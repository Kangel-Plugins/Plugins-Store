class JvmPluginBridge:
    klass: Optional[Class]

    def __init__(self, plugin):
        self.plugin = plugin
        self.klass = None

    def load(self):
        dex_data = self._read_embedded_dex()
        if dex_data is None:
            self.plugin.log("Embedded DEX is unavailable; plugin will not load")
            return

        try:
            loader = InMemoryDexClassLoader(
                ByteBuffer.wrap(dex_data),
                ApplicationLoader.applicationContext.getClassLoader(),
            )
            self.klass = loader.loadClass(String("org.pixwet.music.actions.Main"))
        except Exception as e:
            self.plugin.log_exception("Failed to load DEX", e)

    def call(self, name: str, *args: Any, types: tuple = ()) -> Any:
        if self.klass is None:
            raise RuntimeError(f"cannot call {name}: JVM plugin is not loaded")

        return self.klass.getDeclaredMethod(name, *types).invoke(None, *args)

    def _read_own_source(self) -> Optional[str]:
        candidates: list[str] = []

        own_file = globals().get("__file__")
        if isinstance(own_file, str) and own_file:
            candidates.append(own_file)

        plugins_dir_getter = globals().get("get_plugins_dir")
        if callable(plugins_dir_getter):
            try:
                candidates.append(os.path.join(plugins_dir_getter(), f"{__id__}.py"))
            except Exception as e:
                self.plugin.log_exception("Failed to resolve plugins directory", e)

        for path in candidates:
            try:
                with open(path, "r", encoding="utf-8") as f:
                    return f.read()
            except Exception as e:
                self.plugin.log_exception(f"Failed to read plugin source at {path}", e)

        return None

    def _read_embedded_dex(self) -> Optional[bytes]:
        return self._read_payload(DEX_COMMENT_BEGIN, DEX_COMMENT_END, "DEX")

    def read_embedded_apk_ayugram(self) -> Optional[bytes]:
        return self._read_payload(APK_AYUGRAM_COMMENT_BEGIN, APK_AYUGRAM_COMMENT_END, "AyuGram APK")

    def read_embedded_apk_extera(self) -> Optional[bytes]:
        return self._read_payload(APK_EXTERA_COMMENT_BEGIN, APK_EXTERA_COMMENT_END, "exteraGram APK")

    def _read_payload(self, begin: str, end: str, what: str) -> Optional[bytes]:
        source = self._read_own_source()
        if source is None:
            self.plugin.log(f"Failed to read plugin source for embedded {what}")
            return None

        payload = bytearray()
        decompressor = lzma.LZMADecompressor()
        collecting = False
        completed = False

        try:
            for line in source.splitlines():
                stripped = line.strip()

                if not collecting:
                    collecting = stripped == begin
                    continue

                if stripped == end:
                    completed = True
                    break

                if stripped.startswith("#"):
                    chunk = base64.b64decode(stripped[1:].strip())
                    payload += decompressor.decompress(chunk)
        except (ValueError, lzma.LZMAError) as e:
            self.plugin.log_exception(f"Failed to decode embedded {what}", e)
            return None

        if completed and not decompressor.eof:
            self.plugin.log(f"Embedded {what} payload is truncated")
            return None

        if not completed or not payload:
            self.plugin.log(f"Embedded {what} payload is empty")
            return None

        return bytes(payload)


class MusicPlayer(BasePlugin):
    jvm_plugin: JvmPluginBridge

    def __init__(self):
        super().__init__()
        self.menu_items = None
        self.jvm_plugin = None

    def on_plugin_load(self):
        self.jvm_plugin = JvmPluginBridge(self)
        self.jvm_plugin.load()
        if self.jvm_plugin.klass is not None:
            self.jvm_plugin.call(
                "onLoad",
                String(__id__),
                Boolean(self.get_setting("enable_logs", False)),
                types=(String.getClass(), Boolean.TYPE),
            )
            self.jvm_plugin.call(
                "setCompanionProvider",
                Runnable(self._install_companion),
                types=(JRunnable.getClass(),),
            )
            if self.get_setting("subscribe_external_player", False):
                self.jvm_plugin.call("subscribeOnRemotePlayer")

            if self.get_setting("add_menu_items", True):
                self._add_menu_items()

    def _add_menu_items(self):
        if self.menu_items is not None:
            return
        
        self.menu_items = [
            self.add_menu_item(
                MenuItemData(
                    menu_type=menu_type,
                    text=string("wake_player"),
                    on_click=lambda v=None: self.jvm_plugin.call("wakeExternalPlayer"),
                    icon="msg_played",
                    priority=5,
                    item_id="wake_external_player_" + menu_type.name.lower(),
                )
            )
            for menu_type in [
                MenuItemType.CHAT_ACTION_MENU,
                MenuItemType.PROFILE_ACTION_MENU,
                MenuItemType.MAIN_MENU,
            ]
        ]

    def _remove_menu_items(self):
        if self.menu_items is None:
            return
        
        for item in self.menu_items:
            self.remove_menu_item(item)
        
        self.menu_items = None

    def _install_companion(self):
        package = ApplicationLoader.applicationContext.getPackageName()
        is_extera = package == "com.exteragram.messenger"
        apk = (
            self.jvm_plugin.read_embedded_apk_extera()
            if is_extera
            else self.jvm_plugin.read_embedded_apk_ayugram()
        )
        if not apk:
            self.logger.error("Companion apk is not embedded into the plugin")
            return
        try:
            self.jvm_plugin.call(
                "installCompanion", jarray(jbyte)(apk), types=(jarray(jbyte).getClass(),)
            )
        except Exception as e:
            self.logger.error(f"Failed to start companion install {e}")

    def on_plugin_unload(self):
        jvm_plugin = getattr(self, "jvm_plugin", None)

        if jvm_plugin is None or jvm_plugin.klass is None:
            return

        try:
            jvm_plugin.call("onUnload")
            self.logger.info("JVM plugin unloaded successfully")
        except Exception as e:
            self.logger.error(f"Failed to unload JVM plugin {e}")

        unload_class_loader(jvm_plugin.klass.getClassLoader())
        jvm_plugin.klass = None
    
    def _set_logs(self, enabled):
        jvm_plugin = getattr(self, "jvm_plugin", None)
        if jvm_plugin is None or jvm_plugin.klass is None:
            return
        try:
            jvm_plugin.call("setLogs", Boolean(enabled), types=(Boolean.TYPE,))
        except Exception as e:
            self.logger.error(f"Failed to toggle logs {e}")

    @staticmethod
    def _optional(setting):
        return [setting] if setting is not None else []

    def _apps_setting(self):
        if self.jvm_plugin.klass is None:
            return None
        try:
            factory = self.jvm_plugin.call("getAppsItemFactory")
        except Exception as e:
            self.logger.error(f"Failed to create apps factory {e}")
            return None
        if factory is None:
            return None
        return Custom(factory=factory, link_alias="apps_list")

    def _wake_setting(self):
        if self.jvm_plugin.klass is None:
            return None
        try:
            factory = self.jvm_plugin.call("getWakeItemFactory")
        except Exception as e:
            self.logger.error(f"Failed to create wake factory {e}")
            return None
        if factory is None:
            return None
        return Custom(factory=factory, link_alias="wake_target")

    def _revalidate(self):
        if self.jvm_plugin.klass is None:
            return
        try:
            self.jvm_plugin.call(
                "revalidateSettings",
                Boolean(self.get_setting("subscribe_external_player", False)),
                Boolean(self.get_setting("enable_logs", False)),
                types=(Boolean.TYPE, Boolean.TYPE),
            )
        except Exception as e:
            self.logger.error(f"Failed to revalidate settings {e}")

    def create_settings(self):
        self._revalidate()
        self._add_menu_items() if self.get_setting("add_menu_items", True) else self._remove_menu_items()

        return [
            Text(
                text=string("external_player"),
                subtext=string("external_player_subtext"),
                icon="msg_media",
                accent=True,
                on_click=lambda v=None: self.jvm_plugin.call("openExternalPlayer"),
                link_alias="external_player",
            ),
            Switch(
                key="subscribe_external_player",
                text=string("subscribe_external_player"),
                subtext=string("subscribe_external_player_subtext"),
                default=False,
                icon="player_cover_placeholder",
                on_change=lambda value: self.jvm_plugin.call("subscribeOnRemotePlayer" if value else "unsubscribe"),
                link_alias="subscribe_external_player",
            )
        ] + self._optional(self._apps_setting()) + [
            Divider(),
            Header(string("wake_player")),
            Text(
                text=string("wake_player"),
                subtext=string("wake_player_subtext"),
                icon="msg_played",
                accent=True,
                on_click=lambda v=None: self.jvm_plugin.call("wakeExternalPlayer"),
                link_alias="wake_player",
            ),
        ] + self._optional(self._wake_setting()) + [
            Switch(
                key="add_menu_items",
                text=string("add_menu_items"),
                default=True,
                icon="msg_menu",
                on_change=lambda value: self._add_menu_items() if value else self._remove_menu_items(),
                link_alias="add_wake_menu_items",
            ),
            Divider(),
            Header(string("logs")),
            Switch(
                key="enable_logs",
                text=string("enable_logs"),
                subtext=string("enable_logs_subtext"),
                default=False,
                icon="msg_log",
                on_change=lambda value: self._set_logs(value),
                link_alias="enable_logs",
            ),
            Text(
                text=string("save_logs"),
                subtext=string("save_logs_subtext"),
                icon="msg_download",
                accent=True,
                on_click=lambda v=None: self.jvm_plugin.call("saveLogs"),
                link_alias="save_logs",
            )
        ]

