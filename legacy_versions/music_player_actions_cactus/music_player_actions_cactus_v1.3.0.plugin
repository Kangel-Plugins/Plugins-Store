    },
    "ru": {
        "external_player": "Открыть внешний плеер",
        "subscribe_external_player": "Автоматически включать внешний плеер",
        "enable_logs": "Подробные логи",
        "external_player_subtext": "Открыть музыкальный плеер вне Telegram (если доступно)",
