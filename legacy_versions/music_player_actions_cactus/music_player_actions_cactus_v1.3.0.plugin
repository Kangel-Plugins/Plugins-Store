__id__ = "music_player_actions_cactus"
__name__ = "Music Player Actions"
__author__ = "@CactusPlugins | @exteraFeatures"
__description__ = "Actions for controlling the music player + control of music playing outside Telegram"
__min_version__ = "12.10.6"
__version__ = "1.3.0"

DEX_COMMENT_BEGIN = "# === EMBEDDED DEX BEGIN ==="
DEX_COMMENT_END = "# === EMBEDDED DEX END ==="
APK_AYUGRAM_COMMENT_BEGIN = "# === EMBEDDED APK AYUGRAM BEGIN ==="
APK_AYUGRAM_COMMENT_END = "# === EMBEDDED APK AYUGRAM END ==="
APK_EXTERA_COMMENT_BEGIN = "# === EMBEDDED APK EXTERA BEGIN ==="
APK_EXTERA_COMMENT_END = "# === EMBEDDED APK EXTERA END ==="

