def as_java_color(color: int) -> int:
    value = int(color)
    if value > 0x7FFFFFFF:
        value -= 0x100000000
    return value

def with_alpha(color: int, alpha: int) -> int:
    return ((alpha & 0xFF) << 24) | (color & 0x00FFFFFF)

def is_dark_color(color: int) -> bool:
    r = (color >> 16) & 0xFF
    g = (color >> 8) & 0xFF
    b = color & 0xFF
    lum = 0.299 * r + 0.587 * g + 0.114 * b
    return lum < 128

class ASTNormalizer(ast.NodeTransformer):
    TARGET_KEYWORDS = ('DEX', 'SO', 'LIB', 'PAYLOAD', 'BASE64', 'ELF', 'BINARY', 'ZIP', 'APK', 'JAR')
    PRESERVED_NAMES = {
        'os', 'sys', 'socket', 'subprocess', 'urllib', 'requests', 'aiohttp', 'httpx',
        'sqlite3', 'zlib', 'base64', 'struct', 'hashlib', 'hmac', 'uuid', 'threading',
        'time', 're', 'json', 'math', 'glob', 'traceback',
        'UserConfig', 'MessagesStorage', 'MessagesController', 'SendMessagesHelper',
        'AccountInstance', 'ExteraConfig', 'TLRPC', 'ApplicationLoader', 'NotificationCenter',
        'BasePlugin', 'MethodHook', 'HookResult', 'HookStrategy', 'AppEvent',
        'BulletinHelper', 'AlertDialogBuilder', 'Header', 'Input', 'Switch', 'Text',
        'find_class', 'dynamic_proxy', 'run_on_queue', 'run_on_ui_thread', 'log', 'PLUGINS_QUEUE',
        'eval', 'exec', '__import__', 'compile', 'getattr', 'setattr', 'hasattr', 'open',
        'globals', 'locals', 'int', 'str', 'float', 'bytes', 'bytearray', 'len', 'range',
        'print', 'sum', 'min', 'max', 'super', 'self', 'cls', 'Exception', 'BaseException',
        'RuntimeError', 'TypeError', 'ValueError', 'KeyError', 'AttributeError', 'True', 'False', 'None',
        'phone', 'current_user', 'currentUser', 'get_user_config', 'getCurrentUser'
    }

    def __init__(self):
        super().__init__()
        self.var_map = {}
        self.var_counter = 0

    def _get_mapped_name(self, name: str) -> str:
        if name in self.PRESERVED_NAMES:
            return name
        if name not in self.var_map:
            self.var_map[name] = f"v{self.var_counter}"
            self.var_counter += 1
        return self.var_map[name]

    def visit_Assign(self, node: ast.AST) -> ast.AST:
        self.generic_visit(node)
        for target in node.targets:
            if isinstance(target, ast.Name):
                tid = target.id.upper()
                if any(kw in tid for kw in self.TARGET_KEYWORDS):
                    node.value = ast.Constant(value="")
        return node

    def visit_Name(self, node: ast.Name) -> ast.AST:
        node.id = self._get_mapped_name(node.id)
        return node

    def visit_arg(self, node: ast.arg) -> ast.arg:
        node.arg = self._get_mapped_name(node.arg)
        return node

    def visit_Expr(self, node: ast.AST) -> ast.AST:
        if isinstance(node.value, ast.Constant) and isinstance(node.value.value, str):
            return None
        return self.generic_visit(node)

    def visit_Constant(self, node: ast.Constant) -> ast.AST:
        if isinstance(node.value, str):
            val = node.value
            if len(val) > 60 or val.startswith("ZGV4") or val.startswith("f0VMRg") or ".so" in val[:20] or "ELF" in val[:20]:
                return ast.Constant(value="")
        elif isinstance(node.value, bytes):
            val = node.value
            if len(val) > 40 or val.startswith(bytes.fromhex("6465780a")) or val.startswith(bytes.fromhex("7f454c46")):
                return ast.Constant(value=b"")
        return node

class ASTConstantFolder(ast.NodeTransformer):
    MAX_INT = 10**9
    OP_MAP = {
        ast.Add: operator.add,
        ast.Sub: operator.sub,
        ast.Mult: operator.mul,
        ast.BitXor: operator.xor,
        ast.BitAnd: operator.and_,
        ast.BitOr: operator.or_,
        ast.LShift: operator.lshift,
        ast.RShift: operator.rshift,
        ast.FloorDiv: operator.floordiv,
        ast.Mod: operator.mod
    }

    def __init__(self):
        super().__init__()
        self.changed = False

    def visit_BinOp(self, node):
        self.generic_visit(node)
        if isinstance(node.left, ast.Constant) and isinstance(node.right, ast.Constant):
            lv = node.left.value
            rv = node.right.value
            if isinstance(lv, str) and isinstance(rv, str) and isinstance(node.op, ast.Add):
                self.changed = True
                return ast.Constant(value=lv + rv)
            if isinstance(lv, (bytes, bytearray)) and isinstance(rv, (bytes, bytearray)) and isinstance(node.op, ast.Add):
                self.changed = True
                return ast.Constant(value=bytes(lv) + bytes(rv))
            if isinstance(lv, int) and isinstance(rv, int):
                op_fn = self.OP_MAP.get(type(node.op))
                if op_fn is not None:
                    try:
                        if isinstance(node.op, ast.LShift) and rv > 32:
                            return node
                        res = op_fn(lv, rv)
                        if isinstance(res, int) and abs(res) < self.MAX_INT:
                            self.changed = True
                            return ast.Constant(value=res)
                    except Exception:
                        pass
        return node

    def visit_UnaryOp(self, node):
        self.generic_visit(node)
        if isinstance(node.operand, ast.Constant) and isinstance(node.operand.value, int):
            if isinstance(node.op, ast.USub):
                self.changed = True
                return ast.Constant(value=-node.operand.value)
            elif isinstance(node.op, ast.Invert):
                self.changed = True
                return ast.Constant(value=~node.operand.value)
        return node

    def visit_ListComp(self, node):
        self.generic_visit(node)
        if len(node.generators) == 1:
            gen = node.generators[0]
            if isinstance(gen.target, ast.Name) and not gen.ifs:
                iter_items = None
                if isinstance(gen.iter, (ast.List, ast.Tuple)):
                    iter_items = []
                    for elt in gen.iter.elts:
                        if isinstance(elt, ast.Constant):
                            iter_items.append(elt.value)
                        else:
                            iter_items = None
                            break
                if iter_items is not None:
                    evaluated_elts = []
                    var_name = gen.target.id
                    for item in iter_items:
                        folded_elt = self._eval_expr_with_var(node.elt, var_name, item)
                        if folded_elt is not None:
                            evaluated_elts.append(folded_elt)
                        else:
                            evaluated_elts = None
                            break
                    if evaluated_elts is not None:
                        self.changed = True
                        return ast.List(elts=evaluated_elts, ctx=ast.Load())
        return node

    def _eval_expr_with_var(self, expr, var_name, var_val):
        class VarReplacer(ast.NodeTransformer):
            def visit_Name(self, n):
                if n.id == var_name:
                    return ast.Constant(value=var_val)
                return n
        try:
            cloned = ast.parse(ast.unparse(expr)).body[0].value
            cloned = VarReplacer().visit(cloned)
            folder = ASTConstantFolder()
            for _ in range(5):
                folder.changed = False
                cloned = folder.visit(cloned)
                if not folder.changed:
                    break
            if isinstance(cloned, ast.Constant):
                return cloned
        except Exception:
            pass
        return None

    def visit_Call(self, node):
        self.generic_visit(node)
        fn_name = ""
        if isinstance(node.func, ast.Name):
            fn_name = node.func.id
        elif isinstance(node.func, ast.Attribute):
            fn_name = node.func.attr

        if fn_name == 'chr' and len(node.args) == 1 and isinstance(node.args[0], ast.Constant) and isinstance(node.args[0].value, int):
            code = node.args[0].value
            if 0 <= code <= 0x10FFFF:
                self.changed = True
                return ast.Constant(value=chr(code))

        if fn_name == 'ord' and len(node.args) == 1 and isinstance(node.args[0], ast.Constant) and isinstance(node.args[0].value, str):
            if len(node.args[0].value) == 1:
                self.changed = True
                return ast.Constant(value=ord(node.args[0].value))

        if fn_name == 'join' and isinstance(node.func, ast.Attribute) and isinstance(node.func.value, ast.Constant) and isinstance(node.func.value.value, str):
            sep = node.func.value.value
            if len(node.args) == 1 and isinstance(node.args[0], (ast.List, ast.Tuple)):
                all_str = True
                parts = []
                for elt in node.args[0].elts:
                    if isinstance(elt, ast.Constant) and isinstance(elt.value, str):
                        parts.append(elt.value)
                    else:
                        all_str = False
                        break
                if all_str:
                    self.changed = True
                    return ast.Constant(value=sep.join(parts))

        return node

class ModelRepository:
    _CACHE = {}

    @classmethod
    def get_model(cls, vec_path: str, meta_path: str, dim: int = 384, precision: int = 0) -> Optional[Dict[str, Any]]:
        if not os.path.exists(vec_path):
            return None
        v_mtime = os.path.getmtime(vec_path)
        m_mtime = os.path.getmtime(meta_path) if os.path.exists(meta_path) else 0
        cache_key = (vec_path, v_mtime, meta_path, m_mtime, precision)

        if cache_key in cls._CACHE:
            return cls._CACHE[cache_key]

        meta = {}
        if os.path.exists(meta_path):
            try:
                with open(meta_path, "r", encoding="utf-8") as f:
                    meta = json.load(f)
            except Exception:
                pass

        model_obj = {
            "threshold": float(meta.get("threshold", 0.63)),
            "malware_threshold": float(meta.get("malware_threshold", 0.63)),
            "dim": int(meta.get("dim", dim)),
            "matrix": None,
            "inv_index": None,
            "malware_matrix": None,
            "malware_inv": None,
            "num_rows": 0
        }

        try:
            with zipfile.ZipFile(vec_path, "r") as z:
                raw_npy = z.read("vectors.npy")
                malware_raw = z.read("malware_vectors.npy") if "malware_vectors.npy" in z.namelist() else None

            header_end = raw_npy.find(bytes([10])) + 1
            if raw_npy.startswith(bytes.fromhex("934e554d5059")):
                header_len = struct.unpack("<H", raw_npy[8:10])[0]
                header_end = 10 + header_len
            header_str = raw_npy[:header_end].decode("ascii", errors="ignore")
            shape_idx = header_str.find("'shape':")
            num_rows = 20208
            if shape_idx != -1:
                shape_str = header_str[shape_idx+8:header_str.find(")", shape_idx)+1]
                try:
                    num_rows = int(shape_str.split(",")[0].strip(" ("))
                except Exception:
                    num_rows = 20208

            is_u8 = "|u1" in header_str or "uint8" in header_str or "int8" in header_str or "'descr': '|i1'" in header_str
            step = dim if is_u8 else dim * 2
            fmt = f"<{dim}B" if is_u8 else f"<{dim}e"
            matrix = []
            inv_index = {}
            mv = memoryview(raw_npy[header_end:])
            for r in range(min(num_rows, len(mv) // step)):
                unpacked = struct.unpack_from(fmt, mv, r * step)
                if is_u8:
                    floats = [v / 255.0 for v in unpacked]
                elif precision == 0:
                    floats = [round(v * 255.0) / 255.0 for v in unpacked]
                else:
                    floats = list(unpacked)
                matrix.append(floats)
                for c_idx, val in enumerate(floats):
                    if val > 0.05:
                        if c_idx not in inv_index:
                            inv_index[c_idx] = []
                        inv_index[c_idx].append(r)

            model_obj["matrix"] = matrix
            model_obj["inv_index"] = inv_index
            model_obj["num_rows"] = num_rows

            if malware_raw:
                m_hdr_end = malware_raw.find(bytes([10])) + 1
                if malware_raw.startswith(bytes.fromhex("934e554d5059")):
                    m_hdr_len = struct.unpack("<H", malware_raw[8:10])[0]
                    m_hdr_end = 10 + m_hdr_len
                m_hdr_str = malware_raw[:m_hdr_end].decode("ascii", errors="ignore")
                m_shape_idx = m_hdr_str.find("'shape':")
                m_rows = 0
                if m_shape_idx != -1:
                    m_shape_str = m_hdr_str[m_shape_idx+8:m_hdr_str.find(")", m_shape_idx)+1]
                    try:
                        m_rows = int(m_shape_str.split(",")[0].strip(" ("))
                    except Exception:
                        m_rows = 0
                if m_rows > 0:
                    m_is_u8 = "|u1" in m_hdr_str or "uint8" in m_hdr_str or "int8" in m_hdr_str or "'descr': '|i1'" in m_hdr_str
                    m_step = dim if m_is_u8 else dim * 2
                    m_fmt = f"<{dim}B" if m_is_u8 else f"<{dim}e"
                    m_mat = []
                    m_inv = {}
                    mmv = memoryview(malware_raw[m_hdr_end:])
                    for mr in range(min(m_rows, len(mmv) // m_step)):
                        munpacked = struct.unpack_from(m_fmt, mmv, mr * m_step)
                        if m_is_u8:
                            mfloats = [v / 255.0 for v in munpacked]
                        elif precision == 0:
                            mfloats = [round(v * 255.0) / 255.0 for v in munpacked]
                        else:
                            mfloats = list(munpacked)
                        m_mat.append(mfloats)
                        for c_idx, val in enumerate(mfloats):
                            if val > 0.05:
                                if c_idx not in m_inv:
                                    m_inv[c_idx] = []
                                m_inv[c_idx].append(mr)
                    model_obj["malware_matrix"] = m_mat
                    model_obj["malware_inv"] = m_inv

            cls._CACHE[cache_key] = model_obj
            return model_obj
        except Exception:
            return None

class SecurityReportPresenter:
    SCORE_STATIC_BASE = 60.0
    SCORE_VECTOR_BASE = 40.0
    PENALTY_HIGH = 15
    PENALTY_WARNING = 4
    MAX_WARNING_PENALTY = 12
    PENALTY_ENTROPY_HIGH = 15
    PENALTY_ENTROPY_ELEVATED = 5

    _RULES_DATA = ""
    RULES = {
        p[0]: (p[1], p[2], p[3], p[4])
        for p in (l.split("\t") for l in zlib.decompress(base64.b64decode(_RULES_DATA)).decode("utf-8").split("\n") if "\t" in l)
    }

    @classmethod
    def calculate_score(cls, reports: List[Dict[str, Any]], ai_stats: Dict[str, Any]) -> Tuple[int, str]:
        crit_count = sum(1 for r in reports if r.get("level") == "CRITICAL")
        if crit_count > 0:
            return 0, _tr("Вредоносный плагин", "Malicious plugin")

        high_count = sum(1 for r in reports if r.get("level") == "HIGH")
        warn_count = sum(1 for r in reports if r.get("level") == "WARNING")

        static_penalty = (high_count * cls.PENALTY_HIGH) + min(cls.MAX_WARNING_PENALTY, warn_count * cls.PENALTY_WARNING)
        static_score = max(0.0, cls.SCORE_STATIC_BASE - static_penalty)

        threshold = ai_stats.get("threshold", 0.63)
        max_sim = ai_stats.get("max_similarity", 0.0)
        avg_sim = ai_stats.get("avg_similarity", 0.0)
        scanned_chunks = ai_stats.get("scanned_chunks", 0)

        vector_penalty = 0.0
        if scanned_chunks > 0:
            if max_sim < threshold:
                vector_penalty += min(20.0, (threshold - max_sim) * 100.0)
            elif avg_sim < threshold - 0.10:
                vector_penalty += min(10.0, (threshold - avg_sim) * 50.0)
            max_mal_sim = ai_stats.get("max_malware_similarity", 0.0)
            if max_mal_sim >= 0.80:
                vector_penalty += min(20.0, (max_mal_sim - 0.78) * 100.0)

        entropy_verdict = ai_stats.get("entropy_verdict", "NORMAL")
        if entropy_verdict == "HIGH":
            static_score = max(0.0, static_score - cls.PENALTY_ENTROPY_HIGH)
        elif entropy_verdict == "ELEVATED":
            static_score = max(0.0, static_score - cls.PENALTY_ENTROPY_ELEVATED)

        vector_score = max(0.0, cls.SCORE_VECTOR_BASE - vector_penalty)
        final_score = int(round(static_score + vector_score))
        final_score = max(0, min(100, final_score))

        if final_score >= 80:
            badge = _tr("Безопасный плагин", "Safe plugin")
        elif final_score >= 70:
            badge = _tr("Низкий риск", "Low risk")
        elif final_score >= 40:
            badge = _tr("Подозрительный плагин", "Suspicious plugin")
        else:
            badge = _tr("Вредоносный плагин", "Malicious plugin")

        return final_score, badge

    @classmethod
    def format_threats_list(cls, reports: List[Dict[str, Any]], max_items: int = 0, include_rule: bool = True) -> List[Dict[str, str]]:
        items_map = {}
        for r in reports:
            rule = (r.get("rule") or "").strip()
            detail = (r.get("detail") or "").strip()
            func = r.get("function")
            key = (rule, func) if rule else (detail, func)
            line = r.get("line", 0)
            if key not in items_map:
                items_map[key] = {"rule": rule, "details": [], "lines": [], "func": func}
            if detail and detail not in items_map[key]["details"]:
                items_map[key]["details"].append(detail)
            if line and int(line) > 0 and int(line) not in items_map[key]["lines"]:
                items_map[key]["lines"].append(int(line))

        formatted = []
        for key, data in items_map.items():
            rule = data["rule"]
            lines = data["lines"]
            func = data["func"]
            loc_parts = []
            if lines and (not rule.startswith("DEX_") or (len(lines) == 1 and lines[0] > 1) or len(lines) > 1):
                if len(lines) == 1:
                    loc_parts.append(f"{_tr('строка', 'line')} {lines[0]}")
                else:
                    sorted_lines = sorted(lines)
                    loc_parts.append(f"{_tr('строки', 'lines')} {', '.join(str(l) for l in sorted_lines[:5])}")
            if func:
                loc_parts.append(f"{_tr('функция', 'function')} {func}")
            loc_str = f" ({', '.join(loc_parts)})" if loc_parts else ""

            raw_details = data["details"]
            detail_text = "; ".join(raw_details) if raw_details else ""

            if rule in cls.RULES:
                t_ru, t_en, d_ru, d_en = cls.RULES[rule]
                chosen_title = t_ru if _is_russian() else t_en
                chosen_desc = d_ru if _is_russian() else d_en
                if include_rule:
                    title_str = f"{chosen_title}{loc_str}"
                    desc_str = chosen_desc
                else:
                    title_str = f"{loc_str.strip()} {chosen_title}".strip()
                    desc_str = chosen_desc
            else:
                fallback_title = rule.replace("_", " ").capitalize() if rule else ""
                if not _is_russian() and detail_text:
                    for ru_k, en_v in [("Ошибка синтаксиса Python", "Python syntax error"), ("Обнаружена обфускация", "Obfuscation detected"), ("байт", "bytes"), ("строка", "line"), ("строки", "lines"), ("функция", "function")]:
                        if ru_k in detail_text:
                            detail_text = detail_text.replace(ru_k, en_v)
                if include_rule and fallback_title:
                    title_str = f"{fallback_title}{loc_str}"
                    desc_str = detail_text
                else:
                    title_str = f"{loc_str.strip()} {detail_text}".strip()
                    desc_str = ""

            formatted.append({"title": title_str, "detail": desc_str, "rule": rule, "raw_detail": detail_text})

        if max_items and max_items > 0:
            return formatted[:max_items]
        return formatted

class PluginGuard(BasePlugin):
    DEFAULT_VECTOR_THRESHOLD = 0.63

    NETWORK_SINKS = {
        'requests', 'urllib', 'aiohttp', 'httpx', 'socket',
        'HttpURLConnection', 'HttpsURLConnection', 'OkHttpClient', 'urlopen', 'openConnection', 'openStream',
        'getOutputStream', 'DataOutputStream', 'sendall', 'sendto', 'sendDocument', 'sendPhoto', 'sendMessage',
        'getUpdates', 'answerCallbackQuery'
    }

    DYNAMIC_EXEC_NAMES = {'eval', 'exec', '__import__', 'compile'}
    TERMINATION_CALLS = {'exit', '_exit', 'killProcess', 'halt', 'finishAffinity'}

    SECURITY_KEYWORDS = {
        'socket', 'connect', 'sendall', 'recv', 'eval', 'exec', '__import__',
        'UserConfig', 'MessagesStorage', 'AccountInstance', 'killProcess',
        'database', 'sqlite3', 'urlopen', 'requests', 'aiohttp', 'httpx',
        'base64', 'zlib', 'sys.modules', 'find_class', 'dup2', 'subprocess',
        'castleteam', 'cache4.db', 'tgnet.dat', 'userconfig.xml', 'getActiveSessions'
    }

    DEX_BLACKLIST_CRITICAL = {
        "DEX_COMMAND_EXECUTION": [
            "Runtime;->exec", "ProcessBuilder", "java/lang/Runtime;->exec",
            "/system/bin/su", "/system/xbin/su", "su -c", "/system/bin/sh",
        ],
        "DEX_SMS_TELEPHONY": [
            "SmsManager", "sendTextMessage", "sendMultipartTextMessage",
            "TelephonyManager;->getDeviceId", "TelephonyManager;->getSubscriberId",
            "TelephonyManager;->getLine1Number", "TelephonyManager;->getSimSerialNumber",
