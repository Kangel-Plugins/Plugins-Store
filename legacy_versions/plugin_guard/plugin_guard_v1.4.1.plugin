    def __init__(self):
        super().__init__()
        self._installed_hooks = []
        self._current_analyze_btn = None
        self._current_sheet = None
        self._current_chk_box = None
        self.is_model_loaded = False
        self._hash_cache = {}
        self._last_scan_stats = {}
        self._cached_ui_classes = None
        self._cached_dex_bridge = None
        self._cached_dex_loader = None
        self._dex_model_loaded_path = None

    def on_plugin_load(self):
        global _ACTIVE_GUARD_INSTANCE
        if _ACTIVE_GUARD_INSTANCE is not None and _ACTIVE_GUARD_INSTANCE is not self:
            try:
                _ACTIVE_GUARD_INSTANCE.on_plugin_unload()
            except Exception:
                pass
        _ACTIVE_GUARD_INSTANCE = self

        threading.Thread(target=self._preload_resources, daemon=True).start()
        self._hook_install_ui()
        try:
            self.add_on_send_message_hook()
        except Exception as e:
            self.log(f"[PluginGuard DEBUG] add_on_send_message_hook failed: {e}")

    def on_send_message_hook(self, account: int, params: Any) -> HookResult:
        if not params:
            return HookResult(strategy=HookStrategy.DEFAULT)
        try:
            msg = getattr(params, "message", None)
            if not msg and hasattr(params, "text"):
                msg = params.text
            if isinstance(msg, str):
                text = msg.strip()
                if text.startswith(("./plugguard", ".plugguard", "./guard", ".guard", "/guard", "!guard", "!plugguard")):
                    parts = text.split()
                    subcmd = parts[1].lower() if len(parts) > 1 else "help"
                    arg = parts[2] if len(parts) > 2 else ""
                    run_on_ui_thread(lambda: self._handle_debug_command(subcmd, arg))
                    return HookResult(strategy=HookStrategy.CANCEL)
        except Exception as e:
            self.log(f"[PluginGuard DEBUG] on_send_message_hook error: {e}")
        finally:
            del params
        return HookResult(strategy=HookStrategy.DEFAULT)

    def _handle_debug_command(self, subcmd: str, arg: str = ""):
        frag = get_last_fragment()
        ctx = self._get_active_context(frag)
        if not ctx:
            return

        if subcmd in ("update", "upd"):
            remote_v = arg if arg else "2.0.0"
            local_meta = self._get_cached_metadata()
            local_v = str(local_meta.get("version") or local_meta.get("model_version") or "1.0.1") if local_meta else "1.0.1"
            if frag:
                try:
                    BulletinHelper.show_info(_tr(f"🔔 Доступно обновление модели v{remote_v}!", f"🔔 Model update v{remote_v} available!"), frag)
                except Exception:
                    pass
            self._show_update_available_dialog(remote_v, local_v, frag)

        elif subcmd in ("danger", "crit", "malware", "f"):
            builder = AlertDialogBuilder(ctx, AlertDialogBuilder.ALERT_TYPE_MESSAGE)
            builder.set_title(_tr("Опасность!\nРейтинг: 0/100", "Danger!\nScore: 0/100"))
            debug_info = _tr(
                "\n\nВердикт: Вредоносный обфусцированный код\nВекторов: 20208\nСхожесть: мин 0.2100 / сред 0.4300 / макс 0.5100\nПорог: 0.6300 (-0.1200)\nЭнтропия: 5.6420 (обфускация)\nЧанков: 15",
                "\n\nVerdict: Malicious obfuscated code\nVectors: 20208\nSimilarity: min 0.2100 / avg 0.4300 / max 0.5100\nThreshold: 0.6300 (-0.1200)\nEntropy: 5.6420 (obfuscation)\nChunks: 15"
            )
            msg = _tr(
                "Вердикт: Вредоносный плагин\n\nВнимание: плагин содержит вредоносные вызовы!\n\nОбнаруженные критические угрозы:\n- UNAUTHORIZED_DATA_EXFILTRATION (строка 42): Обнаружен подтвержденный поток данных из Telegram в сетевой запрос",
                "Verdict: Malicious plugin\n\nWarning: plugin contains malicious calls!\n\nDetected critical threats:\n- UNAUTHORIZED_DATA_EXFILTRATION (line 42): Confirmed data flow from Telegram to network request"
            ) + debug_info
            builder.set_message(msg)
            builder.set_positive_button(_tr("Закрыть", "Close"), lambda d, w: d.dismiss() if hasattr(d, "dismiss") else None)
            builder.set_cancelable(True)
            builder.set_canceled_on_touch_outside(True)
            builder.show()

        elif subcmd in ("warn", "warning", "b", "c"):
            builder = AlertDialogBuilder(ctx, AlertDialogBuilder.ALERT_TYPE_MESSAGE)
            builder.set_title(_tr("PluginGuard\nРейтинг: 74/100", "PluginGuard\nScore: 74/100"))
            debug_info = _tr(
                "\n\nВердикт: Код частично нечитаем\nВекторов: 20208\nСхожесть: мин 0.5100 / сред 0.6500 / макс 0.7900\nПорог: 0.6300 (+0.1600)\nЭнтропия: 5.1200 (повышенная)\nЧанков: 8",
                "\n\nVerdict: Code partially unreadable\nVectors: 20208\nSimilarity: min 0.5100 / avg 0.6500 / max 0.7900\nThreshold: 0.6300 (+0.1600)\nEntropy: 5.1200 (elevated)\nChunks: 8"
            )
            msg = _tr(
                "Вердикт: Минимальный риск\n\n Предупреждение:\n- MASS_REPORT_ABUSE (строка 18): Обнаружен вызов массовых жалоб на аккаунты (TL_account_reportPeer)",
                "Verdict: Minimal risk\n\n Warning:\n- MASS_REPORT_ABUSE (line 18): Account mass-report call detected (TL_account_reportPeer)"
            ) + debug_info
            builder.set_message(msg)
            builder.set_positive_button(_tr("Закрыть", "Close"), lambda d, w: d.dismiss() if hasattr(d, "dismiss") else None)
            builder.set_cancelable(True)
            builder.set_canceled_on_touch_outside(True)
            builder.show()

        elif subcmd in ("safe", "clean", "a", "ok"):
            builder = AlertDialogBuilder(ctx, AlertDialogBuilder.ALERT_TYPE_MESSAGE)
            builder.set_title(_tr("PluginGuard\nРейтинг: 100/100", "PluginGuard\nScore: 100/100"))
            debug_info = _tr(
                "\n\nВердикт: Код не обфусцирован, опасных вызовов нет\nВекторов: 20208\nСхожесть: мин 0.4600 / сред 0.7131 / макс 0.8699\nПорог: 0.6300 (+0.2399)\nЭнтропия: 4.3758 (норма)\nЧанков: 91",
                "\n\nVerdict: Code is clean, no dangerous calls\nVectors: 20208\nSimilarity: min 0.4600 / avg 0.7131 / max 0.8699\nThreshold: 0.6300 (+0.2399)\nEntropy: 4.3758 (normal)\nChunks: 91"
            )
            msg = _tr(
                "Вердикт: Безопасный плагин\n\n Вредоносный код и скрытые каналы связи не обнаружены.",
                "Verdict: Safe plugin\n\n Malicious code and covert channels not detected."
            ) + debug_info
            builder.set_message(msg)
            builder.set_positive_button(_tr("Закрыть", "Close"), lambda d, w: d.dismiss() if hasattr(d, "dismiss") else None)
            builder.set_cancelable(True)
            builder.set_canceled_on_touch_outside(True)
            builder.show()

        elif subcmd in ("stats", "diag", "info"):
            meta = self._get_cached_metadata() or {}
            last = self._get_last_scan_stats() or {}
            raw_v = str(meta.get("version") or meta.get("model_version") or "1.0.1")
            builder = AlertDialogBuilder(ctx, AlertDialogBuilder.ALERT_TYPE_MESSAGE)
            builder.set_title(_tr("Диагностика PluginGuard", "PluginGuard Diagnostics"))
            clean_cnt = meta.get('total_clean_chunks', meta.get('vectors_count', 20208))
            mal_cnt = meta.get('total_malware_chunks', 0)
            msg = (
                f"{_tr('Версия модели', 'Model version')}: v{raw_v}\n"
                f"{_tr('Векторов чистых', 'Clean vectors')}: {clean_cnt}\n"
                f"{_tr('Сигнатур малварей', 'Malware signatures')}: {mal_cnt}\n"
                f"{_tr('Движок вычислений', 'Compute engine')}: {self._get_active_engine_name()}\n"
                f"{_tr('Кэш в RAM', 'RAM cache')}: {len(self._hash_cache)} {_tr('файлов', 'files')}\n"
                f"{_tr('Последняя проверка', 'Last scan')}: {last.get('scan_time_ms', 0)} {_tr('мс', 'ms')} ({last.get('scanned_chunks', 0)} {_tr('чанков', 'chunks')})\n"
                f"{_tr('Порог схожести', 'Similarity threshold')}: {last.get('threshold', 0.63):.4f}"
            )
            builder.set_message(msg)
            builder.set_positive_button(_tr("Закрыть", "Close"), lambda d, w: d.dismiss() if hasattr(d, "dismiss") else None)
            builder.set_cancelable(True)
            builder.show()

        elif subcmd in ("sync", "download"):
            self._sync_model_manual()

        elif subcmd in ("clear", "wipe"):
            self._clear_sql_cache()

        else:
            builder = AlertDialogBuilder(ctx, AlertDialogBuilder.ALERT_TYPE_MESSAGE)
            builder.set_title(_tr("Команды отладки PluginGuard", "PluginGuard Debug Commands"))
            msg = _tr(
                "Команды отладки:\n\n"
                "- .plugguard update [версия] — окно обновления модели\n"
                "- .plugguard danger — окно угрозы (Вредоносный плагин)\n"
                "- .plugguard warn — окно предупреждения (Минимальный риск)\n"
                "- .plugguard safe — окно безопасного плагина\n"
                "- .plugguard stats — статус базы и ML-движка\n"
                "- .plugguard sync — принудительная загрузка базы\n"
                "- .plugguard clear — очистка кэша проверок",
                "Debug commands:\n\n"
                "- .plugguard update [version] — model update dialog\n"
                "- .plugguard danger — threat dialog (Malicious plugin)\n"
                "- .plugguard warn — warning dialog (Minimal risk)\n"
                "- .plugguard safe — safe plugin dialog\n"
                "- .plugguard stats — database and ML engine status\n"
                "- .plugguard sync — force download model\n"
                "- .plugguard clear — clear scan cache"
            )
            builder.set_message(msg)
            builder.set_positive_button(_tr("Закрыть", "Close"), lambda d, w: d.dismiss() if hasattr(d, "dismiss") else None)
            builder.set_cancelable(True)
            builder.show()

    def _preload_resources(self):
        self._check_version_update()
        self._init_ram_cache()
        self._ensure_model_downloaded()
        try:
            self._get_dex_bridge()
        except Exception:
            pass

    def _check_version_update(self):
        try:
            last_ver = str(self.get_setting("last_plugin_version", "") or "")
            if last_ver != __version__:
                self.log(f"[PluginGuard] Plugin updated (from '{last_ver}' to '{__version__}'). Auto-clearing scan cache.")
                self._clear_cache_internal()
                self.set_setting("last_plugin_version", __version__)
        except Exception as e:
            self.log(f"[PluginGuard] _check_version_update failed: {e}")

    def _init_ram_cache(self):
        try:
            db_path = self._get_db_path()
            if os.path.exists(db_path):
                with sqlite3.connect(db_path) as conn:
                    cursor = conn.cursor()
                    cursor.execute("SELECT sha256, reports_json, stats_json FROM scan_cache ORDER BY timestamp DESC LIMIT 50")
                    for row in cursor.fetchall():
                        self._hash_cache[row[0]] = (json.loads(row[1]), json.loads(row[2]))
        except Exception:
            pass

    def _get_ui_classes(self):
        if not self._cached_ui_classes or not self._cached_ui_classes[0]:
            b_cls = find_class("org.telegram.ui.Stories.recorder.ButtonWithCounterView")
            l_cls = find_class("android.widget.LinearLayout")
            t_cls = find_class("org.telegram.ui.ActionBar.Theme")
            u_cls = find_class("org.telegram.messenger.AndroidUtilities")
            cb_cls = find_class("android.widget.CheckBox")
            comp_cls = find_class("android.widget.CompoundButton")
            self._cached_ui_classes = (b_cls, l_cls, t_cls, u_cls, cb_cls, comp_cls)
        return self._cached_ui_classes

    def _safe_set_text(self, view, text_str: str, animate: bool = False):
        if not view:
            return
        try:
            view.setText(text_str, animate)
        except Exception:
            try:
                view.setText(text_str)
            except Exception:
                pass

    def on_plugin_unload(self):
        global _ACTIVE_GUARD_INSTANCE
        try:
            self.remove_on_send_message_hook()
        except Exception:
            pass
        if hasattr(self, "_installed_hooks") and self._installed_hooks:
            for h in self._installed_hooks:
                try:
                    self.unhook_method(h)
                except Exception:
                    pass
            self._installed_hooks.clear()
        try:
            if getattr(self, "_cached_dex_bridge", None):
                self._invoke_dex("unload")
        except Exception:
            pass
        self._cached_dex_bridge = None
        self._cached_dex_loader = None
        self._dex_model_loaded_path = None
        self._current_analyze_btn = None
        self._current_sheet = None
        self._current_chk_box = None
        self._current_install_btn = None
        self._current_parent_layout = None
        self._current_orig_listener = None
        self._hash_cache.clear()
        self._vector_db = None
        self._vector_names = None
        self._model_metadata = None
        if _ACTIVE_GUARD_INSTANCE is self:
            _ACTIVE_GUARD_INSTANCE = None
        try:
            gc.collect()
        except Exception:
            pass

    def _resolve_model_paths(self) -> Tuple[str, str]:
        precision = int(self.get_setting("model_precision", 0))
        if precision == 1:
            pref_pairs = [("norm_vectors.npz", "norm_metadata.json"), ("norm_vectors_8bit.npz", "norm_metadata_8bit.json")]
        else:
            pref_pairs = [("norm_vectors_8bit.npz", "norm_metadata_8bit.json"), ("norm_vectors.npz", "norm_metadata.json")]
        candidates_dir = []
        cache_dir = self._get_cache_dir()
        if cache_dir:
            candidates_dir.append(cache_dir)
        try:
            from org.telegram.messenger import ApplicationLoader
            ctx = ApplicationLoader.applicationContext
            if ctx is not None:
                candidates_dir.append(os.path.join(ctx.getFilesDir().getAbsolutePath(), "plugin_guard_model"))
                candidates_dir.append(ctx.getFilesDir().getAbsolutePath())
                candidates_dir.append(os.path.join(ctx.getCacheDir().getAbsolutePath(), "plugin_guard_model"))
                candidates_dir.append(ctx.getCacheDir().getAbsolutePath())
        except Exception:
            pass
        if '__file__' in globals():
            candidates_dir.append(os.path.join(os.path.dirname(os.path.realpath(__file__)), "plugin_guard_model"))
            candidates_dir.append(os.path.dirname(os.path.realpath(__file__)))
        candidates_dir.append(os.path.join(os.getcwd(), "plugin_guard_model"))
        candidates_dir.append(os.getcwd())

        for v_name, m_name in pref_pairs:
            best_candidate = None
            best_version = (-1, -1, -1)
            best_mtime = 0.0
            for d in candidates_dir:
                v = os.path.join(d, v_name)
                m = os.path.join(d, m_name)
                if os.path.exists(v) and os.path.getsize(v) > 1000 and os.path.exists(m) and os.path.getsize(m) > 10:
                    try:
                        with open(m, "r", encoding="utf-8") as mf:
                            data = json.load(mf)
                            ver_str = str(data.get("version") or data.get("model_version") or "0.0.0")
                            parsed_v = self._parse_version(ver_str)
                            mtime = os.path.getmtime(m)
                            if parsed_v > best_version or (parsed_v == best_version and mtime > best_mtime):
                                best_version = parsed_v
                                best_mtime = mtime
                                best_candidate = (v, m)
                    except Exception:
                        if not best_candidate:
                            best_candidate = (v, m)
            if best_candidate:
                return best_candidate

        def_cache = self._get_cache_dir()
        def_v = pref_pairs[0][0]
        def_m = pref_pairs[0][1]
        return os.path.join(def_cache, def_v), os.path.join(def_cache, def_m)

    def _get_cached_metadata(self) -> Optional[Dict[str, Any]]:
        try:
            _, meta_path = self._resolve_model_paths()
            if os.path.exists(meta_path):
                with open(meta_path, "r", encoding="utf-8") as f:
                    return json.load(f)
        except Exception:
            pass
        return None

    def _save_last_scan_stats(self, stats: Dict[str, Any]):
        self._last_scan_stats = stats
        try:
            cache_dir = self._get_cache_dir()
            scan_meta_path = os.path.join(cache_dir, "norm_last_scan.json")
            with open(scan_meta_path, "w", encoding="utf-8") as f:
                json.dump(stats, f, ensure_ascii=False, indent=2)
        except Exception:
            pass

    def _get_last_scan_stats(self) -> Dict[str, Any]:
        if hasattr(self, "_last_scan_stats") and self._last_scan_stats:
            return self._last_scan_stats
        try:
            cache_dir = self._get_cache_dir()
            scan_meta_path = os.path.join(cache_dir, "norm_last_scan.json")
            if os.path.exists(scan_meta_path):
                with open(scan_meta_path, "w", encoding="utf-8") as f:
                    self._last_scan_stats = json.load(f)
                    return self._last_scan_stats
        except Exception:
            pass
        return {}

    def _get_db_path(self) -> str:
        cache_dir = self._get_cache_dir()
        db_dir = os.path.join(cache_dir, "scan_cache")
        os.makedirs(db_dir, exist_ok=True)
        return os.path.join(db_dir, "plugins_hash_cache.db")

    def _init_cache_db(self):
        try:
            db_path = self._get_db_path()
            with sqlite3.connect(db_path, timeout=10.0) as conn:
                conn.execute("CREATE TABLE IF NOT EXISTS scan_cache (sha256 TEXT PRIMARY KEY, file_name TEXT, timestamp REAL, reports_json TEXT, stats_json TEXT)")
                conn.commit()
            self._db_initialized = True
        except Exception:
            pass

    def _get_cached_scan_result(self, file_hash: str) -> Optional[Tuple[List[Dict[str, Any]], Dict[str, Any]]]:
        if not file_hash:
            return None
        if hasattr(self, "_hash_cache") and file_hash in self._hash_cache:
            return self._hash_cache[file_hash]

        try:
            db_path = self._get_db_path()
            if os.path.exists(db_path):
                with sqlite3.connect(db_path, timeout=10.0) as conn:
                    cursor = conn.cursor()
                    cursor.execute("SELECT reports_json, stats_json FROM scan_cache WHERE sha256 = ?", (file_hash,))
                    row = cursor.fetchone()
                    if row:
                        reports = json.loads(row[0])
                        stats = json.loads(row[1])
                        if not hasattr(self, "_hash_cache"):
                            self._hash_cache = {}
                        if len(self._hash_cache) > 100:
                            first_k = next(iter(self._hash_cache), None)
                            if first_k:
                                del self._hash_cache[first_k]
                        self._hash_cache[file_hash] = (reports, stats)
                        return reports, stats
        except Exception:
            pass
        return None

    def _save_cached_scan_result(self, file_hash: str, file_name: str, reports: List[Dict[str, Any]], stats: Dict[str, Any]):
        if not file_hash:
            return
        if not hasattr(self, "_hash_cache"):
            self._hash_cache = {}
        if len(self._hash_cache) > 100:
            first_k = next(iter(self._hash_cache), None)
            if first_k:
                del self._hash_cache[first_k]
        self._hash_cache[file_hash] = (reports, stats)

        try:
            db_path = self._get_db_path()
            if not getattr(self, "_db_initialized", False):
                self._init_cache_db()
            with sqlite3.connect(db_path, timeout=10.0) as conn:
                conn.execute(
                    "INSERT OR REPLACE INTO scan_cache (sha256, file_name, timestamp, reports_json, stats_json) VALUES (?, ?, ?, ?, ?)",
                    (file_hash, file_name, time.time(), json.dumps(reports, ensure_ascii=False), json.dumps(stats, ensure_ascii=False))
                )
                conn.commit()
        except Exception:
            pass

    def _clear_cache_internal(self):
        try:
            if hasattr(self, "_hash_cache"):
                self._hash_cache.clear()
            if hasattr(self, "_last_scan_stats"):
                self._last_scan_stats.clear()
            self._cached_malware_db = None
            db_path = self._get_db_path()
            if os.path.exists(db_path):
                with sqlite3.connect(db_path, timeout=10.0) as conn:
                    conn.execute("DELETE FROM scan_cache")
                    conn.commit()
            m_db_path = self._get_malware_db_file()
            if os.path.exists(m_db_path):
                try:
                    os.remove(m_db_path)
                except Exception:
                    pass
        except Exception as e:
            self.log(f"[PluginGuard] _clear_cache_internal error: {e}")

    def _clear_sql_cache(self):
        try:
            self._clear_cache_internal()
            fragment = get_last_fragment()
            if fragment:
                BulletinHelper.show_success(_tr("Кэш SQLite успешно очищен!", "SQLite cache successfully cleared!"), fragment)
        except Exception as e:
            fragment = get_last_fragment()
            if fragment:
                BulletinHelper.show_error(f"{_tr('Ошибка очистки кэша', 'Cache clearing error')}: {e}", fragment)

    def _get_malware_db_file(self) -> str:
        return os.path.join(self._get_cache_dir(), "malware_signatures.json")

    def _get_malware_db(self) -> Dict[str, Dict[str, str]]:
        if hasattr(self, "_cached_malware_db") and self._cached_malware_db:
            return self._cached_malware_db
        db = {}
        f_path = self._get_malware_db_file()
        if os.path.exists(f_path):
            try:
                with open(f_path, "r", encoding="utf-8") as f:
                    local_entries = json.load(f)
                    if isinstance(local_entries, dict):
                        for h_key, h_val in local_entries.items():
                            db[h_key.lower()] = h_val
            except Exception:
                pass
        self._cached_malware_db = db
        return db

    def _check_malware_hash(self, sha256_hash: str) -> Optional[Dict[str, str]]:
        if not sha256_hash:
            return None
        h_clean = sha256_hash.lower().strip()
        db = self._get_malware_db()
        return db.get(h_clean)

    def _calculate_ast_simhash(self, tree: Optional[ast.AST]) -> str:
        if tree is None:
            return "0000000000000000"
        nodes = []
        for node in ast.walk(tree):
            if not isinstance(node, (ast.Load, ast.Store, ast.Del, ast.Param)):
                nodes.append(type(node).__name__)
        if not nodes:
            return "0000000000000000"
        ngrams = []
        if len(nodes) < 3:
            ngrams = ["_".join(nodes)]
        else:
            for i in range(len(nodes) - 2):
                ngrams.append(f"{nodes[i]}_{nodes[i+1]}_{nodes[i+2]}")
        v = [0] * 64
        for ng in ngrams:
            h = int.from_bytes(hashlib.md5(ng.encode('utf-8')).digest()[:8], 'big')
            for b in range(64):
                if (h >> b) & 1:
                    v[b] += 1
                else:
                    v[b] -= 1
        fingerprint = 0
        for b in range(64):
            if v[b] > 0:
                fingerprint |= (1 << b)
        return f"{fingerprint:016x}"

    def _check_ast_simhash(self, simhash_hex: str, max_distance: int = 3) -> Optional[Dict[str, str]]:
        if not simhash_hex or simhash_hex == "0000000000000000":
            return None
        try:
            target_int = int(simhash_hex, 16)
        except Exception:
            return None
        db = self._get_malware_db()
        for k, val in db.items():
            ref_simhash = None
            if isinstance(val, dict):
                ref_simhash = val.get("simhash") or val.get("ast_simhash")
            if not ref_simhash and k.startswith("simhash:"):
                ref_simhash = k[8:].strip()
            if ref_simhash:
                try:
                    ref_int = int(ref_simhash, 16)
                    dist = bin(target_int ^ ref_int).count("1")
                    if dist <= max_distance:
                        res = dict(val) if isinstance(val, dict) else {"family": "KnownMalware", "type": "AST SimHash Mutation"}
                        res["hamming_distance"] = dist
                        return res
                except Exception:
                    pass
        return None

    def _get_active_engine_name(self) -> str:
        bridge = self._get_dex_bridge()
        if bridge is not None:
            return "Native Java (Optimized SIMD)"
        return "⚙️ Pure Python Fallback Engine"

    def _on_model_precision_change(self, new_val: int):
        self.set_setting("model_precision", new_val, reload_settings=True)
        ModelRepository._CACHE.clear()
        self.is_model_loaded = False
        self._vector_db = None
        self._model_metadata = None
        self._cached_dex_bridge = None
        self._dex_model_loaded_path = None
        if hasattr(self, "_hash_cache"):
            self._hash_cache.clear()
        self._ensure_model_downloaded()

    def create_settings(self):
        frag = get_last_fragment()
        threading.Thread(target=lambda: self._check_remote_version_async(frag), daemon=True).start()

        meta = self._get_cached_metadata()
        raw_ver = str(meta.get("version") or meta.get("model_version") or "1.0.1") if meta else _tr("Не загружена", "Not loaded")
        model_ver = raw_ver.lstrip("v")
        cur_prec = int(self.get_setting("model_precision", 0))
        prec_title = "16-bit Float16" if cur_prec == 1 else "8-bit"
        if meta:
            try:
                vec_p, _ = self._resolve_model_paths()
                if "8bit" in os.path.basename(vec_p):
                    prec_title = "8-bit"
                elif os.path.exists(vec_p):
                    prec_title = "16-bit Float16"
            except Exception:
                pass
        vec_count = (meta.get("total_clean_chunks") or meta.get("total_chunks") or meta.get("vectors_count", 0)) if meta else 0
        malware_count = meta.get("total_malware_chunks", 0) if meta else 0
        if vec_count:
            ver_sub = f"{_tr('Загружено векторов', 'Loaded vectors')}: {vec_count:,} ({_tr('чистых', 'clean')}) + {malware_count} ({_tr('сигнатур', 'signatures')})"
        else:
            ver_sub = _tr("База векторов не загружена", "Vector database not loaded")

        last_stats = self._get_last_scan_stats()
        engine_status = self._get_active_engine_name()
        scan_time_ms = last_stats.get("scan_time_ms", 0.0)
        scanned_chunks = last_stats.get("scanned_chunks", 0)
        max_sim = last_stats.get("max_similarity", 0.0)
        threshold = last_stats.get("threshold", 0.6300)

        speed_sub = f"{scan_time_ms} {_tr('мс', 'ms')} ({scanned_chunks} {_tr('чанков', 'chunks')})" if scan_time_ms > 0 else _tr("Замеры отсутствуют", "No benchmark data")
        sim_sub = f"{_tr('Схожесть', 'Similarity')}: {max_sim:.4f} | {_tr('Порог', 'Threshold')}: {threshold:.4f}" if max_sim > 0 else _tr("Нет данных последнего анализа", "No data from last scan")

        db_entries_count = 0
        try:
            db_path = self._get_db_path()
            if os.path.exists(db_path):
                with sqlite3.connect(db_path) as conn:
                    cursor = conn.cursor()
                    cursor.execute("SELECT COUNT(*) FROM scan_cache")
                    row = cursor.fetchone()
                    if row:
                        db_entries_count = row[0]
        except Exception:
            pass

        cache_sub = f"{_tr('Сохранено отчетов на диске', 'Reports stored on disk')}: {db_entries_count}" if db_entries_count > 0 else _tr("Кэш пуст", "Cache is empty")

        return [
            Header(text=_tr("База данных безопасности", "Security Database")),
            Text(text=f"{_tr('Версия модели', 'Model version')}: v{model_ver} ({prec_title})", subtext=ver_sub, icon="msg_about"),
            Selector(
                key="model_precision",
                text=_tr("Точность векторов", "Vector Model Precision"),
                default=0,
                items=[
                    _tr("8-бит (Рекомендуется)", "8-bit (Recommended)"),
                    _tr("16-бит (Float16)", "16-bit (Float16)")
                ],
                icon="msg_media",
                on_change=self._on_model_precision_change
            ),
            Header(text=_tr("Диагностика и замеры скорости", "Diagnostics & Speed Benchmarks")),
            Text(text=_tr("Движок вычислений", "Compute Engine"), subtext=engine_status, icon="msg_permissions"),
            Text(text=_tr("Время последней проверки", "Last Scan Duration"), subtext=speed_sub, icon="msg_radar"),
            Text(text=_tr("Метрика схожести Top-5", "Top-5 Similarity Metric"), subtext=sim_sub, icon="msg_stats"),
            Header(text=_tr("Управление кэшем проверок", "Scan Cache Management")),
            Text(text=_tr("Очистить кэш проверок", "Clear Scan Cache"), subtext=cache_sub, icon="msg_delete", red=True, on_click=lambda v: self._clear_sql_cache()),
            Header(text=_tr("Отладка и дампы", "Debugging & Dumps")),
            Switch(key="save_debug_dumps", text=_tr("Сохранять дампы для отладки", "Save Dumps for Debugging"), default=False, subtext=_tr("Экспортировать декомпилированный DEX, SO и отчеты в папку Download/PluginGuard_Dumps", "Export decompiled DEX, SO and reports to Download/PluginGuard_Dumps")),
            Header(text=_tr("Настройки обновления базы", "Database Update Settings")),
            Input(key="github_repo_url", text="GitHub Base URL", default="https://github.com/abova8382993/PluginGuard-model/blob/main/norm_metadata_8bit.json", subtext=_tr("Ссылка на репозиторий с norm_vectors_8bit.npz и norm_metadata_8bit.json", "Link to repository with norm_vectors_8bit.npz and norm_metadata_8bit.json")),
            Switch(key="auto_block", text=_tr("Блокировать опасные плагины", "Block Malicious Plugins"), default=True, subtext=_tr("Автоматически отменять установку вредоносных плагинов", "Automatically abort installation of malicious plugins")),
            Switch(key="notify_model_updates", text=_tr("Сообщать об обновлениях модели", "Notify on Model Updates"), default=True, subtext=_tr("Уведомлять при выходе новых версий базы безопасности", "Receive notifications when new security database updates are released")),
            Text(text=_tr("Синхронизировать модель с GitHub", "Sync Model with GitHub"), icon="msg_retry", accent=True, on_click=lambda v: self._sync_model_manual())
        ]

    def _normalize_github_url(self, url: str) -> str:
        u = url.strip()
        for fn in ["norm_metadata_8bit.json", "norm_vectors_8bit.npz", "norm_metadata.json", "norm_vectors.npz", "norm_vectors.npy", "version.txt"]:
            if u.endswith(fn):
                u = u[:-len(fn)]
        u = u.rstrip("/")
        if "github.com/" in u:
            parts = u.split("github.com/", 1)[1].split("/")
            owner = parts[0]
            repo = parts[1] if len(parts) > 1 else ""
            branch = "main"
            if len(parts) >= 4 and parts[2] in ("blob", "tree"):
                branch = parts[3]
            return f"https://raw.githubusercontent.com/{owner}/{repo}/{branch}/"
        elif "raw.githubusercontent.com/" in u:
            return u + "/"
        return u + "/"

    def _parse_version(self, v_str: str) -> Tuple[int, ...]:
        try:
            clean_v = str(v_str).strip().lstrip("vV")
            return tuple(int(x) for x in clean_v.split("."))
        except Exception:
            return (0, 0, 0)

    def _get_active_context(self, frag: Any = None) -> Any:
        for f in [frag, get_last_fragment()]:
            if f:
                try:
                    act = f.getParentActivity()
                    if act is not None:
                        return act
                except Exception:
                    pass
                try:
                    ctx = f.getContext()
                    if ctx is not None:
                        return ctx
                except Exception:
                    pass
        try:
            from org.telegram.messenger import ApplicationLoader
            return ApplicationLoader.applicationContext
        except Exception:
            return None

    def _check_remote_version_async(self, target_frag: Any = None):
        if not self.get_setting("notify_model_updates", True):
            return
        try:
            raw_input_url = self.get_setting("github_repo_url", "https://github.com/abova8382993/PluginGuard-model/blob/main/norm_metadata_8bit.json").strip()
            base_url = self._normalize_github_url(raw_input_url)
            ts = int(time.time())
            ver_url = f"{base_url}version.txt?t={ts}"

            headers = {"User-Agent": "Mozilla/5.0", "Cache-Control": "no-cache", "Pragma": "no-cache"}
            remote_ver = ""
            try:
                req_ver = urllib.request.Request(ver_url, headers=headers)
                with urllib.request.urlopen(req_ver, timeout=8) as resp:
                    remote_ver = resp.read().decode("utf-8").strip()
            except Exception:
                pass

            if not remote_ver:
                precision = int(self.get_setting("model_precision", 0))
                meta_fns = ["norm_metadata.json", "norm_metadata_8bit.json"] if precision == 1 else ["norm_metadata_8bit.json", "norm_metadata.json"]
                for meta_fn in meta_fns:
                    try:
                        meta_url = f"{base_url}{meta_fn}?t={ts}"
                        req_meta = urllib.request.Request(meta_url, headers=headers)
                        with urllib.request.urlopen(req_meta, timeout=8) as resp:
                            meta_j = json.loads(resp.read().decode("utf-8"))
                            remote_ver = str(meta_j.get("version") or meta_j.get("model_version") or "").strip()
                            if remote_ver:
                                break
                    except Exception:
                        pass

            if not remote_ver:
                return

            local_meta = self._get_cached_metadata()
            local_ver = str(local_meta.get("version") or local_meta.get("model_version") or "1.0.1") if local_meta else "1.0.1"

            if self._parse_version(remote_ver) > self._parse_version(local_ver):
                def _notify_ui():
                    frag = target_frag or get_last_fragment()
                    if frag:
                        try:
                            BulletinHelper.show_info(_tr(f"🔔 Доступно обновление модели v{remote_ver}!", f"🔔 Model update v{remote_ver} available!"), frag)
                        except Exception:
                            pass
                    self._show_update_available_dialog(remote_ver, local_ver, frag)

                run_on_ui_thread(_notify_ui)
        except Exception as e:
            self.log(f"[PluginGuard DEBUG] Version check error: {e}")

    def _show_update_available_dialog(self, remote_ver: str, local_ver: str, active_frag: Any = None):
        context = self._get_active_context(active_frag)
        if not context:
            return
        builder = AlertDialogBuilder(context, AlertDialogBuilder.ALERT_TYPE_MESSAGE)
        builder.set_title(_tr("🔔 Обновление модели", "🔔 Model Update"))
        builder.set_message(
            _tr(
                f"Доступна новая версия модели безопасности!\n\nТекущая: v{local_ver}\nНовая: v{remote_ver}\n\nЖелаете загрузить обновление?",
                f"A new version of the security model is available!\n\nCurrent: v{local_ver}\nNew: v{remote_ver}\n\nWould you like to download the update?"
            )
        )
        builder.set_positive_button(_tr("Обновить", "Update"), lambda d, w: (d.dismiss() if hasattr(d, "dismiss") else None, self._sync_model_manual()))
        
        def _on_never_show(d, w):
            if hasattr(d, "dismiss"):
                d.dismiss()
            self.set_setting("notify_model_updates", False)
            f = active_frag or get_last_fragment()
            if f:
                run_on_ui_thread(lambda: BulletinHelper.show_info(_tr("Уведомления об обновлениях модели отключены в настройках", "Model update notifications disabled in settings"), f))

        builder.set_negative_button(_tr("Больше не показывать", "Don't show again"), _on_never_show)
        builder.show()

    def _sync_model_manual(self):
        fragment = get_last_fragment()
        if fragment:
            try:
                BulletinHelper.show_info(_tr("Загрузка модели безопасности с GitHub...", "Downloading security model from GitHub..."), fragment)
            except Exception:
                pass
        threading.Thread(target=self._download_github_model, daemon=True).start()

    def _download_github_model(self):
        raw_input_url = self.get_setting("github_repo_url", "https://github.com/abova8382993/PluginGuard-model/blob/main/norm_metadata_8bit.json").strip()
        base_url = self._normalize_github_url(raw_input_url)
        
        ts = int(time.time())
        headers = {
            "User-Agent": "Mozilla/5.0",
            "Cache-Control": "no-cache",
            "Pragma": "no-cache"
        }

        try:
            vec_data = None
            meta_data = None
            precision = int(self.get_setting("model_precision", 0))
            if precision == 1:
                pairs = [("norm_vectors.npz", "norm_metadata.json"), ("norm_vectors_8bit.npz", "norm_metadata_8bit.json")]
            else:
                pairs = [("norm_vectors_8bit.npz", "norm_metadata_8bit.json"), ("norm_vectors.npz", "norm_metadata.json")]
            for v_fn, m_fn in pairs:
                try:
                    vec_url = f"{base_url}{v_fn}?t={ts}"
                    meta_url = f"{base_url}{m_fn}?t={ts}"
                    req_vec = urllib.request.Request(vec_url, headers=headers)
                    with urllib.request.urlopen(req_vec, timeout=25) as resp:
                        v_temp = resp.read()
                    req_meta = urllib.request.Request(meta_url, headers=headers)
                    with urllib.request.urlopen(req_meta, timeout=20) as resp:
                        m_temp = resp.read()
                    if len(v_temp) >= 1000 and len(m_temp) >= 50:
                        vec_data = v_temp
                        meta_data = m_temp
                        break
                except Exception:
                    pass

            if not vec_data or not meta_data:
                raise ValueError(_tr("Загруженные файлы повреждены или пусты", "Downloaded files are corrupted or empty"))

            vec_path, meta_path = self._resolve_model_paths()
            with open(vec_path, "wb") as f_vec:
                f_vec.write(vec_data)
            with open(meta_path, "wb") as f_meta:
                f_meta.write(meta_data)

            target_dirs = []
            try:
                from org.telegram.messenger import ApplicationLoader
                c = ApplicationLoader.applicationContext
                if c:
                    target_dirs.append(c.getFilesDir().getAbsolutePath())
                    target_dirs.append(c.getCacheDir().getAbsolutePath())
            except Exception:
                pass

            base_v_fn = os.path.basename(vec_path)
            base_m_fn = os.path.basename(meta_path)
            for td in target_dirs:
                try:
                    with open(os.path.join(td, base_v_fn), "wb") as f_vec:
                        f_vec.write(vec_data)
                    with open(os.path.join(td, base_m_fn), "wb") as f_meta:
                        f_meta.write(meta_data)
                except Exception:
                    pass

            ModelRepository._CACHE.clear()
            self.is_model_loaded = False
            self._vector_db = None
            self._model_metadata = None
            self._cached_dex_bridge = None
            self._dex_model_loaded_path = None
            if hasattr(self, "_hash_cache"):
                self._hash_cache.clear()

            new_ver = "2.0.0"
            clean_cnt = 20432
            mal_cnt = 1115
            try:
                meta_j = json.loads(meta_data.decode("utf-8"))
                new_ver = str(meta_j.get("version") or meta_j.get("model_version") or "2.0.0").lstrip("v")
                clean_cnt = meta_j.get("total_clean_chunks", 20432)
                mal_cnt = meta_j.get("total_malware_chunks", 1115)
            except Exception:
                pass

            try:
                self._get_dex_bridge()
            except Exception:
                pass

            success_msg = _tr(
                f"Модель обновлена: v{new_ver} ({clean_cnt:,} чистых / {mal_cnt} сигнатур)",
                f"Model updated: v{new_ver} ({clean_cnt:,} clean / {mal_cnt} signatures)"
            )
            def _show_ui_success():
                frag = get_last_fragment()
                if frag:
                    try:
                        BulletinHelper.show_success(success_msg, frag)
                    except Exception:
                        pass
            run_on_ui_thread(_show_ui_success)
        except Exception as e:
            err_msg = f"{_tr('Ошибка загрузки модели', 'Model download error')}: {e}"
            def _show_ui_error():
                frag = get_last_fragment()
                if frag:
                    try:
                        BulletinHelper.show_error(err_msg, frag)
                    except Exception:
                        pass
            run_on_ui_thread(_show_ui_error)

    def _ensure_model_downloaded(self):
        vec_path, _ = self._resolve_model_paths()
        if not os.path.exists(vec_path) or os.path.getsize(vec_path) < 1000:
            threading.Thread(target=self._download_github_model, daemon=True).start()

    def _get_cache_dir(self) -> str:
        try:
            from org.telegram.messenger import ApplicationLoader
            ctx = ApplicationLoader.applicationContext
            d = os.path.join(ctx.getFilesDir().getAbsolutePath(), "plugin_guard_model")
            os.makedirs(d, exist_ok=True)
            return d
        except Exception:
            d = os.path.join(os.getcwd(), "plugin_guard_model")
            os.makedirs(d, exist_ok=True)
            return d

    def _calculate_security_score(self, reports: List[Dict[str, Any]], ai_stats: Dict[str, Any]) -> Tuple[int, str]:
        return SecurityReportPresenter.calculate_score(reports, ai_stats)

    MANGLED_VAR_REGEX = re.compile(r'^(_0x[a-fA-F0-9]{4,}|[I|l|1|_]{5,}|_[a-z0-9]{12,})$')
    RE_BASE64_LONG = re.compile(r'^[a-zA-Z0-9+/=]{100,}$')
    RE_HEX_LONG = re.compile(r'^(?:[0-9a-fA-F]{2}){20,}$')
    RE_BASE64_STRICT = re.compile(r'^[A-Za-z0-9+/=]+$')
    RE_BASE64_WITH_WS = re.compile(r'^[A-Za-z0-9+/=\s]+$')
    RE_BOT_TOKEN = re.compile(r'\b\d{8,10}:[A-Za-z0-9_-]{35}\b')
    RE_SO_LIB = re.compile(r' ([a-zA-Z0-9_\-\./]+\.so) ')
    RE_HEX_KEY = re.compile(r'^[0-9a-fA-F]{8,}$')
    RE_WALLET_BTC = re.compile(r'\b(?:bc1[a-zA-HJ-NP-Z0-9]{25,39}|[13][a-km-zA-HJ-NP-Z1-9]{25,34})\b')
    RE_WALLET_ETH = re.compile(r'\b0x[a-fA-F0-9]{40}\b')
    RE_WALLET_TON = re.compile(r'\b(?:EQ|UQ)[a-zA-Z0-9_-]{46}\b')
    RE_WALLET_TRX = re.compile(r'\bT[A-Za-z1-9]{33}\b')
    RE_2FA_CODE_KEYWORD = re.compile(r'(?i)(login\s*code|код\s*входа|код\s*подтверждения|авторизаци|login\s*attempt)')

    @staticmethod
    def _is_known_binary_asset(val: Any) -> bool:
        magics = (bytes.fromhex("6465780a"), bytes.fromhex("7f454c46"), bytes.fromhex("89504e47"), bytes.fromhex("ffd8ff"), b"GIF87a", b"GIF89a", b"RIFF")
        if isinstance(val, bytes):
            if val.startswith(magics):
                return True
            try:
                decomp = zlib.decompress(val)
                if decomp.startswith(magics):
                    return True
            except Exception:
                pass
        elif isinstance(val, str):
            s = val.strip()
            if len(s) > 60:
                try:
                    raw = base64.b64decode(s)
                    if raw.startswith(magics):
                        return True
                    try:
                        decomp = zlib.decompress(raw)
                        if decomp.startswith(magics):
                            return True
                    except Exception:
                        pass
                except Exception:
                    pass
        return False

    def _analyze_obfuscation(self, code_str: str, tree: Optional[ast.AST] = None) -> Tuple[float, str, float, int]:
        if not code_str:
            return 0.0, "NORMAL", 0.0, 0

        if tree is None:
            try:
                tree = ast.parse(code_str)
            except Exception:
                chars = [c for c in code_str if ord(c) < 128 and not c.isspace()]
                length = len(chars)
                freq = {}
                for char in chars:
                    freq[char] = freq.get(char, 0) + 1
                raw_entropy = sum(-(c / length) * math.log2(c / length) for c in freq.values()) if length > 0 else 0.0
                return round(raw_entropy, 4), "HIGH", 90.0, 0

        class _LiteralNormalizer(ast.NodeTransformer):
            def visit_Constant(self, node):
                if isinstance(node.value, (str, bytes)):
                    val = node.value
                    val_s = val.decode('utf-8', 'ignore') if isinstance(val, bytes) else val
                    if len(val_s) > 40 or any(ord(c) > 127 for c in val_s) or PluginGuard._is_known_binary_asset(node.value):
                        return ast.Constant(value="")
                return node

        try:
            norm_tree = _LiteralNormalizer().visit(ast.parse(code_str))
            ast.fix_missing_locations(norm_tree)
            clean_text = ast.unparse(norm_tree)
        except Exception:
            clean_text = code_str

        ascii_only = "".join(c for c in clean_text if ord(c) < 128 and not c.isspace())
        length = len(ascii_only)
        freq = {}
        for char in ascii_only:
            freq[char] = freq.get(char, 0) + 1
        entropy = sum(-(c / length) * math.log2(c / length) for c in freq.values()) if length > 0 else 0.0

        total_vars = 0
        mangled_vars = 0
        chr_ord_count = 0
        dynamic_exec = 0
        dynamic_imports = 0
        reverse_slices = 0
        hex_blobs = 0
        high_entropy_literals = 0
        nested_lambdas = 0
        nodes_count = 0
        identifiers = []

        for node in ast.walk(tree):
            nodes_count += 1
            if isinstance(node, ast.Name):
                total_vars += 1
                identifiers.append(node.id)
                if self.MANGLED_VAR_REGEX.match(node.id):
                    mangled_vars += 1
                if node.id in ('eval', 'exec', 'compile', '__import__'):
                    dynamic_exec += 1
            elif isinstance(node, ast.Attribute):
                identifiers.append(node.attr)
                if node.attr in ('b64decode', 'decompress', 'unhexlify', 'b85decode', 'a85decode', 'b32decode'):
                    dynamic_imports += 1
            elif isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)):
                identifiers.append(node.name)
            elif isinstance(node, ast.arg):
                identifiers.append(node.arg)
            elif isinstance(node, ast.Call):
                fn = ''
                if isinstance(node.func, ast.Name):
                    fn = node.func.id
                elif isinstance(node.func, ast.Attribute):
                    fn = node.func.attr
                if fn in ('chr', 'ord', 'unichr', 'fromhex', 'unhexlify'):
                    chr_ord_count += 1
                elif fn in ('__import__', 'import_module'):
                    dynamic_imports += 1
                elif fn == 'getattr' and len(node.args) >= 2:
                    attr_arg = node.args[1]
                    if isinstance(attr_arg, ast.Constant) and isinstance(attr_arg.value, str):
                        if attr_arg.value in ('exec', 'eval', 'compile', '__import__'):
                            dynamic_exec += 2
            elif hasattr(ast, 'Slice') and isinstance(node, ast.Slice):
                if isinstance(getattr(node, 'step', None), ast.UnaryOp) and isinstance(node.step.op, ast.USub):
                    reverse_slices += 1
                elif isinstance(getattr(node, 'step', None), ast.Constant) and node.step.value == -1:
                    reverse_slices += 1
            elif isinstance(node, ast.Lambda):
                for child in ast.walk(node.body):
                    if isinstance(child, ast.Lambda):
                        nested_lambdas += 1
            elif isinstance(node, ast.Constant):
                if self._is_known_binary_asset(node.value):
                    continue
                if isinstance(node.value, str):
                    v_s = node.value.strip()
                    if len(v_s) >= 32:
                        n_lit = len(v_s)
                        f_lit = {}
                        for ch in v_s:
                            f_lit[ch] = f_lit.get(ch, 0) + 1
                        lit_ent = sum(-(c / n_lit) * math.log2(c / n_lit) for c in f_lit.values())
                        if lit_ent >= 5.85:
                            high_entropy_literals += 1
                    if len(v_s) > 100 and self.RE_BASE64_LONG.match(v_s):
                        hex_blobs += 1
                    elif len(v_s) >= 40 and self.RE_HEX_LONG.match(v_s):
                        hex_blobs += 1
                elif isinstance(node.value, bytes):
                    if len(node.value) >= 32:
                        n_bytes = len(node.value)
                        f_bytes = {}
                        for b_val in node.value:
                            f_bytes[b_val] = f_bytes.get(b_val, 0) + 1
                        byte_ent = sum(-(c / n_bytes) * math.log2(c / n_bytes) for c in f_bytes.values())
                        if byte_ent >= 5.90:
                            high_entropy_literals += 1
                    if len(node.value) > 60:
                        hex_blobs += 1

        id_text = "".join(identifiers)
        id_entropy = 0.0
        if id_text:
            n_id = len(id_text)
            f_id = {}
            for ch in id_text:
                f_id[ch] = f_id.get(ch, 0) + 1
            id_entropy = sum(-(c / n_id) * math.log2(c / n_id) for c in f_id.values())

        lines = max(1, len([l for l in clean_text.splitlines() if l.strip()]))
        density = nodes_count / lines
        mangled_ratio = (mangled_vars / max(1, total_vars)) if total_vars > 0 else 0.0

        score = 0.0
        if mangled_ratio > 0.30:
            score += 40.0
        elif mangled_ratio > 0.15:
            score += 20.0

        if chr_ord_count >= 10:
            score += 30.0
        elif chr_ord_count >= 5:
            score += 15.0

        if high_entropy_literals >= 2:
            score += 35.0
        elif high_entropy_literals == 1:
            score += 20.0

        if dynamic_imports >= 3:
            score += 25.0
        if dynamic_exec >= 1:
            score += 25.0
        if reverse_slices >= 2:
            score += 20.0
        if hex_blobs >= 3:
            score += 30.0
        elif hex_blobs >= 1:
            score += 15.0
        if nested_lambdas >= 3:
            score += 25.0
        if density > 40.0 and lines <= 5:
            score += 35.0

        if id_entropy >= 5.0 and len(identifiers) >= 15:
            score += 25.0
        elif id_entropy >= 4.85 and len(identifiers) >= 15:
            score += 10.0

        if entropy >= 5.55:
            score += 30.0
        elif entropy >= 5.38:
            score += 15.0

        if score >= 60.0 or (entropy >= 5.50 and score >= 35.0):
            verdict = "HIGH"
        elif score >= 35.0 or (entropy >= 5.38 and (score >= 15.0 or id_entropy >= 4.85)):
            verdict = "ELEVATED"
        else:
            verdict = "NORMAL"

        return round(entropy, 4), verdict, score, high_entropy_literals

    def _encode_text_deterministic(self, text: str, dim: int = 384) -> List[float]:
        vec = [0.0] * dim
        words = text.split()
        if not words:
            return vec
        for word in words:
            weight = 3.0 if any(sk.lower() in word.lower() for sk in self.SECURITY_KEYWORDS) else 1.0
            w_bytes = word.encode('utf-8')
            idx = zlib.crc32(w_bytes) % dim
            vec[idx] += weight
            if len(word) >= 3:
                for i in range(len(word) - 2):
                    gram = word[i:i+3].encode('utf-8')
                    g_idx = zlib.crc32(gram) % dim
                    vec[g_idx] += weight * 0.5
        sq_sum = sum(v * v for v in vec)
        if sq_sum > 0:
            norm = sq_sum ** 0.5
            return [v / norm for v in vec]
        return vec

    def _get_dex_bridge(self):
        if getattr(self, "_cached_dex_bridge", None):
            return self._cached_dex_bridge
        try:
            dex_bytes = zlib.decompress(base64.b64decode(self._DEX_ZLIB_BASE64))
            byte_buffer = find_class("java.nio.ByteBuffer").wrap(dex_bytes)
            parent_loader = find_class("org.telegram.messenger.ApplicationLoader").applicationContext.getClassLoader()
            dex_loader = find_class("dalvik.system.InMemoryDexClassLoader")(byte_buffer, parent_loader)
            bridge_class = dex_loader.loadClass("ni.dekma.plugin_guard.VectorScannerBridge")
            self._cached_dex_bridge = bridge_class
            self._cached_dex_loader = dex_loader
            return bridge_class
        except Exception as e1:
            try:
                cache_dir = self._get_cache_dir()
                dex_hash = hashlib.sha256(self._DEX_ZLIB_BASE64.encode("utf-8")).hexdigest()[:12]
                dex_path = os.path.join(cache_dir, f"vector_scanner_{dex_hash}.dex")
                opt_dir = os.path.join(cache_dir, f"dex_opt_{dex_hash}")
                os.makedirs(opt_dir, exist_ok=True)
                if not os.path.exists(dex_path):
                    with open(dex_path, "wb") as f:
                        f.write(zlib.decompress(base64.b64decode(self._DEX_ZLIB_BASE64)))
                DexClassLoader = find_class("dalvik.system.DexClassLoader")
                parent_loader = find_class("org.telegram.messenger.ApplicationLoader").applicationContext.getClassLoader()
                dex_loader = DexClassLoader(dex_path, opt_dir, None, parent_loader)
                bridge_class = dex_loader.loadClass("ni.dekma.plugin_guard.VectorScannerBridge")
                self._cached_dex_bridge = bridge_class
                self._cached_dex_loader = dex_loader
                return bridge_class
            except Exception as e2:
                self.log(f"[PluginGuard DEBUG] DEX engine init failed: {e1} / {e2}")
                return None

    def _invoke_dex(self, method_name: str, *args):
        bridge_class = self._get_dex_bridge()
        if bridge_class is None:
            return None
        matches = []
        try:
            for method in bridge_class.getDeclaredMethods():
                if str(method.getName()) == method_name and len(method.getParameterTypes()) == len(args):
                    method.setAccessible(True)
                    matches.append(method)
            if matches:
                return matches[0].invoke(None, *args)
        except Exception as e:
            self.log(f"[PluginGuard DEBUG] _invoke_dex exception for {method_name}: {e}")
        return None

    def _ensure_dex_model_loaded(self, vec_path: str) -> bool:
        if getattr(self, "_dex_model_loaded_path", None) == vec_path:
            return True
        try:
            res = self._invoke_dex("loadModel", vec_path)
            if res:
                self._dex_model_loaded_path = vec_path
                return True
        except Exception:
            pass
        return False

    def scan_plugin_code(self, code_str: str, depth: int = 0) -> Tuple[List[Dict[str, Any]], Dict[str, Any]]:
        t_start = time.perf_counter()
        reports = []
        try:
            tree = ast.parse(code_str)
            folder = ASTConstantFolder()
            any_folded = False
            for _ in range(6):
                folder.changed = False
                tree = folder.visit(tree)
                if folder.changed:
                    any_folded = True
                else:
                    break
            if any_folded:
                ast.fix_missing_locations(tree)
                try:
                    code_str = ast.unparse(tree)
                except Exception:
                    pass
        except SyntaxError as e:
            reports.append({
                "level": "CRITICAL",
                "line": getattr(e, "lineno", 0),
                "rule": "SYNTAX_ERROR",
                "detail": f"Ошибка синтаксиса Python: {e}"
            })
            stats = {
                "scanned_chunks": 0,
                "status": "SYNTAX_ERROR",
                "threshold": self.DEFAULT_VECTOR_THRESHOLD,
                "max_similarity": 0.0,
                "min_similarity": 0.0,
                "avg_similarity": 0.0,
                "vectors_count": 0,
                "threshold_diff": "+0.0000",
                "entropy": 0.0,
                "entropy_verdict": "HIGH",
                "scan_time_ms": round((time.perf_counter() - t_start) * 1000, 2)
            }
            return reports, stats

        obf_entropy, obf_verdict, obf_score, high_ent_literals = self._analyze_obfuscation(code_str, tree)
        if obf_verdict == "HIGH" and obf_score >= 50.0:
            reports.append({
                "level": "WARNING",
                "line": 0,
                "rule": "OBFUSCATED_CODE_STRUCTURE",
                "detail": "Обнаружена обфускация кода (манглинг переменных, динамические декодеры или зашифрованный payload)"
            })
        if high_ent_literals > 0:
            reports.append({
                "level": "WARNING",
                "line": 0,
                "rule": "HIGH_ENTROPY_LITERAL_DETECTED",
                "detail": f"Обнаружен зашифрованный или высокоэнтропийный строковый литерал ({high_ent_literals} шт.)"
            })

        ast_simhash = self._calculate_ast_simhash(tree)
        simhash_match = self._check_ast_simhash(ast_simhash)
        if simhash_match:
            reports.append({
                "level": "CRITICAL",
                "line": 0,
                "rule": "KNOWN_MALWARE_SIMHASH_MATCH",
                "detail": f"Структурная мутация вредоносного плагина обнаружена через AST SimHash [{simhash_match.get('family', 'Malware')}] (дистанция {simhash_match.get('hamming_distance', 0)})"
            })

        try:
            dex_bytes, dex_line = self._extract_dex_bytes(tree, code_str)
            if dex_bytes:
                dex_hash = hashlib.sha256(dex_bytes).hexdigest()
                dex_db_match = self._check_malware_hash(dex_hash)
                if dex_db_match:
                    reports.append({
                        "level": "CRITICAL",
                        "line": dex_line,
                        "rule": "KNOWN_MALWARE_DEX_MATCH",
                        "detail": f"Внедренный DEX обнаружен в базе зловредов [{dex_db_match.get('family', 'Malware')}] ({dex_db_match.get('type', 'Вредоносный DEX')})"
                    })

            deobf_payloads = self._extract_deobfuscated_payloads(code_str)
            obf_layers_count = len(deobf_payloads) if deobf_payloads else 0
            if obf_layers_count > 0:
                reports.append({
                    "level": "WARNING",
                    "line": 0,
                    "rule": "MULTI_LAYER_OBFUSCATION_UNPACKED",
                    "detail": f"Обнаружена и распакована многослойная обфускация ({_plural_code_layers(obf_layers_count)})"
                })
                for _, p_code in deobf_payloads:
                    p_hash = hashlib.sha256(p_code.encode("utf-8", errors="ignore")).hexdigest()
                    p_match = self._check_malware_hash(p_hash)
                    if p_match:
                        reports.append({
                            "level": "CRITICAL",
                            "line": 0,
                            "rule": "KNOWN_MALWARE_PAYLOAD_MATCH",
                            "detail": f"Распакованный слой обнаружен в базе зловредов [{p_match.get('family', 'Malware')}] ({p_match.get('type', 'Деобфусцированный стиллер')})"
                        })
                if depth == 0 and deobf_payloads:
                    innermost_code = deobf_payloads[-1][1]
                    if '\x00' not in innermost_code:
                        sub_reports, sub_stats = self.scan_plugin_code(innermost_code, depth=depth + 1)
                        for sr in sub_reports:
                            if sr.get("rule") != "SYNTAX_ERROR":
                                reports.append(sr)
        except Exception:
            obf_layers_count = 0
            pass

        stats = {
            "scanned_chunks": 0,
            "status": "NOT_LOADED",
            "threshold": self.DEFAULT_VECTOR_THRESHOLD,
            "max_similarity": 0.0,
            "min_similarity": 0.0,
            "avg_similarity": 0.0,
            "vectors_count": 0,
            "threshold_diff": "+0.0000",
            "entropy": obf_entropy,
            "entropy_verdict": obf_verdict,
            "obfuscation_layers": obf_layers_count,
            "ast_simhash": ast_simhash,
            "scan_time_ms": 0.0
        }

        plugin_ref = self

        class CombinedASTVisitor(ast.NodeVisitor):
            def __init__(self):
                self.scope_stack = [set()]
                self.str_vars = {}
                self.str_var_lines = {}
                self.sensitive_vars = set()
                self.chunks = []
                self.reports = []
                self.deep_base64_candidates = []
                self.dex_bytes = None
                self.dex_line = 0
                self.so_bytes_list = []
                self.seen_so_refs = set()
                self.has_clipboard_access = False
                self.embedded_crypto_wallets = []
                self.has_2fa_keyword = False
                self.aliases = {
                    '__import__': '__import__',
                    'getattr': 'getattr',
                    'exec': 'exec',
                    'eval': 'eval',
                    'compile': 'compile',
                    'globals': 'globals',
                    'locals': 'locals'
                }
                self.module_aliases = {
                    'builtins': 'builtins'
                }

            def _resolve_func_name(self, func_node):
                if isinstance(func_node, ast.Name):
                    return self.aliases.get(func_node.id, func_node.id)
                if isinstance(func_node, ast.Attribute):
                    val_name = self._resolve_func_name(func_node.value)
                    return f"{val_name}.{func_node.attr}"
                return ""

            @property
            def current_net_vars(self):
                return self.scope_stack[-1]

            def _is_net_call(self, call_node):
                if not isinstance(call_node, ast.Call):
                    return False
                for child in ast.walk(call_node.func):
                    fn = ""
                    if isinstance(child, ast.Name): fn = child.id
                    elif isinstance(child, ast.Attribute): fn = child.attr
                    if fn in ('recv', 'recvfrom', 'recv_into', 'recvfrom_into', 'urlopen', 'urlretrieve'):
                        return True
                    if fn in ('get', 'post', 'request'):
                        full_fn = ""
                        try:
                            full_fn = ast.unparse(call_node.func)
                        except Exception:
                            pass
                        if any(mod in full_fn for mod in ('requests.', 'urllib.', 'http.', 'httpx.', 'aiohttp.', 'session.')):
                            return True
                return False

            def _mark_net(self, target_node):
                for child in ast.walk(target_node):
                    if isinstance(child, ast.Name) and child.id not in ('self', 'cls', 'this', 'me'):
                        self.current_net_vars.add(child.id)

            def visit_FunctionDef(self, node):
                self.scope_stack.append(set(self.scope_stack[-1]))
                self._extract_chunk(node)
                self.generic_visit(node)
                self.scope_stack.pop()

            def visit_AsyncFunctionDef(self, node):
                self.scope_stack.append(set(self.scope_stack[-1]))
                self._extract_chunk(node)
                self.generic_visit(node)
                self.scope_stack.pop()

            def visit_ClassDef(self, node):
                self._extract_chunk(node)
                self.generic_visit(node)

            def visit_Import(self, node):
                for alias in node.names:
                    if alias.name == "ctypes" or alias.name.startswith("ctypes."):
                        self.reports.append({
                            "level": "WARNING",
                            "line": getattr(node, "lineno", 0),
                            "rule": "CTYPES_NATIVE_ACCESS",
                            "detail": "Импорт модуля ctypes для вызова нативных библиотек .so. Проверить машинный код невозможно, устанавливайте на свой страх и риск!"
                        })
                self.generic_visit(node)

            def visit_ImportFrom(self, node):
                if node.module == "ctypes" or (node.module and node.module.startswith("ctypes.")):
                    self.reports.append({
                        "level": "WARNING",
                        "line": getattr(node, "lineno", 0),
                        "rule": "CTYPES_NATIVE_ACCESS",
                        "detail": "Импорт модуля ctypes для вызова нативных библиотек .so. Проверить машинный код невозможно, устанавливайте на свой страх и риск!"
                    })
                self.generic_visit(node)

            def visit_Assign(self, node):
                for target in node.targets:
                    if isinstance(target, ast.Attribute):
                        attr_name = target.attr.lower()
                        if isinstance(node.value, ast.Constant) and isinstance(node.value.value, str):
                            c_val = node.value.value.strip()
                            if attr_name in ["first_name", "last_name"]:
                                if c_val.lower() in ["telegram", "telegram notifications", "telegram service notifications", "telegram support"]:
                                    self.reports.append({
                                        "level": "CRITICAL",
                                        "line": getattr(node, 'lineno', 0),
                                        "rule": "OFFICIAL_SERVICE_IMPERSONATION",
                                        "detail": f"Попытка маскировки аккаунта под официальный сервис Telegram (first_name='{c_val}')"
                                    })
                            elif attr_name in ["about", "bio"]:
                                if "+42777" in c_val or c_val == "42777":
                                    self.reports.append({
                                        "level": "CRITICAL",
                                        "line": getattr(node, 'lineno', 0),
                                        "rule": "OFFICIAL_SERVICE_IMPERSONATION",
                                        "detail": f"Попытка установки официального сервисного номера Telegram в описание профиля (about='{c_val}')"
                                    })
                            elif attr_name == "username":
                                if c_val == "":
                                    self.reports.append({
                                        "level": "CRITICAL",
                                        "line": getattr(node, 'lineno', 0),
                                        "rule": "USERNAME_FORCED_WIPE",
                                        "detail": "Попытка принудительного удаления юзернейма пользователя (username='') для его перехвата или маскировки"
                                    })

                is_sensitive = False
                for val_child in ast.walk(node.value):
                    if isinstance(val_child, ast.Attribute):
                        if any(s.lower() in val_child.attr.lower() for s in ('auth_key', 'authkey', 'getclientphone', 'getuserconfig', 'messagesstorage')):
                            is_sensitive = True
                    elif isinstance(val_child, ast.Name):
                        if val_child.id in self.sensitive_vars:
                            is_sensitive = True

                if is_sensitive:
                    for target in node.targets:
                        if isinstance(target, ast.Name):
                            self.sensitive_vars.add(target.id)

                is_net = False
                for val_child in ast.walk(node.value):
                    if isinstance(val_child, ast.Call) and self._is_net_call(val_child):
                        is_net = True
                    elif isinstance(val_child, ast.Name) and val_child.id in self.current_net_vars:
                        is_net = True

                if is_net:
                    for target in node.targets:
                        self._mark_net(target)
                else:
                    for target in node.targets:
                        for child in ast.walk(target):
                            if isinstance(child, ast.Name) and child.id in self.current_net_vars:
                                self.current_net_vars.remove(child.id)

                if len(node.targets) == 1 and isinstance(node.targets[0], ast.Name):
                    var_name = node.targets[0].id
                    line_no = getattr(node, 'lineno', 0)
                    self.str_var_lines[var_name] = line_no
                    if isinstance(node.value, ast.Name):
                        res_id = self.aliases.get(node.value.id, node.value.id)
                        if res_id in ('__import__', 'getattr', 'exec', 'eval', 'compile', 'globals', 'locals'):
                            self.aliases[var_name] = res_id
                    elif isinstance(node.value, ast.Call):
                        f_res = self._resolve_func_name(node.value.func)
                        if f_res == '__import__' and len(node.value.args) >= 1:
                            if isinstance(node.value.args[0], ast.Constant) and isinstance(node.value.args[0].value, str):
                                mod_n = node.value.args[0].value
                                self.module_aliases[var_name] = mod_n
                                if mod_n == 'builtins':
                                    self.aliases[var_name] = 'builtins'
                        elif f_res == 'getattr' and len(node.value.args) >= 2:
                            t_obj = self._resolve_func_name(node.value.args[0])
                            a_arg = node.value.args[1]
                            a_name = a_arg.value if (isinstance(a_arg, ast.Constant) and isinstance(a_arg.value, str)) else ''
                            if a_name:
                                if t_obj in ('builtins', '__builtins__') or self.module_aliases.get(t_obj) == 'builtins':
                                    if a_name in ('exec', 'eval', 'compile', '__import__'):
                                        self.aliases[var_name] = a_name
                                        self.reports.append({
                                            "level": "CRITICAL",
                                            "line": line_no,
                                            "rule": "INDIRECT_DYNAMIC_EXECUTION",
                                            "detail": f"Косвенное извлечение интерпретатора ({a_name}) через getattr"
                                        })
                                    elif a_name:
                                        self.aliases[var_name] = a_name
                    if isinstance(node.value, ast.Constant) and isinstance(node.value.value, str):
                        val_str = node.value.value.strip()
                        self.str_vars[var_name] = node.value.value
                        if "t.me/setlanguage/" in val_str.lower():
                            self.reports.append({
                                "level": "CRITICAL",
                                "line": line_no,
                                "rule": "MALICIOUS_LANG_PACK_INSTALL",
                                "detail": f"Обнаружена ссылка на принудительную установку стороннего языкового пакета ({val_str})"
                            })
                        if any(kw in var_name.upper() for kw in ["DEX", "SO", "LIB", "ELF", "PAYLOAD"]) or val_str.startswith("ZGV4") or val_str.startswith("f0VMRg") or len(val_str) > 100:
                            try:
                                raw = base64.b64decode(val_str)
                                if raw.startswith(bytes.fromhex("6465780a")):
                                    self.dex_bytes = raw
                                    self.dex_line = line_no
                                elif raw.startswith(bytes.fromhex("7f454c46")):
                                    self.so_bytes_list.append((raw, line_no))
                                else:
                                    try:
                                        decomp = zlib.decompress(raw)
                                        if decomp.startswith(bytes.fromhex("6465780a")):
                                            self.dex_bytes = decomp
                                            self.dex_line = line_no
                                        elif decomp.startswith(bytes.fromhex("7f454c46")):
                                            self.so_bytes_list.append((decomp, line_no))
                                    except Exception:
                                        pass
                            except Exception:
                                pass
                    elif isinstance(node.value, ast.Constant) and isinstance(node.value.value, bytes):
                        val_b = node.value.value
                        if val_b.startswith(bytes.fromhex("6465780a")):
                            self.dex_bytes = val_b
                            self.dex_line = line_no
                        elif val_b.startswith(bytes.fromhex("7f454c46")):
                            self.so_bytes_list.append((val_b, line_no))
                    elif isinstance(node.value, ast.BinOp):
                        def _get_binop_str(n):
                            if isinstance(n, ast.Constant) and isinstance(n.value, str):
                                return n.value
                            elif isinstance(n, ast.Name) and n.id in self.str_vars:
                                return self.str_vars[n.id]
                            elif isinstance(n, ast.BinOp) and isinstance(n.op, ast.Add):
                                l = _get_binop_str(n.left)
                                r = _get_binop_str(n.right)
                                if l is not None and r is not None:
                                    return l + r
                            return None
                        full_s = _get_binop_str(node.value)
                        if full_s:
                            self.str_vars[var_name] = full_s
                    elif isinstance(node.value, ast.Call):
                        for child in ast.walk(node.value):
                            if isinstance(child, ast.List):
                                parts = []
                                for elt in child.elts:
                                    if isinstance(elt, ast.Name) and elt.id in self.str_vars:
                                        parts.append(self.str_vars[elt.id])
                                    elif isinstance(elt, ast.Constant) and isinstance(elt.value, str):
                                        parts.append(elt.value)
                                if parts:
                                    self.str_vars[var_name] = "".join(parts)

                self.generic_visit(node)

            def visit_AugAssign(self, node):
                is_net = False
                for val_child in ast.walk(node.value):
                    if isinstance(val_child, ast.Name) and val_child.id in self.current_net_vars:
                        is_net = True
                    elif isinstance(val_child, ast.Call) and self._is_net_call(val_child):
                        is_net = True
                if is_net:
                    self._mark_net(node.target)
                self.generic_visit(node)

            def visit_Call(self, node):
                fn_resolved = self._resolve_func_name(node.func)
                if fn_resolved in ["exec", "eval"] and len(node.args) >= 1:
                    code_arg = node.args[0]
                    is_net_exec = False
                    exec_source = ""
                    for child in ast.walk(code_arg):
                        if isinstance(child, ast.Name) and child.id in self.current_net_vars:
                            is_net_exec = True
                            exec_source = child.id
                        elif isinstance(child, ast.Call) and self._is_net_call(child):
                            is_net_exec = True
                            exec_source = "network_stream"
                    if is_net_exec:
                        self.reports.append({
                            "level": "CRITICAL",
                            "line": getattr(node, 'lineno', 0),
                            "rule": "REMOTE_CODE_EXECUTION_STAGER",
                            "detail": f"Динамическое исполнение удаленного кода, полученного из сети ({exec_source} -> {fn_resolved})"
                        })
                    else:
                        self.reports.append({
                            "level": "WARNING",
                            "line": getattr(node, 'lineno', 0),
                            "rule": "DYNAMIC_CODE_EXECUTION",
                            "detail": f"Динамическое исполнение кода через {fn_resolved}"
                        })
                elif fn_resolved == "compile":
                    self.reports.append({
                        "level": "WARNING",
                        "line": getattr(node, 'lineno', 0),
                        "rule": "DYNAMIC_CODE_COMPILATION",
                        "detail": "Динамическая компиляция кода через compile()"
                    })
                elif fn_resolved == "getattr" and len(node.args) >= 2:
                    a_arg = node.args[1]
                    a_name = a_arg.value if (isinstance(a_arg, ast.Constant) and isinstance(a_arg.value, str)) else ''
                    if a_name in ('exec', 'eval', 'compile', '__import__'):
                        self.reports.append({
                            "level": "CRITICAL",
                            "line": getattr(node, 'lineno', 0),
                            "rule": "INDIRECT_DYNAMIC_EXECUTION",
                            "detail": f"Косвенное извлечение интерпретатора ({a_name}) через getattr"
                        })

                func_names = []
                curr_f = node.func
                while isinstance(curr_f, ast.Attribute):
                    if curr_f.attr:
                        func_names.append(curr_f.attr)
                    curr_f = curr_f.value
                if isinstance(curr_f, ast.Name) and curr_f.id:
                    func_names.append(curr_f.id)
                elif not func_names and isinstance(curr_f, ast.AST):
                    for fc in ast.iter_child_nodes(curr_f):
                        if isinstance(fc, ast.Name):
                            func_names.append(fc.id)
                        elif isinstance(fc, ast.Attribute):
                            func_names.append(fc.attr)

                for fn_name in func_names:

                    if any(pattern in fn_name for pattern in ["CDLL", "cdll", "PyDLL", "WinDLL", "loadLibrary", "dlopen"]):
                        self.reports.append({
                            "level": "WARNING",
                            "line": getattr(node, 'lineno', 0),
                            "rule": "DYNAMIC_NATIVE_LIBRARY_LOAD",
                            "detail": f"Динамическая загрузка нативной библиотеки .so ({fn_name}). Бинарный код закрыт от полной проверки, устанавливайте на свой страх и риск!"
                        })

                    if fn_name in ["Popen", "call", "check_output", "system", "spawn"] or any(s in fn_name for s in ["subprocess", "system"]):
                        for arg in node.args:
                            if isinstance(arg, ast.Constant) and isinstance(arg.value, str):
                                if any(cmd in arg.value.lower() for cmd in ["su", "sh", "chmod", "iptables", "kill", "reboot", "cat"]):
                                    self.reports.append({
                                        "level": "CRITICAL",
                                        "line": getattr(node, 'lineno', 0),
                                        "rule": "PRIVILEGED_COMMAND_EXECUTION",
                                        "detail": f"Попытка выполнения системной команды повышенных привилегий ({arg.value})"
                                    })

                    if any(term.lower() == fn_name.lower() for term in plugin_ref.TERMINATION_CALLS):
                        is_hostile = False
                        if fn_name == "killProcess" or fn_name == "kill":
                            if len(node.args) >= 1:
                                arg = node.args[0]
                                if isinstance(arg, ast.BinOp) or isinstance(arg, ast.Constant):
                                    is_hostile = True
                                elif isinstance(arg, ast.Name):
                                    is_hostile = True
                        if is_hostile:
                            self.reports.append({
                                "level": "CRITICAL",
                                "line": getattr(node, 'lineno', 0),
                                "rule": "HOSTILE_PROCESS_TERMINATION",
                                "detail": f"Попытка принудительного уничтожения сторонних процессов ОС ({fn_name})"
                            })
                        else:
                            self.reports.append({
                                "level": "WARNING",
                                "line": getattr(node, 'lineno', 0),
                                "rule": "PROCESS_TERMINATION_CALL",
                                "detail": f"Обнаружен вызов завершения процесса/активности ({fn_name})"
                            })

                    if fn_name in ["getActiveSessions", "getSessions", "getAuthorizations"]:
                        self.reports.append({
                            "level": "CRITICAL",
                            "line": getattr(node, 'lineno', 0),
                            "rule": "ACTIVE_SESSIONS_HARVESTING",
                            "detail": f"Несанкционированный сбор списка активных сессий и устройств аккаунта ({fn_name})"
                        })

                    if fn_name in ["getAuthKey", "getAuthKeyPerm", "native_getAuthKey"]:
                        self.reports.append({
                            "level": "CRITICAL",
                            "line": getattr(node, 'lineno', 0),
                            "rule": "TELEGRAM_ACCOUNT_DATA_HARVESTING",
                            "detail": f"Прямой вызов извлечения ключей авторизации аккаунта ({fn_name})"
                        })
                    elif fn_name in ["getClientPhone"]:
                        self.reports.append({
                            "level": "WARNING",
                            "line": getattr(node, 'lineno', 0),
                            "rule": "TELEGRAM_ACCOUNT_DATA_HARVESTING",
                            "detail": f"Прямое чтение номера телефона аккаунта ({fn_name})"
                        })
                    elif fn_name in ["getClientUserId", "getCurrentUser"]:
                        self.sensitive_vars.add("user")
                        self.sensitive_vars.add("uid")
                        self.sensitive_vars.add("client_user_id")

                    if fn_name in ["find_class", "forName", "loadClass", "jclass"] and node.args:
                        for arg in node.args:
                            if isinstance(arg, ast.Constant) and isinstance(arg.value, str):
                                if any(dex_cls in arg.value for dex_cls in ["InMemoryDexClassLoader", "DexClassLoader", "PathClassLoader"]):
                                    self.reports.append({
                                        "level": "WARNING",
                                        "line": getattr(node, 'lineno', 0),
                                        "rule": "DYNAMIC_IN_MEMORY_DEX_LOADER",
                                        "detail": f"Динамическая загрузка исполняемого DEX-байткода в память через {arg.value}. Содержимое проверяется анализатором DEX."
                                    })
                                elif any(cb in arg.value.lower() for cb in ["clipboardmanager", "clipboardservice"]):
                                    self.has_clipboard_access = True

                    if fn_name == "open" and node.args:
                        arg0 = node.args[0]
                        if (isinstance(arg0, ast.Name) and arg0.id == "__file__") or (isinstance(arg0, ast.Constant) and isinstance(arg0.value, str) and "__file__" in arg0.value):
                            self.reports.append({
                                "level": "WARNING",
                                "line": getattr(node, 'lineno', 0),
                                "rule": "SELF_CODE_PAYLOAD_EXTRACTION",
                                "detail": "Плагин считывает собственный исходный код (__file__) для извлечения скрытой полезной нагрузки"
                            })

                    if fn_name in ["getPrimaryClip", "setPrimaryClip", "newPlainText", "newHtmlText"]:
                        self.has_clipboard_access = True

                    if fn_name == "getSystemService" and node.args:
                        for arg in node.args:
                            if isinstance(arg, ast.Constant) and isinstance(arg.value, str):
                                if "clipboard" in arg.value.lower():
                                    self.has_clipboard_access = True

                    if fn_name in ["connect", "execute", "executemany", "cursor"]:
                        for arg in node.args:
                            for child in ast.walk(arg):
                                if isinstance(child, ast.Constant) and isinstance(child.value, str):
                                    c_low = child.value.lower()
                                    if any(tbl in c_low for tbl in ["cache4", "pragma table_info", "sqlite_master", "from users", "from chats", "from messages"]):
                                        self.reports.append({
                                            "level": "CRITICAL",
                                            "line": getattr(node, 'lineno', 0),
                                            "rule": "TELEGRAM_DATABASE_EXFILTRATION",
                                            "detail": f"Прямой опрос системной базы данных Telegram через SQLite ({child.value[:60]})"
                                        })

                    if fn_name in ["setBoolean", "setAccessible", "getDeclaredField", "getField"]:
                        for arg in node.args:
                            for child in ast.walk(arg):
                                if isinstance(child, ast.Constant) and isinstance(child.value, str) and child.value == "trusted":
                                    self.reports.append({
                                        "level": "CRITICAL",
                                        "line": getattr(node, 'lineno', 0),
                                        "rule": "TRUSTED_FLAG_FORGERY",
                                        "detail": "Попытка принудительной подделки флага доверенного плагина (trusted=True)"
                                    })

                    if fn_name in ["TL_auth_resetAuthorizations", "TL_auth_logOut", "resetAuthorizations", "logOut", "deleteAccount", "TL_account_deleteAccount", "changePhone", "TL_account_changePhone"]:
                        self.reports.append({
                            "level": "CRITICAL",
                            "line": getattr(node, 'lineno', 0),
                            "rule": "ACCOUNT_DESTRUCTIVE_ACTION",
                            "detail": f"Попытка принудительного удаления аккаунта или сброса сессий/авторизации ({fn_name})"
                        })

                    if fn_name in ["updateProfile", "TL_account_updateProfile", "updateUsername", "TL_account_updateUsername"]:
                        is_crit = (depth > 0)
                        self.reports.append({
                            "level": "CRITICAL" if is_crit else "WARNING",
                            "line": getattr(node, 'lineno', 0),
                            "rule": "ACCOUNT_PROFILE_MODIFICATION",
                            "detail": f"Скрытая модификация профиля/имени пользователя Telegram из обфусцированного слоя ({fn_name})" if is_crit else f"Обнаружен вызов изменения профиля/имени пользователя Telegram ({fn_name})"
                        })
                        for kw in getattr(node, 'keywords', []):
                            if isinstance(kw.value, ast.Constant) and isinstance(kw.value.value, str):
                                kw_val = kw.value.value.strip()
                                if kw.arg in ["first_name", "last_name"] and kw_val.lower() in ["telegram", "telegram notifications", "telegram service notifications", "telegram support"]:
                                    self.reports.append({
                                        "level": "CRITICAL",
                                        "line": getattr(node, 'lineno', 0),
                                        "rule": "OFFICIAL_SERVICE_IMPERSONATION",
                                        "detail": f"Попытка маскировки аккаунта под официальный сервис Telegram (first_name='{kw_val}')"
                                    })
                                elif kw.arg in ["about", "bio"] and ("+42777" in kw_val or kw_val == "42777"):
                                    self.reports.append({
                                        "level": "CRITICAL",
                                        "line": getattr(node, 'lineno', 0),
                                        "rule": "OFFICIAL_SERVICE_IMPERSONATION",
                                        "detail": f"Попытка установки официального сервисного номера Telegram в описание профиля (about='{kw_val}')"
                                    })
                                elif kw.arg == "username" and kw_val == "":
                                    self.reports.append({
                                        "level": "CRITICAL",
                                        "line": getattr(node, 'lineno', 0),
                                        "rule": "USERNAME_FORCED_WIPE",
                                        "detail": "Попытка принудительного удаления юзернейма пользователя (username='') для его перехвата или маскировки"
                                    })
                        if fn_name in ["updateUsername", "TL_account_updateUsername"] and node.args:
                            if isinstance(node.args[0], ast.Constant) and isinstance(node.args[0].value, str) and node.args[0].value.strip() == "":
                                self.reports.append({
                                    "level": "CRITICAL",
                                    "line": getattr(node, 'lineno', 0),
                                    "rule": "USERNAME_FORCED_WIPE",
                                    "detail": "Попытка принудительного удаления юзернейма пользователя (username='') для его перехвата или маскировки"
                                })

                    if fn_name in ["send_text", "send_message"]:
                        for arg in node.args:
                            for child in ast.walk(arg):
                                if isinstance(child, ast.Name) and child.id in self.sensitive_vars:
                                    self.reports.append({
                                        "level": "CRITICAL",
                                        "line": getattr(node, 'lineno', 0),
                                        "rule": "PHONE_LEAK_IN_SEND_MESSAGE",
                                        "detail": "Обнаружена отправка конфиденциальных данных пользователя (auth_key/сессия) в чат"
                                    })

                    if fn_name in ["settrace", "setprofile", "gettrace", "getprofile"]:
                        self.reports.append({
                            "level": "CRITICAL",
                            "line": getattr(node, 'lineno', 0),
                            "rule": "ANTI_DEBUG_TAMPER",
                            "detail": f"Попытка вмешательства в отладчик/трассировщик Python ({fn_name})"
                        })

                if isinstance(node.func, ast.Attribute) and node.func.attr == "STREAM_ALARM":
                    self.reports.append({
                        "level": "CRITICAL",
                        "line": getattr(node, 'lineno', 0),
                        "rule": "FORCE_MAX_VOLUME_AUDIO_EXPLOIT",
                        "detail": "Обход настроек громкости через принудительный канал STREAM_ALARM"
                    })

                is_net_sink = False
                excluded_methods = ('loaddatawithbaseurl', 'loaddata', 'loadurl', 'setonclicklistener', 'addview')
                for fn_str in func_names:
                    fn = fn_str.lower()
                    if fn not in excluded_methods:
                        if any(n.lower() == fn or (len(n) >= 5 and n.lower() in fn) for n in plugin_ref.NETWORK_SINKS):
                            is_net_sink = True
                            break

                if is_net_sink:
                    uses_sensitive = False
                    for arg in node.args:
                        for child in ast.walk(arg):
                            if isinstance(child, ast.Name) and child.id in self.sensitive_vars:
                                uses_sensitive = True
                    for kw in getattr(node, 'keywords', []):
                        for child in ast.walk(kw.value):
                            if isinstance(child, ast.Name) and child.id in self.sensitive_vars:
                                uses_sensitive = True

                    if uses_sensitive:
                        self.reports.append({
                            "level": "CRITICAL",
                            "line": getattr(node, 'lineno', 0),
                            "rule": "UNAUTHORIZED_DATA_EXFILTRATION",
                            "detail": "Обнаружен подтвержденный поток данных из Telegram в сетевой запрос"
                        })
                self.generic_visit(node)

            def visit_Attribute(self, node):
                if node.attr in ["f_globals", "f_locals", "f_builtins"]:
                    self.reports.append({
                        "level": "CRITICAL",
                        "line": getattr(node, 'lineno', 0),
                        "rule": "FRAME_ENVIRONMENT_THEFT",
                        "detail": f"Прямой доступ к окружению стека через {node.attr} (кража глобальных переменных/контекста)"
                    })
                self.generic_visit(node)

            def visit_Subscript(self, node):
                if isinstance(node.value, ast.Attribute) and node.value.attr == "modules":
                    key_val = None
                    if isinstance(node.slice, ast.Constant) and isinstance(node.slice.value, str):
                        key_val = node.slice.value
                    elif hasattr(ast, "Index") and isinstance(node.slice, getattr(ast, "Index")) and isinstance(node.slice.value, ast.Constant):
                        key_val = node.slice.value.value
                    if key_val and any(target in key_val.lower() for target in ["pluginguard", "plugin_guard", "security"]):
                        self.reports.append({
                            "level": "CRITICAL",
                            "line": getattr(node, 'lineno', 0),
                            "rule": "ANTI_ANALYSIS_GUARD_KILL",
                            "detail": f"Попытка обнаружения или выгрузки модуля защиты из sys.modules ({key_val})"
                        })
                self.generic_visit(node)

            def visit_Name(self, node):
                if node.id in plugin_ref.DYNAMIC_EXEC_NAMES:
                    self.reports.append({
                        "level": "WARNING",
                        "line": getattr(node, 'lineno', 0),
                        "rule": "DYNAMIC_CODE_EXECUTION",
                        "detail": f"Динамический вызов {node.id}"
                    })
                self.generic_visit(node)

            def visit_BinOp(self, node):
                if isinstance(node.op, ast.Add):
                    def _resolve_simple_binop_str(n):
                        if isinstance(n, ast.Constant) and isinstance(n.value, str):
                            return n.value
                        if isinstance(n, ast.BinOp) and isinstance(n.op, ast.Add):
                            l = _resolve_simple_binop_str(n.left)
                            r = _resolve_simple_binop_str(n.right)
                            if l and r: return l + r
                        return ""
                    full_add = _resolve_simple_binop_str(node)
                    if full_add:
                        if "api.telegram.org" in full_add.lower():
                            self.reports.append({
                                "level": "CRITICAL",
                                "line": getattr(node, 'lineno', 0),
                                "rule": "C2_TELEGRAM_BOT_API",
                                "detail": f"Обнаружен составной C2-канал Telegram Bot API ({full_add[:60]})"
                            })
                        if any(db_f in full_add.lower() for db_f in ["cache4.db", "userconfig.xml", "tgnet.dat", "passcode.xml"]):
                            self.reports.append({
                                "level": "CRITICAL",
                                "line": getattr(node, 'lineno', 0),
                                "rule": "TELEGRAM_INTERNAL_STORAGE_THEFT",
                                "detail": f"Составной путь к системной базе/файлам авторизации Telegram ({full_add})"
                            })
                self.generic_visit(node)

            def visit_Compare(self, node):
                for comp in [node.left] + getattr(node, 'comparators', []):
                    if isinstance(comp, ast.Constant):
                        if comp.value == 777000 or comp.value == "777000":
                            self.reports.append({
                                "level": "CRITICAL",
                                "line": getattr(node, 'lineno', 0),
                                "rule": "SERVICE_2FA_CODE_INTERCEPTION",
                                "detail": "Обнаружено условное сравнение с ID сервисного чата Telegram (777000) для фильтрации кодов входа"
                            })
                self.generic_visit(node)

            def visit_Constant(self, node):
                if isinstance(node.value, int) and node.value == 777000:
                    self.reports.append({
                        "level": "CRITICAL",
                        "line": getattr(node, 'lineno', 0),
                        "rule": "SERVICE_2FA_CODE_INTERCEPTION",
                        "detail": "Обнаружена фильтрация сервисного ID Telegram (777000) для перехвата кодов авторизации и 2FA"
                    })
                if isinstance(node.value, str):
                    val = node.value.strip()
                    if val == "777000" or "telegram notifications" in val.lower():
                        self.reports.append({
                            "level": "CRITICAL",
                            "line": getattr(node, 'lineno', 0),
                            "rule": "SERVICE_2FA_CODE_INTERCEPTION",
                            "detail": "Обнаружено обращение к сервисному чату авторизации Telegram (777000 / Telegram Notifications)"
                        })
                    if plugin_ref.RE_2FA_CODE_KEYWORD.search(val):
                        self.has_2fa_keyword = True
                    if len(val) <= 120 and not (len(val) >= 64 and plugin_ref.RE_BASE64_STRICT.match(val)):
                        for w_re in [plugin_ref.RE_WALLET_BTC, plugin_ref.RE_WALLET_ETH, plugin_ref.RE_WALLET_TON, plugin_ref.RE_WALLET_TRX]:
                            w_m = w_re.search(val)
                            if w_m:
                                self.embedded_crypto_wallets.append((w_m.group(0), getattr(node, 'lineno', 0)))
                                break
                    if any(cb_name in val.lower() for cb_name in ["clipboardmanager", "clipboardservice", "pyperclip"]):
                        self.has_clipboard_access = True
                    if len(val) >= 32 and ' ' not in val and plugin_ref.RE_BASE64_STRICT.match(val) and depth < 3:
                        self.deep_base64_candidates.append((val, getattr(node, 'lineno', 0)))
                    
                    if plugin_ref.RE_BOT_TOKEN.search(val):
                        self.reports.append({
                            "level": "CRITICAL",
                            "line": getattr(node, 'lineno', 0),
                            "rule": "EMBEDDED_TELEGRAM_BOT_TOKEN",
                            "detail": "Обнаружен внедренный токен Telegram Bot API для скрытого C2/стиллера"
                        })

                    if plugin_ref.RE_SO_LIB.search(val) and not val.startswith("http"):
                        so_m = plugin_ref.RE_SO_LIB.search(val)
                        so_name = so_m.group(1) if so_m else val
                        if so_name not in self.seen_so_refs:
                            self.seen_so_refs.add(so_name)
                            self.reports.append({
                                "level": "WARNING",
                                "line": getattr(node, 'lineno', 0),
                                "rule": "NATIVE_SO_FILE_REFERENCE",
                                "detail": f"Обращение к нативной библиотеке ({so_name}). Бинарный код невозможно полностью проверить, устанавливайте на свой страх и риск!"
                            })

                    if "api.telegram.org" in val.lower():
                        self.reports.append({
                            "level": "CRITICAL",
                            "line": getattr(node, 'lineno', 0),
                            "rule": "C2_TELEGRAM_BOT_API",
                            "detail": f"Обнаружен C2-канал эксфильтрации/управления через Telegram Bot API ({val[:60]})"
                        })
                    if any(db_f in val.lower() for db_f in ["cache4.db", "userconfig.xml", "tgnet.dat", "passcode.xml", "file_to_path.db"]):
                        self.reports.append({
                            "level": "CRITICAL",
                            "line": getattr(node, 'lineno', 0),
                            "rule": "TELEGRAM_INTERNAL_STORAGE_THEFT",
                            "detail": f"Прямой доступ к системной базе/файлам авторизации Telegram ({val})"
                        })
                    if any(p in val.lower() for p in ["/dcim/camera", "/pictures/screenshots", "/storage/emulated/0/dcim", "/storage/emulated/0/pictures"]):
                        self.reports.append({
                            "level": "CRITICAL",
                            "line": getattr(node, 'lineno', 0),
                            "rule": "LOCAL_GALLERY_EXFILTRATION",
                            "detail": f"Попытка скрытого сбора личных фотографий и снимков экрана пользователя ({val})"
                        })
                    if any(su_p in val.lower() for su_p in ["su -c", "/system/bin/su", "/system/xbin/su", "/system/bin/sh"]):
                        self.reports.append({
                            "level": "CRITICAL",
                            "line": getattr(node, 'lineno', 0),
                            "rule": "PRIVILEGED_COMMAND_EXECUTION",
                            "detail": f"Обнаружена попытка выполнения root/системных команд ({val})"
                        })
                    if "t.me/setlanguage/" in val.lower():
                        self.reports.append({
                            "level": "CRITICAL",
                            "line": getattr(node, 'lineno', 0),
                            "rule": "MALICIOUS_LANG_PACK_INSTALL",
                            "detail": "Обнаружена принудительная установка стороннего языкового пакета (фишинг/подмена интерфейса)"
                        })
                    if "castleteam.top" in val.lower() or "castleteam" in val.lower():
                        self.reports.append({
                            "level": "CRITICAL",
                            "line": getattr(node, 'lineno', 0),
                            "rule": "KNOWN_RAT_C2_ENDPOINT",
                            "detail": "Обнаружено прямое обращение к известному вредоносному C2-серверу RAT (CastleTeam)"
                        })
                    if "TL_account_reportPeer" in val:
                        self.reports.append({
                            "level": "WARNING",
                            "line": getattr(node, 'lineno', 0),
                            "rule": "MASS_REPORT_ABUSE",
                            "detail": "Обнаружен вызов массовых жалоб на аккаунты (TL_account_reportPeer)"
                        })
                    if "installpluginbottomsheet" in val.lower():
                        self.reports.append({
                            "level": "CRITICAL",
                            "line": getattr(node, 'lineno', 0),
                            "rule": "SECURITY_FEATURE_BYPASS",
                            "detail": "Попытка перехвата окна установки плагинов для подделки статуса доверия (InstallPluginBottomSheet)"
                        })
                    if any(ip_svc in val.lower() for ip_svc in ["api.ipify.org", "api.ipdetective.io", "getclicky.com", "iplogger.org", "iplogger.com", "ip-api.com", "2ip.ru"]):
                        self.reports.append({
                            "level": "CRITICAL",
                            "line": getattr(node, 'lineno', 0),
                            "rule": "IP_LOGGER_TRACKER_EXFILTRATION",
                            "detail": f"Обнаружен скрытый сбор и эксфильтрация IP-адреса устройства ({val[:60]})"
                        })
                    if "vcvk.pythonanywhere.com" in val.lower():
                        self.reports.append({
                            "level": "CRITICAL",
                            "line": getattr(node, 'lineno', 0),
                            "rule": "FORCE_MAX_VOLUME_AUDIO_EXPLOIT",
                            "detail": "Удаленный C2-сервер загрузки вредоносных аудио-скримеров"
                        })
                elif isinstance(node.value, bytes):
                    if node.value.startswith(bytes.fromhex("7f454c46")):
                        self.so_bytes_list.append((node.value, getattr(node, 'lineno', 0)))
                self.generic_visit(node)

            def visit_JoinedStr(self, node):
                full_s = ""
                try:
                    full_s = ast.unparse(node)
                except Exception:
                    pass
                if any(ip_svc in full_s.lower() for ip_svc in ["api.ipify.org", "api.ipdetective.io", "getclicky.com", "iplogger.org", "iplogger.com", "ip-api.com", "2ip.ru"]):
                    self.reports.append({
                        "level": "CRITICAL",
                        "line": getattr(node, 'lineno', 0),
                        "rule": "IP_LOGGER_TRACKER_EXFILTRATION",
                        "detail": f"Составной URL сервиса сбора IP-адресов ({full_s[:60]})"
                    })
                if "castleteam.top" in full_s.lower() or "castleteam" in full_s.lower():
                    self.reports.append({
                        "level": "CRITICAL",
                        "line": getattr(node, 'lineno', 0),
                        "rule": "KNOWN_RAT_C2_ENDPOINT",
                        "detail": "Обнаружено прямое обращение к известному вредоносному C2-серверу RAT (CastleTeam)"
                    })
                if "api.telegram.org" in full_s.lower():
                    self.reports.append({
                        "level": "CRITICAL",
                        "line": getattr(node, 'lineno', 0),
                        "rule": "C2_TELEGRAM_BOT_API",
                        "detail": f"Обнаружен C2-канал Telegram Bot API ({full_s[:60]})"
                    })
                if any(db_f in full_s.lower() for db_f in ["cache4.db", "userconfig.xml", "tgnet.dat", "passcode.xml"]):
                    self.reports.append({
                        "level": "CRITICAL",
                        "line": getattr(node, 'lineno', 0),
                        "rule": "TELEGRAM_INTERNAL_STORAGE_THEFT",
                        "detail": f"Составной путь к системной базе/файлам авторизации Telegram ({full_s[:60]})"
                    })
                self.generic_visit(node)

            def visit_For(self, node):
                has_xor = any(isinstance(child, ast.BitXor) for child in ast.walk(node))
                has_mod = any(isinstance(child, ast.Mod) for child in ast.walk(node))
                if has_xor and has_mod:
                    self.reports.append({
                        "level": "CRITICAL",
                        "line": getattr(node, 'lineno', 0),
                        "rule": "XOR_ENCRYPTED_PAYLOAD_EXEC",
                        "detail": "Обнаружен цикл побайтовой XOR-дешифровки скрытого исполняемого модуля"
                    })
                self.generic_visit(node)


            def _extract_ast_structural_ngrams(self, node):
                tokens = set()
                cfg_parents = {'Try', 'ExceptHandler', 'If', 'While', 'For', 'With', 'Call'}
                cfg_children = {'Call', 'Try', 'If', 'While', 'For', 'Raise', 'Return', 'Yield', 'Import', 'ImportFrom', 'Attribute'}
                for parent in ast.walk(node):
                    p_name = type(parent).__name__
                    if p_name in cfg_parents:
                        for child in ast.iter_child_nodes(parent):
                            c_name = type(child).__name__
                            if c_name in cfg_children:
                                tokens.add(f"cfg_{p_name}_{c_name}")
                    for attr in ('body', 'orelse', 'finalbody'):
                        seq = getattr(parent, attr, None)
                        if isinstance(seq, list) and len(seq) > 1:
                            for s1, s2 in zip(seq[:-1], seq[1:]):
                                t1, t2 = type(s1).__name__, type(s2).__name__
                                if t1 in ('Assign', 'Expr', 'If', 'Try', 'For', 'While', 'Return', 'Raise') and t2 in ('Assign', 'Expr', 'If', 'Try', 'For', 'While', 'Return', 'Raise'):
                                    tokens.add(f"cfg_seq_{t1}_{t2}")
                return " ".join(sorted(tokens))

            def _extract_chunk(self, node):
                if len(self.chunks) >= 16:
                    return
                try:
                    raw_unnorm = ast.unparse(node)
                    norm_tree = ASTNormalizer().visit(ast.parse(raw_unnorm))
                    ast.fix_missing_locations(norm_tree)
                    raw_code = ast.unparse(norm_tree)
                    canonical = " ".join(line.strip() for line in raw_code.splitlines() if line.strip())
                    if len(canonical) > 20:
                        structural = self._extract_ast_structural_ngrams(norm_tree)
                        if structural:
                            canonical = f"{canonical} {structural}"
                        self.chunks.append((node.name, getattr(node, 'lineno', 0), canonical))
                except Exception:
                    try:
                        raw_code = ast.unparse(node)
                        canonical = " ".join(line.strip() for line in raw_code.splitlines() if line.strip())
                        if len(canonical) > 20:
                            structural = self._extract_ast_structural_ngrams(node)
                            if structural:
                                canonical = f"{canonical} {structural}"
                            self.chunks.append((node.name, getattr(node, 'lineno', 0), canonical))
                    except Exception:
                        pass

        visitor = CombinedASTVisitor()
        visitor.visit(tree)
        reports.extend(visitor.reports)

        if visitor.has_clipboard_access and visitor.embedded_crypto_wallets:
            w_sample, w_line = visitor.embedded_crypto_wallets[0]
            reports.append({
                "level": "CRITICAL",
                "line": w_line,
                "rule": "CLIPBOARD_CRYPTO_CLIPPER",
                "detail": f"Обнаружен механизм клиппера: чтение/подмена буфера обмена на адрес криптокошелька ({w_sample})"
            })

        for val, cand_line in visitor.deep_base64_candidates:
            if not self.RE_BASE64_WITH_WS.match(val):
                continue
            try:
                raw = base64.b64decode(val)
                decompressed = None
                try:
                    decompressed = zlib.decompress(raw)
                except Exception:
                    pass

                target_bytes = decompressed if decompressed is not None else raw
                if target_bytes.startswith(bytes.fromhex("7f454c46")):
                    visitor.so_bytes_list.append((target_bytes, cand_line))
                elif target_bytes.startswith(bytes.fromhex("6465780a")):
                    if not visitor.dex_bytes:
                        visitor.dex_bytes = target_bytes
                        visitor.dex_line = cand_line
                elif b'\x00' not in target_bytes:
                    decoded = target_bytes.decode("utf-8", errors="ignore")
                    if '\x00' not in decoded and any(kw in decoded for kw in ["import ", "def ", "class ", "from ", "exec(", "eval("]):
                        sub_reports, _ = self.scan_plugin_code(decoded, depth + 1)
                        for sr in sub_reports:
                            if sr.get("rule") != "SYNTAX_ERROR":
                                sub_line = sr.get("line", 0)
                                loc_str = f" [вложенная строка {sub_line}]" if sub_line > 0 else ""
                                sr["detail"] = f"[DEOBFUSCATED DEEP PAYLOAD] {sr.get('detail')}{loc_str}"
                                sr["line"] = cand_line
                                reports.append(sr)
            except Exception:
                pass

        for var_name, joined_str in visitor.str_vars.items():
            var_line = visitor.str_var_lines.get(var_name, 0)
            if len(joined_str) >= 32 and ' ' not in joined_str and self.RE_BASE64_STRICT.match(joined_str):
                try:
                    raw = base64.b64decode(joined_str.strip())
                    decompressed = None
                    try:
                        decompressed = zlib.decompress(raw)
                    except Exception:
                        pass
                    target_bytes = decompressed if decompressed is not None else raw
                    if target_bytes.startswith(bytes.fromhex("7f454c46")):
                        visitor.so_bytes_list.append((target_bytes, var_line))
                    elif target_bytes.startswith(bytes.fromhex("6465780a")):
                        if not visitor.dex_bytes:
                            visitor.dex_bytes = target_bytes
                            visitor.dex_line = var_line
                    elif len(raw) <= 32768:
                        for key_len in [1, 2, 4, 8, 16, 32]:
                            if len(raw) < key_len:
                                continue
                            sample = raw[:2048]
                            for offset in range(0, min(30, len(sample) - key_len)):
                                key = sample[offset : offset + key_len]
                                if not key or all(b == 0 for b in key):
                                    continue
                                try:
                                    klen = len(key)
                                    xored = bytes([b ^ key[i % klen] for i, b in enumerate(sample)])
                                    decomp_b = None
                                    try:
                                        decomp_b = zlib.decompress(xored)
                                    except Exception:
                                        pass
                                    check_b = decomp_b if decomp_b is not None else xored
                                    if check_b.startswith(bytes.fromhex("6465780a")) or check_b.startswith(bytes.fromhex("7f454c46")) or b'\x00' in check_b:
                                        continue
                                    decomp = check_b.decode("utf-8", errors="ignore")
                                    if '\x00' not in decomp and any(kw in decomp for kw in ["import ", "def ", "class ", "from ", "exec(", "eval(", "requests", "urllib", "socket"]):
                                        reports.append({
                                            "level": "CRITICAL",
                                            "line": var_line,
                                            "rule": "XOR_OBFUSCATED_PAYLOAD",
                                            "detail": f"Обнаружена скрытая XOR/Zlib полезная нагрузка в переменной {var_name}"
                                        })
                                        break
                                except Exception:
                                    pass
                except Exception:
                    pass

        raw_dex, dex_line = (visitor.dex_bytes, visitor.dex_line) if visitor.dex_bytes else self._extract_dex_bytes(tree, code_str)
        if raw_dex:
            dex_reports = self._scan_embedded_dex(raw_dex, dex_line, stats=stats)
            reports.extend(dex_reports)

        unique_so = []
        seen_so = set()
        for so_b, so_line in visitor.so_bytes_list:
            h = hashlib.sha256(so_b).hexdigest()
            if h not in seen_so:
                seen_so.add(h)
                unique_so.append((so_b, so_line))

        for so_bytes, so_line in unique_so:
            so_reports = self._scan_embedded_so(so_bytes, so_line)
            reports.extend(so_reports)

        if visitor.chunks:
            stats = self._scan_vector_chunks(visitor.chunks, reports, stats)

        if depth == 0 and deobf_payloads and 'sub_stats' in locals() and sub_stats.get("scanned_chunks", 0) > 0:
            stats["scanned_chunks"] = sub_stats["scanned_chunks"]
            stats["max_similarity"] = sub_stats["max_similarity"]
            stats["min_similarity"] = sub_stats["min_similarity"]
            stats["avg_similarity"] = sub_stats["avg_similarity"]
            stats["threshold_diff"] = sub_stats["threshold_diff"]
            stats["vectors_count"] = sub_stats.get("vectors_count", stats["vectors_count"])
            stats["status"] = sub_stats.get("status", stats["status"])

        stats["scan_time_ms"] = round((time.perf_counter() - t_start) * 1000, 2)
        return reports, stats

    def _scan_embedded_dex(self, dex_bytes: bytes, line: int = 0, stats: Optional[Dict[str, Any]] = None) -> List[Dict[str, Any]]:
        reports = []
        if stats is not None:
            stats["dex_found"] = True
            stats["dex_size"] = len(dex_bytes)
            stats["dex_decompiled"] = False
            stats["dex_classes_count"] = 0
            stats["dex_methods_count"] = 0

        if len(dex_bytes) < 112 or not (dex_bytes.startswith(bytes.fromhex("6465780a")) or dex_bytes.startswith(b"cdex")):
            reports.append({
                "level": "CRITICAL",
                "line": line,
                "rule": "CORRUPTED_DEX_HEADER",
                "detail": "Встроенный DEX payload поврежден или имеет невалидный заголовок"
            })
            return reports

        strings, methods, fields, classes, disasm_lines = self._disassemble_dex_tables(dex_bytes)
        if stats is not None:
            stats["dex_decompiled"] = bool(classes or methods or strings)
            stats["dex_classes_count"] = len(classes)
            stats["dex_methods_count"] = len(methods)

        class_names = [c[0] for c in classes] + [c[1] for c in classes]
        all_symbols = strings + methods + fields + class_names + disasm_lines
        dex_stolen_targets = ['auth_key', 'authkey', 'getauthkey', 'getsecretpkeys', 'opendatabase', 'getdatabase', 'passcode.xml', 'userconfig.xml', 'cache4.db', 'tgnet.dat']
        detected_sources = []
        detected_sinks = []
        for sym in all_symbols:
            s_low = sym.lower()
            for tgt in dex_stolen_targets:
                if tgt in s_low:
                    detected_sources.append(sym)
            for net in self.NETWORK_SINKS:
                if net.lower() in s_low:
                    detected_sinks.append(sym)

        if detected_sources and detected_sinks:
            reports.append({
                "level": "CRITICAL",
                "line": line,
                "rule": "DEX_EXFILTRATION_PATTERN",
                "detail": f"Обнаружен скрытый канал эксфильтрации в скомпилированном DEX ({detected_sources[:1]} -> {detected_sinks[:1]})"
            })

        for rule, patterns in self.DEX_BLACKLIST_CRITICAL.items():
            for p in patterns:
                if any(p.lower() in s.lower() for s in all_symbols):
                    reports.append({
                        "level": "CRITICAL",
                        "line": line,
                        "rule": rule,
                        "detail": f"Опасный бинарный вызов в скомпилированном DEX: {p}"
                    })
                    break

        for rule, patterns in self.DEX_BLACKLIST_HIGH.items():
            for p in patterns:
                if any(p.lower() in s.lower() for s in all_symbols):
                    reports.append({
                        "level": "HIGH",
                        "line": line,
                        "rule": rule,
                        "detail": f"Подозрительный API-вызов в DEX: {p}"
                    })
                    break

        for rule, patterns in self.DEX_BLACKLIST_WARNING.items():
            for p in patterns:
                if any(p.lower() in s.lower() for s in all_symbols):
                    reports.append({
                        "level": "WARNING",
                        "line": line,
                        "rule": rule,
                        "detail": f"Обращение к системным ресурсам из DEX: {p}"
                    })
                    break

        return reports

    def _scan_embedded_so(self, so_bytes: bytes, line: int = 0) -> List[Dict[str, Any]]:
        reports = []
        if len(so_bytes) < 52 or not so_bytes.startswith(bytes.fromhex("7f454c46")):
            return reports

        e_machine = struct.unpack("<H", so_bytes[18:20])[0] if len(so_bytes) >= 20 else 0
        arch_map = {183: "ARM64 (aarch64)", 40: "ARM32 (armv7)", 62: "x86_64", 3: "x86"}
        arch_name = arch_map.get(e_machine, f"Arch-{e_machine}")

        exploit_symbols = [b"/system/bin/sh", b"libsu.so", b"ptrace", b"execve"]
        network_symbols = [b"socket", b"connect", b"sendto", b"send", b"getprop", b"setprop", b"chmod", b"kill"]

        exploit_found = [s.decode("ascii", errors="ignore") for s in exploit_symbols if s in so_bytes]
        net_found = [s.decode("ascii", errors="ignore") for s in network_symbols if s in so_bytes]

        if exploit_found:
            reports.append({
                "level": "CRITICAL",
                "line": line,
                "rule": "SO_NATIVE_EXPLOIT_SYMBOLS",
                "detail": f"Встроенная нативная библиотека .so ({arch_name}) содержит эксплойт-символы ({', '.join(exploit_found)}). Бинарный код невозможно полностью проверить, устанавливайте на свой страх и риск!"
            })
        elif net_found:
            reports.append({
                "level": "WARNING",
                "line": line,
                "rule": "SO_NATIVE_SYMBOLS",
                "detail": f"Встроенная нативная библиотека .so ({arch_name}) содержит системные символы ({', '.join(net_found[:3])}). Бинарный код невозможно полностью проверить, устанавливайте на свой страх и риск!"
            })
        else:
            reports.append({
                "level": "WARNING",
                "line": line,
                "rule": "EMBEDDED_NATIVE_SO_PAYLOAD",
                "detail": f"Встроенный бинарный нативный модуль .so ({arch_name}, {len(so_bytes):,} байт). Бинарный код невозможно полностью проверить, устанавливайте на свой страх и риск!"
            })

        return reports

    def _scan_vector_chunks(self, chunks: List[Tuple[str, int, str]], reports: List[Dict[str, Any]], stats: Dict[str, Any]) -> Dict[str, Any]:
        vec_path, meta_path = self._resolve_model_paths()
        if not os.path.exists(vec_path):
            stats["status"] = "MODEL_FILE_NOT_FOUND"
            return stats

        precision = int(self.get_setting("model_precision", 0))
        model = ModelRepository.get_model(vec_path, meta_path, precision=precision)
        if not model:
            stats["status"] = "MODEL_PARSE_ERROR"
            return stats

        threshold = model["threshold"]
        dim = model["dim"]
        stats["threshold"] = threshold
        stats["vectors_count"] = model["num_rows"]

        unique_chunks = []
        seen_canonical = set()
        for name, lineno, code in chunks:
            if code not in seen_canonical:
                seen_canonical.add(code)
                unique_chunks.append((name, lineno, code))

        stats["scanned_chunks"] = len(unique_chunks)
        seen_code_sims = {}
        all_sims = []
        global_max_sim = 0.0
        global_min_sim = 1.0
        global_max_mal_sim = 0.0

        use_dex = False
        try:
            from org.telegram.messenger import ApplicationLoader
            if ApplicationLoader.applicationContext is not None:
                use_dex = True
        except Exception:
            pass

        if use_dex and self._ensure_dex_model_loaded(vec_path):
            try:
                joined_texts = "\n===CHUNK_SPLIT===\n".join(c[2] for c in unique_chunks)
                sim_array = self._invoke_dex("evaluateAllChunksDual", joined_texts)
                if sim_array is not None:
                    sims = list(sim_array)
                else:
                    sims = [0.0] * (len(unique_chunks) * 2)
            except Exception as de:
                self.log(f"[PluginGuard DEBUG] evaluateAllChunksDual failed: {de}")
                sims = [0.0] * (len(unique_chunks) * 2)

            mal_thresh = float(model.get("malware_threshold", 0.70))
            for idx, (name, lineno, code) in enumerate(unique_chunks):
                mean_top5 = float(sims[idx * 2]) if (idx * 2) < len(sims) else 0.0
                malware_max = float(sims[idx * 2 + 1]) if (idx * 2 + 1) < len(sims) else 0.0
                seen_code_sims[code] = mean_top5
                all_sims.append(mean_top5)
                if mean_top5 > global_max_sim:
                    global_max_sim = mean_top5
                if mean_top5 < global_min_sim:
                    global_min_sim = mean_top5
                if malware_max > global_max_mal_sim:
                    global_max_mal_sim = malware_max

                if len(code) > 30 and malware_max >= mal_thresh and (malware_max > mean_top5 or mean_top5 < 0.65):
                    reports.append({
                        "level": "CRITICAL",
                        "line": lineno,
                        "function": name,
                        "rule": "KNOWN_MALWARE_SIGNATURE_MATCH",
                        "detail": f"Вредоносная семантическая сигнатура {name} (угроза {malware_max:.4f} vs норма {mean_top5:.4f})"
                    })
                elif len(code) > 30 and malware_max >= (mal_thresh - 0.04) and malware_max > mean_top5:
                    reports.append({
                        "level": "WARNING",
                        "line": lineno,
                        "function": name,
                        "rule": "SUSPICIOUS_SIGNATURE_MATCH",
                        "detail": f"Подозрительная семантическая сигнатура {name} (угроза {malware_max:.4f} vs норма {mean_top5:.4f})"
                    })
                elif mean_top5 < threshold:
                    reports.append({
                        "level": "INFO",
                        "line": lineno,
                        "rule": "SEMANTIC_ANOMALY_OUTLIER",
                        "detail": f"Семантическая редкая функция {name} (схожесть {mean_top5:.4f} < {threshold:.4f})"
                    })
            stats["status"] = "LOADED (Java DEX Engine)"
        else:
            stats["status"] = "LOADED (Python Fallback Engine)"
            matrix = model["matrix"]
            inv_index = model["inv_index"]
            malware_matrix = model.get("malware_matrix")
            malware_inv = model.get("malware_inv")

            import concurrent.futures
            def _eval_single_chunk(item):
                c_name, c_lineno, c_code = item
                vec = self._encode_text_deterministic(c_code, dim)
                non_zero = [(i, val) for i, val in enumerate(vec) if val > 0]
                if not non_zero:
                    return c_name, c_lineno, c_code, 0.0, 0.0

                candidate_rows = set()
                for idx, _ in non_zero:
                    if idx in inv_index:
                        candidate_rows.update(inv_index[idx])

                c_top5 = [0.0] * 5
                if candidate_rows:
                    for r in candidate_rows:
                        row_floats = matrix[r]
                        dot = sum(row_floats[i] * val for i, val in non_zero)
                        if dot > c_top5[0]:
                            c_top5[0] = dot
                            c_top5.sort()
                c_mean_top5 = sum(c_top5) / 5.0
                c_max_clean = c_top5[-1]

                c_mal_max = 0.0
                if malware_matrix and malware_inv:
                    m_candidates = set()
                    for idx, _ in non_zero:
                        if idx in malware_inv:
                            m_candidates.update(malware_inv[idx])
                    for mr in m_candidates:
                        mrow = malware_matrix[mr]
                        mdot = sum(mrow[i] * val for i, val in non_zero)
                        if mdot > c_mal_max:
                            c_mal_max = mdot

                return c_name, c_lineno, c_code, c_mean_top5, c_max_clean, c_mal_max

            max_w = min(os.cpu_count() or 2, 4)
            with concurrent.futures.ThreadPoolExecutor(max_workers=max_w) as executor:
                results = list(executor.map(_eval_single_chunk, unique_chunks))

            mal_thresh = float(model.get("malware_threshold", 0.70))
            for name, lineno, code, mean_top5, max_clean, malware_max in results:
                seen_code_sims[code] = mean_top5
                all_sims.append(mean_top5)
                if mean_top5 > global_max_sim:
                    global_max_sim = mean_top5
                if mean_top5 < global_min_sim:
                    global_min_sim = mean_top5
                if malware_max > global_max_mal_sim:
                    global_max_mal_sim = malware_max

                if len(code) > 30 and malware_max >= mal_thresh and (malware_max > max_clean or max_clean < 0.65):
                    reports.append({
                        "level": "CRITICAL",
                        "line": lineno,
                        "function": name,
                        "rule": "KNOWN_MALWARE_SIGNATURE_MATCH",
                        "detail": f"Вредоносная семантическая сигнатура {name} (угроза {malware_max:.4f} vs норма {max_clean:.4f})"
                    })
                elif len(code) > 30 and malware_max >= (mal_thresh - 0.04) and malware_max > max_clean:
                    reports.append({
                        "level": "WARNING",
                        "line": lineno,
                        "function": name,
                        "rule": "SUSPICIOUS_SIGNATURE_MATCH",
                        "detail": f"Подозрительная семантическая сигнатура {name} (угроза {malware_max:.4f} vs норма {max_clean:.4f})"
                    })
                elif mean_top5 < threshold:
                    reports.append({
                        "level": "INFO",
                        "line": lineno,
                        "function": name,
                        "rule": "SEMANTIC_ANOMALY_OUTLIER",
                        "detail": f"Семантическая редкая функция {name} (схожесть {mean_top5:.4f} < {threshold:.4f})"
                    })

        if not all_sims:
            global_min_sim = 0.0
        avg_sim = sum(all_sims) / len(all_sims) if all_sims else 0.0
        stats["max_similarity"] = global_max_sim
        stats["min_similarity"] = global_min_sim
        stats["avg_similarity"] = avg_sim
        stats["max_malware_similarity"] = global_max_mal_sim
        diff = global_max_sim - threshold
        if diff >= 0:
            stats["threshold_diff"] = f"+{diff:.4f}"
        else:
            stats["threshold_diff"] = f"{diff:.4f}"

        return stats

    def _extract_dex_bytes(self, tree: Optional[ast.AST] = None, code_str: Optional[str] = None) -> Tuple[bytes, int]:
        magics = (bytes.fromhex("6465780a"), b"cdex")
        if code_str:
            if "# __DEX_BEGIN__" in code_str and "# __DEX_END__" in code_str:
                try:
                    block = code_str.split("# __DEX_BEGIN__", 1)[1].split("# __DEX_END__", 1)[0]
                    clean_b64 = "".join(line.strip()[1:].strip() for line in block.splitlines() if line.strip().startswith("#"))
                    clean_b64 = re.sub(r'\s+', '', clean_b64)
                    for cand in (clean_b64, clean_b64[::-1]):
                        try:
                            raw = base64.b64decode(cand)
                            if any(raw.startswith(m) for m in magics):
                                return raw, 1
                            try:
                                decomp = zlib.decompress(raw)
                                if any(decomp.startswith(m) for m in magics):
                                    return decomp, 1
                            except Exception:
                                pass
                        except Exception:
                            pass
                except Exception:
                    pass
            comment_b64_pat = re.compile(r'(?:^[ \t]*#[ \t]*[A-Za-z0-9+/=]{30,}[ \t]*\r?\n){2,}', re.MULTILINE)
            for m in comment_b64_pat.finditer(code_str):
                matched_text = m.group(0)
                clean = "".join(l.split("#", 1)[1].strip() for l in matched_text.splitlines() if "#" in l)
                clean = re.sub(r'\s+', '', clean)
                lineno = code_str[:m.start()].count('\n') + 1
                for cand in (clean, clean[::-1]):
                    try:
                        raw = base64.b64decode(cand)
                        if any(raw.startswith(mg) for mg in magics):
                            return raw, lineno
                        try:
                            decomp = zlib.decompress(raw)
                            if any(decomp.startswith(mg) for mg in magics):
                                return decomp, lineno
                        except Exception:
                            pass
                    except Exception:
                        pass
        if tree is not None:
            for node in ast.walk(tree):
                lineno = getattr(node, 'lineno', 0)
                if isinstance(node, ast.Constant):
                    if isinstance(node.value, bytes):
                        if any(node.value.startswith(m) for m in magics):
                            return node.value, lineno
                        try:
                            decomp = zlib.decompress(node.value)
                            if any(decomp.startswith(m) for m in magics):
                                return decomp, lineno
                        except Exception:
                            pass
                    elif isinstance(node.value, str):
                        s = node.value.strip()
                        if len(s) > 30:
                            s_clean = re.sub(r'\s+', '', s)
                            for cand in (s_clean, s_clean[::-1]):
                                try:
                                    raw = base64.b64decode(cand)
                                    if any(raw.startswith(m) for m in magics):
                                        return raw, lineno
                                    try:
                                        decomp = zlib.decompress(raw)
                                        if any(decomp.startswith(m) for m in magics):
                                            return decomp, lineno
                                    except Exception:
                                        pass
                                except Exception:
                                    pass
        return b"", 0

    def _disassemble_dex_tables(self, dex: bytes) -> Tuple[List[str], List[str], List[str], List[Tuple[str, str]], List[str]]:
        strings = []
        methods = []
        fields = []
        classes = []
        disasm_lines = []
        try:
            if len(dex) < 112 or not (dex.startswith(bytes.fromhex("6465780a")) or dex.startswith(b"cdex")):
                return strings, methods, fields, classes, disasm_lines

            def _read_uleb128(data: bytes, off: int) -> Tuple[int, int]:
                val = 0
                shift = 0
                d_len = len(data)
                while off < d_len:
                    b = data[off]
                    off += 1
                    val |= (b & 0x7f) << shift
                    if not (b & 0x80):
                        break
                    shift += 7
                return val, off

            string_ids_size = struct.unpack("<I", dex[56:60])[0]
            string_ids_off = struct.unpack("<I", dex[60:64])[0]
            type_ids_size = struct.unpack("<I", dex[64:68])[0]
            type_ids_off = struct.unpack("<I", dex[68:72])[0]
            field_ids_size = struct.unpack("<I", dex[80:84])[0]
            field_ids_off = struct.unpack("<I", dex[84:88])[0]
            method_ids_size = struct.unpack("<I", dex[88:92])[0]
            method_ids_off = struct.unpack("<I", dex[92:96])[0]
            class_defs_size = struct.unpack("<I", dex[96:100])[0]
            class_defs_off = struct.unpack("<I", dex[100:104])[0]

            for i in range(min(string_ids_size, 10000)):
                ptr = string_ids_off + (i * 4)
                if ptr + 4 > len(dex): break
                s_off = struct.unpack("<I", dex[ptr:ptr+4])[0]
                l, idx = _read_uleb128(dex, s_off)
                if idx + l <= len(dex):
                    strings.append(dex[idx:idx+l].decode("utf-8", errors="replace"))

            type_names = []
            for i in range(min(type_ids_size, 6000)):
                ptr = type_ids_off + (i * 4)
                if ptr + 4 > len(dex): break
                d_idx = struct.unpack("<I", dex[ptr:ptr+4])[0]
                type_names.append(strings[d_idx] if d_idx < len(strings) else "")

            for i in range(min(field_ids_size, 6000)):
                ptr = field_ids_off + (i * 8)
                if ptr + 8 > len(dex): break
                c_idx, t_idx, n_idx = struct.unpack("<HHI", dex[ptr:ptr+8])
                cls_str = type_names[c_idx] if c_idx < len(type_names) else ""
                t_str = type_names[t_idx] if t_idx < len(type_names) else ""
                name_str = strings[n_idx] if n_idx < len(strings) else ""
                if cls_str or name_str:
                    fields.append(f"{cls_str}->{name_str}:{t_str}")

            for i in range(min(method_ids_size, 6000)):
                ptr = method_ids_off + (i * 8)
                if ptr + 8 > len(dex): break
                c_idx, p_idx, n_idx = struct.unpack("<HHI", dex[ptr:ptr+8])
                cls_str = type_names[c_idx] if c_idx < len(type_names) else ""
                name_str = strings[n_idx] if n_idx < len(strings) else ""
                if cls_str or name_str:
                    methods.append(f"{cls_str}->{name_str}")

            for i in range(min(class_defs_size, 1000)):
                ptr = class_defs_off + (i * 32)
                if ptr + 32 > len(dex): break
                c_idx, a_flags, sc_idx, if_off, sf_idx, annot_off, class_data_off, st_val_off = struct.unpack("<IIIIIIII", dex[ptr:ptr+32])
                c_name = type_names[c_idx] if c_idx < len(type_names) else f"Class_{c_idx}"
                sc_name = type_names[sc_idx] if sc_idx < len(type_names) and sc_idx != 0xFFFFFFFF else "java/lang/Object"
                classes.append((c_name, sc_name))
                disasm_lines.append(f".class {c_name}")
                disasm_lines.append(f".super {sc_name}")

                if class_data_off == 0 or class_data_off >= len(dex):
                    disasm_lines.append("")
                    continue

                off = class_data_off
                s_f_sz, off = _read_uleb128(dex, off)
                i_f_sz, off = _read_uleb128(dex, off)
                d_m_sz, off = _read_uleb128(dex, off)
                v_m_sz, off = _read_uleb128(dex, off)

                for _ in range(s_f_sz + i_f_sz):
                    diff, off = _read_uleb128(dex, off)
                    flags, off = _read_uleb128(dex, off)

                for is_virtual, total_m in ((False, d_m_sz), (True, v_m_sz)):
                    m_idx = 0
                    for _ in range(total_m):
                        diff, off = _read_uleb128(dex, off)
                        m_idx += diff
                        flags, off = _read_uleb128(dex, off)
                        code_off, off = _read_uleb128(dex, off)
                        m_sig = methods[m_idx] if m_idx < len(methods) else f"method_{m_idx}"
                        disasm_lines.append(f"  .method {m_sig}")
                        if code_off > 0 and code_off + 16 <= len(dex):
                            reg_sz, ins_sz, outs_sz, tries_sz, dbg_off, insns_sz = struct.unpack("<HHHHII", dex[code_off:code_off+16])
                            code_end = code_off + 16 + insns_sz * 2
                            if code_end <= len(dex):
                                insns = dex[code_off+16:code_end]
                                pc = 0
                                while pc < len(insns):
                                    op = insns[pc]
                                    if op == 0x1a and pc + 3 < len(insns):
                                        s_idx = struct.unpack_from('<H', insns, pc+2)[0]
                                        if s_idx < len(strings):
                                            disasm_lines.append(f"    const-string \"{strings[s_idx]}\"")
                                        pc += 4
                                    elif op == 0x1b and pc + 5 < len(insns):
                                        s_idx = struct.unpack_from('<I', insns, pc+2)[0]
                                        if s_idx < len(strings):
                                            disasm_lines.append(f"    const-string/jumbo \"{strings[s_idx]}\"")
                                        pc += 6
                                    elif 0x52 <= op <= 0x6f and pc + 3 < len(insns):
                                        f_idx = struct.unpack_from('<H', insns, pc+2)[0]
                                        if f_idx < len(fields):
                                            disasm_lines.append(f"    field-op {fields[f_idx]}")
                                        pc += 4
                                    elif (0x6e <= op <= 0x72 or 0x74 <= op <= 0x78) and pc + 3 < len(insns):
                                        meth_idx = struct.unpack_from('<H', insns, pc+2)[0]
                                        if meth_idx < len(methods):
                                            disasm_lines.append(f"    invoke-op {methods[meth_idx]}")
                                        pc += 6
                                    else:
                                        pc += 2
                        disasm_lines.append("  .end method")
                disasm_lines.append("")
        except Exception:
            pass
        return strings, methods, fields, classes, disasm_lines

    def _get_dumps_dir(self) -> str:
        candidates = []
        try:
            from android.os import Environment
            pub_dl = Environment.getExternalStoragePublicDirectory(Environment.DIRECTORY_DOWNLOADS)
            if pub_dl:
                candidates.append(os.path.join(str(pub_dl.getAbsolutePath()), "PluginGuard_Dumps"))
        except Exception:
            pass
        candidates.extend([
            "/sdcard/Download/PluginGuard_Dumps",
            "/storage/emulated/0/Download/PluginGuard_Dumps",
            os.path.join(self._get_cache_dir(), "dumps")
        ])
        for path in candidates:
            try:
                os.makedirs(path, exist_ok=True)
                if os.path.exists(path):
                    return path
            except Exception:
                pass
        fallback = os.path.join(self._get_cache_dir(), "dumps")
        os.makedirs(fallback, exist_ok=True)
        return fallback

    def _is_safe_ast_node(self, node, allow_exec_capture: bool = False) -> bool:
        safe_nodes = (
            ast.Module, ast.Assign, ast.AnnAssign, ast.AugAssign, ast.Name, ast.Constant,
            ast.List, ast.Tuple, ast.Dict, ast.Set, ast.BinOp, ast.UnaryOp, ast.Compare,
            ast.Call, ast.Attribute, ast.Subscript, ast.Slice, ast.Lambda,
            ast.ListComp, ast.DictComp, ast.SetComp, ast.GeneratorExp, ast.comprehension,
            ast.FunctionDef, ast.arguments, ast.arg, ast.Return, ast.Expr, ast.If,
            ast.For, ast.While, ast.Break, ast.Continue, ast.Pass,
            ast.Add, ast.Sub, ast.Mult, ast.Div, ast.FloorDiv, ast.Mod, ast.Pow,
            ast.LShift, ast.RShift, ast.BitOr, ast.BitXor, ast.BitAnd, ast.Invert,
            ast.Not, ast.USub, ast.UAdd, ast.Eq, ast.NotEq, ast.Lt, ast.LtE, ast.Gt, ast.GtE,
            ast.Is, ast.IsNot, ast.In, ast.NotIn, ast.And, ast.Or, ast.BoolOp,
            ast.Try, ast.ExceptHandler, ast.Import, ast.ImportFrom, ast.alias,
            ast.Load, ast.Store, ast.Del
        )
        blocked_names = {'open', 'getattr', 'setattr', 'delattr', 'vars', 'dir', '__builtins__', 'breakpoint', 'input', 'exit', 'quit'}
        if not allow_exec_capture:
            blocked_names.update({'compile', '__import__', 'eval', 'exec', 'globals', 'locals'})
        for child in ast.walk(node):
            if not isinstance(child, safe_nodes):
                return False
            if isinstance(child, ast.Attribute):
                if child.attr.startswith('__') and child.attr not in ('__name__', '__doc__', '__b', '__z', '__h', '__s', '__k', '__r', '__d'):
                    return False
                if child.attr in ('system', 'popen', 'spawn', 'eval', 'open', 'remove', 'unlink', 'rmdir', 'mkdir', 'read', 'write', 'delete', 'connect', 'send', 'socket'):
                    return False
            if isinstance(child, ast.Name) and child.id in blocked_names:
                return False
            if isinstance(child, ast.Import):
                mod_names = [alias.name.split('.')[0] for alias in child.names]
                if any(m not in ('base64', 'zlib', 'hashlib', 'binascii', 'bz2', 'lzma', 'math', 'string', 'struct', 'json', 'marshal') for m in mod_names):
                    return False
            elif isinstance(child, ast.ImportFrom):
                mod_name = child.module.split('.')[0] if child.module else ''
                if mod_name not in ('base64', 'zlib', 'hashlib', 'binascii', 'bz2', 'lzma', 'math', 'string', 'struct', 'json', 'marshal'):
                    return False
        return True

    def _safe_sandbox_import(self, name: str, globals=None, locals=None, fromlist=(), level=0):
        allowed_modules = {
            'base64': base64, 'zlib': zlib, 'hashlib': hashlib, 'binascii': binascii,
            'bz2': bz2, 'lzma': lzma, 'math': math, 'string': string, 'struct': struct,
            'json': json, 'marshal': marshal
        }
        top_name = name.split('.')[0]
        if top_name in allowed_modules:
            return allowed_modules[top_name]
        raise ImportError(f"Module {name} not allowed in sandbox")

    def _unpack_recursive_payloads(self, code_str: str, max_layers: int = 10) -> List[Tuple[str, str]]:
        current = code_str
        layers = []
        for layer in range(max_layers):
            try:
                tree = ast.parse(current)
            except Exception:
                break
            captured_payloads = []
            def _extract_from_code_obj(co):
                chunks = []
                for c in getattr(co, 'co_consts', ()):
                    if isinstance(c, (str, bytes)):
                        if isinstance(c, bytes):
                            try:
                                c = c.decode('utf-8')
                            except Exception:
                                pass
                        if isinstance(c, str) and len(c) > 20:
                            chunks.append(f"_const = {repr(c)}")
                    elif hasattr(c, 'co_names'):
                        chunks.extend(_extract_from_code_obj(c))
                for n in getattr(co, 'co_names', ()):
                    chunks.append(f"_ref = {n}")
                return chunks

            def capture_compile(source, filename, mode, *args, **kwargs):
                if isinstance(source, str):
                    if '\x00' not in source:
                        captured_payloads.append(source)
                elif isinstance(source, bytes):
                    if not source.startswith(bytes.fromhex("6465780a")) and not source.startswith(bytes.fromhex("7f454c46")) and b'\x00' not in source:
                        try:
                            s_dec = source.decode('utf-8')
                            if '\x00' not in s_dec:
                                captured_payloads.append(s_dec)
                        except Exception:
                            try:
                                d = zlib.decompress(source)
                                if not d.startswith(bytes.fromhex("6465780a")) and not d.startswith(bytes.fromhex("7f454c46")) and b'\x00' not in d:
                                    s_dec = d.decode('utf-8')
                                    if '\x00' not in s_dec:
                                        captured_payloads.append(s_dec)
                            except Exception:
                                pass
                elif hasattr(source, 'co_names'):
                    pseudo = "\n".join(_extract_from_code_obj(source))
                    if pseudo and '\x00' not in pseudo:
                        captured_payloads.append(pseudo)
                return compile(source, filename, mode, *args, **kwargs)

            def capture_exec(target, *args, **kwargs):
                if isinstance(target, str):
                    if '\x00' not in target:
                        captured_payloads.append(target)
                elif isinstance(target, bytes):
                    if not target.startswith(bytes.fromhex("6465780a")) and not target.startswith(bytes.fromhex("7f454c46")) and b'\x00' not in target:
                        try:
                            s_dec = target.decode('utf-8')
                            if '\x00' not in s_dec:
                                captured_payloads.append(s_dec)
                        except Exception:
                            try:
                                d = zlib.decompress(target)
                                if not d.startswith(bytes.fromhex("6465780a")) and not d.startswith(bytes.fromhex("7f454c46")) and b'\x00' not in d:
                                    s_dec = d.decode('utf-8')
                                    if '\x00' not in s_dec:
                                        captured_payloads.append(s_dec)
                            except Exception:
                                pass
                elif hasattr(target, 'co_names'):
                    pseudo = "\n".join(_extract_from_code_obj(target))
                    if pseudo and '\x00' not in pseudo:
                        captured_payloads.append(pseudo)

            safe_builtins = {
                'len': len, 'range': range, 'chr': chr, 'ord': ord, 'int': int, 'str': str,
                'bytes': bytes, 'bytearray': bytearray, 'list': list, 'dict': dict, 'set': set,
                'tuple': tuple, 'enumerate': enumerate, 'zip': zip, 'reversed': reversed,
                'slice': slice, 'isinstance': isinstance, 'bool': bool, 'min': min, 'max': max,
                'sum': sum, '__import__': self._safe_sandbox_import, 'compile': capture_compile,
                'globals': dict, 'locals': dict, 'exec': capture_exec, 'eval': eval
            }
            sandbox_ns = {
                '__builtins__': safe_builtins,
                'base64': base64, '__b': base64, '_b64': base64,
                'zlib': zlib, '__z': zlib, '_z': zlib,
                'hashlib': hashlib, '__h': hashlib, '_h': hashlib,
                'binascii': binascii, 'bz2': bz2, 'lzma': lzma,
                'struct': struct, 'json': json, 'marshal': marshal,
                'math': math, 'string': string
            }
            safe_stmts = [s for s in tree.body if self._is_safe_ast_node(s, allow_exec_capture=True)]
            for s in safe_stmts:
                try:
                    exec(ast.unparse(s), sandbox_ns)
                except Exception:
                    pass
            for fn_name, fn_obj in list(sandbox_ns.items()):
                if callable(fn_obj) and fn_name not in safe_builtins and fn_name not in ('base64', 'zlib', 'hashlib', 'binascii', 'bz2', 'lzma', 'struct', 'json', 'marshal', 'math', 'string'):
                    try:
                        res = fn_obj()
                        if isinstance(res, str) and len(res) > 20 and '\x00' not in res:
                            captured_payloads.append(res)
                        elif isinstance(res, bytes) and not res.startswith(bytes.fromhex("6465780a")) and not res.startswith(bytes.fromhex("7f454c46")) and b'\x00' not in res:
                            try:
                                s_dec = res.decode('utf-8')
                                if '\x00' not in s_dec:
                                    captured_payloads.append(s_dec)
                            except Exception:
                                try:
                                    d = zlib.decompress(res)
                                    if not d.startswith(bytes.fromhex("6465780a")) and not d.startswith(bytes.fromhex("7f454c46")) and b'\x00' not in d:
                                        s_dec = d.decode('utf-8')
                                        if '\x00' not in s_dec:
                                            captured_payloads.append(s_dec)
                                except Exception:
                                    pass
                        elif hasattr(res, 'co_names'):
                            pseudo = "\n".join(_extract_from_code_obj(res))
                            if pseudo and '\x00' not in pseudo:
                                captured_payloads.append(pseudo)
                    except Exception:
                        pass
            best_unpacked = None
            for cand in reversed(captured_payloads):
                cand_s = str(cand).strip()
                if cand_s and cand_s != current and len(cand_s) > 20:
                    if any(kw in cand_s for kw in ('__id__', 'import ', 'def ', 'class ', 'from ', 'exec(', '_ref =', '_const =')):
                        best_unpacked = cand_s
                        break
            if not best_unpacked:
                for cand in reversed(captured_payloads):
                    cand_s = str(cand).strip()
                    if cand_s and cand_s != current and len(cand_s) > 20:
                        best_unpacked = cand_s
                        break
            if best_unpacked:
                best_resolved = self._resolve_string_decoders(best_unpacked)
                layers.append((f"unpacked_layer_{layer+1}", best_resolved))
                current = best_unpacked
            else:
                break
        return layers

    def _resolve_string_decoders(self, p_code: str) -> str:
        current = p_code
        try:
            p_tree = ast.parse(current)
        except Exception:
            return current
        for _pass in range(3):
            safe_builtins = {
                'len': len, 'range': range, 'chr': chr, 'ord': ord, 'int': int, 'str': str, 'float': float,
                'bytes': bytes, 'bytearray': bytearray, 'list': list, 'dict': dict, 'set': set, 'tuple': tuple,
                'enumerate': enumerate, 'zip': zip, 'reversed': reversed, 'slice': slice, 'isinstance': isinstance,
                'bool': bool, 'min': min, 'max': max, 'sum': sum, 'abs': abs, 'all': all, 'any': any, 'round': round,
                'map': map, 'filter': filter, 'iter': iter, 'next': next, 'hex': hex, 'oct': oct, 'bin': bin,
                'print': lambda *a, **k: None, 'Exception': Exception, 'BaseException': BaseException,
                'TypeError': TypeError, 'ValueError': ValueError, 'KeyError': KeyError, 'AttributeError': AttributeError,
                'IndexError': IndexError, 'True': True, 'False': False, 'None': None,
                '__import__': self._safe_sandbox_import
            }

            sandbox_ns = {
                '__builtins__': safe_builtins,
                'base64': base64, '__b': base64, '_b': base64, '_b64': base64, 'b64': base64,
                'zlib': zlib, '__z': zlib, '_z': zlib,
                'hashlib': hashlib, '__h': hashlib, '_h': hashlib,
                'binascii': binascii, 'bz2': bz2, 'lzma': lzma,
                'struct': struct, 'json': json, 'marshal': marshal,
                'math': math, 'string': string
            }

            for stmt in p_tree.body:
                if self._is_safe_ast_node(stmt):
                    try:
                        exec(ast.unparse(stmt), sandbox_ns)
                    except Exception:
                        pass

            candidate_decoders = {}
            for name, obj in sandbox_ns.items():
                if callable(obj) and name not in safe_builtins and not name.startswith('__') and name not in ('base64', 'zlib', 'hashlib', 'binascii', 'bz2', 'lzma', 'struct', 'json', 'marshal', 'math', 'string'):
                    candidate_decoders[name] = obj

            const_aliases = {}
            for stmt in p_tree.body:
                if isinstance(stmt, ast.Assign) and len(stmt.targets) == 1 and isinstance(stmt.targets[0], ast.Name):
                    var_name = stmt.targets[0].id
                    if isinstance(stmt.value, ast.Constant):
                        const_aliases[var_name] = stmt.value.value

            class CombinedTransformer(ast.NodeTransformer):
                def __init__(self):
                    super().__init__()
                    self.replaced_count = 0

                def visit_Call(self, node):
                    self.generic_visit(node)
                    fn_name = ""
                    if isinstance(node.func, ast.Name):
                        fn_name = node.func.id
                    elif isinstance(node.func, ast.Attribute) and isinstance(node.func.value, ast.Name):
                        fn_name = node.func.attr

                    if fn_name in candidate_decoders:
                        if len(node.args) >= 1 and isinstance(node.args[0], ast.Constant) and isinstance(node.args[0].value, (str, bytes)):
                            arg_val = node.args[0].value
                            try:
                                extra_args = []
                                valid_extra = True
                                for extra in node.args[1:]:
                                    if isinstance(extra, ast.Constant):
                                        extra_args.append(extra.value)
                                    else:
                                        valid_extra = False
                                        break
                                if valid_extra:
                                    res = candidate_decoders[fn_name](arg_val, *extra_args)
                                    if isinstance(res, str) and res != arg_val:
                                        self.replaced_count += 1
                                        return ast.Constant(value=res)
                                    elif isinstance(res, bytes):
                                        try:
                                            s_res = res.decode('utf-8')
                                            self.replaced_count += 1
                                            return ast.Constant(value=s_res)
                                        except Exception:
                                            self.replaced_count += 1
                                            return ast.Constant(value=res)
                            except Exception:
                                pass
                    return node

                def visit_Name(self, node):
                    if isinstance(node.ctx, ast.Load) and node.id in const_aliases:
                        val = const_aliases[node.id]
                        if isinstance(val, (str, int, float, bool, bytes)):
                            self.replaced_count += 1
                            return ast.Constant(value=val)
                    return node

            transformer = CombinedTransformer()
            clean_p_tree = transformer.visit(p_tree)
            if transformer.replaced_count > 0:
                ast.fix_missing_locations(clean_p_tree)
                p_tree = clean_p_tree
            else:
                break
        try:
            return ast.unparse(p_tree)
        except Exception:
            return current

    def _extract_deobfuscated_payloads(self, code_str: str) -> List[Tuple[str, str]]:
        extracted = []
        if not code_str:
            return extracted

        rec_layers = self._unpack_recursive_payloads(code_str)
        if rec_layers:
            for title, payload in rec_layers:
                extracted.append((title, payload))

        try:
            tree = ast.parse(code_str)
        except Exception:
            return extracted

        str_vars = {}
        list_vars = {}

        for node in ast.walk(tree):
            if isinstance(node, ast.Assign) and len(node.targets) == 1 and isinstance(node.targets[0], ast.Name):
                vname = node.targets[0].id
                if isinstance(node.value, ast.Constant) and isinstance(node.value.value, str):
                    str_vars[vname] = node.value.value
                elif isinstance(node.value, ast.Constant) and isinstance(node.value.value, bytes):
                    try:
                        str_vars[vname] = node.value.value.decode('utf-8', errors='ignore')
                    except Exception:
                        pass
                elif isinstance(node.value, ast.List):
                    int_vals = []
                    for elt in node.value.elts:
                        if isinstance(elt, ast.Constant) and isinstance(elt.value, int):
                            int_vals.append(elt.value)
                        elif isinstance(elt, ast.BinOp) and isinstance(elt.left, ast.Constant) and isinstance(elt.left.value, int):
                            if isinstance(elt.right, ast.Constant) and isinstance(elt.right.value, int):
                                if isinstance(elt.op, ast.BitXor):
                                    int_vals.append(elt.left.value ^ elt.right.value)
                    if int_vals:
                        list_vars[vname] = int_vals

        for vname, ints in list_vars.items():
            try:
                raw = bytes([x & 0xFF for x in ints])
                if raw.startswith(bytes.fromhex("6465780a")) or raw.startswith(bytes.fromhex("7f454c46")) or b'\x00' in raw:
                    continue
                decoded = raw.decode('utf-8', errors='ignore')
                if '\x00' not in decoded and any(kw in decoded for kw in ['import ', 'def ', 'class ', 'return ', 'self', 'requests', 'socket', 'http', 'urllib', 'open(']):
                    extracted.append((f"list_var_{vname}", decoded))
                for k in range(1, 256):
                    xored_b = bytes([b ^ k for b in raw])
                    if b'\x00' in xored_b:
                        continue
                    xored = xored_b.decode('utf-8', errors='ignore')
                    if '\x00' not in xored and any(kw in xored for kw in ['import ', 'def ', 'class ', 'return ', 'self', 'requests', 'socket', 'http', 'urllib', 'open(']):
                        extracted.append((f"list_var_{vname}_xor_{k}", xored))
                        break
            except Exception:
                pass

        joined_candidates = []
        for node in ast.walk(tree):
            if isinstance(node, ast.Call) and isinstance(node.func, ast.Attribute) and node.func.attr == 'join':
                if node.args and isinstance(node.args[0], ast.List):
                    parts = []
                    for elt in node.args[0].elts:
                        if isinstance(elt, ast.Name) and elt.id in str_vars:
                            parts.append(str_vars[elt.id])
                        elif isinstance(elt, ast.Constant) and isinstance(elt.value, str):
                            parts.append(elt.value)
                    if parts:
                        joined_candidates.append(''.join(parts))

        hex_keys = []
        for k1, v1 in str_vars.items():
            v1_s = v1.strip()
            if self.RE_HEX_KEY.match(v1_s):
                hex_keys.append(v1_s)
                for k2, v2 in str_vars.items():
                    v2_s = v2.strip()
                    if k1 != k2 and self.RE_HEX_KEY.match(v2_s):
                        hex_keys.append(v1_s + v2_s)

        all_candidates = list(joined_candidates)
        for val in str_vars.values():
            if val not in all_candidates and len(val) > 40:
                all_candidates.append(val)

        for s in all_candidates:
            s_clean = s.strip()
            variants = [s_clean]
            if len(s_clean) >= 4:
                variants.append(s_clean[::-1])

            for cand in variants:
                try:
                    raw = base64.b64decode(cand)
                    if raw.startswith(bytes.fromhex("6465780a")) or raw.startswith(bytes.fromhex("7f454c46")):
                        continue
                    decomp = None
                    try:
                        decomp = zlib.decompress(raw)
                    except Exception:
                        pass
                    if decomp is not None:
                        if decomp.startswith(bytes.fromhex("6465780a")) or decomp.startswith(bytes.fromhex("7f454c46")) or b'\x00' in decomp:
                            continue
                        txt = decomp.decode('utf-8', errors='ignore')
                        if '\x00' not in txt and any(kw in txt for kw in ['import ', 'def ', 'class ', 'return ', 'self', 'requests', 'socket', 'http', 'urllib', 'open(']):
                            extracted.append(("base64_payload", txt))
                            continue
                    elif b'\x00' not in raw:
                        txt = raw.decode('utf-8', errors='ignore')
                        if '\x00' not in txt and any(kw in txt for kw in ['import ', 'def ', 'class ', 'return ', 'self', 'requests', 'socket', 'http', 'urllib', 'open(']):
                            extracted.append(("base64_payload", txt))
                            continue

                    for hk in hex_keys:
                        try:
                            key_bytes = bytes.fromhex(hk)
                            klen = len(key_bytes)
                            xored = bytes([raw[i] ^ key_bytes[i % klen] for i in range(len(raw))])
                            try:
                                d_decomp = zlib.decompress(xored)
                                if d_decomp.startswith(bytes.fromhex("6465780a")) or d_decomp.startswith(bytes.fromhex("7f454c46")) or b'\x00' in d_decomp:
                                    continue
                                d_txt = d_decomp.decode('utf-8', errors='ignore')
                            except Exception:
                                if b'\x00' in xored:
                                    continue
                                d_txt = xored.decode('utf-8', errors='ignore')
                            if '\x00' not in d_txt and any(kw in d_txt for kw in ['import ', 'def ', 'class ', 'return ', 'self', 'requests', 'socket', 'http', 'urllib', 'open(']):
                                extracted.append(("xor_hex_payload", d_txt))
                                break
                        except Exception:
                            pass
                except Exception:
                    pass

        unique = []
        seen = set()
        for title, payload in extracted:
            if '\x00' in payload:
                continue
            resolved = self._resolve_string_decoders(payload)
            p_strip = resolved.strip()
            if p_strip and '\x00' not in p_strip and p_strip not in seen:
                try:
                    p_tree = ast.parse(p_strip)
                    ast.fix_missing_locations(p_tree)
                    pretty = ast.unparse(p_tree)
                    if pretty not in seen:
                        seen.add(pretty)
                        unique.append((title, pretty))
                except Exception:
                    pass

        return unique

    def _save_debug_dump(self, file_path: str, code: str, reports: List[Dict[str, Any]], ai_stats: Dict[str, Any], score: int, badge: str):
        try:
            if not self.get_setting("save_debug_dumps", False):
                self._last_dump_folder_name = None
                return

            dumps_dir = self._get_dumps_dir()
            base_name = os.path.splitext(os.path.basename(file_path))[0] if file_path else "plugin"
            clean_name = re.sub(r'[^a-zA-Z0-9_-]', '_', base_name)
            time_tag = time.strftime("%Y%m%d_%H%M%S")
            folder_name = f"{clean_name}_{time_tag}"
            target_folder = os.path.join(dumps_dir, folder_name)
            os.makedirs(target_folder, exist_ok=True)
            self._last_dump_folder_name = folder_name

            report_data = {
                "timestamp": time.time(),
                "datetime": time.strftime("%Y-%m-%d %H:%M:%S"),
                "file_name": os.path.basename(file_path) if file_path else "unknown",
                "file_path": file_path,
                "score": score,
                "badge": badge,
                "reports_count": len(reports),
                "reports": reports,
                "ai_stats": ai_stats
            }

            report_json_path = os.path.join(target_folder, "report.json")
            with open(report_json_path, "w", encoding="utf-8") as f:
                json.dump(report_data, f, ensure_ascii=False, indent=2)

            if code:
                source_path = os.path.join(target_folder, "source.py")
                with open(source_path, "w", encoding="utf-8") as f:
                    f.write(code)

                try:
                    deobf_payloads = self._extract_deobfuscated_payloads(code)
                    if deobf_payloads:
                        _, final_payload = deobf_payloads[-1]
                        deobf_main_path = os.path.join(target_folder, "deobfuscated.py")
                        with open(deobf_main_path, "w", encoding="utf-8") as f:
                            f.write(final_payload)
                        if len(deobf_payloads) > 1:
                            for idx, (_, payload_code) in enumerate(deobf_payloads, 1):
                                l_path = os.path.join(target_folder, f"deobfuscated_layer_{idx}.py")
                                with open(l_path, "w", encoding="utf-8") as f:
                                    f.write(payload_code)
                except Exception:
                    pass

                try:
                    tree = ast.parse(code)
                    dex_bytes, _ = self._extract_dex_bytes(tree, code)
                    if not dex_bytes and 'deobf_payloads' in locals() and deobf_payloads:
                        for _, p_code in deobf_payloads:
                            try:
                                p_tree = ast.parse(p_code)
                                p_dex, _ = self._extract_dex_bytes(p_tree, p_code)
                                if p_dex:
                                    dex_bytes = p_dex
                                    break
                            except Exception:
                                pass
                    if dex_bytes:
                        dex_out_path = os.path.join(target_folder, "embedded_payload.dex")
                        with open(dex_out_path, "wb") as f:
                            f.write(dex_bytes)
                        strings, methods, fields, classes, disasm_lines = self._disassemble_dex_tables(dex_bytes)
                        dex_txt_path = os.path.join(target_folder, "dex_disassembly.txt")
                        with open(dex_txt_path, "w", encoding="utf-8") as f:
                            f.write(f"=== DEX CLASSES ({len(classes)}) ===\n")
                            for cls_name, sup_name in classes:
                                f.write(f"Class: {cls_name} (extends {sup_name})\n")
                            f.write(f"\n=== DEX DISASSEMBLY ({len(disasm_lines)} lines) ===\n")
                            f.write("\n".join(disasm_lines))
                            f.write(f"\n\n=== DEX STRINGS ({len(strings)}) ===\n")
                            f.write("\n".join(strings))
                            f.write(f"\n\n=== DEX METHODS ({len(methods)}) ===\n")
                            f.write("\n".join(methods))
                            f.write(f"\n\n=== DEX FIELDS ({len(fields)}) ===\n")
                            f.write("\n".join(fields))

                    so_bytes_found = []
                    for node in ast.walk(tree):
                        if isinstance(node, ast.Constant) and isinstance(node.value, bytes) and node.value.startswith(bytes.fromhex("7f454c46")):
                            so_bytes_found.append(node.value)
                    for s_idx, so_b in enumerate(so_bytes_found, 1):
                        so_name = "embedded_payload.so" if s_idx == 1 else f"embedded_payload_{s_idx}.so"
                        with open(os.path.join(target_folder, so_name), "wb") as f_so:
                            f_so.write(so_b)
                except Exception:
                    pass

            summary_lines = [
                "PluginGuard Scan Dump",
                f"File: {os.path.basename(file_path) if file_path else 'unknown'}",
                f"Date: {time.strftime('%Y-%m-%d %H:%M:%S')}",
                f"Score: {score}/100 ({badge})",
                f"Status: {ai_stats.get('status', 'OK')}",
                f"Entropy: {ai_stats.get('entropy', 0.0):.4f} ({ai_stats.get('entropy_verdict', 'NORMAL')})",
                f"Vectors: {ai_stats.get('vectors_count', 0)}",
                f"Similarity: max {ai_stats.get('max_similarity', 0.0):.4f} / avg {ai_stats.get('avg_similarity', 0.0):.4f} / min {ai_stats.get('min_similarity', 0.0):.4f}",
                f"Threats count: {len(reports)}"
            ]
            for r in reports:
                line_info = f" ({_tr('строка', 'line')} {r.get('line')})" if r.get('line') else ""
                summary_lines.append(f"  [{r.get('level')}] {r.get('rule')}{line_info}: {r.get('detail')}")

            summary_txt_path = os.path.join(target_folder, "summary.txt")
            with open(summary_txt_path, "w", encoding="utf-8") as f:
                f.write("\n".join(summary_lines))

            self.log(f"[PluginGuard] Saved debug dump to: {target_folder}")
        except Exception as e:
            self.log(f"[PluginGuard] Failed to save debug dump: {e}")

    def _perform_file_scan(self, file_path: str) -> Tuple[int, str, List[Dict[str, Any]], Dict[str, Any], bool]:
        if not file_path or not os.path.exists(file_path):
            return 0, _tr("❌ Ошибка", "❌ Error"), [], {}, True

        file_hash = ""
        file_name = os.path.basename(file_path)
        code = ""
        try:
            with open(file_path, "r", encoding="utf-8", errors="ignore") as f:
                code = f.read()
            file_hash = hashlib.sha256(code.encode("utf-8", errors="ignore")).hexdigest()
        except Exception:
            try:
                with open(file_path, "rb") as f:
                    raw = f.read()
                    file_hash = hashlib.sha256(raw).hexdigest()
                    code = raw.decode("utf-8", errors="ignore")
            except Exception:
                pass

        if file_hash:
            db_match = self._check_malware_hash(file_hash)
            if db_match:
                reports = [{
                    "level": "CRITICAL",
                    "line": 0,
                    "rule": "KNOWN_MALWARE_DB_MATCH",
                    "detail": _tr(f"Плагин обнаружен в базе известных зловредов [{db_match.get('family', 'Malware')}] ({db_match.get('type', 'Вредоносный код')})", f"Plugin matched known malware database [{db_match.get('family', 'Malware')}] ({db_match.get('type', 'Malicious code')})")
                }]
                ai_stats = {
                    "scanned_chunks": 0,
                    "status": "MALWARE_DB_MATCH",
                    "threshold": self.DEFAULT_VECTOR_THRESHOLD,
                    "max_similarity": 1.0,
                    "min_similarity": 1.0,
                    "avg_similarity": 1.0,
                    "vectors_count": 0,
                    "threshold_diff": "+1.0000",
                    "entropy": 0.0,
                    "entropy_verdict": "HIGH",
                    "scan_time_ms": 0.1
                }
                score, badge = 0, _tr("Вредоносный плагин", "Malicious plugin")
                self._save_cached_scan_result(file_hash, file_name, reports, ai_stats)
                self._save_last_scan_stats(ai_stats)
                self._save_debug_dump(file_path, code, reports, ai_stats, score, badge)
                return score, badge, reports, ai_stats, True

        cached_res = self._get_cached_scan_result(file_hash)
        if cached_res:
            reports, ai_stats = cached_res
            self._save_last_scan_stats(ai_stats)
        else:
            reports, ai_stats = self.scan_plugin_code(code)
            if file_hash:
                self._save_cached_scan_result(file_hash, file_name, reports, ai_stats)
            self._save_last_scan_stats(ai_stats)

        score, badge = self._calculate_security_score(reports, ai_stats)
        has_critical = any(r.get("level") == "CRITICAL" for r in reports) or score < 40
        self._save_debug_dump(file_path, code, reports, ai_stats, score, badge)
        return score, badge, reports, ai_stats, has_critical

    def _scan_file_and_show_alert(self, file_path: str):
        def _start_loading_ui():
            if self._current_analyze_btn:
                try:
                    if hasattr(self._current_analyze_btn, "setLoading"):
                        self._current_analyze_btn.setLoading(True)
                    else:
                        self._safe_set_text(self._current_analyze_btn, _tr("Идет сканирование...", "Scanning..."))
                except Exception:
                    pass

        run_on_ui_thread(_start_loading_ui)

        def _do_scan():
            try:
                score, badge, reports, ai_stats, has_critical = self._perform_file_scan(file_path)
            except Exception as e:
                self.log(f"[PluginGuard DEBUG] scan error: {e}")
                score, badge, reports, ai_stats, has_critical = 0, _tr("Ошибка", "Error"), [], {}, True

            def _show_ui():
                try:
                    if self._current_analyze_btn:
                        try:
                            if hasattr(self._current_analyze_btn, "setLoading"):
                                self._current_analyze_btn.setLoading(False)
                            self._safe_set_text(self._current_analyze_btn, f"{_tr('Оценка безопасности PG', 'PG security score')}: {score}/100")
                        except Exception:
                            pass

                    install_btn = getattr(self, "_current_install_btn", None)
                    parent_layout = getattr(self, "_current_parent_layout", None)
                    orig_listener = getattr(self, "_current_orig_listener", None)
                    btn_cls, lin_cls, theme_cls, util_cls, _, _ = self._get_ui_classes()
                    is_update = getattr(self, "_current_is_update", False)

                    class BlockedClickListener(dynamic_proxy(View.OnClickListener)):
                        def onClick(self_inner, v):
                            try:
                                frag = get_last_fragment()
                                if frag:
                                    BulletinHelper.show_error(_tr("Обновление заблокировано PluginGuard (опасный плагин)", "Update blocked by PluginGuard (dangerous plugin)") if is_update else _tr("Установка заблокирована PluginGuard (опасный плагин)", "Installation blocked by PluginGuard (dangerous plugin)"), frag)
                            except Exception:
                                pass

                    if self.get_setting("auto_block", True) and install_btn:
                        if score >= 40 and not has_critical:
                            try:
                                install_btn.setEnabled(True)
                                install_btn.setClickable(True)
                                install_btn.setAlpha(1.0)
                                self._safe_set_text(install_btn, _tr("Обновить", "Update") if is_update else _tr("Установить", "Install"))
                                if orig_listener:
                                    install_btn.setOnClickListener(orig_listener)
                            except Exception:
                                pass
                        else:
                            try:
                                install_btn.setEnabled(False)
                                install_btn.setClickable(False)
                                install_btn.setAlpha(0.4)
                                self._safe_set_text(install_btn, _tr("Обновление заблокировано", "Update blocked") if is_update else _tr("Установка заблокирована", "Installation blocked"))
                                install_btn.setOnClickListener(BlockedClickListener())
                            except Exception:
                                pass

                            if parent_layout and not getattr(self, "_current_chk_box", None):
                                self._create_confirmation_card(install_btn.getContext(), install_btn, orig_listener, parent_layout, lin_cls, util_cls, theme_cls)

                    last_fragment = get_last_fragment()
                    if not last_fragment or not last_fragment.getParentActivity():
                        return

                    context = last_fragment.getParentActivity()
                    self._show_report_bottom_sheet(context, score, badge, reports, ai_stats, has_critical, file_path)

                except Exception as ui_err:
                    self.log(f"[PluginGuard DEBUG] _show_ui exception: {ui_err}\n{traceback.format_exc()}")

            run_on_ui_thread(_show_ui)

        threading.Thread(target=_do_scan, daemon=True).start()

    def _create_confirmation_card(self, context, install_btn, orig_listener, parent_layout, lin_cls, util_cls, theme_cls, resources_provider=None):
        if not context or not parent_layout or getattr(self, "_current_chk_box", None):
            return getattr(self, "_current_chk_box", None)
        try:
            FrameLayout = find_class("android.widget.FrameLayout")
            LinearLayoutClass = find_class("android.widget.LinearLayout")
            TextView = find_class("android.widget.TextView")
            GradientDrawable = find_class("android.graphics.drawable.GradientDrawable")
            Gravity = find_class("android.view.Gravity")
            TypedValue = find_class("android.util.TypedValue")
            AndroidUtilitiesClass = find_class("org.telegram.messenger.AndroidUtilities")
            LayoutHelper = find_class("org.telegram.ui.Components.LayoutHelper")

            card = FrameLayout(context)
            is_dark = self._is_dark_theme(theme_cls, resources_provider)
            card_bg = GradientDrawable()
            card_bg.setCornerRadius(float(AndroidUtilitiesClass.dp(16)))
            bg_tint = with_alpha(0xFFEF5350 if is_dark else 0xFFF44336, 0x2A if is_dark else 0x18)
            self._set_drawable_color(card_bg, bg_tint)
            self._set_drawable_stroke(card_bg, AndroidUtilitiesClass.dp(1), with_alpha(0xFFFF7961 if is_dark else 0xFFF44336, 0x60 if is_dark else 0x40))
            card.setBackground(card_bg)
            card.setClickable(True)
            card.setFocusable(True)

            row = LinearLayoutClass(context)
            row.setOrientation(LinearLayoutClass.HORIZONTAL)
            row.setGravity(Gravity.CENTER)
            row.setPadding(
                AndroidUtilitiesClass.dp(16),
                AndroidUtilitiesClass.dp(12),
                AndroidUtilitiesClass.dp(16),
                AndroidUtilitiesClass.dp(12)
            )

            state = {"checked": False}

            icon_frame = FrameLayout(context)
            icon_bg = GradientDrawable()
            icon_bg.setCornerRadius(float(AndroidUtilitiesClass.dp(6)))
            self._set_drawable_color(icon_bg, 0x00000000)
            self._set_drawable_stroke(icon_bg, AndroidUtilitiesClass.dp(2), 0xFFFF8A80 if is_dark else 0xFFE57373)
            icon_frame.setBackground(icon_bg)

            check_view = TextView(context)
            check_view.setText("✓")
            check_view.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13)
            check_view.setTypeface(AndroidUtilitiesClass.bold())
            check_view.setGravity(Gravity.CENTER)
            self._set_text_color(check_view, 0xFFFFFFFF)
            check_view.setVisibility(View.GONE)
            icon_frame.addView(check_view, LayoutHelper.createFrame(-1, -1, Gravity.CENTER))

            row.addView(icon_frame, LayoutHelper.createLinear(20, 20, Gravity.CENTER_VERTICAL, 0, 0, 10, 0))

            is_update = getattr(self, "_current_is_update", False)

            label = TextView(context)
            label.setText(_tr("Я понимаю все риски, все равно обновить", "I understand all risks, update anyway") if is_update else _tr("Я понимаю все риски, все равно установить", "I understand all risks, install anyway"))
            label.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13)
            label.setTypeface(AndroidUtilitiesClass.bold())
            label.setGravity(Gravity.CENTER_VERTICAL)
            self._set_text_color(label, 0xFFFFCDD2 if is_dark else 0xFFB71C1C)
            row.addView(label, LayoutHelper.createLinear(-2, -2, Gravity.CENTER_VERTICAL))

            card.addView(row, LayoutHelper.createFrame(-2, -2, Gravity.CENTER))

            class BlockedClickListener(dynamic_proxy(View.OnClickListener)):
                def onClick(self_inner, v):
                    try:
                        frag = get_last_fragment()
                        if frag:
                            BulletinHelper.show_error(_tr("Обновление заблокировано PluginGuard (опасный плагин)", "Update blocked by PluginGuard (dangerous plugin)") if is_update else _tr("Установка заблокирована PluginGuard (опасный плагин)", "Installation blocked by PluginGuard (dangerous plugin)"), frag)
                    except Exception:
                        pass
                    finally:
                        del v

            def update_card_state(is_checked: bool):
                state["checked"] = is_checked
                try:
                    if is_checked:
                        self._set_drawable_color(icon_bg, 0xFFF44336)
                        self._set_drawable_stroke(icon_bg, AndroidUtilitiesClass.dp(2), 0xFFF44336)
                        check_view.setVisibility(View.VISIBLE)
                        self._set_drawable_color(card_bg, with_alpha(0xFFF44336, 0x32 if is_dark else 0x22))
                        self._set_drawable_stroke(card_bg, AndroidUtilitiesClass.dp(1), with_alpha(0xFFF44336, 0x90))
                        self._set_text_color(label, 0xFFFFFFFF if is_dark else 0xFFB71C1C)
                        if install_btn:
                            install_btn.setEnabled(True)
                            install_btn.setClickable(True)
                            install_btn.setAlpha(1.0)
                            self._safe_set_text(install_btn, _tr("Обновить", "Update") if is_update else _tr("Установить", "Install"))
                            if orig_listener:
                                install_btn.setOnClickListener(orig_listener)
                    else:
                        self._set_drawable_color(icon_bg, 0x00000000)
                        self._set_drawable_stroke(icon_bg, AndroidUtilitiesClass.dp(2), 0xFFFF8A80 if is_dark else 0xFFE57373)
                        check_view.setVisibility(View.GONE)
                        self._set_drawable_color(card_bg, with_alpha(0xFFF44336, 0x1E if is_dark else 0x14))
                        self._set_drawable_stroke(card_bg, AndroidUtilitiesClass.dp(1), with_alpha(0xFFF44336, 0x48 if is_dark else 0x30))
                        self._set_text_color(label, 0xFFFFCDD2 if is_dark else 0xFFB71C1C)
                        if install_btn:
                            install_btn.setEnabled(False)
                            install_btn.setClickable(False)
                            install_btn.setAlpha(0.4)
                            self._safe_set_text(install_btn, _tr("Обновление заблокировано", "Update blocked") if is_update else _tr("Установка заблокирована", "Installation blocked"))
                            install_btn.setOnClickListener(BlockedClickListener())
                except Exception as ex:
                    self.log(f"[PluginGuard UI ERROR] update_card_state: {ex}")

            class CardClickListener(dynamic_proxy(View.OnClickListener)):
                def onClick(self_inner, v):
                    try:
                        try:
                            HapticFeedbackConstants = find_class("android.view.HapticFeedbackConstants")
                            if HapticFeedbackConstants and hasattr(v, "performHapticFeedback"):
                                v.performHapticFeedback(getattr(HapticFeedbackConstants, "KEYBOARD_TAP", 3))
                        except Exception:
                            pass
                        new_state = not state["checked"]
                        update_card_state(new_state)
                    except Exception:
                        pass
                    finally:
                        del v

            card.setOnClickListener(CardClickListener())

            target_parent = parent_layout
            kpm_split = getattr(self, "_current_kpm_split", None)
            if not kpm_split and install_btn and hasattr(install_btn, "getParent"):
                curr_p = install_btn.getParent()
                if curr_p and (str(getattr(curr_p, "getTag", lambda: "")() or "") == "kpm_split_container" or (hasattr(curr_p, "getOrientation") and curr_p.getOrientation() == 0)):
                    kpm_split = curr_p
                    if curr_p.getParent():
                        target_parent = curr_p.getParent()
            if target_parent and (str(getattr(target_parent, "getTag", lambda: "")() or "") == "kpm_split_container" or (hasattr(target_parent, "getOrientation") and target_parent.getOrientation() == 0)):
                if target_parent.getParent():
                    kpm_split = target_parent
                    target_parent = target_parent.getParent()

            if kpm_split:
                cb_lp = lin_cls.LayoutParams(-1, -2) if lin_cls else None
                if cb_lp and util_cls:
                    cb_lp.leftMargin = util_cls.dp(16)
                    cb_lp.rightMargin = util_cls.dp(16)
                    cb_lp.topMargin = util_cls.dp(8)
                    cb_lp.bottomMargin = util_cls.dp(4)
                cb_idx = -1
                for i in range(target_parent.getChildCount()):
                    if target_parent.getChildAt(i) == kpm_split:
                        cb_idx = i
                        break
                if cb_idx == -1:
                    cb_idx = 0
                if cb_lp:
                    target_parent.addView(card, cb_idx, cb_lp)
                else:
                    target_parent.addView(card, cb_idx)
            else:
                inst_lp = install_btn.getLayoutParams() if install_btn else None
                if inst_lp and lin_cls and isinstance(inst_lp, lin_cls.LayoutParams):
                    cb_lp = lin_cls.LayoutParams(inst_lp)
                elif lin_cls:
                    cb_lp = lin_cls.LayoutParams(-1, -2)
                else:
                    cb_lp = None

                if cb_lp and util_cls:
                    if not (inst_lp and hasattr(inst_lp, "leftMargin") and inst_lp.leftMargin > 0):
                        cb_lp.leftMargin = util_cls.dp(16)
                        cb_lp.rightMargin = util_cls.dp(16)
                    cb_lp.topMargin = util_cls.dp(8)
                    cb_lp.bottomMargin = util_cls.dp(4)

                analyze_btn = getattr(self, "_current_analyze_btn", None)
                cb_idx = -1
                if analyze_btn:
                    for i in range(target_parent.getChildCount()):
                        if target_parent.getChildAt(i) == analyze_btn:
                            cb_idx = i
                            break
                if cb_idx == -1:
                    cb_idx = target_parent.getChildCount()

                if cb_lp:
                    target_parent.addView(card, cb_idx, cb_lp)
                else:
                    target_parent.addView(card, cb_idx)

            self._current_chk_box = card
            return card
        except Exception as e:
            self.log(f"[PluginGuard UI ERROR] _create_confirmation_card: {e}")
            return None

    def _fix_sheet_navigation_bar(self, sheet: Any, color: int):
        try:
            sheet.fixNavigationBar(as_java_color(color))
        except Exception:
            pass

    def _theme_color(self, theme_cls: Any, key: Any, default_color: int, resources_provider: Any = None) -> int:
        if theme_cls is None or key is None:
            return default_color
        try:
            if resources_provider is not None:
                try:
                    return int(theme_cls.getColor(key, resources_provider))
                except Exception:
                    pass
            return int(theme_cls.getColor(key))
        except Exception:
            return default_color

    def _get_monet_or_theme_accent(self, context: Any, theme_cls: Any, resources_provider: Any = None) -> int:
        is_dark = self._is_dark_theme(theme_cls, resources_provider)
        if context is not None:
            try:
                BuildVersion = find_class("android.os.Build$VERSION")
                if BuildVersion and int(getattr(BuildVersion, "SDK_INT", 0)) >= 31:
                    res = context.getResources()
                    accent_key = "system_accent1_200" if is_dark else "system_accent1_600"
                    res_id = res.getIdentifier(accent_key, "color", "android")
                    if not res_id and is_dark:
                        res_id = res.getIdentifier("system_accent1_300", "color", "android")
                    if not res_id:
                        res_id = res.getIdentifier("system_accent1_600", "color", "android")
                    if res_id:
                        col = int(context.getColor(res_id))
                        return self._adjust_luminance(col, 40) if is_dark else col
            except Exception:
                pass
        fallback = self._theme_color(theme_cls, getattr(theme_cls, "key_featuredStickers_addButton", None), 0xFF52A5F5 if is_dark else 0xFF2675C8, resources_provider)
        return self._adjust_luminance(fallback, 30) if is_dark else fallback

    def _is_dark_theme(self, theme_cls: Any, resources_provider: Any = None) -> bool:
        bg = self._theme_color(theme_cls, getattr(theme_cls, "key_windowBackgroundWhite", None), 0xFF101318, resources_provider)
        r = (bg >> 16) & 0xFF
        g = (bg >> 8) & 0xFF
        b = bg & 0xFF
        lum = 0.299 * r + 0.587 * g + 0.114 * b
        return lum < 128

    def _adjust_luminance(self, color: int, delta: int) -> int:
        r = max(0, min(255, ((color >> 16) & 0xFF) + delta))
        g = max(0, min(255, ((color >> 8) & 0xFF) + delta))
        b = max(0, min(255, (color & 0xFF) + delta))
        a = (color >> 24) & 0xFF
        if a == 0 and color != 0:
            a = 0xFF
        return (a << 24) | (r << 16) | (g << 8) | b

    def _get_m3_surface_container(self, theme_cls: Any, resources_provider: Any = None, level: int = 1) -> int:
        base_bg = self._theme_color(theme_cls, getattr(theme_cls, "key_dialogBackground", None), 0xFF181C22, resources_provider)
        is_dark = self._is_dark_theme(theme_cls, resources_provider)
        deltas = {0: (-6 if is_dark else 10), 1: (10 if is_dark else -5), 2: (16 if is_dark else -10), 3: (24 if is_dark else -16)}
        d = deltas.get(level, 10 if is_dark else -5)
        return self._adjust_luminance(base_bg, d)

    def _set_drawable_color(self, drawable: Any, color: int):
        if drawable is None:
            return
        try:
            drawable.setColor(as_java_color(color))
        except Exception:
            pass

    def _set_drawable_stroke(self, drawable: Any, width: int, color: int):
        if drawable is None:
            return
        try:
            drawable.setStroke(int(width), as_java_color(color))
        except Exception:
            pass

    def _set_text_color(self, view: Any, color: int):
        if view is None:
            return
        try:
            view.setTextColor(as_java_color(color))
        except Exception:
            pass

    def _set_background_color(self, view: Any, color: int):
        if view is None:
            return
        try:
            view.setBackgroundColor(as_java_color(color))
        except Exception:
            pass

    def _set_color_filter(self, image_view: Any, color: int):
        if image_view is None:
            return
        try:
            PorterDuff = find_class("android.graphics.PorterDuff$Mode")
            PorterDuffColorFilter = find_class("android.graphics.PorterDuffColorFilter")
            if PorterDuff and PorterDuffColorFilter:
                image_view.setColorFilter(PorterDuffColorFilter(as_java_color(color), PorterDuff.SRC_IN))
            else:
                image_view.setColorFilter(as_java_color(color))
        except Exception:
            pass

    def _apply_icon_to_view(self, image_view: Any, icon_type: str, color: int, size_dp: int = 18, context: Any = None):
        if image_view is None:
            return
        try:
            vec = self._create_vector_drawable(icon_type, color, size_dp=size_dp, context=context)
            if vec:
                image_view.setImageDrawable(vec)
                return
        except Exception:
            pass

        try:
            RClass = find_class("org.telegram.messenger.R$drawable")
            if not RClass:
                return
            res_id = None
            if icon_type in ("critical", "danger", "error"):
                res_id = getattr(RClass, "msg2_block2", None) or getattr(RClass, "msg_block", None) or getattr(RClass, "msg_round_warning", None)
            elif icon_type == "warning":
                res_id = getattr(RClass, "menu_feature_warning", None) or getattr(RClass, "msg_round_warning", None) or getattr(RClass, "msg2_warning", None) or getattr(RClass, "msg2_block2", None)
            elif icon_type == "info":
                res_id = getattr(RClass, "msg_round_info", None) or getattr(RClass, "msg_info", None) or getattr(RClass, "menu_feature_reliable", None)
            elif icon_type == "audit":
                res_id = getattr(RClass, "msg_stats", None) or getattr(RClass, "msg_search", None) or getattr(RClass, "menu_feature_analytics", None) or getattr(RClass, "msg_round_info", None)
            elif icon_type == "check":
                res_id = getattr(RClass, "menu_feature_reliable", None) or getattr(RClass, "msg_round_check", None) or getattr(RClass, "msg_check", None)
            elif icon_type == "folder":
                res_id = getattr(RClass, "msg_folder", None) or getattr(RClass, "folder", None)
            elif icon_type in ("chevron_down", "chevron_up"):
                res_id = getattr(RClass, "arrow_more", None) or getattr(RClass, "msg_arrow_expand", None)

            if res_id:
                image_view.setImageResource(int(res_id))
                self._set_color_filter(image_view, color)
        except Exception:
            pass

    def _create_vector_drawable(self, icon_type: str, color: int, size_dp: int = 24, context: Any = None):
        try:
            Bitmap = find_class("android.graphics.Bitmap")
            BitmapConfig = find_class("android.graphics.Bitmap$Config")
            Canvas = find_class("android.graphics.Canvas")
            BitmapDrawable = find_class("android.graphics.drawable.BitmapDrawable")
            Paint = find_class("android.graphics.Paint")
            Path = find_class("android.graphics.Path")
            AndroidUtilitiesClass = find_class("org.telegram.messenger.AndroidUtilities")
            if not Bitmap or not Canvas or not BitmapDrawable or not Paint or not Path or not AndroidUtilitiesClass:
                return None

            size_px = max(int(AndroidUtilitiesClass.dp(size_dp)), 1)
            config = getattr(BitmapConfig, "ARGB_8888", None)
            if not config:
                return None
            bmp = Bitmap.createBitmap(size_px, size_px, config)
            if not bmp:
                return None

            canvas = Canvas(bmp)
            paint = Paint(Paint.ANTI_ALIAS_FLAG)
            paint.setStyle(Paint.Style.STROKE)
            paint.setStrokeCap(Paint.Cap.ROUND)
            paint.setStrokeJoin(Paint.Join.ROUND)
            paint.setColor(as_java_color(color))

            fill_paint = Paint(Paint.ANTI_ALIAS_FLAG)
            fill_paint.setStyle(Paint.Style.FILL)
            fill_paint.setColor(as_java_color(color))

            fill_tonal_paint = Paint(Paint.ANTI_ALIAS_FLAG)
            fill_tonal_paint.setStyle(Paint.Style.FILL)
            fill_tonal_paint.setColor(as_java_color(with_alpha(color, 0x36)))

            s = float(size_px) / 24.0
            paint.setStrokeWidth(float(max(2.2 * s, 1.2)))
            p = Path()

            if icon_type == "shield_check":
                p.moveTo(float(12.0 * s), float(2.5 * s))
                p.lineTo(float(4.5 * s), float(5.8 * s))
                p.lineTo(float(4.5 * s), float(12.0 * s))
                p.cubicTo(float(4.5 * s), float(17.2 * s), float(7.7 * s), float(21.0 * s), float(12.0 * s), float(22.2 * s))
                p.cubicTo(float(16.3 * s), float(21.0 * s), float(19.5 * s), float(17.2 * s), float(19.5 * s), float(12.0 * s))
                p.lineTo(float(19.5 * s), float(5.8 * s))
                p.close()
                canvas.drawPath(p, fill_tonal_paint)
                canvas.drawPath(p, paint)
                p.reset()
                p.moveTo(float(8.5 * s), float(12.0 * s))
                p.lineTo(float(11.0 * s), float(14.5 * s))
                p.lineTo(float(15.5 * s), float(9.5 * s))
                canvas.drawPath(p, paint)
            elif icon_type == "shield_alert":
                p.moveTo(float(12.0 * s), float(2.5 * s))
                p.lineTo(float(4.5 * s), float(5.8 * s))
                p.lineTo(float(4.5 * s), float(12.0 * s))
                p.cubicTo(float(4.5 * s), float(17.2 * s), float(7.7 * s), float(21.0 * s), float(12.0 * s), float(22.2 * s))
                p.cubicTo(float(16.3 * s), float(21.0 * s), float(19.5 * s), float(17.2 * s), float(19.5 * s), float(12.0 * s))
                p.lineTo(float(19.5 * s), float(5.8 * s))
                p.close()
                canvas.drawPath(p, fill_tonal_paint)
                canvas.drawPath(p, paint)
                canvas.drawLine(float(12.0 * s), float(7.8 * s), float(12.0 * s), float(13.5 * s), paint)
            elif icon_type == "chevron_down":
                p.moveTo(float(6.5 * s), float(9.5 * s))
                p.lineTo(float(12.0 * s), float(15.0 * s))
                p.lineTo(float(17.5 * s), float(9.5 * s))
                canvas.drawPath(p, paint)
            elif icon_type == "chevron_up":
                p.moveTo(float(6.5 * s), float(14.5 * s))
                p.lineTo(float(12.0 * s), float(9.0 * s))
                p.lineTo(float(17.5 * s), float(14.5 * s))
                canvas.drawPath(p, paint)

            if context and hasattr(context, "getResources"):
                try:
                    res = context.getResources()
                    drawable = BitmapDrawable(res, bmp)
                except Exception:
                    drawable = BitmapDrawable(bmp)
            else:
                try:
                    ApplicationLoader = find_class("org.telegram.messenger.ApplicationLoader")
                    app_ctx = ApplicationLoader.applicationContext if ApplicationLoader else None
                    if app_ctx and hasattr(app_ctx, "getResources"):
                        drawable = BitmapDrawable(app_ctx.getResources(), bmp)
                    else:
                        drawable = BitmapDrawable(bmp)
                except Exception:
                    drawable = BitmapDrawable(bmp)

            drawable.setBounds(0, 0, size_px, size_px)
            return drawable
        except Exception:
            return None

    def _show_report_bottom_sheet(self, context: Any, score: int, badge: str, reports: List[Dict[str, Any]], ai_stats: Dict[str, Any], has_critical: bool, file_path: str = ""):
        try:
            BottomSheet = find_class("org.telegram.ui.ActionBar.BottomSheet")
            ThemeClass = find_class("org.telegram.ui.ActionBar.Theme")
            LayoutHelper = find_class("org.telegram.ui.Components.LayoutHelper")
            LinearLayoutClass = find_class("android.widget.LinearLayout")
            ScrollView = find_class("android.widget.ScrollView")
            TextView = find_class("android.widget.TextView")
            ImageView = find_class("android.widget.ImageView")
            FrameLayout = find_class("android.widget.FrameLayout")
            View = find_class("android.view.View")
            TypedValue = find_class("android.util.TypedValue")
            Gravity = find_class("android.view.Gravity")
            GradientDrawable = find_class("android.graphics.drawable.GradientDrawable")
            AndroidUtilitiesClass = find_class("org.telegram.messenger.AndroidUtilities")
            ScaleStateListAnimator = find_class("org.telegram.ui.Components.ScaleStateListAnimator")

            if not BottomSheet or not context:
                return

            last_frag = get_last_fragment()
            resources_provider = self._get_theme_provider(last_frag) if last_frag else None

            monet_accent = self._get_monet_or_theme_accent(context, ThemeClass, resources_provider)
            is_dark = self._is_dark_theme(ThemeClass, resources_provider)
            sheet_container_bg = self._get_m3_surface_container(ThemeClass, resources_provider, level=1)
            card_surface_bg = self._get_m3_surface_container(ThemeClass, resources_provider, level=2)
            dialog_text_color = self._theme_color(ThemeClass, getattr(ThemeClass, "key_dialogTextBlack", None), 0xFFFFFFFF if is_dark else 0xFF1C1B1F, resources_provider)
            dialog_muted_color = self._theme_color(ThemeClass, getattr(ThemeClass, "key_dialogTextGray2", None), 0xFF9E9E9E if is_dark else 0xFF74777F, resources_provider)

            is_safe = (score >= 80 and not has_critical)
            if is_safe:
                verdict_color = 0xFF22C55E if is_dark else 0xFF16A34A
                verdict_title = _tr("Безопасно", "Safe")
                top_vector_type = "shield_check"
                monet_accent = verdict_color
            elif score >= 70 and not has_critical:
                verdict_color = 0xFF38BDF8 if is_dark else 0xFF0284C7
                verdict_title = _tr("Низкий риск", "Low Risk")
                top_vector_type = "shield_check"
            elif score >= 40 and not has_critical:
                verdict_color = 0xFFF59E0B if is_dark else 0xFFD97706
                verdict_title = _tr("Подозрительно", "Suspicious")
                top_vector_type = "shield_alert"
            else:
                verdict_color = 0xFFEF4444 if is_dark else 0xFFDC2626
                verdict_title = _tr("Опасность!", "Danger!")
                top_vector_type = "shield_alert"

            sheet = BottomSheet(context, False)
            self._fix_sheet_navigation_bar(sheet, sheet_container_bg)

            root = LinearLayoutClass(context)
            root.setOrientation(LinearLayoutClass.VERTICAL)
            root.setPadding(
                AndroidUtilitiesClass.dp(20),
                AndroidUtilitiesClass.dp(12),
                AndroidUtilitiesClass.dp(20),
                AndroidUtilitiesClass.dp(18)
            )
            self._set_background_color(root, sheet_container_bg)

            drag_handle = View(context)
            drag_bg = GradientDrawable()
            drag_bg.setCornerRadius(float(AndroidUtilitiesClass.dp(2)))
            handle_color = with_alpha(dialog_muted_color, 0x50)
            self._set_drawable_color(drag_bg, handle_color)
            drag_handle.setBackground(drag_bg)
            root.addView(drag_handle, LayoutHelper.createLinear(36, 4, Gravity.CENTER_HORIZONTAL, 0, 0, 0, 16))

            plugin_name_str = os.path.basename(file_path) if file_path else _tr("Плагин", "Plugin")
            plugin_initial = (plugin_name_str[:1].upper() if plugin_name_str else "P")

            icon_holder = FrameLayout(context)

            avatar_frame = FrameLayout(context)
            avatar_bg = GradientDrawable()
            avatar_bg.setShape(GradientDrawable.OVAL)
            self._set_drawable_color(avatar_bg, card_surface_bg)
            self._set_drawable_stroke(avatar_bg, AndroidUtilitiesClass.dp(2), with_alpha(verdict_color, 0x55 if is_dark else 0x40))
            avatar_frame.setBackground(avatar_bg)

            icon_loaded = False
            if file_path and os.path.exists(file_path):
                try:
                    icon_val = None
                    with open(file_path, "r", encoding="utf-8", errors="ignore") as f:
                        for _ in range(120):
                            line = f.readline()
                            if not line:
                                break
                            m = re.search(r'__icon__\s*=\s*["\']([^"\']+)["\']', line)
                            if m:
                                icon_val = m.group(1).strip()
                                break
                    if icon_val and "/" in icon_val:
                        parts = icon_val.split("/", 1)
                        pack_name = parts[0].strip()
                        icon_idx = int(parts[1].strip())
                        BackupImageView = find_class("org.telegram.ui.Components.BackupImageView")
                        MediaDataController = find_class("org.telegram.messenger.MediaDataController")
                        UserConfig = find_class("org.telegram.messenger.UserConfig")
                        if BackupImageView and MediaDataController:
                            biv = BackupImageView(context)
                            biv.setRoundRadius(AndroidUtilitiesClass.dp(32))
                            sel_acc = getattr(UserConfig, "selectedAccount", 0) if UserConfig else 0
                            mdc = MediaDataController.getInstance(sel_acc)
                            if mdc:
                                mdc.setPlaceholderImageByIndex(biv, pack_name, icon_idx, "78_78")
                                avatar_frame.addView(biv, LayoutHelper.createFrame(64, 64, Gravity.CENTER))
                                icon_loaded = True
                except Exception:
                    pass

            if not icon_loaded:
                avatar_text = TextView(context)
                avatar_text.setText(plugin_initial)
                avatar_text.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 26)
                avatar_text.setTypeface(AndroidUtilitiesClass.bold())
                avatar_text.setGravity(Gravity.CENTER)
                self._set_text_color(avatar_text, verdict_color)
                avatar_frame.addView(avatar_text, LayoutHelper.createFrame(-1, -1, Gravity.CENTER))

            icon_holder.addView(avatar_frame, LayoutHelper.createFrame(64, 64, Gravity.CENTER))

            badge_frame = FrameLayout(context)
            badge_bg = GradientDrawable()
            badge_bg.setShape(GradientDrawable.OVAL)
            self._set_drawable_color(badge_bg, sheet_container_bg)
            badge_frame.setBackground(badge_bg)
            badge_frame.setPadding(
                AndroidUtilitiesClass.dp(2),
                AndroidUtilitiesClass.dp(2),
                AndroidUtilitiesClass.dp(2),
                AndroidUtilitiesClass.dp(2)
            )

            badge_inner = FrameLayout(context)
            badge_inner_bg = GradientDrawable()
            badge_inner_bg.setShape(GradientDrawable.OVAL)
            self._set_drawable_color(badge_inner_bg, verdict_color)
            badge_inner.setBackground(badge_inner_bg)

            icon_view = ImageView(context)
            icon_view.clearColorFilter()
            top_vector = self._create_vector_drawable(top_vector_type, 0xFFFFFFFF, size_dp=18, context=context)
            if top_vector:
                icon_view.setImageDrawable(top_vector)
            else:
                try:
                    RClass = find_class("org.telegram.messenger.R$drawable")
                    fallback_res = getattr(RClass, "msg2_block2", None) if top_vector_type != "shield_check" else getattr(RClass, "menu_feature_reliable", None)
                    if fallback_res:
                        icon_view.setImageResource(int(fallback_res))
                        self._set_color_filter(icon_view, 0xFFFFFFFF)
                except Exception:
                    pass
            badge_inner.addView(icon_view, LayoutHelper.createFrame(18, 18, Gravity.CENTER))
            badge_frame.addView(badge_inner, LayoutHelper.createFrame(26, 26, Gravity.CENTER))

            icon_holder.addView(badge_frame, LayoutHelper.createFrame(30, 30, Gravity.BOTTOM | Gravity.RIGHT, 0, 0, 0, 0))
            root.addView(icon_holder, LayoutHelper.createLinear(72, 72, Gravity.CENTER_HORIZONTAL, 0, 0, 0, 10))

            title_view = TextView(context)
            title_view.setText(f"PluginGuard: {verdict_title}")
            title_view.setGravity(Gravity.CENTER)
            title_view.setTypeface(AndroidUtilitiesClass.bold())
            title_view.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 20)
            self._set_text_color(title_view, dialog_text_color)
            root.addView(title_view, LayoutHelper.createLinear(-1, -2, Gravity.CENTER_HORIZONTAL, 0, 0, 0, 4))

            plugin_name_str = os.path.basename(file_path) if file_path else _tr("Плагин", "Plugin")
            subtitle_view = TextView(context)
            subtitle_view.setText(plugin_name_str)
            subtitle_view.setGravity(Gravity.CENTER)
            subtitle_view.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13)
            self._set_text_color(subtitle_view, dialog_muted_color)
            root.addView(subtitle_view, LayoutHelper.createLinear(-1, -2, Gravity.CENTER_HORIZONTAL, 0, 0, 0, 12))

            def create_chip(text: str, text_color: int, bg_color: int):
                chip_frame = FrameLayout(context)
                chip_bg = GradientDrawable()
                chip_bg.setCornerRadius(float(AndroidUtilitiesClass.dp(8)))
                self._set_drawable_color(chip_bg, bg_color)
                chip_frame.setBackground(chip_bg)

                chip_layout = LinearLayoutClass(context)
                chip_layout.setOrientation(LinearLayoutClass.HORIZONTAL)
                chip_layout.setGravity(Gravity.CENTER)
                chip_layout.setPadding(
                    AndroidUtilitiesClass.dp(12),
                    AndroidUtilitiesClass.dp(6),
                    AndroidUtilitiesClass.dp(12),
                    AndroidUtilitiesClass.dp(6)
                )

                chip_text = TextView(context)
                chip_text.setText(text)
                chip_text.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 12)
                chip_text.setTypeface(AndroidUtilitiesClass.bold())
                self._set_text_color(chip_text, text_color)
                chip_layout.addView(chip_text, LayoutHelper.createLinear(-2, -2, Gravity.CENTER_VERTICAL))
                chip_frame.addView(chip_layout, LayoutHelper.createFrame(-2, -2, Gravity.CENTER))
                return chip_frame

            def create_divider():
                d_view = View(context)
                self._set_background_color(d_view, with_alpha(dialog_muted_color, 0x24 if is_dark else 0x1E))
                return d_view

            verdict_chip = create_chip(badge, verdict_color, with_alpha(verdict_color, 0x20 if is_dark else 0x16))
            if ScaleStateListAnimator:
                try:
                    ScaleStateListAnimator.apply(verdict_chip, 0.04, 1.2)
                except Exception:
                    pass
            if ai_stats.get("dex_found"):
                chips_row = LinearLayoutClass(context)
                chips_row.setOrientation(LinearLayoutClass.HORIZONTAL)
                chips_row.setGravity(Gravity.CENTER)
                chips_row.addView(verdict_chip, LayoutHelper.createLinear(-2, -2, 0, 0, 4, 0, 4))
                dex_ok = ai_stats.get("dex_decompiled", False)
                dex_chip_color = 0xFF4CAF50 if dex_ok else 0xFFF44336
                dex_chip_text = _tr("DEX: декомпилирован", "DEX: decompiled") if dex_ok else _tr("DEX: ошибка", "DEX: failed")
                dex_chip = create_chip(dex_chip_text, dex_chip_color, with_alpha(dex_chip_color, 0x20 if is_dark else 0x16))
                chips_row.addView(dex_chip, LayoutHelper.createLinear(-2, -2, 0, 4, 0, 4, 0))
                root.addView(chips_row, LayoutHelper.createLinear(-2, -2, Gravity.CENTER_HORIZONTAL, 0, 0, 0, 10))
            else:
                root.addView(verdict_chip, LayoutHelper.createLinear(-2, -2, Gravity.CENTER_HORIZONTAL, 0, 0, 0, 10))

            score_row = LinearLayoutClass(context)
            score_row.setOrientation(LinearLayoutClass.HORIZONTAL)
            score_row.setGravity(Gravity.CENTER_VERTICAL)

            score_label = TextView(context)
            score_label.setText(_tr("Оценка безопасности PluginGuard", "PluginGuard security score"))
            score_label.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 12)
            score_label.setTypeface(AndroidUtilitiesClass.bold())
            self._set_text_color(score_label, dialog_muted_color)
            score_row.addView(score_label, LayoutHelper.createLinear(0, -2, 1.0, Gravity.CENTER_VERTICAL))

            score_val_tv = TextView(context)
            score_val_tv.setText(f"{score}/100")
            score_val_tv.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13)
            score_val_tv.setTypeface(AndroidUtilitiesClass.bold())
            self._set_text_color(score_val_tv, verdict_color)
            score_row.addView(score_val_tv, LayoutHelper.createLinear(-2, -2, Gravity.CENTER_VERTICAL))

            root.addView(score_row, LayoutHelper.createLinear(-1, -2, 0, 4, 0, 4, 2))

            track_h_dp = 4
            track_radius = float(AndroidUtilitiesClass.dp(track_h_dp))

            progress_container = FrameLayout(context)

            track_bg = GradientDrawable()
            track_bg.setColor(as_java_color(with_alpha(verdict_color, 0x26)))
            track_bg.setCornerRadius(track_radius)
            progress_container.setBackground(track_bg)

            ratio = max(0.0, min(1.0, float(score) / 100.0))

            active_view = View(context)
            active_bg = GradientDrawable()
            active_bg.setColor(as_java_color(verdict_color))
            active_bg.setCornerRadius(track_radius)
            active_view.setBackground(active_bg)

            active_lp = FrameLayout.LayoutParams(0, FrameLayout.LayoutParams.MATCH_PARENT)
            active_lp.gravity = Gravity.LEFT | Gravity.CENTER_VERTICAL
            active_view.setLayoutParams(active_lp)
            progress_container.addView(active_view)

            root.addView(progress_container, LayoutHelper.createLinear(-1, track_h_dp, 0, 8, 0, 14))

            try:
                OnLayoutChangeListener = find_class("android.view.View$OnLayoutChangeListener")
                ValueAnimator = find_class("android.animation.ValueAnimator")
                DecelerateInterpolator = find_class("android.view.animation.DecelerateInterpolator")
                AnimatorUpdateListener = find_class("android.animation.ValueAnimator$AnimatorUpdateListener")
                if OnLayoutChangeListener:
                    anim_started = [False]
                    class ProgressLayoutListener(dynamic_proxy(OnLayoutChangeListener)):
                        def onLayoutChange(self_inner, v, left, top, right, bottom, oldLeft, oldTop, oldRight, oldBottom):
                            try:
                                total_w = int(right - left)
                                if total_w > 0 and not anim_started[0]:
                                    anim_started[0] = True
                                    target_w = max(0, int(total_w * ratio))
                                    if ValueAnimator and AnimatorUpdateListener and target_w > 0:
                                        score_val_tv.setText("0/100")
                                        anim = ValueAnimator.ofFloat([0.0, 1.0])
                                        anim.setDuration(950)
                                        anim.setStartDelay(180)
                                        if DecelerateInterpolator:
                                            anim.setInterpolator(DecelerateInterpolator(1.8))
                                        class AnimUpdateListener(dynamic_proxy(AnimatorUpdateListener)):
                                            def onAnimationUpdate(self_u, animation):
                                                try:
                                                    frac = float(animation.getAnimatedValue())
                                                    cur_w = int(target_w * frac)
                                                    lp = active_view.getLayoutParams()
                                                    if lp:
                                                        lp.width = cur_w
                                                        active_view.setLayoutParams(lp)
                                                    cur_score = int(score * frac)
                                                    score_val_tv.setText(f"{cur_score}/100")
                                                except Exception:
                                                    pass
                                                finally:
                                                    del animation
                                        anim.addUpdateListener(AnimUpdateListener())
                                        anim.start()
                                    else:
                                        lp = active_view.getLayoutParams()
                                        if lp:
                                            lp.width = target_w
                                            active_view.setLayoutParams(lp)
                                        score_val_tv.setText(f"{score}/100")
                            except Exception:
                                pass
                            finally:
                                del v
                    progress_container.addOnLayoutChangeListener(ProgressLayoutListener())
            except Exception:
                pass

            scroll_view = ScrollView(context)
            scroll_view.setVerticalScrollBarEnabled(False)
            try:
                scroll_view.setNestedScrollingEnabled(True)
            except Exception:
                pass
            try:
                scroll_view.setFillViewport(True)
            except Exception:
                pass

            class ScrollTouchListener(dynamic_proxy(View.OnTouchListener)):
                def onTouch(self_inner, v, event):
                    try:
                        p = v.getParent()
                        if p:
                            p.requestDisallowInterceptTouchEvent(True)
                    except Exception:
                        pass
                    finally:
                        del v, event
                    return False

            scroll_view.setOnTouchListener(ScrollTouchListener())
            scroll_layout = LinearLayoutClass(context)
            scroll_layout.setOrientation(LinearLayoutClass.VERTICAL)

            def create_copy_listener(text_to_copy: str):
                class RowLongClickListener(dynamic_proxy(find_class("android.view.View$OnLongClickListener"))):
                    def onLongClick(self_l, v):
                        try:
                            try:
                                HapticFeedbackConstants = find_class("android.view.HapticFeedbackConstants")
                                if HapticFeedbackConstants and hasattr(v, "performHapticFeedback"):
                                    v.performHapticFeedback(getattr(HapticFeedbackConstants, "LONG_PRESS", 0))
                            except Exception:
                                pass
                            AndroidUtilitiesClass.addToClipboard(text_to_copy)
                            try:
                                BulletinHelper.show_success(_tr("Детали скопированы", "Details copied"))
                            except Exception:
                                pass
                            return True
                        except Exception:
                            return False
                        finally:
                            del v
                return RowLongClickListener()

            def create_issue_card(title: str, items: Any, color: int, icon_type: str = "warning", collapsible: bool = False, initially_collapsed: bool = False, badge_text: str = ""):
                card_frame = FrameLayout(context)
                card_bg = GradientDrawable()
                card_bg.setCornerRadius(float(AndroidUtilitiesClass.dp(16)))
                self._set_drawable_color(card_bg, with_alpha(color, 0x1A if is_dark else 0x12))
                self._set_drawable_stroke(card_bg, AndroidUtilitiesClass.dp(1), with_alpha(color, 0x38 if is_dark else 0x2A))
                card_frame.setBackground(card_bg)

                card_frame.setClipChildren(True)
                card_frame.setClipToPadding(True)

                card_layout = LinearLayoutClass(context)
                card_layout.setOrientation(LinearLayoutClass.VERTICAL)
                card_layout.setClipChildren(True)
                card_layout.setClipToPadding(True)
                card_layout.setPadding(
                    AndroidUtilitiesClass.dp(16),
                    AndroidUtilitiesClass.dp(14),
                    AndroidUtilitiesClass.dp(16),
                    AndroidUtilitiesClass.dp(14)
                )

                header_layout = LinearLayoutClass(context)
                header_layout.setOrientation(LinearLayoutClass.HORIZONTAL)
                header_layout.setGravity(Gravity.CENTER_VERTICAL)

                t_view = TextView(context)
                t_view.setText(title)
                t_view.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 14)
                t_view.setTypeface(AndroidUtilitiesClass.bold())
                self._set_text_color(t_view, color)

                content_layout = LinearLayoutClass(context)
                content_layout.setOrientation(LinearLayoutClass.VERTICAL)
                content_layout.setClipChildren(True)
                content_layout.setClipToPadding(True)
                content_layout.setPadding(0, AndroidUtilitiesClass.dp(8), 0, 0)

                if collapsible:
                    header_layout.addView(t_view, LayoutHelper.createLinear(-2, -2, Gravity.CENTER_VERTICAL, 0, 0, 8, 0))
                    if badge_text:
                        badge_layout = FrameLayout(context)
                        badge_bg = GradientDrawable()
                        badge_bg.setCornerRadius(float(AndroidUtilitiesClass.dp(6)))
                        self._set_drawable_color(badge_bg, with_alpha(0xFFEF4444 if is_dark else 0xFFDC2626, 0x28))
                        self._set_drawable_stroke(badge_bg, AndroidUtilitiesClass.dp(1), with_alpha(0xFFEF4444 if is_dark else 0xFFDC2626, 0x70))
                        badge_layout.setBackground(badge_bg)
                        badge_layout.setPadding(
                            AndroidUtilitiesClass.dp(6),
                            AndroidUtilitiesClass.dp(2),
                            AndroidUtilitiesClass.dp(6),
                            AndroidUtilitiesClass.dp(2)
                        )
                        badge_tv = TextView(context)
                        badge_tv.setText(badge_text)
                        badge_tv.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 10)
                        badge_tv.setTypeface(AndroidUtilitiesClass.bold())
                        self._set_text_color(badge_tv, 0xFFEF4444 if is_dark else 0xFFDC2626)
                        badge_layout.addView(badge_tv, LayoutHelper.createFrame(-2, -2, Gravity.CENTER))
                        header_layout.addView(badge_layout, LayoutHelper.createLinear(-2, -2, Gravity.CENTER_VERTICAL, 0, 0, 8, 0))

                    spacer = View(context)
                    header_layout.addView(spacer, LayoutHelper.createLinear(0, 0, 1.0))

                    chevron_view = ImageView(context)
                    self._apply_icon_to_view(chevron_view, "chevron_down", color, size_dp=18, context=context)
                    if not initially_collapsed:
                        chevron_view.setRotation(180.0)
                    header_layout.addView(chevron_view, LayoutHelper.createLinear(18, 18, Gravity.CENTER_VERTICAL))

                    is_expanded = [not initially_collapsed]
                    current_animator = [None]
                    if initially_collapsed:
                        content_layout.setVisibility(View.GONE)

                    class CardHeaderClickListener(dynamic_proxy(View.OnClickListener)):
                        def onClick(self_inner, v):
                            try:
                                try:
                                    HapticFeedbackConstants = find_class("android.view.HapticFeedbackConstants")
                                    if HapticFeedbackConstants and hasattr(v, "performHapticFeedback"):
                                        v.performHapticFeedback(getattr(HapticFeedbackConstants, "KEYBOARD_TAP", 3))
                                except Exception:
                                    pass

                                is_expanded[0] = not is_expanded[0]
                                expanding = is_expanded[0]

                                if current_animator[0]:
                                    try:
                                        current_animator[0].cancel()
                                    except Exception:
                                        pass

                                ValueAnimator = find_class("android.animation.ValueAnimator")
                                CubicBezierInterpolator = find_class("org.telegram.ui.Components.CubicBezierInterpolator")
                                interpolator = getattr(CubicBezierInterpolator, "EASE_OUT_QUINT", None) if CubicBezierInterpolator else None

                                if hasattr(chevron_view, "animate"):
                                    chevron_view.animate().rotation(180.0 if expanding else 0.0).setDuration(220).start()
                                else:
                                    chevron_view.setRotation(180.0 if expanding else 0.0)

                                if expanding:
                                    content_layout.setVisibility(View.VISIBLE)
                                    content_layout.setAlpha(0.0)
                                    w = card_layout.getWidth() - AndroidUtilitiesClass.dp(32)
                                    if w <= 0:
                                        w = AndroidUtilitiesClass.dp(300)
                                    View_MeasureSpec = find_class("android.view.View$MeasureSpec")
                                    spec_w = View_MeasureSpec.makeMeasureSpec(w, View_MeasureSpec.EXACTLY)
                                    spec_h = View_MeasureSpec.makeMeasureSpec(0, View_MeasureSpec.UNSPECIFIED)
                                    content_layout.measure(spec_w, spec_h)
                                    target_h = content_layout.getMeasuredHeight()
                                    if target_h <= 0:
                                        target_h = AndroidUtilitiesClass.dp(160)
                                    start_h = 0
                                    end_h = target_h
                                else:
                                    start_h = content_layout.getHeight()
                                    if start_h <= 0:
                                        start_h = content_layout.getMeasuredHeight()
                                    end_h = 0

                                if ValueAnimator:
                                    anim = ValueAnimator.ofFloat([0.0, 1.0])
                                    anim.setDuration(220)
                                    if interpolator:
                                        try:
                                            anim.setInterpolator(interpolator)
                                        except Exception:
                                            pass

                                    class AnimUpdate(dynamic_proxy(find_class("android.animation.ValueAnimator$AnimatorUpdateListener"))):
                                        def onAnimationUpdate(self_u, *args):
                                            try:
                                                animation = args[0] if args else None
                                                if animation:
                                                    frac = float(animation.getAnimatedValue())
                                                    cur_h = int(start_h + (end_h - start_h) * frac)
                                                    lp = content_layout.getLayoutParams()
                                                    if lp:
                                                        lp.height = max(0, cur_h)
                                                        content_layout.setLayoutParams(lp)
                                                    content_layout.setAlpha(frac if expanding else (1.0 - frac))
                                            except Exception:
                                                pass

                                    class AnimEnd(dynamic_proxy(find_class("android.animation.Animator$AnimatorListener"))):
                                        def onAnimationEnd(self_e, *args):
                                            try:
                                                if not expanding:
                                                    content_layout.setVisibility(View.GONE)
                                                lp = content_layout.getLayoutParams()
                                                if lp:
                                                    lp.height = -2
                                                    content_layout.setLayoutParams(lp)
                                                content_layout.setAlpha(1.0)
                                            except Exception:
                                                pass
                                        def onAnimationStart(self_e, *args):
                                            pass
                                        def onAnimationCancel(self_e, *args):
                                            pass
                                        def onAnimationRepeat(self_e, *args):
                                            pass

                                    anim.addUpdateListener(AnimUpdate())
                                    anim.addListener(AnimEnd())
                                    current_animator[0] = anim
                                    anim.start()
                                else:
                                    content_layout.setVisibility(View.VISIBLE if expanding else View.GONE)
                            except Exception:
                                content_layout.setVisibility(View.VISIBLE if is_expanded[0] else View.GONE)
                            finally:
                                del v

                    header_layout.setClickable(True)
                    header_layout.setFocusable(True)
                    header_layout.setOnClickListener(CardHeaderClickListener())
                else:
                    header_layout.addView(t_view, LayoutHelper.createLinear(-2, -2, Gravity.CENTER_VERTICAL))

                card_layout.addView(header_layout, LayoutHelper.createLinear(-1, -2))

                lines_list = items if isinstance(items, list) else [items]
                for idx, item in enumerate(lines_list):
                    if idx > 0:
                        content_layout.addView(create_divider(), LayoutHelper.createLinear(-1, 1, 0, 0, 8, 0, 8))
                    if isinstance(item, dict):
                        item_title = str(item.get("title", "")).lstrip("•").strip()
                        item_detail = str(item.get("detail", "")).strip()
                        item_rule = str(item.get("rule", "")).strip()
                    elif isinstance(item, str):
                        parts = item.split("\n", 1)
                        item_title = parts[0].lstrip("•").strip()
                        item_detail = parts[1].strip() if len(parts) > 1 else ""
                        item_rule = ""
                    else:
                        item_title = str(item).lstrip("•").strip()
                        item_detail = ""
                        item_rule = ""

                    row = LinearLayoutClass(context)
                    row.setOrientation(LinearLayoutClass.HORIZONTAL)
                    row.setGravity(Gravity.TOP)
                    row.setClickable(True)
                    row.setFocusable(True)
                    copy_text = f"{item_title} [{item_rule}]\n{item_detail}" if item_rule and item_detail else (item_title + (f"\n{item_detail}" if item_detail else ""))
                    row.setOnLongClickListener(create_copy_listener(copy_text))

                    pill = View(context)
                    pill_bg = GradientDrawable()
                    pill_bg.setCornerRadius(float(AndroidUtilitiesClass.dp(2)))
                    self._set_drawable_color(pill_bg, color)
                    pill.setBackground(pill_bg)
                    row.addView(pill, LayoutHelper.createLinear(3, 14, 0, 0, 2, 8, 0))

                    text_col = LinearLayoutClass(context)
                    text_col.setOrientation(LinearLayoutClass.VERTICAL)

                    it_title_view = TextView(context)
                    it_title_view.setText(item_title)
                    it_title_view.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13)
                    it_title_view.setTypeface(AndroidUtilitiesClass.bold())
                    self._set_text_color(it_title_view, dialog_text_color)
                    text_col.addView(it_title_view, LayoutHelper.createLinear(-1, -2))

                    if item_detail:
                        it_desc_view = TextView(context)
                        it_desc_view.setText(item_detail)
                        it_desc_view.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 12)
                        self._set_text_color(it_desc_view, dialog_muted_color)
                        try:
                            it_desc_view.setLineSpacing(AndroidUtilitiesClass.dp(1), 1.1)
                        except Exception:
                            pass
                        text_col.addView(it_desc_view, LayoutHelper.createLinear(-1, -2, 0, 0, 2, 0, 0))

                    row.addView(text_col, LayoutHelper.createLinear(0, -2, 1.0))
                    content_layout.addView(row, LayoutHelper.createLinear(-1, -2))

                card_layout.addView(content_layout, LayoutHelper.createLinear(-1, -2))
                card_frame.addView(card_layout, LayoutHelper.createFrame(-1, -2))
                return card_frame

            def create_note_card(title: str, description: Any, accent_color: int, icon_type: str = ""):
                card_frame = FrameLayout(context)
                card_bg = GradientDrawable()
                card_bg.setCornerRadius(float(AndroidUtilitiesClass.dp(16)))
                self._set_drawable_color(card_bg, with_alpha(card_surface_bg, 0xFF))
                self._set_drawable_stroke(card_bg, AndroidUtilitiesClass.dp(1), with_alpha(accent_color, 0x30 if is_dark else 0x22))
                card_frame.setBackground(card_bg)

                card_layout = LinearLayoutClass(context)
                card_layout.setOrientation(LinearLayoutClass.VERTICAL)
                card_layout.setPadding(
                    AndroidUtilitiesClass.dp(16),
                    AndroidUtilitiesClass.dp(14),
                    AndroidUtilitiesClass.dp(16),
                    AndroidUtilitiesClass.dp(14)
                )

                header_layout = LinearLayoutClass(context)
                header_layout.setOrientation(LinearLayoutClass.HORIZONTAL)
                header_layout.setGravity(Gravity.CENTER_VERTICAL)

                t_view = TextView(context)
                t_view.setText(title)
                t_view.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 14)
                t_view.setTypeface(AndroidUtilitiesClass.bold())
                self._set_text_color(t_view, accent_color)
                header_layout.addView(t_view, LayoutHelper.createLinear(-2, -2, Gravity.CENTER_VERTICAL))

                card_layout.addView(header_layout, LayoutHelper.createLinear(-1, -2, 0, 0, 0, 0, 8))

                if isinstance(description, list) or (isinstance(description, str) and "\n" in description):
                    lines_list = description if isinstance(description, list) else [x.strip() for x in description.split("\n") if x.strip()]
                    for idx, item_text in enumerate(lines_list):
                        if idx > 0:
                            card_layout.addView(create_divider(), LayoutHelper.createLinear(-1, 1, 0, 0, 8, 0, 8))
                        cleaned_text = item_text.lstrip("•").strip()
                        row = LinearLayoutClass(context)
                        row.setOrientation(LinearLayoutClass.HORIZONTAL)
                        row.setGravity(Gravity.TOP)
                        row.setClickable(True)
                        row.setFocusable(True)
                        row.setOnLongClickListener(create_copy_listener(cleaned_text))

                        pill = View(context)
                        pill_bg = GradientDrawable()
                        pill_bg.setCornerRadius(float(AndroidUtilitiesClass.dp(2)))
                        self._set_drawable_color(pill_bg, with_alpha(accent_color, 0x90))
                        pill.setBackground(pill_bg)
                        row.addView(pill, LayoutHelper.createLinear(3, 14, 0, 0, 2, 8, 0))

                        it_view = TextView(context)
                        it_view.setText(cleaned_text)
                        it_view.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13)
                        self._set_text_color(it_view, dialog_text_color)
                        try:
                            it_view.setLineSpacing(AndroidUtilitiesClass.dp(2), 1.15)
                        except Exception:
                            pass
                        row.addView(it_view, LayoutHelper.createLinear(-1, -2))
                        card_layout.addView(row, LayoutHelper.createLinear(-1, -2))
                else:
                    d_text = str(description).lstrip("•").strip()
                    d_view = TextView(context)
                    d_view.setText(d_text)
                    d_view.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13)
                    self._set_text_color(d_view, dialog_text_color)
                    try:
                        d_view.setLineSpacing(AndroidUtilitiesClass.dp(3), 1.15)
                    except Exception:
                        pass
                    d_view.setClickable(True)
                    d_view.setFocusable(True)
                    d_view.setOnLongClickListener(create_copy_listener(d_text))
                    card_layout.addView(d_view, LayoutHelper.createLinear(-1, -2))

                card_frame.addView(card_layout, LayoutHelper.createFrame(-1, -2))
                return card_frame

            def create_heatmap_card():
                card_frame = FrameLayout(context)
                card_bg = GradientDrawable()
                card_bg.setCornerRadius(float(AndroidUtilitiesClass.dp(16)))
                self._set_drawable_color(card_bg, with_alpha(card_surface_bg, 0xFF))
                self._set_drawable_stroke(card_bg, AndroidUtilitiesClass.dp(1), with_alpha(monet_accent, 0x30 if is_dark else 0x22))
                card_frame.setBackground(card_bg)

                card_layout = LinearLayoutClass(context)
                card_layout.setOrientation(LinearLayoutClass.VERTICAL)
                card_layout.setPadding(
                    AndroidUtilitiesClass.dp(16),
                    AndroidUtilitiesClass.dp(14),
                    AndroidUtilitiesClass.dp(16),
                    AndroidUtilitiesClass.dp(14)
                )

                header_layout = LinearLayoutClass(context)
                header_layout.setOrientation(LinearLayoutClass.HORIZONTAL)
                header_layout.setGravity(Gravity.CENTER_VERTICAL)

                t_view = TextView(context)
                t_view.setText(_tr("Карта секторов кода", "Code Sector Map"))
                t_view.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 14)
                t_view.setTypeface(AndroidUtilitiesClass.bold())
                self._set_text_color(t_view, monet_accent)
                header_layout.addView(t_view, LayoutHelper.createLinear(0, -2, 1.0, Gravity.CENTER_VERTICAL))

                card_layout.addView(header_layout, LayoutHelper.createLinear(-1, -2, 0, 0, 0, 0, 10))

                file_lines = []
                if file_path and os.path.exists(file_path):
                    try:
                        with open(file_path, "r", encoding="utf-8", errors="ignore") as f:
                            file_lines = f.readlines()
                    except Exception:
                        pass
                total_lines = max(1, len(file_lines)) if file_lines else max([int(r.get("line", 0)) for r in reports] + [100])

                num_cells = 20
                cols = 10
                rows = 2
                step = max(1, int(math.ceil(total_lines / float(num_cells))))

                grid_container = LinearLayoutClass(context)
                grid_container.setOrientation(LinearLayoutClass.VERTICAL)

                hint_view = TextView(context)
                hint_view.setText(_tr("Нажмите на сектор для просмотра деталей", "Tap a sector to view details"))
                hint_view.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 12)
                self._set_text_color(hint_view, dialog_muted_color)

                selected_cell_view = [None]
                selected_cell_bg = [None]
                selected_cell_default_color = [0]

                OBF_RULES = {
                    "OBFUSCATED_CODE_STRUCTURE", "MULTI_LAYER_OBFUSCATION_UNPACKED",
                    "HIGH_ENTROPY_LITERAL_DETECTED", "DYNAMIC_CODE_COMPILATION",
                    "DYNAMIC_CODE_EXECUTION", "BYTE_XOR_DECRYPTION_LOOP", "HIDDEN_XOR_PAYLOAD"
                }

                def create_cell_click_listener(c_idx, l_start, l_end, c_level, c_threats, c_col, c_view, c_bg):
                    class CellClickListener(dynamic_proxy(View.OnClickListener)):
                        def onClick(self_c, v):
                            try:
                                try:
                                    HapticFeedbackConstants = find_class("android.view.HapticFeedbackConstants")
                                    if HapticFeedbackConstants and hasattr(v, "performHapticFeedback"):
                                        v.performHapticFeedback(getattr(HapticFeedbackConstants, "KEYBOARD_TAP", 3))
                                except Exception:
                                    pass

                                if selected_cell_bg[0] and selected_cell_view[0]:
                                    self._set_drawable_color(selected_cell_bg[0], selected_cell_default_color[0])
                                    self._set_drawable_stroke(selected_cell_bg[0], 0, 0)

                                selected_cell_view[0] = c_view
                                selected_cell_bg[0] = c_bg
                                selected_cell_default_color[0] = c_col

                                self._set_drawable_color(c_bg, c_col)
                                self._set_drawable_stroke(c_bg, AndroidUtilitiesClass.dp(2), dialog_text_color)

                                if c_level == "CRITICAL":
                                    txt = f"{_tr('Сектор', 'Sector')} {c_idx+1} ({_tr('строки', 'lines')} {l_start}–{l_end}): {_tr('Критическая угроза', 'Critical threat')}{' — ' + c_threats if c_threats else ''}"
                                elif c_level == "OBFUSCATED":
                                    txt = f"{_tr('Сектор', 'Sector')} {c_idx+1} ({_tr('строки', 'lines')} {l_start}–{l_end}): {_tr('Обфусцированный / скрытый код', 'Obfuscated / hidden code')}{' — ' + c_threats if c_threats else ''}"
                                elif c_level == "WARNING":
                                    txt = f"{_tr('Сектор', 'Sector')} {c_idx+1} ({_tr('строки', 'lines')} {l_start}–{l_end}): {_tr('Предупреждение', 'Warning')}{' — ' + c_threats if c_threats else ''}"
                                else:
                                    txt = f"{_tr('Сектор', 'Sector')} {c_idx+1} ({_tr('строки', 'lines')} {l_start}–{l_end}): {_tr('Чистый код', 'Clean code')}"
                                self._set_text_color(hint_view, dialog_text_color)
                                hint_view.setText(txt)
                            except Exception:
                                pass
                            finally:
                                del v
                    return CellClickListener()

                def _format_threat_label(rep):
                    if not rep:
                        return ""
                    rule_k = rep.get("rule")
                    if rule_k and rule_k in SecurityReportPresenter.RULES:
                        t_ru, t_en, _, _ = SecurityReportPresenter.RULES[rule_k]
                        return t_ru if _is_russian() else t_en
                    elif rule_k:
                        return rule_k.replace("_", " ").capitalize()
                    return str(rep.get("detail", ""))[:45]

                for r_idx in range(rows):
                    row_layout = LinearLayoutClass(context)
                    row_layout.setOrientation(LinearLayoutClass.HORIZONTAL)
                    for c_col_idx in range(cols):
                        idx = r_idx * cols + c_col_idx
                        l_start = min(total_lines, idx * step + 1)
                        l_end = min(total_lines, (idx + 1) * step)

                        sector_reports = [r for r in reports if int(r.get("line", 0)) > 0 and l_start <= int(r.get("line", 0)) <= l_end]
                        sector_text = "".join(file_lines[l_start-1:l_end]) if file_lines else ""
                        has_obf_code = False
                        if sector_text:
                            sec_no_ws = "".join(c for c in sector_text if ord(c) < 128 and not c.isspace())
                            if len(sec_no_ws) >= 40:
                                f_sec = {}
                                for ch in sec_no_ws:
                                    f_sec[ch] = f_sec.get(ch, 0) + 1
                                sec_ent = sum(-(c / len(sec_no_ws)) * math.log2(c / len(sec_no_ws)) for c in f_sec.values())
                                if sec_ent >= 5.50:
                                    has_obf_code = True

                        if any(r.get("level") == "CRITICAL" for r in sector_reports):
                            cell_level = "CRITICAL"
                            cell_col = 0xFFEF4444
                            crit_r = next(r for r in sector_reports if r.get("level") == "CRITICAL")
                            threat_desc = _format_threat_label(crit_r)
                        elif any(r.get("rule") in OBF_RULES for r in sector_reports) or has_obf_code:
                            cell_level = "OBFUSCATED"
                            cell_col = 0xFFA855F7 if is_dark else 0xFF9333EA
                            obf_r = next((r for r in sector_reports if r.get("rule") in OBF_RULES), None)
                            threat_desc = _format_threat_label(obf_r) if obf_r else _tr("Высокая энтропия", "High entropy")
                        elif any(r.get("level") in ("HIGH", "WARNING") for r in sector_reports):
                            cell_level = "WARNING"
                            cell_col = 0xFFF59E0B
                            warn_r = next(r for r in sector_reports if r.get("level") in ("HIGH", "WARNING"))
                            threat_desc = _format_threat_label(warn_r)
                        else:
                            cell_level = "SAFE"
                            cell_col = with_alpha(0xFF22C55E, 0x65 if is_dark else 0x50)
                            threat_desc = ""

                        cell_view = View(context)
                        cell_bg = GradientDrawable()
                        cell_bg.setCornerRadius(float(AndroidUtilitiesClass.dp(4)))
                        self._set_drawable_color(cell_bg, cell_col)
                        cell_view.setBackground(cell_bg)
                        cell_view.setClickable(True)
                        cell_view.setFocusable(True)
                        cell_view.setOnClickListener(create_cell_click_listener(idx, l_start, l_end, cell_level, threat_desc, cell_col, cell_view, cell_bg))

                        if hasattr(cell_view, "animate"):
                            try:
                                cell_view.setAlpha(0.0)
                                cell_view.setScaleX(0.7)
                                cell_view.setScaleY(0.7)
                                anim = cell_view.animate().alpha(1.0).scaleX(1.0).scaleY(1.0).setDuration(240).setStartDelay(int(100 + idx * 30))
                                CubicBezierInterpolator = find_class("org.telegram.ui.Components.CubicBezierInterpolator")
                                interpolator = getattr(CubicBezierInterpolator, "EASE_OUT_QUINT", None) if CubicBezierInterpolator else None
                                if interpolator:
                                    anim.setInterpolator(interpolator)
                                anim.start()
                            except Exception:
                                cell_view.setAlpha(1.0)
                                cell_view.setScaleX(1.0)
                                cell_view.setScaleY(1.0)

                        margin_right = AndroidUtilitiesClass.dp(3) if c_col_idx < cols - 1 else 0
                        margin_bottom = AndroidUtilitiesClass.dp(4) if r_idx < rows - 1 else 0
                        row_layout.addView(cell_view, LayoutHelper.createLinear(0, 22, 1.0, 0, 0, margin_right, margin_bottom))

                    grid_container.addView(row_layout, LayoutHelper.createLinear(-1, -2))

                card_layout.addView(grid_container, LayoutHelper.createLinear(-1, -2, 0, 0, 0, 0, 8))
                card_layout.addView(hint_view, LayoutHelper.createLinear(-1, -2))

                card_frame.addView(card_layout, LayoutHelper.createFrame(-1, -2))
                return card_frame

            is_self_scan = "pluginguard" in file_path.lower() or "plugin_guard" in file_path.lower() or "plugin guard" in plugin_name_str.lower()
            if is_self_scan:
                scroll_layout.addView(
                    create_note_card(
                        _tr("Самопроверка PluginGuard", "PluginGuard Self-Scan"),
                        _tr("PluginGuard содержит встроенные базы сигнатур зловредов, DEX-дизассемблер и правила эвристики. Срабатывание детектора на код самого антивируса является нормальным поведением.", "PluginGuard contains built-in malware signatures, DEX disassembler, and heuristic rules. Detection triggering on antivirus self-code is normal behavior."),
                        monet_accent,
                        icon_type="info"
                    ),
                    LayoutHelper.createLinear(-1, -2, 0, 0, 0, 0, 10)
                )

            critical_reports = [r for r in reports if r.get("level") == "CRITICAL"]
            if critical_reports:
                crit_items = SecurityReportPresenter.format_threats_list(critical_reports, max_items=0, include_rule=True)
                scroll_layout.addView(
                    create_issue_card(f"{_tr('Критические угрозы', 'Critical threats')} ({len(critical_reports)})", crit_items, 0xFFF44336, icon_type="critical", collapsible=True, initially_collapsed=False),
                    LayoutHelper.createLinear(-1, -2, 0, 0, 0, 0, 10)
                )

            has_native_so_or_ctypes = any(
                "SO" in str(r.get("rule", "")).upper() or
                "CTYPES" in str(r.get("rule", "")).upper() or
                "NATIVE" in str(r.get("rule", "")).upper() or
                ".so" in str(r.get("detail", "")).lower() or
                "ctypes" in str(r.get("detail", "")).lower()
                for r in reports
            )

            warning_reports = [r for r in reports if r.get("level") in ("HIGH", "WARNING")]
            if warning_reports:
                warn_items = SecurityReportPresenter.format_threats_list(warning_reports, max_items=0, include_rule=True)
                warn_badge = _tr("Важно", "Important") if has_native_so_or_ctypes else ""
                warn_collapsed = False if has_native_so_or_ctypes else True
                scroll_layout.addView(
                    create_issue_card(f"{_tr('Предупреждения', 'Warnings')} ({len(warning_reports)})", warn_items, 0xFFFF9800, icon_type="warning", collapsible=True, initially_collapsed=warn_collapsed, badge_text=warn_badge),
                    LayoutHelper.createLinear(-1, -2, 0, 0, 0, 0, 10)
                )

            if not critical_reports and not warning_reports:
                scroll_layout.addView(
                    create_issue_card(_tr("Безопасный код", "Safe code"), _tr("Опасных действий, кражи сессий и скрытых каналов не обнаружено.", "No dangerous actions, session theft or covert channels detected."), verdict_color, icon_type="check"),
                    LayoutHelper.createLinear(-1, -2, 0, 0, 0, 0, 10)
                )

            if ai_stats.get("dex_found"):
                dex_ok = ai_stats.get("dex_decompiled", False)
                dex_classes_n = ai_stats.get("dex_classes_count", 0)
                dex_methods_n = ai_stats.get("dex_methods_count", 0)
                dex_size_kb = round(ai_stats.get("dex_size", 0) / 1024.0, 1)
                if dex_ok:
                    dex_card_title = _tr("Встроенный код (DEX)", "Embedded Code (DEX)")
                    dex_card_desc = _tr(
                        f"Найден модуль DEX ({dex_size_kb} КБ). Код успешно проверен ({dex_classes_n} классов, {dex_methods_n} методов).",
                        f"Embedded DEX module found ({dex_size_kb} KB). Code successfully verified ({dex_classes_n} classes, {dex_methods_n} methods)."
                    )
                    dex_card_color = 0xFF4CAF50 if not any("DEX" in str(r.get("rule", "")) for r in reports if r.get("level") == "CRITICAL") else 0xFFFF9800
                    dex_card_icon = "check" if dex_card_color == 0xFF4CAF50 else "warning"
                else:
                    dex_card_title = _tr("Встроенный код (DEX)", "Embedded Code (DEX)")
                    dex_card_desc = _tr(
                        f"Найден скрытый модуль DEX ({dex_size_kb} КБ), но его не удалось прочитать (поврежден или зашифрован).",
                        f"Embedded DEX bytecode found ({dex_size_kb} KB), but could not be read (corrupted or encrypted)."
                    )
                    dex_card_color = 0xFFF44336
                    dex_card_icon = "critical"
                scroll_layout.addView(
                    create_note_card(dex_card_title, dex_card_desc, dex_card_color, icon_type=dex_card_icon),
                    LayoutHelper.createLinear(-1, -2, 0, 0, 0, 0, 10)
                )

            has_static_danger = any(r.get("level") == "CRITICAL" for r in reports)
            has_anomaly = ai_stats.get("avg_similarity", 1.0) < ai_stats.get("threshold", 0.4954)
            entropy_verdict = ai_stats.get("entropy_verdict", "NORMAL")
            obf_layers = ai_stats.get("obfuscation_layers", 0)
            has_obfuscation = has_anomaly or entropy_verdict == "HIGH" or obf_layers > 0

            if obf_layers > 0:
                obf_str = f"{_tr('обнаружена', 'detected')} ({_plural_layers(obf_layers)})"
            elif has_obfuscation:
                obf_str = _tr("аномальная структура", "anomalous structure")
            elif entropy_verdict == "ELEVATED":
                obf_str = _tr("повышенная сложность", "elevated complexity")
            else:
                obf_str = _tr("отсутствует", "none")

            if has_static_danger and obf_layers > 0:
                vector_verdict = f"{_tr('Вредоносный обфусцированный код', 'Malicious obfuscated code')} ({_plural_layers(obf_layers)})"
            elif has_static_danger and has_obfuscation:
                vector_verdict = _tr("Вредоносный обфусцированный код", "Malicious obfuscated code")
            elif has_static_danger:
                vector_verdict = _tr("Вредоносный код (не обфусцирован)", "Malicious code (unobfuscated)")
            elif obf_layers > 0:
                vector_verdict = f"{_tr('Обнаружена обфускация', 'Obfuscation detected')} ({_plural_code_layers(obf_layers)})"
            elif has_obfuscation:
                vector_verdict = _tr("Обфускация / аномальная структура", "Obfuscation / anomalous structure")
            elif entropy_verdict == "ELEVATED":
                vector_verdict = _tr("Код частично нечитаем", "Code partially unreadable")
            else:
                vector_verdict = _tr("Код не обфусцирован, опасных вызовов нет", "Unobfuscated code, no dangerous calls")

            entropy_val = ai_stats.get('entropy', 0.0)
            entropy_label = {
                'NORMAL': _tr('норма', 'normal'),
                'ELEVATED': _tr('повышенная', 'elevated'),
                'HIGH': _tr('обфускация', 'obfuscated')
            }.get(entropy_verdict, '—')

            tech_text = [
                f"{_tr('Вердикт', 'Verdict')}: {vector_verdict}",
                f"{_tr('Обфускация', 'Obfuscation')}: {obf_str}",
                f"{_tr('Энтропия', 'Entropy')}: {entropy_val:.4f} ({entropy_label})",
                f"{_tr('Схожесть Top-5', 'Top-5 similarity')}: {_tr('мин', 'min')} {ai_stats.get('min_similarity', 0.0):.4f} / {_tr('сред', 'avg')} {ai_stats.get('avg_similarity', 0.0):.4f} / {_tr('макс', 'max')} {ai_stats.get('max_similarity', 0.0):.4f}",
                f"{_tr('Порог детекции', 'Detection threshold')}: {ai_stats.get('threshold', 0.0):.4f} ({ai_stats.get('threshold_diff', '+0.0000')})",
                f"{_tr('Проверено чанков', 'Scanned chunks')}: {ai_stats.get('scanned_chunks', 0)} ({ai_stats.get('vectors_count', 0)} {_tr('в базе', 'in database')})"
            ]
            if ai_stats.get("dex_found"):
                dex_status_txt = _tr("успешно декомпилирован", "successfully decompiled") if ai_stats.get("dex_decompiled") else _tr("ошибка декомпиляции", "decompilation failed")
                tech_text.append(f"{_tr('DEX модуль', 'DEX module')}: {dex_status_txt} ({round(ai_stats.get('dex_size', 0)/1024.0, 1)} {_tr('КБ', 'KB')})")
            scroll_layout.addView(
                create_heatmap_card(),
                LayoutHelper.createLinear(-1, -2, 0, 0, 0, 0, 10)
            )

            scroll_layout.addView(
                create_note_card(_tr("Аудит", "Audit"), tech_text, monet_accent, icon_type="audit"),
                LayoutHelper.createLinear(-1, -2, 0, 0, 0, 0, 10)
            )

            if getattr(self, '_last_dump_folder_name', None) and self.get_setting("save_debug_dumps", False):
                dump_text = f"Download/PluginGuard_Dumps/{self._last_dump_folder_name}"
                scroll_layout.addView(
                    create_note_card(_tr("Дамп", "Dump"), dump_text, dialog_muted_color, icon_type="folder"),
                    LayoutHelper.createLinear(-1, -2, 0, 0, 0, 0, 10)
                )

            scroll_view.addView(scroll_layout, LayoutHelper.createFrame(-1, -2))
            root.addView(scroll_view, LayoutHelper.createLinear(-1, 0, 1.0, 0, 0, 0, 14))

            def create_primary_button(text: str, on_click):
                button_frame = FrameLayout(context)
                button_bg_color = monet_accent
                button_selector_color = self._adjust_luminance(monet_accent, -25 if is_dark else -35)
                button_frame.setBackground(
                    self._make_button_bg(
                        ThemeClass,
                        AndroidUtilitiesClass,
                        button_bg_color,
                        button_selector_color,
                        resources_provider,
                        corner_dp=24
                    )
                )
                button_frame.setClickable(True)
                button_frame.setFocusable(True)

                button_text = TextView(context)
                button_text.setText(text)
                button_text.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 15)
                button_text.setTypeface(AndroidUtilitiesClass.bold())
                button_text.setGravity(Gravity.CENTER)
                btn_txt_col = 0xFFFFFFFF if is_dark_color(button_bg_color) else 0xFF1C1B1F
                self._set_text_color(button_text, btn_txt_col)
                button_frame.addView(button_text, LayoutHelper.createFrame(-1, 48, Gravity.CENTER))

                class BtnClickListener(dynamic_proxy(View.OnClickListener)):
                    def onClick(self_inner, v):
                        try:
                            try:
                                HapticFeedbackConstants = find_class("android.view.HapticFeedbackConstants")
                                if HapticFeedbackConstants and hasattr(v, "performHapticFeedback"):
                                    v.performHapticFeedback(getattr(HapticFeedbackConstants, "KEYBOARD_TAP", 3))
                            except Exception:
                                pass
                            on_click()
                        except Exception:
                            pass
                        finally:
                            del v
                button_frame.setOnClickListener(BtnClickListener())
                return button_frame

            def dismiss_sheet():
                try:
                    if hasattr(sheet, "dismiss"):
                        sheet.dismiss()
                except Exception:
                    pass

            root.addView(create_divider(), LayoutHelper.createLinear(-1, 1, 0, 0, 0, 0, 14))
            close_btn = create_primary_button(_tr("Понятно", "Got it"), dismiss_sheet)
            root.addView(close_btn, LayoutHelper.createLinear(-1, 48, 0, 0, 0, 0, 4))

            try:
                sheet.setApplyTopPadding(False)
                sheet.setApplyBottomPadding(False)
            except Exception:
                pass
            try:
                sheet.setCanDismissWithSwipe(False)
            except Exception:
                pass
            try:
                sheet.setCanDismissWithTouchOutside(True)
            except Exception:
                pass

            sheet.setCustomView(root)
            sheet.show()

            if has_critical or score < 40:
                try:
                    HapticFeedbackConstants = find_class("android.view.HapticFeedbackConstants")
                    hfc_tap = getattr(HapticFeedbackConstants, "KEYBOARD_TAP", 3)
                    def _schedule_haptic(view, constant, delay):
                        def _fire():
                            run_on_ui_thread(lambda: view.performHapticFeedback(constant))
                        threading.Timer(delay, _fire).start()
                    _schedule_haptic(root, hfc_tap, 0.20)
                    _schedule_haptic(root, hfc_tap, 0.34)
                    _schedule_haptic(root, hfc_tap, 0.48)
                except Exception:
                    pass
            elif is_safe:
                try:
                    HapticFeedbackConstants = find_class("android.view.HapticFeedbackConstants")
                    hfc_confirm = getattr(HapticFeedbackConstants, "CONFIRM", 16) or getattr(HapticFeedbackConstants, "KEYBOARD_TAP", 3)
                    threading.Timer(0.20, lambda: run_on_ui_thread(lambda: root.performHapticFeedback(hfc_confirm))).start()
                except Exception:
                    pass
        except Exception as e:
            self.log(f"[PluginGuard UI ERROR] {e}\n{traceback.format_exc()}")

    def _make_button_bg(self, theme_cls, util_cls, color_bg, color_selector, resources_provider=None, corner_dp: int = 24):
        if theme_cls and hasattr(theme_cls, "createSimpleSelectorRoundRectDrawable") and util_cls:
            try:
                drawable = theme_cls.createSimpleSelectorRoundRectDrawable(
                    util_cls.dp(corner_dp),
                    as_java_color(color_bg),
                    as_java_color(color_selector)
                )
                if drawable:
                    return drawable
            except Exception:
                pass
            try:
                drawable = theme_cls.createSimpleSelectorRoundRectDrawable(
                    util_cls.dp(corner_dp),
                    as_java_color(color_bg),
                    as_java_color(color_selector),
                    as_java_color(color_selector)
                )
                if drawable:
                    return drawable
            except Exception:
                pass
        try:
            StateListDrawable = find_class("android.graphics.drawable.StateListDrawable")
            GradientDrawable = find_class("android.graphics.drawable.GradientDrawable")
            if StateListDrawable and GradientDrawable and util_cls:
                normal = GradientDrawable()
                normal.setCornerRadius(float(util_cls.dp(corner_dp)))
                normal.setColor(as_java_color(color_bg))
                pressed = GradientDrawable()
                pressed.setCornerRadius(float(util_cls.dp(corner_dp)))
                pressed.setColor(as_java_color(color_selector))
                sld = StateListDrawable()
                sld.addState([16842919], pressed)
                sld.addState([], normal)
                return sld
        except Exception:
            pass
        try:
            GradientDrawable = find_class("android.graphics.drawable.GradientDrawable")
            if GradientDrawable and util_cls:
                gd = GradientDrawable()
                gd.setCornerRadius(float(util_cls.dp(corner_dp)))
                gd.setColor(as_java_color(color_bg))
                return gd
        except Exception:
            pass
        return None

    def _get_theme_provider(self, sheet):
        provider = self._get_field_deep(sheet, "resourcesProvider")
        if provider:
            return provider
        activity = self._get_field_deep(sheet, "parentActivity")
        if activity:
            current_frag = self._get_field_deep(activity, "currentFragment")
            if current_frag:
                frag_provider = self._get_field_deep(current_frag, "resourcesProvider")
                if frag_provider:
                    return frag_provider
        return None

    def _find_install_button_pair(self, root_view, btn_cls):
        if not root_view or not hasattr(root_view, "getChildCount"):
            return None, None
        try:
            if btn_cls:
                res_b, res_p = self._find_view_pair(root_view, btn_cls)
                if res_b and res_p:
                    return res_b, res_p
            for i in range(root_view.getChildCount()):
                child = root_view.getChildAt(i)
                text_val = ""
                if hasattr(child, "getText"):
                    try:
                        text_val = str(child.getText() or "").lower()
                    except Exception:
                        pass
                if any(w in text_val for w in ["установ", "обнов", "install", "update", "reinstall"]):
                    return child, root_view
                res, parent = self._find_install_button_pair(child, btn_cls)
                if res and parent:
                    return res, parent
        except Exception:
            pass
        return None, None

    def _find_view_pair(self, root_view, target_cls):
        if not root_view or not hasattr(root_view, "getChildCount"):
            return None, None
        try:
            for i in range(root_view.getChildCount()):
                child = root_view.getChildAt(i)
                if isinstance(child, target_cls):
                    return child, root_view
                res, parent = self._find_view_pair(child, target_cls)
                if res and parent:
                    return res, parent
        except Exception:
            pass
        return None, None

    def _get_field_deep(self, obj, field_name):
        if obj is None:
            return None
        if hasattr(obj, field_name):
            try:
                return getattr(obj, field_name)
            except Exception:
                pass
        curr_cls = obj.getClass() if hasattr(obj, "getClass") else None
        while curr_cls is not None:
            try:
                f = curr_cls.getDeclaredField(field_name)
                f.setAccessible(True)
                return f.get(obj)
            except Exception:
                curr_cls = curr_cls.getSuperclass()
        return None

    def _extract_file_path_from_any(self, sheet, args):
        candidates = []
        if args:
            for arg in args:
                if arg is not None:
                    candidates.append(arg)
                    for fld in ['plugin', 'validationResult', 'params', 'installParams']:
                        val = self._get_field_deep(arg, fld)
                        if val is not None:
                            candidates.append(val)
        if sheet is not None:
            candidates.append(sheet)
            for fld in ['plugin', 'validationResult', 'params', 'installParams', 'validation']:
                val = self._get_field_deep(sheet, fld)
                if val is not None:
                    candidates.append(val)

        for c in candidates:
            if hasattr(c, 'getAbsolutePath'):
                try:
                    s = str(c.getAbsolutePath())
                    if s: return s
                except Exception:
                    pass
            if hasattr(c, 'getPath'):
                try:
                    s = str(c.getPath())
                    if s: return s
                except Exception:
                    pass
            for attr in ['filePath', 'path', 'file', 'sourcePath', 'localPath']:
                val = self._get_field_deep(c, attr)
                if val:
                    if hasattr(val, 'getAbsolutePath'):
                        try:
                            return str(val.getAbsolutePath())
                        except Exception:
                            pass
                    if hasattr(val, 'getPath'):
                        try:
                            return str(val.getPath())
                        except Exception:
                            pass
                    s = str(val)
                    if s.endswith('.plugin') or s.endswith('.py') or (os.path.exists(s) and os.path.isfile(s)):
                        return s
            s = str(c)
            if s.endswith('.plugin') or s.endswith('.py'):
                return s
        return None

    def _is_trusted_source(self, sheet, args):
        candidates = []
        if args:
            for arg in args:
                if arg is not None:
                    candidates.append(arg)
                    for fld in ['plugin', 'validationResult', 'params', 'installParams']:
                        try:
                            val = self._get_field_deep(arg, fld)
                            if val is not None:
                                candidates.append(val)
                        except Exception:
                            pass
        if sheet is not None:
            candidates.append(sheet)
            for fld in ['plugin', 'validationResult', 'params', 'installParams', 'validation']:
                try:
                    val = self._get_field_deep(sheet, fld)
                    if val is not None:
                        candidates.append(val)
                except Exception:
                    pass

        for c in candidates:
            if c is None:
                continue
            for attr in ['trusted', 'isTrusted', 'getTrusted', 'verified', 'isVerified', 'official', 'isOfficial']:
                try:
                    if hasattr(c, attr):
                        v = getattr(c, attr)
                        if callable(v):
                            v = v()
                        if isinstance(v, bool) and v:
                            return True
                except Exception:
                    pass
                try:
                    val = self._get_field_deep(c, attr)
                    if isinstance(val, bool) and val:
                        return True
                    elif callable(val):
                        if val():
                            return True
                except Exception:
                    pass
        return False

    def _is_kpm_present(self, sheet=None, install_btn=None) -> bool:
        if install_btn and hasattr(install_btn, "getParent"):
            p = install_btn.getParent()
            if p:
                tag = str(getattr(p, "getTag", lambda: "")() or "")
                if tag == "kpm_split_container":
                    return True
                if hasattr(p, "getOrientation") and p.getOrientation() == 0:
                    return True
        if sheet:
            for fld in ["bottomContainer", "customView", "sheetContainer", "containerView"]:
                root = self._get_field_deep(sheet, fld)
                if root and hasattr(root, "findViewWithTag"):
                    try:
                        if root.findViewWithTag("kpm_split_container") is not None:
                            return True
                    except Exception:
                        pass
        try:
            PluginsController = find_class("com.exteragram.messenger.plugins.PluginsController")
            if PluginsController:
                inst = PluginsController.getInstance()
                if inst and hasattr(inst, "plugins") and inst.plugins:
                    if inst.plugins.containsKey("kangel_plugins_manager"):
                        return True
        except Exception:
            pass
        return False

    def _hook_install_ui(self):
        target_classes = [
            "com.exteragram.messenger.plugins.ui.components.InstallPluginBottomSheet",
            "com.exteragram.messenger.plugins.ui.InstallPluginBottomSheet",
            "com.exteragram.messenger.plugins.ui.PluginInstallBottomSheet"
        ]

        class _InstallSheetHook(MethodHook):
            def __init__(self, plugin_instance):
                super().__init__()
                self.plugin = plugin_instance

            def before_hooked_method(self, param):
                try:
                    pass
                finally:
                    del param

            def after_hooked_method(self, param):
                try:
                    plugin = self.plugin
                    sheet = getattr(param, "thisObject", None)
                    if not sheet:
                        return

                    saved_args = []
                    if hasattr(param, "args") and param.args:
                        try:
                            saved_args = list(param.args)
                        except Exception:
                            saved_args = []

                    saved_path = plugin._extract_file_path_from_any(sheet, saved_args)

                    is_trusted = False
                    try:
                        is_trusted = plugin._is_trusted_source(sheet, saved_args)
                    except Exception:
                        pass

                    def modify_ui():
                        try:
                            btn_cls, lin_cls, theme_cls, util_cls, _, _ = plugin._get_ui_classes()

                            install_btn = None
                            parent_layout = None

                            direct_btn = plugin._get_field_deep(sheet, "button")
                            if direct_btn:
                                install_btn = direct_btn
                                p = install_btn.getParent() if hasattr(install_btn, "getParent") else None
                                if p:
                                    parent_layout = p

                            if not install_btn or not parent_layout:
                                for fld in ["bottomContainer", "customView", "sheetContainer", "containerView", "sheetView"]:
                                    root = plugin._get_field_deep(sheet, fld)
                                    if root:
                                        b, p = plugin._find_install_button_pair(root, btn_cls)
                                        if b and p:
                                            install_btn = b
                                            parent_layout = p
                                            break

                            if not install_btn or not parent_layout:
                                return

                            kpm_split = None
                            if plugin._is_kpm_present(sheet, install_btn):
                                if install_btn and hasattr(install_btn, "getParent"):
                                    curr_p = install_btn.getParent()
                                    if curr_p and (str(getattr(curr_p, "getTag", lambda: "")() or "") == "kpm_split_container" or (hasattr(curr_p, "getOrientation") and curr_p.getOrientation() == 0)):
                                        kpm_split = curr_p
                                        if curr_p.getParent():
                                            parent_layout = curr_p.getParent()
                                if not kpm_split and parent_layout and (str(getattr(parent_layout, "getTag", lambda: "")() or "") == "kpm_split_container" or (hasattr(parent_layout, "getOrientation") and parent_layout.getOrientation() == 0)):
                                    if parent_layout.getParent():
                                        kpm_split = parent_layout
                                        parent_layout = parent_layout.getParent()

                            if getattr(plugin, "_current_sheet", None) == sheet and getattr(plugin, "_current_analyze_btn", None):
                                return

                            orig_btn_text = ""
                            if hasattr(install_btn, "getText"):
                                try:
                                    orig_btn_text = str(install_btn.getText() or "").strip()
                                except Exception:
                                    pass

                            is_update = False
                            if orig_btn_text:
                                low_t = orig_btn_text.lower()
                                if any(w in low_t for w in ["обнов", "update", "переустанов", "reinstall"]):
                                    is_update = True

                            if not is_update:
                                for obj in [sheet] + saved_args:
                                    if not obj:
                                        continue
                                    for fld in ["isUpdate", "update", "isReinstall", "reinstall", "isUpgrade", "upgrade"]:
                                        try:
                                            v = plugin._get_field_deep(obj, fld)
                                            if isinstance(v, bool) and v:
                                                is_update = True
                                                break
                                            elif callable(v):
                                                if v():
                                                    is_update = True
                                                    break
                                        except Exception:
                                            pass
                                    if is_update:
                                        break

                            resolved_path = saved_path or plugin._extract_file_path_from_any(sheet, None)
                            if not is_update and resolved_path:
                                try:
                                    p_id = None
                                    p_name = None
                                    with open(resolved_path, "r", encoding="utf-8", errors="ignore") as f:
                                        for _line in f:
                                            _line_s = _line.strip()
                                            if _line_s.startswith("id:"):
                                                p_id = _line_s.split(":", 1)[1].strip().strip("\"'")
                                            elif _line_s.startswith("name:"):
                                                p_name = _line_s.split(":", 1)[1].strip().strip("\"'")
                                            elif _line_s.startswith("class ") and "Plugin" in _line_s:
                                                break
                                    PluginsController = find_class("com.exteragram.messenger.plugins.PluginsController")
                                    if PluginsController:
                                        inst = PluginsController.getInstance()
                                        if inst and hasattr(inst, "plugins"):
                                            plugs = inst.plugins
                                            if plugs:
                                                if p_id and hasattr(plugs, "containsKey") and plugs.containsKey(p_id):
                                                    is_update = True
                                                elif hasattr(plugs, "values"):
                                                    for p in plugs.values().toArray():
                                                        if p_id and hasattr(p, "getId") and str(p.getId() or "").strip() == str(p_id).strip():
                                                            is_update = True
                                                            break
                                                        if p_name and hasattr(p, "getName") and str(p.getName() or "").strip().lower() == str(p_name).strip().lower():
                                                            is_update = True
                                                            break
                                except Exception:
                                    pass

                            plugin._current_is_update = is_update

                            context = sheet.getContext()
                            resources_provider = plugin._get_theme_provider(sheet)

                            analyze_btn = btn_cls(context, True, resources_provider) if btn_cls else None
                            if not analyze_btn:
                                return

                            cached_score = None
                            cached_has_critical = False
                            if resolved_path:
                                try:
                                    f_hash = ""
                                    with open(resolved_path, "r", encoding="utf-8", errors="ignore") as f:
                                        f_code = f.read()
                                    f_hash = hashlib.sha256(f_code.encode("utf-8", errors="ignore")).hexdigest()
                                    if f_hash:
                                        cached_res = plugin._get_cached_scan_result(f_hash)
                                        if cached_res:
                                            c_reports, c_stats = cached_res
                                            cached_score, _ = plugin._calculate_security_score(c_reports, c_stats)
                                            cached_has_critical = any(r.get("level") == "CRITICAL" for r in c_reports) or cached_score < 40
                                except Exception:
                                    pass

                            if cached_score is not None:
                                plugin._safe_set_text(analyze_btn, f"{_tr('Оценка безопасности PG', 'PG security score')}: {cached_score}/100")
                            elif is_trusted:
                                plugin._safe_set_text(analyze_btn, _tr("Доверенный источник", "Trusted source"))
                            else:
                                plugin._safe_set_text(analyze_btn, _tr("Проверка PluginGuard", "Scan with PluginGuard"))

                            monet_accent = plugin._get_monet_or_theme_accent(context, theme_cls, resources_provider)
                            is_dark = plugin._is_dark_theme(theme_cls, resources_provider)
                            analyze_btn_bg = monet_accent
                            analyze_btn_selector = plugin._adjust_luminance(monet_accent, -25 if is_dark else -35)

                            analyze_btn.setBackground(
                                plugin._make_button_bg(
                                    theme_cls,
                                    util_cls,
                                    analyze_btn_bg,
                                    analyze_btn_selector,
                                    resources_provider,
                                    corner_dp=12
                                )
                            )
                            analyze_btn.setClickable(True)
                            analyze_btn.setFocusable(True)
                            try:
                                analyze_btn.setAlpha(1.0)
                            except Exception:
                                pass
                            plugin._set_text_color(analyze_btn, 0xFF003258 if (is_dark and monet_accent != 0) else 0xFFFFFFFF)

                            plugin._current_analyze_btn = analyze_btn
                            plugin._current_sheet = sheet
                            plugin._current_install_btn = install_btn
                            plugin._current_parent_layout = parent_layout
                            plugin._current_kpm_split = kpm_split
                            plugin._current_chk_box = None

                            class AnalyzeClickListener(dynamic_proxy(View.OnClickListener)):
                                def onClick(self_inner, v):
                                    try:
                                        try:
                                            HapticFeedbackConstants = find_class("android.view.HapticFeedbackConstants")
                                            if HapticFeedbackConstants and hasattr(v, "performHapticFeedback"):
                                                v.performHapticFeedback(getattr(HapticFeedbackConstants, "KEYBOARD_TAP", 3))
                                        except Exception:
                                            pass
                                        path_to_scan = saved_path or plugin._extract_file_path_from_any(sheet, None)
                                        if path_to_scan:
                                            plugin._scan_file_and_show_alert(path_to_scan)
                                        else:
                                            frag = get_last_fragment()
                                            if frag:
                                                BulletinHelper.show_error(_tr("Путь к файлу плагина не найден", "Plugin file path not found"), frag)
                                    except Exception as cl_err:
                                        plugin.log(f"[PluginGuard DEBUG] Analyze click error: {cl_err}")
                                    finally:
                                        del v

                            analyze_btn.setOnClickListener(AnalyzeClickListener())

                            m_info = plugin._get_field_deep(install_btn, "mListenerInfo")
                            orig_listener = plugin._get_field_deep(m_info, "mOnClickListener") if m_info else plugin._get_field_deep(install_btn, "mOnClickListener")
                            plugin._current_orig_listener = orig_listener

                            idx = -1
                            if kpm_split:
                                anchor_view = kpm_split
                                for i in range(parent_layout.getChildCount()):
                                    if parent_layout.getChildAt(i) == anchor_view:
                                        idx = i + 1
                                        break
                                lp = lin_cls.LayoutParams(-1, util_cls.dp(48)) if (lin_cls and util_cls) else None
                                if lp and util_cls:
                                    lp.leftMargin = util_cls.dp(16)
                                    lp.rightMargin = util_cls.dp(16)
                                    lp.topMargin = util_cls.dp(8)
                                    lp.bottomMargin = 0
                                if idx != -1 and idx <= parent_layout.getChildCount():
                                    if lp:
                                        parent_layout.addView(analyze_btn, idx, lp)
                                    else:
                                        parent_layout.addView(analyze_btn, idx)
                                else:
                                    if lp:
                                        parent_layout.addView(analyze_btn, lp)
                                    else:
                                        parent_layout.addView(analyze_btn)
                            else:
                                for i in range(parent_layout.getChildCount()):
                                    if parent_layout.getChildAt(i) == install_btn:
                                        idx = i + 1
                                        break

                                lp = None
                                if lin_cls and isinstance(parent_layout, lin_cls):
                                    lp = lin_cls.LayoutParams(install_btn.getLayoutParams())
                                elif hasattr(install_btn, "getLayoutParams") and install_btn.getLayoutParams() is not None:
                                    try:
                                        lp = parent_layout.generateLayoutParams(install_btn.getLayoutParams())
                                    except Exception:
                                        lp = install_btn.getLayoutParams()

                                if lp and util_cls and hasattr(lp, "topMargin"):
                                    lp.topMargin = util_cls.dp(8)
                                    lp.bottomMargin = 0
                                    try:
                                        install_lp = install_btn.getLayoutParams()
                                        if hasattr(install_lp, "bottomMargin"):
                                            install_lp.bottomMargin = 0
                                            install_btn.setLayoutParams(install_lp)
                                    except Exception:
                                        pass

                                if idx != -1 and idx <= parent_layout.getChildCount():
                                    if lp:
                                        parent_layout.addView(analyze_btn, idx, lp)
                                    else:
                                        parent_layout.addView(analyze_btn, idx)
                                else:
                                    if lp:
                                        parent_layout.addView(analyze_btn, lp)
                                    else:
                                        parent_layout.addView(analyze_btn)

                            class BlockedClickListener(dynamic_proxy(View.OnClickListener)):
                                def onClick(self_inner, v):
                                    try:
                                        frag = get_last_fragment()
                                        if frag:
                                            BulletinHelper.show_error(_tr("Обновление заблокировано PluginGuard (опасный плагин)", "Update blocked by PluginGuard (dangerous plugin)") if is_update else _tr("Установка заблокирована PluginGuard (опасный плагин)", "Installation blocked by PluginGuard (dangerous plugin)"), frag)
                                    except Exception:
                                        pass

                            if plugin.get_setting("auto_block", True):
                                if is_trusted:
                                    install_btn.setEnabled(True)
                                    install_btn.setClickable(True)
                                    try:
                                        install_btn.setAlpha(1.0)
                                    except Exception:
                                        pass
                                    if orig_listener:
                                        install_btn.setOnClickListener(orig_listener)
                                elif cached_score is not None:
                                    if cached_score >= 40 and not cached_has_critical:
                                        install_btn.setEnabled(True)
                                        install_btn.setClickable(True)
                                        try:
                                            install_btn.setAlpha(1.0)
                                        except Exception:
                                            pass
                                        plugin._safe_set_text(install_btn, _tr("Обновить", "Update") if is_update else _tr("Установить", "Install"))
                                        if orig_listener:
                                            install_btn.setOnClickListener(orig_listener)
                                    else:
                                        install_btn.setEnabled(False)
                                        install_btn.setClickable(False)
                                        try:
                                            install_btn.setAlpha(0.4)
                                        except Exception:
                                            pass
                                        plugin._safe_set_text(install_btn, _tr("Обновление заблокировано", "Update blocked") if is_update else _tr("Установка заблокирована", "Installation blocked"))
                                        install_btn.setOnClickListener(BlockedClickListener())

                                        if parent_layout and not getattr(plugin, "_current_chk_box", None):
                                            plugin._create_confirmation_card(context, install_btn, orig_listener, parent_layout, lin_cls, util_cls, theme_cls, resources_provider)
                                else:
                                    install_btn.setEnabled(False)
                                    install_btn.setClickable(False)
                                    try:
                                        install_btn.setAlpha(0.5)
                                    except Exception:
                                        pass
                                    plugin._safe_set_text(install_btn, _tr("Плагин еще не проверен", "Plugin not scanned yet"))

                                    class NotScannedClickListener(dynamic_proxy(View.OnClickListener)):
                                        def onClick(self_inner, v):
                                            try:
                                                frag = get_last_fragment()
                                                if frag:
                                                    BulletinHelper.show_error(_tr("Нажмите «Проверка PluginGuard» перед обновлением", "Click \"Scan with PluginGuard\" before update") if is_update else _tr("Нажмите «Проверка PluginGuard» перед установкой", "Click \"Scan with PluginGuard\" before installation"), frag)
                                            except Exception:
                                                pass

                                    install_btn.setOnClickListener(NotScannedClickListener())

                        except Exception as me:
                            plugin.log(f"[PluginGuard DEBUG] modify_ui error: {me}")

                    run_on_ui_thread(modify_ui)
                finally:
                    del param

        for class_name in target_classes:
            try:
                cls = find_class(class_name)
                if not cls:
                    continue
                constructors = cls.getClass().getDeclaredConstructors() if hasattr(cls, "getClass") else cls.getDeclaredConstructors()
                for ctor in constructors:
                    try:
                        ctor.setAccessible(True)
                        h = self.hook_method(ctor, _InstallSheetHook(self))
                        if h:
                            self._installed_hooks.append(h)
                    except Exception:
                        pass
            except Exception:
                pass
