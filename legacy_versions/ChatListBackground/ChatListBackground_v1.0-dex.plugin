_PRIMITIVE = {
    "boolean": "java.lang.Boolean",
    "byte": "java.lang.Byte",
    "char": "java.lang.Character",
    "short": "java.lang.Short",
    "int": "java.lang.Integer",
    "long": "java.lang.Long",
    "float": "java.lang.Float",
    "double": "java.lang.Double",
    "void": "java.lang.Void",
}
_class_cache = {}

def _alog(msg: str) -> None:
    try:
        android_log(f"[VCB] {msg}")
    except Exception:
        pass

def java_class(name: str):
    if name in _class_cache:
        return _class_cache[name]
    try:
        if name in _PRIMITIVE:
            cls = java_class(_PRIMITIVE[name]).getField("TYPE").get(None)
        else:
            loader = ApplicationLoader.applicationContext.getClassLoader()
            cls = JavaClass.forName(name, True, loader)
        _class_cache[name] = cls
        return cls
    except Exception as e:
        _alog(f"java_class({name}) fail: {e}")
        return None

def find_method(cls, name: str, *param_type_names: str):
    if cls is None:
        return None
    types = []
    for t in param_type_names:
        jc = java_class(t)
        if jc is None:
            return None
        types.append(jc)
    cur = cls
    while cur is not None:
        for getter in ("getDeclaredMethod", "getMethod"):
            fn = getattr(cur, getter, None)
            if not callable(fn):
                continue
            try:
                m = fn(name, *types)
                try:
                    m.setAccessible(True)
                except Exception:
                    pass
                return m
            except Exception:
                continue
        try:
            cur = cur.getSuperclass()
        except Exception:
            break
    return None

def _parse_int(value, default: int, lo: int, hi: int) -> int:
    try:
        return max(lo, min(hi, int(str(value).strip() or default)))
    except Exception:
        return default

_STATE_ATTR = "_vcb2_plugin_process_state"

def _process_state():
    st = getattr(sys, _STATE_ATTR, None)
    if st is None:
        st = {
            "lock": threading.RLock(),
            "build": None,
            "loader": None,
            "engine_cls": None,
            "engine": None,
            "dex_path": None,
        }
        setattr(sys, _STATE_ATTR, st)
    return st

def _no_arg_ctor(cls_obj):
    try:
        ctor = cls_obj.getDeclaredConstructor()
        if ctor is not None:
            return ctor
    except Exception:
        pass
    try:
        for c in cls_obj.getDeclaredConstructors():
            try:
                if len(c.getParameterTypes()) == 0:
                    return c
            except Exception:
                continue
    except Exception:
        pass
    return None

def _new_engine_instance(cls_obj):
    ctor = _no_arg_ctor(cls_obj)
    if ctor is not None:
        try:
            ctor.setAccessible(True)
        except Exception:
            pass
        try:
            return ctor.newInstance([])
        except TypeError:
            raise
        except Exception:
            pass
    return cls_obj.newInstance()

def _engine_api_ok(engine) -> bool:
    if engine is None:
        return False
    for name in ("buildId", "applySettings", "attachCurrent", "detachAsync", "onPluginLoad"):
        try:
            if not hasattr(engine, name):
                _alog(f"engine api missing: {name}")
                return False
        except Exception:
            return False
    try:
        got = str(engine.buildId())
    except Exception as e:
        _alog(f"engine buildId error: {e}")
        return False
    if got != BUILD_ID:
        _alog(f"engine build mismatch: {got} != {BUILD_ID}")
        return False
    return True

class ChatListVideoBgPlugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self._hooks = []
        self._hooked = set()
        self._ui = None
        self._engine = None
        self._engine_loaded = False
        self._dex_path = None
        self._tick = None
        self._dex_bytes = 0
        self._stale_cache = False
        self._video_name = ""
        self._enabled = True
        self._dim = 30
        self._muted = True
        self._mute_on_music = True
        self._fps = 0
        self._fill = True
        self._save_pause = True
        self._low_battery = 15

    def log(self, msg: str) -> None:
        _alog(msg)

    def _dex_dir(self) -> Optional[str]:
        try:
            base = ApplicationLoader.applicationContext.getFilesDir().getAbsolutePath()
            d = os.path.join(base, DEX_DIR)
            os.makedirs(d, exist_ok=True)
            return d
        except Exception as e:
            self.log(f"dex dir error: {e}")
            return None

    @staticmethod
    def _make_read_only(path: str) -> bool:
        try:
            from java.io import File
            f = File(path)
            if not f.exists():
                return False
            try:
                f.setReadOnly()
            except Exception:
                pass
            try:
                f.setWritable(False, False)
            except Exception:
                pass
            return not bool(f.canWrite())
        except Exception as e:
            _alog(f"chmod error: {e}")
            return False

    def _write_dex(self, data: bytes, dest: str) -> bool:
        tmp = dest + ".tmp"
        try:
            for old in (tmp,):
                try:
                    if os.path.isfile(old):
                        os.remove(old)
                except Exception:
                    pass
            with open(tmp, "wb") as f:
                f.write(data)
            self._make_read_only(tmp)
            try:
                if os.path.isfile(dest):
                    os.remove(dest)
            except Exception:
                pass
            os.rename(tmp, dest)
            return self._make_read_only(dest)
        except Exception as e:
            self.log(f"dex write error: {e}\n{traceback.format_exc()}")
            return False

    def _extract_dex(self) -> Optional[str]:
        try:
            data = base64.b64decode("".join(_DEX_B64))
        except Exception as e:
            self.log(f"dex decode error: {e}\n{traceback.format_exc()}")
            return None
        self._dex_bytes = len(data)
        d = self._dex_dir()
        if d is None:
            return None

        dest = os.path.join(d, f"engine-{hashlib.sha256(data).hexdigest()[:12]}.dex")
        try:
            if os.path.isfile(dest) and os.path.getsize(dest) == len(data):
                if self._make_read_only(dest):
                    self.log(f"dex already on disk: {dest}")
                    return dest

                self.log("cached dex is writable, rewriting")
                if self._write_dex(data, dest):
                    return dest
            elif self._write_dex(data, dest):
                self.log(f"dex extracted: {len(data)} bytes -> {dest}")
                return dest
        except Exception as e:
            self.log(f"dex extract error: {e}\n{traceback.format_exc()}")
        return None

    def _load_class_from_file(self, dex_path: str):
        from dalvik.system import DexClassLoader
        st = _process_state()
        loader = st.get("loader")
        if loader is None:
            opt_dir = os.path.join(os.path.dirname(dex_path), "dexopt")
            try:
                os.makedirs(opt_dir, exist_ok=True)
            except Exception:
                pass
            app_loader = ApplicationLoader.applicationContext.getClassLoader()
            loader = DexClassLoader(dex_path, opt_dir, None, app_loader)
            st["loader"] = loader
            self.log("DexClassLoader created")
        return loader.loadClass(ENGINE_CLS)

    def _load_class_in_memory(self):
        from java.nio import ByteBuffer
        try:
            from dalvik.system import InMemoryDexClassLoader
        except Exception as e:
            self.log(f"InMemoryDexClassLoader unavailable: {e}")
            return None
        data = base64.b64decode("".join(_DEX_B64))
        buf = ByteBuffer.wrap(data)
        app_loader = ApplicationLoader.applicationContext.getClassLoader()
        loader = InMemoryDexClassLoader(buf, app_loader)
        cls = loader.loadClass(ENGINE_CLS)
        st = _process_state()
        st["loader"] = loader
        self.log("engine loaded via InMemoryDexClassLoader")
        return cls

    def _instantiate_engine(self, engine_cls):
        try:
            return _new_engine_instance(engine_cls)
        except TypeError as e:
            if "proxy from" in str(e):
                self._stale_cache = True
                self.log(
                    "engine class conflict: vcb2.VcbEngine уже зарегистрирован в "
                    "Chaquopy другим DexClassLoader (кэш имён живёт до перезапуска "
                    "процесса)\n" + traceback.format_exc()
                )
            else:
                self.log(f"engine newInstance TypeError: {e}\n{traceback.format_exc()}")
            return None
        except Exception as e:
            self.log(f"engine newInstance failed: {e}\n{traceback.format_exc()}")
            return None

    def _recover_from_cache(self):
        try:
            from java import jclass as _jclass
        except Exception as e:
            self.log(f"recover: no java.jclass ({e})")
            return None
        try:
            cached_cls = _jclass(ENGINE_CLS)
        except Exception as e:
            self.log(f"recover: no registered wrapper ({e})")
            return None
        if cached_cls is None:
            return None
        engine = self._instantiate_engine(cached_cls)
        if engine is None:
            return None
        self.log("engine recovered from Chaquopy class cache")
        return engine, cached_cls

    def _load_engine(self) -> bool:
        if self._engine is not None:
            return True
        st = _process_state()
        with st["lock"]:
            cached_engine = st.get("engine")
            if cached_engine is not None:
                if _engine_api_ok(cached_engine):
                    self._engine = cached_engine
                    self._engine_loaded = True
                    self._dex_path = st.get("dex_path")
                    self.log("engine reused from process cache")
                    return True
                self.log("stale engine in process cache, recreating")
                st["engine"] = None
                st["engine_cls"] = None
                st["loader"] = None
                st["dex_path"] = None

            engine_cls = st.get("engine_cls")
            if engine_cls is None:
                dex_path = self._extract_dex()
                if dex_path is not None:
                    self._dex_path = dex_path
                    st["dex_path"] = dex_path
                    try:
                        engine_cls = self._load_class_from_file(dex_path)
                        if engine_cls is not None:
                            st["engine_cls"] = engine_cls
                    except Exception as e:
                        self.log(f"dex load error: {e}\n{traceback.format_exc()}")
                        engine_cls = None

                        try:
                            engine_cls = self._load_class_in_memory()
                            if engine_cls is not None:
                                st["engine_cls"] = engine_cls
                        except Exception as e2:
                            self.log(f"in-memory dex load error: {e2}\n{traceback.format_exc()}")
                            engine_cls = None

            if engine_cls is not None:
                engine = self._instantiate_engine(engine_cls)
                if engine is not None and not _engine_api_ok(engine):
                    self.log("engine api mismatch after load, discarding")
                    engine = None
                    st["engine_cls"] = None
                if engine is not None:
                    st["engine"] = engine
                    st["build"] = BUILD_ID
                    self._engine = engine
                    self._engine_loaded = True
                    self.log("engine loaded from dex")
                    return True

            recovered = self._recover_from_cache()
            if recovered is not None:
                engine, cls_obj = recovered
                st["engine"] = engine
                st["engine_cls"] = cls_obj
                st["build"] = BUILD_ID
                try:
                    st["loader"] = cls_obj.getClassLoader()
                except Exception:
                    pass
                self._engine = engine
                self._engine_loaded = True
                return True

            self._engine = None
            self._engine_loaded = False
            return False

    def _push_settings(self) -> None:
        if self._engine is None:
            return
        try:
            path = self.get_setting("video_path", None)
            if not (path and os.path.isfile(str(path))):
                try:
                    p = self._engine.videoFilePath()
                    path = p if (p and os.path.isfile(str(p))) else None
                except Exception:
                    path = None
            self._engine.applySettings(
                bool(self._enabled),
                int(self._dim),
                bool(self._fill),
                bool(self._save_pause),
                int(self._low_battery),
                bool(self._muted),
                bool(self._mute_on_music),
                int(self._fps),
                str(path) if path else None,
                str(self._video_name or ""),
            )
        except Exception as e:
            self.log(f"push settings error: {e}\n{traceback.format_exc()}")

    def on_plugin_load(self) -> None:
        try:
            from android.os import Handler, Looper
            self._ui = Handler(Looper.getMainLooper())
            self._load_state()
            if not self._load_engine():
                self.log("FATAL: dex engine failed to load")
                if self._stale_cache:
                    self.log(
                        "нужен полный перезапуск Telegram: имя vcb2.VcbEngine уже занято "
                        "прежней загрузкой плагина в этом процессе"
                    )
                return
            try:
                self._engine.onPluginLoad()
            except AttributeError as e:
                self.log(f"engine without onPluginLoad: {e}")
            self._push_settings()
            self._install_hooks()
            self._start_fragment_push()
            self._bootstrap_attach(0)
            self.log(f"loaded {__version__} hooks={len(self._hooks)}")
        except Exception as e:
            self.log(f"load crash: {e}\n{traceback.format_exc()}")

    def on_plugin_unload(self) -> None:
        try:
            if self._ui is not None and self._tick is not None:
                self._ui.removeCallbacks(self._tick)
        except Exception:
            pass
        self._tick = None
        try:
            if self._engine is not None:
                self._engine.detachAsync()
        except Exception:
            pass
        for h in list(self._hooks):
            try:
                unhook = getattr(h, "unhook", None)
                if callable(unhook):
                    unhook()
            except Exception:
                pass
        self._hooks.clear()
        self._hooked.clear()

    def _files_dir(self) -> Optional[str]:
        try:
            return ApplicationLoader.applicationContext.getFilesDir().getAbsolutePath()
        except Exception as e:
            self.log(f"files_dir error: {e}")
            return None

    def _load_state(self) -> None:
        self._enabled = bool(self.get_setting("enabled", True))
        self._dim = _parse_int(self.get_setting("dim", "30"), 30, 0, 90)
        self._fill = bool(self.get_setting("fill", True))
        self._save_pause = bool(self.get_setting("save_pause", True))
        self._low_battery = _parse_int(self.get_setting("low_battery", "15"), 15, 0, 100)
        self._muted = bool(self.get_setting("muted", True))
        self._mute_on_music = bool(self.get_setting("mute_on_music", True))
        self._fps = _parse_int(self.get_setting("target_fps", "0"), 0, 0, 120)
        self._video_name = str(self.get_setting("video_name", "") or "")

    def _hook(self, cls, name: str, hook, *types: str) -> bool:
        if cls is None:
            return False
        try:
            m = find_method(cls, name, *types)
            if m is not None:
                ref = self.hook_method(m, hook)
                self._hooks.append(ref if ref is not None else hook)
                return True
            refs = []
            for dm in cls.getDeclaredMethods():
                if str(dm.getName()) != name:
                    continue
                dm.setAccessible(True)
                r = self.hook_method(dm, hook)
                refs.append(r if r is not None else hook)
            if not refs:
                return False
            self._hooks.extend(refs)
            return True
        except Exception as e:
            self.log(f"hook {name} failed: {e}")
            return False

    def _hook_draw(self, cls, method: str, guard) -> None:
        if cls is None:
            return
        try:
            key = f"{cls.getName()}.{method}"
        except Exception:
            return
        if key in self._hooked:
            return
        self._hooked.add(key)
        try:
            m = cls.getDeclaredMethod(method, java_class("android.graphics.Canvas"))
            m.setAccessible(True)
        except Exception:
            self.log(f"{method} not declared on {key}")
            return

        class SkipDraw(MethodHook):
            def before_hooked_method(self, param):
                try:
                    if guard(param.thisObject):
                        param.setResult(None)
                except Exception:
                    pass

        hook = SkipDraw()
        try:
            ref = self.hook_method(m, hook)
            self._hooks.append(ref if ref is not None else hook)
        except Exception as e:
            self.log(f"hook {key} failed: {e}")

    def _hook_fade_drawables(self) -> None:
        if self._engine is None:
            return
        try:
            names = self._engine.takeFadeDrawableClasses()
        except Exception:
            return
        if not names:
            return
        engine = self._engine
        for name in list(names):
            cls = java_class(str(name))
            if cls is None:
                continue
            try:
                key = f"{cls.getName()}.draw"
            except Exception:
                continue
            if key in self._hooked:
                continue
            self._hooked.add(key)
            try:
                m = cls.getDeclaredMethod("draw", java_class("android.graphics.Canvas"))
                m.setAccessible(True)
            except Exception:
                self.log(f"draw not declared on {key}")
                continue

            class SkipFade(MethodHook):
                def before_hooked_method(self, param):
                    try:
                        if engine.isFadeDrawableOf(param.thisObject):
                            param.setResult(None)
                    except Exception:
                        pass

            try:
                ref = self.hook_method(m, SkipFade())
                self._hooks.append(ref if ref is not None else SkipFade())
            except Exception as e:
                self.log(f"hook {key} failed: {e}")

    def _install_hooks(self) -> None:
        plugin = self
        engine = self._engine
        if engine is None:
            self.log("install hooks: engine is None, skip")
            return
        dialogs = java_class("org.telegram.ui.DialogsActivity")

        class ResumeHook(MethodHook):
            def after_hooked_method(self, param):
                try:
                    engine.onDialogsResume(param.thisObject)
                except Exception as e:
                    plugin.log(f"onResume error: {e}\n{traceback.format_exc()}")

        class PauseHook(MethodHook):
            def before_hooked_method(self, param):
                try:
                    engine.onPause()
                except Exception as e:
                    plugin.log(f"onPause error: {e}")

        class ActivityResultHook(MethodHook):
            def before_hooked_method(self, param):
                try:
                    if param.args is None or len(param.args) < 3:
                        return
                    if int(param.args[0]) != REQ_PICK:
                        return
                    plugin._handle_activity_result(int(param.args[1]), param.args[2])
                except Exception as e:
                    plugin.log(f"onActivityResult error: {e}\n{traceback.format_exc()}")

        self._hook(dialogs, "onResume", ResumeHook())
        self._hook(dialogs, "onPause", PauseHook())
        self._hook(
            java_class("org.telegram.ui.LaunchActivity"),
            "onActivityResult",
            ActivityResultHook(),
            "int",
            "int",
            "android.content.Intent",
        )

        self._hook_draw(
            java_class("org.telegram.ui.Components.DialogsActivityTopBubblesFadeView"),
            "onDraw",
            lambda view: engine.inDialogsHost(view),
        )
        self._hook_header_shadow()

    def _hook_header_shadow(self) -> None:
        key = "ActionBarLayout.drawHeaderShadow"
        if key in self._hooked:
            return
        self._hooked.add(key)
        plugin = self
        engine = self._engine

        class SkipShadow(MethodHook):
            def before_hooked_method(self, param):
                try:
                    if engine.isDialogsVisible():
                        param.setResult(None)
                except Exception:
                    pass

        self._hook(java_class("org.telegram.ui.ActionBar.ActionBarLayout"), "drawHeaderShadow", SkipShadow())

    def _bootstrap_attach(self, attempt: int) -> None:
        delays = (0.0, 0.4, 0.9, 1.6, 2.6, 4.0, 6.0, 9.0)
        if attempt >= len(delays):
            return

        def step():
            try:
                if self._engine is None:
                    return
                self._push_settings()
                self._hook_fade_drawables()
                if not self._enabled:
                    return
                ok = self._engine.attachCurrent()
                self.log(f"bootstrap attempt={attempt} ok={ok}")
                if not ok:
                    self._bootstrap_attach(attempt + 1)
            except Exception as e:
                self.log(f"bootstrap error: {e}\n{traceback.format_exc()}")
                self._bootstrap_attach(attempt + 1)

        def fire():
            run_on_ui_thread(step)

        if delays[attempt] <= 0:
            fire()
        else:
            t = threading.Timer(delays[attempt], fire)
            t.daemon = True
            t.start()

    def _start_fragment_push(self) -> None:
        engine = self._engine
        if engine is None or self._ui is None:
            return
        try:
            from java import dynamic_proxy
            from java.lang import Runnable
            plugin = self

            class Tick(dynamic_proxy(Runnable)):
                def run(self):
                    try:
                        frag = get_last_fragment()
                        engine.setTopFragmentName(
                            str(frag.getClass().getName()) if frag is not None else None
                        )
                    except Exception:
                        engine.setTopFragmentName(None)

                    try:
                        plugin._hook_fade_drawables()
                    except Exception:
                        pass
                    try:
                        drained = engine.drainLogs()
                        if drained:
                            for line in str(drained).strip().split("\n"):
                                if line:
                                    _alog("[J] " + line)
                    except Exception:
                        pass
                    if plugin._ui is not None and plugin._tick is not None:
                        plugin._ui.postDelayed(plugin._tick, 1000)

            self._tick = Tick()
            self._ui.postDelayed(self._tick, 1000)
            self.log("fragment push started")
        except Exception as e:
            self.log(f"fragment push fail: {e}\n{traceback.format_exc()}")

    def _pick_video(self, view=None) -> None:
        def run():
            try:
                from android.content import Intent
                act = None
                if self._engine is not None:
                    try:
                        act = self._engine.getActivity()
                    except Exception:
                        act = None
                if act is None:
                    frag = get_last_fragment()
                    if frag is not None:
                        try:
                            act = frag.getParentActivity()
                        except Exception:
                            act = None
                if act is None:
                    self._toast("Нет Activity для выбора файла", True)
                    return
                error = None
                for action in (
                    "android.intent.action.OPEN_DOCUMENT",
                    "android.intent.action.GET_CONTENT",
                ):
                    try:
                        intent = Intent(action)
                        intent.addCategory("android.intent.category.OPENABLE")
                        intent.setType("video/*")
                        act.startActivityForResult(
                            Intent.createChooser(intent, "Видео для фона"), REQ_PICK
                        )
                        return
                    except Exception as e:
                        error = e
                raise error
            except Exception as e:
                self.log(f"picker fail: {e}\n{traceback.format_exc()}")
                self._toast(f"Не открыть выбор: {e}", True)

        run_on_ui_thread(run)

    def _handle_activity_result(self, result_code: int, data) -> None:
        if result_code != -1:
            return
        uri = None
        try:
            uri = data.getData() if data is not None else None
        except Exception:
            pass
        if uri is None:
            self._toast("Видео не выбрано", True)
            return

        engine = self._engine
        if engine is None:
            self._toast("Движок не загружен", True)
            return

        def copy_job():
            try:
                frag = get_last_fragment()
                if not engine.installFromUri(uri):
                    run_on_ui_thread(
                        lambda: self._toast("Ошибка копирования видео", True)
                    )
                    return
                name = "background.mp4"
                try:
                    seg = str(uri.getLastPathSegment() or "")
                    if seg:
                        name = seg.rsplit("/", 1)[-1] or name
                except Exception:
                    pass
                self.set_setting("video_path", engine.videoFilePath())
                self.set_setting("video_name", name)
                self._load_state()
                self._push_settings()
                engine.reattachAfterInstall(frag)
                self._hook_fade_drawables()
                run_on_ui_thread(
                    lambda: self._toast(f"Видео установлено: {name}", False)
                )
            except Exception as e:
                self.log(f"install error: {e}\n{traceback.format_exc()}")
                err = str(e)
                run_on_ui_thread(lambda: self._toast(f"Ошибка: {err}", True))

        worker = threading.Thread(target=copy_job, name="vcb-install", daemon=True)
        worker.start()

    def _clear_video(self, view=None) -> None:
        engine = self._engine
        if engine is None:
            self._toast("Движок не загружен", True)
            return

        def run():
            engine.clearVideo()
            self.set_setting("video_path", "")
            self.set_setting("video_name", "")
            self._load_state()
            self._push_settings()
            self._toast("Видео-фон удалён", False)

        run_on_ui_thread(run)

    def _change(self, key: str, value: Any) -> None:
        try:
            self.set_setting(key, value)
        except Exception as e:
            self.log(f"set_setting {key}: {e}")
        self._load_state()
        engine = self._engine
        if engine is None:
            return
        self._push_settings()
        if key == "enabled" and not self._enabled:
            engine.detachAsync()
            return
        if key == "target_fps":
            engine.restartPlayerAsync()
            return
        if key == "fill":
            engine.applyTransformAsync()
            return
        if key in ("save_pause", "low_battery"):
            engine.resetPowerCache()
            engine.updatePlaybackAsync()
            return
        engine.applyDimVolumeAndWatch()

    def _toast(self, text: str, error: bool = False) -> None:
        try:
            from ui.bulletin import BulletinHelper
            frag = get_last_fragment()
            if error:
                BulletinHelper.show_error(text, frag)
            else:
                BulletinHelper.show_success(text, frag)
        except Exception as e:
            self.log(f"bulletin: {e}")

    def _video_info(self) -> str:
        self._load_state()
        path = self.get_setting("video_path", None)
        if not (path and os.path.isfile(str(path))):
            return "Видео не выбрано"
        return f"Установлено: {self._video_name or os.path.basename(str(path))}"

    def _icon(self, *names: str) -> str:
        try:
            ctx = ApplicationLoader.applicationContext
            res = ctx.getResources()
            pkg = ctx.getPackageName()
            for n in names[:-1]:
                if int(res.getIdentifier(n, "drawable", pkg)) != 0:
                    return n
        except Exception:
            pass
        return names[-1]

    def create_settings(self) -> List[Any]:
        from ui.settings import Divider, Header, Input, Switch, Text

        return [
            Header(text="Видео"),
            Text(
                text="Текущий видео-фон",
                subtext=self._video_info(),
                icon="msg_video",
            ),
            Text(
                text="Выбрать видео",
                subtext="Открывает галерею.",
                icon="msg_gallery",
                on_click=self._pick_video,
            ),
            Text(
                text="Удалить видео",
                subtext="Освобождает память и убирает фон.",
                icon="msg_delete",
                accent=True,
                on_click=self._clear_video,
            ),
            Divider(),
            Header(text="Воспроизведение"),
            Switch(
                key="enabled",
                text="Включить видео-фон",
                default=True,
                icon="msg_switch",
                on_change=lambda v: self._change("enabled", bool(v)),
            ),
            Input(
                key="target_fps",
                text="Ориентировочный ФПС",
                default="0",
                icon="msg_speed",
                subtext="0 — авто, со звуком. От 1 до 120 — лимит кадров, звука нет. Чем ниже ФПС, тем меньше нагрузка и расход батареи.",
                on_change=lambda v: self._change("target_fps", _parse_int(v, 0, 0, 120)),
            ),
            Switch(
                key="muted",
                text="Без звука",
                default=True,
                icon="msg_mute",
                on_change=lambda v: self._change("muted", bool(v)),
            ),
            Switch(
                key="mute_on_music",
                text="Глушить звук при музыке",
                default=True,
                subtext="Звук ролика отключается, пока играет музыка.",
                icon=self._icon("msg_unmute", "msg_mute"),
                on_change=lambda v: self._change("mute_on_music", bool(v)),
            ),
            Divider(),
            Header(text="Оформление"),
            Input(
                key="dim",
                text="Затемнение (%)",
                default="30",
                icon="msg_theme",
                on_change=lambda v: self._change("dim", _parse_int(v, 30, 0, 90)),
            ),
            Switch(
                key="fill",
                text="Заполнять экран",
                default=True,
                icon=self._icon("msg_photo_settings", "msg_photos", "msg_expand", "msg_gallery"),
                on_change=lambda v: self._change("fill", bool(v)),
            ),
            Divider(),
            Header(text="Экономия энергии"),
            Switch(
                key="save_pause",
                text="Пауза в режиме энергосбережения",
                default=True,
                icon="msg2_battery",
                on_change=lambda v: self._change("save_pause", bool(v)),
            ),
            Input(
                key="low_battery",
                text="Пауза при заряде ниже (%)",
                default="15",
                icon="settings_power",
                subtext="Действует, пока телефон не заряжается. 0 — отключено.",
                on_change=lambda v: self._change("low_battery", _parse_int(v, 15, 0, 100)),
            ),
        ]
