_TAG = "ProfileV2Plugin"
_ENGINE_CLASS = "com.profilev2.Bridge"
_DEX_SHA1 = "dc775a6d5dd819ab5f8dc35934c0e8a6896e054b"
_ICON_TGS_SHA1 = "8980c1d80df99ea107c0378e79d19876601893b7"

_DESC_EN = (
    "Telegram iOS-style profile redesign: unified backdrop matching profile colors or avatars, "
    "native blur and glass highlights, circular action buttons, interactive 3D gift bubbles, "
    "and music-reactive motion. GPU blur requires Android 12+ and refraction requires Android 13+ "
    "(older Android versions automatically use a lightweight fallback)."
)


def _log(msg, err=None):
    try:
        text = msg if err is None else "%s: %s" % (msg, err)
        jclass("android.util.Log").w(_TAG, text)
    except Exception:
        pass


def _int(val, default=0):
    try:
        return default if val is None else int(val)
    except (TypeError, ValueError):
        return default


def _read_config(plugin, overrides=None):
    def get(key, default):
        if overrides is not None and key in overrides:
            return overrides[key]
        return plugin.get_setting(key, default)

    glass_on = bool(get("liquid_glass", True))
    gifts_on = bool(get("floating_gift_bubbles", True))
    music_on = bool(get("dancing_music_sync", True))
    classic = 1 if _int(get("ui_style", 0), 0) == 1 else 0
    return {
        "enabled": 1 if bool(get("enabled", True)) else 0,
        "avatar_color": 1 if bool(get("adaptive_avatar_color", True)) else 0,
        "circle_btns": 1 if bool(get("circular_action_buttons", True)) else 0,
        "liquid_glass": 1 if glass_on else 0,
        "gift_bubbles": 1 if gifts_on else 0,
        "bubble_drag": 1 if (gifts_on and bool(get("interactive_bubbles", True))) else 0,
        "music_dance": 1 if music_on else 0,
        "sys_music": 1 if (music_on and bool(get("system_music_fallback", True))) else 0,
        "glass_cards": 1 if bool(get("glass_cards", True)) else 0,
        "nav_pills": 1 if (glass_on and bool(get("glass_nav_pills", True))) else 0,
        "media_tabs": classic,
        "exp_fade": 1 if bool(get("seamless_expanded_fade", True)) else 0,
        "exp_center": 1 if bool(get("center_expanded_title", True)) else 0,
        "lower_labels": 1 if bool(get("lowercase_labels", True)) else 0,
        "press_swell": 1 if bool(get("liquid_press_swell", True)) else 0,
        "gpu_glass": 1 if (glass_on and bool(get("gpu_liquid_glass", True))) else 0,
        "gift_patterns": 1 if (gifts_on and bool(get("gift_real_patterns", True))) else 0,
        "classic_style": classic,
        "palette": _int(get("palette_style", 0), 0),
        "glass_str": _int(get("glass_intensity", 0), 0),
        "rim_style": _int(get("rim_style", 0), 0),
        "beat_jump": _int(get("beat_jump_strength", 2), 2),
        "beat_sens": _int(get("beat_sensitivity", 1), 1),
        "beat_off": _int(get("beat_sync_offset", 0), 0),
        "av_pulse": _int(get("avatar_pulse_strength", 2), 2),
        "bub_size": _int(get("bubble_size", 1), 1),
        "orb_rad": _int(get("bubble_orbit_radius", 1), 1),
        "orb_spd": _int(get("bubble_orbit_speed", 1), 1),
        "bub_stretch": _int(get("bubble_stretch_strength", 2), 2),
        "bub_bounce": _int(get("bubble_bounce_strength", 1), 1),
        "av_rim": _int(get("avatar_rim_mode", 0), 0),
        "av_rim_col": _int(get("avatar_rim_color", 0), 0),
        "beta_hdr": 1 if bool(get("beta_glass_header", False)) else 0,
        "hdr_align": _int(get("header_align_mode", 0), 0),
    }


class _DexEngine:
    def __init__(self):
        self.bridge = None
        self.loader = None
        self.running = False
        self._last_cfg = None

    @staticmethod
    def _decode_dex():
        data = zlib.decompress(base64.b64decode(_DEX_DATA))
        if hashlib.sha1(data).hexdigest() != _DEX_SHA1:
            _log("embedded dex sha1 mismatch")
            return None
        return data

    @staticmethod
    def _decode_icon_tgs():
        data = base64.b64decode(_ICON_TGS_DATA)
        if hashlib.sha1(data).hexdigest() != _ICON_TGS_SHA1:
            _log("embedded icon sha1 mismatch")
            return None
        return data

    @staticmethod
    def _extract_dex_file(context, data):
        folder = os.path.join(str(context.getFilesDir().getAbsolutePath()), "profile_v2")
        path = os.path.join(folder, "%s-%s.dex" % (__id__, _DEX_SHA1[:10]))
        if not os.path.exists(path):
            os.makedirs(folder, exist_ok=True)
            for name in os.listdir(folder):
                if name.startswith(__id__ + "-") and name.endswith(".dex"):
                    try:
                        os.remove(os.path.join(folder, name))
                    except OSError:
                        pass
            tmp = path + ".tmp"
            with open(tmp, "wb") as f:
                f.write(data)
            os.replace(tmp, path)
        try:
            os.chmod(path, 0o444)
        except OSError:
            pass
        return path

    @staticmethod
    def _extract_icon_file(context):
        try:
            data = _DexEngine._decode_icon_tgs()
            if not data:
                return ""
            folder = os.path.join(str(context.getFilesDir().getAbsolutePath()), "profile_v2")
            path = os.path.join(folder, "icon-%s.tgs" % _ICON_TGS_SHA1[:10])
            if not os.path.exists(path) or os.path.getsize(path) != len(data):
                os.makedirs(folder, exist_ok=True)
                tmp = path + ".tmp"
                with open(tmp, "wb") as f:
                    f.write(data)
                os.replace(tmp, path)
            return path
        except Exception as e:
            _log("icon extract failed", e)
            return ""

    def _load(self):
        app_loader = find_class("org.telegram.messenger.ApplicationLoader")
        context = app_loader.applicationContext if app_loader else None
        if context is None:
            _log("ApplicationLoader.applicationContext is null")
            return False

        data = self._decode_dex()
        if not data:
            return False

        dex_path = ""
        loaded_class = None

        try:
            ByteBuffer = jclass("java.nio.ByteBuffer")
            InMemoryDexClassLoader = jclass("dalvik.system.InMemoryDexClassLoader")
            self.loader = InMemoryDexClassLoader(ByteBuffer.wrap(data), context.getClassLoader())
            loaded_class = self.loader.loadClass(_ENGINE_CLASS)
        except Exception as mem_err:
            _log("InMemoryDexClassLoader fallback", mem_err)
            try:
                dex_path = self._extract_dex_file(context, data)
                DexClassLoader = jclass("dalvik.system.DexClassLoader")
                opt_dir = context.getDir("dex_opt", 0).getAbsolutePath()
                self.loader = DexClassLoader(dex_path, opt_dir, None, context.getClassLoader())
                loaded_class = self.loader.loadClass(_ENGINE_CLASS)
            except Exception as file_err:
                _log("DexClassLoader failed", file_err)
                return False

        if loaded_class is None:
            return False

        loaded_class.getMethod(
            "init",
            jclass("android.content.Context"),
            jclass("java.lang.String"),
        ).invoke(None, context, dex_path)

        self.bridge = loaded_class
        eng_ver = self.cmd("version")
        if eng_ver != __version__:
            _log("version mismatch: engine=%s plugin=%s" % (eng_ver, __version__))
            self.unload()
            return False

        icon_path = self._extract_icon_file(context)
        if icon_path:
            self.cmd("icon:" + icon_path)

        return True

    def cmd(self, text):
        if self.bridge is None:
            return ""
        try:
            res = self.bridge.getMethod("cmd", jclass("java.lang.String")).invoke(None, text)
            return "" if res is None else str(res)
        except Exception as e:
            _log("cmd error", e)
            return ""

    def push_settings(self, plugin, overrides=None):
        if self.bridge is None:
            return
        cfg = _read_config(plugin, overrides)
        line = "cfg:" + ";".join("%s=%d" % (k, int(v)) for k, v in sorted(cfg.items()))
        if line != self._last_cfg:
            self._last_cfg = line
            self.cmd(line)

    def start(self, plugin):
        try:
            if not self._load():
                return False
            self.push_settings(plugin)
            hook_count = _int(self.cmd("engine:start"), 0)
            self.running = hook_count > 0
            if not self.running:
                _log("no hooks installed; stock profile remains")
            return self.running
        except Exception as e:
            _log("start failed", e)
            return False

    def unload(self):
        self.running = False
        bridge, self.bridge = self.bridge, None
        self.loader = None
        self._last_cfg = None
        if bridge is not None:
            try:
                bridge.getMethod("unload").invoke(None)
            except Exception as e:
                _log("unload failed", e)


_engine = _DexEngine()

