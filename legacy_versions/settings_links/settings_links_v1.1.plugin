def _match_row_fields(frag, position: int, row_map: dict) -> Optional[str]:
    if position < 0:
        return None
    for field_name, link in row_map.items():
        if _jint(frag, field_name, -1) == position:
            return link
    return None


def _get_uitem(list_view, position: int):
    if list_view is None or position < 0:
        return None
    try:
        adapter = _jget(list_view, "adapter") or list_view.getAdapter()
        if adapter is None:
            return None
        return adapter.getItem(position)
    except Exception:
        return None


def _has_focused_edittext(view: View) -> bool:
    if isinstance(view, EditText) and view.hasFocus():
        return True
    if isinstance(view, ViewGroup):
        try:
            for i in range(int(view.getChildCount())):
                if _has_focused_edittext(view.getChildAt(i)):
                    return True
        except Exception:
            pass
    return False


def _get_plugin_settings_link(plugin_id: str, link_alias: Optional[str] = None) -> str:
    if not plugin_id:
        return ""
    for cls_name in (
        "app.exteraless.plugins.PluginsController",
        "com.exteragram.messenger.plugins.PluginsController",
    ):
        try:
            cls = find_class(cls_name)
            if cls is not None and hasattr(cls, "settingsLink"):
                res = cls.settingsLink(plugin_id, link_alias)
                if res:
                    return str(res)
        except Exception:
            pass
    try:
        from android.net import Uri
        pid_enc = str(Uri.encode(plugin_id))
        link = f"https://t.me/exteraSettings?p={pid_enc}"
        if link_alias:
            link += f"&s={Uri.encode(str(link_alias))}"
        return link
    except Exception:
        return f"https://t.me/exteraSettings?p={plugin_id}" + (f"&s={link_alias}" if link_alias else "")


def _get_settings_registry_link(frag, item) -> Optional[str]:
    """Получает официальную ссылку из SettingsRegistry (exteraGram 13.2.2+)."""
    if frag is None or item is None:
        return None
    for cls_name in (
        "com.exteragram.messenger.preferences.utils.SettingsRegistry",
        "app.exteraless.settings.SettingsRegistry",
    ):
        try:
            reg_cls = find_class(cls_name)
            if reg_cls is None:
                continue
            inst = reg_cls.getInstance()
            if inst is not None and hasattr(inst, "getFirstSettingLink"):
                link = inst.getFirstSettingLink(frag.getClass(), item)
                if link:
                    s = str(link).strip()
                    if s:
                        return s
        except Exception:
            pass
    return None


def _resolve_search_result_link(item) -> Optional[str]:
    if item is None:
        return None
    obj = _jget(item, "object")
    if obj is not None:
        try:
            link = _jget(obj, "link")
            if link:
                s = str(link).strip()
                if s:
                    return s
        except Exception:
            pass
    return None


def _resolve_settings_activity(frag, list_view, view, position: int) -> Optional[str]:
    item = _get_uitem(list_view, position)
    if item is None:
        return None
    if _is_account_cell(item):
        return None
    if _is_search_cell(item):
        if _setting_bool(KEY_CLIENT_URL_PREVIEW, False):
            return _resolve_search_result_link(item)
        return None
    if _jget(item, "object") is not None:
        return None
    if _jget(item, "text") is None:
        return None
    item_id = _jint(item, "id", -99999)
    if item_id == _KPM_SETTINGS_ITEM_ID:
        if _setting_bool(KEY_CLIENT_URL_PREVIEW, False):
            return _get_plugin_settings_link("kangel_plugins_manager", None) or "tg://kpm_list"
        return None
    link = SETTINGS_ID_TO_LINK.get(item_id)
    if link:
        return link
    if _setting_bool(KEY_CLIENT_URL_PREVIEW, False):
        return _get_settings_registry_link(frag, item)
    return None


def _resolve_user_info(frag, list_view, view, position: int) -> Optional[str]:
    if _has_focused_edittext(view):
        return None
    link = _match_row_fields(frag, position, USER_INFO_ROW_MAP)
    if link:
        return link
    item = _get_uitem(list_view, position)
    if item is not None and not _is_account_cell(item) and _jget(item, "text") is not None:
        return USER_INFO_ID_MAP.get(_jint(item, "id", -99999))
    return None


def _resolve_notif_custom(frag, list_view, view, position: int) -> Optional[str]:
    if position < 0:
        return None
    ct = _jint(frag, "currentType", -1)
    nc = "org.telegram.messenger.NotificationsController"
    type_map = {
        _static_int(nc, "TYPE_PRIVATE", 1): "private-chats",
        _static_int(nc, "TYPE_GROUP", 0): "groups",
        _static_int(nc, "TYPE_CHANNEL", 2): "channels",
        _static_int(nc, "TYPE_STORIES", 3): "stories",
        _static_int(nc, "TYPE_REACTIONS_MESSAGES", 4): "reactions",
        _static_int(nc, "TYPE_REACTIONS_STORIES", 5): "reactions",
    }
    prefix = type_map.get(ct)
    if not prefix:
        return None
    for field_name, suffix in NOTIF_CUSTOM_ROW_SUFFIX.items():
        if _jint(frag, field_name, -1) == position:
            return f"tg://settings/notifications/{prefix}/{suffix}"
    return None


def _resolve_privacy_control(frag, list_view, view, position: int) -> Optional[str]:
    if position < 0:
        return None
    rt = _jint(frag, "rulesType", -1)
    cc = "org.telegram.messenger.ContactsController"
    p2p_type = _static_int(cc, "PRIVACY_RULES_TYPE_P2P", 3)
    msg_type = _static_int(cc, "PRIVACY_RULES_TYPE_MESSAGES", 10)
    photo_type = _static_int(cc, "PRIVACY_RULES_TYPE_PHOTO", 4)
    last_type = _static_int(cc, "PRIVACY_RULES_TYPE_LASTSEEN", 0)
    bday_type = _static_int(cc, "PRIVACY_RULES_TYPE_BIRTHDAY", 9)
    gifts_type = _static_int(cc, "PRIVACY_RULES_TYPE_GIFTS", 12)
    calls_type = _static_int(cc, "PRIVACY_RULES_TYPE_CALLS", 2)

    slug_map = {
        _static_int(cc, "PRIVACY_RULES_TYPE_PHONE", 6): "phone-number",
        last_type: "last-seen",
        photo_type: "profile-photos",
        _static_int(cc, "PRIVACY_RULES_TYPE_BIO", 8): "bio",
        gifts_type: "gifts",
        bday_type: "birthday",
        _static_int(cc, "PRIVACY_RULES_TYPE_MUSIC", 14): "saved-music",
        _static_int(cc, "PRIVACY_RULES_TYPE_FORWARDS", 5): "forwards",
        p2p_type: "calls/p2p",
        calls_type: "calls",
        _static_int(cc, "PRIVACY_RULES_TYPE_VOICE_MESSAGES", 7): "voice",
        msg_type: "messages",
        _static_int(cc, "PRIVACY_RULES_TYPE_INVITE", 1): "invites",
    }
    slug = slug_map.get(rt)
    if not slug:
        return None

    if rt == bday_type and _jint(frag, "setBirthdayRow", -1) == position:
        return "tg://settings/privacy/birthday/add"
    if _jint(frag, "everybodyRow", -1) == position:
        return f"tg://settings/privacy/{slug}/always-share"
    if _jint(frag, "nobodyRow", -1) == position:
        return f"tg://settings/privacy/{slug}/never-share"
    if rt == gifts_type:
        if _jint(frag, "showGiftIconRow", -1) == position:
            return "tg://settings/privacy/gifts/show-icon"
        if _jint(frag, "giftTypesHeaderRow", -1) == position:
            return "tg://settings/privacy/gifts/accepted-types"
    if rt == msg_type:
        if _jint(frag, "priceRow", -1) == position:
            return "tg://settings/privacy/messages/set-price"
        if _jint(frag, "alwaysShareRow", -1) == position:
            return "tg://settings/privacy/messages/remove-fee"
    if rt == last_type and _jint(frag, "readRow", -1) == position:
        return "tg://settings/privacy/last-seen/hide-read-time"
    if rt == photo_type:
        if _jint(frag, "photoForRestRow", -1) == position:
            return "tg://settings/privacy/profile-photos/set-public"
        if _jint(frag, "currentPhotoForRestRow", -1) == position:
            return "tg://settings/privacy/profile-photos/remove-public"
    if rt == calls_type and _jint(frag, "p2pRow", -1) == position:
        return "tg://settings/privacy/calls/p2p"
    return None


def _resolve_sessions(frag, list_view, view, position: int) -> Optional[str]:
    if position < 0:
        return None
    ct = _jint(frag, "currentType", 0)
    if ct == 1:  # TYPE_WEB_SESSIONS
        if _jint(frag, "terminateAllSessionsRow", -1) == position:
            return "tg://settings/privacy/active-websites/disconnect-all"
        return None
    if _jint(frag, "qrCodeRow", -1) == position:
        return "tg://settings/devices/link-desktop"
    if _jint(frag, "terminateAllSessionsRow", -1) == position:
        return "tg://settings/devices/terminate-sessions"
    if _jint(frag, "ttlRow", -1) == position:
        return "tg://settings/devices/auto-terminate"
    return None


def _resolve_auto_download(frag, list_view, view, position: int) -> Optional[str]:
    if position < 0:
        return None
    ct = _jint(frag, "currentType", 0)
    prefix = {0: "mobile", 1: "wifi", 2: "roaming"}.get(ct)
    if not prefix:
        return None
    for field_name, suffix in AUTO_DOWNLOAD_ROW_SUFFIX.items():
        if _jint(frag, field_name, -1) == position:
            return f"tg://settings/data/auto-download/{prefix}/{suffix}"
    return None


def _resolve_save_gallery(frag, list_view, view, position: int) -> Optional[str]:
    if position < 0:
        return None
    tp = _jint(frag, "type", -1)
    sc = "org.telegram.messenger.SharedConfig"
    prefix = {
        _static_int(sc, "SAVE_TO_GALLERY_FLAG_PEER", 1): "chats",
        _static_int(sc, "SAVE_TO_GALLERY_FLAG_GROUP", 2): "groups",
        _static_int(sc, "SAVE_TO_GALLERY_FLAG_CHANNELS", 4): "channels",
    }.get(tp)
    if not prefix:
        return None
    for field_name, suffix in SAVE_GALLERY_ROW_SUFFIX.items():
        if _jint(frag, field_name, -1) == position:
            return f"tg://settings/data/save-to-photos/{prefix}/{suffix}"
    return None


def _resolve_web_browser(frag, list_view, view, position: int) -> Optional[str]:
    link = _match_row_fields(frag, position, WEB_BROWSER_ROW_MAP)
    if link:
        return link
    item = _get_uitem(list_view, position)
    if item is not None and _jget(item, "text") is not None:
        return WEB_BROWSER_ID_MAP.get(_jint(item, "id", -99999))
    return None


def _resolve_stickers(frag, list_view, view, position: int) -> Optional[str]:
    if position < 0:
        return None
    ct = _jint(frag, "currentType", 0)
    mdc = "org.telegram.messenger.MediaDataController"
    type_image = _static_int(mdc, "TYPE_IMAGE", 0)
    type_emoji = _static_int(mdc, "TYPE_EMOJIPACKS", 5)

    item = _get_uitem(list_view, position)
    item_id = _jint(item, "id", -99999) if item is not None else -99999

    if ct == type_image:
        if _jint(frag, "featuredRow", -1) == position or item_id == 1:
            return "tg://settings/appearance/stickers-and-emoji/trending"
        if _jint(frag, "archivedRow", -1) == position or item_id == 2:
            return "tg://settings/appearance/stickers-and-emoji/archived"
        if _jint(frag, "emojiPacksRow", -1) == position or item_id == 3:
            return "tg://settings/appearance/stickers-and-emoji/emoji"
        if _jint(frag, "largeEmojiRow", -1) == position or item_id == 6:
            return "tg://settings/appearance/stickers-and-emoji/emoji/large"
        if _jint(frag, "dynamicPackOrder", -1) == position or item_id == 7:
            return "tg://settings/appearance/stickers-and-emoji/emoji/dynamic-order"
    elif ct == type_emoji:
        if _jint(frag, "archivedRow", -1) == position or item_id == 2:
            return "tg://settings/appearance/stickers-and-emoji/emoji/archived"
        if _jint(frag, "suggestRow", -1) == position or item_id == 9:
            return "tg://settings/appearance/stickers-and-emoji/emoji/suggest"
    return None


def _resolve_lite_mode(frag, list_view, view, position: int) -> Optional[str]:
    if position < 0:
        return None
    items = _jget(frag, "items")
    if items is None or position >= int(items.size()):
        return None
    item = items.get(position)
    if item is None:
        return None
    flags = _jint(item, "flags", 0)
    tp = _jint(item, "type", -1)
    lm = "org.telegram.messenger.LiteMode"
    lsa = "org.telegram.ui.LiteModeSettingsActivity"

    smooth_type = _static_int(lsa, "SWITCH_TYPE_SMOOTH_TRANSITIONS", None)
    if smooth_type is not None and tp == smooth_type:
        return "tg://settings/power-saving/transitions"

    flag_map = (
        (_static_int(lm, "FLAG_AUTOPLAY_VIDEOS", None), "tg://settings/power-saving/videos"),
        (_static_int(lm, "FLAG_AUTOPLAY_GIFS", None), "tg://settings/power-saving/gifs"),
        (_static_int(lm, "FLAGS_ANIMATED_STICKERS", None), "tg://settings/power-saving/stickers"),
        (_static_int(lm, "FLAGS_ANIMATED_EMOJI", None), "tg://settings/power-saving/emoji"),
        (_static_int(lm, "FLAGS_CHAT", None) or _static_int(lsa, "FLAGS_CHAT", None), "tg://settings/power-saving/effects"),
        (_static_int(lm, "FLAG_CALLS_ANIMATIONS", None), "tg://settings/power-saving/call-animations"),
        (_static_int(lm, "FLAG_PARTICLES", None), "tg://settings/power-saving/particles"),
    )
    if flags != 0:
        for expected_flag, link in flag_map:
            if expected_flag is not None and flags == expected_flag:
                return link
    return None


def _resolve_language(frag, list_view, view, position: int) -> Optional[str]:
    if position < 0 or list_view is None:
        return None
    try:
        adapter = list_view.getAdapter()
        search_adapter = _jget(frag, "searchListViewAdapter")
        if search_adapter is not None and adapter is search_adapter:
            return None
    except Exception:
        pass
    return _match_row_fields(frag, position, LANGUAGE_ROW_MAP)


def _resolve_plugin_settings_item_link(frag, item) -> Optional[str]:
    if frag is None or item is None:
        return None
    plugin_id = _jget(frag, "pluginId")
    if not plugin_id:
        p = _jget(frag, "plugin")
        if p is not None:
            try:
                plugin_id = p.getId() if hasattr(p, "getId") else _jget(p, "id")
            except Exception:
                plugin_id = _jget(p, "id")
    plugin_id = str(plugin_id or "").strip()
    if not plugin_id:
        return None

    rows_map = _jget(frag, "rowsByItem")
    if rows_map is not None:
        try:
            row = rows_map.get(item)
        except Exception:
            row = None
        if row is not None:
            try:
                if str(row.optString("long_callback_id", "") or "").strip():
                    return None
                alias = str(row.optString("link_alias", "") or "").strip()
                if alias:
                    return _get_plugin_settings_link(plugin_id, alias)
            except Exception:
                pass

    for field_name in ("settingItem", "object"):
        si = _jget(item, field_name)
        if si is None:
            continue
        try:
            if hasattr(si, "optString"):
                if str(si.optString("long_callback_id", "") or "").strip():
                    return None
                alias_str = str(si.optString("link_alias", "") or "").strip()
                if alias_str:
                    return _get_plugin_settings_link(plugin_id, alias_str)
                continue
        except Exception:
            pass
        try:
            if _jget(si, "onLongClick") is not None or _jget(si, "longClickCallback") is not None:
                return None
            alias = None
            for mname in ("getLinkAlias",):
                if hasattr(si, mname):
                    try:
                        alias = getattr(si, mname)()
                    except Exception:
                        alias = None
                    break
            if not alias:
                alias = _jget(si, "linkAlias") or _jget(si, "link_alias")
            alias_str = str(alias or "").strip()
            if alias_str:
                return _get_plugin_settings_link(plugin_id, alias_str)
        except Exception:
            pass

    return None


def _resolve_plugin_settings_activity(frag, list_view, view, position: int) -> Optional[str]:
    if position < 0 or not _setting_bool(KEY_CLIENT_URL_PREVIEW, False):
        return None
    item = _get_uitem(list_view, position)
    if item is None:
        return None
    return _resolve_plugin_settings_item_link(frag, item) or _get_settings_registry_link(frag, item)


def _resolve_base_preferences_activity(frag, list_view, view, position: int) -> Optional[str]:
    if position < 0 or not _setting_bool(KEY_CLIENT_URL_PREVIEW, False):
        return None
    item = _get_uitem(list_view, position)
    if item is None:
        return None
    return _get_settings_registry_link(frag, item)


def _resolve_kpm_plugin_list(frag, list_view, view, position: int) -> Optional[str]:
    if position < 0 or not _setting_bool(KEY_CLIENT_URL_PREVIEW, False):
        return None
    item = _get_uitem(list_view, position)
    if item is None:
        return None
    obj = _jget(item, "object")
    if obj is None:
        return None
    try:
        engine = obj.getEngine() if hasattr(obj, "getEngine") else _jget(obj, "engine")
        if str(engine or "") != "kangel_plugins_manager":
            return None
        pid = obj.getId() if hasattr(obj, "getId") else _jget(obj, "id")
        pid_str = str(pid or "").strip()
        if pid_str:
            return f"tg://kpm_install?plugin={pid_str}"
    except Exception:
        pass
    return None


SCREEN_RESOLVERS = {
    "org.telegram.ui.SettingsActivity": _resolve_settings_activity,
    "org.telegram.ui.UserInfoActivity": _resolve_user_info,
    "org.telegram.ui.ProfileActivity": lambda f, lv, v, p: _match_row_fields(f, p, PROFILE_ROW_MAP),
    "org.telegram.ui.NotificationsSettingsActivity": lambda f, lv, v, p: _match_row_fields(f, p, NOTIFICATIONS_ROW_MAP),
    "org.telegram.ui.NotificationsCustomSettingsActivity": _resolve_notif_custom,
    "org.telegram.ui.PrivacySettingsActivity": lambda f, lv, v, p: _match_row_fields(f, p, PRIVACY_ROW_MAP),
    "org.telegram.ui.PrivacyControlActivity": _resolve_privacy_control,
    "org.telegram.ui.PasscodeActivity": lambda f, lv, v, p: _match_row_fields(f, p, PASSCODE_ROW_MAP),
    "org.telegram.ui.TwoStepVerificationActivity": lambda f, lv, v, p: _match_row_fields(f, p, TWO_STEP_ROW_MAP),
    "org.telegram.ui.PasskeysActivity": lambda f, lv, v, p: _match_row_fields(f, p, PASSKEYS_ROW_MAP),
    "org.telegram.ui.SessionsActivity": _resolve_sessions,
    "org.telegram.ui.DataSettingsActivity": lambda f, lv, v, p: _match_row_fields(f, p, DATA_SETTINGS_ROW_MAP),
    "org.telegram.ui.DataAutoDownloadActivity": _resolve_auto_download,
    "org.telegram.ui.SaveToGallerySettingsActivity": _resolve_save_gallery,
    "org.telegram.ui.ProxyListActivity": lambda f, lv, v, p: _match_row_fields(f, p, PROXY_ROW_MAP),
    "org.telegram.ui.ThemeActivity": lambda f, lv, v, p: _match_row_fields(f, p, THEME_ROW_MAP),
    "org.telegram.ui.WallpapersListActivity": lambda f, lv, v, p: _match_row_fields(f, p, WALLPAPERS_ROW_MAP),
    "org.telegram.ui.web.WebBrowserSettings": _resolve_web_browser,
    "org.telegram.ui.StickersActivity": _resolve_stickers,
    "org.telegram.ui.FiltersSetupActivity": lambda f, lv, v, p: _match_row_fields(f, p, FILTERS_ROW_MAP),
    "org.telegram.ui.LiteModeSettingsActivity": _resolve_lite_mode,
    "org.telegram.ui.LanguageSelectActivity": _resolve_language,
    "com.exteragram.messenger.preferences.BasePreferencesActivity": _resolve_base_preferences_activity,
    "app.exteraless.plugins.ui.PluginSettingsActivity": _resolve_plugin_settings_activity,
    "com.exteragram.messenger.plugins.ui.PluginSettingsActivity": _resolve_plugin_settings_activity,
    "com.exteragram.messenger.plugins.ui.components.templates.UniversalFragment": _resolve_kpm_plugin_list,
    "app.exteraless.plugins.ui.components.templates.UniversalFragment": _resolve_kpm_plugin_list,
}


def _find_recycler_list_view(frag):
    if frag is None:
        return None
    lv = _jget(frag, "listView")
    if lv is not None:
        return lv
    root = _jget(frag, "fragmentView")
    if root is None and hasattr(frag, "getFragmentView"):
        try:
            root = frag.getFragmentView()
        except Exception:
            root = None
    if root is None:
        return None
    rlv_cls = _try_jclass("org.telegram.ui.Components.RecyclerListView")
    if rlv_cls is None:
        return None
    queue = [root]
    visited = 0
    while queue and visited < 64:
        cur = queue.pop(0)
        visited += 1
        if isinstance(cur, rlv_cls):
            return cur
        if isinstance(cur, ViewGroup):
            try:
                for i in range(int(cur.getChildCount())):
                    ch = cur.getChildAt(i)
                    if ch is not None:
                        queue.append(ch)
            except Exception:
                pass
    return None


def _find_screen_resolver(frag):
    if frag is None:
        return None
    c = frag.getClass()
    while c is not None:
        name = str(c.getName())
        res = SCREEN_RESOLVERS.get(name)
        if res is not None:
            return res
        if name == "org.telegram.ui.ActionBar.BaseFragment":
            break
        c = c.getSuperclass()
    return None


# ======================= Обёртка долгого нажатия для RecyclerListView =======================

_WRAPPED_LISTS = {}  # id(listView) -> (weakref(listView), proxy_obj, is_ext, orig_listener, frag_id)
_PROXY_IDS = set()
try:
    _JWeakRef = jclass("java.lang.ref.WeakReference")
except Exception:
    _JWeakRef = None


def _wref(obj):
    if obj is None:
        return None
    if _JWeakRef is not None:
        try:
            return _JWeakRef(obj)
        except Exception:
            pass
    try:
        return weakref.ref(obj)
    except Exception:
        return obj


def _wderef(ref):
    if ref is None:
        return None
    if _JWeakRef is not None:
        try:
            if isinstance(ref, _JWeakRef):
                return ref.get()
        except Exception:
            pass
    if isinstance(ref, weakref.ReferenceType):
        return ref()
    if hasattr(ref, "get") and not hasattr(ref, "getContext") and not hasattr(ref, "getClass"):
        try:
            return ref.get()
        except Exception:
            pass
    return ref


def _prune_dead_refs():
    for store in (_KPM_SHARE_BTNS, _KPM_CARD_VIEWS, _CELL_SETTINGS_BTNS):
        for k in list(store.keys()):
            if _wderef(store[k][0]) is None:
                store.pop(k, None)
    for k in list(_WRAPPED_LISTS.keys()):
        if _wderef(_WRAPPED_LISTS[k][0]) is None:
            _WRAPPED_LISTS.pop(k, None)


def _handle_resolved_long_click(frag, list_view, view, position, resolver) -> bool:
    if not _PLUGIN_ACTIVE or frag is None or list_view is None:
        return False
    try:
        link = resolver(frag, list_view, view, int(position))
        if link:
            is_tp = (
                resolver in (
                    _resolve_plugin_settings_activity,
                    _resolve_base_preferences_activity,
                    _resolve_kpm_plugin_list,
                )
                or not link.startswith("tg://settings")
            )
            return _show_settings_row_menu(
                frag,
                view,
                list_view,
                link,
                force_url_preview=_setting_bool(KEY_CLIENT_URL_PREVIEW, False) if is_tp else None,
                show_share=_setting_bool(KEY_CLIENT_SHOW_SHARE, True) if is_tp else None,
            )
    except Exception:
        pass
    return False


def _make_simple_long_click_proxy(frag, list_view, resolver, orig, run_first=False):
    iface = find_class("org.telegram.ui.Components.RecyclerListView$OnItemLongClickListener")
    frag_ref = _wref(frag)
    lv_ref = _wref(list_view)

    class _SimpleLongClickProxy(dynamic_proxy(iface)):
        def __init__(self):
            super().__init__()

        def onItemClick(self, view, position):
            f = _wderef(frag_ref)
            lv = _wderef(lv_ref)
            if run_first and _handle_resolved_long_click(f, lv, view, position, resolver):
                return True
            if orig is not None:
                try:
                    if bool(orig.onItemClick(view, position)):
                        return True
                except Exception:
                    pass
            if not run_first:
                return _handle_resolved_long_click(f, lv, view, position, resolver)
            return False

    return _SimpleLongClickProxy()


def _make_ext_long_click_proxy(frag, list_view, resolver, orig, run_first=False):
    iface = find_class("org.telegram.ui.Components.RecyclerListView$OnItemLongClickListenerExtended")
    frag_ref = _wref(frag)
    lv_ref = _wref(list_view)

    class _ExtLongClickProxy(dynamic_proxy(iface)):
        def __init__(self):
            super().__init__()

        def onItemClick(self, view, position, x, y):
            f = _wderef(frag_ref)
            lv = _wderef(lv_ref)
            if run_first and _handle_resolved_long_click(f, lv, view, position, resolver):
                return True
            if orig is not None:
                try:
                    if bool(orig.onItemClick(view, position, x, y)):
                        return True
                except Exception:
                    pass
            if not run_first:
                return _handle_resolved_long_click(f, lv, view, position, resolver)
            return False

        def onMove(self, dx, dy):
            if orig is not None:
                try:
                    orig.onMove(dx, dy)
                except Exception:
                    pass

        def onLongClickRelease(self):
            if orig is not None:
                try:
                    orig.onLongClickRelease()
                except Exception:
                    pass

    return _ExtLongClickProxy()


def _enable_longpress_on_list(lv):
    try:
        gd = _jget(lv, "gestureDetector")
        if gd is not None:
            gd.setIsLongpressEnabled(True)
            try:
                gd.setLongpressDuration(int(ViewConfiguration.getLongPressTimeout()))
            except Exception:
                pass
    except Exception:
        pass


def _install_list_listener(lv, iface_name: str, field_name: str, proxy) -> bool:
    try:
        iface = find_class(iface_name)
        if iface is not None:
            m = lv.getClass().getMethod("setOnItemLongClickListener", iface)
            m.invoke(lv, proxy)
            return True
    except Exception:
        pass
    try:
        lv.setOnItemLongClickListener(proxy)
        return True
    except Exception:
        pass
    if _jset(lv, field_name, proxy):
        _enable_longpress_on_list(lv)
        return True
    return False


def _attach_to_fragment(frag):
    if frag is None or not _PLUGIN_ACTIVE:
        return
    resolver = _find_screen_resolver(frag)
    if resolver is None:
        return
    lv = _find_recycler_list_view(frag)
    if lv is None:
        return

    cur_simple = _jget(lv, "onItemLongClickListener")
    cur_ext = _jget(lv, "onItemLongClickListenerExtended")

    if cur_simple is not None and System.identityHashCode(cur_simple) in _PROXY_IDS:
        _enable_longpress_on_list(lv)
        return
    if cur_ext is not None and System.identityHashCode(cur_ext) in _PROXY_IDS:
        _enable_longpress_on_list(lv)
        return

    lv_id = System.identityHashCode(lv)
    frag_id = System.identityHashCode(frag)
    _prune_dead_refs()
    run_first = (resolver is _resolve_plugin_settings_activity)
    if cur_ext is not None and cur_simple is None:
        proxy = _make_ext_long_click_proxy(frag, lv, resolver, cur_ext, run_first=run_first)
        if _install_list_listener(
            lv,
            "org.telegram.ui.Components.RecyclerListView$OnItemLongClickListenerExtended",
            "onItemLongClickListenerExtended",
            proxy,
        ):
            _PROXY_IDS.add(System.identityHashCode(proxy))
            _WRAPPED_LISTS[lv_id] = (_wref(lv), proxy, True, cur_ext, frag_id)
    else:
        proxy = _make_simple_long_click_proxy(frag, lv, resolver, cur_simple, run_first=run_first)
        if _install_list_listener(
            lv,
            "org.telegram.ui.Components.RecyclerListView$OnItemLongClickListener",
            "onItemLongClickListener",
            proxy,
        ):
            _PROXY_IDS.add(System.identityHashCode(proxy))
            _WRAPPED_LISTS[lv_id] = (_wref(lv), proxy, False, cur_simple, frag_id)


def _scan_fragment_tree(frag):
    if frag is None:
        return
    _attach_to_fragment(frag)
    try:
        arr = _jget(frag, "fragmentsArr")
        if arr is not None:
            for i in range(int(arr.size())):
                st = arr.valueAt(i)
                child = _jget(st, "fragment") if st is not None else None
                if child is not None:
                    _attach_to_fragment(child)
    except Exception:
        pass


def _restore_wrapped_list_entry(entry):
    lv = _wderef(entry[0])
    proxy, is_ext, orig = entry[1], entry[2], entry[3]
    if lv is None:
        return
    try:
        field_name = "onItemLongClickListenerExtended" if is_ext else "onItemLongClickListener"
        iface_name = (
            "org.telegram.ui.Components.RecyclerListView$OnItemLongClickListenerExtended"
            if is_ext
            else "org.telegram.ui.Components.RecyclerListView$OnItemLongClickListener"
        )
        cur = _jget(lv, field_name)
        if cur is not None and System.identityHashCode(cur) == System.identityHashCode(proxy):
            _install_list_listener(lv, iface_name, field_name, orig)
    except Exception:
        pass


def _cleanup_fragment_refs(frag):
    if frag is None:
        return
    fid = System.identityHashCode(frag)
    for lv_id, entry in list(_WRAPPED_LISTS.items()):
        if len(entry) >= 5 and entry[4] == fid:
            _restore_wrapped_list_entry(entry)
            _WRAPPED_LISTS.pop(lv_id, None)
    for k, entry in list(_TRACKED_OPTIONS.items()):
        f = _wderef(entry.get("frag"))
        if f is None or System.identityHashCode(f) == fid:
            _TRACKED_OPTIONS.pop(k, None)
    _prune_dead_refs()


def _restore_all_wrapped_lists():
    for _, entry in list(_WRAPPED_LISTS.items()):
        _restore_wrapped_list_entry(entry)
    _WRAPPED_LISTS.clear()
    _PROXY_IDS.clear()


class _FragmentDestroyHook(MethodHook):
    def after_hooked_method(self, param):
        try:
            _cleanup_fragment_refs(param.thisObject)
        except Exception:
            pass


# ======================= Хуки =======================

class _SettingsOnLongClickHook(MethodHook):
    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin

    def after_hooked_method(self, param):
        if not _PLUGIN_ACTIVE:
            return
        try:
            if bool(param.getResult()):
                return
            item = param.args[0]
            view = param.args[1]
            if item is None or view is None:
                return
            if _is_account_cell(item):
                return
            frag = param.thisObject
            lv = _jget(frag, "listView")
            if _is_search_cell(item):
                if _setting_bool(KEY_CLIENT_URL_PREVIEW, False):
                    link = _resolve_search_result_link(item)
                    if link and _show_settings_row_menu(
                        frag,
                        view,
                        lv,
                        link,
                        force_url_preview=True,
                        show_share=_setting_bool(KEY_CLIENT_SHOW_SHARE, True),
                    ):
                        param.setResult(True)
                return
            if _jget(item, "object") is not None:
                return
            if _jget(item, "text") is None:
                return
            item_id = _jint(item, "id", -99999)
            is_tp = False
            if item_id == _KPM_SETTINGS_ITEM_ID:
                if not _setting_bool(KEY_CLIENT_URL_PREVIEW, False):
                    return
                link = _get_plugin_settings_link("kangel_plugins_manager", None) or "tg://kpm_list"
                is_tp = True
            else:
                link = SETTINGS_ID_TO_LINK.get(item_id)
                if not link and _setting_bool(KEY_CLIENT_URL_PREVIEW, False):
                    link = _get_settings_registry_link(frag, item)
                    is_tp = bool(link and not link.startswith("tg://settings"))
            if not link:
                return
            if _show_settings_row_menu(
                frag,
                view,
                lv,
                link,
                force_url_preview=True if is_tp else None,
                show_share=_setting_bool(KEY_CLIENT_SHOW_SHARE, True) if is_tp else None,
            ):
                param.setResult(True)
        except Exception:
            pass


class _PluginSettingsOnLongClickHook(MethodHook):
    def before_hooked_method(self, param):
        if not _PLUGIN_ACTIVE or _IN_OWN_MENU:
            return
        try:
            frag = param.thisObject
            if frag is None or "PluginSettingsActivity" not in str(frag.getClass().getName()):
                return
            if not _setting_bool(KEY_CLIENT_URL_PREVIEW, False):
                return
            args = param.args
            if len(args) < 2:
                return
            item, view = args[0], args[1]
            if item is None or view is None:
                return
            link = _resolve_plugin_settings_item_link(frag, item)
            if not link:
                return
            lv = _jget(frag, "listView")
            if _show_settings_row_menu(
                frag,
                view,
                lv,
                link,
                force_url_preview=True,
                show_share=_setting_bool(KEY_CLIENT_SHOW_SHARE, True),
            ):
                param.setResult(True)
        except Exception:
            pass


def _refresh_plugins_activity(frag):
    if frag is None or not _PLUGIN_ACTIVE:
        return
    try:
        cname = str(frag.getClass().getName())
        if not cname.endswith("PluginsActivity"):
            return
        _sync_java_description(_ACTIVE_PLUGIN, notify=False)
        try:
            m_ref = frag.getClass().getDeclaredMethod("refreshPlugins", jclass("java.lang.Boolean").TYPE)
            m_ref.setAccessible(True)
            m_ref.invoke(frag, False)
        except Exception:
            pass
        try:
            m_upd = frag.getClass().getDeclaredMethod("updateRows")
            m_upd.setAccessible(True)
            m_upd.invoke(frag)
        except Exception:
            lv = _jget(frag, "listView")
            if lv is not None and getattr(lv, "adapter", None) is not None:
                lv.adapter.update(False)
    except Exception:
        pass


class _FragmentAttachHook(MethodHook):
    def after_hooked_method(self, param):
        if not _PLUGIN_ACTIVE:
            return
        try:
            frag = param.thisObject
            _scan_fragment_tree(frag)
            _refresh_plugins_activity(frag)
        except Exception:
            pass


class _RescanPluginsHook(MethodHook):
    def after_hooked_method(self, param):
        if not _PLUGIN_ACTIVE:
            return
        try:
            _sync_java_description(_ACTIVE_PLUGIN, notify=False)
        except Exception:
            pass


def _is_client_settings_fragment(frag) -> bool:
    if frag is None:
        return False
    try:
        cname = str(frag.getClass().getName())
    except Exception:
        return False
    if "PluginSettingsActivity" in cname or "PluginsActivity" in cname:
        return False
    for prefix in (
        "app.exteraless.",
        "com.exteragram.",
        "tw.nekomimi.",
        "com.radolyn.",
        "xyz.nextalone.",
    ):
        if cname.startswith(prefix):
            return True
    return False


def _is_settings_link_candidate(s: str) -> bool:
    if not s:
        return False
    low = s.lower()
    if low.startswith(("tg://settings", "tg://exterasettings", "tg://kpm_install")):
        return True
    if low.startswith(("https://t.me/", "http://t.me/")):
        rest = low.split("t.me/", 1)[1]
        if rest.startswith(("exterasettings?", "exterasettings/", "settings")):
            return True
        if "?" in rest and ("s=" in rest or "p=" in rest or "plugin=" in rest):
            return True
    return False


def _extract_link_from_runnable(runnable) -> Optional[str]:
    if runnable is None:
        return None
    try:
        fallback = None
        cls = runnable.getClass()
        while cls is not None:
            name = str(cls.getName())
            if name == "java.lang.Object":
                break
            for f in cls.getDeclaredFields():
                try:
                    f.setAccessible(True)
                    val = f.get(runnable)
                    if val is None:
                        continue
                    s = str(val)
                    if _is_settings_link_candidate(s):
                        return s
                    if fallback is None and s.startswith("tg://"):
                        fallback = s
                except Exception:
                    continue
            cls = cls.getSuperclass()
        return fallback
    except Exception:
        pass
    return None


class _ClientRowMenuHook(MethodHook):
    def before_hooked_method(self, param):
        if not _PLUGIN_ACTIVE or _IN_OWN_MENU:
            return
        client_preview = _setting_bool(KEY_CLIENT_URL_PREVIEW, False)
        client_share = _setting_bool(KEY_CLIENT_SHOW_SHARE, True)
        if not client_preview and client_share:
            return
        try:
            args = param.args
            if len(args) >= 3:
                frag, row, link = args[0], args[1], args[2]
            elif len(args) == 2:
                # BasePreferencesActivity.showCopyLinkOptions(View view, String link)
                frag, row, link = param.thisObject, args[0], args[1]
            else:
                return
            if frag is None or row is None or not link:
                return
            link_str = str(link)
            if _show_settings_row_menu(
                frag,
                row,
                _jget(frag, "listView"),
                link_str,
                force_url_preview=client_preview,
                show_share=client_share,
            ):
                param.setResult(None)
        except Exception:
            pass


def _find_kpm_card_plugin_id(view) -> Optional[str]:
    if not isinstance(view, View):
        return None
    cur = view
    has_kpm_buttons = False
    for _ in range(10):
        if cur is None:
            break
        try:
            if not has_kpm_buttons and hasattr(cur, "getTag"):
                tag = cur.getTag()
                if tag is not None and str(tag) == "kpm_buttons":
                    has_kpm_buttons = True
        except Exception:
            pass
        try:
            cname = str(cur.getClass().getName())
            if cname.endswith(".PluginCell") or cname.endswith("$PluginCell"):
                cached_pid = _KPM_CELL_PIDS.get(System.identityHashCode(cur))
                if cached_pid:
                    return cached_pid
                if has_kpm_buttons or cur.findViewWithTag("kpm_buttons") is not None:
                    pid = _jget(cur, "pluginId")
                    if not pid:
                        for pfield in ("plugin", "currentPlugin"):
                            pobj = _jget(cur, pfield)
                            if pobj is not None:
                                pid = pobj.getId() if hasattr(pobj, "getId") else _jget(pobj, "id")
                                if pid:
                                    break
                    pid_str = str(pid or "").strip()
                    if pid_str:
                        return pid_str
                return None
        except Exception:
            pass
        try:
            cur = cur.getParent()
        except Exception:
            break
    return None


def _get_active_fragment(fallback=None):
    try:
        bf_cls = _try_jclass("org.telegram.ui.ActionBar.BaseFragment")
        if fallback is not None and bf_cls is not None and isinstance(fallback, bf_cls):
            return fallback
    except Exception:
        pass
    try:
        la_cls = _try_jclass("org.telegram.ui.LaunchActivity")
        if la_cls is not None:
            inst = la_cls.instance
            if inst is not None:
                for mname in ("getRightActionBarLayout", "getActionBarLayout"):
                    try:
                        layout = getattr(inst, mname)()
                        if layout is not None:
                            last = layout.getLastFragment()
                            if last is not None:
                                return last
                    except Exception:
                        continue
    except Exception:
        pass
    return fallback


class _ItemOptionsMakeHook(MethodHook):
    def after_hooked_method(self, param):
        if not _PLUGIN_ACTIVE or _IN_OWN_MENU:
            return
        try:
            args = param.args
            if len(args) < 2:
                return
            frag = args[0]
            row = args[1]
            if not isinstance(row, View) and len(args) >= 3 and isinstance(args[2], View):
                row = args[2]
            opts = param.getResult()
            if opts is None or not isinstance(row, View):
                return

            client_preview = _setting_bool(KEY_CLIENT_URL_PREVIEW, False)
            client_share = _setting_bool(KEY_CLIENT_SHOW_SHARE, True)
            if client_preview:
                kpm_pid = _find_kpm_card_plugin_id(row)
                if kpm_pid:
                    try:
                        ctx = None
                        if hasattr(opts, "getContext"):
                            ctx = opts.getContext()
                        if ctx is None:
                            ctx = row.getContext()
                        if ctx is not None:
                            real_frag = frag if hasattr(frag, "getParentLayout") else _get_active_fragment()
                            badge = _build_url_preview_view(
                                ctx,
                                f"tg://kpm_install?plugin={kpm_pid}",
                                real_frag,
                                opts,
                            )
                            opts.addView(badge)
                    except Exception:
                        pass
                    return
            if not client_preview and client_share:
                return
            if not _is_client_settings_fragment(frag):
                return
            if len(_TRACKED_OPTIONS) > 16:
                _TRACKED_OPTIONS.clear()
            _TRACKED_OPTIONS[System.identityHashCode(opts)] = {
                "frag": _wref(frag),
                "row": _wref(row),
                "link": None,
            }
        except Exception:
            pass


class _ItemOptionsAddHook(MethodHook):
    def after_hooked_method(self, param):
        if not _PLUGIN_ACTIVE or _IN_OWN_MENU:
            return
        try:
            opts = param.thisObject
            if opts is None:
                return
            entry = _TRACKED_OPTIONS.get(System.identityHashCode(opts))
            if entry is None or entry["link"] is not None:
                return
            copy_label = _res_string("CopyLink", _t("copy_link"))
            has_copy_label = False
            found_link = None
            for a in param.args:
                if a is None:
                    continue
                try:
                    s = str(a)
                    if s == copy_label or s in ("Copy Link", "Копировать ссылку"):
                        has_copy_label = True
                except Exception:
                    pass
                if found_link is None:
                    found_link = _extract_link_from_runnable(a)
            if has_copy_label and found_link:
                entry["link"] = found_link
        except Exception:
            pass


class _ItemOptionsShowHook(MethodHook):
    def before_hooked_method(self, param):
        if not _PLUGIN_ACTIVE or _IN_OWN_MENU:
            return
        try:
            opts = param.thisObject
            if opts is None:
                return
            entry = _TRACKED_OPTIONS.pop(System.identityHashCode(opts), None)
            if entry is None or not entry["link"]:
                return
            client_preview = _setting_bool(KEY_CLIENT_URL_PREVIEW, False)
            client_share = _setting_bool(KEY_CLIENT_SHOW_SHARE, True)
            if not client_preview and client_share:
                return
            try:
                if int(opts.getItemsCount()) > 4:
                    return
            except Exception:
                pass
            frag = _wderef(entry["frag"])
            row = _wderef(entry["row"])
            if frag is None or row is None:
                return
            if _show_settings_row_menu(
                frag,
                row,
                _jget(frag, "listView"),
                entry["link"],
                force_url_preview=client_preview,
                show_share=client_share,
            ):
                param.setResult(opts)
        except Exception:
            pass


def _wire_kpm_cell(cell, pid_str: str, is_kpm: bool):
    if not _PLUGIN_ACTIVE or cell is None:
        return
    try:
        kpm_buttons = None
        try:
            kpm_buttons = cell.findViewWithTag("kpm_buttons")
        except Exception:
            pass
        kpm_mode = bool(is_kpm or kpm_buttons is not None)
        cell_id = System.identityHashCode(cell)

        if kpm_mode and pid_str:
            _KPM_CELL_PIDS[cell_id] = pid_str

            def _attach_kpm_long_click(target_view, anchor_view, map_btns, map_listeners, clear_touch=False, use_lv=False):
                if target_view is None:
                    return
                vid = System.identityHashCode(target_view)
                map_btns[vid] = (_wref(target_view), pid_str)
                if clear_touch:
                    try:
                        target_view.setOnTouchListener(None)
                    except Exception:
                        pass
                try:
                    target_view.setLongClickable(True)
                except Exception:
                    pass
                if vid not in map_listeners:
                    anchor_ref = _wref(anchor_view)

                    class _KpmLongClick(dynamic_proxy(View.OnLongClickListener)):
                        def __init__(self, key_id, store, a_ref, with_lv):
                            super().__init__()
                            self.key_id = key_id
                            self.store = store
                            self.anchor_ref = a_ref
                            self.with_lv = with_lv

                        def onLongClick(self, v):
                            if not _PLUGIN_ACTIVE or not _setting_bool(KEY_CLIENT_URL_PREVIEW, False):
                                return False
                            entry = self.store.get(self.key_id)
                            cur_pid = entry[1] if entry else ""
                            if not cur_pid:
                                return False
                            frag = _get_active_fragment()
                            if frag is None:
                                return False
                            lv = _find_recycler_list_view(frag) if self.with_lv else None
                            a_view = _wderef(self.anchor_ref)
                            return _show_settings_row_menu(
                                frag,
                                a_view if a_view is not None else v,
                                lv,
                                f"tg://kpm_install?plugin={cur_pid}",
                                force_url_preview=True,
                                show_share=_setting_bool(KEY_CLIENT_SHOW_SHARE, True),
                            )

                    listener = _KpmLongClick(vid, map_btns, anchor_ref, use_lv)
                    target_view.setOnLongClickListener(listener)
                    map_listeners[vid] = listener

            share_btn = _jget(cell, "shareButton")
            if share_btn is not None:
                _attach_kpm_long_click(share_btn, share_btn, _KPM_SHARE_BTNS, _KPM_SHARE_LISTENERS, clear_touch=True, use_lv=False)

            _attach_kpm_long_click(cell, cell, _KPM_CARD_VIEWS, _KPM_CARD_LISTENERS, clear_touch=False, use_lv=True)
            for sub_name in ("descriptionView", "subtitleView", "pluginNameView"):
                sub_v = _jget(cell, sub_name)
                if sub_v is not None:
                    _attach_kpm_long_click(sub_v, cell, _KPM_CARD_VIEWS, _KPM_CARD_LISTENERS, clear_touch=False, use_lv=True)
            return

        _KPM_CELL_PIDS.pop(cell_id, None)
        _KPM_CARD_VIEWS.pop(cell_id, None)
        for sub_name in ("descriptionView", "subtitleView", "pluginNameView"):
            sub_v = _jget(cell, sub_name)
            if sub_v is not None:
                _KPM_CARD_VIEWS.pop(System.identityHashCode(sub_v), None)

        settings_btn = _jget(cell, "settingsButton")
        delegate = _jget(cell, "delegate")
        if settings_btn is not None and delegate is not None and pid_str:
            btn_id = System.identityHashCode(settings_btn)
            _CELL_SETTINGS_BTNS[btn_id] = (_wref(settings_btn), pid_str, _wref(delegate))
            if btn_id not in _CELL_SETTINGS_LISTENERS:
                cell_ref = _wref(cell)

                class _CellSettingsLongClick(dynamic_proxy(View.OnLongClickListener)):
                    def onLongClick(self, v):
                        entry = _CELL_SETTINGS_BTNS.get(btn_id)
                        cur_pid = entry[1] if entry else ""
                        del_ref = entry[2] if entry else None
                        cur_del = _wderef(del_ref)
                        if cur_del is None:
                            c = _wderef(cell_ref)
                            if c is not None:
                                cur_del = _jget(c, "delegate")
                        use_menu = bool(_PLUGIN_ACTIVE and cur_pid and _setting_bool(KEY_CLIENT_URL_PREVIEW, False))
                        if use_menu:
                            frag = _get_active_fragment(cur_del)
                            link = _get_plugin_settings_link(cur_pid, None)
                            if frag is not None and link:
                                if _show_settings_row_menu(
                                    frag,
                                    v,
                                    None,
                                    link,
                                    force_url_preview=True,
                                    show_share=_setting_bool(KEY_CLIENT_SHOW_SHARE, True),
                                ):
                                    return True
                        if cur_del is not None and hasattr(cur_del, "copyPluginSettingsLink"):
                            try:
                                cur_del.copyPluginSettingsLink()
                                return True
                            except Exception:
                                pass
                        return False

                listener = _CellSettingsLongClick()
                settings_btn.setOnLongClickListener(listener)
                _CELL_SETTINGS_LISTENERS[btn_id] = listener
    except Exception:
        pass


class _KpmPluginCellHook(MethodHook):
    def after_hooked_method(self, param):
        if not _PLUGIN_ACTIVE:
            return
        try:
            cell = param.thisObject
            if cell is None:
                return
            pid = _jget(cell, "pluginId")
            is_kpm = False
            if len(param.args) >= 1 and param.args[0] is not None:
                p = param.args[0]
                if not pid:
                    pid = p.getId() if hasattr(p, "getId") else _jget(p, "id")
                try:
                    eng = p.getEngine() if hasattr(p, "getEngine") else _jget(p, "engine")
                    is_kpm = (str(eng or "") == "kangel_plugins_manager")
                except Exception:
                    pass
            pid_str = str(pid or "").strip()
            if not pid_str:
                return
            _wire_kpm_cell(cell, pid_str, is_kpm)
            if is_kpm:
                r = Runnable(lambda c=cell: _wire_kpm_cell(c, _KPM_CELL_PIDS.get(System.identityHashCode(c), pid_str), True))
                try:
                    cell.post(r)
                except Exception:
                    pass
                try:
                    AndroidUtilities.runOnUIThread(r)
                except Exception:
                    pass
        except Exception:
            pass


# ======================= Класс плагина =======================

class SettingsLinksPlugin(BasePlugin):
    def on_plugin_load(self):
        global _ACTIVE_PLUGIN, _PLUGIN_ACTIVE
        _ACTIVE_PLUGIN = self
        _PLUGIN_ACTIVE = True
        _lang(self)
        _sync_java_description(self)
        try:
            AndroidUtilities.runOnUIThread(Runnable(lambda: _sync_java_description(self)), 250)
        except Exception:
            pass

        def _install(cls_name: str, method_name: str, hook):
            try:
                cls = find_class(cls_name)
                if cls is not None:
                    self.hook_all_methods(cls, method_name, hook)
            except Exception as e:
                self.log(f"{cls_name}.{method_name} hook failed: {e}")

        attach_hook = _FragmentAttachHook()
        _install("org.telegram.ui.SettingsActivity", "onLongClick", _SettingsOnLongClickHook(self))
        _install("org.telegram.ui.SettingsActivity", "fillItems", attach_hook)
        _install("org.telegram.ui.ActionBar.BaseFragment", "onResume", attach_hook)
        _install("org.telegram.ui.ActionBar.BaseFragment", "onFragmentDestroy", _FragmentDestroyHook())
        _install("org.telegram.ui.ActionBar.BaseFragment", "onBecomeFullyVisible", attach_hook)
        _install("org.telegram.ui.ActionBar.BaseFragment", "onTransitionAnimationEnd", attach_hook)
        _install("app.exteraless.plugins.ui.PluginSettingsActivity", "createView", attach_hook)
        _install("com.exteragram.messenger.plugins.ui.PluginSettingsActivity", "createView", attach_hook)
        _install("com.exteragram.messenger.preferences.BasePreferencesActivity", "createView", attach_hook)
        _install("app.exteraless.plugins.ui.components.templates.UniversalFragment", "createView", attach_hook)
        _install("com.exteragram.messenger.plugins.ui.components.templates.UniversalFragment", "createView", attach_hook)

        rescan_hook = _RescanPluginsHook()
        _install("app.exteraless.plugins.PluginsController", "rescanPlugins", rescan_hook)
        _install("com.exteragram.messenger.plugins.PluginsController", "rescanPlugins", rescan_hook)

        client_menu_hook = _ClientRowMenuHook()
        _install("app.exteraless.settings.utils.SettingsRowMenu", "show", client_menu_hook)
        _install("com.exteragram.messenger.preferences.BasePreferencesActivity", "showCopyLinkOptions", client_menu_hook)

        _install("org.telegram.ui.Components.ItemOptions", "makeOptions", _ItemOptionsMakeHook())
        _install("org.telegram.ui.Components.ItemOptions", "add", _ItemOptionsAddHook())
        _install("org.telegram.ui.Components.ItemOptions", "show", _ItemOptionsShowHook())

        ps_hook = _PluginSettingsOnLongClickHook()
        hooked_ps_classes = set()
        for cls_name in (
            "app.exteraless.plugins.ui.PluginSettingsActivity",
            "com.exteragram.messenger.plugins.ui.PluginSettingsActivity",
        ):
            try:
                cls = find_class(cls_name)
                cur_cls = cls
                while cur_cls is not None:
                    jname = str(cur_cls.getName())
                    if jname == "org.telegram.ui.ActionBar.BaseFragment" or jname == "java.lang.Object":
                        break
                    if jname not in hooked_ps_classes:
                        hooked_ps_classes.add(jname)
                        try:
                            self.hook_all_methods(cur_cls, "onLongClick", ps_hook)
                        except Exception:
                            pass
                    cur_cls = cur_cls.getSuperclass()
            except Exception as e:
                self.log(f"{cls_name}.onLongClick hook failed: {e}")

        cell_hook = _KpmPluginCellHook()
        hooked_cell_classes = set()
        for cls_name in (
            "app.exteraless.plugins.ui.components.PluginCell",
            "com.exteragram.messenger.plugins.ui.components.PluginCell",
        ):
            try:
                cls = find_class(cls_name)
                if cls is not None:
                    jname = str(cls.getName())
                    if jname not in hooked_cell_classes:
                        hooked_cell_classes.add(jname)
                        self.hook_all_methods(cls, "set", cell_hook)
            except Exception as e:
                self.log(f"{cls_name}.set hook failed: {e}")

        self._discover_live_fragments()

    def on_plugin_unload(self):
        global _PLUGIN_ACTIVE, _MENU_PREVIEW_FACTORY, _LANG_SWITCH_FACTORY
        _PLUGIN_ACTIVE = False
        _TRACKED_OPTIONS.clear()
        _MENU_PREVIEW_REFS.clear()
        for fobj in (_MENU_PREVIEW_FACTORY, _LANG_SWITCH_FACTORY):
            try:
                if fobj is not None and hasattr(fobj, "release"):
                    fobj.release()
            except Exception:
                pass
        _MENU_PREVIEW_FACTORY = None
        _LANG_SWITCH_FACTORY = None
        for _, entry in list(_KPM_SHARE_BTNS.items()):
            try:
                btn = _wderef(entry[0])
                if btn is not None:
                    btn.setOnLongClickListener(None)
            except Exception:
                pass
        for _, entry in list(_KPM_CARD_VIEWS.items()):
            try:
                v = _wderef(entry[0])
                if v is not None:
                    v.setOnLongClickListener(None)
            except Exception:
                pass
        _KPM_CELL_PIDS.clear()
        _KPM_SHARE_BTNS.clear()
        _KPM_SHARE_LISTENERS.clear()
        _KPM_CARD_VIEWS.clear()
        _KPM_CARD_LISTENERS.clear()
        _CELL_SETTINGS_BTNS.clear()
        _CELL_SETTINGS_LISTENERS.clear()
        _PILL_CLICK_REFS.clear()
        _restore_all_wrapped_lists()
        try:
            self.unhook_all_methods()
        except Exception:
            pass

    def _discover_live_fragments(self):
        try:
            la_cls = _try_jclass("org.telegram.ui.LaunchActivity")
            if la_cls is None:
                return
            inst = la_cls.instance
            if inst is None:
                return
            for mname in ("getActionBarLayout", "getRightActionBarLayout"):
                try:
                    layout = getattr(inst, mname)()
                    if layout is None:
                        continue
                    stack = layout.getFragmentStack()
                    if stack is None:
                        continue
                    for i in range(int(stack.size())):
                        _scan_fragment_tree(stack.get(i))
                except Exception:
                    continue
        except Exception:
            pass

    def _setting(self, cls, alias: str = None, **kwargs):
        if alias:
            try:
                return cls(link_alias=alias, **kwargs)
            except TypeError:
                pass
        return cls(**kwargs)

    def create_settings(self) -> List[Any]:
        global _ACTIVE_PLUGIN
        _ACTIVE_PLUGIN = self
        _lang(self)
        return [
            self._setting(Custom, alias="language", factory=_get_lang_switch_factory().instance.java),
            Divider(),
            Custom(factory=_get_menu_preview_factory().instance.java),
            Divider(),
            self._setting(
                Switch,
                alias="show_url_preview",
                key=KEY_SHOW_URL_PREVIEW,
                text=_t("sw_url_preview", self),
                default=False,
                on_change=_refresh_live_menu_previews,
            ),
            self._setting(
                Switch,
                alias="client_url_preview",
                key=KEY_CLIENT_URL_PREVIEW,
                text=_t("sw_client_url", self),
                default=False,
                subtext=_t("sw_client_url_sub", self),
                on_change=_refresh_live_menu_previews,
            ),
            Divider(),
            self._setting(
                Switch,
                alias="show_share",
                key=KEY_SHOW_SHARE,
                text=_t("sw_share", self),
                default=True,
                subtext=_t("sw_share_sub", self),
                on_change=_refresh_live_menu_previews,
            ),
            self._setting(
                Switch,
                alias="client_show_share",
                key=KEY_CLIENT_SHOW_SHARE,
                text=_t("sw_client_share", self),
                default=True,
                subtext=_t("sw_client_share_sub", self),
                on_change=_refresh_live_menu_previews,
            ),
        ]
