# ======================= Локализация и метаданные =======================

def _detect_client_lang() -> str:
    try:
        info = LocaleController.getInstance().getCurrentLocaleInfo()
        code = str(info.getLangCode() or "").lower()
        if code.startswith("ru"):
            return "ru"
    except Exception:
        pass
    return "en"


def _lang(plugin=None) -> str:
    global _PLUGIN_LANG
    p = plugin or _ACTIVE_PLUGIN
    if p is not None:
        try:
            v = str(p.get_setting(LANG_KEY, "") or "").lower()
            if v in ("ru", "en"):
                _PLUGIN_LANG = v
                return v
        except Exception:
            pass
    if _PLUGIN_LANG in ("ru", "en"):
        return _PLUGIN_LANG
    _PLUGIN_LANG = _detect_client_lang()
    return _PLUGIN_LANG


def _t(key: str, plugin=None) -> str:
    lang = _lang(plugin)
    return _TR.get(lang, _TR["ru"]).get(key) or _TR["ru"].get(key, key)


def _sync_java_description(plugin=None, notify=True):
    desc = _t("plugin_desc", plugin)
    if plugin is not None:
        try:
            plugin.description = desc
        except Exception:
            pass

    def _set_only():
        updated = False
        for cls_name in (
            "com.exteragram.messenger.plugins.PluginsController",
            "app.exteraless.plugins.PluginsController",
        ):
            try:
                ctrl_cls = find_class(cls_name)
                if ctrl_cls is None:
                    continue
                ctrl = ctrl_cls.getInstance()
                plugins_map = ctrl.getPlugins() if ctrl is not None else None
                if plugins_map is None:
                    continue
                java_plugin = plugins_map.get(__id__)
                if java_plugin is None:
                    continue
                try:
                    java_plugin.setDescription(desc)
                except Exception:
                    _jset(java_plugin, "description", desc)
                if notify and hasattr(ctrl, "notifyPluginsChanged"):
                    ctrl.notifyPluginsChanged()
                updated = True
            except Exception:
                pass
        return updated

    if not notify:
        _set_only()
        return

    try:
        AndroidUtilities.runOnUIThread(Runnable(_set_only))
    except Exception:
        _set_only()


# ======================= Фирменный переключатель языка =======================

def _argb(c: int) -> int:
    return c - (1 << 32) if c >= 0x80000000 else c


def _is_dark_theme() -> bool:
    try:
        bg = int(Theme.getColor(Theme.key_windowBackgroundWhite))
        r = (bg >> 16) & 0xFF
        g = (bg >> 8) & 0xFF
        b = bg & 0xFF
        return (0.299 * r + 0.587 * g + 0.114 * b) < 128.0
    except Exception:
        return True


def _apply_lang_row_style(state, lang, animate=False):
    dark = _is_dark_theme()
    track_gd = state["track_gd"]
    track_gd.setColor(_argb(0xFF141D28 if dark else 0xFFE3E9F0))
    track_gd.setStroke(max(1, AndroidUtilities.dp(1)), _argb(0x10FFFFFF if dark else 0x10000000))

    try:
        accent = int(Theme.getColor(Theme.key_featuredStickers_addButton))
        state["thumb_gd"].setColor(accent)
    except Exception:
        accent = _argb(0xFF2E86D8)
        state["thumb_gd"].setColor(accent)

    ar = (accent >> 16) & 0xFF
    ag = (accent >> 8) & 0xFF
    ab = accent & 0xFF
    acc_lum = 0.299 * ar + 0.587 * ag + 0.114 * ab

    inactive = _argb(0xFF8396A8 if dark else 0xFF607488)
    active = _argb(0xFF111111 if acc_lum > 185.0 else 0xFFFFFFFF)
    is_en = (lang == "en")
    state["tv_ru"].setTextColor(inactive if is_en else active)
    state["tv_en"].setTextColor(active if is_en else inactive)

    tx = float(state["thumb_w"]) if is_en else 0.0
    thumb = state["thumb"]
    if animate:
        try:
            thumb.animate().translationX(tx).setDuration(200).start()
            return
        except Exception:
            pass
    thumb.setTranslationX(tx)


def _refresh_all_for_lang(plugin):
    if plugin is None:
        return
    _sync_java_description(plugin)
    _refresh_live_menu_previews()
    try:
        plugin.set_setting(LANG_KEY, _lang(plugin), reload_settings=True)
    except Exception:
        pass
    try:
        frag = get_last_fragment()
        if frag is not None and str(frag.getClass().getName()).endswith("PluginSettingsActivity"):
            m = getattr(frag, "updateItems", None)
            if callable(m):
                m()
    except Exception:
        pass
    try:
        la_cls = _try_jclass("org.telegram.ui.LaunchActivity")
        inst = la_cls.instance if la_cls is not None else None
        if inst is not None:
            for mname in ("getActionBarLayout", "getRightActionBarLayout"):
                try:
                    layout = getattr(inst, mname)()
                    stack = layout.getFragmentStack() if layout is not None else None
                    if stack is not None:
                        for i in range(int(stack.size())):
                            _refresh_plugins_activity(stack.get(i))
                except Exception:
                    continue
    except Exception:
        pass


class _LangPickClick(dynamic_proxy(View.OnClickListener)):
    def __init__(self, state, target_lang):
        super().__init__()
        self.state = state
        self.target_lang = target_lang

    def onClick(self, v):
        global _PLUGIN_LANG
        plugin = _ACTIVE_PLUGIN
        if _lang(plugin) == self.target_lang:
            return
        _PLUGIN_LANG = self.target_lang
        if plugin is not None:
            try:
                plugin.set_setting(LANG_KEY, self.target_lang, reload_settings=False)
            except Exception:
                pass
        try:
            _apply_lang_row_style(self.state, self.target_lang, animate=True)
        except Exception:
            pass

        def _finish_reload():
            _refresh_all_for_lang(_ACTIVE_PLUGIN)

        try:
            AndroidUtilities.runOnUIThread(Runnable(_finish_reload), 195)
        except Exception:
            _finish_reload()


def _get_lang_switch_factory():
    global _LANG_SWITCH_FACTORY
    if _LANG_SWITCH_FACTORY is not None:
        return _LANG_SWITCH_FACTORY

    def _make_option_tv(context, text):
        tv = TextView(context)
        tv.setText(text)
        tv.setTextSize(1, 14.5)
        try:
            tv.setTypeface(AndroidUtilities.getTypeface("fonts/rmedium.ttf"))
        except Exception:
            try:
                tv.setTypeface(AndroidUtilities.bold())
            except Exception:
                try:
                    tv.setTypeface(Typeface.DEFAULT_BOLD)
                except Exception:
                    pass
        tv.setGravity(Gravity.CENTER)
        tv.setSingleLine(True)
        return tv

    def create_view(context, list_view, current_account, class_guid, resources_provider):
        row = FrameLayout(context)
        row.setLayoutParams(ViewGroup.LayoutParams(-1, -2))
        row.setMinimumHeight(AndroidUtilities.dp(67))
        row.setPadding(
            AndroidUtilities.dp(16),
            AndroidUtilities.dp(11),
            AndroidUtilities.dp(16),
            AndroidUtilities.dp(11),
        )

        try:
            disp_w = int(AndroidUtilities.displaySize.x)
            pill_w = max(AndroidUtilities.dp(240), min(AndroidUtilities.dp(380), int(disp_w * 0.75)))
        except Exception:
            pill_w = AndroidUtilities.dp(280)
        if pill_w % 2 != 0:
            pill_w += 1
        pill_h = AndroidUtilities.dp(45)
        pad = AndroidUtilities.dp(4)
        thumb_w = (pill_w - 2 * pad) // 2
        thumb_h = pill_h - 2 * pad

        pill = FrameLayout(context)
        track_gd = GradientDrawable()
        track_gd.setCornerRadius(float(pill_h) / 2.0)
        pill.setBackground(track_gd)

        thumb = View(context)
        thumb_gd = GradientDrawable()
        thumb_gd.setColor(_argb(0xFF2E86D8))
        thumb_gd.setCornerRadius(float(thumb_h) / 2.0)
        thumb.setBackground(thumb_gd)
        thumb_lp = FrameLayout.LayoutParams(thumb_w, thumb_h)
        thumb_lp.leftMargin = pad
        thumb_lp.topMargin = pad
        pill.addView(thumb, thumb_lp)

        ll = LinearLayout(context)
        ll.setOrientation(LinearLayout.HORIZONTAL)
        tv_ru = _make_option_tv(context, _t("lang_ru"))
        tv_en = _make_option_tv(context, _t("lang_en"))
        opt_lp = LinearLayout.LayoutParams(0, -1, 1.0)
        ll.addView(tv_ru, opt_lp)
        ll.addView(tv_en, opt_lp)
        ll_lp = FrameLayout.LayoutParams(pill_w - 2 * pad, thumb_h)
        ll_lp.leftMargin = pad
        ll_lp.topMargin = pad
        pill.addView(ll, ll_lp)

        row.addView(pill, FrameLayout.LayoutParams(pill_w, pill_h, Gravity.CENTER))

        state = {
            "tv_ru": tv_ru,
            "tv_en": tv_en,
            "thumb": thumb,
            "thumb_gd": thumb_gd,
            "track_gd": track_gd,
            "thumb_w": thumb_w,
        }
        click_ru = _LangPickClick(state, "ru")
        click_en = _LangPickClick(state, "en")
        tv_ru.setOnClickListener(click_ru)
        tv_en.setOnClickListener(click_en)
        _apply_lang_row_style(state, _lang(), animate=False)

        _LANG_ROW_REFS[System.identityHashCode(row)] = (state, click_ru, click_en)
        return row

    def bind_view(view, item, divider, adapter, list_view):
        ref = _LANG_ROW_REFS.get(System.identityHashCode(view))
        if ref is None:
            return
        _apply_lang_row_style(ref[0], _lang(), animate=False)

    factory = SimpleSettingFactory(create_view, bind_view, is_clickable=False, is_shadow=True)
    _LANG_SWITCH_FACTORY = factory
    return factory


def _preview_mode(off_tg: bool, client: bool) -> Optional[str]:
    if off_tg and client:
        return "all"
    if off_tg:
        return "official"
    if client:
        return "client"
    return None


def _preview_mode_icon(mode: str) -> int:
    if mode == "official":
        return _res_drawable("msg_send", "msg_settings")
    if mode == "client":
        return _res_drawable("msg_plugins", "msg_bot", "msg_theme", "msg_tune")
    return _res_drawable("msg_language", "msg_list")


def _apply_menu_preview_style(state):
    dark = _is_dark_theme()
    try:
        card_bg = int(Theme.getColor(Theme.key_actionBarDefaultSubmenuBackground))
    except Exception:
        card_bg = _argb(0xFF1F2936 if dark else 0xFFFFFFFF)
    card_gd = state["card_gd"]
    card_gd.setColor(card_bg)
    card_gd.setStroke(max(1, AndroidUtilities.dp(1)), _argb(0x18FFFFFF if dark else 0x14000000))

    try:
        link_color = int(Theme.getColor(Theme.key_windowBackgroundWhiteBlueText4))
    except Exception:
        link_color = _argb(0xFF4EA4F6 if dark else 0xFF168ACD)

    pill_gd = state["pill_gd"]
    try:
        pill_gd.setColor(Theme.multAlpha(link_color, 0.12 if dark else 0.09))
        pill_gd.setStroke(max(1, AndroidUtilities.dp(1)), Theme.multAlpha(link_color, 0.22 if dark else 0.16))
    except Exception:
        pill_gd.setColor(_argb(0x18FFFFFF if dark else 0x0E000000))
        pill_gd.setStroke(max(1, AndroidUtilities.dp(1)), _argb(0x18FFFFFF if dark else 0x12000000))

    try:
        sel = Theme.createRadSelectorDrawable(Theme.getColor(Theme.key_listSelector), 9, 9)
        if sel is not None and hasattr(state["pill"], "setForeground"):
            state["pill"].setForeground(sel)
    except Exception:
        pass

    if state["iv"] is not None:
        try:
            state["iv"].setColorFilter(link_color, PorterDuff.Mode.SRC_IN)
        except Exception:
            pass
    state["tv"].setTextColor(link_color)

    try:
        item_text_color = int(Theme.getColor(Theme.key_actionBarDefaultSubmenuItem))
    except Exception:
        item_text_color = _argb(0xFFFFFFFF if dark else 0xFF111111)
    try:
        item_icon_color = int(Theme.getColor(Theme.key_actionBarDefaultSubmenuItemIcon))
    except Exception:
        item_icon_color = item_text_color

    for row_key in ("copy_row", "share_row"):
        try:
            row_sel = Theme.createSelectorDrawable(Theme.getColor(Theme.key_listSelector), 2)
            if row_sel is not None:
                state[row_key].setBackground(row_sel)
        except Exception:
            pass

    if state["copy_iv"] is not None:
        try:
            state["copy_iv"].setColorFilter(item_icon_color, PorterDuff.Mode.SRC_IN)
        except Exception:
            pass
    state["copy_tv"].setTextColor(item_text_color)
    state["copy_tv"].setText(_t("copy_link"))

    if state["share_iv"] is not None:
        try:
            state["share_iv"].setColorFilter(item_icon_color, PorterDuff.Mode.SRC_IN)
        except Exception:
            pass
    state["share_tv"].setTextColor(item_text_color)
    state["share_tv"].setText(_t("share_link"))

    pill_mode = _preview_mode(
        _setting_bool(KEY_SHOW_URL_PREVIEW, False),
        _setting_bool(KEY_CLIENT_URL_PREVIEW, False),
    )
    share_mode = _preview_mode(
        _setting_bool(KEY_SHOW_SHARE, True),
        _setting_bool(KEY_CLIENT_SHOW_SHARE, True),
    )
    state["pill_mode"] = pill_mode
    state["share_mode"] = share_mode

    state["pill_wrap"].setVisibility(View.VISIBLE if pill_mode is not None else View.GONE)
    state["share_row"].setVisibility(View.VISIBLE if share_mode is not None else View.GONE)

    def _style_badge(badge_key, iv_key, gd_key, mode):
        badge = state.get(badge_key)
        iv_b = state.get(iv_key)
        gd_b = state.get(gd_key)
        if badge is None:
            return
        if mode is None:
            badge.setVisibility(View.GONE)
            return
        badge.setVisibility(View.VISIBLE)
        if gd_b is not None:
            gd_b.setColor(card_bg)
            gd_b.setStroke(max(1, AndroidUtilities.dp(1)), _argb(0x18FFFFFF if dark else 0x14000000))
        try:
            b_sel = Theme.createRadSelectorDrawable(Theme.getColor(Theme.key_listSelector), 15, 15)
            if b_sel is not None and hasattr(badge, "setForeground"):
                badge.setForeground(b_sel)
        except Exception:
            pass
        if iv_b is not None:
            res_id = _preview_mode_icon(mode)
            if res_id != 0:
                iv_b.setImageResource(res_id)
            try:
                iv_b.setColorFilter(item_icon_color, PorterDuff.Mode.SRC_IN)
            except Exception:
                pass

    _style_badge("pill_badge", "pill_badge_iv", "pill_badge_gd", pill_mode)
    _style_badge("share_badge", "share_badge_iv", "share_badge_gd", share_mode)

    sync = state.get("sync_badges")
    if sync is not None:
        sync()
        try:
            state["row"].post(Runnable(sync))
        except Exception:
            pass


def _refresh_live_menu_previews(*_args):
    def _apply():
        for ref in list(_MENU_PREVIEW_REFS.values()):
            try:
                _apply_menu_preview_style(ref[0])
            except Exception:
                pass

    try:
        AndroidUtilities.runOnUIThread(Runnable(_apply))
    except Exception:
        _apply()


def _get_menu_preview_factory():
    global _MENU_PREVIEW_FACTORY
    if _MENU_PREVIEW_FACTORY is not None:
        return _MENU_PREVIEW_FACTORY

    sample_link = "tg://settings/privacy"

    def _make_menu_row(context, icon_name, icon_fallback, label_text):
        item_row = LinearLayout(context)
        item_row.setOrientation(LinearLayout.HORIZONTAL)
        item_row.setGravity(Gravity.CENTER_VERTICAL)
        item_row.setMinimumHeight(AndroidUtilities.dp(44))
        item_row.setPadding(
            AndroidUtilities.dp(16),
            AndroidUtilities.dp(4),
            AndroidUtilities.dp(16),
            AndroidUtilities.dp(4),
        )
        iv = None
        res_id = _res_drawable(icon_name, icon_fallback)
        if res_id != 0:
            iv = ImageView(context)
            iv.setImageResource(res_id)
            iv_lp = LinearLayout.LayoutParams(AndroidUtilities.dp(22), AndroidUtilities.dp(22))
            iv_lp.rightMargin = AndroidUtilities.dp(16)
            item_row.addView(iv, iv_lp)
        tv = TextView(context)
        tv.setText(label_text)
        tv.setTextSize(1, 15.5)
        tv.setSingleLine(True)
        tv.setEllipsize(TextUtils.TruncateAt.END)
        item_row.addView(tv, LinearLayout.LayoutParams(-2, -2))
        return item_row, iv, tv

    def create_view(context, list_view, current_account, class_guid, resources_provider):
        row = FrameLayout(context)
        row.setLayoutParams(ViewGroup.LayoutParams(-1, -2))
        row.setPadding(
            AndroidUtilities.dp(16),
            AndroidUtilities.dp(14),
            AndroidUtilities.dp(16),
            AndroidUtilities.dp(14),
        )

        card = LinearLayout(context)
        card.setOrientation(LinearLayout.VERTICAL)
        card.setPadding(0, AndroidUtilities.dp(4), 0, AndroidUtilities.dp(4))
        card_gd = GradientDrawable()
        card_gd.setCornerRadius(float(AndroidUtilities.dp(12)))
        card.setBackground(card_gd)
        if hasattr(card, "setElevation"):
            try:
                card.setElevation(float(AndroidUtilities.dp(3)))
            except Exception:
                pass

        pill_wrap = FrameLayout(context)
        pill_wrap.setPadding(
            AndroidUtilities.dp(10),
            AndroidUtilities.dp(6),
            AndroidUtilities.dp(10),
            AndroidUtilities.dp(4),
        )
        pill = LinearLayout(context)
        pill.setOrientation(LinearLayout.HORIZONTAL)
        pill.setGravity(Gravity.CENTER_VERTICAL)
        pill.setPadding(
            AndroidUtilities.dp(10),
            AndroidUtilities.dp(7),
            AndroidUtilities.dp(10),
            AndroidUtilities.dp(7),
        )
        pill_gd = GradientDrawable()
        pill_gd.setCornerRadius(float(AndroidUtilities.dp(9)))
        pill.setBackground(pill_gd)

        iv = None
        icon_res = _res_drawable("msg_link2", "msg_link")
        if icon_res != 0:
            iv = ImageView(context)
            iv.setImageResource(icon_res)
            iv_lp = LinearLayout.LayoutParams(AndroidUtilities.dp(15), AndroidUtilities.dp(15))
            iv_lp.rightMargin = AndroidUtilities.dp(7)
            pill.addView(iv, iv_lp)

        tv = TextView(context)
        tv.setText(sample_link)
        tv.setTextSize(1, 12.5)
        tv.setMaxLines(2)
        tv.setEllipsize(TextUtils.TruncateAt.MIDDLE)
        try:
            tv.setTypeface(AndroidUtilities.getTypeface("fonts/rmono.ttf"))
        except Exception:
            try:
                tv.setTypeface(Typeface.MONOSPACE)
            except Exception:
                pass
        pill.addView(tv, LinearLayout.LayoutParams(-2, -2))
        pill_wrap.addView(pill, FrameLayout.LayoutParams(-1, -2))
        card.addView(pill_wrap, LinearLayout.LayoutParams(-1, -2))

        copy_row, copy_iv, copy_tv = _make_menu_row(
            context,
            "msg_copy",
            "msg_copy_solar",
            _t("copy_link"),
        )
        share_row, share_iv, share_tv = _make_menu_row(
            context,
            "msg_share",
            "msg_forward",
            _t("share_link"),
        )
        card.addView(copy_row, LinearLayout.LayoutParams(-1, -2))
        card.addView(share_row, LinearLayout.LayoutParams(-1, -2))

        class _PreviewCopyClick(dynamic_proxy(View.OnClickListener)):
            def onClick(self, v):
                _copy_link(get_last_fragment(), sample_link)

        class _PreviewShareClick(dynamic_proxy(View.OnClickListener)):
            def onClick(self, v):
                _share_link(get_last_fragment(), v, sample_link)

        copy_click = _PreviewCopyClick()
        share_click = _PreviewShareClick()
        pill.setOnClickListener(copy_click)
        copy_row.setOnClickListener(copy_click)
        share_row.setOnClickListener(share_click)

        try:
            disp_w = int(AndroidUtilities.displaySize.x)
            card_w = max(AndroidUtilities.dp(224), min(AndroidUtilities.dp(268), int(disp_w * 0.64)))
        except Exception:
            card_w = AndroidUtilities.dp(248)
        row.setClipChildren(False)
        row.addView(card, FrameLayout.LayoutParams(card_w, -2, Gravity.CENTER_HORIZONTAL))

        def _make_mode_badge():
            b = FrameLayout(context)
            b_gd = GradientDrawable()
            b_gd.setCornerRadius(float(AndroidUtilities.dp(15)))
            b.setBackground(b_gd)
            if hasattr(b, "setElevation"):
                try:
                    b.setElevation(float(AndroidUtilities.dp(2)))
                except Exception:
                    pass
            b_iv = ImageView(context)
            b.addView(b_iv, FrameLayout.LayoutParams(AndroidUtilities.dp(16), AndroidUtilities.dp(16), Gravity.CENTER))
            b_sz = AndroidUtilities.dp(30)
            row.addView(b, FrameLayout.LayoutParams(b_sz, b_sz, Gravity.TOP | Gravity.LEFT))
            return b, b_iv, b_gd

        pill_badge, pill_badge_iv, pill_badge_gd = _make_mode_badge()
        share_badge, share_badge_iv, share_badge_gd = _make_mode_badge()

        state = {
            "row": row,
            "card": card,
            "card_gd": card_gd,
            "pill_wrap": pill_wrap,
            "pill": pill,
            "pill_gd": pill_gd,
            "iv": iv,
            "tv": tv,
            "copy_row": copy_row,
            "copy_iv": copy_iv,
            "copy_tv": copy_tv,
            "share_row": share_row,
            "share_iv": share_iv,
            "share_tv": share_tv,
            "pill_badge": pill_badge,
            "pill_badge_iv": pill_badge_iv,
            "pill_badge_gd": pill_badge_gd,
            "share_badge": share_badge,
            "share_badge_iv": share_badge_iv,
            "share_badge_gd": share_badge_gd,
            "pill_mode": None,
            "share_mode": None,
        }

        def _sync_badges():
            def _align(badge, target):
                if badge is None or target is None:
                    return
                if badge.getVisibility() != View.VISIBLE or target.getVisibility() != View.VISIBLE:
                    return
                if int(card.getWidth()) <= 0 or int(target.getHeight()) <= 0 or int(badge.getHeight()) <= 0:
                    return
                desired_x = float(card.getRight() + AndroidUtilities.dp(10))
                max_x = float(row.getWidth() - row.getPaddingRight() - badge.getWidth())
                if max_x < desired_x:
                    desired_x = max(float(row.getPaddingLeft()), max_x)
                desired_y = float(card.getTop() + target.getTop()) + (float(target.getHeight() - badge.getHeight()) / 2.0)
                badge.setTranslationX(desired_x - float(badge.getLeft()))
                badge.setTranslationY(desired_y - float(badge.getTop()))

            _align(pill_badge, pill_wrap)
            _align(share_badge, share_row)

        state["sync_badges"] = _sync_badges

        class _PreviewModeClick(dynamic_proxy(View.OnClickListener)):
            def __init__(self, kind: str):
                super().__init__()
                self.kind = kind

            def onClick(self, v):
                mode = state.get(f"{self.kind}_mode")
                if mode:
                    BulletinHelper.show_info(_t(f"mode_{self.kind}_{mode}"), fragment=get_last_fragment())

        pill_mode_click = _PreviewModeClick("pill")
        share_mode_click = _PreviewModeClick("share")
        pill_badge.setOnClickListener(pill_mode_click)
        share_badge.setOnClickListener(share_mode_click)

        layout_listener = None
        try:
            class _PreviewLayoutChange(dynamic_proxy(View.OnLayoutChangeListener)):
                def onLayoutChange(self, v, left, top, right, bottom, oldLeft, oldTop, oldRight, oldBottom):
                    _sync_badges()

            layout_listener = _PreviewLayoutChange()
            card.addOnLayoutChangeListener(layout_listener)
            row.addOnLayoutChangeListener(layout_listener)
        except Exception:
            layout_listener = None

        _apply_menu_preview_style(state)
        if len(_MENU_PREVIEW_REFS) > 8:
            _MENU_PREVIEW_REFS.clear()
        _MENU_PREVIEW_REFS[System.identityHashCode(row)] = (
            state,
            copy_click,
            share_click,
            pill_mode_click,
            share_mode_click,
            layout_listener,
        )
        return row

    def bind_view(view, item, divider, adapter, list_view):
        ref = _MENU_PREVIEW_REFS.get(System.identityHashCode(view))
        if ref is None:
            return
        _apply_menu_preview_style(ref[0])

    factory = SimpleSettingFactory(create_view, bind_view, is_clickable=False, is_shadow=True)
    _MENU_PREVIEW_FACTORY = factory
    return factory


# ======================= Рефлексия и вспомогательные утилиты =======================

def _as_bool(val, default=False) -> bool:
    if val is None:
        return default
    if isinstance(val, bool):
        return val
    if isinstance(val, (int, float)):
        return val != 0
    s = str(val).strip().lower()
    if s in ("true", "1", "yes", "on"):
        return True
    if s in ("false", "0", "no", "off", ""):
        return False
    return bool(val)


def _setting_bool(key: str, default: bool) -> bool:
    p = _ACTIVE_PLUGIN
    if p is None:
        return default
    try:
        return _as_bool(p.get_setting(key, default), default)
    except Exception:
        return default


def _find_declared_field(cls, name: str):
    key = (cls, name)
    if key in _FIELD_CACHE:
        return _FIELD_CACHE[key]
    cur = cls
    while cur is not None:
        try:
            f = cur.getDeclaredField(name)
            f.setAccessible(True)
            _FIELD_CACHE[key] = f
            return f
        except Exception:
            cur = cur.getSuperclass()
    _FIELD_CACHE[key] = None
    return None


def _jget(obj, name: str, default=None):
    if obj is None:
        return default
    try:
        f = _find_declared_field(obj.getClass(), name)
        if f is not None:
            return f.get(obj)
    except Exception:
        pass
    try:
        return getattr(obj, name)
    except Exception:
        return default


def _jset(obj, name: str, value) -> bool:
    if obj is None:
        return False
    try:
        f = _find_declared_field(obj.getClass(), name)
        if f is not None:
            f.set(obj, value)
            return True
    except Exception:
        pass
    return False


def _jint(obj, name: str, default: int = -1) -> int:
    v = _jget(obj, name, None)
    if v is None:
        return default
    try:
        return int(v)
    except Exception:
        return default


def _static_int(cls_name: str, field_name: str, default: Optional[int] = None) -> Optional[int]:
    try:
        cls = find_class(cls_name)
        if cls is None:
            return default
        f = _find_declared_field(cls, field_name)
        if f is None:
            return default
        return int(f.get(None))
    except Exception:
        return default


def _try_jclass(name: str):
    try:
        return jclass(name)
    except Exception:
        return None


def _res_drawable(*names: str) -> int:
    for n in names:
        if not n:
            continue
        try:
            v = getattr(TgR.drawable, n, None)
            if v is not None:
                return int(v)
        except Exception:
            pass
    return 0


def _res_string(name: str, fallback_text: str) -> str:
    try:
        res_id = getattr(TgR.string, name, None)
        if res_id is not None:
            s = LocaleController.getString(int(res_id))
            if s:
                return str(s)
    except Exception:
        pass
    return fallback_text


def _is_account_cell(item) -> bool:
    if item is None:
        return False
    try:
        cls = _try_jclass("org.telegram.ui.SettingsActivity$AccountCell$Factory")
        if cls is not None and item.instanceOf(cls):
            return True
    except Exception:
        pass
    return False


def _is_search_cell(item) -> bool:
    if item is None:
        return False
    try:
        cls = _try_jclass("org.telegram.ui.SettingsActivity$SettingsSearchCell$Factory")
        if cls is not None and item.instanceOf(cls):
            return True
    except Exception:
        pass
    return False


# ======================= Всплывающее меню (стиль exteraGram SettingsRowMenu) =======================

def _copy_link(fragment, link: str):
    try:
        AndroidUtilities.addToClipboard(link)
    except Exception:
        pass
    try:
        if fragment is not None:
            bf = BulletinFactory.of(fragment)
            if _lang() == _detect_client_lang():
                bf.createCopyLinkBulletin().show()
            else:
                copy_raw = getattr(TgR.raw, "copy", 0)
                if copy_raw:
                    bf.createSimpleBulletin(int(copy_raw), _t("copied")).show()
                else:
                    BulletinHelper.show_info(_t("copied"), fragment=fragment)
            return
    except Exception:
        pass
    BulletinHelper.show_info(_t("copied"))


def _share_link(fragment, anchor_view, link: str):
    ctx = None
    try:
        if fragment is not None:
            ctx = fragment.getParentActivity() or fragment.getContext()
    except Exception:
        pass
    if ctx is None and anchor_view is not None:
        try:
            ctx = anchor_view.getContext()
        except Exception:
            pass

    if ctx is not None:
        try:
            alert = ShareAlert.createShareAlert(ctx, None, link, False, link, False)
            if fragment is not None:
                fragment.showDialog(alert)
            else:
                alert.show()
            return
        except Exception:
            pass
        try:
            intent = Intent(Intent.ACTION_SEND)
            intent.setType("text/plain")
            intent.putExtra(Intent.EXTRA_TEXT, link)
            ctx.startActivity(Intent.createChooser(intent, _t("share_link")))
            return
        except Exception:
            pass
    _copy_link(fragment, link)


def _build_url_preview_view(context, link: str, fragment, options):
    wrap = LinearLayout(context)
    wrap.setOrientation(LinearLayout.VERTICAL)
    wrap.setPadding(
        AndroidUtilities.dp(10),
        AndroidUtilities.dp(8),
        AndroidUtilities.dp(10),
        AndroidUtilities.dp(4),
    )

    dark = _is_dark_theme()
    try:
        link_color = int(Theme.getColor(Theme.key_windowBackgroundWhiteBlueText4))
    except Exception:
        link_color = _argb(0xFF4EA4F6 if dark else 0xFF168ACD)

    pill = LinearLayout(context)
    pill.setOrientation(LinearLayout.HORIZONTAL)
    pill.setGravity(Gravity.CENTER_VERTICAL)
    pill.setPadding(
        AndroidUtilities.dp(10),
        AndroidUtilities.dp(7),
        AndroidUtilities.dp(10),
        AndroidUtilities.dp(7),
    )

    gd = GradientDrawable()
    gd.setCornerRadius(float(AndroidUtilities.dp(9)))
    try:
        gd.setColor(Theme.multAlpha(link_color, 0.12 if dark else 0.09))
        gd.setStroke(max(1, AndroidUtilities.dp(1)), Theme.multAlpha(link_color, 0.22 if dark else 0.16))
    except Exception:
        gd.setColor(_argb(0x18FFFFFF if dark else 0x0E000000))
        gd.setStroke(max(1, AndroidUtilities.dp(1)), _argb(0x18FFFFFF if dark else 0x12000000))
    pill.setBackground(gd)

    try:
        sel = Theme.createRadSelectorDrawable(Theme.getColor(Theme.key_listSelector), 9, 9)
        if sel is not None and hasattr(pill, "setForeground"):
            pill.setForeground(sel)
    except Exception:
        pass

    icon_res = _res_drawable("msg_link2", "msg_link")
    if icon_res != 0:
        iv = ImageView(context)
        iv.setImageResource(icon_res)
        try:
            iv.setColorFilter(link_color, PorterDuff.Mode.SRC_IN)
        except Exception:
            pass
        iv_lp = LinearLayout.LayoutParams(AndroidUtilities.dp(15), AndroidUtilities.dp(15))
        iv_lp.rightMargin = AndroidUtilities.dp(7)
        pill.addView(iv, iv_lp)

    tv = TextView(context)
    tv.setText(link)
    tv.setTextSize(1, 12.5)
    tv.setTextColor(link_color)
    tv.setMaxLines(2)
    tv.setEllipsize(TextUtils.TruncateAt.MIDDLE)
    tv.setMaxWidth(AndroidUtilities.dp(244))
    try:
        tv.setTypeface(AndroidUtilities.getTypeface("fonts/rmono.ttf"))
    except Exception:
        try:
            tv.setTypeface(Typeface.MONOSPACE)
        except Exception:
            pass
    pill.addView(tv, LinearLayout.LayoutParams(-2, -2))

    class _PillClick(dynamic_proxy(View.OnClickListener)):
        def onClick(self, v):
            _copy_link(fragment, link)
            try:
                options.dismiss()
            except Exception:
                pass

    pill_click = _PillClick()
    if len(_PILL_CLICK_REFS) > 32:
        _PILL_CLICK_REFS.clear()
    _PILL_CLICK_REFS[System.identityHashCode(pill)] = pill_click
    pill.setOnClickListener(pill_click)
    wrap.addView(pill, LinearLayout.LayoutParams(-1, -2))
    return wrap


def _show_settings_row_menu(
    fragment,
    row,
    list_view,
    link: str,
    force_url_preview: Optional[bool] = None,
    show_share: Optional[bool] = None,
):
    global _IN_OWN_MENU
    if fragment is None or row is None or not link:
        return False
    prev_guard = _IN_OWN_MENU
    _IN_OWN_MENU = True
    try:
        options = ItemOptions.makeOptions(fragment, row)
        if list_view is not None:
            try:
                bg = list_view.getClipBackground(row)
                if bg is not None:
                    options.setScrimViewBackground(bg)
            except Exception:
                pass

        use_preview = (
            _setting_bool(KEY_SHOW_URL_PREVIEW, False)
            if force_url_preview is None
            else bool(force_url_preview)
        )
        if use_preview:
            try:
                ctx = options.getContext() or row.getContext()
                if ctx is not None:
                    options.addView(_build_url_preview_view(ctx, link, fragment, options))
            except Exception:
                try:
                    options.addText(link, 13, AndroidUtilities.dp(280))
                except Exception:
                    pass

        copy_icon = _res_drawable("msg_copy", "msg_copy_solar")
        copy_label = _t("copy_link")
        options.add(copy_icon, copy_label, Runnable(lambda: _copy_link(fragment, link)))

        use_share = (
            _setting_bool(KEY_SHOW_SHARE, True)
            if show_share is None
            else bool(show_share)
        )
        if use_share:
            share_icon = _res_drawable("msg_share", "msg_forward")
            share_label = _t("share_link")
            options.add(share_icon, share_label, Runnable(lambda: _share_link(fragment, row, link)))

        options.show()
        return True
    except Exception as e:
        if _ACTIVE_PLUGIN is not None:
            try:
                _ACTIVE_PLUGIN.log(f"_show_settings_row_menu failed: {e}")
            except Exception:
                pass
        return False
    finally:
        _IN_OWN_MENU = prev_guard


