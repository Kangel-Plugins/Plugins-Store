import base64
import zlib
from base_plugin import BasePlugin
from java import jclass
from org.telegram.messenger import ApplicationLoader, LocaleController
from ui.settings import Divider, Header, Selector, Switch

def is_english():
    try:
        lang = str(LocaleController.getLocaleStringIso639() or "").lower()
        if lang:
            return not (lang.startswith("ru") or lang.startswith("uk") or lang.startswith("be"))
    except Exception:
        pass
    try:
        Locale = jclass("java.util.Locale")
        lang = str(Locale.getDefault().getLanguage() or "").lower()
        return not (lang.startswith("ru") or lang.startswith("uk") or lang.startswith("be"))
    except Exception:
        return False

def tr(ru, en):
    return en if is_english() else ru

__id__ = "camera_enhancer"
__name__ = "RVCE"
__description__ = "Round videos camera enhancer. Round Configurator"
__author__ = "@dekma0091 && @DefinitelyNotDekma"
__version__ = "2.0"
__icon__ = "pixelcamera/17"

ENTRY_CLASS = "ni.dekma.rvce.RvceBridge"
BuildVersion = jclass("android.os.Build$VERSION")
_DEX_PAYLOAD = ""

class NativeBridge:
    def __init__(self, entry_class):
        self.entry_class = entry_class
        self.clazz = None
        self.loaded = False

    def load(self):
        if self.loaded:
            return
        if self.clazz is None:
            context = ApplicationLoader.applicationContext
            if context is None:
                raise RuntimeError("application context is not ready")
            if int(BuildVersion.SDK_INT) < 26:
                raise RuntimeError("embedded DEX requires Android API 26+")
            raw_bytes = base64.b64decode(_DEX_PAYLOAD)
            try:
                payload = zlib.decompress(raw_bytes)
            except Exception:
                payload = raw_bytes
            ByteBuffer = jclass("java.nio.ByteBuffer")
            InMemoryDexClassLoader = jclass("dalvik.system.InMemoryDexClassLoader")
            loader = InMemoryDexClassLoader(ByteBuffer.wrap(payload), context.getClassLoader())
            self.clazz = loader.loadClass(self.entry_class)
        try:
            self._invoke("load")
            self.loaded = True
        except Exception:
            try:
                self._invoke("unload")
            except Exception:
                pass
            self.loaded = False
            raise

    def unload(self):
        if self.clazz is None or not self.loaded:
            return
        try:
            self._invoke("unload")
        finally:
            self.loaded = False

    def update_config(self, enabled, resolution, bitrate_v, bitrate_a, double_tap, hevc, lock_fps, smooth_switch, front_wide):
        if self.clazz is None or not self.loaded:
            return
        self._invoke("updateConfig", bool(enabled), int(resolution), int(bitrate_v), int(bitrate_a), bool(double_tap), bool(hevc), bool(lock_fps), bool(smooth_switch), bool(front_wide))

    def _invoke(self, method_name, *args):
        if self.clazz is None:
            raise RuntimeError("DEX class is not loaded")
        for method in self.clazz.getDeclaredMethods():
            if str(method.getName()) == method_name and len(method.getParameterTypes()) == len(args):
                method.setAccessible(True)
                converted_args = []
                param_types = method.getParameterTypes()
                IntegerClass = jclass("java.lang.Integer")
                LongClass = jclass("java.lang.Long")
                BooleanClass = jclass("java.lang.Boolean")
                for i, arg in enumerate(args):
                    pt = str(param_types[i].getName())
                    if pt in ("int", "java.lang.Integer"):
                        converted_args.append(IntegerClass.valueOf(int(arg)))
                    elif pt in ("long", "java.lang.Long"):
                        converted_args.append(LongClass.valueOf(int(arg)))
                    elif pt in ("boolean", "java.lang.Boolean"):
                        converted_args.append(BooleanClass.valueOf(bool(arg)))
                    else:
                        converted_args.append(arg)
                return method.invoke(None, *converted_args)
        raise RuntimeError(f"method not found: {method_name}/{len(args)}")

class AdvancedCameraPlugin(BasePlugin):
    CONFIG_RESOLUTIONS = [384, 480, 512, 640]
    CONFIG_BITRATES_VIDEO = [1000, 1400, 1600, 1800, 2000, 2300]
    CONFIG_BITRATES_AUDIO = [64, 96, 128, 160, 192, 256, 320]

    def __init__(self):
        super().__init__()
        self.bridge = NativeBridge(ENTRY_CLASS)

    def on_plugin_load(self):
        self.bridge.load()
        try:
            ExteraConfig = jclass("com.exteragram.messenger.ExteraConfig")
            if bool(ExteraConfig.getExtendedFramesPerSecond()):
                self.set_setting("lock_fps_30", False)
        except Exception:
            pass
        self._sync_config()

    def on_plugin_unload(self):
        self.bridge.unload()

    def on_settings_changed(self, *args):
        self._sync_config()

    def set_setting(self, key, value, reload_settings=False):
        super().set_setting(key, value, reload_settings)
        self._sync_config()

    def _make_on_change(self, key):
        def _cb(*args):
            if args:
                try:
                    self.set_setting(key, args[0])
                except Exception:
                    pass
        return _cb

    def _make_lock_fps_change(self):
        def _cb(*args):
            try:
                self.set_setting("lock_fps_30", False, reload_settings=True)
            except Exception:
                pass
        return _cb

    def _sync_config(self):
        enabled = self.get_setting("enable_round_config", True)
        res_idx = int(self.get_setting("resolution", 3))
        if res_idx < 0 or res_idx >= len(self.CONFIG_RESOLUTIONS):
            res_idx = 3
        res = self.CONFIG_RESOLUTIONS[res_idx]

        bv_idx = int(self.get_setting("bitrate_video", 3))
        if bv_idx < 0 or bv_idx >= len(self.CONFIG_BITRATES_VIDEO):
            bv_idx = 3
        bitrate_v = self.CONFIG_BITRATES_VIDEO[bv_idx]

        ba_idx = int(self.get_setting("bitrate_audio", 4))
        if ba_idx < 0 or ba_idx >= len(self.CONFIG_BITRATES_AUDIO):
            ba_idx = 4
        bitrate_a = self.CONFIG_BITRATES_AUDIO[ba_idx]

        extended_fps = False
        try:
            ExteraConfig = jclass("com.exteragram.messenger.ExteraConfig")
            extended_fps = bool(ExteraConfig.getExtendedFramesPerSecond())
        except Exception:
            pass

        double_tap = self.get_setting("enable_double_tap_switch", True)
        hevc = self.get_setting("enable_hevc", True)
        lock_fps = False if extended_fps else self.get_setting("lock_fps_30", True)
        smooth_switch = self.get_setting("enable_smooth_switch", True)
        front_wide = self.get_setting("enable_front_wide_angle", True)
        self.bridge.update_config(enabled, res, bitrate_v, bitrate_a, double_tap, hevc, lock_fps, smooth_switch, front_wide)

    def create_settings(self):
        extended_fps = False
        try:
            ExteraConfig = jclass("com.exteragram.messenger.ExteraConfig")
            extended_fps = bool(ExteraConfig.getExtendedFramesPerSecond())
        except Exception:
            pass

        items = [
            Header(text=tr("Качество и кодеки", "Quality and Codecs")),
            Switch(
                key="enable_round_config",
                text=tr("Кастомное разрешение и битрейт", "Custom Resolution & Bitrate"),
                subtext=tr("Применяет выбранные параметры видеопотока", "Applies custom video stream parameters"),
                default=True,
                icon="msg_settings",
                on_change=self._make_on_change("enable_round_config")
            ),
            Switch(
                key="enable_hevc",
                text=tr("Кодек HEVC (H.265)", "HEVC (H.265) Codec"),
                subtext=tr("Высокоэффективный кодек", "High-efficiency video codec"),
                default=True,
                icon="msg_media",
                on_change=self._make_on_change("enable_hevc")
            ),
        ]

        is_lock_fps = False if extended_fps else self.get_setting("lock_fps_30", True)
        if extended_fps:
            items.extend([
                Switch(
                    key="lock_fps_30",
                    text=tr("Лок фреймрейта (недоступно)", "Lock Framerate (Unavailable)"),
                    subtext=tr("Конфликт: включен расширенный диапазон FPS в настройках клиента", "Conflict: Extended FPS range is enabled in client settings"),
                    default=is_lock_fps,
                    icon="msg_speed",
                    on_change=self._make_lock_fps_change()
                ),
                Divider(text=tr("Настройка «Лок фреймрейта» недоступна, пока в настройках клиента включен «Расширенный диапазон FPS»", "Lock Framerate is unavailable while Extended FPS range is enabled in client settings")),
            ])
        else:
            items.append(
                Switch(
                    key="lock_fps_30",
                    text=tr("Лок фреймрейта", "Lock Framerate"),
                    subtext=tr("Стабильный фреймрейт без рывков", "Stable frame rate without jitter"),
                    default=is_lock_fps,
                    icon="msg_speed",
                    on_change=self._make_on_change("lock_fps_30")
                )
            )

        items.extend([
            Selector(
                key="resolution",
                text=tr("Разрешение", "Resolution"),
                items=[f"{r}x{r} px" for r in self.CONFIG_RESOLUTIONS],
                default=3,
                icon="msg_photos",
                on_change=self._make_on_change("resolution")
            ),
            Selector(
                key="bitrate_video",
                text=tr("Битрейт видео", "Video Bitrate"),
                items=[f"{b} " + tr("кбит/с", "kbps") for b in self.CONFIG_BITRATES_VIDEO],
                default=3,
                icon="msg_video",
                on_change=self._make_on_change("bitrate_video")
            ),
            Selector(
                key="bitrate_audio",
                text=tr("Битрейт аудио", "Audio Bitrate"),
                items=[f"{b} " + tr("кбит/с", "kbps") for b in self.CONFIG_BITRATES_AUDIO],
                default=4,
                icon="msg_voicechat",
                on_change=self._make_on_change("bitrate_audio")
            ),
            Header(text=tr("Управление камерой", "Camera Controls")),
            Switch(
                key="enable_front_wide_angle",
                text=tr("Широкий угол на фронталке", "Front Camera Wide Angle"),
                subtext=tr("Старт с максимального угла обзора", "Start with maximum field of view"),
                default=True,
                icon="msg_zoomout",
                on_change=self._make_on_change("enable_front_wide_angle")
            ),
            Switch(
                key="enable_double_tap_switch",
                text=tr("Смена камеры двойным тапом", "Double Tap Camera Switch"),
                subtext=tr("Быстрое переключение по видоискателю", "Quick switch on viewfinder"),
                default=True,
                icon="msg_retry",
                on_change=self._make_on_change("enable_double_tap_switch")
            ),
            Switch(
                key="enable_smooth_switch",
                text=tr("Бесшовный кроссфейд", "Seamless Crossfade"),
                subtext=tr("Плавное переключение камер (фронт/основа)", "Smooth transition between front and back cameras"),
                default=True,
                icon="msg_theme",
                on_change=self._make_on_change("enable_smooth_switch")
            ),
        ])
        return items

plugin = AdvancedCameraPlugin()
