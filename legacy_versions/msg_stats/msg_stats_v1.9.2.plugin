def _lang() -> str:
    code = ""
    try:
        from org.telegram.messenger import LocaleController
        code = str(LocaleController.getInstance().getCurrentLocale().getLanguage())
    except Exception:
        try:
            from java.util import Locale
            code = str(Locale.getDefault().getLanguage())
        except Exception:
            code = ""
    return "ru" if code.lower() in ("ru", "uk", "be", "kk") else "en"


def _t(key: str, *args: Any) -> str:
    text = STRINGS[_lang()].get(key) or STRINGS["en"][key]
    return text.format(*args) if args else text


def _months() -> List[str]:
    return _t("months").split("|")


def _weekdays() -> List[str]:
    return _t("weekdays").split("|")


def _title_text(title: str) -> str:
    title = str(title)
    if title in ("@saved", "Избранное", "Saved Messages"):
        return _t("saved")
    if title in ("@deleted", "Удалённый аккаунт", "Deleted account"):
        return _t("deleted")
    if title.startswith("@chat:"):
        return f"{_t('chat')} {title[6:]}"
    if title.startswith("Чат ") and title[4:].lstrip("-").isdigit():
        return f"{_t('chat')} {title[4:]}"
    return title


class _Transient(RuntimeError):
    pass


def _jlist(obj: Any) -> List[Any]:
    if obj is None:
        return []
    try:
        return list(obj)
    except TypeError:
        pass
    try:
        return [obj.get(i) for i in range(int(obj.size()))]
    except Exception:
        pass
    try:
        it = obj.iterator()
        out = []
        while it.hasNext():
            out.append(it.next())
        return out
    except Exception:
        return []


def _norm_dialog(dialog: Any) -> int:
    value = int(dialog)
    sign = -1 if value < 0 else 1
    value = abs(value)
    if value > 1000000000000:
        value -= 1000000000000
    return sign * value


def _argb(color: Any, alpha: int = 255) -> int:
    if isinstance(color, str):
        rgb = int(color.lstrip("#"), 16) & 0xFFFFFF
    else:
        rgb = int(color) & 0xFFFFFF
    value = ((int(alpha) & 0xFF) << 24) | rgb
    return value - (1 << 32) if value >= (1 << 31) else value


def _tint(color: Any, amount: float) -> int:
    base = _argb(color) & 0xFFFFFF
    r, g, b = (base >> 16) & 255, (base >> 8) & 255, base & 255
    r, g, b = (int(c + (255 - c) * amount) for c in (r, g, b))
    return _argb((r << 16) | (g << 8) | b)


def _blend(base: Any, over: Any, amount: float) -> int:
    a, b = _argb(base) & 0xFFFFFF, _argb(over) & 0xFFFFFF
    parts = []
    for shift in (16, 8, 0):
        x, y = (a >> shift) & 255, (b >> shift) & 255
        parts.append(int(x + (y - x) * amount))
    return _argb((parts[0] << 16) | (parts[1] << 8) | parts[2])


def _ji(value: int) -> Any:
    try:
        from java import jint
        return jint(int(value))
    except Exception:
        return int(value)


def _class_name(obj: Any) -> str:
    try:
        return str(obj.getClass().getSimpleName())
    except Exception:
        return type(obj).__name__


def _is_secret(dialog: int) -> bool:
    return abs(int(dialog)) >= (1 << 60)


def _tz_offset(ts: float = None) -> int:
    moment = ts if ts is not None else _time.time()
    try:
        from java.util import TimeZone
        return int(TimeZone.getDefault().getOffset(int(moment * 1000)) // 1000)
    except Exception:
        pass
    local = _time.localtime(moment)
    return -int(_time.altzone if local.tm_isdst > 0 and _time.daylight else _time.timezone)


def _fmt_num(value: int) -> str:
    return f"{int(value):,}".replace(",", " ")


def _compact(value: int) -> str:
    value = int(value)
    if value >= 1000000:
        return f"{value / 1000000:.1f}".rstrip("0").rstrip(".") + "M"
    if value >= 1000:
        return f"{value / 1000:.1f}".rstrip("0").rstrip(".") + "k"
    return str(value)


def _short(text: str, limit: int) -> str:
    text = " ".join(str(text).split())
    return text if len(text) <= limit else text[:limit - 1] + "…"


def _local_midnight(now: int, off: int) -> int:
    return ((now + off) // DAY) * DAY - off


def _range_bounds(key: str, now: int, off: int, first_hour: int) -> Tuple[int, int]:
    midnight = _local_midnight(now, off)
    if key == "today":
        return midnight, now
    if key == "24h":
        return now - DAY, now
    if key == "week":
        return midnight - 6 * DAY, now
    if key == "month":
        return midnight - 29 * DAY, now
    if first_hour:
        return _local_midnight(first_hour * HOUR, off), now
    return midnight, now


def _day_label(day: int) -> Tuple[str, str]:
    t = _time.gmtime(day * DAY)
    return f"{t.tm_mday:02d}.{t.tm_mon:02d}", f"{t.tm_mday} {_months()[t.tm_mon - 1]}"


def _series(key: str, hours: Dict[int, int], start: int, end: int, off: int) -> List[Tuple[str, int, str]]:
    out: List[Tuple[str, int, str]] = []
    if key in ("today", "24h"):
        for h in range(start // HOUR, end // HOUR + 1):
            hh = ((h * HOUR + off) // HOUR) % 24
            out.append((f"{hh:02d}", hours.get(h, 0), f"{hh:02d}:00"))
        return out
    per_day: Dict[int, int] = {}
    for h, n in hours.items():
        d = (h * HOUR + off) // DAY
        per_day[d] = per_day.get(d, 0) + n
    first = (start + off) // DAY
    last = (end + off) // DAY
    if key in ("week", "month") or last - first + 1 <= 62:
        for d in range(first, last + 1):
            short, long = _day_label(d)
            out.append((short, per_day.get(d, 0), long))
        return out
    months: "OrderedDict[Tuple[int, int], int]" = OrderedDict()
    for d in range(first, last + 1):
        t = _time.gmtime(d * DAY)
        ym = (t.tm_year, t.tm_mon)
        months[ym] = months.get(ym, 0) + per_day.get(d, 0)
    for (y, m), n in months.items():
        out.append((f"{_months()[m - 1]} {y % 100:02d}", n, f"{_months()[m - 1]} {y}"))
    return out


def _label_steps(n: int, limit: int = 6) -> int:
    return max(1, int(math.ceil(n / float(limit))))


class _Draw:

    def __init__(self, width: int, height: int, density: float, text: int, muted: int,
                 accent: Any = None):
        from android.graphics import Bitmap, Canvas, Paint
        self.w = int(width)
        self.h = int(height)
        self.density = float(density)
        self.bmp = Bitmap.createBitmap(self.w, self.h, Bitmap.Config.ARGB_8888)
        self.cv = Canvas(self.bmp)
        self.paint = Paint(Paint.ANTI_ALIAS_FLAG)
        self.text_color = text
        self.muted_color = muted
        self.accent = _argb(accent if accent is not None else ACCENT)
        self.palette = [self.accent, _tint(self.accent, 0.45)] + PALETTE[2:]

    def dp(self, value: float) -> float:
        return value * self.density

    def rgba(self, color: Any, alpha: int = 255) -> int:
        return _argb(color, alpha)

    def _fill(self, color: Any, alpha: int):
        from android.graphics import Paint
        self.paint.setStyle(Paint.Style.FILL)
        self.paint.setColor(_ji(self.rgba(color, alpha)))

    def rrect(self, l: float, t: float, r: float, b: float, radius: float, color: Any, alpha: int = 255):
        from android.graphics import RectF
        self._fill(color, alpha)
        self.cv.drawRoundRect(RectF(float(l), float(t), float(r), float(b)),
                              float(radius), float(radius), self.paint)

    def stroke_rrect(self, l: float, t: float, r: float, b: float, radius: float, color: Any,
                     width: float, alpha: int = 255):
        from android.graphics import Paint, RectF
        self.paint.setStyle(Paint.Style.STROKE)
        self.paint.setStrokeWidth(float(width))
        self.paint.setColor(_ji(self.rgba(color, alpha)))
        self.cv.drawRoundRect(RectF(float(l), float(t), float(r), float(b)), float(radius), float(radius),
                              self.paint)

    def circle(self, cx: float, cy: float, radius: float, color: Any, alpha: int = 255):
        self._fill(color, alpha)
        self.cv.drawCircle(float(cx), float(cy), float(radius), self.paint)

    def line(self, x1: float, y1: float, x2: float, y2: float, color: Any, width: float = 1.0,
             alpha: int = 255):
        from android.graphics import Paint
        self.paint.setStyle(Paint.Style.STROKE)
        self.paint.setStrokeWidth(float(width))
        self.paint.setColor(_ji(self.rgba(color, alpha)))
        self.cv.drawLine(float(x1), float(y1), float(x2), float(y2), self.paint)

    def arc(self, cx: float, cy: float, radius: float, start: float, sweep: float, color: Any,
            width: float):
        from android.graphics import Paint, RectF
        self.paint.setStyle(Paint.Style.STROKE)
        self.paint.setStrokeWidth(float(width))
        self.paint.setColor(_ji(self.rgba(color)))
        self.cv.drawArc(RectF(float(cx - radius), float(cy - radius), float(cx + radius),
                              float(cy + radius)), float(start), float(sweep), False, self.paint)

    def text(self, value: str, x: float, y: float, size_dp: float, color: Any = None,
             align: str = "l", bold: bool = False, alpha: int = 255):
        from android.graphics import Paint, Typeface
        self._fill(self.text_color if color is None else color, alpha)
        self.paint.setTextSize(float(self.dp(size_dp)))
        self.paint.setTypeface(Typeface.DEFAULT_BOLD if bold else Typeface.DEFAULT)
        self.paint.setTextAlign({"l": Paint.Align.LEFT, "c": Paint.Align.CENTER,
                                 "r": Paint.Align.RIGHT}[align])
        self.cv.drawText(str(value), float(x), float(y), self.paint)

    def width_of(self, value: str, size_dp: float, bold: bool = False) -> float:
        from android.graphics import Typeface
        self.paint.setTextSize(float(self.dp(size_dp)))
        self.paint.setTypeface(Typeface.DEFAULT_BOLD if bold else Typeface.DEFAULT)
        return float(self.paint.measureText(str(value)))

    def fit(self, value: str, size_dp: float, max_width: float) -> str:
        value = str(value)
        if self.width_of(value, size_dp) <= max_width:
            return value
        while len(value) > 1 and self.width_of(value + "…", size_dp) > max_width:
            value = value[:-1]
        return value.rstrip() + "…"


def _draw_icon(d: Any, kind: str, color: Any, alpha: int = 255):
    size = float(d.w)
    stroke = d.dp(2)
    if kind == "overview":
        widths = size * 0.17
        gap = size * 0.09
        left = (size - 3 * widths - 2 * gap) / 2
        for i, h in enumerate((0.38, 0.62, 0.86)):
            x = left + i * (widths + gap)
            d.rrect(x, size * 0.92 - size * h, x + widths, size * 0.92, widths / 2, color, alpha)
    elif kind == "chats":
        d.stroke_rrect(size * 0.12, size * 0.14, size * 0.88, size * 0.70, size * 0.2, color, stroke, alpha)
        d.line(size * 0.30, size * 0.68, size * 0.22, size * 0.90, color, stroke, alpha)
        d.line(size * 0.22, size * 0.90, size * 0.46, size * 0.72, color, stroke, alpha)
    else:
        cx = cy = size / 2
        d.arc(cx, cy, size * 0.27, 0, 359.9, color, stroke)
        d.circle(cx, cy, size * 0.09, color, alpha)
        for i in range(8):
            angle = math.radians(45 * i)
            d.line(cx + math.cos(angle) * size * 0.33, cy + math.sin(angle) * size * 0.33,
                   cx + math.cos(angle) * size * 0.43, cy + math.sin(angle) * size * 0.43,
                   color, stroke * 1.4, alpha)


def _draw_bars(d: Any, series: List[Tuple[str, int, str]]):
    top, bottom, pad = d.dp(22), d.dp(22), d.dp(4)
    n = max(1, len(series))
    vmax = max([v for _, v, _ in series] + [1])
    area_w = d.w - 2 * pad
    area_h = d.h - top - bottom
    gap = d.dp(2) if n > 1 else 0.0
    bw = max(1.0, (area_w - gap * (n - 1)) / n)
    base = d.h - bottom
    d.line(pad, base, d.w - pad, base, d.muted_color, 1.0, 60)
    peak_at = max(range(len(series)), key=lambda i: series[i][1]) if series else 0
    for i, (_, value, _) in enumerate(series):
        x = pad + i * (bw + gap)
        if value <= 0:
            d.rrect(x, base - d.dp(2), x + bw, base, min(bw / 2, d.dp(1)), d.muted_color, 70)
            continue
        h = max(d.dp(3), area_h * value / vmax)
        shade = d.accent if i == peak_at else d.palette[1]
        d.rrect(x, base - h, x + bw, base, min(bw / 2, d.dp(5)), shade)
    step = _label_steps(len(series))
    for i in range(0, len(series), step):
        x = pad + i * (bw + gap) + bw / 2
        align = "l" if i == 0 else "c"
        d.text(series[i][0], x - (bw / 2 if i == 0 else 0), d.h - d.dp(6), 11, d.muted_color, align)
    dash = d.dp(4)
    x = pad
    while x < d.w - pad:
        d.line(x, top, min(x + dash, d.w - pad), top, d.muted_color, 1.0, 55)
        x += dash * 2
    label = _t("max", _fmt_num(vmax))
    tag_h = d.dp(16)
    tag_w = d.width_of(label, 10.5) + d.dp(14)
    tag_r = d.w - pad
    tag_t = d.dp(2)
    d.rrect(tag_r - tag_w, tag_t, tag_r, tag_t + tag_h, tag_h / 2.0, d.muted_color, 40)
    d.text(label, tag_r - tag_w / 2.0, tag_t + tag_h / 2.0 + d.dp(3.6), 10.5, d.muted_color, "c")


def _draw_donut(d: Any, parts: List[Tuple[str, int, str]]):
    total = sum(v for _, v, _ in parts)
    cx, cy = d.h / 2.0, d.h / 2.0
    radius = d.h * 0.34
    stroke = d.h * 0.15
    if total <= 0:
        d.arc(cx, cy, radius, 0, 359.9, d.muted_color, stroke)
        d.text(_t("nodata"), cx, cy + d.dp(4), 12, d.muted_color, "c")
        return
    angle = -90.0
    for _, value, color in parts:
        sweep = 360.0 * value / total
        d.arc(cx, cy, radius, angle, max(sweep - 2.0, 0.5), color, stroke)
        angle += sweep
    inner = 2.0 * (radius - stroke / 2.0) * 0.9
    label = _fmt_num(total)
    size = 20.0
    while size > 10.0 and d.width_of(label, size, True) > inner:
        size -= 1.0
    if d.width_of(label, size, True) > inner:
        label = _compact(total)
    d.text(label, cx, cy + d.dp(2), size, None, "c", True)
    d.text(_t("messages"), cx, cy + d.dp(18), 11, d.muted_color, "c")
    x = d.h + d.dp(8)
    row = d.dp(26)
    y0 = max(d.dp(16), (d.h - row * len(parts)) / 2.0 + d.dp(14))
    for i, (label, value, color) in enumerate(parts):
        y = y0 + i * row
        d.circle(x + d.dp(5), y - d.dp(4), d.dp(5), color)
        d.text(label, x + d.dp(16), y, 13)
        d.text(f"{_fmt_num(value)}  {int(round(100.0 * value / total))}%", d.w - d.dp(4), y, 13,
               d.muted_color, "r")


def _draw_top(d: Any, rows: List[Tuple[str, int]]):
    vmax = max([v for _, v in rows] + [1])
    row = d.dp(36)
    pad = d.dp(4)
    for i, (title, value) in enumerate(rows):
        y = i * row
        num = _fmt_num(value)
        num_w = d.width_of(num, 13) + d.dp(8)
        d.text(d.fit(title, 13, d.w - 2 * pad - num_w), pad, y + d.dp(15), 13)
        d.text(num, d.w - pad, y + d.dp(15), 13, d.muted_color, "r")
        track_t = y + d.dp(22)
        d.rrect(pad, track_t, d.w - pad, track_t + d.dp(6), d.dp(3), d.muted_color, 40)
        if value > 0:
            fill = max(d.dp(6), (d.w - 2 * pad) * value / vmax)
            d.rrect(pad, track_t, pad + fill, track_t + d.dp(6), d.dp(3), d.palette[i % 2] if i else d.accent)


def _draw_heat(d: Any, matrix: List[List[int]]):
    label_w = d.dp(24)
    cell_w = (d.w - label_w - d.dp(4)) / 24.0
    cell_h = d.dp(18)
    vmax = max([max(r) for r in matrix] + [1])
    for wd in range(7):
        y = wd * cell_h
        d.text(_weekdays()[wd], d.dp(2), y + cell_h - d.dp(5), 11, d.muted_color)
        for hr in range(24):
            value = matrix[wd][hr]
            x = label_w + hr * cell_w
            if value <= 0:
                d.rrect(x + 1, y + 1, x + cell_w - 1, y + cell_h - 1, d.dp(3), d.muted_color, 30)
            else:
                alpha = 70 + int(185 * value / vmax)
                d.rrect(x + 1, y + 1, x + cell_w - 1, y + cell_h - 1, d.dp(3), d.accent, alpha)
    base = 7 * cell_h + d.dp(14)
    for hr in (0, 6, 12, 18, 23):
        d.text(str(hr), label_w + hr * cell_w + cell_w / 2, base, 11, d.muted_color, "c")


class StatsPlugin(BasePlugin):

    def on_plugin_load(self):
        self._lock = threading.RLock()
        self._io_lock = threading.Lock()
        self._main_total = 0
        self._bak_total = 0
        self._total = 0
        self._rev = 0
        self._reports: "OrderedDict[Any, Dict[str, Any]]" = OrderedDict()
        self._draws: "OrderedDict[Any, Any]" = OrderedDict()
        self._active = True
        self._dirty = False
        self._save_timer = None
        self._data: Dict[str, Any] = self._blank()
        self._seen: "OrderedDict[Tuple[int, int, int], bool]" = OrderedDict()
        self._meta_cache: Dict[Tuple[int, int], Tuple[str, str]] = {}
        self._observer = None
        self._observed: List[Tuple[int, int]] = []
        self._nc_ids: Dict[str, int] = {}
        self._bf: Dict[str, Any] = {}
        self._sheet = None
        self._state: Dict[str, Any] = {}
        self._peers: Dict[Tuple[int, int], Any] = {}
        self._load()
        self._register_menu()
        run_on_ui_thread(self._register_observers)
        self._top_status = ("s_top_none", "")
        self._hook_header()
        self._hook_tab_menu()
        run_on_ui_thread(self._top_existing)
        self._schedule_intro(0)
        log(f"[{__name__}] loaded")

    def _schedule_intro(self, attempt: int):
        if not self._active or self._data.get("intro"):
            return
        timer = threading.Timer(INTRO_DELAY, lambda: run_on_ui_thread(lambda: self._try_intro(attempt)))
        timer.daemon = True
        timer.start()

    def _try_intro(self, attempt: int):
        if not self._active or self._data.get("intro"):
            return
        try:
            activity = self._activity()
        except Exception:
            activity = None
        if activity is None:
            if attempt < INTRO_TRIES:
                self._schedule_intro(attempt + 1)
            return
        try:
            from org.telegram.messenger import UserConfig
            account = int(UserConfig.selectedAccount)
        except Exception:
            account = 0
        with self._lock:
            self._data["intro"] = 1
        self._mark_dirty()
        self._open_sheet(account)

    def on_plugin_unload(self):
        self._active = False
        run_on_ui_thread(self._unregister_observers)
        run_on_ui_thread(self._top_remove)
        for item_id in (MENU_DRAWER_ID, MENU_CHAT_ID):
            try:
                self.remove_menu_item(item_id)
            except Exception:
                pass
        self._flush()
        log(f"[{__name__}] unloaded")

    # Storage
    @staticmethod
    def _blank() -> Dict[str, Any]:
        return {"v": 1, "intro": 0, "since": {}, "live": {}, "hist": {}, "histinfo": {},
                "histstate": {}, "meta": {}}

    def _data_path(self) -> str:
        try:
            from org.telegram.messenger import ApplicationLoader
            base = str(ApplicationLoader.applicationContext.getFilesDir().getAbsolutePath())
            return os.path.join(base, DATA_FILE)
        except Exception:
            return ""

    @staticmethod
    def _total_of(data: Dict[str, Any]) -> int:
        total = 0
        try:
            for key in ("hist", "live"):
                for per_acc in data.get(key, {}).values():
                    for per in per_acc.values():
                        total += sum(int(n) for n in per.values())
        except Exception:
            return 0
        return total

    def _candidates(self) -> List[Tuple[str, str]]:
        out: List[Tuple[str, str]] = []
        path = self._data_path()
        for suffix in ("", ".bak", ".tmp"):
            if not path:
                break
            try:
                if os.path.exists(path + suffix):
                    with open(path + suffix, "r", encoding="utf-8") as fh:
                        out.append((suffix or "main", fh.read()))
            except Exception as e:
                log(f"[{__name__}] read {suffix} failed: {e}")
        raw = self.get_setting("data", "") or ""
        if raw:
            out.append(("settings", raw))
        return out

    def _keep_corrupt(self, label: str, raw: str):
        path = self._data_path()
        if not path or not raw:
            return
        try:
            with open(path + ".corrupt", "w", encoding="utf-8") as fh:
                fh.write(raw)
        except Exception as e:
            log(f"[{__name__}] keep corrupt failed: {e}")

    def _load(self):
        best, best_total, source = None, -1, ""
        totals: Dict[str, int] = {}
        for label, raw in self._candidates():
            try:
                data = json.loads(raw)
            except Exception:
                log(f"[{__name__}] {label} data is unreadable")
                self._keep_corrupt(label, raw)
                continue
            if not (isinstance(data, dict) and data.get("v") == 1):
                continue
            total = self._total_of(data)
            totals[label] = total
            if total > best_total:
                best, best_total, source = data, total, label
        self._main_total = totals.get("main", 0)
        self._bak_total = totals.get(".bak", 0)
        self._total = max(best_total, 0)
        if best is not None:
            for key, value in self._blank().items():
                best.setdefault(key, value)
            self._data = best
            log(f"[{__name__}] data loaded from {source}: {best_total} messages")

    def _mark_dirty(self):
        with self._lock:
            self._dirty = True
            if self._save_timer is None and self._active:
                delay = SAVE_DELAY_BUSY if self._bf.get("running") else SAVE_DELAY
                timer = threading.Timer(delay, self._flush)
                timer.daemon = True
                self._save_timer = timer
                timer.start()

    def _rotate(self, path: str):
        bak = path + ".bak"
        try:
            if os.path.exists(path) and self._main_total >= BACKUP_RATIO * self._bak_total:
                shutil.copyfile(path, bak)
                self._bak_total = self._main_total
        except Exception as e:
            log(f"[{__name__}] backup failed: {e}")

    def _wipe_backups(self):
        path = self._data_path()
        self._bak_total = 0
        for suffix in (".bak", ".tmp", ".corrupt"):
            try:
                if path and os.path.exists(path + suffix):
                    os.remove(path + suffix)
            except Exception as e:
                log(f"[{__name__}] wipe {suffix} failed: {e}")
        try:
            self.set_setting("data", "")
        except Exception:
            pass

    def _flush(self):
        with self._lock:
            self._save_timer = None
            if not self._dirty:
                return
            self._dirty = False
            raw = json.dumps(self._data, ensure_ascii=False, separators=(",", ":"))
            new_total = self._total
        path = self._data_path()
        with self._io_lock:
            try:
                if not path:
                    raise OSError("no path")
                tmp = path + ".tmp"
                with open(tmp, "w", encoding="utf-8") as fh:
                    fh.write(raw)
                self._rotate(path)
                os.replace(tmp, path)
                self._main_total = new_total
            except Exception as e:
                log(f"[{__name__}] file save failed: {e}")
                try:
                    self.set_setting("data", raw)
                except Exception as e2:
                    log(f"[{__name__}] settings save failed: {e2}")

    def _since(self, account: int) -> int:
        with self._lock:
            since = self._data["since"].setdefault(str(account), int(_time.time()))
        return int(since)

    # Counting
    def _count(self, account: int, dialog: int, mid: int, date: int):
        if not self._active or _is_secret(dialog) or int(dialog) == 0:
            return
        key = (account, dialog, mid)
        with self._lock:
            if key in self._seen:
                return
            if date < self._since(account):
                return
            self._seen[key] = True
            while len(self._seen) > SEEN_MAX:
                self._seen.popitem(last=False)
            live = self._data["live"].setdefault(str(account), {})
            per = live.setdefault(str(int(date) // HOUR), {})
            per[str(dialog)] = per.get(str(dialog), 0) + 1
            self._total += 1
            self._rev += 1
        self._remember(account, dialog)
        self._mark_dirty()

    def _on_notification(self, event: int, account: int, args: Any):
        try:
            if event == self._nc_ids.get("received"):
                items = _jlist(args)
                if len(items) < 7 or bool(items[6]):
                    return
                msg = items[2]
                if msg is None or not bool(msg.out) or getattr(msg, "action", None) is not None:
                    return
                self._count(account, _norm_dialog(items[3]), int(items[1]), int(msg.date))
            elif event == self._nc_ids.get("new"):
                items = _jlist(args)
                if len(items) < 3 or bool(items[2]):
                    return
                dialog = _norm_dialog(items[0])
                for mo in _jlist(items[1]):
                    owner = mo.messageOwner
                    if owner is None or not bool(owner.out) or getattr(owner, "action", None) is not None:
                        continue
                    mid = int(owner.id)
                    if mid <= 0:
                        continue
                    self._count(account, dialog, mid, int(owner.date))
        except Exception as e:
            log(f"[{__name__}] event failed: {e}")

    def _make_observer(self):
        from java import dynamic_proxy
        from org.telegram.messenger import NotificationCenter

        owner = self

        class Observer(dynamic_proxy(NotificationCenter.NotificationCenterDelegate)):

            def didReceivedNotification(self, id, account, args):
                owner._on_notification(int(id), int(account), args)

        return Observer()

    def _register_observers(self):
        try:
            from org.telegram.messenger import NotificationCenter, UserConfig
            wanted = {"received": "messageReceivedByServer", "new": "didReceiveNewMessages"}
            self._nc_ids = {}
            for name, const in wanted.items():
                self._nc_ids[name] = int(getattr(NotificationCenter, const))
            observer = self._make_observer()
            self._observer = observer
            for acc in range(int(UserConfig.MAX_ACCOUNT_COUNT)):
                try:
                    if not UserConfig.getInstance(acc).isClientActivated():
                        continue
                    self._since(acc)
                    center = get_notification_center(acc)
                    for ev in self._nc_ids.values():
                        center.addObserver(observer, ev)
                        self._observed.append((acc, ev))
                except Exception as e:
                    log(f"[{__name__}] observe account {acc} failed: {e}")
            self._mark_dirty()
        except Exception as e:
            log(f"[{__name__}] register observers failed: {e}")

    def _unregister_observers(self):
        for acc, ev in self._observed:
            try:
                get_notification_center(acc).removeObserver(self._observer, ev)
            except Exception:
                pass
        self._observed = []

    # Chats
    def _me(self, account: int) -> int:
        try:
            from org.telegram.messenger import UserConfig
            return int(UserConfig.getInstance(account).getClientUserId())
        except Exception:
            return 0

    @staticmethod
    def _user_info(user: Any, dialog: int, me: int) -> Tuple[str, str]:
        if dialog == me:
            return "@saved", "saved"
        if user is None:
            return f"@chat:{dialog}", "user"
        if bool(getattr(user, "deleted", False)):
            return "@deleted", "user"
        name = " ".join(x for x in (str(user.first_name or ""), str(user.last_name or "")) if x).strip()
        if not name:
            name = str(getattr(user, "username", "") or f"@chat:{dialog}")
        return name, "bot" if bool(getattr(user, "bot", False)) else "user"

    @staticmethod
    def _chat_info(chat: Any, dialog: int) -> Tuple[str, str]:
        if chat is None:
            return f"@chat:{dialog}", "group"
        channel = bool(getattr(chat, "broadcast", False)) or bool(getattr(chat, "monoforum", False))
        return str(chat.title or f"@chat:{dialog}"), "channel" if channel else "group"

    def _resolve(self, account: int, dialog: int) -> Tuple[str, str]:
        try:
            from java import jlong
            controller = get_messages_controller(account)
            if dialog > 0:
                return self._user_info(controller.getUser(jlong(dialog)), dialog, self._me(account))
            return self._chat_info(controller.getChat(jlong(-dialog)), dialog)
        except Exception as e:
            log(f"[{__name__}] resolve failed: {e}")
            return f"@chat:{dialog}", "group" if dialog < 0 else "user"

    def _remember(self, account: int, dialog: int):
        key = (account, dialog)
        with self._lock:
            known = key in self._meta_cache or str(dialog) in self._data["meta"].get(str(account), {})
        if known:
            return
        title, kind = self._resolve(account, dialog)
        with self._lock:
            self._meta_cache[key] = (title, kind)
            self._data["meta"].setdefault(str(account), {})[str(dialog)] = [title, kind]
        self._mark_dirty()

    def _meta(self, account: int, dialog: int) -> Tuple[str, str]:
        with self._lock:
            stored = self._data["meta"].get(str(account), {}).get(str(dialog))
        if stored:
            return str(stored[0]), str(stored[1])
        self._remember(account, dialog)
        with self._lock:
            return self._meta_cache.get((account, dialog), (f"@chat:{dialog}", "user"))

    # Report
    def _first_hour(self, account: int) -> int:
        with self._lock:
            keys = [int(h) for src in ("hist", "live") for h in self._data[src].get(str(account), {})]
        return min(keys) if keys else 0

    def _report_cached(self, account: int, key: str) -> Dict[str, Any]:
        stamp = (account, key, self._rev, int(_time.time() // 60), _lang())
        with self._lock:
            hit = self._reports.get(stamp)
            if hit is not None:
                self._reports.move_to_end(stamp)
                return hit
        rep = self._report(account, key)
        with self._lock:
            self._reports[stamp] = rep
            while len(self._reports) > CACHE_REPORTS:
                self._reports.popitem(last=False)
        return rep

    def _report(self, account: int, key: str, now: float = None) -> Dict[str, Any]:
        now_i = int(now if now is not None else _time.time())
        off = _tz_offset(now_i)
        start, end = _range_bounds(key, now_i, off, self._first_hour(account))
        floor = (start // HOUR) * HOUR
        hours: Dict[int, int] = {}
        chats: Dict[int, int] = {}
        last: Dict[int, int] = {}
        with self._lock:
            sources = [dict(self._data[s].get(str(account), {})) for s in ("hist", "live")]
        for src in sources:
            for h, per in src.items():
                hi = int(h)
                ts = hi * HOUR
                if ts < floor or ts > end:
                    continue
                for dlg, c in per.items():
                    c = int(c)
                    chats[int(dlg)] = chats.get(int(dlg), 0) + c
                    hours[hi] = hours.get(hi, 0) + c
                    if c > 0 and hi > last.get(int(dlg), 0):
                        last[int(dlg)] = hi
        total = sum(hours.values())
        kinds: Dict[str, int] = {}
        titles: Dict[int, str] = {}
        rows: List[Dict[str, Any]] = []
        for dlg, c in chats.items():
            title, kind = self._meta(account, dlg)
            titles[dlg] = _title_text(title)
            kinds[kind] = kinds.get(kind, 0) + c
            rows.append({"dialog": dlg, "title": titles[dlg], "kind": kind, "count": c,
                         "last": last.get(dlg, 0) * HOUR})
        matrix = [[0] * 24 for _ in range(7)]
        for hi, n in hours.items():
            local = hi * HOUR + off
            matrix[((local // DAY) + 3) % 7][(local // HOUR) % 24] += n
        series = _series(key, hours, start, end, off)
        peak = max(series, key=lambda s: s[1]) if series else ("", 0, "")
        ranked = sorted(chats.items(), key=lambda kv: -kv[1])
        top = [(titles[d], c) for d, c in ranked[:TOP_ROWS]]
        rest = ranked[TOP_ROWS:]
        if rest:
            top.append((_t("others", len(rest)), sum(c for _, c in rest)))
        return {
            "key": key, "start": start, "end": end, "total": total, "chats": len(chats),
            "kinds": kinds, "series": series, "peak": (peak[2], peak[1]), "top": top,
            "matrix": matrix, "span_days": max(1, int((end - start) // DAY) + 1),
            "rows": rows, "off": off,
        }

    # History
    def _request(self, req: Any, account: int):
        if getattr(self, "_direct", False):
            return self._request_direct(req, account)
        return self._request_sdk(req, account)

    def _request_direct(self, req: Any, account: int):
        from java import dynamic_proxy
        from org.telegram.tgnet import ConnectionsManager, RequestDelegate
        box: Dict[str, Any] = {}
        done = threading.Event()

        class Delegate(dynamic_proxy(RequestDelegate)):

            def run(self, response, error):
                box["r"] = response
                box["e"] = error
                done.set()

        delegate = Delegate()
        ConnectionsManager.getInstance(account).sendRequest(req, delegate)
        if not done.wait(REQUEST_TIMEOUT):
            raise TimeoutError(_t("err_timeout"))
        return box.get("r"), box.get("e")

    def _ask(self, req: Any, account: int, field: str):
        resp, err = self._request(req, account)
        if err is not None or getattr(self, "_direct", False) or _jlist(getattr(resp, field, None)):
            return resp, err
        if getattr(self, "_direct_tries", DIRECT_TRIES) >= DIRECT_TRIES:
            return resp, err
        self._direct_tries = getattr(self, "_direct_tries", 0) + 1
        try:
            alt, alt_err = self._request_direct(req, account)
        except Exception as e:
            log(f"[{__name__}] direct request failed: {type(e).__name__}: {e}")
            return resp, err
        if alt_err is None and _jlist(getattr(alt, field, None)):
            self._direct = True
            return alt, alt_err
        return resp, err

    def _request_sdk(self, req: Any, account: int):
        box: Dict[str, Any] = {}
        done = threading.Event()

        def cb(response, error):
            box["r"] = response
            box["e"] = error
            done.set()

        send_request(req, cb, account=account)
        if not done.wait(REQUEST_TIMEOUT):
            raise TimeoutError(_t("err_timeout"))
        return box.get("r"), box.get("e")

    def _wait(self, seconds: float):
        left = float(seconds)
        while left > 0 and self._active:
            step = min(1.0, left)
            _time.sleep(step)
            left -= step

    def _page(self, account: int, dialog: int, offset_id: int, cutoff: int):
        from org.telegram.tgnet import TLRPC
        controller = get_messages_controller(account)
        for attempt in range(60):
            req = TLRPC.TL_messages_search()
            req.peer = self._peers.get((account, int(dialog))) or controller.getInputPeer(int(dialog))
            req.q = ""
            req.from_id = TLRPC.TL_inputPeerSelf()
            req.filter = TLRPC.TL_inputMessagesFilterEmpty()
            req.min_date = int(cutoff)
            req.max_date = 0
            req.offset_id = int(offset_id)
            req.add_offset = 0
            req.limit = PAGE
            req.max_id = 0
            req.min_id = 0
            req.hash = 0
            try:
                resp, err = self._request(req, account)
            except TimeoutError:
                self._wait(1)
                continue
            if err is None:
                msgs = _jlist(getattr(resp, "messages", None))
                notes = getattr(self, "_search_note", None)
                if notes is not None and len(notes) < 3:
                    notes.append(self._resp_note(resp, msgs))
                return msgs, resp
            text = str(getattr(err, "text", "") or "")
            if text.startswith("FLOOD_WAIT_"):
                try:
                    wait = int(text.rsplit("_", 1)[1])
                except ValueError:
                    wait = 5
                if wait > FLOOD_MAX or not self._active:
                    raise _Transient(text)
                self._wait(wait + 1)
                continue
            raise RuntimeError(text or _t("err_req"))
        raise _Transient(_t("err_retry"))

    @staticmethod
    def _resp_note(resp: Any, items: List[Any]) -> str:
        if resp is None:
            return "null"
        count = getattr(resp, "count", None)
        tail = f"/{count}" if count is not None else ""
        return f"{_class_name(resp)}:{len(items)}{tail}"

    @staticmethod
    def _is_complete(resp: Any, got: int) -> bool:
        name = _class_name(resp)
        if "Slice" not in name and "channel" not in name.lower():
            return True
        if bool(getattr(resp, "inexact", False)):
            return False
        count = int(getattr(resp, "count", 0) or 0)
        return count > 0 and got >= count and got < PAGE

    def _fetch_dialog(self, account: int, dialog: int, cutoff: int, since: int,
                      resume: Any = None, on_page: Any = None) -> Tuple[Dict[int, int], int, bool]:
        start = resume or {}
        hours: Dict[int, int] = {int(h): int(n) for h, n in (start.get("hours") or {}).items()}
        offset = int(start.get("offset", 0))
        got = int(start.get("got", 0))
        while self._active:
            msgs, resp = self._page(account, dialog, offset, cutoff)
            if not msgs:
                return hours, got, True
            oldest_id, oldest_date = None, None
            for m in msgs:
                mid, date = int(m.id), int(m.date)
                oldest_id = mid if oldest_id is None else min(oldest_id, mid)
                oldest_date = date if oldest_date is None else min(oldest_date, date)
                if getattr(m, "action", None) is not None:
                    continue
                if date >= since or (cutoff and date < cutoff):
                    continue
                hours[date // HOUR] = hours.get(date // HOUR, 0) + 1
            got += len(msgs)
            offset = oldest_id
            if on_page:
                on_page(offset, hours, got)
            if (cutoff and oldest_date < cutoff) or self._is_complete(resp, got):
                return hours, got, True
            _time.sleep(PAGE_PAUSE)
        return hours, got, False

    def _dialog_ids(self, account: int, cutoff: int) -> List[int]:
        controller = get_messages_controller(account)
        pool = []
        for name in ("getAllDialogs", "dialogsServerOnly"):
            try:
                src = getattr(controller, name)
                pool.extend(_jlist(src() if callable(src) else src))
            except Exception:
                continue
        seen, found = set(), []
        for d in pool:
            try:
                if "Folder" in _class_name(d):
                    continue
                did = _norm_dialog(d.id)
                if did in seen or did == 0 or _is_secret(did):
                    continue
                seen.add(did)
                last = int(getattr(d, "last_message_date", 0) or 0)
                if cutoff and last and last < cutoff:
                    continue
                found.append((last, did))
            except Exception:
                continue
        found.sort(reverse=True)
        return [did for _, did in found[:DIALOG_CAP]]

    def _list_dialogs(self, account: int) -> List[int]:
        from org.telegram.tgnet import TLRPC
        self._list_note = []
        me = self._me(account)
        found: List[int] = []
        seen = set()
        acc = str(account)
        for folder in (0, 1):
            offset_date, offset_id = 0, 0
            offset_peer = TLRPC.TL_inputPeerEmpty()
            total = 0
            for _ in range(DIALOG_PAGES):
                req = TLRPC.TL_messages_getDialogs()
                req.flags = 2 if folder else 0
                req.exclude_pinned = False
                req.folder_id = folder
                req.offset_date = offset_date
                req.offset_id = offset_id
                req.offset_peer = offset_peer
                req.limit = 100
                req.hash = 0
                if folder == 0 and offset_id == 0:
                    resp, err = self._ask(req, account, "dialogs")
                else:
                    resp, err = self._request(req, account)
                if err is not None:
                    raise RuntimeError(str(getattr(err, "text", "") or _t("err_req")))
                dialogs = _jlist(getattr(resp, "dialogs", None))
                self._list_note.append(self._resp_note(resp, dialogs))
                if not dialogs:
                    break
                users = {int(u.id): u for u in _jlist(getattr(resp, "users", None))}
                chats = {int(c.id): c for c in _jlist(getattr(resp, "chats", None))}
                tops = {}
                for m in _jlist(getattr(resp, "messages", None)):
                    try:
                        tops[(self._peer_key(m.peer_id), int(m.id))] = m
                    except Exception:
                        continue
                last_peer, last_msg = None, None
                for d in dialogs:
                    total += 1
                    kind, pid = self._peer_key(d.peer)
                    peer, did, title, k = None, 0, "", "user"
                    if kind == "user":
                        user = users.get(pid)
                        if user is not None:
                            peer = TLRPC.TL_inputPeerUser()
                            peer.user_id = pid
                            peer.access_hash = int(getattr(user, "access_hash", 0) or 0)
                        did = pid
                        title, k = self._user_info(user, did, me)
                    elif kind == "chat":
                        peer = TLRPC.TL_inputPeerChat()
                        peer.chat_id = pid
                        did = -pid
                        title, k = self._chat_info(chats.get(pid), did)
                    elif kind == "channel":
                        chat = chats.get(pid)
                        if chat is not None:
                            peer = TLRPC.TL_inputPeerChannel()
                            peer.channel_id = pid
                            peer.access_hash = int(getattr(chat, "access_hash", 0) or 0)
                        did = -pid
                        title, k = self._chat_info(chat, did)
                    if peer is not None:
                        top = tops.get(((kind, pid), int(getattr(d, "top_message", 0) or 0)))
                        if top is not None:
                            last_peer, last_msg = peer, top
                        if did not in seen:
                            seen.add(did)
                            found.append(did)
                            self._peers[(account, did)] = peer
                            with self._lock:
                                self._data["meta"].setdefault(acc, {})[str(did)] = [title, k]
                            self._meta_cache[(account, did)] = (title, k)
                count = int(getattr(resp, "count", 0) or 0)
                if len(dialogs) < 100 or (count and total >= count) or last_msg is None or last_peer is None:
                    break
                nxt = (int(last_msg.date), int(last_msg.id))
                if nxt == (offset_date, offset_id):
                    break
                offset_date, offset_id, offset_peer = nxt[0], nxt[1], last_peer
        self._mark_dirty()
        return found

    @staticmethod
    def _peer_key(peer: Any) -> Tuple[str, int]:
        name = _class_name(peer)
        if "Channel" in name:
            return "channel", int(peer.channel_id)
        if "Chat" in name:
            return "chat", int(peer.chat_id)
        return "user", int(peer.user_id)

    def _history_loaded(self, account: int) -> bool:
        with self._lock:
            return bool(self._data["histinfo"].get(str(account), {}).get("complete"))

    def _progress_text(self) -> str:
        bf = self._bf
        return _t("progress", bf.get("done", 0), bf.get("total", 0),
                  _fmt_num(bf.get("found", 0) + bf.get("current", 0)))

    def _progress_ui(self, force: bool = False):
        now = _time.time()
        if not force and now - self._bf.get("ui", 0.0) < UI_PAUSE:
            return
        self._bf["ui"] = now
        tv = self._state.get("progress_tv")
        if tv is None:
            return
        text = self._progress_text()
        run_on_ui_thread(lambda: tv.setText(text))

    def start_history(self, account: int):
        if self._bf.get("running"):
            return
        self._bf = {"running": True, "done": 0, "total": 0, "found": 0, "current": 0}
        run_on_queue(lambda: self._history_job(account))

    def _checkpoint(self, acc: str, dialog: int, offset: int, hours: Dict[int, int], got: int, pages: List[int]):
        self._bf["current"] = got
        pages[0] += 1
        if pages[0] % CHECKPOINT_PAGES == 0:
            with self._lock:
                st = self._data["histstate"].get(acc)
                if st is not None:
                    st["partial"] = {"dialog": dialog, "offset": offset, "got": got,
                                     "hours": {str(h): n for h, n in hours.items()}}
            self._mark_dirty()
        self._progress_ui()

    @staticmethod
    def _purge(store: Dict[str, Dict[str, int]], dialog: int, from_hour: int, to_hour: Any = None) -> int:
        key = str(dialog)
        removed = 0
        for h in list(store):
            hi = int(h)
            if hi >= from_hour and (to_hour is None or hi < to_hour):
                per = store[h]
                if key in per:
                    removed += int(per.pop(key))
                    if not per:
                        del store[h]
        return removed

    def _commit_dialog(self, account: int, dialog: int, hours: Dict[int, int], cutoff: int,
                       boundary: int, present: Dict[str, set]) -> bool:
        acc = str(account)
        floor = (int(cutoff) // HOUR) if cutoff else 0
        with self._lock:
            hist = self._data["hist"].setdefault(acc, {})
            live = self._data["live"].setdefault(acc, {})
            if not cutoff and dialog in present["hist"]:
                key = str(dialog)
                old_total = sum(int(per.get(key, 0)) for per in hist.values())
                if old_total >= GUARD_MIN and sum(hours.values()) < old_total * GUARD_RATIO:
                    return False
            removed = 0
            if dialog in present["hist"]:
                removed += self._purge(hist, dialog, floor)
            if dialog in present["live"]:
                removed += self._purge(live, dialog, floor, boundary // HOUR)
            for h, n in hours.items():
                hist.setdefault(str(h), {})[str(dialog)] = n
            self._total += sum(hours.values()) - removed
            self._rev += 1
            present["hist"].add(dialog)
            info = self._info(acc)
            info["synced"][str(dialog)] = int(boundary)
            info["resume"].pop(str(dialog), None)
            st = self._data["histstate"].get(acc)
            found = 0
            if st is not None:
                st["done"].append(int(dialog))
                st["partial"] = None
                st["found"] = int(st.get("found", 0)) + sum(hours.values())
                found = st["found"]
        self._bf.update(found=found, current=0)
        self._mark_dirty()
        return True

    def _info(self, acc: str) -> Dict[str, Any]:
        info = self._data["histinfo"].setdefault(acc, {"complete": False})
        info.setdefault("synced", {})
        info.setdefault("resume", {})
        info.setdefault("errors", [])
        return info

    def _account_totals(self, account: int) -> Tuple[int, int]:
        acc = str(account)
        total, chats = 0, set()
        with self._lock:
            for key in ("hist", "live"):
                for per in self._data[key].get(acc, {}).values():
                    for dlg, n in per.items():
                        total += int(n)
                        chats.add(dlg)
        return total, len(chats)

    def _prepare_run(self, account: int) -> Dict[str, Any]:
        acc = str(account)
        with self._lock:
            st = self._data["histstate"].get(acc)
            if st is not None:
                return st
            info = self._data["histinfo"].get(acc)
            if info is not None and "synced" not in info:
                if info.get("complete"):
                    since = int(self._data["since"].get(acc, 0))
                    counts: Dict[str, int] = {}
                    for per in self._data["hist"].get(acc, {}).values():
                        for dlg, n in per.items():
                            counts[dlg] = counts.get(dlg, 0) + int(n)
                    info["synced"] = {d: since for d, n in counts.items() if n < RESYNC_MIN}
                else:
                    self._data["hist"][acc] = {}
                    self._data["histinfo"].pop(acc, None)
                    self._total = self._total_of(self._data)
                    self._rev += 1
            boundary = (int(_time.time()) // HOUR) * HOUR
            self._info(acc)
            st = {"boundary": boundary, "done": [], "partial": None, "found": 0}
            self._data["histstate"][acc] = st
            self._data["since"][acc] = boundary
        self._mark_dirty()
        return st

    def _history_job(self, account: int):
        acc = str(account)
        errors: List[List[str]] = []
        completed = False
        try:
            st = self._prepare_run(account)
            boundary = int(st["boundary"])
            with self._lock:
                done = {int(x) for x in st.get("done", [])}
                info = self._info(acc)
                synced = dict(info["synced"])
                present = {"hist": {int(d) for per in self._data["hist"].get(acc, {}).values() for d in per},
                           "live": {int(d) for per in self._data["live"].get(acc, {}).values() for d in per}}
                found = int(st.get("found", 0))
            list_err, local = "", False
            self._direct, self._direct_tries = False, 0
            try:
                listed = self._list_dialogs(account)
            except Exception as e:
                log(f"[{__name__}] dialog list failed: {e}")
                list_err = f"{type(e).__name__}: {e}"[:100]
                listed = []
            note = list_err or ", ".join(getattr(self, "_list_note", [])[:3])
            self._search_note = []
            if not listed:
                listed, local = self._dialog_ids(account, 0), True
            ids = [d for d in listed if self._meta(account, d)[1] != "channel"]
            raw = [0]
            if not ids:
                reason = list_err or _t("d_empty")
                with self._lock:
                    info["errors"] = [[_t("d_list"), reason]]
                    info["diag"] = [account + 1, 0, 0, local, note]
                self._mark_dirty()
                self._toast(_t("t_list_fail", reason))
                return
            self._bf.update(total=len(ids), done=len([d for d in ids if d in done]), found=found, current=0)
            self._progress_ui(True)
            completed = True
            for dialog in ids:
                if not self._active:
                    completed = False
                    break
                if dialog in done:
                    continue
                key = str(dialog)
                cutoff = max(0, (int(synced[key]) - SYNC_MARGIN) // HOUR * HOUR) if key in synced else 0
                partial = st.get("partial")
                resume = None
                if partial and int(partial.get("dialog", 0)) == dialog:
                    resume = partial
                elif key in info["resume"]:
                    resume, cutoff = info["resume"][key], 0
                pages = [0]
                sink: Dict[str, Any] = {}

                def tick(off, hrs, g, d=dialog, pages=pages, sink=sink):
                    sink.update(offset=off, got=g, hours=hrs)
                    self._checkpoint(acc, d, off, hrs, g, pages)

                try:
                    hours, got, finished = self._fetch_dialog(account, dialog, cutoff, boundary, resume, tick)
                    raw[0] += int(got)
                except _Transient as e:
                    log(f"[{__name__}] history paused: {e}")
                    completed = False
                    self._toast(_t("t_fail"))
                    break
                except Exception as e:
                    log(f"[{__name__}] history {dialog} failed: {e}")
                    if any(code in str(e) for code in BENIGN_ERRORS):
                        with self._lock:
                            st["done"].append(int(dialog))
                        done.add(dialog)
                        self._bf["done"] = self._bf.get("done", 0) + 1
                        continue
                    errors.append([self._meta(account, dialog)[0], str(e)[:80]])
                    with self._lock:
                        if sink:
                            info["resume"][key] = {"offset": sink["offset"], "got": sink["got"],
                                                   "hours": {str(h): n for h, n in sink["hours"].items()}}
                        st["done"].append(int(dialog))
                    done.add(dialog)
                    self._bf["done"] = self._bf.get("done", 0) + 1
                    continue
                if not finished:
                    completed = False
                    break
                if not self._commit_dialog(account, dialog, hours, cutoff, boundary, present):
                    errors.append([self._meta(account, dialog)[0], f"{sum(hours.values())} < old"])
                    with self._lock:
                        st["done"].append(int(dialog))
                done.add(dialog)
                self._bf["done"] = self._bf.get("done", 0) + 1
                self._progress_ui()
            if completed:
                with self._lock:
                    info["complete"] = True
                    info["done"] = int(_time.time())
                    info["errors"] = errors[:ERRORS_KEPT]
                    info["diag"] = [account + 1, len(ids), raw[0], local, note if local else "",
                                    ", ".join(self._search_note) if not raw[0] else "", bool(self._direct)]
                    self._data["histstate"].pop(acc, None)
                self._mark_dirty()
                self._flush()
                found_now = _fmt_num(self._bf.get("found", 0))
                if synced:
                    text = _t("t_done_sync", found_now, _fmt_num(self._account_totals(account)[0]))
                else:
                    text = _t("t_done", found_now)
                self._toast(text + (_t("t_done_err", len(errors)) if errors else ""))
        except Exception as e:
            log(f"[{__name__}] history job failed: {e}")
            self._toast(_t("t_fail"))
        finally:
            self._bf["running"] = False
            self._refresh_sheet()

    # Menu
    def _register_menu(self, only: Any = None):
        for key, kind, item_id in (("show_drawer", MenuItemType.DRAWER_MENU, MENU_DRAWER_ID),
                                   ("show_chat", MenuItemType.CHAT_ACTION_MENU, MENU_CHAT_ID)):
            if only is not None and key not in only:
                continue
            try:
                if only is not None:
                    self.remove_menu_item(item_id)
                if self._entry_on(key):
                    self.add_menu_item(MenuItemData(
                        menu_type=kind, text=_t("menu"), icon="msg_stats",
                        item_id=item_id, on_click=self._on_menu_click,
                    ))
                else:
                    self.remove_menu_item(item_id)
            except Exception as e:
                log(f"[{__name__}] menu {item_id} failed: {e}")

    # Settings
    def _entry_on(self, key: str) -> bool:
        values = {k: bool(self.get_setting(k, True)) for k in ENTRY_KEYS}
        if not any(values.values()):
            return key == "show_drawer"
        return values.get(key, True)

    def _on_entry_change(self, key: str, value: Any):
        if not value and not any(bool(self.get_setting(k, True)) for k in ENTRY_KEYS if k != key):
            self.set_setting(key, True)
            run_on_ui_thread(lambda: self._bounce_back(key), BOUNCE_MS)
            return
        self._register_menu(ENTRY_KEYS)
        run_on_ui_thread(self._top_existing if self._entry_on("show_header") else self._top_remove)

    def _flip_cell(self, text: str) -> bool:
        try:
            stack = [get_last_fragment().getFragmentView()]
        except Exception:
            return False
        while stack:
            view = stack.pop()
            if view is None:
                continue
            try:
                if str(view.getTextView().getText()) == text:
                    view.setChecked(True)
                    return True
            except Exception:
                pass
            try:
                for i in range(int(view.getChildCount())):
                    stack.append(view.getChildAt(i))
            except Exception:
                pass
        return False

    def _bounce_back(self, key: str):
        self.set_setting(key, True)
        if not self._flip_cell(_t(ENTRY_LABELS[key])):
            self.set_setting(key, True, reload_settings=True)
        try:
            from org.telegram.messenger import BotWebViewVibrationEffect
            BotWebViewVibrationEffect.APP_ERROR.vibrate()
        except Exception:
            pass

    def _default_range(self) -> str:
        try:
            idx = int(self.get_setting("default_range", RANGES.index("week")))
        except (TypeError, ValueError):
            idx = RANGES.index("week")
        return RANGES[idx] if 0 <= idx < len(RANGES) else "week"

    def _start_tab(self) -> int:
        try:
            idx = int(self.get_setting("start_tab", 0))
        except (TypeError, ValueError):
            idx = 0
        return idx if 0 <= idx < len(TABS) else 0

    def create_settings(self) -> List[Any]:
        if not any(bool(self.get_setting(k, True)) for k in ENTRY_KEYS):
            self.set_setting("show_drawer", True)

        def toggle(key: str):
            return lambda value: self._on_entry_change(key, value)

        return [
            Header(text=_t("set_entries")),
            Switch(key="show_drawer", text=_t("set_drawer"), default=True, on_change=toggle("show_drawer")),
            Switch(key="show_header", text=_t("set_header"), default=True, on_change=toggle("show_header")),
            Switch(key="show_chat", text=_t("set_chat"), default=True, on_change=toggle("show_chat")),
            Switch(key="show_tabs", text=_t("set_tabs"), default=True, on_change=toggle("show_tabs")),
            Divider(text=_t("set_entries_hint")),
            Header(text=_t("set_view")),
            Selector(key="default_range", text=_t("set_range"), default=RANGES.index("week"),
                     items=[_t("r_" + k) for k in RANGES]),
            Selector(key="start_tab", text=_t("set_tab"), default=0, items=[_t(t) for t in TABS]),
            Divider(text=__author__),
        ]

    def _hook_header(self):
        plugin = self

        class HeaderHook(MethodHook):

            def after_hooked_method(self, param):
                try:
                    plugin._top_attach(param.thisObject)
                except Exception as e:
                    plugin._top_status = ("s_top_err", f"{type(e).__name__}: {e}"[:120])
                    log(f"[{__name__}] header hook failed: {type(e).__name__}: {e}")

        try:
            from hook_utils import find_class
            self.hook_all_methods(find_class(DIALOGS_CLASS), "createView", HeaderHook())
        except Exception as e:
            self._top_status = ("s_top_err", f"hook {type(e).__name__}: {e}"[:120])
            log(f"[{__name__}] header hook install failed: {type(e).__name__}: {e}")

    def _hook_tab_menu(self):
        plugin = self

        class MenuHook(MethodHook):

            def before_hooked_method(self, param):
                try:
                    plugin._extend_tab_menu(param.thisObject)
                except Exception as e:
                    log(f"[{__name__}] tab menu failed: {type(e).__name__}: {e}")

        try:
            from hook_utils import find_class
            self.hook_all_methods(find_class(OPTIONS_CLASS), "show", MenuHook())
        except Exception as e:
            log(f"[{__name__}] tab menu hook install failed: {type(e).__name__}: {e}")

    def _settings_tab(self, fragment: Any) -> Any:
        tabs = None
        if fragment is not None and str(fragment.getClass().getName()) == TABS_CLASS:
            tabs = self._field(fragment, "tabs")
        if tabs is None:
            return None
        return tabs[SETTINGS_TAB]

    def _runnable(self, fn: Any):
        from java import dynamic_proxy
        from java.lang import Runnable

        class Run(dynamic_proxy(Runnable)):

            def run(self):
                try:
                    fn()
                except Exception as e:
                    log(f"[{__name__}] run failed: {e}")

        return Run()

    def _menu_icon(self) -> int:
        try:
            from org.telegram.messenger import R
            return int(getattr(R.drawable, "msg_stats"))
        except Exception:
            return 0

    def _extend_tab_menu(self, options: Any):
        if not self._active or options is None or not self._entry_on("show_tabs"):
            return
        marker = int(options.hashCode())
        if marker == getattr(self, "_menu_marker", None):
            return
        try:
            fragment = self._field(options, "fragment")
            anchor = self._field(options, "scrimView")
        except Exception:
            return
        tab = self._settings_tab(fragment)
        if tab is None or anchor is None or not anchor.equals(tab):
            return
        self._menu_marker = marker
        action = self._runnable(lambda: run_on_ui_thread(self._on_menu_click, OPEN_DELAY_MS))
        icon = self._menu_icon()
        if icon:
            options.add(icon, _t("menu"), action)
        else:
            options.add(self._top_drawable(), _t("menu"), action)

    @staticmethod
    def _field(obj: Any, name: str) -> Any:
        cls = obj.getClass()
        while cls is not None:
            try:
                field = cls.getDeclaredField(name)
                field.setAccessible(True)
                return field.get(obj)
            except Exception:
                cls = cls.getSuperclass()
        raise AttributeError(name)

    def _dialogs_fragments(self) -> List[Any]:
        out = []
        try:
            from org.telegram.ui import LaunchActivity
            stack = LaunchActivity.instance.getActionBarLayout().getFragmentStack()
            for i in range(int(stack.size())):
                out.append(stack.get(i))
        except Exception:
            pass
        try:
            last = get_last_fragment()
            if last is not None and not any(last is f for f in out):
                out.append(last)
        except Exception:
            pass
        found = []
        for fragment in out:
            if fragment is None:
                continue
            try:
                if str(fragment.getClass().getName()) == DIALOGS_CLASS:
                    found.append(fragment)
                    continue
            except Exception:
                continue
            try:
                child = fragment.getDialogsActivity()
            except Exception:
                child = None
            if child is not None and not any(child is f for f in found):
                found.append(child)
        return found

    def _top_drawable(self) -> Any:
        from android.graphics.drawable import BitmapDrawable
        from org.telegram.messenger import AndroidUtilities, ApplicationLoader
        size = int(AndroidUtilities.dp(TOP_ICON_DP))
        d = _Draw(size, size, float(AndroidUtilities.density), -1, -1)
        _draw_icon(d, "overview", -1)
        return BitmapDrawable(ApplicationLoader.applicationContext.getResources(), d.bmp)

    def _click(self, fn: Any):
        from java import dynamic_proxy
        from android.view import View

        class Click(dynamic_proxy(View.OnClickListener)):

            def onClick(self, view):
                try:
                    fn()
                except Exception as e:
                    log(f"[{__name__}] click failed: {e}")

        return Click()

    def _top_attach(self, fragment: Any):
        if fragment is None or not self._active or not self._entry_on("show_header"):
            return
        try:
            lock = self._field(fragment, "passcodeItem")
        except Exception:
            lock = False
        if lock is None:
            return
        bar = fragment.getActionBar()
        if bar is None:
            return
        menu = bar.createMenu()
        if menu.getItem(TOP_ITEM_ID) is not None:
            self._top_status = ("s_top_ok", "")
            return
        item = menu.addItem(TOP_ITEM_ID, self._top_drawable())
        item.setContentDescription(_t("menu"))
        item.setOnClickListener(self._click(self._on_menu_click))
        self._top_status = ("s_top_ok", "")
        if lock is not False:
            index = int(menu.indexOfChild(lock))
            if index >= 0:
                menu.removeView(item)
                menu.addView(item, index)

    def _top_existing(self):
        for fragment in self._dialogs_fragments():
            try:
                self._top_attach(fragment)
            except Exception as e:
                self._top_status = ("s_top_err", f"{type(e).__name__}: {e}"[:120])
                log(f"[{__name__}] header button failed: {type(e).__name__}: {e}")

    def _top_remove(self):
        for fragment in self._dialogs_fragments():
            try:
                menu = fragment.getActionBar().createMenu()
                item = menu.getItem(TOP_ITEM_ID)
                if item is not None:
                    menu.removeView(item)
            except Exception as e:
                log(f"[{__name__}] header button remove failed: {e}")

    def _on_menu_click(self, context: Dict[str, Any] = None):
        account = None
        try:
            account = int((context or {}).get("account"))
        except Exception:
            pass
        if account is None:
            try:
                from org.telegram.messenger import UserConfig
                account = int(UserConfig.selectedAccount)
            except Exception:
                account = 0
        run_on_ui_thread(lambda: self._open_sheet(account))

    def _toast(self, text: str, long: bool = True):
        def show():
            try:
                from android.widget import Toast
                from org.telegram.messenger import ApplicationLoader
                dur = Toast.LENGTH_LONG if long else Toast.LENGTH_SHORT
                Toast.makeText(ApplicationLoader.applicationContext, text, dur).show()
            except Exception as e:
                log(f"[{__name__}] toast failed: {e}")
        run_on_ui_thread(show)

    def _activity(self) -> Any:
        activity = None
        frag = get_last_fragment()
        if frag is not None:
            activity = frag.getParentActivity()
        if activity is None:
            from org.telegram.ui import LaunchActivity
            activity = LaunchActivity.instance
        return activity

    # Sheet
    def _theme_colors(self) -> Tuple[int, int, int]:
        text, muted, accent = -14540254, -7829368, None
        try:
            from org.telegram.ui.ActionBar import Theme
            text = int(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText))
            muted = int(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText))
            for name in ("key_featuredStickers_addButton", "key_chats_actionBackground",
                         "key_windowBackgroundWhiteBlueText4"):
                try:
                    accent = int(Theme.getColor(getattr(Theme, name)))
                    break
                except Exception:
                    continue
        except Exception:
            pass
        return text, muted, accent if accent is not None else _argb(ACCENT)

    def _theme_bg(self) -> int:
        try:
            from org.telegram.ui.ActionBar import Theme
            return int(Theme.getColor(Theme.key_dialogBackground))
        except Exception:
            return -13421773

    def _touch(self, fn: Any):
        from java import dynamic_proxy
        from android.view import View

        class Touch(dynamic_proxy(View.OnTouchListener)):

            def onTouch(self, view, event):
                try:
                    return bool(fn(view, event))
                except Exception as e:
                    log(f"[{__name__}] touch failed: {e}")
                    return False

        return Touch()

    def _watcher(self, fn: Any):
        from java import dynamic_proxy
        from android.text import TextWatcher

        class Watcher(dynamic_proxy(TextWatcher)):

            def beforeTextChanged(self, s, start, count, after):
                pass

            def onTextChanged(self, s, start, before, count):
                try:
                    fn(str(s))
                except Exception as e:
                    log(f"[{__name__}] text failed: {e}")

            def afterTextChanged(self, e):
                pass

        return Watcher()

    def _open_url(self, url: str):
        try:
            from org.telegram.messenger.browser import Browser
            Browser.openUrl(self._activity(), url)
            return
        except Exception as e:
            log(f"[{__name__}] browser failed: {e}")
        try:
            from android.content import Intent
            from android.net import Uri
            from org.telegram.messenger import ApplicationLoader
            intent = Intent(Intent.ACTION_VIEW, Uri.parse(url))
            intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
            ApplicationLoader.applicationContext.startActivity(intent)
        except Exception as e:
            log(f"[{__name__}] intent failed: {e}")

    def _confirm(self, title: str, yes: str, action: Any):
        try:
            from ui.alert import AlertDialogBuilder
            dialog = AlertDialogBuilder(self._activity())
            dialog.set_title(title)

            def go(b, w):
                b.dismiss()
                action()

            dialog.set_positive_button(yes, go)
            dialog.set_negative_button(_t("s_cancel"), lambda b, w: b.dismiss())
            dialog.show()
        except Exception as e:
            log(f"[{__name__}] confirm failed: {e}")

    def _open_sheet(self, account: int):
        try:
            from android.widget import FrameLayout, LinearLayout, ScrollView
            from android.view import Gravity
            from org.telegram.messenger import AndroidUtilities
            activity = self._activity()
            dp = AndroidUtilities.dp
            text, muted, accent = self._theme_colors()
            state = {"account": account, "key": self._default_range(), "later": False, "tab": self._start_tab(),
                     "sort": "count", "type": "all", "query": "", "activity": activity, "built": {}, "stale": set(),
                     "token": 0, "views": [], "contents": [], "ctl": {}, "colors": (text, muted, accent)}
            root = LinearLayout(activity)
            root.setOrientation(LinearLayout.VERTICAL)
            state["root"] = root
            root.addView(self._header(state, text, muted, accent))
            root.addView(self._divider(activity, text))
            area = FrameLayout(activity)
            pad = int(dp(16))
            for i in range(len(TABS)):
                scroll = ScrollView(activity)
                content = LinearLayout(activity)
                content.setOrientation(LinearLayout.VERTICAL)
                content.setPadding(pad, int(dp(8)), pad, int(dp(BAR_HEIGHT_DP + BAR_LIFT_DP + 28)))
                scroll.addView(content)
                if i != state["tab"]:
                    scroll.setVisibility(4)
                area.addView(scroll, FrameLayout.LayoutParams(-1, -1))
                state["views"].append(scroll)
                state["contents"].append(content)
            area.addView(self._tabs(state, text, muted, accent),
                         FrameLayout.LayoutParams(-1, -2, Gravity.BOTTOM))
            height = int(AndroidUtilities.displaySize.y * 0.82 - dp(64))
            root.addView(area, LinearLayout.LayoutParams(-1, height))
            state["content"] = state["contents"][state["tab"]]
            state["width"] = int(AndroidUtilities.displaySize.x)
            self._state = state
            self._render(state)
            state["stale"] = set(range(len(TABS))) - {state["tab"]}
            run_on_ui_thread(lambda: self._prebuild(state), PREBUILD_MS)
            self._sheet = None
            try:
                from java import jboolean
                from org.telegram.ui.ActionBar import BottomSheet
                builder = BottomSheet.Builder(activity, jboolean(True))
                builder.setCustomView(root)
                self._sheet = builder.show()
                for name in ("setCanDismissWithSwipe", "setAllowNestedScroll"):
                    try:
                        getattr(self._sheet, name)(False)
                    except Exception as e:
                        log(f"[{__name__}] {name} failed: {e}")
            except Exception as e:
                log(f"[{__name__}] bottom sheet failed: {e}")
                from org.telegram.ui.ActionBar import AlertDialog
                builder = AlertDialog.Builder(activity)
                builder.setView(root)
                self._sheet = builder.show()
        except Exception as e:
            log(f"[{__name__}] open sheet failed: {e}")
            self._toast(_t("t_open_fail"))

    def _prebuild(self, state: Dict[str, Any]):
        if state is not self._state or not self._active:
            return
        for i in range(len(TABS)):
            if i != state["tab"] and (i in state["stale"] or state["built"].get(i) != self._rev):
                def work(i=i):
                    try:
                        self._warm(state, i)
                    except Exception as e:
                        log(f"[{__name__}] warm failed: {e}")

                    def build():
                        self._render(state, i)
                        state["built"][i] = self._rev
                        state["stale"].discard(i)
                        run_on_ui_thread(lambda: self._prebuild(state), PREBUILD_MS)

                    run_on_ui_thread(build)

                run_on_queue(work)
                return

    def _show_tab(self, state: Dict[str, Any], new: int):
        old = state["tab"]
        if new == old:
            return
        if new in state["stale"] or state["built"].get(new) != self._rev:
            self._render(state, new)
        state["tab"] = new
        state["content"] = state["contents"][new]
        state["token"] += 1
        token = state["token"]
        views = state["views"]
        for j, view in enumerate(views):
            if j not in (old, new):
                view.setVisibility(4)
        direction = 1 if new > old else -1
        shift = float(state.get("width", 1080) * SHIFT)
        incoming, outgoing = views[new], views[old]
        try:
            from android.view.animation import DecelerateInterpolator
            for view in (incoming, outgoing):
                view.animate().cancel()
            incoming.setVisibility(0)
            incoming.setAlpha(0.0)
            incoming.setTranslationX(direction * shift)
            incoming.animate().alpha(1.0).translationX(0.0).setDuration(SWITCH_MS).setInterpolator(
                DecelerateInterpolator()).start()
            outgoing.animate().alpha(0.0).translationX(-direction * shift).setDuration(SWITCH_MS).setInterpolator(
                DecelerateInterpolator()).start()
        except Exception as e:
            log(f"[{__name__}] switch animation failed: {e}")
            incoming.setVisibility(0)
            incoming.setAlpha(1.0)
            incoming.setTranslationX(0.0)
            outgoing.setVisibility(4)

        def finish():
            if state["token"] != token:
                return
            outgoing.setVisibility(4)
            outgoing.setAlpha(1.0)
            outgoing.setTranslationX(0.0)

        run_on_ui_thread(finish, SWITCH_MS + 40)

    def _invalidate_others(self, state: Dict[str, Any]):
        state["stale"] |= set(range(len(TABS))) - {state["tab"]}
        run_on_ui_thread(lambda: self._prebuild(state), PREBUILD_MS)

    def _close_sheet(self):
        try:
            self._sheet.dismiss()
        except Exception as e:
            log(f"[{__name__}] dismiss failed: {e}")

    def _glass(self, radius: float, text: int, fill: int = 22, stroke: int = 46):
        from android.graphics.drawable import GradientDrawable
        from org.telegram.messenger import AndroidUtilities
        bg = GradientDrawable()
        bg.setCornerRadius(float(radius))
        bg.setColor(_ji(_argb(text, fill)))
        bg.setStroke(int(max(1, AndroidUtilities.dp(1))), _ji(_argb(text, stroke)))
        return bg

    def _thumb(self, radius: float, accent: int):
        from android.graphics.drawable import GradientDrawable
        from org.telegram.messenger import AndroidUtilities
        try:
            from java import jarray, jint
            bg = GradientDrawable(GradientDrawable.Orientation.TOP_BOTTOM,
                                  jarray(jint)([_argb(accent, 238), _argb(accent, 168)]))
        except Exception:
            bg = GradientDrawable()
            bg.setColor(_ji(_argb(accent, 205)))
        bg.setCornerRadius(float(radius))
        bg.setStroke(int(max(1, AndroidUtilities.dp(1))), _ji(_argb(-1, 120)))
        return bg

    def _cross(self, activity: Any, text: int):
        from android.widget import ImageView
        from org.telegram.messenger import AndroidUtilities
        size = int(AndroidUtilities.dp(36))
        d = _Draw(size, size, float(AndroidUtilities.density), text, text)
        d.circle(size / 2.0, size / 2.0, size / 2.0 - 1, text, 30)
        arm = size * 0.17
        mid = size / 2.0
        d.line(mid - arm, mid - arm, mid + arm, mid + arm, text, d.dp(2))
        d.line(mid - arm, mid + arm, mid + arm, mid - arm, text, d.dp(2))
        iv = ImageView(activity)
        iv.setImageBitmap(d.bmp)
        return self._press(iv, self._close_sheet)

    def _header(self, state: Dict[str, Any], text: int, muted: int, accent: int):
        from android.widget import LinearLayout
        from android.view import Gravity
        from org.telegram.messenger import AndroidUtilities
        dp = AndroidUtilities.dp
        activity = state["activity"]
        row = LinearLayout(activity)
        row.setOrientation(LinearLayout.HORIZONTAL)
        row.setGravity(Gravity.CENTER_VERTICAL)
        row.setPadding(int(dp(16)), int(dp(14)), int(dp(12)), int(dp(12)))
        title = self._text_view(activity, _t("title"), 20, text, True)
        row.addView(title, LinearLayout.LayoutParams(0, -2, 1.0))
        row.addView(self._cross(activity, text), LinearLayout.LayoutParams(int(dp(36)), int(dp(36))))
        row.setOnTouchListener(self._touch(self._drag_handler(state)))
        return row

    def _divider(self, activity: Any, text: int):
        from android.view import View
        from android.widget import LinearLayout
        from org.telegram.messenger import AndroidUtilities
        line = View(activity)
        line.setBackgroundColor(_ji(_argb(text, 26)))
        line.setLayoutParams(LinearLayout.LayoutParams(-1, max(1, int(AndroidUtilities.dp(0.5)))))
        return line

    def _drag_handler(self, state: Dict[str, Any]):
        from org.telegram.messenger import AndroidUtilities
        drag = {"y0": 0.0, "dy": 0.0, "t0": 0}

        def target():
            root = state.get("root")
            try:
                parent = root.getParent()
                return parent if parent is not None else root
            except Exception:
                return root

        def on_touch(v, event):
            action = int(event.getActionMasked())
            if action == 0:
                drag["y0"] = float(event.getRawY())
                drag["dy"] = 0.0
                drag["t0"] = int(event.getEventTime())
                try:
                    v.getParent().requestDisallowInterceptTouchEvent(True)
                except Exception:
                    pass
                return True
            if action == 2:
                drag["dy"] = max(0.0, float(event.getRawY()) - drag["y0"])
                target().setTranslationY(float(drag["dy"]))
                return True
            if action in (1, 3):
                dy = drag["dy"]
                elapsed = max(1, int(event.getEventTime()) - drag["t0"])
                unit = float(AndroidUtilities.density)
                if action == 1 and (dy > 90 * unit or (dy > 30 * unit and dy / elapsed > 0.9 * unit)):
                    self._close_sheet()
                elif dy > 0:
                    try:
                        from android.view.animation import DecelerateInterpolator
                        target().animate().translationY(0.0).setDuration(SNAP_MS).setInterpolator(
                            DecelerateInterpolator()).start()
                    except Exception:
                        target().setTranslationY(0.0)
                return True
            return True

        return on_touch

    def _rim(self, radius: float, text: int, strong: int = 70, weak: int = 12):
        from android.graphics.drawable import GradientDrawable
        try:
            from java import jarray, jint
            bg = GradientDrawable(GradientDrawable.Orientation.TL_BR,
                                  jarray(jint)([_argb(text, strong), _argb(text, weak)]))
        except Exception:
            bg = GradientDrawable()
            bg.setColor(_ji(_argb(text, weak)))
        bg.setCornerRadius(float(radius))
        return bg

    def _pill_fill(self, radius: float, color: int, alpha: int = 255):
        from android.graphics.drawable import GradientDrawable
        bg = GradientDrawable()
        bg.setCornerRadius(float(radius))
        bg.setColor(_ji(_argb(color, alpha)))
        return bg

    def _glass_layers(self, radius: float, text: int, level: float = 0.07, alpha: int = 232,
                      strong: int = 70, weak: int = 12):
        from org.telegram.messenger import AndroidUtilities
        rim = int(max(1, AndroidUtilities.dp(1)))
        fill = _blend(self._theme_bg(), text, level)
        try:
            from java import jarray
            from android.graphics.drawable import Drawable, LayerDrawable
            layers = LayerDrawable(jarray(Drawable)([self._rim(radius, text, strong, weak),
                                                     self._pill_fill(max(0.0, radius - rim), fill, alpha)]))
            layers.setLayerInset(1, rim, rim, rim, rim)
            return layers
        except Exception as e:
            log(f"[{__name__}] layers failed: {e}")
            return self._glass(radius, text, 22, 40)

    def _press(self, view: Any, on_click: Any):
        track = {"down": False}

        def animate(scale: float, alpha: float, duration: int, spring: bool):
            try:
                from android.view.animation import DecelerateInterpolator, OvershootInterpolator
                view.animate().cancel()
                view.animate().scaleX(float(scale)).scaleY(float(scale)).alpha(float(alpha)).setDuration(
                    duration).setInterpolator(
                    OvershootInterpolator(1.4) if spring else DecelerateInterpolator()).start()
            except Exception as e:
                log(f"[{__name__}] press animation failed: {e}")

        def on_touch(v, event):
            action = int(event.getActionMasked())
            if action == 0:
                track["down"] = True
                try:
                    v.getParent().requestDisallowInterceptTouchEvent(True)
                except Exception:
                    pass
                animate(BTN_SCALE, 0.82, BTN_DOWN_MS, False)
                return True
            if action in (1, 3) and track["down"]:
                track["down"] = False
                animate(1.0, 1.0, BTN_UP_MS, True)
                if action == 1:
                    x, y = float(event.getX()), float(event.getY())
                    if 0 <= x <= float(v.getWidth()) and 0 <= y <= float(v.getHeight()):
                        on_click()
                return True
            return True

        view.setOnTouchListener(self._touch(on_touch))
        return view

    def _button(self, activity: Any, label: str, on_click: Any, text: int, primary: bool = False,
                single: bool = True):
        from android.view import Gravity
        from org.telegram.messenger import AndroidUtilities
        dp = AndroidUtilities.dp
        tv = self._text_view(activity, label, 13, text, True, Gravity.CENTER)
        tv.setSingleLine(single)
        tv.setBackground(self._glass_layers(dp(20), text, 0.2 if primary else 0.07, 240 if primary else 232,
                                            90 if primary else 70, 20 if primary else 12))
        tv.setPadding(int(dp(12)), int(dp(11)), int(dp(12)), int(dp(11)))
        return self._press(tv, on_click)

    def _tab_icon(self, activity: Any, kind: str, text: int):
        from android.widget import ImageView
        from org.telegram.messenger import AndroidUtilities
        size = int(AndroidUtilities.dp(ICON_DP))
        d = _Draw(size, size, float(AndroidUtilities.density), text, text)
        _draw_icon(d, kind, text)
        iv = ImageView(activity)
        iv.setImageBitmap(d.bmp)
        return iv

    def _glass_control(self, activity: Any, count: int, width: int, height: int, make_cell: Any,
                       selected: int, on_select: Any, text: int):
        from android.widget import FrameLayout, LinearLayout
        from android.view import View
        from org.telegram.messenger import AndroidUtilities
        dp = AndroidUtilities.dp
        inset = int(dp(BAR_INSET_DP))
        rim = int(max(1, dp(1)))
        tab_w = float(width - 2 * inset) / count
        thumb_h = height - 2 * inset
        bg = self._theme_bg()
        body_color = _blend(bg, text, 0.07)
        thumb_color = _blend(bg, text, 0.2)

        frame = FrameLayout(activity)
        frame.setBackground(self._rim(height / 2.0, text))
        frame.setClipChildren(False)
        base = FrameLayout.LayoutParams(-1, -1)
        base.setMargins(rim, rim, rim, rim)
        body = View(activity)
        body.setBackground(self._pill_fill(height / 2.0 - rim, body_color, 232))
        frame.addView(body, base)

        thumb = FrameLayout(activity)
        try:
            thumb.setLayerType(2, None)
        except Exception:
            pass
        thumb.setBackground(self._rim(thumb_h / 2.0, text, 90, 20))
        inner = View(activity)
        inner.setBackground(self._pill_fill(thumb_h / 2.0 - rim, thumb_color, 255))
        inner_lp = FrameLayout.LayoutParams(-1, -1)
        inner_lp.setMargins(rim, rim, rim, rim)
        thumb.addView(inner, inner_lp)
        lp = FrameLayout.LayoutParams(int(tab_w), thumb_h)
        lp.setMargins(inset, inset, 0, 0)
        frame.addView(thumb, lp)
        thumb.setTranslationX(float(selected * tab_w))

        row = LinearLayout(activity)
        row.setOrientation(LinearLayout.HORIZONTAL)
        row.setPadding(inset, 0, inset, 0)
        labels = []
        for i in range(count):
            cell, label = make_cell(i)
            labels.append(label)
            row.addView(cell, LinearLayout.LayoutParams(0, -1, 1.0))
        frame.addView(row, FrameLayout.LayoutParams(-1, -1))

        api: Dict[str, Any] = {"index": selected, "labels": labels, "thumb": thumb, "tab_w": tab_w}
        track = {"down": False, "drag": False, "start": 0.0, "base": 0.0, "x": 0.0}
        slop = float(dp(SLOP_DP))

        def nearest(pos: float) -> int:
            return max(0, min(count - 1, int(round(pos / tab_w))))

        def index_at(x: float) -> int:
            return max(0, min(count - 1, int((x - inset) // tab_w)))

        def emphasize(idx: int):
            for i, tv in enumerate(labels):
                tv.setAlpha(1.0 if i == idx else 0.62)

        def animate(target_x: Any, scale: float, duration: int, overshoot: bool):
            try:
                from android.view.animation import OvershootInterpolator, DecelerateInterpolator
                thumb.animate().cancel()
                chain = thumb.animate()
                if target_x is not None:
                    chain = chain.translationX(float(target_x))
                chain.scaleX(float(scale)).scaleY(float(scale)).setDuration(duration).setInterpolator(
                    OvershootInterpolator(1.0) if overshoot else DecelerateInterpolator()).start()
            except Exception as e:
                log(f"[{__name__}] animation failed: {e}")
                if target_x is not None:
                    thumb.setTranslationX(float(target_x))

        def set_index(idx: int, animated: bool = True):
            idx = max(0, min(count - 1, int(idx)))
            api["index"] = idx
            emphasize(idx)
            if animated:
                animate(idx * tab_w, 1.0, SNAP_MS, True)
            else:
                try:
                    thumb.animate().cancel()
                except Exception:
                    pass
                thumb.setTranslationX(float(idx * tab_w))

        def on_touch(view, event):
            action = int(event.getActionMasked())
            x = float(event.getX())
            if action == 0:
                try:
                    view.getParent().requestDisallowInterceptTouchEvent(True)
                except Exception:
                    pass
                base_pos = api["index"] * tab_w
                track.update(down=True, drag=False, start=x, base=base_pos, x=base_pos)
                emphasize(index_at(x))
                animate(None, PRESS_SCALE, PRESS_MS, False)
                return True
            if action == 2 and track["down"]:
                if not track["drag"] and abs(x - track["start"]) > slop:
                    track["drag"] = True
                if track["drag"]:
                    pos = max(0.0, min((count - 1) * tab_w, track["base"] + (x - track["start"])))
                    track["x"] = pos
                    try:
                        thumb.animate().cancel()
                    except Exception:
                        pass
                    thumb.setTranslationX(float(pos))
                    emphasize(nearest(pos))
                return True
            if action in (1, 3) and track["down"]:
                track["down"] = False
                if track["drag"]:
                    idx = nearest(track["x"])
                elif action == 1:
                    idx = index_at(x)
                else:
                    idx = api["index"]
                changed = idx != api["index"]
                set_index(idx, True)
                if changed:
                    on_select(idx)
                return True
            return True

        frame.setOnTouchListener(self._touch(on_touch))
        emphasize(selected)
        api["set"] = set_index
        return frame, api

    def _tabs(self, state: Dict[str, Any], text: int, muted: int, accent: int):
        from android.widget import LinearLayout
        from android.view import Gravity
        from org.telegram.messenger import AndroidUtilities
        dp = AndroidUtilities.dp
        activity = state["activity"]
        width = int(AndroidUtilities.displaySize.x - 2 * dp(BAR_SIDE_DP))

        def make_cell(i: int):
            cell = LinearLayout(activity)
            cell.setOrientation(LinearLayout.VERTICAL)
            cell.setGravity(Gravity.CENTER)
            cell.addView(self._tab_icon(activity, TAB_ICONS[i], text))
            tv = self._text_view(activity, _t(TABS[i]), 10.5, text, True, Gravity.CENTER)
            tv.setSingleLine(True)
            cell.addView(tv)
            return cell, tv

        frame, api = self._glass_control(activity, len(TABS), width, int(dp(BAR_HEIGHT_DP)), make_cell,
                                         state["tab"], lambda idx: self._show_tab(state, idx), text)
        state["tab_labels"] = api["labels"]
        state["thumb"] = api["thumb"]
        state["tab_api"] = api
        holder = LinearLayout(activity)
        holder.setClipChildren(False)
        holder.setPadding(int(dp(BAR_SIDE_DP)), 0, int(dp(BAR_SIDE_DP)), int(dp(BAR_LIFT_DP)))
        try:
            frame.setElevation(float(dp(6)))
        except Exception:
            pass
        holder.addView(frame, LinearLayout.LayoutParams(width, int(dp(BAR_HEIGHT_DP))))
        return holder

    def _segment(self, state: Dict[str, Any], labels: List[str], current: Any, on_select: Any,
                 text: int):
        from android.view import Gravity
        from org.telegram.messenger import AndroidUtilities
        dp = AndroidUtilities.dp
        activity = state["activity"]
        width = int(AndroidUtilities.displaySize.x - 2 * dp(16))

        def make_cell(i: int):
            tv = self._text_view(activity, labels[i], 12, text, True, Gravity.CENTER)
            tv.setSingleLine(True)
            return tv, tv

        frame, api = self._glass_control(activity, len(labels), width, int(dp(SEG_HEIGHT_DP)), make_cell,
                                         current(), on_select, text)
        return frame, api

    def _refresh_sheet(self):
        state = getattr(self, "_state", None)
        if state and state.get("contents"):
            def go():
                state["stale"] = set(range(len(TABS))) - {state["tab"]}
                self._render(state)
                run_on_ui_thread(lambda: self._prebuild(state), PREBUILD_MS)
            run_on_ui_thread(go)

    def _render(self, state: Dict[str, Any], tab: Any = None, fade: bool = False):
        try:
            self._render_content(state, state["tab"] if tab is None else tab, fade)
        except Exception as e:
            log(f"[{__name__}] render failed: {e}")
            self._toast(_t("t_draw_fail", f"{type(e).__name__}: {str(e)[:140]}"))

    def _fade_in(self, view: Any, duration: int = FADE_MS):
        try:
            from android.view.animation import DecelerateInterpolator
            view.animate().cancel()
            view.setAlpha(0.0)
            view.animate().alpha(1.0).setDuration(duration).setInterpolator(DecelerateInterpolator()).start()
        except Exception as e:
            log(f"[{__name__}] fade failed: {e}")
            view.setAlpha(1.0)

    def _range_changed(self, state: Dict[str, Any]):
        tab = state["tab"]

        def work():
            try:
                self._warm(state, tab)
            except Exception as e:
                log(f"[{__name__}] warm failed: {e}")
            run_on_ui_thread(lambda: self._render(state, tab, True))

        run_on_queue(work)
        self._invalidate_others(state)

    def _text_view(self, activity: Any, text: str, size: float, color: int, bold: bool = False,
                   gravity: int = None):
        from android.widget import TextView
        from android.graphics import Typeface
        tv = TextView(activity)
        tv.setText(text)
        tv.setTextSize(float(size))
        tv.setTextColor(color)
        if bold:
            tv.setTypeface(Typeface.DEFAULT_BOLD)
        if gravity is not None:
            tv.setGravity(gravity)
        return tv

    def _image(self, activity: Any, draw: Any):
        from android.widget import ImageView
        iv = ImageView(activity)
        iv.setImageBitmap(draw.bmp)
        iv.setAdjustViewBounds(True)
        return iv

    def _margin(self, view: Any, left: int = 0, top: int = 0, right: int = 0, bottom: int = 0,
                width: int = -1, weight: float = None):
        from android.widget import LinearLayout
        from org.telegram.messenger import AndroidUtilities
        dp = AndroidUtilities.dp
        if weight is None:
            lp = LinearLayout.LayoutParams(width, -2)
        else:
            lp = LinearLayout.LayoutParams(0, -2, float(weight))
        lp.setMargins(int(dp(left)), int(dp(top)), int(dp(right)), int(dp(bottom)))
        view.setLayoutParams(lp)
        return view

    def _chart(self, state: Dict[str, Any], name: str, height_dp: float, painter: Any):
        from org.telegram.messenger import AndroidUtilities
        text, muted, accent = state["colors"]
        width = int(AndroidUtilities.displaySize.x - 2 * AndroidUtilities.dp(16))
        stamp = (name, self._rev, state["key"], width, int(height_dp), text, muted, accent, _lang(),
                 state["account"])
        with self._lock:
            hit = self._draws.get(stamp)
            if hit is not None:
                self._draws.move_to_end(stamp)
                return hit
        d = _Draw(width, int(AndroidUtilities.dp(height_dp)), float(AndroidUtilities.density), text, muted,
                  accent)
        painter(d)
        with self._lock:
            self._draws[stamp] = d
            while len(self._draws) > CACHE_DRAWS:
                self._draws.popitem(last=False)
        return d

    def _chart_specs(self, rep: Dict[str, Any], state: Dict[str, Any]) -> "OrderedDict[str, Tuple[float, Any]]":
        specs: "OrderedDict[str, Tuple[float, Any]]" = OrderedDict()
        specs["bars"] = (190, lambda d: _draw_bars(d, rep["series"]))
        parts = [(_t(KIND_KEYS[k]), rep["kinds"].get(k, 0)) for k in KIND_ORDER if rep["kinds"].get(k, 0) > 0]

        def donut(d):
            _draw_donut(d, [(label, value, d.palette[i % len(d.palette)])
                            for i, (label, value) in enumerate(parts)])

        specs["donut"] = (max(150, 30 * max(len(parts), 3) + 20), donut)
        if rep["top"]:
            specs["top"] = (36 * len(rep["top"]) + 4, lambda d: _draw_top(d, rep["top"]))
        if state["key"] in ("week", "month", "all") and rep["total"]:
            specs["heat"] = (18 * 7 + 22, lambda d: _draw_heat(d, rep["matrix"]))
        return specs

    def _warm(self, state: Dict[str, Any], tab: int):
        rep = self._report_cached(state["account"], state["key"])
        if tab == 0:
            for name, (height, painter) in self._chart_specs(rep, state).items():
                self._chart(state, name, height, painter)

    def _render_content(self, state: Dict[str, Any], tab: int, fade: bool = False):
        from android.widget import LinearLayout
        from org.telegram.messenger import AndroidUtilities
        activity = state["activity"]
        content = state["contents"][tab] if state.get("contents") else state["content"]
        state.setdefault("built", {})[tab] = self._rev
        state.setdefault("stale", set()).discard(tab)
        account = state["account"]
        text, muted, accent = state["colors"] if state.get("colors") else self._theme_colors()
        state.setdefault("colors", (text, muted, accent))
        rep = self._report_cached(account, state["key"])
        width = int(AndroidUtilities.displaySize.x - 2 * AndroidUtilities.dp(16))
        dp = AndroidUtilities.dp
        ctl_map = state.setdefault("ctl", {})
        ctl = ctl_map.get(tab)
        first = ctl is None
        if first:
            top = LinearLayout(activity)
            top.setOrientation(LinearLayout.VERTICAL)
            body = LinearLayout(activity)
            body.setOrientation(LinearLayout.VERTICAL)
            content.addView(top, LinearLayout.LayoutParams(-1, -2))
            content.addView(body, LinearLayout.LayoutParams(-1, -2))
            ctl = {"top": top, "body": body, "syncs": [], "fill": None}
            ctl_map[tab] = ctl
        else:
            for sync in ctl["syncs"]:
                sync()
        body = ctl["body"]
        body.removeAllViews()
        if tab == 0:
            state["progress_tv"] = None
        target = [body]

        def add(view, **margins):
            target[0].addView(self._margin(view, **margins))

        def add_fixed(view, height_dp: float, bottom: float = 10):
            lp = LinearLayout.LayoutParams(-1, int(dp(height_dp)))
            lp.setMargins(0, 0, 0, int(dp(bottom)))
            target[0].addView(view, lp)

        def safe(name, fn):
            try:
                fn()
            except Exception as e:
                log(f"[{__name__}] block {name} failed: {type(e).__name__}: {e}")
                add(self._text_view(activity, f"{name}: {type(e).__name__}: {str(e)[:140]}", 12, muted),
                    top=6)

        def section(title: str):
            add(self._text_view(activity, title, 15, text, True), top=18, bottom=6)

        def refill(animated: bool = False):
            fn = ctl.get("fill")
            if fn:
                fn(animated)

        def range_control():
            def on_range(idx):
                state["key"] = RANGES[idx]
                self._range_changed(state)

            frame, api = self._segment(state, [_t("r_" + k) for k in RANGES],
                                       lambda: RANGES.index(state["key"]), on_range, text)
            ctl["syncs"].append(lambda: api["set"](RANGES.index(state["key"]), False))
            add_fixed(frame, SEG_HEIGHT_DP)

        def search_box():
            from android.widget import EditText
            et = EditText(activity)
            et.setHint(_t("search"))
            et.setSingleLine(True)
            et.setTextSize(15.0)
            et.setTextColor(text)
            et.setHintTextColor(_ji(_argb(muted)))
            et.setBackground(self._glass_layers(dp(20), text, 0.05, 232, 60, 10))
            et.setPadding(int(dp(16)), int(dp(10)), int(dp(16)), int(dp(10)))
            et.setText(state["query"])

            def on_query(value: str):
                state["query"] = value
                state["limit"] = CHAT_ROWS
                refill()

            et.addTextChangedListener(self._watcher(on_query))
            add(et, bottom=10)

        def sort_control():
            def on_sort(idx):
                state["sort"] = SORTS[idx]
                refill(True)

            frame, api = self._segment(state, [_t("sort_" + k) for k in SORTS],
                                       lambda: SORTS.index(state["sort"]), on_sort, text)
            ctl["syncs"].append(lambda: api["set"](SORTS.index(state["sort"]), False))
            add_fixed(frame, SEG_HEIGHT_DP)

        def type_control():
            def on_type(idx):
                state["type"] = TYPES[idx]
                refill(True)

            labels = [_t("f_all") if k == "all" else _t(KIND_KEYS[k]) for k in TYPES]
            frame, api = self._segment(state, labels, lambda: TYPES.index(state["type"]), on_type, text)
            ctl["syncs"].append(lambda: api["set"](TYPES.index(state["type"]), False))
            add_fixed(frame, SEG_HEIGHT_DP, 12)

        def intro():
            if self._history_loaded(account):
                return
            if self._bf.get("running"):
                tv = self._text_view(activity, self._progress_text(), 13, muted)
                state["progress_tv"] = tv
                add(tv, bottom=14)
                return
            if state.get("later"):
                return
            add(self._text_view(activity, _t("intro"), 14, text), bottom=8)

            def later():
                state["later"] = True
                self._render(state, tab, True)

            def load():
                self.start_history(account)
                self._render(state, tab, True)

            row = LinearLayout(activity)
            row.setOrientation(LinearLayout.HORIZONTAL)
            row.addView(self._margin(self._button(activity, _t("btn_load"), load, text, True, False),
                                     right=6, weight=2.0))
            row.addView(self._margin(self._button(activity, _t("btn_later"), later, text), weight=1.0))
            add(row, bottom=14)

        specs = self._chart_specs(rep, state) if tab == 0 else {}

        def totals():
            row = LinearLayout(activity)
            row.setOrientation(LinearLayout.HORIZONTAL)
            peak_label, peak_value = rep["peak"]
            has = rep["total"] > 0
            for number, caption in (
                (_fmt_num(rep["total"]), _t("kpi_total")),
                (_fmt_num(rep["chats"]), _t("kpi_chats")),
                (_fmt_num(peak_value) if has else "0",
                 _t("kpi_peak_at", peak_label) if has and peak_label else _t("kpi_peak")),
            ):
                cell = LinearLayout(activity)
                cell.setOrientation(LinearLayout.VERTICAL)
                cell.addView(self._text_view(activity, number, 24, text, True))
                cell.addView(self._text_view(activity, caption, 12, muted))
                row.addView(self._margin(cell, weight=1.0))
            add(row, bottom=6)

        def chart(title_key: str, name: str):
            if name not in specs:
                return
            section(_t(title_key))
            height, painter = specs[name]
            add(self._image(activity, self._chart(state, name, height, painter)))

        def chat_list():
            list_box = LinearLayout(activity)
            list_box.setOrientation(LinearLayout.VERTICAL)

            def fill_list(animated: bool = False):
                list_box.removeAllViews()
                rows = chat_rows(rep["rows"], state)
                if not rows:
                    list_box.addView(self._text_view(activity, _t("none"), 13, muted))
                else:
                    vmax = max(r["count"] for r in rows) or 1
                    limit = int(state.get("limit", CHAT_ROWS))
                    for r in rows[:limit]:
                        list_box.addView(self._chat_row(activity, r, vmax, width, text, muted, accent,
                                                        rep["off"]))
                    if len(rows) > limit:
                        def more():
                            state["limit"] = limit + CHAT_ROWS
                            fill_list(True)

                        note = self._text_view(activity, _t("more", len(rows) - limit), 13, accent, True)
                        note.setPadding(0, int(dp(10)), 0, int(dp(10)))
                        list_box.addView(self._press(note, more))
                if animated:
                    self._fade_in(list_box)

            ctl["fill"] = fill_list
            add(list_box)
            fill_list()

        def about():
            add(self._text_view(activity, __name__, 18, text, True), bottom=2)
            add(self._text_view(activity, _t("s_version", __version__) + "  " + __author__, 13, muted), bottom=2)
            add(self._text_view(activity, _t("s_about"), 13, muted), bottom=14)

        def link_rows():
            add(self._setting_row(activity, _t("s_channel"), "@metawkaPlugins",
                                  lambda: self._open_url(CHANNEL_URL), text, muted, accent), bottom=8)
            add(self._setting_row(activity, _t("s_author"), "@metawka",
                                  lambda: self._open_url(AUTHOR_URL), text, muted, accent), bottom=14)

        def setting_rows():
            loaded = self._history_loaded(account)
            status = self._progress_text() if self._bf.get("running") else (
                _t("s_loaded") if loaded else _t("s_not_loaded"))

            def reload():
                self.start_history(account)
                self._render(state, tab, True)

            section(_t("s_debug"))
            add(self._setting_row(activity, _t("btn_load"), status, lambda: self._confirm(
                _t("s_load_ask"), _t("s_start"), reload), text, muted, accent), bottom=8)
            with self._lock:
                errs = list(self._data["histinfo"].get(str(account), {}).get("errors", []))
            if errs:
                lines = "\n".join(f"{_title_text(t)}: {m}" for t, m in errs[:3])
                add(self._text_view(activity, _t("s_errors") + "\n" + lines, 12, muted), bottom=8)
            with self._lock:
                diag = list(self._data["histinfo"].get(str(account), {}).get("diag", []))
            if len(diag) >= 3:
                src = _t("s_diag_src") if len(diag) > 3 and diag[3] else ""
                add(self._text_view(activity, _t("s_diag", diag[0], diag[1], _fmt_num(diag[2]), src), 12, muted),
                    bottom=4)
                if len(diag) > 4 and diag[4]:
                    add(self._text_view(activity, _t("s_diag_list", diag[4]), 12, muted), bottom=4)
                if len(diag) > 5 and diag[5]:
                    add(self._text_view(activity, _t("s_diag_search", diag[5]), 12, muted), bottom=4)
                if len(diag) > 6 and diag[6]:
                    add(self._text_view(activity, _t("s_diag_direct"), 12, muted), bottom=4)
            msgs, chats = self._account_totals(account)
            add(self._text_view(activity, _t("s_hist_sum", _fmt_num(msgs), chats), 12, muted), bottom=4)
            key, detail = getattr(self, "_top_status", ("s_top_none", ""))
            add(self._text_view(activity, _t(key, detail) if detail else _t(key), 12, muted), bottom=8)
            add(self._setting_row(activity, _t("s_reset"), "", lambda: self._confirm(
                _t("s_reset_ask"), _t("s_yes"), lambda: self._reset(state)), text, muted, accent), bottom=8)

        if first:
            target[0] = ctl["top"]
            if tab == 0:
                safe("range", range_control)
            elif tab == 1:
                for name, fn in (("range", range_control), ("search", search_box), ("sort", sort_control),
                                 ("filter", type_control)):
                    safe(name, fn)
            target[0] = body
        if tab == 0:
            blocks = (("intro", intro), ("totals", totals), ("activity", lambda: chart("sec_bars", "bars")),
                      ("types", lambda: chart("sec_kinds", "donut")), ("top", lambda: chart("sec_top", "top")),
                      ("heat", lambda: chart("sec_heat", "heat")))
        elif tab == 1:
            blocks = (("list", chat_list),)
        else:
            blocks = (("about", about), ("links", link_rows), ("settings", setting_rows))
        for name, fn in blocks:
            safe(name, fn)
        if fade:
            self._fade_in(body)

    def _setting_row(self, activity: Any, title: str, subtitle: str, on_click: Any, text: int,
                     muted: int, accent: int):
        from android.widget import LinearLayout
        from org.telegram.messenger import AndroidUtilities
        dp = AndroidUtilities.dp
        box = LinearLayout(activity)
        box.setOrientation(LinearLayout.VERTICAL)
        box.setBackground(self._glass_layers(dp(18), text, 0.07, 232, 60, 10))
        box.setPadding(int(dp(16)), int(dp(13)), int(dp(16)), int(dp(13)))
        box.addView(self._text_view(activity, title, 15, text, True))
        if subtitle:
            box.addView(self._text_view(activity, subtitle, 12, muted))
        return self._press(box, on_click)

    def _chat_row(self, activity: Any, row: Dict[str, Any], vmax: int, width: int, text: int,
                  muted: int, accent: int, off: int):
        from android.widget import LinearLayout
        from android.view import View
        from android.graphics.drawable import GradientDrawable
        from org.telegram.messenger import AndroidUtilities
        dp = AndroidUtilities.dp
        box = LinearLayout(activity)
        box.setOrientation(LinearLayout.VERTICAL)
        box.setPadding(0, int(dp(8)), 0, int(dp(8)))
        top = LinearLayout(activity)
        top.setOrientation(LinearLayout.HORIZONTAL)
        name = self._text_view(activity, _short(row["title"], 40), 15, text, True)
        name.setSingleLine(True)
        top.addView(name, LinearLayout.LayoutParams(0, -2, 1.0))
        top.addView(self._text_view(activity, _fmt_num(row["count"]), 15, text, True))
        box.addView(top)
        last = _day_label((row["last"] + off) // DAY)[1] if row["last"] else ""
        sub = _t("row_sub", _t(KIND_KEYS.get(row["kind"], "kind_user")), last) if last else \
            _t(KIND_KEYS.get(row["kind"], "kind_user"))
        box.addView(self._text_view(activity, sub, 12, muted))
        bar = View(activity)
        shape = GradientDrawable()
        shape.setCornerRadius(float(dp(2)))
        shape.setColor(_ji(_argb(accent, 220)))
        bar.setBackground(shape)
        fill = max(int(dp(4)), int((width - 0) * row["count"] / float(vmax)))
        lp = LinearLayout.LayoutParams(fill, int(dp(3)))
        lp.setMargins(0, int(dp(5)), 0, 0)
        box.addView(bar, lp)
        return box

    def _reset(self, state: Dict[str, Any]):
        acc = str(state["account"])
        with self._lock:
            for key in ("live", "hist", "histinfo", "histstate", "meta"):
                self._data[key].pop(acc, None)
            self._data["since"][acc] = int(_time.time())
            self._seen.clear()
            self._meta_cache.clear()
        self._mark_dirty()
        self._flush()
        self._wipe_backups()
        self._total = 0
        self._rev += 1
        self._main_total = 0
        self._toast(_t("t_reset"), False)
        self._render(state)


def chat_rows(rows: List[Dict[str, Any]], state: Dict[str, Any]) -> List[Dict[str, Any]]:
    query = str(state.get("query", "")).strip().lower()
    kind = state.get("type", "all")
    out = [r for r in rows
           if (kind == "all" or r["kind"] == kind) and (not query or query in str(r["title"]).lower())]
    sort = state.get("sort", "count")
    if sort == "name":
        out.sort(key=lambda r: str(r["title"]).lower())
    elif sort == "recent":
        out.sort(key=lambda r: (-r["last"], -r["count"]))
    else:
        out.sort(key=lambda r: (-r["count"], str(r["title"]).lower()))
    return out
