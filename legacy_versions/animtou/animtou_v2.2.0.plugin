__id__ = "animtou"
__name__ = "Анимированные касания"
__description__ = "добавляет прикольную анимацию при каждом нажатии\n(идея — @itskotovski и @mishabotov)"
__author__ = "@jaxbastard & @zwylair"
__version__ = "2.2.0"
__icon__ = "RandomStikery324/35"
__min_version__ = "12.5.1"

from typing import Any, List
import traceback
import time
from java import jclass
from android_utils import run_on_ui_thread, copy_to_clipboard
from base_plugin import BasePlugin, MethodHook
from java.lang import Class as JClass, Boolean
from ui.settings import Header, Custom, Divider, Text
from ui.bulletin import BulletinHelper
from client_utils import get_last_fragment, get_messages_controller
from base_plugin import MenuItemData, MenuItemType
from hook_utils import find_class, get_private_field, set_private_field

from android.graphics import RuntimeShader, RenderEffect
from android.os import Build
from android.view import WindowManagerGlobal
from org.telegram.messenger import R, AndroidUtilities
from org.telegram.ui.Stars import SuperRipple

UPDATE_CHANNEL_ID = 3726559342
UPDATE_MESSAGE_ID = 4

_ripple_cache = {}
_max_cache_size = 30
_patched_shader_code = None
_current_dose = 0.01


def _show_copyable_error(short_msg, exc):
    try:
        trace = "".join(traceback.format_exception(type(exc), exc, exc.__traceback__))
        BulletinHelper.show_with_button(
            short_msg,
            jclass("org.telegram.messenger.R").raw.error,
            "Copy",
            on_click=lambda: copy_to_clipboard(trace)
        )
    except Exception:
        pass


def patch_shader_code(code):
    code = "uniform float dose;\n" + code
    replace_map = {
        "return half4(0.0, 0.0, 0.0, 1.0);": "return half4(0.0, 0.0, 0.0, 0.0);",
        "return img.eval(uv) + half4(add, add, add, 1.);": (
            "half2 off = offset * dose;"
            "return half4(img.eval(uv + off).r, img.eval(uv).g, img.eval(uv - off).b, img.eval(uv).a) + half4(add, add, add, 0.0);"
        ),
        "sdfRoundedBox(uv - size * .5, size * .5, radius)": "sdfRoundedBox(uv - size * .5, size * .5, float4(0.0))",
    }
    for k, v in replace_map.items():
        code = code.replace(k, v)
    return code


def _get_patched_shader_code():
    global _patched_shader_code
    if _patched_shader_code is None:
        _patched_shader_code = patch_shader_code(AndroidUtilities.readRes(R.raw.superripple_effect))
    return _patched_shader_code


def _make_patched_ripple(view):
    ripple = SuperRipple(view)
    try:
        code = _get_patched_shader_code()
        method = ripple.getClass().getDeclaredMethod("setupSizeUniforms", Boolean.TYPE)
        method.setAccessible(True)
        shader = RuntimeShader(code)
        shader.setFloatUniform("dose", _current_dose)
        set_private_field(ripple, "shader", shader)
        method.invoke(ripple, True)
        set_private_field(ripple, "effect", RenderEffect.createRuntimeShaderEffect(shader, "img"))
    except Exception as e:
        _show_copyable_error("animtou: shader patch error", e)
    return ripple


def _set_current_dose(value):
    global _current_dose
    _current_dose = value
    _ripple_cache.clear()


class _animtouHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        try:
            motion_event = param.args[0] if param.args and len(param.args) > 0 else None
            if motion_event is None:
                return
        except Exception:
            return

        try:
            this_object = param.thisObject
        except Exception:
            return

        try:
            self.plugin._handle_touch(this_object, motion_event)
        except Exception as e:
            try:
                _show_copyable_error("animtou: hook error", e)
            except Exception:
                pass

    def after_hooked_method(self, param):
        return


_mviews_field_cache = {"field": None}


def _get_mviews_field():
    if _mviews_field_cache["field"] is not None:
        return _mviews_field_cache["field"]
    try:
        Class = jclass("java.lang.Class")
        wmg_class = Class.forName("android.view.WindowManagerGlobal")
        field = wmg_class.getDeclaredField("mViews")
        field.setAccessible(True)
        _mviews_field_cache["field"] = field
        return field
    except Exception:
        return None


def _read_mviews():
    wmg_instance = WindowManagerGlobal.getInstance()
    field = _get_mviews_field()
    if field is not None:
        return field.get(wmg_instance)
    return get_private_field(wmg_instance, "mViews")


def get_all_decor_views():
    try:
        views = _read_mviews()
        if views is None:
            return []
        result = []
        for i in range(views.size()):
            view = views.get(i)
            if view is not None:
                result.append(view)
        return result
    except Exception:
        return []


def screen_to_local(view, raw_x, raw_y):
    try:
        loc = [0, 0]
        view.getLocationOnScreen(loc)
        return raw_x - loc[0], raw_y - loc[1]
    except Exception:
        return raw_x, raw_y


def make_ripple(view, x, y, intensity):
    def _internal():
        if view is None:
            return
        if Build.VERSION.SDK_INT < Build.VERSION_CODES.TIRAMISU:
            return

        key = view.hashCode()
        if key not in _ripple_cache or _ripple_cache[key] is None:
            _ripple_cache[key] = _make_patched_ripple(view)
            if len(_ripple_cache) > _max_cache_size:
                oldest = next(iter(_ripple_cache))
                del _ripple_cache[oldest]

        _ripple_cache[key].animate(x, y, intensity)

    run_on_ui_thread(_internal)


ECHO_WINDOW_MS = 300
ECHO_POLL_INTERVAL_MS = 80

_echo_state = {
    "active_until": 0,
    "x": 0.0,
    "y": 0.0,
    "intensity": 0.6,
    "known_views": set(),
    "last_seen_size": None,
}


def _echo_poll():
    now = int(time.time() * 1000)
    if now >= _echo_state["active_until"]:
        return

    try:
        views = _read_mviews()
        if views is not None:
            size = views.size()
            if size != _echo_state["last_seen_size"]:
                _echo_state["last_seen_size"] = size
                for i in range(size):
                    view = views.get(i)
                    if view is None:
                        continue
                    key = view.hashCode()
                    if key in _echo_state["known_views"]:
                        continue
                    _echo_state["known_views"].add(key)
                    lx, ly = screen_to_local(view, _echo_state["x"], _echo_state["y"])
                    make_ripple(view, lx, ly, _echo_state["intensity"])
    except Exception:
        pass

    run_on_ui_thread(_echo_poll, ECHO_POLL_INTERVAL_MS)


def _start_echo_tracking(x, y, intensity, known_views):
    was_active = _echo_state["active_until"] > int(time.time() * 1000)
    _echo_state["x"] = x
    _echo_state["y"] = y
    _echo_state["intensity"] = intensity
    _echo_state["known_views"] = known_views
    _echo_state["last_seen_size"] = None
    _echo_state["active_until"] = int(time.time() * 1000) + ECHO_WINDOW_MS
    if not was_active:
        run_on_ui_thread(_echo_poll, ECHO_POLL_INTERVAL_MS)


class animtouPlugin(BasePlugin):
    INTENSITY_MIN = 0.1
    INTENSITY_MAX = 3.0
    INTENSITY_SCALE = 0.1
    INTENSITY_UI_MIN = 1
    INTENSITY_UI_MAX = 30

    DOSE_UI_MIN = 0
    DOSE_UI_MAX = 30
    DOSE_SCALE = 0.1

    def __init__(self):
        super().__init__()
        self.view_unhook_ref = None
        self._cached_intensity = 0.7
        self._cached_dose_ui = self.DOSE_UI_MIN
        self._last_down_token = None
        self._last_up_token = None
        self._seekbar_refs = []

    def on_plugin_load(self):
        try:
            import zwylib
            zwylib.add_autoupdater_task(id, UPDATE_CHANNEL_ID, UPDATE_MESSAGE_ID)
            if self.get_setting("zwylib_missing", False):
                BulletinHelper.show_info("zwylib обнаружена, автообновление доступно")
                self.set_setting("zwylib_missing", False)
        except ImportError:
            run_on_ui_thread(
                lambda: BulletinHelper.show_error("animtou доступен, но без автообновления"),
                2000
            )
            self.set_setting("zwylib_missing", True)

        try:
            self._refresh_settings_cache()

            try:
                view_cls = JClass.forName("android.view.View")
                motion_event_cls = JClass.forName("android.view.MotionEvent")
            except Exception as e:
                _show_copyable_error("animtou: Class.forName failed", e)
                return

            dispatch_method = None
            try:
                dispatch_method = view_cls.getDeclaredMethod("dispatchTouchEvent", motion_event_cls)
            except Exception as e:
                _show_copyable_error("animtou: Could not find View.dispatchTouchEvent", e)
                return

            if not dispatch_method:
                BulletinHelper.show_error("animtou: не нашел dispatchTouchEvent для хука")
                return

            try:
                dispatch_method.setAccessible(True)
            except Exception:
                pass

            self.view_unhook_ref = self.hook_method(dispatch_method, _animtouHook(self), priority=5)
            if self.view_unhook_ref:
                pass
            else:
                BulletinHelper.show_error("animtou: неудача при хуке View.dispatchTouchEvent")
        except Exception as e:
            _show_copyable_error("animtou: setup error", e)

        try:
            def _open_settings(_view=None):
                try:
                    PC = find_class("com.exteragram.messenger.plugins.PluginsController")
                    if PC:
                        PC.openPluginSettings(__id__)
                except Exception as e:
                    _show_copyable_error("animtou: Failed to open settings", e)

            self.add_menu_item(MenuItemData(
                menu_type=MenuItemType.DRAWER_MENU,
                text="animtou",
                subtext="настройки",
                icon="msg_settings",
                on_click=_open_settings,
            ))
        except Exception as e:
            _show_copyable_error("animtou: Failed to add menu items", e)

    def on_plugin_unload(self):
        try:
            import zwylib
            zwylib.remove_autoupdater_task(id)
        except Exception:
            pass

        try:
            if self.view_unhook_ref:
                self.unhook_method(self.view_unhook_ref)
                self.view_unhook_ref = None
        except Exception:
            pass

        try:
            _ripple_cache.clear()
        except Exception:
            pass

        try:
            _echo_state["active_until"] = 0
        except Exception:
            pass

    def _handle_touch(self, owner, motion_event):
        try:
            action_masked = motion_event.getActionMasked()
            if action_masked != 0:
                return

            try:
                dt = float(motion_event.getDownTime())
            except Exception:
                try:
                    dt = float(motion_event.getEventTime())
                except Exception:
                    dt = 0.0
            token = (int(dt), int(action_masked))

            if self._last_down_token is not None and self._last_down_token == token:
                return

            try:
                rx = float(motion_event.getRawX())
                ry = float(motion_event.getRawY())
            except Exception:
                rx = float(motion_event.getX())
                ry = float(motion_event.getY())

            self._last_down_token = token

            all_views = get_all_decor_views()

            if len(all_views) > 1:
                known_views = set()
                for view in all_views:
                    lx, ly = screen_to_local(view, rx, ry)
                    make_ripple(view, lx, ly, self._cached_intensity)
                    known_views.add(view.hashCode())
            else:
                decor = owner.getRootView()
                target = decor if decor is not None else owner
                make_ripple(target, rx, ry, self._cached_intensity)
                known_views = {target.hashCode()} if target is not None else set()

            _start_echo_tracking(rx, ry, self._cached_intensity, known_views)

        except Exception:
            pass

    def _refresh_settings_cache(self):
        try:
            self._cached_intensity = self._clamp_intensity(self._as_float(self.get_setting("intensity", "0.55"), 0.55))
        except Exception:
            self._cached_intensity = 0.55

        try:
            self._cached_dose_ui = self._clamp_dose_ui(self._as_float(self.get_setting("dose", str(self.DOSE_UI_MIN)), self.DOSE_UI_MIN))
        except Exception:
            self._cached_dose_ui = self.DOSE_UI_MIN
        _set_current_dose(self._cached_dose_ui * self.DOSE_SCALE)

    def _as_float(self, s, default):
        try:
            return float(str(s).strip().replace(",", "."))
        except Exception:
            return default

    def _clamp_intensity(self, value):
        return max(self.INTENSITY_MIN, min(self.INTENSITY_MAX, value))

    def _clamp_dose_ui(self, value):
        return max(self.DOSE_UI_MIN, min(self.DOSE_UI_MAX, value))

    def _on_intensity_change(self, ui_value):
        try:
            real = self._clamp_intensity(round(float(ui_value)) * self.INTENSITY_SCALE)
            self._cached_intensity = real
            self.set_setting("intensity", str(real))
        except Exception as e:
            _show_copyable_error("animtou: intensity change error", e)

    def _on_dose_change(self, ui_value):
        try:
            self._cached_dose_ui = self._clamp_dose_ui(round(float(ui_value)))
            _set_current_dose(self._cached_dose_ui * self.DOSE_SCALE)
            self.set_setting("dose", str(self._cached_dose_ui))
        except Exception as e:
            _show_copyable_error("animtou: dose change error", e)

    def _build_seekbar(self, minimum, maximum, default, title, min_label, max_label, on_change):
        try:
            from com.exteragram.messenger.preferences.components import AltSeekbar
            from java import dynamic_proxy
            from org.telegram.messenger import ApplicationLoader

            class _Drag(dynamic_proxy(AltSeekbar.OnDrag)):
                def run(this, value):
                    try:
                        on_change(value)
                    except Exception as e:
                        _show_copyable_error("animtou: seekbar callback error", e)

            listener = _Drag()
            if not hasattr(self, "_seekbar_refs"):
                self._seekbar_refs = []
            self._seekbar_refs.append(listener)

            bar = AltSeekbar(
                ApplicationLoader.applicationContext,
                listener,
                minimum,
                maximum,
                title,
                min_label,
                max_label,
            )
            bar.setProgress(float(default))
            return Custom(view=bar)
        except Exception as e:
            _show_copyable_error("animtou: seekbar build error", e)
            return None

    def _open_channel(self, _view=None):
        try:
            run_on_ui_thread(lambda: get_messages_controller().openByUserName("jxbplug", get_last_fragment(), 1))
        except Exception as e:
            _show_copyable_error("animtou: _open_channel error", e)

    def _open_channel2(self, _view=None):
        try:
            run_on_ui_thread(lambda: get_messages_controller().openByUserName("zwyPlugins", get_last_fragment(), 2))
        except Exception as e:
            _show_copyable_error("animtou: _open_channel2 error", e)

    def _open_idea_author(self, _view=None):
        try:
            run_on_ui_thread(lambda: get_messages_controller().openByUserName("mishabotov", get_last_fragment(), 1))
        except Exception as e:
            _show_copyable_error("animtou: _open_idea_author error", e)

    def create_settings(self):
        intensity_ui_default = round(self._cached_intensity / self.INTENSITY_SCALE)

        items = [
            Header(text="Риппл эффект"),
        ]

        intensity_bar = self._build_seekbar(
            self.INTENSITY_UI_MIN, self.INTENSITY_UI_MAX, intensity_ui_default,
            "Интенсивность", str(self.INTENSITY_UI_MIN), str(self.INTENSITY_UI_MAX),
            self._on_intensity_change,
        )
        if intensity_bar is not None:
            items.append(intensity_bar)

        items.append(Header(text="Уровень дозы"))

        dose_bar = self._build_seekbar(
            self.DOSE_UI_MIN, self.DOSE_UI_MAX, self._cached_dose_ui,
            "Хроматическая аберрация", "выкл.", str(self.DOSE_UI_MAX),
            self._on_dose_change,
        )
        if dose_bar is not None:
            items.append(dose_bar)

        items += [
            Divider(),
            Header(text="Канал"),
            Text(
                text="Бастардские плагины",
                icon="msg_channel",
                on_click=self._open_channel
            ),
            Divider(),
            Header(text="Спасибо за помощь"),
            Text(
                text="zwyPlugins",
                icon="msg_channel",
                on_click=self._open_channel2
            ),
            Divider(),
            Header(text="Автор идеи"),
            Text(
                text="Миша-ня!",
                icon="msg_channel",
                on_click=self._open_idea_author
            ),
            Divider(text=f"animtou v{__version__} // Лс: @jaxbastard"),
        ]

        return items
