_LANG_CACHE = [None, 0.0]


def _lang():
    # Cached for a few seconds: _t() is called many times per screen and each lookup crosses JNI.
    now = time.monotonic()
    if _LANG_CACHE[0] is not None and now - _LANG_CACHE[1] < 3.0:
        return _LANG_CACHE[0]
    _LANG_CACHE[0] = _lang_uncached()
    _LANG_CACHE[1] = now
    return _LANG_CACHE[0]


def _lang_uncached():
    # The client's own language decides; the system language is used only if it can't be read.
    try:
        info = jclass("org.telegram.messenger.LocaleController").getInstance().getCurrentLocaleInfo()
        seen = False
        for getter in ("getLangCode", "getBaseLangCode", "getPluralLangCode"):
            try:
                code = str(getattr(info, getter)() or "").lower().replace("_", "-").split("-", 1)[0]
            except Exception:
                continue
            if code:
                seen = True
                if code in STRINGS:
                    return code
        if seen:
            return "en"
    except Exception:
        pass
    try:
        code = str(jclass("java.util.Locale").getDefault().getLanguage()).lower()
        if code in STRINGS:
            return code
    except Exception:
        pass
    return "en"


def _t(key):
    return STRINGS.get(_lang(), STRINGS["en"]).get(key, key)


def _short(text, limit=22):
    text = " ".join(str(text).split())
    if len(text) <= limit:
        return text
    cut = text[:limit - 1]
    space = cut.rfind(" ")
    if space >= limit // 2:
        cut = cut[:space]
    return cut.rstrip(" ,.-—·") + "…"


def _join_short(names, limit=28):
    out = []
    for i, n in enumerate(names):
        cand = ", ".join(out + [_short(n, 16)])
        rest = len(names) - i - 1
        if len(cand) > limit and out:
            return ", ".join(out) + " +%d" % (len(names) - i)
        out.append(_short(n, 16))
    return ", ".join(out)


def _chats_n(n):
    if _lang() != "ru":
        return _t("chats_one" if n == 1 else "chats_many") % n
    n10, n100 = n % 10, n % 100
    if n10 == 1 and n100 != 11:
        key = "chats_one"
    elif 2 <= n10 <= 4 and not (12 <= n100 <= 14):
        key = "chats_few"
    else:
        key = "chats_many"
    return _t(key) % n


class _Strong(object):
    """Fallback when java.lang.ref.WeakReference is unavailable."""
    def __init__(self, obj):
        self._obj = obj

    def get(self):
        return self._obj

    def clear(self):
        self._obj = None


def _weak(obj):
    # Python closures attached to Java views must not hold the fragment strongly:
    # view -> Java proxy -> Python closure -> fragment is a cross-runtime cycle no GC can free.
    if obj is None:
        return _Strong(None)
    if WeakReference is not None:
        return WeakReference(obj)
    return _Strong(obj)


def _same(ref, obj):
    try:
        cur = ref.get() if ref is not None else None
        return cur is not None and cur == obj
    except Exception:
        return False


def _ident(obj):
    try:
        return int(System.identityHashCode(obj))
    except Exception:
        return 0


def _ui(fn, delay=0):
    def safe():
        try:
            fn()
        except Exception:
            traceback.print_exc()
    if delay:
        run_on_ui_thread(safe, delay)
    else:
        run_on_ui_thread(safe)


def _drawable(name):
    try:
        return int(getattr(jclass("org.telegram.messenger.R$drawable"), name))
    except Exception:
        return 0


def _dp(v):
    return int(jclass("org.telegram.messenger.AndroidUtilities").dp(float(v)))


_Runnable = jclass("java.lang.Runnable")
_JBoolean = jclass("java.lang.Boolean")
_JInteger = jclass("java.lang.Integer")
_OnClick = jclass("android.view.View$OnClickListener")


class _Run(dynamic_proxy(_Runnable)):
    def __init__(self, fn):
        super().__init__()
        self._fn = fn

    def run(self):
        try:
            self._fn()
        except Exception:
            traceback.print_exc()


class _Click(dynamic_proxy(_OnClick)):
    def __init__(self, fn):
        super().__init__()
        self._fn = fn

    def onClick(self, view):
        try:
            self._fn(view)
        except Exception:
            traceback.print_exc()


_TOGGLE_CLICK = None  # one shared listener for all checkbox rows; it holds no views

_PickerDelegate = jclass("org.telegram.ui.UsersSelectActivity$FilterUsersActivityDelegate")


class _Picked(dynamic_proxy(_PickerDelegate)):
    def __init__(self, fn):
        super().__init__()
        self._fn = fn

    def didSelectChats(self, ids, flags):
        try:
            self._fn([int(ids.get(i)) for i in range(int(ids.size()))], int(flags))
        except Exception:
            traceback.print_exc()


class _Hook(MethodHook):
    def __init__(self, before=None, after=None):
        self._before = before
        self._after = after

    def before_hooked_method(self, param):
        if self._before is not None:
            try:
                self._before(param)
            except Exception:
                traceback.print_exc()

    def after_hooked_method(self, param):
        if self._after is not None:
            try:
                self._after(param)
            except Exception:
                traceback.print_exc()


class ArchiveFoldersPlugin(BasePlugin):

    # ---------- lifecycle ----------

    def on_plugin_load(self):
        self._frags = {}
        self._data = {}
        self._sets = {}
        self._chat_item = None
        self._hooks = []
        self._pickers = {}
        self._adapters = {}
        self._helpers = set()
        self._title_views = {}
        self._types = {}
        self._hide_sorted = bool(self.get_setting("hide_sorted", False))
        self._notif_ids = set()
        try:
            nc = jclass("org.telegram.messenger.NotificationCenter")
            for name in ("dialogsNeedReload", "updateInterfaces", "notificationsSettingsUpdated",
                         "dialogFiltersUpdated", "contactsDidLoad", "messagesDidLoad", "didLoadChatInviter"):
                try:
                    self._notif_ids.add(int(getattr(nc, name)))
                except Exception:
                    pass
        except Exception:
            pass
        self._hook_all()
        if self.get_setting("chat_menu", True):
            self._add_chat_menu()

    def on_plugin_unload(self):
        for h in list(self._hooks):
            try:
                self.unhook_method(h)
            except Exception:
                pass
        self._hooks = []
        for st in list(self._frags.values()):
            frag = self._frag_of(st)
            if frag is None:
                continue

            def cleanup(frag=frag, st=st):
                self._detach(frag, st, remove_item=True)
                if st.get("orig_title"):
                    frag.getActionBar().setTitle(st["orig_title"])
                    ref = st.get("tv")
                    tv = ref.get() if ref is not None else None
                    if tv is not None and str(tv.getText() or "") in self._archive_titles(st):
                        tv.setText(st["orig_title"], False)
            _ui(cleanup)
        self._frags = {}
        for ps in list(self._pickers.values()):
            self._restore_limits(ps)
        self._pickers = {}
        self._adapters = {}
        self._helpers = set()
        self._title_views = {}

    # ---------- settings ----------

    def create_settings(self):
        acc = self._selected_account()
        uid = self._uid(acc)
        d = self._load(uid)
        counts = self._counts(acc, uid)
        title = _t("set_folders")
        if self._account_count() > 1:
            title = "%s · %s" % (title, _short(self._account_name(acc), 24))
        rows = [Header(text=title)]
        if not d["folders"]:
            rows.append(Text(text=_t("set_no_folders"), icon="msg_folders"))
        for f in d["folders"]:
            fid = int(f["id"])
            rows.append(Text(
                text=_short(f["name"], 30),
                subtext=_chats_n(counts.get(fid, 0)),
                icon="msg_folders",
                create_sub_fragment=lambda fid=fid: self._folder_page(acc, uid, fid),
            ))
        rows.append(Text(text=_t("new_folder"), icon="msg_addfolder", accent=True, on_click=lambda v: self._new_folder_from_settings(acc, uid)))
        rows += [
            Divider(text=_t("set_hint")),
            Header(text=_t("set_options")),
            Switch(key="remember", text=_t("set_remember"), subtext=_t("set_remember_sub"), default=True, icon="msg_archive"),
            Switch(key="hide_sorted", text=_t("set_hide"), subtext=_t("set_hide_sub"), default=False, icon="msg_folders", on_change=self._on_hide_changed),
            Switch(key="chat_menu", text=_t("set_chat_menu"), subtext=_t("set_chat_menu_sub"), default=True, icon="msg_addfolder", on_change=self._on_chat_menu_changed),
            Divider(),
            Text(text=_t("set_reset"), subtext=_t("set_reset_sub"), icon="msg_delete", red=True, on_click=self._on_reset_click),
            Divider(),
            Text(text=_t("set_author"), subtext="@" + CHANNEL, icon="msg_channel", accent=True, on_click=self._open_channel),
        ]
        return rows

    @staticmethod
    def _account_count():
        uc = jclass("org.telegram.messenger.UserConfig")
        n = 0
        for a in range(int(uc.MAX_ACCOUNT_COUNT)):
            try:
                if uc.getInstance(a).isClientActivated():
                    n += 1
            except Exception:
                pass
        return n

    @staticmethod
    def _account_name(acc):
        try:
            user = jclass("org.telegram.messenger.UserConfig").getInstance(acc).getCurrentUser()
            return str(jclass("org.telegram.messenger.UserObject").getUserName(user))
        except Exception:
            return "#%d" % acc

    @staticmethod
    def _selected_account():
        return int(jclass("org.telegram.messenger.UserConfig").selectedAccount)

    def _refresh_settings(self):
        try:
            self.set_setting("_rev", int(self.get_setting("_rev", 0) or 0) + 1, reload_settings=True)
        except Exception:
            traceback.print_exc()

    def _new_folder_from_settings(self, acc, uid):
        frag = get_last_fragment()
        if frag is None:
            return
        self._ask_name(frag, uid, None, lambda fid: self._refresh_settings())

    # ---------- folder settings page ----------

    def _category_of(self, acc, did):
        mc = jclass("org.telegram.messenger.MessagesController").getInstance(acc)
        if did > 0:
            try:
                user = mc.getUser(Long(did))
                if user is not None and bool(user.bot):
                    return "bot"
            except Exception:
                pass
            return "private_dm"
        try:
            chat = mc.getChat(Long(-did))
        except Exception:
            chat = None
        if chat is None:
            return None
        public = False
        try:
            public = bool(chat.username)
        except Exception:
            pass
        if not public:
            try:
                public = chat.usernames is not None and int(chat.usernames.size()) > 0
            except Exception:
                pass
        try:
            channel = bool(chat.broadcast) and not bool(chat.megagroup)
        except Exception:
            channel = False
        if channel:
            return "public_channel" if public else "private_channel"
        return "public_group" if public else "private_group"

    def _archived_ids(self, acc):
        dialogs = jclass("org.telegram.messenger.MessagesController").getInstance(acc).getDialogs(1)
        out = []
        for i in range(int(dialogs.size())):
            try:
                did = int(dialogs.get(i).id)
            except Exception:
                continue
            if did:
                out.append(did)
        return out

    def _category_index(self, acc):
        index = {c: [] for c in CATEGORIES}
        for did in self._archived_ids(acc):
            c = self._category_of(acc, did)
            if c in index:
                index[c].append(did)
        return index

    def _cat_key(self, uid, fid, cat):
        return "cat_%d_%d_%s" % (uid, fid, cat)

    def _folder_page(self, acc, uid, fid):
        f = self._folder(uid, fid)
        if f is None:
            return [Text(text=_t("set_no_folders"))]
        self._types = {}
        rule = self._rules(uid).get(fid)
        index = self._category_index(acc)
        inc_sub = _t("selected_n") % len(f.get("chats", []))
        types = self._types_summary(rule["flags"], TYPE_LABELS)
        if types:
            inc_sub += " · " + types
        ex_sub = _t("selected_n") % len(f.get("exclude", []))
        xtypes = self._types_summary(rule["xflags"], X_LABELS)
        if xtypes:
            ex_sub += " · " + xtypes
        rows = [
            Header(text=_t("manual_header")),
            Text(
                text=_t("included"),
                subtext=inc_sub,
                icon="msg_addfolder",
                accent=True,
                on_click=lambda v: self._open_picker_from_settings(acc, uid, fid, False),
            ),
            Text(
                text=_t("excluded"),
                subtext=ex_sub,
                icon="msg_removefolder",
                on_click=lambda v: self._open_picker_from_settings(acc, uid, fid, True),
            ),
            Divider(text=_t("types_hint")),
            Header(text=_t("category_header")),
        ]
        for cat in CATEGORIES:
            ids = index.get(cat, [])
            on = bool(ids) and all(self._in_rule(acc, rule, x, live=False) for x in ids)
            key = self._cat_key(uid, fid, cat)
            self.set_setting(key, on)
            rows.append(Switch(
                key=key,
                text=_t("cat_" + cat),
                subtext=_chats_n(len(ids)),
                default=on,
                icon=CATEGORY_ICONS[cat],
                on_change=lambda value, cat=cat: self._on_category(acc, uid, fid, cat, value),
            ))
        rows += [
            Divider(text=_t("category_hint")),
            Header(text=_t("manage_header")),
            Text(text=_t("rename"), icon="msg_edit", on_click=lambda v: self._rename_from_settings(uid, fid)),
        ]
        d = self._load(uid)
        if d["folders"] and int(d["folders"][0]["id"]) != fid:
            rows.append(Text(text=_t("move_up"), icon="msg_go_up", on_click=lambda v: (self._move(uid, fid, -1), self._refresh_settings())))
        if d["folders"] and int(d["folders"][-1]["id"]) != fid:
            rows.append(Text(text=_t("move_down"), icon="msg_go_down", on_click=lambda v: (self._move(uid, fid, 1), self._refresh_settings())))
        rows.append(Text(text=_t("delete"), icon="msg_delete", red=True, on_click=lambda v: self._delete_from_settings(uid, fid)))
        return rows

    def _on_category(self, acc, uid, fid, cat, value):
        ids = self._category_index(acc).get(cat, [])
        d = self._load(uid)
        f = self._folder(uid, fid)
        if f is None:
            return
        rule = self._rules(uid).get(fid)
        if value:
            changed = [x for x in ids if not self._in_rule(acc, rule, x, live=False)]
            msg = (_t("cat_added") % len(changed)) if changed else _t("cat_added_none")
        else:
            changed = [x for x in ids if self._in_rule(acc, rule, x, live=False)]
            msg = (_t("cat_removed") % len(changed)) if changed else _t("cat_removed_none")
        if changed:
            self._set_membership(f, rule["flags"], changed, value, acc)
        self._save(uid, d)
        self._reload_all()
        BulletinHelper.show_info(msg)
        self._refresh_settings()

    def _open_picker_from_settings(self, acc, uid, fid, exclude=False):
        frag = get_last_fragment()
        if frag is not None:
            self._open_picker(frag, acc, uid, fid, self._refresh_settings, exclude)

    def _rename_from_settings(self, uid, fid):
        frag = get_last_fragment()
        if frag is not None:
            self._ask_name(frag, uid, fid, lambda _f: (self._refresh_subtitles(uid), self._refresh_settings()))

    def _delete_from_settings(self, uid, fid):
        frag = get_last_fragment()
        if frag is None:
            return
        def done():
            try:
                frag.finishFragment()
            except Exception:
                pass
            self._refresh_settings()
        self._confirm_delete(frag, uid, fid, done)

    def _refresh_subtitles(self, uid):
        for st in self._frags.values():
            if st["uid"] == uid:
                _ui(lambda st=st: self._apply_title(st))

    def _on_hide_changed(self, value):
        self._hide_sorted = bool(value)
        for st in self._frags.values():
            st["cache"] = None
        self._reload_all()

    def _on_chat_menu_changed(self, value):
        if value:
            self._add_chat_menu()
        elif self._chat_item is not None:
            try:
                self.remove_menu_item(self._chat_item)
            except Exception:
                pass
            self._chat_item = None

    def _open_channel(self, view):
        jclass("org.telegram.messenger.browser.Browser").openUrl(view.getContext(), "https://t.me/" + CHANNEL)

    def _on_reset_click(self, view):
        acc = int(jclass("org.telegram.messenger.UserConfig").selectedAccount)
        uid = self._uid(acc)
        b = AlertDialogBuilder(view.getContext())
        b.set_title(_t("set_reset"))
        b.set_message(_t("set_reset_q"))

        def ok(_b, _w):
            self._save(uid, {"folders": [], "next": 1})
            self.set_setting("sel_%d" % uid, ALL)
            for st in self._frags.values():
                if st["uid"] == uid:
                    st["folder"] = ALL
                    st["cache"] = None
                    self._apply_title(st)
            self._reload_all()
        b.set_positive_button(_t("delete"), ok)
        b.set_negative_button(_t("cancel"))
        b.make_button_red(AlertDialogBuilder.BUTTON_POSITIVE)
        b.show()

    # ---------- storage ----------

    @staticmethod
    def _uid(account):
        try:
            return int(jclass("org.telegram.messenger.UserConfig").getInstance(account).getClientUserId())
        except Exception:
            return int(account)

    def _load(self, uid):
        d = self._data.get(uid)
        if d is not None:
            return d
        d = {"folders": [], "next": 1}
        raw = self.get_setting("data_%d" % uid, "")
        if raw:
            try:
                parsed = json.loads(raw)
                if isinstance(parsed, dict) and isinstance(parsed.get("folders"), list):
                    d = parsed
                    d.setdefault("next", 1 + max([int(f.get("id", 0)) for f in d["folders"]] or [0]))
            except Exception:
                traceback.print_exc()
        self._data[uid] = d
        self._rebuild_sets(uid)
        return d

    def _save(self, uid, d):
        self._data[uid] = d
        self._rebuild_sets(uid)
        # reload_settings re-renders an open plugin settings screen, so lists stay in sync
        self.set_setting("data_%d" % uid, json.dumps(d, ensure_ascii=False), reload_settings=True)
        for st in self._frags.values():
            if st["uid"] == uid:
                st["cache"] = None

    def _rebuild_sets(self, uid):
        d = self._data.get(uid) or {"folders": []}
        rules = {}
        for f in d["folders"]:
            rules[int(f["id"])] = {
                "chats": set(int(x) for x in f.get("chats", [])),
                "ex": set(int(x) for x in f.get("exclude", [])),
                "flags": int(f.get("flags", 0) or 0) & F_INCLUDE_MASK,
                "xflags": int(f.get("xflags", 0) or 0) & X_MASK,
                "pinned": [int(x) for x in f.get("pinned", [])],
            }
        self._sets[uid] = (rules, None)

    def _rules(self, uid):
        self._load(uid)
        return (self._sets.get(uid) or ({}, None))[0]

    # ---------- membership (explicit chats + chat types, like Telegram folders) ----------

    def _type_flag(self, acc, did):
        key = (acc, did)
        v = self._types.get(key)
        if v is not None:
            return v
        v = 0
        mc = jclass("org.telegram.messenger.MessagesController").getInstance(acc)
        try:
            if did > 0:
                user = mc.getUser(Long(did))
                if user is not None and bool(user.bot):
                    v = F_BOTS
                elif user is not None and (bool(user.contact) or bool(user.mutual_contact) or bool(user.self)):
                    v = F_CONTACTS
                else:
                    v = F_NON_CONTACTS
            else:
                chat = mc.getChat(Long(-did))
                if chat is not None:
                    v = F_CHANNELS if (bool(chat.broadcast) and not bool(chat.megagroup)) else F_GROUPS
        except Exception:
            v = 0
        self._types[key] = v
        return v

    def _is_muted(self, acc, did):
        mc = jclass("org.telegram.messenger.MessagesController").getInstance(acc)
        for args in ((did, 0), (did,)):
            try:
                return bool(mc.isDialogMuted(*args))
            except Exception:
                pass
        return False

    @staticmethod
    def _is_unread(d):
        try:
            return int(d.unread_count) > 0 or bool(d.unread_mark) or int(getattr(d, "unread_mentions_count", 0) or 0) > 0
        except Exception:
            return True

    def _in_rule(self, acc, rule, did, d=None, live=True):
        if did in rule["ex"]:
            return False
        if did not in rule["chats"]:
            if not rule["flags"] or not (rule["flags"] & self._type_flag(acc, did)):
                return False
        if live:
            if rule["xflags"] & X_MUTED and self._is_muted(acc, did):
                return False
            if rule["xflags"] & X_READ and d is not None and not self._is_unread(d):
                return False
        return True

    def _archived_dialogs(self, acc):
        dialogs = jclass("org.telegram.messenger.MessagesController").getInstance(acc).getDialogs(1)
        out = []
        for i in range(int(dialogs.size())):
            d = dialogs.get(i)
            try:
                did = int(d.id)
            except Exception:
                continue
            if did:
                out.append((did, d))
        return out

    def _counts(self, acc, uid):
        rules = self._rules(uid)
        counts = {fid: 0 for fid in rules}
        if not rules:
            return counts
        for did, d in self._archived_dialogs(acc):
            for fid, rule in rules.items():
                if self._in_rule(acc, rule, did, d):
                    counts[fid] += 1
        return counts

    def _types_summary(self, flags, labels):
        names = [_t(k) for bit, k in labels if flags & bit]
        return _join_short(names, 30) if names else ""

    def _set_membership(self, f, rule_flags, dids, inside, acc):
        """Put dids into (inside=True) or out of (False) folder f, respecting its type rules."""
        chats = [int(x) for x in f.get("chats", [])]
        ex = [int(x) for x in f.get("exclude", [])]
        if inside:
            for x in dids:
                if x not in chats:
                    chats.append(x)
            ex = [x for x in ex if x not in set(dids)]
        else:
            drop = set(dids)
            chats = [x for x in chats if x not in drop]
            for x in dids:
                if rule_flags & self._type_flag(acc, x) and x not in ex:
                    ex.append(x)
            f["pinned"] = [x for x in f.get("pinned", []) if int(x) not in drop]
        f["chats"] = chats
        f["exclude"] = ex

    def _folder(self, uid, fid):
        for f in self._load(uid)["folders"]:
            if int(f["id"]) == int(fid):
                return f
        return None

    def _name_taken(self, uid, name, except_id=None):
        low = name.strip().lower()
        for f in self._load(uid)["folders"]:
            if str(f["name"]).strip().lower() == low and int(f["id"]) != (except_id or -1):
                return True
        return False

    # ---------- hooks ----------

    def _hook(self, clazz, name, before=None, after=None):
        try:
            res = self.hook_all_methods(clazz, name, _Hook(before, after))
            if res:
                self._hooks.extend(list(res))
                return True
        except Exception:
            traceback.print_exc()
        self.log("hook failed: %s" % name)
        return False

    def _hook_all(self):
        da = find_class("org.telegram.ui.DialogsActivity")
        if da is None:
            self.log("DialogsActivity not found")
            return
        self._hook(da, "getDialogsArray", after=self._after_get_dialogs)
        self._hook(da, "createView", after=self._after_create_view)
        self._hook(da, "createActionMode", after=self._after_create_action_mode)
        self._hook(da, "didReceivedNotification", before=self._before_notification)
        self._hook(da, "onFragmentDestroy", before=self._before_destroy)
        self._pin_actions = set()
        for name, fallback in (("pin", 100), ("pin2", 108)):
            try:
                v = get_static_private_field(da, name)
                self._pin_actions.add(int(v) if v is not None else fallback)
            except Exception:
                self._pin_actions.add(fallback)
        self._hook(da, "performSelectedDialogsAction", before=self._before_dialogs_action)
        # drag-to-reorder of folder pins: same gesture as native pins (selection mode -> hold a pinned chat -> drag)
        self._hook(da, "isDialogPinned", before=self._before_is_pinned)
        # selection mode turns on the reorder handles (≡) only when getPinnedCount() > 1
        self._hook(da, "getPinnedCount", before=self._before_pinned_count)
        self._hook(da, "hideActionMode", before=self._before_hide_action_mode)
        dad = find_class("org.telegram.ui.Adapters.DialogsAdapter")
        if dad is not None:
            self._hook(dad, "moveDialogs", before=self._before_move_dialogs)
        self._hook(da, "updateCounters", after=self._after_update_counters)
        dc = find_class("org.telegram.ui.Cells.DialogCell")
        if dc is not None:
            hooked = False
            try:
                Boolean = jclass("java.lang.Boolean")
                Integer = jclass("java.lang.Integer")
                m = dc.getDeclaredMethod("update", Integer.TYPE, Boolean.TYPE)
                u = self.hook_method(m, _Hook(after=self._after_cell_update))
                if u:
                    self._hooks.append(u)
                    hooked = True
            except Exception:
                traceback.print_exc()
            if not hooked:
                self._hook(dc, "update", after=self._after_cell_update)
        usa = find_class("org.telegram.ui.UsersSelectActivity")
        if usa is not None:
            self._hook(usa, "createView", after=self._picker_after_create_view)
            self._hook(usa, "updateHint", after=self._picker_after_update_hint)
            self._hook(usa, "onFragmentDestroy", before=self._picker_before_destroy)
        adp = find_class("org.telegram.ui.UsersSelectActivity$GroupCreateAdapter")
        if adp is not None:
            try:
                res = self.hook_all_constructors(adp, _Hook(after=self._adapter_after_init))
                if res:
                    self._hooks.extend(list(res))
                else:
                    self.log("hook failed: GroupCreateAdapter.<init>")
            except Exception:
                traceback.print_exc()
            self._hook(adp, "onBindViewHolder", after=self._adapter_after_bind)
        atv = find_class("org.telegram.ui.Components.AnimatedTextView")
        if atv is not None:
            hooked = False
            try:
                Boolean = jclass("java.lang.Boolean")
                m = atv.getDeclaredMethod("setText", jclass("java.lang.CharSequence"), Boolean.TYPE, Boolean.TYPE)
                u = self.hook_method(m, _Hook(before=self._before_stories_title))
                if u:
                    self._hooks.append(u)
                    hooked = True
            except Exception:
                traceback.print_exc()
            if not hooked:
                self._hook(atv, "setText", before=self._before_stories_title)
        sah = find_class("org.telegram.ui.Adapters.SearchAdapterHelper")
        if sah is not None:
            self._hook(sah, "queryServerSearch", before=self._before_server_search)

    def _frag_of(self, st):
        ref = st.get("ref")
        return ref.get() if ref is not None else None

    def _st_for(self, obj):
        """Registered state for this exact DialogsActivity (identity hashes can collide)."""
        st = self._frags.get(_ident(obj))
        if st is None or not _same(st.get("ref"), obj):
            return None
        return st

    def _detach(self, frag, st, remove_item=False):
        try:
            bar = frag.getActionBar()
        except Exception:
            bar = None
        for key in ("item", "sub"):
            ref = st.pop(key, None)
            view = ref.get() if ref is not None else None
            if view is None:
                continue
            try:
                view.setOnClickListener(None)
            except Exception:
                pass
            if remove_item and view.getParent() is not None:
                try:
                    view.getParent().removeView(view)
                except Exception:
                    pass


    def _after_create_view(self, param):
        frag = param.thisObject
        if int(get_private_field(frag, "folderId") or 0) != 1:
            return
        if bool(get_private_field(frag, "onlySelect")):
            return
        if int(get_private_field(frag, "initialDialogsType") or 0) != 0:
            return
        acc = int(frag.getCurrentAccount())
        uid = self._uid(acc)
        self._load(uid)
        self._types = {}
        folder = ALL
        if self.get_setting("remember", True):
            try:
                folder = int(self.get_setting("sel_%d" % uid, ALL) or ALL)
            except Exception:
                folder = ALL
            if folder != ALL and self._folder(uid, folder) is None:
                folder = ALL
        old = self._st_for(frag)
        if old is not None:
            self._detach(frag, old)
        try:
            orig = str(frag.getActionBar().getTitle() or "")
        except Exception:
            orig = ""
        if old is not None and old.get("orig_title"):
            orig = old["orig_title"]
        st = {
            "ref": _weak(frag),
            "orig_title": orig,
            "acc": acc,
            "uid": uid,
            "folder": folder,
            "cache": None,
            "item": None,
        }
        self._frags[_ident(frag)] = st
        self._add_button(frag, st)
        self._register_stories_title(frag, st)
        self._apply_title(st)

    def _before_destroy(self, param):
        if not self._frags:
            return
        st = self._st_for(param.thisObject)
        if st is None:
            return
        self._frags.pop(_ident(param.thisObject), None)
        self._detach(param.thisObject, st)
        if st.pop("pins_dirty", False):
            self._save(st["uid"], self._load(st["uid"]))
        tv_id = st.pop("tv_id", None)
        if tv_id is not None:
            self._title_views.pop(tv_id, None)

    def _before_notification(self, param):
        if not self._frags:
            return
        try:
            nid = int(param.args[0])
        except Exception:
            nid = None
        if self._notif_ids and nid not in self._notif_ids:
            return
        st = self._st_for(param.thisObject)
        if st is not None:
            st["cache"] = None

    def _after_get_dialogs(self, param):
        if not self._frags:
            return
        args = param.args
        if args is None or len(args) < 4:
            return
        if int(args[2]) != 1 or int(args[1]) != 0 or bool(args[3]):
            return
        st = self._st_for(param.thisObject)
        if st is None:
            return
        uid = st["uid"]
        acc = st["acc"]
        rules = self._rules(uid)
        folder = st["folder"]
        if folder == ALL:
            if not rules or not self._hide_sorted:
                return
            rule = None
        else:
            rule = rules.get(folder)
            if rule is None:
                return
        src = param.getResult()
        if src is None:
            return
        size = int(src.size())
        key = (_ident(src), size, folder)
        cache = st.get("cache")
        if cache is not None and cache[0] == key:
            param.setResult(cache[1])
            return
        out = jclass("java.util.ArrayList")()
        for i in range(size):
            d = src.get(i)
            try:
                did = int(d.id)
            except Exception:
                out.add(d)
                continue
            if rule is not None:
                if self._in_rule(acc, rule, did, d):
                    out.add(d)
            elif not any(self._in_rule(acc, r, did, d) for r in rules.values()):
                out.add(d)
        if rule is not None:
            out = self._order_folder(out, rule)
        st["cache"] = (key, out)
        param.setResult(out)

    @staticmethod
    def _order_folder(lst, rule):
        """Inside a folder: its local pins on top (in pin order); server-pinned archive chats
        are placed back among the others by date, since folder pins replace archive pins here."""
        items = []
        for i in range(int(lst.size())):
            d = lst.get(i)
            try:
                items.append((int(d.id), d))
            except Exception:
                items.append((None, d))
        pin_pos = {did: i for i, did in enumerate(rule["pinned"])}
        top = sorted([(pin_pos[did], d) for did, d in items if did in pin_pos], key=lambda x: x[0])
        rest = [(did, d) for did, d in items if did not in pin_pos]

        def is_native_pin(d):
            try:
                return bool(d.pinned)
            except Exception:
                return False

        def date_of(d):
            try:
                return int(d.last_message_date)
            except Exception:
                return 0
        natives = [d for did, d in rest if is_native_pin(d)]
        if not top and not natives:
            return lst
        merged = [d for did, d in rest if not is_native_pin(d)]
        for d in sorted(natives, key=date_of, reverse=True):
            dd = date_of(d)
            pos = len(merged)
            for j, other in enumerate(merged):
                if date_of(other) < dd:
                    pos = j
                    break
            merged.insert(pos, d)
        out = jclass("java.util.ArrayList")()
        for _p, d in top:
            out.add(d)
        for d in merged:
            out.add(d)
        return out

    def _after_create_action_mode(self, param):
        if not self._frags:
            return
        frag = param.thisObject
        st = self._st_for(frag)
        if st is None:
            return
        if param.args is not None and len(param.args) > 0 and param.args[0] is not None:
            return
        mode = frag.getActionBar().getActionMode()
        if mode is None:
            return
        menu_item_cls = jclass("org.telegram.ui.ActionBar.ActionBarMenuItem")
        other = None
        last = None
        for i in range(int(mode.getChildCount())):
            child = mode.getChildAt(i)
            if not isinstance(child, menu_item_cls):
                continue
            last = child
            try:
                if int(child.getTag()) == 0:
                    other = child
            except Exception:
                pass
        if other is None:
            other = last
        if other is None:
            return
        try:
            if other.hasSubItem(ITEM_ACTION_ID):
                return
        except Exception:
            pass
        sub = other.addSubItem(ITEM_ACTION_ID, _drawable("msg_folders"), _t("to_folder"))
        fr, orf = _weak(frag), _weak(other)

        def on_click(_v):
            f, o = fr.get(), orf.get()
            if o is not None:
                o.closeSubMenu()
            if f is None:
                return
            selected = get_private_field(f, "selectedDialogs")
            dids = [int(selected.get(i)) for i in range(int(selected.size()))] if selected is not None else []
            if not dids:
                return
            self._show_assign_dialog(f, int(f.getCurrentAccount()), dids, lambda: self._hide_action_mode_ref(fr))
        sub.setOnClickListener(_Click(on_click))
        st["sub"] = _weak(sub)

    def _hide_action_mode_ref(self, fr):
        f = fr.get()
        if f is not None:
            self._hide_action_mode(f)

    def _hide_action_mode(self, frag):
        try:
            Boolean = jclass("java.lang.Boolean")
            m = frag.getClass().getDeclaredMethod("hideActionMode", Boolean.TYPE)
            m.setAccessible(True)
            m.invoke(frag, Boolean(True))
        except Exception:
            traceback.print_exc()

    # ---------- archive header button ----------

    def _add_button(self, frag, st):
        menu = frag.getActionBar().createMenu()
        fr = _weak(frag)

        def on_click(v):
            f = fr.get()
            if f is not None:
                self._show_folders_popup(f, v)
        item = menu.getItem(ITEM_BUTTON_ID)
        if item is not None:
            item.setOnClickListener(_Click(on_click))
            st["item"] = _weak(item)
            return
        item = menu.addItem(ITEM_BUTTON_ID, _drawable("msg_folders"))
        item.setContentDescription(_t("to_folder_title"))
        item.setOnClickListener(_Click(on_click))
        options = get_private_field(frag, "optionsItem")
        if options is not None and options.getParent() is not None and options.getParent().equals(menu):
            idx = int(menu.indexOfChild(options))
            menu.removeView(item)
            menu.addView(item, idx)
        st["item"] = _weak(item)

    def _apply_title(self, st):
        """The folder name replaces the header title itself ("Архив чатов" for the whole archive).
        No extra views or alignment: works with centered/left titles, stories and custom fonts."""
        frag = self._frag_of(st)
        if frag is None:
            return
        name = None
        if st["folder"] != ALL:
            f = self._folder(st["uid"], st["folder"])
            name = _short(f["name"], 24) if f is not None else None
        text = name or st.get("orig_title") or _t("archive_title")
        if st.get("tv") is None or st["tv"].get() is None:
            self._register_stories_title(frag, st)
        self._update_stories_title(st, text)
        bar = frag.getActionBar()
        try:
            if str(bar.getTitle() or "") == text:
                return
        except Exception:
            pass
        if st.get("shown"):
            try:
                bar.setTitleAnimated(text, True, 220)
                return
            except Exception:
                pass
        bar.setTitle(text)
        st["shown"] = True

    # ---------- stories cell title ----------
    # With archived stories collapsed into the header, DialogStoriesCell draws its own
    # "Архив чатов" in an AnimatedTextView. Its text is swapped only when it would show the
    # archive title, so "Connecting…" or story counters stay untouched.

    def _register_stories_title(self, frag, st):
        try:
            cell = frag.dialogStoriesCell
        except Exception:
            cell = None
        tv = get_private_field(cell, "titleView") if cell is not None else None
        if tv is None:
            return
        tid = _ident(tv)
        st["tv_id"] = tid
        st["tv"] = _weak(tv)
        self._title_views[tid] = st

    def _archive_titles(self, st):
        names = {st.get("orig_title") or "", _t("archive_title"), STRINGS["ru"]["archive_title"], STRINGS["en"]["archive_title"]}
        for f in self._load(st["uid"])["folders"]:
            names.add(_short(f["name"], 24))
        names.discard("")
        return names

    def _display_title(self, st):
        if st["folder"] != ALL:
            f = self._folder(st["uid"], st["folder"])
            if f is not None:
                return _short(f["name"], 24)
        return st.get("orig_title") or _t("archive_title")

    def _before_stories_title(self, param):
        if not self._title_views:
            return
        st = self._title_views.get(_ident(param.thisObject))
        if st is None or not _same(st.get("tv"), param.thisObject):
            return
        args = param.args
        if args is None or len(args) == 0 or args[0] is None:
            return
        cur = str(args[0])
        if cur in self._archive_titles(st):
            want = self._display_title(st)
            if cur != want:
                args[0] = want

    def _update_stories_title(self, st, text):
        ref = st.get("tv")
        tv = ref.get() if ref is not None else None
        if tv is None:
            return
        try:
            cur = str(tv.getText() or "")
        except Exception:
            return
        if cur and cur != text and cur in self._archive_titles(st):
            tv.setText(text, True)

    # ---------- local pins (per folder) ----------

    def _folder_view(self, frag):
        st = self._st_for(frag)
        if st is None or st["folder"] == ALL:
            return None
        return st

    def _before_dialogs_action(self, param):
        if not self._frags or all(s["folder"] == ALL for s in self._frags.values()):
            return
        args = param.args
        if args is None or len(args) < 2:
            return
        try:
            action = int(args[1])
        except Exception:
            return
        if action not in self._pin_actions:
            return
        frag = param.thisObject
        st = self._folder_view(frag)
        if st is None:
            return
        sel = args[0]
        dids = [int(sel.get(i)) for i in range(int(sel.size()))] if sel is not None else []
        param.setResult(None)
        if not dids:
            return
        uid, fid = st["uid"], st["folder"]
        d = self._load(uid)
        f = self._folder(uid, fid)
        if f is None:
            return
        pinned = [int(x) for x in f.get("pinned", [])]
        unpin = all(x in pinned for x in dids)
        if unpin:
            drop = set(dids)
            pinned = [x for x in pinned if x not in drop]
        else:
            pinned = [x for x in dids if x not in pinned] + pinned
        f["pinned"] = pinned
        self._save(uid, d)
        self._hide_action_mode(frag)
        self._reload(st["acc"])
        BulletinHelper.show_success((_t("unpinned_local") if unpin else _t("pinned_local")) % _short(f["name"], 20), frag)

    def _any_folder_view(self):
        return bool(self._frags) and any(s["folder"] != ALL for s in self._frags.values())

    def _before_is_pinned(self, param):
        if not self._any_folder_view():
            return
        st = self._folder_view(param.thisObject)
        if st is None:
            return
        rule = self._rules(st["uid"]).get(st["folder"])
        d = param.args[0] if param.args is not None and len(param.args) > 0 else None
        if rule is None or d is None:
            return
        try:
            did = int(d.id)
        except Exception:
            return
        param.setResult(_JBoolean(did in rule["pinned"]))

    def _before_pinned_count(self, param):
        if not self._any_folder_view():
            return
        frag = param.thisObject
        st = self._folder_view(frag)
        if st is None:
            return
        rule = self._rules(st["uid"]).get(st["folder"])
        if rule is None or not rule["pinned"]:
            param.setResult(_JInteger(0))
            return
        pins = set(rule["pinned"])
        n = 0
        try:
            lst = frag.getDialogsArray(st["acc"], 0, 1, False)
            for i in range(int(lst.size())):
                if int(lst.get(i).id) in pins:
                    n += 1
        except Exception:
            n = len(pins)
        param.setResult(_JInteger(n))

    def _before_move_dialogs(self, param):
        """Inside a folder, dragging swaps folder pins only: native pinnedNum is left alone."""
        if not self._any_folder_view():
            return
        adapter = param.thisObject
        frag = get_private_field(adapter, "parentFragment")
        if frag is None:
            return
        st = self._folder_view(frag)
        if st is None:
            return
        args = param.args
        try:
            acc = int(get_private_field(adapter, "currentAccount"))
            dtype = int(get_private_field(adapter, "dialogsType"))
            fold = int(get_private_field(adapter, "folderId"))
            i = int(adapter.fixPosition(int(args[1])))
            j = int(adapter.fixPosition(int(args[2])))
            lst = frag.getDialogsArray(acc, dtype, fold, False)
            n = int(lst.size())
            if not (0 <= i < n and 0 <= j < n):
                return
            a, b = lst.get(i), lst.get(j)
            lst.set(i, b)
            lst.set(j, a)
            order = []
            f = self._folder(st["uid"], st["folder"])
            pins = set(int(x) for x in f.get("pinned", [])) if f is not None else set()
            for k in range(n):
                did = int(lst.get(k).id)
                if did in pins:
                    order.append(did)
        except Exception:
            traceback.print_exc()
            return
        param.setResult(None)
        if f is not None and order:
            # keep pins that aren't on screen (e.g. not archived right now) at the end
            order += [int(x) for x in f.get("pinned", []) if int(x) not in set(order)]
            f["pinned"] = order
            self._rebuild_sets(st["uid"])
            st["pins_dirty"] = True
            st["cache"] = None
        try:
            adapter.updateList(None)
        except Exception:
            traceback.print_exc()

    def _before_hide_action_mode(self, param):
        if not self._any_folder_view():
            return
        frag = param.thisObject
        st = self._folder_view(frag)
        if st is None:
            return
        # native code would push the archive's own pin order to the server here
        set_private_field(frag, "movingWas", False)
        if st.pop("pins_dirty", False):
            self._save(st["uid"], self._load(st["uid"]))

    def _after_update_counters(self, param):
        if not self._frags:
            return
        frag = param.thisObject
        st = self._folder_view(frag)
        if st is None:
            return
        rule = self._rules(st["uid"]).get(st["folder"])
        item = get_private_field(frag, "pinItem")
        sel = get_private_field(frag, "selectedDialogs")
        if rule is None or item is None or sel is None:
            return
        dids = [int(sel.get(i)) for i in range(int(sel.size()))]
        if not dids:
            return
        unpin = all(x in rule["pinned"] for x in dids)
        item.setVisibility(0)
        item.setIcon(_drawable("msg_unpin" if unpin else "msg_pin"))

    def _after_cell_update(self, param):
        if not self._frags or all(s["folder"] == ALL for s in self._frags.values()):
            return
        cell = param.thisObject
        frag = get_private_field(cell, "parentFragment")
        if frag is None:
            return
        st = self._folder_view(frag)
        if st is None:
            return
        rule = self._rules(st["uid"]).get(st["folder"])
        if rule is None:
            return
        try:
            if int(get_private_field(cell, "currentDialogFolderId") or 0) != 0:
                return
            want = int(cell.getDialogId()) in rule["pinned"]
            cur = bool(get_private_field(cell, "drawPin"))
        except Exception:
            return
        if cur != want:
            set_private_field(cell, "drawPin", want)
            if int(cell.getMeasuredWidth()) > 0:
                cell.buildLayout()
            cell.invalidate()

    def _select(self, st, fid):
        st["folder"] = fid
        st["cache"] = None
        if self.get_setting("remember", True):
            self.set_setting("sel_%d" % st["uid"], fid)
        self._apply_title(st)
        self._reload(st["acc"])

    def _reload(self, acc):
        nc = jclass("org.telegram.messenger.NotificationCenter")
        _ui(lambda: nc.getInstance(acc).postNotificationName(nc.dialogsNeedReload))

    def _reload_all(self):
        for acc in set(st["acc"] for st in self._frags.values()):
            self._reload(acc)

    def _show_folders_popup(self, frag, anchor):
        st = self._st_for(frag)
        if st is None:
            return
        fr = _weak(frag)

        def with_frag(fn):
            def run():
                f = fr.get()
                if f is not None:
                    fn(f)
            return run
        uid, acc = st["uid"], st["acc"]
        d = self._load(uid)
        Theme = jclass("org.telegram.ui.ActionBar.Theme")
        ItemOptions = jclass("org.telegram.ui.Components.ItemOptions")
        o = ItemOptions.makeOptions(frag, anchor, True)
        accent = int(Theme.key_featuredStickers_addButton)
        normal_icon = int(Theme.key_actionBarDefaultSubmenuItemIcon)
        normal_text = int(Theme.key_actionBarDefaultSubmenuItem)
        red = int(Theme.key_text_RedRegular)
        counts = self._counts(acc, uid)

        def add(icon, text, active, fn, is_red=False, target=None):
            if is_red:
                ik, tk = red, red
            elif active:
                ik, tk = accent, accent
            else:
                ik, tk = normal_icon, normal_text
            (target or o).add(_drawable(icon), text, ik, tk, _Run(fn))

        add("msg_archive", _t("all"), st["folder"] == ALL, lambda: self._select(st, ALL))
        for f in d["folders"]:
            fid = int(f["id"])
            label = "%s  ·  %d" % (_short(f["name"]), counts.get(fid, 0))
            add("msg_folders", label, st["folder"] == fid, lambda fid=fid: self._select(st, fid))
        o.addGap()
        def created(fid):
            self._select(st, fid)
            f = fr.get()
            if f is not None:
                self._open_picker(f, acc, uid, fid)
        add("msg_addfolder", _t("new_folder"), False, with_frag(lambda f: self._ask_name(f, uid, None, created)))
        cur = self._folder(uid, st["folder"]) if st["folder"] != ALL else None
        if cur is not None:
            # actions for the open folder live in a slide-in submenu, so the main list stays short
            fid = int(cur["id"])
            sub = o.makeSwipeback()

            def act(fn):
                def run():
                    o.dismiss()
                    fn()
                return run
            add("ic_ab_back", _t("back"), False, lambda: o.closeSwipeback(), target=sub)
            sub.addGap()
            add("msg_select", _t("edit_chats"), False, act(with_frag(lambda f: self._open_picker(f, acc, uid, fid))), target=sub)
            add("msg_removefolder", _t("excluded_short"), False, act(with_frag(lambda f: self._open_picker(f, acc, uid, fid, None, True))), target=sub)
            add("msg_edit", _t("rename"), False, act(with_frag(lambda f: self._ask_name(f, uid, fid, lambda _f: self._apply_title(st)))), target=sub)
            ids = [int(x["id"]) for x in d["folders"]]
            if ids and ids[0] != fid:
                add("msg_go_up", _t("move_up"), False, act(lambda: self._move(uid, fid, -1)), target=sub)
            if ids and ids[-1] != fid:
                add("msg_go_down", _t("move_down"), False, act(lambda: self._move(uid, fid, 1)), target=sub)
            sub.addGap()
            add("msg_delete", _t("delete"), False, act(with_frag(lambda f: self._confirm_delete(f, uid, fid))), is_red=True, target=sub)
            add("msg_settings", _t("manage"), False, lambda: o.openSwipeback(sub))
        try:
            o.setGravity(jclass("android.view.Gravity").RIGHT)
        except Exception:
            pass
        o.show()

    # ---------- folder operations ----------

    def _move(self, uid, fid, delta):
        d = self._load(uid)
        fs = d["folders"]
        for i, f in enumerate(fs):
            if int(f["id"]) == fid:
                j = i + delta
                if 0 <= j < len(fs):
                    fs[i], fs[j] = fs[j], fs[i]
                    self._save(uid, d)
                return

    def _confirm_delete(self, frag, uid, fid, on_done=None):
        f = self._folder(uid, fid)
        if f is None:
            return
        b = AlertDialogBuilder(frag.getParentActivity())
        b.set_title(_t("delete"))
        b.set_message(_t("delete_q") % f["name"])

        def ok(_b, _w):
            d = self._load(uid)
            d["folders"] = [x for x in d["folders"] if int(x["id"]) != fid]
            self._save(uid, d)
            for s in self._frags.values():
                if s["uid"] == uid and s["folder"] == fid:
                    self._select(s, ALL)
            BulletinHelper.show_success(_t("deleted"))
            if on_done:
                on_done()
        b.set_positive_button(_t("delete"), ok)
        b.set_negative_button(_t("cancel"))
        b.make_button_red(AlertDialogBuilder.BUTTON_POSITIVE)
        b.show()

    def _ask_name(self, frag, uid, fid, on_done):
        ctx = frag.getParentActivity()
        if ctx is None:
            return
        Theme = jclass("org.telegram.ui.ActionBar.Theme")
        AndroidUtilities = jclass("org.telegram.messenger.AndroidUtilities")
        EditText = jclass("org.telegram.ui.Components.EditTextBoldCursor")
        FrameLayout = jclass("android.widget.FrameLayout")
        LayoutHelper = jclass("org.telegram.ui.Components.LayoutHelper")
        existing = self._folder(uid, fid) if fid is not None else None

        edit = EditText(ctx)
        edit.setTextSize(1, 18.0)
        edit.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
        edit.setHintText(_t("name_hint"))
        edit.setSingleLine(True)
        edit.setCursorColor(Theme.getColor(Theme.key_dialogTextBlack))
        edit.setCursorSize(_dp(20))
        edit.setCursorWidth(1.5)
        edit.setLineColors(Theme.getColor(Theme.key_windowBackgroundWhiteInputField),
                           Theme.getColor(Theme.key_windowBackgroundWhiteInputFieldActivated),
                           Theme.getColor(Theme.key_text_RedRegular))
        edit.setPadding(0, 0, 0, _dp(8))
        if existing is not None:
            edit.setText(str(existing["name"]))
            edit.setSelection(int(edit.length()))
        frame = FrameLayout(ctx)
        frame.addView(edit, LayoutHelper.createFrame(-1, -2.0, 0x30, 24.0, 6.0, 24.0, 0.0))

        b = AlertDialogBuilder(ctx)
        b.set_title(_t("rename") if existing is not None else _t("new_folder"))
        b.set_view(frame)

        def ok(_b, _w):
            name = str(edit.getText().toString()).strip()[:32]
            if not name:
                BulletinHelper.show_error(_t("name_empty"), frag)
                return
            if self._name_taken(uid, name, fid):
                BulletinHelper.show_error(_t("name_taken"), frag)
                return
            d = self._load(uid)
            if existing is not None:
                for f in d["folders"]:
                    if int(f["id"]) == fid:
                        f["name"] = name
                new_id = fid
            else:
                new_id = int(d.get("next", 1))
                d["next"] = new_id + 1
                d["folders"].append({"id": new_id, "name": name, "chats": []})
            self._save(uid, d)
            AndroidUtilities.hideKeyboard(edit)
            on_done(new_id)
        b.set_positive_button(_t("save") if existing is not None else _t("create"), ok)
        b.set_negative_button(_t("cancel"))
        b.show()

        def focus():
            edit.requestFocus()
            AndroidUtilities.showKeyboard(edit)
        _ui(focus, 200)

    # ---------- chat names ----------

    @staticmethod
    def _dialog_name(acc, did):
        mc = jclass("org.telegram.messenger.MessagesController").getInstance(acc)
        try:
            if did > 0:
                user = mc.getUser(Long(did))
                if user is not None:
                    return str(jclass("org.telegram.messenger.UserObject").getUserName(user))
            else:
                chat = mc.getChat(Long(-did))
                if chat is not None and chat.title:
                    return str(chat.title)
        except Exception:
            pass
        return str(did)

    def _check_list(self, ctx, rows):
        """rows: list of (label, value, checked). Returns (container, cells)."""
        Theme = jclass("org.telegram.ui.ActionBar.Theme")
        LinearLayout = jclass("android.widget.LinearLayout")
        CheckBoxCell = jclass("org.telegram.ui.Cells.CheckBoxCell")
        LayoutHelper = jclass("org.telegram.ui.Components.LayoutHelper")
        global _TOGGLE_CLICK
        if _TOGGLE_CLICK is None:
            def toggle(v):
                c = cast(CheckBoxCell, v)
                c.setChecked(not c.isChecked(), True)
            _TOGGLE_CLICK = _Click(toggle)
        box = LinearLayout(ctx)
        box.setOrientation(LinearLayout.VERTICAL)
        cells = []
        for label, value, checked in rows:
            cell = CheckBoxCell(ctx, 1)
            cell.setBackground(Theme.getSelectorDrawable(False))
            cell.setText(label, value or "", bool(checked), False)
            cell.setOnClickListener(_TOGGLE_CLICK)
            box.addView(cell, LayoutHelper.createLinear(-1, 50))
            cells.append(cell)
        return box, cells

    # ---------- assign selected chats to folders ----------

    def _show_assign_dialog(self, frag, acc, dids, on_done=None):
        ctx = frag.getParentActivity()
        if ctx is None:
            return
        uid = self._uid(acc)
        d = self._load(uid)
        if not d["folders"]:
            def created(fid):
                self._assign(uid, dids, {fid: True}, acc)
                if on_done:
                    on_done()
                BulletinHelper.show_success(_t("added"), frag)
            self._ask_name(frag, uid, None, created)
            return
        rules = self._rules(uid)
        rows, initial = [], []
        for f in d["folders"]:
            rule = rules.get(int(f["id"]))
            inside = sum(1 for x in dids if self._in_rule(acc, rule, x, live=False))
            initial.append(inside == len(dids))
            value = "%d/%d" % (inside, len(dids)) if 0 < inside < len(dids) else ""
            rows.append((_short(f["name"], 30), value, inside == len(dids)))
        box, cells = self._check_list(ctx, rows)

        b = AlertDialogBuilder(ctx)
        b.set_title(_t("to_folder_title"))
        b.set_view(box)

        def ok(_b, _w):
            changes = {}
            for f, cell, was in zip(d["folders"], cells, initial):
                now = bool(cell.isChecked())
                if now != was:
                    changes[int(f["id"])] = now
            if changes:
                self._assign(uid, dids, changes, acc)
                BulletinHelper.show_success(_t("added"), frag)
            if on_done:
                on_done()

        def new_folder(_b, _w):
            self._ask_name(frag, uid, None, lambda fid: self._show_assign_dialog(frag, acc, dids, on_done))
        b.set_positive_button(_t("done"), ok)
        b.set_negative_button(_t("cancel"))
        b.set_neutral_button(_t("new_folder"), new_folder)
        b.show()

    def _assign(self, uid, dids, changes, acc):
        d = self._load(uid)
        rules = self._rules(uid)
        for f in d["folders"]:
            fid = int(f["id"])
            if fid not in changes:
                continue
            self._set_membership(f, rules[fid]["flags"], dids, changes[fid], acc)
        self._save(uid, d)
        self._reload_all()

    # ---------- native chat picker (UsersSelectActivity) ----------

    def _open_picker(self, frag, acc, uid, fid, on_done=None, exclude=False):
        f = self._folder(uid, fid)
        if f is None or frag is None:
            return
        self._types = {}
        ArrayList = jclass("java.util.ArrayList")
        ids = ArrayList()
        for x in f.get("exclude" if exclude else "chats", []):
            ids.add(Long(int(x)))
        USA = jclass("org.telegram.ui.UsersSelectActivity")
        if exclude:
            picker = USA(False, ids, int(f.get("xflags", 0) or 0) & X_MASK)
        else:
            picker = USA(True, ids, int(f.get("flags", 0) or 0) & F_INCLUDE_MASK)
        picker.noChatTypes = False
        try:
            picker.setCurrentAccount(acc)
        except Exception:
            pass

        def picked(chosen, flags):
            d = self._load(uid)
            chosen_set = set(chosen)
            for x in d["folders"]:
                if int(x["id"]) != fid:
                    continue
                if exclude:
                    x["exclude"] = chosen
                    x["xflags"] = int(flags) & X_MASK
                    x["chats"] = [c for c in x.get("chats", []) if int(c) not in chosen_set]
                else:
                    x["chats"] = chosen
                    x["flags"] = int(flags) & F_INCLUDE_MASK
                    x["exclude"] = [c for c in x.get("exclude", []) if int(c) not in chosen_set]
            self._save(uid, d)
            self._reload_all()
            BulletinHelper.show_success(_t("added"))
            if on_done:
                on_done()
        picker.setDelegate(_Picked(picked))
        self._pickers[_ident(picker)] = {"acc": acc, "uid": uid, "fid": fid, "limits": None, "ref": _weak(picker), "exclude": exclude}
        frag.presentFragment(picker)

    def _ps_for(self, obj):
        ps = self._pickers.get(_ident(obj))
        if ps is None or not _same(ps.get("ref"), obj):
            return None
        return ps

    def _restore_limits(self, ps):
        if ps.get("limits") is None:
            return
        try:
            mc = jclass("org.telegram.messenger.MessagesController").getInstance(ps["acc"])
            if int(mc.dialogFiltersChatsLimitDefault) == BIG_LIMIT:
                mc.dialogFiltersChatsLimitDefault = ps["limits"][0]
            if int(mc.dialogFiltersChatsLimitPremium) == BIG_LIMIT:
                mc.dialogFiltersChatsLimitPremium = ps["limits"][1]
        except Exception:
            traceback.print_exc()
        ps["limits"] = None

    def _picker_after_create_view(self, param):
        if not self._pickers:
            return
        ps = self._ps_for(param.thisObject)
        if ps is None:
            return
        f = self._folder(ps["uid"], ps["fid"])
        bar = param.thisObject.getActionBar()
        if f is not None:
            if ps.get("exclude"):
                bar.setTitle(_t("excluded_title") % _short(f["name"], 14))
            else:
                bar.setTitle(_short(f["name"], 24))
        if ps["limits"] is None:
            mc = jclass("org.telegram.messenger.MessagesController").getInstance(ps["acc"])
            ps["limits"] = (int(mc.dialogFiltersChatsLimitDefault), int(mc.dialogFiltersChatsLimitPremium))
            mc.dialogFiltersChatsLimitDefault = BIG_LIMIT
            mc.dialogFiltersChatsLimitPremium = BIG_LIMIT
        self._picker_subtitle(param.thisObject)

    def _picker_subtitle(self, picker):
        n = int(get_private_field(picker, "selectedCount") or 0)
        picker.getActionBar().setSubtitle(_t("selected_n") % n if n else _t("picker_none"))

    def _picker_after_update_hint(self, param):
        if self._pickers and self._ps_for(param.thisObject) is not None:
            self._picker_subtitle(param.thisObject)

    def _picker_before_destroy(self, param):
        if not self._pickers:
            return
        ps = self._ps_for(param.thisObject)
        if ps is None:
            return
        self._pickers.pop(_ident(param.thisObject), None)
        for k, v in list(self._adapters.items()):
            if v[1] is ps:
                self._adapters.pop(k, None)
        if ps.get("helper"):
            self._helpers.discard(ps["helper"])
        self._restore_limits(ps)

    def _adapter_after_init(self, param):
        adapter = param.thisObject
        if not self._pickers:
            return
        outer = get_private_field(adapter, "this$0")
        if outer is not None:
            ps = self._ps_for(outer)
        elif len(self._pickers) == 1:
            ps = next(iter(self._pickers.values()))
        else:
            ps = None
        if ps is None:
            return
        self._adapters[_ident(adapter)] = (_weak(adapter), ps)
        helper = get_private_field(adapter, "searchAdapterHelper")
        if helper is not None:
            ps["helper"] = _ident(helper)
            self._helpers.add(ps["helper"])
        contacts = get_private_field(adapter, "contacts")
        if contacts is None:
            return
        uid, fid, acc = ps["uid"], ps["fid"], ps["acc"]
        f = self._folder(uid, fid)
        members = set(int(x) for x in f.get("exclude" if ps.get("exclude") else "chats", [])) if f is not None else set()
        archived = self._archived_ids(acc)
        allowed = set(archived) | members
        rank = {did: i for i, did in enumerate(archived)}
        others = [r for ofid, r in self._rules(uid).items() if ofid != fid]
        elsewhere = set(did for did in allowed if any(self._in_rule(acc, r, did, live=False) for r in others))
        User = jclass("org.telegram.tgnet.TLRPC$User")
        Chat = jclass("org.telegram.tgnet.TLRPC$Chat")
        free, busy = [], []
        for i in range(int(contacts.size())):
            obj = contacts.get(i)
            if isinstance(obj, User):
                did = int(obj.id)
            elif isinstance(obj, Chat):
                did = -int(obj.id)
            else:
                continue
            if did not in allowed:
                continue
            key = (rank.get(did, 1 << 30), obj)
            (busy if did in elsewhere and did not in members else free).append(key)
        free.sort(key=lambda k: k[0])
        busy.sort(key=lambda k: k[0])
        contacts.clear()
        for _r, obj in free + busy:
            contacts.add(obj)

    def _adapter_after_bind(self, param):
        if not self._adapters:
            return
        entry = self._adapters.get(_ident(param.thisObject))
        if entry is None or not _same(entry[0], param.thisObject):
            return
        ps = entry[1]
        if param.args is None or len(param.args) == 0:
            return
        cell = param.args[0].itemView
        Cell = jclass("org.telegram.ui.Cells.GroupCreateUserCell")
        if not isinstance(cell, Cell):
            return
        obj = cell.getObject()
        if isinstance(obj, str) or (obj is not None and str(obj) in ("archived", "muted", "read", "contacts", "non_contacts", "groups", "channels", "bots")):
            if str(obj) == "archived" and ps.get("exclude"):
                cell.setAlpha(0.35)
                try:
                    cell.setCheckBoxEnabled(False)
                except Exception:
                    pass
            else:
                cell.setAlpha(1.0)
            return
        User = jclass("org.telegram.tgnet.TLRPC$User")
        Chat = jclass("org.telegram.tgnet.TLRPC$Chat")
        if isinstance(obj, User):
            did = int(obj.id)
        elif isinstance(obj, Chat):
            did = -int(obj.id)
        else:
            return
        names = []
        rules = self._rules(ps["uid"])
        for f in self._load(ps["uid"])["folders"]:
            ofid = int(f["id"])
            if ofid == ps["fid"]:
                continue
            if self._in_rule(ps["acc"], rules[ofid], did, live=False):
                names.append(str(f["name"]))
        if not names:
            return
        cell.setObject(obj, get_private_field(cell, "currentName"), _t("in_folders") % _join_short(names))
        Theme = jclass("org.telegram.ui.ActionBar.Theme")
        cell.getStatusTextView().setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlueText))

    def _before_server_search(self, param):
        if self._helpers and _ident(param.thisObject) in self._helpers:
            param.setResult(None)

    # ---------- chat ⋮ menu ----------

    def _add_chat_menu(self):
        if self._chat_item is not None:
            return
        try:
            self._chat_item = self.add_menu_item(MenuItemData(
                menu_type=MenuItemType.CHAT_ACTION_MENU,
                text=_t("to_folder"),
                icon="msg_folders",
                item_id="archive_folders_chat",
                on_click=self._on_chat_menu,
            ))
        except Exception:
            traceback.print_exc()

    def _on_chat_menu(self, context):
        frag = context.get("fragment")
        acc = context.get("account")
        did = context.get("dialog_id")
        if did is None:
            if context.get("userId"):
                did = int(context.get("userId"))
            elif context.get("chatId"):
                did = -int(context.get("chatId"))
        if acc is None and frag is not None:
            acc = int(frag.getCurrentAccount())
        if frag is None or acc is None or not did:
            if frag is not None:
                BulletinHelper.show_error(_t("no_dialog"), frag)
            return
        acc, did = int(acc), int(did)
        _ui(lambda: self._show_assign_dialog(frag, acc, [did]))
