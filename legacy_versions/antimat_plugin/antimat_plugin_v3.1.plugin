__id__ = "antimat_plugin"
__name__ = "Антимат+"
__author__ = "@syspz"
__version__ = "3.1"
__description__ = "Заменяет мат и грубые слова на цензурные аналоги: склонения, латиница, цифры, символы-подмены и флуд 1 буквой."
__min_version__ = "11.12.0"

CREATOR_ID = 7198348151
CREATOR_EMOJI_ID = 5278602960987794957
CREATOR_BADGE_TEXT_RU = "Матерширник"
CREATOR_BADGE_TEXT_EN = "Swearer" #SWAGer, типо 1337 вся ф#гня

_RUN_RE = re.compile(r"([^\W\d_])\1", re.IGNORECASE | re.UNICODE)
_DOUBLE_CLASS_RE = re.compile(r"\[([^\]]+)\]\[\1\]")

def _collapse_classes(pattern):
    while True:
        collapsed = _DOUBLE_CLASS_RE.sub(r"[\1]", pattern)
        if collapsed == pattern:
            return collapsed
        pattern = collapsed

def _make_rule(pattern, replacement):
    return (
        re.compile(pattern, re.IGNORECASE),
        re.compile(_collapse_classes(pattern), re.IGNORECASE),
        replacement,
    )

_RULES = tuple(
    _make_rule(pattern, replacement) #векторный анализ считает это вредоносом, [Высокое семантическое сходство с вредоносным кодом (94.3%)]
