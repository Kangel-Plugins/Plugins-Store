def _collapse(text):
    chars = []
    starts = []
    ends = []
    previous = None
    for index, char in enumerate(text):
        if previous is not None and char.isalpha() and char.lower() == previous.lower():
            ends[-1] = index + 1
            continue
        chars.append(char)
        starts.append(index)
        ends.append(index + 1)
        previous = char
    return "".join(chars), starts, ends

def _replace(text, direct, stretched, replacement):
    if not _RUN_RE.search(text):
        return direct.sub(
            lambda match: replacement.capitalize()
            if match.group(0)[:1].isupper() else replacement,
            text,
        )
    collapsed, starts, ends = _collapse(text)
    parts = []
    position = 0
    changed = False
    for match in stretched.finditer(collapsed):
        start = starts[match.start()]
        end = ends[match.end() - 1]
        if start < position:
            continue
        parts.append(text[position:start])
        parts.append(
            replacement.capitalize()
            if text[start:start + 1].isupper() else replacement
        )
        position = end
        changed = True
    if not changed:
        return text
    parts.append(text[position:])
    return "".join(parts)

def _clean(text):
    if not text:
        return text
    for direct, stretched, replacement in _RULES:
        text = _replace(text, direct, stretched, replacement)
    return text

def _get_raw_id(entity_id):
    if entity_id is None:
        return None
    try:
        return int(entity_id.longValue())
    except Exception:
        try:
            return int(entity_id)
        except Exception:
            return None

class _BadgeHook(MethodHook):
    def __init__(self, manager):
        super().__init__()
        self.manager = manager

    def before_hooked_method(self, param):
        try:
            if not param.args or param.args[0] is None:
                return
            entity_id = param.args[0]
            raw_id = _get_raw_id(entity_id)
            if raw_id is not None and raw_id in self.manager.custom_badges:
                param.setResult(self.manager.custom_badges[raw_id])
            elif entity_id in self.manager.custom_badges:
                param.setResult(self.manager.custom_badges[entity_id])
        except Exception:
            pass

class _CreatorBadgeManager:
    def __init__(self, plugin):
        self.plugin = plugin
        self.custom_badges = {}
        self._hook_refs = []
        self.api_badge_source = None

    def setup(self):
        try:
            self._get_api_badge_source()
            if not self._hook_refs:
                self._setup_hooks()
            self._load_badges()
        except Exception:
            pass

    def _get_api_badge_source(self):
        try:
            BadgesController = find_class("com.exteragram.messenger.badges.BadgesController")
            if not BadgesController:
                return
            instance = getattr(BadgesController, "INSTANCE", None)
            if not instance:
                try:
                    field = BadgesController.getClass().getDeclaredField("INSTANCE")
                    field.setAccessible(True)
                    instance = field.get(None)
                except Exception:
                    pass
            if instance:
                self.api_badge_source = get_private_field(instance, "apiBadgeSource")
        except Exception:
            pass

    def _setup_hooks(self):
        try:
            ApiBadgeSource = find_class("com.exteragram.messenger.badges.source.ApiBadgeSource")
            if not ApiBadgeSource:
                return
            methods = []
            try:
                if hasattr(ApiBadgeSource, "getDeclaredMethods"):
                    methods = list(ApiBadgeSource.getDeclaredMethods())
                elif hasattr(ApiBadgeSource, "getClass"):
                    methods = list(ApiBadgeSource.getClass().getDeclaredMethods())
            except Exception:
                pass
            for method in methods:
                try:
                    if hasattr(method, "getName") and method.getName() == "getBadge":
                        method.setAccessible(True)
                        ref = self.plugin.hook_method(method, _BadgeHook(self))
                        if ref is not None:
                            self._hook_refs.append(ref)
                except Exception:
                    pass
        except Exception:
            pass

    def _load_badges(self):
        try:
            if not self.api_badge_source:
                self._get_api_badge_source()
            dto_class = BadgeDTO or find_class("com.exteragram.messenger.api.dto.BadgeDTO")
            BadgeInfo = find_class("com.exteragram.messenger.badges.source.BadgeInfo")
            ProfileStatus = find_class("com.exteragram.messenger.api.model.ProfileStatus")
            text = CREATOR_BADGE_TEXT_EN if self.plugin._is_en() else CREATOR_BADGE_TEXT_RU
            dto = None
            if dto_class:
                try:
                    dto = dto_class(CREATOR_EMOJI_ID, text)
                except Exception:
                    try:
                        dto = dto_class(Long.valueOf(CREATOR_EMOJI_ID), String(text))
                    except Exception:
                        pass
            if not dto:
                return
            j_uid = CREATOR_ID
            try:
                if Long is not None:
                    j_uid = Long.valueOf(CREATOR_ID)
            except Exception:
                j_uid = CREATOR_ID
            self.custom_badges[CREATOR_ID] = dto
            try:
                self.custom_badges[j_uid] = dto
            except Exception:
                pass
            cache = None
            if self.api_badge_source:
                cache = get_private_field(self.api_badge_source, "cache")
            info_status = None
            if ProfileStatus:
                info_status = getattr(ProfileStatus, "NONE", None) or getattr(ProfileStatus, "DEFAULT", None)
            if cache is not None and BadgeInfo:
                info = None
                try:
                    info = BadgeInfo(dto, info_status, False)
                except Exception:
                    try:
                        info = BadgeInfo(dto, None, False)
                    except Exception:
                        pass
                if info:
                    try:
                        cache.put(j_uid, info)
                    except Exception:
                        pass
        except Exception:
            pass

    def cleanup(self):
        try:
            for ref in self._hook_refs:
                try:
                    self.plugin.unhook_method(ref)
                except Exception:
                    pass
            self._hook_refs.clear()
            if self.api_badge_source:
                try:
                    cache = get_private_field(self.api_badge_source, "cache")
                    if cache is not None:
                        try:
                            cache.remove(Long.valueOf(CREATOR_ID))
                        except Exception:
                            cache.remove(CREATOR_ID)
                except Exception:
                    pass
            self.custom_badges.clear()
        except Exception:
            pass


class AntimatPlusPlugin(BasePlugin):
    def _is_en(self):
        value = self.get_setting("badge_english", False)
        if isinstance(value, str):
            return value.lower() in ("1", "true", "yes", "on")
        return bool(value)

    def _word_filter_enabled(self):
        value = self.get_setting("word_filter_enabled", True)
        if isinstance(value, str):
            return value.lower() not in ("0", "false", "no", "off", "")
        return bool(value)

    def on_plugin_load(self):
        self.add_on_send_message_hook()
        self._badge_manager = _CreatorBadgeManager(self)
        try:
            run_on_ui_thread(self._badge_manager.setup, 1500)
            run_on_ui_thread(self._badge_manager.setup, 4000)
        except Exception:
            self._badge_manager.setup()
        self.log("Антимат+ на связи")

    def on_plugin_unload(self):
        manager = getattr(self, "_badge_manager", None)
        if manager:
            manager.cleanup()

    def create_settings(self):
        en = self._is_en()
        return [
            Header(text="Antimat+" if en else "Антимат+"),
            Switch(
                key="word_filter_enabled",
                text="Word filter" if en else "Фильтр слов",
                default=True,
                subtext="Replace profanity in outgoing messages"
                if en else "Заменять мат и грубые слова в исходящих сообщениях",
            ),
            Switch(
                key="badge_english",
                text="English badge text" if en else "Английский текст бейджа",
                default=False,
                subtext="Swearer instead of Матерширник"
                if en else "Swearer вместо Матерширник",
                on_change=lambda _value: getattr(self, "_badge_manager", None)
                and self._badge_manager._load_badges(),
            ),
            Divider(),
        ]

    def on_send_message_hook(self, account, params):
        if not self._word_filter_enabled():
            return HookResult()
        original_message = getattr(params, "message", None)
        original_caption = getattr(params, "caption", None)
        message = _clean(original_message)
        caption = _clean(original_caption)
        if message == original_message and caption == original_caption:
            return HookResult()
        if message != original_message:
            params.message = message
            if getattr(params, "entities", None):
                params.entities = None
        if caption != original_caption:
            params.caption = caption
        self.log("Отфильтровано исходящее сообщение")
        # Ну что, попался?)
        return HookResult(strategy=HookStrategy.MODIFY_FINAL, params=params)