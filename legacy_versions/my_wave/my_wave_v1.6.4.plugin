_LOG_RING = []
_DEBUG = {"on": False, "logger": None}
_SECRET_RE = re.compile(r"(api_key|api_sig|session_key|token|secret|\bsk)=[^&\s'\")]+", re.I)
def scrub(text):
    return _SECRET_RE.sub(lambda m: m.group(1) + "=***", str(text))
def wlog(msg, debug=False):
    if debug and not _DEBUG["on"]:
        return
    text = scrub(msg)
    _LOG_RING.append(time.strftime("%H:%M:%S") + " " + text)
    del _LOG_RING[:-80]
    try:
        lg = _DEBUG["logger"]
        if lg is not None:
            (lg.debug if debug else lg.info)("%s", text)
        else:
            _sdk_log("[MyWave] " + text)
    except Exception:
        pass
def wlog_exc(where):
    wlog(where + ": " + traceback.format_exc().strip().splitlines()[-1])
    wlog(traceback.format_exc(), debug=True)
def to_list(jl):
    if jl is None:
        return []
    if isinstance(jl, (list, tuple)):
        return list(jl)
    try:
        return [jl.get(i) for i in range(jl.size())]
    except Exception:
        pass
    try:
        return list(jl)
    except Exception:
        return []
def ctx_get(ctx, key):
    if ctx is None:
        return None
    try:
        return ctx.get(key)
    except Exception:
        pass
    try:
        return ctx[key]
    except Exception:
        return None
def ui(fn, delay=0):
    def _wrapped():
        try:
            fn()
        except Exception:
            wlog_exc("ui")
    if delay:
        run_on_ui_thread(_wrapped, delay)
    else:
        run_on_ui_thread(_wrapped)
def _m3_bulletin(text):
    try:
        sheet = _field(M3_CLASS, "instance").get(None)
        if sheet is None or not sheet.isShowing():
            return False
        from org.telegram.messenger import R as R_tg
        from org.telegram.ui.Components import BulletinFactory
        factory = BulletinFactory.of(sheet.getBulletinContainer(), sheet.getBulletinResourcesProvider())
        factory.createSimpleBulletin(R_tg.raw.info, text).show()
        return True
    except Exception:
        return False
def _toast(kind, text):
    text = scrub(text)
    def _show():
        if _m3_bulletin(text):
            return
        try:
            getattr(BulletinHelper, kind)(text)
        except Exception:
            pass
    ui(_show)
def toast_info(text):
    _toast("show_info", text)
def toast_ok(text):
    _toast("show_success", text)
def toast_err(text):
    _toast("show_error", text)
_BRACKETS_JUNK = re.compile(
    r"[\(\[\{][^\)\]\}]*(official|video|audio|lyric|lyrics|clip|клип|премьера|hq|hd|320|kbps|mp3|remaster|visualizer|full version)[^\)\]\}]*[\)\]\}]",
    re.I,
)
_FEAT = re.compile(r"[\(\[]\s*(feat\.?|ft\.?|featuring|при уч\.?)\s+[^\)\]]*[\)\]]|\s+(feat\.?|ft\.?|featuring)\s+.*$", re.I)
_NON_WORD = re.compile(r"[^\w\s]+", re.U)
_SPACES = re.compile(r"\s+")
_ARTIST_SPLIT = re.compile(r"\s*[,;]\s*|\s+(?:&|feat\.?|ft\.?|featuring|vs\.?|x|×)\s+", re.I)
def norm_text(s):
    s = (s or "").casefold().replace("ё", "е")
    s = s.replace("_", " ")
    s = _NON_WORD.sub(" ", s)
    return _SPACES.sub(" ", s).strip()
def primary_artist(artist):
    a = (artist or "").strip()
    parts = [p.strip() for p in _ARTIST_SPLIT.split(a) if p and p.strip()]
    return parts[0] if parts else a
def artist_key(artist):
    return norm_text(primary_artist(artist))
def title_key(title):
    t = _BRACKETS_JUNK.sub(" ", title or "")
    t = _FEAT.sub(" ", t)
    return norm_text(t)
def track_key(artist, title):
    return artist_key(artist) + "|" + title_key(title)
_CYR_RE = re.compile("[а-яё]", re.I)
_TRANSLIT = {
    "а": "a", "б": "b", "в": "v", "г": "g", "д": "d", "е": "e", "ж": "zh", "з": "z", "и": "i", "й": "y",
    "к": "k", "л": "l", "м": "m", "н": "n", "о": "o", "п": "p", "р": "r", "с": "s", "т": "t", "у": "u",
    "ф": "f", "х": "h", "ц": "ts", "ч": "ch", "ш": "sh", "щ": "sch", "ъ": "", "ы": "y", "ь": "", "э": "e",
    "ю": "yu", "я": "ya",
}
def has_cyrillic(s):
    return bool(_CYR_RE.search(s or ""))
def _latin(s):
    return "".join(_TRANSLIT.get(c, c) for c in norm_text(s))
def same_artist(local, remote):
    target = _latin(remote).replace(" ", "")
    if not target:
        return False
    names = [local] + _ARTIST_SPLIT.split(local or "")
    return any(_latin(n).replace(" ", "") == target for n in names if n)
def _clean_title(title):
    t = _BRACKETS_JUNK.sub(" ", title or "")
    return _SPACES.sub(" ", _FEAT.sub(" ", t)).strip()
def same_title(local, remote):
    a, b = _latin(_clean_title(local)), _latin(_clean_title(remote))
    if not a or not b:
        return False
    if a == b:
        return True
    short, longer = sorted((a, b), key=len)
    return len(short) >= 4 and longer.startswith(short + " ")
_CHANNEL_RE = re.compile(
    r"^(?:https?://)?(?:www\.)?(?:t\.me/|telegram\.me/|telegram\.dog/)?(?:s/)?@?([A-Za-z][A-Za-z0-9_]{3,31})(?:[/?#].*)?$",
    re.I,
)
_TG_RESOLVE_RE = re.compile(r"^tg://resolve\?(?:.*&)?domain=([A-Za-z][A-Za-z0-9_]{3,31})", re.I)
def parse_channel_ref(text):
    u = (text or "").strip()
    m = _CHANNEL_RE.match(u) or _TG_RESOLVE_RE.match(u)
    return m.group(1) if m else None
def parse_filename(fname):
    base = re.sub(r"\.[A-Za-z0-9]{2,4}$", "", fname or "").replace("_", " ")
    base = re.sub(r"^\s*\d{1,3}\s*[\.\-)]\s*", "", base)
    for sep in (" - ", " – ", " — ", " -- "):
        if sep in base:
            a, t = base.split(sep, 1)
            return a.strip(), t.strip()
    return "", base.strip()
def classify_outcome(reason, progress, listened, threshold):
    progress = max(0.0, min(1.0, float(progress or 0.0)))
    if reason == "end" or progress >= 0.85:
        return "complete"
    if reason == "next" and progress < threshold and listened >= 1.0:
        return "skip"
    if progress >= 0.4 or listened >= 90:
        return "partial"
    return "none"
class JsonFile:
    def __init__(self, path, default):
        self.path = path
        self.data = default
        self.dirty = False
        self.lock = threading.RLock()
    def load(self):
        with self.lock:
            try:
                if self.path and os.path.exists(self.path):
                    with open(self.path, "r", encoding="utf-8") as f:
                        d = json.load(f)
                    if isinstance(d, dict):
                        self.data.update(d)
            except Exception:
                wlog_exc("load " + str(self.path))
                try:
                    os.replace(self.path, self.path + ".bad")
                except Exception:
                    pass
        return self
    def touch(self):
        self.dirty = True
    def save(self, force=False):
        with self.lock:
            if not self.path or not (self.dirty or force):
                return
            try:
                tmp = self.path + ".tmp"
                with open(tmp, "w", encoding="utf-8") as f:
                    json.dump(self.data, f, ensure_ascii=False, separators=(",", ":"))
                os.replace(tmp, self.path)
                self.dirty = False
            except Exception:
                wlog_exc("save " + str(self.path))
ARTIST_DELTAS = {
    "complete": 1.0,
    "partial": 0.3,
    "skip": -0.7,
    "like": 3.0,
    "unlike": -3.0,
    "dislike": -4.0,
}
LISTEN_OUTCOMES = ("complete", "partial", "skip", "seen")
class Profile:
    def __init__(self, jf):
        self.jf = jf
        d = jf.data
        d.setdefault("tracks", {})
        d.setdefault("artists", {})
        d.setdefault("history", [])
        d.setdefault("bans", {})
        d.setdefault("sq", [])
        d.setdefault("fv", {})
        d.setdefault("schema", 1)
        d.setdefault("streak", {"n": 0, "best": 0, "miss": 0})
        self._listened = sum(1 for t in d["tracks"].values() if t.get("p", 0) > 0)
    def listened(self):
        return self._listened
    @property
    def schema(self):
        return int(self.jf.data.get("schema", 1))
    def set_schema(self, value):
        with self.jf.lock:
            self.jf.data["schema"] = int(value)
            self.jf.touch()
    def taste_add(self, pairs, delta, now=None):
        if not pairs or not delta:
            return
        now = now or time.time()
        with self.jf.lock:
            fv = self.jf.data["fv"]
            for k, v in pairs:
                rec = fv.get(k)
                if rec:
                    age = max(0.0, now - rec[1])
                    rec[0] = round(rec[0] * 0.5 ** (age / TASTE_HALF_LIFE) + delta * v, 4)
                    rec[1] = int(max(now, rec[1]))
                else:
                    fv[k] = [round(delta * v, 4), int(now)]
            if len(fv) > TASTE_MAX:
                for k, _ in sorted(fv.items(), key=lambda kv: abs(kv[1][0]))[: len(fv) - TASTE_MAX]:
                    fv.pop(k, None)
            self.jf.touch()
    def taste(self, now=None):
        now = now or time.time()
        with self.jf.lock:
            rows = list(self.jf.data["fv"].items())
        return {k: r[0] * 0.5 ** (max(0.0, now - r[1]) / TASTE_HALF_LIFE) for k, r in rows if r[0]}
    @property
    def tracks(self):
        return self.jf.data["tracks"]
    @property
    def artists(self):
        return self.jf.data["artists"]
    def artist_score(self, ak, now=None):
        r = self.artists.get(ak)
        if not r:
            return 0.0
        now = now or time.time()
        age = max(0.0, now - r.get("ts", now))
        return float(r.get("sc", 0.0)) * (0.5 ** (age / HALF_LIFE))
    def artist_plays(self, ak):
        r = self.artists.get(ak)
        return int(r.get("p", 0)) if r else 0
    def track(self, tk):
        return self.tracks.get(tk)
    def is_played(self, tk):
        r = self.tracks.get(tk)
        return bool(r and r.get("p", 0) > 0)
    def is_liked(self, tk):
        r = self.tracks.get(tk)
        return bool(r and r.get("l"))
    def is_disliked(self, tk):
        r = self.tracks.get(tk)
        return bool(r and r.get("x"))
    def is_banned(self, ak):
        return bool(ak) and ak in self.jf.data["bans"]
    def ban(self, ak, name):
        with self.jf.lock:
            if ak:
                self.jf.data["bans"][ak] = name or ak
                self.jf.touch()
    def unban(self, ak):
        with self.jf.lock:
            self.jf.data["bans"].pop(ak, None)
            self.jf.touch()
    def bans(self):
        return dict(self.jf.data["bans"])
    def record(self, tk, ak, artist_name, title, outcome, now=None):
        now = now or time.time()
        with self.jf.lock:
            t = self.tracks.setdefault(tk, {"p": 0})
            if title and not t.get("n"):
                t["n"] = ((artist_name or "") + " — " + title)[:120]
            if outcome in LISTEN_OUTCOMES:
                if not t.get("p"):
                    self._listened += 1
                t["p"] = int(t.get("p", 0)) + 1
                t["lp"] = int(now)
            if outcome == "complete":
                t["c"] = int(t.get("c", 0)) + 1
            elif outcome == "skip":
                t["s"] = int(t.get("s", 0)) + 1
            elif outcome == "like":
                t["l"] = 1
                t.pop("x", None)
            elif outcome == "unlike":
                t.pop("l", None)
            elif outcome == "dislike":
                t["x"] = 1
                t.pop("l", None)
            if ak:
                a = self.artists.setdefault(ak, {"n": artist_name or ak, "sc": 0.0, "ts": now, "p": 0})
                delta = ARTIST_DELTAS.get(outcome, 0.0)
                if delta:
                    a["sc"] = round(self.artist_score(ak, now) + delta, 4)
                    a["ts"] = now
                if outcome in LISTEN_OUTCOMES:
                    a["p"] = int(a.get("p", 0)) + 1
                if artist_name:
                    a["n"] = artist_name
            hist = self.jf.data["history"]
            hist.append([tk, int(now), outcome])
            del hist[:-400]
            self.jf.touch()
    def streak(self):
        s = self.jf.data["streak"]
        return int(s["n"]), int(s["best"])
    def streak_update(self, outcome):
        with self.jf.lock:
            s = self.jf.data["streak"]
            if outcome == "complete":
                s["n"] = int(s["n"]) + 1
                s["miss"] = 0
                s["best"] = max(int(s["best"]), s["n"])
            elif outcome == "partial":
                s["miss"] = 0
            elif outcome == "skip":
                s["miss"] = int(s["miss"]) + 1
                if s["miss"] >= STREAK_MISSES:
                    s["n"], s["miss"] = 0, 0
            elif outcome == "dislike":
                s["n"], s["miss"] = 0, 0
            else:
                return int(s["n"])
            self.jf.touch()
            return int(s["n"])
    def add_time(self, ak, name, seconds):
        if not ak or seconds <= 0:
            return
        with self.jf.lock:
            a = self.artists.setdefault(ak, {"n": name or ak, "sc": 0.0, "ts": time.time(), "p": 0})
            a["sec"] = round(float(a.get("sec", 0.0)) + seconds, 1)
            self.jf.touch()
    def top_by_time(self, n=10):
        with self.jf.lock:
            rows = [(float(a.get("sec", 0.0)), a.get("n") or ak) for ak, a in self.artists.items() if a.get("sec")]
        rows.sort(key=lambda r: -r[0])
        return [(primary_artist(name), sec) for sec, name in rows[:n]]
    def top_artists(self, n=30, min_score=0.0):
        now = time.time()
        rows = []
        with self.jf.lock:
            snapshot = list(self.artists.items())
        for ak, r in snapshot:
            sc = self.artist_score(ak, now)
            if sc > min_score:
                rows.append((sc, ak, r.get("n") or ak))
        rows.sort(reverse=True)
        return [(ak, sc, name) for sc, ak, name in rows[:n]]
    def reset(self):
        with self.jf.lock:
            for k in ("tracks", "artists", "history", "fv"):
                self.jf.data[k] = {} if k != "history" else []
            self.jf.data["streak"] = {"n": 0, "best": 0, "miss": 0}
            self.jf.data.pop("time_est", None)
            self._listened = 0
            self.jf.touch()
class Track:
    __slots__ = ("pk", "cid", "mid", "a", "t", "d", "v", "dt", "ak", "tk", "vp", "cyr")
    def __init__(self, cid, mid, a, t, d, v, dt):
        self.cid = int(cid)
        self.mid = int(mid)
        self.pk = "%d:%d" % (self.cid, self.mid)
        self.a = a or ""
        self.t = t or ""
        self.d = int(d or 0)
        self.v = int(v or 0)
        self.dt = int(dt or 0)
        self.ak = artist_key(self.a)
        self.tk = track_key(self.a, self.t)
        self.vp = 0.5
        self.cyr = has_cyrillic(self.a) or has_cyrillic(self.t)
class Catalog:
    def __init__(self, jf):
        self.jf = jf
        jf.data.setdefault("channels", {})
        jf.data.setdefault("tracks", {})
        self.items = {}
        self.by_tk = {}
        self.memory = OrderedDict()
        self.mem_lock = threading.Lock()
        self.rebuild()
    @property
    def channels(self):
        return self.jf.data["channels"]
    def channel(self, cid):
        return self.channels.get(str(int(cid)))
    def add_channel(self, cid, acc, title, username):
        with self.jf.lock:
            ch = self.channels.setdefault(str(int(cid)), {"id": int(cid), "max_id": 0, "min_id": 0, "end": False, "ts": 0})
            ch["acc"] = int(acc)
            ch["title"] = title or ch.get("title") or str(cid)
            ch["username"] = username or ch.get("username") or ""
            ch.pop("err", None)
            self.jf.touch()
            return ch
    def remove_channel(self, cid):
        with self.jf.lock:
            self.channels.pop(str(int(cid)), None)
            self.jf.data["tracks"].pop(str(int(cid)), None)
            self.jf.touch()
        prefix = "%d:" % int(cid)
        with self.mem_lock:
            for pk in [k for k in self.memory if k.startswith(prefix)]:
                self.memory.pop(pk, None)
        self.rebuild()
    def channel_count(self, cid):
        return len(self.jf.data["tracks"].get(str(int(cid)), []))
    def add_entries(self, cid, entries):
        added = 0
        with self.jf.lock:
            lst = self.jf.data["tracks"].setdefault(str(int(cid)), [])
            known = {int(e[0]) for e in lst}
            for mid, m in entries:
                mid = int(mid)
                if mid in known:
                    continue
                known.add(mid)
                lst.append([mid, m.get("a", ""), m.get("t", ""), int(m.get("d", 0)), int(m.get("v", 0)), int(m.get("dt", 0))])
                added += 1
            if added:
                self.jf.touch()
        return added
    def remove_entry(self, pk):
        try:
            cid, mid = pk.split(":")
            mid = int(mid)
        except Exception:
            return
        with self.jf.lock:
            lst = self.jf.data["tracks"].get(cid)
            if lst:
                self.jf.data["tracks"][cid] = [e for e in lst if int(e[0]) != mid]
                self.jf.touch()
        if pk in self.items:
            items = dict(self.items)
            items.pop(pk, None)
            self.items = items
        with self.mem_lock:
            self.memory.pop(pk, None)
    def rebuild(self):
        items = {}
        by_tk = {}
        with self.jf.lock:
            for cid, lst in self.jf.data["tracks"].items():
                if cid not in self.channels:
                    continue
                chan = []
                for e in lst:
                    try:
                        tr = Track(int(cid), e[0], e[1], e[2], e[3], e[4], e[5])
                    except Exception:
                        continue
                    if not tr.t:
                        continue
                    chan.append(tr)
                if chan:
                    order = sorted(chan, key=lambda x: x.v)
                    n = max(1, len(order) - 1)
                    for i, tr in enumerate(order):
                        tr.vp = i / n if len(order) > 1 else 0.5
                for tr in chan:
                    items[tr.pk] = tr
                    best = by_tk.get(tr.tk)
                    if best is None or items[best].v < tr.v:
                        by_tk[tr.tk] = tr.pk
        self.items = items
        self.by_tk = by_tk
    def artists(self):
        cnt = {}
        for tr in list(self.items.values()):
            if tr.ak:
                cnt[tr.ak] = cnt.get(tr.ak, 0) + 1
        return cnt
    def remember(self, pk, msg):
        with self.mem_lock:
            self.memory[pk] = msg
            self.memory.move_to_end(pk)
            while len(self.memory) > MEMORY_MSGS:
                self.memory.popitem(last=False)
    def get_msg(self, pk):
        with self.mem_lock:
            m = self.memory.get(pk)
            if m is not None:
                self.memory.move_to_end(pk)
            return m
    def has_msg(self, pk):
        return pk in self.memory
class NetError(Exception):
    pass
class Http:
    def __init__(self, name, min_interval, headers=None, timeout=(4.0, 8.0), fail_limit=3, cooldown=1800.0):
        self.name = name
        self.min_interval = min_interval
        self.headers = dict(headers or {})
        self.timeout = timeout
        self.fail_limit = fail_limit
        self.cooldown = cooldown
        self._lock = threading.Lock()
        self._last = 0.0
        self._session = None
        self.fails = 0
        self.open_until = 0.0
        self.ok_count = 0
        self.err_count = 0
        self.total_ms = 0.0
    def available(self):
        return time.time() >= self.open_until
    def _throttle(self):
        with self._lock:
            now = time.time()
            wait = self._last + self.min_interval - now
            self._last = now + max(0.0, wait)
        if wait > 0:
            time.sleep(wait)
    def _sess(self):
        if self._session is None:
            import requests
            s = requests.Session()
            s.headers.update(self.headers)
            self._session = s
        return self._session
    def _failed(self):
        self.err_count += 1
        self.fails += 1
        if self.fails >= self.fail_limit:
            self.fails = 0
            self.open_until = time.time() + self.cooldown
            wlog("%s: недоступен, пауза %d мин" % (self.name, self.cooldown / 60))
    def request(self, method, url, **kw):
        if not self.available():
            raise NetError(self.name + ": пауза после сбоев")
        self._throttle()
        t0 = time.time()
        try:
            r = self._sess().request(method, url, timeout=self.timeout, **kw)
        except Exception as e:
            self._session = None
            self._failed()
            raise NetError("%s: %s" % (self.name, type(e).__name__)) from None
        if r.status_code == 429 or r.status_code >= 500:
            self._failed()
            raise NetError("%s: HTTP %d" % (self.name, r.status_code))
        self.fails = 0
        self.ok_count += 1
        self.total_ms += (time.time() - t0) * 1000.0
        return r
    def json(self, method, url, **kw):
        r = self.request(method, url, **kw)
        try:
            return r.json()
        except Exception:
            self._failed()
            raise NetError(self.name + ": плохой ответ") from None
    def report(self):
        avg = self.total_ms / self.ok_count if self.ok_count else 0.0
        state = "ok" if self.available() else "пауза"
        return "%s: %s, успешно %d (среднее %.0f мс), сбоев %d" % (self.name, state, self.ok_count, avg, self.err_count)
class LastFmError(Exception):
    def __init__(self, code, message):
        Exception.__init__(self, "Last.fm %s: %s" % (code, message))
        self.code = int(code or 0)
        self.message = message
def _as_list(x):
    if x is None:
        return []
    if isinstance(x, list):
        return x
    return [x]
class LastFm:
    URL = "https://ws.audioscrobbler.com/2.0/"
    def __init__(self, settings):
        self.settings = settings
        self.http = Http("Last.fm", 0.22, UA)
    @property
    def key(self):
        return str(self.settings("lfm_key", "") or "").strip()
    @property
    def secret(self):
        return str(self.settings("lfm_secret", "") or "").strip()
    @property
    def session(self):
        return str(self.settings("lfm_session", "") or "").strip()
    def available(self):
        return bool(self.key)
    def can_scrobble(self):
        return bool(self.key and self.secret and self.session)
    def sign(self, params):
        s = "".join(k + str(params[k]) for k in sorted(params) if k not in ("format", "callback"))
        s += self.secret
        return hashlib.md5(s.encode("utf-8")).hexdigest()
    def call(self, method, params, signed=False, post=False):
        p = {k: v for k, v in params.items() if v is not None}
        p["method"] = method
        p["api_key"] = self.key
        if signed:
            p["api_sig"] = self.sign(p)
        p["format"] = "json"
        if post:
            j = self.http.json("POST", self.URL, data=p)
        else:
            j = self.http.json("GET", self.URL, params=p)
        if isinstance(j, dict) and "error" in j:
            raise LastFmError(j.get("error"), j.get("message"))
        return j
    def similar(self, artist, limit=40):
        j = self.call("artist.getSimilar", {"artist": artist, "limit": limit, "autocorrect": 1})
        out = []
        for x in _as_list((j.get("similarartists") or {}).get("artist")):
            try:
                out.append((x.get("name") or "", float(x.get("match") or 0)))
            except Exception:
                pass
        return out
    def info(self, artist):
        j = self.call("artist.getInfo", {"artist": artist, "autocorrect": 1})
        a = j.get("artist") or {}
        listeners = 0
        try:
            listeners = int((a.get("stats") or {}).get("listeners") or 0)
        except Exception:
            pass
        tags = [str(t.get("name", "")).lower() for t in _as_list((a.get("tags") or {}).get("tag")) if isinstance(t, dict)]
        return {"tags": tags, "l": listeners}
    def get_token(self):
        return self.call("auth.getToken", {}, signed=True).get("token")
    def get_session(self, token):
        s = self.call("auth.getSession", {"token": token}, signed=True).get("session") or {}
        return s.get("key"), s.get("name")
    def now_playing(self, artist, title, duration):
        p = {"artist": artist, "track": title, "sk": self.session}
        if duration:
            p["duration"] = int(duration)
        self.call("track.updateNowPlaying", p, signed=True, post=True)
    def scrobble(self, batch):
        p = {"sk": self.session}
        for i, (artist, title, ts, dur) in enumerate(batch[:50]):
            p["artist[%d]" % i] = artist
            p["track[%d]" % i] = title
            p["timestamp[%d]" % i] = int(ts)
            if dur:
                p["duration[%d]" % i] = int(dur)
        self.call("track.scrobble", p, signed=True, post=True)
class Deezer:
    URL = "https://api.deezer.com"
    def __init__(self):
        self.http = Http("Deezer", 0.15, UA)
    def _get(self, path, params=None):
        j = self.http.json("GET", self.URL + path, params=params or {})
        if isinstance(j, dict) and j.get("error"):
            raise NetError("Deezer: ошибка API")
        return j
    def _artist(self, name):
        data = self._get("/search/artist", {"q": name, "limit": 1}).get("data") or []
        return data[0] if data else None
    def similar(self, name, limit=40):
        a = self._artist(name)
        if not a:
            return []
        data = self._get("/artist/%s/related" % a.get("id"), {"limit": limit}).get("data") or []
        n = max(1, len(data))
        return [(x.get("name") or "", round(1.0 - i / (n + 1.0), 3)) for i, x in enumerate(data)]
    def mood_tracks(self, query, playlists=4, tracks=300):
        out = []
        for pl in self._get("/search/playlist", {"q": query, "limit": playlists}).get("data") or []:
            for x in self._get("/playlist/%s/tracks" % pl.get("id"), {"limit": tracks}).get("data") or []:
                name = (x.get("artist") or {}).get("name")
                if name and x.get("title"):
                    out.append((name, x["title"]))
        return out
class Yandex:
    URL = "https://api.music.yandex.net"
    HEADERS = {
        "User-Agent": "Yandex-Music-API",
        "X-Yandex-Music-Client": "YandexMusicAndroid/24023621",
        "Accept-Language": "ru",
    }
    def __init__(self):
        self.http = Http("Яндекс Музыка", 0.34, self.HEADERS, fail_limit=5, cooldown=300.0)
    def _search(self, text, kind, size):
        j = self.http.json("GET", self.URL + "/search", params={
            "text": text, "type": kind, "page": 0, "pageSize": size, "nococrrect": "false",
        })
        result = (j.get("result") or {}) if isinstance(j, dict) else {}
        return (result.get(kind + "s") or {}).get("results") or []
    def track_labels(self, artist, title):
        return self.track_info(artist, title)[0]
    def track_info(self, artist, title):
        query = (primary_artist(artist) + " " + _clean_title(title)).strip()
        labels = []
        year = 0
        for x in self._search(query, "track", 5):
            if not same_title(title, x.get("title")):
                continue
            if not any(same_artist(artist, y.get("name")) for y in x.get("artists") or []):
                continue
            for album in x.get("albums") or []:
                g = album.get("genre")
                if g and g not in labels:
                    labels.append(g)
                y = album.get("year")
                if isinstance(y, int) and y > 1900:
                    year = min(year or y, y)
        labels.sort(key=lambda g: g in _Y_NOT_STYLE)
        return labels, year
    def artist_labels(self, artist):
        for x in self._search(primary_artist(artist), "artist", 3):
            if same_artist(artist, x.get("name")):
                return [g for g in x.get("genres") or [] if g]
        return []
    def mood_tracks(self, tag, playlists=MOOD_PLAYLISTS):
        j = self.http.json("GET", self.URL + "/tags/%s/playlist-ids" % tag)
        ids = ((j.get("result") or {}).get("ids") or []) if isinstance(j, dict) else []
        out = []
        for it in ids[:playlists]:
            out += self._playlist_tracks(it.get("uid"), it.get("kind"))
        return out
    def _playlist_tracks(self, uid, kind):
        j = self.http.json("GET", "%s/users/%s/playlists/%s" % (self.URL, uid, kind))
        rows = ((j.get("result") or {}).get("tracks") or []) if isinstance(j, dict) else []
        out = []
        for row in rows:
            tr = row.get("track") or {}
            artists = tr.get("artists") or []
            if artists and tr.get("title"):
                out.append((artists[0].get("name") or "", tr["title"]))
        return out
class ITunes:
    URL = "https://itunes.apple.com/search"
    def __init__(self):
        self.http = Http("iTunes", 3.1, UA)
    def track_labels(self, artist, title):
        query = (primary_artist(artist) + " " + _clean_title(title)).strip()
        j = self.http.json("GET", self.URL, params={"term": query, "entity": "song", "limit": 5, "country": "us"})
        labels = []
        for x in (j.get("results") or []) if isinstance(j, dict) else []:
            if same_title(title, x.get("trackName")) and same_artist(artist, x.get("artistName")):
                g = "it:" + str(x.get("primaryGenreName") or "").lower()
                if len(g) > 3 and g not in labels:
                    labels.append(g)
        return labels
class Similarity:
    TTL_SIM = 21 * DAY
    TTL_INFO = 30 * DAY
    def __init__(self, jf, lastfm, deezer, use_deezer):
        self.jf = jf
        self.lastfm = lastfm
        self.deezer = deezer
        self.use_deezer = use_deezer
        self.lfm_broken = False
        self.dirty = set()
        jf.data.setdefault("c", {})
        self._forget_old_genre_cache()
    def _forget_old_genre_cache(self):
        with self.jf.lock:
            c = self.jf.data["c"]
            stale = [k for k, r in c.items()
                     if (k[:2] in ("i:", "g:") and r.get("src") != "lfm") or (k[:2] == "g:" and not r.get("v"))]
            for k in stale:
                c.pop(k, None)
            if stale:
                self.jf.touch()
    @property
    def c(self):
        return self.jf.data["c"]
    def lfm_ok(self):
        return self.lastfm.available() and not self.lfm_broken
    def source(self):
        if self.lfm_ok():
            return "lfm"
        if self.use_deezer():
            return "dz"
        return None
    def _fresh(self, rec, ttl):
        return rec is not None and (time.time() - rec.get("ts", 0)) < ttl
    def _put(self, key, rec):
        with self.jf.lock:
            rec["ts"] = int(time.time())
            self.c[key] = rec
            if key.startswith("i:"):
                self.dirty.add(key[2:])
            self.jf.touch()
    def take_dirty(self):
        with self.jf.lock:
            out, self.dirty = self.dirty, set()
        return out
    def cached_similar(self, ak):
        rec = self.c.get("s:" + ak)
        return rec.get("v") if rec else None
    def cached_info(self, ak):
        return self.c.get("i:" + ak)
    def has_similar(self, ak):
        rec = self.c.get("s:" + ak)
        if not self._fresh(rec, self.TTL_SIM):
            return False
        return not (rec.get("src") == "dz" and self.lfm_ok())
    def has_info(self, ak):
        return self._fresh(self.c.get("i:" + ak), self.TTL_INFO)
    def _similar_raw(self, name):
        if self.source() == "lfm":
            try:
                return self.lastfm.similar(name), "lfm"
            except LastFmError as e:
                if e.code in (10, 26):
                    self.lfm_broken = True
                    wlog("Last.fm: неверный API key")
                else:
                    raise
        if self.source() == "dz":
            return self.deezer.similar(name), "dz"
        return None, None
    def fetch_similar(self, name):
        ak = artist_key(name)
        if not ak or self.has_similar(ak):
            return self.cached_similar(ak)
        if not self.source():
            return None
        try:
            raw, src = self._similar_raw(name)
        except LastFmError as e:
            if e.code != 6:
                raise
            raw, src = [], "lfm"
        if src is None:
            return None
        best = {}
        for nm, m in raw:
            k = artist_key(nm)
            if k and k != ak and m > best.get(k, -1):
                best[k] = m
        v = sorted(([k, round(m, 3)] for k, m in best.items()), key=lambda x: -x[1])[:50]
        self._put("s:" + ak, {"v": v, "src": src})
        return v
    def fetch_info(self, name):
        ak = artist_key(name)
        if not ak or self.has_info(ak):
            return self.cached_info(ak)
        if not self.lfm_ok():
            return None
        try:
            info = self.lastfm.info(name)
        except LastFmError as e:
            if e.code in (10, 26):
                self.lfm_broken = True
                return None
            if e.code != 6:
                raise
            info = {"tags": [], "l": 0}
        info["src"] = "lfm"
        self._put("i:" + ak, info)
        return info
class TrackGenres:
    TTL_MISS = 30 * DAY
    def __init__(self, jf):
        self.jf = jf
        jf.data.setdefault("t", {})
        jf.data.setdefault("a", {})
        jf.data.setdefault("yr", {})
        self.dirty = set()
        self.by_artist = {}
        for tk, rec in jf.data["t"].items():
            self._count(tk, rec[1:2])
    def _count(self, tk, labels):
        ak = tk.split("|", 1)[0]
        if ak and labels:
            row = self.by_artist.setdefault(ak, {})
            for lb in labels:
                row[lb] = row.get(lb, 0) + 1
    def has(self, tk, now=None):
        rec = self.jf.data["t"].get(tk)
        if not rec:
            return False
        return len(rec) > 1 or ((now or time.time()) - rec[0]) < self.TTL_MISS
    def labels(self, tk):
        rec = self.jf.data["t"].get(tk)
        return rec[1:] if rec else []
    def put(self, tk, labels, year=0):
        with self.jf.lock:
            self.jf.data["t"][tk] = [int(time.time())] + list(labels)
            self._count(tk, list(labels)[:1])
            if year:
                self.jf.data["yr"][tk] = int(year)
            self.dirty.add(tk.split("|", 1)[0])
            self.jf.touch()
    def year(self, tk):
        return int(self.jf.data["yr"].get(tk, 0))
    def take_dirty(self):
        with self.jf.lock:
            out, self.dirty = self.dirty, set()
        return out
    def has_artist(self, ak, now=None):
        rec = self.jf.data["a"].get(ak)
        if not rec:
            return False
        return len(rec) > 1 or ((now or time.time()) - rec[0]) < self.TTL_MISS
    def put_artist(self, ak, labels):
        with self.jf.lock:
            self.jf.data["a"][ak] = [int(time.time())] + list(labels)
            self.dirty.add(ak)
            self.jf.touch()
    def artist_labels(self, ak):
        row = self.by_artist.get(ak)
        if row:
            return sorted(row, key=lambda lb: -row[lb])
        rec = self.jf.data["a"].get(ak)
        return rec[1:] if rec else []
    def artist_known(self, ak):
        return bool(self.artist_labels(ak))
    def pending(self, items, limit=40):
        now = time.time()
        counts = {}
        for tr in items:
            counts[tr.ak] = counts.get(tr.ak, 0) + 1
        first, rest = [], []
        seen_tk, seen_ak = set(), set()
        done = 0
        for tr in items:
            if tr.tk in seen_tk:
                continue
            seen_tk.add(tr.tk)
            if self.has(tr.tk, now):
                done += 1
            elif tr.ak and tr.ak not in seen_ak and not self.artist_known(tr.ak):
                seen_ak.add(tr.ak)
                first.append(tr)
            else:
                rest.append(tr)
        first.sort(key=lambda t: -counts.get(t.ak, 0))
        rest.sort(key=lambda t: -t.dt)
        return (first + rest)[:limit], done, len(seen_tk)
class MoodBook:
    TTL = 30 * DAY
    def __init__(self, jf):
        self.jf = jf
        jf.data.setdefault("t", {})
        jf.data.setdefault("a", {})
        jf.data.setdefault("ts", 0)
        self._rebase()
    def _rebase(self):
        totals = [0] * len(MOODS)
        for row in self.jf.data["a"].values():
            for i, n in enumerate(row[: len(totals)]):
                totals[i] += n
        total = sum(totals)
        self.base = [x / total if total else 0.0 for x in totals]
    def ready(self):
        return bool(self.jf.data["t"])
    def stale(self, now=None):
        return (now or time.time()) - self.jf.data["ts"] >= self.TTL
    def replace(self, by_mood, now=None):
        tracks, artists = {}, {}
        for mood, rows in enumerate(by_mood):
            bit = 1 << mood
            seen = set()
            for artist, title in rows:
                ak = artist_key(artist)
                tk = track_key(artist, title)
                if not ak or tk in seen:
                    continue
                seen.add(tk)
                tracks[tk] = tracks.get(tk, 0) | bit
                artists.setdefault(ak, [0] * len(MOODS))[mood] += 1
        with self.jf.lock:
            self.jf.data["t"] = tracks
            self.jf.data["a"] = artists
            self.jf.data["ts"] = int(now or time.time())
            self.jf.touch()
        self._rebase()
    def level(self, tk, ak, mood):
        mask = self.jf.data["t"].get(tk)
        if mask:
            return MOOD_DIRECT if mask >> mood & 1 else 0.0
        row = self.jf.data["a"].get(ak) if ak else None
        if not row or sum(row) < MOOD_MIN_ARTIST or not self.base[mood]:
            return None
        share = (row[mood] + 0.5 * self.base[mood]) / (sum(row) + 0.5)
        return MOOD_ARTIST if share >= MOOD_LIFT * self.base[mood] else 0.0
    def counts(self):
        out = [0] * len(MOODS)
        for mask in self.jf.data["t"].values():
            for i in range(len(MOODS)):
                out[i] += mask >> i & 1
        return out
def dot_pairs(pairs, vec):
    total = 0.0
    get = vec.get
    for k, v in pairs:
        x = get(k)
        if x:
            total += v * x
    return total
def softmax_pick(pool, rng, tau=0.35):
    if not pool:
        return None
    m = max(s for s, _ in pool)
    ws = [math.exp((s - m) / tau) for s, _ in pool]
    r = rng.random() * sum(ws)
    acc = 0.0
    for w, (_, pk) in zip(ws, pool, strict=False):
        acc += w
        if acc >= r:
            return pk
    return pool[-1][1]
class WaveEngine:
    def __init__(self, catalog, profile, sim, settings, genres=None, moods=None):
        self.catalog = catalog
        self.profile = profile
        self.sim = sim
        self.settings = settings
        self.genres = genres if genres is not None else TrackGenres(JsonFile(None, {}))
        self.moods = moods if moods is not None else MoodBook(JsonFile(None, {}))
        self.lock = threading.RLock()
        self.rng = random.Random()
        self.base_rank = []
        self.explore_pool = []
        self.eligible_count = 0
        self.exhausted = False
        self.repeating = False
        self.drift_pool = []
        self._fv = {}
        self._pairs = {}
        self._rarity = {}
        self._rarity_n = -1
        self._rarity_changes = 0
        self._adj = {}
        self._rc_lock = threading.Lock()
        self.new_session()
    def character(self):
        try:
            return max(0, min(3, int(self.settings("character", 0))))
        except Exception:
            return 0
    def warm(self):
        return self.profile.listened() >= WARM_PLAYS
    def effective_character(self):
        return self.character() if self.warm() else COLD_CHARACTER
    def weights(self):
        return WEIGHTS[self.effective_character()]
    def mood(self):
        try:
            value = int(self.settings("mood", 0))
        except Exception:
            return None
        return value - 1 if 1 <= value <= len(MOODS) else None
    def mood_level(self, tr, mood):
        level = self.moods.level(tr.tk, tr.ak, mood)
        if level is not None:
            return level
        labels = self.genres.labels(tr.tk)[:1] or self.genres.artist_labels(tr.ak)[:1]
        return MOOD_GENRE if labels and labels[0] in MOODS[mood][3] else 0.0
    def skip_threshold(self):
        try:
            return SKIP_THRESHOLDS[int(self.settings("skip_threshold", 1))]
        except Exception:
            return 0.30
    def new_session(self, seed_ak=None, seed_tk=None):
        with self.lock:
            self.session = {}
            self.recent = []
            self.session_played = set()
            self.skip_streak = 0
            self.skipped_recent = []
            self.skipped_tracks = []
            self.explore_boost = 0
            self.seed_ak = seed_ak or None
            self.recent_tks = []
            self.repeating = False
            self.sv = {}
            self.cur_tk = None
            self.cur_rec = None
            self.drift_left = self.rng.randint(*DRIFT_EVERY)
            if seed_ak:
                self._bump(seed_ak, 1.0)
            if seed_tk or seed_ak:
                self._sv_add(self._feats_by_key(seed_tk or "", seed_ak or ""), 1.0)
            self._refresh_sv()
    def _raw_feats(self, tk, ak, cid, cyr):
        labels = self.genres.labels(tk)
        artist_labels = self.genres.artist_labels(ak)[:3] if ak else []
        primary = labels[0] if labels else (artist_labels[0] if artist_labels else None)
        out = {}
        if labels:
            out["g:" + labels[0]] = FEAT_W["genre"]
        for lb in artist_labels:
            out["ga:" + lb] = FEAT_W["artist_genre"]
        fam = genre_family(primary) if primary else None
        if fam:
            out["f:" + fam] = FEAT_W["family"]
        info = self.sim.cached_info(ak) if ak else None
        for tag in (info.get("tags") or [])[:5] if info else ():
            out["t:" + str(tag)] = FEAT_W["tag"]
        if cid:
            out["ch:%d" % cid] = FEAT_W["channel"]
        if cyr:
            out["ru"] = FEAT_W["ru"]
        year = self.genres.year(tk) if tk else 0
        if year:
            out["e:%d" % (year // 10 * 10)] = FEAT_W["epoch"]
        return out, primary
    def _make_feats(self, tk, ak, cid, cyr):
        raw, primary = self._raw_feats(tk, ak, cid, cyr)
        pairs = []
        total = 0.0
        for k, v in raw.items():
            x = round(v * self._rarity.get(k, 1.0), 3)
            if x > 0:
                key = (k, x)
                pairs.append(self._pairs.setdefault(key, key))
                total += x * x
        return tuple(pairs), math.sqrt(total), primary
    def feats(self, tr):
        row = self._fv.get(tr.ak)
        if row is None:
            row = self._fv[tr.ak] = {}
        rec = row.get(tr.pk)
        if rec is None:
            rec = row[tr.pk] = self._make_feats(tr.tk, tr.ak, tr.cid, tr.cyr)
        return rec
    def _track_by_key(self, tk):
        pk = self.catalog.by_tk.get(tk)
        return self.catalog.items.get(pk) if pk else None
    def _feats_by_key(self, tk, ak):
        tr = self._track_by_key(tk)
        return self.feats(tr) if tr is not None else self._make_feats(tk, ak, 0, False)
    def _refresh_features(self, items):
        dirty = self.genres.take_dirty()
        take = getattr(self.sim, "take_dirty", None)
        if take is not None:
            dirty = dirty | take()
        self._rarity_changes += len(dirty)
        n = len(items)
        if self._rarity_n < 0 or abs(n - self._rarity_n) >= max(20, n // 20) or self._rarity_changes >= max(20, n // 40):
            self._rebuild_rarity(items)
            return
        for ak in dirty:
            self._fv.pop(ak, None)
    def _rebuild_rarity(self, items):
        df = {}
        for tr in items:
            for k in self._raw_feats(tr.tk, tr.ak, tr.cid, tr.cyr)[0]:
                df[k] = df.get(k, 0) + 1
        n = max(1, len(items))
        self._rarity = {k: 1.0 - c / n for k, c in df.items()}
        self._rarity_n = len(items)
        self._rarity_changes = 0
        self._pairs = {}
        self._fv = {}
        try:
            self._build_adjacency()
        except Exception:
            wlog_exc("adjacency")
    def _build_adjacency(self):
        pair, cnt = {}, {}
        def link(a, b, w):
            pair[(a, b)] = pair.get((a, b), 0.0) + w
            pair[(b, a)] = pair.get((b, a), 0.0) + w
        rows = [list(r) for r in list(self.genres.by_artist.values())]
        rows += [rec[1:4] for rec in list(self.genres.jf.data["a"].values())]
        for row in rows:
            labels = [lb for lb in row if lb not in _Y_NOT_STYLE][:5]
            for i, a in enumerate(labels):
                cnt[a] = cnt.get(a, 0) + 1
                for b in labels[i + 1:]:
                    link(a, b, 1.0)
        prev = None
        for tk, ts, outcome in list(self.profile.jf.data["history"]):
            label = self.genres.labels(tk)[:1] if outcome in ("complete", "partial", "like") else []
            if label and prev and prev[0] != label[0] and ts - prev[1] < 3600:
                link(prev[0], label[0], 2.0)
            prev = (label[0], ts) if label else None
        adj = {}
        for (a, b), w in pair.items():
            adj.setdefault(a, {})[b] = w / math.sqrt(max(1, cnt.get(a, 1)) * max(1, cnt.get(b, 1)))
        families = {}
        for k in self._rarity:
            if k.startswith("g:"):
                fam = genre_family(k[2:])
                if fam:
                    families.setdefault(fam, []).append(k[2:])
        for labels in families.values():
            for a in labels:
                for b in labels:
                    if a != b:
                        row = adj.setdefault(a, {})
                        row[b] = row.get(b, 0.0) + 0.2
        self._adj = {a: dict(sorted(row.items(), key=lambda kv: -kv[1])[:4]) for a, row in adj.items()}
    def migrate_profile(self):
        p = self.profile
        if p.schema < 2:
            now = time.time()
            rows = sorted(list(p.tracks.items()), key=lambda kv: kv[1].get("lp", 0))
            for tk, t in rows:
                delta = (int(t.get("c", 0)) * FEATURE_DELTAS["complete"] + int(t.get("s", 0)) * FEATURE_DELTAS["skip"]
                         + (FEATURE_DELTAS["like"] if t.get("l") else 0.0) + (FEATURE_DELTAS["dislike"] if t.get("x") else 0.0))
                if delta:
                    p.taste_add(self._raw_pairs(tk, tk.split("|", 1)[0]), delta, now=int(t.get("lp") or now))
            wlog("профиль: долгий вкус собран, признаков %d" % len(p.jf.data["fv"]))
        if p.schema < 3:
            self._estimate_listening_time()
        if p.schema < PROFILE_SCHEMA:
            p.set_schema(PROFILE_SCHEMA)
    def _estimate_listening_time(self):
        p = self.profile
        found = False
        for tk, t in list(p.tracks.items()):
            ak = tk.split("|", 1)[0]
            if ak not in p.artists:
                continue
            tr = self._track_by_key(tk)
            dur = float(tr.d) if tr is not None and tr.d else 200.0
            done, skipped = int(t.get("c", 0)), int(t.get("s", 0))
            rest = max(0, int(t.get("p", 0)) - done - skipped)
            seconds = dur * (done + 0.6 * rest + 0.15 * skipped)
            if seconds > 0:
                p.add_time(ak, None, seconds)
                found = True
        if found:
            p.jf.data["time_est"] = 1
    def _raw_pairs(self, tk, ak):
        tr = self._track_by_key(tk)
        cid, cyr = (tr.cid, tr.cyr) if tr is not None else (0, False)
        return list(self._raw_feats(tk, ak, cid, cyr)[0].items())
    def _sv_add(self, rec, delta):
        for k, v in rec[0]:
            self.sv[k] = self.sv.get(k, 0.0) + delta * v
    def _refresh_sv(self):
        vec = dict(self.sv)
        if self.cur_rec:
            for k, v in self.cur_rec[0]:
                vec[k] = vec.get(k, 0.0) + CURRENT_TRACK_WEIGHT * v
        self._sv_eff = vec
        self._sv_norm = math.sqrt(sum(x * x for x in vec.values()))
    def _learn(self, tk, ak, outcome):
        delta = FEATURE_DELTAS.get(outcome)
        if not delta or not tk:
            return
        self._sv_add(self._feats_by_key(tk, ak), delta)
        if tk == self.cur_tk:
            self.cur_tk, self.cur_rec = None, None
        self.profile.taste_add(self._raw_pairs(tk, ak), delta)
    def _bump(self, ak, delta):
        if not ak:
            return
        self.session[ak] = self.session.get(ak, 0.0) + delta
        for a2, m in (self.sim.cached_similar(ak) or [])[:25]:
            self.session[a2] = self.session.get(a2, 0.0) + delta * float(m) * 0.6
    def on_track_started(self, tk, ak):
        with self.lock:
            for k in list(self.session):
                self.session[k] *= 0.88
            for k in list(self.sv):
                v = self.sv[k] * SESSION_DECAY
                if abs(v) < 0.02:
                    del self.sv[k]
                else:
                    self.sv[k] = v
            if ak:
                self.recent.append(ak)
                del self.recent[:-8]
            if tk:
                self.session_played.add(tk)
                self.recent_tks.append(tk)
                del self.recent_tks[:-REPEAT_GAP]
            self.cur_tk = tk or None
            self.cur_rec = self._feats_by_key(tk, ak) if tk else None
            if self.explore_boost > 0:
                self.explore_boost -= 1
            self.drift_left -= 1
            if self.drift_left < 0:
                self.drift_left = self.rng.randint(*DRIFT_EVERY)
            self._refresh_sv()
    def on_feedback(self, tk, ak, outcome, in_wave):
        deltas = {"complete": 1.0, "partial": 0.2, "skip": -1.2, "like": 2.5, "dislike": -3.0, "ban": -4.0}
        with self.lock:
            d = deltas.get(outcome)
            if d:
                self._bump(ak, d)
            self._learn(tk, ak, outcome)
            if not in_wave:
                self._refresh_sv()
                return False
            if outcome in ("skip", "dislike"):
                self.skip_streak += 1
                if ak:
                    self.skipped_recent.append(ak)
                    del self.skipped_recent[:-4]
                if tk:
                    self.skipped_tracks.append((tk, ak))
                    del self.skipped_tracks[:-4]
            elif outcome in ("complete", "partial", "like"):
                self.skip_streak = 0
            if self.skip_streak >= 2:
                self.change_direction()
                return True
            self._refresh_sv()
            return False
    def change_direction(self):
        with self.lock:
            for ak in self.skipped_recent[-2:]:
                self._bump(ak, -1.5)
            for tk, ak in self.skipped_tracks[-2:]:
                for k, v in self._feats_by_key(tk, ak)[0]:
                    self.sv[k] = min(self.sv.get(k, 0.0), 0.0) - 0.5 * v
            self.explore_boost = 3
            self.skip_streak = 0
            self.drift_left = self.rng.randint(*DRIFT_EVERY)
            self._refresh_sv()
    def filter_ctx(self):
        return {"dur": bool(self.settings("duration_filter", True)), "mood": self.mood()}
    def eligible(self, tr, allow_played, ctx=None, allow_session=False):
        ctx = ctx or self.filter_ctx()
        if tr.tk in self.session_played and not allow_session:
            return False
        t = self.profile.track(tr.tk)
        if t and t.get("x"):
            return False
        if tr.ak and self.profile.is_banned(tr.ak):
            return False
        if ctx["dur"] and tr.d and (tr.d < 60 or tr.d > 900):
            return False
        if not allow_played and t and t.get("p", 0) > 0:
            return False
        if ctx["mood"] is not None and self.mood_level(tr, ctx["mood"]) <= 0:
            return False
        return True
    def similarity_map(self):
        seeds = [(ak, math.tanh(sc / 3.0)) for ak, sc, _ in self.profile.top_artists(30, 0.2)]
        if self.seed_ak:
            seeds.append((self.seed_ak, 1.5))
        sim_map = {}
        total = 0.0
        for ak, wt in seeds:
            lst = self.sim.cached_similar(ak)
            if not lst:
                continue
            total += wt
            for a2, m in lst:
                sim_map[a2] = sim_map.get(a2, 0.0) + wt * float(m)
        if total > 0:
            for k in sim_map:
                sim_map[k] = min(1.0, sim_map[k] / total)
        return sim_map
    def _artist_block(self, ak, w, sim_map, now):
        sc = self.profile.artist_score(ak, now) if ak else 0.0
        T = math.tanh(sc / 3.0)
        S = sim_map.get(ak, 0.0) if ak else 0.0
        plays_a = self.profile.artist_plays(ak) if ak else 0
        F = min(1.0, math.log1p(plays_a) / math.log1p(30))
        N = 1.0 if plays_a == 0 else 0.0
        info = self.sim.cached_info(ak) if ak else None
        L = min(1.0, math.log10(info["l"] + 1) / 7.0) if info and info.get("l") else 0.35
        part = w["T"] * T + w["S"] * S + w["F"] * F + w["N"] * N
        if not ak:
            part -= 0.25
        return part, L
    def _taste_vector(self, now):
        rarity = self._rarity
        vec = {}
        total = 0.0
        for k, v in self.profile.taste(now).items():
            x = v * rarity.get(k, 1.0)
            if x:
                vec[k] = x
                total += x * x
        norm = math.sqrt(total)
        return vec, (1.0 / (norm + TASTE_PRIOR) if norm > 0 else 0.0)
    def base_score(self, tr, w, sim_map, now, played_rec=None, blocks=None, taste=None, taste_k=0.0):
        ak = tr.ak
        block = blocks.get(ak) if blocks is not None else None
        if block is None:
            block = self._artist_block(ak, w, sim_map, now)
            if blocks is not None:
                blocks[ak] = block
        P = 0.6 * tr.vp + 0.4 * block[1]
        R = max(0.0, 1.0 - (now - tr.dt) / (365 * DAY)) if tr.dt else 0.3
        s = block[0] + w["P"] * P + w["R"] * R
        if taste_k:
            pairs, norm, _ = self.feats(tr)
            if norm:
                s += w["G"] * taste_k * dot_pairs(pairs, taste) / norm
        if played_rec:
            lp = played_rec.get("lp", 0)
            s -= 1.0 * max(0.0, 1.0 - (now - lp) / (30 * DAY))
            if played_rec.get("l"):
                s += 0.5
        return s + self.rng.gauss(0, 0.05)
    def _rank_with_session(self, rows, w, vec, norm):
        if norm <= 0:
            return [(s, pk) for s, pk, _ in rows[:400]]
        k = w["Qf"] / (norm + SESSION_PRIOR)
        scored = []
        for s, pk, tr in rows[:RERANK_TOP]:
            pairs, fnorm, _ = self.feats(tr)
            scored.append((s + k * dot_pairs(pairs, vec) / fnorm if fnorm else s, s, pk))
        scored.sort(reverse=True)
        return [(s, pk) for _, s, pk in scored[:400]]
    def _drift_candidates(self, rows, vec):
        best, val = None, 0.0
        for k, v in vec.items():
            if v > val and k.startswith("g:"):
                best, val = k[2:], v
        neighbours = self._adj.get(best) if best else None
        if not neighbours:
            return []
        out = []
        for s, pk, tr in rows:
            if self.feats(tr)[2] in neighbours:
                out.append((s, pk))
                if len(out) >= PICK_POOL:
                    break
        return out
    def recompute(self):
        now = time.time()
        with self._rc_lock:
            with self.lock:
                w = self.weights()
                ctx = self.filter_ctx()
                items = list(self.catalog.items.values())
                vec, norm = dict(self._sv_eff), self._sv_norm
            self._refresh_features(items)
            sim_map = self.similarity_map()
            taste, taste_k = self._taste_vector(now)
            blocks = {}
            best = {}
            stage = 0
            for stage in range(3):
                best.clear()
                for tr in items:
                    if not self.eligible(tr, stage >= 1, ctx, stage >= 2):
                        continue
                    prec = self.profile.track(tr.tk) if stage >= 1 else None
                    s = self.base_score(tr, w, sim_map, now, prec, blocks, taste, taste_k)
                    if ctx["mood"] is not None:
                        s += MOOD_WEIGHT * self.mood_level(tr, ctx["mood"])
                    cur = best.get(tr.tk)
                    if cur is None or cur[0] < s:
                        best[tr.tk] = (s, tr.pk, tr)
                if len(best) >= (5 if stage == 0 else 1):
                    break
            rows = sorted(best.values(), key=lambda x: -x[0])
            base_rank = self._rank_with_session(rows, w, vec, norm)
            drift_pool = self._drift_candidates(rows, vec)
            unexplored = []
            for s, pk, tr in rows:
                if not tr.ak or self.profile.artist_plays(tr.ak) > 0 or sim_map.get(tr.ak, 0) > 0.15:
                    continue
                if abs(self.profile.artist_score(tr.ak, now)) > 0.05:
                    continue
                unexplored.append((0.6 * tr.vp + self.rng.random() * 0.4, s, pk))
            unexplored.sort(reverse=True)
            pool = unexplored[:150]
            self.rng.shuffle(pool)
            explore_pool = sorted(((s, pk) for _, s, pk in pool[:60]), key=lambda x: -x[0])
            with self.lock:
                self.exhausted = stage >= 1
                self.repeating = stage >= 2
                self.base_rank = base_rank
                self.drift_pool = drift_pool
                self.explore_pool = explore_pool
                self.eligible_count = len(rows)
                return self.eligible_count
    def prefetch_candidates(self, n=45, exclude=()):
        with self.lock:
            out = []
            for _, pk in self.base_rank:
                if pk not in exclude:
                    out.append(pk)
                if len(out) >= n - 15:
                    break
            for _, pk in self.drift_pool[:8] + self.explore_pool[:15]:
                if pk not in exclude and pk not in out:
                    out.append(pk)
            return out
    def _near_artists(self):
        near = {}
        last = [ak for ak in self.recent[-3:] if ak]
        for ak in last:
            for a2, m in (self.sim.cached_similar(ak) or [])[:25]:
                x = float(m) * 0.7
                if x > near.get(a2, 0.0):
                    near[a2] = x
        for ak in last:
            near[ak] = 1.0
        return near
    def pick(self, is_ready, exclude=(), ready_only=True, exclude_tks=(), offset=0, sv=None):
        with self.lock:
            w = self.weights()
            vec, norm = sv if sv is not None else (self._sv_eff, self._sv_norm)
            qf = w["Qf"] / (norm + SESSION_PRIOR) if norm > 0 else 0.0
            eps = w["eps"] + (0.45 if self.explore_boost > 0 else 0.0)
            use_explore = bool(self.explore_pool) and self.rng.random() < eps
            if self.drift_pool and self.drift_left - offset == 0:
                sources = [self.drift_pool, self.base_rank]
            elif use_explore:
                sources = [self.explore_pool, self.base_rank]
            else:
                sources = [self.base_rank]
            last_ak = self.recent[-1] if self.recent else None
            recent5 = self.recent[-5:]
            near = self._near_artists()
            session = self.session
            gap = min(REPEAT_GAP, max(0, len(self.base_rank) - 1)) if self.repeating else 0
            blocked = set(self.recent_tks[-gap:]) if gap else ()
            for allow_same_artist in (False, True):
                for source in sources:
                    pool = []
                    for base, pk in source:
                        if pk in exclude:
                            continue
                        tr = self.catalog.items.get(pk)
                        if tr is None or tr.tk in exclude_tks or tr.tk in blocked:
                            continue
                        if tr.tk in self.session_played and not self.repeating:
                            continue
                        if ready_only and not is_ready(pk):
                            continue
                        if tr.ak and tr.ak == last_ak and not allow_same_artist:
                            continue
                        if tr.ak and self.profile.is_banned(tr.ak):
                            continue
                        if self.profile.is_disliked(tr.tk):
                            continue
                        s = base - 0.5 * recent5.count(tr.ak) - MMR_LAMBDA * near.get(tr.ak, 0.0)
                        q = session.get(tr.ak, 0.0) if tr.ak else 0.0
                        if q:
                            s += w["Q"] * math.tanh(q / 2.0)
                        if qf:
                            pairs, fnorm, _ = self.feats(tr)
                            if fnorm:
                                s += qf * dot_pairs(pairs, vec) / fnorm
                        pool.append((s, pk))
                        if len(pool) >= PICK_SCAN:
                            break
                    if pool:
                        pool.sort(reverse=True)
                        return softmax_pick(pool[:PICK_POOL], self.rng)
            return None
    def pick_many(self, n, is_ready, exclude=(), ready_only=True, exclude_tks=()):
        out = []
        ex = set(exclude)
        ex_tks = set(exclude_tks)
        with self.lock:
            saved_recent = list(self.recent)
            vec = dict(self._sv_eff)
            try:
                for i in range(n):
                    norm = math.sqrt(sum(x * x for x in vec.values()))
                    pk = self.pick(is_ready, ex, ready_only, ex_tks, i, (vec, norm))
                    if pk is None:
                        break
                    out.append(pk)
                    ex.add(pk)
                    tr = self.catalog.items.get(pk)
                    if tr:
                        ex_tks.add(tr.tk)
                        if tr.ak:
                            self.recent.append(tr.ak)
                        vec = {k: v * SESSION_DECAY for k, v in vec.items()}
                        for k, v in self.feats(tr)[0]:
                            vec[k] = vec.get(k, 0.0) + CURRENT_TRACK_WEIGHT * v
            finally:
                self.recent = saved_recent
        return out
class Play:
    __slots__ = ("key", "tk", "ak", "a", "t", "d", "start", "listened", "prog", "in_wave",
                 "scrobbled", "last_seen", "acc")
    def __init__(self, key, a, t, d, in_wave, acc):
        self.key = key
