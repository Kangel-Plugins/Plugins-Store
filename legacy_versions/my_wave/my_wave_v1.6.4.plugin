        self.tk = track_key(self.a, self.t)
        self.start = time.time()
        self.listened = 0.0
        self.prog = 0.0
        self.in_wave = in_wave
        self.scrobbled = False
        self.last_seen = time.time()
        self.acc = acc
class TgError(Exception):
    def __init__(self, text, code=0):
        Exception.__init__(self, text)
        self.text = text or ""
        self.code = code
def extract_meta(msg):
    try:
        media = msg.media
        if media is None or not isinstance(media, TLRPC.TL_messageMediaDocument):
            return None
        doc = media.document
        if doc is None:
            return None
        performer = title = fname = ""
        dur = 0
        is_audio = False
        for attr in to_list(doc.attributes):
            if isinstance(attr, TLRPC.TL_documentAttributeAudio):
                if attr.voice:
                    return None
                is_audio = True
                performer = attr.performer or ""
                title = attr.title or ""
                dur = int(attr.duration or 0)
            elif isinstance(attr, TLRPC.TL_documentAttributeFilename):
                fname = attr.file_name or ""
        mime = str(doc.mime_type or "").lower()
        if not is_audio and not mime.startswith("audio/"):
            return None
        if not performer or not title:
            fa, ft = parse_filename(fname)
            performer = performer or fa
            title = title or ft
        if not title:
            return None
        return {"a": performer.strip(), "t": title.strip(), "d": dur,
                "v": int(getattr(msg, "views", 0) or 0), "dt": int(msg.date or 0)}
    except Exception:
        return None
def mo_key(mo):
    try:
        did = int(mo.getDialogId())
        mid = int(mo.getId())
    except Exception:
        return None
    if did < 0:
        return "%d:%d" % (-did, mid)
    return "d%d:%d" % (did, mid)
def mo_meta(mo):
    try:
        return extract_meta(mo.messageOwner)
    except Exception:
        return None
TG_STATS = {"timeout": 0, "flood": 0}
class TgApi:
    def call(self, req, account, timeout=15.0):
        try:
            req.getObjectSize()
        except Exception as e:
            raise TgError("BAD_REQUEST " + str(e)[:100]) from None
        ev = threading.Event()
        box = {}
        def cb(res, err):
            box["r"] = res
            box["e"] = err
            ev.set()
        try:
            send_request(req, cb, account=account)
        except TypeError:
            send_request(req, cb)
        if not ev.wait(timeout):
            raise TgError("TIMEOUT")
        err = box.get("e")
        if err is not None:
            raise TgError(str(getattr(err, "text", "") or "ERROR"), getattr(err, "code", 0))
        return box.get("r")
    def call_retry(self, req, account, tries=3):
        timeouts = 0
        for i in range(tries):
            try:
                return self.call(req, account)
            except TgError as e:
                m = re.match(r"FLOOD_WAIT_(\d+)", e.text)
                if m:
                    TG_STATS["flood"] += 1
                    if i < tries - 1:
                        time.sleep(min(int(m.group(1)) + 1, 60))
                        continue
                if e.text == "TIMEOUT":
                    TG_STATS["timeout"] += 1
                    timeouts += 1
                    if timeouts < 2 and i < tries - 1:
                        continue
                raise
    def put_entities(self, account, res):
        users = getattr(res, "users", None)
        chats = getattr(res, "chats", None)
        def _put():
            mc = MessagesController.getInstance(account)
            if users is not None:
                mc.putUsers(users, False)
            if chats is not None:
                mc.putChats(chats, False)
        ui(_put)
        try:
            MessagesStorage.getInstance(account).putUsersAndChats(users, chats, True, True)
        except Exception:
            pass
    def resolve_username(self, account, username):
        req = TLRPC.TL_contacts_resolveUsername()
        req.username = username
        res = self.call_retry(req, account)
        self.put_entities(account, res)
        chats = to_list(res.chats)
        return chats[0] if chats else None
    def get_chat(self, account, ch):
        mc = MessagesController.getInstance(account)
        chat = None
        try:
            chat = mc.getChat(Long.valueOf(int(ch["id"])))
        except Exception:
            chat = None
        if chat is None:
            try:
                chat = MessagesStorage.getInstance(account).getChatSync(int(ch["id"]))
                if chat is not None:
                    ui(lambda: mc.putChat(chat, True))
            except Exception:
                chat = None
        if chat is None and ch.get("username"):
            chat = self.resolve_username(account, ch["username"])
        return chat
    @staticmethod
    def input_peer(chat):
        p = TLRPC.TL_inputPeerChannel()
        p.channel_id = chat.id
        p.access_hash = chat.access_hash
        return p
    @staticmethod
    def input_channel(chat):
        c = TLRPC.TL_inputChannel()
        c.channel_id = chat.id
        c.access_hash = chat.access_hash
        return c
    def search_music(self, account, peer, offset_id=0, min_id=0, limit=100):
        req = TLRPC.TL_messages_search()
        req.peer = peer
        req.q = ""
        req.filter = TLRPC.TL_inputMessagesFilterMusic()
        req.min_date = 0
        req.max_date = 0
        req.offset_id = int(offset_id)
        req.add_offset = 0
        req.limit = int(limit)
        req.max_id = 0
        req.min_id = int(min_id)
        req.hash = 0
        res = self.call_retry(req, account)
        self.put_entities(account, res)
        return to_list(res.messages), getattr(res, "count", 0)
    def get_messages(self, account, chat, mids):
        req = TLRPC.TL_channels_getMessages()
        req.channel = self.input_channel(chat)
        for mid in mids[:100]:
            req.id.add(Integer(int(mid)))
        res = self.call(req, account, timeout=8.0)
        self.put_entities(account, res)
        return to_list(res.messages)
class TaskRunner:
    def __init__(self, name):
        self.name = name
        self.q = queue.Queue()
        self.pending = set()
        self.lock = threading.Lock()
        self.stop_ev = threading.Event()
        self.thread = None
    def start(self):
        self.stop_ev.clear()
        self.thread = threading.Thread(target=self._loop, name="MyWave-" + self.name, daemon=True)
        self.thread.start()
    def stop(self):
        self.stop_ev.set()
    def submit(self, name, fn):
        with self.lock:
            if name in self.pending:
                return False
            self.pending.add(name)
        self.q.put((name, fn))
        return True
    def busy(self, name):
        with self.lock:
            return name in self.pending
    def _loop(self):
        while not self.stop_ev.is_set():
            try:
                name, fn = self.q.get(timeout=1.0)
            except queue.Empty:
                continue
            try:
                fn()
            except Exception:
                wlog_exc("task " + name)
            finally:
                with self.lock:
                    self.pending.discard(name)
_CLASS_CACHE = {}
_FIELD_CACHE = {}
def java_class(name):
    if name in _CLASS_CACHE:
        return _CLASS_CACHE[name]
    found = None
    try:
        c = find_class(name)
    except Exception:
        c = None
    if c is not None:
        try:
            if c.getName() == name:
                found = c
        except Exception:
            pass
        if found is None:
            try:
                k = c.getClass()
                if k.getName() == name:
                    found = k
            except Exception:
                pass
    if found is None:
        try:
            from java.lang import Class
            found = Class.forName(name, False, ApplicationLoader.applicationContext.getClassLoader())
        except Exception:
            found = None
    _CLASS_CACHE[name] = found
    return found
def _field(cls_name, field):
    key = cls_name + "#" + field
    f = _FIELD_CACHE.get(key)
    if f is None:
        cls = java_class(cls_name)
        f = cls.getDeclaredField(field)
        f.setAccessible(True)
        _FIELD_CACHE[key] = f
    return f
MC_CLASS = "org.telegram.messenger.MediaController"
def mc_get(name):
    return _field(MC_CLASS, name).get(MediaController.getInstance())
def mc_set_int(name, value):
    _field(MC_CLASS, name).setInt(MediaController.getInstance(), int(value))
def mc_set_bool(name, value):
    _field(MC_CLASS, name).setBoolean(MediaController.getInstance(), bool(value))
def icon_id(name):
    try:
        ctx = ApplicationLoader.applicationContext
        return ctx.getResources().getIdentifier(name, "drawable", ctx.getPackageName())
    except Exception:
        return 0
