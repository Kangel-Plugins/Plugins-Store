SHAKE_TIER = 4
BREATH_TIER = 5
TRACK_SCALE = (1.0, 1.0, 1.5, 1.5, 2.0, 2.0)
def fx_bump(view, scale):
    view.setScaleX(jfloat(scale))
    view.setScaleY(jfloat(scale))
    view.animate().scaleX(jfloat(1.0)).scaleY(jfloat(1.0)).setDuration(jlong(300)).start()
def fx_rise(view, distance):
    view.setTranslationY(jfloat(float(distance)))
    view.animate().translationY(jfloat(0.0)).setDuration(jlong(300)).start()
def fx_shake(view, step):
    for i, x in enumerate((step, -step, step / 2.0, 0.0)):
        ui(lambda x=x: view.animate().translationX(jfloat(float(x))).setDuration(jlong(50)).start(), 60 * i)
def fx_growth(view, tier, dp):
    if tier <= 0:
        return
    fx_bump(view, 1.2 if tier == 1 else 1.35)
    if tier == 3:
        fx_rise(view, dp(8))
    if tier >= SHAKE_TIER:
        fx_shake(view, dp(4))
class Breath:
    PERIOD = 1000
    def __init__(self, views, alive):
        self.views = views
        self.alive = alive
        self.running = False
        self.low = False
    def start(self):
        if not self.running:
            self.running = True
            self.low = False
            self._tick()
    def stop(self):
        if self.running:
            self.running = False
            for view in self.views():
                view.animate().cancel()
                view.setAlpha(jfloat(1.0))
    def _tick(self):
        if not self.running:
            return
        try:
            if not self.alive():
                self.stop()
                return
            self.low = not self.low
            for view in self.views():
                view.animate().alpha(jfloat(0.45 if self.low else 1.0)).setDuration(jlong(900)).start()
            run_on_ui_thread(self._tick, self.PERIOD)
        except Exception:
            self.running = False
            wlog_exc("breath")
class WavePanel:
    MATCH, WRAP = -1, -2
    def __init__(self, plugin, activity):
        self.p = plugin
        self.act = activity
        self.sheet = None
        self.root = None
        self._shown_streak = None
        self._number = None
        self.breath = Breath(lambda: [self._number] if self._number is not None else [], self.is_open)
    def show(self):
        from android.widget import LinearLayout, ScrollView
        from org.telegram.ui.ActionBar import BottomSheet
        self.root = LinearLayout(self.act)
        self.root.setOrientation(LinearLayout.VERTICAL)
        self.render()
        scroll = ScrollView(self.act)
        scroll.addView(self.root)
        builder = BottomSheet.Builder(self.act)
        builder.setCustomView(scroll)
        builder.setApplyTopPadding(False)
        builder.setApplyBottomPadding(False)
        self.sheet = builder.show()
        self._breath_sync()
    def _breath_sync(self):
        tier = streak_tier(self.p.profile.streak()[0])
        if self._number is not None and tier >= BREATH_TIER and self.is_open():
            self.breath.start()
        else:
            self.breath.stop()
    def is_open(self):
        try:
            return self.sheet is not None and bool(self.sheet.isShowing())
        except Exception:
            return False
    def close(self):
        if self.is_open():
            self.sheet.dismiss()
    def render(self):
        p, eng = self.p, self.p.engine
        self.root.removeAllViews()
        self._number = None
        self._add(self._text("Моя волна", 20, "key_dialogTextBlack", bold=True), top=16)
        self._add(self._text(p.panel_status(), 14, "key_dialogTextGray3"), top=4, bottom=12)
        if not p.catalog.channels:
            self._button("Добавить канал-источник", p.ui_add_channel_dialog, primary=True)
            self._row("Все настройки", self._open_settings)
            return
        self._button("Остановить волну" if p.active else "Запустить волну", self._toggle, primary=True)
        self._track_actions()
        self._header("Настроение")
        self._chips([MOOD_ANY] + [m[0] for m in MOODS], (eng.mood() + 1) if eng.mood() is not None else 0,
                    lambda i: p._set_mode("mood", i), 3)
        self._header("Характер")
        if eng.warm():
            self._chips(CHARACTERS, eng.character(), lambda i: p._set_mode("character", i), 2)
        else:
            self._add(self._text("Волна знакомится с вами: %d из %d треков. Потом здесь можно будет выбрать её характер."
                                 % (p.profile.listened(), WARM_PLAYS), 14, "key_dialogTextGray3"))
        self._header("Настройки")
        self._switch("Только треки 1–15 минут", "duration_filter", True)
        self._switch("Учиться на всей музыке", "learn_all", True)
        self._switch("Плашка при смене трека", "track_bulletin", p._bulletin_default())
        self._row("Все настройки и каналы", self._open_settings)
        if p.get_setting("show_streak", True):
            self._streak()
        self._breath_sync()
    def _streak(self):
        from android.widget import LinearLayout
        n, best = self.p.profile.streak()
        tier = streak_tier(n)
        low, name, line = STREAK_TIERS[tier]
        inverted = tier >= STREAK_INVERT_FROM
        ink = "key_featuredStickers_buttonText" if inverted else "key_dialogTextBlack"
        box = LinearLayout(self.act)
        box.setOrientation(LinearLayout.VERTICAL)
        box.setBackground(self._rounded("key_featuredStickers_addButton" if inverted else "key_dialogBackgroundGray"))
        box.setPadding(self._dp(16), self._dp(14), self._dp(16), self._dp(14))
        box.addView(self._text(name, 16, ink, bold=True))
        number = self._text(str(n), 34 + tier * 6, ink, bold=True)
        box.addView(number)
        box.addView(self._text(line, 14, ink))
        if tier + 1 < len(STREAK_TIERS):
            high, next_name, _ = STREAK_TIERS[tier + 1]
            box.addView(self._bar(n - low, high - n, ink), self._bar_params())
            footer = "До уровня «%s» осталось %d. Рекорд: %d" % (next_name, high - n, best)
        else:
            footer = "Рекорд: %d" % best
        box.addView(self._text(footer, 13, ink))
        self._add(box, top=8, bottom=20)
        if self._shown_streak is not None and n > self._shown_streak:
            self._pulse(number, tier)
        self._number = number
        self._shown_streak = n
    def _bar_params(self):
        lp = self._params(self.MATCH, top=10, bottom=8)
        lp.height = self._dp(6)
        return lp
    def _bar(self, done, left, ink):
        from android.view import View
        from android.widget import LinearLayout
        bar = LinearLayout(self.act)
        bar.setOrientation(LinearLayout.HORIZONTAL)
        for weight, color in ((done, ink), (left, "key_dialogTextGray3")):
            if weight > 0:
                part = View(self.act)
                part.setBackground(self._rounded(color))
                lp = LinearLayout.LayoutParams(0, self._dp(6), float(weight))
                bar.addView(part, lp)
        return bar
    def _pulse(self, view, tier):
        try:
            view.setScaleX(jfloat(1.3))
            view.setScaleY(jfloat(1.3))
            view.animate().scaleX(jfloat(1.0)).scaleY(jfloat(1.0)).setDuration(jlong(350)).start()
            if tier >= SHAKE_TIER:
                fx_shake(view, self._dp(4))
        except Exception:
            wlog_exc("panel pulse")
    def _track_actions(self):
        p = self.p
        _, meta = p._current_keys()
        if not meta:
            return
        liked = p.profile.is_liked(track_key(meta["a"], meta["t"]))
        buttons = [("Убрать" if liked else "Нравится", p.action_like)]
        if p.active:
            buttons += [("Не то", p.action_dislike), ("Скрыть", p.action_ban)]
        else:
            buttons.append(("По этому треку", p.action_track_wave))
        self._button_row(buttons)
    def _toggle(self):
        if self.p.active:
            self.p.stop_wave()
        else:
            self.p.start_wave()
    def _open_settings(self):
        self.close()
        self.p.open_settings()
    def _dp(self, value):
        from org.telegram.messenger import AndroidUtilities
        return AndroidUtilities.dp(float(value))
    def _color(self, key):
        from org.telegram.ui.ActionBar import Theme
        return Theme.getColor(getattr(Theme, key))
    def _click(self, fn):
        from android_utils import OnClickListener
        def handler(view):
            try:
                fn()
            except Exception:
                wlog_exc("panel click")
            if self.is_open():
                self.render()
        return OnClickListener(handler)
    def _params(self, width, weight=None, side=0, top=0, bottom=0):
        from android.widget import LinearLayout
        lp = (LinearLayout.LayoutParams(width, self.WRAP) if weight is None
              else LinearLayout.LayoutParams(width, self.WRAP, float(weight)))
        lp.setMargins(self._dp(side), self._dp(top), self._dp(side), self._dp(bottom))
        return lp
    def _add(self, view, side=16, top=0, bottom=0):
        self.root.addView(view, self._params(self.MATCH, side=side, top=top, bottom=bottom))
    def _text(self, text, size, color, bold=False, center=False):
        from android.view import Gravity
        from android.widget import TextView
        tv = TextView(self.act)
        tv.setText(text)
        tv.setTextSize(float(size))
        tv.setTextColor(self._color(color))
        if center:
            tv.setGravity(Gravity.CENTER)
        if bold:
            from org.telegram.messenger import AndroidUtilities
            tv.setTypeface(AndroidUtilities.bold())
        return tv
    def _rounded(self, color):
        from org.telegram.ui.ActionBar import Theme
        return Theme.createSimpleSelectorRoundRectDrawable(self._dp(10), self._color(color), self._color("key_listSelector"))
    def _pill(self, text, fn, active):
        tv = self._text(text, 14, "key_featuredStickers_buttonText" if active else "key_dialogTextBlack", center=True)
        tv.setBackground(self._rounded("key_featuredStickers_addButton" if active else "key_dialogBackgroundGray"))
        tv.setPadding(self._dp(6), self._dp(10), self._dp(6), self._dp(10))
        tv.setOnClickListener(self._click(fn))
        return tv
    def _button(self, text, fn, primary=False):
        self._add(self._pill(text, fn, primary), bottom=8)
    def _strip(self, per_row):
        from android.widget import LinearLayout
        row = LinearLayout(self.act)
        row.setOrientation(LinearLayout.HORIZONTAL)
        row.setWeightSum(float(per_row))
        self._add(row, side=12, bottom=4)
        return row
    def _button_row(self, buttons):
        row = self._strip(len(buttons))
        for text, fn in buttons:
            row.addView(self._pill(text, fn, False), self._params(0, weight=1.0, side=4))
    def _chips(self, names, selected, pick, per_row):
        row = None
        for i, name in enumerate(names):
            if i % per_row == 0:
                row = self._strip(per_row)
            row.addView(self._pill(name, lambda i=i: pick(i), i == selected), self._params(0, weight=1.0, side=4))
    def _header(self, text):
        self._add(self._text(text, 15, "key_windowBackgroundWhiteBlueHeader", bold=True), top=12, bottom=8)
    def _switch(self, text, key, default):
        from org.telegram.ui.ActionBar import Theme
        from org.telegram.ui.Cells import TextCheckCell
        cell = TextCheckCell(self.act)
        cell.setTextAndCheck(text, bool(self.p.get_setting(key, default)), False)
        cell.setBackground(Theme.getSelectorDrawable(False))
        def toggle():
            self.p.set_setting(key, not bool(self.p.get_setting(key, default)))
        cell.setOnClickListener(self._click(toggle))
        self._add(cell, side=0)
    def _row(self, text, fn):
        from org.telegram.ui.ActionBar import Theme
        tv = self._text(text, 16, "key_dialogTextBlack")
        tv.setBackground(Theme.getSelectorDrawable(False))
        tv.setPadding(self._dp(21), self._dp(14), self._dp(21), self._dp(14))
        tv.setOnClickListener(self._click(fn))
        self._add(tv, side=0, top=4, bottom=8)
class StreakBar:
    def __init__(self, plugin, sheet):
        from hook_utils import get_private_field
        self.field = get_private_field
        self.plugin, self.sheet = plugin, sheet
        self.context = sheet.getContext()
        self.root = get_private_field(sheet, "playerLayout")
        self.speed = get_private_field(sheet, "speedButton")
        self.lyrics = get_private_field(sheet, "lyricsButton")
        if self.root is None or self.speed is None or self.lyrics is None:
            raise RuntimeError("не найдены элементы плеера")
        self.closed = False
        self.box = self.title = self.track = self.fill = None
        self.shown = None
        self.palette = None
        self.level_token = 0
        self.breath = Breath(lambda: [self.track, self.title], lambda: not self.closed and self.wanted())
    def dp(self, value):
        return int(self.context.getResources().getDisplayMetrics().density * value + 0.5)
    def install(self):
        from android.view import Gravity, View
        from android.widget import FrameLayout, LinearLayout, TextView
        self.box = LinearLayout(self.context)
        self.box.setOrientation(LinearLayout.VERTICAL)
        self.box.setGravity(Gravity.CENTER)
        self.title = TextView(self.context)
        self.title.setTextSize(13.0)
        self.title.setGravity(Gravity.CENTER)
        self.title.setSingleLine(True)
        self.track = FrameLayout(self.context)
        self.fill = View(self.context)
        self.fill.setPivotX(jfloat(0.0))
        self.track.addView(self.fill, FrameLayout.LayoutParams(-1, -1))
        self.box.addView(self.title, LinearLayout.LayoutParams(-1, -2))
        params = LinearLayout.LayoutParams(-1, self.dp(3))
        params.topMargin = self.dp(4)
        self.box.addView(self.track, params)
        self.root.addView(self.box, FrameLayout.LayoutParams(self.dp(64), self.dp(48)))
        self.update(animate=False)
        self.style()
        self.root.requestLayout()
    def wanted(self):
        return bool(self.plugin.active) and bool(self.plugin.get_setting("show_streak", True))
    def layout(self):
        if self.closed or self.box is None or int(self.lyrics.getWidth()) <= 0:
            return
        from android.view import View
        top = int(self.lyrics.getTop())
        left = int(self.speed.getRight())
        lyrics_left = int(self.lyrics.getLeft())
        right = lyrics_left
        for i in range(int(self.root.getChildCount())):
            child = self.root.getChildAt(i)
            if child.equals(self.box) or int(child.getVisibility()) != 0 or int(child.getTop()) != top:
                continue
            if left <= int(child.getLeft()) < right:
                right = int(child.getLeft())
        left += self.dp(12)
        right -= self.dp(12)
        if right - left < self.dp(40):
            self.box.setVisibility(4)
            return
        exact = 1073741824
        height = self.dp(48)
        self.box.measure(View.MeasureSpec.makeMeasureSpec(right - left, exact), View.MeasureSpec.makeMeasureSpec(height, exact))
        self.box.layout(left, top, right, top + height)
    def style(self):
        if self.closed or self.box is None:
            return
        colors = self.field(self.sheet, "colors")
        if colors is not None:
            palette = (int(colors.text), int(colors.track), int(colors.accent))
            if palette != self.palette:
                self.palette = palette
                self.title.setTextColor(palette[0])
                self.track.setBackgroundColor(jint(palette[1]))
                self.fill.setBackgroundColor(jint(palette[2]))
        self.box.setVisibility(int(self.lyrics.getVisibility()) if self.wanted() else 4)
        self.box.setAlpha(jfloat(float(self.lyrics.getAlpha())))
    def update(self, animate=True):
        if self.closed or self.box is None:
            return
        n = self.plugin.profile.streak()[0]
        tier = streak_tier(n)
        low, name, _ = STREAK_TIERS[tier]
        progress = 1.0
        if tier + 1 < len(STREAK_TIERS):
            progress = (n - low) / float(STREAK_TIERS[tier + 1][0] - low)
        label = "%s %d" % (name, n)
        first = not animate or self.shown is None
        if first:
            self.title.setText(label)
            self.fill.setScaleX(jfloat(progress))
        elif tier > streak_tier(self.shown):
            self._level_up(label, progress)
        elif n != self.shown:
            self.title.setText(label)
            self.fill.animate().scaleX(jfloat(progress)).setDuration(jlong(350)).start()
            if n > self.shown:
                fx_growth(self.title, tier, self.dp)
        self.track.setScaleY(jfloat(TRACK_SCALE[tier]))
        self.shown = n
        if tier >= BREATH_TIER:
            self.breath.start()
        else:
            self.breath.stop()
        self.style()
    def _level_up(self, label, progress):
        self.level_token += 1
        token = self.level_token
        self.fill.animate().scaleX(jfloat(1.0)).setDuration(jlong(250)).start()
        def flash():
            if self.closed or self.box is None or token != self.level_token:
                return
            self.title.setText(label)
            self.title.setAlpha(jfloat(0.2))
            self.title.animate().alpha(jfloat(1.0)).setDuration(jlong(300)).start()
            self.fill.setScaleX(jfloat(0.0))
            self.fill.animate().scaleX(jfloat(progress)).setDuration(jlong(300)).start()
        ui(lambda: self.plugin._bar_safe(flash), 300)
    def close(self):
        self.closed = True
        if self.box is not None:
            self.root.removeView(self.box)
            self.box = None
class MyWavePlugin(BasePlugin):
    def on_plugin_load(self):
        self._shutdown_threads()
        _DEBUG["on"] = bool(self.get_setting("debug", False))
        _DEBUG["logger"] = getattr(self, "logger", None)
        self.data_dir = os.path.join(get_plugins_dir(), "my_wave_data")
        try:
            ensure_dir_exists(self.data_dir)
        except Exception:
            os.makedirs(self.data_dir, exist_ok=True)
        self.f_catalog = JsonFile(os.path.join(self.data_dir, "catalog.json"), {}).load()
        self.f_profile = JsonFile(os.path.join(self.data_dir, "profile.json"), {}).load()
        self.f_cache = JsonFile(os.path.join(self.data_dir, "cache.json"), {}).load()
        self.f_genres = JsonFile(os.path.join(self.data_dir, "genres.json"), {}).load()
        self.f_moods = JsonFile(os.path.join(self.data_dir, "moods.json"), {}).load()
        self.catalog = Catalog(self.f_catalog)
        self.profile = Profile(self.f_profile)
        self.lastfm = LastFm(self.get_setting)
        self.deezer = Deezer()
        self.yandex = Yandex()
        self.itunes = ITunes()
        self.sim = Similarity(self.f_cache, self.lastfm, self.deezer, lambda: bool(self.get_setting("use_deezer", True)))
        self.genres = TrackGenres(self.f_genres)
        self.moods = MoodBook(self.f_moods)
        self.engine = WaveEngine(self.catalog, self.profile, self.sim, self.get_setting, self.genres, self.moods)
        try:
            self.engine.migrate_profile()
        except Exception:
            wlog_exc("migrate")
        self.tg = TgApi()
        self.wave_q = TaskRunner("wave")
        self.index_q = TaskRunner("index")
        self.net_q = TaskRunner("net")
        self.genre_q = TaskRunner("genre")
        for runner in (self.wave_q, self.index_q, self.net_q, self.genre_q):
            runner.start()
        self.active = False
        self.timeline = []
        self.ptr = -1
        self.tentative = []
        self.wave_acc = 0
        self.play_when_ready = False
        self.tracks_in_session = 0
        self.cur = None
        self.cur_lock = threading.RLock()
        self._final_key = None
        self._last_music_ts = time.time()
        self.alerts = []
        self.hook_status = {}
        self.index_state = {}
        self.genre_progress = (0, 0)
        self.mood_wait = 150.0
        self._mood_retry_at = 0.0
        self._panel = None
        self._bar = None
        self._genre_retry_at = 0.0
        self._index_retry_at = 0.0
        self._refill_tries = 0
        self._wait_by_stop = False
        self._mode_gen = 0
        self._settings_ts = 0.0
        self._m3_last = None
        self._getmsg_retry_at = 0.0
        self._getmsg_status = "ещё не вызывался"
        self._install_hooks()
        self._install_menus()
        self._stop_ev = threading.Event()
        self._ticker = threading.Thread(target=self._tick_loop, name="MyWave-tick", daemon=True)
        self._ticker.start()
        wlog("загружен, треков в каталоге: %d, каналов: %d" % (len(self.catalog.items), len(self.catalog.channels)))
    def on_plugin_unload(self):
        try:
            self.active = False
            bar = getattr(self, "_bar", None)
            if bar is not None:
                self._bar = None
                ui(lambda: self._bar_safe(bar.close))
            self._shutdown_threads()
            self._flush()
        except Exception:
            wlog_exc("unload")
    def on_app_event(self, event_type):
        try:
            if AppEvent is None:
                return
            if event_type in (AppEvent.PAUSE, AppEvent.STOP):
                threading.Thread(target=self._flush, name="MyWave-flush", daemon=True).start()
            elif event_type == AppEvent.RESUME:
                if self.get_setting("lfm_pending_token", ""):
                    self.net_q.submit("lfm_session", self._lfm_finish_bg)
        except Exception:
            wlog_exc("app event")
    def _shutdown_threads(self):
        for name in ("_stop_ev",):
            ev = getattr(self, name, None)
            if ev is not None:
                ev.set()
        for r in ("wave_q", "index_q", "net_q", "genre_q"):
            runner = getattr(self, r, None)
            if runner is not None:
                runner.stop()
    def _flush(self):
        for f in (getattr(self, "f_catalog", None), getattr(self, "f_profile", None),
                  getattr(self, "f_cache", None), getattr(self, "f_genres", None), getattr(self, "f_moods", None)):
            if f is not None:
                f.save()
    def _tick_loop(self):
        n = 0
        while not self._stop_ev.wait(1.0):
            n += 1
            try:
                self._poll()
            except Exception:
                wlog_exc("poll")
            if n % 20 == 0:
                self._flush()
            if n == 15 or n % 120 == 0:
                self._genre_kick()
                self._index_kick()
                self._mood_refresh()
            if n % 300 == 0 and self.profile.jf.data.get("sq"):
                self.net_q.submit("scrobble", self._scrobble_flush_bg)
    def _install_hooks(self):
        st = self.hook_status
        mc_cls = java_class(MC_CLASS)
        mo_cls = java_class("org.telegram.messenger.MessageObject")
        if mc_cls is None:
            st["MediaController"] = "класс не найден"
            wlog("MediaController не найден — плагин не сможет управлять плеером")
            return
        try:
            m = mc_cls.getDeclaredMethod("playNextMessageWithoutOrder", Boolean.TYPE)
            m.setAccessible(True)
            self.hook_method(m, _NextHook(self))
            st["next"] = "ok"
        except Exception as e:
            st["next"] = "нет (%s) — режим плейлиста" % e
        try:
            m = mc_cls.getDeclaredMethod("playMessage", mo_cls, Boolean.TYPE)
            m.setAccessible(True)
            self.hook_method(m, _PlayHook(self))
            st["play"] = "ok"
        except Exception as e:
            st["play"] = "нет (%s) — опрос раз в секунду" % e
        alert_cls = java_class("org.telegram.ui.Components.AudioPlayerAlert")
        if alert_cls is not None:
            try:
                try:
                    self.hook_all_constructors(alert_cls, _AlertCtorHook(self))
                except Exception:
                    for ctor in alert_cls.getDeclaredConstructors():
                        self.hook_method(ctor, _AlertCtorHook(self))
                m = alert_cls.getDeclaredMethod("updateTitle", Boolean.TYPE)
                m.setAccessible(True)
                self.hook_method(m, _AlertTitleHook(self))
                m = alert_cls.getDeclaredMethod("onSubItemClick", Integer.TYPE)
                m.setAccessible(True)
                self.hook_method(m, _AlertClickHook(self))
                st["AudioPlayerAlert"] = "ok"
            except Exception as e:
                st["AudioPlayerAlert"] = "нет (%s)" % e
        else:
            st["AudioPlayerAlert"] = "класс не найден"
        st["M3-плеер"] = self._install_m3_hook()
        st["Серия в плеере"] = self._install_player_bar()
        wlog("хуки: " + ", ".join("%s=%s" % kv for kv in st.items()))
    def _install_m3_hook(self):
        if java_class(M3_CLASS) is None or java_class(ITEM_OPTIONS) is None:
            return "класс не найден — кнопки через боковое меню и плашку"
        try:
            m = java_class(ITEM_OPTIONS).getDeclaredMethod("show")
            m.setAccessible(True)
            self.hook_method(m, _M3MenuHook(self))
            return "ok"
        except Exception as e:
            return "нет (%s) — кнопки через боковое меню и плашку" % e
    def _install_player_bar(self):
        sheet = find_class(M3_CLASS)
        layout = find_class(M3_CLASS + "$PlayerLayout")
        if sheet is None or layout is None:
            return "класс не найден"
        try:
            from hook_utils import get_static_private_field
            self.hook_all_constructors(sheet, after=lambda p: ui(lambda: self._bar_attach(p.thisObject), 60))
            self.hook_all_methods(layout, "onLayout", after=self._bar_layout)
            self.hook_all_methods(layout, "layoutModeSegments", after=self._bar_layout)
            self.hook_all_methods(sheet, "applyTransitions", after=self._bar_style)
            self.hook_all_methods(layout, "onDetachedFromWindow", after=self._bar_detached)
            existing = get_static_private_field(sheet, "instance")
            if existing is not None:
                ui(lambda: self._bar_attach(existing))
            return "ok"
        except Exception as e:
            wlog_exc("player bar")
            return "нет (%s)" % e
    def _bar_attach(self, sheet):
        bar = None
        try:
            if sheet.isDismissed():
                return
            if self._bar is not None and not self._bar.closed and self._bar.sheet.equals(sheet):
                return
            if self._bar is not None:
                self._bar.close()
            bar = StreakBar(self, sheet)
            self._bar = bar
            bar.install()
        except Exception:
            wlog_exc("player bar attach")
            self._bar = None
            if bar is not None:
                self._bar_safe(bar.close)
    def _bar_safe(self, fn):
        try:
            fn()
        except Exception:
            wlog_exc("player bar")
    def _bar_layout(self, param):
        bar = self._bar
        if bar is not None and bar.root.equals(param.thisObject):
            self._bar_safe(bar.layout)
    def _bar_style(self, param):
        bar = self._bar
        if bar is not None and bar.sheet.equals(param.thisObject):
            self._bar_safe(bar.style)
    def _bar_detached(self, param):
        bar = self._bar
        if bar is not None and bar.root.equals(param.thisObject) and bar.sheet.isDismissed():
            self._bar = None
            self._bar_safe(bar.close)
    def _install_menus(self):
        try:
            self.add_menu_item(MenuItemData(
                menu_type=MenuItemType.DRAWER_MENU,
                text="Моя волна",
                on_click=lambda ctx: ui(self.ui_wave_panel),
                icon="msg_filled_data_music",
                item_id="my_wave_drawer",
                priority=50,
            ))
        except Exception:
            wlog_exc("drawer menu")
        try:
            self.add_menu_item(MenuItemData(
                menu_type=MenuItemType.CHAT_ACTION_MENU,
                text="Моя волна: источник",
                subtext="Добавить / убрать канал",
                on_click=lambda ctx: ui(lambda: self.ui_toggle_channel_from_ctx(ctx)),
                icon="msg_channel",
                item_id="my_wave_channel",
                priority=10,
            ))
        except Exception:
            wlog_exc("chat menu")
    def _playing(self):
        try:
            mo = MediaController.getInstance().getPlayingMessageObject()
            if mo is not None and mo.isMusic():
                return mo
        except Exception:
            pass
        return None
    def _is_wave_key(self, key):
        if not key:
            return False
        return any(it.pk == key for it in self.timeline) or any(it.pk == key for it in self.tentative)
    def _start_play_record(self, mo, in_wave):
        meta = mo_meta(mo) or {"a": "", "t": "", "d": 0}
        try:
            acc = int(mo.currentAccount)
        except Exception:
            acc = UserConfig.selectedAccount
        p = Play(mo_key(mo), meta.get("a"), meta.get("t"), meta.get("d"), in_wave, acc)
        with self.cur_lock:
            self.cur = p
            self._final_key = None
        if self._should_scrobble(p) and p.d >= 30 and p.t:
            self.net_q.submit("np", lambda: self._now_playing_bg(p))
    def _finalize(self, reason, progress=None, explicit=None):
        with self.cur_lock:
            p = self.cur
            self.cur = None
            if p is not None:
                self._final_key = p.key
        if p is None:
            return None
        if progress is not None:
            p.prog = max(p.prog, float(progress))
        outcome = explicit or classify_outcome(reason, p.prog, p.listened, self.engine.skip_threshold())
        if outcome == "none" and p.listened >= 10:
            outcome = "seen"
        learn = explicit is not None or p.in_wave or bool(self.get_setting("learn_all", True))
        if learn:
            self.profile.add_time(p.ak, p.a, p.listened)
        if p.in_wave:
            self._streak_after(outcome)
        if p.tk and p.t and learn and outcome != "none":
            self.profile.record(p.tk, p.ak, p.a, p.t, outcome)
            changed = self.engine.on_feedback(p.tk, p.ak, outcome, p.in_wave and self.active)
            if changed:
                toast_info("Меняю направление волны")
                self._invalidate_tentative()
        wlog("итог: %s — %s → %s (%.0f%%, %ds)" % (p.a, p.t, outcome, p.prog * 100, p.listened), debug=True)
        return outcome
    def _poll(self):
        mc = MediaController.getInstance()
        mo = mc.getPlayingMessageObject()
        now = time.time()
        with self.cur_lock:
            p = self.cur
        if mo is None:
            if p is not None and now - p.last_seen > 3:
                self._finalize("stop")
            if self.active and now - self._last_music_ts > 5:
                wlog("плеер закрыт — волна остановлена", debug=True)
                ui(lambda: self.stop_wave(silent=True))
            return
        self._last_music_ts = now
        if not mo.isMusic():
            return
        key = mo_key(mo)
        if p is None or p.key != key:
            if p is None and key == self._final_key:
                return
            ui(lambda: self.on_play_started(mo))
            return
        dt = min(2.0, now - p.last_seen)
        p.last_seen = now
        if not mc.isMessagePaused():
            p.listened += dt
        try:
            p.prog = max(p.prog, float(mo.audioProgress))
        except Exception:
            pass
        if not p.scrobbled and p.d >= 30 and p.t and self._should_scrobble(p):
            if p.listened >= min(p.d * 0.5, 240):
                p.scrobbled = True
                with self.profile.jf.lock:
                    sq = self.profile.jf.data["sq"]
                    sq.append([p.a or "Unknown", p.t, int(p.start), p.d])
                    del sq[:-500]
                    self.profile.jf.touch()
                self.net_q.submit("scrobble", self._scrobble_flush_bg)
    def on_next(self, by_stop):
        mo = self._playing()
        if mo is not None:
            if not (by_stop and SharedConfig.repeatMode == 2):
                try:
                    prog = float(mo.audioProgress)
                except Exception:
                    prog = None
                self._finalize("end" if by_stop else "next", prog)
        if not self.active or mo is None or not self._is_wave_key(mo_key(mo)):
            return False
        if by_stop and SharedConfig.repeatMode == 2:
            return False
        item = self._next_item(by_stop)
        if item is None:
            self.play_when_ready = True
            self._refill_tries = 0
            self._wait_by_stop = by_stop
            self.wave_q.submit("refill", self._refill_bg)
            toast_info("Подбираю следующий трек…")
            return True
        self._play_item(item)
        return True
    def on_play_started(self, mo):
        if mo is None:
            return
        try:
            if not mo.isMusic():
                return
        except Exception:
            return
        key = mo_key(mo)
        with self.cur_lock:
            same = self.cur is not None and self.cur.key == key
        if same:
            return
        if self.cur is not None:
            self._finalize("other" if self.hook_status.get("next") == "ok" else "next")
        in_wave = False
        if self.active:
            idx = self._timeline_index(key)
            if idx >= 0:
                self.ptr = idx
                in_wave = True
            else:
                j = next((i for i, it in enumerate(self.tentative) if it.pk == key), -1)
                if j >= 0:
                    item = self.tentative.pop(j)
                    self.timeline = self.timeline[: self.ptr + 1] + [item]
                    self.ptr = len(self.timeline) - 1
                    in_wave = True
                else:
                    self.active = False
                    self.tentative = []
                    toast_info("Волна остановлена — играет другая музыка")
        self._start_play_record(mo, in_wave)
        if in_wave:
            it = self.timeline[self.ptr]
            self.engine.on_track_started(it.tk, it.ak)
            self.tracks_in_session += 1
            self._sync_playlist()
            self.wave_q.submit("refill", self._refill_bg)
            if self.tracks_in_session % 8 == 0:
                self.net_q.submit("enrich", self._enrich_bg)
            if self.get_setting("track_bulletin", self._bulletin_default()):
                self._track_bulletin(mo)
        for a in list(self.alerts):
            try:
                self.alert_refresh(a)
            except Exception:
                pass
        self._panel_refresh()
    def _ready(self, pk):
        return self.catalog.has_msg(pk)
    def _used_items(self):
        if self.engine.repeating:
            has_cur = 0 <= self.ptr < len(self.timeline) and self.engine.eligible_count > 1
            return ([self.timeline[self.ptr]] if has_cur else []) + list(self.tentative)
        return list(self.timeline) + list(self.tentative)
    def _used_pks(self):
        return {it.pk for it in self._used_items()}
    def _used_tks(self):
        return {it.tk for it in self._used_items()}
    def _timeline_index(self, key):
        if 0 <= self.ptr < len(self.timeline) and self.timeline[self.ptr].pk == key:
            return self.ptr
        for i in range(len(self.timeline) - 1, -1, -1):
            if self.timeline[i].pk == key:
                return i
        return -1
    def _still_wanted(self, it):
        if (it.ak and self.profile.is_banned(it.ak)) or self.profile.is_disliked(it.tk):
            return False
        return self.engine.repeating or it.tk not in self.engine.session_played
    def _make_item(self, pk):
        tr = self.catalog.items.get(pk)
        msg = self.catalog.get_msg(pk)
        if tr is None or msg is None:
            return None
        ch = self.catalog.channel(tr.cid) or {}
        acc = int(ch.get("acc", self.wave_acc))
        mo = MessageObject(acc, msg, False, True)
        return WaveItem(pk, tr.tk, tr.ak, mo, acc)
    def _next_item(self, by_stop):
        if self.ptr < len(self.timeline) - 1:
            return self.timeline[self.ptr + 1]
        if by_stop:
            while self.tentative:
                it = self.tentative.pop(0)
                if self._still_wanted(it):
                    return it
        pk = self.engine.pick(self._ready, self._used_pks(), ready_only=True, exclude_tks=self._used_tks())
        if pk is not None:
            item = self._make_item(pk)
            if item is not None:
                self.tentative = []
                return item
        if self.tentative:
            return self.tentative.pop(0)
        return None
    def _invalidate_tentative(self):
        def _do():
            self.tentative = []
            self.wave_q.submit("refill", self._refill_bg)
        ui(_do)
    def _play_item(self, item):
        mc = MediaController.getInstance()
        if item in self.timeline:
            self.ptr = self.timeline.index(item)
        else:
            self.timeline = self.timeline[: self.ptr + 1] + [item]
            self.ptr = len(self.timeline) - 1
        if len(self.timeline) > HISTORY_KEEP + 10:
            cut = len(self.timeline) - HISTORY_KEEP
            self.timeline = self.timeline[cut:]
            self.ptr -= cut
        cur = mc.getPlayingMessageObject()
        if cur is not None:
            try:
                cur.resetPlayingProgress()
            except Exception:
                pass
        try:
            mc_set_bool("playMusicAgain", True)
        except Exception:
            pass
        self._sync_playlist()
        mc.playMessage(item.mo)
    def _next_direction(self):
        try:
            return int(MediaController.getInstance().getNextTrackDirection())
        except Exception:
            return 1 if SharedConfig.playOrderReversed and not SharedConfig.shuffleMusic else -1
    def _sync_playlist(self):
        if not self.active or not self.timeline:
            return
        try:
            forward = self.timeline[max(0, self.ptr - HISTORY_KEEP):] + self.tentative
            cur_index = forward.index(self.timeline[self.ptr])
            reversed_order = self._next_direction() > 0
            items = forward if reversed_order else forward[::-1]
            idx = cur_index if reversed_order else len(forward) - 1 - cur_index
            pl = mc_get("playlist")
            pmap = mc_get("playlistMap")
            pl.clear()
            pmap.clear()
            for it in items:
                pl.add(it.mo)
                pmap.put(Integer(int(it.mo.getId())), it.mo)
            try:
                sh = mc_get("shuffledPlaylist")
                sh.clear()
                sh.addAll(pl)
            except Exception:
                pass
            mc_set_int("currentPlaylistNum", idx)
            try:
                NotificationCenter.getInstance(self.wave_acc).postNotificationName(NotificationCenter.moreMusicDidLoad, Integer(0))
            except Exception:
                pass
            self.hook_status["playlist"] = "ok"
        except Exception as e:
            self.hook_status["playlist"] = "ошибка: %s" % e
            wlog_exc("sync playlist")
    def start_wave(self, seed_mo=None):
        if not self.catalog.channels:
            toast_err("Сначала добавьте каналы-источники")
            self.open_settings()
            return
        if self.wave_q.busy("start"):
            toast_info("Волна уже настраивается…")
            return
        seed_ak = seed_tk = None
        if seed_mo is not None:
            meta = mo_meta(seed_mo)
            if meta:
                seed_ak = artist_key(meta.get("a"))
                seed_tk = track_key(meta.get("a"), meta.get("t"))
                self.net_q.submit("seed_sim", lambda: self._safe_net(lambda: self.sim.fetch_similar(meta.get("a"))))
        toast_info("Настраиваю волну…")
        self.wave_q.submit("start", lambda: self._start_bg(seed_ak, seed_tk))
    def stop_wave(self, silent=False):
        self.active = False
        self.play_when_ready = False
        self.tentative = []
        self.timeline = []
        self.ptr = -1
        if not silent:
            toast_info("Волна остановлена")
        self._panel_refresh()
    def _refresh_stale_channels(self):
        stale = [ch for ch in list(self.catalog.channels.values()) if time.time() - ch.get("ts", 0) > 6 * 3600]
        if not stale:
            return
        def bg():
            for ch in stale:
                self._index_channel(ch, quick=bool(ch.get("ts")) and not self._needs_deep(ch))
            self.catalog.rebuild()
            self._genre_kick()
        self.index_q.submit("refresh", bg)
    def _index_depth(self):
        try:
            return INDEX_DEPTHS[int(self.get_setting("index_depth", DEFAULT_DEPTH))]
        except Exception:
            return INDEX_DEPTHS[DEFAULT_DEPTH]
    def _needs_deep(self, ch):
        depth = self._index_depth()
        if depth > int(ch.get("depth_seen", 0)):
            return True
        return not ch.get("end") and self.catalog.channel_count(int(ch["id"])) < depth
    def _index_kick(self):
        if time.time() < self._index_retry_at:
            return
        todo = [ch for ch in list(self.catalog.channels.values()) if self._needs_deep(ch)]
        if not todo:
            return
        def bg():
            for ch in todo:
                self._index_channel(ch, quick=False)
            self.catalog.rebuild()
            if any(ch.get("err") for ch in todo):
                self._index_retry_at = time.time() + 600
            self._refresh_settings()
            self._genre_kick()
        self.index_q.submit("deep", bg)
    def _on_depth_changed(self, *args):
        self._index_retry_at = 0.0
        self._index_kick()
    def _mood_kick(self):
        if (self.moods.ready() and not self.moods.stale()) or time.time() < self._mood_retry_at:
            return
        self.net_q.submit("moods", self._moods_bg)
    def _mood_refresh(self):
        if self.engine.mood() is not None:
            self._mood_kick()
    def _moods_bg(self):
        use_deezer = bool(self.get_setting("use_deezer", True))
        by_mood = []
        try:
            for _, y_tags, dz_queries, _ in MOODS:
                rows = []
                for tag in y_tags:
                    rows += self.yandex.mood_tracks(tag)
                for query in dz_queries if use_deezer else ():
                    try:
                        rows += self.deezer.mood_tracks(query)
                    except NetError:
                        pass
                by_mood.append(rows)
        except NetError as e:
            self._mood_retry_at = time.time() + 600
            wlog("настроения: пауза 10 минут (%s)" % e)
            return
        if min(len(rows) for rows in by_mood) < MOOD_MIN_TRACKS:
            self._mood_retry_at = time.time() + 600
            wlog("настроения: площадки вернули слишком мало треков")
            return
        self.moods.replace(by_mood)
        wlog("настроения загружены: " + ", ".join("%s %d" % (m[0], c) for m, c in zip(MOODS, self.moods.counts(), strict=True)))
        self._panel_refresh()
    def _wait_moods(self):
        self._mood_kick()
        if self.mood_wait > 0:
            toast_info("Загружаю настроения, это около двух минут…")
        deadline = time.time() + self.mood_wait
        while time.time() < deadline and self.net_q.busy("moods"):
            time.sleep(1.0)
        return self.engine.recompute()
    def _recompute_for_mood(self):
        mood = self.engine.mood()
        if mood is None:
            return self.engine.recompute()
        self._mood_kick()
        return self._wait_moods() if not self.moods.ready() else self.engine.recompute()
    def _no_mood_text(self, mood):
        if not self.moods.ready():
            return "Не удалось загрузить настроения — проверьте соединение"
        return "Нет треков с настроением «%s» — выберите другое" % MOODS[mood][0]
    def _start_bg(self, seed_ak, seed_tk=None):
        self.wave_acc = UserConfig.selectedAccount
        self._refresh_stale_channels()
        if not self.catalog.items:
            indexing = bool(self.index_state) or self.index_q.busy("refresh")
            toast_err("Каналы ещё индексируются — попробуйте через минуту" if indexing else "В каналах-источниках не нашлось музыки")
            return
        self.engine.new_session(seed_ak, seed_tk)
        cnt = self._recompute_for_mood()
        mood = self.engine.mood()
        if mood is not None and cnt == 0:
            toast_err(self._no_mood_text(mood))
            return
        self._prefetch()
        pks = self.engine.pick_many(TENTATIVE, self._ready, ready_only=True)
        items = [it for it in (self._make_item(pk) for pk in pks) if it is not None]
        if not items:
            toast_err("Telegram не отдал треки — проверьте соединение и запустите ещё раз")
            return
        ui(lambda: self._begin(items))
        self.net_q.submit("enrich", self._enrich_bg)
        self._genre_kick()
    def _begin(self, items):
        mc = MediaController.getInstance()
        self._last_music_ts = time.time()
        self.active = True
        self.timeline = [items[0]]
        self.ptr = 0
        self.tentative = items[1:]
        self.tracks_in_session = 0
        self.play_when_ready = False
        lst = ArrayList()
        for it in items:
            lst.add(it.mo)
        try:
            mc.setPlaylist(lst, items[0].mo, 0, False, None)
        except Exception:
            wlog_exc("setPlaylist(5)")
            mc.setPlaylist(lst, items[0].mo, 0)
        try:
            mc_set_bool("forceLoopCurrentPlaylist", False)
        except Exception:
            pass
        self._sync_playlist()
        mode = CHARACTERS[self.engine.character()] if self.engine.warm() else "Знакомство"
        mood = self.engine.mood()
        if mood is not None:
            mode += " · " + MOODS[mood][0]
        toast_ok("Моя волна: " + mode)
        self._panel_refresh()
    def _safe_net(self, fn):
        try:
            return fn()
        except NetError as e:
            wlog(str(e), debug=True)
            return None
        except Exception:
            wlog_exc("net")
            return None
    def _refill_bg(self):
        if not self.active:
            return
        self.engine.recompute()
        self._prefetch()
        need = TENTATIVE - len(self.tentative)
        new_items = []
        if need > 0:
            for pk in self.engine.pick_many(need, self._ready, self._used_pks(), ready_only=True, exclude_tks=self._used_tks()):
                it = self._make_item(pk)
                if it is not None:
                    new_items.append(it)
        def _apply():
            if not self.active:
                return
            pks, tks = self._used_pks(), self._used_tks()
            for it in new_items:
                if it.pk in pks or it.tk in tks or len(self.tentative) >= TENTATIVE:
                    continue
                self.tentative.append(it)
                pks.add(it.pk)
                tks.add(it.tk)
            if not self.play_when_ready:
                self._sync_playlist()
            elif self.tentative:
                self.play_when_ready = False
                self._play_item(self.tentative.pop(0))
            else:
                self._refill_empty()
        ui(_apply)
    def _refill_empty(self):
        self._refill_tries += 1
        nothing = self.engine.eligible_count == 0
        if nothing or self._refill_tries >= 3:
            self._end_wave(nothing)
            return
        ui(lambda: self.wave_q.submit("refill", self._refill_bg), 2000)
    def _end_wave(self, nothing):
        ended = self._wait_by_stop
        mood = self.engine.mood()
        self.stop_wave(silent=True)
        if nothing and mood is not None:
            toast_info("Треки с настроением «%s» закончились — волна остановлена" % MOODS[mood][0])
        elif nothing:
            toast_info("Подходящие треки закончились — волна остановлена")
        else:
            toast_err("Не удалось загрузить следующий трек — волна остановлена")
        if ended:
            try:
                MediaController.getInstance().cleanupPlayer(True, True)
            except Exception:
                wlog_exc("cleanup")
    def _prefetch(self):
        pks = [pk for pk in self.engine.prefetch_candidates(45, self._used_pks()) if not self.catalog.has_msg(pk)]
        by_cid = {}
        for pk in pks:
            cid, mid = pk.split(":")
            by_cid.setdefault(int(cid), []).append(int(mid))
        for cid, mids in by_cid.items():
            ch = self.catalog.channel(cid)
            if not ch:
                continue
            acc = int(ch.get("acc", 0))
            try:
                chat = self.tg.get_chat(acc, ch)
                if chat is None:
                    continue
                if not self._prefetch_direct(cid, acc, chat, mids):
                    self._prefetch_by_search(cid, acc, chat, mids)
            except TgError as e:
                wlog("prefetch %s: %s" % (ch.get("title"), e.text))
            except Exception:
                wlog_exc("prefetch")
    def _prefetch_direct(self, cid, acc, chat, mids):
        if time.time() < self._getmsg_retry_at:
            return False
        try:
            msgs = self.tg.get_messages(acc, chat, mids)
        except TgError as e:
            self._getmsg_fail(e.text)
            return False
        got = set()
        for msg in msgs:
            if extract_meta(msg) is not None:
                got.add(int(msg.id))
                self.catalog.remember("%d:%d" % (cid, int(msg.id)), msg)
        if not got:
            self._getmsg_fail("пустой ответ")
            return False
        for mid in mids:
            if mid not in got:
                self.catalog.remove_entry("%d:%d" % (cid, mid))
        self._getmsg_status = "ok"
        return True
    def _getmsg_fail(self, why):
        self._getmsg_status = "сбой (%s), загрузка через поиск" % why
        self._getmsg_retry_at = time.time() + 600
        wlog("getMessages: %s — загружаю через поиск" % why)
    def _prefetch_by_search(self, cid, acc, chat, mids, pages=4):
        peer = self.tg.input_peer(chat)
        left = sorted(set(mids), reverse=True)
        for _ in range(pages):
            if not left:
                break
            msgs, _count = self.tg.search_music(acc, peer, offset_id=left[0] + 1)
            ids = []
            for msg in msgs:
                if extract_meta(msg) is not None:
                    ids.append(int(msg.id))
                    self.catalog.remember("%d:%d" % (cid, int(msg.id)), msg)
            if not ids:
                break
            lowest = min(ids)
            left = [m for m in left if m < lowest]
    def _index_channel(self, ch, quick=False):
        acc = int(ch.get("acc", 0))
        cid = int(ch["id"])
        depth = self._index_depth()
        state = {"total": 0, "pages": 0}
        self.index_state[cid] = state
        try:
            chat = self.tg.get_chat(acc, ch)
            if chat is None:
                ch["err"] = "канал недоступен"
                self.catalog.jf.touch()
                return 0
            peer = self.tg.input_peer(chat)
            total_new = 0
            def consume(msgs, count):
                state["total"] = max(state["total"], int(count or 0))
                entries = []
                for msg in msgs:
                    meta = extract_meta(msg)
                    if meta is None:
                        continue
                    mid = int(msg.id)
                    entries.append((mid, meta))
                    self.catalog.remember("%d:%d" % (cid, mid), msg)
                added = self.catalog.add_entries(cid, entries)
                state["pages"] += 1
                if state["pages"] == 3 or state["pages"] % 20 == 0:
                    self.catalog.rebuild()
                self._refresh_settings(throttle=True)
                return added
            if ch.get("max_id"):
                offset = 0
                for _ in range(20):
                    msgs, count = self.tg.search_music(acc, peer, offset_id=offset, min_id=int(ch["max_id"]))
                    if not msgs:
                        break
                    total_new += consume(msgs, count)
                    ids = [int(m.id) for m in msgs]
                    ch["max_id"] = max(int(ch.get("max_id", 0)), max(ids))
                    offset = min(ids)
                    if len(msgs) < 100:
                        break
                    time.sleep(0.1)
            if not quick or not ch.get("max_id"):
                if depth > int(ch.get("depth_seen", 0)):
                    ch["depth_seen"] = depth
                    ch["end"] = False
                while not ch.get("end") and self.catalog.channel_count(cid) < depth and not self._stop_ev.is_set():
                    before = int(ch.get("min_id") or 0)
                    msgs, count = self.tg.search_music(acc, peer, offset_id=before)
                    if not msgs:
                        ch["end"] = True
                        break
                    total_new += consume(msgs, count)
                    ids = [int(m.id) for m in msgs]
                    ch["max_id"] = max(int(ch.get("max_id", 0)), max(ids))
                    lowest = min(ids)
                    if before and lowest >= before:
                        ch["end"] = True
                    ch["min_id"] = min(before, lowest) if before else lowest
                    time.sleep(0.1)
            ch["ts"] = int(time.time())
            ch.pop("err", None)
            self.catalog.jf.touch()
            wlog("индекс %s: +%d, всего %d" % (ch.get("title"), total_new, self.catalog.channel_count(cid)))
            return total_new
        except TgError as e:
            ch["err"] = e.text
            self.catalog.jf.touch()
            wlog("индекс %s: ошибка %s" % (ch.get("title"), e.text))
            return 0
        except Exception:
            ch["err"] = "сбой индексации"
            wlog_exc("index")
            return 0
        finally:
            self.index_state.pop(cid, None)
    def _warm_similar(self, limit=10):
        if not self.sim.source():
            return
        names = [name for ak, _, name in self.profile.top_artists(30, 0.2) if not self.sim.has_similar(ak)][:limit]
        for name in names:
            self._safe_net(lambda n=name: self.sim.fetch_similar(n))
    def _enrich_top_candidates(self, limit=15):
        if not self.sim.lfm_ok():
            return
        seen = set()
        for _, pk in self.engine.base_rank[:200]:
            tr = self.catalog.items.get(pk)
            if not tr or not tr.ak or tr.ak in seen or self.sim.has_info(tr.ak):
                continue
            seen.add(tr.ak)
            name = primary_artist(tr.a)
            self._safe_net(lambda n=name: self.sim.fetch_info(n))
            if len(seen) >= limit:
                break
    def _enrich_bg(self):
        if not self.sim.source():
            return
        self._warm_similar(limit=5)
        names = {}
        for tr in list(self.catalog.items.values()):
            if tr.ak and tr.ak not in names:
                names[tr.ak] = primary_artist(tr.a)
        with self.engine.lock:
            hot = sorted(((v, ak) for ak, v in self.engine.session.items() if v > 0.5), reverse=True)[:4]
        for _, ak in hot:
            if ak in names and not self.sim.has_similar(ak):
                self._safe_net(lambda n=names[ak]: self.sim.fetch_similar(n))
        if self.engine.effective_character() in (3, COLD_CHARACTER):
            self._enrich_top_candidates(15)
    def _genre_kick(self):
        if self.get_setting("track_genres", True) and self.catalog.items:
            self.genre_q.submit("genres", self._genres_bg)
    def _tag_track(self, tr):
        labels, year = self.yandex.track_info(tr.a, tr.t)
        if not labels and tr.ak and not self.genres.has_artist(tr.ak):
            self.genres.put_artist(tr.ak, self.yandex.artist_labels(tr.a))
        if not labels and not self.genres.artist_known(tr.ak):
            try:
                labels = self.itunes.track_labels(tr.a, tr.t)
            except NetError:
                labels = []
        self.genres.put(tr.tk, labels, year)
    def _genres_bg(self):
        if time.time() < self._genre_retry_at:
            return
        fails = 0
        while not self._stop_ev.is_set():
            batch, done, total = self.genres.pending(list(self.catalog.items.values()))
            self.genre_progress = (done, total)
            if not batch:
                return
            for tr in batch:
                if self._stop_ev.is_set():
                    return
                try:
                    self._tag_track(tr)
                except NetError as e:
                    fails += 1
                    if fails >= 5:
                        self._genre_retry_at = time.time() + 300
                        wlog("жанры: пауза 5 минут (%s)" % e)
                        return
                    continue
                fails = 0
                done += 1
                self.genre_progress = (done, total)
    def _should_scrobble(self, p):
        if not self.get_setting("scrobble", True) or not self.lastfm.can_scrobble():
            return False
        if int(self.get_setting("scrobble_scope", 0)) == 1 and not p.in_wave:
            return False
        return True
    def _now_playing_bg(self, p):
        try:
            self.lastfm.now_playing(p.a or "Unknown", p.t, p.d)
        except LastFmError as e:
            self._lfm_error(e)
        except Exception:
            wlog_exc("now playing")
    def _scrobble_flush_bg(self):
        if not self.lastfm.can_scrobble():
            return
        with self.profile.jf.lock:
            batch = list(self.profile.jf.data["sq"][:50])
        if not batch:
            return
        try:
            self.lastfm.scrobble(batch)
            with self.profile.jf.lock:
                del self.profile.jf.data["sq"][: len(batch)]
                self.profile.jf.touch()
            wlog("скробблов отправлено: %d" % len(batch), debug=True)
        except LastFmError as e:
            self._lfm_error(e)
        except Exception:
            wlog_exc("scrobble")
    def _lfm_error(self, e):
        wlog(str(e))
        if e.code == 9:
            self.set_setting("lfm_session", "")
            toast_err("Last.fm: сессия истекла, войдите заново")
    def lfm_login(self, *args):
        if not self.lastfm.key or not self.lastfm.secret:
            toast_err("Сначала введите API key и Shared secret Last.fm")
            return
        def bg():
            try:
                token = self.lastfm.get_token()
            except Exception as e:
                toast_err("Last.fm: %s" % e)
                return
            self.set_setting("lfm_pending_token", token)
            self.set_setting("lfm_token_ts", int(time.time()))
            url = "https://www.last.fm/api/auth/?api_key=%s&token=%s" % (self.lastfm.key, token)
            ui(lambda: self._open_url(url))
            toast_info("Разрешите доступ в браузере и вернитесь в Telegram")
        self.net_q.submit("lfm_token", bg)
    def lfm_finish(self, *args):
        self.net_q.submit("lfm_session", self._lfm_finish_bg)
    def _lfm_finish_bg(self):
        token = self.get_setting("lfm_pending_token", "")
        if not token:
            return
        if time.time() - int(self.get_setting("lfm_token_ts", 0) or 0) > 3600:
            self.set_setting("lfm_pending_token", "")
            return
        try:
            key, name = self.lastfm.get_session(token)
        except LastFmError as e:
            if e.code == 14:
                return
            toast_err(str(e))
            return
        except Exception:
            wlog_exc("lfm session")
            return
        if key:
            self.set_setting("lfm_session", key)
            self.set_setting("lfm_user", name or "")
            self.set_setting("lfm_pending_token", "")
            self._refresh_settings()
            toast_ok("Last.fm: вошли как %s" % (name or "?"))
    def lfm_logout(self, *args):
        self.set_setting("lfm_session", "")
        self.set_setting("lfm_user", "")
        self._refresh_settings()
        toast_info("Вы вышли из Last.fm")
    def _open_url(self, url):
        from android.content import Intent
        from android.net import Uri
        intent = Intent(Intent.ACTION_VIEW, Uri.parse(url))
        intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
        ApplicationLoader.applicationContext.startActivity(intent)
    def _current_keys(self):
        mo = self._playing()
        if mo is None:
            return None, None
        meta = mo_meta(mo)
        if not meta:
            return mo, None
        return mo, meta
    def action_like(self):
        mo, meta = self._current_keys()
        if not meta:
            toast_err("Сейчас не играет музыка")
            return
        tk, ak = track_key(meta["a"], meta["t"]), artist_key(meta["a"])
        if self.profile.is_liked(tk):
            self.profile.record(tk, ak, meta["a"], meta["t"], "unlike")
            self.engine.on_feedback(tk, ak, "unlike", False)
            toast_info("Убрано из «Нравится»")
            return
        self.profile.record(tk, ak, meta["a"], meta["t"], "like")
        self.engine.on_feedback(tk, ak, "like", self.active and self._is_wave_key(mo_key(mo)))
        toast_ok("Нравится: %s" % meta["t"])
        if ak and not self.sim.has_similar(ak):
            self.net_q.submit("sim_" + ak, lambda: self._safe_net(lambda: self.sim.fetch_similar(meta["a"])))
        if self.active:
            self._invalidate_tentative()
    def action_dislike(self):
        mo, meta = self._current_keys()
        if not meta:
            toast_err("Сейчас не играет музыка")
            return
        self._record_explicit(mo, meta, "dislike")
        toast_info("Больше не поставлю этот трек")
        MediaController.getInstance().playNextMessage()
    def _record_explicit(self, mo, meta, outcome):
        key = mo_key(mo)
        with self.cur_lock:
            p = self.cur
        if p is not None and p.key == key:
            self._finalize("dislike", explicit=outcome)
            return
        tk, ak = track_key(meta["a"], meta["t"]), artist_key(meta["a"])
        self.profile.record(tk, ak, meta["a"], meta["t"], outcome)
        in_wave = self.active and self._is_wave_key(key)
        self.engine.on_feedback(tk, ak, outcome, in_wave)
        if in_wave:
            self._streak_after(outcome)
    def _streak_after(self, outcome):
        before = self.profile.streak()[0]
        after = self.profile.streak_update(outcome)
        tier = streak_tier(after)
        if tier > streak_tier(before) and self.get_setting("show_streak", True):
            toast_ok("Серия %d: %s" % (after, STREAK_TIERS[tier][1]))
    def action_ban(self):
        mo, meta = self._current_keys()
        if not meta or not meta.get("a"):
            toast_err("Не удалось определить исполнителя")
            return
        ak = artist_key(meta["a"])
        self.profile.ban(ak, primary_artist(meta["a"]))
        self._record_explicit(mo, meta, "dislike")
        toast_info("%s скрыт(а) из волны" % primary_artist(meta["a"]))
        MediaController.getInstance().playNextMessage()
    def action_track_wave(self):
        mo = self._playing()
        if mo is None:
            toast_err("Сейчас не играет музыка")
            return
        self.start_wave(seed_mo=mo)
    def alert_attach(self, alert):
        opts = self._alert_options(alert)
        if opts is None:
            return
        opts.addSubItem(ALERT_LIKE, icon_id("msg_fave"), "Нравится")
        opts.addSubItem(ALERT_DISLIKE, icon_id("msg_block"), "Не нравится")
        opts.addSubItem(ALERT_BAN, icon_id("msg_cancel"), "Не предлагать исполнителя")
        opts.addSubItem(ALERT_PANEL, icon_id("msg_filled_data_music"), "Моя волна")
        if alert not in self.alerts:
            self.alerts.append(alert)
            del self.alerts[:-3]
        self.alert_refresh(alert)
    def _alert_options(self, alert):
        try:
            f = java_class("org.telegram.ui.Components.AudioPlayerAlert").getDeclaredField("optionsButton")
            f.setAccessible(True)
            return f.get(alert)
        except Exception:
            return None
    def alert_refresh(self, alert):
        opts = self._alert_options(alert)
        if opts is None:
            return
        music = self._playing() is not None
        try:
            opts.setSubItemShown(ALERT_LIKE, music)
            opts.setSubItemShown(ALERT_DISLIKE, music)
            opts.setSubItemShown(ALERT_BAN, music)
        except Exception:
            pass
    def alert_click(self, item_id):
        actions = {
            ALERT_LIKE: self.action_like,
            ALERT_DISLIKE: self.action_dislike,
            ALERT_BAN: self.action_ban,
            ALERT_PANEL: self.ui_wave_panel,
        }
        fn = actions.get(item_id)
        if fn is None:
            return False
        fn()
        return True
    def _bulletin_default(self):
        return self.hook_status.get("M3-плеер") != "ok"
    def _wave_menu_items(self):
        _, meta = self._current_keys()
        items = [("msg_filled_data_music", "Моя волна", self.ui_wave_panel)]
        if meta:
            liked = self.profile.is_liked(track_key(meta["a"], meta["t"]))
            items.append(("msg_unfave" if liked else "msg_fave", "Убрать из «Нравится»" if liked else "Нравится", self.action_like))
        if self.active and meta:
            items.append(("msg_block", "Не нравится", self.action_dislike))
            items.append(("msg_cancel", "Не предлагать исполнителя", self.action_ban))
        return items
    def m3_menu(self, opts):
        sheet = _field(M3_CLASS, "instance").get(None)
        if sheet is None:
            return
        more = _field(M3_CLASS, "moreButton").get(sheet)
        anchor = _field(ITEM_OPTIONS, "scrimView").get(opts)
        if more is None or anchor is None or not anchor.equals(more):
            return
        if self._m3_last is not None and opts.equals(self._m3_last):
            return
        self._m3_last = opts
        opts.addGap()
        for icon, text, fn in self._wave_menu_items():
            opts.add(icon_id(icon), text, JRunnable(lambda f=fn: ui(f)))
    def _track_bulletin(self, mo):
        meta = mo_meta(mo) or {}
        text = "%s — %s" % (meta.get("a") or "?", meta.get("t") or "?")
        try:
            from org.telegram.messenger import R as R_tg
            BulletinHelper.show_with_button(text, R_tg.raw.info, "Не нравится", lambda *a: ui(self.action_dislike))
        except Exception:
            toast_info(text)
    def ui_toggle_channel_from_ctx(self, ctx):
        chat = ctx_get(ctx, "chat")
        did = ctx_get(ctx, "dialog_id")
        acc = ctx_get(ctx, "account")
        try:
            acc = int(acc) if acc is not None else UserConfig.selectedAccount
        except Exception:
            acc = UserConfig.selectedAccount
        if chat is None and did:
            try:
                chat = MessagesController.getInstance(acc).getChat(Long.valueOf(-int(did)))
            except Exception:
                chat = None
        if chat is None or not ChatObject.isChannel(chat):
            toast_err("Источником может быть только канал или супергруппа")
            return
        cid = int(chat.id)
        if self.catalog.channel(cid):
            self.catalog.remove_channel(cid)
            toast_info("Канал «%s» убран из Моей волны" % chat.title)
            self._refresh_settings()
            return
        self._add_channel_chat(acc, chat)
    def _chat_username(self, chat):
        try:
            u = ChatObject.getPublicUsername(chat)
            if u:
                return str(u)
        except Exception:
            pass
        try:
            return str(chat.username or "")
        except Exception:
            return ""
    def _add_channel_chat(self, acc, chat):
        ch = self.catalog.add_channel(int(chat.id), acc, str(chat.title or ""), self._chat_username(chat))
        toast_info("«%s» добавлен, индексирую музыку…" % ch["title"])
        self._refresh_settings()
        def bg():
            n = self._index_channel(ch)
            self.catalog.rebuild()
            cnt = self.catalog.channel_count(ch["id"])
            if ch.get("err"):
                toast_err("«%s»: %s" % (ch["title"], ch["err"]))
            else:
                toast_ok("«%s»: %d треков (+%d)" % (ch["title"], cnt, n))
            self._refresh_settings()
            self._genre_kick()
        self.index_q.submit("index_%s" % ch["id"], bg)
    def add_channel_by_text(self, text):
        u = (text or "").strip()
        if not u:
            return
        if "joinchat" in u or "/+" in u or u.startswith("+") or "/c/" in u:
            toast_err("Приватный канал добавьте через ⋮ внутри самого канала")
            return
        username = parse_channel_ref(u)
        if not username:
            toast_err("Не похоже на @username канала")
            return
        acc = UserConfig.selectedAccount
        def bg():
            try:
                chat = self.tg.resolve_username(acc, username)
            except TgError as e:
                toast_err("@%s: %s" % (username, e.text))
                return
            if chat is None or not ChatObject.isChannel(chat):
                toast_err("@%s — это не канал" % username)
                return
            ui(lambda: self._add_channel_chat(acc, chat))
        self.wave_q.submit("resolve_" + username, bg)
    def reindex_all(self, *args):
        def bg():
            for ch in list(self.catalog.channels.values()):
                self._index_channel(ch, quick=False)
            self.catalog.rebuild()
            toast_ok("Каналы обновлены: %d треков" % len(self.catalog.items))
            self._refresh_settings()
            self._genre_kick()
        if self.index_q.submit("reindex", bg):
            toast_info("Обновляю каналы…")
    def _activity(self):
        frag = get_last_fragment()
        return frag.getParentActivity() if frag is not None else None
    def _items_dialog(self, title, items, handlers):
        act = self._activity()
        if act is None:
            return
        b = AlertDialogBuilder(act)
        b.set_title(title)
        def on_item(bld, which):
            bld.dismiss()
            fn = handlers[which] if 0 <= which < len(handlers) else None
            if fn:
                ui(fn)
        b.set_items(items, on_item)
        b.set_negative_button("Закрыть", lambda bld, w: bld.dismiss())
        b.show()
    def _message_dialog(self, title, message, copy_text=None):
        act = self._activity()
        if act is None:
            return
        b = AlertDialogBuilder(act)
        b.set_title(title)
        b.set_message(message)
        b.set_positive_button("OK", lambda bld, w: bld.dismiss())
        if copy_text:
            def _copy(bld, w):
                try:
                    from android_utils import copy_to_clipboard
                    copy_to_clipboard(copy_text)
                except Exception:
                    pass
                bld.dismiss()
            b.set_neutral_button("Копировать", _copy)
        b.show()
    def ui_wave_panel(self, *args):
        act = self._activity()
        if act is None:
            return
        try:
            if self._panel is not None:
                self._panel.close()
            self._panel = WavePanel(self, act)
            self._panel.show()
        except Exception:
            wlog_exc("panel")
            self._panel = None
            toast_err("Панель волны не открылась — открываю настройки")
            self.open_settings()
    def panel_status(self):
        if self.wave_q.busy("start"):
            lines = ["Настраиваю волну…"]
        else:
            lines = ["Волна играет" if self.active else "Волна не запущена"]
        _, meta = self._current_keys()
        if meta:
            lines.append("%s — %s" % (meta.get("a") or "?", meta.get("t") or "?"))
        if self.engine.mood() is not None and not self.moods.ready():
            lines.append("Загружаю настроения…" if self.net_q.busy("moods") else "Настроения загрузятся при запуске волны")
        return "\n".join(lines)
    def _panel_refresh(self):
        def _do():
            panel = self._panel
            if panel is not None and panel.is_open():
                panel.render()
            bar = self._bar
            if bar is not None:
                self._bar_safe(bar.update)
        ui(_do)
    def _set_mode(self, key, value):
        self.set_setting(key, value)
        if key == "mood" and value:
            self._mood_kick()
        self.on_mode_changed()
    def _on_mood_setting(self, value):
        self._set_mode("mood", int(value))
    def on_mode_changed(self, *args):
        self._mode_gen += 1
        gen = self._mode_gen
        if not self.active:
            return
        def later():
            if gen == self._mode_gen and self.active:
                self.wave_q.submit("mode", self._mode_bg)
        ui(later, 800)
    def _mode_bg(self):
        cnt = self._recompute_for_mood()
        mood = self.engine.mood()
        if mood is not None and cnt == 0:
            toast_err(self._no_mood_text(mood))
            return
        def _apply():
            if not self.active:
                return
            self.timeline = self.timeline[: self.ptr + 1]
            self.tentative = []
            self._sync_playlist()
            self.wave_q.submit("refill", self._refill_bg)
        ui(_apply)
        toast_info("Волна перестроена")
        self.net_q.submit("enrich", self._enrich_bg)
    def ui_add_channel_dialog(self, *args):
        act = self._activity()
        if act is None:
            return
        from android.widget import EditText
        et = EditText(act)
        et.setHint("@channel или t.me/channel")
        et.setSingleLine(True)
        try:
            from org.telegram.ui.ActionBar import Theme
            et.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
            et.setHintTextColor(Theme.getColor(Theme.key_dialogTextHint))
        except Exception:
            pass
        try:
            from org.telegram.messenger import AndroidUtilities
            pad = AndroidUtilities.dp(20)
            et.setPadding(pad, pad // 2, pad, pad // 2)
        except Exception:
            pass
        b = AlertDialogBuilder(act)
        b.set_title("Добавить канал")
        b.set_message("Публичный канал по @username или ссылке. Приватный — через ⋮ внутри канала.")
        b.set_view(et)
        def ok(bld, w):
            text = str(et.getText())
            bld.dismiss()
            self.add_channel_by_text(text)
        b.set_positive_button("Добавить", ok)
        b.set_negative_button("Отмена", lambda bld, w: bld.dismiss())
        b.show()
    def ui_channel_dialog(self, cid):
        ch = self.catalog.channel(cid)
        if not ch:
            return
        def remove():
            self.catalog.remove_channel(cid)
            toast_info("Канал убран")
            self._refresh_settings()
        def reindex_bg():
            self._index_channel(ch)
            self.catalog.rebuild()
            toast_ok("«%s»: %d треков" % (ch.get("title"), self.catalog.channel_count(cid)))
            self._refresh_settings()
        def reindex():
            ch["end"] = False
            self.index_q.submit("index_%s" % cid, reindex_bg)
        self._items_dialog(ch.get("title") or str(cid), ["Переиндексировать", "Убрать из волны"], [reindex, remove])
    def ui_stats(self, *args):
        with self.profile.jf.lock:
            tracks = dict(self.profile.tracks)
        plays = sum(int(t.get("p", 0)) for t in tracks.values())
        likes = sum(1 for t in tracks.values() if t.get("l"))
        dislikes = sum(1 for t in tracks.values() if t.get("x"))
        top = self.profile.top_artists(10)
        lines = [
            "Треков в каталоге: %d (каналов: %d)" % (len(self.catalog.items), len(self.catalog.channels)),
            "Прослушиваний учтено: %d" % plays,
            "Нравится: %d · Не нравится: %d · Скрыто исполнителей: %d" % (likes, dislikes, len(self.profile.bans())),
            "Жанры определены: %d из %d" % self.genre_progress,
            "Источник похожих: %s" % {"lfm": "Last.fm", "dz": "Deezer", None: "нет"}[self.sim.source()],
            "",
            "Топ-10 по времени:",
        ]
        by_time = self.profile.top_by_time(10)
        lines += ["%s %s — %s" % (MEDALS[i] if i < len(MEDALS) else "%d." % (i + 1), name, format_duration(sec))
                  for i, (name, sec) in enumerate(by_time)] or ["пока пусто — послушайте волну"]
        if self.profile.jf.data.get("time_est"):
            lines.append("Время до версии 1.4.0 оценено по длине треков.")
        lines += ["", "Топ по оценке волны:"]
        lines += ["%d. %s (%.1f)" % (i + 1, name, sc) for i, (ak, sc, name) in enumerate(top)] or ["пока пусто — послушайте волну"]
        self._message_dialog("Статистика волны", "\n".join(lines))
    def ui_diagnostics(self, *args):
        lines = ["Версия: " + __version__, "", "Хуки:"] + ["  %s: %s" % kv for kv in self.hook_status.items()]
        done, total = self.genre_progress
        indexing = ["%s: %d из %d" % (
            (self.catalog.channel(cid) or {}).get("title"), self.catalog.channel_count(cid), st.get("total", 0),
        ) for cid, st in list(self.index_state.items())]
        lines += [
            "",
            "Волна активна: %s, в плейлисте %d, готово следующих %d" % (self.active, len(self.timeline), len(self.tentative)),
            "Подходящих треков: %d%s" % (self.engine.eligible_count, " (всё новое прослушано — повторы)" if self.engine.exhausted else ""),
            "Сообщений в памяти: %d" % len(self.catalog.memory),
            "Жанры определены: %d из %d%s" % (done, total, " (идёт)" if self.genre_q.busy("genres") else ""),
            "Настроения: " + self._mood_report(),
            "Характеры: " + ("открыты" if self.engine.warm() else "знакомство, %d из %d треков" % (self.profile.listened(), WARM_PLAYS)),
            "Индексация: " + ("; ".join(indexing) if indexing else "не идёт"),
            "Last.fm: ключ %s, сессия %s, в очереди скробблов %d" % (
                "есть" if self.lastfm.key else "нет", "есть" if self.lastfm.session else "нет", len(self.profile.jf.data.get("sq", []))),
            "",
            "Сеть:",
        ]
        lines += ["  " + h.report() for h in (self.yandex.http, self.itunes.http, self.lastfm.http, self.deezer.http)]
        lines += [
            "  Telegram: таймаутов %d, FLOOD_WAIT %d, getMessages: %s" % (TG_STATS["timeout"], TG_STATS["flood"], self._getmsg_status),
            "",
            "Последние события:",
        ] + _LOG_RING[-15:]
        text = "\n".join(lines)
        self._message_dialog("Диагностика", text, copy_text=text)
    def _mood_report(self):
        if self.moods.ready():
            return ", ".join("%s %d" % (m[0], c) for m, c in zip(MOODS, self.moods.counts(), strict=True))
        return "загружаются" if self.net_q.busy("moods") else "не загружены"
    def export_for_eval(self, *args):
        def bg():
            try:
                from client_utils import send_document
                self._flush()
                path = os.path.join(self.data_dir, "my_wave_export.zip")
                with zipfile.ZipFile(path, "w", zipfile.ZIP_DEFLATED) as z:
                    for name in ("profile.json", "catalog.json", "genres.json", "cache.json"):
                        src = os.path.join(self.data_dir, name)
                        if os.path.exists(src):
                            z.write(src, name)
                me = int(UserConfig.getInstance(UserConfig.selectedAccount).getClientUserId())
                send_document(me, path, caption="Моя волна: данные для оценки подбора")
                toast_ok("Архив отправлен в Избранное")
            except Exception:
                wlog_exc("export")
                toast_err("Не удалось выгрузить данные")
        self.net_q.submit("export", bg)
    def ui_reset(self, *args):
        act = self._activity()
        if act is None:
            return
        b = AlertDialogBuilder(act)
        b.set_title("Сбросить историю?")
        b.set_message("Оценки исполнителей, лайки и история прослушиваний будут удалены. Каналы и кэш Last.fm останутся.")
        def ok(bld, w):
            bld.dismiss()
            self.profile.reset()
            self.engine.new_session()
            if self.active:
                self._invalidate_tentative()
            toast_ok("История сброшена")
        b.set_positive_button("Сбросить", ok)
        b.set_negative_button("Отмена", lambda bld, w: bld.dismiss())
        b.show()
        try:
            b.make_button_red(AlertDialogBuilder.BUTTON_POSITIVE)
        except Exception:
            pass
    def open_settings(self, *args):
        try:
            from com.exteragram.messenger.plugins import PluginsController
            from com.exteragram.messenger.plugins.ui import PluginSettingsActivity
            ctrl = PluginsController.getInstance()
            p = (ctrl.getPlugins() if hasattr(ctrl, "getPlugins") else ctrl.plugins).get(__id__)
            frag = get_last_fragment()
            if p is not None and frag is not None:
                ui(lambda: frag.presentFragment(PluginSettingsActivity(p)))
                return
        except Exception:
            wlog_exc("open settings")
        toast_info("Откройте: Настройки → Плагины → Моя волна")
    def _refresh_settings(self, throttle=False):
        now = time.time()
        if throttle and now - self._settings_ts < 3.0:
            return
        self._settings_ts = now
        def _do():
            self.set_setting("_rev", int(self.get_setting("_rev", 0) or 0) + 1, reload_settings=True)
        ui(_do)
    def _on_debug(self, value):
        _DEBUG["on"] = bool(value)
    def _banned_page(self):
        rows = [Header(text="Скрытые исполнители")]
        bans = self.profile.bans()
        if not bans:
            rows.append(Text(text="Список пуст"))
        for ak, name in sorted(bans.items(), key=lambda kv: kv[1].lower()):
            rows.append(Text(text=name, subtext="Нажмите, чтобы вернуть в волну", icon="msg_block",
                             on_click=lambda v, ak=ak, name=name: (self.profile.unban(ak), toast_ok("%s снова в волне" % name), self._refresh_settings())))
        return rows
    def _data_page(self):
        return [
            Header(text="Данные"),
            Text(text="Статистика", icon="msg_stats", on_click=lambda v: ui(self.ui_stats)),
            Text(text="Скрытые исполнители (%d)" % (len(self.profile.bans()) if hasattr(self, "profile") else 0),
                 icon="msg_block", create_sub_fragment=self._banned_page),
            Text(text="Диагностика", icon="msg_info", on_click=lambda v: ui(self.ui_diagnostics)),
            Text(text="Выгрузить данные подбора в Избранное", icon="msg_saved",
                 subtext="История, каталог и жанры для оценки алгоритма. Ключей там нет",
                 on_click=lambda v: self.export_for_eval()),
            Switch(key="debug", text="Подробный лог", default=False, on_change=self._on_debug),
            Text(text="Сбросить историю", red=True, on_click=lambda v: ui(self.ui_reset)),
        ]
    def create_settings(self):
        lfm_user = self.get_setting("lfm_user", "")
        pending = self.get_setting("lfm_pending_token", "")
        rows = [
            Header(text="Моя волна"),
            Text(text="Остановить волну" if getattr(self, "active", False) else "Запустить волну",
                 icon="msg_filled_data_music",
                 on_click=lambda v: ui(self.stop_wave if self.active else self.start_wave)),
            Selector(key="mood", text="Настроение", default=0, items=[MOOD_ANY] + [m[0] for m in MOODS], icon="msg_media",
                     on_change=self._on_mood_setting),
        ]
        engine = getattr(self, "engine", None)
        if engine is not None and engine.warm():
            rows.append(Selector(key="character", text="Характер", default=0, items=CHARACTERS, icon="msg_reactions",
                                 on_change=self.on_mode_changed))
        else:
            listened = engine.profile.listened() if engine is not None else 0
            rows.append(Text(text="Характер волны", icon="msg_reactions",
                             subtext="Откроется, когда волна узнает ваш вкус: %d из %d треков" % (listened, WARM_PLAYS)))
        rows += [
            Selector(key="skip_threshold", text="Ранний пропуск — раньше", default=1,
                     items=["15% трека", "30% трека", "50% трека"], icon="msg_played"),
            Switch(key="learn_all", text="Учиться на всей музыке", default=True,
                   subtext="Учитывать прослушивания и вне волны"),
            Switch(key="duration_filter", text="Только треки 1–15 минут", default=True,
                   subtext="Отсекает джинглы, подкасты и часовые миксы"),
            Switch(key="track_genres", text="Определять жанры треков", default=True,
                   subtext="Нужны подбору похожих треков. Уходят только имя исполнителя и название"),
            Switch(key="track_bulletin", text="Плашка при смене трека", default=self._bulletin_default() if hasattr(self, "hook_status") else True,
                   subtext="С кнопкой «Не нравится». Те же действия есть в меню ⋮ плеера"),
            Switch(key="show_streak", text="Серия на панели волны", default=True,
                   subtext="Счётчик прослушанных подряд внизу панели и в плеере"),
            Divider(),
            Header(text="Каналы-источники"),
            Text(text="Добавить канал", icon="msg_add", on_click=lambda v: ui(self.ui_add_channel_dialog)),
        ]
        channels = sorted(self.catalog.channels.values(), key=lambda c: str(c.get("title", "")).lower()) if hasattr(self, "catalog") else []
        for ch in channels:
            cid = int(ch["id"])
            sub = "%d треков" % self.catalog.channel_count(cid)
            st = self.index_state.get(cid)
            if st:
                sub = "индексируется: %d из %d" % (self.catalog.channel_count(cid), st.get("total", 0))
            if ch.get("username"):
                sub = "@%s · %s" % (ch["username"], sub)
            if ch.get("err"):
                sub += " · " + str(ch["err"])
            rows.append(Text(text=str(ch.get("title") or cid), subtext=sub, icon="msg_channel",
                             on_click=lambda v, cid=cid: ui(lambda: self.ui_channel_dialog(cid))))
        rows += [
            Selector(key="index_depth", text="Глубина индексации канала", default=DEFAULT_DEPTH,
                     items=[str(d) + " треков" for d in INDEX_DEPTHS], icon="msg_stats", on_change=self._on_depth_changed),
            Text(text="Обновить все каналы", on_click=lambda v: self.reindex_all()),
            Divider(text="Каналы также добавляются через ⋮ → «Моя волна: источник» внутри канала."),
            Header(text="Last.fm"),
            Input(key="lfm_key", text="API key", default="", subtext="Бесплатно: last.fm/api/account/create"),
            Input(key="lfm_secret", text="Shared secret", default=""),
        ]
        if lfm_user and self.get_setting("lfm_session", ""):
            rows.append(Text(text="Вошли как " + lfm_user, subtext="Нажмите, чтобы выйти", on_click=lambda v: self.lfm_logout()))
        else:
            rows.append(Text(text="Войти через браузер", accent=True, on_click=lambda v: self.lfm_login()))
            if pending:
                rows.append(Text(text="Я подтвердил доступ — завершить вход", on_click=lambda v: self.lfm_finish()))
        rows += [
            Switch(key="scrobble", text="Скробблинг", default=True, subtext="Отправлять прослушанное в Last.fm"),
            Selector(key="scrobble_scope", text="Что скробблить", default=0, items=["Всю музыку", "Только волну"]),
            Switch(key="use_deezer", text="Deezer, если нет ключа Last.fm", default=True,
                   subtext="Похожие исполнители без ключа"),
            Divider(text="Наружу уходят только имена исполнителей и названия треков. Сообщения и чаты не передаются."),
            Text(text="Данные", icon="msg_stats", subtext="Статистика, диагностика, скрытые исполнители, сброс",
                 create_sub_fragment=self._data_page),
        ]
        return rows
