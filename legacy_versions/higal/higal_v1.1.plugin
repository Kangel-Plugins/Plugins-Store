``  ᴨᴧᴀ7ин ᴄдᴇᴧᴀн: @ᴋᴀ1ᴘʟᴜɢɪɴs
``  ᴇᴄᴧи чᴛо ᴋоᴨиᴩоʙᴀᴛь ᴨоᴧноᴄᴛью нᴇᴧьзя! ᴀ изʍᴇниᴛь ʍожно, ᴄᴨᴩоᴄиʙ у ᴀʙᴛоᴩᴀ ϶ᴛоᴦо ᴨᴧᴀ7инᴀ^`^

"""

__id__ = "higal"
__name__ = "Hide Gallery"
__description__ = "Скрывает всю галерею под размытием\nBlurs the whole gallery"
__author__ = "@ka1Plugins"
__version__ = "1.1"
__icon__ = "animated_boykisser_by_fStikBot/31"
__min_version__ = "12.5.1"


from base_plugin import BasePlugin, MethodHook
from android_utils import log, run_on_ui_thread
from hook_utils import get_private_field
from java.lang import Class, Boolean as B


CELL = "org.telegram.ui.Cells.PhotoAttachPhotoCell"
LAYOUT = "org.telegram.ui.Components.ChatAttachAlertPhotoLayout"
VIEWER = "org.telegram.ui.PhotoViewer"
ATTACH_BUTTON = "org.telegram.ui.Components.ChatAttachAlert$AttachButton"


class HideGalleryPlugin(BasePlugin):

    def __init__(self):
        super().__init__()
        self.revealed = set()
        self.grid = None
        self.orig = None
        self.grid_id = None
        self.blur = None
        self.active = False
        self.session_on = True
        self.bound_rv = None
        self.orig_long = None
        self.attach_listener = None
        self.anim_token = 0
        self.anim = None

    def on_plugin_load(self):
        self.active = True
        self.session_on = True
        try:
            from android.os import Build
            if Build.VERSION.SDK_INT >= 31:
                from android.graphics import RenderEffect, Shader
                from org.telegram.messenger import AndroidUtilities
                r = float(AndroidUtilities.dp(25))
                self.blur = RenderEffect.createBlurEffect(r, r, Shader.TileMode.CLAMP)
            self._install()
        except Exception as e:
            log(f"load: {e}")

    def on_plugin_unload(self):
        self.active = False
        try:
            self.anim_token += 1
            if self.anim is not None:
                try:
                    self.anim.cancel()
                except Exception:
                    pass
                self.anim = None
        except Exception:
            pass
        rv = self.bound_rv
        if rv is not None and self.orig_long is not None:
            try:
                rv.setOnItemLongClickListener(self.orig_long)
            except Exception:
                pass
        gv = self.grid
        if gv is not None:
            try:
                if self.attach_listener is not None:
                    try:
                        gv.removeOnChildAttachStateChangeListener(self.attach_listener)
                    except Exception:
                        pass
            except Exception:
                pass
            try:
                for i in range(gv.getChildCount()):
                    c = gv.getChildAt(i)
                    try:
                        if "PhotoAttachPhotoCell" not in c.getClass().getName():
                            continue
                        iv = c.getImageView()
                        iv.setRenderEffect(None)
                        iv.setColorFilter(None)
                    except Exception:
                        pass
            except Exception:
                pass
        self.revealed = set()
        self.grid = None
        self.orig = None
        self.grid_id = None
        self.blur = None
        self.bound_rv = None
        self.orig_long = None
        self.attach_listener = None
        self.anim_token = 0
        self.anim = None

    def _visual(self, iv, spoil):
        if iv is None:
            return
        try:
            if spoil and self.blur is not None:
                iv.setRenderEffect(self.blur)
            else:
                iv.setRenderEffect(None)
        except Exception:
            pass

    def _spoil(self, entry, cell):
        if not self.session_on:
            return False
        if entry is None:
            return True
        try:
            if entry.hasSpoiler:
                return False
        except Exception:
            pass
        try:
            if cell is not None and cell.isChecked():
                return False
        except Exception:
            pass
        try:
            return entry.imageId not in self.revealed
        except Exception:
            return True

    def _apply(self, cell):
        if not self.active:
            return
        try:
            entry = cell.getPhotoEntry()
            if entry is None:
                return
            spoil = self._spoil(entry, cell)
            self._visual(cell.getImageView(), spoil)
        except Exception:
            pass

    def _refresh(self):
        if not self.active or self.grid is None:
            return
        try:
            for i in range(self.grid.getChildCount()):
                c = self.grid.getChildAt(i)
                try:
                    if "PhotoAttachPhotoCell" in c.getClass().getName():
                        self._apply(c)
                except Exception:
                    pass
        except Exception:
            pass

    def _reset(self):
        if not self.active:
            return
        self.revealed = set()
        self._refresh()

    def _run_blur_anim(self, cells, start_dp, end_dp, duration=320):
        if not cells:
            return
        try:
            from android.animation import ValueAnimator
            from android.graphics import RenderEffect, Shader
            from org.telegram.messenger import AndroidUtilities
            from java import dynamic_proxy

            k = float(AndroidUtilities.dp(1))
            start_r = float(start_dp) * k
            end_r = float(end_dp) * k

            self.anim_token += 1
            token = self.anim_token

            class Upd(dynamic_proxy(ValueAnimator.AnimatorUpdateListener)):
                def onAnimationUpdate(this, anim):
                    if token != self.anim_token:
                        try:
                            anim.cancel()
                        except Exception:
                            pass
                        return
                    try:
                        v = float(anim.getAnimatedValue())
                    except Exception:
                        v = 0.0
                    eff = None
                    if v > 0.5:
                        try:
                            eff = RenderEffect.createBlurEffect(v, v, Shader.TileMode.CLAMP)
                        except Exception:
                            eff = None
                    for iv in cells:
                        try:
                            iv.setRenderEffect(eff)
                        except Exception:
                            pass

            a = ValueAnimator.ofFloat(start_r, end_r)
            a.setDuration(duration)
            a.addUpdateListener(Upd())
            self.anim = a
            a.start()
        except Exception as e:
            log(f"anim: {e}")

    def _collect_toggle_cells(self):
        cells = []
        try:
            gv = self.grid
            if gv is None:
                return cells
            for i in range(gv.getChildCount()):
                c = gv.getChildAt(i)
                try:
                    if "PhotoAttachPhotoCell" not in c.getClass().getName():
                        continue
                    entry = c.getPhotoEntry()
                    if entry is None:
                        continue
                    try:
                        if entry.hasSpoiler:
                            continue
                    except Exception:
                        pass
                    try:
                        if c.isChecked():
                            continue
                    except Exception:
                        pass
                    try:
                        if entry.imageId in self.revealed:
                            continue
                    except Exception:
                        pass
                    iv = c.getImageView()
                    if iv is None:
                        continue
                    cells.append(iv)
                except Exception:
                    pass
        except Exception:
            pass
        return cells

    def _after_toggle(self):
        try:
            self.anim_token += 1
            self._refresh()
            run_on_ui_thread(self._refresh, 250)
        except Exception:
            pass

    def _toggle_gallery(self):
        try:
            new_state = not self.session_on
            cells = self._collect_toggle_cells()
            self.session_on = new_state
            if new_state:
                self._run_blur_anim(cells, 0, 25)
            else:
                self._run_blur_anim(cells, 25, 0)
            run_on_ui_thread(self._after_toggle, 340)
            from ui.bulletin import BulletinHelper
            if new_state:
                BulletinHelper.show_success("Hide Gallery: ON")
            else:
                BulletinHelper.show_info("Hide Gallery: OFF")
        except Exception as e:
            log(f"toggle: {e}")
        return True

    def _install(self):
        p = self

        class H2(MethodHook):
            def after_hooked_method(self, param):
                if p.active and param.thisObject is not None:
                    p._apply(param.thisObject)

        class HAdd(MethodHook):
            def after_hooked_method(self, param):
                if not p.active:
                    return
                p._refresh()

        class HInit(MethodHook):
            def after_hooked_method(self, param):
                if not p.active:
                    return
                p.revealed = set()
                try:
                    obj = param.thisObject
                    gv = get_private_field(obj, "gridView")
                    if gv is not None:
                        p.grid = gv
                        p._click(gv)
                        p._bind_attach(gv)
                    parent = get_private_field(obj, "parentAlert")
                    if parent is not None:
                        rv = get_private_field(parent, "buttonsRecyclerView")
                        if rv is not None:
                            p.bound_rv = None
                            p.orig_long = None
                            run_on_ui_thread(lambda rv=rv, p=p: p._install_long_click(rv), 100)
                except Exception as e:
                    log(f"onInit: {e}")

        class HReset(MethodHook):
            def after_hooked_method(self, param):
                if p.active:
                    p.revealed = set()

        class HClose(MethodHook):
            def before_hooked_method(self, param):
                if p.active:
                    run_on_ui_thread(p._reset, 400)

        try:
            for m in Class.forName(CELL).getDeclaredMethods():
                n = m.getName()
                if n in ("setPhotoEntry", "setChecked"):
                    m.setAccessible(True)
                    self.hook_method(m, H2())
        except Exception as e:
            log(f"cell: {e}")

        try:
            cls = Class.forName(LAYOUT)
            for m in cls.getDeclaredMethods():
                try:
                    if m.getName() == "addToSelectedPhotos":
                        m.setAccessible(True)
                        self.hook_method(m, HAdd())
                except Exception:
                    pass
            try:
                m = cls.getMethod("onInit", B.TYPE, B.TYPE, B.TYPE)
            except Exception:
                m = cls.getDeclaredMethod("onInit", B.TYPE, B.TYPE, B.TYPE)
            m.setAccessible(True)
            self.hook_method(m, HInit())
            try:
                m2 = cls.getMethod("onHidden")
                m2.setAccessible(True)
                self.hook_method(m2, HReset())
            except Exception:
                pass
        except Exception as e:
            log(f"layout: {e}")

        try:
            for m in Class.forName(VIEWER).getDeclaredMethods():
                if m.getName() == "closePhoto":
                    m.setAccessible(True)
                    self.hook_method(m, HClose())
        except Exception as e:
            log(f"viewer: {e}")

    def _bind_attach(self, gv):
        p = self
        if self.attach_listener is not None:
            return
        try:
            from java import dynamic_proxy
            from androidx.recyclerview.widget import RecyclerView

            class AL(dynamic_proxy(RecyclerView.OnChildAttachStateChangeListener)):
                def onChildViewAttachedToWindow(this, view):
                    try:
                        if not p.active:
                            return
                        try:
                            nm = view.getClass().getName()
                        except Exception:
                            return
                        if "PhotoAttachPhotoCell" in nm:
                            p._apply(view)
                    except Exception:
                        pass

                def onChildViewDetachedFromWindow(this, view):
                    pass

            lst = AL()
            self.attach_listener = lst
            gv.addOnChildAttachStateChangeListener(lst)
        except Exception as e:
            log(f"attach bind: {e}")

    def _install_long_click(self, rv):
        p = self
        if p.bound_rv is rv and p.orig_long is not None:
            return
        p.bound_rv = rv

        try:
            p.orig_long = get_private_field(rv, "onItemLongClickListener")
        except Exception:
            p.orig_long = None
        orig = p.orig_long

        try:
            cls = Class.forName(ATTACH_BUTTON)
        except Exception:
            cls = None

        try:
            from java import dynamic_proxy
            from org.telegram.ui.Components import RecyclerListView

            try:
                ILC = RecyclerListView.OnItemLongClickListener
            except AttributeError:
                ILC = RecyclerListView.OnItemLongClickListenerExtended

            class LongCL(dynamic_proxy(ILC)):
                def onItemClick(this, view, position, *rest):
                    try:
                        if p.active:
                            is_attach = False
                            if cls is not None:
                                try:
                                    is_attach = bool(cls.isInstance(view))
                                except Exception:
                                    is_attach = False
                            if not is_attach:
                                nm = view.getClass().getName()
                                if "AttachButton" in nm and "AttachBot" not in nm:
                                    is_attach = True
                            if is_attach:
                                try:
                                    tag = view.getTag()
                                    if tag is not None and int(tag) == 1:
                                        return p._toggle_gallery()
                                except Exception:
                                    pass
                    except Exception:
                        pass
                    if orig is not None:
                        try:
                            if len(rest) >= 2:
                                return bool(orig.onItemClick(view, position, rest[0], rest[1]))
                            return bool(orig.onItemClick(view, position))
                        except Exception:
                            pass
                    return False

            rv.setOnItemLongClickListener(LongCL())
        except Exception as e:
            log(f"long install: {e}")

    def _click(self, gv):
        p = self
        gid = id(gv)
        if p.grid_id != gid:
            p.orig = None
            for f in ("onItemClickListenerExtended", "onItemClickListener"):
                try:
                    cur = get_private_field(gv, f)
                    if cur is not None:
                        p.orig = cur
                        break
                except Exception:
                    continue
            p.grid_id = gid
        orig = p.orig

        try:
            from java import dynamic_proxy
            from org.telegram.ui.Components import RecyclerListView
            IFC = RecyclerListView.OnItemClickListenerExtended

            class CL(dynamic_proxy(IFC)):
                def onItemClick(this, view, position, x, y):
                    try:
                        if p.active and "PhotoAttachPhotoCell" in view.getClass().getName():
                            try:
                                e = view.getPhotoEntry()
                                if e is not None:
                                    p.revealed.add(e.imageId)
                                    p._visual(view.getImageView(), False)
                            except Exception:
                                pass
                        if orig is not None:
                            orig.onItemClick(view, position, x, y)
                    except Exception as ex:
                        log(f"click: {ex}")

            gv.setOnItemClickListener(CL())
        except Exception as e:
            log(f"listener: {e}")