_DEBUG_STOP = object()
_DEBUG_STATE = {"recorder": None, "plugin": None}
_ROUTE_STATE = threading.local()


def _route_error(label, owner=None, notify=False, to_recorder=True):
    trace = traceback.format_exc()
    if not to_recorder or getattr(_ROUTE_STATE, "active", False):
        _android_log(f"[{__id__}] {label}: {trace}")
        return
    _ROUTE_STATE.active = True
    try:
        if owner is None:
            owner = _DEBUG_STATE["plugin"]
        if owner is not None and notify:
            owner._handle_error(label)
        else:
            log(f"[{__id__}] {label}: {trace}")
            if owner is not None:
                owner._dbg_report_error(label)
    finally:
        _ROUTE_STATE.active = False


def guard(default=None, msg=None, to_recorder=True):
    def deco(fn):
        @wraps(fn)
        def wrapper(*args, **kwargs):
            try:
                return fn(*args, **kwargs)
            except Exception:
                _route_error(msg or f"{fn.__name__} failed", to_recorder=to_recorder)
                return default
        return wrapper
    return deco


_SELF_FILE = _route_error.__code__.co_filename


@guard(msg="Debug recorder flush failed", to_recorder=False)
def _recorder_flush(handle):
    handle.flush()


@guard(msg="Debug recorder write failed", to_recorder=False)
def _recorder_write(handle, item):
    handle.write(item)


@guard(msg="Debug recorder close failed", to_recorder=False)
def _recorder_close(handle):
    handle.close()


@guard(msg="Debug recorder emit failed", to_recorder=False)
def _recorder_emit(recorder, msg):
    recorder.emit("PY", msg)


# ====================================================================
# QPS DEBUG RECORDER
# фоновая запись debug-лога в файл (включается настройкой debug_mode)
# ====================================================================
class DebugRecorder:
    def __init__(self):
        self.path = None
        self.auto_send = False
        self.on_event = None
        self._file = None
        self._queue = Queue()
        self._thread = None
        self._segments = []
        self._held = []
        self._seq = 0
        self._full_notified = False
        self._lock = threading.Lock()

    def open(self, prefix):
        self.close()
        with self._lock:
            self.path = prefix
            self._segments = []
            self._held = []
            self._seq = 0
            self._full_notified = False
            self._queue = Queue()
            handle = self._open_segment_locked()
            self._file = handle
            self._thread = threading.Thread(
                target=self._run,
                args=(self._queue, handle),
                name="QPSDebugWriter",
                daemon=True
            )
            self._thread.start()

    def _open_segment_locked(self):
        path = f"{self.path}.{self._seq:04d}{DEBUG_SEGMENT_EXT}"
        self._seq += 1
        handle = open(path, "w", encoding="utf-8", newline="\n", buffering=1)
        self._segments.append([path, 0])
        return handle

    def _switch_segment_locked(self):
        handle = self._open_segment_locked()
        self._file = handle
        self._queue.put(("switch", handle))

    def _hold_all_locked(self):
        paths = [segment[0] for segment in self._segments]
        self._segments = []
        self._held.append(paths)
        return paths

    @staticmethod
    def _run(queue, handle):
        while True:
            item = queue.get()
            if item is _DEBUG_STOP:
                break
            if isinstance(item, threading.Event):
                _recorder_flush(handle)
                item.set()
                continue
            if isinstance(item, tuple):
                _recorder_flush(handle)
                _recorder_close(handle)
                handle = item[1]
                continue
            _recorder_write(handle, item)
        _recorder_flush(handle)
        _recorder_close(handle)

    @staticmethod
    def _remove_files(paths):
        for path in paths:
            try:
                os.remove(path)
            except OSError:
                pass

    def _rotate_locked(self):
        events = []
        if len(self._segments) >= DEBUG_RING_SEGMENTS:
            if self.auto_send:
                events.append(("full_send", self._hold_all_locked()))
            else:
                self._remove_files([self._segments.pop(0)[0]])
                if not self._full_notified:
                    self._full_notified = True
                    events.append(("full", None))
        self._switch_segment_locked()
        return events

    def _fire(self, events):
        callback = self.on_event
        if callback is None:
            return
        for kind, held in events:
            try:
                callback(self, kind, held)
            except Exception as e:
                log(f"[{__id__}] Debug recorder event failed: {e}")

    def emit(self, tag, text):
        events = []
        with self._lock:
            if self._file is None:
                return
            stamp = datetime.now().strftime("%H:%M:%S.%f")[:-3]
            body = redact_text(str(text)).replace("\n", "\n" + " " * 14)
            line = f"{stamp} [{tag}] {body}\n"
            size = len(line.encode("utf-8", "replace"))
            if self._segments[-1][1] and self._segments[-1][1] + size > DEBUG_SEGMENT_BYTES:
                events = self._rotate_locked()
            self._queue.put(line)
            self._segments[-1][1] += size
        if events:
            self._fire(events)

    def seal(self):
        with self._lock:
            if self._file is None:
                return []
            held = self._hold_all_locked()
            self._switch_segment_locked()
            event = threading.Event()
            self._queue.put(event)
        event.wait(3.0)
        return held

    def release(self, paths, delete):
        with self._lock:
            if paths in self._held:
                self._held.remove(paths)
            if delete:
                self._remove_files(paths)
                self._full_notified = False
                return
            if self._file is None:
                return
            restored = []
            for path in paths:
                try:
                    restored.append([path, os.path.getsize(path)])
                except OSError:
                    pass
            self._segments = restored + self._segments
            while len(self._segments) > DEBUG_RING_SEGMENTS:
                self._remove_files([self._segments.pop(0)[0]])

    def flush(self, timeout=3.0):
        with self._lock:
            if self._file is None:
                return
            event = threading.Event()
            self._queue.put(event)
        event.wait(timeout)

    def close(self):
        with self._lock:
            if self._file is None:
                return
            self._queue.put(_DEBUG_STOP)
            thread = self._thread
            self._file = None
            self._thread = None
        if thread:
            thread.join(3.0)


def _segment_paths(prefix):
    try:
        directory, base = os.path.split(prefix)
        names = sorted(
            name for name in os.listdir(directory)
            if name.startswith(base + ".") and name.endswith(DEBUG_SEGMENT_EXT)
        )
        return [os.path.join(directory, name) for name in names]
    except Exception:
        return []


@guard(default=False, msg="Thread error ownership check failed", to_recorder=False)
def _thread_error_is_ours(args):
    if args.thread is not None and str(args.thread.name).startswith("QPS"):
        return True
    frame = args.exc_traceback
    while frame is not None:
        if frame.tb_frame.f_code.co_filename == _SELF_FILE:
            return True
        frame = frame.tb_next
    return False


# ====================================================================
# QPS LOGGING & LOCALISATION
# ====================================================================
def log(msg):
    try:
        _android_log(msg)
    finally:
        recorder = _DEBUG_STATE["recorder"]
        if recorder is not None:
            _recorder_emit(recorder, msg)


