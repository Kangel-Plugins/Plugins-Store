        "MENU_ITEM_PLUGINS_SHORTCUT": "exteraGram > Plugins"
    }


def localise(key, *args):
    lang = Locale.getDefault().getLanguage()
    locale_dict = getattr(Locales, lang, Locales.default)
    text = locale_dict.get(key, Locales.default.get(key, key))
    return text.format(*args) if args else text


def _error_bulletin_icon():
    raw = getattr(R_tg, "raw", None)
    for name in ("error", "chats_infotip", "info"):
        icon = getattr(raw, name, None)
        if icon:
            return icon
    return 0


# ====================================================================
# QPS ERROR HANDLING
# ====================================================================
# эту хуйню вешаем только к except который логает+ отдает дефолт
# если на except завязан fallback на другой путь — не вешать, оно сожрёт ветку
@guard(default="?", msg="Error context label failed")
def _ctx_label(ctx, args, kwargs):
    return ctx(*args, **kwargs)


def safe(default=None, msg=None, ctx=None, notify=True):
    def deco(fn):
        @wraps(fn)
        def wrapper(self, *args, **kwargs):
            try:
                return fn(self, *args, **kwargs)
            except Exception:
                label = msg or f"{fn.__name__} failed"
                if ctx is not None:
                    label = f"{label} for {_ctx_label(ctx, args, kwargs)}"
                # notify=False идёт для внутренней кухни (тики таймеров, поштучные проходы по списку плагинов) —
                # там бюллетень на каждый чих это спам, но полный трейс всё равно летит в лог
                _route_error(label, owner=self, notify=notify)
                return default
        return wrapper
    return deco


# ====================================================================
# QPS AST SCANNER
# статический разбор .py/.plugin: id, наличие create_settings, команды
# ====================================================================
def _is_literal_node(node):
    if isinstance(node, ast.Constant):
        return True
    if isinstance(node, (ast.Tuple, ast.List, ast.Set)):
        return all(_is_literal_node(element) for element in node.elts)
    if isinstance(node, ast.Dict):
        return (
            all(key is not None and _is_literal_node(key) for key in node.keys)
            and all(_is_literal_node(value) for value in node.values)
        )
    if isinstance(node, ast.UnaryOp) and isinstance(node.op, (ast.UAdd, ast.USub)):
        return isinstance(node.operand, ast.Constant) and isinstance(node.operand.value, (int, float, complex))
    return False


class _CommandVisitor(ast.NodeVisitor):
    # if u see this, i have rlly br0ken vision xDD
    VALID_COMMAND_RE = re.compile(r"^\.[A-Za-z_][\w-]*$")
    # регексу похуй что это расширение файла а не команда - .py/.plugin/.elyx/.eaf сюда не пускаем
    _EXCLUDED_TOKENS = {
        ".py", ".plugin", ".elyx", ".eaf", ".json", ".txt", ".png", ".jpg", ".jpeg",
        ".gif", ".webp", ".mp3", ".mp4", ".ogg", ".webm", ".zip", ".db", ".pdf",
        ".csv", ".xml", ".yaml", ".yml", ".log", ".apk", ".tgs",
        ".doc", ".docx", ".xls", ".xlsx", ".ppt", ".pptx", ".rtf", ".md", ".html", ".htm",
        ".css", ".js", ".ts", ".svg", ".bmp", ".ico", ".heic", ".mov", ".avi", ".mkv",
        ".wav", ".flac", ".m4a", ".aac", ".opus", ".rar", ".7z", ".tar", ".gz", ".bz2", ".xz",
        ".so", ".dll", ".exe", ".bin", ".dat", ".env", ".ini", ".cfg", ".conf", ".toml",
        ".properties", ".pyc", ".pyi", ".sh", ".bat", ".sql", ".ttf", ".otf", ".woff",
        ".jar", ".dex", ".aab", ".iso", ".img", ".bak", ".tmp", ".lock",
        ".com", ".org", ".net", ".ru", ".io", ".me", ".app",
        ".m4v", ".3gp", ".mpg", ".mpeg", ".wmv", ".flv", ".wma", ".mid", ".oga",
        ".tif", ".tiff", ".avif", ".jfif", ".tgz", ".zst",
        ".apks", ".xapk", ".obb", ".odt", ".ods", ".epub"
    }

    def __init__(self):
        self.commands = set()
        self.variables = {}

    _UNKNOWN = object()

    def _static_value(self, node):
        # значение узла, если его можно вычислить статически: константа, переменная с литералом,
        # литерал-коллекция, склейка строк или кортежей через +; иначе _UNKNOWN
        if isinstance(node, ast.Constant):
            return node.value
        if isinstance(node, ast.Name):
            return self.variables.get(node.id, self._UNKNOWN)
        if _is_literal_node(node):
            try:
                return ast.literal_eval(node)
            except Exception:
                return self._UNKNOWN
        if isinstance(node, ast.BinOp) and isinstance(node.op, ast.Add):
            left = self._static_value(node.left)
            right = self._static_value(node.right)
            if left is self._UNKNOWN or right is self._UNKNOWN:
                return self._UNKNOWN
            if isinstance(left, str) and isinstance(right, str):
                return left + right
            if isinstance(left, (tuple, list)) and isinstance(right, (tuple, list)):
                return list(left) + list(right)
        return self._UNKNOWN

    def _resolve_values(self, node):
        value = self._static_value(node)
        if value is self._UNKNOWN:
            return []
        return self._flatten_value(value)

    def _flatten_value(self, value):
        if isinstance(value, (tuple, list, set, frozenset)):
            out = []
            for element in value:
                out.extend(self._flatten_value(element))
            return out
        if isinstance(value, dict):
            return self._flatten_value(list(value.keys()))
        if isinstance(value, str):
            return [value]
        return []

    def _remember(self, target, value_node, overwrite):
        if not isinstance(target, ast.Name) or value_node is None:
            return
        if not overwrite and target.id in self.variables:
            return
        value = self._static_value(value_node)
        if value is self._UNKNOWN:
            return
        try:
            if isinstance(value, (str, int, float, complex, bool, tuple, list, set, frozenset, dict)) or value is None:
                self.variables[target.id] = value
        except Exception:
            pass

    def visit_Module(self, node):
        # переменные могут быть объявлены ниже функции, которая их использует,
        # поэтому сначала собираем все присваивания со статическим значением, потом обходим код
        for child in ast.walk(node):
            if isinstance(child, ast.Assign) and len(child.targets) == 1:
                self._remember(child.targets[0], child.value, overwrite=False)
            elif isinstance(child, ast.AnnAssign):
                self._remember(child.target, child.value, overwrite=False)
        self.generic_visit(node)

    def visit_AnnAssign(self, node):
        self._remember(node.target, node.value, overwrite=True)
        self.generic_visit(node)

    def visit_Assign(self, node):
        if len(node.targets) == 1:
            self._remember(node.targets[0], node.value, overwrite=True)
        self.generic_visit(node)

    def _add_command(self, value):
        command = _command_from_value(value)
        if command:
            self.commands.add(command)

    def visit_Compare(self, node):
        if any(isinstance(op, (ast.Eq, ast.NotEq, ast.In)) for op in node.ops):
            for item in [node.left] + node.comparators:
                for value in self._resolve_values(item):
                    self._add_command(value)
        self.generic_visit(node)

    def visit_Call(self, node):
        if isinstance(node.func, ast.Attribute) and node.func.attr == "startswith":
            if node.args:
                for value in self._resolve_values(node.args[0]):
                    self._add_command(value)
        self.generic_visit(node)


def _command_from_value(value):
    if not isinstance(value, str):
        return None
    command = value.strip().split(" ")[0]
    if command.lower() in _CommandVisitor._EXCLUDED_TOKENS:
        return None
    if _CommandVisitor.VALID_COMMAND_RE.match(command):
        return command
    return None


def _get_id_from_tree(tree):
    for node in tree.body:
        if not isinstance(node, ast.Assign):
            continue
        for target in node.targets:
            if isinstance(target, ast.Name) and target.id == "__id__":
                if not _is_literal_node(node.value):
                    return None
                value = ast.literal_eval(node.value)
                return value if isinstance(value, str) and value else None
    return None


def _negative_cache_entry(stat, is_elyx):
    return {
        "v": CACHE_SCAN_VERSION,
        "plugin_id": None,
        "mtime": stat.st_mtime,
        "size": stat.st_size,
        "is_elyx": is_elyx
    }


def _get_returns_no_nested(node):
    returns = []
    for child in ast.iter_child_nodes(node):
        if isinstance(child, (ast.FunctionDef, ast.AsyncFunctionDef, ast.Lambda)):
            continue
        if isinstance(child, ast.Return):
            returns.append(child)
        else:
            returns.extend(_get_returns_no_nested(child))
    return returns


def _has_real_create_settings(tree):
    for node in ast.walk(tree):
        if not isinstance(node, ast.ClassDef):
            continue
        for item in node.body:
            if not (isinstance(item, ast.FunctionDef) and item.name == "create_settings"):
                continue
            arg_names = [a.arg for a in item.args.args]
            if not arg_names or arg_names[0] != "self":
                continue
            returns = _get_returns_no_nested(item)
            if not returns:
                continue
            for ret in returns:
                value = ret.value
                if value is None:
                    continue
                if isinstance(value, ast.Constant) and value.value is None:
                    continue
                if isinstance(value, (ast.List, ast.Tuple)) and not value.elts:
                    continue
                return True
    return False


# ====================================================================
# QPS XPOSED HOOKS
# ====================================================================
class PluginStateChangeHook(XposedHook):
    def __init__(self, plugin_instance):
        super().__init__()
        self.plugin = plugin_instance

    @guard(msg="State change hook failed")
    def after_hooked_method(self, param):
        if self.plugin._unloaded:
            return
        self.plugin._schedule_cache_sync(hint=self.plugin._hook_path_hint(param))


class DebugEventHook(XposedHook):
    def __init__(self, plugin_instance):
        super().__init__()
        self.plugin = plugin_instance

    @guard(msg="Debug before-hook failed")
    def before_hooked_method(self, param):
        if self.plugin._unloaded:
            return
        self.plugin._dbg_on_hook("BEFORE", param)

    @guard(msg="Debug after-hook failed")
    def after_hooked_method(self, param):
        if self.plugin._unloaded:
            return
        self.plugin._dbg_on_hook("AFTER ", param)


# ====================================================================
# QPS CACHE
# кэш сведений о плагинах (mtime/size) и обычный сканер .py/.plugin
# ====================================================================
class CacheMixin:
    def _handle_rebuild_cache_click(self, view):
        BulletinHelper.show_info(localise("INFO_CACHE_REBUILDING"))
        self._schedule_cache_rebuild(delay=0.1, show_notification=True)

    @safe(msg="Failed to initialize cache system")
    def _init_cache_system(self):
        context = ApplicationLoader.applicationContext
        if not context:
            return
        base_dir = context.getFilesDir()
        if not base_dir:
            return

        cache_dir = File(base_dir, QUICKSETTINGS_CACHE_DIR)
        if not cache_dir.exists():
            cache_dir.mkdirs()

        self.cache_path = File(cache_dir, CACHE_FILENAME).getAbsolutePath()

    def _index_by_plugin_id(self, file_cache):
        index = {}
        for entry in file_cache.values():
            if not isinstance(entry, dict):
                continue
            plugin_id = entry.get("plugin_id")
            if plugin_id:
                index[plugin_id] = entry
        return index

    def _load_cache(self):
        if not self.cache_path or not os.path.exists(self.cache_path):
            return False
        try:
            with open(self.cache_path, "r", encoding="utf-8") as f:
                data = json.load(f)
            if not isinstance(data, dict):
                return False

            # старый кэш v4.0 лежал по plugin_id и без mtime — такие записи просто отвалятся на ребилде
            with self._cache_lock:
                self.file_cache = data
                self.plugin_info_cache = self._index_by_plugin_id(data)
            log(f"[{__id__}] Cache loaded successfully with {len(self.plugin_info_cache)} entries.")
            return True
        except Exception as e:
            log(f"[{__id__}] Failed to load cache: {e}. Rebuilding.")
            return False

    def _rebuild_cache_and_update_menu(self):
        if self._unloaded:
            return
        if not self._rebuild_exec_lock.acquire(blocking=False):
            log(f"[{__id__}] Rebuild already in progress, requeueing.")
            self._schedule_cache_rebuild(delay=1.0)
            return

        try:
            with self._rebuild_lock:
                show_notification = self._pending_notify
                self._pending_notify = False
            self._do_rebuild_cache_and_update_menu(show_notification)
        finally:
            self._rebuild_exec_lock.release()

    def _do_rebuild_cache_and_update_menu(self, show_notification=False):
        log(f"[{__id__}] Starting cache rebuild.")
        if not self.cache_path:
            self._init_cache_system()

        if not self.cache_path:
            log(f"[{__id__}] Cache path not initialized. Aborting rebuild.")
            return

        cache_data = {}
        parsed = 0
        reused = 0
        registry_baseline = self._registry_state()
        try:
            plugins_dir = get_plugins_dir()
            if not plugins_dir:
                return

            with self._cache_lock:
                old_cache = self.file_cache

            cache_data, parsed, reused = self._scan_regular_plugins(plugins_dir, old_cache)

            try:
                elyx_entries, elyx_parsed, elyx_reused = self._scan_elyx_plugins(plugins_dir, old_cache)
            except Exception:
                self._handle_error("Elyx scan failed", notify=False)
                elyx_entries = {
                    k: v for k, v in old_cache.items()
                    if isinstance(v, dict) and v.get("is_elyx") is True
                }
                elyx_parsed = 0
                elyx_reused = len(elyx_entries)
            cache_data.update(elyx_entries)
            parsed += elyx_parsed
            reused += elyx_reused

            with self._cache_lock:
                self.file_cache = cache_data
                self.plugin_info_cache = self._index_by_plugin_id(cache_data)
                self._cache_dirty = False
            self._registry_state_last = registry_baseline

            log(
                f"[{__id__}] Cache rebuilt with {len(cache_data)} entries "
                f"(parsed {parsed}, reused {reused})."
            )

            self._schedule_menu_update(delay=0)
            if show_notification:
                self._notify("success", localise("INFO_CACHE_REBUILT_SUCCESS"))

            self._persist_cache(cache_data)

        except Exception:
            self._handle_error("Error during cache rebuild", notify=show_notification)

    def _scan_regular_plugins(self, plugins_dir, old_cache):
        cache_data = {}
        parsed = 0
        reused = 0

        for filename in os.listdir(plugins_dir):
            if not filename.endswith((".py", ".plugin")):
                continue
            file_path = os.path.join(plugins_dir, filename)
            entry, was_parsed, was_reused = self._scan_regular_file(filename, file_path, old_cache.get(filename))
            if entry is not None:
                cache_data[filename] = entry
            parsed += was_parsed
            reused += was_reused

        return cache_data, parsed, reused

    def _scan_regular_file(self, filename, file_path, old):
        try:
            stat = os.stat(file_path)
            size = stat.st_size

            # файл не трогали с прошлого раза — берём готовое, нехуй его парсить заново
            if (
                isinstance(old, dict)
                and old.get("v") == CACHE_SCAN_VERSION
                and old.get("mtime") == stat.st_mtime
                and old.get("size") == size
            ):
                # старый кэш мог быть записан до появления is_elyx - копия, а не мутация
                # in-place, self.plugin_info_cache на этот словарь ещё смотрит живой юай-поток
                return (old if "is_elyx" in old else {**old, "is_elyx": False}), 0, 1

            # 8 мб — это уже не плагин, а хуйня какая-то, парсить не будем
            if size > MAX_FILE_SIZE:
                log(f"[{__id__}] Skipped {filename}: {size} bytes is too fat for ast")
                return None, 0, 0

            with open(file_path, "r", encoding="utf-8-sig") as f:
                content = f.read()

            if "__id__" not in content:
                return _negative_cache_entry(stat, False), 0, 0

            try:
                tree = ast.parse(content, filename=filename)
            except Exception as ast_err:
                log(f"[{__id__}] AST parse failed for {filename}: {ast_err}")
                tree = None

            parse_failed = tree is None

            if tree is not None:
                plugin_id = _get_id_from_tree(tree)
            else:
                plugin_id = self._get_id_by_regex(content)
            if not plugin_id:
                return _negative_cache_entry(stat, False), 0, 0
            has_settings = _has_real_create_settings(tree) if tree is not None else False

            if tree is not None:
                visitor = _CommandVisitor()
                visitor.visit(tree)
                commands = sorted(visitor.commands)
            else:
                commands = []

            return {
                "v": CACHE_SCAN_VERSION,
                "plugin_id": plugin_id,
                "mtime": stat.st_mtime,
                "size": size,
                "has_settings": has_settings,
                "commands": commands,
                "parse_failed": parse_failed,
                "is_elyx": False
            }, 1, 0
        except FileNotFoundError:
            return None, 0, 0
        except Exception as inner_e:
            log(f"[{__id__}] Skipped {filename}: {inner_e}")
            if isinstance(old, dict) and old.get("plugin_id"):
                return old, 0, 0
            return None, 0, 0

    @safe(msg="Legacy private data cleanup failed", notify=False)
    def _cleanup_legacy_private_data(self):
        if not self.cache_path:
            return
        cache_dir = os.path.dirname(self.cache_path)
        if not os.path.isdir(cache_dir):
            return
        real_cache_dir = os.path.realpath(cache_dir)
        for name in LEGACY_PRIVATE_DIRNAMES:
            target = os.path.join(cache_dir, name)
            if os.path.islink(target) or not os.path.isdir(target):
                continue
            real_target = os.path.realpath(target)
            if real_target == real_cache_dir or not self._is_path_inside_dir(real_target, real_cache_dir):
                log(f"[{__id__}] Refusing to clean {target}: outside QuickSettingsCache")
                continue
            if self._rmtree_guarded(target, real_cache_dir, "legacy private data"):
                log(f"[{__id__}] Removed legacy private data: {real_target}")

    def _purge_cache_for_plugin(self, plugin_id):
        with self._cache_lock:
            dead = [k for k, v in self.file_cache.items() if isinstance(v, dict) and v.get("plugin_id") == plugin_id]
            if dead:
                self.file_cache = {k: v for k, v in self.file_cache.items() if k not in dead}
                self.plugin_info_cache = self._index_by_plugin_id(self.file_cache)
                self._cache_dirty = True
        return len(dead)

    def _persist_cache(self, cache_data):
        # пишем в .tmp и подменяем, чтоб дохляк посреди записи не наебашил по json
        tmp_path = self.cache_path + ".tmp"
        try:
            with open(tmp_path, "w", encoding="utf-8") as f:
                json.dump(cache_data, f)
            os.replace(tmp_path, self.cache_path)
        except Exception:
            self._handle_error("Cache persist failed", notify=False)

    def _schedule_cache_rebuild(self, delay=1.0, show_notification=False):
        with self._rebuild_lock:
            if self._unloaded:
                return
            if show_notification:
                self._pending_notify = True
            self._cancel_timer(self.rebuild_timer)
            timer = threading.Timer(delay, self._rebuild_cache_and_update_menu)
            timer.daemon = True
            self.rebuild_timer = timer
            timer.start()

    def _schedule_cache_sync(self, delay=1.0, hint=None):
        with self._sync_lock:
            if self._unloaded:
                return
            if hint:
                self._sync_hints.add(hint)
            self._cancel_timer(self._sync_timer)
            timer = threading.Timer(delay, self._sync_cache_and_update_menu)
            timer.daemon = True
            self._sync_timer = timer
            timer.start()

    @safe(default=None, msg="Hook path hint failed", notify=False)
    def _hook_path_hint(self, param):
        plugin_exts = (".py", ".plugin") + ELYX_EXTS
        for arg in (list(param.args) if param.args is not None else []):
            if isinstance(arg, str) and arg.endswith(plugin_exts):
                return arg
            if hasattr(arg, "getAbsolutePath"):
                path = str(arg.getAbsolutePath())
                if path.endswith(plugin_exts):
                    return path
        if str(param.method.getName()) == "loadPluginFromFile":
            return SYNC_DISCOVER_HINT
        return None

    def _sync_cache_and_update_menu(self):
        if self._unloaded:
            return
        if not self._rebuild_exec_lock.acquire(blocking=False):
            self._schedule_cache_sync(delay=1.0)
            return
        try:
            with self._sync_lock:
                hints = set(self._sync_hints)
                self._sync_hints.clear()
            if self._do_sync_cache(hints) is not True:
                log(f"[{__id__}] Cache sync not possible, falling back to full rebuild.")
                self._schedule_cache_rebuild(delay=0.5)
        finally:
            self._rebuild_exec_lock.release()

    @safe(default=False, msg="Cache sync failed", notify=False)
    def _do_sync_cache(self, hints):
        previous = self._registry_state_last
        plugins_dir = get_plugins_dir()
        if previous is None or not self.cache_path or not plugins_dir:
            return False
        current = self._registry_state()
        if current is None:
            return False

        with self._cache_lock:
            old_cache = self.file_cache
        rows_by_id = {}
        for key, entry in old_cache.items():
            if isinstance(entry, dict) and entry.get("plugin_id"):
                rows_by_id.setdefault(entry["plugin_id"], []).append(key)

        touched = set()
        discover = False
        for plugin_id in set(current) | set(previous):
            now = current.get(plugin_id)
            before = previous.get(plugin_id)
            if now is None:
                touched.update(rows_by_id.get(plugin_id, []))
            elif before is None or now[0] != before[0] or plugin_id not in rows_by_id:
                key = self._key_for_path(now[0], plugins_dir)
                if key:
                    touched.add(key)
                else:
                    discover = True
        for hint in hints:
            if hint == SYNC_DISCOVER_HINT:
                discover = True
                continue
            key = self._key_for_path(hint, plugins_dir)
            if key:
                touched.add(key)
            else:
                discover = True
        if discover:
            found = self._discover_changed_keys(plugins_dir, old_cache)
            if found is None:
                return False
            touched.update(found)

        updates = {}
        parsed = 0
        for key in sorted(touched):
            path = os.path.join(plugins_dir, *key.split("/"))
            old = old_cache.get(key)
            if not os.path.exists(path):
                if key in old_cache:
                    updates[key] = None
                continue
            result = self._refresh_cache_key(key, path, old)
            if result is None:
                continue
            entry, was_parsed, _ = result
            parsed += was_parsed
            if entry is old:
                continue
            if entry is None:
                if key in old_cache:
                    updates[key] = None
                continue
            updates[key] = entry

        changed = bool(updates) or self._cache_dirty
        if updates:
            with self._cache_lock:
                new_cache = dict(self.file_cache)
                affected = set()
                for key, entry in updates.items():
                    old_row = new_cache.get(key)
                    if isinstance(old_row, dict) and old_row.get("plugin_id"):
                        affected.add(old_row["plugin_id"])
                    if entry is None:
                        new_cache.pop(key, None)
                    else:
                        new_cache[key] = entry
                        if entry.get("plugin_id"):
                            affected.add(entry["plugin_id"])
                index = dict(self.plugin_info_cache)
                for plugin_id in affected:
                    index.pop(plugin_id, None)
                for entry in new_cache.values():
                    if isinstance(entry, dict) and entry.get("plugin_id") in affected:
                        index[entry["plugin_id"]] = entry
                self.file_cache = new_cache
                self.plugin_info_cache = index
        if changed:
            with self._cache_lock:
                snapshot = self.file_cache
                self._cache_dirty = False
            self._persist_cache(snapshot)

        self._registry_state_last = current
        log(
            f"[{__id__}] Cache synced: {len(updates)} rows changed, parsed {parsed}, "
            f"touched {len(touched)}, registry {len(current)} plugins."
        )
        if changed or current != previous:
            self._schedule_menu_update(delay=0)
        return True

    @safe(default=None, msg="Registry state read failed", notify=False)
    def _registry_state(self):
        entries, complete = self._registry_entries()
        if not complete:
            return None
        state = {}
        for plugin_id, plugin_obj in entries:
            state[plugin_id] = (self._registry_plugin_path(plugin_obj), bool(self._is_plugin_enabled(plugin_obj)))
        return state

    @safe(default=None, msg="Registry plugin path read failed", notify=False)
    def _registry_plugin_path(self, plugin_obj):
        if not hasattr(plugin_obj, "file"):
            return None
        path = plugin_obj.file.getAbsolutePath()
        return str(path) if path else None

    def _key_for_path(self, path, plugins_dir):
        if not path:
            return None
        candidate = path if os.path.isabs(path) else os.path.join(plugins_dir, path)
        real_dir = os.path.realpath(plugins_dir)
        real = os.path.realpath(candidate)
        if real == real_dir or not self._is_path_inside_dir(real, real_dir):
            return None
        parts = os.path.relpath(real, real_dir).replace(os.sep, "/").split("/")
        if len(parts) == 1:
            return parts[0]
        if parts[0] == ELYX_ARCHIVES_DIRNAME:
            return "/".join(parts[:2])
        if parts[0] != ELYX_PLUGINS_DIRNAME:
            return None
        if parts[1] == ELYX_ARCHIVES_DIRNAME:
            return "/".join(parts[:3]) if len(parts) >= 3 else None
        return "/".join(parts[:2])

    def _refresh_cache_key(self, key, path, old):
        parts = key.split("/")
        if len(parts) == 1:
            if os.path.isfile(path) and key.endswith((".py", ".plugin")):
                return self._scan_regular_file(key, path, old)
            if os.path.isfile(path) and key.endswith(ELYX_EXTS):
                return self._scan_elyx_job(key, path, False, old)
            return None
        if parts[0] == ELYX_ARCHIVES_DIRNAME:
            if len(parts) == 2 and os.path.isfile(path) and key.endswith(ELYX_EXTS):
                return self._scan_elyx_job(key, path, False, old)
            return None
        if parts[0] != ELYX_PLUGINS_DIRNAME:
            return None
        if os.path.isdir(path):
            if len(parts) == 2 and parts[1] != ELYX_ARCHIVES_DIRNAME:
                return self._scan_elyx_job(key, path, True, old)
            return None
        if os.path.isfile(path) and key.endswith(ELYX_EXTS):
            return self._scan_elyx_job(key, path, False, old)
        return None

    @safe(default=None, msg="Cache discovery failed", notify=False)
    def _discover_changed_keys(self, plugins_dir, old_cache):
        keys = set()

        def stale(key, path):
            old = old_cache.get(key)
            stat = os.stat(path)
            return not (
                isinstance(old, dict)
                and old.get("v") == CACHE_SCAN_VERSION
                and old.get("mtime") == stat.st_mtime
                and old.get("size") == stat.st_size
            )

        def stale_dir(key, path):
            # уже известную папку тоже перепроверяем: её могли обновить или отсканировать посреди распаковки
            old = old_cache.get(key)
            try:
                _, newest, total = self._walk_elyx_dir(path)
            except OSError:
                return True
            return not (
                isinstance(old, dict)
                and old.get("v") == CACHE_SCAN_VERSION
                and old.get("mtime") == newest
                and old.get("size") == total
            )

        for name in os.listdir(plugins_dir):
            path = os.path.join(plugins_dir, name)
            if name.endswith((".py", ".plugin") + ELYX_EXTS) and os.path.isfile(path) and stale(name, path):
                keys.add(name)

        docs_archives = os.path.join(plugins_dir, ELYX_ARCHIVES_DIRNAME)
        if os.path.isdir(docs_archives):
            for arch in os.listdir(docs_archives):
                arch_path = os.path.join(docs_archives, arch)
                arch_key = f"{ELYX_ARCHIVES_DIRNAME}/{arch}"
                if arch.endswith(ELYX_EXTS) and os.path.isfile(arch_path) and stale(arch_key, arch_path):
                    keys.add(arch_key)

        root = os.path.join(plugins_dir, ELYX_PLUGINS_DIRNAME)
        if not os.path.isdir(root):
            return keys
        for name in os.listdir(root):
            path = os.path.join(root, name)
            key = f"{ELYX_PLUGINS_DIRNAME}/{name}"
            if os.path.isdir(path):
                if name == ELYX_ARCHIVES_DIRNAME:
                    for arch in os.listdir(path):
                        arch_path = os.path.join(path, arch)
                        arch_key = f"{key}/{arch}"
                        if arch.endswith(ELYX_EXTS) and os.path.isfile(arch_path) and stale(arch_key, arch_path):
                            keys.add(arch_key)
                elif key not in old_cache or stale_dir(key, path):
                    keys.add(key)
            elif name.endswith(ELYX_EXTS) and os.path.isfile(path) and stale(key, path):
                keys.add(key)
        return keys

    def _get_id_by_regex(self, content):
        match = re.search(
            r"^__id__\s*=\s*['\"]([\w.-]+)['\"]", content, re.MULTILINE
        )
        return match.group(1) if match else None

    @safe(default=None, msg="AST parse failed", notify=False)
    def _parse_tree(self, content):
        return ast.parse(content)

    def _get_id_from_file_content(self, content):
        plugin_id = self._get_id_by_regex(content)
        if plugin_id or "__id__" not in content:
            return plugin_id
        tree = self._parse_tree(content)
        return _get_id_from_tree(tree) if tree is not None else None

    def _find_cached_regular_path(self, plugin_id):
        plugins_dir = get_plugins_dir()
        if not plugins_dir:
            return None
        with self._cache_lock:
            items = list(self.file_cache.items())
        for key, entry in items:
            if (
                isinstance(entry, dict)
                and entry.get("plugin_id") == plugin_id
                and entry.get("is_elyx") is not True
                and "/" not in key
            ):
                path = os.path.join(plugins_dir, key)
                if os.path.isfile(path):
                    return path
        return None

    def _get_plugin_info(self, plugin_id):
        with self._cache_lock:
            return self.plugin_info_cache.get(plugin_id)

    def _plugin_has_settings(self, plugin_id):
        return (self._get_plugin_info(plugin_id) or {}).get("has_settings", False)

    def _get_plugin_commands(self, plugin_id):
        return (self._get_plugin_info(plugin_id) or {}).get("commands", [])

    def _plugin_has_commands(self, plugin_id):
        return bool(self._get_plugin_commands(plugin_id))


# ====================================================================
# QPS ELYX SCANNER
# elyx-плагины лежат в plugins/ElyxPlugins/: распакованные папки (refmap.yml в корне папки,
# сам плагин во вложенной папке) и исходные архивы в ElyxPlugins/archives/.
# и папки, и архивы читаются одним кодом: источник отдаёт список имён и функцию чтения.
# у elyx-плагина нет .file, поэтому путь берём из кэша сканера (ключ записи = путь от plugins/)
# ====================================================================
class ElyxScannerMixin:
    def _read_zip_entry_capped(self, zf, name, max_size):
        info = zf.getinfo(name)
        if info.file_size > max_size:
            return None
        return zf.read(name)

    def _parse_flat_mapping(self, text):
        result = {}
        for line in text.splitlines():
            if line.startswith((" ", "\t")):
                continue
            stripped = line.strip()
            if not stripped or stripped.startswith("#") or ":" not in stripped:
                continue
            key, _, value = stripped.partition(":")
            key = key.strip().strip('"').strip("'")
            value = value.strip()
            if value[:1] in ("'", '"'):
                closing = value.find(value[0], 1)
                if closing != -1:
                    value = value[1:closing]
            else:
                value = value.split(" #", 1)[0].strip()
            if key:
                result[key] = value
        return result

    def _parse_py_meta(self, text):
        # python-metainfo: берём только литеральные присваивания верхнего уровня, код не исполняем
        try:
            tree = ast.parse(text)
        except Exception as e:
            log(f"[{__id__}] Failed to parse elyx py metainfo: {e}")
            return None
        meta = {}
        for node in tree.body:
            if isinstance(node, ast.Assign):
                targets = [t for t in node.targets if isinstance(t, ast.Name)]
            elif isinstance(node, ast.AnnAssign) and isinstance(node.target, ast.Name) and node.value is not None:
                targets = [node.target]
            else:
                continue
            try:
                value = ast.literal_eval(node.value)
            except Exception:
                continue
            for target in targets:
                meta[target.id] = value
        return meta

    def _parse_structured(self, raw, is_json, is_py=False):
        text = raw.decode("utf-8-sig", errors="replace")
        if is_py:
            return self._parse_py_meta(text)
        if is_json:
            try:
                return json.loads(text)
            except Exception as e:
                log(f"[{__id__}] Failed to parse elyx json: {e}")
                return None
        try:
            import yaml
            return yaml.safe_load(text)
        except ImportError:
            return self._parse_flat_mapping(text)
        except Exception as e:
            log(f"[{__id__}] Failed to parse elyx yaml: {e}")
            return None

    def _elyx_norm(self, path):
        text = str(path).replace("\\", "/")
        while text.startswith("./"):
            text = text[2:]
        return text.strip("/")

    def _read_elyx_refmap(self, names, read):
        for candidate in ELYX_REFMAP_NAMES:
            if candidate in names:
                raw = read(candidate)
                if raw is None:
                    return {}
                parsed = self._parse_structured(raw, candidate.endswith(".json"))
                return parsed if isinstance(parsed, dict) else {}
        return {}

    def _read_elyx_metainfo(self, names, read, refmap):
        meta_path = self._elyx_norm(refmap.get("metainfo") or "")
        if not meta_path or meta_path not in names:
            meta_path = next((c for c in ELYX_METAINFO_NAMES if c in names), None)
        if not meta_path:
            meta_path = next(
                (
                    n for n in sorted(names)
                    if n.count("/") <= 1 and n.rsplit("/", 1)[-1] in ELYX_METAINFO_NAMES
                ),
                None
            )
        if not meta_path:
            return None

        raw = read(meta_path)
        if raw is None:
            return None
        meta = self._parse_structured(raw, meta_path.endswith(".json"), meta_path.endswith(".py"))
        if not isinstance(meta, dict):
            return None

        normalised = {}
        for key, value in meta.items():
            clean_key = key.strip("_") if isinstance(key, str) else key
            normalised[clean_key] = value
        return normalised

    def _read_elyx_main_path(self, names, refmap):
        main_path = self._elyx_norm(refmap.get("main") or "")
        if main_path and main_path in names:
            return main_path
        return "main.py" if "main.py" in names else None

    def _elyx_is_compiled(self, meta):
        def truthy(value):
            return value is True or str(value).strip().lower() == "true"

        if not isinstance(meta, dict):
            return False
        if truthy(meta.get("compiled")):
            return True
        builder = meta.get("elyxbuilder")
        return isinstance(builder, dict) and truthy(builder.get("compiled"))

    def _scan_elyx_source(self, label, names, read):
        try:
            read = self._budgeted_reader(read)
            names_set = set(names)
            refmap = self._read_elyx_refmap(names_set, read)
            meta = self._read_elyx_metainfo(names_set, read, refmap)
            plugin_id = str(meta["id"]) if meta and meta.get("id") else None
            if not plugin_id:
                log(
                    f"[{__id__}] Elyx {label}: no plugin id in metainfo "
                    f"(refmap keys: {sorted(map(str, refmap))})"
                )
                return None, False, [], False

            main_rel = self._read_elyx_main_path(names_set, refmap)

            wheels_prefixes = {"wheels/"}
            custom_wheels = self._elyx_norm(refmap.get("wheels") or "")
            if custom_wheels:
                wheels_prefixes.add(custom_wheels + "/")
            inner_dir = self._elyx_norm(refmap.get("metainfo") or "").rpartition("/")[0]
            if inner_dir:
                wheels_prefixes.add(inner_dir + "/wheels/")
            wheels_prefixes = tuple(wheels_prefixes)

            def is_project_file(name):
                return (
                    not name.startswith(wheels_prefixes)
                    and "/.elyxbuilder/" not in "/" + name
                    and "/__pycache__/" not in "/" + name
                )

            py_names = [n for n in sorted(names_set) if n.endswith(".py") and is_project_file(n)]
            pyc_names = [
                n for n in sorted(names_set)
                if n.endswith(".pyc") and is_project_file(n) and n[:-1] not in names_set
            ]
            if main_rel and main_rel not in py_names:
                py_names.insert(0, main_rel)

            has_settings = False
            commands = set()
            parse_failed = False
            analysed = 0

            for name in py_names:
                raw = read(name)
                if raw is None:
                    continue
                try:
                    source = raw.decode("utf-8-sig", errors="replace")
                    tree = ast.parse(source, filename=name)
                except Exception as ast_err:
                    log(f"[{__id__}] AST parse failed for {label}::{name}: {ast_err}")
                    parse_failed = True
                    continue

                analysed += 1
                if not has_settings and _has_real_create_settings(tree):
                    has_settings = True

                visitor = _CommandVisitor()
                visitor.visit(tree)
                commands.update(visitor.commands)

            if pyc_names:
                parse_failed = True

            if not parse_failed and not has_settings and not commands:
                if analysed == 0 or self._elyx_is_compiled(meta):
                    parse_failed = True

            log(
                f"[{__id__}] Elyx {label}: id={plugin_id}, py={len(py_names)}, "
                f"pyc={len(pyc_names)}, analysed={analysed}, settings={has_settings}, "
                f"commands={len(commands)}, parse_failed={parse_failed}"
            )
            return plugin_id, has_settings, sorted(commands), parse_failed
        except Exception as e:
            log(f"[{__id__}] Failed to scan elyx source {label}: {e}")
            return None

    def _budgeted_reader(self, read):
        state = {"total": 0}

        def limited(name):
            if state["total"] >= ELYX_SCAN_MAX_TOTAL_BYTES:
                return None
            raw = read(name)
            if raw is not None:
                state["total"] += len(raw)
            return raw

        return limited

    def _scan_elyx_archive(self, file_path):
        try:
            with zipfile.ZipFile(file_path) as zf:
                names = [n for n in zf.namelist() if n.endswith(ELYX_SCAN_EXTS)]
                limited = sum(1 for n in names if n.endswith(ELYX_LIMIT_EXTS))
                if limited > ELYX_ARCHIVE_MAX_ENTRIES:
                    log(f"[{__id__}] Skipped archive {file_path}: {limited} scannable entries (limit {ELYX_ARCHIVE_MAX_ENTRIES})")
                    return None
                return self._scan_elyx_source(
                    os.path.basename(file_path),
                    names,
                    lambda name: self._read_zip_entry_capped(zf, name, MAX_FILE_SIZE)
                )
        except Exception as e:
            log(f"[{__id__}] Failed to scan elyx archive {file_path}: {e}")
            return None

    def _walk_elyx_dir(self, root):
        # names - только то, что сканер может прочитать (.py/.pyc/.yml/.yaml/.json);
        # newest/total считаем по всем файлам, чтобы замена любого файла меняла отпечаток папки.
        # в лимит ELYX_DIR_MAX_FILES идут только .py/.yml/.yaml/.json - ассеты обход не обрывают
        names = []
        newest = 0.0
        total = 0
        limited = 0
        for current, dirs, files in os.walk(root):
            dirs[:] = [d for d in dirs if d not in ELYX_SKIP_DIRS]
            for fname in files:
                full = os.path.join(current, fname)
                if os.path.islink(full):
                    continue
                try:
                    st = os.stat(full)
                except OSError:
                    continue
                newest = max(newest, st.st_mtime)
                total += st.st_size
                if not fname.endswith(ELYX_SCAN_EXTS):
                    continue
                names.append(os.path.relpath(full, root).replace(os.sep, "/"))
                if fname.endswith(ELYX_LIMIT_EXTS):
                    limited += 1
                    if limited >= ELYX_DIR_MAX_FILES:
                        log(f"[{__id__}] Elyx dir {root}: more than {ELYX_DIR_MAX_FILES} scannable files, stopping the walk")
                        return names, newest, total
        return names, newest, total

    def _scan_elyx_dir(self, dir_path, names):
        real_root = os.path.realpath(dir_path)

        def read(name):
            try:
                full = os.path.realpath(os.path.join(dir_path, *name.split("/")))
                if not self._is_path_inside_dir(full, real_root) or not os.path.isfile(full):
                    return None
                if os.path.getsize(full) > MAX_FILE_SIZE:
                    return None
                with open(full, "rb") as f:
                    return f.read()
            except OSError as e:
                log(f"[{__id__}] Elyx dir read failed for {dir_path}/{name}: {e}")
                return None

        return self._scan_elyx_source(os.path.basename(dir_path), names, read)

    def _scan_elyx_plugins(self, plugins_dir, old_cache):
        entries = {}
        parsed = 0
        reused = 0
        jobs = []

        try:
            for name in sorted(os.listdir(plugins_dir)):
                path = os.path.join(plugins_dir, name)
                if name.endswith(ELYX_EXTS) and os.path.isfile(path):
                    jobs.append((name, path, False))

            # по документации Elyx исходные архивы лежат в plugins/archives/
            docs_archives = os.path.join(plugins_dir, ELYX_ARCHIVES_DIRNAME)
            if os.path.isdir(docs_archives):
                for arch in sorted(os.listdir(docs_archives)):
                    arch_path = os.path.join(docs_archives, arch)
                    if arch.endswith(ELYX_EXTS) and os.path.isfile(arch_path):
                        jobs.append((f"{ELYX_ARCHIVES_DIRNAME}/{arch}", arch_path, False))

            root = os.path.join(plugins_dir, ELYX_PLUGINS_DIRNAME)
            if os.path.isdir(root):
                for name in sorted(os.listdir(root)):
                    path = os.path.join(root, name)
                    key = f"{ELYX_PLUGINS_DIRNAME}/{name}"
                    if os.path.isdir(path):
                        if name == ELYX_ARCHIVES_DIRNAME:
                            for arch in sorted(os.listdir(path)):
                                arch_path = os.path.join(path, arch)
                                if arch.endswith(ELYX_EXTS) and os.path.isfile(arch_path):
                                    jobs.append((f"{key}/{arch}", arch_path, False))
                        else:
                            jobs.append((key, path, True))
                    elif name.endswith(ELYX_EXTS) and os.path.isfile(path):
                        jobs.append((key, path, False))
        except Exception as e:
            log(f"[{__id__}] Elyx directory listing failed: {e}")

        jobs.sort(key=lambda job: job[2])

        for key, path, is_dir in jobs:
            entry, was_parsed, was_reused = self._scan_elyx_job(key, path, is_dir, old_cache.get(key))
            if entry is not None:
                entries[key] = entry
            parsed += was_parsed
            reused += was_reused

        log(f"[{__id__}] Elyx scan: {len(entries)} entries (parsed {parsed}, reused {reused}).")
        return entries, parsed, reused

    def _scan_elyx_job(self, key, path, is_dir, old):
        try:
            names = None
            if is_dir:
                names, mtime, size = self._walk_elyx_dir(path)
            else:
                stat = os.stat(path)
                mtime, size = stat.st_mtime, stat.st_size

            # лимит размера - только для архивов: распакованный плагин весит больше архива
            if not is_dir and size > MAX_ELYX_ARCHIVE_SIZE:
                log(f"[{__id__}] Skipped {key}: {size} bytes is too fat for elyx scan")
                return None, 0, 0

            if (
                isinstance(old, dict)
                and old.get("v") == CACHE_SCAN_VERSION
                and old.get("mtime") == mtime
                and old.get("size") == size
                and old.get("is_elyx") is True
            ):
                return old, 0, 1

            result = self._scan_elyx_dir(path, names) if is_dir else self._scan_elyx_archive(path)
            if not result:
                if isinstance(old, dict) and old.get("plugin_id"):
                    return old, 0, 0
                return None, 0, 0

            plugin_id, has_settings, commands, parse_failed = result
            if not plugin_id:
                return {
                    "v": CACHE_SCAN_VERSION,
                    "plugin_id": None,
                    "mtime": mtime,
                    "size": size,
                    "is_elyx": True
                }, 0, 0

            return {
                "v": CACHE_SCAN_VERSION,
                "plugin_id": plugin_id,
                "mtime": mtime,
                "size": size,
                "has_settings": has_settings,
                "commands": commands,
                "parse_failed": parse_failed,
                "is_elyx": True,
                "elyx_src": "dir" if is_dir else "archive"
            }, 1, 0
        except FileNotFoundError:
            return None, 0, 0
        except Exception as e:
            log(f"[{__id__}] Skipped {key}: {e}")
            if isinstance(old, dict) and old.get("plugin_id"):
                return old, 0, 0
            return None, 0, 0

    def _find_elyx_paths(self, plugin_id, src):
        plugins_dir = get_plugins_dir()
        if not plugins_dir:
            return []
        with self._cache_lock:
            items = list(self.file_cache.items())
        found = []
        for key, entry in items:
            if (
                not isinstance(entry, dict)
                or entry.get("plugin_id") != plugin_id
                or entry.get("is_elyx") is not True
                or entry.get("elyx_src") != src
            ):
                continue
            path = os.path.join(plugins_dir, *key.split("/"))
            if (src == "dir" and os.path.isdir(path)) or (src == "archive" and os.path.isfile(path)):
                found.append(path)
        if src == "archive":
            found.sort(key=self._mtime_or_zero, reverse=True)
        return found

    @safe(default=0.0, msg="mtime read failed", notify=False)
    def _mtime_or_zero(self, path):
        return os.path.getmtime(path)

    def _force_remove_elyx_plugin(self, plugin_id, plugin_path, real_path, real_plugins_dir):
        elyx_root = os.path.join(real_plugins_dir, ELYX_PLUGINS_DIRNAME)
        archives_root = os.path.join(elyx_root, ELYX_ARCHIVES_DIRNAME)
        if (
            os.path.islink(plugin_path)
            or os.path.dirname(real_path) != elyx_root
            or real_path == archives_root
            or not any(name in ELYX_REFMAP_NAMES for name in os.listdir(real_path))
        ):
            log(f"[{__id__}] Refusing to remove {plugin_path}: not an installed elyx plugin folder")
            return False

        if not self._rmtree_guarded(real_path, elyx_root, "elyx plugin folder"):
            return False
        log(f"[{__id__}] Manually removed elyx plugin folder: {real_path}")
        self._drop_from_registry(plugin_id)
        return not self._plugin_still_exists(plugin_id)

    def _remove_elyx_local_libs(self, plugin_id, plugins_dir):
        if not plugins_dir or not plugin_id:
            return
        try:
            if plugin_id in (".", "..") or "/" in plugin_id or "\\" in plugin_id:
                log(f"[{__id__}] Refusing to remove elyx local libs for suspicious id {plugin_id!r}")
                return
            real_plugins_dir = os.path.realpath(plugins_dir)
            libs_root = os.path.join(real_plugins_dir, ELYX_LOCAL_LIBS_DIRNAME)
            target = os.path.join(libs_root, plugin_id)
            if os.path.islink(target) or not os.path.isdir(target):
                return
            if os.path.dirname(os.path.realpath(target)) != os.path.realpath(libs_root):
                log(f"[{__id__}] Refusing to remove {target}: outside elyx local libs")
                return
            if self._rmtree_guarded(target, libs_root, "elyx local libs"):
                log(f"[{__id__}] Removed elyx local libs: {target}")
        except Exception as e:
            log(f"[{__id__}] Failed to remove elyx local libs for {plugin_id}: {e}")

    def _remove_elyx_archives(self, archive_paths, plugins_dir):
        if not ELYX_DELETE_ARCHIVES or not plugins_dir:
            return
        real_plugins_dir = os.path.realpath(plugins_dir)
        for path in archive_paths:
            try:
                real = os.path.realpath(path)
                if (
                    os.path.islink(path)
                    or not os.path.isfile(real)
                    or not self._is_path_inside_dir(real, real_plugins_dir)
                    or not real.endswith(ELYX_EXTS)
                ):
                    continue
                os.remove(real)
                log(f"[{__id__}] Removed elyx source archive: {real}")
            except Exception as e:
                log(f"[{__id__}] Failed to remove elyx archive {path}: {e}")

    def _plugin_is_elyx(self, plugin_id, plugin_obj=None):
        info = self._get_plugin_info(plugin_id)
        if info is not None and "is_elyx" in info:
            return info.get("is_elyx", False)

        # кэша ещё нет (свежепоставленный плагин) - смотрим на сам объект, без похода на диск.
        # у elyx-плагина объекта .file нет: его отсутствие и есть признак elyx
        if plugin_obj is None:
            plugin_obj = self._get_plugin_obj(plugin_id)
        if plugin_obj is None:
            return False
        try:
            file_obj = getattr(plugin_obj, "file", None) if hasattr(plugin_obj, "file") else None
        except Exception as e:
            log(f"[{__id__}] Failed to read file of {plugin_id} for elyx check: {e}")
            return False
        if file_obj is None:
            return True
        try:
            path = file_obj.getAbsolutePath()
            if path:
                return str(path).endswith(ELYX_EXTS)
        except Exception as e:
            log(f"[{__id__}] Failed to resolve file for elyx check {plugin_id}: {e}")
        return False


# ====================================================================
# QPS DEBUG
# debug-сессия: логи, пробы файловой системы, хуки, отправка в Избранное
# ====================================================================
class DebugMixin:
    @safe(default=None, msg="Debug dir failed", notify=False)
    def _dbg_dir(self):
        if not self.cache_path:
            return None
        return os.path.join(os.path.dirname(self.cache_path), DEBUG_DIRNAME)

    def _dbg_ext(self):
        if self.get_setting("debug_log_format", 1) == 0:
            return ".md"
        return ".txt"

    def _dbg_emit(self, tag, text):
        recorder = self._dbg_recorder
        if recorder is not None:
            recorder.emit(tag, text)

    @safe(default="<unprintable>", msg="Value format failed", notify=False)
    def _dbg_to_text(self, value):
        return str(value)

    def _dbg_fmt(self, value, limit=300):
        text = self._dbg_to_text(value).replace("\n", "\\n")
        if len(text) > limit:
            return text[:limit] + "..."
        return text

    @safe(default=None, msg="Time format failed", notify=False)
    def _dbg_format_time(self, stamp):
        return time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(stamp))

    def _dbg_human_time(self, stamp):
        return self._dbg_format_time(stamp) or str(stamp)

    def _on_debug_toggle(self, value):
        if value:
            self._submit(self._dbg_start, "debug_start")
        else:
            self._submit(self._dbg_stop, "debug_stop")

    @safe(msg="Debug boot failed", notify=False)
    def _dbg_boot(self):
        self._dbg_check_previous_session()
        self._dbg_start()

    @safe(msg="Debug rotate failed", notify=False)
    def _dbg_rotate(self, directory, keep):
        files = [
            os.path.join(directory, name)
            for name in os.listdir(directory)
            if name.endswith((".md", ".txt")) and not name.startswith("pending_")
        ]
        files.sort(key=os.path.getmtime, reverse=True)
        for old in files[keep:]:
            try:
                os.remove(old)
            except Exception as e:
                log(f"[{__id__}] Failed to rotate {old}: {e}")

    @safe(msg="Debug sessions rotate failed", notify=False)
    def _dbg_rotate_sessions(self, directory, keep):
        groups = {}
        for name in os.listdir(directory):
            if name.endswith(DEBUG_SEGMENT_EXT):
                groups.setdefault(name.rsplit(".", 2)[0], []).append(os.path.join(directory, name))
        ordered = sorted(groups.values(), key=lambda paths: max(os.path.getmtime(p) for p in paths), reverse=True)
        for paths in ordered[keep:]:
            self._dbg_discard(paths)

    @staticmethod
    def _dbg_discard(paths):
        for path in paths:
            try:
                os.remove(path)
            except OSError as e:
                log(f"[{__id__}] Failed to drop {path}: {e}")

    @safe(default=False, msg="Debug start failed", notify=False)
    def _dbg_start(self):
        with self._dbg_lock:
            if self._dbg_running:
                return True
            debug_dir = self._dbg_dir()
            if not debug_dir:
                return False
            sent_dir = os.path.join(debug_dir, DEBUG_SENT_DIRNAME)
            os.makedirs(sent_dir, exist_ok=True)
            self._dbg_rotate(debug_dir, 0)
            self._dbg_rotate(sent_dir, 0)
            self._dbg_rotate_sessions(debug_dir, DEBUG_KEEP_SESSIONS - 1)
            path = os.path.join(debug_dir, "QPS_debug_" + time.strftime("%Y%m%d_%H%M%S"))
            recorder = DebugRecorder()
            recorder.auto_send = bool(self.get_setting("debug_auto_send", False))
            recorder.on_event = self._dbg_on_ring_event
            recorder.open(path)
            self._dbg_recorder = recorder
            _DEBUG_STATE["recorder"] = recorder
            self._dbg_stop_event = threading.Event()
            self._dbg_hook_counts = {}
            self._dbg_account = self._dbg_current_account()
            self._dbg_running = True
            marker_tmp = os.path.join(debug_dir, "session.json.tmp")
            with open(marker_tmp, "w", encoding="utf-8") as f:
                json.dump(
                    {"started_ms": int(time.time() * 1000), "log_path": path, "pid": os.getpid(), "account": self._dbg_account},
                    f
                )
            os.replace(marker_tmp, os.path.join(debug_dir, "session.json"))
        self._dbg_emit("SESSION", f"start [{__id__}] version={__version__}")
        self._dbg_probe_env()
        self._dbg_install_excepthook()
        self._dbg_install_hooks()
        self._dbg_baseline()
        for target, name in ((self._dbg_logcat_loop, "QPSDebugLogcat"), (self._dbg_watch_loop, "QPSDebugWatch")):
            thread = threading.Thread(target=target, name=name, daemon=True)
            self._dbg_threads.append(thread)
            thread.start()
        self._dbg_request_probe("session-start", 0.2)
        return True

    @safe(msg="Debug stop failed", notify=False)
    def _dbg_stop(self, clean=True):
        with self._dbg_lock:
            if not self._dbg_running:
                return
            self._dbg_running = False
            self._dbg_stop_event.set()
        with self._dbg_probe_lock:
            self._cancel_timer(self._dbg_probe_timer)
            self._dbg_probe_timer = None
        self._dbg_emit("SESSION", "stop requested")
        proc = self._dbg_proc
        self._dbg_proc = None
        if proc is not None:
            self._dbg_stop_proc(proc)
        for handle in self._dbg_unhooks:
            try:
                self.unhook_method(handle)
            except Exception as e:
                log(f"[{__id__}] debug unhook failed: {e}")
        self._dbg_unhooks = []
        self._dbg_account = None
        self._dbg_threads = []
        self._dbg_remove_excepthook()
        recorder = self._dbg_recorder
        self._dbg_recorder = None
        _DEBUG_STATE["recorder"] = None
        if recorder is not None:
            recorder.close()
        debug_dir = self._dbg_dir()
        if clean and debug_dir:
            marker = os.path.join(debug_dir, "session.json")
            if os.path.isfile(marker):
                os.remove(marker)

    @safe(msg="Installing excepthook failed", notify=False)
    def _dbg_install_excepthook(self):
        if self._dbg_hook_fn is not None:
            return
        plugin_ref = weakref.ref(self)
        previous = threading.excepthook
        state = {"active": True}

        @guard(msg="Thread excepthook report failed")
        def report(args):
            plugin = plugin_ref()
            if not state["active"] or plugin is None:
                return
            if not _thread_error_is_ours(args):
                return
            tb = "".join(traceback.format_exception(args.exc_type, args.exc_value, args.exc_traceback))
            name = args.thread.name if args.thread is not None else "?"
            log(f"[{__id__}] Uncaught exception in thread {name}: {tb}")
            plugin._dbg_report_error(f"thread-crash:{name}:{getattr(args.exc_type, '__name__', '?')}")

        def hook(args):
            report(args)
            previous(args)

        hook._qps_state = state
        self._dbg_prev_excepthook = previous
        self._dbg_hook_fn = hook
        threading.excepthook = hook

    @safe(msg="Removing excepthook failed", notify=False)
    def _dbg_remove_excepthook(self):
        if self._dbg_hook_fn is None:
            return
        if threading.excepthook is self._dbg_hook_fn:
            threading.excepthook = self._dbg_prev_excepthook
        else:
            # нас обернул кто-то другой и снять хук нельзя — гасим его, он просто зовёт previous
            state = getattr(self._dbg_hook_fn, "_qps_state", None)
            if state is not None:
                state["active"] = False
        self._dbg_hook_fn = None
        self._dbg_prev_excepthook = None

    @safe(default=None, msg="Account resolve failed", notify=False)
    def _dbg_current_account(self):
        return int(get_selected_account())

    @safe(msg="Debug report failed", notify=False)
    def _dbg_report_error(self, label):
        account = self._dbg_account
        if not self._dbg_running or self._unloaded or account is None:
            return
        now = time.time()
        with self._dbg_report_lock:
            if now - self._dbg_last_report < DEBUG_REPORT_GAP:
                return
            if now - self._dbg_report_sigs.get(label, 0) < DEBUG_REPORT_SAME_GAP:
                return
            self._dbg_last_report = now
            self._dbg_report_sigs[label] = now
        self._submit(lambda: self._dbg_send("qps-error: " + label, account=account), "debug_report")

    @safe(msg="Environment probe failed", notify=False)
    def _dbg_probe_env(self):
        self._dbg_emit("ENV", f"python={sys.version.split()[0]} pyyaml={'yes' if importlib.util.find_spec('yaml') else 'NO'}")
        try:
            from android.os import Build
            self._dbg_emit("ENV", f"android={Build.VERSION.RELEASE} sdk_int={Build.VERSION.SDK_INT} abis={list(Build.SUPPORTED_ABIS)} model={Build.MODEL}")
        except Exception as e:
            self._dbg_emit("ENV", f"android build info failed: {self._dbg_fmt(e, 200)}")
        try:
            context = ApplicationLoader.applicationContext
            package = str(context.getPackageName())
            version = context.getPackageManager().getPackageInfo(package, 0).versionName
            self._dbg_emit("ENV", f"package={package} versionName={version}")
        except Exception as e:
            self._dbg_emit("ENV", f"app version failed: {self._dbg_fmt(e, 200)}")
        self._dbg_emit("ENV", f"plugins_dir={get_plugins_dir()}")
        self._dbg_emit("ENV", f"qps_cache_path={self.cache_path}")
        self._dbg_emit("ENV", f"qps={__version__} scans plugins_dir root only, extensions={('.py', '.plugin') + ELYX_EXTS}")
        values = []
        for key in DEBUG_SETTING_KEYS:
            values.append(f"{key}={self.get_setting(key, None)}")
        self._dbg_emit("SETTINGS", " ".join(values))

    @safe(default=None, msg="FS snapshot failed", notify=False)
    def _dbg_snapshot_fs(self):
        base = get_plugins_dir()
        result = {}
        if not base or not os.path.isdir(base):
            return result
        base = os.path.normpath(base)
        for root, dirs, files in os.walk(base):
            depth = root[len(base):].count(os.sep)
            if depth >= DEBUG_FS_WALK_DEPTH:
                dirs[:] = []
            for name in files:
                full = os.path.join(root, name)
                try:
                    stat = os.stat(full)
                except OSError:
                    continue
                result[os.path.relpath(full, base)] = (stat.st_size, int(stat.st_mtime))
                if len(result) >= DEBUG_FS_MAX_ENTRIES:
                    return result
            for name in dirs:
                result[os.path.relpath(os.path.join(root, name), base) + "/"] = (0, 0)
        return result

    @safe(default=None, msg="Controller enumeration failed", notify=False)
    def _dbg_controller_entries(self):
        plugins = PluginsController.getInstance().plugins
        if hasattr(plugins, "keySet"):
            keys = list(plugins.keySet().toArray())
        else:
            keys = list(plugins.keys())
        return [(str(key), plugins.get(key)) for key in keys]

    def _dbg_describe_plugin(self, plugin_obj):
        info = {"class": type(plugin_obj).__name__, "enabled": None, "path": None, "has_file_attr": hasattr(plugin_obj, "file")}
        try:
            info["enabled"] = bool(self._is_plugin_enabled(plugin_obj))
        except Exception as e:
            info["enabled"] = f"error: {self._dbg_fmt(e, 100)}"
        if info["has_file_attr"]:
            try:
                info["path"] = str(plugin_obj.file.getAbsolutePath())
            except Exception as e:
                info["path"] = f"error: {self._dbg_fmt(e, 100)}"
        return info

    @safe(default=None, msg="Filesystem probe failed", notify=False)
    def _dbg_probe_fs(self):
        archives = []
        base = get_plugins_dir()
        self._dbg_emit("FS", f"plugins_dir={base} exists={bool(base) and os.path.isdir(base)}")
        if not base or not os.path.isdir(base):
            return archives
        for entry in sorted(os.listdir(base)):
            full = os.path.join(base, entry)
            is_dir = os.path.isdir(full)
            try:
                stat = os.stat(full)
                meta = f"size={stat.st_size} mtime={self._dbg_human_time(stat.st_mtime)}"
            except OSError as e:
                meta = f"stat failed: {e}"
            if is_dir:
                verdict = "-"
            elif entry.endswith(('.py', '.plugin') + ELYX_EXTS):
                verdict = "QPS-scans"
            else:
                verdict = "ignored-by-QPS"
            self._dbg_emit("FS", f"[root] {'dir ' if is_dir else 'file'} {entry} {meta} {verdict}")
        for entry in sorted(os.listdir(base)):
            full = os.path.join(base, entry)
            if not os.path.isdir(full):
                continue
            try:
                children = sorted(os.listdir(full))
            except OSError as e:
                self._dbg_emit("FS", f"[{entry}/] listdir failed: {e}")
                continue
            self._dbg_emit("FS", f"[{entry}/] {len(children)} entries: {', '.join(children[:60])}")
        for root, dirs, files in os.walk(base):
            depth = root[len(base):].count(os.sep)
            if depth >= DEBUG_FS_WALK_DEPTH + 1:
                dirs[:] = []
            for name in files:
                if name.endswith(ELYX_EXTS):
                    full = os.path.join(root, name)
                    archives.append(full)
                    if root == base:
                        location = "plugins root"
                    elif os.path.relpath(root, base) == ELYX_ARCHIVES_DIRNAME:
                        location = "plugins/archives/ (Elyx docs location)"
                    elif os.path.relpath(root, base) == f"{ELYX_PLUGINS_DIRNAME}/{ELYX_ARCHIVES_DIRNAME}":
                        location = "ElyxPlugins/archives/ (QPS cache key is the relative path)"
                    else:
                        location = "nested (QPS cache key is the relative path)"
                    self._dbg_emit("FS", f"elyx archive found: {os.path.relpath(full, base)} -> {location}")
        if not archives:
            self._dbg_emit("FS", "NO elyx archives (.elyx/.eaf/.elyx.zip/.eaf.zip) found anywhere under plugins_dir")
        return archives

    @safe(msg="Archive probe failed", notify=False)
    def _dbg_probe_archives(self, archives):
        base = get_plugins_dir()
        for path in archives[:DEBUG_MAX_ARCHIVES]:
            rel = os.path.relpath(path, base)
            try:
                stat = os.stat(path)
                self._dbg_emit("ARCHIVE", f"{rel}: size={stat.st_size} mtime={self._dbg_human_time(stat.st_mtime)}")
                with zipfile.ZipFile(path) as zf:
                    names = zf.namelist()
                top = sorted(set(n.split("/")[0] for n in names))
                self._dbg_emit("ARCHIVE", f"{rel}: {len(names)} entries, top-level: {', '.join(top[:40])}")
                scanned = self._scan_elyx_archive(path)
                if scanned and scanned[0]:
                    self._dbg_emit("ARCHIVE", f"{rel}: QPS VERDICT: would register plugin_id={scanned[0]} has_settings={scanned[1]} commands={len(scanned[2])} parse_failed={scanned[3]}")
                else:
                    self._dbg_emit("ARCHIVE", f"{rel}: QPS VERDICT: NOT recognised as a plugin")
            except Exception:
                self._dbg_emit("ARCHIVE", f"{rel}: analysis crashed\n{traceback.format_exc()}")
        elyx_dir = os.path.join(base, "ElyxPlugins")
        if not os.path.isdir(elyx_dir):
            return
        for name in sorted(os.listdir(elyx_dir)):
            full = os.path.join(elyx_dir, name)
            if not os.path.isdir(full) or name == ELYX_ARCHIVES_DIRNAME:
                continue
            try:
                names, newest, total = self._walk_elyx_dir(full)
                top = sorted(set(n.split("/")[0] for n in names))
                self._dbg_emit("EXTRACTED", f"ElyxPlugins/{name}: {len(names)} scannable files, {total} bytes, top-level: {', '.join(top[:40])}")
                scanned = self._scan_elyx_dir(full, names)
                if scanned and scanned[0]:
                    self._dbg_emit("EXTRACTED", f"ElyxPlugins/{name}: QPS VERDICT: plugin_id={scanned[0]} has_settings={scanned[1]} commands={len(scanned[2])} parse_failed={scanned[3]}")
                else:
                    self._dbg_emit("EXTRACTED", f"ElyxPlugins/{name}: QPS VERDICT: NOT recognised as a plugin")
            except Exception:
                self._dbg_emit("EXTRACTED", f"ElyxPlugins/{name}: analysis crashed\n{traceback.format_exc()}")

    @safe(default=None, msg="Controller probe failed", notify=False)
    def _dbg_probe_controller(self):
        result = {}
        entries = self._dbg_controller_entries()
        if entries is None:
            self._dbg_emit("CTRL", "cannot enumerate PluginsController.plugins")
            return result
        self._dbg_emit("CTRL", f"PluginsController.plugins: {len(entries)} plugins")
        for plugin_id, plugin_obj in sorted(entries, key=lambda item: item[0]):
            info = self._dbg_describe_plugin(plugin_obj)
            path = info["path"]
            info["elyx_by_ext"] = bool(path) and str(path).endswith(ELYX_EXTS)
            info["path_exists"] = bool(path) and os.path.exists(str(path))
            result[plugin_id] = info
            self._dbg_emit(
                "CTRL",
                f"id={plugin_id} class={info['class']} enabled={info['enabled']} "
                f"file_attr={info['has_file_attr']} path={path} exists={info['path_exists']} "
                f"QPS_is_elyx={info['elyx_by_ext']}"
            )
        return result

    @safe(msg="QPS cache probe failed", notify=False)
    def _dbg_probe_cache(self, controller_info, archives):
        path = self.cache_path
        if not path or not os.path.isfile(path):
            self._dbg_emit("QPSCACHE", f"QPS cache file missing: {path}")
            return
        stat = os.stat(path)
        with open(path, "r", encoding="utf-8") as handle:
            data = json.load(handle)
        if not isinstance(data, dict):
            self._dbg_emit("QPSCACHE", f"unexpected cache root type: {type(data).__name__}")
            return
        self._dbg_emit("QPSCACHE", f"file mtime={self._dbg_human_time(stat.st_mtime)} size={stat.st_size} entries={len(data)}")
        cached_ids = set()
        base = get_plugins_dir()
        elyx_entries = 0
        for filename in sorted(data):
            entry = data[filename]
            if not isinstance(entry, dict):
                self._dbg_emit("QPSCACHE", f"{filename}: unexpected entry {self._dbg_fmt(entry, 100)}")
                continue
            plugin_id = entry.get("plugin_id")
            if plugin_id:
                cached_ids.add(plugin_id)
            if entry.get("is_elyx"):
                elyx_entries += 1
            exists = os.path.exists(os.path.join(base, filename)) if base else None
            commands = entry.get("commands") or []
            self._dbg_emit(
                "QPSCACHE",
                f"{filename}: plugin_id={plugin_id} is_elyx={entry.get('is_elyx')} has_settings={entry.get('has_settings')} "
                f"commands={len(commands)} parse_failed={entry.get('parse_failed')} size={entry.get('size')} "
                f"mtime={self._dbg_human_time(entry.get('mtime') or 0)} file_exists={exists}"
            )
        self._dbg_emit("QPSCACHE", f"elyx entries in QPS cache: {elyx_entries}")
        for plugin_id, info in sorted((controller_info or {}).items()):
            if plugin_id not in cached_ids:
                self._dbg_emit("CHECK", f"MISSING IN QPS CACHE: controller plugin id={plugin_id} path={info.get('path')} QPS_is_elyx={info.get('elyx_by_ext')}")

    @safe(msg="Debug baseline failed", notify=False)
    def _dbg_baseline(self):
        self._dbg_last_fs = self._dbg_snapshot_fs() or {}
        self._dbg_last_ctrl_state = self._dbg_controller_state()
        self._dbg_last_cache_stamp = self._dbg_cache_stamp()

    def _dbg_cache_stamp(self):
        if not self.cache_path:
            return None
        try:
            stat = os.stat(self.cache_path)
            return (int(stat.st_mtime), stat.st_size)
        except OSError:
            return None

    def _dbg_controller_state(self):
        state = {}
        for plugin_id, plugin_obj in (self._dbg_controller_entries() or []):
            info = self._dbg_describe_plugin(plugin_obj)
            state[plugin_id] = (info["enabled"], info["path"])
        return state

    @safe(msg="Debug logcat loop failed", notify=False)
    def _dbg_logcat_loop(self):
        try:
            proc = subprocess.Popen(
                ["logcat", "-v", "threadtime"],
                stdin=subprocess.DEVNULL,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                universal_newlines=True,
                errors="replace",
                bufsize=1
            )
        except Exception as e:
            self._dbg_emit("LOGCAT", f"cannot start logcat: {type(e).__name__}: {e}")
            return
        self._dbg_proc = proc
        stop_event = self._dbg_stop_event
        if stop_event.is_set():
            self._dbg_stop_proc(proc)
            return
        self._dbg_emit("LOGCAT", f"capturing logcat lines matching /{DEBUG_LOGCAT_RE.pattern}/ (backlog first, then live)")
        try:
            for line in proc.stdout:
                if stop_event.is_set():
                    break
                if DEBUG_SELF_TAG in line:
                    continue
                if DEBUG_LOGCAT_RE.search(line):
                    self._dbg_emit("LC", line.rstrip())
        except Exception as e:
            if not stop_event.is_set():
                self._dbg_emit("LOGCAT", f"reader stopped: {type(e).__name__}: {e}")
        finally:
            self._dbg_stop_proc(proc)

    @safe(msg="logcat stop failed", notify=False)
    def _dbg_stop_proc(self, proc):
        if proc.poll() is not None:
            return
        proc.terminate()
        try:
            proc.wait(timeout=2.0)
        except subprocess.TimeoutExpired:
            log(f"[{__id__}] logcat did not exit on terminate, killing")
            proc.kill()

    @safe(msg="Debug watch loop failed", notify=False)
    def _dbg_watch_loop(self):
        stop_event = self._dbg_stop_event
        while not stop_event.wait(DEBUG_WATCH_INTERVAL):
            self._dbg_watch_tick()

    @safe(msg="Debug watch tick failed", notify=False)
    def _dbg_watch_tick(self):
        changed = False
        current_fs = self._dbg_snapshot_fs() or {}
        lines = []
        for rel in sorted(set(current_fs) | set(self._dbg_last_fs)):
            before = self._dbg_last_fs.get(rel)
            after = current_fs.get(rel)
            if before is None:
                lines.append(f"ADDED   {rel} size={after[0]}")
            elif after is None:
                lines.append(f"REMOVED {rel}")
            elif before != after and not rel.endswith("/"):
                lines.append(f"CHANGED {rel} size {before[0]}->{after[0]}")
        if lines:
            changed = True
            self._dbg_emit("WATCH", "plugins_dir change:\n" + "\n".join(lines[:60]))
        self._dbg_last_fs = current_fs

        current_ctrl = self._dbg_controller_state()
        lines = []
        for plugin_id in sorted(set(current_ctrl) | set(self._dbg_last_ctrl_state)):
            before = self._dbg_last_ctrl_state.get(plugin_id)
            after = current_ctrl.get(plugin_id)
            if before is None:
                lines.append(f"CONTROLLER ADDED {plugin_id} enabled={after[0]} path={after[1]}")
            elif after is None:
                lines.append(f"CONTROLLER REMOVED {plugin_id}")
            elif before != after:
                lines.append(f"CONTROLLER CHANGED {plugin_id} {before} -> {after}")
        if lines:
            changed = True
            self._dbg_emit("WATCH", "\n".join(lines[:60]))
        self._dbg_last_ctrl_state = current_ctrl

        stamp = self._dbg_cache_stamp()
        if stamp != self._dbg_last_cache_stamp:
            self._dbg_emit("WATCH", f"QPS cache file changed {self._dbg_last_cache_stamp} -> {stamp}")
            self._dbg_last_cache_stamp = stamp
            self._dbg_probe_cache(self._dbg_last_controller, self._dbg_last_archives)
        if changed:
            self._dbg_request_probe("watcher", DEBUG_PROBE_DEBOUNCE)

    @safe(msg="Debug probe request failed", notify=False)
    def _dbg_request_probe(self, reason, delay=DEBUG_PROBE_DEBOUNCE):
        if not self._dbg_running:
            return
        with self._dbg_probe_lock:
            self._cancel_timer(self._dbg_probe_timer)
            timer = threading.Timer(delay, self._dbg_run_probe, args=(reason,))
            timer.daemon = True
            self._dbg_probe_timer = timer
            timer.start()

    @safe(msg="Debug probe failed", notify=False)
    def _dbg_run_probe(self, reason):
        if not self._dbg_running:
            return
        if not self._dbg_probe_run_lock.acquire(blocking=False):
            self._dbg_request_probe(reason, 1.0)
            return
        try:
            self._dbg_emit("PROBE", f"==== probe start, reason={reason} ====")
            self._dbg_run_probe_steps()
            self._dbg_emit("PROBE", "==== probe end ====")
        finally:
            self._dbg_probe_run_lock.release()

    @safe(msg="Debug probe steps failed", notify=False)
    def _dbg_run_probe_steps(self):
        self._dbg_last_archives = self._dbg_probe_fs() or []
        self._dbg_probe_archives(self._dbg_last_archives)
        self._dbg_last_controller = self._dbg_probe_controller() or {}
        self._dbg_probe_cache(self._dbg_last_controller, self._dbg_last_archives)

    @safe(msg="Debug install hooks failed", notify=False)
    def _dbg_install_hooks(self):
        cls = PluginsController.getClass()
        methods = list(cls.getDeclaredMethods())
        catalog = []
        names = []
        for method in methods:
            name = str(method.getName())
            params = ", ".join(str(t.getSimpleName()) for t in method.getParameterTypes())
            catalog.append(f"{name}({params})")
            if "$" in name or name in names:
                continue
            if DEBUG_HOOK_NAME_RE.search(name) and not DEBUG_HOOK_EXCLUDE_RE.match(name):
                names.append(name)
        self._dbg_emit("HOOKS", f"PluginsController declared methods ({len(catalog)}):\n" + "\n".join(sorted(catalog)))
        wanted = set(names[:DEBUG_MAX_HOOKED_NAMES])
        handler = DebugEventHook(self)
        counts = {}
        for method in methods:
            name = str(method.getName())
            if name not in wanted:
                continue
            try:
                handle = self.hook_method(method, handler)
                if handle:
                    self._dbg_unhooks.append(handle)
                    counts[name] = counts.get(name, 0) + 1
                else:
                    self._dbg_emit("HOOKS", f"hook_method returned nothing for {name}")
            except Exception as e:
                self._dbg_emit("HOOKS", f"failed to hook {name}: {self._dbg_fmt(e, 200)}")
        hooked = ", ".join(f"{name} x{count}" for name, count in sorted(counts.items()))
        self._dbg_emit("HOOKS", "hooked: " + (hooked or "nothing"))

    def _dbg_fmt_hook_value(self, value):
        if value is None or isinstance(value, (bool, int, float, str)):
            return self._dbg_fmt(value, 200)
        return "<" + type(value).__name__ + ">"

    @safe(default=None, msg="Hook throwable read failed", notify=False)
    def _dbg_thrown(self, param):
        return param.getThrowable()

    @safe(msg="Debug hook logging failed", notify=False)
    def _dbg_on_hook(self, phase, param):
        if not self._dbg_running:
            return
        name = str(param.method.getName())
        count = self._dbg_hook_counts.get(name, 0) + 1
        self._dbg_hook_counts[name] = count
        if count > DEBUG_HOOK_LOG_LIMIT:
            if count == DEBUG_HOOK_LOG_LIMIT + 1:
                self._dbg_emit("HOOK", f"{name}: further calls suppressed")
            return
        thread = threading.current_thread().name
        if phase == "BEFORE":
            args = list(param.args) if param.args is not None else []
            self._dbg_emit("HOOK", f"{phase} {name}({', '.join(self._dbg_fmt_hook_value(a) for a in args)}) thread={thread}")
            return
        thrown = self._dbg_thrown(param)
        suffix = f" THREW {self._dbg_fmt(thrown, 300)}" if thrown is not None else ""
        self._dbg_emit("HOOK", f"{phase} {name} -> {self._dbg_fmt_hook_value(param.getResult())}{suffix} thread={thread}")
        self._dbg_request_probe(f"after:{name}")

    @safe(default=None, msg="Logcat dump failed", notify=False)
    def _dbg_logcat_dump(self, include_crash):
        main_lines = []
        crash_lines = []
        try:
            res = subprocess.run(
                ["logcat", "-d", "-v", "threadtime", "-t", str(DEBUG_LOGCAT_DUMP_LINES)],
                stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=15
            )
            text = res.stdout.decode("utf-8", "replace")
            main_lines = [ln for ln in text.splitlines() if DEBUG_LOGCAT_RE.search(ln) and DEBUG_SELF_TAG not in ln]
        except Exception as e:
            main_lines = [f"logcat failed: {e}"]
        if include_crash:
            try:
                res = subprocess.run(
                    ["logcat", "-d", "-b", "crash", "-v", "threadtime", "-t", "800"],
                    stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=15
                )
                crash_lines = res.stdout.decode("utf-8", "replace").splitlines()
            except Exception as e:
                crash_lines = [f"logcat crash buffer failed: {e}"]
        return main_lines, crash_lines

    @safe(default=None, msg="Debug oneshot failed", notify=False)
    def _dbg_oneshot(self):
        debug_dir = self._dbg_dir()
        if not debug_dir:
            return None
        os.makedirs(debug_dir, exist_ok=True)
        prefix = os.path.join(debug_dir, "QPS_oneshot")
        self._dbg_discard(_segment_paths(prefix))
        recorder = DebugRecorder()
        with self._dbg_lock:
            if self._dbg_running:
                return None
            recorder.open(prefix)
            self._dbg_recorder = recorder
        try:
            self._dbg_emit("SESSION", f"one-shot snapshot (debug session is not running) version={__version__}")
            self._dbg_probe_env()
            self._dbg_run_probe_steps()
            main_lines, crash_lines = self._dbg_logcat_dump(False)
            for line in main_lines or []:
                self._dbg_emit("LC", line)
        finally:
            with self._dbg_lock:
                if self._dbg_recorder is recorder:
                    self._dbg_recorder = None
            recorder.close()
        return _segment_paths(prefix)

    @staticmethod
    def _dbg_path_inside(path, root):
        try:
            real_path = os.path.realpath(str(path))
            real_root = os.path.realpath(str(root))
            return os.path.commonpath([real_path, real_root]) == real_root
        except Exception:
            return False

    # safe тут, а не на _dbg_path_inside: поверх staticmethod он делал fn(self, path, root) -> TypeError -> None
    @safe(default=None, msg="Debug snapshot build failed", notify=False)
    def _dbg_build_snapshot(self, reason, sources, extra_text="", pending=False, account=None):
        debug_dir = self._dbg_dir()
        if not debug_dir or not sources:
            return None
        checked = []
        for source in sources:
            if not os.path.isfile(source):
                continue
            if not self._dbg_path_inside(source, debug_dir):
                log(f"[{__id__}] [DEBUG] refusing log path outside debug dir: {source}")
                return None
            checked.append(source)
        if not checked:
            return None
        ext = self._dbg_ext()
        if pending:
            target_dir = debug_dir
            name = f"pending_a{account}_QPS_log_" + time.strftime("%Y%m%d_%H%M%S") + ext
        else:
            target_dir = os.path.join(debug_dir, DEBUG_SENT_DIRNAME)
            os.makedirs(target_dir, exist_ok=True)
            self._dbg_rotate(target_dir, 1)
            name = "QPS_log_" + time.strftime("%Y%m%d_%H%M%S") + ext
        size = sum(os.path.getsize(source) for source in checked)
        header = [
            f"plugin: {__id__} {__version__}",
            f"reason: {reason}",
            f"time: {time.strftime('%Y-%m-%d %H:%M:%S')}",
            f"source: {len(checked)} segment(s), {size} bytes",
        ]
        out_path = os.path.join(target_dir, name)
        with open(out_path, "w", encoding="utf-8", newline="\n") as f:
            if ext == ".md":
                f.write("# QPS debug log\n\n")
                f.write("\n".join("- " + line for line in header))
                f.write("\n\n## Session log\n\n````text\n")
                self._dbg_copy_segments(checked, f)
                f.write("````\n")
                if extra_text:
                    f.write("\n## Extra (logcat after restart)\n\n````text\n")
                    f.write(redact_text(extra_text))
                    f.write("\n````\n")
            else:
                f.write("\n".join(header))
                f.write("\n\n==== SESSION LOG ====\n")
                self._dbg_copy_segments(checked, f)
                if extra_text:
                    f.write("\n==== EXTRA (logcat after restart) ====\n")
                    f.write(redact_text(extra_text))
                    f.write("\n")
        return out_path

    @staticmethod
    def _dbg_copy_segments(sources, out):
        for source in sources:
            with open(source, "r", encoding="utf-8", errors="replace", newline="") as f_in:
                shutil.copyfileobj(f_in, out, 1024 * 1024)

    @safe(default=False, msg="Debug log send failed", notify=False)
    def _dbg_send_file(self, path, reason, account):
        if account is None:
            log(f"[{__id__}] Refusing to send {path}: no account bound to this log")
            return False
        user = get_user_config(account).getCurrentUser()
        if user is None:
            log(f"[{__id__}] Cannot resolve Saved Messages: account {account} has no current user")
            return False
        send_document(user.id, path, caption=("QPS debug: " + reason)[:200], account=account)
        self._dbg_emit("SEND", f"sent {path} size={os.path.getsize(path)} peer={user.id} account={account}")
        log(f"[{__id__}] Debug log sent to Saved Messages: {path}")
        return True

    def _dbg_ship(self, reason, sources, account, recorder=None, held=None):
        ok = False
        try:
            snapshot = self._dbg_build_snapshot(reason, sources)
            ok = bool(snapshot) and self._dbg_send_file(snapshot, reason, account)
        finally:
            if recorder is not None and held is not None:
                recorder.release(held, ok)
        if ok and recorder is not None and self._dbg_recorder is recorder:
            self._dbg_emit("SESSION", "log sent and cleared, recording continues")
            self._dbg_probe_env()
        return ok

    @safe(default=False, msg="Debug log send failed", notify=False)
    def _dbg_send(self, reason, sources=None, account=None):
        recorder = self._dbg_recorder
        if sources is not None:
            return self._dbg_ship(reason, sources, account)
        if recorder is None or not recorder.path:
            return False
        held = recorder.seal()
        return self._dbg_ship(reason, held, account, recorder, held)

    @safe(msg="Debug ring event failed", notify=False)
    def _dbg_on_ring_event(self, recorder, kind, held):
        if kind == "full":
            self._notify("info", localise("DEBUG_LOG_FULL"))
            return
        account = self._dbg_account

        def job():
            self._notify("info", localise("DEBUG_LOG_FULL_SENDING"))
            ok = self._dbg_ship("log full", held, account, recorder, held)
            if ok:
                self._notify("success", localise("DEBUG_LOG_SENT"))
            else:
                self._notify("error", localise("DEBUG_LOG_FAILED"))

        if not self._submit(job, "debug_full_send"):
            recorder.release(held, False)

    @safe(msg="Debug auto send toggle failed", notify=False)
    def _on_debug_auto_send(self, value):
        recorder = self._dbg_recorder
        if recorder is not None:
            recorder.auto_send = bool(value)

    def _handle_fast_log_click(self, view):
        BulletinHelper.show_info(localise("DEBUG_LOG_SENDING"))
        account = self._dbg_current_account()

        def job():
            sources = None if self._dbg_running else self._dbg_oneshot()
            if sources:
                ok = self._dbg_send("fast-log (no session)", sources=sources, account=account)
                self._dbg_discard(sources)
            elif self._dbg_running:
                ok = self._dbg_send("fast-log", account=account)
            else:
                ok = False
            if ok:
                self._notify("success", localise("DEBUG_LOG_SENT"))
            else:
                self._notify("error", localise("DEBUG_LOG_FAILED"))

        if not self._submit(job, "fast_log"):
            self._notify("error", localise("DEBUG_LOG_FAILED"))

    def _handle_debug_probe_click(self, view):
        if not self._dbg_running:
            BulletinHelper.show_info(localise("DEBUG_ENABLE_FIRST"))
            return
        self._dbg_request_probe("manual", 0.1)
        BulletinHelper.show_info(localise("DEBUG_PROBE_STARTED"))

    @safe(default=None, msg="Exit info read failed", notify=False)
    def _dbg_find_exit_reason(self, started_ms):
        from android.os import Build
        if Build.VERSION.SDK_INT < 30:
            return None
        from android.app import ApplicationExitInfo
        context = ApplicationLoader.applicationContext
        am = context.getSystemService(Context.ACTIVITY_SERVICE)
        infos = am.getHistoricalProcessExitReasons(context.getPackageName(), 0, 8)
        for i in range(infos.size()):
            info = infos.get(i)
            reason = int(info.getReason())
            stamp = int(info.getTimestamp())
            if stamp < started_ms:
                continue
            if reason == ApplicationExitInfo.REASON_CRASH:
                return f"app crash (java) ts={stamp} desc={info.getDescription()}"
            if reason == ApplicationExitInfo.REASON_CRASH_NATIVE:
                return f"app crash (native) ts={stamp} desc={info.getDescription()}"
            if reason == ApplicationExitInfo.REASON_ANR:
                return f"app ANR ts={stamp} desc={info.getDescription()}"
        return None

    @safe(msg="Previous debug session check failed", notify=False)
    def _dbg_check_previous_session(self):
        debug_dir = self._dbg_dir()
        if not debug_dir:
            return
        marker = os.path.join(debug_dir, "session.json")
        if not os.path.isfile(marker):
            return
        with open(marker, "r", encoding="utf-8") as f:
            data = json.load(f)
        os.remove(marker)
        why = self._dbg_find_exit_reason(int(data.get("started_ms", 0)))
        if not why:
            log(f"[{__id__}] [DEBUG] previous session ended without a crash")
            return
        main_lines, crash_lines = self._dbg_logcat_dump(True)
        extra = "\n".join(["--- logcat (filtered) ---"] + (main_lines or []) + ["", "--- logcat crash buffer ---"] + (crash_lines or []))
        account = data.get("account")
        if not isinstance(account, int):
            log(f"[{__id__}] [DEBUG] crash log dropped: previous session had no bound account")
            return
        log_prefix = data.get("log_path")
        sources = _segment_paths(log_prefix) if isinstance(log_prefix, str) and log_prefix else []
        pending_path = self._dbg_build_snapshot(why, sources, extra, pending=True, account=account)
        if pending_path:
            self._dbg_discard(sources)
            log(f"[{__id__}] [DEBUG] crash log queued: {pending_path}")
            self._dbg_process_pending()

    @safe(msg="Pending debug logs failed", notify=False)
    def _dbg_process_pending(self, attempt=0):
        # запуск отладки и таймер на 10 секунд приходят сюда одновременно -
        # без блокировки один и тот же краш-лог уходит в Избранное дважды
        with self._dbg_pending_lock:
            self._dbg_process_pending_locked(attempt)

    def _dbg_retire(self, path, debug_dir, name):
        sent_dir = os.path.join(debug_dir, DEBUG_SENT_DIRNAME)
        try:
            os.makedirs(sent_dir, exist_ok=True)
            os.replace(path, os.path.join(sent_dir, PENDING_NAME_RE.sub("", name)))
        except OSError as e:
            log(f"[{__id__}] Failed to retire {path}: {e}")

    def _dbg_process_pending_locked(self, attempt):
        if self._unloaded:
            return
        debug_dir = self._dbg_dir()
        if not debug_dir or not os.path.isdir(debug_dir):
            return
        pending = sorted(n for n in os.listdir(debug_dir) if n.startswith("pending_"))
        if not pending:
            return
        if not self.get_setting("debug_mode", False):
            for name in pending:
                try:
                    os.remove(os.path.join(debug_dir, name))
                except OSError as e:
                    log(f"[{__id__}] Failed to drop pending debug log {name}: {e}")
            return
        failed = False
        for name in pending:
            path = os.path.join(debug_dir, name)
            match = PENDING_NAME_RE.match(name)
            if match is None:
                log(f"[{__id__}] Dropping pending debug log without bound account: {name}")
                os.remove(path)
                continue
            if self._dbg_send_file(path, "app crash", int(match.group(1))):
                self._dbg_retire(path, debug_dir, name)
            else:
                failed = True
        if failed and attempt < 3:
            if attempt == 0:
                delay = 30.0
            elif attempt == 1:
                delay = 90.0
            else:
                delay = 240.0
            timer = threading.Timer(delay, self._dbg_process_pending, (attempt + 1,))
            timer.daemon = True
            timer.start()


# ====================================================================
# QPS MENU
# пункты меню, диалог действий, хуки на PluginsController
# ====================================================================
class MenuMixin:
    def _apply_hooks(self):
        if self.hooks:
            return
        try:
            controller_class = PluginsController.getClass()
            hook_handler = PluginStateChangeHook(self)
            for target in controller_class.getDeclaredMethods():
                name = str(target.getName())
                if name not in ("loadPluginFromFile", "setPluginEnabled", "deletePlugin"):
                    continue
                try:
                    hook = self.hook_method(target, hook_handler)
                    if hook:
                        self.hooks.append(hook)
                    else:
                        log(f"[{__id__}] hook_method returned nothing for {target}, skipping")
                except Exception as e:
                    log(f"[{__id__}] Failed to hook {target}: {e}")
        except Exception as e:
            log(f"[{__id__}] Failed to apply hooks: {e}")

    def _remove_hooks(self):
        for hook in self.hooks:
            try:
                self.unhook_method(hook)
            except Exception as e:
                log(f"[{__id__}] Failed to unhook {hook}: {e}")
        self.hooks.clear()

    def _schedule_menu_update(self, delay=0.0):
        # таймер чтобы не ебашить меню 10 раз в секунду
        with self._menu_lock:
            if self._unloaded:
                return
            self._cancel_timer(self.update_timer)
            timer = threading.Timer(delay, self._update_menu_items)
            timer.daemon = True
            self.update_timer = timer
            timer.start()

    def _registry_entries(self):
        entries = []
        for attempt in range(3):
            entries = []
            try:
                plugins_map = PluginsController.getInstance().plugins

                if hasattr(plugins_map, "entrySet"):
                    java_iterator = plugins_map.entrySet().iterator()
                    while java_iterator.hasNext():
                        entry = java_iterator.next()
                        entries.append((str(entry.getKey()), entry.getValue()))
                elif isinstance(plugins_map, dict):
                    entries = list(plugins_map.items())
                return entries, True
            except Exception as e:
                log(
                    f"[{__id__}] Plugins snapshot broke at {len(entries)} entries "
                    f"(attempt {attempt + 1}): {e}"
                )
        return entries, False

    def _get_displayable_plugins(self):
        plugins_to_show = []
        show_without_settings = self.get_setting("show_plugins_without_settings", False)
        show_disabled = self.get_setting("show_disabled_plugins", True)

        entries, _ = self._registry_entries()

        try:
            for plugin_id, plugin_obj in entries:
                # фильтруем себя, иначе меню в себя уйдёт — рекурсия хуёвая штука
                if plugin_id == __id__:
                    continue

                try:
                    is_enabled = self._is_plugin_enabled(plugin_obj)
                    plugin_name = self._get_plugin_display_name(plugin_obj, plugin_id)

                    if not (is_enabled or show_disabled):
                        continue

                    info = self._get_plugin_info(plugin_id) or {}
                    # если нет настроек и команд — нахуй оно в меню нужно
                    if not show_without_settings and not info.get("parse_failed", False) and not (
                        self._plugin_has_settings(plugin_id)
                        or self._plugin_has_commands(plugin_id)
                    ):
                        continue

                    plugins_to_show.append((plugin_id, str(plugin_name), is_enabled))
                except Exception as e:
                    log(f"[{__id__}] Error processing plugin {plugin_id}: {e}")

        except Exception as e:
            log(f"[{__id__}] Error getting displayable plugins: {e}")

        return sorted(plugins_to_show, key=lambda item: item[1].casefold())

    def _update_menu_items(self):
        try:
            menu_data = self._compute_menu_data()
        except Exception:
            self._handle_error("Error computing menu data", notify=False)
            return

        self._run_ui_action(
            lambda: self._apply_menu_items(menu_data),
            "Error updating menu items",
            notify_on_error=False
        )

    def _compute_menu_data(self):
        location = self.get_setting("menu_location", MENU_LOCATION_BOTH)
        chat_action = self.get_setting("chat_menu_action", ACTION_OPEN_MENU)
        show_shortcut = self.get_setting("show_chat_plugins_shortcut", True)
        return location, chat_action, show_shortcut, self._get_displayable_plugins()

    def _apply_menu_items(self, menu_data):
        if self._unloaded:
            return
        location, chat_action, show_shortcut, displayable_plugins = menu_data

        self._remove_menu_items()

        if location in (MENU_LOCATION_CHAT, MENU_LOCATION_BOTH):
            for idx, (plugin_id, plugin_name, is_enabled) in enumerate(displayable_plugins):
                if chat_action == ACTION_OPEN_SETTINGS:
                    on_click_action = (
                        lambda ctx, plugin_id=plugin_id:
                        self._open_settings_or_show_bulletin(plugin_id)
                    )
                elif chat_action == ACTION_TOGGLE_STATE:
                    on_click_action = (
                        lambda ctx, plugin_id=plugin_id, plugin_name=plugin_name:
                        self._toggle_plugin_state(plugin_id, plugin_name)
                    )
                else:
                    on_click_action = (
                        lambda ctx, plugin_id=plugin_id, plugin_name=plugin_name:
                        self._show_plugin_action_dialog(plugin_id, plugin_name)
                    )

                icon = "msg_select_solar" if is_enabled else "msg_block_solar"

                item = self.add_menu_item(MenuItemData(
                    menu_type=MenuItemType.CHAT_ACTION_MENU,
                    text=plugin_name,
                    icon=icon,
                    # каждому пункту - свой приоритет, а не один общий на всех: с одинаковым
                    # priority на всех элементах список при росте (без настроек=True) рендерился
                    # криво и обрубался примерно вдвое
                    priority=self.PRIORITY_PLUGIN - idx,
                    on_click=on_click_action
                ))
                self.added_menu_items.append(item)

            if show_shortcut:
                item = self.add_menu_item(MenuItemData(
                    menu_type=MenuItemType.CHAT_ACTION_MENU,
                    text=localise("MENU_ITEM_PLUGINS_SHORTCUT"),
                    icon="msg_plugins_solar",
                    priority=self.PRIORITY_SHORTCUT,
                    on_click=lambda ctx: self._open_plugins_activity()
                ))
                self.added_menu_items.append(item)

            chat_settings_item = self.add_menu_item(MenuItemData(
                menu_type=MenuItemType.CHAT_ACTION_MENU,
                text=localise("MENU_ITEM_QPS_SETTINGS"),
                icon="msg_settings",
                priority=self.PRIORITY_PLUGIN - len(displayable_plugins),
                on_click=lambda ctx: self._open_specific_settings(__id__)
            ))
            self.added_menu_items.append(chat_settings_item)

        if location in (MENU_LOCATION_DRAWER, MENU_LOCATION_BOTH):
            settings_item = self.add_menu_item(MenuItemData(
                menu_type=MenuItemType.DRAWER_MENU,
                text=localise("TITLE_PLUGIN_SETTINGS"),
                icon="msg_reorder",
                priority=self.PRIORITY_PLUGIN,
                on_click=lambda ctx: self._open_plugins_activity()
            ))
            self.added_menu_items.append(settings_item)

            drawer_settings_item = self.add_menu_item(MenuItemData(
                menu_type=MenuItemType.DRAWER_MENU,
                text=localise("MENU_ITEM_QPS_SETTINGS"),
                icon="msg_settings",
                priority=self.PRIORITY_PLUGIN - 1,
                on_click=lambda ctx: self._open_specific_settings(__id__)
            ))
            self.added_menu_items.append(drawer_settings_item)

    def _remove_menu_items(self):
        failed = []
        for item in self.added_menu_items:
            try:
                self.remove_menu_item(item)
            except Exception as e:
                log(f"[{__id__}] Failed to remove menu item {item}: {e}")
                failed.append(item)
        self.added_menu_items = failed

    def _get_ui_context(self):
        fragment = get_last_fragment()
        if not fragment:
            return None
        return fragment.getContext() or fragment.getParentActivity()

    def _show_plugin_action_dialog(self, plugin_id, plugin_name):
        def action():
            context = self._get_ui_context()
            if not context:
                return

            plugin_obj = self._get_plugin_obj(plugin_id)
            if not plugin_obj:
                return

            builder = AlertDialogBuilder(context)
            builder.set_title(plugin_name)
            is_enabled = self._is_plugin_enabled(plugin_obj)

            actions = []
            if self._plugin_has_settings(plugin_id) and is_enabled:
                actions.append(("settings", localise("DIALOG_ACTION_SETTINGS")))

            if self._plugin_has_commands(plugin_id):
                actions.append(("show_commands", localise("DIALOG_ACTION_SHOW_COMMANDS")))

            if is_enabled:
                actions.append(("disable", localise("DIALOG_ACTION_DISABLE")))
            else:
                actions.append(("enable", localise("DIALOG_ACTION_ENABLE")))

            if is_enabled:
                actions.append(("restart", localise("DIALOG_ACTION_RESTART")))

            actions.append(("delete", localise("DIALOG_ACTION_DELETE")))
            if not self._plugin_is_elyx(plugin_id, plugin_obj):
                actions.extend([
                    ("share", localise("DIALOG_ACTION_SHARE")),
                    ("open_with", localise("DIALOG_ACTION_OPEN_WITH"))
                ])

            items = [text for _, text in actions]

            handlers = {
                "settings": lambda: self._open_specific_settings(plugin_id),
                "show_commands": lambda: self._show_plugin_commands_dialog(plugin_id, plugin_name),
                "disable": lambda: self._disable_plugin(plugin_id, plugin_name),
                "enable": lambda: self._enable_plugin(plugin_id, plugin_name),
                "restart": lambda: self._restart_plugin(plugin_id, plugin_name),
                "delete": lambda: self._delete_plugin_with_undo(plugin_id, plugin_name),
                "share": lambda: self._share_plugin(plugin_id),
                "open_with": lambda: self._open_plugin_with(plugin_id),
            }

            def on_item_click(dialog, which):
                try:
                    handler = handlers.get(actions[which][0])
                    if handler:
                        handler()
                finally:
                    dialog.dismiss()

            builder.set_items(items, on_item_click)
            builder.show()

        self._run_ui_action(action, "Error building action dialog")

    def _show_plugin_commands_dialog(self, plugin_id, plugin_name):
        def action():
            commands = self._get_plugin_commands(plugin_id)
            if not commands:
                BulletinHelper.show_info(localise("INFO_NO_COMMANDS_FOUND"))
                return

            context = self._get_ui_context()
            if not context:
                return

            builder = AlertDialogBuilder(context)
            builder.set_title(localise("DIALOG_COMMANDS_TITLE", plugin_name))

            commands_text = "\n".join(commands)
            builder.set_message(commands_text)

            builder.set_positive_button("OK", lambda d, w: d.dismiss())
            builder.show()

        self._run_ui_action(action, "Error showing commands dialog", notify_on_error=False)

    def _open_settings_or_show_bulletin(self, plugin_id):
        plugin_obj = self._get_plugin_obj(plugin_id)
        if not plugin_obj:
            return

        if not self._plugin_has_settings(plugin_id):
            BulletinHelper.show_info(localise("PLUGIN_HAS_NO_SETTINGS"))
            return

        if not self._is_plugin_enabled(plugin_obj):
            plugin_name = self._get_plugin_display_name(plugin_obj, plugin_id)
            BulletinHelper.show_info(localise("PLUGIN_DISABLED", plugin_name))
            return

        self._open_specific_settings(plugin_id)

    def _open_specific_settings(self, plugin_id):
        def action():
            plugin_obj = self._get_plugin_obj(plugin_id)
            if plugin_obj:
                fragment = get_last_fragment()
                if fragment:
                    fragment.presentFragment(PluginSettingsActivity(plugin_obj))

        self._run_ui_action(action, "Error opening settings", notify_on_error=False)

    def _open_plugins_activity(self):
        def action():
            fragment = get_last_fragment()
            if fragment:
                fragment.presentFragment(PluginsActivity())

        self._run_ui_action(action, "Failed to open PluginsActivity", notify_on_error=False)


# ====================================================================
# QPS PLUGIN ACTIONS
# включить / выключить / перезапустить / удалить
# ====================================================================
class ActionsMixin:
    def _drop_from_registry(self, plugin_id):
        controller = PluginsController.getInstance()
        try:
            if hasattr(controller.plugins, "remove"):
                controller.plugins.remove(plugin_id)
            elif isinstance(controller.plugins, dict):
                controller.plugins.pop(plugin_id, None)
        except Exception as e:
            log(f"[{__id__}] Registry cleanup after manual delete failed for {plugin_id}: {e}")

    def _toggle_plugin_state(self, plugin_id, plugin_name):
        plugin_obj = self._get_plugin_obj(plugin_id)
        if not plugin_obj:
            return

        if self._is_plugin_enabled(plugin_obj):
            self._disable_plugin(plugin_id, plugin_name)
        else:
            self._enable_plugin(plugin_id, plugin_name)

    def _set_plugin_enabled_locked(self, plugin_id, enabled):
        controller = PluginsController.getInstance()

        try:
            controller.setPluginEnabled(plugin_id, enabled, None)
        except Exception as e:
            log(f"[{__id__}] controller.setPluginEnabled failed for {plugin_id}, falling back: {e}")

        # сука этот апи пиздит что сделал — перечитываем реестр после каждой попытки
        plugin_obj = controller.plugins.get(plugin_id)
        if plugin_obj and self._is_plugin_enabled(plugin_obj) == enabled:
            return True

        try:
            if plugin_obj:
                plugin_obj.setEnabled(enabled)
        except Exception as e:
            log(f"[{__id__}] plugin_obj.setEnabled({enabled}) fallback failed for {plugin_id}: {e}")

        plugin_obj = controller.plugins.get(plugin_id)
        if plugin_obj and self._is_plugin_enabled(plugin_obj) == enabled:
            return True

        return False

    @safe(default=False, ctx=lambda plugin_id, enabled: plugin_id, notify=False)
    def _set_plugin_enabled_silent(self, plugin_id, enabled):
        # лочим на конкретный plugin_id, чтобы enable/disable/restart на одном и том же плагине
        # не могли выполниться внахлёст друг на друга - гонка состояний иначе неизбежна
        with self._get_plugin_lock(plugin_id):
            return self._set_plugin_enabled_locked(plugin_id, enabled)

    def _set_plugin_enabled(self, plugin_id, enabled, success_key, error_key, plugin_name):
        def action():
            try:
                success = self._set_plugin_enabled_silent(plugin_id, enabled)

                if success:
                    self._notify("success", localise(success_key, plugin_name))
                    self._schedule_cache_sync(delay=0.5)
                else:
                    log(f"[{__id__}] Failed to set enabled={enabled} for {plugin_id}")
                    self._notify("error", localise(error_key, plugin_name))
            except Exception as e:
                log(f"[{__id__}] Toggle task for {plugin_id} died: {e}")

        if not self._submit(action, f"toggle:{plugin_id}"):
            self._notify("error", localise(error_key, plugin_name))

    def _disable_plugin(self, plugin_id, plugin_name):
        self._set_plugin_enabled(
            plugin_id, False, "PLUGIN_DISABLED", "PLUGIN_DISABLE_ERROR", plugin_name
        )

    def _enable_plugin(self, plugin_id, plugin_name):
        self._set_plugin_enabled(
            plugin_id, True, "PLUGIN_ENABLED", "PLUGIN_ENABLE_ERROR", plugin_name
        )

    def _restart_plugin(self, plugin_id, plugin_name):
        self._notify("info", localise("RESTART_LAUNCHED"))

        def action():
            try:
                # оба шага под одним и тем же плагин-локом - снаружи никто не втиснется
                # между disable и enable, иначе поймаем гонку с обычным toggle
                with self._get_plugin_lock(plugin_id):
                    plugin_obj = self._get_plugin_obj(plugin_id)
                    if not plugin_obj or not self._is_plugin_enabled(plugin_obj):
                        self._notify("error", localise("PLUGIN_GENERIC_ERROR"))
                        return
                    disabled = self._set_plugin_enabled_locked(plugin_id, False)
                    enabled = self._set_plugin_enabled_locked(plugin_id, True)

                if disabled and enabled:
                    self._notify("success", localise("RESTART_SUCCESSFUL"))
                    self._schedule_cache_sync(delay=0.5)
                else:
                    log(
                        f"[{__id__}] Restart incomplete for {plugin_id}: "
                        f"disabled={disabled} enabled={enabled}"
                    )
                    self._notify("error", localise("PLUGIN_GENERIC_ERROR"))
            except Exception:
                self._handle_error("Error restarting plugin", "PLUGIN_GENERIC_ERROR")

        if not self._submit(action, f"restart:{plugin_id}"):
            self._notify("error", localise("PLUGIN_GENERIC_ERROR"))

    def _delete_plugin_with_undo(self, plugin_id, plugin_name):
        if not self.get_setting("del_bullet", True):
            self._delete_plugin(plugin_id, plugin_name)
            return
        plugin_obj = self._get_plugin_obj(plugin_id)
        was_enabled = self._is_plugin_enabled(plugin_obj) if plugin_obj else False

        # выключаем прямо тут, как только тапнули "Удалить" — до того как юзер вообще увидел бюллетень с Undo,
        # а не после его истечения. так быстрее, но по факту плагин уже мёртв ещё до окна отмены, не просто помечен
        predelete_future = None
        # если оба потока заняты, выключение может стоять в очереди. после Undo/отмены оно
        # уже не нужно: проверяем флаг в самой задаче, чтобы оно не отработало позже повторного включения
        predelete_cancelled = threading.Event()

        def predelete_task():
            if predelete_cancelled.is_set():
                log(f"[{__id__}] Predelete for {plugin_id} cancelled before it started")
                return False
            return self._set_plugin_enabled_silent(plugin_id, False)

        if was_enabled:
            executor = self._executor
            if executor is not None:
                try:
                    predelete_future = executor.submit(predelete_task)
                except RuntimeError as e:
                    log(f"[{__id__}] Executor rejected predelete:{plugin_id}: {e}")

        settle_lock = threading.Lock()
        settled = {"done": False}

        timer_ref = {"timer": None}

        def settle():
            with settle_lock:
                if settled["done"]:
                    return False
                settled["done"] = True
            t = timer_ref["timer"]
            if t is not None:
                t.cancel()
            with self._undo_timers_lock:
                if t is not None:
                    self._undo_timers.discard(t)
                self._pending_undo_finalizers.pop(timer_ref.get("key"), None)
            return True

        def restore_enabled():
            if not was_enabled:
                return

            # невыполненное выключение просто отменяем - плагин и так включён
            predelete_cancelled.set()
            if predelete_future is not None and predelete_future.cancel():
                log(f"[{__id__}] Pending predelete for {plugin_id} cancelled, nothing to restore")
                return

            def restore_task():
                if predelete_future is not None:
                    # выключение уже идёт или завершилось - дожидаемся его, потом включаем обратно
                    try:
                        predelete_future.result(timeout=30)
                    except Exception as e:
                        log(f"[{__id__}] predelete wait failed for {plugin_id}: {e}")
                if not self._set_plugin_enabled_silent(plugin_id, True):
                    self._notify("error", localise("PLUGIN_ENABLE_ERROR", plugin_name))

            if not self._submit(restore_task, f"undo:{plugin_id}", detached=True):
                self._notify("error", localise("PLUGIN_ENABLE_ERROR", plugin_name))

        def perform_delete():
            if settle():
                self._delete_plugin(plugin_id, plugin_name, detached=self._unloaded)

        def finalize_on_unload():
            # QPS выгружают, пока висит Undo: довершаем удаление, иначе плагин
            # останется выключенным, но не удалённым
            if settle():
                log(f"[{__id__}] QPS unloading with pending undo, finishing delete of {plugin_id}")
                self._delete_plugin(plugin_id, plugin_name, detached=True)

        def undo_callback():
            if not settle():
                return
            restore_enabled()
            BulletinHelper.show_info(localise("ACTION_UNDONE"))

        def timeout_fallback():
            if not settle():
                return
            log(f"[{__id__}] Undo bulletin closed without a callback, restoring {plugin_id}")
            restore_enabled()

        fallback_timer = threading.Timer(UNDO_FALLBACK_SECONDS, timeout_fallback)
        fallback_timer.daemon = True
        timer_ref["timer"] = fallback_timer
        with self._undo_timers_lock:
            self._undo_timers.add(fallback_timer)
        fallback_timer.start()
        with self._undo_timers_lock:
            self._pending_undo_finalizers[id(fallback_timer)] = finalize_on_unload
        timer_ref["key"] = id(fallback_timer)

        bulletin_text = localise("PLUGIN_WILL_BE_DELETED", plugin_name)
        BulletinHelper.show_undo(
            text=bulletin_text,
            on_action=perform_delete,
            on_undo=undo_callback
        )

    def _plugin_still_exists(self, plugin_id):
        try:
            if PluginsController.getInstance().plugins.get(plugin_id) is not None:
                return True
        except Exception as e:
            log(f"[{__id__}] Registry lookup failed for {plugin_id}, assuming it still exists: {e}")
            return True
        path = self._find_plugin_path(plugin_id)
        return path is not None and os.path.exists(path)

    def _delete_plugin(self, plugin_id, plugin_name, detached=False):
        def delete_task():
            try:
                with self._get_plugin_lock(plugin_id):
                    controller = PluginsController.getInstance()
                    plugin_obj = controller.plugins.get(plugin_id)
                    plugin_path = self._find_plugin_path(plugin_id)
                    elyx_archives = (
                        self._find_elyx_paths(plugin_id, "archive")
                        if self._plugin_is_elyx(plugin_id, plugin_obj) else []
                    )

                    if plugin_obj and self._is_plugin_enabled(plugin_obj):
                        self._set_plugin_enabled_locked(plugin_id, False)

                    # что за хуйня с sdk, deletePlugin выкидывает плагин из реестра но на диске он блять продолжает существовать
                    try:
                        controller.deletePlugin(plugin_id)
                    except Exception as e:
                        log(f"[{__id__}] deletePlugin(id) failed for {plugin_id}: {e}")

                    deleted = not self._plugin_still_exists(plugin_id)

                    if not deleted:
                        deleted = self._force_remove_plugin_file(plugin_id, plugin_path)

                    if deleted and elyx_archives:
                        self._remove_elyx_archives(elyx_archives, get_plugins_dir())

                    if deleted and self._plugin_is_elyx(plugin_id, plugin_obj):
                        self._remove_elyx_local_libs(plugin_id, get_plugins_dir())

                    if deleted:
                        purged = self._purge_cache_for_plugin(plugin_id)
                        log(f"[{__id__}] Cache purged for {plugin_id}: {purged} entries")

                if deleted:
                    # замок не удаляем: другой поток может держать/ждать старый объект, словарь крошечный
                    self._notify("success", localise("PLUGIN_DELETED_SUCCESS", plugin_name))
                    self._schedule_cache_sync(delay=0.5)
                else:
                    self._notify("error", localise("PLUGIN_DELETE_ERROR", plugin_name))
            except Exception:
                self._handle_error("Error in _delete_plugin", "PLUGIN_DELETE_ERROR", (plugin_name,))

        if not self._submit(delete_task, f"delete:{plugin_id}", detached=detached):
            self._notify("error", localise("PLUGIN_DELETE_ERROR", plugin_name))

    def _force_remove_plugin_file(self, plugin_id, plugin_path):
        if not plugin_path:
            log(f"[{__id__}] No resolved path for {plugin_id}, cannot force-remove")
            return False
        try:
            plugins_dir = get_plugins_dir()
            if not plugins_dir:
                return False

            real_plugins_dir = os.path.realpath(plugins_dir)
            real_path = os.path.realpath(plugin_path)
            if not self._is_path_inside_dir(real_path, real_plugins_dir):
                log(f"[{__id__}] Refusing to remove {plugin_path}: outside plugins dir")
                return False

            if os.path.isdir(real_path):
                return self._force_remove_elyx_plugin(plugin_id, plugin_path, real_path, real_plugins_dir)

            if not os.path.isfile(real_path):
                log(f"[{__id__}] {real_path} is not a regular file, skipping")
                return False

            # всё что не py, не plugin и не elyx-архив признать иноагентами
            if os.path.islink(plugin_path) or not real_path.endswith((".py", ".plugin") + ELYX_EXTS):
                log(f"[{__id__}] Refusing to remove {plugin_path}: symlink or not a plugin file")
                return False

            os.remove(real_path)
            log(f"[{__id__}] Manually removed plugin file: {real_path}")

            self._drop_from_registry(plugin_id)

            return not self._plugin_still_exists(plugin_id)
        except Exception as e:
            log(f"[{__id__}] Manual file removal failed for {plugin_id}: {e}")
            return False

    def _find_plugin_path(self, plugin_id):
        plugin_obj = self._get_plugin_obj(plugin_id)
        if plugin_obj and hasattr(plugin_obj, "file"):
            try:
                java_path = plugin_obj.file.getAbsolutePath()
                if java_path and os.path.isfile(java_path):
                    return java_path
            except Exception as e:
                log(
                    f"[{__id__}] plugin_obj.file.getAbsolutePath() failed for {plugin_id}, "
                    f"falling back to directory scan: {e}"
                )

        if self._plugin_is_elyx(plugin_id, plugin_obj):
            dirs = self._find_elyx_paths(plugin_id, "dir")
            return dirs[0] if dirs else None

        cached_path = self._find_cached_regular_path(plugin_id)
        if cached_path:
            return cached_path

        try:
            plugins_dir = get_plugins_dir()
            if not plugins_dir:
                return None

            for filename in os.listdir(plugins_dir):
                if not filename.endswith((".py", ".plugin")):
                    continue

                file_path = os.path.join(plugins_dir, filename)
                try:
                    if os.path.getsize(file_path) > MAX_FILE_SIZE:
                        log(f"[{__id__}] Skipping {filename}: too big to scan")
                        continue

                    with open(file_path, "r", encoding="utf-8-sig") as f:
                        content = f.read()
                    id_from_file = self._get_id_from_file_content(content)
                    if id_from_file == plugin_id:
                        return file_path
                except Exception as e:
                    log(
                        f"[{__id__}] Skipping unreadable file {filename} "
                        f"while searching for {plugin_id}: {e}"
                    )
                    continue
        except Exception as e:
            log(f"[{__id__}] Directory scan for {plugin_id} failed: {e}")
        return None

    def _resolve_plugin_file_or_notify(self, plugin_id):
        plugin_path = self._find_plugin_path(plugin_id)
        if not plugin_path:
            self._notify("error", localise("SHARE_ERROR_NOT_FOUND"))
            return None
        return plugin_path


# ====================================================================
# QPS SHARE & STAGING
# временные копии для «Поделиться» и «Открыть с помощью»
# ====================================================================
class ShareMixin:
    def _resolve_share_mime(self, filename):
        if filename.endswith(ELYX_EXTS):
            return "application/zip"
        return "text/plain"

    def _staging_roots(self, private_first=False):
        roots = []
        app_context = ApplicationLoader.applicationContext
        if not app_context:
            return roots
        getters = ("getExternalCacheDir", "getCacheDir", "getFilesDir")
        if private_first:
            getters = ("getCacheDir", "getFilesDir", "getExternalCacheDir")
        for getter in getters:
            try:
                root = getattr(app_context, getter)()
            except Exception as e:
                log(f"[{__id__}] {getter} unavailable for staging: {e}")
                continue
            if root:
                roots.append(root)
        return roots

    def _stage_plugin_copy(self, plugin_path, root, rename_py_to_plugin=False):
        staged_dir = None
        staged_path = None
        try:
            staged_dir = File(File(root, QUICKSETTINGS_TEMP_DIR), uuid.uuid4().hex)
            if not staged_dir.exists() and not staged_dir.mkdirs():
                return None

            filename = File(plugin_path).getName()
            if rename_py_to_plugin and filename.endswith(".py"):
                filename = filename[:-3] + ".plugin"

            staged_file = File(staged_dir, filename)
            staged_path = staged_file.getAbsolutePath()
            with open(plugin_path, "rb") as f_in, open(staged_path, "wb") as f_out:
                while True:
                    chunk = f_in.read(65536)
                    if not chunk:
                        break
                    f_out.write(chunk)
            return staged_file
        except Exception as e:
            log(f"[{__id__}] Staging {plugin_path} failed: {e}")
            if staged_path:
                self._delete_staged_file(staged_path)
            elif staged_dir is not None:
                self._remove_empty_dir(staged_dir.getAbsolutePath())
            return None

    def _copy_plugin_to_staging(self, plugin_path, rename_py_to_plugin=False):
        for root in self._staging_roots(private_first=True):
            staged_file = self._stage_plugin_copy(
                plugin_path, root, rename_py_to_plugin
            )
            if staged_file:
                return staged_file
        return None

    def _stage_for_provider(self, context, plugin_path):
        authority = context.getPackageName() + ".provider"
        for root in self._staging_roots(private_first=True):
            staged_file = self._stage_plugin_copy(plugin_path, root)
            if not staged_file:
                continue
            try:
                uri = FileProvider.getUriForFile(context, authority, staged_file)
                return staged_file, uri
            except Exception as e:
                log(f"[{__id__}] Provider has no root for {root}: {e}")
                self._delete_staged_file(staged_file.getAbsolutePath())
        return None, None

    def _delete_staged_file(self, path):
        try:
            if os.path.isfile(path):
                os.remove(path)
            parent = os.path.dirname(path)
            if os.path.basename(os.path.dirname(parent)) == QUICKSETTINGS_TEMP_DIR:
                self._remove_empty_dir(parent)
        except Exception as e:
            log(f"[{__id__}] Failed to drop staged file {path}: {e}")

    @safe(msg="Empty dir removal failed", notify=False)
    def _remove_empty_dir(self, path):
        if os.path.isdir(path) and not os.listdir(path):
            os.rmdir(path)

    def _schedule_staged_cleanup(self, path, delay=None):
        if delay is None:
            delay = self._get_staged_cleanup_timeout()
        timer = threading.Timer(delay, lambda: self._run_staged_cleanup(path, timer))
        timer.daemon = True
        with self._staged_lock:
            if self._unloaded:
                self._delete_staged_file(path)
                return
            self._staged_timers.add(timer)
        timer.start()

    def _run_staged_cleanup(self, path, timer):
        try:
            self._delete_staged_file(path)
        finally:
            with self._staged_lock:
                self._staged_timers.discard(timer)

    def _cancel_staged_timers(self):
        with self._staged_lock:
            timers = list(self._staged_timers)
            self._staged_timers.clear()
        for t in timers:
            self._cancel_timer(t)

    @safe(msg="Temp dir cleanup failed", notify=False)
    def _clear_temp_dir(self):
        # мистер пропер пиздабол нихуя не моет пол,но внешний кэш чистит xD
        for root in self._staging_roots():
            temp_dir = os.path.join(root.getAbsolutePath(), QUICKSETTINGS_TEMP_DIR)
            if not os.path.isdir(temp_dir):
                continue
            for name in os.listdir(temp_dir):
                path = os.path.join(temp_dir, name)
                if os.path.isdir(path) and not os.path.islink(path):
                    self._rmtree_guarded(path, temp_dir, "staged dir")
                else:
                    self._delete_staged_file(path)

    def _share_plugin(self, plugin_id):
        fragment = get_last_fragment()
        if not fragment:
            return

        try:
            dialog_id = fragment.getDialogId()
            account = int(fragment.getCurrentAccount())
        except Exception:
            self._handle_error("Error sharing plugin", "SHARE_ERROR_GENERAL")
            return

        def stage_and_send():
            try:
                plugin_path = self._resolve_plugin_file_or_notify(plugin_id)
                if not plugin_path:
                    return

                staged_file = self._copy_plugin_to_staging(
                    plugin_path, rename_py_to_plugin=True
                )
                if not staged_file:
                    self._notify("error", localise("SHARE_ERROR_GENERAL"))
                    return
                external_path = staged_file.getAbsolutePath()

                send_document(dialog_id, external_path, account=account)

                # тг файл впитал, через настроенный тайм-аут мистер пропер сюда тоже придёт
                self._schedule_staged_cleanup(external_path)
            except Exception:
                self._handle_error("Error sharing plugin", "SHARE_ERROR_GENERAL")

        if not self._submit(stage_and_send, f"share:{plugin_id}"):
            self._notify("error", localise("SHARE_ERROR_GENERAL"))

    def _open_plugin_with(self, plugin_id):
        context = self._get_ui_context()
        if not context:
            return

        def stage_and_open():
            try:
                plugin_path = self._resolve_plugin_file_or_notify(plugin_id)
                if not plugin_path:
                    return

                staged_file, uri = self._stage_for_provider(context, plugin_path)
                if not staged_file:
                    self._notify("error", localise("SHARE_ERROR_GENERAL"))
                    return

                def open_chooser():
                    intent = Intent(Intent.ACTION_VIEW)
                    intent.setDataAndType(uri, self._resolve_share_mime(staged_file.getAbsolutePath()))
                    intent.addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)
                    chooser = Intent.createChooser(intent, localise("OPEN_WITH_TITLE"))
                    context.startActivity(chooser)

                run_on_ui_thread(open_chooser)
                self._schedule_staged_cleanup(staged_file.getAbsolutePath())
            except Exception:
                self._handle_error("Error in _open_plugin_with", "SHARE_ERROR_GENERAL")

        if not self._submit(stage_and_open, f"open_with:{plugin_id}"):
            self._notify("error", localise("SHARE_ERROR_GENERAL"))


# ====================================================================
# QPS PLUGIN
# сам плагин: жизненный цикл и настройки; остальное — в миксинах выше
# ====================================================================
class QuickSettingsPlugin(MenuMixin, ActionsMixin, ShareMixin, DebugMixin, CacheMixin, ElyxScannerMixin, BasePlugin):
    PRIORITY_PLUGIN = 90
    PRIORITY_SHORTCUT = 91

    @safe(msg="Failed to cancel timer", notify=False)
    def _cancel_timer(self, timer):
        if timer:
            timer.cancel()

    @safe(default=False, msg="Clipboard copy failed", notify=False)
    def _copy_to_clipboard(self, label, text):
        context = ApplicationLoader.applicationContext
        if not context:
            return False
        clipboard = context.getSystemService(Context.CLIPBOARD_SERVICE)
        if not clipboard:
            return False
        clipboard.setPrimaryClip(ClipData.newPlainText(label, text))
        return True

    def _handle_error(self, context_label, message_key="PLUGIN_GENERIC_ERROR",
                      message_args=(), notify=True):
        tb = traceback.format_exc()
        log(f"[{__id__}] {context_label}: {tb}")
        self._dbg_report_error(context_label)

        def notify_action():
            bulletin_text = localise(message_key, *message_args)

            def copy_action():
                copied = self._copy_to_clipboard(
                    f"{__id__} error: {context_label}",
                    f"[{__id__}] {context_label}\n{tb}"
                )
                if copied:
                    BulletinHelper.show_info(localise("ERROR_DETAILS_COPIED"))

            try:
                BulletinHelper.show_with_button(
                    bulletin_text,
                    _error_bulletin_icon(),
                    localise("BULLETIN_ACTION_COPY_DETAILS"),
                    copy_action,
                    get_last_fragment()
                )
            except Exception as e:
                log(f"[{__id__}] show_with_button unavailable: {e}")
                BulletinHelper.show_error(bulletin_text)

        if notify:
            run_on_ui_thread(notify_action)

    def _run_ui_action(self, action, error_context, message_key="PLUGIN_GENERIC_ERROR",
                       message_args=(), notify_on_error=True):
        def wrapped():
            try:
                action()
            except Exception:
                self._handle_error(
                    error_context, message_key, message_args, notify=notify_on_error
                )

        run_on_ui_thread(wrapped)

    def _notify(self, kind, text):
        fn = {
            "success": BulletinHelper.show_success,
            "error": BulletinHelper.show_error,
            "info": BulletinHelper.show_info,
        }.get(kind, BulletinHelper.show_info)
        fn(text)

    def __init__(self):
        super().__init__()
        self.added_menu_items = []
        self.hooks = []
        self.update_timer = None
        self.plugin_info_cache = {}
        self.file_cache = {}
        self.cache_path = None
        self.rebuild_timer = None
        self._executor = None
        self._unloaded = False
        self._pending_notify = False
        self._sync_timer = None
        self._sync_lock = threading.Lock()
        self._sync_hints = set()
        self._registry_state_last = None
        self._cache_dirty = False
        self._pending_timer = None
        self._staged_timers = set()
        self._staged_lock = threading.Lock()
        self._rebuild_lock = threading.Lock()
        self._rebuild_exec_lock = threading.Lock()
        self._menu_lock = threading.Lock()
        self._cache_lock = threading.Lock()
        self._plugin_locks = {}
        self._plugin_locks_lock = threading.Lock()
        self._undo_timers = set()
        self._pending_undo_finalizers = {}
        self._dbg_pending_lock = threading.Lock()
        self._undo_timers_lock = threading.Lock()
        self._dbg_lock = threading.Lock()
        self._dbg_probe_lock = threading.Lock()
        self._dbg_probe_run_lock = threading.Lock()
        self._dbg_running = False
        self._dbg_recorder = None
        self._dbg_stop_event = threading.Event()
        self._dbg_proc = None
        self._dbg_threads = []
        self._dbg_unhooks = []
        self._dbg_hook_counts = {}
        self._dbg_probe_timer = None
        self._dbg_last_archives = []
        self._dbg_last_controller = {}
        self._dbg_last_fs = {}
        self._dbg_last_ctrl_state = {}
        self._dbg_last_cache_stamp = None
        self._dbg_account = None
        self._dbg_report_lock = threading.Lock()
        self._dbg_last_report = 0
        self._dbg_report_sigs = {}
        self._dbg_hook_fn = None
        self._dbg_prev_excepthook = None

    def _get_plugin_lock(self, plugin_id):
        with self._plugin_locks_lock:
            lock = self._plugin_locks.get(plugin_id)
            if lock is None:
                lock = threading.Lock()
                self._plugin_locks[plugin_id] = lock
            return lock

    def create_settings(self):
        return [
            Header(text=localise("HEADER_MENU_LOCATION")),
            Selector(
                key="menu_location",
                text=localise("SELECTOR_SHOW_MENU_IN"),
                items=localise("SELECTOR_ITEMS_MENU_LOCATION"),
                default=MENU_LOCATION_BOTH,
                on_change=lambda _: self._schedule_menu_update(delay=0.1)
            ),
            Header(text=localise("HEADER_PLUGINS_SHORTCUT")),
            Switch(
                key="show_chat_plugins_shortcut",
                text=localise("SWITCH_SHOW_CHAT_PLUGINS_SHORTCUT"),
                default=True,
                on_change=lambda _: self._schedule_menu_update(delay=0.1)
            ),
            Header(text=localise("HEADER_CHAT_MENU_ACTION")),
            Selector(
                key="chat_menu_action",
                text=localise("SELECTOR_CHAT_MENU_ACTION"),
                items=localise("SELECTOR_ITEMS_CHAT_MENU_ACTION"),
                default=ACTION_OPEN_MENU,
                on_change=lambda _: self._schedule_menu_update(delay=0.1)
            ),
            Header(text=localise("HEADER_PLUGIN_VISIBILITY")),
            Switch(
                key="show_plugins_without_settings",
                text=localise("SWITCH_SHOW_PLUGINS_WITHOUT_SETTINGS"),
                default=False,
                on_change=lambda _: self._schedule_menu_update(delay=0.1)
            ),
            Switch(
                key="show_disabled_plugins",
                text=localise("SWITCH_SHOW_DISABLED_PLUGINS"),
                default=True,
                on_change=lambda _: self._schedule_menu_update(delay=0.1)
            ),
            Header(text=localise("HEADER_CACHE_MANAGEMENT")),
            Text(
                text=localise("SETTINGS_REBUILD_CACHE_BUTTON"),
                icon="msg_update",
                on_click=self._handle_rebuild_cache_click
            ),
            Divider(text=localise("SETTINGS_REBUILD_CACHE_SUBTEXT")),
            Header(text=localise("HEADER_DELETE")),
            Switch(
                key="del_bullet",
                text=localise("SWITCH_DELETE_BULLET"),
                default=True
            ),
            Divider(text=localise("DELETE_BULLET_SUBTEXT")),
            Header(text=localise("HEADER_STAGED_CLEANUP")),
            Input(
                key="staged_cleanup_timeout",
                text=localise("INPUT_STAGED_CLEANUP_TIMEOUT"),
                default=str(DEFAULT_STAGED_CLEANUP_TIMEOUT),
                icon="msg_timer"
            ),
            Divider(text=localise("STAGED_CLEANUP_TIMEOUT_SUBTEXT")),
            Header(text=localise("HEADER_DEBUG")),
            Switch(
                key="debug_mode",
                text=localise("SWITCH_DEBUG_MODE"),
                default=False,
                on_change=lambda value: self._on_debug_toggle(value)
            ),
            Selector(
                key="debug_log_format",
                text=localise("SELECTOR_DEBUG_LOG_FORMAT"),
                items=localise("SELECTOR_ITEMS_DEBUG_FORMAT"),
                default=1
            ),
            Text(
                text=localise("BUTTON_FAST_LOG"),
                icon="msg_saved",
                on_click=self._handle_fast_log_click
            ),
            Text(
                text=localise("BUTTON_DEBUG_PROBE"),
                icon="msg_list",
                on_click=self._handle_debug_probe_click
            ),
            Switch(
                key="debug_auto_send",
                text=localise("SWITCH_DEBUG_AUTO_SEND"),
                default=False,
                on_change=lambda value: self._on_debug_auto_send(value)
            ),
            Divider(text=localise("DEBUG_SUBTEXT"))
        ]

    def _get_staged_cleanup_timeout(self):
        raw = self.get_setting("staged_cleanup_timeout", str(DEFAULT_STAGED_CLEANUP_TIMEOUT))
        try:
            value = int(str(raw).strip())
        except (TypeError, ValueError):
            return DEFAULT_STAGED_CLEANUP_TIMEOUT
        return max(MIN_STAGED_CLEANUP_TIMEOUT, min(MAX_STAGED_CLEANUP_TIMEOUT, value))

    def on_plugin_load(self):
        self._unloaded = False
        _DEBUG_STATE["plugin"] = self
        self._executor = ThreadPoolExecutor(max_workers=2)
        self._clear_temp_dir()
        self._init_cache_system()
        self._submit(self._cleanup_legacy_private_data, "legacy_cleanup")
        if self.get_setting("debug_mode", False):
            self._submit(self._dbg_boot, "debug_boot")
        self._pending_timer = threading.Timer(10.0, self._dbg_process_pending)
        self._pending_timer.daemon = True
        self._pending_timer.start()
        if self._load_cache():
            self._schedule_cache_rebuild(delay=2.0)
        else:
            self._schedule_cache_rebuild(delay=0.1)
        self._schedule_menu_update(delay=0)
        self._apply_hooks()

    def on_plugin_unload(self):
        self._unloaded = True
        run_on_ui_thread(self._remove_menu_items)
        self._remove_hooks()
        with self._menu_lock:
            self._cancel_timer(self.update_timer)
        with self._rebuild_lock:
            self._cancel_timer(self.rebuild_timer)
        with self._sync_lock:
            self._cancel_timer(self._sync_timer)
            self._sync_hints.clear()
        self._cancel_timer(self._pending_timer)
        with self._undo_timers_lock:
            undo_timers = list(self._undo_timers)
            self._undo_timers.clear()
            finalizers = list(self._pending_undo_finalizers.values())
            self._pending_undo_finalizers.clear()
        for t in undo_timers:
            self._cancel_timer(t)
        for finalize in finalizers:
            try:
                finalize()
            except Exception as e:
                log(f"[{__id__}] Pending undo finalize failed: {e}")
        if self._executor:
            self._executor.shutdown(wait=False)
            self._executor = None
        self._cancel_staged_timers()
        self._dbg_stop()
        self._clear_temp_dir()
        _DEBUG_STATE["plugin"] = None

    @safe(default=False, ctx=lambda plugin_obj: type(plugin_obj).__name__, notify=False)
    def _is_plugin_enabled(self, plugin_obj):
        return getattr(plugin_obj, "enabled", False) or (
            plugin_obj.isEnabled() if hasattr(plugin_obj, "isEnabled") else False
        )

    @safe(ctx=lambda plugin_id: plugin_id)
    def _get_plugin_obj(self, plugin_id):
        return PluginsController.getInstance().plugins.get(plugin_id)

    def _get_plugin_display_name(self, plugin_obj, fallback_id):
        if hasattr(plugin_obj, "name"):
            return str(plugin_obj.name)
        return str(plugin_obj.getName()) if hasattr(plugin_obj, "getName") else fallback_id

    def _submit(self, task, label="task", detached=False):
        # detached=True - если пула уже нет (QPS выгружается), выполняем в отдельном потоке:
        # так нужно для довершения удаления, которое юзер уже подтвердил
        executor = self._executor
        if executor is not None:
            try:
                executor.submit(task)
                return True
            except RuntimeError as e:
                log(f"[{__id__}] Executor rejected {label}: {e}")
        else:
            log(f"[{__id__}] Executor is gone for {label}")
        if not detached:
            return False
        try:
            thread = threading.Thread(target=task, name=f"QPS-{label}", daemon=True)
            thread.start()
            return True
        except Exception as e:
            log(f"[{__id__}] Detached thread failed for {label}: {e}")
            return False

    def _rmtree_guarded(self, target, root, label):
        if not target or not root:
            log(f"[{__id__}] Refusing rmtree of {label}: empty path")
            return False
        if os.path.islink(target) or not os.path.isdir(target):
            log(f"[{__id__}] Refusing rmtree of {label} {target}: symlink or not a directory")
            return False
        real_root = os.path.realpath(root)
        real_target = os.path.realpath(target)
        depth = len([part for part in real_target.split(os.sep) if part])
        if (
            real_target == real_root
            or not self._is_path_inside_dir(real_target, real_root)
            or depth < 3
            or os.path.ismount(real_target)
        ):
            log(f"[{__id__}] Refusing rmtree of {label} {target}: outside {root}")
            return False

        def on_error(func, path, exc_info):
            log(f"[{__id__}] rmtree {label}: {getattr(func, '__name__', func)} failed for {path}: {exc_info[1]}")

        shutil.rmtree(real_target, onerror=on_error)
        gone = not os.path.exists(real_target)
        if not gone:
            log(f"[{__id__}] rmtree {label} left {real_target} partially in place")
        return gone

    def _is_path_inside_dir(self, path, directory):
        dir_with_sep = directory if directory.endswith(os.sep) else directory + os.sep
        return path == directory or path.startswith(dir_with_sep)