__id__ = "QuickCloseButton"
__name__ = "QuickCloseButton"
__description__ = "Кнопка закрытия\\перезагрузки в правом углу главного экрана и в боковом меню. Копирует функционал кнопки перезагрузки из AyuGram в exterаGram.\n\nТап — закрыть\nЗажатие — перезапустить"
__author__ = "@KUNSESHBOY & @chestertech"
__version__ = "1.2.2"
__icon__ = "lelelesky1337/3"
__min_version__ = "12.1.1"

from android.os import Handler, Looper, Process
from android.content import Intent
from android.view import View

from java import dynamic_proxy
from java.lang import Class, Runnable, System

from base_plugin import BasePlugin, MethodHook, MenuItemData, MenuItemType
from client_utils import get_last_fragment

from ui.settings import Header, Switch
from ui.alert import AlertDialogBuilder
from org.telegram.messenger import ApplicationLoader


class _R(dynamic_proxy(Runnable)):
    def __init__(self, fn):
        super().__init__()
        self._fn = fn
    def run(self):
        try:
            self._fn()
        except Exception:
            pass


_main = Handler(Looper.getMainLooper())


def _do_exit():
    try:
        System.exit(0)
    except Exception:
        pass

def _close_app():
    _main.postDelayed(_R(_do_exit), 150)

def _restart_app(fragment):
    try:
        ctx = (fragment or get_last_fragment()).getContext()
        intent = ctx.getPackageManager().getLaunchIntentForPackage(ctx.getPackageName())
        intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK | Intent.FLAG_ACTIVITY_CLEAR_TASK)
        ctx.startActivity(intent)
        Process.killProcess(Process.myPid())
    except Exception:
        pass


_ICON_NAMES = ("ic_close_white", "msg_close", "ic_ab_back", "ic_close_white_24dp")

def _resolve_icon(ctx):
    try:
        res = ctx.getResources()
        pkg = ctx.getPackageName()
        for name in _ICON_NAMES:
            rid = res.getIdentifier(name, "drawable", pkg)
            if rid != 0:
                return rid
    except Exception:
        pass
    return 0


ITEM_ID            = 0x7C105E
_GONE              = 8
_VISIBLE           = 0
_last_fragment     = None
_close_item_ref    = None
_search_open       = False
_plugin_instance   = None




def _set_search_active(active):
    global _search_open
    active = bool(active)
    _search_open = active
    item = _close_item_ref
    if item is not None:
        try:
            item.setVisibility(_GONE if active else _VISIBLE)
        except Exception:
            pass
    elif not active and _last_fragment is not None:
        _inject_button(_last_fragment)


def _find_existing_item(action_bar):

    try:
        menu = action_bar.createMenu()
        if menu is None:
            return None

        try:
            existing = menu.findItem(ITEM_ID)
            if existing is not None:
                return existing
        except Exception:
            pass

        try:
            count = menu.getChildCount()
            for i in range(count):
                child = menu.getChildAt(i)
                if child is None:
                    continue
                try:
                    tag = child.getTag()
                    if tag is not None and str(tag) == str(ITEM_ID):
                        return child
                except Exception:
                    continue
        except Exception:
            pass
    except Exception:
        pass
    return None


def _inject_button(fragment):
    global _last_fragment, _close_item_ref
    if fragment is None:
        return
    _last_fragment = fragment
    try:
        action_bar = fragment.getActionBar()
        if action_bar is None:
            return


        if _close_item_ref is not None:
            try:
                if _close_item_ref.getParent() is not None:
                    _close_item_ref.setVisibility(_GONE if _search_open else _VISIBLE)
                    return
            except Exception:
                pass
            _close_item_ref = None


        existing = _find_existing_item(action_bar)
        if existing is not None:
            _close_item_ref = existing
            try:
                existing.setVisibility(_GONE if _search_open else _VISIBLE)
            except Exception:
                pass
            return


        menu = action_bar.createMenu()
        if menu is None:
            return
        ctx = action_bar.getContext()
        rid = _resolve_icon(ctx)
        if rid == 0:
            return
        item = menu.addItem(ITEM_ID, rid)
        if item is None:
            return
        _close_item_ref = item
        try:
            item.setTag(ITEM_ID)
        except Exception:
            pass

        class _Click(dynamic_proxy(View.OnClickListener)):
            def onClick(self, v):
                _close_app()

        class _LongClick(dynamic_proxy(View.OnLongClickListener)):
            def onLongClick(self, v):
                _restart_app(fragment)
                return True

        try:
            item.setOnClickListener(_Click())
            item.setOnLongClickListener(_LongClick())
        except Exception:
            pass
        try:
            item.setContentDescription("Закрыть")
        except Exception:
            pass
        try:
            item.setVisibility(_GONE if _search_open else _VISIBLE)
        except Exception:
            pass
    except Exception:
        pass




class _CreateViewHook(MethodHook):
    def after_hooked_method(self, param):
        try:
            frag = param.thisObject
            _main.post(_R(lambda: _inject_button(frag)))
        except Exception:
            pass


class _ResumeHook(MethodHook):
    def after_hooked_method(self, param):
        try:
            frag = param.thisObject
            _main.post(_R(lambda: _inject_button(frag)))
        except Exception:
            pass


class _ShowSearchHook(MethodHook):
    def after_hooked_method(self, param):
        try:
            args = param.args
            show = True
            if args is not None and len(args) >= 1 and args[0] is not None:
                show = str(args[0]).lower() == "true"
            _main.post(_R(lambda: _set_search_active(show)))
        except Exception:
            pass


class _CloseSearchHook(MethodHook):
    def after_hooked_method(self, param):
        try:
            _main.post(_R(lambda: _set_search_active(False)))
        except Exception:
            pass


class QuickCloseButton(BasePlugin):

    def _try_hook(self, cls, method, hook):
        try:
            self.hook_all_methods(cls, method, hook)
        except Exception:
            pass

    def create_settings(self):
        return [
            Header(text="Основные"),
            Switch(
                key="drawer_button_enabled",
                text="Пункт «Закрыть приложение»",
                subtext="Тап по кнопке в боковом меню открывает меню выбора",
                default=True,
                on_change=lambda *_: _main.post(_R(self._refresh_drawer_item)),
            ),
        ]

    def _refresh_drawer_item(self):
        enabled = True
        try:
            enabled = bool(self.get_setting("drawer_button_enabled", True))
        except Exception:
            pass

        if enabled:
            if not (hasattr(self, 'menu_item') and self.menu_item):
                self.menu_item = self.add_menu_item(MenuItemData(
                    menu_type=MenuItemType.DRAWER_MENU,
                    text="Закрыть приложение",
                    icon="msg_close",
                    priority=100,
                    on_click=self._show_close_dialog
                ))
        else:
            if hasattr(self, 'menu_item') and self.menu_item:
                try:
                    self.remove_menu_item(self.menu_item)
                except Exception:
                    pass
                self.menu_item = None

    def _show_close_dialog(self, context):
        try:
            fragment = get_last_fragment()
            if not fragment:
                return

            activity = fragment.getParentActivity()
            if not activity:
                activity = ApplicationLoader.applicationContext

            builder = AlertDialogBuilder(activity)
            builder.set_title("Quick Close")
            builder.set_message("Выберите действие")

            def on_close(dialog, which):
                dialog.dismiss()
                _close_app()

            def on_restart(dialog, which):
                dialog.dismiss()
                _restart_app(fragment)

            builder.set_positive_button("Закрыть", on_close)
            builder.set_negative_button("Перезапустить", on_restart)
            builder.set_neutral_button("Отмена", lambda d, w: d.dismiss())
            builder.show()
        except Exception as e:
            try:
                self.log(f"Error showing close dialog: {e}")
            except Exception:
                pass

    def on_plugin_load(self):
        global _plugin_instance, _close_item_ref, _last_fragment, _search_open
        _plugin_instance = self

        _close_item_ref = None
        _last_fragment = None
        _search_open = False

        self._refresh_drawer_item()


        try:
            DA = Class.forName("org.telegram.ui.DialogsActivity")
            self._try_hook(DA, "showSearch", _ShowSearchHook())
            self._try_hook(DA, "closeSearch", _CloseSearchHook())
            self._try_hook(DA, "createView", _CreateViewHook())
            self._try_hook(DA, "onResume", _ResumeHook())
        except Exception:
            pass

        try:
            AB = Class.forName("org.telegram.ui.ActionBar.ActionBar")
            self._try_hook(AB, "closeSearchField", _CloseSearchHook())
        except Exception:
            pass

    def on_plugin_unload(self):
        global _search_open, _close_item_ref, _last_fragment
        _search_open = False

        try:
            if _close_item_ref is not None:
                parent = _close_item_ref.getParent()
                if parent is not None:
                    try:
                        parent.removeView(_close_item_ref)
                    except Exception:
                        try:
                            _close_item_ref.setVisibility(_GONE)
                        except Exception:
                            pass
        except Exception:
            pass
        _close_item_ref = None
        _last_fragment = None

        if hasattr(self, 'menu_item') and self.menu_item:
            try:
                self.remove_menu_item(self.menu_item)
            except Exception:
                pass
            self.menu_item = None
