def _java_id(obj):
    if obj is None:
        return 0
    try:
        return int(obj.hashCode())
    except Exception:
        pass
    try:
        return id(obj)
    except Exception:
        return 0


def _cached_field(store, obj, name, limit=32):
    try:
        cls = obj.getClass()
        ck = str(cls.getName())
    except Exception:
        return None
    if ck in store:
        return store[ck]
    fld = None
    try:
        c = cls
        while c is not None:
            try:
                fld = c.getDeclaredField(name)
                break
            except Exception:
                try:
                    c = c.getSuperclass()
                except Exception:
                    c = None
        if fld is not None:
            fld.setAccessible(True)
    except Exception:
        fld = None
    try:
        if len(store) > limit:
            for _k in list(store.keys())[: max(1, limit // 2)]:
                store.pop(_k, None)
        store[ck] = fld
    except Exception:
        pass
    return fld


def _dp(value):
    try:
        return int(AndroidUtilities.dp(float(value)))
    except Exception:
        return int(value * 2)


class _ChannelCellDrawHook(MethodHook):
    def __init__(self, plugin):
        super().__init__()
        self.p = weakref.ref(plugin)
        self._matrix = None

    def before_hooked_method(self, param):
        p = self.p()
        if p is None or not p._cache_cb_enable:
            return
        try:
            with p._cb_bmp_lock:
                self._draw_banner_locked(p, param)
        except Exception:
            pass

    def _draw_banner_locked(self, p, param):
        try:
            cell = param.thisObject
            canvas = param.args[0]
            if cell is None or canvas is None:
                return
            key = p._cb_current_channel_key
            if not key:
                return
            if not p._cb_is_banner_cell(cell):
                return
            p._cb_tint_views_white(cell)
            with p._cb_bmp_lock:
                bmp = p._cb_bmp_map.get(key)
            try:
                if bmp is not None and bmp.isRecycled():
                    bmp = None
            except Exception:
                bmp = None
            if bmp is None:
                p._cb_prefetch_bitmap(key)
                return
            w = cell.getMeasuredWidth()
            h = cell.getMeasuredHeight()
            if w <= 0 or h <= 0:
                return
            eff = p._cache_cb_effect
            if eff not in ("blur", "darken", "blur_darken", "none"):
                eff = "none"
            if p._cb_has_blur(eff):
                bmp_draw = p._cb_get_blurred(key, bmp)
                if bmp_draw is None or bmp_draw.isRecycled():
                    return
            else:
                if bmp.isRecycled():
                    return
                bmp_draw = bmp
            bw = bmp_draw.getWidth()
            bh = bmp_draw.getHeight()
            if bw <= 0 or bh <= 0:
                return
            scale = max(w / float(bw), h / float(bh)) * 1.02
            if self._matrix is None:
                self._matrix = Matrix()
            else:
                self._matrix.reset()
            mat = self._matrix
            mat.postScale(float(scale), float(scale))
            mat.postTranslate((w - bw * scale) * 0.5, (h - bh * scale) * 0.5)
            sid = canvas.save()
            try:
                try:
                    canvas.clipRect(0, 0, int(w), int(h))
                except Exception:
                    canvas.clipRect(int(0), int(0), int(w), int(h))
                if p._cb_paint_bmp is None:
                    p._cb_paint_bmp = Paint()
                    p._cb_paint_bmp.setFilterBitmap(True)
                    p._cb_paint_bmp.setDither(True)
                p._cb_paint_bmp.setAlpha(255)
                canvas.drawBitmap(bmp_draw, mat, p._cb_paint_bmp)
                if p._cb_has_darken(eff):
                    a = int(255 * p._cache_cb_darken / 100.0)
                    if a > 0:
                        if p._cb_paint_darken is None:
                            p._cb_paint_darken = Paint()
                            p._cb_paint_darken.setStyle(Paint.Style.FILL)
                            p._cb_paint_darken.setDither(True)
                            p._cb_paint_darken.setAntiAlias(True)
                        p._cb_paint_darken.setARGB(a, 0, 0, 0)
                        canvas.drawRect(0, 0, float(w), float(h), p._cb_paint_darken)
            finally:
                try:
                    canvas.restoreToCount(sid)
                except Exception:
                    try:
                        canvas.restore()
                    except Exception:
                        pass
        except Exception:
            pass


