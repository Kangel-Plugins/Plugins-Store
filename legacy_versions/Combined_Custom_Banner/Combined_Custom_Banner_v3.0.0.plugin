            view.setBackground(p._oldfolders_tab_drawable())
        except Exception:
            pass


class _TFActionBarDispatchDrawHook(MethodHook):
    _VERDICT_LIMIT = 32
    _REVALIDATE_EVERY = 2000
    _V_NOT_DIALOGS = 0
    _V_BB_MISSING = 1
    _V_BB_FALSE = 2
    _V_BB_TRUE = 3

    def __init__(self, plugin):
        super().__init__()
        self.plugin = weakref.ref(plugin)
        self._verdict = {}
        self._saved = {}
        self._tls = threading.local()
        self._bb_field = {}
        self._pf_field = {}

    def _frames(self):
        tls = self._tls
        st = getattr(tls, "stack", None)
        if st is None:
            st = []
            tls.stack = st
        return st

    def _classify(self, actionBar, bar_id):
        try:
            pf_fld = _cached_field(self._pf_field, actionBar, "parentFragment", self._VERDICT_LIMIT)
            if pf_fld is not None:
                parentFragment = pf_fld.get(actionBar)
            else:
                parentFragment = get_private_field(actionBar, "parentFragment")
            if parentFragment is None:
                return (self._V_NOT_DIALOGS, None)
            if str(parentFragment.getClass().getName()) != "org.telegram.ui.DialogsActivity":
                return (self._V_NOT_DIALOGS, None)
        except Exception:
            return (self._V_NOT_DIALOGS, None)
        try:
            bb_fld = _cached_field(
                self._bb_field, actionBar, "blurredBackground", self._VERDICT_LIMIT
            )
            if bb_fld is not None:
                orig = bool(bb_fld.getBoolean(actionBar))
                return (self._V_BB_TRUE if orig else self._V_BB_FALSE, bb_fld)
            orig = get_private_field(actionBar, "blurredBackground")
            return (self._V_BB_TRUE if bool(orig) else self._V_BB_FALSE, None)
        except Exception:
            return (self._V_BB_MISSING, None)

    def before_hooked_method(self, param):
        p = self.plugin()
        if p is None or not p._oldf_active:
            return
        actionBar = param.thisObject
        if actionBar is None:
            return
        bar_id = _java_id(actionBar)
        verdict = self._verdict
        entry = verdict.get(bar_id)
        if entry is not None:
            entry[1] += 1
            state = entry[0]
            if entry[1] >= self._REVALIDATE_EVERY:
                new_state, bb_fld = self._classify(actionBar, bar_id)
                entry[0] = new_state
                entry[1] = 0
                entry[2] = bb_fld
                state = new_state
            else:
                bb_fld = entry[2]
        else:
            if len(verdict) > self._VERDICT_LIMIT:
                verdict.clear()
            state, bb_fld = self._classify(actionBar, bar_id)
            verdict[bar_id] = [state, 0, bb_fld]
        if state == self._V_NOT_DIALOGS or state == self._V_BB_FALSE:
            return
        frames = self._frames()
        if frames is not None:
            frames.append(None)
        try:
            if bb_fld is not None:
                orig = bool(bb_fld.getBoolean(actionBar))
            else:
                orig = bool(get_private_field(actionBar, "blurredBackground"))
            if not orig:
                entry = verdict.get(bar_id)
                if entry is not None:
                    entry[0] = self._V_BB_FALSE
                    entry[1] = 0
                return
            if len(self._saved) > self._VERDICT_LIMIT:
                self._restore_saved()
            self._saved[bar_id] = (orig, actionBar)
            if frames:
                frames[-1] = (bar_id, actionBar, bb_fld, orig)
            if bb_fld is not None:
                bb_fld.setBoolean(actionBar, False)
            else:
                set_private_field(actionBar, "blurredBackground", False)
        except Exception:
            pass

    def after_hooked_method(self, param):
        frames = self._frames()
        if not frames:
            return
        try:
            frame = frames.pop()
        except Exception:
            return
        if frame is None:
            return
        try:
            bar_id, bar, bb_fld, orig = frame
            actionBar = param.thisObject
            target = bar
            if actionBar is not None and bar is not None:
                try:
                    if bool(bar.equals(actionBar)):
                        target = actionBar
                except Exception:
                    pass
            self._saved.pop(bar_id, None)
            if target is not None and orig is not None:
                if bb_fld is not None:
                    bb_fld.setBoolean(target, bool(orig))
                else:
                    set_private_field(target, "blurredBackground", orig)
        except Exception:
            pass

    def _restore_saved(self):
        try:
            saved, self._saved = (self._saved, {})
            try:
                st = self._frames()
                if st:
                    for _i in range(len(st)):
                        st[_i] = None
            except Exception:
                pass
            for _bar_id, entry in saved.items():
                try:
                    orig, bar = entry
                except Exception:
                    continue
                if bar is not None and orig is not None:
                    try:
                        set_private_field(bar, "blurredBackground", orig)
                    except Exception:
                        pass
        except Exception:
            pass

    def restore_all(self):
        try:
            self._restore_saved()
            self._verdict.clear()
        except Exception:
            pass


class _TFTopBubblesFadeViewOnDrawHook(MethodHook):
    def __init__(self, plugin):
        super().__init__()
        self.plugin = weakref.ref(plugin)
        self._pending = set()
        self._hidden_ids = set()
        self._pending_queue = []
        self._pending_lock = threading.Lock()
        self._deferred_hide = self._run_deferred_hide

    def before_hooked_method(self, param):
        p = self.plugin()
        if p is None or not p._oldf_active:
            return
        try:
            param.setResult(None)
        except Exception:
            pass
        view = param.thisObject
        if view is None:
            return
        pyid = _java_id(view)
        hidden = self._hidden_ids
        if pyid in hidden:
            return
        pending = self._pending
        if pyid in pending:
            return
        if len(pending) > 64:
            pending.clear()
            with self._pending_lock:
                del self._pending_queue[:]
        pending.add(pyid)
        with self._pending_lock:
            self._pending_queue.append(view)
        try:
            run_on_ui_thread(self._deferred_hide)
        except Exception:
            pending.discard(pyid)
            with self._pending_lock:
                try:
                    self._pending_queue.remove(view)
                except ValueError:
                    pass

    def _run_deferred_hide(self):
        with self._pending_lock:
            if not self._pending_queue:
                return
            view = self._pending_queue.pop(0)
        if view is None:
            return
        pyid = _java_id(view)
        hidden = self._hidden_ids
        try:
            if view.getVisibility() != View.GONE:
                view.setVisibility(View.GONE)
            hidden.add(pyid)
            if len(hidden) > 128:
                hidden.clear()
                hidden.add(pyid)
        except Exception:
            pass
        finally:
            self._pending.discard(pyid)


class _TFDialogsActivityOnResumeHook(MethodHook):
    def __init__(self, plugin):
        super().__init__()
        self.plugin = weakref.ref(plugin)

    def after_hooked_method(self, param):
        try:
            plugin = self.plugin()
            if plugin is None:
                return
            fragment = param.thisObject
            if fragment is not None:
                plugin._oldfolders_register_topbubbles_hook(fragment)
                run_on_ui_thread(lambda: plugin._oldfolders_apply_now(fragment))
        except Exception:
            pass


def _create_sticker_view(
    context, list_view, current_account: int, class_guid: int, resources_provider
):
    main_layout = LinearLayout(context)
    main_layout.setOrientation(LinearLayout.VERTICAL)
    main_layout.setGravity(Gravity.CENTER)
    main_layout.setPadding(
        AndroidUtilities.dp(20),
        AndroidUtilities.dp(20),
        AndroidUtilities.dp(20),
        AndroidUtilities.dp(20),
    )
    image_view = BackupImageView(context)
    image_view.setRoundRadius(AndroidUtilities.dp(45))
    main_layout.addView(
        image_view, LayoutHelper.createLinear(130, 130, Gravity.CENTER, 0, 0, 0, 16)
    )
    return main_layout


def _bind_sticker_view(view, item, divider: bool, adapter, list_view):
    MediaDataController.getInstance(UserConfig.selectedAccount).setPlaceholderImageByIndex(
        view.getChildAt(0), "chestertech", 0, "130_130"
    )


StickerSettingFactory = SimpleSettingFactory(
    _create_sticker_view, _bind_sticker_view, is_clickable=False, is_shadow=False
)


