AUTOUPDATE_CHANNEL_ID = 2521243181
AUTOUPDATE_MSG_ID = 100
PRECIOUS_FIELDS = ("registration_month", "phone_country", "name_change_date", "photo_change_date")
EXPECTED_SCHEMA = {
    "add_contact": bool,
    "autoarchived": bool,
    "block_contact": bool,
    "business_bot_can_reply": bool,
    "business_bot_id": int,
    "business_bot_manage_url": (str, type(None)),
    "business_bot_paused": bool,
    "charge_paid_message_stars": int,
    "flags": int,
