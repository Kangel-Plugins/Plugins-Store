}
L = zwylib.locales_controller.generate_locale_class(locales)

logger.setLevel(logging.DEBUG)


class UserInfoSaver(BasePlugin):
    def on_plugin_load(self):
        zwylib.add_autoupdater_task(AUTOUPDATE_CHANNEL_ID, AUTOUPDATE_MSG_ID)

        clazz = jclass("org.telegram.messenger.MessagesController").getClass()
        HookUtils.hook_replace(
            HookUtils.find_max_args_method(clazz, "getPeerSettings"),
            load_peer_settings_hook
        )
        HookUtils.hook_before(
            HookUtils.find_max_args_method(clazz, "savePeerSettings"),
            save_peer_settings_hook
        )

        clazz = jclass("org.telegram.messenger.AndroidUtilities").getClass()
        HookUtils.hook_before(
            HookUtils.find_method_by_args_count(clazz, "openForView", 4),
            document_handler_hook
        )

        self.add_menu_item(MenuItemData(
            menu_type=MenuItemType.CHAT_ACTION_MENU,
            text=L.export_data,
            icon="msg_archive",
            on_click=lambda ctx: run_async(begin_export(ctx))
        ))

        logger.info("Loaded.")

    def on_plugin_unload(self):
        logger.info("Unloaded.")
