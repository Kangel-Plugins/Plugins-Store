import base64
import re
import zlib

from base_plugin import BasePlugin, MethodHook
from java import jclass
from org.telegram.messenger import ApplicationLoader


def raw_class(name):
    return jclass("java.lang.Class").forName(name)


CharSequence = jclass("java.lang.CharSequence")


__id__ = "wp"
__name__ = "WEB Proxy"
__description__ = "Ээээ короч диплинки там локал протик ещё какая-то хуйня типа крутяк ок"
__author__ = "@la_cringe"
__version__ = "1.0b"
__icon__ = "akresloh/0"
__app_version__ = ">=12.9.0"
__sdk_version__ = ">=1.4.5.1"

ENTRY_CLASS = "com.extera.webproxy.NativeWebProxyCore"
DEX_BEGIN = "__DEX_BEGIN__"
DEX_END = "__DEX_END__"
BuildVersion = jclass("android.os.Build$VERSION")

LINK_PATTERN = re.compile(
    r"^(?:tg://webproxy\?|tg:webproxy\?"
    r"|https?://(?:t\.me|telegram\.me|telegram\.dog)/webproxy\?)(.+)$",
    re.IGNORECASE,
)


class Dex:
    def __init__(self, entry_class):
        self.entry_class = entry_class
        self.clazz = None
        self.loaded = False

    def load(self):
        if self.loaded:
            return
        if self.clazz is None:
            context = ApplicationLoader.applicationContext
            if context is None:
                raise RuntimeError("application context is not ready")
            if BuildVersion.SDK_INT < 26:
                raise RuntimeError("embedded DEX requires Android API 26+")
            ByteBuffer = jclass("java.nio.ByteBuffer")
            Loader = jclass("dalvik.system.InMemoryDexClassLoader")
            loader = Loader(ByteBuffer.wrap(self._read_payload()), context.getClassLoader())
            self.clazz = loader.loadClass(self.entry_class)
        try:
            self.invoke("load")
            self.loaded = True
        except Exception:
            try:
                self.invoke("unload")
            except Exception:
                pass
            self.loaded = False
            raise

    def unload(self):
        try:
            if self.loaded and self.clazz is not None:
                self.invoke("unload")
        finally:
            self.loaded = False

    def invoke(self, name, *args):
        if self.clazz is None:
            raise RuntimeError("embedded DEX is not loaded")
        matches = []
        for method in self.clazz.getDeclaredMethods():
            if str(method.getName()) == name and len(method.getParameterTypes()) == len(args):
                method.setAccessible(True)
                matches.append(method)
        if len(matches) != 1:
            raise RuntimeError("DEX method unavailable: %s/%s" % (name, len(args)))
        try:
            return matches[0].invoke(None, *args)
        except Exception as error:
            cause = None
            try:
                cause = error.getCause()
            except Exception:
                pass
            raise RuntimeError(str(cause) if cause is not None else str(error))

    def _read_payload(self):
        with open(__file__, "r", encoding="utf-8") as source:
            text = source.read()
        try:
            block = text.split("# " + DEX_BEGIN, 1)[1].split("# " + DEX_END, 1)[0]
            encoded = "".join(
                line.strip()[1:].strip()
                for line in block.splitlines()
                if line.strip().startswith("#")
            )
            raw = zlib.decompress(base64.b64decode(encoded))
        except Exception as error:
            raise RuntimeError("embedded DEX decode failed: %s" % error)
        if raw[:4] != b"dex\n":
            raise RuntimeError("embedded DEX payload is invalid")
        return raw


class ProxyIntentHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        intent = None
        for value in param.args or []:
            try:
                if str(value.getClass().getName()) == "android.content.Intent":
                    intent = value
                    break
            except Exception:
                continue
        if intent is None:
            return
        try:
            data = intent.getData()
            if data is None:
                return
            parsed = self.plugin.parse_link(str(data))
        except Exception:
            return
        if parsed is None:
            return
        server, secret = parsed
        try:
            local = self.plugin.start_adapter(server, secret)
        except Exception as error:
            self.plugin.log("WEB proxy link failed: %s" % error)
            param.setResult(True)
            return
        port, local_secret = local
        Uri = jclass("android.net.Uri")
        intent.setData(Uri.parse(
            "tg://proxy?server=127.0.0.1&port=%d&secret=dd%s" % (port, local_secret)
        ))
        self.plugin.dex.invoke(
            "upsertEntry", ApplicationLoader.applicationContext, server, secret)
        self.plugin.pending_display = (server, port, local_secret, secret)


class SettingsCreateViewHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            injected = bool(self.plugin.dex.invoke("injectThirdType", param.thisObject))
        except Exception as error:
            self.plugin.log("WEB radio inject failed: %s" % error)
            return
        if not injected:
            return

        def try_restore():
            try:
                self.plugin.dex.invoke("restoreWebEditState", param.thisObject)
            except Exception as error:
                self.plugin.log("WEB edit restore failed: %s" % error)

        try_restore()
        from android_utils import run_on_ui_thread
        run_on_ui_thread(try_restore, 400)
        run_on_ui_thread(try_restore, 1200)


class ProxyTypeHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            requested = int(param.args[0])
        except Exception:
            return
        try:
            animated = bool(param.args[1]) if len(param.args) > 1 else True
        except Exception:
            animated = True
        if not animated:
            return
        try:
            self.plugin.dex.invoke("onProxyTypeSelected", param.thisObject, requested)
        except Exception as error:
            self.plugin.log("WEB type handling failed: %s" % error)


class SaveProxyHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        try:
            info = param.args[0]
            if info is None:
                return
            rewritten = bool(self.plugin.dex.invoke("rewriteForWeb", info))
            if rewritten:
                self.plugin.log("WEB Proxy: entry redirected to loopback adapter")
            else:
                addr = ''
                secret = ''
                try:
                    addr = str(info.getClass().getField('address').get(info))
                    secret = str(info.getClass().getField('secret').get(info))
                except Exception:
                    pass
                self.plugin.log("WEB rewrite skipped addr=%s secret=%s" % (addr, secret))
        except Exception as error:
            self.plugin.log("WEB rewrite failed: %s" % error)

    def after_hooked_method(self, param):
        try:
            named = bool(self.plugin.dex.invoke("applyWebNaming", param.getResult()))
            if named:
                self.plugin.log("WEB Proxy: entry titled with relay domain")
        except Exception as error:
            self.plugin.log("WEB naming failed: %s" % error)


class DisplayNameHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            result = param.getResult()
            replacement = self.plugin.dex.invoke(
                "displayNameHook", param.args[0], "" if result is None else str(result))
            if replacement:
                param.setResult(replacement)
        except Exception:
            pass


class TypeNameHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            result = param.getResult()
            replacement = self.plugin.dex.invoke(
                "typeNameHook", param.args[0], "" if result is None else str(result))
            if replacement:
                param.setResult(replacement)
        except Exception:
            pass


class CheckProxyHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        try:
            address = str(param.args[0])
            secret = str(param.args[5] or '')
            if address != '127.0.0.1' or not secret.startswith('dd'):
                return
            port = int(param.args[1])
            delegate = param.args[6]
            ms = int(self.plugin.dex.invoke('probeLocalPing', port))
            run_on_ui_thread(lambda: delegate.run(ms))
            param.setResult(1)
        except Exception:
            pass



class DeleteProxyHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        try:
            info = param.args[0]
            if info is None:
                return
            self.plugin.dex.invoke("deleteWebEntry", info)
        except Exception as error:
            self.plugin.log("WEB entry cleanup failed: %s" % error)


class ShareLinkHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            result = param.getResult()
            if result is None:
                return
            replacement = self.plugin.dex.invoke(
                "shareLinkHook", param.args[0], str(result))
            if replacement and replacement != str(result):
                param.setResult(replacement)
        except Exception:
            pass



class SheetRowHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        pending = getattr(self.plugin, 'pending_display', None)
        if not pending or len(param.args) < 2:
            return
        try:
            server, port, local_secret, web_secret = pending
            label = '' if param.args[0] is None else str(param.args[0])
            value = param.args[1]
            if value is None:
                return
            text = str(value)
            labels = self.plugin.proxy_type_labels()
            is_type_row = (label in labels) if labels \
                else self.plugin.pending_row_index() == 0
            self.plugin.pending_row_advance()
            if is_type_row:
                param.args[1] = 'WEB'
            elif text == '127.0.0.1':
                param.args[1] = server
            elif text == str(port):
                param.args[1] = '443'
            elif local_secret and text in ('dd' + local_secret, local_secret):
                param.args[1] = web_secret or value
        except Exception:
            pass


class SheetCloseHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        self.plugin.pending_display = None



class WebProxyNativePlugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self.dex = Dex(ENTRY_CLASS)
        self.hooks = []
        self.pending_display = None
        self._type_labels = None
        self._pending_rows = 0

    def proxy_type_labels(self):
        if self._type_labels is None:
            labels = []
            try:
                string_id = raw_class("org.telegram.R$string").getField("ProxyType").get(None)
                locale = raw_class("org.telegram.messenger.LocaleController")
                for m in locale.getDeclaredMethods():
                    if str(m.getName()) != "getString" or len(m.getParameterTypes()) != 1:
                        continue
                    if str(m.getParameterTypes()[0]) != "int":
                        continue
                    m.setAccessible(True)
                    labels.append(str(m.invoke(None, string_id)))
                    break
            except Exception:
                pass
            try:
                string_id = raw_class("org.telegram.R$string").getField("ProxyType").get(None)
                resources = ApplicationLoader.applicationContext.getResources()
                labels.append(str(resources.getString(string_id)))
            except Exception:
                pass
            self._type_labels = tuple(set(labels))
        return self._type_labels

    def pending_row_index(self):
        return self._pending_rows

    def pending_row_advance(self):
        self._pending_rows += 1

    def on_plugin_load(self):
        self.dex.load()
        self.install_hooks()
        try:
            restored = int(self.dex.invoke(
                "restoreEntries", ApplicationLoader.applicationContext))
            if restored:
                self.log("WEB proxy: restored %d relay(s)" % restored)
        except Exception as error:
            self.log("WEB proxy restore failed: %s" % error)

    def on_plugin_unload(self):
        for hook in self.hooks:
            try:
                self.unhook_method(hook)
            except Exception:
                pass
        self.hooks = []
        try:
            ours_active = bool(self.dex.invoke("isOurLoopbackActive"))
        except Exception:
            ours_active = False
        try:
            self.dex.invoke("stopAll")
        except Exception:
            pass
        if ours_active:
            self.apply_native(False, 1080, "")
        self.dex.unload()

    def install_hooks(self):
        utils = raw_class("org.telegram.messenger.AndroidUtilities")
        if utils is None:
            raise RuntimeError("AndroidUtilities not found")
        installed = 0
        for method in utils.getDeclaredMethods():
            name = str(method.getName())
            if name == "handleProxyIntent":
                handle = self.hook_method(method, ProxyIntentHook(self))
                if handle is not None:
                    self.hooks.append(handle)
                    installed += 1
        if installed == 0:
            raise RuntimeError("handleProxyIntent hook not installed")

        settings_cls = raw_class("org.telegram.ui.ProxySettingsActivity")
        if settings_cls is not None:
            for method in settings_cls.getDeclaredMethods():
                name = str(method.getName())
                if name == "createView" and len(method.getParameterTypes()) == 1:
                    handle = self.hook_method(method, SettingsCreateViewHook(self))
                    if handle is not None:
                        self.hooks.append(handle)

            type_overloads = [m for m in settings_cls.getDeclaredMethods()
                              if str(m.getName()) == "setProxyType"]
            for method in type_overloads:
                handle = self.hook_method(method, ProxyTypeHook(self))
                if handle is not None:
                    self.hooks.append(handle)

        controller = raw_class("com.exteragram.messenger.proxy.ProxyController")
        if controller is not None:
            for method in controller.getDeclaredMethods():
                if str(method.getName()) != "saveProxy":
                    continue
                types = method.getParameterTypes()
                if len(types) == 3 and str(types[0]).endswith("SharedConfig$ProxyInfo"):
                    handle = self.hook_method(method, SaveProxyHook(self))
                    if handle is not None:
                        self.hooks.append(handle)

        cm = raw_class("org.telegram.tgnet.ConnectionsManager")
        if cm is not None:
            for method in cm.getDeclaredMethods():
                if str(method.getName()) != "checkProxy":
                    continue
                types = method.getParameterTypes()
                if len(types) == 7 and types[0] == jclass("java.lang.String"):
                    handle = self.hook_method(method, CheckProxyHook(self))
                    if handle is not None:
                        self.hooks.append(handle)

        for method in controller.getDeclaredMethods():
            if str(method.getName()) != "buildShareLink":
                continue
            types = method.getParameterTypes()
            if len(types) >= 1 and str(types[0]).endswith("SharedConfig$ProxyInfo"):
                handle = self.hook_method(method, ShareLinkHook(self))
                if handle is not None:
                    self.hooks.append(handle)

        table_view = raw_class("org.telegram.ui.Components.TableView")
        if table_view is not None:
            for method in table_view.getDeclaredMethods():
                if str(method.getName()) != "addRow":
                    continue
                types = method.getParameterTypes()
                if len(types) >= 2 and types[0] == CharSequence and types[1] == CharSequence:
                    handle = self.hook_method(method, SheetRowHook(self))
                    if handle is not None:
                        self.hooks.append(handle)

        for method in utils.getDeclaredMethods():
            if str(method.getName()) == "showProxyAlert":
                handle = self.hook_method(method, SheetCloseHook(self))
                if handle is not None:
                    self.hooks.append(handle)
                break

        for method in controller.getDeclaredMethods():
            if str(method.getName()) != "deleteProxy":
                continue
            types = method.getParameterTypes()
            if len(types) == 1 and str(types[0]).endswith("SharedConfig$ProxyInfo"):
                handle = self.hook_method(method, DeleteProxyHook(self))
                if handle is not None:
                    self.hooks.append(handle)

        for class_name, method_name, hook_cls in (
            ("com.exteragram.messenger.proxy.ProxyController", "getDisplayName", DisplayNameHook),
            ("com.exteragram.messenger.proxy.ProxyController", "getProxyTypeName", TypeNameHook),
        ):
            target = raw_class(class_name)
            if target is None:
                continue
            for method in target.getDeclaredMethods():
                if str(method.getName()) == method_name and len(method.getParameterTypes()) == 1:
                    handle = self.hook_method(method, hook_cls(self))
                    if handle is not None:
                        self.hooks.append(handle)

    def parse_link(self, value):
        match = LINK_PATTERN.match((value or "").strip())
        if not match:
            return None
        fields = {}
        for pair in match.group(1).split("&"):
            key, separator, data = pair.partition("=")
            if separator:
                fields[key.lower()] = data.strip()
        server = fields.get("server") or fields.get("host") or ""
        secret = (fields.get("secret") or "").lower()
        if not re.match(r"^[A-Za-z0-9.-]+\.[A-Za-z]{2,}$", server):
            return None
        if not re.match(r"^(?:dd)?[0-9a-f]{32}$", secret):
            return None
        return server, secret

    def start_adapter(self, server, secret):
        result = str(self.dex.invoke("prepare", server, secret))
        if result.startswith("error:"):
            raise RuntimeError(result[6:])
        port, _, local_secret = result.partition(":")
        return int(port), local_secret

    def apply_native(self, enabled, port, secret):
        try:
            from org.telegram.tgnet import ConnectionsManager
            ConnectionsManager.setProxySettings(enabled, "127.0.0.1", port, "", "", secret)
        except Exception as error:
            self.notify("Could not apply proxy: %s" % error)

