from base_plugin import BasePlugin
from hook_utils import find_class
from org.telegram.messenger import AndroidUtilities
from org.telegram.ui.ActionBar import Theme
from org.telegram.ui.Components import LayoutHelper
from android.view import ViewGroup, View, Gravity
from android.widget import FrameLayout, LinearLayout
from java import jint, jfloat
from extera_utils.classes import Base, java_subclass, joverride

__id__ = "md3_navbars_everywhere"
__name__ = "MD3 Navbars Everywhere"
__description__ = "Applies MD3-styled navbars to attach menu, statistics and gifts preview screens. Requires exteraGram's MD3 navbar to be on."
__author__ = "@Slucket"
__version__ = "1.0.0"
__app_version__ = ">=12.9.0"
__sdk_version__ = ">=1.4.4.3"

def is_md3_enabled() -> bool:
    helper = find_class("com.exteragram.messenger.utils.ui.MainTabsUiHelper")
    return helper.isMaterial3NavigationBar() if helper else False

def is_divider_enabled() -> bool:
    cfg = find_class("com.exteragram.messenger.ExteraConfig")
    return str(cfg.getDividerStyle()) != "HIDDEN" if cfg and hasattr(cfg, "getDividerStyle") else True

def fix_original_background(view):
    bg = view.getBackground()
    if not bg: return
    try:
        if "InsetDrawable" in bg.getClass().getName():
            bg = bg.JA.getDrawable()
            view.setBackground(bg)
        
        if hasattr(bg, "setRadius"): bg.JA.setRadius(jfloat(0.0))
        elif hasattr(bg, "setCornerRadius"): bg.JA.setCornerRadius(jfloat(0.0))
        
        if hasattr(bg, "setPadding"): bg.JA.setPadding(jint(0))
        
        if hasattr(bg, "getPaint"):
            paint = bg.JA.getPaint()
            if paint and hasattr(paint, "clearShadowLayer"):
                paint.clearShadowLayer()
    except Exception: pass

def style_glass_tabs(tabs_view):
    try:
        tabs = []
        if hasattr(tabs_view.JA, "tabs"): tabs.extend([t for t in tabs_view.JA.tabs if t])
        elif hasattr(tabs_view.JA, "getTabs"): tabs.extend([t for t in tabs_view.JA.getTabs() if t])
        
        if not tabs and isinstance(tabs_view, ViewGroup):
            def find_tabs(vg):
                for i in range(vg.getChildCount()):
                    child = vg.getChildAt(i)
                    if child and child.getClass().getSimpleName() == "GlassTabView": tabs.append(child)
                    elif isinstance(child, ViewGroup): find_tabs(child)
            find_tabs(tabs_view)

        for tab in tabs:
            if hasattr(tab.JA, "setMainTabStyle"): tab.JA.setMainTabStyle()
            if hasattr(tab.JA, "selfMeasure"): tab.JA.selfMeasure = False
            
            lp = tab.getLayoutParams()
            if isinstance(lp, LinearLayout.LayoutParams) and (lp.width != 0 or lp.weight != 1.0):
                lp.width, lp.weight = 0, 1.0
                tab.setLayoutParams(lp)
                
            if hasattr(tab.JA, "textView") and tab.JA.textView:
                tab.JA.textView.setTypeface(AndroidUtilities.bold())
            if hasattr(tab.JA, "isTabSelected") and hasattr(tab.JA, "setSelected"):
                tab.JA.setSelected(tab.JA.isTabSelected(), False)
    except Exception: pass

def setup_md3_navbar(tabs_view, nav_height, apply_padding=True, add_divider=True):
    if not tabs_view: return
    lp = tabs_view.getLayoutParams()
    if isinstance(lp, FrameLayout.LayoutParams):
        lp.width, lp.height = LayoutHelper.MATCH_PARENT, AndroidUtilities.dp(64) + int(nav_height)
        lp.leftMargin = lp.rightMargin = lp.bottomMargin = lp.topMargin = 0
        tabs_view.setLayoutParams(lp)
        
    pad = AndroidUtilities.dp(12) if apply_padding else 0
    tabs_view.setPadding(pad, 0, pad, int(nav_height))
    tabs_view.setClipToPadding(False)
    tabs_view.setTranslationY(jfloat(0.0))
    fix_original_background(tabs_view)
    
    try:
        if hasattr(tabs_view.JA, "setLensColor"): tabs_view.JA.setLensColor(jint(0), jint(0))
        if hasattr(tabs_view.JA, "setFillAvailableWidth"): tabs_view.JA.setFillAvailableWidth(True)
    except Exception: pass
        
    if add_divider:
        div_needed = is_divider_enabled()
        if hasattr(tabs_view.JA, "setDrawTopDivider"):
            tabs_view.JA.setDrawTopDivider(div_needed)
            tabs_view.invalidate()
            return
            
        divider = tabs_view.findViewWithTag("md3_custom_divider")
        if div_needed:
            if not divider:
                divider = View(tabs_view.getContext())
                divider.setBackgroundColor(Theme.getColor(Theme.key_divider))
                divider.setTag("md3_custom_divider")
                div_lp = FrameLayout.LayoutParams(LayoutHelper.MATCH_PARENT, max(1, AndroidUtilities.dp(0.5)))
                div_lp.gravity = Gravity.TOP
                tabs_view.addView(divider, div_lp)
            divider.setVisibility(0)
        elif divider:
            divider.setVisibility(8)

@java_subclass(View)
class M3DividerView(Base):
    @joverride()
    def onDraw(self, canvas):
        if not is_divider_enabled(): return
        paint = getattr(Theme, "forcedDividerPaint", None) or getattr(Theme, "dividerPaint", None)
        if paint:
            old_alpha = paint.getAlpha()
            paint.setAlpha(int(old_alpha * 0.8))
            canvas.drawRect(0.0, 0.0, float(self.java.getMeasuredWidth()), AndroidUtilities.dpf2(0.5), paint)
            paint.setAlpha(old_alpha)

class MD3NavbarsPlugin(BasePlugin):
    def on_plugin_load(self):
        self.force_m3 = 0
        self.hooked_classes = set()

        helper = find_class("com.exteragram.messenger.utils.ui.MainTabsUiHelper")
        if helper: self.hook_all_methods(helper, "isMaterial3NavigationBar", before=self.force_m3_check)

        AttachAlert = find_class("org.telegram.ui.Components.ChatAttachAlert")
        if AttachAlert: self.hook_all_methods(AttachAlert, "init", after=self.after_init)

        BtnAdapter = find_class("org.telegram.ui.Components.ChatAttachAlert$ButtonsAdapter")
        if BtnAdapter:
            self.hook_all_methods(BtnAdapter, "onCreateViewHolder", after=self.after_onCreateViewHolder)
            self.hook_all_methods(BtnAdapter, "onBindViewHolder", after=self.after_onBindViewHolder)

        GlassTab = find_class("org.telegram.ui.Components.glass.GlassTabView")
        if GlassTab:
            self.hook_all_methods(GlassTab, "setAdditionalWidth", before=self.before_setAdditionalWidth)
            for m in ["setSelected", "setTabAnimation", "setAttachBot", "setAttachBotUser"]:
                self.hook_all_methods(GlassTab, m, before=self.inc_m3, after=self.dec_m3_and_style)

        StatActivity = find_class("org.telegram.ui.StatisticActivity")
        if StatActivity:
            self.hook_all_methods(StatActivity, "createView", after=self.on_statistic)
            self.hook_all_methods(StatActivity, "checkUi_listPaddings", after=self.on_statistic)
        
        GiftSheet = find_class("org.telegram.ui.Stars.StarGiftPreviewSheet")
        if GiftSheet:
            self.hook_all_constructors(GiftSheet, after=self.on_stargift)
            self.hook_all_methods(GiftSheet, "applyBottomInset", after=self.on_stargift)

        self.log("MD3 Navbars Everywhere loaded (Optimized).")

    def force_m3_check(self, param):
        if self.force_m3 > 0: param.setResult(True)

    def inc_m3(self, param):
        if is_md3_enabled(): self.force_m3 += 1

    def dec_m3_and_style(self, param):
        if not is_md3_enabled(): return
        self.force_m3 -= 1
        if param.method.getName() in ["setAttachBot", "setAttachBotUser"]:
            try:
                m = param.thisObject.getClass().getDeclaredMethod("setMainTabStyle")
                m.setAccessible(True)
                m.invoke(param.thisObject)
            except Exception: pass

    def on_statistic(self, param):
        if not is_md3_enabled(): return
        tabs = param.thisObject.JA.tabsView
        if tabs:
            setup_md3_navbar(tabs, AndroidUtilities.navigationBarHeight, apply_padding=False)
            style_glass_tabs(tabs)

    def on_stargift(self, param):
        if not is_md3_enabled(): return
        sheet = param.thisObject
        nav_h = int(sheet.JA.lastBottomInset) if hasattr(sheet.JA, "lastBottomInset") else AndroidUtilities.navigationBarHeight
        tabs = sheet.JA.tabsSelectorView
        
        setup_md3_navbar(tabs, nav_h, apply_padding=True, add_divider=False)
        style_glass_tabs(tabs)
        
        if not tabs.findViewWithTag("m3_divider"):
            div = M3DividerView.new_instance(tabs.getContext())
            div.java.setWillNotDraw(False)
            div.java.setTag("m3_divider")
            lp = FrameLayout.LayoutParams(LayoutHelper.MATCH_PARENT, max(1, AndroidUtilities.dp(0.5)))
            lp.gravity, pad = Gravity.TOP, AndroidUtilities.dp(12)
            lp.leftMargin = lp.rightMargin = -pad
            tabs.addView(div.java, lp)

    def after_init(self, param):
        if not is_md3_enabled(): return
        alert = param.thisObject
        wrapper, recycler = alert.JA.buttonsRecyclerViewWrapper, alert.JA.buttonsRecyclerView
        if not wrapper or not recycler: return

        w_cls, r_cls = wrapper.getClass().getName(), recycler.getClass().getName()
        
        if w_cls not in self.hooked_classes:
            cls = find_class(w_cls)
            self.hook_all_methods(cls, "onMeasure", before=self.before_wrapper_onMeasure, after=self.after_wrapper_onMeasure)
            self.dispatch_draw_hooked = bool(self.hook_all_methods(cls, "dispatchDraw", after=self.after_wrapper_dispatchDraw))
            self.hooked_classes.add(w_cls)

        if r_cls not in self.hooked_classes:
            cls = find_class(r_cls)
            self.hook_all_methods(cls, "onMeasure", before=self.before_recycler_onMeasure, after=self.after_recycler_onMeasure)
            self.hook_all_methods(cls, "dispatchDraw", before=self.inc_m3, after=self.dec_m3_and_style)
            self.hooked_classes.add(r_cls)

        lp = wrapper.getLayoutParams()
        lp.width, lp.height = -1, AndroidUtilities.dp(64) + AndroidUtilities.navigationBarHeight
        lp.bottomMargin = -AndroidUtilities.navigationBarHeight
        wrapper.setLayoutParams(lp)

        bg = wrapper.getBackground()
        if bg:
            if hasattr(bg, "setPadding"):
                try: bg.setPadding(0)
                except Exception: pass
            if hasattr(bg, "setRadius"):
                try: bg.setRadius(0.0)
                except Exception:
                    try: bg.setRadius(0)
                    except Exception: pass

        recycler.setClipToOutline(False)
        recycler.setOutlineProvider(None)

        if not getattr(self, "dispatch_draw_hooked", False) and not wrapper.findViewWithTag("m3_divider"):
            div = M3DividerView.new_instance(wrapper.getContext())
            div.java.setWillNotDraw(False)
            div.java.setTag("m3_divider")
            wrapper.addView(div.java, LayoutHelper.createFrame(-1, 0.5, 48))

        shift = AndroidUtilities.dp(24)
        rlp = recycler.getLayoutParams()
        rlp.width, rlp.leftMargin, rlp.rightMargin = -1, -shift, -shift
        recycler.setLayoutParams(rlp)
        
        wrapper.setClipChildren(True)
        OutlineProvider = find_class("android.view.ViewOutlineProvider")
        if OutlineProvider:
            wrapper.setOutlineProvider(OutlineProvider.BOUNDS)
            wrapper.setClipToOutline(True)

    def after_wrapper_dispatchDraw(self, param):
        if not is_md3_enabled() or not is_divider_enabled(): return
        paint = getattr(Theme, "forcedDividerPaint", None) or getattr(Theme, "dividerPaint", None)
        if paint:
            old_alpha = paint.getAlpha()
            paint.setAlpha(int(old_alpha * 0.8))
            param.args[0].drawRect(0.0, 0.0, float(param.thisObject.getMeasuredWidth()), AndroidUtilities.dpf2(0.5), paint)
            paint.setAlpha(old_alpha)

    def before_wrapper_onMeasure(self, param):
        if not is_md3_enabled(): return
        alert = getattr(param.thisObject.JA, "this$0", None)
        if alert:
            self.orig_poll = alert.JA.pollAllowedLayouts
            if self.orig_poll is not None: alert.JA.pollAllowedLayouts = jint(0)
            recycler = alert.JA.buttonsRecyclerView
            if recycler:
                nav_h, shift = AndroidUtilities.navigationBarHeight, AndroidUtilities.dp(24)
                pad = shift if alert.JA.isPollAttach else AndroidUtilities.dp(10) + shift
                if recycler.getPaddingLeft() != pad:
                    recycler.setPadding(pad, 0, pad, nav_h)

    def after_wrapper_onMeasure(self, param):
        if not is_md3_enabled(): return
        alert = getattr(param.thisObject.JA, "this$0", None)
        if alert and hasattr(self, "orig_poll") and self.orig_poll is not None:
            alert.JA.pollAllowedLayouts = jint(self.orig_poll)

    def before_recycler_onMeasure(self, param):
        if not is_md3_enabled(): return
        alert = getattr(param.thisObject.JA, "this$0", None)
        if alert: self.disable_add_width = not alert.JA.isPollAttach

    def after_recycler_onMeasure(self, param):
        self.disable_add_width = False

    def before_setAdditionalWidth(self, param):
        if is_md3_enabled() and getattr(self, "disable_add_width", False):
            param.args[0] = jint(0)

    def after_onCreateViewHolder(self, param):
        if not is_md3_enabled() or not param.getResult(): return
        tab = param.getResult().itemView.JA.glassTabView
        if tab:
            try:
                self.force_m3 += 1
                m = tab.getClass().getDeclaredMethod("setMainTabStyle")
                m.setAccessible(True)
                m.invoke(tab)
            except Exception: pass
            finally: self.force_m3 -= 1

    def after_onBindViewHolder(self, param):
        if not is_md3_enabled(): return
        adapter = param.thisObject
        alert = getattr(adapter.JA, "this$0", None)
        if not alert: return

        lp = param.args[0].itemView.getLayoutParams()
        if not alert.JA.isPollAttach:
            count = adapter.JA.buttonsCount if adapter.JA.buttonsCount is not None else adapter.getItemCount()
            lp.rightMargin = AndroidUtilities.dp(8) if param.args[1] < count - 1 else 0
        else:
            lp.rightMargin = 0
            
        lp.leftMargin = 0
        param.args[0].itemView.setLayoutParams(lp)