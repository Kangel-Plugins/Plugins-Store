OPEN_MODE_ITEMS = [
    ("内置浏览器打开（推荐）", "builtin"),
    ("应用内悬浮窗打开", "float"),
]


def _c32(val):
    val = int(val) & 0xFFFFFFFF
    if val > 0x7FFFFFFF:
        val -= 0x100000000
    return val


def _safe_theme_color(theme_cls, attr_name, fallback):
    if theme_cls is None:
        return _c32(fallback)
    try:
        key = getattr(theme_cls, attr_name, None)
        if key is None:
            return _c32(fallback)
        return _c32(theme_cls.getColor(key))
    except BaseException:
        return _c32(fallback)


def _round_bg(color, radius_px, stroke_px=0, stroke_color=0):
    d = GradientDrawable()
    d.setShape(GradientDrawable.RECTANGLE)
    d.setColor(_c32(color))
    d.setCornerRadius(float(radius_px))
    if stroke_px > 0:
        d.setStroke(int(stroke_px), _c32(stroke_color))
    return d


def _get_activity():
    try:
        frag = get_last_fragment()
        if frag is not None:
            act = frag.getParentActivity()
            if act is not None:
                return act
    except BaseException:
        pass
    try:
        return find_class("org.telegram.ui.LaunchActivity").instance
    except BaseException:
        return None


class _OpenUrlHook(MethodHook):
    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin

    def before_hooked_method(self, param):
        try:
            if not self.plugin.get_setting("auto_intercept", True):
                return
            if self.plugin._is_bypassed():
                return

            args = param.args
            if not args or len(args) < 2 or args[1] is None:
                return

            arg1 = args[1]
            is_str = isinstance(arg1, str)
            is_uri = False
            if not is_str:
                try:
                    cls_name = str(arg1.getClass().getName())
                    is_uri = "android.net.Uri" in cls_name or cls_name.endswith("Uri")
                except BaseException:
                    is_uri = False

            if not is_str and not is_uri:
                return

            raw_url = arg1.strip() if is_str else str(arg1).strip()
            if not raw_url:
                return

            low = raw_url.lower()
            if not (low.startswith("http://") or low.startswith("https://")):
                return

            if not self.plugin.should_translate_url(raw_url):
                self.plugin._log("SKIP", f"放行链接: {self.plugin._short_url(raw_url)}")
                return

            mode = self.plugin._get_open_mode()
            if mode == "float":
                param.setResult(None)
                now = time.monotonic()
                if (
                    raw_url == self.plugin._last_hook_url
                    and (now - self.plugin._last_hook_ts) < 0.45
                ):
                    return
                self.plugin._last_hook_url = raw_url
                self.plugin._last_hook_ts = now
                self.plugin._log("FLOAT", f"悬浮窗拦截翻译: {self.plugin._short_url(raw_url)}")
                run_on_ui_thread(lambda u=raw_url: self.plugin.show_translated_float(u))
            else:
                new_url = self.plugin.to_translate_url(raw_url)
                if not new_url or new_url == raw_url:
                    return
                self.plugin._last_url = new_url
                if is_str:
                    param.args[1] = new_url
                elif Uri is not None:
                    param.args[1] = Uri.parse(new_url)
                self.plugin._log("BUILTIN", f"内置浏览器翻译: {self.plugin._short_url(raw_url)}")
        except BaseException as err:
            self.plugin._log("ERROR", f"拦截外链异常: {err}")


class UnifiedTranslatePlugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self._hook_refs = []
        self._bypass_until = 0.0
        self._last_hook_url = ""
        self._last_hook_ts = 0.0

        self._wm = None
        self._root = None
        self._root_bg = None
        self._lp = None
        self._webview = None
        self._content_box = None
        self._bar_row = None
        self._bubble_btn = None
        self._btn_toggle = None
        self._btn_kb = None

        self._minimized = False
        self._focusable = False
        self._accent_col = _c32(0xFF3A8DFF)
        self._text_col = _c32(0xFFFFFFFF)

        self._win_w = 0
        self._win_x = 0
        self._win_y = 0
        self._saved_x = 0
        self._saved_y = 0
        self._drag_x = 0.0
        self._drag_y = 0.0
        self._drag_ox = 0
        self._drag_oy = 0
        self._b_drag_x = 0.0
        self._b_drag_y = 0.0
        self._b_ox = 0
        self._b_oy = 0
        self._b_moved = False
        self._last_url = ""
        self._logs = []

    def create_settings(self):
        mode_idx = self.get_setting("open_mode_idx", 0)
        if not isinstance(mode_idx, int) or not (0 <= mode_idx < len(OPEN_MODE_ITEMS)):
            mode_idx = 0

        lang_idx = self.get_setting("lang_idx", 0)
        if not isinstance(lang_idx, int) or not (0 <= lang_idx < len(GOOGLE_TRANSLATE_LANGUAGES)):
            lang_idx = 0

        return [
            Divider(text="基础设置"),
            Switch(
                key="auto_intercept",
                text="点击外部链接自动网页翻译",
                subtext="自动识别源语言并翻译为目标语言；默认放行 t.me 频道/消息链接",
                default=self.get_setting("auto_intercept", True),
            ),
            Selector(
                key="open_mode_idx",
                text="打开方式",
                items=[x[0] for x in OPEN_MODE_ITEMS],
                default=mode_idx,
            ),
            Selector(
                key="lang_idx",
                text="目标翻译语言（支持全部谷歌语言）",
                items=[x[0] for x in GOOGLE_TRANSLATE_LANGUAGES],
                default=lang_idx,
            ),
            Input(
                key="custom_lang_code",
                text="手动输入语言代码（可选，优先于上方列表）",
                default=self.get_setting("custom_lang_code", ""),
            ),
            Input(
                key="custom_cmd",
                text="自定义翻译指令前缀",
                default=self.get_setting("custom_cmd", ".tr"),
            ),
            Divider(text="域名白名单与免翻译列表"),
            Input(
                key="force_whitelist",
                text="强制翻译白名单（逗号分隔）",
                subtext="填入 t.me 后，t.me 首页会翻译，但带路径如 t.me/Mkataba/1615 依然不翻",
                default=self.get_setting("force_whitelist", ""),
            ),
            Input(
                key="skip_domains",
                text="免翻译域名列表（逗号分隔）",
                subtext="填入不想走翻译的网站（如 wiki.com, baidu.com），直接原样打开",
                default=self.get_setting("skip_domains", ""),
            ),
            Divider(text="诊断与排障"),
            Text(
                text="运行与报错日志记录",
                icon="msg_log",
                subtext="查看最近拦截分流轨迹与异常报错，支持一键复制排查",
                on_click=lambda v=None: run_on_ui_thread(self._show_logs_dialog),
            ),
        ]

    def _short_url(self, url: str, limit: int = 64) -> str:
        s = (url or "").strip()
        if len(s) <= limit:
            return s
        return s[: limit - 3] + "..."

    def _log(self, level: str, msg: str):
        try:
            ts = datetime.datetime.now().strftime("%H:%M:%S")
            line = f"[{ts}] [{level}] {msg}"
            self._logs.append(line)
            if len(self._logs) > 50:
                del self._logs[:-50]
        except BaseException:
            pass

    def on_plugin_load(self):
        self._hook_refs = []
        self._bypass_until = 0.0
        self._last_hook_url = ""
        self._last_hook_ts = 0.0
        try:
            self.add_on_send_message_hook()
        except BaseException as err:
            self._log("ERROR", f"挂载发送指令 Hook 失败: {err}")
        self._install_url_hooks()

    def on_plugin_unload(self):
        for ref in list(self._hook_refs):
            try:
                self.unhook_method(ref)
            except BaseException:
                pass
        self._hook_refs = []
        self._bypass_until = 0.0
        self._last_hook_url = ""
        self._last_hook_ts = 0.0
        run_on_ui_thread(self.close_float)

    def _install_url_hooks(self):
        if Browser is None:
            self._log("ERROR", "未找到 Browser 类，外链自动拦截未生效")
            return
        try:
            count = 0
            for m in list(Browser.getClass().getDeclaredMethods()):
                if str(m.getName()) == "openUrl":
                    try:
                        ref = self.hook_method(m, _OpenUrlHook(self))
                        if ref is not None:
                            self._hook_refs.append(ref)
                            count += 1
                    except BaseException as err:
                        self._log("ERROR", f"挂载 openUrl 重载失败: {err}")
            if count > 0:
                self._log("INFO", f"插件加载完成，已挂载 {count} 个 openUrl 入口")
            else:
                self._log("WARN", "未挂载到任何 openUrl 方法")
        except BaseException as err:
            self._log("ERROR", f"扫描 Browser.openUrl 异常: {err}")

    def _is_bypassed(self) -> bool:
        return time.monotonic() < self._bypass_until

    def _get_open_mode(self) -> str:
        idx = self.get_setting("open_mode_idx", 0)
        if isinstance(idx, int) and 0 <= idx < len(OPEN_MODE_ITEMS):
            return OPEN_MODE_ITEMS[idx][1]
        return "builtin"

    def _target_lang(self) -> str:
        custom = str(self.get_setting("custom_lang_code", "") or "").strip()
        if custom and re.match(r"^[a-zA-Z]{2,3}(-[a-zA-Z0-9]{2,8})*$", custom):
            return custom
        idx = self.get_setting("lang_idx", 0)
        if isinstance(idx, int) and 0 <= idx < len(GOOGLE_TRANSLATE_LANGUAGES):
            return GOOGLE_TRANSLATE_LANGUAGES[idx][1]
        return "zh-CN"

    def _parse_domain_list(self, setting_key: str):
        raw = str(self.get_setting(setting_key, "") or "")
        out = []
        for item in re.split(r"[,，;\s]+", raw):
            d = item.strip().lower()
            if not d:
                continue
            if "://" in d:
                try:
                    d = (urllib.parse.urlsplit(d).hostname or "").lower()
                except BaseException:
                    pass
            d = d.lstrip(".").rstrip(".")
            if d:
                out.append(d)
        return out

    def _host_matches(self, host: str, domain_list) -> bool:
        for d in domain_list:
            if host == d or host.endswith("." + d):
                return True
        return False

    def is_telegram_domain(self, host: str) -> bool:
        return any(host == d or host.endswith("." + d) for d in TELEGRAM_ROOT_DOMAINS)

    def is_translated_url(self, url: str) -> bool:
        try:
            host = (urllib.parse.urlsplit(url).hostname or "").lower().rstrip(".")
            return host.endswith(".translate.goog") or host in (
                "translate.google.com",
                "translate.googleusercontent.com",
            )
        except BaseException:
            return False

    def should_translate_url(self, url: str) -> bool:
        """
        核心分流规则：
        1. 非 http/https、已翻译页、无域名/带端口/IP/localhost -> 不翻
        2. 命中免翻译列表 (skip_domains) -> 不翻
        3. 电报自有域名 (t.me / telegram.me 等)：
           - 带具体路径 (如 t.me/Mkataba/1615, t.me/+xxx) -> 即使 t.me 在白名单里也永远不翻
           - 仅根首页 (如 https://t.me 或 https://t.me/) -> 仅当 t.me 在强制翻译白名单里时才翻
        4. 其余普通外语外链 -> 翻译
        """
        try:
            p = urllib.parse.urlsplit(url.strip())
            if (p.scheme or "").lower() not in ("http", "https"):
                return False
            host = (p.hostname or "").lower().rstrip(".")
            if not host or p.port is not None:
                return False
            if self.is_translated_url(url):
                return False
            if host == "localhost" or re.match(r"^[\d.:]+$", host):
                return False

            skip_list = self._parse_domain_list("skip_domains")
            if self._host_matches(host, skip_list):
                return False

            whitelist = self._parse_domain_list("force_whitelist")
            in_whitelist = self._host_matches(host, whitelist)

            if self.is_telegram_domain(host):
                path = (p.path or "").strip()
                has_subpath = bool(path and path != "/") or bool(p.query)
                if has_subpath:
                    return False
                return in_whitelist

            return True
        except BaseException:
            return False

    def to_translate_url(self, url: str, bypass_check: bool = False) -> str:
        try:
            if not bypass_check and not self.should_translate_url(url):
                return url
            p = urllib.parse.urlsplit(url.strip())
            scheme = (p.scheme or "").lower()
            if scheme not in ("http", "https"):
                return url
            host = (p.hostname or "").lower().rstrip(".")
            if not host or p.port is not None or self.is_translated_url(url):
                return url
            if host == "localhost" or re.match(r"^[\d.:]+$", host):
                return url

            try:
                ascii_host = host.encode("idna").decode("ascii")
            except BaseException:
                ascii_host = host

            trans_host = ascii_host.replace("-", "--").replace(".", "-") + ".translate.goog"
            lang = self._target_lang()
            q = urllib.parse.parse_qs(p.query, keep_blank_values=True)
            q["_x_tr_sl"] = ["auto"]
            q["_x_tr_tl"] = [lang]
            q["_x_tr_hl"] = [lang]
            q["_x_tr_pto"] = ["wapp"]
            if scheme == "http":
                q["_x_tr_sch"] = ["http"]

            path = p.path if p.path else "/"
            return urllib.parse.urlunsplit(
                ("https", trans_host, path, urllib.parse.urlencode(q, doseq=True), p.fragment)
            )
        except BaseException:
            return url

    def from_translate_url(self, url: str) -> str:
        try:
            p = urllib.parse.urlsplit(url.strip())
            host = (p.hostname or "").lower().rstrip(".")
            if not host.endswith(".translate.goog"):
                return url
            raw_host = host[:-len(".translate.goog")]
            orig_host = raw_host.replace("--", "\x00").replace("-", ".").replace("\x00", "-")
            q = urllib.parse.parse_qs(p.query, keep_blank_values=True)
            orig_scheme = "http" if q.get("_x_tr_sch") == ["http"] else "https"
            clean_q = {k: v for k, v in q.items() if not k.startswith("_x_tr_")}
            return urllib.parse.urlunsplit(
                (orig_scheme, orig_host, p.path, urllib.parse.urlencode(clean_q, doseq=True), p.fragment)
            )
        except BaseException:
            return url

    def _extract_url(self, text: str) -> str:
        s = (text or "").strip()
        if not s:
            return ""
        trail_chars = ".,;:!?)]}。，！？》】）\"'"
        m = re.search(r"https?://[^\s<>\"']+", s, re.I)
        if m:
            return m.group(0).rstrip(trail_chars)
        tok = s.split()[0].strip("([{\"'<《【（").rstrip(trail_chars)
        if re.match(r"^[a-zA-Z0-9][-a-zA-Z0-9]{0,62}(\.[a-zA-Z]{2,})+(/.*)?$", tok):
            return "https://" + tok
        return ""

    # ==================== 自定义指令分发 ====================
    def on_send_message_hook(self, account, params) -> HookResult:
        try:
            if not isinstance(getattr(params, "message", None), str):
                return HookResult()
            raw = params.message.strip()
            if not raw:
                return HookResult()

            cmd = str(self.get_setting("custom_cmd", ".tr") or ".tr").strip() or ".tr"
            parts = raw.split(None, 1)
            if parts[0].lower() != cmd.lower():
                return HookResult()

            mode = self._get_open_mode()
            arg = parts[1].strip() if len(parts) > 1 else ""

            if not arg:
                if mode == "float" and self._is_window_alive() and self._minimized:
                    run_on_ui_thread(self._expand)
                    return HookResult(strategy=HookStrategy.CANCEL, params=params)
                target = self._last_url
            else:
                target = self._extract_url(arg)

            if not target:
                BulletinHelper.show_info(f"用法：{cmd} <外语网址>")
                return HookResult(strategy=HookStrategy.CANCEL, params=params)

            if mode == "float":
                run_on_ui_thread(lambda u=target: self.show_translated_float(u, force_trans=True))
            else:
                run_on_ui_thread(lambda u=target: self._open_in_builtin_browser(u, force_trans=True))
            return HookResult(strategy=HookStrategy.CANCEL, params=params)
        except BaseException:
            return HookResult()

    # ==================== 内置浏览器模式与日志弹窗 ====================
    def _open_in_builtin_browser(self, raw_url: str, force_trans: bool = False):
        if Browser is None:
            self._log("ERROR", "内置浏览器打开失败: 未找到 Browser 类")
            BulletinHelper.show_error("未找到 Browser 类")
            return
        try:
            ctx = _get_activity() or (ApplicationLoader.applicationContext if ApplicationLoader else None)
            if ctx is None:
                self._log("ERROR", "内置浏览器打开失败: Context 为空")
                return
            final_url = self.to_translate_url(raw_url, bypass_check=force_trans)
            self._last_url = final_url
            self._bypass_until = time.monotonic() + 1.0
            self._log("CMD", f"指令触发内置浏览器翻译: {self._short_url(raw_url)}")
            Browser.openUrl(ctx, final_url)
        except BaseException as err:
            self._log("ERROR", f"打开内置浏览器失败: {err}")
            BulletinHelper.show_error(f"打开内置浏览器失败: {err}")

    def _build_diagnostic_text(self) -> str:
        mode = self._get_open_mode()
        lang = self._target_lang()
        cmd = str(self.get_setting("custom_cmd", ".tr") or ".tr").strip() or ".tr"
        wl = str(self.get_setting("force_whitelist", "") or "").strip() or "(空)"
        sl = str(self.get_setting("skip_domains", "") or "").strip() or "(空)"
        header = (
            f"插件: {__name__} v{__version__}\n"
            f"模式: {mode} | 目标语言: {lang} | 指令: {cmd}\n"
            f"白名单: {wl}\n"
            f"免翻译: {sl}\n"
            f"Hook数: {len(self._hook_refs)}\n"
            f"------------------------------\n"
        )
        if not self._logs:
            return header + "暂无运行或报错记录。"
        return header + "\n".join(self._logs)

    def _copy_to_clipboard(self, text: str):
        try:
            ctx = _get_activity() or (ApplicationLoader.applicationContext if ApplicationLoader else None)
            if ctx is None:
                BulletinHelper.show_error("复制失败：无法获取上下文")
                return
            ClipDataCls = find_class("android.content.ClipData")
            cm = ctx.getSystemService("clipboard")
            if cm is not None and ClipDataCls is not None:
                cm.setPrimaryClip(ClipDataCls.newPlainText("plugin_logs", text))
                BulletinHelper.show_info("已复制完整诊断日志到剪贴板")
                return
        except BaseException as err:
            self._log("ERROR", f"复制日志失败: {err}")
        BulletinHelper.show_error("复制日志失败")

    def _show_logs_dialog(self):
        try:
            act = _get_activity()
            if act is None:
                BulletinHelper.show_info("无法获取当前界面窗口")
                return
            report_text = self._build_diagnostic_text()
            builder = AlertDialogBuilder(act)
            builder.set_title("运行与报错日志")
            builder.set_message(report_text)
            builder.set_positive_button(
                "复制全部",
                lambda d, w, t=report_text: self._copy_to_clipboard(t),
            )
            builder.set_neutral_button(
                "清空日志",
                lambda d, w: (self._logs.clear(), BulletinHelper.show_info("日志已清空")),
            )
            builder.set_negative_button("关闭", None)
            builder.show()
        except BaseException as err:
            self._log("ERROR", f"弹出日志窗口失败: {err}")
            BulletinHelper.show_error(f"日志弹窗失败: {err}")

    # ==================== 悬浮窗模式 ====================
    def _is_window_alive(self) -> bool:
        if self._root is None or self._webview is None or self._wm is None:
            return False
        try:
            if hasattr(self._root, "isAttachedToWindow"):
                return bool(self._root.isAttachedToWindow())
        except BaseException:
            pass
        return True

    def _update_toggle_btn(self, url: str):
        if self._btn_toggle is None:
            return
        try:
            self._btn_toggle.setText("原页" if self.is_translated_url(url) else "译页")
        except BaseException:
            pass

    def _refresh_kb_btn(self):
        if self._btn_kb is None:
            return
        try:
            if self._focusable:
                self._btn_kb.setTextColor(_c32(0xFFFFFFFF))
                self._btn_kb.setBackground(_round_bg(self._accent_col, AndroidUtilities.dp(9)))
            else:
                self._btn_kb.setTextColor(self._text_col)
                self._btn_kb.setBackground(_round_bg(0x22888888, AndroidUtilities.dp(9)))
        except BaseException:
            pass

    def _set_focusable(self, on: bool):
        if not self._is_window_alive() or self._lp is None:
            return
        if self._focusable == on:
            return
        try:
            LayoutParamsCls = find_class("android.view.WindowManager$LayoutParams")
            if LayoutParamsCls is None:
                return
            nf = LayoutParamsCls.FLAG_NOT_FOCUSABLE
            if on:
                self._lp.flags &= ~nf
            else:
                self._lp.flags |= nf
                try:
                    self._webview.clearFocus()
                except BaseException:
                    pass
            self._focusable = on
            self._wm.updateViewLayout(self._root, self._lp)
            self._refresh_kb_btn()
        except BaseException:
            pass

    def _toggle_kb_focus(self):
        target = not self._focusable
        self._set_focusable(target)
        if target:
            try:
                if self._webview is not None:
                    self._webview.requestFocus()
            except BaseException:
                pass
            BulletinHelper.show_info("已允许网页输入（点悬浮窗外自动归还焦点）")

    def show_translated_float(self, raw_url: str, force_trans: bool = False):
        final_url = self.to_translate_url(raw_url, bypass_check=force_trans)
        self._last_url = final_url

        if self._is_window_alive():
            try:
                if self._minimized:
                    self._expand()
                self._webview.loadUrl(final_url)
                self._update_toggle_btn(final_url)
                return
            except BaseException:
                self.close_float()

        self._create_float(final_url)

    def _create_float(self, url: str):
        try:
            if self._root is not None or self._webview is not None:
                self.close_float()

            WindowManagerCls = find_class("android.view.WindowManager")
            LayoutParamsCls = find_class("android.view.WindowManager$LayoutParams")
            ThemeCls = find_class("org.telegram.ui.ActionBar.Theme")
            WebViewCls = find_class("android.webkit.WebView")
            WebViewClientCls = find_class("android.webkit.WebViewClient")
            OnTouchCls = find_class("android.view.View$OnTouchListener")
            BuildVerCls = find_class("android.os.Build$VERSION")

            if WindowManagerCls is None or LayoutParamsCls is None or WebViewCls is None:
                BulletinHelper.show_error("缺少 WebView 或 WindowManager")
                return

            act = _get_activity()
            ctx = act if act is not None else (ApplicationLoader.applicationContext if ApplicationLoader else None)
            if ctx is None:
                return

            wm = act.getSystemService("window") if act is not None else ctx.getSystemService("window")
            if wm is None:
                return
            self._wm = wm

            dm = ctx.getResources().getDisplayMetrics()
            sw, sh = int(dm.widthPixels), int(dm.heightPixels)

            bg_col = _safe_theme_color(ThemeCls, "key_windowBackgroundWhite", 0xFF1C1C1E)
            border_col = _safe_theme_color(ThemeCls, "key_divider", 0x44FFFFFF)
            accent_col = _safe_theme_color(ThemeCls, "key_dialogButtonBlue", 0xFF3A8DFF)
            text_col = _safe_theme_color(ThemeCls, "key_windowBackgroundWhiteBlackText", 0xFFFFFFFF)
            self._accent_col = accent_col
            self._text_col = text_col

            win_w = min(AndroidUtilities.dp(356), int(sw * 0.92))
            win_h = int(sh * 0.52)
            self._win_w = win_w
            self._win_x = max(AndroidUtilities.dp(8), (sw - win_w) // 2)
            self._win_y = AndroidUtilities.dp(64)

            root = LinearLayout(ctx)
            root.setOrientation(LinearLayout.VERTICAL)
            pad = AndroidUtilities.dp(6)
            root.setPadding(pad, pad, pad, pad)
            root_bg = _round_bg(bg_col, AndroidUtilities.dp(14), AndroidUtilities.dp(1), border_col)
            root.setBackground(root_bg)
            try:
                root.setClipToOutline(True)
                root.setElevation(float(AndroidUtilities.dp(12)))
            except BaseException:
                pass
            self._root_bg = root_bg

            bar = LinearLayout(ctx)
            bar.setOrientation(LinearLayout.HORIZONTAL)
            bar.setGravity(Gravity.CENTER_VERTICAL)
            bar.setPadding(AndroidUtilities.dp(4), AndroidUtilities.dp(2), AndroidUtilities.dp(4), AndroidUtilities.dp(6))

            def make_btn(label, cb, highlight=False):
                tv = TextView(ctx)
                tv.setText(label)
                tv.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 12)
                tv.setSingleLine(True)
                tv.setGravity(Gravity.CENTER)
                tv.setPadding(AndroidUtilities.dp(7), AndroidUtilities.dp(4), AndroidUtilities.dp(7), AndroidUtilities.dp(4))
                if highlight:
                    tv.setTextColor(_c32(0xFFFFFFFF))
                    tv.setBackground(_round_bg(accent_col, AndroidUtilities.dp(9)))
                else:
                    tv.setTextColor(text_col)
                    tv.setBackground(_round_bg(0x22888888, AndroidUtilities.dp(9)))
                if cb is not None:
                    tv.setOnClickListener(OnClickListener(cb))
                return tv

            btn_back = make_btn("◀", lambda v: self._go_nav("back"))
            btn_fwd = make_btn("▶", lambda v: self._go_nav("forward"))

            drag_hint = TextView(ctx)
            drag_hint.setText("≡ 译")
            drag_hint.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 12)
            drag_hint.setTextColor(accent_col)
            drag_hint.setGravity(Gravity.CENTER)
            drag_hint.setSingleLine(True)

            btn_toggle = make_btn("原页" if self.is_translated_url(url) else "译页", lambda v: self._switch_orig_trans())
            btn_ext = make_btn("↗", lambda v: self._open_external())
            btn_kb = make_btn("⌨", lambda v: self._toggle_kb_focus())
            btn_min = make_btn("—", lambda v: self._minimize())
            btn_close = make_btn("✕", lambda v: self.close_float(), highlight=True)

            for b in (btn_back, btn_fwd):
                lp_b = LinearLayout.LayoutParams(-2, -2)
                lp_b.rightMargin = AndroidUtilities.dp(4)
                bar.addView(b, lp_b)

            lp_d = LinearLayout.LayoutParams(0, -2, 1.0)
            lp_d.leftMargin = AndroidUtilities.dp(2)
            lp_d.rightMargin = AndroidUtilities.dp(2)
            bar.addView(drag_hint, lp_d)

            for b in (btn_toggle, btn_ext, btn_kb, btn_min, btn_close):
                lp_b = LinearLayout.LayoutParams(-2, -2)
                lp_b.leftMargin = AndroidUtilities.dp(4)
                bar.addView(b, lp_b)

            root.addView(bar, LinearLayout.LayoutParams(-1, -2))

            box = FrameLayout(ctx)
            wv = WebViewCls(ctx)
            s = wv.getSettings()
            s.setJavaScriptEnabled(True)
            s.setDomStorageEnabled(True)
            s.setSupportZoom(True)
            s.setBuiltInZoomControls(True)
            s.setDisplayZoomControls(False)
            s.setUseWideViewPort(True)
            s.setLoadWithOverviewMode(True)
            try:
                s.setMixedContentMode(0)
            except BaseException:
                pass
            if WebViewClientCls is not None:
                wv.setWebViewClient(WebViewClientCls())
            wv.loadUrl(url)
            box.addView(wv, FrameLayout.LayoutParams(-1, -1))
            root.addView(box, LinearLayout.LayoutParams(-1, win_h))

            b_size = AndroidUtilities.dp(48)
            bubble = FrameLayout(ctx)
            bubble.setBackground(_round_bg(accent_col, b_size // 2))
            try:
                bubble.setElevation(float(AndroidUtilities.dp(10)))
            except BaseException:
                pass
            b_txt = TextView(ctx)
            b_txt.setText("译")
            b_txt.setTextColor(_c32(0xFFFFFFFF))
            b_txt.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 16)
            b_txt.setGravity(Gravity.CENTER)
            bubble.addView(b_txt, FrameLayout.LayoutParams(-1, -1))
            bubble.setVisibility(View.GONE)
            root.addView(bubble, LinearLayout.LayoutParams(b_size, b_size))

            lp = LayoutParamsCls()
            lp.width = win_w
            lp.height = -2
            lp.gravity = Gravity.TOP | Gravity.START
            lp.x = self._win_x
            lp.y = self._win_y
            flag_outside = getattr(LayoutParamsCls, "FLAG_WATCH_OUTSIDE_TOUCH", 0x00040000)
            lp.flags = (
                LayoutParamsCls.FLAG_NOT_FOCUSABLE
                | LayoutParamsCls.FLAG_NOT_TOUCH_MODAL
                | flag_outside
                | LayoutParamsCls.FLAG_LAYOUT_IN_SCREEN
                | LayoutParamsCls.FLAG_LAYOUT_NO_LIMITS
            )
            lp.softInputMode = 48  # SOFT_INPUT_ADJUST_NOTHING
            lp.format = -3  # TRANSLUCENT

            added_panel = False
            try:
                token = act.getWindow().getDecorView().getWindowToken() if act is not None else None
                if token is not None:
                    lp.type = LayoutParamsCls.TYPE_APPLICATION_PANEL
                    lp.token = token
                    wm.addView(root, lp)
                    added_panel = True
            except BaseException:
                added_panel = False

            if not added_panel:
                sdk = int(BuildVerCls.SDK_INT) if BuildVerCls is not None else 26
                lp.type = LayoutParamsCls.TYPE_APPLICATION_OVERLAY if sdk >= 26 else LayoutParamsCls.TYPE_PHONE
                lp.token = None
                wm.addView(root, lp)

            if OnTouchCls is not None:
                host_self = self
                action_outside = getattr(MotionEvent, "ACTION_OUTSIDE", 4)

                class _OutsideWatcher(dynamic_proxy(OnTouchCls)):
                    def onTouch(self, v, ev):
                        try:
                            if ev.getActionMasked() == action_outside and host_self._focusable:
                                host_self._set_focusable(False)
                        except BaseException:
                            pass
                        return False

                root.setOnTouchListener(_OutsideWatcher())

                class _BarDrag(dynamic_proxy(OnTouchCls)):
                    def onTouch(self, v, ev):
                        try:
                            act_code = ev.getActionMasked()
                            if act_code == MotionEvent.ACTION_DOWN:
                                host_self._drag_x = float(ev.getRawX())
                                host_self._drag_y = float(ev.getRawY())
                                host_self._drag_ox = host_self._win_x
                                host_self._drag_oy = host_self._win_y
                                return True
                            if act_code == MotionEvent.ACTION_MOVE:
                                cur_dm = root.getContext().getResources().getDisplayMetrics()
                                cur_sw, cur_sh = int(cur_dm.widthPixels), int(cur_dm.heightPixels)
                                nx = int(host_self._drag_ox + (float(ev.getRawX()) - host_self._drag_x))
                                ny = int(host_self._drag_oy + (float(ev.getRawY()) - host_self._drag_y))
                                nx = max(0, min(nx, max(0, cur_sw - host_self._win_w)))
                                ny = max(AndroidUtilities.dp(20), min(ny, max(AndroidUtilities.dp(20), cur_sh - AndroidUtilities.dp(80))))
                                host_self._win_x, host_self._win_y = nx, ny
                                lp.x, lp.y = nx, ny
                                wm.updateViewLayout(root, lp)
                                return True
                        except BaseException:
                            pass
                        return False

                bar.setOnTouchListener(_BarDrag())

                class _BubbleTouch(dynamic_proxy(OnTouchCls)):
                    def onTouch(self, v, ev):
                        try:
                            act_code = ev.getActionMasked()
                            if act_code == MotionEvent.ACTION_DOWN:
                                host_self._b_drag_x = float(ev.getRawX())
                                host_self._b_drag_y = float(ev.getRawY())
                                host_self._b_ox = host_self._win_x
                                host_self._b_oy = host_self._win_y
                                host_self._b_moved = False
                                return True
                            if act_code == MotionEvent.ACTION_MOVE:
                                dx = float(ev.getRawX()) - host_self._b_drag_x
                                dy = float(ev.getRawY()) - host_self._b_drag_y
                                if not host_self._b_moved and (abs(dx) + abs(dy)) > AndroidUtilities.dp(6):
                                    host_self._b_moved = True
                                if host_self._b_moved:
                                    cur_dm = root.getContext().getResources().getDisplayMetrics()
                                    cur_sw, cur_sh = int(cur_dm.widthPixels), int(cur_dm.heightPixels)
                                    nx = max(0, min(int(host_self._b_ox + dx), max(0, cur_sw - b_size)))
                                    ny = max(AndroidUtilities.dp(24), min(int(host_self._b_oy + dy), max(AndroidUtilities.dp(24), cur_sh - b_size - AndroidUtilities.dp(24))))
                                    host_self._win_x, host_self._win_y = nx, ny
                                    lp.x, lp.y = nx, ny
                                    wm.updateViewLayout(root, lp)
                                return True
                            if act_code in (MotionEvent.ACTION_UP, MotionEvent.ACTION_CANCEL):
                                if not host_self._b_moved:
                                    host_self._expand()
                                return True
                        except BaseException:
                            pass
                        return False

                bubble.setOnTouchListener(_BubbleTouch())

            self._root = root
            self._lp = lp
            self._webview = wv
            self._content_box = box
            self._bar_row = bar
            self._bubble_btn = bubble
            self._btn_toggle = btn_toggle
            self._btn_kb = btn_kb
            self._minimized = False
            self._focusable = False
        except BaseException as err:
            self._log("ERROR", f"悬浮窗启动失败: {err}")
            self.close_float()
            BulletinHelper.show_error("悬浮窗启动失败: %s" % err)

    def _minimize(self):
        if not self._is_window_alive() or self._lp is None or self._minimized:
            return
        try:
            self._set_focusable(False)
            self._saved_x = self._win_x
            self._saved_y = self._win_y
            if self._bar_row is not None:
                self._bar_row.setVisibility(View.GONE)
            if self._content_box is not None:
                self._content_box.setVisibility(View.GONE)
            self._root.setBackground(None)
            self._root.setPadding(0, 0, 0, 0)
            if self._bubble_btn is not None:
                self._bubble_btn.setVisibility(View.VISIBLE)

            dm = self._root.getContext().getResources().getDisplayMetrics()
            sw, sh = int(dm.widthPixels), int(dm.heightPixels)
            b_size = AndroidUtilities.dp(48)
            self._win_x = max(0, sw - b_size - AndroidUtilities.dp(10))
            self._win_y = max(AndroidUtilities.dp(100), min(self._win_y, max(AndroidUtilities.dp(100), sh - b_size - AndroidUtilities.dp(24))))
            self._lp.width = -2
            self._lp.height = -2
            self._lp.x = self._win_x
            self._lp.y = self._win_y
            self._minimized = True
            self._wm.updateViewLayout(self._root, self._lp)
        except BaseException:
            pass

    def _expand(self):
        if not self._is_window_alive() or self._lp is None or not self._minimized:
            return
        try:
            if self._bubble_btn is not None:
                self._bubble_btn.setVisibility(View.GONE)
            ctx = self._root.getContext()
            pad = AndroidUtilities.dp(6)
            self._root.setPadding(pad, pad, pad, pad)
            if self._root_bg is not None:
                self._root.setBackground(self._root_bg)
            if self._bar_row is not None:
                self._bar_row.setVisibility(View.VISIBLE)
            if self._content_box is not None:
                self._content_box.setVisibility(View.VISIBLE)

            dm = ctx.getResources().getDisplayMetrics()
            sw, sh = int(dm.widthPixels), int(dm.heightPixels)
            win_w = min(AndroidUtilities.dp(356), int(sw * 0.92))
            self._win_w = win_w
            self._win_x = max(0, min(self._saved_x, max(0, sw - win_w)))
            self._win_y = max(AndroidUtilities.dp(20), min(self._saved_y, max(AndroidUtilities.dp(20), sh - AndroidUtilities.dp(120))))
            self._lp.width = win_w
            self._lp.height = -2
            self._lp.x = self._win_x
            self._lp.y = self._win_y
            self._minimized = False
            self._wm.updateViewLayout(self._root, self._lp)
        except BaseException:
            pass

    def _go_nav(self, direction: str):
        if self._webview is None:
            return
        try:
            if direction == "back" and self._webview.canGoBack():
                self._webview.goBack()
            elif direction == "forward" and self._webview.canGoForward():
                self._webview.goForward()
        except BaseException:
            pass

    def _switch_orig_trans(self):
        if self._webview is None:
            return
        try:
            cur = str(self._webview.getUrl() or self._last_url or "").strip()
            if not cur:
                return
            nxt = self.from_translate_url(cur) if self.is_translated_url(cur) else self.to_translate_url(cur, bypass_check=True)
            if nxt == cur:
                BulletinHelper.show_info("当前链接不支持谷歌网页翻译代理")
                return
            self._last_url = nxt
            self._webview.loadUrl(nxt)
            self._update_toggle_btn(nxt)
        except BaseException:
            pass

    def _open_external(self):
        if self._webview is None or Browser is None:
            return
        try:
            cur = str(self._webview.getUrl() or self._last_url or "").strip()
            if not cur:
                return
            orig = self.from_translate_url(cur)
            ctx = _get_activity() or (ApplicationLoader.applicationContext if ApplicationLoader else None)
            if ctx is None:
                return
            self._bypass_until = time.monotonic() + 1.5
            Browser.openUrl(ctx, orig)
        except BaseException:
            pass

    def close_float(self):
        root = self._root
        wv = self._webview
        wm = self._wm

        try:
            if wv is not None:
                try:
                    u = wv.getUrl()
                    if u:
                        self._last_url = str(u)
                except BaseException:
                    pass
            if root is not None:
                removed = False
                if wm is not None:
                    try:
                        wm.removeViewImmediate(root)
                        removed = True
                    except BaseException:
                        try:
                            wm.removeView(root)
                            removed = True
                        except BaseException:
                            pass
                if not removed:
                    try:
                        wm_fallback = root.getContext().getSystemService("window")
                        if wm_fallback is not None:
                            wm_fallback.removeViewImmediate(root)
                    except BaseException:
                        pass
            if wv is not None:
                try:
                    wv.stopLoading()
                    wv.loadUrl("about:blank")
                    wv.destroy()
                except BaseException:
                    pass
        except BaseException:
            pass

        self._wm = None
        self._root = None
        self._root_bg = None
        self._lp = None
        self._webview = None
        self._content_box = None
        self._bar_row = None
        self._bubble_btn = None
        self._btn_toggle = None
        self._btn_kb = None
        self._minimized = False
        self._focusable = False
