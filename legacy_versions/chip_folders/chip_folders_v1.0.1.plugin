__id__ = "chip_folders"
__name__ = "Chip Folders"
__description__ = """Панель папок чатов в стиле чипсов Material 3 с плавным морфингом скруглений.

Material 3 chip style folders bar with smooth corner morphing."""
__author__ = "@RnPlugins"
__version__ = "1.0.1"
__icon__ = "RnDev/5"
__app_version__ = ">=12.5.1"
__sdk_version__ = ">=1.4.3.3"

import base64
import traceback

from base_plugin import BasePlugin
from java.nio import ByteBuffer
from dalvik.system import InMemoryDexClassLoader
from org.telegram.messenger import ApplicationLoader
from ui.settings import Header, Selector, Divider, Custom, Text, Switch

DEX_B64 = """"""

STYLE_FILLED = 0
STYLE_OUTLINED = 1
STYLE_GHOST = 2
SHAPE_CAPSULE = 0
SHAPE_ROUNDED = 1
SHAPE_SOFT = 2
SHAPE_SQUARE = 3
SHAPE_DYNAMIC = 4
SHAPE_EXPRESSIVE = 5
SHAPE_ALTERNATIVE = 6
SHAPE_CUSTOM = 7
SIZE_COMPACT = 0
SIZE_DEFAULT = 1
SIZE_LARGE = 2
SIZE_CUSTOM = 3
SPACING_TIGHT = 0
SPACING_DEFAULT = 1
SPACING_WIDE = 2
SPACING_CUSTOM = 3

COLOR_KEYS = (
    ("color_chip_active", "Активная вкладка", "Active chip"),
    ("color_chip_inactive", "Неактивная вкладка", "Inactive chip"),
    ("color_text_active", "Текст активной", "Active label"),
    ("color_text_inactive", "Текст неактивной", "Inactive label"),
)


def is_russian():
    try:
        from org.telegram.messenger import LocaleController
        return str(LocaleController.getInstance().getCurrentLocale().getLanguage()) == "ru"
    except Exception:
        return True


def t(ru, en):
    return ru if is_russian() else en


class ChipFoldersPlugin(BasePlugin):
    def on_plugin_load(self):
        self.dex_class = None
        self.dex_loader = None
        try:
            dex_bytes = base64.b64decode(DEX_B64)
            buffer = ByteBuffer.wrap(dex_bytes)
            parent_cl = ApplicationLoader.applicationContext.getClassLoader()
            self.dex_loader = InMemoryDexClassLoader(buffer, parent_cl)
            self.dex_class = self.dex_loader.loadClass("dev.rooni.chipfolders.ChipFolders")

            self.apply_settings()

            for method in self.dex_class.getMethods():
                if method.getName() == "start":
                    method.invoke(None)
                    break
        except Exception as e:
            self.log("Load error: %s\n%s" % (e, traceback.format_exc()))

    def on_plugin_unload(self):
        try:
            if self.dex_class is not None:
                for method in self.dex_class.getMethods():
                    if method.getName() == "stop":
                        method.invoke(None)
                        break
        except Exception as e:
            self.log("Unload error: %s" % e)
        finally:
            self._preview_cell = None
            self._seekbar_refs = []
            self._row_refs = []
            self._picker_sheet = None
            self._picker_listener = None
            self._picker_pipette = None
            self._picker_delegate = None
            self.dex_class = None
            self.dex_loader = None

    def _int(self, key, default):
        try:
            return int(self.get_setting(key, default))
        except Exception:
            return default

    def build_config(self):
        pairs = [
            ("style", self._int("chip_style", 0)),
            ("shape", self._int("chip_shape", 5)),
            ("size", self._int("chip_size", 1)),
            ("spacing", self._int("chip_spacing", 1)),
            ("ra", self._int("radius_active", 20)),
            ("ri", self._int("radius_inactive", 20)),
            ("rca", self._int("radius_custom_active", 11)),
            ("ro", self._int("radius_outer", 20)),
            ("ri_in", self._int("radius_inner", 8)),
            ("raa", self._int("radius_alt_active", 20)),
            ("rao", self._int("radius_alt_outer", 20)),
            ("md3", 1 if self.get_setting("md3_colors", True) else 0),
            ("sdiv", 1 if self.get_setting("scroll_divider", True) else 0),
            ("h", self._int("custom_height", 48)),
            ("sp", self._int("custom_spacing", 6)),
            ("lpad", self._int("list_top_padding", 5)),
            ("ca", self._int("color_chip_active", 0)),
            ("ci", self._int("color_chip_inactive", 0)),
            ("ta", self._int("color_text_active", 0)),
            ("ti", self._int("color_text_inactive", 0)),
            ("anim", self._int("chip_anim", 0)),
            ("aspd", self._int("anim_speed", 100)),
        ]
        return ";".join("%s:%s" % (k, v) for k, v in pairs)

    def apply_settings(self, *args):
        if self.dex_class is None:
            return
        try:
            config = self.build_config()
            for method in self.dex_class.getMethods():
                if method.getName() == "updateSettings":
                    method.invoke(None, config)
                    break
            self._refresh_preview()
        except Exception as e:
            self.log("Apply settings error: %s" % e)

    def _refresh_preview(self):
        cell = getattr(self, "_preview_cell", None)
        if cell is None or self.dex_class is None:
            return
        try:
            for method in self.dex_class.getMethods():
                if method.getName() == "refreshPreview":
                    method.invoke(None, cell)
                    break
        except Exception:
            pass

    def _preview_row(self):
        from com.exteragram.messenger.preferences.appearance.components import FilterTabsPreviewCell
        from client_utils import get_last_fragment

        fragment = get_last_fragment()
        context = None
        if fragment is not None:
            context = fragment.getParentActivity()
        if context is None:
            context = ApplicationLoader.applicationContext

        cell = FilterTabsPreviewCell(context)
        self._preview_cell = cell
        self._refresh_preview()
        return Custom(view=cell)

    def _on_structure_change(self, key):
        def handler(value):
            try:
                self.set_setting(key, value, reload_settings=True)
            except Exception:
                pass
            self.apply_settings()
        return handler

    def _seekbar(self, key, title, minimum, maximum, default):
        from com.exteragram.messenger.preferences.components import AltSeekbar
        from java import dynamic_proxy

        plugin = self

        class _Drag(dynamic_proxy(AltSeekbar.OnDrag)):
            def __init__(self):
                super().__init__()

            def run(self, value):
                try:
                    plugin.set_setting(key, int(round(float(value))))
                    plugin.apply_settings()
                except Exception:
                    pass

        listener = _Drag()
        if not hasattr(self, "_seekbar_refs"):
            self._seekbar_refs = []
        self._seekbar_refs.append(listener)

        bar = AltSeekbar(
            ApplicationLoader.applicationContext,
            listener,
            minimum,
            maximum,
            title,
            str(minimum),
            str(maximum),
        )
        bar.setProgress(float(self._int(key, default)))
        return Custom(view=bar)

    def _color_row(self, key, label, divider):
        from android.graphics import PorterDuff, PorterDuffColorFilter
        from android.graphics.drawable import GradientDrawable
        from android.view import View as AndroidView
        from java import dynamic_proxy
        from org.telegram.messenger import AndroidUtilities, R
        from org.telegram.ui.ActionBar import Theme
        from org.telegram.ui.Cells import TextCell
        from android_utils import OnClickListener

        context = ApplicationLoader.applicationContext
        stored = self._int(key, 0)

        swatch = GradientDrawable()
        swatch.setShape(GradientDrawable.OVAL)
        swatch.setSize(AndroidUtilities.dp(22), AndroidUtilities.dp(22))
        if stored != 0:
            swatch.setColor(stored)
        else:
            swatch.setColor(0)
            swatch.setStroke(AndroidUtilities.dp(2), Theme.getColor(Theme.key_windowBackgroundWhiteGrayText))

        icon = context.getResources().getDrawable(R.drawable.msg_colors).mutate()
        icon.setColorFilter(PorterDuffColorFilter(
            Theme.getColor(Theme.key_windowBackgroundWhiteGrayIcon), PorterDuff.Mode.SRC_IN))

        cell = TextCell(context)
        cell.setClickable(True)
        cell.setFocusable(True)
        cell.setTextAndIconAndValueDrawable(label, icon, swatch, divider)

        try:
            from android.content.res import ColorStateList
            from android.graphics import Color as AndroidColor
            from android.graphics.drawable import ColorDrawable, RippleDrawable

            base = Theme.getColor(Theme.key_listSelector)
            color = AndroidColor.argb(
                max(AndroidColor.alpha(base), 45),
                AndroidColor.red(base),
                AndroidColor.green(base),
                AndroidColor.blue(base),
            )
            cell.setBackground(RippleDrawable(
                ColorStateList.valueOf(color),
                None,
                ColorDrawable(AndroidColor.WHITE),
            ))
        except Exception:
            try:
                cell.setBackground(Theme.createSelectorDrawable(Theme.getColor(Theme.key_listSelector), 2))
            except Exception:
                pass
        cell.setOnClickListener(OnClickListener(lambda v: self._open_color_picker(key, label)))

        plugin = self

        class _LongClick(dynamic_proxy(AndroidView.OnLongClickListener)):
            def __init__(self):
                super().__init__()

            def onLongClick(self, view):
                plugin._reset_color(key)
                return True

        listener = _LongClick()
        if not hasattr(self, "_row_refs"):
            self._row_refs = []
        self._row_refs.append(listener)
        cell.setOnLongClickListener(listener)

        return Custom(view=cell)

    def _reset_color(self, key):
        try:
            self.set_setting(key, 0, reload_settings=True)
        except Exception:
            self.set_setting(key, 0)
        self.apply_settings()

    def _open_color_picker(self, key, label):
        from android_utils import run_on_ui_thread
        from client_utils import get_last_fragment
        from java import dynamic_proxy
        from hook_utils import find_class
        from org.telegram.ui.ActionBar import Theme

        fragment = get_last_fragment()
        activity = fragment.getParentActivity() if fragment is not None else None
        if activity is None:
            return

        try:
            resources_provider = fragment.getResourceProvider()
        except Exception:
            resources_provider = None

        current = self._int(key, 0)
        if current == 0:
            current = Theme.getColor(Theme.key_windowBackgroundWhiteBlueText)

        plugin = self

        def save(color):
            value = int(color)
            plugin._picker_pipette = None
            plugin._picker_listener = None
            plugin._picker_delegate = None
            try:
                plugin.set_setting(key, value, reload_settings=True)
            except Exception:
                plugin.set_setting(key, value)
            plugin.apply_settings()

        try:
            from org.telegram.ui.Components.Paint import ColorPickerBottomSheet
            from androidx.core.util import Consumer

            pipette_class = find_class("org.telegram.ui.Components.Paint.ColorPickerBottomSheet$PipetteDelegate")

            class _Pipette(dynamic_proxy(pipette_class)):
                def __init__(self):
                    super().__init__()

                def onStartColorPipette(self):
                    return None

                def onStopColorPipette(self):
                    return None

                def getContainerView(self):
                    return None

                def getSnapshotDrawingView(self):
                    return None

                def onDrawImageOverCanvas(self, bitmap, canvas):
                    return None

                def isPipetteVisible(self):
                    return False

                def isPipetteAvailable(self):
                    return False

                def onColorSelected(self, color):
                    return None

            class _Listener(dynamic_proxy(Consumer)):
                def __init__(self):
                    super().__init__()

                def accept(self, color):
                    save(color)

            self._picker_pipette = _Pipette()
            self._picker_listener = _Listener()
            sheet = ColorPickerBottomSheet(activity, resources_provider)
            sheet.setPipetteDelegate(self._picker_pipette)
            sheet.setColor(current)
            sheet.setColorListener(self._picker_listener)
            run_on_ui_thread(sheet.show)
            return
        except Exception:
            pass

        try:
            from org.telegram.ui.Components import ColorPicker
            from ui.alert import AlertDialogBuilder
            from org.telegram.messenger import AndroidUtilities

            delegate_class = find_class("org.telegram.ui.Components.ColorPicker$ColorPickerDelegate")
            chosen = {"color": current}

            class _Delegate(dynamic_proxy(delegate_class)):
                def __init__(self):
                    super().__init__()

                def setColor(self, color, num, applyNow):
                    chosen["color"] = int(color)

            def confirm(dialog, which):
                dialog.dismiss()
                save(chosen["color"])

            self._picker_delegate = _Delegate()
            picker = ColorPicker(activity, False, self._picker_delegate)
            picker.setColor(current, 0)

            builder = AlertDialogBuilder(activity)
            builder.set_title(label)
            builder.set_view(picker, AndroidUtilities.dp(360))
            builder.set_positive_button("Сохранить", confirm)
            builder.set_negative_button("Отмена", lambda dialog, which: dialog.dismiss())
            run_on_ui_thread(builder.show)
        except Exception as e:
            self.log("Color picker error: %s" % e)

    def create_settings(self):
        self.apply_settings()
        self._seekbar_refs = []
        self._row_refs = []

        style = self._int("chip_style", 0)
        shape = self._int("chip_shape", 5)
        size = self._int("chip_size", 1)
        spacing = self._int("chip_spacing", 1)
        anim = self._int("chip_anim", 0)

        self._preview_cell = None
        rows = [
            self._safe(self._preview_row),
            Header(text=t("Чипсы", "Chips")),
            Selector(
                key="chip_style",
                text=t("Стиль", "Style"),
                default=0,
                items=[
                    t("Заливка", "Filled"),
                    t("Контур", "Outlined"),
                    t("Призрачный", "Ghost"),
                ],
                icon="msg_colors",
                on_change=self._on_structure_change("chip_style"),
            ),
        ]

        md3_colors = self.get_setting("md3_colors", True)
        rows.append(Switch(
            key="md3_colors",
            text=t("Цвета Material 3", "Material 3 colors"),
            subtext=t("Цвета с темы, более подходящие под Material 3",
                      "Theme colors tailored for Material 3"),
            default=True,
            icon="msg_colors",
            on_change=self._on_structure_change("md3_colors"),
        ))

        if not md3_colors:
            active_keys = []
            for k, ru, en in COLOR_KEYS:
                if style == STYLE_OUTLINED and k == "color_chip_inactive":
                    continue
                active_keys.append((k, ru, en))
            for index, (key, ru, en) in enumerate(active_keys):
                divider = index < len(active_keys) - 1
                rows.append(self._safe(self._color_row, key, t(ru, en), divider))

        rows.append(Selector(
            key="chip_shape",
            text=t("Форма", "Shape"),
            default=5,
            items=[
                t("Капсула", "Capsule"),
                t("Скругленная", "Rounded"),
                t("Мягкая", "Soft"),
                t("Квадрат", "Square"),
                t("Динамическая", "Dynamic"),
                t("Экспрессивная", "Expressive"),
                t("Альтернативная", "Alternative"),
                t("Своя", "Custom"),
            ],
            icon="msg_autodelete_badge2",
            on_change=self._on_structure_change("chip_shape"),
        ))

        if shape == SHAPE_EXPRESSIVE:
            rows.append(self._safe(self._seekbar, "radius_active",
                                   t("Скругление активной", "Active corner"), 0, 24, 20))
            rows.append(self._safe(self._seekbar, "radius_outer",
                                   t("Скругление внешних углов", "Outer corner"), 0, 24, 20))
            rows.append(self._safe(self._seekbar, "radius_inner",
                                   t("Скругление внутренних углов", "Inner corner"), 0, 24, 8))
        elif shape == SHAPE_ALTERNATIVE:
            rows.append(self._safe(self._seekbar, "radius_alt_active",
                                   t("Скругление активной", "Active corner"), 0, 24, 20))
            rows.append(self._safe(self._seekbar, "radius_alt_outer",
                                   t("Скругление внешних углов", "Outer corner"), 0, 24, 20))
        elif shape == SHAPE_CUSTOM:
            rows.append(self._safe(self._seekbar, "radius_custom_active",
                                   t("Скругление активной", "Active corner"), 0, 24, 11))
            rows.append(self._safe(self._seekbar, "radius_inactive",
                                   t("Скругление неактивной", "Inactive corner"), 0, 24, 20))

        rows.append(Selector(
            key="chip_anim",
            text=t("Анимация", "Animation"),
            default=0,
            items=[
                t("Нет", "None"),
                t("Желе", "Jelly"),
                t("Сжатие", "Squeeze"),
                t("Прожатие", "Press"),
                t("Пружина", "Spring"),
            ],
            icon="msg_photo_settings",
            on_change=self._on_structure_change("chip_anim"),
        ))
        if anim != 0:
            rows.append(self._safe(self._seekbar, "anim_speed",
                                   t("Скорость", "Speed"), 50, 200, 100))

        rows.append(Header(text=t("Панель", "Bar")))
        rows.append(Selector(
            key="chip_size",
            text=t("Размер", "Size"),
            default=1,
            items=[
                t("Компактный", "Compact"),
                t("Обычный", "Default"),
                t("Крупный", "Large"),
                t("Свой", "Custom"),
            ],
            icon="ic_gofullscreen",
            on_change=self._on_structure_change("chip_size"),
        ))
        if size == SIZE_CUSTOM:
            rows.append(self._safe(self._seekbar, "custom_height",
                                   t("Высота панели", "Bar height"), 36, 64, 48))

        rows.append(Selector(
            key="chip_spacing",
            text=t("Промежутки", "Spacing"),
            default=1,
            items=[
                t("Плотно", "Tight"),
                t("Обычно", "Default"),
                t("Свободно", "Wide"),
                t("Свои", "Custom"),
            ],
            icon="msg_colors",
            on_change=self._on_structure_change("chip_spacing"),
        ))
        if spacing == SPACING_CUSTOM:
            rows.append(self._safe(self._seekbar, "custom_spacing",
                                   t("Промежуток", "Gap"), 0, 24, 6))

        rows.append(self._safe(self._seekbar, "list_top_padding",
                               t("Отступ списка чатов", "Chat list offset"), 0, 24, 5))

        rows.append(Header(text=t("Ещё", "More")))
        rows.append(Switch(
            key="scroll_divider",
            text=t("Разделитель при скролле", "Scroll divider"),
            subtext=t("Показывать линию под панелью при прокрутке чатов",
                      "Show bottom line under bar when scrolling chats"),
            default=True,
            icon="msg_channel",
            on_change=self._on_structure_change("scroll_divider"),
        ))
        rows.append(Text(
            text=t("Настройки папок exteraGram", "exteraGram folder settings"),
            subtext=t("Стиль заголовков, счетчики и прочее.",
                      "Title style, counters and more."),
            icon="msg_folders",
            on_click=self._open_etg_folders,
        ))

        rows.append(Divider(text=t(
            "Подсказка: попасть в эти настройки можно зажав основную папку",
            "Tip: long-press the main folder to open these settings",
        )))

        return [row for row in rows if row is not None]

    def _open_etg_folders(self, view=None):
        try:
            from android_utils import run_on_ui_thread
            from client_utils import get_last_fragment
            from org.telegram.messenger.browser import Browser

            fragment = get_last_fragment()
            activity = fragment.getParentActivity() if fragment is not None else None
            if activity is None:
                return
            run_on_ui_thread(lambda: Browser.openUrl(activity, "https://t.me/exteraSettings?s=tabTitleStyle"))
        except Exception as e:
            self.log("Open eTG settings error: %s" % e)

    def _safe(self, factory, *args):
        try:
            return factory(*args)
        except Exception as e:
            import traceback
            self.log("Row error in %s: %s\n%s" % (getattr(factory, "__name__", str(factory)), e, traceback.format_exc()))
            return None

