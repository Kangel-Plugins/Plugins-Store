from typing import Any, List

from base_plugin import BasePlugin, MethodHook

__id__ = "bubble_chat_editor"
__name__ = "Bubble Outline"
__description__ = "Пузырьковый контур (bubbleIn/Outline) для exteraGram 12.9.0. Только для контура: цвета чата остаются прежними в текущей теме."
__author__ = "@xw_wvv"
__version__ = "3.4.1"
__app_version__ = ">=12.9.0"
__sdk_version__ = ">=1.4.4.3"

# Порт bubble_outline (TGMessage.java:2007-2031).
# Outline-only: цвета чата всегда из текущей темы.

OUTLINE_SIZE_OPTIONS = ["0.5", "1", "1.5", "2", "3"]
OUTLINE_SIZE_VALUES = [0.5, 1.0, 1.5, 2.0, 3.0]
OUTLINE_ALPHA_OPTIONS = ["25%", "50%", "75%", "100%"]
OUTLINE_ALPHA_VALUES = [0.25, 0.5, 0.75, 1.0]

OUTLINE_IN_DEFAULT = "#FFFFFF"
OUTLINE_OUT_DEFAULT = "#FFFFFF"

MSG_DRAWABLE_FIELDS = (
    "chat_msgInDrawable",
    "chat_msgInSelectedDrawable",
    "chat_msgOutDrawable",
    "chat_msgOutSelectedDrawable",
    "chat_msgInMediaDrawable",
    "chat_msgInMediaSelectedDrawable",
    "chat_msgOutMediaDrawable",
    "chat_msgOutMediaSelectedDrawable",
)
ROUNDING_EPSILON = 0.001

# Приватные поля ChatMessageCell для штриха прозрачной стороны.
CACHED_FIELDS = (
    "currentMessageObject",
    "backgroundCacheParams",
    "wasLayout",
    "currentMessagesGroup",
    "drawBackground",
    "enterTransitionInProgress",
)

# Ключ тега вьюхи для счётчика попыток перерисовки.
TAG_KEY_RETRY = 0x7F000001
MAX_RETRIES = 3


def parse_hex(s):
    if not s:
        return None
    s = str(s).strip().lstrip("#")
    try:
        if len(s) == 6:
            return (0xFF << 24) | int(s, 16)
        if len(s) == 8:
            return int(s, 16)
    except Exception:
        return None
    return None


def apply_alpha(color, factor):
    try:
        rgb = int(color) & 0xFFFFFF
        a = int(round(255.0 * float(factor)))
        if a < 0:
            a = 0
        if a > 255:
            a = 255
        return (a << 24) | rgb
    except Exception:
        return color


def to_java_int(c):
    try:
        c = int(c) & 0xFFFFFFFF
        if c >= 0x80000000:
            c -= 0x100000000
        return c
    except Exception:
        return 0


class DrawablePatchHook(MethodHook):
    # Редкий путь: только создание drawable (старт/смена темы).
    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            if not self.plugin.outline_enabled:
                return
            d = param.thisObject
            if d is not None:
                try:
                    d.setRoundingRadius(float(ROUNDING_EPSILON))
                except Exception:
                    pass
                try:
                    is_out = bool(param.args[1])
                except Exception:
                    is_out = False
                try:
                    self.plugin._remember_drawable(d)
                    self.plugin._apply_shadow_to_drawable(d, not is_out)
                except Exception:
                    pass
        except Exception:
            pass


class ReapplyShadowHook(MethodHook):
    # Редкий путь: смена/применение темы — drawable могли пересоздаться.
    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            self.plugin._patch_existing_drawables()
            self.plugin._apply_shadow_to_all()
        except Exception:
            pass


class ScopedStrokeHook(MethodHook):
    # Только прозрачная сторона (ей тень не видна — нет заливки).
    # Штрих четкий во всю ширину: наружу — контур, внутрь — по прозрачному.
    # Клип не нужен, guard'ы те же (протухших путей не рисуем).
    # Если backgroundCacheParams или path ещё не готов — планируем
    # перерисовку через postInvalidateOnAnimation (до MAX_RETRIES раз).
    def __init__(self, plugin):
        self.plugin = plugin

    def _schedule_retry(self, cell):
        """Запланировать перерисовку ячейки, если path ещё не готов."""
        try:
            tag = cell.getTag(TAG_KEY_RETRY)
            attempts = int(tag) if tag is not None else 0
            if attempts < MAX_RETRIES:
                cell.setTag(TAG_KEY_RETRY, attempts + 1)
                cell.postInvalidateOnAnimation()
                return True
        except Exception:
            try:
                cell.postInvalidateOnAnimation()
            except Exception:
                pass
        return False

    def _clear_retry(self, cell):
        """Сбросить счётчик попыток после успешной отрисовки."""
        try:
            cell.setTag(TAG_KEY_RETRY, None)
        except Exception:
            pass

    def after_hooked_method(self, param):
        try:
            p = self.plugin
            if not p.outline_enabled:
                return
            if not param.args or len(param.args) == 0:
                return
            canvas = param.args[0]
            if canvas is None:
                return
            cell = param.thisObject
            if cell is None:
                return
            F = p._F
            if F:
                try:
                    wf = F.get("wasLayout")
                    if wf is not None and not bool(wf.getBoolean(cell)):
                        return
                except Exception:
                    pass
                try:
                    msg = F.get("currentMessageObject").get(cell)
                except Exception:
                    msg = None
            else:
                msg = p._cell_field(cell, "currentMessageObject")
            if msg is None:
                return
            try:
                if msg.shouldDrawWithoutBackground():
                    return
            except Exception:
                pass
            try:
                is_out = bool(msg.isOutOwner())
            except Exception:
                return
            try:
                need = p._force_stroke or (not is_out and p._in_transparent) or (is_out and p._out_transparent)
            except Exception:
                return
            if not need:
                return
            paint = p.stroke_paint_out if is_out else p.stroke_paint_in
            if paint is None:
                return
            if F:
                try:
                    df = F.get("drawBackground")
                    if df is not None and not bool(df.getBoolean(cell)):
                        return
                except Exception:
                    pass
                try:
                    gf = F.get("currentMessagesGroup")
                    if (gf.get(cell) if gf is not None else None) is not None:
                        return
                except Exception:
                    pass
                try:
                    ef = F.get("enterTransitionInProgress")
                    if ef is not None and bool(ef.getBoolean(cell)):
                        try:
                            if not bool(msg.isVoice()):
                                return
                        except Exception:
                            pass
                except Exception:
                    pass

            # --- Получение backgroundCacheParams и path ---
            cache = None
            try:
                if F:
                    try:
                        cache = F.get("backgroundCacheParams").get(cell)
                    except Exception:
                        cache = None
                else:
                    cache = p._cell_field(cell, "backgroundCacheParams")
            except Exception:
                pass

            if cache is None:
                # Cache ещё не создан — планируем перерисовку.
                self._schedule_retry(cell)
                return

            path = None
            try:
                path = cache.getPath()
            except Exception:
                path = None

            if path is None:
                # Path ещё не готов — планируем перерисовку.
                self._schedule_retry(cell)
                return

            # Path готов — сбрасываем счётчик и рисуем.
            self._clear_retry(cell)

            try:
                canvas.drawPath(path, paint)
                try:
                    if is_out:
                        p._stroke_out += 1
                    else:
                        p._stroke_in += 1
                except Exception:
                    pass
            except Exception:
                pass
        except Exception:
            pass


class TxOutlinePlugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self._paint_field = None
        self.outline_enabled = True
        self.outline_in = OUTLINE_IN_DEFAULT
        self.outline_out = OUTLINE_OUT_DEFAULT
        self.outline_size = 1.0
        self.outline_alpha = 1.0
        self._patched_drawables = 0
        self._patched_refs = []
        self._shadow_ok = 0
        self._shadow_error = None
        self._shadow_bad = []
        self._shadow_method = None
        self._shadow_method_tried = False
        self._F = {}
        self._draw_unhooks = []
        self._draw_hooked = False
        self.stroke_paint_in = None
        self.stroke_paint_out = None
        self._in_transparent = False
        self._out_transparent = False
        self._force_stroke = False
        self._stroke_in = 0
        self._stroke_out = 0
        self._cell_field_missing = False

    def _on_ui(self, fn):
        try:
            from android_utils import run_on_ui_thread
            run_on_ui_thread(fn)
        except Exception:
            try:
                fn()
            except Exception:
                pass

    def _init_paint_field(self):
        if self._paint_field is not None:
            return
        try:
            from hook_utils import find_class
            cls = find_class("org.telegram.ui.ActionBar.Theme$MessageDrawable")
            if cls is None:
                return
            try:
                f = cls.getDeclaredField("paint")
                try:
                    f.setAccessible(True)
                except Exception:
                    pass
                self._paint_field = f
            except Exception as e:
                self._shadow_error = f"paint-field:{e}"[:80]
        except Exception as e:
            self._shadow_error = f"find-md:{e}"[:80]

    def _remember_drawable(self, d):
        try:
            for known in self._patched_refs:
                try:
                    if known == d:
                        return
                except Exception:
                    pass
            self._patched_refs.append(d)
        except Exception:
            pass

    def _cell_field(self, cell, name):
        try:
            return getattr(cell.JA, name)
        except Exception:
            pass
        try:
            from hook_utils import get_private_field
            return get_private_field(cell, name)
        except Exception:
            return None

    def _init_fields(self):
        if self._F:
            return
        try:
            from hook_utils import find_class
            cls = find_class("org.telegram.ui.Cells.ChatMessageCell")
            if cls is None:
                return
            for name in CACHED_FIELDS:
                try:
                    f = cls.getDeclaredField(name)
                    try:
                        f.setAccessible(True)
                    except Exception:
                        pass
                    self._F[name] = f
                except Exception:
                    pass
        except Exception:
            pass

    def _stroke_style(self):
        try:
            from android.graphics import Paint
            try:
                return Paint.Style.STROKE
            except Exception:
                pass
        except Exception:
            pass
        try:
            from hook_utils import find_class
            st = find_class("android.graphics.Paint$Style")
            if st is not None:
                try:
                    for c in st.getEnumConstants():
                        try:
                            if str(c.name()) == "STROKE":
                                return c
                        except Exception:
                            pass
                except Exception:
                    pass
        except Exception:
            pass
        return None

    def _make_stroke_paint(self, color):
        try:
            from android.graphics import Paint
            from org.telegram.messenger import AndroidUtilities
            style = self._stroke_style()
            if style is None:
                return None
            paint = Paint(1)
            try:
                paint.setStyle(style)
            except Exception:
                return None
            try:
                paint.setStrokeJoin(Paint.Join.ROUND)
            except Exception:
                pass
            try:
                paint.setStrokeCap(Paint.Cap.ROUND)
            except Exception:
                pass
            try:
                w = float(AndroidUtilities.dp(float(self.outline_size)))
                if w < 1:
                    w = 1.0
                paint.setStrokeWidth(float(w))
            except Exception:
                return None
            try:
                paint.setColor(to_java_int(int(apply_alpha(color, self.outline_alpha))))
            except Exception:
                try:
                    a = int(round(255.0 * float(self.outline_alpha)))
                    r = (int(color) >> 16) & 0xFF
                    g = (int(color) >> 8) & 0xFF
                    b = int(color) & 0xFF
                    paint.setARGB(a, r, g, b)
                except Exception:
                    return None
            return paint
        except Exception:
            return None

    def _evaluate_modes(self):
        # Какая сторона прозрачная: ей тень не видна, ей нужен штрих.
        try:
            from org.telegram.ui.ActionBar import Theme
            try:
                in_c = int(Theme.getColor(int(getattr(Theme, "key_chat_inBubble"))))
            except Exception:
                in_c = -1
            try:
                out_c = int(Theme.getColor(int(getattr(Theme, "key_chat_outBubble"))))
            except Exception:
                out_c = -1
        except Exception:
            in_c, out_c = -1, -1
        try:
            self._in_transparent = in_c != -1 and ((in_c >> 24) & 0xFF) == 0
        except Exception:
            self._in_transparent = False
        try:
            self._out_transparent = out_c != -1 and ((out_c >> 24) & 0xFF) == 0
        except Exception:
            self._out_transparent = False

    def _sync_draw_hook(self):
        # Штрих висит если: форсирован, или есть прозрачная сторона с кистью.
        try:
            want = bool(self.outline_enabled and (
                self._force_stroke
                or (self._in_transparent and self.stroke_paint_in is not None)
                or (self._out_transparent and self.stroke_paint_out is not None)))
        except Exception:
            want = False
        have = bool(self._draw_unhooks)
        if want and not have:
            try:
                from hook_utils import find_class
                cell_cls = find_class("org.telegram.ui.Cells.ChatMessageCell")
                if cell_cls:
                    hooked = None
                    try:
                        hooked = self.hook_all_methods(cell_cls, "drawBackgroundInternal", ScopedStrokeHook(self))
                    except Exception as e:
                        self.log(f"hook drawBg failed: {e}")
                    if not hooked:
                        try:
                            hooked = self.hook_all_methods(cell_cls, "onDraw", ScopedStrokeHook(self))
                        except Exception as e:
                            self.log(f"hook onDraw failed: {e}")
                    if hooked:
                        try:
                            self._draw_unhooks = list(hooked)
                        except Exception:
                            self._draw_unhooks = [hooked]
                        self._draw_hooked = True
            except Exception as e:
                self.log(f"draw hook setup failed: {e}")
        elif have and not want:
            try:
                for h in list(self._draw_unhooks):
                    try:
                        self.unhook_method(h)
                    except Exception:
                        pass
            finally:
                self._draw_unhooks = []
                self._draw_hooked = False

    def _rebuild_outline_cache(self):
        self._shadow_error = None
        try:
            self._force_stroke = bool(self.get_setting("force_stroke", False))
        except Exception:
            self._force_stroke = False
        try:
            self.outline_enabled = bool(self.get_setting("outline_enable", True))
        except Exception:
            self.outline_enabled = True
        try:
            size_idx = int(self.get_setting("outline_size", 1))
        except Exception:
            size_idx = 1
        if size_idx < 0 or size_idx >= len(OUTLINE_SIZE_VALUES):
            size_idx = 1
        try:
            alpha_idx = int(self.get_setting("outline_alpha", 3))
        except Exception:
            alpha_idx = 3
        if alpha_idx < 0 or alpha_idx >= len(OUTLINE_ALPHA_VALUES):
            alpha_idx = 3
        self.outline_size = float(OUTLINE_SIZE_VALUES[size_idx])
        self.outline_alpha = float(OUTLINE_ALPHA_VALUES[alpha_idx])
        raw_in = str(self.get_setting("outline_in", OUTLINE_IN_DEFAULT))
        raw_out = str(self.get_setting("outline_out", OUTLINE_OUT_DEFAULT))
        c_in = parse_hex(raw_in)
        c_out = parse_hex(raw_out)
        if c_in is None:
            c_in = parse_hex(OUTLINE_IN_DEFAULT)
        if c_out is None:
            c_out = parse_hex(OUTLINE_OUT_DEFAULT)
        self.outline_in = raw_in
        self.outline_out = raw_out
        self._outline_in_color = int(c_in)
        self._outline_out_color = int(c_out)
        try:
            self.stroke_paint_in = self._make_stroke_paint(int(c_in))
        except Exception:
            self.stroke_paint_in = None
        try:
            self.stroke_paint_out = self._make_stroke_paint(int(c_out))
        except Exception:
            self.stroke_paint_out = None

    def _fill_paint_of(self, d):
        # Публичный getPaint() — самый надежный путь, без рефлексии.
        try:
            p = d.getPaint()
            if p is not None:
                return p
        except Exception:
            pass
        try:
            if self._paint_field is not None:
                try:
                    p = self._paint_field.get(d)
                    if p is not None:
                        return p
                except Exception:
                    pass
            try:
                return d.JA.paint
            except Exception:
                pass
        except Exception:
            pass
        try:
            self._shadow_error = "no-paint"
        except Exception:
            pass
        return None

    def _resolve_shadow_method(self, paint):
        # Класс берем из самого объекта — без find_class и TYPE-полей.
        if self._shadow_method_tried:
            return self._shadow_method
        self._shadow_method_tried = True
        try:
            try:
                cls = paint.getClass()
            except Exception as e:
                self._shadow_error = f"getClass:{e}"[:80]
                return None
            try:
                methods = cls.getMethods()
            except Exception as e:
                self._shadow_error = f"getMethods:{e}"[:80]
                return None
            m = None
            try:
                for cand in methods:
                    try:
                        if str(cand.getName()) == "setShadowLayer" and int(cand.getParameterCount()) == 4:
                            m = cand
                            break
                    except Exception:
                        pass
            except Exception as e:
                self._shadow_error = f"scan:{e}"[:80]
                return None
            if m is None:
                self._shadow_error = "no-method"
                return None
            try:
                m.setAccessible(True)
            except Exception:
                pass
            self._shadow_method = m
            return m
        except Exception as e:
            self._shadow_error = f"resolve:{e}"[:80]
            return None

    def _apply_shadow_to_drawable(self, d, is_in=True):
        # Один проход fill+outline силами клиента. Редкий путь.
        try:
            paint = self._fill_paint_of(d)
            if paint is None:
                return False
            if not self.outline_enabled:
                try:
                    paint.clearShadowLayer()
                except Exception:
                    pass
                return True
            try:
                from org.telegram.messenger import AndroidUtilities
                w = float(AndroidUtilities.dp(float(self.outline_size)))
            except Exception:
                w = 3.0
            if w < 1:
                w = 1.0
            base = self._outline_in_color if is_in else self._outline_out_color
            col = int(apply_alpha(base, self.outline_alpha))
            done = False
            errs = []
            # 1) Явный Object[] из предупакованных Float/Integer: всего 2
            # аргумента верхнего уровня вместо 5 — в обход varargs-маршалинга.
            try:
                m = self._resolve_shadow_method(paint)
                if m is None:
                    errs.append("no-method")
                else:
                    try:
                        from java.lang import Float as _JF, Integer as _JI, Object as _JO
                        from java import jarray
                        arr = jarray(_JO)([_JF(float(w)), _JF(0.0), _JF(0.0), _JI(to_java_int(col))])
                        m.invoke(paint, arr)
                        done = True
                    except Exception as e:
                        errs.append(f"arr:{e}"[:40])
            except Exception as e:
                errs.append(f"prep:{e}"[:40])
            # 2) Запасной прямой вызов.
            if not done:
                try:
                    paint.setShadowLayer(float(w), 0.0, 0.0, to_java_int(col))
                    done = True
                except Exception as e:
                    errs.append(f"direct:{e}"[:40])
            if not done:
                self._shadow_error = "|".join(errs)[:80]
                return False
            return True
        except Exception as e:
            self._shadow_error = f"apply:{e}"[:80]
            return False

    def _apply_shadow_to_all(self):
        ok = 0
        bad = []
        try:
            from org.telegram.ui.ActionBar import Theme
            for name in MSG_DRAWABLE_FIELDS:
                try:
                    d = getattr(Theme, name, None)
                    if d is None:
                        bad.append(name.replace("chat_msg", "").replace("Drawable", "") + "?")
                        continue
                    self._remember_drawable(d)
                    side_in = "msgIn" in name
                    try:
                        transparent = self._in_transparent if side_in else self._out_transparent
                    except Exception:
                        transparent = False
                    if transparent:
                        # Прозрачной заливке тень не видна — чистим, контур даст штрих.
                        try:
                            paint = self._fill_paint_of(d)
                            if paint is not None:
                                try:
                                    paint.clearShadowLayer()
                                except Exception:
                                    pass
                        except Exception:
                            pass
                        ok += 1
                    elif self._apply_shadow_to_drawable(d, side_in):
                        ok += 1
                    else:
                        bad.append(name.replace("chat_msg", "").replace("Drawable", ""))
                except Exception:
                    pass
        except Exception as e:
            self._shadow_error = f"all:{e}"[:80]
        self._shadow_ok = ok
        self._shadow_bad = bad

    def _patch_drawable(self, d):
        try:
            d.setRoundingRadius(float(ROUNDING_EPSILON))
            try:
                self._patched_drawables += 1
            except Exception:
                pass
            self._remember_drawable(d)
            return True
        except Exception:
            return False

    def _patch_existing_drawables(self):
        try:
            from org.telegram.ui.ActionBar import Theme
            for name in MSG_DRAWABLE_FIELDS:
                try:
                    d = getattr(Theme, name, None)
                    if d is not None:
                        self._patch_drawable(d)
                except Exception:
                    pass
        except Exception as e:
            try:
                self.log(f"patch existing failed: {e}")
            except Exception:
                pass

    def _hook_drawable_ctors(self):
        try:
            from hook_utils import find_class
            cls = find_class("org.telegram.ui.ActionBar.Theme$MessageDrawable")
            if cls is None:
                return
            try:
                self.hook_all_constructors(cls, DrawablePatchHook(self))
            except Exception as e:
                self.log(f"hook MessageDrawable ctors failed: {e}")
        except Exception as e:
            self.log(f"drawable ctor hook setup failed: {e}")

    def _hook_theme_reapply(self):
        try:
            from hook_utils import find_class
            theme_cls = find_class("org.telegram.ui.ActionBar.Theme")
            if theme_cls is None:
                return
            try:
                cb = ReapplyShadowHook(self)
                self.hook_all_methods(theme_cls, "applyChatTheme", cb)
                self.hook_all_methods(theme_cls, "applyTheme", cb)
            except Exception as e:
                self.log(f"hook applyTheme failed: {e}")
        except Exception as e:
            self.log(f"theme reapply hook setup failed: {e}")

    def _clear_shadows(self):
        try:
            for d in list(self._patched_refs):
                try:
                    paint = self._fill_paint_of(d)
                    if paint is not None:
                        try:
                            paint.clearShadowLayer()
                        except Exception:
                            pass
                except Exception:
                    pass
                try:
                    d.setRoundingRadius(0.0)
                except Exception:
                    pass
        except Exception:
            pass
        self._shadow_ok = 0

    def _refresh_all(self):
        self._rebuild_outline_cache()
        self._evaluate_modes()
        if self.outline_enabled:
            self._patch_existing_drawables()
        else:
            self._clear_shadows()
        self._apply_shadow_to_all()
        self._sync_draw_hook()

    def _migrate_legacy(self):
        # v1.x писал свои цвета поверх темы через setColor. Откатываем
        # переприменением АКТИВНОЙ темы целиком (с учетом ночь/день).
        try:
            from org.telegram.ui.ActionBar import Theme
            try:
                info = Theme.getActiveTheme()
            except Exception:
                info = None
            if info is not None:
                try:
                    night = bool(Theme.isCurrentThemeNight())
                except Exception:
                    night = False
                try:
                    Theme.applyTheme(info, night)
                except Exception as e:
                    self.log(f"re-apply theme failed: {e}")
        except Exception as e:
            try:
                self.log(f"migrate failed: {e}")
            except Exception:
                pass
        try:
            self.set_setting("migrated21", True)
        except Exception:
            pass

    def apply_all(self):
        self._rebuild_outline_cache()
        self._apply_shadow_to_all()

    def on_plugin_load(self):
        self._init_paint_field()
        self._init_fields()
        self._hook_drawable_ctors()
        self._hook_theme_reapply()
        self._refresh_all()
        try:
            if not self.get_setting("migrated21", False):
                self._on_ui(self._migrate_legacy)
        except Exception:
            pass
        self.log(f"Bubble Outline 3.4.1 loaded, patched={self._patched_drawables} shadow_ok={self._shadow_ok}")
        try:
            if self._shadow_error:
                self._bulletin(f"err={self._shadow_error}\nshadow x{self._shadow_ok}")
            else:
                mode_in = "stroke" if self._in_transparent else "shadow"
                mode_out = "stroke" if self._out_transparent else "shadow"
                fmark = " F" if self._force_stroke else ""
                self._bulletin(f"3.4.1 in:{mode_in} out:{mode_out}{fmark} sh x{self._shadow_ok}")
        except Exception:
            pass

    def _on_outline_toggle(self, v):
        self._refresh_all()

    def _on_force_toggle(self, v):
        self._refresh_all()

    def _on_outline_change(self, new_value):
        self._refresh_all()

    def _bulletin(self, text):
        try:
            from android_utils import run_on_ui_thread

            def _do():
                try:
                    from ui.bulletin import BulletinHelper
                    BulletinHelper.show_info(str(text))
                except Exception:
                    pass

            run_on_ui_thread(_do)
        except Exception:
            pass

    def _show_diag(self, view=None):
        try:
            if self._shadow_error:
                msg = f"err={self._shadow_error}\nshadow x{self._shadow_ok} p={self._patched_drawables}"
            else:
                bad = ",".join(self._shadow_bad)
                mode_in = "stroke" if self._in_transparent else "shadow"
                mode_out = "stroke" if self._out_transparent else "shadow"
                fmark = " F" if self._force_stroke else ""
                msg = (f"in:{mode_in} out:{mode_out}{fmark} sh x{self._shadow_ok}\n"
                       f"stI={self._stroke_in} stO={self._stroke_out} bad:{bad if bad else '-'}")
        except Exception as e:
            msg = f"diag failed: {e}"
        self._bulletin(msg)

    def create_settings(self) -> List[Any]:
        from ui.settings import Divider, Header, Input, Selector, Switch, Text
        items: List[Any] = []
        items.append(Header(text="Outline (контур бабблов)"))
        items.append(Switch(key="outline_enable", text="Включить outline", default=True, subtext="Контур запекается в бабблы, без нагрузки на скролл", icon="msg_border", on_change=self._on_outline_toggle))
        items.append(Input(key="outline_in", text="bubbleIn_outline (чужие)", default="#FFFFFF", subtext="HEX цвет входящих", icon="msg_color", on_change=self._on_outline_change))
        items.append(Input(key="outline_out", text="bubbleOut_outline (мои)", default="#FFFFFF", subtext="HEX цвет исходящих", icon="msg_color", on_change=self._on_outline_change))
        items.append(Selector(key="outline_size", text="Толщина (dp)", default=1, items=OUTLINE_SIZE_OPTIONS, icon="msg_line", on_change=self._on_outline_change))
        items.append(Selector(key="outline_alpha", text="Непрозрачность", default=3, items=OUTLINE_ALPHA_OPTIONS, icon="msg_opacity", on_change=self._on_outline_change))
        items.append(Switch(key="force_stroke", text="Форсировать штрих везде", default=False, subtext="Четкий контур поверх всего (дороже)", icon="msg_flash", on_change=self._on_force_toggle))
        items.append(Divider(text="Диагностика"))
        items.append(Text(text="Диагностика outline", subtext="Показать состояние на экране", icon="msg_info", on_click=self._show_diag))
        return items
