    def _lg_changelog_scroll_row(self):
        if Custom is None:
            return None
        try:
            from android.graphics import Typeface
            from android.util import TypedValue
            from android.view import Gravity, ViewGroup
            from android.widget import FrameLayout, LinearLayout, ScrollView, TextView
            from org.telegram.ui.Components import BackupImageView

            context = ApplicationLoader.applicationContext
            scroll = ScrollView(context)
            try:
                scroll.setNestedScrollingEnabled(True)
                scroll.setVerticalScrollBarEnabled(True)
                scroll.setScrollbarFadingEnabled(False)
            except Exception:
                pass

            try:
                screen_h = int(AndroidUtilities.displaySize.y)
            except Exception:
                screen_h = AndroidUtilities.dp(640)
            scroll_h = max(AndroidUtilities.dp(280), int(screen_h * 0.58))
            scroll.setLayoutParams(
                LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, scroll_h)
            )

            outer = LinearLayout(context)
            outer.setOrientation(LinearLayout.VERTICAL)
            outer.setGravity(Gravity.CENTER_HORIZONTAL)
            outer.setLayoutParams(
                LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT)
            )
            outer.setPadding(
                AndroidUtilities.dp(18),
                AndroidUtilities.dp(14),
                AndroidUtilities.dp(18),
                AndroidUtilities.dp(20),
            )

            icon = BackupImageView(context)
            icon.setRoundRadius(AndroidUtilities.dp(16))
            _lg_apply_plugin_icon(icon)
            outer.addView(
                icon,
                LinearLayout.LayoutParams(AndroidUtilities.dp(56), AndroidUtilities.dp(56)),
            )

            title = TextView(context)
            title.setText(self._tr("changelog"))
            title.setTextSize(TypedValue.COMPLEX_UNIT_SP, 20.0)
            title.setTypeface(Typeface.DEFAULT, Typeface.BOLD)
            title.setGravity(Gravity.CENTER)
            title.setTextColor(int(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText)))
            _lg_wrap_textview(title, 2)
            title_params = LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT)
            title_params.topMargin = AndroidUtilities.dp(10)
            outer.addView(title, title_params)

            intro = TextView(context)
            intro.setText(self._tr("cl_intro") + " · " + self._tr("cl_header_fmt", ver=__version__))
            intro.setTextSize(TypedValue.COMPLEX_UNIT_SP, 13.0)
            intro.setGravity(Gravity.CENTER)
            intro.setTextColor(int(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText)))
            _lg_wrap_textview(intro, 3)
            intro_params = LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT)
            intro_params.topMargin = AndroidUtilities.dp(4)
            intro_params.bottomMargin = AndroidUtilities.dp(12)
            outer.addView(intro, intro_params)

            body = TextView(context)
            body.setText(self._tr("cl_body"))
            body.setTextSize(TypedValue.COMPLEX_UNIT_SP, 15.0)
            body.setTextColor(int(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText)))
            body.setSingleLine(False)
            try:
                body.setMaxLines(10000)
                body.setEllipsize(None)
                body.setHorizontallyScrolling(False)
                body.setTextIsSelectable(True)
                body.setLineSpacing(float(AndroidUtilities.dp(3)), 1.08)
            except Exception:
                pass
            outer.addView(
                body,
                LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT),
            )

            scroll.addView(
                outer,
                FrameLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT),
            )
            return Custom(view=scroll)
        except Exception as exc:
            self._debug_log_exc("changelog scroll", exc)
            return None

    def _create_changelog_subfragment(self):
        row = self._safe_settings_row(self._lg_changelog_scroll_row)
        if row is not None:
            return [row]
        rows = [Header(text=self._tr("changelog"))]
        for part in self._tr("cl_body").split("\n"):
            chunk = part.strip()
            if chunk:
                rows.append(Divider(text=chunk))
        return rows if len(rows) > 1 else [
            Header(text=self._tr("changelog")),
            Divider(text=self._tr("cl_intro")),
        ]

