def _setting_icon(key, fallback="msg_info"):
    return SETTING_ICONS.get(key, fallback)


def _ui_icon(key, fallback="msg_info"):
    return _UI_MENU_ICONS.get(key, fallback)


def _lg_format_slider_display(key, value_str):
    spec = _NUMERIC_SLIDER_SPECS.get(key, {})
    unit = spec.get("unit", "")
    try:
        v = float(str(value_str).replace(",", "."))
    except Exception:
        return str(value_str)
    if spec.get("kind") == "int":
        return "%d%s" % (int(round(v)), unit)
    text = ("%.2f" % v).rstrip("0").rstrip(".")
    return text + unit if unit else text


def _lg_icon_pack_index():
    raw = str(__icon__ or "").strip()
    if "/" in raw:
        pack, idx = raw.rsplit("/", 1)
        try:
            return str(pack), int(idx)
        except Exception:
            pass
    return "exteraPlugins", 0


def _lg_apply_plugin_icon(image_view):
    if image_view is None:
        return
    try:
        from org.telegram.messenger import MediaDataController, UserConfig
        pack, index = _lg_icon_pack_index()
        MediaDataController.getInstance(int(UserConfig.selectedAccount)).setPlaceholderImageByIndex(
            image_view,
            pack,
            index,
            "100_100",
        )
    except Exception:
        pass


def _lg_bind_static_setting_view(view, item, divider, adapter, list_view):
    return


def _lg_wrap_textview(tv, max_lines=3):
    try:
        tv.setSingleLine(False)
        tv.setMaxLines(int(max_lines))
        from android.text import TextUtils
        tv.setEllipsize(TextUtils.TruncateAt.END)
        tv.setHorizontallyScrolling(False)
    except Exception:
        pass


def _lg_bind_header_view(view, item, divider, adapter, list_view):
    return


def _lg_create_header_view_impl(context, list_view, current_account, class_guid, resources_provider):
    from android.graphics import Typeface
    from android.graphics.drawable import GradientDrawable
    from android.util import TypedValue
    from android.view import Gravity, View, ViewGroup
    from android.widget import LinearLayout, TextView

    plugin = _ACTIVE_LG_PLUGIN
    outer = LinearLayout(context)
    outer.setOrientation(LinearLayout.VERTICAL)
    outer.setGravity(Gravity.CENTER_HORIZONTAL)
    outer.setLayoutParams(
        LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT)
    )
    outer.setPadding(
        AndroidUtilities.dp(20),
        AndroidUtilities.dp(22),
        AndroidUtilities.dp(20),
        AndroidUtilities.dp(10),
    )

    title = TextView(context)
    if plugin is not None:
        try:
            title.setText(plugin._tr("header_brand"))
        except Exception:
            title.setText("Liquid Glass")
    else:
        title.setText("Liquid Glass")
    title.setTextSize(TypedValue.COMPLEX_UNIT_SP, 24.0)
    title.setGravity(Gravity.CENTER)
    title.setSingleLine(False)
    title.setMaxLines(2)
    try:
        title.setEllipsize(None)
        title.setHorizontallyScrolling(False)
    except Exception:
        pass
    title.setTextColor(int(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText)))
    try:
        title.setTypeface(AndroidUtilities.bold())
    except Exception:
        title.setTypeface(Typeface.DEFAULT, Typeface.BOLD)
    title_params = LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT)
    title_params.gravity = Gravity.CENTER_HORIZONTAL
    outer.addView(title, title_params)

    accent = View(context)
    accent_draw = GradientDrawable()
    accent_draw.setShape(GradientDrawable.RECTANGLE)
    accent_draw.setCornerRadius(float(AndroidUtilities.dp(2)))
    accent_draw.setColor(int(Theme.getColor(Theme.key_windowBackgroundWhiteBlueText)))
    accent.setBackground(accent_draw)
    accent_params = LinearLayout.LayoutParams(AndroidUtilities.dp(36), AndroidUtilities.dp(2))
    accent_params.topMargin = AndroidUtilities.dp(8)
    accent_params.gravity = Gravity.CENTER_HORIZONTAL
    outer.addView(accent, accent_params)

    version = TextView(context)
    if plugin is not None:
        try:
            version.setText(plugin._tr("header_version_fmt", ver=__version__))
        except Exception:
            version.setText("v%s" % __version__)
    else:
        version.setText("v%s" % __version__)
    version.setTextSize(TypedValue.COMPLEX_UNIT_SP, 13.0)
    version.setGravity(Gravity.CENTER)
    version.setSingleLine(True)
    try:
        from android.text import TextUtils
        version.setEllipsize(TextUtils.TruncateAt.END)
    except Exception:
        pass
    version.setLetterSpacing(0.04)
    version.setTextColor(int(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText2)))
    version_params = LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT)
    version_params.topMargin = AndroidUtilities.dp(6)
    version_params.gravity = Gravity.CENTER_HORIZONTAL
    outer.addView(version, version_params)

    return outer


def _lg_create_header_view(context, list_view, current_account, class_guid, resources_provider):
    try:
        return _lg_create_header_view_impl(context, list_view, current_account, class_guid, resources_provider)
    except Exception:
        from android.widget import TextView
        view = TextView(context)
        view.setText("Liquid Glass %s" % __version__)
        return view


LiquidGlassHeaderFactory = None
if SimpleSettingFactory is not None:
    try:
        LiquidGlassHeaderFactory = SimpleSettingFactory(
            _lg_create_header_view,
            _lg_bind_header_view,
            is_clickable=False,
        )
    except Exception:
        LiquidGlassHeaderFactory = None


class _ColorProviderProxy(dynamic_proxy(BlurredBackgroundColorProvider)):
    def __init__(self, base, disable_top_stroke=False, disable_shadow=False, disable_bottom_stroke=False):
        super().__init__()
        self._base = base
        self._disable_top_stroke = disable_top_stroke
        self._disable_shadow = disable_shadow
        self._disable_bottom_stroke = disable_bottom_stroke

    def getShadowColor(self):
        if self._disable_shadow:
            return 0
        try:
            return self._base.getShadowColor()
        except Exception:
            return 0

    def getBackgroundColor(self):
        try:
            return int(self._base.getBackgroundColor())
        except Exception:
            return 0

    def getStrokeColorTop(self):
        if self._disable_top_stroke:
            return 0
        try:
            return self._base.getStrokeColorTop()
        except Exception:
            return 0

    def getStrokeColorBottom(self):
        if self._disable_bottom_stroke:
            return 0
        try:
            return self._base.getStrokeColorBottom()
        except Exception:
            return 0

    def getStrokeColorFull(self):
        try:
            return self._base.getStrokeColorFull()
        except Exception:
            return 0


def safe_find_class(class_name):
    if class_name in _class_cache:
        return _class_cache[class_name]
    try:
        cls = find_class(class_name)
        _class_cache[class_name] = cls
        return cls
    except Exception:
        _class_cache[class_name] = None
        return None


def _fragment_class_name(fragment):
    if not fragment:
        return None
    try:
        return fragment.getClass().getName()
    except Exception:
        return None


def _get_first_available_field(obj, *names):
    if not obj or not names:
        return None
    for name in names:
        try:
            v = getattr(obj, name, None)
        except Exception:
            v = None
        if v is not None:
            return v
        try:
            v = get_private_field(obj, name)
        except Exception:
            v = None
        if v is not None:
            return v
    return None


def _truthy_fragment_flag(raw):
    if raw is None:
        return False
    try:
        if callable(raw):
            raw = raw()
    except Exception:
        return False
    try:
        return bool(raw)
    except Exception:
        return False


class LiquidGlassPlugin(BasePlugin):
    _TOP_PANEL_PROVIDER_METHODS = {
        "chat": "topPanelChatActivity",
        "top_panel": "topPanel",
        "search_tags": "topPanelChatActivityTags",
        "search_list": "topPanelChatActivitySearchListBg",
    }
    _APPLY_DEBOUNCE_MS = 180
    _PERFORMANCE_DEBOUNCE_MS = 280
    _MIN_TOP_PANEL_DP = 8
    # Cell setDialog path removed — scrolling must never drive glass apply.
    _DIALOGS_EXTRA_FROM_CELL_MS = 2500
    _DIALOGS_REQUEST_FOLLOWUP_MS = 280
    _DIALOGS_REQUEST_COALESCE_MS = 180
    _DRAWABLE_CACHE_MAX = 72
    _BOOT_POLL_MAX_TRIES = 12
    _BOOT_POLL_MAX_TRIES_PERF = 8
    _BOOT_POLL_INTERVAL_MS = 240
    _BOOT_POLL_INTERVAL_MS_PERF = 280
    _STARTUP_GRACE_MS = 1800
    _STARTUP_DEBOUNCE_MIN_MS = 220
    _STARTUP_EXTRA_DELAY_MIN_MS = 80
    _STATE_STORE_MAX = 128
    _FACTORY_RETRY_COOLDOWN_MS = 2500
    _THEME_BURST_DEBOUNCE_MS = 320
    _TOP_PANEL_NATIVE_GRACE_MS = 0
    _TOP_PANEL_NATIVE_GRACE_MS_DIALOGS = 80
    _TOP_PANEL_TUNE_RETRY_MS = (120, 280)
    _TOP_PANEL_TUNE_RETRY_MS_PERF = (200, 400)
    _TOP_PANEL_TUNE_RETRY_MS_DIALOGS = (160, 360)
    _TOP_PANEL_TUNE_RETRY_MS_DIALOGS_PERF = (240, 480)
    _ACTION_BAR_COLOR_SHIELD_MS = 90
    _ACTION_BAR_MODE_RESUME_MS = 220

    def __init__(self):
        global _ACTIVE_LG_PLUGIN
        _ACTIVE_LG_PLUGIN = self
        super().__init__()
        self._loaded = False
        self._hooks = []
        self._applied = {}
        self._warned_keys = set()
        self._apply_pending = set()
        self._apply_requested = set()
        self._drawable_cache = OrderedDict()
        self._last_apply_time = {}
        self._active_chats = WeakSet()
        self._extras_applied = {}
        self._active_extras = WeakSet()
        self._dialogs_req_gen = {}
        self._dialogs_req_last_ms = {}
        self._startup_grace_until_ms = 0.0
        self._extra_apply_gen = {}
        self._settings_apply_gen = 0
        self._factory_cooldown_chat = {}
        self._factory_cooldown_extra = {}
        self._action_bar_color_shield_last = {}
        self._action_bar_store_index = {}
        self._theme_burst_hint_shown = False
        self._load_requirements_hint_shown = False
        self._menu_chat_reapply_id = None
        self._menu_chat_settings_id = None
        self._menu_action_debounce_ts = {}
        self._chat_followup_gen = {}
        self._supported_cache = None  # (ok: bool, until_ms: float)
        self._prune_tick = 0
        self._diag = {
            "factory_miss_chat": 0,
            "factory_miss_extra": 0,
            "factory_cooldown_skip_chat": 0,
            "factory_cooldown_skip_extra": 0,
            "theme_burst_chat": 0,
            "theme_burst_extra": 0,
            "state_prunes": 0,
            "action_bar_shield_calls": 0,
            "action_bar_bg_restore_calls": 0,
            "drawable_create_fail": 0,
            "drawable_cache_hits": 0,
            "dialog_shown": 0,
            "import_confirmed": 0,
            "import_cancelled": 0,
        }

    def _arm_startup_grace(self):
        self._startup_grace_until_ms = (time.time() * 1000.0) + float(self._STARTUP_GRACE_MS)

    def _in_startup_grace(self):
        return (time.time() * 1000.0) < self._startup_grace_until_ms

    def _index_action_bar_store(self, action_bar, store):
        if action_bar is not None and store is not None:
            self._action_bar_store_index[id(action_bar)] = store

    def _unindex_action_bar_store(self, action_bar):
        if action_bar is not None:
            self._action_bar_store_index.pop(id(action_bar), None)

    def _rebuild_action_bar_store_index(self):
        self._action_bar_store_index.clear()
        for store in list(self._applied.values()) + list(self._extras_applied.values()):
            entry = store.get("action_bar")
            view = entry.get("view") if entry else None
            if view is not None:
                self._action_bar_store_index[id(view)] = store

    def _schedule_settings_reapply(self, delay_ms=120):
        self._settings_apply_gen += 1
        gen = int(self._settings_apply_gen)
        self._supported_cache = None

        def _run():
            if int(self._settings_apply_gen) != gen:
                return
            self._restore_all()

        run_on_ui_thread(_run, delay_ms)

    def _clear_reapply_runtime_state(self):
        self._supported_cache = None
        self._last_apply_time.clear()
        self._apply_pending.clear()
        self._apply_requested.clear()
        self._extra_apply_gen.clear()
        self._factory_cooldown_chat.clear()
        self._factory_cooldown_extra.clear()
        self._chat_followup_gen.clear()
        self._drawable_cache.clear()
        self._action_bar_store_index.clear()

    def _dialogs_boot_poll_needed(self):
        if not self._loaded or not self.get_setting("enabled", True):
            return False
        if not self._is_supported():
            return False
        return bool(
            self.get_setting("apply_dialogs_list", DEFAULT_SETTINGS["apply_dialogs_list"])
            or self.get_setting("apply_action_bar", DEFAULT_SETTINGS["apply_action_bar"])
        )

    def _boot_poll_max_tries(self):
        if not self._dialogs_boot_poll_needed():
            return 0
        if bool(self.get_setting("performance_mode", False)):
            return self._BOOT_POLL_MAX_TRIES_PERF
        return self._BOOT_POLL_MAX_TRIES

    def _boot_poll_interval_ms(self):
        if bool(self.get_setting("performance_mode", False)):
            return self._BOOT_POLL_INTERVAL_MS_PERF
        return self._BOOT_POLL_INTERVAL_MS

    def on_app_event(self, event_type: AppEvent):
        if event_type == AppEvent.START:
            self._arm_startup_grace()
        if event_type in (AppEvent.START, AppEvent.RESUME):
            self._arm_dialogs_boot_poll()

    def on_plugin_load(self):
        global _ACTIVE_LG_PLUGIN
        if self._loaded:
            self.on_plugin_unload()
        _ACTIVE_LG_PLUGIN = self
        self._warned_keys = set()
        self._loaded = True
        self._theme_burst_hint_shown = False
        self._boot_glass_gen = 0
        self._boot_sched_ms = 0.0
        self._dialogs_boot_tries = 0
        self._arm_startup_grace()
        self._verify_client_requirements()
        self._hook_chat_activity()
        self._hook_action_bar()
        self._hook_chat_search_tabs()
        self._hook_extra_fragments()
        self._register_menu_items()
        try:
            probe_cls = safe_find_class("org.telegram.ui.ChatActivity")
            has_resume = self._class_declared_method(probe_cls, "onResume") is not None if probe_cls else False
            self.log(
                "[LiquidGlass] ready onResume=%s hooks=%d"
                % (has_resume, len(self._hooks))
            )
        except Exception as exc:
            try:
                self.log("[LiquidGlass] ready probe failed: %s" % exc)
            except Exception:
                pass
        self._arm_dialogs_boot_poll()
        self._normalize_stored_settings()
        try:
            if not bool(self.get_setting("lg_welcome_shown_v4_0", False)):
                self.set_setting("lg_welcome_shown_v4_0", True)
                AndroidUtilities.runOnUIThread(lambda: self._show_welcome_sheet(), 700)
        except Exception as exc:
            self._debug_log_exc("welcome schedule", exc)

    def _lang(self):
        try:
            raw = self.get_setting("ui_lang", 0)
            if isinstance(raw, str):
                s = raw.strip().lower()
                if s == "ru":
                    return "ru"
                if s == "en":
                    return "en"
            else:
                idx = int(raw or 0)
                if idx == 1:
                    return "ru"
                if idx == 2:
                    return "en"
        except Exception:
            pass
        try:
            from java.util import Locale
            lang = str(Locale.getDefault().getLanguage() or "").lower()
            if lang.startswith("ru"):
                return "ru"
            return "en"
        except Exception:
            return "ru"

    def _tr(self, key, **fmt):
        try:
            lang = self._lang()
            text = str(_LG_STRINGS.get(lang, {}).get(key) or _LG_STRINGS["en"].get(key) or key)
            if fmt:
                return text.format(**fmt)
            return text
        except Exception:
            return str(key)

    def _area_label(self, key):
        i18n_key = _AREA_I18N_KEYS.get(key)
        if i18n_key:
            return self._tr(i18n_key)
        return _AREA_LABELS.get(key, key)

    def _area_subtext(self, key):
        sub_key = _AREA_I18N_KEYS.get(key, "") + "_sub"
        if sub_key.endswith("_sub"):
            try:
                return self._tr(sub_key)
            except Exception:
                pass
        return ""

    def _get_user_first_name(self):
        invalid = frozenset({"", "-", ".", "—", "–", "…", "_", "null", "none"})
        try:
            from org.telegram.messenger import UserConfig
            account = int(UserConfig.selectedAccount)
            user = UserConfig.getInstance(account).getCurrentUser()
            if user is not None:
                for attr in ("first_name", "last_name", "username"):
                    try:
                        raw = str(getattr(user, attr, "") or "").strip().lstrip("@")
                    except Exception:
                        raw = ""
                    if not raw:
                        continue
                    low = raw.lower()
                    if low in invalid:
                        continue
                    if all(ch in ".-_ " for ch in raw):
                        continue
                    return raw
        except Exception:
            pass
        return ""

    def _settings_welcome_line(self):
        try:
            n = self._count_enabled_areas()
            name = self._get_user_first_name()
            if name:
                return self._tr(
                    "settings_home_welcome_fmt",
                    name=name,
                    zones=n,
                    total=len(_AREA_LABELS),
                )
            return self._tr(
                "settings_home_welcome_plain_fmt",
                zones=n,
                total=len(_AREA_LABELS),
            )
        except Exception:
            return self._settings_home_line()

    def _header_status_subline(self):
        mode = self._settings_effect_mode_label()
        n = self._count_enabled_areas()
        health = self._health_check_line_short()
        return self._tr(
            "header_sub_fmt",
            mode=mode,
            zones=n,
            total=len(_AREA_LABELS),
            health=health,
        )

    def _toggle_strong_glass_quick(self, _view=None):
        try:
            cur = bool(self.get_setting("strong_glass", False))
            self.set_setting("strong_glass", not cur)
            self._schedule_settings_reapply(self._settings_reapply_delay_ms())
            try:
                self.reload_settings()
            except Exception:
                pass
        except Exception as exc:
            self._debug_log_exc("toggle strong glass", exc)

    def _is_conflicting_plugin_enabled(self, plugin_id):
        try:
            from com.exteragram.messenger.plugins import PluginsController
            controller = PluginsController.getInstance()
            if not bool(controller.isPluginEnabled(str(plugin_id))):
                return False
            return controller.plugins.get(str(plugin_id)) is not None
        except Exception:
            return False

    def _conflict_hint_widgets(self):
        rows = []
        conflicts = []
        if self._is_conflicting_plugin_enabled("glassify"):
            conflicts.append("conflict_glassify_name")
        if self._is_conflicting_plugin_enabled("square_liquid_glass"):
            conflicts.append("conflict_square_name")
        if self._is_conflicting_plugin_enabled("setliquid_glass"):
            conflicts.append("conflict_setlg_name")
        for name_key in conflicts:
            rows.append(
                Text(
                    text=self._tr("conflict_title"),
                    subtext=self._tr(name_key),
                    icon="msg_warning",
                    red=True,
                )
            )
        if rows:
            rows.append(Divider(text=self._tr("conflict_hint")))
            rows.append(Divider())
        return rows

    def _on_ui_lang_changed(self, idx):
        try:
            self.set_setting("ui_lang", int(idx))
        except Exception:
            self.set_setting("ui_lang", 0)
        try:
            self.reload_settings()
        except Exception:
            pass

    def _ui_lang_selector_index(self):
        try:
            raw = self.get_setting("ui_lang", 0)
            if isinstance(raw, str):
                s = raw.strip().lower()
                if s == "ru":
                    return 1
                if s == "en":
                    return 2
                return 0
            idx = int(raw or 0)
            if idx < 0 or idx >= len(_LG_LANG_OPTIONS):
                return 0
            return idx
        except Exception:
            return 0

    def _on_enabled_changed(self, _v=None):
        self._schedule_settings_reapply(self._settings_reapply_delay_ms())
        try:
            self.reload_settings()
        except Exception:
            pass

    def _on_performance_mode_changed(self, _v=None):
        self._schedule_settings_reapply(self._settings_reapply_delay_ms())
        try:
            self.reload_settings()
        except Exception:
            pass

    def _show_welcome_sheet(self):
        try:
            from android.util import TypedValue
            from android.view import Gravity, View, ViewGroup
            from android.widget import LinearLayout, TextView
            from java import dynamic_proxy as _dp
            from org.telegram.ui.ActionBar import BottomSheet

            fragment = get_last_fragment()
            ctx = fragment.getParentActivity() if fragment else None
            if ctx is None:
                return
            sheet = BottomSheet(ctx, True)
            root = LinearLayout(ctx)
            root.setOrientation(LinearLayout.VERTICAL)
            root.setPadding(
                AndroidUtilities.dp(16),
                AndroidUtilities.dp(14),
                AndroidUtilities.dp(16),
                AndroidUtilities.dp(12),
            )
            title = TextView(ctx)
            title.setText(self._tr("welcome_title_fmt", ver=__version__))
            title.setTextSize(TypedValue.COMPLEX_UNIT_SP, 18.0)
            title.setTextColor(int(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText)))
            _lg_wrap_textview(title, 2)
            root.addView(title, LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT))

            desc = TextView(ctx)
            desc.setText(self._tr("welcome_desc"))
            desc.setTextSize(TypedValue.COMPLEX_UNIT_SP, 14.0)
            desc.setTextColor(int(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText)))
            _lg_wrap_textview(desc, 12)
            desc_params = LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT)
            desc_params.topMargin = AndroidUtilities.dp(8)
            root.addView(desc, desc_params)

            btn_row = LinearLayout(ctx)
            btn_row.setOrientation(LinearLayout.VERTICAL)
            btn_row.setGravity(Gravity.CENTER_HORIZONTAL)
            btn_row_params = LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT)
            btn_row_params.topMargin = AndroidUtilities.dp(14)
            root.addView(btn_row, btn_row_params)

            plugin = self
            btn_index = [0]

            def _mk_action(label, accent, handler):
                tv = TextView(ctx)
                tv.setText(str(label))
                tv.setTextSize(TypedValue.COMPLEX_UNIT_SP, 15.0)
                color_key = Theme.key_windowBackgroundWhiteBlueText if accent else Theme.key_windowBackgroundWhiteGrayText
                tv.setTextColor(int(Theme.getColor(color_key)))
                tv.setPadding(AndroidUtilities.dp(12), AndroidUtilities.dp(8), AndroidUtilities.dp(12), AndroidUtilities.dp(8))
                tv.setClickable(True)
                _lg_wrap_textview(tv, 2)
                tv.setGravity(Gravity.CENTER)

                class _Click(_dp(View.OnClickListener)):
                    def onClick(self_obj, v):
                        try:
                            handler()
                        except Exception:
                            pass
                        try:
                            sheet.dismiss()
                        except Exception:
                            pass

                tv.setOnClickListener(_Click())
                lp = LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT)
                if btn_index[0] > 0:
                    lp.topMargin = AndroidUtilities.dp(6)
                btn_index[0] += 1
                btn_row.addView(tv, lp)

            _mk_action(self._tr("welcome_ok"), False, lambda: None)
            _mk_action(self._tr("welcome_open_settings"), True, lambda: run_on_ui_thread(plugin._open_plugin_settings))

            sheet.setCustomView(root)
            sheet.show()
        except Exception as exc:
            self._debug_log_exc("welcome sheet", exc)

    def _normalize_stored_settings(self):
        for obsolete_key in (
            "settings_tab", "active_preset", "preset_selector", "welcome_shown_v4",
            "lg_welcome_shown_v5", "lg_opt_defaults_applied",
        ):
            try:
                if self.get_setting(obsolete_key, "__lg_missing__") != "__lg_missing__":
                    self.delete_setting(obsolete_key)
            except Exception:
                pass
        for key in _OBSOLETE_SETTING_KEYS:
            try:
                if self.get_setting(key, "__lg_missing__") != "__lg_missing__":
                    self.delete_setting(key)
            except Exception:
                pass
        for key, default in DEFAULT_SETTINGS.items():
            try:
                if self.get_setting(key, "__lg_missing__") is None:
                    self.set_setting(key, default)
                    continue
                self._repair_stored_setting(key)
            except Exception:
                pass
        self._apply_schema_migrations()

    def _apply_schema_migrations(self):
        try:
            if bool(self.get_setting("lg_opt_defaults_applied", False)):
                for key in ("performance_mode", "apply_story_bar", "apply_dialogs_list"):
                    try:
                        self.set_setting(key, DEFAULT_SETTINGS[key])
                    except Exception:
                        pass
                try:
                    self.delete_setting("lg_opt_defaults_applied")
                except Exception:
                    pass
        except Exception:
            pass
        try:
            stored_schema = int(self.get_setting("profile_schema_version", 0) or 0)
            if stored_schema < PROFILE_SCHEMA_VERSION:
                self.set_setting("profile_schema_version", PROFILE_SCHEMA_VERSION)
        except Exception:
            pass

    def _bool_setting(self, key):
        try:
            default = DEFAULT_SETTINGS.get(key, False)
            return bool(self.get_setting(key, default))
        except Exception:
            return bool(DEFAULT_SETTINGS.get(key, False))

    def _chat_zone_flags(self):
        return (
            self._bool_setting("apply_action_bar"),
            self._bool_setting("apply_top_panels"),
            self._bool_setting("apply_search_bar"),
            self._bool_setting("apply_story_bar"),
        )

    def _format_numeric_setting(self, key, value):
        if key not in NUMERIC_SETTING_LIMITS:
            return None
        lo, hi = NUMERIC_SETTING_LIMITS[key]
        v = self._clamp_dp_setting(value, DEFAULT_SETTINGS[key], lo, hi)
        try:
            fv = float(v)
        except Exception:
            return str(DEFAULT_SETTINGS[key])
        if fv.is_integer():
            return str(int(fv))
        return ("%.3f" % fv).rstrip("0").rstrip(".")

    def _repair_stored_setting(self, key):
        default = DEFAULT_SETTINGS.get(key)
        if default is None:
            return
        try:
            raw = self.get_setting(key, "__lg_missing__")
        except Exception:
            return
        if raw is None:
            self.set_setting(key, default)
            return
        if isinstance(default, bool):
            if isinstance(raw, bool):
                return
            if isinstance(raw, (int, float)):
                fixed = raw != 0
            else:
                fixed = str(raw).strip().lower() in ("1", "true", "yes", "on", "да")
            if fixed != raw:
                self.set_setting(key, fixed)
            return
        if key == "ui_lang":
            if isinstance(raw, str):
                s = raw.strip().lower()
                if s == "ru":
                    self.set_setting(key, 1)
                elif s == "en":
                    self.set_setting(key, 2)
                else:
                    self.set_setting(key, 0)
            return
        if key in NUMERIC_SETTING_LIMITS:
            formatted = self._format_numeric_setting(key, raw)
            if formatted is not None and str(raw) != formatted:
                self.set_setting(key, formatted)

    def _on_numeric_input_change(self, key, _view=None):
        self._repair_stored_setting(key)
        delay = 110 if key in ("action_bar_alpha", "panel_alpha") else 120
        self._schedule_settings_reapply(delay)

    def _on_sdk_slider_change(self, key, value):
        spec = _NUMERIC_SLIDER_SPECS.get(key, {})
        try:
            if spec.get("kind") == "int":
                raw = int(value)
            else:
                raw = float(value) / 100.0
        except Exception:
            return
        formatted = self._format_numeric_setting(key, raw)
        if formatted is not None:
            try:
                self.set_setting(key, formatted)
            except Exception:
                pass
        self._schedule_settings_reapply(90)

    def _lg_slider_labels(self, key):
        spec = _NUMERIC_SLIDER_SPECS.get(key, {})
        title_key = spec.get("title_key")
        sub_key = spec.get("subtext_key")
        if title_key:
            title = self._tr(title_key)
        else:
            title = spec.get("title", key)
        if sub_key:
            subtext = self._tr(sub_key)
        else:
            subtext = spec.get("subtext", "")
        return title, subtext

    def _lg_alt_seek_progress(self, key):
        lo, hi = NUMERIC_SETTING_LIMITS[key]
        spec = _NUMERIC_SLIDER_SPECS.get(key, {})
        cur = float(
            self._clamp_dp_setting(
                self.get_setting(key, DEFAULT_SETTINGS[key]),
                DEFAULT_SETTINGS[key],
                lo,
                hi,
            )
        )
        if spec.get("kind") == "int":
            return float(int(round(cur)))
        return float(int(round(cur * 100.0)))

    def _lg_alt_seekbar(self, key):
        spec = _NUMERIC_SLIDER_SPECS.get(key)
        if not spec or AltSeekbar is None or Custom is None:
            return None
        lo, hi = NUMERIC_SETTING_LIMITS[key]
        title, _sub = self._lg_slider_labels(key)
        kind = spec.get("kind", "float2")
        if kind == "int":
            smin, smax = int(lo), int(hi)
            label_min = "%d%s" % (smin, spec.get("unit", ""))
            label_max = "%d%s" % (smax, spec.get("unit", ""))
        else:
            smin, smax = int(round(lo * 100.0)), int(round(hi * 100.0))
            label_min = _lg_format_slider_display(key, str(lo))
            label_max = _lg_format_slider_display(key, str(hi))

        plugin = self

        class _AltSeekDrag(dynamic_proxy(AltSeekbar.OnDrag)):
            def run(self, value):
                try:
                    raw = float(value)
                    if kind == "int":
                        formatted = plugin._format_numeric_setting(key, int(round(raw)))
                    else:
                        formatted = plugin._format_numeric_setting(key, raw / 100.0)
                    if formatted is not None:
                        plugin.set_setting(key, formatted)
                    plugin._schedule_settings_reapply(90)
                except Exception:
                    pass

        listener = _AltSeekDrag()
        if not hasattr(self, "_alt_seekbar_refs"):
            self._alt_seekbar_refs = []
        self._alt_seekbar_refs.append(listener)
        try:
            bar = AltSeekbar(
                ApplicationLoader.applicationContext,
                listener,
                smin,
                smax,
                title,
                label_min,
                label_max,
            )
            bar.setProgress(self._lg_alt_seek_progress(key))
            return Custom(view=bar)
        except Exception as exc:
            self._debug_log_exc("alt seekbar %s" % key, exc)
            return None

    def _lg_slider_widget(self, key):
        spec = _NUMERIC_SLIDER_SPECS.get(key)
        if not spec:
            return None
        row = self._lg_alt_seekbar(key)
        if row is not None:
            return row
        title, subtext = self._lg_slider_labels(key)
        icon = _setting_icon(key)
        if _SdkSlider is not None:
            try:
                lo, hi = NUMERIC_SETTING_LIMITS[key]
                cur = self._clamp_dp_setting(
                    self.get_setting(key, DEFAULT_SETTINGS[key]),
                    DEFAULT_SETTINGS[key],
                    lo,
                    hi,
                )
                if spec.get("kind") == "int":
                    smin, smax, sdef = int(lo), int(hi), int(round(float(cur)))
                else:
                    smin, smax, sdef = int(round(lo * 100)), int(round(hi * 100)), int(round(float(cur) * 100))
                return _SdkSlider(
                    key=key,
                    text=title,
                    subtext=subtext,
                    icon=icon,
                    default=sdef,
                    min=smin,
                    max=smax,
                    on_change=lambda v, k=key: self._on_sdk_slider_change(k, v),
                )
            except Exception as exc:
                self._debug_log_exc("sdk slider %s" % key, exc)
        return Input(
            key=key,
            text=title,
            subtext=subtext,
            icon=icon,
            default=str(DEFAULT_SETTINGS[key]),
            on_change=lambda v, k=key: self._on_numeric_input_change(k, v),
        )

    def _lg_slider_group(self, keys):
        rows = []
        for key in keys:
            row = self._lg_slider_widget(key)
            if row is not None:
                rows.append(row)
        return rows

    def _lg_header_row(self):
        if Custom is None:
            return None
        try:
            context = ApplicationLoader.applicationContext
            outer = _lg_create_header_view_impl(context, None, 0, 0, None)
            return Custom(view=outer)
        except Exception as exc:
            self._debug_log_exc("header row", exc)
            return None

    def _lg_preview_row(self):
        if Custom is None:
            return None
        try:
            from android.graphics.drawable import GradientDrawable
            from android.util import TypedValue
            from android.view import Gravity, View, ViewGroup
            from android.widget import LinearLayout, TextView
            from java import dynamic_proxy as _dp

            plugin = self
            context = ApplicationLoader.applicationContext
            outer = LinearLayout(context)
            outer.setOrientation(LinearLayout.VERTICAL)
            outer.setLayoutParams(
                LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT)
            )
            outer.setPadding(
                AndroidUtilities.dp(14),
                AndroidUtilities.dp(12),
                AndroidUtilities.dp(14),
                AndroidUtilities.dp(12),
            )
            card_bg = GradientDrawable()
            card_bg.setShape(GradientDrawable.RECTANGLE)
            card_bg.setCornerRadius(float(AndroidUtilities.dp(18)))
            card_bg.setColor(int(Theme.getColor(Theme.key_dialogBackground)))
            card_bg.setStroke(
                AndroidUtilities.dp(1),
                int(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText2)),
            )
            outer.setBackground(card_bg)

            head = LinearLayout(context)
            head.setOrientation(LinearLayout.HORIZONTAL)
            head.setGravity(Gravity.CENTER_VERTICAL)
            outer.addView(
                head,
                LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT),
            )

            title = TextView(context)
            title.setText(self._tr("preview_title"))
            title.setTextSize(TypedValue.COMPLEX_UNIT_SP, 16.0)
            title.setTextColor(int(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText)))
            _lg_wrap_textview(title, 2)
            head.addView(
                title,
                LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1.0),
            )

            badge = TextView(context)
            badge.setText(self._settings_effect_mode_label())
            badge.setTextSize(TypedValue.COMPLEX_UNIT_SP, 11.0)
            badge.setTextColor(int(Theme.getColor(Theme.key_windowBackgroundWhiteBlueText)))
            _lg_wrap_textview(badge, 1)
            badge.setPadding(
                AndroidUtilities.dp(8),
                AndroidUtilities.dp(3),
                AndroidUtilities.dp(8),
                AndroidUtilities.dp(3),
            )
            badge_bg = GradientDrawable()
            badge_bg.setCornerRadius(float(AndroidUtilities.dp(10)))
            badge_c = int(Theme.getColor(Theme.key_chat_inBubble))
            badge_bg.setColor((badge_c & 0x00FFFFFF) | 0x33000000)
            badge.setBackground(badge_bg)
            head.addView(badge, LinearLayout.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT))

            try:
                ab_alpha = float(self.get_setting("action_bar_alpha", DEFAULT_SETTINGS["action_bar_alpha"]))
            except Exception:
                ab_alpha = 0.82
            try:
                panel_alpha = float(self.get_setting("panel_alpha", DEFAULT_SETTINGS["panel_alpha"]))
            except Exception:
                panel_alpha = 0.80
            try:
                blur_v = float(self.get_setting("action_bar_intensity", DEFAULT_SETTINGS["action_bar_intensity"]))
            except Exception:
                blur_v = 0.42

            accent = int(Theme.getColor(Theme.key_windowBackgroundWhiteBlueText))
            wallpaper_key = getattr(Theme, "key_chat_wallpaper", Theme.key_windowBackgroundGray)
            wallpaper = int(Theme.getColor(wallpaper_key))

            mock = LinearLayout(context)
            mock.setOrientation(LinearLayout.VERTICAL)
            mock.setPadding(AndroidUtilities.dp(10), AndroidUtilities.dp(10), AndroidUtilities.dp(10), AndroidUtilities.dp(10))
            mock_bg = GradientDrawable(
                GradientDrawable.Orientation.TOP_BOTTOM,
                [wallpaper, int(Theme.getColor(Theme.key_windowBackgroundWhite))],
            )
            mock_bg.setCornerRadius(float(AndroidUtilities.dp(14)))
            mock.setBackground(mock_bg)

            bar_top = View(context)
            top_draw = GradientDrawable()
            top_draw.setShape(GradientDrawable.RECTANGLE)
            top_draw.setCornerRadius(float(AndroidUtilities.dp(12)))
            a1 = max(0, min(255, int(round(ab_alpha * 255.0))))
            top_draw.setColor((a1 << 24) | (accent & 0x00FFFFFF))
            bar_top.setBackground(top_draw)
            mock.addView(bar_top, LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, AndroidUtilities.dp(22)))

            msg_row = LinearLayout(context)
            msg_row.setOrientation(LinearLayout.HORIZONTAL)
            msg_row.setGravity(Gravity.END)
            msg_params = LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT)
            msg_params.topMargin = AndroidUtilities.dp(10)
            mock.addView(msg_row, msg_params)
            bubble = View(context)
            bubble_draw = GradientDrawable()
            bubble_draw.setCornerRadius(float(AndroidUtilities.dp(14)))
            bubble_draw.setColor(int(Theme.getColor(Theme.key_chat_outBubble)))
            bubble.setBackground(bubble_draw)
            msg_row.addView(bubble, LinearLayout.LayoutParams(AndroidUtilities.dp(96), AndroidUtilities.dp(28)))

            bar_panel = View(context)
            panel_draw = GradientDrawable()
            panel_draw.setShape(GradientDrawable.RECTANGLE)
            panel_draw.setCornerRadius(float(AndroidUtilities.dp(12)))
            a2 = max(0, min(255, int(round(panel_alpha * 255.0))))
            panel_draw.setColor((a2 << 24) | (accent & 0x00FFFFFF))
            bar_panel.setBackground(panel_draw)
            panel_params = LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, AndroidUtilities.dp(16))
            panel_params.topMargin = AndroidUtilities.dp(10)
            mock.addView(bar_panel, panel_params)

            mock_params = LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT)
            mock_params.topMargin = AndroidUtilities.dp(10)
            outer.addView(mock, mock_params)

            metrics = TextView(context)
            alpha_s = self._format_numeric_setting("action_bar_alpha", ab_alpha)
            blur_s = self._format_numeric_setting("action_bar_intensity", blur_v)
            metrics.setText(
                self._tr(
                    "preview_metrics_fmt",
                    alpha=alpha_s,
                    blur=blur_s,
                    mode=self._settings_effect_mode_label(),
                )
            )
            metrics.setTextSize(TypedValue.COMPLEX_UNIT_SP, 12.0)
            metrics.setTextColor(int(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText)))
            _lg_wrap_textview(metrics, 3)
            metrics_params = LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT)
            metrics_params.topMargin = AndroidUtilities.dp(8)
            outer.addView(metrics, metrics_params)

            actions = LinearLayout(context)
            actions.setOrientation(LinearLayout.HORIZONTAL)
            actions.setGravity(Gravity.CENTER)
            actions_params = LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT)
            actions_params.topMargin = AndroidUtilities.dp(10)
            outer.addView(actions, actions_params)

            def _pill(text, accent=False, on_click=None):
                tv = TextView(context)
                tv.setText(str(text))
                tv.setTextSize(TypedValue.COMPLEX_UNIT_SP, 13.0)
                _lg_wrap_textview(tv, 2)
                color_key = Theme.key_featuredStickers_buttonText if accent else Theme.key_windowBackgroundWhiteBlueText
                bg_key = Theme.key_featuredStickers_addButton if accent else Theme.key_chat_inBubble
                tv.setTextColor(int(Theme.getColor(color_key if accent else Theme.key_windowBackgroundWhiteBlueText)))
                tv.setGravity(Gravity.CENTER)
                tv.setPadding(AndroidUtilities.dp(12), AndroidUtilities.dp(8), AndroidUtilities.dp(12), AndroidUtilities.dp(8))
                pill_bg = GradientDrawable()
                pill_bg.setCornerRadius(float(AndroidUtilities.dp(14)))
                if accent:
                    pill_bg.setColor(int(Theme.getColor(bg_key)))
                    tv.setTextColor(int(Theme.getColor(color_key)))
                else:
                    pill_bg.setColor(int(Theme.getColor(Theme.key_chat_inBubble)))
                tv.setBackground(pill_bg)
                if on_click is not None:
                    tv.setClickable(True)

                    class _Click(_dp(View.OnClickListener)):
                        def onClick(self_obj, v):
                            try:
                                on_click(v)
                            except Exception as exc:
                                plugin._debug_log_exc("preview pill", exc)

                    tv.setOnClickListener(_Click())
                lp = LinearLayout.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT)
                if actions.getChildCount() > 0:
                    lp.leftMargin = AndroidUtilities.dp(6)
                actions.addView(tv, lp)
                return tv

            def _strong_label():
                state = self._tr("preview_on") if bool(self.get_setting("strong_glass", False)) else self._tr("preview_off")
                return self._tr("preview_strong_fmt", state=state)

            sg_ref = [None]

            def _on_sg_toggle(_v):
                plugin._toggle_strong_glass_quick(_v)
                if sg_ref[0] is not None:
                    sg_ref[0].setText(_strong_label())

            sg_ref[0] = _pill(_strong_label(), accent=False, on_click=_on_sg_toggle)
            return Custom(view=outer)
        except Exception as exc:
            self._debug_log_exc("preview row", exc)
            return None

    def _safe_settings_row(self, factory, *args):
        try:
            return factory(*args)
        except Exception as exc:
            self._debug_log_exc(getattr(factory, "__name__", "settings_row"), exc)
            return None

    def _appearance_subtext_short(self):
        try:
            a = self._format_numeric_setting(
                "action_bar_alpha",
                self.get_setting("action_bar_alpha", DEFAULT_SETTINGS["action_bar_alpha"]),
            )
            p = self._format_numeric_setting(
                "panel_alpha",
                self.get_setting("panel_alpha", DEFAULT_SETTINGS["panel_alpha"]),
            )
            return self._tr("appearance_sub_fmt", a=a, p=p)
        except Exception:
            return self._tr("appearance")

    def _tuning_subtext_short(self):
        try:
            blur = self._format_numeric_setting(
                "action_bar_intensity",
                self.get_setting("action_bar_intensity", DEFAULT_SETTINGS["action_bar_intensity"]),
            )
            thick = self._format_numeric_setting(
                "action_bar_thickness",
                self.get_setting("action_bar_thickness", DEFAULT_SETTINGS["action_bar_thickness"]),
            )
            radius = self._format_numeric_setting(
                "panel_radius",
                self.get_setting("panel_radius", DEFAULT_SETTINGS["panel_radius"]),
            )
            return self._tr("tuning_sub_fmt", blur=blur, thick=thick, radius=radius)
        except Exception:
            return self._tr("tuning")

    def _arm_dialogs_boot_poll(self):
        if not self._loaded:
            return
        if not self._dialogs_boot_poll_needed():
            return
        self._boot_glass_gen = int(getattr(self, "_boot_glass_gen", 0)) + 1
        gen = int(self._boot_glass_gen)
        self._dialogs_boot_tries = 0
        max_tries = int(self._boot_poll_max_tries())
        interval_ms = int(self._boot_poll_interval_ms())

        def _tick(g=gen, p=self, mt=max_tries, iv=interval_ms):
            if not p._loaded or int(getattr(p, "_boot_glass_gen", 0)) != g:
                return
            if not p._dialogs_boot_poll_needed():
                return
            p._dialogs_boot_tries = int(getattr(p, "_dialogs_boot_tries", 0)) + 1
            try:
                p._bootstrap_visible_glass()
            except Exception as exc:
                p._debug_log_exc("dialogs boot poll", exc)
            dialogs = p._find_bootstrap_dialogs()
            ready = bool(dialogs is not None and p._dialogs_glass_ready(dialogs))
            if ready:
                try:
                    p.log("[LiquidGlass] dialogs boot ready try=%d" % int(p._dialogs_boot_tries))
                except Exception:
                    pass
                return
            if int(p._dialogs_boot_tries) >= mt:
                try:
                    last = None
                    try:
                        last = _fragment_class_name(get_last_fragment())
                    except Exception:
                        last = None
                    p.log(
                        "[LiquidGlass] dialogs boot give up try=%d last=%s found=%s"
                        % (int(p._dialogs_boot_tries), last, dialogs is not None)
                    )
                except Exception:
                    pass
                return
            run_on_ui_thread(_tick, iv)

        run_on_ui_thread(_tick, 40)

    def _add_bootstrap_fragment(self, out, seen, fr):
        if fr is None:
            return
        try:
            key = id(fr)
        except Exception:
            return
        if key in seen:
            return
        seen.add(key)
        out.append(fr)

    def _iter_bootstrap_fragments(self):
        out = []
        seen = set()
        seeds = []

        def _seed(fr):
            if fr is None:
                return
            seeds.append(fr)
            self._add_bootstrap_fragment(out, seen, fr)

        try:
            _seed(get_last_fragment())
        except Exception:
            pass

        try:
            LA = safe_find_class("org.telegram.ui.LaunchActivity")
        except Exception:
            LA = None
        if LA is not None:
            for name in (
                "getSafeLastFragment",
                "getLastFragmentIncludeMainTabs",
                "getLastFragment",
            ):
                try:
                    fn = getattr(LA, name, None)
                    if callable(fn):
                        _seed(fn())
                except Exception:
                    pass
            try:
                vis = LA.getVisibleFragments()
                if vis is not None:
                    for fr in list(vis):
                        _seed(fr)
            except Exception:
                pass
            # Class-identity findFragment is unreliable via Chaquopy — still try.
            try:
                Cls = safe_find_class(CLASS_DIALOGS_ACTIVITY)
                find = getattr(LA, "findFragment", None)
                if callable(find) and Cls is not None:
                    _seed(find(Cls))
            except Exception:
                pass

        for fr in list(seeds):
            try:
                layout = None
                try:
                    layout = fr.getParentLayout()
                except Exception:
                    layout = self._get_attr(fr, "parentLayout")
                if layout is None:
                    continue
                try:
                    stack = layout.getFragmentStack()
                    if stack is not None:
                        for item in list(stack):
                            self._add_bootstrap_fragment(out, seen, item)
                except Exception:
                    pass
                for name in ("getBackgroundFragment", "getLastFragment", "getSafeLastFragment"):
                    try:
                        fn = getattr(layout, name, None)
                        if callable(fn):
                            self._add_bootstrap_fragment(out, seen, fn())
                    except Exception:
                        pass
                try:
                    find = getattr(layout, "findFragment", None)
                    Cls = safe_find_class(CLASS_DIALOGS_ACTIVITY)
                    if callable(find) and Cls is not None:
                        self._add_bootstrap_fragment(out, seen, find(Cls))
                except Exception:
                    pass
                try:
                    act = None
                    try:
                        act = fr.getParentActivity()
                    except Exception:
                        act = self._get_attr(fr, "parentActivity")
                    if act is not None:
                        for field in (
                            "actionBarLayout",
                            "mainFragmentsStack",
                            "layersActionBarLayout",
                            "rightActionBarLayout",
                        ):
                            try:
                                obj = self._get_attr(act, field)
                            except Exception:
                                obj = None
                            if obj is None:
                                continue
                            try:
                                if hasattr(obj, "__iter__") and not hasattr(obj, "getFragmentStack"):
                                    for item in list(obj):
                                        self._add_bootstrap_fragment(out, seen, item)
                                    continue
                            except Exception:
                                pass
                            try:
                                stack = obj.getFragmentStack()
                                if stack is not None:
                                    for item in list(stack):
                                        self._add_bootstrap_fragment(out, seen, item)
                            except Exception:
                                pass
                            try:
                                find = getattr(obj, "findFragment", None)
                                Cls = safe_find_class(CLASS_DIALOGS_ACTIVITY)
                                if callable(find) and Cls is not None:
                                    self._add_bootstrap_fragment(out, seen, find(Cls))
                            except Exception:
                                pass
                except Exception:
                    pass
            except Exception:
                pass
        return out

    def _find_bootstrap_dialogs(self):
        for fr in self._iter_bootstrap_fragments():
            if _fragment_class_name(fr) == CLASS_DIALOGS_ACTIVITY and self._is_fragment_active(fr):
                return fr
        return None

    def _bootstrap_visible_glass(self):
        if not self._loaded or not self.get_setting("enabled", True):
            return
        if not self._is_supported():
            return
        applied = 0
        dialogs = self._find_bootstrap_dialogs()
        if dialogs is not None:
            if self._bool_setting("apply_dialogs_list") or self._bool_setting("apply_action_bar"):
                if not self._dialogs_glass_ready(dialogs):
                    self._request_dialogs_glass(dialogs, force=True)
                    applied += 1
        try:
            last = get_last_fragment()
        except Exception:
            last = None
        if last is not None and last is not dialogs and self._is_fragment_active(last):
            cname = _fragment_class_name(last)
            try:
                if cname == CLASS_CHAT_ACTIVITY:
                    self.apply_to_chat(last, 0, urgent=True)
                    applied += 1
                elif cname in (CLASS_SETTINGS_ACTIVITY, CLASS_TOPICS_FRAGMENT):
                    self.apply_to_extra_fragment(last, 0, urgent=True)
                    applied += 1
            except Exception as exc:
                self._debug_log_exc("bootstrap visible", exc)
        if applied:
            try:
                self.log("[LiquidGlass] bootstrap fragments=%d" % applied)
            except Exception:
                pass
        elif int(getattr(self, "_dialogs_boot_tries", 0)) in (1, 4, 8):
            try:
                self.log(
                    "[LiquidGlass] bootstrap miss try=%d last=%s dialogs=%s"
                    % (
                        int(self._dialogs_boot_tries),
                        _fragment_class_name(last) if last is not None else None,
                        dialogs is not None,
                    )
                )
            except Exception:
                pass

    def on_plugin_unload(self):
        global _ACTIVE_LG_PLUGIN
        self._loaded = False
        _ACTIVE_LG_PLUGIN = None
        self._unregister_menu_items()
        for ref in self._hooks:
            try:
                self.unhook_method(ref)
            except Exception:
                pass
        self._hooks.clear()
        try:
            self._dialogs_req_gen.clear()
            self._dialogs_req_last_ms.clear()
        except Exception:
            self._dialogs_req_gen = {}
            self._dialogs_req_last_ms = {}
        self._startup_grace_until_ms = 0.0
        self._extra_apply_gen.clear()
        self._apply_pending.clear()
        self._apply_requested.clear()
        self._factory_cooldown_chat.clear()
        self._factory_cooldown_extra.clear()
        self._chat_followup_gen.clear()
        self._supported_cache = None
        try:
            self._warned_keys.clear()
        except Exception:
            self._warned_keys = set()
        self._action_bar_color_shield_last.clear()
        self._action_bar_store_index.clear()
        self._drawable_cache.clear()
        _class_cache.clear()
        run_on_ui_thread(lambda: self._restore_all(reapply_after=False))

    def _register_hook(self, ref):
        if ref and ref not in self._hooks:
            self._hooks.append(ref)

    def _log_hook_status(self, block_name, added):
        try:
            self.log("[LiquidGlass] hooks %s: %d" % (block_name, int(added)))
        except Exception:
            pass
        if int(added or 0) <= 0:
            try:
                self.log("[LiquidGlass] WARN: no hooks for %s — reflection miss?" % block_name)
            except Exception:
                pass

    def _debug_enabled(self):
        try:
            return bool(self.get_setting("debug_logs", False))
        except Exception:
            return False

    def _debug_log(self, text):
        if not self._debug_enabled():
            return
        try:
            self.log("[LiquidGlass][debug] %s" % str(text))
        except Exception:
            pass

    def _debug_log_exc(self, text, exc):
        if not self._debug_enabled():
            return
        try:
            self.log("[LiquidGlass][debug] %s: %s" % (str(text), str(exc)))
        except Exception:
            pass

    def _unwrap_java_class(self, cls):
        """Resolve reflective Class candidates from find_class() result."""
        if not cls:
            return []
        out = []
        seen = set()

        def _add(obj):
            if obj is None:
                return
            try:
                key = id(obj)
            except Exception:
                key = None
            if key is not None and key in seen:
                return
            if key is not None:
                seen.add(key)
            out.append(obj)

        _add(cls)
        try:
            _add(cls.getClass())
        except Exception:
            pass
        # Some runtimes expose the mirrored Class via .class_ / jclass helpers.
        for attr in ("class_", "jclass", "Class"):
            try:
                _add(getattr(cls, attr, None))
            except Exception:
                pass
        return out

    def _class_declared_method(self, cls, name, *arg_types):
        if not cls or not name:
            return None
        for target in self._unwrap_java_class(cls):
            for getter_name in ("getDeclaredMethod", "getMethod"):
                try:
                    getter = getattr(target, getter_name, None)
                    if not callable(getter):
                        continue
                    if arg_types:
                        m = getter(name, *arg_types)
                    else:
                        m = getter(name)
                    if m is not None:
                        return m
                except Exception:
                    continue
        return None

    def _class_declared_methods(self, cls):
        if not cls:
            return []
        out = []
        seen = set()
        for target in self._unwrap_java_class(cls):
            for getter_name in ("getDeclaredMethods", "getMethods"):
                try:
                    getter = getattr(target, getter_name, None)
                    if not callable(getter):
                        continue
                    methods = getter()
                    if methods is None:
                        continue
                    try:
                        iterable = list(methods)
                    except Exception:
                        try:
                            iterable = [methods[i] for i in range(len(methods))]
                        except Exception:
                            iterable = methods
                    for m in iterable:
                        try:
                            sig = str(m.toString())
                        except Exception:
                            sig = str(id(m))
                        if sig in seen:
                            continue
                        seen.add(sig)
                        out.append(m)
                except Exception:
                    continue
        return out

    def _hook_methods_by_name(self, cls, method_name, hook_obj):
        """Hook all overloads by name; prefer SDK hook_all_methods when present."""
        added = 0
        if not cls or not method_name or hook_obj is None:
            return added
        try:
            hook_all = getattr(self, "hook_all_methods", None)
            if callable(hook_all):
                refs = hook_all(cls, method_name, hook_obj)
                if refs:
                    for ref in refs:
                        self._register_hook(ref)
                        added += 1
                    if added:
                        return added
        except Exception as e:
            self._debug_log("hook_all_methods %s failed: %s" % (method_name, e))
        try:
            seen = set()
            for m in self._class_declared_methods(cls):
                try:
                    if str(m.getName()) != method_name:
                        continue
                    sig = str(m.toString())
                    if sig in seen:
                        continue
                    seen.add(sig)
                    m.setAccessible(True)
                    self._register_hook(self.hook_method(m, hook_obj))
                    added += 1
                except Exception as e:
                    self._debug_log("hook %s overload failed: %s" % (method_name, e))
        except Exception as e:
            self._debug_log("hook_methods_by_name %s failed: %s" % (method_name, e))
        return added

    def _bump_diag(self, key, inc=1):
        try:
            self._diag[key] = int(self._diag.get(key, 0)) + int(inc)
        except Exception:
            pass

    def _dialog_activity(self):
        try:
            fragment = get_last_fragment()
            if fragment is None:
                return None
            return fragment.getParentActivity()
        except Exception:
            return None

    def _show_confirm_dialog(self, title, message, on_confirm, positive="OK", negative="Отмена", on_cancel=None):
        activity = self._dialog_activity()
        if activity is None:
            try:
                if on_confirm:
                    on_confirm()
            except Exception:
                pass
            return

        def _ok(bld, which):
            self._bump_diag("dialog_shown")
            try:
                if on_confirm:
                    on_confirm()
            except Exception as exc:
                self._debug_log_exc("confirm_dialog_ok", exc)
            try:
                bld.dismiss()
            except Exception:
                pass

        def _cancel(bld, which):
            try:
                if on_cancel:
                    on_cancel()
            except Exception as exc:
                self._debug_log_exc("confirm_dialog_cancel", exc)
            try:
                bld.dismiss()
            except Exception:
                pass

        try:
            builder = AlertDialogBuilder(activity)
            builder.set_title(str(title))
            builder.set_message(str(message))
            builder.set_positive_button(str(positive), _ok)
            builder.set_negative_button(str(negative), _cancel)
            builder.set_cancelable(True)
            builder.show()
        except Exception as exc:
            self._debug_log_exc("confirm_dialog", exc)
            try:
                if on_confirm:
                    on_confirm()
            except Exception:
                pass

    def _count_enabled_areas(self):
        keys = (
            "apply_action_bar",
            "apply_top_panels",
            "apply_search_bar",
            "apply_story_bar",
            "apply_dialogs_list",
            "apply_topics_header",
        )
        n = 0
        for k in keys:
            try:
                if bool(self.get_setting(k, DEFAULT_SETTINGS[k])):
                    n += 1
            except Exception:
                pass
        return n

    def _settings_effect_mode_label(self):
        try:
            if not self.get_setting("enabled", True):
                return self._tr("mode_off")
            if not self._is_supported():
                return self._tr("mode_unavailable")
            return self._tr("mode_liquid")
        except Exception:
            return "—"

    def _settings_status_line(self):
        mode = self._settings_effect_mode_label()
        n = self._count_enabled_areas()
        perf = self._tr("status_perf") if self.get_setting("performance_mode", False) else ""
        return "%s · %d%s" % (mode, n, perf)

    def _health_check_line_short(self):
        if not self._is_supported():
            return self._tr("mode_unavailable")
        fails = int(self._diag.get("drawable_create_fail", 0))
        if fails:
            return self._tr("health_errors_fmt", n=fails)
        return self._tr("health_ok")

    def _health_check_line(self):
        parts = []
        if self._is_supported():
            parts.append("OK")
        else:
            parts.append("Нет")
        miss = int(self._diag.get("factory_miss_chat", 0)) + int(self._diag.get("factory_miss_extra", 0))
        if miss:
            parts.append("miss %d" % miss)
        fails = int(self._diag.get("drawable_create_fail", 0))
        if fails:
            parts.append("fail %d" % fails)
        parts.append("hooks %d" % int(len(self._hooks)))
        parts.append("cache %d" % int(len(self._drawable_cache)))
        return " · ".join(parts)

    def _effective_drawable_cache_max(self):
        if bool(self.get_setting("performance_mode", False)):
            return 40
        return self._DRAWABLE_CACHE_MAX

    def _settings_reapply_delay_ms(self):
        if bool(self.get_setting("performance_mode", False)):
            return 140
        return 90

    def _settings_home_line(self):
        try:
            mode = self._settings_effect_mode_label()
            n = self._count_enabled_areas()
            return self._tr(
                "settings_home_line_fmt",
                ver=__version__,
                mode=mode,
                zones=n,
                total=len(_AREA_LABELS),
            )
        except Exception:
            return "Liquid Glass %s" % __version__

    def _zones_subtext_short(self):
        n = self._count_enabled_areas()
        total = len(_AREA_LABELS)
        if n <= 0:
            return self._tr("zones_none")
        if n >= total:
            return self._tr("zones_all")
        return self._tr("zones_count_fmt", n=n, total=total)

    def _settings_status_widgets(self):
        rows = []
        rows.extend(self._requirements_hint_widgets())
        if rows:
            rows.append(Divider())
        return rows

    def _set_zone_flags(self, mapping, reload_settings=False):
        self._persist_settings_bulk(mapping, reload_settings=reload_settings)
        self._schedule_settings_reapply(self._settings_reapply_delay_ms())

    def _zones_enable_all(self, _view=None):
        self._set_zone_flags({k: True for k in _AREA_LABELS})

    def _zones_enable_chat_only(self, _view=None):
        self._set_zone_flags({
            "apply_action_bar": True,
            "apply_top_panels": True,
            "apply_search_bar": True,
            "apply_story_bar": True,
            "apply_dialogs_list": False,
            "apply_topics_header": False,
        })

    def _zones_disable_all(self, _view=None):
        self._set_zone_flags({k: False for k in _AREA_LABELS})

    def _areas_summary_line(self):
        active = []
        for key in _AREA_LABELS:
            try:
                if bool(self.get_setting(key, DEFAULT_SETTINGS[key])):
                    active.append(self._area_label(key))
            except Exception:
                pass
        if not active:
            return self._tr("zones_none")
        if len(active) == len(_AREA_LABELS):
            return self._tr("zones_all")
        if len(active) <= 3:
            return ", ".join(active)
        return self._tr("zones_count_fmt", n=len(active), total=len(_AREA_LABELS))

    def _verify_client_requirements(self):
        if self._load_requirements_hint_shown:
            return
        self._load_requirements_hint_shown = True
        missing = []
        if not safe_find_class("org.telegram.ui.ActionBar.ActionBar"):
            missing.append("ActionBar")
        if not safe_find_class("org.telegram.ui.ChatActivity"):
            missing.append("ChatActivity")
        if not safe_find_class("org.telegram.ui.Components.blur3.BlurredBackgroundDrawableViewFactory"):
            missing.append("blur3")
        if missing:
            try:
                BulletinHelper.show_info(
                    "Нужен exteraGram %s (не найдено: %s)" % (__app_version__, ", ".join(missing))
                )
            except Exception:
                pass

    def _ensure_native_glass_setup(self, fragment):
        if not fragment:
            return
        setup = getattr(fragment, "setupGlass", None)
        if not callable(setup):
            return
        try:
            setup()
        except Exception:
            pass

    def _search_provider_kind(self, store_key):
        if store_key == "search_results":
            return "search_list"
        if store_key == "search_bar":
            return "search_tags"
        return "chat"

    def _signature_theme_fingerprint(self, sig):
        try:
            if sig and len(sig) >= 2:
                return sig[1]
        except Exception:
            pass
        return None

    def _is_real_theme_burst(self, prev_sig, current_sig):
        if prev_sig is None or current_sig is None or prev_sig == current_sig:
            return False
        prev_theme = self._signature_theme_fingerprint(prev_sig)
        curr_theme = self._signature_theme_fingerprint(current_sig)
        if prev_theme is None or curr_theme is None:
            return False
        return prev_theme != curr_theme

    def _store_needs_sig_recovery(self, store):
        if not store or store.get("_lg_apply_sig") is not None:
            return False
        for key in (
            "action_bar", "top_panel", "top_panel_layout", "top_panel2",
            "search_bar", "search_container", "search_results", "story_bar",
        ):
            if key in store:
                return True
        return False

    def _maybe_theme_burst_hint(self):
        if self._theme_burst_hint_shown:
            return
        self._theme_burst_hint_shown = True
        try:
            BulletinHelper.show_info("Тема сменилась — эффект обновится через мгновение")
        except Exception:
            pass

    def _drawable_cache_get(self, cache_key):
        d = self._drawable_cache
        if cache_key not in d:
            return None
        drawable = d.pop(cache_key)
        d[cache_key] = drawable
        return drawable

    def _drawable_cache_put(self, cache_key, drawable):
        d = self._drawable_cache
        if cache_key in d:
            d.pop(cache_key)
        d[cache_key] = drawable
        while len(d) > self._effective_drawable_cache_max():
            d.popitem(last=False)

    def _collect_drawable_cache_view_ids(self, store):
        ids = set()
        if not store:
            return ids
        for key in (
            "action_bar",
            "action_bar_blurred",
            "action_bar_cast_shadows",
            "top_panel_layout",
            "top_panel",
            "top_panel2",
            "search_bar",
            "search_container",
            "search_results",
            "story_bar",
        ):
            entry = store.get(key)
            view = entry.get("view") if entry else None
            if view is not None:
                try:
                    ids.add(id(view))
                except Exception:
                    pass
        clip = store.get("background_clip")
        if clip and clip.get("view"):
            try:
                ids.add(id(clip["view"]))
            except Exception:
                pass
        return ids

    def _evict_drawable_cache_for_view_ids(self, view_ids):
        if not view_ids or not self._drawable_cache:
            return
        drop = [k for k in self._drawable_cache if k and len(k) > 1 and k[1] in view_ids]
        for k in drop:
            self._drawable_cache.pop(k, None)

    def _prune_runtime_state(self):
        if (
            len(self._applied) < self._STATE_STORE_MAX
            and len(self._extras_applied) < self._STATE_STORE_MAX
            and len(self._last_apply_time) < (self._STATE_STORE_MAX * 2)
            and len(self._factory_cooldown_chat) < (self._STATE_STORE_MAX * 2)
            and len(self._factory_cooldown_extra) < (self._STATE_STORE_MAX * 2)
            and len(self._action_bar_color_shield_last) < (self._STATE_STORE_MAX * 2)
        ):
            return
        keep_chat_ids = set()
        keep_extra_ids = set()
        keep_action_bar_ids = set()
        try:
            keep_chat_ids.update(id(x) for x in list(self._active_chats))
        except Exception:
            pass
        try:
            keep_extra_ids.update(id(x) for x in list(self._active_extras))
        except Exception:
            pass
        for store in list(self._applied.values()) + list(self._extras_applied.values()):
            entry = store.get("action_bar")
            view = entry.get("view") if entry else None
            if view is not None:
                try:
                    keep_action_bar_ids.add(id(view))
                except Exception:
                    pass
        self._applied = {k: v for k, v in self._applied.items() if k in keep_chat_ids}
        self._extras_applied = {k: v for k, v in self._extras_applied.items() if k in keep_extra_ids}
        self._last_apply_time = {k: v for k, v in self._last_apply_time.items() if k in keep_chat_ids}
        self._factory_cooldown_chat = {k: v for k, v in self._factory_cooldown_chat.items() if k in keep_chat_ids}
        self._factory_cooldown_extra = {k: v for k, v in self._factory_cooldown_extra.items() if k in keep_extra_ids}
        self._action_bar_color_shield_last = {
            k: v for k, v in self._action_bar_color_shield_last.items() if k in keep_action_bar_ids
        }
        self._rebuild_action_bar_store_index()
        keep_view_ids = set()
        keep_view_ids.update(keep_action_bar_ids)
        for store in list(self._applied.values()) + list(self._extras_applied.values()):
            keep_view_ids.update(self._collect_drawable_cache_view_ids(store))
        if self._drawable_cache:
            drop = [k for k in self._drawable_cache if not k or len(k) < 2 or k[1] not in keep_view_ids]
            for k in drop:
                self._drawable_cache.pop(k, None)
        self._bump_diag("state_prunes")

    def _profile_setting_keys(self):
        return list(DEFAULT_SETTINGS.keys())

    def _menu_action_debounce_ok(self, key, min_interval_ms=500):
        try:
            now = int(time.time() * 1000)
            k = str(key or "").strip()
            if not k:
                return True
            prev = int(self._menu_action_debounce_ts.get(k, 0) or 0)
            if prev and (now - prev) < int(min_interval_ms):
                return False
            self._menu_action_debounce_ts[k] = now
            if len(self._menu_action_debounce_ts) > 32:
                cutoff = now - 30000
                self._menu_action_debounce_ts = {
                    kk: vv for kk, vv in self._menu_action_debounce_ts.items() if int(vv or 0) >= cutoff
                }
            return True
        except Exception:
            return True

    def _open_tg(self, username):
        u = str(username or "").strip().lstrip("@")
        if not u or not u.replace("_", "").isalnum():
            return
        try:
            AppLoader = safe_find_class("org.telegram.messenger.ApplicationLoader")
            if AppLoader is None:
                AppLoader = safe_find_class("com.exteragram.messenger.ApplicationLoader")
            Intent_cls = safe_find_class("android.content.Intent")
            Uri_cls = safe_find_class("android.net.Uri")
            if AppLoader is None or Intent_cls is None or Uri_cls is None:
                return
            ctx = AppLoader.applicationContext
            if ctx is None:
                return
            it = Intent_cls(Intent_cls.ACTION_VIEW, Uri_cls.parse("tg://resolve?domain=%s" % u))
            it.addFlags(Intent_cls.FLAG_ACTIVITY_NEW_TASK)
            ctx.startActivity(it)
        except Exception:
            pass

    def _open_plugin_settings(self):
        try:
            from com.exteragram.messenger.plugins import PluginsController
            from com.exteragram.messenger.plugins.ui import PluginSettingsActivity

            fragment = get_last_fragment()
            if fragment is None:
                raise RuntimeError("fragment missing")

            controller = PluginsController.getInstance()
            plugin = controller.plugins.get(__id__)
            if plugin is None:
                raise RuntimeError("plugin missing")

            fragment.presentFragment(PluginSettingsActivity(plugin))
            return
        except Exception:
            pass
        try:
            from com.exteragram.messenger.plugins import PluginsController

            fragment = get_last_fragment()
            controller = PluginsController.getInstance()
            if fragment is not None:
                engine = controller.getPluginsEngine()
                if engine is not None:
                    try:
                        engine.openPluginSettings(__id__, fragment)
                        return
                    except TypeError:
                        engine.openPluginSetting(__id__, fragment)
                        return
            try:
                controller.openPluginSettings(__id__)
                return
            except TypeError:
                controller.openPluginSettings(__id__, "")
                return
        except Exception as exc:
            self._debug_log_exc("open_plugin_settings", exc)
            try:
                BulletinHelper.show_error("Не удалось открыть настройки")
            except Exception:
                pass

    def _register_menu_items(self):
        self._unregister_menu_items()
        try:
            self._menu_chat_settings_id = self.add_menu_item(
                MenuItemData(
                    menu_type=MenuItemType.CHAT_ACTION_MENU,
                    text=self._tr("menu_settings"),
                    subtext=self._tr("menu_sub_fmt", ver=__version__),
                    icon="msg_settings",
                    on_click=self._menu_open_settings,
                    priority=14,
                )
            )
            self._menu_chat_reapply_id = self.add_menu_item(
                MenuItemData(
                    menu_type=MenuItemType.CHAT_ACTION_MENU,
                    text=self._tr("reapply"),
                    subtext=self._tr("menu_sub_fmt", ver=__version__),
                    icon="msg_retry",
                    on_click=self._menu_reapply_glass,
                    priority=12,
                )
            )
        except Exception as exc:
            self._debug_log_exc("register_menu_items", exc)

    def _unregister_menu_items(self):
        for attr in ("_menu_chat_settings_id", "_menu_chat_reapply_id"):
            item_id = getattr(self, attr, None)
            if item_id:
                try:
                    self.remove_menu_item(item_id)
                except Exception:
                    pass
            setattr(self, attr, None)

    def _menu_reapply_glass(self, context):
        if not self._menu_action_debounce_ok("chat_reapply", 500):
            return
        run_on_ui_thread(self._force_reapply)

    def _menu_open_settings(self, context):
        if not self._menu_action_debounce_ok("chat_settings", 500):
            return
        run_on_ui_thread(self._open_plugin_settings)

    def _client_blur_restricted(self):
        try:
            from org.telegram.messenger import UserConfig, MessagesController
            account = int(UserConfig.selectedAccount)
            mc = MessagesController.getInstance(account)
            cfg = mc.config
            if Theme.isCurrentThemeDark() and bool(cfg.disableBlurInDarkTheme.get()):
                return "dark"
            if not Theme.isCurrentThemeDark() and bool(cfg.disableBlurInLightTheme.get()):
                return "light"
        except Exception:
            pass
        return None

    def _requirements_hint_widgets(self):
        rows = []
        try:
            blur_on = SharedConfig.chatBlurEnabled()
        except Exception:
            blur_on = True
        if not blur_on:
            rows.append(
                Text(
                    text=self._tr("blur_chat_hint"),
                    subtext=self._tr("blur_chat_hint_sub"),
                    icon="msg_warning",
                    red=True,
                )
            )
        restricted = self._client_blur_restricted()
        if restricted == "dark":
            rows.append(
                Text(
                    text=self._tr("blur_dark"),
                    subtext=self._tr("blur_restricted_sub"),
                    icon="msg_warning",
                )
            )
        elif restricted == "light":
            rows.append(
                Text(
                    text=self._tr("blur_light"),
                    subtext=self._tr("blur_restricted_sub"),
                    icon="msg_warning",
                )
            )
        sdk = int(getattr(Build.VERSION, "SDK_INT", 0))
        if bool(self.get_setting("strong_glass", False)) and sdk < 33:
            rows.append(
                Text(
                    text=self._tr("liquid_unavailable"),
                    subtext=self._tr("liquid_unavailable_sub"),
                    icon="msg_warning",
                    red=True,
                )
            )
        return rows

    def _get_application_context(self):
        for pkg in (
            "org.telegram.messenger.ApplicationLoader",
            "com.exteragram.messenger.ApplicationLoader",
        ):
            AL = safe_find_class(pkg)
            if not AL:
                continue
            try:
                ctx = AL.applicationContext
                if ctx is not None:
                    return ctx
            except Exception:
                pass
        return None

    def _clipboard_copy_text(self, text):
        ctx = self._get_application_context()
        if not ctx or not text:
            return False
        try:
            Context = safe_find_class("android.content.Context")
            ClipData = safe_find_class("android.content.ClipData")
            if not Context or not ClipData:
                return False
            cm = ctx.getSystemService(Context.CLIPBOARD_SERVICE)
            if not cm:
                return False
            clip = ClipData.newPlainText(__id__, str(text))
            cm.setPrimaryClip(clip)
            return True
        except Exception:
            return False

    def _notify_copied(self, message):
        try:
            BulletinHelper.show_copied_to_clipboard(message)
        except Exception:
            try:
                BulletinHelper.show_info(message)
            except Exception:
                pass

    def _clipboard_get_text(self):
        ctx = self._get_application_context()
        if not ctx:
            return None
        try:
            Context = safe_find_class("android.content.Context")
            if not Context:
                return None
            cm = ctx.getSystemService(Context.CLIPBOARD_SERVICE)
            if not cm:
                return None
            clip = cm.getPrimaryClip()
            if not clip or clip.getItemCount() < 1:
                return None
            t = clip.getItemAt(0).getText()
            if t is None:
                return None
            return str(t)
        except Exception:
            return None

    def _coerce_import_value(self, key, raw):
        if key not in DEFAULT_SETTINGS:
            return None
        default = DEFAULT_SETTINGS[key]
        if isinstance(default, bool):
            if isinstance(raw, bool):
                return raw
            if isinstance(raw, (int, float)):
                return raw != 0
            s = str(raw).strip().lower()
            return s in ("1", "true", "yes", "on", "да")
        if key in NUMERIC_SETTING_LIMITS:
            lo, hi = NUMERIC_SETTING_LIMITS[key]
            try:
                v = float(str(raw).replace(",", ".").strip())
            except Exception:
                return str(default)
            v = max(float(lo), min(float(hi), v))
            if float(v).is_integer():
                return str(int(v))
            return ("%.3f" % v).rstrip("0").rstrip(".")
        if key == "ui_lang":
            try:
                if isinstance(raw, str):
                    s = raw.strip().lower()
                    if s == "ru":
                        return 1
                    if s == "en":
                        return 2
                    if s in ("auto", ""):
                        return 0
                    return int(raw)
                return int(raw or 0)
            except Exception:
                return 0
        return str(raw)

    def _sanitize_import_settings(self, inner):
        if not isinstance(inner, dict):
            return inner
        cleaned = {}
        for k, v in inner.items():
            if k in ("settings_tab", "active_preset", "preset_selector", "welcome_shown_v4"):
                continue
            if k in _OBSOLETE_SETTING_KEYS:
                continue
            if k not in DEFAULT_SETTINGS:
                continue
            c = self._coerce_import_value(k, v)
            if c is not None:
                cleaned[k] = c
        return cleaned

    def _migrate_import_profile(self, obj):
        if not isinstance(obj, dict):
            return obj
        migrated = dict(obj)
        try:
            schema_version = int(migrated.get("schema_version", 1))
        except Exception:
            schema_version = 1
        if schema_version >= PROFILE_SCHEMA_VERSION:
            inner = migrated.get("settings")
            if isinstance(inner, dict):
                migrated["settings"] = self._sanitize_import_settings(dict(inner))
            return migrated
        inner = migrated.get("settings")
        if not isinstance(inner, dict):
            inner = {}
            for k in DEFAULT_SETTINGS:
                if k in migrated:
                    inner[k] = migrated[k]
        inner = self._sanitize_import_settings(dict(inner))
        merged_settings = {k: DEFAULT_SETTINGS[k] for k in DEFAULT_SETTINGS}
        if isinstance(inner, dict):
            for k, v in inner.items():
                if k in DEFAULT_SETTINGS and k not in _OBSOLETE_SETTING_KEYS:
                    c = self._coerce_import_value(k, v)
                    if c is not None:
                        merged_settings[k] = c
        return {
            "format": "liquid_glass",
            "schema_version": PROFILE_SCHEMA_VERSION,
            "version": migrated.get("version", __version__),
            "settings": merged_settings,
        }

    def _export_profile_json(self):
        payload = {
            "format": "liquid_glass",
            "schema_version": PROFILE_SCHEMA_VERSION,
            "version": __version__,
            "settings": {
                k: self._coerce_import_value(k, self.get_setting(k, DEFAULT_SETTINGS[k]))
                for k in self._profile_setting_keys()
            },
        }
        try:
            text = json.dumps(payload, ensure_ascii=False, indent=2)
        except Exception:
            try:
                BulletinHelper.show_info("Ошибка экспорта")
            except Exception:
                pass
            return
        if self._clipboard_copy_text(text):
            self._notify_copied("Профиль скопирован в буфер")
        else:
            try:
                BulletinHelper.show_error("Не удалось записать буфер обмена")
            except Exception:
                pass

    def _parse_import_profile(self, raw):
        if not raw or not str(raw).strip():
            return {"error": "Буфер пуст"}
        try:
            obj = json.loads(str(raw).strip())
        except Exception:
            return {"error": "Неверный JSON в буфере"}
        obj = self._migrate_import_profile(obj)
        if not isinstance(obj, dict):
            return {"error": "Ожидался объект JSON"}
        fmt = obj.get("format")
        if fmt is not None and fmt != "liquid_glass":
            return {"error": "Это не профиль Liquid Glass"}
        schema_version = obj.get("schema_version", 1)
        try:
            schema_version = int(schema_version)
        except Exception:
            schema_version = 1
        if schema_version > PROFILE_SCHEMA_VERSION:
            return {"error": "Профиль из более новой версии плагина"}
        inner = obj.get("settings", obj)
        if not isinstance(inner, dict):
            return {"error": "Нет блока settings"}
        current = {k: self.get_setting(k, DEFAULT_SETTINGS[k]) for k in DEFAULT_SETTINGS}
        merged = dict(current)
        changes = []
        n = 0
        for k, v in inner.items():
            if k not in DEFAULT_SETTINGS:
                continue
            c = self._coerce_import_value(k, v)
            if c is None:
                continue
            old = current.get(k)
            if old != c:
                changes.append((k, old, c))
            merged[k] = c
            n += 1
        if n == 0:
            return {"error": "Нет распознанных полей"}
        return {"merged": merged, "n": n, "changes": changes}

    def _import_profile_from_clipboard(self):
        parsed = self._parse_import_profile(self._clipboard_get_text())
        if parsed.get("error"):
            try:
                BulletinHelper.show_info(str(parsed["error"]))
            except Exception:
                pass
            return
        merged = parsed["merged"]
        n = int(parsed["n"])
        changes = parsed.get("changes") or []
        if not changes:
            try:
                BulletinHelper.show_info("Профиль совпадает с текущими настройками")
            except Exception:
                pass
            return
        lines = []
        for k, old, new in changes[:14]:
            lines.append("%s: %s → %s" % (k, old, new))
        if len(changes) > 14:
            lines.append("… и ещё %d" % (len(changes) - 14))
        message = "Будет обновлено полей: %d\n\n%s" % (len(changes), "\n".join(lines))

        def _apply():
            self._commit_import_profile(merged, n)

        def _cancel():
            self._bump_diag("import_cancelled")

        self._show_confirm_dialog(
            "Импорт профиля",
            message,
            _apply,
            positive="Применить",
            on_cancel=_cancel,
        )

    def _commit_import_profile(self, merged, n):
        self._bump_diag("import_confirmed")
        self._persist_settings_bulk(merged)
        for key in NUMERIC_SETTING_LIMITS:
            self._repair_stored_setting(key)
        self._clear_reapply_runtime_state()
        run_on_ui_thread(self._restore_all)
        try:
            BulletinHelper.show_info("Импорт: %d полей" % int(n))
        except Exception:
            pass

    def _export_debug_report(self):
        try:
            blur_on = bool(SharedConfig.chatBlurEnabled())
        except Exception:
            blur_on = True
        is_supported_now = bool(int(getattr(Build.VERSION, "SDK_INT", 0)) >= 29 and blur_on)
        try:
            settings = {k: self.get_setting(k, DEFAULT_SETTINGS[k]) for k in DEFAULT_SETTINGS}
        except Exception:
            settings = {}
        try:
            diag = dict(self._diag)
        except Exception:
            diag = {}
        try:
            report = {
                "format": "liquid_glass_debug_report",
                "schema_version": 1,
                "plugin_id": __id__,
                "plugin_name": __name__,
                "plugin_version": __version__,
                "app_version_req": __app_version__,
                "sdk_version_req": __sdk_version__,
                "app_min_version_legacy": __min_version__,
                "android_sdk": int(getattr(Build.VERSION, "SDK_INT", 0)),
                "is_supported_now": is_supported_now,
                "chat_blur_enabled": bool(blur_on),
                "runtime": {
                    "hooks_registered": int(len(self._hooks)),
                    "active_chats": int(len(list(self._active_chats))),
                    "active_extras": int(len(list(self._active_extras))),
                    "applied_chat_stores": int(len(self._applied)),
                    "applied_extra_stores": int(len(self._extras_applied)),
                    "apply_pending": int(len(self._apply_pending)),
                    "apply_requested": int(len(self._apply_requested)),
                    "factory_cooldown_chat": int(len(self._factory_cooldown_chat)),
                    "factory_cooldown_extra": int(len(self._factory_cooldown_extra)),
                    "drawable_cache_size": int(len(self._drawable_cache)),
                },
                "diagnostics": diag,
                "settings": settings,
            }
            text = json.dumps(report, ensure_ascii=False, indent=2)
        except Exception:
            try:
                BulletinHelper.show_error("Ошибка сборки debug-отчёта")
            except Exception:
                pass
            return

        if self._clipboard_copy_text(text):
            self._notify_copied("Debug-отчёт скопирован в буфер")
        else:
            try:
                BulletinHelper.show_error("Не удалось записать debug-отчёт в буфер")
            except Exception:
                pass

    def _export_debug_summary(self):
        try:
            blur_on = bool(SharedConfig.chatBlurEnabled())
        except Exception:
            blur_on = True
        sdk = int(getattr(Build.VERSION, "SDK_INT", 0))
        supported = bool(sdk >= 29 and blur_on)
        try:
            summary = (
                "Liquid Glass Debug Summary\n"
                "version: %s\n"
                "android_sdk: %d\n"
                "supported_now: %s\n"
                "chat_blur_enabled: %s\n"
                "hooks_registered: %d\n"
                "active_chats: %d\n"
                "active_extras: %d\n"
                "factory_miss_chat: %d\n"
                "factory_miss_extra: %d\n"
                "theme_burst_chat: %d\n"
                "theme_burst_extra: %d\n"
                "state_prunes: %d\n"
                "action_bar_shield_calls: %d\n"
                "action_bar_bg_restore_calls: %d\n"
                "drawable_create_fail: %d\n"
                "drawable_cache_hits: %d\n"
                "drawable_cache_size: %d"
            ) % (
                __version__,
                sdk,
                "yes" if supported else "no",
                "yes" if blur_on else "no",
                int(len(self._hooks)),
                int(len(list(self._active_chats))),
                int(len(list(self._active_extras))),
                int(self._diag.get("factory_miss_chat", 0)),
                int(self._diag.get("factory_miss_extra", 0)),
                int(self._diag.get("theme_burst_chat", 0)),
                int(self._diag.get("theme_burst_extra", 0)),
                int(self._diag.get("state_prunes", 0)),
                int(self._diag.get("action_bar_shield_calls", 0)),
                int(self._diag.get("action_bar_bg_restore_calls", 0)),
                int(self._diag.get("drawable_create_fail", 0)),
                int(self._diag.get("drawable_cache_hits", 0)),
                int(len(self._drawable_cache)),
            )
        except Exception:
            try:
                BulletinHelper.show_info("Ошибка сборки краткого отчёта")
            except Exception:
                pass
            return

        if self._clipboard_copy_text(summary):
            self._notify_copied("Краткий отчёт скопирован в буфер")
        else:
            try:
                BulletinHelper.show_error("Не удалось записать краткий отчёт в буфер")
            except Exception:
                pass

    def create_settings(self) -> List[Any]:
        try:
            rows = self._create_settings_impl()
            if rows:
                return rows
            raise RuntimeError("settings builder returned empty list")
        except Exception as exc:
            self._debug_log_exc("create_settings", exc)
            try:
                return self._create_settings_fallback()
            except Exception as exc2:
                self._debug_log_exc("create_settings_fallback", exc2)
                return [
                    Header(text="Liquid Glass %s" % __version__),
                    Switch(key="enabled", text="Стеклянный эффект", default=True, icon="msg_theme"),
                ]

    def _create_settings_fallback(self) -> List[Any]:
        return [
            Header(text="Liquid Glass %s" % __version__),
            Divider(text=self._tr("safe_mode")),
            Switch(
                key="enabled",
                text=self._tr("glass_effect"),
                default=True,
                icon=_setting_icon("enabled"),
            ),
            Text(
                text=self._tr("reapply"),
                icon="msg_retry",
                accent=True,
                on_click=lambda v: run_on_ui_thread(self._force_reapply),
            ),
        ]

    def _create_settings_impl(self) -> List[Any]:
        def on_change(_):
            self._schedule_settings_reapply(self._settings_reapply_delay_ms())

        enabled = bool(self.get_setting("enabled", True))
        perf = bool(self.get_setting("performance_mode", False))

        rows = []
        header = self._safe_settings_row(self._lg_header_row)
        if header is not None:
            rows.append(header)
        elif LiquidGlassHeaderFactory is not None:
            try:
                rows.append(Custom(factory=LiquidGlassHeaderFactory.instance.java))
            except Exception as exc:
                self._debug_log_exc("header factory", exc)
                rows.append(Divider(text=self._settings_home_line()))
        else:
            rows.append(Divider(text=self._settings_home_line()))
        preview = self._safe_settings_row(self._lg_preview_row)
        if preview is not None:
            rows.append(preview)
        rows.extend(self._conflict_hint_widgets())
        rows.extend(self._settings_status_widgets())
        rows.append(Header(text=self._tr("section_main")))
        rows.append(
            Switch(
                key="enabled",
                text=self._tr("glass_effect"),
                subtext=self._tr("glass_effect_sub"),
                icon=_setting_icon("enabled"),
                default=True,
                link_alias="enabled",
