def int_class():
    """Класс примитива int для рефлексии.

    jint из Chaquopy — аннотация типа, а не java.lang.Class, поэтому
    getDeclaredMethod с ним ничего не находит. Нужен Integer.TYPE."""
    try:
        return Integer.TYPE
    except Exception:
        pass
    try:
        return jclass("int")
    except Exception:
        return None


# ─── 1. кнопка в меню вложений ────────────────────────────────────────────────

# ButtonsAdapter хранит позиции кнопок в int-полях: galleryButton,
# documentButton, ... , attachBotsStartRow/attachBotsEndRow и buttonsCount.
_INDEX_FIELD_SUFFIXES = ("Button", "Row")
_INDEX_FIELD_NAMES = ("buttonsCount",)


class PluginHook(MethodHook):
    """Общая основа хуков: держит ссылку на плагин."""

    def __init__(self, plugin):
        self.plugin = plugin



class AdapterRowsHook(PluginHook):
    """notifyDataSetChanged(): освобождаем слот MY_INDEX под нашу кнопку.

    Индексы сдвигаются на +1 от исходных значений, которые запоминаются при
    первом вызове: без снимка повторный вызов сдвинул бы их ещё раз."""

    ADAPTER_CLASS = "org.telegram.ui.Components.ChatAttachAlert$ButtonsAdapter"

    def before_hooked_method(self, param):
        if not self._is_buttons_adapter(param.thisObject):
            return
        self.plugin._rows_shifted = False

    def after_hooked_method(self, param):
        adapter = param.thisObject
        if not self._is_buttons_adapter(adapter):
            return
        if self.plugin._rows_shifted:
            return
        self.plugin._rows_shifted = True
        try:
            self._shift(adapter)
        except Exception as exc:
            log(TAG + "row shift failed: " + str(exc))

    @classmethod
    def _is_buttons_adapter(cls, obj):
        """Чужой адаптер (другая RecyclerView) сдвигать нельзя."""
        try:
            return str(obj.getClass().getName()) == cls.ADAPTER_CLASS
        except Exception:
            return False

    def _shift(self, adapter):
        """Сдвигает индексы кнопок на +1 от исходных значений.

        Снимок исходных значений хранится в _base_indices: без него сдвиг накапливался
        бы при каждом notifyDataSetChanged()."""
        fields = [f for f in adapter.getClass().getDeclaredFields()
                  if self._is_index_field(f)]
        if not fields:
            log(TAG + "warning: no row index fields found")
            return

        base = getattr(adapter, "_base_indices", None)
        if base is None:
            base = {}
            for field in fields:
                field.setAccessible(True)
                base[str(field.getName())] = int(field.get(adapter))
            adapter._base_indices = base

        shifted = 0
        for field in fields:
            value = base.get(str(field.getName()))
            if value is None:
                continue
            field.setAccessible(True)
            if value >= MY_INDEX:
                field.set(adapter, Integer(value + 1))
                shifted += 1
            else:
                field.set(adapter, Integer(value))

        if shifted == 0:
            log(TAG + "warning: no row indices shifted")

    @staticmethod
    def _is_index_field(field):
        try:
            if str(field.getType().getName()) != "int":
                return False
            name = str(field.getName())
            return name in _INDEX_FIELD_NAMES or name.endswith(_INDEX_FIELD_SUFFIXES)
        except Exception:
            return False


class AdapterBindHook(PluginHook):
    """onBindViewHolder(holder, position): оформляем нашу вкладку.

    Позиции не подменяются — слот освобождён AdapterRowsHook. Вьюхи
    переиспользуются, поэтому отданную другому пункту вьюху чистим от нашего тега."""

    def __init__(self, plugin):
        self.plugin = plugin
        self._ours = False

    def before_hooked_method(self, param):
        try:
            self._ours = int(param.args[1]) == MY_INDEX
        except Exception:
            self._ours = False

    def after_hooked_method(self, param):
        ours, self._ours = self._ours, False
        try:
            view = self._item_view(param.args[0])
            if view is None:
                return
            if not ours:
                # Вьюха ушла под другую кнопку. Если её отдали боту, штатный
                # bind тег не ставит — и на ней остался бы наш id, из-за чего
                # клик по боту открывал бы Google Фото.
                self.plugin.clear_stale_tag(view)
                return
            # Штатный обработчик Telegram читает id кнопки из тега — именно
            # по нему нажатие доходит до наших хуков.
            view.setTag(Integer(MY_TAG))
            self.plugin.style_button(view)
        except Exception as exc:
            log(TAG + "bind our tab failed: " + str(exc))

    @staticmethod
    def _item_view(holder):
        try:
            return holder.itemView
        except Exception:
            return get_private_field(holder, "itemView")


class AlertButtonHook(PluginHook):
    """Основной путь клика: ChatAttachAlert.dismissWithButtonClick(MY_TAG).

    Сюда приходит наш тег из штатного OnItemClickListener: незнакомый id он
    передаёт в delegate.didPressedButton."""

    def __init__(self, plugin):
        self.plugin = plugin
        self._alert = None

    def before_hooked_method(self, param):
        """Оригинал не блокируем: он закрывает меню принудительно, тогда как dismiss()
        уважает delegate.canDismiss(). Picker открываем в after-хуке."""
        self._alert = None
        try:
            button = int(param.args[0])
        except Exception:
            return
        if button != MY_TAG:
            return
        self._alert = getattr(param, "thisObject", None)

    def after_hooked_method(self, param):
        alert = self._alert
        self._alert = None
        if alert is None:
            return
        self.plugin.on_menu_item_selected(alert, None)


class ProcessSelectedAttachHook(PluginHook):
    """Резервный путь клика: ChatActivity.processSelectedAttach(MY_TAG).

    Telegram вызывает его сразу после dismissWithButtonClick, поэтому если
    основной хук не встал, сработает этот."""

    def before_hooked_method(self, param):
        try:
            which = int(param.args[0])
        except Exception:
            return
        if which != MY_TAG:
            return
        param.setResult(None)
        self.plugin.on_menu_item_selected(None, getattr(param, "thisObject", None))


# ─── 2. результат системного выбора ───────────────────────────────────────────

class PickerResultHook(PluginHook):
    """ChatActivity.onActivityResultFragment — забираем выбранные uri."""

    def before_hooked_method(self, param):
        try:
            request_code = int(param.args[0])
        except Exception:
            return
        if request_code != MY_REQUEST_CODE:
            return
        param.setResult(None)
        try:
            result_code = int(param.args[1])
            data = param.args[2]
            if result_code != Activity.RESULT_OK or data is None:
                # Пользователь закрыл picker без выбора — удержание снимаем,
                # иначе экран остался бы горящим до конца таймаута.
                self.plugin._release_screen_on()
                return
            self.plugin.on_picked(param.thisObject, data)
        except Exception as exc:
            log(TAG + "result handling failed: " + str(exc))
            self.plugin._release_screen_on()


class VideoEditedInfoNeedConvertHook(PluginHook):
    """Пропускает конвертацию для видео, которые подготовил плагин.

    Telegram гоняет любое видео через аппаратный MediaCodec, а на файлах из
    picker'а тот пишет пустой огрызок на 148 байт, и отправка замирает. С
    needConvert() == false файл уходит как есть.

    Хук срабатывает только на путях плагина — обычные видео не затрагиваются."""

    def after_hooked_method(self, param):
        try:
            this = getattr(param, "thisObject", None)
            path = str(getattr(this, "originalPath", "") or "")
            bypass_paths = getattr(self.plugin, "_bypass_paths", set())
            if path and path in bypass_paths:
                param.setResult(Boolean(False))
        except Exception as exc:
            log(TAG + "needConvert hook error: " + str(exc))


class ScheduleVideoConvertHook(PluginHook):
    """Предохранитель: не даёт поставить наши видео в очередь перекодирования."""

    def before_hooked_method(self, param):
        try:
            if param.args is not None and len(param.args) > 0:
                obj = param.args[0]
                info = getattr(obj, "videoEditedInfo", None)
                if info is not None:
                    path = str(getattr(info, "originalPath", "") or "")
                    bypass_paths = getattr(self.plugin, "_bypass_paths", set())
                    if path and path in bypass_paths:
                        param.setResult(Boolean(False))
        except Exception as exc:
            log(TAG + "scheduleVideoConvert hook error: " + str(exc))


# ─── иконка вкладки ──────────────────────────────────────────────────────────
#
# Логотип Google Фото, обведённый по контуру в вектор. Форма и толщина штриха
# повторяют картинку-образец (сверено попиксельно), но, в отличие от растра,
# контур остаётся резким на экране с любой плотностью.
#
# Фигура разбита на внешний контур и четыре отверстия. Намотка у них разная,
# поэтому при заливке отверстия вырезаются сами: fill-rule этот парсер не
# понимает, и без встречной намотки фигура залилась бы сплошным пятном.
#
# Цвет заливки здесь не важен: Telegram рисует иконку вкладки через
# ImageView.setColorFilter(SRC_IN) и подставляет цвет темы — светлая она или
# тёмная, вкладка выбрана или нет, всё берётся из темы автоматически.
# Логотип Google Фото одним контуром. Путь переведён в абсолютные команды и
# вписан в 19,5dp из 24dp слота — ровно так, как выглядят штатные значки
# вкладок (у «Галереи» контент занимает 19,3dp), поэтому наш не выглядит
# крупнее соседей.
#
# Дырки в логотипе вырезаны встречной намоткой контуров: fill-rule этот
# парсер не понимает, и без неё фигура залилась бы сплошным пятном.
#
# Цвет заливки здесь не важен: Telegram рисует значок вкладки через
# ImageView.setColorFilter(SRC_IN) и подставляет цвет темы — светлая она
# или тёмная, вкладка выбрана или нет, всё берётся из темы автоматически.
# Логотип Google Фото одним контуром. Путь переведён в абсолютные команды
# и вписан в 22,5dp из 24dp слота: штрих у логотипа тонкий, поэтому при
# размере штатных значков (около 19dp) он читался бы мельче соседей —
# заливка «Галереи» и «Файла» весит куда больше.
#
# Дырки в логотипе вырезаны встречной намоткой контуров: fill-rule этот
# парсер не понимает, и без неё фигура залилась бы сплошным пятном.
#
# Цвет заливки здесь не важен: Telegram рисует значок вкладки через
# ImageView.setColorFilter(SRC_IN) и подставляет цвет темы — светлая она
# или тёмная, вкладка выбрана или нет, всё берётся из темы автоматически.
# Логотип Google Фото одним контуром. Путь переведён в абсолютные команды
# и вписан в 21dp из 24dp слота — так он по габариту совпадает со штатными
# значками вкладок и не вылезает за них.
#
# Дырки в логотипе вырезаны встречной намоткой контуров: fill-rule этот
# парсер не понимает, и без неё фигура залилась бы сплошным пятном.
#
# Цвет заливки здесь не важен: Telegram рисует значок вкладки через
# ImageView.setColorFilter(SRC_IN) и подставляет цвет темы — светлая она
# или тёмная, вкладка выбрана или нет, всё берётся из темы автоматически.
# Логотип Google Фото одним контуром. Путь переведён в абсолютные команды
# и вписан в 19dp из 24dp слота — ровно по габариту штатных значков вкладок
# (у «Галереи» 19,3dp по высоте), чтобы наш не вылезал за соседей.
#
# Дырки в логотипе вырезаны встречной намоткой контуров: fill-rule этот
# парсер не понимает, и без неё фигура залилась бы сплошным пятном.
#
# Цвет заливки здесь не важен: Telegram рисует значок вкладки через
# ImageView.setColorFilter(SRC_IN) и подставляет цвет темы — светлая она
# или тёмная, вкладка выбрана или нет, всё берётся из темы автоматически.
# Логотип Google Фото одним контуром. Путь в абсолютных командах, вписан в
# 18,5dp из 24dp слота: после утолщения штриха на 0,5dp габарит становится
# 19dp — ровно как у штатных значков вкладок (у «Галереи» 19,3dp).
#
# Дырки в логотипе вырезаны встречной намоткой контуров: fill-rule этот
# парсер не понимает, и без неё фигура залилась бы сплошным пятном.
#
# Цвет заливки здесь не важен: Telegram рисует значок вкладки через
# ImageView.setColorFilter(SRC_IN) и подставляет цвет темы — светлая она
# или тёмная, вкладка выбрана или нет, всё берётся из темы автоматически.
# Логотип Google Фото одним контуром. Путь в абсолютных командах, вписан в
# 18,7dp из 24dp слота: со штрихом +0,3dp габарит выходит ровно 19dp — как
# у штатных значков вкладок (у «Галереи» 19,3dp).
#
# Толщина штриха подобрана по соседям: у «Файла» и «Кошелька» линии
# 1,67–2,0dp, здесь столько же.
#
# Дырки в логотипе вырезаны встречной намоткой контуров: fill-rule этот
# парсер не понимает, и без неё фигура залилась бы сплошным пятном.
#
# Цвет заливки здесь не важен: Telegram рисует значок вкладки через
# ImageView.setColorFilter(SRC_IN) и подставляет цвет темы — светлая она
# или тёмная, вкладка выбрана или нет, всё берётся из темы автоматически.
ICON_SVG = (
    '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" '
