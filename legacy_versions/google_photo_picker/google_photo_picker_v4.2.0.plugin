)

# ─── сам плагин ───────────────────────────────────────────────────────────────

class VideoAttributeHook(PluginHook):
    """Подставляет размеры и длительность видео для предпросмотра.

    Когда конвертация пропущена, Telegram берёт их из MediaMetadataRetriever, а
    тот на файлах из picker'а не читает ничего."""

    def after_hooked_method(self, param):
        try:
            args = param.args
            if args is None or len(args) < 2:
                return
            path = str(args[0] or "")
            attribute = args[1]
            if not path or attribute is None:
                return
            meta = self.plugin._video_meta.get(path)
            if meta is None:
                return
            width, height, duration = meta
            if not attribute.w:
                attribute.w = width
            if not attribute.h:
                attribute.h = height
            if not attribute.duration:
                attribute.duration = duration
        except Exception as exc:
            log(TAG + "video attribute hook error: " + str(exc))


class GooglePhotoPickerPlugin(BasePlugin):

    # Состояние держим в атрибутах класса: __init__ у BasePlugin не трогаем,
    # чтобы не сломать инициализацию плагина движком.
    _icon = None
    _label_cache = None
    _hooks = None
    _gallery_animation = None
    _rows_shifted = False
    _last_launch = 0.0
    _bypass_paths = set()

    # Метаданные видео, которые мы отдали Telegram: путь -> (ширина, высота,
    # длительность в секундах). Нужны хуку предпросмотра.
    _video_meta = {}

    # Удерживающий экран wake lock (см. _hold_screen_on).
    _wake_lock = None

    # ---- настройки ----

    def create_settings(self) -> List[Any]:
        """Экран настроек плагина: подпись кнопки и выбор пикера.

        Набор параметров у каждого пункта строго по таблице ui.settings:
        Selector принимает items/icon/on_change/on_long_click/link_alias, но НЕ
        subtext. Лишний параметр роняет весь create_settings целиком, и тогда
        движок не показывает ни одного пункта."""
        try:
            from ui.settings import Divider, Header, Input, Selector
        except Exception as exc:
            log(TAG + "settings import failed: " + str(exc))
            return []
        return [
            Header(text="Кнопка"),
            Input(
                key=SETTING_BUTTON_LABEL,
                text="Название кнопки",
                default="",
                subtext="Пусто — подпись подбирается сама по языку интерфейса",
                icon="msg_text",
            ),
            Divider(text="Пикер"),
            Selector(
                key=SETTING_PICKER_MODE,
                text="Чем открывать выбор",
                default=MODE_AUTO,
                items=list(PICKER_MODES),
                icon="msg_list",
            ),
        ]

    # ---- жизненный цикл ----

    def on_plugin_load(self):
        self._icon = None
        self._label_cache = None
        self._hooks = []
        self._gallery_animation = None
        self._rows_shifted = False
        self._last_launch = 0.0

        # Каждый шаг независим: провал одного не должен отменять остальные.
        for install in (
            self._hook_attach_menu,
            self._hook_chat_activity,
            self._hook_send_messages_helper,
            self._hook_video_convert,
        ):
            self._try(install.__name__, install)

        # В лог уходит всё, по чему видно состояние плагина.
        device = self._describe_device()
        self.log(
            TAG + "v" + __version__ + " loaded, hooks: " + str(len(self._hooks))
            + ", max: " + str(self.max_items()) + ", " + device
        )

    def _describe_device(self):
        """Строка о выбранной стратегии — для лога загрузки."""
        try:
            mode, component, reason = self.detect_strategy()
        except Exception as exc:
            return "detection failed: " + str(exc)
        text = "strategy=" + mode + " (" + reason + ")"
        if component:
            text += ", picker=" + component[0]
        return text + ", setting=" + PICKER_MODES[self.picker_mode()]


    def on_plugin_unload(self):
        # Хуки снимает движок по списку, который вернули hook_method /
        # hook_all_methods, — здесь достаточно отпустить наше состояние.
        self._hooks = []
        self._icon = None
        self._bypass_paths = set()
        self._video_meta = {}
        run_on_ui_thread(self._release_screen_on)

    # ---- установка хуков ----

    def _hook_attach_menu(self):
        adapter = self._safe_find(
            "org.telegram.ui.Components.ChatAttachAlert$ButtonsAdapter"
        )
        if adapter is None:
            self.log(TAG + "ButtonsAdapter не найден — кнопка не добавлена")
            return

        # Раскладка: без этого хука кнопки нет вообще, поэтому без него дальше
        # не идём.
        if not self._install(adapter, "notifyDataSetChanged", (), AdapterRowsHook(self)):
            self.log(TAG + "notifyDataSetChanged не подключён — кнопка не добавлена")
            return

        # Оформление вкладки — здесь же ставится основной обработчик клика,
        # поэтому дальше идём, даже если клик не встанет.
        self._install(adapter, "onBindViewHolder", None, AdapterBindHook(self))

        # Клик по штатному тегу: dismissWithButtonClick объявлен в BottomSheet,
        # а в ChatAttachAlert только переопределён — нужны оба.
        for class_name in (
            "org.telegram.ui.Components.ChatAttachAlert",
            "org.telegram.ui.ActionBar.BottomSheet",
        ):
            alert = self._safe_find(class_name)
            if alert is not None:
                self._install(
                    alert, "dismissWithButtonClick", self._int_types(),
                    AlertButtonHook(self),
                )

        self.log(TAG + "attach menu hooked, hooks: " + str(len(self._hooks)))

    @staticmethod
    def _int_types():
        """Типы аргументов для рефлексии: (int,) либо None, если int не найден."""
        int_type = int_class()
        return (int_type,) if int_type is not None else None

    def _hook_chat_activity(self):
        chat_activity = self._safe_find("org.telegram.ui.ChatActivity")
        if chat_activity is None:
            self.log(TAG + "ChatActivity не найден")
            return

        # Резервный путь клика — по штатному тегу кнопки.
        self._install(
            chat_activity, "processSelectedAttach", self._int_types(),
            ProcessSelectedAttachHook(self),
        )
        # Приём результата системного выбора.
        self._install(
            chat_activity, "onActivityResultFragment", None, PickerResultHook(self)
        )

    def _hook_send_messages_helper(self):
        helper = self._safe_find("org.telegram.messenger.SendMessagesHelper")
        if helper is None:
            self.log(TAG + "SendMessagesHelper не найден")
            return
        if self._install(helper, "fillVideoAttribute", None, VideoAttributeHook(self)):
            self.log(TAG + "SendMessagesHelper.fillVideoAttribute hooked")

    def _hook_video_convert(self):
        info_class = self._safe_find("org.telegram.messenger.VideoEditedInfo")
        if info_class is not None and self._install(
            info_class, "needConvert", (), VideoEditedInfoNeedConvertHook(self)
        ):
            self.log(TAG + "VideoEditedInfo.needConvert hooked")

        controller = self._safe_find("org.telegram.messenger.MediaController")
        if controller is not None and self._install(
            controller, "scheduleVideoConvert", None, ScheduleVideoConvertHook(self)
        ):
            self.log(TAG + "MediaController.scheduleVideoConvert hooked")

    def _install(self, clazz, name, param_types, hook):
        """Ставит хук так, чтобы одна неудача не сломала остальные.

        param_types=None означает «точный хук не нужен» — сразу по имени."""
        if param_types is not None:
            try:
                if self._hook_declared(clazz, name, param_types, hook):
                    return True
            except Exception as exc:
                log(TAG + "precise hook " + name + " failed: " + str(exc))
        try:
            return self._hook_all(clazz, name, hook)
        except Exception as exc:
            log(TAG + "named hook " + name + " failed: " + str(exc))
            return False

    def _safe_find(self, class_name):
        """find_class, который не роняет установку остальных хуков."""
        try:
            return find_class(class_name)
        except Exception as exc:
            log(TAG + "find_class(" + class_name + ") failed: " + str(exc))
            return None

    def _hook_declared(self, clazz, name, param_types, hook):
        """Хук на метод, объявленный именно в этом классе (без фоллбэков)."""
        try:
            method = clazz.getDeclaredMethod(name, *param_types)
            method.setAccessible(True)
            unhook = self.hook_method(method, hook, priority=1000)
            if unhook:
                self._hooks.append(unhook)
                return True
        except Exception as exc:
            log(TAG + "declared hook " + name + " failed: " + str(exc))
        return False

    def _hook_all(self, clazz, name, hook):
        """Хук по имени метода. priority передаём только если SDK его принимает."""
        for with_priority in (False, True):
            try:
                if with_priority:
                    unhooks = self.hook_all_methods(clazz, name, hook, priority=1000)
                else:
                    unhooks = self.hook_all_methods(clazz, name, hook)
            except TypeError as exc:
                log(TAG + "hook_all_methods(" + name + ") signature: " + str(exc))
                continue
            except Exception as exc:
                log(TAG + "hook_all_methods(" + name + ") failed: " + str(exc))
                continue
            if unhooks:
                self._hooks.extend(list(unhooks))
                return True
        log(TAG + "HOOK FAILED: " + name)
        return False

    # ---- оформление кнопки ----

    def style_button(self, button):
        """Оформляем нашу вкладку в освобождённом слоте.

        Штатный bind для нашего индекса ничего не рисует, поэтому выдаём вьюхе значок,
        подпись и свой id. Свой id нужен и затем, чтобы вкладка не выглядела выбранной."""
        glass = get_private_field(button, "glassTabView")
        if glass is None:
            log(TAG + "glassTabView not found")
            return

        # Сначала штатный значок: setTabAnimation готовит вьюху к рисованию, а мы
        # сразу подменяем картинку на логотип. Затем подпись и свой id — он нужен
        # и для клика, и чтобы вкладка не выглядела выбранной вместо «Галереи»
        # (у неё currentId = 1, он же выбран по умолчанию).
        animation = self.gallery_animation()
        if animation is not None:
            self._try("setTabAnimation", glass.setTabAnimation, animation)
        self._try("own icon", self._apply_own_icon, glass)
        self._try("label", self._apply_label, glass)
        self._try("currentId", set_private_field, button, "currentId", Integer(MY_TAG))

    @staticmethod
    def _try(what, func, *args):
        """
        Зовём шаг оформления, не роняя остальные.

        Шаги независимы: если не встал значок, подпись и id всё равно нужны.
        """
        try:
            func(*args)
        except Exception as exc:
            log(TAG + what + " failed: " + str(exc))

    def _apply_own_icon(self, glass):
        """Ставит на вкладку наш логотип вместо штатного.

        Цвет Telegram навешивает сам через updateColors(): фильтр живёт во вьюхе и
        перекрашивает любую присвоенную картинку."""
        image_view = get_private_field(glass, "imageView")
        if image_view is None:
            log(TAG + "icon: imageView not found")
            return

        drawable = self.own_icon_drawable()
        if drawable is None:
            log(TAG + "icon: drawable not built")
            return

        # Сначала сбрасываем лотти «Галереи»: он продолжает рисоваться поверх
        # любой присвоенной картинки, пока живёт во вьюхе.
        try:
            image_view.clearAnimationDrawable()
        except Exception as exc:
            log(TAG + "icon: clearAnimationDrawable failed: " + str(exc))

        image_view.setImageDrawable(drawable)
        try:
            image_view.setVisibility(0)
        except Exception:
            pass

    def own_icon_drawable(self):
        """Drawable с логотипом Google Фото. Собирается один раз.

        Берём растр ровно в размер вкладки. Векторный SvgDrawable не годится: цвет
        иконке задаёт ImageView.setColorFilter(SRC_IN), а у SvgDrawable этот метод
        пустой."""
        if self._icon is not None:
            return self._icon
        try:
            dp = int(jclass("org.telegram.messenger.AndroidUtilities").dp(24))
            bitmap = jclass("org.telegram.messenger.SvgHelper").getBitmap(
                String(ICON_SVG), dp, dp, False
            )
            if bitmap is None:
                log(TAG + "icon: SvgHelper returned null")
                return None
            resources = jclass(
                "org.telegram.messenger.ApplicationLoader"
            ).applicationContext.getResources()
            self._icon = jclass("android.graphics.drawable.BitmapDrawable")(
                resources, bitmap
            )
            return self._icon
        except Exception as exc:
            log(TAG + "icon build failed: " + str(exc))
            return None

    def clear_stale_tag(self, view):
        """Снимаем наш id с вьюхи, отданной другой кнопке."""
        try:
            tag = view.getTag()
            if tag is not None and int(tag) == MY_TAG:
                view.setTag(None)
        except Exception as exc:
            log(TAG + "clear stale tag failed: " + str(exc))

    def gallery_animation(self):
        """GlassTabView.TabAnimation.GALLERY — значок вкладки выбора медиа.

        setTabAnimation приводит вьюху в рабочее состояние, а картинку мы сразу
        подменяем своим логотипом."""
        if self._gallery_animation is not None:
            return self._gallery_animation
        try:
            enum_class = jclass(
                "org.telegram.ui.Components.glass.GlassTabView$TabAnimation"
            )
        except Exception as exc:
            log(TAG + "TabAnimation not found: " + str(exc))
            return None
        constant = self._enum_constant(enum_class, ("GALLERY", "PHOTOS", "IMAGES"))
        if constant is None:
            log(TAG + "TabAnimation.GALLERY not found")
            return None
        self._gallery_animation = constant
        return constant

    @staticmethod
    def _enum_constant(enum_class, preferred_names):
        """Первая существующая константа перечисления из списка предпочтений."""
        for name in preferred_names:
            try:
                return enum_class.getField(name).get(None)
            except Exception:
                pass
            try:
                return jclass("java.lang.Enum").valueOf(enum_class, name)
            except Exception:
                pass
        return None

    # Ширина вкладки в Telegram ограничена константой dp(84)
    # (GlassTabView.measureAttachTabWidth), а текст с ellipsize=END обрезается.
    TAB_WIDTH_LIMIT_DP = 84

    # Подписи от длинной к короткой: «Google Фото» в лимит вкладки не входит,
    # поэтому при переполнении берём укороченный вариант.
    LABELS_RU = ("Google Фото", "Гугл Фото", "Фото")
    LABELS_EN = ("Google Photos", "Google", "Photos")

    def _apply_label(self, glass):
        """
        Ставим самую длинную подпись, которая влезает во вкладку.

        «Google Фото» в лимит dp(84) не входит, поэтому при переполнении берём
        укороченный вариант. Подпись из настроек — единственная и ставится как
        есть: её обрезает уже сам Telegram.
        """
        labels = self._labels()
        for candidate in labels:
            glass.setText(candidate)
            try:
                if glass.measureAttachTabWidth() < self._tab_width_limit() - 0.5:
                    return  # не упёрлись в лимит — текст не обрежется
            except Exception:
                return  # измерить не смогли, оставляем как есть
        # Своя подпись из настроек — единственный вариант в списке, и подменить
        # её нечем: если не влезла, обрежет уже сам Telegram.
        log(TAG + "label does not fit: " + labels[-1])

    def _labels(self):
        """Подписи от длинной к короткой, по языку интерфейса."""
        custom = self.custom_label()
        if custom:
            return [custom]
        if self._label_cache is None:
            try:
                language = str(jclass("java.util.Locale").getDefault().getLanguage())
            except Exception:
                language = "ru"
            if language.lower().startswith("ru"):
                self._label_cache = list(self.LABELS_RU)
            else:
                self._label_cache = list(self.LABELS_EN)
        return self._label_cache

    def custom_label(self):
        """Подпись кнопки из настроек. Пусто — подбираем сами."""
        try:
            return str(self.get_setting(SETTING_BUTTON_LABEL, "") or "").strip()
        except Exception as exc:
            log(TAG + "button label read failed: " + str(exc))
            return ""

    def _tab_width_limit(self):
        """Лимит ширины вкладки в пикселях (см. TAB_WIDTH_LIMIT_DP)."""
        try:
            return float(
                jclass("org.telegram.messenger.AndroidUtilities").dp(
                    self.TAB_WIDTH_LIMIT_DP
                )
            )
        except Exception:
            return float(self.TAB_WIDTH_LIMIT_DP)

    # ---- запуск системного выбора ----

    def on_menu_item_selected(self, alert=None, activity=None):
        """Единая точка входа для всех путей клика.

        Пути могут сработать почти одновременно, поэтому запуск защищён тайм-штампом."""
        now = time.monotonic()
        if now - self._last_launch < 1.0:
            return
        self._last_launch = now

        fragment = self._resolve_fragment(alert, activity)

        # Меню закрываем сами: при клике по нашей вкладке штатный
        # dismissWithButtonClick может вообще не вызываться.
        if alert is None and fragment is not None:
            alert = self._alert_of(fragment)
        if alert is not None:
            try:
                alert.dismiss()
            except Exception as exc:
                log(TAG + "alert dismiss failed: " + str(exc))

        if fragment is None:
            log(TAG + "chat fragment not found")
            self._bulletin("Не удалось определить чат для отправки")
            return

        # Держим экран с этого момента: picker — отдельная активность, и пока
        # он открыт, Telegram в фоне. Его окно и флаги на чужую активность не
        # действуют, поэтому без удержания экран у системного выбора успевает
        # и потускнеть, и уснуть.
        self._hold_screen_on(self._activity_of(fragment))

        run_on_ui_thread(lambda: self.launch_picker(fragment), LAUNCH_DELAY_MS)

    def _alert_of(self, fragment):
        """ChatAttachAlert текущего чата — чтобы закрыть меню вложений."""
        try:
            return get_private_field(fragment, "chatAttachAlert")
        except Exception as exc:
            log(TAG + "chatAttachAlert lookup failed: " + str(exc))
            return None

    def _resolve_fragment(self, alert, activity):
        """Ищем фрагмент чата — от самого надёжного источника к общему.

        baseFragment у меню вложений — ровно то, что использует сам Telegram."""
        if alert is not None:
            fragment = self._safe_field(alert, "baseFragment")
            if fragment is not None:
                return fragment
        if activity is not None:
            return activity
        for getter in (self.launch_fragment, self.last_fragment):
            fragment = getter()
            if fragment is not None:
                return fragment
        return None

    @staticmethod
    def _safe_field(obj, name):
        try:
            return get_private_field(obj, name)
        except Exception as exc:
            log(TAG + name + " lookup failed: " + str(exc))
            return None

    def launch_fragment(self):
        """Последний фрагмент LaunchActivity — то же, что видит Telegram."""
        try:
            return jclass("org.telegram.ui.LaunchActivity").getLastFragment()
        except Exception as exc:
            log(TAG + "LaunchActivity.getLastFragment failed: " + str(exc))
            return None

    def last_fragment(self):
        try:
            return get_last_fragment()
        except Exception as exc:
            log(TAG + "get_last_fragment failed: " + str(exc))
            return None

    def launch_picker(self, fragment):
        """Открываем системный выбор.

        Варианты перебираются по порядку, каждый пробуется и на Activity чата, и на
        фрагменте. startActivityForResult зовём напрямую: отсутствие обработчика
        приходит синхронно, и мы успеваем уйти на запасной вариант."""
        if fragment is None:
            log(TAG + "launch_picker without fragment")
            self._bulletin("Не удалось определить чат для отправки")
            return

        # Activity идёт первой: BaseFragment.startActivityForResult уходит в
        # неё же, но при пустом parentLayout просто ничего не делает и не
        # бросает исключение — по фрагменту мы бы отчитались об успехе зря.
        targets = []
        try:
            activity = fragment.getParentActivity()
            if activity is not None:
                targets.append(activity)
        except Exception as exc:
            log(TAG + "getParentActivity failed: " + str(exc))
        targets.append(fragment)

        last_error = None
        variants = self.picker_intent_variants()
        for index, build in enumerate(variants):
            try:
                intent = build()
            except Exception as exc:
                last_error = exc
                continue
            for target in targets:
                try:
                    target.startActivityForResult(intent, MY_REQUEST_CODE)
                except Exception as exc:
                    last_error = exc
                    continue
                log(TAG + "picker launched, variant " + str(index))
                return

        log(TAG + "picker not launched: " + str(last_error))
        self._release_screen_on()
        self._bulletin("Не удалось открыть системный выбор фото и видео")

    def picker_intent(self, component=None):
        """ACTION_PICK_IMAGES: фото и видео, множественный выбор.

        type намеренно не выставляется — пустой type означает «фото и видео».
        EXTRA_PICK_IMAGES_MAX включает множественный выбор."""
        if self.system_picker_available():
            media_store = jclass("android.provider.MediaStore")
            intent = Intent(media_store.ACTION_PICK_IMAGES)
            limit = self.max_items()
            key = str(media_store.EXTRA_PICK_IMAGES_MAX)

            # Bundle.putInt — единственная перегрузка с таким именем, поэтому
            # значение гарантированно уходит как int. У Intent.putExtra
            # перегрузок больше десятка (int/long/char/byte/String/...), и
            # выбор между ними неочевиден.
            extras = Bundle()
            extras.putInt(key, limit)
            intent.putExtras(extras)
            log(TAG + "extra " + key + "=" + str(limit))

            if component is not None:
                # Явный компонент обходит выбор производителя. Нужен там, где
                # ACTION_PICK_IMAGES перехватывает вендорский пикер (HyperOS,
                # ColorOS, OriginOS, MagicOS) — он облако Google Фото не
                # показывает. Несуществующий компонент даст исключение прямо в
                # startActivityForResult, и мы просто уйдём на следующий вариант.
                intent.setComponent(ComponentName(component[0], component[1]))
                log(TAG + "explicit picker: " + component[0] + "/" + component[1])

            intent.addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)
            return intent
        return self.fallback_intent()

    def picker_mode(self):
        """Выбранный в настройках пикер. Незнакомое значение — «Авто»."""
        try:
            mode = int(self.get_setting(SETTING_PICKER_MODE, MODE_AUTO))
        except Exception as exc:
            log(TAG + "picker mode read failed: " + str(exc))
            return MODE_AUTO
        return mode if 0 <= mode < len(PICKER_MODES) else MODE_AUTO

    def picker_intent_variants(self):
        """Варианты интента выбора: выбранный пикер, затем запасные.

        Группы вариантов собираются один раз, а режим из настроек задаёт только
        их очерёдность. В «Авто» порядок берётся из detect_strategy(). Хвост
        цепочки остаётся на месте всегда: недоступный пикер не должен оставлять
        пользователя без выбора."""
        detected, native, reason = self.detect_strategy()
        mode = self.picker_mode()

        groups = {
            "photos": [self.photos_app_intent, self.photos_app_package_intent],
            "native": self.native_picker_variants(native),
            "aosp": self.aosp_picker_variants(),
            "system": [self.picker_intent] if self.system_picker_available() else [],
            "fallback": [self.fallback_intent],
        }

        # Системный выбор — последним из основных: он есть не везде, и
        # picker_intent сам уходит на fallback_intent, если ACTION_PICK_IMAGES
        # не поддерживается. fallback остаётся хвостом цепочки и в настройках
        # не выбирается — это страховка, а не режим.
        order = ("native", "photos") if detected == "native" else ("photos", "native")
        order += ("system", "fallback")

        chosen = {
            MODE_SYSTEM: "system",
            MODE_PHOTOS: "photos",
            MODE_AOSP: "aosp",
        }.get(mode)
        if chosen is not None:
            order = (chosen,) + tuple(name for name in order if name != chosen)

        variants = []
        for name in order:
            variants.extend(groups[name])

        log(
            TAG + "mode=" + PICKER_MODES[mode] + ", strategy=" + detected
            + " (" + reason + "), variants=" + str(len(variants))
        )
        return variants

    def native_picker_variants(self, native=None):
        """Нативные пикеры Google явным компонентом: выбранный — первым."""
        variants = []
        if native is not None:
            variants.append(lambda c=native: self.picker_intent(c))
        variants.extend(
            lambda c=component: self.picker_intent(component)
            for component in GOOGLE_NATIVE_PICKERS
            if component != native
        )
        return variants

    def aosp_picker_variants(self):
        """Пикер MediaProvider явным компонентом — тот, что стоит в AOSP."""
        return [
            lambda p=package: self.picker_intent((p, AOSP_PICKER_CLASS))
            for package in AOSP_PICKER_PACKAGES
        ]

    # ---- определение устройства ----

    def detect_strategy(self):
        """Решает, чем открывать выбор: (режим, компонент, пояснение).

        native — системный пикер Google с облаком, photos_app — собственный выбор
        приложения Google Фото, system — ни того, ни другого."""
        manager = self.package_manager()
        if manager is None:
            return ("photos_app", None, "package manager unavailable")

        photos_installed = self.package_installed(GOOGLE_PHOTOS_PACKAGE, manager)
        cloud_ok = GOOGLE_PHOTOS_PACKAGE in self.cloud_provider_packages(manager)
        native = self.first_native_picker(manager)

        reason = (
            "photos=" + str(photos_installed)
            + ", cloud=" + str(cloud_ok)
            + ", native=" + (native[0] if native else "none")
        )
        if native is not None and cloud_ok:
            return ("native", native, reason)
        if photos_installed:
            return ("photos_app", native, reason)
        return ("system", native, reason)

    def package_manager(self):
        """PackageManager приложения. Нужен, чтобы опросить установленное."""
        try:
            loader = jclass("org.telegram.messenger.ApplicationLoader")
            context = loader.applicationContext
            if context is not None:
                return context.getPackageManager()
        except Exception as exc:
            log(TAG + "package manager failed: " + str(exc))
        return None

    def package_installed(self, package, manager=None):
        """Установлен ли пакет: getPackageInfo бросает исключение, если пакета нет."""
        manager = manager or self.package_manager()
        if manager is None:
            return False
        try:
            manager.getPackageInfo(package, 0)
            return True
        except Exception:
            return False

    def cloud_provider_packages(self, manager=None):
        """Пакеты, зарегистрированные как поставщики облачных медиа.

        Именно они дают системному picker'у облачные фото."""
        manager = manager or self.package_manager()
        if manager is None:
            return []
        found = []
        try:
            resolved = manager.queryIntentContentProviders(
                Intent(CLOUD_MEDIA_PROVIDER_ACTION), 0
            )
            for index in range(int(resolved.size())):
                provider = resolved.get(index).providerInfo
                if provider is not None:
                    found.append(str(provider.packageName))
        except Exception as exc:
            log(TAG + "cloud provider query failed: " + str(exc))
        return found

    def first_native_picker(self, manager=None):
        """Первый существующий нативный пикер Google.

        Существование проверяем через getActivityInfo: у отсутствующего компонента он
        бросает исключение."""
        manager = manager or self.package_manager()
        if manager is None:
            return None
        for component in GOOGLE_NATIVE_PICKERS:
            try:
                manager.getActivityInfo(
                    ComponentName(component[0], component[1]), 0
                )
                return component
            except Exception:
                continue
        return None

    def photos_app_intent(self):
        """Выбор внутри самого приложения Google Фото.

        Явный компонент обходит выбор производителя и показывает облако — нужен там,
        где системный picker перехвачен вендором."""
        intent = self._pick_media_intent()
        intent.setComponent(
            ComponentName(GOOGLE_PHOTOS_PACKAGE, GOOGLE_PHOTOS_PICKER_CLASS)
        )
        return intent

    def photos_app_package_intent(self):
        """Резервный запуск приложения Google Фото по имени пакета."""
        intent = self._pick_media_intent()
        intent.setPackage(GOOGLE_PHOTOS_PACKAGE)
        return intent

    def fallback_intent(self):
        """Системный выбор без уточнений: фото и видео, множественный выбор."""
        return self._pick_media_intent()

    @staticmethod
    def _pick_media_intent():
        """ACTION_GET_CONTENT на фото и видео с множественным выбором."""
        intent = Intent(Intent.ACTION_GET_CONTENT)
        intent.setType("*/*")
        intent.putExtra(
            Intent.EXTRA_MIME_TYPES, jarray(String)(["image/*", "video/*"])
        )

        # putBoolean вместо putExtra: у putExtra несколько десятков перегрузок,
        # и Chaquopy может выбрать не ту. putBoolean такой один.
        extras = Bundle()
        extras.putBoolean(str(Intent.EXTRA_ALLOW_MULTIPLE), True)
        intent.putExtras(extras)

        intent.addCategory(Intent.CATEGORY_OPENABLE)
        intent.addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)
        return intent

    def system_picker_available(self):
        try:
            sdk = int(Build.VERSION.SDK_INT)
        except Exception:
            return False
        if sdk >= 33:
            return True
        if sdk >= 30:
            # фото-выбор приезжает на Android 11/12 как расширение SDK
            try:
                extensions = jclass("android.os.ext.SdkExtensions")
                return int(extensions.getExtensionVersion(30)) >= 2
            except Exception:
                return False
        return False

    def max_items(self):
        """Лимит выбора для системного picker'а.

        При превышении он не занижает лимит, а отвергает конфигурацию целиком, поэтому
        берём меньшее из MAX_PICK_ITEMS и системного предела."""
        limit = MAX_PICK_ITEMS
        try:
            system_limit = int(
                jclass("android.provider.MediaStore").getPickImagesMaxLimit()
            )
            if 1 <= system_limit < limit:
                limit = system_limit
        except Exception as exc:
            log(TAG + "getPickImagesMaxLimit failed: " + str(exc))
        return limit

    # ---- полученные файлы ----

    def on_picked(self, fragment, data):
        """Разбираем ответ системного выбора: сначала набор, потом одиночный uri."""
        uris = self._clip_uris(data)
        if not uris:
            try:
                uri = data.getData()
            except Exception:
                uri = None
            if uri is not None:
                uris = [uri]
        if not uris:
            return

        limit = self.max_items()
        if len(uris) > limit:
            uris = uris[:limit]

        log(TAG + "picked " + str(len(uris)) + " item(s)")

        # Удержание перезапускаем: пока пользователь ходил по облаку, прежний
        # wake lock мог истечь, а впереди ещё копирование файла.
        self._hold_screen_on(self._activity_of(fragment))

        # Копирование облачных файлов — блокирующая операция, ей не место в UI.
        run_on_queue(lambda: self.prepare_media(fragment, uris))

    @staticmethod
    def _clip_uris(data):
        """uri из ClipData множественного выбора."""
        try:
            clip = data.getClipData()
        except Exception:
            return []
        if clip is None:
            return []
        try:
            count = int(clip.getItemCount())
        except Exception:
            return []

        uris = []
        for index in range(count):
            try:
                item = clip.getItemAt(index)
                uri = item.getUri() if item is not None else None
            except Exception:
                continue
            if uri is not None:
                uris.append(uri)
        return uris

    def prepare_media(self, fragment, uris):
        """Готовим SendingMediaInfo: фото — по uri, видео — через локальный файл.

        Видео обязательно проходит через файл: Telegram работает с ним по пути, и
        только так можно отдать оригинал вместо урезанной копии."""
        try:
            infos = self._build_infos(fragment, uris)
        except Exception as exc:
            log(TAG + "prepare failed: " + str(exc))
            infos = None
        run_on_ui_thread(lambda: self._finish_prepare(fragment, infos))

    def _finish_prepare(self, fragment, infos):
        """Отправка и снятие флага экрана. Выполняется на UI-потоке."""
        try:
            if infos is not None and not infos.isEmpty():
                self.send_media(fragment, infos)
        finally:
            self._release_screen_on()

    def _build_infos(self, fragment, uris):
        """SendingMediaInfo по каждому выбранному элементу."""
        sending_info_class = self._sending_media_info_class()
        if sending_info_class is None:
            return None

        resolver = self._resolver_of(fragment)
        infos = ArrayList()
        skipped = 0

        for uri in uris:
            try:
                mime = None
                if resolver is not None:
                    try:
                        mime = resolver.getType(uri)
                    except Exception:
                        mime = None

                info = sending_info_class()
                info.isVideo = False

                if self._is_video(uri, mime, resolver):
                    info.isVideo = True
                    path = self._video_path(
                        uri, mime, resolver, self._media_size(resolver, uri)
                    )
                    if path is None:
                        # Оригинал достать не удалось — пусть решает Telegram.
                        info.uri = uri
                    else:
                        info.path = path
                        info.uri = None
                        info.videoEditedInfo = self._create_video_edited_info(path)
                        # Кадр для предпросмотра: Telegram берёт его тем же
                        # MediaMetadataRetriever, который такие файлы не
                        # читает, поэтому готовим кадр сами.
                        info.thumbPath = self._make_thumbnail(path)
                else:
                    info.uri = uri
                infos.add(info)
            except Exception as exc:
                log(TAG + "prepare item failed: " + str(exc))
                skipped += 1

        if skipped:
            self._bulletin(
                "Не удалось подготовить файлов: " + str(skipped), fragment
            )
        return infos

    def _hold_screen_on(self, activity):
        """Не даём экрану погаснуть и померкнуть, пока открыт выбор и идёт
        подготовка.

        Удержание идёт с клика по вкладке и до ответа picker'а, поэтому покрывает и
        сам выбор, и копирование файла. FLAG_KEEP_SCREEN_ON не даёт экрану уснуть, но
        затемнение снимает только SCREEN_BRIGHT_WAKE_LOCK — нужны оба. Яркость не
        переопределяем: экран светит так, как настроен."""
        if activity is None:
            return
        self._release_wake_lock()
        self._keep_screen_flag(activity)
        self._acquire_wake_lock()
        run_on_ui_thread(self._release_screen_on, SCREEN_ON_MAX_MS)

    def _release_screen_on(self):
        """Снимаем удержание. Повторный вызов безвреден."""
        self._release_wake_lock()

    def _acquire_wake_lock(self):
        """Держим экран ярким через wake lock.

        SCREEN_BRIGHT_WAKE_LOCK устарел, но именно он снимает затемнение. Разрешение
        WAKE_LOCK у Telegram уже есть."""
        if self._wake_lock is not None:
            return
        try:
            power = jclass("android.os.PowerManager")
            context = jclass(
                "org.telegram.messenger.ApplicationLoader"
            ).applicationContext
            manager = context.getSystemService(context.POWER_SERVICE)
            if manager is None:
                return
            level = int(power.SCREEN_BRIGHT_WAKE_LOCK) | int(power.ACQUIRE_CAUSES_WAKEUP)
            lock = manager.newWakeLock(level, WAKE_LOCK_TAG)
            lock.setReferenceCounted(False)
            lock.acquire(SCREEN_ON_MAX_MS)
            self._wake_lock = lock
        except Exception as exc:
            log(TAG + "wake lock failed: " + str(exc))

    def _release_wake_lock(self):
        lock, self._wake_lock = self._wake_lock, None
        if lock is None:
            return
        try:
            lock.release()
        except Exception as exc:
            log(TAG + "wake lock release failed: " + str(exc))

    @staticmethod
    def _keep_screen_flag(activity):
        """Ставим окну FLAG_KEEP_SCREEN_ON.

        Яркость не трогаем: экран должен остаться таким, как настроил пользователь.
        Флаг снимается сам, когда активность уходит в фон."""
        try:
            params = jclass("android.view.WindowManager$LayoutParams")
            activity.getWindow().addFlags(int(params.FLAG_KEEP_SCREEN_ON))
        except Exception as exc:
            log(TAG + "screen flag failed: " + str(exc))

    @staticmethod
    def _activity_of(fragment):
        try:
            return fragment.getParentActivity()
        except Exception:
            return None

    @staticmethod
    def _sending_media_info_class():
        for name in (
            "org.telegram.messenger.SendMessagesHelper$SendingMediaInfo",
            "org.telegram.messenger.SendMessagesHelper.SendingMediaInfo",
        ):
            try:
                return jclass(name)
            except Exception:
                continue
        log(TAG + "SendingMediaInfo not found")
        return None

    @classmethod
    def _resolver_of(cls, fragment):
        activity = cls._activity_of(fragment)
        if activity is None:
            return None
        try:
            return activity.getContentResolver()
        except Exception:
            return None

    def _video_path(self, uri, mime, resolver=None, expected_size=None):
        """Путь к файлу видео — от самого дешёвого способа к самому дорогому.

        Сначала оригинал на устройстве, затем копия через MediaController, и лишь в
        конце поток из ContentProvider — для облачных видео."""
        # Размер сверяем: у облачного видео id может случайно совпасть с
        # локальным файлом, и без проверки уйдёт совсем другое видео.
        path = self._local_video(resolver, uri, expected_size)
        if path is not None:
            return path

        extension = self.extension_for(mime)
        try:
            path = jclass("org.telegram.messenger.MediaController").copyFileToCache(
                uri, extension
            )
            if path is not None and jclass("java.io.File")(path).exists():
                return path
        except Exception as exc:
            log(TAG + "copyFileToCache failed: " + str(exc))

        return self._stream_to_cache(uri, resolver, extension)

    def _stream_to_cache(self, uri, resolver, extension):
        """Копия облачного файла в кеше: ContentResolver -> FileLoader.copyFile."""
        if resolver is None:
            return None
        try:
            stream = resolver.openInputStream(uri)
        except Exception as exc:
            log(TAG + "openInputStream failed: " + str(exc))
            return None
        if stream is None:
            return None

        try:
            cache_dir = jclass(
                "org.telegram.messenger.ApplicationLoader"
            ).applicationContext.getCacheDir()
            name = "gphoto_vid_" + str(int(time.time() * 1000)) + "." + extension
            target = jclass("java.io.File")(cache_dir, name)
            copied = jclass("org.telegram.messenger.FileLoader").copyFile(
                stream, target
            )
            if copied and target.exists() and target.length() > 0:
                log(TAG + "streamed video to cache: " + str(target.getAbsolutePath()))
                return str(target.getAbsolutePath())
        except Exception as exc:
            log(TAG + "stream copy failed: " + str(exc))
        finally:
            try:
                stream.close()
            except Exception:
                pass
        return None

    # Расширения, по которым медиа опознаётся как видео, если ContentResolver
    # не дал тип.
    VIDEO_EXTENSIONS = (
        ".mp4", ".mov", ".mkv", ".webm", ".3gp", ".avi", ".ts", ".m4v", ".hevc",
    )

    # Сигнатуры контейнеров: первый бокс файла и magic-байты.
    VIDEO_BOXES = (b"ftyp", b"moov", b"wide", b"mdat", b"free", b"skip")
    VIDEO_MAGIC = (b"\x1a\x45\xdf\xa3",)  # MKV / WebM

    def _is_video(self, uri, mime, resolver=None):
        """
        Видео ли это.

        Одного getType мало: для Video Boost он возвращает None или image/jpeg.
        Проверяем тип, расширение в uri, имя файла в MediaStore и, в последнюю
        очередь, сигнатуру контейнера в первых байтах.
        """
        if mime is not None and str(mime).lower().startswith("video"):
            return True
        if self._has_video_extension(str(uri) if uri is not None else ""):
            return True
        if resolver is None or uri is None:
            return False

        cursor = self._query(resolver, uri)
        if cursor is not None:
            try:
                if cursor.moveToFirst():
                    for column in ("_display_name", "title", "_data"):
                        index = cursor.getColumnIndex(column)
                        if index < 0:
                            continue
                        if self._has_video_extension(str(cursor.getString(index) or "")):
                            return True
            except Exception:
                pass
            finally:
                cursor.close()

        return self._header_is_video(resolver, uri)

    def _has_video_extension(self, value):
        value = value.lower()
        return any(extension in value for extension in self.VIDEO_EXTENSIONS)

    def _header_is_video(self, resolver, uri):
        """Сигнатура контейнера: mp4/mov, MKV/WebM или AVI."""
        try:
            stream = resolver.openInputStream(uri)
        except Exception:
            return False
        if stream is None:
            return False
        try:
            header = bytearray(32)
            if stream.read(header, 0, 32) < 12:
                return False
            if bytes(header[4:8]) in self.VIDEO_BOXES:
                return True
            if bytes(header[0:4]) in self.VIDEO_MAGIC:
                return True
            return bytes(header[0:4]) == b"RIFF" and bytes(header[8:12]) == b"AVI "
        except Exception:
            return False
        finally:
            try:
                stream.close()
            except Exception:
                pass

    def _query(self, resolver, uri):
        """Курсор по uri или None. Закрывать — на стороне вызывающего."""
        if resolver is None or uri is None:
            return None
        try:
            return resolver.query(uri, None, None, None, None)
        except Exception:
            return None

    def _cell(self, resolver, uri, column, as_number=False):
        """Значение одной колонки или None."""
        cursor = self._query(resolver, uri)
        if cursor is None:
            return None
        try:
            if not cursor.moveToFirst():
                return None
            index = cursor.getColumnIndex(column)
            if index < 0:
                return None
            value = cursor.getLong(index) if as_number else cursor.getString(index)
            if value is None:
                return None
            return int(value) if as_number else str(value)
        except Exception:
            return None
        finally:
            cursor.close()

    def _media_size(self, resolver, uri):
        """Размер файла по данным MediaStore."""
        return self._cell(resolver, uri, "_size", as_number=True)

    def _data_column(self, resolver, uri):
        """Путь к файлу из колонки _data самого MediaStore."""
        return self._cell(resolver, uri, "_data")

    def _telegram_path(self, uri):
        """Запасной способ: путь через AndroidUtilities.getPath."""
        try:
            value = jclass(
                "org.telegram.messenger.AndroidUtilities"
            ).getPath(uri)
            return str(value) if value else None
        except Exception:
            return None

    def _local_video(self, resolver, uri, expected_size=None):
        """Настоящий файл на устройстве, если он есть.

        Picker отдаёт uri на синтетическую копию в /.transforms с вырезанными
        метаданными. По id из uri оригинал находится обычным запросом к MediaStore."""
        try:
            media_id = str(uri.getLastPathSegment())
        except Exception:
            return None
        if not media_id.isdigit():
            return None

        for base in (
            "content://media/external/video/media/",
            "content://media/external/file/",
        ):
            try:
                query_uri = jclass("android.net.Uri").parse(base + media_id)
            except Exception:
                continue
            for path in (
                self._data_column(resolver, query_uri),
                self._telegram_path(query_uri),
            ):
                if not path:
                    continue
                path = str(path)
                # Копия из .transforms — это и есть испорченный файл.
                if "/.transforms/" in path:
                    continue
                try:
                    file_obj = jclass("java.io.File")(path)
                    if not file_obj.exists() or file_obj.length() <= 0:
                        continue
                    if expected_size and file_obj.length() != expected_size:
                        continue
                    return path
                except Exception:
                    continue
        return None

    def _bulletin(self, message, fragment=None):
        """Всплывающая подсказка Telegram. Ошибка здесь ничего не ломает."""
        def _show():
            try:
                from ui.bulletin import BulletinHelper

                BulletinHelper.show_info(message, fragment)
            except Exception as exc:
                log(TAG + "bulletin failed: " + str(exc))

        run_on_ui_thread(_show)

    def send_media(self, fragment, infos):
        """Отдаём выбранное Telegram штатным путём поиска медиа.

        didSelectSearchPhotos группирует вложения в один альбом."""
        if infos.isEmpty():
            return
        # Фрагмент мог умереть, пока открыт системный выбор.
        try:
            if fragment.getParentActivity() is None:
                log(TAG + "fragment detached, send skipped")
                return
        except Exception:
            pass

        try:
            fragment.didSelectSearchPhotos(infos, True, 0)
            log(TAG + "sent media via didSelectSearchPhotos")
            return
        except Exception as exc:
            log(TAG + "didSelectSearchPhotos failed: " + str(exc))

        if not self._call_did_select_photos(fragment, infos):
            self._bulletin("Не удалось отправить медиа", fragment)

    def _call_did_select_photos(self, fragment, infos):
        """Резервный путь отправки: didSelectPhotos с разным числом параметров."""
        try:
            methods = fragment.getClass().getMethods()
        except Exception:
            return False
        for method in methods:
            try:
                if method.getName() != "didSelectPhotos":
                    continue
                count = len(method.getParameterTypes())
                if count == 3:
                    method.invoke(fragment, infos, Boolean(True), Integer(0))
                elif count == 5:
                    method.invoke(
                        fragment, infos, Boolean(True), Integer(0), Integer(0), Long(0)
                    )
                else:
                    continue
                log(TAG + "sent via didSelectPhotos/" + str(count))
                return True
            except Exception as exc:
                log(TAG + "didSelectPhotos invoke failed: " + str(exc))
        return False

    def extension_for(self, mime):
        """Расширение файла для копии в кеше. Без mime — mp4."""
        if mime:
            try:
                extension = jclass(
                    "android.webkit.MimeTypeMap"
                ).getSingleton().getExtensionFromMimeType(str(mime))
                if extension:
                    return str(extension)
            except Exception:
                pass
        return "mp4"

    def _read_video_meta(self, path):
        """Метаданные видео собственным парсером Telegram.

        MediaMetadataRetriever на файлах из picker'а не читает ничего — отсюда «0:00»
        и отсутствие картинки. AnimatedFileNative этот файл понимает."""
        try:
            params = jclass("java.lang.reflect.Array").newInstance(
                jclass("java.lang.Integer").TYPE, 11
            )
        except Exception as exc:
            log(TAG + "params array failed: " + str(exc))
            return None

        try:
            jclass("org.telegram.ui.Components.AnimatedFileNative").getVideoInfo(
                str(path), params, 0
            )
            size = int(jclass("java.io.File")(str(path)).length())
            width = int(params[1])
            height = int(params[2])
            bitrate = int(params[3])
            duration = int(params[4])       # миллисекунды
            framerate = int(params[7])
            rotation = int(params[8])
        except Exception as exc:
            log(TAG + "video meta failed: " + str(exc))
            return None

        if width <= 0 or height <= 0 or duration <= 0 or size <= 0:
            log(TAG + "video meta invalid: " + str((width, height, duration, size)))
            return None

        if bitrate <= 0:
            # Оценка по размеру: файл целиком делим на длительность.
            bitrate = int(size * 8 / (duration / 1000.0))

        # Нужны хуку предпросмотра: он подставляет их, когда система прочитать
        # файл не смогла.
        self._video_meta[str(path)] = (width, height, int(duration / 1000))
        return {
            "width": width,
            "height": height,
            "bitrate": bitrate,
            "duration": duration,
            "framerate": framerate,
            "rotation": rotation,
            "size": size,
        }

    def _make_thumbnail(self, path):
        """Кадр для предпросмотра.

        Обычный путь Telegram упирается в MediaMetadataRetriever и возвращает null,
        поэтому берём кадр через собственный декодер."""
        try:
            helper = jclass("org.telegram.messenger.SendMessagesHelper")
        except Exception as exc:
            log(TAG + "SendMessagesHelper not found: " + str(exc))
            return None

        bitmap = self._first_frame(helper, path)
        if bitmap is None:
            return None

        try:
            cache_dir = jclass(
                "org.telegram.messenger.ApplicationLoader"
            ).applicationContext.getCacheDir()
            name = "gpp_thumb_" + str(int(time.time() * 1000)) + ".jpg"
            target = jclass("java.io.File")(cache_dir, name)
            stream = jclass("java.io.FileOutputStream")(target)
            try:
                bitmap.compress(
                    jclass("android.graphics.Bitmap$CompressFormat").JPEG, 80, stream
                )
            finally:
                stream.close()
            log(TAG + "thumbnail ready: " + str(target.getAbsolutePath()))
            return str(target.getAbsolutePath())
        except Exception as exc:
            log(TAG + "thumbnail save failed: " + str(exc))
            return None

    def _first_frame(self, helper, path):
        """Первый кадр видео.

        createVideoThumbnailAtTime с precise=true декодирует кадр тем же движком, что
        играет видео, поэтому работает и на файлах из picker'а."""
        try:
            bitmap = helper.createVideoThumbnailAtTime(str(path), 0, None, True)
        except Exception as exc:
            log(TAG + "thumbnail call failed: " + str(exc))
            bitmap = None
        if bitmap is not None:
            return bitmap

        try:
            method = helper.getMethod(
                "createVideoThumbnailAtTime",
                jclass("java.lang.String"),
                jclass("java.lang.Long").TYPE,
                jclass("[I"),
                jclass("java.lang.Boolean").TYPE,
            )
            bitmap = method.invoke(None, str(path), 0, None, True)
        except Exception as exc:
            log(TAG + "thumbnail reflect failed: " + str(exc))
            return None
        if bitmap is None:
            log(TAG + "thumbnail empty for " + str(path))
        return bitmap

    def _create_video_edited_info(self, path):
        """VideoEditedInfo для Telegram.

        Размеры результата равны исходным, поэтому перекодирования нет: видео уходит
        как есть. Конвертацию для этих путей пропускает needConvert-хук."""
        meta = self._read_video_meta(path)
        if meta is None:
            return None

        try:
            info = jclass("org.telegram.messenger.VideoEditedInfo")()
            info.originalPath = str(path)
            info.originalWidth = info.resultWidth = meta["width"]
            info.originalHeight = info.resultHeight = meta["height"]
            info.rotationValue = meta["rotation"]
            info.originalBitrate = info.bitrate = meta["bitrate"]
            info.originalDuration = info.estimatedDuration = meta["duration"]
            info.estimatedSize = meta["size"]
            info.startTime = -1
            info.endTime = -1
            info.avatarStartTime = -1
            info.roundVideo = False
            info.muted = False
        except Exception as exc:
            log(TAG + "VideoEditedInfo failed: " + str(exc))
            return None

        self._register_bypass(path)
        log(
            TAG + "video " + str(meta["width"]) + "x" + str(meta["height"])
            + " bitrate=" + str(meta["bitrate"])
            + " dur=" + str(meta["duration"])
            + " size=" + str(meta["size"])
        )
        return info

    # Больше путей в наборе держать незачем: облачное видео каждый раз
    # копируется в новый файл, и без ограничения набор рос бы бесконечно.
    BYPASS_PATHS_LIMIT = 64

    def _register_bypass(self, path):
        """Помечает путь как «конвертация не нужна» (см. needConvert-хук)."""
        path = str(path)
        paths = self._bypass_paths
        if paths is None:
            paths = self._bypass_paths = set()
        paths.add(path)
        if len(paths) > self.BYPASS_PATHS_LIMIT:
            paths.clear()
            paths.add(path)
