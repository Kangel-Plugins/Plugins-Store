__id__ = "media_transformer_ecubz"
__name__ = "Media Transformer"
__version__ = "9.0.4"
__author__ = "@eCubzBio - @eCubzPlugins"
__description__ = "Трансформирует видео в кружки, а аудиофайлы в голосовые сообщения. Поддерживает режим «Посмотреть один раз», нарезку длинных видео, меню предпросмотра и редактор медиа.\n\nTransforms videos into round videos and audio files into voice messages. Supports View Once, long-video splitting, send preview and the media editor."
__min_version__ = "12.8.1"
__icon__ = "eCubzPlugin/2"

import base64

from base_plugin import BasePlugin
from dalvik.system import InMemoryDexClassLoader
from java import dynamic_proxy
from java.nio import ByteBuffer
from org.telegram.messenger import ApplicationLoader
from org.telegram.messenger.browser import Browser
from ui.settings import Divider, Header, Input, Switch, Text

DEX_B64 = ""


STRINGS = {
    "ru": {
        "settings_header": "Настройки трансформации",
        "blur_enabled": "Размытие фона (Blur)",
        "plane_enabled": "Анимация самолетика",
        "text_enabled": "Водяной знак «ТГ»",
