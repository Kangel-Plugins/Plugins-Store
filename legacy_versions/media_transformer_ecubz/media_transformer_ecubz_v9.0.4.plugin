        "vignette_color": "Цвет виньетки",
        "vignette_alpha": "Прозрачность (%)",
        "crop_pos_title": "Автоматическое кадрирование",
        "crop_pos_h": "Смещение по горизонтали (%, 50 = центр)",
        "crop_pos_v": "Смещение по вертикали (%, 50 = центр)",
        "crop_pos_desc": "50% — строго центр. Меньше 50% сдвигает обрезку к верху/левому краю, больше 50% — к низу/правому краю. При ручном кадрировании используется ваш выбор.",
        "support_header": "Поддержка и разработка",
        "channel_title": "Канал eCubz Plugins",
        "channel_desc": "Официальные обновления и новые плагины",
        "donate_title": "Поддержать проект (Чаевые / Донат)",
        "donate_desc": "Пост с реквизитами для поддержки автора",
        "usage_title": "Как пользоваться:",
        "usage_text": "1. Выберите видео или аудио в галерее.\n2. Удерживайте кнопку «ОТПРАВИТЬ» и откройте «Просмотр и настройки».\n3. Удерживайте палец на медиа и выберите способ отправки.",
        "share_log": "Поделиться логом отладки",
        "debug_mode": "Режим отладки (Логирование)",
        "debug_mode_desc": "Запись отладочных логов в файл. При включении появляется кнопка отсылки лога.",
    },
    "en": {
        "settings_header": "Transformation Settings",
        "blur_enabled": "Background Blur",
        "plane_enabled": "Plane Animation",
        "text_enabled": "Watermark «TG»",
        "waveform_enabled": "Voice Waveform (Spectrum)",
        "vignette_header": "Vignette Customization",
        "vignette_color": "Vignette Color",
        "vignette_alpha": "Vignette Alpha (%)",
        "crop_pos_title": "Automatic Crop Settings",
        "crop_pos_h": "Horizontal offset (%, 50 = center)",
        "crop_pos_v": "Vertical offset (%, 50 = center)",
        "crop_pos_desc": "50% is exact center. Values below 50% shift towards top/left; values above 50% shift towards bottom/right. Manual crop overrides this.",
        "support_header": "Support & Development",
        "channel_title": "eCubz Plugins Channel",
        "channel_desc": "Official updates and new plugins",
        "donate_title": "Support project (Tips / Donate)",
        "donate_desc": "Post with payment details to support the author",
        "usage_title": "How to use:",
        "usage_text": "1. Select video or audio in the gallery.\n2. Hold the SEND button and open Preview and settings.\n3. Hold the media and choose a send mode.",
        "share_log": "Share Debug Log",
        "debug_mode": "Debug Mode (Logging)",
        "debug_mode_desc": "Save debug logs to file. Enables report sharing when turned on.",
    },
}


def get_strings():
    try:
        from java.util import Locale

        language = Locale.getDefault().getLanguage()
    except Exception:
        language = "en"
    return STRINGS["ru"] if language and language.startswith("ru") else STRINGS["en"]


class Plugin(BasePlugin):
    def on_plugin_load(self):
        self.dex_class = None
        self.dex_loader = None
        try:
            dex_bytes = base64.b64decode(DEX_B64)
            parent = ApplicationLoader.applicationContext.getClassLoader()
            self.dex_loader = InMemoryDexClassLoader(ByteBuffer.wrap(dex_bytes), parent)
            self.dex_class = self.dex_loader.loadClass(
                "ru.ecubz.mediatransformer.MediaTransformer"
            )
            self._sync_dex_settings()
            self.dex_class.getMethod("start").invoke(None)
            self.log("Media Transformer DEX загружен")
        except Exception as error:
            self.log(f"Ошибка загрузки Media Transformer DEX: {error}")

    def on_plugin_unload(self):
        try:
            if self.dex_class is not None:
                self.dex_class.getMethod("stop").invoke(None)
        except Exception as error:
            self.log(f"Ошибка выгрузки Media Transformer DEX: {error}")
        self.dex_class = None
        self.dex_loader = None

    def _sync_dex_settings(self, *args):
        try:
            if self.dex_class is not None:
                self.dex_class.getMethod("syncSettings").invoke(None)
        except Exception as error:
            self.log(f"Ошибка синхронизации настроек DEX: {error}")

    def _share_log(self):
        try:
            from client_utils import get_last_fragment
            from hook_utils import find_class

            fragment = get_last_fragment()
            activity = fragment.getParentActivity() if fragment else None
            if self.dex_class is not None:
                self.dex_class.getMethod("shareLogFile", find_class("java.lang.Object")).invoke(None, activity)
        except Exception as error:
            self.log(f"Ошибка шеринга лога: {error}")

    def _refresh_ui(self):
        try:
            from com.exteragram.messenger.plugins import PluginsController

            PluginsController.getInstance().loadPluginSettings(self.id)
        except Exception:
            pass

    def _open_color_picker(self):
        from client_utils import get_last_fragment
        from hook_utils import find_class
        from org.telegram.ui.ActionBar import AlertDialog

        activity = get_last_fragment().getParentActivity()
        color_picker_class = find_class("org.telegram.ui.Components.ColorPicker")

        current_hex = str(self.get_setting("vignette_color_hex", "#000000"))
        try:
            current_color = int(current_hex.replace("#", ""), 16) | 0xFF000000
        except Exception:
            current_color = 0xFF000000

        delegate_type = color_picker_class.ColorPickerDelegate
        plugin = self

        class ColorDelegate(dynamic_proxy(delegate_type)):
            def __init__(self):
                super().__init__()

            def setColor(self, color, num, apply_now):
                if apply_now:
                    plugin.set_setting(
                        "vignette_color_hex",
                        f"#{color & 0xFFFFFF:06X}",
                    )
                    plugin._sync_dex_settings()
                    plugin._refresh_ui()

            def getDefaultColor(self, num):
                return current_color

            def openThemeCreate(self, share):
                pass

            def deleteTheme(self):
                pass

            def rotateColors(self):
                pass

            def hasChanges(self):
                return True

        picker = color_picker_class(activity, False, ColorDelegate())
        builder = AlertDialog.Builder(activity)
        builder.setTitle(get_strings()["vignette_color"])
        builder.setView(picker)
        builder.setPositiveButton("OK", None)
        builder.show()

    def _is_debug_mode(self):
        try:
            if self.dex_class is not None:
                return bool(self.dex_class.getMethod("isDebugMode").invoke(None))
        except Exception:
            pass
        return False

    def open_channel(self, view=None):
        try:
            Browser.openUrl(
                ApplicationLoader.applicationContext, "https://t.me/eCubzPlugins"
            )
        except Exception:
            pass

    def open_donate(self, view=None):
        try:
            Browser.openUrl(
                ApplicationLoader.applicationContext, "https://t.me/eCubzPlugins/29"
            )
        except Exception:
            pass

    def create_settings(self):
        strings = get_strings()
        color = str(self.get_setting("vignette_color_hex", "#000000"))
        sync = lambda *args: self._sync_dex_settings()
        items = [
            Header(text=strings["settings_header"]),
            Switch(
                key="round_blur_enabled",
                text=strings["blur_enabled"],
                default=self.get_setting("round_blur_enabled", True),
                icon="msg_preview_blur",
                on_change=sync,
            ),
            Switch(
                key="round_plane_enabled",
                text=strings["plane_enabled"],
                default=self.get_setting("round_plane_enabled", True),
                icon="msg_send",
                on_change=sync,
            ),
            Switch(
                key="round_text_enabled",
                text=strings["text_enabled"],
                default=self.get_setting("round_text_enabled", True),
                icon="msg_edit",
                on_change=sync,
            ),
            Switch(
                key="voice_waveform_enabled",
                text=strings["waveform_enabled"],
                default=self.get_setting("voice_waveform_enabled", True),
                icon="msg_audio",
                on_change=sync,
            ),
            Divider(),
            Header(text=strings["vignette_header"]),
            Text(
                text=f"{strings['vignette_color']}: {color}",
                icon="menu_select_quote_solar",
                accent=True,
                on_click=lambda *args: self._open_color_picker(),
            ),
            Input(
                key="vignette_alpha_perc",
                text=strings["vignette_alpha"],
                default=str(self.get_setting("vignette_alpha_perc", "25")),
                icon="msg_preview_blur",
                on_change=sync,
            ),
            Divider(),
            Header(text=strings["crop_pos_title"]),
            Input(
                key="crop_pct_h",
                text=strings["crop_pos_h"],
                default=str(self.get_setting("crop_pct_h", "50")),
                icon="msg_select",
                on_change=sync,
            ),
            Input(
                key="crop_pct_v",
                text=strings["crop_pos_v"],
                default=str(self.get_setting("crop_pct_v", "50")),
                icon="msg_select",
                on_change=sync,
            ),
            Divider(text=strings["crop_pos_desc"]),
            Divider(),
            Header(text=strings["support_header"]),
            Text(
                text=strings["channel_title"],
                subtext=strings["channel_desc"],
                icon="msg_channel",
                accent=True,
                on_click=self.open_channel,
            ),
            Text(
                text=strings["donate_title"],
                subtext=strings["donate_desc"],
                icon="msg_link",
                accent=True,
                on_click=self.open_donate,
            ),
        ]

        debug_enabled = self.get_setting("debug_mode_enabled", False)
        on_debug_change = lambda val: (sync(), self._refresh_ui())
        debug_header = "Отладка" if strings == STRINGS["ru"] else "Debugging"

        items.extend([
            Divider(),
            Header(text=debug_header),
            Switch(
                key="debug_mode_enabled",
                text=strings["debug_mode"],
                default=debug_enabled,
                icon="msg_log",
                on_change=on_debug_change,
            ),
        ])

        if debug_enabled or self._is_debug_mode():
            items.append(
                Text(
                    text=strings["share_log"],
                    icon="msg_share",
                    accent=True,
                    on_click=lambda *args: self._share_log(),
                )
            )

        items.extend([
            Divider(text=strings["debug_mode_desc"]),
            Divider(),
            Header(text=strings["usage_title"]),
            Divider(text=strings["usage_text"]),
        ])
        return items
