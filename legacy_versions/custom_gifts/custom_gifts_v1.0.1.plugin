)
_LOCK = _threading.RLock()
_NAMESPACE = None


def _decode_base122(value):
    output = bytearray()
    current = offset = 0

    def push7(bits):
        nonlocal current, offset
        bits <<= 1
        current |= bits >> offset
        offset += 7
        if offset >= 8:
            output.append(current & 255)
            offset -= 8
            current = (bits << (7 - offset)) & 255

    for char in value:
        code = ord(char)
        if code > 127:
            illegal = (code >> 8) & 7
            if illegal != 7:
                push7(_BASE122_ILLEGAL[illegal])
            push7(code & 127)
        else:
            push7(code)
    return bytes(output)


def _root():
    try:
        from java import jclass
        context = jclass("org.telegram.messenger.ApplicationLoader").applicationContext
        base = str(context.getFilesDir().getAbsolutePath())
    except Exception:
        base = _tempfile.gettempdir()
    target = _os.path.join(base, "pak", __id__, _BUNDLE_SHA256)
    _os.makedirs(_os.path.dirname(target), exist_ok=True)
    return target


def _unpack():
    target = _root()
    if _os.path.isfile(_os.path.join(target, "main.py")):
        return target
    stage = target + ".extracting"
    cache_parent = _os.path.dirname(target)
    _os.makedirs(cache_parent, exist_ok=True)

    for name in _os.listdir(cache_parent):
        previous = _os.path.join(cache_parent, name)
        if previous != target and _os.path.isdir(previous):
            _shutil.rmtree(previous, ignore_errors=True)
    _shutil.rmtree(stage, ignore_errors=True)
    _os.makedirs(stage)
    try:
        compressed = _decode_base122("".join(_PAYLOAD))
        with _zipfile.ZipFile(_io.BytesIO(_lzma.decompress(compressed))) as archive:
            root = _os.path.realpath(stage)
            for member in archive.infolist():
                path = _os.path.realpath(_os.path.join(root, member.filename))
                if path != root and not path.startswith(root + _os.sep):
                    raise RuntimeError("Unsafe path in packed plugin")
            archive.extractall(stage)
        if not _os.path.isfile(_os.path.join(stage, "main.py")):
            raise RuntimeError("Packed project has no main.py")
        try:
            _os.replace(stage, target)
        except FileExistsError:
            _shutil.rmtree(stage, ignore_errors=True)
    except Exception:
        _shutil.rmtree(stage, ignore_errors=True)
        raise
    return target


def _purge_previous_bundle_modules():
    parents = {_os.path.realpath(_os.path.dirname(_root()))}
    try:
        from java import jclass
        context = jclass("org.telegram.messenger.ApplicationLoader").applicationContext
        cache = str(context.getCacheDir().getAbsolutePath())
        parents.add(_os.path.realpath(_os.path.join(cache, "chaquopy", "tmp", "pak", __id__)))
    except Exception:
        pass
    prefixes = tuple(parent + _os.sep for parent in parents)
    for name, module in list(_sys.modules.items()):
        source = getattr(module, "__file__", None)
        if not source:
            continue
        try:
            source = _os.path.realpath(source)
        except Exception:
            continue
        if source.startswith(prefixes):
            _sys.modules.pop(name, None)


def _project():
    global _NAMESPACE
    with _LOCK:
        if _NAMESPACE is None:
            root = _unpack()
            _purge_previous_bundle_modules()
            if root not in _sys.path:
                _sys.path.insert(0, root)
            _NAMESPACE = _runpy.run_path(_os.path.join(root, "main.py"), run_name="__packed_main__")
        return _NAMESPACE


class PackedPlugin(BasePlugin):
    def _call(self, name, *args):
        callback = _project().get(name)
        return callback(self, *args) if callable(callback) else None

    def on_plugin_load(self): return self._call("on_plugin_load")
    def on_plugin_unload(self): return self._call("on_plugin_unload")
    def on_app_event(self, event_type): return self._call("on_app_event", event_type)
    def on_send_message_hook(self, account, params): return self._call("on_send_message_hook", account, params)
    def pre_request_hook(self, request_name, account, request): return self._call("pre_request_hook", request_name, account, request)

    def create_settings(self):
        result = self._call("create_settings")
        return [] if result is None else result
