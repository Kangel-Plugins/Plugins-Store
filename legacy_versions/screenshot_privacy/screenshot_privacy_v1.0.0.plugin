def _gen_random_phrase() -> str:
    if _language() == "en":
        return f"{random.choice(_RAND_ADJ_EN)} {random.choice(_RAND_NOUN_EN)}"
    return f"{random.choice(_RAND_ADJ)} {random.choice(_RAND_NOUN)}"


def _gen_random_alnum(length: int = 7) -> str:
    return "".join(random.choice(_ALNUM_CHARS) for _ in range(length))

_FIELD_CACHE: Dict[tuple, Any] = {}
_FIELD_MISSING = object()


def _resolve_field(obj: Any, field_name: str) -> Any:
    cls = obj.getClass()
    key = (str(cls.getName()), field_name)
    cached = _FIELD_CACHE.get(key)
    if cached is not None:
        return None if cached is _FIELD_MISSING else cached

    cur = cls
    while cur is not None:
        try:
            f = cur.getDeclaredField(field_name)
            f.setAccessible(True)
            if len(_FIELD_CACHE) > 256:
                _FIELD_CACHE.clear()
            _FIELD_CACHE[key] = f
            return f
        except Exception:
            cur = cur.getSuperclass()

    if len(_FIELD_CACHE) > 256:
        _FIELD_CACHE.clear()
    _FIELD_CACHE[key] = _FIELD_MISSING
    return None


def _safe_get(obj: Any, field_name: str, default: Any = None) -> Any:
    if obj is None:
        return default
    try:
        f = _resolve_field(obj, field_name)
        if f is None:
            return default
        val = f.get(obj)
        return default if val is None else val
    except Exception:
        return default


def _safe_set(obj: Any, field_name: str, value: Any) -> bool:
    if obj is None:
        return False
    try:
        f = _resolve_field(obj, field_name)
        if f is None:
            return False
        ftype = str(f.getType().getName())
        if ftype == "int":
            f.setInt(obj, jint(int(value)))
        elif ftype == "long":
            f.setLong(obj, jlong(int(value)))
        elif ftype == "boolean":
            f.setBoolean(obj, jboolean(bool(value)))
        elif ftype == "float":
            f.setFloat(obj, jfloat(float(value)))
        else:
            f.set(obj, value)
        return True
    except Exception:
        return False


def _extract_dominant_color(bmp: Any) -> Optional[int]:
    """
    Быстрое извлечение основного цвета из Bitmap (включая HARDWARE-битмапы Android 8+).
    Рисует исходный Bitmap в крошечный ARGB_8888 12x12 и выбирает доминирующий цветовой бакет.
    """
    if bmp is None:
        return None
    sample_bmp = None
    try:
        if bmp.isRecycled():
            return None
        w = bmp.getWidth()
        h = bmp.getHeight()
        if w <= 0 or h <= 0:
            return None

        size = 12
        sample_bmp = Bitmap.createBitmap(size, size, Bitmap.Config.ARGB_8888)
        canvas = Canvas(sample_bmp)
        paint = Paint(Paint.FILTER_BITMAP_FLAG)
        from android.graphics import Rect
        canvas.drawBitmap(bmp, Rect(0, 0, w, h), Rect(0, 0, size, size), paint)

        buckets: Dict[int, List[int]] = {}
        for y in range(size):
            for x in range(size):
                px = sample_bmp.getPixel(x, y)
                a = (px >> 24) & 0xFF
                if a < 128:
                    continue
                r = (px >> 16) & 0xFF
                g = (px >> 8) & 0xFF
                b = px & 0xFF

                mx = max(r, g, b)
                mn = min(r, g, b)
                sat = mx - mn
                if sat > 24 and 28 < mx < 248:
                    weight = 6
                elif 28 < mx < 245:
                    weight = 2
                else:
                    weight = 1

                key = ((r >> 4) << 8) | ((g >> 4) << 4) | (b >> 4)
                entry = buckets.get(key)
                if entry is None:
                    buckets[key] = [weight, r * weight, g * weight, b * weight]
                else:
                    entry[0] += weight
                    entry[1] += r * weight
                    entry[2] += g * weight
                    entry[3] += b * weight

        if not buckets:
            return None

        best = max(buckets.values(), key=lambda e: e[0])
        total_w = max(1, best[0])
        ar = min(255, max(0, best[1] // total_w))
        ag = min(255, max(0, best[2] // total_w))
        ab = min(255, max(0, best[3] // total_w))
        return Color.argb(255, ar, ag, ab)
    except Exception:
        return None
    finally:
        if sample_bmp is not None:
            try:
                sample_bmp.recycle()
            except Exception:
                pass


def _extract_bitmap_from_image_receiver(image_receiver: Any) -> Any:
    if image_receiver is None:
        return None
    try:
        bmp = image_receiver.getBitmap()
        if bmp is not None and not bmp.isRecycled():
            return bmp
    except Exception:
        pass
    try:
        drawable = image_receiver.getDrawable()
        if drawable is not None and hasattr(drawable, "getBitmap"):
            bmp = drawable.getBitmap()
            if bmp is not None and not bmp.isRecycled():
                return bmp
    except Exception:
        pass
    return None


def _get_peer_display_parts(account: int, peer_id: int, user: Any = None, chat: Any = None) -> tuple:
    """Возвращает (first_name, last_name) для генерации дефолтной аватарки с буквой."""
    try:
        if user is not None:
            fn = getattr(user, "first_name", None) or ""
            ln = getattr(user, "last_name", None) or ""
            if fn or ln:
                return (fn, ln)
        if chat is not None:
            title = getattr(chat, "title", None) or ""
            if title:
                return (title, "")
        mc = MessagesController.getInstance(account)
        if mc is not None and peer_id != 0:
            if peer_id > 0:
                u = mc.getUser(jlong(peer_id))
                if u is not None:
                    return (getattr(u, "first_name", None) or "", getattr(u, "last_name", None) or "")
            else:
                c = mc.getChat(jlong(-peer_id))
                if c is not None:
                    return (getattr(c, "title", None) or "", "")
    except Exception:
        pass
    return ("U", "")

_ScreenCaptureCallbackProxy = None
_PixelCopyListenerProxy = None
_MediaContentObserverProxy = None
_MAIN_HANDLER = None


def _get_main_handler():
    global _MAIN_HANDLER
    if _MAIN_HANDLER is None:
        _MAIN_HANDLER = Handler(Looper.getMainLooper())
    return _MAIN_HANDLER


def _ensure_pixel_copy_proxy():
    global _PixelCopyListenerProxy
    if _PixelCopyListenerProxy is not None:
        return _PixelCopyListenerProxy
    if Build.VERSION.SDK_INT < 24:
        return None

    @java_subclass(JObject, PixelCopy.OnPixelCopyFinishedListener)
    class _PyPixelCopyListener(Base):
        def __init__(self, fn):
            self._fn = fn

        @joverride()
        def onPixelCopyFinished(self, copyResult):
            cb = self._fn
            self._fn = None
            if cb is not None:
                try:
                    cb(int(copyResult))
                except Exception:
                    pass
            try:
                self.jrelease()
            except Exception:
                pass

    _PixelCopyListenerProxy = _PyPixelCopyListener
    return _PixelCopyListenerProxy


def _ensure_screen_capture_proxy():
    global _ScreenCaptureCallbackProxy
    if _ScreenCaptureCallbackProxy is not None:
        return _ScreenCaptureCallbackProxy
    if Build.VERSION.SDK_INT < 34:
        return None
    try:
        ActivityClass = find_class("android.app.Activity")
        ScreenCaptureCallbackClass = find_class("android.app.Activity$ScreenCaptureCallback")
        if ScreenCaptureCallbackClass is None:
            return None

        @java_subclass(JObject, ScreenCaptureCallbackClass)
        class _PyScreenCaptureCallback(Base):
            def __init__(self, plugin):
                self._plugin = plugin

            @joverride()
            def onScreenCaptured(self):
                if self._plugin is not None:
                    self._plugin._on_system_screenshot_detected(source="android14_callback")

        _ScreenCaptureCallbackProxy = _PyScreenCaptureCallback
        return _ScreenCaptureCallbackProxy
    except Exception:
        return None


def _ensure_content_observer_proxy():
    global _MediaContentObserverProxy
    if _MediaContentObserverProxy is not None:
        return _MediaContentObserverProxy
    try:
        @java_subclass(ContentObserver)
        class _PyScreenshotContentObserver(Base):
            def __init__(self, handler, plugin):
                self._plugin = plugin

            @joverload("onChange", ["boolean"])
            def on_change_simple(self, self_change):
                if self._plugin is not None:
                    self._plugin._check_latest_mediastore_screenshot(None)

            @joverload("onChange", ["boolean", "android.net.Uri"])
            def on_change_uri(self, self_change, uri):
                if self._plugin is not None:
                    self._plugin._check_latest_mediastore_screenshot(uri)

        _MediaContentObserverProxy = _PyScreenshotContentObserver
        return _MediaContentObserverProxy
    except Exception:
        return None


class _ScreenshotNotificationDelegate:
    pass


def _create_notification_delegate(plugin: "ScreenshotPrivacyPlugin"):
    @java_subclass(JObject, NotificationCenter.NotificationCenterDelegate)
    class _PyNotificationDelegate(Base):
        def __init__(self, plg):
            self._plugin = plg

        @joverride()
        def didReceivedNotification(self, notif_id, account, args):
            try:
                if int(notif_id) == NotificationCenter.screenshotTook and self._plugin is not None:
                    self._plugin._on_system_screenshot_detected(source="notification_center")
            except Exception:
                pass

    return _PyNotificationDelegate.new_instance(init_args=[plugin])


class _AuthorNameHook(MethodHook):
    def __init__(self, plugin: "ScreenshotPrivacyPlugin"):
        self.plugin = plugin

    def after_hooked_method(self, param):
        if not self.plugin._masking_active or not self.plugin.get_setting("hide_nicknames", True):
            return
        try:
            cell = param.thisObject
            user = _safe_get(cell, "currentUser")
            chat = _safe_get(cell, "currentChat")
            msg = _safe_get(cell, "currentMessageObject")
            peer_id = 0
            if user is not None:
                peer_id = int(getattr(user, "id", 0) or 0)
            elif chat is not None:
                peer_id = -int(getattr(chat, "id", 0) or 0)
            elif msg is not None:
                peer_id = int(msg.getFromChatId() or 0)
            param.setResult(self.plugin.get_masked_name(peer_id))
        except Exception:
            pass


class _ReplyNameFromDialogIdHook(MethodHook):
    def __init__(self, plugin: "ScreenshotPrivacyPlugin"):
        self.plugin = plugin

    def after_hooked_method(self, param):
        if not self.plugin._masking_active or not self.plugin.get_setting("hide_reply_names", True):
            return
        try:
            original = param.getResult()
            if original is None:
                return
            peer_id = int(param.args[0] or 0)
            param.setResult(self.plugin.get_masked_name(peer_id))
        except Exception:
            pass


class _AuthorStatusHook(MethodHook):
