_DESCRIPTION = (
    "Нативно скрывает никнеймы, время сообщений, аватарки (заливка в основной цвет "
    "или дефолтная аватарка с буквой), закреп и тэги участников при скриншоте диалога."
)

_language_choice = 0
_language_cache = (0.0, "en")


def _language_index(value: Any) -> int:
    try:
        index = int(value)
        return index if index in (0, 1, 2) else 0
    except (ValueError, TypeError):
        return {"ru": 1, "en": 2}.get(str(value).lower(), 0)


def _language() -> str:
    global _language_cache
    if _language_choice in (1, 2):
        return "ru" if _language_choice == 1 else "en"
    now = time.monotonic()
    if now - _language_cache[0] < 1.0:
        return _language_cache[1]
    language = ""
    try:
        locale = LocaleController.getInstance().getCurrentLocale()
        if locale is not None:
            language = str(locale.getLanguage() or "")
    except Exception:
        pass
    if not language:
        try:
            locale = find_class("android.content.res.Resources").getSystem().getConfiguration().locale
            language = str(locale.getLanguage() or "")
        except Exception:
            try:
                language = str(find_class("java.util.Locale").getDefault().getLanguage() or "")
            except Exception:
                language = "en"
    resolved = "ru" if language.lower().startswith("ru") else "en"
    _language_cache = (now, resolved)
    return resolved


