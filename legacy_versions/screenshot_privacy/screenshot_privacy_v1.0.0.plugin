class _AuthorVerificationHook(MethodHook):
    def __init__(self, plugin: "ScreenshotPrivacyPlugin"):
        self.plugin = plugin

    def before_hooked_method(self, param):
        if not self.plugin._masking_active:
            return
        if self.plugin.get_setting("hide_statuses", True) or self.plugin.get_setting("hide_nicknames", True):
