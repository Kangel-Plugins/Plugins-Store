class _TouchPreMaskHook(MethodHook):
    """Мгновенно включает предмаскировку при касании экрана 3 пальцами (жест скриншота)."""
    def __init__(self, plugin: "ScreenshotPrivacyPlugin"):
        self.plugin = plugin

    def before_hooked_method(self, param):
        if self.plugin._masking_active or self.plugin._capturing_now:
            return
        try:
            ev = param.args[0]
            if ev is None:
                return
            if ev.getActionMasked() != MotionEvent.ACTION_POINTER_DOWN:
                return
            if ev.getPointerCount() < 3:
                return
            self.plugin.on_three_finger_gesture()
        except Exception:
            pass


class _ChatAvatarContainerTitleIconsHook(MethodHook):
    def __init__(self, plugin: "ScreenshotPrivacyPlugin"):
        self.plugin = plugin

    def before_hooked_method(self, param):
        if not self.plugin._masking_active:
            return
        if self.plugin.get_setting("hide_statuses", True) or self.plugin.get_setting("hide_header_name", True):
            if param.args and len(param.args) >= 2:
                param.args[0] = None
                param.args[1] = None


class _PinnedMessageViewHook(MethodHook):
    def __init__(self, plugin: "ScreenshotPrivacyPlugin"):
        self.plugin = plugin

    def before_hooked_method(self, param):
        if not self.plugin._masking_active or not self.plugin.get_setting("hide_pinned", True):
            return
        try:
            chat_activity = param.thisObject
            ChatActivityClass = chat_activity.getClass()
            hide_method = ChatActivityClass.getDeclaredMethod("hidePinnedMessageView", JBoolean.TYPE)
            hide_method.setAccessible(True)
            hide_method.invoke(chat_activity, False)
            param.setResult(None)
        except Exception:
            try:
                pinned_view = _safe_get(param.thisObject, "pinnedMessageView")
                if pinned_view is not None:
                    pinned_view.setVisibility(View.GONE)
                    param.setResult(None)
            except Exception:
                pass


def _build_plugin_icon_bitmap(size: int = 192) -> Any:
    """
    Генерирует векторно-чёткую нативную иконку для Screenshot Privacy:
    фирменный сине-фиолетовый градиент, рамка кадра скриншота и перечёркнутый глаз.
    """
    bmp = Bitmap.createBitmap(size, size, Bitmap.Config.ARGB_8888)
    canvas = Canvas(bmp)
    s = float(size)

    bg_paint = Paint(Paint.ANTI_ALIAS_FLAG)
    bg_paint.setShader(
        LinearGradient(
            0.0,
            0.0,
            s,
            s,
            jint(Color.rgb(0x3E, 0x7B, 0xFA)),
            jint(Color.rgb(0x7B, 0x4D, 0xFF)),
            Shader.TileMode.CLAMP,
        )
    )
    canvas.drawRect(0.0, 0.0, s, s, bg_paint)

    glow_paint = Paint(Paint.ANTI_ALIAS_FLAG)
    glow_paint.setColor(jint(Color.argb(0x24, 0xFF, 0xFF, 0xFF)))
    canvas.drawCircle(s * 0.28, s * 0.22, s * 0.42, glow_paint)

    white = jint(Color.rgb(0xFF, 0xFF, 0xFF))

    stroke_paint = Paint(Paint.ANTI_ALIAS_FLAG)
    stroke_paint.setColor(white)
    stroke_paint.setStyle(Paint.Style.STROKE)
    stroke_paint.setStrokeWidth(s * 0.068)
    stroke_paint.setStrokeCap(Paint.Cap.ROUND)
    stroke_paint.setStrokeJoin(Paint.Join.ROUND)

    m = s * 0.19
    arm = s * 0.15
    p = Path()
    p.moveTo(m, m + arm)
    p.lineTo(m, m)
    p.lineTo(m + arm, m)
    p.moveTo(s - m - arm, m)
    p.lineTo(s - m, m)
    p.lineTo(s - m, m + arm)
    p.moveTo(m, s - m - arm)
    p.lineTo(m, s - m)
    p.lineTo(m + arm, s - m)
    p.moveTo(s - m - arm, s - m)
    p.lineTo(s - m, s - m)
    p.lineTo(s - m, s - m - arm)
    canvas.drawPath(p, stroke_paint)

    eye_paint = Paint(Paint.ANTI_ALIAS_FLAG)
    eye_paint.setColor(white)
    eye_paint.setStyle(Paint.Style.STROKE)
    eye_paint.setStrokeWidth(s * 0.062)
    eye_paint.setStrokeCap(Paint.Cap.ROUND)
    eye_paint.setStrokeJoin(Paint.Join.ROUND)

    cx = s * 0.5
    cy = s * 0.5
    ew = s * 0.21
    eh = s * 0.14
    eye_path = Path()
    eye_path.moveTo(cx - ew, cy)
    eye_path.quadTo(cx, cy - eh * 1.45, cx + ew, cy)
    eye_path.quadTo(cx, cy + eh * 1.45, cx - ew, cy)
    canvas.drawPath(eye_path, eye_paint)

    pupil_paint = Paint(Paint.ANTI_ALIAS_FLAG)
    pupil_paint.setColor(white)
    pupil_paint.setStyle(Paint.Style.FILL)
    canvas.drawCircle(cx, cy, s * 0.062, pupil_paint)

    slash_bg = Paint(Paint.ANTI_ALIAS_FLAG)
    slash_bg.setColor(jint(Color.rgb(0x5D, 0x64, 0xFC)))
    slash_bg.setStyle(Paint.Style.STROKE)
    slash_bg.setStrokeWidth(s * 0.115)
    slash_bg.setStrokeCap(Paint.Cap.ROUND)
    canvas.drawLine(cx - s * 0.17, cy + s * 0.17, cx + s * 0.17, cy - s * 0.17, slash_bg)

    canvas.drawLine(cx - s * 0.17, cy + s * 0.17, cx + s * 0.17, cy - s * 0.17, eye_paint)
    return bmp


_ICON_BITMAP_CACHE = None


def _get_plugin_icon_bitmap():
    global _ICON_BITMAP_CACHE
    try:
        if _ICON_BITMAP_CACHE is None or _ICON_BITMAP_CACHE.isRecycled():
            _ICON_BITMAP_CACHE = _build_plugin_icon_bitmap(192)
    except Exception:
        return None
    return _ICON_BITMAP_CACHE


class _ChatActionCellDrawHook(MethodHook):
    def __init__(self, plugin: "ScreenshotPrivacyPlugin"):
        self.plugin = plugin

    def before_hooked_method(self, param):
        if not self.plugin._masking_active or not self.plugin.get_setting("hide_date_headers", False):
            return
        try:
            cell = param.thisObject
            msg = cell.getMessageObject()
            if msg is not None and int(getattr(msg, "type", -1)) == 101:
                param.setResult(None)
        except Exception:
            pass


class _AvatarOnlineHook(MethodHook):
    def __init__(self, plugin: "ScreenshotPrivacyPlugin"):
        self.plugin = plugin

    def before_hooked_method(self, param):
        if not self.plugin._masking_active:
            return
        if self.plugin.get_setting("hide_avatars", True) or self.plugin.get_setting("hide_statuses", True):
            try:
                canvas = param.args[0]
                image_receiver = param.args[1]
                if image_receiver is not None and canvas is not None:
                    image_receiver.draw(canvas)
                param.setResult(None)
            except Exception:
                pass


class _AvatarsDrawableDrawHook(MethodHook):
    def __init__(self, plugin: "ScreenshotPrivacyPlugin", chat_msg_cell_cls: Any):
        self.plugin = plugin
        self.chat_msg_cell_cls = chat_msg_cell_cls

    def before_hooked_method(self, param):
        avd = param.thisObject
        if avd is None:
            return
        should_mask = self.plugin._masking_active and self.plugin.get_setting("hide_avatars", True)
        if not should_mask and not self.plugin._masked_avds:
            return
        try:
            if should_mask:
                parent = _safe_get(avd, "parent")
                if parent is not None and self.chat_msg_cell_cls is not None and isinstance(parent, self.chat_msg_cell_cls):
                    self.plugin.mask_avatars_drawable(avd, parent)
            else:
                self.plugin.restore_avatars_drawable_if_needed(avd)
        except Exception:
            pass


class _PluginCellIconHook(MethodHook):
    def __init__(self, plugin_id: str):
        self.plugin_id = plugin_id

    def after_hooked_method(self, param):
        try:
            cell = param.thisObject
            plg = _safe_get(cell, "plugin")
            if plg is None or str(plg.getId() or "") != self.plugin_id:
                return
            img_view = _safe_get(cell, "imageView")
            if img_view is None:
                return
            bmp = _get_plugin_icon_bitmap()
            if bmp is None:
                return
            try:
                img_view.setAnimatedEmojiDrawable(None)
            except Exception:
                pass
            try:
                ir = img_view.getImageReceiver()
                if ir is not None:
                    ir.clearImage()
            except Exception:
                pass
            img_view.setImageBitmap(bmp)
            img_view.invalidate()
        except Exception:
            pass

class ScreenshotPrivacyPlugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self._masking_active: bool = False
        self._premask_active: bool = False
        self._premask_token: int = 0
        self._capturing_now: bool = False
        self._last_screenshot_ts: float = 0.0
        self._ignore_observer_until: float = 0.0
        self._dominant_color_cache: Dict[int, int] = {}
        self._random_color_cache: Dict[int, int] = {}
        self._container_stories_flag: Dict[int, bool] = {}
        self._container_subtitle_visible: Dict[int, bool] = {}
        self._alias_map: Dict[int, str] = {}
        self._mention_alias_map: Dict[Any, str] = {}
        self._header_random_cache: Dict[Any, str] = {}
        self._masked_avds: Dict[int, Any] = {}
        self._masked_mentions: Dict[int, Any] = {}
        self._alias_counter: int = 0
        self._mention_alias_counter: int = 0

        self._menu_toggle_id: Optional[str] = None
        self._menu_capture_id: Optional[str] = None

        self._notif_delegate: Optional[_ScreenshotNotificationDelegate] = None
        self._notif_accounts: List[int] = []
        self._screen_capture_cb: Any = None
        self._registered_activity: Any = None
        self._content_observer: Any = None
        self._last_mediastore_uri: Any = None

        self._app_in_foreground: bool = True
        self._last_resume_mono: float = time.monotonic()
        self._last_resume_ms: int = int(time.time() * 1000)
        self._seen_mediastore_ids: set = set()
        self._max_seen_mediastore_id: int = 0

    def _set_masking_active(self, active: bool):
        self._masking_active = bool(active)

    def _sync_default_placeholders(self):
        nick_ph = (self.get_setting("nickname_placeholder", "") or "").strip()
        if nick_ph in ("Пользователь", "User"):
            self.set_setting("nickname_placeholder", _t("Пользователь"), reload_settings=False)
        hdr_ph = (self.get_setting("header_placeholder", "") or "").strip()
        if hdr_ph in ("Собеседник", "Contact"):
            self.set_setting("header_placeholder", _t("Собеседник"), reload_settings=False)

    def on_plugin_load(self):
        global _language_choice
        _language_choice = _language_index(self.get_setting("language", 0))
        self._sync_description()
        self._sync_default_placeholders()
        self._set_masking_active(bool(self.get_setting("manual_masking", False)))

        self._app_in_foreground = True
        self._last_resume_mono = time.monotonic()
        self._last_resume_ms = int(time.time() * 1000)
        self._snapshot_latest_mediastore_id()

        self._install_hooks()
        self._sync_menu_items()
        self._register_screenshot_detectors()

    def _sync_description(self):
        try:
            pc = find_class("com.exteragram.messenger.plugins.PluginsController")
            if pc is not None:
                plugin = pc.getInstance().getPlugins().get(__id__)
                if plugin is not None:
                    plugin.setDescription(_t(_DESCRIPTION))
        except Exception:
            pass

    def _language_changed(self, value: Any = None, *_):
        global _language_choice
        _language_choice = _language_index(value if value is not None else self.get_setting("language", 0))
        self._sync_default_placeholders()
        self.set_setting("language", _language_choice, reload_settings=True)
        self._sync_description()
        self._sync_menu_items()
        self._alias_map.clear(); self._mention_alias_map.clear()
        self._header_random_cache.clear()
        self._alias_counter = 0; self._mention_alias_counter = 0
        self._refresh_if_active()

    def on_plugin_unload(self):
        global _ICON_BITMAP_CACHE
        was_active = self._masking_active
        self._set_masking_active(False)
        self._premask_active = False
        self._premask_token += 1
        if was_active:
            self.set_setting("manual_masking", False)
            run_on_ui_thread(self._refresh_current_chat)

        self._unregister_screenshot_detectors()
        self._remove_menu_items()
        self.restore_all_masked_avds()
        self.restore_all_masked_mentions()
        self._dominant_color_cache.clear()
        self._container_stories_flag.clear()
        self._container_subtitle_visible.clear()
        self._alias_map.clear(); self._mention_alias_map.clear(); self._mention_alias_map.clear(); self._random_color_cache.clear(); self._header_random_cache.clear()
        _FIELD_CACHE.clear()
        _ICON_BITMAP_CACHE = None

    def on_app_event(self, event_type: AppEvent):
        if event_type == AppEvent.RESUME:
            self._app_in_foreground = True
            self._last_resume_mono = time.monotonic()
            self._last_resume_ms = int(time.time() * 1000)
            self._register_android14_callback()
            self._register_mediastore_observer()
            self._snapshot_latest_mediastore_id()
        elif event_type == AppEvent.PAUSE:
            self._app_in_foreground = False
            self._unregister_android14_callback()
            self._unregister_mediastore_observer()
            if self._premask_active:
                self._premask_active = False
                self._premask_token += 1
                if not self.get_setting("manual_masking", False) and not self._capturing_now:
                    self._set_masking_active(False)
                    self._refresh_current_chat()

    def _build_status_summary(self) -> str:
        parts = []
        if self.get_setting("hide_nicknames", True):
            parts.append(_t("ники"))
        if int(self.get_setting("hide_time_mode", 0)) != 3:
            parts.append(_t("время"))
        if self.get_setting("hide_avatars", True):
            parts.append(_t("аватарки"))
        if self.get_setting("hide_pinned", True):
            parts.append(_t("закреп"))
        if self.get_setting("hide_tags", True):
            parts.append(_t("тэги"))
        hidden_str = ", ".join(parts) if parts else _t("ничего не скрывается")
        manual_only = bool(self.get_setting("manual_only_mode", False)) or not bool(
            self.get_setting("intercept_system_screenshot", True)
        )
        mode_str = _t("Только по кнопке (⋮)") if manual_only else _t("Автоперехват включён")
        return f"{mode_str} • {_t('Скрывается: ')}{hidden_str}."

    def _on_manual_only_changed(self, value: bool):
        manual_only = bool(value)
        self.set_setting("manual_only_mode", manual_only)
        self.set_setting("intercept_system_screenshot", not manual_only)
        if manual_only and not self.get_setting("show_chat_menu", True):
            self.set_setting("show_chat_menu", True)
            self._sync_menu_items()
        self.set_setting("manual_only_mode", manual_only, reload_settings=True)

    def _on_subpage_setting_changed(self, key: str, value: Any, clear_aliases: bool = False, clear_header: bool = False):
        if clear_aliases:
            self._alias_map.clear()
            self._mention_alias_map.clear()
            self._alias_counter = 0; self._mention_alias_counter = 0
        if clear_header:
            self._header_random_cache.clear()
        self.set_setting(key, value, reload_settings=True)
        self._refresh_if_active()

    def _create_nicks_subpage(self) -> List[Any]:
        items: List[Any] = [
            Header(text="Имена отправителей в чате"),
            Selector(
                key="nickname_mode",
                text="Как заменять имена",
                default=0,
                items=[
                    "Один текст для всех",
                    "Участник 1, 2…",
                    "Пусто",
                    "Случайные фразы",
                    "Случайные символы",
                ],
                on_change=lambda v: self._on_subpage_setting_changed("nickname_mode", v, clear_aliases=True),
            ),
        ]
        if int(self.get_setting("nickname_mode", 0)) == 0:
            items.append(
                Input(
                    key="nickname_placeholder",
                    text="Текст заглушки",
                    default=_t("Пользователь"),
                    subtext="Этот текст будет вместо всех имён.",
                    on_change=lambda v: self._refresh_if_active(),
                )
            )
        items.extend([
            Divider(),
            Header(text="Цитаты, пересылки и значки"),
            Switch(
                key="hide_reply_names",
                text="Скрывать имена в ответах и пересылках",
                subtext="Заменяет имена авторов внутри ответов и пересланных сообщений.",
                default=True,
                on_change=lambda v: self._refresh_if_active(),
            ),
            Switch(
                key="hide_statuses",
                text="Скрывать статусы и значки у имён",
                subtext="Убирает эмодзи-статусы, галочки и зелёную точку онлайна.",
                default=True,
                on_change=lambda v: self._refresh_if_active(),
            ),
            Switch(
                key="hide_mentions",
                text="Скрывать @упоминания в тексте",
                subtext="Заменяет @username и упоминания пользователей внутри сообщений.",
                default=True,
                on_change=lambda v: self._refresh_if_active(),
            ),
        ])
        return items

    def _create_avatars_subpage(self) -> List[Any]:
        ava_mode = int(self.get_setting("avatar_mode", 0))
        items: List[Any] = [
            Header(text="Как выглядят скрытые аватарки"),
            Selector(
                key="avatar_mode",
                text="Стиль",
                default=0,
                items=[
                    "Цвет аватарки",
                    "С буквой (ТГ)",
                    "Случайный цвет",
                ],
                on_change=lambda v: self._on_subpage_setting_changed("avatar_mode", v),
            ),
        ]
        if ava_mode == 1:
            items.append(
                Selector(
                    key="avatar_letter_source",
                    text="Откуда буква",
                    default=0,
                    items=[
                        "Реальный ник",
                        "Заглушка",
                    ],
                    on_change=lambda v: self._refresh_if_active(),
                )
            )
        if ava_mode == 0:
            items.extend([
                Divider(
                    text="Плагин берёт главный цвет текущей фотографии профиля и заливает им круг без буквы."
                ),
                Text(
                    text="Очистить кеш цветов аватарок",
                    subtext="Пересчитает цвета заново при следующем снимке.",
                    on_click=self._on_clear_color_cache_click,
                ),
            ])
        return items

    def _create_header_subpage(self) -> List[Any]:
        hide_hdr_name = bool(self.get_setting("hide_header_name", True))
        hdr_mode = int(self.get_setting("header_mode", 0))
        items: List[Any] = [
            Header(text="Верхняя панель чата"),
            Switch(
                key="hide_header_name",
                text="Скрывать название в шапке",
                default=True,
                on_change=lambda v: self._on_subpage_setting_changed("hide_header_name", v),
            ),
        ]
        if hide_hdr_name:
            items.append(
                Selector(
                    key="header_mode",
                    text="Как заменять название",
                    default=0,
                    items=[
                        "Авто / свой текст",
                        "Случайные фразы",
                        "Случайные символы",
                        "Пусто",
                    ],
                    on_change=lambda v: self._on_subpage_setting_changed("header_mode", v, clear_header=True),
                )
            )
            if hdr_mode == 0:
                items.append(
                    Input(
                        key="header_placeholder",
                        text="Свой текст в шапке",
                        default=_t("Собеседник"),
                        subtext="Для групп и каналов автоматически ставится «Чат» / «Канал», если оставить стандартный текст.",
                        on_change=lambda v: self._refresh_if_active(),
                    )
                )
        items.extend([
            Switch(
                key="hide_header_subtitle",
                text="Скрывать статус под названием",
                subtext="Убирает «в сети», «был(а) недавно» и количество участников.",
                default=True,
                on_change=lambda v: self._refresh_if_active(),
            ),
            Switch(
                key="hide_header_avatar",
                text="Скрывать аватарку в шапке",
                default=True,
                on_change=lambda v: self._refresh_if_active(),
            ),
            Divider(),
            Header(text="Лента сообщений"),
            Switch(
                key="hide_date_headers",
                text="Скрывать даты между сообщениями",
                subtext="Убирает плашки «Сегодня», «Вчера» и плавающую дату.",
                default=False,
                on_change=lambda v: self._refresh_if_active(),
            ),
        ])
        return items

    def _on_reset_defaults_click(self, view: Any):
        defaults = {
            "language": _language_choice,
            "manual_masking": False,
            "manual_only_mode": False,
            "intercept_system_screenshot": True,
            "three_finger_premask": True,
            "delete_original": False,
            "show_chat_menu": True,
            "hide_nicknames": True,
            "nickname_mode": 0,
            "nickname_placeholder": _t("Пользователь"),
            "hide_reply_names": True,
            "hide_mentions": True,
            "hide_time_mode": 0,
            "hide_tags": True,
            "hide_statuses": True,
            "hide_avatars": True,
            "avatar_mode": 0,
            "avatar_letter_source": 0,
            "hide_pinned": True,
            "hide_header_name": True,
            "header_mode": 0,
            "header_placeholder": _t("Собеседник"),
            "hide_header_subtitle": True,
            "hide_header_avatar": True,
            "hide_date_headers": False,
        }
        self._set_masking_active(False)
        self._premask_active = False
        self._dominant_color_cache.clear()
        self._alias_map.clear()
        self._mention_alias_map.clear()
        self._random_color_cache.clear()
        self._header_random_cache.clear()
        self._alias_counter = 0; self._mention_alias_counter = 0
        self.import_settings(defaults, reload_settings=True)
        self._sync_menu_items()
        run_on_ui_thread(self._refresh_current_chat)
        BulletinHelper.show_success(_t("Настройки сброшены по умолчанию"))

    def create_settings(self) -> List[Any]:
        manual_only = bool(self.get_setting("manual_only_mode", False)) or not bool(
            self.get_setting("intercept_system_screenshot", True)
        )

        nick_modes = [
            _t("Один текст"),
            _t("Участник 1, 2…"),
            _t("Пусто"),
            _t("Случайные фразы"),
            _t("Случайные символы"),
        ]
        nick_idx = min(4, max(0, int(self.get_setting("nickname_mode", 0))))
        raw_nick_ph = (self.get_setting("nickname_placeholder", "") or "").strip()
        nick_ph = _t("Пользователь") if (not raw_nick_ph or raw_nick_ph in ("Пользователь", "User")) else raw_nick_ph
        nicks_sub = f"{nick_modes[nick_idx]}" + (f": «{nick_ph}»" if nick_idx == 0 else "")

        ava_modes = [_t("Заливка в цвет аватарки"), _t("Стандартная с буквой"), _t("Случайный цвет")]
        ava_idx = min(2, max(0, int(self.get_setting("avatar_mode", 0))))

        hdr_modes = [_t("авто"), _t("фразы"), _t("символы"), _t("пусто")]
        hdr_idx = min(3, max(0, int(self.get_setting("header_mode", 0))))
        hdr_parts = []
        if self.get_setting("hide_header_name", True):
            hdr_parts.append(f"{_t('название')} ({hdr_modes[hdr_idx]})")
        if self.get_setting("hide_header_subtitle", True):
            hdr_parts.append(_t("статус"))
        if self.get_setting("hide_header_avatar", True):
            hdr_parts.append(_t("аватарка"))
        if self.get_setting("hide_date_headers", False):
            hdr_parts.append(_t("даты"))
        hdr_sub = (_t("Скрывается: ") + ", ".join(hdr_parts)) if hdr_parts else _t("Всё отображается")

        items: List[Any] = [
            Divider(text=self._build_status_summary()),
            Selector(
                key="language",
                text="Язык",
                icon="msg_translate",
                default=0,
                items=["Системный", "Русский", "English"],
                on_change=self._language_changed,
            ),
            Header(text="Режим работы"),
            Switch(
                key="manual_only_mode",
                text="Только по кнопке в меню (⋮)",
                subtext="Обычные скриншоты не перехватываются. Чистый снимок делается вручную через меню чата.",
                default=False,
                on_change=self._on_manual_only_changed,
            ),
        ]

        if not manual_only:
            items.extend([
                Switch(
                    key="three_finger_premask",
                    text="Предмаскировка 3 пальцами",
                    subtext="Скрывает данные ещё до кадра при жесте скриншота тремя пальцами.",
                    default=True,
                ),
                Switch(
                    key="delete_original",
                    text="Удалять обычный скриншот",
                    subtext="Убирает незамазанный снимок после сохранения чистого.",
                    default=False,
                ),
            ])

        items.extend([
            Switch(
                key="show_chat_menu",
                text="Кнопки в меню чата (⋮)",
                subtext="Добавляет «Чистый скриншот» и «Режим скриншота» в ⋮.",
                default=True,
                on_change=lambda v: self._sync_menu_items(),
            ),

            Divider(),
            Header(text="Что скрывать в чате"),
            Switch(
                key="hide_nicknames",
                text="Скрывать имена отправителей",
                default=True,
                on_change=lambda v: self._on_main_toggle_changed("hide_nicknames", v),
            ),
            Selector(
                key="hide_time_mode",
                text="Время сообщений",
                default=0,
                items=[
                    "Только галочки",
                    "Скрыть полностью",
                    "Заменить на 00:00",
                    "Не скрывать",
                ],
                on_change=lambda v: self._on_main_toggle_changed("hide_time_mode", v),
            ),
            Switch(
                key="hide_avatars",
                text="Скрывать аватарки",
                default=True,
                on_change=lambda v: self._on_main_toggle_changed("hide_avatars", v),
            ),
            Switch(
                key="hide_pinned",
                text="Скрывать закреплённое сообщение",
                default=True,
                on_change=lambda v: self._on_main_toggle_changed("hide_pinned", v),
            ),
            Switch(
                key="hide_tags",
                text="Скрывать тэги участников и админов",
                default=True,
                on_change=lambda v: self._on_main_toggle_changed("hide_tags", v),
            ),

            Divider(),
            Header(text="Как именно скрывать"),
            Text(
                text="Никнеймы, ответы и значки",
                subtext=nicks_sub,
                icon="msg_contacts",
                create_sub_fragment=self._create_nicks_subpage,
            ),
            Text(
                text="Внешний вид аватарок",
                subtext=ava_modes[ava_idx],
                icon="msg_photos",
                create_sub_fragment=self._create_avatars_subpage,
            ),
            Text(
                text="Шапка чата и разделители дат",
                subtext=hdr_sub,
                icon="msg_info",
                create_sub_fragment=self._create_header_subpage,
            ),

            Divider(),
            Text(
                text="Сбросить настройки по умолчанию",
                icon="msg_reset",
                red=True,
                on_click=self._on_reset_defaults_click,
            ),
        ])
        return items

    def _on_main_toggle_changed(self, key: str, value: Any):
        self.set_setting(key, value, reload_settings=True)
        self._refresh_if_active()

    def _on_clear_color_cache_click(self, view: Any):
        self._dominant_color_cache.clear()
        BulletinHelper.show_info(_t("Кеш цветов аватарок очищен"))

    def is_masking_active(self) -> bool:
        return self._masking_active

    def should_collapse_time_space(self, cell: Any) -> bool:
        if not self._masking_active:
            return False
        mode = int(self.get_setting("hide_time_mode", 0))
        if mode == 1:
            return True
        if mode == 0:
            try:
                msg = _safe_get(cell, "currentMessageObject")
                if msg is not None and not msg.isOutOwner():
                    if int(_safe_get(cell, "timeWidth", 0) or 0) <= 0:
                        return True
            except Exception:
                pass
        return False

    def _refresh_if_active(self):
        if self._masking_active:
            run_on_ui_thread(self._refresh_current_chat)

    def get_masked_name(self, peer_id: int) -> str:
        mode = int(self.get_setting("nickname_mode", 0))
        if mode == 2:
            return "\u200B"
        if mode == 1:
            if peer_id == 0:
                return _t("Участник")
            cached = self._alias_map.get(peer_id)
            if cached is None:
                self._alias_counter += 1
                cached = f"{_t('Участник')} {self._alias_counter}"
                self._alias_map[peer_id] = cached
            return cached
        if mode == 3:
            cached = self._alias_map.get(peer_id)
            if cached is None:
                cached = _gen_random_phrase()
                self._alias_map[peer_id] = cached
            return cached
        if mode == 4:
            cached = self._alias_map.get(peer_id)
            if cached is None:
                cached = _gen_random_alnum(7)
                self._alias_map[peer_id] = cached
            return cached
        placeholder = (self.get_setting("nickname_placeholder", "") or "").strip()
        if not placeholder or placeholder in ("Пользователь", "User"):
            return _t("Пользователь")
        return placeholder

    def get_header_placeholder(self, container: Any) -> str:
        hmode = int(self.get_setting("header_mode", 0))
        if hmode == 3:
            return "\u200B"
        did = 0
        fragment = None
        try:
            fragment = _safe_get(container, "parentFragment")
            if fragment is not None:
                did = int(fragment.getDialogId() or 0)
        except Exception:
            pass
        if hmode in (1, 2):
            cache_key = (did, hmode)
            cached = self._header_random_cache.get(cache_key)
            if cached is None:
                cached = _gen_random_phrase() if hmode == 1 else _gen_random_alnum(7)
                self._header_random_cache[cache_key] = cached
            return cached

        custom = (self.get_setting("header_placeholder", "") or "").strip()
        if custom and custom not in ("Собеседник", "Contact"):
            return custom
        try:
            if fragment is not None:
                chat = fragment.getCurrentChat()
                if chat is not None:
                    return _t("Канал") if getattr(chat, "broadcast", False) else _t("Чат")
        except Exception:
            pass
        return _t("Собеседник")

    def save_container_stories_flag(self, container: Any):
        try:
            cid = int(JSystem.identityHashCode(container))
            if cid not in self._container_stories_flag:
                if len(self._container_stories_flag) > 64:
                    self._container_stories_flag.clear()
                self._container_stories_flag[cid] = bool(_safe_get(container, "allowDrawStories", False))
        except Exception:
            pass

    def restore_container_stories_flag(self, container: Any):
        try:
            cid = int(JSystem.identityHashCode(container))
            if cid in self._container_stories_flag:
                _safe_set(container, "allowDrawStories", self._container_stories_flag.pop(cid))
        except Exception:
            pass

    def save_container_subtitle_visible(self, container: Any, is_vis: bool):
        try:
            cid = int(JSystem.identityHashCode(container))
            if cid not in self._container_subtitle_visible:
                if len(self._container_subtitle_visible) > 64:
                    self._container_subtitle_visible.clear()
                self._container_subtitle_visible[cid] = bool(is_vis)
        except Exception:
            pass

    def pop_container_subtitle_visible(self, container: Any) -> Optional[bool]:
        try:
            cid = int(JSystem.identityHashCode(container))
            return self._container_subtitle_visible.pop(cid, None)
        except Exception:
            return None

    def cache_bitmap_color(self, peer_id: int, bmp: Any):
        if peer_id == 0 or bmp is None:
            return
        if peer_id in self._dominant_color_cache:
            return
        color = _extract_dominant_color(bmp)
        if color is not None:
            if len(self._dominant_color_cache) >= 500:
                try:
                    oldest = next(iter(self._dominant_color_cache))
                    self._dominant_color_cache.pop(oldest, None)
                except Exception:
                    self._dominant_color_cache.clear()
            self._dominant_color_cache[peer_id] = color

    def apply_masked_avatar(
        self,
        avatar_drawable: Any,
        image_receiver: Any,
        account: int,
        peer_id: int,
        user: Any = None,
        chat: Any = None,
        image_view: Any = None,
    ):
        avatar_mode = int(self.get_setting("avatar_mode", 0))
        try:
            avatar_drawable.setScaleSize(1.0)
        except Exception:
            pass
        if avatar_mode == 0:
            dominant = self._dominant_color_cache.get(peer_id)
            if dominant is None and image_receiver is not None:
                bmp = _extract_bitmap_from_image_receiver(image_receiver)
                if bmp is not None:
                    dominant = _extract_dominant_color(bmp)
                    if dominant is not None and peer_id != 0:
                        self._dominant_color_cache[peer_id] = dominant
            if dominant is None:
                dominant = AvatarDrawable.getColorForId(jlong(peer_id))

            avatar_drawable.setInfo(jlong(peer_id))
            avatar_drawable.setColor(jint(dominant))
        elif avatar_mode == 2:
            rnd_color = self._random_color_cache.get(peer_id)
            if rnd_color is None:
                hue = random.uniform(0.0, 360.0)
                sat = random.uniform(0.55, 0.85)
                val = random.uniform(0.65, 0.90)
                rnd_color = Color.HSVToColor([hue, sat, val])
                self._random_color_cache[peer_id] = rnd_color
            avatar_drawable.setInfo(jlong(peer_id))
            avatar_drawable.setColor(jint(rnd_color))
        else:
            letter_source = int(self.get_setting("avatar_letter_source", 0))
            if letter_source == 1:
                masked = self.get_masked_name(peer_id)
                fallback_ch = "U" if _language() == "en" else "П"
                fn, ln = (masked, "") if masked and masked != "\u200B" else (fallback_ch, "")
                avatar_drawable.setInfo(jlong(peer_id), fn, ln)
            elif user is not None:
                avatar_drawable.setInfo(jint(account), user)
            elif chat is not None:
                avatar_drawable.setInfo(jint(account), chat)
            else:
                fn, ln = _get_peer_display_parts(account, peer_id, user=user, chat=chat)
                avatar_drawable.setInfo(jlong(peer_id), fn, ln)

        if image_view is not None:
            try:
                image_view.setAnimatedEmojiDrawable(None)
            except Exception:
                pass
            try:
                ir = image_view.getImageReceiver()
                if ir is not None:
                    ir.clearImage()
            except Exception:
                pass
            image_view.setImageDrawable(avatar_drawable)
            image_view.invalidate()
        elif image_receiver is not None:
            try:
                image_receiver.clearImage()
            except Exception:
                pass
            image_receiver.setImageBitmap(avatar_drawable)

    def _get_avatar_mask_sig(self) -> tuple:
        return (
            int(self.get_setting("avatar_mode", 0)),
            int(self.get_setting("avatar_letter_source", 0)),
            int(self.get_setting("nickname_mode", 0)),
            str(self.get_setting("nickname_placeholder", "")),
        )

    def mask_avatars_drawable(self, avd: Any, parent: Any = None):
        cid = int(JSystem.identityHashCode(avd))
        curr_states = _safe_get(avd, "currentStates")
        anim_states = _safe_get(avd, "animatingStates")
        if curr_states is None:
            return
        curr_ids = tuple(int(_safe_get(s, "id", 0) or 0) if s is not None else 0 for s in curr_states)
        sig = (curr_ids, self._get_avatar_mask_sig())
        entry = self._masked_avds.get(cid)
        if entry is not None and entry[1] == sig:
            return

        account = UserConfig.selectedAccount
        if parent is not None:
            try:
                account = int(_safe_get(parent, "currentAccount", account) or account)
            except Exception:
                pass

        for states in (curr_states, anim_states):
            if states is None:
                continue
            for st in states:
                if st is None:
                    continue
                peer_id = int(_safe_get(st, "id", 0) or 0)
                if peer_id == 0:
                    continue
                ir = _safe_get(st, "imageReceiver")
                av = _safe_get(st, "avatarDrawable")
                if ir is None or av is None:
                    continue
                obj = _safe_get(st, "object")
                user = obj if peer_id > 0 else None
                chat = obj if peer_id < 0 else None
                if peer_id not in self._dominant_color_cache:
                    bmp = _extract_bitmap_from_image_receiver(ir)
                    if bmp is not None:
                        self.cache_bitmap_color(peer_id, bmp)
                self.apply_masked_avatar(
                    avatar_drawable=av,
                    image_receiver=ir,
                    account=account,
                    peer_id=peer_id,
                    user=user,
                    chat=chat,
                )

        if len(self._masked_avds) > 256:
            dead = [k for k, v in self._masked_avds.items() if v[0].get() is None]
            for k in dead:
                self._masked_avds.pop(k, None)
            if len(self._masked_avds) > 256:
                self._masked_avds.clear()
        self._masked_avds[cid] = (JWeakRef(avd), sig, account)

    def _restore_single_avd(self, avd: Any, account: int):
        curr_states = _safe_get(avd, "currentStates")
        if curr_states is None:
            return
        objs = [_safe_get(st, "object") if st is not None else None for st in curr_states]
        for idx, obj in enumerate(objs):
            avd.setObject(jint(idx), jint(account), obj)
        avd.commitTransition(False)

    def restore_avatars_drawable_if_needed(self, avd: Any):
        cid = int(JSystem.identityHashCode(avd))
        entry = self._masked_avds.pop(cid, None)
        if entry is None:
            return
        try:
            self._restore_single_avd(avd, entry[2])
        except Exception:
            pass

    def restore_all_masked_avds(self):
        if not self._masked_avds:
            return
        items = list(self._masked_avds.values())
        self._masked_avds.clear()
        for ref, _, account in items:
            avd = ref.get()
            if avd is not None:
                try:
                    self._restore_single_avd(avd, account)
                except Exception:
                    pass

    def _get_mention_mask_sig(self) -> tuple:
        return (
            int(self.get_setting("nickname_mode", 0)),
            str(self.get_setting("nickname_placeholder", "")),
        )

    def get_masked_mention(self, key: Any, is_at_mention: bool = True) -> str:
        nmode = int(self.get_setting("nickname_mode", 0))
        if nmode == 2:
            return ""
        prefix = "@" if is_at_mention else ""
        if nmode == 1:
            if isinstance(key, tuple) and key[0] == "id" and key[1] != 0:
                return f"{prefix}{self.get_masked_name(int(key[1]))}"
            cached = self._mention_alias_map.get(key)
            if cached is None:
                self._mention_alias_counter += 1
                cached = f"{prefix}{_t('Участник')} {self._mention_alias_counter}"
                self._mention_alias_map[key] = cached
            return cached
        if nmode == 3:
            cached = self._mention_alias_map.get(key)
            if cached is None:
                cached = f"{prefix}{_gen_random_phrase()}"
                self._mention_alias_map[key] = cached
            return cached
        if nmode == 4:
            cached = self._mention_alias_map.get(key)
            if cached is None:
                cached = f"{prefix}{_gen_random_alnum(7)}"
                self._mention_alias_map[key] = cached
            return cached
        base = self.get_masked_name(0)
        if prefix and not base.startswith("@"):
            return f"@{base}"
        return base

    def mask_mentions_in_spannable(self, text: Any) -> Any:
        if TextUtils.isEmpty(text):
            return None
        URLSpanNoUnderlineClass = find_class("org.telegram.ui.Components.URLSpanNoUnderline")
        URLSpanUserMentionClass = find_class("org.telegram.ui.Components.URLSpanUserMention")
        sb = text if isinstance(text, SpannableStringBuilder) else SpannableStringBuilder(text)
        total_len = int(sb.length())
        if total_len <= 0:
            return None

        hits = []
        if URLSpanNoUnderlineClass is not None:
            spans = sb.getSpans(jint(0), jint(total_len), URLSpanNoUnderlineClass)
            if spans is not None:
                for sp in spans:
                    url = str(sp.getURL() or "")
                    if url.startswith("@"):
                        s = int(sb.getSpanStart(sp))
                        e = int(sb.getSpanEnd(sp))
                        if 0 <= s < e <= total_len:
                            hits.append((s, e, sp, ("u", url.lower()), True))

        if URLSpanUserMentionClass is not None:
            spans = sb.getSpans(jint(0), jint(total_len), URLSpanUserMentionClass)
            if spans is not None:
                for sp in spans:
                    s = int(sb.getSpanStart(sp))
                    e = int(sb.getSpanEnd(sp))
                    if 0 <= s < e <= total_len:
                        uid = 0
                        try:
                            uid = int(str(sp.getURL() or "0") or 0)
                        except Exception:
                            pass
                        frag = str(sb.subSequence(jint(s), jint(e)))
                        hits.append((s, e, sp, ("id", uid if uid != 0 else frag.lower()), frag.startswith("@")))

        if not hits:
            return None

        hits.sort(key=lambda item: item[0], reverse=True)
        for s, e, sp, key, is_at in hits:
            rep = self.get_masked_mention(key, is_at_mention=is_at)
            if rep == "":
                try:
                    sb.removeSpan(sp)
                except Exception:
                    pass
                sb.replace(jint(s), jint(e), "")
                cur_len = int(sb.length())
                if s == 0 and cur_len > 0:
                    tail = str(sb.subSequence(jint(0), jint(min(2, cur_len))))
                    if tail in (", ", ": "):
                        sb.delete(jint(0), jint(2))
                    elif tail.startswith(" ") or tail.startswith(","):
                        sb.delete(jint(0), jint(1))
                elif 0 < s < cur_len:
                    prev_ch = str(sb.subSequence(jint(s - 1), jint(s)))
                    next_ch = str(sb.subSequence(jint(s), jint(s + 1)))
                    if prev_ch == " " and next_ch == " ":
                        sb.delete(jint(s), jint(s + 1))
            else:
                sb.replace(jint(s), jint(e), rep)

        if int(sb.length()) == 0:
            sb.append("\u200B")
        return sb

    def _msg_has_mention_entities(self, msg: Any) -> bool:
        try:
            entities = msg.getEntities()
            if entities is None or entities.isEmpty():
                return False
            MentionCls = find_class("org.telegram.tgnet.TLRPC$TL_messageEntityMention")
            MentionNameCls = find_class("org.telegram.tgnet.TLRPC$TL_messageEntityMentionName")
            InputMentionCls = find_class("org.telegram.tgnet.TLRPC$TL_inputMessageEntityMentionName")
            for i in range(entities.size()):
                ent = entities.get(i)
                if (
                    (MentionCls is not None and isinstance(ent, MentionCls))
                    or (MentionNameCls is not None and isinstance(ent, MentionNameCls))
                    or (InputMentionCls is not None and isinstance(ent, InputMentionCls))
                ):
                    return True
        except Exception:
            pass
        return False

    def _rebuild_message_text_and_caption(self, msg: Any):
        owner = getattr(msg, "messageOwner", None)
        if owner is None:
            return
        raw = None
        if bool(getattr(msg, "translated", False)) and getattr(owner, "translatedText", None) is not None:
            raw = getattr(owner.translatedText, "text", None)
        if not raw:
            raw = getattr(owner, "message", None)
        if raw and getattr(msg, "messageText", None) is not None:
            msg.applyNewText(raw)
        if getattr(msg, "caption", None) is not None:
            _safe_set(msg, "caption", None)
            msg.generateCaption()
        msg.forceUpdate = True

    def track_masked_mention_msg(self, msg: Any):
        if msg is None:
            return
        mid = int(JSystem.identityHashCode(msg))
        sig = self._get_mention_mask_sig()
        if len(self._masked_mentions) > 256:
            dead = [k for k, v in self._masked_mentions.items() if v[0].get() is None]
            for k in dead:
                self._masked_mentions.pop(k, None)
            if len(self._masked_mentions) > 256:
                self._masked_mentions.clear()
        self._masked_mentions[mid] = (JWeakRef(msg), sig)

    def ensure_message_mentions_masked(self, msg: Any):
        if msg is None:
            return
        mid = int(JSystem.identityHashCode(msg))
        sig = self._get_mention_mask_sig()
        entry = self._masked_mentions.get(mid)
        if entry is not None and entry[1] == sig:
            return
        if entry is None and not self._msg_has_mention_entities(msg):
            return
        self._rebuild_message_text_and_caption(msg)
        self.track_masked_mention_msg(msg)

    def restore_message_mentions_if_needed(self, msg: Any):
        if msg is None:
            return
        mid = int(JSystem.identityHashCode(msg))
        if self._masked_mentions.pop(mid, None) is not None:
            self._rebuild_message_text_and_caption(msg)

    def restore_all_masked_mentions(self):
        if not self._masked_mentions:
            return
        items = list(self._masked_mentions.values())
        self._masked_mentions.clear()
        for ref, _ in items:
            m = ref.get()
            if m is not None:
                try:
                    self._rebuild_message_text_and_caption(m)
                except Exception:
                    pass

    def _install_hooks(self):
        ChatMessageCellClass = find_class("org.telegram.ui.Cells.ChatMessageCell")
        if ChatMessageCellClass:
            self.hook_all_methods(ChatMessageCellClass, "getAuthorName", _AuthorNameHook(self))
            self.hook_all_methods(ChatMessageCellClass, "getNameFromDialogId", _ReplyNameFromDialogIdHook(self))
            self.hook_all_methods(ChatMessageCellClass, "getAuthorStatus", _AuthorStatusHook(self))
            self.hook_all_methods(ChatMessageCellClass, "getAuthorBotVerificationId", _AuthorVerificationHook(self))
            self.hook_all_methods(ChatMessageCellClass, "timeString", _TimeStringHook(self))
            self.hook_all_methods(ChatMessageCellClass, "measureTime", _MeasureTimeHook(self))
            self.hook_all_methods(ChatMessageCellClass, "getExtraTimeX", _GetExtraTimeXHook(self))
            self.hook_all_methods(ChatMessageCellClass, "calcBackgroundWidth", _CalcBackgroundWidthHook(self))
            self.hook_all_methods(ChatMessageCellClass, "drawTime", _DrawTimeHook(self))
            self.hook_all_methods(ChatMessageCellClass, "setMessageContent", _SetMessageContentHook(self))
            self.hook_all_methods(ChatMessageCellClass, "setAvatar", _MessageCellAvatarHook(self))
            self.hook_all_methods(ChatMessageCellClass, "drawAvatarWithOnlineStatus", _AvatarOnlineHook(self))
            self.hook_all_methods(ChatMessageCellClass, "getAuthorSecondaryBadge", _AuthorStatusHook(self))
        else:
            self.logger.warning("ChatMessageCell class not found")

        AvatarsDrawableClass = find_class("org.telegram.ui.Components.AvatarsDrawable")
        if AvatarsDrawableClass:
            self.hook_all_methods(
                AvatarsDrawableClass,
                "onDraw",
                _AvatarsDrawableDrawHook(self, ChatMessageCellClass),
            )

        MessageObjectClass = find_class("org.telegram.messenger.MessageObject")
        if MessageObjectClass:
            self.hook_all_methods(MessageObjectClass, "applyEntities", _MessageObjectApplyEntitiesHook(self))
            self.hook_all_methods(MessageObjectClass, "generateCaption", _MessageObjectGenerateCaptionHook(self))

        PluginCellClass = find_class("com.exteragram.messenger.plugins.ui.components.PluginCell")
        if PluginCellClass:
            pcell_hook = _PluginCellIconHook(__id__)
            self.hook_all_methods(PluginCellClass, "set", pcell_hook)
            self.hook_all_methods(PluginCellClass, "bindNormalState", pcell_hook)

        ChatAvatarContainerClass = find_class("org.telegram.ui.Components.ChatAvatarContainer")
        if ChatAvatarContainerClass:
            self.hook_all_methods(ChatAvatarContainerClass, "checkAndUpdateAvatar", _ChatAvatarContainerAvatarHook(self))
            self.hook_all_methods(ChatAvatarContainerClass, "setChatAvatar", _ChatAvatarContainerAvatarHook(self))
            self.hook_all_methods(ChatAvatarContainerClass, "setUserAvatar", _ChatAvatarContainerAvatarHook(self))
            self.hook_all_methods(ChatAvatarContainerClass, "setTitle", _ChatAvatarContainerTitleHook(self))
            self.hook_all_methods(ChatAvatarContainerClass, "setTitleIcons", _ChatAvatarContainerTitleIconsHook(self))
            self.hook_all_methods(ChatAvatarContainerClass, "updateSubtitle", _ChatAvatarContainerSubtitleHook(self))
            self.hook_all_methods(ChatAvatarContainerClass, "setSubtitle", _ChatAvatarContainerSubtitleHook(self))
        else:
            self.logger.warning("ChatAvatarContainer class not found")

        ChatActivityClass = find_class("org.telegram.ui.ChatActivity")
        if ChatActivityClass:
            self.hook_all_methods(ChatActivityClass, "updatePinnedMessageView", _PinnedMessageViewHook(self))
        else:
            self.logger.warning("ChatActivity class not found")

        ChatActionCellClass = find_class("org.telegram.ui.Cells.ChatActionCell")
        if ChatActionCellClass:
            self.hook_all_methods(ChatActionCellClass, "onDraw", _ChatActionCellDrawHook(self))

        LaunchActivityClass = find_class("org.telegram.ui.LaunchActivity")
        if LaunchActivityClass:
            self.hook_all_methods(LaunchActivityClass, "dispatchTouchEvent", _TouchPreMaskHook(self))

    def _sync_menu_items(self):
        self._remove_menu_items()
        if not self.get_setting("show_chat_menu", True):
            return
        self._menu_toggle_id = self.add_menu_item(
            MenuItemData(
                menu_type=MenuItemType.CHAT_ACTION_MENU,
                text=_t("Режим скриншота"),
                on_click=self._on_menu_toggle_click,
                icon="msg_secret",
                priority=50,
            )
        )
        self._menu_capture_id = self.add_menu_item(
            MenuItemData(
                menu_type=MenuItemType.CHAT_ACTION_MENU,
                text=_t("Чистый скриншот"),
                on_click=self._on_menu_capture_click,
                icon="msg_gallery",
                priority=49,
            )
        )

    def _remove_menu_items(self):
        if self._menu_toggle_id:
            try:
                self.remove_menu_item(self._menu_toggle_id)
            except Exception:
                pass
            self._menu_toggle_id = None
        if self._menu_capture_id:
            try:
                self.remove_menu_item(self._menu_capture_id)
            except Exception:
                pass
            self._menu_capture_id = None

    def _on_menu_toggle_click(self, context: Dict[str, Any]):
        new_state = not self._masking_active
        self._set_masking_active(new_state)
        self.set_setting("manual_masking", new_state, reload_settings=False)
        if not new_state:
            self._alias_map.clear(); self._mention_alias_map.clear(); self._random_color_cache.clear(); self._header_random_cache.clear()
            self._alias_counter = 0; self._mention_alias_counter = 0
        self._refresh_current_chat()
        if new_state:
            BulletinHelper.show_info(_t("Режим скриншота включён"))
        else:
            BulletinHelper.show_info(_t("Режим скриншота выключен"))

    def _on_menu_capture_click(self, context: Dict[str, Any]):
        self._capture_clean_screenshot(delete_original_uri=None)


    def _get_current_chat_activity(self) -> Any:
        try:
            frag = get_last_fragment()
            if frag is None:
                return None
            ChatActivityClass = find_class("org.telegram.ui.ChatActivity")
            if ChatActivityClass is not None and isinstance(frag, ChatActivityClass):
                return frag
        except Exception:
            pass
        return None

    def _refresh_current_chat(self):
        if not self._masking_active or not self.get_setting("hide_avatars", True):
            self.restore_all_masked_avds()
        if not self._masking_active or not self.get_setting("hide_mentions", True):
            self.restore_all_masked_mentions()
        chat_activity = self._get_current_chat_activity()
        if chat_activity is None:
            return
        try:
            avatar_container = _safe_get(chat_activity, "avatarContainer")
            if avatar_container is not None:
                if not self._masking_active:
                    self.restore_container_stories_flag(avatar_container)
                    try:
                        was_vis = self.pop_container_subtitle_visible(avatar_container)
                        sub_view = avatar_container.getSubtitleTextView()
                        if was_vis is True and sub_view is not None and sub_view.getVisibility() == View.GONE:
                            sub_view.setVisibility(View.VISIBLE)
                    except Exception:
                        pass
                avatar_container.checkAndUpdateAvatar()
                chat_activity.updateTitle(False)
                avatar_container.updateSubtitle(False)

            try:
                ChatActivityClass = chat_activity.getClass()
                upd_pin = ChatActivityClass.getDeclaredMethod("updatePinnedMessageView", JBoolean.TYPE)
                upd_pin.setAccessible(True)
                upd_pin.invoke(chat_activity, False)
            except Exception:
                pass

            floating_date = _safe_get(chat_activity, "floatingDateView")
            if floating_date is not None:
                if self._masking_active and self.get_setting("hide_date_headers", False):
                    floating_date.setAlpha(0.0)
                else:
                    floating_date.setAlpha(1.0)

            chat_list_view = _safe_get(chat_activity, "chatListView")
            if chat_list_view is not None:
                try:
                    pool = chat_list_view.getRecycledViewPool()
                    if pool is not None:
                        pool.clear()
                except Exception:
                    pass
                try:
                    cnt = chat_list_view.getChildCount()
                    for i in range(cnt):
                        ch = chat_list_view.getChildAt(i)
                        if ch is not None and hasattr(ch, "getMessageObject"):
                            m = ch.getMessageObject()
                            if m is not None:
                                m.forceUpdate = True
                except Exception:
                    pass

            chat_activity.updateVisibleRows()

            if chat_list_view is not None:
                count = chat_list_view.getChildCount()
                for i in range(count):
                    child = chat_list_view.getChildAt(i)
                    if child is not None:
                        try:
                            if hasattr(child, "relayout"):
                                child.relayout()
                        except Exception:
                            pass
                        child.requestLayout()
                        child.invalidate()
                chat_list_view.invalidate()
        except Exception as e:
            self.logger.exception("Failed to refresh chat UI: %s", e)

    def _is_auto_intercept_enabled(self) -> bool:
        return (
            not bool(self.get_setting("manual_only_mode", False))
            and bool(self.get_setting("intercept_system_screenshot", True))
        )

    def on_three_finger_gesture(self):
        if not self._is_auto_intercept_enabled():
            return
        if not self.get_setting("three_finger_premask", True):
            return
        if self._capturing_now or self._masking_active:
            return
        if self._get_current_chat_activity() is None:
            return

        self._premask_active = True
        self._premask_token += 1
        token = self._premask_token
        self._set_masking_active(True)
        self._refresh_current_chat()

        def _timeout_restore():
            if self._premask_active and self._premask_token == token:
                self._premask_active = False
                if not self.get_setting("manual_masking", False) and not self._capturing_now:
                    self._set_masking_active(False)
                    self._alias_map.clear(); self._mention_alias_map.clear(); self._random_color_cache.clear(); self._header_random_cache.clear()
                    self._alias_counter = 0; self._mention_alias_counter = 0
                    self._refresh_current_chat()

        run_on_ui_thread(_timeout_restore, 1800)

    def _register_screenshot_detectors(self):
        try:
            self._notif_delegate = _create_notification_delegate(self)
            max_acc = int(getattr(UserConfig, "MAX_ACCOUNT_COUNT", 4) or 4)
            self._notif_accounts = []
            for acc in range(max_acc):
                try:
                    get_notification_center(acc).addObserver(self._notif_delegate.java, NotificationCenter.screenshotTook)
                    self._notif_accounts.append(acc)
                except Exception:
                    pass
        except Exception:
            pass

        self._register_android14_callback()

        self._register_mediastore_observer()

    def _register_mediastore_observer(self):
        if self._content_observer is not None:
            return
        try:
            ObserverClass = _ensure_content_observer_proxy()
            if ObserverClass is not None:
                handler = _get_main_handler()
                self._content_observer = ObserverClass.new_instance(handler, init_args=[handler, self])
                resolver = ApplicationLoader.applicationContext.getContentResolver()
                resolver.registerContentObserver(
                    MediaStore.Images.Media.EXTERNAL_CONTENT_URI,
                    True,
                    self._content_observer.java,
                )
                try:
                    resolver.registerContentObserver(
                        MediaStore.Images.Media.INTERNAL_CONTENT_URI,
                        True,
                        self._content_observer.java,
                    )
                except Exception:
                    pass
        except Exception:
            pass

    def _unregister_mediastore_observer(self):
        if self._content_observer is not None:
            try:
                resolver = ApplicationLoader.applicationContext.getContentResolver()
                resolver.unregisterContentObserver(self._content_observer.java)
            except Exception:
                pass
            try:
                self._content_observer._plugin = None
                self._content_observer.jrelease()
            except Exception:
                pass
            self._content_observer = None

    def _snapshot_latest_mediastore_id(self):
        def _snap():
            try:
                resolver = ApplicationLoader.applicationContext.getContentResolver()
                cursor = resolver.query(
                    MediaStore.Images.Media.EXTERNAL_CONTENT_URI,
                    ["_id"],
                    None,
                    None,
                    "_id DESC",
                )
                if cursor is not None:
                    try:
                        if cursor.moveToFirst():
                            idx = cursor.getColumnIndex("_id")
                            if idx >= 0:
                                rid = int(cursor.getLong(idx) or 0)
                                if rid > self._max_seen_mediastore_id:
                                    self._max_seen_mediastore_id = rid
                                if rid > 0:
                                    self._seen_mediastore_ids.add(rid)
                                    if len(self._seen_mediastore_ids) > 128:
                                        self._seen_mediastore_ids = {rid}
                    finally:
                        cursor.close()
            except Exception:
                pass

        run_on_queue(_snap)

    def _unregister_screenshot_detectors(self):
        if self._notif_delegate is not None:
            for acc in self._notif_accounts:
                try:
                    get_notification_center(acc).removeObserver(self._notif_delegate.java, NotificationCenter.screenshotTook)
                except Exception:
                    pass
            try:
                self._notif_delegate._plugin = None
                self._notif_delegate.jrelease()
            except Exception:
                pass
            self._notif_accounts.clear()
            self._notif_delegate = None

        self._unregister_android14_callback()
        self._unregister_mediastore_observer()

    def _register_android14_callback(self):
        if Build.VERSION.SDK_INT < 34:
            return
        try:
            frag = get_last_fragment()
            activity = frag.getParentActivity() if frag is not None else None
            if activity is None:
                return
            if activity.checkSelfPermission("android.permission.DETECT_SCREEN_CAPTURE") != PackageManager.PERMISSION_GRANTED:
                return
            if self._registered_activity is activity and self._screen_capture_cb is not None:
                return
            self._unregister_android14_callback()
            CbProxy = _ensure_screen_capture_proxy()
            if CbProxy is None:
                return
            self._screen_capture_cb = CbProxy.new_instance(init_args=[self])
            activity.registerScreenCaptureCallback(activity.getMainExecutor(), self._screen_capture_cb.java)
            self._registered_activity = activity
        except Exception:
            pass

    def _unregister_android14_callback(self):
        if Build.VERSION.SDK_INT < 34:
            return
        if self._registered_activity is not None and self._screen_capture_cb is not None:
            try:
                self._registered_activity.unregisterScreenCaptureCallback(self._screen_capture_cb.java)
            except Exception:
                pass
            try:
                self._screen_capture_cb._plugin = None
                self._screen_capture_cb.jrelease()
            except Exception:
                pass
        self._registered_activity = None
        self._screen_capture_cb = None

    def _check_latest_mediastore_screenshot(self, uri: Any):
        if not self._app_in_foreground or not self._is_auto_intercept_enabled():
            return
        if self._capturing_now or time.monotonic() < self._ignore_observer_until:
            return
        if time.monotonic() - self._last_resume_mono < 0.7:
            return
        if self._get_current_chat_activity() is None:
            return

        def _query():
            try:
                if not self._app_in_foreground:
                    return
                ctx = ApplicationLoader.applicationContext
                resolver = ctx.getContentResolver()
                target_uri = uri if uri is not None else MediaStore.Images.Media.EXTERNAL_CONTENT_URI
                uri_str = str(target_uri.toString()) if target_uri is not None else ""
                last_seg = uri_str.rsplit("/", 1)[-1] if "/" in uri_str else ""
                is_item_uri = last_seg.isdigit()
                projection = [
                    "_id",
                    "_display_name",
                    "bucket_display_name",
                    "relative_path",
                    "title",
                    "_data",
                    "date_added",
                    "datetaken",
                    "width",
                    "height",
                ]
                cursor = resolver.query(
                    target_uri,
                    projection,
                    None,
                    None,
                    None if is_item_uri else "_id DESC",
                )
                if cursor is None:
                    return
                try:
                    if cursor.moveToFirst():
                        def _col_str(col_name: str) -> str:
                            idx = cursor.getColumnIndex(col_name)
                            return str(cursor.getString(idx) or "").lower() if idx >= 0 else ""

                        def _col_int(col_name: str) -> int:
                            idx = cursor.getColumnIndex(col_name)
                            return int(cursor.getLong(idx) or 0) if idx >= 0 else 0

                        name = _col_str("_display_name")
                        bucket = _col_str("bucket_display_name")
                        rel_path = _col_str("relative_path")
                        title = _col_str("title")
                        data_path = _col_str("_data")
                        added = _col_int("date_added")
                        taken_ms = _col_int("datetaken")
                        row_id = _col_int("_id")
                        pw = _col_int("width")
                        ph = _col_int("height")
                        now_sec = int(time.time())

                        if row_id > 0 and (row_id in self._seen_mediastore_ids or row_id <= self._max_seen_mediastore_id):
                            return

                        combined = f"{name} {bucket} {rel_path} {title} {data_path}"
                        is_shot_name = (
                            "screenshot" in combined
                            or "скриншот" in combined
                            or "снимок" in combined
                        )
                        is_our_clean = "_tg_clean" in combined

                        if taken_ms > 0 and taken_ms < self._last_resume_ms - 250:
                            if row_id > 0:
                                self._seen_mediastore_ids.add(row_id)
                                if row_id > self._max_seen_mediastore_id:
                                    self._max_seen_mediastore_id = row_id
                            return
                        if added > 0 and added < int(self._last_resume_ms // 1000) - 1:
                            if row_id > 0:
                                self._seen_mediastore_ids.add(row_id)
                                if row_id > self._max_seen_mediastore_id:
                                    self._max_seen_mediastore_id = row_id
                            return

                        size_ok = True
                        try:
                            real_size = AndroidUtilities.getRealScreenSize()
                            if real_size is not None and pw > 0 and ph > 0:
                                sx = int(real_size.x)
                                sy = int(real_size.y)
                                size_ok = (pw == sx and ph == sy) or (ph == sx and pw == sy)
                        except Exception:
                            pass

                        if is_shot_name and not is_our_clean and size_ok and abs(now_sec - added) <= 6:
                            if row_id > 0:
                                if len(self._seen_mediastore_ids) > 128:
                                    self._seen_mediastore_ids.clear()
                                self._seen_mediastore_ids.add(row_id)
                                if row_id > self._max_seen_mediastore_id:
                                    self._max_seen_mediastore_id = row_id
                            found_uri = target_uri if is_item_uri else None
                            if found_uri is None and row_id > 0:
                                found_uri = MediaStore.Images.Media.EXTERNAL_CONTENT_URI.buildUpon().appendPath(str(row_id)).build()
                            self._last_mediastore_uri = found_uri

                            def _dispatch():
                                if self._app_in_foreground:
                                    self._on_system_screenshot_detected(
                                        source="mediastore",
                                        original_uri=found_uri,
                                    )

                            run_on_ui_thread(_dispatch)
                finally:
                    cursor.close()
            except Exception:
                pass

        run_on_queue(_query)

    def _on_system_screenshot_detected(self, source: str = "", original_uri: Any = None):
        if not self._app_in_foreground or not self._is_auto_intercept_enabled():
            return
        if self._capturing_now:
            return
        if self._get_current_chat_activity() is None:
            return

        now = time.monotonic()
        if now - self._last_screenshot_ts < 2.2:
            if original_uri is not None:
                self._last_mediastore_uri = original_uri
            return
        self._last_screenshot_ts = now

        if self._premask_active:
            self._premask_active = False
            self._premask_token += 1
            run_on_ui_thread(self._disable_masking_silent, 300)
            return

        if self._masking_active:
            run_on_ui_thread(self._disable_masking_after_screenshot, 350)
            return

        delete_uri = original_uri or self._last_mediastore_uri
        run_on_ui_thread(lambda: self._capture_clean_screenshot(delete_original_uri=delete_uri), 40)

    def _disable_masking_silent(self):
        if self._masking_active and not self.get_setting("manual_masking", False):
            self._set_masking_active(False)
            self._alias_map.clear(); self._mention_alias_map.clear(); self._random_color_cache.clear(); self._header_random_cache.clear()
            self._alias_counter = 0; self._mention_alias_counter = 0
            self._refresh_current_chat()

    def _disable_masking_after_screenshot(self):
        if self._masking_active:
            self._set_masking_active(False)
            self.set_setting("manual_masking", False, reload_settings=False)
            self._alias_map.clear(); self._mention_alias_map.clear(); self._random_color_cache.clear(); self._header_random_cache.clear()
            self._alias_counter = 0; self._mention_alias_counter = 0
            self._refresh_current_chat()
            BulletinHelper.show_info(_t("Режим скриншота автоматически выключен"))

    @staticmethod
    def _resolve_native_screenshots_rel_path() -> str:
        """
        Сохраняет в ту же папку Screenshots, что и система устройства:
        например DCIM/Screenshots на Samsung OneUI, иначе Pictures/Screenshots.
        """
        try:
            dcim_dir = Environment.getExternalStoragePublicDirectory(Environment.DIRECTORY_DCIM)
            if dcim_dir is not None:
                dcim_shots = os.path.join(str(dcim_dir.getAbsolutePath()), "Screenshots")
                if os.path.isdir(dcim_shots):
                    return Environment.DIRECTORY_DCIM + "/Screenshots"
        except Exception:
            pass
        return Environment.DIRECTORY_PICTURES + "/Screenshots"

    def _capture_clean_screenshot(self, delete_original_uri: Any = None):
        if self._capturing_now:
            return
        chat_activity = self._get_current_chat_activity()
        if chat_activity is None:
            return
        activity = chat_activity.getParentActivity()
        if activity is None:
            return
        try:
            if activity.isFinishing() or (Build.VERSION.SDK_INT >= 17 and activity.isDestroyed()):
                return
        except Exception:
            pass
        window = activity.getWindow()
        if window is None:
            return
        decor = window.getDecorView()
        if decor is None:
            return
        try:
            if not decor.isAttachedToWindow():
                return
            if delete_original_uri is not None and not decor.hasWindowFocus():
                return
        except Exception:
            pass
        w = decor.getWidth()
        h = decor.getHeight()
        if w <= 0 or h <= 0:
            return

        self._capturing_now = True
        was_already_active = self._masking_active

        if not was_already_active:
            self._set_masking_active(True)
            self._refresh_current_chat()

        def _restore():
            if not was_already_active:
                self._set_masking_active(False)
                self._alias_map.clear(); self._mention_alias_map.clear(); self._random_color_cache.clear(); self._header_random_cache.clear()
                self._alias_counter = 0; self._mention_alias_counter = 0
                self._refresh_current_chat()
            self._capturing_now = False

        def _do_capture():
            bitmap = None
            ownership_transferred = False
            try:
                if activity.isFinishing() or (Build.VERSION.SDK_INT >= 17 and activity.isDestroyed()):
                    _restore()
                    return
                bitmap = Bitmap.createBitmap(w, h, Bitmap.Config.ARGB_8888)
                if Build.VERSION.SDK_INT >= 26:
                    ProxyCls = _ensure_pixel_copy_proxy()
                    if ProxyCls is not None:
                        def _on_copied(result_code: int):
                            _restore()
                            if result_code == PixelCopy.SUCCESS:
                                self._save_bitmap_async(bitmap, delete_original_uri)
                            else:
                                try:
                                    bitmap.recycle()
                                except Exception:
                                    pass
                                if self._app_in_foreground:
                                    BulletinHelper.show_error(_t("Не удалось снять чистый скриншот"))

                        listener = ProxyCls.new_instance(init_args=[_on_copied])
                        PixelCopy.request(window, bitmap, listener.java, _get_main_handler())
                        ownership_transferred = True
                        return

                canvas = Canvas(bitmap)
                decor.draw(canvas)
                _restore()
                ownership_transferred = True
                self._save_bitmap_async(bitmap, delete_original_uri)
            except Exception as e:
                _restore()
                self.logger.exception("Capture failed: %s", e)
                BulletinHelper.show_error(_t("Ошибка при создании скриншота"))
            finally:
                if bitmap is not None and not ownership_transferred:
                    try:
                        bitmap.recycle()
                    except Exception:
                        pass

        run_on_ui_thread(_do_capture, 140)

    def _save_bitmap_async(self, bitmap: Any, delete_original_uri: Any = None):
        should_delete_original = bool(self.get_setting("delete_original", False))
        self._ignore_observer_until = time.monotonic() + 4.0

        def _save_task():
            saved_ok = False
            try:
                from java.io import ByteArrayOutputStream

                ctx = ApplicationLoader.applicationContext
                ts = time.strftime("%Y%m%d_%H%M%S")
                now_sec = int(time.time())
                now_ms = int(now_sec * 1000)
                bw = int(bitmap.getWidth())
                bh = int(bitmap.getHeight())
                file_name = f"Screenshot_{ts}_tg_clean.png"
                rel_path = self._resolve_native_screenshots_rel_path()

                baos = ByteArrayOutputStream()
                try:
                    bitmap.compress(Bitmap.CompressFormat.PNG, 100, baos)
                    raw_bytes = baos.toByteArray()
                finally:
                    try:
                        baos.close()
                    except Exception:
                        pass
                byte_len = len(raw_bytes)

                if Build.VERSION.SDK_INT >= 29:
                    values = ContentValues()
                    values.put("title", file_name)
                    values.put(MediaStore.MediaColumns.DISPLAY_NAME, file_name)
                    values.put(MediaStore.MediaColumns.MIME_TYPE, "image/png")
                    values.put("relative_path", rel_path)
                    values.put("width", JInteger(bw))
                    values.put("height", JInteger(bh))
                    values.put("_size", JLong(byte_len))
                    values.put("datetaken", JLong(now_ms))
                    values.put("date_added", JLong(now_sec))
                    values.put("date_modified", JLong(now_sec))
                    values.put("orientation", JInteger(0))
                    values.put("is_pending", JInteger(1))

                    resolver = ctx.getContentResolver()
                    out_uri = resolver.insert(MediaStore.Images.Media.EXTERNAL_CONTENT_URI, values)
                    if out_uri is not None:
                        write_ok = False
                        try:
                            stream = resolver.openOutputStream(out_uri)
                            if stream is not None:
                                try:
                                    stream.write(raw_bytes)
                                    stream.flush()
                                    write_ok = True
                                finally:
                                    stream.close()
                            if write_ok:
                                upd = ContentValues()
                                upd.put("is_pending", JInteger(0))
                                upd.put("width", JInteger(bw))
                                upd.put("height", JInteger(bh))
                                upd.put("_size", JLong(byte_len))
                                upd.put("datetaken", JLong(now_ms))
                                resolver.update(out_uri, upd, None, None)

                                try:
                                    cur = resolver.query(out_uri, ["_data"], None, None, None)
                                    if cur is not None:
                                        try:
                                            if cur.moveToFirst():
                                                fpath = cur.getString(0)
                                                if fpath:
                                                    MediaScannerConnection.scanFile(ctx, [fpath], ["image/png"], None)
                                        finally:
                                            cur.close()
                                except Exception:
                                    pass
                                saved_ok = True
                            else:
                                resolver.delete(out_uri, None, None)
                        except Exception:
                            try:
                                resolver.delete(out_uri, None, None)
                            except Exception:
                                pass
                            raise
                else:
                    from java.io import File as JFile
                    from java.io import FileOutputStream

                    base_type = (
                        Environment.DIRECTORY_DCIM
                        if rel_path.startswith(Environment.DIRECTORY_DCIM)
                        else Environment.DIRECTORY_PICTURES
                    )
                    base_dir = Environment.getExternalStoragePublicDirectory(base_type)
                    shots_dir = JFile(base_dir, "Screenshots")
                    if not shots_dir.exists():
                        shots_dir.mkdirs()
                    out_file = JFile(shots_dir, file_name)
                    fos = FileOutputStream(out_file)
                    try:
                        fos.write(raw_bytes)
                        fos.flush()
                    finally:
                        fos.close()
                    MediaScannerConnection.scanFile(
                        ctx,
                        [out_file.getAbsolutePath()],
                        ["image/png"],
                        None,
                    )
                    saved_ok = True

                if saved_ok:
                    try:
                        run_on_ui_thread(lambda: MediaController.getInstance().loadGalleryPhotosAlbums(0), 250)
                    except Exception:
                        pass

                if saved_ok and should_delete_original and delete_original_uri is not None:
                    def _try_delete_original():
                        try:
                            ctx.getContentResolver().delete(delete_original_uri, None, None)
                        except Exception as del_err:
                            if Build.VERSION.SDK_INT >= 30:
                                try:
                                    from java.util import Collections
                                    pi = MediaStore.createDeleteRequest(
                                        ctx.getContentResolver(),
                                        Collections.singletonList(delete_original_uri),
                                    )
                                    frag = get_last_fragment()
                                    act = frag.getParentActivity() if frag is not None else None
                                    if act is not None and pi is not None:
                                        act.startIntentSenderForResult(pi.getIntentSender(), 9941, None, 0, 0, 0)
                                except Exception:
                                    pass
                            else:
                                pass
                    run_on_ui_thread(_try_delete_original, 450)
            except Exception as e:
                self.logger.exception("Save screenshot error: %s", e)
            finally:
                raw_bytes = None
                try:
                    bitmap.recycle()
                except Exception:
                    pass

            if saved_ok:
                BulletinHelper.show_success(_t("Чистый скриншот сохранён"))
            else:
                BulletinHelper.show_error(_t("Не удалось сохранить скриншот"))

        run_on_queue(_save_task)
