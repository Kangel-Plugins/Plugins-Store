import base64
import zlib
from base_plugin import BasePlugin
from java.nio import ByteBuffer
from dalvik.system import InMemoryDexClassLoader
from org.telegram.messenger import ApplicationLoader
from ui.settings import Switch, Selector, Divider

__id__ = "spam_collapse"
__name__ = "Spam Collapse"
__description__ = "Сворачивает повторяющиеся спам-сообщения / Collapses repeated spam messages"
__author__ = "@dekma0091"
__version__ = "1.1"
__icon__ = "pixelcamera/18"
__min_version__ = "12.5.1"

ENTRY_CLASS = "ni.dekma.spam_collapse.SpamCollapseBridge"
_DEX_BASE64 = ""

class NativeBridge:
    def __init__(self, entry_class_name):
        self.entry_class_name = entry_class_name
        self.target_class = None
        self.is_active = False

    def start(self):
        if self.is_active:
            return
        if self.target_class is None:
            ctx = ApplicationLoader.applicationContext
            if ctx is None:
                raise RuntimeError("Application context is unavailable")
            if not _DEX_BASE64:
                raise RuntimeError("Payload data is missing")
            dex_data = base64.b64decode(_DEX_BASE64)
            try:
                dex_data = zlib.decompress(dex_data)
            except Exception:
                pass
            dex_buffer = ByteBuffer.wrap(dex_data)
            class_loader = InMemoryDexClassLoader(dex_buffer, ctx.getClassLoader())
            self.target_class = class_loader.loadClass(self.entry_class_name)
        try:
            self._invoke_static("load")
            self.is_active = True
        except Exception as load_err:
            try:
                self._invoke_static("unload")
            except Exception:
                pass
            self.is_active = False
            raise RuntimeError(f"Bridge initialization failed: {load_err}") from load_err

    def stop(self):
        if not self.is_active:
            return
        try:
            self._invoke_static("unload")
        except Exception:
            pass
        finally:
            self.is_active = False
            self.target_class = None

    def _invoke_static(self, method_name, *args):
        if self.target_class is None:
            raise RuntimeError("Embedded DEX is not loaded")
        for m in self.target_class.getDeclaredMethods():
            if str(m.getName()) == method_name and len(m.getParameterTypes()) == len(args):
                m.setAccessible(True)
                return m.invoke(None, *args)
        raise RuntimeError(f"Method {method_name} not found")

def _is_en():
    try:
        from org.telegram.messenger import LocaleController
        iso = str(LocaleController.getLocaleStringIso639() or "")
        if iso:
            lower = iso.lower()
            return not (lower.startswith("ru") or lower.startswith("uk") or lower.startswith("be"))
    except Exception:
        pass
    try:
        from java.util import Locale
        loc = Locale.getDefault()
        if loc and loc.getLanguage():
            lower = str(loc.getLanguage()).lower()
            return not (lower.startswith("ru") or lower.startswith("uk") or lower.startswith("be"))
    except Exception:
        pass
    return False

def _tr(ru, en):
    return en if _is_en() else ru

class SpamCollapsePlugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self.bridge = NativeBridge(ENTRY_CLASS)

    def on_plugin_load(self):
        self.bridge.start()

    def on_plugin_unload(self):
        self.bridge.stop()

    def create_settings(self):
        cur_min = self.get_setting("min_count", 0)
        if isinstance(cur_min, int) and cur_min >= 2:
            cur_min = cur_min - 2
        elif not isinstance(cur_min, int) or cur_min < 0 or cur_min > 3:
            cur_min = 0
        return [
            Selector(key="min_count", text=_tr("Минимум повторов", "Minimum repeats"), default=cur_min, items=[_tr("2 раза", "2 times"), _tr("3 раза", "3 times"), _tr("4 раза", "4 times"), _tr("5 раз", "5 times")]),
            Divider(text=_tr("Типы контента", "Content types")),
            Switch(key="collapse_messages", text=_tr("Сворачивать сообщения", "Collapse messages"), default=True),
            Switch(key="collapse_gifs", text=_tr("Сворачивать гифки", "Collapse GIFs"), default=True),
            Switch(key="collapse_stickers", text=_tr("Сворачивать стикеры", "Collapse stickers"), default=True),
            Switch(key="collapse_voice", text=_tr("Сворачивать голосовые", "Collapse voice messages"), default=False),
            Switch(key="collapse_round_video", text=_tr("Сворачивать кружки", "Collapse video messages"), default=False),
            Switch(key="collapse_files", text=_tr("Сворачивать файлы", "Collapse files"), default=False),
        ]
