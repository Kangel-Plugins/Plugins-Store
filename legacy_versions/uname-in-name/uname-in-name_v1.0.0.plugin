TEMPLATE_KEY = "uname-in-name.template"
DEFAULT_TEMPLATE = "{o} | @{u}"

DEX_COMMENT_BEGIN = "# === EMDEDDED DEX BEGIN ==="
DEX_COMMENT_END = "# === EMDEDDED DEX END ==="


