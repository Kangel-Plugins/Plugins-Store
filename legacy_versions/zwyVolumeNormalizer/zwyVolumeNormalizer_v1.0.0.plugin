# slider stops in dB
OFFSETS_DB = tuple(range(-6, 7, 2))

TARGET_LOUDNESS_DB = -14.0
MIN_GAIN_DB = -24.0
MAX_GAIN_DB = 16.0
PEAK_CEILING_DB = -3.0
LEVEL_DEADBAND_DB = 2.0
GAIN_RISE_DB_PER_SEC = 40.0
GAIN_FALL_DB_PER_SEC = 40.0
ABSOLUTE_GATE_DB = -65.0
RELATIVE_GATE_DB = -10.0
SILENT_LEVEL_DB = -120.0
BOOST_EPSILON_DB = 0.05

BLOCK_SECONDS = 0.5
FRAME_SAMPLES = 4
SAMPLE_PHASE_STEP = 37
CURVE_UPDATE_BLOCKS = 8
STOP_CHECK_FRAMES = 32
MAX_ANALYSIS_SECONDS = 900
ANALYSIS_STALL_TIMEOUT = 5.0
CODEC_TIMEOUT_US = 5_000
PCM_ENCODING_FLOAT = 4
QUANT_STEPS_PER_DB = 2
ANALYSIS_VERSION = 2

TICK_MS = 50
PAUSED_TICK_MS = 250
GAIN_SLEW_DB_PER_TICK = 2.0
PUSH_EPSILON_DB = 0.05
NEXT_TRACK_RETRY_SEC = 2.0
LOG_GAIN_STEP_DB = 3.0

MAX_STORED_TRACKS = 200
MAX_LOADED_TRACKS = 32
MAX_TRACKED_PLAYERS = 8

_AU_CHANNEL_ID = 2521243181
_AU_MSG_ID = 139


class S:
    offset_db = SettingEntry("offset_db", 0)
    leveling = SettingEntry("leveling", True, icon="msg_stats")
    debug_mode = SettingEntry("debug_mode", False, icon="msg_log")


logger = zwylib.build_log(__name__)


def get_offset_index() -> int:
    value = S.offset_db.safe_get(int)
    return min(range(len(OFFSETS_DB)), key=lambda i: abs(OFFSETS_DB[i] - value))


def get_offset_db() -> int:
    return OFFSETS_DB[get_offset_index()]


class MC:
    _fields: Dict[str, Any] = {}
    _set_player_volume = None

    @classmethod
    def get(cls, name: str) -> Optional[Any]:
        try:
            field = cls._fields.get(name)
            if field is None:
                field = MediaController.getClass().getDeclaredField(name)
                field.setAccessible(True)
                cls._fields[name] = field
            return field.get(MediaController.getInstance())
        except Exception:
            logger.debug(f"Failed to read '{name}':", exc_info=True)
            return None

    @classmethod
    def refresh_player_volume(cls):
        if cls._set_player_volume is None:
            method = MediaController.getClass().getDeclaredMethod("setPlayerVolume")
            method.setAccessible(True)
            cls._set_player_volume = method
        cls._set_player_volume.invoke(MediaController.getInstance())


def db_to_power(db: float) -> float:
    return 10 ** (db / 10)


def build_curve(
        level: List[float],
        peak: List[float],
        offset_db: float,
        leveling: bool
) -> Tuple[List[float], Optional[float]]:
    audible = [db_to_power(i) for i in level if i > ABSOLUTE_GATE_DB]
    if not audible:
        return [], None

    mean = sum(audible) / len(audible)
    loud = [i for i in audible if i >= mean * db_to_power(RELATIVE_GATE_DB)]
    reference = 10 * math.log10(sum(loud) / len(loud))

    track_ceiling = min(MAX_GAIN_DB, max(PEAK_CEILING_DB - max(peak), 0.0))
    static_gain = min(max(TARGET_LOUDNESS_DB - reference + offset_db, MIN_GAIN_DB), track_ceiling)
    if not leveling:
        return [static_gain] * len(level), static_gain

    gains: List[Optional[float]] = []
    for i, value in enumerate(level):
        if value <= ABSOLUTE_GATE_DB:
            gains.append(None)
            continue

        window_peak = max(peak[max(i - 1, 0):i + 2])
        ceiling = min(MAX_GAIN_DB, max(PEAK_CEILING_DB - window_peak, 0.0))
        deviation = min(max(value - reference, -LEVEL_DEADBAND_DB), LEVEL_DEADBAND_DB)
        wanted = TARGET_LOUDNESS_DB + offset_db - value + deviation
        gains.append(min(max(wanted, MIN_GAIN_DB), ceiling))

    last = next(i for i in gains if i is not None)
    for i, value in enumerate(gains):
        if value is None:
            gains[i] = last
        else:
            last = value

    rise = GAIN_RISE_DB_PER_SEC * BLOCK_SECONDS
    fall = GAIN_FALL_DB_PER_SEC * BLOCK_SECONDS
    for i in range(1, len(gains)):
        gains[i] = min(gains[i], gains[i - 1] + rise)
    for i in range(len(gains) - 2, -1, -1):
        gains[i] = min(gains[i], gains[i + 1] + fall)

    return gains, static_gain


class Timeline:
    def __init__(
            self,
            level: Optional[List[float]] = None,
            peak: Optional[List[float]] = None,
            done: bool = False,
            truncated: bool = False
    ):
        self.level: List[float] = level if level is not None else []
        self.peak: List[float] = peak if peak is not None else []
        self.done = done
        self.truncated = truncated
        self.failed = False
        self.curve: List[float] = []
        self.tail: Optional[float] = None
        self.curve_version = -1

    def reset(self):
        self.level.clear()
        self.peak.clear()
        self.curve = []
        self.tail = None
        self.curve_version = -1

    def rebuild(self, offset_db: float, leveling: bool, version: int):
        count = min(len(self.level), len(self.peak))
        self.curve, self.tail = build_curve(self.level[:count], self.peak[:count], offset_db, leveling)
        self.curve_version = version

    def gain_at(self, position_ms: float) -> Optional[float]:
        curve = self.curve
        if not curve:
            return None

        x = position_ms / (BLOCK_SECONDS * 1000) - 0.5
        if x <= 0:
            return curve[0]

        index = int(x)
        if index >= len(curve) - 1:
            if not self.done or self.truncated:
                return self.tail
            return curve[-1]

        return curve[index] + (curve[index + 1] - curve[index]) * (x - index)


def append_block(timeline: Timeline, square_sum: float, sample_count: int, peak: float):
    mean = square_sum / sample_count if sample_count else 0.0
    timeline.level.append(10 * math.log10(mean) if mean > 1e-12 else SILENT_LEVEL_DB)
    timeline.peak.append(20 * math.log10(peak) if peak > 1e-6 else SILENT_LEVEL_DB)


def decode_levels(
        path: str,
        timeline: Timeline,
        should_stop: Callable[[], bool],
        on_progress: Callable[[], None]
) -> bool:
    extractor = MediaExtractor()
    codec = None
    try:
        extractor.setDataSource(path)

        fmt = None
        for i in range(extractor.getTrackCount()):
            candidate = extractor.getTrackFormat(i)
            mime = candidate.getString(MediaFormat.KEY_MIME)
            if mime is not None and str(mime).startswith("audio/"):
                extractor.selectTrack(i)
                fmt = candidate
                break
        if fmt is None:
            timeline.failed = True
            return True

        sample_rate = fmt.getInteger(MediaFormat.KEY_SAMPLE_RATE) if fmt.containsKey(MediaFormat.KEY_SAMPLE_RATE) else 44100
        channels = fmt.getInteger(MediaFormat.KEY_CHANNEL_COUNT) if fmt.containsKey(MediaFormat.KEY_CHANNEL_COUNT) else 2

        codec = MediaCodec.createDecoderByType(str(fmt.getString(MediaFormat.KEY_MIME)))
        codec.configure(fmt, None, None, 0)
        codec.start()

        info = MediaCodec.BufferInfo()
        native_order = ByteOrder.nativeOrder()
        max_blocks = int(MAX_ANALYSIS_SECONDS / BLOCK_SECONDS)

        bytes_per_sample = 2
        is_float = False
        block_frames = 0
        block_target = max(int(BLOCK_SECONDS * sample_rate), 1)
        square_sum = 0.0
        sample_count = 0
        peak = 0.0
        frame_counter = 0
        input_done = False
        finished = False
        last_output = time.monotonic()

        while not finished:
            if not input_done:
                index = codec.dequeueInputBuffer(0)
                while index >= 0:
                    size = extractor.readSampleData(codec.getInputBuffer(index), 0)
                    if size < 0:
                        codec.queueInputBuffer(index, 0, 0, 0, MediaCodec.BUFFER_FLAG_END_OF_STREAM)
                        input_done = True
                        break

                    codec.queueInputBuffer(index, 0, size, 0, 0)
                    extractor.advance()
                    index = codec.dequeueInputBuffer(0)

            index = codec.dequeueOutputBuffer(info, CODEC_TIMEOUT_US)
            while True:
                if index >= 0:
                    last_output = time.monotonic()
                    size = info.size
                    if size > 0:
                        buffer = codec.getOutputBuffer(index)
                        buffer.order(native_order)
                        offset = info.offset
                        count = size // bytes_per_sample
                        step = max(count // FRAME_SAMPLES, 1)
                        begin = (frame_counter * SAMPLE_PHASE_STEP) % step
                        frame_counter += 1

                        for i in range(FRAME_SAMPLES):
                            position = begin + i * step
                            if position >= count:
                                break

                            if is_float:
                                value = buffer.getFloat(offset + position * 4)
                            else:
                                value = buffer.getShort(offset + position * 2) / 32768
                            square_sum += value * value
                            sample_count += 1
                            peak = max(peak, abs(value))

                        block_frames += count // channels

                    ended = bool(info.flags & MediaCodec.BUFFER_FLAG_END_OF_STREAM)
                    codec.releaseOutputBuffer(index, False)

                    if block_frames >= block_target:
                        append_block(timeline, square_sum, sample_count, peak)
                        block_frames -= block_target
                        square_sum = 0.0
                        sample_count = 0
                        peak = 0.0

                        blocks = len(timeline.level)
                        if blocks % CURVE_UPDATE_BLOCKS == 0:
                            on_progress()
                        if blocks >= max_blocks:
                            timeline.truncated = True
                            ended = True

                    if frame_counter % STOP_CHECK_FRAMES == 0 and should_stop():
                        return False

                    if ended:
                        finished = True
                        break
                elif index == MediaCodec.INFO_OUTPUT_FORMAT_CHANGED:
                    out_format = codec.getOutputFormat()
                    is_float = (
                        out_format.containsKey("pcm-encoding")
                        and out_format.getInteger("pcm-encoding") == PCM_ENCODING_FLOAT
                    )
                    bytes_per_sample = 4 if is_float else 2
                    if out_format.containsKey(MediaFormat.KEY_CHANNEL_COUNT):
                        channels = max(out_format.getInteger(MediaFormat.KEY_CHANNEL_COUNT), 1)
                    if out_format.containsKey(MediaFormat.KEY_SAMPLE_RATE):
                        sample_rate = out_format.getInteger(MediaFormat.KEY_SAMPLE_RATE)
                        block_target = max(int(BLOCK_SECONDS * sample_rate), 1)
                elif index != MediaCodec.INFO_OUTPUT_BUFFERS_CHANGED:
                    break

                index = codec.dequeueOutputBuffer(info, 0)

            if not finished and time.monotonic() - last_output > ANALYSIS_STALL_TIMEOUT:
                timeline.truncated = True
                break

        if sample_count > 0:
            append_block(timeline, square_sum, sample_count, peak)
        return True
    finally:
        try:
            if codec is not None:
                codec.stop()
                codec.release()
        except Exception:
            pass
        extractor.release()


class Analyzer:
    def __init__(self, on_progress: Callable[[Timeline], None], on_finished: Callable[[str, Timeline], None]):
        self._on_progress = on_progress
        self._on_finished = on_finished
        self._condition = threading.Condition()
        self._queue: "OrderedDict[str, Tuple[str, Timeline, bool]]" = OrderedDict()
        self._thread: Optional[threading.Thread] = None
        self._stopped = False

    def submit(self, key: str, path: str, timeline: Timeline, urgent: bool) -> Timeline:
        with self._condition:
            entry = self._queue.get(key)
            if entry is None:
                entry = (path, timeline, urgent)
            elif urgent and not entry[2]:
                entry = (entry[0], entry[1], True)

            if urgent:
                self._queue.clear()
            self._queue[key] = entry

            if self._thread is None:
                self._thread = threading.Thread(target=self._run, name=__id__, daemon=True)
                self._thread.start()
            self._condition.notify()
            return entry[1]

    def stop(self):
        with self._condition:
            self._stopped = True
            self._condition.notify_all()

    def _should_stop(self, key: str) -> bool:
        with self._condition:
            return self._stopped or key not in self._queue or next(iter(self._queue)) != key

    def _run(self):
        while True:
            with self._condition:
                while not self._queue and not self._stopped:
                    self._condition.wait()
                if self._stopped:
                    return

                key = next(iter(self._queue))
                path, timeline, _ = self._queue[key]

            completed = self._process(key, path, timeline)
            if completed:
                with self._condition:
                    self._queue.pop(key, None)

    def _process(self, key: str, path: str, timeline: Timeline) -> bool:
        started = time.monotonic()
        try:
            completed = decode_levels(
                path,
                timeline,
                lambda: self._should_stop(key),
                lambda: self._on_progress(timeline)
            )
        except Exception:
            logger.error(f"Failed to analyze '{path}':", exc_info=True)
            timeline.failed = True
            completed = True

        if not completed:
            logger.debug(f"Analysis of '{key}' was preempted.")
            timeline.reset()
            return False

        timeline.done = True
        if timeline.level and not timeline.failed:
            self._on_progress(timeline)
            self._on_finished(key, timeline)
            elapsed = time.monotonic() - started
            seconds = len(timeline.level) * BLOCK_SECONDS
            logger.debug(f"Analyzed '{key}': {seconds:.0f} s of audio in {elapsed:.2f} s.")
        return True


def get_track_path(message: MessageObject) -> Optional[str]:
    owner = message.messageOwner
    if owner.attachPath and File(owner.attachPath).exists():
        return str(owner.attachPath)

    path = FileLoader.getInstance(message.currentAccount).getPathToMessage(owner)
    if path is not None and path.exists():
        return str(path.getAbsolutePath())
    return None


def get_track_key(message: MessageObject, path: Optional[str]) -> Optional[str]:
    document = message.getDocument()
    if document is not None:
        return f"d{document.id}"
    return f"p{path}" if path else None


def get_next_message(controller: MediaController) -> Optional[MessageObject]:
    playlist = MC.get("shuffledPlaylist") if SharedConfig.shuffleMusic else controller.getPlaylist()
    if playlist is None or playlist.size() < 2:
        return None

    size = playlist.size()
    current = controller.getPlayingMessageObjectNum()
    if not 0 <= current < size:
        return None

    index = current + (1 if SharedConfig.playOrderReversed else -1)
    if index >= size:
        index = 0
    elif index < 0:
        index = size - 1

    message = playlist.get(index)
    return message if message is not None and message.isMusic() else None


class Booster:
    def __init__(self):
        self.player = None
        self.enhancer = None

    def release(self):
        if self.enhancer is not None:
            try:
                self.enhancer.release()
            except Exception:
                logger.debug("Failed to release the loudness enhancer:", exc_info=True)
        self.enhancer = None
        self.player = None

    def apply(self, player, boost_db: float):
        if self.player is not None and not self.player.equals(player):
            self.release()

        if self.enhancer is None and boost_db <= BOOST_EPSILON_DB:
            return

        exo_player = player.player
        session_id = exo_player.getAudioSessionId() if exo_player is not None else 0
        if session_id == 0:
            return

        try:
            if self.enhancer is None:
                self.enhancer = LoudnessEnhancer(session_id)
                self.enhancer.setEnabled(True)
                self.player = player
            self.enhancer.setTargetGain(int(round(boost_db * 100)))
        except Exception:
            logger.error("Failed to apply the boost:", exc_info=True)
            self.release()


class Normalizer:
    def __init__(self):
        self.timelines: "OrderedDict[str, Timeline]" = OrderedDict()
        self.player_scales: "OrderedDict[Any, float]" = OrderedDict()
        self.booster = Booster()
        self.analyzer = Analyzer(self._on_progress, self._on_finished)
        self.store = zwylib.JsonCacheFile("volume_normalizer__loudness", {}, compress=True)

        self.timeline: Optional[Timeline] = None
        self.applied_db: Optional[float] = None
        self.pushed_db: Optional[float] = None
        self.offset_db = 0
        self.leveling = True
        self.settings_version = 0
        self.last_next_check = 0.0
        self.logged_db = 0.0
        self.ticking = False
        self.active = True

    def load_settings(self):
        self.offset_db = get_offset_db()
        self.leveling = bool(S.leveling.safe_get(bool))
        self.settings_version += 1

    def set_offset(self, value: int):
        self.offset_db = value
        self.settings_version += 1

    def set_leveling(self, enabled: bool):
        self.leveling = enabled
        self.settings_version += 1

    def _on_progress(self, timeline: Timeline):
        timeline.rebuild(self.offset_db, self.leveling, self.settings_version)

    def _on_finished(self, key: str, timeline: Timeline):
        count = min(len(timeline.level), len(timeline.peak))

        def encode(values: List[float]) -> str:
            data = bytes(min(max(int(round(-i * QUANT_STEPS_PER_DB)), 0), 255) for i in values)
            return base64.b64encode(data).decode("ascii")

        try:
            content = self.store.content
            content.pop(key, None)
            content[key] = {
                "v": ANALYSIS_VERSION,
                "l": encode(timeline.level[:count]),
                "p": encode(timeline.peak[:count]),
                "t": timeline.truncated,
            }
            while len(content) > MAX_STORED_TRACKS:
                content.pop(next(iter(content)))
            self.store.write()
        except Exception:
            logger.error("Failed to save the analysis:", exc_info=True)

    def _stored_entry(self, key: str) -> Optional[Dict[str, Any]]:
        entry = self.store.content.get(key)
        if isinstance(entry, dict) and entry.get("v") == ANALYSIS_VERSION:
            return entry
        return None

    def _load_stored(self, key: str) -> Optional[Timeline]:
        entry = self._stored_entry(key)
        if entry is None:
            return None

        try:
            level = [-i / QUANT_STEPS_PER_DB for i in base64.b64decode(entry["l"])]
            peak = [-i / QUANT_STEPS_PER_DB for i in base64.b64decode(entry["p"])]
            return Timeline(level, peak, done=True, truncated=bool(entry.get("t")))
        except Exception:
            logger.debug(f"Failed to read the stored analysis of '{key}':", exc_info=True)
            return None

    def _timeline_for(self, key: str, path: Optional[str], urgent: bool) -> Optional[Timeline]:
        timeline = self.timelines.get(key)
        if timeline is None:
            timeline = self._load_stored(key)
            if timeline is not None:
                logger.debug(f"Loaded the stored analysis of '{key}'.")
            elif path is not None:
                timeline = Timeline()
                logger.debug(f"Analyzing '{key}' (urgent: {urgent}).")
            else:
                return None

        if not timeline.done and path is not None:
            timeline = self.analyzer.submit(key, path, timeline, urgent)

        self.timelines[key] = timeline
        self.timelines.move_to_end(key)
        while len(self.timelines) > MAX_LOADED_TRACKS:
            self.timelines.popitem(last=False)
        return timeline

    def _target_db(self, timeline: Optional[Timeline], position_ms: float) -> float:
        if timeline is not None:
            if timeline.curve_version != self.settings_version:
                timeline.rebuild(self.offset_db, self.leveling, self.settings_version)

            gain = timeline.gain_at(position_ms)
            if gain is not None:
                return gain

        return min(max(float(self.offset_db), MIN_GAIN_DB), MAX_GAIN_DB)

    def on_track(self, message: MessageObject):
        path = get_track_path(message)
        key = get_track_key(message, path)
        timeline = self._timeline_for(key, path, urgent=True) if key is not None else None

        if timeline is not None and timeline is self.timeline and self.applied_db is not None:
            return

        self.timeline = timeline
        self.applied_db = self._target_db(timeline, 0.0)
        self.pushed_db = None
        self.last_next_check = 0.0

    def on_other_media(self):
        self.timeline = None
        self.applied_db = None
        self.pushed_db = None
        self.booster.release()

    def on_track_started(self):
        self.last_next_check = 0.0
        self.ensure_ticking()

    def scale_for(self, player) -> Optional[float]:
        current = MC.get("audioPlayer")
        if current is None or not current.equals(player):
            return self.player_scales.get(player)

        scale = 1.0 if self.applied_db is None else 10 ** (min(self.applied_db, 0.0) / 20)
        self.player_scales[player] = scale
        self.player_scales.move_to_end(player)
        while len(self.player_scales) > MAX_TRACKED_PLAYERS:
            self.player_scales.popitem(last=False)
        return scale

    def ensure_ticking(self):
        if self.ticking or not self.active:
            return

        self.ticking = True
        run_on_ui_thread(self._tick)

    def _tick(self):
        try:
            delay = self._update()
        except Exception:
            logger.error("An error occurred while updating the gain:", exc_info=True)
            delay = PAUSED_TICK_MS

        if delay is None or not self.active:
            self.ticking = False
            return

        run_on_ui_thread(self._tick, delay)

    def _update(self) -> Optional[int]:
        controller = MediaController.getInstance()
        message = controller.getPlayingMessageObject()
        if message is None or not message.isMusic():
            return None

        player = MC.get("audioPlayer")
        if player is None or controller.isMessagePaused():
            return PAUSED_TICK_MS

        target = self._target_db(self.timeline, player.getCurrentPosition())
        if self.applied_db is None:
            self.applied_db = target
        else:
            delta = min(max(target - self.applied_db, -GAIN_SLEW_DB_PER_TICK), GAIN_SLEW_DB_PER_TICK)
            self.applied_db += delta

        if self.pushed_db is None or abs(self.applied_db - self.pushed_db) >= PUSH_EPSILON_DB:
            self._push(player)
            if abs(self.applied_db - self.logged_db) >= LOG_GAIN_STEP_DB:
                self.logged_db = self.applied_db
                logger.debug(f"Gain {self.applied_db:+.1f} dB at {player.getCurrentPosition() / 1000:.1f} s.")

        self._preanalyze_next(controller)
        return TICK_MS

    def _push(self, player):
        self.pushed_db = self.applied_db
        self.booster.apply(player, max(self.applied_db, 0.0))
        MC.refresh_player_volume()

    def _preanalyze_next(self, controller: MediaController):
        now = time.monotonic()
        if now - self.last_next_check < NEXT_TRACK_RETRY_SEC:
            return

        self.last_next_check = now
        message = get_next_message(controller)
        if message is None:
            return

        path = get_track_path(message)
        key = get_track_key(message, path)
        if key is None or path is None or self._stored_entry(key) is not None:
            return

        self._timeline_for(key, path, urgent=False)

    def refresh(self):
        self.ensure_ticking()

    def shutdown(self):
        self.active = False
        self.analyzer.stop()
        self.timeline = None
        self.applied_db = None
        self.player_scales.clear()
        try:
            player = MC.get("audioPlayer")
            self.booster.release()
            if player is not None:
                MC.refresh_player_volume()
        except Exception:
            logger.debug("Failed to restore the volume:", exc_info=True)


normalizer = Normalizer()


def set_volume_before_hook(param):
    scale = normalizer.scale_for(param.thisObject)
    if scale is None or scale >= 1.0:
        return

    param.args[0] = jfloat(param.args[0] * scale)


def play_message_before_hook(param):
    message: MessageObject = param.args[0]
    if message is None:
        return

    if message.isMusic():
        normalizer.on_track(message)
    else:
        normalizer.on_other_media()


def play_message_after_hook(param):
    message: MessageObject = param.args[0]
    if message is not None and message.isMusic():
        normalizer.on_track_started()


def build_offset_slider() -> Custom:
    def on_choose(index: int):
        item.intValue = index
        # reloading would rebuild the settings page right under the finger
        SettingsManager.set(S.offset_db.plugin_id, S.offset_db, OFFSETS_DB[index], reload_settings=False)
        normalizer.set_offset(OFFSETS_DB[index])
        normalizer.refresh()

    # UItem.asSlideView(String[] choices, int chosen, Utilities.Callback<Integer> whenChose)
    item = UItem.asSlideView(
        jarray(String)([f"{i:+d}" if i else "0" for i in OFFSETS_DB]),
        get_offset_index(),
        zwylib.Callback1(on_choose)
    )
    return Custom(item=item)


class VolumeNormalizer(BasePlugin):
    def on_plugin_load(self):
        logger.setLevel(logging.DEBUG if S.debug_mode.get() else logging.INFO)
        zwylib.add_autoupdater_task(__id__, _AU_CHANNEL_ID, _AU_MSG_ID)
        normalizer.load_settings()

        media_controller = MediaController.getClass()
        play_message = HookUtils.find_max_args_method(media_controller, "playMessage")
        set_volume = HookUtils.find_max_args_method(jclass("org.telegram.ui.Components.VideoPlayer").getClass(), "setVolume")

        if not play_message or not set_volume:
            logger.error("Failed to hook the player methods.")
            return

        HookUtils.hook_before(play_message, play_message_before_hook)
        HookUtils.hook_after(play_message, play_message_after_hook)
        HookUtils.hook_before(set_volume, set_volume_before_hook)

        def init_current():
            message = MediaController.getInstance().getPlayingMessageObject()
            if message is not None and message.isMusic():
                normalizer.on_track(message)
                normalizer.on_track_started()

        run_on_ui_thread(init_current)
        logger.info("Loaded.")

    def on_plugin_unload(self):
        zwylib.remove_autoupdater_task(__id__)
        run_on_ui_thread(normalizer.shutdown)
        logger.info("Unloaded.")

    def create_settings(self):
        try:
            return [
                Header(f"{L.prefs_offset}, {L.db}"),
                build_offset_slider(),
                Divider(L.prefs_offset_hint),
                S.leveling.as_switch(
                    text=L.prefs_leveling,
                    on_change=lambda enabled: (normalizer.set_leveling(bool(enabled)), normalizer.refresh())
                ),
                Divider(L.prefs_leveling_hint),
                S.debug_mode.as_switch(
                    text=L.prefs_debug_mode,
                    on_change=lambda enabled: logger.setLevel(logging.DEBUG if enabled else logging.INFO)
                ),
            ]
        except Exception as e:
            logger.error("An error occurred while generating settings:", exc_info=True)
            trace = zwylib.format_exc_from(e)
            return [
                Divider(f"An error occurred while generating settings:\n{zwylib.format_exc_only(e)}"),
                Text(
                    text="Copy full traceback",
                    icon="msg_copy",
                    on_click=lambda v: copy_to_clipboard(trace)
                )
            ]
