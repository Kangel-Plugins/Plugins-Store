                    p_spswitch.rightMargin = dp(8)
                    sp_btn_row.addView(b_spswitch, p_spswitch)

                    b_spdisc = _make_button("Отключить", lambda: _show_disconnect_dialog("Spotify", _on_sp_disable, _on_sp_clear))
                    p_spdisc = LinearLayout.LayoutParams(0, -2, 0.9)
                    sp_btn_row.addView(b_spdisc, p_spdisc)
                elif sp_has_session and not sp_enabled:
                    b_spenable = _make_button("Включить", _on_sp_enable, is_accent=True)
                    p_spenable = LinearLayout.LayoutParams(0, -2, 1.0)
                    p_spenable.rightMargin = dp(8)
                    sp_btn_row.addView(b_spenable, p_spenable)

                    b_spclear = _make_button("Очистить", _on_sp_clear)
                    p_spclear = LinearLayout.LayoutParams(0, -2, 1.0)
                    sp_btn_row.addView(b_spclear, p_spclear)
                else:
                    b_splogin = _make_button("Войти", lambda: (_dismiss_all(), plugin._open_spotify_auth(on_success=lambda: _ui())), is_accent=True)
                    p_splogin = LinearLayout.LayoutParams(0, -2, 1.2)
                    p_splogin.rightMargin = dp(8)
                    sp_btn_row.addView(b_splogin, p_splogin)

                    b_sptoken = _make_button("Ввести токен", lambda: plugin._open_spotify_token_input_dialog(act, on_done=lambda: _ui()))
                    p_sptoken = LinearLayout.LayoutParams(0, -2, 1.0)
                    sp_btn_row.addView(b_sptoken, p_sptoken)

                # Dialog setup
                builder = AlertDialogBuilder(act)
                builder.set_title(L.g("external_platforms_title"))
                builder.set_view(scroll)
                builder.set_positive_button(L.g("close"), lambda d, *a: d.dismiss())
                dlg = builder.create()
                dlg_ref[0] = dlg
                dlg.show()

            except Exception as e:
                plugin.log(f"open external platforms error: {e}\n{traceback.format_exc()}")
                BulletinHelper.show_error(str(e))

        run_on_ui_thread(_ui)

    def _open_ym_token_input_dialog(self, act, on_done=None):
        plugin = self
        try:
            from android.widget import LinearLayout, EditText
            from org.telegram.messenger import AndroidUtilities
            builder = AlertDialogBuilder(act)
            builder.set_title(L.g("ym_token_input_title"))

            container = LinearLayout(act)
            container.setOrientation(LinearLayout.VERTICAL)
            container.setPadding(AndroidUtilities.dp(20), AndroidUtilities.dp(8), AndroidUtilities.dp(20), AndroidUtilities.dp(8))

            et = EditText(act)
            et.setHint(L.g("ym_token_input_hint"))
            cur_tok = str(plugin.get_setting("yandex_token", "") or "")
            if cur_tok:
                et.setText(cur_tok)
                et.setSelection(len(cur_tok))
            container.addView(et)
            builder.set_view(container)

            def on_save(dialog, which):
                new_t = str(et.getText()).strip()
                plugin.set_setting("yandex_token", new_t, reload_settings=True)
                dialog.dismiss()
                BulletinHelper.show_success(L.g("ym_token_saved"))
                if on_done:
                    on_done()

            builder.set_positive_button(L.g("save"), on_save)
            builder.set_negative_button(L.g("close"), lambda d, *a: d.dismiss())
            builder.show()
        except Exception as e:
            plugin.log(f"token input dialog error: {e}")

    def _parse_ytm_date(self, shelf_title: str, last_date: datetime.date) -> datetime.date:
        if not shelf_title:
            return last_date
        st = shelf_title.strip().lower()
        now_d = datetime.now().date()
        if "сегодня" in st or "today" in st:
            return now_d
        if "вчера" in st or "yesterday" in st:
            return now_d - timedelta(days=1)

        ru_days = {"понедельник": 0, "вторник": 1, "среда": 2, "четверг": 3, "пятница": 4, "суббота": 5, "воскресенье": 6}
        en_days = {"monday": 0, "tuesday": 1, "wednesday": 2, "thursday": 3, "friday": 4, "saturday": 5, "sunday": 6}
        for name, wd in list(ru_days.items()) + list(en_days.items()):
            if name in st:
                diff = (now_d.weekday() - wd) % 7
                if diff == 0:
                    diff = 7
                return now_d - timedelta(days=diff)

        ru_months = {"янв": 1, "фев": 2, "мар": 3, "апр": 4, "май": 5, "мая": 5, "июн": 6, "июл": 7, "авг": 8, "сен": 9, "окт": 10, "ноя": 11, "дек": 12}
        en_months = {"jan": 1, "feb": 2, "mar": 3, "apr": 4, "may": 5, "jun": 6, "jul": 7, "aug": 8, "sep": 9, "oct": 10, "nov": 11, "dec": 12}
        all_months = dict(ru_months)
        all_months.update(en_months)

        m = re.search(r'(\d{1,2})\s+([а-яa-z]+)(?:\s+(\d{4}))?', st)
        if m:
            day_num = int(m.group(1))
            m_word = m.group(2)[:3]
            year_num = int(m.group(3)) if m.group(3) else now_d.year
            if m_word in all_months:
                month_num = all_months[m_word]
                if not m.group(3) and (month_num > now_d.month or (month_num == now_d.month and day_num > now_d.day)):
                    year_num -= 1
                try:
                    return datetime(year_num, month_num, day_num).date()
                except Exception:
                    pass

        if "на прошлой неделе" in st or "last week" in st:
            return now_d - timedelta(days=7)
        if "в этом месяце" in st or "this month" in st:
            return now_d - timedelta(days=14)
        if "в прошлом месяце" in st or "last month" in st:
            return now_d - timedelta(days=35)
        if "ранее" in st or "earlier" in st or "старше" in st or "older" in st:
            return last_date - timedelta(days=7)

        return last_date

    def _fetch_ytm_all_history(self, cookie_str: str, progress_cb=None) -> Tuple[List[Dict[str, Any]], str]:
        self.log("Fetching full YTM history...")
        try:
            from android.webkit import CookieManager
            cm = CookieManager.getInstance()
            raw_music = cm.getCookie("https://music.youtube.com")
            if raw_music and ("SAPISID=" in raw_music or "__Secure-3PAPISID=" in raw_music):
                if raw_music != cookie_str:
                    cookie_str = raw_music
                    self.set_setting("ytm_cookie", cookie_str)
        except Exception as e:
            self.log(f"CookieManager note: {e}")

        match = re.search(r'(?:^|;\s*)__Secure-3PAPISID=([^;]+)', cookie_str)
        if not match:
            match = re.search(r'(?:^|;\s*)SAPISID=([^;]+)', cookie_str)
        if not match:
            raise ValueError("SAPISID cookie not found in session. Пожалуйста, выполните вход в YouTube Music.")

        sapisid = match.group(1).strip().strip('"')
        origin = "https://music.youtube.com"
        timestamp = int(time.time())
        hash_hex = hashlib.sha1(f"{timestamp} {sapisid} {origin}".encode("utf-8")).hexdigest()
        auth_header = f"SAPISIDHASH {timestamp}_{hash_hex}"

        client_ver = f"1.{datetime.now(timezone.utc).strftime('%Y%m%d')}.01.00"
        headers = {
            "Authorization": auth_header,
            "Cookie": cookie_str,
            "Content-Type": "application/json",
            "Origin": origin,
            "Referer": "https://music.youtube.com/",
            "X-Origin": origin,
            "X-Goog-AuthUser": "0",
            "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
        }

        payload = {
            "context": {
                "client": {
                    "clientName": "WEB_REMIX",
                    "clientVersion": client_ver,
                    "hl": "ru",
                    "gl": "RU",
                }
            },
            "browseId": "FEmusic_history",
        }
        body = json.dumps(payload).encode("utf-8")
        url = "https://music.youtube.com/youtubei/v1/browse?alt=json&key=AIzaSyC9XL3ZjWddXya6X74dJoCTL-WEYFDNX30"

        raw = self._fetch_bytes(url, headers=headers, data=body, timeout=15)
        data = json.loads(raw.decode("utf-8", errors="ignore"))

        sec_list_renderer = (
            data.get("contents", {})
            .get("singleColumnBrowseResultsRenderer", {})
            .get("tabs", [{}])[0]
            .get("tabRenderer", {})
            .get("content", {})
            .get("sectionListRenderer", {})
        ) or {}
        contents = sec_list_renderer.get("contents", []) or []

        flat_sections = []
        for sec in contents:
            if not isinstance(sec, dict):
                continue
            if "itemSectionRenderer" in sec:
                isr_contents = sec["itemSectionRenderer"].get("contents", []) or []
                for sub in isr_contents:
                    if isinstance(sub, dict):
                        flat_sections.append(sub)
            else:
                flat_sections.append(sec)

        auth_error_notice = None
        for sec in flat_sections:
            msg_r = sec.get("messageRenderer") or sec.get("musicNotifierShelfRenderer")
            if msg_r:
                runs = (
                    msg_r.get("text", {}).get("runs", [])
                    or msg_r.get("title", {}).get("runs", [])
                    or []
                )
                notice = "".join(r.get("text", "") for r in runs).strip()
                if notice:
                    if any(w in notice.lower() for w in ("войдите", "sign in", "login", "аккаунт", "account")):
                        auth_error_notice = notice

        if auth_error_notice:
            raise ValueError(f"{auth_error_notice} (требуется вход в YouTube Music)")

        target_shelves = []
        for shelf in flat_sections:
            renderer = shelf.get("musicShelfRenderer") or shelf.get("musicCarouselShelfRenderer")
            if not renderer:
                continue
            title_runs = renderer.get("title", {}).get("runs", [])
            shelf_title = "".join(r.get("text", "") for r in title_runs).strip()
            target_shelves.append((shelf_title, renderer))

        def _find_continuation_token(sec_node, items_list):
            if isinstance(sec_node, dict):
                for c in sec_node.get("continuations", []) or []:
                    t = c.get("nextContinuationData", {}).get("continuation")
                    if t:
                        return str(t)
            for it in reversed(items_list or []):
                if isinstance(it, dict) and "continuationItemRenderer" in it:
                    c_cmd = it["continuationItemRenderer"].get("continuationEndpoint", {}).get("continuationCommand", {})
                    t = c_cmd.get("token")
                    if t:
                        return str(t)
            return None

        curr_token = _find_continuation_token(sec_list_renderer, contents)
        cont_step = 0
        max_steps = 60
        while curr_token and cont_step < max_steps:
            cont_step += 1
            if progress_cb:
                try:
                    progress_cb(cont_step, max_steps, len(target_shelves))
                except Exception:
                    pass

            cont_url = f"https://music.youtube.com/youtubei/v1/browse?continuation={urllib.parse.quote(curr_token)}&alt=json&key=AIzaSyC9XL3ZjWddXya6X74dJoCTL-WEYFDNX30"
            cont_payload = {"context": payload["context"]}
            try:
                cont_raw = self._fetch_bytes(
                    cont_url,
                    headers=headers,
                    data=json.dumps(cont_payload).encode("utf-8"),
                    timeout=15,
                )
                cont_data = json.loads(cont_raw.decode("utf-8", errors="ignore"))
            except Exception as ex:
                self.log(f"YTM continuation fetch exception: {ex}")
                break

            next_token = None
            new_sections = []

            # Format A
            sl_cont = cont_data.get("continuationContents", {}).get("sectionListContinuation", {})
            if sl_cont:
                sl_items = sl_cont.get("contents", []) or []
                new_sections.extend(sl_items)
                next_token = _find_continuation_token(sl_cont, sl_items)

            # Format B
            actions = cont_data.get("onResponseReceivedActions", []) or []
            for act in actions:
                act_items = act.get("appendContinuationItemsAction", {}).get("continuationItems", []) or []
                for it in act_items:
                    if isinstance(it, dict):
                        if "continuationItemRenderer" in it:
                            c_cmd = it["continuationItemRenderer"].get("continuationEndpoint", {}).get("continuationCommand", {})
                            if c_cmd.get("token"):
                                next_token = str(c_cmd.get("token"))
                        else:
                            new_sections.append(it)

            # Format C
            ms_cont = cont_data.get("continuationContents", {}).get("musicShelfContinuation", {})
            if ms_cont:
                ms_items = ms_cont.get("contents", []) or []
                if target_shelves and ms_items:
                    last_title, last_shelf = target_shelves[-1]
                    last_shelf.setdefault("contents", []).extend(ms_items)
                next_token = _find_continuation_token(ms_cont, ms_items)

            for sec in new_sections:
                renderer = sec.get("musicShelfRenderer") or sec.get("musicCarouselShelfRenderer")
                if not renderer:
                    continue
                title_runs = renderer.get("title", {}).get("runs", [])
                shelf_title = "".join(r.get("text", "") for r in title_runs).strip()
                target_shelves.append((shelf_title, renderer))

            if not next_token or next_token == curr_token:
                break
            curr_token = next_token

        tracks = []
        curr_date = datetime.now().date()
        for shelf_title, shelf in target_shelves:
            curr_date = self._parse_ytm_date(shelf_title, curr_date)
            date_str = curr_date.strftime("%Y-%m-%d")
            items = shelf.get("contents", []) or []
            for it in items:
                renderer = it.get("musicResponsiveListItemRenderer")
                if not renderer:
                    continue
                flex_cols = renderer.get("flexColumns", []) or []
                if not flex_cols:
                    continue

                col0_runs = (
                    flex_cols[0]
                    .get("musicResponsiveListItemFlexColumnRenderer", {})
                    .get("text", {})
                    .get("runs", [])
                ) or []
                title = "".join(r.get("text", "") for r in col0_runs).strip()
                video_id = ""
                for r in col0_runs:
                    endpoint = r.get("navigationEndpoint", {})
                    v_id = endpoint.get("watchEndpoint", {}).get("videoId")
                    if v_id:
                        video_id = str(v_id)
                        break

                col1_runs = (
                    flex_cols[1]
                    .get("musicResponsiveListItemFlexColumnRenderer", {})
                    .get("text", {})
                    .get("runs", [])
                ) if len(flex_cols) > 1 else []

                artist_parts = []
                for r in col1_runs:
                    t = r.get("text", "")
                    if t.strip() in ("•", "•", "/", "|"):
                        break
                    artist_parts.append(t)
                artist = "".join(artist_parts).strip() or "Unknown Artist"

                dur_sec = 0
                fixed_cols = renderer.get("fixedColumns", []) or []
                for fc in fixed_cols:
                    fixed_item = fc.get("musicResponsiveListItemFixedColumnRenderer", {})
                    text_obj = fixed_item.get("text", {})
                    dur_str = text_obj.get("simpleText") or ""
                    if not dur_str:
                        runs = text_obj.get("runs", []) or []
                        dur_str = "".join(r.get("text", "") for r in runs).strip()
                    if dur_str and re.match(r"^\d+:\d{2}(:\d{2})?$", dur_str.strip()):
                        parts = dur_str.strip().split(":")
                        try:
                            if len(parts) == 2:
                                dur_sec = int(parts[0]) * 60 + int(parts[1])
                            elif len(parts) == 3:
                                dur_sec = int(parts[0]) * 3600 + int(parts[1]) * 60 + int(parts[2])
                            break
                        except Exception:
                            dur_sec = 0

                if dur_sec == 0:
                    for fc in flex_cols:
                        fc_item = fc.get("musicResponsiveListItemFlexColumnRenderer", {})
                        for r in fc_item.get("text", {}).get("runs", []) or []:
                            clean_t = r.get("text", "").strip()
                            if re.match(r"^\d+:\d{2}(:\d{2})?$", clean_t):
                                parts = clean_t.split(":")
                                try:
                                    if len(parts) == 2:
                                        dur_sec = int(parts[0]) * 60 + int(parts[1])
                                    elif len(parts) == 3:
                                        dur_sec = int(parts[0]) * 3600 + int(parts[1]) * 60 + int(parts[2])
                                    break
                                except Exception:
                                    dur_sec = 0
                        if dur_sec > 0:
                            break

                if title:
                    tracks.append({
                        "id": video_id,
                        "title": title,
                        "artist": artist,
                        "duration": dur_sec,
                        "date": date_str,
                        "play_id": f"ytm_{video_id}_{date_str}" if video_id else f"ytm_{artist}_{title}_{date_str}_{dur_sec}",
                    })

        self.log(f"YTM total tracks parsed: {len(tracks)}")
        return tracks, "YouTube Music"

    def _start_full_ytm_sync(self, act=None):
        plugin = self
        cookie_str = str(self.get_setting("ytm_cookie", "") or "").strip()
        if not cookie_str:
            BulletinHelper.show_error(L.g("ytm_not_authorized_yet"))
            return

        self.dex.call("pyShowYmProgress", "YouTube Music")

        def _bg_sync():
            total_added = 0
            total_skipped = 0
            try:
                self.log("YTM sync: starting background sync...")
                self.dex.call("pyUpdateYmProgress", json.dumps({
                    "percent": 5,
                    "status": L.g("sync_starting_ytm"),
                    "added": 0,
                    "skipped": 0
                }))

                def _progress_cb(step, max_s, shelves_cnt):
                    pct = min(45, 5 + int((step * 40) / max_s))
                    st_text = f"Загрузка истории... (шаг {step}, секций {shelves_cnt})"
                    plugin.dex.call("pyUpdateYmProgress", json.dumps({
                        "percent": pct,
                        "status": st_text,
                        "added": 0,
                        "skipped": 0
                    }))

                tracks, _ = self._fetch_ytm_all_history(cookie_str, progress_cb=_progress_cb)
                total_tracks_count = len(tracks)
                self.log(f"YTM sync: importing {total_tracks_count} tracks...")

                batch_size = 50
                batch = []
                for i, t in enumerate(tracks):
                    pid = t.get("play_id")
                    if pid and pid in self._ym_synced_ids:
                        total_skipped += 1
                    else:
                        if pid:
                            self._ym_synced_ids.add(pid)
                        total_added += 1
                        batch.append({
                            "date": t["date"],
                            "title": t["title"],
                            "artist": t["artist"],
                            "duration": t["duration"],
                        })

                    if len(batch) >= batch_size or (i + 1 == total_tracks_count and batch):
                        self.dex.call("pyImportYmTracks", json.dumps(batch))
                        batch = []

                    if total_tracks_count > 0 and (i % 25 == 0 or i + 1 == total_tracks_count):
                        pct = 50 + int(((i + 1) * 50) / total_tracks_count)
                        st_text = f"Импорт трека {i + 1} из {total_tracks_count}..."
                        self.dex.call("pyUpdateYmProgress", json.dumps({
                            "percent": pct,
                            "status": st_text,
                            "added": total_added,
                            "skipped": total_skipped
                        }))

                self._save_synced_ids()
                self.dex.call("pyFinishYmProgress", json.dumps({
                    "summary": L.g("sync_finished_ytm"),
                    "added": total_added,
                    "skipped": total_skipped
                }))
            except Exception as e:
                self.log(f"YTM sync error: {e}\n{traceback.format_exc()}")
                self.dex.call("pyFinishYmProgress", json.dumps({
                    "summary": f"Ошибка: {e}",
                    "added": total_added,
                    "skipped": total_skipped
                }))

        threading.Thread(target=_bg_sync, daemon=True).start()

    def _open_ytm_auth(self, view=None, *args, **kwargs):
        plugin = self

        def _ui():
            try:
                from org.telegram.messenger import AndroidUtilities
                from android.webkit import CookieManager, WebView, WebViewClient
                from android.widget import LinearLayout, EditText
                from android.view import View, WindowManager
                from android.content import DialogInterface

                frag = get_last_fragment()
                act = frag.getParentActivity() if frag else None
                if not act:
                    return

                is_closed = [False]
                dlg_ref = [None]
                real_dialog_ref = [None]

                def _get_all_ytm_cookies(cm):
                    collected = {}
                    urls = [
                        "https://youtube.com",
                        "https://music.youtube.com",
                    ]
                    for u in urls:
                        try:
                            raw = cm.getCookie(u)
                            if raw:
                                for pair in str(raw).split(";"):
                                    pair = pair.strip()
                                    if "=" in pair:
                                        k, v = pair.split("=", 1)
                                        k = k.strip()
                                        v = v.strip()
                                        if k:
                                            collected[k] = v
                        except Exception as e:
                            plugin.log(f"getCookie error for {u}: {e}")
                    cookie_str = "; ".join(f"{k}={v}" for k, v in collected.items())
                    return collected, cookie_str

                builder = AlertDialogBuilder(act)
                builder.set_title(L.g("ytm_login_title"))

                container = LinearLayout(act)
                container.setOrientation(LinearLayout.VERTICAL)

                try:
                    dummy_et = EditText(act)
                    dummy_et.setVisibility(View.GONE)
                    container.addView(dummy_et)
                except Exception:
                    pass

                try:
                    wv = WebView(act)
                except (Exception, BaseException) as e_wv:
                    plugin.log(f"YTM auth WebView creation failed: {e_wv}")
                    plugin._show_webview_error_dialog(act)
                    return
                wv.setFocusable(True)
                wv.setFocusableInTouchMode(True)
                wv.requestFocus(View.FOCUS_DOWN)
                wv.setWebViewClient(WebViewClient())

                try:
                    class WVTouchListener(dynamic_proxy(View.OnTouchListener)):
                        def onTouch(self, v, event):
                            action = event.getAction()
                            if action in (0, 1):
                                if not v.hasFocus():
                                    v.requestFocus()
                                    v.requestFocusFromTouch()
                            return False

                    wv.setOnTouchListener(WVTouchListener())
                except Exception as e:
                    plugin.log(f"setOnTouchListener error: {e}")

                ws = wv.getSettings()
                ws.setJavaScriptEnabled(True)
                ws.setDomStorageEnabled(True)
                ws.setUserAgentString("Mozilla/5.0 (Linux; Android 13; SM-S918B) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/114.0.0.0 Mobile Safari/537.36")

                cm = CookieManager.getInstance()
                cm.setAcceptCookie(True)
                try:
                    cm.setAcceptThirdPartyCookies(wv, True)
                except Exception:
                    pass

                params = LinearLayout.LayoutParams(-1, AndroidUtilities.dp(500))
                container.addView(wv, params)
                builder.set_view(container)

                def _cleanup_webview():
                    try:
                        wv.stopLoading()
                        wv.loadUrl("about:blank")
                        wv.clearHistory()
                        p = wv.getParent()
                        if p:
                            p.removeView(wv)
                        wv.destroy()
                    except Exception:
                        pass

                def _on_success(cookie_str):
                    if is_closed[0]:
                        return
                    is_closed[0] = True
                    plugin.set_setting("ytm_cookie", cookie_str, reload_settings=True)

                    def _dismiss_and_notify():
                        d = dlg_ref[0]
                        rd = real_dialog_ref[0]
                        try:
                            if d is not None and hasattr(d, "dismiss"):
                                d.dismiss()
                        except Exception:
                            pass
                        try:
                            if rd is not None and hasattr(rd, "dismiss"):
                                rd.dismiss()
                        except Exception:
                            pass
                        _cleanup_webview()
                        BulletinHelper.show_success(L.g("ytm_login_success"))

                    run_on_ui_thread(_dismiss_and_notify)

                def _on_done_clicked(d, *a):
                    try:
                        cm_inst = CookieManager.getInstance()
                        cm_inst.flush()
                        raw_music = cm_inst.getCookie("https://music.youtube.com") or ""
                        if "SAPISID=" in raw_music or "__Secure-3PAPISID=" in raw_music:
                            cookies_dict, cookie_str = _get_all_ytm_cookies(cm_inst)
                            _on_success(cookie_str)
                        else:
                            BulletinHelper.show_error(L.g("ytm_not_authorized_yet"))
                    except Exception as ex:
                        plugin.log(f"on_done_clicked error: {ex}")
                        BulletinHelper.show_error(str(ex))

                def _on_close_clicked(d, *a):
                    is_closed[0] = True
                    try:
                        d.dismiss()
                    except Exception:
                        pass
                    _cleanup_webview()

                builder.set_positive_button(L.g("check_login_done"), _on_done_clicked)
                builder.set_negative_button(L.g("close"), _on_close_clicked)

                dlg = builder.create()
                dlg_ref[0] = dlg
                dlg.show()

                real_dialog = None
                for obj in (dlg, builder):
                    if hasattr(obj, "get_dialog"):
                        try:
                            real_dialog = obj.get_dialog()
                            if real_dialog is not None:
                                break
                        except Exception:
                            pass
                    if hasattr(obj, "_dialog"):
                        try:
                            real_dialog = getattr(obj, "_dialog")
                            if real_dialog is not None:
                                break
                        except Exception:
                            pass

                if real_dialog is None:
                    real_dialog = dlg
                real_dialog_ref[0] = real_dialog

                try:
                    if hasattr(real_dialog, "setFocusable"):
                        real_dialog.setFocusable(True)
                except Exception as e:
                    plugin.log(f"setFocusable error: {e}")

                try:
                    win = None
                    if hasattr(real_dialog, "getWindow"):
                        win = real_dialog.getWindow()
                    elif hasattr(dlg, "getWindow"):
                        win = dlg.getWindow()

                    if win is not None:
                        win.clearFlags(
                            WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE
                            | WindowManager.LayoutParams.FLAG_ALT_FOCUSABLE_IM
                        )
                        win.setSoftInputMode(WindowManager.LayoutParams.SOFT_INPUT_ADJUST_RESIZE)
                except Exception as e:
                    plugin.log(f"window flags error: {e}")

                try:
                    class DismissProxy(dynamic_proxy(DialogInterface.OnDismissListener)):
                        def onDismiss(self, dialog):
                            is_closed[0] = True
                            _cleanup_webview()

                    if hasattr(real_dialog, "setOnDismissListener"):
                        real_dialog.setOnDismissListener(DismissProxy())
                except Exception as e:
                    plugin.log(f"setOnDismissListener error: {e}")

                wv.loadUrl("https://accounts.google.com/ServiceLogin?service=youtube&continue=https://music.youtube.com/&prompt=select_account")

                def _is_dlg_showing():
                    if is_closed[0]:
                        return False
                    for target in (real_dialog_ref[0], dlg_ref[0]):
                        if target is not None and hasattr(target, "isShowing"):
                            try:
                                return bool(target.isShowing())
                            except Exception:
                                pass
                    return True

                def _poll():
                    try:
                        cm_inst = CookieManager.getInstance()
                        for _ in range(300):
                            time.sleep(1)
                            if is_closed[0]:
                                break
                            if not _is_dlg_showing():
                                break
                            raw_music = cm_inst.getCookie("https://music.youtube.com") or ""
                            if "SAPISID=" in raw_music or "__Secure-3PAPISID=" in raw_music:
                                cookies_dict, cookie_str = _get_all_ytm_cookies(cm_inst)
                                cm_inst.flush()
                                _on_success(cookie_str)
                                break
                    except Exception as e:
                        plugin.log(f"ytm auth poll exception: {e}")

                threading.Thread(target=_poll, daemon=True).start()

            except Exception as e:
                plugin.log(f"ytm auth open error: {e}")
                BulletinHelper.show_error(str(e))

        run_on_ui_thread(_ui)

    def _clear_ytm_session(self):
        self.set_setting("ytm_cookie", "", reload_settings=True)
        try:
            from android.webkit import CookieManager, WebStorage
            cm = CookieManager.getInstance()
            try:
                cm.removeAllCookies(None)
            except Exception:
                try:
                    cm.removeAllCookie()
                except Exception:
                    pass
            try:
                cm.removeSessionCookies(None)
            except Exception:
                try:
                    cm.removeSessionCookie()
                except Exception:
                    pass
            try:
                cm.flush()
            except Exception:
                pass
            try:
                WebStorage.getInstance().deleteAllData()
            except Exception:
                pass
            self.log("YTM session completely cleared")
        except Exception as e:
            self.log(f"clear ytm session error: {e}")

    def _schedule_startup_ytm_sync(self):
        if not self.get_setting("ytm_enabled", True):
            return
        cookie = str(self.get_setting("ytm_cookie", "") or "").strip()
        if not cookie:
            return

        plugin = self
        def _bg():
            time.sleep(4.0)
            try:
                plugin.log("YTM startup sync: checking history...")
                tracks, _ = plugin._fetch_ytm_all_history(cookie)
                if not tracks:
                    return
                new_tracks = []
                for t in tracks:
                    pid = t.get("play_id")
                    if pid and pid in plugin._ym_synced_ids:
                        continue
                    if pid:
                        plugin._ym_synced_ids.add(pid)
                    new_tracks.append({
                        "date": t["date"],
                        "title": t["title"],
                        "artist": t["artist"],
                        "duration": t["duration"],
                    })
                if new_tracks:
                    plugin.dex.call("pyImportYmTracks", json.dumps(new_tracks))
                    plugin._save_synced_ids()
                    plugin.log(f"YTM startup sync: imported {len(new_tracks)} new tracks")
            except Exception as e:
                plugin.log(f"YTM startup sync failed: {e}")

        threading.Thread(target=_bg, daemon=True).start()

