    @classmethod
    def g(cls, key: str, *args) -> str:
        if cls.app_language == 1:
            is_ru = True
        elif cls.app_language == 2:
            is_ru = False
        else:
            try:
                lang = LocaleController.getInstance().getCurrentLocale().getLanguage()
            except Exception:
                lang = "ru"
            is_ru = lang.startswith("ru")
        entry = cls._T.get(key)
        if not entry:
            return key
        val = entry.get("ru", entry.get("en", key)) if is_ru else entry.get("en", key)
        if args:
            try:
                return val.format(*args)
            except Exception:
                return val
        return val


class Dex:
    def __init__(self, ec: str):
        self.ec = ec
        self.clazz = None
        self.loaded = False
        self.loading = False
        self._m = {}

    def load(self):
        if self.loaded or self.loading:
            return
        self.loading = True
        try:
            if self.clazz is None:
                ctx = ApplicationLoader.applicationContext
                if not ctx:
                    raise RuntimeError("Application context is null")
                raw = self._read_payload()
                loader_cls = jclass("dalvik.system.InMemoryDexClassLoader")
                loader = loader_cls(jclass("java.nio.ByteBuffer").wrap(raw), ctx.getClassLoader())
                clazz = loader.loadClass(self.ec)
                self.clazz = clazz
                self._m = {}
                for m in self.clazz.getDeclaredMethods():
                    m.setAccessible(True)
                    name = str(m.getName())
                    if name not in self._m:
                        self._m[name] = []
                    self._m[name].append(m)
            if "load" in self._m:
                self._invoke_best("load")
            self.loaded = True
            self.loading = False
        except Exception:
            self.loading = False
            traceback.print_exc()

    def unload(self):
        try:
            if self.loaded and "unload" in self._m:
                self._invoke_best("unload")
        except Exception:
            traceback.print_exc()
        self.loaded = False

    def call(self, name: str, *args):
        try:
            if not self.loaded:
                self.load()
            if self.loaded and name in self._m:
                return self._invoke_best(name, *args)
        except Exception:
            traceback.print_exc()
        return None

    def _invoke_best(self, name: str, *args):
        methods = self._m.get(name, [])
        for m in methods:
            if len(m.getParameterTypes()) == len(args):
                try:
                    return m.invoke(None, *args)
                except TypeError:
                    return m.invoke(None, list(args))
        if methods:
            try:
                return methods[0].invoke(None, *args)
            except TypeError:
                return methods[0].invoke(None, list(args))
        return None

    def _read_payload(self) -> bytes:
        with open(__file__, "r", encoding="utf-8") as f:
            t = f.read()
        if "# " + DEX_BEGIN not in t or "# " + DEX_END not in t:
            raise RuntimeError("DEX markers missing in plugin file")
        b = t.split("# " + DEX_BEGIN, 1)[1].split("# " + DEX_END, 1)[0]
        p = "".join(l.strip()[1:].strip() for l in b.splitlines() if l.strip().startswith("#"))
        if not p:
            raise RuntimeError("DEX payload empty")
        return zlib.decompress(base64.b64decode(p))


class MusicStats(BasePlugin):

    def __init__(self):
        super().__init__()
        self.dex = Dex(ENTRY_CLASS)
        self._unhooks = []
        self._ym_synced_ids = set()
        self._synced_track_ids = self._ym_synced_ids

    def on_plugin_load(self):
        self.log("music_stats: plugin loaded")
        self.dex.load()
        self._ym_synced_ids = self._load_synced_ids()
        self._synced_track_ids = self._ym_synced_ids
        self._schedule_startup_ym_sync()
        self._schedule_startup_ytm_sync()
        self._schedule_startup_spotify_sync()
        self._install_open_hook()
        try:
            self.dex.call("pySetNotifyStreak", bool(self.get_setting("notify_streak", True)))
            self.dex.call("pySetNotifyYearReview", bool(self.get_setting("notify_year_review", True)))
            ign = self.get_setting("ignore_accounts", None)
            if ign is None:
                old_sep = self.get_setting("separate_accounts", None)
                if old_sep is not None:
                    ign = not bool(old_sep)
                    self.set_setting("ignore_accounts", ign)
                else:
                    ign = True
                    self.set_setting("ignore_accounts", True)
            self.dex.call("pySetIgnoreAccounts", bool(ign))
            self.dex.call("pySetUiStyle", int(self.get_setting("ui_style", 0)))
            lang_val = int(self.get_setting("app_language", 0) or 0)
            L.app_language = lang_val
            try:
                from org.telegram.messenger import ApplicationLoader
                if ApplicationLoader.applicationContext:
                    ApplicationLoader.applicationContext.getSharedPreferences("music_stats_prefs", 0).edit().putInt("app_language", lang_val).apply()
            except Exception:
                pass
            self.dex.call("pySetLanguage", lang_val)
        except Exception as e:
            self.log(f"Sync settings error: {e}")
        try:
            timer = threading.Timer(2.0, lambda: run_on_ui_thread(self._check_year_review_startup_popup))
            timer.daemon = True
            timer.start()
        except Exception as e:
            self.log(f"Timer error: {e}")

    def on_plugin_unload(self):
        self.log("music_stats: plugin unloaded")
        for u in self._unhooks:
            try:
                u.unhook()
            except Exception:
                pass
        self._unhooks.clear()
        self.dex.unload()

    def _install_open_hook(self):
        plugin = self
        class OpenForViewHook(MethodHook):
            def before_hooked_method(hook_self, param):
                try:
                    args = param.args
                    if args is None or len(args) == 0:
                        return
                    arg0 = args[0]
                    if arg0 is None:
                        return
                    cls_name = str(arg0.getClass().getName())
                    if "MessageObject" in cls_name:
                        fn = str(arg0.getFileName())
                        if fn.endswith(".ms_backup"):
                            param.setResult(True)
                            run_on_ui_thread(lambda: plugin._handle_backup_file(arg0))
                            return
                    elif "File" in cls_name:
                        fn = str(arg0.getName())
                        if fn.endswith(".ms_backup"):
                            param.setResult(True)
                            run_on_ui_thread(lambda: plugin._handle_backup_file_from_path(str(arg0.getAbsolutePath())))
                            return
                except Exception as ex:
                    plugin.log(f"openForView hook error: {ex}")

        try:
            AU_cls = jclass("org.telegram.messenger.AndroidUtilities").getClass()
            for m in AU_cls.getDeclaredMethods():
                if str(m.getName()) == "openForView":
                    m.setAccessible(True)
                    u = self.hook_method(m, OpenForViewHook())
                    if u:
                        self._unhooks.append(u)
        except Exception as e:
            self.log(f"openForView hook install error: {e}")

    def _handle_backup_file_from_path(self, fpath: str):
        try:
            with open(fpath, "r", encoding="utf-8") as bf:
                content = bf.read()
            if not content:
                BulletinHelper.show_error(L.g("import_error"))
                return
            self._show_import_confirm(content)
        except Exception as e:
            self.log(f"handle_backup_file_from_path error: {e}")
            BulletinHelper.show_error(L.g("import_error"))

    def _handle_backup_file(self, message):
        try:
            doc = message.getDocument()
            if doc is None:
                return
            acc = int(UserConfig.selectedAccount)
            fl = FileLoader.getInstance(acc)
            f = fl.getPathToAttach(doc)
            if f is None or not f.exists():
                try:
                    f = fl.getPathToMessage(message.messageOwner)
                except Exception:
                    f = None
            if f is None or not f.exists():
                fl.loadFile(doc, message, 1, 0)
                BulletinHelper.show_info(L.g("downloading_file"))
                return

            with open(str(f.getAbsolutePath()), "r", encoding="utf-8") as bf:
                content = bf.read()
            if not content:
                BulletinHelper.show_error(L.g("import_error"))
                return

            self._show_import_confirm(content)
        except Exception as e:
            self.log(f"handle_backup_file error: {e}\n{traceback.format_exc()}")
            BulletinHelper.show_error(L.g("import_error"))

    def _show_import_confirm(self, content: str):
        act = None
        try:
            frag = get_last_fragment()
            if frag:
                act = frag.getParentActivity()
        except Exception:
            pass
        if not act:
            try:
                from org.telegram.ui import LaunchActivity
                act = LaunchActivity.instance
            except Exception:
                pass
        if not act:
            return

        def on_apply(dlg, which):
            try:
                dlg.dismiss()
            except Exception:
                pass
            try:
                ok = self.dex.call("pyImportStats", content)
                if ok:
                    BulletinHelper.show_success(L.g("import_done"))
                else:
                    BulletinHelper.show_error(L.g("import_error"))
            except Exception as ex:
                self.log(f"Import error: {ex}")
                BulletinHelper.show_error(L.g("import_error"))

        def on_cancel(dlg, which):
            try:
                dlg.dismiss()
            except Exception:
                pass

        builder = AlertDialogBuilder(act)
        builder.set_title(L.g("import_title"))
        builder.set_message(L.g("import_confirm"))
        builder.set_positive_button(L.g("import_btn"), on_apply)
        builder.set_negative_button(L.g("cancel"), on_cancel)
        builder.show()

    def _export_to_peer(self, peer_id: int):
        def _bg():
            try:
                data_json = self.dex.call("pyExportStats")
                if not data_json:
                    self.log("pyExportStats returned null or empty")
                    run_on_ui_thread(lambda: BulletinHelper.show_error(L.g("export_error")))
                    return
                cache_dir = str(ApplicationLoader.applicationContext.getCacheDir().getAbsolutePath())
                export_dir = os.path.join(cache_dir, "music_stats_export")
                os.makedirs(export_dir, exist_ok=True)
                import datetime
                dt_str = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")
                file_path = os.path.join(export_dir, f"music_stats_{dt_str}.ms_backup")
                with open(file_path, "w", encoding="utf-8") as f:
                    f.write(str(data_json))
                send_document(int(peer_id), file_path)
                run_on_ui_thread(lambda: BulletinHelper.show_success(L.g("export_done")))
            except Exception as e:
                self.log(f"Export error: {e}\n{traceback.format_exc()}")
                run_on_ui_thread(lambda: BulletinHelper.show_error(L.g("export_error")))
        threading.Thread(target=_bg, daemon=True).start()

    def _open_chat_picker(self):
        try:
            frag = get_last_fragment()
            if not frag:
                return

            DA = jclass("org.telegram.ui.DialogsActivity")
            DelCls = jclass("org.telegram.ui.DialogsActivity$DialogsActivityDelegate")

            args = Bundle()
            args.putBoolean("onlySelect", True)
            args.putBoolean("canSelectTopics", True)
            args.putBoolean("checkCanWrite", True)
            args.putBoolean("resetDelegate", True)
            act = DA(args)

            plugin = self

            class PickerDelegate(dynamic_proxy(DelCls)):
                def didSelectDialogs(s_self, dialogs_act, dids, message, b1, b2, i1, i2, topics_frag):
                    try:
                        if dids and dids.size() > 0:
                            first = dids.get(0)
                            if hasattr(first, "dialogId"):
                                chosen_id = int(first.dialogId)
                            else:
                                chosen_id = int(first)
                            run_on_ui_thread(lambda: plugin._export_to_peer(chosen_id))
                    except Exception as e:
                        plugin.log(f"didSelectDialogs error: {e}")
                    finally:
                        try:
                            if topics_frag is not None:
                                topics_frag.finishFragment()
                        except Exception:
                            pass
                        try:
                            if dialogs_act is not None:
                                dialogs_act.finishFragment()
                        except Exception:
                            pass
                    return True

                def canSelectStories(s_self):
                    return False

                def didSelectStories(s_self, fragment):
                    return False

            act.setDelegate(PickerDelegate())
            frag.presentFragment(act)
        except Exception as e:
            self.log(f"open_chat_picker error: {e}\n{traceback.format_exc()}")

    def _on_export_click(self, view=None, *args, **kwargs):
        act = None
        if view is not None:
            try:
                act = view.getContext()
            except Exception:
                pass
        if not act:
            try:
                frag = get_last_fragment()
                if frag:
                    act = frag.getParentActivity()
            except Exception:
                pass
        if not act:
            return

        def on_saved(dlg, which):
            try:
                dlg.dismiss()
            except Exception:
                pass
            try:
                acc = int(UserConfig.selectedAccount)
                my_id = int(UserConfig.getInstance(acc).getClientUserId())
                self._export_to_peer(my_id)
            except Exception as e:
                self.log(f"Saved messages export error: {e}")

        def on_choose_chat(dlg, which):
            try:
                dlg.dismiss()
            except Exception:
                pass
            self._open_chat_picker()

        builder = AlertDialogBuilder(act)
        builder.set_title(L.g("export_title"))
        builder.set_positive_button(L.g("export_to_saved"), on_saved)
        builder.set_negative_button(L.g("export_to_chat"), on_choose_chat)
        builder.show()

    def _on_ui_style_change(self, val):
        try:
            style_idx = int(val) if val is not None else 0
            self.dex.call("pySetUiStyle", style_idx)
            self.set_setting("ui_style", style_idx)
        except Exception as e:
            self.log(f"UI style change error: {e}")

    def _on_ignore_accounts_change(self, value: bool):
        plugin = self
        val = bool(value)
        if val:
            has_data = False
            try:
                has_data = bool(self.dex.call("pyHasSeparateAccountData"))
            except Exception as e:
                self.log(f"Check separate data error: {e}")

            if has_data:
                def _do_merge(*a, **k):
                    try:
                        plugin.dex.call("pyMergeAllAccountsData")
                        plugin.dex.call("pySetIgnoreAccounts", True)
                        plugin.set_setting("ignore_accounts", True)
                        run_on_ui_thread(lambda: BulletinHelper.show_info(L.g("accounts_merged_done")))
                    except Exception as ex:
                        plugin.log(f"Merge accounts error: {ex}")
                        run_on_ui_thread(lambda: BulletinHelper.show_error(str(ex)))

                def _do_skip(*a, **k):
                    try:
                        plugin.dex.call("pySetIgnoreAccounts", True)
                        plugin.set_setting("ignore_accounts", True)
                    except Exception as ex:
                        plugin.log(f"Set ignore accounts error: {ex}")

                def _do_cancel(*a, **k):
                    plugin.set_setting("ignore_accounts", False)
                    try:
                        frag = get_last_fragment()
                        if frag and hasattr(frag, "getListView"):
                            lv = frag.getListView()
                            if lv and lv.getAdapter():
                                lv.getAdapter().notifyDataSetChanged()
                    except Exception:
                        pass

                run_on_ui_thread(lambda: self._show_merge_confirm_dialog(_do_merge, _do_skip, _do_cancel))
                return

        try:
            self.dex.call("pySetIgnoreAccounts", val)
            self.set_setting("ignore_accounts", val)
        except Exception as e:
            self.log(f"ignore accounts change error: {e}")

    def _show_merge_confirm_dialog(self, on_merge, on_skip, on_cancel):
        try:
            act = None
            last_frag = get_last_fragment()
            if last_frag:
                act = last_frag.getParentActivity()
            builder = AlertDialogBuilder(act) if act else AlertDialogBuilder()
            builder.set_title(L.g("merge_accounts_title"))
            builder.set_message(L.g("merge_accounts_msg"))
            builder.set_positive_button(L.g("merge_accounts_btn"), on_merge)
            builder.set_negative_button(L.g("merge_accounts_skip"), on_skip)
            builder.show()
        except Exception as e:
            self.log(f"Show merge dialog error: {e}")
            if on_skip:
                on_skip()

    def create_settings(self) -> List[Any]:
        items: List[Any] = []

        # Section 0: Channel Card at the very top
        if HAS_CUSTOM_SETTING:
            items.append(self._get_channel_card_factory())
        else:
            items.append(
                Text(
                    text="Max Extera Plugins",
                    subtext="@MaxExteraPlugins",
                    icon="msg_channel",
                    on_click=lambda view=None, *a, **k: self._open_channel(view),
                )
            )

        # Section 1: Music Statistics Screen
        items.append(Header(text=L.g("stats_section")))
        items.append(
            Text(
                text=L.g("open_stats"),
                icon="msg_round_listen",
                on_click=lambda view=None, *a, **k: self._open_stats(view),
            )
        )

        items.append(Divider())

        # Section 2: Display & Account Settings
        items.append(Header(text=L.g("settings_section")))
        items.append(
            Selector(
                key="app_language",
                text=L.g("language_title"),
                default=0,
                items=[L.g("lang_auto"), L.g("lang_ru"), L.g("lang_en")],
                icon="msg_language",
                on_change=lambda v: self._on_app_language_change(v),
            )
        )
        items.append(
            Switch(
                key="ignore_accounts",
                text=L.g("ignore_accounts"),
                default=True,
                subtext=L.g("ignore_accounts_sub"),
                icon="msg_user",
                on_change=lambda v: self._on_ignore_accounts_change(v),
            )
        )
        items.append(
            Switch(
                key="show_in_settings",
                text=L.g("show_in_settings"),
                default=True,
                subtext=L.g("show_in_settings_sub"),
                on_change=lambda v: self._on_show_in_settings_change(v),
            )
        )

        items.append(Divider())

        # Section 3: Notifications & Events
        items.append(Header(text=L.g("notifications_section")))
        items.append(
            Switch(
                key="notify_streak",
                text=L.g("notify_streak"),
                default=True,
                subtext=L.g("notify_streak_sub"),
                icon="msg_flame",
                on_change=lambda v: self._on_notify_streak_change(v),
            )
        )
        items.append(
            Switch(
                key="notify_year_review",
                text=L.g("notify_year_review"),
                default=True,
                subtext=L.g("notify_year_review_sub"),
                icon="msg_round_listen",
                on_change=lambda v: self._on_notify_year_review_change(v),
            )
        )


        items.append(Divider())

        # Section: External Platforms
        items.append(Header(text=L.g("external_platforms_section")))
        items.append(
            Text(
                text=L.g("external_platforms_title"),
                subtext=L.g("external_platforms_sub"),
                icon="msg_retry",
                on_click=lambda view=None, *a, **k: self._open_external_platforms_dialog(view),
            )
        )

        items.append(Divider())

        # Section 3: Backup & Export
        items.append(Header(text=L.g("backup_section")))
        items.append(
            Text(
                text=L.g("export_stats"),
                subtext=L.g("export_stats_sub"),
                icon="msg_saved",
                on_click=lambda view=None, *a, **k: self._on_export_click(view),
            )
        )

        items.append(Divider())

        # Section 4: Actions
        items.append(Header(text=L.g("actions_section")))
        items.append(
            Text(
                text=L.g("reset_stats"),
                subtext=L.g("reset_stats_sub"),
                icon="msg_delete",
                red=True,
                on_click=lambda view=None, *a, **k: self._confirm_reset_stats(view),
            )
        )

        return items

    def _open_channel(self, view=None):
        try:
            from org.telegram.messenger.browser import Browser
            from org.telegram.messenger import ApplicationLoader
            ctx = view.getContext() if view is not None else ApplicationLoader.applicationContext
            Browser.openUrl(ctx, "https://t.me/MaxExteraPlugins")
        except Exception as e:
            self.log(f"Failed to open channel: {e}")

    def _get_channel_card_factory(self):
        plugin = self

        def _create_view(context, list_view=None, current_account=None, class_guid=None, resources_provider=None):
            from android.widget import LinearLayout, FrameLayout, TextView
            from android.view import Gravity
            from android.graphics import Typeface
            from android_utils import OnClickListener
            from org.telegram.messenger import AndroidUtilities
            from org.telegram.ui.ActionBar import Theme
            from android.graphics.drawable import GradientDrawable

            def dp(px):
                return AndroidUtilities.dp(float(px))

            def _round_bg(color, radius_px):
                gd = GradientDrawable()
                gd.setColor(color)
                gd.setCornerRadius(float(radius_px))
                return gd

            root = LinearLayout(context)
            root.setOrientation(LinearLayout.VERTICAL)
            root.setPadding(dp(14), dp(8), dp(14), dp(4))

            card = LinearLayout(context)
            card.setOrientation(LinearLayout.HORIZONTAL)
            card.setGravity(Gravity.CENTER_VERTICAL)
            card.setPadding(dp(14), dp(12), dp(14), dp(12))
            card.setBackground(_round_bg(Theme.getColor(Theme.key_windowBackgroundWhite), dp(16)))

            icon_box = FrameLayout(context)
            accent_col = Theme.getColor(Theme.key_featuredStickers_addButton)
            icon_box.setBackground(_round_bg(accent_col, dp(12)))

            icon_tv = TextView(context)
            icon_tv.setText("📢")
            icon_tv.setTextSize(20.0)
            icon_tv.setGravity(Gravity.CENTER)
            icon_box.addView(icon_tv, FrameLayout.LayoutParams(-1, -1))
            card.addView(icon_box, LinearLayout.LayoutParams(dp(44), dp(44)))

            col = LinearLayout(context)
            col.setOrientation(LinearLayout.VERTICAL)
            lp_col = LinearLayout.LayoutParams(0, -2, 1.0)
            lp_col.setMargins(dp(12), 0, 0, 0)
            card.addView(col, lp_col)

            title_tv = TextView(context)
            title_tv.setText("Max Extera Plugins")
            title_tv.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText))
            title_tv.setTextSize(15.0)
            title_tv.setTypeface(None, Typeface.BOLD)
            col.addView(title_tv)

            sub_tv = TextView(context)
            sub_tv.setText("@MaxExteraPlugins")
            sub_tv.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText))
            sub_tv.setTextSize(13.0)
            col.addView(sub_tv)

            arrow = TextView(context)
            arrow.setText("›")
            arrow.setTextSize(24.0)
            arrow.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText))
            card.addView(arrow, LinearLayout.LayoutParams(-2, -2))

            root.addView(card, LinearLayout.LayoutParams(-1, -2))
            card.setOnClickListener(OnClickListener(lambda v: plugin._open_channel(v)))
            return root

        def _bind_view(view, item=None, divider=None, adapter=None, list_view=None):
            pass

        return SimpleSettingFactory(_create_view, _bind_view, is_clickable=False, is_shadow=False)

    def _check_year_review_startup_popup(self):
        try:
            self.dex.call("pyCheckYearReviewStartupPopup")
        except Exception as e:
            self.log(f"checkYearReviewStartupPopup error: {e}")


    def _on_notify_streak_change(self, value: bool):
        try:
            self.dex.call("pySetNotifyStreak", bool(value))
        except Exception as e:
            self.log(f"notify streak change error: {e}")

    def _on_notify_year_review_change(self, value: bool):
        try:
            self.dex.call("pySetNotifyYearReview", bool(value))
        except Exception as e:
            self.log(f"notify year review change error: {e}")


    def _open_stats(self, view=None, *args, **kwargs):
        self.log(f"music_stats: _open_stats called with view={view}")
        try:
            if view is not None:
                self.dex.call("pyOpenStats", view)
            else:
                self.dex.call("pyOpenStats")
        except Exception as e:
            self.log(f"open stats error: {e}\n{traceback.format_exc()}")

    def _on_show_in_settings_change(self, value: bool):
        try:
            self.dex.call("pySetShowInSettings", bool(value))
            BulletinHelper.show_info(L.g("show_in_settings_restart"))
        except Exception as e:
            self.log(f"show in settings change error: {e}")

    def _confirm_reset_stats(self, view=None, *args, **kwargs):
        self.log(f"music_stats: _confirm_reset_stats called with view={view}")
        act = None
        if view is not None:
            try:
                ctx = view.getContext()
                if ctx:
                    act = ctx
            except Exception:
                pass

        if not act:
            try:
                frag = get_last_fragment()
                if frag:
                    act = frag.getParentActivity()
            except Exception:
                pass

        if not act:
            try:
                from org.telegram.ui import LaunchActivity
                act = LaunchActivity.instance
            except Exception:
                pass

        if not act:
            self.log("Cannot show dialog: activity is null")
            return

        def on_reset(dialog, which):
            try:
                dialog.dismiss()
            except Exception:
                pass
            self.dex.call("pyResetStats")
            self._ym_synced_ids.clear()
            self.set_setting("ym_synced_ids_v2", [])
            self.set_setting("ym_duplicates_cleaned_v1", False)
            try:
                p = self._get_synced_ids_path()
                if p and os.path.exists(p):
                    os.remove(p)
            except Exception:
                pass
            try:
                BulletinHelper.show_success(L.g("stats_reset_done"))
            except Exception:
                pass

        def on_cancel(dialog, which):
            try:
                dialog.dismiss()
            except Exception:
                pass

        try:
            builder = AlertDialogBuilder(act)
            builder.set_title(L.g("reset_title"))
            builder.set_message(L.g("reset_confirm"))
            builder.set_positive_button(L.g("reset_btn"), on_reset)
            builder.set_negative_button(L.g("cancel"), on_cancel)
            builder.show()
        except Exception as e:
            self.log(f"dialog error: {e}\n{traceback.format_exc()}")



    # ------------------------------------------------------------------
    # Yandex Music Sync & Network Methods
    # ------------------------------------------------------------------

    def _get_synced_ids_path(self) -> str:
        ctx = ApplicationLoader.applicationContext
        if not ctx:
            try:
                frag = get_last_fragment()
                if frag and frag.getParentActivity():
                    ctx = frag.getParentActivity().getApplicationContext()
            except Exception:
                pass
        if ctx:
            try:
                files_dir = ctx.getFilesDir()
                if files_dir:
                    return os.path.join(files_dir.getAbsolutePath(), "ym_synced_ids.json")
            except Exception:
                pass
        return ""

    def _load_synced_ids(self) -> set:
        s = set()
        try:
            stored = self.get_setting("ym_synced_ids_v2", None)
            if isinstance(stored, list):
                s.update(stored)
        except Exception as e:
            self.log(f"Error loading ym_synced_ids from settings: {e}")

        try:
            p = self._get_synced_ids_path()
            if p and os.path.exists(p):
                with open(p, "r", encoding="utf-8") as f:
                    data = json.load(f)
                    if isinstance(data, list):
                        s.update(data)
        except Exception as e:
            self.log(f"Error loading ym_synced_ids from file: {e}")
        return s

    def _save_synced_ids(self):
        try:
            ids_list = list(self._ym_synced_ids)
            self.set_setting("ym_synced_ids_v2", ids_list[-2000:] if len(ids_list) > 2000 else ids_list)
        except Exception as e:
            self.log(f"Error saving ym_synced_ids to settings: {e}")

        try:
            p = self._get_synced_ids_path()
            if p:
                with open(p, "w", encoding="utf-8") as f:
                    json.dump(list(self._ym_synced_ids), f)
        except Exception as e:
            self.log(f"Error saving ym_synced_ids to file: {e}")

    def _get_api_headers(self, token: str = "") -> dict:
        headers = {
            "User-Agent": "YandexMusic/2024.08.1 (Android; Pixel 7)",
            "Accept": "application/json",
        }
        clean = (token or "").strip()
        if clean:
            if not clean.lower().startswith("oauth "):
                clean = f"OAuth {clean}"
            headers["Authorization"] = clean
        return headers

    def _fetch_bytes(self, url: str, headers: Optional[dict] = None, data: Optional[bytes] = None, timeout: int = 15) -> bytes:
        try:
            req = urllib.request.Request(url, data=data, headers=headers or {})
            ctx = ssl.create_default_context()
            ctx.check_hostname = False
            ctx.verify_mode = ssl.CERT_NONE
            with urllib.request.urlopen(req, timeout=timeout, context=ctx) as resp:
                return resp.read()
        except Exception as e_urllib:
            try:
                j_url = URL(url)
                conn = j_url.openConnection()
                conn.setConnectTimeout(timeout * 1000)
                conn.setReadTimeout(timeout * 1000)
                conn.setInstanceFollowRedirects(True)
                if data:
                    conn.setDoOutput(True)
                    conn.setRequestMethod("POST")
                if headers:
                    for k, v in headers.items():
                        conn.setRequestProperty(str(k), str(v))
                if data:
                    os_stream = conn.getOutputStream()
                    os_stream.write(data)
                    os_stream.flush()
                    os_stream.close()
                else:
                    conn.connect()
                stream = conn.getInputStream()
                baos = io.BytesIO()
                buf = bytearray(32 * 1024)
                while True:
                    n = stream.read(buf)
                    if n <= 0:
                        break
                    baos.write(buf[:n])
                stream.close()
                conn.disconnect()
                return baos.getvalue()
            except Exception as e_java:
                self.log(f"_fetch_bytes failed for {url[:60]}: urllib={e_urllib}, java={e_java}")
                raise e_urllib

    def _verify_token(self, token: str):
        url = f"{API_BASE}/account/status"
        try:
            data = json.loads(self._fetch_bytes(url, headers=self._get_api_headers(token), timeout=10))
            res = data.get("result", {})
            acc = res.get("account", {})
            name = acc.get("displayName") or acc.get("fullName") or acc.get("login") or "User"
            has_plus = bool(res.get("plus", {}).get("hasPlus", False))
            plus_str = " (Plus: OK)" if has_plus else " (No Plus)"
            return True, f"{name}{plus_str}"
        except Exception as e:
            return False, str(e)

    def _fetch_tracks_info(self, track_ids: List[str], token: str) -> Dict[str, Dict[str, Any]]:
        result = {}
        if not track_ids:
            return result
        headers = self._get_api_headers(token)
        chunk_size = 50
        for i in range(0, len(track_ids), chunk_size):
            chunk = track_ids[i:i + chunk_size]
            encoded_ids = urllib.parse.quote(",".join(chunk))
            url = f"{API_BASE}/tracks?track-ids={encoded_ids}"
            try:
                resp_bytes = self._fetch_bytes(url, headers=headers, timeout=15)
                data = json.loads(resp_bytes.decode("utf-8", errors="ignore"))
                items = data.get("result", []) or []
                for item in items:
                    if not isinstance(item, dict):
                        continue
                    t_id = str(item.get("id") or "")
                    title = str(item.get("title") or "")
                    artists_list = item.get("artists", []) or []
                    artists = ", ".join([
                        str(a.get("name", "")) for a in artists_list
                        if isinstance(a, dict) and a.get("name")
                    ]) or L.g("unknown_artist")
                    dur_ms = item.get("durationMs") or item.get("duration_ms") or 0
                    try:
                        dur_sec = max(0, int(dur_ms) // 1000)
                    except Exception:
                        dur_sec = 0
                    result[t_id] = {
                        "id": t_id,
                        "title": title,
                        "artist": artists,
                        "duration_sec": dur_sec,
                    }
            except Exception as e:
                self.log(f"Error batch fetching tracks: {e}")
        return result

    def _fetch_all_history(self, token: str) -> List[Dict[str, Any]]:
        url = f"{API_BASE}/music-history?fullModelsCount=100"
        resp_bytes = self._fetch_bytes(url, headers=self._get_api_headers(token), timeout=20)
        data = json.loads(resp_bytes.decode("utf-8", errors="ignore"))
        res = data.get("result", {})
        return res.get("historyTabs", []) or []

    def _make_play_id(self, tab_date: str, item: dict, idx: int, t_id: str) -> str:
        data_obj = item.get("data") if isinstance(item.get("data"), dict) else {}
        ts = (
            item.get("timestamp")
            or item.get("playedAt")
            or item.get("time")
            or data_obj.get("timestamp")
            or data_obj.get("playedAt")
            or data_obj.get("time")
        )
        item_id = item.get("id") or data_obj.get("id")
        if ts:
            return f"ym_{tab_date}_{t_id}_{ts}"
        if item_id:
            return f"ym_{tab_date}_{t_id}_{item_id}"
        return f"ym_{tab_date}_{t_id}_{idx}"

    def _extract_tab_tracks(self, tab: dict, token: str) -> List[Dict[str, Any]]:
        tab_date = str(tab.get("date") or "")
        groups = tab.get("items", []) or []
        tracks = []
        missing_ids = []
        raw_items_all = []

        for g in groups:
            if not isinstance(g, dict):
                continue
            group_tracks = g.get("tracks")
            raw_items = group_tracks if isinstance(group_tracks, list) else [g]
            for it in raw_items:
                if isinstance(it, dict):
                    raw_items_all.append(it)

        total_items = len(raw_items_all)
        for i, item in enumerate(raw_items_all):
            stable_idx = (total_items - 1) - i
            data_obj = item.get("data", {}) if isinstance(item.get("data"), dict) else {}
            item_id_obj = data_obj.get("itemId") or data_obj.get("item_id") or {}
            t_id = ""
            if isinstance(item_id_obj, dict):
                t_id = str(item_id_obj.get("trackId") or item_id_obj.get("track_id") or item_id_obj.get("id") or "")

            full_model = data_obj.get("fullModel") or data_obj.get("full_model") or {}
            if not t_id and isinstance(full_model, dict):
                t_id = str(full_model.get("id") or "")

            play_id = self._make_play_id(tab_date, item, stable_idx, t_id)

            if isinstance(full_model, dict) and full_model.get("title"):
                title = str(full_model.get("title") or "")
                artists_list = full_model.get("artists", []) or []
                artists = ", ".join([
                    str(a.get("name", "")) for a in artists_list
                    if isinstance(a, dict) and a.get("name")
                ]) or L.g("unknown_artist")
                dur_ms = full_model.get("durationMs") or full_model.get("duration_ms") or 0
                try:
                    dur_sec = max(0, int(dur_ms) // 1000)
                except Exception:
                    dur_sec = 0
                tracks.append({
                    "play_id": play_id,
                    "date": tab_date,
                    "id": play_id,
                    "track_id": t_id or str(full_model.get("id") or ""),
                    "title": title,
                    "artist": artists,
                    "duration": dur_sec,
                })
            elif t_id:
                missing_ids.append(t_id)
                tracks.append({
                    "play_id": play_id,
                    "date": tab_date,
                    "id": play_id,
                    "track_id": t_id,
                    "title": "",
                    "artist": "",
                    "duration": 0,
                })

        if missing_ids:
            batch_map = self._fetch_tracks_info(missing_ids, token)
            for t in tracks:
                if not t["title"] and t["track_id"] in batch_map:
                    info = batch_map[t["track_id"]]
                    t["title"] = info.get("title", "")
                    t["artist"] = info.get("artist", "")
                    t["duration"] = info.get("duration_sec", 0)

        return [t for t in tracks if t.get("title")]

    def _schedule_startup_ym_sync(self):
        if not self.get_setting("yandex_enabled", True):
            return
        token = str(self.get_setting("yandex_token", "") or "").strip()
        if not token:
            return

        def _bg():
            time.sleep(2.5)
            try:
                self._run_startup_ym_sync(token)
            except Exception as e:
                self.log(f"YM startup sync failed: {e}\n{traceback.format_exc()}")

        threading.Thread(target=_bg, daemon=True).start()

    def _rollback_fake_ym_duplicates_if_needed(self, token: str):
        if self.get_setting("ym_duplicates_cleaned_v1", False):
            return
        try:
            self.log("YM cleanup: checking for duplicate fake tracks to rollback...")
            tabs = self._fetch_all_history(token)
            if not tabs:
                return

            total_rolled_back_sec = 0
            for tab in tabs:
                tab_date = str(tab.get("date") or "")
                if not tab_date:
                    continue
                tracks = self._extract_tab_tracks(tab, token)
                if not tracks:
                    continue

                for t in tracks:
                    pid = t.get("play_id")
                    if pid:
                        self._ym_synced_ids.add(pid)

                tracks_data = [
                    {
                        "title": t["title"],
                        "artist": t["artist"],
                        "duration": t["duration"]
                    }
                    for t in tracks
                ]
                sec = self.dex.call("pyRollbackYmDuplicates", tab_date, json.dumps(tracks_data))
                if sec and int(sec) > 0:
                    total_rolled_back_sec += int(sec)
                    self.log(f"YM cleanup: rolled back {sec} fake duplicate seconds for {tab_date}")

            self._save_synced_ids()
            self.set_setting("ym_duplicates_cleaned_v1", True)

            if total_rolled_back_sec > 0:
                hours = round(total_rolled_back_sec / 3600.0, 1)
                msg = f"Откачено {hours} ч повторно синхронизированных треков"
                self.log(msg)
                run_on_ui_thread(lambda: BulletinHelper.show_success(msg))
        except Exception as e:
            self.log(f"Rollback duplicate YM tracks error: {e}\n{traceback.format_exc()}")

    def _run_startup_ym_sync(self, token: str):
        try:
            self.log("YM startup sync: checking history...")
            if not self._ym_synced_ids:
                self._ym_synced_ids = self._load_synced_ids()

            self._rollback_fake_ym_duplicates_if_needed(token)

            install_date = str(self.get_setting("ym_install_date", "") or "").strip()
            if not install_date:
                try:
                    earliest = self.dex.call("pyGetEarliestDate")
                    if earliest:
                        install_date = str(earliest).strip()
                except Exception:
                    pass
                if not install_date:
                    install_date = datetime.now().strftime("%Y-%m-%d")
                self.set_setting("ym_install_date", install_date)

            history_tabs = self._fetch_all_history(token)
            if not history_tabs:
                self.log("YM startup sync: no history tabs found")
                return

            eligible_tabs = [
                t for t in history_tabs
                if str(t.get("date") or "") >= install_date
            ]
            self.log(f"YM startup sync: found {len(eligible_tabs)} tabs since {install_date}")
            if not eligible_tabs:
                return

            all_new_tracks = []
            for tab in eligible_tabs:
                tracks = self._extract_tab_tracks(tab, token)
                for t in tracks:
                    pid = t.get("play_id")
                    if pid and pid not in self._ym_synced_ids:
                        self._ym_synced_ids.add(pid)
                        all_new_tracks.append({
                            "id": pid,
                            "play_id": pid,
                            "date": t["date"],
                            "title": t["title"],
                            "artist": t["artist"],
                            "duration": t["duration"],
                        })

            if all_new_tracks:
                imported_cnt = self.dex.call("pyImportYmTracks", json.dumps(all_new_tracks))
                self._save_synced_ids()
                self.log(f"YM startup sync: imported {imported_cnt} tracks from {install_date}")
                if imported_cnt and int(imported_cnt) > 0:
                    msg = L.g("ym_sync_startup_done", int(imported_cnt))
                    run_on_ui_thread(lambda: BulletinHelper.show_info(msg))
            else:
                self.log(f"YM startup sync: all up to date")
        except Exception as e:
            self.log(f"YM startup sync error: {e}\n{traceback.format_exc()}")

    def _get_token_display(self) -> str:
        token = str(self.get_setting("yandex_token", "") or "").strip()
        if not token:
            return L.g("token_not_set")
        masked = token[:4] + "..." + token[-4:] if len(token) > 8 else "***"
        return L.g("token_saved", masked)

    def _open_url(self, url: str):
        try:
            from android.content import Intent
            from android.net import Uri
            intent = Intent(Intent.ACTION_VIEW, Uri.parse(url))
            intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
            ApplicationLoader.applicationContext.startActivity(intent)
        except Exception as e:
            self.log(f"open_url error: {e}")

    def _on_check_token_click(self, view=None, *args, **kwargs):
        token = str(self.get_setting("yandex_token", "") or "").strip()
        if not token:
            BulletinHelper.show_error(L.g("token_not_set"))
            return

        plugin = self
        BulletinHelper.show_info(L.g("checking_token"))

        def _bg():
            try:
                ok, user_info = plugin._verify_token(token)
                if ok:
                    run_on_ui_thread(lambda: BulletinHelper.show_info(L.g("token_valid", user_info)))
                else:
                    run_on_ui_thread(lambda: BulletinHelper.show_error(L.g("token_invalid")))
            except Exception as e:
                run_on_ui_thread(lambda: BulletinHelper.show_error(str(e)))

        threading.Thread(target=_bg, daemon=True).start()

    def _on_get_token_click(self, view=None, *args, **kwargs):
        try:
            from org.telegram.messenger.browser import Browser
            ctx = (view.getContext() if (view and hasattr(view, "getContext")) else None) or ApplicationLoader.applicationContext
            Browser.openUrl(ctx, "https://ym.marshal.dev/token/")
        except Exception as e:
            self.log(f"open token url error: {e}")
            self._open_url("https://ym.marshal.dev/token/")

    def _on_how_to_token_click(self, view=None, *args, **kwargs):
        try:
            act = None
            last_frag = get_last_fragment()
            if last_frag:
                act = last_frag.getParentActivity()
            builder = AlertDialogBuilder(act) if act else AlertDialogBuilder()
            builder.set_title(L.g("token_guide_title"))
            builder.set_message(L.g("token_guide_text"))
            builder.set_positive_button(
                L.g("open_guide_link"),
                lambda *a, **k: self._open_url("https://ym.marshal.dev/token")
            )
            builder.set_negative_button(L.g("close"), None)
            builder.show()
        except Exception as e:
            self.log(f"how to token click error: {e}")

    def _on_sync_old_history_click(self, view=None, *args, **kwargs):
        token = str(self.get_setting("yandex_token", "") or "").strip()
        if not token:
            BulletinHelper.show_error(L.g("token_not_set"))
            return

        BulletinHelper.show_info(L.g("sync_loading"))

        def _bg_fetch():
            try:
                tabs = self._fetch_all_history(token)
                if not tabs:
                    run_on_ui_thread(lambda: BulletinHelper.show_info(L.g("sync_empty")))
                    return

                dated_tabs = [t for t in tabs if t.get("date")]
                if not dated_tabs:
                    run_on_ui_thread(lambda: BulletinHelper.show_info(L.g("sync_empty")))
                    return

                dated_tabs.sort(key=lambda t: str(t.get("date") or ""))
                dates = [str(t.get("date")) for t in dated_tabs]
                min_date = dates[0]
                max_date = dates[-1]

                def _fmt_date(d_str):
                    p = d_str.split("-")
                    return f"{p[2]}.{p[1]}.{p[0]}" if len(p) == 3 else d_str

                min_fmt = _fmt_date(min_date)
                max_fmt = _fmt_date(max_date)

                total_est_tracks = 0
                for t in dated_tabs:
                    groups = t.get("items", []) or []
                    for g in groups:
                        if isinstance(g, dict):
                            tr = g.get("tracks")
                            total_est_tracks += len(tr) if isinstance(tr, list) else 1

                def _show_confirm():
                    try:
                        act = None
                        last_frag = get_last_fragment()
                        if last_frag:
                            act = last_frag.getParentActivity()
                        builder = AlertDialogBuilder(act) if act else AlertDialogBuilder()
                        builder.set_title(L.g("sync_dialog_title"))
                        msg = L.g("sync_dialog_msg", min_fmt, max_fmt, len(dated_tabs), total_est_tracks)
                        builder.set_message(msg)
                        builder.set_positive_button(
                            L.g("sync_start_btn"),
                            lambda *a, **k: self._start_full_ym_sync(dated_tabs, token, f"{min_fmt} — {max_fmt}")
                        )
                        builder.set_negative_button(L.g("cancel"), None)
                        builder.show()
                    except Exception as e_dlg:
                        self.log(f"Confirm dialog error: {e_dlg}")

                run_on_ui_thread(_show_confirm)
            except Exception as e:
                self.log(f"Fetch old history error: {e}\n{traceback.format_exc()}")
                run_on_ui_thread(lambda: BulletinHelper.show_error(str(e)))

        threading.Thread(target=_bg_fetch, daemon=True).start()

    def _start_full_ym_sync(self, dated_tabs: list, token: str, period_str: str):
        self.log(f"YM sync: starting full sync for {len(dated_tabs)} tabs ({period_str})")
        self.dex.call("pyShowYmProgress", period_str)

        def _bg_sync():
            total_tabs = len(dated_tabs)
            total_added = 0
            total_skipped = 0

            def _fmt_date(d_str):
                p = d_str.split("-")
                return f"{p[2]}.{p[1]}.{p[0]}" if len(p) == 3 else d_str

            try:
                for i, tab in enumerate(dated_tabs):
                    tab_date = str(tab.get("date") or "")
                    tab_fmt = _fmt_date(tab_date)
                    self.log(f"YM sync: processing tab {i+1}/{total_tabs} ({tab_date})")

                    cur_pct = int((i * 100) / total_tabs)
                    step_status = f"День {i + 1} из {total_tabs} ({tab_fmt})..."
                    self.dex.call("pyUpdateYmProgress", json.dumps({
                        "percent": cur_pct,
                        "status": step_status,
                        "added": total_added,
                        "skipped": total_skipped
                    }))

                    tracks = self._extract_tab_tracks(tab, token)
                    tab_new = []
                    for t in tracks:
                        pid = t.get("play_id")
                        if pid and pid in self._ym_synced_ids:
                            total_skipped += 1
                        else:
                            if pid:
                                self._ym_synced_ids.add(pid)
                            total_added += 1
                            tab_new.append({
                                "id": pid,
                                "play_id": pid,
                                "date": t["date"],
                                "title": t["title"],
                                "artist": t["artist"],
                                "duration": t["duration"],
                            })

                    if tab_new:
                        self.dex.call("pyImportYmTracks", json.dumps(tab_new))

                    percent = int(((i + 1) * 100) / total_tabs)
                    status_str = f"День {i + 1} из {total_tabs} ({tab_fmt})"
                    self.dex.call("pyUpdateYmProgress", json.dumps({
                        "percent": percent,
                        "status": status_str,
                        "added": total_added,
                        "skipped": total_skipped
                    }))

                self._save_synced_ids()
                self.log(f"YM sync: finished successfully. Added: {total_added}, Skipped: {total_skipped}")
                self.dex.call("pyFinishYmProgress", json.dumps({
                    "summary": L.g("sync_finished"),
                    "added": total_added,
                    "skipped": total_skipped
                }))
            except Exception as e:
                self.log(f"YM sync fatal error: {e}\n{traceback.format_exc()}")
                err_summary = f"Ошибка: {e}"
                self.dex.call("pyFinishYmProgress", json.dumps({
                    "summary": err_summary,
                    "added": total_added,
                    "skipped": total_skipped
                }))

        threading.Thread(target=_bg_sync, daemon=True).start()


    def _on_app_language_change(self, val):
        v = int(val)
        self.set_setting("app_language", v, reload_settings=True)
        L.app_language = v
        try:
            from org.telegram.messenger import ApplicationLoader
            if ApplicationLoader.applicationContext:
                ApplicationLoader.applicationContext.getSharedPreferences("music_stats_prefs", 0).edit().putInt("app_language", v).apply()
        except Exception as ex:
            self.log(f"SharedPreferences language write error: {ex}")
        try:
            self.dex.call("pySetLanguage", v)
        except Exception as e:
            self.log(f"SetLanguage error: {e}")


    # ------------------------------------------------------------------
    # Spotify API & Auth
    # ------------------------------------------------------------------

    SPOTIFY_OAUTH_CLIENT_ID = "cfe923b2d660439caf2b557b21f31221"
    SPOTIFY_OAUTH_REDIRECT = "https://developer.spotify.com"
    SPOTIFY_OAUTH_SCOPES = (
        "email openid profile user-self-provisioning playlist-modify-private "
        "playlist-modify-public playlist-read-collaborative playlist-read-private "
        "ugc-image-upload user-follow-modify user-follow-read user-library-modify "
        "user-library-read user-modify-playback-state user-read-currently-playing "
        "user-read-email user-read-playback-position user-read-playback-state "
        "user-read-private user-read-recently-played user-top-read user-personalized"
    )

    def _exchange_sp_dc_for_token(self, sp_dc: str) -> Tuple[Optional[str], Optional[str]]:
        clean_sp_dc = (sp_dc or "").strip()
        if not clean_sp_dc:
            return None, "empty sp_dc"
        try:
            code_verifier = base64.urlsafe_b64encode(os.urandom(64)).rstrip(b"=").decode("utf-8")
            code_challenge = base64.urlsafe_b64encode(hashlib.sha256(code_verifier.encode("utf-8")).digest()).rstrip(b"=").decode("utf-8")

            params = {
                "response_type": "code",
                "client_id": self.SPOTIFY_OAUTH_CLIENT_ID,
                "scope": self.SPOTIFY_OAUTH_SCOPES,
                "redirect_uri": self.SPOTIFY_OAUTH_REDIRECT,
                "code_challenge": code_challenge,
                "code_challenge_method": "S256",
                "state": "x1X0-Qo96pi118lEr8s0MZlVQ_lgVfCW",
                "response_mode": "web_message",
                "prompt": "none",
            }
            auth_url = "https://accounts.spotify.com/oauth2/v2/auth?" + urllib.parse.urlencode(params)
            headers = {
                "Cookie": f"sp_dc={clean_sp_dc}",
                "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
            }
            self.log("Requesting Spotify OAuth code via sp_dc...")
            auth_body = self._fetch_bytes(auth_url, headers=headers, timeout=12).decode("utf-8", errors="ignore")

            if '"error": "login_required"' in auth_body or ('"error"' in auth_body and '"code"' not in auth_body):
                self.log(f"Spotify auth returned error: login_required")
                return None, "login_required"

            match = re.search(r'"code"\s*:\s*"([^"]+)"', auth_body)
            if not match:
                self.log(f"Spotify auth response missing code: {auth_body[:200]}")
                return None, "no code in response"

            code = match.group(1)
            self.log(f"Spotify auth code received (len={len(code)}), exchanging for token...")

            token_url = "https://accounts.spotify.com/api/token"
            payload = urllib.parse.urlencode({
                "client_id": self.SPOTIFY_OAUTH_CLIENT_ID,
                "grant_type": "authorization_code",
                "code": code,
                "redirect_uri": self.SPOTIFY_OAUTH_REDIRECT,
                "code_verifier": code_verifier,
            }).encode("utf-8")

            token_headers = {
                "Content-Type": "application/x-www-form-urlencoded",
                "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
            }
            token_resp = self._fetch_bytes(token_url, headers=token_headers, data=payload, timeout=12)
            token_data = json.loads(token_resp.decode("utf-8", errors="ignore"))

            access_token = token_data.get("access_token")
            if not access_token:
                err = token_data.get("error_description") or token_data.get("error") or "no token"
                self.log(f"Token exchange failed: {err}")
                return None, err

            self.log(f"Successfully obtained Spotify access_token (len={len(access_token)})")
            return access_token, None
        except Exception as e:
            self.log(f"exchange_sp_dc_for_token exception: {e}")
            return None, str(e)

    def _verify_spotify_token(self, token: str) -> Tuple[bool, str]:
        clean_token = (token or "").strip()
        if clean_token.lower().startswith("bearer "):
            clean_token = clean_token[7:].strip()
        headers = {
            "Authorization": f"Bearer {clean_token}",
            "Accept": "application/json",
            "User-Agent": "Mozilla/5.0",
        }
        try:
            raw = self._fetch_bytes("https://api.spotify.com/v1/me", headers=headers, timeout=10)
            data = json.loads(raw.decode("utf-8", errors="ignore"))
            if "error" in data:
                return False, data["error"].get("message", "Error")
            name = data.get("display_name") or data.get("id") or "User"
            email = data.get("email") or ""
            info = f"{name} ({email})" if email else name
            return True, info
        except Exception as e:
            return False, str(e)

    def _silent_refresh_spotify(self) -> Optional[str]:
        saved_sp_dc = str(self.get_setting("spotify_sp_dc", "") or "").strip()
        if not saved_sp_dc:
            try:
                from android.webkit import CookieManager
                cm = CookieManager.getInstance()
                for dom in ["https://open.spotify.com", "https://spotify.com", "https://accounts.spotify.com"]:
                    raw = cm.getCookie(dom) or ""
                    if "sp_dc=" in raw:
                        for part in raw.split(";"):
                            if "=" in part:
                                k, v = part.strip().split("=", 1)
                                if k.strip() == "sp_dc":
                                    saved_sp_dc = v.strip()
                                    break
                    if saved_sp_dc:
                        break
            except Exception:
                pass

        if not saved_sp_dc:
            self.log("Silent refresh: no sp_dc cookie available")
            return None

        self.log(f"Silent refresh: exchanging sp_dc (len={len(saved_sp_dc)})...")
        tok, err = self._exchange_sp_dc_for_token(saved_sp_dc)
        if tok:
            self.set_setting("spotify_token", tok, reload_settings=False)
            self.set_setting("spotify_sp_dc", saved_sp_dc, reload_settings=False)
            self.log(f"Silent refresh succeeded with token len={len(tok)}")
            return tok
        else:
            self.log(f"Silent refresh failed: {err}")
            return None

    def _clear_spotify_session(self):
        self.set_setting("spotify_token", "", reload_settings=False)
        self.set_setting("spotify_user_name", "", reload_settings=False)
        self.set_setting("spotify_sp_dc", "", reload_settings=True)
        try:
            from android.webkit import CookieManager
            cm = CookieManager.getInstance()
            try:
                cm.removeAllCookies(None)
            except Exception:
                try:
                    cm.removeAllCookie()
                except Exception:
                    pass
            for u in [
                "https://spotify.com",
                "https://accounts.spotify.com",
                "https://open.spotify.com",
                "https://api.spotify.com",
                "https://developer.spotify.com",
            ]:
                raw = cm.getCookie(u)
                if raw:
                    for pair in str(raw).split(";"):
                        if "=" in pair:
                            k = pair.split("=", 1)[0].strip()
                            if k:
                                cm.setCookie(u, f"{k}=; Expires=Thu, 01 Jan 1970 00:00:00 GMT; Path=/; Domain=.spotify.com")
            cm.flush()
            self.log("Spotify session cleared and cookies removed")
        except Exception as e:
            self.log(f"clear spotify session error: {e}")


    def _show_webview_error_dialog(self, act, on_manual=None):
        if not act:
            return
        b = AlertDialogBuilder(act)
        b.set_title("Ошибка WebView")
        b.set_message(
            "Не удалось запустить Android System WebView на вашем устройстве.\n\n"
            "Возможные причины:\n"
            "• Компонент 'Android System WebView' отключен или обновляется в Google Play\n"
            "• В системе отключен Google Chrome\n\n"
            "Обновите или включите WebView в Google Play либо введите токен вручную."
        )
        if on_manual:
            b.set_positive_button("Ввести вручную", lambda d, *a: (d.dismiss(), on_manual()))
            b.set_negative_button("Закрыть", lambda d, *a: d.dismiss())
        else:
            b.set_positive_button("Понятно", lambda d, *a: d.dismiss())
        b.show()

    def _open_spotify_token_input_dialog(self, act=None, on_done=None):
        plugin = self
        if not act:
            frag = get_last_fragment()
            act = frag.getParentActivity() if frag else None
        if not act:
            return

        from android.widget import LinearLayout, EditText, TextView
        from org.telegram.messenger import AndroidUtilities

        b = AlertDialogBuilder(act)
        b.set_title(L.g("spotify_login_title"))
        container = LinearLayout(act)
        container.setOrientation(LinearLayout.VERTICAL)
        container.setPadding(AndroidUtilities.dp(20), AndroidUtilities.dp(12), AndroidUtilities.dp(20), AndroidUtilities.dp(8))

        hint_tv = TextView(act)
        hint_tv.setText("Вставьте OAuth токен Spotify или значение cookie sp_dc:")
        hint_tv.setTextSize(13)
        hint_tv.setTextColor(to_signed(0xFF8B98A5))
        container.addView(hint_tv)

        et = EditText(act)
        cur_tok = str(plugin.get_setting("spotify_token", "") or "")
        cur_sp = str(plugin.get_setting("spotify_sp_dc", "") or "")
        et.setText(cur_sp if cur_sp else cur_tok)
        et.setHint("sp_dc или access_token")
        container.addView(et, LinearLayout.LayoutParams(-1, -2))

        b.set_view(container)

        def _on_save(d, *a):
            val = str(et.getText().toString() or "").strip()
            if not val:
                BulletinHelper.show_error("Поле не может быть пустым")
                return
            d.dismiss()
            BulletinHelper.show_info("Проверка токена...")

            def _bg():
                try:
                    tok = val
                    if not tok.lower().startswith("bearer ") and not tok.startswith("BQ") and len(tok) > 40 and "=" not in tok:
                        ex_tok, err = plugin._exchange_sp_dc_for_token(val)
                        if ex_tok:
                            tok = ex_tok
                            plugin.set_setting("spotify_sp_dc", val, reload_settings=False)
                    elif tok.lower().startswith("bearer "):
                        tok = tok[7:].strip()

                    ok, name = plugin._verify_spotify_token(tok)
                    if ok:
                        plugin.set_setting("spotify_token", tok, reload_settings=True)
                        plugin.set_setting("spotify_enabled", True)
                        msg = L.g("spotify_login_success")
                        if name:
                            msg += f" ({name})"
                        run_on_ui_thread(lambda: BulletinHelper.show_success(msg))
                        if on_done:
                            run_on_ui_thread(on_done)
                    else:
                        run_on_ui_thread(lambda: BulletinHelper.show_error(f"Не удалось войти: {name}"))
                except Exception as ex:
                    run_on_ui_thread(lambda: BulletinHelper.show_error(str(ex)))

            threading.Thread(target=_bg, daemon=True).start()

        b.set_positive_button("Сохранить", _on_save)
        b.set_negative_button("Отмена", lambda d, *a: d.dismiss())
        b.show()

    def _open_ym_auth(self, view=None, on_success=None, *args, **kwargs):
        plugin = self

        def _ui():
            try:
                from android.webkit import CookieManager, WebView, WebViewClient
                from android.widget import LinearLayout, EditText
                from android.view import View, WindowManager
                from android.content import DialogInterface
                from org.telegram.messenger import AndroidUtilities

                frag = get_last_fragment()
                if not frag:
                    return
                act = frag.getParentActivity()
                if not act:
                    return

                try:
                    wv = WebView(act)
                except (Exception, BaseException) as e_wv:
                    plugin.log(f"YM auth WebView creation failed: {e_wv}")
                    plugin._show_webview_error_dialog(
                        act,
                        on_manual=lambda: plugin._open_ym_token_input_dialog(act, on_done=on_success)
                    )
                    return

                is_closed = [False]
                dlg_ref = [None]
                real_dialog_ref = [None]
                token_found = [False]

                builder = AlertDialogBuilder(act)
                builder.set_title("Вход в Яндекс")

                container = LinearLayout(act)
                container.setOrientation(LinearLayout.VERTICAL)

                try:
                    dummy_et = EditText(act)
                    dummy_et.setVisibility(View.GONE)
                    container.addView(dummy_et)
                except Exception:
                    pass

                wv.setFocusable(True)
                wv.setFocusableInTouchMode(True)
                wv.requestFocus(View.FOCUS_DOWN)

                try:
                    class WVTouchListener(dynamic_proxy(View.OnTouchListener)):
                        def onTouch(self, v, event):
                            action = event.getAction()
                            if action in (0, 1):
                                if not v.hasFocus():
                                    v.requestFocus()
                                    v.requestFocusFromTouch()
                            return False

                    wv.setOnTouchListener(WVTouchListener())
                except Exception as e:
                    plugin.log(f"setOnTouchListener error: {e}")

                ws = wv.getSettings()
                ws.setJavaScriptEnabled(True)
                ws.setDomStorageEnabled(True)
                ws.setUserAgentString("Mozilla/5.0 (Linux; Android 13; SM-S918B) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/114.0.0.0 Mobile Safari/537.36")

                cm = CookieManager.getInstance()
                cm.setAcceptCookie(True)
                try:
                    cm.setAcceptThirdPartyCookies(wv, True)
                except Exception:
                    pass

                def _cleanup_webview():
                    try:
                        wv.stopLoading()
                        wv.loadUrl("about:blank")
                        wv.clearHistory()
                        p = wv.getParent()
                        if p:
                            p.removeView(wv)
                        wv.destroy()
                    except Exception:
                        pass

                def _dismiss_dialog():
                    try:
                        d = dlg_ref[0]
                        if d is not None and hasattr(d, "dismiss"):
                            d.dismiss()
                    except Exception:
                        pass
                    try:
                        rd = real_dialog_ref[0]
                        if rd is not None and hasattr(rd, "dismiss"):
                            rd.dismiss()
                    except Exception:
                        pass
                    _cleanup_webview()

                def _on_token_detected(token_str):
                    if token_found[0] or is_closed[0]:
                        return
                    token_found[0] = True
                    is_closed[0] = True
                    plugin.log("Yandex access_token detected, verifying...")

                    def _bg():
                        try:
                            ok, user_info = plugin._verify_token(token_str)
                            if not ok:
                                plugin.log(f"Yandex token verify failed: {user_info}")
                                token_found[0] = False
                                is_closed[0] = False
                                return

                            plugin.set_setting("yandex_token", token_str, reload_settings=True)
                            plugin.set_setting("yandex_enabled", True)
                            plugin.log(f"Yandex token saved successfully ({user_info})")

                            def _done_ui():
                                _dismiss_dialog()
                                BulletinHelper.show_success(L.g("token_saved", user_info))
                                if on_success:
                                    try:
                                        on_success()
                                    except Exception as ex_cb:
                                        plugin.log(f"on_success callback error: {ex_cb}")

                            run_on_ui_thread(_done_ui)
                        except Exception as ex:
                            plugin.log(f"Yandex auth verification error: {ex}")
                            token_found[0] = False
                            is_closed[0] = False

                    threading.Thread(target=_bg, daemon=True).start()

                def _check_url_for_token(url_val):
                    if not url_val or token_found[0]:
                        return False
                    url_str = str(url_val)
                    if "access_token=" in url_str:
                        m = re.search(r"access_token=([a-zA-Z0-9_\-\.]+)", url_str)
                        if m:
                            _on_token_detected(m.group(1).strip())
                            return True
                    return False

                wv.setWebViewClient(WebViewClient())

                params = LinearLayout.LayoutParams(-1, AndroidUtilities.dp(500))
                container.addView(wv, params)
                builder.set_view(container)

                def _on_close_clicked(d, *a):
                    is_closed[0] = True
                    try:
                        d.dismiss()
                    except Exception:
                        pass
                    _cleanup_webview()

                builder.set_negative_button(L.g("close"), _on_close_clicked)
                dlg = builder.create()
                dlg_ref[0] = dlg
                dlg.show()

                real_dialog = None
                for obj in (dlg, builder):
                    if hasattr(obj, "get_dialog"):
                        try:
                            real_dialog = obj.get_dialog()
                            if real_dialog is not None:
                                break
                        except Exception:
                            pass
                    if hasattr(obj, "_dialog"):
                        try:
                            real_dialog = getattr(obj, "_dialog")
                            if real_dialog is not None:
                                break
                        except Exception:
                            pass

                if real_dialog is None:
                    real_dialog = dlg
                real_dialog_ref[0] = real_dialog

                try:
                    if hasattr(real_dialog, "setFocusable"):
                        real_dialog.setFocusable(True)
                except Exception as e:
                    plugin.log(f"setFocusable error: {e}")

                try:
                    win = None
                    if hasattr(real_dialog, "getWindow"):
                        win = real_dialog.getWindow()
                    elif hasattr(dlg, "getWindow"):
                        win = dlg.getWindow()

                    if win is not None:
                        win.clearFlags(
                            WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE
                            | WindowManager.LayoutParams.FLAG_ALT_FOCUSABLE_IM
                        )
                        win.setSoftInputMode(WindowManager.LayoutParams.SOFT_INPUT_ADJUST_RESIZE)
                except Exception as e:
                    plugin.log(f"window flags error: {e}")

                try:
                    class DismissProxy(dynamic_proxy(DialogInterface.OnDismissListener)):
                        def onDismiss(self, dialog):
                            is_closed[0] = True
                            _cleanup_webview()

                    if hasattr(real_dialog, "setOnDismissListener"):
                        real_dialog.setOnDismissListener(DismissProxy())
                except Exception as e:
                    plugin.log(f"setOnDismissListener error: {e}")

                auth_url = "https://oauth.yandex.ru/authorize?response_type=token&client_id=23cabbbdc6cd418abb4b39c32c41195d"
                plugin.log(f"Loading Yandex OAuth URL: {auth_url}")
                wv.loadUrl(auth_url)

                def _poll():
                    try:
                        for _ in range(600):
                            time.sleep(0.5)
                            if is_closed[0] or token_found[0]:
                                break
                            def _step():
                                try:
                                    u = wv.getUrl()
                                    if u:
                                        _check_url_for_token(u)
                                except Exception:
                                    pass
                            run_on_ui_thread(_step)
                    except Exception as e:
                        plugin.log(f"YM auth poll exception: {e}")

                threading.Thread(target=_poll, daemon=True).start()

            except Exception as e:
                plugin.log(f"YM auth open error: {e}")
                BulletinHelper.show_error(str(e))

        run_on_ui_thread(_ui)

    def _open_spotify_auth(self, view=None, switch_account: bool = False, on_success=None, *args, **kwargs):
        plugin = self

        def _ui():
            try:
                from android.webkit import CookieManager, WebView, WebViewClient
                from android.widget import LinearLayout, EditText
                from android.view import View, WindowManager
                from android.content import DialogInterface

                frag = get_last_fragment()
                if not frag:
                    return
                act = frag.getParentActivity()
                if not act:
                    return

                is_closed = [False]
                dlg_ref = [None]
                real_dialog_ref = [None]
                exchanging = [False]

                builder = AlertDialogBuilder(act)
                builder.set_title(L.g("spotify_login_title"))

                container = LinearLayout(act)
                container.setOrientation(LinearLayout.VERTICAL)

                try:
                    dummy_et = EditText(act)
                    dummy_et.setVisibility(View.GONE)
                    container.addView(dummy_et)
                except Exception:
                    pass

                try:
                    wv = WebView(act)
                except (Exception, BaseException) as e_wv:
                    plugin.log(f"Spotify auth WebView creation failed: {e_wv}")
                    plugin._show_webview_error_dialog(
                        act,
                        on_manual=lambda: plugin._open_spotify_token_input_dialog(act, on_done=on_success)
                    )
                    return
                wv.setFocusable(True)
                wv.setFocusableInTouchMode(True)
                wv.requestFocus(View.FOCUS_DOWN)
                wv.setWebViewClient(WebViewClient())

                try:
                    class WVTouchListener(dynamic_proxy(View.OnTouchListener)):
                        def onTouch(self, v, event):
                            action = event.getAction()
                            if action in (0, 1):
                                if not v.hasFocus():
                                    v.requestFocus()
                                    v.requestFocusFromTouch()
                            return False

                    wv.setOnTouchListener(WVTouchListener())
                except Exception as e:
                    plugin.log(f"setOnTouchListener error: {e}")

                ws = wv.getSettings()
                ws.setJavaScriptEnabled(True)
                ws.setDomStorageEnabled(True)
                ws.setUserAgentString("Mozilla/5.0 (Linux; Android 13; SM-S918B) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/114.0.0.0 Mobile Safari/537.36")

                cm = CookieManager.getInstance()
                cm.setAcceptCookie(True)
                try:
                    cm.setAcceptThirdPartyCookies(wv, True)
                except Exception:
                    pass

                params = LinearLayout.LayoutParams(-1, AndroidUtilities.dp(500))
                container.addView(wv, params)
                builder.set_view(container)

                def _cleanup_webview():
                    try:
                        wv.stopLoading()
                        wv.loadUrl("about:blank")
                        wv.clearHistory()
                        p = wv.getParent()
                        if p:
                            p.removeView(wv)
                        wv.destroy()
                    except Exception:
                        pass

                def _dismiss_dialog():
                    d = dlg_ref[0]
                    rd = real_dialog_ref[0]
                    try:
                        if d is not None and hasattr(d, "dismiss"):
                            d.dismiss()
                    except Exception:
                        pass
                    try:
                        if rd is not None and hasattr(rd, "dismiss"):
                            rd.dismiss()
                    except Exception:
                        pass
                    _cleanup_webview()

                def _find_sp_dc():
                    try:
                        cm_inst = CookieManager.getInstance()
                        cm_inst.flush()
                        for u in ["https://open.spotify.com", "https://spotify.com", "https://accounts.spotify.com"]:
                            raw = cm_inst.getCookie(u) or ""
                            if "sp_dc=" in raw:
                                for pair in raw.split(";"):
                                    if "=" in pair:
                                        k, v = pair.strip().split("=", 1)
                                        if k.strip() == "sp_dc":
                                            return v.strip()
                    except Exception as e:
                        plugin.log(f"find_sp_dc error: {e}")
                    return None

                def _try_auth_with_sp_dc(sp_dc_val):
                    if exchanging[0] or is_closed[0]:
                        return
                    exchanging[0] = True
                    plugin.log(f"Found sp_dc cookie (len={len(sp_dc_val)}), exchanging for token...")

                    def _bg():
                        try:
                            token, err = plugin._exchange_sp_dc_for_token(sp_dc_val)
                            if not token:
                                plugin.log(f"Exchange failed: {err}")
                                exchanging[0] = False
                                return

                            ok, name = plugin._verify_spotify_token(token)
                            if not ok:
                                plugin.log(f"Token verification failed: {name}")
                                exchanging[0] = False
                                return

                            is_closed[0] = True
                            plugin.set_setting("spotify_token", token, reload_settings=False)
                            plugin.set_setting("spotify_sp_dc", sp_dc_val, reload_settings=False)
                            if name:
                                pass
                            if name:
                                plugin.set_setting("spotify_user_name", name, reload_settings=True)
                            else:
                                plugin.set_setting("spotify_token", token, reload_settings=True)
                            if hasattr(plugin, "reload_settings"):
                                try:
                                    plugin.reload_settings()
                                except Exception:
                                    pass

                            def _done_ui():
                                _dismiss_dialog()
                                msg = L.g("spotify_login_success")
                                if name:
                                    msg += f" ({name})"
                                BulletinHelper.show_success(msg)
                                if on_success:
                                    try:
                                        on_success()
                                    except Exception as ex_cb:
                                        plugin.log(f"on_success callback error: {ex_cb}")

                            run_on_ui_thread(_done_ui)
                        except Exception as ex:
                            plugin.log(f"try_auth_with_sp_dc exception: {ex}")
                            exchanging[0] = False

                    threading.Thread(target=_bg, daemon=True).start()

                def _check_cookies():
                    if is_closed[0] or exchanging[0]:
                        return
                    sp_dc = _find_sp_dc()
                    if sp_dc:
                        _try_auth_with_sp_dc(sp_dc)

                def _on_done_clicked(d, *a):
                    try:
                        plugin.log("Done clicked on Spotify auth dialog")
                        sp_dc = _find_sp_dc()
                        if sp_dc:
                            BulletinHelper.show_info(L.g("checking_spotify_token") if hasattr(L, "g") else "Проверка...")
                            _try_auth_with_sp_dc(sp_dc)
                        else:
                            BulletinHelper.show_error(L.g("spotify_status_not_connected"))
                    except Exception as ex:
                        plugin.log(f"spotify on_done_clicked error: {ex}")
                        BulletinHelper.show_error(str(ex))

                def _on_logout_clicked(d, *a):
                    try:
                        plugin._clear_spotify_session()
                        wv.loadUrl("https://accounts.spotify.com/en/logout")
                        BulletinHelper.show_info(L.g("spotify_logged_out"))
                    except Exception as ex:
                        plugin.log(f"spotify on_logout_clicked error: {ex}")

                def _on_close_clicked(d, *a):
                    is_closed[0] = True
                    try:
                        d.dismiss()
                    except Exception:
                        pass
                    _cleanup_webview()

                builder.set_positive_button(L.g("check_login_done") if hasattr(L, "g") else "Готово", _on_done_clicked)
                builder.set_neutral_button(L.g("logout") if hasattr(L, "g") else "Выйти", _on_logout_clicked)
                builder.set_negative_button(L.g("close"), _on_close_clicked)

                dlg = builder.create()
                dlg_ref[0] = dlg
                dlg.show()

                real_dialog = None
                for obj in (dlg, builder):
                    if hasattr(obj, "get_dialog"):
                        try:
                            real_dialog = obj.get_dialog()
                            if real_dialog is not None:
                                break
                        except Exception:
                            pass
                    if hasattr(obj, "_dialog"):
                        try:
                            real_dialog = getattr(obj, "_dialog")
                            if real_dialog is not None:
                                break
                        except Exception:
                            pass

                if real_dialog is None:
                    real_dialog = dlg
                real_dialog_ref[0] = real_dialog

                try:
                    if hasattr(real_dialog, "setFocusable"):
                        real_dialog.setFocusable(True)
                except Exception as e:
                    plugin.log(f"setFocusable error: {e}")

                try:
                    win = None
                    if hasattr(real_dialog, "getWindow"):
                        win = real_dialog.getWindow()
                    elif hasattr(dlg, "getWindow"):
                        win = dlg.getWindow()

                    if win is not None:
                        win.clearFlags(
                            WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE
                            | WindowManager.LayoutParams.FLAG_ALT_FOCUSABLE_IM
                        )
                        win.setSoftInputMode(WindowManager.LayoutParams.SOFT_INPUT_ADJUST_RESIZE)
                except Exception as e:
                    plugin.log(f"window flags error: {e}")

                try:
                    class DismissProxy(dynamic_proxy(DialogInterface.OnDismissListener)):
                        def onDismiss(self, dialog):
                            is_closed[0] = True
                            _cleanup_webview()

                    if hasattr(real_dialog, "setOnDismissListener"):
                        real_dialog.setOnDismissListener(DismissProxy())
                except Exception as e:
                    plugin.log(f"setOnDismissListener error: {e}")

                login_url = "https://accounts.spotify.com/en/login?continue=https%3A%2F%2Fopen.spotify.com%2F"
                plugin.log(f"Loading Spotify login URL: {login_url}")
                wv.loadUrl(login_url)

                def _is_dlg_showing():
                    if is_closed[0]:
                        return False
                    for target in (real_dialog_ref[0], dlg_ref[0]):
                        if target is not None and hasattr(target, "isShowing"):
                            try:
                                return bool(target.isShowing())
                            except Exception:
                                pass
                    return True

                def _poll():
                    try:
                        for _ in range(300):
                            time.sleep(1)
                            if is_closed[0] or exchanging[0]:
                                break
                            if not _is_dlg_showing():
                                break
                            def _step():
                                _check_cookies()
                            run_on_ui_thread(_step)
                    except Exception as e:
                        plugin.log(f"spotify auth poll exception: {e}")

                threading.Thread(target=_poll, daemon=True).start()

            except Exception as e:
                plugin.log(f"spotify auth open error: {e}")
                BulletinHelper.show_error(str(e))

        run_on_ui_thread(_ui)

    def _fetch_spotify_history(self, token: str, days: int = 7) -> Tuple[List[Dict[str, Any]], str]:
        self.log(f"Fetching Spotify history: days={days}")
        clean_token = (token or "").strip()
        if not clean_token:
            clean_token = str(self.get_setting("spotify_token", "") or "").strip()
        if clean_token.lower().startswith("bearer "):
            clean_token = clean_token[7:].strip()

        if not clean_token:
            refreshed = self._silent_refresh_spotify()
            if refreshed:
                clean_token = refreshed
            else:
                raise ValueError("Spotify token not set")

        headers = {
            "Authorization": f"Bearer {clean_token}",
            "Accept": "application/json",
            "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
        }

        now_dt = datetime.now()
        now_date = now_dt.date()
        cutoff_date = now_date - timedelta(days=(days - 1) if days > 1 else 0)
        period_display = f"{cutoff_date.strftime('%d.%m.%Y')} — {now_date.strftime('%d.%m.%Y')}" if days > 1 else now_date.strftime("%d.%m.%Y")

        url = "https://api.spotify.com/v1/me/player/recently-played?limit=50"
        try:
            raw = self._fetch_bytes(url, headers=headers, timeout=15)
            self.log(f"Spotify response: {len(raw)} bytes")
            data = json.loads(raw.decode("utf-8", errors="ignore"))
            if "error" in data:
                err_msg = data["error"].get("message", "Unknown error")
                status = data["error"].get("status")
                if status == 401 or "expired" in err_msg.lower():
                    self.log("Spotify token expired, attempting silent refresh...")
                    refreshed = self._silent_refresh_spotify()
                    if refreshed:
                        headers["Authorization"] = f"Bearer {refreshed}"
                        raw = self._fetch_bytes(url, headers=headers, timeout=15)
                        data = json.loads(raw.decode("utf-8", errors="ignore"))
                        if "error" in data:
                            raise ValueError(f"Spotify API error: {data['error'].get('message')}")
                    else:
                        raise ValueError(f"Spotify API error: {err_msg}")
                else:
                    raise ValueError(f"Spotify API error: {err_msg}")
        except Exception as e_fetch:
            if "401" in str(e_fetch) or "expired" in str(e_fetch).lower():
                self.log("Spotify fetch 401, attempting silent refresh...")
                refreshed = self._silent_refresh_spotify()
                if refreshed:
                    headers["Authorization"] = f"Bearer {refreshed}"
                    raw = self._fetch_bytes(url, headers=headers, timeout=15)
                    data = json.loads(raw.decode("utf-8", errors="ignore"))
                else:
                    raise e_fetch
            else:
                raise e_fetch

        items = data.get("items", []) or []
        self.log(f"Spotify raw items count: {len(items)}")

        tracks = []
        for it in items:
            track_obj = it.get("track") or {}
            played_at_str = it.get("played_at") or ""
            t_id = str(track_obj.get("id") or "")
            title = str(track_obj.get("name") or "")
            if not title:
                continue

            artists_list = track_obj.get("artists", []) or []
            artists = ", ".join([
                str(a.get("name", "")) for a in artists_list
                if isinstance(a, dict) and a.get("name")
            ]) or "Unknown Artist"

            dur_ms = track_obj.get("duration_ms") or 0
            dur_sec = max(0, int(dur_ms) // 1000)

            played_date = now_date
            if played_at_str:
                try:
                    clean_ts = played_at_str.replace("Z", "+00:00")
                    dt = datetime.fromisoformat(clean_ts).astimezone()
                    played_date = dt.date()
                except Exception:
                    played_date = now_date

            if days == 1 and played_date != now_date:
                continue
            if days > 1 and played_date < cutoff_date:
                continue

            tracks.append({
                "id": t_id,
                "title": title,
                "artist": artists,
                "duration_sec": dur_sec,
                "date": played_date.strftime("%Y-%m-%d"),
            })

        return tracks, period_display

    def _sync_spotify_history(self, act):
        plugin = self
        token = str(plugin.get_setting("spotify_token", "") or "").strip()
        if not token:
            BulletinHelper.show_error(L.g("spotify_status_not_connected"))
            return

        def _bg():
            try:
                title = L.g("spotify_sync_title")
                plugin.dex.call("pyShowYmProgress", title, "")

                tracks, period_display = plugin._fetch_spotify_history(token, days=30)
                if not tracks:
                    plugin.dex.call("pyDismissYmProgress")
                    run_on_ui_thread(lambda: BulletinHelper.show_info(L.g("spotify_no_tracks")))
                    return

                total_tracks = len(tracks)
                import_batch = []
                total_added = 0
                total_skipped = 0

                for i, t in enumerate(tracks):
                    tid = f"sp_{t['id']}_{t['date']}"
                    if tid not in plugin._ym_synced_ids:
                        import_batch.append({
                            "id": tid,
                            "title": t["title"],
                            "artist": t["artist"],
                            "duration": t["duration_sec"],
                            "date": t["date"]
                        })
                        plugin._ym_synced_ids.add(tid)
                        total_added += 1
                    else:
                        total_skipped += 1

                if import_batch:
                    plugin.dex.call("pyImportYmTracks", json.dumps(import_batch))
                    plugin._save_synced_ids()

                plugin.dex.call("pyUpdateYmProgress", json.dumps({
                    "percent": 100,
                    "status": L.g("sync_finished"),
                    "added": total_added,
                    "skipped": total_skipped
                }))

                plugin.log(f"Spotify sync completed: imported {total_added} tracks (skipped {total_skipped})")
                msg = L.g("spotify_sync_done", total_added)
                run_on_ui_thread(lambda: BulletinHelper.show_success(msg))
            except Exception as e:
                plugin.log(f"Spotify sync error: {e}\n{traceback.format_exc()}")
                plugin.dex.call("pyDismissYmProgress")
                run_on_ui_thread(lambda: BulletinHelper.show_error(str(e)))

        threading.Thread(target=_bg, daemon=True).start()

    def _schedule_startup_spotify_sync(self):
        if not self.get_setting("spotify_enabled", True):
            return
        token = str(self.get_setting("spotify_token", "") or "").strip()
        if not token:
            token = self._silent_refresh_spotify()
        if not token:
            return

        plugin = self
        def _bg():
            try:
                time.sleep(3.5)
                tracks, _ = plugin._fetch_spotify_history(token, days=7)
                if not tracks:
                    return
                all_new_tracks = []
                for t in tracks:
                    tid = f"sp_{t['id']}_{t['date']}"
                    if tid not in plugin._ym_synced_ids:
                        all_new_tracks.append({
                            "id": tid,
                            "title": t["title"],
                            "artist": t["artist"],
                            "duration": t["duration_sec"],
                            "date": t["date"]
                        })
                        plugin._ym_synced_ids.add(tid)
                if all_new_tracks:
                    plugin.dex.call("pyImportYmTracks", json.dumps(all_new_tracks))
                    plugin._save_synced_ids()
                    plugin.log(f"Spotify startup sync: imported {len(all_new_tracks)} tracks")
            except Exception as e:
                plugin.log(f"Spotify startup sync error: {e}")

        threading.Thread(target=_bg, daemon=True).start()

    def _confirm_and_sync_ym(self, act=None):
        token = str(self.get_setting("yandex_token", "") or "").strip()
        if not token:
            BulletinHelper.show_error(L.g("token_not_set"))
            return

        BulletinHelper.show_info(L.g("sync_loading"))

        def _bg_fetch():
            try:
                tabs = self._fetch_all_history(token)
                if not tabs:
                    run_on_ui_thread(lambda: BulletinHelper.show_info(L.g("sync_empty")))
                    return

                dated_tabs = [t for t in tabs if t.get("date")]
                if not dated_tabs:
                    run_on_ui_thread(lambda: BulletinHelper.show_info(L.g("sync_empty")))
                    return

                dated_tabs.sort(key=lambda t: str(t.get("date") or ""))
                dates = [str(t.get("date")) for t in dated_tabs]
                min_date = dates[0]
                max_date = dates[-1]

                def _fmt_date(d_str):
                    p = d_str.split("-")
                    return f"{p[2]}.{p[1]}.{p[0]}" if len(p) == 3 else d_str

                min_fmt = _fmt_date(min_date)
                max_fmt = _fmt_date(max_date)

                total_est_tracks = 0
                for t in dated_tabs:
                    groups = t.get("items", []) or []
                    for g in groups:
                        if isinstance(g, dict):
                            tr = g.get("tracks")
                            total_est_tracks += len(tr) if isinstance(tr, list) else 1

                def _show_confirm():
                    try:
                        dlg_act = act or (get_last_fragment().getParentActivity() if get_last_fragment() else None)
                        builder = AlertDialogBuilder(dlg_act) if dlg_act else AlertDialogBuilder()
                        builder.set_title("Синхронизация")
                        msg = f"Синхронизировать историю Яндекс Музыки?\n\nПериод: {min_fmt} — {max_fmt}\nДоступно треков: ~{total_est_tracks}"
                        builder.set_message(msg)
                        builder.set_positive_button(
                            "Да",
                            lambda *a, **k: self._start_full_ym_sync(dated_tabs, token, f"{min_fmt} — {max_fmt}")
                        )
                        builder.set_negative_button("Отмена", None)
                        builder.show()
                    except Exception as e_dlg:
                        self.log(f"Confirm dialog error: {e_dlg}")

                run_on_ui_thread(_show_confirm)
            except Exception as e:
                self.log(f"Fetch old history error: {e}\n{traceback.format_exc()}")

        threading.Thread(target=_bg_fetch, daemon=True).start()

    def _open_external_platforms_dialog(self, view=None):
        plugin = self

        def _ui():
            try:
                frag = get_last_fragment()
                act = frag.getParentActivity() if frag else None
                if not act:
                    return

                from android.widget import LinearLayout, ScrollView, TextView
                from android.view import View, Gravity
                from android.graphics import Typeface
                from android.graphics.drawable import GradientDrawable
                from org.telegram.messenger import AndroidUtilities

                def dp(px):
                    return AndroidUtilities.dp(float(px))

                def _round_bg(color, radius_dp=16):
                    gd = GradientDrawable()
                    gd.setColor(to_signed(color))
                    gd.setCornerRadius(float(dp(radius_dp)))
                    return gd

                def _btn_bg(color, radius_dp=10):
                    gd = GradientDrawable()
                    gd.setColor(to_signed(color))
                    gd.setCornerRadius(float(dp(radius_dp)))
                    return gd

                bg_card = to_signed(0xFF141923)
                text_primary = to_signed(0xFFFFFFFF)
                text_secondary = to_signed(0xFF8B98A5)
                accent_color = to_signed(0xFF818CF8)
                btn_bg_col = to_signed(0xFF1E2638)
                btn_text_col = to_signed(0xFFDCE2EC)
                status_ok = to_signed(0xFF4ADE80)
                status_warn = to_signed(0xFFF59E0B)
                status_none = to_signed(0xFF94A3B8)

                scroll = ScrollView(act)
                root = LinearLayout(act)
                root.setOrientation(LinearLayout.VERTICAL)
                root.setPadding(dp(16), dp(16), dp(16), dp(20))
                scroll.addView(root)

                dlg_ref = [None]

                def _dismiss_all():
                    if dlg_ref[0]:
                        try:
                            dlg_ref[0].dismiss()
                        except Exception:
                            pass

                def _make_button(text, on_click_fn, is_accent=False):
                    btn = TextView(act)
                    btn.setText(text)
                    btn.setTextSize(13)
                    btn.setTypeface(Typeface.create("sans-serif-medium", Typeface.NORMAL))
                    btn.setGravity(Gravity.CENTER)
                    b_color = accent_color if is_accent else btn_bg_col
                    t_color = to_signed(0xFFFFFFFF) if is_accent else btn_text_col
                    btn.setTextColor(to_signed(t_color))
                    btn.setBackground(_btn_bg(b_color, 10))
                    btn.setPadding(dp(12), dp(9), dp(12), dp(9))
                    btn.setClickable(True)
                    btn.setFocusable(True)

                    from android_utils import OnClickListener
                    btn.setOnClickListener(OnClickListener(lambda v: on_click_fn()))
                    return btn

                def _show_disconnect_dialog(service_name, on_disable, on_clear):
                    b = AlertDialogBuilder(act)
                    b.set_title("Отключение")
                    b.set_message("Что вы хотите сделать?")
                    b.set_positive_button(
                        "Выключить",
                        lambda d, *a: (d.dismiss(), on_disable())
                    )
                    b.set_neutral_button(
                        "Выключить и очистить",
                        lambda d, *a: (d.dismiss(), on_clear())
                    )
                    b.set_negative_button("Отмена", lambda d, *a: d.dismiss())
                    b.show()

                # ==========================================================
                # 1. YANDEX MUSIC CARD
                # ==========================================================
                card_ym = LinearLayout(act)
                card_ym.setOrientation(LinearLayout.VERTICAL)
                card_ym.setBackground(_round_bg(bg_card, 16))
                card_ym.setPadding(dp(16), dp(16), dp(16), dp(16))
                root.addView(card_ym)

                ym_header = LinearLayout(act)
                ym_header.setOrientation(LinearLayout.HORIZONTAL)
                ym_header.setGravity(Gravity.CENTER_VERTICAL)
                ym_header.setPadding(0, 0, 0, dp(14))
                card_ym.addView(ym_header)

                ym_title = TextView(act)
                ym_title.setText(L.g("ym_title"))
                ym_title.setTextSize(16)
                ym_title.setTypeface(Typeface.create("sans-serif-medium", Typeface.NORMAL))
                ym_title.setTextColor(text_primary)
                ym_header.addView(ym_title, LinearLayout.LayoutParams(0, -2, 1.0))

                ym_token = str(plugin.get_setting("yandex_token", "") or "").strip()
                ym_has_token = bool(ym_token)
                ym_enabled = bool(plugin.get_setting("yandex_enabled", True))

                ym_status = TextView(act)
                ym_status.setTextSize(12)
                ym_status.setTypeface(Typeface.create("sans-serif-medium", Typeface.NORMAL))
                if ym_has_token and ym_enabled:
                    ym_status.setText(L.g("ym_status_connected"))
                    ym_status.setTextColor(status_ok)
                elif ym_has_token and not ym_enabled:
                    ym_status.setText(L.g("status_disabled"))
                    ym_status.setTextColor(status_warn)
                else:
                    ym_status.setText(L.g("ym_status_not_connected"))
                    ym_status.setTextColor(status_none)
                ym_header.addView(ym_status)

                ym_btn_row = LinearLayout(act)
                ym_btn_row.setOrientation(LinearLayout.HORIZONTAL)
                card_ym.addView(ym_btn_row)

                def _on_ym_sync():
                    _dismiss_all()
                    plugin._confirm_and_sync_ym(act)

                def _on_ym_change():
                    b = AlertDialogBuilder(act)
                    b.set_title("Изменить авторизацию")
                    b.set_message("Выберите способ входа в Яндекс:")
                    b.set_positive_button("Войти", lambda d, *a: (d.dismiss(), plugin._open_ym_auth(on_success=lambda: _ui())))
                    b.set_neutral_button("Ввести токен", lambda d, *a: (d.dismiss(), plugin._open_ym_token_input_dialog(act, on_done=lambda: _ui())))
                    b.set_negative_button("Отмена", lambda d, *a: d.dismiss())
                    b.show()

                def _on_ym_disable():
                    plugin.set_setting("yandex_enabled", False)
                    BulletinHelper.show_info("Синхронизация Яндекс Музыки выключена")
                    _ui()

                def _on_ym_clear():
                    plugin.set_setting("yandex_token", "", reload_settings=True)
                    plugin.set_setting("yandex_enabled", True)
                    BulletinHelper.show_info(L.g("ym_token_cleared"))
                    _ui()

                def _on_ym_enable():
                    plugin.set_setting("yandex_enabled", True)
                    BulletinHelper.show_success("Синхронизация Яндекс Музыки включена")
                    _ui()

                if ym_has_token and ym_enabled:
                    b_sync = _make_button(L.g("ym_sync_history_btn"), _on_ym_sync, is_accent=True)
                    p_sync = LinearLayout.LayoutParams(0, -2, 1.2)
                    p_sync.rightMargin = dp(8)
                    ym_btn_row.addView(b_sync, p_sync)

                    b_edit = _make_button("Изменить", _on_ym_change)
                    p_edit = LinearLayout.LayoutParams(0, -2, 1.0)
                    p_edit.rightMargin = dp(8)
                    ym_btn_row.addView(b_edit, p_edit)

                    b_disc = _make_button("Отключить", lambda: _show_disconnect_dialog("Яндекс", _on_ym_disable, _on_ym_clear))
                    p_disc = LinearLayout.LayoutParams(0, -2, 0.9)
                    ym_btn_row.addView(b_disc, p_disc)
                elif ym_has_token and not ym_enabled:
                    b_enable = _make_button("Включить", _on_ym_enable, is_accent=True)
                    p_enable = LinearLayout.LayoutParams(0, -2, 1.0)
                    p_enable.rightMargin = dp(8)
                    ym_btn_row.addView(b_enable, p_enable)

                    b_clear = _make_button("Очистить", _on_ym_clear)
                    p_clear = LinearLayout.LayoutParams(0, -2, 1.0)
                    ym_btn_row.addView(b_clear, p_clear)
                else:
                    b_ya_login = _make_button("Войти", lambda: (_dismiss_all(), plugin._open_ym_auth(on_success=lambda: _ui())), is_accent=True)
                    p_ya = LinearLayout.LayoutParams(0, -2, 1.2)
                    p_ya.rightMargin = dp(8)
                    ym_btn_row.addView(b_ya_login, p_ya)

                    b_token_in = _make_button("Ввести токен", lambda: plugin._open_ym_token_input_dialog(act, on_done=lambda: _ui()))
                    p_token = LinearLayout.LayoutParams(0, -2, 1.0)
                    ym_btn_row.addView(b_token_in, p_token)

                # Spacing between cards
                spacer = View(act)
                root.addView(spacer, LinearLayout.LayoutParams(-1, dp(14)))

                # ==========================================================
                # 2. YOUTUBE MUSIC CARD
                # ==========================================================
                card_ytm = LinearLayout(act)
                card_ytm.setOrientation(LinearLayout.VERTICAL)
                card_ytm.setBackground(_round_bg(bg_card, 16))
                card_ytm.setPadding(dp(16), dp(16), dp(16), dp(16))
                root.addView(card_ytm)

                ytm_header = LinearLayout(act)
                ytm_header.setOrientation(LinearLayout.HORIZONTAL)
                ytm_header.setGravity(Gravity.CENTER_VERTICAL)
                ytm_header.setPadding(0, 0, 0, dp(14))
                card_ytm.addView(ytm_header)

                ytm_title = TextView(act)
                ytm_title.setText(L.g("ytm_title"))
                ytm_title.setTextSize(16)
                ytm_title.setTypeface(Typeface.create("sans-serif-medium", Typeface.NORMAL))
                ytm_title.setTextColor(text_primary)
                ytm_header.addView(ytm_title, LinearLayout.LayoutParams(0, -2, 1.0))

                ytm_cookie = str(plugin.get_setting("ytm_cookie", "") or "").strip()
                ytm_has_session = bool(ytm_cookie and ("SAPISID=" in ytm_cookie or "__Secure-3PAPISID=" in ytm_cookie))
                ytm_enabled = bool(plugin.get_setting("ytm_enabled", True))

                ytm_status = TextView(act)
                ytm_status.setTextSize(12)
                ytm_status.setTypeface(Typeface.create("sans-serif-medium", Typeface.NORMAL))
                if ytm_has_session and ytm_enabled:
                    ytm_status.setText(L.g("ytm_status_connected"))
                    ytm_status.setTextColor(status_ok)
                elif ytm_has_session and not ytm_enabled:
                    ytm_status.setText(L.g("status_disabled"))
                    ytm_status.setTextColor(status_warn)
                else:
                    ytm_status.setText(L.g("ytm_status_not_connected"))
                    ytm_status.setTextColor(status_none)
                ytm_header.addView(ytm_status)

                ytm_btn_row = LinearLayout(act)
                ytm_btn_row.setOrientation(LinearLayout.HORIZONTAL)
                card_ytm.addView(ytm_btn_row)

                def _on_ytm_sync():
                    b = AlertDialogBuilder(act)
                    b.set_title("Синхронизация")
                    b.set_message("Синхронизировать историю YouTube Music?\n\nБудет загружена доступная история прослушиваний.")
                    b.set_positive_button("Да", lambda d, *a: (d.dismiss(), _dismiss_all(), plugin._start_full_ytm_sync(act)))
                    b.set_negative_button("Отмена", lambda d, *a: d.dismiss())
                    b.show()

                def _on_ytm_change():
                    b = AlertDialogBuilder(act)
                    b.set_title("Сменить аккаунт?")
                    b.set_message("Данные текущей сессии будут стерты из плагина.")
                    b.set_positive_button("Сменить", lambda d, *a: (d.dismiss(), _dismiss_all(), plugin._clear_ytm_session(), plugin._open_ytm_auth(on_success=lambda: _ui())))
                    b.set_negative_button("Отмена", lambda d, *a: d.dismiss())
                    b.show()

                def _on_ytm_disable():
                    plugin.set_setting("ytm_enabled", False)
                    BulletinHelper.show_info("Синхронизация YouTube Music выключена")
                    _ui()

                def _on_ytm_clear():
                    plugin._clear_ytm_session()
                    plugin.set_setting("ytm_enabled", True)
                    BulletinHelper.show_info(L.g("ytm_logged_out"))
                    _ui()

                def _on_ytm_enable():
                    plugin.set_setting("ytm_enabled", True)
                    BulletinHelper.show_success("Синхронизация YouTube Music включена")
                    _ui()

                if ytm_has_session and ytm_enabled:
                    b_ysync = _make_button(L.g("ytm_sync_history_btn"), _on_ytm_sync, is_accent=True)
                    p_ysync = LinearLayout.LayoutParams(0, -2, 1.2)
                    p_ysync.rightMargin = dp(8)
                    ytm_btn_row.addView(b_ysync, p_ysync)

                    b_yswitch = _make_button("Изменить", _on_ytm_change)
                    p_yswitch = LinearLayout.LayoutParams(0, -2, 1.0)
                    p_yswitch.rightMargin = dp(8)
                    ytm_btn_row.addView(b_yswitch, p_yswitch)

                    b_ydisc = _make_button("Отключить", lambda: _show_disconnect_dialog("YouTube Music", _on_ytm_disable, _on_ytm_clear))
                    p_ydisc = LinearLayout.LayoutParams(0, -2, 0.9)
                    ytm_btn_row.addView(b_ydisc, p_ydisc)
                elif ytm_has_session and not ytm_enabled:
                    b_yenable = _make_button("Включить", _on_ytm_enable, is_accent=True)
                    p_yenable = LinearLayout.LayoutParams(0, -2, 1.0)
                    p_yenable.rightMargin = dp(8)
                    ytm_btn_row.addView(b_yenable, p_yenable)

                    b_yclear = _make_button("Очистить", _on_ytm_clear)
                    p_yclear = LinearLayout.LayoutParams(0, -2, 1.0)
                    ytm_btn_row.addView(b_yclear, p_yclear)
                else:
                    b_ylogin = _make_button("Войти", lambda: (_dismiss_all(), plugin._open_ytm_auth(on_success=lambda: _ui())), is_accent=True)
                    p_ylogin = LinearLayout.LayoutParams(-1, -2)
                    ytm_btn_row.addView(b_ylogin, p_ylogin)

                # Spacing between cards
                spacer2 = View(act)
                root.addView(spacer2, LinearLayout.LayoutParams(-1, dp(14)))

                # ==========================================================
                # 3. SPOTIFY CARD
                # ==========================================================
                card_sp = LinearLayout(act)
                card_sp.setOrientation(LinearLayout.VERTICAL)
                card_sp.setBackground(_round_bg(bg_card, 16))
                card_sp.setPadding(dp(16), dp(16), dp(16), dp(16))
                root.addView(card_sp)

                sp_header = LinearLayout(act)
                sp_header.setOrientation(LinearLayout.HORIZONTAL)
                sp_header.setGravity(Gravity.CENTER_VERTICAL)
                sp_header.setPadding(0, 0, 0, dp(14))
                card_sp.addView(sp_header)

                sp_title = TextView(act)
                sp_title.setText(L.g("spotify_title"))
                sp_title.setTextSize(16)
                sp_title.setTypeface(Typeface.create("sans-serif-medium", Typeface.NORMAL))
                sp_title.setTextColor(text_primary)
                sp_header.addView(sp_title, LinearLayout.LayoutParams(0, -2, 1.0))

                sp_token = str(plugin.get_setting("spotify_token", "") or "").strip()
                sp_has_session = bool(sp_token)
                sp_enabled = bool(plugin.get_setting("spotify_enabled", True))

                sp_status = TextView(act)
                sp_status.setTextSize(12)
