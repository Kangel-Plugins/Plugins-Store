                if sp_has_session and sp_enabled:
                    sp_status.setText(L.g("spotify_status_connected"))
                    sp_status.setTextColor(status_ok)
                elif sp_has_session and not sp_enabled:
                    sp_status.setText(L.g("status_disabled"))
                    sp_status.setTextColor(status_warn)
                else:
                    sp_status.setText(L.g("spotify_status_not_connected"))
                    sp_status.setTextColor(status_none)
                sp_header.addView(sp_status)

                sp_btn_row = LinearLayout(act)
                sp_btn_row.setOrientation(LinearLayout.HORIZONTAL)
                card_sp.addView(sp_btn_row)

                def _on_sp_sync():
                    b = AlertDialogBuilder(act)
