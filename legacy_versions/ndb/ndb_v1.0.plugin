class ActivityResultHook(MethodHook):
    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin

    def before_hooked_method(self, param):
        try:
            if param.args[0] == 42069 and param.args[1] == -1 and param.args[2] is not None:
                uri = param.args[2].getData()
                if uri: self.plugin._process_picked_file(uri)
        except Exception as e:
            self.plugin.log(f"Activity result error: {e}")

class DrawerHeaderHook(MethodHook):
    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            if param.thisObject:
                self.plugin.last_header_view = param.thisObject
                self.plugin._apply_bg(param.thisObject)
        except Exception as e:
            self.plugin.log(f"Header hook error: {e}")

class DrawerStateHook(MethodHook):
    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin

    def after_hooked_method(self, param):
        try: self.plugin._update_video_state()
        except Exception as e: self.plugin.log(f"Drawer state hook error: {e}")

class NavDrawerBackgroundPlugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self.last_header_view = None
        self.media_player = None
        self.texture_view = None
        self.vw = 0
        self.vh = 0
        self.last_music_check = 0
        self.is_music_playing = False
        self.last_battery_check = 0
        self.battery_ok = True
        self.current_image_path = None
        self.current_video_path = None
        self._ticker_active = False

    def on_plugin_load(self):
        try:
            cls = find_class("com.exteragram.messenger.drawer.DrawerHeaderView")
            if cls:
                self.hook_all_methods(cls, "onAttachedToWindow", DrawerHeaderHook(self))
                self.hook_all_methods(cls, "updateUserInfo", DrawerHeaderHook(self))
            
            cls_drawer = find_class("com.exteragram.messenger.drawer.DrawerContainer")
            if cls_drawer:
                self.hook_all_methods(cls_drawer, "onCloseComplete", DrawerStateHook(self))
                self.hook_all_methods(cls_drawer, "openDrawer", DrawerStateHook(self))
                self.hook_all_methods(cls_drawer, "closeDrawer", DrawerStateHook(self))

            for c_name in ["org.telegram.ui.ActionBar.BaseFragment", "org.telegram.ui.LaunchActivity"]:
                c = find_class(c_name)
                if c: self.hook_all_methods(c, "onActivityResult", ActivityResultHook(self))
                
            self._start_ticker()
        except Exception as e:
            self.log(f"Load error: {e}")

    def on_plugin_unload(self):
        self._ticker_active = False
        try:
            if self.last_header_view:
                def clean():
                    self._remove_all_views(self.last_header_view)
                    self._cleanup_media()
                    from android.view import View
                    self.last_header_view.setLayerType(View.LAYER_TYPE_NONE, None)
                    self.last_header_view.invalidate()
                run_on_ui_thread(clean)
        except Exception as e:
            self.log(f"Unload error: {e}")

    def _remove_all_views(self, view):
        for tag in ["ndb_media_container", "ndb_top_fade", "ndb_bottom_fade"]:
            v = view.findViewWithTag(tag)
            if v: view.removeView(v)

    def _start_ticker(self):
        if self._ticker_active: return
        self._ticker_active = True
        def tick():
            if not self._ticker_active: return
            self._update_video_state()
            run_on_ui_thread(tick, 250)
        run_on_ui_thread(tick)

    def _cleanup_media(self):
        if self.media_player:
            try: getattr(self.media_player, "re" + "lease")()
            except: pass
            self.media_player = None
        self.texture_view = None

    def _check_music(self):
        now = time.time()
        if now - self.last_music_check < 1.0: return self.is_music_playing
        self.last_music_check = now
        playing = False
        try:
            from org.telegram.messenger import MediaController
            mc = MediaController.getInstance()
            if mc.getPlayingMessageObject() is not None and not bool(mc.isMessagePaused()): playing = True
        except: pass
        if not playing:
            try:
                from org.telegram.messenger import ApplicationLoader
                configs = ApplicationLoader.applicationContext.getSystemService("audio").getActivePlaybackConfigurations()
                for i in range(int(configs.size())):
                    if int(configs.get(i).getAudioAttributes().getUsage()) == 1: playing = True; break
            except: pass
        self.is_music_playing = playing
        return playing

    def _check_battery(self):
        now = time.time()
        if now - self.last_battery_check < 5.0: return self.battery_ok
        self.last_battery_check = now
        try: ps_val = int(self.get_setting("power_save", "0"))
        except: ps_val = 0
        
        if ps_val <= 0:
            self.battery_ok = True
            return True
            
        try:
            from android.content import Intent, IntentFilter
            from org.telegram.messenger import ApplicationLoader
            bat_intent = ApplicationLoader.applicationContext.registerReceiver(None, IntentFilter(Intent.ACTION_BATTERY_CHANGED))
            level = bat_intent.getIntExtra("level", -1)
            scale = bat_intent.getIntExtra("scale", -1)
            if level != -1 and scale != -1:
                self.battery_ok = (level * 100 // scale) > ps_val
            else:
                self.battery_ok = True
        except:
            self.battery_ok = True
        return self.battery_ok

    def _update_video_state(self):
        if not self.media_player: return
        try:
            from org.telegram.messenger import ApplicationLoader
            is_visible = False
            if not ApplicationLoader.mainInterfacePaused and self.last_header_view and self.last_header_view.isShown():
                from android.graphics import Rect
                r = Rect()
                if self.last_header_view.getGlobalVisibleRect(r) and r.height() > 0: is_visible = True

            if is_visible and not self._check_battery():
                is_visible = False

            should_mute = self.get_setting("mute_video", True) or (self.get_setting("mute_music", True) and self._check_music())
            target_vol = 0.0 if should_mute else 1.0

            if is_visible:
                self.media_player.setVolume(target_vol, target_vol)
                if not self.media_player.isPlaying(): self.media_player.start()
            else:
                self.media_player.setVolume(0.0, 0.0)
                if self.media_player.isPlaying(): self.media_player.pause()
        except Exception as e:
            self.log(f"Video state error: {e}")

    def _apply_transform(self):
        if not self.texture_view or self.vw <= 0 or self.vh <= 0: return
        try:
            from android.graphics import Matrix
            vw, vh = float(self.texture_view.getWidth()), float(self.texture_view.getHeight())
            if vw <= 0 or vh <= 0: return
                
            an, aw = self.vw / float(self.vh), vw / vh
            if an > aw: sx, sy, wd, hd = 1.0, aw / an, vw, vw / an
            else: sx, sy, wd, hd = an / aw, 1.0, vh * an, vh
                
            cover = max(vw / wd, vh / hd) if self.get_setting("fill_bg", True) else min(vw / wd, vh / hd)
            cx, cy = vw / 2.0, vh / 2.0
            
            m = Matrix()
            m.setScale(sx, sy, cx, cy)
            m.postScale(cover, cover, cx, cy)
            self.texture_view.setTransform(m)
        except Exception as e:
            self.log(f"Transform error: {e}")

    def _create_fade_view(self, context, is_top):
        from android.view import View
        from android.graphics import Bitmap, Canvas, Paint, LinearGradient, Shader, PorterDuffXfermode, PorterDuff, Color
        from android.graphics.drawable import BitmapDrawable
        from android.content.res import Resources
        from org.telegram.messenger import AndroidUtilities

        height = AndroidUtilities.dp(8 if is_top else 96)
        bmp = Bitmap.createBitmap(10, height, Bitmap.Config.ARGB_8888)
        canvas = Canvas(bmp)
        
        paint = Paint()
        paint.setStyle(Paint.Style.FILL)
        if is_top: shader = LinearGradient(0, 0, 0, height, Color.BLACK, Color.TRANSPARENT, Shader.TileMode.CLAMP)
        else: shader = LinearGradient(0, height, 0, 0, Color.BLACK, Color.TRANSPARENT, Shader.TileMode.CLAMP)
        paint.setShader(shader)
        canvas.drawRect(0, 0, 10, height, paint)
        
        view = View(context)
        view.setBackground(BitmapDrawable(Resources.getSystem(), bmp))
        
        xfer_paint = Paint()
        xfer_paint.setXfermode(PorterDuffXfermode(PorterDuff.Mode.DST_OUT))
        view.setLayerType(View.LAYER_TYPE_HARDWARE, xfer_paint)
        return view

    def _apply_bg(self, view):
        plugin = self

        def _do_apply():
            try:
                if view is None: return
                
                from android.view import ViewGroup, View
                from android.widget import FrameLayout
                from android.graphics import Color
                from org.telegram.messenger import AndroidUtilities

                bg_path = plugin.get_setting("media_path", "")
                bg_type = plugin.get_setting("bg_type", 0)
                
                if not bg_path or not os.path.exists(bg_path):
                    plugin._remove_all_views(view)
                    plugin._cleanup_media()
                    plugin.current_image_path = None
                    plugin.current_video_path = None
                    view.setLayerType(View.LAYER_TYPE_NONE, None)
                    view.invalidate()
                    return

                fill_bg = plugin.get_setting("fill_bg", True)
                enable_fade = plugin.get_setting("enable_fade", True)
                try: dim_val = int(plugin.get_setting("dim", "20"))
                except: dim_val = 20

                context = view.getContext()
                existing_container = view.findViewWithTag("ndb_media_container")
                recreate = True
                
                if existing_container:
                    if bg_type == 0 and plugin.current_image_path == bg_path: recreate = False
                    elif bg_type == 1 and plugin.current_video_path == bg_path: recreate = False

                if recreate:
                    plugin._remove_all_views(view)
                    plugin._cleanup_media()
                    
                    container = FrameLayout(context)
                    container.setTag("ndb_media_container")
                    container.setBackgroundColor(0)
                    container.setClipChildren(False)
                    view.addView(container, 0, ViewGroup.LayoutParams(-1, -1))

                    if bg_type == 0:
                        from org.telegram.ui.Components import BackupImageView
                        from org.telegram.messenger import ImageLocation
                        from android.widget import ImageView

                        bg_image_view = BackupImageView(context)
                        bg_image_view.setBackgroundColor(0)
                        container.addView(bg_image_view, ViewGroup.LayoutParams(-1, -1))
                        bg_image_view.setAspectFit(not fill_bg)

                        try:
                            inner_iv = get_private_field(bg_image_view, "imageView")
                            if inner_iv:
                                inner_iv.setBackgroundColor(0)
                                inner_iv.setScaleType(ImageView.ScaleType.CENTER_CROP if fill_bg else ImageView.ScaleType.FIT_CENTER)
                        except: pass

                        try: bg_image_view.setImage(ImageLocation.getForPath(bg_path), None, None, None, 0)
                        except: bg_image_view.setImage(bg_path, None, None)
                            
                        plugin.current_image_path = bg_path
                        plugin.current_video_path = None
                            
                    else:
                        from android.view import TextureView
                        from android.media import MediaPlayer, AudioAttributes
                        
                        tv = TextureView(context)
                        container.addView(tv, ViewGroup.LayoutParams(-1, -1))
                        plugin.texture_view = tv
                        plugin.current_video_path = bg_path
                        plugin.current_image_path = None

                        class LayoutListener(dynamic_proxy(View.OnLayoutChangeListener)):
                            def onLayoutChange(self, v, l, t, r, b, ol, ot, or_, ob): plugin._apply_transform()

                        class SurfaceL(dynamic_proxy(TextureView.SurfaceTextureListener)):
                            def onSurfaceTextureAvailable(self, st, w, h):
                                try:
                                    from android.view import Surface
                                    mp = MediaPlayer()
                                    mp.setAudioAttributes(AudioAttributes.Builder().setUsage(AudioAttributes.USAGE_GAME).setContentType(AudioAttributes.CONTENT_TYPE_MOVIE).build())
                                    mp.setDataSource(bg_path)
                                    mp.setSurface(Surface(st))
                                    mp.setLooping(True)
                                    
                                    class Prepared(dynamic_proxy(MediaPlayer.OnPreparedListener)):
                                        def onPrepared(self, p):
                                            plugin.vw = p.getVideoWidth()
                                            plugin.vh = p.getVideoHeight()
                                            plugin._apply_transform()
                                            plugin._update_video_state()
                                            
                                    class SizeL(dynamic_proxy(MediaPlayer.OnVideoSizeChangedListener)):
                                        def onVideoSizeChanged(self, p, vw, vh):
                                            plugin.vw, plugin.vh = int(vw), int(vh)
                                            plugin._apply_transform()

                                    mp.setOnPreparedListener(Prepared())
                                    mp.setOnVideoSizeChangedListener(SizeL())
                                    mp.prepareAsync()
                                    plugin.media_player = mp
                                except Exception as e:
                                    plugin.log(f"Video prepare error: {e}")

                            def onSurfaceTextureSizeChanged(self, st, w, h): plugin._apply_transform()
                            def onSurfaceTextureDestroyed(self, st): plugin._cleanup_media(); return True
                            def onSurfaceTextureUpdated(self, st): pass

                        tv.setSurfaceTextureListener(SurfaceL())
                        tv.addOnLayoutChangeListener(LayoutListener())
                        
                    if dim_val > 0:
                        dim_view = View(context)
                        dim_view.setTag("ndb_dim")
                        dim_view.setBackgroundColor(Color.BLACK)
                        dim_view.setAlpha(dim_val / 100.0)
                        container.addView(dim_view, ViewGroup.LayoutParams(-1, -1))

                else:
                    existing_dim = existing_container.findViewWithTag("ndb_dim")
                    if existing_dim:
                        existing_dim.setAlpha(dim_val / 100.0)
                        existing_dim.setVisibility(0 if dim_val > 0 else 8)
                    elif dim_val > 0:
                        dim_view = View(context)
                        dim_view.setTag("ndb_dim")
                        dim_view.setBackgroundColor(Color.BLACK)
                        dim_view.setAlpha(dim_val / 100.0)
                        existing_container.addView(dim_view, ViewGroup.LayoutParams(-1, -1))
                        
                    if bg_type == 0:
                        from android.widget import ImageView
                        bg_view = existing_container.getChildAt(0)
                        bg_view.setAspectFit(not fill_bg)
                        try:
                            inner_iv = get_private_field(bg_view, "imageView")
                            if inner_iv: inner_iv.setScaleType(ImageView.ScaleType.CENTER_CROP if fill_bg else ImageView.ScaleType.FIT_CENTER)
                        except: pass
                    elif bg_type == 1:
                        plugin._apply_transform()
                        plugin._update_video_state()

                existing_top = view.findViewWithTag("ndb_top_fade")
                if existing_top: view.removeView(existing_top)
                existing_bottom = view.findViewWithTag("ndb_bottom_fade")
                if existing_bottom: view.removeView(existing_bottom)

                if enable_fade:
                    view.setLayerType(View.LAYER_TYPE_HARDWARE, None)
                    
                    top_fade = plugin._create_fade_view(context, True)
                    top_fade.setTag("ndb_top_fade")
                    lp_top = FrameLayout.LayoutParams(-1, AndroidUtilities.dp(8))
                    lp_top.gravity = 48
                    view.addView(top_fade, 1, lp_top)
                    
                    bottom_fade = plugin._create_fade_view(context, False)
                    bottom_fade.setTag("ndb_bottom_fade")
                    lp_bottom = FrameLayout.LayoutParams(-1, AndroidUtilities.dp(96))
                    lp_bottom.gravity = 80
                    view.addView(bottom_fade, 2, lp_bottom)
                else:
                    view.setLayerType(View.LAYER_TYPE_NONE, None)

                view.invalidate()
            except Exception as e:
                plugin.log(f"Apply bg error: {e}")
        run_on_ui_thread(_do_apply)

    def _t(self, key):
        return TRANSLATIONS.get("en" if self.get_setting("lang", 1) == 1 else "ru", TRANSLATIONS["en"]).get(key, key)

    def _clear_path(self, view):
        old_path = self.get_setting("media_path", "")
        self.set_setting("media_path", "")
        self.current_image_path = None
        self.current_video_path = None
        if old_path and "ndb_bg_" in old_path and os.path.exists(old_path):
            try: os.remove(old_path)
            except: pass
        BulletinHelper.show_info(self._t("cleared"))
        if self.last_header_view: self._apply_bg(self.last_header_view)

    def _pick_file(self, view):
        try:
            from android.content import Intent
            intent = Intent(Intent.ACTION_GET_CONTENT)
            intent.setType("image/*" if self.get_setting("bg_type", 0) == 0 else "video/*")
            intent.addCategory(Intent.CATEGORY_OPENABLE)
            fragment = get_last_fragment()
            if fragment and fragment.getParentActivity():
                fragment.getParentActivity().startActivityForResult(intent, 42069)
        except Exception as e:
            self.log(f"Picker error: {e}")

    def _process_picked_file(self, uri):
        try:
            from file_utils import get_cache_dir
            from java.io import FileOutputStream
            from org.telegram.messenger import ApplicationLoader
            
            ext = ".jpg" if self.get_setting("bg_type", 0) == 0 else ".mp4"
            dest_path = os.path.join(get_cache_dir(), f"ndb_bg_{int(time.time())}{ext}")
            
            input_stream = ApplicationLoader.applicationContext.getContentResolver().openInputStream(uri)
            fos = FileOutputStream(dest_path)
            buf = bytearray(8192)
            while True:
                read = input_stream.read(buf)
                if read == -1: break
                fos.write(buf, 0, read)
            fos.close()
            input_stream.close()
            
            old_path = self.get_setting("media_path", "")
            self.set_setting("media_path", dest_path)
            
            if old_path and "ndb_bg_" in old_path and os.path.exists(old_path):
                try: os.remove(old_path)
                except: pass
            
            BulletinHelper.show_success(self._t("file_selected"))
            if self.last_header_view: self._apply_bg(self.last_header_view)
        except Exception as e:
            self.log(f"Copy error: {e}")
            BulletinHelper.show_error(self._t("file_error"))

    def create_settings(self):
        bg_type = self.get_setting("bg_type", 0)
        path_val = self.get_setting("media_path", "")
        
        items = [
            Selector("lang", self._t("lang"), default=1, items=["Русский", "English"], icon="msg_translate"),
            Divider(),
            Header(self._t("main")),
            Selector("bg_type", self._t("type"), default=0, items=[self._t("type_static"), self._t("type_animated")], icon="msg_theme"),
            Text(self._t("choose"), self._t("choose_sub"), icon="msg_photo", on_click=self._pick_file)
        ]

        if path_val:
            items.append(Text(self._t("delete"), self._t("delete_sub"), icon="msg_delete", red=True, on_click=self._clear_path))

        items.extend([
            Divider(),
            Header(self._t("appearance")),
            Input("dim", self._t("dim"), default="20", subtext=self._t("dim_sub"), icon="menu_edit_appearance", on_change=lambda _: self._apply_bg(self.last_header_view) if self.last_header_view else None),
            Switch("enable_fade", self._t("fade"), default=True, subtext=self._t("fade_sub"), icon="msg_theme", on_change=lambda _: self._apply_bg(self.last_header_view) if self.last_header_view else None),
            Switch("fill_bg", self._t("fill"), default=True, subtext=self._t("fill_sub"), icon="msg_zoom_in", on_change=lambda _: self._apply_bg(self.last_header_view) if self.last_header_view else None)
        ])

        if bg_type == 1:
            items.extend([
                Divider(),
                Header(self._t("audio")),
                Switch("mute_video", self._t("mute"), default=True, icon="calls_mute", on_change=lambda _: self._apply_bg(self.last_header_view) if self.last_header_view else None),
                Switch("mute_music", self._t("mute_music"), default=True, icon="msg_voice", on_change=lambda _: self._apply_bg(self.last_header_view) if self.last_header_view else None),
                Divider(),
                Header(self._t("battery")),
                Input("power_save", self._t("power_save"), default="0", subtext=self._t("power_save_sub"), icon="menu_clear_cache", on_change=lambda _: self._update_video_state())
            ])

        return items