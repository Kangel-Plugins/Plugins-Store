PILL_ALPHA = 0x2E  # прозрачность заливки пилюли (~18%)
PAD_X_DP = 9.0     # внутренние отступы пилюли
PAD_Y_DP = 1.0
SHIFT_DP = 4.0     # на сколько dp опущена пилюля вместе с текстом (баланс между основным текстом и разделителем)

# ячейки профиля, которые обрабатываются своими хуками
_HANDLED = {"TextDetailCell", "AboutLinkCell"}
# ячейки, где подписи трогать не нужно
_NEVER = {
    "TextCell", "HeaderCell", "ShadowSectionCell", "DividerCell", "TextInfoPrivacyCell",
    "TextCheckCell", "NotificationsCheckCell", "UserCell", "EmptyCell", "View",
}
_NEVER_SUBSTR = (
    "Channel", "Gift", "Shared", "Check", "Switch", "Header", "Shadow",
    "Empty", "Stories", "Media", "Loading", "Flicker", "Placeholder", "Page",
)

_styled = {}        # hashCode(TextView) -> [tv, bg, layer, last_text, pending_ts, created_ts]
_field_cache = {}   # имя класса ячейки -> java.lang.reflect.Field | None
_misses = {}        # имя класса -> сколько раз не нашли подпись
_generic_seen = set()
_validating = set()
_bg = {"color": None, "screen": None, "gen": 0, "source": None, "polls": 0}   # цвет шапки текущего профиля
_last_style = [0.0]
_screen_cache = [0.0, None, ""]
_overlay_logged = [None]
_cur_tv = [None]        # подпись, которую сейчас красим (чтобы понять, какому фрагменту она принадлежит)
_RING = collections.deque(maxlen=500)   # журнал последних событий (кнопка «Скопировать лог» в настройках)
_plugin_ref = [None]
_cfg_cache = [0.0, None]
_theme_cache = {}
_MISSING = object()


class _J:
    ready = False
    density = None


def _log(msg):
    try:
        _RING.append("%s %s" % (time.strftime("%H:%M:%S"), msg))
        (_alog or print)("[PillLabels] " + str(msg))
    except Exception:
        pass


def _report(msg):
    _log(msg)
    try:
        if BulletinHelper is not None:
            BulletinHelper.show_error(str(msg))
    except Exception:
        try:
            BulletinHelper.show_info(str(msg))
        except Exception:
            pass


def _ui(fn, delay=0):
    """Выполнить fn в UI-потоке (с задержкой в мс); ошибки показываем уведомлением."""
    def safe():
        try:
            fn()
        except Exception as e:
            _report("Ошибка: %s" % e)

    if _run_on_ui is not None:
        try:
            _run_on_ui(safe, delay)
            return
        except TypeError:
            try:
                _run_on_ui(safe)
                return
            except Exception:
                pass
        except Exception as e:
            _log("run_on_ui failed: %s" % e)
    safe()


def _init():
    if _J.ready:
        return
    _J.TextView = jclass("android.widget.TextView")
    _J.ViewGroup = jclass("android.view.ViewGroup")
    _J.GD = jclass("android.graphics.drawable.GradientDrawable")
    _J.LD = jclass("android.graphics.drawable.LayerDrawable")
    _J.DrawableArr = jarray(jclass("android.graphics.drawable.Drawable"))
    _J.Theme = jclass("org.telegram.ui.ActionBar.Theme")
    klass = jclass("java.lang.Class")
    _J.tv_cls = klass.forName("android.widget.TextView")
    _J.vg_cls = klass.forName("android.view.ViewGroup")
    _J.ready = True


# ---------------------------------------------------------------- цвета

def _signed(v):
    v &= 0xFFFFFFFF
    return v - 0x100000000 if v >= 0x80000000 else v


def _with_alpha(color, alpha):
    return _signed((alpha << 24) | (color & 0x00FFFFFF))


def _rgb_of(c):
    return (c >> 16) & 255, (c >> 8) & 255, c & 255


def _from_rgb(r, g, b):
    return _signed(0xFF000000 | (int(round(r)) << 16) | (int(round(g)) << 8) | int(round(b)))


def _hsv_of(c):
    r, g, b = _rgb_of(c)
    return colorsys.rgb_to_hsv(r / 255.0, g / 255.0, b / 255.0)


def _from_hsv(h, s, v):
    r, g, b = colorsys.hsv_to_rgb(h, s, v)
    return _from_rgb(r * 255, g * 255, b * 255)


def _lum(r, g, b):
    def f(c):
        c /= 255.0
        return c / 12.92 if c <= 0.03928 else ((c + 0.055) / 1.055) ** 2.4
    return 0.2126 * f(r) + 0.7152 * f(g) + 0.0722 * f(b)


def _parse_hex(s):
    s = (s or "").strip().lstrip("#")
    if len(s) == 3:
        s = "".join(c * 2 for c in s)
    if len(s) != 6:
        return None
    try:
        return _signed(0xFF000000 | int(s, 16))
    except ValueError:
        return None


def _theme(names, fallback, ttl=0.6):
    now = time.monotonic()
    e = _theme_cache.get(names[0])
    if e is not None and now - e[0] < ttl:
        return e[1]
    val = fallback
    for n in names:
        try:
            val = _J.Theme.getColor(getattr(_J.Theme, n))
            break
        except Exception:
            continue
    _theme_cache[names[0]] = (now, val)
    return val


def _accent():
    return _theme(
        ("key_windowBackgroundWhiteBlueText", "key_chats_actionBackground", "key_featuredStickers_addButton"),
        _signed(0xFF8774E1),
    )


def _gray():
    return _theme(("key_windowBackgroundWhiteGrayText2", "key_windowBackgroundWhiteGrayText"), _signed(0xFF8A8A8A))


def _card_bg():
    return _theme(("key_windowBackgroundWhite",), _signed(0xFF000000))


def _is_dark():
    r, g, b = _rgb_of(_card_bg())
    return _lum(r, g, b) < 0.4


def _readable(color, ratio=4.5):
    """Подтягивает цвет к белому/чёрному, пока он не станет читаемым на фоне карточки профиля."""
    try:
        r, g, b = _rgb_of(color)
        br, bg_, bb = _rgb_of(_card_bg())
        lb = _lum(br, bg_, bb)
        target = 255.0 if lb < 0.5 else 0.0
        rr, gg, bb2 = r, g, b
        for i in range(11):
            t = i / 10.0
            rr = r + (target - r) * t
            gg = g + (target - g) * t
            bb2 = b + (target - b) * t
            lc = _lum(rr, gg, bb2)
            if (max(lc, lb) + 0.05) / (min(lc, lb) + 0.05) >= ratio:
                break
        return _from_rgb(rr, gg, bb2)
    except Exception:
        return color


def _derive_bg_color(r, g, b):
    h, s, v = colorsys.rgb_to_hsv(r / 255.0, g / 255.0, b / 255.0)
    if s < 0.15 or v < 0.20:
        return None  # шапка серая/чёрная — своего цвета у профиля нет
    if _is_dark():
        s, v = min(max(s, 0.28), 0.62), 0.96
    else:
        s, v = min(max(s, 0.50), 0.90), 0.52
    return _from_hsv(h, s, v)


PRESETS = [
    ("🎨 Как в теме", "auto"),
    ("🖼 С фона профиля", "profile"),
    ("🟣 Фиолетовый", "#B388FF"),
    ("🔵 Синий", "#5AA2FF"),
    ("🩵 Бирюзовый", "#4DD0E1"),
    ("🟢 Зелёный", "#66D17A"),
    ("🟡 Жёлтый", "#F5C84B"),
    ("🟠 Оранжевый", "#FF9B4A"),
    ("🔴 Красный", "#FF6B6B"),
    ("🩷 Розовый", "#FF7EB6"),
    ("✏️ Свой цвет…", "custom"),
]
CUSTOM_IDX = len(PRESETS) - 1
DEFAULT_IDX = 1  # «С фона профиля»


def _color_idx(plugin):
    try:
        idx = int(plugin.get_setting("pill_color_idx", DEFAULT_IDX))
    except Exception:
        idx = DEFAULT_IDX
    return max(0, min(len(PRESETS) - 1, idx))


def _migrate_settings(plugin):
    """Старая строковая настройка pill_color -> индекс в списке."""
    try:
        if plugin.get_setting("pill_color_idx", None) is not None:
            return
        old = plugin.get_setting("pill_color", None)
        if old is None:
            return
        old = str(old).strip()
        idx = None
        for i, (_, v) in enumerate(PRESETS):
            if v.lower() == old.lower():
                idx = i
        if idx is None and _parse_hex(old) is not None:
            plugin.set_setting("custom_color", old if old.startswith("#") else "#" + old)
            idx = CUSTOM_IDX
        if idx is not None:
            plugin.set_setting("pill_color_idx", idx)
    except Exception as e:
        _log("migrate failed: %s" % e)


def _cfg(plugin):
    now = time.monotonic()
    if _cfg_cache[1] is not None and now - _cfg_cache[0] < 0.5:
        return _cfg_cache[1]
    c = {
        "enabled": bool(plugin.get_setting("enabled", True)),
        "mode": PRESETS[_color_idx(plugin)][1],
        "custom": str(plugin.get_setting("custom_color", "") or ""),
    }
    _cfg_cache[0] = now
    _cfg_cache[1] = c
    return c


# ---------------------------------------------------------------- поиск подписи в ячейке

def _get_field_walk(cls, name):
    c = cls
    while c is not None:
        try:
            f = c.getDeclaredField(name)
            f.setAccessible(True)
            return f
        except Exception:
            pass
        c = c.getSuperclass()
    return None


def _lookup_value_field(cell):
    cls = cell.getClass()
    for name in ("valueTextView", "valueText", "subtitleTextView", "subtitle"):
        f = _get_field_walk(cls, name)
        if f is not None and _J.tv_cls.isAssignableFrom(f.getType()):
            return f
    found = []
    for f in cls.getDeclaredFields():
        if _J.tv_cls.isAssignableFrom(f.getType()):
            f.setAccessible(True)
            found.append(f)
    if len(found) >= 2:
        return found[1]
    if len(found) == 1 and "AboutLinkCell" in str(cls.getName()):
        return found[0]
    return None


def _value_view(cell):
    cn = str(cell.getClass().getName())
    f = _field_cache.get(cn, _MISSING)
    if f is _MISSING:
        f = _lookup_value_field(cell)
        _field_cache[cn] = f
        _log("%s: value view %s" % (cn, "found" if f is not None else "NOT found"))
    if f is None:
        return None
    v = f.get(cell)
    return cast(_J.TextView, v) if v is not None else None


def _collect_tvs(view, out, depth):
    if not _J.vg_cls.isInstance(view):
        return
    vg = cast(_J.ViewGroup, view)
    for i in range(vg.getChildCount()):
        c = vg.getChildAt(i)
        if _J.tv_cls.isInstance(c):
            out.append(cast(_J.TextView, c))
        elif depth < 4:
            _collect_tvs(c, out, depth + 1)


def _find_label(cell):
    """Эвристика для незнакомых ячеек: серый текст помельче, под более крупным."""
    tvs = []
    _collect_tvs(cell, tvs, 0)
    cand = []
    for tv in tvs:
        t = tv.getText()
        if t is None or len(str(t).strip()) == 0 or tv.getVisibility() != 0:
            continue
        cand.append((tv, float(tv.getTextSize())))
    if len(cand) < 2:
        return None
    max_size = max(s for _, s in cand)
    g2 = _gray()
    g1 = _theme(("key_windowBackgroundWhiteGrayText",), g2)
    for tv, size in cand:
        if size >= max_size * 0.92:
            continue
        if int(tv.hashCode()) in _styled or int(tv.getCurrentTextColor()) in (g2, g1):
            return tv
    return None


def _generic(plugin, cell):
    _init()
    cn = str(cell.getClass().getName())
    simple = cn.rsplit(".", 1)[-1].rsplit("$", 1)[-1]
    if simple in _HANDLED or simple in _NEVER or any(x in simple for x in _NEVER_SUBSTR):
        return
    if _misses.get(cn, 0) >= 3:
        return
    label = _find_label(cell)
    if label is None:
        n = _misses.get(cn, 0) + 1
        _misses[cn] = n
        if n == 3:
            _log("no label found in %s (skipped)" % cn)
        return
    h = int(label.hashCode())
    if h in _styled:  # уже прошла проверку раньше — просто обновляем
        _style_label(plugin, label)
        return
    if h not in _validating:
        _validating.add(h)
        _ui(lambda: _validate_generic(plugin, cell, label, cn, 1), 120)


def _validate_generic(plugin, cell, label, cn, attempt=1):
    """Красим неизвестную подпись только если по факту это строка «значение + подпись» слева, а не пустой экран/заглушка."""
    h = int(label.hashCode())
    if label.getWidth() <= 0 or cell.getHeight() <= 0:
        if attempt < 4:  # ещё не разложено — проверим чуть позже
            _ui(lambda: _validate_generic(plugin, cell, label, cn, attempt + 1), 250)
        else:
            _validating.discard(h)
        return
    _validating.discard(h)
    d = _J.density or float(label.getResources().getDisplayMetrics().density)
    t = label.getText()
    text = str(t) if t is not None else ""
    reason = None
    if label.getLineCount() > 1:
        reason = "multi-line label"
    elif (int(label.getGravity()) & 7) == 1:
        reason = "centered label"
    elif cell.getHeight() > int(150 * d):
        reason = "tall cell"
    elif len(text) > 60:
        reason = "long label"
    elif label.getLeft() < int(PAD_X_DP * d):
        reason = "no room on the left"
    if reason is not None:
        _misses[cn] = 3  # этот класс больше не трогаем
        if cn not in _generic_seen:
            _generic_seen.add(cn)
            _log("label rejected in %s: %s" % (cn, reason))
        return
    if cn not in _generic_seen:
        _generic_seen.add(cn)
        _log("generic label in %s" % cn)
    _style_label(plugin, label)


# ---------------------------------------------------------------- пилюля

def _screen_id():
    """Идентификатор верхнего фрагмента: у каждого открытого экрана свой."""
    now = time.monotonic()
    if now - _screen_cache[0] < 0.3:
        return _screen_cache[1]
    sid = None
    cname = ""
    try:
        from client_utils import get_last_fragment
        f = get_last_fragment()
        if f is not None:
            sid = int(f.hashCode())
            cname = str(f.getClass().getName())
    except Exception:
        pass
    _screen_cache[0] = now
    _screen_cache[1] = sid
    _screen_cache[2] = cname
    return sid


def _tv_in_top_fragment(tv):
    """Принадлежит ли подпись верхнему фрагменту. Если сверху чужой экран (плеер, диалог, бабл…),
    а подпись из профиля под ним — смену экрана засчитывать нельзя, иначе цвет сбрасывается."""
    try:
        from client_utils import get_last_fragment
        f = get_last_fragment()
        root = f.getFragmentView() if f is not None else None
        if root is None:
            return True
        if not bool(tv.isAttachedToWindow()):
            return True  # при открытии профиля ячейки биндятся до прикрепления: цепочка родителей ещё пуста
        p = tv.getParent()
        for _ in range(60):
            if p is None:
                return False
            if p == root:
                return True
            p = p.getParent()
        return False
    except Exception:
        return True  # проверить не удалось — ведём себя как раньше


# ---------------------------------------------------------------- цвет фона профиля из данных (не с экрана)

_method_cache = {}
_pc_fields = {}


def _num(v):
    """Число из чего угодно, что вернула рефлексия (boxed Integer/Long, int)."""
    return int(str(v))


def _fget(obj, name):
    """Значение поля (в т.ч. публичного) через рефлексию, без приведения типов."""
    f = _get_field_walk(obj.getClass(), name)
    if f is None:
        return None
    return f.get(obj)


def _invoke(obj, name, *args):
    """Вызов публичного метода по имени и числу аргументов (объекты из рефлексии приходят без типа)."""
    cls = obj.getClass()
    key = (str(cls.getName()), name, len(args))
    m = _method_cache.get(key, _MISSING)
    if m is _MISSING:
        m = None
        for cand in cls.getMethods():
            if cand.getName() == name and len(cand.getParameterTypes()) == len(args):
                m = cand
                break
        _method_cache[key] = m
    if m is None:
        raise AttributeError("%s.%s/%d" % (key[0], name, len(args)))
    return m.invoke(obj, *args)


def _theme_dark():
    try:
        return bool(_J.Theme.isCurrentThemeDark())
    except Exception:
        return _is_dark()


def _peer_bgs(peer, dark):
    """Цвета фона из MessagesController.PeerColor: (bg1, bg2) как ARGB."""
    for names in (("getBgColor1", "getBgColor2"), ("getColor1", "getColor2")):
        vals = []
        for n in names:
            try:
                try:
                    v = _invoke(peer, n, dark)
                except AttributeError:
                    v = _invoke(peer, n)
                vals.append(_signed(0xFF000000 | (_num(v) & 0xFFFFFF)))
            except Exception:
                pass
        if vals:
            return vals
    return []


def _fragment_peer_bgs(frag, dark):
    """Фрагмент профиля сам хранит PeerColor, по которому рисует шапку — читаем его поля."""
    cls = frag.getClass()
    cn = str(cls.getName())
    fields = _pc_fields.get(cn)
    if fields is None:
        fields = []
        c = cls
        while c is not None and str(c.getName()) != "java.lang.Object":
            for f in c.getDeclaredFields():
                try:
                    tn = str(f.getType().getName())
                    if tn.endswith("$PeerColor") or tn.endswith(".PeerColor"):
                        f.setAccessible(True)
                        fields.append(f)
                except Exception:
                    pass
            c = c.getSuperclass()
        fields.sort(key=lambda f: 0 if ("profile" in str(f.getName()).lower() or "peercolor" in str(f.getName()).lower()) else 1)
        _pc_fields[cn] = fields
        _log("PeerColor-поля в %s: %s" % (cn, [str(f.getName()) for f in fields]))
    for f in fields:
        try:
            v = f.get(frag)
            if v is None:
                continue
            bgs = _peer_bgs(v, dark)
            if bgs:
                return str(f.getName()), bgs
        except Exception:
            pass
    return None, []


def _profile_target(frag):
    """(аккаунт, 'user'|'chat', id) профиля, который сейчас открыт, или None."""
    try:
        acc = int(frag.getCurrentAccount())
    except Exception:
        acc = int(jclass("org.telegram.messenger.UserConfig").selectedAccount)
    args = None
    try:
        args = frag.getArguments()
    except Exception:
        pass
    if args is not None:
        for key, kind in (("user_id", "user"), ("chat_id", "chat"), ("channel_id", "chat")):
            try:
                if bool(args.containsKey(key)):
                    v = _num(args.get(key))
                    if v:
                        return acc, kind, abs(v)
            except Exception:
                pass
    if "profile" in str(frag.getClass().getName()).lower():  # вкладка «Профиль» — свой профиль
        try:
            uid = _num(jclass("org.telegram.messenger.UserConfig").getInstance(acc).getClientUserId())
            if uid:
                return acc, "user", uid
        except Exception:
            pass
    return None


def _collectible_bgs(pc, dark):
    """Коллекционный цвет профиля (подарок): список цветов в поле colors / dark_colors."""
    for name in (("dark_colors", "colors") if dark else ("colors",)):
        lst = _fget(pc, name)
        if lst is None:
            continue
        n = _num(_invoke(lst, "size"))
        vals = [_signed(0xFF000000 | (_num(_invoke(lst, "get", i)) & 0xFFFFFF)) for i in range(min(n, 4))]
        if vals:
            return vals
    return []


def _model_peer_bgs(acc, kind, pid, dark):
    """Читаем из памяти приложения: User/Chat.profile_color -> MessagesController.profilePeerColors."""
    mc = jclass("org.telegram.messenger.MessagesController").getInstance(acc)
    lid = jclass("java.lang.Long").valueOf(pid)
    obj = mc.getUser(lid) if kind == "user" else mc.getChat(lid)
    if obj is None:
        return "unknown", []
    helper = "org.telegram.messenger.UserObject" if kind == "user" else "org.telegram.messenger.ChatObject"
    color_id = None
    try:
        color_id = int(jclass(helper).getProfileColorId(obj))
    except Exception:
        pc = _fget(obj, "profile_color")
        if pc is None:
            color_id = -1
        else:
            if "Collectible" in str(pc.getClass().getName()):
                bgs = _collectible_bgs(pc, dark)
                return ("color", bgs) if bgs else ("unknown", [])
            v = _fget(pc, "color")
            color_id = _num(v) if v is not None else -1
    if color_id < 0:
        return "none", []
    peer = _invoke(mc.profilePeerColors, "getColor", color_id, dark)
    if peer is None:
        return "unknown", []
    bgs = _peer_bgs(peer, dark)
    return ("color", bgs) if bgs else ("unknown", [])


def _try_profile_data_color():
    """Пытаемся узнать цвет шапки из данных приложения. True — цвет (или его отсутствие) известен точно."""
    try:
        from client_utils import get_last_fragment
        frag = get_last_fragment()
    except Exception:
        frag = None
    if frag is None:
        return False
    dark = _theme_dark()
    src, bgs = None, []
    try:
        src, bgs = _fragment_peer_bgs(frag, dark)
        if bgs:
            src = "fragment." + src
    except Exception as e:
        _log("fragment PeerColor read failed: %s" % e)
    status = None
    if not bgs:
        try:
            tgt = _profile_target(frag)
            if tgt is not None:
                status, bgs = _model_peer_bgs(tgt[0], tgt[1], tgt[2], dark)
                src = "%s:%s" % (tgt[1], tgt[2])
        except Exception as e:
            _log("profile data read failed: %s" % e)
    if not bgs:
        _log("цвет профиля из данных не получен (%s) — замер с экрана" % (status or "нет данных"))
        return False
    r1, g1, b1 = _rgb_of(bgs[0])
    r2, g2, b2 = _rgb_of(bgs[-1])
    t = 0.35 if len(bgs) > 1 else 0.0  # замер раньше шёл вверху шапки, ближе к первому цвету градиента
    base = _from_rgb(r1 + (r2 - r1) * t, g1 + (g2 - g1) * t, b1 + (b2 - b1) * t)
    derived = _derive_bg_color(*_rgb_of(base))
    _bg["color"] = derived
    _bg["source"] = "data"
    _log("цвет профиля из данных (%s): bg=%s -> %s" % (
        src, ["#%06X" % (c & 0xFFFFFF) for c in bgs], "цвет темы (нейтральный)" if derived is None else "#%06X" % (derived & 0xFFFFFF)))
    return True


def _retry_data(sid):
    _screen_cache[0] = 0.0  # не верим кэшу экрана
    if _screen_id() != sid or _bg["screen"] != sid or _bg.get("source") == "data":
        return
    if _try_profile_data_color():
        _bg["gen"] += 1  # устаревшие замеры с экрана больше не нужны
        _recolor_styled()


def _header_photo_expanded():
    """True, если аватарка развёрнута на всю шапку (виден ProfileGalleryView): тогда в полосе замера
    не фон профиля, а фото, и брать с него цвет нельзя."""
    try:
        root = None
        try:
            from client_utils import get_last_fragment
            f = get_last_fragment()
            if f is not None:
                root = f.getFragmentView()
        except Exception:
            root = None
        if root is None:
            ctx = _context()
            root = ctx.getWindow().getDecorView() if ctx is not None else None
        if root is None:
            return False
        full_w = int(root.getWidth())
        pending = [(root, 0)]
        seen = 0
        while pending and seen < 500:
            v, depth = pending.pop(0)
            seen += 1
            name = str(v.getClass().getName())
            if "ProfileGalleryView" in name or "AvatarsViewPager" in name:
                if (int(v.getVisibility()) == 0 and float(v.getAlpha()) > 0.6
                        and int(v.getHeight()) > 0 and int(v.getWidth()) >= 0.8 * full_w):
                    return True
                continue
            if depth >= 10 or "RecyclerView" in name or "RecyclerListView" in name:
                continue
            if _J.vg_cls.isInstance(v):
                vg = cast(_J.ViewGroup, v)
                for i in range(vg.getChildCount()):
                    pending.append((vg.getChildAt(i), depth + 1))
        return False
    except Exception as e:
        _log("expanded-header check failed: %s" % e)
        return False


def _profile_base():
    now = time.monotonic()
    sid = _screen_id()
    tv = _cur_tv[0]
    if sid is not None:
        new_screen = _bg["screen"] != sid
        if new_screen and _bg["screen"] is not None and tv is not None and not _tv_in_top_fragment(tv):
            # Сверху другой фрагмент, а красим подпись профиля под ним — это не смена экрана.
            if _overlay_logged[0] != sid:
                _overlay_logged[0] = sid
                _log("top fragment %s is not the owner of this label — keeping profile colour" % (_screen_cache[2] or sid))
            new_screen = False
    else:  # нет доступа к фрагменту: прежнее состояние держим, новую «сессию» начинаем только после долгой паузы
        new_screen = _bg["screen"] is None or now - _last_style[0] > 20.0
        sid = _bg["screen"] if not new_screen else None
    _last_style[0] = now
    if new_screen:
        _log("new profile screen: id=%s class=%s" % (sid, _screen_cache[2]))
        _bg["screen"] = sid
        _bg["color"] = None
        _bg["source"] = None
        _bg["polls"] = 0
        if _try_profile_data_color():
            _bg["gen"] += 1
        else:
            _request_bg()
            for delay in (500, 1500):  # данные профиля (поля фрагмента) могут появиться чуть позже
                _ui(lambda sid=sid: _retry_data(sid), delay)
        for delay in (0, 400):  # подписи, покрашенные до определения цвета, получают актуальный цвет
            _ui(_recolor_styled, delay)
    c = _bg["color"]
    return c if c is not None else _accent()


def _base_color(cfg):
    mode = cfg["mode"]
    if mode == "profile":
        return _profile_base()
    if mode == "auto":
        return _accent()
    c = _parse_hex(cfg["custom"] if mode == "custom" else mode)
    return c if c is not None else _accent()


def _prune():
    now = time.monotonic()
    for h in list(_styled.keys()):
        ent = _styled[h]
        try:
            # только давно созданные и уже отсоединённые: свежепривязанная ячейка может быть ещё не прикреплена
            if now - ent[5] > 30.0 and not ent[0].isAttachedToWindow():
                del _styled[h]
        except Exception:
            _styled.pop(h, None)


class _OneShot(dynamic_proxy(jclass("android.view.View$OnLayoutChangeListener"))):
    """Срабатывает до первого лэйаута с известной шириной и снимает себя."""

    def __init__(self, fn):
        super().__init__()
        self.fn = fn

    def onLayoutChange(self, v, left, top, right, bottom, old_left, old_top, old_right, old_bottom):
        try:
            if self.fn(v):
                v.removeOnLayoutChangeListener(self)
        except Exception as e:
            _log("layout error: %s" % e)


def _sync(tv, ent):
    """Подгоняет правый отступ фона под ширину текста, если подпись растянута на всю строку."""
    w = tv.getWidth()
    want = int(math.ceil(tv.getPaint().measureText(str(tv.getText())))) + tv.getPaddingLeft() + tv.getPaddingRight()
    extra = (w - want) if w > want else 0
    ent[2].setLayerInset(0, 0, 0, extra, 0)


def _on_layout(v):
    tv = cast(_J.TextView, v)
    ent = _styled.get(int(tv.hashCode()))
    if ent is None:
        return True
    if tv.getWidth() <= 0:
        return False
    if _J.density:
        px = int(round(PAD_X_DP * _J.density))
        # сдвиг влево не должен выходить за границу родителя — иначе пилюлю обрежет с одной стороны
        tv.setTranslationX(float(-min(px, max(0, int(tv.getLeft())))))
    _sync(tv, ent)
    ent[4] = 0.0
    return True


def _reset(tv):
    ent = _styled.pop(int(tv.hashCode()), None)
    if ent is None:
        return
    _log("pill removed: %r" % (ent[3],))
    tv.setBackground(None)
    tv.setPadding(0, 0, 0, 0)
    tv.setTranslationX(0.0)
    tv.setTranslationY(0.0)
    tv.setTextColor(_gray())


def _style_label(plugin, tv):
    _init()
    cfg = _cfg(plugin)
    text = tv.getText()
    if not cfg["enabled"] or text is None or len(str(text).strip()) == 0 or tv.getVisibility() != 0:
        _reset(tv)
        return

    if _J.density is None:
        _J.density = float(tv.getResources().getDisplayMetrics().density)
    d = _J.density
    px, py = int(round(PAD_X_DP * d)), int(round(PAD_Y_DP * d))
    shift = int(round(SHIFT_DP * d))

    _cur_tv[0] = tv
    vis = _readable(_base_color(cfg))

    h = int(tv.hashCode())
    ent = _styled.get(h)
    is_new = ent is None
    if ent is None:
        if len(_styled) > 60:
            _prune()
        bg = _J.GD()
        bg.setCornerRadius(9999.0)  # GradientDrawable сам ограничит радиус до половины высоты
        layer = _J.LD(_J.DrawableArr([bg]))
        ent = [tv, bg, layer, None, 0.0, time.monotonic()]
        _styled[h] = ent

    # Профиль обновляется (появилась плашка музыки, пришли данные, сменились цвета) и ячейка «О себе»
    # может заново выставить фон/паддинг/цвет своей подписи уже ПОСЛЕ нашей раскраски. Поэтому при каждом
    # проходе проверяем, что наш drawable и паддинг на месте, и восстанавливаем их.
    restored = False
    try:
        current_bg = tv.getBackground()
        if current_bg is None or int(current_bg.hashCode()) != int(ent[2].hashCode()):
            tv.setBackground(ent[2])  # сначала фон, потом паддинг
            restored = True
    except Exception:
        try:
            tv.setBackground(ent[2])
            restored = True
        except Exception:
            pass
    try:
        if (int(tv.getPaddingLeft()) != px or int(tv.getPaddingTop()) != py or
                int(tv.getPaddingRight()) != px or int(tv.getPaddingBottom()) != py):
            tv.setPadding(px, py, px, py)
            restored = True
    except Exception:
        pass
    if ent[3] is None or restored:
        tv.setTranslationX(float(-px))  # компенсируем паддинг, текст остаётся на месте
        try:
            lp = tv.getLayoutParams()
            if lp is not None and lp.width != -2:
                lp.width = -2         # WRAP_CONTENT: пилюля ровно по тексту
                tv.setLayoutParams(lp)
        except Exception:
            pass
    tv.setTranslationY(float(shift - py))
    ent[1].setColor(_with_alpha(vis, PILL_ALPHA))
    tv.setTextColor(vis)

    cur = str(text)
    if ent[3] != cur or restored:
        ent[3] = cur
        ent[2].setLayerInset(0, 0, 0, 0, 0)
        now = time.monotonic()
        if now - ent[4] > 1.0:
            ent[4] = now
            tv.addOnLayoutChangeListener(_OneShot(_on_layout))
    if restored and not is_new:
        _log("pill style restored on %r (the cell had reset it)" % (cur,))

# ---------------------------------------------------------------- цвет с фона профиля

def _make_pixel_listener(fn):
    cls = getattr(_make_pixel_listener, "_cls", None)
    if cls is None:
        class _PixelListener(dynamic_proxy(jclass("android.view.PixelCopy$OnPixelCopyFinishedListener"))):
            def __init__(self, fn):
                super().__init__()
                self.fn = fn

            def onPixelCopyFinished(self, result):
                try:
                    self.fn(result)
                except Exception as e:
                    _log("pixelcopy cb error: %s" % e)

        cls = _PixelListener
        _make_pixel_listener._cls = cls
    return cls(fn)


def _color_from_bitmap(bmp):
    bw, bh = bmp.getWidth(), bmp.getHeight()
    rs, gs, bs = [], [], []
    for fy in (0.2, 0.4, 0.6, 0.8):  # строки внутри верхней полосы окна (0–20% высоты)
        for fx in (0.10, 0.18, 0.26, 0.74, 0.82, 0.90):  # слева и справа от аватарки
            px = bmp.getPixel(min(bw - 1, int(fx * bw)), min(bh - 1, int(fy * bh)))
            if ((px >> 24) & 255) < 200:
                continue
            rs.append((px >> 16) & 255)
            gs.append((px >> 8) & 255)
            bs.append(px & 255)
    if len(rs) < 8:
        return None

    def med(a):
        return sorted(a)[len(a) // 2]

    return _derive_bg_color(med(rs), med(gs), med(bs))


def _request_bg():
    _bg["gen"] += 1
    gen = _bg["gen"]
    _ui(lambda: _sample_bg(gen, 1), 120)


def _bg_done(gen, attempt, color):
    if gen != _bg["gen"]:
        return  # пока считали, открылся другой профиль
    if _bg.get("source") == "data":
        return  # цвет уже известен из данных приложения — замер с экрана не нужен
    if color is not None:
        _bg["color"] = color
        _log("colour from screen pixels: #%06X (attempt %d)" % (color & 0xFFFFFF, attempt))
        _recolor_styled()
    elif attempt < 4:
        _ui(lambda: _sample_bg(gen, attempt + 1), 400)
    else:
        _bg["color"] = None  # у профиля нет своего цвета — остаётся цвет темы
        _recolor_styled()
        _log("profile background colour not found")


def _sample_bg(gen, attempt):
    if gen != _bg["gen"]:
        return
    if _header_photo_expanded():
        # Аватарка развёрнута на всю шапку — цвет с фото не берём, ждём пока свернут (до ~30 с).
        polls = _bg.get("polls", 0) + 1
        _bg["polls"] = polls
        if polls == 1:
            _log("header photo is expanded; waiting for it to collapse before sampling")
        if polls <= 30:
            _ui(lambda: _sample_bg(gen, attempt), 1000)
        else:
            _bg_done(gen, 4, None)
        return
    ctx = _context()
    if ctx is None:
        _bg_done(gen, attempt, None)
        return
    win = ctx.getWindow()
    decor = win.getDecorView()
    w, h = decor.getWidth(), decor.getHeight()
    if w <= 0 or h <= 0:
        _bg_done(gen, attempt, None)
        return
    strip = max(1, int(h * 0.2))
    k = 8
    dw, dh = max(1, w // k), max(1, strip // k)
    bmp = jclass("android.graphics.Bitmap").createBitmap(
        dw, dh, jclass("android.graphics.Bitmap$Config").ARGB_8888
    )

    def finish(result):
        col = None
        defer = False
        try:
            if _header_photo_expanded():  # аватарку развернули, пока шла копия
                defer = True
            elif result == 0:  # PixelCopy.SUCCESS
                col = _color_from_bitmap(bmp)
        finally:
            try:
                bmp.recycle()
            except Exception:
                pass
        if defer:
            _log("header photo expanded during capture; sample discarded")
            _ui(lambda: _sample_bg(gen, attempt), 1000)
            return
        _bg_done(gen, attempt, col)

    try:
        rect = jclass("android.graphics.Rect")(0, 0, w, strip)
        handler = jclass("android.os.Handler")(jclass("android.os.Looper").getMainLooper())
        jclass("android.view.PixelCopy").request(win, rect, bmp, _make_pixel_listener(finish), handler)
        return
    except Exception as e:
        _log("PixelCopy unavailable: %s" % e)

    col = None
    try:  # запасной вариант: рисуем только верхнюю полосу окна в маленький bitmap
        cv = jclass("android.graphics.Canvas")(bmp)
        cv.scale(dw / float(w), dh / float(strip))
        decor.draw(cv)
        col = _color_from_bitmap(bmp)
    except Exception as e:
        _log("draw fallback failed: %s" % e)
    finally:
        try:
            bmp.recycle()
        except Exception:
            pass
    _bg_done(gen, attempt, col)


def _recolor_styled():
    plugin = _plugin_ref[0]
    if plugin is None:
        return
    if _cfg(plugin)["mode"] != "profile":
        return
    base = _bg["color"] if _bg["color"] is not None else _accent()
    vis = _readable(base)
    fill = _with_alpha(vis, PILL_ALPHA)
    n = 0
    for ent in list(_styled.values()):
        try:
            ent[1].setColor(fill)
            ent[0].setTextColor(vis)
            n += 1
        except Exception as e:
            _log("recolor error: %s" % e)
    _log("recolored %d labels" % n)


# ---------------------------------------------------------------- классы / контекст

def _load_class(name):
    try:
        loader = jclass("org.telegram.messenger.ApplicationLoader").applicationContext.getClassLoader()
        return loader.loadClass(name)
    except Exception as e:
        _log("loadClass failed: %s" % e)
    try:
        return jclass("java.lang.Class").forName(name)
    except Exception as e:
        _log("forName failed: %s" % e)
    try:
        from hook_utils import find_class
        c = find_class(name)
        if c is not None and hasattr(c, "getDeclaredMethods"):
            return c
    except Exception:
        pass
    return None


def _context():
    try:
        from client_utils import get_last_fragment
        f = get_last_fragment()
        if f is not None:
            a = f.getParentActivity()
            if a is not None:
                return a
    except Exception:
        pass
    try:
        return jclass("org.telegram.ui.LaunchActivity").instance
    except Exception:
        return None


# ---------------------------------------------------------------- диалоги

class _ClickListener(dynamic_proxy(jclass("android.content.DialogInterface$OnClickListener"))):
    def __init__(self, fn):
        super().__init__()
        self.fn = fn

    def onClick(self, dialog, which):
        try:
            self.fn(which)
        except Exception as e:
            _report("Ошибка в диалоге: %s" % e)


def _button_listener(fn):
    """Кнопки Telegram-диалога принимают свой тип слушателя, не DialogInterface.OnClickListener — узнаём его через рефлексию."""
    cls = getattr(_button_listener, "_cls", None)
    if cls is None:
        iface = "android.content.DialogInterface$OnClickListener"
        try:
            builder = _load_class("org.telegram.ui.ActionBar.AlertDialog$Builder")
            for m in builder.getMethods():
                if m.getName() == "setPositiveButton":
                    types = m.getParameterTypes()
                    if len(types) == 2:
                        iface = str(types[1].getName())
                        break
        except Exception as e:
            _log("button listener lookup failed: %s" % e)
        _log("button listener type: %s" % iface)

        class _BtnListener(dynamic_proxy(jclass(iface))):
            def __init__(self, fn):
                super().__init__()
                self.fn = fn

            def onClick(self, *args):
                try:
                    self.fn(args[-1] if args else 0)
                except Exception as e:
                    _report("Ошибка в диалоге: %s" % e)

        cls = _BtnListener
        _button_listener._cls = cls
    return cls(fn)


def _copy_text(text):
    ctx = _context()
    if ctx is None:
        _report("Нет контекста для буфера обмена")
        return
    cm = cast(jclass("android.content.ClipboardManager"), ctx.getSystemService("clipboard"))
    cm.setPrimaryClip(jclass("android.content.ClipData").newPlainText("pill_labels", text))
    _toast("Лог скопирован: %d символов" % len(text))


def _toast(msg):
    try:
        if BulletinHelper is not None:
            BulletinHelper.show_info(msg)
    except Exception:
        pass


def _save_custom(plugin, hx):
    plugin.set_setting("custom_color", hx)
    plugin.set_setting("pill_color_idx", CUSTOM_IDX)
    _cfg_cache[1] = None
    _toast("Цвет %s сохранён. Откройте профиль заново" % hx)


class _SeekListener(dynamic_proxy(jclass("android.widget.SeekBar$OnSeekBarChangeListener"))):
    def __init__(self, fn):
        super().__init__()
        self.fn = fn

    def onProgressChanged(self, seek_bar, progress, from_user):
        if from_user:
            try:
                self.fn(progress)
            except Exception as e:
                _log("seek error: %s" % e)

    def onStartTrackingTouch(self, seek_bar):
        pass

    def onStopTrackingTouch(self, seek_bar):
        pass


class _HexWatcher(dynamic_proxy(jclass("android.text.TextWatcher"))):
    def __init__(self, fn):
        super().__init__()
        self.fn = fn

    def beforeTextChanged(self, s, start, count, after):
        pass

    def onTextChanged(self, s, start, before, count):
        pass

    def afterTextChanged(self, editable):
        try:
            self.fn(str(editable.toString()))
        except Exception as e:
            _log("hex error: %s" % e)


def _ask_custom_hex(plugin, ctx):
    AlertDialog = jclass("org.telegram.ui.ActionBar.AlertDialog")
    et = jclass("android.widget.EditText")(ctx)
    cur = str(plugin.get_setting("custom_color", "") or "")
    et.setSingleLine(True)
    et.setHint("#RRGGBB")
    et.setText(cur if cur.startswith("#") else "#")
    et.setTextColor(_theme(("key_dialogTextBlack",), _signed(0xFFFFFFFF)))
    et.setHintTextColor(_theme(("key_dialogTextGray2", "key_windowBackgroundWhiteHintText"), _signed(0xFF888888)))
    d = ctx.getResources().getDisplayMetrics().density
    et.setPadding(int(24 * d), int(12 * d), int(24 * d), int(12 * d))

    def on_ok(_which):
        c = _parse_hex(str(et.getText()))
        if c is None:
            _report("Нужен HEX вида #RRGGBB")
            return
        _save_custom(plugin, "#%06X" % (c & 0xFFFFFF))

    b = AlertDialog.Builder(ctx)
    b.setTitle("Свой цвет (HEX)")
    b.setView(et)
    b.setPositiveButton("OK", _button_listener(on_ok))
    b.setNegativeButton("Отмена", None)
    b.show()


def _open_picker(plugin, ctx):
    try:
        _open_picker_impl(plugin, ctx)
    except Exception as e:
        _report("Палитра не открылась: %s" % e)
        try:
            _ask_custom_hex(plugin, ctx)
        except Exception as e2:
            _report("HEX-окно не открылось: %s" % e2)


def _open_picker_impl(plugin, ctx):
    AlertDialog = jclass("org.telegram.ui.ActionBar.AlertDialog")
    LinearLayout = jclass("android.widget.LinearLayout")
    LP = jclass("android.widget.LinearLayout$LayoutParams")
    TextView = jclass("android.widget.TextView")
    SeekBar = jclass("android.widget.SeekBar")
    EditText = jclass("android.widget.EditText")
    View = jclass("android.view.View")
    ScrollView = jclass("android.widget.ScrollView")
    GradientDrawable = jclass("android.graphics.drawable.GradientDrawable")

    density = ctx.getResources().getDisplayMetrics().density

    def dp(x):
        return int(round(x * density))

    text_color = _theme(("key_dialogTextBlack",), _signed(0xFFFFFFFF))
    hint_color = _theme(("key_dialogTextGray2", "key_dialogTextHint"), _signed(0xFF888888))

    start = _parse_hex(plugin.get_setting("custom_color", "")) or _readable(_accent())
    h0, s0, v0 = _hsv_of(start)
    st = {"h": h0, "s": s0, "v": v0, "busy": False}

    def current():
        return _from_hsv(st["h"], st["s"], st["v"])

    ll = LinearLayout(ctx)
    ll.setOrientation(1)
    ll.setPadding(dp(24), dp(8), dp(24), dp(8))

    def add(view, h=-2, top=0):
        lp = LP(-1, h)
        lp.topMargin = dp(top)
        ll.addView(view, lp)

    preview_bg = GradientDrawable()
    preview_bg.setCornerRadius(float(dp(14)))
    preview = View(ctx)
    preview.setBackground(preview_bg)
    add(preview, dp(44), 0)

    def make_bar(title, maximum, value, fn):
        label = TextView(ctx)
        label.setText(title)
        label.setTextColor(hint_color)
        label.setTextSize(13.0)
        add(label, -2, 12)
        bar = SeekBar(ctx)
        bar.setMax(maximum)
        bar.setProgress(value)
        bar.setOnSeekBarChangeListener(_SeekListener(fn))
        add(bar, -2, 0)
        return bar

    def on_h(p):
        st["h"] = min(p, 359.99) / 360.0
        refresh()

    def on_s(p):
        st["s"] = p / 100.0
        refresh()

    def on_v(p):
        st["v"] = p / 100.0
        refresh()

    hue_bar = make_bar("Тон", 360, int(round(st["h"] * 360)), on_h)
    sat_bar = make_bar("Насыщенность", 100, int(round(st["s"] * 100)), on_s)
    val_bar = make_bar("Яркость", 100, int(round(st["v"] * 100)), on_v)

    et = EditText(ctx)
    et.setSingleLine(True)
    et.setHint("#RRGGBB")
    et.setTextColor(text_color)
    et.setHintTextColor(hint_color)
    add(et, -2, 12)

    def refresh(update_hex=True, update_bars=False):
        c = current()
        preview_bg.setColor(c)
        if update_hex:
            st["busy"] = True
            et.setText("#%06X" % (c & 0xFFFFFF))
            st["busy"] = False
        if update_bars:
            hue_bar.setProgress(int(round(st["h"] * 360)))
            sat_bar.setProgress(int(round(st["s"] * 100)))
            val_bar.setProgress(int(round(st["v"] * 100)))

    def on_hex(text):
        if st["busy"]:
            return
        c = _parse_hex(text)
        if c is None:
            return
        st["h"], st["s"], st["v"] = _hsv_of(c)
        refresh(update_hex=False, update_bars=True)

    et.addTextChangedListener(_HexWatcher(on_hex))
    refresh()

    def on_ok(_which):
        c = _parse_hex(str(et.getText()))
        if c is None:
            c = current()
        _save_custom(plugin, "#%06X" % (c & 0xFFFFFF))

    sv = ScrollView(ctx)
    sv.addView(ll)

    b = AlertDialog.Builder(ctx)
    b.setTitle("Свой цвет")
    b.setView(sv)
    b.setPositiveButton("Готово", _button_listener(on_ok))
    b.setNegativeButton("Отмена", None)
    b.show()


def _show_color_dialog(plugin):
    """Запасной вариант, если в этой версии exteraGram нет Selector: список цветов в диалоге."""
    ctx = _context()
    if ctx is None:
        _report("Не удалось получить контекст для окна")
        return
    AlertDialog = jclass("org.telegram.ui.ActionBar.AlertDialog")

    def on_pick(which):
        plugin.set_setting("pill_color_idx", which)
        _cfg_cache[1] = None
        if which == CUSTOM_IDX:
            _ui(lambda: _open_picker(plugin, ctx), 150)
        else:
            _toast("Цвет: %s. Откройте профиль заново" % PRESETS[which][0])

    bld = AlertDialog.Builder(ctx)
    bld.setTitle("Цвет пилюли")
    bld.setItems(jarray(jclass("java.lang.CharSequence"))([n for n, _ in PRESETS]), _ClickListener(on_pick))
    bld.setNegativeButton("Отмена", None)
    bld.show()


# ---------------------------------------------------------------- плагин

class _BindHook(MethodHook):
    """После заполнения TextDetailCell / AboutLinkCell красим их подпись."""

    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            self.plugin.style_cell(param.thisObject)
        except Exception as e:
            _log("style error: %s" % e)


def _cell_style_intact(plugin, cell):
    """Дёшево проверяем: подпись ячейки всё ещё с нашим фоном и паддингом (или плагин выключен)."""
    try:
        if not _cfg(plugin)["enabled"]:
            return True
        tv = _value_view(cell)
        if tv is None:
            return True
        ent = _styled.get(int(tv.hashCode()))
        if ent is None or _J.density is None:
            return False
        bg = tv.getBackground()
        if bg is None or int(bg.hashCode()) != int(ent[2].hashCode()):
            return False
        return int(tv.getPaddingLeft()) == int(round(PAD_X_DP * _J.density))
    except Exception:
        return False


class _AboutCellRefreshHook(MethodHook):
    """Повторно накладывает стиль после сброса цветов/перерасчёта AboutLinkCell («О себе»)."""

    def __init__(self, plugin, method_name):
        super().__init__()
        self.plugin = plugin
        self.method_name = method_name

    def after_hooked_method(self, param):
        try:
            if self.method_name != "updateColors" and _cell_style_intact(self.plugin, param.thisObject):
                return  # onMeasure/onLayout вызываются очень часто — ничего не делаем, пока пилюля на месте
            # Debounce: стиль восстанавливается после окончания серии измерений.
            self.plugin.schedule_cell_refresh(param.thisObject, self.method_name)
        except Exception as e:
            _log("AboutLinkCell %s refresh scheduling failed: %s" % (self.method_name, e))


class _AdapterHook(MethodHook):
    """После onBindViewHolder адаптера профиля — подписи в остальных ячейках (адрес, место работы и т.д.)."""

    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            holder = param.args[0]
            try:
                cell = cast(jclass("androidx.recyclerview.widget.RecyclerView$ViewHolder"), holder).itemView
            except Exception:
                cell = holder.itemView
            _generic(self.plugin, cell)
        except Exception as e:
            _log("adapter hook error: %s" % e)


class PillLabelsPlugin(BasePlugin):
    def create_settings(self):
        items = [
            Header(text="Подписи в профиле"),
            Switch(
                key="enabled",
                text="Обводка вокруг подписей",
                default=True,
                subtext="«О себе», «Имя пользователя», «Адрес» и др. Меняется при следующем открытии профиля",
            ),
        ]
        names = [n for n, _ in PRESETS]
        added = False
        if Selector is not None:
            try:
                items.append(Selector(
                    key="pill_color_idx",
                    text="Цвет пилюли",
                    default=DEFAULT_IDX,
                    items=names,
                    on_change=self._on_color_change,
                ))
                added = True
            except Exception as e:
                _log("Selector failed: %s" % e)
        if not added and Text is not None:
            try:
                items.append(Text(
                    text="Цвет пилюли: %s" % names[_color_idx(self)],
                    on_click=self._on_pick_color,
                ))
            except Exception as e:
                _log("Text item failed: %s" % e)
        if Text is not None:
            try:
                items.append(Text(text="Скопировать лог", on_click=self._on_copy_log))
                items.append(Text(text="Очистить лог", on_click=self._on_clear_log))
            except Exception as e:
                _log("log items failed: %s" % e)
        return items

    def _on_copy_log(self, *args):
        head = "Pill Labels %s, строк %d\n" % (__version__, len(_RING))
        _ui(lambda: _copy_text(head + "\n".join(list(_RING))[-14000:]), 0)

    def _on_clear_log(self, *args):
        _RING.clear()
        _toast("Лог очищен")

    def _on_pick_color(self, *args):
        _show_color_dialog(self)

    def _on_color_change(self, *args):
        _cfg_cache[1] = None
        idx = args[0] if args else None
        try:
            if isinstance(idx, str):
                idx = [n for n, _ in PRESETS].index(idx)
            idx = int(idx)
        except Exception:
            idx = _color_idx(self)
        if idx == CUSTOM_IDX:
            ctx = _context()
            if ctx is not None:
                _ui(lambda: _open_picker(self, ctx), 250)

    def on_plugin_load(self):
        _init()
        _plugin_ref[0] = self
        _migrate_settings(self)
        bind_hook = _BindHook(self)
        for cls_name in ("org.telegram.ui.Cells.TextDetailCell", "org.telegram.ui.Cells.AboutLinkCell"):
            cls = _load_class(cls_name)
            if cls is None:
                _log("%s not found" % cls_name)
                continue
            count = 0
            for m in cls.getDeclaredMethods():
                try:
                    name = m.getName()
                    if name.startswith("setText") and "Value" in name:
                        self.hook_method(m, bind_hook)
                        count += 1
                except Exception as e:
                    _log("hook error: %s" % e)
            _log("%s: hooked %d methods" % (cls_name, count))

            if cls_name.endswith("AboutLinkCell"):
                refresh_count = 0
                for m in cls.getDeclaredMethods():
                    try:
                        if str(m.getName()) in ("updateColors", "onMeasure", "onLayout"):
                            self.hook_method(m, _AboutCellRefreshHook(self, str(m.getName())))
                            refresh_count += 1
                    except Exception as e:
                        _log("AboutLinkCell refresh hook error: %s" % e)
                _log("AboutLinkCell: hooked %d refresh methods" % refresh_count)

        adapter_hook = _AdapterHook(self)
        cls = _load_class("org.telegram.ui.ProfileActivity$ListAdapter")
        if cls is None:
            _log("ProfileActivity$ListAdapter not found — подписи кроме телефона/логина/«О себе» красить не буду")
        else:
            count = 0
            for m in cls.getDeclaredMethods():
                try:
                    if m.getName() == "onBindViewHolder" and len(m.getParameterTypes()) == 2:
                        self.hook_method(m, adapter_hook)
                        count += 1
                except Exception as e:
                    _log("adapter hook error: %s" % e)
            _log("ProfileActivity$ListAdapter: hooked %d methods" % count)

    def schedule_cell_refresh(self, cell, reason="layout"):
        try:
            key = int(cell.hashCode())
        except Exception:
            key = id(cell)
        seq = getattr(self, "_cell_refresh_seq", None)
        if seq is None:
            seq = {}
            self._cell_refresh_seq = seq
        token = seq.get(key, 0) + 1
        seq[key] = token

        def run():
            try:
                if seq.get(key) != token:
                    return  # пришёл более свежий запрос
                seq.pop(key, None)
                self.style_cell(cell)
            except Exception as e:
                _log("deferred AboutLinkCell style (%s) failed: %s" % (reason, e))

        _ui(run, 70)

    def on_plugin_unload(self):
        _plugin_ref[0] = None
        _styled.clear()
        _bg["gen"] += 1
        try:
            self._cell_refresh_seq.clear()
        except Exception:
            pass

    def style_cell(self, cell):
        _init()
        tv = _value_view(cell)
        if tv is None:
            return
        _style_label(self, tv)
