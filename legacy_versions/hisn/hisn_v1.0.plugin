__id__ = "hisn"
__name__ = "Hider Sender Name"
__description__ = "Автоматически скрывает имя отправителя при пересылке сообщений\nAutomatically hides the sender name when forwarding messages"
__author__ = "@ka1Plugins"
__version__ = "1.0"
__icon__ = "PakKot1kov/79"
__app_version__ = ">=12.10.6"
__sdk_version__ = ">=1.4.5.7"

import base64
from base_plugin import BasePlugin
from java.nio import ByteBuffer
from dalvik.system import InMemoryDexClassLoader
from org.telegram.messenger import ApplicationLoader

DEX_B64 = """"""


class HiderSenderNamePlugin(BasePlugin):
    def on_plugin_load(self):
        try:
            self.log("Loading HideSenderName DEX...")
            dex_bytes = base64.b64decode(DEX_B64)
            buffer = ByteBuffer.wrap(dex_bytes)
            parent_cl = ApplicationLoader.applicationContext.getClassLoader()
            self.dex_loader = InMemoryDexClassLoader(buffer, parent_cl)
            self.dex_class = self.dex_loader.loadClass("by.ka1Plugins.hisn.HideSenderName")

            for method in self.dex_class.getMethods():
                if method.getName() == "start":
                    method.invoke(None)
                    break
            self.log("HideSenderName loaded and started successfully.")
        except Exception as e:
            self.log(f"Failed to load HideSenderName DEX: {e}")

    def on_plugin_unload(self):
        try:
            if hasattr(self, "dex_class") and self.dex_class is not None:
                for method in self.dex_class.getMethods():
                    if method.getName() == "stop":
                        method.invoke(None)
                        break
            self.log("HideSenderName DEX unloaded.")
        except Exception as e:
            self.log(f"Failed to unload HideSenderName DEX: {e}")