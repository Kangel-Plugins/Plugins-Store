                        _nv_fl = [_t for _t in list(_B27C_FINDINGS.get(_nv_own) or []) if _nv_now - _t <= _B27C_CONFIRM_MS]
                        _nv_fn = len(_nv_fl)
                        _nv_prev_rd = rec.get("reason_detail_base") or rec.get("reason_detail") or "host_unattributed"
