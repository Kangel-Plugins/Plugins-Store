_B41_OWN_PERIOD_MS = 30000
_B41_OWN_KEEP = 80
_B41_THR_HIST = []
_B41_WREF_HIST = []
_B41_OWN_LAST = [0]
_B41_THR_MIN = 8
_B41_WREF_MIN = 256
