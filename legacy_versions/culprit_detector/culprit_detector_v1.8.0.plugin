_UEH_IFACE = None
try:
    _UEH_IFACE = jclass("java.lang.Thread$UncaughtExceptionHandler")
except Exception:
    _UEH_IFACE = None
_HANDLER_CLASS = None
if _UEH_IFACE is not None:
    try:
        from java import dynamic_proxy
        class _CrashHandler(dynamic_proxy(_UEH_IFACE)):
            def __init__(self, prev):
                super().__init__(); self._prev = prev
            def uncaughtException(self, thread, ex):
                swallow = False
                try: swallow = _capture_crash(thread, ex)
                except Exception: swallow = False
                if not swallow:
                    try:
                        if self._prev is not None:
                            self._prev.uncaughtException(thread, ex)
                    except Exception: pass
        _HANDLER_CLASS = _CrashHandler
    except Exception:
        _HANDLER_CLASS = None

_PREV_UEH = None
_OUR_UEH = None

_SUICIDE_TL = threading.local()
def _pm_thread_name():
    try:
        if _JThread is not None: return str(_JThread.currentThread().getName())
    except Exception: pass
    return ""
def _pm_java_stack(maxn=28):
    out = []
    try:
        if _JThread is None: return out
        st = _JThread.currentThread().getStackTrace()
        for e in list(st)[:maxn]:
            try:
                out.append("%s.%s(%s:%s)" % (e.getClassName(), e.getMethodName(), e.getFileName(), e.getLineNumber()))
            except Exception: pass
    except Exception: pass
    return out
def _pm_scan_stack(frames):
    try: known = _load_known()
    except Exception: known = []
    if not known: return None
    for fr in frames:
        low = fr.lower()
        for pid in known:
            if pid and pid.lower() in low: return pid
    for fr in frames:
        fsq = _squash(fr)
        for pid in known:
            ps = _squash(pid)
            if ps and len(ps) >= 4 and ps in fsq: return pid
    return None
def _pm_python_stack(maxn=48):
    out = []
    try:
        import traceback as _tb
        for fr in _tb.extract_stack()[-maxn:]:
            try:
                fn = getattr(fr, "filename", None); nm = getattr(fr, "name", None)
                if fn is None: fn = fr[0]; nm = fr[2]
                out.append("%s::%s" % (fn, nm))
            except Exception: pass
    except Exception: pass
    return out
def _pm_scan_py(pyframes):
    try: known = _known_union()
    except Exception:
        try: known = _load_known()
        except Exception: known = []
    if not known: return None
    for fr in pyframes:
        low = fr.lower()
        if "culprit" in low: continue
        for pid in known:
            if pid and pid != _SELF_ID and pid.lower() in low: return pid
    for fr in pyframes:
        if "culprit" in fr.lower(): continue
        fsq = _squash(fr)
        for pid in known:
            if pid == _SELF_ID: continue
            ps = _squash(pid)
            if ps and len(ps) >= 4 and ps in fsq: return pid
    return None
_PM_TEARDOWN = ("uncaughtException", "dispatchUncaughtException", "KillApplicationHandler")
def _pm_is_teardown(frames):
    try:
        for fr in frames:
            for mk in _PM_TEARDOWN:
                if mk in fr: return True
    except Exception: pass
    return False
_UI_CLICK_ATTRS = ("on_click", "on_long_click", "on_select", "on_toggle", "on_change", "on_value_change")
_XRL_REUSED = []
_XRL_RESET = []
_XRL_SCHEMA = 1
def _xrl_is_lock(o):
    return (hasattr(o, "acquire") and hasattr(o, "release")
            and hasattr(o, "__enter__") and hasattr(o, "__exit__"))
def _xrl_shared(name, factory, validator=None):
    try:
        import builtins as _bi
        store = getattr(_bi, "_culprit_xreload_state", None)
        if not isinstance(store, dict) or store.get("_schema") != _XRL_SCHEMA:
            store = {"_schema": _XRL_SCHEMA}
            setattr(_bi, "_culprit_xreload_state", store)
        obj = store.get(name)
        if obj is not None:
            ok = False
            try:
                ok = True if validator is None else bool(validator(obj))
            except Exception:
                ok = False
            if ok:
                _XRL_REUSED.append(name)
                return obj
            _XRL_RESET.append(name)
        obj = factory()
        store[name] = obj
        return obj
    except Exception:
        return factory()
_UI_CLICK_TL = _xrl_shared("ui_click_tl", threading.local, lambda o: isinstance(o, threading.local))
_UI_CLICK_LAST = _xrl_shared("ui_click_last", dict, lambda o: isinstance(o, dict))
_UI_CLICK_LOCK = _xrl_shared("ui_click_lock", threading.Lock, _xrl_is_lock)
_UI_CLICK_WINDOW_MS = 6000
def _ui_click_enter(pid):
    try:
        st = getattr(_UI_CLICK_TL, "stack", None)
        if st is None:
            st = []; _UI_CLICK_TL.stack = st
        st.append(pid)
