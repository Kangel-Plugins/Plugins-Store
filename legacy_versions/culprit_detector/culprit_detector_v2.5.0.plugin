        if best is None and best_py is not None:
            _nu_named = bool(cur_pid) and cur_pid != "unknown" and not (isinstance(cur_pid, str) and (cur_pid.startswith("<python>") or cur_pid.startswith("$Proxy")))
            _nu_struct = _nu_named and ((rec.get("cause") in ("orphaned_dynamic_proxy_runnable", "zombie_xposed_hook", "zombie_java_proxy_listener")) or str(rec.get("src") or "").startswith(("orphan-proxy", "orphan_proxy", "zombie")))
            if _nu_struct:
