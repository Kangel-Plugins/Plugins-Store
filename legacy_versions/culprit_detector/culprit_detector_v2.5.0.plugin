            elif cands:
                _log("  известные сторонние плагины (загрузка хуком не покрыта): %s" % ", ".join(cands))
    
    if best is not None and code == 6 and (not v.get("attribution")) and not benign_self:
        try:
            _hc = _b34_anr_host_correlate(ets, prev_boot_ts)  
            if isinstance(_hc, dict):
                _hcul = _hc.get("culprit") or "unknown"
                _hhost = bool(_hc.get("host_side"))
                _hkind = _hc.get("culprit_kind")
                _hsrc_leg = str(_hc.get("src") or "")  
                if _hkind not in ("host", "plugin"): _hkind = "plugin" if (("plugin-xphook" in _hsrc_leg) or ("java-plugin-frame" in _hsrc_leg)) else ("host" if _hhost else "plugin")  
                _hd = (int(ets) - int(_hc.get("ts"))) if _hc.get("ts") else None
                _oj_meaning = bool(isinstance(_hcul, str) and _hcul.strip() and _hcul not in ("unknown", "host/idle", "none", "none (intentional restart)"))  
                v["culprit"] = _hcul
                v["confidence"] = (_hc.get("confidence") or "medium") if _oj_meaning else "low"  
                v["attribution"] = _oj_meaning  
                v["culprit_kind"] = _hkind
                v["correlation_kind"] = "anr_host_stall" if _hc.get("_corr_file") != "anr_verdict" else "anr_plugin_verdict"
                v["anr_confirmed"] = True  
                v["anr_stall_ref"] = {"ts": _hc.get("ts"), "stalled_ms": _hc.get("stalled_ms"), "where": _hc.get("where"), "src": _hc.get("src"), "host_side": _hhost, "culprit_kind": _hkind, "delta_ms": _hd, "file": _hc.get("_corr_file")}
                v.pop("early_boot_death", None); v.pop("early_death_streak", None)
                v.pop("boot_window_plugins", None); v.pop("boot_window_suspect", None)
                try: _atomic_json_write(_b34_path(_B34_EARLY_NAME), {"count": 0})           
                except Exception: pass
                _log("  ANR-smert skorrelirovana s %s verdiktom (+OI/+OK/+SB): culprit='%s' conf=%s kind=%s delta=%sms src=%s -> attribution=%s" % (_hc.get("_corr_file") or "host_stall", v["culprit"], v["confidence"], v["culprit_kind"], _hd, _hc.get("src"), bool(v.get("attribution"))))
        except Exception as _eac:
            _log("  B34 +OI ANR/host-stall correlate err: %s" % _eac)
    
    if best is not None and code == 5 and (not v.get("attribution")) and not benign_self and not blameless:
        try:
            _nc = _b34_native_so_correlate(ets, status)
            if isinstance(_nc, dict) and _nc.get("culprit"):
                v["culprit"] = _nc["culprit"]
                v["confidence"] = _nc.get("confidence") or "low"
                v["attribution"] = bool(_nc.get("attribution"))
                v["culprit_kind"] = _nc.get("culprit_kind")
                v["correlation_kind"] = "native_tombstone_so"
                v["native_so_ref"] = {"so_path": _nc.get("so_path"), "wild_branch": _nc.get("wild_branch"), "tombstone_code": _nc.get("tombstone_code"), "match_score": _nc.get("match_score")}
                v.pop("early_boot_death", None); v.pop("early_death_streak", None)
                v.pop("boot_window_plugins", None); v.pop("boot_window_suspect", None)
                _log("  B34 +PF nativnyj krash otnesyon po tombstone .so: culprit=%r kind=%s wild=%s conf=%s attribution=%s (so=%s)" % (v["culprit"], v.get("culprit_kind"), _nc.get("wild_branch"), v["confidence"], bool(v.get("attribution")), _nc.get("so_path")))
        except Exception as _epf:
            _log("  B34 +PF native-so correlate err: %s" % _epf)
    
    if best is not None and code == 9 and (not v.get("attribution")) and not benign_self and not blameless:
