                v["confidence"] = _oc.get("confidence") or "low"
                v["attribution"] = bool(_oc.get("attribution"))
                v["culprit_kind"] = _oc.get("culprit_kind") or "plugin"
                v["correlation_kind"] = "oom_resource_pressure"
                v["oom_ref"] = {"src": _oc.get("src"), "reason_detail": _oc.get("reason_detail"),
                               "oom_confidence": _oc.get("oom_confidence"), "consensus": _oc.get("consensus"),
                               "instrumentation_agent": _oc.get("instrumentation_agent"),
                               "top_named_bytes": _oc.get("top_named_bytes"), "untagged_bytes": _oc.get("untagged_bytes"),
                               "dump_delta_ms": _oc.get("dump_delta_ms"), "top_bytes": _oc.get("top_bytes"),
