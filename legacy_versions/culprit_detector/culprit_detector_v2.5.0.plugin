                    _log("Block#16 +NS(1): pyerr-fallback отклонён -- delta=%dms без py-сигнатуры краша -> контекст, не атрибуция ('%s')" % (_pfd, str(best_py.get("culprit"))))
                except Exception: pass
        if best is None:
            return rec
        culprit = best.get("culprit")
        if not culprit or culprit == "unknown":
            return rec
        rec["crashed_plugin_id_native"] = cur_pid
        rec["crashed_plugin_id"] = culprit
        rec["confidence"] = "high"
