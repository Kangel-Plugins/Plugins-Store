            _ph_hog_pct = float(_ph_co.get("pct") or 0.0)
            _ph_src = str(src or "")
            _ph_weak = (("scope" in _ph_src) or ("op:" in _ph_src) or ("op-stamp" in _ph_src)) and ("selfkill" not in _ph_src)
            _ph_own = _hx_owned_hot(_crows, culprit)
            _ph_own_pct = float((_ph_own or {}).get("pct") or 0.0)
            if (_ph_hog_pct >= _HX_CPU_STARVE_PCT and _ph_weak
                    and (_ph_own is None or _ph_hog_pct >= _ph_own_pct * _HX_RENDER_RATIO)):
                _ph_owner = str(_ph_co.get("owner"))
                _ph_from = conf
                _anr_scope_suspect = culprit
                conf = "high" if _ph_hog_pct >= 95.0 else "medium"
                _hx_extra.pop("co_culprit", None)
                _hx_extra["cpu_starvation"] = {"owner": _ph_owner, "tid": _ph_co.get("tid"), "name": _ph_co.get("name"), "pct": round(_ph_hog_pct, 1)}
                _hx_extra["starved_scope"] = culprit
                _hx_extra["cv_conf_from"] = _ph_from
                _hx_extra["cv_note"] = "CPU starvation: %s burns %.1f%% CPU on thread %s while the UI thread starves; scope-owner %r only held the op-stamp" % (_ph_owner, _ph_hog_pct, _ph_co.get("name"), culprit)
                culprit = _ph_owner; py_mod = _ph_owner
                src = "anr/cpu-starvation+hog:%s" % (_ph_co.get("name") or "?")
                try: _log("Block#20 +PH: CPU-starvation ANR -> %r monopolizes %.1f%% CPU (tid=%s name=%s); op-stamp owner %r demoted to scope_suspect (conf %s->%s, src=%s)" % (_ph_owner, _ph_hog_pct, _ph_co.get("tid"), _ph_co.get("name"), _anr_scope_suspect, _ph_from, conf, src))
                except Exception: pass
    except Exception as _eph:
