_UI_CLICK_ATTRS = ("on_click", "on_long_click", "on_select", "on_toggle", "on_change", "on_value_change")
_XRL_REUSED = []
_XRL_RESET = []
_XRL_SCHEMA = 1
def _xrl_is_lock(o):
    return (hasattr(o, "acquire") and hasattr(o, "release")
            and hasattr(o, "__enter__") and hasattr(o, "__exit__"))
def _xrl_shared(name, factory, validator=None):
    try:
        import builtins as _bi
        store = getattr(_bi, "_culprit_xreload_state", None)
        if not isinstance(store, dict) or store.get("_schema") != _XRL_SCHEMA:
            store = {"_schema": _XRL_SCHEMA}
            setattr(_bi, "_culprit_xreload_state", store)
        obj = store.get(name)
        if obj is not None:
            ok = False
            try:
                ok = True if validator is None else bool(validator(obj))
            except Exception:
                ok = False
            if ok:
                _XRL_REUSED.append(name)
                return obj
            _XRL_RESET.append(name)
        obj = factory()
        store[name] = obj
        return obj
    except Exception:
        return factory()
_UI_CLICK_TL = _xrl_shared("ui_click_tl", threading.local, lambda o: isinstance(o, threading.local))
_UI_CLICK_LAST = _xrl_shared("ui_click_last", dict, lambda o: isinstance(o, dict))
_UI_CLICK_LOCK = _xrl_shared("ui_click_lock", threading.Lock, _xrl_is_lock)
_UI_CLICK_WINDOW_MS = 6000
def _ui_click_enter(pid):
    try:
        st = getattr(_UI_CLICK_TL, "stack", None)
        if st is None:
            st = []; _UI_CLICK_TL.stack = st
        st.append(pid)
    except Exception: pass
    try:
        if pid:
            now = int(time.time() * 1000)
            with _UI_CLICK_LOCK:
                _UI_CLICK_LAST[pid] = now
                if len(_UI_CLICK_LAST) > 8:
                    cutoff = now - 60000
                    for _k in list(_UI_CLICK_LAST):
                        try:
                            if int(_UI_CLICK_LAST.get(_k) or 0) < cutoff: _UI_CLICK_LAST.pop(_k, None)
                        except Exception:
                            _UI_CLICK_LAST.pop(_k, None)
    except Exception: pass
def _ui_click_leave():
    try:
        st = getattr(_UI_CLICK_TL, "stack", None)
        if st: st.pop()
    except Exception: pass
def _ui_click_active_owner():
    try:
        st = getattr(_UI_CLICK_TL, "stack", None)
        if st:
            return st[-1]
    except Exception: pass
    return None
def _ui_click_recent(pid, window_ms=None):
    if not pid: return None
    if window_ms is None: window_ms = _UI_CLICK_WINDOW_MS
    try:
        with _UI_CLICK_LOCK: ts = _UI_CLICK_LAST.get(pid)
        if ts is None: return None
        age = int(time.time() * 1000) - int(ts)
        return age if (0 <= age <= window_ms) else None
    except Exception:
        return None
_RELAUNCH_LAST = _xrl_shared("relaunch_last", dict, lambda o: isinstance(o, dict))
_RELAUNCH_GLOBAL_TS = _xrl_shared("relaunch_global_ts", lambda: [0], lambda o: isinstance(o, list) and len(o) >= 1)
_RELAUNCH_LOCK = _xrl_shared("relaunch_lock", threading.Lock, _xrl_is_lock)
_RELAUNCH_WINDOW_MS = 3000
def _own_pkg():
    try:
        p = jclass("android.app.ActivityThread").currentPackageName()
        if p: return str(p)
    except Exception: pass
    try:
        return str(jclass("org.telegram.messenger.ApplicationLoader").applicationContext.getPackageName())
    except Exception: return None
def _relaunch_recent(owner=None, window_ms=None):
    if window_ms is None: window_ms = _RELAUNCH_WINDOW_MS
    try:
        with _RELAUNCH_LOCK:
            ts = None
            if owner and owner != "unknown":
                ts = _RELAUNCH_LAST.get(owner)
            if not ts:
                ts = _RELAUNCH_GLOBAL_TS[0]
        if not ts: return None
        age = int(time.time() * 1000) - int(ts)
        return age if (0 <= age <= window_ms) else None
    except Exception: return None
def _relaunch_note_intent(intent, owner=None):
    try:
        if intent is None: return
        own = _own_pkg()
        if not own: return
        tgt = None
        try:
            pkg = intent.getPackage()
            if pkg: tgt = str(pkg)
        except Exception: pass
        if tgt is None:
            try:
                comp = intent.getComponent()
                if comp is not None: tgt = str(comp.getPackageName())
            except Exception: pass
        if tgt and tgt == own:
            now = int(time.time() * 1000)
            with _RELAUNCH_LOCK:
                if owner and owner != "unknown":
                    _RELAUNCH_LAST[owner] = now
                else:
                    _RELAUNCH_GLOBAL_TS[0] = now
                if len(_RELAUNCH_LAST) > 8:
                    cutoff = now - 60000
                    for _k in list(_RELAUNCH_LAST):
                        try:
                            if int(_RELAUNCH_LAST.get(_k) or 0) < cutoff: _RELAUNCH_LAST.pop(_k, None)
                        except Exception:
                            _RELAUNCH_LAST.pop(_k, None)
    except Exception: pass
class _HookRelaunchSchedule(MethodHook):
    def before_hooked_method(self, param):
        try:
            owner = None
            try: owner = _b14_caller_owner()
            except Exception: owner = None
            if owner is None:
                try: owner = _hook_scope_pid()
                except Exception: owner = None
            a = param.args
            if a is None: return
            for x in a:
                try:
                    if x is not None and "Intent" in x.getClass().getName():
                        _relaunch_note_intent(x, owner); break
                except Exception: continue
        except Exception: pass
_PM_RESTART_UI = ("View.performClick", "View$PerformClick", "OnClickListener", ".onClick(", "OnLongClickListener", ".onLongClick(", "onLongClick", "performLongClick")
_PM_RESTART_HINT = ("restartApp", ".restart(", "recreate(", "HooksInitFailed", "RestartUtil", "ProcessPhoenix", "_restart_app", "restart_app")
_PM_RESTART_EXIT_TAGS = ("System.exit", "Runtime.exit", "Runtime.halt")
_PM_RESTART_KILL_TAGS = ("Process.killProcess", "killProcess")
def _pm_is_intentional_restart(method_tag, frames, kill_arg, owner_pid=None, pyframes=None):
    try:
        _is_exit = method_tag in _PM_RESTART_EXIT_TAGS
        _is_selfkill = False
        try:
            _is_selfkill = (any(_k in str(method_tag or "") for _k in _PM_RESTART_KILL_TAGS)
                            and kill_arg is not None and int(kill_arg) == int(os.getpid()))
        except Exception:
            _is_selfkill = False
        if not _is_exit and not _is_selfkill: return False
        if _is_exit and kill_arg not in (0, None): return False
        _h51_lbl = ("exit(%s)" % kill_arg) if _is_exit else ("kill(pid=%s)" % kill_arg)
        if frames and _pm_is_teardown(frames): return False
        _allfr = list(frames or [])
        if pyframes:
            try: _allfr = _allfr + list(pyframes)
            except Exception: pass
        has_ui = False; has_hint = False
        for fr in _allfr:
            for mk in _PM_RESTART_UI:
                if mk in fr: has_ui = True; break
            for mk in _PM_RESTART_HINT:
                if mk in fr: has_hint = True; break
            if has_ui and has_hint: break
        if has_ui and has_hint:
            return True
        try:
            act = _ui_click_active_owner()
            if act is not None:
                if owner_pid in (None, "unknown", act):
                    _rl = _relaunch_recent(owner_pid if owner_pid not in (None, "unknown") else act)
                    if _rl is not None:
                        _log("PRE-MORTEM +H5.1: %s внутри UI-click scope owner=%r + запланирован само-перезапуск (%dms) -> benign restart" % (_h51_lbl, act, _rl))
                        return True
                    _log("PRE-MORTEM +H5.1: %s внутри UI-click scope owner=%r, НО само-перезапуск НЕ запланирован -> НЕ benign (вероятно plain-exit плагина)" % (_h51_lbl, act))
                else:
                    _log("PRE-MORTEM +H5.1: активный UI-click owner=%r не совпал с suicide owner=%r -> НЕ benign" % (act, owner_pid))
            if owner_pid and owner_pid != "unknown":
                age = _ui_click_recent(owner_pid)
                if age is not None:
                    _rl = _relaunch_recent(owner_pid)
                    if _rl is not None:
                        _log("PRE-MORTEM +H5.1: %s через %dms после UI-click owner=%r + запланирован само-перезапуск (%dms) -> benign restart" % (_h51_lbl, age, owner_pid, _rl))
                        return True
                    _log("PRE-MORTEM +H5.1: %s через %dms после UI-click owner=%r, НО само-перезапуск НЕ запланирован -> НЕ benign (вероятно plain-exit плагина)" % (_h51_lbl, age, owner_pid))
        except Exception: pass
        return False
    except Exception:
        return False
def _pm_is_programmatic_restart(pyframes, owner_pid):
    try:
        if not pyframes or not owner_pid or owner_pid == "unknown": return False
        _names = ("restart", "reload", "relaunch", "soft_restart", "do_restart", "_restart")
        for _fr in list(pyframes)[:8]:
            try:
                _s = _fr if isinstance(_fr, str) else str(_fr)
                if "::" not in _s: continue
                _path, _meth = _s.rsplit("::", 1)
                _meth = _meth.strip().lower()
                if _meth in _names and (("/%s.py" % owner_pid) in _path or _path.endswith("%s.py" % owner_pid)):
                    return True
            except Exception:
                continue
    except Exception:
        pass
    return False
def _record_suicide(method_tag, param):
    if getattr(_SUICIDE_TL, "busy", False): return
    _SUICIDE_TL.busy = True
    try:
        jstack = _pm_java_stack(28)
        if _pm_is_teardown(jstack):
            _log("pre-mortem: killProcess в crash-teardown — пропуск (вердикт у _capture_crash)")
            return
        try: _direct_premortem_dump()
        except Exception: pass
        argval = None
