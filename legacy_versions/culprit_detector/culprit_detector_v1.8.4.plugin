            _pm_own_pct = float((_pm_own or {}).get("pct") or 0.0)
            _pm_ui_tid = globals().get("_B33_UI_TID")
            _pm_ui_pct = None
            for _pm_r in (_crows or []):
                try:
                    if _pm_ui_tid is not None and _pm_r.get("tid") == _pm_ui_tid:
                        _pm_ui_pct = float(_pm_r.get("pct") or 0.0); break
                except Exception:
                    continue
            _pm_ui_starved = (_pm_ui_pct is None) or (_pm_hog_pct >= _pm_ui_pct * _HX_RENDER_RATIO)
            if (_pm_hog_pct >= _HX_CPU_STARVE_PCT and _pm_ui_starved
                    and (_pm_own is None or _pm_hog_pct >= _pm_own_pct * _HX_RENDER_RATIO)):
                _pm_owner = str(_pm_co.get("owner"))
                _pm_from = conf
                _anr_scope_suspect = culprit
                conf = "high" if _pm_hog_pct >= 95.0 else "medium"
                _hx_extra.pop("co_culprit", None)
                _hx_extra["cpu_starvation"] = {"owner": _pm_owner, "tid": _pm_co.get("tid"), "name": _pm_co.get("name"), "pct": round(_pm_hog_pct, 1), "victim_pyframe": True}
                _hx_extra["starved_scope"] = culprit
                _hx_extra["victim_pyframe"] = {"owner": culprit, "module": py_mod, "file": py_file, "line": py_line}
                if _pm_ui_pct is not None:
                    _hx_extra["ui_thread_pct"] = round(_pm_ui_pct, 1)
                _hx_extra["cv_conf_from"] = _pm_from
                _hx_extra["cv_note"] = "GIL/CPU starvation: instrumentation %s burns %.1f%% CPU on thread %s while the UI thread starves; py-frame owner %r is a victim (no hot thread of its own)" % (_pm_owner, _pm_hog_pct, _pm_co.get("name"), culprit)
                culprit = _pm_owner; py_mod = _pm_owner; py_file = ""; py_line = -1; stack = []
                src = "anr/gil-starvation+hog:%s" % (_pm_co.get("name") or "?")
                try: _log("Block#20 +PM: GIL/CPU-starvation ANR -> instrumentation %r monopolizes %.1f%% CPU (tid=%s name=%s, ui=%s%%); py-frame victim %r demoted to scope_suspect (conf %s->%s, src=%s)" % (_pm_owner, _pm_hog_pct, _pm_co.get("tid"), _pm_co.get("name"), _pm_ui_pct, _anr_scope_suspect, _pm_from, conf, src))
                except Exception: pass
    except Exception as _epm:
        try: _log("Block#20 +PM: gil-starvation promo err: %r" % _epm)
        except Exception: pass
    rec = {"had_anr": True, "event_type": "anr", "dropbox_tag": "data_app_anr", "tombstone_norm_version": 1, "culprit": culprit, "src": src, "confidence": conf, "scope_suspect": _anr_scope_suspect,
           "where": "ui-thread", "stalled_ms": int(waited_ms), "ui_tid": _B20_UI_TID, "ui_tid_linux": globals().get("_B33_UI_TID"),
           "py_module": py_mod, "py_file": py_file, "py_line": py_line,
           "stack": stack,
           "hot_frames": _b42_hot_frames(globals().get("_DN_MIDSTALL_SNAPSHOT")),
           "cpu_top": _crows, "cpu_win_ms": (_cmeta or {}).get("win_ms"), "cpu_age_ms": (_cmeta or {}).get("age_ms"),
           "reason": "UI thread unresponsive > %dms (ANR imminent)" % _B20_TIMEOUT_MS,
           "ts": int(time.time() * 1000)}
    if _sk is not None:
        rec["selfkill_corrob"] = _sk
    if _bi_nature:
        rec["nature"] = _bi_nature
        rec["reason"] = "UI thread unresponsive > %dms (ANR imminent); %s" % (_B20_TIMEOUT_MS, _bi_nature)
    if _hx_extra:
        try: rec.update(_hx_extra)
        except Exception: pass
    try:
        _gc_storm_pct = 25.0
        _mem_corrob_ms = 8000
        _heap_pct = 0.0
        for _hr in (_crows or []):
            try:
                _hn = str(_hr.get("name") or "")
                if ("HeapTaskDaemon" in _hn) or ("GCDaemon" in _hn) or ("HeapTask" in _hn):
                    _hp = float(_hr.get("pct") or 0.0)
                    if _hp > _heap_pct: _heap_pct = _hp
            except Exception:
                continue
        if _heap_pct >= _gc_storm_pct:
            _mpc = {"gc_daemon_cpu_pct": round(_heap_pct, 1)}
            _mp_cl = None
            try: _mp_cl = _recent_client_lowmem(_mem_corrob_ms)
            except Exception: _mp_cl = None
            _mp_oom = None
            try: _mp_oom = _recent_oom_dump(_mem_corrob_ms)
            except Exception: _mp_oom = None
            if _mp_cl: _mpc["client_lowmem"] = _mp_cl
            if _mp_oom:
                _mpc["oom_culprit"] = _mp_oom.get("culprit"); _mpc["oom_rate_mbps"] = _mp_oom.get("rate_mbps"); _mpc["oom_ts"] = _mp_oom.get("ts")
            rec["mem_pressure_corrob"] = _mpc
            if conf == "high": rec["confidence"] = "medium"
            if _mp_oom: _mp_extra = ", OOM-виновник %r rate=%s МБ/с" % (_mpc.get("oom_culprit"), _mpc.get("oom_rate_mbps"))
            elif _mp_cl: _mp_extra = ", client_lowmem trim=%s" % (_mp_cl.get("trim_level"),)
            else: _mp_extra = ""
            rec["reason"] = rec.get("reason", "") + " [+MP: GC-демон %.1f%% CPU в окне ANR%s -> часть UI-стойла = GC-wait/давление памяти; атрибуция плагина не меняется]" % (_heap_pct, _mp_extra)
            try: _log("Block#20 +MP: ANR при активном GC-демоне %.1f%% CPU%s -> mem_pressure_corrob, conf=%s (атрибуция %r сохранена)" % (_heap_pct, (" +OOM" if _mp_oom else (" +client_lowmem" if _mp_cl else "")), rec["confidence"], culprit))
            except Exception: pass
    except Exception as _emp:
        try: _log("Block#20 +MP corroborate err: %r" % _emp)
        except Exception: pass
    _ui_ctx_attach(rec)
    try:
        with _B20_LOCK:
            _persist_anr_fail(rec)
    except Exception as e:
        _log("Block#20: verdict write err: %r" % e)
    _log("ВИНОВНИК ANR: %r conf=%s stalled=%dms where=ui-thread tid=%s" % (culprit, conf, int(waited_ms), _B20_UI_TID))
    if py_file:
        _log("  modul: %s:%s" % (py_file, py_line))
    _log("  причина: %s" % rec["reason"])
    try:
        _hf = rec.get("hot_frames") or {}
        if _hf.get("in_python"):
            _log("  горячий кадр: %s%% времени в Python-коде%s%s (%s, %s сэмплов)" % (_hf.get("py_pct"), (" плагина %r" % _hf.get("py_owner")) if _hf.get("py_owner") else "", (", вызван из %s" % _hf.get("top_app_frame")) if _hf.get("top_app_frame") else "", _hf.get("source"), _hf.get("samples")))
        elif _hf.get("top_app_frame"):
            _log("  горячий кадр: %s%% времени на %s (%s, %s сэмплов)" % (_hf.get("top_app_pct"), _hf.get("top_app_frame"), _hf.get("source"), _hf.get("samples")))
    except Exception: pass
    _ucs = _ui_ctx_str(rec.get("ui_ctx"))
    if _ucs: _log("  контекст: %s" % _ucs)

def _b20_loop_native(stop, evfd=-1, seq0=-1):
    global _DN_MIDSTALL_SNAPSHOT
    last_seq = seq0
    if last_seq < 0:
        try: last_seq = int(_NLIB.cd_anr_stall_seq())
        except Exception: last_seq = 0
    if evfd < 0:
        try: evfd = int(_NLIB.cd_anr_eventfd())
        except Exception: evfd = -1
    last_ping = 0.0
    last_beat = 0.0
    _uic_last = 0.0
    _infl_since = None
    _mid = []
    ev = 0
    while not stop.is_set():
        try:
            try: ev |= int(_NLIB.cd_anr_events_take())
            except Exception: pass
            now = time.monotonic()
            try: inflight = int(_NLIB.cd_anr_inflight())
            except Exception: inflight = 1
            if (now - last_ping) * 1000.0 >= _B20_PING_MS and not inflight:
                _b20_post_ping(); last_ping = now
            if (now - last_beat) * 1000.0 >= _B20_BEAT_MS:
                _b20_post_beat(); last_beat = now
            if inflight:
                if _infl_since is None: _infl_since = last_ping if last_ping > 0.0 else now
                if ev & 2:
                    _held = (now - _infl_since) * 1000.0
                    try:
                        _jf, _pn, _cmp = _dn_capture_java_ui_stack()
                        if _jf:
                            _ks = _dn_capture_kernel_state(globals().get("_B33_UI_TID"))
                            _mid.append({"held_ms": _held, "jframes": _jf, "plugin_n": _pn, "component": _cmp, "kernel": _ks, "scope_owner": _dn_live_scope_owner()})
                            if len(_mid) > _DN_MIDSTALL_MAX: _mid = _mid[-_DN_MIDSTALL_MAX:]
                    except Exception: pass
            else:
                _infl_since = None
                if _mid and not (ev & 1): _mid = []
                if (now - _uic_last) * 1000.0 >= _UI_CTX_MS:
                    _uic_last = now
                    try: _ui_ctx_refresh()
                    except Exception: pass
            if ev & 1:
                try: seq = int(_NLIB.cd_anr_stall_seq())
                except Exception: seq = last_seq
                if seq != last_seq:
                    last_seq = seq
                    try: waited = int(_NLIB.cd_anr_stalled_ms())
                    except Exception: waited = _B20_TIMEOUT_MS
                    _DN_MIDSTALL_SNAPSHOT = list(_mid)
                    _gil_begin(_GIL_B20)
                    try:
                        _b20_report_stall(waited)
                    finally:
                        _gil_end(_GIL_B20)
            ev = 0
            _tn = time.monotonic()
            timo = max(0.05, _B20_BEAT_MS / 1000.0 - (_tn - last_beat))
            if not inflight:
                _wp = max(0.05, _B20_PING_MS / 1000.0 - (_tn - last_ping))
                if _wp < timo: timo = _wp
            try:
                if select.select([evfd], [], [], timo)[0]:
                    try: os.read(evfd, 8)
                    except Exception: pass
            except Exception:
                stop.wait(timo)
        except Exception as e:
            try: _log("Block#20 native loop err: %r" % e)
            except Exception: pass
            stop.wait(0.25)

def _b20_start():
    global _B20_THREAD, _B20_NATIVE, _B20_BEAT_INFLIGHT
    _B20_BEAT_INFLIGHT = False
    if not _B20_ON:
        _log("Block#20: disabled"); return
    if not _b20_setup_handler():
        _log("Block#20: setup failed -> ANR watchdog OFF"); return
    _B20_NATIVE = bool(_ANR_NATIVE_OK and _NLIB is not None)
    if not _B20_NATIVE:
        _log("Block#20: native ANR (cd_anr_start) missing -> watchdog OFF (rebuild .so)"); return
    _B20_STOP.clear()
    _a20fd = -1
    try:
        _a20fd = int(_NLIB.cd_anr_eventfd())
    except Exception:
        _a20fd = -1
    _a20seq0 = -1
    try:
        _a20seq0 = int(_NLIB.cd_anr_stall_seq())
    except Exception:
        _a20seq0 = -1
    try:
        _NLIB.cd_anr_mid_cfg(int(_DN_MIDSTALL_AFTER_MS), int(_DN_MIDSTALL_EVERY_MS))
    except Exception:
        pass
    try:
        rc = int(_NLIB.cd_anr_start(int(_B20_TIMEOUT_MS), int(_B20_MAX_PLAUSIBLE_MS), 250))
    except Exception as e:
        _log("Block#20: cd_anr_start err: %r -> watchdog OFF" % e); return
    if rc < 0:
        _log("Block#20: cd_anr_start rc=%d -> watchdog OFF" % rc); return
    if _B42_ON and _B42_HF_OK:
        try:
            _hrc = int(_NLIB.cd_hf_start(int(_B42_HF_EVERY_MS), int(_B42_HF_START_MS), int(_B42_HF_MAX_MS)))
            _log("Block#42 +TN: native hot-frame sampler rc=%d every=%dms" % (_hrc, _B42_HF_EVERY_MS))
        except Exception as _ehf:
            _log("Block#42 +TN: cd_hf_start err: %r" % _ehf)
    _B20_THREAD = threading.Thread(target=_b20_loop_native, args=(_B20_STOP, _a20fd, _a20seq0), name="culprit-anr", daemon=True)
    _B20_THREAD.start()
    _log("Block#20 ANR watchdog: start ping=%dms timeout=%dms detect=C/native (Tier 2b, event-wake) -> %s" % (
        _B20_PING_MS, _B20_TIMEOUT_MS, _ANR_FILE_NAME))

def _b20_stop():
    global _B20_THREAD, _B20_BEAT_INFLIGHT
    _B20_BEAT_INFLIGHT = False
    try:
        _B20_STOP.set()
        if _NLIB is not None:
            try: _NLIB.cd_anr_event_wake()
            except Exception: pass
        t = _B20_THREAD
        if t is not None: t.join(timeout=2.0)
        if _B42_HF_OK and _NLIB is not None:
            try: _NLIB.cd_hf_stop()
            except Exception: pass
        if _B20_NATIVE and _NLIB is not None:
            try: _NLIB.cd_anr_stop()
            except Exception: pass
        _B20_THREAD = None
        try:
            if _B20_HANDLER is not None: _B20_HANDLER.removeCallbacksAndMessages(None)
        except Exception: pass
        globals()["_B20_PING"] = None; globals()["_B20_BEAT"] = None; globals()["_B20_HANDLER"] = None
        globals()["_B20_BEAT_INFLIGHT"] = False
        _log("Block#20 ANR watchdog: stopped (callbacks cleared)")
    except Exception:
        pass

_WG_TICK_S = 3.0
_WG_CARDS_TTL_S = 15.0
_WG_LABEL_MAX = 30
_WG_NOACT_BACKOFF_S = 9.0
_WG_LOCK = threading.Lock()
_WG = None

_WG_RUNNABLE_CLS = None
_WG_RUNNABLE_LOCK = threading.Lock()

def _wg_runnable(fn):
    global _WG_RUNNABLE_CLS
    cls = _WG_RUNNABLE_CLS
    if cls is None:
        with _WG_RUNNABLE_LOCK:
            cls = _WG_RUNNABLE_CLS
            if cls is None:
                from java import dynamic_proxy
                _R = find_class("java.lang.Runnable")
                class _WgR(dynamic_proxy(_R)):
                    def __init__(self, _fn):
                        super().__init__()
                        self._fn = _fn
                    def run(self):
                        try:
                            self._fn()
                        except Exception as e:
                            try: _log("Block#36 ui err: %s" % e)
                            except Exception: pass
                cls = _WgR
                _WG_RUNNABLE_CLS = _WgR
    return cls(fn)

_WG_MAIN_HANDLER = None

def _wg_handler():
    global _WG_MAIN_HANDLER
    h = _WG_MAIN_HANDLER
    if h is None:
        with _WG_RUNNABLE_LOCK:
            h = _WG_MAIN_HANDLER
            if h is None:
                Looper = find_class("android.os.Looper")
                Handler = find_class("android.os.Handler")
                h = Handler(Looper.getMainLooper())
                _WG_MAIN_HANDLER = h
    return h

def _wg_run_ui(fn):
    try:
        _wg_handler().post(_wg_runnable(fn))
        return True
    except Exception as e:
        try: _log("Block#36 post err: %s" % e)
        except Exception: pass
        return False

class _CdWidget:
    def __init__(self, plugin):
        self.plugin = plugin
        self.root = None; self.tv = None; self.iv = None
        self._bg = None; self._listener = None
        self._stop = threading.Event()
        self._lock = threading.Lock()
        self._worker = None
        self._cards = []
        self._cards_ts = 0.0
        self._rot = 0
        self._menu = None
        self._drag_st = None
        self._backoff_until = 0.0
        self._dlg_lock = threading.Lock()
        self._dlg_inflight = False
        self._dialog = None

    def _dp(self, v):
        try:
            AndroidUtilities = find_class("org.telegram.messenger.AndroidUtilities")
            return int(AndroidUtilities.dp(float(v)))
        except Exception:
            return int(v * 3)

    def _activity(self):
        try:
            LaunchActivity = find_class("org.telegram.ui.LaunchActivity")
            fragment = LaunchActivity.getSafeLastFragment()
            if fragment is not None:
                return fragment.getParentActivity()
        except Exception:
            pass
        return None

    def start(self):
        with self._lock:
            if self._worker is not None and self._worker.is_alive():
                return
            ev = threading.Event()
            self._stop = ev
            self._worker = threading.Thread(target=self._loop, args=(ev,), name="culprit-widget", daemon=True)
            self._worker.start()

    def stop(self, join_s=2.0):
        self._stop.set()
        t = self._worker
        if t is not None and join_s > 0:
            try:
                t.join(timeout=join_s)
                if t.is_alive():
                    _log("Block#36: worker stop timeout")
            except Exception: pass
        self._worker = None
        _wg_run_ui(self.remove)

    def _loop(self, ev):
        while not ev.wait(_WG_TICK_S):
            try:
                if not bool(self.plugin.get_setting("widget_on", True)):
                    continue
                now = time.monotonic()
                if now < self._backoff_until:
                    continue
                if now - self._cards_ts >= _WG_CARDS_TTL_S:
                    try:
                        self._cards = list(self.plugin._ui_collect_culprits() or [])
                    except Exception as e:
                        _log("Block#36 collect err: %s" % e)
                    self._cards_ts = now
                if ev.is_set():
                    break
                self._rot += 1
                _wg_run_ui(self._ui_tick)
            except Exception as e:
                try: _log("Block#36 loop err: %s" % e)
                except Exception: pass

    def _ui_tick(self):
        if self._stop.is_set():
            return
        _d = self._dialog
        if _d is not None:
            try:
                if not _d.isShowing():
                    if self._dialog is _d:
                        self._dialog = None
            except Exception:
                if self._dialog is _d:
                    self._dialog = None
        if self._activity() is None:
            self._backoff_until = time.monotonic() + _WG_NOACT_BACKOFF_S
            return
        self._backoff_until = 0.0
        self.ensure()
        self.render()

    def ensure(self):
        try:
            act = self._activity()
            if act is None:
                return
            if self.root is not None:
                try:
                    same_ctx = bool(self.root.getContext().equals(act))
                except Exception:
                    same_ctx = False
                if not same_ctx:
                    self.remove(); self._build(act); return
                if self.root.isAttachedToWindow():
                    try:
                        if self._listener is not None:
                            self.root.setOnTouchListener(self._listener)
                        par = self.root.getParent()
                        if par is not None:
                            n = int(par.getChildCount())
                            if n > 0 and (not bool(par.getChildAt(n - 1).equals(self.root))):
                                self.root.bringToFront()
                    except Exception:
                        pass
                    return
                parent = self.root.getParent()
                if parent is not None:
                    parent.removeView(self.root)
                self._attach(act)
                return
            self._build(act)
        except Exception as e:
            _log("Block#36 ensure err: %s" % e)

    def _build(self, act):
        LinearLayout = find_class("android.widget.LinearLayout")
        TextView = find_class("android.widget.TextView")
        ImageView = find_class("android.widget.ImageView")
        GradientDrawable = find_class("android.graphics.drawable.GradientDrawable")
        LLP = find_class("android.widget.LinearLayout$LayoutParams")
        root = LinearLayout(act)
        root.setOrientation(0)
        root.setGravity(16)
        root.setPadding(self._dp(10), self._dp(5), self._dp(10), self._dp(5))
        bg = GradientDrawable()
        bg.setCornerRadius(float(self._dp(16)))
        root.setBackground(bg)
        self._bg = bg
        try: root.setElevation(float(self._dp(8)))
        except Exception: pass
        iv = ImageView(act)
        try:
            ctx = act.getApplicationContext()
            res = ctx.getResources()
            icon_res = res.getIdentifier("msg_report", "drawable", ctx.getPackageName())
            if icon_res: iv.setImageResource(icon_res)
        except Exception: pass
        ilp = LLP(self._dp(14), self._dp(14))
        ilp.rightMargin = self._dp(6)
        root.addView(iv, ilp)
        tv = TextView(act)
        tv.setTextSize(12.0)
        try:
            Typeface = find_class("android.graphics.Typeface")
            tv.setTypeface(Typeface.DEFAULT_BOLD)
        except Exception: pass
        tv.setSingleLine(False)
        # Preserve owner/time; constrain width, not the complete item's length.
        try:
            screen_w = int(act.getResources().getDisplayMetrics().widthPixels)
            tv.setMaxWidth(max(self._dp(120), min(self._dp(300), screen_w - self._dp(56))))
        except Exception: tv.setMaxWidth(self._dp(300))
        tv.setText("…")
        root.addView(tv)
        self.root, self.tv, self.iv = (root, tv, iv)
        self.sync_theme()
        if not bool(self.plugin.get_setting("widget_on", True)):
            root.setVisibility(8)
        self._listener = self._make_drag_listener()
        root.setOnTouchListener(self._listener)
        self._attach(act)
        self.render()

    def _attach(self, act):
        FLP = find_class("android.widget.FrameLayout$LayoutParams")
        decor = act.getWindow().getDecorView()
        lp = FLP(-2, -2)
        lp.gravity = 51
        try:
            x = int(str(self.plugin.get_setting("wg_x", str(self._dp(8)))))
            y = int(str(self.plugin.get_setting("wg_y", str(self._dp(96)))))
        except Exception:
            x, y = (self._dp(8), self._dp(96))
        lp.leftMargin = max(0, x)
        lp.topMargin = max(0, y)
        decor.addView(self.root, lp)
        try: self.root.bringToFront()
        except Exception: pass
        rv = self.root
        def _clamp_saved_pos():
            try:
                par = rv.getParent()
                if par is None: return
                w = int(par.getWidth()); h = int(par.getHeight())
                if w <= 0 or h <= 0: return
                p = rv.getLayoutParams()
                nx = max(0, min(w - int(rv.getWidth()), int(p.leftMargin)))
                ny = max(0, min(h - int(rv.getHeight()), int(p.topMargin)))
                if nx != int(p.leftMargin) or ny != int(p.topMargin):
                    p.leftMargin = nx; p.topMargin = ny
                    rv.setLayoutParams(p)
            except Exception:
                pass
        try: rv.post(_wg_runnable(_clamp_saved_pos))
        except Exception: pass

    def _dismiss_menu(self):
        try:
            if self._menu is not None:
                self._menu.dismiss()
        except Exception:
            pass
        self._menu = None

    def remove(self):
        self._dismiss_menu()
        try:
            if self._dialog is not None:
                self._dialog.dismiss()
        except Exception:
            pass
        self._dialog = None
        try:
            st = self._drag_st
            if st is not None and st.get("lp_run") is not None and self.root is not None:
                try: self.root.removeCallbacks(st["lp_run"])
                except Exception: pass
                st["lp_run"] = None
        except Exception:
            pass
        try:
            if self.root is not None:
                self.root.setOnTouchListener(None)
        except Exception:
            pass
        try:
            if self.root is not None:
                parent = self.root.getParent()
                if parent is not None:
                    parent.removeView(self.root)
        except Exception:
            pass
        self._listener = None
        self._drag_st = None
        self.root = None; self.tv = None; self.iv = None; self._bg = None

    def sync_theme(self):
        try:
            if self._bg is None: return
            Theme = find_class("org.telegram.ui.ActionBar.Theme")
            base = int(Theme.getColor(Theme.key_windowBackgroundWhite))
            c = (base & 16777215) | (230 << 24)
            c &= 4294967295
            if c >= 2147483648: c -= 4294967296
            from java import jint
            self._bg.setColor(jint(c))
        except Exception:
            pass

    def _items(self):
        current = [c for c in self._cards if c.get("event_scope") == "current"]
        history_n = len(self._cards) - len(current)
        if not current:
            clean = self.plugin._t("✅ В этом процессе событий нет")
            if history_n:
                clean += "\n" + self.plugin._t("История: %d · открыть список") % history_n
            return [clean]
        items = [self.plugin._t("Текущих: %d · история: %d") % (len(current), history_n)]
        # Historic alerts are available in show_all, not rotated as live alarms.
        for c in current[:10]:
            label = ("%s %s" % (c.get("emoji", ""), c.get("label", "-"))).strip()
            items.append("%s\n%s\n%s" % (
                label, self.plugin._t("Владелец: %s") % c.get("culprit", "?"),
                self.plugin._ui_when(c.get("ts"))))
        return items

    def render(self):
        try:
            if self.root is None or self.tv is None:
                return
            if not bool(self.plugin.get_setting("widget_on", True)):
                try: self.root.setVisibility(8)
                except Exception: pass
                return
            try:
                if int(self.root.getVisibility()) != 0:
                    self.root.setVisibility(0)
            except Exception:
                pass
            self.sync_theme()
            items = self._items()
            self.tv.setText(items[self._rot % len(items)])
            from java import jint
            try:
                if any(c.get("event_scope") == "current" for c in self._cards):
                    Color = find_class("android.graphics.Color")
                    col = int(Color.parseColor("#F44336"))
                else:
                    Theme = find_class("org.telegram.ui.ActionBar.Theme")
                    col = int(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText))
                self.tv.setTextColor(jint(col))
                if self.iv is not None:
                    self.iv.setColorFilter(jint(col))
            except Exception:
                pass
        except Exception as e:
            _log("Block#36 render err: %s" % e)

    def _make_drag_listener(self):
        from java import dynamic_proxy
        OnTouchListener = find_class("android.view.View$OnTouchListener")
        plugin = self.plugin
        wg = self
        st = {"x0": 0.0, "y0": 0.0, "mx": 0, "my": 0, "moved": False, "slop": 24, "lpt": 450, "lp_run": None, "menu_shown": False}
        self._drag_st = st
        class _WgDragListener(dynamic_proxy(OnTouchListener)):
            def onTouch(self, v, ev):
                try:
                    a = int(ev.getActionMasked())
                    if a == 0:
                        st["x0"] = float(ev.getRawX()); st["y0"] = float(ev.getRawY())
                        lp = v.getLayoutParams()
                        st["mx"] = int(lp.leftMargin); st["my"] = int(lp.topMargin)
                        st["moved"] = False; st["menu_shown"] = False
                        try:
                            VC = find_class("android.view.ViewConfiguration")
                            st["slop"] = int(VC.get(v.getContext()).getScaledTouchSlop())
                            st["lpt"] = int(VC.getLongPressTimeout())
                        except Exception:
                            pass
                        def _trigger_long_press():
                            if not st["moved"] and (not st["menu_shown"]):
                                st["menu_shown"] = True
                                try: v.performHapticFeedback(0)
                                except Exception: pass
                        st["lp_run"] = _wg_runnable(_trigger_long_press)
                        v.postDelayed(st["lp_run"], st["lpt"])
                        return True
                    if a == 2:
                        dx = float(ev.getRawX()) - st["x0"]
                        dy = float(ev.getRawY()) - st["y0"]
                        if not st["moved"] and (abs(dx) > st["slop"] or abs(dy) > st["slop"]):
                            st["moved"] = True
                            if st["lp_run"] is not None:
                                v.removeCallbacks(st["lp_run"])
                                st["lp_run"] = None
                        if st["moved"] and (not st["menu_shown"]):
                            lp = v.getLayoutParams()
                            nx = st["mx"] + int(dx)
                            ny = st["my"] + int(dy)
                            try:
                                par = v.getParent()
                                nx = max(0, min(int(par.getWidth()) - int(v.getWidth()), nx))
                                ny = max(0, min(int(par.getHeight()) - int(v.getHeight()), ny))
                            except Exception:
                                nx = max(0, nx); ny = max(0, ny)
                            lp.leftMargin = nx; lp.topMargin = ny
                            v.setLayoutParams(lp)
                        return True
                    if a in (1, 3):
                        if st["lp_run"] is not None:
                            try: v.removeCallbacks(st["lp_run"])
                            except Exception: pass
                            st["lp_run"] = None
                        if st["menu_shown"]:
                            if a == 1:
                                wg.show_menu(v)
                        elif st["moved"]:
                            try:
                                lp = v.getLayoutParams()
                                plugin.set_setting("wg_x", str(int(lp.leftMargin)))
                                plugin.set_setting("wg_y", str(int(lp.topMargin)))
                            except Exception:
                                pass
                        elif a == 1:
                            wg._rot += 1
                            wg.render()
                        return True
                except Exception as e:
                    try: _log("Block#36 touch err: %s" % e)
                    except Exception: pass
                return False
        return _WgDragListener()

    def show_menu(self, view):
        try:
            self._dismiss_menu()
            LaunchActivity = find_class("org.telegram.ui.LaunchActivity")
            fragment = LaunchActivity.getSafeLastFragment()
            if not fragment:
                return
            try:
                ItemOptions = find_class("org.telegram.ui.Components.ItemOptions")
            except Exception:
                ItemOptions = None
            if ItemOptions is None:
                self.show_all(); return
            from java import jint
            ApplicationLoader = find_class("org.telegram.messenger.ApplicationLoader")
            ctx = ApplicationLoader.applicationContext
            res = ctx.getResources(); pkg = ctx.getPackageName()
            def _icon(name):
                try: return res.getIdentifier(name, "drawable", pkg)
                except Exception: return 0
            options = ItemOptions.makeOptions(fragment, view)
            options.add(jint(_icon("msg_report")), self.plugin._t("Показать всех виновников"), _wg_runnable(self.show_all))
            options.add(jint(_icon("msg_settings")), self.plugin._t("Открыть настройки"), _wg_runnable(self.open_settings))
            self._menu = options
            options.setDrawScrim(False).setDimAlpha(jint(0)).show()
        except Exception as e:
            _log("Block#36 menu err: %s" % e)

    def show_all(self):
        wg = self
        with self._dlg_lock:
            if self._dlg_inflight:
                return
            self._dlg_inflight = True
        def work():
            try:
                if wg._stop.is_set():
                    with wg._dlg_lock:
                        wg._dlg_inflight = False
                    return
                cards = list(wg.plugin._ui_collect_culprits() or [])
                wg._cards = cards; wg._cards_ts = time.monotonic()
                lines = []
                _current_n = sum(c.get("event_scope") == "current" for c in cards)
                lines.append(wg.plugin._t("Текущие события: %d · исторические: %d") % (_current_n, len(cards) - _current_n))
                lines.append(wg.plugin._t("История не означает зависание сейчас."))
                lines.append("")
                if not cards:
                    lines.append(wg.plugin._t("✅ Чисто — виновники не найдены"))
                _group = None
                for i, c in enumerate(cards[:50], 1):
                    if c.get("event_scope") != _group:
                        _group = c.get("event_scope")
                        lines.append(wg.plugin._t("Текущий процесс" if _group == "current" else "История"))
                    lines.append("[%d] %s %s" % (i, c.get("emoji", ""), c.get("label", "-")))
                    lines.append(wg.plugin._t("  Виноват: %s") % c.get("culprit", "?"))
                    if c.get("reason"):
                        lines.append(wg.plugin._t("  Что случилось: %s") % c["reason"])
                    lines.append(wg.plugin._t("  Когда: %s") % wg.plugin._ui_when(c.get("ts", 0)))
                    lines.append(wg.plugin._t("  Уверенность: %s") % c.get("conf", "?"))
                    if c.get("where"):
                        lines.append(wg.plugin._t("  Где: %s") % c["where"])
                    lines.append("")
                text = "\n".join(lines)
            except Exception as e:
                text = "err: %s" % e
            def ui():
                try:
                    if wg._stop.is_set():
                        return
                    from java import jint
                    LaunchActivity = find_class("org.telegram.ui.LaunchActivity")
                    fragment = LaunchActivity.getSafeLastFragment()
                    if not fragment:
                        return
                    act = fragment.getParentActivity()
                    Builder = find_class("org.telegram.ui.ActionBar.AlertDialog$Builder")
                    b = Builder(act)
                    b.setTitle(wg.plugin._t("Показать всех виновников"))
                    try:
                        TextView = find_class("android.widget.TextView")
                        ScrollView = find_class("android.widget.ScrollView")
                        tv = TextView(act)
                        tv.setText(text)
                        tv.setTextSize(13.0)
                        try:
                            Theme = find_class("org.telegram.ui.ActionBar.Theme")
                            tv.setTextColor(jint(Theme.getColor(Theme.key_dialogTextBlack)))
                        except Exception: pass
                        pad = wg._dp(16)
                        tv.setPadding(pad, pad, pad, pad)
                        sv = ScrollView(act)
                        sv.addView(tv)
                        b.setView(sv)
                    except Exception:
                        b.setMessage(text)
                    try: b.setPositiveButton(wg.plugin._t("Закрыть"), None)
                    except Exception: pass
                    dlg = b.create()
                    _old_dlg = wg._dialog
                    wg._dialog = None
                    if _old_dlg is not None:
                        try: _old_dlg.dismiss()
                        except Exception: pass
                    wg._dialog = dlg
                    fragment.showDialog(dlg)
                except Exception as e:
                    _log("Block#36 dialog err: %s" % e)
                finally:
                    with wg._dlg_lock:
                        wg._dlg_inflight = False
            _posted = False
            try:
                if not wg._stop.is_set():
                    _posted = bool(_wg_run_ui(ui))
            finally:
                if not _posted:
                    with wg._dlg_lock:
                        wg._dlg_inflight = False
        try:
            threading.Thread(target=work, name="culprit-widget-dlg", daemon=True).start()
        except Exception:
            with wg._dlg_lock:
                wg._dlg_inflight = False

    def open_settings(self):
        try:
            from client_utils import get_last_fragment
            from com.exteragram.messenger.plugins import PluginsController
            PluginSettingsActivity = find_class("com.exteragram.messenger.plugins.ui.PluginSettingsActivity")
            controller = PluginsController.getInstance()
            plugins_map = getattr(controller, "plugins", None)
            java_plugin = plugins_map.get(__id__) if plugins_map else None
            if java_plugin:
                frag = get_last_fragment()
                if frag:
                    frag.presentFragment(PluginSettingsActivity(java_plugin))
        except Exception as e:
            _log("Block#36 settings err: %s" % e)

def _wg_start(plugin):
    global _WG
    try:
        if not bool(plugin.get_setting("widget_on", True)):
            return
    except Exception:
        pass
    with _WG_LOCK:
        if _WG is None:
            globals()["_WG"] = _CdWidget(plugin)
        w = _WG
    w.start()
    _wg_run_ui(w.ensure)
    _log("Block#36: overlay widget started")

def _wg_stop(join_s=2.0):
    global _WG
    with _WG_LOCK:
        w = _WG
        globals()["_WG"] = None
    if w is not None:
        try: w.stop(join_s=join_s)
        except Exception: pass
        _log("Block#36: overlay widget stopped")

