        if _NLIB is None or not hasattr(_NLIB, "cd_notif_diag"): return ""
        d = [int(_NLIB.cd_notif_diag(i)) for i in range(5)]
        return " [sh_ierr=%d sh_uerr=%d unhook_fail=%d leftover=%d adopted=%d]" % tuple(d)
