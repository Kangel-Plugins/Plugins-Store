            continue
        is_cm = isinstance(raw, classmethod)
        fn = raw.__func__ if (is_cm or isinstance(raw, staticmethod)) else raw
        if not callable(fn) or getattr(fn, _B14_FLAG, False):
            continue
        def _mk(fn, attrs, surface):
            def _w(bound, *a, **kw):
                owner = None
                try: owner = _b14_caller_owner()
                except Exception: owner = None
                if owner is not None:
                    try:
                        for arg in a:
                            _b14_wrap_obj_cbs(owner, arg, attrs, surface)
                        for v in kw.values():
                            _b14_wrap_obj_cbs(owner, v, attrs, surface)
                    except Exception: pass
                return fn(bound, *a, **kw)
            return _w
        wfn = _mk(fn, attrs, surface)
        try: _functools.update_wrapper(wfn, fn)
        except Exception: pass
        try: setattr(wfn, _B14_FLAG, True)
        except Exception: pass
        new_attr = classmethod(wfn) if is_cm else (staticmethod(wfn) if isinstance(raw, staticmethod) else wfn)
        try:
            setattr(cls, meth, new_attr)
            with _B14_WRAP_LOCK:
                _B14_WRAPPED_CLASSES.append((_wref_make(cls), meth, _wref_make(raw), _wref_make(new_attr)))
            n += 1
        except Exception as e:
            _log("Block#14 +TM registrar classmethod %s err: %s" % (surface, e))
    return n

def _b14_patch_registrars():
    a = 0; b = 0
    try: a = _b14_patch_baseplugin_registrars()
    except Exception as e: _log("Block#14 +TM baseplugin registrars err: %s" % e)
    try: b = _b14_patch_registrar_classmethods()
    except Exception as e: _log("Block#14 +TM classmethod registrars err: %s" % e)
    if a or b:
        _log("Block#14 +TM: регистраторы file/intent обёрнуты (BasePlugin=%d, SDK-classmethod=%d)" % (a, b))
    return a + b

