                        return True
                    _log("PRE-MORTEM +H5.1: %s через %dms после UI-click owner=%r, НО само-перезапуск НЕ запланирован -> НЕ benign (вероятно plain-exit плагина)" % (_h51_lbl, age, owner_pid))
