_REG_LOADERS = []; _REG_LOADERS_LOCK = threading.Lock(); _REG_LOADERS_MAX = 64
class _UnloadHook(MethodHook):
    def after_hooked_method(self, param):
        pid = None
        try:
            a = param.args
