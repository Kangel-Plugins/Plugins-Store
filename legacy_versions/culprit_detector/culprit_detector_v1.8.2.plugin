def _cb_verdict_log(rec, when):
    _verdict_log(rec, when, 'CALLBACK', 'КОЛБЭКА', 'scope-plugin(tid)', "=================================================", '', ('причина', 'modul', 'iskljuchenie'))

def _persist_cb_fail(rec):
