import traceback

from base_plugin import BasePlugin, MethodHook
from java import dynamic_proxy, jclass, jarray, jboolean
from hook_utils import find_class
from ui.settings import Header, Switch, Selector, Divider

try:
    from ui.settings import Text
except Exception:
    Text = None

try:
    from client_utils import get_last_fragment
except Exception:
    get_last_fragment = None

try:
    from android_utils import log
except Exception:
    def log(*a):
        pass

__id__ = "side_panel"
__name__ = "side panel"
__description__ = "панель с чатами на правой стороне (идея панели взята из plus messenger)"
__author__ = "@d1zzy412"
__icon__ = "ikonki_319a5_by_TgEmodziBot/1"
__version__ = "1.0.0"
__min_version__ = "11.9.0"

TOP_FALLBACK = 95
TOP_OFFSET = 64
BOTTOM_MARGIN = 150
HANDLE_SHIFT = 35
HANDLE_ALPHA = 0xF0
DEFAULT_COLOR = "1B1B1B"
TAG = "side_panel_container"

COUNTS = [20, 50, 100, 500]
OPACITY = [255, 217, 178]

COLOR_CHOICES = [
    ("1B1B1B", "стандартный"),
    ("2A1A4A", "тёмно-фиолетовый"),
    ("THEME", "как в теме"),
]

SIZES = [
    {"width": 50, "avatar": 34, "item_height": 66, "text_size": 10.0, "badge": 13, "handle_width": 20, "handle_height": 44},
    {"width": 56, "avatar": 38, "item_height": 71, "text_size": 10.5, "badge": 14, "handle_width": 22, "handle_height": 48},
    {"width": 60, "avatar": 40, "item_height": 75, "text_size": 11.0, "badge": 15, "handle_width": 24, "handle_height": 52},
]

KIND_KEYS = {"user": "show_users", "bot": "show_bots", "group": "show_groups", "channel": "show_channels"}
KIND_LABELS = {"user": "личный", "bot": "бот", "group": "группа", "channel": "канал"}

MATCH, WRAP = -1, -2
VISIBLE, GONE = 0, 8
OVAL = 1
OVERSCROLL_NEVER = 2
GRAV_CENTER = 17
GRAV_CENTER_H = 1
GRAV_CENTER_V = 16
GRAV_TOP_CENTER_H = 49
GRAV_TOP_LEFT = 51
GRAV_TOP_RIGHT = 53
GRAV_END = 8388613
GRAV_START_CENTER_V = 8388627

Long = jclass("java.lang.Long")
UserObject = jclass("org.telegram.messenger.UserObject")
DialogObject = jclass("org.telegram.messenger.DialogObject")
AndroidUtilities = jclass("org.telegram.messenger.AndroidUtilities")
Theme = jclass("org.telegram.ui.ActionBar.Theme")


def argb(c):
    c &= 0xFFFFFFFF
    return c - (1 << 32) if c >= (1 << 31) else c


def safe(fn, *args, default=None):
    try:
        return fn(*args)
    except Exception:
        log(traceback.format_exc())
        return default


def theme_color(name, fallback):
    try:
        return Theme.getColor(getattr(Theme, name)) & 0xFFFFFFFF
    except Exception:
        return fallback


class ClickListener(dynamic_proxy(jclass("android.view.View$OnClickListener"))):
    def __init__(self, fn):
        super().__init__()
        self.fn = fn

    def onClick(self, view):
        safe(self.fn)


class LongClickListener(dynamic_proxy(jclass("android.view.View$OnLongClickListener"))):
    def __init__(self, fn):
        super().__init__()
        self.fn = fn

    def onLongClick(self, view):
        safe(self.fn)
        return True


class TouchListener(dynamic_proxy(jclass("android.view.View$OnTouchListener"))):
    def __init__(self, fn):
        super().__init__()
        self.fn = fn

    def onTouch(self, view, event):
        return bool(safe(self.fn, view, event, default=False))


class RunnableProxy(dynamic_proxy(jclass("java.lang.Runnable"))):
    def __init__(self, fn):
        super().__init__()
        self.fn = fn

    def run(self):
        safe(self.fn)


class DialogClickListener(dynamic_proxy(jclass("android.content.DialogInterface$OnClickListener"))):
    def __init__(self, fn):
        super().__init__()
        self.fn = fn

    def onClick(self, dialog, which):
        safe(self.fn, which)


class CheckedListener(dynamic_proxy(jclass("android.widget.CompoundButton$OnCheckedChangeListener"))):
    def __init__(self, fn):
        super().__init__()
        self.fn = fn

    def onCheckedChanged(self, button, checked):
        safe(self.fn, bool(checked))


def chat_kind(did, obj):
    if did > 0:
        return "bot" if getattr(obj, "bot", False) else "user"
    return "channel" if getattr(obj, "broadcast", False) else "group"


def chat_info(mc, did):
    if did > 0:
        obj = mc.getUser(Long(did))
        return obj, UserObject.getUserName(obj) if obj else None
    obj = mc.getChat(Long(-did))
    return obj, obj.title if obj else None


def load_dialogs(mc):
    out = []
    dialogs = mc.getAllDialogs()
    for i in range(dialogs.size()):
        dlg = dialogs.get(i)
        did = dlg.id
        if did == 0 or DialogObject.isEncryptedDialog(did) or getattr(dlg, "folder_id", 0) != 0:
            continue
        obj, title = chat_info(mc, did)
        if obj is not None and title:
            out.append((dlg, did, obj, title))
    return out


def char_sequences(items):
    return jarray(jclass("java.lang.CharSequence"))(items)


def show_sheet(ctx, title, items, on_pick):
    listener = DialogClickListener(on_pick)
    try:
        sheet = jclass("org.telegram.ui.ActionBar.BottomSheet$Builder")(ctx)
        sheet.setTitle(title)
        sheet.setItems(char_sequences(items), listener)
        return sheet.show()
    except Exception:
        log(traceback.format_exc())
        builder = jclass("android.app.AlertDialog$Builder")(ctx)
        builder.setTitle(title)
        builder.setItems(char_sequences(items), listener)
        return builder.show()


def show_dialog(ctx, title, view=None, message=None, button="готово"):
    try:
        builder = jclass("org.telegram.ui.ActionBar.AlertDialog$Builder")(ctx)
        builder.setTitle(title)
        if message:
            builder.setMessage(message)
        if view is not None:
            builder.setView(view)
        builder.setPositiveButton(button, None)
        return builder.show()
    except Exception:
        log(traceback.format_exc())
        builder = jclass("android.app.AlertDialog$Builder")(ctx)
        builder.setTitle(title)
        if message:
            builder.setMessage(message)
        if view is not None:
            builder.setView(view)
        builder.setPositiveButton(button, DialogClickListener(lambda which: None))
        return builder.show()


def checklist_view(ctx, rows, on_toggle):
    dp = AndroidUtilities.dp
    LinearLayout = jclass("android.widget.LinearLayout")
    scroll = jclass("android.widget.ScrollView")(ctx)
    col = LinearLayout(ctx)
    col.setOrientation(LinearLayout.VERTICAL)
    col.setPadding(dp(12), 0, dp(12), 0)
    text_color = argb(theme_color("key_dialogTextBlack", 0xFF000000))
    tint = jclass("android.content.res.ColorStateList").valueOf(argb(theme_color("key_dialogTextBlue", 0xFF3390EC)))
    CheckBox = jclass("android.widget.CheckBox")
    for i, (label, checked) in enumerate(rows):
        box = CheckBox(ctx)
        box.setText(label)
        box.setTextSize(15.0)
        box.setTextColor(text_color)
        box.setPadding(dp(6), dp(8), dp(6), dp(8))
        box.setChecked(checked)
        safe(box.setButtonTintList, tint)
        box.setOnCheckedChangeListener(CheckedListener(lambda on, i=i: on_toggle(i, on)))
        col.addView(box)
    scroll.addView(col)
    return scroll


def palette_view(ctx, current, on_pick):
    dp = AndroidUtilities.dp
    LinearLayout = jclass("android.widget.LinearLayout")
    LP = jclass("android.widget.LinearLayout$LayoutParams")
    Gradient = jclass("android.graphics.drawable.GradientDrawable")
    View = jclass("android.view.View")
    TextView = jclass("android.widget.TextView")
    text_color = argb(theme_color("key_dialogTextBlack", 0xFF000000))

    root = LinearLayout(ctx)
    root.setOrientation(LinearLayout.VERTICAL)
    root.setPadding(dp(14), dp(4), dp(14), dp(4))
    for code, name in COLOR_CHOICES:
        if code == "THEME":
            fill = theme_color("key_windowBackgroundWhite", 0xFF1B1B1B)
        else:
            fill = 0xFF000000 | int(code, 16)
        selected = code == current
        bg = Gradient()
        bg.setShape(OVAL)
        bg.setColor(argb(fill))
        bg.setStroke(dp(3) if selected else dp(1), text_color if selected else argb(0x55888888))
        swatch = View(ctx)
        swatch.setBackground(bg)

        label = TextView(ctx)
        label.setText(name)
        label.setTextSize(16.0)
        label.setTextColor(text_color)
        label.setPadding(dp(14), 0, 0, 0)

        row = LinearLayout(ctx)
        row.setOrientation(LinearLayout.HORIZONTAL)
        row.setGravity(GRAV_CENTER_V)
        row.setPadding(dp(4), dp(8), dp(4), dp(8))
        row.addView(swatch, LP(dp(32), dp(32)))
        row.addView(label, LP(WRAP, WRAP))
        row.setOnClickListener(ClickListener(lambda code=code: on_pick(code)))
        root.addView(row)
    return root


class CreateViewHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        safe(self.plugin.sp_attach, param.thisObject, param.getResult())


class SidePanel(BasePlugin):
    sp_restyle = None

    def on_plugin_load(self):
        chat = find_class("org.telegram.ui.ChatActivity")
        method = chat.getClass().getDeclaredMethod("createView", jclass("android.content.Context"))
        self.hook_method(method, CreateViewHook(self))

    def create_settings(self):
        return [
            Header(text="что показывать"),
            Switch(key="show_users", text="личные чаты", default=True),
            Switch(key="show_bots", text="боты", default=True),
            Switch(key="show_groups", text="группы", default=True),
            Switch(key="show_channels", text="каналы", default=True),
            Switch(key="show_saved", text="избранное", default=True),
            Switch(key="unread_only", text="только с непрочитанными", default=False),
            *self.sp_action_items(),
            Header(text="вид"),
            Selector(key="count", text="количество чатов", default=1, items=[str(n) for n in COUNTS]),
            Selector(
                key="size",
                text="размер боковой панели",
                default=0,
                items=["маленькая", "средняя", "большой"],
            ),
            Selector(key="opacity", text="прозрачность панели", default=0, items=["100%", "85%", "70%"]),
            Switch(key="close_on_tap", text="закрывать по тапу вне панели", default=True),
            Divider(text="изменения применяются при следующем открытии чата"),
        ]

    def sp_action_items(self):
        if Text is None:
            return []
        return safe(
            lambda: [
                Text(text="исключения (всегда показывать)", on_click=lambda view: self.sp_open_exceptions(None)),
                Text(text="цвет панели", on_click=lambda view: self.sp_open_palette(None)),
            ],
            default=[],
        )

    def sp_context(self, ctx):
        if ctx is None and get_last_fragment is not None:
            ctx = get_last_fragment().getParentActivity()
        return ctx

    def sp_get_ids(self, key):
        try:
            raw = str(self.get_setting(key, "") or "")
            return [int(x) for x in raw.split(",") if x.strip()]
        except Exception:
            return []

    def sp_save_ids(self, key, ids):
        safe(self.set_setting, key, ",".join(str(x) for x in ids))

    def sp_kind_flags(self):
        return {kind: bool(self.get_setting(key, True)) for kind, key in KIND_KEYS.items()}

    def sp_color_choice(self):
        choice = str(self.get_setting("panel_color", DEFAULT_COLOR) or DEFAULT_COLOR).upper()
        return choice if choice in dict(COLOR_CHOICES) else DEFAULT_COLOR

    def sp_open_palette(self, ctx):
        try:
            ctx = self.sp_context(ctx)
            if ctx is None:
                return
            holder = []

            def picked(choice):
                self.set_setting("panel_color", choice.upper())
                if self.sp_restyle is not None:
                    safe(self.sp_restyle)
                safe(lambda: holder[0].dismiss())

            view = palette_view(ctx, self.sp_color_choice(), picked)
            holder.append(show_dialog(ctx, "цвет панели", view=view, button="закрыть"))
        except Exception:
            log(traceback.format_exc())

    def sp_open_exceptions(self, ctx):
        try:
            ctx = self.sp_context(ctx)
            if ctx is None:
                return
            UC = jclass("org.telegram.messenger.UserConfig")
            mc = jclass("org.telegram.messenger.MessagesController").getInstance(UC.selectedAccount)
            me = UC.getInstance(UC.selectedAccount).getClientUserId()
            flags = self.sp_kind_flags()
            exc = self.sp_get_ids("exceptions")

            rows = []
            for dlg, did, obj, title in load_dialogs(mc):
                kind = chat_kind(did, obj)
                if did != me and (not flags[kind] or did in exc):
                    rows.append((did, "%s (%s)" % (title, KIND_LABELS[kind]), did in exc))

            if not rows:
                show_dialog(
                    ctx, "всегда показывать",
                    message="все типы чатов включены. отключите нужный тип, и его чаты появятся здесь.",
                    button="ок",
                )
                return

            def toggled(which, checked):
                did = rows[which][0]
                cur = self.sp_get_ids("exceptions")
                if checked and did not in cur:
                    cur.append(did)
                elif not checked and did in cur:
                    cur.remove(did)
                self.sp_save_ids("exceptions", cur)

            view = checklist_view(ctx, [(r[1], r[2]) for r in rows], toggled)
            show_dialog(ctx, "всегда показывать", view=view)
        except Exception:
            log(traceback.format_exc())

    def sp_attach(self, fragment, root):
        if root is None or root.findViewWithTag(TAG) is not None:
            return
        added = []
        try:
            self.sp_build(fragment, root, added)
        except Exception:
            log(traceback.format_exc())
            for v in added:
                safe(root.removeView, v)

    def sp_build(self, fragment, root, added):
        def pick(key, default, table):
            try:
                return table[int(self.get_setting(key, default))]
            except Exception:
                return table[default]

        show_saved = bool(self.get_setting("show_saved", True))
        unread_only = bool(self.get_setting("unread_only", False))
        close_on_tap = bool(self.get_setting("close_on_tap", True))
        flags = self.sp_kind_flags()
        limit = pick("count", 1, COUNTS)
        S = pick("size", 0, SIZES)

        UC = jclass("org.telegram.messenger.UserConfig")
        CM = jclass("org.telegram.tgnet.ConnectionsManager")
        LinearLayout = jclass("android.widget.LinearLayout")
        FrameLayout = jclass("android.widget.FrameLayout")
        ScrollView = jclass("android.widget.ScrollView")
        TextView = jclass("android.widget.TextView")
        View = jclass("android.view.View")
        LP = jclass("android.widget.LinearLayout$LayoutParams")
        FLP = jclass("android.widget.FrameLayout$LayoutParams")
        Gradient = jclass("android.graphics.drawable.GradientDrawable")
        Typeface = jclass("android.graphics.Typeface")
        BackupImageView = jclass("org.telegram.ui.Components.BackupImageView")
        AvatarDrawable = jclass("org.telegram.ui.Components.AvatarDrawable")
        TextUtils = jclass("android.text.TextUtils")
        Bundle = jclass("android.os.Bundle")
        ChatActivity = jclass("org.telegram.ui.ChatActivity")

        dp = AndroidUtilities.dp
        ctx = root.getContext()
        acc = UC.selectedAccount
        mc = jclass("org.telegram.messenger.MessagesController").getInstance(acc)
        me = UC.getInstance(acc).getClientUserId()
        slop = jclass("android.view.ViewConfiguration").get(ctx).getScaledTouchSlop()
        pin_set = set()
        pin_order = []
        style = {}

        def read_style():
            choice = self.sp_color_choice()
            if choice == "THEME":
                rgb = theme_color("key_windowBackgroundWhite", 0xFF1B1B1B) & 0xFFFFFF
                text = theme_color("key_windowBackgroundWhiteBlackText", 0xFFFFFFFF)
            else:
                rgb = int(choice, 16)
                luma = 0.299 * (rgb >> 16 & 255) + 0.587 * (rgb >> 8 & 255) + 0.114 * (rgb & 255)
                text = 0xFF000000 if luma > 160 else 0xFFFFFFFF
            style["rgb"] = rgb
            style["text"] = text
            style["alpha"] = pick("opacity", 0, OPACITY)

        read_style()

        def is_muted(did):
            try:
                return bool(mc.isDialogMuted(did, 0))
            except Exception:
                return bool(safe(mc.isDialogMuted, did, default=False))

        def top_px():
            try:
                ab = fragment.getActionBar()
                h = int(ab.getY()) + int(ab.getHeight())
                if h > 0:
                    return h + dp(6) + dp(TOP_OFFSET)
            except Exception:
                pass
            return dp(TOP_FALLBACK)

        def make_badge(count, muted, size):
            badge = TextView(ctx)
            badge.setText("99+" if count > 99 else str(count))
            badge.setTextSize(float(size) * 0.68)
            badge.setTypeface(Typeface.DEFAULT_BOLD)
            badge.setTextColor(argb(theme_color("key_chats_unreadCounterText", 0xFFFFFFFF)))
            badge.setGravity(GRAV_CENTER)
            badge.setPadding(dp(4), 0, dp(4), 0)
            badge.setMinWidth(dp(size))
            badge.setIncludeFontPadding(False)
            bg = Gradient()
            bg.setCornerRadius(float(dp(size)) / 2.0)
            if muted:
                bg.setColor(argb(theme_color("key_chats_unreadCounterMuted", 0xFF5A5A5A)))
            else:
                bg.setColor(argb(theme_color("key_chats_unreadCounter", 0xFFB06CEC)))
            badge.setBackground(bg)
            return badge

        def make_pin_dot():
            dot = View(ctx)
            bg = Gradient()
            bg.setShape(OVAL)
            bg.setColor(argb(theme_color("key_chats_unreadCounter", 0xFFB06CEC)))
            dot.setBackground(bg)
            return dot

        def make_avatar(did, obj, size_dp):
            avatar = BackupImageView(ctx)
            avatar.setRoundRadius(dp(size_dp // 2))
            ad = AvatarDrawable()
            if did == me:
                try:
                    ad.setAvatarType(AvatarDrawable.AVATAR_TYPE_SAVED)
                    avatar.setImageDrawable(ad)
                    return avatar
                except Exception:
                    pass
            ad.setInfo(acc, obj)
            avatar.setForUserOrChat(obj, ad)
            return avatar

        def make_args(did):
            args = Bundle()
            if did > 0:
                args.putLong("user_id", did)
            else:
                args.putLong("chat_id", -did)
            return args

        def open_chat(did):
            fragment.presentFragment(ChatActivity(make_args(did)))

        def toggle_pin(did):
            ids = self.sp_get_ids("pinned")
            if did in ids:
                ids.remove(did)
            else:
                ids.append(did)
            self.sp_save_ids("pinned", ids)
            refill()

        def move_pin(did, delta):
            ids = self.sp_get_ids("pinned")
            if did not in ids:
                return
            i = ids.index(did)
            j = i + delta
            if 0 <= j < len(ids):
                ids[i], ids[j] = ids[j], ids[i]
                self.sp_save_ids("pinned", ids)
                refill()

        def menu_entries(did, in_peek=False):
            entries = [("открыть", lambda: open_chat(did))] if in_peek else [("предпросмотр", lambda: preview(did))]
            if did != me:
                entries.append(("открепить" if did in pin_set else "закрепить", lambda: toggle_pin(did)))
            if did in pin_set:
                idx = pin_order.index(did)
                if idx > 0:
                    entries.append(("переместить выше", lambda: move_pin(did, -1)))
                if idx < len(pin_order) - 1:
                    entries.append(("переместить ниже", lambda: move_pin(did, 1)))
            entries.append(("исключения", lambda: self.sp_open_exceptions(ctx)))
            entries.append(("цвет панели", lambda: self.sp_open_palette(ctx)))
            return entries

        def show_menu(did, title):
            entries = menu_entries(did)
            show_sheet(ctx, title, [e[0] for e in entries], lambda which: entries[which][1]())

        def after_peek(action):
            fragment.finishPreviewFragment()
            root.post(RunnableProxy(action))

        def peek_menu(did):
            Layout = jclass("org.telegram.ui.ActionBar.ActionBarPopupWindow$ActionBarPopupWindowLayout")
            SubItem = jclass("org.telegram.ui.ActionBar.ActionBarMenuSubItem")
            menu = Layout(ctx)
            entries = menu_entries(did, in_peek=True)
            for i, (label, action) in enumerate(entries):
                row = SubItem(ctx, i == 0, i == len(entries) - 1)
                row.setTextAndIcon(label, 0)
                row.setMinimumWidth(dp(180))
                row.setOnClickListener(ClickListener(lambda action=action: after_peek(action)))
                menu.addView(row)
            return menu

        def preview(did):
            def go():
                chat = ChatActivity(make_args(did))
                shown = safe(lambda: bool(fragment.presentFragmentAsPreviewWithMenu(chat, peek_menu(did))), default=False)
                if shown:
                    root.postDelayed(RunnableProxy(lambda: fragment.getParentLayout().movePreviewFragment(float(dp(120)))), 150)
                    return
                if not safe(fragment.presentFragmentAsPreview, ChatActivity(make_args(did)), default=False):
                    open_chat(did)
            root.post(RunnableProxy(go))

        def collect():
            entries = load_dialogs(mc)
            saved = next((e for e in entries if e[1] == me), None)
            others = [e for e in entries if e[1] != me]
            by_id = {e[1]: e for e in others}
            exceptions = set(self.sp_get_ids("exceptions"))
            pinned = [x for x in self.sp_get_ids("pinned") if x != me]
            pin_set.clear()
            pin_set.update(pinned)
            pin_order[:] = pinned

            out = []
            if show_saved:
                if saved is None:
                    obj, title = chat_info(mc, me)
                    if obj is not None:
                        saved = (None, me, obj, title)
                if saved is not None:
                    out.append(saved)
            for pid in pinned:
                entry = by_id.get(pid)
                if entry is None:
                    obj, title = chat_info(mc, pid)
                    if obj is not None and title:
                        entry = (None, pid, obj, title)
                if entry is not None:
                    out.append(entry)
            for entry in others:
                dlg, did, obj, _ = entry
                if did in pin_set:
                    continue
                if unread_only and int(dlg.unread_count) <= 0:
                    continue
                if did in exceptions or flags[chat_kind(did, obj)]:
                    out.append(entry)
            return out[:limit]

        W = dp(S["width"])
        AV = S["avatar"]
        HW, HH = dp(S["handle_width"]), dp(S["handle_height"])

        cont = FrameLayout(ctx)
        cont.setTag(TAG)
        cont.setClipChildren(False)

        wrap = FrameLayout(ctx)
        rr = float(dp(14))
        wbg = Gradient()
        wbg.setCornerRadii([rr, rr, 0.0, 0.0, 0.0, 0.0, rr, rr])
        wrap.setBackground(wbg)
        wrap.setClipChildren(True)
        wrap.setClipToOutline(True)

        scroll = ScrollView(ctx)
        scroll.setClipToPadding(True)
        scroll.setVerticalScrollBarEnabled(False)
        scroll.setOverScrollMode(OVERSCROLL_NEVER)
        wrap.addView(scroll, FLP(MATCH, MATCH))

        col = LinearLayout(ctx)
        col.setOrientation(LinearLayout.VERTICAL)
        col.setPadding(0, dp(6), 0, dp(6))
        scroll.addView(col, FLP(MATCH, WRAP))
        cont.addView(wrap, FLP(W, MATCH, GRAV_END))

        def make_item(dlg, did, obj, title):
            item = LinearLayout(ctx)
            item.setOrientation(LinearLayout.VERTICAL)
            item.setGravity(GRAV_CENTER_H)

            box = FrameLayout(ctx)
            box.setClipChildren(False)
            box.addView(make_avatar(did, obj, AV), FLP(dp(AV), dp(AV)))

            unread = int(dlg.unread_count) if dlg is not None else 0
            if unread > 0:
                blp = FLP(WRAP, dp(S["badge"]), GRAV_TOP_LEFT)
                blp.leftMargin = dp(-2)
                blp.topMargin = dp(-1)
                box.addView(make_badge(unread, is_muted(did), S["badge"]), blp)
            if did in pin_set:
                plp = FLP(dp(7), dp(7), GRAV_TOP_RIGHT)
                plp.rightMargin = dp(-1)
                plp.topMargin = dp(-1)
                box.addView(make_pin_dot(), plp)
            item.addView(box, LP(dp(AV), dp(AV)))

            label = TextView(ctx)
            label.setText(title)
            label.setTextSize(S["text_size"])
            label.setTextColor(argb(style["text"]))
            label.setLines(2)
            label.setEllipsize(TextUtils.TruncateAt.END)
            label.setGravity(GRAV_TOP_CENTER_H)
            llp = LP(W - dp(4), dp(int(S["text_size"] * 2.4) + 2))
            llp.topMargin = dp(2)
            item.addView(label, llp)

            item.setOnClickListener(ClickListener(lambda: open_chat(did)))
            item.setOnLongClickListener(LongClickListener(lambda: show_menu(did, title)))
            return item

        def refill():
            col.removeAllViews()
            for dlg, did, obj, title in collect():
                item = safe(make_item, dlg, did, obj, title)
                if item is not None:
                    col.addView(item, LP(MATCH, dp(S["item_height"])))

        refill()

        handle = TextView(ctx)
        handle.setGravity(GRAV_CENTER)
        handle.setTypeface(Typeface.DEFAULT_BOLD)
        handle.setTextSize(float(S["handle_height"]) * 0.55)
        handle.setIncludeFontPadding(False)
        hbg = Gradient()
        r = float(HH) / 2.0
        hbg.setCornerRadii([r, r, 0.0, 0.0, 0.0, 0.0, r, r])
        handle.setBackground(hbg)

        def apply_colors():
            alpha = style["alpha"]
            wbg.setColor(argb((alpha << 24) | style["rgb"]))
            hbg.setColor(argb((min(alpha, HANDLE_ALPHA) << 24) | style["rgb"]))
            handle.setTextColor(argb(style["text"]))

        apply_colors()

        def restyle():
            read_style()
            apply_colors()
            refill()

        self.sp_restyle = restyle

        hlp = FLP(HW, HH, GRAV_START_CENTER_V)
        hlp.topMargin = dp(HANDLE_SHIFT * 2)
        cont.addView(handle, hlp)

        scrim = View(ctx)
        scrim.setVisibility(GONE)
        root.addView(scrim, FLP(MATCH, MATCH))
        added.append(scrim)

        clp = FLP(W + HW, MATCH, GRAV_END)
        clp.topMargin = top_px()
        clp.bottomMargin = dp(BOTTOM_MARGIN)
        root.addView(cont, clp)
        added.append(cont)

        def fit():
            h = root.getHeight()
            if h <= 0:
                return
            lp = cont.getLayoutParams()
            t = top_px()
            nh = h - t - dp(BOTTOM_MARGIN)
            if nh > 0 and (lp.height != nh or lp.topMargin != t):
                lp.height = nh
                lp.topMargin = t
                cont.setLayoutParams(lp)

        root.post(RunnableProxy(fit))

        try:
            interpolator = jclass("org.telegram.ui.Components.CubicBezierInterpolator").DEFAULT
        except Exception:
            interpolator = None
        arrow = {"open": None}

        def set_arrow(is_open):
            if arrow["open"] is is_open:
                return
            arrow["open"] = is_open
            handle.setText("\u203a" if is_open else "\u2039")

        def set_tx(x):
            x = max(0.0, min(float(W), x))
            cont.setTranslationX(x)
            set_arrow(x < W / 2.0)

        def animate_to(x):
            cont.animate().cancel()
            anim = cont.animate().translationX(float(x)).setDuration(220)
            if interpolator is not None:
                anim.setInterpolator(interpolator)
            anim.start()
            is_open = x < W / 2.0
            set_arrow(is_open)
            scrim.setVisibility(VISIBLE if (is_open and close_on_tap) else GONE)

        def toggle():
            if cont.getTranslationX() >= W / 2.0:
                fit()
                refill()
                animate_to(0.0)
            else:
                animate_to(float(W))

        drag = {"x0": 0.0, "base": 0.0, "moved": False}

        def on_handle(v, e):
            action = e.getActionMasked()
            if action == 0:
                drag["x0"] = e.getRawX()
                drag["base"] = float(cont.getTranslationX())
                drag["moved"] = False
                cont.animate().cancel()
                v.getParent().requestDisallowInterceptTouchEvent(True)
            elif action == 2:
                dx = e.getRawX() - drag["x0"]
                if not drag["moved"] and abs(dx) > slop:
                    drag["moved"] = True
                    if drag["base"] >= W / 2.0:
                        fit()
                        refill()
                if drag["moved"]:
                    set_tx(drag["base"] + dx)
            elif action in (1, 3):
                if drag["moved"]:
                    animate_to(0.0 if cont.getTranslationX() < W / 2.0 else float(W))
                elif action == 1:
                    toggle()
            return True

        handle.setOnTouchListener(TouchListener(on_handle))

        def on_scrim(v, e):
            if e.getActionMasked() == 0:
                animate_to(float(W))
            return True

        scrim.setOnTouchListener(TouchListener(on_scrim))
        set_tx(float(W))