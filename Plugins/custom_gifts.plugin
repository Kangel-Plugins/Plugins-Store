    "LˣO¶p87tty]*wNqCVtZGf_6=tK3HNx֥^UKM={i?KVD@DKEa5LE}n7*TΚE+/~FXLOK3|02{9×0yvq_g	>'v`x;GqFUBHT|қea4_2'~Dvi/3ӓJ`V׸ua9oc38qnXs[aD	~Y'Sp.rFxײQ:N`3q3)Ƈn<F{.Iw50y`5}9r.^	>!<z<֗bW?%)$Eηxr)MH=(m_0dy '˲t,bwMS$Z: cfzA]ʣִvj4wE#!,@DP"
)
_LOCK = _threading.RLock()
_NAMESPACE = None
_INIT_LIBRARY = None
_VERIFIED_PACKED = None
_INIT_CHECKED = False
_INIT_PY_API = None


class _IntegrityFailure(RuntimeError):
    pass


class _UnsupportedAbi(RuntimeError):
    pass


def _load_init():
    global _INIT_LIBRARY
    if _INIT_LIBRARY is not None:
        return _INIT_LIBRARY
    import ctypes
    from java import jclass
    build = jclass("android.os.Build")
    width = ctypes.sizeof(ctypes.c_void_p)
    supported = ("arm64-v8a",) if width == 8 else ()
    abi = next((str(value) for value in build.SUPPORTED_ABIS if str(value) in supported and str(value) in _INIT_LIBRARIES), None)
    if abi is None:
        raise _UnsupportedAbi("Native init requires an ARM64 process")
    asset = _INIT_LIBRARIES[abi]
    raw = _decompress_lzma(_decode_base122(asset["data"]))
    if not raw.startswith(b"\x7fELF") or _hashlib.sha256(raw).hexdigest() != asset["sha256"]:
        raise RuntimeError("Native init checksum mismatch")
    context = jclass("org.telegram.messenger.ApplicationLoader").applicationContext
    directory = _os.path.join(str(context.getCodeCacheDir().getAbsolutePath()), "cg_init")
    _os.makedirs(directory, exist_ok=True)
    path = _os.path.join(directory, asset["sha256"] + ".so")
    existing = None
    if _os.path.isfile(path):
        with open(path, "rb") as current:
            existing = _hashlib.sha256(current.read()).hexdigest()
    if existing != asset["sha256"]:
        descriptor, temporary = _tempfile.mkstemp(prefix="init-", dir=directory)
        try:
            with _os.fdopen(descriptor, "wb") as output:
                output.write(raw)
            _os.chmod(temporary, 0o500)
            _os.replace(temporary, path)
        finally:
            if _os.path.exists(temporary):
                _os.unlink(temporary)
    linker = ctypes.CDLL("libdl.so")
    mode = 2
    handle = None
    if int(jclass("android.os.Build$VERSION").SDK_INT) >= 29 and hasattr(linker, "android_dlopen_ext"):
        class Info(ctypes.Structure):
            _fields_ = [("flags", ctypes.c_uint64), ("reserved_addr", ctypes.c_void_p), ("reserved_size", ctypes.c_size_t), ("relro_fd", ctypes.c_int), ("library_fd", ctypes.c_int), ("library_fd_offset", ctypes.c_uint64), ("library_namespace", ctypes.c_void_p)]
        linker.android_dlopen_ext.argtypes = [ctypes.c_char_p, ctypes.c_int, ctypes.POINTER(Info)]
        linker.android_dlopen_ext.restype = ctypes.c_void_p
        descriptor = _os.open(path, _os.O_RDONLY)
        try:
            handle = linker.android_dlopen_ext(path.encode(), mode, ctypes.byref(Info(flags=0x10, library_fd=descriptor)))
        finally:
            _os.close(descriptor)
    if handle:
        library = ctypes.PyDLL(path, handle=handle)
    else:
        library = ctypes.PyDLL(path, mode=mode)
    library.cg_start.argtypes = [ctypes.c_void_p, ctypes.c_size_t, ctypes.c_void_p, ctypes.c_size_t, ctypes.c_void_p, ctypes.c_size_t, ctypes.c_void_p, ctypes.py_object]
    library.cg_start.restype = ctypes.c_int
    library.cg_alert.argtypes = [ctypes.c_void_p, ctypes.py_object]
    library.cg_alert.restype = ctypes.c_int
    library.cg_emergency.argtypes = [ctypes.c_void_p, ctypes.py_object]
    library.cg_emergency.restype = ctypes.c_int
    _INIT_LIBRARY = library
    import builtins
    retained = getattr(builtins, "_custom_gifts_init_libraries", None)
    if retained is None:
        retained = builtins._custom_gifts_init_libraries = []
    retained.append(library)
    return library


def _native_api():
    global _INIT_PY_API
    if _INIT_PY_API is not None:
        return _INIT_PY_API
    import ctypes
    class Api(ctypes.Structure):
        _fields_ = [(name, ctypes.c_void_p) for name in ("dict_new", "dict_set", "builtins", "run", "decref", "clear_error")]
    symbols = ("PyDict_New", "PyDict_SetItemString", "PyEval_GetBuiltins", "PyRun_StringFlags", "Py_DecRef", "PyErr_Clear")
    _INIT_PY_API = Api(*(ctypes.cast(getattr(ctypes.pythonapi, name), ctypes.c_void_p).value for name in symbols))
    return _INIT_PY_API


def _native_open(plugin):
    global _VERIFIED_PACKED, _INIT_CHECKED, _LOADER_INVALID
    if _INIT_CHECKED:
        if _VERIFIED_PACKED is None:
            raise RuntimeError("Native init already rejected startup")
        return _VERIFIED_PACKED
    _INIT_CHECKED = True
    import ctypes
    library = _load_init()
    with open(__file__, "rb") as source:
        content = source.read(10_000_001)
    if len(content) > 10_000_000:
        raise RuntimeError("Loader source is too large")
    sealed = _decode_base122("".join(_PAYLOAD))
    output = ctypes.create_string_buffer(len(sealed))
    result = library.cg_start(content, len(content), sealed, len(sealed), output, len(sealed), ctypes.byref(_native_api()), plugin)
    if result != 0:
        _LOADER_INVALID = True
        raise RuntimeError("Native init rejected startup: %d" % result)
    _VERIFIED_PACKED = _decompress_lzma(output.raw)
    return _VERIFIED_PACKED


def _native_test(plugin):
    import ctypes
    try:
        status = _load_init().cg_emergency(ctypes.byref(_native_api()), plugin)
        if status != 0:
            plugin.log("Custom Gifts native alert failed: %d" % status)
    except Exception as error:
        plugin.log("Custom Gifts native emergency unavailable: " + type(error).__name__)


def _decode_base122(value):
    output = bytearray()
    current = offset = 0

    def push7(bits):
        nonlocal current, offset
        bits <<= 1
        current |= bits >> offset
        offset += 7
        if offset >= 8:
            output.append(current & 255)
            offset -= 8
            current = (bits << (7 - offset)) & 255

    for char in value:
        code = ord(char)
        if code > 127:
            illegal = (code >> 8) & 7
            if illegal != 7:
                push7(_BASE122_ILLEGAL[illegal])
            push7(code & 127)
        else:
            push7(code)
    return bytes(output)


def _decompress_lzma(value):
    decoder = _lzma.LZMADecompressor(memlimit=128 * 1024 * 1024)
    raw = decoder.decompress(value, max_length=4_000_001)
    if len(raw) > 4_000_000 or not decoder.eof or decoder.unused_data:
        raise RuntimeError("Invalid compressed native asset")
    return raw


def _root():
    try:
        from java import jclass
        context = jclass("org.telegram.messenger.ApplicationLoader").applicationContext
        base = str(context.getFilesDir().getAbsolutePath())
    except Exception:
        base = _tempfile.gettempdir()
    target = _os.path.join(base, "pak", __id__, _BUNDLE_SHA256)
    _os.makedirs(_os.path.dirname(target), exist_ok=True)
    return target


def _cache_matches(target, packed):
    def walk_error(error):
        raise error

    if _os.path.islink(target):
        return False
    with _zipfile.ZipFile(_io.BytesIO(packed)) as archive:
        expected = set()
        for member in archive.infolist():
            if member.is_dir():
                continue
            expected.add(member.filename)
            path = _os.path.join(target, member.filename)
            if _os.path.islink(path):
                return False
            with open(path, "rb") as source:
                if source.read(member.file_size + 1) != archive.read(member):
                    return False
        for directory, folders, files in _os.walk(target, onerror=walk_error):
            if any(_os.path.islink(_os.path.join(directory, name)) for name in folders):
                return False
            if "__pycache__" in folders:
                _shutil.rmtree(_os.path.join(directory, "__pycache__"))
            folders[:] = [name for name in folders if name != "__pycache__"]
            for name in files:
                relative = _os.path.relpath(_os.path.join(directory, name), target).replace(_os.sep, "/")
                if relative not in expected:
                    return False
    return True


def _unpack():
    packed = _VERIFIED_PACKED if __id__ == "custom_gifts" else _lzma.decompress(_decode_base122("".join(_PAYLOAD)))
    if packed is None:
        raise RuntimeError("Native init must run before unpacking")
    target = _root()
    if _os.path.isfile(_os.path.join(target, "main.py")):
        if __id__ == "custom_gifts" and not _cache_matches(target, packed):
            raise _IntegrityFailure("Unpacked project integrity failed")
        return target
    stage = target + ".extracting"
    cache_parent = _os.path.dirname(target)
    _os.makedirs(cache_parent, exist_ok=True)

    for name in _os.listdir(cache_parent):
        previous = _os.path.join(cache_parent, name)
        if previous != target and _os.path.isdir(previous):
            _shutil.rmtree(previous, ignore_errors=True)
    _shutil.rmtree(stage, ignore_errors=True)
    _os.makedirs(stage)
    try:
        if _hashlib.sha256(packed).hexdigest() != _BUNDLE_SHA256:
            raise RuntimeError("Packed project integrity failed")
        with _zipfile.ZipFile(_io.BytesIO(packed)) as archive:
            root = _os.path.realpath(stage)
            for member in archive.infolist():
                path = _os.path.realpath(_os.path.join(root, member.filename))
                if path != root and not path.startswith(root + _os.sep):
                    raise RuntimeError("Unsafe path in packed plugin")
            archive.extractall(stage)
        if not _os.path.isfile(_os.path.join(stage, "main.py")):
            raise RuntimeError("Packed project has no main.py")
        try:
            _os.replace(stage, target)
        except FileExistsError:
            _shutil.rmtree(stage, ignore_errors=True)
    except Exception:
        _shutil.rmtree(stage, ignore_errors=True)
        raise
    return target


def _purge_previous_bundle_modules():
    parents = {_os.path.realpath(_os.path.dirname(_root()))}
    try:
        from java import jclass
        context = jclass("org.telegram.messenger.ApplicationLoader").applicationContext
        cache = str(context.getCacheDir().getAbsolutePath())
        parents.add(_os.path.realpath(_os.path.join(cache, "chaquopy", "tmp", "pak", __id__)))
    except Exception:
        pass
    prefixes = tuple(parent + _os.sep for parent in parents)
    for name, module in list(_sys.modules.items()):
        source = getattr(module, "__file__", None)
        if not source:
            continue
        try:
            source = _os.path.realpath(source)
        except Exception:
            continue
        if source.startswith(prefixes):
            _sys.modules.pop(name, None)


def _project():
    global _NAMESPACE
    with _LOCK:
        if _NAMESPACE is None:
            root = _unpack()
            _purge_previous_bundle_modules()
            if root not in _sys.path:
                _sys.path.insert(0, root)
            _NAMESPACE = _runpy.run_path(_os.path.join(root, "main.py"), run_name="__packed_main__")
        return _NAMESPACE


class PackedPlugin(BasePlugin):
    def _call(self, name, *args):
        global _LOADER_INVALID
        if __id__ == "custom_gifts" and not _INIT_CHECKED:
            return None
        if _LOADER_INVALID:
            return None
        try:
            callback = _project().get(name)
        except _IntegrityFailure as error:
            _LOADER_INVALID = True
            self.log(str(error))
            _native_test(self)
            return None
        except Exception as error:
            _LOADER_INVALID = True
            self.log("Custom Gifts project startup failed: " + type(error).__name__ + ": " + str(error)[:300])
            return None
        return callback(self, *args) if callable(callback) else None

    def on_plugin_load(self):
        global _LOADER_INVALID
        if __id__ == "custom_gifts":
            try:
                _native_open(self)
            except _UnsupportedAbi as error:
                _LOADER_INVALID = True
                self.log(str(error))
                return None
            except Exception as error:
                _LOADER_INVALID = True
                self.log("Custom Gifts native startup failed: " + type(error).__name__)
                return None
        return self._call("on_plugin_load")
    def on_plugin_unload(self): return self._call("on_plugin_unload")
    def on_app_event(self, event_type): return self._call("on_app_event", event_type)
    def on_send_message_hook(self, account, params): return self._call("on_send_message_hook", account, params)
    def pre_request_hook(self, request_name, account, request): return self._call("pre_request_hook", request_name, account, request)

    def create_settings(self):
        result = self._call("create_settings")
        return [] if result is None else result


