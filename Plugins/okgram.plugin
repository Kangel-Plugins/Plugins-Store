class LoadMediaHook(MethodHook):
    """MediaDataController.loadMedia: reset cached voice messages on a fresh first-page load."""

    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        try:
            args = list(param.args or [])
            if int(args[4]) == VOICE.base_tab and int(args[2]) == 0 and int(args[3]) == 0:
                self.plugin.master["voice"].pop(int(args[0]), None)
        except Exception as e:
            self.plugin.log_split_error("loadMedia", e)


class AddMessageHook(MethodHook):
    """SharedMediaData.addMessage: records messages and filters them by the current mode."""

    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        p = self.plugin
        try:
            args = list(param.args or [])
            msg = args[0]
            data = param.thisObject
            h = JSystem.identityHashCode(data)

            spec = p.data_spec.get(h)
            if spec is None:
                spec = p.guess_spec(msg)
                if spec is None:
                    return
                p.register_lazy(h, spec, msg)
            elif not p.is_split_on(spec):
                return

            kind = spec.classify(msg)
            if kind is None:
                return

            p.remember(spec, msg)

            if not param.getResult():
                return

            mode = p.data_mode.get(h, spec.modes[0])
            if kind != mode:
                key = msg.monthKey
                section = data.sectionArrays.get(key)
                if section is not None:
                    section.remove(msg)
                    if section.isEmpty():
                        data.sectionArrays.remove(key)
                        data.sections.remove(key)
                data.messages.remove(msg)

            p.sync_total(data)
        except Exception as e:
            p.log_split_error("addMessage", e)


class SetTotalHook(MethodHook):
    """SharedMediaData.setTotalCount: keep the total equal to what we actually show."""

    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            p = self.plugin
            data = param.thisObject
            h = JSystem.identityHashCode(data)
            spec = p.data_spec.get(h)
            if spec is not None and p.is_split_on(spec):
                p.sync_total(data)
                p.schedule_kick(h)
        except Exception:
            pass


class DeleteMessageHook(MethodHook):
    """SharedMediaData.deleteMessage: forget deleted messages in our stores."""

    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            res = param.getResult()
            if res is not None:
                did, mid = int(res.getDialogId()), int(res.getId())
                for store in self.plugin.master.values():
                    store.get(did, {}).pop(mid, None)
        except Exception:
            pass


class PluralHook(MethodHook):
    """LocaleController.formatPluralString("Voice", n) for the profile header counter."""

    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        p = self.plugin
        try:
            if str(param.args[0]) != "Voice":
                return
            if p.last_layout is None or not p.is_split_on(VOICE):
                return
            if not p.called_from("updateSelectedMediaTabText"):
                return
            text = p.counter_text(p.last_layout)
            if text is not None:
                param.setResult(text)
        except Exception as e:
            p.log_split_error("formatPluralString", e)


class NextPageHook(MethodHook):
    """ScrollSlidingTextTabStrip.getNextPageId: Telegram asks it when a swipe starts."""

    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        p = self.plugin
        try:
            layout = p.layout_of_main_strip(param.thisObject)
            if layout is None:
                return
            result = int(param.getResult())
            spec = p.spec_for_tab(result)
            if spec is None:
                p.swipe = None
                return
            if result == spec.alias_tab:
                param.setResult(Integer(spec.base_tab))
            p.last_layout = layout

            now = time.time()
            sw = p.swipe
            if sw is None or sw["target"] != result or sw.get("done") is not None:
                p.swipe = {"spec": spec, "target": result, "t": now, "max": 0.0, "done": None}
            else:
                sw["t"] = now

            mode = spec.modes[1] if result == spec.alias_tab else spec.modes[0]
            if p.get_mode(layout, spec) != mode:
                p.detach_hidden_page(layout)
                p.set_mode(layout, spec, mode)
        except Exception as e:
            p.log_split_error("getNextPageId", e)


class SelectTabHook(MethodHook):
    """ScrollSlidingTextTabStrip.selectTabWithId: moves the tab indicator during a swipe."""

    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        p = self.plugin
        if p.alias_select:
            return
        sw = p.swipe
        if sw is None:
            return
        try:
            spec = sw["spec"]
            now = time.time()
            done_at = sw.get("done")
            if done_at is not None:
                if now - done_at > POST_SWIPE_GRACE:
                    p.swipe = None
                    return
            elif now - sw["t"] > SWIPE_TIMEOUT:
                p.swipe = None
                return
            strip = param.thisObject
            if p.layout_of_main_strip(strip) is None:
                return
            tab_id = int(param.args[0])
            if tab_id != spec.base_tab:
                return
            progress = float(param.args[1])

            if done_at is not None:
                finished, cancelled = True, False
            else:
                sw["t"] = now
                sw["max"] = max(sw["max"], progress)
                finished = progress >= 0.999
                cancelled = progress <= 0.001 and sw["max"] >= 0.1
                if finished or cancelled:
                    sw["done"] = now

            new_id = spec.alias_tab if sw["target"] == spec.alias_tab else spec.base_tab
            new_progress = 1.0 if (finished or cancelled) else progress

            if new_id != tab_id or new_progress != progress:
                p.alias_select = True
                try:
                    strip.selectTabWithId(new_id, new_progress)
                finally:
                    p.alias_select = False
                param.setResult(None)
        except Exception as e:
            p.alias_select = False
            p.log_split_error("selectTabWithId", e)


class ToggleSubMenuHook(MethodHook):
    """ActionBarMenuItem.toggleSubMenu: the native photo/video options menu must not open."""

    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        p = self.plugin
        try:
            if p.option_items and p.is_split_on(MEDIA):
                if JSystem.identityHashCode(param.thisObject) in p.option_items:
                    param.setResult(None)
        except Exception:
            pass


class AnimatedVisibilityHook(MethodHook):
    """AndroidUtilities.updateViewVisibilityAnimated: keep the native options button hidden."""

    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        p = self.plugin
        try:
            if not p.option_items or not p.is_split_on(MEDIA):
                return
            view = param.args[0]
            if view is not None and JSystem.identityHashCode(view) in p.option_items:
                view.setVisibility(VIEW_GONE)
                view.setAlpha(0.0)
                param.setResult(None)
        except Exception:
            pass


# --------------------------------------------------------------------------
# Hook handlers: UiTweaks integrations (GIF Spoiler, Edit File Name, Join Requests)
# --------------------------------------------------------------------------

class DirectProfileHook(MethodHook):

    @hook_filters(HookFilter.Condition("param.thisObject != null"))
    def before_hooked_method(self, param):
        try:
            delegate = param.thisObject
            if not delegate or len(param.args) < 1:
                return

            view = param.args[0]
            member_request_cell_class = find_class("org.telegram.ui.Cells.MemberRequestCell")
            if not member_request_cell_class or not isinstance(view, member_request_cell_class):
                return

            is_search_expanded = get_private_field(delegate, "isSearchExpanded")
            if is_search_expanded:
                fragment = get_private_field(delegate, "fragment")
                if fragment and fragment.getParentActivity():
                    AndroidUtilities.hideKeyboard(fragment.getParentActivity().getCurrentFocus())

            cell = view

            def open_profile_directly():
                try:
                    importer = cell.getImporter()
                    if not importer:
                        return
                    users = get_private_field(delegate, "users")
                    if not users:
                        return
                    user = users.get(importer.user_id)
                    if not user:
                        return
                    fragment = get_private_field(delegate, "fragment")
                    if not fragment:
                        return

                    fragment.getMessagesController().putUser(user, False)
                    set_private_field(delegate, "isNeedRestoreList", True)
                    fragment.dismissCurrentDialog()

                    args = Bundle()
                    args.putLong("user_id", user.id)
                    args.putBoolean("removeFragmentOnChatOpen", False)

                    profile_activity = ProfileActivity(args)
                    fragment.presentFragment(profile_activity)
                except Exception:
                    pass

            delay = 100 if is_search_expanded else 0
            run_on_ui_thread(open_profile_directly, delay)
            param.setResult(None)
        except Exception:
            pass


# --------------------------------------------------------------------------
# Plugin
# --------------------------------------------------------------------------

class OkGramPlugin(BasePlugin):
    opt_images = True
    opt_status = True
    opt_stickers = True
    opt_emoji = True
    opt_always_tabs_forums = True

    emoji_measure_depth = 0
    emoji_measure_thread = 0
    saved_density = None
    density_depth = 0
    status_cache_types = (7, 9)  # CACHE_TYPE_EMOJI_STATUS, ..._ALERT_EMOJI_STATUS

    # ---- settings ---------------------------------------------------------

    def create_settings(self) -> List[Any]:
        return [
            Header(text="Appearance"),
            Switch(
                key="images",
                text="Sharp images",
                subtext="Load sharper avatars, media, and album covers without blurry upscaling",
                default=True,
                on_change=self._on_images,
            ),
            Switch(
                key="status",
                text="Endless status animation",
                subtext="Keep animated emoji statuses looping continuously",
                default=True,
                on_change=self._on_status,
            ),
            Switch(
                key="stickers",
                text="5 sticker columns",
                subtext="Lock the sticker panel to 5 items per row",
                default=True,
                on_change=self._on_stickers,
            ),
            Switch(
                key="emoji",
                text="8 emoji columns",
                subtext="Lock the emoji panel to 8 items per row",
                default=True,
                on_change=self._on_emoji,
            ),
            Header(text="Chats"),
            Switch(
                key="always_tabs_forums",
                text="Always show forum tabs",
                subtext="Force tabbed topic view across all forum groups",
                default=True,
                on_change=self._on_always_tabs_forums,
            ),
            Switch(
                key="enable_join_request_direct_profile",
                text="Open profile from join requests",
                subtext="Open a user's profile directly when tapping them in join requests",
                default=True,
                on_change=self._on_join_request_direct_profile_change,
            ),
            Header(text="Media & Playlists"),
            Switch(
                key="split_media",
                text="Split photos and videos",
                subtext="Separate shared media into dedicated photos and videos tabs",
                default=True,
                on_change=lambda v: self.set_split_flag("media", v),
            ),
            Switch(
                key="split_voice",
                text="Split voice and video messages",
                subtext="Separate voice notes and video messages into their own tabs",
                default=True,
                on_change=lambda v: self.set_split_flag("voice", v),
            ),
            Switch(
                key="reset_progress",
                text="Start tracks from the beginning",
                subtext="Always start music tracks from the beginning when switching",
                default=True,
            ),
            Switch(
                key="topic_playlist",
                text="Topic-only playlists",
                subtext="Keep music playback inside the current forum topic",
                default=True,
            ),
        ]

    def _on_images(self, value: bool):
        self.opt_images = bool(value)

    def _on_status(self, value: bool):
        self.opt_status = bool(value)

    def _on_stickers(self, value: bool):
        self.opt_stickers = bool(value)

    def _on_emoji(self, value: bool):
        self.opt_emoji = bool(value)

    def _on_always_tabs_forums(self, value: bool):
        self.opt_always_tabs_forums = bool(value)

    def _on_join_request_direct_profile_change(self, value: bool):
        if value:
            self._hook_join_request_direct_profile()
        else:
            self._unhook_join_request_direct_profile()

    def _sync_settings(self):
        self.opt_images = bool(self.get_setting("images", True))
        self.opt_status = bool(self.get_setting("status", True))
        self.opt_stickers = bool(self.get_setting("stickers", True))
        self.opt_emoji = bool(self.get_setting("emoji", True))
        self.opt_always_tabs_forums = bool(self.get_setting("always_tabs_forums", True))

    # ---- lifecycle --------------------------------------------------------

    def on_plugin_load(self):
        self._sync_settings()
        self._hook_errors = []

        # Playlist state
        self._topic_lock = None  # type: Optional[Tuple[int, int]]
        self._skip_topic = False
        self._fresh_start = None
        self._music_did_load = _int(getattr(NotificationCenter, "musicDidLoad", None), -2)
        self._media_did_load = _int(getattr(NotificationCenter, "mediaDidLoad", None), -3)
        self._media_music = _int(getattr(MediaDataController, "MEDIA_MUSIC", None), -2)

        # Split tabs state
        self.flags = {"media": True, "voice": True}
        self.refresh_split_flags()
        self.master = {"voice": {}, "media": {}}
        self.data_spec = {}
        self.data_mode = {}
        self.kick_count = {}
        self.kick_pending = set()
        self.option_items = {}
        self.in_update = 0
        self.adding = False
        self.alias_call = False
        self.last_layout = None
        self._tmp_page0 = None
        self._restore_type = MEDIA.base_tab
        self.swipe = None
        self.alias_select = False
        self.hooked_delegates = set()

        # UiTweaks hook refs
        self.hook_join_request_direct_profile_refs = []

        for name, install in (
            ("images", self._hook_images),
            ("status", self._hook_status),
            ("emoji", self._hook_emoji),
            ("stickers", self._hook_stickers),
            ("always_tabs_forums", self._hook_always_tabs_forums),
            ("playlists", self._hook_playlists),
            ("split_tabs", self._hook_split_tabs),
        ):
            try:
                install()
            except Exception:
                self.logger.exception("OkGram: failed to install %s hooks", name)
                self._note("install %s failed" % name)

        if self.get_setting("enable_join_request_direct_profile", True):
            self._hook_join_request_direct_profile()

        if self._hook_errors:
            self.logger.error("Hook errors: %s", self._hook_errors)

    def on_plugin_unload(self):
        self.restore_density()
        self.emoji_measure_depth = 0
        self.emoji_measure_thread = 0
        self._unhook_join_request_direct_profile()

    def restore_density(self):
        if self.density_depth > 0:
            self.density_depth -= 1
        if self.density_depth == 0 and self.saved_density is not None:
            AndroidUtilities.density = self.saved_density
            self.saved_density = None

    # ---- hook installation ------------------------------------------------

    def _note(self, msg: str) -> None:
        self.logger.error("%s", msg)
        errors = getattr(self, "_hook_errors", None)
        if errors is not None and msg not in errors:
            errors.append(msg)

    def _install(self, class_name: str, name: str, handler, signatures=None) -> int:
        clazz = find_class(class_name)
        if clazz is None:
            self._note("class not found: %s" % class_name)
            return 0
        count = 0
        try:
            unhooks = self.hook_all_methods(clazz, name, handler)
            if unhooks:
                count = len(unhooks) if hasattr(unhooks, "__len__") else 1
                if count:
                    return count
        except Exception as e:
            self._note("hook_all_methods(%s.%s): %s" % (class_name, name, e))

        if signatures:
            for sig in signatures:
                if sig is None:
                    continue
                try:
                    method = clazz.getDeclaredMethod(name, *sig) if sig else clazz.getDeclaredMethod(name)
                    method.setAccessible(True)
                    if self.hook_method(method, handler):
                        count += 1
                        break
                except Exception:
                    pass
        if count == 0:
            self._note("No hook installed for %s.%s" % (class_name, name))
        return count

    def _install_class_callback(self, clazz, name, before=None, after=None, signatures=None) -> int:
        hook = _CallbackHook(self, name, before=before, after=after)
        count = 0
        try:
            unhooks = self.hook_all_methods(clazz, name, hook)
            if unhooks:
                count = len(unhooks) if hasattr(unhooks, "__len__") else 1
                if count:
                    return count
        except Exception as e:
            self._note("hook_all_methods(%s): %s" % (name, e))

        if signatures:
            for sig in signatures:
                try:
                    method = clazz.getDeclaredMethod(name, *sig) if sig else clazz.getDeclaredMethod(name)
                    method.setAccessible(True)
                    if self.hook_method(method, hook):
                        count += 1
                except Exception:
                    pass

        if count == 0:
            self._note("No hook installed for %s" % name)
        return count

    def _set_image_signatures(self):
        loc = find_class("org.telegram.messenger.ImageLocation")
        string = find_class("java.lang.String")
        drawable = find_class("android.graphics.drawable.Drawable")
        obj = find_class("java.lang.Object")
        sigs = []
        for size in _primitive_alts(Long.TYPE, jlong):
            for cache in _primitive_alts(Integer.TYPE, jint):
                sig = _sig(loc, string, loc, string, loc, string, drawable, size, string, obj, cache)
                if sig is not None:
                    sigs.append(sig)
        return sigs

    def _artwork_signatures(self):
        document = find_class("org.telegram.tgnet.TLRPC$Document")
        sigs = []
        for flag in _primitive_alts(Boolean.TYPE, jboolean):
            sig = _sig(document, flag)
            if sig is not None:
                sigs.append(sig)
        return sigs

    def _ints(self, count: int):
        sigs = []
        for primitive in _primitive_alts(Integer.TYPE, jint):
            sigs.append((primitive,) * count)
        return sigs

    def _hook_images(self):
        self._install(
            "org.telegram.ui.AvatarPreviewer$AvatarView",
            "setImage",
            AvatarPreviewHook(self, "AvatarPreviewer.AvatarView.setImage"),
        )
        self._install(
            "org.telegram.messenger.ImageReceiver",
            "setImage",
            SetImageHook(self, "setImage"),
            signatures=self._set_image_signatures(),
        )
        self._install(
            "org.telegram.messenger.MessageObject",
            "getArtworkUrl",
            ArtworkHook(self, "getArtworkUrl"),
            signatures=self._artwork_signatures(),
        )

    def _hook_status(self):
        cls = find_class("org.telegram.ui.Components.AnimatedEmojiDrawable")
        if cls is not None:
            types = []
            for field in ("CACHE_TYPE_EMOJI_STATUS", "CACHE_TYPE_ALERT_EMOJI_STATUS"):
                value = get_static_private_field(cls, field)
                if value is not None:
                    types.append(int(value))
            if types:
                self.status_cache_types = tuple(types)
        receiver = find_class("org.telegram.messenger.ImageReceiver")
        sigs = []
        sig = _sig(receiver)
        if sig is not None:
            sigs.append(sig)
        self._install(
            "org.telegram.ui.Components.AnimatedEmojiDrawable",
            "updateAutoRepeat",
            StatusRepeatHook(self, "updateAutoRepeat"),
            signatures=sigs,
        )

    def _hook_emoji(self):
        self._install(
            "org.telegram.ui.Components.EmojiView$EmojiGridView",
            "onMeasure",
            EmojiMeasureHook(self, "EmojiGridView.onMeasure"),
            signatures=self._ints(2),
        )
        self._install(
            "androidx.recyclerview.widget.GridLayoutManager",
            "setSpanCount",
            SpanCountHook(self, "setSpanCount"),
            signatures=self._ints(1),
        )

    def _hook_stickers(self):
        self._install(
            "org.telegram.ui.Components.EmojiView$StickersGridAdapter",
            "updateItems",
            StickersUpdateHook(self, "StickersGridAdapter.updateItems"),
            signatures=[()],
        )

    def _hook_always_tabs_forums(self):
        self._install(
            "org.telegram.messenger.ChatObject",
            "areTabsEnabled",
            AreTabsEnabledHook(self),
        )

    def _hook_playlists(self):
        mc = _as_class(find_class("org.telegram.messenger.MediaController")) or _as_class(MediaController)
        mdc = _as_class(find_class("org.telegram.messenger.MediaDataController")) or _as_class(MediaDataController)
        msg_cls = _as_class(find_class("org.telegram.messenger.MessageObject")) or _as_class(MessageObject)
        alist = find_class("java.util.ArrayList") or ArrayList
        if not mc or not mdc:
            self._note("MediaController / MediaDataController class not found")
            return

        bools = [Boolean.TYPE, jboolean]
        ints = [Integer.TYPE, jint]
        longs = [Long.TYPE, jlong]

        play_sigs = []
        if msg_cls:
            play_sigs.append((msg_cls,))
            for b in bools:
                play_sigs.append((msg_cls, b))
        self._install_class_callback(
            mc, "playMessage",
            before=self._before_play_message, after=self._after_play_message,
            signatures=play_sigs,
        )
        self._install_class_callback(
            mc, "playPreviousMessage", before=self._before_play_previous,
            signatures=[()],
        )
        self._install_class_callback(
            mc, "playMessageAtIndex", before=self._before_play_at_index,
            signatures=[(t,) for t in ints],
        )
        params_cls = find_class(
            "org.telegram.messenger.MediaController$PlaylistGlobalSearchParams"
        )
        set_playlist_sigs = []
        if msg_cls and alist:
            for lg in longs:
                set_playlist_sigs.append((alist, msg_cls, lg))
                for b in bools:
                    set_playlist_sigs.append((alist, msg_cls, lg, b))
                    if params_cls is not None:
                        set_playlist_sigs.append((alist, msg_cls, lg, b, params_cls))
        self._install_class_callback(
            mc, "setPlaylist",
            before=self._before_set_playlist, after=self._after_set_playlist,
            signatures=set_playlist_sigs,
        )
        obj_arr = find_class("[Ljava.lang.Object;")
        did_sigs = []
        for a in ints:
            for b in ints:
                did_sigs.append((a, b))
                if obj_arr is not None:
                    did_sigs.append((a, b, obj_arr))
        self._install_class_callback(
            mc, "didReceivedNotification",
            before=self._before_notification, after=self._after_notification,
            signatures=did_sigs,
        )
        self._install_class_callback(
            mdc, "loadMedia", before=self._before_load_media,
            signatures=self._load_media_signatures(longs, ints),
        )

    def _hook_split_tabs(self):
        layout_cls = "org.telegram.ui.Components.SharedMediaLayout"
        strip_cls = "org.telegram.ui.Components.ScrollSlidingTextTabStrip"
        data_cls = "org.telegram.ui.Components.SharedMediaLayout$SharedMediaData"

        self._hook_split(layout_cls, "updateTabs", UpdateTabsHook(self))
        self._hook_split(strip_cls, "addTextTab", AddTabHook(self))
        self._hook_split("org.telegram.messenger.MediaDataController", "loadMedia", LoadMediaHook(self))
        self._hook_split(layout_cls, "switchToCurrentSelectedMode", SwitchModeHook(self))
        self._hook_split(
            layout_cls,
            "updateSelectedMediaTabText",
            _CallbackHook(self, "updateSelectedMediaTabText", after=lambda param: self.hide_options(param.thisObject)),
        )
        self._hook_split(strip_cls, "getNextPageId", NextPageHook(self))
        self._hook_split(strip_cls, "selectTabWithId", SelectTabHook(self))
        self._hook_split(layout_cls, "getSelectedTab", RemapTabHook())
        self._hook_split(layout_cls, "getClosestTab", RemapTabHook())
        self._hook_split(data_cls, "addMessage", AddMessageHook(self))
        self._hook_split(data_cls, "deleteMessage", DeleteMessageHook(self))
        self._hook_split(data_cls, "setTotalCount", SetTotalHook(self))
        self._hook_split("org.telegram.messenger.LocaleController", "formatPluralString", PluralHook(self))
        self._hook_split("org.telegram.ui.ActionBar.ActionBarMenuItem", "toggleSubMenu", ToggleSubMenuHook(self))
        self._hook_split(
            "org.telegram.messenger.AndroidUtilities",
            "updateViewVisibilityAnimated",
            AnimatedVisibilityHook(self),
        )

    # ---- UiTweaks: Join Requests Direct Profile ---------------------------

    def _hook_join_request_direct_profile(self):
        if self.hook_join_request_direct_profile_refs:
            return
        try:
            delegate_class = find_class("org.telegram.ui.Delegates.MemberRequestsDelegate")
            if not delegate_class:
                self._note("MemberRequestsDelegate not found")
                return
            unhooks = self.hook_all_methods(delegate_class, "onItemClick", DirectProfileHook())
            if unhooks:
                self.hook_join_request_direct_profile_refs = list(unhooks)
            else:
                self._note("No hook installed for MemberRequestsDelegate.onItemClick")
        except Exception as e:
            self.logger.info("Join request direct profile hook failed: %s", e)

    def _unhook_join_request_direct_profile(self):
        for ref in getattr(self, "hook_join_request_direct_profile_refs", []):
            try:
                self.unhook_method(ref)
            except Exception:
                pass
        self.hook_join_request_direct_profile_refs = []

    # ---- OK Playlists logic -----------------------------------------------

    def _load_media_signatures(self, longs, ints):
        vis = find_class(
            "org.telegram.ui.Components.Reactions.ReactionsLayoutInBubble$VisibleReaction"
        )
        str_cls = find_class("java.lang.String")
        int_t = ints[0] if ints else Integer.TYPE
        sigs = []
        for d in longs:
            for t in longs:
                core = (d, int_t, int_t, int_t, int_t, t, int_t, int_t, int_t)
                sigs.append(core)
                if vis is not None and str_cls is not None:
                    sigs.append(core + (vis, str_cls))
        return sigs

    def _reset_all_copies(self, mc, msg, forget_long: bool) -> None:
        _reset_progress(msg)
        if forget_long:
            _forget_saved_position(msg)
        if mc is None or msg is None:
            return
        for field in ("playlist", "shuffledPlaylist"):
            lst = get_private_field(mc, field)
            for i in range(_list_size(lst)):
                try:
                    other = _list_get(lst, i)
                except Exception:
                    continue
                if other is not None and other is not msg and _same_message(other, msg):
                    _reset_progress(other)

    def _force_start_at_zero(self, mc, msg, first: bool) -> None:
        if mc is None or msg is None:
            return
        pending = _float(get_private_field(mc, "seekToProgressPending"), 0.0)
        if pending == 0.0 and (not first or _float(msg.audioProgress) == 0.0):
            return
        self._reset_all_copies(mc, msg, True)
        _set_field(mc, "seekToProgressPending", jfloat(0.0), 0.0)
        try:
            playing = mc.getPlayingMessageObject()
            if playing is not None and _same_message(playing, msg):
                ok = False
                try:
                    ok = bool(mc.seekToProgressMs(playing, jlong(0)))
                except Exception:
                    pass
                if not ok:
                    mc.seekToProgress(playing, 0.0)
        except Exception:
            self.logger.exception("seek to zero failed")

    def _schedule_zero(self, mc, msg) -> None:
        self._force_start_at_zero(mc, msg, True)

        def later():
            try:
                playing = mc.getPlayingMessageObject()
                if playing is None or not _same_message(playing, msg):
                    return
                self._force_start_at_zero(mc, playing, False)
            except Exception:
                pass

        run_on_ui_thread(later, 50)
        run_on_ui_thread(later, 250)

    def _stop_saving_position(self, mc, msg) -> None:
        try:
            playing = mc.getPlayingMessageObject()
            if playing is None or not _same_message(playing, msg):
                return
            if get_private_field(mc, "shouldSavePositionForCurrentAudio") is not None:
                _set_field(mc, "shouldSavePositionForCurrentAudio", None)
        except Exception:
            self.logger.exception("stop saving position failed")

    def _before_play_message(self, param):
        self._fresh_start = None
        if not param.args:
            return
        incoming = param.args[0]
        if incoming is None:
            return
        mc = param.thisObject
        if self.get_setting("topic_playlist", True):
            self._ensure_topic_lock(incoming)
            self._filter_controller_playlist(mc, incoming)

        if self.get_setting("reset_progress", True) and _is_music(incoming):
            _forget_saved_position(incoming)

        if not self.get_setting("reset_progress", True):
            return
        current = mc.getPlayingMessageObject()
        if current is None or not current.isMusic() or not incoming.isMusic():
            return
        if _same_message(current, incoming):
            return

        self._reset_all_copies(mc, current, True)
        self._reset_all_copies(mc, incoming, True)
        self._fresh_start = incoming
        run_on_ui_thread(lambda: _forget_saved_position(current), 150)

    def _after_play_message(self, param):
        if not param.args:
            return
        incoming = param.args[0]
        mc = param.thisObject
        marker = self._fresh_start
        self._fresh_start = None
        if incoming is None:
            return
        if self.get_setting("reset_progress", True) and _is_music(incoming):
            self._stop_saving_position(mc, incoming)
        if not self.get_setting("reset_progress", True):
            return
        if marker is None or not _same_message(incoming, marker):
            return
        self._schedule_zero(mc, incoming)

    def _before_play_previous(self, param):
        if not self.get_setting("reset_progress", True):
            return
        mc = param.thisObject
        current = mc.getPlayingMessageObject()
        if current is None or not current.isMusic():
            return
        try:
            if _int(current.audioProgressSec) > 10:
                return
        except Exception:
            pass
        target = self._playlist_neighbor(mc, previous=True)
        if target is None or _same_message(target, current):
            return
        self._reset_all_copies(mc, target, True)

    def _before_play_at_index(self, param):
        if not self.get_setting("reset_progress", True):
            return
        if not param.args:
            return
        mc = param.thisObject
        try:
            index = _int(param.args[0])
            playlist = get_private_field(mc, "playlist")
            if playlist is None or index < 0 or index >= playlist.size():
                return
            target = playlist.get(index)
        except Exception:
            return
        if target is None:
            return
        current = mc.getPlayingMessageObject()
        if current is not None and _same_message(current, target):
            return
        self._reset_all_copies(mc, target, True)

    def _playlist_neighbor(self, mc, previous: bool):
        try:
            use_shuffle = _bool(SharedConfig.shuffleMusic)
        except Exception:
            use_shuffle = False
        lst = get_private_field(mc, "shuffledPlaylist" if use_shuffle else "playlist")
        n = _list_size(lst)
        if n <= 0:
            return None
        idx = _int(get_private_field(mc, "currentPlaylistNum"), 0)
        try:
            reversed_order = _bool(SharedConfig.playOrderReversed)
        except Exception:
            reversed_order = False
        step = -1 if previous else 1
        if reversed_order:
            step = -step
        nxt = idx + step
        if nxt < 0:
            nxt = n - 1
        elif nxt >= n:
            nxt = 0
        try:
            return _list_get(lst, nxt)
        except Exception:
            return None

    def _ensure_topic_lock(self, msg, force: bool = False) -> Optional[Tuple[int, int]]:
        if self._skip_topic:
            return None
        if msg is None:
            return self._topic_lock
        try:
            dialog_id = _int(msg.getDialogId())
            account = msg.currentAccount
        except Exception:
            return self._topic_lock
        if not _is_forum(account, dialog_id):
            self._topic_lock = None
            return None
        if not force and self._topic_lock and self._topic_lock[0] == dialog_id:
            return self._topic_lock
        topic = _topic_from_open_chat(dialog_id, account) or _topic_of(msg)
        if topic is None:
            return None
        self._topic_lock = (dialog_id, topic)
        return self._topic_lock

    def _active_playlist(self, mc):
        try:
            shuffle = _bool(SharedConfig.shuffleMusic)
        except Exception:
            shuffle = False
        return get_private_field(mc, "shuffledPlaylist" if shuffle else "playlist")

    def _sync_playlist_index(self, mc, anchor) -> None:
        if anchor is None:
            return
        active = self._active_playlist(mc)
        for i in range(_list_size(active)):
            try:
                if _same_message(_list_get(active, i), anchor):
                    if _int(get_private_field(mc, "currentPlaylistNum"), -1) != i:
                        _set_field(mc, "currentPlaylistNum", jint(i), i)
                    return
            except Exception:
                continue

    def _filter_controller_playlist(self, mc, anchor=None) -> int:
        if mc is None or not self.get_setting("topic_playlist", True):
            return 0
        if anchor is None:
            anchor = mc.getPlayingMessageObject()
        lock = self._topic_lock or self._ensure_topic_lock(anchor)
        if lock is None:
            return 0
        dialog_id, topic = lock
        playlist = get_private_field(mc, "playlist")
        shuffled = get_private_field(mc, "shuffledPlaylist")
        removed = _filter_list_for_topic(playlist, dialog_id, topic)
        removed += _filter_list_for_topic(shuffled, dialog_id, topic)
        if not removed:
            return 0

        pmap = get_private_field(mc, "playlistMap")
        if pmap is not None and playlist is not None:
            try:
                pmap.clear()
                for i in range(playlist.size()):
                    item = playlist.get(i)
                    pmap.put(item.getId(), item)
            except Exception:
                self.logger.exception("playlistMap rebuild failed")

        self._sync_playlist_index(mc, anchor)
        return removed

    def _before_set_playlist(self, param):
        args = param.args
        if not args or len(args) < 2:
            return
        if not self.get_setting("topic_playlist", True):
            self._topic_lock = None
            return
        messages, current = args[0], args[1]
        if current is None:
            return
        self._topic_lock = None
        if _is_unfiltered_playlist(args):
            self._skip_topic = True
            return
        self._skip_topic = False
        lock = self._ensure_topic_lock(current, force=True)
        if lock is None:
            return
        _, topic = lock
        if messages is None:
            return

        kept = ArrayList()
        for i in range(_list_size(messages)):
            msg = _list_get(messages, i)
            if msg is None:
                continue
            try:
                if not msg.isMusic():
                    continue
            except Exception:
                continue
            t = _topic_of(msg)
            if t is None or t == topic:
                kept.add(msg)
        args[0] = kept

    def _after_set_playlist(self, param):
        if self._skip_topic or not self.get_setting("topic_playlist", True):
            return
        current = param.args[1] if param.args and len(param.args) > 1 else None
        self._ensure_topic_lock(current)
        self._filter_controller_playlist(param.thisObject, current)

    def _notification_id(self, param) -> int:
        try:
            return _int(param.args[0], -1)
        except Exception:
            return -1

    def _before_notification(self, param):
        nid = self._notification_id(param)
        if nid != self._music_did_load and nid != self._media_did_load:
            return
        if not self.get_setting("topic_playlist", True):
            return
        if nid == self._music_did_load:
            self._filter_music_did_load_payload(param)
        else:
            self._filter_media_did_load_payload(param)

    def _after_notification(self, param):
        nid = self._notification_id(param)
        if nid != self._music_did_load and nid != self._media_did_load:
            return
        if not self.get_setting("topic_playlist", True):
            return
        self._filter_controller_playlist(param.thisObject)

    def _payload(self, param):
        args = param.args
        if args is None or len(args) < 3:
            return None
        return args[2]

    def _filter_music_did_load_payload(self, param):
        mc = param.thisObject
        playing = mc.getPlayingMessageObject()
        payload = self._payload(param)
        if playing is None or payload is None:
            return
        try:
            dialog_id = _int(payload[0], 0)
            begin, end = payload[1], payload[2]
        except Exception:
            return
        if dialog_id != _int(playing.getDialogId()):
            return
        lock = self._ensure_topic_lock(playing)
        if lock is None:
            return
        _, topic = lock
        _filter_list_for_topic(begin, lock[0], topic)
        _filter_list_for_topic(end, lock[0], topic)

    def _filter_media_did_load_payload(self, param):
        payload = self._payload(param)
        if payload is None:
            return
        try:
            arr = payload[2]
            guid = _int(payload[3], -1)
            media_type = _int(payload[4], -1)
        except Exception:
            return
        if media_type != self._media_music:
            return
        mc = param.thisObject
        class_guid = _int(get_private_field(mc, "playlistClassGuid"), 0)
        if class_guid == 0 or guid != class_guid:
            return
        lock = self._topic_lock
        if lock is None:
            lock = self._ensure_topic_lock(mc.getPlayingMessageObject())
        if lock is None:
            return
        _filter_list_for_topic(arr, lock[0], lock[1])

    def _before_load_media(self, param):
        if not self.get_setting("topic_playlist", True):
            return
        args = param.args
        if args is None or len(args) < 8:
            return
        try:
            ptypes = [t.getName() for t in param.method.getParameterTypes()]
        except Exception:
            return
        if len(ptypes) < 8 or ptypes[0] != "long" or ptypes[5] != "long":
            return
        if _int(args[4], -1) != self._media_music:
            return
        controller = MediaController.getInstance()
        guid = _int(get_private_field(controller, "playlistClassGuid"), 0)
        if guid == 0 or _int(args[7], -1) != guid:
            return
        playing = controller.getPlayingMessageObject()
        if playing is None or _int(args[0], 0) != _int(playing.getDialogId()):
            return
        lock = self._ensure_topic_lock(playing)
        if lock is None:
            return
        topic = lock[1]
        try:
            args[5] = jlong(topic)
        except Exception:
            args[5] = topic

    # ---- Split Tabs logic -------------------------------------------------

    def refresh_split_flags(self):
        try:
            self.flags["media"] = bool(self.get_setting("split_media", True))
            self.flags["voice"] = bool(self.get_setting("split_voice", True))
        except Exception as e:
            self.log_split_error("refresh_split_flags", e)

    def set_split_flag(self, key, value):
        self.flags[key] = bool(value)

    def is_split_on(self, spec):
        return bool(self.flags.get(spec.key, False))

    def log_split_error(self, where, error):
        try:
            self.logger.info(f"{where}: {error}")
        except Exception:
            pass

    def tab_title(self, kind):
        ru, en = TITLES[kind]
        try:
            if str(Locale.getDefault().getLanguage()) == "ru":
                return ru
        except Exception:
            pass
        return en

    def spec_for_tab(self, tab_id):
        for spec in SPECS:
            if tab_id == spec.alias_tab:
                return spec
            if tab_id == spec.base_tab and self.is_split_on(spec):
                return spec
        return None

    def guess_spec(self, msg):
        if self.is_split_on(VOICE) and classify_voice(msg) is not None:
            return VOICE
        return None

    def base_class(self, obj, simple_name):
        c = obj.getClass()
        while c is not None:
            if c.getSimpleName() == simple_name:
                return c
            c = c.getSuperclass()
        return obj.getClass()

    def normalize_pages(self, layout):
        base = self.base_class(layout, "SharedMediaLayout")
        pages = _get_declared_field_val(layout, base, "mediaPages")
        for page in pages:
            if page is None:
                continue
            pbase = self.base_class(page, "MediaPage")
            t = int(_get_declared_field_val(page, pbase, "selectedType"))
            if t in ALIAS_TO_BASE:
                _set_declared_int_field(page, pbase, "selectedType", ALIAS_TO_BASE[t])

    def ensure_delegate_hooks(self, layout):
        base = self.base_class(layout, "SharedMediaLayout")
        strip = _get_declared_field_val(layout, base, "scrollSlidingTextTabStrip")
        if strip is None:
            return
        sbase = self.base_class(strip, "ScrollSlidingTextTabStrip")
        delegate = _get_declared_field_val(strip, sbase, "delegate")
        if delegate is None:
            return
        name = str(delegate.getClass().getName())
        if name in self.hooked_delegates:
            return
        self.hooked_delegates.add(name)
        self._hook_split(name, "onPageSelected", DelegateHook(self))
        self._hook_split(name, "canReorder", ReorderGuardHook())
        self._hook_split(name, "showOptions", ReorderGuardHook())

    def prune(self):
        while len(self.data_spec) > MAX_TRACKED:
            old = next(iter(self.data_spec))
            self.data_spec.pop(old, None)
            self.data_mode.pop(old, None)
            self.kick_count.pop(old, None)

    def remember(self, spec, msg):
        store = self.master[spec.key]
        did = int(msg.getDialogId())
        bucket = store.get(did)
        if bucket is None:
            if len(store) >= MAX_DIALOGS:
                store.pop(next(iter(store)), None)
            bucket = store[did] = {}
        bucket[int(msg.getId())] = msg

    def register_lazy(self, h, spec, msg):
        self.data_spec[h] = spec
        self.data_mode[h] = spec.modes[0]
        self.master[spec.key].pop(int(msg.getDialogId()), None)
        self.prune()

    def track_layout(self, layout):
        base = self.base_class(layout, "SharedMediaLayout")
        datas = _get_declared_field_val(layout, base, "sharedMediaData")
        for spec in SPECS:
            if not self.is_split_on(spec):
                continue
            data = datas[spec.data_index]
            h = JSystem.identityHashCode(data)
            if h in self.data_spec:
                continue
            self.data_spec[h] = spec
            self.data_mode[h] = spec.modes[0]
            dialog_id = int(_get_declared_field_val(layout, base, "dialog_id"))
            self.master[spec.key].pop(dialog_id, None)
            self.prune()
            self.adopt(layout, spec, data)

    def adopt(self, layout, spec, data):
        try:
            n = int(data.messages.size())
            if n == 0:
                return
            for i in range(n):
                m = data.messages.get(i)
                if spec.classify(m) is not None:
                    self.remember(spec, m)
            self.set_mode(layout, spec, spec.modes[0], force=True)
        except Exception as e:
            self.log_split_error("adopt", e)

    def current_page_type(self, layout):
        base = self.base_class(layout, "SharedMediaLayout")
        page = _get_declared_field_val(layout, base, "mediaPages")[0]
        pbase = self.base_class(page, "MediaPage")
        return int(_get_declared_field_val(page, pbase, "selectedType"))

    def get_mode(self, layout, spec):
        base = self.base_class(layout, "SharedMediaLayout")
        data = _get_declared_field_val(layout, base, "sharedMediaData")[spec.data_index]
        return self.data_mode.get(JSystem.identityHashCode(data), spec.modes[0])

    def set_mode(self, layout, spec, mode, force=False):
        base = self.base_class(layout, "SharedMediaLayout")
        data = _get_declared_field_val(layout, base, "sharedMediaData")[spec.data_index]
        key = JSystem.identityHashCode(data)
        if not force and self.data_mode.get(key, spec.modes[0]) == mode:
            return

        dialog_id = int(_get_declared_field_val(layout, base, "dialog_id"))
        msgs = list(self.master[spec.key].get(dialog_id, {}).values())
        msgs.sort(key=lambda m: int(m.getId()), reverse=True)

        plan = []
        for m in msgs:
            if spec.classify(m) != mode:
                continue
            plan.append((m.monthKey, m))

        self.data_spec[key] = spec
        self.data_mode[key] = mode
        self.kick_count[key] = 0
        try:
            data.messages.clear()
            data.sections.clear()
            data.sectionArrays.clear()
            for section_key, m in plan:
                arr = data.sectionArrays.get(section_key)
                if arr is None:
                    arr = ArrayList()
                    data.sectionArrays.put(section_key, arr)
                    data.sections.add(section_key)
                arr.add(m)
                data.messages.add(m)
            self.sync_total(data)
        finally:
            try:
                adapter = _get_declared_field_val(layout, base, spec.adapter_field)
                adapter.notifyDataSetChanged()
            except Exception as e:
                self.log_split_error("adapter refresh", e)
                self.refresh_any_adapter(layout, base)
            self.schedule_kick(key)

    def refresh_any_adapter(self, layout, base):
        try:
            for page in _get_declared_field_val(layout, base, "mediaPages"):
                if page is None:
                    continue
                lv = _get_declared_field_val(page, self.base_class(page, "MediaPage"), "listView")
                adapter = lv.getAdapter()
                if adapter is not None:
                    adapter.notifyDataSetChanged()
        except Exception as e:
            self.log_split_error("refresh_any_adapter", e)

    def set_total(self, data, number):
        base = self.base_class(data, "SharedMediaData")
        f = base.getDeclaredField("totalCount")
        f.setAccessible(True)
        value = f.get(data)
        try:
            value[0] = number
        except TypeError:
            f.setInt(data, number)

    def sync_total(self, data):
        try:
            size = int(data.messages.size())
            if size > 0:
                self.set_total(data, size)
        except Exception as e:
            self.log_split_error("sync_total", e)

    def schedule_kick(self, h):
        if run_on_ui_thread is None or h in self.kick_pending:
            return
        self.kick_pending.add(h)
        try:
            run_on_ui_thread(lambda: self.do_kick(h), KICK_DELAY_MS)
        except Exception as e:
            self.kick_pending.discard(h)
            self.log_split_error("schedule_kick", e)

    def do_kick(self, h):
        self.kick_pending.discard(h)
        try:
            spec = self.data_spec.get(h)
            layout = self.last_layout
            if spec is None or layout is None or not self.is_split_on(spec):
                return
            base = self.base_class(layout, "SharedMediaLayout")
            data = _get_declared_field_val(layout, base, "sharedMediaData")[spec.data_index]
            if JSystem.identityHashCode(data) != h:
                return
            if bool(data.endReached[0]) or bool(data.loading):
                return
            if int(data.messages.size()) >= spec.min_items:
                return
            count = self.kick_count.get(h, 0)
            if count >= KICK_MAX:
                return
            page = _get_declared_field_val(layout, base, "mediaPages")[0]
            pbase = self.base_class(page, "MediaPage")
            if int(_get_declared_field_val(page, pbase, "selectedType")) != spec.base_tab:
                return
            if self.get_mode(layout, spec) != self.data_mode.get(h):
                return
            self.kick_count[h] = count + 1
            lv = _get_declared_field_val(page, pbase, "listView")
            c = lv.getClass()
            method = None
            while c is not None and method is None:
                try:
                    method = c.getDeclaredMethod("dispatchOnScrolled", Integer.TYPE, Integer.TYPE)
                except Exception:
                    c = c.getSuperclass()
            if method is None:
                return
            method.setAccessible(True)
            method.invoke(lv, Integer(0), Integer(0))
        except Exception as e:
            self.log_split_error("do_kick", e)

    def hide_options(self, layout):
        if not self.is_split_on(MEDIA):
            return
        try:
            base = self.base_class(layout, "SharedMediaLayout")
            item = _get_declared_field_val(layout, base, "photoVideoOptionsItem")
        except Exception:
            return
        if item is None:
            return
        if len(self.option_items) > 16:
            self.option_items = {}
        self.option_items[JSystem.identityHashCode(item)] = True
        try:
            item.setVisibility(VIEW_GONE)
            item.setAlpha(0.0)
            item.setScaleX(0.0)
            item.setScaleY(0.0)
            item.setEnabled(False)
            item.setClickable(False)
        except Exception as e:
            self.log_split_error("hide_options", e)

    def prepare_real_switch(self, layout):
        base = self.base_class(layout, "SharedMediaLayout")
        pages = _get_declared_field_val(layout, base, "mediaPages")
        page0, page1 = pages[0], pages[1]
        list1 = _get_declared_field_val(page1, self.base_class(page1, "MediaPage"), "listView")
        list1.setAdapter(None)
        pbase0 = self.base_class(page0, "MediaPage")
        self._restore_type = int(_get_declared_field_val(page0, pbase0, "selectedType"))
        _set_declared_int_field(page0, pbase0, "selectedType", TEMP_PAGE_TYPE)
        self._tmp_page0 = page0

    def finish_real_switch(self):
        page0 = self._tmp_page0
        self._tmp_page0 = None
        if page0 is not None:
            _set_declared_int_field(
                page0,
                self.base_class(page0, "MediaPage"),
                "selectedType",
                self._restore_type,
            )

    def layout_of_main_strip(self, strip):
        try:
            layout = _get_declared_field_val(strip, strip.getClass(), "this$0")
            base = self.base_class(layout, "SharedMediaLayout")
            if str(base.getSimpleName()) != "SharedMediaLayout":
                return None
            main = _get_declared_field_val(layout, base, "scrollSlidingTextTabStrip")
            if main is None or JSystem.identityHashCode(main) != JSystem.identityHashCode(strip):
                return None
            return layout
        except Exception:
            return None

    def detach_hidden_page(self, layout):
        base = self.base_class(layout, "SharedMediaLayout")
        page1 = _get_declared_field_val(layout, base, "mediaPages")[1]
        if int(page1.getVisibility()) == 0:
            return
        list1 = _get_declared_field_val(page1, self.base_class(page1, "MediaPage"), "listView")
        list1.setAdapter(None)

    def called_from(self, method_fragment):
        for el in JThread.currentThread().getStackTrace():
            if method_fragment in str(el.getMethodName()):
                return True
        return False

    def counter_text(self, layout):
        base = self.base_class(layout, "SharedMediaLayout")
        data = _get_declared_field_val(layout, base, "sharedMediaData")[VOICE.data_index]
        mode = self.data_mode.get(JSystem.identityHashCode(data), "voice")
        dialog_id = int(_get_declared_field_val(layout, base, "dialog_id"))
        msgs = list(self.master["voice"].get(dialog_id, {}).values())
        rounds = sum(1 for m in msgs if classify_voice(m) == "round")
        n = rounds if mode == "round" else len(msgs) - rounds
        complete = bool(data.endReached[0])

        ru = str(Locale.getDefault().getLanguage()) == "ru"
        if mode == "round":
            forms = (
                ("видеосообщение", "видеосообщения", "видеосообщений")
                if ru
                else ("video message", "video messages")
            )
        else:
            forms = (
                ("голосовое сообщение", "голосовых сообщения", "голосовых сообщений")
                if ru
                else ("voice message", "voice messages")
            )

        if not complete:
            return f"{n}+ {forms[-1]}"
        if ru:
            n10, n100 = n % 10, n % 100
            if n10 == 1 and n100 != 11:
                word = forms[0]
            elif 2 <= n10 <= 4 and not 12 <= n100 <= 14:
                word = forms[1]
            else:
                word = forms[2]
        else:
            word = forms[0] if n == 1 else forms[1]
        return f"{n} {word}"

    def _hook_split(self, class_name, method_name, handler):
        try:
            cls = find_class(class_name)
            if not cls:
                self.log_split_error("hook", f"class not found: {class_name}")
                return
            self.hook_all_methods(cls, method_name, handler)
        except Exception as e:
            self.log_split_error(f"hook {method_name}", e)