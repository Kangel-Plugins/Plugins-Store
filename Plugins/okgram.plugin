class _CallbackHook(MethodHook):
    def __init__(self, plugin, name, before=None, after=None):
        self.plugin = plugin
        self.name = name
        self._before = before
        self._after = after

    def before_hooked_method(self, param):
        if self._before is None:
            return
        try:
            self._before(param)
        except Exception:
            self.plugin.logger.exception("%s before-hook failed", self.name)

    def after_hooked_method(self, param):
        if self._after is None:
            return
        try:
            self._after(param)
        except Exception:
            self.plugin.logger.exception("%s after-hook failed", self.name)


# --------------------------------------------------------------------------
# Hook handlers: Split Tabs (voice_video_split)
# --------------------------------------------------------------------------

class UpdateTabsHook(MethodHook):
    """SharedMediaLayout.updateTabs: rebuilds the tab strip."""

    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        p = self.plugin
        if p.in_update == 0:
            p.refresh_split_flags()
        p.in_update += 1
        try:
            layout = param.thisObject
            p.last_layout = layout
            p.track_layout(layout)
            p.ensure_delegate_hooks(layout)
        except Exception as e:
            p.log_split_error("updateTabs", e)

    def after_hooked_method(self, param):
        p = self.plugin
        p.in_update = max(0, p.in_update - 1)
        try:
            p.normalize_pages(param.thisObject)
            p.hide_options(param.thisObject)
        except Exception as e:
            p.log_split_error("updateTabs (after)", e)


class AddTabHook(MethodHook):
    """ScrollSlidingTextTabStrip.addTextTab."""

    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        p = self.plugin
        try:
            if p.adding or p.in_update <= 0 or not p.is_split_on(MEDIA):
                return
            args = list(param.args or [])
            if int(args[0]) != MEDIA.base_tab:
                return
            strip = param.thisObject
            rest = args[2:]
            p.adding = True
            try:
                strip.addTextTab(MEDIA.base_tab, p.tab_title("photo"), *rest)
                if not strip.hasTab(MEDIA.alias_tab):
                    strip.addTextTab(MEDIA.alias_tab, p.tab_title("video"), *rest)
            finally:
                p.adding = False
            param.setResult(None)
        except Exception as e:
            p.adding = False
            p.log_split_error("addTextTab (before)", e)

    def after_hooked_method(self, param):
        p = self.plugin
        try:
            if p.adding or p.in_update <= 0 or not p.is_split_on(VOICE):
                return
            args = list(param.args or [])
            if int(args[0]) != VOICE.base_tab:
                return
            strip = param.thisObject
            if strip.hasTab(VOICE.alias_tab):
                return
            p.adding = True
            try:
                title = p.tab_title("round")
                if len(args) >= 3:
                    strip.addTextTab(VOICE.alias_tab, title, args[2])
                else:
                    strip.addTextTab(VOICE.alias_tab, title)
            finally:
                p.adding = False
        except Exception as e:
            p.adding = False
            p.log_split_error("addTextTab (after)", e)


class DelegateHook(MethodHook):
    """Tab strip delegate onPageSelected(id, forward): our tabs are aliases of real pages."""

    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        p = self.plugin
        if p.alias_call:
            return
        tab_id = None
        try:
            args = param.args
            tab_id = int(args[0])
            spec = p.spec_for_tab(tab_id)
            if spec is None:
                return
            p.swipe = None
            obj = param.thisObject
            layout = _get_declared_field_val(obj, obj.getClass(), "this$0")
            p.last_layout = layout
            try:
                p.track_layout(layout)
            except Exception as e:
                p.log_split_error("track_layout", e)
            same_page = p.current_page_type(layout) == spec.base_tab

            mode = spec.modes[1] if tab_id == spec.alias_tab else spec.modes[0]
            try:
                p.set_mode(layout, spec, mode)
            except Exception as e:
                p.log_split_error("set_mode", e)

            if tab_id == spec.base_tab and not same_page:
                return

            forward = bool(args[1])
            p.alias_call = True
            try:
                if same_page:
                    p.prepare_real_switch(layout)
                obj.onPageSelected(spec.base_tab, forward)
            finally:
                if same_page:
                    p.finish_real_switch()
                p.alias_call = False
            param.setResult(None)
        except Exception as e:
            p.alias_call = False
            try:
                p.finish_real_switch()
            except Exception:
                pass
            p.log_split_error("onPageSelected", e)
            if tab_id in ALIAS_TO_BASE:
                param.setResult(None)

    def after_hooked_method(self, param):
        p = self.plugin
        if p.alias_call or not p.is_split_on(MEDIA):
            return
        try:
            obj = param.thisObject
            layout = _get_declared_field_val(obj, obj.getClass(), "this$0")
            p.hide_options(layout)
        except Exception:
            pass


class ReorderGuardHook(MethodHook):
    """Our tabs must not be reordered / get an options menu."""

    def before_hooked_method(self, param):
        try:
            if int(param.args[0]) in ALIAS_TO_BASE:
                param.setResult(False)
        except Exception:
            pass


class RemapTabHook(MethodHook):
