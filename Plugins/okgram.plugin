# --------------------------------------------------------------------------
# Constants (verified against Telegram-Android master)
# --------------------------------------------------------------------------

# ImageLocation.TYPE_BIG / TYPE_SMALL. Small avatar = 160px, big = 640px.
TYPE_BIG = 0
TYPE_SMALL = 1

# The source photo_big is normally 640px. ImageLoader's power-of-two sampler
# undershoots only when the requested width is between roughly 320 and 533px.
AVATAR_FILTER_DP = 80
AVATAR_SOURCE_PX = 640
AVATAR_TARGET_SOURCE_PX = 540
# Tiny elements do not need the larger avatar file.
AVATAR_KEEP_SMALL_PX = 80

# Do not force a full-size decode for sources bigger than this (memory).
MAX_FULL_DECODE_SIDE = 1600

EMOJI_COLUMNS = 8
STICKER_COLUMNS = 5

# "w_h" or "w_h_flags": same format ImageLoader parses with split("_").
_FILTER_RE = re.compile(r"^(\d+(?:\.\d+)?)_(\d+(?:\.\d+)?)((?:_.*)?)$")

# Telegram stores the position of music this long in the "media_saved_pos" prefs.
LONG_TRACK_SECONDS = 10 * 60

# Split tabs constants
TEMP_PAGE_TYPE = 4        # harmless type (Music) shown for a moment during a real page switch
SWIPE_TIMEOUT = 4.0       # seconds a remembered swipe target stays valid
POST_SWIPE_GRACE = 1.5    # after a swipe ends, late "select tab" calls are still corrected
MAX_DIALOGS = 6           # how many chats' messages we keep per split
MAX_TRACKED = 64          # how many SharedMediaData objects we remember
KICK_DELAY_MS = 400       # delay before asking Telegram for one more page
KICK_MAX = 30             # max automatic extra pages per tab switch
VIEW_GONE = 8


# --------------------------------------------------------------------------
# Image & UI helpers (from OK UI)
# --------------------------------------------------------------------------

def _sample_size(pw: float, ph: float, wf: float, hf: float) -> int:
    """BitmapFactory inSampleSize exactly as ImageLoader picks it."""
    if wf >= hf and pw > ph:
        sf = max(pw / wf, ph / hf)
    else:
        sf = min(pw / wf, ph / hf)
    if sf < 1.2:
        sf = 1.0
    if sf > 1.0 and (pw > wf or ph > hf):
        s = 1
        while True:
            s *= 2
            if not (s * 2 < sf):
                break
        return s
    return max(1, int(sf))


def _final_width(pw: float, ph: float, wf: float, hf: float) -> float:
    """Width after ImageLoader's inSampleSize and post-decode resize."""
    width = pw / _sample_size(pw, ph, wf, hf)
    # ImageLoader.CacheOutTask scales only when decoded width is > w_filter+20.
    if width > wf + 20:
        width = wf
    return width


def fix_sampling(pw: int, ph: int, wf: float, hf: float) -> Optional[tuple]:
    """Return a larger decode filter only when Telegram undersamples width."""
    if wf <= 0 or hf <= 0 or pw <= 0 or ph <= 0:
        return None
    if pw <= wf * 0.9:
        return None  # the source itself is smaller than the requested width
    if _final_width(pw, ph, wf, hf) >= wf * 0.9:
        return None  # no meaningful upscaling would be needed
    # Keep the source aspect ratio and make ImageLoader's scale factor < 1.2,
    # which forces inSampleSize=1 for this source.
    return math.ceil(pw / 1.19), math.ceil(ph / 1.19)


def avatar_filter(flt: str, density: float) -> Optional[str]:
    """Filter for the 640px avatar photo, or None if the small one is fine."""
    m = _FILTER_RE.match(flt)
    if not m:
        return None
    w_dp, h_dp, suffix = float(m.group(1)), float(m.group(2)), m.group(3)
    if max(w_dp, h_dp) * density <= AVATAR_KEEP_SMALL_PX:
        return None
    size = int(math.ceil(max(w_dp, h_dp, AVATAR_FILTER_DP)))
    target_px = size * density
    low_risk_edge = AVATAR_SOURCE_PX / 2.0
    high_risk_edge = AVATAR_SOURCE_PX / 1.2
    if low_risk_edge < target_px < high_risk_edge:
        # Avoid the 2x decode that would leave a 320px bitmap to be enlarged.
        size = max(size, int(math.ceil(AVATAR_TARGET_SOURCE_PX / density)))
    return "%d_%d%s" % (size, size, suffix)


def sampling_filter(flt: str, pw: int, ph: int, density: float) -> Optional[str]:
    m = _FILTER_RE.match(flt)
    if not m or density <= 0:
        return None
    wf = float(m.group(1)) * density
    hf = float(m.group(2)) * density
    fixed = fix_sampling(pw, ph, wf, hf)
    if fixed is None:
        return None
    return "%d_%d%s" % (
        int(math.ceil(fixed[0] / density)),
        int(math.ceil(fixed[1] / density)),
        m.group(3),
    )


def _argc(args) -> int:
    if args is None:
        return 0
    try:
        return len(args)
    except Exception:
        try:
            return int(args.length)
        except Exception:
            return 0


def _param_names(param):
    try:
        return [t.getName() for t in param.method.getParameterTypes()]
    except Exception:
        return None


def _is_terminal_set_image(param) -> bool:
    # ImageReceiver.setImage(media, mediaFilter, image, imageFilter,
    # thumb, thumbFilter, drawable, size, ext, parentObject, cacheType).
    return _argc(param.args) == 11


def _is_static_artwork(param) -> bool:
    """getArtworkUrl(Document, boolean). The 1-arg instance method delegates to it."""
    if _argc(param.args) < 2:
        return False
    names = _param_names(param)
    if names is None:
        return True
    return len(names) >= 2 and names[1] in ("boolean", "java.lang.Boolean")


def _sig(*parts):
    if any(p is None for p in parts):
        return None
    return parts


def _primitive_alts(lang_type, marker):
    """Return primitive-signature forms without comparing Java bridge objects."""
    if lang_type is None:
        return [marker] if marker is not None else []
    if marker is None or marker is lang_type:
        return [lang_type]
    return [lang_type, marker]


def _collection_count(values) -> int:
    if values is None:
        return 0
    try:
        return int(values.size())
    except Exception:
        try:
            return len(values)
        except Exception:
            try:
                return int(values.length)
            except Exception:
                return 0


def _collection_item(values, index):
    try:
        return values.get(index)
    except Exception:
        return values[index]


def _valid_dimensions(size) -> Optional[tuple]:
    if size is None:
        return None
    try:
        width, height = int(size.w), int(size.h)
        if width > 0 and height > 0:
            return width, height
    except Exception:
        pass
    return None


def _dimensions_from_sizes(location, owner, collection_name) -> Optional[tuple]:
    """Find the PhotoSize selected by ImageLocation.thumbSize/location."""
    if owner is None:
        return None
    try:
        sizes = getattr(owner, collection_name)
    except Exception:
        return None
    count = _collection_count(sizes)
    if count <= 0:
        return None

    try:
        preferred_type = location.thumbSize
    except Exception:
        preferred_type = None
    try:
        target_location = location.location
    except Exception:
        target_location = None

    fallback = None
    for i in range(count):
        try:
            candidate = _collection_item(sizes, i)
        except Exception:
            continue
        dims = _valid_dimensions(candidate)
        if dims is None:
            continue

        if preferred_type is not None:
            try:
                if str(candidate.type) == str(preferred_type):
                    return dims
            except Exception:
                pass

        if target_location is not None:
            try:
                candidate_location = candidate.location
                if (
                    candidate_location is not None
                    and int(candidate_location.volume_id) == int(target_location.volume_id)
                    and int(candidate_location.local_id) == int(target_location.local_id)
                ):
                    return dims
            except Exception:
                pass

        if fallback is None or dims[0] * dims[1] > fallback[0] * fallback[1]:
            fallback = dims

    if preferred_type is not None or target_location is not None:
        return None
    return fallback


def image_dimensions(location) -> Optional[tuple]:
    """Resolve image dimensions across Telegram's photo and document sources."""
    try:
        dims = _valid_dimensions(location.photoSize)
        if dims is not None:
            return dims
    except Exception:
        pass

    try:
        photo = location.photo
    except Exception:
        photo = None
    dims = _dimensions_from_sizes(location, photo, "sizes")
    if dims is not None:
        return dims

    try:
        document = location.document
    except Exception:
        document = None
    return _dimensions_from_sizes(location, document, "thumbs")


def _largest_photo_size(photo):
    """Return the largest downloadable PhotoSize in a TLRPC.Photo."""
    if photo is None:
        return None
    try:
        sizes = photo.sizes
    except Exception:
        return None
    best = None
    best_area = 0
    for i in range(_collection_count(sizes)):
        try:
            candidate = _collection_item(sizes, i)
            dims = _valid_dimensions(candidate)
            if dims is None or candidate.location is None:
                continue
            area = dims[0] * dims[1]
            if area > best_area:
                best = candidate
                best_area = area
        except Exception:
            continue
    return best


def _avatar_preview_location(account: int, parent):
    """Use the largest full-profile photo in AvatarPreviewer, not photo_big."""
    if parent is None:
        return None
    try:
        class_name = str(parent.getClass().getName()).lower()
        object_id = int(parent.id)
        controller = MessagesController.getInstance(account)
        photos = []
        if "user" in class_name:
            full = controller.getUserFull(object_id)
            if full is not None:
                for field in ("profile_photo", "personal_photo", "fallback_photo"):
                    try:
                        photo = getattr(full, field)
                    except Exception:
                        photo = None
                    if photo is not None:
                        photos.append(photo)
        elif "chat" in class_name or "channel" in class_name:
            full = controller.getChatFull(object_id)
            if full is not None:
                try:
                    photo = full.chat_photo
                except Exception:
                    photo = None
                if photo is not None:
                    photos.append(photo)
        for photo in photos:
            size = _largest_photo_size(photo)
            if size is not None:
                location = ImageLocation.getForPhoto(size, photo)
                if location is not None:
                    return location
    except Exception:
        return None
    return None


# --------------------------------------------------------------------------
# Playlist helpers (from OK Playlists)
# --------------------------------------------------------------------------

def _int(x, default=0) -> int:
    try:
        return int(x)
    except Exception:
        pass
    try:
        return int(x.longValue())
    except Exception:
        pass
    try:
        return int(x.intValue())
    except Exception:
        return default


def _float(x, default=0.0) -> float:
    try:
        return float(x)
    except Exception:
        pass
    try:
        return float(x.floatValue())
    except Exception:
        return default


def _bool(x) -> bool:
    try:
        return bool(x.booleanValue())
    except Exception:
        return bool(x)


def _is_bool_arg(x) -> bool:
    return isinstance(x, bool) or hasattr(x, "booleanValue")


def _same_message(a, b) -> bool:
    if a is None or b is None:
        return False
    return (
        _int(a.getDialogId()) == _int(b.getDialogId())
        and _int(a.getId()) == _int(b.getId())
        and (_int(a.eventId) == 0) == (_int(b.eventId) == 0)
    )


def _reset_progress(msg) -> None:
    if msg is None:
        return
    try:
        msg.resetPlayingProgress()
    except Exception:
        try:
            msg.audioProgress = 0.0
            msg.audioProgressSec = 0
        except Exception:
            pass
    try:
        msg.audioProgressMs = 0
    except Exception:
        pass
    try:
        msg.forceSeekTo = -1.0
    except Exception:
        pass


def _file_name(msg) -> str:
    try:
        name = msg.getFileName()
        return name or ""
    except Exception:
        return ""


def _is_music(msg) -> bool:
    try:
        return msg is not None and _bool(msg.isMusic())
    except Exception:
        return False


def _is_long(msg) -> bool:
    try:
        return _int(msg.getDuration()) >= LONG_TRACK_SECONDS
    except Exception:
        return True


def _set_field(obj, name, *candidates) -> bool:
    """set_private_field with typed fallbacks (jfloat/jint for primitive fields)."""
    for value in candidates:
        try:
            if set_private_field(obj, name, value) is not False:
                return True
        except Exception:
            pass
    return False


def _forget_saved_position(msg) -> None:
    """Drop the 'resume long audio' position Telegram keeps in SharedPreferences."""
    if msg is None or not _is_long(msg):
        return
    try:
        name = _file_name(msg)
        if not name:
            return
        prefs = ApplicationLoader.applicationContext.getSharedPreferences("media_saved_pos", 0)
        if prefs.contains(name):
            prefs.edit().remove(name).apply()
    except Exception:
        pass


def _topic_of(msg) -> Optional[int]:
    """Topic id of a message. General topic is 1."""
    if msg is None:
        return None
    try:
        tid = _int(msg.getTopicId())
        if tid:
            return tid
    except Exception:
        pass
    try:
        tid = _int(MessageObject.getTopicId(msg.currentAccount, msg.messageOwner, True))
        if tid:
            return tid
    except Exception:
        pass
    try:
        owner = msg.messageOwner
        if owner is not None and owner.action is not None:
            if "TopicCreate" in type(owner.action).__name__:
                return _int(msg.getId()) or 1
        reply = owner.reply_to if owner is not None else None
        if reply is not None and _bool(getattr(reply, "forum_topic", False)):
            return _int(reply.reply_to_top_id) or _int(reply.reply_to_msg_id) or 1
        return 1
    except Exception:
        return None


def _topic_from_open_chat(dialog_id, account) -> Optional[int]:
    """Topic id of the currently open ChatActivity, if it is this dialog AND this account."""
    try:
        frag = get_last_fragment()
        if frag is None:
            return None
        acc = _int(account, -1)
        try:
            frag_acc = _int(frag.getCurrentAccount(), -1)
            if acc >= 0 and frag_acc >= 0 and frag_acc != acc:
                return None
        except Exception:
            pass
        frag_did = 0
        try:
            frag_did = _int(frag.getDialogId())
        except Exception:
            frag_did = _int(get_private_field(frag, "dialogId"), 0)
        if not frag_did or frag_did != _int(dialog_id):
            return None
        try:
            tid = _int(frag.getTopicId())
            if tid:
                return tid
        except Exception:
            pass
        tid = _int(get_private_field(frag, "threadMessageId"), 0)
        return tid or None
    except Exception:
        return None


def _is_forum(account, dialog_id) -> bool:
    try:
        return bool(MessagesController.getInstance(account).isForum(dialog_id))
    except Exception:
        return False


def _list_size(lst) -> int:
    if lst is None:
        return 0
    try:
        return lst.size()
    except Exception:
        try:
            return len(lst)
        except Exception:
            return 0


def _list_get(lst, index):
    try:
        return lst.get(index)
    except Exception:
        return lst[index]


def _filter_list_for_topic(lst, dialog_id, topic) -> int:
    """Keep messages of this dialog+topic (and other dialogs, e.g. merged)."""
    if lst is None:
        return 0
    kept = []
    removed = 0
    for i in range(_list_size(lst)):
        try:
            msg = _list_get(lst, i)
        except Exception:
            continue
        if msg is None:
            continue
        try:
            if _int(msg.getDialogId()) != dialog_id:
                kept.append(msg)
                continue
        except Exception:
            kept.append(msg)
            continue
        t = _topic_of(msg)
        if t is None or t == topic:
            kept.append(msg)
        else:
            removed += 1
    if removed:
        try:
            lst.clear()
            for msg in kept:
                lst.add(msg)
        except Exception:
            pass
    return removed


def _is_unfiltered_playlist(args) -> bool:
    """Global-search playlists and loadMusic=False calls are not topic playlists."""
    if len(args) >= 5 and args[4] is not None:
        return True
    if len(args) >= 4:
        a3 = args[3]
        if _is_bool_arg(a3):
            return not _bool(a3)
        return a3 is not None
    return False


def _as_class(obj):
    """find_class() already returns Class; imported Java types need .class_ / getClass()."""
    if obj is None:
        return None
    try:
        if hasattr(obj, "getDeclaredMethod") and hasattr(obj, "getName"):
            name = obj.getName()
            if isinstance(name, str) and "." in name:
                return obj
    except Exception:
        pass
    for attr in ("class_", "CLASS"):
        c = getattr(obj, attr, None)
        if c is not None:
            return c
    try:
        return obj.getClass()
    except Exception:
        return obj


# --------------------------------------------------------------------------
# Split Tabs definitions (from voice_video_split)
# --------------------------------------------------------------------------

def _safe_msg_flag(msg, name):
    try:
        return bool(getattr(msg, name)())
    except Exception:
        return False


def classify_voice(msg):
    if _safe_msg_flag(msg, "isRoundVideo"):
        return "round"
    if _safe_msg_flag(msg, "isVoice"):
        return "voice"
    return None


def classify_media(msg):
    return "video" if _safe_msg_flag(msg, "isVideo") else "photo"


class Spec:
    """One split: a real Telegram tab (base) plus our alias tab sharing the same page."""

    def __init__(self, key, base_tab, alias_tab, data_index, adapter_field, modes, classify, min_items):
        self.key = key
        self.base_tab = base_tab
        self.alias_tab = alias_tab
        self.data_index = data_index
        self.adapter_field = adapter_field
        self.modes = modes
        self.classify = classify
        self.min_items = min_items


VOICE = Spec("voice", 2, 100, 2, "voiceAdapter", ("voice", "round"), classify_voice, 20)
MEDIA = Spec("media", 0, 101, 0, "photoVideoAdapter", ("photo", "video"), classify_media, 60)
SPECS = (VOICE, MEDIA)
ALIAS_TO_BASE = {VOICE.alias_tab: VOICE.base_tab, MEDIA.alias_tab: MEDIA.base_tab}

TITLES = {
    "photo": ("Фото", "Photos"),
    "video": ("Видео", "Videos"),
    "round": ("Видеосообщения", "Video Messages"),
}


def _get_declared_field_val(obj, cls, name):
    f = cls.getDeclaredField(name)
    f.setAccessible(True)
    return f.get(obj)


def _set_declared_int_field(obj, cls, name, value):
    f = cls.getDeclaredField(name)
    f.setAccessible(True)
    f.setInt(obj, value)


# --------------------------------------------------------------------------
# Hook handlers: OK UI
# --------------------------------------------------------------------------

class _GuardedHook(MethodHook):
    """Never lets an exception escape into Telegram code."""

    def __init__(self, plugin: "OkGramPlugin", name: str):
        self.plugin = plugin
        self.name = name
        self._failed = False

    def _fail(self):
        if not self._failed:
            self._failed = True
            self.plugin.logger.exception("OkGram: %s hook failed", self.name)

    def before_hooked_method(self, param):
        try:
            self.before(param)
        except Exception:
            self._fail()

    def after_hooked_method(self, param):
        try:
            self.after(param)
        except Exception:
            self._fail()

    def before(self, param):
        pass

    def after(self, param):
        pass


class SetImageHook(_GuardedHook):
    """ImageReceiver.setImage(media, mediaFilter, image, filter, thumb, ...)."""

    def _upgrade_avatar(self, receiver, loc, flt, parent, density):
        if loc is None or not flt:
            return None
        try:
            if loc.photoPeer is None:
                return None
            photo_type = int(loc.photoPeerType)
        except Exception:
            return None
        if photo_type not in (TYPE_SMALL, TYPE_BIG):
            return None
        new_filter = avatar_filter(flt, density)
        if new_filter is None:
            return None
        if photo_type == TYPE_SMALL:
            peer = parent if parent is not None else loc.photoPeer
            if peer is None:
                return None
            try:
                big = ImageLocation.getForUserOrChat(
                    int(receiver.getCurrentAccount()), peer, TYPE_BIG
                )
            except Exception:
                return None
            if big is None:
                return None
            return big, new_filter
        return loc, new_filter

    def before(self, param):
        p = self.plugin
        if not p.opt_images or not _is_terminal_set_image(param):
            return
        args = param.args
        density = float(AndroidUtilities.density)
        parent = args[9]

        # Upgrade thumbLocation/thumbFilter as well so transitions (e.g. clicking an
        # avatar in an open chat to open ProfileActivity) hit the cached photo_big
        # instead of falling back to AvatarDrawable (text avatar) during animation.
        thumb_loc = args[4]
        thumb_flt = args[5]
        upgraded_thumb = self._upgrade_avatar(param.thisObject, thumb_loc, thumb_flt, parent, density)
        if upgraded_thumb is not None:
            args[4], args[5] = upgraded_thumb

        loc = args[2]
        flt = args[3]
        if loc is None or not flt:
            return

        # Chat/user avatars: upgrade small photos to photo_big and enlarge the
        # decode filter for both TYPE_SMALL and already-large avatar requests.
        if loc.photoPeer is not None:
            upgraded = self._upgrade_avatar(param.thisObject, loc, flt, parent, density)
            if upgraded is not None:
                args[2], args[3] = upgraded
            return

        # Everything else: plain photo-size images with known dimensions.
        if int(loc.imageType) != 0:
            return
        dimensions = image_dimensions(loc)
        if dimensions is None:
            return
        pw, ph = dimensions
        if pw <= 0 or ph <= 0 or max(pw, ph) > MAX_FULL_DECODE_SIDE:
            return
        new_filter = sampling_filter(flt, pw, ph, density)
        if new_filter is not None:
            args[3] = new_filter


class AvatarPreviewHook(_GuardedHook):
    """AvatarPreviewer passes TYPE_BIG with a null filter; use the max profile size."""

    def before(self, param):
        p = self.plugin
        args = param.args
        if not p.opt_images or _argc(args) != 9:
            return
        if args[4] is not None:
            return
        location = args[3]
        if location is None:
            return
        try:
            if location.photoPeer is None or int(location.photoPeerType) != TYPE_BIG:
                return
        except Exception:
            return
        best = _avatar_preview_location(int(args[0]), args[8])
        if best is not None:
            args[3] = best


class ArtworkHook(_GuardedHook):
    """MessageObject.getArtworkUrl(document, small): 100px -> 600px cover."""

    def before(self, param):
        if self.plugin.opt_images and _is_static_artwork(param):
            param.args[1] = jboolean(False)


class StatusRepeatHook(_GuardedHook):
    """AnimatedEmojiDrawable.updateAutoRepeat(receiver) sets repeat count 2."""

    def after(self, param):
        p = self.plugin
        if not p.opt_status:
            return
        cache_type = get_private_field(param.thisObject, "cacheType")
        if cache_type is not None and int(cache_type) in p.status_cache_types:
            param.args[0].setAutoRepeatCount(-1)


class EmojiMeasureHook(_GuardedHook):
    """Track execution of EmojiGridView.onMeasure on the current UI thread."""

    def before(self, param):
        p = self.plugin
        if not p.opt_emoji:
            return
        if p.emoji_measure_depth == 0:
            p.emoji_measure_thread = int(JThread.currentThread().getId())
        p.emoji_measure_depth += 1

    def after(self, param):
        p = self.plugin
        if p.emoji_measure_depth > 0:
            p.emoji_measure_depth -= 1
        if p.emoji_measure_depth == 0:
            p.emoji_measure_thread = 0


class SpanCountHook(_GuardedHook):
    """Override the count Telegram calculates inside EmojiGridView.onMeasure."""

    def _inside_emoji_measure(self, plugin) -> bool:
        try:
            current_thread = int(JThread.currentThread().getId())
            if (
                plugin.emoji_measure_depth > 0
                and plugin.emoji_measure_thread == current_thread
            ):
                return True
        except Exception:
            pass

        try:
            for frame in JThread.currentThread().getStackTrace():
                if (
                    str(frame.getMethodName()) == "onMeasure"
                    and str(frame.getClassName()).endswith("$EmojiGridView")
                ):
                    return True
        except Exception:
            pass
        return False

    def before(self, param):
        p = self.plugin
        if p.opt_emoji and self._inside_emoji_measure(p):
            param.args[0] = jint(EMOJI_COLUMNS)


class StickersUpdateHook(_GuardedHook):
    """Scale density briefly during StickersGridAdapter.updateItems for 5 columns."""

    def before(self, param):
        p = self.plugin
        if not p.opt_stickers:
            return
        if p.density_depth == 0:
            outer = get_private_field(param.thisObject, "this$0")
            if outer is None:
                return
            width = int(outer.getMeasuredWidth())
            if width == 0:
                width = int(AndroidUtilities.displaySize.x)
            if width <= 0:
                return
            p.saved_density = float(AndroidUtilities.density)
            AndroidUtilities.density = width / (72.0 * (STICKER_COLUMNS + 0.5))
        p.density_depth += 1

    def after(self, param):
        self.plugin.restore_density()


