__id__ = "stickerpack_author_fix"
__name__ = "StickerPack Author Fix"
__description__ = "Открывает профиль автора стикерпака по нажатию на «Владелец» вместо копирования ID."
__author__ = "@k9s1_plugins"
__version__ = "1.0"
__icon__ = "msg_openprofile"
__min_version__ = "11.12.0"

import traceback
from base_plugin import BasePlugin, MethodHook
from client_utils import (
    get_last_fragment,
    get_messages_controller,
    get_messages_storage,
)
from android_utils import run_on_ui_thread
from hook_utils import find_class, get_private_field
from ui.bulletin import BulletinHelper
from ui.settings import Header, Divider

STUB_NAME = "Не удалось открыть профиль"


class _ClipboardHook(MethodHook):
    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin

    def before_hooked_method(self, param):
        self.plugin._on_add_to_clipboard(param)


class StickerPackAuthorFixPlugin(BasePlugin):

    def on_plugin_load(self):
        AndroidUtilities = find_class("org.telegram.messenger.AndroidUtilities")
        if AndroidUtilities is not None:
            self.hook_all_methods(
                AndroidUtilities,
                "addToClipboard",
                _ClipboardHook(self)
            )

    def create_settings(self):
        return [
            Header(text="Ограничения Telegram"),
            Divider(
                text="В стикерпаке хранится только числовой ID автора. "
                     "По правилам безопасности Telegram сервер отдаёт профиль по ID только тогда, "
                     "когда ваш аккаунт уже хотя бы раз «видел» этого человека "
                     "(в общих чатах, комментариях или личных сообщениях).\n\n"
                     "Если вы никогда не пересекались с автором и его нет в кэше телефона, "
                     "откроется карточка «Не удалось открыть профиль», а ID автоматически скопируется в буфер обмена."
            ),
        ]

    def _on_add_to_clipboard(self, param):
        try:
            if not param.args or param.args[0] is None:
                return

            text = str(param.args[0]).strip()
            if not text.isdigit():
                return

            Throwable = find_class("java.lang.Throwable")
            if Throwable is None:
                return

            from_stickers_alert = False
            for element in Throwable().getStackTrace():
                if "StickersAlert" in str(element.getClassName()):
                    from_stickers_alert = True
                    break

            if not from_stickers_alert:
                return

            user_id = int(text)
            if user_id <= 0:
                return

            # Отменяем стандартное копирование ID
            param.setResult(None)

            run_on_ui_thread(lambda: self._open_owner_profile(user_id))

        except Exception:
            self.log(f"Ошибка при перехвате клика: {traceback.format_exc()}")

    def _find_user_anywhere(self, user_id: int):
        """Ищет пользователя в ОЗУ и локальной базе данных всех авторизованных аккаунтов."""
        mc = get_messages_controller()
        ms = get_messages_storage()

        # 1. Проверяем оперативную память текущего аккаунта
        user = mc.getUser(user_id)
        if user is not None and getattr(user, "access_hash", 0) != 0 and getattr(user, "first_name", "") != STUB_NAME:
            return user

        # 2. Проверяем локальную базу данных телефона (SQLite)
        if ms is not None:
            try:
                db_user = ms.getUser(user_id)
                if db_user is not None and getattr(db_user, "access_hash", 0) != 0:
                    mc.putUser(db_user, True)
                    return db_user
            except Exception:
                pass

        # 3. Проверяем соседние аккаунты в клиенте
        UserConfig = find_class("org.telegram.messenger.UserConfig")
        max_accounts = getattr(UserConfig, "MAX_ACCOUNT_COUNT", 4) if UserConfig else 4

        for acc in range(max_accounts):
            try:
                AccountInstance = find_class("org.telegram.messenger.AccountInstance")
                if AccountInstance is None:
                    break
                instance = AccountInstance.getInstance(acc)
                if instance is None:
                    continue

                other_mc = instance.getMessagesController()
                if other_mc is not None:
                    u = other_mc.getUser(user_id)
                    if u is not None and getattr(u, "access_hash", 0) != 0 and getattr(u, "first_name", "") != STUB_NAME:
                        mc.putUser(u, False)
                        return u

                other_ms = instance.getMessagesStorage()
                if other_ms is not None:
                    u = other_ms.getUser(user_id)
                    if u is not None and getattr(u, "access_hash", 0) != 0:
                        mc.putUser(u, False)
                        return u
            except Exception:
                pass

        return None

    def _open_owner_profile(self, user_id: int):
        try:
            fragment = get_last_fragment()
            if fragment is None:
                return

            # Закрываем окно стикерпака (StickersAlert)
            visible_dialog = get_private_field(fragment, "visibleDialog")
            if visible_dialog is not None and "StickersAlert" in str(visible_dialog.getClass().getName()):
                parent_from_dialog = get_private_field(visible_dialog, "parentFragment")
                if parent_from_dialog is not None:
                    fragment = parent_from_dialog
                try:
                    visible_dialog.dismiss()
                except Exception:
                    pass

            mc = get_messages_controller()
            user = self._find_user_anywhere(user_id)
            is_stub = False

            # Если пользователя нет в базах — ставим заглушку
            if user is None:
                TL_user = find_class("org.telegram.tgnet.TLRPC$TL_user")
                if TL_user is not None:
                    user = TL_user()
                    user.id = user_id
                    user.first_name = STUB_NAME
                    user.access_hash = 0
                    mc.putUser(user, False)
                    is_stub = True

            Bundle = find_class("android.os.Bundle")
            ProfileActivity = find_class("org.telegram.ui.ProfileActivity")
            if Bundle is None or ProfileActivity is None:
                return

            args = Bundle()
            args.putLong("user_id", user_id)

            if not fragment.presentFragment(ProfileActivity(args)):
                run_on_ui_thread(lambda: fragment.presentFragment(ProfileActivity(args)), 150)

            # Если открыта заглушка, через 600 мс копируем ID и показываем плашку внизу
            if is_stub:
                run_on_ui_thread(lambda: self._notify_if_stub(user_id), 600)

        except Exception:
            self.log(f"Ошибка при открытии профиля {user_id}: {traceback.format_exc()}")

    def _notify_if_stub(self, user_id: int):
        try:
            mc = get_messages_controller()
            user = mc.getUser(user_id)
            if user is not None and str(getattr(user, "first_name", "")) == STUB_NAME:
                ApplicationLoader = find_class("org.telegram.messenger.ApplicationLoader")
                ClipData = find_class("android.content.ClipData")
                if ApplicationLoader is not None and ClipData is not None:
                    context = ApplicationLoader.applicationContext
                    clipboard = context.getSystemService("clipboard")
                    if clipboard is not None:
                        clipboard.setPrimaryClip(ClipData.newPlainText("exteraGram", str(user_id)))

                BulletinHelper.show_info(f"Профиль скрыт ограничениями Telegram. ID {user_id} скопирован")
        except Exception:
            pass