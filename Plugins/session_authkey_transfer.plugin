def _lang():
    try:
        from org.telegram.messenger import LocaleController
        code = str(LocaleController.getInstance().getCurrentLocale().getLanguage() or "")
        return "ru" if code.lower().startswith("ru") else "en"
    except Exception:
        return "ru"


def _t(key):
    table = RU if _lang() == "ru" else EN
    return table.get(key, EN.get(key, key))


def _err(e):
    text = str(e or "").strip()
    return text or _t("unknown")


def _button_id(name):
    try:
        return int(getattr(AlertDialogBuilder, name))
    except Exception:
        return {"BUTTON_POSITIVE": -1, "BUTTON_NEGATIVE": -2,
                "BUTTON_NEUTRAL": -3}.get(name, -1)


def _red_button(builder, which=None):
    which = _button_id("BUTTON_POSITIVE") if which is None else int(which)
    try:
        builder.make_button_red(which)
    except Exception:
        pass
    try:
        button = builder.get_button(which)
        if button is None:
            return
        from java import jclass
        theme = jclass("org.telegram.ui.ActionBar.Theme")
        try:
            color = theme.getColor(theme.key_text_RedBold)
        except Exception:
            from java import jint
            color = jint(0xFFE53935, truncate=True)
        button.setTextColor(color)
    except Exception:
        pass


def _run_ui(func, delay=0):
    try:
        from android_utils import run_on_ui_thread
        run_on_ui_thread(func, delay)
        return True
    except Exception:
        return False


def _u32(value):
    return struct.pack("<I", int(value) & 0xFFFFFFFF)


def _i32(value):
    return struct.pack("<i", int(value))


def _i64(value):
    return struct.pack("<q", int(value))


def _bool(value):
    return _u32(0x997275B5 if value else 0xBC799737)


def _string(value):
    data = value.encode("utf-8") if isinstance(value, str) else bytes(value)
    size = len(data)
    if size < 254:
        head = bytes((size,))
    else:
        head = bytes((254, size & 0xFF, (size >> 8) & 0xFF, (size >> 16) & 0xFF))
    pad = (-(size + len(head))) % 4
    return head + data + b"\x00" * pad


class _Reader(object):
    def __init__(self, data):
        self.data = data
        self.pos = 0

    def take(self, size):
        size = int(size)
        if size < 0 or self.pos + size > len(self.data):
            raise ValueError("truncated buffer")
        chunk = self.data[self.pos:self.pos + size]
        self.pos += size
        return chunk

    def u32(self):
        return struct.unpack("<I", self.take(4))[0]

    def i32(self):
        return struct.unpack("<i", self.take(4))[0]

    def i64(self):
        return struct.unpack("<q", self.take(8))[0]

    def boolean(self):
        value = self.u32()
        if value == 0x997275B5:
            return True
        if value == 0xBC799737:
            return False
        raise ValueError("invalid bool constructor")

    def string(self):
        size = self.take(1)[0]
        marker = 1
        if size >= 254:
            extra = self.take(3)
            size = extra[0] | (extra[1] << 8) | (extra[2] << 16)
            marker = 4
        pad = (-(size + marker)) % 4
        raw = self.take(size + pad)
        return raw[:size].decode("utf-8", "replace")


def _parse_datacenter(reader):
    version = reader.u32()
    if version < 2 or version > 13:
        raise ValueError("unsupported dc block version %d" % version)

    dc_id = reader.u32()
    if version >= 3:
        reader.u32()
    if version >= 10:
        reader.u32()

    for _ in range(4 if version >= 5 else 1):
        count = reader.u32()
        for _ in range(count):
            reader.string()
            reader.u32()
            if version >= 7:
                reader.i32()
            if version >= 11:
                reader.string()
            elif version >= 9:
                reader.string()

    if version >= 6:
        reader.boolean()

    key_size = reader.u32()
    key = reader.take(key_size) if key_size else None

    key_id = 0
    if version >= 4:
        key_id = reader.i64()
    else:
        legacy_size = reader.u32()
        if legacy_size:
            key_id = reader.i64()

    if version >= 8:
        temp_size = reader.u32()
        if temp_size:
            reader.take(temp_size)
        reader.i64()

    if version >= 12:
        media_size = reader.u32()
        if media_size:
            reader.take(media_size)
        reader.i64()

    reader.i32()

    count = reader.u32()
    for _ in range(count):
        reader.i32()
        reader.i32()
        reader.i64()

    if version >= 13:
        count = reader.u32()
        for _ in range(count):
            reader.i32()
            reader.i32()
            reader.i64()

    return {"id": dc_id, "key": key, "key_id": key_id}


def _parse_tgnet(data):
    if len(data) < 4:
        raise ValueError("empty config")
    size = struct.unpack("<I", data[:4])[0]
    if size < 1 or 4 + size > len(data):
        raise ValueError("bad config size %d" % size)
    reader = _Reader(data[4:4 + size])
    version = reader.u32()
    if version > 5:
        raise ValueError("unsupported tgnet version %d" % version)

    reader.boolean()
    if version >= 3:
        reader.boolean()
    if version >= 4:
        reader.string()

    current_dc = 0
    datacenters = {}
    if reader.boolean():
        current_dc = reader.u32()
        reader.i32()
        reader.i32()
        reader.i64()
        if version >= 2:
            reader.boolean()
        if version >= 5:
            reader.i32()
        count = reader.u32()
        reader.take(8 * count)
        count = reader.u32()
        for _ in range(count):
            block = _parse_datacenter(reader)
            datacenters[block["id"]] = block

    return {"version": version, "current_dc": current_dc, "datacenters": datacenters}


def _build_datacenter(dc_id, key, key_id):
    ipv4, ipv6 = _DC_ADDRESSES.get(int(dc_id), ([], []))
    out = bytearray()
    out += _i32(13)
    out += _i32(dc_id)
    out += _i32(0)
    out += _i32(0)

    for addresses, flags in ((ipv4, 0), (ipv6, 1), (ipv4, 0), (ipv6, 1)):
        out += _i32(len(addresses))
        for address in addresses:
            out += _string(address)
            out += _i32(443)
            out += _i32(flags)
            out += _string("")

    out += _bool(False)
    out += _i32(len(key))
    out += bytes(key)
    out += _i64(key_id)
    out += _i32(0)
    out += _i64(0)
    out += _i32(0)
    out += _i64(0)
    out += _i32(1)
    out += _i32(0)
    out += _i32(0)
    return bytes(out)


def _build_tgnet(dc_id, key, key_id):
    system_lang = "en"
    try:
        from org.telegram.messenger import LocaleController
        code = str(LocaleController.getSystemLocaleStringIso639() or "").lower()
        if code:
            system_lang = code.split("-")[0]
    except Exception:
        pass

    push_session = int.from_bytes(os.urandom(8), "little", signed=True)
    body = bytearray()
    body += _i32(5)
    body += _bool(False)
    body += _bool(False)
    body += _string(system_lang)
    body += _bool(True)
    body += _i32(dc_id)
    body += _i32(0)
    body += _i32(0)
    body += _i64(push_session)
    body += _bool(False)
    body += _i32(int(time.time()))
    body += _i32(0)
    body += _i32(1)
    body += _build_datacenter(dc_id, key, key_id)
    return _u32(len(body)) + bytes(body)


def _pack_token(dc_id, key, key_id, user_id, user_blob, name):
    body = bytearray()
    body += TOKEN_MAGIC
    body += bytes((TOKEN_VERSION, int(dc_id) & 0xFF))
    body += _i64(user_id)
    body += _i64(key_id)
    body += struct.pack("<H", len(key))
    body += bytes(key)
    body += struct.pack("<H", len(user_blob))
    body += bytes(user_blob)
    name_bytes = str(name or "").encode("utf-8")[:96]
    body += struct.pack("<H", len(name_bytes))
    body += name_bytes
    body += _u32(zlib.crc32(bytes(body)) & 0xFFFFFFFF)
    return TOKEN_PREFIX + base64.b64encode(bytes(body)).decode("ascii")


def _decode_token(raw):
    text = str(raw or "").strip()
    marker = text.find(TOKEN_PREFIX)
    if marker >= 0:
        text = text[marker + len(TOKEN_PREFIX):]
        for separator in ("\n", "\r", "\t", " "):
            text = text.split(separator, 1)[0]
    text = "".join(text.split())
    if not text:
        raise ValueError("empty token")

    text = text.replace("-", "+").replace("_", "/")
    text += "=" * (-len(text) % 4)
    data = base64.b64decode(text)
    if len(data) < 8 or data[:4] != TOKEN_MAGIC:
        raise ValueError("bad magic")
    if data[4] != TOKEN_VERSION:
        raise ValueError("unsupported token version %d" % data[4])

    crc = struct.unpack("<I", data[-4:])[0]
    if (zlib.crc32(data[:-4]) & 0xFFFFFFFF) != crc:
        raise ValueError("crc mismatch")

    reader = _Reader(data[:-4])
    reader.take(4)
    reader.take(1)
    dc_id = reader.take(1)[0]
    user_id = reader.i64()
    key_id = reader.i64()
    key_size = struct.unpack("<H", reader.take(2))[0]
    key = reader.take(key_size)
    user_size = struct.unpack("<H", reader.take(2))[0]
    user_blob = reader.take(user_size)
    name_size = struct.unpack("<H", reader.take(2))[0]
    name = reader.take(name_size).decode("utf-8", "replace")

    if dc_id < 1 or dc_id > 5:
        raise ValueError("bad dc id %d" % dc_id)
    if len(key) != 256:
        raise ValueError("bad key length %d" % len(key))
    if not user_blob:
        raise ValueError("empty user data")

    computed = int.from_bytes(hashlib.sha1(key).digest()[12:20], "little", signed=True)
    if computed != key_id:
        raise ValueError("key id mismatch")

    return {
        "dc": dc_id,
        "user_id": user_id,
        "key": key,
        "key_id": key_id,
        "user_blob": user_blob,
        "name": name,
    }


def _activity():
    fragment = None
    try:
        from client_utils import get_last_fragment
        fragment = get_last_fragment()
    except Exception:
        fragment = None
    if fragment is None:
        try:
            from java import jclass
            fragment = jclass("org.telegram.ui.LaunchActivity").getLastFragment()
        except Exception:
            fragment = None
    if fragment is not None:
        try:
            activity = fragment.getParentActivity()
            if activity is not None:
                return activity
        except Exception:
            pass
        try:
            context = fragment.getContext()
            if context is not None:
                return context
        except Exception:
            pass
    raise RuntimeError("no activity")


def _context():
    try:
        return _activity()
    except Exception:
        from java import jclass
        context = jclass("org.telegram.messenger.ApplicationLoader").applicationContext
        if context is None:
            raise RuntimeError("no context")
        return context


def _files_dir():
    from java import jclass
    loader = jclass("org.telegram.messenger.ApplicationLoader")
    try:
        fixed = loader.getFilesDirFixed()
        if fixed is not None:
            path = str(fixed.getAbsolutePath())
            if path:
                return path
    except Exception:
        pass
    context = loader.applicationContext
    if context is None:
        raise RuntimeError("files directory is unavailable")
    path = context.getFilesDir()
    if path is None:
        raise RuntimeError("files directory is unavailable")
    return str(path.getAbsolutePath())


def _slot_dir(account):
    base = _files_dir()
    account = int(account)
    return base if account == 0 else os.path.join(base, "account%d" % account)


def _tgnet_path(account):
    return os.path.join(_slot_dir(account), "tgnet.dat")


def _prefs(account):
    name = "userconfing" if int(account) == 0 else "userconfig%d" % int(account)
    return _context().getSharedPreferences(name, 0)


def _serialize_user(user):
    from java import jclass
    serialized = jclass("org.telegram.tgnet.SerializedData")()
    try:
        user.serializeToStream(serialized)
        raw = serialized.toByteArray()
        try:
            return bytes(raw)
        except Exception:
            return bytes(bytearray(raw))
    finally:
        try:
            serialized.cleanup()
        except Exception:
            pass


def _read_user_blob(account):
    try:
        stored = _prefs(account).getString("user", None)
    except Exception:
        stored = None
    if stored:
        return base64.b64decode(str(stored))
    user = get_user_config(account).getCurrentUser()
    if user is None:
        raise RuntimeError(_t("err_user"))
    return _serialize_user(user)


def _deserialize_user(blob):
    from java import jclass
    serialized = jclass("org.telegram.tgnet.SerializedData")(bytes(blob))
    try:
        constructor = serialized.readInt32(False)
        user = jclass("org.telegram.tgnet.TLRPC").User.TLdeserialize(serialized, constructor, False)
    finally:
        try:
            serialized.cleanup()
        except Exception:
            pass
    if user is None:
        raise RuntimeError("user deserialize failed")
    return user


def _apply_user_object(account, blob):
    user = _deserialize_user(blob)
    config = get_user_config(account)
    config.loadConfig()
    config.setCurrentUser(user)


def _select_account(slot):
    try:
        _prefs(0).edit().putInt("selectedAccount", int(slot)).commit()
    except Exception:
        pass
    try:
        from java import jclass
        jclass("org.telegram.messenger.UserConfig").selectedAccount = int(slot)
    except Exception:
        pass


def _write_user_blob(account, blob, selected_slot):
    encoded = base64.b64encode(bytes(blob)).decode("ascii")
    editor = _prefs(account).edit()
    editor.putString("user", encoded)
    editor.putInt("loginTime", int(time.time()))
    editor.putBoolean("registeredForPush", False)
    editor.remove("tmpPassword")
    editor.commit()
    _select_account(selected_slot)


def _display_name(user):
    if user is None:
        return _t("name_this")
    try:
        parts = [str(getattr(user, "first_name", "") or "").strip(),
                 str(getattr(user, "last_name", "") or "").strip()]
        name = " ".join(part for part in parts if part)
        return name or str(getattr(user, "username", "") or "").strip() or _t("name_this")
    except Exception:
        return _t("name_this")


def _read_file(path):
    try:
        with open(path, "rb") as handle:
            return handle.read()
    except Exception:
        return None


def _write_file(path, data):
    with open(path, "wb") as handle:
        handle.write(data)
        handle.flush()
        os.fsync(handle.fileno())


def _atomic_write(path, data):
    temp = path + ".new"
    _write_file(temp, data)
    os.replace(temp, path)


def _delete(path):
    try:
        os.remove(path)
        return True
    except FileNotFoundError:
        return True
    except OSError:
        return False


def _clear_db(account):
    base = _slot_dir(account)
    for name in ("cache4.db", "cache4.db-wal", "cache4.db-shm", "cache4.db-journal"):
        _delete(os.path.join(base, name))


def _max_accounts():
    try:
        from java import jclass
        return int(jclass("org.telegram.messenger.UserConfig").MAX_ACCOUNT_COUNT)
    except Exception:
        return 10


def _find_free_slot(selected):
    max_accounts = _max_accounts()

    order = [int(selected)] + [i for i in range(max_accounts) if i != int(selected)]
    for slot in order:
        try:
            config = get_user_config(slot)
            config.loadConfig()
            if config.getCurrentUser() is None:
                return slot
        except Exception:
            continue
    return None


def _clipboard_text():
    try:
        clip = _context().getSystemService("clipboard").getPrimaryClip()
        if clip is None or int(clip.getItemCount()) < 1:
            return ""
        item = clip.getItemAt(0)
        text = item.getText() if item is not None else None
        return str(text).strip() if text is not None else ""
    except Exception:
        return ""


def _restart_app(log, delay_ms=0, pre_action=None):
    from android_utils import run_on_ui_thread
    from java import jclass

    def _restart():
        if pre_action is not None:
            try:
                pre_action()
            except Exception as e:
                log("pre-restart action failed: %s" % e)
        try:
            context = _context()
            launch = context.getPackageManager().getLaunchIntentForPackage(context.getPackageName())
            if launch is not None:
                intent_class = jclass("android.content.Intent")
                launch.addFlags(intent_class.FLAG_ACTIVITY_NEW_TASK | intent_class.FLAG_ACTIVITY_CLEAR_TASK)
                context.startActivity(launch)
        except Exception as e:
            log("restart intent failed: %s" % e)
        try:
            process = jclass("android.os.Process")
            process.killProcess(process.myPid())
        except Exception as e:
            log("killProcess failed: %s" % e)

    run_on_ui_thread(_restart, int(delay_ms or 0))


class SessionAuthkeyPlugin(BasePlugin):
    def create_settings(self):
        return [
            Header(text=_t("title")),
            Text(text=_t("warning"), red=True),
            Text(text=_t("warning2"), red=True),
            Text(text=_t("help_title"), subtext=_t("help_sub"), on_click=self._show_help),
            Text(text=_t("export"), subtext=_t("export_sub"), accent=True,
                 on_click=self._export),
            Text(text=_t("import"), subtext=_t("import_sub"), accent=True,
                 on_click=self._import),
            Input(key=TOKEN_KEY, text=_t("token_label"), default="",
                  subtext=_t("token_hint")),
            Text(text=_t("clipboard"), subtext=_t("clipboard_sub"), red=True,
                 on_click=self._clear_clipboard),
            Divider(),
            Text(text=_t("wipe"), subtext=_t("wipe_sub"), red=True, on_click=self._wipe),
        ]

    def _confirm_wait(self, action_key, on_confirm):
        try:
            builder = AlertDialogBuilder(_activity())
        except Exception as e:
            self.log("wait dialog failed: %s" % e)
            BulletinHelper.show_error(_t("err_dialog"))
            return

        state = {
            "left": WAIT_SECONDS,
            "done": False,
            "builder": builder,
            "action": _t(action_key),
            "confirm": on_confirm,
        }
        builder.set_title(_t("wait_title"))
        builder.set_message(_t("wait_text").format(
            action=state["action"], sec=WAIT_SECONDS))
        builder.set_positive_button(
            _t("wait_button").format(sec=WAIT_SECONDS),
            lambda *args: self._wait_confirm(state))
        builder.set_negative_button(
            _t("cancel"), lambda *args: self._wait_cancel(state))
        builder.set_on_dismiss_listener(lambda *args: state.__setitem__("done", True))
        _red_button(builder)
        builder.show()
        _red_button(builder)
        _run_ui(lambda: self._wait_lock(state), 0)
        _run_ui(lambda: self._wait_tick(state), 1000)

    def _wait_button(self, state):
        try:
            return state["builder"].get_button(_button_id("BUTTON_POSITIVE"))
        except Exception:
            return None

    def _wait_lock(self, state):
        if state["done"]:
            return
        button = self._wait_button(state)
        if button is None:
            return
        try:
            button.setEnabled(False)
            button.setAlpha(0.5)
        except Exception:
            pass

    def _wait_tick(self, state):
        if state["done"]:
            return
        left = int(state["left"]) - 1
        state["left"] = left
        button = self._wait_button(state)
        if left > 0:
            if button is not None:
                try:
                    button.setText(_t("wait_button").format(sec=left))
                except Exception:
                    pass
            _run_ui(lambda: self._wait_tick(state), 1000)
            return
        if button is not None:
            try:
                button.setText(_t("wait_ready"))
                button.setEnabled(True)
                button.setAlpha(1.0)
            except Exception:
                pass

    def _wait_confirm(self, state):
        if state["done"] or int(state["left"]) > 0:
            return
        state["done"] = True
        try:
            state["builder"].dismiss()
        except Exception:
            pass
        state["confirm"]()

    def _wait_cancel(self, state):
        state["done"] = True
        try:
            state["builder"].dismiss()
        except Exception:
            pass

    def _require_ack(self, action):
        try:
            builder = AlertDialogBuilder(_activity())
            builder.set_title(_t("ack_title"))
            builder.set_message(_t("ack_text"))
            builder.set_positive_button(_t("ack_ok"), lambda *args: action())
            builder.set_negative_button(_t("cancel"), lambda *args: None)
            _red_button(builder)
            builder.show()
            _red_button(builder)
        except Exception as e:
            self.log("ack dialog failed: %s" % e)
            BulletinHelper.show_error(_t("err_dialog"))

    def _clear_clipboard(self, view=None):
        try:
            clipboard = _context().getSystemService("clipboard")
            try:
                clipboard.clearPrimaryClip()
            except Exception:
                from java import jclass
                clip_data = jclass("android.content.ClipData")
                clipboard.setPrimaryClip(clip_data.newPlainText("", ""))
            BulletinHelper.show_info(_t("clipboard_ok"))
        except Exception as e:
            self.log("clipboard clear failed: %s" % e)
            BulletinHelper.show_error(_t("clipboard_err"))

    def _show_help(self, view=None):
        try:
            builder = AlertDialogBuilder(_activity())
            builder.set_title(_t("help_title"))
            builder.set_message(_t("help_text"))
            builder.set_positive_button(_t("close"), lambda *args: None)
            builder.show()
        except Exception as e:
            self.log("help dialog failed: %s" % e)
            BulletinHelper.show_error(_t("err_dialog"))

    def _export(self, view=None):
        self._require_ack(self._confirm_export)

    def _confirm_export(self):
        account = get_selected_account()
        name = _t("name_this")
        try:
            user = get_user_config(account).getCurrentUser()
            if user is not None:
                name = _display_name(user)
        except Exception:
            pass
        try:
            builder = AlertDialogBuilder(_activity())
            builder.set_title(_t("export_confirm_title"))
            builder.set_message(_t("export_confirm_text").format(name=name))
            builder.set_positive_button(
                _t("export_confirm_ok"),
                lambda *args: self._confirm_wait(
                    "action_export", lambda: self._do_export(account)))
            builder.set_negative_button(_t("cancel"), lambda *args: None)
            _red_button(builder)
            builder.show()
            _red_button(builder)
        except Exception as e:
            self.log("export confirm failed: %s" % e)
            BulletinHelper.show_error(_t("err_dialog"))

    def _do_export(self, account):
        try:
            session = self._read_session(account)
            user_blob = _read_user_blob(account)
            user = get_user_config(account).getCurrentUser()
            if user is None:
                try:
                    user = _deserialize_user(user_blob)
                except Exception as e:
                    self.log("user blob decode failed: %s" % e)
                    user = None
            token = _pack_token(session["dc"], session["key"], session["key_id"],
                                int(user.id) if user is not None else 0,
                                user_blob, _display_name(user))
        except Exception as e:
            self.log("export failed: %s" % e)
            BulletinHelper.show_error(_t("err_export").format(_err(e)))
            return

        try:
            from android_utils import copy_to_clipboard
            copy_to_clipboard(token)
        except Exception as e:
            self.log("clipboard copy failed: %s" % e)

        self.log("export ok: dc=%s uid=%s size=%s" %
                 (session["dc"], int(user.id) if user is not None else 0, len(token)))
        self._show_export_dialog(token, session, user)

    def _read_session(self, account):
        path = _tgnet_path(account)
        last_error = None
        for _ in range(3):
            data = _read_file(path)
            if not data:
                last_error = ValueError("%s is missing or unreadable" % path)
                time.sleep(0.05)
                continue
            try:
                parsed = _parse_tgnet(data)
            except Exception as e:
                last_error = e
                time.sleep(0.05)
                continue
            dc_id = parsed["current_dc"]
            block = parsed["datacenters"].get(dc_id)
            if block is None or not block.get("key"):
                raise RuntimeError(_t("err_no_key"))
            key = block["key"]
            if len(key) != 256:
                raise RuntimeError("unexpected auth key length %d" % len(key))
            computed = int.from_bytes(hashlib.sha1(key).digest()[12:20], "little", signed=True)
            if computed != block["key_id"]:
                raise RuntimeError("auth key id mismatch")
            return {"dc": dc_id, "key": key, "key_id": computed}
        raise last_error or RuntimeError("session read failed")

    def _show_export_dialog(self, token, session, user):
        try:
            builder = AlertDialogBuilder(_activity())
            builder.set_title(_t("ok_title"))
            builder.set_message(
                _t("ok_text").format(
                    name=_display_name(user),
                    uid=int(user.id) if user is not None else 0,
                    dc=session["dc"],
                    size=len(token),
                ) + "\n\n" + _t("export_warn") + "\n\n" + _t("preview").format(preview=token[:56])
            )
            builder.set_positive_button(_t("show"), lambda *args: self._show_token(token))
            builder.set_neutral_button(_t("share"), lambda *args: self._share(token))
            builder.set_negative_button(_t("close"), lambda *args: None)
            builder.show()
        except Exception as e:
            self.log("export dialog failed: %s" % e)
            BulletinHelper.show_error(_t("err_dialog"))

    def _show_token(self, token):
        try:
            builder = AlertDialogBuilder(_activity())
            builder.set_title(_t("full_title"))
            builder.set_message(token)
            builder.set_positive_button(_t("share"), lambda *args: self._share(token))
            builder.set_negative_button(_t("close"), lambda *args: None)
            builder.show()
        except Exception as e:
            self.log("token dialog failed: %s" % e)

    def _share(self, token):
        try:
            from java import jclass
            context = _context()
            intent_class = jclass("android.content.Intent")
            send = intent_class(intent_class.ACTION_SEND)
            send.setType("text/plain")
            send.putExtra(intent_class.EXTRA_TEXT, str(token))
            chooser = intent_class.createChooser(send, _t("share_title"))
            chooser.addFlags(intent_class.FLAG_ACTIVITY_NEW_TASK)
            context.startActivity(chooser)
        except Exception as e:
            self.log("share failed: %s" % e)
            BulletinHelper.show_error(_t("err_dialog"))

    def _import(self, view=None):
        self._require_ack(self._import_flow)

    def _import_flow(self):
        field = str(self.get_setting(TOKEN_KEY, "") or "")
        sources = [text for text in (_clipboard_text(), field) if text]
        if not sources:
            BulletinHelper.show_error(_t("err_clipboard"))
            return

        token = None
        last_error = None
        for raw in sources:
            try:
                token = _decode_token(raw)
                break
            except Exception as e:
                last_error = e
        if token is None:
            BulletinHelper.show_error(_t("err_bad_token").format(_err(last_error)))
            return

        selected = get_selected_account()
        slot = _find_free_slot(selected)
        if slot is None:
            BulletinHelper.show_error(_t("err_no_slot"))
            return

        try:
            builder = AlertDialogBuilder(_activity())
            builder.set_title(_t("confirm_import_title"))
            builder.set_message(_t("confirm_import_text").format(
                name=token["name"] or _t("name_this"),
                uid=token["user_id"],
                dc=token["dc"],
                slot=slot,
            ))
            builder.set_positive_button(
                _t("confirm_import_ok"),
                lambda *args: self._confirm_wait(
                    "action_import", lambda: self._do_import(token, slot)))
            builder.set_negative_button(_t("cancel"), lambda *args: None)
            _red_button(builder)
            builder.show()
            _red_button(builder)
        except Exception as e:
            self.log("import dialog failed: %s" % e)
            BulletinHelper.show_error(_t("err_dialog"))

    def _do_import(self, token, slot):
        BulletinHelper.show_info(_t("importing"))
        path = _tgnet_path(slot)
        data = None
        try:
            data = _build_tgnet(token["dc"], token["key"], token["key_id"])
            slot_dir = _slot_dir(slot)
            os.makedirs(slot_dir, exist_ok=True)

            _delete(path + ".bak")
            _clear_db(slot)
            _write_user_blob(slot, token["user_blob"], slot)
            try:
                _apply_user_object(slot, token["user_blob"])
            except Exception as e:
                self.log("in-memory user restore skipped: %s" % e)
            _atomic_write(path, data)

            try:
                self.set_setting(TOKEN_KEY, "", reload_settings=True)
            except Exception:
                try:
                    self.set_setting(TOKEN_KEY, "")
                except Exception:
                    pass
            self.log("import ok: dc=%s uid=%s slot=%s" %
                     (token["dc"], token["user_id"], slot))
        except Exception as e:
            self.log("import failed: %s" % e)
            BulletinHelper.show_error(_t("err_import").format(_err(e)))
            return

        BulletinHelper.show_info(_t("imported"))

        def _final_write():
            _delete(path + ".bak")
            _write_user_blob(slot, token["user_blob"], slot)
            _atomic_write(path, data)

        _restart_app(self.log, delay_ms=120, pre_action=_final_write)

    def _wipe(self, view=None):
        account = get_selected_account()
        try:
            config = get_user_config(account)
            config.loadConfig()
            user = config.getCurrentUser()
            if user is None:
                BulletinHelper.show_error(_t("err_not_logged"))
                return
        except Exception as e:
            BulletinHelper.show_error(_t("err_wipe").format(_err(e)))
            return

        name = _display_name(user)
        try:
            builder = AlertDialogBuilder(_activity())
            builder.set_title(_t("wipe_title"))
            builder.set_message(_t("wipe_text").format(name=name))
            builder.set_positive_button(
                _t("wipe_ok"),
                lambda *args: self._confirm_wipe(account, name))
            builder.set_negative_button(_t("cancel"), lambda *args: None)
            _red_button(builder)
            builder.show()
            _red_button(builder)
        except Exception as e:
            self.log("wipe dialog failed: %s" % e)
            BulletinHelper.show_error(_t("err_dialog"))

    def _confirm_wipe(self, account, name):
        try:
            builder = AlertDialogBuilder(_activity())
            builder.set_title(_t("wipe_title2"))
            builder.set_message(_t("wipe_text2"))
            builder.set_positive_button(
                _t("wipe_ok2"),
                lambda *args: self._confirm_wait(
                    "action_wipe", lambda: self._do_wipe(account)))
            builder.set_negative_button(_t("cancel"), lambda *args: None)
            _red_button(builder)
            builder.show()
            _red_button(builder)
        except Exception as e:
            self.log("wipe confirm failed: %s" % e)

    def _do_wipe(self, account):
        BulletinHelper.show_info(_t("wiping"))
        try:
            _delete(_tgnet_path(account))
            _delete(_tgnet_path(account) + ".bak")
            _clear_db(account)

            try:
                config = get_user_config(account)
                config.loadConfig()
                config.clearConfig()
            except Exception as e:
                self.log("clearConfig skipped: %s" % e)

            prefs = _prefs(account)
            editor = prefs.edit()
            editor.remove("user")
            editor.remove("tmpPassword")
            editor.putBoolean("registeredForPush", False)
            editor.commit()

            remaining = 0
            for slot in range(_max_accounts()):
                if slot == int(account):
                    continue
                try:
                    config = get_user_config(slot)
                    config.loadConfig()
                    if config.getCurrentUser() is not None:
                        remaining = slot
                        break
                except Exception:
                    continue
            _select_account(remaining)

            try:
                from client_utils import get_connections_manager
                get_connections_manager(account).cleanup(True)
            except Exception as e:
                self.log("native cleanup skipped: %s" % e)

            self.log("wipe ok: slot=%s next=%s" % (account, remaining))
        except Exception as e:
            self.log("wipe failed: %s" % e)
            BulletinHelper.show_error(_t("err_wipe").format(_err(e)))
            return

        BulletinHelper.show_info(_t("wiped"))
        path = _tgnet_path(account)

        def _final_cleanup():
            _delete(path)
            _delete(path + ".bak")
            try:
                get_user_config(account).clearConfig()
            except Exception as e:
                self.log("final clear skipped: %s" % e)
            _select_account(remaining)

        _restart_app(self.log, delay_ms=600, pre_action=_final_cleanup)
