_STATE = {"enabled": True, "hidden": set(), "fragment": None, "dirty": False}

def _lang():
    try:
        from org.telegram.messenger import LocaleController
        code = str(LocaleController.getInstance().getCurrentLocale().getLanguage() or "")
        return "ru" if code.lower().startswith("ru") else "en"
    except Exception:
        return "ru"

def _t(key):
    table = RU if _lang() == "ru" else EN
    return table.get(key, EN.get(key, key))

def _key_of(obj):
    if obj is None:
        return None
    try:
        if hasattr(obj, "device_model"):
            return "a:%s" % int(obj.hash)
    except Exception:
        pass
    try:
        if hasattr(obj, "domain"):
            return "w:%s" % int(obj.hash)
    except Exception:
        pass
    try:
        if hasattr(obj, "bot_id"):
            return "b:%s" % int(obj.bot_id)
    except Exception:
        pass
    return None

def _is_current(obj):
    try:
        return bool(obj.current)
    except Exception:
        return False

def _fallback_title(obj):
    try:
        if hasattr(obj, "device_model"):
            name = str(obj.device_model or "").strip()
            if not name:
                name = ("%s %s" % (obj.platform or "", obj.system_version or "")).strip()
            app = str(getattr(obj, "app_name", "") or "").strip()
            if app and name:
                name = "%s · %s" % (name, app)
            return name or _t("session")
        if hasattr(obj, "domain"):
            return str(obj.domain or "").strip() or _t("web_session")
        if hasattr(obj, "bot_id"):
            return _t("bot")
    except Exception:
        pass
    return _t("session")

def _cell_title(view, obj):
    try:
        cell = get_private_field(view, "nameTextView")
        if cell is not None:
            text = str(cell.getText() or "").strip()
            if text:
                return text
    except Exception:
        pass
    return _fallback_title(obj)


def _last_fragment():
    try:
        from client_utils import get_last_fragment
        return get_last_fragment()
    except Exception:
        return None


def _sessions_fragment(candidate=None):
    if candidate is not None:
        return candidate
    fragment = _last_fragment()
    if fragment is not None:
        try:
            if get_private_field(fragment, "sessions") is not None:
                return fragment
        except Exception:
            pass
    return _STATE.get("fragment")

def _show_dialog(activity, title, message, positive_text, on_positive):
    if AlertDialogBuilder is not None:
        try:
            builder = AlertDialogBuilder(activity)
            builder.set_title(str(title))
            builder.set_message(str(message))
            builder.set_positive_button(str(positive_text), lambda *args: on_positive())
            builder.set_negative_button(str(_t("cancel")), lambda *args: None)
            builder.show()
            return True
        except Exception:
            pass
    return _native_dialog(activity, title, message, positive_text, on_positive)

def _native_dialog(activity, title, message, positive_text, on_positive):
    try:
        dialog_class = find_class("org.telegram.ui.ActionBar.AlertDialog")
        listener_class = find_class("android.content.DialogInterface$OnClickListener")
        if dialog_class is None or listener_class is None or activity is None:
            return False

        class _Click(dynamic_proxy(listener_class)):
            def __init__(self, callback=None):
                super().__init__()
                self._callback = callback

            def onClick(self, dialog, which):
                if self._callback is None:
                    return
                try:
                    self._callback()
                except Exception:
                    pass

        builder = dialog_class.Builder(activity)
        builder.setTitle(str(title))
        builder.setMessage(str(message))
        builder.setPositiveButton(str(positive_text), _Click(on_positive))
        builder.setNegativeButton(str(_t("cancel")), _Click())
        builder.show()
        return True
    except Exception:
        return False

def _row_field(fragment, name):
    try:
        value = get_private_field(fragment, name)
    except Exception:
        return None
    if value is None:
        return None
    try:
        return int(value)
    except Exception:
        return None

def session_at(fragment, position):
    try:
        current_row = _row_field(fragment, "currentSessionRow")
        if current_row is not None and position == current_row:
            return get_private_field(fragment, "currentSession"), True
        ranges = (
            ("otherSessionsStartRow", "otherSessionsEndRow", "sessions"),
            ("botSessionsStartRow", "botSessionsEndRow", "bots"),
            ("passwordSessionsStartRow", "passwordSessionsEndRow", "passwordSessions"),
        )
        for start_name, end_name, field_name in ranges:
            start = _row_field(fragment, start_name)
            end = _row_field(fragment, end_name)
            if start is None or end is None or start < 0 or end <= start:
                continue
            if not (start <= position < end):
                continue
            items = get_private_field(fragment, field_name)
            if items is None:
                return None, False
            index = position - start
            if 0 <= index < items.size():
                return items.get(index), False
    except Exception:
        pass
    return None, False

def _hidden_devices():
    return sum(1 for item in _STATE.get("hidden", ()) if str(item).startswith("a:"))

def _refresh_settings(fragment):
    if fragment is None:
        return False
    list_view = None
    for field in ("listView", "listview"):
        try:
            list_view = get_private_field(fragment, field)
        except Exception:
            list_view = None
        if list_view is not None:
            break
    if list_view is None:
        return False
    adapter = None
    for field in ("adapter", "listAdapter"):
        try:
            adapter = get_private_field(list_view, field)
        except Exception:
            adapter = None
        if adapter is not None:
            break
    if adapter is None:
        try:
            adapter = list_view.getAdapter()
        except Exception:
            adapter = None
    if adapter is None:
        return False
    update = getattr(adapter, "update", None)
    if update is not None:
        update(False)
        return True
    adapter.notifyDataSetChanged()
    return True

class SessionHiderPlugin(BasePlugin):
    def on_plugin_load(self):
        self._hook_ids = []
        self._sync_state()
        self._install_hooks()

    def on_plugin_unload(self):
        for hook_id in getattr(self, "_hook_ids", []) or []:
            try:
                self.unhook_method(hook_id)
            except Exception:
                pass
        self._hook_ids = []

    def _install_hooks(self):
        self._install_counter_hooks()
        self._install_sessions_hooks()

    def _install_sessions_hooks(self):
        try:
            activity = find_class("org.telegram.ui.SessionsActivity")
        except Exception as e:
            self.log("SessionsActivity не найден: %s" % e)
            return
        if activity is None:
            self.log("SessionsActivity не найден")
            return
        installed = 0
        for name, handler in (("updateRows", _RowsHook(self)), ("createView", _CreateViewHook(self))):
            try:
                ids = self.hook_all_methods(activity, name, handler)
            except Exception as e:
                self.log("hook %s failed: %s" % (name, e))
                continue
            for hook_id in ids or []:
                self._hook_ids.append(hook_id)
                installed += 1
        self.log("хуки установлены: %s" % installed)

    def _install_counter_hooks(self):
        try:
            settings = find_class("org.telegram.ui.SettingsActivity")
        except Exception as e:
            self.log("SettingsActivity не найден: %s" % e)
            return
        if settings is None:
            self.log("SettingsActivity не найден: счётчик не поправлен")
            return
        installed = 0
        for name in self._counter_method_names(settings):
            try:
                ids = self.hook_all_methods(settings, name, _DevicesCountHook(self))
            except Exception as e:
                self.log("hook SettingsActivity.%s failed: %s" % (name, e))
                continue
            for hook_id in ids or []:
                self._hook_ids.append(hook_id)
                installed += 1
        try:
            ids = self.hook_all_methods(settings, "onResume", _SettingsResumeHook(self))
        except Exception as e:
            self.log("hook SettingsActivity.onResume failed: %s" % e)
            ids = []
        for hook_id in ids or []:
            self._hook_ids.append(hook_id)
            installed += 1
        self.log("хуки счётчика: %s" % installed)

    def _counter_method_names(self, settings):
        names = []
        try:
            methods = settings.getDeclaredMethods()
        except Exception as e:
            self.log("не удалось прочитать методы SettingsActivity: %s" % e)
            methods = []
        for method in methods or []:
            try:
                name = str(method.getName())
                if not name or name in names:
                    continue
                if "device" not in name.lower():
                    continue
                if len(method.getParameterTypes()) != 0:
                    continue
                kind = str(method.getReturnType().getName())
                if kind not in ("java.lang.String", "int", "java.lang.Integer",
                                "long", "java.lang.Long"):
                    continue
                names.append(name)
            except Exception:
                continue
        if "getDevicesCount" not in names:
            names.insert(0, "getDevicesCount")
        self.log("методы счётчика: %s" % names)
        return names

    def _ensure_listener(self, fragment):
        try:
            list_view = get_private_field(fragment, "listView")
            if list_view is None:
                return False
            marker = str(list_view)
            if _STATE.get("list_view") == marker:
                return True
            if get_private_field(list_view, "onItemLongClickListener") is not None:
                _STATE["list_view"] = marker
                return True
            base = find_class("org.telegram.ui.Components.RecyclerListView$OnItemLongClickListener")
            if base is None:
                return False
            plugin = self

            class _ItemLongClick(dynamic_proxy(base)):
                def onItemClick(self, view, position):
                    try:
                        return bool(plugin.on_item_long_click(fragment, view, int(position)))
                    except Exception as e:
                        plugin.log("long click failed: %s" % e)
                        return False

            list_view.setOnItemLongClickListener(_ItemLongClick())
            _STATE["list_view"] = marker
            return True
        except Exception as e:
            self.log("long click listener failed: %s" % e)
            return False

    def _sync_state(self):
        try:
            value = self.get_setting(SETTING_ENABLED, True)
            if isinstance(value, str):
                _STATE["enabled"] = value.strip().lower() not in ("0", "false", "no", "off", "")
            else:
                _STATE["enabled"] = bool(value)
        except Exception:
            _STATE["enabled"] = True
        try:
            raw = self.get_setting(STORE_KEY, "[]")
            data = json.loads(raw) if isinstance(raw, str) else raw
            _STATE["hidden"] = set(str(item) for item in data) if isinstance(data, (list, tuple)) else set()
        except Exception:
            _STATE["hidden"] = set()

    def _enabled(self):
        return bool(_STATE.get("enabled", True))

    def _hidden(self):
        return list(_STATE.get("hidden", ()))

    def _save(self, keys):
        _STATE["hidden"] = set(str(item) for item in keys)
        _STATE["dirty"] = True
        try:
            self.set_setting(STORE_KEY, json.dumps(list(_STATE["hidden"])))
        except Exception as e:
            self.log("save failed: %s" % e)

    def prune(self, fragment):
        hidden = _STATE.get("hidden") or set()
        if not hidden or fragment is None:
            return False
        changed = False
        for field in ("sessions", "passwordSessions", "bots"):
            try:
                items = get_private_field(fragment, field)
            except Exception:
                continue
            if items is None:
                continue
            try:
                index = 0
                while index < items.size():
                    if _key_of(items.get(index)) in hidden:
                        items.remove(index)
                        changed = True
                    else:
                        index += 1
            except Exception:
                continue
        return changed

    def refresh(self, fragment):
        if fragment is None:
            return
        _STATE["fragment"] = fragment
        try:
            method = fragment.getClass().getDeclaredMethod("updateRows")
            method.setAccessible(True)
            method.invoke(fragment)
        except Exception:
            try:
                fragment.loadSessions(False)
            except Exception:
                pass
        try:
            adapter = get_private_field(fragment, "listAdapter")
            if adapter is not None:
                adapter.notifyDataSetChanged()
        except Exception:
            pass

    def hide(self, key, title, fragment):
        if key not in _STATE["hidden"]:
            self._save(set(_STATE["hidden"]) | {key})
        target = _sessions_fragment(fragment)
        self.prune(target)
        self.refresh(target)
        try:
            BulletinHelper.show_undo(
                _t("hidden_toast").format(title),
                lambda: self.unhide([key], target),
                fragment=target,
            )
        except Exception:
            pass

    def unhide(self, keys, fragment):
        keys = set(keys)
        self._save(set(_STATE["hidden"]) - keys)
        target = _sessions_fragment(fragment)
        try:
            target.loadSessions(False)
        except Exception:
            self.refresh(target)

    def unhide_all(self):
        self._save([])
        target = _sessions_fragment()
        try:
            target.loadSessions(False)
        except Exception:
            self.refresh(target)
        try:
            BulletinHelper.show_success(_t("unhide_all_done"))
        except Exception:
            pass

    def on_item_long_click(self, fragment, view, position):
        if not self._enabled():
            return False
        obj, is_current = session_at(fragment, position)
        if obj is None:
            return False
        key = _key_of(obj)
        if not key:
            return False
        _STATE["fragment"] = fragment
        self._open_menu(fragment, view, obj, key, is_current)
        return True

    def _open_menu(self, fragment, view, obj, key, is_current):
        title = _cell_title(view, obj)
        activity = None
        try:
            activity = fragment.getParentActivity()
        except Exception:
            activity = None
        if activity is None:
            try:
                activity = view.getContext()
            except Exception:
                return

        if key in _STATE["hidden"]:
            _show_dialog(
                activity,
                _t("dialog_hidden_title"),
                _t("dialog_hidden_text").format(title),
                _t("dialog_unhide_ok"),
                lambda: self.unhide([key], fragment),
            )
            return

        if is_current:
            try:
                BulletinHelper.show_info(_t("current_forbidden"))
            except Exception:
                pass
            return

        _show_dialog(
            activity,
            _t("dialog_hide_title"),
            _t("dialog_hide_text").format(title),
            _t("dialog_hide_ok"),
            lambda: self.hide(key, title, fragment),
        )

    def create_settings(self):
        self._sync_state()
        hidden = self._hidden()
        return [
            Header(text=_t("menu_title")),
            Text(text=_t("menu_long_press"), subtext=_t("menu_long_press_hint")),
            Switch(key=SETTING_ENABLED, text=_t("enabled"), default=True,
                   on_change=self._on_enabled_change),
            Divider(),
            Header(text=_t("hidden_header")),
            Text(text=_t("hidden_count").format(len(hidden)), subtext=_t("hidden_hint")),
            Text(text=_t("unhide_all"), accent=True, on_click=lambda v=None: self.unhide_all()),
        ]

    def _on_enabled_change(self, value):
        _STATE["enabled"] = bool(value)

class _RowsHook(MethodHook):
    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin

    def before_hooked_method(self, param):
        try:
            fragment = param.thisObject
            _STATE["fragment"] = fragment
            self.plugin.prune(fragment)
            self.plugin._ensure_listener(fragment)
        except Exception as e:
            self.plugin.log("prune failed: %s" % e)

class _CreateViewHook(MethodHook):
    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            fragment = param.thisObject
            _STATE["fragment"] = fragment
            self.plugin._ensure_listener(fragment)
        except Exception as e:
            self.plugin.log("createView hook failed: %s" % e)
# Напиши @syspz в лс слово "тетрагидропиранилциклопентилтетрагидропиридопиридиновые", если читаешь эту хуйню :)
class _DevicesCountHook(MethodHook):
    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            hidden = _hidden_devices()
            if hidden <= 0:
                return
            value = param.getResult()
            if value is None or isinstance(value, bool):
                return
            if isinstance(value, int):
                param.setResult(max(0, value - hidden))
                return
            text = str(value).strip()
            if not text.isdigit():
                return
            corrected = max(0, int(text) - hidden)
            param.setResult(str(corrected) if corrected > 0 else "")
        except Exception as e:
            self.plugin.log("devices count hook failed: %s" % e)

class _SettingsResumeHook(MethodHook):
    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            if not _STATE.get("dirty"):
                return
            if _refresh_settings(param.thisObject):
                _STATE["dirty"] = False
        except Exception as e:
            self.plugin.log("settings resume hook failed: %s" % e)
