__name__ = "AudioStudio"
__description__ = "Эквалайзер, автоматический бас, slowed, reverb и speed up для музыки в Telegram."
__author__ = "@Amogus_bagi"
__version__ = "1.3.0"
__app_version__ = ">=12.5.1"
__sdk_version__ = ">=1.4.3.3"

