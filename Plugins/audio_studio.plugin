DEFAULT_ACCENT = 0x7C4DFF


def parse_order(raw):
    """Порядок блоков: только известные, без повторов, недостающие в конце."""
    try:
        data = json.loads(raw) if isinstance(raw, str) and raw else (raw or [])
    except Exception:
        data = []
    out = []
    if isinstance(data, list):
        for k in data:
            if isinstance(k, str) and k in BLOCK_KEYS and k not in out:
                out.append(k)
    for k in BLOCK_KEYS:
        if k not in out:
            out.append(k)
    return out


def parse_hidden(raw):
    try:
        data = json.loads(raw) if isinstance(raw, str) and raw else (raw or [])
    except Exception:
        data = []
    out = []
    if isinstance(data, list):
        for k in data:
            if isinstance(k, str) and k in BLOCK_KEYS and k not in out:
                out.append(k)
    # хотя бы один блок должен оставаться видимым
    if len(out) >= len(BLOCK_KEYS):
        out = out[:-1]
    return out


def parse_hex(text):
    t = str(text or "").strip().lstrip("#")
    if len(t) == 3:
        t = "".join(c * 2 for c in t)
    if len(t) != 6:
        return None
    try:
        return int(t, 16)
    except ValueError:
        return None


def reorder(order, key, target):
    """Переставить key на позицию target (0..len-1)."""
    rest = [k for k in order if k != key]
    target = max(0, min(len(rest), int(target)))
    rest.insert(target, key)
    return rest


def make_palette(seed, dark):
    r, g, b = (seed >> 16) & 255, (seed >> 8) & 255, seed & 255
    h, _l, sat = colorsys.rgb_to_hls(r / 255.0, g / 255.0, b / 255.0)
    sat = sat if sat < 0.12 else max(0.3, min(0.9, sat))

    def c(l, sv):
        rr, gg, bb = colorsys.hls_to_rgb(h, max(0.0, min(1.0, l)), max(0.0, min(1.0, sv)))
        return 0xFF000000 | (int(round(rr * 255)) << 16) | (int(round(gg * 255)) << 8) | int(round(bb * 255))

    if dark:
        return dict(surface=c(.17, sat * .18), high=c(.22, sat * .2), ink=c(.90, sat * .15), sub=c(.80, sat * .12),
                    primary=c(.80, sat), on_primary=c(.20, sat), pc=c(.31, sat * .6), on_pc=c(.90, sat),
                    outline=c(.31, sat * .1), track=c(.28, sat * .3))
    return dict(surface=c(.95, sat * .4), high=c(.91, sat * .3), ink=c(.11, sat * .1), sub=c(.30, sat * .1),
                primary=c(.40, sat), on_primary=0xFFFFFFFF, pc=c(.90, sat * .8), on_pc=c(.13, sat),
                outline=c(.80, sat * .1), track=c(.88, sat * .5))


class _Hook(MethodHook):
    def __init__(self, plugin, name):
        self.plugin = plugin
        self.name = name

    def after_hooked_method(self, param):
        p = self.plugin
        try:
            if self.name == "style":
                p._on_context_view(param.thisObject)
            elif self.name == "speed":
                p._after_telegram_speed()
            elif self.name == "dialogs":
                p._on_dialogs(param.thisObject)
        except Exception as exc:
            p._note_error(self.name, exc)


class AudioStudioPlugin(BasePlugin):
    def on_plugin_load(self):
        self._alive = True
        self._errors = 0
        self._last_error = ""
        self._log = []
        self._info = {}
        self._status = "ожидание музыки"
        self._stage = ""
        self._zero_ticks = 0
        self._key = None            # (плеер, сессия звука), к которой привязаны эффекты
        self._fx = {}               # eq, bass, virt, rev, loud
        self._modified_speed = False
        self._vis = None
        self._ratio = None
        self._ratio_ema = None
        self._buttons = []
        self._hbuttons = []
        self._dviews = []
        self._views = []
        self._listeners = []
        self._dialog = None
        self._ui = {}
        self._edit = False
        self._quiet = False
        self._scroll = None
        self._pal_cache = {}
        self._hooks = []
        self._load_state()
        try:
            self._install_hooks()
        except Exception as exc:
            self._note_error("hooks", exc)
        run_on_ui_thread(self._tick, delay=1000)

    def on_plugin_unload(self):
        self._alive = False
        try:
            run_on_ui_thread(self._teardown)
        except Exception:
            pass

    def _teardown(self):
        try:
            if self._dialog is not None:
                self._dialog.dismiss()
        except Exception:
            pass
        self._release_all(restore_speed=True)
        for b in list(self._buttons) + list(self._hbuttons):
            try:
                b.setVisibility(8)
            except Exception:
                pass

    # -- состояние
    def _load_state(self):
        gs = self.get_setting
        self._enabled = bool(gs(K_ENABLED, True))
        self._preset = int(clamp(int(gs(K_PRESET, 1) or 0), 0, len(PRESETS) - 1))
        try:
            raw = json.loads(str(gs(K_PARAMS, "") or "{}"))
        except Exception:
            raw = {}
        self._params = sanitize(raw)
        if self._preset > 0:
            self._params = merge_params(PRESETS[self._preset][2])
        ab = gs(K_AUTO_BASS, True)
        self._auto_bass = True if ab is None else bool(ab)
        self._auto_level = int(clamp(int(gs(K_AUTO_LEVEL, 1) or 0), 0, 2))
        self._adaptive = bool(gs(K_ADAPTIVE, False))
        self._voice = bool(gs(K_VOICE, False))
        hd = gs(K_HEADER, True)
        self._show_header = True if hd is None else bool(hd)
        bt = gs(K_BUTTON, True)
        self._show_button = True if bt is None else bool(bt)
        self._theme = int(clamp(int(gs(K_THEME, 0) or 0), 0, len(THEMES) - 1))
        self._accent = str(gs(K_ACCENT, "") or "")
        self._mode = int(clamp(int(gs(K_MODE, 0) or 0), 0, 2))
        self._radius = int(clamp(int(gs(K_RADIUS, 0) or 0), 0, 2))
        self._compact = bool(gs(K_COMPACT, False))
        st = gs(K_STATUS, True)
        self._show_status = True if st is None else bool(st)
        self._order = parse_order(str(gs(K_ORDER, "") or ""))
        self._hidden = parse_hidden(str(gs(K_HIDDEN, "") or ""))

    def _save_params(self):
        self.set_setting(K_PARAMS, json.dumps(self._params))
        self.set_setting(K_PRESET, self._preset)

    def _note_error(self, where, exc):
        self._errors += 1
        step = getattr(self, "_step", "")
        self._last_error = "%s%s: %s: %s" % (where, ("@" + step) if step else "", type(exc).__name__, str(exc)[:150])
        if not self._log or self._log[-1] != self._last_error:
            self._log.append(self._last_error)
        del self._log[:-8]

    # -- хуки
    def _find(self, class_name, method, types):
        from java import jclass
        try:
            cls = jclass("java.lang.Class").forName(class_name)
        except Exception:
            cls = find_class("org.telegram.messenger.ApplicationLoader").applicationContext.getClassLoader().loadClass(class_name)
        for m in cls.getDeclaredMethods():
            if str(m.getName()) != method:
                continue
            got = [str(t.getName()) for t in m.getParameterTypes()]
            if got == types:
                m.setAccessible(True)
                return m
        return None

    def _install_hooks(self):
        fcv = "org.telegram.ui.Components.FragmentContextView"
        for meth, types in (("updateStyle", ["int", "boolean"]), ("checkPlayer", ["boolean"]),
                            ("onAttachedToWindow", []), ("checkVisibility", [])):
            try:
                m = self._find(fcv, meth, types)
                if m is not None and self.hook_method(m, _Hook(self, "style")):
                    self._hooks.append("кнопка:" + meth)
            except Exception as exc:
                self._note_error("hook " + meth, exc)
        dlg = "org.telegram.ui.DialogsActivity"
        for meth, types in (("createView", ["android.content.Context"]), ("onResume", [])):
            try:
                m = self._find(dlg, meth, types)
                if m is not None and self.hook_method(m, _Hook(self, "dialogs")):
                    self._hooks.append("шапка:" + meth)
            except Exception as exc:
                self._note_error("hook dialogs " + meth, exc)
        m = self._find("org.telegram.ui.Components.VideoPlayer", "setPlaybackSpeed", ["float"])
        if m is not None:
            h = self.hook_method(m, _Hook(self, "speed"))
            if h:
                self._hooks.append("speed")

    # -- Android-помощники
    def _activity(self):
        try:
            return find_class("org.telegram.ui.LaunchActivity").instance
        except Exception:
            return None

    def _context(self):
        return find_class("org.telegram.messenger.ApplicationLoader").applicationContext

    def _dp(self, v):
        d = float(find_class("org.telegram.messenger.AndroidUtilities").density)
        return int(round(v * d))

    def _dark(self):
        try:
            from org.telegram.ui.ActionBar import Theme
            c = int(Theme.getColor(Theme.key_windowBackgroundWhite)) & 0xFFFFFF
            r, g, b = (c >> 16) & 255, (c >> 8) & 255, c & 255
            return (0.299 * r + 0.587 * g + 0.114 * b) < 128
        except Exception:
            return True

    def _menu_dark(self):
        if self._mode == 1:
            return True
        if self._mode == 2:
            return False
        return self._dark()

    def _seed(self):
        name, seed = THEMES[self._theme]
        if self._theme == 6:
            try:
                from org.telegram.ui.ActionBar import Theme
                return int(Theme.getColor(Theme.key_featuredStickers_addButton)) & 0xFFFFFF
            except Exception:
                return THEMES[0][1]
        if self._theme == 7:
            v = parse_hex(self._accent)
            return DEFAULT_ACCENT if v is None else v
        return seed

    def _pal(self):
        dark = self._menu_dark()
        if self._theme == 0:
            return PALETTE[dark]
        seed = self._seed()
        key = (seed, dark)
        pal = self._pal_cache.get(key)
        if pal is None:
            if len(self._pal_cache) > 20:
                self._pal_cache.clear()
            pal = self._pal_cache[key] = make_palette(seed, dark)
        return pal

    def _rs(self):
        return RADIUS_SCALE[self._radius]

    # -- плеер
    def _player(self):
        """(VideoPlayer, ExoPlayer, id сессии) для играющего сейчас аудио или None."""
        mc = find_class("org.telegram.messenger.MediaController").getInstance()
        vp = read_field(mc, "audioPlayer")
        if vp is None:
            self._stage = "у Telegram нет audioPlayer"
            return None
        player = None
        try:
            player = vp.player
        except Exception:
            player = None
        if player is None:
            player = read_field(vp, "player")
        if player is None:
            self._stage = "у VideoPlayer нет player"
            return None
        sid = self._session_id(player)
        return mc, vp, player, sid

    def _session_id(self, player):
        """id аудиосессии: у разных версий media3 метод лежит в разных местах, поэтому пробуем всё по очереди."""
        tries = []
        tries.append(lambda: player.getAudioSessionId())
        tries.append(lambda: player.getAudioComponent().getAudioSessionId())
        def fld():
            v = read_field(player, "audioSessionId")
            self._info["fld"] = str(v)
            return v
        tries.append(fld)

        def by_reflection():
            c = player.getClass()
            while c is not None:
                for m in c.getDeclaredMethods():
                    if str(m.getName()) == "getAudioSessionId" and len(m.getParameterTypes()) == 0:
                        m.setAccessible(True)
                        return m.invoke(player)
                c = c.getSuperclass()
            return None
        tries.append(by_reflection)

        def via_audio_track():  # последний шанс: взять сессию у AudioTrack внутри плеера не получится, но поле renderer может хранить её
            return read_field(player, "audioSessionId")
        if "scan" not in self._info:
            self._info["scan"] = "1"
            try:
                names = []
                c = player.getClass()
                while c is not None:
                    for m in c.getDeclaredMethods():
                        if "essionId" in str(m.getName()):
                            names.append(str(m.getName()))
                    for f in c.getDeclaredFields():
                        if "essionId" in str(f.getName()):
                            names.append("поле " + str(f.getName()))
                    c = c.getSuperclass()
                self._info["found"] = ", ".join(names[:8]) or "нет методов/полей с SessionId"
                self._info["cls"] = str(player.getClass().getName())
            except Exception as exc:
                self._note_error("scan", exc)
        def deep():
            import time
            if time.time() < getattr(self, "_deep_until", 0):
                return 0
            v = self._deep_session(player)
            if not v:
                self._deep_until = time.time() + 8   # не обходить объекты плеера каждую секунду
            return v
        tries.append(deep)
        for fn in tries:
            try:
                v = fn()
                if v is not None and int(v) > 0:
                    self._info["sid_via"] = str(tries.index(fn))
                    return int(v)
            except Exception as exc:
                self._note_error("sid%d" % tries.index(fn), exc)
        return 0

    def _deep_session(self, root):
        """Обход объектов плеера через рефлексию: ищем AudioTrack (у него getAudioSessionId открытый) или поле audioSessionId."""
        from java import jclass
        System = jclass("java.lang.System")
        Array = jclass("java.lang.reflect.Array")
        seen = set()
        queue = [(root, 0)]
        budget = 2500
        PRIORITY = ("renderers", "renderer", "audioSink", "audioTrack", "internalPlayer", "audioSessionId")
        while queue and budget > 0:
            obj, depth = queue.pop(0)
            budget -= 1
            if obj is None:
                continue
            ident = int(System.identityHashCode(obj))
            if ident in seen:
                continue
            seen.add(ident)
            cls = obj.getClass()
            name = str(cls.getName())
            if name == "android.media.AudioTrack":
                v = int(obj.getAudioSessionId())
                if v > 0:
                    self._info["deep"] = "AudioTrack"
                    return v
                continue
            if depth >= 9:
                continue
            if bool(cls.isArray()):
                if str(cls.getComponentType().isPrimitive()) == "True" or bool(cls.getComponentType().isPrimitive()):
                    continue
                for i in range(min(int(Array.getLength(obj)), 12)):
                    queue.append((Array.get(obj, i), depth + 1))
                continue
            if name.startswith("java.util."):
                try:
                    arr = obj.toArray()
                    for i in range(min(int(arr.length), 12)):
                        queue.append((arr[i], depth + 1))
                except Exception:
                    pass
                continue
            if not name.startswith("androidx.media3"):
                continue
            c = cls
            while c is not None and str(c.getName()) != "java.lang.Object":
                for f in c.getDeclaredFields():
                    try:
                        if int(f.getModifiers()) & 8:   # static
                            continue
                        f.setAccessible(True)
                        ft = f.getType()
                        if bool(ft.isPrimitive()):
                            if "udioSessionId" in str(f.getName()) and str(ft.getName()) == "int":
                                v = int(f.get(obj))
                                if v > 0:
                                    self._info["deep"] = "%s.%s" % (name.split(".")[-1], str(f.getName()))
                                    return v
                            continue
                        val = f.get(obj)
                        if val is not None:
                            if str(f.getName()) in PRIORITY:
                                queue.insert(0, (val, depth + 1))   # путь renderers → audioSink → audioTrack проверяем первым
                            else:
                                queue.append((val, depth + 1))
                    except Exception:
                        pass
                c = c.getSuperclass()
        return 0

    def _now_playing(self):
        try:
            mc = find_class("org.telegram.messenger.MediaController").getInstance()
            mo = mc.getPlayingMessageObject()
            if mo is None:
                return None, None, False
            return str(mo.getMusicTitle() or ""), str(mo.getMusicAuthor() or ""), bool(mo.isVoice())
        except Exception:
            return None, None, False

    def _tick(self):
        if not self._alive:
            return
        period = 2500
        try:
            for v in list(self._views):
                try:
                    self._inject(v)
                except Exception as exc:
                    self._note_error("inject", exc)
            self._check_header()
            period = 900 if self._sync() else 2500
        except Exception as exc:
            self._note_error("tick", exc)
        try:
            run_on_ui_thread(self._tick, delay=period)
        except Exception:
            pass

    def _sync(self):
        """Найти играющий плеер и подключить эффекты. True, если музыка играет."""
        info = self._player() if self._enabled else None
        if info is None:
            if self._key is not None:
                self._release_all(restore_speed=False)
            self._status = (self._stage or "музыка не играет") if self._enabled else "выключено"
            return False
        mc, vp, player, sid = info
        title, author, voice = self._now_playing()
        if voice and not self._voice:
            if self._key is not None:
                self._release_all(restore_speed=True)
            self._status = "голосовое: эффекты выключены"
            return True
        self._zero_ticks = self._zero_ticks + 1 if sid <= 0 else 0
        if sid > 0 or self._zero_ticks >= 3:
            use = sid if sid > 0 else 0
            key = (int(vp.hashCode()), use)
            if key != self._key:
                self._release_all(restore_speed=False)
                self._key = key
                self._attach(use)
                self._apply_all()
            else:
                self._reassert(player)
            self._adaptive_update()
            self._status = "эффекты: " + (", ".join(sorted(self._fx)) or "не подключились") + " • сессия %d" % use
        else:
            self._status = "ждём аудиосессию плеера"
        return True

    def _reassert(self, player):
        """Telegram мог сбросить скорость/тон или выключить эффекты: возвращаем своё."""
        p = effective(self._params, self._auto_bass, self._auto_level, 0)
        if not is_neutral_playback(p):
            pp = player.getPlaybackParameters()
            if abs(float(pp.speed) - p["spd"]) > 0.01 or abs(float(pp.pitch) - p["pit"]) > 0.01:
                self._apply_speed(p)
        for fx in self._fx.values():
            try:
                if not fx.getEnabled():
                    fx.setEnabled(True)
            except Exception:
                pass

    # -- эффекты
    def _attach(self, sid):
        from android.media.audiofx import Equalizer, BassBoost, Virtualizer, PresetReverb
        made = {}
        for name, factory in (("eq", Equalizer), ("bass", BassBoost), ("virt", Virtualizer), ("rev", PresetReverb)):
            try:
                fx = factory(0, sid)
                fx.setEnabled(True)
                made[name] = fx
            except Exception as exc:
                self._note_error("fx " + name, exc)
        try:
            from android.media.audiofx import LoudnessEnhancer
            fx = LoudnessEnhancer(sid)
            fx.setEnabled(True)
            made["loud"] = fx
        except Exception as exc:
            self._note_error("fx loud", exc)
        self._fx = made
        for nm in ("bass", "virt"):
            try:
                if nm in made:
                    self._info[nm + "_ok"] = "да" if bool(made[nm].getStrengthSupported()) else "нет (заменено эквалайзером)"
            except Exception:
                pass
        try:
            if "virt" in made:
                made["virt"].forceVirtualizationMode(1)
        except Exception:
            pass
        try:
            if "eq" in made:
                self._info["eq"] = "%d полос" % int(made["eq"].getNumberOfBands())
        except Exception:
            pass
        if self._adaptive and self._auto_bass:
            self._start_visualizer(sid)

    def _release_all(self, restore_speed):
        for fx in list(self._fx.values()):
            try:
                fx.setEnabled(False)
                fx.release()
            except Exception:
                pass
        self._fx = {}
        self._key = None
        self._stop_visualizer()
        if restore_speed and self._modified_speed:
            try:
                info = self._player()
                if info is not None:
                    mc, vp, player, sid = info
                    sp = float(mc.getPlaybackSpeed(True))
                    vp.setPlaybackSpeed(round(sp * 10.0) / 10.0)
            except Exception as exc:
                self._note_error("restore speed", exc)
        self._modified_speed = False

    def _adaptive_percent(self):
        return adaptive_bass_percent(self._ratio) if (self._adaptive and self._auto_bass) else 0

    def _apply_all(self):
        """Применить текущие параметры к плееру (в потоке интерфейса)."""
        if not self._enabled:
            return
        if self._key is None:
            try:
                self._sync()      # сам подключает эффекты и вызывает _apply_all
            except Exception as exc:
                self._note_error("sync", exc)
            return
        from java import jshort
        p = effective(self._params, self._auto_bass, self._auto_level, self._adaptive_percent())
        fx = self._fx
        try:
            eq = fx.get("eq")
            if eq is not None:
                bands = int(eq.getNumberOfBands())
                rng = eq.getBandLevelRange()
                levels = eq_levels(mix_eq(p), bands, int(rng[0]), int(rng[1]))
                for i, lv in enumerate(levels):
                    eq.setBandLevel(jshort(i), jshort(lv))
        except Exception as exc:
            self._note_error("eq", exc)
        for name, key in (("bass", "bass"), ("virt", "virt")):
            try:
                if name in fx:
                    fx[name].setStrength(jshort(int(p[key] * 10)))
            except Exception as exc:
                self._note_error(name, exc)
        try:
            if "rev" in fx:
                fx["rev"].setPreset(jshort(REVERB_CONST[virt_reverb(p)]))
        except Exception as exc:
            self._note_error("reverb", exc)
        try:
            if "loud" in fx:
                fx["loud"].setTargetGain(int(p["loud"] * 12))   # до +1200 мБ
        except Exception as exc:
            self._note_error("loudness", exc)
        self._apply_speed(p)

    def _apply_speed(self, p=None):
        """Скорость и тон: свои значения; если оба равны 1 и мы их не меняли, оставляем настройки Telegram."""
        if p is None:
            p = effective(self._params, self._auto_bass, self._auto_level, 0)
        info = self._player()
        if info is None:
            return
        mc, vp, player, sid = info
        if is_neutral_playback(p):
            if self._modified_speed:
                sp = float(mc.getPlaybackSpeed(True))
                vp.setPlaybackSpeed(round(sp * 10.0) / 10.0)
                self._modified_speed = False
            return
        from java import jclass, jfloat
        try:
            try:
                PP = jclass(str(player.getPlaybackParameters().getClass().getName()))
            except Exception:
                PP = jclass("androidx.media3.common.PlaybackParameters")
            player.setPlaybackParameters(PP(jfloat(float(p["spd"])), jfloat(float(p["pit"]))))
            self._modified_speed = True
            self._info["speed"] = "%.2f / %.2f" % (p["spd"], p["pit"])
        except Exception as exc:
            self._note_error("speed", exc)
            try:  # запасной путь: скорость через Telegram (без смены тона)
                mc.setPlaybackSpeed(True, float(p["spd"]))
                self._modified_speed = True
            except Exception as exc2:
                self._note_error("speed2", exc2)

    def _after_telegram_speed(self):
        """Telegram сам выставил скорость (кнопка скорости): возвращаем свои скорость и тон поверх."""
        if not self._enabled or not self._modified_speed or self._key is None:
            return
        run_on_ui_thread(self._apply_speed)

    # -- адаптивный бас по составу трека
    def _start_visualizer(self, sid):
        try:
            from android.media.audiofx import Visualizer
            from java import dynamic_proxy, jclass
            vis = Visualizer(sid)
            vis.setEnabled(False)
            vis.setCaptureSize(int(Visualizer.getCaptureSizeRange()[1]))
            iface = jclass("android.media.audiofx.Visualizer$OnDataCaptureListener")
            plugin = self

            class _L(dynamic_proxy(iface)):
                def onWaveFormDataCapture(self, v, w, r):
                    pass

                def onFftDataCapture(self, v, fft, rate):
                    plugin._on_fft(fft, rate)

            self._vis_listener = _L()
            vis.setDataCaptureListener(self._vis_listener, int(Visualizer.getMaxCaptureRate()) // 2, False, True)
            vis.setEnabled(True)
            self._vis = vis
            self._ratio = None
            self._ratio_ema = None
        except Exception as exc:
            self._vis = None
            self._note_error("visualizer", exc)

    def _stop_visualizer(self):
        vis, self._vis = self._vis, None
        if vis is not None:
            try:
                vis.setEnabled(False)
                vis.release()
            except Exception:
                pass

    def _on_fft(self, fft, rate):
        try:
            data = to_signed(fft)
            bass = band_mean(data, float(rate), 40.0, 160.0)
            mid = band_mean(data, float(rate), 400.0, 4000.0)
            if mid <= 0.05 or bass <= 0.05:
                return
            r = bass / mid
            self._ratio_ema = r if self._ratio_ema is None else self._ratio_ema * 0.97 + r * 0.03
            self._ratio = self._ratio_ema
        except Exception as exc:
            self._note_error("fft", exc)

    def _adaptive_update(self):
        if self._vis is None and self._adaptive and self._auto_bass and self._key is not None:
            self._start_visualizer(self._key[1])
        if self._vis is not None and not (self._adaptive and self._auto_bass):
            self._stop_visualizer()
        if self._adaptive and self._auto_bass and self._ratio is not None:
            self._apply_bass_only()

    def _apply_bass_only(self):
        try:
            from java import jshort
            p = effective(self._params, self._auto_bass, self._auto_level, self._adaptive_percent())
            if "bass" in self._fx:
                self._fx["bass"].setStrength(jshort(int(p["bass"] * 10)))
        except Exception as exc:
            self._note_error("adaptive bass", exc)

    # -- кнопка быстрого открытия в шапке списка чатов (слева от замка)
    def _check_header(self):
        """Если экран чатов уже был открыт до загрузки плагина, хуки его не видели: берём текущий экран сами."""
        try:
            for f in list(self._dviews):
                self._inject_dialogs(f)
            act = self._activity()
            if act is None:
                return
            frag = act.getLastFragment()
            if frag is not None and str(frag.getClass().getName()).endswith("DialogsActivity"):
                if not any(v is frag for v in self._dviews):
                    self._on_dialogs(frag)
        except Exception as exc:
            self._note_error("header check", exc)

    def _on_dialogs(self, frag):
        try:
            if not any(v is frag for v in self._dviews):
                self._dviews.append(frag)
                del self._dviews[:-2]
            self._inject_dialogs(frag)
        except Exception as exc:
            self._info["hdr"] = "ошибка"
            self._note_error("header", exc)

    def _set_icon(self, btn, color):
        """Значок из рисунка; если не вышло, берём встроенную иконку Telegram."""
        try:
            btn.setImageBitmap(self._icon(color, self._preset != 1 or self._auto_bass))
        except Exception as exc:
            self._note_error("icon bitmap", exc)
            ctx = btn.getContext()
            rid = int(ctx.getResources().getIdentifier("msg_media", "drawable", ctx.getPackageName()))
            if rid:
                btn.setImageResource(rid)

    def _inject_dialogs(self, frag):
        self._step = "hdr-find"
        item = read_field(frag, "passcodeItem")
        if item is None:
            self._info["hdr"] = "нет passcodeItem"
            return
        parent = item.getParent()
        if parent is None:
            return
        btn = parent.findViewWithTag(BTN_TAG2)
        if not self._show_header or not self._enabled:
            if btn is not None:
                btn.setVisibility(8)
            return
        from android.widget import ImageView, LinearLayout
        if btn is None:
            self._step = "hdr-create"
            btn = ImageView(parent.getContext())
            btn.setTag(BTN_TAG2)
            btn.setScaleType(ImageView.ScaleType.CENTER)
            self._step = "hdr-listener"
            lst = OnClickListener(lambda *_: self.open_menu())
            self._listeners.append(lst)
            btn.setOnClickListener(lst)
            self._step = "hdr-addView"
            parent.addView(btn, int(parent.indexOfChild(item)), LinearLayout.LayoutParams(self._dp(48), -1))
            self._hbuttons.append(btn)
        self._step = "hdr-icon"
        try:
            from org.telegram.ui.ActionBar import Theme
            color = int(Theme.getColor(Theme.key_actionBarDefaultIcon))
        except Exception:
            color = 0xFF8E8E93
        self._set_icon(btn, color)
        btn.setVisibility(0)
        self._info["hdr"] = "вставлена"

    # -- кнопка в мини-плеере под шапкой
    def _icon(self, color, on):
        from android.graphics import Bitmap, Canvas, Paint, RectF
        size = self._dp(36)
        bmp = Bitmap.createBitmap(size, size, Bitmap.Config.ARGB_8888)
        cv = Canvas(bmp)
        paint = Paint(1)
        c32 = color & 0xFFFFFFFF
        paint.setARGB(150 if not on else 255, (c32 >> 16) & 255, (c32 >> 8) & 255, c32 & 255)
        bw = size * 0.11
        gap = size * 0.07
        heights = [0.34, 0.58, 0.42, 0.66]
        total = len(heights) * bw + (len(heights) - 1) * gap
        x = (size - total) / 2.0
        base = size * 0.74
        for h in heights:
            hh = size * h * 0.8
            cv.drawRoundRect(RectF(x, base - hh, x + bw, base), bw / 2.0, bw / 2.0, paint)
            x += bw + gap
        return bmp

    def _on_context_view(self, fcv):
        try:
            if not any(v is fcv for v in self._views):
                self._views.append(fcv)
                del self._views[:-4]
            self._inject(fcv)
            self._info["btn"] = "вставлена" if fcv.findViewWithTag(BTN_TAG) is not None else "нет"
        except Exception as exc:
            self._info["btn"] = "ошибка"
            self._note_error("button", exc)

    def _inject(self, fcv):
        self._step = "style"
        style = int(read_field(fcv, "currentStyle"))
        self._step = "find"
        btn = fcv.findViewWithTag(BTN_TAG)
        if style != 0 or not self._show_button or not self._enabled:
            if btn is not None:
                btn.setVisibility(8)
            return
        from android.widget import ImageView, FrameLayout
        if btn is None:
            self._step = "create"
            btn = ImageView(fcv.getContext())
            btn.setTag(BTN_TAG)
            btn.setScaleType(ImageView.ScaleType.CENTER)
            self._step = "listener"
            lst = OnClickListener(lambda *_: self.open_menu())
            self._listeners.append(lst)
            btn.setOnClickListener(lst)
            self._step = "layout"
            params = FrameLayout.LayoutParams(self._dp(36), self._dp(36), 53)  # TOP | RIGHT
            params.rightMargin = self._dp(72)
            self._step = "addView"
            fcv.addView(btn, params)
            self._buttons.append(btn)
        self._step = "icon"
        try:
            from org.telegram.ui.ActionBar import Theme
            color = int(Theme.getColor(Theme.key_inappPlayerPlayPause))
        except Exception:
            color = 0xFF8E8E93
        self._set_icon(btn, color)
        btn.setVisibility(0)
        self._step = "title"
        try:  # заголовок не должен залезать под новую кнопку
            title = read_field(fcv, "titleTextView")
            lp = title.getLayoutParams()
            lp.rightMargin = max(int(lp.rightMargin), self._dp(108))
            title.setLayoutParams(lp)
        except Exception as exc:
            self._note_error("title margin", exc)

    # -- меню Material 3 Expressive
    def open_menu(self, view=None):
        self._edit = False
        self._quiet = False
        run_on_ui_thread(self._build_menu)

    def _rebuild(self):
        self._quiet = True
        run_on_ui_thread(self._build_menu)

    def _build_menu(self):
        try:
            act = self._activity()
            if act is None:
                return
            if self._dialog is not None:
                try:
                    self._dialog.dismiss()
                except Exception:
                    pass
            self._build_menu_impl(act)
        except Exception as exc:
            self._note_error("menu", exc)

    def _label(self, ctx, text, size, color, bold=False):
        from android.widget import TextView
        from android.util import TypedValue
        from android.graphics import Typeface
        tv = TextView(ctx)
        tv.setText(text)
        tv.setTextSize(TypedValue.COMPLEX_UNIT_DIP, float(size))
        tv.setTextColor(signed(color))
        if bold:
            tv.setTypeface(Typeface.DEFAULT_BOLD)
        return tv

    def _round(self, color, radius_dp):
        from android.graphics.drawable import GradientDrawable
        g = GradientDrawable()
        g.setColor(signed(color))
        g.setCornerRadius(float(self._dp(radius_dp * self._rs())))
        return g

    def _build_menu_impl(self, act):
        from android.app import Dialog
        from android.view import Gravity, View, ViewGroup
        from android.widget import LinearLayout, ScrollView, Switch as ASwitch
        from android.graphics.drawable import GradientDrawable, ColorDrawable
        from android.content.res import ColorStateList
        from java import dynamic_proxy, jclass

        pal = self._pal()
        ctx = act
        dp = self._dp
        MATCH, WRAP = -1, -2
        self._ui = {"chips": [], "sliders": {}, "revs": [], "eq": []}
        edit = bool(self._edit)

        dlg = Dialog(ctx)
        dlg.requestWindowFeature(1)
        dlg.setCanceledOnTouchOutside(not edit)
        win = dlg.getWindow()
        win.setBackgroundDrawable(ColorDrawable(0))
        win.setGravity(80)
        win.setDimAmount(0.45)
        if not self._quiet:
            try:
                win.setWindowAnimations(int(jclass("android.R$style").Animation_InputMethod))
            except Exception:
                pass

        sheet = LinearLayout(ctx)
        sheet.setOrientation(LinearLayout.VERTICAL)
        big = float(dp(28 * self._rs()))
        shape = GradientDrawable()
        shape.setColor(signed(pal["surface"]))
        shape.setCornerRadii([big, big, big, big, 0.0, 0.0, 0.0, 0.0])
        sheet.setBackground(shape)
        sheet.setPadding(dp(20), dp(10), dp(20), dp(16))

        handle = View(ctx)
        handle.setBackground(self._round(pal["outline"], 2))
        hp = LinearLayout.LayoutParams(dp(36), dp(4))
        hp.gravity = Gravity.CENTER_HORIZONTAL
        sheet.addView(handle, hp)

        head = LinearLayout(ctx)
        head.setOrientation(LinearLayout.HORIZONTAL)
        head.setGravity(Gravity.CENTER_VERTICAL)
        head.setPadding(0, dp(10 if self._compact else 14), 0, dp(4))
        texts = LinearLayout(ctx)
        texts.setOrientation(LinearLayout.VERTICAL)
        texts.addView(self._label(ctx, "Оформление" if edit else "Эквалайзер", 24, pal["ink"], True))
        if edit:
            texts.addView(self._label(ctx, "Перетаскивайте ≡, чтобы поменять порядок", 13, pal["sub"]))
        else:
            title, author, voice = self._now_playing()
            sub = (title or "ничего не играет")
            if author:
                sub = "%s — %s" % (author, sub)
            sub_view = self._label(ctx, sub, 13, pal["sub"])
            sub_view.setSingleLine(True)
            texts.addView(sub_view)
            try:
                self._sync()
            except Exception as exc:
                self._note_error("menu sync", exc)
            if self._show_status:
                stat = self._label(ctx, "● " + self._status + ("  ⚠ " + self._last_error if self._last_error else ""), 11, pal["primary"])
                stat.setMaxLines(2)
                texts.addView(stat)
        head.addView(texts, LinearLayout.LayoutParams(0, WRAP, 1.0))
        if not edit:
            sw = ASwitch(ctx)
            sw.setChecked(self._enabled)
            sw.setThumbTintList(ColorStateList.valueOf(signed(pal["primary"])))
            sw.setTrackTintList(ColorStateList.valueOf(signed(pal["pc"])))

            class _Sw(dynamic_proxy(jclass("android.widget.CompoundButton$OnCheckedChangeListener"))):
                def onCheckedChanged(s, button, checked):
                    self._set_enabled(bool(checked))

            l1 = _Sw()
            self._listeners.append(l1)
            sw.setOnCheckedChangeListener(l1)
            head.addView(sw)
        sheet.addView(head, LinearLayout.LayoutParams(MATCH, WRAP))

        scroll = ScrollView(ctx)
        scroll.setVerticalScrollBarEnabled(False)
        body = LinearLayout(ctx)
        body.setOrientation(LinearLayout.VERTICAL)
        scroll.addView(body, ViewGroup.LayoutParams(MATCH, WRAP))
        self._scroll = scroll
        try:
            self._fill_body(ctx, body, pal)
        except Exception as exc:
            self._note_error("menu body", exc)
        sheet.addView(scroll, LinearLayout.LayoutParams(MATCH, 0, 1.0))

        foot = LinearLayout(ctx)
        foot.setOrientation(LinearLayout.HORIZONTAL)
        foot.setGravity(Gravity.END | Gravity.CENTER_VERTICAL)
        foot.setPadding(0, dp(10), 0, 0)

        def add_text_btn(text, fn):
            v = self._label(ctx, text, 15, pal["primary"], True)
            v.setPadding(dp(16), dp(12), dp(16), dp(12))
            lst = OnClickListener(lambda *_: fn())
            self._listeners.append(lst)
            v.setOnClickListener(lst)
            foot.addView(v)

        if edit:
            add_text_btn("Сбросить вид", lambda: self._reset_look())
        else:
            add_text_btn("Сбросить", lambda: self._choose_preset(1))
            add_text_btn("Вид", lambda: self._toggle_edit(True))
        done = self._label(ctx, "Готово", 15, pal["on_primary"], True)
        done.setPadding(dp(28), dp(12), dp(28), dp(12))
        done.setBackground(self._round(pal["primary"], 24))
        lst = OnClickListener(lambda *_: (self._toggle_edit(False) if edit else dlg.dismiss()))
        self._listeners.append(lst)
        done.setOnClickListener(lst)
        foot.addView(done)
        sheet.addView(foot, LinearLayout.LayoutParams(MATCH, WRAP))

        dlg.setContentView(sheet, ViewGroup.LayoutParams(MATCH, WRAP))
        win.setLayout(MATCH, WRAP)
        try:
            h = int(ctx.getResources().getDisplayMetrics().heightPixels * 0.88)
            win.setLayout(MATCH, h)
        except Exception:
            pass
        self._dialog = dlg
        self._refresh_ui()
        dlg.show()

    def _toggle_edit(self, on):
        self._edit = bool(on)
        self._rebuild()

    # -- блоки меню
    def _fill_body(self, ctx, body, pal):
        from android.widget import LinearLayout
        body.removeAllViews()
        self._ui = {"chips": [], "sliders": {}, "revs": [], "eq": []}
        if self._edit:
            self._fill_edit(ctx, body, pal)
            return
        makers = {"presets": self._blk_presets, "sound": self._blk_sound, "reverb": self._blk_reverb,
                  "eq": self._blk_eq, "auto": self._blk_auto}
        shown = 0
        for key in self._order:
            if key in self._hidden:
                continue
            try:
                box = makers[key](ctx, pal)
                body.addView(box, LinearLayout.LayoutParams(-1, -2))
                shown += 1
            except Exception as exc:
                self._note_error("block " + key, exc)
        if not shown:
            body.addView(self._label(ctx, "Все блоки скрыты. Нажмите «Вид», чтобы вернуть их.", 14, pal["sub"]),
                         self._lp(0, 20, 0, 0))

    def _gap(self):
        return 10 if self._compact else 18

    def _box(self, ctx, pal, title, top=None):
        from android.widget import LinearLayout
        box = LinearLayout(ctx)
        box.setOrientation(LinearLayout.VERTICAL)
        box.addView(self._label(ctx, title, 14, pal["primary"], True),
                    self._lp(0, self._gap() if top is None else top, 0, 6))
        return box

    def _chip_row(self, ctx, pal, names, pad_v, on_click, bucket):
        from android.view import Gravity
        from android.widget import LinearLayout, HorizontalScrollView
        dp = self._dp
        hs = HorizontalScrollView(ctx)
        hs.setHorizontalScrollBarEnabled(False)
        row = LinearLayout(ctx)
        row.setOrientation(LinearLayout.HORIZONTAL)
        for i, name in enumerate(names):
            chip = self._label(ctx, name, 14, pal["ink"])
            chip.setPadding(dp(16), dp(pad_v), dp(16), dp(pad_v))
            chip.setGravity(Gravity.CENTER)
            lst = OnClickListener(lambda *_, idx=i: on_click(idx))
            self._listeners.append(lst)
            chip.setOnClickListener(lst)
            lp = LinearLayout.LayoutParams(-2, -2)
            lp.rightMargin = dp(8)
            row.addView(chip, lp)
            if bucket is not None:
                bucket.append(chip)
        hs.addView(row)
        return hs

    def _blk_presets(self, ctx, pal):
        box = self._box(ctx, pal, "Пресеты", 12)
        names = ["%s  %s" % (glyph, name) for name, glyph, _ in PRESETS]
        box.addView(self._chip_row(ctx, pal, names, 10, self._choose_preset, self._ui["chips"]))
        return box

    def _blk_sound(self, ctx, pal):
        box = self._box(ctx, pal, "Звук", 6 if self._compact else 12)
        for key, title_s, lo, hi, step, unit in SLIDERS:
            self._add_slider(ctx, box, pal, key, title_s, lo, hi, step, unit)
        return box

    def _blk_reverb(self, ctx, pal):
        box = self._box(ctx, pal, "Реверберация")
        box.addView(self._chip_row(ctx, pal, list(REVERBS), 9, lambda i: self._set_param("rev", i), self._ui["revs"]))
        return box

    def _blk_eq(self, ctx, pal):
        from android.view import Gravity, View
        from android.widget import LinearLayout, FrameLayout
        dp = self._dp
        box = self._box(ctx, pal, "Эквалайзер")
        eq_row = LinearLayout(ctx)
        eq_row.setOrientation(LinearLayout.HORIZONTAL)
        th = 100 if self._compact else 140
        for i in range(5):
            col = LinearLayout(ctx)
            col.setOrientation(LinearLayout.VERTICAL)
            col.setGravity(Gravity.CENTER_HORIZONTAL)
            track = FrameLayout(ctx)
            track.setBackground(self._round(pal["track"], 22))
            fill = View(ctx)
            fill.setBackground(self._round(pal["primary"], 22))
            track.addView(fill, FrameLayout.LayoutParams(-1, dp(10), 80))
            self._attach_band_touch(track, fill, i)
            col.addView(track, LinearLayout.LayoutParams(dp(46), dp(th)))
            hint = EQ_FREQ_HINT[i] or ("%d" % (i + 1))
            col.addView(self._label(ctx, hint, 12, pal["sub"]), self._lp(0, 6, 0, 0))
            eq_row.addView(col, LinearLayout.LayoutParams(0, -2, 1.0))
            self._ui["eq"].append((track, fill))
        box.addView(eq_row, LinearLayout.LayoutParams(-1, -2))
        return box

    def _blk_auto(self, ctx, pal):
        dp = self._dp
        box = self._box(ctx, pal, "Автоматический бас")
        auto = self._label(ctx, self._auto_text(), 14, pal["ink"])
        auto.setPadding(dp(16), dp(14), dp(16), dp(14))
        auto.setBackground(self._round(pal["high"], 20))
        lst = OnClickListener(lambda *_: self._cycle_auto(auto))
        self._listeners.append(lst)
        auto.setOnClickListener(lst)
        box.addView(auto, self._lp(0, 0, 0, 0))
        box.addView(self._label(ctx, "нажмите, чтобы переключить: выкл → лёгкий → средний → сильный", 12, pal["sub"]),
                    self._lp(4, 4, 0, 0))
        return box

    # -- режим «Вид»: тема, скругление, порядок и видимость блоков
    def _swatch_row(self, ctx, pal):
        from android.view import Gravity
        from android.widget import LinearLayout, HorizontalScrollView, TextView
        from android.graphics.drawable import GradientDrawable
        dp = self._dp
        hs = HorizontalScrollView(ctx)
        hs.setHorizontalScrollBarEnabled(False)
        row = LinearLayout(ctx)
        row.setOrientation(LinearLayout.HORIZONTAL)
        dark = self._menu_dark()
        for i, (name, _seed) in enumerate(THEMES):
            if i == 0:
                color = PALETTE[dark]["primary"]
            elif i == 6:
                saved, self._theme = self._theme, 6
                color = make_palette(self._seed(), dark)["primary"]
                self._theme = saved
            elif i == 7:
                v = parse_hex(self._accent)
                color = make_palette(DEFAULT_ACCENT if v is None else v, dark)["primary"]
            else:
                color = make_palette(_seed, dark)["primary"]
            col = LinearLayout(ctx)
            col.setOrientation(LinearLayout.VERTICAL)
            col.setGravity(Gravity.CENTER_HORIZONTAL)
            dot = TextView(ctx)
            g = GradientDrawable()
            g.setShape(1)
            g.setColor(signed(color))
            if i == self._theme:
                g.setStroke(dp(3), signed(pal["ink"]))
            dot.setBackground(g)
            dot.setGravity(Gravity.CENTER)
            dot.setText("✓" if i == self._theme else "")
            dot.setTextColor(signed(pal["on_primary"]))
            lst = OnClickListener(lambda *_, idx=i: self._pick_theme(idx))
            self._listeners.append(lst)
            dot.setOnClickListener(lst)
            col.addView(dot, LinearLayout.LayoutParams(dp(44), dp(44)))
            lab = self._label(ctx, name, 11, pal["sub"])
            lab.setGravity(Gravity.CENTER)
            col.addView(lab, self._lp(0, 4, 0, 0))
            lp = LinearLayout.LayoutParams(dp(72), -2)
            row.addView(col, lp)
        hs.addView(row)
        return hs

    def _pick_theme(self, idx):
        if idx == 7 and parse_hex(self._accent) is None:
            self.set_setting(K_ACCENT, "%06X" % DEFAULT_ACCENT)
        self._set_look(K_THEME, int(idx))

    def _select_row(self, ctx, pal, names, current, key):
        hs = self._chip_row(ctx, pal, names, 9, lambda i: self._set_look(key, int(i)), None)
        row = hs.getChildAt(0)
        for i in range(len(names)):
            chip = row.getChildAt(i)
            sel = i == current
            chip.setBackground(self._round(pal["pc"] if sel else pal["high"], 20))
            chip.setTextColor(signed(pal["on_pc"] if sel else pal["ink"]))
        return hs

    def _fill_edit(self, ctx, body, pal):
        from android.view import Gravity
        from android.widget import LinearLayout
        dp = self._dp
        body.addView(self._label(ctx, "Цветовая тема", 14, pal["primary"], True), self._lp(0, 12, 0, 6))
        body.addView(self._swatch_row(ctx, pal))
        if self._theme == 7:
            body.addView(self._label(ctx, "Точный цвет задаётся в настройках плагина (HEX).", 12, pal["sub"]),
                         self._lp(2, 4, 0, 0))
        body.addView(self._label(ctx, "Светлая или тёмная", 14, pal["primary"], True), self._lp(0, 16, 0, 6))
        body.addView(self._select_row(ctx, pal, MODE_NAMES, self._mode, K_MODE))
        body.addView(self._label(ctx, "Скругление", 14, pal["primary"], True), self._lp(0, 16, 0, 6))
        body.addView(self._select_row(ctx, pal, RADIUS_NAMES, self._radius, K_RADIUS))
        body.addView(self._label(ctx, "Плотность", 14, pal["primary"], True), self._lp(0, 16, 0, 6))
        body.addView(self._select_row(ctx, pal, ["Обычная", "Компактная"], 1 if self._compact else 0, "__compact"))
        body.addView(self._label(ctx, "Блоки: перетаскивайте ≡, глаз скрывает", 14, pal["primary"], True),
                     self._lp(0, 20, 0, 8))
        box = LinearLayout(ctx)
        box.setOrientation(LinearLayout.VERTICAL)
        body.addView(box, LinearLayout.LayoutParams(-1, -2))
        names = dict(BLOCKS)
        rows = {}
        stride = dp(56) + dp(8)
        for key in self._order:
            row = LinearLayout(ctx)
            row.setOrientation(LinearLayout.HORIZONTAL)
            row.setGravity(Gravity.CENTER_VERTICAL)
            row.setBackground(self._round(pal["high"], 18))
            hide = key in self._hidden
            row.setAlpha(0.45 if hide else 1.0)
            grip = self._label(ctx, "≡", 26, pal["primary"], True)
            grip.setGravity(Gravity.CENTER)
            grip.setPadding(dp(16), 0, dp(16), 0)
            row.addView(grip, LinearLayout.LayoutParams(-2, -1))
            row.addView(self._label(ctx, names[key], 16, pal["ink"]), LinearLayout.LayoutParams(0, -2, 1.0))
            eye = self._label(ctx, "Скрыт" if hide else "Показан", 13, pal["sub"] if hide else pal["primary"], True)
            eye.setPadding(dp(16), dp(10), dp(16), dp(10))
            lst = OnClickListener(lambda *_, k=key, r=row, e=eye: self._toggle_hidden(k, r, e, pal))
            self._listeners.append(lst)
            eye.setOnClickListener(lst)
            row.addView(eye)
            lp = LinearLayout.LayoutParams(-1, dp(56))
            lp.bottomMargin = dp(8)
            box.addView(row, lp)
            rows[key] = row
            self._attach_drag(grip, key, rows, stride, ctx, body, pal)

    def _toggle_hidden(self, key, row, eye, pal):
        if key in self._hidden:
            self._hidden = [k for k in self._hidden if k != key]
        else:
            if len(self._hidden) >= len(BLOCK_KEYS) - 1:
                return  # хотя бы один блок остаётся
            self._hidden = self._hidden + [key]
        self._save_layout()
        hide = key in self._hidden
        row.setAlpha(0.45 if hide else 1.0)
        eye.setText("Скрыт" if hide else "Показан")
        eye.setTextColor(signed(pal["sub"] if hide else pal["primary"]))

    def _attach_drag(self, grip, key, rows, stride, ctx, body, pal):
        """Перетаскивание без смены родителя: строки сдвигаются translationY, порядок фиксируется на отпускании."""
        from java import dynamic_proxy, jclass
        plugin = self
        state = {"y0": 0.0, "idx": 0, "target": 0, "order": []}

        class _T(dynamic_proxy(jclass("android.view.View$OnTouchListener"))):
            def onTouch(s, v, event):
                try:
                    act = int(event.getActionMasked())
                    n = len(plugin._order)
                    if act == 0:
                        state["y0"] = float(event.getRawY())
                        state["order"] = list(plugin._order)
                        state["idx"] = state["order"].index(key)
                        state["target"] = state["idx"]
                        if plugin._scroll is not None:
                            plugin._scroll.requestDisallowInterceptTouchEvent(True)
                        r = rows[key]
                        r.setElevation(float(plugin._dp(10)))
                        r.bringToFront()
                        return True
                    if act == 2:
                        dy = float(event.getRawY()) - state["y0"]
                        idx = state["idx"]
                        dy = max(-idx * stride, min((n - 1 - idx) * stride, dy))
                        target = max(0, min(n - 1, int(round(idx + dy / stride))))
                        state["target"] = target
                        rows[key].setTranslationY(dy)
                        virtual = reorder(state["order"], key, target)
                        for k, r in rows.items():
                            if k == key:
                                continue
                            r.setTranslationY(float((virtual.index(k) - state["order"].index(k)) * stride))
                        return True
                    if act in (1, 3):
                        if act == 1 and state["target"] != state["idx"]:
                            plugin._order = reorder(state["order"], key, state["target"])
                            plugin._save_layout()
                        for r in rows.values():
                            r.setTranslationY(0.0)
                            r.setElevation(0.0)
                        plugin._fill_body(ctx, body, pal)
                        return True
                except Exception as exc:
                    plugin._note_error("drag", exc)
                return True

        t = _T()
        self._listeners.append(t)
        grip.setOnTouchListener(t)

    def _lp(self, l, t, r, b):
        from android.widget import LinearLayout
        lp = LinearLayout.LayoutParams(-1, -2)
        lp.setMargins(self._dp(l), self._dp(t), self._dp(r), self._dp(b))
        return lp

    def _add_slider(self, ctx, body, pal, key, title, lo, hi, step, unit):
        from android.widget import LinearLayout, SeekBar
        from android.content.res import ColorStateList
        from java import dynamic_proxy, jclass
        dp = self._dp
        head = LinearLayout(ctx)
        head.setOrientation(LinearLayout.HORIZONTAL)
        name = self._label(ctx, title, 15, pal["ink"])
        value = self._label(ctx, "", 14, pal["primary"], True)
        head.addView(name, LinearLayout.LayoutParams(0, -2, 1.0))
        head.addView(value)
        body.addView(head, self._lp(0, 12, 0, 0))
        sb = SeekBar(ctx)
        n = int(round((hi - lo) / step))
        sb.setMax(n)
        sb.setProgressTintList(ColorStateList.valueOf(signed(pal["primary"])))
        sb.setThumbTintList(ColorStateList.valueOf(signed(pal["primary"])))
        sb.setProgressBackgroundTintList(ColorStateList.valueOf(signed(pal["track"])))
        plugin = self

        class _L(dynamic_proxy(jclass("android.widget.SeekBar$OnSeekBarChangeListener"))):
            def onProgressChanged(s, bar, progress, from_user):
                if not from_user:
                    return
                v = lo + progress * step
                if unit != "x":
                    v = int(round(v))
                else:
                    v = round(v, 2)
                plugin._set_param(key, v)

            def onStartTrackingTouch(s, bar):
                pass

            def onStopTrackingTouch(s, bar):
                pass

        l = _L()
        self._listeners.append(l)
        sb.setOnSeekBarChangeListener(l)
        body.addView(sb, LinearLayout.LayoutParams(-1, -2))
        self._ui["sliders"][key] = (sb, value, lo, step, unit)

    def _attach_band_touch(self, track, fill, index):
        from java import dynamic_proxy, jclass
        plugin = self

        class _T(dynamic_proxy(jclass("android.view.View$OnTouchListener"))):
            def onTouch(s, v, event):
                try:
                    v.getParent().requestDisallowInterceptTouchEvent(True)
                    h = max(1, int(v.getHeight()))
                    y = float(event.getY())
                    gain = int(clamp(round((1.0 - 2.0 * y / h) * 100.0 / 5.0) * 5, -100, 100))
                    plugin._set_eq(index, gain)
                except Exception as exc:
                    plugin._note_error("band touch", exc)
                return True

        t = _T()
        self._listeners.append(t)
        track.setOnTouchListener(t)

    def _auto_text(self):
        if not self._auto_bass:
            return "Выключен"
        return "Включён: " + AUTO_NAMES[self._auto_level] + (" • подстраивается под трек" if self._adaptive else "")

    def _cycle_auto(self, view):
        if not self._auto_bass:
            self._auto_bass, self._auto_level = True, 0
        elif self._auto_level < 2:
            self._auto_level += 1
        else:
            self._auto_bass = False
        self.set_setting(K_AUTO_BASS, self._auto_bass)
        self.set_setting(K_AUTO_LEVEL, self._auto_level)
        view.setText(self._auto_text())
        self._apply_all()
        self._refresh_buttons()

    # -- действия из меню
    def _set_enabled(self, on):
        self._enabled = on
        self.set_setting(K_ENABLED, on)
        if on:
            self._key = None
            run_on_ui_thread(self._tick)
        else:
            self._release_all(restore_speed=True)
        self._refresh_buttons()

    def _choose_preset(self, idx):
        self._preset = idx
        if idx > 0:
            self._params = merge_params(PRESETS[idx][2])
        self._save_params()
        self._apply_all()
        self._refresh_ui()
        self._refresh_buttons()

    def _set_param(self, key, value):
        self._params[key] = value
        self._preset = 0
        self._save_params()
        self._apply_all()
        self._refresh_ui(skip=key)
        self._refresh_buttons()

    def _set_eq(self, index, gain):
        self._params["eq"][index] = int(gain)
        self._preset = 0
        self._save_params()
        self._apply_all()
        self._refresh_ui()
        self._refresh_buttons()

    def _refresh_buttons(self):
        for f in list(self._dviews):
            try:
                self._inject_dialogs(f)
            except Exception:
                pass
        for b in list(self._buttons):
            try:
                parent = b.getParent()
                if parent is not None:
                    self._on_context_view(parent)
            except Exception:
                pass

    def _refresh_ui(self, skip=None):
        """Подсветить выбранные пресеты, обновить ползунки, полосы и реверберацию."""
        try:
            pal = self._pal()
            dp = self._dp
            for i, chip in enumerate(self._ui.get("chips", [])):
                sel = i == self._preset
                chip.setBackground(self._round(pal["pc"] if sel else pal["high"], 20))
                chip.setTextColor(signed(pal["on_pc"] if sel else pal["ink"]))
            for key, (sb, value, lo, step, unit) in self._ui.get("sliders", {}).items():
                v = self._params[key]
                if key != skip:
                    sb.setProgress(int(round((v - lo) / step)))
                value.setText(("%.2f×" % v) if unit == "x" else ("%d%%" % int(v)))
            for i, chip in enumerate(self._ui.get("revs", [])):
                sel = i == self._params["rev"]
                chip.setBackground(self._round(pal["pc"] if sel else pal["high"], 20))
                chip.setTextColor(signed(pal["on_pc"] if sel else pal["ink"]))
            for i, (track, fill) in enumerate(self._ui.get("eq", [])):
                h = max(1, int(track.getHeight()) or dp(140))
                frac = (self._params["eq"][i] + 100) / 200.0
                lp = fill.getLayoutParams()
                lp.height = max(dp(10), int(h * frac))
                fill.setLayoutParams(lp)
        except Exception as exc:
            self._note_error("refresh ui", exc)

    # -- настройки плагина
    def _changed(self, key, value):
        self.set_setting(key, value)
        self._load_state()
        if key in (K_AUTO_BASS, K_AUTO_LEVEL, K_ADAPTIVE):
            self._apply_all()
        if key == K_ENABLED and not value:
            run_on_ui_thread(lambda: self._release_all(restore_speed=True))
        self._refresh_buttons()

    def _open_edit(self, view=None):
        self._edit = True
        self._quiet = False
        run_on_ui_thread(self._build_menu)

    def _reset_look(self, view=None):
        for k, v in ((K_THEME, 0), (K_ACCENT, ""), (K_MODE, 0), (K_RADIUS, 0), (K_COMPACT, False),
                     (K_STATUS, True), (K_ORDER, ""), (K_HIDDEN, "")):
            self.set_setting(k, v)
        self._load_state()
        if self._dialog is not None:
            self._edit = False
            self._rebuild()

    def _save_layout(self):
        self.set_setting(K_ORDER, json.dumps(self._order))
        self.set_setting(K_HIDDEN, json.dumps(self._hidden))

    def _set_look(self, key, value):
        if key == "__compact":
            key, value = K_COMPACT, bool(value)
        self.set_setting(key, value)
        self._load_state()
        self._rebuild()

    def _reset_all(self, view=None):
        for k in (K_PRESET, K_PARAMS):
            self.set_setting(k, 1 if k == K_PRESET else "")
        self._load_state()
        run_on_ui_thread(lambda: (self._apply_all(), self._refresh_buttons()))

    def _diag_page(self):
        return [
            Header(text="Диагностика"),
            Text(text="Состояние: " + self._status),
            Text(text="Хуки: " + (", ".join(self._hooks) or "нет")),
            Text(text="Эффекты: " + (", ".join(sorted(self._fx)) or "не подключены")),
            Text(text="Сессия звука: " + (str(self._key[1]) if self._key else "—")),
            Text(text="Бас трека: " + ("%.2f" % self._ratio if self._ratio is not None else "не измерен")),
            Text(text="Ошибок: %d" % self._errors),
            Text(text="Скорость/тон: " + self._info.get("speed", "не менялись")),
            Text(text="Эквалайзер: " + self._info.get("eq", "—")),
            Text(text="BassBoost поддержан: " + self._info.get("bass_ok", "—")),
            Text(text="Virtualizer поддержан: " + self._info.get("virt_ok", "—")),
            Text(text="Кнопка в мини-плеере: " + self._info.get("btn", "ещё не вызывалась")),
            Text(text="Кнопка в шапке чатов: " + self._info.get("hdr", "ещё не вызывалась")),
            Text(text="Сессия через: " + self._info.get("sid_via", "не найдена")),
            Text(text="Поиск: " + self._info.get("found", "—")),
            Text(text="Класс: " + self._info.get("cls", "—")),
            Text(text="Глубокий поиск: " + self._info.get("deep", "не нашёл")),
            Text(text="Поле audioSessionId: " + self._info.get("fld", "—")),
        ] + [Text(text=chunk) for e in (self._log[-4:] or ["ошибок нет"]) for chunk in _wrap(e)]

    def create_settings(self) -> List[Any]:
        gs = self.get_setting
        return [
            Header(text="AudioStudio"),
            Switch(key=K_ENABLED, text="Включить эффекты", default=True,
                   subtext="Эквалайзер и эффекты для музыки в Telegram.",
                   icon="msg_play", on_change=lambda v: self._changed(K_ENABLED, bool(v))),
            Text(text="Открыть эквалайзер", subtext="Работает, пока в Telegram играет аудио. Кнопка есть и в мини-плеере под шапкой.",
                 icon="msg_settings", on_click=self.open_menu),
            Divider(text="Автоматический бас"),
            Switch(key=K_AUTO_BASS, text="Добавлять бас автоматически", default=True,
                   subtext="Усиление баса применяется ко всем трекам без ручной настройки.",
                   icon="msg_voice", on_change=lambda v: self._changed(K_AUTO_BASS, bool(v))),
            Selector(key=K_AUTO_LEVEL, text="Сила", default=int(clamp(int(gs(K_AUTO_LEVEL, 1) or 0), 0, 2)),
                     items=AUTO_NAMES, icon="msg_settings",
                     on_change=lambda v: self._changed(K_AUTO_LEVEL, int(v))),
            Switch(key=K_ADAPTIVE, text="Подстраивать под трек", default=False,
                   subtext="Если в треке уже много баса, добавляется меньше. Измеряется во время игры.",
                   icon="msg_stats", on_change=lambda v: self._changed(K_ADAPTIVE, bool(v))),
            Divider(text="Кнопка и голосовые"),
            Switch(key=K_HEADER, text="Кнопка в шапке списка чатов", default=True,
                   subtext="Значок эквалайзера слева от замка: открывает меню в один тап, даже без музыки.",
                   icon="msg_media", on_change=lambda v: self._changed(K_HEADER, bool(v))),
            Switch(key=K_BUTTON, text="Кнопка в мини-плеере", default=True,
                   subtext="Значок эквалайзера в мини-плеере под шапкой чата.",
                   icon="msg_media", on_change=lambda v: self._changed(K_BUTTON, bool(v))),
            Switch(key=K_VOICE, text="Применять к голосовым", default=False,
                   subtext="По умолчанию эффекты только для музыки.",
                   icon="msg_voice", on_change=lambda v: self._changed(K_VOICE, bool(v))),
            Divider(text="Оформление эквалайзера"),
            Selector(key=K_THEME, text="Цветовая тема", default=self._theme,
                     items=[n for n, _ in THEMES], icon="msg_theme",
                     on_change=lambda v: self._changed(K_THEME, int(v))),
            Input(key=K_ACCENT, text="Свой цвет (HEX)", default=self._accent,
                  subtext="Например: 7C4DFF. Работает, когда выбрана тема «Свой цвет».",
                  icon="msg_edit", on_change=lambda v: self._changed(K_ACCENT, str(v or ""))),
            Selector(key=K_MODE, text="Светлая или тёмная", default=self._mode,
                     items=MODE_NAMES, icon="msg_theme",
                     on_change=lambda v: self._changed(K_MODE, int(v))),
            Selector(key=K_RADIUS, text="Скругление", default=self._radius,
                     items=RADIUS_NAMES, icon="msg_settings",
                     on_change=lambda v: self._changed(K_RADIUS, int(v))),
            Switch(key=K_COMPACT, text="Компактный вид", default=False,
                   subtext="Меньше отступы и ниже полосы эквалайзера.",
                   icon="msg_settings", on_change=lambda v: self._changed(K_COMPACT, bool(v))),
            Switch(key=K_STATUS, text="Строка состояния в меню", default=True,
                   subtext="Показывает, подключены ли эффекты к плееру.",
                   icon="msg_info", on_change=lambda v: self._changed(K_STATUS, bool(v))),
            Text(text="Перетащить блоки", subtext="Откроет меню в режиме правки: ≡ перетаскивает, глаз скрывает блок.",
                 icon="msg_edit", on_click=self._open_edit),
            Text(text="Сбросить оформление", red=True, icon="msg_reset", on_click=self._reset_look),
            Divider(),
            Text(text="Диагностика", subtext="Подключённые эффекты и ошибки", icon="msg_info",
                 create_sub_fragment=self._diag_page),
            Text(text="Сбросить эффекты", red=True, icon="msg_reset", on_click=self._reset_all),
            Text(text="Как это работает",
                 subtext="Плагин подключает системные звуковые эффекты Android к плееру Telegram и меняет скорость и тон воспроизведения. Файлы не изменяются."),
        ]
