# -*- coding: utf-8 -*-
"""
AudioStudio для exteraGram
Эквалайзер и эффекты для аудио, которое играет в Telegram: автоматический бас, версии slowed, reverb,
speed up и nightcore, ручные ползунки скорости, тона, баса и объёма, полосы эквалайзера.
Кнопка находится в мини-плеере под шапкой (там, где название трека и кнопка скорости).
Меню в стиле Material 3 Expressive.
Target: exteraGram 12.5.1+, SDK 1.4.3.3.
"""
import colorsys
import json
import math
import struct
from typing import Any, List

from android_utils import OnClickListener, run_on_ui_thread
from base_plugin import BasePlugin, MethodHook
from hook_utils import find_class
from ui.settings import Header, Divider, Switch, Selector, Text, Input

