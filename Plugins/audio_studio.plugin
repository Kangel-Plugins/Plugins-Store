                on_primary=0xFFFFFFFF, pc=0xFFEADDFF, on_pc=0xFF21005D, outline=0xFFCAC4D0, track=0xFFE8DEF8),
}


BLOCKS = [("presets", "Пресеты"), ("sound", "Звук"), ("reverb", "Реверберация"),
          ("eq", "Эквалайзер"), ("auto", "Автоматический бас")]
BLOCK_KEYS = [k for k, _ in BLOCKS]
THEMES = [("Классика", 0x6750A4), ("Океан", 0x1E88E5), ("Лес", 0x2E9E5B), ("Закат", 0xF4743B),
          ("Роза", 0xE91E7A), ("Графит", 0x8A8A8A), ("Как в Telegram", None), ("Свой цвет", None)]
