BTN_TAG = "audio_studio_button"
BTN_TAG2 = "audio_studio_header_button"
AUTO_LEVELS = [40, 65, 90]
AUTO_NAMES = ["Лёгкий (40%)", "Средний (65%)", "Сильный (90%)"]
REVERBS = ["нет", "комната", "средняя", "большая", "зал", "большой зал", "пластина"]   # индексы PresetReverb
REVERB_CONST = [0, 1, 2, 3, 4, 5, 6]
EQ_FREQ_HINT = ["низ", "", "середина", "", "верх"]

# параметры эффектов: spd/pit — скорость и тон (множители), bass/virt/loud — проценты, rev — индекс реверберации,
# eq — 5 полос от низких к высоким, от -100 до 100
BASE = {"spd": 1.0, "pit": 1.0, "bass": 0, "virt": 0, "rev": 0, "loud": 0, "eq": [0, 0, 0, 0, 0]}
PRESETS = [
    ("Свой", "✎", None),
    ("Обычный", "◎", {}),
    ("Бас", "♨", {"bass": 90, "loud": 15, "eq": [60, 30, 0, 0, 10]}),
    ("Slowed", "◐", {"spd": 0.85, "pit": 0.85, "bass": 35}),
    ("Slowed + Reverb", "❂", {"spd": 0.85, "pit": 0.85, "bass": 45, "virt": 30, "rev": 5}),
    ("Speed Up", "➤", {"spd": 1.25, "pit": 1.25, "bass": 20}),
    ("Nightcore", "☾", {"spd": 1.35, "pit": 1.35, "eq": [-10, 0, 10, 30, 40]}),
    ("Lo-fi", "☁", {"spd": 0.95, "pit": 0.95, "rev": 1, "eq": [25, 20, 0, -40, -70]}),
    ("Концерт", "★", {"virt": 85, "rev": 4, "bass": 25}),
    ("Вокал", "♪", {"eq": [-20, -10, 40, 30, 10]}),
    ("Бас + Slowed", "▼", {"spd": 0.88, "pit": 0.88, "bass": 100, "loud": 20, "eq": [70, 35, 0, -10, -10]}),
]
SLIDERS = [  # ключ, название, минимум, максимум, шаг, подпись
    ("spd", "Скорость", 0.5, 2.0, 0.05, "x"),
    ("pit", "Тон (высота звука)", 0.5, 2.0, 0.05, "x"),
    ("bass", "Бас", 0, 100, 1, "%"),
    ("virt", "Объём (3D)", 0, 100, 1, "%"),
    ("loud", "Громкость +", 0, 100, 1, "%"),
]


def _wrap(text, n=38):
    """Интерфейс настроек обрезает длинные подписи: режем текст на короткие строки."""
    text = str(text)
    return [text[i:i + n] for i in range(0, min(len(text), n * 5), n)] or [""]


def clamp(v, lo, hi):
    return lo if v < lo else hi if v > hi else v


def merge_params(preset_values):
    p = dict(BASE)
    p["eq"] = list(BASE["eq"])
    for k, v in (preset_values or {}).items():
        p[k] = list(v) if k == "eq" else v
    return p


def sanitize(raw):
    """Достаёт параметры из словаря (например, из сохранённого JSON) и приводит к допустимым значениям."""
    p = merge_params({})
    try:
        p["spd"] = clamp(float(raw.get("spd", 1.0)), 0.5, 2.0)
        p["pit"] = clamp(float(raw.get("pit", 1.0)), 0.5, 2.0)
        for k in ("bass", "virt", "loud"):
            p[k] = int(clamp(int(raw.get(k, 0)), 0, 100))
        p["rev"] = int(clamp(int(raw.get("rev", 0)), 0, 6))
        eq = list(raw.get("eq", [0] * 5))[:5]
        eq += [0] * (5 - len(eq))
        p["eq"] = [int(clamp(int(x), -100, 100)) for x in eq]
    except Exception:
        return merge_params({})
    return p


def effective(p, auto_bass, auto_level, adaptive_bass):
    """К параметрам добавляется автоматический бас: не ниже выбранного уровня (и не ниже подобранного под трек)."""
    q = dict(p)
    q["eq"] = list(p["eq"])
    if auto_bass:
        q["bass"] = max(q["bass"], AUTO_LEVELS[int(clamp(auto_level, 0, 2))], adaptive_bass or 0)
    return q


def mix_eq(p):
    """Бас и 3D дублируются через полосы эквалайзера: системные BassBoost/Virtualizer есть не на всех телефонах."""
    g = [float(x) for x in p["eq"]]
    b, v = p["bass"], p["virt"]
    g[0] += b * 1.0
    g[1] += b * 0.55
    g[2] -= b * 0.05
    g[3] += v * 0.30
    g[4] += v * 0.45
    g[0] -= v * 0.10
    return [int(clamp(x, -100, 100)) for x in g]


def virt_reverb(p):
    """Если 3D включён, а реверберация нет, добавляем лёгкое пространство."""
    if p["rev"] or p["virt"] < 15:
        return p["rev"]
    return 1 if p["virt"] < 40 else 3 if p["virt"] < 75 else 4


def is_neutral_playback(p):
    return abs(p["spd"] - 1.0) < 0.001 and abs(p["pit"] - 1.0) < 0.001


def eq_levels(gains, bands, lo, hi):
    """5 ручных полос -> уровни миллибелов для любого числа полос устройства (линейная интерполяция по частоте)."""
    out = []
    for i in range(bands):
        pos = (i / float(bands - 1)) * 4.0 if bands > 1 else 2.0
        a = int(math.floor(pos))
        b = min(4, a + 1)
        t = pos - a
        g = gains[a] * (1 - t) + gains[b] * t   # -100..100
        mid = (lo + hi) / 2.0
        half = (hi - lo) / 2.0
        out.append(int(clamp(mid + half * g / 100.0, lo, hi)))
    return out


def adaptive_bass_percent(ratio):
    """Чем больше баса уже в треке (ratio = энергия баса / энергия середины), тем меньше добавляем."""
    if ratio is None:
        return 0
    t = clamp((2.5 - ratio) / (2.5 - 0.7), 0.25, 1.0)
    return int(round(100 * t))


def to_signed(fft):
    try:
        data = bytes(fft)
        return struct.unpack("%db" % len(data), data)
    except Exception:
        return [int(x) for x in fft]


def band_mean(fft, sampling_mhz, lo, hi):
    n = len(fft)
    if n < 8 or sampling_mhz <= 0:
        return 0.0
    hz = (sampling_mhz / 1000.0) / float(n)
    k0 = max(1, int(math.ceil(lo / hz)))
    k1 = min(n // 2 - 1, int(math.floor(hi / hz)))
    if k1 < k0:
        return 0.0
    total = 0.0
    for k in range(k0, k1 + 1):
        re, im = float(fft[2 * k]), float(fft[2 * k + 1])
        total += math.sqrt(re * re + im * im)
    return total / (k1 - k0 + 1)


def read_field(obj, name):
    c = obj.getClass()
    while c is not None:
        try:
            f = c.getDeclaredField(name)
            f.setAccessible(True)
            return f.get(obj)
        except Exception:
            c = c.getSuperclass()
    return None


def signed(color):
    color &= 0xFFFFFFFF
    return color - 0x100000000 if color & 0x80000000 else color


