def short_err(err):
    err = str(err or "ошибка").strip()
    if "Traceback" in err:
        err = [x for x in err.splitlines() if x.strip()][-1]
    if "exec disabled" in err:
        return "exec выключен: включи «Разрешить exec» в настройках плагина"
    if err == "bad token":
        return "неверный токен: заново нажми «Подключить Termux» в плагине"
    return err


def vis(s):
    return len(ANSI.sub("", s))


def box(lines, color=ACC):
    w = max(vis(x) for x in lines)
    print(color + "╭" + "─" * (w + 2) + "╮" + R)
    for x in lines:
        print(color + "│" + R + " " + x + " " * (w - vis(x)) + " " + color + "│" + R)
    print(color + "╰" + "─" * (w + 2) + "╯" + R)


def port_open():
    try:
        socket.create_connection((HOST, PORT), timeout=0.5).close()
        return True
    except OSError:
        return False


def quiet(cmd):
    p = subprocess.run(cmd, shell=True, capture_output=True, text=True)
    return p.returncode == 0 and "Error" not in p.stdout + p.stderr


def launch_extera():
    if port_open():
        return True
    print(MUT + "◌ запускаю exteraGram в фоне…" + R)
    started = quiet("am start --user 0 -a android.intent.action.MAIN -c android.intent.category.LAUNCHER -p " + PKG)
    if not started:
        started = quiet("monkey -p " + PKG + " -c android.intent.category.LAUNCHER 1")
    if not started:
        print(ERR + "✖ не удалось запустить " + PKG + R + MUT + "  (открой Telegram вручную)" + R)
        return False
    for _ in range(60):
        if port_open():
            break
        time.sleep(0.5)
    else:
        print(ERR + "✖ плагин не ответил за 30 секунд" + R)
        return False
    time.sleep(1.0)
    quiet("am start --user 0 -n com.termux/com.termux.app.TermuxActivity")
    print(OK + "✔ exteraGram запущен" + R)
    return True


class Bridge:
    def __init__(self):
        self.sock = None
        self.buf = b""
        self.launched = False
        self.lock = threading.RLock()

    def connect(self):
        self.close()
        s = socket.create_connection((HOST, PORT), timeout=3)
        s.settimeout(120)
        self.sock = s
        self.buf = b""

    def close(self):
        if self.sock is not None:
            try:
                self.sock.close()
            except OSError:
                pass
        self.sock = None

    def roundtrip(self, payload):
        self.sock.sendall(payload)
        while b"\n" not in self.buf:
            chunk = self.sock.recv(65536)
            if not chunk:
                raise ConnectionError("closed")
            self.buf += chunk
        line, self.buf = self.buf.split(b"\n", 1)
        return json.loads(line.decode("utf-8"))

    def send(self, cmd, **kw):
        kw.update(cmd=cmd, token=TOKEN, sid=SID)
        payload = (json.dumps(kw, ensure_ascii=False) + "\n").encode("utf-8")
        with self.lock:
            for attempt in (0, 1):
                try:
                    if self.sock is None:
                        self.connect()
                    return self.roundtrip(payload)
                except ConnectionRefusedError:
                    if self.launched or os.environ.get("TGB_AUTOSTART") == "0":
                        raise
                    self.launched = True
                    if not launch_extera():
                        raise
                except OSError:
                    self.close()
                    if attempt:
                        raise


_bridge = None


def get_bridge():
    global _bridge
    if _bridge is None:
        _bridge = Bridge()
    return _bridge


def check(r):
    if not r.get("ok"):
        raise RuntimeError(short_err(r.get("error")))
    return r


def show(text, **kw):
    check(get_bridge().send("show", text=str(text), **{"pos": state["pos"], **kw}))


def notify(text, kind="info"):
    check(get_bridge().send("notify", text=str(text), kind=kind))


def clip(text):
    check(get_bridge().send("clip", text=str(text)))


def tg(code):
    r = check(get_bridge().send("exec", code=code, overlay=True))
    if r.get("output"):
        print(r["output"], end="")


def call(cb, *args):
    try:
        n = len(inspect.signature(cb).parameters)
    except (TypeError, ValueError):
        n = len(args)
    return cb(*args[:n])


def drop_callbacks(pid):
    for k in [k for k in CALLBACKS if k[0] == pid]:
        CALLBACKS.pop(k, None)


class Events:
    def __init__(self):
        self.sock = None
        self.thread = None

    def alive(self):
        return self.thread is not None and self.thread.is_alive()

    def start(self):
        if self.alive():
            return
        s = socket.create_connection((HOST, PORT), timeout=3)
        s.settimeout(None)
        hello = {"cmd": "subscribe", "token": TOKEN, "sid": SID}
        s.sendall((json.dumps(hello) + "\n").encode("utf-8"))
        self.sock = s
        self.thread = threading.Thread(target=self.loop, args=(s,), daemon=True)
        self.thread.start()

    def loop(self, s):
        buf = b""
        try:
            while True:
                chunk = s.recv(65536)
                if not chunk:
                    return
                buf += chunk
                while b"\n" in buf:
                    line, buf = buf.split(b"\n", 1)
                    try:
                        ev = json.loads(line.decode("utf-8"))
                    except ValueError:
                        continue
                    if "event" in ev:
                        self.dispatch(ev)
        except OSError:
            return

    def dispatch(self, ev):
        kind, pid, iid = ev.get("event"), ev.get("panel"), ev.get("id")
        if kind == "jcall":
            cb = CALLBACKS.get(("j", ev.get("h"), ev.get("method")))
            args = tuple(dec(a) for a in ev.get("args") or [])
        elif kind == "close":
            OPEN.discard(pid)
            cb = CALLBACKS.get((pid, None, "close"))
            drop_callbacks(pid)
            args = ()
        else:
            cb = CALLBACKS.get((pid, iid, kind))
            args = (ev["value"],) if "value" in ev else ()
        if cb is None:
            return
        try:
            call(cb, *args)
        except Exception as e:
            print("\r" + ERR + "✖ callback: " + str(e) + R)


EVENTS = Events()


def wait():
    try:
        while OPEN and EVENTS.alive():
            time.sleep(0.2)
    except KeyboardInterrupt:
        pass


class JavaError(RuntimeError):
    pass


class Cast:
    def __init__(self, kind, value):
        self.kind, self.value = kind, value


class Arr:
    def __init__(self, kind, values):
        self.kind, self.values = kind, list(values)


def enc(v):
    if isinstance(v, JObj):
        return {"$h": v.h}
    if isinstance(v, Cast):
        return {"$cast": v.kind, "v": v.value}
    if isinstance(v, Arr):
        return {"$arr": v.kind, "v": [enc(x) for x in v.values]}
    if isinstance(v, (list, tuple)):
        return [enc(x) for x in v]
    return v


def dec(v):
    if isinstance(v, dict) and "$h" in v:
        return JObj(v["$h"], v.get("t", ""))
    if isinstance(v, list):
        return [dec(x) for x in v]
    return v


class JMethod:
    def __init__(self, obj, name):
        self.obj, self.name = obj, name

    def __call__(self, *args):
        return JAVA.rpc("j_call", h=self.obj.h, name=self.name, args=[enc(a) for a in args])


class JObj:
    __slots__ = ("h", "t", "__weakref__")

    def __init__(self, h, t=""):
        object.__setattr__(self, "h", h)
        object.__setattr__(self, "t", t)

    def __getattr__(self, name):
        if name.startswith("__"):
            raise AttributeError(name)
        return JMethod(self, name)

    def __setattr__(self, name, value):
        JAVA.rpc("j_set", h=self.h, name=name, value=enc(value))

    def __call__(self, *args):
        return JAVA.rpc("j_new", h=self.h, args=[enc(a) for a in args])

    def __str__(self):
        return JAVA.rpc("j_str", h=self.h)

    def __iter__(self):
        return iter(JAVA.rpc("j_list", h=self.h))

    def __repr__(self):
        return "<java %s #%s>" % (self.t or "object", self.h)

    def __del__(self):
        try:
            JAVA.pending.append(self.h)
        except Exception:
            pass


GRAV = {
    "top_start": 51, "top": 49, "top_end": 53, "center": 17,
    "bottom_start": 83, "bottom": 81, "bottom_end": 85,
}


class Java:
    def __init__(self):
        self.pending = []
        self.meta = None
        self.classes = {}

    def rpc(self, cmd, **kw):
        if self.pending:
            kw["release"], self.pending = self.pending, []
        r = get_bridge().send(cmd, **kw)
        if not r.get("ok"):
            raise JavaError(short_err(r.get("error")))
        return dec(r.get("r"))

    def cls(self, name):
        c = self.classes.get(name)
        if c is None:
            c = self.classes[name] = self.rpc("j_cls", name=name)
        return c

    def new(self, name, *args):
        return self.cls(name)(*args)

    def activity(self):
        return self.rpc("j_activity")

    def info(self):
        if self.meta is None:
            self.meta = check(get_bridge().send("j_info"))
        return self.meta

    def dp(self, value):
        return int(round(value * float(self.info()["density"])))

    def get(self, obj, name):
        return self.rpc("j_get", h=obj.h, name=name)

    def set(self, obj, name, value):
        self.rpc("j_set", h=obj.h, name=name, value=enc(value))

    def const(self, cls_name, field):
        return self.get(self.cls(cls_name), field)

    def str(self, obj):
        return self.rpc("j_str", h=obj.h)

    def list(self, obj):
        return self.rpc("j_list", h=obj.h)

    def array(self, kind, values):
        return Arr(kind, values)

    def i(self, v):
        return Cast("int", v)

    def f(self, v):
        return Cast("float", v)

    def d(self, v):
        return Cast("double", v)

    def l(self, v):
        return Cast("long", v)

    def b(self, v):
        return Cast("boolean", v)

    def listener(self, iface, returns=None, **handlers):
        EVENTS.start()
        proxy = self.rpc("j_listener", iface=iface, methods=sorted(handlers), returns=returns or {})
        for name, fn in handlers.items():
            CALLBACKS[("j", proxy.h, name)] = fn
        return proxy

    def add_view(self, view, x=None, y=None, gravity="top_start", width=None, height=None, keep=False):
        def size(v):
            if v is None:
                return -2
            return -1 if v == "match" else self.dp(v)

        g = GRAV.get(gravity, 51) if isinstance(gravity, str) else int(gravity)
        px = None if x is None else self.dp(x)
        py = None if x is None and y is None else self.dp(y or 0)
        self.rpc("j_add_view", h=view.h, x=px, y=py, gravity=g, w=size(width), ht=size(height), keep=bool(keep))

    def remove_view(self, view):
        self.rpc("j_remove_view", h=view.h)

    def toast(self, text, long=False):
        Toast = self.cls("android.widget.Toast")
        Toast.makeText(self.activity(), str(text), 1 if long else 0).show()

    def vibrate(self, ms=50):
        vib = self.activity().getSystemService("vibrator")
        vib.vibrate(self.cls("java.lang.Long").parseLong(str(int(ms))))


JAVA = Java()
java = JAVA


class Panel:
    def __init__(self, title="", pos="bottom_end", width=260, x=None, y=None, keep=False, id=None):
        self.id = id or "p" + os.urandom(3).hex()
        self.opts = {"title": title, "pos": pos, "width": width, "keep": keep}
        if x is not None:
            self.opts.update(x=x, y=y or 0)
        self.items = []
        self.stack = [self.items]
        self.n = 0

    def add(self, kind, event, cb, id, **props):
        self.n += 1
        iid = id or "i%d" % self.n
        item = {"type": kind, "id": iid}
        item.update({k: v for k, v in props.items() if v is not None})
        self.stack[-1].append(item)
        if cb is not None and event:
            CALLBACKS[(self.id, iid, event)] = cb
        return iid

    def text(self, text, id=None, size=None, color=None, mono=None):
        return self.add("text", None, None, id, text=text, size=size, color=color, mono=mono)

    def button(self, text, callback=None, id=None, color=None):
        return self.add("button", "click", callback, id, text=text, color=color)

    def toggle(self, text, callback=None, value=False, id=None):
        return self.add("toggle", "toggle", callback, id, text=text, value=value)

    def slider(self, text, lo, hi, value=None, callback=None, step=1, id=None):
        start = lo if value is None else value
        return self.add("slider", "slide", callback, id, text=text, min=lo, max=hi, value=start, step=step)

    def input(self, hint, callback=None, button="OK", id=None, clear=True):
        return self.add("input", "submit", callback, id, hint=hint, button=button, clear=clear)

    @contextlib.contextmanager
    def row(self):
        group = {"type": "row", "items": []}
        self.stack[-1].append(group)
        self.stack.append(group["items"])
        try:
            yield self
        finally:
            self.stack.pop()

    def on_close(self, callback):
        CALLBACKS[(self.id, None, "close")] = callback
        return self

    def show(self):
        EVENTS.start()
        spec = dict(self.opts)
        spec.update(id=self.id, items=self.items)
        check(get_bridge().send("panel", **spec))
        OPEN.add(self.id)
        return self

    def set(self, id, **props):
        check(get_bridge().send("set", panel=self.id, id=id, **props))

    def close(self):
        get_bridge().send("close", panel=self.id)
        OPEN.discard(self.id)
        drop_callbacks(self.id)


def banner(b):
    try:
        b.send("ping")
        st = OK + "● подключено" + R
    except OSError:
        st = ERR + "● плагин не отвечает" + R
    box([
        B + ACC + "◆ Telegram Bridge" + R + MUT + "  v" + VER + R,
        st + MUT + "  " + HOST + ":" + str(PORT) + R,
        MUT + "help — список команд" + R,
    ])


def show_help(b, rest):
    rows = [
        ("<python-код>", "Python в Termux → экран Telegram"),
        ("<команда>", "shell: ls, echo… (или !команда)"),
        ("ai <запрос>", "нейросеть пишет и запускает скрипт"),
        ("btn <текст> = <команда>", "кнопка на экране Telegram"),
        ("show <текст>", "текст поверх экрана"),
        ("notify <текст>", "уведомление в Telegram"),
        ("copy <текст>", "в буфер обмена"),
        ("ball [цвет] [размер]", "двигаемый шарик, ball off — убрать"),
        ("run <файл.py>", "запустить файл, вывод на экран"),
        ("tg <код>", "Python внутри Telegram (exec)"),
        ("tgrun <файл.py>", "файл внутри Telegram (exec)"),
        ("pos <место>", "top · bottom · center …"),
        ("docs", "документация (api, ui, java, ai)"),
        ("start", "запустить exteraGram в фоне"),
        ("clear", "убрать оверлей"),
        ("status", "диагностика"),
        ("exit", "выйти"),
    ]
    cols = shutil.get_terminal_size((48, 20)).columns
    w = max(len(r[0]) for r in rows)
    wide = w + 2 + max(len(r[1]) for r in rows) + 4 <= cols
    lines = []
    for a, d in rows:
        if wide:
            lines.append(ACC + B + a.ljust(w) + R + "  " + MUT + d + R)
        else:
            lines.append(ACC + B + a + R)
            lines.append(MUT + "  " + d + R)
    box(lines, MUT)


def offline():
    box([
        ERR + B + "✖ Плагин не отвечает" + R,
        MUT + "1. Открой Telegram (exteraGram)" + R,
        MUT + "2. Настройки → Плагины → Termux Bridge" + R,
        MUT + "3. Включи плагин и «Сервер включён»" + R,
    ], ERR)


def reply(r):
    if r.get("output"):
        print(TXT + r["output"].rstrip("\n") + R)
    if r.get("ok"):
        print(OK + "✔" + R)
        return True
    print(ERR + "✖ " + short_err(r.get("error")) + R)
    return False


def cmd_status(b, rest):
    r = b.send("diag")
    if not r.get("ok"):
        reply(r)
        return

    def row(ok, text, hint=""):
        mark = OK + "✔" if ok is True else (ERR + "✖" if ok is False else MUT + "○")
        return mark + R + " " + TXT + text + R + (MUT + "  " + hint + R if hint else "")

    ai_ok = bool(r.get("ai"))
    box([
        row(True, "плагин %s · порт %s" % (r.get("version"), r.get("port"))),
        row(bool(r.get("screen")), "экран Telegram", "" if r.get("screen") else "открой exteraGram"),
        row(True if r.get("exec") else None, "exec и Java", "включены" if r.get("exec") else "выключены"),
        row(ai_ok if not ai_ok or r.get("ai_key") else None, "нейросеть",
            "не настроена" if not ai_ok else ("" if r.get("ai_key") else "ключ не задан")),
        row(True, "панелей на экране: %s" % r.get("panels", 0)),
    ])


def cmd_start(b, rest):
    if port_open():
        print(OK + "✔ exteraGram уже запущен" + R)
    else:
        launch_extera()


def cmd_show(b, rest):
    args = shlex.split(rest)
    opts, words, it = {}, [], iter(args)
    for a in it:
        if a in ("--pos", "--title", "--timeout"):
            opts[a[2:]] = next(it, "")
        else:
            words.append(a)
    if "timeout" in opts:
        opts["timeout"] = float(opts["timeout"] or 0)
    opts.setdefault("pos", state["pos"])
    reply(b.send("show", text=" ".join(words), **opts))


def cmd_notify(b, rest):
    kind = "info"
    head = rest.split(None, 1)
    if head and head[0] in ("info", "success", "error"):
        kind, rest = head[0], (head[1] if len(head) > 1 else "")
    reply(b.send("notify", text=rest, kind=kind))


def cmd_copy(b, rest):
    reply(b.send("clip", text=rest))


def cmd_sh(b, command):
    if not command:
        print(MUT + "использование: !<команда>" + R)
        return
    b.send("clear")
    p = subprocess.Popen(
        command, shell=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
        text=True, errors="replace", bufsize=1,
    )
    try:
        for line in p.stdout:
            line = line.rstrip("\n")
            print(MUT + line + R)
            b.send("append", text=line, pos=state["pos"])
        code = p.wait()
    except KeyboardInterrupt:
        p.terminate()
        code = -2
    b.send("append", text="— exit %d —" % code, pos=state["pos"])
    print(OK + "✔" + R if code == 0 else ERR + "✖ код выхода %d" % code + R)


def cmd_run(b, rest):
    path = os.path.expanduser(rest.strip())
    if not os.path.isfile(path):
        print(ERR + "✖ файл не найден" + R)
        return
    cmd_sh(b, "python3 " + shlex.quote(path))


def cmd_py(b, code):
    buf = io.StringIO()
    failed = False
    try:
        try:
            node, mode = compile(code, "<tgb>", "eval"), "eval"
        except SyntaxError:
            node, mode = compile(code, "<tgb>", "exec"), "exec"
        with contextlib.redirect_stdout(buf), contextlib.redirect_stderr(buf):
            val = eval(node, NS)
            if mode == "eval" and val is not None:
                print(repr(val))
    except Exception as e:
        failed = True
        buf.write("%s: %s" % (type(e).__name__, e))
    text = buf.getvalue().rstrip("\n")
    if text:
        print((ERR if failed else TXT) + text + R)
    else:
        print(OK + "✔" + R)
    if failed:
        b.send("show", text="✖ " + text, pos=state["pos"], timeout=6)
    elif text and not API_USE.search(code):
        b.send("show", text=text, pos=state["pos"])


def cmd_tg(b, code):
    reply(b.send("exec", code=code, overlay=True))


def cmd_tgrun(b, rest):
    path = os.path.expanduser(rest.strip())
    if not os.path.isfile(path):
        print(ERR + "✖ файл не найден" + R)
        return
    with open(path, encoding="utf-8") as f:
        cmd_tg(b, f.read())


def cmd_pos(b, rest):
    name = rest.strip()
    if name in POSITIONS:
        state["pos"] = name
        print(OK + "✔ " + R + MUT + "позиция: " + name + R)
    else:
        print(MUT + "варианты: " + ", ".join(POSITIONS) + R)


def cmd_ball(b, rest):
    opts = {}
    for a in rest.split():
        k = a.lower()
        if k in ("off", "убрать", "выкл"):
            reply(b.send("ball", off=True))
            return
        if k in COLORS:
            opts["color"] = COLORS[k]
        elif k.startswith("#"):
            opts["color"] = a
        elif k.isdigit():
            opts["size"] = int(k)
    reply(b.send("ball", **opts))


def cmd_clear(b, rest):
    reply(b.send("clear"))


def cmd_pipe(b, rest):
    b.send("clear")
    for line in sys.stdin:
        b.send("append", text=line.rstrip("\n"), pos=state["pos"])


def cmd_cd(b, rest):
    try:
        os.chdir(os.path.expanduser(rest.strip() or "~"))
        print(MUT + os.getcwd() + R)
    except OSError as e:
        print(ERR + "✖ " + str(e) + R)


def run_quick(label, command):
    try:
        p = subprocess.run(command, shell=True, capture_output=True, text=True, errors="replace", timeout=30)
        out = (p.stdout + p.stderr).strip() or "✔"
        code = p.returncode
    except subprocess.TimeoutExpired:
        out, code = "превышено время (30 с)", -1
    get_bridge().send("show", title=label + ("" if code == 0 else " ✖"), text=out, pos="top", timeout=8)


def build_quick():
    panel = Panel("Кнопки", pos="bottom_end", id="quick")
    for i, (label, command) in enumerate(QUICK):
        panel.button(label, lambda l=label, c=command: run_quick(l, c), id="b%d" % i)
    panel.show()


def cmd_btn(b, rest):
    rest = rest.strip()
    if rest in ("clear", "off", "убрать"):
        QUICK.clear()
        Panel(id="quick").close()
        print(OK + "✔ " + R + MUT + "кнопки убраны" + R)
        return
    if not rest or rest == "list":
        for i, (label, command) in enumerate(QUICK, 1):
            print(ACC + str(i) + R + " " + TXT + label + R + MUT + "  →  " + command + R)
        if not QUICK:
            print(MUT + "использование: btn <текст> = <команда>" + R)
        return
    if "=" in rest:
        label, command = [x.strip() for x in rest.split("=", 1)]
    else:
        label = command = rest
    if not label or not command:
        print(ERR + "✖ нужен текст и команда: btn Пинг = ping -c1 8.8.8.8" + R)
        return
    QUICK.append((label, command))
    build_quick()
    print(OK + "✔ " + R + MUT + "кнопка добавлена: " + label + R)


def cmd_docs(b, rest):
    key = rest.strip().lower()
    if key == "ai show":
        r = b.send("ai_docs")
        print(TXT + str(r.get("text", r.get("error", ""))) + R)
        return
    sections = DOCS.get(key)
    if sections is None:
        print(MUT + "разделы: docs · docs api · docs ui · docs java · docs ai · docs ai show" + R)
        return
    cols = max(30, shutil.get_terminal_size((48, 20)).columns - 4)
    for head, body in sections:
        print(ACC + B + "▎" + head + R)
        for line in textwrap.wrap(body, cols):
            print("  " + TXT + line + R)
        print()
    if not key:
        print(MUT + "docs api · docs ui · docs java · docs ai · docs ai show" + R)


class Tee:
    def __init__(self):
        self.buf = io.StringIO()

    def write(self, s):
        self.buf.write(s)
        sys.__stdout__.write(s)
        sys.__stdout__.flush()
        return len(s)

    def flush(self):
        pass


def pick_code(text):
    m = re.search(r"```(?:python|py)?[ \t]*\n(.*?)```", text, re.S)
    return m.group(1).rstrip() if m else None


def plain(text):
    return re.sub(r"```.*?```", "", text, flags=re.S).strip()


def exec_code(b, code):
    tee = Tee()
    err = ""
    try:
        with contextlib.redirect_stdout(tee), contextlib.redirect_stderr(tee):
            exec(compile(code, "<ai>", "exec"), NS)
    except KeyboardInterrupt:
        err = "прервано"
    except Exception as e:
        err = "%s: %s" % (type(e).__name__, e)
    out = tee.buf.getvalue().strip()
    if err:
        print(ERR + "✖ " + err + R)
        b.send("show", text="✖ " + err, pos=state["pos"], timeout=6)
        return
    if out and not API_USE.search(code):
        b.send("show", text=out, pos=state["pos"])
    print(OK + "✔" + R)


def cmd_ai(b, rest):
    rest = rest.strip()
    if rest in ("reset", "сброс"):
        HISTORY.clear()
        print(OK + "✔ " + R + MUT + "диалог очищен" + R)
        return
    if not rest:
        print(MUT + "использование: ai <что сделать>   (ai reset — забыть диалог)" + R)
        return
    print(MUT + "◌ думаю…" + R)
    r = b.send("ai", prompt=rest, history=HISTORY[-10:])
    if not r.get("ok"):
        reply(r)
        return
    text = str(r.get("text", ""))
    HISTORY.extend([{"role": "user", "content": rest}, {"role": "assistant", "content": text}])
    code = pick_code(text)
    note = plain(text)
    if note:
        print(TXT + note + R)
    if code is None:
        if note:
            b.send("show", title="AI", text=note[:600], pos=state["pos"])
        return
    lines = code.split("\n")
    for line in lines[:40]:
        print(ACC + "▎" + R + MUT + line + R)
    if len(lines) > 40:
        print(MUT + "… ещё %d строк" % (len(lines) - 40) + R)
    try:
        ans = input("\001" + ACC + "\002Выполнить? [y/N] \001" + R + "\002")
    except (EOFError, KeyboardInterrupt):
        print()
        return
    if ans.strip().lower() in ("y", "yes", "д", "да"):
        exec_code(b, code)


COMMANDS = {
    "help": show_help, "?": show_help, "h": show_help,
    "status": cmd_status, "ping": cmd_status, "doctor": cmd_status,
    "start": cmd_start,
    "show": cmd_show,
    "notify": cmd_notify,
    "copy": cmd_copy,
    "btn": cmd_btn,
    "ai": cmd_ai,
    "docs": cmd_docs,
    "ball": cmd_ball,
    "sh": cmd_sh,
    "run": cmd_run,
    "py": cmd_py,
    "tg": cmd_tg,
    "tgrun": cmd_tgrun,
    "pos": cmd_pos,
    "clear": cmd_clear,
    "pipe": cmd_pipe,
    "cd": cmd_cd,
}


def is_shell(line):
    first = line.split(None, 1)[0]
    if keyword.iskeyword(first):
        return False
    if shutil.which(first):
        return True
    for mode in ("eval", "exec"):
        try:
            compile(line, "<tgb>", mode)
            return False
        except SyntaxError:
            continue
    return True


def dispatch(b, line):
    line = line.strip()
    if not line:
        return
    if line.startswith("!"):
        cmd_sh(b, line[1:].strip())
        return
    word = line.split(None, 1)[0]
    rest = line[len(word):].strip()
    handler = COMMANDS.get(word.lower())
    if handler is not None:
        handler(b, rest)
    elif is_shell(line):
        cmd_sh(b, line)
    else:
        cmd_py(b, line)


def setup_ns(b):
    NS.update(b=b, show=show, notify=notify, clip=clip, tg=tg, Panel=Panel, wait=wait, java=JAVA)


def shell(b):
    try:
        import readline
    except ImportError:
        pass
    prompt = "\001" + ACC + B + "\002tgb \001" + MUT + "\002❯ \001" + R + "\002"
    banner(b)
    while True:
        try:
            line = input(prompt).strip()
        except (EOFError, KeyboardInterrupt):
            print()
            break
        if line in ("exit", "quit", "q"):
            break
        try:
            dispatch(b, line)
        except ConnectionRefusedError:
            offline()
        except KeyboardInterrupt:
            print()
        except Exception as e:
            print(ERR + "✖ " + str(e) + R)


def main():
    b = get_bridge()
    setup_ns(b)
    if len(sys.argv) > 1:
        argv = sys.argv[1:]
        if argv[0] in ("sh", "py", "tg", "ai", "btn", "notify", "copy"):
            line = " ".join(argv)
        else:
            line = " ".join(shlex.quote(a) for a in argv)
        try:
            dispatch(b, line)
            if argv[0] == "btn" and OPEN:
                print(MUT + "кнопки активны, Ctrl+C — выйти" + R)
                wait()
        except ConnectionRefusedError:
            offline()
            sys.exit(1)
        return
    shell(b)


if __name__ == "__main__":
    main()
'''

class UIError(Exception):
    pass


class Plugin(BasePlugin):
    def on_plugin_load(self):
        self._srv = None
        self._stop = threading.Event()
        self._panel = None
        self._lines = []
        self._opts = dict(DEFAULTS)
        self._gen = 0
        self._port = 42691
        self._pair_until = 0.0
        self._proxies = {}
        self._ball = None
        self._ball_pos = None
        self._subs = {}
        self._subs_lock = threading.Lock()
        self._panels = {}
        self._silent = False
        self._handles = {}
        self._hid = 0
        self._hlock = threading.Lock()
        self._jviews = []
        if not self.get_setting("token", ""):
            self.set_setting("token", secrets.token_hex(8))
        if self.get_setting("enabled", True):
            self._start()

    def on_plugin_unload(self):
        self._shutdown()
        run_on_ui_thread(self._ui_cleanup)

    def create_settings(self) -> List[Any]:
        return [
            Header(text="Подключение"),
            Text(text="Подключить Termux", icon="msg_link", on_click=self._pair),
            Text(text="Проверить оверлей", on_click=self._self_test),
            Header(text="Сервер"),
            Switch(
                key="enabled",
                text="Сервер включён",
                default=True,
                on_change=self._on_enabled,
            ),
            Input(
                key="port",
                text="Порт",
                subtext="После смены нажми «Перезапустить сервер»",
                default="42691",
            ),
            Text(text="Перезапустить сервер", on_click=lambda *a: self._start()),
            Header(text="Нейросеть"),
            Input(
                key="ai_endpoint",
                text="Эндпоинт",
                subtext="OpenAI-совместимый адрес (.../chat/completions или базовый .../v1)",
                default=AI_URL,
            ),
            Input(key="ai_key", text="API-ключ", subtext="Хранится в настройках плагина", default=""),
            Input(key="ai_model", text="Модель", default=AI_MODEL),
            Input(
                key="ai_extra",
                text="Доп. инструкции для ИИ",
                subtext="Добавляются к документации для нейросети",
                default="",
            ),
            Text(text="Проверить нейросеть", on_click=self._ai_test),
            Text(text="Скопировать документацию для ИИ", on_click=self._ai_copy_docs),
            Header(text="Безопасность"),
            Input(
                key="token",
                text="Токен",
                default=self.get_setting("token", ""),
            ),
            Switch(
                key="allow_exec",
                text="Разрешить exec и Java",
                subtext="Python и Java-вызовы из Termux выполняются внутри процесса ExteraGram",
                default=False,
            ),
        ]

    def _on_enabled(self, value):
        if value:
            self._start()
        else:
            self._shutdown()
            run_on_ui_thread(self._ui_cleanup)

    def _self_test(self, *a):
        threading.Thread(
            target=lambda: self._safe(self._cmd_show, {"text": "Termux Bridge работает", "timeout": 3, "mono": False}),
            daemon=True,
        ).start()

    def _safe(self, fn, msg):
        try:
            fn(msg)
        except UIError as e:
            run_on_ui_thread(lambda: self._toast("error", str(e)))
        except Exception:
            log("termux_bridge: self-test failed\n" + traceback.format_exc())

    def _pair(self, *a):
        if self._srv is None:
            self._start()
        self._pair_until = time.time() + 300
        cmd = "pkg install -y python curl && curl -s 127.0.0.1:%d/i | python" % self._port
        run_on_ui_thread(lambda: self._pair_dialog(cmd))

    def _pair_dialog(self, cmd):
        try:
            from ui.alert import AlertDialogBuilder

            activity = get_last_fragment().getParentActivity()
            builder = AlertDialogBuilder(activity)
            builder.set_title("Подключить Termux")
            builder.set_message("Скопируй команду и вставь в Termux. Окно подключения открыто 5 минут.\n\n" + cmd)
            builder.set_positive_button("Копировать", lambda bld, which: self._copy(activity, cmd, bld))
            builder.set_negative_button("Закрыть", lambda bld, which: bld.dismiss())
            builder.show()
        except Exception:
            log("termux_bridge: dialog failed\n" + traceback.format_exc())

    def _copy(self, activity, text, bld):
        try:
            ClipData = jclass("android.content.ClipData")
            activity.getSystemService("clipboard").setPrimaryClip(ClipData.newPlainText("tgbridge", text))
            bld.dismiss()
            self._toast("info", "Команда скопирована")
        except Exception:
            log("termux_bridge: copy failed\n" + traceback.format_exc())

    def _start(self):
        self._shutdown()
        try:
            port = int(self.get_setting("port", "42691"))
        except Exception:
            port = 42691
        srv = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        try:
            srv.bind(("127.0.0.1", port))
            srv.listen(8)
        except Exception as e:
            log(f"termux_bridge: bind failed on {port}: {e}")
            srv.close()
            return
        srv.settimeout(1.0)
        self._srv = srv
        self._port = port
        self._stop = threading.Event()
        threading.Thread(target=self._accept, args=(srv, self._stop), daemon=True).start()
        log(f"termux_bridge: listening on 127.0.0.1:{port}")

    def _shutdown(self):
        self._stop.set()
        if self._srv is not None:
            try:
                self._srv.close()
            except Exception:
                pass
            self._srv = None

    def _accept(self, srv, stop):
        while not stop.is_set():
            try:
                conn, _ = srv.accept()
            except socket.timeout:
                continue
            except OSError:
                break
            threading.Thread(target=self._client, args=(conn, stop), daemon=True).start()

    def _client(self, conn, stop):
        try:
            self._client_loop(conn, stop)
        finally:
            self._drop_conn(conn)

    def _client_loop(self, conn, stop):
        conn.settimeout(1.0)
        buf = b""
        with conn:
            while not stop.is_set():
                try:
                    chunk = conn.recv(65536)
                except socket.timeout:
                    continue
                except OSError:
                    return
                if not chunk:
                    return
                buf += chunk
                if buf.startswith(b"GET "):
                    self._http(conn, buf)
                    return
                if len(buf) > 4 * 1024 * 1024:
                    return
                while b"\n" in buf:
                    line, buf = buf.split(b"\n", 1)
                    if not line.strip():
                        continue
                    reply = self._handle(line, conn)
                    try:
                        conn.sendall((json.dumps(reply, ensure_ascii=False) + "\n").encode("utf-8"))
                    except OSError:
                        return

    def _http(self, conn, head):
        try:
            path = head.split(b" ", 2)[1].decode("ascii", "ignore")
        except Exception:
            path = ""
        if path == "/i" and time.time() < self._pair_until:
            self._pair_until = 0.0
            status = "200 OK"
            body = self._installer()
            run_on_ui_thread(self._paired)
        else:
            status = "403 Forbidden"
            body = "print('Окно подключения закрыто. Нажми «Подключить Termux» в настройках плагина.')\n"
        data = body.encode("ascii", "backslashreplace")
        header = (
            "HTTP/1.1 %s\r\nContent-Type: text/plain\r\nContent-Length: %d\r\nConnection: close\r\n\r\n"
            % (status, len(data))
        )
        try:
            conn.sendall(header.encode("ascii") + data)
        except OSError:
            pass

    def _paired(self):
        self._toast("success", "Termux подключён")

    def _installer(self):
        src = CLIENT.replace("@@PORT@@", str(self._port)).replace("@@TOKEN@@", str(self.get_setting("token", "")))
        return INSTALLER.replace("@@SRC@@", ascii(src))

    def _handle(self, raw, conn=None):
        try:
            msg = json.loads(raw.decode("utf-8"))
            token = str(self.get_setting("token", ""))
            if not secrets.compare_digest(str(msg.get("token", "")), token):
                return {"ok": False, "error": "bad token"}
            cmd = str(msg.get("cmd"))
            if cmd == "subscribe":
                return self._subscribe(str(msg.get("sid", "")), conn)
            fn = getattr(self, "_cmd_" + cmd, None)
            if fn is None:
                return {"ok": False, "error": "unknown cmd"}
            return fn(msg)
        except UIError as e:
            return {"ok": False, "error": str(e)}
        except Exception:
            log("termux_bridge: command failed\n" + traceback.format_exc())
            return {"ok": False, "error": traceback.format_exc()}

    def _subscribe(self, sid, conn):
        with self._subs_lock:
            self._subs.setdefault(sid, []).append(conn)
        return {"ok": True}

    def _drop_conn(self, conn):
        gone = []
        with self._subs_lock:
            for sid, conns in list(self._subs.items()):
                if conn in conns:
                    conns.remove(conn)
                    if not conns:
                        del self._subs[sid]
                        gone.append(sid)
        for sid in gone:
            run_on_ui_thread(lambda s=sid: self._owner_cleanup(s))

    def _owner_cleanup(self, sid):
        for pid, entry in list(self._panels.items()):
            if entry["owner"] == sid and not entry["keep"]:
                self._panel_detach(pid)
        for item in [v for v in self._jviews if v["owner"] == sid and not v["keep"]]:
            self._jview_detach(item["view"])
            self._jviews.remove(item)
        with self._hlock:
            for hid in [h for h, e in self._handles.items() if e["owner"] == sid]:
                del self._handles[hid]

    def _emit(self, owner, event):
        with self._subs_lock:
            conns = list(self._subs.get(owner, []))
        data = (json.dumps(event, ensure_ascii=False) + "\n").encode("utf-8")
        for conn in conns:
            try:
                conn.sendall(data)
            except OSError:
                self._drop_conn(conn)

    def _on_ui(self, fn, timeout=5.0):
        done = threading.Event()
        box = {}

        def run():
            try:
                box["r"] = fn()
            except Exception as e:
                box["e"] = e
                if not isinstance(e, UIError):
                    log("termux_bridge: ui failed\n" + traceback.format_exc())
            finally:
                done.set()

        run_on_ui_thread(run)
        if not done.wait(timeout):
            raise UIError("интерфейс Telegram не ответил")
        err = box.get("e")
        if err is not None:
            if isinstance(err, UIError):
                raise err
            raise UIError("%s: %s" % (type(err).__name__, err))
        return box.get("r")

    def _activity(self):
        fragment = get_last_fragment()
        activity = fragment.getParentActivity() if fragment else None
        if activity is None:
            raise UIError("нет активного окна Telegram: открой exteraGram")
        return activity

    def _color(self, value, default):
        Color = jclass("android.graphics.Color")
        try:
            return Color.parseColor(str(value))
        except Exception:
            return Color.parseColor(default)

    def _rounded(self, color, radius, d):
        shape = jclass("android.graphics.drawable.GradientDrawable")()
        shape.setColor(color)
        shape.setCornerRadius(float(radius) * d)
        return shape

    def _apply_opts(self, msg):
        for k in DEFAULTS:
            if k in msg:
                self._opts[k] = msg[k]

    def _cmd_ping(self, msg):
        return {"ok": True, "pong": True}

    def _cmd_diag(self, msg):
        info = {
            "ok": True,
            "version": __version__,
            "port": self._port,
            "exec": bool(self.get_setting("allow_exec", False)),
            "ai": bool(self._ai_url() and str(self.get_setting("ai_model", AI_MODEL)).strip()),
            "ai_key": bool(str(self.get_setting("ai_key", "")).strip()),
            "panels": len(self._panels),
        }
        try:
            self._on_ui(self._activity)
            info["screen"] = True
        except UIError:
            info["screen"] = False
        return info

    def _cmd_show(self, msg):
        self._opts = dict(DEFAULTS)
        self._apply_opts(msg)
        self._lines = str(msg.get("text", "")).split("\n")
        self._trim()
        self._on_ui(self._render)
        return {"ok": True}

    def _cmd_append(self, msg):
        self._apply_opts(msg)
        self._push(str(msg.get("text", "")))
        return {"ok": True}

    def _cmd_clear(self, msg):
        self._lines = []
        self._opts = dict(DEFAULTS)
        self._on_ui(self._remove)
        return {"ok": True}

    def _cmd_notify(self, msg):
        text, kind = str(msg.get("text", "")), str(msg.get("kind", "info"))
        self._on_ui(lambda: self._notify(kind, text))
        return {"ok": True}

    def _notify(self, kind, text):
        from ui.bulletin import BulletinHelper

        if kind == "success":
            BulletinHelper.show_success(text)
        elif kind == "error":
            BulletinHelper.show_error(text)
        else:
            BulletinHelper.show_info(text)

    def _cmd_clip(self, msg):
        text = str(msg.get("text", ""))
        self._on_ui(lambda: self._clip(text))
        return {"ok": True}

    def _clip(self, text):
        ClipData = jclass("android.content.ClipData")
        self._activity().getSystemService("clipboard").setPrimaryClip(ClipData.newPlainText("tgbridge", text))

    def _cmd_exec(self, msg):
        if not self.get_setting("allow_exec", False):
            return {"ok": False, "error": "exec disabled in plugin settings"}
        out = io.StringIO()
        ns = {
            "ui": run_on_ui_thread,
            "jclass": jclass,
            "fragment": get_last_fragment,
            "show": lambda text, **kw: self._cmd_show({"text": text, **kw}),
            "append": self._push,
            "clear": lambda: self._cmd_clear({}),
            "notify": lambda text, kind="info": self._cmd_notify({"text": text, "kind": kind}),
        }
        import java as jv

        for name in ("jint", "jfloat", "jdouble", "jlong", "jboolean", "jshort", "jbyte", "jchar", "jarray", "dynamic_proxy"):
            if hasattr(jv, name):
                ns[name] = getattr(jv, name)
        ns["activity"] = self._activity
        try:
            with contextlib.redirect_stdout(out), contextlib.redirect_stderr(out):
                exec(compile(str(msg.get("code", "")), "<termux>", "exec"), ns)
        except Exception:
            out.write(traceback.format_exc())
            return {"ok": False, "error": "exception", "output": out.getvalue()}
        text = out.getvalue()
        if msg.get("overlay") and text.strip():
            self._push(text.rstrip("\n"))
        return {"ok": True, "output": text}

    def _need_exec(self):
        if not self.get_setting("allow_exec", False):
            raise UIError("exec disabled in plugin settings")

    def _next_hid(self):
        with self._hlock:
            self._hid += 1
            return self._hid

    def _jreg(self, obj, owner, hid=None):
        if hid is None:
            hid = self._next_hid()
        with self._hlock:
            if len(self._handles) > 50000:
                raise UIError("слишком много Java-объектов")
            self._handles[hid] = {"obj": obj, "owner": owner}
        return hid

    def _jget(self, hid):
        entry = self._handles.get(int(hid))
        if entry is None:
            raise UIError("Java-объект уже освобождён")
        return entry["obj"]

    def _jenc(self, obj, owner, kind=None):
        if obj is None or isinstance(obj, (bool, int, float, str)):
            return obj
        hid = self._jreg(obj, owner)
        if kind is None:
            try:
                kind = str(obj.getClass().getName())
            except Exception:
                kind = "object"
        return {"$h": hid, "t": kind}

    def _jtype(self, kind):
        import java as jv

        names = {
            "int": "jint", "float": "jfloat", "double": "jdouble", "long": "jlong",
            "short": "jshort", "byte": "jbyte", "char": "jchar", "boolean": "jboolean",
        }
        if kind in names:
            return getattr(jv, names[kind])
        return jclass("java.lang.String" if kind == "String" else kind)

    def _jdec(self, value, owner):
        if isinstance(value, dict):
            if "$h" in value:
                return self._jget(value["$h"])
            if "$cast" in value:
                return self._jtype(str(value["$cast"]))(self._jdec(value.get("v"), owner))
            if "$arr" in value:
                import java as jv

                items = [self._jdec(x, owner) for x in value.get("v") or []]
                return jv.jarray(self._jtype(str(value["$arr"])))(items)
            return value
        if isinstance(value, list):
            return [self._jdec(x, owner) for x in value]
        return value

    def _jcmd(self, msg, fn):
        self._need_exec()
        owner = str(msg.get("sid") or "")

        def run():
            for hid in msg.get("release") or []:
                self._handles.pop(int(hid), None)
            return fn(owner)

        return {"ok": True, "r": self._on_ui(run)}

    def _cmd_j_info(self, msg):
        def run():
            activity = self._activity()
            metrics = activity.getResources().getDisplayMetrics()
            return {
                "density": float(metrics.density),
                "width": int(metrics.widthPixels),
                "height": int(metrics.heightPixels),
                "sdk": int(jclass("android.os.Build$VERSION").SDK_INT),
                "package": str(activity.getPackageName()),
            }

        info = self._on_ui(run)
        info["ok"] = True
        return info

    def _cmd_j_cls(self, msg):
        name = str(msg.get("name", ""))
        return self._jcmd(msg, lambda o: self._jenc(jclass(name), o, "class"))

    def _cmd_j_activity(self, msg):
        return self._jcmd(msg, lambda o: self._jenc(self._activity(), o))

    def _cmd_j_call(self, msg):
        def run(o):
            target = self._jget(msg.get("h"))
            args = [self._jdec(a, o) for a in msg.get("args") or []]
            return self._jenc(getattr(target, str(msg.get("name")))(*args), o)

        return self._jcmd(msg, run)

    def _cmd_j_new(self, msg):
        def run(o):
            target = self._jget(msg.get("h"))
            args = [self._jdec(a, o) for a in msg.get("args") or []]
            return self._jenc(target(*args), o)

        return self._jcmd(msg, run)

    def _cmd_j_get(self, msg):
        def run(o):
            return self._jenc(getattr(self._jget(msg.get("h")), str(msg.get("name"))), o)

        return self._jcmd(msg, run)

    def _cmd_j_set(self, msg):
        def run(o):
            setattr(self._jget(msg.get("h")), str(msg.get("name")), self._jdec(msg.get("value"), o))

        return self._jcmd(msg, run)

    def _cmd_j_str(self, msg):
        return self._jcmd(msg, lambda o: str(self._jget(msg.get("h"))))

    def _cmd_j_list(self, msg):
        return self._jcmd(msg, lambda o: [self._jenc(x, o) for x in self._jget(msg.get("h"))])

    def _cmd_j_listener(self, msg):
        iface = str(msg.get("iface", ""))
        names = [str(n) for n in msg.get("methods") or []]
        returns = msg.get("returns") or {}

        def run(o):
            import types

            from java import dynamic_proxy

            hid = self._next_hid()
            plugin = self

            def make(name):
                def method(this, *args):
                    try:
                        plugin._emit(o, {
                            "event": "jcall", "h": hid, "method": name,
                            "args": [plugin._jenc(a, o) for a in args],
                        })
                    except Exception:
                        log("termux_bridge: listener failed\n" + traceback.format_exc())
                    return returns.get(name)

                method.__name__ = name
                return method

            methods = {n: make(n) for n in names}
            base = dynamic_proxy(jclass(iface))
            proxy_cls = types.new_class("TgbListener", (base,), {}, lambda ns: ns.update(methods))
            self._jreg(proxy_cls(), o, hid)
            return {"$h": hid, "t": iface}

        return self._jcmd(msg, run)

    def _cmd_j_add_view(self, msg):
        def run(o):
            view = self._jget(msg.get("h"))
            activity = self._activity()
            FrameLayout = jclass("android.widget.FrameLayout")
            lp = FrameLayout.LayoutParams(int(msg.get("w", -2)), int(msg.get("ht", -2)))
            lp.gravity = int(msg.get("gravity", 51))
            parent = view.getParent()
            if parent is not None:
                parent.removeView(view)
            activity.getWindow().getDecorView().addView(view, lp)
            if msg.get("x") is not None:
                view.setX(float(msg["x"]))
                view.setY(float(msg.get("y") or 0))
            self._jviews = [v for v in self._jviews if v["view"] is not view]
            self._jviews.append({"view": view, "owner": o, "keep": bool(msg.get("keep"))})

        return self._jcmd(msg, run)

    def _cmd_j_remove_view(self, msg):
        def run(o):
            view = self._jget(msg.get("h"))
            self._jview_detach(view)
            self._jviews = [v for v in self._jviews if v["view"] is not view]

        return self._jcmd(msg, run)

    def _jview_detach(self, view):
        try:
            parent = view.getParent()
            if parent is not None:
                parent.removeView(view)
        except Exception as e:
            log(f"termux_bridge: view remove failed: {e}")

    def _cmd_ball(self, msg):
        if msg.get("off"):
            self._on_ui(self._ball_remove)
            return {"ok": True}
        color = str(msg.get("color") or "#FFD600")
        try:
            size = max(24, min(int(msg.get("size") or 56), 200))
        except Exception:
            size = 56
        self._on_ui(lambda: self._ball_build(color, size))
        return {"ok": True}

    def _cmd_panel(self, msg):
        pid = str(msg.get("id") or "panel")
        owner = str(msg.get("sid") or "")
        self._on_ui(lambda: self._panel_build(pid, msg, owner))
        return {"ok": True, "id": pid}

    def _cmd_set(self, msg):
        pid, iid = str(msg.get("panel", "")), str(msg.get("id", ""))
        self._on_ui(lambda: self._item_set(pid, iid, msg))
        return {"ok": True}

    def _cmd_close(self, msg):
        pid = str(msg.get("panel", ""))
        self._on_ui(lambda: self._panel_detach(pid))
        return {"ok": True}

    def _ai_url(self):
        url = str(self.get_setting("ai_endpoint", AI_URL)).strip().rstrip("/")
        if url and not url.endswith("/chat/completions"):
            url += "/chat/completions"
        return url

    def _ai_system(self):
        extra = str(self.get_setting("ai_extra", "")).strip()
        return AI_DOCS + ("\nUSER NOTES\n" + extra + "\n" if extra else "")

    def _ai_call(self, messages):
        import urllib.error
        import urllib.request

        url = self._ai_url()
        model = str(self.get_setting("ai_model", AI_MODEL)).strip()
        key = str(self.get_setting("ai_key", "")).strip()
        if not url or not model:
            raise ValueError("нейросеть не настроена: Настройки плагина → Нейросеть")
        headers = {"Content-Type": "application/json", "User-Agent": "termux-bridge"}
        if key:
            headers["Authorization"] = "Bearer " + key
        body = json.dumps({"model": model, "messages": messages, "temperature": 0.2}).encode("utf-8")
        req = urllib.request.Request(url, data=body, headers=headers)
        try:
            with urllib.request.urlopen(req, timeout=60) as resp:
                data = json.loads(resp.read().decode("utf-8"))
        except urllib.error.HTTPError as e:
            detail = e.read().decode("utf-8", "replace")[:300]
            raise RuntimeError("HTTP %d: %s" % (e.code, detail))
        return str(data["choices"][0]["message"]["content"])

    def _cmd_ai(self, msg):
        history = []
        for m in (msg.get("history") or [])[-12:]:
            if isinstance(m, dict) and m.get("role") in ("user", "assistant"):
                history.append({"role": m["role"], "content": str(m.get("content", ""))[:8000]})
        messages = [{"role": "system", "content": self._ai_system()}]
        messages += history
        messages.append({"role": "user", "content": str(msg.get("prompt", ""))[:4000]})
        try:
            return {"ok": True, "text": self._ai_call(messages)}
        except Exception as e:
            return {"ok": False, "error": str(e)}

    def _cmd_ai_docs(self, msg):
        return {"ok": True, "text": self._ai_system()}

    def _ai_test(self, *a):
        def work():
            try:
                text = self._ai_call([{"role": "user", "content": "Reply with one word: ok"}])
                note = ("success", "Нейросеть отвечает: " + text.strip()[:60])
            except Exception as e:
                note = ("error", str(e)[:200])
            run_on_ui_thread(lambda: self._toast(*note))

        threading.Thread(target=work, daemon=True).start()

    def _ai_copy_docs(self, *a):
        def work():
            try:
                self._clip(self._ai_system())
                self._toast("success", "Документация для ИИ скопирована")
            except Exception:
                log("termux_bridge: clip failed\n" + traceback.format_exc())

        run_on_ui_thread(work)

    def _toast(self, kind, text):
        try:
            self._notify(kind, text)
        except Exception:
            log("termux_bridge: bulletin failed\n" + traceback.format_exc())

    def _proxy_cls(self, kind):
        cls = self._proxies.get(kind)
        if cls is not None:
            return cls
        from java import dynamic_proxy

        if kind == "click":

            class Proxy(dynamic_proxy(jclass("android.view.View$OnClickListener"))):
                def __init__(self, *fns):
                    super().__init__()
                    self.fns = fns

                def onClick(self, view):
                    self.fns[0](view)

        elif kind == "touch":

            class Proxy(dynamic_proxy(jclass("android.view.View$OnTouchListener"))):
                def __init__(self, *fns):
                    super().__init__()
                    self.fns = fns

                def onTouch(self, view, event):
                    return bool(self.fns[0](view, event))

        elif kind == "check":

            class Proxy(dynamic_proxy(jclass("android.widget.CompoundButton$OnCheckedChangeListener"))):
                def __init__(self, *fns):
                    super().__init__()
                    self.fns = fns

                def onCheckedChanged(self, button, checked):
                    self.fns[0](button, bool(checked))

        else:

            class Proxy(dynamic_proxy(jclass("android.widget.SeekBar$OnSeekBarChangeListener"))):
                def __init__(self, *fns):
                    super().__init__()
                    self.fns = fns

                def onProgressChanged(self, bar, progress, from_user):
                    self.fns[0](bar, int(progress), bool(from_user))

                def onStartTrackingTouch(self, bar):
                    pass

                def onStopTrackingTouch(self, bar):
                    self.fns[1](bar)

        self._proxies[kind] = Proxy
        return Proxy

    def _proxy(self, kind, *fns):
        return self._proxy_cls(kind)(*fns)

    def _ui_cleanup(self):
        self._remove()
        self._ball_remove()
        for pid in list(self._panels):
            self._panel_detach(pid)
        for item in self._jviews:
            self._jview_detach(item["view"])
        self._jviews = []
        with self._hlock:
            self._handles.clear()

    def _push(self, text):
        self._lines.extend(text.split("\n"))
        self._trim()
        self._on_ui(self._render)

    def _trim(self):
        n = max(1, int(self._opts.get("max_lines", 30)))
        if len(self._lines) > n:
            self._lines = self._lines[-n:]

    def _remove(self):
        panel = self._panel
        self._panel = None
        if panel is None:
            return
        try:
            parent = panel.getParent()
            if parent is not None:
                parent.removeView(panel)
        except Exception as e:
            log(f"termux_bridge: remove failed: {e}")

    def _render(self):
        activity = self._activity()
        self._remove()
        o = self._opts
        d = float(activity.getResources().getDisplayMetrics().density)
        TextView = jclass("android.widget.TextView")
        FrameLayout = jclass("android.widget.FrameLayout")
        Typeface = jclass("android.graphics.Typeface")

        body = "\n".join(self._lines)
        if o["title"]:
            body = str(o["title"]) + "\n" + body

        tv = TextView(activity)
        tv.setText(body)
        tv.setTextColor(self._color(o["fg"], "#FFFFFF"))
        tv.setTextSize(2, float(o["size"]))
        if o["mono"]:
            tv.setTypeface(Typeface.MONOSPACE)
        pad = int(10 * d)
        tv.setPadding(pad, pad, pad, pad)
        tv.setBackground(self._rounded(self._color(o["bg"], "#CC101418"), 12, d))
        tv.setOnClickListener(self._proxy("click", lambda v: self._remove()))

        pos = str(o["pos"])
        lp = FrameLayout.LayoutParams(-2, -2)
        lp.gravity = POS.get(pos, POS["top"])
        m = int(12 * d)
        top = int(48 * d) if "top" in pos else m
        bottom = int(72 * d) if "bottom" in pos else m
        lp.setMargins(m, top, m, bottom)

        activity.getWindow().getDecorView().addView(tv, lp)
        self._panel = tv

        self._gen += 1
        gen = self._gen
        timeout = float(o["timeout"])
        if timeout > 0:
            run_on_ui_thread(lambda: self._remove() if gen == self._gen else None, int(timeout * 1000))

    def _ball_remove(self):
        root = self._ball
        self._ball = None
        if root is None:
            return
        try:
            parent = root.getParent()
            if parent is not None:
                parent.removeView(root)
        except Exception as e:
            log(f"termux_bridge: ball remove failed: {e}")

    def _ball_build(self, color, size):
        activity = self._activity()
        self._ball_remove()
        metrics = activity.getResources().getDisplayMetrics()
        d = float(metrics.density)
        sw, sh = int(metrics.widthPixels), int(metrics.heightPixels)
        FrameLayout = jclass("android.widget.FrameLayout")
        View = jclass("android.view.View")
        TextView = jclass("android.widget.TextView")
        GradientDrawable = jclass("android.graphics.drawable.GradientDrawable")

        s = int(size * d)
        badge = int(24 * d)
        w = h = s + badge // 2

        root = FrameLayout(activity)
        root.setElevation(24.0 * d)

        ball = View(activity)
        oval = GradientDrawable()
        oval.setShape(1)
        oval.setColor(self._color(color, "#FFD600"))
        oval.setStroke(int(2 * d), self._color("#33000000", "#33000000"))
        ball.setBackground(oval)
        ball.setElevation(6.0 * d)
        ball_lp = FrameLayout.LayoutParams(s, s)
        ball_lp.gravity = 8388691
        root.addView(ball, ball_lp)

        close = TextView(activity)
        close.setText("✕")
        close.setTextColor(self._color("#FFFFFF", "#FFFFFF"))
        close.setTextSize(2, 11.0)
        close.setGravity(17)
        shade = GradientDrawable()
        shade.setShape(1)
        shade.setColor(self._color("#E61E2328", "#E61E2328"))
        close.setBackground(shade)
        close.setElevation(8.0 * d)
        close.setOnClickListener(self._proxy("click", lambda v: self._ball_remove()))
        close_lp = FrameLayout.LayoutParams(badge, badge)
        close_lp.gravity = 8388661
        root.addView(close, close_lp)

        root.setOnTouchListener(self._proxy("touch", self._dragger(root, w, h, sw, sh, "ball")))

        lp = FrameLayout.LayoutParams(w, h)
        lp.gravity = 51
        activity.getWindow().getDecorView().addView(root, lp)
        px, py = self._ball_pos or (sw - w - 24 * d, sh * 0.45)
        root.setX(float(px))
        root.setY(float(py))
        self._ball = root

    def _dragger(self, target, w, h, sw, sh, kind, pid=None):
        st = {}

        def on_touch(v, e):
            a = e.getActionMasked()
            if a == 0:
                st["rx"], st["ry"] = e.getRawX(), e.getRawY()
                st["x"], st["y"] = target.getX(), target.getY()
                parent = v.getParent()
                if parent is not None:
                    parent.requestDisallowInterceptTouchEvent(True)
            elif a == 2:
                nx = st["x"] + e.getRawX() - st["rx"]
                ny = st["y"] + e.getRawY() - st["ry"]
                bw, bh = int(target.getWidth() or w), int(target.getHeight() or h)
                target.setX(float(max(0.0, min(nx, float(sw - bw)))))
                target.setY(float(max(0.0, min(ny, float(sh - bh)))))
            elif a in (1, 3):
                pos = (target.getX(), target.getY())
                if kind == "ball":
                    self._ball_pos = pos
                elif pid in self._panels:
                    self._panels[pid]["pos"] = pos
            return True

        return on_touch

    def _panel_detach(self, pid):
        entry = self._panels.pop(pid, None)
        if entry is None:
            return
        try:
            parent = entry["root"].getParent()
            if parent is not None:
                parent.removeView(entry["root"])
        except Exception as e:
            log(f"termux_bridge: panel remove failed: {e}")

    def _panel_closed(self, pid):
        entry = self._panels.get(pid)
        owner = entry["owner"] if entry else ""
        self._panel_detach(pid)
        self._emit(owner, {"event": "close", "panel": pid})

    def _panel_build(self, pid, spec, owner):
        activity = self._activity()
        old = self._panels.get(pid)
        keep_pos = old["pos"] if old else None
        self._panel_detach(pid)
        metrics = activity.getResources().getDisplayMetrics()
        d = float(metrics.density)
        sw, sh = int(metrics.widthPixels), int(metrics.heightPixels)
        FrameLayout = jclass("android.widget.FrameLayout")
        LinearLayout = jclass("android.widget.LinearLayout")
        TextView = jclass("android.widget.TextView")
        MeasureSpec = jclass("android.view.View$MeasureSpec")

        w = int(float(spec.get("width", 260)) * d)
        pad = int(10 * d)

        root = LinearLayout(activity)
        root.setOrientation(1)
        root.setPadding(pad, pad, pad, pad)
        root.setBackground(self._rounded(self._color("#F01C2127", "#F01C2127"), 16, d))
        root.setElevation(24.0 * d)

        header = LinearLayout(activity)
        header.setOrientation(0)
        header.setGravity(16)
        title = TextView(activity)
        title.setText(str(spec.get("title", "")) or " ")
        title.setTextColor(self._color("#9AA4AD", "#9AA4AD"))
        title.setTextSize(2, 12.0)
        header.addView(title, LinearLayout.LayoutParams(0, -2, 1.0))
        close = TextView(activity)
        close.setText("✕")
        close.setTextColor(self._color("#9AA4AD", "#9AA4AD"))
        close.setTextSize(2, 14.0)
        close.setPadding(int(10 * d), 0, int(4 * d), 0)
        close.setOnClickListener(self._proxy("click", lambda v: self._panel_closed(pid)))
        header.addView(close, LinearLayout.LayoutParams(-2, -2))
        root.addView(header, LinearLayout.LayoutParams(-1, -2))

        reg = {}
        for item in spec.get("items") or []:
            view = self._item_view(activity, d, item, pid, owner, reg)
            lp = LinearLayout.LayoutParams(-1, -2)
            lp.setMargins(0, int(8 * d), 0, 0)
            root.addView(view, lp)

        root.measure(MeasureSpec.makeMeasureSpec(w, 1073741824), MeasureSpec.makeMeasureSpec(0, 0))
        h = int(root.getMeasuredHeight())
        header.setOnTouchListener(self._proxy("touch", self._dragger(root, w, h, sw, sh, "panel", pid)))

        if keep_pos:
            x, y = keep_pos
        elif spec.get("x") is not None:
            x, y = float(spec["x"]) * d, float(spec.get("y", 0)) * d
        else:
            pos = str(spec.get("pos", "bottom_end"))
            mg = 12 * d
            x = mg if "start" in pos else (sw - w - mg if "end" in pos else (sw - w) / 2)
            y = 48 * d if "top" in pos else (sh - h - 72 * d if "bottom" in pos else (sh - h) / 2)
        x = max(0.0, min(float(x), float(sw - w)))
        y = max(0.0, min(float(y), float(sh - h)))

        lp = FrameLayout.LayoutParams(w, -2)
        lp.gravity = 51
        activity.getWindow().getDecorView().addView(root, lp)
        root.setX(x)
        root.setY(y)
        self._panels[pid] = {
            "root": root,
            "owner": owner,
            "items": reg,
            "pos": (x, y),
            "keep": bool(spec.get("keep")),
        }

    def _button_view(self, activity, d, text, color):
        TextView = jclass("android.widget.TextView")
        tv = TextView(activity)
        tv.setText(str(text))
        tv.setTextColor(self._color("#FFFFFF", "#FFFFFF"))
        tv.setTextSize(2, 14.0)
        tv.setGravity(17)
        tv.setPadding(int(14 * d), int(10 * d), int(14 * d), int(10 * d))
        tv.setBackground(self._rounded(self._color(color or "#2F80ED", "#2F80ED"), 10, d))
        tv.setClickable(True)
        return tv

    def _item_view(self, activity, d, item, pid, owner, reg):
        LinearLayout = jclass("android.widget.LinearLayout")
        TextView = jclass("android.widget.TextView")
        kind = str(item.get("type", "text"))
        iid = str(item.get("id") or "")
        white = self._color("#FFFFFF", "#FFFFFF")

        def event(name, **extra):
            data = {"event": name, "panel": pid, "id": iid}
            data.update(extra)
            self._emit(owner, data)

        if kind == "button":
            tv = self._button_view(activity, d, item.get("text", ""), item.get("color"))
            tv.setOnClickListener(self._proxy("click", lambda v: event("click")))
            reg[iid] = {"type": kind, "view": tv}
            return tv

        if kind == "toggle":
            Switch = jclass("android.widget.Switch")
            sw = Switch(activity)
            sw.setText(str(item.get("text", "")))
            sw.setTextColor(white)
            sw.setTextSize(2, 14.0)
            sw.setChecked(bool(item.get("value", False)))

            def on_check(button, checked):
                if not self._silent:
                    event("toggle", value=checked)

            sw.setOnCheckedChangeListener(self._proxy("check", on_check))
            reg[iid] = {"type": kind, "view": sw}
            return sw

        if kind == "slider":
            SeekBar = jclass("android.widget.SeekBar")
            lo, hi = int(item.get("min", 0)), int(item.get("max", 100))
            step = max(1, int(item.get("step", 1)))
            count = max(1, (hi - lo) // step)
            start = max(0, min((int(item.get("value", lo)) - lo) // step, count))
            wrap = LinearLayout(activity)
            wrap.setOrientation(1)
            label = TextView(activity)
            label.setTextColor(white)
            label.setTextSize(2, 14.0)
            bar = SeekBar(activity)
            bar.setMax(count)
            entry = {"type": kind, "view": bar, "label": label, "text": str(item.get("text", "")), "lo": lo, "step": step}
            reg[iid] = entry
            label.setText("%s: %d" % (entry["text"], lo + start * step))
            bar.setProgress(start)
            wrap.addView(label, LinearLayout.LayoutParams(-1, -2))
            wrap.addView(bar, LinearLayout.LayoutParams(-1, -2))
            st = {"t": 0.0}

            def on_change(view, progress, from_user):
                value = entry["lo"] + progress * entry["step"]
                label.setText("%s: %d" % (entry["text"], value))
                now = time.time()
                if from_user and not self._silent and now - st["t"] >= 0.08:
                    st["t"] = now
                    event("slide", value=value)

            def on_stop(view):
                if not self._silent:
                    event("slide", value=entry["lo"] + int(view.getProgress()) * entry["step"])

            bar.setOnSeekBarChangeListener(self._proxy("seek", on_change, on_stop))
            return wrap

        if kind == "input":
            EditText = jclass("android.widget.EditText")
            row = LinearLayout(activity)
            row.setOrientation(0)
            row.setGravity(16)
            et = EditText(activity)
            et.setHint(str(item.get("hint", "")))
            et.setSingleLine(True)
            et.setTextColor(white)
            et.setHintTextColor(self._color("#77FFFFFF", "#77FFFFFF"))
            et.setTextSize(2, 14.0)
            row.addView(et, LinearLayout.LayoutParams(0, -2, 1.0))
            send = self._button_view(activity, d, item.get("button", "OK"), None)

            def on_send(view):
                text = str(et.getText().toString())
                event("submit", value=text)
                if item.get("clear", True):
                    et.setText("")

            send.setOnClickListener(self._proxy("click", on_send))
            slp = LinearLayout.LayoutParams(-2, -2)
            slp.setMargins(int(6 * d), 0, 0, 0)
            row.addView(send, slp)
            reg[iid] = {"type": kind, "view": et}
            return row

        if kind == "row":
            row = LinearLayout(activity)
            row.setOrientation(0)
            for sub in item.get("items") or []:
                view = self._item_view(activity, d, sub, pid, owner, reg)
                slp = LinearLayout.LayoutParams(0, -2, 1.0)
                slp.setMargins(int(3 * d), 0, int(3 * d), 0)
                row.addView(view, slp)
            return row

        tv = TextView(activity)
        tv.setText(str(item.get("text", "")))
        tv.setTextColor(self._color(item.get("color") or "#FFFFFF", "#FFFFFF"))
        tv.setTextSize(2, float(item.get("size") or 14))
        if item.get("mono"):
            tv.setTypeface(jclass("android.graphics.Typeface").MONOSPACE)
        reg[iid] = {"type": "text", "view": tv}
        return tv

    def _item_set(self, pid, iid, props):
        entry = self._panels.get(pid)
        if entry is None:
            raise UIError("панель не найдена: " + pid)
        it = entry["items"].get(iid)
        if it is None:
            raise UIError("элемент не найден: " + iid)
        view, kind = it["view"], it["type"]
        if "text" in props:
            if kind == "slider":
                it["text"] = str(props["text"])
                value = it["lo"] + int(view.getProgress()) * it["step"]
                it["label"].setText("%s: %d" % (it["text"], value))
            elif kind in ("text", "button", "toggle"):
                view.setText(str(props["text"]))
        if "hint" in props and kind == "input":
            view.setHint(str(props["hint"]))
        if "value" in props:
            self._silent = True
            try:
                if kind == "toggle":
                    view.setChecked(bool(props["value"]))
                elif kind == "slider":
                    view.setProgress(max(0, min((int(props["value"]) - it["lo"]) // it["step"], int(view.getMax()))))
                elif kind == "input":
                    view.setText(str(props["value"]))
            finally:
                self._silent = False
        if "enabled" in props:
            enabled = bool(props["enabled"])
            view.setEnabled(enabled)
            view.setAlpha(1.0 if enabled else 0.4)
        if "visible" in props:
            view.setVisibility(0 if props["visible"] else 8)