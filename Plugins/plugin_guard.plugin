_CLASS_CACHE = {}

def find_class(class_name: str):
    if not class_name:
        return None
    cls = _CLASS_CACHE.get(class_name)
    if cls is not None:
        return cls
    cls = _hook_find_class(class_name)
    if cls is not None:
        _CLASS_CACHE[class_name] = cls
    return cls

from android.view import View

def _is_russian() -> bool:
    try:
        from org.telegram.messenger import LocaleController
        iso = LocaleController.getLocaleStringIso639()
        if iso:
            lower = str(iso).lower()
            if lower.startswith("ru") or lower.startswith("uk") or lower.startswith("be"):
                return True
            return False
    except Exception:
        pass
    try:
        from java.util import Locale
        loc = Locale.getDefault()
        if loc and loc.getLanguage():
            lower = str(loc.getLanguage()).lower()
            if lower.startswith("ru") or lower.startswith("uk") or lower.startswith("be"):
                return True
    except Exception:
        pass
    return False

def _tr(ru: str, en: str) -> str:
    return ru if _is_russian() else en

def _plural_layers(n: int) -> str:
    if not _is_russian():
        return f"{n} layer" if n == 1 else f"{n} layers"
    n_abs = abs(n) % 100
    n1 = n_abs % 10
    if 11 <= n_abs <= 19:
        w = "слоев"
    elif n1 == 1:
        w = "слой"
    elif 2 <= n1 <= 4:
        w = "слоя"
    else:
        w = "слоев"
    return f"{n} {w}"

def _plural_code_layers(n: int) -> str:
    if not _is_russian():
        return f"{n} code layer" if n == 1 else f"{n} code layers"
    n_abs = abs(n) % 100
    n1 = n_abs % 10
    if 11 <= n_abs <= 19:
        w = "слоев кода"
    elif n1 == 1:
        w = "слой кода"
    elif 2 <= n1 <= 4:
        w = "слоя кода"
    else:
        w = "слоев кода"
    return f"{n} {w}"

def _plural_threats(n: int) -> str:
    if not _is_russian():
        return f"{n} threat" if n == 1 else f"{n} threats"
    n_abs = abs(n) % 100
    n1 = n_abs % 10
    if 11 <= n_abs <= 19:
        w = "угроз"
    elif n1 == 1:
        w = "угроза"
    elif 2 <= n1 <= 4:
        w = "угрозы"
    else:
        w = "угроз"
    return f"{n} {w}"

def _format_rule_title(rule: str) -> str:
    r_map_ru = {
        "DYNAMIC_CODE_EXECUTION": "Выполнение кода",
        "DYNAMIC_CODE_COMPILATION": "Компиляция кода",
        "BYTE_XOR_DECRYPTION_LOOP": "XOR-расшифровка",
        "HIDDEN_XOR_PAYLOAD": "XOR-код",
        "BASE64_EXEC_CHAIN": "Base64-исполнение",
        "BASE64_OBFUSCATED_PAYLOAD": "Base64-код",
        "REVERSE_SHELL_PAYLOAD": "Reverse Shell",
        "TOKEN_STEALER_PATTERN": "Перехват сессии",
        "TELEGRAM_BOT_EXFIL": "Утечка в Telegram",
        "SOCKET_EXFILTRATION": "Сетевой сокет",
        "UNTRUSTED_SOCKET_CONNECT": "Сокет-соединение",
        "OBFUSCATION_UNPACKED": "Обфускация",
        "MULTI_LAYER_OBFUSCATION_UNPACKED": "Многослойность",
        "NATIVE_HOOK_PAYLOAD": "Внедрение хука",
        "REFLECTION_BYPASS": "Обход Reflection",
        "SUBWORD_EXEC_MATCH": "Динамический вызов",
        "SUSPICIOUS_EXEC_HEURISTIC": "Подозрительный вызов",
        "ENCRYPTED_PAYLOAD": "Зашифрованный код",
        "FILE_STEALER": "Кража файлов",
        "PROCESS_SPAWN": "Запуск процесса",
        "DEX_INJECTION": "DEX-инъекция",
        "MALWARE_HASH_MATCH": "Сигнатура малвари",
        "YARA_MATCH": "Правило YARA",
        "AST_SUSPICIOUS": "Аномалия AST",
        "DANGEROUS_IMPORT": "Опасный импорт",
    }
    r_map_en = {
        "DYNAMIC_CODE_EXECUTION": "Code Execution",
        "DYNAMIC_CODE_COMPILATION": "Code Compilation",
        "BYTE_XOR_DECRYPTION_LOOP": "XOR Decrypt",
        "HIDDEN_XOR_PAYLOAD": "XOR Payload",
        "BASE64_EXEC_CHAIN": "Base64 Execution",
        "BASE64_OBFUSCATED_PAYLOAD": "Base64 Payload",
        "REVERSE_SHELL_PAYLOAD": "Reverse Shell",
        "TOKEN_STEALER_PATTERN": "Session Stealer",
        "TELEGRAM_BOT_EXFIL": "Telegram Exfil",
        "SOCKET_EXFILTRATION": "Socket Exfil",
        "UNTRUSTED_SOCKET_CONNECT": "Socket Connect",
        "OBFUSCATION_UNPACKED": "Obfuscation",
        "MULTI_LAYER_OBFUSCATION_UNPACKED": "Multi-layer Obf",
        "NATIVE_HOOK_PAYLOAD": "Hook Injection",
        "REFLECTION_BYPASS": "Reflection Bypass",
        "SUBWORD_EXEC_MATCH": "Dynamic Call",
        "SUSPICIOUS_EXEC_HEURISTIC": "Suspicious Call",
        "ENCRYPTED_PAYLOAD": "Encrypted Payload",
        "FILE_STEALER": "File Stealer",
        "PROCESS_SPAWN": "Process Spawn",
        "DEX_INJECTION": "DEX Injection",
        "MALWARE_HASH_MATCH": "Malware Hash",
        "YARA_MATCH": "YARA Match",
        "AST_SUSPICIOUS": "AST Anomaly",
        "DANGEROUS_IMPORT": "Dangerous Import",
    }
    if _is_russian():
        if rule in r_map_ru:
            return r_map_ru[rule]
    else:
        if rule in r_map_en:
            return r_map_en[rule]
    if "ReportUI" in globals() and rule in ReportUI.RULES:
        return ReportUI.RULES[rule][0 if _is_russian() else 1]
    return rule.replace("_", " ").title()

def _beautify_code(raw: str) -> str:
    if not raw or not isinstance(raw, str):
        return raw if raw else ""
    stripped = raw.strip()
    if (stripped.startswith("{") and stripped.endswith("}")) or (stripped.startswith("[") and stripped.endswith("]")):
        try:
            import json
            return json.dumps(json.loads(stripped), indent=2, ensure_ascii=False)
        except Exception:
            pass
        try:
            import ast, json
            return json.dumps(ast.literal_eval(stripped), indent=2, ensure_ascii=False)
        except Exception:
            pass
    return raw

_premium_haptics_cached = None

def _vibrate(view=None, context=None, haptic_type="tap"):
    global _premium_haptics_cached
    try:
        if _premium_haptics_cached is None:
            ctx = context or (view.getContext() if view and hasattr(view, "getContext") else None)
            if not ctx:
                return
            Build = find_class("android.os.Build")
            sdk_int = getattr(Build.VERSION, "SDK_INT", 0) if Build and hasattr(Build, "VERSION") else 0
            vib = None
            if sdk_int >= 31:
                try:
                    vm = ctx.getSystemService("vibrator_manager")
                    if vm and hasattr(vm, "getDefaultVibrator"):
                        vib = vm.getDefaultVibrator()
                except Exception:
                    pass
            if not vib:
                vib = ctx.getSystemService("vibrator")
            if vib and hasattr(vib, "hasVibrator") and vib.hasVibrator() and hasattr(vib, "hasAmplitudeControl") and vib.hasAmplitudeControl():
                _premium_haptics_cached = True
            else:
                _premium_haptics_cached = False
        if not _premium_haptics_cached or not view or not hasattr(view, "performHapticFeedback"):
            return
        HapticFeedbackConstants = find_class("android.view.HapticFeedbackConstants")
        if not HapticFeedbackConstants:
            return
        if haptic_type == "long":
            code = getattr(HapticFeedbackConstants, "LONG_PRESS", 0)
        elif haptic_type == "confirm":
            code = getattr(HapticFeedbackConstants, "CONFIRM", 16) or getattr(HapticFeedbackConstants, "KEYBOARD_TAP", 3)
        elif haptic_type == "tick":
            code = getattr(HapticFeedbackConstants, "CLOCK_TICK", 4)
        else:
            code = getattr(HapticFeedbackConstants, "KEYBOARD_TAP", 3)
        flag = getattr(HapticFeedbackConstants, "FLAG_IGNORE_GLOBAL_SETTING", 2)
        try:
            view.performHapticFeedback(code, flag)
        except Exception:
            view.performHapticFeedback(code)
    except Exception:
        pass

_vibrate_tap = _vibrate

_haptic_loop_stop = threading.Event()

def _get_vibrator(context=None):
    try:
        ctx = context
        if not ctx:
            try:
                AppLoader = find_class("org.telegram.messenger.ApplicationLoader")
                ctx = getattr(AppLoader, "applicationContext", None)
            except Exception:
                pass
        Build = find_class("android.os.Build")
        sdk = getattr(Build.VERSION, "SDK_INT", 0) if Build and hasattr(Build, "VERSION") else 0
        vib = None
        if ctx:
            if sdk >= 31:
                try:
                    vm = ctx.getSystemService("vibrator_manager")
                    if vm and hasattr(vm, "getDefaultVibrator"):
                        vib = vm.getDefaultVibrator()
                except Exception:
                    pass
            if not vib:
                try:
                    vib = ctx.getSystemService("vibrator")
                except Exception:
                    pass
        return vib, sdk
    except Exception:
        return None, 0

def _start_spring_waiting_haptic(context=None):
