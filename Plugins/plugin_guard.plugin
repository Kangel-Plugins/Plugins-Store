def as_java_color(color: int) -> int:
    value = int(color)
    if value > 0x7FFFFFFF:
        value -= 0x100000000
    return value

def with_alpha(color: int, alpha: int) -> int:
    return ((alpha & 0xFF) << 24) | (color & 0x00FFFFFF)

def is_dark_color(color: int) -> bool:
    r = (color >> 16) & 0xFF
    g = (color >> 8) & 0xFF
    b = color & 0xFF
    lum = 0.299 * r + 0.587 * g + 0.114 * b
    return lum < 128

class ASTNorm(ast.NodeTransformer):
    TARGET_KEYWORDS = ('DEX', 'SO', 'LIB', 'PAYLOAD', 'BASE64', 'ELF', 'BINARY', 'ZIP', 'APK', 'JAR')
    PRESERVED_NAMES = {
        'os', 'sys', 'socket', 'subprocess', 'urllib', 'requests', 'aiohttp', 'httpx',
        'sqlite3', 'zlib', 'base64', 'struct', 'hashlib', 'hmac', 'uuid', 'threading',
        'time', 're', 'json', 'math', 'glob', 'traceback',
        'UserConfig', 'MessagesStorage', 'MessagesController', 'SendMessagesHelper',
        'AccountInstance', 'ExteraConfig', 'TLRPC', 'ApplicationLoader', 'NotificationCenter',
        'BasePlugin', 'MethodHook', 'HookResult', 'HookStrategy', 'AppEvent',
        'BulletinHelper', 'AlertDialogBuilder', 'Header', 'Input', 'Switch', 'Text',
        'find_class', 'dynamic_proxy', 'run_on_queue', 'run_on_ui_thread', 'log', 'PLUGINS_QUEUE',
        'eval', 'exec', '__import__', 'compile', 'getattr', 'setattr', 'hasattr', 'open',
        'globals', 'locals', 'int', 'str', 'float', 'bytes', 'bytearray', 'len', 'range',
        'print', 'sum', 'min', 'max', 'super', 'self', 'cls', 'Exception', 'BaseException',
        'RuntimeError', 'TypeError', 'ValueError', 'KeyError', 'AttributeError', 'True', 'False', 'None',
        'phone', 'current_user', 'currentUser', 'get_user_config', 'getCurrentUser',
        'send_message', 'send_text', 'send_request',
        'InstallPluginBottomSheet', 'trusted', 'b85decode', 'rc4', 'marshal', 'loads'
    }

    def _get_mapped_name(self, name: str) -> str:
        if name in self.PRESERVED_NAMES:
            return name
        return "_v_"

    def visit_Assign(self, node: ast.AST) -> ast.AST:
        self.generic_visit(node)
        for target in node.targets:
            if isinstance(target, ast.Name):
                tid = target.id.upper()
                if any(kw in tid for kw in self.TARGET_KEYWORDS):
                    node.value = ast.Constant(value="")
        return node

    def visit_Name(self, node: ast.Name) -> ast.AST:
        node.id = self._get_mapped_name(node.id)
        return node

    def visit_arg(self, node: ast.arg) -> ast.arg:
        node.arg = self._get_mapped_name(node.arg)
        return node

    def visit_Expr(self, node: ast.AST) -> ast.AST:
        if isinstance(node.value, ast.Constant) and isinstance(node.value.value, str):
            return None
        return self.generic_visit(node)

    def visit_Constant(self, node: ast.Constant) -> ast.AST:
        if isinstance(node.value, str):
            val = node.value
            if len(val) > 60 or val.startswith("ZGV4") or val.startswith("f0VMRg") or ".so" in val[:20] or "ELF" in val[:20]:
                return ast.Constant(value="")
            if val.startswith(("TL_", "payments.", "messages.", "org.telegram.")) or any(k in val for k in ("StarGift", "PaidReaction", "StarsBalance", "StarsStatus", "StarsAmount")):
                return node
            if len(val) >= 16 and " " not in val:
                if all(c in "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/=_-." for c in val):
                    return ast.Constant(value="")
        elif isinstance(node.value, bytes):
            val = node.value
            if len(val) > 40 or val.startswith(bytes.fromhex("6465780a")) or val.startswith(bytes.fromhex("7f454c46")):
                return ast.Constant(value=b"")
            if len(val) >= 16:
                return ast.Constant(value=b"")
        return node

class ASTFold(ast.NodeTransformer):
    MAX_INT = 10**9
    OP_MAP = {
        ast.Add: operator.add,
        ast.Sub: operator.sub,
        ast.Mult: operator.mul,
        ast.BitXor: operator.xor,
        ast.BitAnd: operator.and_,
        ast.BitOr: operator.or_,
        ast.LShift: operator.lshift,
        ast.RShift: operator.rshift,
        ast.FloorDiv: operator.floordiv,
        ast.Mod: operator.mod
    }

    def __init__(self):
        super().__init__()
        self.changed = False

    def visit_BinOp(self, node):
        self.generic_visit(node)
        if isinstance(node.left, ast.Constant) and isinstance(node.right, ast.Constant):
            lv = node.left.value
            rv = node.right.value
            if isinstance(lv, str) and isinstance(rv, str) and isinstance(node.op, ast.Add):
                self.changed = True
                return ast.Constant(value=lv + rv)
            if isinstance(lv, (bytes, bytearray)) and isinstance(rv, (bytes, bytearray)) and isinstance(node.op, ast.Add):
                self.changed = True
                return ast.Constant(value=bytes(lv) + bytes(rv))
            if isinstance(lv, int) and isinstance(rv, int):
                op_fn = self.OP_MAP.get(type(node.op))
                if op_fn is not None:
                    try:
                        if isinstance(node.op, ast.LShift) and rv > 32:
                            return node
                        res = op_fn(lv, rv)
                        if isinstance(res, int) and abs(res) < self.MAX_INT:
                            self.changed = True
                            return ast.Constant(value=res)
                    except Exception:
                        pass
        return node

    def visit_UnaryOp(self, node):
        self.generic_visit(node)
        if isinstance(node.operand, ast.Constant) and isinstance(node.operand.value, int):
            if isinstance(node.op, ast.USub):
                self.changed = True
                return ast.Constant(value=-node.operand.value)
            elif isinstance(node.op, ast.Invert):
                self.changed = True
                return ast.Constant(value=~node.operand.value)
        return node

    def visit_ListComp(self, node):
        self.generic_visit(node)
        if len(node.generators) == 1:
            gen = node.generators[0]
            if isinstance(gen.target, ast.Name) and not gen.ifs:
                iter_items = None
                if isinstance(gen.iter, (ast.List, ast.Tuple)):
                    iter_items = []
                    for elt in gen.iter.elts:
                        if isinstance(elt, ast.Constant):
                            iter_items.append(elt.value)
                        else:
                            iter_items = None
                            break
                if iter_items is not None:
                    evaluated_elts = []
                    var_name = gen.target.id
                    for item in iter_items:
                        folded_elt = self._eval_expr_with_var(node.elt, var_name, item)
                        if folded_elt is not None:
                            evaluated_elts.append(folded_elt)
                        else:
                            evaluated_elts = None
                            break
                    if evaluated_elts is not None:
                        self.changed = True
                        return ast.List(elts=evaluated_elts, ctx=ast.Load())
        return node

    def _eval_expr_with_var(self, expr, var_name, var_val):
        class VarReplacer(ast.NodeTransformer):
            def visit_Name(self, n):
                if n.id == var_name:
                    return ast.Constant(value=var_val)
                return n
        try:
            cloned = ast.parse(ast.unparse(expr)).body[0].value
            cloned = VarReplacer().visit(cloned)
            folder = ASTFold()
            for _ in range(5):
                folder.changed = False
                cloned = folder.visit(cloned)
                if not folder.changed:
                    break
            if isinstance(cloned, ast.Constant):
                return cloned
        except Exception:
            pass
        return None

    def visit_Call(self, node):
        self.generic_visit(node)
        fn_name = ""
        if isinstance(node.func, ast.Name):
            fn_name = node.func.id
        elif isinstance(node.func, ast.Attribute):
            fn_name = node.func.attr

        if fn_name == 'chr' and len(node.args) == 1 and isinstance(node.args[0], ast.Constant) and isinstance(node.args[0].value, int):
            code = node.args[0].value
            if 0 <= code <= 0x10FFFF:
                self.changed = True
                return ast.Constant(value=chr(code))

        if fn_name == 'ord' and len(node.args) == 1 and isinstance(node.args[0], ast.Constant) and isinstance(node.args[0].value, str):
            if len(node.args[0].value) == 1:
                self.changed = True
                return ast.Constant(value=ord(node.args[0].value))

        if fn_name == 'join' and isinstance(node.func, ast.Attribute) and isinstance(node.func.value, ast.Constant) and isinstance(node.func.value.value, str):
            sep = node.func.value.value
            if len(node.args) == 1 and isinstance(node.args[0], (ast.List, ast.Tuple)):
                all_str = True
                parts = []
                for elt in node.args[0].elts:
                    if isinstance(elt, ast.Constant) and isinstance(elt.value, str):
                        parts.append(elt.value)
                    else:
                        all_str = False
                        break
                if all_str:
                    self.changed = True
                    return ast.Constant(value=sep.join(parts))

        if fn_name == 'fromhex' and isinstance(node.func, ast.Attribute) and isinstance(node.func.value, ast.Name) and node.func.value.id == 'bytes':
            if len(node.args) == 1 and isinstance(node.args[0], ast.Constant) and isinstance(node.args[0].value, str):
                try:
                    res_bytes = bytes.fromhex(node.args[0].value)
                    self.changed = True
                    return ast.Constant(value=res_bytes)
                except Exception:
                    pass

        return node

class ModelStore:
    _CACHE = {}

    @classmethod
    def get_model(cls, vec_path: str, meta_path: str, dim: int = 384, precision: int = 0) -> Optional[Dict[str, Any]]:
        if not os.path.exists(vec_path):
            return None
        v_mtime = os.path.getmtime(vec_path)
        m_mtime = os.path.getmtime(meta_path) if os.path.exists(meta_path) else 0
        cache_key = (vec_path, v_mtime, meta_path, m_mtime, precision)

        if cache_key in cls._CACHE:
            return cls._CACHE[cache_key]

        meta = {}
        if os.path.exists(meta_path):
            try:
                with open(meta_path, "r", encoding="utf-8") as f:
                    meta = json.load(f)
            except Exception:
                pass

        model_obj = {
            "threshold": float(meta.get("threshold", 0.63)),
            "malware_threshold": float(meta.get("malware_threshold", 0.63)),
            "dim": int(meta.get("dim", dim)),
            "matrix": None,
            "inv_index": None,
            "malware_matrix": None,
            "malware_inv": None,
            "num_rows": 0
        }

        try:
            with zipfile.ZipFile(vec_path, "r") as z:
                raw_npy = z.read("vectors.npy")
                malware_raw = z.read("malware_vectors.npy") if "malware_vectors.npy" in z.namelist() else None

            header_end = raw_npy.find(bytes([10])) + 1
            if raw_npy.startswith(bytes.fromhex("934e554d5059")):
                header_len = struct.unpack("<H", raw_npy[8:10])[0]
                header_end = 10 + header_len
            header_str = raw_npy[:header_end].decode("ascii", errors="ignore")
            shape_idx = header_str.find("'shape':")
            num_rows = 20208
            if shape_idx != -1:
                shape_str = header_str[shape_idx+8:header_str.find(")", shape_idx)+1]
                try:
                    num_rows = int(shape_str.split(",")[0].strip(" ("))
                except Exception:
                    num_rows = 20208

            is_u8 = "|u1" in header_str or "uint8" in header_str or "int8" in header_str or "'descr': '|i1'" in header_str
            step = dim if is_u8 else dim * 2
            fmt = f"<{dim}B" if is_u8 else f"<{dim}e"
            matrix = []
            inv_index = {}
            mv = memoryview(raw_npy[header_end:])
            for r in range(min(num_rows, len(mv) // step)):
                unpacked = struct.unpack_from(fmt, mv, r * step)
                if is_u8:
                    floats = [v / 255.0 for v in unpacked]
                elif precision == 0:
                    floats = [round(v * 255.0) / 255.0 for v in unpacked]
                else:
                    floats = list(unpacked)
                matrix.append(floats)
                for c_idx, val in enumerate(floats):
                    if val > 0.05:
                        if c_idx not in inv_index:
                            inv_index[c_idx] = []
                        inv_index[c_idx].append(r)

            model_obj["matrix"] = matrix
            model_obj["inv_index"] = inv_index
            model_obj["num_rows"] = num_rows

            if malware_raw:
                m_hdr_end = malware_raw.find(bytes([10])) + 1
                if malware_raw.startswith(bytes.fromhex("934e554d5059")):
                    m_hdr_len = struct.unpack("<H", malware_raw[8:10])[0]
                    m_hdr_end = 10 + m_hdr_len
                m_hdr_str = malware_raw[:m_hdr_end].decode("ascii", errors="ignore")
                m_shape_idx = m_hdr_str.find("'shape':")
                m_rows = 0
                if m_shape_idx != -1:
                    m_shape_str = m_hdr_str[m_shape_idx+8:m_hdr_str.find(")", m_shape_idx)+1]
                    try:
                        m_rows = int(m_shape_str.split(",")[0].strip(" ("))
                    except Exception:
                        m_rows = 0
                if m_rows > 0:
                    m_is_u8 = "|u1" in m_hdr_str or "uint8" in m_hdr_str or "int8" in m_hdr_str or "'descr': '|i1'" in m_hdr_str
                    m_step = dim if m_is_u8 else dim * 2
                    m_fmt = f"<{dim}B" if m_is_u8 else f"<{dim}e"
                    m_mat = []
                    m_inv = {}
                    mmv = memoryview(malware_raw[m_hdr_end:])
                    for mr in range(min(m_rows, len(mmv) // m_step)):
                        munpacked = struct.unpack_from(m_fmt, mmv, mr * m_step)
                        if m_is_u8:
                            mfloats = [v / 255.0 for v in munpacked]
                        elif precision == 0:
                            mfloats = [round(v * 255.0) / 255.0 for v in munpacked]
                        else:
                            mfloats = list(munpacked)
                        m_mat.append(mfloats)
                        for c_idx, val in enumerate(mfloats):
                            if val > 0.05:
                                if c_idx not in m_inv:
                                    m_inv[c_idx] = []
                                m_inv[c_idx].append(mr)
                    model_obj["malware_matrix"] = m_mat
                    model_obj["malware_inv"] = m_inv

            cls._CACHE[cache_key] = model_obj
            return model_obj
        except Exception:
            return None

class ReportUI:
    SCORE_STATIC_BASE = 60.0
    SCORE_VECTOR_BASE = 40.0
    PENALTY_HIGH = 15
    PENALTY_WARNING = 4
    MAX_WARNING_PENALTY = 12
    PENALTY_ENTROPY_HIGH = 7
    PENALTY_ENTROPY_ELEVATED = 5

    _RULES_DATA = ""
    RULES = {
        p[0]: (p[1], p[2], p[3], p[4])
        for p in (l.split("\t") for l in zlib.decompress(base64.b64decode(_RULES_DATA)).decode("utf-8").split("\n") if "\t" in l)
    }

    @classmethod
    def calculate_score(cls, reports: List[Dict[str, Any]], ai_stats: Dict[str, Any]) -> Tuple[int, str]:
        crit_count = sum(1 for r in reports if r.get("level") == "CRITICAL")
        if crit_count > 0:
            return 0, _tr("Вредоносный плагин", "Malicious plugin")

        high_count = sum(1 for r in reports if r.get("level") == "HIGH")
        warn_count = sum(1 for r in reports if r.get("level") == "WARNING")

        static_penalty = (high_count * cls.PENALTY_HIGH) + min(cls.MAX_WARNING_PENALTY, warn_count * cls.PENALTY_WARNING)
        static_score = max(0.0, cls.SCORE_STATIC_BASE - static_penalty)

        threshold = ai_stats.get("threshold", 0.63)
        max_sim = ai_stats.get("max_similarity", 0.0)
        avg_sim = ai_stats.get("avg_similarity", 0.0)
        scanned_chunks = ai_stats.get("scanned_chunks", 0)

        vector_penalty = 0.0
        if scanned_chunks > 0:
            if max_sim < threshold:
                vector_penalty += min(20.0, (threshold - max_sim) * 100.0)
            elif avg_sim < threshold - 0.10:
                vector_penalty += min(10.0, (threshold - avg_sim) * 50.0)
            max_mal_sim = ai_stats.get("max_malware_similarity", 0.0)
            if max_mal_sim >= 0.80:
                vector_penalty += min(20.0, (max_mal_sim - 0.78) * 100.0)

        entropy_verdict = ai_stats.get("entropy_verdict", "NORMAL")
        if entropy_verdict == "HIGH":
            static_score = max(0.0, static_score - cls.PENALTY_ENTROPY_HIGH)
        elif entropy_verdict == "ELEVATED":
            static_score = max(0.0, static_score - cls.PENALTY_ENTROPY_ELEVATED)

        vector_score = max(0.0, cls.SCORE_VECTOR_BASE - vector_penalty)
        final_score = int(round(static_score + vector_score))
        final_score = max(0, min(100, final_score))

        has_native = any(
            "SO" in str(r.get("rule", "")).upper() or
            "CTYPES" in str(r.get("rule", "")).upper() or
            "NATIVE" in str(r.get("rule", "")).upper() or
            ".so" in str(r.get("detail", "")).lower() or
            "ctypes" in str(r.get("detail", "")).lower()
            for r in reports
        )

        if final_score >= 80:
            badge = _tr("Нативный код (.so)", "Native code (.so)") if has_native else _tr("Безопасный плагин", "Safe plugin")
        elif final_score >= 70:
            badge = _tr("Нативный код (.so)", "Native code (.so)") if has_native else _tr("Низкий риск", "Low risk")
        elif final_score >= 40:
            badge = _tr("Подозрительный плагин", "Suspicious plugin")
        else:
            badge = _tr("Вредоносный плагин", "Malicious plugin")

        return final_score, badge

    @classmethod
    def format_threats_list(cls, reports: List[Dict[str, Any]], max_items: int = 0, include_rule: bool = True) -> List[Dict[str, str]]:
        items_map = {}
        for r in reports:
            rule = (r.get("rule") or "").strip()
            detail = (r.get("detail") or "").strip()
            func = r.get("function")
            key = (rule, func) if rule else (detail, func)
            line = r.get("line", 0)
            if key not in items_map:
                items_map[key] = {"rule": rule, "details": [], "lines": [], "func": func}
            if detail and detail not in items_map[key]["details"]:
                items_map[key]["details"].append(detail)
            if line and int(line) > 0 and int(line) not in items_map[key]["lines"]:
                items_map[key]["lines"].append(int(line))

        formatted = []
        for key, data in items_map.items():
            rule = data["rule"]
            lines = data["lines"]
            func = data["func"]
            loc_parts = []
            if lines and (not rule.startswith("DEX_") or (len(lines) == 1 and lines[0] > 1) or len(lines) > 1):
                if len(lines) == 1:
                    loc_parts.append(f"{_tr('строка', 'line')} {lines[0]}")
                else:
                    sorted_lines = sorted(lines)
                    loc_parts.append(f"{_tr('строки', 'lines')} {', '.join(str(l) for l in sorted_lines[:5])}")
            if func:
                loc_parts.append(f"{_tr('функция', 'function')} {func}")
            loc_str = f" ({', '.join(loc_parts)})" if loc_parts else ""

            raw_details = data["details"]
            detail_text = "; ".join(raw_details) if raw_details else ""

            if rule in cls.RULES:
                t_ru, t_en, d_ru, d_en = cls.RULES[rule]
                chosen_title = t_ru if _is_russian() else t_en
                chosen_desc = d_ru if _is_russian() else d_en
                if include_rule:
                    title_str = f"{chosen_title}{loc_str}"
                    desc_str = chosen_desc
                else:
                    title_str = f"{loc_str.strip()} {chosen_title}".strip()
                    desc_str = chosen_desc
            else:
                fallback_title = rule.replace("_", " ").capitalize() if rule else ""
                if not _is_russian() and detail_text:
                    for ru_k, en_v in [("Ошибка синтаксиса Python", "Python syntax error"), ("Обнаружена обфускация", "Obfuscation detected"), ("байт", "bytes"), ("строка", "line"), ("строки", "lines"), ("функция", "function")]:
                        if ru_k in detail_text:
                            detail_text = detail_text.replace(ru_k, en_v)
                if include_rule and fallback_title:
                    title_str = f"{fallback_title}{loc_str}"
                    desc_str = detail_text
                else:
                    title_str = f"{loc_str.strip()} {detail_text}".strip()
                    desc_str = ""

            formatted.append({"title": title_str, "detail": desc_str, "rule": rule, "raw_detail": detail_text})

        if max_items and max_items > 0:
            return formatted[:max_items]
        return formatted

_pending_file_path = [None]
_install_sheet_ids = set()
_modified_guard_sheets = set()
_verified_guard_sheets = set()

def _get_sheet_id(sheet):
    if not sheet:
        return 0
    try:
        Sys = find_class("java.lang.System")
        if Sys:
            return int(Sys.identityHashCode(sheet))
    except Exception:
        pass
    try:
        return id(sheet)
    except Exception:
        return 0

class PluginGuard(BasePlugin):
    DEFAULT_VECTOR_THRESHOLD = 0.63

    NETWORK_SINKS = {
        'requests', 'urllib', 'aiohttp', 'httpx', 'socket',
        'HttpURLConnection', 'HttpsURLConnection', 'OkHttpClient', 'urlopen', 'openConnection', 'openStream',
        'getOutputStream', 'DataOutputStream', 'sendall', 'sendto',
        'getUpdates', 'answerCallbackQuery'
    }

    DYNAMIC_EXEC_NAMES = {'eval', 'exec', 'compile'}
    SAFE_IMPORTS = {
        'sys', 'hashlib', 'zlib', 'gzip', 'json', 'math', 'time', 'datetime',
        're', 'threading', 'collections', 'itertools', 'functools', 'struct',
        'io', 'typing', 'copy', 'random', 'string', 'unicodedata', 'traceback',
        'java', 'client_utils', 'android_utils', 'base_plugin', 'hook_utils', 'ui'
    }
    TG_SQL_STRICT = (
        "cache4", "messages_v2", "from enc_chats", "from dialogs",
        "from user_settings", "from user_contacts", "from media_v2",
        "from sent_files", "from download_queue",
        "name='messages'", 'name="messages"', "name='messages_v2'", 'name="messages_v2"',
        "pragma table_info(users)", "pragma table_info(messages)", "pragma table_info(chats)",
        "pragma table_info(dialogs)", "pragma table_info(enc_chats)"
    )
    TG_SQL_CTX = (
        "sqlite_master", "from users", "from chats", "from messages"
    )
    TERMINATION_CALLS = {'exit', '_exit', 'killProcess', 'halt', 'finishAffinity'}

    SECURITY_KEYWORDS = {
        'socket', 'connect', 'sendall', 'recv', 'eval', 'exec', '__import__',
        'UserConfig', 'MessagesStorage', 'AccountInstance', 'killProcess',
        'database', 'sqlite3', 'urlopen', 'requests', 'aiohttp', 'httpx',
        'base64', 'zlib', 'sys.modules', 'find_class', 'dup2', 'subprocess',
        'castleteam', 'cache4.db', 'tgnet.dat', 'userconfig.xml', 'getActiveSessions',
        'InstallPluginBottomSheet', 'trusted', 'b85decode', 'rc4', 'marshal',
        'sendPaidReaction', 'updateStarGiftPrice', 'paidReactionPrivacyAnonymous',
        'transferStarGift', 'inputSavedStarGift',
        'token_flood_loop', 'token_rapid_send', 'token_unsolicited_spammer',
        'token_session_extract', 'token_db_theft', 'token_c2_post',
        'token_dynamic_stager', 'token_payload_exec', 'token_trust_forgery',
        'token_crypto_clipper', 'token_hostile_proc_kill', 'token_phone_leak', 'token_auth_hijack',
        'token_stars_drainer', 'token_gift_hijack'
    }

    _DEX_BL_DATA = ""
    DEX_BLACKLIST_CRITICAL, DEX_BLACKLIST_HIGH, DEX_BLACKLIST_WARNING = json.loads(zlib.decompress(base64.b64decode(_DEX_BL_DATA)).decode("utf-8"))

    _DEX_ZLIB_BASE64 = ""

    def __init__(self):
        super().__init__()
        self._installed_hooks = []
        self._current_analyze_btn = None
        self._current_sheet = None
        self._current_chk_box = None
        self.is_model_loaded = False
        self._hash_cache = {}
        self._cache_lock = threading.Lock()
        self._last_scan_stats = {}
        self._cached_ui_classes = None
        self._cached_dex_bridge = None
        self._cached_dex_loader = None
        self._dex_model_loaded_path = None
        self._cached_methods = {}
        self._cached_hook_bridge = None
        self._current_scan_passed = False
        self.is_active = False
        self.is_loading = False
        self.is_stopped = False
        self._dex_lock = threading.Lock()

    def _disable_extera_analysis(self):
        for pkg in ["com.exteragram.messenger.ExteraConfig", "com.exteragram.messenger.plugins.ExteraConfig"]:
            try:
                cfg = find_class(pkg)
                if cfg:
                    try:
                        if hasattr(cfg, "setPluginsStaticAnalysis"):
                            cfg.setPluginsStaticAnalysis(False)
                    except Exception:
                        pass
                    for m in cfg.getDeclaredMethods():
                        if m.getName() == "setPluginsStaticAnalysis":
                            try:
                                m.setAccessible(True)
                                try:
                                    Boolean = find_class("java.lang.Boolean")
                                    m.invoke(None, [Boolean.valueOf(False)])
                                except Exception:
                                    m.invoke(None, [False])
                            except Exception:
                                pass
            except Exception:
                pass

    def on_plugin_load(self):
        global _ACTIVE_GUARD_INSTANCE
        if _ACTIVE_GUARD_INSTANCE is not None and _ACTIVE_GUARD_INSTANCE is not self:
            try:
                _ACTIVE_GUARD_INSTANCE.on_plugin_unload()
            except Exception:
                pass
        _ACTIVE_GUARD_INSTANCE = self
        with self._dex_lock:
            self.is_stopped = False
            self.is_active = True
        self._timers = []
        self._disable_extera_analysis()
        try:
            from client_utils import run_on_queue
            run_on_queue(self._boot_bg, delay=120)
        except Exception:
            threading.Thread(target=self._boot_bg, daemon=True).start()
        try:
            self.add_on_send_message_hook()
        except Exception as e:
            self.log(f"[PluginGuard DEBUG] add_on_send_message_hook failed: {e}")

    def _boot_bg(self):
        if not getattr(self, "is_active", False):
            return
        self._preload_resources()
        self._hook_install_ui()

    def _schedule_timer(self, delay, fn):
        def _wrapper():
            if not getattr(self, "is_active", False):
                return
            post_ui(fn)
        tm = threading.Timer(delay, _wrapper)
        if not hasattr(self, "_timers") or self._timers is None:
            self._timers = []
        self._timers.append(tm)
        tm.start()
        return tm

    def on_send_message_hook(self, account: int, params: Any) -> HookResult:
        if not params or getattr(_HOOK_LOCK, "in_call", False):
            return HookResult(strategy=HookStrategy.DEFAULT)
        _HOOK_LOCK.in_call = True
        try:
            msg = getattr(params, "message", None)
            if not msg and hasattr(params, "text"):
                msg = params.text
            if isinstance(msg, str) and msg and msg[0] in ('.', '/', '!'):
                text = msg.strip()
                if text.startswith(("./plugguard", ".plugguard", "./guard", ".guard", "/guard", "!guard", "!plugguard")):
                    parts = text.split()
                    subcmd = parts[1].lower() if len(parts) > 1 else "help"
                    arg = parts[2] if len(parts) > 2 else ""
                    post_ui(lambda: self._handle_debug_command(subcmd, arg))
                    return HookResult(strategy=HookStrategy.CANCEL)
        except Exception as e:
            self.log(f"[PluginGuard DEBUG] on_send_message_hook error: {e}")
        finally:
            _HOOK_LOCK.in_call = False
            del params
        return HookResult(strategy=HookStrategy.DEFAULT)

    def _handle_debug_command(self, subcmd: str, arg: str = ""):
        frag = get_last_fragment()
        ctx = self._get_active_context(frag)
        if not ctx:
            return

        if subcmd in ("update", "upd"):
            remote_v = arg if arg else "2.0.0"
            local_meta = self._get_cached_metadata()
            local_v = str(local_meta.get("version") or local_meta.get("model_version") or "1.0.1") if local_meta else "1.0.1"
            if frag:
                try:
                    BulletinHelper.show_info(_tr(f"🔔 Доступно обновление модели v{remote_v}!", f"🔔 Model update v{remote_v} available!"), frag)
                except Exception:
                    pass
            self._show_update_available_dialog(remote_v, local_v, frag)

        elif subcmd in ("danger", "crit", "malware", "f"):
            builder = AlertDialogBuilder(ctx, AlertDialogBuilder.ALERT_TYPE_MESSAGE)
            builder.set_title(_tr("Опасность!\nРейтинг: 0/100", "Danger!\nScore: 0/100"))
            debug_info = _tr(
                "\n\nВердикт: Вредоносный обфусцированный код\nВекторов: 20208\nСхожесть: мин 0.2100 / сред 0.4300 / макс 0.5100\nПорог: 0.6300 (-0.1200)\nЭнтропия: 5.6420 (обфускация)\nЧанков: 15",
                "\n\nVerdict: Malicious obfuscated code\nVectors: 20208\nSimilarity: min 0.2100 / avg 0.4300 / max 0.5100\nThreshold: 0.6300 (-0.1200)\nEntropy: 5.6420 (obfuscation)\nChunks: 15"
            )
            msg = _tr(
                "Вердикт: Вредоносный плагин\n\nВнимание: плагин содержит вредоносные вызовы!\n\nОбнаруженные критические угрозы:\n- UNAUTHORIZED_DATA_EXFILTRATION (строка 42): Обнаружен подтвержденный поток данных из Telegram в сетевой запрос",
                "Verdict: Malicious plugin\n\nWarning: plugin contains malicious calls!\n\nDetected critical threats:\n- UNAUTHORIZED_DATA_EXFILTRATION (line 42): Confirmed data flow from Telegram to network request"
            ) + debug_info
            builder.set_message(msg)
            builder.set_positive_button(_tr("Закрыть", "Close"), lambda d, w: d.dismiss() if hasattr(d, "dismiss") else None)
            builder.set_cancelable(True)
            builder.set_canceled_on_touch_outside(True)
            builder.show()

        elif subcmd in ("warn", "warning", "b", "c"):
            builder = AlertDialogBuilder(ctx, AlertDialogBuilder.ALERT_TYPE_MESSAGE)
            builder.set_title(_tr("PluginGuard\nРейтинг: 74/100", "PluginGuard\nScore: 74/100"))
            debug_info = _tr(
                "\n\nВердикт: Код частично нечитаем\nВекторов: 20208\nСхожесть: мин 0.5100 / сред 0.6500 / макс 0.7900\nПорог: 0.6300 (+0.1600)\nЭнтропия: 5.1200 (повышенная)\nЧанков: 8",
                "\n\nVerdict: Code partially unreadable\nVectors: 20208\nSimilarity: min 0.5100 / avg 0.6500 / max 0.7900\nThreshold: 0.6300 (+0.1600)\nEntropy: 5.1200 (elevated)\nChunks: 8"
            )
            msg = _tr(
                "Вердикт: Минимальный риск\n\n Предупреждение:\n- MASS_REPORT_ABUSE (строка 18): Обнаружен вызов массовых жалоб на аккаунты (TL_account_reportPeer)",
                "Verdict: Minimal risk\n\n Warning:\n- MASS_REPORT_ABUSE (line 18): Account mass-report call detected (TL_account_reportPeer)"
            ) + debug_info
            builder.set_message(msg)
            builder.set_positive_button(_tr("Закрыть", "Close"), lambda d, w: d.dismiss() if hasattr(d, "dismiss") else None)
            builder.set_cancelable(True)
            builder.set_canceled_on_touch_outside(True)
            builder.show()

        elif subcmd in ("safe", "clean", "a", "ok"):
            builder = AlertDialogBuilder(ctx, AlertDialogBuilder.ALERT_TYPE_MESSAGE)
            builder.set_title(_tr("PluginGuard\nРейтинг: 100/100", "PluginGuard\nScore: 100/100"))
            debug_info = _tr(
                "\n\nВердикт: Код не обфусцирован, опасных вызовов нет\nВекторов: 20208\nСхожесть: мин 0.4600 / сред 0.7131 / макс 0.8699\nПорог: 0.6300 (+0.2399)\nЭнтропия: 4.3758 (норма)\nЧанков: 91",
                "\n\nVerdict: Code is clean, no dangerous calls\nVectors: 20208\nSimilarity: min 0.4600 / avg 0.7131 / max 0.8699\nThreshold: 0.6300 (+0.2399)\nEntropy: 4.3758 (normal)\nChunks: 91"
            )
            msg = _tr(
                "Вердикт: Безопасный плагин\n\n Вредоносный код и внешние каналы связи не обнаружены.",
                "Verdict: Safe plugin\n\n Malicious code and covert channels not detected."
            ) + debug_info
            builder.set_message(msg)
            builder.set_positive_button(_tr("Закрыть", "Close"), lambda d, w: d.dismiss() if hasattr(d, "dismiss") else None)
            builder.set_cancelable(True)
            builder.set_canceled_on_touch_outside(True)
            builder.show()

        elif subcmd in ("stats", "diag", "info"):
            meta = self._get_cached_metadata() or {}
            last = self._get_last_scan_stats() or {}
            raw_v = str(meta.get("version") or meta.get("model_version") or "1.0.1")
            builder = AlertDialogBuilder(ctx, AlertDialogBuilder.ALERT_TYPE_MESSAGE)
            builder.set_title(_tr("Диагностика PluginGuard", "PluginGuard Diagnostics"))
            clean_cnt = meta.get('total_clean_chunks', meta.get('vectors_count', 20208))
            mal_cnt = meta.get('total_malware_chunks', 0)
            is_dbg = self.is_using_debug_model()
            mode_str = _tr("ОТЛАДОЧНАЯ", "DEBUG") if is_dbg else _tr("Официальная", "Official")
            msg = (
                f"{_tr('Режим базы', 'Database mode')}: {mode_str}\n"
                f"{_tr('Версия модели', 'Model version')}: v{raw_v}\n"
                f"{_tr('Векторов чистых', 'Clean vectors')}: {clean_cnt}\n"
                f"{_tr('Сигнатур малварей', 'Malware signatures')}: {mal_cnt}\n"
                f"{_tr('Движок вычислений', 'Compute engine')}: {self._get_active_engine_name()}\n"
                f"{_tr('Кэш в RAM', 'RAM cache')}: {len(self._hash_cache)} {_tr('файлов', 'files')}\n"
                f"{_tr('Последняя проверка', 'Last scan')}: {last.get('scan_time_ms', 0)} {_tr('мс', 'ms')} ({last.get('scanned_chunks', 0)} {_tr('чанков', 'chunks')})\n"
                f"{_tr('Порог схожести', 'Similarity threshold')}: {last.get('threshold', 0.63):.4f}"
            )
            builder.set_message(msg)
            builder.set_positive_button(_tr("Закрыть", "Close"), lambda d, w: d.dismiss() if hasattr(d, "dismiss") else None)
            builder.set_cancelable(True)
            builder.show()

        elif subcmd in ("debug_model", "debugmodel", "devmodel", "custom_model"):
            if arg:
                self.set_setting("debug_github_repo_url", arg)
                self._sync_debug_model_manual(custom_url=arg, target_frag=frag)
            else:
                cur_url = self.get_setting("debug_github_repo_url", "")
                is_dbg = self.is_using_debug_model()
                builder = AlertDialogBuilder(ctx, AlertDialogBuilder.ALERT_TYPE_MESSAGE)
                builder.set_title(_tr("Отладочная модель", "Debug Model"))
                status_str = _tr("Активна", "Active") if is_dbg else _tr("Не активна", "Inactive")
                builder.set_message(
                    _tr(
                        f"Статус: {status_str}\nURL репозитория: {cur_url or 'Не задан'}\n\nДля загрузки используйте:\n.plugguard debug_model <url>",
                        f"Status: {status_str}\nRepository URL: {cur_url or 'Not set'}\n\nTo download use:\n.plugguard debug_model <url>"
                    )
                )
                builder.set_positive_button(_tr("Закрыть", "Close"), lambda d, w: d.dismiss() if hasattr(d, "dismiss") else None)
                if cur_url:
                    builder.set_neutral_button(_tr("Загрузить", "Download"), lambda d, w: (d.dismiss() if hasattr(d, "dismiss") else None, self._sync_debug_model_manual(custom_url=cur_url, target_frag=frag)))
                builder.show()

        elif subcmd in ("reset_model", "resetmodel", "official_model"):
            self._reset_to_official_model(target_frag=frag)

        elif subcmd in ("sync", "download"):
            self._sync_model_manual(target_frag=frag)

        elif subcmd in ("clear", "wipe"):
            self._clear_sql_cache()

        else:
            builder = AlertDialogBuilder(ctx, AlertDialogBuilder.ALERT_TYPE_MESSAGE)
            builder.set_title(_tr("Команды отладки PluginGuard", "PluginGuard Debug Commands"))
            msg = _tr(
                "Команды отладки:\n\n"
                "- .plugguard debug_model [url] — загрузка отладочной модели\n"
                "- .plugguard reset_model — сброс на релизную базу\n"
                "- .plugguard update [версия] — окно обновления модели\n"
                "- .plugguard danger — окно угрозы (Вредоносный плагин)\n"
                "- .plugguard warn — окно предупреждения (Минимальный риск)\n"
                "- .plugguard safe — окно безопасного плагина\n"
                "- .plugguard stats — статус базы и ML-движка\n"
                "- .plugguard sync — принудительная загрузка базы\n"
                "- .plugguard clear — очистка кэша проверок",
                "Debug commands:\n\n"
                "- .plugguard debug_model [url] — load debug model\n"
                "- .plugguard reset_model — reset to official model\n"
                "- .plugguard update [version] — model update dialog\n"
                "- .plugguard danger — threat dialog (Malicious plugin)\n"
                "- .plugguard warn — warning dialog (Minimal risk)\n"
                "- .plugguard safe — safe plugin dialog\n"
                "- .plugguard stats — database and ML engine status\n"
                "- .plugguard sync — force download model\n"
                "- .plugguard clear — clear scan cache"
            )
            builder.set_message(msg)
            builder.set_positive_button(_tr("Закрыть", "Close"), lambda d, w: d.dismiss() if hasattr(d, "dismiss") else None)
            builder.set_cancelable(True)
            builder.show()

    def _preload_resources(self):
        if getattr(self, "is_stopped", False):
            return
        self._check_version_update()
        if getattr(self, "is_stopped", False):
            return
        self._init_ram_cache()
        if getattr(self, "is_stopped", False):
            return
        self._ensure_model_downloaded()
        if getattr(self, "is_stopped", False):
            return
        try:
            self._get_dex_bridge()
        except Exception:
            pass

    def _check_version_update(self):
        try:
            meta = self._get_cached_metadata() or {}
            m_ver = str(meta.get("version") or meta.get("model_version") or "")
            cur_sig = f"{__version__}:{m_ver}:{zlib.crc32(ReportUI._RULES_DATA.encode()):08x}"
            last_ver = str(self.get_setting("last_plugin_version", "") or "")
            if last_ver != cur_sig:
                self.log(f"[PluginGuard] Plugin updated (from '{last_ver}' to '{cur_sig}'). Auto-clearing scan cache.")
                self._clear_cache_internal()
                self.set_setting("last_plugin_version", cur_sig)
        except Exception as e:
            self.log(f"[PluginGuard] _check_version_update failed: {e}")

    def _init_ram_cache(self):
        try:
            db_path = self._get_db_path()
            if os.path.exists(db_path):
                with sqlite3.connect(db_path) as conn:
                    cursor = conn.cursor()
                    cursor.execute("SELECT sha256, reports_json, stats_json FROM scan_cache ORDER BY timestamp DESC LIMIT 50")
                    loaded = {row[0]: (json.loads(row[1]), json.loads(row[2])) for row in cursor.fetchall()}
                lock = getattr(self, "_cache_lock", None)
                if lock:
                    with lock:
                        self._hash_cache.update(loaded)
                else:
                    self._hash_cache.update(loaded)
        except Exception:
            pass

    def _get_ui_classes(self):
        if not self._cached_ui_classes or not self._cached_ui_classes[0]:
            b_cls = find_class("org.telegram.ui.Stories.recorder.ButtonWithCounterView")
            l_cls = find_class("android.widget.LinearLayout")
            t_cls = find_class("org.telegram.ui.ActionBar.Theme")
            u_cls = find_class("org.telegram.messenger.AndroidUtilities")
            cb_cls = find_class("android.widget.CheckBox")
            comp_cls = find_class("android.widget.CompoundButton")
            self._cached_ui_classes = (b_cls, l_cls, t_cls, u_cls, cb_cls, comp_cls)
        return self._cached_ui_classes

    def _safe_set_text(self, view, text_str: str, animate: bool = False):
        if not view:
            return
        try:
            view.setText(text_str, animate)
        except Exception:
            try:
                view.setText(text_str)
            except Exception:
                pass

    def on_plugin_unload(self):
        with self._dex_lock:
            self.is_stopped = True
            self.is_active = False
        for tm in getattr(self, "_timers", []):
            try:
                tm.cancel()
            except Exception:
                pass
        self._timers.clear()
        _stop_spring_waiting_haptic()
        global _ACTIVE_GUARD_INSTANCE
        try:
            self.remove_on_send_message_hook()
        except Exception:
            pass
        if hasattr(self, "_installed_hooks") and self._installed_hooks:
            for h in self._installed_hooks:
                try:
                    self.unhook_method(h)
                except Exception:
                    pass
            self._installed_hooks.clear()
        try:
            if getattr(self, "_cached_dex_bridge", None):
                self._invoke_dex("unload")
        except Exception:
            pass
        try:
            if getattr(self, "_cached_hook_bridge", None):
                self._cached_hook_bridge.uninstall()
        except Exception:
            pass
        self._cached_dex_bridge = None
        self._cached_dex_loader = None
        self._cached_hook_bridge = None
        self._dex_model_loaded_path = None
        if hasattr(self, "_cached_methods") and self._cached_methods is not None:
            self._cached_methods.clear()
        self._cleanup_sheet_views()
        self._hash_cache.clear()
        self._vector_db = None
        self._vector_names = None
        self._model_metadata = None
        if _ACTIVE_GUARD_INSTANCE is self:
            _ACTIVE_GUARD_INSTANCE = None
        try:
            gc.collect()
        except Exception:
            pass

    def _cleanup_sheet_views(self):
        _stop_spring_waiting_haptic()
        self._current_scan_passed = False
        self._current_is_update = False
        self._current_analyze_btn = None
        self._current_sheet = None
        self._current_chk_box = None
        self._current_install_btn = None
        self._current_parent_layout = None
        self._current_orig_listener = None
        self._current_kpm_split = None
        _pending_file_path[0] = None
        _install_sheet_ids.clear()
        _modified_guard_sheets.clear()
        _verified_guard_sheets.clear()

    def _get_debug_cache_dir(self) -> str:
        d = os.path.join(self._get_cache_dir(), "debug_model")
        os.makedirs(d, exist_ok=True)
        return d

    def is_using_debug_model(self) -> bool:
        if not self.get_setting("debug_model_enabled", False):
            return False
        dbg_dir = self._get_debug_cache_dir()
        precision = int(self.get_setting("model_precision", 0))
        pref_pairs = [("norm_vectors.npz", "norm_metadata.json"), ("norm_vectors_8bit.npz", "norm_metadata_8bit.json")] if precision == 1 else [("norm_vectors_8bit.npz", "norm_metadata_8bit.json"), ("norm_vectors.npz", "norm_metadata.json")]
        for v_name, m_name in pref_pairs:
            v = os.path.join(dbg_dir, v_name)
            m = os.path.join(dbg_dir, m_name)
            if os.path.exists(v) and os.path.getsize(v) > 1000 and os.path.exists(m) and os.path.getsize(m) > 10:
                return True
        return False

    def _resolve_model_paths(self) -> Tuple[str, str]:
        precision = int(self.get_setting("model_precision", 0))
        if precision == 1:
            pref_pairs = [("norm_vectors.npz", "norm_metadata.json"), ("norm_vectors_8bit.npz", "norm_metadata_8bit.json")]
        else:
            pref_pairs = [("norm_vectors_8bit.npz", "norm_metadata_8bit.json"), ("norm_vectors.npz", "norm_metadata.json")]

        if self.get_setting("debug_model_enabled", False):
            dbg_dir = self._get_debug_cache_dir()
            for v_name, m_name in pref_pairs:
                v = os.path.join(dbg_dir, v_name)
                m = os.path.join(dbg_dir, m_name)
                if os.path.exists(v) and os.path.getsize(v) > 1000 and os.path.exists(m) and os.path.getsize(m) > 10:
                    return v, m

        candidates_dir = []
        cache_dir = self._get_cache_dir()
        if cache_dir:
            candidates_dir.append(cache_dir)
        try:
            from org.telegram.messenger import ApplicationLoader
            ctx = ApplicationLoader.applicationContext
            if ctx is not None:
                candidates_dir.append(os.path.join(ctx.getFilesDir().getAbsolutePath(), "plugin_guard_model"))
                candidates_dir.append(ctx.getFilesDir().getAbsolutePath())
                candidates_dir.append(os.path.join(ctx.getCacheDir().getAbsolutePath(), "plugin_guard_model"))
                candidates_dir.append(ctx.getCacheDir().getAbsolutePath())
        except Exception:
            pass
        if '__file__' in globals():
            candidates_dir.append(os.path.join(os.path.dirname(os.path.realpath(__file__)), "plugin_guard_model"))
            candidates_dir.append(os.path.dirname(os.path.realpath(__file__)))
        candidates_dir.append(os.path.join(os.getcwd(), "plugin_guard_model"))
        candidates_dir.append(os.getcwd())

        for v_name, m_name in pref_pairs:
            best_candidate = None
            best_version = (-1, -1, -1)
            best_mtime = 0.0
            for d in candidates_dir:
                v = os.path.join(d, v_name)
                m = os.path.join(d, m_name)
                if os.path.exists(v) and os.path.getsize(v) > 1000 and os.path.exists(m) and os.path.getsize(m) > 10:
                    try:
                        with open(m, "r", encoding="utf-8") as mf:
                            data = json.load(mf)
                            ver_str = str(data.get("version") or data.get("model_version") or "0.0.0")
                            parsed_v = self._parse_version(ver_str)
                            mtime = os.path.getmtime(m)
                            if parsed_v > best_version or (parsed_v == best_version and mtime > best_mtime):
                                best_version = parsed_v
                                best_mtime = mtime
                                best_candidate = (v, m)
                    except Exception:
                        if not best_candidate:
                            best_candidate = (v, m)
            if best_candidate:
                return best_candidate

        def_cache = self._get_cache_dir()
        def_v = pref_pairs[0][0]
        def_m = pref_pairs[0][1]
        return os.path.join(def_cache, def_v), os.path.join(def_cache, def_m)

    def _get_cached_metadata(self) -> Optional[Dict[str, Any]]:
        try:
            _, meta_path = self._resolve_model_paths()
            if os.path.exists(meta_path):
                with open(meta_path, "r", encoding="utf-8") as f:
                    return json.load(f)
        except Exception:
            pass
        return None

    def _save_last_scan_stats(self, stats: Dict[str, Any]):
        self._last_scan_stats = stats
        try:
            cache_dir = self._get_cache_dir()
            scan_meta_path = os.path.join(cache_dir, "norm_last_scan.json")
            with open(scan_meta_path, "w", encoding="utf-8") as f:
                json.dump(stats, f, ensure_ascii=False, indent=2)
        except Exception:
            pass

    def _get_last_scan_stats(self) -> Dict[str, Any]:
        if hasattr(self, "_last_scan_stats") and self._last_scan_stats:
            return self._last_scan_stats
        try:
            cache_dir = self._get_cache_dir()
            scan_meta_path = os.path.join(cache_dir, "norm_last_scan.json")
            if os.path.exists(scan_meta_path):
                with open(scan_meta_path, "w", encoding="utf-8") as f:
                    self._last_scan_stats = json.load(f)
                    return self._last_scan_stats
        except Exception:
            pass
        return {}

    def _get_db_path(self) -> str:
        cache_dir = self._get_cache_dir()
        db_dir = os.path.join(cache_dir, "scan_cache")
        os.makedirs(db_dir, exist_ok=True)
        return os.path.join(db_dir, "plugins_hash_cache.db")

    def _init_cache_db(self):
        try:
            db_path = self._get_db_path()
            with sqlite3.connect(db_path, timeout=10.0) as conn:
                conn.execute("PRAGMA journal_mode=WAL")
                conn.execute("PRAGMA synchronous=NORMAL")
                conn.execute("PRAGMA temp_store=MEMORY")
                conn.execute("CREATE TABLE IF NOT EXISTS scan_cache (sha256 TEXT PRIMARY KEY, file_name TEXT, timestamp REAL, reports_json TEXT, stats_json TEXT)")
                conn.commit()
            self._db_initialized = True
        except Exception:
            pass

    def _get_cached_scan_result(self, file_hash: str) -> Optional[Tuple[List[Dict[str, Any]], Dict[str, Any]]]:
        if not file_hash:
            return None
        lock = getattr(self, "_cache_lock", None)
        if lock:
            with lock:
                if hasattr(self, "_hash_cache") and file_hash in self._hash_cache:
                    return self._hash_cache[file_hash]
        elif hasattr(self, "_hash_cache") and file_hash in self._hash_cache:
            return self._hash_cache[file_hash]

        try:
            db_path = self._get_db_path()
            if os.path.exists(db_path):
                with sqlite3.connect(db_path, timeout=10.0) as conn:
                    cursor = conn.cursor()
                    cursor.execute("SELECT reports_json, stats_json FROM scan_cache WHERE sha256 = ?", (file_hash,))
                    row = cursor.fetchone()
                    if row:
                        reports = json.loads(row[0])
                        stats = json.loads(row[1])
                        if lock:
                            with lock:
                                if not hasattr(self, "_hash_cache"):
                                    self._hash_cache = {}
                                if len(self._hash_cache) > 100:
                                    first_k = next(iter(self._hash_cache), None)
                                    if first_k:
                                        del self._hash_cache[first_k]
                                self._hash_cache[file_hash] = (reports, stats)
                        else:
                            if not hasattr(self, "_hash_cache"):
                                self._hash_cache = {}
                            if len(self._hash_cache) > 100:
                                first_k = next(iter(self._hash_cache), None)
                                if first_k:
                                    del self._hash_cache[first_k]
                            self._hash_cache[file_hash] = (reports, stats)
                        return reports, stats
        except Exception:
            pass
        return None

    def _save_cached_scan_result(self, file_hash: str, file_name: str, reports: List[Dict[str, Any]], stats: Dict[str, Any]):
        if not file_hash:
            return
        lock = getattr(self, "_cache_lock", None)
        if lock:
            with lock:
                if not hasattr(self, "_hash_cache"):
                    self._hash_cache = {}
                if len(self._hash_cache) > 100:
                    first_k = next(iter(self._hash_cache), None)
                    if first_k:
                        del self._hash_cache[first_k]
                self._hash_cache[file_hash] = (reports, stats)
        else:
            if not hasattr(self, "_hash_cache"):
                self._hash_cache = {}
            if len(self._hash_cache) > 100:
                first_k = next(iter(self._hash_cache), None)
                if first_k:
                    del self._hash_cache[first_k]
            self._hash_cache[file_hash] = (reports, stats)

        try:
            db_path = self._get_db_path()
            if not getattr(self, "_db_initialized", False):
                self._init_cache_db()
            with sqlite3.connect(db_path, timeout=10.0) as conn:
                conn.execute(
                    "INSERT OR REPLACE INTO scan_cache (sha256, file_name, timestamp, reports_json, stats_json) VALUES (?, ?, ?, ?, ?)",
                    (file_hash, file_name, time.time(), json.dumps(reports, ensure_ascii=False), json.dumps(stats, ensure_ascii=False))
                )
                conn.commit()
        except Exception:
            pass

    def _clear_cache_internal(self):
        try:
            lock = getattr(self, "_cache_lock", None)
            if lock:
                with lock:
                    if hasattr(self, "_hash_cache"):
                        self._hash_cache.clear()
            elif hasattr(self, "_hash_cache"):
                self._hash_cache.clear()
            if hasattr(self, "_last_scan_stats"):
                self._last_scan_stats.clear()
            db_path = self._get_db_path()
            if os.path.exists(db_path):
                with sqlite3.connect(db_path, timeout=10.0) as conn:
                    conn.execute("DELETE FROM scan_cache")
                    conn.commit()

        except Exception as e:
            self.log(f"[PluginGuard] _clear_cache_internal error: {e}")

    def _clear_sql_cache(self):
        try:
            self._clear_cache_internal()
            fragment = get_last_fragment()
            if fragment:
                BulletinHelper.show_success(_tr("Кэш SQLite успешно очищен!", "SQLite cache successfully cleared!"), fragment)
        except Exception as e:
            fragment = get_last_fragment()
            if fragment:
                BulletinHelper.show_error(f"{_tr('Ошибка очистки кэша', 'Cache clearing error')}: {e}", fragment)

    def _get_active_engine_name(self) -> str:
        bridge = self._get_dex_bridge()
        if bridge is not None:
            return "Native Java (SIMD)"
        return "Pure Python Engine"

    def _on_model_precision_change(self, new_val: int):
        self.set_setting("model_precision", new_val, reload_settings=True)
        ModelStore._CACHE.clear()
        self.is_model_loaded = False
        self._vector_db = None
        self._model_metadata = None
        self._cached_dex_bridge = None
        self._dex_model_loaded_path = None
        self._clear_cache_internal()
        self._ensure_model_downloaded()

    def create_settings(self):
        frag = get_last_fragment()
        threading.Thread(target=lambda: self._check_remote_version_async(frag), daemon=True).start()

        meta = self._get_cached_metadata()
        raw_ver = str(meta.get("version") or meta.get("model_version") or "1.0.1") if meta else _tr("Не загружена", "Not loaded")
        model_ver = raw_ver.lstrip("v")
        cur_prec = int(self.get_setting("model_precision", 0))
        prec_title = "16-bit Float16" if cur_prec == 1 else "8-bit"
        if meta:
            try:
                vec_p, _ = self._resolve_model_paths()
                if "8bit" in os.path.basename(vec_p):
                    prec_title = "8-bit"
                elif os.path.exists(vec_p):
                    try:
                        with zipfile.ZipFile(vec_p, "r") as z:
                            head = z.read("vectors.npy")[:128]
                            if b"|u1" in head or b"uint8" in head or b"int8" in head or b"'descr': '|i1'" in head:
                                prec_title = "8-bit"
                            elif b"<f2" in head or b"float16" in head:
                                prec_title = "8-bit" if cur_prec == 0 else "16-bit Float16"
                            elif b"<f4" in head or b"float32" in head:
                                prec_title = "8-bit" if cur_prec == 0 else "32-bit Float32"
                            else:
                                prec_title = "16-bit Float16" if cur_prec == 1 else "8-bit"
                    except Exception:
                        prec_title = "16-bit Float16" if cur_prec == 1 else "8-bit"
            except Exception:
                pass
        vec_count = (meta.get("total_clean_chunks") or meta.get("total_chunks") or meta.get("vectors_count", 0)) if meta else 0
        malware_count = meta.get("total_malware_chunks", 0) if meta else 0
        is_dbg = self.is_using_debug_model()
        model_tag = f" [{_tr('ОТЛАДОЧНАЯ', 'DEBUG')}]" if is_dbg else ""
        if vec_count:
            if is_dbg:
                dbg_repo = self.get_setting("debug_github_repo_url", "").strip()
                short_repo = (dbg_repo[:38] + "...") if len(dbg_repo) > 40 else dbg_repo
                ver_sub = f"⚠️ {_tr('Отладочная модель', 'Debug model')} ({short_repo or 'local'}): {vec_count:,} {_tr('чистых', 'clean')} + {malware_count} {_tr('сигнатур', 'signatures')}"
            else:
                ver_sub = f"{_tr('Загружено векторов', 'Loaded vectors')}: {vec_count:,} ({_tr('чистых', 'clean')}) + {malware_count} ({_tr('сигнатур', 'signatures')})"
        else:
            ver_sub = _tr("База векторов не загружена", "Vector database not loaded")

        last_stats = self._get_last_scan_stats()
        engine_status = self._get_active_engine_name()
        scan_time_ms = last_stats.get("scan_time_ms", 0.0)
        scanned_chunks = last_stats.get("scanned_chunks", 0)
        max_sim = last_stats.get("max_similarity", 0.0)
        threshold = last_stats.get("threshold", 0.6300)

        speed_sub = f"{scan_time_ms} {_tr('мс', 'ms')} ({scanned_chunks} {_tr('чанков', 'chunks')})" if scan_time_ms > 0 else _tr("Замеры отсутствуют", "No benchmark data")
        sim_sub = f"{_tr('Схожесть', 'Similarity')}: {max_sim:.4f} | {_tr('Порог', 'Threshold')}: {threshold:.4f}" if max_sim > 0 else _tr("Нет данных последнего анализа", "No data from last scan")

        db_entries_count = 0
        try:
            db_path = self._get_db_path()
            if os.path.exists(db_path):
                with sqlite3.connect(db_path) as conn:
                    cursor = conn.cursor()
                    cursor.execute("SELECT COUNT(*) FROM scan_cache")
                    row = cursor.fetchone()
                    if row:
                        db_entries_count = row[0]
        except Exception:
            pass

        cache_sub = f"{_tr('Сохранено отчетов на диске', 'Reports stored on disk')}: {db_entries_count}" if db_entries_count > 0 else _tr("Кэш пуст", "Cache is empty")

        return [
            Header(text=_tr("База данных безопасности", "Security Database")),
            Text(text=f"{_tr('Версия модели', 'Model version')}: v{model_ver} ({prec_title}){model_tag}", subtext=ver_sub, icon="msg_about"),
            Selector(
                key="model_precision",
                text=_tr("Точность векторов", "Vector Model Precision"),
                default=0,
                items=[
                    _tr("8-бит (Рекомендуется)", "8-bit (Recommended)"),
                    _tr("16-бит (Float16)", "16-bit (Float16)")
                ],
                icon="msg_media",
                on_change=self._on_model_precision_change
            ),
            Divider(text=_tr(
                "8-бит: экономит 50% RAM и ускоряет поиск при сохранении ≈ 99.2% точности.\n16-бит: полная точность без квантования, ценой повышенного расхода памяти.",
                "8-bit: saves 50% RAM and accelerates search with 99.8% accuracy.\n16-bit: full original float precision without quantization at higher RAM cost."
            )),
            Header(text=_tr("Диагностика и замеры скорости", "Diagnostics & Speed Benchmarks")),
            Text(text=_tr("Движок вычислений", "Compute Engine"), subtext=engine_status, icon="msg_permissions"),
            Text(text=_tr("Время последней проверки", "Last Scan Duration"), subtext=speed_sub, icon="msg_radar"),
            Text(text=_tr("Метрика схожести Top-5", "Top-5 Similarity Metric"), subtext=sim_sub, icon="msg_stats"),
            Header(text=_tr("Управление кэшем проверок", "Scan Cache Management")),
            Text(text=_tr("Очистить кэш проверок", "Clear Scan Cache"), subtext=cache_sub, icon="msg_delete", red=True, on_click=lambda v: self._clear_sql_cache()),
            Header(text=_tr("Отладка и дампы", "Debugging & Dumps")),
            Switch(key="save_debug_dumps", text=_tr("Сохранять дампы для отладки", "Save Dumps for Debugging"), default=False, subtext=_tr("Экспортировать декомпилированный DEX и отчеты в папку Download/PluginGuard_Dumps", "Export decompiled DEX and reports to Download/PluginGuard_Dumps")),
            Switch(key="debug_model_enabled", text=_tr("Режим отладочной модели", "Debug Model Mode"), default=False, subtext=_tr("Тебе это явно не нужно...", "You clearly don't need this..."), on_change=self._on_debug_model_toggle),
            Input(key="debug_github_repo_url", text=_tr("URL отладочного GitHub репо", "Debug Model GitHub URL"), default="", subtext=_tr("Ссылка на репозиторий с тестовыми npz и json базами", "Link to repository with test npz and json databases")),
            Text(text=_tr("Загрузить отладочную модель", "Download Debug Model"), icon="msg_download", accent=True, on_click=lambda v: self._sync_debug_model_manual()),
            Text(text=_tr("Сбросить на релизную модель", "Reset to Official Model"), icon="msg_delete", red=True, on_click=lambda v: self._reset_to_official_model()),
            Header(text=_tr("Настройки обновления базы", "Database Update Settings")),
            Input(key="github_repo_url", text="GitHub Base URL", default="https://github.com/abova8382993/PluginGuard-model/blob/main/norm_metadata_8bit.json", subtext=_tr("Ссылка на репозиторий с norm_vectors_8bit.npz и norm_metadata_8bit.json", "Link to repository with norm_vectors_8bit.npz and norm_metadata_8bit.json")),
            Switch(key="auto_block", text=_tr("Блокировать опасные плагины", "Block Malicious Plugins"), default=True, subtext=_tr("Автоматически отменять установку вредоносных плагинов", "Automatically abort installation of malicious plugins")),
            Switch(key="notify_model_updates", text=_tr("Сообщать об обновлениях модели", "Notify on Model Updates"), default=True, subtext=_tr("Уведомлять при выходе новых версий базы безопасности", "Receive notifications when new security database updates are released")),
            Text(text=_tr("Синхронизировать модель с GitHub", "Sync Model with GitHub"), icon="msg_retry", accent=True, on_click=lambda v: self._sync_model_manual())
        ]

    def _normalize_github_url(self, url: str) -> str:
        u = url.strip()
        for fn in ["norm_metadata_8bit.json", "norm_vectors_8bit.npz", "norm_metadata.json", "norm_vectors.npz", "norm_vectors.npy", "version.txt"]:
            if u.endswith(fn):
                u = u[:-len(fn)]
        u = u.rstrip("/")
        if "github.com/" in u:
            parts = u.split("github.com/", 1)[1].split("/")
            owner = parts[0]
            repo = parts[1] if len(parts) > 1 else ""
            branch_and_path = "main"
            if len(parts) >= 4 and parts[2] in ("blob", "tree"):
                branch_and_path = "/".join(parts[3:])
            return f"https://raw.githubusercontent.com/{owner}/{repo}/{branch_and_path}/"
        elif "raw.githubusercontent.com/" in u:
            return u + "/"
        return u + "/"

    def _parse_version(self, v_str: str) -> Tuple[int, ...]:
        try:
            clean_v = str(v_str).strip().lstrip("vV")
            return tuple(int(x) for x in clean_v.split("."))
        except Exception:
            return (0, 0, 0)

    def _get_active_context(self, frag: Any = None) -> Any:
        for f in [frag, get_last_fragment()]:
            if f:
                try:
                    act = f.getParentActivity()
                    if act is not None:
                        return act
                except Exception:
                    pass
                try:
                    ctx = f.getContext()
                    if ctx is not None:
                        return ctx
                except Exception:
                    pass
        try:
            from org.telegram.messenger import ApplicationLoader
            return ApplicationLoader.applicationContext
        except Exception:
            return None

    def _check_remote_version_async(self, target_frag: Any = None):
        if not self.get_setting("notify_model_updates", True):
            return
        try:
            raw_input_url = self.get_setting("github_repo_url", "https://github.com/abova8382993/PluginGuard-model/blob/main/norm_metadata_8bit.json").strip()
            base_url = self._normalize_github_url(raw_input_url)
            ts = int(time.time())
            ver_url = f"{base_url}version.txt?t={ts}"

            headers = {"User-Agent": "Mozilla/5.0", "Cache-Control": "no-cache", "Pragma": "no-cache"}
            remote_ver = ""
            try:
                req_ver = urllib.request.Request(ver_url, headers=headers)
                with urllib.request.urlopen(req_ver, timeout=8) as resp:
                    remote_ver = resp.read().decode("utf-8").strip()
            except Exception:
                pass

            if not remote_ver:
                precision = int(self.get_setting("model_precision", 0))
                meta_fns = ["norm_metadata.json", "norm_metadata_8bit.json"] if precision == 1 else ["norm_metadata_8bit.json", "norm_metadata.json"]
                for meta_fn in meta_fns:
                    try:
                        meta_url = f"{base_url}{meta_fn}?t={ts}"
                        req_meta = urllib.request.Request(meta_url, headers=headers)
                        with urllib.request.urlopen(req_meta, timeout=8) as resp:
                            meta_j = json.loads(resp.read().decode("utf-8"))
                            remote_ver = str(meta_j.get("version") or meta_j.get("model_version") or "").strip()
                            if remote_ver:
                                break
                    except Exception:
                        pass

            if not remote_ver:
                return

            local_meta = self._get_cached_metadata()
            local_ver = str(local_meta.get("version") or local_meta.get("model_version") or "1.0.1") if local_meta else "1.0.1"

            if self._parse_version(remote_ver) > self._parse_version(local_ver):
                def _notify_ui():
                    frag = target_frag or get_last_fragment()
                    if frag:
                        try:
                            BulletinHelper.show_info(_tr(f"🔔 Доступно обновление модели v{remote_ver}!", f"🔔 Model update v{remote_ver} available!"), frag)
                        except Exception:
                            pass
                    self._show_update_available_dialog(remote_ver, local_ver, frag)

                run_on_ui_thread(_notify_ui)
        except Exception as e:
            self.log(f"[PluginGuard DEBUG] Version check error: {e}")

    def _show_update_available_dialog(self, remote_ver: str, local_ver: str, active_frag: Any = None):
        context = self._get_active_context(active_frag)
        if not context:
            return
        builder = AlertDialogBuilder(context, AlertDialogBuilder.ALERT_TYPE_MESSAGE)
        builder.set_title(_tr("🔔 Обновление модели", "🔔 Model Update"))
        builder.set_message(
            _tr(
                f"Доступна новая версия модели безопасности!\n\nТекущая: v{local_ver}\nНовая: v{remote_ver}\n\nЖелаете загрузить обновление?",
                f"A new version of the security model is available!\n\nCurrent: v{local_ver}\nNew: v{remote_ver}\n\nWould you like to download the update?"
            )
        )
        builder.set_positive_button(_tr("Обновить", "Update"), lambda d, w: (d.dismiss() if hasattr(d, "dismiss") else None, self._sync_model_manual()))
        
        def _on_never_show(d, w):
            if hasattr(d, "dismiss"):
                d.dismiss()
            self.set_setting("notify_model_updates", False)
            f = active_frag or get_last_fragment()
            if f:
                run_on_ui_thread(lambda: BulletinHelper.show_info(_tr("Уведомления об обновлениях модели отключены в настройках", "Model update notifications disabled in settings"), f))

        builder.set_negative_button(_tr("Больше не показывать", "Don't show again"), _on_never_show)
        builder.show()

    def _on_debug_model_toggle(self, enabled: bool):
        self.set_setting("debug_model_enabled", enabled, reload_settings=True)
        ModelStore._CACHE.clear()
        self.is_model_loaded = False
        self._vector_db = None
        self._model_metadata = None
        self._cached_dex_bridge = None
        self._dex_model_loaded_path = None
        self._clear_cache_internal()
        try:
            self._get_dex_bridge()
        except Exception:
            pass

    def _sync_debug_model_manual(self, custom_url: str = "", target_frag: Any = None):
        url = (custom_url or self.get_setting("debug_github_repo_url", "")).strip()
        frag = target_frag or get_last_fragment()
        if not url:
            if frag:
                try:
                    BulletinHelper.show_error(_tr("Укажите GitHub URL отладочной модели", "Specify Debug Model GitHub URL"), frag)
                except Exception:
                    pass
            return
        if frag:
            try:
                BulletinHelper.show_info(_tr("Загрузка отладочной модели...", "Downloading debug model..."), frag)
            except Exception:
                pass
        threading.Thread(target=lambda: self._download_github_model(custom_url=url, is_debug=True, target_frag=frag), daemon=True).start()

    def _reset_to_official_model(self, target_frag: Any = None):
        self.set_setting("debug_model_enabled", False, reload_settings=True)
        ModelStore._CACHE.clear()
        self.is_model_loaded = False
        self._vector_db = None
        self._model_metadata = None
        self._cached_dex_bridge = None
        self._dex_model_loaded_path = None
        self._clear_cache_internal()
        try:
            self._get_dex_bridge()
        except Exception:
            pass
        frag = target_frag or get_last_fragment()
        if frag:
            try:
                BulletinHelper.show_info(_tr("Возврат к официальной модели безопасности", "Reverted to official security model"), frag)
            except Exception:
                pass

    def _sync_model_manual(self, target_frag: Any = None):
        fragment = target_frag or get_last_fragment()
        if fragment:
            try:
                BulletinHelper.show_info(_tr("Загрузка модели безопасности с GitHub...", "Downloading security model from GitHub..."), fragment)
            except Exception:
                pass
        threading.Thread(target=lambda: self._download_github_model(is_debug=False, target_frag=fragment), daemon=True).start()

    def _download_github_model(self, custom_url: str = "", is_debug: bool = False, target_frag: Any = None):
        if is_debug:
            raw_input_url = (custom_url or self.get_setting("debug_github_repo_url", "")).strip()
        else:
            raw_input_url = (custom_url or self.get_setting("github_repo_url", "https://github.com/abova8382993/PluginGuard-model/blob/main/norm_metadata_8bit.json")).strip()

        if not raw_input_url:
            err_msg = _tr("URL репозитория не указан", "Repository URL not specified")
            run_on_ui_thread(lambda: BulletinHelper.show_error(err_msg, target_frag or get_last_fragment()) if (target_frag or get_last_fragment()) else None)
            return

        base_url = self._normalize_github_url(raw_input_url)
        ts = int(time.time())
        headers = {
            "User-Agent": "Mozilla/5.0",
            "Cache-Control": "no-cache",
            "Pragma": "no-cache"
        }

        try:
            vec_data = None
            meta_data = None
            chosen_pair = None
            precision = int(self.get_setting("model_precision", 0))
            if precision == 1:
                pairs = [("norm_vectors.npz", "norm_metadata.json"), ("norm_vectors_8bit.npz", "norm_metadata_8bit.json")]
            else:
                pairs = [("norm_vectors_8bit.npz", "norm_metadata_8bit.json"), ("norm_vectors.npz", "norm_metadata.json")]
            for v_fn, m_fn in pairs:
                try:
                    vec_url = f"{base_url}{v_fn}?t={ts}"
                    meta_url = f"{base_url}{m_fn}?t={ts}"
                    req_vec = urllib.request.Request(vec_url, headers=headers)
                    with urllib.request.urlopen(req_vec, timeout=25) as resp:
                        v_temp = resp.read()
                    req_meta = urllib.request.Request(meta_url, headers=headers)
                    with urllib.request.urlopen(req_meta, timeout=20) as resp:
                        m_temp = resp.read()
                    if len(v_temp) >= 1000 and len(m_temp) >= 50:
                        vec_data = v_temp
                        meta_data = m_temp
                        chosen_pair = (v_fn, m_fn)
                        break
                except Exception:
                    pass

            if not vec_data or not meta_data or not chosen_pair:
                raise ValueError(_tr("Загруженные файлы повреждены или пусты", "Downloaded files are corrupted or empty"))

            if is_debug:
                debug_dir = self._get_debug_cache_dir()
                vec_path = os.path.join(debug_dir, chosen_pair[0])
                meta_path = os.path.join(debug_dir, chosen_pair[1])
                with open(vec_path, "wb") as f_vec:
                    f_vec.write(vec_data)
                with open(meta_path, "wb") as f_meta:
                    f_meta.write(meta_data)
                self.set_setting("debug_model_enabled", True)
                if custom_url:
                    self.set_setting("debug_github_repo_url", custom_url)
            else:
                cache_dir = self._get_cache_dir()
                vec_path = os.path.join(cache_dir, chosen_pair[0])
                meta_path = os.path.join(cache_dir, chosen_pair[1])
                with open(vec_path, "wb") as f_vec:
                    f_vec.write(vec_data)
                with open(meta_path, "wb") as f_meta:
                    f_meta.write(meta_data)

                target_dirs = []
                try:
                    from org.telegram.messenger import ApplicationLoader
                    c = ApplicationLoader.applicationContext
                    if c:
                        target_dirs.append(c.getFilesDir().getAbsolutePath())
                        target_dirs.append(c.getCacheDir().getAbsolutePath())
                        target_dirs.append(os.path.join(c.getFilesDir().getAbsolutePath(), "plugin_guard_model"))
                        target_dirs.append(os.path.join(c.getCacheDir().getAbsolutePath(), "plugin_guard_model"))
                except Exception:
                    pass

                base_v_fn = chosen_pair[0]
                base_m_fn = chosen_pair[1]
                for td in target_dirs:
                    try:
                        os.makedirs(td, exist_ok=True)
                        with open(os.path.join(td, base_v_fn), "wb") as f_vec:
                            f_vec.write(vec_data)
                        with open(os.path.join(td, base_m_fn), "wb") as f_meta:
                            f_meta.write(meta_data)
                    except Exception:
                        pass

            ModelStore._CACHE.clear()
            self.is_model_loaded = False
            self._vector_db = None
            self._model_metadata = None
            self._cached_dex_bridge = None
            self._dex_model_loaded_path = None
            self._clear_cache_internal()

            new_ver = "2.0.0"
            clean_cnt = 20432
            mal_cnt = 1115
            try:
                meta_j = json.loads(meta_data.decode("utf-8"))
                new_ver = str(meta_j.get("version") or meta_j.get("model_version") or "2.0.0").lstrip("v")
                clean_cnt = meta_j.get("total_clean_chunks", 20432)
                mal_cnt = meta_j.get("total_malware_chunks", 1115)
            except Exception:
                pass

            try:
                self._get_dex_bridge()
            except Exception:
                pass

            if is_debug:
                success_msg = _tr(
                    f"Отладочная модель активирована: v{new_ver} ({clean_cnt:,} чистых / {mal_cnt} сигнатур)",
                    f"Debug model active: v{new_ver} ({clean_cnt:,} clean / {mal_cnt} signatures)"
                )
            else:
                success_msg = _tr(
                    f"Модель обновлена: v{new_ver} ({clean_cnt:,} чистых / {mal_cnt} сигнатур)",
                    f"Model updated: v{new_ver} ({clean_cnt:,} clean / {mal_cnt} signatures)"
                )
            def _show_ui_success():
                frag = target_frag or get_last_fragment()
                if frag:
                    try:
                        BulletinHelper.show_success(success_msg, frag)
                    except Exception:
                        pass
            run_on_ui_thread(_show_ui_success)
        except Exception as e:
            err_msg = f"{_tr('Ошибка загрузки модели', 'Model download error')}: {e}"
            def _show_ui_error():
                frag = target_frag or get_last_fragment()
                if frag:
                    try:
                        BulletinHelper.show_error(err_msg, frag)
                    except Exception:
                        pass
            run_on_ui_thread(_show_ui_error)

    def _ensure_model_downloaded(self):
        vec_path, _ = self._resolve_model_paths()
        if not os.path.exists(vec_path) or os.path.getsize(vec_path) < 1000:
            threading.Thread(target=self._download_github_model, daemon=True).start()

    def _get_cache_dir(self) -> str:
        try:
            from org.telegram.messenger import ApplicationLoader
            ctx = ApplicationLoader.applicationContext
            d = os.path.join(ctx.getFilesDir().getAbsolutePath(), "plugin_guard_model")
            os.makedirs(d, exist_ok=True)
            return d
        except Exception:
            d = os.path.join(os.getcwd(), "plugin_guard_model")
            os.makedirs(d, exist_ok=True)
            return d

    def _calculate_security_score(self, reports: List[Dict[str, Any]], ai_stats: Dict[str, Any]) -> Tuple[int, str]:
        return ReportUI.calculate_score(reports, ai_stats)

    MANGLED_VAR_REGEX = re.compile(r'^(_0x[a-fA-F0-9]{4,}|[I|l|1|_]{5,}|_[a-z0-9]{12,})$')
    RE_BASE64_LONG = re.compile(r'^[a-zA-Z0-9+/=]{100,}$')
    RE_HEX_LONG = re.compile(r'^(?:[0-9a-fA-F]{2}){20,}$')
    RE_BASE64_STRICT = re.compile(r'^[A-Za-z0-9+/=]+$')
    RE_BASE64_WITH_WS = re.compile(r'^[A-Za-z0-9+/=\s]+$')
    RE_BOT_TOKEN = re.compile(r'\b\d{8,10}:[A-Za-z0-9_-]{35}\b')
    RE_SO_LIB = re.compile(r' ([a-zA-Z0-9_\-\./]+\.so) ')
    RE_HEX_KEY = re.compile(r'^[0-9a-fA-F]{8,}$')
    RE_WALLET_BTC = re.compile(r'\b(?:bc1[a-zA-HJ-NP-Z0-9]{25,39}|[13][a-km-zA-HJ-NP-Z1-9]{25,34})\b')
    RE_WALLET_ETH = re.compile(r'\b0x[a-fA-F0-9]{40}\b')
    RE_WALLET_TON = re.compile(r'\b(?:EQ|UQ)[a-zA-Z0-9_-]{46}\b')
    RE_WALLET_TRX = re.compile(r'\bT[A-Za-z1-9]{33}\b')
    RE_2FA_CODE_KEYWORD = re.compile(r'(?i)(login\s*code|код\s*входа|код\s*подтверждения|авторизаци|login\s*attempt)')
    RE_COMMENT_B64 = re.compile(r'(?:^[ \t]*#[ \t]*\S{25,}[ \t]*\r?\n){2,}(?:^[ \t]*#[ \t]*\S{1,}[ \t]*\r?\n)?', re.MULTILINE)
    RE_IPV4_C2 = re.compile(r'https?://(?:(?:\d{1,3}\.){3}\d{1,3}|(?:\d{1,3}[.-]){3}\d{1,3}\.(?:sslip|nip)\.io)(?::\d+)?(?:/|\b)')

    @classmethod
    def _is_safe_imp(cls, node: ast.AST) -> bool:
        if isinstance(node, ast.Call) and len(node.args) == 1 and not getattr(node, 'keywords', []):
            arg0 = node.args[0]
            if isinstance(arg0, ast.Constant) and isinstance(arg0.value, str):
                raw_m = arg0.value.strip()
                if raw_m not in ("urllib.request", "urllib.parse") and raw_m.split(".")[0] in cls.SAFE_IMPORTS:
                    return True
        return False

    @staticmethod
    def _is_known_binary_asset(val: Any) -> bool:
        magics = (bytes.fromhex("6465780a"), bytes.fromhex("7f454c46"), bytes.fromhex("89504e47"), bytes.fromhex("ffd8ff"), b"GIF87a", b"GIF89a", b"RIFF", b"\x1f\x8b")
        def _is_asset_bytes(b_data: bytes) -> bool:
            if b_data.startswith(magics):
                return True
            head = b_data.lstrip()[:512]
            if head.startswith(b"{") and any(k in head for k in (b'"v":', b'"fr":', b'"layers":', b'"assets":', b'"ip":', b'"op":', b'"tgs":')):
                return True
            return False
        if isinstance(val, bytes):
            if _is_asset_bytes(val):
                return True
            try:
                decomp = zlib.decompress(val)
                if _is_asset_bytes(decomp):
                    return True
            except Exception:
                pass
        elif isinstance(val, str):
            s = val.strip()
            if len(s) > 60:
                if s.startswith("M") and any(k in s for k in (" C", " L", " Z", "c", "l", "z")) and re.match(r'^[MLHVCSQTAZmlhvcsqtaz0-9.,\-\s]+$', s[:200]):
                    return True
                try:
                    raw = base64.b64decode(s)
                    if _is_asset_bytes(raw):
                        return True
                    try:
                        decomp = zlib.decompress(raw)
                        if _is_asset_bytes(decomp):
                            return True
                    except Exception:
                        pass
                except Exception:
                    pass
        return False

    def _analyze_obfuscation(self, code_str: str, tree: Optional[ast.AST] = None) -> Tuple[float, str, float, int]:
        if not code_str:
            return 0.0, "NORMAL", 0.0, 0

        if tree is None:
            try:
                tree = ast.parse(code_str)
            except Exception:
                chars = [c for c in code_str if ord(c) < 128 and not c.isspace()]
                length = len(chars)
                freq = {}
                for char in chars:
                    freq[char] = freq.get(char, 0) + 1
                raw_entropy = sum(-(c / length) * math.log2(c / length) for c in freq.values()) if length > 0 else 0.0
                return round(raw_entropy, 4), "HIGH", 90.0, 0

        class LiteralClean(ast.NodeTransformer):
            def visit_Constant(self, node):
                if isinstance(node.value, (str, bytes)):
                    val = node.value
                    val_s = val.decode('utf-8', 'ignore') if isinstance(val, bytes) else val
                    if len(val_s) > 40 or any(ord(c) > 127 for c in val_s) or PluginGuard._is_known_binary_asset(node.value):
                        return ast.Constant(value="")
                return node

        try:
            norm_tree = LiteralClean().visit(ast.parse(code_str))
            ast.fix_missing_locations(norm_tree)
            clean_text = ast.unparse(norm_tree)
        except Exception:
            clean_text = code_str

        ascii_only = "".join(c for c in clean_text if ord(c) < 128 and not c.isspace())
        length = len(ascii_only)
        freq = {}
        for char in ascii_only:
            freq[char] = freq.get(char, 0) + 1
        entropy = sum(-(c / length) * math.log2(c / length) for c in freq.values()) if length > 0 else 0.0

        total_vars = 0
        mangled_vars = 0
        chr_ord_count = 0
        dynamic_exec = 0
        dynamic_imports = 0
        reverse_slices = 0
        hex_blobs = 0
        high_entropy_literals = 0
        nested_lambdas = 0
        nodes_count = 0
        identifiers = []

        for node in ast.walk(tree):
            nodes_count += 1
            if isinstance(node, ast.Name):
                total_vars += 1
                identifiers.append(node.id)
                if self.MANGLED_VAR_REGEX.match(node.id):
                    mangled_vars += 1
                if node.id in ('eval', 'exec', 'compile'):
                    dynamic_exec += 1
            elif isinstance(node, ast.Attribute):
                identifiers.append(node.attr)
                if node.attr in ('b64decode', 'decompress', 'unhexlify', 'b85decode', 'a85decode', 'b32decode'):
                    dynamic_imports += 1
            elif isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)):
                identifiers.append(node.name)
            elif isinstance(node, ast.arg):
                identifiers.append(node.arg)
            elif isinstance(node, ast.Call):
                fn = ''
                if isinstance(node.func, ast.Name):
                    fn = node.func.id
                elif isinstance(node.func, ast.Attribute):
                    fn = node.func.attr
                if fn in ('chr', 'ord', 'unichr', 'fromhex', 'unhexlify'):
                    chr_ord_count += 1
                elif fn in ('__import__', 'import_module'):
                    if not self._is_safe_imp(node):
                        dynamic_imports += 1
                        dynamic_exec += 1
                elif fn == 'getattr' and len(node.args) >= 2:
                    attr_arg = node.args[1]
                    if isinstance(attr_arg, ast.Constant) and isinstance(attr_arg.value, str):
                        if attr_arg.value in ('exec', 'eval', 'compile', '__import__'):
                            dynamic_exec += 2
            elif hasattr(ast, 'Slice') and isinstance(node, ast.Slice):
                if isinstance(getattr(node, 'step', None), ast.UnaryOp) and isinstance(node.step.op, ast.USub):
                    reverse_slices += 1
                elif isinstance(getattr(node, 'step', None), ast.Constant) and node.step.value == -1:
                    reverse_slices += 1
            elif isinstance(node, ast.Lambda):
                for child in ast.walk(node.body):
                    if isinstance(child, ast.Lambda):
                        nested_lambdas += 1
            elif isinstance(node, ast.Constant):
                if self._is_known_binary_asset(node.value):
                    continue
                if isinstance(node.value, str):
                    v_s = node.value.strip()
                    if len(v_s) >= 32:
                        n_lit = len(v_s)
                        f_lit = {}
                        for ch in v_s:
                            f_lit[ch] = f_lit.get(ch, 0) + 1
                        lit_ent = sum(-(c / n_lit) * math.log2(c / n_lit) for c in f_lit.values())
                        if lit_ent >= 5.85:
                            high_entropy_literals += 1
                    if len(v_s) > 100 and self.RE_BASE64_LONG.match(v_s):
                        hex_blobs += 1
                    elif len(v_s) >= 40 and self.RE_HEX_LONG.match(v_s):
                        hex_blobs += 1
                elif isinstance(node.value, bytes):
                    if len(node.value) >= 32:
                        n_bytes = len(node.value)
                        f_bytes = {}
                        for b_val in node.value:
                            f_bytes[b_val] = f_bytes.get(b_val, 0) + 1
                        byte_ent = sum(-(c / n_bytes) * math.log2(c / n_bytes) for c in f_bytes.values())
                        if byte_ent >= 5.90:
                            high_entropy_literals += 1
                    if len(node.value) > 60:
                        hex_blobs += 1

        id_text = "".join(identifiers)
        id_entropy = 0.0
        if id_text:
            n_id = len(id_text)
            f_id = {}
            for ch in id_text:
                f_id[ch] = f_id.get(ch, 0) + 1
            id_entropy = sum(-(c / n_id) * math.log2(c / n_id) for c in f_id.values())

        lines = max(1, len([l for l in clean_text.splitlines() if l.strip()]))
        density = nodes_count / lines
        mangled_ratio = (mangled_vars / max(1, total_vars)) if total_vars > 0 else 0.0

        score = 0.0
        if mangled_ratio > 0.30:
            score += 40.0
        elif mangled_ratio > 0.15:
            score += 20.0

        if chr_ord_count >= 10:
            score += 30.0
        elif chr_ord_count >= 5:
            score += 15.0

        if high_entropy_literals >= 2:
            score += 35.0
        elif high_entropy_literals == 1:
            score += 20.0

        if dynamic_imports >= 3:
            score += 25.0
        if dynamic_exec >= 1:
            score += 25.0
        if reverse_slices >= 2:
            score += 20.0
        if hex_blobs >= 3:
            score += 30.0
        elif hex_blobs >= 1:
            score += 15.0
        if nested_lambdas >= 3:
            score += 25.0
        if density > 40.0 and lines <= 5:
            score += 35.0

        if id_entropy >= 5.0 and len(identifiers) >= 15:
            score += 25.0
        elif id_entropy >= 4.85 and len(identifiers) >= 15:
            score += 10.0

        if entropy >= 5.55:
            score += 30.0
        elif entropy >= 5.38:
            score += 15.0

        if score >= 60.0 or (entropy >= 5.50 and score >= 35.0):
            verdict = "HIGH"
        elif score >= 35.0 or (entropy >= 5.38 and (score >= 15.0 or id_entropy >= 4.85)):
            verdict = "ELEVATED"
        else:
            verdict = "NORMAL"

        return round(entropy, 4), verdict, score, high_entropy_literals

    def _hash_token(self, text: str, dim: int = 384) -> List[float]:
        vec = [0.0] * dim
        words = text.split()
        if not words:
            return vec
        for word in words:
            weight = 5.0 if any(sk.lower() in word.lower() for sk in self.SECURITY_KEYWORDS) else 1.0
            w_bytes = word.encode('utf-8')
            idx = zlib.crc32(w_bytes) % dim
            vec[idx] += weight
            if len(word) >= 3:
                for i in range(len(word) - 2):
                    gram = word[i:i+3].encode('utf-8')
                    g_idx = zlib.crc32(gram) % dim
                    vec[g_idx] += weight * 0.5
        sq_sum = sum(v * v for v in vec)
        if sq_sum > 0:
            norm = sq_sum ** 0.5
            return [v / norm for v in vec]
        return vec

    def _get_dex_bridge(self):
        with self._dex_lock:
            if getattr(self, "_cached_dex_bridge", None):
                return self._cached_dex_bridge
            if getattr(self, "is_stopped", False) or getattr(self, "is_loading", False):
                return None
            self.is_loading = True
        try:
            bridge_class = None
            dex_loader = None
            try:
                dex_bytes = zlib.decompress(base64.b64decode(self._DEX_ZLIB_BASE64))
                byte_buffer = find_class("java.nio.ByteBuffer").wrap(dex_bytes)
                parent_loader = find_class("org.telegram.messenger.ApplicationLoader").applicationContext.getClassLoader()
                dex_loader = find_class("dalvik.system.InMemoryDexClassLoader")(byte_buffer, parent_loader)
                bridge_class = dex_loader.loadClass("ni.dekma.plugin_guard.VectorScannerBridge")
            except Exception as e1:
                try:
                    cache_dir = self._get_cache_dir()
                    dex_hash = hashlib.sha256(self._DEX_ZLIB_BASE64.encode("utf-8")).hexdigest()[:12]
                    dex_path = os.path.join(cache_dir, f"vector_scanner_{dex_hash}.dex")
                    opt_dir = os.path.join(cache_dir, f"dex_opt_{dex_hash}")
                    os.makedirs(opt_dir, exist_ok=True)
                    if not os.path.exists(dex_path):
                        with open(dex_path, "wb") as f:
                            f.write(zlib.decompress(base64.b64decode(self._DEX_ZLIB_BASE64)))
                    DexClassLoader = find_class("dalvik.system.DexClassLoader")
                    parent_loader = find_class("org.telegram.messenger.ApplicationLoader").applicationContext.getClassLoader()
                    dex_loader = DexClassLoader(dex_path, opt_dir, None, parent_loader)
                    bridge_class = dex_loader.loadClass("ni.dekma.plugin_guard.VectorScannerBridge")
                except Exception as e2:
                    self.log(f"[PluginGuard DEBUG] DEX engine init failed: {e1} / {e2}")
                    return None
            with self._dex_lock:
                if getattr(self, "is_stopped", False) or bridge_class is None:
                    return None
                self._cached_dex_bridge = bridge_class
                self._cached_dex_loader = dex_loader
                return bridge_class
        finally:
            with self._dex_lock:
                self.is_loading = False

    def _invoke_dex(self, method_name: str, *args):
        bridge_class = self._get_dex_bridge()
        if bridge_class is None:
            return None
        key = (method_name, len(args))
        if not hasattr(self, "_cached_methods") or self._cached_methods is None:
            self._cached_methods = {}
        target_method = self._cached_methods.get(key)
        if target_method is None:
            try:
                for method in bridge_class.getDeclaredMethods():
                    if str(method.getName()) == method_name and len(method.getParameterTypes()) == len(args):
                        method.setAccessible(True)
                        target_method = method
                        self._cached_methods[key] = method
                        break
            except BaseException as e:
                self.log(f"[PluginGuard DEBUG] _invoke_dex lookup exception for {method_name}: {e}")
        if target_method is not None:
            try:
                return target_method.invoke(None, *args)
            except BaseException as e:
                self.log(f"[PluginGuard DEBUG] _invoke_dex exception for {method_name}: {e}")
                try:
                    find_class("java.lang.System").gc()
                except BaseException:
                    pass
        return None

    def _get_hook_bridge(self):
        if getattr(self, "_cached_hook_bridge", None):
            return self._cached_hook_bridge
        if not getattr(self, "_cached_dex_loader", None):
            self._get_dex_bridge()
        if getattr(self, "_cached_dex_loader", None):
            try:
                hb = self._cached_dex_loader.loadClass("ni.dekma.plugin_guard.PluginGuardHookBridge")
                self._cached_hook_bridge = hb
                return hb
            except Exception as e:
                self.log(f"[PluginGuard DEBUG] HookBridge load failed: {e}")
        return None

    def _ensure_dex_model_loaded(self, vec_path: str) -> bool:
        if getattr(self, "_dex_model_loaded_path", None) == vec_path:
            return True
        try:
            res = self._invoke_dex("loadModel", vec_path)
            if res:
                self._dex_model_loaded_path = vec_path
                return True
        except BaseException:
            pass
        return False

    def scan_plugin_code(self, code_str: str, depth: int = 0) -> Tuple[List[Dict[str, Any]], Dict[str, Any]]:
        t_start = time.perf_counter()
        reports = []
        orig_code_str = code_str
        try:
            tree = ast.parse(code_str)
            folder = ASTFold()
            any_folded = False
            for _ in range(8):
                folder.changed = False
                tree = folder.visit(tree)
                if folder.changed:
                    any_folded = True
                else:
                    break
            if any_folded:
                ast.fix_missing_locations(tree)
                try:
                    code_str = ast.unparse(tree)
                except Exception:
                    pass
        except SyntaxError as e:
            reports.append({
                "level": "WARNING",
                "line": getattr(e, "lineno", 0),
                "rule": "SYNTAX_ERROR",
                "detail": f"Ошибка синтаксиса Python: {e}"
            })
            stats = {
                "scanned_chunks": 0,
                "status": "SYNTAX_ERROR",
                "threshold": self.DEFAULT_VECTOR_THRESHOLD,
                "max_similarity": 0.0,
                "min_similarity": 0.0,
                "avg_similarity": 0.0,
                "vectors_count": 0,
                "threshold_diff": "+0.0000",
                "entropy": 0.0,
                "entropy_verdict": "HIGH",
                "scan_time_ms": round((time.perf_counter() - t_start) * 1000, 2)
            }
            return reports, stats

        obf_entropy, obf_verdict, obf_score, high_ent_literals = self._analyze_obfuscation(code_str, tree)
        if obf_verdict == "HIGH" and obf_score >= 50.0:
            reports.append({
                "level": "WARNING",
                "line": 0,
                "rule": "OBFUSCATED_CODE_STRUCTURE",
                "detail": "Обнаружена обфускация кода (манглинг переменных, динамические декодеры или зашифрованный payload)"
            })
        if high_ent_literals > 0:
            reports.append({
                "level": "WARNING",
                "line": 0,
                "rule": "HIGH_ENTROPY_LITERAL_DETECTED",
                "detail": f"Обнаружен зашифрованный или высокоэнтропийный строковый литерал ({high_ent_literals} шт.)"
            })


        dex_bytes, dex_line = None, 0
        try:
            dex_bytes, dex_line = self._extract_dex_bytes(tree, orig_code_str if orig_code_str else code_str)
            if not dex_bytes and code_str != orig_code_str:
                dex_bytes, dex_line = self._extract_dex_bytes(tree, code_str)

            deobf_payloads = self._extract_deobfuscated_payloads(orig_code_str if orig_code_str else code_str)
            if not deobf_payloads and code_str != orig_code_str:
                deobf_payloads = self._extract_deobfuscated_payloads(code_str)
            obf_layers_count = getattr(self, "_last_unpacked_layers_count", len(deobf_payloads) if deobf_payloads else 0)
            if obf_layers_count == 0 and deobf_payloads:
                obf_layers_count = len(deobf_payloads)
            if obf_layers_count > 0:
                rule_name = "MULTI_LAYER_OBFUSCATION_UNPACKED" if obf_layers_count > 1 else "OBFUSCATION_UNPACKED"
                detail_msg = f"Обнаружена и распакована многослойная обфускация ({_plural_code_layers(obf_layers_count)})" if obf_layers_count > 1 else f"Обнаружена и распакована обфускация ({_plural_code_layers(obf_layers_count)})"
                reports.append({
                    "level": "WARNING",
                    "line": 0,
                    "rule": rule_name,
                    "detail": detail_msg
                })
                payload_records = []
                for idx, p_item in enumerate(deobf_payloads, 1):
                    p_title = p_item[0] if isinstance(p_item, (tuple, list)) and len(p_item) > 0 else f"layer_{idx}"
                    p_code = p_item[1] if isinstance(p_item, (tuple, list)) and len(p_item) > 1 else str(p_item)
                    p_code = _beautify_code(p_code)
                    p_stage = p_item[2] if isinstance(p_item, (tuple, list)) and len(p_item) > 2 else idx
                    payload_records.append({
                        "title": str(p_title),
                        "code": str(p_code),
                        "stage": int(p_stage),
                        "threats": []
                    })
                if depth < 2 and deobf_payloads:
                    sub_stats_list = []
                    found_malware = any(sr.get("rule") == "KNOWN_MALWARE_PAYLOAD_MATCH" for p_rec in payload_records for sr in p_rec.get("threats", []))
                    for p_rec in list(payload_records):
                        if found_malware:
                            break
                        l_code = p_rec.get("code", "")
                        if '\x00' not in l_code and len(l_code.strip()) > 20:
                            sub_reports, sub_stats = self.scan_plugin_code(l_code, depth=depth + 1)
                            sub_stats_list.append(sub_stats)
                            for sr in sub_reports:
                                if sr.get("rule") != "SYNTAX_ERROR":
                                    reports.append(sr)
                                    if sr.get("rule") == "KNOWN_MALWARE_SIGNATURE_MATCH" or sr.get("level") == "CRITICAL":
                                        found_malware = True
                            nested_crits = [np for np in sub_stats.get("unpacked_payloads", []) if any(t.get("level") == "CRITICAL" for t in np.get("threats", []))]
                            if nested_crits:
                                for nested_p in nested_crits:
                                    payload_records.append({
                                        "title": f"{p_rec.get('title', 'payload')} -> {nested_p.get('title', 'layer')}",
                                        "code": nested_p.get("code", ""),
                                        "stage": len(payload_records) + 1,
                                        "threats": nested_p.get("threats", [])
                                    })
                            else:
                                for sr in sub_reports:
                                    if sr.get("rule") != "SYNTAX_ERROR":
                                        p_rec["threats"].append({
                                            "line": sr.get("line", 0),
                                            "rule": sr.get("rule", "THREAT"),
                                            "level": sr.get("level", "WARNING"),
                                            "detail": sr.get("detail", "")
                                        })
        except Exception:
            obf_layers_count = 0
            pass

        if depth == 0:
            remote_droppers = self._extract_remote_payloads(orig_code_str if orig_code_str else code_str)
            if remote_droppers:
                if 'payload_records' not in locals():
                    payload_records = []
                is_crit_drop = any(k in (orig_code_str or code_str) for k in ("reloadPlugin", "loadPlugin", "installPlugin", "exec(", "eval("))
                for r_title, r_code, r_url in remote_droppers:
                    reports.append({
                        "level": "CRITICAL" if is_crit_drop else "WARNING",
                        "line": 0,
                        "rule": "REMOTE_CODE_EXECUTION_STAGER",
                        "detail": f"Обнаружена внешняя полезная нагрузка ({r_url})"
                    })
                    r_rec = {
                        "title": r_title,
                        "code": r_code,
                        "stage": len(payload_records) + 1,
                        "threats": []
                    }
                    sub_reps, sub_st = self.scan_plugin_code(r_code, depth=depth + 1)
                    for sr in sub_reps:
                        if sr.get("rule") != "SYNTAX_ERROR":
                            sr_c = dict(sr)
                            sr_c["detail"] = f"[{r_title}] {sr_c.get('detail', '')}"
                            reports.append(sr_c)
                    r_nested_crits = [np for np in sub_st.get("unpacked_payloads", []) if any(t.get("level") == "CRITICAL" for t in np.get("threats", []))]
                    if r_nested_crits:
                        for nested_p in r_nested_crits:
                            payload_records.append({
                                "title": f"{r_title} -> {nested_p.get('title', 'layer')}",
                                "code": nested_p.get("code", ""),
                                "stage": len(payload_records) + 1,
                                "threats": nested_p.get("threats", [])
                            })
                    else:
                        r_crit_threats = [sr for sr in sub_reps if sr.get("rule") != "SYNTAX_ERROR" and sr.get("level") == "CRITICAL"]
                        if r_crit_threats:
                            r_rec["threats"] = r_crit_threats
                            payload_records.append(r_rec)

        stats = {
            "scanned_chunks": 0,
            "status": "NOT_LOADED",
            "threshold": self.DEFAULT_VECTOR_THRESHOLD,
            "max_similarity": 0.0,
            "min_similarity": 0.0,
            "avg_similarity": 0.0,
            "vectors_count": 0,
            "threshold_diff": "+0.0000",
            "entropy": obf_entropy,
            "entropy_verdict": obf_verdict,
            "obfuscation_layers": obf_layers_count,
            "scan_time_ms": 0.0
        }

        plugin_ref = self

        class CombinedASTVisitor(ast.NodeVisitor):
            def __init__(self):
                self.scope_stack = [set()]
                self.str_vars = {}
                self.str_var_lines = {}
                self.sensitive_vars = set()
                self.sensitive_stack = []
                self.chunks = []
                self.reports = []
                self.deep_base64_candidates = []
                self.dex_bytes = None
                self.dex_line = 0
                self.so_bytes_list = []
                self.seen_so_refs = set()
                self.has_clipboard_access = False
                self.has_clipboard_read = False
                has_tg_exfil = any(m in code_str for m in ("sendMessage", "sendDocument", "sendPhoto", "sendAudio", "sendMediaGroup", "sendVideo"))
                self.is_readonly_tg = ("getAvailableGifts" in code_str or "getMe" in code_str) and not has_tg_exfil
                self.has_code_exec = any(w in code_str for w in ("exec(", "eval(", "compile(", "InMemoryDexClassLoader", "loadClass", "dalvik.system"))
                self.embedded_crypto_wallets = []
                self.has_2fa_keyword = False
                self.aliases = {
                    '__import__': '__import__',
                    'getattr': 'getattr',
                    'exec': 'exec',
                    'eval': 'eval',
                    'compile': 'compile',
                    'globals': 'globals',
                    'locals': 'locals'
                }
                self.module_aliases = {
                    'builtins': 'builtins'
                }
                low_c = code_str.lower()
                self.has_tg_db_src = any(k in low_c for k in ("cache4.db", "cache4", "tgnet.dat", "userconfig.xml", "/databases/cache"))
                self.has_db_scan = False
                self.has_exfil_sink = False
                self.has_ui_viewer = False
                self.has_sql_page = False
                self.tainted_db_fns = set()
                self.tainted_exfil_fns = set()
                self.msg_exfil_hits = []
                for n_it in ast.walk(tree):
                    if isinstance(n_it, (ast.FunctionDef, ast.AsyncFunctionDef)):
                        f_low = ""
                        try:
                            f_low = ast.unparse(n_it).lower()
                        except Exception:
                            pass
                        if any(k in f_low for k in ("cache4", "getdatabasepath", "/databases/")) or (("getfilesdir" in f_low or "listdir" in f_low) and ".db" in f_low and ("cache" in f_low or "sqlite_master" in f_low)):
                            self.tainted_db_fns.add(n_it.name)
                            self.has_db_scan = True
                        if any(k in f_low for k in ("api.telegram.org/bot", "senddocument", "/stream/message", "_upload_loot", "send_to_bot", "discord.com/api/webhooks")) or (any(net in f_low for net in ("requests.post", "urlopen", "httpx.post", "aiohttp")) and any(loot in f_low for loot in ("files=", "multipart", "history_", "database_tables", "stolen", "loot", "dump", "encrypt_data"))):
                            self.tainted_exfil_fns.add(n_it.name)
                            self.has_exfil_sink = True
                    elif isinstance(n_it, ast.ClassDef):
                        if any(u_k in n_it.name.lower() for u_k in ("bottomsheet", "viewer", "dialog", "cell", "screen", "page")):
                            self.has_ui_viewer = True
                    elif isinstance(n_it, ast.Constant) and isinstance(n_it.value, str):
                        v_l = n_it.value.lower()
                        if "limit " in v_l and "offset " in v_l:
                            self.has_sql_page = True
                        if any(k in v_l for k in ("tablelayout", "tablerow", "bottomsheet")):
                            self.has_ui_viewer = True
                        if any(k in v_l for k in ("api.telegram.org/bot", "/senddocument", "/sendmessage", "discord.com/api/webhooks")):
                            self.has_exfil_sink = True
                for n_it in ast.walk(tree):
                    if isinstance(n_it, (ast.FunctionDef, ast.AsyncFunctionDef)):
                        has_m_hist = False
                        has_m_exf = False
                        has_m_ui = False
                        m_line = getattr(n_it, "lineno", 0)
                        for s_it in ast.walk(n_it):
                            if isinstance(s_it, ast.Call):
                                s_fn = s_it.func.attr if isinstance(s_it.func, ast.Attribute) else (s_it.func.id if isinstance(s_it.func, ast.Name) else "")
                                if s_fn in ("TL_messages_getHistory", "TL_messages_getDialogs", "getMessages", "loadMessages"):
                                    has_m_hist = True
                                    m_line = getattr(s_it, "lineno", m_line)
                                if s_fn in self.tainted_exfil_fns or s_fn in ("sendDocument", "send_to_bot", "_upload_loot", "_stream_message"):
                                    has_m_exf = True
                                if s_fn in ("post", "urlopen", "request"):
                                    try:
                                        c_s = ast.unparse(s_it).lower()
                                        if any(k in c_s for k in ("bot", "c2", "loot", "dump", "steal", "exfil", "webhook", "files=")):
                                            has_m_exf = True
                                    except Exception:
                                        pass
                                if s_fn in ("setText", "addView", "show", "AlertDialogBuilder", "BottomSheet", "BulletinHelper"):
                                    has_m_ui = True
                        if has_m_hist and has_m_exf and not has_m_ui:
                            self.msg_exfil_hits.append((m_line, n_it.name))

            _FN_SEC_DATA = ""
            FN_SECURITY_TABLE = {p[0]: (p[1], p[2], p[3]) for p in (l.split("\t") for l in zlib.decompress(base64.b64decode(_FN_SEC_DATA)).decode("utf-8").split("\n") if "\t" in l)}
            _STR_SEC_DATA = ""
            STR_SUBSTR_MAP = [(p[0], (p[1], p[2], p[3])) for p in (l.split("\t") for l in zlib.decompress(base64.b64decode(_STR_SEC_DATA)).decode("utf-8").split("\n") if "\t" in l)]

            def _resolve_func_name(self, func_node):
                if isinstance(func_node, ast.Name):
                    return self.aliases.get(func_node.id, func_node.id)
                if isinstance(func_node, ast.Attribute):
                    val_name = self._resolve_func_name(func_node.value)
                    return f"{val_name}.{func_node.attr}"
                return ""

            @property
            def current_net_vars(self):
                return self.scope_stack[-1]

            def _is_net_call(self, call_node):
                if not isinstance(call_node, ast.Call):
                    return False
                for child in ast.walk(call_node.func):
                    fn = ""
                    if isinstance(child, ast.Name): fn = child.id
                    elif isinstance(child, ast.Attribute): fn = child.attr
                    if fn in ('recv', 'recvfrom', 'recv_into', 'recvfrom_into', 'urlopen', 'urlretrieve'):
                        return True
                    if fn in ('get', 'post', 'request'):
                        full_fn = ""
                        try:
                            full_fn = ast.unparse(call_node.func)
                        except Exception:
                            pass
                        if any(mod in full_fn for mod in ('requests.', 'urllib.', 'http.', 'httpx.', 'aiohttp.', 'session.')):
                            return True
                for child in ast.walk(call_node):
                    if isinstance(child, ast.Call) and child is not call_node and self._is_net_call(child):
                        return True
                return False

            def _mark_net(self, target_node):
                for child in ast.walk(target_node):
                    if isinstance(child, ast.Name) and child.id not in ('self', 'cls', 'this', 'me'):
                        self.current_net_vars.add(child.id)

            def _check_flood_loop(self, node):
                has_send = False
                has_net = False
                has_slice = False
                sleep_val = None
                for child in ast.walk(node):
                    if isinstance(child, ast.Call):
                        fn = child.func.attr if isinstance(child.func, ast.Attribute) else (child.func.id if isinstance(child.func, ast.Name) else "")
                        if fn in ('send_message', 'sendMessage', 'sendText', 'sendTextMessage', 'sendSticker'):
                            has_send = True
                        elif fn in ('get', 'post', 'request', 'urlopen', 'urlretrieve', 'fetch', 'download'):
                            has_net = True
                        elif fn == 'sleep':
                            if child.args and isinstance(child.args[0], ast.Constant) and isinstance(child.args[0].value, (int, float)):
                                sleep_val = child.args[0].value
                    elif isinstance(child, ast.Subscript) and isinstance(child.slice, ast.Slice):
                        has_slice = True
                if not has_send:
                    return
                is_flood = False
                if isinstance(node, ast.While):
                    is_flood = True
                elif isinstance(node, ast.For) and not has_net:
                    if has_slice and (sleep_val is not None and sleep_val <= 0.25):
                        is_flood = True
                    elif isinstance(node.iter, ast.Call) and getattr(node.iter.func, 'id', '') == 'range':
                        is_flood = True
                if is_flood:
                    self.reports.append({
                        "level": "CRITICAL",
                        "line": getattr(node, 'lineno', 0),
                        "rule": "MESSAGE_SPAM_FLOOD_LOOP",
                        "detail": f"Обнаружен автоматический цикл массовой рассылки сообщений (интервал {sleep_val}s)"
                    })

            def visit_FunctionDef(self, node):
                self.scope_stack.append(set(self.scope_stack[-1]))
                self.sensitive_stack.append(set(self.sensitive_vars))
                for arg, default in zip(reversed(node.args.args), reversed(node.args.defaults)):
                    for child in ast.walk(default):
                        if isinstance(child, ast.Name) and child.id in self.scope_stack[-1]:
                            self.scope_stack[-1].add(arg.arg)
                        if isinstance(child, ast.Name) and child.id in self.sensitive_vars:
                            self.sensitive_vars.add(arg.arg)
                self._extract_chunk(node)
                self.generic_visit(node)
                self.scope_stack.pop()
                if self.sensitive_stack:
                    self.sensitive_vars = self.sensitive_stack.pop()

            def visit_AsyncFunctionDef(self, node):
                self.scope_stack.append(set(self.scope_stack[-1]))
                self.sensitive_stack.append(set(self.sensitive_vars))
                for arg, default in zip(reversed(node.args.args), reversed(node.args.defaults)):
                    for child in ast.walk(default):
                        if isinstance(child, ast.Name) and child.id in self.scope_stack[-1]:
                            self.scope_stack[-1].add(arg.arg)
                        if isinstance(child, ast.Name) and child.id in self.sensitive_vars:
                            self.sensitive_vars.add(arg.arg)
                self._extract_chunk(node)
                self.generic_visit(node)
                self.scope_stack.pop()
                if self.sensitive_stack:
                    self.sensitive_vars = self.sensitive_stack.pop()

            def visit_ClassDef(self, node):
                self._extract_chunk(node)
                self.generic_visit(node)

            def visit_Try(self, node):
                if len(node.body) >= 2:
                    self._extract_chunk(node, "block_try")
                self.generic_visit(node)

            def visit_For(self, node):
                if len(node.body) >= 2:
                    self._extract_chunk(node, "block_for")
                self._check_flood_loop(node)
                self.generic_visit(node)

            def visit_While(self, node):
                if len(node.body) >= 2:
                    self._extract_chunk(node, "block_while")
                self._check_flood_loop(node)
                has_sleep = False
                has_abuse = False
                abuse_type = ""
                for child in ast.walk(node):
                    if isinstance(child, ast.Call):
                        fname = child.func.attr if isinstance(child.func, ast.Attribute) else (child.func.id if isinstance(child.func, ast.Name) else "")
                        if fname == "sleep":
                            has_sleep = True
                        elif fname in ("vibrate", "play", "ringTone", "beep"):
                            has_abuse = True
                            abuse_type = fname
                if has_sleep and has_abuse:
                    self.reports.append({
                        "level": "CRITICAL",
                        "line": getattr(node, 'lineno', 0),
                        "rule": "INFINITE_HARDWARE_ABUSE_LOOP",
                        "detail": f"Обнаружен бесконечный цикл паразитной нагрузки на устройство/вибрации ({abuse_type}) в связке с time.sleep"
                    })
                self.generic_visit(node)

            def visit_Import(self, node):
                for alias in node.names:
                    if alias.name == "ctypes" or alias.name.startswith("ctypes."):
                        self.reports.append({
                            "level": "WARNING",
                            "line": getattr(node, "lineno", 0),
                            "rule": "CTYPES_NATIVE_ACCESS",
                            "detail": "Импорт модуля ctypes для вызова нативных библиотек .so. Проверить машинный код невозможно, устанавливайте на свой страх и риск!"
                        })
                self.generic_visit(node)

            def visit_ImportFrom(self, node):
                if node.module == "ctypes" or (node.module and node.module.startswith("ctypes.")):
                    self.reports.append({
                        "level": "WARNING",
                        "line": getattr(node, "lineno", 0),
                        "rule": "CTYPES_NATIVE_ACCESS",
                        "detail": "Импорт модуля ctypes для вызова нативных библиотек .so. Проверить машинный код невозможно, устанавливайте на свой страх и риск!"
                    })
                self.generic_visit(node)

            def visit_Assign(self, node):
                for target in node.targets:
                    if isinstance(target, ast.Attribute):
                        attr_name = target.attr.lower()
                        if isinstance(node.value, ast.Constant) and isinstance(node.value.value, str):
                            c_val = node.value.value.strip()
                            if attr_name in ["first_name", "last_name"]:
                                if c_val.lower() in ["telegram", "telegram notifications", "telegram service notifications", "telegram support"]:
                                    self.reports.append({
                                        "level": "CRITICAL",
                                        "line": getattr(node, 'lineno', 0),
                                        "rule": "OFFICIAL_SERVICE_IMPERSONATION",
                                        "detail": f"Попытка маскировки аккаунта под официальный сервис Telegram (first_name='{c_val}')"
                                    })
                            elif attr_name in ["about", "bio"]:
                                if "+42777" in c_val or c_val == "42777":
                                    self.reports.append({
                                        "level": "CRITICAL",
                                        "line": getattr(node, 'lineno', 0),
                                        "rule": "OFFICIAL_SERVICE_IMPERSONATION",
                                        "detail": f"Попытка установки официального сервисного номера Telegram в описание профиля (about='{c_val}')"
                                    })
                            elif attr_name == "username":
                                if c_val == "":
                                    self.reports.append({
                                        "level": "CRITICAL",
                                        "line": getattr(node, 'lineno', 0),
                                        "rule": "USERNAME_FORCED_WIPE",
                                        "detail": "Попытка принудительного удаления юзернейма пользователя (username='') для его перехвата или маскировки"
                                    })

                is_sensitive = False
                for val_child in ast.walk(node.value):
                    if isinstance(val_child, ast.Attribute):
                        if any(s.lower() in val_child.attr.lower() for s in ('auth_key', 'authkey', 'getclientphone', 'getuserconfig', 'messagesstorage')):
                            is_sensitive = True
                    elif isinstance(val_child, ast.Name):
                        if val_child.id in self.sensitive_vars:
                            is_sensitive = True

                if is_sensitive:
                    for target in node.targets:
                        if isinstance(target, ast.Name):
                            self.sensitive_vars.add(target.id)

                is_net = False
                for val_child in ast.walk(node.value):
                    if isinstance(val_child, ast.Call) and self._is_net_call(val_child):
                        is_net = True
                    elif isinstance(val_child, ast.Name) and val_child.id in self.current_net_vars:
                        is_net = True

                if is_net:
                    for target in node.targets:
                        self._mark_net(target)
                else:
                    for target in node.targets:
                        for child in ast.walk(target):
                            if isinstance(child, ast.Name) and child.id in self.current_net_vars:
                                self.current_net_vars.remove(child.id)

                if len(node.targets) == 1 and isinstance(node.targets[0], ast.Name):
                    var_name = node.targets[0].id
                    line_no = getattr(node, 'lineno', 0)
                    self.str_var_lines[var_name] = line_no
                    if isinstance(node.value, ast.Name):
                        res_id = self.aliases.get(node.value.id, node.value.id)
                        if res_id in ('__import__', 'getattr', 'exec', 'eval', 'compile', 'globals', 'locals'):
                            self.aliases[var_name] = res_id
                            if res_id == '__import__':
                                self.reports.append({
                                    "level": "WARNING",
                                    "line": line_no,
                                    "rule": "DYNAMIC_CODE_EXECUTION",
                                    "detail": "Динамический вызов __import__"
                                })
                    elif isinstance(node.value, ast.Call):
                        f_res = self._resolve_func_name(node.value.func)
                        if f_res == '__import__' and len(node.value.args) >= 1:
                            if isinstance(node.value.args[0], ast.Constant) and isinstance(node.value.args[0].value, str):
                                mod_n = node.value.args[0].value
                                self.module_aliases[var_name] = mod_n
                                if mod_n == 'builtins':
                                    self.aliases[var_name] = 'builtins'
                        elif f_res == 'getattr' and len(node.value.args) >= 2:
                            t_obj = self._resolve_func_name(node.value.args[0])
                            a_arg = node.value.args[1]
                            a_name = a_arg.value if (isinstance(a_arg, ast.Constant) and isinstance(a_arg.value, str)) else ''
                            if a_name:
                                if t_obj in ('builtins', '__builtins__') or self.module_aliases.get(t_obj) == 'builtins':
                                    if a_name in ('exec', 'eval', 'compile', '__import__'):
                                        self.aliases[var_name] = a_name
                                        self.reports.append({
                                            "level": "CRITICAL",
                                            "line": line_no,
                                            "rule": "INDIRECT_DYNAMIC_EXECUTION",
                                            "detail": f"Косвенное извлечение интерпретатора ({a_name}) через getattr"
                                        })
                                    elif a_name:
                                        self.aliases[var_name] = a_name
                    if isinstance(node.value, ast.Constant) and isinstance(node.value.value, str):
                        val_str = node.value.value.strip()
                        self.str_vars[var_name] = node.value.value
                        if "t.me/setlanguage/" in val_str.lower():
                            self.reports.append({
                                "level": "CRITICAL",
                                "line": line_no,
                                "rule": "MALICIOUS_LANG_PACK_INSTALL",
                                "detail": f"Обнаружена ссылка на принудительную установку стороннего языкового пакета ({val_str})"
                            })
                        if any(kw in var_name.upper() for kw in ["DEX", "SO", "LIB", "ELF", "PAYLOAD"]) or val_str.startswith("ZGV4") or val_str.startswith("f0VMRg") or len(val_str) > 100:
                            try:
                                raw = base64.b64decode(val_str)
                                if len(raw) >= 112 and (raw.startswith(bytes.fromhex("6465780a")) or raw.startswith(b"cdex")):
                                    self.dex_bytes = raw
                                    self.dex_line = line_no
                                elif raw.startswith(bytes.fromhex("7f454c46")):
                                    self.so_bytes_list.append((raw, line_no))
                                else:
                                    try:
                                        decomp = zlib.decompress(raw)
                                        if len(decomp) >= 112 and (decomp.startswith(bytes.fromhex("6465780a")) or decomp.startswith(b"cdex")):
                                            self.dex_bytes = decomp
                                            self.dex_line = line_no
                                        elif decomp.startswith(bytes.fromhex("7f454c46")):
                                            self.so_bytes_list.append((decomp, line_no))
                                    except Exception:
                                        pass
                            except Exception:
                                pass
                    elif isinstance(node.value, ast.Constant) and isinstance(node.value.value, bytes):
                        val_b = node.value.value
                        if len(val_b) >= 112 and (val_b.startswith(bytes.fromhex("6465780a")) or val_b.startswith(b"cdex")):
                            self.dex_bytes = val_b
                            self.dex_line = line_no
                        elif val_b.startswith(bytes.fromhex("7f454c46")):
                            self.so_bytes_list.append((val_b, line_no))
                    elif isinstance(node.value, ast.BinOp):
                        def _get_binop_str(n):
                            if isinstance(n, ast.Constant) and isinstance(n.value, str):
                                return n.value
                            elif isinstance(n, ast.Name) and n.id in self.str_vars:
                                return self.str_vars[n.id]
                            elif isinstance(n, ast.BinOp) and isinstance(n.op, ast.Add):
                                l = _get_binop_str(n.left)
                                r = _get_binop_str(n.right)
                                if l is not None and r is not None:
                                    return l + r
                            return None
                        full_s = _get_binop_str(node.value)
                        if full_s:
                            self.str_vars[var_name] = full_s
                    elif isinstance(node.value, ast.Call):
                        for child in ast.walk(node.value):
                            if isinstance(child, ast.List):
                                parts = []
                                for elt in child.elts:
                                    if isinstance(elt, ast.Name) and elt.id in self.str_vars:
                                        parts.append(self.str_vars[elt.id])
                                    elif isinstance(elt, ast.Constant) and isinstance(elt.value, str):
                                        parts.append(elt.value)
                                if parts:
                                    self.str_vars[var_name] = "".join(parts)

                self.generic_visit(node)

            def visit_AugAssign(self, node):
                is_net = False
                for val_child in ast.walk(node.value):
                    if isinstance(val_child, ast.Name) and val_child.id in self.current_net_vars:
                        is_net = True
                    elif isinstance(val_child, ast.Call) and self._is_net_call(val_child):
                        is_net = True
                if is_net:
                    self._mark_net(node.target)
                self.generic_visit(node)

            def visit_Call(self, node):
                fn_resolved = self._resolve_func_name(node.func)
                if fn_resolved in ["exec", "eval"] and len(node.args) >= 1:
                    code_arg = node.args[0]
                    is_net_exec = False
                    exec_source = ""
                    for child in ast.walk(code_arg):
                        if isinstance(child, ast.Name) and child.id in self.current_net_vars:
                            is_net_exec = True
                            exec_source = child.id
                        elif isinstance(child, ast.Call) and self._is_net_call(child):
                            is_net_exec = True
                            exec_source = "network_stream"
                    if is_net_exec:
                        self.reports.append({
                            "level": "CRITICAL",
                            "line": getattr(node, 'lineno', 0),
                            "rule": "REMOTE_CODE_EXECUTION_STAGER",
                            "detail": f"Динамическое исполнение удаленного кода, полученного из сети ({exec_source} -> {fn_resolved})"
                        })
                    else:
                        self.reports.append({
                            "level": "WARNING",
                            "line": getattr(node, 'lineno', 0),
                            "rule": "DYNAMIC_CODE_EXECUTION",
                            "detail": f"Динамическое исполнение кода через {fn_resolved}"
                        })
                elif fn_resolved == "compile":
                    self.reports.append({
                        "level": "WARNING",
                        "line": getattr(node, 'lineno', 0),
                        "rule": "DYNAMIC_CODE_COMPILATION",
                        "detail": "Динамическая компиляция кода через compile()"
                    })
                elif fn_resolved == "__import__":
                    if not plugin_ref._is_safe_imp(node):
                        self.reports.append({
                            "level": "WARNING",
                            "line": getattr(node, 'lineno', 0),
                            "rule": "DYNAMIC_CODE_EXECUTION",
                            "detail": "Динамический вызов __import__"
                        })
                elif fn_resolved == "getattr" and len(node.args) >= 2:
                    a_arg = node.args[1]
                    a_name = a_arg.value if (isinstance(a_arg, ast.Constant) and isinstance(a_arg.value, str)) else ''
                    if a_name in ('exec', 'eval', 'compile', '__import__'):
                        self.reports.append({
                            "level": "CRITICAL",
                            "line": getattr(node, 'lineno', 0),
                            "rule": "INDIRECT_DYNAMIC_EXECUTION",
                            "detail": f"Косвенное извлечение интерпретатора ({a_name}) через getattr"
                        })

                func_names = []
                curr_f = node.func
                while isinstance(curr_f, ast.Attribute):
                    if curr_f.attr:
                        func_names.append(curr_f.attr)
                    curr_f = curr_f.value
                if isinstance(curr_f, ast.Name) and curr_f.id:
                    func_names.append(curr_f.id)
                elif not func_names and isinstance(curr_f, ast.AST):
                    for fc in ast.iter_child_nodes(curr_f):
                        if isinstance(fc, ast.Name):
                            func_names.append(fc.id)
                        elif isinstance(fc, ast.Attribute):
                            func_names.append(fc.attr)

                for fn_name in func_names:

                    if any(pattern in fn_name for pattern in ["CDLL", "cdll", "PyDLL", "WinDLL", "loadLibrary", "dlopen"]):
                        self.reports.append({
                            "level": "WARNING",
                            "line": getattr(node, 'lineno', 0),
                            "rule": "DYNAMIC_NATIVE_LIBRARY_LOAD",
                            "detail": f"Динамическая загрузка нативной библиотеки .so ({fn_name}). Бинарный код закрыт от полной проверки, устанавливайте на свой страх и риск!"
                        })

                    is_proc_exec = (fn_name in ["Popen", "check_output", "system", "spawn"] or any(s in func_names for s in ["subprocess", "os"]) or (fn_name == "call" and any(s in func_names for s in ["subprocess", "os"])))
                    if is_proc_exec:
                        arg_consts = [child.value.lower() for arg in node.args for child in ast.walk(arg) if isinstance(child, ast.Constant) and isinstance(child.value, str)]
                        is_benign_probe = any(probe in " ".join(arg_consts) for probe in ["echo test", "which su", "su -v", "su --version", "echo 1"])
                        if not is_benign_probe:
                            for val_low in arg_consts:
                                if any(cmd in val_low for cmd in ["su -c", "/system/bin/su", "/system/xbin/su", "/bin/sh", "/system/bin/sh", "chmod +x", "iptables -", "setenforce"]) or re.search(r'\b(su|chmod|iptables|reboot)\b', val_low):
                                    self.reports.append({
                                        "level": "CRITICAL",
                                        "line": getattr(node, 'lineno', 0),
                                        "rule": "PRIVILEGED_COMMAND_EXECUTION",
                                        "detail": f"Попытка выполнения системной команды повышенных привилегий ({val_low})"
                                    })
                                    break

                    if any(term.lower() == fn_name.lower() for term in plugin_ref.TERMINATION_CALLS):
                        is_hostile = False
                        if fn_name == "killProcess" or fn_name == "kill":
                            if len(node.args) >= 1:
                                arg = node.args[0]
                                if isinstance(arg, ast.BinOp) or isinstance(arg, ast.Constant):
                                    is_hostile = True
                                elif isinstance(arg, ast.Name):
                                    is_hostile = True
                        if is_hostile:
                            self.reports.append({
                                "level": "CRITICAL",
                                "line": getattr(node, 'lineno', 0),
                                "rule": "HOSTILE_PROCESS_TERMINATION",
                                "detail": f"Попытка принудительного уничтожения сторонних процессов ОС ({fn_name})"
                            })
                        else:
                            self.reports.append({
                                "level": "WARNING",
                                "line": getattr(node, 'lineno', 0),
                                "rule": "PROCESS_TERMINATION_CALL",
                                "detail": f"Обнаружен вызов завершения процесса/активности ({fn_name})"
                            })

                    if fn_name in self.FN_SECURITY_TABLE:
                        sec_level, sec_rule, sec_desc = self.FN_SECURITY_TABLE[fn_name]
                        self.reports.append({
                            "level": sec_level,
                            "line": getattr(node, 'lineno', 0),
                            "rule": sec_rule,
                            "detail": f"{sec_desc} ({fn_name})"
                        })
                    elif fn_name in ["getClientUserId", "getCurrentUser"]:
                        self.sensitive_vars.add("user")
                        self.sensitive_vars.add("uid")
                        self.sensitive_vars.add("client_user_id")

                    if fn_name in ["find_class", "forName", "loadClass", "jclass"] and node.args:
                        for arg in node.args:
                            if isinstance(arg, ast.Constant) and isinstance(arg.value, str):
                                if any(dex_cls in arg.value for dex_cls in ["InMemoryDexClassLoader", "DexClassLoader", "PathClassLoader"]):
                                    self.reports.append({
                                        "level": "WARNING",
                                        "line": getattr(node, 'lineno', 0),
                                        "rule": "DYNAMIC_IN_MEMORY_DEX_LOADER",
                                        "detail": f"Динамическая загрузка исполняемого DEX-байткода в память через {arg.value}. Содержимое проверяется анализатором DEX."
                                    })
                                elif any(cb in arg.value.lower() for cb in ["clipboardmanager", "clipboardservice"]):
                                    self.has_clipboard_access = True

                    if fn_name == "open" and node.args:
                        arg0 = node.args[0]
                        if (isinstance(arg0, ast.Name) and arg0.id == "__file__") or (isinstance(arg0, ast.Constant) and isinstance(arg0.value, str) and "__file__" in arg0.value):
                            self.reports.append({
                                "level": "WARNING",
                                "line": getattr(node, 'lineno', 0),
                                "rule": "SELF_CODE_PAYLOAD_EXTRACTION",
                                "detail": "Плагин считывает собственный исходный код (__file__) для извлечения полезной нагрузки"
                            })

                    if fn_name in ["getPrimaryClip", "addPrimaryClipChangedListener", "hasPrimaryClip"]:
                        self.has_clipboard_read = True
                        self.has_clipboard_access = True
                    elif fn_name in ["setPrimaryClip", "newPlainText", "newHtmlText"]:
                        self.has_clipboard_access = True

                    if fn_name == "getSystemService" and node.args:
                        for arg in node.args:
                            if isinstance(arg, ast.Constant) and isinstance(arg.value, str):
                                if "clipboard" in arg.value.lower():
                                    self.has_clipboard_access = True

                    if fn_name in ["connect", "execute", "executemany", "cursor"]:
                        for arg in node.args:
                            for child in ast.walk(arg):
                                if isinstance(child, ast.Constant) and isinstance(child.value, str):
                                    c_low = child.value.lower()
                                    is_strict_tg = any(tbl in c_low for tbl in plugin_ref.TG_SQL_STRICT)
                                    is_ctx_tg = any(tbl in c_low for tbl in plugin_ref.TG_SQL_CTX)
                                    if "pragma table_info" in c_low and any(tg_tbl in c_low for tg_tbl in ["messages", "users", "chats", "dialogs", "enc_chats", "params"]):
                                        is_strict_tg = True
                                    has_mal_db_intent = (
                                        self.has_tg_db_src or
                                        self.has_db_scan or
                                        bool(self.tainted_db_fns) or
                                        (self.has_exfil_sink and not (self.has_ui_viewer and self.has_sql_page))
                                    )
                                    if is_strict_tg or (is_ctx_tg and has_mal_db_intent):
                                        self.reports.append({
                                            "level": "CRITICAL",
                                            "line": getattr(node, 'lineno', 0),
                                            "rule": "TELEGRAM_DATABASE_EXFILTRATION",
                                            "detail": f"Прямой опрос системной базы данных Telegram через SQLite ({child.value[:60]})"
                                        })

                    if fn_name in ["setBoolean", "setAccessible", "getDeclaredField", "getField"]:
                        for arg in node.args:
                            for child in ast.walk(arg):
                                if isinstance(child, ast.Constant) and isinstance(child.value, str) and child.value == "trusted":
                                    self.reports.append({
                                        "level": "CRITICAL",
                                        "line": getattr(node, 'lineno', 0),
                                        "rule": "TRUSTED_FLAG_FORGERY",
                                        "detail": "Попытка принудительной подделки флага доверенного плагина (trusted=True)"
                                    })

                    if fn_name == "setStreamVolume" or (fn_name == "getDeclaredMethod" and any(isinstance(a, ast.Constant) and a.value == "setStreamVolume" for a in node.args)):
                        has_max = any("max" in str(getattr(a, "id", "")).lower() or "maxvolume" in str(getattr(getattr(a, "func", None), "attr", "")).lower() or (isinstance(a, ast.Constant) and isinstance(a.value, int) and a.value >= 15) for a in node.args)
                        if has_max or "getStreamMaxVolume" in code_str or "VolumeHook" in code_str:
                            self.reports.append({
                                "level": "CRITICAL",
                                "line": getattr(node, 'lineno', 0),
                                "rule": "FORCED_HARDWARE_OVERRIDE_ON_BOOT",
                                "detail": "Попытка принудительного выкручивания системной громкости медиа на максимум (setStreamVolume -> getStreamMaxVolume)"
                            })

                    if fn_name in ["updateProfile", "TL_account_updateProfile", "updateUsername", "TL_account_updateUsername"]:
                        is_crit = (depth > 0)
                        self.reports.append({
                            "level": "CRITICAL" if is_crit else "WARNING",
                            "line": getattr(node, 'lineno', 0),
                            "rule": "ACCOUNT_PROFILE_MODIFICATION",
                            "detail": f"Модификация профиля/имени пользователя Telegram из обфусцированного слоя ({fn_name})" if is_crit else f"Обнаружен вызов изменения профиля/имени пользователя Telegram ({fn_name})"
                        })
                        for kw in getattr(node, 'keywords', []):
                            if isinstance(kw.value, ast.Constant) and isinstance(kw.value.value, str):
                                kw_val = kw.value.value.strip()
                                if kw.arg in ["first_name", "last_name"] and kw_val.lower() in ["telegram", "telegram notifications", "telegram service notifications", "telegram support"]:
                                    self.reports.append({
                                        "level": "CRITICAL",
                                        "line": getattr(node, 'lineno', 0),
                                        "rule": "OFFICIAL_SERVICE_IMPERSONATION",
                                        "detail": f"Попытка маскировки аккаунта под официальный сервис Telegram (first_name='{kw_val}')"
                                    })
                                elif kw.arg in ["about", "bio"] and ("+42777" in kw_val or kw_val == "42777"):
                                    self.reports.append({
                                        "level": "CRITICAL",
                                        "line": getattr(node, 'lineno', 0),
                                        "rule": "OFFICIAL_SERVICE_IMPERSONATION",
                                        "detail": f"Попытка установки официального сервисного номера Telegram в описание профиля (about='{kw_val}')"
                                    })
                                elif kw.arg == "username" and kw_val == "":
                                    self.reports.append({
                                        "level": "CRITICAL",
                                        "line": getattr(node, 'lineno', 0),
                                        "rule": "USERNAME_FORCED_WIPE",
                                        "detail": "Попытка принудительного удаления юзернейма пользователя (username='') для его перехвата или маскировки"
                                    })
                        if fn_name in ["updateUsername", "TL_account_updateUsername"] and node.args:
                            if isinstance(node.args[0], ast.Constant) and isinstance(node.args[0].value, str) and node.args[0].value.strip() == "":
                                self.reports.append({
                                    "level": "CRITICAL",
                                    "line": getattr(node, 'lineno', 0),
                                    "rule": "USERNAME_FORCED_WIPE",
                                    "detail": "Попытка принудительного удаления юзернейма пользователя (username='') для его перехвата или маскировки"
                                })

                    if fn_name in ["send_text", "send_message"]:
                        for arg in node.args:
                            for child in ast.walk(arg):
                                if isinstance(child, ast.Name) and child.id in self.sensitive_vars:
                                    self.reports.append({
                                        "level": "CRITICAL",
                                        "line": getattr(node, 'lineno', 0),
                                        "rule": "PHONE_LEAK_IN_SEND_MESSAGE",
                                        "detail": "Обнаружена отправка конфиденциальных данных пользователя (auth_key/сессия) в чат"
                                    })

                    if fn_name in ["settrace", "setprofile", "gettrace", "getprofile"]:
                        self.reports.append({
                            "level": "CRITICAL",
                            "line": getattr(node, 'lineno', 0),
                            "rule": "ANTI_DEBUG_TAMPER",
                            "detail": f"Попытка вмешательства в отладчик/трассировщик Python ({fn_name})"
                        })

                if isinstance(node.func, ast.Attribute) and node.func.attr == "STREAM_ALARM":
                    self.reports.append({
                        "level": "CRITICAL",
                        "line": getattr(node, 'lineno', 0),
                        "rule": "FORCE_MAX_VOLUME_AUDIO_EXPLOIT",
                        "detail": "Обход настроек громкости через принудительный канал STREAM_ALARM"
                    })

                is_net_sink = False
                excluded_methods = ('loaddatawithbaseurl', 'loaddata', 'loadurl', 'setonclicklistener', 'addview')
                for fn_str in func_names:
                    fn = fn_str.lower()
                    if fn not in excluded_methods:
                        if any(n.lower() == fn or (len(n) >= 5 and n.lower() in fn) for n in plugin_ref.NETWORK_SINKS):
                            is_net_sink = True
                            break

                if is_net_sink:
                    uses_sensitive = False
                    for arg in node.args:
                        for child in ast.walk(arg):
                            if isinstance(child, ast.Name) and child.id in self.sensitive_vars:
                                uses_sensitive = True
                    for kw in getattr(node, 'keywords', []):
                        for child in ast.walk(kw.value):
                            if isinstance(child, ast.Name) and child.id in self.sensitive_vars:
                                uses_sensitive = True

                    if uses_sensitive:
                        self.reports.append({
                            "level": "CRITICAL",
                            "line": getattr(node, 'lineno', 0),
                            "rule": "UNAUTHORIZED_DATA_EXFILTRATION",
                            "detail": "Обнаружен подтвержденный поток данных из Telegram в сетевой запрос"
                        })
                self.generic_visit(node)

            def visit_Attribute(self, node):
                if node.attr in ["getPrimaryClip", "addPrimaryClipChangedListener", "hasPrimaryClip"]:
                    self.has_clipboard_read = True
                if node.attr == "f_builtins":
                    self.reports.append({
                        "level": "CRITICAL",
                        "line": getattr(node, 'lineno', 0),
                        "rule": "FRAME_ENVIRONMENT_THEFT",
                        "detail": f"Прямой доступ к окружению стека через {node.attr} (кража глобальных переменных/контекста)"
                    })
                self.generic_visit(node)

            def visit_Subscript(self, node):
                if isinstance(node.value, ast.Attribute) and node.value.attr == "modules":
                    key_val = None
                    if isinstance(node.slice, ast.Constant) and isinstance(node.slice.value, str):
                        key_val = node.slice.value
                    elif hasattr(ast, "Index") and isinstance(node.slice, getattr(ast, "Index")) and isinstance(node.slice.value, ast.Constant):
                        key_val = node.slice.value.value
                    if key_val and any(target in key_val.lower() for target in ["pluginguard", "plugin_guard", "security"]):
                        self.reports.append({
                            "level": "CRITICAL",
                            "line": getattr(node, 'lineno', 0),
                            "rule": "ANTI_ANALYSIS_GUARD_KILL",
                            "detail": f"Попытка обнаружения или выгрузки модуля защиты из sys.modules ({key_val})"
                        })
                self.generic_visit(node)

            def visit_Name(self, node):
                if node.id in plugin_ref.DYNAMIC_EXEC_NAMES:
                    self.reports.append({
                        "level": "WARNING",
                        "line": getattr(node, 'lineno', 0),
                        "rule": "DYNAMIC_CODE_EXECUTION",
                        "detail": f"Динамический вызов {node.id}"
                    })
                self.generic_visit(node)

            def visit_BinOp(self, node):
                if isinstance(node.op, ast.Add):
                    def _resolve_simple_binop_str(n):
                        if isinstance(n, ast.Constant) and isinstance(n.value, str):
                            return n.value
                        if isinstance(n, ast.BinOp) and isinstance(n.op, ast.Add):
                            l = _resolve_simple_binop_str(n.left)
                            r = _resolve_simple_binop_str(n.right)
                            if l and r: return l + r
                        return ""
                    full_add = _resolve_simple_binop_str(node)
                    if full_add:
                        if not self.is_readonly_tg and "api.telegram.org" in full_add.lower():
                            self.reports.append({
                                "level": "CRITICAL",
                                "line": getattr(node, 'lineno', 0),
                                "rule": "C2_TELEGRAM_BOT_API",
                                "detail": f"Обнаружен составной C2-канал Telegram Bot API ({full_add[:60]})"
                            })
                        if any(db_f in full_add.lower() for db_f in ["cache4.db", "userconfig.xml", "tgnet.dat", "passcode.xml"]):
                            self.reports.append({
                                "level": "CRITICAL",
                                "line": getattr(node, 'lineno', 0),
                                "rule": "TELEGRAM_INTERNAL_STORAGE_THEFT",
                                "detail": f"Составной путь к системной базе/файлам авторизации Telegram ({full_add})"
                            })
                self.generic_visit(node)

            def visit_Compare(self, node):
                for comp in [node.left] + getattr(node, 'comparators', []):
                    if isinstance(comp, ast.Constant):
                        if comp.value == 777000 or comp.value == "777000":
                            self.reports.append({
                                "level": "CRITICAL",
                                "line": getattr(node, 'lineno', 0),
                                "rule": "SERVICE_2FA_CODE_INTERCEPTION",
                                "detail": "Обнаружено условное сравнение с ID сервисного чата Telegram (777000) для фильтрации кодов входа"
                            })
                self.generic_visit(node)

            def visit_Constant(self, node):
                if isinstance(node.value, int) and node.value == 777000:
                    self.reports.append({
                        "level": "CRITICAL",
                        "line": getattr(node, 'lineno', 0),
                        "rule": "SERVICE_2FA_CODE_INTERCEPTION",
                        "detail": "Обнаружена фильтрация сервисного ID Telegram (777000) для перехвата кодов авторизации и 2FA"
                    })
                if isinstance(node.value, str):
                    val = node.value.strip()
                    if val == "777000" or "telegram notifications" in val.lower():
                        self.reports.append({
                            "level": "CRITICAL",
                            "line": getattr(node, 'lineno', 0),
                            "rule": "SERVICE_2FA_CODE_INTERCEPTION",
                            "detail": "Обнаружено обращение к сервисному чату авторизации Telegram (777000 / Telegram Notifications)"
                        })
                    if plugin_ref.RE_2FA_CODE_KEYWORD.search(val):
                        self.has_2fa_keyword = True
                    if len(val) <= 120 and not (len(val) >= 64 and plugin_ref.RE_BASE64_STRICT.match(val)):
                        for w_re in [plugin_ref.RE_WALLET_BTC, plugin_ref.RE_WALLET_ETH, plugin_ref.RE_WALLET_TON, plugin_ref.RE_WALLET_TRX]:
                            w_m = w_re.search(val)
                            if w_m:
                                self.embedded_crypto_wallets.append((w_m.group(0), getattr(node, 'lineno', 0)))
                                break
                    if any(cb_name in val.lower() for cb_name in ["clipboardmanager", "clipboardservice", "pyperclip"]):
                        self.has_clipboard_access = True
                    if len(val) >= 32 and ' ' not in val and plugin_ref.RE_BASE64_STRICT.match(val) and depth < 3:
                        self.deep_base64_candidates.append((val, getattr(node, 'lineno', 0)))
                    
                    if not self.is_readonly_tg and plugin_ref.RE_BOT_TOKEN.search(val):
                        self.reports.append({
                            "level": "CRITICAL",
                            "line": getattr(node, 'lineno', 0),
                            "rule": "EMBEDDED_TELEGRAM_BOT_TOKEN",
                            "detail": "Обнаружен внедренный токен Telegram Bot API для C2/стиллера"
                        })

                    if plugin_ref.RE_SO_LIB.search(val) and not val.startswith("http"):
                        so_m = plugin_ref.RE_SO_LIB.search(val)
                        so_name = so_m.group(1) if so_m else val
                        if so_name not in self.seen_so_refs:
                            self.seen_so_refs.add(so_name)
                            self.reports.append({
                                "level": "WARNING",
                                "line": getattr(node, 'lineno', 0),
                                "rule": "NATIVE_SO_FILE_REFERENCE",
                                "detail": f"Обращение к нативной библиотеке ({so_name}). Бинарный код невозможно полностью проверить, устанавливайте на свой страх и риск!"
                            })

                    val_low = val.lower()
                    for sub, (lvl, r_name, det_tmpl) in self.STR_SUBSTR_MAP:
                        if sub in val_low and not (sub == "api.telegram.org" and self.is_readonly_tg):
                            self.reports.append({
                                "level": lvl,
                                "line": getattr(node, 'lineno', 0),
                                "rule": r_name,
                                "detail": det_tmpl.replace("{val[:60]}", val[:60])
                            })
                    if any(db_f in val_low for db_f in ("cache4.db", "userconfig.xml", "tgnet.dat", "passcode.xml", "file_to_path.db")):
                        self.reports.append({
                            "level": "CRITICAL",
                            "line": getattr(node, 'lineno', 0),
                            "rule": "TELEGRAM_INTERNAL_STORAGE_THEFT",
                            "detail": f"Прямой доступ к системной базе/файлам авторизации Telegram ({val})"
                        })
                    if any(p in val_low for p in ("/dcim/camera", "/pictures/screenshots", "/storage/emulated/0/dcim/camera", "/storage/emulated/0/dcim", "/dcim/100media")):
                        self.reports.append({
                            "level": "CRITICAL",
                            "line": getattr(node, 'lineno', 0),
                            "rule": "LOCAL_GALLERY_EXFILTRATION",
                            "detail": f"Попытка сбора личных фотографий и снимков экрана пользователя ({val})"
                        })
                    if any(su_p in val_low for su_p in ("su -c", "/system/bin/su", "/system/xbin/su", "/system/bin/sh")):
                        self.reports.append({
                            "level": "CRITICAL",
                            "line": getattr(node, 'lineno', 0),
                            "rule": "PRIVILEGED_COMMAND_EXECUTION",
                            "detail": f"Обнаружена попытка выполнения root/системных команд ({val})"
                        })
                    if any(ip_svc in val_low for ip_svc in ("api.ipdetective.io", "getclicky.com", "iplogger.org", "iplogger.com", "iplogger.ru")):
                        self.reports.append({
                            "level": "CRITICAL",
                            "line": getattr(node, 'lineno', 0),
                            "rule": "IP_LOGGER_TRACKER_EXFILTRATION",
                            "detail": f"Обнаружен сбор и эксфильтрация IP-адреса устройства ({val[:60]})"
                        })
                    elif any(ip_svc in val_low for ip_svc in ("api.ipify.org", "ip-api.com", "2ip.ru")):
                        self.reports.append({
                            "level": "WARNING",
                            "line": getattr(node, 'lineno', 0),
                            "rule": "EXTERNAL_IP_QUERY_SERVICE",
                            "detail": f"Обращение к внешнему сервису геопозиции/IP ({val[:60]})"
                        })
                    m_ip = plugin_ref.RE_IPV4_C2.search(val)
                    if m_ip and not val.startswith("http://127.0.0.1") and not val.startswith("http://localhost"):
                        self.reports.append({
                            "level": "CRITICAL",
                            "line": getattr(node, 'lineno', 0),
                            "rule": "RAW_IP_C2_ENDPOINT",
                            "detail": f"Прямое обращение к C2-серверу по IPv4-адресу ({m_ip.group(0)})"
                        })
                elif isinstance(node.value, bytes):
                    if node.value.startswith(bytes.fromhex("7f454c46")):
                        self.so_bytes_list.append((node.value, getattr(node, 'lineno', 0)))
                self.generic_visit(node)

            def visit_JoinedStr(self, node):
                parts = []
                for val in getattr(node, 'values', []):
                    if isinstance(val, ast.Constant) and isinstance(val.value, str):
                        parts.append(val.value)
                    elif isinstance(val, ast.FormattedValue) and isinstance(getattr(val, 'value', None), ast.Constant) and isinstance(val.value.value, str):
                        parts.append(val.value.value)
                full_s = "".join(parts)
                low_s = full_s.lower()
                if any(ip_svc in low_s for ip_svc in ["api.ipdetective.io", "getclicky.com", "iplogger.org", "iplogger.com", "iplogger.ru"]):
                    self.reports.append({
                        "level": "CRITICAL",
                        "line": getattr(node, 'lineno', 0),
                        "rule": "IP_LOGGER_TRACKER_EXFILTRATION",
                        "detail": f"Составной URL сервиса сбора IP-адресов ({full_s[:60]})"
                    })
                elif any(ip_svc in low_s for ip_svc in ["api.ipify.org", "ip-api.com", "2ip.ru"]):
                    self.reports.append({
                        "level": "WARNING",
                        "line": getattr(node, 'lineno', 0),
                        "rule": "EXTERNAL_IP_QUERY_SERVICE",
                        "detail": f"Составной URL сервиса геопозиции/IP ({full_s[:60]})"
                    })
                if "castleteam" in low_s:
                    self.reports.append({
                        "level": "CRITICAL",
                        "line": getattr(node, 'lineno', 0),
                        "rule": "KNOWN_RAT_C2_ENDPOINT",
                        "detail": "Обнаружено прямое обращение к известному вредоносному C2-серверу RAT (CastleTeam)"
                    })
                if not self.is_readonly_tg and "api.telegram.org" in low_s:
                    self.reports.append({
                        "level": "CRITICAL",
                        "line": getattr(node, 'lineno', 0),
                        "rule": "C2_TELEGRAM_BOT_API",
                        "detail": f"Обнаружен C2-канал Telegram Bot API ({full_s[:60]})"
                    })
                if any(db_f in low_s for db_f in ["cache4.db", "userconfig.xml", "tgnet.dat", "passcode.xml"]):
                    self.reports.append({
                        "level": "CRITICAL",
                        "line": getattr(node, 'lineno', 0),
                        "rule": "TELEGRAM_INTERNAL_STORAGE_THEFT",
                        "detail": f"Составной путь к системной базе/файлам авторизации Telegram ({full_s[:60]})"
                    })
                self.generic_visit(node)

            def visit_For(self, node):
                has_xor = any(isinstance(child, ast.BitXor) for child in ast.walk(node))
                has_mod = any(isinstance(child, ast.Mod) for child in ast.walk(node))
                if has_xor and has_mod and self.has_code_exec:
                    self.reports.append({
                        "level": "CRITICAL",
                        "line": getattr(node, 'lineno', 0),
                        "rule": "XOR_ENCRYPTED_PAYLOAD_EXEC",
                        "detail": "Обнаружен цикл побайтовой XOR-дешифровки исполняемого модуля"
                    })
                self.generic_visit(node)

            def visit_GeneratorExp(self, node):
                has_xor = any(isinstance(child, ast.BitXor) for child in ast.walk(node))
                has_mod = any(isinstance(child, ast.Mod) for child in ast.walk(node))
                if has_xor and has_mod and self.has_code_exec:
                    self.reports.append({
                        "level": "CRITICAL",
                        "line": getattr(node, 'lineno', 0),
                        "rule": "XOR_ENCRYPTED_PAYLOAD_EXEC",
                        "detail": "Обнаружен генератор побайтовой XOR-дешифровки исполняемого модуля"
                    })
                self.generic_visit(node)


            def _get_ast_ngrams(self, node):
                tokens = set()
                cfg_parents = {'Try', 'ExceptHandler', 'If', 'While', 'For', 'With', 'Call'}
                cfg_children = {'Call', 'Try', 'If', 'While', 'For', 'Raise', 'Return', 'Yield', 'Import', 'ImportFrom', 'Attribute'}
                for parent in ast.walk(node):
                    p_name = type(parent).__name__
                    if p_name in cfg_parents:
                        for child in ast.iter_child_nodes(parent):
                            c_name = type(child).__name__
                            if c_name in cfg_children:
                                tokens.add(f"cfg_{p_name}_{c_name}")
                    for attr in ('body', 'orelse', 'finalbody'):
                        seq = getattr(parent, attr, None)
                        if isinstance(seq, list) and len(seq) > 1:
                            for s1, s2 in zip(seq[:-1], seq[1:]):
                                t1, t2 = type(s1).__name__, type(s2).__name__
                                if t1 in ('Assign', 'Expr', 'If', 'Try', 'For', 'While', 'Return', 'Raise') and t2 in ('Assign', 'Expr', 'If', 'Try', 'For', 'While', 'Return', 'Raise'):
                                    tokens.add(f"cfg_seq_{t1}_{t2}")
                return " ".join(sorted(tokens))

            def _detect_behavior(self, node):
                tags = []
                if isinstance(node, (ast.While, ast.For)):
                    has_send = False
                    has_fast_sleep = False
                    for sub in ast.walk(node):
                        if isinstance(sub, ast.Call):
                            fn = ""
                            if isinstance(sub.func, ast.Name):
                                fn = sub.func.id
                            elif isinstance(sub.func, ast.Attribute):
                                fn = sub.func.attr
                            if fn == 'send_message' or 'send_message' in fn.lower():
                                has_send = True
                            if fn == 'sleep':
                                if sub.args and isinstance(sub.args[0], ast.Constant):
                                    try:
                                        if float(sub.args[0].value) <= 0.25:
                                            has_fast_sleep = True
                                    except Exception:
                                        pass
                                elif sub.args and isinstance(sub.args[0], ast.BinOp):
                                    has_fast_sleep = True
                    if has_send and has_fast_sleep:
                        tags.extend(['token_flood_loop', 'token_rapid_send', 'token_unsolicited_spammer'])
                has_db = False
                has_auth = False
                for sub in ast.walk(node):
                    if isinstance(sub, ast.Constant) and isinstance(sub.value, str):
                        v_low = sub.value.lower()
                        if any(k in v_low for k in ('cache4.db', 'tgnet.dat', 'userconfig.xml')):
                            has_db = True
                        if any(k in v_low for k in ('getauthkey', 'getsecretpkeys', 'auth_key')):
                            has_auth = True
                if has_db or has_auth:
                    tags.extend(['token_session_extract', 'token_db_theft'])
                if isinstance(node, ast.ClassDef):
                    return []
                has_dyn = False
                has_c2_net = False
                has_c2_exec = False
                for sub in ast.walk(node):
                    if isinstance(sub, ast.Call):
                        fn = ""
                        if isinstance(sub.func, ast.Name):
                            fn = sub.func.id
                            if fn in ('compile', 'exec'):
                                has_c2_exec = True
                            elif fn in ('b85decode', 'rc4'):
                                has_dyn = True
                            elif fn in ('urlopen', 'urlretrieve'):
                                has_c2_net = True
                        elif isinstance(sub.func, ast.Attribute):
                            fn = sub.func.attr
                            mod_name = sub.func.value.id if isinstance(sub.func.value, ast.Name) else ""
                            if mod_name in ('marshal', 'pickle', 'types') and fn in ('b85decode', 'rc4', 'loads'):
                                has_dyn = True
                            elif mod_name in ('requests', 'urllib', 'http', 'aiohttp', 'httpx') and fn in ('get', 'post', 'request'):
                                has_c2_net = True
                    elif isinstance(sub, ast.Constant) and isinstance(sub.value, str):
                        v_low = sub.value.lower()
                        if any(k in v_low for k in ('/proc/self/cmdline', 'android_id')) or 'http://' in v_low or 'https://' in v_low:
                            has_c2_net = True
                    elif isinstance(sub, ast.Attribute):
                        if sub.attr in ('did', 'android_id'):
                            has_c2_net = True
                if has_dyn:
                    tags.extend(['token_dynamic_stager', 'token_payload_exec'])
                if has_c2_net and has_c2_exec:
                    tags.extend(['token_c2_post', 'token_dynamic_stager', 'token_payload_exec', 'token_c2_post', 'token_dynamic_stager', 'token_payload_exec'])
                has_stars_drain = False
                for sub in ast.walk(node):
                    if isinstance(sub, ast.Constant) and isinstance(sub.value, str):
                        v_low = sub.value.lower()
                        if any(k in v_low for k in ('sendpaidreaction', 'paidreactionprivacy', 'updatestargiftprice', 'transferstargift', 'inputsavedstargift')):
                            has_stars_drain = True
                    elif isinstance(sub, ast.Attribute):
                        a_low = sub.attr.lower()
                        if any(k in a_low for k in ('sendpaidreaction', 'paidreactionprivacy', 'updatestargiftprice', 'transferstargift', 'inputsavedstargift')):
                            has_stars_drain = True
                if has_stars_drain:
                    tags.extend(['token_stars_drainer', 'token_gift_hijack'])
                return tags

            def _extract_chunk(self, node, default_name=None):
                c_name = getattr(node, 'name', default_name or type(node).__name__)
                b_tags = self._detect_behavior(node)
                if len(self.chunks) >= 128 and not b_tags:
                    return
                if len(self.chunks) >= 256:
                    return
                node_target = node
                if isinstance(node, ast.ClassDef):
                    try:
                        c_copy = copy.deepcopy(node)
                        c_copy.body = [copy.copy(m) if not isinstance(m, (ast.FunctionDef, ast.AsyncFunctionDef)) else (lambda f: setattr(f, 'body', [ast.Pass()]) or f)(copy.copy(m)) for m in c_copy.body]
                        node_target = c_copy
                    except Exception:
                        node_target = node
                try:
                    raw_unnorm = ast.unparse(node_target)
                    norm_tree = ASTNorm().visit(ast.parse(raw_unnorm))
                    ast.fix_missing_locations(norm_tree)
                    raw_code = ast.unparse(norm_tree)
                    canonical = " ".join(line.strip() for line in raw_code.splitlines() if line.strip())
                    if len(canonical) > 20:
                        structural = self._get_ast_ngrams(norm_tree)
                        parts = [canonical]
                        if structural:
                            parts.append(structural)
                        if b_tags:
                            parts.append(" ".join(b_tags * 3))
                        canonical = " ".join(parts)
                        self.chunks.append((c_name, getattr(node, 'lineno', 0), canonical))
                except Exception:
                    try:
                        raw_code = ast.unparse(node_target)
                        canonical = " ".join(line.strip() for line in raw_code.splitlines() if line.strip())
                        if len(canonical) > 20:
                            structural = self._get_ast_ngrams(node_target)
                            parts = [canonical]
                            if structural:
                                parts.append(structural)
                            if b_tags:
                                parts.append(" ".join(b_tags * 3))
                            canonical = " ".join(parts)
                            self.chunks.append((c_name, getattr(node, 'lineno', 0), canonical))
                    except Exception:
                        pass

        visitor = CombinedASTVisitor()
        visitor.visit(tree)
        reports.extend(visitor.reports)

        if (visitor.tainted_db_fns or visitor.has_db_scan) and (visitor.has_exfil_sink or visitor.tainted_exfil_fns):
            if not any(r.get("rule") in ("TELEGRAM_DATABASE_EXFILTRATION", "TELEGRAM_INTERNAL_STORAGE_THEFT") for r in reports):
                reports.append({
                    "level": "CRITICAL",
                    "line": 1,
                    "rule": "TELEGRAM_DATABASE_EXFILTRATION",
                    "detail": "Межпроцедурный поток кражи локальной БД Telegram (поиск .db -> SQL-опрос -> сетевая эксфильтрация)"
                })
        for h_line, h_fn in visitor.msg_exfil_hits:
            reports.append({
                "level": "CRITICAL",
                "line": h_line,
                "rule": "UNAUTHORIZED_DATA_EXFILTRATION",
                "detail": f"Выгрузка истории переписки во внешний сетевой канал в функции {h_fn}"
            })

        if visitor.has_clipboard_read and visitor.embedded_crypto_wallets:
            w_sample, w_line = visitor.embedded_crypto_wallets[0]
            reports.append({
                "level": "CRITICAL",
                "line": w_line,
                "rule": "CLIPBOARD_CRYPTO_CLIPPER",
                "detail": f"Обнаружен механизм клиппера: чтение/подмена буфера обмена на адрес криптокошелька ({w_sample})"
            })

        for val, cand_line in visitor.deep_base64_candidates:
            if not self.RE_BASE64_WITH_WS.match(val):
                continue
            try:
                raw = base64.b64decode(val)
                decompressed = None
                try:
                    decompressed = zlib.decompress(raw)
                except Exception:
                    pass

                target_bytes = decompressed if decompressed is not None else raw
                if target_bytes.startswith(bytes.fromhex("7f454c46")):
                    visitor.so_bytes_list.append((target_bytes, cand_line))
                elif target_bytes.startswith(bytes.fromhex("6465780a")):
                    if not visitor.dex_bytes:
                        visitor.dex_bytes = target_bytes
                        visitor.dex_line = cand_line
                elif b'\x00' not in target_bytes:
                    decoded = target_bytes.decode("utf-8", errors="ignore")
                    if '\x00' not in decoded and any(kw in decoded for kw in ["import ", "def ", "class ", "from ", "exec(", "eval("]):
                        sub_reports, _ = self.scan_plugin_code(decoded, depth + 1)
                        for sr in sub_reports:
                            if sr.get("rule") != "SYNTAX_ERROR":
                                sub_line = sr.get("line", 0)
                                loc_str = f" [вложенная строка {sub_line}]" if sub_line > 0 else ""
                                sr["detail"] = f"[DEOBFUSCATED DEEP PAYLOAD] {sr.get('detail')}{loc_str}"
                                sr["line"] = cand_line
                                reports.append(sr)
            except Exception:
                pass

        for var_name, joined_str in visitor.str_vars.items():
            var_line = visitor.str_var_lines.get(var_name, 0)
            if len(joined_str) >= 32 and ' ' not in joined_str and self.RE_BASE64_STRICT.match(joined_str):
                try:
                    raw = base64.b64decode(joined_str.strip())
                    decompressed = None
                    try:
                        decompressed = zlib.decompress(raw)
                    except Exception:
                        pass
                    target_bytes = decompressed if decompressed is not None else raw
                    if target_bytes.startswith(bytes.fromhex("7f454c46")):
                        visitor.so_bytes_list.append((target_bytes, var_line))
                    elif target_bytes.startswith(bytes.fromhex("6465780a")):
                        if not visitor.dex_bytes:
                            visitor.dex_bytes = target_bytes
                            visitor.dex_line = var_line
                    elif len(raw) <= 32768:
                        for key_len in [1, 2, 4, 8, 16, 32]:
                            if len(raw) < key_len:
                                continue
                            sample = raw[:2048]
                            for offset in range(0, min(30, len(sample) - key_len)):
                                key = sample[offset : offset + key_len]
                                if not key or all(b == 0 for b in key):
                                    continue
                                try:
                                    klen = len(key)
                                    xored = bytes([b ^ key[i % klen] for i, b in enumerate(sample)])
                                    decomp_b = None
                                    if len(xored) >= 2 and (xored[0] & 0x0F) == 8 and ((xored[0] * 256 + xored[1]) % 31 == 0):
                                        try:
                                            decomp_b = zlib.decompress(xored)
                                        except Exception:
                                            pass
                                    check_b = decomp_b if decomp_b is not None else xored
                                    if check_b.startswith(bytes.fromhex("6465780a")) or check_b.startswith(bytes.fromhex("7f454c46")) or b'\x00' in check_b:
                                        continue
                                    decomp = check_b.decode("utf-8", errors="ignore")
                                    if '\x00' not in decomp and any(kw in decomp for kw in ["import ", "def ", "class ", "from ", "exec(", "eval(", "requests", "urllib", "socket"]):
                                        reports.append({
                                            "level": "CRITICAL",
                                            "line": var_line,
                                            "rule": "XOR_OBFUSCATED_PAYLOAD",
                                            "detail": f"Обнаружена XOR/Zlib полезная нагрузка в переменной {var_name}"
                                        })
                                        break
                                except Exception:
                                    pass
                except Exception:
                    pass

        raw_dex, dex_line = (visitor.dex_bytes, visitor.dex_line) if visitor.dex_bytes else (dex_bytes, dex_line)
        if raw_dex:
            dex_reports = self._scan_embedded_dex(raw_dex, dex_line, stats=stats)
            reports.extend(dex_reports)

        unique_so = []
        seen_so = set()
        for so_b, so_line in visitor.so_bytes_list:
            h = hashlib.sha256(so_b).hexdigest()
            if h not in seen_so:
                seen_so.add(h)
                unique_so.append((so_b, so_line))

        for so_bytes, so_line in unique_so:
            so_reports = self._scan_embedded_so(so_bytes, so_line)
            reports.extend(so_reports)

        if visitor.chunks:
            stats = self._scan_vector_chunks(visitor.chunks, reports, stats)

        if depth == 0 and deobf_payloads and 'sub_stats_list' in locals() and sub_stats_list:
            for s_st in sub_stats_list:
                stats["obfuscation_layers"] = max(stats.get("obfuscation_layers", 0), obf_layers_count + s_st.get("obfuscation_layers", 0))
                stats["max_malware_similarity"] = max(stats.get("max_malware_similarity", 0.0), s_st.get("max_malware_similarity", 0.0))
                if s_st.get("scanned_chunks", 0) > 0:
                    if stats.get("scanned_chunks", 0) == 0:
                        stats["scanned_chunks"] = s_st["scanned_chunks"]
                        stats["max_similarity"] = s_st["max_similarity"]
                        stats["min_similarity"] = s_st["min_similarity"]
                        stats["avg_similarity"] = s_st["avg_similarity"]
                        stats["threshold_diff"] = s_st["threshold_diff"]
                        stats["vectors_count"] = s_st.get("vectors_count", stats["vectors_count"])
                        stats["status"] = s_st.get("status", stats["status"])
                    else:
                        stats["scanned_chunks"] = stats.get("scanned_chunks", 0) + s_st["scanned_chunks"]
                        stats["max_similarity"] = max(stats.get("max_similarity", 0.0), s_st.get("max_similarity", 0.0))

        if 'payload_records' in locals() and payload_records:
            stats["unpacked_payloads"] = [p for p in payload_records if any(t.get("level") == "CRITICAL" for t in p.get("threats", []))] if depth == 0 else payload_records
        else:
            stats["unpacked_payloads"] = []

        stats["scan_time_ms"] = round((time.perf_counter() - t_start) * 1000, 2)
        return reports, stats

    def _scan_embedded_dex(self, dex_bytes: bytes, line: int = 0, stats: Optional[Dict[str, Any]] = None) -> List[Dict[str, Any]]:
        reports = []
        if stats is not None:
            stats["dex_found"] = True
            stats["dex_size"] = len(dex_bytes)
            stats["dex_decompiled"] = False
            stats["dex_classes_count"] = 0
            stats["dex_methods_count"] = 0

        if len(dex_bytes) < 112 or not (dex_bytes.startswith(bytes.fromhex("6465780a")) or dex_bytes.startswith(b"cdex")):
            reports.append({
                "level": "CRITICAL",
                "line": line,
                "rule": "CORRUPTED_DEX_HEADER",
                "detail": "Встроенный DEX payload поврежден или имеет невалидный заголовок"
            })
            return reports

        strings, methods, fields, classes, disasm_lines = self._disassemble_dex_tables(dex_bytes)
        if stats is not None:
            stats["dex_decompiled"] = bool(classes or methods or strings)
            stats["dex_classes_count"] = len(classes)
            stats["dex_methods_count"] = len(methods)

        class_names = [c[0] for c in classes] + [c[1] for c in classes]
        all_symbols = strings + methods + fields + class_names + disasm_lines
        dex_stolen_targets = ['auth_key', 'authkey', 'getauthkey', 'getsecretpkeys', 'opendatabase', 'passcode.xml', 'userconfig.xml', 'cache4.db', 'tgnet.dat', 'stolen_cache']
        dex_network_sinks = {
            'requests', 'urllib', 'aiohttp', 'httpx', 'socket',
            'HttpURLConnection', 'HttpsURLConnection', 'OkHttpClient', 'urlopen', 'openConnection', 'openStream',
            'getOutputStream', 'DataOutputStream', 'sendall', 'sendto', 'DatagramSocket'
        }
        detected_sources = []
        detected_sinks = []
        for sym in all_symbols:
            s_low = sym.lower()
            for tgt in dex_stolen_targets:
                if tgt in s_low:
                    detected_sources.append(sym)
            for net in dex_network_sinks:
                if net.lower() in s_low:
                    detected_sinks.append(sym)

        if detected_sources and detected_sinks:
            reports.append({
                "level": "CRITICAL",
                "line": line,
                "rule": "DEX_EXFILTRATION_PATTERN",
                "detail": f"Обнаружен канал эксфильтрации в скомпилированном DEX ({detected_sources[:1]} -> {detected_sinks[:1]})"
            })

        for s in strings:
            m_ip = self.RE_IPV4_C2.search(s)
            if m_ip and not s.startswith("http://127.0.0.1") and not s.startswith("http://localhost"):
                reports.append({
                    "level": "CRITICAL",
                    "line": line,
                    "rule": "DEX_RAW_IP_C2_ENDPOINT",
                    "detail": f"Прямое обращение к C2-серверу по IPv4-адресу из скомпилированного DEX ({m_ip.group(0)})"
                })
                break

        dex_methods_body = []
        cur_m_sig = None
        cur_m_body = []
        for d_line in disasm_lines:
            if d_line.startswith("  .method "):
                cur_m_sig = d_line
                cur_m_body = []
            elif d_line.startswith("  .end method"):
                if cur_m_sig:
                    dex_methods_body.append((cur_m_sig, cur_m_body))
                cur_m_sig = None
            elif cur_m_sig is not None:
                cur_m_body.append(d_line)

        for lvl, r_map, msg_prefix in (
            ("CRITICAL", self.DEX_BLACKLIST_CRITICAL, "Опасный бинарный вызов в скомпилированном DEX"),
            ("WARNING", self.DEX_BLACKLIST_HIGH, "Подозрительный API-вызов в DEX"),
            ("WARNING", self.DEX_BLACKLIST_WARNING, "Обращение к системным ресурсам из DEX")
        ):
            for rule, patterns in r_map.items():
                for p in patterns:
                    p_low = p.lower()
                    matched = False
                    if rule == "DEX_PROCESS_KILLER_DOS":
                        for m_sig, m_body in dex_methods_body:
                            body_text = " ".join(m_body).lower()
                            if p_low in body_text:
                                if "mypid" not in body_text:
                                    matched = True
                                    break
                    elif p_low == "processbuilder":
                        for m_sig, m_body in dex_methods_body:
                            body_text = " ".join(m_body).lower()
                            if "processbuilder" in body_text:
                                if "logcat" not in body_text or any(sh in body_text for sh in ("/bin/sh", "su ", "chmod", "curl", "wget")):
                                    matched = True
                                    break
                    elif p_low in ("checkservertrusted", "x509trustmanager;->checkservertrusted"):
                        for m_sig, m_body in dex_methods_body:
                            if "->checkservertrusted" in m_sig.lower():
                                body_text = " ".join(m_body).lower()
                                if "certificateexception" not in body_text and "x509trustmanager;->checkservertrusted" not in body_text:
                                    matched = True
                                    break
                    else:
                        if any(p_low in s.lower() for s in all_symbols):
                            matched = True
                    if matched:
                        reports.append({
                            "level": lvl,
                            "line": line,
                            "rule": rule,
                            "detail": f"{msg_prefix}: {p}"
                        })
                        break

        return reports

    def _scan_embedded_so(self, so_bytes: bytes, line: int = 0) -> List[Dict[str, Any]]:
        reports = []
        if len(so_bytes) < 52 or not so_bytes.startswith(bytes.fromhex("7f454c46")):
            return reports

        e_machine = struct.unpack("<H", so_bytes[18:20])[0] if len(so_bytes) >= 20 else 0
        arch_map = {183: "ARM64 (aarch64)", 40: "ARM32 (armv7)", 62: "x86_64", 3: "x86"}
        arch_name = arch_map.get(e_machine, f"Arch-{e_machine}")

        exploit_symbols = [b"/system/bin/sh", b"libsu.so", b"ptrace", b"execve"]
        network_symbols = [b"socket", b"connect", b"sendto", b"send", b"getprop", b"setprop", b"chmod", b"kill"]

        exploit_found = [s.decode("ascii", errors="ignore") for s in exploit_symbols if s in so_bytes]
        net_found = [s.decode("ascii", errors="ignore") for s in network_symbols if s in so_bytes]

        if exploit_found:
            reports.append({
                "level": "CRITICAL",
                "line": line,
                "rule": "SO_NATIVE_EXPLOIT_SYMBOLS",
                "detail": f"Встроенная нативная библиотека .so ({arch_name}) содержит эксплойт-символы ({', '.join(exploit_found)}). Бинарный код невозможно полностью проверить, устанавливайте на свой страх и риск!"
            })
        elif net_found:
            reports.append({
                "level": "WARNING",
                "line": line,
                "rule": "SO_NATIVE_SYMBOLS",
                "detail": f"Встроенная нативная библиотека .so ({arch_name}) содержит системные символы ({', '.join(net_found[:3])}). Бинарный код невозможно полностью проверить, устанавливайте на свой страх и риск!"
            })
        else:
            reports.append({
                "level": "WARNING",
                "line": line,
                "rule": "EMBEDDED_NATIVE_SO_PAYLOAD",
                "detail": f"Встроенный бинарный нативный модуль .so ({arch_name}, {len(so_bytes):,} байт). Бинарный код невозможно полностью проверить, устанавливайте на свой страх и риск!"
            })

        return reports

    def _scan_vector_chunks(self, chunks: List[Tuple[str, int, str]], reports: List[Dict[str, Any]], stats: Dict[str, Any]) -> Dict[str, Any]:
        vec_path, meta_path = self._resolve_model_paths()
        if not os.path.exists(vec_path):
            stats["status"] = "MODEL_FILE_NOT_FOUND"
            return stats

        meta = {}
        if os.path.exists(meta_path):
            try:
                with open(meta_path, "r", encoding="utf-8") as mf:
                    meta = json.load(mf)
            except Exception:
                pass

        threshold = float(meta.get("threshold", 0.63))
        mal_thresh = float(meta.get("malware_threshold", 0.70))
        dim = int(meta.get("dim", 384))
        vectors_count = int(meta.get("total_clean_chunks") or meta.get("total_chunks") or meta.get("vectors_count", 20208))
        stats["threshold"] = threshold
        stats["vectors_count"] = vectors_count
        stats["model_version"] = str(meta.get("version") or meta.get("model_version") or "2.3.3")

        unique_chunks = []
        seen_canonical = set()
        for name, lineno, code in chunks:
            if code not in seen_canonical:
                seen_canonical.add(code)
                unique_chunks.append((name, lineno, code))

        stats["scanned_chunks"] = len(unique_chunks)
        seen_code_sims = {}
        all_sims = []
        global_max_sim = 0.0
        global_min_sim = 1.0
        global_max_mal_sim = 0.0

        use_dex = False
        try:
            from org.telegram.messenger import ApplicationLoader
            if ApplicationLoader.applicationContext is not None:
                use_dex = True
                rt = find_class("java.lang.Runtime").getRuntime()
                avail_mem = rt.maxMemory() - (rt.totalMemory() - rt.freeMemory())
                if avail_mem < 50 * 1024 * 1024:
                    rt.gc()
                    avail_mem = rt.maxMemory() - (rt.totalMemory() - rt.freeMemory())
                if avail_mem < 25 * 1024 * 1024:
                    use_dex = False
        except BaseException:
            pass

        if use_dex and self._ensure_dex_model_loaded(vec_path):
            sims = []
            try:
                batch_size = 20
                for b_i in range(0, len(unique_chunks), batch_size):
                    b_chunks = unique_chunks[b_i:b_i + batch_size]
                    joined_texts = "\n===CHUNK_SPLIT===\n".join(c[2] for c in b_chunks)
                    sim_array = self._invoke_dex("evaluateAllChunksDual", joined_texts)
                    del joined_texts
                    if sim_array is not None:
                        sims.extend(list(sim_array))
                        del sim_array
                    else:
                        sims.extend([0.0] * (len(b_chunks) * 2))
            except BaseException as de:
                self.log(f"[PluginGuard DEBUG] evaluateAllChunksDual failed: {de}")
                if len(sims) < len(unique_chunks) * 2:
                    sims.extend([0.0] * (len(unique_chunks) * 2 - len(sims)))

            for idx, (name, lineno, code) in enumerate(unique_chunks):
                mean_top5 = float(sims[idx * 2]) if (idx * 2) < len(sims) else 0.0
                malware_max = float(sims[idx * 2 + 1]) if (idx * 2 + 1) < len(sims) else 0.0
                seen_code_sims[code] = mean_top5
                all_sims.append(mean_top5)
                if mean_top5 > global_max_sim:
                    global_max_sim = mean_top5
                if mean_top5 < global_min_sim:
                    global_min_sim = mean_top5
                if malware_max > global_max_mal_sim:
                    global_max_mal_sim = malware_max

                if len(code) > 30 and malware_max >= mal_thresh and (malware_max - mean_top5) >= 0.04:
                    reports.append({
                        "level": "CRITICAL",
                        "line": lineno,
                        "function": name,
                        "rule": "KNOWN_MALWARE_SIGNATURE_MATCH",
                        "detail": f"Вредоносная семантическая сигнатура {name} (угроза {malware_max:.4f} vs норма {mean_top5:.4f})"
                    })
                elif len(code) > 30 and malware_max >= (mal_thresh - 0.04) and (malware_max - mean_top5) >= 0.02:
                    reports.append({
                        "level": "WARNING",
                        "line": lineno,
                        "function": name,
                        "rule": "SUSPICIOUS_SIGNATURE_MATCH",
                        "detail": f"Подозрительная семантическая сигнатура {name} (угроза {malware_max:.4f} vs норма {mean_top5:.4f})"
                    })
                elif mean_top5 < threshold:
                    reports.append({
                        "level": "INFO",
                        "line": lineno,
                        "rule": "SEMANTIC_ANOMALY_OUTLIER",
                        "detail": f"Семантическая редкая функция {name} (схожесть {mean_top5:.4f} < {threshold:.4f})"
                    })
            stats["status"] = "LOADED (Java DEX Engine)"
        else:
            stats["status"] = "LOADED (Python Fallback Engine)"
            precision = int(self.get_setting("model_precision", 0))
            try:
                model = ModelStore.get_model(vec_path, meta_path, precision=precision)
            except BaseException:
                model = None
            if not model:
                stats["status"] = "SKIPPED_LOW_MEMORY"
                return stats
            threshold = model["threshold"]
            dim = model["dim"]
            stats["threshold"] = threshold
            stats["vectors_count"] = model["num_rows"]
            matrix = model["matrix"]
            inv_index = model["inv_index"]
            malware_matrix = model.get("malware_matrix")
            malware_inv = model.get("malware_inv")

            import concurrent.futures
            def _eval_single_chunk(item):
                c_name, c_lineno, c_code = item
                vec = self._hash_token(c_code, dim)
                non_zero = [(i, val) for i, val in enumerate(vec) if val > 0]
                if not non_zero:
                    return c_name, c_lineno, c_code, 0.0, 0.0, 0.0

                candidate_rows = set()
                for idx, _ in non_zero:
                    if idx in inv_index:
                        candidate_rows.update(inv_index[idx])

                c_top5 = [0.0] * 5
                if candidate_rows:
                    for r in candidate_rows:
                        row_floats = matrix[r]
                        dot = sum(row_floats[i] * val for i, val in non_zero)
                        if dot > c_top5[0]:
                            c_top5[0] = dot
                            c_top5.sort()
                c_mean_top5 = sum(c_top5) / 5.0
                c_max_clean = c_top5[-1]

                c_mal_max = 0.0
                if malware_matrix and malware_inv:
                    m_candidates = set()
                    for idx, _ in non_zero:
                        if idx in malware_inv:
                            m_candidates.update(malware_inv[idx])
                    for mr in m_candidates:
                        mrow = malware_matrix[mr]
                        mdot = sum(mrow[i] * val for i, val in non_zero)
                        if mdot > c_mal_max:
                            c_mal_max = mdot

                return c_name, c_lineno, c_code, c_mean_top5, c_max_clean, c_mal_max

            max_w = min(os.cpu_count() or 2, 4)
            with concurrent.futures.ThreadPoolExecutor(max_workers=max_w) as executor:
                results = list(executor.map(_eval_single_chunk, unique_chunks))

            mal_thresh = float(model.get("malware_threshold", 0.78))
            for name, lineno, code, mean_top5, max_clean, malware_max in results:
                seen_code_sims[code] = mean_top5
                all_sims.append(mean_top5)
                if mean_top5 > global_max_sim:
                    global_max_sim = mean_top5
                if mean_top5 < global_min_sim:
                    global_min_sim = mean_top5
                if malware_max > global_max_mal_sim:
                    global_max_mal_sim = malware_max

                if len(code) > 30 and malware_max >= mal_thresh and (malware_max - max_clean) >= 0.04:
                    reports.append({
                        "level": "CRITICAL",
                        "line": lineno,
                        "function": name,
                        "rule": "KNOWN_MALWARE_SIGNATURE_MATCH",
                        "detail": f"Вредоносная семантическая сигнатура {name} (угроза {malware_max:.4f} vs норма {max_clean:.4f})"
                    })
                elif len(code) > 30 and malware_max >= (mal_thresh - 0.04) and (malware_max - max_clean) >= 0.02:
                    reports.append({
                        "level": "WARNING",
                        "line": lineno,
                        "function": name,
                        "rule": "SUSPICIOUS_SIGNATURE_MATCH",
                        "detail": f"Подозрительная семантическая сигнатура {name} (угроза {malware_max:.4f} vs норма {max_clean:.4f})"
                    })
                elif mean_top5 < threshold:
                    reports.append({
                        "level": "INFO",
                        "line": lineno,
                        "function": name,
                        "rule": "SEMANTIC_ANOMALY_OUTLIER",
                        "detail": f"Семантическая редкая функция {name} (схожесть {mean_top5:.4f} < {threshold:.4f})"
                    })

        if not all_sims:
            global_min_sim = 0.0
        avg_sim = sum(all_sims) / len(all_sims) if all_sims else 0.0
        stats["max_similarity"] = global_max_sim
        stats["min_similarity"] = global_min_sim
        stats["avg_similarity"] = avg_sim
        stats["max_malware_similarity"] = global_max_mal_sim
        diff = global_max_sim - threshold
        if diff >= 0:
            stats["threshold_diff"] = f"+{diff:.4f}"
        else:
            stats["threshold_diff"] = f"{diff:.4f}"

        return stats

    def _extract_dex_bytes(self, tree: Optional[ast.AST] = None, code_str: Optional[str] = None) -> Tuple[bytes, int]:
        magics = (bytes.fromhex("6465780a"), b"cdex")

        def _is_dex(d: bytes) -> bool:
            if not isinstance(d, (bytes, bytearray)) or len(d) < 112:
                return False
            return any(d.startswith(m) for m in magics)

        def _try_decode(b_cand: bytes) -> bytes:
            if _is_dex(b_cand):
                return b_cand
            try:
                dec = zlib.decompress(b_cand)
                if _is_dex(dec):
                    return dec
            except Exception:
                pass
            return b""

        def _decode_str(s: str) -> bytes:
            s_clean = re.sub(r'\s+', '', s)
            if len(s_clean) < 32:
                return b""
            for cand in (s_clean, s_clean[::-1]):
                try:
                    raw = base64.b64decode(cand, validate=False)
                    res = _try_decode(raw)
                    if res:
                        return res
                except Exception:
                    pass
                try:
                    raw = base64.b85decode(cand)
                    res = _try_decode(raw)
                    if res:
                        return res
                except Exception:
                    pass
                if len(cand) >= 224 and len(cand) % 2 == 0 and re.fullmatch(r'[0-9a-fA-F]+', cand):
                    try:
                        raw = binascii.unhexlify(cand)
                        res = _try_decode(raw)
                        if res:
                            return res
                    except Exception:
                        pass
            return b""

        if code_str:
            if "# __DEX_BEGIN__" in code_str and "# __DEX_END__" in code_str:
                try:
                    block = code_str.split("# __DEX_BEGIN__", 1)[1].split("# __DEX_END__", 1)[0]
                    clean_b64 = "".join(line.strip()[1:].strip() for line in block.splitlines() if line.strip().startswith("#"))
                    res = _decode_str(clean_b64)
                    if res:
                        return res, 1
                except Exception:
                    pass
            for m in self.RE_COMMENT_B64.finditer(code_str):
                matched_text = m.group(0)
                clean = "".join(l.split("#", 1)[1].strip() for l in matched_text.splitlines() if "#" in l)
                lineno = code_str[:m.start()].count('\n') + 1
                res = _decode_str(clean)
                if res:
                    return res, lineno

        if tree is not None:
            for node in ast.walk(tree):
                lineno = getattr(node, 'lineno', 0)
                if isinstance(node, ast.Constant):
                    if isinstance(node.value, bytes):
                        res = _try_decode(node.value)
                        if res:
                            return res, lineno
                    elif isinstance(node.value, str):
                        s = node.value
                        if len(s) >= 32:
                            res = _decode_str(s)
                            if res:
                                return res, lineno

        return b"", 0

    def _disassemble_dex_tables(self, dex: bytes) -> Tuple[List[str], List[str], List[str], List[Tuple[str, str]], List[str]]:
        strings = []
        methods = []
        fields = []
        classes = []
        disasm_lines = []
        try:
            if len(dex) < 112 or not (dex.startswith(bytes.fromhex("6465780a")) or dex.startswith(b"cdex")):
                return strings, methods, fields, classes, disasm_lines

            def _read_uleb128(data: bytes, off: int) -> Tuple[int, int]:
                val = 0
                shift = 0
                d_len = len(data)
                while off < d_len:
                    b = data[off]
                    off += 1
                    val |= (b & 0x7f) << shift
                    if not (b & 0x80):
                        break
                    shift += 7
                return val, off

            string_ids_size = struct.unpack("<I", dex[56:60])[0]
            string_ids_off = struct.unpack("<I", dex[60:64])[0]
            type_ids_size = struct.unpack("<I", dex[64:68])[0]
            type_ids_off = struct.unpack("<I", dex[68:72])[0]
            field_ids_size = struct.unpack("<I", dex[80:84])[0]
            field_ids_off = struct.unpack("<I", dex[84:88])[0]
            method_ids_size = struct.unpack("<I", dex[88:92])[0]
            method_ids_off = struct.unpack("<I", dex[92:96])[0]
            class_defs_size = struct.unpack("<I", dex[96:100])[0]
            class_defs_off = struct.unpack("<I", dex[100:104])[0]

            for i in range(min(string_ids_size, 50000)):
                ptr = string_ids_off + (i * 4)
                if ptr + 4 > len(dex): break
                s_off = struct.unpack("<I", dex[ptr:ptr+4])[0]
                l, idx = _read_uleb128(dex, s_off)
                if idx + l <= len(dex):
                    strings.append(dex[idx:idx+l].decode("utf-8", errors="replace"))

            type_names = []
            for i in range(min(type_ids_size, 15000)):
                ptr = type_ids_off + (i * 4)
                if ptr + 4 > len(dex): break
                d_idx = struct.unpack("<I", dex[ptr:ptr+4])[0]
                type_names.append(strings[d_idx] if d_idx < len(strings) else "")

            for i in range(min(field_ids_size, 30000)):
                ptr = field_ids_off + (i * 8)
                if ptr + 8 > len(dex): break
                c_idx, t_idx, n_idx = struct.unpack("<HHI", dex[ptr:ptr+8])
                cls_str = type_names[c_idx] if c_idx < len(type_names) else ""
                t_str = type_names[t_idx] if t_idx < len(type_names) else ""
                name_str = strings[n_idx] if n_idx < len(strings) else ""
                if cls_str or name_str:
                    fields.append(f"{cls_str}->{name_str}:{t_str}")

            for i in range(min(method_ids_size, 30000)):
                ptr = method_ids_off + (i * 8)
                if ptr + 8 > len(dex): break
                c_idx, p_idx, n_idx = struct.unpack("<HHI", dex[ptr:ptr+8])
                cls_str = type_names[c_idx] if c_idx < len(type_names) else ""
                name_str = strings[n_idx] if n_idx < len(strings) else ""
                if cls_str or name_str:
                    methods.append(f"{cls_str}->{name_str}")

            for i in range(min(class_defs_size, 5000)):
                ptr = class_defs_off + (i * 32)
                if ptr + 32 > len(dex): break
                c_idx, a_flags, sc_idx, if_off, sf_idx, annot_off, class_data_off, st_val_off = struct.unpack("<IIIIIIII", dex[ptr:ptr+32])
                c_name = type_names[c_idx] if c_idx < len(type_names) else f"Class_{c_idx}"
                sc_name = type_names[sc_idx] if sc_idx < len(type_names) and sc_idx != 0xFFFFFFFF else "java/lang/Object"
                classes.append((c_name, sc_name))
                disasm_lines.append(f".class {c_name}")
                disasm_lines.append(f".super {sc_name}")

                if class_data_off == 0 or class_data_off >= len(dex):
                    disasm_lines.append("")
                    continue

                off = class_data_off
                s_f_sz, off = _read_uleb128(dex, off)
                i_f_sz, off = _read_uleb128(dex, off)
                d_m_sz, off = _read_uleb128(dex, off)
                v_m_sz, off = _read_uleb128(dex, off)

                for _ in range(s_f_sz + i_f_sz):
                    diff, off = _read_uleb128(dex, off)
                    flags, off = _read_uleb128(dex, off)

                for is_virtual, total_m in ((False, d_m_sz), (True, v_m_sz)):
                    m_idx = 0
                    for _ in range(total_m):
                        diff, off = _read_uleb128(dex, off)
                        m_idx += diff
                        flags, off = _read_uleb128(dex, off)
                        code_off, off = _read_uleb128(dex, off)
                        m_sig = methods[m_idx] if m_idx < len(methods) else f"method_{m_idx}"
                        disasm_lines.append(f"  .method {m_sig}")
                        if code_off > 0 and code_off + 16 <= len(dex):
                            reg_sz, ins_sz, outs_sz, tries_sz, dbg_off, insns_sz = struct.unpack("<HHHHII", dex[code_off:code_off+16])
                            code_end = code_off + 16 + insns_sz * 2
                            if code_end <= len(dex):
                                insns = dex[code_off+16:code_end]
                                pc = 0
                                while pc < len(insns):
                                    op = insns[pc]
                                    if op == 0x1a and pc + 3 < len(insns):
                                        s_idx = struct.unpack_from('<H', insns, pc+2)[0]
                                        if s_idx < len(strings):
                                            disasm_lines.append(f"    const-string \"{strings[s_idx]}\"")
                                        pc += 4
                                    elif op == 0x1b and pc + 5 < len(insns):
                                        s_idx = struct.unpack_from('<I', insns, pc+2)[0]
                                        if s_idx < len(strings):
                                            disasm_lines.append(f"    const-string/jumbo \"{strings[s_idx]}\"")
                                        pc += 6
                                    elif 0x52 <= op <= 0x5f and pc + 3 < len(insns):
                                        f_idx = struct.unpack_from('<H', insns, pc+2)[0]
                                        if f_idx < len(fields):
                                            disasm_lines.append(f"    field-op {fields[f_idx]}")
                                        pc += 4
                                    elif (0x6e <= op <= 0x72 or 0x74 <= op <= 0x78) and pc + 3 < len(insns):
                                        meth_idx = struct.unpack_from('<H', insns, pc+2)[0]
                                        if meth_idx < len(methods):
                                            disasm_lines.append(f"    invoke-op {methods[meth_idx]}")
                                        pc += 6
                                    else:
                                        pc += 2
                        disasm_lines.append("  .end method")
                disasm_lines.append("")
        except Exception:
            pass
        return strings, methods, fields, classes, disasm_lines

    def _get_dumps_dir(self) -> str:
        candidates = []
        try:
            from android.os import Environment
            pub_dl = Environment.getExternalStoragePublicDirectory(Environment.DIRECTORY_DOWNLOADS)
            if pub_dl:
                candidates.append(os.path.join(str(pub_dl.getAbsolutePath()), "PluginGuard_Dumps"))
        except Exception:
            pass
        candidates.extend([
            "/sdcard/Download/PluginGuard_Dumps",
            "/storage/emulated/0/Download/PluginGuard_Dumps",
            os.path.join(self._get_cache_dir(), "dumps")
        ])
        for path in candidates:
            try:
                os.makedirs(path, exist_ok=True)
                if os.path.exists(path):
                    return path
            except Exception:
                pass
        fallback = os.path.join(self._get_cache_dir(), "dumps")
        os.makedirs(fallback, exist_ok=True)
        return fallback

    def _is_safe_ast_node(self, node, allow_exec_capture: bool = False) -> bool:
        safe_nodes = (
            ast.Module, ast.Assign, ast.AnnAssign, ast.AugAssign, ast.Name, ast.Constant,
            ast.List, ast.Tuple, ast.Dict, ast.Set, ast.BinOp, ast.UnaryOp, ast.Compare,
            ast.Call, ast.Attribute, ast.Subscript, ast.Slice, ast.Lambda,
            ast.ListComp, ast.DictComp, ast.SetComp, ast.GeneratorExp, ast.comprehension,
            ast.FunctionDef, ast.arguments, ast.arg, ast.Return, ast.Expr, ast.If,
            ast.For, ast.While, ast.Break, ast.Continue, ast.Pass,
            ast.Add, ast.Sub, ast.Mult, ast.Div, ast.FloorDiv, ast.Mod, ast.Pow,
            ast.LShift, ast.RShift, ast.BitOr, ast.BitXor, ast.BitAnd, ast.Invert,
            ast.Not, ast.USub, ast.UAdd, ast.Eq, ast.NotEq, ast.Lt, ast.LtE, ast.Gt, ast.GtE,
            ast.Is, ast.IsNot, ast.In, ast.NotIn, ast.And, ast.Or, ast.BoolOp,
            ast.Try, ast.ExceptHandler, ast.Import, ast.ImportFrom, ast.alias,
            ast.Load, ast.Store, ast.Del
        )
        blocked_names = {'open', 'getattr', 'setattr', 'delattr', 'vars', 'dir', '__builtins__', 'breakpoint', 'input', 'exit', 'quit'}
        if not allow_exec_capture:
            blocked_names.update({'compile', '__import__', 'eval', 'exec', 'globals', 'locals'})
        for child in ast.walk(node):
            if not isinstance(child, safe_nodes):
                return False
            if isinstance(child, ast.Attribute):
                if child.attr.startswith('__') and child.attr not in ('__name__', '__doc__', '__b', '__z', '__h', '__s', '__k', '__r', '__d'):
                    return False
                if child.attr in ('system', 'popen', 'spawn', 'eval', 'open', 'remove', 'unlink', 'rmdir', 'mkdir', 'read', 'write', 'delete', 'connect', 'send', 'socket'):
                    return False
            if isinstance(child, ast.Name) and child.id in blocked_names:
                return False
            if isinstance(child, ast.Import):
                mod_names = [alias.name.split('.')[0] for alias in child.names]
                if any(m not in ('base64', 'zlib', 'hashlib', 'binascii', 'bz2', 'lzma', 'math', 'string', 'struct', 'json') for m in mod_names):
                    return False
            elif isinstance(child, ast.ImportFrom):
                mod_name = child.module.split('.')[0] if child.module else ''
                if mod_name not in ('base64', 'zlib', 'hashlib', 'binascii', 'bz2', 'lzma', 'math', 'string', 'struct', 'json'):
                    return False
        return True

    def _safe_sandbox_import(self, name: str, globals=None, locals=None, fromlist=(), level=0):
        allowed_modules = {
            'base64': base64, 'zlib': zlib, 'hashlib': hashlib, 'binascii': binascii,
            'bz2': bz2, 'lzma': lzma, 'math': math, 'string': string, 'struct': struct,
            'json': json
        }
        top_name = name.split('.')[0]
        if top_name in allowed_modules:
            return allowed_modules[top_name]
        raise ImportError(f"Module {name} not allowed in sandbox")

    class ASTEval:
        def __init__(self, max_ops=3000000, max_depth=100):
            self.max_ops = max_ops
            self.max_depth = max_depth
            self.ops_count = 0
            self.captured_payloads = []
            self.safe_modules = {
                'base64': base64, '__b': base64, '_b': base64, '_b64': base64, 'b64': base64,
                'zlib': zlib, '__z': zlib, '_z': zlib,
                'hashlib': hashlib, '__h': hashlib, '_h': hashlib,
                'binascii': binascii, 'bz2': bz2, 'lzma': lzma,
                'struct': struct, 'json': json,
                'math': math, 'string': string
            }
            self.safe_builtins = {
                'len': len, 'range': range, 'chr': chr, 'ord': ord, 'int': int, 'str': str, 'float': float,
                'bytes': bytes, 'bytearray': bytearray, 'list': list, 'dict': dict, 'set': set, 'tuple': tuple,
                'enumerate': enumerate, 'zip': zip, 'reversed': reversed, 'slice': slice, 'isinstance': isinstance,
                'bool': bool, 'min': min, 'max': max, 'sum': sum, 'abs': abs, 'all': all, 'any': any, 'round': round,
                'map': map, 'filter': filter, 'iter': iter, 'next': next, 'hex': hex, 'oct': oct, 'bin': bin,
                'repr': repr, 'print': lambda *a, **k: None,
                'Exception': Exception, 'BaseException': BaseException, 'TypeError': TypeError,
                'ValueError': ValueError, 'KeyError': KeyError, 'AttributeError': AttributeError,
                'IndexError': IndexError, 'RuntimeError': RuntimeError,
                'True': True, 'False': False, 'None': None,
                'globals': lambda: env, 'locals': lambda: env
            }

        def _tick(self):
            self.ops_count += 1
            if self.ops_count > self.max_ops:
                raise RuntimeError("Limit")

        def eval_node(self, node, env, depth=0):
            self._tick()
            if depth > self.max_depth:
                raise RecursionError("Depth")
            if isinstance(node, ast.Constant):
                return node.value
            if isinstance(node, ast.Name):
                if node.id in env: return env[node.id]
                if node.id in self.safe_modules: return self.safe_modules[node.id]
                if node.id in self.safe_builtins: return self.safe_builtins[node.id]
                if node.id in ('exec', 'eval', 'compile'): return node.id
                raise NameError(node.id)
            if isinstance(node, ast.UnaryOp):
                val = self.eval_node(node.operand, env, depth + 1)
                if isinstance(node.op, ast.UAdd): return +val
                if isinstance(node.op, ast.USub): return -val
                if isinstance(node.op, ast.Not): return not val
                if isinstance(node.op, ast.Invert): return ~val
            if isinstance(node, ast.BinOp):
                l = self.eval_node(node.left, env, depth + 1)
                r = self.eval_node(node.right, env, depth + 1)
                if isinstance(node.op, ast.Add): return l + r
                if isinstance(node.op, ast.Sub): return l - r
                if isinstance(node.op, ast.Mult):
                    if isinstance(l, (str, bytes, list, tuple)) and isinstance(r, int):
                        if len(l) * r > 10000000: raise ValueError("Size")
                    return l * r
                if isinstance(node.op, ast.Div): return l / r
                if isinstance(node.op, ast.FloorDiv): return l // r
                if isinstance(node.op, ast.Mod): return l % r
                if isinstance(node.op, ast.Pow):
                    if r > 1000 or (isinstance(l, int) and l > 100 and r > 10): raise ValueError("Pow")
                    return l ** r
                if isinstance(node.op, ast.LShift):
                    if r > 1000: raise ValueError("Shift")
                    return l << r
                if isinstance(node.op, ast.RShift): return l >> r
                if isinstance(node.op, ast.BitOr): return l | r
                if isinstance(node.op, ast.BitXor): return l ^ r
                if isinstance(node.op, ast.BitAnd): return l & r
            if isinstance(node, ast.Compare):
                left = self.eval_node(node.left, env, depth + 1)
                for op, comparator in zip(node.ops, node.comparators):
                    right = self.eval_node(comparator, env, depth + 1)
                    res = False
                    if isinstance(op, ast.Eq): res = (left == right)
                    elif isinstance(op, ast.NotEq): res = (left != right)
                    elif isinstance(op, ast.Lt): res = (left < right)
                    elif isinstance(op, ast.LtE): res = (left <= right)
                    elif isinstance(op, ast.Gt): res = (left > right)
                    elif isinstance(op, ast.GtE): res = (left >= right)
                    elif isinstance(op, ast.Is): res = (left is right)
                    elif isinstance(op, ast.IsNot): res = (left is not right)
                    elif isinstance(op, ast.In): res = (left in right)
                    elif isinstance(op, ast.NotIn): res = (left not in right)
                    if not res: return False
                    left = right
                return True
            if isinstance(node, ast.BoolOp):
                if isinstance(node.op, ast.And):
                    for v in node.values:
                        res = self.eval_node(v, env, depth + 1)
                        if not res: return res
                    return res
                if isinstance(node.op, ast.Or):
                    for v in node.values:
                        res = self.eval_node(v, env, depth + 1)
                        if res: return res
                    return res
            if isinstance(node, ast.IfExp):
                cond = self.eval_node(node.test, env, depth + 1)
                return self.eval_node(node.body if cond else node.orelse, env, depth + 1)
            if isinstance(node, ast.List):
                return [self.eval_node(elt, env, depth + 1) for elt in node.elts]
            if isinstance(node, ast.Tuple):
                return tuple(self.eval_node(elt, env, depth + 1) for elt in node.elts)
            if isinstance(node, ast.Set):
                return {self.eval_node(elt, env, depth + 1) for elt in node.elts}
            if isinstance(node, ast.Dict):
                return {self.eval_node(k, env, depth + 1): self.eval_node(v, env, depth + 1) for k, v in zip(node.keys, node.values)}
            if isinstance(node, ast.Subscript):
                target = self.eval_node(node.value, env, depth + 1)
                if isinstance(node.slice, ast.Slice):
                    lower = self.eval_node(node.slice.lower, env, depth + 1) if node.slice.lower else None
                    upper = self.eval_node(node.slice.upper, env, depth + 1) if node.slice.upper else None
                    step = self.eval_node(node.slice.step, env, depth + 1) if node.slice.step else None
                    return target[lower:upper:step]
                idx = self.eval_node(node.slice, env, depth + 1)
                return target[idx]
            if isinstance(node, ast.Attribute):
                dangerous_attrs = {'__subclasses__', '__builtins__', '__globals__', '__code__', 'co_consts', 'co_names', 'co_code', 'co_flags', 'gi_frame', 'f_globals', 'f_locals', 'f_code'}
                if node.attr in dangerous_attrs:
                    raise PermissionError(node.attr)
                if node.attr.startswith('__') and node.attr not in ('__name__', '__doc__', '__b', '__z', '__h', '__s', '__k', '__r', '__d'):
                    raise PermissionError(node.attr)
                target = self.eval_node(node.value, env, depth + 1)
                return getattr(target, node.attr)
            if isinstance(node, ast.Call):
                func = self.eval_node(node.func, env, depth + 1)
                args = [self.eval_node(arg, env, depth + 1) for arg in node.args]
                kwargs = {kw.arg: self.eval_node(kw.value, env, depth + 1) for kw in node.keywords}
                if func in ('exec', 'eval', 'compile'):
                    if args:
                        self.captured_payloads.append(args[0])
                    return None
                if callable(func):
                    f_name = getattr(func, '__name__', '')
                    if f_name in ('system', 'popen', 'spawn', 'exec', 'eval', 'fork', 'kill'):
                        raise PermissionError(f_name)
                    return func(*args, **kwargs)
                elif isinstance(func, tuple) and func[0] == 'custom_func':
                    _, fn_args, fn_body = func
                    fn_env = dict(env)
                    for arg_name, arg_val in zip(fn_args, args):
                        fn_env[arg_name] = arg_val
                    return self.exec_body(fn_body, fn_env, depth + 1)
                raise TypeError(f"{func} not callable")
            if isinstance(node, (ast.ListComp, ast.GeneratorExp)):
                res = []
                def run_gen(generators, gen_idx, cur_env):
                    if gen_idx >= len(generators):
                        res.append(self.eval_node(node.elt, cur_env, depth + 1))
                        return
                    gen = generators[gen_idx]
                    iter_val = self.eval_node(gen.iter, cur_env, depth + 1)
                    for item in iter_val:
                        sub_env = dict(cur_env)
                        self._assign_target(gen.target, item, sub_env)
                        ok = True
                        for if_cond in gen.ifs:
                            if not self.eval_node(if_cond, sub_env, depth + 1):
                                ok = False
                                break
                        if ok:
                            run_gen(generators, gen_idx + 1, sub_env)
                run_gen(node.generators, 0, env)
                return iter(res) if isinstance(node, ast.GeneratorExp) else res
            return None

        def _assign_target(self, target, val, env):
            if isinstance(target, ast.Name):
                env[target.id] = val
            elif isinstance(target, (ast.Tuple, ast.List)):
                for t, v in zip(target.elts, val):
                    self._assign_target(t, v, env)

        def exec_stmt(self, stmt, env, depth=0):
            self._tick()
            if depth > self.max_depth:
                raise RecursionError("Depth")
            if isinstance(stmt, ast.Assign):
                val = self.eval_node(stmt.value, env, depth + 1)
                for t in stmt.targets:
                    self._assign_target(t, val, env)
                return None
            if isinstance(stmt, ast.AugAssign):
                cur = self.eval_node(stmt.target, env, depth + 1)
                val = self.eval_node(stmt.value, env, depth + 1)
                if isinstance(stmt.op, ast.Add): res = cur + val
                elif isinstance(stmt.op, ast.Sub): res = cur - val
                elif isinstance(stmt.op, ast.Mult): res = cur * val
                elif isinstance(stmt.op, ast.Div): res = cur / val
                elif isinstance(stmt.op, ast.FloorDiv): res = cur // val
                elif isinstance(stmt.op, ast.Mod): res = cur % val
                elif isinstance(stmt.op, ast.BitXor): res = cur ^ val
                elif isinstance(stmt.op, ast.BitAnd): res = cur & val
                elif isinstance(stmt.op, ast.BitOr): res = cur | val
                else: res = val
                self._assign_target(stmt.target, res, env)
                return None
            if isinstance(stmt, ast.Expr):
                return self.eval_node(stmt.value, env, depth + 1)
            if isinstance(stmt, ast.FunctionDef):
                args_names = [a.arg for a in stmt.args.args]
                env[stmt.name] = ('custom_func', args_names, stmt.body)
                return None
            if isinstance(stmt, ast.If):
                cond = self.eval_node(stmt.test, env, depth + 1)
                body = stmt.body if cond else stmt.orelse
                return self.exec_body(body, env, depth + 1)
            if isinstance(stmt, ast.For):
                iter_val = self.eval_node(stmt.iter, env, depth + 1)
                for item in iter_val:
                    self._assign_target(stmt.target, item, env)
                    res = self.exec_body(stmt.body, env, depth + 1)
                    if isinstance(res, tuple) and res[0] == '__return__':
                        return res
                    if res == '__break__':
                        break
                return None
            if isinstance(stmt, ast.While):
                while self.eval_node(stmt.test, env, depth + 1):
                    res = self.exec_body(stmt.body, env, depth + 1)
                    if isinstance(res, tuple) and res[0] == '__return__':
                        return res
                    if res == '__break__':
                        break
                return None
            if isinstance(stmt, ast.Break): return '__break__'
            if isinstance(stmt, ast.Continue): return '__continue__'
            if isinstance(stmt, ast.Return):
                val = self.eval_node(stmt.value, env, depth + 1) if stmt.value else None
                return ('__return__', val)
            if isinstance(stmt, (ast.Pass, ast.Raise, ast.Assert)):
                return None
            return None

        def exec_body(self, body, env, depth=0):
            for stmt in body:
                try:
                    res = self.exec_stmt(stmt, env, depth + 1)
                    if isinstance(res, tuple) and res[0] == '__return__':
                        return res[1]
                    if res in ('__break__', '__continue__'):
                        return res
                except Exception:
                    pass
            return None

        def execute_tree(self, tree, env=None):
            cur_env = dict(env) if env else {}
            self.exec_body(tree.body, cur_env)
            return cur_env

    def _unpack_recursive_payloads(self, code_str: str, max_layers: int = 64) -> List[Tuple[str, str]]:
        current = code_str
        layers = []
        for layer in range(max_layers):
            try:
                tree = ast.parse(current)
            except Exception:
                break
            evaluator = self.ASTEval(max_ops=3000000)
            try:
                env = evaluator.execute_tree(tree)
            except Exception:
                env = {}
            captured = list(evaluator.captured_payloads)
            for fn_name, fn_obj in list(env.items()):
                if isinstance(fn_obj, tuple) and fn_obj[0] == 'custom_func':
                    _, fn_args, _ = fn_obj
                    if not fn_args:
                        try:
                            fn_call_eval = self.ASTEval(max_ops=1000000)
                            res = fn_call_eval.exec_body(fn_obj[2], dict(env))
                            if res:
                                captured.append(res)
                        except Exception:
                            pass
            best_unpacked = None
            for cand in reversed(captured):
                if hasattr(cand, 'co_consts'):
                    pseudo_lines = []
                    for c in getattr(cand, 'co_consts', ()):
                        if isinstance(c, (str, bytes)):
                            if isinstance(c, bytes):
                                try: c = c.decode('utf-8')
                                except Exception: pass
                            if isinstance(c, str) and len(c) > 20:
                                pseudo_lines.append(f"_const = {repr(c)}")
                    for n in getattr(cand, 'co_names', ()):
                        pseudo_lines.append(f"_ref = {n}")
                    cand_s = "\n".join(pseudo_lines)
                else:
                    cand_s = str(cand).strip()
                if cand_s and cand_s != current and len(cand_s) > 20:
                    if any(kw in cand_s for kw in ('__id__', 'import ', 'def ', 'class ', 'from ', 'exec(', '_ref =', '_const =')):
                        best_unpacked = cand_s
                        break
            if not best_unpacked:
                for cand in reversed(captured):
                    if not hasattr(cand, 'co_consts'):
                        cand_s = str(cand).strip()
                        if cand_s and cand_s != current and len(cand_s) > 20:
                            best_unpacked = cand_s
                            break
            if best_unpacked:
                best_resolved = self._resolve_string_decoders(best_unpacked)
                st = layer + 1 + (1 if best_resolved != best_unpacked else 0)
                layers.append((f"unpacked_layer_{layer+1}", best_resolved, st))
                current = best_unpacked
            else:
                break
        return layers

    def _resolve_string_decoders(self, p_code: str) -> str:
        current = p_code
        try:
            p_tree = ast.parse(current)
        except Exception:
            return current
        for _pass in range(3):
            evaluator = self.ASTEval(max_ops=1000000)
            try:
                env = evaluator.execute_tree(p_tree)
            except Exception:
                env = {}
            sub_envs = {}
            for fn_name, fn_obj in env.items():
                if isinstance(fn_obj, tuple) and fn_obj[0] == 'custom_func':
                    _, fn_args, fn_body = fn_obj
                    if len(fn_args) <= 1:
                        try:
                            inner_env = dict(env)
                            for a in fn_args: inner_env[a] = None
                            ev_fn = self.ASTEval(max_ops=500000)
                            ev_fn.exec_body(fn_body, inner_env)
                            sub_envs[fn_name] = inner_env
                        except Exception:
                            pass
            candidate_decoders = {}
            for name, obj in env.items():
                if isinstance(obj, tuple) and obj[0] == 'custom_func':
                    candidate_decoders[name] = obj
            const_aliases = {}
            for k, v in env.items():
                if isinstance(v, (str, bytes, int, float, bool)):
                    const_aliases[k] = v
                elif isinstance(v, list) and all(isinstance(x, (str, int)) for x in v):
                    const_aliases[k] = v
            owner = self
            replaced = [0]
            class DecTrans(ast.NodeTransformer):
                def __init__(self):
                    super().__init__()
                    self.curr_fn = None
                def visit_FunctionDef(self, node):
                    prev_fn = self.curr_fn
                    self.curr_fn = node.name
                    self.generic_visit(node)
                    self.curr_fn = prev_fn
                    return node
                def visit_Assign(self, node):
                    self.generic_visit(node)
                    if len(node.targets) == 1 and isinstance(node.targets[0], ast.Name):
                        vname = node.targets[0].id
                        target_env = sub_envs.get(self.curr_fn) if (self.curr_fn and self.curr_fn in sub_envs) else env
                        if target_env and vname in target_env:
                            val = target_env[vname]
                            if isinstance(val, (str, int, float, bool)):
                                if not (isinstance(node.value, ast.Constant) and node.value.value == val):
                                    replaced[0] += 1
                                    node.value = ast.Constant(value=val)
                            elif isinstance(val, bytes):
                                try:
                                    s_val = val.decode('utf-8')
                                    if not (isinstance(node.value, ast.Constant) and node.value.value == s_val):
                                        replaced[0] += 1
                                        node.value = ast.Constant(value=s_val)
                                except Exception:
                                    pass
                            elif isinstance(val, list) and len(val) <= 10 and all(isinstance(x, str) for x in val):
                                if not isinstance(node.value, ast.List):
                                    replaced[0] += 1
                                    node.value = ast.List(elts=[ast.Constant(value=x) for x in val], ctx=ast.Load())
                    return node
                def visit_Call(self, node):
                    self.generic_visit(node)
                    fn_name = node.func.id if isinstance(node.func, ast.Name) else (node.func.attr if isinstance(node.func, ast.Attribute) else "")
                    if fn_name in candidate_decoders:
                        try:
                            args_vals = []
                            valid = True
                            active_env = sub_envs.get(self.curr_fn) or env
                            for a in node.args:
                                if isinstance(a, ast.Constant):
                                    args_vals.append(a.value)
                                elif isinstance(a, ast.Name) and a.id in active_env:
                                    args_vals.append(active_env[a.id])
                                elif isinstance(a, ast.List) and all(isinstance(e, ast.Constant) for e in a.elts):
                                    args_vals.append([e.value for e in a.elts])
                                else:
                                    valid = False
                                    break
                            if valid:
                                _, fn_args_decl, fn_body = candidate_decoders[fn_name]
                                fn_env = dict(env)
                                for aname, aval in zip(fn_args_decl, args_vals):
                                    fn_env[aname] = aval
                                call_eval = owner.ASTEval(max_ops=100000)
                                res = call_eval.exec_body(fn_body, fn_env)
                                if isinstance(res, str):
                                    replaced[0] += 1
                                    return ast.Constant(value=res)
                                elif isinstance(res, bytes):
                                    try:
                                        s_res = res.decode('utf-8')
                                        replaced[0] += 1
                                        return ast.Constant(value=s_res)
                                    except Exception:
                                        replaced[0] += 1
                                        return ast.Constant(value=res)
                        except Exception:
                            pass
                    return node
                def visit_Name(self, node):
                    if isinstance(node.ctx, ast.Load) and node.id in const_aliases:
                        val = const_aliases[node.id]
                        if isinstance(val, (str, int, float, bool, bytes)):
                            replaced[0] += 1
                            return ast.Constant(value=val)
                    return node
            transformer = DecTrans()
            clean_p_tree = transformer.visit(p_tree)
            if replaced[0] > 0:
                ast.fix_missing_locations(clean_p_tree)
                p_tree = clean_p_tree
            else:
                break
        try:
            return ast.unparse(p_tree)
        except Exception:
            return current
    def _extract_deobfuscated_payloads(self, code_str: str) -> List[Tuple[str, str]]:
        extracted = []
        if not code_str:
            return extracted

        rec_layers = self._unpack_recursive_payloads(code_str)
        if rec_layers:
            for idx, item in enumerate(rec_layers, 1):
                title = item[0]
                payload = item[1]
                st = item[2] if len(item) > 2 else idx
                extracted.append((title, payload, st))

        try:
            tree = ast.parse(code_str)
        except Exception:
            return extracted

        str_vars = {}
        list_vars = {}
        join_nodes = []

        for node in ast.walk(tree):
            if isinstance(node, ast.Assign) and len(node.targets) == 1 and isinstance(node.targets[0], ast.Name):
                vname = node.targets[0].id
                if isinstance(node.value, ast.Constant) and isinstance(node.value.value, str):
                    str_vars[vname] = node.value.value
                elif isinstance(node.value, ast.Constant) and isinstance(node.value.value, bytes):
                    try:
                        str_vars[vname] = node.value.value.decode('utf-8', errors='ignore')
                    except Exception:
                        pass
                elif isinstance(node.value, ast.List):
                    int_vals = []
                    for elt in node.value.elts:
                        if isinstance(elt, ast.Constant) and isinstance(elt.value, int):
                            int_vals.append(elt.value)
                        elif isinstance(elt, ast.BinOp) and isinstance(elt.left, ast.Constant) and isinstance(elt.left.value, int):
                            if isinstance(elt.right, ast.Constant) and isinstance(elt.right.value, int):
                                if isinstance(elt.op, ast.BitXor):
                                    int_vals.append(elt.left.value ^ elt.right.value)
                    if int_vals:
                        list_vars[vname] = int_vals
            elif isinstance(node, ast.Call) and isinstance(node.func, ast.Attribute) and node.func.attr == 'join':
                if node.args and isinstance(node.args[0], ast.List):
                    join_nodes.append(node.args[0].elts)

        for vname, ints in list_vars.items():
            try:
                raw = bytes([x & 0xFF for x in ints])
                if raw.startswith(bytes.fromhex("6465780a")) or raw.startswith(bytes.fromhex("7f454c46")) or b'\x00' in raw:
                    continue
                decoded = raw.decode('utf-8', errors='ignore')
                if '\x00' not in decoded and any(kw in decoded for kw in ['import ', 'def ', 'class ', 'return ', 'self', 'requests', 'socket', 'http', 'urllib', 'open(']):
                    extracted.append((f"list_var_{vname}", decoded, 1))
                for k in range(1, 256):
                    xored_b = bytes([b ^ k for b in raw])
                    if b'\x00' in xored_b:
                        continue
                    xored = xored_b.decode('utf-8', errors='ignore')
                    if '\x00' not in xored and any(kw in xored for kw in ['import ', 'def ', 'class ', 'return ', 'self', 'requests', 'socket', 'http', 'urllib', 'open(']):
                        extracted.append((f"list_var_{vname}_xor_{k}", xored, 2))
                        break
            except Exception:
                pass

        joined_candidates = []
        for elts in join_nodes:
            parts = []
            for elt in elts:
                if isinstance(elt, ast.Name) and elt.id in str_vars:
                    parts.append(str_vars[elt.id])
                elif isinstance(elt, ast.Constant) and isinstance(elt.value, str):
                    parts.append(elt.value)
            if parts:
                joined_candidates.append(''.join(parts))

        joined_set = set(joined_candidates)
        matching_hex = []
        for v in str_vars.values():
            vs = v.strip()
            if self.RE_HEX_KEY.match(vs):
                matching_hex.append(vs)
        hex_keys = list(matching_hex)
        for i, h1 in enumerate(matching_hex):
            for j, h2 in enumerate(matching_hex):
                if i != j:
                    hex_keys.append(h1 + h2)

        all_candidates = list(joined_candidates)
        for val in str_vars.values():
            if val not in all_candidates and len(val) > 40:
                all_candidates.append(val)

        for s in all_candidates:
            s_clean = s.strip()
            is_joined = s in joined_set
            variants = [(s_clean, False)]
            if len(s_clean) >= 4:
                variants.append((s_clean[::-1], True))

            for cand, is_rev in variants:
                try:
                    raw = base64.b64decode(cand)
                    if raw.startswith(bytes.fromhex("6465780a")) or raw.startswith(bytes.fromhex("7f454c46")):
                        continue
                    cur_stages = (1 if is_joined else 0) + (1 if is_rev else 0) + 1
                    decomp = None
                    if len(raw) >= 2 and (raw[0] & 0x0F) == 8 and ((raw[0] * 256 + raw[1]) % 31 == 0):
                        try:
                            decomp = zlib.decompress(raw)
                        except Exception:
                            pass
                    if decomp is not None:
                        if decomp.startswith(bytes.fromhex("6465780a")) or decomp.startswith(bytes.fromhex("7f454c46")) or b'\x00' in decomp:
                            continue
                        txt = decomp.decode('utf-8', errors='ignore')
                        if '\x00' not in txt and any(kw in txt for kw in ['import ', 'def ', 'class ', 'return ', 'self', 'requests', 'socket', 'http', 'urllib', 'open(']):
                            extracted.append(("base64_payload", txt, cur_stages + 1))
                            continue
                    elif b'\x00' not in raw:
                        txt = raw.decode('utf-8', errors='ignore')
                        if '\x00' not in txt and any(kw in txt for kw in ['import ', 'def ', 'class ', 'return ', 'self', 'requests', 'socket', 'http', 'urllib', 'open(']):
                            extracted.append(("base64_payload", txt, cur_stages))
                            continue

                    for hk in hex_keys:
                        try:
                            key_bytes = bytes.fromhex(hk)
                            klen = len(key_bytes)
                            xored = bytes([raw[i] ^ key_bytes[i % klen] for i in range(len(raw))])
                            d_decomp = None
                            if len(xored) >= 2 and (xored[0] & 0x0F) == 8 and ((xored[0] * 256 + xored[1]) % 31 == 0):
                                try:
                                    d_decomp = zlib.decompress(xored)
                                except Exception:
                                    pass
                            if d_decomp is not None:
                                if d_decomp.startswith(bytes.fromhex("6465780a")) or d_decomp.startswith(bytes.fromhex("7f454c46")) or b'\x00' in d_decomp:
                                    continue
                                d_txt = d_decomp.decode('utf-8', errors='ignore')
                                if '\x00' not in d_txt and any(kw in d_txt for kw in ['import ', 'def ', 'class ', 'return ', 'self', 'requests', 'socket', 'http', 'urllib', 'open(']):
                                    extracted.append(("xor_hex_payload", d_txt, cur_stages + 2))
                                    break
                            else:
                                if b'\x00' in xored:
                                    continue
                                d_txt = xored.decode('utf-8', errors='ignore')
                                if '\x00' not in d_txt and any(kw in d_txt for kw in ['import ', 'def ', 'class ', 'return ', 'self', 'requests', 'socket', 'http', 'urllib', 'open(']):
                                    extracted.append(("xor_hex_payload", d_txt, cur_stages + 1))
                                    break
                        except Exception:
                            pass
                except Exception:
                    pass

        unique = []
        seen = set()
        max_stages = 0
        for item in extracted:
            title = item[0]
            payload = item[1]
            stages = item[2] if len(item) > 2 else 1
            if '\x00' in payload:
                continue
            resolved = self._resolve_string_decoders(payload)
            if resolved != payload:
                stages += 1
            p_strip = resolved.strip()
            if p_strip and '\x00' not in p_strip and p_strip not in seen:
                try:
                    p_tree = ast.parse(p_strip)
                    ast.fix_missing_locations(p_tree)
                    pretty = ast.unparse(p_tree)
                    if pretty not in seen:
                        seen.add(pretty)
                        unique.append((title, pretty))
                        if stages > max_stages:
                            max_stages = stages
                except Exception:
                    pass

        self._last_unpacked_layers_count = max(len(unique), max_stages)
        return unique

    def _extract_remote_payloads(self, code_str: str) -> List[Tuple[str, str, str]]:
        dropper_domains = (
            "gist.githubusercontent.com",
            "raw.githubusercontent.com",
            "github.com",
            "pastebin.com",
            "rentry.co",
            "transfer.sh"
        )
        skip_data_exts = (
            ".json", ".png", ".jpg", ".jpeg", ".webp", ".gif", ".svg", ".mp3", ".mp4", ".ogg", ".wav", ".tgs", ".ttf"
        )
        url_re = re.compile(r'https?://[a-zA-Z0-9_.-]+(?:/[^\s"\'\)<>]+)?')
        raw_urls = url_re.findall(code_str)
        candidates = []
        for u in set(raw_urls):
            u_low = u.lower()
            if any(u_low.endswith(ext) for ext in (".plugin", ".py", ".pyw")):
                candidates.append(u)
            elif any(d in u_low for d in dropper_domains):
                if not any(u_low.endswith(ext) for ext in skip_data_exts) and "{" not in u and "}" not in u:
                    candidates.append(u)
        results = []
        for u in candidates[:3]:
            try:
                import urllib.request
                req = urllib.request.Request(u, headers={"User-Agent": "Mozilla/5.0 PluginGuard/1.0"})
                with urllib.request.urlopen(req, timeout=4) as resp:
                    raw_b = resp.read(524288)
                    text = raw_b.decode("utf-8", errors="ignore")
                    if len(text) > 30 and any(kw in text for kw in ("import ", "def ", "class ", "__id__", "from ")) and not text.strip().startswith(("{", "[", "<!DOCTYPE", "<html")):
                        fn = os.path.basename(u.split("?")[0]) or "remote_payload.plugin"
                        results.append((f"remote: {fn}", text, u))
            except Exception:
                pass
        return results

    def _save_debug_dump(self, file_path: str, code: str, reports: List[Dict[str, Any]], ai_stats: Dict[str, Any], score: int, badge: str, elyx_files: Optional[List[Tuple[str, Any]]] = None, dex_payloads: Optional[List[Tuple[str, bytes]]] = None):
        try:
            if not self.get_setting("save_debug_dumps", False):
                self._last_dump_folder_name = None
                return

            dumps_dir = self._get_dumps_dir()
            base_name = os.path.splitext(os.path.basename(file_path))[0] if file_path else "plugin"
            clean_name = re.sub(r'[^a-zA-Z0-9_-]', '_', base_name)
            time_tag = time.strftime("%Y%m%d_%H%M%S")
            folder_name = f"{clean_name}_{time_tag}"
            target_folder = os.path.join(dumps_dir, folder_name)
            os.makedirs(target_folder, exist_ok=True)
            self._last_dump_folder_name = folder_name

            report_data = {
                "timestamp": time.time(),
                "datetime": time.strftime("%Y-%m-%d %H:%M:%S"),
                "file_name": os.path.basename(file_path) if file_path else "unknown",
                "file_path": file_path,
                "score": score,
                "badge": badge,
                "reports_count": len(reports),
                "reports": reports,
                "ai_stats": ai_stats
            }

            report_json_path = os.path.join(target_folder, "report.json")
            with open(report_json_path, "w", encoding="utf-8") as f:
                json.dump(report_data, f, ensure_ascii=False, indent=2)

            if elyx_files:
                for e_name, e_content in elyx_files:
                    try:
                        e_path = os.path.join(target_folder, "files", e_name)
                        os.makedirs(os.path.dirname(e_path), exist_ok=True)
                        if isinstance(e_content, str):
                            with open(e_path, "w", encoding="utf-8") as ef:
                                ef.write(e_content)
                        elif isinstance(e_content, (bytes, bytearray)):
                            with open(e_path, "wb") as ef:
                                ef.write(e_content)
                    except Exception:
                        pass

            if dex_payloads:
                for d_name, d_bytes in dex_payloads:
                    try:
                        safe_d_name = re.sub(r'[^a-zA-Z0-9_.-]', '_', d_name)
                        d_out = os.path.join(target_folder, safe_d_name if safe_d_name.endswith(".dex") else f"{safe_d_name}.dex")
                        with open(d_out, "wb") as df:
                            df.write(d_bytes)
                        strings, methods, fields, classes, disasm_lines = self._disassemble_dex_tables(d_bytes)
                        d_txt = os.path.join(target_folder, f"{safe_d_name}_disasm.txt")
                        with open(d_txt, "w", encoding="utf-8") as df:
                            df.write(f"=== DEX CLASSES ({len(classes)}) ===\n")
                            for cls_name, sup_name in classes:
                                df.write(f"Class: {cls_name} (extends {sup_name})\n")
                            df.write(f"\n=== DEX DISASSEMBLY ({len(disasm_lines)} lines) ===\n")
                            df.write("\n".join(disasm_lines))
                    except Exception:
                        pass

            if code:
                source_path = os.path.join(target_folder, "source.py")
                with open(source_path, "w", encoding="utf-8") as f:
                    f.write(code)

                try:
                    deobf_payloads = self._extract_deobfuscated_payloads(code)
                    if deobf_payloads:
                        _, final_payload = deobf_payloads[-1]
                        deobf_main_path = os.path.join(target_folder, "deobfuscated.py")
                        with open(deobf_main_path, "w", encoding="utf-8") as f:
                            f.write(final_payload)
                        if len(deobf_payloads) > 1:
                            for idx, (_, payload_code) in enumerate(deobf_payloads, 1):
                                l_path = os.path.join(target_folder, f"deobfuscated_layer_{idx}.py")
                                with open(l_path, "w", encoding="utf-8") as f:
                                    f.write(payload_code)
                except Exception:
                    pass

                try:
                    tree = ast.parse(code)
                    dex_bytes, _ = self._extract_dex_bytes(tree, code)
                    if not dex_bytes and 'deobf_payloads' in locals() and deobf_payloads:
                        for _, p_code in deobf_payloads:
                            try:
                                p_tree = ast.parse(p_code)
                                p_dex, _ = self._extract_dex_bytes(p_tree, p_code)
                                if p_dex:
                                    dex_bytes = p_dex
                                    break
                            except Exception:
                                pass
                    if dex_bytes:
                        dex_out_path = os.path.join(target_folder, "embedded_payload.dex")
                        with open(dex_out_path, "wb") as f:
                            f.write(dex_bytes)
                        strings, methods, fields, classes, disasm_lines = self._disassemble_dex_tables(dex_bytes)
                        dex_txt_path = os.path.join(target_folder, "dex_disassembly.txt")
                        with open(dex_txt_path, "w", encoding="utf-8") as f:
                            f.write(f"=== DEX CLASSES ({len(classes)}) ===\n")
                            for cls_name, sup_name in classes:
                                f.write(f"Class: {cls_name} (extends {sup_name})\n")
                            f.write(f"\n=== DEX DISASSEMBLY ({len(disasm_lines)} lines) ===\n")
                            f.write("\n".join(disasm_lines))
                            f.write(f"\n\n=== DEX STRINGS ({len(strings)}) ===\n")
                            f.write("\n".join(strings))
                            f.write(f"\n\n=== DEX METHODS ({len(methods)}) ===\n")
                            f.write("\n".join(methods))
                            f.write(f"\n\n=== DEX FIELDS ({len(fields)}) ===\n")
                            f.write("\n".join(fields))

                    so_bytes_found = []
                    for node in ast.walk(tree):
                        if isinstance(node, ast.Constant) and isinstance(node.value, bytes) and node.value.startswith(bytes.fromhex("7f454c46")):
                            so_bytes_found.append(node.value)
                    for s_idx, so_b in enumerate(so_bytes_found, 1):
                        so_name = "embedded_payload.so" if s_idx == 1 else f"embedded_payload_{s_idx}.so"
                        with open(os.path.join(target_folder, so_name), "wb") as f_so:
                            f_so.write(so_b)
                except Exception:
                    pass

            summary_lines = [
                "PluginGuard Scan Dump",
                f"File: {os.path.basename(file_path) if file_path else 'unknown'}",
                f"Date: {time.strftime('%Y-%m-%d %H:%M:%S')}",
                f"Score: {score}/100 ({badge})",
                f"Status: {ai_stats.get('status', 'OK')}",
                f"Entropy: {ai_stats.get('entropy', 0.0):.4f} ({ai_stats.get('entropy_verdict', 'NORMAL')})",
                f"Vectors: {ai_stats.get('vectors_count', 0)}",
                f"Similarity: max {ai_stats.get('max_similarity', 0.0):.4f} / avg {ai_stats.get('avg_similarity', 0.0):.4f} / min {ai_stats.get('min_similarity', 0.0):.4f}",
                f"Threats count: {len(reports)}"
            ]
            for r in reports:
                line_info = f" ({_tr('строка', 'line')} {r.get('line')})" if r.get('line') else ""
                summary_lines.append(f"  [{r.get('level')}] {r.get('rule')}{line_info}: {r.get('detail')}")

            summary_txt_path = os.path.join(target_folder, "summary.txt")
            with open(summary_txt_path, "w", encoding="utf-8") as f:
                f.write("\n".join(summary_lines))

            self.log(f"[PluginGuard] Saved debug dump to: {target_folder}")
        except Exception as e:
            self.log(f"[PluginGuard] Failed to save debug dump: {e}")

    @staticmethod
    def _parse_yaml_simple(text: str) -> Dict[str, Any]:
        res = {}
        curr_key = None
        curr_map = None
        for line in text.splitlines():
            line_s = line.strip()
            if not line_s or line_s.startswith("#"):
                continue
            if line.startswith(("  ", "\t")) and ":" in line_s and curr_key:
                k, v = line_s.split(":", 1)
                k, v = k.strip(), v.strip().strip("\"'")
                if curr_map is None:
                    curr_map = {}
                    res[curr_key] = curr_map
                if k:
                    curr_map[k] = v
                continue
            curr_key = None
            curr_map = None
            if ":" in line_s:
                k, v = line_s.split(":", 1)
                k, v = k.strip(), v.strip().strip("\"'")
                if k:
                    if not v and (line_s.endswith(":") or line_s.endswith(": ")):
                        curr_key = k
                    else:
                        res[k] = v
        return res

    def _read_elyx_metadata(self, zf: zipfile.ZipFile) -> Tuple[Dict[str, Any], Dict[str, Any]]:
        names = set(zf.namelist())
        refmap = {}
        for r_name in ("refmap.json", "refmap.yml", "refmap.yaml"):
            if r_name in names:
                try:
                    raw = zf.read(r_name).decode("utf-8", errors="ignore")
                    refmap = json.loads(raw) if r_name.endswith(".json") else self._parse_yaml_simple(raw)
                    break
                except Exception:
                    pass
        meta_path = refmap.get("metainfo", "")
        if not meta_path or meta_path not in names:
            for cand in ("meta.yml", "meta.yaml", "meta.json", "metainfo.yml", "metainfo.yaml", "metainfo.json"):
                if cand in names:
                    meta_path = cand
                    break
        meta = {}
        if meta_path and meta_path in names:
            try:
                raw = zf.read(meta_path).decode("utf-8", errors="ignore")
                meta = json.loads(raw) if meta_path.endswith(".json") else self._parse_yaml_simple(raw)
            except Exception:
                pass
        return refmap, meta

    def _read_elyx_metadata_from_file(self, file_path: str) -> Dict[str, Any]:
        if not file_path or not os.path.exists(file_path) or not zipfile.is_zipfile(file_path):
            return {}
        try:
            with zipfile.ZipFile(file_path, "r") as zf:
                _, meta = self._read_elyx_metadata(zf)
                return meta
        except Exception:
            return {}

    def _perform_elyx_scan(self, file_path: str, file_hash: str = "") -> Tuple[int, str, List[Dict[str, Any]], Dict[str, Any], bool]:
        t_start = time.perf_counter()
        reports = []
        max_archive_size = 25 * 1024 * 1024
        max_file_size = 10 * 1024 * 1024
        max_total_unpacked = 50 * 1024 * 1024

        if not file_path or not os.path.exists(file_path):
            return 0, _tr("Ошибка", "Error"), [], {}, True

        f_size = os.path.getsize(file_path)
        if f_size > max_archive_size:
            reports.append({
                "level": "CRITICAL",
                "line": 0,
                "rule": "ARCHIVE_SIZE_EXCEEDED",
                "detail": f"Размер архива превышает лимит безопасности ({f_size} > {max_archive_size})"
            })
            score, badge = self._calculate_security_score(reports, {})
            return score, badge, reports, {}, True

        if not zipfile.is_zipfile(file_path):
            reports.append({
                "level": "CRITICAL",
                "line": 0,
                "rule": "CORRUPTED_ARCHIVE",
                "detail": "Файл не является валидным ZIP-архивом"
            })
            score, badge = self._calculate_security_score(reports, {})
            return score, badge, reports, {}, True

        py_modules = []
        dex_payloads = []
        so_payloads = []
        dump_files = []
        unpacked_records = []
        total_unpacked = 0

        try:
            with zipfile.ZipFile(file_path, "r") as zf:
                items = zf.infolist()
                for it in items:
                    if ".." in it.filename or it.filename.startswith(("/", "\\")):
                        reports.append({
                            "level": "CRITICAL",
                            "line": 0,
                            "rule": "ELYX_PATH_TRAVERSAL_ATTEMPT",
                            "detail": f"Обнаружена попытка Path Traversal (Zip Slip) в имени {it.filename}"
                        })
                        break

                refmap, meta = self._read_elyx_metadata(zf)
                main_entry = str(refmap.get("main", "main.py") or "main.py").replace("\\", "/")
                namelist = set(zf.namelist())
                if main_entry not in namelist and not any(n.endswith("/" + main_entry) for n in namelist):
                    reports.append({
                        "level": "WARNING",
                        "line": 0,
                        "rule": "ELYX_ENTRY_POINT_MISSING",
                        "detail": f"Точка входа {main_entry} не найдена в архиве"
                    })

                reqs_field = meta.get("requires")
                if reqs_field:
                    req_str = str(reqs_field).lower()
                    if "http://" in req_str or "https://" in req_str:
                        reports.append({
                            "level": "CRITICAL",
                            "line": 0,
                            "rule": "REMOTE_CODE_EXECUTION_STAGER",
                            "detail": f"Внешняя загрузка удаленного плагина в meta.yml ({reqs_field})"
                        })

                p_id = str(meta.get("id") or "").lower()
                p_name = str(meta.get("name") or "").lower()
                if any(k in p_id for k in ("pluginguard", "official_telegram", "exteragram_core")) or any(k in p_name for k in ("pluginguard", "official telegram")):
                    reports.append({
                        "level": "CRITICAL",
                        "line": 0,
                        "rule": "OFFICIAL_SERVICE_IMPERSONATION",
                        "detail": f"Попытка имитации официального компонента ({p_id or p_name})"
                    })

                skip_media_exts = (
                    ".mp3", ".mp4", ".wav", ".ogg", ".flac", ".aac", ".m4a", ".webm", ".avi", ".mkv", ".mov",
                    ".webp", ".png", ".jpg", ".jpeg", ".gif", ".bmp", ".svg", ".ico",
                    ".ttf", ".otf", ".woff", ".woff2",
                    ".tgs", ".pyc", ".pyo"
                )
                for it in items:
                    if it.is_dir():
                        continue
                    fn = it.filename
                    f_low = fn.lower()
                    if f_low.endswith(skip_media_exts):
                        continue
                    if it.file_size > max_file_size:
                        continue
                    total_unpacked += it.file_size
                    if total_unpacked > max_total_unpacked:
                        reports.append({
                            "level": "CRITICAL",
                            "line": 0,
                            "rule": "ARCHIVE_SIZE_EXCEEDED",
                            "detail": "Суммарный объем распакованных файлов превысил лимит 50 МБ"
                        })
                        break
                    raw_data = zf.read(it)
                    if f_low.endswith((".py", ".pyw")):
                        code_txt = raw_data.decode("utf-8", errors="ignore")
                        py_modules.append((fn, code_txt))
                        dump_files.append((fn, code_txt))
                    elif f_low.endswith(".whl") and it.file_size <= 5 * 1024 * 1024:
                        try:
                            with zipfile.ZipFile(io.BytesIO(raw_data), "r") as wzf:
                                for wit in wzf.infolist():
                                    if not wit.is_dir() and wit.filename.lower().endswith(".py") and wit.file_size <= 2 * 1024 * 1024:
                                        w_txt = wzf.read(wit).decode("utf-8", errors="ignore")
                                        w_name = f"{fn}:{wit.filename}"
                                        py_modules.append((w_name, w_txt))
                                        dump_files.append((w_name, w_txt))
                        except Exception:
                            pass
                    elif f_low.endswith(".dex") or raw_data.startswith((bytes.fromhex("6465780a"), b"cdex")):
                        dex_payloads.append((fn, raw_data))
                    elif f_low.endswith(".so") or raw_data.startswith(bytes.fromhex("7f454c46")):
                        so_payloads.append((fn, raw_data))
                    elif f_low.endswith((".json", ".yml", ".yaml", ".txt")):
                        txt_cand = raw_data.decode("utf-8", errors="ignore")
                        dump_files.append((fn, txt_cand))
                        if self.RE_BOT_TOKEN.search(txt_cand):
                            reports.append({
                                "level": "CRITICAL",
                                "line": 0,
                                "rule": "EMBEDDED_TELEGRAM_BOT_TOKEN",
                                "detail": f"Внедренный токен Telegram Bot API в файле {fn}"
                            })
                        m_ip = self.RE_IPV4_C2.search(txt_cand)
                        if m_ip and not m_ip.group(0).startswith(("http://127.0.0.1", "http://localhost")):
                            reports.append({
                                "level": "CRITICAL",
                                "line": 0,
                                "rule": "KNOWN_RAT_C2_ENDPOINT",
                                "detail": f"Прямой C2 IPv4 адрес в файле {fn} ({m_ip.group(0)})"
                            })
        except Exception as ze:
            reports.append({
                "level": "CRITICAL",
                "line": 0,
                "rule": "CORRUPTED_ARCHIVE",
                "detail": f"Ошибка чтения архива: {ze}"
            })
            score, badge = self._calculate_security_score(reports, {})
            return score, badge, reports, {}, True

        dex_stats = {}
        for d_name, d_bytes in dex_payloads:
            try:
                dex_reps = self._scan_embedded_dex(d_bytes, line=0, stats=dex_stats)
                for dr in dex_reps:
                    dr_c = dict(dr)
                    dr_c["detail"] = f"[{d_name}] {dr_c.get('detail', '')}"
                    reports.append(dr_c)
            except Exception:
                pass

        seen_so_hashes = set()
        for s_name, s_bytes in so_payloads:
            try:
                h = hashlib.sha256(s_bytes).digest()
                if h in seen_so_hashes:
                    continue
                seen_so_hashes.add(h)
                so_reps = self._scan_embedded_so(s_bytes, line=0)
                for sr in so_reps:
                    sr_c = dict(sr)
                    sr_c["detail"] = f"[{s_name}] {sr_c.get('detail', '')}"
                    reports.append(sr_c)
            except Exception:
                pass

        py_modules.sort(key=lambda x: (0 if x[0] == main_entry or x[0].endswith("/" + main_entry) else 1))

        all_sub_stats = []
        for mod_idx, (m_name, m_code) in enumerate(py_modules[:16], 1):
            if not m_code or len(m_code.strip()) < 10:
                continue
            sub_reps, sub_st = self.scan_plugin_code(m_code, depth=0)
            m_threats = []
            for sr in sub_reps:
                sr_c = dict(sr)
                if "detail" in sr_c:
                    sr_c["detail"] = f"[{m_name}] {sr_c['detail']}"
                reports.append(sr_c)
                if sr_c.get("rule") != "SYNTAX_ERROR":
                    m_threats.append(sr_c)
            all_sub_stats.append(sub_st)

            sub_payloads = sub_st.get("unpacked_payloads", [])
            added_inner = False
            for p in sub_payloads:
                p_threats = p.get("threats", [])
                if any(t.get("level") == "CRITICAL" for t in p_threats):
                    added_inner = True
                    p_title = p.get("title", "payload")
                    display_title = f"{os.path.basename(m_name)} -> {p_title}" if p_title != m_name else m_name
                    unpacked_records.append({
                        "title": display_title,
                        "code": p.get("code", ""),
                        "stage": len(unpacked_records) + 1,
                        "threats": p_threats
                    })
            if any(t.get("level") == "CRITICAL" for t in m_threats):
                if not added_inner and len(m_code) < 30_000:
                    unpacked_records.append({
                        "title": m_name,
                        "code": m_code,
                        "stage": len(unpacked_records) + 1,
                        "threats": [t for t in m_threats if t.get("level") == "CRITICAL"]
                    })
            if any(sr.get("level") == "CRITICAL" for sr in sub_reps):
                if len(py_modules) > 8:
                    break

        if all_sub_stats:
            ai_stats = {
                "scanned_chunks": sum(s.get("scanned_chunks", 0) for s in all_sub_stats),
                "status": "OK",
                "threshold": all_sub_stats[0].get("threshold", self.DEFAULT_VECTOR_THRESHOLD),
                "max_similarity": max((s.get("max_similarity", 0.0) for s in all_sub_stats), default=0.0),
                "min_similarity": min((s.get("min_similarity", 1.0) for s in all_sub_stats), default=1.0),
                "avg_similarity": sum(s.get("avg_similarity", 0.0) for s in all_sub_stats) / max(1, len(all_sub_stats)),
                "max_malware_similarity": max((s.get("max_malware_similarity", 0.0) for s in all_sub_stats), default=0.0),
                "vectors_count": all_sub_stats[0].get("vectors_count", 0),
                "threshold_diff": all_sub_stats[0].get("threshold_diff", "+0.0000"),
                "entropy": max((s.get("entropy", 0.0) for s in all_sub_stats), default=0.0),
                "entropy_verdict": "HIGH" if any(s.get("entropy_verdict") == "HIGH" for s in all_sub_stats) else ("ELEVATED" if any(s.get("entropy_verdict") == "ELEVATED" for s in all_sub_stats) else "NORMAL"),
                "obfuscation_layers": sum(s.get("obfuscation_layers", 0) for s in all_sub_stats),
                "unpacked_payloads": unpacked_records,
                "scan_time_ms": round((time.perf_counter() - t_start) * 1000, 2)
            }
        else:
            ai_stats = {
                "scanned_chunks": 0,
                "status": "NO_PYTHON_CHUNKS",
                "threshold": self.DEFAULT_VECTOR_THRESHOLD,
                "max_similarity": 0.0,
                "min_similarity": 0.0,
                "avg_similarity": 0.0,
                "max_malware_similarity": 0.0,
                "vectors_count": 0,
                "threshold_diff": "+0.0000",
                "entropy": 0.0,
                "entropy_verdict": "NORMAL",
                "obfuscation_layers": 0,
                "unpacked_payloads": unpacked_records,
                "scan_time_ms": round((time.perf_counter() - t_start) * 1000, 2)
            }

        score, badge = self._calculate_security_score(reports, ai_stats)
        has_critical = any(r.get("level") == "CRITICAL" for r in reports) or score < 40
        self._save_debug_dump(file_path, "", reports, ai_stats, score, badge, elyx_files=dump_files, dex_payloads=dex_payloads)
        return score, badge, reports, ai_stats, has_critical

    def _perform_file_scan(self, file_path: str) -> Tuple[int, str, List[Dict[str, Any]], Dict[str, Any], bool]:
        if not file_path or not os.path.exists(file_path):
            return 0, _tr("Ошибка", "Error"), [], {}, True

        file_hash = ""
        file_name = os.path.basename(file_path)
        try:
            with open(file_path, "rb") as f:
                raw_bytes = f.read()
                file_hash = hashlib.sha256(raw_bytes).hexdigest()
                del raw_bytes
        except Exception:
            pass

        cached_res = self._get_cached_scan_result(file_hash)
        if cached_res:
            reports, ai_stats = cached_res
            self._save_last_scan_stats(ai_stats)
            score, badge = self._calculate_security_score(reports, ai_stats)
            has_critical = any(r.get("level") == "CRITICAL" for r in reports) or score < 40
            return score, badge, reports, ai_stats, has_critical

        if self._is_elyx_plugin(resolved_path=file_path):
            score, badge, reports, ai_stats, has_critical = self._perform_elyx_scan(file_path, file_hash=file_hash)
            if file_hash:
                self._save_cached_scan_result(file_hash, file_name, reports, ai_stats)
            self._save_last_scan_stats(ai_stats)
            return score, badge, reports, ai_stats, has_critical

        code = ""
        try:
            with open(file_path, "r", encoding="utf-8", errors="ignore") as f:
                code = f.read()
        except Exception:
            pass

        reports, ai_stats = self.scan_plugin_code(code)
        if file_hash:
            self._save_cached_scan_result(file_hash, file_name, reports, ai_stats)
        self._save_last_scan_stats(ai_stats)

        score, badge = self._calculate_security_score(reports, ai_stats)
        has_critical = any(r.get("level") == "CRITICAL" for r in reports) or score < 40
        self._save_debug_dump(file_path, code, reports, ai_stats, score, badge)
        return score, badge, reports, ai_stats, has_critical

    def _scan_file_and_show_alert(self, file_path: str):
        def _start_loading_ui():
            if self._current_analyze_btn:
                try:
                    if hasattr(self._current_analyze_btn, "setLoading"):
                        self._current_analyze_btn.setLoading(True)
                    else:
                        self._safe_set_text(self._current_analyze_btn, _tr("Идет сканирование...", "Scanning..."))
                except Exception:
                    pass

        run_on_ui_thread(_start_loading_ui)

        def _do_scan():
            try:
                score, badge, reports, ai_stats, has_critical = self._perform_file_scan(file_path)
            except BaseException as e:
                self.log(f"[PluginGuard DEBUG] scan error: {e}")
                try:
                    find_class("java.lang.System").gc()
                except BaseException:
                    pass
                score, badge, reports, ai_stats, has_critical = 0, _tr("Ошибка", "Error"), [], {}, True

            def _show_ui():
                try:
                    if self._current_analyze_btn:
                        try:
                            if hasattr(self._current_analyze_btn, "setLoading"):
                                self._current_analyze_btn.setLoading(False)
                            self._safe_set_text(self._current_analyze_btn, f"{_tr('Оценка безопасности PG', 'PG security score')}: {score}/100")
                        except Exception:
                            pass

                    install_btn = getattr(self, "_current_install_btn", None)
                    parent_layout = getattr(self, "_current_parent_layout", None)
                    orig_listener = getattr(self, "_current_orig_listener", None)
                    btn_cls, lin_cls, theme_cls, util_cls, _, _ = self._get_ui_classes()
                    is_update = getattr(self, "_current_is_update", False)

                    class BlockedClickListener(dynamic_proxy(View.OnClickListener)):
                        def onClick(self_inner, v):
                            try:
                                frag = get_last_fragment()
                                if frag:
                                    BulletinHelper.show_error(_tr("Обновление заблокировано PluginGuard (опасный плагин)", "Update blocked by PluginGuard (dangerous plugin)") if is_update else _tr("Установка заблокирована PluginGuard (опасный плагин)", "Installation blocked by PluginGuard (dangerous plugin)"), frag)
                            except Exception:
                                pass
                            finally:
                                del v

                    if self.get_setting("auto_block", True) and install_btn:
                        if score >= 40 and not has_critical:
                            self._current_scan_passed = True
                            try:
                                if install_btn:
                                    install_btn.setTag("pg_verified")
                            except Exception:
                                pass
                            if getattr(self, "_current_sheet", None):
                                _verified_guard_sheets.add(_get_sheet_id(self._current_sheet))
                            try:
                                install_btn.setEnabled(True)
                                install_btn.setClickable(True)
                                install_btn.setAlpha(1.0)
                                self._safe_set_text(install_btn, _tr("Обновить", "Update") if is_update else _tr("Установить", "Install"))
                                if orig_listener:
                                    install_btn.setOnClickListener(orig_listener)
                            except Exception:
                                pass
                        else:
                            self._current_scan_passed = False
                            try:
                                install_btn.setEnabled(False)
                                install_btn.setClickable(False)
                                install_btn.setAlpha(0.4)
                                self._safe_set_text(install_btn, _tr("Обновление заблокировано", "Update blocked") if is_update else _tr("Установка заблокирована", "Installation blocked"))
                                install_btn.setOnClickListener(BlockedClickListener())
                            except Exception:
                                pass

                            if parent_layout:
                                self._create_confirmation_card(install_btn.getContext(), install_btn, orig_listener, parent_layout, lin_cls, util_cls, theme_cls)

                    last_fragment = get_last_fragment()
                    if not last_fragment or not last_fragment.getParentActivity():
                        return

                    context = last_fragment.getParentActivity()
                    self._show_report_bottom_sheet(context, score, badge, reports, ai_stats, has_critical, file_path)

                except Exception as ui_err:
                    self.log(f"[PluginGuard DEBUG] _show_ui exception: {ui_err}\n{traceback.format_exc()}")

            run_on_ui_thread(_show_ui)

        threading.Thread(target=_do_scan, daemon=True).start()

    def _create_confirmation_card(self, context, install_btn, orig_listener, parent_layout, lin_cls=None, util_cls=None, theme_cls=None, resources_provider=None):
        if not context or not parent_layout:
            return None
        if hasattr(parent_layout, "findViewWithTag") and parent_layout.findViewWithTag("pg_confirm_card") is not None:
            return parent_layout.findViewWithTag("pg_confirm_card")
        try:
            FrameLayout = find_class("android.widget.FrameLayout")
            LinearLayoutClass = find_class("android.widget.LinearLayout")
            TextView = find_class("android.widget.TextView")
            GradientDrawable = find_class("android.graphics.drawable.GradientDrawable")
            Gravity = find_class("android.view.Gravity")
            AU = find_class("org.telegram.messenger.AndroidUtilities")
            Theme = find_class("org.telegram.ui.ActionBar.Theme")
            LLP = find_class("android.widget.LinearLayout$LayoutParams")
            ViewClass = find_class("android.view.View")

            dp16 = AU.dp(16) if AU else 40
            dp12 = AU.dp(12) if AU else 30
            dp8 = AU.dp(8) if AU else 20
            dp6 = AU.dp(6) if AU else 15
            dp4 = AU.dp(4) if AU else 10
            dp2 = AU.dp(2) if AU else 5
            dp1 = AU.dp(1) if AU else 2
            dp20 = AU.dp(20) if AU else 50

            is_dark = self._is_dark_theme(theme_cls or Theme, resources_provider)

            card = FrameLayout(context)
            card.setTag("pg_confirm_card")
            card_bg = GradientDrawable()
            card_bg.setCornerRadius(float(dp12))
            bg_tint = with_alpha(0xFFEF5350 if is_dark else 0xFFF44336, 0x2A if is_dark else 0x18)
            self._set_drawable_color(card_bg, bg_tint)
            self._set_drawable_stroke(card_bg, dp1, with_alpha(0xFFFF7961 if is_dark else 0xFFF44336, 0x60 if is_dark else 0x40))
            card.setBackground(card_bg)
            card.setClickable(True)
            card.setFocusable(True)

            row = LinearLayoutClass(context)
            row.setOrientation(0)
            row.setGravity(Gravity.CENTER)
            row.setPadding(dp16, dp12, dp16, dp12)

            state = {"checked": False}

            icon_frame = FrameLayout(context)
            icon_bg = GradientDrawable()
            icon_bg.setCornerRadius(float(dp6))
            self._set_drawable_color(icon_bg, 0x00000000)
            self._set_drawable_stroke(icon_bg, dp2, 0xFFFF8A80 if is_dark else 0xFFE57373)
            icon_frame.setBackground(icon_bg)

            check_view = TextView(context)
            check_view.setText("✓")
            check_view.setTextSize(1, 13.0)
            if AU and hasattr(AU, "bold"):
                try:
                    check_view.setTypeface(AU.bold())
                except Exception:
                    pass
            check_view.setGravity(Gravity.CENTER)
            self._set_text_color(check_view, 0xFFFFFFFF)
            check_view.setVisibility(8)
            flp_chk = FrameLayout.LayoutParams(-1, -1, Gravity.CENTER)
            icon_frame.addView(check_view, flp_chk)

            llp_icon = LinearLayoutClass.LayoutParams(dp20, dp20)
            llp_icon.gravity = Gravity.CENTER_VERTICAL
            llp_icon.rightMargin = dp8
            row.addView(icon_frame, llp_icon)

            is_update = getattr(self, "_current_is_update", False)
            label = TextView(context)
            label.setText(_tr("Я понимаю все риски, все равно обновить", "I understand all risks, update anyway") if is_update else _tr("Я понимаю все риски, все равно установить", "I understand all risks, install anyway"))
            label.setTextSize(1, 13.0)
            if AU and hasattr(AU, "bold"):
                try:
                    label.setTypeface(AU.bold())
                except Exception:
                    pass
            label.setGravity(Gravity.CENTER_VERTICAL)
            self._set_text_color(label, 0xFFFFCDD2 if is_dark else 0xFFB71C1C)
            llp_label = LinearLayoutClass.LayoutParams(-2, -2)
            llp_label.gravity = Gravity.CENTER_VERTICAL
            row.addView(label, llp_label)

            flp_row = FrameLayout.LayoutParams(-2, -2, Gravity.CENTER)
            card.addView(row, flp_row)

            class BlockedClickListener(dynamic_proxy(ViewClass.OnClickListener)):
                def onClick(self_inner, v):
                    try:
                        frag = get_last_fragment()
                        if frag:
                            BulletinHelper.show_error(_tr("Обновление заблокировано PluginGuard (опасный плагин)", "Update blocked by PluginGuard (dangerous plugin)") if is_update else _tr("Установка заблокирована PluginGuard (опасный плагин)", "Installation blocked by PluginGuard (dangerous plugin)"), frag)
                    except Exception:
                        pass
                    finally:
                        del v

            def update_card_state(is_checked: bool):
                state["checked"] = is_checked
                self._current_scan_passed = is_checked
                if getattr(self, "_current_sheet", None):
                    if is_checked:
                        _verified_guard_sheets.add(_get_sheet_id(self._current_sheet))
                    else:
                        _verified_guard_sheets.discard(_get_sheet_id(self._current_sheet))
                try:
                    if is_checked:
                        self._set_drawable_color(icon_bg, 0xFFF44336)
                        self._set_drawable_stroke(icon_bg, dp2, 0xFFF44336)
                        check_view.setVisibility(0)
                        self._set_drawable_color(card_bg, with_alpha(0xFFF44336, 0x32 if is_dark else 0x22))
                        self._set_drawable_stroke(card_bg, dp1, with_alpha(0xFFF44336, 0x90))
                        self._set_text_color(label, 0xFFFFFFFF if is_dark else 0xFFB71C1C)
                        if install_btn:
                            install_btn.setTag("pg_verified")
                            install_btn.setEnabled(True)
                            install_btn.setClickable(True)
                            install_btn.setAlpha(1.0)
                            self._safe_set_text(install_btn, _tr("Обновить", "Update") if is_update else _tr("Установить", "Install"))
                            if orig_listener:
                                install_btn.setOnClickListener(orig_listener)
                    else:
                        self._set_drawable_color(icon_bg, 0x00000000)
                        self._set_drawable_stroke(icon_bg, dp2, 0xFFFF8A80 if is_dark else 0xFFE57373)
                        check_view.setVisibility(8)
                        self._set_drawable_color(card_bg, with_alpha(0xFFF44336, 0x1E if is_dark else 0x14))
                        self._set_drawable_stroke(card_bg, dp1, with_alpha(0xFFF44336, 0x48 if is_dark else 0x30))
                        self._set_text_color(label, 0xFFFFCDD2 if is_dark else 0xFFB71C1C)
                        if install_btn:
                            install_btn.setTag("pg_blocked")
                            install_btn.setEnabled(False)
                            install_btn.setClickable(False)
                            install_btn.setAlpha(0.4)
                            self._safe_set_text(install_btn, _tr("Обновление заблокировано", "Update blocked") if is_update else _tr("Установка заблокирована", "Installation blocked"))
                            install_btn.setOnClickListener(BlockedClickListener())
                except Exception as ex:
                    self.log(f"[PluginGuard UI ERROR] update_card_state: {ex}")

            class CardClickListener(dynamic_proxy(ViewClass.OnClickListener)):
                def onClick(self_inner, v):
                    try:
                        _vibrate(v)
                        new_state = not state["checked"]
                        update_card_state(new_state)
                    except Exception:
                        pass
                    finally:
                        del v

            card.setOnClickListener(CardClickListener())

            cb_lp = LLP(-1, -2) if LLP else None
            if cb_lp:
                inst_lp = install_btn.getLayoutParams() if install_btn else None
                if inst_lp and hasattr(inst_lp, "leftMargin") and inst_lp.leftMargin > 0:
                    cb_lp.leftMargin = inst_lp.leftMargin
                    cb_lp.rightMargin = inst_lp.rightMargin
                else:
                    cb_lp.leftMargin = dp16
                    cb_lp.rightMargin = dp16
                cb_lp.topMargin = dp8
                cb_lp.bottomMargin = dp4

            analyze_btn = getattr(self, "_current_analyze_btn", None)
            idx = -1
            if analyze_btn and hasattr(parent_layout, "indexOfChild"):
                try:
                    idx = parent_layout.indexOfChild(analyze_btn)
                except Exception:
                    idx = -1

            if idx >= 0:
                parent_layout.addView(card, idx + 1, cb_lp if cb_lp else None)
            elif cb_lp:
                parent_layout.addView(card, cb_lp)
            else:
                parent_layout.addView(card)

            self._current_chk_box = card
            return card
        except Exception as e:
            self.log(f"[PluginGuard UI ERROR] _create_confirmation_card: {e}")
            return None

    def _fix_sheet_navigation_bar(self, sheet: Any, color: int):
        try:
            sheet.fixNavigationBar(as_java_color(color))
        except Exception:
            pass

    def _theme_color(self, theme_cls: Any, key: Any, default_color: int, resources_provider: Any = None) -> int:
        if theme_cls is None or key is None:
            return default_color
        try:
            if resources_provider is not None:
                try:
                    return int(theme_cls.getColor(key, resources_provider))
                except Exception:
                    pass
            return int(theme_cls.getColor(key))
        except Exception:
            return default_color

    def _get_monet_or_theme_accent(self, context: Any, theme_cls: Any, resources_provider: Any = None) -> int:
        is_dark = self._is_dark_theme(theme_cls, resources_provider)
        if context is not None:
            try:
                BuildVersion = find_class("android.os.Build$VERSION")
                if BuildVersion and int(getattr(BuildVersion, "SDK_INT", 0)) >= 31:
                    res = context.getResources()
                    accent_key = "system_accent1_200" if is_dark else "system_accent1_600"
                    res_id = res.getIdentifier(accent_key, "color", "android")
                    if not res_id and is_dark:
                        res_id = res.getIdentifier("system_accent1_300", "color", "android")
                    if not res_id:
                        res_id = res.getIdentifier("system_accent1_600", "color", "android")
                    if res_id:
                        col = int(context.getColor(res_id))
                        return self._adjust_luminance(col, 40) if is_dark else col
            except Exception:
                pass
        fallback = self._theme_color(theme_cls, getattr(theme_cls, "key_featuredStickers_addButton", None), 0xFF52A5F5 if is_dark else 0xFF2675C8, resources_provider)
        return self._adjust_luminance(fallback, 30) if is_dark else fallback

    def _is_dark_theme(self, theme_cls: Any, resources_provider: Any = None) -> bool:
        bg = self._theme_color(theme_cls, getattr(theme_cls, "key_windowBackgroundWhite", None), 0xFF101318, resources_provider)
        r = (bg >> 16) & 0xFF
        g = (bg >> 8) & 0xFF
        b = bg & 0xFF
        lum = 0.299 * r + 0.587 * g + 0.114 * b
        return lum < 128

    def _adjust_luminance(self, color: int, delta: int) -> int:
        r = max(0, min(255, ((color >> 16) & 0xFF) + delta))
        g = max(0, min(255, ((color >> 8) & 0xFF) + delta))
        b = max(0, min(255, (color & 0xFF) + delta))
        a = (color >> 24) & 0xFF
        if a == 0 and color != 0:
            a = 0xFF
        return (a << 24) | (r << 16) | (g << 8) | b

    def _get_m3_surface_container(self, theme_cls: Any, resources_provider: Any = None, level: int = 1) -> int:
        base_bg = self._theme_color(theme_cls, getattr(theme_cls, "key_dialogBackground", None), 0xFF181C22, resources_provider)
        is_dark = self._is_dark_theme(theme_cls, resources_provider)
        deltas = {0: (-6 if is_dark else 10), 1: (10 if is_dark else -5), 2: (16 if is_dark else -10), 3: (24 if is_dark else -16)}
        d = deltas.get(level, 10 if is_dark else -5)
        return self._adjust_luminance(base_bg, d)

    def _set_drawable_color(self, drawable: Any, color: int):
        if drawable is None:
            return
        try:
            drawable.setColor(as_java_color(color))
        except Exception:
            pass

    def _set_drawable_stroke(self, drawable: Any, width: int, color: int):
        if drawable is None:
            return
        try:
            drawable.setStroke(int(width), as_java_color(color))
        except Exception:
            pass

    def _set_text_color(self, view: Any, color: int):
        if view is None:
            return
        try:
            view.setTextColor(as_java_color(color))
        except Exception:
            pass

    def _set_background_color(self, view: Any, color: int):
        if view is None:
            return
        try:
            view.setBackgroundColor(as_java_color(color))
        except Exception:
            pass

    def _set_color_filter(self, image_view: Any, color: int):
        if image_view is None:
            return
        try:
            PorterDuff = find_class("android.graphics.PorterDuff$Mode")
            PorterDuffColorFilter = find_class("android.graphics.PorterDuffColorFilter")
            if PorterDuff and PorterDuffColorFilter:
                image_view.setColorFilter(PorterDuffColorFilter(as_java_color(color), PorterDuff.SRC_IN))
            else:
                image_view.setColorFilter(as_java_color(color))
        except Exception:
            pass

    def _apply_icon_to_view(self, image_view: Any, icon_type: str, color: int, size_dp: int = 18, context: Any = None):
        if image_view is None:
            return
        try:
            vec = self._create_vector_drawable(icon_type, color, size_dp=size_dp, context=context)
            if vec:
                image_view.setImageDrawable(vec)
                return
        except Exception:
            pass

        try:
            RClass = find_class("org.telegram.messenger.R$drawable")
            if not RClass:
                return
            res_id = None
            if icon_type in ("critical", "danger", "error"):
                res_id = getattr(RClass, "msg2_block2", None) or getattr(RClass, "msg_block", None) or getattr(RClass, "msg_round_warning", None)
            elif icon_type == "warning":
                res_id = getattr(RClass, "menu_feature_warning", None) or getattr(RClass, "msg_round_warning", None) or getattr(RClass, "msg2_warning", None) or getattr(RClass, "msg2_block2", None)
            elif icon_type == "info":
                res_id = getattr(RClass, "msg_round_info", None) or getattr(RClass, "msg_info", None) or getattr(RClass, "menu_feature_reliable", None)
            elif icon_type == "audit":
                res_id = getattr(RClass, "msg_stats", None) or getattr(RClass, "msg_search", None) or getattr(RClass, "menu_feature_analytics", None) or getattr(RClass, "msg_round_info", None)
            elif icon_type == "check":
                res_id = getattr(RClass, "menu_feature_reliable", None) or getattr(RClass, "msg_round_check", None) or getattr(RClass, "msg_check", None)
            elif icon_type == "folder":
                res_id = getattr(RClass, "msg_folder", None) or getattr(RClass, "folder", None)
            elif icon_type in ("chevron_down", "chevron_up"):
                res_id = getattr(RClass, "arrow_more", None) or getattr(RClass, "msg_arrow_expand", None)

            if res_id:
                image_view.setImageResource(int(res_id))
                self._set_color_filter(image_view, color)
        except Exception:
            pass

    def _create_vector_drawable(self, icon_type: str, color: int, size_dp: int = 24, context: Any = None):
        try:
            Bitmap = find_class("android.graphics.Bitmap")
            BitmapConfig = find_class("android.graphics.Bitmap$Config")
            Canvas = find_class("android.graphics.Canvas")
            BitmapDrawable = find_class("android.graphics.drawable.BitmapDrawable")
            Paint = find_class("android.graphics.Paint")
            Path = find_class("android.graphics.Path")
            AndroidUtilitiesClass = find_class("org.telegram.messenger.AndroidUtilities")
            if not Bitmap or not Canvas or not BitmapDrawable or not Paint or not Path or not AndroidUtilitiesClass:
                return None

            size_px = max(int(AndroidUtilitiesClass.dp(size_dp)), 1)
            config = getattr(BitmapConfig, "ARGB_8888", None)
            if not config:
                return None
            bmp = Bitmap.createBitmap(size_px, size_px, config)
            if not bmp:
                return None

            canvas = Canvas(bmp)
            paint = Paint(Paint.ANTI_ALIAS_FLAG)
            paint.setStyle(Paint.Style.STROKE)
            paint.setStrokeCap(Paint.Cap.ROUND)
            paint.setStrokeJoin(Paint.Join.ROUND)
            paint.setColor(as_java_color(color))

            fill_paint = Paint(Paint.ANTI_ALIAS_FLAG)
            fill_paint.setStyle(Paint.Style.FILL)
            fill_paint.setColor(as_java_color(color))

            fill_tonal_paint = Paint(Paint.ANTI_ALIAS_FLAG)
            fill_tonal_paint.setStyle(Paint.Style.FILL)
            fill_tonal_paint.setColor(as_java_color(with_alpha(color, 0x36)))

            s = float(size_px) / 24.0
            paint.setStrokeWidth(float(max(2.2 * s, 1.2)))
            p = Path()

            if icon_type == "shield_check":
                p.moveTo(float(12.0 * s), float(2.5 * s))
                p.lineTo(float(4.5 * s), float(5.8 * s))
                p.lineTo(float(4.5 * s), float(12.0 * s))
                p.cubicTo(float(4.5 * s), float(17.2 * s), float(7.7 * s), float(21.0 * s), float(12.0 * s), float(22.2 * s))
                p.cubicTo(float(16.3 * s), float(21.0 * s), float(19.5 * s), float(17.2 * s), float(19.5 * s), float(12.0 * s))
                p.lineTo(float(19.5 * s), float(5.8 * s))
                p.close()
                canvas.drawPath(p, fill_tonal_paint)
                canvas.drawPath(p, paint)
                p.reset()
                p.moveTo(float(8.5 * s), float(12.0 * s))
                p.lineTo(float(11.0 * s), float(14.5 * s))
                p.lineTo(float(15.5 * s), float(9.5 * s))
                canvas.drawPath(p, paint)
            elif icon_type == "shield_alert":
                p.moveTo(float(12.0 * s), float(2.5 * s))
                p.lineTo(float(4.5 * s), float(5.8 * s))
                p.lineTo(float(4.5 * s), float(12.0 * s))
                p.cubicTo(float(4.5 * s), float(17.2 * s), float(7.7 * s), float(21.0 * s), float(12.0 * s), float(22.2 * s))
                p.cubicTo(float(16.3 * s), float(21.0 * s), float(19.5 * s), float(17.2 * s), float(19.5 * s), float(12.0 * s))
                p.lineTo(float(19.5 * s), float(5.8 * s))
                p.close()
                canvas.drawPath(p, fill_tonal_paint)
                canvas.drawPath(p, paint)
                canvas.drawLine(float(12.0 * s), float(7.8 * s), float(12.0 * s), float(13.5 * s), paint)
            elif icon_type == "chevron_down":
                p.moveTo(float(6.5 * s), float(9.5 * s))
                p.lineTo(float(12.0 * s), float(15.0 * s))
                p.lineTo(float(17.5 * s), float(9.5 * s))
                canvas.drawPath(p, paint)
            elif icon_type == "chevron_up":
                p.moveTo(float(6.5 * s), float(14.5 * s))
                p.lineTo(float(12.0 * s), float(9.0 * s))
                p.lineTo(float(17.5 * s), float(14.5 * s))
                canvas.drawPath(p, paint)
            elif icon_type == "code":
                p.moveTo(float(8.5 * s), float(7.5 * s))
                p.lineTo(float(4.5 * s), float(12.0 * s))
                p.lineTo(float(8.5 * s), float(16.5 * s))
                p.moveTo(float(15.5 * s), float(7.5 * s))
                p.lineTo(float(19.5 * s), float(12.0 * s))
                p.lineTo(float(15.5 * s), float(16.5 * s))
                p.moveTo(float(13.5 * s), float(6.0 * s))
                p.lineTo(float(10.5 * s), float(18.0 * s))
                canvas.drawPath(p, paint)

            if context and hasattr(context, "getResources"):
                try:
                    res = context.getResources()
                    drawable = BitmapDrawable(res, bmp)
                except Exception:
                    drawable = BitmapDrawable(bmp)
            else:
                try:
                    ApplicationLoader = find_class("org.telegram.messenger.ApplicationLoader")
                    app_ctx = ApplicationLoader.applicationContext if ApplicationLoader else None
                    if app_ctx and hasattr(app_ctx, "getResources"):
                        drawable = BitmapDrawable(app_ctx.getResources(), bmp)
                    else:
                        drawable = BitmapDrawable(bmp)
                except Exception:
                    drawable = BitmapDrawable(bmp)

            drawable.setBounds(0, 0, size_px, size_px)
            return drawable
        except Exception:
            return None

    def _show_payload_viewer(self, context: Any, unpacked_payloads: List[Dict[str, Any]], ThemeClass: Any, resources_provider: Any = None):
        try:
            if not context or not unpacked_payloads:
                return
            BottomSheet = find_class("org.telegram.ui.ActionBar.BottomSheet")
            LayoutHelper = find_class("org.telegram.ui.Components.LayoutHelper")
            LinearLayoutClass = find_class("android.widget.LinearLayout")
            ScrollView = find_class("android.widget.ScrollView")
            HorizontalScrollView = find_class("android.widget.HorizontalScrollView")
            TextView = find_class("android.widget.TextView")
            FrameLayout = find_class("android.widget.FrameLayout")
            View = find_class("android.view.View")
            TypedValue = find_class("android.util.TypedValue")
            Gravity = find_class("android.view.Gravity")
            GradientDrawable = find_class("android.graphics.drawable.GradientDrawable")
            AndroidUtilitiesClass = find_class("org.telegram.messenger.AndroidUtilities")
            Typeface = find_class("android.graphics.Typeface")
            if not BottomSheet:
                return

            sheet = BottomSheet(context, False)
            try:
                sheet.setCanDismissWithSwipe(False)
            except Exception:
                pass
            try:
                sheet.setCanDismissWithTouchOutside(True)
            except Exception:
                pass
            try:
                sheet.setApplyTopPadding(False)
                sheet.setApplyBottomPadding(False)
            except Exception:
                pass
            is_dark = self._is_dark_theme(ThemeClass, resources_provider)
            monet_accent = self._get_monet_or_theme_accent(context, ThemeClass, resources_provider)
            sheet_bg = self._get_m3_surface_container(ThemeClass, resources_provider, level=1)
            text_primary = self._theme_color(ThemeClass, getattr(ThemeClass, "key_dialogTextBlack", None), 0xFFFFFFFF if is_dark else 0xFF1C1B1F, resources_provider)
            text_muted = self._theme_color(ThemeClass, getattr(ThemeClass, "key_dialogTextGray2", None), 0xFF9E9E9E if is_dark else 0xFF74777F, resources_provider)
            code_bg = 0xFF111215 if is_dark else 0xFFF3F4F6

            sheet_bg_draw = GradientDrawable()
            sheet_bg_draw.setCornerRadii([
                float(AndroidUtilitiesClass.dp(24)), float(AndroidUtilitiesClass.dp(24)),
                float(AndroidUtilitiesClass.dp(24)), float(AndroidUtilitiesClass.dp(24)),
                0.0, 0.0, 0.0, 0.0
            ])
            self._set_drawable_color(sheet_bg_draw, sheet_bg)

            screen_h = 0
            try:
                dm = context.getResources().getDisplayMetrics()
                screen_h = dm.heightPixels
            except Exception:
                pass
            target_sheet_h = max(AndroidUtilitiesClass.dp(440), int(screen_h * 0.70)) if screen_h > 0 else AndroidUtilitiesClass.dp(480)
            code_card_min_h = max(AndroidUtilitiesClass.dp(240), int(target_sheet_h * 0.52))

            root = LinearLayoutClass(context)
            root.setOrientation(LinearLayoutClass.VERTICAL)
            root.setBackground(sheet_bg_draw)
            root.setMinimumHeight(target_sheet_h)
            root.setPadding(
                AndroidUtilitiesClass.dp(16),
                AndroidUtilitiesClass.dp(10),
                AndroidUtilitiesClass.dp(16),
                AndroidUtilitiesClass.dp(14)
            )

            handle_wrap = FrameLayout(context)
            handle = View(context)
            handle_draw = GradientDrawable()
            handle_draw.setCornerRadius(float(AndroidUtilitiesClass.dp(2)))
            self._set_drawable_color(handle_draw, with_alpha(text_muted, 0x44))
            handle.setBackground(handle_draw)
            handle_wrap.addView(handle, LayoutHelper.createFrame(36, 4, Gravity.CENTER))
            root.addView(handle_wrap, LayoutHelper.createLinear(-1, 8, 0, 0, 0, 0, 8))

            top_row = LinearLayoutClass(context)
            top_row.setOrientation(LinearLayoutClass.HORIZONTAL)
            top_row.setGravity(Gravity.CENTER_VERTICAL)

            title_col = LinearLayoutClass(context)
            title_col.setOrientation(LinearLayoutClass.VERTICAL)

            h_title = TextView(context)
            h_title.setText(_tr("Инспектор кода", "Code Inspector"))
            h_title.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 16)
            h_title.setTypeface(AndroidUtilitiesClass.bold())
            try:
                h_title.setSingleLine(True)
            except Exception:
                pass
            self._set_text_color(h_title, text_primary)
            title_col.addView(h_title, LayoutHelper.createLinear(-2, -2))

            total_layers = len(unpacked_payloads)
            h_sub = TextView(context)
            layer_s = _plural_layers(total_layers)
            h_sub.setText(_tr(f"Полезная нагрузка: {layer_s}", f"Payload • {layer_s}"))
            h_sub.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 12)
            try:
                h_sub.setSingleLine(True)
            except Exception:
                pass
            self._set_text_color(h_sub, text_muted)
            title_col.addView(h_sub, LayoutHelper.createLinear(-2, -2, 0, 0, 2, 0, 0))

            top_row.addView(title_col, LayoutHelper.createLinear(0, -2, 1.0, Gravity.CENTER_VERTICAL))

            active_layer_idx = [0]
            wrap_mode = [False]

            btns_row = LinearLayoutClass(context)
            btns_row.setOrientation(LinearLayoutClass.HORIZONTAL)
            btns_row.setGravity(Gravity.CENTER_VERTICAL)

            wrap_btn = FrameLayout(context)
            wrap_bg = GradientDrawable()
            wrap_bg.setCornerRadius(float(AndroidUtilitiesClass.dp(10)))
            wrap_btn.setBackground(wrap_bg)
            wrap_btn.setPadding(AndroidUtilitiesClass.dp(8), AndroidUtilitiesClass.dp(5), AndroidUtilitiesClass.dp(8), AndroidUtilitiesClass.dp(5))
            wrap_btn.setClickable(True)
            wrap_txt = TextView(context)
            wrap_txt.setText(_tr("Перенос", "Wrap"))
            wrap_txt.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 11)
            wrap_txt.setTypeface(AndroidUtilitiesClass.bold())
            wrap_btn.addView(wrap_txt, LayoutHelper.createFrame(-2, -2, Gravity.CENTER))

            def _update_wrap_btn_style():
                if wrap_mode[0]:
                    self._set_drawable_color(wrap_bg, with_alpha(monet_accent, 0x30 if is_dark else 0x22))
                    self._set_drawable_stroke(wrap_bg, AndroidUtilitiesClass.dp(1), monet_accent)
                    self._set_text_color(wrap_txt, monet_accent)
                else:
                    self._set_drawable_color(wrap_bg, with_alpha(text_muted, 0x14 if is_dark else 0x0C))
                    self._set_drawable_stroke(wrap_bg, AndroidUtilitiesClass.dp(1), with_alpha(text_muted, 0x38 if is_dark else 0x24))
                    self._set_text_color(wrap_txt, text_muted)

            _update_wrap_btn_style()

            class WrapClickListener(dynamic_proxy(View.OnClickListener)):
                def onClick(self_w, v_w):
                    try:
                        _vibrate(v_w)
                        wrap_mode[0] = not wrap_mode[0]
                        _update_wrap_btn_style()
                        render_content(active_layer_idx[0])
                    finally:
                        del v_w
            wrap_btn.setOnClickListener(WrapClickListener())
            btns_row.addView(wrap_btn, LayoutHelper.createLinear(-2, -2, Gravity.CENTER_VERTICAL, 0, 0, 8, 0))

            copy_btn = FrameLayout(context)
            copy_bg = GradientDrawable()
            copy_bg.setCornerRadius(float(AndroidUtilitiesClass.dp(10)))
            self._set_drawable_color(copy_bg, with_alpha(monet_accent, 0x1A if is_dark else 0x12))
            self._set_drawable_stroke(copy_bg, AndroidUtilitiesClass.dp(1), with_alpha(monet_accent, 0x44 if is_dark else 0x30))
            copy_btn.setBackground(copy_bg)
            copy_btn.setPadding(AndroidUtilitiesClass.dp(10), AndroidUtilitiesClass.dp(5), AndroidUtilitiesClass.dp(10), AndroidUtilitiesClass.dp(5))
            copy_btn.setClickable(True)

            copy_txt = TextView(context)
            copy_txt.setText(_tr("Копировать", "Copy"))
            copy_txt.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 11)
            copy_txt.setTypeface(AndroidUtilitiesClass.bold())
            self._set_text_color(copy_txt, monet_accent)
            copy_btn.addView(copy_txt, LayoutHelper.createFrame(-2, -2, Gravity.CENTER))

            class CopyClickListener(dynamic_proxy(View.OnClickListener)):
                def onClick(self_inner, v):
                    try:
                        _vibrate(v)
                        cur_l = unpacked_payloads[active_layer_idx[0]]
                        c_text = cur_l.get("_b_code") or _beautify_code(cur_l.get("code", ""))
                        if AndroidUtilitiesClass and hasattr(AndroidUtilitiesClass, "addToClipboard"):
                            AndroidUtilitiesClass.addToClipboard(c_text)
                            try:
                                BulletinHelper.show_success(_tr("Код полезной нагрузки скопирован", "Payload code copied"))
                            except Exception:
                                pass
                    except Exception:
                        pass
                    finally:
                        del v
            copy_btn.setOnClickListener(CopyClickListener())
            btns_row.addView(copy_btn, LayoutHelper.createLinear(-2, -2, Gravity.CENTER_VERTICAL))

            top_row.addView(btns_row, LayoutHelper.createLinear(-2, -2, Gravity.CENTER_VERTICAL, 10, 0, 0, 0))

            root.addView(top_row, LayoutHelper.createLinear(-1, -2, 0, 0, 4, 0, 10))

            tab_scroll = HorizontalScrollView(context)
            tab_scroll.setHorizontalScrollBarEnabled(False)
            tab_row = LinearLayoutClass(context)
            tab_row.setOrientation(LinearLayoutClass.HORIZONTAL)
            tab_views = []

            viewer_holder = FrameLayout(context)

            def _style_tabs(target_idx: int):
                active_layer_idx[0] = target_idx
                for idx_btn, btn_view in enumerate(tab_views):
                    is_active = (idx_btn == target_idx)
                    b_bg = GradientDrawable()
                    b_bg.setCornerRadius(float(AndroidUtilitiesClass.dp(12)))
                    if is_active:
                        self._set_drawable_color(b_bg, monet_accent)
                    else:
                        self._set_drawable_color(b_bg, with_alpha(text_muted, 0x18 if is_dark else 0x10))
                    btn_view.setBackground(b_bg)
                    tv = btn_view.getChildAt(0)
                    if tv:
                        txt_col = (0xFFFFFFFF if is_dark_color(monet_accent) else 0xFF1C1B1F) if is_active else text_muted
                        self._set_text_color(tv, txt_col)

            def switch_tab(target_idx: int):
                _style_tabs(target_idx)
                render_content(target_idx)

            if total_layers > 1:
                for idx_layer in range(total_layers):
                    tb = FrameLayout(context)
                    tb.setClickable(True)
                    tb.setPadding(AndroidUtilitiesClass.dp(12), AndroidUtilitiesClass.dp(6), AndroidUtilitiesClass.dp(12), AndroidUtilitiesClass.dp(6))
                    t_tv = TextView(context)
                    l_obj_prev = unpacked_payloads[idx_layer]
                    t_name = l_obj_prev.get("title") or _tr(f"Слой {idx_layer + 1}", f"Layer {idx_layer + 1}")
                    if len(t_name) > 22:
                        t_name = t_name[:9] + "..." + t_name[-10:]
                    t_tv.setText(t_name)
                    t_tv.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 12)
                    t_tv.setTypeface(AndroidUtilitiesClass.bold())
                    tb.addView(t_tv, LayoutHelper.createFrame(-2, -2, Gravity.CENTER))

                    class TabClickListener(dynamic_proxy(View.OnClickListener)):
                        def __init__(self_inner, target_i):
                            super().__init__()
                            self_inner.target_i = target_i
                        def onClick(self_inner, v):
                            try:
                                _vibrate(v)
                                switch_tab(self_inner.target_i)
                            finally:
                                del v
                    tb.setOnClickListener(TabClickListener(idx_layer))
                    tab_views.append(tb)
                    tab_row.addView(tb, LayoutHelper.createLinear(-2, -2, 0, 0, 0, 6, 0))
                tab_scroll.addView(tab_row, LayoutHelper.createFrame(-2, -2))
                root.addView(tab_scroll, LayoutHelper.createLinear(-1, -2, 0, 0, 0, 0, 10))

            def render_content(layer_idx: int):
                viewer_holder.removeAllViews()
                layer_obj = unpacked_payloads[layer_idx]
                if "_b_code" not in layer_obj:
                    layer_obj["_b_code"] = _beautify_code(layer_obj.get("code", ""))
                code_raw = layer_obj["_b_code"]
                raw_lines = code_raw.split("\n")
                total_code_lines = len(raw_lines)
                threats_list = layer_obj.get("threats", [])
                threat_lines_map = {}
                raw_lines_lower = None
                for th in threats_list:
                    th_l = th.get("line", 0)
                    detail = th.get("detail", "")
                    if th_l > 0 and th_l <= total_code_lines:
                        l_content = raw_lines[th_l - 1].strip()
                        if l_content in ["[", "{", "]", "}"] or len(l_content) <= 1:
                            target_kw = None
                            if "(" in detail and ")" in detail:
                                target_kw = detail[detail.rfind("(") + 1:detail.rfind(")")].strip()
                            if not target_kw:
                                for w in detail.split():
                                    if len(w) >= 4 and any(c in w for c in ["_", "/", ".", ";"]):
                                        target_kw = w.strip("()[]'\",")
                                        break
                            if target_kw and len(target_kw) >= 3:
                                kw_low = target_kw.lower()
                                if raw_lines_lower is None:
                                    raw_lines_lower = [rl.lower() for rl in raw_lines]
                                for r_idx, r_line_low in enumerate(raw_lines_lower, 1):
                                    if kw_low in r_line_low:
                                        th_l = r_idx
                                        th["line"] = r_idx
                                        break
                    if th_l > 0 and th_l <= total_code_lines:
                        if raw_lines[th_l - 1].strip() not in ["[", "{", "]", "}"]:
                            threat_lines_map[th_l] = th

                content_box = LinearLayoutClass(context)
                content_box.setOrientation(LinearLayoutClass.VERTICAL)

                vert_scroll = ScrollView(context)
                try:
                    vert_scroll.setFillViewport(True)
                    vert_scroll.setVerticalScrollBarEnabled(True)
                except Exception:
                    pass
                horiz_scroll = HorizontalScrollView(context)
                row_views = {}
                code_view_ref = [None]
                display_lines_ref = [None]
                active_scroll_anim = [None]

                def _animate_scroll(target_y):
                    try:
                        if active_scroll_anim[0]:
                            try:
                                active_scroll_anim[0].cancel()
                            except Exception:
                                pass
                            active_scroll_anim[0] = None
                        start_y = vert_scroll.getScrollY()
                        if start_y == target_y:
                            return
                        ValueAnimator = find_class("android.animation.ValueAnimator")
                        DecelerateInterpolator = find_class("android.view.animation.DecelerateInterpolator")
                        AnimatorUpdateListener = find_class("android.animation.ValueAnimator$AnimatorUpdateListener")
                        if ValueAnimator and DecelerateInterpolator and AnimatorUpdateListener:
                            anim = ValueAnimator.ofInt([start_y, target_y])
                            anim.setDuration(320)
                            anim.setInterpolator(DecelerateInterpolator(1.5))
                            class ScrollUpdate(dynamic_proxy(AnimatorUpdateListener)):
                                def onAnimationUpdate(self_u, a):
                                    try:
                                        vert_scroll.scrollTo(0, int(a.getAnimatedValue()))
                                    except Exception:
                                        pass
                                    finally:
                                        del a
                            anim.addUpdateListener(ScrollUpdate())
                            active_scroll_anim[0] = anim
                            anim.start()
                        else:
                            vert_scroll.smoothScrollTo(0, target_y)
                    except Exception:
                        try:
                            vert_scroll.smoothScrollTo(0, target_y)
                        except Exception:
                            pass

                def _navigate_to_line(target_line):
                    actual_line = target_line
                    if actual_line <= 0:
                        non_zero = [t.get("line", 0) for t in threats_list if t.get("line", 0) > 0]
                        actual_line = min(non_zero) if non_zero else 1

                    def _run_scroll():
                        try:
                            target_y = 0
                            if display_lines_ref[0] and total_code_lines > 1000:
                                d_idx = 0
                                for idx_d, (l_no_d, _) in enumerate(display_lines_ref[0]):
                                    if l_no_d == actual_line:
                                        d_idx = idx_d
                                        break
                                target_y = int(d_idx * AndroidUtilitiesClass.dp(16))
                            else:
                                cv = code_view_ref[0]
                                if cv and hasattr(cv, "getLayout") and cv.getLayout():
                                    layout = cv.getLayout()
                                    if layout and hasattr(layout, "getLineTop") and actual_line <= layout.getLineCount():
                                        target_y = int(layout.getLineTop(max(0, actual_line - 1)))
                                    else:
                                        lh = cv.getLineHeight() if hasattr(cv, "getLineHeight") else AndroidUtilitiesClass.dp(16)
                                        target_y = int((actual_line - 1) * lh)
                                elif actual_line in row_views:
                                    cur_v = row_views[actual_line]
                                    total_y = 0
                                    while cur_v and cur_v != vert_scroll:
                                        if hasattr(cur_v, "getTop"):
                                            total_y += int(cur_v.getTop())
                                        if hasattr(cur_v, "getParent"):
                                            cur_v = cur_v.getParent()
                                        else:
                                            break
                                    target_y = total_y
                                elif total_code_lines > 0:
                                    ratio = float(min(actual_line, total_code_lines)) / float(max(1, total_code_lines))
                                    child_v = vert_scroll.getChildAt(0) if vert_scroll.getChildCount() > 0 else None
                                    total_h = child_v.getHeight() if child_v and hasattr(child_v, "getHeight") else 0
                                    if total_h > 0:
                                        target_y = int(ratio * total_h)
                                    else:
                                        target_y = int((actual_line - 1) * AndroidUtilitiesClass.dp(16))
                            scroll_target_y = max(0, target_y - AndroidUtilitiesClass.dp(44))
                            _animate_scroll(scroll_target_y)
                        except Exception:
                            pass

                    run_on_ui_thread(_run_scroll)

                class ThreatClickListener(dynamic_proxy(View.OnClickListener)):
                    def __init__(self_inner, target_line):
                        super().__init__()
                        self_inner.target_line = target_line
                    def onClick(self_inner, v):
                        try:
                            _vibrate(v)
                            _navigate_to_line(self_inner.target_line)
                        finally:
                            del v

                if threats_list:
                    grouped_threats = []
                    seen_lines = {}
                    for th in threats_list:
                        l_num = th.get("line", 0)
                        rule = th.get("rule", "ALERT")
                        level = th.get("level", "WARNING")
                        if l_num > 0:
                            if l_num not in seen_lines:
                                entry = {"line": l_num, "rules": [rule], "level": level}
                                seen_lines[l_num] = entry
                                grouped_threats.append(entry)
                            else:
                                if rule not in seen_lines[l_num]["rules"]:
                                    seen_lines[l_num]["rules"].append(rule)
                                if level == "CRITICAL":
                                    seen_lines[l_num]["level"] = "CRITICAL"
                        else:
                            r_key = f"r_{rule}"
                            if r_key not in seen_lines:
                                entry = {"line": 0, "rules": [rule], "level": level}
                                seen_lines[r_key] = entry
                                grouped_threats.append(entry)

                    def _open_threats_list_sheet():
                        try:
                            list_sheet = BottomSheet(context, False)
                            try:
                                list_sheet.setCanDismissWithSwipe(False)
                            except Exception:
                                pass
                            try:
                                list_sheet.setCanDismissWithTouchOutside(True)
                            except Exception:
                                pass
                            try:
                                list_sheet.setApplyTopPadding(False)
                                list_sheet.setApplyBottomPadding(False)
                            except Exception:
                                pass
                            sh_draw = GradientDrawable()
                            sh_draw.setCornerRadii([
                                float(AndroidUtilitiesClass.dp(24)), float(AndroidUtilitiesClass.dp(24)),
                                float(AndroidUtilitiesClass.dp(24)), float(AndroidUtilitiesClass.dp(24)),
                                0.0, 0.0, 0.0, 0.0
                            ])
                            self._set_drawable_color(sh_draw, sheet_bg)
                            sh_root = LinearLayoutClass(context)
                            sh_root.setOrientation(LinearLayoutClass.VERTICAL)
                            sh_root.setBackground(sh_draw)
                            sh_root.setPadding(
                                AndroidUtilitiesClass.dp(16),
                                AndroidUtilitiesClass.dp(10),
                                AndroidUtilitiesClass.dp(16),
                                AndroidUtilitiesClass.dp(16)
                            )

                            drag_h = View(context)
                            drag_d = GradientDrawable()
                            drag_d.setCornerRadius(float(AndroidUtilitiesClass.dp(2)))
                            self._set_drawable_color(drag_d, with_alpha(text_muted, 0x44))
                            drag_h.setBackground(drag_d)
                            sh_root.addView(drag_h, LayoutHelper.createLinear(36, 4, Gravity.CENTER_HORIZONTAL, 0, 0, 0, 10))

                            header_row = LinearLayoutClass(context)
                            header_row.setOrientation(LinearLayoutClass.HORIZONTAL)
                            header_row.setGravity(Gravity.CENTER_VERTICAL)

                            title_col = LinearLayoutClass(context)
                            title_col.setOrientation(LinearLayoutClass.VERTICAL)
                            h_title = TextView(context)
                            h_title.setText(_tr(f"Все угрозы ({len(grouped_threats)})", f"All threats ({len(grouped_threats)})"))
                            h_title.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 16)
                            h_title.setTypeface(AndroidUtilitiesClass.bold())
                            self._set_text_color(h_title, text_primary)
                            title_col.addView(h_title, LayoutHelper.createLinear(-2, -2))

                            h_sub = TextView(context)
                            h_sub.setText(_tr("Нажмите на угрозу для перехода к строке", "Tap a threat to jump to code line"))
                            h_sub.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 12)
                            self._set_text_color(h_sub, text_muted)
                            title_col.addView(h_sub, LayoutHelper.createLinear(-2, -2, 0, 0, 2, 0, 0))

                            header_row.addView(title_col, LayoutHelper.createLinear(0, -2, 1.0, Gravity.CENTER_VERTICAL))

                            class CloseClickListener(dynamic_proxy(View.OnClickListener)):
                                def onClick(self_c, v_c):
                                    try:
                                        _vibrate(v_c)
                                        try:
                                            list_sheet.dismiss()
                                        except Exception:
                                            pass
                                    finally:
                                        del v_c

                            close_btn = FrameLayout(context)
                            close_btn.setPadding(AndroidUtilitiesClass.dp(8), AndroidUtilitiesClass.dp(4), AndroidUtilitiesClass.dp(8), AndroidUtilitiesClass.dp(4))
                            close_txt = TextView(context)
                            close_txt.setText("✕")
                            close_txt.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 16)
                            close_txt.setTypeface(AndroidUtilitiesClass.bold())
                            self._set_text_color(close_txt, text_muted)
                            close_btn.addView(close_txt, LayoutHelper.createFrame(-2, -2, Gravity.CENTER))
                            close_btn.setOnClickListener(CloseClickListener())
                            header_row.addView(close_btn, LayoutHelper.createLinear(-2, -2, Gravity.CENTER_VERTICAL))

                            sh_root.addView(header_row, LayoutHelper.createLinear(-1, -2, 0, 0, 0, 0, 10))

                            list_scroll = ScrollView(context)
                            try:
                                list_scroll.setFillViewport(True)
                                list_scroll.setVerticalScrollBarEnabled(True)
                            except Exception:
                                pass
                            list_col = LinearLayoutClass(context)
                            list_col.setOrientation(LinearLayoutClass.VERTICAL)

                            class SheetItemClickListener(dynamic_proxy(View.OnClickListener)):
                                def __init__(self_s, target_l):
                                    super().__init__()
                                    self_s.target_l = target_l
                                def onClick(self_s, v_s):
                                    try:
                                        _vibrate(v_s)
                                        try:
                                            list_sheet.dismiss()
                                        except Exception:
                                            pass
                                        def _delayed_jump():
                                            _navigate_to_line(self_s.target_l)
                                        self._schedule_timer(0.18, _delayed_jump)
                                    finally:
                                        del v_s

                            for th_item in grouped_threats:
                                it_line = th_item.get("line", 0)
                                it_rules = th_item.get("rules", [])
                                it_is_crit = th_item.get("level") == "CRITICAL"
                                it_col = 0xFFFF3B30 if it_is_crit else 0xFFF59E0B
                                it_first_rule = it_rules[0] if it_rules else "ALERT"

                                item_row = LinearLayoutClass(context)
                                item_row.setOrientation(LinearLayoutClass.HORIZONTAL)
                                item_row.setGravity(Gravity.CENTER_VERTICAL)
                                it_bg = GradientDrawable()
                                it_bg.setCornerRadius(float(AndroidUtilitiesClass.dp(10)))
                                self._set_drawable_color(it_bg, with_alpha(it_col, 0x14 if is_dark else 0x0E))
                                self._set_drawable_stroke(it_bg, AndroidUtilitiesClass.dp(1), with_alpha(it_col, 0x30 if is_dark else 0x20))
                                item_row.setBackground(it_bg)
                                item_row.setPadding(AndroidUtilitiesClass.dp(10), AndroidUtilitiesClass.dp(8), AndroidUtilitiesClass.dp(10), AndroidUtilitiesClass.dp(8))
                                item_row.setClickable(True)
                                item_row.setFocusable(True)

                                if it_line > 0:
                                    badge_b = GradientDrawable()
                                    badge_b.setCornerRadius(float(AndroidUtilitiesClass.dp(6)))
                                    self._set_drawable_color(badge_b, with_alpha(it_col, 0x38 if is_dark else 0x28))
                                    b_txt = TextView(context)
                                    b_txt.setBackground(badge_b)
                                    b_txt.setText(f"L{it_line}")
                                    b_txt.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 11)
                                    b_txt.setTypeface(AndroidUtilitiesClass.bold())
                                    b_txt.setPadding(AndroidUtilitiesClass.dp(6), AndroidUtilitiesClass.dp(2), AndroidUtilitiesClass.dp(6), AndroidUtilitiesClass.dp(2))
                                    self._set_text_color(b_txt, it_col)
                                    item_row.addView(b_txt, LayoutHelper.createLinear(-2, -2, Gravity.CENTER_VERTICAL, 0, 0, 8, 0))
                                else:
                                    w_icon = TextView(context)
                                    w_icon.setText("⚠")
                                    w_icon.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 12)
                                    w_icon.setTypeface(AndroidUtilitiesClass.bold())
                                    self._set_text_color(w_icon, it_col)
                                    item_row.addView(w_icon, LayoutHelper.createLinear(-2, -2, Gravity.CENTER_VERTICAL, 2, 0, 8, 0))

                                mid_col = LinearLayoutClass(context)
                                mid_col.setOrientation(LinearLayoutClass.VERTICAL)
                                m_title = TextView(context)
                                m_title.setText(_format_rule_title(it_first_rule))
                                m_title.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13)
                                m_title.setTypeface(AndroidUtilitiesClass.bold())
                                self._set_text_color(m_title, text_primary)
                                mid_col.addView(m_title, LayoutHelper.createLinear(-2, -2))

                                if len(it_rules) > 1:
                                    extra_names = ", ".join([_format_rule_title(r) for r in it_rules[1:]])
                                    m_sub = TextView(context)
                                    m_sub.setText(f"+ {extra_names}")
                                    m_sub.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 11)
                                    self._set_text_color(m_sub, text_muted)
                                    mid_col.addView(m_sub, LayoutHelper.createLinear(-2, -2, 0, 0, 2, 0, 0))

                                item_row.addView(mid_col, LayoutHelper.createLinear(0, -2, 1.0, Gravity.CENTER_VERTICAL))

                                sev_bg = GradientDrawable()
                                sev_bg.setCornerRadius(float(AndroidUtilitiesClass.dp(6)))
                                self._set_drawable_color(sev_bg, with_alpha(it_col, 0x2A))
                                sev_view = TextView(context)
                                sev_view.setBackground(sev_bg)
                                sev_view.setText("CRITICAL" if it_is_crit else "WARNING")
                                sev_view.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 9)
                                sev_view.setTypeface(AndroidUtilitiesClass.bold())
                                sev_view.setPadding(AndroidUtilitiesClass.dp(5), AndroidUtilitiesClass.dp(2), AndroidUtilitiesClass.dp(5), AndroidUtilitiesClass.dp(2))
                                self._set_text_color(sev_view, it_col)
                                item_row.addView(sev_view, LayoutHelper.createLinear(-2, -2, Gravity.CENTER_VERTICAL, 6, 0, 0, 0))

                                item_row.setOnClickListener(SheetItemClickListener(it_line))
                                list_col.addView(item_row, LayoutHelper.createLinear(-1, -2, 0, 0, 0, 0, 6))

                            list_scroll.addView(list_col, LayoutHelper.createFrame(-1, -2))
                            sh_root.addView(list_scroll, LayoutHelper.createLinear(-1, -2, 0, 0, 0, 0, 0))
                            list_sheet._kpm_custom_sheet = True
                            list_sheet.setCustomView(sh_root)
                            list_sheet.show()
                        except Exception:
                            pass

                    class AllThreatsClickListener(dynamic_proxy(View.OnClickListener)):
                        def onClick(self_a, v_a):
                            try:
                                _vibrate(v_a)
                                _open_threats_list_sheet()
                            finally:
                                del v_a

                    threat_chip_scroll = HorizontalScrollView(context)
                    threat_chip_scroll.setHorizontalScrollBarEnabled(False)
                    threat_chip_row = LinearLayoutClass(context)
                    threat_chip_row.setOrientation(LinearLayoutClass.HORIZONTAL)

                    all_chip = LinearLayoutClass(context)
                    all_chip.setOrientation(LinearLayoutClass.HORIZONTAL)
                    all_chip.setGravity(Gravity.CENTER_VERTICAL)
                    all_bg = GradientDrawable()
                    all_bg.setCornerRadius(float(AndroidUtilitiesClass.dp(14)))
                    self._set_drawable_color(all_bg, with_alpha(monet_accent, 0x2C if is_dark else 0x1E))
                    self._set_drawable_stroke(all_bg, AndroidUtilitiesClass.dp(1), with_alpha(monet_accent, 0x66 if is_dark else 0x48))
                    all_chip.setBackground(all_bg)
                    all_chip.setPadding(AndroidUtilitiesClass.dp(10), AndroidUtilitiesClass.dp(4), AndroidUtilitiesClass.dp(10), AndroidUtilitiesClass.dp(4))
                    all_chip.setClickable(True)
                    all_chip.setFocusable(True)

                    all_txt = TextView(context)
                    all_txt.setText(_tr(f"☰ Все ({len(grouped_threats)})", f"☰ All ({len(grouped_threats)})"))
                    all_txt.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 12)
                    all_txt.setTypeface(AndroidUtilitiesClass.bold())
                    self._set_text_color(all_txt, monet_accent)
                    all_chip.addView(all_txt, LayoutHelper.createLinear(-2, -2, Gravity.CENTER_VERTICAL))
                    all_chip.setOnClickListener(AllThreatsClickListener())
                    threat_chip_row.addView(all_chip, LayoutHelper.createLinear(-2, -2, 0, 0, 0, 8, 0))

                    for th in grouped_threats:
                        th_chip = LinearLayoutClass(context)
                        th_chip.setOrientation(LinearLayoutClass.HORIZONTAL)
                        th_chip.setGravity(Gravity.CENTER_VERTICAL)
                        th_bg = GradientDrawable()
                        th_bg.setCornerRadius(float(AndroidUtilitiesClass.dp(14)))
                        is_crit = th.get("level") == "CRITICAL"
                        th_col = 0xFFFF3B30 if is_crit else 0xFFF59E0B
                        self._set_drawable_color(th_bg, with_alpha(th_col, 0x1E if is_dark else 0x14))
                        self._set_drawable_stroke(th_bg, AndroidUtilitiesClass.dp(1), with_alpha(th_col, 0x50 if is_dark else 0x36))
                        th_chip.setBackground(th_bg)
                        th_chip.setPadding(AndroidUtilitiesClass.dp(6), AndroidUtilitiesClass.dp(4), AndroidUtilitiesClass.dp(10), AndroidUtilitiesClass.dp(4))
                        th_chip.setClickable(True)
                        th_chip.setFocusable(True)

                        l_num = th.get("line", 0)
                        rules = th.get("rules", [])
                        first_rule = rules[0] if rules else "ALERT"

                        if l_num > 0:
                            badge_bg = GradientDrawable()
                            badge_bg.setCornerRadius(float(AndroidUtilitiesClass.dp(8)))
                            self._set_drawable_color(badge_bg, with_alpha(th_col, 0x38 if is_dark else 0x28))
                            badge_view = TextView(context)
                            badge_view.setBackground(badge_bg)
                            badge_view.setText(f"L{l_num}")
                            badge_view.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 11)
                            badge_view.setTypeface(AndroidUtilitiesClass.bold())
                            badge_view.setPadding(AndroidUtilitiesClass.dp(6), AndroidUtilitiesClass.dp(2), AndroidUtilitiesClass.dp(6), AndroidUtilitiesClass.dp(2))
                            self._set_text_color(badge_view, th_col)
                            th_chip.addView(badge_view, LayoutHelper.createLinear(-2, -2, Gravity.CENTER_VERTICAL, 0, 0, 6, 0))
                        else:
                            warn_icon = TextView(context)
                            warn_icon.setText("⚠")
                            warn_icon.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 11)
                            warn_icon.setTypeface(AndroidUtilitiesClass.bold())
                            self._set_text_color(warn_icon, th_col)
                            th_chip.addView(warn_icon, LayoutHelper.createLinear(-2, -2, Gravity.CENTER_VERTICAL, 2, 0, 6, 0))

                        th_txt = TextView(context)
                        th_txt.setText(_format_rule_title(first_rule))
                        th_txt.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 12)
                        th_txt.setTypeface(AndroidUtilitiesClass.bold())
                        self._set_text_color(th_txt, text_primary)
                        th_chip.addView(th_txt, LayoutHelper.createLinear(-2, -2, Gravity.CENTER_VERTICAL))

                        if len(rules) > 1:
                            cnt_bg = GradientDrawable()
                            cnt_bg.setCornerRadius(float(AndroidUtilitiesClass.dp(6)))
                            self._set_drawable_color(cnt_bg, with_alpha(th_col, 0x30 if is_dark else 0x22))
                            count_badge = TextView(context)
                            count_badge.setBackground(cnt_bg)
                            count_badge.setText(f"+{len(rules)-1}")
                            count_badge.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 10)
                            count_badge.setTypeface(AndroidUtilitiesClass.bold())
                            count_badge.setPadding(AndroidUtilitiesClass.dp(4), AndroidUtilitiesClass.dp(1), AndroidUtilitiesClass.dp(4), AndroidUtilitiesClass.dp(1))
                            self._set_text_color(count_badge, th_col)
                            th_chip.addView(count_badge, LayoutHelper.createLinear(-2, -2, Gravity.CENTER_VERTICAL, 6, 0, 0, 0))

                        th_chip.setOnClickListener(ThreatClickListener(l_num))
                        threat_chip_row.addView(th_chip, LayoutHelper.createLinear(-2, -2, 0, 0, 0, 8, 0))
                    threat_chip_scroll.addView(threat_chip_row, LayoutHelper.createFrame(-2, -2))
                    content_box.addView(threat_chip_scroll, LayoutHelper.createLinear(-1, -2, 0, 0, 0, 0, 8))

                code_card = FrameLayout(context)
                code_card_bg = GradientDrawable()
                code_card_bg.setCornerRadius(float(AndroidUtilitiesClass.dp(12)))
                self._set_drawable_color(code_card_bg, code_bg)
                self._set_drawable_stroke(code_card_bg, AndroidUtilitiesClass.dp(1), with_alpha(text_muted, 0x20 if is_dark else 0x14))
                code_card.setBackground(code_card_bg)

                raw_lines = code_raw.split("\n")
                total_code_lines = len(raw_lines)

                SpannableStringBuilder = find_class("android.text.SpannableStringBuilder")
                BackgroundColorSpan = find_class("android.text.style.BackgroundColorSpan")
                ForegroundColorSpan = find_class("android.text.style.ForegroundColorSpan")
                Spanned = find_class("android.text.Spanned")
                SPAN_EXCLUSIVE_EXCLUSIVE = getattr(Spanned, "SPAN_EXCLUSIVE_EXCLUSIVE", 33) if Spanned else 33

                th_crit_col = as_java_color(with_alpha(0xFFFF3B30, 0x48 if is_dark else 0x30))
                th_warn_col = as_java_color(with_alpha(0xFFF59E0B, 0x48 if is_dark else 0x30))
                no_color = as_java_color(with_alpha(text_muted, 0x88))
                mono_tf = Typeface.MONOSPACE if Typeface else None

                editor_box = LinearLayoutClass(context)
                editor_box.setOrientation(LinearLayoutClass.HORIZONTAL)

                gutter_box = FrameLayout(context)
                gutter_bg = GradientDrawable()
                self._set_drawable_color(gutter_bg, with_alpha(code_bg, 0x88 if is_dark else 0x40))
                gutter_box.setBackground(gutter_bg)

                gutter_tv = TextView(context)
                gutter_tv.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 11)
                if mono_tf:
                    gutter_tv.setTypeface(mono_tf)
                gutter_tv.setIncludeFontPadding(False)
                gutter_tv.setLineSpacing(float(0), float(1.15))
                self._set_text_color(gutter_tv, with_alpha(text_muted, 0x88))
                gutter_tv.setPadding(AndroidUtilitiesClass.dp(6), AndroidUtilitiesClass.dp(8), AndroidUtilitiesClass.dp(6), AndroidUtilitiesClass.dp(8))
                gutter_tv.setGravity(Gravity.RIGHT | Gravity.TOP)
                gutter_tv.setTextIsSelectable(False)
                gutter_box.addView(gutter_tv, LayoutHelper.createFrame(-2, -2))

                divider_v = View(context)
                divider_v.setBackgroundColor(as_java_color(with_alpha(text_muted, 0x24 if is_dark else 0x16)))

                code_tv = TextView(context)
                code_tv.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 11)
                if mono_tf:
                    code_tv.setTypeface(mono_tf)
                code_tv.setIncludeFontPadding(False)
                code_tv.setLineSpacing(float(0), float(1.15))
                self._set_text_color(code_tv, text_primary)
                code_tv.setPadding(AndroidUtilitiesClass.dp(10), AndroidUtilitiesClass.dp(8), AndroidUtilitiesClass.dp(12), AndroidUtilitiesClass.dp(8))
                try:
                    code_tv.setTextIsSelectable(True)
                except Exception:
                    pass

                display_lines = []
                if total_code_lines > 150:
                    threat_linenos = sorted([l for l in threat_lines_map.keys() if l > 0])
                    w_rad = 5 if len(threat_linenos) > 10 else (8 if len(threat_linenos) > 5 else 12)
                    included_set = set()
                    for t_l in threat_linenos:
                        for w in range(max(1, t_l - w_rad), min(total_code_lines + 1, t_l + w_rad + 1)):
                            included_set.add(w)
                    for w in range(1, min(total_code_lines + 1, 12)):
                        included_set.add(w)
                    last_inc = 0
                    for cur_l in range(1, total_code_lines + 1):
                        if cur_l in included_set:
                            if last_inc > 0 and cur_l > last_inc + 1:
                                skipped_cnt = cur_l - last_inc - 1
                                display_lines.append((-1, f"... [{_tr(f'Пропущено строк: {skipped_cnt}', f'Skipped lines: {skipped_cnt}')}] ..."))
                            display_lines.append((cur_l, raw_lines[cur_l - 1]))
                            last_inc = cur_l
                    if last_inc < total_code_lines:
                        skipped_cnt = total_code_lines - last_inc
                        display_lines.append((-1, f"... [{_tr(f'Пропущено строк: {skipped_cnt}', f'Skipped lines: {skipped_cnt}')}] ..."))
                else:
                    display_lines = [(i, l) for i, l in enumerate(raw_lines, 1)]
                display_lines_ref[0] = display_lines

                g_parts = []
                c_parts = []
                g_spans = []
                c_spans = []
                line_s_offs = []
                g_off = 0
                c_off = 0
                for item in display_lines:
                    line_i, line_str = item
                    if line_i == -1:
                        g_txt = " ..."
                        g_end = g_off + len(g_txt)
                        c_txt = line_str
                        c_len = len(c_txt) if c_txt.isascii() else (len(c_txt.encode("utf-16-le")) >> 1)
                        line_s_offs.append(c_off)
                        c_parts.append(c_txt)
                        c_off += c_len + 1
                        g_parts.append(g_txt)
                        g_off = g_end + 1
                        continue
                    g_txt = f"{line_i:>4}"
                    g_end = g_off + len(g_txt)
                    c_txt = line_str if line_str else " "
                    if len(c_txt) > 280:
                        c_txt = c_txt[:280] + " ... [TRUNCATED]"
                    c_len = len(c_txt) if c_txt.isascii() else (len(c_txt.encode("utf-16-le")) >> 1)
                    line_s_offs.append(c_off)
                    if line_i in threat_lines_map:
                        th_i = threat_lines_map[line_i]
                        th_c = (th_i.get("level") == "CRITICAL")
                        fg_col = as_java_color(0xFFFF3B30 if th_c else 0xFFF59E0B)
                        bg_col = th_crit_col if th_c else th_warn_col
                        g_spans.append((g_off, g_end, g_end + 1, fg_col, bg_col))
                        tag_str = f"  [{th_i.get('rule', 'ALERT')}]"
                        tag_len = len(tag_str) if tag_str.isascii() else (len(tag_str.encode("utf-16-le")) >> 1)
                        b_start = c_off + c_len
                        b_end = b_start + tag_len
                        c_spans.append((c_off, b_start, b_end, fg_col, bg_col))
                        c_parts.append(c_txt + tag_str)
                        c_off = b_end + 1
                    else:
                        c_parts.append(c_txt)
                        c_off += c_len + 1
                    g_parts.append(g_txt)
                    g_off = g_end + 1
                line_s_offs.append(c_off)
                g_full = "\n".join(g_parts) + "\n"
                c_full = "\n".join(c_parts) + "\n"

                if SpannableStringBuilder:
                    try:
                        if g_spans:
                            g_sb = SpannableStringBuilder(g_full)
                            for gs, ge, g_bg_e, fg_col, bg_col in g_spans:
                                if ForegroundColorSpan:
                                    g_sb.setSpan(ForegroundColorSpan(fg_col), gs, ge, SPAN_EXCLUSIVE_EXCLUSIVE)
                                if BackgroundColorSpan:
                                    g_sb.setSpan(BackgroundColorSpan(bg_col), gs, g_bg_e, SPAN_EXCLUSIVE_EXCLUSIVE)
                            gutter_tv.setText(g_sb)
                        else:
                            gutter_tv.setText(g_full)
                        if c_spans:
                            c_sb = SpannableStringBuilder(c_full)
                            for cs, bs, be, fg_col, bg_col in c_spans:
                                if ForegroundColorSpan:
                                    c_sb.setSpan(ForegroundColorSpan(fg_col), bs, be, SPAN_EXCLUSIVE_EXCLUSIVE)
                                if BackgroundColorSpan:
                                    c_sb.setSpan(BackgroundColorSpan(bg_col), cs, be, SPAN_EXCLUSIVE_EXCLUSIVE)
                            code_tv.setText(c_sb)
                        else:
                            code_tv.setText(c_full)
                    except Exception:
                        gutter_tv.setText(g_full)
                        code_tv.setText(c_full)
                else:
                    gutter_tv.setText(g_full)
                    code_tv.setText(c_full)

                editor_box.addView(gutter_box, LayoutHelper.createLinear(-2, -2))
                editor_box.addView(divider_v, LayoutHelper.createLinear(AndroidUtilitiesClass.dp(1), -1))

                if wrap_mode[0]:
                    editor_box.addView(code_tv, LayoutHelper.createLinear(0, -2, 1.0))
                    RunnableClass = find_class("java.lang.Runnable")
                    if RunnableClass:
                        class GutterSync(dynamic_proxy(RunnableClass)):
                            def run(self_gs):
                                try:
                                    layout = code_tv.getLayout()
                                    if not layout or layout.getLineCount() <= total_code_lines + 1:
                                        return
                                    v_starts = [0] * (total_code_lines + 1)
                                    v_starts[0] = layout.getLineForOffset(line_s_offs[0])
                                    v_starts[total_code_lines] = layout.getLineForOffset(max(0, line_s_offs[total_code_lines] - 1)) + 1
                                    step_b = 32
                                    for b_s in range(0, total_code_lines, step_b):
                                        b_e = min(total_code_lines, b_s + step_b)
                                        if b_e < total_code_lines:
                                            v_starts[b_e] = layout.getLineForOffset(line_s_offs[b_e])
                                        if v_starts[b_e] - v_starts[b_s] == b_e - b_s:
                                            for k in range(b_s + 1, b_e):
                                                v_starts[k] = v_starts[b_s] + (k - b_s)
                                        else:
                                            for k in range(b_s + 1, b_e):
                                                v_starts[k] = layout.getLineForOffset(line_s_offs[k])
                                    new_g_parts = []
                                    new_g_spans = []
                                    ng_off = 0
                                    for idx_0 in range(total_code_lines):
                                        l_idx = idx_0 + 1
                                        extra = max(0, (v_starts[idx_0 + 1] - 1) - v_starts[idx_0])
                                        num_s = f"{l_idx:>4}"
                                        g_txt = num_s + ("\n" * extra)
                                        g_num_end = ng_off + len(num_s)
                                        g_tot_end = ng_off + len(g_txt)
                                        if l_idx in threat_lines_map:
                                            th_i = threat_lines_map[l_idx]
                                            th_c = (th_i.get("level") == "CRITICAL")
                                            fg_col = as_java_color(0xFFFF3B30 if th_c else 0xFFF59E0B)
                                            bg_col = th_crit_col if th_c else th_warn_col
                                            new_g_spans.append((ng_off, g_num_end, g_tot_end + 1, fg_col, bg_col))
                                        new_g_parts.append(g_txt)
                                        ng_off = g_tot_end + 1
                                    new_g_full = "\n".join(new_g_parts) + "\n"
                                    if new_g_spans and SpannableStringBuilder:
                                        new_g_sb = SpannableStringBuilder(new_g_full)
                                        for gs, ge, g_bg_e, fg_col, bg_col in new_g_spans:
                                            if ForegroundColorSpan:
                                                new_g_sb.setSpan(ForegroundColorSpan(fg_col), gs, ge, SPAN_EXCLUSIVE_EXCLUSIVE)
                                            if BackgroundColorSpan:
                                                new_g_sb.setSpan(BackgroundColorSpan(bg_col), gs, g_bg_e, SPAN_EXCLUSIVE_EXCLUSIVE)
                                        gutter_tv.setText(new_g_sb)
                                    else:
                                        gutter_tv.setText(new_g_full)
                                except Exception:
                                    pass
                        code_tv.post(GutterSync())
                else:
                    horiz_scroll = HorizontalScrollView(context)
                    try:
                        horiz_scroll.setHorizontalScrollBarEnabled(True)
                    except Exception:
                        pass
                    horiz_scroll.addView(code_tv, LayoutHelper.createFrame(-2, -2))
                    editor_box.addView(horiz_scroll, LayoutHelper.createLinear(0, -2, 1.0))

                code_view_ref[0] = code_tv
                vert_scroll.addView(editor_box, LayoutHelper.createFrame(-1, -2))

                code_card.setMinimumHeight(code_card_min_h)
                vert_scroll.setMinimumHeight(code_card_min_h)
                code_card.addView(vert_scroll, LayoutHelper.createFrame(-1, -1))
                content_box.addView(code_card, LayoutHelper.createLinear(-1, 0, 1.0))
                viewer_holder.setMinimumHeight(code_card_min_h)
                viewer_holder.addView(content_box, LayoutHelper.createFrame(-1, -1))

            if total_layers > 1:
                _style_tabs(0)
            viewer_holder.setMinimumHeight(code_card_min_h)
            root.addView(viewer_holder, LayoutHelper.createLinear(-1, 0, 1.0, 0, 0, 0, 8))

            close_frame = FrameLayout(context)
            close_bg = GradientDrawable()
            close_bg.setCornerRadius(float(AndroidUtilitiesClass.dp(20)))
            self._set_drawable_color(close_bg, monet_accent)
            close_frame.setBackground(close_bg)
            close_frame.setClickable(True)
            close_txt = TextView(context)
            close_txt.setText(_tr("Закрыть", "Close"))
            close_txt.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 14)
            close_txt.setTypeface(AndroidUtilitiesClass.bold())
            self._set_text_color(close_txt, 0xFFFFFFFF if is_dark_color(monet_accent) else 0xFF1C1B1F)
            close_frame.addView(close_txt, LayoutHelper.createFrame(-2, -2, Gravity.CENTER))

            class CloseClickListener(dynamic_proxy(View.OnClickListener)):
                def onClick(self_inner, v):
                    try:
                        _vibrate(v)
                        sheet.dismiss()
                    finally:
                        del v
            close_frame.setOnClickListener(CloseClickListener())
            root.addView(close_frame, LayoutHelper.createLinear(-1, 42, 0, 0, 4, 0, 0))

            try:
                sheet.setApplyTopPadding(False)
                sheet.setApplyBottomPadding(False)
            except Exception:
                pass
            class ViewerDismissListener(dynamic_proxy(find_class("android.content.DialogInterface$OnDismissListener"))):
                def onDismiss(self_d, d):
                    try:
                        if active_scroll_anim[0]:
                            try:
                                active_scroll_anim[0].cancel()
                            except Exception:
                                pass
                            active_scroll_anim[0] = None
                        viewer_holder.removeAllViews()
                        root.removeAllViews()
                        tab_views.clear()
                    except Exception:
                        pass
                    finally:
                        del d

            try:
                sheet.setOnDismissListener(ViewerDismissListener())
            except Exception:
                pass

            sheet.setCustomView(root)
            sheet.show()
            RunnableInit = find_class("java.lang.Runnable")
            if RunnableInit:
                class InitRenderTask(dynamic_proxy(RunnableInit)):
                    def run(self_ir):
                        try:
                            render_content(0)
                        except Exception:
                            pass
                viewer_holder.post(InitRenderTask())
            else:
                render_content(0)
        except Exception:
            pass

    def _show_report_bottom_sheet(self, context: Any, score: int, badge: str, reports: List[Dict[str, Any]], ai_stats: Dict[str, Any], has_critical: bool, file_path: str = ""):
        try:
            BottomSheet = find_class("org.telegram.ui.ActionBar.BottomSheet")
            ThemeClass = find_class("org.telegram.ui.ActionBar.Theme")
            LayoutHelper = find_class("org.telegram.ui.Components.LayoutHelper")
            LinearLayoutClass = find_class("android.widget.LinearLayout")
            ScrollView = find_class("android.widget.ScrollView")
            TextView = find_class("android.widget.TextView")
            ImageView = find_class("android.widget.ImageView")
            FrameLayout = find_class("android.widget.FrameLayout")
            View = find_class("android.view.View")
            TypedValue = find_class("android.util.TypedValue")
            Gravity = find_class("android.view.Gravity")
            GradientDrawable = find_class("android.graphics.drawable.GradientDrawable")
            AndroidUtilitiesClass = find_class("org.telegram.messenger.AndroidUtilities")
            ScaleStateListAnimator = find_class("org.telegram.ui.Components.ScaleStateListAnimator")

            if not BottomSheet or not context:
                return

            last_frag = get_last_fragment()
            resources_provider = self._get_theme_provider(last_frag) if last_frag else None

            monet_accent = self._get_monet_or_theme_accent(context, ThemeClass, resources_provider)
            is_dark = self._is_dark_theme(ThemeClass, resources_provider)
            sheet_container_bg = self._get_m3_surface_container(ThemeClass, resources_provider, level=1)
            card_surface_bg = self._get_m3_surface_container(ThemeClass, resources_provider, level=2)
            dialog_text_color = self._theme_color(ThemeClass, getattr(ThemeClass, "key_dialogTextBlack", None), 0xFFFFFFFF if is_dark else 0xFF1C1B1F, resources_provider)
            dialog_muted_color = self._theme_color(ThemeClass, getattr(ThemeClass, "key_dialogTextGray2", None), 0xFF9E9E9E if is_dark else 0xFF74777F, resources_provider)

            has_native_so_or_ctypes = any(
                "SO" in str(r.get("rule", "")).upper() or
                "CTYPES" in str(r.get("rule", "")).upper() or
                "NATIVE" in str(r.get("rule", "")).upper() or
                ".so" in str(r.get("detail", "")).lower() or
                "ctypes" in str(r.get("detail", "")).lower()
                for r in reports
            )

            is_safe = (score >= 80 and not has_critical and not has_native_so_or_ctypes)
            if has_native_so_or_ctypes and not has_critical and score >= 40:
                verdict_color = 0xFFF59E0B if is_dark else 0xFFD97706
                verdict_title = _tr("Нативный код (.so)", "Native code (.so)")
                top_vector_type = "shield_alert"
                monet_accent = verdict_color
            elif is_safe:
                verdict_color = 0xFF22C55E if is_dark else 0xFF16A34A
                verdict_title = _tr("Безопасно", "Safe")
                top_vector_type = "shield_check"
                monet_accent = verdict_color
            elif score >= 70 and not has_critical:
                verdict_color = 0xFF38BDF8 if is_dark else 0xFF0284C7
                verdict_title = _tr("Низкий риск", "Low Risk")
                top_vector_type = "shield_check"
            elif score >= 40 and not has_critical:
                verdict_color = 0xFFF59E0B if is_dark else 0xFFD97706
                verdict_title = _tr("Подозрительно", "Suspicious")
                top_vector_type = "shield_alert"
            else:
                verdict_color = 0xFFEF4444 if is_dark else 0xFFDC2626
                verdict_title = _tr("Опасность!", "Danger!")
                top_vector_type = "shield_alert"

            sheet = BottomSheet(context, False)
            sheet._kpm_custom_sheet = True
            self._fix_sheet_navigation_bar(sheet, sheet_container_bg)

            root = LinearLayoutClass(context)
            root.setOrientation(LinearLayoutClass.VERTICAL)
            root.setPadding(
                AndroidUtilitiesClass.dp(20),
                AndroidUtilitiesClass.dp(12),
                AndroidUtilitiesClass.dp(20),
                AndroidUtilitiesClass.dp(18)
            )
            self._set_background_color(root, sheet_container_bg)

            drag_handle = View(context)
            drag_bg = GradientDrawable()
            drag_bg.setCornerRadius(float(AndroidUtilitiesClass.dp(2)))
            handle_color = with_alpha(dialog_muted_color, 0x50)
            self._set_drawable_color(drag_bg, handle_color)
            drag_handle.setBackground(drag_bg)
            root.addView(drag_handle, LayoutHelper.createLinear(36, 4, Gravity.CENTER_HORIZONTAL, 0, 0, 0, 16))

            plugin_name_str = os.path.basename(file_path) if file_path else _tr("Плагин", "Plugin")
            plugin_initial = (plugin_name_str[:1].upper() if plugin_name_str else "P")

            icon_holder = FrameLayout(context)

            avatar_frame = FrameLayout(context)
            avatar_bg = GradientDrawable()
            avatar_bg.setShape(GradientDrawable.OVAL)
            self._set_drawable_color(avatar_bg, card_surface_bg)
            self._set_drawable_stroke(avatar_bg, AndroidUtilitiesClass.dp(2), with_alpha(verdict_color, 0x55 if is_dark else 0x40))
            avatar_frame.setBackground(avatar_bg)

            icon_loaded = False
            if file_path and os.path.exists(file_path):
                try:
                    icon_val = None
                    with open(file_path, "r", encoding="utf-8", errors="ignore") as f:
                        for _ in range(120):
                            line = f.readline()
                            if not line:
                                break
                            m = re.search(r'__icon__\s*=\s*["\']([^"\']+)["\']', line)
                            if m:
                                icon_val = m.group(1).strip()
                                break
                    if icon_val and "/" in icon_val:
                        parts = icon_val.split("/", 1)
                        pack_name = parts[0].strip()
                        icon_idx = int(parts[1].strip())
                        BackupImageView = find_class("org.telegram.ui.Components.BackupImageView")
                        MediaDataController = find_class("org.telegram.messenger.MediaDataController")
                        UserConfig = find_class("org.telegram.messenger.UserConfig")
                        if BackupImageView and MediaDataController:
                            biv = BackupImageView(context)
                            biv.setRoundRadius(AndroidUtilitiesClass.dp(32))
                            sel_acc = getattr(UserConfig, "selectedAccount", 0) if UserConfig else 0
                            mdc = MediaDataController.getInstance(sel_acc)
                            if mdc:
                                mdc.setPlaceholderImageByIndex(biv, pack_name, icon_idx, "78_78")
                                avatar_frame.addView(biv, LayoutHelper.createFrame(64, 64, Gravity.CENTER))
                                icon_loaded = True
                except Exception:
                    pass

            if not icon_loaded:
                avatar_text = TextView(context)
                avatar_text.setText(plugin_initial)
                avatar_text.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 26)
                avatar_text.setTypeface(AndroidUtilitiesClass.bold())
                avatar_text.setGravity(Gravity.CENTER)
                self._set_text_color(avatar_text, verdict_color)
                avatar_frame.addView(avatar_text, LayoutHelper.createFrame(-1, -1, Gravity.CENTER))

            icon_holder.addView(avatar_frame, LayoutHelper.createFrame(64, 64, Gravity.CENTER))

            badge_frame = FrameLayout(context)
            badge_bg = GradientDrawable()
            badge_bg.setShape(GradientDrawable.OVAL)
            self._set_drawable_color(badge_bg, sheet_container_bg)
            badge_frame.setBackground(badge_bg)
            badge_frame.setPadding(
                AndroidUtilitiesClass.dp(2),
                AndroidUtilitiesClass.dp(2),
                AndroidUtilitiesClass.dp(2),
                AndroidUtilitiesClass.dp(2)
            )

            badge_inner = FrameLayout(context)
            badge_inner_bg = GradientDrawable()
            badge_inner_bg.setShape(GradientDrawable.OVAL)
            self._set_drawable_color(badge_inner_bg, verdict_color)
            badge_inner.setBackground(badge_inner_bg)

            icon_view = ImageView(context)
            icon_view.clearColorFilter()
            top_vector = self._create_vector_drawable(top_vector_type, 0xFFFFFFFF, size_dp=18, context=context)
            if top_vector:
                icon_view.setImageDrawable(top_vector)
            else:
                try:
                    RClass = find_class("org.telegram.messenger.R$drawable")
                    fallback_res = getattr(RClass, "msg2_block2", None) if top_vector_type != "shield_check" else getattr(RClass, "menu_feature_reliable", None)
                    if fallback_res:
                        icon_view.setImageResource(int(fallback_res))
                        self._set_color_filter(icon_view, 0xFFFFFFFF)
                except Exception:
                    pass
            badge_inner.addView(icon_view, LayoutHelper.createFrame(18, 18, Gravity.CENTER))
            badge_frame.addView(badge_inner, LayoutHelper.createFrame(26, 26, Gravity.CENTER))

            icon_holder.addView(badge_frame, LayoutHelper.createFrame(30, 30, Gravity.BOTTOM | Gravity.RIGHT, 0, 0, 0, 0))
            root.addView(icon_holder, LayoutHelper.createLinear(72, 72, Gravity.CENTER_HORIZONTAL, 0, 0, 0, 10))

            title_view = TextView(context)
            title_view.setText(f"PluginGuard: {verdict_title}")
            title_view.setGravity(Gravity.CENTER)
            title_view.setTypeface(AndroidUtilitiesClass.bold())
            title_view.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 20)
            self._set_text_color(title_view, dialog_text_color)
            root.addView(title_view, LayoutHelper.createLinear(-1, -2, Gravity.CENTER_HORIZONTAL, 0, 0, 0, 4))

            plugin_name_str = os.path.basename(file_path) if file_path else _tr("Плагин", "Plugin")
            subtitle_view = TextView(context)
            subtitle_view.setText(plugin_name_str)
            subtitle_view.setGravity(Gravity.CENTER)
            subtitle_view.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13)
            self._set_text_color(subtitle_view, dialog_muted_color)
            root.addView(subtitle_view, LayoutHelper.createLinear(-1, -2, Gravity.CENTER_HORIZONTAL, 0, 0, 0, 4))

            scanner_ver = globals().get("__version__", "1.4.3")
            m_ver = str(ai_stats.get("model_version") or "2.3.3")
            ver_meta_tv = TextView(context)
            ver_meta_tv.setText(f"PG v{scanner_ver} | Model v{m_ver}")
            ver_meta_tv.setGravity(Gravity.CENTER)
            ver_meta_tv.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 11)
            ver_meta_tv.setTypeface(AndroidUtilitiesClass.bold())
            self._set_text_color(ver_meta_tv, with_alpha(dialog_muted_color, 0x90 if is_dark else 0x80))
            root.addView(ver_meta_tv, LayoutHelper.createLinear(-1, -2, Gravity.CENTER_HORIZONTAL, 0, 0, 0, 12))

            def create_chip(text: str, text_color: int, bg_color: int):
                chip_frame = FrameLayout(context)
                chip_bg = GradientDrawable()
                chip_bg.setCornerRadius(float(AndroidUtilitiesClass.dp(8)))
                self._set_drawable_color(chip_bg, bg_color)
                chip_frame.setBackground(chip_bg)

                chip_layout = LinearLayoutClass(context)
                chip_layout.setOrientation(LinearLayoutClass.HORIZONTAL)
                chip_layout.setGravity(Gravity.CENTER)
                chip_layout.setPadding(
                    AndroidUtilitiesClass.dp(12),
                    AndroidUtilitiesClass.dp(6),
                    AndroidUtilitiesClass.dp(12),
                    AndroidUtilitiesClass.dp(6)
                )

                chip_text = TextView(context)
                chip_text.setText(text)
                chip_text.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 12)
                chip_text.setTypeface(AndroidUtilitiesClass.bold())
                self._set_text_color(chip_text, text_color)
                chip_layout.addView(chip_text, LayoutHelper.createLinear(-2, -2, Gravity.CENTER_VERTICAL))
                chip_frame.addView(chip_layout, LayoutHelper.createFrame(-2, -2, Gravity.CENTER))
                return chip_frame

            def create_divider():
                d_view = View(context)
                self._set_background_color(d_view, with_alpha(dialog_muted_color, 0x24 if is_dark else 0x1E))
                return d_view

            is_self_scan = "pluginguard" in file_path.lower() or "plugin_guard" in file_path.lower() or "plugin guard" in plugin_name_str.lower()
            chip_badge_str = _tr("Самопроверка", "Self-Scan") if is_self_scan else badge
            chip_col = (0xFF38BDF8 if is_dark else 0xFF0284C7) if is_self_scan else verdict_color
            verdict_chip = create_chip(chip_badge_str, chip_col, with_alpha(chip_col, 0x20 if is_dark else 0x16))
            if ScaleStateListAnimator:
                try:
                    ScaleStateListAnimator.apply(verdict_chip, 0.04, 1.2)
                except Exception:
                    pass
            if ai_stats.get("dex_found"):
                chips_row = LinearLayoutClass(context)
                chips_row.setOrientation(LinearLayoutClass.HORIZONTAL)
                chips_row.setGravity(Gravity.CENTER)
                chips_row.addView(verdict_chip, LayoutHelper.createLinear(-2, -2, 0, 0, 4, 0, 4))
                dex_ok = ai_stats.get("dex_decompiled", False)
                dex_chip_color = 0xFF4CAF50 if dex_ok else 0xFFF44336
                dex_chip_text = _tr("DEX: декомпилирован", "DEX: decompiled") if dex_ok else _tr("DEX: ошибка", "DEX: failed")
                dex_chip = create_chip(dex_chip_text, dex_chip_color, with_alpha(dex_chip_color, 0x20 if is_dark else 0x16))
                chips_row.addView(dex_chip, LayoutHelper.createLinear(-2, -2, 0, 4, 0, 4, 0))
                root.addView(chips_row, LayoutHelper.createLinear(-2, -2, Gravity.CENTER_HORIZONTAL, 0, 0, 0, 10))
            else:
                root.addView(verdict_chip, LayoutHelper.createLinear(-2, -2, Gravity.CENTER_HORIZONTAL, 0, 0, 0, 10))

            score_row = LinearLayoutClass(context)
            score_row.setOrientation(LinearLayoutClass.HORIZONTAL)
            score_row.setGravity(Gravity.CENTER_VERTICAL)

            score_label = TextView(context)
            score_label.setText(_tr("Оценка безопасности PluginGuard", "PluginGuard security score"))
            score_label.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 12)
            score_label.setTypeface(AndroidUtilitiesClass.bold())
            self._set_text_color(score_label, dialog_muted_color)
            score_row.addView(score_label, LayoutHelper.createLinear(0, -2, 1.0, Gravity.CENTER_VERTICAL))

            score_val_tv = TextView(context)
            score_val_tv.setText(f"{score}/100")
            score_val_tv.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13)
            score_val_tv.setTypeface(AndroidUtilitiesClass.bold())
            self._set_text_color(score_val_tv, verdict_color)
            score_row.addView(score_val_tv, LayoutHelper.createLinear(-2, -2, Gravity.CENTER_VERTICAL))

            root.addView(score_row, LayoutHelper.createLinear(-1, -2, 0, 4, 0, 4, 2))

            track_h_dp = 4
            track_radius = float(AndroidUtilitiesClass.dp(track_h_dp))

            progress_container = FrameLayout(context)

            track_bg = GradientDrawable()
            track_bg.setColor(as_java_color(with_alpha(verdict_color, 0x26)))
            track_bg.setCornerRadius(track_radius)
            progress_container.setBackground(track_bg)

            ratio = max(0.0, min(1.0, float(score) / 100.0))

            active_view = View(context)
            active_bg = GradientDrawable()
            active_bg.setColor(as_java_color(verdict_color))
            active_bg.setCornerRadius(track_radius)
            active_view.setBackground(active_bg)

            active_lp = FrameLayout.LayoutParams(0, FrameLayout.LayoutParams.MATCH_PARENT)
            active_lp.gravity = Gravity.LEFT | Gravity.CENTER_VERTICAL
            active_view.setLayoutParams(active_lp)
            progress_container.addView(active_view)

            root.addView(progress_container, LayoutHelper.createLinear(-1, track_h_dp, 0, 8, 0, 14))

            try:
                OnLayoutChangeListener = find_class("android.view.View$OnLayoutChangeListener")
                ValueAnimator = find_class("android.animation.ValueAnimator")
                DecelerateInterpolator = find_class("android.view.animation.DecelerateInterpolator")
                AnimatorUpdateListener = find_class("android.animation.ValueAnimator$AnimatorUpdateListener")
                if OnLayoutChangeListener:
                    anim_started = [False]
                    class ProgressLayoutListener(dynamic_proxy(OnLayoutChangeListener)):
                        def onLayoutChange(self_inner, v, left, top, right, bottom, oldLeft, oldTop, oldRight, oldBottom):
                            try:
                                total_w = int(right - left)
                                if total_w > 0 and not anim_started[0]:
                                    anim_started[0] = True
                                    target_w = max(0, int(total_w * ratio))
                                    if ValueAnimator and AnimatorUpdateListener and target_w > 0:
                                        score_val_tv.setText("0/100")
                                        anim = ValueAnimator.ofFloat([0.0, 1.0])
                                        anim.setDuration(950)
                                        anim.setStartDelay(180)
                                        if DecelerateInterpolator:
                                            anim.setInterpolator(DecelerateInterpolator(1.8))
                                        class AnimUpdateListener(dynamic_proxy(AnimatorUpdateListener)):
                                            def onAnimationUpdate(self_u, animation):
                                                try:
                                                    frac = float(animation.getAnimatedValue())
                                                    cur_w = int(target_w * frac)
                                                    lp = active_view.getLayoutParams()
                                                    if lp:
                                                        lp.width = cur_w
                                                        active_view.setLayoutParams(lp)
                                                    cur_score = int(score * frac)
                                                    score_val_tv.setText(f"{cur_score}/100")
                                                except Exception:
                                                    pass
                                                finally:
                                                    del animation
                                        anim.addUpdateListener(AnimUpdateListener())
                                        anim.start()
                                    else:
                                        lp = active_view.getLayoutParams()
                                        if lp:
                                            lp.width = target_w
                                            active_view.setLayoutParams(lp)
                                        score_val_tv.setText(f"{score}/100")
                            except Exception:
                                pass
                            finally:
                                del v
                    progress_container.addOnLayoutChangeListener(ProgressLayoutListener())
            except Exception:
                pass

            scroll_view = ScrollView(context)
            scroll_view.setVerticalScrollBarEnabled(False)
            try:
                scroll_view.setNestedScrollingEnabled(True)
            except Exception:
                pass
            try:
                scroll_view.setFillViewport(True)
            except Exception:
                pass

            class ScrollTouchListener(dynamic_proxy(View.OnTouchListener)):
                def onTouch(self_inner, v, event):
                    try:
                        p = v.getParent()
                        if p:
                            p.requestDisallowInterceptTouchEvent(True)
                    except Exception:
                        pass
                    finally:
                        del v, event
                    return False

            scroll_view.setOnTouchListener(ScrollTouchListener())
            scroll_layout = LinearLayoutClass(context)
            scroll_layout.setOrientation(LinearLayoutClass.VERTICAL)

            def create_copy_listener(text_to_copy: str):
                class RowLongClickListener(dynamic_proxy(find_class("android.view.View$OnLongClickListener"))):
                    def onLongClick(self_l, v):
                        try:
                            _vibrate(v, haptic_type="long")
                            AndroidUtilitiesClass.addToClipboard(text_to_copy)
                            try:
                                BulletinHelper.show_success(_tr("Детали скопированы", "Details copied"))
                            except Exception:
                                pass
                            return True
                        except Exception:
                            return False
                        finally:
                            del v
                return RowLongClickListener()

            def create_issue_card(title: str, items: Any, color: int, icon_type: str = "warning", collapsible: bool = False, initially_collapsed: bool = False, badge_text: str = ""):
                card_frame = FrameLayout(context)
                card_bg = GradientDrawable()
                card_bg.setCornerRadius(float(AndroidUtilitiesClass.dp(16)))
                self._set_drawable_color(card_bg, with_alpha(color, 0x1A if is_dark else 0x12))
                self._set_drawable_stroke(card_bg, AndroidUtilitiesClass.dp(1), with_alpha(color, 0x38 if is_dark else 0x2A))
                card_frame.setBackground(card_bg)

                card_frame.setClipChildren(True)
                card_frame.setClipToPadding(True)

                card_layout = LinearLayoutClass(context)
                card_layout.setOrientation(LinearLayoutClass.VERTICAL)
                card_layout.setClipChildren(True)
                card_layout.setClipToPadding(True)
                card_layout.setPadding(
                    AndroidUtilitiesClass.dp(16),
                    AndroidUtilitiesClass.dp(14),
                    AndroidUtilitiesClass.dp(16),
                    AndroidUtilitiesClass.dp(14)
                )

                header_layout = LinearLayoutClass(context)
                header_layout.setOrientation(LinearLayoutClass.HORIZONTAL)
                header_layout.setGravity(Gravity.CENTER_VERTICAL)

                t_view = TextView(context)
                t_view.setText(title)
                t_view.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 14)
                t_view.setTypeface(AndroidUtilitiesClass.bold())
                self._set_text_color(t_view, color)

                content_layout = LinearLayoutClass(context)
                content_layout.setOrientation(LinearLayoutClass.VERTICAL)
                content_layout.setClipChildren(True)
                content_layout.setClipToPadding(True)
                content_layout.setPadding(0, AndroidUtilitiesClass.dp(8), 0, 0)

                if collapsible:
                    header_layout.addView(t_view, LayoutHelper.createLinear(-2, -2, Gravity.CENTER_VERTICAL, 0, 0, 8, 0))
                    if badge_text:
                        badge_layout = FrameLayout(context)
                        badge_bg = GradientDrawable()
                        badge_bg.setCornerRadius(float(AndroidUtilitiesClass.dp(6)))
                        self._set_drawable_color(badge_bg, with_alpha(0xFFEF4444 if is_dark else 0xFFDC2626, 0x28))
                        self._set_drawable_stroke(badge_bg, AndroidUtilitiesClass.dp(1), with_alpha(0xFFEF4444 if is_dark else 0xFFDC2626, 0x70))
                        badge_layout.setBackground(badge_bg)
                        badge_layout.setPadding(
                            AndroidUtilitiesClass.dp(6),
                            AndroidUtilitiesClass.dp(2),
                            AndroidUtilitiesClass.dp(6),
                            AndroidUtilitiesClass.dp(2)
                        )
                        badge_tv = TextView(context)
                        badge_tv.setText(badge_text)
                        badge_tv.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 10)
                        badge_tv.setTypeface(AndroidUtilitiesClass.bold())
                        self._set_text_color(badge_tv, 0xFFEF4444 if is_dark else 0xFFDC2626)
                        badge_layout.addView(badge_tv, LayoutHelper.createFrame(-2, -2, Gravity.CENTER))
                        header_layout.addView(badge_layout, LayoutHelper.createLinear(-2, -2, Gravity.CENTER_VERTICAL, 0, 0, 8, 0))

                    spacer = View(context)
                    header_layout.addView(spacer, LayoutHelper.createLinear(0, 0, 1.0))

                    chevron_view = ImageView(context)
                    self._apply_icon_to_view(chevron_view, "chevron_down", color, size_dp=18, context=context)
                    if not initially_collapsed:
                        chevron_view.setRotation(180.0)
                    header_layout.addView(chevron_view, LayoutHelper.createLinear(18, 18, Gravity.CENTER_VERTICAL))

                    is_expanded = [not initially_collapsed]
                    current_animator = [None]
                    if initially_collapsed:
                        content_layout.setVisibility(View.GONE)

                    class CardHeaderClickListener(dynamic_proxy(View.OnClickListener)):
                        def onClick(self_inner, v):
                            try:
                                _vibrate(v)

                                is_expanded[0] = not is_expanded[0]
                                expanding = is_expanded[0]

                                if current_animator[0]:
                                    try:
                                        current_animator[0].cancel()
                                    except Exception:
                                        pass

                                ValueAnimator = find_class("android.animation.ValueAnimator")
                                CubicBezierInterpolator = find_class("org.telegram.ui.Components.CubicBezierInterpolator")
                                interpolator = getattr(CubicBezierInterpolator, "EASE_OUT_QUINT", None) if CubicBezierInterpolator else None

                                if hasattr(chevron_view, "animate"):
                                    chevron_view.animate().rotation(180.0 if expanding else 0.0).setDuration(220).start()
                                else:
                                    chevron_view.setRotation(180.0 if expanding else 0.0)

                                if expanding:
                                    content_layout.setVisibility(View.VISIBLE)
                                    content_layout.setAlpha(0.0)
                                    w = card_layout.getWidth() - AndroidUtilitiesClass.dp(32)
                                    if w <= 0:
                                        w = AndroidUtilitiesClass.dp(300)
                                    View_MeasureSpec = find_class("android.view.View$MeasureSpec")
                                    spec_w = View_MeasureSpec.makeMeasureSpec(w, View_MeasureSpec.EXACTLY)
                                    spec_h = View_MeasureSpec.makeMeasureSpec(0, View_MeasureSpec.UNSPECIFIED)
                                    content_layout.measure(spec_w, spec_h)
                                    target_h = content_layout.getMeasuredHeight()
                                    if target_h <= 0:
                                        target_h = AndroidUtilitiesClass.dp(160)
                                    start_h = 0
                                    end_h = target_h
                                else:
                                    start_h = content_layout.getHeight()
                                    if start_h <= 0:
                                        start_h = content_layout.getMeasuredHeight()
                                    end_h = 0

                                if ValueAnimator:
                                    anim = ValueAnimator.ofFloat([0.0, 1.0])
                                    anim.setDuration(220)
                                    if interpolator:
                                        try:
                                            anim.setInterpolator(interpolator)
                                        except Exception:
                                            pass

                                    class AnimUpdate(dynamic_proxy(find_class("android.animation.ValueAnimator$AnimatorUpdateListener"))):
                                        def onAnimationUpdate(self_u, *args):
                                            try:
                                                animation = args[0] if args else None
                                                if animation:
                                                    frac = float(animation.getAnimatedValue())
                                                    cur_h = int(start_h + (end_h - start_h) * frac)
                                                    lp = content_layout.getLayoutParams()
                                                    if lp:
                                                        lp.height = max(0, cur_h)
                                                        content_layout.setLayoutParams(lp)
                                                    content_layout.setAlpha(frac if expanding else (1.0 - frac))
                                            except Exception:
                                                pass

                                    class AnimEnd(dynamic_proxy(find_class("android.animation.Animator$AnimatorListener"))):
                                        def onAnimationEnd(self_e, *args):
                                            try:
                                                if not expanding:
                                                    content_layout.setVisibility(View.GONE)
                                                lp = content_layout.getLayoutParams()
                                                if lp:
                                                    lp.height = -2
                                                    content_layout.setLayoutParams(lp)
                                                content_layout.setAlpha(1.0)
                                            except Exception:
                                                pass
                                        def onAnimationStart(self_e, *args):
                                            pass
                                        def onAnimationCancel(self_e, *args):
                                            pass
                                        def onAnimationRepeat(self_e, *args):
                                            pass

                                    anim.addUpdateListener(AnimUpdate())
                                    anim.addListener(AnimEnd())
                                    current_animator[0] = anim
                                    anim.start()
                                else:
                                    content_layout.setVisibility(View.VISIBLE if expanding else View.GONE)
                            except Exception:
                                content_layout.setVisibility(View.VISIBLE if is_expanded[0] else View.GONE)
                            finally:
                                del v

                    header_layout.setClickable(True)
                    header_layout.setFocusable(True)
                    header_layout.setOnClickListener(CardHeaderClickListener())
                else:
                    header_layout.addView(t_view, LayoutHelper.createLinear(-2, -2, Gravity.CENTER_VERTICAL))

                card_layout.addView(header_layout, LayoutHelper.createLinear(-1, -2))

                lines_list = items if isinstance(items, list) else [items]
                for idx, item in enumerate(lines_list):
                    if idx > 0:
                        content_layout.addView(create_divider(), LayoutHelper.createLinear(-1, 1, 0, 0, 8, 0, 8))
                    if isinstance(item, dict):
                        item_title = str(item.get("title", "")).lstrip("•").strip()
                        item_detail = str(item.get("detail", "")).strip()
                        item_rule = str(item.get("rule", "")).strip()
                    elif isinstance(item, str):
                        parts = item.split("\n", 1)
                        item_title = parts[0].lstrip("•").strip()
                        item_detail = parts[1].strip() if len(parts) > 1 else ""
                        item_rule = ""
                    else:
                        item_title = str(item).lstrip("•").strip()
                        item_detail = ""
                        item_rule = ""

                    row = LinearLayoutClass(context)
                    row.setOrientation(LinearLayoutClass.HORIZONTAL)
                    row.setGravity(Gravity.TOP)
                    row.setClickable(True)
                    row.setFocusable(True)
                    copy_text = f"{item_title} [{item_rule}]\n{item_detail}" if item_rule and item_detail else (item_title + (f"\n{item_detail}" if item_detail else ""))
                    row.setOnLongClickListener(create_copy_listener(copy_text))

                    pill = View(context)
                    pill_bg = GradientDrawable()
                    pill_bg.setCornerRadius(float(AndroidUtilitiesClass.dp(2)))
                    self._set_drawable_color(pill_bg, color)
                    pill.setBackground(pill_bg)
                    row.addView(pill, LayoutHelper.createLinear(3, 14, 0, 0, 2, 8, 0))

                    text_col = LinearLayoutClass(context)
                    text_col.setOrientation(LinearLayoutClass.VERTICAL)

                    it_title_view = TextView(context)
                    it_title_view.setText(item_title)
                    it_title_view.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13)
                    it_title_view.setTypeface(AndroidUtilitiesClass.bold())
                    self._set_text_color(it_title_view, dialog_text_color)
                    text_col.addView(it_title_view, LayoutHelper.createLinear(-1, -2))

                    if item_detail:
                        it_desc_view = TextView(context)
                        it_desc_view.setText(item_detail)
                        it_desc_view.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 12)
                        self._set_text_color(it_desc_view, dialog_muted_color)
                        try:
                            it_desc_view.setLineSpacing(AndroidUtilitiesClass.dp(1), 1.1)
                        except Exception:
                            pass
                        text_col.addView(it_desc_view, LayoutHelper.createLinear(-1, -2, 0, 0, 2, 0, 0))

                    row.addView(text_col, LayoutHelper.createLinear(0, -2, 1.0))
                    content_layout.addView(row, LayoutHelper.createLinear(-1, -2))

                card_layout.addView(content_layout, LayoutHelper.createLinear(-1, -2))
                card_frame.addView(card_layout, LayoutHelper.createFrame(-1, -2))
                return card_frame

            def create_peek_card(payloads: List[Dict[str, Any]], on_click):
                card_frame = FrameLayout(context)
                accent = monet_accent
                card_bg = GradientDrawable()
                card_bg.setCornerRadius(float(AndroidUtilitiesClass.dp(16)))
                self._set_drawable_color(card_bg, with_alpha(accent, 0x1A if is_dark else 0x10))
                self._set_drawable_stroke(card_bg, AndroidUtilitiesClass.dp(1), with_alpha(accent, 0x48 if is_dark else 0x30))
                card_frame.setBackground(card_bg)
                card_frame.setClickable(True)
                card_frame.setFocusable(True)

                class PeekClickListener(dynamic_proxy(View.OnClickListener)):
                    def onClick(self_inner, v):
                        try:
                            _vibrate(v)
                            on_click()
                        finally:
                            del v
                card_frame.setOnClickListener(PeekClickListener())

                card_layout = LinearLayoutClass(context)
                card_layout.setOrientation(LinearLayoutClass.VERTICAL)
                card_layout.setPadding(
                    AndroidUtilitiesClass.dp(16),
                    AndroidUtilitiesClass.dp(14),
                    AndroidUtilitiesClass.dp(16),
                    AndroidUtilitiesClass.dp(14)
                )

                sub_cnt = len(payloads)
                sub_threats = sum(len(p.get("threats", [])) for p in payloads)

                line1_view = TextView(context)
                line1_view.setText(_tr("Открыть инспектор кода", "Open code inspector"))
                line1_view.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 14)
                line1_view.setTypeface(AndroidUtilitiesClass.bold())
                self._set_text_color(line1_view, accent)
                card_layout.addView(line1_view, LayoutHelper.createLinear(-2, -2))

                line2_view = TextView(context)
                line2_view.setText(_tr("Полезная нагрузка", "Unpacked payload"))
                line2_view.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13)
                self._set_text_color(line2_view, dialog_text_color)
                card_layout.addView(line2_view, LayoutHelper.createLinear(-2, -2, 0, 0, 2, 0, 0))

                verb = "Распакован" if (abs(sub_cnt) % 10 == 1 and abs(sub_cnt) % 100 != 11) else "Распаковано"
                sub_msg = _tr(f"{verb} {_plural_layers(sub_cnt)}, {_plural_threats(sub_threats)}", f"Unpacked {_plural_layers(sub_cnt)}, {_plural_threats(sub_threats)}")
                line3_view = TextView(context)
                line3_view.setText(sub_msg)
                line3_view.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 12)
                self._set_text_color(line3_view, dialog_muted_color)
                card_layout.addView(line3_view, LayoutHelper.createLinear(-2, -2, 0, 0, 2, 0, 0))

                card_frame.addView(card_layout, LayoutHelper.createFrame(-1, -2))
                return card_frame

            def create_note_card(title: str, description: Any, accent_color: int, icon_type: str = ""):
                card_frame = FrameLayout(context)
                card_bg = GradientDrawable()
                card_bg.setCornerRadius(float(AndroidUtilitiesClass.dp(16)))
                self._set_drawable_color(card_bg, with_alpha(card_surface_bg, 0xFF))
                self._set_drawable_stroke(card_bg, AndroidUtilitiesClass.dp(1), with_alpha(accent_color, 0x30 if is_dark else 0x22))
                card_frame.setBackground(card_bg)

                card_layout = LinearLayoutClass(context)
                card_layout.setOrientation(LinearLayoutClass.VERTICAL)
                card_layout.setPadding(
                    AndroidUtilitiesClass.dp(16),
                    AndroidUtilitiesClass.dp(14),
                    AndroidUtilitiesClass.dp(16),
                    AndroidUtilitiesClass.dp(14)
                )

                header_layout = LinearLayoutClass(context)
                header_layout.setOrientation(LinearLayoutClass.HORIZONTAL)
                header_layout.setGravity(Gravity.CENTER_VERTICAL)

                t_view = TextView(context)
                t_view.setText(title)
                t_view.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 14)
                t_view.setTypeface(AndroidUtilitiesClass.bold())
                self._set_text_color(t_view, accent_color)
                header_layout.addView(t_view, LayoutHelper.createLinear(-2, -2, Gravity.CENTER_VERTICAL))

                card_layout.addView(header_layout, LayoutHelper.createLinear(-1, -2, 0, 0, 0, 0, 8))

                if isinstance(description, list) or (isinstance(description, str) and "\n" in description):
                    lines_list = description if isinstance(description, list) else [x.strip() for x in description.split("\n") if x.strip()]
                    for idx, item_text in enumerate(lines_list):
                        if idx > 0:
                            card_layout.addView(create_divider(), LayoutHelper.createLinear(-1, 1, 0, 0, 8, 0, 8))
                        cleaned_text = item_text.lstrip("•").strip()
                        row = LinearLayoutClass(context)
                        row.setOrientation(LinearLayoutClass.HORIZONTAL)
                        row.setGravity(Gravity.TOP)
                        row.setClickable(True)
                        row.setFocusable(True)
                        row.setOnLongClickListener(create_copy_listener(cleaned_text))

                        pill = View(context)
                        pill_bg = GradientDrawable()
                        pill_bg.setCornerRadius(float(AndroidUtilitiesClass.dp(2)))
                        self._set_drawable_color(pill_bg, with_alpha(accent_color, 0x90))
                        pill.setBackground(pill_bg)
                        row.addView(pill, LayoutHelper.createLinear(3, 14, 0, 0, 2, 8, 0))

                        it_view = TextView(context)
                        it_view.setText(cleaned_text)
                        it_view.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13)
                        self._set_text_color(it_view, dialog_text_color)
                        try:
                            it_view.setLineSpacing(AndroidUtilitiesClass.dp(2), 1.15)
                        except Exception:
                            pass
                        row.addView(it_view, LayoutHelper.createLinear(-1, -2))
                        card_layout.addView(row, LayoutHelper.createLinear(-1, -2))
                else:
                    d_text = str(description).lstrip("•").strip()
                    d_view = TextView(context)
                    d_view.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13)
                    self._set_text_color(d_view, dialog_text_color)
                    try:
                        d_view.setLineSpacing(AndroidUtilitiesClass.dp(3), 1.15)
                    except Exception:
                        pass
                    mention_tag = "@DefinitelyNotDekma"
                    if mention_tag in d_text:
                        m_start = d_text.find(mention_tag)
                        m_end = m_start + len(mention_tag)
                        link_col = as_java_color(0xFF38BDF8 if is_dark else 0xFF0284C7)
                        try:
                            SpannableStringBuilder = find_class("android.text.SpannableStringBuilder")
                            ForegroundColorSpan = find_class("android.text.style.ForegroundColorSpan")
                            StyleSpan = find_class("android.text.style.StyleSpan")
                            sb_d = SpannableStringBuilder(d_text)
                            if ForegroundColorSpan:
                                sb_d.setSpan(ForegroundColorSpan(link_col), m_start, m_end, 33)
                            if StyleSpan:
                                sb_d.setSpan(StyleSpan(1), m_start, m_end, 33)
                            d_view.setText(sb_d)
                        except Exception:
                            d_view.setText(d_text)

                        class ChannelTouchListener(dynamic_proxy(View.OnTouchListener)):
                            def onTouch(self_ct, v, event):
                                try:
                                    act = event.getAction()
                                    if act in (0, 1):
                                        lay = v.getLayout()
                                        if lay:
                                            tx = int(event.getX()) - v.getTotalPaddingLeft() + v.getScrollX()
                                            ty = int(event.getY()) - v.getTotalPaddingTop() + v.getScrollY()
                                            ln = lay.getLineForVertical(ty)
                                            off = lay.getOffsetForHorizontal(ln, float(tx))
                                            if m_start <= off <= m_end:
                                                if act == 1:
                                                    _vibrate(v)
                                                    try:
                                                        sheet.dismiss()
                                                    except Exception:
                                                        pass
                                                    try:
                                                        inst_sh = getattr(self, "_current_sheet", None)
                                                        if inst_sh:
                                                            inst_sh.dismiss()
                                                    except Exception:
                                                        pass
                                                    mc_cls = find_class("org.telegram.messenger.MessagesController")
                                                    uc_cls = find_class("org.telegram.messenger.UserConfig")
                                                    br_cls = find_class("org.telegram.messenger.browser.Browser")
                                                    opened = False
                                                    if mc_cls and last_frag:
                                                        try:
                                                            acc = getattr(uc_cls, "selectedAccount", 0) if uc_cls else 0
                                                            mc_cls.getInstance(acc).openByUserName("DefinitelyNotDekma", last_frag, 1)
                                                            opened = True
                                                        except Exception:
                                                            pass
                                                    if not opened and br_cls:
                                                        br_cls.openUrl(context, "https://t.me/DefinitelyNotDekma")
                                                return True
                                except Exception:
                                    pass
                                finally:
                                    del v, event
                                return False
                        d_view.setOnTouchListener(ChannelTouchListener())
                    else:
                        d_view.setText(d_text)
                        d_view.setClickable(True)
                        d_view.setFocusable(True)
                        d_view.setOnLongClickListener(create_copy_listener(d_text))
                    card_layout.addView(d_view, LayoutHelper.createLinear(-1, -2))

                card_frame.addView(card_layout, LayoutHelper.createFrame(-1, -2))
                return card_frame

            def create_heatmap_card():
                card_frame = FrameLayout(context)
                card_frame.setClipChildren(False)
                card_frame.setClipToPadding(False)
                card_bg = GradientDrawable()
                card_bg.setCornerRadius(float(AndroidUtilitiesClass.dp(16)))
                self._set_drawable_color(card_bg, with_alpha(card_surface_bg, 0xFF))
                self._set_drawable_stroke(card_bg, AndroidUtilitiesClass.dp(1), with_alpha(monet_accent, 0x30 if is_dark else 0x22))
                card_frame.setBackground(card_bg)

                card_layout = LinearLayoutClass(context)
                card_layout.setOrientation(LinearLayoutClass.VERTICAL)
                card_layout.setClipChildren(False)
                card_layout.setClipToPadding(False)
                card_layout.setPadding(
                    AndroidUtilitiesClass.dp(16),
                    AndroidUtilitiesClass.dp(14),
                    AndroidUtilitiesClass.dp(16),
                    AndroidUtilitiesClass.dp(14)
                )

                header_layout = LinearLayoutClass(context)
                header_layout.setOrientation(LinearLayoutClass.HORIZONTAL)
                header_layout.setGravity(Gravity.CENTER_VERTICAL)

                t_view = TextView(context)
                t_view.setText(_tr("Карта секторов кода", "Code Sector Map"))
                t_view.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 14)
                t_view.setTypeface(AndroidUtilitiesClass.bold())
                self._set_text_color(t_view, monet_accent)
                header_layout.addView(t_view, LayoutHelper.createLinear(0, -2, 1.0, Gravity.CENTER_VERTICAL))

                card_layout.addView(header_layout, LayoutHelper.createLinear(-1, -2, 0, 0, 0, 0, 10))

                file_lines = []
                if file_path and os.path.exists(file_path):
                    try:
                        with open(file_path, "r", encoding="utf-8", errors="ignore") as f:
                            file_lines = f.readlines()
                    except Exception:
                        pass
                def _to_int_line(v):
                    try:
                        return int(v)
                    except Exception:
                        return 0
                total_lines = max(1, len(file_lines)) if file_lines else max([_to_int_line(r.get("line", 0)) for r in reports] + [100])

                num_cells = 20
                cols = 10
                rows = 2
                step = max(1, int(math.ceil(total_lines / float(num_cells))))

                grid_container = LinearLayoutClass(context)
                grid_container.setOrientation(LinearLayoutClass.VERTICAL)
                grid_container.setClipChildren(False)
                grid_container.setClipToPadding(False)
                grid_container.setPadding(
                    AndroidUtilitiesClass.dp(3),
                    AndroidUtilitiesClass.dp(3),
                    AndroidUtilitiesClass.dp(3),
                    AndroidUtilitiesClass.dp(3)
                )

                details_box = LinearLayoutClass(context)
                details_box.setOrientation(LinearLayoutClass.VERTICAL)
                details_box.setPadding(AndroidUtilitiesClass.dp(12), AndroidUtilitiesClass.dp(8), AndroidUtilitiesClass.dp(12), AndroidUtilitiesClass.dp(8))
                d_bg = GradientDrawable()
                d_bg.setCornerRadius(float(AndroidUtilitiesClass.dp(10)))
                self._set_drawable_color(d_bg, with_alpha(dialog_text_color, 0x12 if is_dark else 0x0A))
                details_box.setBackground(d_bg)

                top_row = LinearLayoutClass(context)
                top_row.setOrientation(LinearLayoutClass.HORIZONTAL)
                top_row.setGravity(Gravity.CENTER_VERTICAL)

                dot_v = View(context)
                dot_bg = GradientDrawable()
                dot_bg.setCornerRadius(float(AndroidUtilitiesClass.dp(4)))
                self._set_drawable_color(dot_bg, dialog_muted_color)
                dot_v.setBackground(dot_bg)
                top_row.addView(dot_v, LayoutHelper.createLinear(7, 7, Gravity.CENTER_VERTICAL, 0, 0, 8, 0))

                title_tv = TextView(context)
                title_tv.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 12)
                title_tv.setTypeface(AndroidUtilitiesClass.bold())
                self._set_text_color(title_tv, dialog_muted_color)
                title_tv.setText(_tr("Нажмите на сектор для просмотра деталей", "Tap a sector to view details"))
                top_row.addView(title_tv, LayoutHelper.createLinear(0, -2, 1.0, Gravity.CENTER_VERTICAL))

                details_box.addView(top_row, LayoutHelper.createLinear(-1, -2))

                sub_tv = TextView(context)
                sub_tv.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 11)
                self._set_text_color(sub_tv, dialog_muted_color)
                sub_tv.setVisibility(View.GONE)
                details_box.addView(sub_tv, LayoutHelper.createLinear(-1, -2, 0, 15, 2, 0, 0))

                selected_cell_view = [None]
                selected_cell_bg = [None]
                selected_cell_default_color = [0]
                selected_cell_stroke_color = [0]

                OBF_RULES = {
                    "OBFUSCATED_CODE_STRUCTURE", "MULTI_LAYER_OBFUSCATION_UNPACKED",
                    "HIGH_ENTROPY_LITERAL_DETECTED", "DYNAMIC_CODE_COMPILATION",
                    "DYNAMIC_CODE_EXECUTION", "BYTE_XOR_DECRYPTION_LOOP", "HIDDEN_XOR_PAYLOAD"
                }

                def create_cell_click_listener(c_idx, l_start, l_end, c_level, c_threats, c_col, c_view, c_bg, stroke_col):
                    class CellClickListener(dynamic_proxy(View.OnClickListener)):
                        def onClick(self_c, v):
                            try:
                                _vibrate(v)

                                if selected_cell_view[0] == c_view:
                                    return

                                if selected_cell_bg[0] and selected_cell_view[0]:
                                    prev_v = selected_cell_view[0]
                                    prev_bg = selected_cell_bg[0]
                                    prev_col = selected_cell_default_color[0]
                                    prev_sc = selected_cell_stroke_color[0]
                                    self._set_drawable_color(prev_bg, prev_col)
                                    self._set_drawable_stroke(prev_bg, AndroidUtilitiesClass.dp(1), with_alpha(prev_sc, 0x50))
                                    if hasattr(prev_v, "animate"):
                                        prev_v.animate().cancel()
                                        prev_v.animate().setStartDelay(0).scaleX(1.0).scaleY(1.0).setDuration(120).start()
                                    if hasattr(prev_v, "setTranslationZ"):
                                        prev_v.setTranslationZ(0.0)

                                selected_cell_view[0] = c_view
                                selected_cell_bg[0] = c_bg
                                selected_cell_default_color[0] = c_col
                                selected_cell_stroke_color[0] = stroke_col

                                self._set_drawable_color(c_bg, c_col)
                                self._set_drawable_stroke(c_bg, AndroidUtilitiesClass.dp(2), dialog_text_color)
                                if hasattr(c_view, "animate"):
                                    c_view.animate().cancel()
                                    c_anim = c_view.animate().setStartDelay(0).scaleX(1.06).scaleY(1.06).setDuration(140)
                                    CubicBezierInterpolator = find_class("org.telegram.ui.Components.CubicBezierInterpolator")
                                    interpolator = getattr(CubicBezierInterpolator, "EASE_OUT_QUINT", None) if CubicBezierInterpolator else None
                                    if interpolator:
                                        c_anim.setInterpolator(interpolator)
                                    c_anim.start()
                                if hasattr(c_view, "setTranslationZ"):
                                    c_view.setTranslationZ(float(AndroidUtilitiesClass.dp(3)))

                                self._set_drawable_color(dot_bg, stroke_col)
                                self._set_text_color(title_tv, dialog_text_color)
                                title_tv.setText(f"{_tr('Сектор', 'Sector')} {c_idx+1} • {_tr('строки', 'lines')} {l_start}–{l_end}")

                                if c_level == "CRITICAL":
                                    s_txt = f"{_tr('Критическая угроза', 'Critical threat')}{': ' + c_threats if c_threats else ''}"
                                elif c_level == "OBFUSCATED":
                                    s_txt = f"{_tr('Обфусцированный код', 'Obfuscated code')}{': ' + c_threats if c_threats else ''}"
                                elif c_level == "WARNING":
                                    s_txt = f"{_tr('Предупреждение', 'Warning')}{': ' + c_threats if c_threats else ''}"
                                else:
                                    s_txt = _tr("Чистый код (угроз не обнаружено)", "Clean code (no threats detected)")

                                sub_tv.setText(s_txt)
                                sub_tv.setVisibility(View.VISIBLE)
                            except Exception:
                                pass
                            finally:
                                del v
                    return CellClickListener()

                def _format_threat_label(rep):
                    if not rep:
                        return ""
                    rule_k = rep.get("rule")
                    if rule_k and rule_k in ReportUI.RULES:
                        t_ru, t_en, _, _ = ReportUI.RULES[rule_k]
                        return t_ru if _is_russian() else t_en
                    elif rule_k:
                        return rule_k.replace("_", " ").capitalize()
                    return str(rep.get("detail", ""))[:45]

                for r_idx in range(rows):
                    row_layout = LinearLayoutClass(context)
                    row_layout.setOrientation(LinearLayoutClass.HORIZONTAL)
                    row_layout.setClipChildren(False)
                    row_layout.setClipToPadding(False)
                    for c_col_idx in range(cols):
                        idx = r_idx * cols + c_col_idx
                        l_start = min(total_lines, idx * step + 1)
                        l_end = min(total_lines, (idx + 1) * step)

                        sector_reports = [r for r in reports if _to_int_line(r.get("line", 0)) > 0 and l_start <= _to_int_line(r.get("line", 0)) <= l_end]
                        sector_text = "".join(file_lines[l_start-1:l_end]) if file_lines else ""
                        has_obf_code = False
                        if sector_text:
                            sec_no_ws = "".join(c for c in sector_text if ord(c) < 128 and not c.isspace())
                            if len(sec_no_ws) >= 40:
                                f_sec = {}
                                for ch in sec_no_ws:
                                    f_sec[ch] = f_sec.get(ch, 0) + 1
                                sec_ent = sum(-(c / len(sec_no_ws)) * math.log2(c / len(sec_no_ws)) for c in f_sec.values())
                                if sec_ent >= 5.50:
                                    has_obf_code = True

                        if any(r.get("level") == "CRITICAL" for r in sector_reports):
                            cell_level = "CRITICAL"
                            cell_col = 0xFFEF4444
                            crit_r = next(r for r in sector_reports if r.get("level") == "CRITICAL")
                            threat_desc = _format_threat_label(crit_r)
                        elif any(r.get("rule") in OBF_RULES for r in sector_reports) or has_obf_code:
                            cell_level = "OBFUSCATED"
                            cell_col = 0xFFA855F7 if is_dark else 0xFF9333EA
                            obf_r = next((r for r in sector_reports if r.get("rule") in OBF_RULES), None)
                            threat_desc = _format_threat_label(obf_r) if obf_r else _tr("Высокая энтропия", "High entropy")
                        elif any(r.get("level") in ("HIGH", "WARNING") for r in sector_reports):
                            cell_level = "WARNING"
                            cell_col = 0xFFF59E0B
                            warn_r = next(r for r in sector_reports if r.get("level") in ("HIGH", "WARNING"))
                            threat_desc = _format_threat_label(warn_r)
                        else:
                            cell_level = "SAFE"
                            cell_col = with_alpha(0xFF10B981, 0x65 if is_dark else 0x50)
                            threat_desc = ""

                        stroke_col = 0xFF10B981 if cell_level == "SAFE" else cell_col

                        cell_view = View(context)
                        cell_bg = GradientDrawable()
                        cell_bg.setCornerRadius(float(AndroidUtilitiesClass.dp(7)))
                        self._set_drawable_color(cell_bg, cell_col)
                        self._set_drawable_stroke(cell_bg, AndroidUtilitiesClass.dp(1), with_alpha(stroke_col, 0x50))
                        cell_view.setBackground(cell_bg)
                        cell_view.setClickable(True)
                        cell_view.setFocusable(True)
                        cell_view.setOnClickListener(create_cell_click_listener(idx, l_start, l_end, cell_level, threat_desc, cell_col, cell_view, cell_bg, stroke_col))

                        if hasattr(cell_view, "animate"):
                            try:
                                cell_view.setAlpha(0.0)
                                cell_view.setScaleX(0.7)
                                cell_view.setScaleY(0.7)
                                anim = cell_view.animate().alpha(1.0).scaleX(1.0).scaleY(1.0).setDuration(240).setStartDelay(int(100 + idx * 30))
                                CubicBezierInterpolator = find_class("org.telegram.ui.Components.CubicBezierInterpolator")
                                interpolator = getattr(CubicBezierInterpolator, "EASE_OUT_QUINT", None) if CubicBezierInterpolator else None
                                if interpolator:
                                    anim.setInterpolator(interpolator)
                                anim.start()
                            except Exception:
                                cell_view.setAlpha(1.0)
                                cell_view.setScaleX(1.0)
                                cell_view.setScaleY(1.0)

                        margin_right = AndroidUtilitiesClass.dp(3) if c_col_idx < cols - 1 else 0
                        margin_bottom = AndroidUtilitiesClass.dp(4) if r_idx < rows - 1 else 0
                        row_layout.addView(cell_view, LayoutHelper.createLinear(0, 24, 1.0, 0, 0, margin_right, margin_bottom))

                    grid_container.addView(row_layout, LayoutHelper.createLinear(-1, -2))

                card_layout.addView(grid_container, LayoutHelper.createLinear(-1, -2, 0, 0, 0, 0, 8))
                card_layout.addView(details_box, LayoutHelper.createLinear(-1, -2))

                card_frame.addView(card_layout, LayoutHelper.createFrame(-1, -2))
                return card_frame

            if is_self_scan:
                scroll_layout.addView(
                    create_note_card(
                        _tr("Самопроверка PluginGuard", "PluginGuard Self-Scan"),
                        _tr("PluginGuard содержит встроенные базы сигнатур зловредов, DEX-дизассемблер и правила эвристики. Срабатывание детектора на код самого антивируса является нормальным поведением. Убедитесь, что вы скачали PG из канала @DefinitelyNotDekma.", "PluginGuard contains built-in malware signatures, DEX disassembler, and heuristic rules. Detection triggering on antivirus self-code is normal behavior. Make sure you downloaded PG from the author's channel — @DefinitelyNotDekma."),
                        monet_accent,
                        icon_type="info"
                    ),
                    LayoutHelper.createLinear(-1, -2, 0, 0, 0, 0, 10)
                )

            unpacked_list = [p for p in ai_stats.get("unpacked_payloads", []) if any(t.get("level") == "CRITICAL" for t in p.get("threats", []))]
            if unpacked_list:
                def on_peek_click():
                    self._show_payload_viewer(context, unpacked_list, ThemeClass, resources_provider)
                peek_card = create_peek_card(unpacked_list, on_peek_click)
                if peek_card:
                    scroll_layout.addView(
                        peek_card,
                        LayoutHelper.createLinear(-1, -2, 0, 0, 0, 0, 10)
                    )

            has_native_so_or_ctypes = any(
                "SO" in str(r.get("rule", "")).upper() or
                "CTYPES" in str(r.get("rule", "")).upper() or
                "NATIVE" in str(r.get("rule", "")).upper() or
                ".so" in str(r.get("detail", "")).lower() or
                "ctypes" in str(r.get("detail", "")).lower()
                for r in reports
            )

            if has_native_so_or_ctypes:
                scroll_layout.addView(
                    create_note_card(
                        _tr("Внимание: нативный код (.so)", "Warning: native code (.so)"),
                        _tr("Плагин использует бинарные библиотеки ctypes/.so. Машинный нативный код невозможно проверить статически. Установка на ваш страх и риск!", "Plugin uses binary ctypes/.so libraries. Machine native code cannot be statically verified. Install at your own risk!"),
                        0xFFF59E0B if is_dark else 0xFFD97706,
                        icon_type="warning"
                    ),
                    LayoutHelper.createLinear(-1, -2, 0, 0, 0, 0, 10)
                )

            critical_reports = [r for r in reports if r.get("level") == "CRITICAL"]
            if critical_reports:
                crit_items = ReportUI.format_threats_list(critical_reports, max_items=0, include_rule=True)
                scroll_layout.addView(
                    create_issue_card(f"{_tr('Критические угрозы', 'Critical threats')} ({len(critical_reports)})", crit_items, 0xFFF44336, icon_type="critical", collapsible=True, initially_collapsed=False),
                    LayoutHelper.createLinear(-1, -2, 0, 0, 0, 0, 10)
                )

            warning_reports = [r for r in reports if r.get("level") in ("HIGH", "WARNING")]
            if warning_reports:
                warn_items = ReportUI.format_threats_list(warning_reports, max_items=0, include_rule=True)
                has_dex_dyn = any(str(r.get("rule", "")).upper() in ("DEX_DYNAMIC_LOADING", "DYNAMIC_IN_MEMORY_DEX_LOADER") for r in warning_reports)
                is_imp_warn = has_native_so_or_ctypes or has_dex_dyn
                warn_badge = _tr("Важно", "Important") if is_imp_warn else ""
                warn_collapsed = not is_imp_warn
                scroll_layout.addView(
                    create_issue_card(f"{_tr('Предупреждения', 'Warnings')} ({len(warning_reports)})", warn_items, 0xFFFF9800, icon_type="warning", collapsible=True, initially_collapsed=warn_collapsed, badge_text=warn_badge),
                    LayoutHelper.createLinear(-1, -2, 0, 0, 0, 0, 10)
                )

            if not critical_reports and not warning_reports:
                scroll_layout.addView(
                    create_issue_card(_tr("Безопасный код", "Safe code"), _tr("Опасных действий, кражи сессий и утечек не обнаружено.", "No dangerous actions, session theft or data leaks detected."), verdict_color, icon_type="check"),
                    LayoutHelper.createLinear(-1, -2, 0, 0, 0, 0, 10)
                )

            if ai_stats.get("dex_found"):
                dex_ok = ai_stats.get("dex_decompiled", False)
                dex_classes_n = ai_stats.get("dex_classes_count", 0)
                dex_methods_n = ai_stats.get("dex_methods_count", 0)
                dex_size_kb = round(ai_stats.get("dex_size", 0) / 1024.0, 1)
                if dex_ok:
                    dex_card_title = _tr("Встроенный код (DEX)", "Embedded Code (DEX)")
                    dex_card_desc = _tr(
                        f"Найден модуль DEX ({dex_size_kb} КБ). Код успешно проверен ({dex_classes_n} классов, {dex_methods_n} методов).",
                        f"Embedded DEX module found ({dex_size_kb} KB). Code successfully verified ({dex_classes_n} classes, {dex_methods_n} methods)."
                    )
                    dex_card_color = 0xFF4CAF50 if not any("DEX" in str(r.get("rule", "")) for r in reports if r.get("level") == "CRITICAL") else 0xFFFF9800
                    dex_card_icon = "check" if dex_card_color == 0xFF4CAF50 else "warning"
                else:
                    dex_card_title = _tr("Встроенный код (DEX)", "Embedded Code (DEX)")
                    dex_card_desc = _tr(
                        f"Найден модуль DEX ({dex_size_kb} КБ), но его не удалось прочитать (поврежден или зашифрован).",
                        f"Embedded DEX bytecode found ({dex_size_kb} KB), but could not be read (corrupted or encrypted)."
                    )
                    dex_card_color = 0xFFF44336
                    dex_card_icon = "critical"
                scroll_layout.addView(
                    create_note_card(dex_card_title, dex_card_desc, dex_card_color, icon_type=dex_card_icon),
                    LayoutHelper.createLinear(-1, -2, 0, 0, 0, 0, 10)
                )

            has_static_danger = any(r.get("level") == "CRITICAL" for r in reports)
            has_anomaly = ai_stats.get("avg_similarity", 1.0) < ai_stats.get("threshold", 0.4954)
            entropy_verdict = ai_stats.get("entropy_verdict", "NORMAL")
            obf_layers = ai_stats.get("obfuscation_layers", 0)
            has_obfuscation = has_anomaly or entropy_verdict == "HIGH" or obf_layers > 0

            if obf_layers > 0:
                obf_str = f"{_tr('обнаружена', 'detected')} ({_plural_layers(obf_layers)})"
            elif has_obfuscation:
                obf_str = _tr("аномальная структура", "anomalous structure")
            elif entropy_verdict == "ELEVATED":
                obf_str = _tr("повышенная сложность", "elevated complexity")
            else:
                obf_str = _tr("отсутствует", "none")

            if has_static_danger and obf_layers > 0:
                vector_verdict = f"{_tr('Вредоносный обфусцированный код', 'Malicious obfuscated code')} ({_plural_layers(obf_layers)})"
            elif has_static_danger and has_obfuscation:
                vector_verdict = _tr("Вредоносный обфусцированный код", "Malicious obfuscated code")
            elif has_static_danger:
                vector_verdict = _tr("Вредоносный код (не обфусцирован)", "Malicious code (unobfuscated)")
            elif obf_layers > 0:
                vector_verdict = f"{_tr('Обнаружена обфускация', 'Obfuscation detected')} ({_plural_code_layers(obf_layers)})"
            elif has_obfuscation:
                vector_verdict = _tr("Обфускация / аномальная структура", "Obfuscation / anomalous structure")
            elif entropy_verdict == "ELEVATED":
                vector_verdict = _tr("Код частично нечитаем", "Code partially unreadable")
            else:
                vector_verdict = _tr("Код не обфусцирован, опасных вызовов нет", "Unobfuscated code, no dangerous calls")

            entropy_val = ai_stats.get('entropy', 0.0)
            entropy_label = {
                'NORMAL': _tr('норма', 'normal'),
                'ELEVATED': _tr('повышенная', 'elevated'),
                'HIGH': _tr('обфускация', 'obfuscated')
            }.get(entropy_verdict, '—')

            tech_text = [
                f"{_tr('Вердикт', 'Verdict')}: {vector_verdict}",
                f"{_tr('Обфускация', 'Obfuscation')}: {obf_str}",
                f"{_tr('Энтропия', 'Entropy')}: {entropy_val:.4f} ({entropy_label})",
                f"{_tr('Схожесть Top-5', 'Top-5 similarity')}: {_tr('мин', 'min')} {ai_stats.get('min_similarity', 0.0):.4f} / {_tr('сред', 'avg')} {ai_stats.get('avg_similarity', 0.0):.4f} / {_tr('макс', 'max')} {ai_stats.get('max_similarity', 0.0):.4f}",
                f"{_tr('Порог детекции', 'Detection threshold')}: {ai_stats.get('threshold', 0.0):.4f} ({ai_stats.get('threshold_diff', '+0.0000')})",
                f"{_tr('Проверено чанков', 'Scanned chunks')}: {ai_stats.get('scanned_chunks', 0)} ({ai_stats.get('vectors_count', 0)} {_tr('в базе', 'in database')})"
            ]
            if ai_stats.get("dex_found"):
                dex_status_txt = _tr("успешно декомпилирован", "successfully decompiled") if ai_stats.get("dex_decompiled") else _tr("ошибка декомпиляции", "decompilation failed")
                tech_text.append(f"{_tr('DEX модуль', 'DEX module')}: {dex_status_txt} ({round(ai_stats.get('dex_size', 0)/1024.0, 1)} {_tr('КБ', 'KB')})")
            scroll_layout.addView(
                create_heatmap_card(),
                LayoutHelper.createLinear(-1, -2, 0, 0, 0, 0, 10)
            )

            scroll_layout.addView(
                create_note_card(_tr("Аудит", "Audit"), tech_text, monet_accent, icon_type="audit"),
                LayoutHelper.createLinear(-1, -2, 0, 0, 0, 0, 10)
            )

            if getattr(self, '_last_dump_folder_name', None) and self.get_setting("save_debug_dumps", False):
                dump_text = f"Download/PluginGuard_Dumps/{self._last_dump_folder_name}"
                scroll_layout.addView(
                    create_note_card(_tr("Дамп", "Dump"), dump_text, dialog_muted_color, icon_type="folder"),
                    LayoutHelper.createLinear(-1, -2, 0, 0, 0, 0, 10)
                )

            scroll_view.addView(scroll_layout, LayoutHelper.createFrame(-1, -2))
            root.addView(scroll_view, LayoutHelper.createLinear(-1, 0, 1.0, 0, 0, 0, 14))

            def create_primary_button(text: str, on_click):
                button_frame = FrameLayout(context)
                button_bg_color = monet_accent
                button_selector_color = self._adjust_luminance(monet_accent, -25 if is_dark else -35)
                button_frame.setBackground(
                    self._make_button_bg(
                        ThemeClass,
                        AndroidUtilitiesClass,
                        button_bg_color,
                        button_selector_color,
                        resources_provider,
                        corner_dp=24
                    )
                )
                button_frame.setClickable(True)
                button_frame.setFocusable(True)

                button_text = TextView(context)
                button_text.setText(text)
                button_text.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 15)
                button_text.setTypeface(AndroidUtilitiesClass.bold())
                button_text.setGravity(Gravity.CENTER)
                btn_txt_col = 0xFFFFFFFF if is_dark_color(button_bg_color) else 0xFF1C1B1F
                self._set_text_color(button_text, btn_txt_col)
                button_frame.addView(button_text, LayoutHelper.createFrame(-1, 48, Gravity.CENTER))

                class BtnClickListener(dynamic_proxy(View.OnClickListener)):
                    def onClick(self_inner, v):
                        try:
                            _vibrate(v)
                            on_click()
                        except Exception:
                            pass
                        finally:
                            del v
                button_frame.setOnClickListener(BtnClickListener())
                return button_frame

            def dismiss_sheet():
                try:
                    if hasattr(sheet, "dismiss"):
                        sheet.dismiss()
                except Exception:
                    pass

            root.addView(create_divider(), LayoutHelper.createLinear(-1, 1, 0, 0, 0, 0, 14))
            close_btn = create_primary_button(_tr("Понятно", "Got it"), dismiss_sheet)
            root.addView(close_btn, LayoutHelper.createLinear(-1, 48, 0, 0, 0, 0, 4))

            try:
                sheet.setApplyTopPadding(False)
                sheet.setApplyBottomPadding(False)
            except Exception:
                pass
            try:
                sheet.setCanDismissWithSwipe(False)
            except Exception:
                pass
            try:
                sheet.setCanDismissWithTouchOutside(True)
            except Exception:
                pass

            sheet.setCustomView(root)
            sheet.show()

            if has_critical or score < 40:
                try:
                    self._schedule_timer(0.20, lambda: _vibrate(root))
                    self._schedule_timer(0.34, lambda: _vibrate(root))
                    self._schedule_timer(0.48, lambda: _vibrate(root))
                except Exception:
                    pass
            elif is_safe:
                try:
                    self._schedule_timer(0.20, lambda: _vibrate(root, haptic_type="confirm"))
                except Exception:
                    pass
        except Exception as e:
            self.log(f"[PluginGuard UI ERROR] {e}\n{traceback.format_exc()}")

    def _make_button_bg(self, theme_cls, util_cls, color_bg, color_selector, resources_provider=None, corner_dp: int = 24):
        if theme_cls and hasattr(theme_cls, "createSimpleSelectorRoundRectDrawable") and util_cls:
            try:
                drawable = theme_cls.createSimpleSelectorRoundRectDrawable(
                    util_cls.dp(corner_dp),
                    as_java_color(color_bg),
                    as_java_color(color_selector)
                )
                if drawable:
                    return drawable
            except Exception:
                pass
            try:
                drawable = theme_cls.createSimpleSelectorRoundRectDrawable(
                    util_cls.dp(corner_dp),
                    as_java_color(color_bg),
                    as_java_color(color_selector),
                    as_java_color(color_selector)
                )
                if drawable:
                    return drawable
            except Exception:
                pass
        try:
            StateListDrawable = find_class("android.graphics.drawable.StateListDrawable")
            GradientDrawable = find_class("android.graphics.drawable.GradientDrawable")
            if StateListDrawable and GradientDrawable and util_cls:
                normal = GradientDrawable()
                normal.setCornerRadius(float(util_cls.dp(corner_dp)))
                normal.setColor(as_java_color(color_bg))
                pressed = GradientDrawable()
                pressed.setCornerRadius(float(util_cls.dp(corner_dp)))
                pressed.setColor(as_java_color(color_selector))
                sld = StateListDrawable()
                sld.addState([16842919], pressed)
                sld.addState([], normal)
                return sld
        except Exception:
            pass
        try:
            GradientDrawable = find_class("android.graphics.drawable.GradientDrawable")
            if GradientDrawable and util_cls:
                gd = GradientDrawable()
                gd.setCornerRadius(float(util_cls.dp(corner_dp)))
                gd.setColor(as_java_color(color_bg))
                return gd
        except Exception:
            pass
        return None

    def _get_theme_provider(self, sheet):
        provider = self._get_field_deep(sheet, "resourcesProvider")
        if provider:
            return provider
        activity = self._get_field_deep(sheet, "parentActivity")
        if activity:
            current_frag = self._get_field_deep(activity, "currentFragment")
            if current_frag:
                frag_provider = self._get_field_deep(current_frag, "resourcesProvider")
                if frag_provider:
                    return frag_provider
        return None

    def _find_install_button_pair(self, root_view, btn_cls=None):
        if not root_view or not hasattr(root_view, "getChildCount"):
            return None, None
        try:
            for i in range(root_view.getChildCount()):
                child = root_view.getChildAt(i)
                if child is None:
                    continue
                c_name = child.getClass().getName()
                if "ButtonWithCounterView" in c_name:
                    return child, root_view
                if btn_cls and btn_cls.isInstance(child):
                    return child, root_view
            for i in range(root_view.getChildCount()):
                child = root_view.getChildAt(i)
                if child is None or not hasattr(child, "getChildCount"):
                    continue
                res, parent = self._find_install_button_pair(child, btn_cls)
                if res and parent:
                    return res, parent
            for i in range(root_view.getChildCount()):
                child = root_view.getChildAt(i)
                if child is None:
                    continue
                text_val = ""
                if hasattr(child, "getText"):
                    try:
                        text_val = str(child.getText() or "").lower()
                    except Exception:
                        pass
                if any(w in text_val for w in ["установ", "обнов", "install", "update", "reinstall"]):
                    return child, root_view
        except Exception:
            pass
        return None, None

    def _find_view_pair(self, root_view, target_cls):
        if not root_view or not hasattr(root_view, "getChildCount"):
            return None, None
        try:
            for i in range(root_view.getChildCount()):
                child = root_view.getChildAt(i)
                if isinstance(child, target_cls):
                    return child, root_view
                res, parent = self._find_view_pair(child, target_cls)
                if res and parent:
                    return res, parent
        except Exception:
            pass
        return None, None

    _FIELD_CACHE = {}

    def _get_field_deep(self, obj, field_name):
        if obj is None:
            return None
        try:
            from hook_utils import get_private_field
            v = get_private_field(obj, field_name)
            if v is not None:
                return v
        except Exception:
            pass
        if hasattr(obj, field_name):
            try:
                v = getattr(obj, field_name)
                if v is not None:
                    return v
            except Exception:
                pass
        curr_cls = obj.getClass() if hasattr(obj, "getClass") else None
        if not curr_cls:
            return None
        cls_name = curr_cls.getName() if hasattr(curr_cls, "getName") else str(curr_cls)
        cache_key = (cls_name, field_name)
        cached_f = self._FIELD_CACHE.get(cache_key)
        if cached_f:
            try:
                return cached_f.get(obj)
            except Exception:
                pass
        target_cls = curr_cls
        try:
            obj_cls = find_class("java.lang.Object")
        except Exception:
            obj_cls = None
        while target_cls is not None and target_cls != obj_cls:
            try:
                f = target_cls.getDeclaredField(field_name)
                f.setAccessible(True)
                self._FIELD_CACHE[cache_key] = f
                return f.get(obj)
            except Exception:
                target_cls = target_cls.getSuperclass()
        return None

    def _set_field_deep(self, obj, field_name, value):
        if obj is None:
            return False
        curr_cls = obj.getClass() if hasattr(obj, "getClass") else None
        if not curr_cls:
            return False
        cls_name = curr_cls.getName() if hasattr(curr_cls, "getName") else str(curr_cls)
        cache_key = (cls_name, field_name)
        cached_f = self._FIELD_CACHE.get(cache_key)
        if cached_f and cached_f is not False:
            try:
                cached_f.set(obj, value)
                return True
            except Exception:
                pass
        target_cls = curr_cls
        while target_cls is not None:
            try:
                f = target_cls.getDeclaredField(field_name)
                f.setAccessible(True)
                self._FIELD_CACHE[cache_key] = f
                f.set(obj, value)
                return True
            except Exception:
                target_cls = target_cls.getSuperclass()
        return False

    def _invoke_method_deep(self, obj, method_name, *args):
        if obj is None:
            return None
        curr_cls = obj.getClass() if hasattr(obj, "getClass") else None
        while curr_cls is not None:
            try:
                for m in curr_cls.getDeclaredMethods():
                    if m.getName() == method_name and len(m.getParameterTypes()) == len(args):
                        try:
                            m.setAccessible(True)
                            return m.invoke(obj, *args)
                        except Exception:
                            pass
            except Exception:
                pass
            curr_cls = curr_cls.getSuperclass()
        return None

    def _extract_file_path_from_any(self, sheet, args):
        candidates = []
        if args:
            for arg in args:
                if arg is not None:
                    candidates.append(arg)
                    for fld in ['plugin', 'validationResult', 'params', 'installParams']:
                        val = self._get_field_deep(arg, fld)
                        if val is not None:
                            candidates.append(val)
        if sheet is not None:
            candidates.append(sheet)
            for fld in ['plugin', 'validationResult', 'params', 'installParams', 'validation']:
                val = self._get_field_deep(sheet, fld)
                if val is not None:
                    candidates.append(val)

        for c in candidates:
            if hasattr(c, 'getAbsolutePath'):
                try:
                    s = str(c.getAbsolutePath())
                    if s: return s
                except Exception:
                    pass
            if hasattr(c, 'getPath'):
                try:
                    s = str(c.getPath())
                    if s: return s
                except Exception:
                    pass
            for attr in ['filePath', 'path', 'file', 'sourcePath', 'localPath']:
                val = self._get_field_deep(c, attr)
                if val:
                    if hasattr(val, 'getAbsolutePath'):
                        try:
                            return str(val.getAbsolutePath())
                        except Exception:
                            pass
                    if hasattr(val, 'getPath'):
                        try:
                            return str(val.getPath())
                        except Exception:
                            pass
                    s = str(val)
                    if s.endswith('.plugin') or s.endswith('.py') or s.endswith('.elyx') or s.endswith('.eaf') or (os.path.exists(s) and os.path.isfile(s)):
                        return s
            s = str(c)
            if s.endswith('.plugin') or s.endswith('.py') or s.endswith('.elyx') or s.endswith('.eaf'):
                return s
        return None

    def _is_trusted_source(self, sheet, args):
        candidates = []
        if args:
            for arg in args:
                if arg is not None:
                    candidates.append(arg)
                    for fld in ['plugin', 'validationResult', 'params', 'installParams']:
                        try:
                            val = self._get_field_deep(arg, fld)
                            if val is not None:
                                candidates.append(val)
                        except Exception:
                            pass
        if sheet is not None:
            candidates.append(sheet)
            for fld in ['plugin', 'validationResult', 'params', 'installParams', 'validation']:
                try:
                    val = self._get_field_deep(sheet, fld)
                    if val is not None:
                        candidates.append(val)
                except Exception:
                    pass

        for c in candidates:
            if c is None:
                continue
            for fld in ['isTrusted', 'trusted', 'is_trusted']:
                try:
                    v = self._get_field_deep(c, fld)
                    if isinstance(v, bool) and v:
                        return True
                    if callable(v):
                        res = v()
                        if isinstance(res, bool) and res:
                            return True
                except Exception:
                    pass
        return False

    def _is_kpm_present(self, sheet=None, install_btn=None) -> bool:
        if install_btn and hasattr(install_btn, "getParent"):
            p = install_btn.getParent()
            if p:
                tag = str(getattr(p, "getTag", lambda: "")() or "")
                if tag == "kpm_split_container":
                    return True
                if hasattr(p, "getOrientation") and p.getOrientation() == 0:
                    return True
        if sheet:
            for fld in ["bottomContainer", "customView", "sheetContainer", "containerView"]:
                root = self._get_field_deep(sheet, fld)
                if root and hasattr(root, "findViewWithTag"):
                    try:
                        if root.findViewWithTag("kpm_split_container") is not None:
                            return True
                    except Exception:
                        pass
        try:
            PluginsController = find_class("com.exteragram.messenger.plugins.PluginsController")
            if PluginsController:
                inst = PluginsController.getInstance()
                if inst and hasattr(inst, "plugins") and inst.plugins:
                    if inst.plugins.containsKey("kangel_plugins_manager"):
                        return True
        except BaseException:
            pass
        return False

    def _is_elyx_plugin(self, sheet=None, args=None, resolved_path=None) -> bool:
        if resolved_path:
            low = str(resolved_path).lower()
            if low.endswith('.elyx') or low.endswith('.eaf'):
                return True
            try:
                if zipfile.is_zipfile(resolved_path):
                    with zipfile.ZipFile(resolved_path, 'r') as zf:
                        names = set(zf.namelist())
                        if any(n in names for n in ('refmap.yml', 'refmap.yaml', 'refmap.json', 'meta.yml', 'meta.yaml')):
                            return True
            except Exception:
                pass
        candidates = []
        if args:
            for arg in args:
                if arg is not None:
                    candidates.append(arg)
                    for fld in ['plugin', 'validationResult', 'params', 'installParams', 'file']:
                        try:
                            v = self._get_field_deep(arg, fld)
                            if v is not None:
                                candidates.append(v)
                        except Exception:
                            pass
        if sheet is not None:
            candidates.append(sheet)
            for fld in ['plugin', 'validationResult', 'params', 'installParams', 'validation', 'file']:
                try:
                    v = self._get_field_deep(sheet, fld)
                    if v is not None:
                        candidates.append(v)
                except Exception:
                    pass
        for c in candidates:
            if c is None:
                continue
            for fld in ['isElyx', 'is_elyx', 'elyx', 'isEaf', 'is_eaf']:
                try:
                    v = self._get_field_deep(c, fld)
                    if isinstance(v, bool) and v:
                        return True
                except Exception:
                    pass
            try:
                s = str(c).lower()
                if s.endswith('.elyx') or s.endswith('.eaf') or '.elyx' in s or '.eaf' in s:
                    return True
            except Exception:
                pass
        return False


    def _track_hooks(self, hooks):
        if not hooks:
            return
        if isinstance(hooks, (list, tuple, set)):
            for h in hooks:
                if h:
                    self._installed_hooks.append(h)
        else:
            self._installed_hooks.append(hooks)

    def _is_kpm_active(self) -> bool:
        try:
            for p in ["com.exteragram.messenger.plugins.PluginsController", "org.telegram.messenger.plugins.PluginsController"]:
                PC = find_class(p)
                if PC:
                    inst = PC.getInstance()
                    if inst and hasattr(inst, "plugins") and inst.plugins:
                        if inst.plugins.containsKey("kangel_plugins_manager"):
                            return True
        except BaseException:
            pass
        return False

    def _suppress_sheet_analysis(self, sheet):
        if not sheet:
            return
        self._disable_extera_analysis()
        try:
            self._set_field_deep(sheet, "analysisRunning", False)
            self._set_field_deep(sheet, "riskAcknowledged", True)
        except Exception:
            pass
        try:
            sec = self._get_field_deep(sheet, "analysisSection")
            if sec:
                if hasattr(sec, "setDisabled"):
                    sec.setDisabled()
                try:
                    self._set_field_deep(sec, "state", 4)
                except Exception:
                    pass
        except Exception:
            pass
        try:
            task = self._get_field_deep(sheet, "analysisTask")
            if task and hasattr(task, "cancel"):
                task.cancel()
            self._set_field_deep(sheet, "analysisTask", None)
        except Exception:
            pass

    def _on_sheet_created_native(self, sheet):
        if not sheet:
            return
        if not self._is_kpm_active():
            self._suppress_sheet_analysis(sheet)
        saved_path = self._extract_file_path_from_any(sheet, [])
        is_elyx = self._is_elyx_plugin(sheet, [], saved_path)
        is_trusted = False
        try:
            is_trusted = self._is_trusted_source(sheet, [])
        except Exception:
            pass
        self._inject_guard_ui(sheet, [], saved_path, is_elyx, is_trusted)

    def _extract_path_from_object(self, obj):
        if not obj:
            return None
        if isinstance(obj, str):
            if obj.endswith(".plugin") or obj.endswith(".zip") or os.path.exists(obj):
                return obj
        try:
            if hasattr(obj, "getAbsolutePath"):
                p = str(obj.getAbsolutePath())
                if p:
                    return p
        except Exception:
            pass
        try:
            if hasattr(obj, "getFilePath"):
                p = str(obj.getFilePath())
                if p:
                    return p
        except Exception:
            pass
        try:
            if hasattr(obj, "filePath"):
                p = str(obj.filePath)
                if p:
                    return p
        except Exception:
            pass
        try:
            if hasattr(obj, "path"):
                p = str(obj.path)
                if p:
                    return p
        except Exception:
            pass
        try:
            owner = getattr(obj, "messageOwner", None)
            if owner is not None:
                acc = getattr(obj, "currentAccount", 0)
                FL = find_class("org.telegram.messenger.FileLoader")
                if FL:
                    inst = FL.getInstance(acc)
                    p = inst.getPathToMessage(owner)
                    if p:
                        ps = str(p.getAbsolutePath() if hasattr(p, "getAbsolutePath") else p)
                        if ps and (ps.endswith(".plugin") or os.path.exists(ps)):
                            return ps
                    doc = getattr(owner, "media", None)
                    if doc and hasattr(doc, "document"):
                        p = inst.getPathToAttach(doc.document, True)
                        if p:
                            ps = str(p.getAbsolutePath() if hasattr(p, "getAbsolutePath") else p)
                            if ps and (ps.endswith(".plugin") or os.path.exists(ps)):
                                return ps
        except Exception:
            pass
        return None

    def _resolve_full_msg_path(self, sheet, msg_obj=None):
        if _pending_file_path[0] and isinstance(_pending_file_path[0], str):
            return _pending_file_path[0]
        if msg_obj is not None:
            p = self._extract_path_from_object(msg_obj)
            if p:
                _pending_file_path[0] = p
                return p
        if not sheet:
            return None
        for fn in ("params", "messageObject", "pluginInstallParams", "installParams"):
            try:
                v = self._get_field_deep(sheet, fn) or getattr(sheet, fn, None)
                if v:
                    p = self._extract_path_from_object(v)
                    if p:
                        _pending_file_path[0] = p
                        return p
            except Exception:
                pass
        try:
            cur = sheet.getClass()
            while cur and cur != find_class("java.lang.Object"):
                for f in cur.getDeclaredFields():
                    try:
                        f.setAccessible(True)
                        v = f.get(sheet)
                        if v:
                            p = self._extract_path_from_object(v)
                            if p:
                                _pending_file_path[0] = p
                                return p
                    except Exception:
                        pass
                cur = cur.getSuperclass()
        except Exception:
            pass
        return _pending_file_path[0]

    def _is_plugin_trusted(self, sheet) -> bool:
        if not sheet:
            return False
        try:
            params = self._get_field_deep(sheet, "params")
            if params:
                if hasattr(params, "getTrusted"):
                    try:
                        res = params.getTrusted()
                        if hasattr(res, "booleanValue"):
                            return bool(res.booleanValue())
                        return res is True or res == 1
                    except Exception:
                        pass
                if hasattr(params, "isTrusted"):
                    try:
                        res = params.isTrusted()
                        if hasattr(res, "booleanValue"):
                            return bool(res.booleanValue())
                        return res is True or res == 1
                    except Exception:
                        pass
        except BaseException:
            pass
        return False

    def _block_unverified_install(self, install_btn, sheet=None):
        cur_sheet = sheet or getattr(self, "_current_sheet", None)
        if not cur_sheet or not install_btn:
            return
        if self._is_plugin_trusted(cur_sheet):
            return
        if getattr(install_btn, "getTag", None):
            try:
                t = str(install_btn.getTag() or "")
                if t in ("pg_blocked", "pg_verified"):
                    return
            except Exception:
                pass
        resolved_path = self._resolve_full_msg_path(cur_sheet)
        if resolved_path and os.path.exists(resolved_path):
            try:
                with open(resolved_path, "rb") as f:
                    f_hash = hashlib.sha256(f.read()).hexdigest()
                cached_res = self._get_cached_scan_result(f_hash) if f_hash else None
                if cached_res:
                    c_reports, c_stats = cached_res
                    sc, _ = self._calculate_security_score(c_reports, c_stats)
                    if sc >= 40 and not any(r.get("level") == "CRITICAL" for r in c_reports):
                        install_btn.setTag("pg_verified")
                        install_btn.setEnabled(True)
                        install_btn.setClickable(True)
                        install_btn.setAlpha(1.0)
                        return
            except Exception:
                pass
        try:
            install_btn.setTag("pg_blocked")
            install_btn.setEnabled(False)
            install_btn.setClickable(False)
            install_btn.setAlpha(0.4)
            self._safe_set_text(install_btn, "Плагин не проверен")

            class UnverifiedClick(dynamic_proxy(View.OnClickListener)):
                def onClick(self_inner, v):
                    try:
                        frag = get_last_fragment()
                        if frag:
                            BulletinHelper.show_error("Сначала проверьте плагин через PluginGuard", frag)
                    except Exception:
                        pass
                    finally:
                        del v

            install_btn.setOnClickListener(UnverifiedClick())
        except Exception:
            pass

    def _inject_guard_ui(self, sheet, saved_args=None, retry=0):
        if not sheet or retry > 5:
            return
        if self._is_plugin_trusted(sheet):
            return

        target_container = self._get_field_deep(sheet, "bottomContainer")
        install_btn = self._get_field_deep(sheet, "button")

        if not target_container and install_btn and hasattr(install_btn, "getParent"):
            try:
                target_container = install_btn.getParent()
            except Exception:
                pass

        if (not target_container or not install_btn) and hasattr(sheet, "getContainerView"):
            try:
                cv = sheet.getContainerView()
                if cv:
                    f_btn, f_parent = self._find_install_button_pair(cv)
                    if not install_btn:
                        install_btn = f_btn
                    if not target_container:
                        target_container = f_parent
            except Exception:
                pass

        if not target_container or not install_btn:
            if retry < 5:
                run_on_ui_thread(lambda: self._inject_guard_ui(sheet, saved_args, retry + 1))
            return

        if hasattr(target_container, "findViewWithTag") and target_container.findViewWithTag("pg_analyze_btn") is not None:
            self._block_unverified_install(install_btn, sheet)
            return

        resolved_path = self._resolve_full_msg_path(sheet)
        if not resolved_path and saved_args:
            for a in saved_args:
                p = self._extract_path_from_object(a)
                if p:
                    resolved_path = p
                    _pending_file_path[0] = p
                    break

        try:
            ctx = target_container.getContext()
        except Exception:
            ctx = sheet.getContext()

        BWCV = find_class("org.telegram.ui.Stories.recorder.ButtonWithCounterView") or (install_btn.getClass() if (install_btn and hasattr(install_btn, "getClass")) else None)
        if not BWCV:
            return

        resources_provider = self._get_theme_provider(sheet)
        btn = None
        try:
            btn = BWCV(ctx, True, resources_provider)
        except Exception:
            try:
                btn = BWCV(ctx, resources_provider)
            except Exception:
                try:
                    btn = BWCV(ctx)
                except Exception:
                    pass
        if not btn:
            return

        try:
            btn.setRound()
        except Exception:
            pass

        cached_score = None
        cached_has_critical = False
        if resolved_path and os.path.exists(resolved_path):
            try:
                with open(resolved_path, "rb") as f:
                    f_hash = hashlib.sha256(f.read()).hexdigest()
                if f_hash:
                    cached_res = self._get_cached_scan_result(f_hash)
                    if cached_res:
                        c_reports, c_stats = cached_res
                        cached_score, _ = self._calculate_security_score(c_reports, c_stats)
                        cached_has_critical = any(r.get("level") == "CRITICAL" for r in c_reports) or cached_score < 40
            except Exception:
                pass

        if cached_score is not None:
            btn.setText(f"PG: {cached_score}/100", False)
        else:
            btn.setText("Проверка PluginGuard", False)
        btn.setTag("pg_analyze_btn")

        self._current_analyze_btn = btn
        self._current_sheet = sheet
        self._current_install_btn = install_btn
        self._current_parent_layout = target_container

        is_update = False
        try:
            v_up = self._get_field_deep(sheet, "isUpdate")
            if isinstance(v_up, bool):
                is_update = v_up
        except Exception:
            pass
        self._current_is_update = is_update

        orig_listener = None
        if install_btn:
            try:
                m_info = self._get_field_deep(install_btn, "mListenerInfo")
                orig_listener = self._get_field_deep(m_info, "mOnClickListener") if m_info else self._get_field_deep(install_btn, "mOnClickListener")
            except Exception:
                pass
        self._current_orig_listener = orig_listener

        if cached_score is not None:
            if cached_score >= 40 and not cached_has_critical:
                self._current_scan_passed = True
                try:
                    install_btn.setTag("pg_verified")
                    install_btn.setEnabled(True)
                    install_btn.setClickable(True)
                    install_btn.setAlpha(1.0)
                    self._safe_set_text(install_btn, _tr("Обновить", "Update") if is_update else _tr("Установить", "Install"))
                    if orig_listener:
                        install_btn.setOnClickListener(orig_listener)
                except Exception:
                    pass
            else:
                self._current_scan_passed = False
                try:
                    install_btn.setTag("pg_blocked")
                    install_btn.setEnabled(False)
                    install_btn.setClickable(False)
                    install_btn.setAlpha(0.4)
                    self._safe_set_text(install_btn, _tr("Обновление заблокировано", "Update blocked") if is_update else _tr("Установка заблокирована", "Installation blocked"))
                    btn_cls, lin_cls, theme_cls, util_cls, _, _ = self._get_ui_classes()
                    if target_container:
                        self._create_confirmation_card(install_btn.getContext(), install_btn, orig_listener, target_container, lin_cls, util_cls, theme_cls)
                except Exception:
                    pass
        else:
            self._block_unverified_install(install_btn, sheet)

        class GuardClick(dynamic_proxy(View.OnClickListener)):
            def __init__(self, guard_ref, sheet_ref):
                super().__init__()
                self.g = guard_ref
                self.s = sheet_ref

            def onClick(self, v):
                try:
                    _vibrate(v)
                    p = self.g._resolve_full_msg_path(self.s)
                    if p:
                        self.g._scan_file_and_show_alert(p)
                    else:
                        Toast = find_class("android.widget.Toast")
                        if Toast:
                            Toast.makeText(v.getContext(), "Файл плагина загружается...", 0).show()
                except Exception:
                    pass
                finally:
                    del v

        btn.setOnClickListener(GuardClick(self, sheet))

        LLP = find_class("android.widget.LinearLayout$LayoutParams")
        AU = find_class("org.telegram.messenger.AndroidUtilities")

        dp48 = AU.dp(48) if AU else 120
        dp8 = AU.dp(8) if AU else 20
        dp4 = AU.dp(4) if AU else 10

        lp = LLP(-1, dp48) if LLP else None
        if not lp:
            return

        try:
            inst_lp = install_btn.getLayoutParams() if (install_btn and hasattr(install_btn, "getLayoutParams")) else None
            if inst_lp and hasattr(inst_lp, "leftMargin") and inst_lp.leftMargin > 0:
                lp.leftMargin = inst_lp.leftMargin
                lp.rightMargin = inst_lp.rightMargin
            else:
                bg_pad = int(self._get_field_deep(sheet, "backgroundPaddingLeft") or getattr(sheet, "backgroundPaddingLeft", 0) or 0)
                margin_h = bg_pad + (AU.dp(12) if AU else 24)
                lp.leftMargin = margin_h
                lp.rightMargin = margin_h
        except Exception:
            pass

        lp.topMargin = dp8
        lp.bottomMargin = 0

        try:
            if inst_lp:
                inst_lp.bottomMargin = dp4
                install_btn.setLayoutParams(inst_lp)
        except Exception:
            pass

        split_container = target_container.findViewWithTag("kpm_split_container") if hasattr(target_container, "findViewWithTag") else None
        idx = -1
        if split_container and hasattr(target_container, "indexOfChild"):
            try:
                idx = target_container.indexOfChild(split_container)
            except Exception:
                idx = -1
        if idx < 0 and install_btn and hasattr(target_container, "indexOfChild"):
            try:
                idx = target_container.indexOfChild(install_btn)
            except Exception:
                idx = -1

        if idx >= 0:
            target_container.addView(btn, idx + 1, lp)
        else:
            target_container.addView(btn, lp)

    def _hook_install_ui(self):
        plugin_inst = self
        try:
            PPE = find_class("com.exteragram.messenger.plugins.PythonPluginsEngine")
            if PPE:
                class PPEHook(MethodHook):
                    def before_hooked_method(self, param):
                        try:
                            if param.args and len(param.args) > 1:
                                p = plugin_inst._extract_path_from_object(param.args[1])
                                if p:
                                    _pending_file_path[0] = p
                        except Exception:
                            pass
                        finally:
                            del param
                self._track_hooks(self.hook_all_methods(PPE, "showInstallDialog", PPEHook()))
        except Exception:
            pass

        try:
            PC = find_class("com.exteragram.messenger.plugins.PluginsController")
            if PC:
                class PCHook(MethodHook):
                    def before_hooked_method(self, param):
                        try:
                            if param.args:
                                for a in param.args:
                                    p = plugin_inst._extract_path_from_object(a)
                                    if p:
                                        _pending_file_path[0] = p
                                        break
                        except Exception:
                            pass
                        finally:
                            del param
                self._track_hooks(self.hook_all_methods(PC, "showInstallDialog", PCHook()))
        except Exception:
            pass

        try:
            BS = find_class("org.telegram.ui.ActionBar.BottomSheet")
            if BS:
                class BSShowHook(MethodHook):
                    def after_hooked_method(self, param):
                        try:
                            sheet = param.thisObject
                            if sheet and "InstallPluginBottomSheet" in sheet.getClass().getName():
                                if not plugin_inst._is_plugin_trusted(sheet):
                                    run_on_ui_thread(lambda: plugin_inst._inject_guard_ui(sheet))
                        except Exception:
                            pass
                        finally:
                            del param
                self._track_hooks(self.hook_all_methods(BS, "show", BSShowHook()))
        except Exception:
            pass

        target_classes = (
            "com.exteragram.messenger.plugins.ui.components.InstallPluginBottomSheet",
            "com.exteragram.messenger.plugins.p027ui.components.InstallPluginBottomSheet",
            "com.exteragram.messenger.plugins.ui.InstallPluginBottomSheet",
            "com.exteragram.messenger.plugins.ui.PluginInstallBottomSheet",
        )
        for cName in target_classes:
            try:
                IPBS = find_class(cName)
                if not IPBS:
                    continue
                class IPBSHook(MethodHook):
                    def after_hooked_method(self, param):
                        try:
                            sheet = param.thisObject
                            args = list(param.args) if param.args else None
                            if sheet and not plugin_inst._is_plugin_trusted(sheet):
                                run_on_ui_thread(lambda: plugin_inst._inject_guard_ui(sheet, args))
                        except Exception:
                            pass
                        finally:
                            del param

                self._track_hooks(self.hook_all_constructors(IPBS, IPBSHook()))

                class OnInstallClickHook(MethodHook):
                    def before_hooked_method(self, param):
                        try:
                            sheet = param.thisObject
                            if sheet and not plugin_inst._is_plugin_trusted(sheet):
                                b = plugin_inst._get_field_deep(sheet, "button")
                                is_ok = False
                                if b and hasattr(b, "getTag"):
                                    try:
                                        if str(b.getTag() or "") == "pg_verified":
                                            is_ok = True
                                    except Exception:
                                        pass
                                if not is_ok:
                                    p = plugin_inst._resolve_full_msg_path(sheet)
                                    if p and os.path.exists(p):
                                        try:
                                            with open(p, "rb") as f:
                                                fh = hashlib.sha256(f.read()).hexdigest()
                                            cr = plugin_inst._get_cached_scan_result(fh) if fh else None
                                            if cr:
                                                reps, stats = cr
                                                sc, _ = plugin_inst._calculate_security_score(reps, stats)
                                                if sc >= 40 and not any(r.get("level") == "CRITICAL" for r in reps):
                                                    is_ok = True
                                                    if b and hasattr(b, "setTag"):
                                                        b.setTag("pg_verified")
                                        except Exception:
                                            pass
                                if not is_ok:
                                    param.setResult(None)
                                    frag = get_last_fragment()
                                    if frag:
                                        try:
                                            BulletinHelper.show_error("Сначала проверьте плагин через PluginGuard", frag)
                                        except Exception:
                                            pass
                        except Exception:
                            pass
                        finally:
                            del param

                self._track_hooks(self.hook_all_methods(IPBS, "onInstallClick", OnInstallClickHook()))

                class DismissHook(MethodHook):
                    def after_hooked_method(self, param):
                        try:
                            plugin_inst._cleanup_sheet_views()
                        except Exception:
                            pass
                        finally:
                            del param
                self._track_hooks(self.hook_all_methods(IPBS, "dismiss", DismissHook()))
            except Exception:
                pass
