import traceback

from android.view import View
from org.telegram.ui import DialogsActivity

from base_plugin import BasePlugin, MethodHook
from hook_utils import get_private_field

__id__ = "add_to_folder"
__name__ = "Add to Folder in Folders"
__description__ = ("Shows the \"Add to folder\" button when selecting chats "
                    "inside a folder, not only on the main screen.\n\n"
                    "Показывает кнопку «Добавить в папку» при выборе чатов "
                    "внутри папки, а не только на главном экране.")
__author__ = "@itNotMax - @MaxExteraPlugins"
__version__ = "1.0"
__icon__ = "MaxExteraPluginsStickers/14"

def _log_err(plugin_ref, tag):
    try:
        plugin_ref.log(tag + ": " + traceback.format_exc())
    except Exception:
        pass


class UpdateCountersHook(MethodHook):

    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            self.plugin._on_counters_updated(param.thisObject)
        except Exception:
            pass


class AddToFolder(BasePlugin):

    def on_plugin_load(self):
        self._unhook_refs = []
        self._install_hooks()

    def on_plugin_unload(self):
        for h in getattr(self, "_unhook_refs", []):
            try:
                self.unhook_method(h)
            except Exception:
                pass
        self._unhook_refs.clear()

    def _keep_unhook(self, uh):
        if uh is None:
            return
        if isinstance(uh, (list, tuple, set)):
            for h in uh:
                if h is not None:
                    self._unhook_refs.append(h)
        else:
            self._unhook_refs.append(uh)

    def _install_hooks(self):
        try:
            dialogs_cls = DialogsActivity.getClass()
            for m in dialogs_cls.getDeclaredMethods():
                if m.getName() == "updateCounters":
                    m.setAccessible(True)
                    self._keep_unhook(self.hook_method(m, UpdateCountersHook(self)))
                    break
        except Exception:
            _log_err(self, "ADD_TO_FOLDER-HOOK-UPDATECOUNTERS")

    def _on_counters_updated(self, fragment):
        try:
            if fragment is None:
                return
            add_item = get_private_field(fragment, "addToFolderItem")
            if add_item is None:
                return
            action_bar = fragment.getActionBar()
            if action_bar is None:
                return
            try:
                if not bool(action_bar.isActionModeShowed()):
                    return
            except Exception:
                return
            filter_tabs = get_private_field(fragment, "filterTabsView")
            in_folder_tab = (
                filter_tabs is not None
                and int(filter_tabs.getVisibility()) == View.VISIBLE
                and not bool(filter_tabs.currentTabIsDefault())
            )
            folder_id = get_private_field(fragment, "folderId")
            direct_folder = folder_id is not None and int(folder_id) != 0
            if not in_folder_tab and not direct_folder:
                return
            add_item.setVisibility(View.VISIBLE)
        except Exception:
            pass


