def locale_code():
    try:
        controller = LocaleController.getInstance()
        locale_info = controller.getCurrentLocaleInfo()
        language_code = str(getattr(locale_info, "shortName", "") or "")
        if not language_code:
            language_code = str(controller.getCurrentLocale().getLanguage() or "")
    except Exception:
        language_code = ""
    primary = language_code.strip().lower().replace("_", "-").split("-", 1)[0]
    if primary in RUSSIAN_FALLBACK_LANGUAGES:
        return "ru"
    return "en"


class Dex:
    def __init__(self, entry_class):
        self.entry_class = entry_class
        self.clazz = None
        self.loaded = False

    def load(self):
        if self.loaded:
            return
        if self.clazz is None:
            context = ApplicationLoader.applicationContext
            if context is None:
                raise RuntimeError("application context is not ready")
            if int(BuildVersion.SDK_INT) < 26:
                raise RuntimeError("embedded DEX requires Android API 26+")
            ByteBuffer = jclass("java.nio.ByteBuffer")
            InMemoryDexClassLoader = jclass("dalvik.system.InMemoryDexClassLoader")
            loader = InMemoryDexClassLoader(
                ByteBuffer.wrap(self._read_payload()),
                context.getClassLoader(),
            )
            self.clazz = loader.loadClass(self.entry_class)
        try:
            self._invoke("load")
            self.loaded = True
        except Exception as load_error:
            try:
                self._invoke("unload")
            except Exception as cleanup_error:
                raise RuntimeError(
                    "DEX load failed and cleanup also failed: "
                    f"{load_error}; cleanup: {cleanup_error}"
                ) from cleanup_error
            raise

    def unload(self):
        if self.clazz is None or not self.loaded:
            return
        try:
            self._invoke("unload")
        finally:
            self.loaded = False

    def refresh(self):
        if self.clazz is None or not self.loaded:
            return
        self._invoke("refresh")

    def _invoke(self, method_name, *args):
        if self.clazz is None:
            raise RuntimeError("embedded DEX class is not loaded")
        matches = []
        for method in self.clazz.getDeclaredMethods():
            if str(method.getName()) != method_name:
                continue
            if len(method.getParameterTypes()) != len(args):
                continue
            method.setAccessible(True)
            matches.append(method)
        if len(matches) > 1:
            raise RuntimeError(f"ambiguous core method: {method_name}/{len(args)}")
        if not matches:
            raise RuntimeError(f"core method not found: {method_name}/{len(args)}")
        try:
            return matches[0].invoke(None, *args)
        except Exception as exc:
            cause = None
            try:
                cause = exc.getCause()
            except Exception:
                pass
            if cause is not None:
                try:
                    message = cause.getMessage()
                except Exception:
                    message = None
                raise RuntimeError(str(message or cause)) from exc
            raise

    def _read_payload(self):
        try:
            with open(__file__, "r", encoding="utf-8") as source:
                text = source.read()
            block = text.split(f"# {DEX_BEGIN}", 1)[1].split(f"# {DEX_END}", 1)[0]
            payload = "".join(
                line.strip()[1:].strip()
                for line in block.splitlines()
                if line.strip().startswith("#")
            )
        except Exception as exc:
            raise RuntimeError(f"embedded dex read failed: {exc}") from exc
        if not payload:
            raise RuntimeError("embedded dex payload not found")
        try:
            return zlib.decompress(base64.b64decode(payload))
        except Exception as exc:
            raise RuntimeError(f"embedded dex decode failed: {exc}") from exc


class MentionAvatarsPlugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self.dex = Dex(ENTRY_CLASS)

    def on_plugin_load(self):
        try:
            self.dex.load()
        except Exception:
            try:
                self.dex.unload()
            except Exception as cleanup_error:
                self.logger.error(f"MentionAvatars cleanup failed: {cleanup_error}")
            self.logger.exception("MentionAvatars failed to load")
            raise

    def on_plugin_unload(self):
        try:
            self.dex.unload()
        except Exception:
            self.logger.exception("MentionAvatars failed to unload")

    def _on_setting_changed(self, *_args):
        try:
            self.dex.refresh()
        except Exception:
            self.logger.exception("MentionAvatars settings refresh failed")
        try:
            center = NotificationCenter.getInstance(int(UserConfig.selectedAccount))
            try:
                center.postNotificationNameOnUIThread(NotificationCenter.emojiLoaded)
            except Exception:
                center.postNotificationName(NotificationCenter.emojiLoaded)
        except Exception:
            pass

    def create_settings(self) -> List[Any]:
        text = PLUGIN_STRINGS[locale_code()]
        return [
            Header(text=text["header"]),
            Switch(
                key="enabled",
                text=text["enabled"],
                default=True,
                subtext=text["enabled_sub"],
                icon="msg_settings",
                on_change=self._on_setting_changed,
            ),
            Selector(
                key="position",
                text=text["position"],
                default=0,
                items=[text["position_before"], text["position_after"], text["position_instead"]],
                icon="msg_customize",
                on_change=self._on_setting_changed,
            ),
            Selector(
                key="size",
                text=text["size"],
                default=1,
                items=[text["size_small"], text["size_medium"], text["size_large"]],
                icon="msg_info",
                on_change=self._on_setting_changed,
            ),
            Divider(),
            Switch(
                key="include_chats",
                text=text["include_chats"],
                default=True,
                subtext=text["include_chats_sub"],
                icon="msg_groups",
                on_change=self._on_setting_changed,
            ),
            Switch(
                key="include_bots",
                text=text["include_bots"],
                default=True,
                subtext=text["include_bots_sub"],
                icon="msg_bot",
                on_change=self._on_setting_changed,
            ),
        ]


