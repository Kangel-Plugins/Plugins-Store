__id__ = "mention_avatars"
__name__ = "MentionAvatars"
__description__ = (
    "Добавляет аватар пользователя рядом с его ником при его @упоминании в сообщении"
)
__author__ = "@limeplug"
__version__ = "1.2.5"
__icon__ = "masquernya/13"
__app_version__ = ">=12.10.6"
__sdk_version__ = ">=1.4.5.3"

