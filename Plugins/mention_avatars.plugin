DEX_BEGIN = "__DEX_BEGIN__"
DEX_END = "__DEX_END__"
BuildVersion = jclass("android.os.Build$VERSION")
RUSSIAN_FALLBACK_LANGUAGES = frozenset("ru be kk ky uz tg tt ba".split())

PLUGIN_STRINGS = {
