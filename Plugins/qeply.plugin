import time
from typing import Any, List, Optional

from android.widget import FrameLayout
from android_utils import run_on_ui_thread
from base_plugin import BasePlugin, MethodHook
from client_utils import send_request
from extera_utils.classes import Base, java_subclass, joverride
from hook_utils import find_class
from java import cast, jclass, jint
from ui.settings import Custom, Divider, Header, SimpleSettingFactory, Switch

__id__ = "qeply"
__name__ = "Qeply"
__description__ = "Реплай цитирует сообщение"
__author__ = "@scvnms"
__version__ = "1.0"
__icon__ = "TgAndroidIcons/15"
__app_version__ = ">=12.10.6"
__sdk_version__ = ">=1.4.5.0"

CHAT_ACTIVITY = "org.telegram.ui.ChatActivity"
REPLY_QUOTE = "org.telegram.ui.ChatActivity$ReplyQuote"
MAX_QUOTE_LENGTH = 1024
QUOTE_HEADER_FLAGS = 16 | 64 | 512 | 1024
PLAIN_HEADER_FLAGS = 16
MAX_CONTAINERS = 6

PREVIEW_USER_ID = 963080346
PREVIEW_USERNAME = "immat0x1"
PREVIEW_FALLBACK_NAME = "илья"
PREVIEW_CHAT_ID = 1
PREVIEW_ORIGINAL = "Съешь ещё этих мягких французских булок, да выпей же чаю"
PREVIEW_REPLY = "В чащах юга жил бы цитрус? Да, но фальшивый экземпляр!"

_PLUGIN = None
_CONTAINERS_OTHERS = []
_CONTAINERS_OWN = []
_STATE = {"account": 0, "preview_id": PREVIEW_USER_ID}

def _cell_params():
    from org.telegram.messenger import AndroidUtilities

    lp = FrameLayout.LayoutParams(-1, -2)
    margin = int(AndroidUtilities.dp(6))
    lp.setMargins(0, margin, 0, margin)
    return lp

def _utf16_len(text: str) -> int:
    return len(text.encode("utf-16-le")) // 2

def _get_preview_user(account: int):
    from java.lang import Long
    from org.telegram.messenger import MessagesController

    try:
        ctrl = MessagesController.getInstance(account)
        return ctrl.getUser(Long.valueOf(_STATE["preview_id"]))
    except Exception:
        return None

def _apply_users(account: int, users) -> bool:
    from org.telegram.messenger import MessagesController

    if users is None or users.size() == 0:
        return False
    first = users.get(0)
    if not hasattr(first, "first_name"):
        return False
    MessagesController.getInstance(account).putUsers(users, False)
    _STATE["preview_id"] = int(first.id)
    run_on_ui_thread(_refresh_others)
    return True

def _load_preview_user(account: int) -> None:
    plugin = _PLUGIN
    if plugin is None or plugin._resolving:
        return
    plugin._resolving = True

    try:
        from java.util import ArrayList
        from org.telegram.tgnet import TLRPC

        def by_username():
            try:
                req = TLRPC.TL_contacts_resolveUsername()
                req.username = PREVIEW_USERNAME

                def on_resolved(response, error):
                    try:
                        users = getattr(response, "users", None) if response is not None else None
                        if not _apply_users(account, users):
                            plugin.logger.info("resolveUsername failed: %s" % (error,))
                    except Exception:
                        plugin.logger.exception("resolveUsername callback failed")
                    plugin._resolving = False

                send_request(req, on_resolved)
            except Exception:
                plugin._resolving = False
                plugin.logger.exception("resolveUsername request failed")

        req = TLRPC.TL_users_getUsers()
        input_user = TLRPC.TL_inputUser()
        input_user.user_id = PREVIEW_USER_ID
        input_user.access_hash = 0
        req.id.add(input_user)

        def on_users(response, error):
            try:
                objects = getattr(response, "objects", None) if response is not None else None
                users = ArrayList()
                if objects is not None:
                    for obj in objects.toArray():
                        users.add(obj)
                if _apply_users(account, users):
                    plugin._resolving = False
                    return
            except Exception:
                plugin.logger.exception("getUsers callback failed")
            by_username()

        send_request(req, on_users)
    except Exception:
        plugin._resolving = False
        plugin.logger.exception("preview user request failed")

def _fill_preview_others(container, account: int, quote_mode: bool) -> None:
    from android.view import View
    from android.widget import FrameLayout, TextView
    from org.telegram.messenger import AndroidUtilities, MessageObject, UserConfig
    from org.telegram.tgnet import TLRPC
    from org.telegram.ui.Cells import ChatMessageCell

    container.removeAllViews()
    container.setClipChildren(False)
    container.setClipToPadding(False)
    context = container.getContext()

    try:
        now = int(time.time())
        me = UserConfig.getInstance(account).getClientUserId()
        target_id = _STATE["preview_id"]
        user = _get_preview_user(account)

        orig = TLRPC.TL_message()
        orig.id = 1
        orig.date = now - 60
        orig.message = PREVIEW_ORIGINAL
        orig.out = False
        orig.dialog_id = -PREVIEW_CHAT_ID
        orig.flags = 1 << 28
        orig.media = TLRPC.TL_messageMediaEmpty()
        orig.peer_id = TLRPC.TL_peerChat()
        orig.peer_id.chat_id = PREVIEW_CHAT_ID
        orig.from_id = TLRPC.TL_peerUser()
        orig.from_id.user_id = target_id

        header = TLRPC.TL_messageReplyHeader()
        header.reply_to_msg_id = 1
        if quote_mode:
            header.flags = QUOTE_HEADER_FLAGS
            header.quote = True
            header.quote_text = PREVIEW_ORIGINAL
            header.quote_offset = 0
        else:
            header.flags = PLAIN_HEADER_FLAGS

        mine = TLRPC.TL_message()
        mine.id = 2
        mine.date = now
        mine.message = PREVIEW_REPLY
        mine.out = False
        mine.dialog_id = -PREVIEW_CHAT_ID
        mine.flags = (1 << 28) | 8
        mine.media = TLRPC.TL_messageMediaEmpty()
        mine.peer_id = TLRPC.TL_peerChat()
        mine.peer_id.chat_id = PREVIEW_CHAT_ID
        mine.from_id = TLRPC.TL_peerUser()
        mine.from_id.user_id = me
        mine.reply_to = header
        mine.replyMessage = orig

        orig_mo = MessageObject(account, orig, True, False)
        mine_mo = MessageObject(account, mine, orig_mo, True, False)
        mine_mo.forceAvatar = True
        if user is None:
            mine_mo.customReplyName = PREVIEW_FALLBACK_NAME
        try:
            mine_mo.eventId = 1
        except Exception:
            pass

        cell = ChatMessageCell(context, account)
        try:
            cell.isChat = True
        except Exception:
            pass
        cell.setFullyDraw(True)
        w = int(container.getWidth())
        if w <= 0:
            w = int(AndroidUtilities.displaySize.x)
        cell.setParentViewSize(w, int(AndroidUtilities.displaySize.y))
        cell.setMessageObject(mine_mo, None, False, False, False)

        container.addView(cell, _cell_params())

        overlay = View(context)
        overlay.setClickable(True)
        container.addView(overlay, FrameLayout.LayoutParams(-1, -1))
        container.setTag("quote" if quote_mode else "plain")
    except Exception as e:
        if _PLUGIN is not None:
            _PLUGIN.logger.exception("preview build failed")
        label = TextView(context)
        label.setText("Preview error: %s" % e)
        label.setPadding(40, 40, 40, 40)
        container.addView(label, FrameLayout.LayoutParams(-1, -2))
        container.setTag("error")

def _fill_preview_own(container, account: int, quote_mode: bool) -> None:
    from android.widget import FrameLayout, TextView
    from org.telegram.messenger import AndroidUtilities, MessageObject, UserConfig
    from org.telegram.tgnet import TLRPC
    from org.telegram.ui.Cells import ChatMessageCell

    container.removeAllViews()
    container.setClipChildren(False)
    container.setClipToPadding(False)
    context = container.getContext()

    try:
        now = int(time.time())
        me = UserConfig.getInstance(account).getClientUserId()

        orig = TLRPC.TL_message()
        orig.id = 1
        orig.date = now - 60
        orig.message = PREVIEW_ORIGINAL
        orig.out = True
        orig.dialog_id = -PREVIEW_CHAT_ID
        orig.flags = 1 << 28
        orig.media = TLRPC.TL_messageMediaEmpty()
        orig.peer_id = TLRPC.TL_peerChat()
        orig.peer_id.chat_id = PREVIEW_CHAT_ID
        orig.from_id = TLRPC.TL_peerUser()
        orig.from_id.user_id = me

        header = TLRPC.TL_messageReplyHeader()
        header.reply_to_msg_id = 1
        if quote_mode:
            header.flags = QUOTE_HEADER_FLAGS
            header.quote = True
            header.quote_text = PREVIEW_ORIGINAL
            header.quote_offset = 0
        else:
            header.flags = PLAIN_HEADER_FLAGS

        mine = TLRPC.TL_message()
        mine.id = 2
        mine.date = now
        mine.message = PREVIEW_REPLY
        mine.out = True
        mine.dialog_id = -PREVIEW_CHAT_ID
        mine.flags = (1 << 28) | 8
        mine.media = TLRPC.TL_messageMediaEmpty()
        mine.peer_id = TLRPC.TL_peerChat()
        mine.peer_id.chat_id = PREVIEW_CHAT_ID
        mine.from_id = TLRPC.TL_peerUser()
        mine.from_id.user_id = me
        mine.reply_to = header
        mine.replyMessage = orig

        orig_mo = MessageObject(account, orig, True, False)
        mine_mo = MessageObject(account, mine, orig_mo, True, False)
        try:
            mine_mo.eventId = 1
        except Exception:
            pass

        cell = ChatMessageCell(context, account)
        try:
            cell.isChat = True
        except Exception:
            pass
        cell.setFullyDraw(True)
        w = int(container.getWidth())
        if w <= 0:
            w = int(AndroidUtilities.displaySize.x)
        cell.setParentViewSize(w, int(AndroidUtilities.displaySize.y))
        cell.setMessageObject(mine_mo, None, False, False, False)

        container.addView(cell, _cell_params())
        container.setTag("quote" if quote_mode else "plain")
    except Exception as e:
        if _PLUGIN is not None:
            _PLUGIN.logger.exception("own preview build failed")
        label = TextView(context)
        label.setText("Preview error: %s" % e)
        label.setPadding(40, 40, 40, 40)
        container.addView(label, FrameLayout.LayoutParams(-1, -2))
        container.setTag("error")

def _preview_mode_others() -> bool:
    return bool(_PLUGIN.get_setting("quote_others", True)) if _PLUGIN is not None else True

def _preview_mode_own() -> bool:
    return bool(_PLUGIN.get_setting("quote_own", True)) if _PLUGIN is not None else True

def _draw_cell_avatar(frame, canvas) -> None:
    from org.telegram.messenger import AndroidUtilities

    child = frame.getChildAt(0)
    if child is None:
        return
    cell = cast(jclass("org.telegram.ui.Cells.ChatMessageCell"), child)
    image = cell.getAvatarImage()
    if image is None:
        return
    bottom = int(child.getTop()) + int(cell.getPaddingTopAnimated()) + int(cell.getLayoutHeight())
    image.setImageY(float(bottom - AndroidUtilities.dp(44)))
    image.setVisible(True, False)
    image.setAlpha(1.0)
    image.draw(canvas)

def _post_refill(container, own: bool) -> None:
    def run():
        try:
            if own:
                _fill_preview_own(container, _STATE["account"], _preview_mode_own())
            else:
                _fill_preview_others(container, _STATE["account"], _preview_mode_others())
        except Exception:
            if _PLUGIN is not None:
                _PLUGIN.logger.exception("preview refill failed")

    run_on_ui_thread(run)

@java_subclass(FrameLayout)
class PreviewFrame(Base):
    @joverride()
    def dispatchDraw(self, canvas):
        super().dispatchDraw(canvas)
        try:
            _draw_cell_avatar(self.java, canvas)
        except Exception:
            if _PLUGIN is not None:
                _PLUGIN.logger.exception("avatar draw failed")

    @joverride()
    def onSizeChanged(self, w, h, oldw, oldh):
        super().onSizeChanged(w, h, oldw, oldh)
        if w > 0 and w != oldw:
            _post_refill(self.java, False)

    @joverride()
    def onAttachedToWindow(self):
        super().onAttachedToWindow()
        if self.java.getChildCount() == 0:
            _post_refill(self.java, False)

@java_subclass(FrameLayout)
class OwnPreviewFrame(Base):
    @joverride()
    def onSizeChanged(self, w, h, oldw, oldh):
        super().onSizeChanged(w, h, oldw, oldh)
        if w > 0 and w != oldw:
            _post_refill(self.java, True)

    @joverride()
    def onAttachedToWindow(self):
        super().onAttachedToWindow()
        if self.java.getChildCount() == 0:
            _post_refill(self.java, True)

def _create_preview_view_others(context, list_view, current_account: int, class_guid: int, resources_provider):
    account = int(current_account)
    _STATE["account"] = account
    container = PreviewFrame.new_instance(context).java
    _fill_preview_others(container, account, _preview_mode_others())
    _CONTAINERS_OTHERS.append(container)
    if len(_CONTAINERS_OTHERS) > MAX_CONTAINERS:
        del _CONTAINERS_OTHERS[0]
    _load_preview_user(account)
    return container

def _bind_preview_view_others(view, item, divider: bool, adapter, list_view):
    want = "quote" if _preview_mode_others() else "plain"
    if view.getChildCount() == 0 or str(view.getTag()) != want:
        _fill_preview_others(view, _STATE["account"], _preview_mode_others())

def _refresh_others(mode: Optional[bool] = None) -> None:
    if mode is None:
        mode = _preview_mode_others()
    for container in list(_CONTAINERS_OTHERS):
        try:
            _fill_preview_others(container, _STATE["account"], mode)
        except Exception:
            pass

def _create_preview_view_own(context, list_view, current_account: int, class_guid: int, resources_provider):
    account = int(current_account)
    _STATE["account"] = account
    container = OwnPreviewFrame.new_instance(context).java
    _fill_preview_own(container, account, _preview_mode_own())
    _CONTAINERS_OWN.append(container)
    if len(_CONTAINERS_OWN) > MAX_CONTAINERS:
        del _CONTAINERS_OWN[0]
    return container

def _bind_preview_view_own(view, item, divider: bool, adapter, list_view):
    want = "quote" if _preview_mode_own() else "plain"
    if view.getChildCount() == 0 or str(view.getTag()) != want:
        _fill_preview_own(view, _STATE["account"], _preview_mode_own())

def _refresh_own(mode: Optional[bool] = None) -> None:
    if mode is None:
        mode = _preview_mode_own()
    for container in list(_CONTAINERS_OWN):
        try:
            _fill_preview_own(container, _STATE["account"], mode)
        except Exception:
            pass

PREVIEW_FACTORY_OTHERS = SimpleSettingFactory(
    _create_preview_view_others,
    _bind_preview_view_others,
    is_clickable=False,
    is_shadow=True,
)

PREVIEW_FACTORY_OWN = SimpleSettingFactory(
    _create_preview_view_own,
    _bind_preview_view_own,
    is_clickable=False,
    is_shadow=True,
)

class ReplyHook(MethodHook):
    def __init__(self, plugin: "QuoteReplyPlugin"):
        self.plugin = plugin

    def before_hooked_method(self, param):
        self.plugin.handle_reply(param)

class QuoteReplyPlugin(BasePlugin):
    def on_plugin_load(self):
        global _PLUGIN
        _PLUGIN = self
        self._busy = False
        self._resolving = False
        self._ok = self._install_hook()
        self.logger.info("hook installed: %s" % self._ok)

    def on_plugin_unload(self):
        global _PLUGIN
        _CONTAINERS_OTHERS.clear()
        _CONTAINERS_OWN.clear()
        _PLUGIN = None

    def _on_quote_others_changed(self, new_value: bool):
        run_on_ui_thread(lambda: _refresh_others(bool(new_value)))

    def _on_quote_own_changed(self, new_value: bool):
        run_on_ui_thread(lambda: _refresh_own(bool(new_value)))

    def create_settings(self) -> List[Any]:
        return [
            Header(text="Чужие сообщения"),
            Custom(factory=PREVIEW_FACTORY_OTHERS.instance.java),
            Switch(
                key="quote_others",
                text="Цитирование чужих сообщений",
                default=True,
                subtext="Включает цитирование чужих сообщений заместо обычного реплая.",
                icon="menu_feature_transparent",
                on_change=self._on_quote_others_changed,
            ),
            Divider(),
            Header(text="Свои сообщения"),
            Custom(factory=PREVIEW_FACTORY_OWN.instance.java),
            Switch(
                key="quote_own",
                text="Цитирование своих сообщений",
                default=True,
                subtext="Включает цитирование своих сообщений заместо обычного реплая.",
                icon="menu_feature_transparent",
                on_change=self._on_quote_own_changed,
            ),
        ]

    def _install_hook(self) -> bool:
        try:
            cls = find_class(CHAT_ACTIVITY)
            if cls is not None:
                unhooks = self.hook_all_methods(cls, "showFieldPanelForReply", ReplyHook(self))
                if unhooks:
                    return True
        except Exception:
            self.logger.exception("hook_all_methods failed")

        try:
            from java.lang import Class
            from org.telegram.messenger import ApplicationLoader

            loader = ApplicationLoader.applicationContext.getClassLoader()
            chat_cls = Class.forName(CHAT_ACTIVITY, True, loader)
            mo_cls = Class.forName("org.telegram.messenger.MessageObject", True, loader)
            method = chat_cls.getDeclaredMethod("showFieldPanelForReply", mo_cls)
            method.setAccessible(True)
            return bool(self.hook_method(method, ReplyHook(self)))
        except Exception:
            self.logger.exception("fallback hook failed")
            return False

    def handle_reply(self, param) -> None:
        if self._busy:
            return
        try:
            msg = param.args[0]
            chat = param.thisObject
            if msg is None or chat is None:
                return

            setting_key = "quote_own" if msg.isOutOwner() else "quote_others"
            if not self.get_setting(setting_key, True):
                return

            try:
                current = chat.getReplyQuote()
                if (current is not None and current.message is not None
                        and int(current.message.getId()) == int(msg.getId())):
                    return
            except Exception:
                pass

            text = self._message_text(msg)
            if not text:
                return

            length = min(_utf16_len(text), MAX_QUOTE_LENGTH)

            quote_cls = jclass(REPLY_QUOTE)
            factory = getattr(quote_cls, "from_", None) or getattr(quote_cls, "from")
            quote = factory(msg, jint(0), jint(length))
            if quote is None:
                return

            self._busy = True
            try:
                chat.showFieldPanelForReplyQuote(msg, quote)
            finally:
                self._busy = False

            param.setResult(None)
        except Exception:
            self._busy = False
            self.logger.exception("handle_reply failed")

    @staticmethod
    def _message_text(msg: Any) -> Optional[str]:
        try:
            text = msg.messageOwner.message
        except Exception:
            return None
        if text is None:
            return None
        text = str(text)
        return text if text.strip() else None
