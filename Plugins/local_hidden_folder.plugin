import base64
import json
import zlib

from base_plugin import BasePlugin, MenuItemData, MenuItemType
from java import jclass

__id__ = "local_hidden_folder"
__name__ = "Hidden Folder"
__description__ = "Hide chats in a local folder with a passcode."
__author__ = "@anivplugins"
__version__ = "1.0.0"
__icon__ = "anivdev/1"
__category__ = ["chats", "privacy"]
__app_version__ = ">=12.10.6"
__sdk_version__ = ">=1.4.0"

ENTRY_CLASS = "com.aniv.hiddenfolder.HiddenFolderCore"

def _tr(russian, english):
    try:
        locale = jclass("org.telegram.messenger.LocaleController").getInstance().getCurrentLocale()
        return russian if str(locale.getLanguage()) == "ru" else english
    except Exception:
        return english

BOOT_DIALOGS = r'''
if (object.state.get("enabled") && result != null) {
    uid = org.telegram.messenger.UserConfig.getInstance(param.args[0].intValue()).getClientUserId();
    ids = object.state.get("members").get(uid);
    if (ids != null && !ids.isEmpty()) {
        clean = new java.util.ArrayList();
        for (dialog : result) { if (!ids.contains(dialog.id)) clean.add(dialog); }
        param.setResult(clean);
    }
}
return false;
'''
BOOT_CELL = r'''
if (object.state.get("enabled")) {
    cell = param.thisObject;
    account = object.account.getInt(cell);
    uid = org.telegram.messenger.UserConfig.getInstance(account).getClientUserId();
    ids = object.state.get("members").get(uid);
    did = 0L;
    if (object.kind == 2) {
        peer = cell.getCurrentObject();
        if (peer instanceof org.telegram.tgnet.TLRPC$User) did = peer.id;
        else if (peer instanceof org.telegram.tgnet.TLRPC$Chat) did = -peer.id;
    } else { did = cell.getDialogId(); }
    views = object.state.get("views");
    if (ids != null && ids.contains(did)) {
        if (!views.containsKey(cell)) views.put(cell, cell.getVisibility());
        cell.setVisibility(4); param.setResult(null);
    } else if (views.containsKey(cell)) { cell.setVisibility(views.remove(cell)); }
}
return false;
'''
BOOT_CHAT = r'''
if (object.state.get("enabled")) {
    account = object.account.getInt(param.thisObject);
    uid = org.telegram.messenger.UserConfig.getInstance(account).getClientUserId();
    ids = object.state.get("members").get(uid);
    if (ids != null && !ids.isEmpty()) {
        args = param.thisObject.getArguments(); did = 0L;
        if (args != null) {
            chat = args.getLong("chat_id", 0L); user = args.getLong("user_id", 0L); enc = args.getInt("enc_id", 0);
            if (chat != 0) did = -chat;
            else if (user != 0) did = user;
            else if (enc != 0) did = (1L << 62) | (enc & 4294967295L);
        }
        if (ids.contains(did)) param.setResult(false);
    }
}
return false;
'''
BOOT_COUNTER = r'''
if (object.state.get("enabled") && object.state.get("nativeCounters") != true) {
    account = object.account.getInt(param.thisObject);
    uid = org.telegram.messenger.UserConfig.getInstance(account).getClientUserId();
    ids = object.state.get("members").get(uid);
    if (object.kind == 1) {
        for (entry : object.state.get("members").values()) {
            if (!entry.isEmpty()) { param.setResult(0); }
        }
    } else if (ids != null && !ids.isEmpty()) { param.setResult(0); }
}
return false;
'''

class EarlyPrivacy:
    def __init__(self, plugin):
        self.plugin = plugin
        self.handles = []
        self.state = None

    @staticmethod
    def _unused(param):
        pass

    def install(self, stored):
        from base_plugin import HookFilter
        from hook_utils import find_class
        HashMap = jclass("java.util.HashMap")
        Long = jclass("java.lang.Long")
        context = jclass("org.telegram.messenger.ApplicationLoader").applicationContext
        prefs = context.getSharedPreferences("aniv_local_hidden_folder", 0)
        members = HashMap()
        legacy = {key: str(value) for key, value in stored.items()
                  if key.startswith("account_") and key[8:].isdigit() and value}
        entries = prefs.getAll().entrySet().iterator()
        while entries.hasNext():
            entry = entries.next()
            key = str(entry.getKey())
            if key.startswith("account_") and key[8:].isdigit():
                legacy[key] = str(entry.getValue())
        for key, value in legacy.items():
            ids = jclass("java.util.HashSet")()
            for did in json.loads(value).get("members", []):
                if int(did):
                    ids.add(Long.valueOf(str(did)))
            members.put(Long.valueOf(key[8:]), ids)
        views = jclass("java.util.Collections").synchronizedMap(jclass("java.util.WeakHashMap")())
        self.state = HashMap()
        self.state.put("enabled", True)
        self.state.put("members", members)
        self.state.put("views", views)

        def register(name, method, expression, before, kind=0):
            jclass("org.mvel2.MVEL").compileExpression(expression)
            binding = HashMap()
            binding.put("state", self.state)
            binding.put("kind", kind)
            if name != "org.telegram.ui.DialogsActivity":
                clazz = jclass("java.lang.Class").forName(name)
                field = None
                while clazz is not None:
                    try:
                        field = clazz.getDeclaredField("currentAccount")
                        field.setAccessible(True)
                        break
                    except Exception:
                        clazz = clazz.getSuperclass()
                if field is None:
                    raise RuntimeError(name + _tr(": currentAccount недоступен", ": currentAccount unavailable"))
                binding.put("account", field)
            filters = [HookFilter.Condition(expression, binding)]
            never = [HookFilter.Condition("false")]
            kwargs = {"before": self._unused, "after": self._unused,
                      "before_filters": filters if before else never,
                      "after_filters": never if before else filters}
            handles = self.plugin.hook_all_methods(find_class(name), method, priority=2147483647, **kwargs)
            if not handles:
                raise RuntimeError(_tr("Нет раннего перехвата: ", "Early hook unavailable: ") + name + "." + method)
            self.handles.extend(handles)

        register("org.telegram.ui.DialogsActivity", "getDialogsArray", BOOT_DIALOGS, False)
        for name, bind, kind in (("DialogCell", "setDialog", 0), ("ProfileSearchCell", "setData", 1), ("UserCell", "setData", 2)):
            target = "org.telegram.ui.Cells." + name
            register(target, bind, BOOT_CELL, False, kind)
            register(target, "onDraw", BOOT_CELL, True, kind)
        for screen in ("org.telegram.ui.ChatActivity", "org.telegram.ui.TopicsFragment"):
            register(screen, "onFragmentCreate", BOOT_CHAT, True)

        for method in ("getMainUnreadCount", "getArchiveUnreadCount"):
            register("org.telegram.messenger.MessagesStorage", method, BOOT_COUNTER, False)
        register("org.telegram.messenger.NotificationsController", "getTotalUnreadCount", BOOT_COUNTER, False)
        register("org.telegram.messenger.NotificationsController", "getTotalAllUnreadCount", BOOT_COUNTER, False, 1)

    def close(self, handoff=False):
        if self.state is not None:
            self.state.put("enabled", False)
        for handle in self.handles:
            try:
                self.plugin.unhook_method(handle)
            except Exception as exc:
                self.plugin.log("Hidden Folder / early unhook: " + str(exc))
        self.handles.clear()
        if not handoff and self.state is not None:
            from android_utils import run_on_ui_thread
            views = self.state.get("views")
            def restore():
                try:
                    entries = jclass("java.util.ArrayList")(views.entrySet()).iterator()
                    while entries.hasNext():
                        entry = entries.next()
                        if entry.getKey() is not None:
                            entry.getKey().setVisibility(int(entry.getValue()))
                    views.clear()
                except Exception as exc:
                    self.plugin.log("Hidden Folder / early restore: " + str(exc))
            run_on_ui_thread(restore)

def read_payload():
    data = zlib.decompress(base64.b64decode(_DEX_PAYLOAD, validate=True))
    if not data.startswith(b"dex\n"):
        raise RuntimeError(_tr("Встроенный DEX повреждён", "Embedded DEX is corrupted"))
    return data

class Dex:
    def __init__(self):
        self.clazz = self.loader = None
        self.methods = None
        self.loaded = False

    def load(self, migration, warm_state=None, entry_point=0):
        if self.loaded:
            return
        if int(jclass("android.os.Build$VERSION").SDK_INT) < 26:
            raise RuntimeError(_tr("Для DEX нужен Android 8.0 или новее", "DEX requires Android 8.0 or newer"))
        context = jclass("org.telegram.messenger.ApplicationLoader").applicationContext
        if context is None:
            raise RuntimeError(_tr("Контекст приложения недоступен", "App context unavailable"))
        try:
            data = jclass("java.nio.ByteBuffer").wrap(read_payload())
            self.loader = jclass("dalvik.system.InMemoryDexClassLoader")(data, context.getClassLoader())
            self.clazz = self.loader.loadClass(ENTRY_CLASS)
            self.call("configure", migration)
            if warm_state is not None:
                self.call("configureWarm", warm_state)
            self.call("setEntryPoint", str(entry_point))
            self.call("load")
            self.loaded = True
        except Exception:
            self.unload()
            raise

    def call(self, name, *args):
        if self.clazz is None:
            raise RuntimeError(_tr("DEX не загружен", "DEX is not loaded"))
        if self.methods is None:
            resolved = {}
            methods = self.clazz.getDeclaredMethods()
            for index in range(len(methods)):
                method = methods[index]
                key = (str(method.getName()), len(method.getParameterTypes()))
                resolved.setdefault(key, []).append(method)
            self.methods = resolved
        matches = self.methods.get((name, len(args)), ())
        if len(matches) != 1:
            raise RuntimeError(_tr("Нет однозначного DEX-метода: ", "Ambiguous or missing DEX method: ") + name)
        return matches[0].invoke(None, *args)

    def unload(self):
        try:
            if self.clazz is not None:
                self.call("unload")
        finally:
            self.loaded = False
            self.clazz = self.loader = None
            self.methods = None

class HiddenFolderPlugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self.dex = None
        self.failure = None
        self.menu_added = False
        self.early = None
        self.entry_hooks = []
        self.settings_factories = None

    def on_plugin_load(self):
        self.on_plugin_unload()
        self.failure = None
        self.dex = Dex()
        try:

            stored = self.export_settings()
            migration = {key[8:]: str(value) for key, value in stored.items()
                         if key.startswith("account_") and key[8:].isdigit() and value}
            self.early = EarlyPrivacy(self)
            self.early.install(stored)
            self._install_entry_hooks()
            entry = self._entry_point()
            self._sync_chat_menu(entry)
            self.dex.load(json.dumps(migration, separators=(",", ":")), self.early.state, entry)
            self.early.close(handoff=True)
        except Exception as exc:
            self.failure = str(exc)
            self.log("Hidden Folder DEX / load: " + self.failure)
            if self.dex is not None:
                try:
                    self.dex.unload()
                except Exception as cleanup:
                    self.log("Hidden Folder DEX / cleanup: " + str(cleanup))

    def on_plugin_unload(self):
        for handle in self.entry_hooks:
            try:
                self.unhook_method(handle)
            except Exception as exc:
                self.log("Hidden Folder / entry unhook: " + str(exc))
        self.entry_hooks.clear()
        if self.menu_added:
            try:
                self.remove_menu_item("hidden_folder_chat")
            except Exception as exc:
                self.log("Hidden Folder DEX / menu cleanup: " + str(exc))
        self.menu_added = False
        handed = self.dex is not None and self.dex.loaded
        if self.dex is not None:
            try:
                self.dex.unload()
            except Exception as exc:
                self.log("Hidden Folder DEX / unload: " + str(exc))
        self.dex = None
        if self.early is not None:
            self.early.close(handoff=handed)
        self.early = None
        self.settings_factories = None

    def _entry_point(self):
        try:
            value = int(self.get_setting("entry_point", 0))
            return value if value in (0, 1, 2) else 0
        except (TypeError, ValueError):
            return 0

    def _sync_chat_menu(self, entry):
        if self.menu_added:
            self.remove_menu_item("hidden_folder_chat")
            self.menu_added = False
        if entry == 1:
            self.add_menu_item(MenuItemData(menu_type=MenuItemType.CHAT_ACTION_MENU,
                text=_tr("Скрытая папка", "Hidden Folder"), icon="msg_folders", item_id="hidden_folder_chat",
                priority=2147483647, on_click=self._chat_menu))
            self.menu_added = True

    def _install_entry_hooks(self):
        from hook_utils import find_class
        handles = self.hook_all_methods(find_class("org.telegram.ui.SettingsActivity"), "onLongClick",
            priority=2147483647, before=self._settings_long_press)
        if not handles:
            raise RuntimeError(_tr("Нет обработчика настроек чатов", "Chat settings handler unavailable"))
        self.entry_hooks.extend(handles)

    def _settings_long_press(self, param):
        try:
            if self._entry_point() == 2 and len(param.args) == 5 and int(param.args[0].id) == 2:
                param.setResult(True)
                self._call("openEntry", param.thisObject)
        except Exception as exc:
            self.log("Hidden Folder / settings entry: " + str(exc))

    def _set_entry_point(self, value):
        try:
            entry = int(value)
            if entry not in (0, 1, 2):
                return
            self.set_setting("entry_point", entry)
            self._sync_chat_menu(entry)
            self._call("setEntryPoint", str(entry))
        except Exception as exc:
            self.log("Hidden Folder / entry preference: " + str(exc))

    def create_settings(self):
        from ui.settings import SimpleSettingFactory
        if self.settings_factories is None:
            def factory(kind):
                def create(context, list_view, account, class_guid, resources_provider):
                    from client_utils import get_last_fragment
                    return self._call("settingsRow", context, str(kind), list_view, get_last_fragment())
                def bind(view, item, divider, adapter, list_view):
                    from client_utils import get_last_fragment
                    self._call("bindSettingsRow", view, str(kind), list_view, get_last_fragment())
                def click(plugin, item, view):
                    if kind >= 0:
                        self._set_entry_point(kind)
                return SimpleSettingFactory(create, bind, is_clickable=kind >= 0,
                    is_shadow=True, on_click=click)
            self.settings_factories = [factory(kind) for kind in (-1, 0, 1, 2)]
        return [factory() for factory in self.settings_factories]

    def _call(self, method, *args):
        try:
            if self.dex is None or not self.dex.loaded:
                raise RuntimeError(self.failure or _tr("DEX не загружен", "DEX is not loaded"))
            return self.dex.call(method, *args)
        except Exception as exc:
            self.log("Hidden Folder DEX / " + method + ": " + str(exc))
            self._alert(_tr("Скрытая папка", "Hidden Folder"), str(exc))

    def _chat_menu(self, context):
        try:
            from client_utils import get_last_fragment
            host = context.get("fragment") or get_last_fragment()
            if self._entry_point() == 1 and host is not None:
                self._call("openEntry", host)
        except Exception as exc:
            self.log("Hidden Folder DEX / chat menu: " + str(exc))

    def _alert(self, title, message):
        try:
            from client_utils import get_last_fragment
            from ui.alert import AlertDialogBuilder
            host = get_last_fragment()
            if host is not None and host.getParentActivity() is not None:
                AlertDialogBuilder(host.getParentActivity()).set_title(title).set_message(
                    message).set_positive_button(_tr("ОК", "OK")).show()
        except Exception as exc:
            self.log("Hidden Folder DEX / alert: " + str(exc))

_DEX_PAYLOAD = ""
