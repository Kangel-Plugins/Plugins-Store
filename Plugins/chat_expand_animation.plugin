__id__ = "chat_expand_animation"
__name__ = "Chat Expand Animation"
__description__ = "Заменяет анимацию открытия чата на увеличение из карточки диалога и обратное сворачивание"
__author__ = "@Vernyak6"
__version__ = "1.2"
__icon__ = "UtyaDuckFull/41"
__min_version__ = "11.12.0"

import collections
import os
import threading
import time
from typing import Any, List

from base_plugin import BasePlugin
from ui.settings import Divider, Header, Selector, Switch, Text

try:
    from android_utils import run_on_ui_thread
except Exception:
    from client_utils import run_on_ui_thread

LOCAL_DIR = "/storage/emulated/0/Android/media/com.exteragram.messenger"
DEX_NAME = "classesCEA.dex"
ENTRY_CLASS = "com.vernyak.chat_expand.CEA"
DEX_API = 1
EMBEDDED_B64 = ""

SOURCE_LABELS = {
    "local": "локальный файл",
    "embedded": "встроенный в плагин",
}

_LOG = collections.deque(maxlen=200)

def _i(x):
    return int(str(x))

def _valid(data):
    return (data is not None and len(data) >= 112 and data[:4] == b"dex\n"
            and 48 <= data[4] <= 57 and 48 <= data[5] <= 57 and 48 <= data[6] <= 57 and data[7] == 0)

def _ctx():
    from org.telegram.messenger import ApplicationLoader
    return ApplicationLoader.applicationContext

def _notify(text, error=False):
    def show():
        try:
            from ui.bulletin import BulletinHelper
            (BulletinHelper.show_error if error else BulletinHelper.show_info)(text)
        except Exception:
            try:
                from android.widget import Toast
                Toast.makeText(_ctx(), text, 1).show()
            except Exception:
                pass
    try:
        run_on_ui_thread(show)
    except Exception:
        show()

class ChatExpandPlugin(BasePlugin):
    _dex = None
    _error = None
    _lock = threading.RLock()

    def _log(self, msg):
        try:
            if not self.get_setting("debug_log", True):
                return
        except Exception:
            pass
        line = "%s %s" % (time.strftime("%H:%M:%S"), msg)
        _LOG.append(line)
        d = self._dex
        try:
            if d is not None:
                d["methods"][("log", 1)].invoke(None, "shell: " + str(msg))
            else:
                self.logger.info(msg)
        except Exception:
            pass

    def _local_candidates(self):
        paths = [os.path.join(LOCAL_DIR, DEX_NAME)]
        try:
            dirs = _ctx().getExternalMediaDirs()
            for d in (dirs or []):
                if d is not None:
                    p = os.path.join(str(d.getAbsolutePath()), DEX_NAME)
                    if p not in paths:
                        paths.append(p)
        except Exception:
            pass
        return paths

    def _read_local(self):
        for p in self._local_candidates():
            try:
                if os.path.isfile(p):
                    with open(p, "rb") as fh:
                        data = fh.read()
                    if _valid(data):
                        return data, p
                    self._log("локальный файл не является DEX: %s" % p)
            except Exception as e:
                self._log("не удалось прочитать %s: %s" % (p, e))
        return None, None

    def _read_embedded(self):
        if not EMBEDDED_B64:
            return None
        try:
            import base64
            data = base64.b64decode(EMBEDDED_B64)
            return data if _valid(data) else None
        except Exception:
            return None

    @staticmethod
    def _open(payload):
        from java.nio import ByteBuffer
        from dalvik.system import InMemoryDexClassLoader
        ctx = _ctx()
        loader = InMemoryDexClassLoader(ByteBuffer.wrap(payload), ctx.getClassLoader())
        try:
            cls = loader.loadClass(ENTRY_CLASS)
        except Exception:
            raise RuntimeError("в DEX нет класса CEA (файл старого формата?)")
        methods = {}
        for m in cls.getDeclaredMethods():
            m.setAccessible(True)
            methods[(str(m.getName()), len(m.getParameterTypes()))] = m
        for need in (("api", 0), ("version", 0), ("versionCode", 0), ("init", 2), ("load", 0), ("unload", 0),
                     ("log", 1), ("logText", 2), ("copyLog", 3), ("clearLog", 0)):
            if need not in methods:
                raise RuntimeError("в DEX нет метода %s/%d" % need)
        api = _i(methods[("api", 0)].invoke(None))
        if api != DEX_API:
            raise RuntimeError("DEX несовместим с оболочкой (api %d, нужен %d)" % (api, DEX_API))
        return {"loader": loader, "methods": methods,
                "version": str(methods[("version", 0)].invoke(None)),
                "code": _i(methods[("versionCode", 0)].invoke(None))}

    def _probe(self, payload):
        info = self._open(payload)
        return info["version"], info["code"]

    def _deactivate(self):
        d = self._dex
        self._dex = None
        if d is not None:
            try:
                d["methods"][("unload", 0)].invoke(None)
            except Exception as e:
                _LOG.append("unload failed: %s" % e)

    def _activate(self, payload, source, path=None):
        """Грузит DEX и ставит хуки. Вызывать из UI-потока."""
        with self._lock:
            self._deactivate()
            ctx = _ctx()
            try:
                info = self._open(payload)
                info["methods"][("init", 2)].invoke(None, ctx.getClassLoader(), __id__)
                hooks = _i(info["methods"][("load", 0)].invoke(None))
            except Exception as e:
                self._error = "DEX не загрузился: %s" % e
                self._log(self._error)
                return False
            info["source"] = source
            info["path"] = path
            self._dex = info
            self._error = None if hooks > 0 else "DEX загружен, но хуки не установлены (см. лог)"
            self._log("DEX %s (%d) загружен: %s, хуков: %d" % (info["version"], info["code"],
                                                                SOURCE_LABELS.get(source, source), hooks))
            return True

    def _activate_preferred(self):
        payload, path = self._read_local()
        if payload is not None:
            if self._activate(payload, "local", path):
                return True
            self._log("локальный DEX не загрузился; переключаюсь на встроенный")
        payload = self._read_embedded()
        if payload is None:
            self._deactivate()
            self._error = "Встроенный DEX отсутствует или повреждён"
            self._log(self._error)
            return False
        return self._activate(payload, "embedded")

    def _activate_ui(self, payload, source, path, done=None):
        def run():
            ok = self._activate(payload, source, path)
            if not ok and source == "local":
                embedded = self._read_embedded()
                if embedded is not None:
                    self._activate(embedded, "embedded")
            self._reload_ui()
            if done is not None:
                done(ok)
        run_on_ui_thread(run)

    def _reload_ui(self):
        def run():
            try:
                self.set_setting("_ui_rev", int(time.time() * 1000) % 2000000000, reload_settings=True)
            except Exception:
                pass
        try:
            run_on_ui_thread(run)
        except Exception:
            pass

    def _on_delete(self, view=None):
        def work():
            removed = []
            paths = list(self._local_candidates())
            try:
                files_dir = str(_ctx().getFilesDir().getAbsolutePath())
                legacy_path = os.path.join(files_dir, "chat_expand_animation", DEX_NAME)
                if legacy_path not in paths:
                    paths.append(legacy_path)
            except Exception:
                pass
            for path in paths:
                try:
                    if os.path.isfile(path):
                        os.remove(path)
                        removed.append(path)
                except Exception as e:
                    self._log("не удалось удалить %s: %s" % (path, e))

            def finish():
                ok = self._activate_preferred()
                self._reload_ui()
                d = self._dex
                if ok and d is not None and d["source"] == "embedded":
                    if removed:
                        _notify("Локальный DEX удалён; работает встроенный DEX")
                    else:
                        _notify("Локальный DEX не активен; работает встроенный DEX")
                elif ok:
                    _notify("Локальный DEX всё ещё активен; удалить его не удалось", error=True)
                else:
                    _notify("Не удалось загрузить встроенный DEX", error=True)
            run_on_ui_thread(finish)
        threading.Thread(target=work, daemon=True).start()

    def _on_local(self, view=None):
        def work():
            data, path = self._read_local()
            if data is None:
                def fallback():
                    ok = self._activate_preferred()
                    self._reload_ui()
                    if ok and self._dex is not None and self._dex["source"] == "embedded":
                        _notify("Локальный DEX не найден; работает встроенный DEX")
                    else:
                        _notify("Локальный и встроенный DEX не загрузились", error=True)
                run_on_ui_thread(fallback)
                return
            try:
                version, _ = self._probe(data)
            except Exception as e:
                error = str(e)
                self._log("локальный DEX не подходит: %s" % error)
                def fallback():
                    ok = self._activate_preferred()
                    self._reload_ui()
                    if ok and self._dex is not None and self._dex["source"] == "embedded":
                        _notify("Локальный DEX не подходит; работает встроенный DEX", error=True)
                    else:
                        _notify("Локальный DEX не подходит: %s" % error, error=True)
                run_on_ui_thread(fallback)
                return

            def done(ok):
                d = self._dex
                if ok and d is not None and d["source"] == "local":
                    _notify("Загружен локальный DEX %s" % version)
                elif d is not None and d["source"] == "embedded":
                    _notify("Локальный DEX не загрузился; работает встроенный DEX", error=True)
                else:
                    _notify("Локальный DEX не загрузился", error=True)
            self._activate_ui(data, "local", path, done)
        threading.Thread(target=work, daemon=True).start()

    def on_plugin_load(self):
        self._migrate_settings()
        self._error = None
        try:
            self._activate_preferred()
        except Exception as e:
            self._deactivate()
            self._error = "DEX не загрузился: %s" % e
            self._log(self._error)

    def on_plugin_unload(self):
        self._deactivate()

    def _shell_info(self):
        d = self._dex
        src = SOURCE_LABELS.get(d["source"], d["source"]) if d else "нет"
        return "shell %s | DEX source: %s%s | error: %s\n--- shell log ---\n%s" % (
            __version__, src, (" (%s)" % d["path"]) if d and d.get("path") else "", self._error,
            "\n".join(_LOG))

    def _copy_log(self, view=None):
        try:
            ctx = _ctx()
            settings = str(self.export_settings())
            d = self._dex
            count = -1
            if d is not None:
                count = _i(d["methods"][("copyLog", 3)].invoke(None, ctx, settings, self._shell_info()))
            else:
                from android.content import ClipData
                cm = ctx.getSystemService("clipboard")
                cm.setPrimaryClip(ClipData.newPlainText("chat_expand_animation log",
                                                        "DEX не загружен\nsettings: %s\n%s" % (settings, self._shell_info())))
                count = len(_LOG)
            if count >= 0:
                _notify("Лог скопирован (%d строк)" % count)
            else:
                _notify("Не удалось скопировать лог", error=True)
        except Exception as e:
            self._log("copy log failed: %s" % e)

    def _clear_log(self, view=None):
        _LOG.clear()
        d = self._dex
        if d is not None:
            try:
                d["methods"][("clearLog", 0)].invoke(None)
            except Exception:
                pass
        _notify("Лог очищен")

    def _migrate_settings(self):
        for new_key, old_key in (("stretch_chat_content_v3", "stretch_chat_content"),
                                 ("header_sprite_flight_v2", "header_sprite_flight")):
            try:
                if self.get_setting(new_key, None) is None:
                    previous = self.get_setting(old_key, None)
                    if previous is not None:
                        self.set_setting(new_key, bool(previous))
            except Exception as e:
                self._log("settings migration %s->%s failed: %s" % (old_key, new_key, e))
        try:
            mode = self.get_setting("stretch_mode", None)
            if mode is None:
                if bool(self.get_setting("stretch_source_card", False)):
                    mode = 1
                elif bool(self.get_setting("stretch_chat_content_v3", True)):
                    mode = 0
                else:
                    mode = 2
                self.set_setting("stretch_mode", mode)
            mode = max(0, min(2, int(mode)))
            self.set_setting("stretch_chat_content_v3", mode == 0)
            self.set_setting("stretch_source_card", mode == 1)
        except Exception as e:
            self._log("stretch mode migration failed: %s" % e)

    def _on_stretch_mode_change(self, new_value):
        try:
            mode = max(0, min(2, int(new_value)))
        except Exception:
            mode = 0
        self.set_setting("stretch_mode", mode)
        self.set_setting("stretch_chat_content_v3", mode == 0)
        self.set_setting("stretch_source_card", mode == 1)

    def _on_header_sprite_flight_change(self, new_value):
        self.set_setting("header_sprite_flight_v2", bool(new_value))

    def _show_dex_info(self, view=None):
        d = self._dex
        if d is None:
            _notify("DEX не загружен", error=True)
        else:
            _notify("DEX %s (%d), источник: %s" % (d["version"], d["code"], SOURCE_LABELS.get(d["source"], d["source"])))

    def _dex_rows(self):
        d = self._dex
        if d is not None:
            label = SOURCE_LABELS.get(d["source"], d["source"])
            if d.get("path"):
                label += " (%s)" % d["path"]
            head = "Версия DEX: %s (%d)" % (d["version"], d["code"])
            status = "Источник: %s." % label
            if d["source"] == "local":
                status += " Локальный файл имеет приоритет над встроенным DEX."
            else:
                status += " Используется DEX, встроенный в плагин."
            if self._error:
                status += " " + self._error
        else:
            head = "DEX не загружен"
            status = (
                (self._error or "Встроенный DEX не удалось загрузить.")
                + " Можно загрузить локальный файл %s/%s." % (LOCAL_DIR, DEX_NAME)
            )
        return [
            Header(text="DEX (логика анимации)"),
            Text(text=head, icon="msg_info", on_click=self._show_dex_info),
            Divider(text=status),
            Text(text="Загрузить локальный DEX", icon="msg_download", on_click=self._on_local),
            Text(text="Удалить локальный DEX и перейти на встроенный", icon="msg_delete", on_click=self._on_delete),
            Divider(text="Встроенный DEX находится в плагине. Локальный файл %s/%s имеет приоритет; его удаление возвращает встроенную версию." % (LOCAL_DIR, DEX_NAME)),
        ]

    def create_settings(self) -> List[Any]:
        return [
            Header(text="Анимация открытия чата"),
            Switch(key="enabled", text="Включить", default=True,
                   subtext="Чат раскрывается из своей карточки, как приложение из иконки"),
            Switch(key="animate_close", text="Анимировать закрытие", default=True,
                   subtext="Чат сворачивается обратно в карточку (кнопка назад / стрелка)"),
            Switch(key="parallel_close", text="Параллельная анимация", default=True,
                   subtext="Во время сворачивания можно сразу открыть другой чат"),
            Switch(key="header_sprite_flight_v2", text="Смещение аватарки, ника и последнего сообщения", default=True,
                   subtext="Смещает из карточки в их места в чате",
                   on_change=self._on_header_sprite_flight_change),
            Switch(key="depth", text="Эффект глубины", default=True,
                   subtext="Список диалогов слегка отдаляется и затемняется"),
            Switch(key="gradient_open", text="Затухание", default=True,
                   subtext="Чат проявляется из прозрачности при открытии и закрытии"),
            Selector(key="stretch_mode", text="Режим растягивания", default=0,
                     items=["Содержимое чата", "Форма карточки", "Без растягивания"],
                     on_change=self._on_stretch_mode_change),
            Divider(text="Что растягивается при открытии: содержимое чата (чат «сплющен» в карточку и вытягивается), только форма карточки или ничего."),
            Selector(key="open_mode", text="Анимация содержимого чата", default=0,
                     items=["Живой чат", "Снимок (легче)"]),
            Divider(text="Живой чат анимируется целиком (плавнее, но тяжелее для устройства). Снимок: чат снимается один раз и движется как картинка (легче)."),
            Selector(key="speed", text="Скорость", default=1, items=["Быстро", "Обычно", "Плавно"]),
            Divider(text="Длительность анимации открытия. Закрытие идёт чуть быстрее."),
            Selector(key="corner", text="Скругление карточки", default=1,
                     items=["Пилюля", "Скруглённая", "Прямоугольник"]),
            Divider(text="Форма карточки в начале открытия и в конце закрытия: пилюля, скруглённый прямоугольник или обычный прямоугольник."),
            Selector(key="inset", text="Отступ карточки от краёв", default=1, items=["Нет", "Небольшой", "Средний"]),
            Divider(text="Насколько карточка отступает от краёв ячейки диалога в начале открытия и в конце закрытия."),
        ] + self._dex_rows() + [
            Header(text="Отладка"),
            Switch(key="debug_log", text="Записывать лог", default=True,
                   subtext="Если выключено, журнал работы не ведётся"),
            Text(text="Скопировать лог", icon="msg_copy", on_click=self._copy_log),
            Text(text="Очистить лог", icon="msg_delete", on_click=self._clear_log),
            Divider(text="Журнал работы плагина помогает разобраться с ошибками анимации: нажмите «Скопировать лог» и отправьте его разработчику."),
        ]
