import math
import time

from base_plugin import BasePlugin, MethodHook
from hook_utils import find_class
from java import jclass
from ui.settings import Header, Switch, Selector, Divider

__id__ = "md3_loader"
__name__ = "MD3 Loader"
__description__ = "Заменяет стандартный круговой прогресс загрузки фото и файлов на Material 3 Expressive индикатор с волной. В центре — крестик отмены во время загрузки и значок загрузки до её начала."
__author__ = "@jettaxp & @jettax_plugins"
__version__ = "1.0.0"
__icon__ = "jettaxpluginsicon/0"
__min_version__ = "12.10.6"
__app_version__ = ">=12.10.6"
__category__ = ["appearance", "media"]

Paint = jclass("android.graphics.Paint")
PaintStyle = jclass("android.graphics.Paint$Style")
PaintCap = jclass("android.graphics.Paint$Cap")
PaintJoin = jclass("android.graphics.Paint$Join")
Path = jclass("android.graphics.Path")
Matrix = jclass("android.graphics.Matrix")
PathMeasure = jclass("android.graphics.PathMeasure")
RectF = jclass("android.graphics.RectF")
Rect = jclass("android.graphics.Rect")
AndroidUtilities = jclass("org.telegram.messenger.AndroidUtilities")
Integer = jclass("java.lang.Integer")
JSystem = jclass("java.lang.System")
JClass = jclass("java.lang.Class")


def java_class(name):
    loaders = []
    try:
        loaders.append(jclass("org.telegram.messenger.ApplicationLoader").applicationContext.getClassLoader())
    except Exception:
        pass
    try:
        loaders.append(AndroidUtilities.getClass().getClassLoader())
    except Exception:
        pass
    for loader in loaders:
        try:
            return JClass.forName(name, False, loader)
        except Exception:
            pass
    try:
        return JClass.forName(name)
    except Exception:
        pass
    c = find_class(name)
    if c is None:
        return None
    if hasattr(c, "getDeclaredField"):
        return c
    try:
        return c.getClass()
    except Exception:
        return None

MAD_CLASS = "org.telegram.ui.Components.MediaActionDrawable"
RP_CLASS = "org.telegram.ui.Components.RadialProgress2"

ICON_DOWNLOAD = 2
ICON_CANCEL = 3
ICON_NONE = 4
ICON_EMPTY = 10
ICON_CANCEL_FILL = 14

SUPPORTED = {ICON_DOWNLOAD, ICON_CANCEL, ICON_NONE, ICON_EMPTY, ICON_CANCEL_FILL}
RING_ICONS = {ICON_CANCEL, ICON_EMPTY, ICON_CANCEL_FILL}

AMPLITUDES = [0.6, 1.0, 1.5]
SPEEDS = [35.0, 70.0, 130.0]
THICKNESS = [(2.5, 1.5), (3.0, 2.0), (4.0, 2.5)]

EXTRA_KEY = "md3_loader_save"
RP_EXTRA_KEY = "md3_loader_rp_save"


def dp(v):
    return float(v) * float(AndroidUtilities.density)


class DrawHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        try:
            self.plugin.before_draw(param)
        except Exception as e:
            self.plugin.logger.exception(e)

    def after_hooked_method(self, param):
        try:
            self.plugin.after_draw(param)
        except Exception as e:
            self.plugin.logger.exception(e)


class RadialDrawHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        try:
            self.plugin.before_rp_draw(param)
        except Exception as e:
            self.plugin.logger.exception(e)

    def after_hooked_method(self, param):
        try:
            self.plugin.after_rp_draw(param)
        except Exception as e:
            self.plugin.logger.exception(e)


class Md3LoaderPlugin(BasePlugin):

    def on_plugin_load(self):
        self._cfg = {
            "enabled": self.get_setting("enabled", True),
            "wavy": self.get_setting("wavy", True),
            "amplitude": self.get_setting("amplitude", 1),
            "speed": self.get_setting("speed", 1),
            "thickness": self.get_setting("thickness", 1),
            "track": self.get_setting("track", True),
            "md3_download": self.get_setting("md3_download", True),
        }
        self._paths = {}
        self._in_rp = 0
        self._anim = {}
        self._rp = None
        self._save_stack = []
        self._empty_rect = Rect(0, 0, 0, 0)
        self._rect = RectF()
        self._seg = Path()
        self._mtx = Matrix()

        self._ring = Paint(Paint.ANTI_ALIAS_FLAG)
        self._ring.setStyle(PaintStyle.STROKE)
        self._ring.setStrokeCap(PaintCap.ROUND)
        self._ring.setStrokeJoin(PaintJoin.ROUND)

        self._icon = Paint(Paint.ANTI_ALIAS_FLAG)
        self._icon.setStyle(PaintStyle.STROKE)
        self._icon.setStrokeCap(PaintCap.ROUND)
        self._icon.setStrokeJoin(PaintJoin.ROUND)

        self._fill = Paint(Paint.ANTI_ALIAS_FLAG)
        self._fill.setStyle(PaintStyle.FILL)

        mad = java_class(MAD_CLASS)
        canvas_cls = java_class("android.graphics.Canvas")
        if mad is None or canvas_cls is None:
            self.logger.info("MediaActionDrawable not found, plugin disabled")
            return

        self._f = {}
        for name in ("currentIcon", "nextIcon", "transitionProgress", "animatingTransition",
                     "animatedDownloadProgress", "overrideAlpha", "isMini"):
            field = mad.getDeclaredField(name)
            field.setAccessible(True)
            self._f[name] = field

        draw = mad.getDeclaredMethod("draw", canvas_cls)
        draw.setAccessible(True)
        self.hook_method(draw, DrawHook(self))

        try:
            self._hook_radial(canvas_cls)
        except Exception as e:
            self._rp = None
            self.logger.exception(e)

    def _hook_radial(self, canvas_cls):
        rp = java_class(RP_CLASS)
        if rp is None:
            return
        fields = {}
        for name in ("mediaActionDrawable", "progressRect", "circlePaint", "circleRadius"):
            f = rp.getDeclaredField(name)
            f.setAccessible(True)
            fields[name] = f
        for name in ("drawBackground", "backgroundStroke", "iconScale", "drawMiniIcon",
                     "circleCrossfadeColorKey", "overlayImageView", "maxIconSize"):
            try:
                f = rp.getDeclaredField(name)
                f.setAccessible(True)
                fields[name] = f
            except Exception:
                pass
        self._rp = fields
        draw = rp.getDeclaredMethod("draw", canvas_cls)
        draw.setAccessible(True)
        self.hook_method(draw, RadialDrawHook(self))

    def _rp_opt(self, rp, name, kind, default):
        f = self._rp.get(name)
        if f is None:
            return default
        try:
            if kind == "bool":
                return f.getBoolean(rp)
            if kind == "int":
                return f.getInt(rp)
            if kind == "float":
                return f.getFloat(rp)
            return f.get(rp)
        except Exception:
            return default

    def before_rp_draw(self, param):
        if not self._cfg["enabled"] or self._rp is None:
            return
        rp = param.thisObject
        d = self._rp["mediaActionDrawable"].get(rp)
        if d is None:
            return
        cur, nxt, _, anim = self._state(d)
        if not self._should_handle(cur, nxt, anim):
            return
        if self._rp_opt(rp, "drawMiniIcon", "bool", False):
            return
        if self._rp_opt(rp, "circleCrossfadeColorKey", "int", -1) >= 0:
            return
        overlay = self._rp_opt(rp, "overlayImageView", "obj", None)
        if overlay is not None and overlay.hasBitmapImage():
            return
        canvas = param.args[0]
        count = canvas.save()
        canvas.clipRect(self._empty_rect)
        self._in_rp += 1
        try:
            param.setObjectExtra(RP_EXTRA_KEY, Integer.valueOf(count))
        except Exception:
            self._save_stack.append((JSystem.identityHashCode(rp), count))

    def after_rp_draw(self, param):
        rp = param.thisObject
        count = self._take_count(param, RP_EXTRA_KEY, rp)
        if count is None:
            return
        self._in_rp = max(0, self._in_rp - 1)
        canvas = param.args[0]
        canvas.restoreToCount(count)

        d = self._rp["mediaActionDrawable"].get(rp)
        rect = self._rp["progressRect"].get(rp)
        cx = float(rect.centerX())
        cy = float(rect.centerY())
        radius = float(self._rp["circleRadius"].getInt(rp))
        if self._rp_opt(rp, "drawBackground", "bool", True):
            if self._rp_opt(rp, "backgroundStroke", "float", 0.0) != 0:
                radius -= dp(3.5)
            canvas.drawCircle(cx, cy, radius, self._rp["circlePaint"].get(rp))

        scale = self._rp_opt(rp, "iconScale", "float", 1.0)
        if scale != 1.0:
            canvas.save()
            canvas.scale(float(scale), float(scale), cx, cy)
        self._render(d, canvas)
        if scale != 1.0:
            canvas.restore()

    def _take_count(self, param, key, obj):
        try:
            extra = param.getObjectExtra(key)
            if extra is None:
                return None
            return extra if isinstance(extra, int) else int(extra.intValue())
        except Exception:
            oid = JSystem.identityHashCode(obj)
            if self._save_stack and self._save_stack[-1][0] == oid:
                return self._save_stack.pop()[1]
        return None


    def _setter(self, key):
        def cb(value):
            self._cfg[key] = value
        return cb

    def create_settings(self):
        return [
            Header(text="MD3 Loader"),
            Switch(key="enabled", text="Включить", default=True,
                   subtext="MD3 индикатор вместо стандартного прогресса загрузки",
                   on_change=self._setter("enabled")),
            Switch(key="md3_download", text="MD3 значок загрузки", default=True,
                   subtext="Стрелка с полочкой до начала скачивания",
                   on_change=self._setter("md3_download")),
            Header(text="Кольцо"),
            Switch(key="wavy", text="Волна", default=True,
                   subtext="Волнистый индикатор (Material 3 Expressive)",
                   on_change=self._setter("wavy")),
            Selector(key="amplitude", text="Высота волны", default=1,
                     items=["Низкая", "Средняя", "Высокая"],
                     on_change=self._setter("amplitude")),
            Selector(key="speed", text="Скорость волны", default=1,
                     items=["Медленно", "Обычно", "Быстро"],
                     on_change=self._setter("speed")),
            Selector(key="thickness", text="Толщина", default=1,
                     items=["Тонкая", "Обычная", "Толстая"],
                     on_change=self._setter("thickness")),
            Switch(key="track", text="Показывать трек", default=True,
                   subtext="Полупрозрачная дорожка оставшейся части",
                   on_change=self._setter("track")),
            Divider(text="by @jettaxp & @jettax_plugins"),
        ]


    def _state(self, d):
        f = self._f
        return (
            f["currentIcon"].getInt(d),
            f["nextIcon"].getInt(d),
            f["transitionProgress"].getFloat(d),
            f["animatingTransition"].getBoolean(d),
        )

    def _should_handle(self, cur, nxt, anim):
        icons = {cur, nxt} if anim else {nxt}
        if not icons <= SUPPORTED:
            return False
        if icons & RING_ICONS:
            return True
        if ICON_DOWNLOAD in icons:
            return anim or bool(self._cfg["md3_download"])
        return False


    def before_draw(self, param):
        if not self._cfg["enabled"] or self._in_rp > 0:
            return
        d = param.thisObject
        cur, nxt, _, anim = self._state(d)
        if not self._should_handle(cur, nxt, anim):
            return
        canvas = param.args[0]
        count = canvas.save()
        canvas.clipRect(self._empty_rect)
        try:
            param.setObjectExtra(EXTRA_KEY, Integer.valueOf(count))
        except Exception:
            self._save_stack.append((JSystem.identityHashCode(d), count))

    def after_draw(self, param):
        count = self._take_count(param, EXTRA_KEY, param.thisObject)
        if count is None:
            return
        canvas = param.args[0]
        canvas.restoreToCount(count)
        self._render(param.thisObject, canvas)


    def _wave_path(self, radius, amp, waves):
        key = (int(radius * 4), int(amp * 20), waves)
        cached = self._paths.get(key)
        if cached is not None:
            return cached
        if len(self._paths) > 24:
            self._paths.clear()
        path = Path()
        steps = waves * 16
        total = steps * 2
        for i in range(total + 1):
            th = 2.0 * math.pi * i / steps
            r = radius + amp * math.sin(waves * th)
            x = r * math.cos(th)
            y = r * math.sin(th)
            if i == 0:
                path.moveTo(float(x), float(y))
            else:
                path.lineTo(float(x), float(y))
        pm = PathMeasure(path, False)
        cached = (pm, float(pm.getLength()) / 2.0)
        self._paths[key] = cached
        return cached

    def _draw_arc(self, canvas, cx, cy, radius, start, sweep, amp, phase):
        if sweep <= 0.0:
            return
        if amp < 0.05 or not self._cfg["wavy"]:
            self._rect.set(cx - radius, cy - radius, cx + radius, cy + radius)
            canvas.drawArc(self._rect, float(start), float(sweep), False, self._ring)
            return
        waves = max(5, int(round(2.0 * math.pi * radius / dp(11))))
        period = 360.0 / waves
        pm, turn_len = self._wave_path(radius, amp, waves)
        rho = start - ((start - phase) % period)
        alpha = start - rho
        self._seg.rewind()
        pm.getSegment(float(alpha / 360.0 * turn_len),
                      float((alpha + sweep) / 360.0 * turn_len), self._seg, True)
        self._mtx.setRotate(float(rho))
        self._mtx.postTranslate(float(cx), float(cy))
        self._seg.transform(self._mtx)
        canvas.drawPath(self._seg, self._ring)

    def _render(self, d, canvas):
        f = self._f
        cur, nxt, t, anim = self._state(d)
        progress = f["animatedDownloadProgress"].getFloat(d)
        override_alpha = f["overrideAlpha"].getFloat(d)
        mini = f["isMini"].getBoolean(d)

        weights = {}
        if anim:
            weights[cur] = weights.get(cur, 0.0) + (1.0 - t)
            weights[nxt] = weights.get(nxt, 0.0) + t
        else:
            weights[nxt] = 1.0
        ring_w = sum(weights.get(i, 0.0) for i in RING_ICONS)
        cross_w = weights.get(ICON_CANCEL, 0.0)
        stop_w = weights.get(ICON_CANCEL_FILL, 0.0)
        dl_w = weights.get(ICON_DOWNLOAD, 0.0)

        src = d.paint
        for p in (self._ring, self._icon):
            p.set(src)
            p.setStyle(PaintStyle.STROKE)
            p.setStrokeCap(PaintCap.ROUND)
            p.setStrokeJoin(PaintJoin.ROUND)
        self._fill.set(src)
        self._fill.setStyle(PaintStyle.FILL)

        b = d.getBounds()
        cx = float(b.exactCenterX())
        cy = float(b.exactCenterY())
        size = float(min(b.width(), b.height()))
        if size <= 0:
            return

        th = THICKNESS[self._cfg["thickness"] if 0 <= self._cfg["thickness"] < 3 else 1]
        stroke = dp(th[1] if mini else th[0])
        self._ring.setStrokeWidth(stroke)
        self._icon.setStrokeWidth(stroke if not mini else max(stroke, dp(2)))

        now = time.monotonic()

        if ring_w > 0.001:
            a = int(255 * override_alpha * min(1.0, ring_w))
            inset = dp(2 if mini else 4) + stroke / 2.0
            radius = size / 2.0 - inset
            amp_level = self._cfg["amplitude"] if 0 <= self._cfg["amplitude"] < 3 else 1
            amp = dp(AMPLITUDES[amp_level]) * (0.6 if mini else 1.0)
            amp = min(amp, stroke * 0.9 + dp(0.3))
            speed = SPEEDS[self._cfg["speed"] if 0 <= self._cfg["speed"] < 3 else 1]
            phase = (now * speed) % 360.0

            canvas.save()
            sc = 0.85 + 0.15 * min(1.0, ring_w)
            canvas.scale(float(sc), float(sc), cx, cy)

            indeterminate = progress < 0.01
            if indeterminate:
                rot = (now * 300.0) % 360.0
                t_start = rot - 90.0
                t_sweep = 30.0 + 230.0 * (0.5 - 0.5 * math.cos(2.0 * math.pi * now / 1.6))
                p = 0.0
            else:
                p = min(1.0, progress)
                t_start = -90.0
                t_sweep = max(3.0, 360.0 * p)
            t_det = 0.0 if indeterminate else 1.0

            key = JSystem.identityHashCode(d)
            st = self._anim.get(key)
            if st is None or now - st[3] > 0.4:
                st = [t_start, t_sweep, t_det, now]
            else:
                dt = max(0.0, min(0.1, now - st[3]))
                k = 1.0 - math.exp(-dt * 9.0)
                delta = (t_start - st[0]) % 360.0
                if delta < 0.05 or delta > 359.95:
                    st[0] = t_start
                else:
                    st[0] = st[0] + delta * k
                st[1] += (t_sweep - st[1]) * k
                st[2] += (t_det - st[2]) * k
                st[3] = now
            self._anim[key] = st
            if len(self._anim) > 64:
                for kk in [kk for kk, v in self._anim.items() if now - v[3] > 2.0]:
                    del self._anim[kk]

            start = st[0]
            sweep = max(3.0, st[1])
            det_w = max(0.0, min(1.0, st[2]))
            flat = min(1.0, (1.0 - p) / 0.06) if not indeterminate else 1.0
            flat = round(flat * 4.0) / 4.0

            if self._cfg["track"] and det_w > 0.01:
                gap = math.degrees((stroke + dp(4)) / max(radius, 1.0))
                track_start = start + sweep + gap
                track_sweep = 360.0 - sweep - 2.0 * gap
                if track_sweep > 0.5:
                    self._ring.setAlpha(int(a * 0.28 * det_w))
                    self._rect.set(cx - radius, cy - radius, cx + radius, cy + radius)
                    canvas.drawArc(self._rect, float(track_start), float(track_sweep), False, self._ring)
            self._ring.setAlpha(a)
            self._draw_arc(canvas, cx, cy, radius, start, sweep, amp * flat, phase + start + 90.0)
            canvas.restore()

        if cross_w > 0.001:
            self._icon.setAlpha(int(255 * override_alpha * min(1.0, cross_w)))
            half = size * (0.17 if mini else 0.15)
            canvas.save()
            canvas.rotate(float(-90.0 * (1.0 - cross_w)), cx, cy)
            s = 0.5 + 0.5 * cross_w
            canvas.scale(float(s), float(s), cx, cy)
            canvas.drawLine(cx - half, cy - half, cx + half, cy + half, self._icon)
            canvas.drawLine(cx + half, cy - half, cx - half, cy + half, self._icon)
            canvas.restore()

        if stop_w > 0.001:
            self._fill.setAlpha(int(255 * override_alpha * min(1.0, stop_w)))
            half = size * 0.11 * (0.5 + 0.5 * stop_w)
            self._rect.set(cx - half, cy - half, cx + half, cy + half)
            canvas.drawRoundRect(self._rect, dp(2), dp(2), self._fill)

        if dl_w > 0.001:
            self._icon.setAlpha(int(255 * override_alpha * min(1.0, dl_w)))
            canvas.save()
            s = 0.6 + 0.4 * dl_w
            canvas.scale(float(s), float(s), cx, cy)
            canvas.translate(0.0, float(-size * 0.08 * (1.0 - dl_w)))
            if self._cfg["md3_download"]:
                top = cy - size * 0.21
                tip = cy + size * 0.09
                arm = size * 0.14
                canvas.drawLine(cx, top, cx, tip, self._icon)
                canvas.drawLine(cx - arm, tip - arm, cx, tip, self._icon)
                canvas.drawLine(cx + arm, tip - arm, cx, tip, self._icon)
                base_y = cy + size * 0.22
                bw = size * 0.18
                canvas.drawLine(cx - bw, base_y, cx + bw, base_y, self._icon)
            else:
                top = cy - size * 0.2
                tip = cy + size * 0.2
                arm = size * 0.18
                canvas.drawLine(cx, top, cx, tip, self._icon)
                canvas.drawLine(cx - arm, tip - arm, cx, tip, self._icon)
                canvas.drawLine(cx + arm, tip - arm, cx, tip, self._icon)
            canvas.restore()

