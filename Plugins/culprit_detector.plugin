def _b18_uninstall():
    try:
        with _B18_LOCK:
            items = list(_B18_PATCHED); del _B18_PATCHED[:]
        for tup in items:
            try:
                cls, nm, orig = tup[0], tup[1], tup[2]
                our_w = tup[3] if len(tup) > 3 else None
                cur = getattr(cls, nm, None)
                if cur is not None and (cur is our_w if our_w is not None else getattr(cur, _B18_FLAG, False)):
                    setattr(cls, nm, orig)
            except Exception: pass
    except Exception: pass

_PYERR_FILE_NAME = "pyerr_verdict.json"
_PYERR_FAILS_MAX = 20
_PYERR_DEDUP_MS = 4000
_PYERR_SEEN = {}; _PYERR_SEEN_LOCK = threading.Lock()
_B19_LAST_TID = {}
_B19_ECHO_MS = 2000
_BLOCK19_ON = True
_B19_OK = False
_B19_STARTED = False
_B19_IDLE_S = 30.0
_B19_STOP = None
_B19_THREAD = None
_B19_SYM = {1: "callThrowsNative", 2: "callAttrThrowsNative", 3: "PyInvocationHandler.invokeNative"}
_B19Event = None
_B19_RING_ADDR = 0
_B19_RING_CAP = 0
_B19_EVBUF = None
_B19_EVADDR = 0
_B19_REC_SIZE = 0
_B19_MAX_FRAMES = 0
_B19_PATH_MAX = 0
_B19_NEXT = 0

def _pyerr_verdict_path():
    return _data_path(_PYERR_FILE_NAME)

def _b19_build_struct(maxf, pathmax):
    c = ctypes
    class B19Event(c.Structure):
        _fields_ = [("tid", c.c_int64),
                    ("ts_ms", c.c_int64),
                    ("symbol", c.c_int32),
                    ("nframes", c.c_int32),
                    ("lines", c.c_int32 * maxf),
                    ("files", (c.c_char * pathmax) * maxf)]
    return B19Event

def _b19_init(lib):
    global _B19_OK, _B19Event, _B19_RING_CAP, _B19_REC_SIZE, _B19_MAX_FRAMES, _B19_PATH_MAX, _B19_EVBUF, _B19_EVADDR
    c = ctypes
    needed = ("cd_b19_start", "cd_b19_stop", "cd_b19_ring_addr", "cd_b19_ring_cap",
              "cd_b19_rec_size", "cd_b19_max_frames", "cd_b19_path_max",
              "cd_b19_committed", "cd_b19_running", "cd_b19_read_event")
    if not all(hasattr(lib, n) for n in needed):
        _B19_OK = False
        _log("Block#19: cd_b19_* нет в .so (старый бинарь) — JNI-py-атрибуция отключена")
        return False
    try:
        lib.cd_b19_start.restype = c.c_int
        lib.cd_b19_stop.restype = c.c_int
        lib.cd_b19_ring_addr.restype = c.c_uint64
        lib.cd_b19_ring_cap.restype = c.c_int32
        lib.cd_b19_rec_size.restype = c.c_int32
        lib.cd_b19_max_frames.restype = c.c_int32
        lib.cd_b19_path_max.restype = c.c_int32
        lib.cd_b19_committed.restype = c.c_int64
        lib.cd_b19_running.restype = c.c_int
        lib.cd_b19_read_event.restype = c.c_int
        lib.cd_b19_read_event.argtypes = [c.c_int64, c.c_void_p]
        lib.cd_b19_eventfd.restype = c.c_int
        lib.cd_b19_event_wake.restype = c.c_int
        for opt in ("cd_b19_boundary_hits", "cd_b19_tb_captures", "cd_b19_dropped"):
            try: getattr(lib, opt).restype = c.c_int64
            except Exception: pass
        _B19_MAX_FRAMES = int(lib.cd_b19_max_frames())
        _B19_PATH_MAX = int(lib.cd_b19_path_max())
        _B19_REC_SIZE = int(lib.cd_b19_rec_size())
        _B19_RING_CAP = int(lib.cd_b19_ring_cap())
        if _B19_MAX_FRAMES <= 0 or _B19_PATH_MAX <= 0 or _B19_RING_CAP <= 0:
            _B19_OK = False
            _log("Block#19: невалидные размеры от натива — отключаю")
            return False
        _B19Event = _b19_build_struct(_B19_MAX_FRAMES, _B19_PATH_MAX)
        if c.sizeof(_B19Event) != _B19_REC_SIZE:
            _B19_OK = False
            _log("Block#19: размер записи не совпал (py=%d native=%d) — отключаю" % (c.sizeof(_B19Event), _B19_REC_SIZE))
            return False
        _B19_EVBUF = _B19Event()
        _B19_EVADDR = c.addressof(_B19_EVBUF)
        _B19_OK = True
        _log("Block#19: cd_b19_* ок (cap=%d rec=%dB maxf=%d path=%d)" % (_B19_RING_CAP, _B19_REC_SIZE, _B19_MAX_FRAMES, _B19_PATH_MAX))
        return True
    except Exception as e:
        _B19_OK = False
        _log("Block#19 init err: %s: %s" % (type(e).__name__, e))
        return False

def _b19_cstr(arr):
    try:
        return bytes(arr).split(b"\x00", 1)[0].decode("utf-8", "replace")
    except Exception:
        return ""

def _b19_file_plugin_map():
    m = {}
    try:
        for mod in list(_sys.modules.values()):
            try:
                pid = getattr(mod, "__id__", None)
                fn = getattr(mod, "__file__", None)
                if not (isinstance(pid, str) and pid and isinstance(fn, str) and fn):
                    continue
                if pid == _SELF_ID or pid == __id__:
                    continue
                try: pid = _canon_pid(pid)
                except Exception: pass
                m[fn] = pid
                try: m[os.path.abspath(fn)] = pid
                except Exception: pass
                try: m[os.path.basename(fn)] = pid
                except Exception: pass
            except Exception: pass
    except Exception as e:
        try: _log("Block#19: file->plugin map build err: %s: %s" % (type(e).__name__, e))
        except Exception: pass
    try:
        d = None
        try: d = _b11p_plugins_dir()
        except Exception: d = None
        ids = set()
        try:
            with _REG_LOCK:
                for pid, r in _REGISTRY.items():
                    if r and r.get("inst"): ids.add(pid)
        except Exception: pass
        try: ids |= _installed_plugin_ids_fs()
        except Exception: pass
        added = 0
        for pid in ids:
            if not pid or pid == _SELF_ID or pid == __id__: continue
            try: pid_c = _canon_pid(pid)
            except Exception: pid_c = pid
            bn = "%s.py" % pid
            if bn not in m:
                m[bn] = pid_c; added += 1
            if d:
                fp = os.path.join(d, bn)
                if fp not in m:
                    m[fp] = pid_c; added += 1
                try:
                    ap = os.path.abspath(fp)
                    if ap not in m:
                        m[ap] = pid_c; added += 1
                except Exception: pass
        if added and not _B19_FSMAP_LOG_ONCE[0]:
            _B19_FSMAP_LOG_ONCE[0] = True
            _log("Block#19: file->plugin map дополнена FS/реестровым фолбэком (+%d ключей)" % added)
    except Exception: pass
    if not m:
        try: _log("Block#19: file->plugin map ПУСТА -- атрибуция Python-ошибок уйдёт в untagged")
        except Exception: pass
    return m

def _b19_culprit_from_event(ev, fmap):
    n = int(ev.nframes)
    if n > _B19_MAX_FRAMES: n = _B19_MAX_FRAMES
    deepest_file = None; deepest_line = -1
    if n > 0:
        deepest_file = _b19_cstr(ev.files[n - 1]); deepest_line = int(ev.lines[n - 1])
    pid = None; pfile = None; pline = -1
    for i in range(n - 1, -1, -1):
        f = _b19_cstr(ev.files[i])
        cand = fmap.get(f)
        if cand is None:
            try: cand = fmap.get(os.path.basename(f))
            except Exception: cand = None
        if isinstance(cand, str) and cand:
            pid = cand; pfile = f; pline = int(ev.lines[i]); break
    return pid, pfile, pline, deepest_file, deepest_line

def _pyerr_verdict_log(rec, when):
    try:
        _log("============= JNI PY-EXC VERDICT (%s) =============" % when)
        cul = rec.get("culprit"); conf = rec.get("confidence")
        if cul and cul != "unknown":
            _log("ВИНОВНИК PY-JNI: %r conf=%s where=%s src=%s" % (cul, conf, rec.get("where"), rec.get("src")))
        else:
            _log("ВИНОВНИК PY-JNI: неизвестен (symbol=%s)" % rec.get("symbol"))
        _log("  причина: %s" % rec.get("reason"))
        pf = rec.get("py_file")
        if pf: _log("  modul: %s:%s" % (pf, rec.get("py_line")))
        df = rec.get("deepest_file")
        if df: _log("  deepest: %s:%s" % (df, rec.get("deepest_line")))
        _log("  granica: %s" % rec.get("symbol"))
        _log("===================================================")
    except Exception: pass

def _persist_pyerr_fail(rec):
    _persist_append(_pyerr_verdict_path(), rec, _PYERR_FAILS_MAX, "Block#19 pyerrpersist")

def _read_and_clear_pyerr_fails():
    return _read_and_clear_json_list(_pyerr_verdict_path())

_B19_DIAG_TS = {}
def _b19_diag(key, msg):
    try:
        now = int(time.time() * 1000)
        if now - _B19_DIAG_TS.get(key, 0) < 5000: return
        if len(_B19_DIAG_TS) > 256: _B19_DIAG_TS.clear()
        _B19_DIAG_TS[key] = now
        _log(msg)
    except Exception: pass
def _b19_record(ev, fmap):
    if not _BLOCK19_ON: return
    pid, pfile, pline, dfile, dline = _b19_culprit_from_event(ev, fmap)
    sym = _B19_SYM.get(int(ev.symbol), "?")
    if not pid:
        try:
            _df0 = str(dfile or "")
            if "/plugins/" in _df0:
                _b19_diag("nopid|" + _df0, "Block#19 +SF: событие без плагина в file-map (deepest=%s:%s sym=%s map=%d) -> пропуск" % (_df0, dline, sym, len(fmap)))
        except Exception: pass
        return
    if pid == _SELF_ID or pid == __id__: return
    try:
        _hl = _HOOK_LIVE_LINES.get((pid, str(pline)))
        if _hl is not None and 0 <= int(time.time() * 1000) - _hl <= _HOOK_ECHO_MS:
            _b19_diag("echo|%s|%s" % (pid, pline), "Block#19 +SE: echo hook/cb-вердикта '%s' (%s:%s) -> не вердикт" % (pid, pfile, pline))
            return
    except Exception: pass
    try:
        _etid = int(ev.tid); _ets = int(ev.ts_ms)
        _prev = _B19_LAST_TID.get(_etid)
        _df = str(dfile or "")
        if _prev and _prev[1] != pid and 0 <= _ets - _prev[0] <= _B19_ECHO_MS and (_df.endswith(".pxi") or _df.endswith(".pyx")):
            _log("Block#19 +SB: nested echo -- '%s' получил исключение '%s' через Java-вызов (tid=%d dt=%dms deepest=%s:%s) -> не вердикт" % (pid, _prev[1], _etid, _ets - _prev[0], _df, dline))
            return
        _B19_LAST_TID[_etid] = (_ets, pid)
        if len(_B19_LAST_TID) > 256: _B19_LAST_TID.clear()
    except Exception: pass
    reason = "py-exception across JNI boundary (%s)" % sym
    now = int(time.time() * 1000)
    _rate_pm, _rate_n = _exc_rate_record(pid)
    rec = {"had_pyerr_fail": True, "event_type": "python_exception", "dropbox_tag": "data_app_crash", "tombstone_norm_version": 1, "culprit": pid, "src": "py-frame/jni-boundary",
           "confidence": "high", "where": "jni-boundary", "symbol": sym,
           "py_module": pid, "py_file": pfile, "py_line": pline,
           "deepest_file": dfile, "deepest_line": dline, "reason": reason,
           "exc_cls": None, "exc_msg": None,
           "throws_per_min": _rate_pm, "throws_in_window": _rate_n,
           "high_rate": bool(_rate_pm >= _EXC_RATE_HOT), "ts": now}
    key = "%s|%s|%s" % (pid, pline, sym)
    try:
        with _PYERR_SEEN_LOCK:
            if now - _PYERR_SEEN.get(key, 0) < _PYERR_DEDUP_MS:
                _exc_rate_refresh_note("pyerr", _PYERR_SEEN[key], rec)
                _b19_diag("dedup|" + key, "Block#19 +SF: дедуп %dms '%s' (%s:%s) -> пропуск" % (_PYERR_DEDUP_MS, pid, pfile, pline))
                return
            _PYERR_SEEN[key] = now
    except Exception: pass
    try: _b16_push_verdict("pyerr", rec)
    except Exception: pass
    try: _pyerr_verdict_log(rec, "live")
    except Exception: pass
    try: _persist_pyerr_fail(rec)
    except Exception: pass

_CD_COMPACT_TS = 0
_CD_COMPACT_MIN_S = 300
_CD_COMPACT_TOMB_HI = 200000
def _b19_poll_loop(stop):
    global _B19_NEXT, _CD_COMPACT_TS
    if not (_B19_OK and _NLIB is not None and _B19Event is not None and _B19_RING_ADDR):
        return
    cap = _B19_RING_CAP
    fmap = {}; fmap_ts = 0
    evfd = -1
    try:
        evfd = int(_NLIB.cd_b19_eventfd())
    except Exception: evfd = -1
    try:
        _log("Block#19: режим СОБЫТИЙНЫЙ (eventfd=%d, select idle=%.0fs)" % (evfd, _B19_IDLE_S))
    except Exception: pass
    _b19_ack_ok = False
    try:
        if hasattr(_NLIB, "cd_b19_acked") and hasattr(_NLIB, "cd_b19_ack"):
            _NLIB.cd_b19_acked.restype = ctypes.c_int64
            _NLIB.cd_b19_ack.argtypes = [ctypes.c_int64]; _NLIB.cd_b19_ack.restype = None
            _b19_ack_ok = True
            _a = int(_NLIB.cd_b19_acked())
            if _a > _B19_NEXT:
                _log("Block#19 +SF: курсор кольца из .so: %d (reload -- уже обработанные события не повторяются)" % _a)
                _B19_NEXT = _a
    except Exception: pass
    while not stop.is_set():
        try:
            committed = int(_NLIB.cd_b19_committed())
            if committed > _B19_NEXT:
                now = int(time.time() * 1000)
                if (now - fmap_ts) > 1500 or not fmap:
                    fmap = _b19_file_plugin_map(); fmap_ts = now
                start = _B19_NEXT
                if committed - start > cap:
                    start = committed - cap
                for seq in range(start, committed):
                    try:
                        if int(_NLIB.cd_b19_read_event(seq, _B19_EVADDR)) == 1:
                            _b19_record(_B19_EVBUF, fmap)
                    except Exception: pass
                _B19_NEXT = committed
                if _b19_ack_ok:
                    try: _NLIB.cd_b19_ack(ctypes.c_int64(committed))
                    except Exception: pass
        except Exception: pass
        try:
            _nl = _NLIB
            if _nl is not None and hasattr(_nl, "cd_compact") and hasattr(_nl, "cd_tomb_count"):
                _now2 = int(time.time())
                if _now2 - _CD_COMPACT_TS >= _CD_COMPACT_MIN_S and int(_nl.cd_tomb_count()) >= _CD_COMPACT_TOMB_HI:
                    _moved = int(_nl.cd_compact())
                    _CD_COMPACT_TS = _now2
                    _log(f"FIX#15 compact: moved={_moved} (tomb>={_CD_COMPACT_TOMB_HI})")
        except Exception: pass
        try:
            if select.select([evfd], [], [], _B19_IDLE_S)[0]:
                try: os.read(evfd, 8)
                except Exception: pass
        except Exception:
            stop.wait(_B19_IDLE_S)

def _b19_start():
    global _B19_STARTED, _B19_STOP, _B19_THREAD, _B19_RING_ADDR
    if not _BLOCK19_ON:
        _log("Block#19: отключён (_BLOCK19_ON=False)"); return
    if not (_B19_OK and _NATIVE_OK and _NLIB is not None):
        _log("Block#19: натив/символы недоступны -- пропуск"); return
    if _B19_STARTED: return
    try:
        hooks = int(_NLIB.cd_b19_start())
    except Exception as e:
        _log("Block#19 cd_b19_start err: %s" % e); return
    if hooks <= 0:
        _log("Block#19: cd_b19_start вернул %d хуков -- JNI/py граница не зацепилась" % hooks); return
    try: _B19_RING_ADDR = int(_NLIB.cd_b19_ring_addr())
    except Exception: _B19_RING_ADDR = 0
    if not _B19_RING_ADDR:
        _log("Block#19: ring_addr=0 -- отключаю")
        try: _NLIB.cd_b19_stop()
        except Exception: pass
        return
    _B19_STOP = threading.Event()
    _B19_THREAD = threading.Thread(target=_b19_poll_loop, args=(_B19_STOP,), name="culprit-b19", daemon=True)
    _B19_THREAD.start()
    _B19_STARTED = True
    _b19_tot = 3; _b19_inv = ""
    try:
        if hasattr(_NLIB, "cd_b19_hook_total"): _b19_tot = int(_NLIB.cd_b19_hook_total())
        if hasattr(_NLIB, "cd_b19_invoke_hooked"): _b19_inv = ", invokeNative=%d" % int(_NLIB.cd_b19_invoke_hooked())
    except Exception: pass
    _log("Block#19: установлен (хуков %d/%d%s, ring@0x%x cap=%d) -> %s" % (hooks, _b19_tot, _b19_inv, _B19_RING_ADDR, _B19_RING_CAP, _PYERR_FILE_NAME))

def _b19_stop():
    global _B19_STARTED
    if not _B19_STARTED: return
    try:
        if _B19_STOP is not None: _B19_STOP.set()
        try:
            if _NLIB is not None: _NLIB.cd_b19_event_wake()
        except Exception: pass
        if _B19_THREAD is not None: _B19_THREAD.join(timeout=2.0)
    except Exception: pass
    try:
        if _NLIB is not None: _NLIB.cd_b19_stop()
    except Exception: pass
    _B19_STARTED = False
    _log("Block#19: снят (cd_b19_stop)")


_BLOCK26_ON = True
_CXA_FILE_NAME = "cxa_throw.txt"
_CXA_UI_MAX = 20
_B26_OK = False
_B26_STARTED = False

def _cxa_path():
    return _data_path(_CXA_FILE_NAME)

def _kg_history_path():
    return _data_path(_KG_HISTORY_NAME)

def _md_hist_best(crash_ts):
    try:
        if crash_ts is None:
            return None
        ct = int(crash_ts)
        hp = _kg_history_path()
        if not (hp and os.path.exists(hp)):
            return None
        with open(hp, "r", encoding="utf-8") as f:
            hist = list(json.load(f))
    except Exception:
        return None
    best = None; best_d = None
    for it in hist:
        try:
            if not isinstance(it, dict) or it.get("event_type") != "selfkill_blocked":
                continue
            d = abs(int(it.get("ts")) - ct)
            if d <= _MD_VERDICT_FRESH_MS and (best_d is None or d < best_d):
                best = it; best_d = d
        except Exception:
            continue
    return best

_TA_SEGV_WINDOW_MS = 5000

def _ta_selfkill_aftermath(rec, where):
    try:
        sig = int(rec.get("signo") or 0)
    except Exception:
        return False
    if sig not in (4, 11) or rec.get("pid") is not None or rec.get("native_subtype") == "selfkill_aftermath":
        return False
    top = ((rec.get("top_so") or "").rsplit("/", 1)[-1] or "").lower()
    fso = ""
    fr = rec.get("frames") or []
    if fr and isinstance(fr[0], str) and ".so" in fr[0]:
        fso = fr[0].split("+", 1)[0].split(" ", 1)[0].rsplit("/", 1)[-1].lower()
    if not ((top in _MD_RT_SO) or (fso in _MD_RT_SO)):
        return False
    try:
        cts = int(rec.get("crash_ts") or rec.get("ts"))
    except Exception:
        return False
    win = _MD_VERDICT_FRESH_MS if sig == 4 else _TA_SEGV_WINDOW_MS
    cands = []
    try:
        vp = _kg_verdict_path()
        if not (vp and os.path.exists(vp)):
            try: _b30_read_sentinel("ta-correlate")
            except Exception: pass
            vp = _kg_verdict_path()
        if vp and os.path.exists(vp):
            with open(vp, "r", encoding="utf-8") as f:
                cands.append(json.load(f))
    except Exception:
        pass
    try:
        hb = _md_hist_best(cts)
        if hb is not None:
            cands.append(hb)
    except Exception:
        pass
    sk = None; best_d = None
    for c in cands:
        if not isinstance(c, dict) or c.get("event_type") != "selfkill_blocked":
            continue
        try:
            d = cts - int(c.get("ts"))
        except Exception:
            continue
        if _td_sk_consumed(c, cts):
            continue
        if -1000 <= d <= win and (best_d is None or abs(d) < abs(best_d)):
            sk, best_d = c, d
    if sk is None:
        return False
    cul = _deidx_name(sk.get("culprit"))
    vec = sk.get("vector") or "exit"
    rec["pid"] = cul
    rec["culprit_kind"] = "plugin" if cul else "system"
    rec["confidence"] = "medium"
    rec["native_subtype"] = "selfkill_aftermath"
    rec["pid_choice_src"] = "selfkill-aftermath"
    rec["pid_resolve_src"] = "kg-correlated"
    rec["unattributed_reason"] = None
    rec["runtime_abort_suspect"] = True
    rec["selfkill_aftermath"] = {
        "block_ts": sk.get("ts"), "block_culprit": cul, "vector": vec,
        "signal": sk.get("signal"), "api": sk.get("api"), "delta_ms": int(best_d), "where": where,
    }
    rec["native_advisory"] = ("последствие заблокированного %s плагина %r: после блокировки %s поток вернулся в noreturn-код рантайма и упал (signo=%d через %d мс) -- не отдельный краш" % (vec, cul, sk.get("api") or "exit", sig, int(best_d)))
    try: _ta_mark_died(sk, sig, int(best_d), cts)
    except Exception: pass
    _log("Block#4C +TA(1): signo=%d в рантайме (%s) через %dms после заблокированного %s -> последствие блокировки; culprit=%r conf=medium [%s]" % (sig, top or fso, int(best_d), vec, cul, where))
    return True

def _td_sk_consumed(sk, cts):
    try:
        return bool(isinstance(sk, dict) and sk.get("process_survived") is False and sk.get("aftermath_ts") not in (None, cts))
    except Exception:
        return False

def _td_runtime_abort(rec):
    try:
        if int(rec.get("signo") or 0) != 4 or rec.get("pid") is not None:
            return False
        top = ((rec.get("top_so") or "").rsplit("/", 1)[-1] or "").lower()
        if top not in _MD_RT_SO:
            return False
        rec["runtime_abort_suspect"] = True
        rec["native_subtype"] = "runtime_abort"
        rec["confidence"] = "low"
        rec["unattributed_reason"] = "runtime-abort: SIGILL wholly in JVM/ART runtime (%s) without fresh selfkill_blocked -- runtime abort / not a standalone plugin crash" % top
        _log("Block#35 +TD(2): SIGILL в рантайме (%s) без свежей блокировки exit -> runtime_abort_suspect, conf=low [journal]" % top)
        return True
    except Exception:
        return False

def _ta_mark_died(sk, sig, delta, cts):
    upd = {"process_survived": False, "aftermath_signo": sig, "aftermath_delta_ms": delta, "aftermath_ts": cts,
           "neutralized_note": "exit заблокирован, но процесс умер через %d мс (signo=%d): возврат из noreturn-пути рантайма" % (delta, sig)}
    bts = sk.get("ts")
    vp = _kg_verdict_path()
    if vp and os.path.exists(vp):
        try:
            with open(vp, "r", encoding="utf-8") as f:
                v = json.load(f)
            if isinstance(v, dict) and v.get("ts") == bts and v.get("process_survived") is None:
                v.update(upd)
                _atomic_json_write(vp, v)
        except Exception:
            pass
    hp = _kg_history_path()
    if hp and os.path.exists(hp):
        try:
            with open(hp, "r", encoding="utf-8") as f:
                h = list(json.load(f))
            ch = False
            for it in h:
                if isinstance(it, dict) and it.get("ts") == bts and it.get("process_survived") is None:
                    it.update(upd)
                    ch = True
            if ch:
                _atomic_json_write(hp, h, 40)
        except Exception:
            pass

def _kg_sentinel_path():
    return _data_path(_KG_SENTINEL_NAME)

def _kg_verdict_path():
    return _data_path(_KG_VERDICT_NAME)

def _fg_sentinel_path():
    return _data_path(_FG_SENTINEL_NAME)

def _fg_verdict_path():
    return _data_path(_FG_VERDICT_NAME)

def _self_backup_path():
    try:
        pd = _app_priv_dir()
        if pd:
            return File(pd, _SELF_BACKUP_NAME).getAbsolutePath()
    except Exception:
        pass
    return _data_path(_SELF_BACKUP_NAME)

def _self_plugin_path():
    try:
        fp = globals().get("__file__")
        if isinstance(fp, str) and fp and fp.endswith(".py"):
            try:
                if File(fp).exists(): return File(fp).getAbsolutePath()
            except Exception:
                return fp
    except Exception:
        pass
    try:
        PC = jclass("com.exteragram.messenger.plugins.PluginsController").getInstance()
        d = PC.pluginsDir
        if d is not None:
            return File(d, str(_SELF_ID) + ".py").getAbsolutePath()
    except Exception:
        pass
    return None

def _b31_enable_pref():
    try:
        PC = jclass("com.exteragram.messenger.plugins.PluginsController").getInstance()
        try:
            PC.setPluginEnabled(str(_SELF_ID), True)
            return True
        except Exception:
            pass
    except Exception:
        pass
    return False

def _b31_write_file(path, data):
    if not path: return False
    try:
        tmp = path + ".tmp"
        with open(tmp, "wb") as f:
            f.write(data); f.flush()
            try: os.fsync(f.fileno())
            except Exception: pass
        try:
            os.replace(tmp, path)
        except Exception:
            with open(path, "wb") as f2:
                f2.write(data); f2.flush()
                try: os.fsync(f2.fileno())
                except Exception: pass
            try: os.remove(tmp)
            except Exception: pass
        return True
    except Exception as e:
        _log("Block#31 write err: %s" % e)
        return False

_b31_last_src_sig = None
_b31_fail_sig = None
_b31_fail_ts = 0.0
_B31_FAIL_BACKOFF_S = 300.0

_B31_BAK_LOCK = threading.Lock()

def _b31_backup_self():
    global _b31_last_src_sig, _b31_fail_sig, _b31_fail_ts
    if not _B31_BAK_LOCK.acquire(False):
        return False
    try:
        sp = _self_plugin_path(); bp = _self_backup_path()
        if not sp or not bp: return False
        if not File(sp).exists(): return False
        try:
            st = os.stat(sp)
            sig = (getattr(st, "st_mtime_ns", int(st.st_mtime * 1000000000)), st.st_size)
        except Exception:
            sig = None
        if sig is not None and sig == _b31_last_src_sig:
            try:
                if File(bp).exists() and os.path.getsize(bp) > 0:
                    return True
            except Exception:
                pass
        if (sig is not None and sig == _b31_fail_sig
                and (time.time() - _b31_fail_ts) < _B31_FAIL_BACKOFF_S):
            return False
        with open(sp, "rb") as f: data = f.read()
        if not data: return False
        ok = _b31_write_file(bp, data)
        if ok:
            if sig is not None:
                _b31_last_src_sig = sig
            _b31_fail_sig = None
        else:
            _b31_fail_sig = sig
            _b31_fail_ts = time.time()
        return ok
    except Exception as e:
        _log("Block#31 backup err: %s" % e)
        return False
    finally:
        _B31_BAK_LOCK.release()

def _b31_resurrect():
    try:
        sp = _self_plugin_path(); bp = _self_backup_path()
        if not sp or not bp: return False
        if File(sp).exists(): return False
        if not File(bp).exists(): return False
        with open(bp, "rb") as f: data = f.read()
        if not data: return False
        if not _b31_write_file(sp, data): return False
        _log("Block#31: detector .py восстановлен из бэкапа -> %s" % sp)
        try: _b31_enable_pref()
        except Exception: pass
        try:
            vp = _fg_verdict_path()
            if vp:
                verdict = {"kind": "detector_resurrected", "from": bp, "to": sp,
                           "culprit": _UNTAGGED_LABEL,
                           "reason": "Детектор был удалён и автоматически восстановил себя из резервной копии (.bak.py)",
                           "confidence": "high", "detector": "Block#31 self-resurrect",
                           "version": __version__, "ts": int(time.time() * 1000), "tag": "boot"}
                _atomic_json_write(vp, verdict)
        except Exception: pass
        return True
    except Exception as e:
        _log("Block#31 resurrect err: %s" % e)
        return False

_B31_WD_THREAD = None
_B31_WD_STOP_EVT = threading.Event()
_B31_WD_STOPPED = False
_B31_WD_LOCK = threading.Lock()
_B31_WD_INTERVAL = 1.0
_B31_WD_GRACE = 2.5
_b31_missing_since = None

def _b31_reset_native_sentinel():
    try:
        if _NLIB is not None and hasattr(_NLIB, "cd_fg_reset_sentinel"):
            _NLIB.cd_fg_reset_sentinel()
    except Exception:
        pass

def _b31_clear_sentinel(reason):
    try:
        p = _fg_sentinel_path()
        _mp = _aw_mirror_path(p) if p else None
        if p and (File(p).exists() or (_mp and File(_mp).exists())):
            _rc_remove_both(p)
            _log("Block#31: stale fileguard sentinel discarded (%s)" % reason)
    except Exception:
        pass
    _b31_reset_native_sentinel()

def _b31_native_read():
    if not (_WD_NATIVE_OK and _NLIB is not None):
        return None
    try:
        buf = (ctypes.c_int64 * 8)()
        got = int(_NLIB.cd_wd_read(buf, 8))
        if got < 8:
            return None
        return {"src_present": bool(buf[0]), "src_mtime_ns": int(buf[1]),
                "src_size": int(buf[2]), "bak_present": bool(buf[3]),
                "bak_size": int(buf[4]), "sentinel_present": bool(buf[5]),
                "missing_ms": int(buf[6]), "ts_ms": int(buf[7])}
    except Exception:
        return None

def _b31_native_wd_start():
    if not (_WD_NATIVE_OK and _NATIVE_OK and _NLIB is not None):
        return False
    try:
        if int(_NLIB.cd_wd_running()):
            return True
    except Exception:
        pass
    sp = _self_plugin_path(); bp = _self_backup_path(); se = _aw_mirror_path(_fg_sentinel_path()) or _fg_sentinel_path()
    try:
        rc = int(_NLIB.cd_wd_start((sp or "").encode("utf-8"),
                                   (bp or "").encode("utf-8"),
                                   (se or "").encode("utf-8"),
                                   int(_B31_WD_INTERVAL * 1000)))
        if rc >= 0:
            _log("Block#31: нативный off-GIL watchdog запущен (+DS, period=%dms)" % int(_B31_WD_INTERVAL * 1000))
            return True
    except Exception as e:
        _log("Block#31 native wd start err: %s" % e)
    return False

_B31_INSTALL_TEMP_SUFFIXES = (".tmp", ".part", ".partial", ".download", ".dl", ".new", ".writing", ".crdownload", "~")
_B31_INSTALL_FRESH_S = 12.0

def _b31_fresh(p):
    try:
        return (time.time() - os.path.getmtime(p)) <= _B31_INSTALL_FRESH_S
    except Exception:
        return False

def _b31_install_in_progress():
    try:
        sp = _self_plugin_path()
        if not sp: return False
        d = os.path.dirname(sp) or _DIR
        base = os.path.basename(sp)
        for suf in _B31_INSTALL_TEMP_SUFFIXES:
            try:
                cand = os.path.join(d, base + suf)
                if os.path.exists(cand) and _b31_fresh(cand):
                    return True
            except Exception: pass
        try:
            for nm in os.listdir(d):
                if nm.lower().endswith(_B31_INSTALL_TEMP_SUFFIXES) and _b31_fresh(os.path.join(d, nm)):
                    return True
        except Exception: pass
    except Exception: pass
    return False

def _b31_watchdog_tick():
    global _b31_missing_since
    _gil_begin(_GIL_B31)
    try:
        snap = _b31_native_read()
        if snap is not None:
            if snap["src_present"]:
                if _b31_missing_since is not None:
                    _b31_missing_since = None
                if snap["sentinel_present"]:
                    try: _b31_read_sentinel("watchdog-blocked")
                    except Exception: pass
                    _b31_clear_sentinel("file present")
                if (not snap["bak_present"]) or ((snap["src_mtime_ns"], snap["src_size"]) != _b31_last_src_sig):
                    try: _b31_backup_self()
                    except Exception: pass
            else:
                if (snap["missing_ms"] / 1000.0) >= _B31_WD_GRACE:
                    if _b31_install_in_progress():
                        try: _log("Block#31: .py нет, но рядом свежий temp установки -- восстановление отложено")
                        except Exception: pass
                    else:
                        if _b31_resurrect():
                            try: _b31_read_sentinel("watchdog")
                            except Exception: pass
                            _b31_reset_native_sentinel()
                        _b31_missing_since = None
        else:
            pass
    except Exception as e:
        _log("Block#31 watchdog tick err: %s" % e)
    finally:
        _gil_end(_GIL_B31)

def _b31_watchdog_loop():
    while not _B31_WD_STOP_EVT.is_set():
        if _B31_WD_STOP_EVT.wait(_B31_WD_INTERVAL): break
        if not _BLOCK31_ON or globals().get("_B31_WD_STOPPED", False): break
        try: _b31_watchdog_tick()
        except Exception as e:
            try: _log("Block#31 watchdog loop err: %s" % e)
            except Exception: pass

def _b31_watchdog_arm():
    global _B31_WD_THREAD
    if not _BLOCK31_ON or globals().get("_B31_WD_STOPPED", False): return
    try:
        with _B31_WD_LOCK:
            t = _B31_WD_THREAD
            if t is not None and t.is_alive():
                return
            _B31_WD_STOP_EVT.clear()
            _B31_WD_THREAD = threading.Thread(target=_b31_watchdog_loop, name="cd-b31-wd", daemon=True)
            _B31_WD_THREAD.start()
    except Exception as e:
        _log("Block#31 watchdog arm err: %s" % e)

def _b31_watchdog_stop():
    global _B31_WD_THREAD, _b31_missing_since, _B31_WD_STOPPED
    try:
        if _WD_NATIVE_OK and _NLIB is not None and int(_NLIB.cd_wd_running()):
            _NLIB.cd_wd_stop()
    except Exception:
        pass
    _B31_WD_STOPPED = True
    _B31_WD_STOP_EVT.set()
    try:
        with _B31_WD_LOCK:
            t = _B31_WD_THREAD
            _B31_WD_THREAD = None
        if t is not None and t is not threading.current_thread():
            try: t.join(timeout=2.0)
            except Exception: pass
        _b31_missing_since = None
    except Exception:
        pass

def _b31_decl(lib):
    global _B31_OK
    c = ctypes
    needed = ("cd_fg_protect", "cd_fg_start", "cd_fg_running")
    if not all(hasattr(lib, n) for n in needed):
        _B31_OK = False
        _log("Block#31: cd_fg_* нет в .so (старый бинарь) -- file-guard отключён")
        return False
    lib.cd_fg_protect.argtypes = [c.c_char_p]; lib.cd_fg_protect.restype = c.c_int
    lib.cd_fg_start.argtypes = [c.c_char_p]; lib.cd_fg_start.restype = c.c_int
    if hasattr(lib, "cd_fg_stop"): lib.cd_fg_stop.restype = c.c_int
    lib.cd_fg_running.restype = c.c_int
    if hasattr(lib, "cd_fg_arm"):
        lib.cd_fg_arm.argtypes = [c.c_int]; lib.cd_fg_arm.restype = c.c_int
    if hasattr(lib, "cd_fg_is_armed"):
        lib.cd_fg_is_armed.restype = c.c_int
    if hasattr(lib, "cd_fg_count"):
        lib.cd_fg_count.restype = c.c_int
    for opt in ("cd_fg_seen", "cd_fg_blocked"):
        if hasattr(lib, opt): getattr(lib, opt).restype = c.c_int64
    if hasattr(lib, "cd_fg_reset_sentinel"):
        lib.cd_fg_reset_sentinel.restype = c.c_int
    _B31_OK = True
    return True

def _b31_init(lib):
    if not _BLOCK31_ON:
        _log("Block#31: отключён (_BLOCK31_ON=False)"); return
    try:
        _b31_decl(lib)
    except Exception as e:
        _log("Block#31 decl err: %s" % e)

def _b31_start():
    global _B31_STARTED, _B31_WD_STOPPED
    if not _BLOCK31_ON: return
    _B31_WD_STOPPED = False
    try: _b31_native_wd_start()
    except Exception: pass
    try: _b31_backup_self()
    except Exception: pass
    try: _b31_watchdog_arm()
    except Exception: pass
    if not (_B31_OK and _NATIVE_OK and _NLIB is not None):
        _log("Block#31: натив/символы недоступны -- только бэкап"); return
    if _B31_STARTED: return
    sp = _self_plugin_path()
    if not sp:
        _log("Block#31: put detektora ne razreshen -- propusk"); return
    try:
        rc = int(_NLIB.cd_fg_protect(sp.encode("utf-8")))
        if rc < 0: _log("Block#31: cd_fg_protect vernul %d" % rc)
    except Exception as e:
        _log("Block#31 cd_fg_protect err: %s" % e); return
    p = _fg_sentinel_path()
    _pw = _aw_mirror_path(p) or p
    try:
        rc2 = int(_NLIB.cd_fg_start((_pw or "").encode("utf-8")))
    except Exception as e:
        _log("Block#31 cd_fg_start err: %s" % e); return
    if rc2 < 0:
        _log("Block#31: cd_fg_start vernul %d -- libc rename/unlink ne zacepilis" % rc2); return
    _B31_STARTED = True
    _log("Block#31: file-guard установлен (libc rename/renameat/unlink/unlinkat), хуков=%d, защищён=%s" % (rc2, sp))
    try: _b31_read_sentinel("post-start")
    except Exception: pass

def _b31_stop():
    global _B31_STARTED
    try: _b31_watchdog_stop()
    except Exception: pass
    if not _B31_STARTED: return
    try:
        if _NLIB is not None: _NLIB.cd_fg_stop()
    except Exception: pass
    _B31_STARTED = False
    _log("Block#31: snjat (cd_fg_stop)")

def _b31_parse_sentinel(text):
    rec = {}
    try:
        for line in text.splitlines():
            line = line.strip()
            if not line or line in ("CULPRIT_FILEGUARD", "END"): continue
            for tok in line.split(" "):
                if "=" in tok:
                    k, v = tok.split("=", 1)
                    rec[k] = v
    except Exception:
        pass
    return rec

def _b31_read_sentinel(tag):
    if not _BLOCK31_ON: return None
    p = _fg_sentinel_path()
    if not p: return None
    _rp = _rc_take_path(p)
    if not _rp: return None
    try:
        with open(_rp, "r", encoding="utf-8", errors="replace") as f:
            text = f.read()
    except Exception:
        return None
    finally:
        try: os.remove(_rp)
        except Exception: pass
    rec = _b31_parse_sentinel(text)
    if not rec: return None
    owner_id = rec.get("owner_id") or ""
    if owner_id in ("(?)", ""): owner_id = ""
    try: idx = int(rec.get("owner_idx", "-1"))
    except Exception: idx = -1
    name = owner_id or _resolve_idx_durable(idx) or (("idx#%d" % idx) if idx >= 0 else "unknown")
    name = _deidx_name(name)
    api = rec.get("api", "?")
    path = rec.get("path", "?")
    try: ts = int(rec.get("ts", "0"))
    except Exception: ts = int(time.time() * 1000)
    _kgc = _kg_crash_corroborate(idx, ts, name)
    if _kgc: name = _kgc[0]
    low = name.lower()
    dropper = ("netprotector" in low) or ("netblocker" in low) or ("shikatu" in low)
    verdict = {"event_type": "file_delete_blocked", "dropbox_tag": "self_protection", "tombstone_norm_version": 1, "kind": "detector_erase_blocked", "culprit": name, "owner_idx": idx,
               "api": api, "path": path, "vector": "os.replace/os.remove on detector .py",
               "dropper_signature": dropper, "neutralized": True,
               "confidence": "high", "detector": "Block#31 native file-guard",
               "version": __version__, "ts": ts, "tag": tag}
    if _kgc:
        verdict["culprit_src"] = _kgc[1]
        if _kgc[2] != _kgc[0]: verdict["culprit_sidecar"] = _kgc[2]
    vp = _fg_verdict_path()
    if vp:
        try:
            if not _atomic_json_write(vp, verdict):
                _log("Block#31 verdict write returned False")
        except Exception as e:
            _log("Block#31 verdict write err: %s" % e)
    _log("=============== DETECTOR ERASE NEUTRALIZED (Block#31) ===============")
    _log("  culprit=%s api=%s path=%s" % (name, api, path))
    _log("  detector .py survived; verdict -> %s" % _FG_VERDICT_NAME)
    _log("====================================================================")
    try:
        _b16_push_verdict("detector_erase_blocked", {"culprit": name, "confidence": "high", "where": api, "ts": ts})
    except Exception:
        pass
    return verdict

def _b30_decl(lib):
    global _B30_OK
    c = ctypes
    needed = ("cd_kg_start", "cd_kg_stop", "cd_kg_running")
    if not all(hasattr(lib, n) for n in needed):
        _B30_OK = False
        _log("Block#30: cd_kg_* нет в .so (старый бинарь) -- kill-guard отключён")
        return False
    lib.cd_kg_start.argtypes = [c.c_char_p]; lib.cd_kg_start.restype = c.c_int
    lib.cd_kg_stop.restype = c.c_int
    lib.cd_kg_running.restype = c.c_int
    if hasattr(lib, "cd_kg_arm"):
        lib.cd_kg_arm.argtypes = [c.c_int]; lib.cd_kg_arm.restype = c.c_int
    if hasattr(lib, "cd_kg_is_armed"):
        lib.cd_kg_is_armed.restype = c.c_int
    for opt in ("cd_kg_seen", "cd_kg_blocked"):
        if hasattr(lib, opt): getattr(lib, opt).restype = c.c_int64
    if hasattr(lib, "cd_kg_permit_restart"):
        lib.cd_kg_permit_restart.restype = c.c_int
    if hasattr(lib, "cd_kg_permit_crash"):
        lib.cd_kg_permit_crash.restype = c.c_int
    _B30_OK = True
    return True

def _b30_init(lib):
    if not _BLOCK30_ON:
        _log("Block#30: отключён (_BLOCK30_ON=False)"); return
    try:
        _b30_decl(lib)
    except Exception as e:
        _log("Block#30 decl err: %s" % e)

def _b30_start():
    global _B30_STARTED
    if not _BLOCK30_ON: return
    if not (_B30_OK and _NATIVE_OK and _NLIB is not None):
        _log("Block#30: nativ/simvoly nedostupny -- propusk"); return
    if _B30_STARTED: return
    p = _kg_sentinel_path()
    if not p:
        _log("Block#30: put killguard.txt nedostupen -- propusk"); return
    _pw = _aw_mirror_path(p) or p
    try:
        rc = int(_NLIB.cd_kg_start(_pw.encode("utf-8")))
    except Exception as e:
        _log("Block#30 cd_kg_start err: %s" % e); return
    if rc < 0:
        _log("Block#30: cd_kg_start vernul %d -- libc kill/exit ne zacepilis" % rc); return
    _B30_STARTED = True
    _log("Block#30: kill-guard установлен (libc kill/tgkill/exit/_exit/_Exit), хуков=%d -> %s" % (rc, _pw))
    try: _b30_read_sentinel("post-start")
    except Exception: pass

def _b30_stop():
    global _B30_STARTED
    if not _B30_STARTED: return
    try:
        if _NLIB is not None: _NLIB.cd_kg_stop()
    except Exception: pass
    _B30_STARTED = False
    _log("Block#30: snjat (cd_kg_stop)")

def _kg_crash_corroborate(idx, ts, name):
    try:
        _unres = (not name) or (name == "unknown") or name.startswith("#") or name.startswith("idx#")
        _best = None
        _recs = []
        try:
            if isinstance(_BOOT_FRESH_VERDICT, dict): _recs.append(_BOOT_FRESH_VERDICT)
        except Exception: pass
        for _pf in (_crash_verdict_durable_path, _crash_path):
            try: _p = _pf()
            except Exception: _p = None
            if not _p: continue
            try:
                if not os.path.exists(_p): continue
                with open(_p, "r", encoding="utf-8") as _f:
                    _recs.append(json.load(_f))
            except Exception:
                continue
        for _crec in _recs:
            if not isinstance(_crec, dict): continue
            _nm = _crec.get("crashed_plugin_id")
            if not (isinstance(_nm, str) and _nm and _nm != "unknown"): continue
            if _nm.startswith("#") or _nm.startswith("idx#") or _nm.startswith("$Proxy"): continue
            try: _rts = int(_crec.get("ts") or 0)
            except Exception: _rts = 0
            if (not _rts) or abs(int(ts) - _rts) > 3000: continue
            try: _ridx = int(_crec.get("reg_idx"))
            except Exception: _ridx = -1
            if _ridx >= 0 and idx >= 0 and _ridx == idx:
                return (_nm, "crash-corr/idx+ts", name)
            if _unres and _crec.get("confidence") == "high" and _best is None:
                _best = (_nm, "crash-corr/ts-window", name)
        return _best
    except Exception:
        return None

def _b30_parse_sentinel(text):
    rec = {}
    try:
        for line in text.splitlines():
            line = line.strip()
            if not line or line in ("CULPRIT_KILLGUARD", "END"): continue
            for tok in line.split(" "):
                if "=" in tok:
                    k, v = tok.split("=", 1)
                    rec[k] = v
    except Exception:
        pass
    return rec

def _b30_read_sentinel(tag):
    if not _BLOCK30_ON: return None
    p = _kg_sentinel_path()
    if not p: return None
    _rp = _rc_take_path(p)
    if not _rp: return None
    try:
        with open(_rp, "r", encoding="utf-8", errors="replace") as f:
            text = f.read()
    except Exception:
        return None
    finally:
        try: os.remove(_rp)
        except Exception: pass
    rec = _b30_parse_sentinel(text)
    if not rec: return None
    owner_id = rec.get("owner_id") or ""
    if owner_id in ("(?)", ""): owner_id = ""
    try: idx = int(rec.get("owner_idx", "-1"))
    except Exception: idx = -1
    name = owner_id or _resolve_idx_durable(idx) or (("idx#%d" % idx) if idx >= 0 else "unknown")
    name = _deidx_name(name)
    api = rec.get("api", "?")
    try: sig = int(rec.get("signal", "0"))
    except Exception: sig = 0
    try: ts = int(rec.get("ts", "0"))
    except Exception: ts = int(time.time() * 1000)
    _kgc = _kg_crash_corroborate(idx, ts, name)
    if _kgc: name = _kgc[0]
    low = name.lower()
    dropper = ("netprotector" in low) or ("netblocker" in low) or ("shikatu" in low)
    vector = "Process.killProcess(myPid)" if api in ("kill", "tgkill") else "libc.%s" % api
    try: _kg_call_pid = int(rec.get("call_pid") or rec.get("pid") or 0) or None
    except Exception: _kg_call_pid = None
    try: _kg_protected_pid = int(rec.get("pid") or 0) or None
    except Exception: _kg_protected_pid = None
    try: _kg_ppid = int(rec.get("ppid") or 0) or None
    except Exception: _kg_ppid = None
    if (_kg_call_pid is not None and _kg_protected_pid is not None and
            _kg_call_pid != _kg_protected_pid):
        _log("Block#30 +UA: descendant exit sidecar ignored (call_pid=%s protected_pid=%s)" % (_kg_call_pid, _kg_protected_pid))
        return None
    verdict = {
        "event_type": "selfkill_blocked", "dropbox_tag": "self_protection", "tombstone_norm_version": 1,
        "kind": "self_kill_blocked", "culprit": name, "owner_idx": idx,
        "api": api, "signal": sig, "vector": vector,
        "dropper_signature": dropper, "neutralized": True,
        "confidence": "high", "detector": "Block#30 native kill-guard",
        "version": __version__, "ts": ts, "tag": tag,
    }
    verdict["proc_pid"] = _kg_call_pid
    verdict["protected_pid"] = _kg_protected_pid
    verdict["ppid"] = _kg_ppid
    verdict["owner_id_raw"] = owner_id or None
    if not _kgc:
        verdict["culprit_src"] = "sidecar-owner-id" if owner_id else ("idx-durable" if idx >= 0 else "unresolved")
    if _kgc:
        verdict["culprit_src"] = _kgc[1]
        if _kgc[2] != _kgc[0]: verdict["culprit_sidecar"] = _kgc[2]
    vp = _kg_verdict_path()
    if vp:
        try:
            if not _atomic_json_write(vp, verdict):
                _log("Block#30 verdict write returned False")
        except Exception as e:
            _log("Block#30 verdict write err: %s" % e)
    try:
        _kh = _kg_history_path()
        if _kh:
            _khist = []
            try:
                if os.path.exists(_kh):
                    with open(_kh, "r", encoding="utf-8") as _khf:
                        _khist = list(json.load(_khf))
            except Exception:
                _khist = []
            _khist.append(verdict)
            _atomic_json_write(_kh, _khist, 40)
    except Exception as _ekh:
        try: _log("Block#30 history append err: %s" % _ekh)
        except Exception: pass
    try: _kg_tid = int(rec.get("tid", ""))
    except Exception: _kg_tid = None
    try: globals()["_B30_LAST_BLOCKED"] = {"ts": ts, "culprit": name, "vector": vector, "dropper": dropper, "tid": _kg_tid, "proc_pid": _kg_call_pid}
    except Exception: pass
    _log("=============== SELF-KILL NEUTRALIZED (Block#30) ===============")
    _log("  culprit=%s api=%s signal=%d vector=%s dropper=%s" % (name, api, sig, vector, dropper))
    if tag == "boot":
        _log("  вызов заблокирован, но прошлая сессия всё равно завершилась -- выживание после блокировки НЕ подтверждено (см. пост-мортем / +TA); verdict -> %s" % _KG_VERDICT_NAME)
    else:
        _log("  detector survived; verdict -> %s" % _KG_VERDICT_NAME)
    _log("===============================================================")
    try:
        _b16_push_verdict("self_kill_blocked", {"culprit": name, "confidence": "high", "where": vector, "ts": ts})
    except Exception:
        pass
    return verdict

def _b26_decl(lib):
    global _B26_OK
    c = ctypes
    needed = ("cd_cxa_start", "cd_cxa_stop", "cd_cxa_running")
    if not all(hasattr(lib, n) for n in needed):
        _B26_OK = False
        _log("Block#26: cd_cxa_* нет в .so (старый бинарь) — C++ throw-атрибуция отключена")
        return False
    lib.cd_cxa_start.argtypes = [c.c_char_p]; lib.cd_cxa_start.restype = c.c_int
    lib.cd_cxa_stop.restype = c.c_int
    lib.cd_cxa_running.restype = c.c_int
    for opt in ("cd_cxa_seen", "cd_cxa_captured", "cd_cxa_dropped"):
        if hasattr(lib, opt): getattr(lib, opt).restype = c.c_int64
    _B26_OK = True
    return True

def _b26_init(lib):
    if not _BLOCK26_ON:
        _log("Block#26: отключён (_BLOCK26_ON=False)"); return
    try:
        if not _b26_decl(lib): return
    except Exception as e:
        _log("Block#26 decl err: %s" % e); return

def _b26_start():
    global _B26_STARTED
    if not _BLOCK26_ON: return
    if not (_B26_OK and _NATIVE_OK and _NLIB is not None):
        _log("Block#26: натив/символы недоступны -- пропуск"); return
    if _B26_STARTED: return
    p = _cxa_path()
    if not p:
        _log("Block#26: путь cxa_throw.txt недоступен -- пропуск"); return
    _pw = _aw_mirror_path(p) or p
    try:
        rc = int(_NLIB.cd_cxa_start(_pw.encode("utf-8")))
    except Exception as e:
        _log("Block#26 cd_cxa_start err: %s" % e); return
    if rc <= 0:
        _log("Block#26: cd_cxa_start вернул %d -- __cxa_throw не зацепился (нет shared libc++?)" % rc); return
    _B26_STARTED = True
    _log("Block#26: установлен (__cxa_throw hook) -> %s" % _pw)

def _b26_stop():
    global _B26_STARTED
    if not _B26_STARTED: return
    try:
        if _NLIB is not None: _NLIB.cd_cxa_stop()
    except Exception: pass
    _B26_STARTED = False
    _log("Block#26: снят (cd_cxa_stop)")

def _read_and_clear_cxa():
    recs = []
    try:
        p = _cxa_path()
        _rp = _rc_take_path(p) if p else None
        if not _rp: return recs
        try:
            with open(_rp, "r", encoding="utf-8", errors="replace") as f:
                raw = f.read()
        finally:
            try: os.remove(_rp)
            except Exception: pass
        if "CULPRIT_CXA_THROW" not in raw: return recs
        cur = None
        for line in raw.splitlines():
            s = line.strip()
            if s == "CULPRIT_CXA_THROW":
                cur = {"kind": None, "module": None, "owner": None, "conf": None,
                       "type": None, "ts": None, "culprit_frame": None, "frames": []}
                recs.append(cur); continue
            if cur is None: continue
            if s == "END": cur = None; continue
            if s.startswith("kind="):
                for tok in s.split():
                    if tok.startswith("kind="): cur["kind"] = tok.split("=", 1)[1]
                    elif tok.startswith("module="): cur["module"] = tok.split("=", 1)[1]
                    elif tok.startswith("type="): cur["type"] = tok.split("=", 1)[1]
                    elif tok.startswith("ts="):
                        try: cur["ts"] = int(tok.split("=", 1)[1])
                        except Exception: pass
                    elif tok.startswith("culprit_frame="):
                        try: cur["culprit_frame"] = int(tok.split("=", 1)[1])
                        except Exception: pass
                if cur.get("kind") == "plugin" and cur.get("module"):
                    try: cur["owner"], cur["conf"] = _so_owner_from_path(cur["module"])
                    except Exception: cur["owner"], cur["conf"] = None, None
            elif s.startswith("#"):
                cur["frames"].append(s)
        return [r for r in recs if r.get("kind")]
    except Exception:
        return recs

_BLOCK28_ON = True
_B28_WARN_ON = True
_GLOBALREF_FILE_NAME = "globalref_verdict.json"
_GLOBALREF_SEEN_NAME = "globalref_seen.json"
_GLOBALREF_DUMP_NAME = "globalref_dump.txt"
_GLOBALREF_FAILS_MAX = 20
_GLOBALREF_SEEN_MAX = 64
_B28_WARN_PERIOD_S = 60.0
_B28_THREAD = None
_B28_STOP = threading.Event()
_B28_WARNED = set()
_B28_OVERFLOW_MARK = "global reference table overflow"
_PROC_START_MS = int(time.time() * 1000)
_B28_STALE_ECHO_MS = 180000
_B28_TS_RE = re.compile(r"^\s*(\d\d)-(\d\d)\s+(\d\d):(\d\d):(\d\d)\.(\d+)")
_B28_HOOK_REG = {}
_B28_HOOK_REG_LOCK = threading.Lock()
_B28_HOT_METHODS = (
    "addEntitiesToText", "applyEntities", "generateLayout",
    "messageTextToString", "replaceAnimatedEmoji",
)

_B10_PASSIVE_SCOPE_SKIP = True
_B10_PASSIVE_WINDOW_S = 3.0
_B10_PASSIVE_HOT_RATE = 80.0
_B10_PASSIVE_HOT_WINDOWS = 2
_B10_PASSIVE_MAX_KEYS = 1024
_B10_PASSIVE_PERSIST_S = 3.0
_B10_PASSIVE_TTL_S = 3600.0
_B10_PASSIVE_RECENT_MAX_PER_OWNER = 16
_B10_PASSIVE_RECENT_WINDOW_MS = 10000
_B10_PASSIVE_STATE_NAME = "b10_passive_hot.json"
_B10_PASSIVE_LOCK = threading.RLock()
_B10_PASSIVE_HITS = {}
_B10_PASSIVE_FORCE = {}
_B10_PASSIVE_RECENT_SKIPS = {}
_B10_PASSIVE_LAST_PERSIST = 0.0
_B10_PASSIVE_LOADED = False
_B10_PASSIVE_DIRTY = False
_B10_PASSIVE_STATS = {"seen": 0, "shape_pass": 0, "hot_skip": 0, "force_scope": 0, "persist": 0}
_B10_PASSIVE_POS_PREFIXES = ("get", "is", "has", "can", "should")
_B10_PASSIVE_DENY_PREFIXES = (
    "set", "send", "post", "notify", "dispatch", "handle", "on", "do", "run",
    "draw", "layout", "measure", "bind", "load", "create", "init", "start",
    "stop", "open", "close", "delete", "remove", "update", "write", "read",
    "save", "commit", "apply", "perform", "execute",
)

_B10_REENTRY_MAX_DEPTH = 1
_B10_REENTRY_LOG_MS = 5000
_B10_REENTRY_LOCK = threading.Lock()
_B10_REENTRY_LAST_LOG = {}
_B10_REENTRY_STATS = {"enter": 0, "cut": 0}
_B10_UNSET = object()
_B10_OWNER_CACHE = {}
_B10_WHERE_CODE = {"before_hooked_method": 0, "after_hooked_method": 1, "replace_hooked_method": 2}
_CD_B10_ENTER = None
_CD_B10_LEAVE = None
_B10_METHOD_IDX = {}
_B10_METHOD_IDX_LOCK = threading.Lock()
_B10_METHOD_IDX_SEQ = [0]
def _b10_method_idx(name):
    if not name: return 0
    i = _B10_METHOD_IDX.get(name)
    if i is not None: return i
    with _B10_METHOD_IDX_LOCK:
        i = _B10_METHOD_IDX.get(name)
        if i is None:
            _B10_METHOD_IDX_SEQ[0] += 1
            i = _B10_METHOD_IDX_SEQ[0]
            _B10_METHOD_IDX[name] = i
        return i
def _b10_reentry_log_cut(owner, where, method_name):
    try: _B10_REENTRY_STATS["cut"] = int(_B10_REENTRY_STATS.get("cut") or 0) + 1
    except Exception: pass
    try:
        key = "%s|%s|%s" % (owner, where, method_name)
        now = int(time.time() * 1000)
        _do = False
        with _B10_REENTRY_LOCK:
            last = int(_B10_REENTRY_LAST_LOG.get(key) or 0)
            if now - last >= _B10_REENTRY_LOG_MS:
                _B10_REENTRY_LAST_LOG[key] = now
                _do = True
        if _do:
            _log("Block#10 reentry trim (native): owner=%r where=%s method=%s max=%d (hook body skipped)" % (owner, where, method_name, _B10_REENTRY_MAX_DEPTH))
    except Exception: pass

def _b10_passive_key(owner, method_key):
    return "%s|%s" % (owner, method_key)

def _b10_passive_path():
    return _data_path(_B10_PASSIVE_STATE_NAME)

def _b10_shape_getter(name):
    try:
        if not name:
            return False
        if name.startswith(_B10_PASSIVE_DENY_PREFIXES):
            return False
        return name.startswith(_B10_PASSIVE_POS_PREFIXES)
    except Exception:
        return False

def _b10_passive_load_once():
    global _B10_PASSIVE_LOADED
    if _B10_PASSIVE_LOADED:
        return
    with _B10_PASSIVE_LOCK:
        if _B10_PASSIVE_LOADED:
            return
        _B10_PASSIVE_LOADED = True
        try:
            p = _b10_passive_path()
            rp = _rc_read_path(p) if p else None
            if not rp:
                return
            with open(rp, "r", encoding="utf-8") as f:
                obj = json.load(f)
            hot = obj.get("hot") if isinstance(obj, dict) else {}
            force = obj.get("force") if isinstance(obj, dict) else {}
            now = time.time()
            if isinstance(hot, dict):
                for k, v in hot.items():
                    if not isinstance(v, dict):
                        continue
                    last_hot = float(v.get("last_hot") or 0)
                    if last_hot and now - last_hot <= _B10_PASSIVE_TTL_S:
                        _B10_PASSIVE_HITS[k] = {
                            "owner": v.get("owner"), "method": v.get("method"),
                            "name": v.get("name"), "window_start": now,
                            "count": 0, "rate": float(v.get("rate") or 0.0),
                            "hot_windows": _B10_PASSIVE_HOT_WINDOWS, "hot": True,
                            "last_seen": now, "last_hot": last_hot,
                        }
            if isinstance(force, dict):
                for k, v in force.items():
                    if isinstance(v, dict):
                        _B10_PASSIVE_FORCE[k] = v
        except Exception as _e:
            try: _log("B10 passive load err: %s" % _e)
            except Exception: pass

def _b10_passive_maybe_gc_locked(now):
    try:
        if len(_B10_PASSIVE_HITS) <= _B10_PASSIVE_MAX_KEYS:
            return
        items = list(_B10_PASSIVE_HITS.items())
        def _score(kv):
            k, st = kv
            if k in _B10_PASSIVE_FORCE:
                return 1e18
            if st.get("hot"):
                return 1e15 + float(st.get("last_hot") or 0)
            return float(st.get("last_seen") or 0)
        items.sort(key=_score, reverse=True)
        keep = dict(items[:_B10_PASSIVE_MAX_KEYS])
        _B10_PASSIVE_HITS.clear()
        _B10_PASSIVE_HITS.update(keep)
    except Exception:
        pass

def _b10_passive_flush_if_dirty(force=False):
    global _B10_PASSIVE_DIRTY, _B10_PASSIVE_LAST_PERSIST
    try:
        now = time.time()
        obj = None
        with _B10_PASSIVE_LOCK:
            if not _B10_PASSIVE_DIRTY:
                return
            if not force and now - _B10_PASSIVE_LAST_PERSIST < _B10_PASSIVE_PERSIST_S:
                return
            hot = {}
            for k, st in _B10_PASSIVE_HITS.items():
                if not bool(st.get("hot")):
                    continue
                hot[k] = {
                    "owner": st.get("owner"), "method": st.get("method"),
                    "name": st.get("name"), "rate": st.get("rate"),
                    "last_hot": st.get("last_hot") or now,
                }
            stats = dict(_B10_PASSIVE_STATS)
            stats["persist"] = int(stats.get("persist") or 0) + 1
            obj = {
                "version": 1, "ts": int(now * 1000), "hot": hot,
                "force": dict(_B10_PASSIVE_FORCE), "stats": stats,
            }
            _B10_PASSIVE_DIRTY = False
        if obj is None:
            return
        p = _b10_passive_path()
        if not p:
            return
        ok = _atomic_json_write(p, obj)
        with _B10_PASSIVE_LOCK:
            if ok is False:
                _B10_PASSIVE_DIRTY = True
            else:
                _B10_PASSIVE_STATS["persist"] = int(_B10_PASSIVE_STATS.get("persist") or 0) + 1
                _B10_PASSIVE_LAST_PERSIST = now
    except Exception as _e:
        try: _log("B10 passive flush err: %s" % _e)
        except Exception: pass

def _b10_passive_note_skip_locked(owner, method_key, method_name, now):
    try:
        now_ms = int(now * 1000)
        arr = _B10_PASSIVE_RECENT_SKIPS.get(owner)
        if arr is None:
            arr = []
            _B10_PASSIVE_RECENT_SKIPS[owner] = arr
        arr.append({"method": method_key, "name": method_name, "ts": now_ms})
        if len(arr) > _B10_PASSIVE_RECENT_MAX_PER_OWNER:
            del arr[:-_B10_PASSIVE_RECENT_MAX_PER_OWNER]
    except Exception:
        pass

def _b10_passive_scope_skip(owner, method_name, method_key):
    global _B10_PASSIVE_DIRTY
    try:
        if not _B10_PASSIVE_SCOPE_SKIP:
            return False
        if not owner or not method_name:
            return False
        try: _B10_PASSIVE_STATS["seen"] = int(_B10_PASSIVE_STATS.get("seen") or 0) + 1
        except Exception: pass
        if not _b10_shape_getter(method_name):
            return False
        if not method_key:
            method_key = method_name
        _b10_passive_load_once()
        now = time.time()
        key = _b10_passive_key(owner, method_key)
        with _B10_PASSIVE_LOCK:
            _B10_PASSIVE_STATS["shape_pass"] = int(_B10_PASSIVE_STATS.get("shape_pass") or 0) + 1
            if key in _B10_PASSIVE_FORCE:
                _B10_PASSIVE_STATS["force_scope"] = int(_B10_PASSIVE_STATS.get("force_scope") or 0) + 1
                return False
            st = _B10_PASSIVE_HITS.get(key)
            if st is None:
                st = {
                    "owner": owner, "method": method_key, "name": method_name,
                    "window_start": now, "count": 0, "rate": 0.0,
                    "hot_windows": 0, "hot": False, "last_seen": now, "last_hot": 0.0,
                }
                _B10_PASSIVE_HITS[key] = st
            _was_hot = bool(st.get("hot"))
            elapsed = now - float(st.get("window_start") or now)
            if elapsed >= _B10_PASSIVE_WINDOW_S:
                cnt = int(st.get("count") or 0)
                rate = float(cnt) / max(elapsed, 0.001)
                st["rate"] = rate
                st["count"] = 0
                st["window_start"] = now
                if rate >= _B10_PASSIVE_HOT_RATE:
                    st["hot_windows"] = int(st.get("hot_windows") or 0) + 1
                else:
                    st["hot_windows"] = 0
                if int(st.get("hot_windows") or 0) >= _B10_PASSIVE_HOT_WINDOWS:
                    st["hot"] = True
                    st["last_hot"] = now
            st["count"] = int(st.get("count") or 0) + 1
            st["last_seen"] = now
            hot = bool(st.get("hot"))
            if hot and not _was_hot:
                _B10_PASSIVE_DIRTY = True
            if hot:
                _B10_PASSIVE_STATS["hot_skip"] = int(_B10_PASSIVE_STATS.get("hot_skip") or 0) + 1
                _b10_passive_note_skip_locked(owner, method_key, method_name, now)
            _b10_passive_maybe_gc_locked(now)
            return hot
    except Exception:
        return False

def _b10_passive_mark_force(owner, method_key, method_name=None, why="unknown"):
    global _B10_PASSIVE_DIRTY
    try:
        if not owner or not method_key:
            return
        _b10_passive_load_once()
        now = time.time()
        key = _b10_passive_key(owner, method_key)
        with _B10_PASSIVE_LOCK:
            _B10_PASSIVE_FORCE[key] = {
                "owner": owner, "method": method_key,
                "name": method_name or method_key.rsplit(".", 1)[-1],
                "why": why, "ts": now,
            }
            st = _B10_PASSIVE_HITS.get(key)
            if st is not None:
                st["hot"] = False
                st["hot_windows"] = 0
            _B10_PASSIVE_DIRTY = True
    except Exception:
        pass

def _b10_passive_mark_recent_owner_force(owner, crash_ts, why):
    try:
        if not owner:
            return
        cands = []
        for _o in (owner, _canon_pid(owner)):
            if _o and _o not in cands:
                cands.append(_o)
        now_ms = int(time.time() * 1000)
        try: cts = int(crash_ts) if crash_ts is not None else now_ms
        except Exception: cts = now_ms
        for _ow in cands:
            with _B10_PASSIVE_LOCK:
                arr = list(_B10_PASSIVE_RECENT_SKIPS.get(_ow) or [])
            for it in arr:
                try: ts = int(it.get("ts") or 0)
                except Exception: ts = 0
                if ts and abs(cts - ts) <= _B10_PASSIVE_RECENT_WINDOW_MS:
                    _b10_passive_mark_force(_ow, it.get("method"), it.get("name"), why)
    except Exception:
        pass
_MD_VERDICT_FRESH_MS = 120000
_MD_RT_SO = (
    "libopenjdk.so", "libopenjdkjvm.so", "libart.so", "libandroid_runtime.so",
    "libsigchain.so", "libnativehelper.so",
)

def _b28_reg_hot_hook(pid, method, persist=False):
    try:
        if not pid or not method:
            return False
        try:
            pid = _canon_pid(pid)
        except Exception:
            pass
        if not isinstance(pid, str) or not pid:
            return False
        if pid == _SELF_ID or pid == __id__:
            return False
        if method not in _B28_HOT_METHODS:
            return False
        changed = False
        with _B28_HOOK_REG_LOCK:
            arr = _B28_HOOK_REG.get(pid)
            if arr is None:
                arr = []
                _B28_HOOK_REG[pid] = arr
            if method not in arr:
                arr.append(method)
                changed = True
        if changed:
            try:
                _log("Block#28: hot-hook registered owner=%r method=%s" % (pid, method))
            except Exception:
                pass
            if persist:
                try:
                    _b28_persist_hot_hook(pid, method)
                except Exception:
                    pass
        return True
    except Exception:
        return False
_GLOBALREF_HOOKS_NAME = "globalref_hooks.json"

def _b28_hooks_path():
    return _data_path(_GLOBALREF_HOOKS_NAME)

def _b28_persist_hot_hook(pid, method):
    p = _b28_hooks_path()
    if not p:
        return
    _PERSIST_IO_LOCK.acquire()
    try:
        cur = {}
        _rp = _rc_read_path(p)
        if _rp:
            try:
                with open(_rp, "r", encoding="utf-8") as f:
                    cur = dict(json.load(f))
            except Exception:
                cur = {}
        rec = cur.get(pid)
        if not isinstance(rec, dict):
            rec = {"methods": [], "ts": 0}
        methods = list(rec.get("methods") or [])
        if method not in methods:
            methods.append(method)
        rec["methods"] = methods
        rec["ts"] = int(time.time() * 1000)
        cur[pid] = rec
        _atomic_json_write(p, cur)
    except Exception:
        pass
    finally:
        try: _PERSIST_IO_LOCK.release()
        except Exception: pass

def _b28_load_persisted_hooks():
    p = _b28_hooks_path()
    try:
        _rp = _rc_read_path(p) if p else None
        if _rp:
            with open(_rp, "r", encoding="utf-8") as f:
                return dict(json.load(f))
    except Exception:
        pass
    return {}

def _b28_installed_pids():
    out = set()
    try:
        for e in _b11_plugin_entries():
            try:
                k = _safe_str(e.getKey())
                if k: out.add(k)
            except Exception: pass
    except Exception: pass
    try:
        out |= _installed_plugin_ids_fs()
    except Exception: pass
    return out

def _b28_prune_persisted_hooks():
    try:
        installed = _b28_installed_pids()
        if not installed: return
        cur = _b28_load_persisted_hooks() or {}
        if not cur: return
        pruned = {pid: rec for pid, rec in cur.items() if pid in installed}
        if len(pruned) == len(cur): return
        p = _b28_hooks_path()
        if not p: return
        _PERSIST_IO_LOCK.acquire()
        try:
            _atomic_json_write(p, pruned)
        finally:
            try: _PERSIST_IO_LOCK.release()
            except Exception: pass
        try: _log("Block#28: pruned %d ghost hot-hook owner(s) from globalref_hooks.json" % (len(cur) - len(pruned)))
        except Exception: pass
    except Exception:
        pass

def _b28_combined_hook_owners():
    out = {}
    try:
        with _B28_HOOK_REG_LOCK:
            for pid, methods in _B28_HOOK_REG.items():
                out.setdefault(pid, [])
                for m in (methods or []):
                    if m not in out[pid]:
                        out[pid].append(m)
    except Exception:
        pass
    try:
        for pid, rec in (_b28_load_persisted_hooks() or {}).items():
            ms = rec.get("methods") if isinstance(rec, dict) else rec
            out.setdefault(pid, [])
            for m in (ms or []):
                if m not in out[pid]:
                    out[pid].append(m)
    except Exception:
        pass
    try:
        _inst = _b28_installed_pids()
        if _inst:
            out = {pid: ms for pid, ms in out.items() if pid in _inst}
    except Exception:
        pass
    return out

_B28C_ON = True
_B28C_SAMPLE = 4
_B28C_PERSIST_MS = 3000
_B28C_MIN = 160
_B28C_DOMINANCE = 0.55
_B28C_UNTAG_AMBIENT = 0.90
_B28C_ABS_MIN_SHARE = 0.05
_GLOBALREF_PROXY_NAME = "globalref_proxy.json"
_B28C_COUNTS = {}
_B28C_LOCK = threading.Lock()
_GREF_READ_LOCK = threading.Lock()
_B28C_SEEN = 0
_B28C_LAST = int(time.time() * 1000)

def _b28c_proxy_path():
    return _data_path(_GLOBALREF_PROXY_NAME)

def _b28c_persist(counts, now):
    p = _b28c_proxy_path()
    if not p: return
    try:
        data = {}
        for pid, n in counts.items():
            if not pid or pid == _SELF_ID or pid == __id__: continue
            data[pid] = {"count": int(n), "ts": int(now)}
        _atomic_json_write(p, data)
    except Exception:
        pass

def _b28c_record(owner, weight=1):
    if not owner: return
    now = int(time.time() * 1000)
    due = False; snap = None
    with _B28C_LOCK:
        _B28C_COUNTS[owner] = _B28C_COUNTS.get(owner, 0) + int(weight)
        global _B28C_LAST
        if (now - _B28C_LAST) >= _B28C_PERSIST_MS:
            _B28C_LAST = now; due = True; snap = dict(_B28C_COUNTS)
    if due and snap is not None:
        _b28c_persist(snap, now)

_B28C_NATIVE_THREAD = None
_B28C_NATIVE_STOP = None
_B28C_LAST_GEN = None

def _b28c_native_flush(now=None):
    if not (_GREF_NATIVE_OK and _NLIB is not None): return False
    try:
        if not int(_NLIB.cd_gref_running()): return False
    except Exception:
        return False
    global _B28C_LAST_GEN
    gen = None
    try:
        gen = (int(_NLIB.cd_gref_total()),
               int(_NLIB.cd_gref_arm_generation()))
    except Exception:
        gen = None
    if gen is not None and gen == _B28C_LAST_GEN:
        return False
    try:
        n = int(_NLIB.cd_gref_tags())
    except Exception:
        n = 4096
    if n <= 0 or n > 65536: n = 4096
    try:
        arr = (ctypes.c_int64 * n)()
        m = int(_NLIB.cd_gref_snapshot(arr, ctypes.c_int32(n)))
    except Exception:
        return False
    counts = {}
    for idx in range(m):
        try: cnt = int(arr[idx])
        except Exception: continue
        if cnt <= 0: continue
        name = None
        try: name = _resolve_idx(idx)
        except Exception: name = None
        if not name:
            try: name = _resolve_idx_durable(idx)
            except Exception: name = None
        if not name or name == _SELF_ID or name == __id__: continue
        counts[name] = cnt
    if not counts:
        _B28C_LAST_GEN = gen
        return False
    _b28c_persist(counts, now if now is not None else int(time.time() * 1000))
    _B28C_LAST_GEN = gen
    return True

_B28P_ON = True
_B28P_TABLE_MAX_DEFAULT = 51200
_B28P_WARN_FRAC = 0.85
_B28P_COOLDOWN_MS = 600000
_B28P_LAST_VERDICT_MS = [0]
_B28P_LAST_LOG_MS = [0]

def _b28_gref_pressure_check(now=None):
    if not _B28P_ON: return False
    try:
        if not (globals().get("_GREF_LIVE_OK") and _GREF_NATIVE_OK and _NLIB is not None and ctypes is not None):
            return False
        try:
            if not int(_NLIB.cd_gref_running()): return False
        except Exception:
            return False
        live = 0
        try:
            _NLIB.cd_gref_live_total.restype = ctypes.c_int64
            live = int(_NLIB.cd_gref_live_total())
        except Exception:
            live = 0
        if live <= 0:
            live = int(_gref_live_sum())
        limit = _B28P_TABLE_MAX_DEFAULT
        if live < int(limit * _B28P_WARN_FRAC): return False
        ts = int(now if now is not None else time.time() * 1000)
        if ts - _B28P_LAST_LOG_MS[0] >= 60000:
            _B28P_LAST_LOG_MS[0] = ts
            _log("Block#28P WARN: давление global-ref %d/%d (%.0f%%) -- переполнение и SIGABRT близко" % (live, limit, 100.0 * live / max(1, limit)))
        if ts - _B28P_LAST_VERDICT_MS[0] < _B28P_COOLDOWN_MS: return False
        owner, om = _b28_live_producer()
        if not owner:
            try: owner, om = _b28_proxy_producer()
            except Exception: owner, om = (None, None)
        if not owner:
            try: owner, om = _b28_proxy_top2()
            except Exception: owner, om = (None, None)
        if not owner:
            try:
                _pxc = _ta_proxy_census()
                if _pxc and _pxc.get("culprit") and float(_pxc.get("share") or 0.0) >= 0.6:
                    owner, om = _pxc["culprit"], "py-proxy-census"
                    _log("Block#28P +TD(4): владелец по переписи прокси: %r (%d объектов, доля %.0f%%)" % (owner, int(_pxc.get("count") or 0), 100.0 * float(_pxc.get("share") or 0.0)))
            except Exception:
                pass
        multi = bool(owner and "|" in str(owner))
        conf = "high" if (owner and om == "proxy-producer-live") else ("medium" if owner else "low")
        culprit = owner or globals().get("_UNTAGGED_LABEL", "неизвестный плагин")
        rec = {
            "had_globalref_overflow": False,
            "pre_abort": True,
            "culprit": culprit,
            "culprit_kind": (("plugin-multi:%s" % owner) if multi else ("plugin:%s" % owner)) if owner else "untagged",
            "suspects": (str(owner).split("|") if multi else None),
            "confidence": conf,
            "kind": "jni-globalref-pressure",
            "src": "gref-pressure/pre-abort",
            "sig": "pressure:%s" % (owner or "untagged"),
            "reason": ("таблица JNI global-ref заполнена: %d из %d (порог 85%%) -- переполнение вызовет SIGABRT (ART); пред-смертный вердикт по live-карте владения" % (live, limit)),
            "where": "Chaquopy dynamic_proxy / JNI NewGlobalRef",
            "exc_cls": "JniGlobalRefTablePressure",
            "exc_msg": "global reference table at %d/%d (pre-abort)" % (live, limit),
            "max": None,
            "table_max": limit,
            "live_total": live,
            "dominant_type": None,
            "dominant_count": None,
            "dominant_share": None,
            "is_proxy_object": True,
            "hot_method": None,
            "hook_owner": owner,
            "hook_method": None,
            "hook_match": om,
            "hook_meta": {"n": 0, "status": om or "pressure-unattributed"},
            "ts": ts,
            "event_ts": ts,
            "age_ms": 0,
            "stale_echo": False,
        }
        try:
            _b28_write_verdict(rec)
        except Exception as e:
            _log("Block#28P: ошибка записи пред-смертного вердикта: %s" % e)
            return False
        _B28P_LAST_VERDICT_MS[0] = ts
        _log("Block#28P: пред-смертный вердикт записан: %r conf=%s live=%d/%d src=%s" % (culprit, conf, live, limit, om or "?"))
        return True
    except Exception:
        return False

def _b28c_native_loop(stop_evt):
    while not stop_evt.is_set():
        wrote = False
        try: wrote = bool(_b28c_native_flush())
        except Exception: wrote = False
        if wrote:
            try: _b28_reattribute_untagged()
            except Exception: pass
        try: _b28_gref_pressure_check()
        except Exception: pass
        try: stop_evt.wait(max(0.5, _B28C_PERSIST_MS / 1000.0))
        except Exception: time.sleep(3.0)

def _b28c_start_native_flush():
    global _B28C_NATIVE_THREAD, _B28C_NATIVE_STOP
    if _B28C_NATIVE_THREAD is not None: return False
    if not (_GREF_NATIVE_OK and _NLIB is not None): return False
    try:
        _B28C_NATIVE_STOP = threading.Event()
        t = threading.Thread(target=_b28c_native_loop, args=(_B28C_NATIVE_STOP,), name="CulpritGrefFlush", daemon=True)
        t.start()
        _B28C_NATIVE_THREAD = t
        return True
    except Exception:
        return False

_B28_HOOK_HITS = {}
_B28_HOOK_HITS_LOCK = threading.Lock()
_B28_HITS_LAST = 0
_B28_HITS_PERSIST_MS = 3000
_B28_HITS_NAME = "globalref_hits.json"
def _b28_hits_path():
    return _data_path(_B28_HITS_NAME)
def _b28_persist_hits(snap, now):
    p = _b28_hits_path()
    if not p: return
    try:
        data = {}
        for pid, methods in snap.items():
            if not pid or pid == _SELF_ID or pid == __id__: continue
            data[pid] = {"methods": {k: int(v) for k, v in methods.items()}, "ts": int(now)}
        _atomic_json_write(p, data)
    except Exception:
        pass
def _b28_hit(pid, method):
    if not pid or not method: return
    if pid == _SELF_ID or pid == __id__: return
    now = int(time.time() * 1000)
    due = False; snap = None
    global _B28_HITS_LAST
    with _B28_HOOK_HITS_LOCK:
        d = _B28_HOOK_HITS.get(pid)
        if d is None:
            d = {}; _B28_HOOK_HITS[pid] = d
        d[method] = d.get(method, 0) + 1
        if (now - _B28_HITS_LAST) >= _B28_HITS_PERSIST_MS:
            _B28_HITS_LAST = now; due = True
            snap = {p: dict(m) for p, m in _B28_HOOK_HITS.items()}
    if due and snap is not None:
        try: _b28_persist_hits(snap, now)
        except Exception: pass
def _b28_load_hits():
    p = _b28_hits_path()
    try:
        _rp = _rc_read_path(p) if p else None
        if _rp:
            with open(_rp, "r", encoding="utf-8") as f:
                return dict(json.load(f))
    except Exception:
        pass
    return {}
def _b28_hit_winner(method, candidates, ref_ts=None, max_age_ms=None, dominance=0.8):
    if not method: return None
    cset = set(candidates or [])
    mem = {}; disk = {}
    try:
        with _B28_HOOK_HITS_LOCK:
            for pid, m in _B28_HOOK_HITS.items():
                if cset and pid not in cset: continue
                c = int((m or {}).get(method, 0))
                if c > 0: mem[pid] = c
    except Exception:
        pass
    try:
        for pid, rec in (_b28_load_hits() or {}).items():
            if cset and pid not in cset: continue
            if ref_ts is not None and max_age_ms is not None and isinstance(rec, dict):
                try:
                    ts = int(rec.get("ts") or 0)
                    if ts and abs(ts - int(ref_ts)) > int(max_age_ms): continue
                except Exception:
                    pass
            ms = rec.get("methods") if isinstance(rec, dict) else rec
            c = int((ms or {}).get(method, 0))
            if c > 0: disk[pid] = c
    except Exception:
        pass
    tally = {}
    for pid in (set(mem) | set(disk)):
        tally[pid] = max(mem.get(pid, 0), disk.get(pid, 0))
    if not tally: return None
    tot = sum(tally.values()) or 1
    best = max(tally, key=lambda k: tally[k])
    if tally[best] >= dominance * tot:
        return best
    return None

def _b28_proxy_producer(ref_ts=None, max_age_ms=None):
    try:
        p = _b28c_proxy_path()
        _rp = _rc_read_path(p) if p else None
        if not _rp: return None, None
        with open(_rp, "r", encoding="utf-8") as f:
            data = dict(json.load(f))
    except Exception:
        return None, None
    best = None; best_n = 0; total = 0
    for pid, rec in data.items():
        if not pid or pid == _SELF_ID or pid == __id__: continue
        try:
            n = int(rec.get("count") or 0) if isinstance(rec, dict) else int(rec or 0)
            ts = int(rec.get("ts") or 0) if isinstance(rec, dict) else 0
        except Exception:
            continue
        if ref_ts is not None and max_age_ms is not None and ts:
            if abs(ts - int(ref_ts)) > max_age_ms: continue
        total += n
        if n > best_n: best_n = n; best = pid
    if best and best_n >= _B28C_MIN and total > 0 and best_n >= total * _B28C_DOMINANCE:
        return best, "proxy-producer"
    return None, None

_B28P_TOP2_SHARE = 0.60

def _b28_live_producer():
    try:
        if not (globals().get("_GREF_LIVE_OK") and _GREF_NATIVE_OK and _NLIB is not None and ctypes is not None):
            return None, None
        try:
            if not int(_NLIB.cd_gref_running()): return None, None
        except Exception:
            return None, None
        try: overflow = int(_NLIB.cd_gref_overflow())
        except Exception: overflow = 0
        try: del_untracked = int(_NLIB.cd_gref_del_untracked())
        except Exception: del_untracked = 0
        try: creation_total = int(_NLIB.cd_gref_total())
        except Exception: creation_total = 0
        if overflow > 0 or (del_untracked >= _GREF_LIVE_DEGRADE_MIN and float(del_untracked) >= _GREF_LIVE_DEGRADE_FRAC * float(max(1, creation_total))):
            return None, None
        try: n = int(_NLIB.cd_gref_tags())
        except Exception: n = 0
        if n <= 0: return None, None
        arr = (ctypes.c_int64 * n)()
        mcount = int(_NLIB.cd_gref_live_snapshot(arr, ctypes.c_int32(n)))
        rows = []; total = 0
        i = 0
        while i < mcount and i < n:
            v = int(arr[i])
            if v > 0:
                nm = None
                try: nm = _resolve_idx(i)
                except Exception: nm = None
                if not nm:
                    try: nm = _resolve_idx_durable(i)
                    except Exception: nm = None
                if nm and nm != _SELF_ID and nm != __id__:
                    total += v
                    rows.append((v, nm))
            i += 1
        if total <= 0 or not rows: return None, None
        rows.sort(reverse=True)
        n1, p1 = rows[0]
        if n1 >= _B28C_MIN and float(n1) >= float(total) * _B28C_DOMINANCE:
            return p1, "proxy-producer-live"
        if len(rows) >= 2:
            n2, p2 = rows[1]
            if n1 >= _B28C_MIN and n2 >= _B28C_MIN and float(n1 + n2) >= float(total) * _B28P_TOP2_SHARE:
                return "%s|%s" % (p1, p2), "proxy-producer-live-top2"
    except Exception:
        pass
    return None, None

def _b28_proxy_top2(ref_ts=None, max_age_ms=None):
    try:
        p = _b28c_proxy_path()
        _rp = _rc_read_path(p) if p else None
        if not _rp: return None, None
        with open(_rp, "r", encoding="utf-8") as f:
            data = dict(json.load(f))
    except Exception:
        return None, None
    rows = []; total = 0
    for pid, rec in data.items():
        if not pid or pid == _SELF_ID or pid == __id__: continue
        try:
            n = int(rec.get("count") or 0) if isinstance(rec, dict) else int(rec or 0)
            ts = int(rec.get("ts") or 0) if isinstance(rec, dict) else 0
        except Exception:
            continue
        if ref_ts is not None and max_age_ms is not None and ts:
            if abs(ts - int(ref_ts)) > max_age_ms: continue
        total += n
        if n > 0: rows.append((n, pid))
    if total <= 0 or len(rows) < 2: return None, None
    rows.sort(reverse=True)
    n1, p1 = rows[0]; n2, p2 = rows[1]
    if n1 < _B28C_MIN or n2 < _B28C_MIN: return None, None
    if float(n1) >= float(total) * _B28C_DOMINANCE: return None, None
    if float(n1 + n2) >= float(total) * _B28P_TOP2_SHARE:
        return "%s|%s" % (p1, p2), "proxy-producer-top2"
    return None, None

class _ProxyCreateHook(MethodHook):
    def after_hooked_method(self, param):
        try:
            if not _B28C_ON: return
            try:
                if param.getThrowable() is not None: return
            except Exception: pass
            global _B28C_SEEN
            _B28C_SEEN += 1
            if (_B28C_SEEN % _B28C_SAMPLE) != 0: return
            owner = None
            try: owner = _direct_pid_now()
            except Exception: owner = None
            if not owner:
                try: owner = _b27_owner_now()
                except Exception: owner = None
            if not owner or owner == _SELF_ID: return
            _b28c_record(owner, _B28C_SAMPLE)
        except Exception: pass

_B28_BRIDGE_TOKENS = (
    "LSPHooker_", "PyMethodHook", "HookCallbackDispatcher", "XposedBridge",
    "Proxy_Object", "chaquopy", "PyObject", "Reflector", "HookInfo",
    "afterHookedMethod", "beforeHookedMethod",
)

_B28_JNISIG_RE = re.compile(r"^L([\w/$]+);$")
_B28_SUMMARY_RE = re.compile(r"^\s*(\d+)\s+of\s+(\S+)")
_B28_MAX_RE = re.compile(r"max\s*=\s*(\d+)")
_B28_FRAME_RE = re.compile(r"([\w$.]+)\.([\w$<>]+)\s*[\(:]")
_B28_ENTRY_RE = re.compile(r"^\d+:")
_B28_PREFIX_RE = re.compile(r"^\s*\d\d-\d\d \d\d:\d\d:\d\d\.\d+\s+\d+\s+\d+\s+\w\s+[^:]*:\s?(.*)$")
_B28_DEBUG_RE = re.compile(r"\bDEBUG\b[^:]*:\s?")

def _globalref_path():
    return _data_path(_GLOBALREF_FILE_NAME)

def _b28_seen_path():
    return _data_path(_GLOBALREF_SEEN_NAME)

def _b28_load_seen():
    p = _b28_seen_path()
    try:
        _rp = _rc_read_path(p) if p else None
        if _rp:
            with open(_rp, "r", encoding="utf-8") as f:
                return list(json.load(f))
    except Exception:
        pass
    return []

def _b28_save_seen(sigs):
    p = _b28_seen_path()
    if not p: return
    try:
        _atomic_json_write(p, list(sigs)[-_GLOBALREF_SEEN_MAX:], _GLOBALREF_SEEN_MAX)
    except Exception:
        pass

def _b28_strip_prefix(line):
    try:
        m = _B28_DEBUG_RE.search(line)
        if m: return line[m.end():]
        m2 = _B28_PREFIX_RE.match(line)
        if m2: return m2.group(1)
    except Exception:
        pass
    return line

_B28_LOGCAT_TAIL = 8000

_B28_READ_FILTER_ON = True
_B28_MIN_LEVEL = "V"
_B28_KEEP_RE_ERE = "global reference|FATAL EXCEPTION|abort message|signal [0-9]|tombstone|>>> |DEBUG|art::|JNI (DETECTED|ERROR)|ReferenceTable|ANR in"


_B28_LEVELS = ("V", "D", "I", "W", "E")
_B28_NLIB_WARN = False

def _b28_apply_settings(plugin):
    global _B28_READ_FILTER_ON, _B28_MIN_LEVEL, _B28_KEEP_RE_ERE
    try:
        _B28_READ_FILTER_ON = bool(plugin.get_setting("b28_filter_on", True))
    except Exception:
        pass
    try:
        _i = int(plugin.get_setting("b28_min_level", 0) or 0)
        if 0 <= _i < len(_B28_LEVELS):
            _B28_MIN_LEVEL = _B28_LEVELS[_i]
    except Exception:
        pass
    try:
        _rx = plugin.get_setting("b28_keep_re", None)
        if _rx is not None:
            _B28_KEEP_RE_ERE = str(_rx)
    except Exception:
        pass

def _b28_read_logcat(prefilter=True):
    out = []
    global _B28_NLIB_WARN
    try:
        _ok = (_NLIB is not None and hasattr(_NLIB, "cd_logcat_read_filtered"))
    except Exception:
        _ok = False
    if not _ok:
        if not _B28_NLIB_WARN:
            _B28_NLIB_WARN = True
            try: _log("Block#28: native logcat недоступен (_NLIB=None или нет cd_logcat_read_filtered) -- дальнейшие попытки пропускаются тихо")
            except Exception: pass
        return out
    lvl = (_B28_MIN_LEVEL if (prefilter and _B28_READ_FILTER_ON) else "V")
    rx  = (_B28_KEEP_RE_ERE if (prefilter and _B28_READ_FILTER_ON) else "")
    cap = 3 * 1024 * 1024
    try:
        bufp = ctypes.create_string_buffer(cap)
    except Exception as e:
        try: _log("Block#28: logcat out-buf alloc err: %s" % e)
        except Exception: pass
        return out
    for buf in ("crash", "main"):
        try:
            n = int(_NLIB.cd_logcat_read_filtered(
                buf.encode("utf-8"), lvl.encode("ascii"), rx.encode("utf-8"),
                ctypes.c_int32(int(_B28_LOGCAT_TAIL)), bufp, ctypes.c_int32(cap)))
        except Exception as e:
            try: _log("Block#28: native logcat(%s) err: %s" % (buf, e))
            except Exception: pass
            continue
        if n > 0:
            try: out.append(bufp.value.decode("utf-8", "replace"))
            except Exception: pass
        elif n < 0:
            try: _log("Block#28: native logcat(%s) rc=%d" % (buf, n))
            except Exception: pass
    if not out:
        try: _log("Block#28: logcat пуст (crash+main) -- abort-message дамп недоступен")
        except Exception: pass
    return out

def _b28_read_drop_files():
    texts = []
    try:
        import glob as _glob
        gref_dump = os.path.join(_DIR, _GLOBALREF_DUMP_NAME)
        cands = [gref_dump]
        try:
            cands += _glob.glob(os.path.join(_DIR, "crash*.txt"))
            cands += _glob.glob(os.path.join(_DIR, "tombstone*"))
        except Exception:
            pass
        seen_p = set()
        for p in cands:
            if p in seen_p: continue
            seen_p.add(p)
            try:
                if not os.path.exists(p):
                    continue
                if os.path.getsize(p) > 15 * 1024 * 1024:
                    continue
                if p == gref_dump:
                    _rp = p + ".processing"
                    try:
                        os.rename(p, _rp)
                    except Exception:
                        continue
                    _hit = False
                    try:
                        with open(_rp, "r", encoding="utf-8", errors="replace") as f:
                            raw = f.read()
                        if _B28_OVERFLOW_MARK in raw:
                            texts.append(raw); _hit = True
                    except Exception:
                        pass
                    try:
                        if _hit: os.remove(_rp)
                        elif not os.path.exists(p): os.rename(_rp, p)
                        else: os.remove(_rp)
                    except Exception:
                        pass
                else:
                    with open(p, "r", encoding="utf-8", errors="replace") as f:
                        raw = f.read()
                    if _B28_OVERFLOW_MARK in raw:
                        texts.append(raw)
            except Exception:
                pass
    except Exception:
        pass
    return texts

def _b28_logcat_event_ts(line, ref_ts=None):
    try:
        m = _B28_TS_RE.match(line or "")
        if not m: return None
        mo, da, hh, mm, ss = (int(m.group(i)) for i in range(1, 6))
        frac = int((m.group(6) + "000")[:3])
        if ref_ts is not None:
            try:
                ref = int(ref_ts) / 1000.0
                base_yr = time.localtime(ref).tm_year
                best = None
                for _y in (base_yr - 1, base_yr, base_yr + 1):
                    try: _ep = time.mktime(time.struct_time((_y, mo, da, hh, mm, ss, 0, 0, -1)))
                    except Exception: continue
                    if best is None or abs(_ep - ref) < abs(best - ref):
                        best = _ep
                if best is not None:
                    return int(best * 1000 + frac)
            except Exception:
                pass
        yr = time.localtime().tm_year
        epoch = time.mktime(time.struct_time((yr, mo, da, hh, mm, ss, 0, 0, -1)))
        if epoch - time.time() > 2 * 86400:
            epoch = time.mktime(time.struct_time((yr - 1, mo, da, hh, mm, ss, 0, 0, -1)))
        return int(epoch * 1000 + frac)
    except Exception:
        return None

def _b28_extract_overflow_block(text):
    if not text or _B28_OVERFLOW_MARK not in text:
        return None, None
    lines = text.splitlines()
    idx = None
    for i in range(len(lines) - 1, -1, -1):
        if _B28_OVERFLOW_MARK in lines[i]:
            idx = i; break
    if idx is None: return None, None
    ev_ts = _b28_logcat_event_ts(lines[idx])
    start = max(0, idx - 2)
    end = min(len(lines), idx + 400)
    return "\n".join(lines[start:end]), ev_ts

def _b28_norm_type(t):
    if not t: return t
    t = t.strip().rstrip(",")
    m = _B28_JNISIG_RE.match(t)
    if m:
        return m.group(1).replace("/", ".")
    return t

def _b28_parse_dump(block):
    res = {"max": None, "types": {}, "alloc_frames": [], "entry_types": {}}
    m = _B28_MAX_RE.search(block)
    if m:
        try: res["max"] = int(m.group(1))
        except Exception: pass
    in_alloc = False
    for raw in block.splitlines():
        s = _b28_strip_prefix(raw).strip()
        if not s:
            in_alloc = False
            continue
        if "Allocated at" in s:
            in_alloc = True
            continue
        ms = _B28_SUMMARY_RE.match(s)
        if ms:
            in_alloc = False
            try:
                cnt = int(ms.group(1)); typ = _b28_norm_type(ms.group(2))
                if typ and ("." in typ):
                    res["types"][typ] = res["types"].get(typ, 0) + cnt
            except Exception:
                pass
            continue
        if _B28_ENTRY_RE.match(s):
            in_alloc = False
            toks = s.split()
            tail = toks[-1] if toks else ""
            typ = _b28_norm_type(tail)
            if typ and ("." in typ):
                res["entry_types"][typ] = res["entry_types"].get(typ, 0) + 1
            continue
        if in_alloc:
            fm = _B28_FRAME_RE.search(s)
            if fm:
                res["alloc_frames"].append("%s.%s" % (fm.group(1), fm.group(2)))
    if res["max"] is None and not res["types"] and not res["alloc_frames"]:
        try: _log("Block#28: parse_dump не распознал дамп (max/types/frames пусты) -- формат изменился?")
        except Exception: pass
    return res

def _b28_dominant_type(parsed):
    types = dict(parsed.get("types") or {})
    if not types:
        types = dict(parsed.get("entry_types") or {})
    if not types:
        return None, 0, 0.0
    total = sum(types.values()) or 1
    dom = max(types.items(), key=lambda kv: kv[1])
    return dom[0], dom[1], float(dom[1]) / float(total)

def _b28_hot_method(parsed):
    frames = parsed.get("alloc_frames") or []
    counts = {}
    for fr in frames:
        mth = fr.rsplit(".", 1)[-1]
        for hm in _B28_HOT_METHODS:
            if mth == hm:
                counts[hm] = counts.get(hm, 0) + 1
    if counts:
        return max(counts.items(), key=lambda kv: kv[1])[0], frames
    for fr in frames:
        if any(tok in fr for tok in _B28_BRIDGE_TOKENS):
            continue
        return fr.rsplit(".", 1)[-1], frames
    return None, frames

def _b28_attribute(parsed, hot_method, event_ts=None):
    owner = None; hook_method = None; hook_match = None; meta = {}
    try:
        frames = list(parsed.get("alloc_frames") or [])
        if hot_method:
            frames = ["LSPHooker_.%s" % hot_method] + frames
        owner, hook_method, hook_match, meta = _hook_owner_for_frames(frames)
    except Exception as e:
        try: _log("Block#28 attribute err: %s" % e)
        except Exception: pass
    if owner is None and hot_method:
        try:
            _rt_cands = []
            for pid, methods in _b28_combined_hook_owners().items():
                if not pid or pid == _SELF_ID or pid == __id__:
                    continue
                if hot_method in methods and pid not in _rt_cands:
                    _rt_cands.append(pid)
            if len(_rt_cands) == 1:
                owner = _rt_cands[0]
                hook_method = hot_method
                hook_match = "reg_time"
                meta = {"n": 0, "status": "reg-time"}
                _log("Block#28 attribution via reg-time: %r -> %s" % (owner, hot_method))
            elif len(_rt_cands) > 1:
                _hw = _b28_hit_winner(hot_method, _rt_cands)
                if _hw:
                    owner = _hw
                    hook_method = hot_method
                    hook_match = "reg-time-hits"
                    meta = {"n": 0, "status": "reg-time-hits", "candidates": _rt_cands}
                    _log("Block#28 attribution via live hot-hook hits: %r -> %s (broke reg-time-multi of %d)" % (owner, hot_method, len(_rt_cands)))
                else:
                    hook_match = "reg-time-multi"
                    meta = {"n": 0, "status": "reg-time-multi", "candidates": _rt_cands}
                    _log("Block#28 reg-time ambiguous (%d owners hooked %s): %r" % (len(_rt_cands), hot_method, _rt_cands))
        except Exception:
            pass
    if owner is None:
        try:
            persisted = _b28_load_persisted_hooks()
            _inst = _b28_installed_pids()
            cand = []
            for pid, rec in (persisted or {}).items():
                if not pid or pid == _SELF_ID or pid == __id__:
                    continue
                if _inst and pid not in _inst:
                    continue
                ms = rec.get("methods") if isinstance(rec, dict) else rec
                ms = [m for m in (ms or []) if m in _B28_HOT_METHODS]
                if ms:
                    ts = int(rec.get("ts") or 0) if isinstance(rec, dict) else 0
                    cand.append((pid, ms, ts))
            if cand:
                cand.sort(key=lambda c: c[2], reverse=True)
                owner = cand[0][0]
                hook_method = hot_method if (hot_method in cand[0][1]) else cand[0][1][0]
                if len(cand) == 1:
                    hook_match = "reg-persist"
                    meta = {"n": 0, "status": "reg-persist"}
                else:
                    hook_match = "reg-persist-multi"
                    meta = {"n": 0, "status": "reg-persist-multi", "candidates": [c[0] for c in cand]}
                _log("Block#28 attribution via persisted reg (%s): %r -> %s" % (hook_match, owner, hook_method))
        except Exception:
            pass
    if owner is None:
        try:
            lp, _lm = _b28_live_producer()
            if lp:
                owner = lp; hook_method = None; hook_match = _lm
                meta = {"n": 0, "status": _lm}
                if "|" in str(lp): meta["candidates"] = str(lp).split("|")
                _log("Block#28 attribution via live ownership map: %r (%s)" % (owner, _lm))
        except Exception:
            pass
    if owner is None:
        try:
            pp, _pb = _b28_proxy_producer()
            if pp:
                owner = pp; hook_method = None; hook_match = "proxy-producer"
                meta = {"n": 0, "status": "proxy-producer"}
                _log("Block#28 attribution via proxy-producer: %r" % owner)
        except Exception:
            pass
    if owner is None:
        try:
            tp, _tm = _b28_proxy_top2()
            if tp:
                owner = tp; hook_method = None; hook_match = _tm
                meta = {"n": 0, "status": _tm, "candidates": str(tp).split("|")}
                _log("Block#28 attribution via top-2 producers: %r" % tp)
        except Exception:
            pass
    if owner is None:
        try:
            c_owner, c_basis = _b28_correlate_owner(ref_ts=event_ts or int(time.time() * 1000), max_age_ms=1800000)
            if c_owner:
                owner = c_owner
                hook_method = None
                hook_match = "correlate-%s" % c_basis
                meta = {"n": 0, "status": hook_match, "basis": c_basis}
                _log("Block#28 attribution via correlation (%s): %r" % (hook_match, owner))
        except Exception:
            pass
    return owner, hook_method, hook_match, meta

def _b28_correlate_owner(ref_ts=None, max_age_ms=None):
    try:
        p = _leak_verdict_path()
        _rp = _rc_read_path(p) if p else None
        if not _rp:
            return None, None
        with open(_rp, "r", encoding="utf-8") as f:
            recs = list(json.load(f))
        owners = []
        views_by_owner = {}
        for r in recs:
            if not isinstance(r, dict):
                continue
            c = r.get("culprit"); conf = r.get("confidence")
            if not (c and c != _UNTAGGED_LABEL and c != _SELF_ID and c != __id__
                    and conf in ("high", "medium")):
                continue
            if ref_ts is not None and max_age_ms is not None:
                try:
                    lt = int(r.get("ts") or 0)
                    if lt and abs(lt - int(ref_ts)) > max_age_ms:
                        continue
                except Exception:
                    pass
            if c not in owners:
                owners.append(c)
            try:
                _v = int(r.get("leaked_views") or 0)
            except Exception:
                _v = 0
            if _v <= 0: _v = 1
            views_by_owner[c] = views_by_owner.get(c, 0) + _v
        if len(owners) == 1:
            return owners[0], "view-leak"
        if len(owners) > 1:
            try:
                _tot = sum(views_by_owner.values())
                if _tot > 0:
                    _dom = max(views_by_owner, key=lambda k: views_by_owner[k])
                    if views_by_owner[_dom] >= 0.8 * _tot:
                        return _dom, "view-leak-dominant"
            except Exception:
                pass
    except Exception:
        pass
    return None, None

def _b28_reattribute_untagged():
    _PERSIST_IO_LOCK.acquire()
    try:
        try:
            p = _globalref_path()
            _rp = _rc_read_path(p) if p else None
            if not _rp:
                return
            with open(_rp, "r", encoding="utf-8") as f:
                recs = list(json.load(f))
        except Exception:
            return
        changed = False
        for rec in recs:
            try:
                if not isinstance(rec, dict):
                    continue
                if rec.get("kind") != "jni-globalref-leak":
                    continue
                if rec.get("culprit_kind") != "untagged":
                    continue
                owner = None; basis = None
                try:
                    rec_hm = rec.get("hot_method")
                    cand = []
                    for pid, rr in (_b28_load_persisted_hooks() or {}).items():
                        if not pid or pid == _SELF_ID or pid == __id__:
                            continue
                        ms = rr.get("methods") if isinstance(rr, dict) else rr
                        ms = [m for m in (ms or []) if m in _B28_HOT_METHODS]
                        if rec_hm:
                            if rec_hm in ms:
                                ts = int(rr.get("ts") or 0) if isinstance(rr, dict) else 0
                                cand.append((pid, [rec_hm], ts))
                        elif ms:
                            ts = int(rr.get("ts") or 0) if isinstance(rr, dict) else 0
                            cand.append((pid, ms, ts))
                    if cand:
                        if rec_hm and len(cand) > 1:
                            _hw = _b28_hit_winner(rec_hm, [c[0] for c in cand], ref_ts=rec.get("ts"), max_age_ms=1800000)
                            if _hw:
                                owner = _hw
                                basis = "reg-hits"
                                rec["hook_method"] = rec_hm
                        elif rec_hm or len(cand) == 1:
                            cand.sort(key=lambda c: c[2], reverse=True)
                            owner = cand[0][0]
                            basis = "reg-persist" if rec_hm else "reg-persist-uniq"
                            rec["hook_method"] = cand[0][1][0]
                except Exception:
                    pass
                if owner is None:
                    pp, _pb = _b28_proxy_producer(ref_ts=rec.get("ts"), max_age_ms=1800000)
                    if pp:
                        owner = pp; basis = "proxy-producer"
                if owner is None:
                    c_owner, c_basis = _b28_correlate_owner(ref_ts=rec.get("ts"), max_age_ms=1800000)
                    if c_owner:
                        owner = c_owner; basis = "correlate-%s" % c_basis
                if owner is None:
                    tp, _tb = _b28_proxy_top2(ref_ts=rec.get("ts"), max_age_ms=1800000)
                    if tp:
                        owner = tp; basis = _tb
                if not owner:
                    continue
                _multi = "|" in str(owner)
                rec["culprit"] = owner
                rec["culprit_kind"] = ("plugin-multi:%s" % owner) if _multi else ("plugin:%s" % owner)
                rec["suspects"] = str(owner).split("|") if _multi else None
                rec["hook_owner"] = owner
                rec["hook_match"] = basis
                if rec.get("confidence") == "low":
                    rec["confidence"] = "medium"
                if basis == "proxy-producer":
                    rec["confidence"] = "high"
                    rec["reason"] = ("плагин создаёт/удерживает множество JNI global-ref без освобождения (мост Chaquopy Java<->Python: dynamic_proxy и/или Class/PyObject-ссылки) -> таблица global-ссылок переполнилась (max=%s), ART аварийно завершил процесс [виновник определён прямым нативным трекером создания JNI global-ref (NewGlobalRef)]" % rec.get("max"))
                    rec["where"] = "мост Chaquopy (JNI NewGlobalRef)"
                elif basis == "proxy-producer-top2":
                    rec["reason"] = ("плагин создаёт множество Chaquopy dynamic_proxy объектов (Java<->Python колбэки), каждый удерживает JNI global-ref без освобождения -> таблица global-ссылок переполнилась (max=%s), ART аварийно завершил процесс [ни один продюсер не доминирует; названы два главных подозреваемых, вместе покрывающих большинство созданий]" % rec.get("max"))
                    rec["where"] = "Chaquopy dynamic_proxy (Java<->Python колбэки)"
                elif str(basis).startswith("correlate"):
                    rec["reason"] = ("плагин создаёт множество Chaquopy dynamic_proxy объектов (Java<->Python колбэки), каждый удерживает JNI global-ref без освобождения -> таблица global-ссылок переполнилась (max=%s), ART аварийно завершил процесс [виновник по корреляции с одновременной утечкой того же плагина в этом краше]" % rec.get("max"))
                    rec["where"] = "Chaquopy dynamic_proxy (Java<->Python колбэки)"
                changed = True
                try: _log("Block#28 reattribute untagged -> %r (%s)" % (owner, basis))
                except Exception: pass
            except Exception:
                pass
        if changed:
            try: _atomic_json_write(p, recs, _GLOBALREF_FAILS_MAX)
            except Exception: pass
    finally:
        try: _PERSIST_IO_LOCK.release()
        except Exception: pass

def _b28_signature(parsed, dom_type):
    af = (parsed.get("alloc_frames") or [])
    first = af[0] if af else ""
    return "ovf|max=%s|%s|%s" % (parsed.get("max"), dom_type, first)

def _b28_build_verdict(block, event_ts=None):
    parsed = _b28_parse_dump(block)
    dom_type, dom_count, dom_share = _b28_dominant_type(parsed)
    hot_method, _ = _b28_hot_method(parsed)
    is_proxy = bool(dom_type and ("Proxy_Object" in dom_type or "plugins.Proxy" in dom_type))
    owner, hook_method, hook_match, meta = _b28_attribute(parsed, hot_method, event_ts)
    method_for_msg = hook_method or hot_method or "?"
    produced = bool(hook_match == "proxy-producer")
    multi = bool(owner and "|" in str(owner))
    if owner and not multi and (dom_share >= 0.8 or produced or hook_match == "proxy-producer-live"):
        conf = "high"
    elif owner:
        conf = "medium"
    elif dom_share >= 0.8:
        conf = "medium"
    else:
        conf = "low"
    if owner:
        culprit = owner
        culprit_kind = ("plugin-multi:%s" % owner) if multi else ("plugin:%s" % owner)
    elif hot_method:
        culprit = "хук на %s" % hot_method
        culprit_kind = "untagged"
    else:
        culprit = globals().get("_UNTAGGED_LABEL", "неизвестный плагин")
        culprit_kind = "untagged"
    share_pct = int(round(dom_share * 100))
    correlated = bool(hook_match and str(hook_match).startswith("correlate"))
    proxy_leak = bool(correlated or produced or is_proxy or (owner and not hook_method))
    if proxy_leak:
        reason = ("плагин создаёт множество Chaquopy dynamic_proxy объектов "
                  "(Java<->Python колбэки), каждый удерживает JNI global-ref без "
                  "освобождения -> таблица global-ссылок переполнилась (max=%s), "
                  "ART аварийно завершил процесс" % parsed.get("max"))
        where = "Chaquopy dynamic_proxy (Java<->Python колбэки)"
    elif hook_method or hot_method:
        reason = ("плагин хукнул горячий метод рендера %s и на каждый вызов "
                  "оставляет JNI global-ref (Chaquopy Proxy_Object) без DeleteGlobalRef "
                  "-> таблица global-ссылок переполнилась (max=%s), ART аварийно "
                  "завершил процесс" % (method_for_msg, parsed.get("max")))
        where = "%s (хук плагина, мост Chaquopy)" % method_for_msg
    else:
        reason = ("плагин удерживает JNI global-ref (Chaquopy Proxy_Object/Class) без "
                  "освобождения -> таблица global-ссылок переполнилась (max=%s), ART "
                  "аварийно завершил процесс" % parsed.get("max"))
        where = "мост Chaquopy (JNI NewGlobalRef)"
    if dom_type:
        reason += " — %d%% таблицы заняты %s" % (share_pct, dom_type.rsplit(".", 1)[-1])
    if correlated:
        reason += (" [виновник определён по корреляции с одновременной "
                   "утечкой того же плагина в этом краше]")
    elif produced:
        reason += " [виновник определён прямым трекером создания dynamic_proxy]"
    elif hook_match == "proxy-producer-live":
        reason += " [виновник определён по live-карте владения global-ref: текущие удержания, не кумулятив]"
    elif hook_match in ("proxy-producer-top2", "proxy-producer-live-top2"):
        reason += " [ни один продюсер не доминирует; названы два главных подозреваемых, вместе покрывающих большинство созданий]"
    rec = {
        "had_globalref_overflow": True,
        "culprit": culprit,
        "culprit_kind": culprit_kind,
        "confidence": conf,
        "kind": "jni-globalref-leak",
        "src": "globalref-dump",
        "reason": reason,
        "where": where,
        "exc_cls": "JniGlobalRefTableOverflow",
        "exc_msg": "global reference table overflow (max=%s)" % parsed.get("max"),
        "max": parsed.get("max"),
        "dominant_type": dom_type,
        "dominant_count": dom_count,
        "dominant_share": round(dom_share, 4),
        "is_proxy_object": is_proxy,
        "hot_method": hot_method,
        "hook_owner": owner,
        "hook_method": hook_method,
        "hook_match": hook_match,
        "hook_meta": meta,
        "suspects": (str(owner).split("|") if multi else None),
        "ts": int(time.time() * 1000),
        "event_ts": event_ts,
    }
    try:
        _ps = globals().get("_PROC_START_MS") or 0
        if event_ts and _ps:
            rec["age_ms"] = max(0, int(_ps) - int(event_ts))
            rec["stale_echo"] = bool((int(_ps) - int(event_ts)) > _B28_STALE_ECHO_MS)
        else:
            rec["age_ms"] = None; rec["stale_echo"] = False
    except Exception:
        rec["age_ms"] = None; rec["stale_echo"] = False
    return rec, parsed

def _b28_write_verdict(rec):
    _PERSIST_IO_LOCK.acquire()
    try:
        p = _globalref_path()
        if not p: return
        try:
            cur = []
            _rp = _rc_read_path(p)
            if _rp:
                try:
                    with open(_rp, "r", encoding="utf-8") as f: cur = list(json.load(f))
                except Exception: cur = []
            try:
                _sig = rec.get("sig"); _mx = rec.get("max"); _tagged = bool(rec.get("hook_owner"))
                def _keep(c):
                    if _sig and c.get("sig") == _sig: return False
                    if _tagged and c.get("kind") == rec.get("kind") and c.get("culprit_kind") == "untagged" and c.get("max") == _mx: return False
                    return True
                cur = [c for c in cur if _keep(c)]
            except Exception: pass
            cur.append(rec)
            _atomic_json_write(p, cur, _GLOBALREF_FAILS_MAX)
        except Exception:
            pass
        try:
            _log("============ JNI GLOBALREF-OVERFLOW VERDICT (Block#28) ============")
            _log("ВИНОВНИК УТЕЧКИ JNI-ССЫЛОК: %r conf=%s метод=%s тип=%s (%d%%)" % (
                rec.get("culprit"), rec.get("confidence"), rec.get("hot_method"),
                (rec.get("dominant_type") or "?").rsplit(".", 1)[-1],
                int(round((rec.get("dominant_share") or 0) * 100))))
            _log("  max=%s match4A=%s метод4A=%s" % (rec.get("max"), rec.get("hook_match"), rec.get("hook_method")))
            _log("  причина: %s" % rec.get("reason"))
            _log("==================================================================")
        except Exception:
            pass
    finally:
        try: _PERSIST_IO_LOCK.release()
        except Exception: pass

def _b28_prune_stale_verdicts():
    _PERSIST_IO_LOCK.acquire()
    try:
        try:
            p = _globalref_path()
            _rp = _rc_read_path(p) if p else None
            if not _rp: return
            with open(_rp, "r", encoding="utf-8") as f: recs = list(json.load(f))
        except Exception:
            return
        ps = globals().get("_PROC_START_MS") or 0
        keep = []; drop = []
        for rec in recs:
            try:
                if not isinstance(rec, dict) or rec.get("kind") != "jni-globalref-leak":
                    keep.append(rec); continue
                stale = bool(rec.get("stale_echo"))
                if not stale and ps:
                    base = rec.get("event_ts") or rec.get("ts")
                    if base and (int(ps) - int(base)) > _B28_STALE_ECHO_MS:
                        stale = True
                (drop if stale else keep).append(rec)
            except Exception:
                keep.append(rec)
        if not drop: return
        try: _atomic_json_write(p, keep, _GLOBALREF_FAILS_MAX)
        except Exception: pass
        try:
            hp = File(_DIR, "globalref_history.json").getAbsolutePath()
            hist = []
            _hrp = _rc_read_path(hp)
            if _hrp:
                try:
                    with open(_hrp, "r", encoding="utf-8") as f: hist = list(json.load(f))
                except Exception: hist = []
            hist += drop
            _atomic_json_write(hp, hist[-_GLOBALREF_SEEN_MAX:], _GLOBALREF_SEEN_MAX)
        except Exception: pass
    finally:
        try: _PERSIST_IO_LOCK.release()
        except Exception: pass

def _read_globalref_overflow(logcat=True):
    if not _BLOCK28_ON: return None
    _GREF_READ_LOCK.acquire()
    try:
        try: _b28_reattribute_untagged()
        except Exception: pass
        texts = []
        try: texts += _b28_read_drop_files()
        except Exception: pass
        if logcat:
            try: texts += _b28_read_logcat()
            except Exception: pass
        if not texts: return None
        seen = _b28_load_seen()
        new_sigs = list(seen)
        last_rec = None
        changed = False
        seen_changed = False
        for t in texts:
            block, ev_ts = _b28_extract_overflow_block(t)
            if not block: continue
            rec, parsed = _b28_build_verdict(block, event_ts=ev_ts)
            sig = _b28_signature(parsed, rec.get("dominant_type"))
            rec["sig"] = sig
            is_tagged = bool(rec.get("hook_owner"))
            tag_key = sig + "#tagged"
            ev_key = ("evt:%s:%s" % (sig, ev_ts)) if ev_ts else None
            if ev_key and ev_key in new_sigs:
                continue
            if rec.get("stale_echo"):
                try: _log("Block#28: старый logcat-эхо overflow (событие ~%.1f мин до старта) — подавлено, не текущая утечка" % ((rec.get("age_ms") or 0) / 60000.0))
                except Exception: pass
                if ev_key:
                    new_sigs.append(ev_key); seen_changed = True
                continue
            seen_sig = sig in new_sigs
            seen_tagged = tag_key in new_sigs
            if seen_sig and (not is_tagged or seen_tagged) and not ev_key:
                continue
            if seen_sig:
                rec["repeat"] = True
            if not seen_sig:
                new_sigs.append(sig); seen_changed = True
            if is_tagged and not seen_tagged:
                new_sigs.append(tag_key); seen_changed = True
            if ev_key and ev_key not in new_sigs:
                new_sigs.append(ev_key); seen_changed = True
            changed = True
            _b28_write_verdict(rec)
            last_rec = rec
        if changed or seen_changed:
            _b28_save_seen(new_sigs)
        try:
            _b28_prune_stale_verdicts()
        except Exception: pass
        return last_rec
    except Exception as e:
        try: _log("Block#28 read err: %s" % e)
        except Exception: pass
        return None
    finally:
        try: _GREF_READ_LOCK.release()
        except Exception: pass

def _b28_hot_hook_owners():
    out = {}
    try:
        omap, _, _ = _build_hook_owner_map()
        for key, owner in (omap or {}).items():
            if not owner:
                continue
            try:
                mth = str(key).rsplit(".", 1)[-1]
            except Exception:
                continue
            if mth in _B28_HOT_METHODS:
                out.setdefault(owner, [])
                if mth not in out[owner]:
                    out[owner].append(mth)
    except Exception:
        pass
    try:
        with _B28_HOOK_REG_LOCK:
            reg = dict(_B28_HOOK_REG)
        for owner, methods in reg.items():
            if not owner:
                continue
            out.setdefault(owner, [])
            for mth in methods or []:
                if mth in _B28_HOT_METHODS and mth not in out[owner]:
                    out[owner].append(mth)
    except Exception:
        pass
    return out

def _b28_warn_scan(tag="periodic"):
    if not (_BLOCK28_ON and _B28_WARN_ON): return
    try:
        owners = _b28_hot_hook_owners()
        for owner, methods in owners.items():
            key = "%s|%s" % (owner, ",".join(sorted(methods)))
            if key in _B28_WARNED: continue
            _B28_WARNED.add(key)
            _log("⚠ Block#28 РАННЕЕ ПРЕДУПРЕЖДЕНИЕ (%s): плагин %r держит хук на горячем "
                 "методе рендера %s — каждый вызов рискует оставить JNI global-ref "
                 "(Proxy_Object). При утечке таблица дойдёт до предела (~51200) и ART "
                 "аварийно завершит процесс." % (tag, owner, ", ".join(methods)))
    except Exception as e:
        try: _log("Block#28 warn-scan err: %s" % e)
        except Exception: pass

_HX_FLOOD_ON = True
_HX_FLOOD_NAME = "hook_exception_flood.json"
_HX_FLOOD_READ_RE = "Uncaught Exception|FATAL EXCEPTION|NoClassDefFoundError|ClassNotFoundException|XposedBridge|AndroidRuntime"
_HX_FLOOD_HDR_RE = re.compile(r"(Uncaught Exception|FATAL EXCEPTION)")
_HX_FLOOD_FRAME_RE = re.compile(r"\bat\s+([\w.$]+)\(")
_HX_FLOOD_EXCCLS_RE = re.compile(r"((?:[\w$]+\.)+[\w$]+(?:Error|Exception))")
_HX_FLOOD_SKIP_PKG = ("android.", "java.", "javax.", "kotlin.", "kotlinx.",
                      "dalvik.", "libcore.", "sun.", "com.android.",
                      "de.robv.android.xposed.", "org.telegram.")
_HX_FLOOD_MIN_RATE = 1.0
_HX_FLOOD_HI_RATE = 5.0
_HX_FLOOD_MIN_N = 8
_HX_FLOOD_WINDOW_MS = 90000
_HX_FLOOD_DEDUP_MS = 120000
_HX_FLOOD_SEEN = {}
_HX_FLOOD_CUM = {}
_HX_FLOOD_CUM_N = 24
_HX_FLOOD_CUM_WINDOW_MS = 300000

def _b28_read_logcat_re(ere, level="E", tail=6000):
    out = []
    try:
        if not (_NLIB is not None and hasattr(_NLIB, "cd_logcat_read_filtered")):
            return out
    except Exception:
        return out
    cap = 3 * 1024 * 1024
    try: bufp = ctypes.create_string_buffer(cap)
    except Exception: return out
    for buf in ("crash", "main"):
        try:
            n = int(_NLIB.cd_logcat_read_filtered(
                buf.encode("utf-8"), level.encode("ascii"), (ere or "").encode("utf-8"),
                ctypes.c_int32(int(tail)), bufp, ctypes.c_int32(cap)))
        except Exception:
            continue
        if n > 0:
            try: out.append(bufp.value.decode("utf-8", "replace"))
            except Exception: pass
    return out

def _hx_flood_attr_frame(frames):
    for fr in frames:
        if not fr: continue
        if any(fr.startswith(p) for p in _HX_FLOOD_SKIP_PKG): continue
        return fr.rsplit(".", 1)[0] if "." in fr else fr
    if frames:
        f0 = frames[0]
        return f0.rsplit(".", 1)[0] if "." in f0 else f0
    return None

def _hx_flood_path():
    return _data_path(_HX_FLOOD_NAME)

def _hx_flood_emit(attr, sig, n, rate, span_s, missing_class=None):
    now = int(time.time() * 1000)
    key = "%s|%s" % (attr, sig or "")
    if now - _HX_FLOOD_SEEN.get(key, 0) < _HX_FLOOD_DEDUP_MS: return
    _HX_FLOOD_SEEN[key] = now
    pkg = attr.rsplit(".", 1)[0] if (attr and "." in attr) else attr
    rec = {"had_flood": True, "event_type": "hook_exception_flood",
           "dropbox_tag": "app_hook_flood", "tombstone_norm_version": 1,
           "culprit": attr, "culprit_pkg": pkg, "culprit_kind": "hook",
           "src": "logcat/exteraHook", "where": "hook-dispatch",
           "confidence": ("high" if rate >= _HX_FLOOD_HI_RATE else "medium"),
           "exc_cls": sig or "Uncaught Exception", "count": int(n),
           "rate_per_s": round(rate, 2), "window_s": round(span_s, 1),
           "reason": ("hook %s throws %s in a loop (%.1f/s, %d in %.0fs) on the dispatch "
                      "thread -- silently burns CPU/battery and floods logcat; ANR/pyerr "
                      "do not catch it (Java hook exception, not Python)") % (pkg, (sig or "Uncaught Exception"), rate, n, span_s),
           "ts": now}
    if missing_class:
        rec["missing_class"] = missing_class
        _inc, _incconf = _hx_api_incompat(missing_class)
        if _inc:
            rec["event_type"] = "plugin_api_incompatible"
            rec["dropbox_tag"] = "plugin_api_incompatible"
            rec["api_incompatible"] = True
            rec["confidence"] = _incconf or rec.get("confidence")
            rec["reason"] = ("плагин %s собран под устаревший Telegram API: класс %s "
                            "не найден (удалён/переименован) -> плагин надо обновить; "
                            "хук зациклился (%.1f/с, %d за %.0fс), жжёт CPU/батарею и флудит logcat"
                            % (pkg, missing_class, rate, n, span_s))
            rec["fix_hint"] = "обнови/пересобери плагин под текущую версию exteraGram/Telegram"
    p = _hx_flood_path()
    if not p: return
    _PERSIST_IO_LOCK.acquire()
    try:
        cur = []
        if os.path.exists(p):
            try:
                with open(p, "r", encoding="utf-8") as f: cur = list(json.load(f))
            except Exception: cur = []
        cur.append(rec)
        _atomic_json_write(p, cur, 20)
        _log("+HX FLOOD: hook %r throws %s %.1f/s (n=%d span=%.0fs) -> %s" % (attr, (sig or "?"), rate, n, span_s, _HX_FLOOD_NAME))
    except Exception as e:
        try: _log("+HX flood persist err: %s" % e)
        except Exception: pass
    finally:
        try: _PERSIST_IO_LOCK.release()
        except Exception: pass

def _hx_flood_scan(tag="periodic"):
    if not (_BLOCK28_ON and _HX_FLOOD_ON): return
    try:
        texts = _b28_read_logcat_re(_HX_FLOOD_READ_RE, level="E", tail=6000)
    except Exception as e:
        try: _log("+HX flood: logcat read err: %s" % e)
        except Exception: pass
        return
    if not texts: return
    now = int(time.time() * 1000)
    cut = now - _HX_FLOOD_WINDOW_MS
    groups = {}
    for blob in texts:
        lines = blob.split("\n")
        N = len(lines); i = 0
        while i < N:
            ln = lines[i]
            if ("XposedBridge" in ln or "AndroidRuntime" in ln) and _HX_FLOOD_HDR_RE.search(ln):
                ets = _b28_logcat_event_ts(ln) or now
                frames = []; sig = None; missing = None; j = i + 1
                while j < N and j < i + 40:
                    fl = lines[j]
                    if _HX_FLOOD_HDR_RE.search(fl): break
                    m = _HX_FLOOD_FRAME_RE.search(fl)
                    if m: frames.append(m.group(1))
                    if sig is None:
                        me = _HX_FLOOD_EXCCLS_RE.search(fl)
                        if me: sig = me.group(1)
                    if missing is None:
                        _mm = _hx_extract_missing(fl)
                        if _mm: missing = _mm
                    j += 1
                if missing is None:
                    missing = _hx_extract_missing(ln)
                attr = _hx_flood_attr_frame(frames) or "unknown-hook"
                g = groups.get(attr)
                if g is None: g = groups[attr] = {"ts": [], "sig": sig, "missing": missing}
                if ets >= cut: g["ts"].append(ets)
                if g["sig"] is None and sig: g["sig"] = sig
                if g.get("missing") is None and missing: g["missing"] = missing
                i = j; continue
            i += 1
    for attr, g in groups.items():
        tss = sorted(g["ts"]); n = len(tss)
        cum = _HX_FLOOD_CUM.setdefault(attr, [])
        if tss: cum.extend(tss)
        cwin = now - _HX_FLOOD_CUM_WINDOW_MS
        cum[:] = sorted(x for x in cum if x >= cwin)
        cn = len(cum)
        span = ((tss[-1] - tss[0]) / 1000.0) if n >= 2 else 0.0
        rate = (n / span) if span > 0 else float(n)
        burst_ok = (n >= _HX_FLOOD_MIN_N and rate >= _HX_FLOOD_MIN_RATE)
        persist_ok = (cn >= _HX_FLOOD_CUM_N)
        if not (burst_ok or persist_ok): continue
        if burst_ok:
            _hx_flood_emit(attr, g.get("sig"), n, rate, span, g.get("missing"))
        else:
            cspan = ((cum[-1] - cum[0]) / 1000.0) if cn >= 2 else 0.0
            crate = (cn / cspan) if cspan > 0 else float(cn)
            _hx_flood_emit(attr, g.get("sig"), cn, crate, cspan, g.get("missing"))


def _b28_loop(stop):
    try: stop.wait(8.0)
    except Exception: pass
    while not stop.is_set():
        _gil_begin(_GIL_B28)
        try:
            _b28_warn_scan("periodic")
            try: _hx_flood_scan("periodic")
            except Exception: pass
        finally:
            _gil_end(_GIL_B28)
        try:
            if stop.wait(_B28_WARN_PERIOD_S): break
        except Exception: break

def _b28_start():
    global _B28_THREAD
    if not _BLOCK28_ON:
        _log("Block#28: отключён (_BLOCK28_ON=False)"); return
    if _B28_THREAD is not None:
        return
    if not _B28_WARN_ON:
        _log("Block#28: пост-мортем включён, раннее предупреждение выключено"); return
    _B28_STOP.clear()
    _B28_THREAD = threading.Thread(target=_b28_loop, args=(_B28_STOP,), name="culprit-b28", daemon=True)
    _B28_THREAD.start()
    _log("Block#28: JNI globalref-overflow детектор активен (пост-мортем logcat/дамп + раннее предупреждение по хукам: %s)" % (", ".join(_B28_HOT_METHODS)))

def _b28_stop():
    global _B28_THREAD
    try:
        _B28_STOP.set()
        t = _B28_THREAD
        if t is not None:
            try: t.join(timeout=2.0)
            except Exception: pass
        _B28_THREAD = None
        _log("Block#28: остановлен")
    except Exception:
        pass


_B20_ON = True
_B20_PING_MS = 2000
_B20_BEAT_MS = 1000
_B20_BEAT = None
_B20_BEAT_INFLIGHT = False
_B20_TIMEOUT_MS = 4500
_B20_IDLE_CPU_MAX = 25.0
_B20_SELFKILL_AFTERMATH_MS = 3000
_B20_STOP = threading.Event()
_B20_THREAD = None
_B20_UI_TID = None
_B20_HANDLER = None
_B20_PING = None
_B20_LOCK = threading.Lock()
_B20_MAX_PLAUSIBLE_MS = 15000
_B20_NATIVE = False

def _b20_anr_path():
    return _data_path(_ANR_FILE_NAME)

def _b20_ack():
    global _B20_UI_TID
    try:
        if _B20_UI_TID is None:
            _B20_UI_TID = int(threading.get_ident())
            _log("Block#20: UI thread tid=%s captured" % _B20_UI_TID)
            try:
                native_ui_tid = _cur_tid()
                globals()["_B33_UI_TID"] = native_ui_tid
                if globals().get("_SELF_NATIVE_OK") and _NLIB is not None and hasattr(_NLIB, "cd_self_set_ui_tid"):
                    _NLIB.cd_self_set_ui_tid(ctypes.c_int64(int(native_ui_tid)))
            except Exception as _e33:
                _log("Block#33: UI tid pass err: %s" % _e33)
        if _B20_NATIVE and _NLIB is not None:
            try: _NLIB.cd_anr_ack()
            except Exception: pass
    except Exception:
        pass

def _b20_setup_handler():
    global _B20_HANDLER, _B20_PING, _B20_BEAT
    try:
        from java import jclass as _jc, dynamic_proxy as _dp
    except Exception as e:
        _log("Block#20: java bridge unavailable: %r" % e); return False
    try:
        Looper = _jc("android.os.Looper")
        Handler = _jc("android.os.Handler")
        main = Looper.getMainLooper()
        if main is None:
            _log("Block#20: getMainLooper() is None"); return False
        if _B20_HANDLER is not None:
            try: _B20_HANDLER.removeCallbacksAndMessages(None)
            except Exception: pass
        _B20_HANDLER = Handler(main)
    except Exception as e:
        _log("Block#20: Handler(mainLooper) build err: %r" % e); return False
    try:
        if _B20_PING is None:
            Runnable = _jc("java.lang.Runnable")
            class _B20Ping(_dp(Runnable)):
                def run(self):
                    _b20_ack()
            _B20_PING = _B20Ping()
    except Exception as e:
        _log("Block#20: ping Runnable build err: %r" % e); return False
    try:
        if _B20_BEAT is None:
            Runnable = _jc("java.lang.Runnable")
            class _B20Beat(_dp(Runnable)):
                def run(self):
                    _b20_beat()
            _B20_BEAT = _B20Beat()
    except Exception as e:
        _log("Block#20: beat Runnable build err: %r" % e); _B20_BEAT = None
    return True

def _b20_post_ping():
    if _B20_NATIVE and _NLIB is not None:
        try: _NLIB.cd_anr_ping()
        except Exception: pass
    ok = False
    try:
        ok = bool(_B20_HANDLER.post(_B20_PING))
    except Exception as e:
        _log("Block#20: post ping err: %r" % e)
    if not ok:
        if _B20_NATIVE and _NLIB is not None:
            try: _NLIB.cd_anr_ping_cancel()
            except Exception: pass

def _b20_beat():
    global _B20_BEAT_INFLIGHT
    _B20_BEAT_INFLIGHT = False
    try:
        if _B20_NATIVE and _NLIB is not None:
            try: _NLIB.cd_anr_beat()
            except Exception: pass
    except Exception:
        pass

def _b20_post_beat():
    global _B20_BEAT_INFLIGHT
    if _B20_BEAT is None or _B20_HANDLER is None: return
    if _B20_BEAT_INFLIGHT: return
    try:
        from java import jclass as _jc
        Message = _jc("android.os.Message")
        msg = Message.obtain(_B20_HANDLER, _B20_BEAT)
        try: msg.setAsynchronous(True)
        except Exception: pass
        _B20_BEAT_INFLIGHT = True
        if not _B20_HANDLER.sendMessage(msg):
            _B20_BEAT_INFLIGHT = False
    except Exception as e:
        _B20_BEAT_INFLIGHT = False
        _log("Block#20: post beat err: %r" % e)

def _b20_pid_of_frame_mod(mod):
    if not mod or mod == _SELF_ID or mod == __id__:
        return None
    try:
        mobj = _sys.modules.get(mod)
        cand = getattr(mobj, "__id__", None) if mobj is not None else None
        if not (isinstance(cand, str) and cand):
            try:
                c2 = _canon_pid(mod)
                if isinstance(c2, str) and c2 and c2 != mod:
                    cand = c2
            except Exception:
                pass
        if isinstance(cand, str) and cand and cand != _SELF_ID and cand != __id__:
            return cand
    except Exception:
        pass
    return None

def _b20_capture_culprit(fr):
    deepest = None
    stack = []
    f = fr; hops = 0
    while f is not None and hops < 60:
        try:
            g = f.f_globals
            mod = g.get("__name__") or ""
            fn = g.get("__file__") or ((mod + ".py") if mod else "?")
            ln = f.f_lineno
            nm = f.f_code.co_name
        except Exception:
            mod = ""; fn = "?"; ln = -1; nm = "?"
        stack.append("%s:%s %s" % (fn, ln, nm))
        if deepest is None:
            pid = _b20_pid_of_frame_mod(mod)
            if pid:
                deepest = (pid, fn, int(ln) if ln is not None else -1)
        try: f = f.f_back
        except Exception: f = None
        hops += 1
    return deepest, stack[:25]

def _persist_anr_fail(rec):
    p = _b20_anr_path()
    if not p:
        _log("Block#20: нет пути -- пропуск"); return
    _PERSIST_IO_LOCK.acquire()
    try:
        cur = []
        if os.path.exists(p):
            try:
                with open(p, "r", encoding="utf-8") as f: cur = list(json.load(f))
            except Exception: cur = []
        cur.append(rec)
        _atomic_json_write(p, cur, 20)
        _log("Block#20: anr verdict zapisan (%d zapisej) -> %s" % (len(cur), _ANR_FILE_NAME))
    except Exception as e:
        _log("Block#20: verdict persist err: %s: %s" % (type(e).__name__, e))
    finally:
        try: _PERSIST_IO_LOCK.release()
        except Exception: pass

_B20_OPSTAMP_STALE_MARGIN_MS = 300
_B20_HOST_RENDER_ERE = "Shader compilation failed|Pipeline create failed|startInput|startInputInner|Kumiho"
def _b20_host_render_signal():
    try:
        chunks = _b28_read_logcat_re(_B20_HOST_RENDER_ERE, level="V", tail=500)
    except Exception:
        return None
    for _c in (chunks or []):
        if not _c:
            continue
        for _pat in ("Shader compilation failed", "Pipeline create failed", "startInput", "Kumiho"):
            if _pat in _c:
                return _pat
    return None


def _b20_owner_from_op(window_ms):
    try:
        if not (_OP_NATIVE_OK and _NLIB is not None and _CTYPES_OK and hasattr(_NLIB, "cd_op_read")):
            return None
    except Exception:
        return None
    best = None
    try:
        ob = ctypes.create_string_buffer(_OP_OWNER_MAX)
        ab = ctypes.create_string_buffer(_OP_API_MAX)
        for _dn, _di in _OP_DOMAIN_IDX.items():
            try:
                age = int(_NLIB.cd_op_read(ctypes.c_int32(_di), ob, ctypes.c_int32(_OP_OWNER_MAX), ab, ctypes.c_int32(_OP_API_MAX)))
            except Exception:
                continue
            if age < 0 or age > int(window_ms):
                continue
            own = ob.value.decode("utf-8", "replace") if ob.value else ""
            if not own:
                continue
            if own[:1] == "#" and own[1:].isdigit():
                _nm = _resolve_idx(int(own[1:]))
                if not (isinstance(_nm, str) and _nm):
                    _nm = _resolve_idx_durable(int(own[1:]))
                own = _nm if (isinstance(_nm, str) and _nm) else ""
            if not own:
                continue
            try: own = _canon_pid(own)
            except Exception: pass
            if not isinstance(own, str) or not own or own == _SELF_ID or own == __id__:
                continue
            api = ab.value.decode("utf-8", "replace") if ab.value else ""
            if api == "dispatchMessage":
                continue
            if best is None or age < best[0]:
                best = (age, _dn, own, api)
    except Exception:
        return None
    if best is None:
        return None
    return {"owner": best[2], "domain": best[1], "api": best[3], "age_ms": best[0]}

def _b20_owner_from_op_in_domains(window_ms, domains, owner=None):
    try:
        if not (_OP_NATIVE_OK and _NLIB is not None and _CTYPES_OK and hasattr(_NLIB, "cd_op_read")):
            return None
    except Exception:
        return None
    best = None
    try:
        ob = ctypes.create_string_buffer(_OP_OWNER_MAX)
        ab = ctypes.create_string_buffer(_OP_API_MAX)
        for _dn in domains:
            _di = _OP_DOMAIN_IDX.get(_dn)
            if _di is None:
                continue
            try:
                age = int(_NLIB.cd_op_read(ctypes.c_int32(_di), ob, ctypes.c_int32(_OP_OWNER_MAX), ab, ctypes.c_int32(_OP_API_MAX)))
            except Exception:
                continue
            if age < 0 or age > int(window_ms):
                continue
            own = ob.value.decode("utf-8", "replace") if ob.value else ""
            if not own:
                continue
            if own[:1] == "#" and own[1:].isdigit():
                _nm = _resolve_idx(int(own[1:]))
                if not (isinstance(_nm, str) and _nm):
                    _nm = _resolve_idx_durable(int(own[1:]))
                own = _nm if (isinstance(_nm, str) and _nm) else ""
            if not own:
                continue
            try: own = _canon_pid(own)
            except Exception: pass
            if not isinstance(own, str) or not own or own == _SELF_ID or own == __id__:
                continue
            if owner is not None and own != owner:
                continue
            api = ab.value.decode("utf-8", "replace") if ab.value else ""
            if api == "dispatchMessage":
                continue
            if best is None or age < best[0]:
                best = (age, _dn, own, api)
    except Exception:
        return None
    if best is None:
        return None
    return {"owner": best[2], "domain": best[1], "api": best[3], "age_ms": best[0]}

def _b20_owner_from_scope():
    try:
        if not (_ANR_NATIVE_OK and _NLIB is not None and hasattr(_NLIB, "cd_anr_owner")):
            return None
        idx = int(_NLIB.cd_anr_owner())
    except Exception:
        return None
    if idx is None or idx < 0:
        return None
    nm = _resolve_idx(idx)
    if not (isinstance(nm, str) and nm):
        nm = _resolve_idx_durable(idx)
    if not (isinstance(nm, str) and nm):
        return None
    try: nm = _canon_pid(nm)
    except Exception: pass
    if not isinstance(nm, str) or not nm or nm == _SELF_ID or nm == __id__:
        return None
    return nm

_B29_ON = True
_B29_PERIOD_S = 3.0
_B29_MIN_PCT = 1.0
_B29_TOP_N = 8
_B29_HOG_PCT = 60.0
_B29_STALE_MS = 8000


_GIL_B29, _GIL_B27, _GIL_B6, _GIL_B31, _GIL_B20, _GIL_B28, _GIL_OTHER = 0, 1, 2, 3, 4, 5, 6
_GIL_B6_JHEAP, _GIL_B6_KILL, _GIL_B6_LEAK = 7, 8, 9

def _gil_begin(slot):
    if _GIL_NATIVE_OK and _NLIB is not None:
        try: _NLIB.cd_gil_mark_begin(int(slot))
        except Exception: pass

def _gil_end(slot):
    if _GIL_NATIVE_OK and _NLIB is not None:
        try: _NLIB.cd_gil_mark_end(int(slot))
        except Exception: pass


class _CdCpuRow(ctypes.Structure):
    _fields_ = [("tid", ctypes.c_int32), ("owner_idx", ctypes.c_int32),
                ("milli_pct", ctypes.c_int32), ("_pad", ctypes.c_int32),
                ("comm", ctypes.c_char * 16)]

def _b29_owner_from_idx(idx, tid):
    if idx is None or idx < 0:
        try: idx = _reg_get(int(tid))
        except Exception: idx = None
    if idx is None or idx < 0: return None
    nm = _resolve_idx(idx)
    if not (isinstance(nm, str) and nm):
        nm = _resolve_idx_durable(idx)
    if not (isinstance(nm, str) and nm): return None
    try: nm = _canon_pid(nm)
    except Exception: pass
    if not isinstance(nm, str) or not nm or nm == _SELF_ID or nm == __id__:
        return None
    return nm

def _b29_native_read():
    if not (_CPU_NATIVE_OK and _NLIB is not None):
        return None
    try:
        addr = int(_NLIB.cd_cpu_rows_addr())
        rsz = int(_NLIB.cd_cpu_row_size())
        cap = int(_NLIB.cd_cpu_max())
        if addr == 0 or rsz != ctypes.sizeof(_CdCpuRow) or cap <= 0:
            return None
        arr_t = _CdCpuRow * cap
        for _att in range(8):
            s1 = int(_NLIB.cd_cpu_seq())
            if s1 & 1:
                time.sleep(0.0005); continue
            cnt = int(_NLIB.cd_cpu_count())
            if cnt < 0: cnt = 0
            if cnt > cap: cnt = cap
            win = int(_NLIB.cd_cpu_win_ms())
            ts = int(_NLIB.cd_cpu_ts_ms())
            arr = arr_t.from_address(addr)
            raw = [(int(arr[i].tid), int(arr[i].owner_idx), int(arr[i].milli_pct),
                    arr[i].comm.decode("utf-8", "replace")) for i in range(cnt)]
            s2 = int(_NLIB.cd_cpu_seq())
            if s1 == s2:
                age = (int(time.time() * 1000) - ts) if ts else (1 << 30)
                rows = []
                for tid, oidx, mpct, nm in raw:
                    pct = mpct / 1000.0
                    if pct < _B29_MIN_PCT: continue
                    rows.append({"tid": tid, "name": nm, "pct": round(pct, 1),
                                 "owner": _b29_owner_from_idx(oidx, tid)})
                return rows[:_B29_TOP_N], {"age_ms": age, "win_ms": win}
            time.sleep(0.0003)
        return None
    except Exception:
        return None


def _b29_cpu_top():
    if _CPU_NATIVE_OK and _NLIB is not None:
        _nr = _b29_native_read()
        if _nr is not None: return _nr
    return [], None

def _b29_fresh_top(window_ms=160):
    if _CPU_NATIVE_OK and _NLIB is not None:
        try: _NLIB.cd_cpu_sample_now(int(window_ms))
        except Exception: pass
        _nr = _b29_native_read()
        if _nr is not None:
            try: _nr[1]["age_ms"] = 0
            except Exception: pass
            return _nr
    return [], None

def _b29_hog_culprit(rows, meta):
    if not rows or meta is None: return None
    if meta.get("age_ms", 1 << 30) > _B29_STALE_MS: return None
    top = rows[0]
    if top.get("owner") and top["pct"] >= _B29_HOG_PCT:
        if len(rows) == 1 or rows[1]["pct"] < top["pct"] * 0.5 or rows[1].get("owner") == top["owner"]:
            return {"owner": top["owner"], "pct": top["pct"], "tid": top["tid"],
                    "name": top["name"], "age_ms": meta.get("age_ms")}
    return None

_B29_CORROB_PCT = 35.0

def _b29_top_owned_by(rows, owner):
    if not rows or not owner:
        return None
    best = None
    for r in (rows or []):
        try:
            if r.get("owner") == owner and float(r.get("pct") or 0.0) >= _B29_CORROB_PCT:
                if best is None or r["pct"] > best["pct"]:
                    best = r
        except Exception:
            continue
    return best


def _b29_start():
    if not _B29_ON:
        _log("Block#29: disabled"); return
    if _CPU_NATIVE_OK and _NLIB is not None:
        try:
            _rc = int(_NLIB.cd_cpu_start(int(_B29_PERIOD_S * 1000), int(_B29_MIN_PCT * 1000), int(_B29_TOP_N)))
            _log("Block#29 native CPU sampler: start rc=%d period=%.1fs (off-GIL, +DR Lever 1)" % (_rc, _B29_PERIOD_S))
        except Exception as _e:
            _log("Block#29 native CPU sampler start failed (%r) -> CPU sampling OFF (no python fallback, +HW)" % _e)
        return
    _log("Block#29: native CPU sampler unavailable -> CPU sampling OFF (no python fallback, +HW)")

def _b29_stop():
    try:
        if _CPU_NATIVE_OK and _NLIB is not None:
            try: _NLIB.cd_cpu_stop()
            except Exception: pass
    except Exception: pass

_BLOCK33_ON = False
_B33_BASELINE = None
_B33_PERIOD_S = 2.0
_B33_UI_BUDGET_MS_PER_S = 8.0
_B33_TOTAL_BUDGET_MS_PER_S = 25.0
_B33_GIL_GAP_BUDGET_MS_PER_S = 14.0

def _b33_status():
    if not (_B33_NATIVE_OK and _NLIB is not None):
        return None
    try:
        buf = (ctypes.c_int64 * 16)()
        n = int(_NLIB.cd_b33_status(buf, 16))
        if n < 13:
            return None
        v = [int(buf[i]) for i in range(min(n, 16))]
        return {"running": bool(v[0]), "degrade_level": v[1], "gref_level": v[2],
                "strike": v[3], "ok_run": v[4], "na_min_bytes": v[5],
                "na_sample_div": v[6], "cpu_period_ms": v[7], "gref_time_div": v[8],
                "ui_ms_per_s": v[9] / 100.0, "total_ms_per_s": v[10] / 100.0,
                "gil_ms_per_s": v[11] / 100.0, "last_emit_ms": v[12]}
    except Exception:
        return None

def _b33_sync_globals():
    st = _b33_status()
    if not st:
        return None
    global _NA_MIN_BYTES, _B29_PERIOD_S
    try:
        if st.get("na_min_bytes", 0) > 0: _NA_MIN_BYTES = int(st["na_min_bytes"])
        if st.get("cpu_period_ms", 0) > 0: _B29_PERIOD_S = float(st["cpu_period_ms"]) / 1000.0
    except Exception:
        pass
    return st

def _b33_capture_baseline():
    b = {"na_min_bytes": int(_NA_MIN_BYTES), "b29_period_s": float(_B29_PERIOD_S)}
    try:
        if _NLIB is not None:
            if hasattr(_NLIB, "cd_na_sample_div"):
                b["na_sample_div"] = int(_NLIB.cd_na_sample_div())
            if hasattr(_NLIB, "cd_gref_time_div"):
                b["gref_time_div"] = int(_NLIB.cd_gref_time_div())
            if hasattr(_NLIB, "cd_na_is_on"):
                b["na_is_on"] = bool(int(_NLIB.cd_na_is_on()))
    except Exception:
        pass
    return b

def _b33_start():
    global _B33_BASELINE
    if not _BLOCK33_ON:
        _log("Block#33: disabled"); return
    if not (_B33_NATIVE_OK and _NLIB is not None):
        _log("Block#33: cd_b33_start недоступен (старый .so) -> watchdog OFF")
        return
    p = _oom_path(_SELF_OVERHEAD_NAME)
    if not p:
        _log("Block#33: нет каталога для self_overhead.json -> watchdog OFF"); return
    _run0 = 0
    try:
        _run0 = int(_NLIB.cd_b33_running())
    except Exception:
        _run0 = 0
    if _run0 == 0:
        if _B33_BASELINE is not None:
            try: _b33_restore_baseline()
            except Exception: pass
            if _B33_BASELINE is not None:
                _log("Block#33 +PB: previous baseline restore incomplete -> start cancelled")
                return
        _B33_BASELINE = _b33_capture_baseline()
    try:
        rc = int(_NLIB.cd_b33_start(p.encode("utf-8"), str(__id__).encode("utf-8"),
                                    int(_B33_PERIOD_S * 1000),
                                    int(_B33_UI_BUDGET_MS_PER_S * 1000),
                                    int(_B33_TOTAL_BUDGET_MS_PER_S * 1000),
                                    int(_B33_GIL_GAP_BUDGET_MS_PER_S * 1000)))
        _log("Block#33 native watchdog start rc=%d period=%.1fs ui=%.1f total=%.1f gil=%.1f ms/s" % (
            rc, _B33_PERIOD_S, _B33_UI_BUDGET_MS_PER_S, _B33_TOTAL_BUDGET_MS_PER_S, _B33_GIL_GAP_BUDGET_MS_PER_S))
    except Exception as e:
        try: _log("Block#33 start err: %r" % e)
        except Exception: pass

def _b33_restore_baseline(best_effort=False):
    global _NA_MIN_BYTES, _B29_PERIOD_S, _B33_BASELINE
    b = _B33_BASELINE
    if not b:
        return
    _fail = []
    try:
        _NA_MIN_BYTES = int(b["na_min_bytes"])
        _B29_PERIOD_S = float(b["b29_period_s"])
    except Exception:
        return
    try:
        if _NLIB is not None and hasattr(_NLIB, "cd_na_min_bytes") and hasattr(_NLIB, "cd_na_enable"):
            _want_on = 1 if b.get("na_is_on", True) else 0
            _cur = int(_NLIB.cd_na_min_bytes())
            _cur_on = int(_NLIB.cd_na_is_on()) if hasattr(_NLIB, "cd_na_is_on") else _want_on
            if _cur != int(_NA_MIN_BYTES) or _cur_on != _want_on:
                _rc = int(_NLIB.cd_na_enable(_want_on, int(_NA_MIN_BYTES)))
                if _rc != 0:
                    _fail.append("na_enable(rc=%d)" % _rc)
    except Exception:
        _fail.append("na_enable")
    try:
        if _NLIB is not None and hasattr(_NLIB, "cd_na_set_sample_div") and "na_sample_div" in b:
            _NLIB.cd_na_set_sample_div(int(b["na_sample_div"]))
    except Exception:
        _fail.append("na_sample_div")
    try:
        if _NLIB is not None and hasattr(_NLIB, "cd_gref_set_time_div") and "gref_time_div" in b:
            _NLIB.cd_gref_set_time_div(int(b["gref_time_div"]))
    except Exception:
        _fail.append("gref_time_div")
    try:
        if _NLIB is not None and hasattr(_NLIB, "cd_cpu_set_period"):
            _NLIB.cd_cpu_set_period(int(_B29_PERIOD_S * 1000))
    except Exception:
        _fail.append("cpu_set_period")
    try:
        _log("Block#33 +OX: baseline restored (na_min=%d, b29_period=%.1fs, na_div=%s, gref_div=%s, na_on=%s)" % (
            int(_NA_MIN_BYTES), float(_B29_PERIOD_S),
            b.get("na_sample_div", "-"), b.get("gref_time_div", "-"), b.get("na_is_on", "-")))
    except Exception:
        pass
    if _fail:
        try: _log("Block#33 +OZ: baseline restore PARTIAL, failed setters: %s" % ", ".join(_fail))
        except Exception: pass
    if best_effort or not _fail:
        _B33_BASELINE = None

def _b33_stop():
    try:
        if _B33_NATIVE_OK and _NLIB is not None and int(_NLIB.cd_b33_running()) == 1:
            _b33_sync_globals()
            _NLIB.cd_b33_stop()
    except Exception:
        pass


_DN_IDLE_CLASSES = ("android.os.MessageQueue", "android.os.Looper", "android.os.Handler", "android.app.ActivityThread", "com.android.internal.os", "java.lang.reflect.Method", "dalvik.system", "java.lang.Object", "com.chaquo", "java.chaquopy", "org.python")
_DN_PLUGIN_MARKERS = ("chaquo", "chaquopy", "org.python", "pythonplugin")
_DN_SYSCALL_NAMES = {98: "futex", 73: "ppoll", 22: "epoll_pwait", 63: "read", 64: "write", 113: "clock_nanosleep", 101: "nanosleep", 71: "sendmsg", 212: "recvmsg", 29: "ioctl", 56: "openat"}
_DN_MIDSTALL_AFTER_MS = 1200
_DN_MIDSTALL_EVERY_MS = 800
_DN_MIDSTALL_MAX = 5
_DN_MIDSTALL_SNAPSHOT = []

def _dn_capture_java_ui_stack(max_frames=48):
    try:
        from java import jclass as _jc
        Looper = _jc("android.os.Looper")
        main = Looper.getMainLooper()
        if main is None:
            return None, 0, None
        th = main.getThread()
        if th is None:
            return None, 0, None
        elems = th.getStackTrace()
    except Exception as e:
        try: _log("Block#20 +DN: java stack err: %r" % e)
        except Exception: pass
        return None, 0, None
    frames = []
    plugin_n = 0
    component = None
    try:
        n = len(elems)
    except Exception:
        n = 0
    for i in range(n):
        try:
            el = elems[i]
            cls = el.getClassName() or "?"
            mth = el.getMethodName() or "?"
            fn = el.getFileName() or ""
            ln = el.getLineNumber()
        except Exception:
            continue
        frames.append("%s.%s(%s:%s)" % (cls, mth, fn, ln))
        low = cls.lower()
        if any(m in low for m in _DN_PLUGIN_MARKERS):
            plugin_n += 1
        if component is None and not cls.startswith(_DN_IDLE_CLASSES):
            component = "%s.%s" % (cls, mth)
        if len(frames) >= max_frames:
            break
    return frames, plugin_n, component

def _dn_proc_field(path):
    try:
        with open(path, "r") as f:
            return f.read().strip()
    except Exception:
        return None

def _dn_capture_kernel_state(ui_tid_linux):
    try:
        tid = int(ui_tid_linux)
    except Exception:
        return None
    if tid <= 0:
        return None
    base = "/proc/self/task/%d" % tid
    out = {"tid": tid}
    st = _dn_proc_field(base + "/stat")
    if st:
        try:
            cp = st.rfind(")")
            out["state"] = st[cp + 2] if (cp >= 0 and len(st) > cp + 2) else None
        except Exception:
            out["state"] = None
    out["wchan"] = _dn_proc_field(base + "/wchan")
    sc = _dn_proc_field(base + "/syscall")
    if sc:
        out["syscall_raw"] = sc
        try:
            nr = int(sc.split()[0])
            out["syscall_nr"] = nr
            out["syscall"] = _DN_SYSCALL_NAMES.get(nr)
        except Exception:
            pass
    s = out.get("state")
    wc = (out.get("wchan") or "").lower()
    if s == "R":
        out["nature"] = "on-cpu (host compute / busy-loop)"
    elif s in ("S", "D"):
        if "futex" in wc or out.get("syscall") == "futex":
            out["nature"] = "blocked on lock (futex) - host lock contention"
        elif "binder" in wc or "ioctl" in wc:
            out["nature"] = "blocked in binder IPC"
        elif "poll" in wc or "epoll" in wc:
            out["nature"] = "epoll/poll wait (looper idle or polling)"
        elif "io_schedule" in wc or "wait_on_page" in wc or "folio_wait" in wc or "page_fault" in wc or "filemap" in wc or "__lock_page" in wc or "read_pages" in wc or "balance_dirty_pages" in wc or out.get("syscall") in ("read", "write"):
            out["nature"] = "blocked on page/disk I/O (memory-pressure page-in)"
        else:
            out["nature"] = "sleeping (%s)" % (wc or "?")
    else:
        out["nature"] = "state=%s" % (s or "?")
    return out

def _persist_host_stall(rec, p):
    _PERSIST_IO_LOCK.acquire()
    try:
        cur = []
        if os.path.exists(p):
            try:
                with open(p, "r", encoding="utf-8") as f: cur = list(json.load(f))
            except Exception: cur = []
        cur.append(rec)
        _atomic_json_write(p, cur, 20)
        _log("Block#20 +DN: host-stall verdict zapisan (%d zapisej) -> %s" % (len(cur), _HOST_STALL_FILE_NAME))
    except Exception as e:
        _log("Block#20 +DN: host verdict persist err: %s: %s" % (type(e).__name__, e))
    finally:
        try: _PERSIST_IO_LOCK.release()
        except Exception: pass

def _dn_live_scope_owner():
    try:
        tid = globals().get("_B33_UI_TID")
        if tid is None: return None
        idx = _reg_get(int(tid))
        if idx is None or int(idx) < 0: return None
        nm = _resolve_idx(int(idx))
        if not (isinstance(nm, str) and nm): nm = _resolve_idx_durable(int(idx))
        if not (isinstance(nm, str) and nm): return None
        try: nm = _canon_pid(nm)
        except Exception: pass
        if not (isinstance(nm, str) and nm): return None
        return nm
    except Exception:
        return None

def _dn_mid_scope_owner(midsamples, chosen):
    try:
        if chosen is not None and chosen.get("scope_owner"):
            return chosen.get("scope_owner")
        for s in reversed(list(midsamples or [])):
            try:
                if s.get("scope_owner"): return s.get("scope_owner")
            except Exception: continue
    except Exception:
        pass
    return None

def _dn_choose_host_sample(midsamples):
    best = None
    for s in midsamples or []:
        try:
            if s.get("component"):
                if best is None or (s.get("held_ms") or 0) > (best.get("held_ms") or 0):
                    best = s
        except Exception:
            continue
    return best

_DN_HOST_PREFIXES = ("android.", "androidx.", "java.", "javax.", "kotlin.", "kotlinx.", "dalvik.", "libcore.", "sun.", "com.android.", "org.telegram.", "com.exteragram.", "com.chaquo.", "java.chaquopy", "org.python")
def _dn_java_plugin_owner(jframes):
    try:
        _ku = _known_union()
    except Exception:
        _ku = None
    if not _ku:
        return None
    for _f in (jframes or []):
        try:
            _cls = _f.split("(", 1)[0].rsplit(".", 1)[0] if "(" in _f else _f
            if not _cls or _cls.startswith(_DN_HOST_PREFIXES):
                continue
            _pid = _map_stack_to_id(_cls, _ku)
            if _pid and _pid not in (_SELF_ID, __id__):
                return _pid
        except Exception:
            continue
    return None


def _dn_classify_host(jframes, plugin_n, component, kernel, phase):
    top = (jframes[0] if jframes else "") or ""
    idle = (component is None) or top.startswith("android.os.MessageQueue.nativePollOnce")
    if idle:
        return "host/undetermined", "low", "anr/host-idle", True
    if plugin_n > 0:
        if phase == "mid-stall":
            return component, "medium", "anr/host?+plugin-frames", False
        return component, "low", "anr/host?+plugin-frames", False
    if phase == "mid-stall":
        return component, "high", "anr/host", False
    wc = ((kernel or {}).get("wchan") or "").lower()
    st = (kernel or {}).get("state")
    active = (st in ("R", "D")) or ("futex" in wc) or ("binder" in wc) or ("io_schedule" in wc)
    return component, ("medium" if active else "low"), "anr/host", False

_HX_RENDER_NAMES = ("renderthread", "hwuitask", "glthread", "mali-",
                    "gpu completion", "renderengine", "surfaceflinger")
_HX_RENDER_DOM_PCT = 45.0
_HX_UNTAGGED_DOM_PCT = 50.0
_HX_RENDER_RATIO = 1.5
_HX_COCULPRIT_PCT = 60.0
_HX_CPU_STARVE_PCT = 90.0
_HX_LEAK_WINDOW_MS = 120000
_HX_LEAK_RECENT = {}
_HX_LEAK_LOCK = threading.Lock()

_HX_DISPATCH_QUEUE_NAMES = ("stagequeue", "storagequeue", "sendqueue", "downloadqueue", "uploadqueue", "dispatchqueue")

def _hx_is_dispatch_queue_name(nm):
    if not nm: return False
    low = str(nm).lower()
    for t in _HX_DISPATCH_QUEUE_NAMES:
        if t in low: return True
    return False

def _hx_is_render_name(nm):
    if not nm: return False
    low = str(nm).lower()
    for t in _HX_RENDER_NAMES:
        if t in low: return True
    return False

def _hx_owned_hot(rows, owner):
    best = None
    for r in (rows or []):
        try:
            if r.get("owner") == owner and (best is None or float(r.get("pct") or 0.0) > float(best.get("pct") or 0.0)):
                best = r
        except Exception:
            continue
    return best

def _hx_conf_down(conf):
    return {"high": "medium", "medium": "low", "low": "low"}.get(conf, conf)

def _hx_leak_corroborates(owner):
    if not owner: return None
    now = int(time.time() * 1000)
    try:
        with _HX_LEAK_LOCK:
            ts = _HX_LEAK_RECENT.get(owner)
        if ts and (now - ts) <= _HX_LEAK_WINDOW_MS:
            return "view-leak"
    except Exception:
        pass
    try:
        if owner in (_b28_hot_hook_owners() or {}):
            return "hot-hook"
    except Exception:
        pass
    return None

def _hx_apply(culprit, src, conf, py_file, crows):
    extra = {}
    rows = crows or []
    has_pyframe = bool(py_file)
    if rows and not has_pyframe and culprit:
        top = rows[0]
        try: top_pct = float(top.get("pct") or 0.0)
        except Exception: top_pct = 0.0
        if _hx_is_render_name(top.get("name")) and (not top.get("owner")) and top_pct >= _HX_RENDER_DOM_PCT:
            own = _hx_owned_hot(rows, culprit)
            own_pct = float((own or {}).get("pct") or 0.0)
            if own is None or top_pct >= own_pct * _HX_RENDER_RATIO:
                extra["render_bound"] = True
                extra["render_thread"] = {"tid": top.get("tid"), "name": top.get("name"), "pct": round(top_pct, 1)}
                extra["cpu_suggests"] = "host/render"
                _nc = _hx_conf_down(conf)
                if _nc != conf:
                    extra["cv_conf_from"] = conf; conf = _nc
                if "+render?" not in (src or ""):
                    src = (src or "anr/ui-thread") + "+render?"
    if rows and culprit:
        co = None
        for r in rows:
            try:
                ow = r.get("owner"); pc = float(r.get("pct") or 0.0)
            except Exception:
                continue
            if ow and ow != culprit and pc >= _HX_COCULPRIT_PCT and (co is None or pc > co["pct"]):
                co = {"owner": ow, "tid": r.get("tid"), "name": r.get("name"), "pct": round(pc, 1)}
        if co is not None:
            extra["co_culprit"] = co
            if conf == "low":
                extra["cv_note"] = "co_culprit %s burns %.1f%% CPU on a bg thread during the stall" % (co["owner"], co["pct"])
    if culprit and conf == "low" and not extra.get("render_bound"):
        _lk = _hx_leak_corroborates(culprit)
        if _lk:
            extra["cv_conf_from"] = conf; conf = "medium"
            extra["leak_corrob"] = _lk
            if "+leak?" not in (src or ""):
                src = (src or "anr") + "+leak?"
    if rows and not has_pyframe and culprit and not extra.get("render_bound") and not extra.get("co_culprit"):
        _t0 = rows[0]
        try: _tp0 = float(_t0.get("pct") or 0.0)
        except Exception: _tp0 = 0.0
        if (not _t0.get("owner")) and (not _hx_is_render_name(_t0.get("name"))) and _tp0 >= _HX_UNTAGGED_DOM_PCT:
            _o4 = _hx_owned_hot(rows, culprit)
            _o4p = float((_o4 or {}).get("pct") or 0.0)
            if _o4 is None or _tp0 >= _o4p * _HX_RENDER_RATIO:
                extra["untagged_top"] = {"tid": _t0.get("tid"), "name": _t0.get("name"), "pct": round(_tp0, 1)}
                if _hx_is_dispatch_queue_name(_t0.get("name")) and "scope" in (src or "") and not str(culprit).startswith("host"):
                    extra["cpu_suggests"] = "scope-owner-dispatch"
                    extra["dispatch_corroborates"] = {"name": _t0.get("name"), "pct": round(_tp0, 1), "owner": culprit}
                    if conf == "low":
                        extra["cv_conf_from"] = conf; conf = "medium"
                    if "+dispatch?" not in (src or ""):
                        src = (src or "anr/ui-thread") + "+dispatch?"
                else:
                    extra["cpu_suggests"] = "untagged"
                    _nc4 = _hx_conf_down(conf)
                    if _nc4 != conf:
                        extra["cv_conf_from"] = conf; conf = _nc4
                    if "+untagged?" not in (src or ""):
                        src = (src or "anr/ui-thread") + "+untagged?"
    return culprit, src, conf, extra


def _native_event_ms(record):
    """Original native capture time; publication/mtime is not a crash time."""
    if not isinstance(record, dict): return None
    ne = record.get("native_emit")
    values = [record.get("crash_ts"), record.get("event_ts")]
    if isinstance(ne, dict): values.append(ne.get("ts_ms"))
    for value in values:
        stamp = _ui_timestamp_s(value)
        if stamp is not None: return int(round(stamp * 1000.0))
    return None

def _b20_vfork_host_sample(midsamples):
    """Narrow +UA gate: kernel-confirmed host vfork wait, no plugin frames.
    A Python/Java plugin frame or process launch without kernel evidence does
    NOT enter this gate. Scope/op/foreign-thread exit are not direct UI frames.
    """
    chosen = _dn_choose_host_sample(midsamples)
    if not isinstance(chosen, dict): return None
    frames = chosen.get("jframes") or []
    kernel = chosen.get("kernel") or {}
    if int(chosen.get("plugin_n") or 0) != 0: return None
    if _dn_java_plugin_owner(frames): return None
    if float(chosen.get("held_ms") or 0) < 0.5 * _B20_TIMEOUT_MS: return None
    if kernel.get("state") not in ("S", "D"): return None
    if "wait_for_vfork_done" not in str(kernel.get("wchan") or ""): return None
    if not frames or not str(frames[0]).startswith("java.lang.UNIXProcess.forkAndExec"):
        return None
    if not any(str(f).startswith("org.telegram.messenger.EmuDetector.checkIp") for f in frames):
        return None
    return chosen

def _b20_selfkill_corr(waited_ms):
    try:
        try: _b30_read_sentinel("anr-corr")
        except Exception: pass
        rec = globals().get("_B30_LAST_BLOCKED")
        if not isinstance(rec, dict): return None
        _proc = rec.get("proc_pid")
        if _proc is not None and int(_proc) != os.getpid(): return None
        _cu = rec.get("culprit")
        if not _cu or str(_cu).startswith(("unknown", "idx#")): return None
        d = (int(time.time() * 1000) - int(waited_ms)) - int(rec.get("ts") or 0)
        if -500 <= d <= 1500:
            return {"culprit": _cu, "vector": rec.get("vector"), "dropper": rec.get("dropper"), "tid": rec.get("tid"), "kill_ts": int(rec.get("ts") or 0), "delta_ms": int(d)}
    except Exception:
        pass
    return None


def _b20_selfkill_aftermath(waited_ms):
    try:
        rec = globals().get("_B30_LAST_BLOCKED")
        if not isinstance(rec, dict): return None
        _proc = rec.get("proc_pid")
        if _proc is not None and int(_proc) != os.getpid(): return None
        _cu = rec.get("culprit")
        if not _cu or str(_cu).startswith(("unknown", "idx#")): return None
        d = (int(time.time() * 1000) - int(waited_ms)) - int(rec.get("ts") or 0)
        if 1500 < d <= _B20_SELFKILL_AFTERMATH_MS:
            return {"culprit": _cu, "vector": rec.get("vector"), "dropper": rec.get("dropper"), "tid": rec.get("tid"), "kill_ts": int(rec.get("ts") or 0), "delta_ms": int(d)}
    except Exception:
        pass
    return None


def _b20_report_stall(waited_ms):
    try:
        frames = _sys._current_frames()
    except Exception as e:
        _log("Block#20: _current_frames err: %r" % e); return
    fr = frames.get(_B20_UI_TID) if _B20_UI_TID is not None else None
    deepest, stack = (None, [])
    _bi_nature = None
    _sk = None
    if fr is not None:
        try: deepest, stack = _b20_capture_culprit(fr)
        except Exception as e: _log("Block#20: capture err: %r" % e)
    try:
        _crows, _cmeta = _b29_cpu_top()
    except Exception:
        _crows, _cmeta = [], None
    if deepest is None:
        _ua_mid = list(globals().get("_DN_MIDSTALL_SNAPSHOT") or [])
        try: _ua_launch = _b20_vfork_host_sample(_ua_mid)
        except Exception: _ua_launch = None
        if _ua_launch is not None:
            _ua_weak = {"scope_owner": _b20_owner_from_scope()}
            try: _ua_weak["blocked_exit"] = _b20_selfkill_corr(waited_ms)
            except Exception: pass
            _ua_rec = {
                "had_anr": True, "host_side": True, "culprit_kind": "host",
                "event_type": "host_stall", "dropbox_tag": "data_app_anr",
                "tombstone_norm_version": 1,
                "culprit": "java.lang.UNIXProcess.forkAndExec",
                "component": "java.lang.UNIXProcess.forkAndExec",
                "src": "anr/host-vfork+UA", "confidence": "high",
                "where": "ui-thread", "stalled_ms": int(waited_ms),
                "ui_tid": _B20_UI_TID, "ui_tid_linux": globals().get("_B33_UI_TID"),
                "proc_pid": os.getpid(), "so_abi": globals().get("_SO_ABI_SEEN"),
                "plugin_frames_in_ui_stack": 0, "sample_phase": "mid-stall",
                "sample_held_ms": _ua_launch.get("held_ms"), "looper_idle": False,
                "java_stack": _ua_launch.get("jframes"), "kernel": _ua_launch.get("kernel"),
                "hot_frames": _b42_hot_frames(_ua_mid), "cpu_top": _crows,
                "cpu_win_ms": (_cmeta or {}).get("win_ms"),
                "weak_context": _ua_weak,
                "reason": "UI blocked in host EmuDetector.checkIp -> forkAndExec; kernel wait_for_vfork_done. Scope/blocked exit are context, not proof of plugin causation.",
                "ts": int(time.time() * 1000)}
            try: _ui_ctx_attach(_ua_rec)
            except Exception: pass
            _ua_path = _oom_path(_HOST_STALL_FILE_NAME)
            if _ua_path:
                with _B20_LOCK: _persist_host_stall(_ua_rec, _ua_path)
            _log("Block#20 +UA: kernel-confirmed host vfork wait overrides weak scope/selfkill correlation; context=%r" % _ua_weak)
            return
    if deepest is not None:
        culprit, py_file, py_line = deepest
        src = "anr/ui-thread"; conf = "high"; py_mod = culprit
        try:
            _bi_imp = [_f for _f in (stack or []) if any(_m in _f for _m in ("_bootstrap_external", "_bootstrap.pyc", "importer.pyc", "find_spec", "find_module", "_find_and_load", "importlib"))]
            if _bi_imp:
                _bi_nature = "blocking import on UI thread: %s -> import/find_module в apply_ui/tick (перенести импорт в фон)" % culprit
                src = src + "+blocking-import"
                _log("Block#20 +BI: blocking import on UI thread for %r (%d import frames) -> nature tagged" % (culprit, len(_bi_imp)))
        except Exception as _ebi:
            try: _log("Block#20 +BI: import-detect err: %r" % _ebi)
            except Exception: pass
    else:
        owner = _b20_owner_from_scope()
        _opinfo = _b20_owner_from_op(int(waited_ms) + 2500)
        _op_stale = False
        if _opinfo is not None:
            try:
                _op_age = int(_opinfo.get("age_ms") or 0)
                _op_dom = _opinfo.get("domain")
                _op_max_age = int(waited_ms) if (_op_dom == "anim") else (int(waited_ms) + _B20_OPSTAMP_STALE_MARGIN_MS)
                if _op_age > _op_max_age:
                    _op_stale = True
                    _log("Block#20 +IL guard#%s: op-stamp %r/%s age=%dms > max=%dms (stall=%dms) -> STALE, плагин НЕ атрибутируется" % (("2anim" if _op_dom == "anim" else "1"), _opinfo.get("owner"), _op_dom, _op_age, _op_max_age, int(waited_ms)))
            except Exception as _eil:
                try: _log("Block#20 +IL: staleness calc err: %r" % _eil)
                except Exception: pass
        _host_render = None
        if owner is None and _opinfo is not None and not _op_stale:
            try:
                _host_render = _b20_host_render_signal()
            except Exception as _ehr:
                _host_render = None
                try: _log("Block#20 +IL guard#3: host-render probe err: %r" % _ehr)
                except Exception: pass
            if _host_render is not None:
                _log("Block#20 +IL guard#3: host render/IME маркер %r в окне при пустом py-стеке -> op-stamp %r/%s отдаём хосту" % (_host_render, _opinfo.get("owner"), _opinfo.get("domain")))
        _sk = _b20_selfkill_corr(waited_ms)
        _sk_tid = _sk.get("tid") if _sk is not None else None
        _ui_tid_n = globals().get("_B33_UI_TID")
        _sk_ui = bool(_sk is not None and _sk_tid is not None and _ui_tid_n is not None and _sk_tid == _ui_tid_n)
        _sk_after = _b20_selfkill_aftermath(waited_ms)
        _sk_after_uimatch = bool(_sk_after is not None and _sk_after.get("tid") is not None and _ui_tid_n is not None and _sk_after.get("tid") == _ui_tid_n)
        if _sk_after is not None:
            _log("Block#20 +MG advisory: fresh blocked self-kill ot %r za %dms do ocenki nachala stall (vector=%s tid=%s ui_tid=%s uimatch=%s) -- diagnostika, sama po sebe atribuciyu NE menyaet" % (_sk_after.get("culprit"), int(_sk_after.get("delta_ms") or 0), _sk_after.get("vector"), _sk_after.get("tid"), _ui_tid_n, _sk_after_uimatch))
        if _sk is not None and _sk_tid is not None and _ui_tid_n is not None and not _sk_ui:
            _log("Block#20 +LW: заблокированный %s от %r пришёл с фонового tid=%s (UI tid=%s) -> только corroboration, не прямая атрибуция" % (_sk.get("vector"), _sk["culprit"], _sk_tid, _ui_tid_n))
        if _sk_ui:
            culprit = _sk["culprit"]; py_mod = culprit; py_file = ""; py_line = -1
            src = "anr/ui-thread-selfkill-blocked"; conf = "high"
            _log("Block#20 +LW: стойл UI начался в момент нейтрализованного %s от %r НА UI-потоке (tid=%s, delta=%dms) -> culprit=%r conf=high" % (_sk.get("vector"), _sk["culprit"], _sk_tid, int(_sk.get("delta_ms") or 0), _sk["culprit"]))
        elif owner is not None:
            culprit = owner; py_mod = owner; py_file = ""; py_line = -1
            _op_match = (_opinfo is not None and _opinfo["owner"] == owner and not _op_stale)
            if _sk is not None and _sk.get("culprit") == owner:
                src = "anr/ui-thread-scope+selfkill-blocked" + ("+op" if _op_match else "")
                conf = "high" if _op_match else "medium"
                _log("Block#20 +LW: scope-owner %r совпал с culprit заблокированного %s (delta=%dms%s) -> conf=%s" % (owner, _sk.get("vector"), int(_sk.get("delta_ms") or 0), (", op corroborated" if _op_match else ""), conf))
            elif _op_match:
                src = "anr/ui-thread-scope+op:%s" % _opinfo["domain"]; conf = "medium"
                _log("Block#20: no py-frame; scope-owner %r corroborated by op-stamp (domain=%s api=%s age=%dms, UI stall %dms)" % (owner, _opinfo["domain"], _opinfo["api"], int(_opinfo["age_ms"]), int(waited_ms)))
            else:
                _res_toppct = 0.0
                try:
                    if _crows: _res_toppct = float(_crows[0].get("pct") or 0.0)
                except Exception:
                    _res_toppct = 0.0
                if _res_toppct < _B20_IDLE_CPU_MAX:
                    if _sk_after is not None and _sk_after["culprit"] == owner and _sk_after_uimatch:
                        culprit = owner; py_mod = owner; py_file = ""; py_line = -1
                        src = "anr/ui-thread-scope-residual+selfkill-aftermath-corroborated"; conf = "medium"
                        _log("Block#20 +MG: residual scope-owner %r SOVPAL s culprit nejtralizovannogo %s NA UI-tid=%s (delta=%dms) -> corroboration low->medium (owner NE zamenen)" % (owner, _sk_after.get("vector"), _sk_after.get("tid"), int(_sk_after.get("delta_ms") or 0)))
                    else:
                        culprit = "host/undetermined"; py_mod = "host/undetermined"; py_file = ""; py_line = -1
                        src = "anr/ui-thread-scope-residual?idle"; conf = "low"
                        _log("Block#20 +IY #4: no py-frame; scope-owner %r but CPU idle (top=%.1f%% < %.1f) no op -> host/undetermined, plugin NOT attributed (UI stall %dms)" % (owner, _res_toppct, _B20_IDLE_CPU_MAX, int(waited_ms)))
                else:
                    src = "anr/ui-thread-scope-residual"; conf = "low"
                    _div = (" (op-stamp -> %r/%s instead)" % (_opinfo["owner"], _opinfo["domain"])) if _opinfo is not None else " (no corroborating op-stamp)"
                    _log("Block#20: no py-frame; scope-owner -> %r uncorroborated -> scope-residual conf=low%s (UI stall %dms)" % (owner, _div, int(waited_ms)))
        elif _opinfo is not None and not _op_stale and _host_render is None:
            culprit = _opinfo["owner"]; py_mod = _opinfo["owner"]; py_file = ""; py_line = -1
            src = "anr/ui-thread-op:%s" % _opinfo["domain"]; conf = "low"
            _log("Block#20: no py-frame/scope; op-stamp fallback -> %r (domain=%s api=%s age=%dms, UI stall %dms)" % (_opinfo["owner"], _opinfo["domain"], _opinfo["api"], int(_opinfo["age_ms"]), int(waited_ms)))
            if _sk is not None and _sk.get("culprit") == _opinfo["owner"]:
                src = src + "+selfkill"; conf = "medium"
                _log("Block#20 +LW: op-stamp owner %r совпал с culprit заблокированного kill (delta=%dms) -> conf=medium" % (_opinfo["owner"], int(_sk.get("delta_ms") or 0)))
            try:
                _crows2, _cmeta2 = _b29_fresh_top(160)
                _cw = _b29_top_owned_by(_crows2, _opinfo["owner"])
                if _cw is not None:
                    _crows = _crows2; _cmeta = _cmeta2
                    src = "anr/ui-thread-op:%s+cpu" % _opinfo["domain"]; conf = "medium"
                    _log("Block#29 +CR: op-stamp owner %r corroborated by hot bg thread (tid=%s name=%s pct=%.1f%%) -> conf=medium" % (_opinfo["owner"], _cw["tid"], _cw["name"], _cw["pct"]))
            except Exception as _ecr:
                try: _log("Block#29 +CR corroborate err: %r" % _ecr)
                except Exception: pass
        elif _sk is not None and (_sk_tid is None or _ui_tid_n is None):
            culprit = _sk["culprit"]; py_mod = culprit; py_file = ""; py_line = -1
            src = "anr/ui-thread-selfkill-blocked?window"; conf = "medium"
            _log("Block#20 +LW: нет scope/op-сигналов; заблокированный %s от %r в окне начала стойла (delta=%dms, tid недоступен) -> fallback conf=medium" % (_sk.get("vector"), _sk["culprit"], int(_sk.get("delta_ms") or 0)))
        else:
            _hog = None
            try:
                _hog = _b29_hog_culprit(_crows, _cmeta)
            except Exception as _e29:
                try: _log("Block#29: hog probe err: %r" % _e29)
                except Exception: pass
            if _hog is None:
                try:
                    _frows, _fmeta = _b29_fresh_top(160)
                    _fhog = _b29_hog_culprit(_frows, _fmeta)
                    if _fhog is not None:
                        _hog = _fhog; _crows = _frows; _cmeta = _fmeta
                        _log("Block#29: rolling snapshot missed hog -> fresh on-demand sample caught %r (tid=%s pct=%.1f%%)" % (_fhog["owner"], _fhog["tid"], _fhog["pct"]))
                    else:
                        try:
                            _fdiag = "; ".join("tid=%s/%s pct=%.1f owner=%s" % (r["tid"], r["name"], r["pct"], r.get("owner")) for r in (_frows or [])[:8])
                            _log("Block#29 fresh(retry): rows=%d win=%sms | %s" % (len(_frows or []), (_fmeta or {}).get("win_ms"), _fdiag or "<none>"))
                        except Exception: pass
                except Exception as _ef29:
                    try: _log("Block#29: fresh-sample err: %r" % _ef29)
                    except Exception: pass
            if _hog is not None:
                culprit = _hog["owner"]; py_mod = _hog["owner"]; py_file = ""; py_line = -1
                src = "anr/cpu-hog"; conf = "low"
                _log("Block#20: no py-frame/scope/op; CPU-hog fallback -> %r (tid=%s name=%s pct=%.1f%% age=%sms, UI stall %dms)" % (
                    _hog["owner"], _hog["tid"], _hog["name"], _hog["pct"], _hog.get("age_ms"), int(waited_ms)))
            else:
                try:
                    _diag_rows = "; ".join("tid=%s/%s pct=%.1f owner=%s" % (r["tid"], r["name"], r["pct"], r.get("owner")) for r in (_crows or [])[:8])
                    _log("Block#29 diag(suppress): rows=%d age=%sms win=%sms | %s" % (len(_crows or []), (_cmeta or {}).get("age_ms"), (_cmeta or {}).get("win_ms"), _diag_rows or "<none>"))
                except Exception as _ed29:
                    _log("Block#29 diag err: %r" % _ed29)
                _ui_lin = globals().get("_B33_UI_TID")
                _mid = list(globals().get("_DN_MIDSTALL_SNAPSHOT") or [])
                _chosen = _dn_choose_host_sample(_mid)
                if _chosen is not None:
                    _jframes = _chosen.get("jframes"); _plugin_n = int(_chosen.get("plugin_n") or 0)
                    _component = _chosen.get("component"); _kstate = _chosen.get("kernel")
                    _phase = "mid-stall"; _sample_held_ms = _chosen.get("held_ms")
                else:
                    _jframes, _plugin_n, _component = _dn_capture_java_ui_stack()
                    _kstate = _dn_capture_kernel_state(_ui_lin)
                    _phase = "post-hoc"; _sample_held_ms = None
