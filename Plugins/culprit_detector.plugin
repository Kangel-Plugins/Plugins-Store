                    v["java_crash_ref"] = {"src": _c5v.get("src"), "exc_cls": _c5v.get("exc_cls"), "thread": _c5v.get("thread"), "dt_ms": _c5dt}
                    v.pop("early_boot_death", None); v.pop("early_death_streak", None)
