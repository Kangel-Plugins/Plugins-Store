def _b41_bind(lib, c):
    global _THR_OWN_OK, _WREF_OK, _LEAK_FEED_DIM_OK
    try:
        if hasattr(lib, "cd_thr_live_topn") and hasattr(lib, "cd_thr_adopt"):
            lib.cd_thr_adopt.argtypes = [c.c_int32]; lib.cd_thr_adopt.restype = c.c_int
            lib.cd_thr_live.argtypes = [c.c_int32]; lib.cd_thr_live.restype = c.c_int64
            lib.cd_thr_live_untagged.restype = c.c_int64
            lib.cd_thr_tracked_total.restype = c.c_int64
            lib.cd_thr_adopted_total.restype = c.c_int64
            lib.cd_thr_track_ok.restype = c.c_int
            lib.cd_thr_live_topn.argtypes = [c.POINTER(c.c_int32), c.POINTER(c.c_int64), c.c_int32]
            lib.cd_thr_live_topn.restype = c.c_int
            _THR_OWN_OK = True
    except Exception:
        _THR_OWN_OK = False
    try:
        if hasattr(lib, "cd_wref_install") and hasattr(lib, "cd_wref_live_topn"):
            lib.cd_wref_install.restype = c.c_int
            lib.cd_wref_running.restype = c.c_int
            lib.cd_wref_total.restype = c.c_int64
            lib.cd_wref_del_total.restype = c.c_int64
            lib.cd_wref_del_untracked.restype = c.c_int64
            lib.cd_wref_overflow.restype = c.c_int64
            lib.cd_wref_live_untagged.restype = c.c_int64
            lib.cd_wref_live_total.restype = c.c_int64
            lib.cd_wref_live.argtypes = [c.c_int32]; lib.cd_wref_live.restype = c.c_int64
            lib.cd_wref_live_topn.argtypes = [c.POINTER(c.c_int32), c.POINTER(c.c_int64), c.c_int32]
            lib.cd_wref_live_topn.restype = c.c_int
            _WREF_OK = True
    except Exception:
        _WREF_OK = False
    try:
        if hasattr(lib, "cd_leak_feed_dim"):
            lib.cd_leak_feed_dim.argtypes = [c.c_int32, c.c_int64]; lib.cd_leak_feed_dim.restype = c.c_int
            _LEAK_FEED_DIM_OK = True
    except Exception:
        _LEAK_FEED_DIM_OK = False

def _b41_wref_install():
    if not (_B41_ON and _WREF_OK and _NLIB is not None):
        return
    try:
        rc = int(_NLIB.cd_wref_install())
        _log("Block#41 +SZ(1): JNI weak-global attribution %s (rc=%d)" % ("ON" if rc > 0 else "OFF", rc))
    except Exception as e:
        _log("Block#41 +SZ(1): cd_wref_install err: %s" % e)

def _b41_thr_adopt(pid):
    if not (_THR_OWN_OK and _NLIB is not None) or not pid:
        return
    try:
        idx = int(_intern(pid))
        if idx >= 0:
            _NLIB.cd_thr_adopt(ctypes.c_int32(idx))
    except Exception:
        pass

def _b41_name(idx):
    nm = None
    try: nm = _resolve_idx(idx)
    except Exception: nm = None
    if not nm:
        try: nm = _resolve_idx_durable(idx)
        except Exception: nm = None
    if (not nm) or nm in (_SELF_ID, __id__, "__regtest__", "culprit_detector"):
        return None
    return nm

def _b41_topn(fn):
    out = {}
    try:
        try: n = max(48, len(_IDX_PID) + 8)
        except Exception: n = 64
        if n > 4096: n = 4096
        ia = (ctypes.c_int32 * n)(); ca = (ctypes.c_int64 * n)()
        got = int(fn(ia, ca, ctypes.c_int32(n)))
        for i in range(max(0, min(got, n))):
            idx = int(ia[i]); cnt = int(ca[i])
            if idx < 0 or cnt <= 0:
                continue
            nm = _b41_name(idx)
            if nm:
                out[nm] = out.get(nm, 0) + cnt
    except Exception:
        pass
    return out

def _b41_feed():
    if not (_B41_ON and _LEAK_FEED_DIM_OK and _NLIB is not None):
        return
    now = int(time.time() * 1000)
    if now - _B41_FEED_LAST[0] < 25000:
        return
    _B41_FEED_LAST[0] = now
    try:
        b = int(_sys.getallocatedblocks())
        if b > 0:
            _NLIB.cd_leak_feed_dim(ctypes.c_int32(7), ctypes.c_int64(b))
    except Exception:
        pass
    if _B41_DEBUG_CLS[0] is not False:
        try:
            if _B41_DEBUG_CLS[0] is None:
                _B41_DEBUG_CLS[0] = jclass("android.os.Debug")
            v = int(_B41_DEBUG_CLS[0].getBinderProxyObjectCount())
            if v >= 0:
                _NLIB.cd_leak_feed_dim(ctypes.c_int32(6), ctypes.c_int64(v))
        except Exception:
            _B41_DEBUG_CLS[0] = False

def _b41_own_sample():
    if not (_B41_ON and _NLIB is not None):
        return
    now = int(time.time() * 1000)
    if now - _B41_OWN_LAST[0] < _B41_OWN_PERIOD_MS:
        return
    _B41_OWN_LAST[0] = now
    if _THR_OWN_OK:
        try:
            _B41_THR_HIST.append((now, _b41_topn(_NLIB.cd_thr_live_topn)))
            if len(_B41_THR_HIST) > _B41_OWN_KEEP:
                del _B41_THR_HIST[:len(_B41_THR_HIST) - _B41_OWN_KEEP]
        except Exception:
            pass
    if _WREF_OK:
        try:
            if int(_NLIB.cd_wref_running()):
                m = _b41_topn(_NLIB.cd_wref_live_topn)
                _B41_WREF_HIST.append((now, m))
                if len(_B41_WREF_HIST) > _B41_OWN_KEEP:
                    del _B41_WREF_HIST[:len(_B41_WREF_HIST) - _B41_OWN_KEEP]
                _b41_wref_guard(now, m)
        except Exception:
            pass
    try: _b41_census(False)
    except Exception: pass

def _b41_owner_attr(dims, dim_key, hist, min_growth):
    d = None
    for x in dims:
        if x.get("dim") == dim_key and x.get("leaking"):
            d = x
            break
    if not d:
        return None
    span_ms = int(float(d.get("span_s") or 0.0) * 1000.0)
    growth = int(d.get("growth") or 0)
    if span_ms <= 0 or growth <= 0 or len(hist) < 2:
        return None
    now = int(time.time() * 1000)
    lo = now - span_ms - _B41_OWN_PERIOD_MS
    win = [e for e in list(hist) if e[0] >= lo]
    if len(win) < 2:
        return None
    t0, first = win[0]
    t1, last = win[-1]
    if (t1 - t0) < int(span_ms * _B41_COVER):
        return None
    best = None; best_g = 0
    for k, v in last.items():
        g = int(v) - int(first.get(k, 0))
        if g > best_g:
            best, best_g = k, g
    if (not best) or best_g < min_growth:
        return None
    share = float(best_g) / float(growth)
    if share < _B41_SHARE:
        return None
    return {"culprit": best, "growth": int(best_g), "dim_growth": int(growth),
            "share": round(min(share, 9.99), 3), "first": int(first.get(best, 0)),
            "last": int(last.get(best, 0)), "window_ms": int(t1 - t0)}

def _b41_append(name, rec, maxn=20):
    p = _data_path(name)
    if not p:
        return False
    _PERSIST_IO_LOCK.acquire()
    try:
        cur = []
        if os.path.exists(p):
            try:
                with open(p, "r", encoding="utf-8") as f:
                    cur = list(json.load(f))
            except Exception:
                cur = []
        cur.append(rec)
        _atomic_json_write(p, cur, maxn)
        return True
    except Exception:
        return False
    finally:
        try: _PERSIST_IO_LOCK.release()
        except Exception: pass

def _b41_wref_guard(now, m):
    try:
        total = int(_NLIB.cd_wref_live_total())
    except Exception:
        return
    if total < int(_B41_WREF_CAP * _B41_WREF_WARN_FRAC):
        return
    if now - _B41_WREF_LAST[0] < _B41_WREF_DEDUP_MS:
        return
    _B41_WREF_LAST[0] = now
    top = sorted(m.items(), key=lambda kv: -kv[1])[:5]
    best, bn = (top[0] if top else (None, 0))
    share = (float(bn) / float(total)) if total > 0 else 0.0
    if best and share >= 0.6: conf = "high"
    elif best and share >= 0.3: conf = "medium"
    else: conf = "low"
    try: untagged = int(_NLIB.cd_wref_live_untagged())
    except Exception: untagged = 0
    pair = _ta_gref_pair(total)
    pxc = None
    wsrc = "native-owner" if conf != "low" else None
    if conf == "low" and untagged >= int(total * 0.5):
        try: pxc = _ta_proxy_census()
        except Exception: pxc = None
        if pxc and pxc.get("culprit"):
            pb = int(pxc.get("count") or 0)
            if pb >= int(untagged * 0.5) and float(pxc.get("share") or 0.0) >= 0.6:
                best, bn = pxc["culprit"], pb
                share = (float(pb) / float(total)) if total > 0 else 0.0
                conf = "medium"
                wsrc = "py-proxy-census"
    rec = {"had_leak": True, "verdict": "JNI WEAK-REF TABLE PRESSURE",
           "culprit": (best if conf != "low" else "client (host process)"),
           "suspect": best, "confidence": conf, "kind": "jni-weakref-pressure",
           "live_weak": total, "cap": _B41_WREF_CAP, "pct": round(100.0 * total / _B41_WREF_CAP, 1),
           "owner_live": int(bn), "share": round(share, 4), "untagged_live": untagged, "top": top,
           "partial": True,
           "reason": "JNI weak-global refs (NewWeakGlobalRef без DeleteWeakGlobalRef) заполнили %.0f%% таблицы ART (лимит %d -> abort)" % (100.0 * total / _B41_WREF_CAP, _B41_WREF_CAP),
           "exc_cls": "WeakGlobalRefPressure", "exc_msg": "weak globals live=%d/%d" % (total, _B41_WREF_CAP),
           "ts": now, "event_type": "jni_weakref_pressure", "dropbox_tag": "app_memory_leak",
           "tombstone_norm_version": 1}
    rec["culprit_src"] = wsrc
    if pair:
        rec["gref_pair"] = pair
        if pair.get("hint"):
            rec["reason"] = rec["reason"] + "; " + pair["hint"]
    if pxc:
        rec["py_proxy_census"] = pxc
    if _b41_append(_B41_WREF_FILE, rec):
        _log("Block#41 +SZ(1): WEAK-REF PRESSURE live=%d/%d (%.0f%%) top=%s conf=%s suspect=%r src=%s" % (
            total, _B41_WREF_CAP, 100.0 * total / _B41_WREF_CAP, top[:3], conf, best, wsrc))
        if pair:
            _log("  +TA(2): global live=%d (untagged=%d) / weak live=%d -> ratio=%.2f paired=%s" % (
                pair["gref_live"], pair["gref_untagged"], total, pair["ratio"], pair["paired"]))
        if pxc:
            _log("  +TA(2): перепись прокси-объектов: лидер=%r count=%s share=%s types=%s (%sms)" % (
                pxc.get("culprit"), pxc.get("count"), pxc.get("share"), pxc.get("top_types"), pxc.get("ms")))

def _ta_gref_pair(wtotal):
    try:
        if not (hasattr(_NLIB, "cd_gref_live_total") and hasattr(_NLIB, "cd_gref_live_untagged")):
            return None
        _NLIB.cd_gref_live_total.restype = ctypes.c_int64
        _NLIB.cd_gref_live_untagged.restype = ctypes.c_int64
        gt = int(_NLIB.cd_gref_live_total())
        gu = int(_NLIB.cd_gref_live_untagged())
    except Exception:
        return None
    if gt <= 0 or wtotal <= 0:
        return None
    r = float(gt) / float(wtotal)
    out = {"gref_live": gt, "gref_untagged": gu, "ratio": round(r, 3), "paired": bool(r >= 0.7)}
    if r >= 0.7:
        out["hint"] = "каждый Python-объект dynamic_proxy/static_proxy (Chaquopy) держит 1 global + 1 weak ref: совместный рост обеих таблиц = накопление прокси-объектов, которые удерживает список/Java-коллекция"
    return out

def _ta_is_bridge_type(t):
    try:
        mm = getattr(type(t), "__module__", "") or ""
        if mm == "java" or mm.startswith("java.") or "chaquopy" in mm:
            return True
        for b in getattr(t, "__mro__", ())[1:]:
            bm = getattr(b, "__module__", "") or ""
            if bm == "java" or bm.startswith("java.") or "chaquopy" in bm:
                return True
    except Exception:
        pass
    return False

def _ta_proxy_census():
    t0 = time.time()
    try:
        cnt = collections.Counter(map(type, _gc.get_objects()))
    except Exception:
        return None
    per = {}; tops = {}
    for t, n in cnt.items():
        try: mn = t.__module__
        except Exception: continue
        if not isinstance(mn, str):
            continue
        pid = _B41_MOD_PID.get(mn, 0)
        if pid == 0:
            try: pid = _pid_of_module_pkg(mn)
            except Exception: pid = None
            if pid and len(_B41_MOD_PID) < 4096:
                _B41_MOD_PID[mn] = pid
        if (not pid) or pid in (_SELF_ID, __id__):
            continue
        if not _ta_is_bridge_type(t):
            continue
        per[pid] = per.get(pid, 0) + int(n)
        tops.setdefault(pid, []).append((int(n), getattr(t, "__qualname__", "?")))
    ms = int((time.time() - t0) * 1000)
    if not per:
        return {"culprit": None, "ms": ms}
    tot = sum(per.values())
    best = max(per.items(), key=lambda kv: kv[1])
    return {"culprit": best[0], "count": int(best[1]), "share": round(float(best[1]) / float(tot), 3),
            "top_types": sorted(tops.get(best[0], []), reverse=True)[:4], "plugins": len(per), "ms": ms}

def _b41_census(force):
    if not _B41_ON:
        return None
    now = int(time.time() * 1000)
    try: blocks = int(_sys.getallocatedblocks())
    except Exception: blocks = 0
    if not force:
        if _B41_CENSUS_LAST[0] == 0:
            _B41_CENSUS_LAST[0] = now - _B41_CENSUS_GAP_MS + 300000
            _B41_CENSUS_LAST[1] = blocks
            return None
        if now - _B41_CENSUS_LAST[0] < _B41_CENSUS_GAP_MS:
            return None
        if _B41_CENSUS_HIST and (blocks - _B41_CENSUS_LAST[1]) < _B41_CENSUS_TRIGGER:
            return None
    _B41_CENSUS_LAST[0] = now
    _B41_CENSUS_LAST[1] = blocks
    t0 = time.time()
    try:
        cnt = collections.Counter(map(type, _gc.get_objects()))
    except Exception:
        return None
    per = {}; tops = {}
    for t, n in cnt.items():
        try: mn = t.__module__
        except Exception: continue
        if not isinstance(mn, str):
            continue
        pid = _B41_MOD_PID.get(mn, 0)
        if pid == 0:
            try: pid = _pid_of_module_pkg(mn)
            except Exception: pid = None
            if pid and len(_B41_MOD_PID) < 4096:
                _B41_MOD_PID[mn] = pid
        if (not pid) or pid in (_SELF_ID, __id__):
            continue
        per[pid] = per.get(pid, 0) + int(n)
        tl = tops.setdefault(pid, [])
        tl.append((int(n), getattr(t, "__qualname__", "?")))
    for pid in tops:
        tops[pid] = sorted(tops[pid], reverse=True)[:4]
    ent = (now, per, tops, blocks, int((time.time() - t0) * 1000))
    _B41_CENSUS_HIST.append(ent)
    if len(_B41_CENSUS_HIST) > 12:
        del _B41_CENSUS_HIST[:len(_B41_CENSUS_HIST) - 12]
    return ent

def _b41_census_attr(dims):
    d = None
    for x in dims:
        if x.get("dim") == "pyblocks" and x.get("leaking"):
            d = x
            break
    if not d:
        return None
    base = None
    span_ms = int(float(d.get("span_s") or 0.0) * 1000.0)
    lo = int(time.time() * 1000) - span_ms - _B41_CENSUS_GAP_MS
    for e in _B41_CENSUS_HIST:
        if e[0] >= lo:
            base = e
            break
    cur = _b41_census(True)
    if cur is None or base is None or base is cur:
        return None
    growth = int(d.get("growth") or 0)
    best = None; bg = 0
    for pid, n in cur[1].items():
        g = int(n) - int(base[1].get(pid, 0))
        if g > bg:
            best, bg = pid, g
    if (not best) or bg < _B41_CENSUS_MIN or growth <= 0:
        return None
    share = float(bg) / float(growth)
    if share < _B41_CENSUS_SHARE:
        return None
    return {"culprit": best, "growth": int(bg), "dim_growth": growth, "share": round(min(share, 9.99), 3),
            "first": int(base[1].get(best, 0)), "last": int(cur[1].get(best, 0)),
            "window_ms": int(cur[0] - base[0]), "top_types": cur[2].get(best, []), "census_ms": cur[4]}

def _b41_pyheap_detail():
    out = {}
    try: out["allocated_blocks"] = int(_sys.getallocatedblocks())
    except Exception: pass
    try: out["gc_garbage"] = len(_gc.garbage)
    except Exception: pass
    try: out["gc_counts"] = list(_gc.get_count())
    except Exception: pass
    try:
        tids = set(os.listdir("/proc/self/task"))
        dummy = stale = 0
        for t in list(getattr(threading, "_active", {}).values()):
            if isinstance(t, getattr(threading, "_DummyThread", ())):
                dummy += 1
                nid = getattr(t, "native_id", None)
                if nid is not None and str(nid) not in tids:
                    stale += 1
        out["dummy_threads"] = dummy
        out["dummy_threads_stale"] = stale
    except Exception:
        pass
    return out

def _b41_enrich_leak(rec, dims):
    ld = rec.get("leaking_dims") or []
    out = {}
    if "threads" in ld and _THR_OWN_OK:
        a = _b41_owner_attr(dims, "threads", _B41_THR_HIST, _B41_THR_MIN)
        if a: out["threads"] = a
    if "jweak" in ld and _WREF_OK:
        a = _b41_owner_attr(dims, "jweak", _B41_WREF_HIST, _B41_WREF_MIN)
        if a: out["jweak"] = a
    if "pyblocks" in ld:
        try: rec["python_heap"] = _b41_pyheap_detail()
        except Exception: pass
        a = _b41_census_attr(dims)
        if a: out["pyblocks"] = a
    if "binder" in ld:
        try:
            Dbg = _B41_DEBUG_CLS[0] or jclass("android.os.Debug")
            rec["binder_counts"] = {"proxy": int(Dbg.getBinderProxyObjectCount()),
                                    "local": int(Dbg.getBinderLocalObjectCount()),
                                    "death": int(Dbg.getBinderDeathObjectCount())}
        except Exception:
            pass
    if out:
        rec["owner_attribution"] = out
    if rec.get("kind") != "host":
        if out:
            _log("Block#41 +SZ: owner side-info (kind=%s kept): %s" % (rec.get("kind"), out))
        if "binder" in ld and rec.get("reason_detail") == "host_unattributed":
            rec["reason_detail"] = "binder_proxy_leak"
        return
    kinds = (("threads", "plugin-thread", "live threads"), ("jweak", "plugin-weakref", "live JNI weak refs"),
             ("pyblocks", "plugin-python-objects", "Python objects"))
    for key, kind, what in kinds:
        a = out.get(key)
        if not a:
            continue
        rec["reason_detail_base"] = rec.get("reason_detail") or "host_unattributed"
        rec["culprit"] = a["culprit"]
        rec["kind"] = kind
        rec["reason_detail"] = "%s_owner: %s +%d %s (%d->%d) = %.0f%% of +%d in window" % (
            key, a["culprit"], a["growth"], what, a["first"], a["last"], 100.0 * min(a["share"], 1.0), a["dim_growth"])
        hi = (ld == [key]) and a["share"] >= 0.8 and key != "pyblocks"
        rec["confidence"] = "high" if hi else "medium"
        _log("Block#41 +SZ: %s leak attributed -> %s (%s, conf=%s)" % (key, a["culprit"], rec["reason_detail"], rec["confidence"]))
        return
    for key, label in (("jweak", "jweak_leak"), ("binder", "binder_proxy_leak"), ("pyblocks", "python_heap_leak")):
        if key in ld and rec.get("reason_detail") == "host_unattributed":
            for d in dims:
                if d.get("dim") == key:
                    rec["reason_detail"] = "%s: %d->%d (+%d)" % (label, int(d.get("first") or 0), int(d.get("last") or 0), int(d.get("growth") or 0))
                    break
            break

def _b41_mod_owned(v, g):
    try:
        for a in list(vars(v).values()):
            f = getattr(a, "__func__", a)
            if getattr(f, "__globals__", None) is g:
                return True
    except Exception:
        pass
    return False

def _b41_plugin_objects(pid, with_funcs=False):
    mods = []; clss = []; fns = []
    _ft = type(_b41_mod_owned)
    for nm, mod in list(_sys.modules.items()):
        if mod is None:
            continue
        try:
            if _pid_of_module_pkg(nm) != pid:
                continue
        except Exception:
            continue
        mods.append((nm, mod))
        try:
            g = vars(mod)
            mn = (nm, g.get("__name__"))
            for k, v in list(g.items()):
                if isinstance(v, type):
                    if getattr(v, "__module__", None) in mn or _b41_mod_owned(v, g):
                        clss.append((nm + "." + str(getattr(v, "__qualname__", k)), v))
                elif with_funcs and isinstance(v, _ft) and getattr(v, "__globals__", None) is g:
                    fns.append((nm + "." + str(getattr(v, "__qualname__", k)), v))
        except Exception:
            pass
    if with_funcs:
        return mods, clss, fns
    return mods, clss

def _b41_pend():
    return _xrl_shared("b41_retain_pending", dict, lambda o: isinstance(o, dict))

_TJ_UNLOAD_WIN_MS = 900000
def _tg_recent_unload(pid):
    try:
        now = int(time.time() * 1000)
        for rec in list(_b41_pend().values()):
            if isinstance(rec, dict) and rec.get("pid") == pid and now - int(rec.get("unload_ts") or 0) < _TJ_UNLOAD_WIN_MS:
                return True
    except Exception:
        pass
    return False

def _b41_retain_track(pid, why="load"):
    if not (_B41_ON and pid) or pid in (_SELF_ID, __id__):
        return
    try:
        mods, clss, fns = _b41_plugin_objects(pid, True)
        wm = []; wc = []; wf = []
        for nm, m in mods:
            try: wm.append((nm, weakref.ref(m)))
            except TypeError: pass
        for q, c in clss[:64]:
            try: wc.append((q, weakref.ref(c)))
            except TypeError: pass
        for q, f in fns[:_B41_FUNC_MAX]:
            try: wf.append((q, weakref.ref(f)))
            except TypeError: pass
        if wm or wc or wf:
            with _B41_RETAIN_LOCK:
                _B41_RETAIN[pid] = {"mods": wm, "cls": wc, "fn": wf, "t": int(time.time() * 1000)}
            _log("Block#41 +TA(3): удержание: отслеживаю %s [%s] (модулей=%d классов=%d функций=%d)" % (pid, why, len(wm), len(wc), len(wf)))
        elif why != "load" and not _tg_recent_unload(pid):
            _log("Block#41 +TA(3): удержание: %s [%s] -- модули плагина не найдены в sys.modules, отслеживание пропущено" % (pid, why))
    except Exception:
        pass

def _b41_retain_unloaded(pid):
    if not (_B41_ON and pid):
        return
    with _B41_RETAIN_LOCK:
        rec = _B41_RETAIN.pop(pid, None)
    if not rec:
        if not _tg_recent_unload(pid):
            _log("Block#41 +TA(3): %s выгружен, но не отслеживался -- проверка удержания пропущена" % pid)
        return
    rec["unload_ts"] = int(time.time() * 1000)
    rec["pid"] = pid
    rec["pkey"] = "%s@%d" % (pid, rec["unload_ts"])
    rec["gen"] = _B41_GEN
    rec["attempt"] = 0
    try:
        _b41_pend()[rec["pkey"]] = rec
    except Exception:
        pass
    try:
        t = threading.Timer(_B41_RETAIN_DELAYS[0], _b41_retain_check, args=(pid, rec, 0))
        t.daemon = True
        t.start()
        _log("Block#41 +TA(3): %s выгружен -> проверка удержания через %.0fс (модулей=%d классов=%d функций=%d)" % (
            pid, _B41_RETAIN_DELAYS[0], len(rec.get("mods") or []), len(rec.get("cls") or []), len(rec.get("fn") or [])))
    except Exception as _ete:
        _log("Block#41 +TA(3): таймер проверки удержания не запущен: %s" % _ete)

def _b41_retain_orphan():
    n = 0
    try:
        for k, rec in list(_b41_pend().items()):
            if isinstance(rec, dict) and rec.get("gen") == _B41_GEN:
                rec["gen"] = "orphan"
                n += 1
        if n:
            _log("Block#41 +TD(3): %d незавершённых проверок удержания оставлено следующему инстансу детектора" % n)
    except Exception:
        pass
    return n

def _b41_retain_adopt():
    if not _B41_ON:
        return 0
    n = 0
    try:
        pend = _b41_pend()
        now = int(time.time() * 1000)
        for k, rec in list(pend.items()):
            try:
                if not isinstance(rec, dict) or rec.get("gen") == _B41_GEN:
                    continue
                pid = rec.get("pid"); ut = int(rec.get("unload_ts") or 0)
                a = int(rec.get("attempt") or 0)
                while a + 1 < len(_B41_RETAIN_DELAYS) and (now - ut) / 1000.0 >= _B41_RETAIN_DELAYS[a + 1]:
                    a += 1
                if not pid or not ut or now - ut > 3600000 or a >= len(_B41_RETAIN_DELAYS):
                    pend.pop(k, None)
                    continue
                rec["gen"] = _B41_GEN
                delay = max(5.0, _B41_RETAIN_DELAYS[a] - (now - ut) / 1000.0)
                t = threading.Timer(delay, _b41_retain_check, args=(pid, rec, a))
                t.daemon = True
                t.start()
                n += 1
                _log("Block#41 +TB(4): проверка удержания %s подхвачена после reload детектора (выгружен %.0fс назад, попытка %d, через %.0fс)" % (pid, (now - ut) / 1000.0, a, delay))
            except Exception:
                pass
    except Exception as e:
        _log("Block#41 +TB(4) adopt err: %s" % e)
    return n

def _b41_stale(pid, rec):
    cur_mods, cur_cls, cur_fns = _b41_plugin_objects(pid, True)
    cur_ids = set(id(m) for _n, m in cur_mods) | set(id(c) for _q, c in cur_cls) | set(id(f) for _q, f in cur_fns)
    try:
        all_mods = set(id(m) for m in list(_sys.modules.values()) if m is not None)
    except Exception:
        all_mods = set()
    out = []
    for nm, wr in rec.get("mods") or []:
        o = wr()
        if o is not None and id(o) not in cur_ids and id(o) not in all_mods:
            out.append(("module", nm, o))
    for q, wr in rec.get("cls") or []:
        o = wr()
        if o is not None and id(o) not in cur_ids:
            out.append(("class", q, o))
    for q, wr in rec.get("fn") or []:
        o = wr()
        if o is not None and id(o) not in cur_ids:
            out.append(("function", q, o))
    return out

def _te_fn_holds(r, fn, fids):
    try:
        sf = getattr(r, "__self__", None)
        if sf is not None and id(sf) in fids:
            return True
        for t in (getattr(fn, "__closure__", None), getattr(fn, "__defaults__", None), getattr(fn, "__kwdefaults__", None)):
            if t is not None and id(t) in fids:
                return True
        for c in (getattr(fn, "__closure__", None) or ()):
            if id(c) in fids:
                return True
        for x in (getattr(fn, "__defaults__", None) or ()):
            if id(x) in fids:
                return True
        for x in list((getattr(fn, "__kwdefaults__", None) or {}).values()):
            if id(x) in fids:
                return True
        d = getattr(fn, "__dict__", None)
        if d is not None and id(d) in fids:
            return True
        g = getattr(fn, "__globals__", None)
        return not (g is not None and id(g) in fids)
    except Exception:
        return True

_TH_EXT_MAX = 32
def _th_ext_roots(cand):
    out = []
    if not cand:
        return out
    try:
        ctl = object()
        objs = [c[2] for c in cand]
        objs.append(ctl)
        ctl = None
        idm = {}
        for k in range(len(objs)):
            idm.setdefault(id(objs[k]), k)
        cnt = [0] * len(objs)
        me = _sys._getframe()
        rs = _gc.get_referrers(*objs)
        for r in rs:
            if r is me or r is idm:
                continue
            for x in _gc.get_referents(r):
                k = idm.get(id(x))
                if k is not None:
                    cnt[k] += 1
            x = None
        rs = None
        r = None
        me = None
        last = len(objs) - 1
        base = _sys.getrefcount(objs[last]) - cnt[last]
        for k in range(last):
            ext = (_sys.getrefcount(objs[k]) - cnt[k]) - base
            if ext > 0:
                out.append("L%d %s held outside Python GC (+%d ref: Java/JNI, C-ext or live thread local)" % (cand[k][0], cand[k][1], ext))
                if len(out) >= 4:
                    break
    except Exception:
        pass
    return out

def _b41_holders(targets):
    import types as _types
    t0 = time.time()
    me = _sys._getframe()
    dg = globals()
    mine = {id(me), id(targets)}
    seen = set(id(t) for t in targets)
    frontier = list(targets)
    own = set()
    for _t in targets:
        try: own.add(getattr(_t, "__module__", None))
        except Exception: pass
    own.discard(None)
    own_g = set()
    for _t in targets:
        try:
            _g = getattr(_t, "__globals__", None)
            if isinstance(_g, dict):
                own_g.add(id(_g))
            elif isinstance(_t, type):
                for _a in list(vars(_t).values()):
                    _g = getattr(getattr(_a, "__func__", _a), "__globals__", None)
                    if isinstance(_g, dict):
                        own_g.add(id(_g))
            elif isinstance(_t, _types.ModuleType):
                own_g.add(id(vars(_t)))
        except Exception:
            pass
    cand = []
    cand_t = []
    for _t in targets:
        if isinstance(_t, (_types.FunctionType, _types.ModuleType)):
            cand_t.append((0, ("module %s" if isinstance(_t, _types.ModuleType) else "function %s") % getattr(_t, "__qualname__", getattr(_t, "__name__", "?")), _t))
    roots = []
    other = {}
    for lvl in range(_B41_HOLDER_LEVELS):
        if not frontier or (time.time() - t0) > _B41_HOLDER_BUDGET_S:
            break
        try:
            refs = _gc.get_referrers(*frontier)
        except Exception:
            break
        mine.add(id(refs)); mine.add(id(frontier))
        fids = set(id(x) for x in frontier)
        nxt = []
        for r in refs:
            if id(r) in seen or id(r) in mine:
                continue
            seen.add(id(r))
            try:
                if r is dg:
                    ks = [k for k, v in list(dg.items()) if id(v) in fids and not isinstance(v, (_types.FunctionType, _types.BuiltinFunctionType, _types.MethodType, type, _types.ModuleType))][:3]
                    if ks:
                        roots.append("detector global %s" % ",".join(ks))
                    continue
                if isinstance(r, _types.FrameType):
                    roots.append("frame path %s (%s:%d)" % (r.f_code.co_name, r.f_code.co_filename.rsplit("/", 1)[-1], r.f_lineno))
                    continue
                if isinstance(r, _types.ModuleType):
                    hp = None
                    try: hp = _pid_of_module_pkg(r.__name__)
                    except Exception: hp = None
                    if r.__name__ == __name__ or hp in (_SELF_ID, __id__):
                        continue
                    roots.append("module %s global" % (hp or r.__name__))
                    if hp: other[hp] = other.get(hp, 0) + 1
                    continue
                if isinstance(r, (_types.FunctionType, _types.MethodType)):
                    fn = getattr(r, "__func__", r)
                    fm = getattr(fn, "__module__", None)
                    _sf = getattr(r, "__self__", None)
                    if (_sf is not None and getattr(type(_sf), "__module__", None) in own) or getattr(fn, _B10_FLAG, False) or getattr(fn, _B_TAGGED_FLAG, False):
                        if len(cand) < _TH_EXT_MAX:
                            cand.append((lvl, ("detector wrapper %s" if (getattr(fn, _B10_FLAG, False) or getattr(fn, _B_TAGGED_FLAG, False)) else "method %s") % getattr(fn, "__qualname__", "?"), r))
                        nxt.append(r)
                        continue
                    if not _te_fn_holds(r, fn, fids):
                        if id(getattr(fn, "__globals__", None)) in own_g:
                            nxt.append(r)
                        continue
                    if fm == __name__:
                        roots.append("detector function path %s (not an exclusive root)" % getattr(fn, "__qualname__", "?"))
                        nxt.append(r)
                        continue
                    if fm not in own:
                        roots.append("L%d function %s (%s)" % (lvl, getattr(fn, "__qualname__", "?"), fm))
                    nxt.append(r)
                    continue
                if isinstance(r, threading.Thread):
                    try:
                        target = getattr(r, "_target", None)
                        target_name = getattr(target, "__qualname__", type(target).__name__) if target is not None else "unknown/custom-run"
                        roots.append("live thread name=%s ident=%s alive=%s target=%s" % (r.name, r.ident, r.is_alive(), target_name))
                        target = None
                    except Exception: pass
                tn = type(r).__module__ + "." + type(r).__qualname__
                if not isinstance(r, (dict, list, tuple, set, frozenset, _types.CellType)):
                    if "proxy" in tn.lower() or tn.startswith("java") or _ta_is_bridge_type(type(r)):
                        roots.append("L%d java-bridge object %s (held from Java: hook/listener/proxy not removed?)" % (lvl, tn))
                    elif lvl <= 2 and getattr(type(r), "__module__", None) not in own:
                        roots.append("L%d %s instance" % (lvl, tn))
                    elif getattr(type(r), "__module__", None) in own and len(cand) < _TH_EXT_MAX:
                        cand.append((lvl, "%s instance" % tn, r))
                nxt.append(r)
            except Exception:
                pass
            if len(nxt) >= _B41_HOLDER_FRONTIER:
                break
        frontier = nxt
    del frontier, me
    r = refs = nxt = _sf = _t = _a = _g = fn = None
    cand.extend(cand_t[:max(0, _TH_EXT_MAX - len(cand))])
    del cand_t
    roots.extend(_th_ext_roots(cand))
    del cand
    uniq = []
    for x in roots:
        if x not in uniq:
            uniq.append(x)
    return uniq[:10], other, int((time.time() - t0) * 1000)

def _b41_retain_check(pid, rec, attempt):
    try:
        if rec.get("gen") not in (None, _B41_GEN):
            return
    except Exception:
        pass
    rec["attempt"] = attempt
    try:
        _b41_retain_check_body(pid, rec, attempt)
    finally:
        if int(rec.get("attempt") or 0) <= attempt:
            try: _b41_pend().pop(rec.get("pkey"), None)
            except Exception: pass

def _ti_java_gc():
    try:
        rt = jclass("java.lang.Runtime").getRuntime()
        sy = jclass("java.lang.System")
        for _i in range(3):
            rt.gc()
            sy.runFinalization()
            time.sleep(0.4)
            _gc.collect()
        return True
    except Exception:
        return False

def _b41_retention_evidence(holders):
    """Paths from a bounded scan are not exclusive GC roots."""
    holders = [str(h) for h in (holders or ())]
    detector = [h for h in holders if h.startswith("detector ")]
    direct = [h for h in detector if h.startswith("detector global ")]
    threads = [h for h in holders if h.startswith("live thread ")]
    live = [h for h in threads if "alive=true" in h.lower()]
    frames = [h for h in holders if h.startswith(("frame path ", "live frame "))]
    external = [h for h in holders if "java-bridge" in h or "outside Python GC" in h]
    return {"detector_paths": detector, "direct_detector_references": direct,
            "thread_paths": threads, "live_execution_paths": live, "frame_paths": frames,
            "external_reference_hints": external,
            "exclusive_root_proven": False, "scan_complete": False}


def _b20_storage_evidence(rec):
    """Direct Python UI caller + sustained sampled MessagesStorage.getMessage."""
    if not rec.get("py_file") or not rec.get("stack"):
        return None
    src = str(rec.get("src") or "")
    if src != "anr/ui-thread" and not src.startswith("anr/ui-thread+"):
        return None
    hf = rec.get("hot_frames") or {}
    method = str(hf.get("top_app_frame") or "").split("(", 1)[0]
    if method != "org.telegram.messenger.MessagesStorage.getMessage": return None
    try:
        if int(hf.get("samples") or 0) < 8 or float(hf.get("top_app_pct") or 0) < 75.0: return None
    except Exception: return None
    return {"initiator": rec.get("py_module") or rec.get("culprit"),
            "blocked_resource": "MessagesStorage.getMessage",
            "attribution_kind": "direct-ui-caller", "resource_owner": None,
            "blocker_status": "not_identified", "samples": hf.get("samples"),
            "top_app_pct": hf.get("top_app_pct"), "wait_frame": hf.get("top_frame")}


def _b41_retain_check_body(pid, rec, attempt):
    try:
        _gc.collect()
        st = _b41_stale(pid, rec)
        _jg = ""
        if st:
            st = None
            if _ti_java_gc():
                st = _b41_stale(pid, rec)
                if not st:
                    _jg = " (после принудительного Java GC: держали Java-обёртки PyObject)"
            else:
                st = _b41_stale(pid, rec)
        if not st:
            _insys = 0
            for _nm, _wr in rec.get("mods") or []:
                _o = _wr()
                if _o is not None and _sys.modules.get(_nm) is _o:
                    _insys += 1
            if _insys:
                _log("Block#41 +TA(3): %s: модуль остаётся в sys.modules через %.0fс после выгрузки (движок не удалил модуль) -- удержание не оценивается" % (pid, _B41_RETAIN_DELAYS[attempt]))
            else:
                _log("Block#41 +TA(3): %s освобождён через %.0fс после выгрузки%s (ok)" % (pid, _B41_RETAIN_DELAYS[attempt], _jg))
            return
        if attempt + 1 < len(_B41_RETAIN_DELAYS):
            _log("Block#41 +SZ(4): %s still alive %.0fs after unload (%d objects: %s) -> re-check in %.0fs" % (
                pid, _B41_RETAIN_DELAYS[attempt], len(st), ", ".join("%s %s" % (k, n) for k, n, _o in st[:4]), _B41_RETAIN_DELAYS[attempt + 1] - _B41_RETAIN_DELAYS[attempt]))
            rec["attempt"] = attempt + 1
            t = threading.Timer(_B41_RETAIN_DELAYS[attempt + 1] - _B41_RETAIN_DELAYS[attempt], _b41_retain_check, args=(pid, rec, attempt + 1))
            t.daemon = True
            t.start()
            return
        targets = [o for _k, _n, o in st]
        names = ["%s %s" % (k, n) for k, n, _o in st][:8]
        del st
        holders, other, hms = _b41_holders(targets)
        del targets
        conf = "medium" if holders else "low"
        held_by = None
        if other:
            held_by = sorted(other.items(), key=lambda kv: -kv[1])[0][0]
            if held_by == pid:
                held_by = None
        now = int(time.time() * 1000)
        r = {"had_leak": True, "verdict": "PLUGIN RETAINED AFTER UNLOAD",
             "culprit": pid, "confidence": conf, "kind": "plugin-retained",
             "retained": names, "holders": holders, "held_by_plugin": held_by,
             "age_ms": now - int(rec.get("unload_ts") or now), "holder_scan_ms": hms,
             "reason": "после выгрузки плагина его модуль/классы остаются в памяти: зарегистрированные хуки, слушатели, потоки, таймеры или Java-прокси не сняты в on_plugin_unload",
             "exc_cls": "PluginRetained", "exc_msg": ", ".join(names[:3]),
             "ts": now, "event_type": "plugin_retained", "dropbox_tag": "app_memory_leak",
             "tombstone_norm_version": 1}
        evidence = _b41_retention_evidence(holders)
        r.update({"retained_plugin": pid, "retention_evidence": evidence,
                  "attribution": False, "culprit": "undetermined",
                  "kind": "plugin-retained-unresolved", "confidence": "low",
                  "reason": "объекты выгруженного плагина остаются живыми; пути через потоки, обёртки и Java/JNI не доказывают единственного виновника"})
        if evidence["direct_detector_references"]:
            r.update({"verdict": "DETECTOR REFERENCE TO RETAINED PLUGIN", "culprit": _SELF_ID,
                      "kind": "detector-reference", "confidence": "medium",
                      "detector_holders": evidence["detector_paths"],
                      "reason": "обнаружена ссылка из глобального состояния детектора; другие держатели не исключены, единственная причина удержания не установлена"})
        elif evidence["detector_paths"]:
            r.update({"verdict": "RETAINED PLUGIN — MIXED/UNRESOLVED HOLDERS",
                      "detector_holders": evidence["detector_paths"]})
        if _b41_append(_B41_RETAIN_FILE, r):
            _log("================ PLUGIN-RETAINED VERDICT (Block#41) ================")
            _log("RETAINED: %r holder=%r conf=%s exclusive_root=false retained=%s" % (pid, r["culprit"], r["confidence"], names[:4]))
            for h in holders[:6]:
                _log("  holder: %s" % h)
            _log("====================================================================")
    except Exception as e:
        try: _log("Block#41 +SZ(4) check err: %s" % e)
        except Exception: pass


_B42_ON = True
_B42_COUNTED_CLASSES = (
    "org.telegram.ui.LaunchActivity",
    "org.telegram.ui.ActionBar.BaseFragment",
    "org.telegram.ui.ChatActivity",
    "org.telegram.ui.DialogsActivity",
    "org.telegram.ui.ProfileActivity",
    "org.telegram.ui.Components.ChatActivityEnterView",
    "org.telegram.ui.Components.EmojiView",
    "org.telegram.ui.Cells.ChatMessageCell",
    "org.telegram.messenger.ImageReceiver",
    "org.telegram.ui.Components.RLottieDrawable",
    "org.telegram.ui.Components.AnimatedFileDrawable",
    "org.telegram.ui.Components.AnimatedEmojiDrawable",
    "android.graphics.Bitmap",
)
_B42_SINGLETON_CLASSES = ("org.telegram.ui.ChatActivity", "org.telegram.ui.ProfileActivity", "org.telegram.ui.DialogsActivity")
_B42_OBJ_PERIOD_MS = 300000
_B42_OBJ_KEEP = 6
_B42_OBJ_MIN_GROWTH = 3
_B42_OBJ_SINGLETON_MAX = 3
_B42_OBJ_FILE = "client_objects_leak.json"
_B42_OBJ_WARMUP_MS = 600000
_B42_OBJ_MIN_REL = 0.15
_B42_APP_CL = [None]
_B42_CLS_LOGGED = [False]
_B42_OBJ_HIST = {}
_B42_OBJ_LAST = [0]
_B42_VMDEBUG = [None]
_B42_CLASSARR = [None]
_B42_NC_PERIOD_MS = 300000
_B42_NC_KEEP = 6
_B42_NC_MIN = 12
_B42_NC_GROWTH = 8
_B42_NC_FILE = "nc_observers_leak.json"
_B42_NC_HIST = {}
_B42_NC_LAST = [0]
_B42_GC_KEYS = ("art.gc.blocking-gc-count", "art.gc.blocking-gc-time", "art.gc.gc-count", "art.gc.gc-time")
_B42_HPROF_ON = False
_B42_HPROF_LAST = [0]
_B42_HPROF_MIN_GAP_MS = 1800000
_B42_HPROF_MAX_BYTES = 80 * 1024 * 1024
_B42_HPROF_DIRNAME = "heapdumps"
_B42_HF_OK = False
_B42_HF_EVERY_MS = 20
_B42_HF_START_MS = 100
_B42_HF_MAX_MS = 120000
_B42_APP_PREFIXES = ("org.telegram.", "com.exteragram.", "com.chaquo.", "dev.exterahook.")
_B42_GLUE_PREFIXES = ("com.chaquo.python.", "java.lang.reflect.", "$Proxy", "java.lang.Thread.", "dalvik.system.VMStack.")
_B42_PY_BRIDGE = "com.chaquo.python."


def _b42_foreground():
    try:
        fd = _jc("org.telegram.ui.Components.ForegroundDetector")
        inst = fd.getInstance() if fd is not None else None
        if inst is not None:
            return bool(inst.isForeground())
    except Exception:
        pass
    try:
        al = _jc("org.telegram.messenger.ApplicationLoader")
        if al is not None and hasattr(al, "mainInterfacePaused"):
            return not bool(al.mainInterfacePaused)
    except Exception:
        pass
    return False


def _b42_gc():
    try:
        rt = _jc("java.lang.Runtime").getRuntime()
        rt.gc(); rt.runFinalization(); rt.gc()
        return True
    except Exception:
        return False


def _b42_gc_stats():
    out = {}
    try:
        Debug = _jc("android.os.Debug")
        if Debug is None:
            return out
        for k in _B42_GC_KEYS:
            try:
                s = Debug.getRuntimeStat(k)
                if s is None:
                    continue
                out[k.replace("art.gc.", "")] = int(str(s))
            except Exception:
                continue
    except Exception:
        pass
    return out


def _b42_gc_stats_str(g):
    if not isinstance(g, dict) or not g:
        return ""
    try:
        p = []
        if g.get("blocking-gc-count") is not None:
            p.append("blocking %s раз/%s мс" % (g.get("blocking-gc-count"), g.get("blocking-gc-time", "?")))
        if g.get("gc-count") is not None:
            p.append("всего %s раз/%s мс" % (g.get("gc-count"), g.get("gc-time", "?")))
        return ("GC: " + ", ".join(p)) if p else ""
    except Exception:
        return ""


def _b42_app_loader():
    if _B42_APP_CL[0] is None:
        cl = None
        try:
            al = _jc("org.telegram.messenger.ApplicationLoader")
            ctx = al.applicationContext if al is not None else None
            cl = ctx.getClassLoader() if ctx is not None else None
        except Exception:
            cl = None
        if cl is None:
            try: cl = _jc("java.lang.Thread").currentThread().getContextClassLoader()
            except Exception: cl = None
        _B42_APP_CL[0] = cl if cl is not None else False
    return _B42_APP_CL[0] if _B42_APP_CL[0] is not False else None


def _b42_proc_age_ms():
    try:
        if _NLIB is not None and hasattr(_NLIB, "cd_proc_age_ms"):
            import ctypes as _c
            _NLIB.cd_proc_age_ms.restype = _c.c_int64
            v = int(_NLIB.cd_proc_age_ms())
            if v >= 0:
                return v
    except Exception:
        pass
    try:
        return int(_jc("android.os.SystemClock").uptimeMillis()) - int(_jc("android.os.Process").getStartUptimeMillis())
    except Exception:
        return -1


def _b42_count_instances(classnames):
    if _B42_VMDEBUG[0] is False or _B42_CLASSARR[0] is False:
        return None
    try:
        if _B42_VMDEBUG[0] is None:
            _B42_VMDEBUG[0] = _jc("dalvik.system.VMDebug")
        if _B42_CLASSARR[0] is None:
            from java import jarray
            _B42_CLASSARR[0] = jarray(_jc("java.lang.Class"))
        vmd = _B42_VMDEBUG[0]
        if vmd is None:
            _B42_VMDEBUG[0] = False
            return None
    except Exception:
        _B42_VMDEBUG[0] = False
        _B42_CLASSARR[0] = False
        return None
    classes = []
    names = []
    _cl = _b42_app_loader()
    _Cls = _jc("java.lang.Class")
    for nm in classnames:
        try:
            k = _Cls.forName(nm, False, _cl) if _cl is not None else _Cls.forName(nm)
            if k is not None:
                classes.append(k); names.append(nm)
        except Exception:
            continue
    if not _B42_CLS_LOGGED[0]:
        _B42_CLS_LOGGED[0] = True
        _miss = [n.rsplit(".", 1)[-1] for n in classnames if n not in names]
        _log("Block#42 +TV: census классов %d/%d (loader=%s)%s" % (len(names), len(classnames), "app" if _cl is not None else "boot", (" нет: " + ",".join(_miss)) if _miss else ""))
    if not classes:
        return None
    try:
        arr = _B42_CLASSARR[0](classes)
    except Exception:
        return None
    try:
        res = _B42_VMDEBUG[0].countInstancesOfClasses(arr, True)
        if res is not None:
            vals = list(res)
            return {names[i]: int(vals[i]) for i in range(min(len(names), len(vals)))}
    except Exception:
        pass
    out = {}
    try:
        for i, k in enumerate(classes):
            try:
                out[names[i]] = int(_B42_VMDEBUG[0].countInstancesOfClass(k, True))
            except Exception:
                continue
        return out or None
    except Exception:
        return None


def _b42_object_census(force=False):
    if not _B42_ON:
        return None
    now = int(time.time() * 1000)
    if not force:
        if now - _B42_OBJ_LAST[0] < _B42_OBJ_PERIOD_MS:
            return None
        if not _b42_foreground():
            return None
        _age = _b42_proc_age_ms()
        if 0 <= _age < _B42_OBJ_WARMUP_MS:
            return None
        _B42_OBJ_LAST[0] = now
    _b42_gc()
    counts = _b42_count_instances(_B42_COUNTED_CLASSES)
    if not counts:
        return None
    if force:
        return counts
    for nm, c in counts.items():
        h = _B42_OBJ_HIST.setdefault(nm, [])
        h.append((now, int(c)))
        if len(h) > _B42_OBJ_KEEP:
            del h[:len(h) - _B42_OBJ_KEEP]
    leaks = []
    for nm, h in _B42_OBJ_HIST.items():
        if len(h) < 3:
            continue
        seq = [c for _, c in h]
        first, last = seq[0], seq[-1]
        growth = last - first
        monotonic = all(seq[i] <= seq[i + 1] for i in range(len(seq) - 1))
        is_singleton = nm in _B42_SINGLETON_CLASSES
        if monotonic and growth >= max(_B42_OBJ_MIN_GROWTH, first * _B42_OBJ_MIN_REL) and (last >= _B42_OBJ_MIN_GROWTH):
            leaks.append({"cls": nm, "first": first, "last": last, "growth": growth,
                          "n": len(seq), "span_s": round((h[-1][0] - h[0][0]) / 1000.0, 1), "kind": "growth"})
        elif is_singleton and last > _B42_OBJ_SINGLETON_MAX:
            leaks.append({"cls": nm, "first": first, "last": last, "growth": growth,
                          "n": len(seq), "span_s": round((h[-1][0] - h[0][0]) / 1000.0, 1), "kind": "singleton-overcount"})
    if not leaks:
        return counts
    leaks.sort(key=lambda d: (d["kind"] != "singleton-overcount", -d["growth"], -d["last"]))
    top = leaks[0]
    short = top["cls"].rsplit(".", 1)[-1]
    rec = {"had_leak": True, "suspected_leak": True, "leak_confirmed": False,
           "attribution": False, "root_status": "not_identified",
           "verdict": "SUSPECTED CLIENT OBJECT RETENTION",
           "culprit": "client (host process)", "culprit_kind": "host", "host_side": True,
           "confidence": "medium" if top["kind"] == "growth" else "low",
           "kind": "client-object-leak", "leak_class": top["cls"], "leak_kind": top["kind"],
           "first": top["first"], "last": top["last"], "growth": top["growth"],
           "samples": top["n"], "span_s": top["span_s"],
           "all_leaks": leaks[:6], "counts": counts,
           "reason": ("живых экземпляров %s выросло %d -> %d за %.0f с (монотонно, %d замеров) -- подозрение на удержание; GC-root и владелец не установлены"
                      % (short, top["first"], top["last"], top["span_s"], top["n"]))
                     if top["kind"] == "growth" else
                     ("%d живых экземпляров %s превышает эвристический порог %d; допустимый navigation stack/кеш и GC-root не проверены"
                      % (top["last"], short, _B42_OBJ_SINGLETON_MAX)),
           "exc_cls": "ClientObjectLeak", "exc_msg": "%s live=%d (+%d)" % (short, top["last"], top["growth"]),
           "gc": _b42_gc_stats(), "nc_observers": _b42_nc_snapshot(),
           "ts": now, "event_type": "client_object_leak", "dropbox_tag": "app_memory_leak",
           "tombstone_norm_version": 1}
    try:
        _ui_ctx_attach(rec)
    except Exception:
        pass
    if _b42_append_dedup(_B42_OBJ_FILE, rec, dedup_key=("leak_class",)):
        _log("================ SUSPECTED OBJECT RETENTION (Block#42 +UB) ================")
        _log("НАБЛЮДЕНИЕ: client class=%s %d->%d (+%d) за %.0fс conf=%s kind=%s; GC-root/owner unresolved"
             % (short, top["first"], top["last"], top["growth"], top["span_s"], rec["confidence"], top["kind"]))
        for l in leaks[:6]:
            _log("  %s: %d->%d (+%d) n=%d" % (l["cls"].rsplit(".", 1)[-1], l["first"], l["last"], l["growth"], l["n"]))
        _log("===================================================================")
    return counts


def _q42_cls(name):
    return _jc("java.lang.Class").forName(name, False, _b42_app_loader())


class _Q42Weak:
    def __init__(self):
        from java import jarray
        self.array = jarray(_jc("java.lang.Object"))
        self.wr = _jc("java.lang.ref.WeakReference")
        self.obj = _q42_cls("java.lang.Object")
        ref = _q42_cls("java.lang.ref.Reference")
        self.mh = _jc("java.lang.invoke.MethodHandles")
        self.lk = self.mh.publicLookup()
        self.get = self.lk.unreflect(ref.getMethod("get"))
        self.ctor = self.lk.unreflectConstructor(_q42_cls("java.lang.ref.WeakReference").getConstructor(self.obj))
        self.null = self.mh.filterReturnValue(self.get, self.lk.unreflect(_q42_cls("java.util.Objects").getMethod("isNull", self.obj)))
        self.same = self.mh.collectArguments(self.lk.unreflect(ref.getMethod("refersTo", self.obj)), 1, self.get)
        Boolean = _jc("java.lang.Boolean")
        classes = jarray(_q42_cls("java.lang.Class"))
        false_pair = self.mh.dropArguments(self.mh.constant(Boolean.TYPE, Boolean.FALSE), 0, classes([ref, ref]))
        null_second = self.mh.dropArguments(self.null, 0, classes([ref]))
        self.same_live = self.mh.guardWithTest(null_second, false_pair, self.same)
        self.hash = self.mh.filterReturnValue(self.get, self.lk.unreflect(_q42_cls("java.lang.System").getMethod("identityHashCode", self.obj)))
        self.class_of = self.mh.filterReturnValue(self.get, self.lk.unreflect(self.obj.getMethod("getClass")))
        self.name = self.mh.filterReturnValue(self.class_of, self.lk.unreflect(_q42_cls("java.lang.Class").getMethod("getName")))
        inner_get = self.get.asType(self.get.type().changeParameterType(0, self.obj))
        self.deref = self.mh.filterReturnValue(self.get, inner_get)
        self.deref = self.mh.filterReturnValue(self.deref, self.ctor)
        sentinel = _jc("java.util.ArrayList")()
        a, b = self.wr(sentinel), self.wr(sentinel)
        if self.gone(a) or not self.equal(a, b) or not self.gone(self.wr(None)):
            raise RuntimeError("weak projection selftest failed")

    def call(self, handle, *args):
        return handle.invokeWithArguments(self.array(list(args)))

    def int_constant(self, value):
        from java import jlong
        value = int(value)
        if not -(1 << 31) <= value < (1 << 31):
            raise ValueError("int constant outside int32")
        handle = self.mh.constant(_jc("java.lang.Long").TYPE, jlong(value))
        return self.mh.explicitCastArguments(handle, handle.type().changeReturnType(_jc("java.lang.Integer").TYPE))

    def check_int_constants(self):
        previous = getattr(self, "int_constant_check", None)
        if previous and previous.get("passed"):
            return
        result = dict(strategy="long_jlong_then_explicit_int", passed=False, checked_values=[])
        self.int_constant_check = result
        try:
            for value in (-(1 << 31), -1, 0, 1, 2, 4, 8, 16, (1 << 31)-1):
                actual = self.call(self.int_constant(value))
                if isinstance(actual, bool) or int(actual) != value:
                    raise RuntimeError("int constant bridge preflight mismatch")
                result["checked_values"].append(value)
            result["passed"] = True
        except Exception as exc:
            result.update(error_type=type(exc).__name__, detail=str(exc)[:160])
            raise

    def then(self, first, second):
        
        typed = second.asType(second.type().changeParameterType(0, first.type().returnType()))
        return self.mh.filterReturnValue(first, typed)

    def pack_weak(self, handles, slots=None):
                                                                           
                                                                      
        from java import jarray
        ref_type = self.get.type().parameterType(0)
        array_class = _q42_cls("[Ljava.lang.Object;")
        pack = self.mh.identity(array_class).asCollector(array_class, len(handles))
        for index, handle in enumerate(handles):
            boxed = handle.asType(handle.type().changeReturnType(self.obj).changeParameterType(0, ref_type))
            pack = self.mh.filterArguments(pack, index, jarray(_jc("java.lang.invoke.MethodHandle"))([boxed]))
        slots = slots if slots is not None else [0]*len(handles)
        signature = pack.type().dropParameterTypes(max(slots)+1, len(handles))
        return self.mh.permuteArguments(pack, signature, jarray(_jc("java.lang.Integer").TYPE)(slots))

    def gone(self, ref):
        return ref is None or bool(self.call(self.null, ref))

    def equal(self, a, b):
        return a is not None and b is not None and bool(self.call(self.same_live, a, b))

    def nullable_equal(self, a, b):
        return (self.gone(a) and self.gone(b)) or self.equal(a, b)

    def identity_hash(self, ref):
        return int(self.call(self.hash, ref))

    def class_name(self, ref):
        return str(self.call(self.name, ref)) if not self.gone(ref) else "<collected>"

    def field_handle(self, field, scalar=None):
        if int(field.getModifiers()) & 8:
            raise RuntimeError("static field is not an object edge")
        typename = str(field.getType().getName())
        if (scalar is None and field.getType().isPrimitive()) or (scalar is not None and typename != scalar):
            raise RuntimeError("field schema mismatch")
        field.setAccessible(True)
        h = self.lk.unreflectGetter(field)
        h = h.asType(h.type().changeParameterType(0, self.obj))
        if scalar is None:
            h = h.asType(h.type().changeReturnType(self.obj))
        h = self.mh.filterReturnValue(self.get, h)
        return self.mh.filterReturnValue(h, self.ctor) if scalar is None else h

    def field(self, cls, name, scalar=None):
        for _ in range(16):
            if cls is None:
                break
            try:
                f = cls.getDeclaredField(name)
            except Exception as exc:
                if not type(exc).__name__.endswith("NoSuchFieldException"):
                    raise
                cls = cls.getSuperclass()
                continue
            return self.field_handle(f, scalar)
        raise RuntimeError("field unavailable: " + name)


class _Q42Ids:
    def __init__(self, probe, cap=8192):
        self.probe, self.cap, self.serial = probe, cap, 0
        self.entries, self.buckets = {}, {}

    def token(self, kind, ref):
        if self.probe.gone(ref):
            return 0
        return self.projected_token(kind, ref, self.probe.identity_hash(ref))

    def projected_token(self, kind, ref, identity_hash):
                                                                          
                                                                            
        key = (kind, identity_hash)
        for token in self.buckets.get(key, ()):
            if self.probe.equal(self.entries[token][1], ref):
                return token
        if len(self.entries) >= self.cap:
            raise RuntimeError("weak identity cap")
        self.serial += 1
        self.entries[self.serial] = (key, ref)
        self.buckets.setdefault(key, []).append(self.serial)
        return self.serial

    def forget(self, token):
        entry = self.entries.pop(token, None)
        if entry is not None:
            bucket = self.buckets[entry[0]]
            bucket.remove(token)
            if not bucket:
                del self.buckets[entry[0]]

    def prune(self):
        for token, (_, ref) in list(self.entries.items()):
            if self.probe.gone(ref):
                self.forget(token)

    def close(self):
        self.entries.clear()
        self.buckets.clear()


def _q42_finished(lifecycle):
    flags = lifecycle.get("flags", {})
    required = ("paused", "isPaused", "finishing", "isFinished", "parentLayout_is_null")
    if not lifecycle.get("complete") or any(k not in flags for k in required):
        return -1
    return int(all(flags[k] is True for k in required))


class _Q42Probe(_Q42Weak):
    def __init__(self):
        super().__init__()
        self.schemas, self.life_schemas, self.life_masks = {}, {}, {}
        self.life_mask_errors, self.life_mask_attempts = {}, {}
        self.base = _q42_cls("org.telegram.ui.ActionBar.BaseFragment")
        check = self.lk.unreflect(_q42_cls("java.lang.Class").getMethod("isInstance", self.obj)).bindTo(self.base)
        self.is_fragment = self.mh.filterReturnValue(self.get, check)
        main = self.lk.unreflect(_q42_cls("android.os.Looper").getMethod("getMainLooper"))
        main = main.asType(main.type().changeReturnType(self.obj))
        self.main = self.mh.filterReturnValue(main, self.ctor)
        self.queue_field = self.field(_q42_cls("android.os.Looper"), "mQueue")
        self.head_field = self.field(_q42_cls("android.os.MessageQueue"), "mMessages")
        msg = _q42_cls("android.os.Message")
        self.msg_fields = {n:self.field(msg, n, "long" if n == "when" else None) for n in ("next", "callback", "when")}
        self.handler_queue = self.field(_q42_cls("android.os.Handler"), "mQueue")
        self.clock = _jc("android.os.SystemClock")
        self.main_queue = self.call(self.queue_field, self.call(self.main))
        if self.gone(self.main_queue):
            raise RuntimeError("main queue unavailable")
        self.param_name = None
        self.site = "handler_send_at_time"

    def uptime(self):
        return int(self.clock.uptimeMillis())

    def capture_schema(self, cls):
        name = str(cls.getName())
        if name not in self.schemas:
            if len(self.schemas) >= 128:
                raise RuntimeError("callback schema cap")
            fields, gaps = [], []
            c = cls
            for _ in range(4):
                if c is None or str(c.getName()) == "java.lang.Object":
                    break
                declared = c.getDeclaredFields()
                if len(declared) > 64:
                    raise RuntimeError("callback field cap")
                for f in declared:
                    if int(f.getModifiers()) & 8 or f.getType().isPrimitive():
                        continue
                    t = f.getType()
                    if not (self.base.isAssignableFrom(t) or str(t.getName()) == "java.lang.Object"):
                        continue
                    if len(fields) >= 8:
                        raise RuntimeError("callback capture cap")
                    try:
                        fields.append((str(f.getName()), self.field_handle(f)))
                    except Exception as exc:
                        gaps.append(type(exc).__name__)
                c = c.getSuperclass()
            self.schemas[name] = (fields, gaps)
        fields, gaps = self.schemas[name]
        return name, fields, gaps

    def captures(self, callback):
        name, fields, gaps = self.capture_schema(self.call(self.class_of, callback))
        found = []
        for field, h in fields:
            ref = self.call(h, callback)
            if not self.gone(ref) and bool(self.call(self.is_fragment, ref)):
                if not any(self.equal(ref, old[1]) for old in found):
                    found.append((field, ref))
        return name, found, list(gaps)

    def lifecycle_flags(self, values):
                                                                              
                                                                             
        keys = ("paused", "isPaused", "finishing", "isFinished", "parentLayout_is_null")
        if len(values) != len(keys):
            raise RuntimeError("lifecycle projection length")
        flags = {}
        for i, key in enumerate(keys):
            value = int(values[i])
            if value not in (0, 1 << i):
                raise RuntimeError("lifecycle projection bit")
            flags[key] = value != 0
        return dict(flags=flags, gaps=[], complete=True, non_atomic=True)

    def chat_state(self, ref, retry_projection=False):
        cls = self.call(self.class_of, ref)
        name = str(cls.getName())
        if name not in self.life_schemas:
            if len(self.life_schemas) >= 32:
                raise RuntimeError("lifecycle schema cap")
            fields, gaps = {}, []
            for n in ("paused", "isPaused", "finishing", "isFinished", "parentLayout"):
                try:
                    fields[n] = self.field(cls, n, None if n == "parentLayout" else "boolean")
                except Exception as exc:
                    gaps.append(n + ":" + type(exc).__name__)
            self.life_schemas[name] = (fields, gaps)
        fields, missing = self.life_schemas[name]
                                                                               
                                                                                 
        attempts = self.life_mask_attempts.get(name, 0)
        if not missing and name not in self.life_masks and (attempts == 0 or (retry_projection and attempts < 3)):
            self.life_mask_attempts[name] = attempts + 1
            try:
                from java import jarray
                self.check_int_constants()
                ref_type = self.get.type().parameterType(0)
                classes = jarray(_q42_cls("java.lang.Class"))
                def constant(value):
                    return self.mh.dropArguments(self.int_constant(value), 0, classes([ref_type]))
                handles = []
                for bit, key in enumerate(("paused", "isPaused", "finishing", "isFinished", "parentLayout")):
                    test = self.then(fields[key], self.null) if key == "parentLayout" else fields[key]
                    handles.append(self.mh.guardWithTest(test, constant(1 << bit), constant(0)))
                                                                           
                                                                              
                packed = self.pack_weak(handles)
                self.lifecycle_flags(self.call(packed, ref))
                self.life_masks[name] = packed
                self.life_mask_errors.pop(name, None)
            except Exception as exc:
                self.life_mask_errors[name] = dict(error_type=type(exc).__name__, detail=str(exc)[:160])
        if name in self.life_masks:
            try:
                return self.lifecycle_flags(self.call(self.life_masks[name], ref))
            except Exception as exc:
                return dict(flags={}, gaps=["lifecycle_batch:"+type(exc).__name__], complete=False, non_atomic=True)
        flags, gaps = {}, list(missing)
        for key, h in fields.items():
            try:
                v = self.call(h, ref)
                flags["parentLayout_is_null" if key == "parentLayout" else key] = self.gone(v) if key == "parentLayout" else bool(v)
            except Exception as exc:
                gaps.append(key + ":" + type(exc).__name__)
        return dict(flags=flags, gaps=gaps, complete=not gaps, non_atomic=True)

    def prepare_projection(self, callback_class):
        self.trace_projection = {}
        self.projection_setup = dict(status="preparing", reason="not_completed", lifecycle_backend="packed_bits_v2")
        try:
            return self._prepare_projection(callback_class)
        except Exception as exc:
            self.trace_projection = {}
            self.projection_setup.update(status="failed", reason="projection_build_exception", error_type=type(exc).__name__, detail=str(exc)[:160])
            raise

    def _prepare_projection(self, callback_class):
        def fallback(reason, **detail):
            self.trace_projection = {}
            self.projection_setup.update(status="fallback", reason=reason, **detail)
            return False
        name, fields, gaps = self.capture_schema(callback_class)
        self.projection_setup.update(callback_class=name, capture_fields=[f for f, _ in fields], capture_gaps=list(gaps)[:8])
        if gaps:
            return fallback("capture_schema_gaps")
        if not fields:
            return fallback("no_capture_fields")
        warm = []
        for item in getattr(self, "trace_warm_targets", ()):
            cb_name, ref = item[:2]
            if cb_name == name and not self.gone(ref):
                warm.append((ref, self.call(self.class_of, ref), item[2] if len(item)>2 else None, item[3] if len(item)>3 else None))
        self.projection_setup["warm_target_count"] = len(warm)
        if not warm:
            return fallback("no_live_warm_target")
        names = {str(cls.getName()) for _, cls, _, _ in warm}
        if len(names) != 1:
            return fallback("mixed_target_classes", target_classes=sorted(names)[:8])
        selected = {field for _, _, field, _ in warm if field is not None}
        if not selected and len(fields) == 1:
            selected = {fields[0][0]}
        if len(selected) != 1:
            return fallback("ambiguous_capture_selection")
        field = next(iter(selected))
        candidates = [h for n, h in fields if n == field]
        if len(candidates) != 1:
            return fallback("capture_field_name_ambiguous")
        capture = candidates[0]
        target_name, target_class = next(iter(names)), warm[0][1]
        self.projection_setup.update(capture_field=field, target_class=target_name, extra_capture_guards=len(fields)-1)
        for ref, _, _, cb in warm:
            if cb is not None:
                if self.gone(cb):
                    return fallback("warm_callback_collected")
                _, found, current_gaps = self.captures(cb)
                if current_gaps or len(found) != 1 or found[0][0] != field or not self.equal(found[0][1], ref):
                    return fallback("warm_capture_changed")
        life = self.chat_state(warm[0][0], retry_projection=True)
        mask = self.life_masks.get(target_name)
        self.projection_setup["lifecycle_build_attempts"] = self.life_mask_attempts.get(target_name, 0)
        self.projection_setup["int_constants"] = dict(getattr(self, "int_constant_check", {}))
        if mask is None or not life.get("complete"):
            return fallback("lifecycle_projection_unavailable", lifecycle_gaps=life.get("gaps", [])[:8], lifecycle_error=self.life_mask_errors.get(target_name))
        if self.param_name is None:
            return fallback("sdk_param_not_bound")
        from java import jarray
        ref_type = self.get.type().parameterType(0)
        Integer = _jc("java.lang.Integer")
        minus = self.mh.dropArguments(self.int_constant(-1), 0, jarray(_q42_cls("java.lang.Class"))([ref_type]))
        get_thread = self.lk.unreflect(_q42_cls("java.lang.Thread").getMethod("currentThread"))
        thread_id = self.mh.filterReturnValue(get_thread, self.lk.unreflect(_q42_cls("java.lang.Thread").getMethod("getId")))
        thread_id = self.mh.dropArguments(thread_id, 0, jarray(_q42_cls("java.lang.Class"))([ref_type]))
        equals_class = self.lk.unreflect(_q42_cls("java.lang.Class").getMethod("equals", self.obj))
        def exact_class(cls):
            return self.then(self.class_of, equals_class.bindTo(cls))
        queue_equal = self.mh.insertArguments(self.same_live, 0, self.array([self.main_queue]))
        one = self.mh.dropArguments(self.int_constant(1), 0, jarray(_q42_cls("java.lang.Class"))([ref_type]))
        zero = self.mh.dropArguments(self.int_constant(0), 0, jarray(_q42_cls("java.lang.Class"))([ref_type]))
        send_result = self.mh.guardWithTest(self.result, one, zero)
        send_outcome = self.mh.guardWithTest(self.thrown, zero, send_result)
        run_outcome = self.mh.guardWithTest(self.thrown, one, zero)
                                                                           
                                                                               
        callback_valid = exact_class(callback_class)
        false_value = self.mh.dropArguments(self.mh.constant(_jc("java.lang.Boolean").TYPE, _jc("java.lang.Boolean").FALSE), 0, jarray(_q42_cls("java.lang.Class"))([ref_type]))
        for other_field, other in fields:
            if other_field != field:
                callback_valid = self.mh.guardWithTest(self.then(other, self.is_fragment), false_value, callback_valid)
        for _, _, _, cb in warm:
            if cb is not None and not bool(self.call(callback_valid, cb)):
                return fallback("warm_extra_fragment_capture")
        for run in (False, True):
            callback = self.param_this if run else self.param_callback
            queue = self.param_handler_queue if self.site == "handler_send_at_time" else self.param_this
            identity = self.mh.identity(ref_type)
            for lifecycle in (False, True):
                                                                               
                                                                               
                                                                               
                handles = [identity, identity, mask if lifecycle else minus,
                    self.hash, self.hash, self.hash, callback_valid, exact_class(target_class),
                    self.is_fragment, self.then(queue, queue_equal) if not run else exact_class(callback_class),
                    thread_id, minus if lifecycle else (run_outcome if run else send_outcome)]
                pack = self.pack_weak(handles, [1,2,2,1,2,0,1,2,2,1 if run else 0,0,0])
                typed_capture = capture.asType(capture.type().changeReturnType(ref_type))
                step = self.mh.collectArguments(pack, 2, typed_capture)
                signature = pack.type().dropParameterTypes(2, 3)
                step = self.mh.permuteArguments(step, signature, jarray(Integer.TYPE)([0,1,1]))
                typed_callback = callback.asType(callback.type().changeReturnType(ref_type))
                joined = self.mh.collectArguments(step, 1, typed_callback)
                signature = signature.dropParameterTypes(1, 2)
                self.trace_projection[(run, lifecycle)] = self.mh.permuteArguments(joined, signature, jarray(Integer.TYPE)([0,0]))
        self.trace_projection_meta = (name, field, target_name)
        self.projection_setup.update(status="ready", reason="ok", modes=len(self.trace_projection))
        return True

    def projected(self, param, run=False, read_lifecycle=True):
        pref = self.wr(param)
        values = self.call(self.trace_projection[(run, read_lifecycle)], pref)
        if len(values) != 12 or not all(bool(values[i]) for i in (6, 7, 8, 9)):
            raise RuntimeError("batch projection class/target/queue mismatch")
        cb, target = values[0], values[1]
        name, field, target_name = self.trace_projection_meta
        life = self.lifecycle_flags(values[2]) if read_lifecycle else dict(flags={}, complete=False)
        return pref, cb, target, name, field, life, (int(values[5]), int(values[3]), int(values[4])), int(values[10]), target_name, int(values[11])

    def message(self, ref):
        return {n:self.call(h, ref) for n, h in self.msg_fields.items()}

    def bind_param(self, param):
        from java import jarray
        if self.param_name is not None:
            return
        cls = param.getClass()
        name = str(cls.getName())
        self.param_args = self.field(cls, "args")
        self.param_this = self.field(cls, "thisObject")
        element = self.mh.arrayElementGetter(_q42_cls("[Ljava.lang.Object;"))
        Long = _jc("java.lang.Long")
        element = self.mh.explicitCastArguments(element, element.type().changeParameterType(1, Long.TYPE))
        self.elements = []
        for i in (0, 1):
            h = self.mh.insertArguments(element, 1, self.array([Long.valueOf(i)]))
            h = h.asType(h.type().changeParameterType(0, self.obj))
            self.elements.append(self.mh.filterReturnValue(self.mh.filterReturnValue(self.get, h), self.ctor))
        h = self.lk.unreflect(_q42_cls("java.lang.Long").getMethod("longValue"))
        self.long_value = self.mh.filterReturnValue(self.get, h.asType(h.type().changeParameterType(0, self.obj)))
        method = cls.getMethod("hasThrowable")
        method.setAccessible(True)
        h = self.lk.unreflect(method)
        self.thrown = self.mh.filterReturnValue(self.get, h.asType(h.type().changeParameterType(0, self.obj)))
        method = cls.getMethod("getResult")
        method.setAccessible(True)
        h = self.lk.unreflect(method)
        h = h.asType(h.type().changeParameterType(0, self.obj).changeReturnType(self.obj))
        unbox = self.lk.unreflect(_q42_cls("java.lang.Boolean").getMethod("booleanValue"))
        unbox = unbox.asType(unbox.type().changeParameterType(0, self.obj))
        self.result = self.mh.filterReturnValue(self.mh.filterReturnValue(self.get, h), unbox)
        self.param_callback = self.then(
            self.then(self.param_args, self.elements[0]), self.msg_fields["callback"])
        self.param_handler_queue = self.then(self.param_this, self.handler_queue)
        self.param_name = name

    def message_from_param(self, param):
        self.bind_param(param)
        args = self.call(self.param_args, self.wr(param))
        return self.call(self.elements[0], args)

    def callback_from_param(self, param):
        self.bind_param(param)
        return self.call(self.param_callback, self.wr(param))

    def owner_from_param(self, param):
        self.bind_param(param)
        return self.call(self.param_this, self.wr(param))

    def queue_from_param(self, param):
        self.bind_param(param)
        handle = self.param_handler_queue if self.site == "handler_send_at_time" else self.param_this
        return self.call(handle, self.wr(param))

    def outcome(self, param, run=False):
        self.bind_param(param)
        pref = self.wr(param)
        thrown = bool(self.call(self.thrown, pref))
        return int(thrown) if run else (0 if thrown else int(bool(self.call(self.result, pref))))

    def projection(self, param, run=False, read_lifecycle=True):
        cb = self.owner_from_param(param) if run else self.callback_from_param(param)
        if self.gone(cb):
            raise RuntimeError("callback unavailable")
        name, captures, gaps = self.captures(cb)
        if len(captures) != 1 or gaps:
            raise RuntimeError("callback capture ambiguous or incomplete")
        field, target = captures[0]
        if not run and not self.equal(self.queue_from_param(param), self.main_queue):
            raise RuntimeError("not the main queue")
        life = self.chat_state(target) if read_lifecycle else dict(flags={}, complete=False)
        return cb, target, name, field, life

    def collection(self, ref, limit=16):
        if self.gone(ref):
            return 0, []
        if self.class_name(ref) != "java.util.ArrayList":
            raise RuntimeError("unsupported owner collection; strong membership not assumed")
        if not hasattr(self, "list_size"):
            cls = _q42_cls("java.util.ArrayList")
            h = self.lk.unreflect(cls.getMethod("size"))
            self.list_size = self.mh.filterReturnValue(self.get, h.asType(h.type().changeParameterType(0, self.obj)))
            h = self.lk.unreflect(cls.getMethod("get", _jc("java.lang.Integer").TYPE))
            h = h.asType(h.type().changeParameterType(0, self.obj))
            h = self.mh.explicitCastArguments(h, h.type().changeParameterType(1, _jc("java.lang.Long").TYPE))
            h = self.mh.collectArguments(h, 0, self.get)
            self.list_item = self.mh.filterReturnValue(h, self.ctor)
        count = int(self.call(self.list_size, ref))
        return count, [self.call(self.list_item, ref, _jc("java.lang.Long").valueOf(i)) for i in range(min(count, limit))]

    def owner_projection(self, root, max_nodes=24, budget_ms=20):
        started = time.monotonic()
        ids = _Q42Ids(self, cap=max_nodes)
        rows, edges, gaps = [], [], []
        pending = [(root, 0)]
        try:
            while pending:
                if (time.monotonic()-started)*1000 > budget_ms:
                    gaps.append("time_cap"); break
                ref, depth = pending.pop(0)
                if self.gone(ref):
                    continue
                token = ids.token("graph", ref)
                if any(r["token"] == token for r in rows):
                    continue
                name = self.class_name(ref)
                row = dict(token=token, cls=name, state={})
                rows.append(row)
                c = self.call(self.class_of, ref)
                count = 0
                if name == "org.telegram.ui.Components.AnimatedEmojiDrawable":
                    for member_name in ("views", "holders"):
                        try:
                            collection = self.call(self.field(c, member_name), ref)
                            member_count, members = self.collection(collection)
                            row["state"][member_name] = member_count
                            if member_count > 16:
                                gaps.append("member_cap")
                            for index, child in enumerate(members):
                                if self.gone(child):
                                    continue
                                child_id = ids.token("graph", child)
                                edges.append(dict(parent=token, field=member_name+"[%d]" % index, child=child_id, edge_kind="strong_arraylist_membership"))
                                if depth < 3:
                                    pending.append((child, depth+1))
                                else:
                                    gaps.append("depth_cap")
                        except Exception as exc:
                            gaps.append(member_name+":"+type(exc).__name__)
                for _ in range(4):
                    if c is None or str(c.getName()) == "java.lang.Object":
                        break
                    for f in c.getDeclaredFields():
                        if (time.monotonic()-started)*1000 > budget_ms:
                            gaps.append("time_cap"); break
                        if int(f.getModifiers()) & 8:
                            continue
                        n, t = str(f.getName()), str(f.getType().getName())
                        if t == "boolean" and n in ("attached", "attachedToWindow", "isAttachedToWindow", "preloading", "isFinished", "finishing"):
                            try:
                                row["state"][n] = bool(self.call(self.field_handle(f, "boolean"), ref))
                            except Exception as exc:
                                gaps.append(n+":"+type(exc).__name__)
                        if depth >= 3 or f.getType().isPrimitive():
                            continue
                        if not ("ImageReceiver" in t or "AnimatedEmojiDrawable" in t or t.startswith("org.telegram.ui.") or t in ("android.view.View", "android.graphics.drawable.Drawable$Callback")):
                            continue
                        count += 1
                        if count > 16:
                            gaps.append("field_cap"); break
                        try:
                            child = self.call(self.field_handle(f), ref)
                            if self.gone(child):
                                continue
                            child_id = ids.token("graph", child)
                            edges.append(dict(parent=token, field=n, child=child_id, edge_kind="strong_instance_field"))
                            pending.append((child, depth+1))
                        except Exception as exc:
                            gaps.append(n+":"+type(exc).__name__)
                    if count > 16:
                        break
                    c = c.getSuperclass()
            for row in rows:
                st = row["state"]
                if row["cls"] == "org.telegram.ui.Components.AnimatedEmojiDrawable" and all(k in st for k in ("views", "holders", "attached", "preloading")):
                    if st["views"]+st["holders"] == 0:
                        row["classification"] = "PRELOADING_WITHOUT_MEMBERS" if st["preloading"] else ("ATTACHED_WITHOUT_MEMBERS" if st["attached"] else "IDLE_NO_MEMBERS")
                    else:
                        row["classification"] = "MEMBERS_PRESENT_OWNER_STATE_UNRESOLVED"
            if len(edges) > 64:
                gaps.append("edge_cap")
            return dict(nodes=rows, edges=edges[:64], gaps=gaps[:16], projection_complete=not gaps,
                scope="bounded selected strong fields; not a complete owner map or GC-root scan", non_atomic=True)
        finally:
            ids.close()


def _q42_queue_snapshot(probe, watch):
    started = time.monotonic()
    row = dict(ts=int(time.time()*1000), status="partial", non_atomic=True,
        scanned_messages=0, targets=[], gaps=[], caps_hit=[], forced_gc_requested=False,
        bounds=dict(max_messages=256, max_targets=32, cooperative_budget_ms=80, max_owner_nodes=24, owner_cooperative_budget_ms=20),
        meaning="sampled queue references; not execution, unbounded leak or exclusive owner proof")
    candidates = {}
    probe.trace_warm_targets = []
    try:
        watch.prune()
        head = probe.call(probe.head_field, probe.main_queue)
        current, seen = head, _Q42Ids(probe, cap=256)
        while not probe.gone(current):
            if row["scanned_messages"] >= 256:
                row["caps_hit"].append("messages"); break
            if (time.monotonic()-started)*1000 >= 80:
                row["caps_hit"].append("time"); break
            token = seen.token("message", current)
            if token <= row["scanned_messages"]:
                row["gaps"].append("cycle_or_message_reuse"); break
            row["scanned_messages"] += 1
            before = probe.message(current)
            cb = before["callback"]
            observations = []
            if not probe.gone(cb):
                name, captures, gaps = probe.captures(cb)
                if gaps:
                    row["gaps"].extend(gaps[:4])
                for field, target in captures:
                    if len(row["targets"]) + len(observations) >= 32:
                        row["caps_hit"].append("targets"); break
                    life = probe.chat_state(target)
                    closed = life["flags"].get("isFinished") is True and life["flags"].get("parentLayout_is_null") is True
                    item = dict(callback_class=name, capture_field=field, target_class=probe.class_name(target),
                        callback_token=watch.token("callback", cb), target_token=watch.token("target", target),
                        lifecycle=life, closed_observed=closed, strictly_finished=_q42_finished(life),
                        when_uptime_ms=int(before["when"]), delay_ms=int(before["when"])-probe.uptime(),
                        path=["main MessageQueue.mMessages", "Message.next*", "Message.callback", name+"."+field, probe.class_name(target)])
                    observations.append((item, target))
            after = probe.message(current)
            stable = probe.nullable_equal(before["callback"], after["callback"]) and probe.nullable_equal(before["next"], after["next"]) and int(before["when"]) == int(after["when"])
            if not stable:
                row["gaps"].append("message_changed_during_read")
            for item, target_ref in observations:
                item["edge_rechecked"] = stable
                row["targets"].append(item)
                if stable and item["closed_observed"] and len(captures) == 1 and not gaps:
                    candidates[item["callback_class"]] = probe.call(probe.class_of, cb)
                    if not hasattr(probe, "trace_warm_targets"):
                        probe.trace_warm_targets = []
                    if len(probe.trace_warm_targets) < 32:
                        probe.trace_warm_targets.append((item["callback_class"], target_ref, item["capture_field"], cb))
                    if sum("owner_projection" in r for r in row["targets"]) < 2:
                        item["owner_projection"] = probe.owner_projection(target_ref)
            current = before["next"]
        if not probe.nullable_equal(head, probe.call(probe.head_field, probe.main_queue)):
            row["gaps"].append("head_changed_during_read")
        row["status"] = "observed" if not row["gaps"] and not row["caps_hit"] else "partial"
    except Exception as exc:
        row["gaps"].append(type(exc).__name__+":"+str(exc)[:100])
    row["duration_ms"] = round((time.monotonic()-started)*1000, 3)
    row["gaps"] = row["gaps"][:24]
    return row, candidates


def _q42_filters(name, owner=False):
    from base_plugin import HookFilter
    if not re.fullmatch(r"[A-Za-z_$][A-Za-z0-9_.$]*", name):
        raise ValueError("unsafe callback class name")
    value = "param.thisObject" if owner else "param.args[0].getCallback()"
    guard = "param.thisObject != null" if owner else "param.args[0] != null && param.args[0].getCallback() != null"
    return [HookFilter.Condition(guard + ' && ' + value + '.getClass().getName().equals("' + name + '")')]


class _Q42Trace:
    def __init__(self, plugin, probe, callback_class, lib):
        self.plugin_ref, self.probe, self.lib = weakref.ref(plugin), probe, lib
        self.callback_class = callback_class
        self.name = str(callback_class.getName())
        self.ids = _Q42Ids(probe)
        self.lock, self.closed, self.armed = threading.RLock(), False, False
        self.unhooks, self.events, self.sources, self.errors = [], [], {}, []
        self.targets = {}
        self.pairs = {}
        self.max_callback_ms = 0.0
        self.total_callback_ms = 0.0
        self.callback_calls = 0
        self.batch_projection_calls = 0
        self.generic_projection_calls = 0
        self.projection_setup = dict(status="not_started", reason="install_not_started")
        self.budget_started = time.monotonic()
        self.budget_ms = 0.0
        self.generation = time.monotonic_ns()
        self.started = time.monotonic()
        self.selftests = {}
        self.native_started = False

    def fault(self, site, exc=None):
        self.armed = False
        if len(self.errors) < 16:
            self.errors.append(site + (":"+type(exc).__name__ if exc is not None else ""))
        if self.native_started:
            self.lib.cd_qp_fault(self.generation)

    def hook(self, method, before, after, filters=None):
        plugin = self.plugin_ref()
        if plugin is None or self.closed:
            raise RuntimeError("detector unloaded")
        h = plugin.hook_method(method, before=before, after=after,
            before_filters=filters or [], after_filters=filters or [])
        if h is None:
            raise RuntimeError("SDK hook unavailable")
        self.unhooks.append(h)
        return h

    def unhook(self, handle):
        plugin = self.plugin_ref()
        if plugin is None:
            self.fault("unhook_plugin_missing"); return False
        try:
            plugin.unhook_method(handle)
            self.unhooks.remove(handle)
            return True
        except Exception as exc:
            self.fault("unhook", exc); return False

    def pair_selftest(self, method, run=False):
        p = self.probe
        Thread = _jc("java.lang.Thread")
        callback = Thread()
        owned = p.wr(callback)
        frames, count = [], [0, 0]
        trace_ref = weakref.ref(self)
        result = dict(passed=False, before=0, after=0, null_delivered=0)
        def before(param):
            trace = trace_ref()
            if trace is None or trace.closed:
                return
            try:
                cb = p.owner_from_param(param) if run else p.callback_from_param(param)
                if p.gone(cb):
                    result["null_delivered"] += 1
                    raise RuntimeError("null callback passed filter")
                if not p.equal(cb, owned):
                    raise RuntimeError("unrelated callback passed filter")
                if not run and not p.equal(p.queue_from_param(param), p.main_queue):
                    raise RuntimeError("selftest wrong queue")
                frames.append(p.wr(param)); count[0] += 1
            except Exception as exc:
                trace.fault("selftest_before", exc)
        def after(param):
            trace = trace_ref()
            if trace is None or trace.closed:
                return
            try:
                if not frames or not p.equal(frames.pop(), p.wr(param)):
                    raise RuntimeError("selftest pair mismatch")
                if p.outcome(param, run) != (0 if run else 1):
                    raise RuntimeError("selftest outcome mismatch")
                count[1] += 1
            except Exception as exc:
                trace.fault("selftest_after", exc)
        h = self.hook(method, before, after, _q42_filters("java.lang.Thread", owner=run))
        try:
            if run:
                callback.run()
            else:
                handler = _jc("android.os.Handler")(_jc("android.os.Looper").getMainLooper())
                if not handler.postDelayed(callback, 2000) or not handler.sendEmptyMessageDelayed(0, 2000):
                    raise RuntimeError("selftest post rejected")
            result.update(before=count[0], after=count[1], passed=count==[1, 1] and not frames and not self.errors)
        finally:
            if not self.unhook(h):
                result["passed"] = False
        if self.errors:
            raise RuntimeError("SDK pair/filter selftest failed")
        return result

    def install(self):
        p = self.probe
                                                                             
                                                                               
        run_test = _q42_cls("java.lang.Thread").getDeclaredMethod("run")
        run_test.setAccessible(True)
        self.selftests["run_pair"] = self.pair_selftest(run_test, True)
        if not self.selftests["run_pair"]["passed"]:
            raise RuntimeError("run pair not observed")
        selected = None
        for site, owner, method_name in (("handler_send_at_time", "android.os.Handler", "sendMessageAtTime"),
                                          ("message_queue", "android.os.MessageQueue", "enqueueMessage")):
            p.site = site
            method = _q42_cls(owner).getDeclaredMethod(method_name, _q42_cls("android.os.Message"), _jc("java.lang.Long").TYPE)
            method.setAccessible(True)
            result = self.pair_selftest(method)
            self.selftests[site] = result
            if result["passed"]:
                selected = method; break
        if selected is None:
            raise RuntimeError("no observed scheduling pair; no broad fallback")
        run = self.callback_class.getMethod("run")
        if str(run.getReturnType().getName()) != "void":
            raise RuntimeError("Runnable schema mismatch")
        run.setAccessible(True)
        p.capture_schema(self.callback_class)
        try:
            self.batched_projection = p.prepare_projection(self.callback_class)
        finally:
            self.projection_setup = dict(getattr(p, "projection_setup", {"status":"failed", "reason":"diagnostic_unavailable"}))
        self.stack_thread = _jc("java.lang.Thread")
        self.stack_arrays = _jc("java.util.Arrays")
        self.stack_arrays.toString(self.stack_thread.currentThread().getStackTrace())
        if self.lib.cd_qp_begin(self.generation) != 0:
            raise RuntimeError("native proof ledger busy")
        self.native_started = True
        ref = weakref.ref(self)
        def boundary(kind):
            def invoke(param):
                trace = ref()
                if trace is not None:
                    trace.observe(kind, param)
            return invoke
        self.hook(run, boundary(3), boundary(4), _q42_filters(self.name, owner=True))
        self.hook(selected, boundary(1), boundary(2), _q42_filters(self.name))
        self.armed = True

    def stack(self):
        if not hasattr(self, "stack_thread"):
            self.stack_thread = _jc("java.lang.Thread")
            self.stack_arrays = _jc("java.util.Arrays")
        raw = self.stack_thread.currentThread().getStackTrace()
        depth = len(raw)
        if depth > 64:
            raise RuntimeError("stack depth cap")
                                                                            
                                                                               
                                                                             
        text = str(self.stack_arrays.toString(raw))
        if len(text) > 64*322+2 or not (text.startswith("[") and text.endswith("]")):
            raise RuntimeError("stack serialization cap/schema")
        frames = tuple(text[1:-1].split(", ")) if depth else ()
        if len(frames) != depth or any(len(f) > 320 for f in frames):
            raise RuntimeError("stack frame cap/ambiguous serialization")
        dispatch = False
        for i, frame in enumerate(frames):
            if "android.os.Handler.handleCallback(" in frame:
                actual = raw[i]
                if str(actual.getClassName()) == "android.os.Handler" and str(actual.getMethodName()) == "handleCallback":
                    dispatch = True
        if frames not in self.sources:
            if len(self.sources) >= 64:
                raise RuntimeError("source stack cap")
            self.sources[frames] = len(self.sources)+1
        return self.sources[frames], dispatch

    def observe(self, kind, param):
        with self.lock:
            if self.closed or not self.armed:
                return
            started = time.monotonic()
            pt = 0
            try:
                p = self.probe
                if getattr(self, "batched_projection", False):
                    self.batch_projection_calls += 1
                    pref, cb, target, name, field, life, hashes, tid, target_name, projected_outcome = p.projected(param, run=kind in (3, 4), read_lifecycle=kind in (1, 3))
                    pt = self.ids.projected_token("param", pref, hashes[0])
                else:
                    self.generic_projection_calls += 1
                    pt = self.ids.token("param", p.wr(param))
                    cb, target, name, field, life = p.projection(param, run=kind in (3, 4), read_lifecycle=kind in (1, 3))
                    tid, target_name = None, None
                if name != self.name:
                    raise RuntimeError("Java filter misdelivery")
                if kind in (1, 3):
                    if pt in self.pairs or len(self.pairs) >= 256:
                        raise RuntimeError("before pair duplicate/cap")
                    if getattr(self, "batched_projection", False):
                        ct = self.ids.projected_token("callback", cb, hashes[1])
                        tt = self.ids.projected_token("target", target, hashes[2])
                    else:
                        ct, tt = self.ids.token("callback", cb), self.ids.token("target", target)
                    self.pairs[pt] = (kind, cb, target, ct, tt, field)
                else:
                    pair = self.pairs.pop(pt, None)
                    if not pair or pair[0] + 1 != kind or pair[5] != field or not p.equal(pair[1], cb) or not p.equal(pair[2], target):
                        raise RuntimeError("after pair identity mismatch")
                    ct, tt = pair[3], pair[4]
                if tt not in self.targets:
                    self.targets[tt] = dict(target_class=target_name or p.class_name(target), callback_class=name, capture_field=field)
                source, dispatch = self.stack() if kind in (1, 3) else (0, False)
                outcome = (projected_outcome if getattr(self, "batched_projection", False) else p.outcome(param, run=kind==4)) if kind in (2, 4) else -1
                if tid is None:
                    tid = int(_jc("java.lang.Thread").currentThread().getId())
                rid = int(self.lib.cd_qp_event(self.generation, kind, tid, pt, ct, tt, _q42_finished(life), outcome, source, int(dispatch)))
                if rid <= 0:
                    raise RuntimeError("native proof event rejected")
                if len(self.events) >= 4096:
                    raise RuntimeError("proof event journal cap")
                event = dict(event_id=len(self.events)+1, kind=kind, id=rid, tid=tid, param_token=pt, callback_token=ct, target_token=tt,
                    strictly_finished=_q42_finished(life), outcome=outcome, source_id=source, handler_dispatch_observed=dispatch,
                    ts=int(time.time()*1000))
                if kind in (1, 3):
                    event["lifecycle"] = life
                self.events.append(event)
            except Exception as exc:
                self.fault("callback", exc)
            finally:
                if kind in (2, 4) and pt:
                    self.ids.forget(pt)
                elapsed = (time.monotonic()-started)*1000
                self.max_callback_ms = max(self.max_callback_ms, elapsed)
                self.total_callback_ms += elapsed
                self.callback_calls += 1
                if started-self.budget_started >= 1.0:
                    self.budget_started, self.budget_ms = started, 0.0
                self.budget_ms += elapsed
                if elapsed > 20.0 or self.budget_ms > 30.0:
                    self.last_budget_failure = dict(callback_ms=round(elapsed, 3), bucket_ms=round(self.budget_ms, 3),
                        bucket_age_ms=round((started-self.budget_started)*1000, 3), kind=kind)
                    self.fault("observer_budget")

    def summary(self):
        with self.lock:
            if not self.native_started:
                return dict(generation=self.generation, edge_evidence_usable=False, local_coverage_complete=False, status="setup_failed", errors=list(self.errors), selftests=self.selftests, projection_setup=dict(self.projection_setup), batch_projection_calls=self.batch_projection_calls, generic_projection_calls=self.generic_projection_calls)
            buf = ctypes.create_string_buffer(8192)
            rc = self.lib.cd_qp_read(self.generation, buf, len(buf))
            if rc <= 0:
                self.fault("native_read")
                return dict(edge_evidence_usable=False, status="native_read_failed", errors=list(self.errors))
            out = json.loads(buf.value.decode("utf-8"))
            if self.errors or not self.selftests.get("run_pair", {}).get("passed"):
                out["edge_evidence_usable"] = False
                out["local_coverage_complete"] = False
            out.update(callback_class=self.name, hook_site=self.probe.site, selftests=self.selftests,
                projection_backend="java_weak_batch" if getattr(self, "batched_projection", False) else "generic_weak",
                projection_setup=dict(self.projection_setup), batch_projection_calls=self.batch_projection_calls,
                generic_projection_calls=self.generic_projection_calls,
                errors=list(self.errors), max_callback_ms=round(self.max_callback_ms, 3),
                total_callback_ms=round(self.total_callback_ms, 3), callback_calls=self.callback_calls,
                observer_budget=dict(single_callback_wall_ms=20, per_bucket_1s_wall_ms=30, exceeded_disables_proof=True),
                budget_failure=getattr(self, "last_budget_failure", None),
                elapsed_s=round(time.monotonic()-self.started, 3),
                source_stacks=[dict(source_id=i, frames=list(f)) for f, i in self.sources.items()],
                targets=[dict(target_token=k, **v) for k,v in self.targets.items()],
                no_forced_gc=True, measurement_isolation="instrumented; not a clean RSS/retained-byte measurement",
                limits=["visible result at this after-hook; later hooks may change it",
                    "unique observed prior submission does not exclude unobserved/direct submissions",
                    "missing, ambiguous or incomplete pairs never establish execution lineage",
                    "method origin is not exclusive plugin ownership; no crash-causation or byte attribution"])
            return out

    def close(self):
        with self.lock:
            if self.closed and not self.unhooks:
                return
            self.closed, self.armed = True, False
            handles = list(reversed(self.unhooks))
        for h in handles:
            self.unhook(h)
        with self.lock:
            if self.native_started:
                self.lib.cd_qp_end(self.generation)
            self.ids.close()
            self.pairs.clear()


def _q42_bind():
    lib = _NLIB
    if lib is None or not hasattr(lib, "cd_qp_api") or int(lib.cd_qp_api()) != 1:
        return None
    u, i = ctypes.c_uint64, ctypes.c_int
    lib.cd_qp_begin.argtypes, lib.cd_qp_begin.restype = [u], i
    lib.cd_qp_end.argtypes, lib.cd_qp_end.restype = [u], i
    lib.cd_qp_fault.argtypes, lib.cd_qp_fault.restype = [u], None
    lib.cd_qp_event.argtypes, lib.cd_qp_event.restype = [u,i,u,u,u,u,i,i,i,i], ctypes.c_int64
    lib.cd_qp_read.argtypes, lib.cd_qp_read.restype = [u,ctypes.c_void_p,ctypes.c_size_t], i
    return lib


def _q42_record(snapshot, proof=None):
    stable = [r for r in snapshot.get("targets", ()) if r.get("closed_observed") and r.get("edge_rechecked")]
    usable = bool(proof and proof.get("edge_evidence_usable"))
    if not stable and not usable:
        return None
    origins = []
    for source in (proof or {}).get("source_stacks", ()):
        for frame in source.get("frames", ()):
            if frame.startswith("org.telegram.ui.") and frame not in origins:
                origins.append(frame)
                break
    return dict(process_pid=os.getpid(), proof_generation=(proof or {}).get("generation"), ts=int(time.time()*1000) if usable else snapshot.get("ts") or int(time.time()*1000), event_type="queue_retention", kind="finished-screen-queue-retention",
        had_crash=False, had_leak=False, leak_confirmed=False, attribution=False,
        culprit="undetermined", culprit_kind=None, owner_status="not_identified", host_side=False,
        evidence_status="reschedule_proven" if usable else "queue_reference_observed",
        root_status="queue_field_path_observed_non_atomic" if stable else "not_scanned",
        confidence="high" if usable else "medium", bytes_attributed=None,
        callback_class=(proof or {}).get("callback_class") or (stable[0]["callback_class"] if stable else None),
        reason=("Закрытый экран: подтверждено перепланирование callback; исключительный владелец и причина краша не установлены" if usable
            else "Закрытый экран достижим через callback в очереди; снимок неатомарный, выполнение и утечка не доказаны"),
        queue=snapshot, proof=proof, origin_methods=origins[:12], where=origins[0] if origins else None, observation_basis="queue-fields-and-filtered-before-after" if usable else "sampled-queue-fields",
        exc_cls="FinishedScreenReschedule" if usable else "FinishedScreenQueueReference")


class _Q42Monitor:
    def __init__(self, plugin):
        self.plugin_ref = weakref.ref(plugin)
        self.stop_event, self.lock = threading.Event(), threading.RLock()
        self.thread, self.probe, self.watch, self.trace = None, None, None, None
        self.last_closed_trace = None
        self.retired_trace_ref = None
        self.last_snapshot = {}
        self.next_trace = 0
        self.last_trace_write = 0
        self.lib = None
        self.last_emitted = {}
        self.class_last_trace = {}

    def write(self, name, value):
        path = _data_path(name)
        if path:
            return bool(_atomic_json_write(path, value, 4*1024*1024))
        return False

    def checkpoint(self, trace, metadata=None):
        with trace.lock:
            result = trace.summary()
            result.update(metadata or {})
            result["journal_checkpoint_saved"] = True
            result["process_pid"] = os.getpid()
            payload = dict(summary=result, events=list(trace.events))
        ok = self.write("queue_retention_trace.json", payload)
        with trace.lock:
            if not ok:
                trace.fault("evidence_write")
                result["journal_checkpoint_saved"] = False
            if not ok or trace.errors:
                result["edge_evidence_usable"] = False
                result["local_coverage_complete"] = False
                result["errors"] = list(trace.errors)
        return result

    def finish_trace(self, reason):
        with self.lock:
            trace = self.trace
            if trace is None:
                return None
            trace.close()
            result = self.checkpoint(trace, dict(stop_reason=reason, unhooks_remaining=len(trace.unhooks),
                weak_storage_released=not trace.ids.entries))
            if trace.unhooks:
                result["edge_evidence_usable"] = False
                result["local_coverage_complete"] = False
            self.last_closed_trace = result
            rec = _q42_record(self.last_snapshot, result)
            if rec and result.get("edge_evidence_usable"):
                _b42_append_dedup("queue_retention_verdict.json", rec, dedup_key=("callback_class","evidence_status","proof_generation"))
            if not trace.unhooks:
                self.retired_trace_ref = weakref.ref(trace)
                self.trace = None
            self.next_trace = time.monotonic()+60
            return result

    def run(self):
        try:
            self.lib = _q42_bind()
            self.probe = _Q42Probe()
            self.watch = _Q42Ids(self.probe, cap=2048)
            while not self.stop_event.wait(15):
                if not _b42_foreground():
                    if self.trace:
                        self.finish_trace("background")
                    continue
                snapshot, candidates = _q42_queue_snapshot(self.probe, self.watch)
                self.last_snapshot = snapshot
                if self.last_closed_trace is not None and self.retired_trace_ref is not None:
                    self.last_closed_trace["trace_python_collectible_without_forced_gc"] = self.retired_trace_ref() is None
                with self.lock:
                    if self.stop_event.is_set():
                        break
                    if self.trace and (self.trace.errors or self.trace.closed or time.monotonic()-self.trace.started >= 180):
                        self.finish_trace("health_error" if self.trace.errors else "window_complete")
                    eligible = {n:c for n,c in candidates.items() if time.monotonic()-self.class_last_trace.get(n, -1e9) >= 300}
                    if self.trace is None and eligible and self.lib is not None and time.monotonic() >= self.next_trace:
                        plugin = self.plugin_ref()
                        if plugin is not None:
                            name = min(eligible, key=lambda n:(self.class_last_trace.get(n, -1e9), n))
                            self.class_last_trace[name] = time.monotonic()
                            self.trace = _Q42Trace(plugin, self.probe, eligible[name], self.lib)
                            try:
                                self.trace.install()
                            except Exception as exc:
                                self.trace.fault("setup", exc)
                                self.finish_trace("setup_failed")
                        plugin = None
                    proof = self.trace.summary() if self.trace else None
                    if proof and time.monotonic()-self.last_trace_write >= 30:
                        proof = self.checkpoint(self.trace)
                        self.last_trace_write = time.monotonic()
                    elif proof:
                        proof["journal_checkpoint_saved"] = False
                        proof["edge_evidence_usable"] = False
                    self.write("queue_retention_state.json", dict(version=1, detector_version=__version__, ts=int(time.time()*1000),
                        native_proof_available=self.lib is not None, queue=snapshot, active_proof=proof,
                        last_closed_proof=self.last_closed_trace, forced_gc_requested=False))
                    rec = _q42_record(snapshot, proof)
                    if rec:
                        key = (rec.get("callback_class"), rec["evidence_status"])
                        if time.monotonic()-self.last_emitted.get(key, -1e9) > 300:
                            if not _b42_append_dedup("queue_retention_verdict.json", rec, dedup_key=()):
                                continue
                            self.last_emitted[key] = time.monotonic()
                            _log("Block#42 +UG: %s; callback=%s; plugin owner unresolved" % (rec["evidence_status"], rec.get("callback_class")))
        except Exception as exc:
            self.write("queue_retention_state.json", dict(ts=int(time.time()*1000), status="unavailable", error_type=type(exc).__name__, detail=str(exc)[:160], forced_gc_requested=False))
        finally:
            self.finish_trace("monitor_stopped")
            if self.watch:
                self.watch.close()
            self.probe = None

    def stop(self):
        self.stop_event.set()
        self.finish_trace("disabled_or_unloaded")
        if self.thread and self.thread is not threading.current_thread():
            self.thread.join(timeout=2)


_Q42_MONITOR = [None]
_Q42_CONTROL_LOCK = threading.RLock()


def _q42_start(plugin):
    with _Q42_CONTROL_LOCK:
        if _Q42_MONITOR[0] is not None or not plugin.get_setting("queue_retention_on", True) or globals().get("_SAFE_MODE"):
            return
        monitor = _Q42Monitor(plugin)
        _Q42_MONITOR[0] = monitor
        monitor.thread = threading.Thread(target=monitor.run, name="cd_queue_probe", daemon=True)
        monitor.thread.start()


def _q42_stop():
    with _Q42_CONTROL_LOCK:
        monitor = _Q42_MONITOR[0]
        if monitor is not None:
            monitor.stop()
            if monitor.thread is None or not monitor.thread.is_alive():
                _Q42_MONITOR[0] = None
            else:
                _log("Block#42 +UG: worker still stopping; new monitor gated")


def _b42_nc_measure(scopes):
    p = _Q42Weak()
    ids = _Q42Ids(p, cap=16384)
    summary, series = {}, {}
    started = time.monotonic()
    try:
        for label, scope_key, nc in scopes:
            d = dict(registrations=0, ids=0, strong=0, weak_live=0, weak_dead=0,
                unique_observers=None, unique_live_targets=None, scope_key=scope_key,
                top_classes=[], groups=[], complete=True, gaps=[], caps_hit=[], non_atomic=True)
            summary[label] = d
            wrappers, targets, groups, classes = set(), set(), {}, {}
            try:
                field = _jfield(nc, "observers")
                sa = field.get(nc) if field is not None else None
                if sa is None:
                    raise RuntimeError("observers unavailable")
                n = int(sa.size())
                if n > 1024:
                    raise RuntimeError("event table cap")
                weak_fields = {}
                for i in range(n):
                    if time.monotonic()-started > 0.5:
                        d["caps_hit"].append("time"); break
                    lst, event = sa.valueAt(i), int(sa.keyAt(i))
                    if lst is None:
                        continue
                    size = int(lst.size())
                    if size > 8192 or d["registrations"]+size > 8192:
                        d["caps_hit"].append("registrations"); break
                    d["ids"] += 1
                    for j in range(size):
                        if time.monotonic()-started > 0.5:
                            d["caps_hit"].append("time"); break
                        obj = lst.get(j)
                        if obj is None:
                            d["gaps"].append("null_observer"); continue
                        ref = p.wr(obj)
                        obj = None
                        wrapper = ids.token("wrapper", ref)
                        wrappers.add(wrapper)
                        name = p.class_name(ref)
                        target, kind = ref, "strong"
                        if name.endswith("WeakObserversGroupImpl"):
                            if name not in weak_fields:
                                weak_fields[name] = p.field(p.call(p.class_of, ref), "reference")
                            weak = p.call(weak_fields[name], ref)
                            if p.gone(weak):
                                raise RuntimeError("weak wrapper reference unavailable")
                            target = p.call(p.deref, weak)
                            kind = "weak_dead" if p.gone(target) else "weak_live"
                            name = "<cleared weak target>" if kind == "weak_dead" else p.class_name(target)
                        target_token = ids.token("target", target)
                        if target_token:
                            targets.add(target_token)
                        d["registrations"] += 1
                        d[kind] += 1
                        display = name + (" (weak)" if kind.startswith("weak_") else "")
                        classes[display] = classes.get(display, 0)+1
                        key = (event, name, kind)
                        if key not in groups:
                            if len(groups) >= 512:
                                d["caps_hit"].append("groups"); break
                            groups[key] = [0, set(), set()]
                        g = groups[key]
                        g[0] += 1; g[1].add(wrapper)
                        if target_token:
                            g[2].add(target_token)
                    if int(lst.size()) != size:
                        d["gaps"].append("observer_list_changed")
                    if d["caps_hit"]:
                        break
                if int(sa.size()) != n:
                    d["gaps"].append("event_table_changed")
                d["complete"] = not d["gaps"] and not d["caps_hit"]
                d["unique_observers"], d["unique_live_targets"] = len(wrappers), len(targets)
                d["top_classes"] = sorted(classes.items(), key=lambda x: -x[1])[:12]
                for (event, name, kind), (count, uw, ut) in groups.items():
                    d["groups"].append(dict(event=event, cls=name, reference_kind=kind, registrations=count,
                        unique_observers=len(uw), unique_live_targets=len(ut)))
                    if d["complete"]:
                        series[(scope_key, event, name, kind)] = count
            except Exception as exc:
                d["complete"] = False
                d["gaps"].append(type(exc).__name__+":"+str(exc)[:100])
            d["gaps"] = d["gaps"][:16]
            d["caps_hit"] = list(dict.fromkeys(d["caps_hit"]))
            d["ts"] = int(time.time()*1000)
            d["duration_ms"] = round((time.monotonic()-started)*1000, 3)
        return summary, series
    finally:
        ids.close()

def _b42_nc_reset():
    _B42_NC_SESSION[0] = time.monotonic_ns()
    _B42_NC_HIST.clear()
    _B42_NC_CACHE[0] = None
    _B42_NC_LAST[0] = 0

_B42_NC_SESSION = [time.monotonic_ns()]
_B42_NC_CACHE = [None]
_B42_NC_LOCK = threading.RLock()


def _b42_delegate_name(obj):
    if obj is None:
        return "null"
    try:
        cls = obj.getClass()
        s = str(cls.getName() or "")
    except Exception:
        return "?"
    if s.endswith("WeakObserversGroupImpl"):
        try:
            f = _jfield(obj, "reference")
            ref = f.get(obj) if f is not None else None
            tgt = ref.get() if ref is not None else None
            if tgt is None:
                return "cleared (weak)"
            return str(tgt.getClass().getName() or "cleared (weak)") + " (weak)"
        except Exception:
            return s
    return s


def _b42_nc_census(force=False):
    now = int(time.time()*1000)
    if not force and globals().get("_CP_LIFECYCLE") in ("unloading", "unloaded", "disabled"):
        return None
    try:
        Looper = _jc("android.os.Looper")
        if Looper.myLooper() == Looper.getMainLooper():
            return _B42_NC_CACHE[0]
    except Exception:
        return None
    if not force:
        if now-_B42_NC_LAST[0] < _B42_NC_PERIOD_MS or not _b42_foreground():
            return None
    if not _B42_NC_LOCK.acquire(False):
        return _B42_NC_CACHE[0]
    try:
        session = _B42_NC_SESSION[0]
        if not force:
            _B42_NC_LAST[0] = now
        NC, UC = _jc("org.telegram.messenger.NotificationCenter"), _jc("org.telegram.messenger.UserConfig")
        if NC is None:
            _B42_NC_HIST.clear(); return None
        scopes, errors = [], []
        try:
            account = int(UC.selectedAccount)
            acc = NC.getInstance(account)
            if acc is None:
                raise RuntimeError("account NC unavailable")
            scopes.append(("account", "account:%d" % account, acc))
        except Exception as exc:
            errors.append(type(exc).__name__)
        try:
            glob = NC.getGlobalInstance()
            if glob is None:
                raise RuntimeError("global NC unavailable")
            scopes.append(("global", "global", glob))
        except Exception as exc:
            errors.append(type(exc).__name__)
        summary, counts = _b42_nc_measure(scopes)
        if session != _B42_NC_SESSION[0]:
            return None
        for d in summary.values():
            d["census_generation"] = session
            if errors:
                d["scope_errors"] = errors
        _B42_NC_CACHE[0] = summary
        if force:
            return summary
        path = _data_path("nc_observers_state.json")
        if path:
            _atomic_json_write(path, dict(ts=now, detector_version=__version__, observers=summary,
                scope_errors=errors, census_generation=session, forced_gc_requested=False, non_atomic=True), 2*1024*1024)
        if errors or not summary or any(not d["complete"] for d in summary.values()):
            _B42_NC_HIST.clear()
            return summary
        for key in list(_B42_NC_HIST):
            if key not in counts:
                del _B42_NC_HIST[key]
        for key, count in counts.items():
            history = _B42_NC_HIST.setdefault(key, [])
            if history and now-history[-1][0] > _B42_NC_PERIOD_MS*2:
                history.clear()
            history.append((now, int(count)))
            del history[:-_B42_NC_KEEP]
        growth = []
        for (scope, event, name, kind), history in _B42_NC_HIST.items():
            if len(history) < 3 or kind == "weak_dead":
                continue
            seq = [c for _,c in history]
            if seq[-1] >= _B42_NC_MIN and seq[-1]-seq[0] >= _B42_NC_GROWTH and all(a<=b for a,b in zip(seq,seq[1:])):
                growth.append(dict(scope_key=scope, event=event, cls=name, reference_kind=kind,
                    first=seq[0], last=seq[-1], growth=seq[-1]-seq[0], n=len(seq), span_s=round((history[-1][0]-history[0][0])/1000,1)))
        if not growth:
            return summary
        growth.sort(key=lambda d: -d["growth"])
        top = growth[0]
        owner = None
        try:
            ent = _B14_IFACE_OWNER.get(top["cls"])
            owner = ent[0] if isinstance(ent, (tuple,list)) else ent
            if owner in (_SELF_ID, __id__):
                owner = None
        except Exception:
            pass
        rec = dict(had_leak=False, suspected_leak=True, leak_confirmed=False,
            verdict="SUSPECTED NOTIFICATIONCENTER REGISTRATION GROWTH", culprit="undetermined", culprit_kind=None,
            host_side=False, suspect=None, candidate_owner=owner, confidence="low", attribution=False,
            root_status="not_identified", owner_status="not_identified", observation_basis="registration-count",
            unique_objects_counted=True, unique_counts_scope="per-snapshot; not cross-snapshot survival",
            weak_observers=top["reference_kind"]=="weak_live", kind="nc-observer-growth", leak_class=top["cls"],
            census_generation=session, scope_key=top["scope_key"], event=top["event"], reference_kind=top["reference_kind"],
            first=top["first"], last=top["last"], growth=top["growth"], samples=top["n"], span_s=top["span_s"],
            observers=summary, all_leaks=growth[:6],
            reason="Рост регистраций %s в %s / event=%s (%s); уникальные объекты посчитаны отдельно, причина роста и GC-root не установлены" % (top["cls"],top["scope_key"],top["event"],top["reference_kind"]),
            exc_cls="NotificationCenterRegistrationGrowth", exc_msg="%s regs=%d (+%d)" % (top["cls"],top["last"],top["growth"]),
            ts=now, event_type="nc_observer_growth", dropbox_tag="memory_observation", tombstone_norm_version=1)
        if _b42_append_dedup(_B42_NC_FILE, rec, dedup_key=("leak_class","scope_key","event","reference_kind")):
            _log("Block#42 +UG: NC registrations %s/%s/%s/%s %d->%d; owner unresolved" %
                (top["scope_key"],top["event"],top["cls"],top["reference_kind"],top["first"],top["last"]))
        return summary
    except Exception:
        if not force:
            _B42_NC_HIST.clear()
        raise
    finally:
        _B42_NC_LOCK.release()


def _b42_nc_snapshot():
    try:
        s = _b42_nc_census(force=True)
        if not s:
            return None
        out = {}
        for label,d in s.items():
            out[label] = {key:d.get(key) for key in ("ts","scope_key","registrations","ids","strong","weak_live","weak_dead",
                "unique_observers","unique_live_targets","complete","gaps","caps_hit","non_atomic")}
            out[label]["top_classes"] = d.get("top_classes", [])[:6]
        return out
    except Exception:
        return None


def _b42_hprof_dump(reason):
    now = int(time.time() * 1000)
    if now - _B42_HPROF_LAST[0] < _B42_HPROF_MIN_GAP_MS:
        return None
    _B42_HPROF_LAST[0] = now
    raw = None
    try:
        d = File(_DIR, _B42_HPROF_DIRNAME)
        if not d.exists():
            d.mkdirs()
        base = "heap_%d" % (now // 1000)
        raw = File(d, base + ".hprof").getAbsolutePath()
        gz = File(d, base + ".hprof.gz").getAbsolutePath()
        _b42_gc()
        Debug = _jc("android.os.Debug")
        Debug.dumpHprofData(raw)
        import gzip as _gzip
        sz = 0
        with open(raw, "rb") as _fi, _gzip.open(gz, "wb") as _fo:
            while True:
                chunk = _fi.read(1 << 20)
                if not chunk:
                    break
                _fo.write(chunk)
                sz += len(chunk)
        try: os.remove(raw)
        except Exception: pass
        raw = None
        try:
            if os.path.getsize(gz) > _B42_HPROF_MAX_BYTES:
                os.remove(gz)
                _log("Block#42 +TN: hprof (%s) превысил лимит %dМБ -> удалён" % (reason, _B42_HPROF_MAX_BYTES // (1024 * 1024)))
                return None
        except Exception:
            pass
        _log("Block#42 +TN: hprof-дамп сохранён (%s): %s (raw heap=%dБ)" % (reason, gz, sz))
        return gz
    except Exception as e:
        try:
            if raw:
                os.remove(raw)
        except Exception:
            pass
        _log("Block#42 +TN: hprof-дамп не удался (%s): %r" % (reason, e))
        return None


def _b42_enabled_plugins():
    out = {}
    off = set()
    try:
        for e in _b41_plugin_entries_safe():
            try:
                pid = _safe_str(e.getKey())
                p = e.getValue()
                if not pid:
                    continue
                en = _b11_attr(p, "isEnabled", "getEnabled", "enabled") if p is not None else None
                if en is None:
                    en = _b11_is_loaded(pid)
                if not bool(en):
                    off.add(pid)
                    continue
                ver = _b11_attr(p, "getVersion", "version") if p is not None else None
                if ver is not None and str(ver) not in ("", "None", "null"):
                    out[pid] = str(ver)
                else:
                    out[pid] = None
            except Exception:
                continue
    except Exception:
        pass
    try:
        with _REG_LOCK:
            reg = dict(_REGISTRY)
        for pid, r in reg.items():
            if r and r.get("inst") and pid not in out:
                out[pid] = None
    except Exception:
        pass
    try:
        for pid in _b27_live_pids():
            if pid and pid not in out and pid not in off:
                out[pid] = None
    except Exception:
        pass
    if not out:
        _b42_plugins_diag(out)
        return None
    for k in list(out):
        if not out[k]:
            out[k] = _b42_file_version(k)
    _b42_plugins_diag(out)
    return sorted("%s %s" % (k, v if v else "?") for k, v in out.items())


_B42_FVER_CACHE = {}
_B42_PSET = [None]
_B42_PDIAG = [0, 0]


def _b42_file_version(pid):
    try:
        d = _b11p_plugins_dir()
        if not d:
            return None
        p = os.path.join(d, "%s.py" % pid)
        if not os.path.isfile(p):
            p = os.path.join(d, "%s.plugin" % pid)
            if not os.path.isfile(p):
                return None
        mt = os.path.getmtime(p)
        c = _B42_FVER_CACHE.get(p)
        if c and c[0] == mt:
            return c[1]
        with open(p, "r", encoding="utf-8", errors="replace") as f:
            head = f.read(65536)
        m = re.search(r"""^__version__\s*=\s*['"]([^'"]{1,40})['"]""", head, re.M)
        v = m.group(1) if m else None
        _B42_FVER_CACHE[p] = (mt, v)
        return v
    except Exception:
        return None


def _b42_plugins_diag(out):
    try:
        miss = [k for k, v in (out or {}).items() if not v]
        try:
            _cur = set((out or {}).keys())
            _prev = _B42_PSET[0]
            _B42_PSET[0] = _cur
            if _prev is not None and _cur != _prev:
                _log("Block#42 +TR: набор плагинов изменился: +%s -%s (всего %d)" % (sorted(_cur - _prev), sorted(_prev - _cur), len(_cur)))
        except Exception:
            pass
        if _B42_PDIAG[0] and (_B42_PDIAG[1] or not miss):
            return
        ents = _b41_plugin_entries_safe()
        info = {"ctrl": _B11_CTRL_HOW[0], "ctrl_err": _B11_CTRL_HOW[1], "entries": len(ents)}
        if ents:
            try:
                p = ents[0].getValue()
                info["key0"] = _safe_str(ents[0].getKey())
                info["cls"] = _safe_str(p.getClass().getName()) if p is not None else None
                _det = []
                for _e in ents[:16]:
                    try:
                        _p = _e.getValue()
                        _det.append("%s:%s:%s" % (_safe_str(_e.getKey()), _b11_attr(_p, "isEnabled", "getEnabled", "enabled"), _b11_attr(_p, "getVersion", "version")))
                    except BaseException as _x:
                        _det.append("ERR %s" % type(_x).__name__)
                info["detail"] = _det
                for nm in ("isEnabled", "getId", "getVersion", "getName", "getAuthor"):
                    try:
                        v = getattr(p, nm)
                        v = v() if callable(v) else v
                        info[nm] = _safe_str(v)[:60] if v is not None else None
                    except BaseException as e:
                        info[nm] = "ERR %s" % (type(e).__name__,)
            except BaseException as e:
                info["entry_err"] = repr(e)[:120]
        try:
            with _REG_LOCK:
                info["registry"] = sum(1 for r in _REGISTRY.values() if r and r.get("inst"))
        except Exception:
            pass
        info["total"] = len(out or {}); info["no_version"] = miss[:8]
        try:
            info["plugins_dir"] = _b11p_plugins_dir()
        except Exception:
            pass
        if not _B42_PDIAG[0]:
            _B42_PDIAG[0] = 1
            _log("Block#42 +TQ: plugins diag: %s" % info)
            if miss:
                _B42_PDIAG[1] = 1
        elif miss and not _B42_PDIAG[1]:
            _B42_PDIAG[1] = 1
            _log("Block#42 +TQ: версия не найдена ни в Plugin, ни в файле: %s" % info)
        if not ents and info.get("registry"):
            _log("Block#42 +TQ: getPlugins() пуст при непустом реестре (ctrl=%s err=%s)" % (info["ctrl"], info["ctrl_err"]))
    except Exception:
        pass

def _b41_plugin_entries_safe():
    try:
        return _b11_plugin_entries()
    except Exception:
        return []


def _b42_append_dedup(name, rec, dedup_key=()):
    try:
        p = _data_path(name)
        if not p:
            return False
        cur = []
        if os.path.exists(p):
            try:
                with open(p, "r", encoding="utf-8") as f:
                    cur = list(json.load(f))
            except Exception:
                cur = []
        now = int(rec.get("ts") or (time.time() * 1000))
        if dedup_key:
            for old in reversed(cur[-6:]):
                try:
                    if all(old.get(k) == rec.get(k) for k in dedup_key) and abs(int(old.get("ts") or 0) - now) < 3600000:
                        return False
                except Exception:
                    continue
        cur.append(rec)
        _atomic_json_write(p, cur, 20)
        return True
    except Exception:
        return False


def _dn_hot_frames(midsamples):
    top_hist = {}
    app_hist = {}
    n = 0
    py_n = 0
    for s in midsamples or []:
        try:
            jf = s.get("jframes") or []
        except Exception:
            jf = []
        if not jf:
            continue
        n += 1
        t0 = jf[0]
        top_hist[t0] = top_hist.get(t0, 0) + 1
        inpy = False
        for f in jf:
            try:
                cls = f.split("(", 1)[0]
                if cls.startswith(_B42_GLUE_PREFIXES):
                    if cls.startswith(_B42_PY_BRIDGE) and not inpy:
                        inpy = True; py_n += 1
                    continue
                if cls.startswith(_B42_APP_PREFIXES):
                    app_hist[f] = app_hist.get(f, 0) + 1
                    break
            except Exception:
                continue
    if n <= 0:
        return None
    top_sorted = sorted(top_hist.items(), key=lambda kv: -kv[1])
    out = {"samples": n, "top_hist": [[k, v] for k, v in top_sorted[:5]]}
    if py_n:
        out["py_samples"] = py_n
    if app_hist:
        app_sorted = sorted(app_hist.items(), key=lambda kv: -kv[1])
        best, cnt = app_sorted[0]
        out["top_app_frame"] = best
        out["top_app_pct"] = round(100.0 * cnt / n, 1)
        out["app_hist"] = [[k, v] for k, v in app_sorted[:5]]
    return out


def _b42_native_hot_frames():
    if not (_B42_HF_OK and _NLIB is not None):
        return None
    try:
        buf = ctypes.create_string_buffer(8192)
        n = int(_NLIB.cd_hf_read(buf, 8192, 8))
        if n <= 0:
            return None
        txt = buf.raw[:n].decode("utf-8", "replace")
    except Exception:
        return None
    out = {"source": "native-20ms"}
    top = []; app = []
    for ln in txt.splitlines():
        try:
            if ln.startswith("S "):
                p = ln.split()
                out["samples"] = int(p[1]); out["app_samples"] = int(p[2])
                out["max_depth"] = int(p[3]); out["span_ms"] = int(p[4])
                if len(p) > 6: out["py_samples"] = int(p[6])
            elif ln.startswith("T "):
                _, c, f = ln.split(" ", 2); top.append([f, int(c)])
            elif ln.startswith("A "):
                _, c, f = ln.split(" ", 2); app.append([f, int(c)])
        except Exception:
            continue
    ns = int(out.get("samples") or 0)
    if ns <= 0:
        return None
    out["top_hist"] = top[:5]
    if top:
        out["top_frame"] = top[0][0]
        out["top_pct"] = round(100.0 * top[0][1] / ns, 1)
    if app:
        out["top_app_frame"] = app[0][0]
        out["top_app_pct"] = round(100.0 * app[0][1] / ns, 1)
        out["app_hist"] = app[:5]
    return out


def _b42_hot_frames(midsamples):
    h = None
    try: h = _b42_native_hot_frames()
    except Exception: h = None
    if not h:
        try:
            h = _dn_hot_frames(midsamples)
            if h: h["source"] = "py-midstall"
        except Exception:
            h = None
    if h:
        try:
            _fr = [x[0] for x in (h.get("top_hist") or [])] + [x[0] for x in (h.get("app_hist") or [])]
            _ow = _dn_java_plugin_owner(_fr)
            if _ow: h["hot_owner"] = _ow
        except Exception:
            pass
        try:
            _ns = int(h.get("samples") or 0); _pn = int(h.get("py_samples") or 0)
            if _ns > 0 and _pn > 0:
                h["py_pct"] = round(100.0 * _pn / _ns, 1)
                if _pn * 2 >= _ns:
                    h["in_python"] = True
                    _oc = {}
                    for _s in midsamples or []:
                        try:
                            _o = _s.get("scope_owner")
                            if _o: _oc[_o] = _oc.get(_o, 0) + 1
                        except Exception:
                            continue
                    if _oc:
                        h["py_owner"] = sorted(_oc.items(), key=lambda kv: -kv[1])[0][0]
        except Exception:
            pass
    return h


def _b42_tick(where):
    if not _B42_ON:
        return
    try:
        _b42_object_census(False)
    except Exception as e:
        try: _log("Block#42 +TN: object census err: %r" % e)
        except Exception: pass
    try:
        _b42_nc_census(False)
    except Exception as e:
        try: _log("Block#42 +TN: nc census err: %r" % e)
        except Exception: pass


def _leak_emit(decoded, where):
    try:
        dims = decoded.get("dims", [])
        leaking = [d for d in dims if d.get("leaking")]
        if not leaking:
            return
        try: adj, score = _proc_oom_score()
        except Exception: adj, score = None, None
        rss_r2 = max([d["r2"] for d in leaking if d["dim"] == "rss"] or [0.0])
        conf = "high" if rss_r2 >= 0.90 else "medium"
        _gref_attr = None
        try:
            _lk = [d.get("dim") for d in leaking]
            if any(x in ("native", "rss", "java") for x in _lk):
                _g = _oom_gref_top()
                if not _g:
                    _g = _iz_proxy_top()
                if _g:
                    _gc = int(_g.get("count") or 0); _gt = int(_g.get("total") or 0)
                    _gu = int(_g.get("untagged") or 0); _gnm = _gt - _gu
                    _gsh = (float(_gc) / float(_gnm)) if _gnm > 0 else ((float(_gc) / float(_gt)) if _gt > 0 else 0.0)
                    if _g.get("culprit") and _gc >= _B28C_MIN and _gsh >= _B28C_DOMINANCE:
                        _gref_attr = {"culprit": _g.get("culprit"), "count": _gc,
                                      "total": _gt, "share": round(_gsh, 4),
                                      "untagged": int(_g.get("untagged") or 0),
                                      "src": (_g.get("src") or "native"), "live": bool(_g.get("live"))}
        except Exception:
            _gref_attr = None
        if _gref_attr:
            try:
                if _gref_attr.get("live"):
                    _log("Block#6D/A: client leak attributed to LIVE native global-refs (+JO: DeleteGlobalRef tracked; confirmed holder) -> %s (%d/%d live gref, %.0f%%)" % (
                        _gref_attr["culprit"], _gref_attr["count"], _gref_attr["total"], _gref_attr["share"] * 100.0))
                else:
                    _log("Block#6D/A: client leak attributed to native global-ref CREATION/churn (not a confirmed leak; live map degraded or pre-+JO .so) -> %s (%d/%d gref, %.0f%%)" % (
                        _gref_attr["culprit"], _gref_attr["count"], _gref_attr["total"], _gref_attr["share"] * 100.0))
            except Exception: pass
        _ii_ambient = None
        try:
            if _gref_attr:
                _iu = int(_gref_attr.get("untagged") or 0)
                _it = int(_gref_attr.get("total") or 0)
                _ic = int(_gref_attr.get("count") or 0)
                _iu_sh = (float(_iu) / float(_it)) if _it > 0 else 0.0
                _abs_sh = (float(_ic) / float(_it)) if _it > 0 else 0.0
                _java_leak = any(d.get("dim") == "java" and d.get("leaking") for d in dims)
                _rssnat = any(d.get("dim") in ("rss", "native") and d.get("leaking") for d in dims)
                if (_iu_sh >= _B28C_UNTAG_AMBIENT) and _rssnat and (not _java_leak) and (_abs_sh < _B28C_ABS_MIN_SHARE):
                    _ii_ambient = {"gref_suspect": dict(_gref_attr), "untagged_share": round(_iu_sh, 4), "abs_share": round(_abs_sh, 4)}
                    _gref_attr = None
                    conf = "low"
                    try: _log("Block#6D/A +II: gref attribution demoted (ambient/untagged dominates: untagged=%.0f%% of total, suspect abs=%.1f%% of total, rss/native leak, java flat) -> host-unattributed low" % (_iu_sh * 100.0, _abs_sh * 100.0))
                    except Exception: pass
        except Exception:
            _ii_ambient = None
        _jr_reclass = None
        try:
            if _gref_attr:
                _jr_java = any(d.get("dim") == "java" and d.get("leaking") for d in dims)
                _jr_rssnat = any(d.get("dim") in ("rss", "native") and d.get("leaking") for d in dims)
                if _jr_rssnat and (not _jr_java):
                    try: _na_dump(where)
                    except Exception: pass
                    _jr_ns = None
                    try: _jr_ns = _na_top_bucket_summary()
                    except Exception: _jr_ns = None
                    _jr_hostb, _jr_plugb, _jr_hostsh = _jr_native_host_split(_jr_ns)
                    _jr_untag_sh = 0.0
                    try:
                        _jt = int(_gref_attr.get("total") or 0); _ju = int(_gref_attr.get("untagged") or 0)
                        _jr_untag_sh = (float(_ju) / float(_jt)) if _jt > 0 else 0.0
                    except Exception: _jr_untag_sh = 0.0
                    _jr_was_host = (_LEAK_LAST_KIND.get(where) == "host")
                    _jr_pyrt_ok = (_jr_plugb < _JR_PLUGIN_NATIVE_MIN_BYTES)
                    _jr_trig = None
                    if _jr_pyrt_ok:
                        if _jr_hostsh >= _JR_NATIVE_HOST_SHARE: _jr_trig = "native_host_dominated"
                        elif _jr_untag_sh >= _B28C_UNTAG_AMBIENT_LO: _jr_trig = "untagged_dominant+native_flat"
                        elif _jr_was_host: _jr_trig = "hysteresis_prior_host"
                    if _jr_trig:
                        _jr_reclass = {"gref_suspect": dict(_gref_attr), "trigger": _jr_trig,
                                       "native_host_bytes": int(_jr_hostb), "native_plugin_bytes": int(_jr_plugb),
                                       "native_host_share": round(_jr_hostsh, 4), "untagged_share": round(_jr_untag_sh, 4),
                                       "top_modules": (_jr_ns.get("modules") if _jr_ns else None),
                                       "prior_host": bool(_jr_was_host),
                                       "basis": "live-gref pin not corroborated by native (host libs own %.0f%% of sampled native bytes, python-runtime ~%dB) or java-heap growth -> host-native leak, gref is churn/correlation" % (_jr_hostsh * 100.0, int(_jr_plugb))}
                        _gref_attr = None
                        if conf != "low":
                            _jr_reclass["conf_from"] = conf; conf = "low"
                        try: _log("Block#6D/A +JR: gref attribution reclassified to HOST (trigger=%s host_native=%.0f%% py-rt=%dB untagged=%.0f%%%s) -> kind=host, plugin kept as gref_suspect, conf=low" % (_jr_trig, _jr_hostsh * 100.0, int(_jr_plugb), _jr_untag_sh * 100.0, (", prior_host" if _jr_was_host else "")))
                        except Exception: pass
        except Exception:
            _jr_reclass = None
        _na_sum = None; _na_dumped = False
        if (not _gref_attr) and (not _ii_ambient):
            try: _na_dump(where); _na_dumped = True
            except Exception: pass
            try: _na_sum = _na_top_bucket_summary()
            except Exception: _na_sum = None
        _na_reason = (_na_sum.get("display") if (_na_sum and _na_sum.get("display") and not _na_sum.get("undersampled")) else "host_unattributed")

        _le_attr = None
        if (not _gref_attr) and (not _ii_ambient):
            try:
                _le_attr = _le_tag_attr(dims)
            except Exception:
                _le_attr = None
        if _le_attr:
            if _le_attr.get("pseudo"):
                conf = "low"
            elif conf != "low":
                conf = "medium"
            try:
                _kind_label = ("interpreter-pool" if _le_attr.get("pseudo") else "plugin-native")
                _log("Block#6D +LE(fix1): client native leak attributed by malloc-tagger growth -> %s (+%.1fMB of +%.1fMB native-heap, %.0f%%, hist n=%d/%.0fs) -> kind=%s, conf=%s" % (
                    _le_attr["culprit"], _le_attr["growth"] / 1048576.0, _le_attr["native_growth"] / 1048576.0,
                    _le_attr["share_of_native_growth"] * 100.0, _le_attr["hist_n"], _le_attr["hist_span_s"], _kind_label, conf))
            except Exception:
                pass
        rec = {"type": "client_memory_leak",
               "event_type": "client_memory_leak", "dropbox_tag": "client_memory_leak", "tombstone_norm_version": 1,
               "verdict": "CLIENT MEMORY LEAK",
               "where": where,
               "ts": int(time.time() * 1000),
               "confidence": conf,
               "culprit": (_gref_attr["culprit"] if _gref_attr else (_le_attr["culprit"] if _le_attr else "client (host process)")),
               "kind": ("plugin-globalref" if _gref_attr else (("interpreter-pool" if _le_attr.get("pseudo") else "plugin-native") if _le_attr else "host")),
               "gref_attribution": _gref_attr,
               "gref_suspect": (_ii_ambient.get("gref_suspect") if _ii_ambient else (_jr_reclass.get("gref_suspect") if _jr_reclass else None)),
               "gref_native_xcheck": (_jr_reclass if _jr_reclass else None),
               "tagged_attribution": (_le_attr if _le_attr else None),
               "ambient_note": (_ii_ambient if _ii_ambient else None),
               "reason_detail": (("globalref_" + (_gref_attr.get("src") or "native")) if _gref_attr else ("globalref_ambient" if _ii_ambient else (("interpreter_pool_growth" if _le_attr.get("pseudo") else "plugin_native_tagged") if _le_attr else _na_reason))),
               "oom_score_adj": adj, "oom_score": score,
               "dims": dims,
               "leaking_dims": [d["dim"] for d in leaking],
               "mem_snapshot": _leak_mem_snapshot()}
        try:
            if rec.get("reason_detail") == "host_unattributed" and rec.get("leaking_dims") == ["fd"]:
                _fdd = None
                for _d in dims:
                    if _d.get("dim") == "fd":
                        _fdd = _d; break
                _fk = ((rec.get("mem_snapshot") or {}).get("fd_by_kind") or {})
                _fkt = ", ".join("%s=%d" % (_k, int(_v or 0)) for _k, _v in sorted(_fk.items(), key=lambda kv: -int(kv[1] or 0))[:3])
                if _fdd is not None:
                    rec["reason_detail"] = "fd_leak: %d->%d (+%d)%s" % (int(_fdd.get("first") or 0), int(_fdd.get("last") or 0), int(_fdd.get("growth") or 0), ((", kinds: " + _fkt) if _fkt else ""))
                    try: _log("Block#6D +MO: fd-утечка без native-атрибуции -> reason_detail=%s" % rec["reason_detail"])
                    except Exception: pass
        except Exception: pass
        try:
            if rec.get("reason_detail") == "host_unattributed" and rec.get("leaking_dims") == ["threads"]:
                _thd = None
                for _d in dims:
                    if _d.get("dim") == "threads":
                        _thd = _d; break
                _tnames = {}
                try:
                    for _tid in os.listdir("/proc/self/task"):
                        try:
                            _tf = open("/proc/self/task/%s/comm" % _tid, "rb")
                            try: _tn = _tf.read(64).decode("utf-8", "replace").strip()
                            finally: _tf.close()
                            if _tn: _tnames[_tn] = _tnames.get(_tn, 0) + 1
                        except Exception: pass
                except Exception: pass
                _ttop = sorted(_tnames.items(), key=lambda kv: (-kv[1], kv[0]))[:5]
                _tt = ", ".join("%s×%d" % (_k, _v) for _k, _v in _ttop)
                if _thd is not None:
                    rec["reason_detail"] = "thread_leak: %d->%d (+%d)%s" % (int(_thd.get("first") or 0), int(_thd.get("last") or 0), int(_thd.get("growth") or 0), ((", top: " + _tt) if _tt else ""))
                    rec["thread_top"] = _ttop
                    try: _log("Block#6D +NS(2): thread-утечка без атрибуции -> reason_detail=%s" % rec["reason_detail"])
                    except Exception: pass
        except Exception: pass
        try:
            if (not _gref_attr) and (not _le_attr) and _B27C_LAST_FIND:
                _nv_ld = rec.get("leaking_dims") or []
                if ("java" in _nv_ld) or ("rss" in _nv_ld and "native" not in _nv_ld):
                    _nv_now = int(time.time() * 1000)
                    try:
                        _nv_live = set(_b27_live_pids() or [])
                    except Exception:
                        _nv_live = set()
                    _nv_own = None; _nv_ts = 0
                    for _nv_k, _nv_v in list(_B27C_LAST_FIND.items()):
                        if _nv_v > _nv_ts and _nv_k in _nv_live:
                            _nv_own, _nv_ts = _nv_k, _nv_v
                    if _nv_own and (_nv_now - _nv_ts) <= _B27C_FEED_MS:
                        _nv_fl = [_t for _t in list(_B27C_FINDINGS.get(_nv_own) or []) if _nv_now - _t <= _B27C_CONFIRM_MS]
                        _nv_fn = len(_nv_fl)
                        _nv_prev_rd = rec.get("reason_detail_base") or rec.get("reason_detail") or "host_unattributed"
                        if _nv_fn >= 1:
                            rec["context_leak_suspect"] = _nv_own
                            rec["context_leak_ref"] = {"culprit": _nv_own, "age_ms": _nv_now - _nv_ts, "findings": _nv_fn}
                            if _nv_fn >= 2:
                                rec["culprit"] = _nv_own
                                rec["kind"] = "plugin-context"
                                if rec.get("confidence") == "high":
                                    rec["confidence"] = "medium"
                                    conf = "medium"
                                if rec.get("reason_detail") in (None, "host_unattributed"):
                                    rec["reason_detail"] = "context_leak: %s pins a dead Activity (see context_leak.json)" % _nv_own
                                rec["reason_detail_base"] = _nv_prev_rd
                                try: _log("Block#6D +NX(1): leak attributed via repeated Block#27C context finding -> %s (age %.0fs, findings=%d, conf<=medium)" % (_nv_own, (_nv_now - _nv_ts) / 1000.0, _nv_fn))
                                except Exception: pass
                            else:
                                rec["context_leak_suspect_confidence"] = "low"
                                try: _log("Block#6D +NY(2): single Block#27C context finding -> suspect only (%s, age %.0fs, suspect_conf=low, verdict confidence/culprit unchanged)" % (_nv_own, (_nv_now - _nv_ts) / 1000.0))
                                except Exception: pass
                        else:
                            try: _log("Block#6D +NZ(2): Block#27C owner %s still observed but 0 persisted findings inside confirmation window -> no suspect" % _nv_own)
                            except Exception: pass
        except Exception: pass
        if _na_sum:
            if _na_reason != "host_unattributed" and rec.get("kind") != "plugin-context":
                rec["reason_detail_base"] = "host_unattributed"
                try: _log("Block#6D +IX: host leak enriched -> %s" % _na_reason)
                except Exception: pass
            if _na_sum.get("modules"): rec["native_top_modules"] = _na_sum["modules"]
            if _na_sum.get("leak_family") and _na_sum.get("undersampled"):
                rec["leak_family_suspect"] = _na_sum["leak_family"]
                rec["gfx_family_suspect"] = _na_sum.get("gfx_family")
                try: _log("Block#6D +MP: leak_family=%s с undersampled-таблицы -> только suspect (не классификация)" % _na_sum["leak_family"])
                except Exception: pass
            elif _na_sum.get("leak_family"):
                rec["leak_family"] = _na_sum["leak_family"]
                rec["gfx_family"] = _na_sum.get("gfx_family")
                try:
                    _gf = _na_sum.get("gfx_family") or {}
                    _log("Block#6D +IX: leak_family=hwui_gfx (gfx top-frame %s x%s, ~%.0fMB) -- рост кэша текстур/битмапов/RenderNode на стороне клиента" % (_gf.get("top_frame"), _gf.get("sites"), (_gf.get("bytes") or 0) / 1048576.0))
                except Exception: pass
        try:
            _rss_span = max([float(d.get("span_s") or 0) for d in dims] or [0.0])
            _seg = _leak_seg_delta(_rss_span)
            if _seg:
                rec["rss_segments"] = _seg
                if _seg.get("top"): rec["rss_top_segment"] = _seg["top"]
                _order = sorted(_seg.get("segments", {}).items(),
                                key=lambda kv: kv[1].get("growth", 0), reverse=True)
                _slines = ["  RSS segment deltas (window ~%.0fs):" % _seg.get("span_s", 0)]
                for _nm, _v in _order:
                    _slines.append("    %-12s %+.1f MB (%.1f -> %.1f MB)" % (
                        _nm, _v.get("growth", 0) / 1048576.0,
                        _v.get("first", 0) / 1048576.0, _v.get("last", 0) / 1048576.0))
                try: _log("\n".join(_slines))
                except Exception: pass
        except Exception: pass
        try:
            _nm_pss = 0; _top_native = None; _tg = []
            try:
                _tg = _smaps_top_groups() or []
                for _grp in _tg:
                    if _grp.get("group") == "native-malloc":
                        _nm_pss = int(_grp.get("pss") or 0)
                    if _top_native is None and _grp.get("group") in _SMAPS_NATIVE_GROUPS:
                        _top_native = _grp
            except Exception:
                _tg = []
            _under = bool(_na_sum.get("undersampled")) if _na_sum else False
            if _na_sum and _under:
                rec["native_alloc_undersampled"] = True
                if _na_sum.get("undersample_reason"): rec["native_alloc_undersample_reason"] = _na_sum.get("undersample_reason")
                if _na_sum.get("epoch_age_s") is not None: rec["native_alloc_epoch_age_s"] = round(float(_na_sum["epoch_age_s"]), 1)
                try: _log("Block#6D +JQ(fix1): native alloc-site attribution UNDER-SAMPLED (%s) -- top-bucket bytes are a floor, not the true leak size" % _na_sum.get("undersample_reason"))
                except Exception: pass
            if _na_sum and _na_sum.get("sampled_stats") and _nm_pss > 0:
                _lsb = int(_na_sum["sampled_stats"].get("live_sampled_bytes") or 0)
                _cov = (float(_lsb) / float(_nm_pss)) if _nm_pss > 0 else None
                rec["native_alloc_coverage"] = {"sampled_live_bytes": _lsb, "native_malloc_bytes": _nm_pss,
                                                "ratio": (round(_cov, 4) if _cov is not None else None),
                                                "low": bool(_cov is not None and _cov < _NA_COVERAGE_LOW),
                                                "over": bool(_cov is not None and _cov > 1.5)}
                if _cov is not None and _cov < _NA_COVERAGE_LOW:
                    rec["native_alloc_coverage_note"] = "malloc-hook sees ~%.0f%% of native-malloc RSS; the gap is non-malloc (Vulkan/gralloc/dmabuf suballocators) invisible to the tagger" % (_cov * 100.0)
                    try: _log("Block#6D +JQ(fix3): malloc coverage ~%.1f%% (sampled %.1fMB / native-malloc %.1fMB) -- large non-malloc gap" % (_cov * 100.0, _lsb / 1048576.0, _nm_pss / 1048576.0))
                    except Exception: pass
            if _na_sum and (not rec.get("rss_top_segment")) and _top_native is not None:
                _fb = {"group": _top_native.get("group"), "pss": int(_top_native.get("pss") or 0),
                       "rss": int(_top_native.get("rss") or 0), "source": "smaps_top_group_absolute"}
                rec["rss_localization_fallback"] = _fb
                _mp_ldims = rec.get("leaking_dims") or []
                if (rec.get("reason_detail") == "host_unattributed" and (not _le_attr)
                        and any(_x in _mp_ldims for _x in ("rss", "native", "java"))):
                    rec["reason_detail"] = "host_native: %s largest (~%.0fMB, smaps abs)" % (_fb["group"], _fb["pss"] / 1048576.0)
                    rec["reason_detail_base"] = "host_unattributed"
                try: _log("Block#6D +JQ(fix2): no per-segment baseline (ring cleared/short) -> fallback localization to top smaps group %s (~%.0fMB)" % (_fb["group"], _fb["pss"] / 1048576.0))
                except Exception: pass
            try:
                _ldims = rec.get("leaking_dims") or []
                _seg2 = rec.get("rss_segments") or {}
                _segtop = (_seg2.get("top") or {}) if isinstance(_seg2, dict) else {}
                _stname = _segtop.get("segment"); _stg = int(_segtop.get("growth") or 0)
                if _ldims == ["rss"] and _stname in ("native-heap", "graphics") and _stg >= _NA_XVAL_MIN_GROWTH and not _under:
                    _relabel = "native-malloc" if _stname == "native-heap" else "gfx"
                    rec["rss_reclassified"] = {"from": "rss", "to": _relabel, "segment": _stname,
                                               "segment_growth": _stg,
                                               "basis": "rss-only leak corroborated by growing %s smaps segment" % _stname}
                    if conf == "medium" and rec.get("kind") != "plugin-context":
                        conf = "high"; rec["confidence"] = conf
                        rec["confidence_bumped"] = "rss<->smaps cross-validated (+JQ fix4)"
                    try: _log("Block#6D +JQ(fix4): rss-only leak cross-validated by growing %s segment (+%.1fMB) -> reclassified rss->%s, confidence=%s" % (_stname, _stg / 1048576.0, _relabel, conf))
                    except Exception: pass
            except Exception: pass
        except Exception as _jqe:
            try: _log("Block#6D +JQ enrich err: %s" % _jqe)
            except Exception: pass
        try:
            _b41_enrich_leak(rec, dims)
            conf = rec.get("confidence") or conf
        except Exception as _sze:
            try: _log("Block#41 +SZ enrich err: %s" % _sze)
            except Exception: pass
        lines = ["CLIENT MEMORY LEAK (%s) conf=%s" % (where, conf)]
        for d in dims:
            mark = "LEAK" if d.get("leaking") else "  - "
            nm = _LEAK_DIM_NAMES.get(d["dim"], d["dim"])
            lines.append("  [%s] %-16s %s -> %s growth=%s slope=%.4g/s r2=%.2f n=%d span=%.0fs" % (
                mark, nm, _leak_fmt_amount(d["dim"], d["first"]),
                _leak_fmt_amount(d["dim"], d["last"]),
                _leak_fmt_amount(d["dim"], d["growth"]),
                d["slope_per_s"], d["r2"], d["n"], d["span_s"]))
        try: _log("\n".join(lines))
        except Exception: pass
        try:
            _gst = _b42_gc_stats()
            if _gst: rec["gc"] = _gst
        except Exception: pass
        try:
            _ncs = _b42_nc_snapshot()
            if _ncs: rec["nc_observers"] = _ncs
        except Exception: pass
        try:
            if _B42_HPROF_ON and any(d.get("dim") == "java" for d in leaking) and _b42_foreground():
                _hp = _b42_hprof_dump("client java-heap leak")
                if _hp: rec["hprof"] = _hp
        except Exception: pass
        p = _oom_path(_LEAK_NAME)
        if p: _atomic_json_write(p, rec, 65536)
        try: _LEAK_LAST_KIND[where] = rec.get("kind")
        except Exception: pass
        try: _leak_peak_capture(where, rec)
        except Exception: pass
        if not _na_dumped:
            try: _na_dump(where)
            except Exception: pass
    except Exception as e:
        try: _log("Block#6D leak emit err: %s" % e)
        except Exception: pass

def _leak_check(where):
    try:
        if not (_LEAK_NATIVE_OK and _NLIB is not None):
            return
        _leak_feed_java()
        _leak_seg_sample()
        _le_tag_sample()
        try:
            _b41_feed()
            _b41_own_sample()
        except Exception: pass
        try:
            _b42_tick(where)
        except Exception: pass
        seq = int(_NLIB.cd_leak_seq())
        if seq == _LEAK_STATE.get("last_seq", 0):
            return
        _LEAK_STATE["last_seq"] = seq
        decoded = _leak_read_native_snap()
        if decoded and decoded.get("flags"):
            _leak_emit(decoded, where)
    except Exception as e:
        try: _log("Block#6D leak check err: %s" % e)
        except Exception: pass

_BOOT_FRESH_VERDICT = None
def _read_and_clear_crash_verdict():
    return _read_and_clear_json_dict(_crash_path())

_BLOCK4A_ON = True
_BLOCK4B_ON = True
_XPOSED_BRIDGE_CLASSES = (
    "de.robv.android.xposed.XposedBridge",
    "com.taobao.android.dexposed.DexposedBridge",
)
_HOOK_FRAMEWORK_PROBES = [
    ("de.robv.android.xposed.XposedBridge", "sHookedMethodCallbacks"),
    ("com.taobao.android.dexposed.DexposedBridge", "sHookedMethodCallbacks"),
    ("top.canyie.pine.Pine", "sHookListeners"),
    ("top.canyie.pine.PineConfig", None),
    ("me.weishu.epic.art.Epic", None),
    ("com.swift.sandhook.SandHook", None),
    ("org.lsposed.lsplant.LSPlant", None),
    ("org.lsposed.lspd.core.Main", None),
    ("io.github.libxposed.api.XposedInterface", None),
    ("lab.galaxy.yahfa.HookMain", None),
    ("com.exteragram.messenger.plugins.PythonPluginsEngine", None),
]

def _class_obj(cn):
    try:
        return jclass("java.lang.Class").forName(cn)
    except Exception:
        return None

def _probe_hook_frameworks():
    found = []
    for cn, fld in _HOOK_FRAMEWORK_PROBES:
        cls = _class_obj(cn)
        if cls is None:
            continue
        info = cn
        if fld:
            try:
                f = cls.getDeclaredField(fld); f.setAccessible(True); v = f.get(None)
                try: sz = v.size()
                except Exception:
                    try: sz = len(v)
                    except Exception: sz = "?"
                info += f" [{fld}={sz}]"
            except Exception as e:
                info += f" [{fld}:нет поля]"
        found.append(info)
    return found

def _safe_str(o):
    try: return str(o)
    except Exception:
        try: return o.toString()
        except Exception: return ""

def _plugin_classloaders():
    out = {}
    try:
        PC = jclass("com.exteragram.messenger.plugins.PluginsController")
        controller = PC.getInstance()
        plugins = controller.getPlugins() if controller is not None else None
        if plugins is None: return out
        for e in _entryset_snapshot(plugins):
            try:
                pid = _safe_str(e.getKey()); inst = e.getValue()
                cl = inst.getClass().getClassLoader() if inst is not None else None
                if cl is not None: out[_safe_str(cl)] = pid
            except Exception: pass
    except Exception: pass
    return out

def _entryset_snapshot(m):
    last = None
    for _ in range(4):
        try: return list(m.entrySet().toArray())
        except Exception as e: last = e
    try: _log("entrySet snapshot failed: %s" % last)
    except Exception: pass
    return []

def _xposed_field_value():
    for cn in _XPOSED_BRIDGE_CLASSES:
        try:
            cls = _class_obj(cn)
            if cls is None: continue
            f = cls.getDeclaredField("sHookedMethodCallbacks")
            f.setAccessible(True)
            v = f.get(None)
            if v is not None: return v, cn
        except Exception: continue
    return None, None

def _cb_array(callbacks):
    for getter in ("getSnapshot", "toArray"):
        try:
            a = getattr(callbacks, getter)()
            if a is not None: return a
        except Exception: pass
    return []

def _build_hook_owner_map():
    res = {}
    m, _ = _xposed_field_value()
    if m is None:
        st = "lsplant-no-jmap" if _class_obj("de.robv.android.xposed.XposedBridge") is not None else "no-xposed"
        return res, 0, st
    try:
        clmap = _plugin_classloaders(); known = _load_known()
        for e in _entryset_snapshot(m):
            try:
                member = e.getKey(); callbacks = e.getValue()
                dcl = member.getDeclaringClass().getName()
                try: mname = member.getName()
                except Exception: mname = "<init>"
                key = dcl + "." + mname
                owner = None
                for cb in _cb_array(callbacks):
                    try:
                        cl = cb.getClass().getClassLoader(); rep = _safe_str(cl)
                        if rep in clmap: owner = clmap[rep]; break
                        owner = _map_stack_to_id(rep, known) or _map_stack_to_id(cb.getClass().getName(), known)
                        if owner: break
                    except Exception: pass
                res[key] = owner
            except Exception: pass
    except Exception:
        return res, len(res), "err"
    return res, len(res), "ok"

def _hook_owner_for_frames(frames):
    if not _BLOCK4A_ON: return None, None, None, {"status": "off"}
    omap, n, status = _build_hook_owner_map()
    meta = {"n": n, "status": status}
    if not omap: return None, None, None, meta
    for fr in frames:
        if fr in omap and omap[fr]: return omap[fr], fr, "exact", meta
    simple = {}
    for k, v in omap.items():
        try:
            cls, mth = k.rsplit(".", 1); simple[(_simple(cls), mth)] = (v, k)
        except Exception: pass
    for fr in frames:
        try:
            cls, mth = fr.rsplit(".", 1); t = (_simple(cls), mth)
            if t in simple and simple[t][0]: return simple[t][0], simple[t][1], "simple", meta
        except Exception: pass
    by_method = {}
    for k, v in omap.items():
        if not v: continue
        try: mth = k.rsplit(".", 1)[1]
        except Exception: continue
        by_method.setdefault(mth, set()).add((v, k))
    for fr in frames:
        if not _is_hook_frame(fr): continue
        try: mth = fr.rsplit(".", 1)[1]
        except Exception: continue
        hits = by_method.get(mth)
        if hits and len(hits) == 1:
            v, k = next(iter(hits))
            return v, k, "hook-method", meta
    for fr in frames:
        if fr in omap: return None, fr, "method-only", meta
    return None, None, None, meta

def _plugin_loaders():
    out = []
    try:
        PC = jclass("com.exteragram.messenger.plugins.PluginsController")
        controller = PC.getInstance()
        plugins = controller.getPlugins() if controller is not None else None
        if plugins is None: return out
        for e in _entryset_snapshot(plugins):
            try:
                pid = _safe_str(e.getKey()); inst = e.getValue()
                cl = inst.getClass().getClassLoader() if inst is not None else None
                if cl is not None: out.append((cl, _safe_str(cl), pid))
            except Exception: pass
    except Exception: pass
    return out

def _classloader_culprit(frames):
    if not _BLOCK4B_ON: return None, None, {"status": "off"}
    loaders = _plugin_loaders()
    meta = {"n": len(loaders), "status": ("no-loaders" if not loaders else "ok")}
    if not loaders: return None, None, meta
    repr2pids = {}
    for (cl, rep, pid) in loaders:
        repr2pids.setdefault(rep, set()).add(pid)
    ambig = 0
    for fr in frames:
        cn = fr.rsplit(".", 1)[0] if "." in fr else fr
        if _is_system_class(cn): continue
        for (cl, rep, pid) in loaders:
            try:
                kls = cl.loadClass(cn)
            except Exception:
                continue
            try:
                drep = _safe_str(kls.getClassLoader())
            except Exception:
                drep = None
            if drep is None: continue
            pids = repr2pids.get(drep)
            if not pids: continue
            if len(pids) == 1:
                if ambig: meta["ambiguous"] = ambig
                return next(iter(pids)), fr, meta
            ambig += 1; break
    if ambig: meta["ambiguous"] = ambig
    return None, None, meta

def _b16_push_verdict(kind, rec):
    if not _B16_ON: return
    try:
        conf = rec.get("confidence")
        if conf not in ("high", "medium"): return
        e = {"kind": kind, "culprit": rec.get("culprit"), "confidence": conf,
             "where": rec.get("where"), "exc_cls": rec.get("exc_cls"),
             "exc_msg": rec.get("exc_msg"), "py_file": rec.get("py_file"),
             "py_line": rec.get("py_line"), "ts": rec.get("ts") or int(time.time() * 1000),
             "high_rate": bool(rec.get("high_rate")), "throws_per_min": rec.get("throws_per_min"),
             "throws_in_window": rec.get("throws_in_window")}
        with _RECENT_VERDICTS_LOCK:
            _RECENT_VERDICTS.append(e)
            if len(_RECENT_VERDICTS) > _RECENT_MAX:
                del _RECENT_VERDICTS[:-_RECENT_MAX]
    except Exception:
        pass

def _b16_disk_candidates():
    out = []
    try:
        srcs = (("cb", _cb_verdict_path), ("bg", _bg_verdict_path), ("ui", _ui_verdict_path), ("fut", _fut_verdict_path), ("async", _async_verdict_path), ("pyerr", _pyerr_verdict_path))
    except Exception:
        srcs = ()
    for kind, pathfn in srcs:
        try:
            p = pathfn()
            _rp = _rc_read_path(p) if p else None
            if not _rp: continue
            with open(_rp, "r", encoding="utf-8") as f:
                arr = list(json.load(f))
            for r in arr[-12:]:
                try:
                    out.append({"kind": kind, "culprit": r.get("culprit"),
                                "confidence": r.get("confidence"), "where": r.get("where"),
                                "exc_cls": r.get("exc_cls"), "exc_msg": r.get("exc_msg"),
                                "py_file": r.get("py_file"), "py_line": r.get("py_line"),
                                "high_rate": bool(r.get("high_rate")), "throws_per_min": r.get("throws_per_min"),
                                "throws_in_window": r.get("throws_in_window"),
                                "ts": r.get("ts")})
                except Exception: pass
        except Exception:
            pass
    return out

def _b16_pyerr_fallback_ok(cx, cm, frames, delta_ms, v=None):
    try:
        if isinstance(v, dict) and bool(v.get("high_rate")):
            return False
        if delta_ms is not None and int(delta_ms) <= _B16_PYERR_TIGHT_MS:
            return True
        blob = (str(cx or "") + " " + str(cm or "")).lower()
        if ("chaquo" in blob) or ("pyexception" in blob):
            return True
        for fr in (frames or []):
            if "chaquo" in str(fr).lower():
                return True
    except Exception:
        return True
    return False


def _b16_exc_match(crash_exc_cls, crash_exc_msg, v_exc_cls, v_exc_msg):
    cm = str(crash_exc_msg or "")
    vm = str(v_exc_msg or "")
    vc = str(v_exc_cls or "")
    if vm and (vm == cm or vm in cm or cm.endswith(vm)):
        return True
    combo = ("%s: %s" % (vc, vm)) if vm else vc
    if combo and (combo == cm or combo in cm or cm.endswith(combo)):
        return True
    return False

def _b19_exc_ring_put(exc):
    try: _ec = type(exc).__name__
    except Exception: _ec = None
    try: _em = str(exc)
    except Exception: _em = None
    if not _ec: return
    try:
        with _B19_EXC_RING_LOCK:
            _B19_EXC_RING.append((int(time.time() * 1000), _ec, _em))
            if len(_B19_EXC_RING) > _B19_EXC_RING_MAX:
                del _B19_EXC_RING[0:len(_B19_EXC_RING) - _B19_EXC_RING_MAX]
    except Exception: pass

def _b19_exc_ring_lookup(crash_ts, window_ms):
    best = None; best_dt = None
    try:
        with _B19_EXC_RING_LOCK:
            _snap = list(_B19_EXC_RING)
    except Exception:
        _snap = []
    for _ts, _ec, _em in _snap:
        try: _dt = abs(int(crash_ts) - int(_ts))
        except Exception: continue
        if _dt <= window_ms and (best_dt is None or _dt < best_dt):
            best = (_ec, _em); best_dt = _dt
    return best


def _b16_correlate(rec):
    try:
        if not _B16_ON or not isinstance(rec, dict): return rec
        crash_ts = rec.get("ts") or int(time.time() * 1000)
        cx = rec.get("exc_cls"); cm = rec.get("exc_msg")
        if (not cx or str(cx).strip() in ("", "?")) and (not cm or str(cm).strip() == ""):
            _enr = _b19_exc_ring_lookup(crash_ts, _B16_CORR_WINDOW_MS)
            if _enr:
                rec["exc_cls"] = _enr[0]
                if _enr[1]: rec["exc_msg"] = _enr[1]
                rec["exc_from"] = "b19_ring+window"
                cx = rec.get("exc_cls"); cm = rec.get("exc_msg")
        cands = []
        try:
            with _RECENT_VERDICTS_LOCK:
                cands = list(_RECENT_VERDICTS)
        except Exception:
            cands = []
        try:
            cands = cands + _b16_disk_candidates()
        except Exception:
            pass
        top_pid = None
        try:
            nm = rec.get("native_mem")
            if isinstance(nm, dict): top_pid = nm.get("top_pid")
        except Exception:
            top_pid = None
        try:
            frames = rec.get("stack_top") or []
        except Exception:
            frames = []
        best = None; best_ts = -1
        best_py = None; best_py_ts = -1
        for v in cands:
            try:
                if v.get("confidence") != "high": continue
                vts = v.get("ts")
                if vts is None: continue
                if abs(int(crash_ts) - int(vts)) > _B16_CORR_WINDOW_MS: continue
                if _b16_exc_match(cx, cm, v.get("exc_cls"), v.get("exc_msg")):
                    if int(vts) > best_ts:
                        best = v; best_ts = int(vts)
                elif v.get("kind") == "pyerr":
                    if int(vts) > best_py_ts:
                        best_py = v; best_py_ts = int(vts)
            except Exception:
                pass
        try:
            if best is None:
                _op = _classify_orphan_proxy(cx, cm, frames)
                if _op is not None:
                    _oown, _oconf, _osrc = _orphan_proxy_owner(_op.get("proxy_class"), crash_ts)
                    if _oown:
                        rec["correlated"] = {"from": "orphan_proxy", "culprit": _oown, "confidence": _oconf,
                                             "where": "proxy.invoke/fromJava", "proxy_class": _op.get("proxy_class"),
                                             "attr": _op.get("attr"), "match": _osrc}
                        cur_pid = rec.get("crashed_plugin_id"); cur_conf = rec.get("confidence")
                        _jl_tidm = (rec.get("src") == "tid" and str(rec.get("thread") or "").strip().lower().startswith("main"))
                        if _jl_tidm: rec["tid_candidate"] = cur_pid
                        weak = ((cur_conf != "high") or _jl_tidm or (not cur_pid) or (cur_pid == "unknown")
                                or (isinstance(cur_pid, str) and (cur_pid.startswith("<python>") or cur_pid.startswith("$Proxy"))))
                        if weak:
                            rec["crashed_plugin_id_native"] = cur_pid
                            rec["crashed_plugin_id"] = _oown
                            rec["confidence"] = _oconf
                            rec["src"] = str(_osrc or ("orphan_proxy/" + str(_op.get("proxy_class"))))
                        return rec
        except Exception: pass
        if best is None and best_py is not None:
            _pfd = abs(int(crash_ts) - int(best_py_ts))
            if _b16_pyerr_fallback_ok(rec.get("exc_cls"), rec.get("exc_msg"), (rec.get("stack_top") or []), _pfd, best_py):
                best = best_py; best_ts = best_py_ts
            else:
                try:
                    rec["pyerr_context"] = {"culprit": best_py.get("culprit"), "age_ms": _pfd, "py_file": best_py.get("py_file"), "py_line": best_py.get("py_line")}
                    _log("Block#16 +NS(1): pyerr-fallback отклонён -- delta=%dms без py-сигнатуры краша -> контекст, не атрибуция ('%s')" % (_pfd, str(best_py.get("culprit"))))
                except Exception: pass
        if best is None:
            try:
                cms = str(cm or "")
                if "_chaquopyGetDict" in cms or "_chaquopyGetType" in cms:
                    q1 = cms.find("'") + 1
                    q2 = cms.find("'", q1) if q1 > 0 else -1
                    cls_name = cms[q1:q2] if (q1 > 0 and q2 > q1) else None
                    if cls_name:
                        entry = _B14_IFACE_OWNER.get(cls_name)
                        if entry:
                            zowner, zts = entry
                            if abs(int(crash_ts) - int(zts)) < _B16_ZOMBIE_WINDOW_MS:
                                rec["correlated"] = {
                                    "from": "zombie_proxy",
                                    "culprit": zowner,
                                    "confidence": "medium",
                                    "where": "proxy.invoke/fromJava",
                                    "proxy_class": cls_name,
                                    "match": "iface_owner+window",
                                    "age_ms": abs(int(crash_ts) - int(zts))}
                                cur_pid = rec.get("crashed_plugin_id")
                                cur_conf = rec.get("confidence")
                                weak = (
                                    (cur_conf != "high") or
                                    (rec.get("src") == "tid" and str(rec.get("thread") or "").strip().lower().startswith("main")) or
                                    (not cur_pid) or
                                    (cur_pid == "unknown") or
                                    (isinstance(cur_pid, str) and
                                     cur_pid.startswith("<python>"))
                                )
                                if weak:
                                    rec["crashed_plugin_id_native"] = cur_pid
                                    rec["crashed_plugin_id"] = zowner
                                    rec["confidence"] = "medium"
                                    rec["src"] = "zombie_proxy/" + cls_name
            except Exception: pass
            return rec
        culprit = best.get("culprit")
        if not culprit or culprit == "unknown": return rec
        sig = ["exc", "window"]
        try:
            if top_pid and top_pid == culprit: sig.append("top_pid")
        except Exception: pass
        try:
            for fr in frames:
                if isinstance(fr, str) and culprit in fr:
                    sig.append("stack"); break
        except Exception: pass
        rec["correlated"] = {
            "from": (best.get("kind") or "cb") + "_verdict", "culprit": culprit,
            "confidence": best.get("confidence"), "where": best.get("where"),
            "py_file": best.get("py_file"), "py_line": best.get("py_line"),
            "match": "+".join(sig), "age_ms": abs(int(crash_ts) - best_ts),
        }
        cur_pid = rec.get("crashed_plugin_id")
        cur_conf = rec.get("confidence")
        weak = (cur_conf != "high") or (not cur_pid) or (cur_pid == "unknown") or (isinstance(cur_pid, str) and cur_pid.startswith("<python>"))
        if weak:
            rec["crashed_plugin_id_native"] = cur_pid
            rec["crashed_plugin_id"] = culprit
            rec["confidence"] = "high"
            rec["src"] = "correlated/" + (best.get("kind") or "cb")
        return rec
    except Exception:
        return rec

def _b16_correlate_boot(rec, cands):
    try:
        if not _B16_ON or not isinstance(rec, dict) or not cands:
            return rec
        cur_pid = rec.get("crashed_plugin_id"); cur_conf = rec.get("confidence")
        weak = (cur_conf != "high") or (not cur_pid) or (cur_pid == "unknown") or (isinstance(cur_pid, str) and cur_pid.startswith("<python>"))
        if not weak:
            return rec
        crash_ts = rec.get("ts") or int(time.time() * 1000)
        cx = rec.get("exc_cls"); cm = rec.get("exc_msg")
        if (not cx or str(cx).strip() in ("", "?")) and (not cm or str(cm).strip() == ""):
            _enr = _b19_exc_ring_lookup(crash_ts, _B16_CORR_WINDOW_MS)
            if _enr:
                rec["exc_cls"] = _enr[0]
                if _enr[1]: rec["exc_msg"] = _enr[1]
                rec["exc_from"] = "b19_ring+window"
                cx = rec.get("exc_cls"); cm = rec.get("exc_msg")
        best = None; best_ts = -1; best_py = None; best_py_ts = -1
        for v in cands:
            try:
                if v.get("confidence") != "high":
                    continue
                vts = v.get("ts")
                if vts is None:
                    continue
                if abs(int(crash_ts) - int(vts)) > _B16_CORR_WINDOW_MS:
                    continue
                if _b16_exc_match(cx, cm, v.get("exc_cls"), v.get("exc_msg")):
                    if int(vts) > best_ts:
                        best = v; best_ts = int(vts)
                elif v.get("kind") == "pyerr":
                    if int(vts) > best_py_ts:
                        best_py = v; best_py_ts = int(vts)
            except Exception:
                pass
        if best is None and best_py is not None:
            _nu_named = bool(cur_pid) and cur_pid != "unknown" and not (isinstance(cur_pid, str) and (cur_pid.startswith("<python>") or cur_pid.startswith("$Proxy")))
            _nu_struct = _nu_named and ((rec.get("cause") in ("orphaned_dynamic_proxy_runnable", "zombie_xposed_hook", "zombie_java_proxy_listener")) or str(rec.get("src") or "").startswith(("orphan-proxy", "orphan_proxy", "zombie")))
            if _nu_struct:
                try:
                    _pfd0 = abs(int(crash_ts) - int(best_py_ts))
                    rec["pyerr_context"] = {"culprit": best_py.get("culprit"), "age_ms": _pfd0, "py_file": best_py.get("py_file"), "py_line": best_py.get("py_line")}
                    _log("Block#16 +NU(1): boot pyerr-fallback skipped -- structural verdict kept (%r via %r), pyerr %r -> context" % (cur_pid, rec.get("src"), best_py.get("culprit")))
                except Exception:
                    pass
                return rec
            _pfd = abs(int(crash_ts) - int(best_py_ts))
            if _b16_pyerr_fallback_ok(rec.get("exc_cls"), rec.get("exc_msg"), (rec.get("stack_top") or []), _pfd, best_py):
                best = best_py; best_ts = best_py_ts
            else:
                try:
                    rec["pyerr_context"] = {"culprit": best_py.get("culprit"), "age_ms": _pfd, "py_file": best_py.get("py_file"), "py_line": best_py.get("py_line")}
                    _log("Block#16 +NS(1): pyerr-fallback отклонён -- delta=%dms без py-сигнатуры краша -> контекст, не атрибуция ('%s')" % (_pfd, str(best_py.get("culprit"))))
                except Exception: pass
        if best is None:
            return rec
        culprit = best.get("culprit")
        if not culprit or culprit == "unknown":
            return rec
        rec["crashed_plugin_id_native"] = cur_pid
        rec["crashed_plugin_id"] = culprit
        rec["confidence"] = "high"
        rec["src"] = "correlated-boot/" + (best.get("kind") or "py")
        rec["correlated"] = {"from": (best.get("kind") or "py") + "_verdict", "culprit": culprit,
                             "confidence": best.get("confidence"), "where": best.get("where"),
                             "py_file": best.get("py_file"), "py_line": best.get("py_line"),
                             "match": "boot+window", "age_ms": abs(int(crash_ts) - int(best_ts))}
        return rec
    except Exception:
        return rec


_ORPHAN_PROXY_ATTRS = ("_chaquopyGetType", "_chaquopyGetDict")
_ORPHAN_PROXY_FRAMES = ("fromJavaNative", "DynamicProxyClass", "PyInvocationHandler", "j2p", "chaquopy")
def _classify_orphan_proxy(exc_cls, exc_msg, frames):
    try:
        cm = str(exc_msg or "")
        attr = None
        for a in _ORPHAN_PROXY_ATTRS:
            if a in cm:
                attr = a; break
        if attr is None:
            return None
        if ("AttributeError" not in cm) and ("AttributeError" not in str(exc_cls or "")):
            return None
        fr_hit = False
        for fr in (frames or []):
            for mk in _ORPHAN_PROXY_FRAMES:
                if mk in fr:
                    fr_hit = True; break
            if fr_hit:
                break
        if not fr_hit:
            return None
        cls_name = None
        q1 = cm.find("'") + 1
        q2 = cm.find("'", q1) if q1 > 0 else -1
        if q1 > 0 and q2 > q1:
            cls_name = cm[q1:q2]
        return {"proxy_class": cls_name, "attr": attr}
    except Exception:
        return None
def _proxy_iface_owner(cls_name, crash_ts):
    try:
        _no = _pxo_native_owner(cls_name, crash_ts)
        if _no[0]: return _no
    except Exception:
        pass
    try:
        if cls_name:
            keys = [cls_name]
            try:
                for k in (cls_name.lstrip("_"), cls_name.rsplit("$", 1)[-1]):
                    if k and k not in keys:
                        keys.append(k)
            except Exception:
                pass
            for key in keys:
                entry = _B14_IFACE_OWNER.get(key)
                if entry:
                    zowner, zts = entry
                    try:
                        fresh = abs(int(crash_ts) - int(zts)) < _B16_ZOMBIE_WINDOW_MS
                    except Exception:
                        fresh = False
                    if fresh and zowner:
                        return (zowner, "iface-owner+" + str(key))
    except Exception:
        pass
    return (None, None)

def _orphan_proxy_owner(cls_name, crash_ts):
    try:
        if _POST_NATIVE_ACTIVE and _NLIB is not None and _CTYPES_OK and hasattr(_NLIB, "cd_orphan_owner"):
            _oage = ctypes.c_int64(0)
            _oidx = int(_NLIB.cd_orphan_owner(ctypes.byref(_oage)))
            _oam = int(_oage.value)
            if _oidx >= 0 and 0 <= _oam <= _B16_ZOMBIE_WINDOW_MS:
                _onm = _resolve_idx(_oidx)
                if not (isinstance(_onm, str) and _onm):
                    _onm = _resolve_idx_durable(_oidx)
                if isinstance(_onm, str) and _onm:
                    return _onm, "high", "orphan-proxy/handler-post-native"
    except Exception:
        pass
    try:
        _io = _proxy_iface_owner(cls_name, crash_ts)
        if _io[0]:
            return _io[0], "medium", "orphan-proxy/" + _io[1]
        try:
            pp, _ = _b28_proxy_producer()
        except Exception:
            pp = None
        if pp:
            return pp, "low", "orphan-proxy/proxy-producer"
    except Exception:
        pass
    return None, None, None
def _capture_crash(thread, ex):
    crash_ts = int(time.time() * 1000)
    tid = None
    if _NATIVE_OK and _NLIB is not None:
        try: tid = int(_NLIB.cd_gettid())
        except Exception: tid = None
    if tid is None:
        try: tid = int(thread.getId())
        except Exception: tid = None
    idx_tid = _reg_get(tid)
    pid_tid = _resolve_idx(idx_tid) if (idx_tid is not None and idx_tid >= 0) else None
    crumb_raw = None
    try:
        crumb_raw = _CRUMB.read_prev() if _CRUMB is not None else None
    except Exception:
        crumb_raw = None
    pid_crumb = None; crumb_fresh = False; crumb_age = None
    if crumb_raw:
        try:
            parts = crumb_raw.split("\t")
            pid_crumb = parts[0]; cts = int(parts[2]); crumb_age = crash_ts - cts
            if 0 <= crumb_age <= _CRUMB_FRESH_MS: crumb_fresh = True
        except Exception:
            pid_crumb = crumb_raw.split("\t")[0] if "\t" in crumb_raw else crumb_raw
    frames = []
    try:
        st = ex.getStackTrace()
        if st is not None:
            for el in st:
                try: frames.append(el.getClassName() + "." + el.getMethodName())
                except Exception: pass
    except Exception:
        pass
    via_hook = any(_is_hook_frame(f) for f in frames)
    hooked_method = None
    if via_hook:
        for f in frames:
            if _is_hook_frame(f) and "LSPHooker_" in f:
                try: hooked_method = f.rsplit(".", 1)[1]
                except Exception: hooked_method = _short_method(f)
                break
        if not hooked_method:
            for f in frames:
                if f.startswith("org.telegram."):
                    hooked_method = _short_method(f); break
    culprit_frame = _stack_culprit(frames)
    pid_stack = _map_stack_to_id(culprit_frame, _known_union()) if culprit_frame else None
    pid_4a = None; hook4a_method = None; hook4a_kind = None; hook4a_meta = {}
    try:
        pid_4a, hook4a_method, hook4a_kind, hook4a_meta = _hook_owner_for_frames(frames)
    except Exception as _e4a:
        hook4a_meta = {"status": "err:%s" % _e4a}
    pid_4b = None; cl4b_frame = None; cl4b_meta = {}
    try:
        pid_4b, cl4b_frame, cl4b_meta = _classloader_culprit(frames)
    except Exception as _e4b:
        cl4b_meta = {"status": "err:%s" % _e4b}
    pid_4c = None; cl4c_frame = None; cl4c_meta = {}
    try:
        pid_4c, cl4c_frame, cl4c_meta = _loader_culprit(frames)
    except Exception as _e4c:
        cl4c_meta = {"status": "err:%s" % _e4c}
    pid_stack_strong = pid_stack if (pid_stack and culprit_frame and not _is_obfuscated(culprit_frame)) else None
    if pid_tid:
        pid = pid_tid; src = "tid"; conf = "high"
    elif pid_stack_strong:
        pid = pid_stack_strong; src = "stack"; conf = "high"
    elif pid_4c:
        pid = pid_4c; src = "loader"; conf = "high"
    elif pid_4b:
        pid = pid_4b; src = "classloader"; conf = "high"
    elif pid_4a:
        pid = pid_4a; src = "hookmap"; conf = "high"
    elif pid_stack:
        pid = pid_stack; src = "stack"; conf = "medium"
    elif culprit_frame and culprit_frame.startswith("$Proxy") and _proxy_iface_owner(culprit_frame.rpartition(".")[0] or culprit_frame, crash_ts)[0]:
        _pio = _proxy_iface_owner(culprit_frame.rpartition(".")[0] or culprit_frame, crash_ts)
        pid = _pio[0]; src = "proxy-" + str(_pio[1]); conf = "medium"
    elif culprit_frame:
        pid = _pkg_of(culprit_frame); src = "stack-pkg"; conf = "low"
    elif crumb_fresh and pid_crumb:
        pid = pid_crumb; src = "breadcrumb"; conf = "low"
    else:
        pid = "unknown"; src = ("hook-obfuscated" if via_hook else "none"); conf = "none"
    _opan = None
    try:
        if _frames_hit_anim(frames):
            _opan = _b20_owner_from_op_in_domains(_GPU_OP_WINDOW_MS, ("anim",))
    except Exception:
        _opan = None
    exc_cls = ""; exc_msg = ""; tname = ""
    try: exc_cls = ex.getClass().getName()
    except Exception: pass
    try:
        m = ex.getMessage(); exc_msg = str(m) if m is not None else ""
    except Exception: pass
    try: tname = thread.getName()
    except Exception: pass
    nat = None
    if _NATIVE_OK and _NLIB is not None:
        try:
            b = ctypes.c_int64(0)
            ti = int(_NLIB.cd_top1(ctypes.byref(b)))
            nat = {"top_idx": ti, "top_pid": (_resolve_idx(ti) if ti >= 0 else None),
                   "top_bytes": int(b.value), "total": int(_NLIB.cd_total())}
        except Exception:
            nat = None
    try: _reg_backend = registry_info().get("backend")
    except Exception: _reg_backend = None
    rec = {
        "had_crash": True, "crashed_plugin_id": pid, "src": src, "confidence": conf,
        "exc_cls": exc_cls, "exc_msg": exc_msg, "thread": tname,
        "via_hook": via_hook, "hooked_method": hooked_method,
        "pid_tid": pid_tid, "reg_idx": idx_tid, "reg_backend": _reg_backend,
        "pid_stack": pid_stack, "culprit_frame": culprit_frame,
        "pid_4a": pid_4a, "hook4a_method": hook4a_method, "hook4a_kind": hook4a_kind, "hook4a_meta": hook4a_meta,
        "pid_4b": pid_4b, "cl4b_frame": cl4b_frame, "cl4b_meta": cl4b_meta,
        "pid_4c": pid_4c, "cl4c_frame": cl4c_frame, "cl4c_meta": cl4c_meta,
        "pid_crumb": pid_crumb, "crumb_fresh": crumb_fresh, "crumb_age_ms": crumb_age, "crumb": crumb_raw,
        "stack_top": frames[:40], "native_mem": nat, "op_anim": _opan, "ts": crash_ts,
    }
    if _is_py_memoryerror(exc_cls, exc_msg):
        rec["mem_pressure"] = True
        rec["reason"] = _JAVA_OOM_REASON if _is_java_heap_oom(exc_cls, exc_msg) else _MEM_PRESSURE_REASON
    try:
        _odp = _classify_orphan_proxy(exc_cls, exc_msg, frames)
        if _odp is not None:
            rec["cause"] = "orphaned_dynamic_proxy_runnable"
            rec["proxy_class"] = _odp.get("proxy_class")
            rec["proxy_attr"] = _odp.get("attr")
            _own, _oconf, _osrc = _orphan_proxy_owner(_odp.get("proxy_class"), crash_ts)
            _cur = rec.get("crashed_plugin_id")
            _tid_main = (rec.get("src") == "tid" and str(tname or "").strip().lower().startswith("main"))
            if _tid_main: rec["tid_candidate"] = _cur
            _weak = (rec.get("confidence") in (None, "low", "none")) or (not _cur) or _tid_main or \
