def _b19_build_struct(maxf, pathmax):
    c = ctypes
    class B19Event(c.Structure):
        _fields_ = [("tid", c.c_int64),
                    ("ts_ms", c.c_int64),
                    ("symbol", c.c_int32),
                    ("nframes", c.c_int32),
                    ("lines", c.c_int32 * maxf),
                    ("files", (c.c_char * pathmax) * maxf)]
    return B19Event

def _b19_init(lib):
    global _B19_OK, _B19Event, _B19_RING_CAP, _B19_REC_SIZE, _B19_MAX_FRAMES, _B19_PATH_MAX, _B19_EVBUF, _B19_EVADDR
    c = ctypes
    needed = ("cd_b19_start", "cd_b19_stop", "cd_b19_ring_addr", "cd_b19_ring_cap",
              "cd_b19_rec_size", "cd_b19_max_frames", "cd_b19_path_max",
              "cd_b19_committed", "cd_b19_running", "cd_b19_read_event")
    if not all(hasattr(lib, n) for n in needed):
        _B19_OK = False
        _log("Block#19: cd_b19_* нет в .so (старый бинарь) — JNI-py-атрибуция отключена")
        return False
    try:
        lib.cd_b19_start.restype = c.c_int
        lib.cd_b19_stop.restype = c.c_int
        lib.cd_b19_ring_addr.restype = c.c_uint64
        lib.cd_b19_ring_cap.restype = c.c_int32
        lib.cd_b19_rec_size.restype = c.c_int32
        lib.cd_b19_max_frames.restype = c.c_int32
        lib.cd_b19_path_max.restype = c.c_int32
        lib.cd_b19_committed.restype = c.c_int64
        lib.cd_b19_running.restype = c.c_int
        lib.cd_b19_read_event.restype = c.c_int
        lib.cd_b19_read_event.argtypes = [c.c_int64, c.c_void_p]
        lib.cd_b19_eventfd.restype = c.c_int
        lib.cd_b19_event_wake.restype = c.c_int
        for opt in ("cd_b19_boundary_hits", "cd_b19_tb_captures", "cd_b19_dropped"):
            try: getattr(lib, opt).restype = c.c_int64
            except Exception: pass
        _B19_MAX_FRAMES = int(lib.cd_b19_max_frames())
        _B19_PATH_MAX = int(lib.cd_b19_path_max())
        _B19_REC_SIZE = int(lib.cd_b19_rec_size())
        _B19_RING_CAP = int(lib.cd_b19_ring_cap())
        if _B19_MAX_FRAMES <= 0 or _B19_PATH_MAX <= 0 or _B19_RING_CAP <= 0:
            _B19_OK = False
            _log("Block#19: невалидные размеры от натива — отключаю")
            return False
        _B19Event = _b19_build_struct(_B19_MAX_FRAMES, _B19_PATH_MAX)
        if c.sizeof(_B19Event) != _B19_REC_SIZE:
            _B19_OK = False
            _log("Block#19: размер записи не совпал (py=%d native=%d) — отключаю" % (c.sizeof(_B19Event), _B19_REC_SIZE))
            return False
        _B19_EVBUF = _B19Event()
        _B19_EVADDR = c.addressof(_B19_EVBUF)
        _B19_OK = True
        _log("Block#19: cd_b19_* ок (cap=%d rec=%dB maxf=%d path=%d)" % (_B19_RING_CAP, _B19_REC_SIZE, _B19_MAX_FRAMES, _B19_PATH_MAX))
        return True
    except Exception as e:
        _B19_OK = False
        _log("Block#19 init err: %s: %s" % (type(e).__name__, e))
        return False

def _b19_cstr(arr):
    try:
        return bytes(arr).split(b"\x00", 1)[0].decode("utf-8", "replace")
    except Exception:
        return ""

def _b19_file_plugin_map():
    m = {}
    try:
        for mod in list(_sys.modules.values()):
            try:
                pid = getattr(mod, "__id__", None)
                fn = getattr(mod, "__file__", None)
                if not (isinstance(pid, str) and pid and isinstance(fn, str) and fn):
                    continue
                if pid == _SELF_ID or pid == __id__:
                    continue
                try: pid = _canon_pid(pid)
                except Exception: pass
                m[fn] = pid
                try: m[os.path.abspath(fn)] = pid
                except Exception: pass
                try: m[os.path.basename(fn)] = pid
                except Exception: pass
            except Exception: pass
    except Exception as e:
        try: _log("Block#19: file->plugin map build err: %s: %s" % (type(e).__name__, e))
        except Exception: pass
    try:
        d = None
        try: d = _b11p_plugins_dir()
        except Exception: d = None
        ids = set()
        try:
            with _REG_LOCK:
                for pid, r in _REGISTRY.items():
                    if r and r.get("inst"): ids.add(pid)
        except Exception: pass
        try: ids |= _installed_plugin_ids_fs()
        except Exception: pass
        added = 0
        for pid in ids:
            if not pid or pid == _SELF_ID or pid == __id__: continue
            try: pid_c = _canon_pid(pid)
            except Exception: pid_c = pid
            bn = "%s.py" % pid
            if bn not in m:
                m[bn] = pid_c; added += 1
            if d:
                fp = os.path.join(d, bn)
                if fp not in m:
                    m[fp] = pid_c; added += 1
                try:
                    ap = os.path.abspath(fp)
                    if ap not in m:
                        m[ap] = pid_c; added += 1
                except Exception: pass
        if added and not _B19_FSMAP_LOG_ONCE[0]:
            _B19_FSMAP_LOG_ONCE[0] = True
            _log("Block#19: file->plugin map дополнена FS/реестровым фолбэком (+%d ключей)" % added)
    except Exception: pass
    if not m:
        try: _log("Block#19: file->plugin map ПУСТА -- атрибуция Python-ошибок уйдёт в untagged")
        except Exception: pass
    return m

def _b19_culprit_from_event(ev, fmap):
    n = int(ev.nframes)
    if n > _B19_MAX_FRAMES: n = _B19_MAX_FRAMES
    deepest_file = None; deepest_line = -1
    if n > 0:
        deepest_file = _b19_cstr(ev.files[n - 1]); deepest_line = int(ev.lines[n - 1])
    pid = None; pfile = None; pline = -1
    for i in range(n - 1, -1, -1):
        f = _b19_cstr(ev.files[i])
        cand = fmap.get(f)
        if cand is None:
            try: cand = fmap.get(os.path.basename(f))
            except Exception: cand = None
        if isinstance(cand, str) and cand:
            pid = cand; pfile = f; pline = int(ev.lines[i]); break
    return pid, pfile, pline, deepest_file, deepest_line

def _pyerr_verdict_log(rec, when):
    try:
        _log("============= JNI PY-EXC VERDICT (%s) =============" % when)
        cul = rec.get("culprit"); conf = rec.get("confidence")
        if cul and cul != "unknown":
            _log("ВИНОВНИК PY-JNI: %r conf=%s where=%s src=%s" % (cul, conf, rec.get("where"), rec.get("src")))
        else:
            _log("ВИНОВНИК PY-JNI: неизвестен (symbol=%s)" % rec.get("symbol"))
        _log("  причина: %s" % rec.get("reason"))
        pf = rec.get("py_file")
        if pf: _log("  modul: %s:%s" % (pf, rec.get("py_line")))
        df = rec.get("deepest_file")
        if df: _log("  deepest: %s:%s" % (df, rec.get("deepest_line")))
        _log("  granica: %s" % rec.get("symbol"))
        _log("===================================================")
    except Exception: pass

def _persist_pyerr_fail(rec):
    _persist_append(_pyerr_verdict_path(), rec, _PYERR_FAILS_MAX, "Block#19 pyerrpersist")

def _read_and_clear_pyerr_fails():
    return _read_and_clear_json_list(_pyerr_verdict_path())

_B19_DIAG_TS = {}
def _b19_diag(key, msg):
    try:
        now = int(time.time() * 1000)
        if now - _B19_DIAG_TS.get(key, 0) < 5000: return
        if len(_B19_DIAG_TS) > 256: _B19_DIAG_TS.clear()
        _B19_DIAG_TS[key] = now
        _log(msg)
    except Exception: pass
def _b19_record(ev, fmap):
    if not _BLOCK19_ON: return
    pid, pfile, pline, dfile, dline = _b19_culprit_from_event(ev, fmap)
    sym = _B19_SYM.get(int(ev.symbol), "?")
    if not pid:
        try:
            _df0 = str(dfile or "")
            if "/plugins/" in _df0:
                _b19_diag("nopid|" + _df0, "Block#19 +SF: событие без плагина в file-map (deepest=%s:%s sym=%s map=%d) -> пропуск" % (_df0, dline, sym, len(fmap)))
        except Exception: pass
        return
    if pid == _SELF_ID or pid == __id__: return
    try:
        _hl = _HOOK_LIVE_LINES.get((pid, str(pline)))
        if _hl is not None and 0 <= int(time.time() * 1000) - _hl <= _HOOK_ECHO_MS:
            _b19_diag("echo|%s|%s" % (pid, pline), "Block#19 +SE: echo hook/cb-вердикта '%s' (%s:%s) -> не вердикт" % (pid, pfile, pline))
            return
    except Exception: pass
    try:
        _etid = int(ev.tid); _ets = int(ev.ts_ms)
        _prev = _B19_LAST_TID.get(_etid)
        _df = str(dfile or "")
        if _prev and _prev[1] != pid and 0 <= _ets - _prev[0] <= _B19_ECHO_MS and (_df.endswith(".pxi") or _df.endswith(".pyx")):
            _log("Block#19 +SB: nested echo -- '%s' получил исключение '%s' через Java-вызов (tid=%d dt=%dms deepest=%s:%s) -> не вердикт" % (pid, _prev[1], _etid, _ets - _prev[0], _df, dline))
            return
        _B19_LAST_TID[_etid] = (_ets, pid)
        if len(_B19_LAST_TID) > 256: _B19_LAST_TID.clear()
    except Exception: pass
    reason = "py-exception across JNI boundary (%s)" % sym
    now = int(time.time() * 1000)
    _rate_pm, _rate_n = _exc_rate_record(pid)
    rec = {"had_pyerr_fail": True, "event_type": "python_exception", "dropbox_tag": "data_app_crash", "tombstone_norm_version": 1, "culprit": pid, "src": "py-frame/jni-boundary",
           "confidence": "high", "where": "jni-boundary", "symbol": sym,
           "py_module": pid, "py_file": pfile, "py_line": pline,
           "deepest_file": dfile, "deepest_line": dline, "reason": reason,
           "exc_cls": None, "exc_msg": None,
           "throws_per_min": _rate_pm, "throws_in_window": _rate_n,
           "high_rate": bool(_rate_pm >= _EXC_RATE_HOT), "ts": now}
    key = "%s|%s|%s" % (pid, pline, sym)
    try:
        with _PYERR_SEEN_LOCK:
            if now - _PYERR_SEEN.get(key, 0) < _PYERR_DEDUP_MS:
                _exc_rate_refresh_note("pyerr", _PYERR_SEEN[key], rec)
                _b19_diag("dedup|" + key, "Block#19 +SF: дедуп %dms '%s' (%s:%s) -> пропуск" % (_PYERR_DEDUP_MS, pid, pfile, pline))
                return
            _PYERR_SEEN[key] = now
    except Exception: pass
    try: _b16_push_verdict("pyerr", rec)
    except Exception: pass
    try: _pyerr_verdict_log(rec, "live")
    except Exception: pass
    try: _persist_pyerr_fail(rec)
    except Exception: pass

_CD_COMPACT_TS = 0
_CD_COMPACT_MIN_S = 300
_CD_COMPACT_TOMB_HI = 200000
def _b19_poll_loop(stop):
    global _B19_NEXT, _CD_COMPACT_TS
    if not (_B19_OK and _NLIB is not None and _B19Event is not None and _B19_RING_ADDR):
        return
    cap = _B19_RING_CAP
    fmap = {}; fmap_ts = 0
    evfd = -1
    try:
        evfd = int(_NLIB.cd_b19_eventfd())
    except Exception: evfd = -1
    try:
        _log("Block#19: режим СОБЫТИЙНЫЙ (eventfd=%d, select idle=%.0fs)" % (evfd, _B19_IDLE_S))
    except Exception: pass
    _b19_ack_ok = False
    try:
        if hasattr(_NLIB, "cd_b19_acked") and hasattr(_NLIB, "cd_b19_ack"):
            _NLIB.cd_b19_acked.restype = ctypes.c_int64
            _NLIB.cd_b19_ack.argtypes = [ctypes.c_int64]; _NLIB.cd_b19_ack.restype = None
            _b19_ack_ok = True
            _a = int(_NLIB.cd_b19_acked())
            if _a > _B19_NEXT:
                _log("Block#19 +SF: курсор кольца из .so: %d (reload -- уже обработанные события не повторяются)" % _a)
                _B19_NEXT = _a
    except Exception: pass
    while not stop.is_set():
        try:
            committed = int(_NLIB.cd_b19_committed())
            if committed > _B19_NEXT:
                now = int(time.time() * 1000)
                if (now - fmap_ts) > 1500 or not fmap:
                    fmap = _b19_file_plugin_map(); fmap_ts = now
                start = _B19_NEXT
                if committed - start > cap:
                    start = committed - cap
                for seq in range(start, committed):
                    try:
                        if int(_NLIB.cd_b19_read_event(seq, _B19_EVADDR)) == 1:
                            _b19_record(_B19_EVBUF, fmap)
                    except Exception: pass
                _B19_NEXT = committed
                if _b19_ack_ok:
                    try: _NLIB.cd_b19_ack(ctypes.c_int64(committed))
                    except Exception: pass
        except Exception: pass
        try:
            _nl = _NLIB
            if _nl is not None and hasattr(_nl, "cd_compact") and hasattr(_nl, "cd_tomb_count"):
                _now2 = int(time.time())
                if _now2 - _CD_COMPACT_TS >= _CD_COMPACT_MIN_S and int(_nl.cd_tomb_count()) >= _CD_COMPACT_TOMB_HI:
                    _moved = int(_nl.cd_compact())
                    _CD_COMPACT_TS = _now2
                    _log(f"FIX#15 compact: moved={_moved} (tomb>={_CD_COMPACT_TOMB_HI})")
        except Exception: pass
        try:
            if select.select([evfd], [], [], _B19_IDLE_S)[0]:
                try: os.read(evfd, 8)
                except Exception: pass
        except Exception:
            stop.wait(_B19_IDLE_S)

def _b19_start():
    global _B19_STARTED, _B19_STOP, _B19_THREAD, _B19_RING_ADDR
    if not _BLOCK19_ON:
        _log("Block#19: отключён (_BLOCK19_ON=False)"); return
    if not (_B19_OK and _NATIVE_OK and _NLIB is not None):
        _log("Block#19: натив/символы недоступны -- пропуск"); return
    if _B19_STARTED: return
    try:
        hooks = int(_NLIB.cd_b19_start())
    except Exception as e:
        _log("Block#19 cd_b19_start err: %s" % e); return
    if hooks <= 0:
        _log("Block#19: cd_b19_start вернул %d хуков -- JNI/py граница не зацепилась" % hooks); return
    try: _B19_RING_ADDR = int(_NLIB.cd_b19_ring_addr())
    except Exception: _B19_RING_ADDR = 0
    if not _B19_RING_ADDR:
        _log("Block#19: ring_addr=0 -- отключаю")
        try: _NLIB.cd_b19_stop()
        except Exception: pass
        return
    _B19_STOP = threading.Event()
    _B19_THREAD = threading.Thread(target=_b19_poll_loop, args=(_B19_STOP,), name="culprit-b19", daemon=True)
    _B19_THREAD.start()
    _B19_STARTED = True
    _b19_tot = 3; _b19_inv = ""
    try:
        if hasattr(_NLIB, "cd_b19_hook_total"): _b19_tot = int(_NLIB.cd_b19_hook_total())
        if hasattr(_NLIB, "cd_b19_invoke_hooked"): _b19_inv = ", invokeNative=%d" % int(_NLIB.cd_b19_invoke_hooked())
    except Exception: pass
    _log("Block#19: установлен (хуков %d/%d%s, ring@0x%x cap=%d) -> %s" % (hooks, _b19_tot, _b19_inv, _B19_RING_ADDR, _B19_RING_CAP, _PYERR_FILE_NAME))

def _b19_stop():
    global _B19_STARTED
    if not _B19_STARTED: return
    try:
        if _B19_STOP is not None: _B19_STOP.set()
        try:
            if _NLIB is not None: _NLIB.cd_b19_event_wake()
        except Exception: pass
        if _B19_THREAD is not None: _B19_THREAD.join(timeout=2.0)
    except Exception: pass
    try:
        if _NLIB is not None: _NLIB.cd_b19_stop()
    except Exception: pass
    _B19_STARTED = False
    _log("Block#19: снят (cd_b19_stop)")


_BLOCK26_ON = True
_CXA_FILE_NAME = "cxa_throw.txt"
_CXA_UI_MAX = 20
_B26_OK = False
_B26_STARTED = False

def _cxa_path():
    return _data_path(_CXA_FILE_NAME)

def _kg_history_path():
    return _data_path(_KG_HISTORY_NAME)

def _md_hist_best(crash_ts):
    try:
        if crash_ts is None:
            return None
        ct = int(crash_ts)
        hp = _kg_history_path()
        if not (hp and os.path.exists(hp)):
            return None
        with open(hp, "r", encoding="utf-8") as f:
            hist = list(json.load(f))
    except Exception:
        return None
    best = None; best_d = None
    for it in hist:
        try:
            if not isinstance(it, dict) or it.get("event_type") != "selfkill_blocked":
                continue
            d = abs(int(it.get("ts")) - ct)
            if d <= _MD_VERDICT_FRESH_MS and (best_d is None or d < best_d):
                best = it; best_d = d
        except Exception:
            continue
    return best

_TA_SEGV_WINDOW_MS = 5000

def _ta_selfkill_aftermath(rec, where):
    try:
        sig = int(rec.get("signo") or 0)
    except Exception:
        return False
    if sig not in (4, 11) or rec.get("pid") is not None or rec.get("native_subtype") == "selfkill_aftermath":
        return False
    top = ((rec.get("top_so") or "").rsplit("/", 1)[-1] or "").lower()
    fso = ""
    fr = rec.get("frames") or []
    if fr and isinstance(fr[0], str) and ".so" in fr[0]:
        fso = fr[0].split("+", 1)[0].split(" ", 1)[0].rsplit("/", 1)[-1].lower()
    if not ((top in _MD_RT_SO) or (fso in _MD_RT_SO)):
        return False
    try:
        cts = int(rec.get("crash_ts") or rec.get("ts"))
    except Exception:
        return False
    win = _MD_VERDICT_FRESH_MS if sig == 4 else _TA_SEGV_WINDOW_MS
    cands = []
    try:
        vp = _kg_verdict_path()
        if not (vp and os.path.exists(vp)):
            try: _b30_read_sentinel("ta-correlate")
            except Exception: pass
            vp = _kg_verdict_path()
        if vp and os.path.exists(vp):
            with open(vp, "r", encoding="utf-8") as f:
                cands.append(json.load(f))
    except Exception:
        pass
    try:
        hb = _md_hist_best(cts)
        if hb is not None:
            cands.append(hb)
    except Exception:
        pass
    sk = None; best_d = None
    for c in cands:
        if not isinstance(c, dict) or c.get("event_type") != "selfkill_blocked":
            continue
        try:
            d = cts - int(c.get("ts"))
        except Exception:
            continue
        if _td_sk_consumed(c, cts):
            continue
        if -1000 <= d <= win and (best_d is None or abs(d) < abs(best_d)):
            sk, best_d = c, d
    if sk is None:
        return False
    cul = _deidx_name(sk.get("culprit"))
    vec = sk.get("vector") or "exit"
    rec["pid"] = cul
    rec["culprit_kind"] = "plugin" if cul else "system"
    rec["confidence"] = "medium"
    rec["native_subtype"] = "selfkill_aftermath"
    rec["pid_choice_src"] = "selfkill-aftermath"
    rec["pid_resolve_src"] = "kg-correlated"
    rec["unattributed_reason"] = None
    rec["runtime_abort_suspect"] = True
    rec["selfkill_aftermath"] = {
        "block_ts": sk.get("ts"), "block_culprit": cul, "vector": vec,
        "signal": sk.get("signal"), "api": sk.get("api"), "delta_ms": int(best_d), "where": where,
    }
    rec["native_advisory"] = ("последствие заблокированного %s плагина %r: после блокировки %s поток вернулся в noreturn-код рантайма и упал (signo=%d через %d мс) -- не отдельный краш" % (vec, cul, sk.get("api") or "exit", sig, int(best_d)))
    try: _ta_mark_died(sk, sig, int(best_d), cts)
    except Exception: pass
    _log("Block#4C +TA(1): signo=%d в рантайме (%s) через %dms после заблокированного %s -> последствие блокировки; culprit=%r conf=medium [%s]" % (sig, top or fso, int(best_d), vec, cul, where))
    return True

def _td_sk_consumed(sk, cts):
    try:
        return bool(isinstance(sk, dict) and sk.get("process_survived") is False and sk.get("aftermath_ts") not in (None, cts))
    except Exception:
        return False

def _td_runtime_abort(rec):
    try:
        if int(rec.get("signo") or 0) != 4 or rec.get("pid") is not None:
            return False
        top = ((rec.get("top_so") or "").rsplit("/", 1)[-1] or "").lower()
        if top not in _MD_RT_SO:
            return False
        rec["runtime_abort_suspect"] = True
        rec["native_subtype"] = "runtime_abort"
        rec["confidence"] = "low"
        rec["unattributed_reason"] = "runtime-abort: SIGILL wholly in JVM/ART runtime (%s) without fresh selfkill_blocked -- runtime abort / not a standalone plugin crash" % top
        _log("Block#35 +TD(2): SIGILL в рантайме (%s) без свежей блокировки exit -> runtime_abort_suspect, conf=low [journal]" % top)
        return True
    except Exception:
        return False

def _ta_mark_died(sk, sig, delta, cts):
    upd = {"process_survived": False, "aftermath_signo": sig, "aftermath_delta_ms": delta, "aftermath_ts": cts,
           "neutralized_note": "exit заблокирован, но процесс умер через %d мс (signo=%d): возврат из noreturn-пути рантайма" % (delta, sig)}
    bts = sk.get("ts")
    vp = _kg_verdict_path()
    if vp and os.path.exists(vp):
        try:
            with open(vp, "r", encoding="utf-8") as f:
                v = json.load(f)
            if isinstance(v, dict) and v.get("ts") == bts and v.get("process_survived") is None:
                v.update(upd)
                _atomic_json_write(vp, v)
        except Exception:
            pass
    hp = _kg_history_path()
    if hp and os.path.exists(hp):
        try:
            with open(hp, "r", encoding="utf-8") as f:
                h = list(json.load(f))
            ch = False
            for it in h:
                if isinstance(it, dict) and it.get("ts") == bts and it.get("process_survived") is None:
                    it.update(upd)
                    ch = True
            if ch:
                _atomic_json_write(hp, h, 40)
        except Exception:
            pass

def _kg_sentinel_path():
    return _data_path(_KG_SENTINEL_NAME)

def _kg_verdict_path():
    return _data_path(_KG_VERDICT_NAME)

def _fg_sentinel_path():
    return _data_path(_FG_SENTINEL_NAME)

def _fg_verdict_path():
    return _data_path(_FG_VERDICT_NAME)

def _self_backup_path():
    try:
        pd = _app_priv_dir()
        if pd:
            return File(pd, _SELF_BACKUP_NAME).getAbsolutePath()
    except Exception:
        pass
    return _data_path(_SELF_BACKUP_NAME)

def _self_plugin_path():
    try:
        fp = globals().get("__file__")
        if isinstance(fp, str) and fp and fp.endswith(".py"):
            try:
                if File(fp).exists(): return File(fp).getAbsolutePath()
            except Exception:
                return fp
    except Exception:
        pass
    try:
        PC = jclass("com.exteragram.messenger.plugins.PluginsController").getInstance()
        d = PC.pluginsDir
        if d is not None:
            return File(d, str(_SELF_ID) + ".py").getAbsolutePath()
    except Exception:
        pass
    return None

def _b31_enable_pref():
    try:
        PC = jclass("com.exteragram.messenger.plugins.PluginsController").getInstance()
        try:
            PC.setPluginEnabled(str(_SELF_ID), True)
            return True
        except Exception:
            pass
    except Exception:
        pass
    return False

def _b31_write_file(path, data):
    if not path: return False
    try:
        tmp = path + ".tmp"
        with open(tmp, "wb") as f:
            f.write(data); f.flush()
            try: os.fsync(f.fileno())
            except Exception: pass
        try:
            os.replace(tmp, path)
        except Exception:
            with open(path, "wb") as f2:
                f2.write(data); f2.flush()
                try: os.fsync(f2.fileno())
                except Exception: pass
            try: os.remove(tmp)
            except Exception: pass
        return True
    except Exception as e:
        _log("Block#31 write err: %s" % e)
        return False

_b31_last_src_sig = None
_b31_fail_sig = None
_b31_fail_ts = 0.0
_B31_FAIL_BACKOFF_S = 300.0

_B31_BAK_LOCK = threading.Lock()

def _b31_backup_self():
    global _b31_last_src_sig, _b31_fail_sig, _b31_fail_ts
    if not _B31_BAK_LOCK.acquire(False):
        return False
    try:
        sp = _self_plugin_path(); bp = _self_backup_path()
        if not sp or not bp: return False
        if not File(sp).exists(): return False
        try:
            st = os.stat(sp)
            sig = (getattr(st, "st_mtime_ns", int(st.st_mtime * 1000000000)), st.st_size)
        except Exception:
            sig = None
        if sig is not None and sig == _b31_last_src_sig:
            try:
                if File(bp).exists() and os.path.getsize(bp) > 0:
                    return True
            except Exception:
                pass
        if (sig is not None and sig == _b31_fail_sig
                and (time.time() - _b31_fail_ts) < _B31_FAIL_BACKOFF_S):
            return False
        with open(sp, "rb") as f: data = f.read()
        if not data: return False
        ok = _b31_write_file(bp, data)
        if ok:
            if sig is not None:
                _b31_last_src_sig = sig
            _b31_fail_sig = None
        else:
            _b31_fail_sig = sig
            _b31_fail_ts = time.time()
        return ok
    except Exception as e:
        _log("Block#31 backup err: %s" % e)
        return False
    finally:
        _B31_BAK_LOCK.release()

def _b31_resurrect():
    try:
        sp = _self_plugin_path(); bp = _self_backup_path()
        if not sp or not bp: return False
        if File(sp).exists(): return False
        if not File(bp).exists(): return False
        with open(bp, "rb") as f: data = f.read()
        if not data: return False
        if not _b31_write_file(sp, data): return False
        _log("Block#31: detector .py восстановлен из бэкапа -> %s" % sp)
        try: _b31_enable_pref()
        except Exception: pass
        try:
            vp = _fg_verdict_path()
            if vp:
                verdict = {"kind": "detector_resurrected", "from": bp, "to": sp,
                           "culprit": _UNTAGGED_LABEL,
                           "reason": "Детектор был удалён и автоматически восстановил себя из резервной копии (.bak.py)",
                           "confidence": "high", "detector": "Block#31 self-resurrect",
                           "version": __version__, "ts": int(time.time() * 1000), "tag": "boot"}
                _atomic_json_write(vp, verdict)
        except Exception: pass
        return True
    except Exception as e:
        _log("Block#31 resurrect err: %s" % e)
        return False

_B31_WD_THREAD = None
_B31_WD_STOP_EVT = threading.Event()
_B31_WD_STOPPED = False
_B31_WD_LOCK = threading.Lock()
_B31_WD_INTERVAL = 1.0
_B31_WD_GRACE = 2.5
_b31_missing_since = None

def _b31_reset_native_sentinel():
    try:
        if _NLIB is not None and hasattr(_NLIB, "cd_fg_reset_sentinel"):
            _NLIB.cd_fg_reset_sentinel()
    except Exception:
        pass

def _b31_clear_sentinel(reason):
    try:
        p = _fg_sentinel_path()
        _mp = _aw_mirror_path(p) if p else None
        if p and (File(p).exists() or (_mp and File(_mp).exists())):
            _rc_remove_both(p)
            _log("Block#31: stale fileguard sentinel discarded (%s)" % reason)
    except Exception:
        pass
    _b31_reset_native_sentinel()

def _b31_native_read():
    if not (_WD_NATIVE_OK and _NLIB is not None):
        return None
    try:
        buf = (ctypes.c_int64 * 8)()
        got = int(_NLIB.cd_wd_read(buf, 8))
        if got < 8:
            return None
        return {"src_present": bool(buf[0]), "src_mtime_ns": int(buf[1]),
                "src_size": int(buf[2]), "bak_present": bool(buf[3]),
                "bak_size": int(buf[4]), "sentinel_present": bool(buf[5]),
                "missing_ms": int(buf[6]), "ts_ms": int(buf[7])}
    except Exception:
        return None

def _b31_native_wd_start():
    if not (_WD_NATIVE_OK and _NATIVE_OK and _NLIB is not None):
        return False
    try:
        if int(_NLIB.cd_wd_running()):
            return True
    except Exception:
        pass
    sp = _self_plugin_path(); bp = _self_backup_path(); se = _aw_mirror_path(_fg_sentinel_path()) or _fg_sentinel_path()
    try:
        rc = int(_NLIB.cd_wd_start((sp or "").encode("utf-8"),
                                   (bp or "").encode("utf-8"),
                                   (se or "").encode("utf-8"),
                                   int(_B31_WD_INTERVAL * 1000)))
        if rc >= 0:
            _log("Block#31: нативный off-GIL watchdog запущен (+DS, period=%dms)" % int(_B31_WD_INTERVAL * 1000))
            return True
    except Exception as e:
        _log("Block#31 native wd start err: %s" % e)
    return False

_B31_INSTALL_TEMP_SUFFIXES = (".tmp", ".part", ".partial", ".download", ".dl", ".new", ".writing", ".crdownload", "~")
_B31_INSTALL_FRESH_S = 12.0

def _b31_fresh(p):
    try:
        return (time.time() - os.path.getmtime(p)) <= _B31_INSTALL_FRESH_S
    except Exception:
        return False

def _b31_install_in_progress():
    try:
        sp = _self_plugin_path()
        if not sp: return False
        d = os.path.dirname(sp) or _DIR
        base = os.path.basename(sp)
        for suf in _B31_INSTALL_TEMP_SUFFIXES:
            try:
                cand = os.path.join(d, base + suf)
                if os.path.exists(cand) and _b31_fresh(cand):
                    return True
            except Exception: pass
        try:
            for nm in os.listdir(d):
                if nm.lower().endswith(_B31_INSTALL_TEMP_SUFFIXES) and _b31_fresh(os.path.join(d, nm)):
                    return True
        except Exception: pass
    except Exception: pass
    return False

def _b31_watchdog_tick():
    global _b31_missing_since
    _gil_begin(_GIL_B31)
    try:
        snap = _b31_native_read()
        if snap is not None:
            if snap["src_present"]:
                if _b31_missing_since is not None:
                    _b31_missing_since = None
                if snap["sentinel_present"]:
                    try: _b31_read_sentinel("watchdog-blocked")
                    except Exception: pass
                    _b31_clear_sentinel("file present")
                if (not snap["bak_present"]) or ((snap["src_mtime_ns"], snap["src_size"]) != _b31_last_src_sig):
                    try: _b31_backup_self()
                    except Exception: pass
            else:
                if (snap["missing_ms"] / 1000.0) >= _B31_WD_GRACE:
                    if _b31_install_in_progress():
                        try: _log("Block#31: .py нет, но рядом свежий temp установки -- восстановление отложено")
                        except Exception: pass
                    else:
                        if _b31_resurrect():
                            try: _b31_read_sentinel("watchdog")
                            except Exception: pass
                            _b31_reset_native_sentinel()
                        _b31_missing_since = None
        else:
            pass
    except Exception as e:
        _log("Block#31 watchdog tick err: %s" % e)
    finally:
        _gil_end(_GIL_B31)

def _b31_watchdog_loop():
    while not _B31_WD_STOP_EVT.is_set():
        if _B31_WD_STOP_EVT.wait(_B31_WD_INTERVAL): break
        if not _BLOCK31_ON or globals().get("_B31_WD_STOPPED", False): break
        try: _b31_watchdog_tick()
        except Exception as e:
            try: _log("Block#31 watchdog loop err: %s" % e)
            except Exception: pass

def _b31_watchdog_arm():
    global _B31_WD_THREAD
    if not _BLOCK31_ON or globals().get("_B31_WD_STOPPED", False): return
    try:
        with _B31_WD_LOCK:
            t = _B31_WD_THREAD
            if t is not None and t.is_alive():
                return
            _B31_WD_STOP_EVT.clear()
            _B31_WD_THREAD = threading.Thread(target=_b31_watchdog_loop, name="cd-b31-wd", daemon=True)
            _B31_WD_THREAD.start()
    except Exception as e:
        _log("Block#31 watchdog arm err: %s" % e)

def _b31_watchdog_stop():
    global _B31_WD_THREAD, _b31_missing_since, _B31_WD_STOPPED
    try:
        if _WD_NATIVE_OK and _NLIB is not None and int(_NLIB.cd_wd_running()):
            _NLIB.cd_wd_stop()
    except Exception:
        pass
    _B31_WD_STOPPED = True
    _B31_WD_STOP_EVT.set()
    try:
        with _B31_WD_LOCK:
            t = _B31_WD_THREAD
            _B31_WD_THREAD = None
        if t is not None and t is not threading.current_thread():
            try: t.join(timeout=2.0)
            except Exception: pass
        _b31_missing_since = None
    except Exception:
        pass

def _b31_decl(lib):
    global _B31_OK
    c = ctypes
    needed = ("cd_fg_protect", "cd_fg_start", "cd_fg_running")
    if not all(hasattr(lib, n) for n in needed):
        _B31_OK = False
        _log("Block#31: cd_fg_* нет в .so (старый бинарь) -- file-guard отключён")
        return False
    lib.cd_fg_protect.argtypes = [c.c_char_p]; lib.cd_fg_protect.restype = c.c_int
    lib.cd_fg_start.argtypes = [c.c_char_p]; lib.cd_fg_start.restype = c.c_int
    if hasattr(lib, "cd_fg_stop"): lib.cd_fg_stop.restype = c.c_int
    lib.cd_fg_running.restype = c.c_int
    if hasattr(lib, "cd_fg_arm"):
        lib.cd_fg_arm.argtypes = [c.c_int]; lib.cd_fg_arm.restype = c.c_int
    if hasattr(lib, "cd_fg_is_armed"):
        lib.cd_fg_is_armed.restype = c.c_int
    if hasattr(lib, "cd_fg_count"):
        lib.cd_fg_count.restype = c.c_int
    for opt in ("cd_fg_seen", "cd_fg_blocked"):
        if hasattr(lib, opt): getattr(lib, opt).restype = c.c_int64
    if hasattr(lib, "cd_fg_reset_sentinel"):
        lib.cd_fg_reset_sentinel.restype = c.c_int
    _B31_OK = True
    return True

def _b31_init(lib):
    if not _BLOCK31_ON:
        _log("Block#31: отключён (_BLOCK31_ON=False)"); return
    try:
        _b31_decl(lib)
    except Exception as e:
        _log("Block#31 decl err: %s" % e)

def _b31_start():
    global _B31_STARTED, _B31_WD_STOPPED
    if not _BLOCK31_ON: return
    _B31_WD_STOPPED = False
    try: _b31_native_wd_start()
    except Exception: pass
    try: _b31_backup_self()
    except Exception: pass
    try: _b31_watchdog_arm()
    except Exception: pass
    if not (_B31_OK and _NATIVE_OK and _NLIB is not None):
        _log("Block#31: натив/символы недоступны -- только бэкап"); return
    if _B31_STARTED: return
    sp = _self_plugin_path()
    if not sp:
        _log("Block#31: put detektora ne razreshen -- propusk"); return
    try:
        rc = int(_NLIB.cd_fg_protect(sp.encode("utf-8")))
        if rc < 0: _log("Block#31: cd_fg_protect vernul %d" % rc)
    except Exception as e:
        _log("Block#31 cd_fg_protect err: %s" % e); return
    p = _fg_sentinel_path()
    _pw = _aw_mirror_path(p) or p
    try:
        rc2 = int(_NLIB.cd_fg_start((_pw or "").encode("utf-8")))
    except Exception as e:
        _log("Block#31 cd_fg_start err: %s" % e); return
    if rc2 < 0:
        _log("Block#31: cd_fg_start vernul %d -- libc rename/unlink ne zacepilis" % rc2); return
    _B31_STARTED = True
    _log("Block#31: file-guard установлен (libc rename/renameat/unlink/unlinkat), хуков=%d, защищён=%s" % (rc2, sp))
    try: _b31_read_sentinel("post-start")
    except Exception: pass

def _b31_stop():
    global _B31_STARTED
    try: _b31_watchdog_stop()
    except Exception: pass
    if not _B31_STARTED: return
    try:
        if _NLIB is not None: _NLIB.cd_fg_stop()
    except Exception: pass
    _B31_STARTED = False
    _log("Block#31: snjat (cd_fg_stop)")

def _b31_parse_sentinel(text):
    rec = {}
    try:
        for line in text.splitlines():
            line = line.strip()
            if not line or line in ("CULPRIT_FILEGUARD", "END"): continue
            for tok in line.split(" "):
                if "=" in tok:
                    k, v = tok.split("=", 1)
                    rec[k] = v
    except Exception:
        pass
    return rec

def _b31_read_sentinel(tag):
    if not _BLOCK31_ON: return None
    p = _fg_sentinel_path()
    if not p: return None
    _rp = _rc_take_path(p)
    if not _rp: return None
    try:
        with open(_rp, "r", encoding="utf-8", errors="replace") as f:
            text = f.read()
    except Exception:
        return None
    finally:
        try: os.remove(_rp)
        except Exception: pass
    rec = _b31_parse_sentinel(text)
    if not rec: return None
    owner_id = rec.get("owner_id") or ""
    if owner_id in ("(?)", ""): owner_id = ""
    try: idx = int(rec.get("owner_idx", "-1"))
    except Exception: idx = -1
    name = owner_id or _resolve_idx_durable(idx) or (("idx#%d" % idx) if idx >= 0 else "unknown")
    name = _deidx_name(name)
    api = rec.get("api", "?")
    path = rec.get("path", "?")
    try: ts = int(rec.get("ts", "0"))
    except Exception: ts = int(time.time() * 1000)
    _kgc = _kg_crash_corroborate(idx, ts, name)
    if _kgc: name = _kgc[0]
    low = name.lower()
    dropper = ("netprotector" in low) or ("netblocker" in low) or ("shikatu" in low)
    verdict = {"event_type": "file_delete_blocked", "dropbox_tag": "self_protection", "tombstone_norm_version": 1, "kind": "detector_erase_blocked", "culprit": name, "owner_idx": idx,
               "api": api, "path": path, "vector": "os.replace/os.remove on detector .py",
               "dropper_signature": dropper, "neutralized": True,
               "confidence": "high", "detector": "Block#31 native file-guard",
               "version": __version__, "ts": ts, "tag": tag}
    if _kgc:
        verdict["culprit_src"] = _kgc[1]
        if _kgc[2] != _kgc[0]: verdict["culprit_sidecar"] = _kgc[2]
    vp = _fg_verdict_path()
    if vp:
        try:
            if not _atomic_json_write(vp, verdict):
                _log("Block#31 verdict write returned False")
        except Exception as e:
            _log("Block#31 verdict write err: %s" % e)
    _log("=============== DETECTOR ERASE NEUTRALIZED (Block#31) ===============")
    _log("  culprit=%s api=%s path=%s" % (name, api, path))
    _log("  detector .py survived; verdict -> %s" % _FG_VERDICT_NAME)
    _log("====================================================================")
    try:
        _b16_push_verdict("detector_erase_blocked", {"culprit": name, "confidence": "high", "where": api, "ts": ts})
    except Exception:
        pass
    return verdict

def _b30_decl(lib):
    global _B30_OK
    c = ctypes
    needed = ("cd_kg_start", "cd_kg_stop", "cd_kg_running")
    if not all(hasattr(lib, n) for n in needed):
        _B30_OK = False
        _log("Block#30: cd_kg_* нет в .so (старый бинарь) -- kill-guard отключён")
        return False
    lib.cd_kg_start.argtypes = [c.c_char_p]; lib.cd_kg_start.restype = c.c_int
    lib.cd_kg_stop.restype = c.c_int
    lib.cd_kg_running.restype = c.c_int
    if hasattr(lib, "cd_kg_arm"):
        lib.cd_kg_arm.argtypes = [c.c_int]; lib.cd_kg_arm.restype = c.c_int
    if hasattr(lib, "cd_kg_is_armed"):
        lib.cd_kg_is_armed.restype = c.c_int
    for opt in ("cd_kg_seen", "cd_kg_blocked"):
        if hasattr(lib, opt): getattr(lib, opt).restype = c.c_int64
    if hasattr(lib, "cd_kg_permit_restart"):
        lib.cd_kg_permit_restart.restype = c.c_int
    if hasattr(lib, "cd_kg_permit_crash"):
        lib.cd_kg_permit_crash.restype = c.c_int
    _B30_OK = True
    return True

def _b30_init(lib):
    if not _BLOCK30_ON:
        _log("Block#30: отключён (_BLOCK30_ON=False)"); return
    try:
