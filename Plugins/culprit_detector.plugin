def _known_path():
    return _data_path(_KNOWN_FILE)
def _load_known():
    p = _known_path()
    try:
        if p and os.path.exists(p):
            with open(p, "r", encoding="utf-8") as f:
                return list(json.load(f))
    except Exception:
        pass
    return []
def _save_known(pid):
    try:
        cur = set(_load_known())
        if pid in cur: return
        cur.add(pid)
        p = _known_path()
        if not p: return
        _atomic_json_write(p, sorted(cur))
    except Exception:
        pass

def _known_union():
    out = set()
    try:
        out.update(_load_known() or [])
    except Exception:
        pass
    try:
        out.update([n for n in _IDX_PID if isinstance(n, str) and n])
    except Exception:
        pass
    try:
        p = _idxnames_path()
        if p and os.path.exists(p):
            with open(p, "r", encoding="utf-8") as f:
                m = json.load(f)
            if isinstance(m, dict):
                out.update([v for v in m.values() if isinstance(v, str) and v])
    except Exception:
        pass
    return list(out)


def _simple(class_str):
    s = class_str.replace("class ", "").strip()
    for sep in ("$", "."):
        if sep in s: s = s.split(sep)[-1]
    return s
def _tokens(s):
    return set(t for t in re.split(r"[^a-z0-9]+", (s or "").lower()) if len(t) >= 3)
def _is_hook_frame(f):
    if not f: return False
    for m in _HOOK_MARKERS:
        if m in f: return True
    return False
def _is_system_class(cls):
    if not cls: return True
    if "culprit" in cls.lower(): return True
    for p in _SYS_PREFIXES:
        if cls.startswith(p): return True
    return False
def _is_obfuscated(frame):
    parts = (frame or "").split(".")
    if len(parts) < 2: return True
    return all(len(p) <= 2 for p in parts[:-1])
def _short_method(frame):
    parts = (frame or "").split(".")
    return ".".join(parts[-2:]) if len(parts) >= 2 else frame
def _squash(s):
    return re.sub(r"[^a-z0-9]+", "", (s or "").lower())
def _py_module_of(frame):
    if not frame or not frame.startswith(_PY_PREFIX): return None
    rest = frame[len(_PY_PREFIX):]
    if not rest: return None
    return rest.split(".", 1)[0]
def _is_py_runtime_frame(fr):
    if not fr or not fr.startswith(_PY_PREFIX): return False
    low = fr[len(_PY_PREFIX):].lower()
    return any(low == s or low.startswith(s) for s in _PY_SYS_MODS)
def _stack_culprit(frames):
    for fr in frames:
        if _is_system_class(fr): continue
        if _is_hook_frame(fr): continue
        if _is_py_runtime_frame(fr): continue
        if _is_obfuscated(fr): continue
        return fr
    return None
def _pkg_of(frame):
    parts = (frame or "").split(".")
    return ".".join(parts[:3]) if len(parts) >= 3 else frame
def _map_stack_to_id(culprit_frame, known):
    if not culprit_frame or not known: return None
    mod = _py_module_of(culprit_frame)
    sq = _squash(mod) if mod else ""
    if sq:
        for pid in known:
            if _squash(pid) == sq: return pid
        for pid in known:
            ps = _squash(pid)
            if ps and len(ps) >= 4 and (ps in sq or sq in ps): return pid
    ct = _tokens(culprit_frame) - _GENERIC
    if not ct: return None
    best = None; best_score = 0; second = 0
    for pid in known:
        pt = _tokens(pid) - _GENERIC
        score = len(ct & pt)
        if score > best_score:
            second = best_score; best_score = score; best = pid
        elif score > second:
            second = score
    if best_score >= 1 and best_score > second:
        return best
    return None

_REENTRY = threading.local()
_FIRST_LOGGED = False
def _note_first(pid, where):
    global _FIRST_LOGGED
    if _FIRST_LOGGED: return
    _FIRST_LOGGED = True
    _log(f"first breadcrumb captured: pid={pid} where={where!r}")

def _crash_path():
    return _data_path(_CRASH_FILE_NAME)
_APP_PRIV_DIR = None
_AW_LOG_SEEN = {}
def _aw_mirror_path(path):
    try:
        pd = _app_priv_dir()
        if not pd: return None
        return os.path.join(pd, os.path.basename(path))
    except Exception:
        return None
def _aw_mirror_list():
    out = []
    try:
        pd = _app_priv_dir()
        if not pd: return out
        names = File(pd).list()
        if names:
            for nm in names:
                try:
                    if nm.endswith(".stage"): continue
                    if not (nm.endswith(".json") or nm.endswith(".txt") or nm in ("culprit_journal.bin", "culprit_journal.bin.1", "culprit_tracer_report.txt.1") or _rc_is_quarantine_name(nm) or _rc_is_stale_processing(os.path.join(pd, nm), nm)): continue
                    out.append(File(pd, nm).getAbsolutePath())
                except Exception: pass
    except Exception: pass
    return out
def _aw_log_once(path, sig, msg):
    try:
        if _AW_LOG_SEEN.get(path) == sig:
            return
        _AW_LOG_SEEN[path] = sig
    except Exception:
        pass
    try: _log(msg)
    except Exception: pass
def _aw_log_clear(path):
    try:
        _AW_LOG_SEEN.pop(path, None)
    except Exception: pass
def _app_priv_dir():
    global _APP_PRIV_DIR
    try:
        if _APP_PRIV_DIR:
            return _APP_PRIV_DIR
    except Exception:
        pass
    d = None
    try:
        ctx = _app_context()
        if ctx is not None:
            base = None
            try: base = ctx.getCacheDir().getAbsolutePath()
            except Exception: base = None
            if not base:
                try: base = ctx.getFilesDir().getAbsolutePath()
                except Exception: base = None
            if base:
                jd = File(base, "culprit_tmp")
                try:
                    if not jd.exists(): jd.mkdirs()
                except Exception: pass
                if jd.exists() and jd.isDirectory():
                    d = jd.getAbsolutePath()
    except Exception:
        d = None
    if d:
        _APP_PRIV_DIR = d
    return d

_FALLBACK_IO_LOCK = threading.Lock()
def _atomic_same_dir_replace(path, text):
    sib = None
    try:
        d = os.path.dirname(path) or "."
        sib = os.path.join(d, os.path.basename(path) + ".fb." + str(os.getpid()) + "." + str(threading.get_ident()))
        with open(sib, "w", encoding="utf-8") as f:
            f.write(text); f.flush()
            try: os.fsync(f.fileno())
            except Exception: pass
        os.replace(sib, path)
        return True
    except Exception:
        if sib:
            try: os.remove(sib)
            except Exception: pass
        return False

def _aw_target_is_precious(path):
    try:
        return os.path.exists(path) and os.path.getsize(path) > 0
    except Exception:
        return False


def _atomic_write_fallback(path, text):
    last_exc = None
    try:
        if _atomic_same_dir_replace(path, text):
            return (True, "sdcard", None)
    except Exception as e:
        last_exc = e
    try:
        if not _aw_target_is_precious(path):
            with open(path, "w", encoding="utf-8") as f3:
                f3.write(text); f3.flush()
                try: os.fsync(f3.fileno())
                except Exception: pass
            return (True, "sdcard", None)
    except Exception as e:
        last_exc = e
    try:
        mp = _aw_mirror_path(path)
        if mp:
            if _atomic_same_dir_replace(mp, text):
                return (True, "app_priv", None)
            if not _aw_target_is_precious(mp):
                with open(mp, "w", encoding="utf-8") as f4:
                    f4.write(text); f4.flush()
                    try: os.fsync(f4.fileno())
                    except Exception: pass
                return (True, "app_priv", None)
    except Exception as e:
        last_exc = e
    return (False, None, last_exc)

def _atomic_json_write_impl(path, data, max_len=None, dedup=False, max_items=None, max_bytes=None):
    if not path: return False
    _is_seq = isinstance(data, (list, tuple))
    if max_items is None and _is_seq and max_len is not None:
        max_items = max_len
    if max_bytes is None and (not _is_seq) and max_len is not None:
        max_bytes = max_len
    try:
        if max_items is not None and _is_seq:
            try:
                if len(data) > max_items: data = data[-max_items:]
            except Exception: pass
    except Exception: pass
    try:
        _text = json.dumps(data, ensure_ascii=False)
    except Exception as e0:
        try: _log("atomic write enc err (%s): %s: %s" % (path, type(e0).__name__, e0))
        except Exception: pass
        return False
    if max_bytes is not None and not _is_seq:
        try:
            if len(_text) > max_bytes:
                try: _log("atomic write oversize (%s): %d > %d bytes; skipped (max_bytes)" % (path, len(_text), max_bytes))
                except Exception: pass
                return False
        except Exception: pass
    _vh = None
    if dedup:
        try:
            _vh = hash(_text)
            if _VERDICT_DEDUP.get(path) == _vh:
                return True
        except Exception:
            _vh = None
    try:
        if _VERDICT_NATIVE_OK and _NLIB is not None and _CTYPES_OK and hasattr(_NLIB, "cd_verdict_write"):
            _vb = _text.encode("utf-8")
            _ntmp = path + ".tmp." + str(os.getpid()) + "." + str(threading.get_ident())
            _vrc = int(_NLIB.cd_verdict_write(
                ctypes.c_char_p(_ntmp.encode("utf-8")),
                ctypes.c_char_p(path.encode("utf-8")),
                ctypes.c_char_p(_vb), ctypes.c_int32(len(_vb))))
            if _vrc == 0:
                _aw_log_clear(path)
                if _vh is not None:
                    try: _VERDICT_DEDUP[path] = _vh
                    except Exception: pass
                return True
    except Exception:
        pass
    try:
        tmp = path + ".tmp." + str(os.getpid()) + "." + str(threading.get_ident())
        with open(tmp, "w", encoding="utf-8") as f:
            f.write(_text); f.flush()
            try: os.fsync(f.fileno())
            except Exception: pass
        try:
            os.replace(tmp, path)
        except Exception:
            if _aw_target_is_precious(path):
                try: os.remove(tmp)
                except Exception: pass
                raise
            try:
                with _FALLBACK_IO_LOCK:
                    with open(path, "w", encoding="utf-8") as f2:
                        f2.write(_text); f2.flush()
                        try: os.fsync(f2.fileno())
                        except Exception: pass
            finally:
                try: os.remove(tmp)
                except Exception: pass
        _aw_log_clear(path)
        if _vh is not None:
            try: _VERDICT_DEDUP[path] = _vh
            except Exception: pass
        return True
    except Exception as e1:
        with _FALLBACK_IO_LOCK:
            ok, where, fe = _atomic_write_fallback(path, _text)
        if ok:
            if where == "app_priv":
                _aw_log_once(path, "app_priv", "atomic persist: %s -> app-private mirror (sdcard denied); included in share-logs" % path)
            else:
                _aw_log_clear(path)
            return True
        _aw_log_once(path, "fail", "atomic write err (%s): primary=%s fallback=%s: %s" % (path, type(e1).__name__, (type(fe).__name__ if fe is not None else "n/a"), fe))
        return False

_MOMENT_AUTOCAP_ON = True
_MOMENT_SEEN = {}
_MOMENT_INFLIGHT = set()
_MOMENT_LOCK = threading.Lock()
_MOMENT_SEEN_MAX = 512
_MOMENT_SESSION_MAX = 300
_MOMENT_SESSION_N = 0
_MOMENT_PRE_MS = 8000
_MOMENT_POST_MS = 8000
_MOMENT_MAX_LINES = 800
_MOMENT_MAX_CHARS = 60000
_MOMENT_FRESH_MS = 180000
_MOMENT_FAM_N = {}
_MOMENT_FAM_KEYS = {}
_MOMENT_FAM_KEYS_MAX = 1024
_MOMENT_CHRONIC_SRC = ("pyerr_verdict.json", "hook_verdict.json")
_MOMENT_STALE_MS = 90000
_MOMENT_RATE_S = 45.0
_MOMENT_FAM_TS = {}
_MOMENT_SKIP = ("client_lowmem.json", "client_trim_unavailable.json", "client_lowmem_unavailable.json", "self_overhead.json")
_MOMENT_SRC_MAP = None

_MOMENT_INDEX_NAME = "culprit_moment_index.json"
_MOMENT_INDEX_MAX = 500
_MOMENT_FILES_MAX = 200
_MOMENT_FILES_BYTES = 25 * 1024 * 1024

def _moment_kind(base):
    try:
        b = base or ""
        if "*" in b:
            return b.split("*", 1)[0].rstrip("_")
        m = _moment_src_map()
        for k in m:
            if "*" in k:
                pre = k.split("*", 1)[0]
                if pre and b.startswith(pre):
                    return pre.rstrip("_")
        return b[:-5] if b.endswith(".json") else b
    except Exception:
        return base

def _moment_event_id(base, center_ms, culprit=None):
    try:
        _eid = "%s_%d" % (_moment_kind(base), int(center_ms))
        if culprit:
            try:
                _eid = "%s_%s" % (_eid, hashlib.sha1(str(culprit).encode("utf-8", "replace")).hexdigest()[:6])
            except Exception:
                pass
        return _eid
    except Exception:
        return "%s_%s" % (base, center_ms)

def _moment_event_prefix(base, center_ms):
    try:
        return "%s_%d" % (_moment_kind(base), int(center_ms))
    except Exception:
        return "%s_%s" % (base, center_ms)

def _moment_filename(base, center_ms, culprit=None):
    return "culprit_moment_%s.txt" % _moment_event_id(base, center_ms, culprit)

def _moment_index_path():
    try:
        return os.path.join(_DIR, _MOMENT_INDEX_NAME)
    except Exception:
        return None

def _moment_index_load():
    paths = []
    try: paths.append(_moment_index_path())
    except Exception: pass
    try: paths.append(_aw_mirror_path(_MOMENT_INDEX_NAME))
    except Exception: pass
    for p in paths:
        if not p:
            continue
        try:
            if os.path.exists(p):
                with open(p, "r", encoding="utf-8", errors="replace") as f:
                    d = json.load(f)
                if isinstance(d, dict):
                    return d
        except Exception:
            continue
    return {}

def _moment_index_upsert(event_id, entry):
    if not event_id:
        return
    try:
        with _MOMENT_LOCK:
            idx = _moment_index_load()
            e = dict(entry or {})
            e["event_id"] = event_id
            idx[event_id] = e
            if len(idx) > _MOMENT_INDEX_MAX:
                try:
                    keys = sorted(idx, key=lambda k: idx[k].get("created_ms", 0))
                    for k in keys[:len(idx) - _MOMENT_INDEX_MAX]:
                        idx.pop(k, None)
                except Exception:
                    pass
            p = _moment_index_path()
            if p:
                _atomic_json_write_impl(p, idx)
    except Exception:
        pass


def _moment_prune_files():
    try:
        import glob as _glob2
        dirs = []
        try: dirs.append(_DIR)
        except Exception: pass
        try:
            _md = _app_priv_dir()
            if _md: dirs.append(_md)
        except Exception: pass
        entries = []
        for d in dirs:
            if not d:
                continue
            try:
                for p in _glob2.glob(os.path.join(d, "culprit_moment_*.txt")):
                    try:
                        st = os.stat(p)
                        entries.append((st.st_mtime, st.st_size, p, os.path.basename(p)))
                    except Exception:
                        pass
            except Exception:
                pass
        if not entries:
            return
        entries.sort(key=lambda e: e[0])
        total = sum(e[1] for e in entries)
        n = len(entries)
        removed = set()
        i = 0
        while i < len(entries) and (n > _MOMENT_FILES_MAX or total > _MOMENT_FILES_BYTES):
            _mt, sz, p, bn = entries[i]
            try:
                os.remove(p)
                removed.add(bn)
                n -= 1
                total -= sz
            except Exception:
                pass
            i += 1
        if removed:
            try:
                with _MOMENT_LOCK:
                    idx = _moment_index_load()
                    ch = False
                    for k in list(idx.keys()):
                        try:
                            f = idx.get(k, {}).get("file")
                            if f and os.path.basename(f) in removed:
                                idx.pop(k, None); ch = True
                        except Exception:
                            pass
                    if ch:
                        _ip = _moment_index_path()
                        if _ip:
                            _atomic_json_write_impl(_ip, idx)
            except Exception:
                pass
    except Exception:
        pass

def _moment_file_exists(path):
    try:
        if os.path.exists(path): return True
    except Exception:
        pass
    try:
        mp = _aw_mirror_path(path)
        return bool(mp and os.path.exists(mp))
    except Exception:
        return False

def _moment_find_existing_path(base, center_ms, culprit=None):

    cands = []
    prefix = None
    try:
        prefix = _moment_event_prefix(base, center_ms)
    except Exception:
        prefix = None
    if culprit:
        try:
            cands.append(_moment_filename(base, center_ms, culprit))
        except Exception:
            pass
    try:
        if prefix:
            idx = _moment_index_load()
            for k in sorted(idx, key=lambda x: idx.get(x, {}).get("created_ms", 0)):
                if k == prefix or k.startswith(prefix + "_"):
                    f = idx.get(k, {}).get("file")
                    if f:
                        cands.append(f)
    except Exception:
        pass
    try:
        if prefix:
            cands.append("culprit_moment_%s.txt" % prefix)
    except Exception:
        pass
    for fn in cands:
        if not fn:
            continue
        try:
            p1 = os.path.join(_DIR, fn)
            if os.path.exists(p1):
                return p1
        except Exception:
            pass
        try:
            mp = _aw_mirror_path(fn)
            if mp and os.path.exists(mp):
                return mp
        except Exception:
            pass
    return None


def _moment_src_map():
    global _MOMENT_SRC_MAP
    if _MOMENT_SRC_MAP is not None:
        return _MOMENT_SRC_MAP
    m = {}
    try:
        for src in _UI_VERDICT_SOURCES:
            try:
                fn, label, emoji, what, gate = src
                m[fn] = (label, emoji, what, gate)
            except Exception:
                pass
    except Exception:
        m = {}
    _MOMENT_SRC_MAP = m
    return m

def _restart_kind(rec):
    """Classification only, never a native exit permit. Legacy records are read-only."""
    if not isinstance(rec, dict): return None
    if rec.get("benign_restart") is True: return "benign"
    if rec.get("self_kill") is not True or rec.get("programmatic_restart") is not True: return None
    if rec.get("kill_method") not in ("System.exit", "Runtime.exit", "Runtime.halt", "system_exit", "exit", "_exit", "_Exit"):
        return None
    arg = rec.get("kill_arg")
    if isinstance(arg, bool): return None
    try:
        if arg is None or float(arg) != 0: return None
    except Exception: return None
    return "programmatic"


def _restart_matches_exit(rec, code, status, exit_ts):
    if not _restart_kind(rec) or rec.get("self_kill") is not True: return False
    try:
        delta = int(exit_ts) - int(rec.get("ts") or 0)
        if int(rec.get("ts") or 0) <= 0 or not (-_B34_WIN_SKEW_MS <= delta <= 15000): return False
        if code == 1: return int(rec.get("kill_arg")) == int(status)
        return code == 2 and int(status) == 9 and "killProcess" in str(rec.get("kill_method") or "")
    except Exception: return False


def _restart_permit_matches_exit(context, prev, code, status, exit_pid, exit_ts):
    """Fresh permit + matching session + actual EXIT_SELF(0); permit alone proves nothing."""
    try:
        if code != 1 or int(status) != 0 or not isinstance(context, dict) or not isinstance(prev, dict): return False
        permit, boot = context["permit"], context["boot"]
        pid = int(exit_pid)
        if pid <= 0 or pid != int(prev["pid"]) or pid != int(permit["pid"]) or pid != int(boot["pid"]): return False
        if int(permit["type"]) != _JEV_RESTART_PERMIT or int(boot["type"]) != _JEV_BOOT: return False
        if int(permit["pstart"]) <= 0 or int(permit["pstart"]) != int(boot["pstart"]): return False
        pts, bts, ets = int(permit["ts"]), int(boot["ts"]), int(exit_ts)
        if not (bts > 0 and pts >= bts and pts >= int(prev["ts"]) - _B34_WIN_SKEW_MS): return False
        return 0 <= ets - pts <= 4000
    except Exception: return False


def _normalize_restart_record(rec):
    kind = _restart_kind(rec)
    if kind:
        rec["had_crash"] = False
        rec["restart_classification"] = kind
        rec["event_type"] = "intentional_restart" if kind == "benign" else "programmatic_exit"
        rec["dropbox_tag"] = rec["event_type"]
        rec["attribution"] = False
    return rec


def _event_presentation(rec, base):
    """Shared card/moment projection. Does not rewrite evidence or legacy files."""
    if not isinstance(rec, dict): return {}
    if base in ("crash_verdict.json", "crash_verdict_persisted.json"):
        kind = _restart_kind(rec)
        if kind == "benign": return {"omit": True}
        if kind == "programmatic":
            return {"label": "ПРОГРАММНЫЙ ВЫХОД", "emoji": "↪️", "actor_label": "Инициатор: %s",
                "what": "Программный выход; не доказательство сбоя", "reason": _cd_tr("Программный exit(0); намерение restart указано, результат запуска не подтверждён"),
                "alert_level": "info", "category": "other", "attribution": False}
    if base.startswith("oom_dump"):
        vd = rec.get("verdict") if isinstance(rec.get("verdict"), dict) else {}
        if rec.get("event_type") == "init_alloc_burst" or vd.get("severity") == "init_burst":
            return {"label": "ВСПЛЕСК ПАМЯТИ ПРИ ЗАГРУЗКЕ", "emoji": "📊", "actor_label": "Наблюдаемый модуль: %s",
                "what": "Разовый рост выделений; OOM и утечка не доказаны",
                "reason": _cd_tr("Всплеск выделений при загрузке; OOM и утечка не доказаны"),
                "alert_level": "info", "category": "mem", "attribution": False}
    if base == "client_objects_leak.json" and not rec.get("leak_confirmed"):
        return {"label": "ПОДОЗРЕНИЕ НА УДЕРЖАНИЕ ОБЪЕКТОВ", "emoji": "🧩",
            "actor_label": "Место наблюдения: %s", "culprit": rec.get("culprit") or "client (host process)",
            "what": "Рост/превышение порога экземпляров, не доказательство причины утечки",
            "reason": _cd_tr("Наблюдение: %s · %s → %s · GC-root и владелец не установлены") % (rec.get("leak_class") or "?", rec.get("first", "?"), rec.get("last", "?")),
            "alert_level": "warning", "category": "mem", "attribution": False}
    if base == "queue_retention_verdict.json":
        proved = rec.get("evidence_status") == "reschedule_proven" and bool((rec.get("proof") or {}).get("edge_evidence_usable"))
        return {"label": "ПЕРЕПЛАНИРОВАНИЕ ЗАКРЫТОГО ЭКРАНА" if proved else "УДЕРЖАНИЕ ЗАКРЫТОГО ЭКРАНА В ОЧЕРЕДИ",
            "emoji": "🧷", "actor_label": "Место наблюдения: %s", "culprit": rec.get("callback_class") or "undetermined",
            "what": "Очередь удерживает закрытый экран; причина краша не установлена",
            "reason": _cd_tr(rec.get("reason") or ""), "alert_level": "warning", "category": "mem", "attribution": False}
    if base == "nc_observers_leak.json":
        return {"label": "РОСТ РЕГИСТРАЦИЙ NotificationCenter", "emoji": "📡", "actor_label": "Причина: %s",
            "culprit": "undetermined", "confidence": "low", "what": "Подозрительный рост регистраций; причина не установлена",
            "reason": _cd_tr("Регистрации %s: %s → %s; не число уникальных объектов, GC-root и причина не установлены") % (rec.get("leak_class") or "?", rec.get("first", "?"), rec.get("last", "?")),
            "alert_level": "warning", "category": "mem", "attribution": False}
    return {}


def _moment_project_header(body, card):
    """Project legacy capture headers in memory; never modify historical log files."""
    if not isinstance(body, str) or not isinstance(card, dict): return body
    lines = body.splitlines()
    if len(lines) < 3 or not lines[0].startswith("Culprit Detector"):
        return body
    lines[1] = "%s %s" % (card.get("emoji", ""), card.get("label", "-"))
    lines[2] = _cd_tr(card.get("actor_label", "Виноват: %s")) % card.get("culprit", "?")
    return "\n".join(lines)


def _moment_meta_for(base):
    m = _moment_src_map()
    if base in m:
        return m[base]
    for k, v in m.items():
        if "*" in k:
            pre = k.split("*", 1)[0]
            if pre and base.startswith(pre):
                return v
    return None

def _moment_center_ms(d):
    def _coerce(ts):
        try:
            if isinstance(ts, (int, float)):
                return int(ts if ts > 1e11 else ts * 1000.0)
            if isinstance(ts, str) and ts:
                import time as _t2
                if "-" in ts and ":" in ts:
                    return int(_t2.mktime(_t2.strptime(ts, "%Y-%m-%d %H:%M:%S")) * 1000.0)
                f = float(ts)
                return int(f if f > 1e11 else f * 1000.0)
        except Exception:
            return None
        return None
    _c = _coerce(d.get("event_ts"))
    if _c is not None:
        return _c
    _c = _coerce(d.get("exit_ts"))
    if _c is not None:
        return _c
    _tb = d.get("tombstone_debuggerd")
    if isinstance(_tb, dict):
        _c = _coerce(_tb.get("event_ts") or _tb.get("logcat_ts"))
        if _c is not None:
            return _c
    for _src in ("crash_ts", "ts"):
        _c = _coerce(d.get(_src))
        if _c is not None:
            return _c
    return None

def _moment_culprit(d):
    try:
        c = (d.get("culprit") or d.get("crashed_plugin_id") or d.get("pid")
             or d.get("plugin") or d.get("py_module") or d.get("scoped_pid") or d.get("owner"))
        ck = d.get("culprit_kind")
        if not c and isinstance(ck, str):
            if ck.startswith("plugin:"):
                c = ck.split(":", 1)[1]
            elif ck == "host":
                c = d.get("host_so_owner") or "host"
        if not c:
            for _sub in ("verdict", "gref"):
                try:
                    _sv = d.get(_sub)
                    if isinstance(_sv, dict):
                        _cc = _sv.get("culprit") or _sv.get("owner")
                        if _cc:
                            c = _cc; break
                except Exception:
                    pass
        if not c:
            try:
                _ops = d.get("op_stamps")
                if isinstance(_ops, dict) and _ops:
                    _best = None
                    for _st in _ops.values():
                        if not isinstance(_st, dict): continue
                        _ow = _st.get("owner"); _ag = _st.get("age_ms")
                        if isinstance(_ow, str) and _ow.startswith("#") and _ow[1:].isdigit():
                            _nm = _resolve_idx(int(_ow[1:]))
                            if not (isinstance(_nm, str) and _nm):
                                _nm = _resolve_idx_durable(int(_ow[1:]))
                            _ow = _nm if (isinstance(_nm, str) and _nm) else ""
                        if not _ow or _ow == _SELF_ID or _ow == __id__: continue
                        if _ag is None or _ag < 0 or _ag > _GPU_OP_WINDOW_MS: continue
                        if _best is None or _ag < _best[0]: _best = (_ag, _ow)
                    if _best is not None: c = _best[1]
            except Exception:
                pass
        if not c:
            _ao = d.get("anr_owner")
            c = _ao if not isinstance(_ao, int) else (_ao if _ao >= 0 else None)
        if not c:
            try:
                _oi = int(d.get("owner_idx", -1))
                if _oi >= 0: c = _resolve_idx_durable(_oi)
            except Exception:
                pass
        try:
            if isinstance(c, bool):
                c = None
            elif isinstance(c, (int, float)) and int(c) < 0:
                c = None
            elif isinstance(c, str) and c.strip().lstrip("-").isdigit() and int(c.strip()) < 0:
                c = None
        except Exception:
            pass
        s = str(c).strip() if c else ""
        if "/" in s:
            s = s.rsplit("/", 1)[1]
        if s.endswith(".py"):
            s = s[:-3]
        if not s and d.get("hook_involved"):
            return "хук плагина (не определён)"
        return s or "не определён"
    except Exception:
        return "?"

def _moment_when(center_ms):
    try:
        return time.strftime("%d.%m %H:%M", time.localtime(center_ms / 1000.0))
    except Exception:
        return "-"

def _moment_is_tombstone_dump(lines, min_share=0.7):
    if not lines:
        return False
    _n = 0; _tot = 0
    for ln in lines:
        if not ln.strip():
            continue
        _tot += 1
        if (" F DEBUG " in ln) or (" F libc " in ln) or ("*** *** ***" in ln) or ("beginning of crash" in ln):
            _n += 1
    return _tot > 0 and (float(_n) / float(_tot)) >= min_share

def _moment_is_noise(ln):
    try:
        if "HWUI" in ln and "Image decoding logging dropped" in ln: return True
        if "Choreographer" in ln and "Skipped " in ln and "frames" in ln: return True
    except Exception:
        pass
    return False

def _moment_read_and_slice(center, pre_ms, post_ms, max_lines, max_chars):
    texts = []
    try:
        texts = _b28_read_logcat(prefilter=False)
    except Exception as e:
        try: _log("moment: logcat read err: %s" % e)
        except Exception: pass
    picked = []; total = 0; keep = False; _noise_supp = 0; matched_window = False
    _line_seen = 0; _ts_seen = 0; _newest_ts = None
    for blob in texts:
        for ln in blob.split("\n"):
            if ln.strip(): _line_seen += 1
            ets = _b28_logcat_event_ts(ln)
            if ets is not None:
                _ts_seen += 1
                if _newest_ts is None or ets > _newest_ts: _newest_ts = ets
                keep = (center is not None) and (-pre_ms <= (ets - center) <= post_ms)
            if keep:
                matched_window = True
                if _moment_is_noise(ln):
                    _noise_supp += 1; continue
                picked.append(ln); total += len(ln) + 1
                if len(picked) >= max_lines or total >= max_chars: break
        if len(picked) >= max_lines or total >= max_chars: break
    sealed = (_line_seen > 0 and _ts_seen == 0)
    stale = ((not picked) and _ts_seen > 0 and center is not None and _newest_ts is not None and (center - _newest_ts) > _MOMENT_STALE_MS)
    tail_mode = False
    _all_noise = False
    if not picked and matched_window:
        _all_noise = True
        picked = ["        … [+KP3] все строки окна были шумом HWUI/Choreographer: %d" % _noise_supp]
    if not picked:
        tail_mode = True
        allln = []
        for blob in texts:
            allln.extend(blob.split("\n"))
        picked = allln[-300:]
    if picked and not tail_mode and not _all_noise and _noise_supp > 0:
        picked.append("        … [+KP3] отфильтровано %d шумовых строк (HWUI/Choreographer) до лимита max_lines" % _noise_supp)
    return picked, tail_mode, sealed, stale

def _moment_atomic_text_write(target, body):
    _tmp = target + ".tmp." + str(os.getpid()) + "." + str(threading.get_ident())
    try:
        with open(_tmp, "w", encoding="utf-8", errors="replace") as f:
            f.write(body)
        os.replace(_tmp, target)
        return True
    except Exception:
        try: os.remove(_tmp)
        except Exception: pass
    return False

def _moment_write_text(target, body):
    if _moment_atomic_text_write(target, body):
        return True
    try:
        mp = _aw_mirror_path(target)
        if mp and _moment_atomic_text_write(mp, body):
            return True
    except Exception:
        pass
    return False

def _breadcrumb_slice(center_ms, pre_ms, post_ms, max_lines=400):
    path = _LOG_PATH
    if not path:
        return []
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as f:
            _lines = f.read().splitlines()
    except Exception:
        return []
    try:
        _lt = time.localtime(center_ms / 1000.0)
        _midnight = center_ms - ((_lt.tm_hour * 3600 + _lt.tm_min * 60 + _lt.tm_sec) * 1000) - (center_ms % 1000)
    except Exception:
        return []
    out = []
    for ln in _lines:
        if len(ln) < 10 or ln[0] != "[" or ln[3] != ":" or ln[6] != ":" or ln[9] != "]":
            continue
        try:
            _hh = int(ln[1:3]); _mm = int(ln[4:6]); _ss = int(ln[7:9])
        except Exception:
            continue
        ets = _midnight + (_hh * 3600 + _mm * 60 + _ss) * 1000
        d = ets - center_ms
        if d > post_ms + 43200000:
            ets -= 86400000; d = ets - center_ms
        elif d < -(pre_ms + 43200000):
            ets += 86400000; d = ets - center_ms
        if -pre_ms <= d <= post_ms:
            out.append(ln)
            if len(out) >= max_lines:
                break
    return out


_FILELOG_MAX_LINES = 140
_FILELOG_MAX_CHARS = 14000
_FILELOG_DIR_CACHE = None

def _filelog_dir():
    global _FILELOG_DIR_CACHE
    if _FILELOG_DIR_CACHE is not None:
        return _FILELOG_DIR_CACHE or None
    cand = []
    try:
        _au = jclass("org.telegram.messenger.AndroidUtilities")
        _d = _au.getLogsDir()
        if _d is not None:
            cand.append(_d.getAbsolutePath())
    except Exception:
        pass
    try:
        _ctx = jclass("org.telegram.messenger.ApplicationLoader").applicationContext
        try:
            _ext = _ctx.getExternalFilesDir(None)
            if _ext is not None:
                cand.append(File(_ext, "logs").getAbsolutePath())
        except Exception:
            pass
        try:
            cand.append(File(_ctx.getFilesDir(), "logs").getAbsolutePath())
        except Exception:
            pass
    except Exception:
        pass
    for _p in cand:
        try:
            if _p and os.path.isdir(_p):
                _FILELOG_DIR_CACHE = _p
                return _p
        except Exception:
            pass
    _FILELOG_DIR_CACHE = ""
    return None

def _filelog_pick_file(center_ms, dirp):
    best = None; best_d = None
    try:
        for _name in os.listdir(dirp):
            if not _name.endswith(".txt"):
                continue
            _fp = os.path.join(dirp, _name)
            try:
                _mt = os.path.getmtime(_fp) * 1000.0
            except Exception:
                continue
            _dd = abs(_mt - center_ms)
            if best is None or _dd < best_d:
                best = _fp; best_d = _dd
    except Exception:
        return None
    return best

def _filelog_slice(center_ms, max_lines=_FILELOG_MAX_LINES, max_chars=_FILELOG_MAX_CHARS):
    _dirp = _filelog_dir()
    if not _dirp:
        return []
    _fp = _filelog_pick_file(center_ms, _dirp)
    if not _fp:
        return []
    try:
        _sz = os.path.getsize(_fp)
        with open(_fp, "rb") as _f:
            if _sz > max_chars:
                _f.seek(_sz - max_chars)
            _raw = _f.read()
        _lines = _raw.decode("utf-8", "replace").splitlines()
        if _sz > max_chars and _lines:
            _lines = _lines[1:]
        if len(_lines) > max_lines:
            _lines = _lines[-max_lines:]
        return _lines
    except Exception:
        return []




def _filelog_meaningful(lines):
    for _ln in (lines or []):
        _s = _ln.strip()
        if not _s:
            continue
        if _s.startswith("-----") and ("log" in _s.lower()):
            continue
        if set(_s) <= set("-"):
            continue
        return True
    return False


_PW_RUNTIME_BARE_SO = frozenset(("libc.so", "libm.so", "libdl.so", "libart.so", "libc++.so", "liblog.so", "libbase.so", "libutils.so", "libbinder.so", "libhwui.so", "libandroid.so", "libandroid_runtime.so", "libjavacore.so", "libopenjdk.so", "libnativehelper.so", "linker64", "linker", "libculprit.so"))
_HZ_FB_KEYS = ("event_type", "reason", "where", "confidence", "src", "culprit_kind", "stalled_ms", "trim_level", "throws_per_min", "throws_in_window", "exc_cls", "exc_msg", "cause", "top_so", "signo", "py_file", "py_line", "symbol")


def _hz_moment_fallback(rec):
    out = [_cd_tr("(logcat пуст — снимок из вердикта)")]
    if not isinstance(rec, dict):
        return out
    for _k in _HZ_FB_KEYS:
        _v = rec.get(_k)
        if _v is not None and _v != "" and _v != -1:
            out.append("%s=%s" % (_k, _v))
    _vd = rec.get("verdict")
    if isinstance(_vd, dict):
        for _k in ("culprit", "top_named", "culprit_bytes", "top_named_bytes"):
            _vv = _vd.get(_k)
            if _vv is not None and _vv != "":
                out.append("verdict.%s=%s" % (_k, _vv))
    _mem = rec.get("mem")
    if isinstance(_mem, dict) and _mem.get("pct") is not None:
        out.append("mem.pct=%s used=%s limit=%s" % (_mem.get("pct"), _mem.get("used"), _mem.get("limit")))
    _top = rec.get("top")
    if isinstance(_top, list) and _top:
        out.append("top_alloc:")
        for _e in _top[:6]:
            try:
                out.append("  %s=%s" % (_e[0], _e[1]))
            except Exception:
                out.append("  %s" % (_e,))
    _st = rec.get("stack")
    if isinstance(_st, list) and _st:
        out.append("stack:")
        for _s in _st[:12]:
            out.append("  %s" % (_s,))
    _ct = rec.get("cpu_top")
    if isinstance(_ct, list) and _ct:
        out.append("cpu_top:")
        for _t in _ct[:8]:
            try:
                out.append("  %s %.1f%% owner=%s" % (_t.get("name"), float(_t.get("pct") or 0), _t.get("owner")))
            except Exception:
                out.append("  %s" % (_t,))
    return out


_MOMENT_DEDUP_MIN_RUN = 3

def _moment_logline_key(ln):
    try:
        parts = ln.split(None, 5)
        if (len(parts) >= 6 and len(parts[0]) == 5 and parts[0][2] == "-"
                and ":" in parts[1] and parts[2].isdigit() and parts[3].isdigit()
                and len(parts[4]) == 1):
            return parts[4] + " " + parts[5]
    except Exception:
        pass
    return ln.strip()

def _moment_dedup_lines(lines, min_run=None):
    if min_run is None:
        min_run = _MOMENT_DEDUP_MIN_RUN
    out = []; removed = 0
    i = 0; n = len(lines)
    while i < n:
        key = _moment_logline_key(lines[i])
        j = i + 1
        while j < n and _moment_logline_key(lines[j]) == key:
            j += 1
        run = j - i
        if run >= min_run:
            out.append(lines[i])
            out.append("        … ×%d (dedup: %s)" % (run, key[:80]))
            removed += run - 2
        else:
            out.extend(lines[i:j])
        i = j
    return out, removed


def _moment_capture_worker(key, base, label, emoji, culprit, center, rec=None):
    global _MOMENT_SESSION_N
    _ok = False
    try:
        _view = _event_presentation(rec, base)
        if _view.get("omit"): return
        label, emoji = _view.get("label", label), _view.get("emoji", emoji)
        culprit = _view.get("culprit", culprit)
        fn = _moment_filename(base, center, culprit)
        target = os.path.join(_DIR, fn)
        event_id = _moment_event_id(base, center, culprit)
        if _moment_file_exists(target):
            _moment_index_upsert(event_id, {"file": fn, "source": base, "culprit": culprit, "label": label, "center_ms": int(center), "created_ms": int(time.time() * 1000)})
            _ok = True
            return
        picked, tail, _iw_sealed, _iy_stale = _moment_read_and_slice(center, _MOMENT_PRE_MS, _MOMENT_POST_MS,
                                              _MOMENT_MAX_LINES, _MOMENT_MAX_CHARS)
        _kz_retry = False
        if _iy_stale:
            try:
                time.sleep(0.35)
                _p2, _t2, _s2, _st2 = _moment_read_and_slice(center, _MOMENT_PRE_MS, _MOMENT_POST_MS,
                                                             _MOMENT_MAX_LINES, _MOMENT_MAX_CHARS)
                if not _st2:
                    picked, tail, _iw_sealed, _iy_stale = _p2, _t2, _s2, _st2
                    _kz_retry = True
            except Exception:
                pass
        head = ["Culprit Detector — %s" % _cd_tr("логи момента"),
                "%s %s" % (emoji or "", _cd_tr(label) or "-"),
                _cd_tr(_view.get("actor_label", "Виноват: %s")) % culprit,
                _cd_tr("Когда: %s") % _moment_when(center),
                "crash_ts=%d  window=-%dms/+%dms" % (center, _MOMENT_PRE_MS, _MOMENT_POST_MS),
                "event_id=%s  source=%s" % (event_id, base)]
        _hz_empty = not picked
        _iy_tomb = (tail and (not _hz_empty) and _moment_is_tombstone_dump(picked))
        _use_fb = _hz_empty or _iw_sealed or _iy_stale or _iy_tomb
        try:
            _MOMENT_FAM_TS[(base, culprit)] = (time.time(), bool(_use_fb))
        except Exception:
            pass
        if tail and not _use_fb:
            head.append(_cd_tr("(точное время не найдено — показан хвост logcat)"))
        head.append("[+HV auto-capture @ confirm]")
        if _hz_empty:
            head.append("[+HZ] logcat ring empty (lines=0) - verdict fallback")
        if _iw_sealed:
            head.append("[+IW] logcat sealed by host ((HKS)..(HKE), no threadtime) - verdict+breadcrumb fallback")
        if _iy_stale:
            head.append("[+IY] logcat stale (newest ts older than window) - verdict+breadcrumb fallback")
        if _kz_retry:
            head.append("[+KZ(3)] logcat was stale -> live re-read OK")
        if _iy_tomb:
            head.append("[+IY] logcat tail is tombstone/crash-buffer dump - verdict+breadcrumb fallback")
        _dd_lines = picked; _dd_removed = 0
        if picked and not _use_fb:
            try:
                _dd_lines, _dd_removed = _moment_dedup_lines(picked)
            except Exception:
                _dd_lines = picked; _dd_removed = 0
            if _dd_removed > 0:
                head.append("[+IX] dedup: свёрнуто %d повторяющихся строк (анти-спам)" % _dd_removed)
        head.append("=" * 60)
        _hz_body_lines = _hz_moment_fallback(rec) if _use_fb else _dd_lines
        if _use_fb:
            _iw_bc = _breadcrumb_slice(center, _MOMENT_PRE_MS, _MOMENT_POST_MS)
            if _iw_bc:
                _hz_body_lines = list(_hz_body_lines) + ["", "breadcrumb (+/-window):"] + _iw_bc
        if base in ("native_crash_verdict.json", "native_crash_history.json") and isinstance(rec, dict):
            _hz_body_lines = list(_hz_body_lines) + _native_crash_moment_evidence(rec)
        try:
            _fl = _filelog_slice(center)
        except Exception:
            _fl = []
        _fl_has = _filelog_meaningful(_fl)
        _fl_found_empty = bool(_fl) and not _fl_has
        if _fl_has:
            _hz_body_lines = list(_hz_body_lines) + ["", "client FileLog (unfiltered tail; outside event window possible, +PR):"] + _fl
        body = "\n".join(head) + "\n" + "\n".join(_hz_body_lines)
        if _moment_write_text(target, body):
            _ok = True
            _moment_index_upsert(event_id, {"file": fn, "source": base, "culprit": culprit, "label": label, "center_ms": int(center), "created_ms": int(time.time() * 1000), "lines": len(picked), "tail": bool(tail), "empty": bool(_hz_empty), "fallback": bool(_use_fb), "sealed": bool(_iw_sealed), "filelog": bool(_fl_has), "filelog_empty": bool(_fl_found_empty)})
            try: _moment_prune_files()
            except Exception: pass
            try: _log("+HV: auto-moment -> %s (lines=%d%s)" % (fn, len(picked), ", tail" if tail else ""))
            except Exception: pass
    except Exception as e:
        try: _log("+HV moment worker err: %s" % e)
        except Exception: pass
    finally:
        with _MOMENT_LOCK:
            _MOMENT_INFLIGHT.discard(key)
            if _ok:
                try:
                    _MOMENT_SEEN[key] = time.time()
                    if len(_MOMENT_SEEN) > _MOMENT_SEEN_MAX:
                        for _k in sorted(_MOMENT_SEEN, key=lambda x: _MOMENT_SEEN[x])[:len(_MOMENT_SEEN) - _MOMENT_SEEN_MAX]:
                            _MOMENT_SEEN.pop(_k, None)
                except Exception:
                    pass
            else:
                try:
                    if _MOMENT_SESSION_N > 0: _MOMENT_SESSION_N -= 1
                except Exception:
                    pass

def _moment_autocap(path, data):
    global _MOMENT_SESSION_N
    if not _MOMENT_AUTOCAP_ON:
        return
    try:
        base = os.path.basename(path or "")
        if not base or not base.endswith(".json"):
            return
        if base in _MOMENT_SKIP:
            return
        meta = _moment_meta_for(base)
        if not meta:
            return
        label, emoji, _, gate = meta
        now_ms = time.time() * 1000.0
        items = data if isinstance(data, list) else [data]
        for it in items:
            try:
                if not isinstance(it, dict):
                    continue
                if _restart_kind(it) == "benign":
                    continue
                if bool(it.get("repeat_suppressed")) and not bool(it.get("repeat_sample")):
                    continue
                if gate and not any(bool(it.get(g)) for g in gate):
                    continue
                ck = it.get("culprit_kind")
                is_native = base in ("native_crash_verdict.json", "native_crash_history.json")
                if isinstance(ck, str) and ck == "system" and not is_native:
                    continue
                center = _moment_center_ms(it)
                if not center:
                    continue
                if center > now_ms + 5000.0 or (now_ms - center) > _MOMENT_FRESH_MS:
                    continue
                _view = _event_presentation(it, base)
                if _view.get("omit"): continue
                label, emoji = _view.get("label", meta[0]), _view.get("emoji", meta[1])
                culprit = _view.get("culprit", _moment_culprit(it))
                key = _moment_event_id(base, center, culprit)
                try:
                    _ft, _ffb = _MOMENT_FAM_TS.get((base, culprit), (0.0, False))
                    if _ffb and (time.time() - _ft) < _MOMENT_RATE_S and base not in ("native_crash_verdict.json", "native_crash_history.json"):
                        continue
                except Exception:
                    pass
                with _MOMENT_LOCK:
                    if key in _MOMENT_SEEN or key in _MOMENT_INFLIGHT:
                        continue
                    if base in _MOMENT_CHRONIC_SRC:
                        try:
                            _famc = culprit or ("%s|%s|%s|%s" % (it.get("exc_cls"), it.get("where"), it.get("py_file"), it.get("py_line")))
                            _sel = _MOMENT_FAM_KEYS.get(key)
                            if _sel is None:
                                _fam_n = _MOMENT_FAM_N.get((base, _famc), 0) + 1
                                _MOMENT_FAM_N[(base, _famc)] = _fam_n
                                _sel = not (_fam_n > 2 and (_fam_n & (_fam_n - 1)) != 0)
                                _MOMENT_FAM_KEYS[key] = _sel
                                if len(_MOMENT_FAM_KEYS) > _MOMENT_FAM_KEYS_MAX:
                                    for _fk in list(_MOMENT_FAM_KEYS)[:len(_MOMENT_FAM_KEYS) - _MOMENT_FAM_KEYS_MAX]:
                                        _MOMENT_FAM_KEYS.pop(_fk, None)
                            if not _sel:
                                continue
                        except Exception:
                            pass
                    if _MOMENT_SESSION_N >= _MOMENT_SESSION_MAX:
                        continue
                    _MOMENT_INFLIGHT.add(key)
                    _MOMENT_SESSION_N += 1
                try:
                    threading.Thread(target=_moment_capture_worker,
                                     args=(key, base, label, emoji, culprit, center, it),
                                     name="culprit-moment", daemon=True).start()
                except Exception:
                    with _MOMENT_LOCK:
                        _MOMENT_INFLIGHT.discard(key)
            except Exception:
                continue
    except Exception:
        pass

def _extras_real_path(p):
    try:
        if os.path.exists(p):
            return p
    except Exception:
        pass
    try:
        mp = _aw_mirror_path(p)
        if mp and os.path.exists(mp):
            return mp
    except Exception:
        pass
    return None

def _send_logs_collect(base_path, mirror_paths):
                                                                           
                                                                          
                                                                              
    import stat
    entries, skipped, positions = [], [], {}
    byte_total, visited = 0, 0
    limits = dict(max_files=4096, max_file_bytes=32*1024*1024, max_total_bytes=128*1024*1024, max_depth=12, max_entries=16384)
    def skip(name, reason):
        if len(skipped) < 256:
            skipped.append(dict(path=name, reason=reason))
    def add(path, name, mirror=False):
        nonlocal byte_total
        try:
            st = os.lstat(path)
            if not stat.S_ISREG(st.st_mode):
                skip(name, "not_regular"); return
            if st.st_size == 0:
                return
            if st.st_size > limits["max_file_bytes"]:
                skip(name, "file_size_cap"); return
            previous = positions.get(name)
            old_size = 0
            if previous is not None:
                old = entries[previous]
                if not mirror or st.st_mtime_ns <= old[2]:
                    return
                old_size = old[3]
            if (previous is None and len(entries) >= limits["max_files"]) or byte_total-old_size+st.st_size > limits["max_total_bytes"]:
                skip(name, "archive_cap"); return
            item = (path, name, st.st_mtime_ns, st.st_size)
            if previous is None:
                positions[name] = len(entries); entries.append(item)
            else:
                entries[previous] = item
            byte_total += st.st_size-old_size
        except Exception as exc:
            skip(name, "stat:"+type(exc).__name__)
    def excluded(name):
        return (name in ("archive_export_coverage.json", "archive_export_result.json") or name.startswith(_SELF_BACKUP_NAME) or _aw_atomic_tmp_parse(name) is not None
                or name.endswith((".snap", ".stage")))
    def walk(root, prefix="", mirror=False):
        nonlocal visited
        pending = [(root, prefix, 0)]
        while pending:
            parent, rel, depth = pending.pop()
            try:
                with os.scandir(parent) as children:
                    for child in children:
                        visited += 1
                        if visited > limits["max_entries"]:
                            skip(rel, "entry_cap"); return
                        name = str(child.name)
                        arc = rel+name
                        if excluded(name):
                            continue
                        if child.is_symlink():
                            skip(arc, "symlink"); continue
                        if child.is_dir(follow_symlinks=False):
                            if depth >= limits["max_depth"]:
                                skip(arc, "depth_cap")
                            else:
                                pending.append((child.path, arc+"/", depth+1))
                        else:
                            add(child.path, arc, mirror)
            except Exception as exc:
                skip(rel, "list:"+type(exc).__name__)
    root = os.path.realpath(str(base_path))
    if os.path.isdir(root):
        walk(root)
    for path in mirror_paths or ():
        name = os.path.basename(str(path))
        if not excluded(name):
            add(str(path), name, True)
    private = _app_priv_dir()
    if private and os.path.realpath(str(private)) != root:
                                                                              
        private = os.path.realpath(str(private))
        for name in ("uab_targeted_tests", "culprit_targeted_artifacts", "PersistenceRetryTester", "pw_tester_sandbox"):
            path = os.path.join(private, name)
            if os.path.islink(path):
                skip(name, "symlink")
            elif os.path.isdir(path):
                walk(path, name+"/", True)
    return entries, dict(limits=limits, selected_files=len(entries), selected_bytes=byte_total,
        scanned_entries=visited, skipped=skipped, skipped_list_truncated=len(skipped)>=256,
        snapshot_atomic=False, scope="detector folder and known detector-private tester subtrees")

def _send_logs_extras(names):

    out = []
    _errs = []
    try: _aw_cleanup_stale_tmp()
    except Exception: pass
    try:
        texts = []
        try:
            texts = _b28_read_logcat(prefilter=False)
        except Exception as e:
            _errs.append("logcat_read: %s" % e)
        allln = []
        for blob in (texts or []):
            allln.extend(blob.split("\n"))
        tail = allln[-1200:]
        body = ("Culprit Detector send-logs current logcat\ncaptured=%s\nlines=%d\n%s\n" %
                (time.strftime("%Y-%m-%d %H:%M:%S", time.localtime()), len(tail), "=" * 60)) + "\n".join(tail)
        _p = os.path.join(_DIR, "send_logs_current_logcat.txt")
        if _moment_write_text(_p, body):
            _rp = _extras_real_path(_p)
            if _rp:
                out.append(_rp)
    except Exception as e:
        _errs.append("current_logcat: %s" % e)
    try:
        nm2 = list(names or [])
        nm2.append("send_logs_current_logcat.txt")
        nm2.append("archive_manifest.json")
        seen = set(); nmu = []
        for x in nm2:
            if _aw_atomic_tmp_parse(x) is not None:
                continue
            if x not in seen:
                seen.add(x); nmu.append(x)
        moment = [x for x in nmu if x.startswith("culprit_moment_") and x.endswith(".txt")]
        _man_verdict_exact = ("client_leak.json", "client_lowmem.json", "client_oom_killed.json",
                              "hook_exception_flood.json", "native_crash_history.json",
                              "client_objects_leak.json", "nc_observers_leak.json", "queue_retention_verdict.json")
        verdict = [x for x in nmu if x.endswith(".json") and ("verdict" in x
                   or x.startswith(("oom_dump", "b23_bitmap_oom")) or x in _man_verdict_exact)]
        native = {
            "abi_expect": _SO_ABI_EXPECT,
            "native_ok": bool(_NATIVE_OK),
            "oom": bool(_OOM_NATIVE_OK), "anr": bool(_ANR_NATIVE_OK),
            "gref": bool(_GREF_NATIVE_OK), "smaps": bool(_SMAPS_NATIVE_OK),
        }
        try:
            if _NLIB is not None and hasattr(_NLIB, "cd_tracer_report_failures_total"):
                native["tracer_report_io"] = {
                    "scope": "current_native_instance",
                    "failures": int(_NLIB.cd_tracer_report_failures_total()),
                    "last_errno": int(_NLIB.cd_tracer_report_errno()),
                }
        except Exception:
            pass
        man = {
            "detector_version": __version__,
            "archived_at": time.strftime("%Y-%m-%d %H:%M:%S", time.localtime()),
            "archived_ms": int(time.time() * 1000),
            "file_count": len(nmu),
            "verdict_file_count": len(verdict),
            "moment_snapshot_count": len(moment),
            "files": sorted(nmu),
            "moment_snapshots": sorted(moment),
            "native_lib": native,
            "errors": _errs,
        }
        _pm = os.path.join(_DIR, "archive_manifest.json")
        if _moment_write_text(_pm, json.dumps(man, ensure_ascii=False, indent=2)):
            _rpm = _extras_real_path(_pm)
            if _rpm:
                out.append(_rpm)
    except Exception as e:
        try: _log("send_logs: manifest err: %s" % e)
        except Exception: pass
    return out

_AW_TMP_MARKERS = (".tmp.", ".fb.")

def _aw_atomic_tmp_parse(name):
    try:
        for _mk in _AW_TMP_MARKERS:
            if _mk not in name:
                continue
            _tail = name.rsplit(_mk, 1)[1]
            _pp = _tail.split(".")
            if len(_pp) == 2 and _pp[0].isdigit() and _pp[1].isdigit():
                return (_mk, int(_pp[0]), int(_pp[1]))
    except Exception:
        pass
    return None

def _aw_cleanup_stale_tmp(max_age_s=600, dead_age_s=5, own_age_s=None):
    removed = 0
    try:
        _mypid = int(os.getpid()); _now = time.time()
        _dirs = []
        try:
            _d0 = globals().get("_DIR")
            if _d0: _dirs.append(_d0)
        except Exception: pass
        try:
            _md = _app_priv_dir()
            if _md and _md not in _dirs: _dirs.append(_md)
        except Exception: pass
        for _dd in _dirs:
            try: _names = os.listdir(_dd)
            except Exception: continue
            for _tnm in _names:
                try:
                    _pt = _aw_atomic_tmp_parse(_tnm)
                    if _pt is None: continue
                    _fp = os.path.join(_dd, _tnm)
                    if not os.path.isfile(_fp): continue
                    try: _age = _now - os.path.getmtime(_fp)
                    except Exception: continue
                    _tpid = _pt[1]
                    if _tpid == _mypid:
                        _stale = _age > (max_age_s if own_age_s is None else own_age_s)
                    else:
                        _alive = False
                        try: _alive = os.path.exists("/proc/%d" % _tpid)
                        except Exception: _alive = False
                        _stale = (_age > max_age_s) if _alive else (_age > dead_age_s)
                    if _stale:
                        os.remove(_fp); removed += 1
                except Exception: continue
        if removed:
            try: _log("+ML: удалены осиротевшие атомарные tmp/fb-файлы: %d" % removed)
            except Exception: pass
    except Exception: pass
    return removed


def _atomic_json_write(path, data, max_len=None, dedup=False):

    try:
        if isinstance(data, dict):
            if data.get("event_type") and "detector_version" not in data:
                data = dict(data)
                data["detector_version"] = __version__
        elif isinstance(data, (list, tuple)):
            _chg = False; _cp = []
            for _it in data:
                if isinstance(_it, dict) and _it.get("event_type") and "detector_version" not in _it:
                    _it = dict(_it); _it["detector_version"] = __version__; _chg = True
                _cp.append(_it)
            if _chg:
                data = _cp
    except Exception:
        pass
    _ok = _atomic_json_write_impl(path, data, max_len, dedup)
    if _ok:
        try: _moment_autocap(path, data)
        except Exception: pass
    return _ok


_JRN_FILE_NAME = "culprit_journal.bin"
_JEV_BOOT = 1; _JEV_SELF_KILL = 2; _JEV_RESTART_PERMIT = 3; _JEV_CRASH_PERMIT = 4
_JEV_ANR_STALL = 5; _JEV_OOM_BREACH = 6; _JEV_PERSIST_FAIL = 7; _JEV_NATIVE_CRASH = 8; _JEV_HANDLER_REARM = 9; _JEV_HANDLER_AUDIT = 10; _JEV_KERNEL_DISP = 11; _JEV_KERNEL_RECLAIM = 12; _JEV_DLCLOSE_SKIP = 13; _JEV_DL_EVENT = 14; _JEV_TRACER_THROTTLE = 15; _JEV_OOM_THROW = 16
_PREV_SESSION_SAFE_MODE = None
_PREV_SESSION_SEGV_OWNER = None
_PREV_SESSION_SEGV_OURS = None
_PREV_SESSION_NATIVE_CRASH_SEEN = None
_PREV_SESSION_RESTART_EVIDENCE = None
_JRN_BOUND = [False]
_JRN_NATIVE_CRASH_PENDING = [None]
_JRN_HDR_FMT = "<IHHQQiiiiiIII"
_JRN_MAGIC = 0x314A4443
_JRN_MAX_BYTES = 1024 * 1024

def _native_evidence_path(name):
    return _aw_mirror_path(name) or _b34_path(name)

def _native_evidence_read_path(name):
    seen = set()
    for p in (_aw_mirror_path(name), _b34_path(name)):
        if not p or p in seen: continue
        seen.add(p)
        try:
            with open(p, "rb") as f:
                if f.read(1): return p
        except OSError:
            pass
    return None

def _jrn_path():
    try:
        return _native_evidence_path(_JRN_FILE_NAME)
    except Exception:
        return None

def _jrn_bind():
    import ctypes as _c
    lib = _NLIB
    if lib is None: return False
    lib.cd_jrn_start.argtypes = [_c.c_char_p]; lib.cd_jrn_start.restype = _c.c_int
    lib.cd_jrn_stop.argtypes = []; lib.cd_jrn_stop.restype = _c.c_int
    lib.cd_jrn_drops_total.argtypes = []; lib.cd_jrn_drops_total.restype = _c.c_int64
    lib.cd_jrn_running.argtypes = []; lib.cd_jrn_running.restype = _c.c_int
    lib.cd_jrn_sync_fails_total.argtypes = []; lib.cd_jrn_sync_fails_total.restype = _c.c_int64
    lib.cd_event_append.argtypes = [_c.c_uint32, _c.c_uint64, _c.c_int32, _c.c_int32,
                                    _c.c_int32, _c.c_int32, _c.c_char_p, _c.c_uint32]
    lib.cd_event_append.restype = _c.c_int
    try: lib.cd_gettid.restype = _c.c_int
    except Exception: pass
    _JRN_BOUND[0] = True
    return True

def _jrn_event(evt, owner_idx=-1, code=0, status=0, payload=None):
    try:
        if not _JRN_BOUND[0] or _NLIB is None: return False
        pb = None
        if payload is not None:
            pb = payload if isinstance(payload, bytes) else str(payload).encode("utf-8")
        try: _tid = int(_NLIB.cd_gettid())
        except Exception: _tid = 0
        rc = int(_NLIB.cd_event_append(int(evt), int(time.time() * 1000), _tid,
                                       int(owner_idx), int(code), int(status),
                                       pb, len(pb) if pb else 0))
        if rc == 1:
            try: _log("Block#35 (+OQ): journal record written, fdatasync unconfirmed (rc=1)")
            except Exception: pass
            return True
        return rc == 0
    except Exception:
        return False

def _utf8_bound(value, max_bytes):
    try:
        b = str(value or "").encode("utf-8")[:max_bytes]
        return b.decode("utf-8", "ignore")
    except Exception:
        return ""


def _jrn_selfkill(rec):
    try:
        d = {}
        for k in ("crashed_plugin_id", "kill_method", "kill_arg", "self_kill",
                  "benign_restart", "programmatic_restart", "src", "confidence",
                  "ts", "event_type", "dropbox_tag"):
            v = rec.get(k)
            if isinstance(v, str):
                v = _utf8_bound(v, 160)
            if v is None or isinstance(v, (str, int, float, bool)): d[k] = v
        pb = json.dumps(d, ensure_ascii=False, separators=(",", ":")).encode("utf-8")
        if len(pb) > 1000:
            d = {"crashed_plugin_id": _utf8_bound(d.get("crashed_plugin_id"), 256),
                 "kill_method": _utf8_bound(d.get("kill_method"), 96),
                 "self_kill": bool(d.get("self_kill")),
                 "src": _utf8_bound(d.get("src"), 64),
                 "ts": d.get("ts")}
            pb = json.dumps(d, ensure_ascii=False, separators=(",", ":")).encode("utf-8")
        if len(pb) > 1024:
            _ka = rec.get("kill_arg") if isinstance(rec, dict) else None
            if not isinstance(_ka, (int, float, bool)): _ka = None
            _ts = d.get("ts")
            if not isinstance(_ts, (int, float)): _ts = None
            d = {"self_kill": bool(d.get("self_kill")), "ts": _ts, "kill_arg": _ka}
            pb = json.dumps(d, separators=(",", ":")).encode("utf-8")
        if len(pb) > 1024:
            _log("Block#35 (+OP): SELF_KILL payload %dB > 1024 -- не записан" % len(pb))
            return False
        return _jrn_event(_JEV_SELF_KILL, payload=pb)
    except Exception:
        return False

def _jrn_read_all(p):
    import struct as _st, zlib as _zl
    out = []
    _sz = os.path.getsize(p)
    if _sz > _JRN_MAX_BYTES:
        raise ValueError("journal too big: %d bytes (cap %d)" % (_sz, _JRN_MAX_BYTES))
    with open(p, "rb") as f:
        raw = f.read(_JRN_MAX_BYTES)
    hdr = _st.calcsize(_JRN_HDR_FMT)
    off = 0
    while off + hdr <= len(raw):
        (magic, ver, hlen, ts, pstart, pid, tid, oidx, code, status,
         etype, plen, crc) = _st.unpack_from(_JRN_HDR_FMT, raw, off)
        if magic != _JRN_MAGIC or ver != 1 or hlen != hdr or plen > 1024 or off + hdr + plen > len(raw):
            break
        payload = raw[off + hdr: off + hdr + plen]
        c0 = _zl.crc32(raw[off:off + hdr - 4] + b"\x00\x00\x00\x00")
        if plen: c0 = _zl.crc32(payload, c0)
        if (c0 & 0xffffffff) != crc:
            break
        out.append({"type": etype, "ts": ts, "pstart": pstart, "pid": pid, "tid": tid,
                    "owner_idx": oidx, "code": code, "status": status, "payload": payload})
        off += hdr + plen
    return out

def _jrn_materialize_native_crash():
    try:
        try:
            jrec = _JRN_NATIVE_CRASH_PENDING[0]
        except Exception:
            jrec = None
        if not jrec:
            return False
        _JRN_NATIVE_CRASH_PENDING[0] = None
        _ncvp = _native_crash_verdict_path()
        if not _ncvp:
            return False
        _exist = None
        try:
            _exist = _rc_read_path(_ncvp)
        except Exception:
            _exist = None
        if _exist:
            _ets = None
            try:
                with open(_exist, "r", encoding="utf-8") as _fe:
                    _ed = json.load(_fe)
                _ets = int(_ed.get("crash_ts") or _ed.get("ts") or 0) if isinstance(_ed, dict) else None
            except Exception:
                _ets = None
            try:
                _jts0 = int(jrec.get("ts") or 0)
            except Exception:
                _jts0 = 0
            if not _ets or not _jts0 or _ets >= _jts0 - _TB_VERDICT_TOL_MS:
                _log("Block#35 (+PW): native_crash_verdict.json уже на диске -- journal-recovery не нужна (verdict_ts=%r journal_ts=%r)" % (_ets, _jts0))
                return False
            _log("Block#35 (+PW): на диске вердикт ПРОШЛОГО краша (verdict_ts=%r < journal_ts=%r) -> восстанавливаем новый" % (_ets, _jts0))
        try:
            _ts = int(jrec.get("ts") or 0)
        except Exception:
            _ts = 0
        if _ts:
            _age = abs(int(time.time() * 1000) - _ts)
            if _age > 24 * 3600 * 1000:
                _log("Block#35 (+PW): journal NATIVE_CRASH протух (age=%dms) -> пропуск" % _age)
                return False
        try:
            _pls = (jrec.get("payload") or b"").decode("utf-8", "replace")
        except Exception:
            _pls = ""
        _pc = None; _so = None; _kind = None; _ap = -1; _sk = None
        for _tok in _pls.split():
            if _tok.startswith("pc="): _pc = _tok[3:]
            elif _tok.startswith("so="): _so = _tok[3:]
            elif _tok.startswith("k="): _kind = _tok[2:]
            elif _tok.startswith("ap="):
                try: _ap = int(_tok[3:])
                except Exception: _ap = -1
            elif _tok.startswith("sk="): _sk = _tok[3:]
        try:
            _signo = int(jrec.get("code") or 0)
        except Exception:
            _signo = 0
        try:
            _sicode = int(jrec.get("status") or 0)
        except Exception:
            _sicode = 0
        try:
            _cp = int(jrec.get("owner_idx"))
        except Exception:
            _cp = -1
        rec = {"event_type": "native_crash", "dropbox_tag": "data_app_native_crash",
               "tombstone_tag": "data_app_native_crash", "tombstone_source": "native_journal_recovered",
               "tombstone_norm_version": 1, "src": "native-journal-recovered", "journal_recovered": True,
               "signo": _signo, "code": _sicode, "fault_pc": _pc, "tid": jrec.get("tid"),
               "culprit_pid": (_cp if (_cp is not None and _cp >= 0) else (_ap if _ap >= 0 else None)),
               "active_pid": (_ap if _ap >= 0 else None),
               "pid": None, "attribution": False, "confidence": "low", "ts": _ts,
               "detector_version": __version__}
        if _so and _sk is None:
            try:
                _hd = _host_lib_dir()
            except Exception:
                _hd = None
            if (_so.startswith("/data/data/") or _so.startswith("/data/user/")) and "/bootstrap-native/" not in _so and not _so.endswith("/libculprit.so"):
                _sk = "p"
            elif _hd and _so.startswith(_hd):
                _sk = "h"
            elif ("/" not in _so) and _kind == "plugin" and _so.lower() not in _PW_RUNTIME_BARE_SO:
                _sk = "p"
            else:
                _sk = "s"
        rec["journal_so_class"] = _sk
        if _so and _kind == "plugin":
            rec["culprit_kind"] = "plugin"
            if _sk == "p":
                rec["foreign_so"] = _so; rec["foreign_app_private"] = True
            elif _sk == "h":
                rec["host_so"] = _so
            else:
                rec["top_so"] = _so
        elif _so and _kind == "host":
            rec["host_so"] = _so; rec["host_native"] = True; rec["culprit_kind"] = "host"
        elif _so:
            rec["top_so"] = _so; rec["culprit_kind"] = None
        else:
            rec["culprit_kind"] = None
        rec["native_advisory"] = ("нативный краш восстановлен из durable-журнала (native_crash.txt не сохранился): модуль=%s kind=%s pc=%s signo=%s -- атрибуция ограничена полями журнала" % (_so or "?", _kind or "?", _pc or "?", _signo))
        try:
            if not _ta_selfkill_aftermath(rec, "journal"):
                _td_runtime_abort(rec)
        except Exception as _eta:
            _log("Block#35 (+TA) err: %s" % _eta)
        _ok = False
        try:
            _ok = bool(_atomic_json_write(_ncvp, rec))
        except Exception as _ew:
            _log("Block#35 (+PW): verdict write err: %s" % _ew)
        _log("Block#35 (+PW): NATIVE_CRASH вердикт восстановлен из журнала (persisted=%r signo=%s so=%r kind=%s pc=%s cp=%r)" % (_ok, _signo, _so, _kind, _pc, rec.get("culprit_pid")))
        try:
            _nhp = File(_DIR, _NATIVE_CRASH_HISTORY_NAME).getAbsolutePath()
            _nhist = []
            _nhrp = _rc_read_path(_nhp)
            if _nhrp:
                try:
                    with open(_nhrp, "r", encoding="utf-8") as _fnh:
                        _nhist = list(json.load(_fnh))
                except Exception:
                    _nhist = []
            if not any(isinstance(_h, dict) and _h.get("ts") == _ts for _h in _nhist):
                _nhist.append(rec)
                _atomic_json_write(_nhp, _nhist[-_NATIVE_CRASH_HISTORY_MAX:], _NATIVE_CRASH_HISTORY_MAX)
                _log("Block#35 (+PW): native_crash_history.json дополнен из журнала (signo=%s -> всего=%d)" % (_signo, min(len(_nhist), _NATIVE_CRASH_HISTORY_MAX)))
        except Exception as _enh:
            _log("Block#35 (+PW): history append err: %s" % _enh)
        return _ok
    except Exception as _e:
        try:
            _log("Block#35 (+PW): materialize err: %s" % _e)
        except Exception:
            pass
        return False


def _jrn_boot_consume():
    globals()["_PREV_SESSION_RESTART_EVIDENCE"] = None
    p = _jrn_path()
    if not p:
        _log("Block#35 (+ON): journal path недоступен")
        return
    if not _jrn_bind():
        _log("Block#35 (+ON): native lib недоступна -- journal не запущен")
        return
    try: _reload = int(_NLIB.cd_jrn_running()) == 1
    except Exception: _reload = False
    prev = []
    if _reload:
        try: _pexists = os.path.exists(p)
        except Exception: _pexists = True
        if _pexists:
            _log("Block#35 (+OP): same-process reload -- журнал сохранён как есть (без ротации/reopen)")
            return
        try:
            _rrc = int(_NLIB.cd_jrn_start(p.encode("utf-8")))
            _log("Block#35 (+OQ): reload: journal path исчез -- reopen rc=%d path=%s" % (_rrc, p))
        except Exception as _jr:
            _log("Block#35 (+OQ): reload reopen err: %r" % (_jr,))
        return
    _read_p = _native_evidence_read_path(_JRN_FILE_NAME)
    try:
        if _read_p:
            prev = _jrn_read_all(_read_p)
    except Exception as _je:
        _log("Block#35 (+ON): journal read err: %r" % (_je,)); prev = []
    if prev:
        try:
            _cnt = {}; _last = {}
            for r in prev:
                _cnt[r["type"]] = _cnt.get(r["type"], 0) + 1; _last[r["type"]] = r
            _log("Block#35 (+ON): журнал прошлой сессии: records=%d types=%r" % (len(prev), _cnt))
            if _JEV_RESTART_PERMIT in _last and _JEV_BOOT in _last:
                globals()["_PREV_SESSION_RESTART_EVIDENCE"] = {"permit": dict(_last[_JEV_RESTART_PERMIT]), "boot": dict(_last[_JEV_BOOT])}
            globals()["_PREV_SESSION_NATIVE_CRASH_SEEN"] = (_JEV_NATIVE_CRASH in _cnt)
            try:
                if _JEV_BOOT in _last:
                    _psm = bool(_last[_JEV_BOOT].get("status", 0))
                    globals()["_PREV_SESSION_SAFE_MODE"] = _psm
                    _log("Block#35 (+QI): прошлая сессия в БЕЗОПАСНОМ режиме = %s (из status BOOT-записи журнала)" % ("ДА" if _psm else "нет"))
            except Exception: pass
            for _t, _nm in ((_JEV_RESTART_PERMIT, "RESTART_PERMIT"), (_JEV_CRASH_PERMIT, "CRASH_PERMIT")):
                if _t in _last:
                    _log("Block#35 (+OO): %s x%d, последний ts=%d tid=%d" % (_nm, _cnt[_t], _last[_t]["ts"], _last[_t]["tid"]))
            if _JEV_ANR_STALL in _last:
                _r = _last[_JEV_ANR_STALL]
                _log("Block#35 (+OO): ANR_STALL x%d, последний stalled_ms=%d ui_tid=%d owner_idx=%d ts=%d" % (_cnt[_JEV_ANR_STALL], _r["code"], _r["tid"], _r["owner_idx"], _r["ts"]))
            if _JEV_OOM_BREACH in _last:
                _r = _last[_JEV_OOM_BREACH]
                _log("Block#35 (+OO): OOM_BREACH x%d, последний reason=%d src=%d ts=%d" % (_cnt[_JEV_OOM_BREACH], _r["code"], _r["status"], _r["ts"]))
            if _JEV_PERSIST_FAIL in _last:
                _r = _last[_JEV_PERSIST_FAIL]
                _log("Block#35 (+OO): PERSIST_FAIL x%d, kind=%r ts=%d -- деградация персистенса в прошлой сессии" % (_cnt[_JEV_PERSIST_FAIL], _r["payload"].decode("utf-8", "replace"), _r["ts"]))
            if _JEV_HANDLER_REARM in _last:
                _rr = _last[_JEV_HANDLER_REARM]
                _log("Block#35 (+PY): HANDLER_REARM x%d -- нативный fatal-sig handler был ВЫТЕСНЕН и восстановлен off-GIL watchdog'ом; последний: sig=%d %s ts=%d (durable-доказательство displacement: tombstone момента краша вытесняется из logcat спамом ДО recovery, journal переживает смерть)" % (_cnt[_JEV_HANDLER_REARM], _rr["code"], ((_rr["payload"] or b"")[:160].decode("utf-8", "replace")), _rr["ts"]))
            if _JEV_HANDLER_AUDIT in _last:
                _ra = _last[_JEV_HANDLER_AUDIT]
                _log("Block#35 (+PZ): HANDLER_AUDIT x%d -- РЕАЛЬНАЯ диспозиция фатальных сигналов прошлой сессии из /proc (libsigchain её НЕ подделывает): %s [anom=%d] ts=%d -- segv_cgt=0 => обработчика SIGSEGV не было вовсе; segv_blk=1/segv_ign=1 => синхронный фолт force-default БЕЗ вывода = тихий signal-11 (ни Fatal signal, ни type-8/9)" % (_cnt[_JEV_HANDLER_AUDIT], ((_ra["payload"] or b"")[:180].decode("utf-8","replace")), _ra["code"], _ra["ts"]))
            if _JEV_KERNEL_DISP in _last:
                _kd = _last[_JEV_KERNEL_DISP]
                try:
                    _kdp_qk = ((_kd["payload"] or b"")[:220]).decode("utf-8", "replace")
                    _own_qk = None; _ours_qk = None
                    for _tok_qk in _kdp_qk.split():
                        if _tok_qk.startswith("segv_real="): _own_qk = _tok_qk.split("=", 1)[1].rsplit("/", 1)[-1]
                        elif _tok_qk.startswith("ours="):
                            try: _ours_qk = bool(int(_tok_qk.split("=", 1)[1]))
                            except Exception: _ours_qk = None
                    globals()["_PREV_SESSION_SEGV_OWNER"] = _own_qk; globals()["_PREV_SESSION_SEGV_OURS"] = _ours_qk
                except Exception: pass
                _log("Block#35 (+QA): KERNEL_DISP x%d -- РЕАЛЬНЫЙ обработчик SIGSEGV ядра (прямой rt_sigaction, мимо libsigchain): %s [not_ours=%d] ts=%d -- если модуль libart.so/libsigchain => цепочка здорова (проблема глубже); если чужой crash-reporter .so => ИМЕННО он перехватил слот через raw-syscall и не чейнит => ни мы, ни debuggerd не исполняемся" % (_cnt[_JEV_KERNEL_DISP], ((_kd["payload"] or b"")[:180].decode("utf-8","replace")), _kd["status"], _kd["ts"]))
            if _JEV_KERNEL_RECLAIM in _last:
                _kr = _last[_JEV_KERNEL_RECLAIM]
                _krp = ((_kr["payload"] or b"")[:180]).decode("utf-8", "replace")
                if _kr["status"] == 2:
                    _log("Block#35 (+QD): KERNEL_RECLAIM x%d -- ЦИРКУИТ-БРЕЙКЕР СРАБОТАЛ: raw-слот SIGSEGV/SIGBUS возвращён прежнему владельцу (shadowhook), реклейм авто-отключён во избежание шторма (+QB-регрессия): %s ts=%d" % (_cnt[_JEV_KERNEL_RECLAIM], _krp, _kr["ts"]))
                else:
                    _log("Block#35 (+QD): KERNEL_RECLAIM x%d -- raw-слот фатального сигнала ОТОБРАН у чужого не-чейнящего владельца прямым rt_sigaction (наш обработчик установлен поверх, с чейном к нему): sig=%d %s ts=%d -- следующий фолт этого сигнала теперь исполнит cd_crash_action => атрибуция вместо тихой смерти" % (_cnt[_JEV_KERNEL_RECLAIM], _kr["code"], _krp, _kr["ts"]))
        except Exception: pass
        try:
            if _JEV_TRACER_THROTTLE in _last:
                _th = _last[_JEV_TRACER_THROTTLE]
                _log("Block#37 (+RH): TRACER_THROTTLE x%d -- ptrace-супервизор превысил CPU-бюджет (>=20%% ядра, 2x10с) и добровольно ушёл, приложение продолжило работу без ptrace-захвата; cpu_ms=%d maps_loads=%d %s ts=%d" % (_cnt[_JEV_TRACER_THROTTLE], _th["code"], _th["status"], ((_th["payload"] or b"")[:160]).decode("utf-8", "replace"), _th["ts"]))
        except Exception: pass
        try:
            if _JEV_DLCLOSE_SKIP in _last:
                _dl13 = _last[_JEV_DLCLOSE_SKIP]
                _log("Block#38 (+QU): DLCLOSE_SKIP x%d -- media/codec .so удержаны от выгрузки в прошлой сессии; последний: %s ts=%d" % (_cnt[_JEV_DLCLOSE_SKIP], ((_dl13["payload"] or b"")[:160].decode("utf-8", "replace")), _dl13["ts"]))
            try:
                _dlev = [r for r in prev if r["type"] == _JEV_DL_EVENT]
                if _dlev:
                    _tail = _dlev[-24:]
                    _dls = []
                    for _r in _tail:
                        _p = _r.get("payload") or b""
                        try: _p = _p.decode("utf-8", "replace")
                        except Exception: _p = str(_p)
                        _dls.append("ts=%d tid=%s %s" % (_r.get("ts", 0), _r.get("tid", "?"), _p[:200]))
                    _log("Block#39 (+RA): DL/UNMAP ring x%d -- last %d dlopen/dlclose/munmap of code segments from the previous session (name+decision; +RE hook-free watcher: op=1 dec=7 appeared, op=2 dec=7 vanished, dec=4 dlopen FAILED [only with opt-in hooks], dec=3 enter); look at the last events right before the linker crash:\n%s" % (_cnt.get(_JEV_DL_EVENT, 0), len(_tail), "\n".join(_dls)))
            except Exception as _edl:
                _log("Block#39 (+RA) DL-ring log err: %r" % (_edl,))
            sk = [r for r in prev if r["type"] == _JEV_SELF_KILL]
            if sk:
                try: cp = _crash_path()
                except Exception: cp = None
                _existing = None
                try: _existing = _rc_read_path(cp) if cp else None
                except Exception: _existing = None
                if cp and not _existing:
                    rec = json.loads(sk[-1]["payload"].decode("utf-8", "replace"))
                    _age = abs(int(time.time() * 1000) - int(rec.get("ts") or 0))
                    if rec.get("ts") and _age <= 24 * 3600 * 1000:
                        rec["src"] = "%s+journal-recovered" % (rec.get("src") or "self-kill")
                        rec["journal_recovered"] = True
                        _ok = _write_crash_verdict(rec)
                        _log("Block#35 (+ON): self-kill verdict восстановлен из native journal "
                             "(early-consume window, age=%dms, persisted=%r): %r"
                             % (_age, _ok, rec.get("crashed_plugin_id")))
                    else:
                        _log("Block#35 (+ON): journal SELF_KILL протух (age=%dms) -> пропуск" % _age)
                elif _existing:
                    _log("Block#35 (+OO): штатный вердикт найден (%s) -- journal recovery не нужен" % (_existing,))
        except Exception as _jr:
            _log("Block#35 (+ON): journal recover err: %r" % (_jr,))
        _b23_journal_boot(prev)
        try:
            _nc = [r for r in prev if r["type"] == _JEV_NATIVE_CRASH]
            if _nc:
                _JRN_NATIVE_CRASH_PENDING[0] = _nc[-1]
                _rnc = _nc[-1]
                _log("Block#35 (+PW): NATIVE_CRASH x%d, последний signo=%d si=%d tid=%d owner_idx=%d ts=%d payload=%r" % (len(_nc), _rnc["code"], _rnc["status"], _rnc["tid"], _rnc["owner_idx"], _rnc["ts"], ((_rnc["payload"] or b"")[:160].decode("utf-8", "replace"))))
        except Exception as _jnc:
            _log("Block#35 (+PW): NATIVE_CRASH capture err: %r" % (_jnc,))
    _rotated = True
    try:
        if _read_p:
            try:
                os.replace(_read_p, _read_p + ".1")
            except Exception as _re:
                _rotated = False
                _log("Block#35 (+OP): journal rotation FAILED: %r" % (_re,))
    except Exception as _re2:
        _rotated = False
        _log("Block#35 (+OP): journal rotation check FAILED: %r" % (_re2,))
    if not _rotated and _read_p == p:
        return
    try:
        rc = int(_NLIB.cd_jrn_start(p.encode("utf-8")))
        if rc != 0:
            try: _alive = int(_NLIB.cd_jrn_running()) == 1
            except Exception: _alive = False
            _log("Block#35 (+OP): native journal start FAILED rc=%d running=%r path=%s" % (rc, _alive, p))
            return
        try: _drops = int(_NLIB.cd_jrn_drops_total())
        except Exception: _drops = -1
        try: _sfail = int(_NLIB.cd_jrn_sync_fails_total())
        except Exception: _sfail = -1
        _log("Block#35 (+ON): native journal start rc=0 drops=%d sync_fails=%d path=%s" % (_drops, _sfail, p))
    except Exception as _js:
        _log("Block#35 (+ON): cd_jrn_start err: %r" % (_js,))


_TRC_FILE_NAME = "culprit_tracer_report.txt"
_TRC_BOUND = [False]
_PREV_SESSION_TRACER = None

def _trc_path():
    try:
        return _native_evidence_path(_TRC_FILE_NAME)
    except Exception:
        return None

def _trc_bind():
    import ctypes as _c
    lib = _NLIB
    if lib is None: return False
    if not hasattr(lib, "cd_tracer_start"): return False
    lib.cd_tracer_start.argtypes = [_c.c_char_p]; lib.cd_tracer_start.restype = _c.c_int
    lib.cd_tracer_running.argtypes = []; lib.cd_tracer_running.restype = _c.c_int
    lib.cd_tracer_captures_total.argtypes = []; lib.cd_tracer_captures_total.restype = _c.c_int64
    lib.cd_tracer_signals_total.argtypes = []; lib.cd_tracer_signals_total.restype = _c.c_int64
    _TRC_BOUND[0] = True
    return True

def _trc_rc_text(rc):
    import os as _o
    _e = int(_NLIB.cd_tracer_last_errno()) if hasattr(_NLIB, "cd_tracer_last_errno") else 0
    _tp = int(_NLIB.cd_tracer_adopted_pid()) if hasattr(_NLIB, "cd_tracer_adopted_pid") else 0
    _es = ("errno=%d %s" % (_e, _o.strerror(_e))) if _e else "errno=?"
    if rc == -4:
        return "-- same-process reload: супервизор ПРЕДЫДУЩЕГО инстанса .so жив (pid=%d) и продолжает ловить фолты; новый не нужен" % _tp
    if rc == -5:
        return "-- процесс уже трассируется ЧУЖИМ трассером (TracerPid=%d: отладчик/strace?) -- супервизор не запущен" % (-_tp)
    if rc == -6:
        return "-- fork() отказал (%s) -- супервизор неактивен" % _es
    if rc == -1 and _e:
        return "-- PTRACE_SEIZE отказал (%s: dumpable/SELinux/yama) -- супервизор неактивен, детектор работает как раньше" % _es
    if rc == -7:
        return "-- report file open failed (%s) -- supervisor inactive; no capture promised" % _es
    if rc == -8:
        return "-- потомок не ответил за 3с -- супервизор неактивен"
    if rc == -9:
        return "-- супервизор ранее ушёл по CPU-бюджету, до конца процесса не поднимаем"
    return "(отказ ptrace/dumpable/SELinux? -- супервизор неактивен, детектор работает как раньше)"

def _trc_parse(txt):
    caps = []
    cur = None
    frames = None
    try:
        for ln in (txt or "").splitlines():
            ln = ln.rstrip()
            if ln.startswith("CULPRIT TRACER CAPTURE"):
                cur = {"capture_version": 2 if " v2 " in ln else 1, "complete": False}; frames = []; caps.append(cur)
                continue
            if cur is None:
                continue
            if ln == "END":
                cur["complete"] = True
                if frames: cur["frames"] = frames
                cur = None; frames = None
                continue
            if ln.startswith("  #") or ln.startswith("  stk+"):
                frames.append(ln.strip())
                continue
            if "=" in ln:
                k, _, val = ln.partition("=")
                cur[k.strip()] = val.strip()
        if cur is not None and frames:
            cur["frames"] = frames
    except Exception:
        pass
    return [c for c in caps if c.get("sig")]

_TRC_SELF_SO = "libculprit.so"
_TRC_SKIP_FRAME_MODS = ("libculprit.so", "libsigchain.so", "libshadowhook.so")

def _trc_mod_base(mod):
    return (mod or "").rsplit("/", 1)[-1].lower()

def _trc_is_self_capture(cap):
    return _trc_mod_base(cap.get("pc_module")) == _TRC_SELF_SO

def _trc_is_stack_overflow(cap):
    try:
        a = int(str(cap.get("si_addr") or "0"), 16); s = int(str(cap.get("sp") or "0"), 16)
        return a != 0 and s != 0 and abs(a - s) <= 0x2000
    except Exception:
        return False

def _trc_frame_module(fr):
    i = (fr or "").find("mod=")
    if i < 0: return ""
    rest = fr[i + 4:].strip()
    return rest.split(" ", 1)[0] if rest else ""

def _trc_mod_is_realcode(mod):
    if not mod: return False
    low = mod.lower()
    if mod == "<unknown>" or mod == "[vdso]" or mod.startswith("[anon") or mod.startswith("[stack") \
       or mod.startswith("[heap") or mod.startswith("/memfd") or ("jit-cache" in low) \
       or ("dalvik" in low) or low.endswith("boot.oat"):
        return False
    return _trc_mod_base(mod) not in _TRC_SKIP_FRAME_MODS

def _trc_culprit_module(cap):
    pm = cap.get("pc_module") or ""
    if _trc_mod_is_realcode(pm):
        return pm, False
    for fr in (cap.get("frames") or []):
        m = _trc_frame_module(fr)
        if _trc_mod_is_realcode(m):
            return m, True
    return pm, True

_TRC_ABORT_MACHINERY = ("libc.so", "libart.so", "libbase.so", "liblog.so", "libutils.so", "libsigchain.so", "libculprit.so", "libshadowhook.so")

def _trc_abort_like(cap):
    try:
        if int(cap.get("sig") or 0) == 6: return True
        return int(cap.get("si_code") or 0) <= 0
    except Exception:
        return False

def _trc_abort_caller_module(cap):
    
    for fr in (cap.get("frames") or []):
        m = _trc_frame_module(fr)
        base = _trc_mod_base(m)
        bridge = base.startswith(("_ctypes.", "libpython", "libffi")) or base == "chaquopy.so"
        if _trc_mod_is_realcode(m) and base not in _TRC_ABORT_MACHINERY and not bridge:
            return m
    return None

def _trc_jrn_match(cap, exit_only=False):
    
    
    try:
        rec = _JRN_NATIVE_CRASH_PENDING[0]
        if not rec or int(rec.get("code") or 0) != int(cap.get("sig") or -1): return None
        if int(cap.get("pid") or 0) <= 0 or int(rec.get("pid") or 0) != int(cap["pid"]): return None
        if abs(int(rec.get("ts") or 0) - int(cap.get("realtime_ms") or 0)) > 3000: return None
        if not exit_only:
            if int(cap.get("tid") or 0) <= 0 or int(rec.get("tid") or 0) != int(cap["tid"]): return None
            if int(rec.get("status")) != int(cap.get("si_code")): return None
            payload = (rec.get("payload") or b"").decode("utf-8", "replace")
            pcs = [t[3:] for t in payload.split() if t.startswith("pc=")]
            if len(pcs) != 1 or int(pcs[0], 16) < 0 or int(pcs[0], 16) != int(str(cap.get("pc")), 16): return None
        elif cap.get("tid") is not None or cap.get("pc") is not None:
            return None
        return rec
    except Exception:
        return None


def _trc_jrn_owner(cap, exit_only=False):
    
    
    
    jrec = _trc_jrn_match(cap, exit_only=exit_only)
    if not jrec:
        return None
    try:
        _pls = (jrec.get("payload") or b"").decode("utf-8", "replace")
    except Exception:
        return None
    _k = None; _ap = -1
    for _tok in _pls.split():
        if _tok.startswith("k="): _k = _tok[2:]
        elif _tok.startswith("ap="):
            try: _ap = int(_tok[3:])
            except Exception: _ap = -1
    if _k != "plugin":
        return None
    try:
        _oi = int(jrec.get("owner_idx"))
    except Exception:
        _oi = -1
    _idx = _oi if _oi >= 0 else _ap
    if _idx < 0:
        return None
    _nm = None
    try: _nm = _resolve_idx(_idx)
    except Exception: _nm = None
    if not _nm:
        try: _nm = _resolve_idx_durable(_idx)
        except Exception: _nm = None
    if not _nm:
        return None
    return {"plugin": _nm, "idx": _idx, "src": ("registry" if _oi >= 0 else "scope"), "conf": ("high" if _oi >= 0 else "medium")}

def _trc_select_fatal(caps, ets, status, proc_pid=None):
    _cand = []; _self = []
    for _cq in (caps or []):
        try:
            if proc_pid is not None and int(proc_pid) > 0 and int(_cq.get("pid") or 0) != int(proc_pid): continue
            if int(_cq.get("capture_version") or 1) >= 2 and not _cq.get("complete"): continue
            if ets is not None:
                if status and int(_cq.get("sig") or -1) != int(status): continue
                if abs(int(_cq.get("realtime_ms") or 0) - int(ets)) > 15000: continue
            
            
            if _trc_abort_like(_cq) and not (_trc_jrn_match(_cq) or _trc_jni_owner(_cq)):
                continue
            (_self if _trc_is_self_capture(_cq) else _cand).append(_cq)
        except Exception:
            pass
    if _cand:
        try: best = min(_cand, key=lambda c: int(c.get("realtime_ms") or 0))
        except Exception: best = _cand[0]
        mod, wild = _trc_culprit_module(best)
        return best, mod, wild, len(_self)
    _self_real = [c for c in _self if not _trc_is_stack_overflow(c)]
    if _self_real:
        try: best = min(_self_real, key=lambda c: int(c.get("realtime_ms") or 0))
        except Exception: best = _self_real[0]
        mod, wild = _trc_culprit_module(best)
        return best, mod, wild, len(_self) - len(_self_real)
    return None, None, False, len(_self)


def _trc_boot_consume():
    globals()["_PREV_SESSION_TRACER"] = None
    p = _trc_path()
    if not p:
        return
    if not _trc_bind():
        _log("Block#37 (+QO): в .so нет cd_tracer_* (сборка < rev 10479) -- супервизор не запущен; пересобери/встрой свежий libculprit.so")
        return
    try:
        if int(_NLIB.cd_tracer_running()) == 1:
            _ill = -1
            if hasattr(_NLIB, "cd_tracer_sigill_skips"):
                import ctypes as _c
                _NLIB.cd_tracer_sigill_skips.restype = _c.c_int64; _ill = int(_NLIB.cd_tracer_sigill_skips())
            _log("Block#37 (+QO): same-process reload -- супервизор уже жив (captures=%d sig_passthrough=%d sigill_skips=%s)" % (int(_NLIB.cd_tracer_captures_total()), int(_NLIB.cd_tracer_signals_total()), _ill if _ill >= 0 else "n/a"))
            return
    except Exception:
        pass
    _read_p = _native_evidence_read_path(_TRC_FILE_NAME)
    try:
        if _read_p:
            with open(_read_p, "r", encoding="utf-8", errors="replace") as _f:
                _txt = _f.read(524288)
            _caps = _trc_parse(_txt)
            if _caps:
                globals()["_PREV_SESSION_TRACER"] = _caps
                _log("Block#37 (+QP): ptrace-супервизор: захватов в прошлой сессии: %d" % len(_caps))
                for _ci in _caps[:6]:
                    _log("  +QP capture sig=%s si=%s addr=%s pc=%s comm=%s module=%s maps_trunc=%s frames=%d ts=%s" % (_ci.get("sig"), _ci.get("si_code"), _ci.get("si_addr"), _ci.get("pc"), _ci.get("comm"), _ci.get("pc_module"), _ci.get("maps_truncated"), len(_ci.get("frames") or []), _ci.get("realtime_ms")))
            elif _txt.strip():
                _log("Block#37 (+QP): tracer-отчёт есть, но не распарсен (%d байт)" % len(_txt))
            try:
                os.replace(_read_p, _read_p + ".1")
            except Exception as _rot_err:
                _log("Block#37 (+UE): report rotation failed; source retained: %s: %r" % (_read_p, _rot_err))
    except Exception as _et0:
        _log("Block#37 (+QO): tracer report consume err: %r" % (_et0,))
    try:
        _rc = int(_NLIB.cd_tracer_start(p.encode("utf-8")))
        if _rc == 0:
            _log("Block#37 (+QO): ptrace-супервизор ЗАПУЩЕН rc=0 path=%s -- следующий фолт будет пойман в ядре ДО shadowhook" % p)
        else:
            _log("Block#37 (+QO): tracer start rc=%d %s" % (_rc, _trc_rc_text(_rc)))
    except Exception as _et1:
        _log("Block#37 (+QO): cd_tracer_start err: %r" % (_et1,))


_DCG_BOUND = [False]

def _dcg_bind():
    import ctypes as _c
    lib = _NLIB
    if lib is None: return False
    if not hasattr(lib, "cd_dlclose_guard_install"): return False
    lib.cd_dlclose_guard_install.argtypes = []; lib.cd_dlclose_guard_install.restype = _c.c_int
    lib.cd_dlclose_guard_seen_total.argtypes = []; lib.cd_dlclose_guard_seen_total.restype = _c.c_int64
    lib.cd_dlclose_guard_skipped_total.argtypes = []; lib.cd_dlclose_guard_skipped_total.restype = _c.c_int64
    _DCG_BOUND[0] = True
    return True

def _dcg_log_fail(rc):
    try:
        import ctypes as _c
        _e = 0; _m = ""; _pi = -1
        if hasattr(_NLIB, "cd_dlclose_guard_err"):
            _NLIB.cd_dlclose_guard_err.argtypes = [_c.c_char_p, _c.c_int]; _NLIB.cd_dlclose_guard_err.restype = _c.c_int
            _b = _c.create_string_buffer(128); _e = int(_NLIB.cd_dlclose_guard_err(_b, 128)); _m = _b.value.decode("utf-8", "replace")
        if hasattr(_NLIB, "cd_prev_instances"):
            _NLIB.cd_prev_instances.argtypes = []; _NLIB.cd_prev_instances.restype = _c.c_int
            _pi = int(_NLIB.cd_prev_instances())
        _why = {-1: "libshadowhook не найдена", -2: "sh_hook(libdl.so, dlclose) отказал"}.get(rc, "rc=%d" % rc)
        _ctx = (" -- same-process reload: загружено ещё %d копий libculprit.so, guard ПРЕДЫДУЩЕГО инстанса продолжает работать (dlclose уже перехвачен)" % _pi) if _pi > 0 else ""
        _log("Block#38 (+TT): guard не установлен: %s (sh errno=%d %s)%s" % (_why, _e, _m or "?", _ctx))
    except Exception as _ef:
        _log("Block#38 (+TT) fail-diag err: %r" % (_ef,))

def _dcg_start():
    if not _dcg_bind():
        _log("Block#38 (+QU): в .so нет cd_dlclose_guard_* (сборка < rev 10484) -- dlclose-guard off; пересобери .so")
        return
    try:
        _rc = int(_NLIB.cd_dlclose_guard_install())
        _log("Block#38 (+QU): dlclose-guard install rc=%d (seen=%d skipped=%d) -- media/codec/GPU .so НЕ выгружаются (use-after-dlclose mitigation)" % (_rc, int(_NLIB.cd_dlclose_guard_seen_total()), int(_NLIB.cd_dlclose_guard_skipped_total())))
        if _rc != 0:
            _dcg_log_fail(_rc)
        try:
            _hk = int(_NLIB.cd_dlopen_hook_enabled()) if hasattr(_NLIB, "cd_dlopen_hook_enabled") else -1
            _wt = int(_NLIB.cd_dl_watch_enabled()) if hasattr(_NLIB, "cd_dl_watch_enabled") else -1
            _log("Block#39 (+RE): dlopen-hooks=%s (OFF = штатно, не искажают caller-namespace), dl-watcher=%s (dl_iterate_phdr adds/subs, ~200ms)" % ({1: "ON(opt-in)", 0: "OFF", -1: "n/a(.so<10494)"}.get(_hk, _hk), {1: "ON", 0: "OFF", -1: "n/a(.so<10494)"}.get(_wt, _wt)))
        except Exception as _ere:
            _log("Block#39 (+RE) state log err: %r" % (_ere,))
        try:
            if hasattr(_NLIB, "cd_dlclose_guard_diag"):
                import ctypes as _ctd
                _NLIB.cd_dlclose_guard_diag.argtypes = [_ctd.c_char_p, _ctd.c_int]; _NLIB.cd_dlclose_guard_diag.restype = _ctd.c_int
                _bd = _ctd.create_string_buffer(256); _NLIB.cd_dlclose_guard_diag(_bd, 256)
                _src = int(_NLIB.cd_dlclose_guard_dlinfo_src()) if hasattr(_NLIB, "cd_dlclose_guard_dlinfo_src") else -1
                _psrc = int(_NLIB.cd_dlclose_guard_probe_src()) if hasattr(_NLIB, "cd_dlclose_guard_probe_src") else -1
                if _psrc < 0:
                    _log("Block#38 (+RI): dlinfo=%s :: %s (src=0 -> dlinfo не резолвится => guard слеп; имена в DL-ring будут '?nodlinfo')" % ({0: "NULL", 1: "RTLD_DEFAULT", 2: "libdl-handle"}.get(_src, _src), _bd.value.decode("utf-8", "replace")))
                else:
                    _log("Block#38 (+RJ): dlinfo=%s, имя по handle через dlsym-префильтр + __loader_dlopen=%s :: %s (ldopen=0 -> точная сверка недоступна, guard форвардит, в DL-ring '?noconf'; '?nomedia' = точно не media-либа)" % ({0: "NULL", 1: "RTLD_DEFAULT", 2: "libdl-handle"}.get(_src, _src), {0: "НЕТ", 1: "RTLD_DEFAULT", 2: "libdl-dep"}.get(_psrc, _psrc), _bd.value.decode("utf-8", "replace")))
            else:
                _log("Block#38 (+RI): в .so нет cd_dlclose_guard_diag (rev < 10497) -- пересобери .so")
        except Exception as _eri:
            _log("Block#38 (+RI) diag err: %r" % (_eri,))
        try:
            if hasattr(_NLIB, "cd_tls_pool_used"):
                import ctypes as _cty
                _NLIB.cd_tls_pool_used.argtypes = []; _NLIB.cd_tls_pool_used.restype = _cty.c_int
                _NLIB.cd_tls_acquired_total.argtypes = []; _NLIB.cd_tls_acquired_total.restype = _cty.c_int64
                _NLIB.cd_tls_overflowed_total.argtypes = []; _NLIB.cd_tls_overflowed_total.restype = _cty.c_int64
                _log("Block#40 (+RF): native TLS = pthread_key-пул (нет PT_TLS/TLSDESC в хуках malloc/munmap): pool_used=%d acquired=%d overflowed=%d exit_leak_fix=%s (overflowed>0 = пул 2048 исчерпан, деградация, не краш; +RJ: exit_leak_fix=no -> слот течёт на каждом завершении треда)" % (int(_NLIB.cd_tls_pool_used()), int(_NLIB.cd_tls_acquired_total()), int(_NLIB.cd_tls_overflowed_total()), "yes" if hasattr(_NLIB, "cd_tls_dying_bound") else "no"))
            else:
                _log("Block#40 (+RF): в .so нет cd_tls_* (rev < 10495) -- динамический TLS в хуках ещё активен; пересобери .so")
        except Exception as _erf:
            _log("Block#40 (+RF) state log err: %r" % (_erf,))
    except Exception as _ed:
        _log("Block#38 (+QU): install err: %r" % (_ed,))

def _write_crash_verdict(rec):
    p = _crash_path()
    if not p: return False
    try:
        _normalize_restart_record(rec)
        rec.setdefault("event_type", "app_crash"); rec.setdefault("dropbox_tag", "data_app_crash")
        rec.setdefault("tombstone_norm_version", 1); rec.setdefault("persisted", False)
    except Exception: pass
    try:
        if _is_safemode_collateral(rec.get("exc_cls"), rec.get("exc_msg")):
            _victim = rec.get("crashed_plugin_id")
            rec["safe_mode_collateral"] = True
            rec["safemode_victim"] = _victim
            _corr = rec.get("correlated") or {}
            _root = _corr.get("culprit")
            if _root and _root != _victim and _corr.get("confidence") in ("high", "medium"):
                rec["crashed_plugin_id"] = _root
                rec["src"] = "safe-mode-collateral->corr-root"
                rec["confidence"] = _corr.get("confidence")
            else:
                rec["crashed_plugin_id"] = "safe-mode-collateral"
                rec["src"] = "safe-mode-collateral"
                rec["confidence"] = "none"
            rec["culprit_kind"] = "collateral"
            rec["reason"] = _SAFEMODE_COLLATERAL_REASON
    except Exception: pass
    try:
        _cx = rec.get("crashed_plugin_id") or rec.get("culprit")
        if _cx and _cx not in ("safe-mode-collateral", "unknown", "none") and not _restart_kind(rec):
            _b10_passive_mark_recent_owner_force(_cx, rec.get("ts"), "native_crash_owner")
    except Exception: pass
    try:
        _ok = bool(_atomic_json_write(p, rec))
    except Exception:
        _ok = False
    if not _ok:
        _jrn_event(_JEV_PERSIST_FAIL, payload="crash_verdict")
    return _ok

_LOAD_FILE_NAME = "load_verdict.json"
_LOAD_FAILS_MAX = 20
_LOAD_DEDUP_MS = 4000
_LOAD_SEEN = {}; _LOAD_SEEN_LOCK = threading.Lock()
_PY_PREFIX = "<python>."
_PY_SYS_MODS = ("importlib", "java.chaquopy", "java.", "chaquopy_java",
                "_sdk_version", "encodings.", "<frozen", "base_plugin")

def _load_verdict_path():
    return _data_path(_LOAD_FILE_NAME)

def _thr_chain(thr):
    out = []; n = 0; cur = thr
    while cur is not None and n < 12:
        n += 1
        try: cls = cur.getClass().getName()
        except Exception: cls = "?"
        try: msg = cur.getMessage()
        except Exception: msg = None
        out.append((cls, msg, cur))
        try: nxt = cur.getCause()
        except Exception: nxt = None
        if nxt is cur: break
        cur = nxt
    return out

def _py_module_from_throwable(chain):
    for (_c, _m, exc) in chain:
        try: st = exc.getStackTrace()
        except Exception: st = None
        if st is None: continue
        for el in st:
            try:
                cn = el.getClassName() or ""
                mn = el.getMethodName() or ""
                fn = el.getFileName() or ""
                ln = el.getLineNumber()
            except Exception:
                continue
            if not cn.startswith(_PY_PREFIX): continue
            if mn != "<module>": continue
            mod = cn[len(_PY_PREFIX):]
            low = mod.lower()
            if any(low == s or low.startswith(s) for s in _PY_SYS_MODS): continue
            return mod, (fn or (mod + ".py")), (int(ln) if ln is not None else -1)
    return None, None, -1

def _load_reason(chain):
    for (cls, msg, _e) in reversed(chain):
        if msg:
            scls = cls.rsplit(".", 1)[-1] if cls else "?"
            return ("%s: %s" % (scls, msg)) if (scls and scls not in (msg or "")) else msg
    for (cls, _m, _e) in reversed(chain):
        if cls and cls != "?":
            return cls.rsplit(".", 1)[-1]
    return "unknown"

_MEM_PRESSURE_REASON = "🧠 Python MemoryError — процесс исчерпал память (Python-куча); стек мог не сформироваться"
_JAVA_OOM_REASON = "🧠 java.lang.OutOfMemoryError — исчерпана Java-куча (Dalvik heap); аварийная аллокация в стеке — жертва, не причина"
def _is_java_heap_oom(exc_cls, exc_msg):
    try:
        ec = str(exc_cls or ""); em = str(exc_msg or "")
        return ("OutOfMemoryError" in ec) or ("OutOfMemoryError" in em)
    except Exception:
        return False
def _is_py_memoryerror(exc_cls, exc_msg):
    try:
        ec = str(exc_cls or ""); em = str(exc_msg or "")
        return ("MemoryError" in ec) or ("MemoryError" in em)
    except Exception:
        return False


_SAFEMODE_COLLATERAL_REASON = "safe-mode collateral — плагин заблокирован SafeModeImporter (жертва, не причина); корень — плагин, вызвавший safe-mode"
def _is_safemode_collateral(exc_cls, exc_msg):
    try:
        ec = str(exc_cls or ""); em = str(exc_msg or "")
        return ("Safe mode enabled" in em) or ("Safe mode enabled" in ec) or ("SafeModeImporter" in em)
    except Exception:
        return False


def _record_load_fail(scoped_pid, thr, where):
    try: chain = _thr_chain(thr)
    except Exception: chain = []
    py_mod, py_file, py_line = _py_module_from_throwable(chain)
    reason = _load_reason(chain)
    top_cls = chain[0][0] if chain else "?"
    top_msg = chain[0][1] if chain else None
    if where == "loadPlugin" and scoped_pid:
        culprit = scoped_pid; src = "scope/loadPlugin"; conf = "high" if py_mod else "medium"
    elif py_mod:
        culprit = py_mod; src = "py-frame"; conf = "high"
    elif scoped_pid:
        culprit = scoped_pid; src = "scope/" + where; conf = "medium"
    else:
        culprit = "unknown"; src = "none"; conf = "low"
    rec = {"had_load_fail": True, "event_type": "plugin_load_exception", "dropbox_tag": "plugin_load_blocked", "tombstone_norm_version": 1, "culprit": culprit, "src": src, "confidence": conf,
           "where": where, "scoped_pid": scoped_pid, "py_module": py_mod,
           "py_file": py_file, "py_line": py_line, "reason": reason,
           "exc_cls": top_cls, "exc_msg": top_msg, "ts": int(time.time() * 1000)}
    if _is_py_memoryerror(top_cls, top_msg) or ("MemoryError" in (reason or "")):
        rec["mem_pressure"] = True
        rec["reason"] = _JAVA_OOM_REASON if (_is_java_heap_oom(top_cls, top_msg) or ("OutOfMemoryError" in (reason or ""))) else _MEM_PRESSURE_REASON
        reason = rec["reason"]
    key = "%s|%s|%s" % (culprit, reason, where); now = rec["ts"]
    with _LOAD_SEEN_LOCK:
        if now - _LOAD_SEEN.get(key, 0) < _LOAD_DEDUP_MS: return
        _LOAD_SEEN[key] = now
    try: _load_verdict_log(rec, "live")
    except Exception: pass
    try: _persist_load_fail(rec)
    except Exception: pass

_PERSIST_IO_LOCK = __import__("threading").Lock()


def _persist_append(path, rec, max_n, log_tag=None):
    if not path:
        if log_tag: _log("%s: нет пути -- пропуск" % log_tag)
        return
    _PERSIST_IO_LOCK.acquire()
    try:
        cur = []
        if os.path.exists(path):
            try:
                with open(path, "r", encoding="utf-8") as f: cur = list(json.load(f))
            except Exception: cur = []
        cur.append(rec)
        _atomic_json_write(path, cur, max_n)
        if log_tag: _log("%s: zapisano %d zapisej -> %s" % (log_tag, min(len(cur), max_n), os.path.basename(path)))
    except Exception as e:
        if log_tag: _log("%s err: %s: %s" % (log_tag, type(e).__name__, e))
    finally:
        try: _PERSIST_IO_LOCK.release()
        except Exception: pass

def _persist_load_fail(rec):
    _persist_append(_load_verdict_path(), rec, _LOAD_FAILS_MAX)

_RC_PROC_START = time.time()

_UI_PROCESS_START_S = None
_UI_PROCESS_START_KIND = None

def _ui_process_start():
    global _UI_PROCESS_START_S, _UI_PROCESS_START_KIND
    if _UI_PROCESS_START_S is None:
        now = time.time()
        try: age = _proc_age_ms()
        except Exception: age = -1
        if age < 0:
            try:
                _up = find_class("android.os.SystemClock").elapsedRealtime()
                _born = find_class("android.os.Process").getStartElapsedRealtime()
                _android_age = float(_up) - float(_born)
                if float(_born) > 0 and _android_age >= 0: age = _android_age
            except Exception: pass
        if age >= 0:
            _UI_PROCESS_START_S = now - age / 1000.0
            _UI_PROCESS_START_KIND = "process"
        else:
            _UI_PROCESS_START_S = float(_RC_PROC_START)
            _UI_PROCESS_START_KIND = "detector"
    return _UI_PROCESS_START_S

def _ui_timestamp_s(value):
    try:
        if isinstance(value, bool) or value is None: return None
        if isinstance(value, str) and "-" in value and ":" in value:
            value = time.mktime(time.strptime(value.strip(), "%Y-%m-%d %H:%M:%S"))
        v = float(value)
        if v > 1e11: v /= 1000.0
        if not (0 < v < float("inf")): return None
        return v
    except Exception:
        return None

def _ui_event_scope(record, event_s):
    start = _ui_process_start()
    if record.get("event_type") == "process_exit_postmortem" or record.get("src") == "exitinfo/b34":
        return "history", "postmortem"
    if event_s is None: return "history", "unknown_time"
    if event_s > time.time() + 5.0: return "history", "future_time"
    for key in ("proc_pid", "process_pid", "os_pid"):
        try:
            pid = int(record.get(key) or 0)
            if pid > 0 and pid != os.getpid(): return "history", "other_process"
        except Exception: pass
    if event_s < int(start): return "history", "before_process"
    return "current", _UI_PROCESS_START_KIND


def _rc_rearm_orphan(base):
    if not base: return
    proc = base + ".processing"
    try:
        if os.path.exists(base): return
        _rt = None; _rm = None
        for _sfx in (".retry", ".retry.2", ".retry.3"):
            _c = base + _sfx
            try:
                if os.path.exists(_c):
                    _m = os.path.getmtime(_c)
                    if _rm is None or _m < _rm: _rm = _m; _rt = _c
            except Exception: pass
        if _rt is not None:
            _pc = _rc_publish_noreplace3(_rt, base)
            if _pc == -1 and not globals().get("_RC_NOREP_WARN"):
                globals()["_RC_NOREP_WARN"] = True
                try: _log("+MU: retry publish отложен - нет атомарного no-replace (os.link/renameat2), источник сохранён: %s" % _rt)
                except Exception: pass
            return
        if not os.path.exists(proc): return
        if os.path.getmtime(proc) >= _RC_PROC_START: return
        _ppc = _rc_publish_noreplace3(proc, base)
        if _ppc == -1:
            if not globals().get("_RC_PROC_NOREP_WARN"):
                globals()["_RC_PROC_NOREP_WARN"] = True
                try: _log("+MV: .processing publish отложен - нет атомарного no-replace (os.link/renameat2), источник сохранён: %s" % proc)
                except Exception: pass
    except Exception:
        pass

def _rc_read_path(p):
    try:
        mp = _aw_mirror_path(p) if p else None
    except Exception:
        mp = None
    _rc_rearm_orphan(p)
    if mp: _rc_rearm_orphan(mp)
    try: pe = bool(p) and os.path.exists(p)
    except Exception: pe = False
    try: me = bool(mp) and os.path.exists(mp)
    except Exception: me = False
    if pe and me:
        try:
            if os.path.getmtime(mp) > os.path.getmtime(p): return mp
        except Exception: pass
        return p
    if pe: return p
    if me: return mp
    return None

def _rc_remove_both(p):
    if not p: return
    try: mp = _aw_mirror_path(p)
    except Exception: mp = None
    for _fp in (p, mp):
        try:
            if _fp and os.path.exists(_fp): os.remove(_fp)
        except Exception: pass

def _rc_take_path(p):
    if not p: return None
    _PERSIST_IO_LOCK.acquire()
    try:
        rp = _rc_read_path(p)
        if not rp: return None
        try: mp = _aw_mirror_path(p)
        except Exception: mp = None
        try: _claim_m = os.path.getmtime(rp)
        except Exception: _claim_m = None
        tmp = rp + ".processing"
        try:
            if os.path.exists(tmp) and _rc_park_pending(rp, tmp) is None:
                return None
        except Exception:
            return None
        try:
            os.rename(rp, tmp); claimed = tmp
        except Exception:
            return None
        _other = p if rp != p else mp
        if _other and _other != rp:
            try:
                if os.path.exists(_other) and (_claim_m is None or os.path.getmtime(_other) <= _claim_m):
                    os.remove(_other)
            except Exception: pass
        return claimed
    finally:
        try: _PERSIST_IO_LOCK.release()
        except Exception: pass

def _rc_expect_list(raw):
    if not isinstance(raw, list):
        raise ValueError("verdict: expected list, got %s" % type(raw).__name__)
    for _i, _it in enumerate(raw):
        if not isinstance(_it, dict):
            raise ValueError("verdict: item %d expected object, got %s" % (_i, type(_it).__name__))
    return list(raw)

def _rc_expect_dict(raw):
    if not isinstance(raw, dict):
        raise ValueError("verdict: expected object, got %s" % type(raw).__name__)
    return raw

def _rc_is_quarantine_name(nm):
    try:
        return nm.endswith((".corrupted.1", ".corrupted.2", ".corrupted.3", ".retry", ".retry.2", ".retry.3"))
    except Exception:
        return False

def _rc_is_stale_processing(path, nm):
    try:
        if not nm.endswith(".processing"): return False
        return (time.time() - os.path.getmtime(path)) >= 60.0
    except Exception:
        return False

def _rc_native_noreplace(src, dst):
    try:
        if globals().get("_ABI_FAIL"): return -1
        _nl = globals().get("_NLIB", None)
        if _nl is None or not hasattr(_nl, "cd_rename_noreplace"): return -1
        _rc = int(_nl.cd_rename_noreplace(os.fsencode(src), os.fsencode(dst)))
        if _rc == 0: return 1
        if _rc == -17: return 0
        return -1
    except Exception:
        return -1

def _rc_publish_noreplace3(src, dst):
    try:
        os.link(src, dst)
    except FileExistsError:
        return 0
    except Exception:
        return _rc_native_noreplace(src, dst)
    try:
        os.unlink(src)
        return 1
    except Exception:
        try: os.unlink(dst)
        except Exception: pass
        return -1

def _rc_publish_noreplace(src, dst):
    return _rc_publish_noreplace3(src, dst) == 1

def _rc_park_pending(base, src):
    for _sfx in (".retry", ".retry.2", ".retry.3"):
        _dst = base + _sfx
        try:
            _pc = _rc_publish_noreplace3(src, _dst)
            if _pc == 1: return _dst
            if _pc == 0: continue
            return None
        except Exception:
            return None
    return None

def _rc_clear_taken(_rp, ok, err=None):
    if not _rp: return
    try:
        if (not ok) and os.path.isfile(_rp) and os.path.getsize(_rp) > 0:
            _base = _rp[:-11] if _rp.endswith(".processing") else _rp
            if isinstance(err, (OSError, MemoryError)):
                _dst = None
                try:
                    if _rc_publish_noreplace(_rp, _base):
                        _dst = _base
                    else:
                        _dst = _rc_park_pending(_base, _rp)
                except Exception: _dst = None
                try:
                    if _dst:
                        _log("+MR: временная ошибка чтения (%s) - вердикт возвращён для повтора: %s" % (type(err).__name__, _dst))
                    else:
                        _log("+MS: не удалось вернуть вердикт для повтора (%s) - источник сохранён: %s" % (type(err).__name__, _rp))
                except Exception: pass
                return
            _q1 = _base + ".corrupted.1"
            _q2 = _base + ".corrupted.2"; _q3 = _base + ".corrupted.3"
            try:
                if os.path.exists(_q2): os.replace(_q2, _q3)
            except Exception: pass
            try:
                if os.path.exists(_q1): os.replace(_q1, _q2)
            except Exception: pass
            try:
                os.replace(_rp, _q1)
            except Exception:
                try: _log("+MS: карантин не удался - источник сохранён: %s" % _rp)
                except Exception: pass
            else:
                try: _log("+MQ: повреждённый verdict-файл отправлен в карантин: %s" % _q1)
                except Exception: pass
            return
    except Exception: pass
    try: os.remove(_rp)
    except Exception: pass

def _read_and_clear_json_list(path):
    if not path: return []
    out = []
    _rp = _rc_take_path(path)
    try:
        if _rp:
            with open(_rp, "r", encoding="utf-8") as f: out = _rc_expect_list(json.load(f))
    except Exception as _mr_e:
        out = None
        if _rp:
            _rc_clear_taken(_rp, False, _mr_e)
            _rp = None
    if _rp:
        _rc_clear_taken(_rp, out is not None)
    if out is None: out = []
    return out
def _read_and_clear_json_dict(path):
    if not path: return None
    rec = None
    _rp = _rc_take_path(path)
    try:
        if _rp:
            with open(_rp, "r", encoding="utf-8") as f: rec = _rc_expect_dict(json.load(f))
    except Exception as _mr_e:
        rec = None
        if _rp:
            _rc_clear_taken(_rp, False, _mr_e)
            _rp = None
    if _rp:
        _rc_clear_taken(_rp, rec is not None)
    return rec

def _read_and_clear_load_fails():
    return _read_and_clear_json_list(_load_verdict_path())

_UI_CTX = None
_UI_CTX_MS = 10000
_UI_CTX_MAX_AGE_MS = 120000

def _jfield(obj, name):
    try: cls = obj.getClass()
    except Exception: return None
    while cls is not None:
        try:
            f = cls.getDeclaredField(name); f.setAccessible(True)
            return f
        except Exception:
            try: cls = cls.getSuperclass()
            except Exception: return None
    return None

_UI_CTX_PLUGINS_MS = 120000
_B42_T0_MS = int(time.time() * 1000)
_UI_CTX_PLUGINS = [None, 0]

def _ui_ctx_refresh():
    global _UI_CTX
    d = {"ts": int(time.time() * 1000), "screens": -1}
    try:
        from client_utils import get_last_fragment
        fr = get_last_fragment()
        lay = fr.getParentLayout() if fr is not None else None
        if lay is not None:
            stk = lay.getFragmentStack()
            d["screens"] = int(stk.size())
            try:
                names = []
                for _i in range(int(stk.size())):
                    try: names.append(str(stk.get(_i).getClass().getSimpleName()))
                    except Exception: pass
                if names:
                    d["fragment_stack"] = names
                    d["screen"] = names[-1]
            except Exception: pass
    except Exception: pass
    try:
        g = _b42_gc_stats()
        if g: d["gc"] = g
    except Exception: pass
    try:
        _nowp = d["ts"]
        _ttlp = 10000 if (_nowp - _B42_T0_MS) < 90000 else _UI_CTX_PLUGINS_MS
        if _UI_CTX_PLUGINS[0] is None or (_nowp - _UI_CTX_PLUGINS[1]) >= _ttlp:
            _UI_CTX_PLUGINS[0] = _b42_enabled_plugins() or []; _UI_CTX_PLUGINS[1] = _nowp if _UI_CTX_PLUGINS[0] else (_nowp - _UI_CTX_PLUGINS_MS + 10000)
        if _UI_CTX_PLUGINS[0]:
            d["plugins"] = _UI_CTX_PLUGINS[0]
    except Exception: pass
    try:
        il = jclass("org.telegram.messenger.ImageLoader").getInstance()
        f = _jfield(il, "memCache")
        mc = f.get(il) if f is not None else None
        if mc is not None:
            sz = int(mc.size()); mx = int(mc.maxSize())
            d["img_cache_mb"] = round(sz / 1048576.0, 1); d["img_cache_max_mb"] = round(mx / 1048576.0, 1)
            if mx > 0: d["img_cache_pct"] = round(sz * 100.0 / mx, 1)
    except Exception: pass
    _UI_CTX = d
    return d

def _ui_ctx_snapshot():
    d = _UI_CTX
    if not isinstance(d, dict): return None
    try:
        age = int(time.time() * 1000) - int(d.get("ts", 0))
        if age > _UI_CTX_MAX_AGE_MS: return None
        r = dict(d); r["age_ms"] = max(0, age)
        return r
    except Exception:
        return None

def _ui_ctx_attach(rec):
    try:
        if isinstance(rec, dict) and "ui_ctx" not in rec:
            s = _ui_ctx_snapshot()
            if s:
                _ui_ctx_plugins_fix(s, rec)
                rec["ui_ctx"] = s
        return rec.get("ui_ctx") if isinstance(rec, dict) else None
    except Exception:
        return None

def _ui_ctx_plugins_fix(s, rec):
    try:
        now = int(time.time() * 1000)
        if (now - _B42_T0_MS) < 90000 or (now - int(_UI_CTX_PLUGINS[1] or 0)) > 10000:
            pl = _b42_enabled_plugins()
            if pl:
                s["plugins"] = pl
                _UI_CTX_PLUGINS[0] = pl; _UI_CTX_PLUGINS[1] = now
    except Exception:
        pass
    try:
        cul = rec.get("culprit") or rec.get("crashed_plugin_id")
        if not cul or not isinstance(cul, str) or cul == "unknown":
            return
        pl = list(s.get("plugins") or [])
        if any(str(x).split(" ", 1)[0] == cul for x in pl):
            return
        live = set()
        try: live = set(_b27_live_pids())
        except Exception: live = set()
        try:
            with _REG_LOCK:
                if cul in _REGISTRY: live.add(cul)
        except Exception:
            pass
        if cul not in live:
            return
        ver = None
        try:
            for e in _b41_plugin_entries_safe():
                if _safe_str(e.getKey()) == cul:
                    ver = _b11_attr(e.getValue(), "getVersion", "version"); break
        except Exception:
            ver = None
        if not ver:
            ver = _b42_file_version(cul)
        pl.append("%s %s" % (cul, ver if ver else "?"))
        s["plugins"] = sorted(pl)
        s["plugins_culprit_added"] = cul
    except Exception:
        pass

def _ui_ctx_str(u):
    if not isinstance(u, dict): return ""
    try:
        p = []
        sc = int(u.get("screens", -1))
        p.append("экранов=%s" % (sc if sc >= 0 else "?"))
        if u.get("fragment_stack"):
            _fs = list(u.get("fragment_stack") or [])
            p.append("экран=%s (стек: %s%s)" % (_fs[-1], " > ".join(_fs[-6:]), " …" if len(_fs) > 6 else ""))
        elif u.get("screen"):
            p.append("экран=%s" % u.get("screen"))
        if u.get("plugins"):
            p.append("плагинов вкл.=%d" % len(u.get("plugins") or []))
        if u.get("gc"):
            _gcs = _b42_gc_stats_str(u.get("gc"))
            if _gcs: p.append(_gcs)
        if u.get("img_cache_max_mb") is not None:
            p.append("кэш картинок=%s/%s МБ%s" % (u.get("img_cache_mb"), u.get("img_cache_max_mb"), (" (%s%%)" % u.get("img_cache_pct")) if u.get("img_cache_pct") is not None else ""))
        if u.get("age_ms") is not None: p.append("снимок %d с назад" % (int(u["age_ms"]) // 1000))
        return ", ".join(p)
    except Exception:
        return ""

def _verdict_log(rec, when, hdr, who, scope_label, footer, unk_tail=" — нет имени модуля в стеке", labels=("причина", "модуль", "исключение")):
    try:
        _log("============= %s VERDICT (%s) =============" % (hdr, when))
        cul = rec.get("culprit"); conf = rec.get("confidence")
        if cul and cul != "unknown":
            _log("ВИНОВНИК %s: %r conf=%s where=%s src=%s" % (who, cul, conf, rec.get("where"), rec.get("src")))
        else:
            _log("ВИНОВНИК %s: неизвестен (where=%s)%s" % (who, rec.get("where"), unk_tail))
        _log("  %s: %s" % (labels[0], rec.get("reason")))
        pf = rec.get("py_file")
        if pf: _log("  %s: %s:%s" % (labels[1], pf, rec.get("py_line")))
        sp = rec.get("scoped_pid")
        if sp and sp != cul: _log("  %s: %s" % (scope_label, sp))
        _log("  %s: %s: %s" % (labels[2], rec.get("exc_cls"), rec.get("exc_msg")))
        if when == "live": _ui_ctx_attach(rec)
        _ucs = _ui_ctx_str(rec.get("ui_ctx"))
        if _ucs: _log("  контекст: %s" % _ucs)
        _log(footer)
    except Exception: pass

def _load_verdict_log(rec, when):
    _verdict_log(rec, when, 'LOAD/IMPORT', 'ЗАГРУЗКИ', 'scope-плагин(loadPlugin-арг)', "====================================================")
_HOOK_FILE_NAME = "hook_verdict.json"
_HOOK_FAILS_MAX = 20
_HOOK_DEDUP_MS = 4000
_HOOK_SEEN = {}; _HOOK_SEEN_LOCK = threading.Lock()
_BLOCK9_ON = True

def _hook_verdict_path():
    return _data_path(_HOOK_FILE_NAME)

def _hook_scope_pid():
    try:
        c = get_culprit_for_tid(_cur_tid())
        if c and c != "unknown": return c
    except Exception: pass
    return None

def _record_hook_fail(thr, where="executeHook", scoped=None):
    if not _BLOCK9_ON: return
    try: chain = _thr_chain(thr)
    except Exception: chain = []
    if not chain: return
    py_mod, py_file, py_line = _py_module_from_throwable(chain)
    reason = _load_reason(chain)
    top_cls = chain[0][0] if chain else "?"
    top_msg = chain[0][1] if chain else None
    if scoped is None: scoped = _hook_scope_pid()
    if py_mod:
        culprit = py_mod; src = "py-frame"; conf = "high"
    elif scoped:
        culprit = scoped; src = "scope/" + where; conf = "medium"
    else:
        culprit = "unknown"; src = "none"; conf = "low"
    rec = {"had_hook_fail": True, "culprit": culprit, "src": src, "confidence": conf,
           "where": where, "scoped_pid": scoped, "py_module": py_mod,
           "py_file": py_file, "py_line": py_line, "reason": reason,
           "exc_cls": top_cls, "exc_msg": top_msg, "ts": int(time.time() * 1000)}
    _hook_live_mark(rec)
    key = "%s|%s|%s" % (culprit, reason, where); now = rec["ts"]
    with _HOOK_SEEN_LOCK:
        if now - _HOOK_SEEN.get(key, 0) < _HOOK_DEDUP_MS: return
        _HOOK_SEEN[key] = now
    try: _hook_verdict_log(rec, "live")
    except Exception: pass
    try: _persist_hook_fail(rec)
    except Exception: pass

def _persist_hook_fail(rec):
    p = _hook_verdict_path()
    if not p: return
    _PERSIST_IO_LOCK.acquire()
    try:
        cur = []
        if os.path.exists(p):
            try:
                with open(p, "r", encoding="utf-8") as f: cur = list(json.load(f))
            except Exception: cur = []
        try:
            rec.setdefault("event_type", "hook_exception"); rec.setdefault("dropbox_tag", "data_app_crash"); rec.setdefault("tombstone_norm_version", 1)
        except Exception: pass
        cur.append(rec)
        _atomic_json_write(p, cur, _HOOK_FAILS_MAX)
    except Exception: pass
    finally:
        try: _PERSIST_IO_LOCK.release()
        except Exception: pass

def _read_and_clear_hook_fails():
    return _read_and_clear_json_list(_hook_verdict_path())

_HOOK_LIVE_LINES = {}
_HOOK_ECHO_MS = 2000
def _hook_live_mark(rec):
    try:
        if len(_HOOK_LIVE_LINES) > 256: _HOOK_LIVE_LINES.clear()
        _HOOK_LIVE_LINES[(rec.get("culprit"), str(rec.get("py_line")))] = int(rec.get("ts") or time.time() * 1000)
    except Exception: pass
def _hook_verdict_log(rec, when):
    _verdict_log(rec, when, 'RUNTIME HOOK', 'ХУКА', 'scope-плагин(tid)', "====================================================")
_GATE_FILE_NAME = "gate_verdict.json"
_GATE_FAILS_MAX = 20
_GATE_DEDUP_MS = 60000
_GATE_SEEN = {}; _GATE_SEEN_LOCK = threading.Lock()
_BLOCK11_ON = True
_B11_TIMERS = []
_PC_CLASS = "com.exteragram.messenger.plugins.PluginsController"
_PPE_CLASS = "com.exteragram.messenger.plugins.PythonPluginsEngine"
_XCFG_CLASS = "com.exteragram.messenger.ExteraConfig"

def _b11_jc(name):
    try:
        return jclass(name)
    except BaseException:
        pass
    try:
        return find_class(name)
    except BaseException:
        return None

def _b11_attr(obj, *names):
    for n in names:
        try:
            v = getattr(obj, n)
        except Exception:
            continue
        try:
            return v() if callable(v) else v
        except Exception:
            continue
    return None

def _gate_verdict_path():
    return _data_path(_GATE_FILE_NAME)

_B11_CTRL_HOW = [None, None]

def _b11_controller():
    jc = _b11_jc(_PC_CLASS)
    if jc is None:
        _B11_CTRL_HOW[0] = None; _B11_CTRL_HOW[1] = "class not found"
        return None
    last = None
    for how in ("getInstance", "Companion.getInstance", "INSTANCE"):
        try:
            if how == "getInstance":
                c = jc.getInstance()
            elif how == "Companion.getInstance":
                c = getattr(jc, "Companion").getInstance()
            else:
                c = getattr(jc, "INSTANCE")
        except BaseException as e:
            last = "%s: %r" % (how, e)
            continue
        if c is not None:
            _B11_CTRL_HOW[0] = how; _B11_CTRL_HOW[1] = last
            return c
    _B11_CTRL_HOW[0] = None; _B11_CTRL_HOW[1] = last
    return None

def _b11_runtime_sdk():
    jc = _b11_jc(_PPE_CLASS)
    if jc is None: return None
    v = _b11_attr(jc, "getSDK_VERSION", "SDK_VERSION")
    return str(v) if v is not None else None

def _b11_safe_mode():
    jc = _b11_jc(_XCFG_CLASS)
    if jc is None: return None
    v = _b11_attr(jc, "getPluginsSafeMode")
    return bool(v) if v is not None else None

def _b11_plugin_entries():
    ctrl = _b11_controller()
    if ctrl is None: return []
    m = _b11_attr(ctrl, "getPlugins", "plugins")
    if m is None: return []
    last = None
    for _ in range(3):
        try: return list(m.entrySet().toArray())
        except Exception as e: last = e
    try: _log("Block#11: entrySet snapshot failed: %s" % last)
    except Exception: pass
    return []

def _b11_is_loaded(pid):
    try:
        with _REG_LOCK:
            r = _REGISTRY.get(pid)
        if r and r.get("inst"): return True
    except Exception: pass
    return False

def _record_gate_fail(pid, kind, reason, thr=None, extra=None):
    if not _BLOCK11_ON: return
    py_mod = py_file = None; py_line = -1; top_cls = "?"; top_msg = None
    if thr is not None:
        try: chain = _thr_chain(thr)
        except Exception: chain = []
        if chain:
            py_mod, py_file, py_line = _py_module_from_throwable(chain)
            r2 = _load_reason(chain)
            if r2 and r2 != "unknown": reason = r2
            top_cls = chain[0][0]; top_msg = chain[0][1]
    if py_mod:
        culprit = py_mod; src = "py-frame"; conf = "high"
    elif pid:
        culprit = pid; src = "plugins-map/" + kind; conf = "high" if thr is not None else "medium"
    else:
        culprit = "unknown"; src = "none"; conf = "low"
    _gv_lib = False
    try:
        _cul_s = culprit if isinstance(culprit, str) else ""
        _gv_dotted = ("." in _cul_s) and (" " not in _cul_s) and (not _cul_s.endswith(".")) and (not _cul_s.startswith("."))
        _gv_known = set()
        try: _gv_known = set(_load_known() or [])
        except Exception: _gv_known = set()
        if _gv_dotted and _cul_s and (_cul_s not in _gv_known):
            _gv_lib = True
            if conf == "high": conf = "medium"
            src = (src or "none") + "?lib-style"
    except Exception:
        _gv_lib = False
    rec = {"had_gate_fail": True, "event_type": "plugin_gate_blocked", "dropbox_tag": "plugin_gate_blocked", "tombstone_norm_version": 1, "culprit": culprit, "src": src, "confidence": conf,
           "kind": kind, "pid": pid, "py_module": py_mod, "py_file": py_file,
           "py_line": py_line, "reason": reason, "exc_cls": top_cls, "exc_msg": top_msg,
           "extra": extra, "ts": int(time.time() * 1000)}
    if _gv_lib:
        rec["library_style_id"] = True
        rec["note"] = "возможно вендоренная зависимость (library-style id вида a.b.c); инициатор импорта (плагин) не определён"
    key = "%s|%s|%s" % (culprit, reason, kind); now = rec["ts"]
    with _GATE_SEEN_LOCK:
        if now - _GATE_SEEN.get(key, 0) < _GATE_DEDUP_MS: return
        _GATE_SEEN[key] = now
    try: _gate_verdict_log(rec, "live")
    except Exception: pass
    try: _persist_gate_fail(rec)
    except Exception: pass

def _persist_gate_fail(rec):
    _persist_append(_gate_verdict_path(), rec, _GATE_FAILS_MAX)

def _read_and_clear_gate_fails():
    return _read_and_clear_json_list(_gate_verdict_path())

def _gate_verdict_log(rec, when):
    try:
        _log("============= PRE-IMPORT/GATE VERDICT (%s) =============" % when)
        cul = rec.get("culprit"); conf = rec.get("confidence")
        if cul and cul != "unknown":
            _log("ВИНОВНИК ВОРОТ ЗАГРУЗКИ: %r conf=%s kind=%s src=%s" % (cul, conf, rec.get("kind"), rec.get("src")))
        else:
            _log("ВИНОВНИК ВОРОТ ЗАГРУЗКИ: неизвестен (kind=%s)" % rec.get("kind"))
        _log("  причина: %s" % rec.get("reason"))
        pf = rec.get("py_file")
        if pf: _log("  модуль: %s:%s" % (pf, rec.get("py_line")))
        ex = rec.get("extra")
        if ex: _log("  детали: %s" % ex)
        ec = rec.get("exc_cls")
        if ec and ec != "?": _log("  исключение: %s: %s" % (ec, rec.get("exc_msg")))
        _log("=======================================================")
    except Exception: pass

def _b11_scan(reason="scan"):
    if not _BLOCK11_ON: return
    try:
        sm = _b11_safe_mode()
        if sm is True:
            _record_gate_fail(None, "safe-mode",
                              "движок в SAFE-MODE -> плагины не загружаются (тихо, без исключения)",
                              extra="ExteraConfig.getPluginsSafeMode()=true")
    except Exception: pass
    rt_sdk = _b11_runtime_sdk()
    entries = _b11_plugin_entries()
    for ent in entries:
        try:
            pid = str(ent.getKey())
            pj = ent.getValue()
        except Exception:
            continue
        if pj is None: continue
        err = _b11_attr(pj, "getError", "error")
        if err is not None:
            try: _intern(pid); _save_known(pid)
            except Exception: pass
            _record_gate_fail(pid, "error",
                              "движок проглотил исключение загрузки (plugins[%s].error)" % pid, thr=err)
            continue
        try:
            if _b11_is_loaded(pid): continue
        except Exception: pass
        psdk = _b11_attr(pj, "getSdkVersion", "sdkVersion")
        psdk = str(psdk) if psdk is not None else ""
        pav = _b11_attr(pj, "getAppVersion", "appVersion")
        pav = str(pav) if pav is not None else ""
        req = _b11_attr(pj, "getRequirements", "requirements")
        try: req = list(req) if req is not None else []
        except Exception: req = []
        if rt_sdk and psdk and psdk != rt_sdk and rt_sdk != "unknown":
            _record_gate_fail(pid, "sdk-version",
                              "несовпадение sdk_version (плагин=%s, рантайм=%s) -> вероятная тихая не-загрузка" % (psdk, rt_sdk),
                              extra="app_version(min)=%s requirements=%s" % (pav or "-", req or "-"))

_B11P_ON = True
_PREIMPORT_DIR = None
_PREIMPORT_FINDER = None

def _b11p_plugins_dir():
    global _PREIMPORT_DIR
    if _PREIMPORT_DIR is not None:
        return _PREIMPORT_DIR
    d = None
    try:
        PC = jclass(_PC_CLASS).getInstance()
        pd = getattr(PC, "pluginsDir", None)
        if pd is not None:
            try: d = str(pd.getAbsolutePath())
            except Exception: d = str(pd)
    except Exception:
        d = None
    if not d:
        try:
            fp = globals().get("__file__")
            if isinstance(fp, str) and fp:
                d = os.path.dirname(fp)
        except Exception:
            d = None
    _PREIMPORT_DIR = d or ""
    return _PREIMPORT_DIR

def _b11p_record(fullname, module, exc):
    if not _BLOCK11_ON or not _B11P_ON: return
    pid = None
    if isinstance(fullname, str) and fullname and fullname != _SELF_ID and fullname != __id__:
        pid = fullname
    if pid is None:
        try:
            cand = getattr(module, "__id__", None)
            if isinstance(cand, str) and cand: pid = cand
        except Exception: pass
    py_file = None; py_line = -1
    try:
        tb = getattr(exc, "__traceback__", None)
        while tb is not None:
            try:
                g = tb.tb_frame.f_globals
                fn = g.get("__file__")
                if fn: py_file = fn
                py_line = tb.tb_lineno
            except Exception: pass
            tb = tb.tb_next
    except Exception: pass
    try: ecls = type(exc).__name__
    except Exception: ecls = "?"
    try: emsg = str(exc)
    except Exception: emsg = None
    reason = "падение во время импорта модуля плагина (до on_plugin_load): %s: %s" % (ecls, emsg)
    extra = "pre-import module=%s" % fullname
    if py_file: extra += " @ %s:%s" % (py_file, py_line)
    try:
        _intern(pid); _save_known(pid)
    except Exception: pass
    _record_gate_fail(pid, "pre-import", reason, thr=None, extra=extra)
    try: _log("Block#11P: поймано падение импорта плагина %r (%s)" % (pid or fullname, ecls))
    except Exception: pass

class _PreImportGuardLoader:
    def __init__(self, real, fullname):
        self._real = real
        self._fullname = fullname
    def create_module(self, spec):
        try:
            return self._real.create_module(spec)
        except Exception:
            return None
    def exec_module(self, module):
        try:
            self._real.exec_module(module)
        except BaseException as e:
            try: _b11p_record(self._fullname, module, e)
            except Exception: pass
            raise
    def __getattr__(self, name):
        if name in ("_real", "_fullname"):
            raise AttributeError(name)
        return getattr(self._real, name)

class _PreImportFinder:
    def find_spec(self, fullname, path=None, target=None):
        if not _B11P_ON: return None
        try:
            pdir = _b11p_plugins_dir()
            if not pdir: return None
            spec = None
            for finder in list(_sys.meta_path):
                if finder is self: continue
                fs = getattr(finder, "find_spec", None)
                if fs is None: continue
                try: spec = fs(fullname, path, target)
                except Exception: spec = None
                if spec is not None: break
            if spec is None: return None
            loader = getattr(spec, "loader", None)
            origin = getattr(spec, "origin", None)
            if loader is None or not isinstance(origin, str): return spec
            if isinstance(loader, _PreImportGuardLoader): return spec
            try: in_pdir = (os.path.dirname(origin) == pdir) or origin.startswith(pdir)
            except Exception: in_pdir = False
            if not in_pdir: return spec
            try:
                spec.loader = _PreImportGuardLoader(loader, fullname)
            except Exception:
                return spec
            return spec
        except Exception:
            return None

def _b11p_install():
    global _PREIMPORT_FINDER
    if not _B11P_ON: return
    if _PREIMPORT_FINDER is not None: return
    try:
        _b11p_plugins_dir()
        f = _PreImportFinder()
        _sys.meta_path.insert(0, f)
        _PREIMPORT_FINDER = f
        _log("Block#11P: pre-import gate installed (dir=%s)" % (_PREIMPORT_DIR or "?"))
    except Exception as e:
        try: _log("Block#11P install err: %s" % e)
        except Exception: pass

def _b11p_uninstall():
    global _PREIMPORT_FINDER
    f = _PREIMPORT_FINDER
    if f is None: return
    try:
        if f in _sys.meta_path: _sys.meta_path.remove(f)
    except Exception: pass
    _PREIMPORT_FINDER = None


def _b11_install_scan():
    for delay in (3.0, 8.0):
        try:
            t = threading.Timer(delay, lambda d=delay: _b11_scan("post-load+%ss" % int(d)))
            t.daemon = True; t.start()
            _B11_TIMERS.append(t)
        except Exception as e:
            try: _log("Block#11: scan timer err: %s" % e)
            except Exception: pass

def _jc(name):
    try:
        return jclass(name)
    except Exception:
        try:
            from java import jclass as _j
            return _j(name)
        except Exception:
            return None

def _oom_path(name=None):
    try:
        d = File(_DIR)
        if not d.exists(): d.mkdirs()
        return File(d, name or _OOM_FILE_NAME).getAbsolutePath()
    except Exception:
        return None

def _java_mem():
    ju = -1; jm = -1; nh = -1
    try:
        rt = _jc("java.lang.Runtime").getRuntime()
        jm = int(rt.maxMemory()); ju = int(rt.totalMemory()) - int(rt.freeMemory())
    except Exception:
        pass
    try:
        nh = int(_jc("android.os.Debug").getNativeHeapAllocatedSize())
    except Exception:
        pass
    return ju, jm, nh

_UNTAGGED_LABEL = "⟨untagged⟩"

_GREF_LIVE_DEGRADE_MIN = 4096
_GREF_LIVE_DEGRADE_FRAC = 0.25
def _gref_live_sum():
    try:
        if not (globals().get("_GREF_LIVE_OK") and _NLIB is not None and ctypes is not None):
            return 0
        try: n = int(_NLIB.cd_gref_tags())
        except Exception: n = 0
        s = 0
        if n > 0:
            arr = (ctypes.c_int64 * n)()
            m = int(_NLIB.cd_gref_live_snapshot(arr, ctypes.c_int32(n)))
            i = 0
            while i < m and i < n:
                v = int(arr[i])
                if v > 0: s += v
                i += 1
        try: s += max(0, int(_NLIB.cd_gref_live_untagged()))
        except Exception: pass
        return s
    except Exception:
        return 0
def _oom_gref_top():
    try:
        if not (_GREF_NATIVE_OK and _NLIB is not None and ctypes is not None):
            return None
        try:
            if not int(_NLIB.cd_gref_running()):
                return None
        except Exception:
            return None
        _live_ok = bool(globals().get("_GREF_LIVE_OK"))
        overflow = 0; del_untracked = 0
        if _live_ok:
            try: overflow = int(_NLIB.cd_gref_overflow())
            except Exception: overflow = 0
            try: del_untracked = int(_NLIB.cd_gref_del_untracked())
            except Exception: del_untracked = 0
        _cnt = ctypes.c_int64(0)
        try: creation_total = int(_NLIB.cd_gref_total())
        except Exception: creation_total = 0
        _degraded = (not _live_ok) or (overflow > 0) or (del_untracked >= _GREF_LIVE_DEGRADE_MIN and float(del_untracked) >= _GREF_LIVE_DEGRADE_FRAC * float(max(1, creation_total)))
        src = "native"; is_live = False
        if _live_ok and not _degraded:
            idx = int(_NLIB.cd_gref_live_top1(ctypes.byref(_cnt)))
            top_cnt = int(_cnt.value)
            if idx < 0 or top_cnt <= 0:
                return None
            is_live = True; src = "native_live"
            total = _gref_live_sum()
            try: untagged = int(_NLIB.cd_gref_live_untagged())
            except Exception: untagged = 0
            if total <= 0: total = top_cnt
        else:
            idx = int(_NLIB.cd_gref_top1(ctypes.byref(_cnt)))
            top_cnt = int(_cnt.value)
            if idx < 0 or top_cnt <= 0:
                return None
            try: total = int(_NLIB.cd_gref_total())
            except Exception: total = 0
            try: untagged = int(_NLIB.cd_gref_untagged())
            except Exception: untagged = 0
        name = None
        try: name = _resolve_idx(idx)
        except Exception: name = None
        if not name:
            try: name = _resolve_idx_durable(idx)
            except Exception: name = None
        if not name or name == _SELF_ID or name == __id__:
            return None
        return {"culprit": name, "count": top_cnt, "total": total,
                "untagged": untagged, "src": src, "live": is_live, "overflow": overflow, "del_untracked": del_untracked, "degraded": _degraded}
    except Exception:
        return None

_NA_HINT_MAX_AGE_MS = 180000
_NA_HINT_MIN_BYTES = 1048576

def _mr_untagged_top_module(odump):
    try:
        p = _oom_path(_NA_NAME)
        if not p or not os.path.exists(p):
            return None
        try: _mt = int(os.path.getmtime(p) * 1000)
        except Exception: _mt = None
        try: _ts = int(odump.get("ts") or 0)
        except Exception: _ts = 0
        if _mt is not None and _ts > 0 and abs(_mt - _ts) > _NA_HINT_MAX_AGE_MS:
            return None
        with open(p, "r", encoding="utf-8") as _f:
            d = json.load(_f)
        best = None
        for s in (d.get("sites") or []):
            try:
                rb = int(s.get("retained_bytes") or 0)
            except Exception:
                continue
            if rb < _NA_HINT_MIN_BYTES:
                continue
            if best is None or rb > best[0]:
                frames = s.get("frames") or []
                mod = None
                if frames:
                    try: mod = str(frames[0]).split("+", 1)[0].split("/")[-1].strip()
                    except Exception: mod = None
                if mod:
                    best = (rb, mod, s.get("bucket") or "app")
        if not best:
            return None
        return {"module": best[1], "bytes": best[0], "bucket": best[2]}
    except Exception:
        return None

def _oom_native_site_hint(odump):
    try:
        _sv = odump.get("verdict") or {}
        _snsc = _sv.get("native_site_culprit"); _snsb = int(_sv.get("native_site_bytes") or 0)
        if _snsc and _snsb >= _NA_HINT_MIN_BYTES:
            return {"module": _snsc, "bytes": _snsb, "count": int(_sv.get("native_site_count") or 0), "bucket": _sv.get("native_site_bucket")}
    except Exception:
        pass
    try:
        p = _oom_path(_NA_NAME)
        if not p or not os.path.exists(p):
            return None
        try: _mt = int(os.path.getmtime(p) * 1000)
        except Exception: _mt = None
        try: _ts = int(odump.get("ts") or 0)
        except Exception: _ts = 0
        if _mt is not None and _ts > 0 and abs(_mt - _ts) > _NA_HINT_MAX_AGE_MS:
            return None
        with open(p, "r", encoding="utf-8") as _f:
            d = json.load(_f)
        best = None
        for s in (d.get("sites") or []):
            try:
                if s.get("bucket") == "gfx":
                    continue
                rb = int(s.get("retained_bytes") or 0)
            except Exception:
                continue
            if rb < _NA_HINT_MIN_BYTES:
                continue
            if best is None or rb > best[0]:
                frames = s.get("frames") or []
                mod = None
                if frames:
                    try: mod = str(frames[0]).split("+", 1)[0].split("/")[-1].strip()
                    except Exception: mod = None
                if mod:
                    best = (rb, mod, int(s.get("count") or 0), s.get("bucket"))
        if not best:
            return None
        return {"module": best[1], "bytes": best[0], "count": best[2], "bucket": best[3]}
    except Exception:
        return None

_OOM_RPS_OP_WINDOW_MS = 8000
_OOM_RPS_DOMAINS = ("gl", "anim", "mediacodec")
_OOM_PSEUDO_TAGS = ("python_interpreter",)
_OOM_MR_UNTAGGED_FAMILY = ("ambient_device_pressure", "no_attribution", "untagged_dominates",
                           "untagged_edges_named", "rate_untagged_dominant",
                           "async_download_untagged_dominant", "native_site_hint")


def _oom_untagged_alias(name):
    if name == _UNTAGGED_LABEL:
        return True
    try:
        _n = str(name).strip().strip("<>()\u27e8\u27e9").strip().lower()
    except Exception:
        return False
    return _n == "untagged"

_OOM_GFX_LABEL = "⟨host:graphics⟩"
_OOM_SMAPS_TOPN = 8
_OOM_SMAPS_MIN_BYTES = 64 * 1048576
_OOM_SMAPS_CONSUMER = ("native-malloc", "gfx-gpu", "gfx-dmabuf", "shmem-ashmem",
                       "anon-private", "anon-other", "file-other", "thread-stack")
_OOM_SMAPS_GFX = ("gfx-gpu", "gfx-dmabuf")

def _oom_smaps_annotate(rec, v):
    if not isinstance(v, dict):
        return
    try:
        g = _smaps_scan_native()
        if not g:
            return
        roll = _smaps_rollup_native()
        groups = [{"group": k, "rss": int(x["rss"]), "pss": int(x["pss"]),
                   "swap": int(x["swap"]), "maps": int(x["n"])}
                  for k, x in g.items() if (x["rss"] or x["pss"] or x["swap"] or x["n"])]
        groups.sort(key=lambda d: d["pss"], reverse=True)
        v["smaps_groups"] = groups[:_OOM_SMAPS_TOPN]
        _tot = int(roll["pss"]) if roll else sum(d["pss"] for d in groups)
        if roll:
            v["smaps_total_pss"] = int(roll["pss"]); v["smaps_total_rss"] = int(roll["rss"])
        _dom = None
        for d in groups:
            if d["group"] in _OOM_SMAPS_CONSUMER and (_dom is None or d["pss"] > _dom["pss"]):
                _dom = d
        if _dom is None:
            return
        v["dominant_region"] = _dom["group"]
        v["dominant_region_bytes"] = int(_dom["pss"])
        v["dominant_region_share"] = round((float(_dom["pss"]) / float(_tot)) if _tot > 0 else 0.0, 4)
    except Exception:
        return
    try:
        rd = str(v.get("reason_detail"))
        if rd == "ambient_device_pressure":
            return
        if v.get("culprit") != _UNTAGGED_LABEL:
            return
        if rd not in ("untagged_dominates", "no_attribution", "untagged_edges_named",
                      "rate_untagged_dominant", "async_download_untagged_dominant",
                      "native_site_hint", "rate_suspect"):
            return
        dom = v.get("dominant_region"); domb = int(v.get("dominant_region_bytes") or 0)
        untagged = int(v.get("untagged_bytes") or 0)
        if not dom or domb < _OOM_SMAPS_MIN_BYTES:
            return
        _explains = (untagged <= 0) or (domb >= untagged * 0.5)
        if not _explains:
            return
        if dom in _OOM_SMAPS_GFX:
            v["culprit"] = _OOM_GFX_LABEL; v["culprit_display"] = _OOM_GFX_LABEL
            v["display_bytes"] = domb
            v["reason_detail"] = "smaps_gfx_dominant"; v["confidence"] = "medium"
            v["holder_region"] = dom
        elif dom == "native-malloc" and v.get("native_site_culprit"):
            v["culprit"] = v.get("native_site_culprit"); v["culprit_display"] = v.get("native_site_culprit")
            v["display_bytes"] = int(v.get("native_site_bytes") or 0) or domb
            v["reason_detail"] = "smaps_native_malloc_dominant"; v["confidence"] = "medium"
            v["holder_region"] = dom
        if v.get("reason_detail") in ("smaps_gfx_dominant", "smaps_native_malloc_dominant"):
            _display = int(v.get("display_bytes") or 0)
            if (v.get("reason_detail") == "smaps_gfx_dominant" or
                    not int(v.get("native_site_bytes") or 0)):
                _denom = int(v.get("smaps_total_pss") or _tot or 0)
                v["display_basis"] = "smaps-pss"
            else:
                _denom = int(rec.get("native_total") or 0)
                v["display_basis"] = "native-live"
            v["display_total_bytes"] = _denom
            v["display_share"] = (round(float(_display) / _denom, 4)
                                  if _denom > 0 and 0 <= _display <= _denom else None)
    except Exception:
        return

def _oom_verdict(odump):
    try:
        top = list(odump.get("top") or [])
    except Exception:
        top = []
    untagged = 0; real = []; total_attr = 0; _interp_b = 0
    for kv in top:
        try:
            name = kv[0]; b = int(kv[1])
        except Exception:
            continue
        if b < 0: b = 0
        total_attr += b
        if _oom_untagged_alias(name):
            untagged += b
        elif name in _OOM_PSEUDO_TAGS:
            untagged += b
            _interp_b += b
        elif name == _SELF_ID or name == __id__:
            pass
        else:
            real.append((name, b))
    real.sort(key=lambda x: x[1], reverse=True)
    denom = total_attr if total_attr > 0 else 1
    culprit = real[0][0] if real else None
    culprit_bytes = real[0][1] if real else 0
    second_bytes = real[1][1] if len(real) > 1 else 0
    share = float(culprit_bytes) / float(denom)
    untagged_share = float(untagged) / float(denom)
    margin = (float(culprit_bytes - second_bytes) / float(culprit_bytes)) if culprit_bytes > 0 else 0.0
    try:
        rate = float(odump.get("rate_mbps") or 0.0)
    except Exception:
        rate = 0.0
    global _OOM_PREV_EMIT
    _gr_cul = None; _gr_b = 0; _gr_win = None; _gr_unt = 0; _gr_unt_known = True
    try:
        _now_ts = int(odump.get("ts") or int(time.time() * 1000))
        _cur_map = {}
        for kv in top:
            try:
                _gk = _UNTAGGED_LABEL if _oom_untagged_alias(kv[0]) else str(kv[0])
                _cur_map[_gk] = _cur_map.get(_gk, 0) + max(0, int(kv[1]))
            except Exception: pass
        _prev = _OOM_PREV_EMIT
        _OOM_PREV_EMIT = {"ts": _now_ts, "top": _cur_map}
        if not (_prev and 0 < (_now_ts - int(_prev.get("ts") or 0)) <= _OOM_GROWTH_FRESH_MS):
            try:
                _pb = _oom_rate_baseline_pick(_now_ts)
                if _pb: _prev = _pb
            except Exception: pass
        if _prev and 0 < (_now_ts - int(_prev.get("ts") or 0)) <= _OOM_GROWTH_FRESH_MS:
            _gr_win = _now_ts - int(_prev.get("ts") or 0)
            _pm = _prev.get("top") or {}
            _best = None
            for _gn, _gb in _cur_map.items():
                if _gn not in _pm:
                    if _gn == _UNTAGGED_LABEL or _gn in _OOM_PSEUDO_TAGS:
                        _gr_unt_known = False
                    continue
                _gd = _gb - int(_pm.get(_gn, 0))
                if _gd <= 0: continue
                if _gn == _UNTAGGED_LABEL:
                    _gr_unt += _gd
                elif _gn in _OOM_PSEUDO_TAGS:
                    _gr_unt += _gd
                elif _gn not in (_SELF_ID, __id__) and (_best is None or _gd > _best[1]):
                    _best = (_gn, _gd)
            if _best:
                _gr_cul, _gr_b = _best[0], int(_best[1])
    except Exception:
        _gr_cul = None; _gr_b = 0; _gr_win = None; _gr_unt = 0; _gr_unt_known = True
    tagged_total = total_attr - untagged
    tagged_share = (float(culprit_bytes) / float(tagged_total)) if tagged_total > 0 else 0.0
    if culprit is None:
        conf = "low"
        display = _UNTAGGED_LABEL if untagged > 0 else None
        reason_detail = "no_attribution"
    elif untagged > culprit_bytes:
        _nl_interp_dom = (_interp_b > 0 and _interp_b * 2 >= untagged)
        if rate >= 15.0 and tagged_share >= 0.80 and culprit_bytes > 524288 and not _nl_interp_dom:
            conf = "medium"
            display = culprit
            reason_detail = "async_download_pattern"
        elif rate >= 50.0 and culprit_bytes > 262144:
            conf = "low"
            display = culprit
            reason_detail = "rate_suspect"
        else:
            conf = "low"
            display = _UNTAGGED_LABEL
            if culprit_bytes > 262144 and untagged < culprit_bytes * _OOM_EDGE_RATIO:
                reason_detail = "untagged_edges_named"
            else:
                reason_detail = "untagged_dominates"
    elif share >= 0.60 and untagged_share <= 0.25 and margin >= 0.50:
        conf = "high"; display = culprit; reason_detail = "clear_leader"
    elif share >= 0.30 and untagged_share <= 0.50:
        conf = "medium"; display = culprit; reason_detail = "probable_leader"
    else:
        conf = "low"; display = culprit; reason_detail = "weak_leader"
    gref_culprit = None; gref_count = 0; gref_total = 0; gref_share = 0.0; gref_live = False; gref_overflow = 0; gref_del_untracked = 0
    _byte_named = (display != _UNTAGGED_LABEL and display is not None)
    _gref_took_display = False
    _g = None
    try: _g = odump.get("gref")
    except Exception: _g = None
    if not _g:
        try: _g = _oom_gref_top()
        except Exception: _g = None
    if _g:
        try:
            _gn = _g.get("culprit"); _gc = int(_g.get("count") or 0)
            _gt = int(_g.get("total") or 0)
            _gu = int(_g.get("untagged") or 0)
            _named = _gt - _gu
            _gsh = min(1.0, (float(_gc) / float(_named)) if _named > 0 else ((float(_gc) / float(_gt)) if _gt > 0 else 0.0))
            if _gn and _gc >= _B28C_MIN and _gsh >= _B28C_DOMINANCE:
                gref_culprit = _gn; gref_count = _gc
                gref_total = _gt; gref_share = _gsh
                gref_live = bool(_g.get("live")); gref_overflow = int(_g.get("overflow") or 0); gref_del_untracked = int(_g.get("del_untracked") or 0)
                if not _byte_named:
                    display = _gn
                    reason_detail = "globalref_native"
                    conf = "high" if _g.get("live") else "medium"
                    _gref_took_display = True
        except Exception:
            pass
    is_unt = (display == _UNTAGGED_LABEL)
    if _gref_took_display:
        display_bytes = untagged; display_share = untagged_share
    else:
        display_bytes = untagged if is_unt else culprit_bytes
        display_share = untagged_share if is_unt else share
    native_site = None
    if not _gref_took_display:
        try: native_site = _oom_native_site_hint(odump)
        except Exception: native_site = None
    if native_site and (is_unt or display is None):
        reason_detail = "native_site_hint"
        try:
            _if_b = int(native_site.get("bytes") or 0)
            _if_mod = native_site.get("module")
            if _if_mod and _if_b >= _NA_HINT_MIN_BYTES:
                display = _if_mod
                display_bytes = _if_b
                display_share = (float(_if_b) / float(denom)) if denom > 0 else 0.0
                reason_detail = "native_site_promoted"
                conf = "medium" if (untagged > 0 and _if_b >= untagged * 0.5) else "low"
        except Exception:
            pass
    _cl_corr = None
    try:
        _cl_corr = _recent_client_lowmem()
    except Exception:
        _cl_corr = None
    try:
        _ig_amb = ("ambient(device)" in str(odump.get("reason") or "")) and (rate < 2.0)
        if _ig_amb and (not _byte_named) and (not _gref_took_display) and reason_detail in ("native_site_promoted", "native_site_hint", "untagged_dominates", "no_attribution", "untagged_edges_named"):
            if reason_detail == "native_site_promoted":
                display = _UNTAGGED_LABEL
                display_bytes = untagged
                display_share = untagged_share
            reason_detail = "ambient_device_pressure"
            conf = "low"
    except Exception:
        pass
    _rps = None; _rps_basis = None
    try:
        if culprit and culprit not in (_UNTAGGED_LABEL, _SELF_ID, __id__):
            _rps_op = None
            try: _rps_op = _b20_owner_from_op_in_domains(_OOM_RPS_OP_WINDOW_MS, _OOM_RPS_DOMAINS, owner=culprit)
            except Exception: _rps_op = None
            _rps_op_dom = (_rps_op.get("domain") if _rps_op else None)
            if _rps_op is not None and _rps_op_dom in _OOM_RPS_DOMAINS:
                _rps = culprit
                _rps_basis = "top native allocator (%dB) == fresh %s op-stamp owner (age=%dms); anr_scope_owner=%r" % (int(culprit_bytes), _rps_op_dom, int((_rps_op.get("age_ms") or 0)), _b20_owner_from_scope())
    except Exception:
        _rps = None; _rps_basis = None
    _tagged_leader = None; _tagged_leader_bytes = 0; _tagged_leader_share = 0.0
    try:
        if reason_detail in ("async_download_pattern", "rate_suspect") and untagged > culprit_bytes and share < _OOM_TAGGED_HEADLINE_MIN_SHARE and display == culprit:
            _tagged_leader = culprit; _tagged_leader_bytes = int(culprit_bytes); _tagged_leader_share = round(share, 4)
            _mp_async = (reason_detail == "async_download_pattern")
            display = _UNTAGGED_LABEL
            display_bytes = untagged; display_share = untagged_share
            reason_detail = "async_download_untagged_dominant" if _mp_async else "rate_untagged_dominant"
            conf = "low"
            try: _log("Block#7 +JR(fix3)/+MP(2): OOM headline demoted -- untagged %dB > tagged leader %r %dB (abs share %.1f%% < %.0f%%) -> culprit=untagged/host, %r kept as tagged_leader" % (int(untagged), _tagged_leader, int(culprit_bytes), share * 100.0, _OOM_TAGGED_HEADLINE_MIN_SHARE * 100.0, _tagged_leader))
            except Exception: pass
    except Exception:
        pass
    _rs_txt = str(odump.get("reason") or "")
    _sev = "pre_oom_growth" if (("rate" in _rs_txt) and ("pct" not in _rs_txt)) else "oom_pressure"
    try:
        if (_gr_cul and _gr_win and _gr_b >= _OOM_GROWTH_MIN_BYTES and _gr_b > _gr_unt
                and _gr_unt_known
                and ("rate" in _rs_txt)
                and reason_detail in ("rate_suspect", "rate_untagged_dominant", "untagged_dominates", "weak_leader")
                and not _gref_took_display):
            _gb_cur = 0
            for _rn, _rb in real:
                if _rn == _gr_cul:
                    _gb_cur = int(_rb); break
            display = _gr_cul
            display_bytes = _gb_cur if _gb_cur > 0 else _gr_b
            display_share = (float(display_bytes) / float(denom)) if denom else 0.0
            conf = "medium" if _gr_b >= 2 * max(1, _gr_unt) else "low"
            reason_detail = "growth_leader"
            try: _log("Block#7 +MP(3): rate-событие -> headline по РОСТУ за окно %dмс: %s +%.1f МБ (untagged +%.1f МБ); retained-лидер %r оставлен в top_named" % (int(_gr_win), _gr_cul, _gr_b/1048576.0, _gr_unt/1048576.0, culprit))
            except Exception: pass
    except Exception: pass
    _sj_age = -1; _sj_basis = None; _sj_load_ago = -1
    try:
        if _sev == "pre_oom_growth":
            _sj_pct = float((odump.get("mem") or {}).get("pct") or 0.0)
            _sj_fresh = abs(int(time.time() * 1000) - int(odump.get("ts") or 0)) < 10000
            if _sj_pct < _OOM_PCT and _sj_fresh:
                _sj_age = _proc_age_ms()
                if 0 <= _sj_age < _OOM_STARTUP_GRACE_MS:
                    _sj_basis = "proc_age"
                else:
                    _sj_mod = (native_site["module"] if native_site else None) or (display if str(display or "").endswith(".so") else None)
                    _sj_lt = _dl_recent_load_ts(_sj_mod) if _sj_mod else 0
                    if _sj_lt > 0:
                        _sj_load_ago = int(odump.get("ts") or time.time() * 1000) - _sj_lt
                        if 0 <= _sj_load_ago < _OOM_LOAD_BURST_MS:
                            _sj_basis = "lib_load"
                if _sj_basis:
                    _sev = "init_burst"; conf = "low"
    except Exception: pass
    _co_s = None; _co_b = 0
    try:
        if display == culprit and len(real) > 1 and second_bytes > 0 and margin < 0.25:
            _co_s = real[1][0]; _co_b = int(second_bytes)
    except Exception: pass
    return {"culprit": display, "top_named": culprit, "top_named_bytes": culprit_bytes,
            "resource_pressure_suspect": _rps, "rps_basis": _rps_basis,
            "culprit_bytes": culprit_bytes, "second_bytes": second_bytes,
            "margin": round(margin, 4), "share": round(share, 4),
            "display_bytes": display_bytes, "display_share": round(display_share, 4),
            "untagged_bytes": untagged, "untagged_share": round(untagged_share, 4),
            "interpreter_bytes": _interp_b, "raw_untagged_bytes": (untagged - _interp_b),
            "rate_mbps": round(rate, 2), "reason": odump.get("reason"),
            "severity": _sev, "proc_age_ms": _sj_age, "burst_basis": _sj_basis, "lib_load_ago_ms": _sj_load_ago, "growth_culprit": _gr_cul, "growth_bytes": _gr_b,
            "growth_window_ms": _gr_win, "growth_untagged_bytes": _gr_unt,
            "co_suspect": _co_s, "co_suspect_bytes": _co_b,
            "growth_baseline_present": bool(_gr_win),
            "growth_untagged_baseline": (None if not _gr_win else bool(_gr_unt_known)),
            "gref_culprit": gref_culprit, "gref_count": gref_count,
            "gref_total": gref_total, "gref_share": round(gref_share, 4),
            "gref_live": gref_live, "gref_overflow": gref_overflow, "gref_del_untracked": gref_del_untracked,
            "native_site_culprit": (native_site["module"] if native_site else None),
            "native_site_bytes": (native_site["bytes"] if native_site else 0),
            "native_site_count": (native_site["count"] if native_site else 0),
            "native_site_bucket": (native_site["bucket"] if native_site else None),
            "reason_detail": reason_detail, "confidence": conf,
            "client_lowmem_corrob": _cl_corr,
            "tagged_leader": _tagged_leader, "tagged_leader_bytes": _tagged_leader_bytes, "tagged_leader_share": _tagged_leader_share}

def _oom_verdict_log(odump, where):
    try:
        v = odump.get("verdict") if isinstance(odump, dict) else None
        if not isinstance(v, dict):
            v = _oom_verdict(odump)
    except Exception as e:
        try: _log(f"OOM verdict err: {e}")
        except Exception: pass
        return None
    cul = v.get("culprit")
    if cul is None:
        return v
    _OOM_RD_TXT = {
        "untagged_dominates": "untagged dominates; named plugin too small to explain OOM",
        "no_attribution": "no attribution; all memory untagged (raw threads / Part A .so)",
        "clear_leader": "clear leader",
        "probable_leader": "probable leader",
        "weak_leader": "weak leader; low confidence",
        "async_download_pattern": "async HTTP/network: plugin dominates tagged; untagged = urllib3/TCP/JNI buffers outside scope",
        "rate_suspect": "fast growth rate with active named plugin; untagged dominates",
        "rate_untagged_dominant": "rate-triggered; untagged dominates and named share is tiny -> host/untagged headlined, named kept as tagged_leader (+MP)",
        "growth_leader": "rate-triggered; headline by per-owner growth delta over the last emit window; retained leader kept in top_named (+MP)",
        "globalref_native": "native JNI global-ref attribution (Block#28C/+JO): the plugin owning the most LIVE global-refs (NewGlobalRef minus DeleteGlobalRef, charged to the ref creator) dominates the JNI table; falls back to cumulative CREATION/churn wording when the live map is degraded (overflow / late hook) or the .so predates +JO",
        "native_site_hint": "untagged at OOM, but the native alloc-site sampler names the dominant holder module (large mmap/direct allocs bypass the malloc tagger)",
        "ambient_device_pressure": "device-wide RAM pressure with ~zero process growth: meminfo saturated device-side while our RSS is small/flat -- NOT this process leaking (holder/untagged suppressed, no per-process culprit)",
        "smaps_gfx_dominant": "untagged at OOM; the /proc/self/smaps PSS breakdown shows graphics memory (gfx-gpu/gfx-dmabuf) dominates -> host/graphics (GPU/DMA buffers), not a plugin malloc leak",
        "smaps_native_malloc_dominant": "untagged at OOM; smaps shows the native-malloc region dominates and the alloc-site sampler names the top holder library",
        "globalref_ambient": "RSS/native leak but the JNI global-ref pool is >90%% untagged and the named plugin owns <5%% of ALL refs: gref creation-dominance among a tiny tagged slice is unrepresentative -> not pinned (host-ambient, low)",
    }
    rd = v.get("reason_detail")
    _log("================ OOM VERDICT (%s) ================" % where)
    _mp_hdr = "БЫСТРЫЙ РОСТ ПАМЯТИ(pre-OOM)" if v.get("severity") == "pre_oom_growth" else "ВИНОВНИК OOM(память)"
    if v.get("severity") == "init_burst":
        if v.get("burst_basis") == "lib_load":
            _mp_hdr = "РАЗОВЫЙ ВСПЛЕСК ПРИ ЗАГРУЗКЕ .so (не утечка, загружена %.1fс назад)" % (float(v.get("lib_load_ago_ms") or 0) / 1000.0)
        else:
            _mp_hdr = "РАЗОВЫЙ ВСПЛЕСК ПРИ СТАРТЕ (не утечка, процессу %.1fс)" % (float(v.get("proc_age_ms") or 0) / 1000.0)
    _log("%s: %r conf=%s — %.0f МБ (отслежено детектором, НЕ доля от ОЗУ) отрыв=%.0f МБ rate=%sМБ/с untagged=%.0f МБ reason=%s" % (
        _mp_hdr,
        cul, v["confidence"], float(v["display_bytes"])/1048576.0,
        max(0.0, (float(v.get("culprit_bytes") or 0) - float(v.get("second_bytes") or 0)))/1048576.0,
        v["rate_mbps"], float(v["untagged_bytes"])/1048576.0, v.get("reason")))
    try:
        if v.get("co_suspect"):
            _log("  co-suspect: %s %.0f МБ (отрыв от лидера <25%% — виновник не единственный кандидат)" % (v.get("co_suspect"), float(v.get("co_suspect_bytes") or 0)/1048576.0))
        if v.get("growth_culprit"):
            _log("  рост за окно %sмс: %s +%.0f МБ (untagged +%.0f МБ)" % (v.get("growth_window_ms"), v.get("growth_culprit"), float(v.get("growth_bytes") or 0)/1048576.0, float(v.get("growth_untagged_bytes") or 0)/1048576.0))
    except Exception: pass
    try:
        if v.get("dominant_region"):
            _log("  smaps: доминирует %s %.0f МБ (%.0f%% PSS)%s" % (
                v.get("dominant_region"), float(v.get("dominant_region_bytes") or 0)/1048576.0,
                float(v.get("dominant_region_share") or 0.0)*100.0,
                ((" holder=" + str(v.get("holder_region"))) if v.get("holder_region") else "")))
            _sg = v.get("smaps_groups") or []
            if _sg:
                _log("  smaps top: " + ", ".join("%s=%.0fМБ" % (d.get("group"), float(d.get("pss") or 0)/1048576.0) for d in _sg[:5]))
    except Exception: pass
    _rps = v.get("resource_pressure_suspect")
    if _rps:
        _log("  [+RP] process-level resource-pressure suspect: %s -- держатель нативной памяти И владелец UI-стойла/ANR (gl/anim/mediacodec op-stamp); device-OOM вердикт НЕ меняется [%s]" % (_rps, v.get("rps_basis")))
    if cul == _UNTAGGED_LABEL:
        tn = v.get("top_named"); tnb = int(v.get("top_named_bytes") or 0)
        if tn:
            _log("  top_named=%s %.0f МБ" % (tn, tnb/1048576.0))
        _nsc = v.get("native_site_culprit")
        if _nsc:
            _log("  native-site(holder)=%s %.0f МБ x%s bucket=%s -- держатель нативной памяти по сэмплеру (модульная подсказка; malloc-теги его не видят)" % (
                _nsc, int(v.get("native_site_bytes") or 0)/1048576.0, v.get("native_site_count"), v.get("native_site_bucket")))
        _log("  reason: %s" % _OOM_RD_TXT.get(rd, rd))
        _log("  → виновник по памяти не определён достоверно (named-плагин не объясняет OOM)")
    elif rd == "globalref_native":
        gn = v.get("gref_culprit"); gc = int(v.get("gref_count") or 0)
        gt = int(v.get("gref_total") or 0)
        gsh = (float(gc) / float(gt) * 100.0) if gt > 0 else 0.0
        if v.get("gref_live"):
            _log("  global-refs(LIVE): %s=%d из %d живых (%.0f%%) -- атрибуция по ЖИВЫМ JNI global-ref (Block#28C/+JO: NewGlobalRef+DeleteGlobalRef, owner=создатель)" % (gn, gc, gt, gsh))
            _log("  reason: %s" % _OOM_RD_TXT.get(rd, rd))
            _log("  -> доминирование по ЖИВЫМ (не удалённым) global-ref: подтверждённый держатель JNI-таблицы, а не churn; malloc-теги его не видят")
        else:
            _log("  global-refs(native/churn): %s=%d из %d (%.0f%%) -- атрибуция по нативному счётчику NewGlobalRef (Block#28C)" % (gn, gc, gt, gsh))
            _log("  reason: %s" % _OOM_RD_TXT.get(rd, rd))
            _log("  -> live-карта деградирована (overflow=%d / del_untracked=%d) или .so без +JO -> откат на НАКОПЛЕННЫЙ темп создания (churn): доминирование по созданию, доверие среднее" % (int(v.get("gref_overflow") or 0), int(v.get("gref_del_untracked") or 0)))
    elif rd in ("async_download_pattern", "rate_suspect"):
        tn = v.get("top_named"); tnb = int(v.get("top_named_bytes") or 0)
        unt = int(v.get("untagged_bytes") or 0)
        _async_ratio = round(float(unt) / float(tnb), 1) if tnb > 0 else 0.0
        _named_pct = round(float(tnb) / float(tnb + unt) * 100.0, 1) if (tnb + unt) > 0 else 0.0
        _log("  named=%s %.0f МБ untagged=%.0f МБ async_ratio=%.1fx (named %.0f из %.0f МБ отслеженных)" % (
            tn, tnb/1048576.0, unt/1048576.0, _async_ratio, tnb/1048576.0, (tnb+unt)/1048576.0))
        _log("  reason: %s" % _OOM_RD_TXT.get(rd, rd))
        _h6_nsc = v.get("native_site_culprit"); _h6_nsb = int(v.get("native_site_bytes") or 0)
        if _h6_nsc and _h6_nsb >= _NA_HINT_MIN_BYTES and _h6_nsc != tn:
            _log("  [+H6] из untagged ~%.0f МБ удерживает %r (нативный модуль-держатель, НЕ HTTP-буферы плагина)" % (_h6_nsb/1048576.0, _h6_nsc))
            _log("  → виновник по async-паттерну (named-плагин), но часть untagged = нативный держатель выше, а не сеть")
        else:
            _log("  → виновник определён по async-паттерну: буферы HTTP-загрузки вне scope падают в untagged")
    else:
        _log("  reason: %s" % _OOM_RD_TXT.get(rd, rd))
        try:
            _mrm = v.get("untagged_top_module")
            if _mrm:
                _mrb = v.get("untagged_top_module_bucket")
                _mrg = "; gfx: ресурсы могли быть созданы плагином, хотя выделение прошло через системную библиотеку" if _mrb == "gfx" else ""
                _log("  [+NF] топ-модуль sampled untagged: %s ~%.0f МБ bucket=%s -- владелец не установлен, это holder/module hint, а НЕ атрибуция%s" % (_mrm, int(v.get("untagged_top_module_bytes") or 0) / 1048576.0, _mrb, _mrg))
        except Exception:
            pass
    _log("=================================================")
    return v

def _mr_esc_metrics(rec):
    v = rec.get("verdict") or {}
    try: _r = float(rec.get("rate_mbps") or 0.0)
    except Exception: _r = 0.0
    def _i(k):
        try: return int(v.get(k) or 0)
        except Exception: return 0
    _hm = v.get("untagged_top_module")
    _tn = v.get("top_named")
    return {"rate": _r, "display_b": _i("display_bytes"), "growth_b": _i("growth_bytes"),
            "untagged_b": _i("untagged_bytes"),
            "holder_b": _i("untagged_top_module_bytes"), "top_named_b": _i("top_named_bytes"),
            "holder": (str(_hm) if _hm else None), "top_named": (str(_tn) if _tn else None)}

def _oom_persist(rec):
    try:
        if (not rec.get("repeat_suppressed")) or rec.get("repeat_sample"):
            hp = _oom_path("oom_dump_%d.json" % rec["ts"])
            if hp:
                _atomic_json_write(hp, rec)
    except Exception:
        pass
    p = _oom_path()
    if not p: return
    _atomic_json_write(p, rec)

def _oom_log_dump(rec):
    m = rec.get("mem", {})
    pc = m.get("pct"); pcs = round(pc*100,1) if (pc is not None and pc>=0) else -1
    _log("================ PRE-OOM DUMP ================")
    _log(f'PRE-OOM trigger: reason={rec.get("reason")} rate={rec.get("rate_mbps")}MB/s')
    _log(f'  mem: src={m.get("src")} used={m.get("used")}B limit={m.get("limit")}B pct={pcs}%')
    _log(f'  rss={m.get("rss")}B native_heap={m.get("native_heap")}B java={m.get("java_used")}/{m.get("java_max")}B cgroup={m.get("cg_cur")}/{m.get("cg_max")}B')
    _log(f'  tracked: cd_total={m.get("cd_total")}B live={rec.get("native_live")} dropped={rec.get("dropped")}')
    _ucs = _ui_ctx_str(rec.get("ui_ctx"))
    if _ucs: _log("  контекст: " + _ucs)
    if rec.get("direct_total") is not None:
        _log(f'  direct(NIO off-heap): live={rec.get("direct_live_total")}B cumulative={rec.get("direct_total")}B untagged_live={rec.get("direct_live_untagged")}B')
    _log(f'  TOP-{_OOM_TOPN} consumers (plugin: bytes [native_live+direct_live]):')
    for i, kv in enumerate(rec.get("top", [])):
        try: _log(f'    #{i+1} {kv[0]}: {int(kv[1])}B')
        except Exception: pass
    try: _oom_verdict_log(rec, "live")
    except Exception: pass
    _log("==============================================")

def _read_and_clear_oom_dump():
    return _read_and_clear_json_dict(_oom_path())

import struct as _struct
_OOM_HDR_FMT = "<II12q4i"
_OOM_HDR_LEN = _struct.calcsize(_OOM_HDR_FMT)
_OOM_TOP_FMT = "<iiq"
_OOM_TOP_LEN = _struct.calcsize(_OOM_TOP_FMT)
_OOM_MAGIC = 0x4F4F4D32

def _oom_sentinel_path():
    return _oom_path(_OOM_SENTINEL_NAME)

def _oom_decode_sentinel(blob):
    if not blob or len(blob) < _OOM_HDR_LEN:
        return None
    h = _struct.unpack_from(_OOM_HDR_FMT, blob, 0)
    (magic, ver, ts_ms, used, limit, rate_milli, cd_total, untagged, live_count,
        dropped, dropped_bytes, rss, cg_cur, cg_max, reason, src, topn, _pad) = h
    if magic != _OOM_MAGIC or ver not in (1, 2):
        return None
    thr_pct = None
    thr_rate_mbps = None
    if ver == 2:
        threshold_off = _OOM_HDR_LEN + 64 * _OOM_TOP_LEN
        if len(blob) < threshold_off + 16:
            return None
        thr_pct, thr_rate_mbps, _ = _struct.unpack_from("<dii", blob, threshold_off)
        if not (0.0 < thr_pct < float("inf") and thr_rate_mbps > 0):
            return None
    topn = max(0, min(int(topn), 64))
    tops = []
    off = _OOM_HDR_LEN
    for _ in range(topn):
        if off + _OOM_TOP_LEN > len(blob): break
        idx, _p, b = _struct.unpack_from(_OOM_TOP_FMT, blob, off)
        off += _OOM_TOP_LEN
        if idx >= 0 and b > 0:
            tops.append((int(idx), int(b)))
    return {"ver": int(ver), "ts_ms": int(ts_ms), "used": int(used), "limit": int(limit),
            "rate_mbps": (rate_milli / 1000.0), "cd_total": int(cd_total),
            "untagged": int(untagged), "live_count": int(live_count),
            "dropped": int(dropped), "dropped_bytes": int(dropped_bytes),
            "rss": int(rss), "cg_cur": int(cg_cur), "cg_max": int(cg_max),
            "reason_bits": int(reason), "src_code": int(src), "tops": tops,
            "thr_pct": thr_pct, "thr_rate_mbps": thr_rate_mbps,
            "thresholds_source": "native_snapshot" if ver == 2 else "unavailable_v1"}

def _direct_pm_path():
    return _oom_path(_DIRECT_PM_NAME)

def _direct_premortem_dump():
    try:
        p = _direct_pm_path()
        if not p: return
        d = _direct_snapshot()
        d["ts"] = int(time.time() * 1000)
        _atomic_json_write(p, d)
    except Exception:
        pass

def _direct_premortem_read_and_clear():
    try:
        p = _direct_pm_path()
        if not p: return None
        _rp = _rc_take_path(p)
        if not _rp: return None
        d = None
        try:
            try:
                with open(_rp, "r", encoding="utf-8") as f:
                    d = _rc_expect_dict(json.load(f))
            except Exception as _mr_e:
                _rc_clear_taken(_rp, False, _mr_e)
                _rp = None
                raise
        finally:
            if _rp:
                _rc_clear_taken(_rp, d is not None)
        return d
    except Exception:
        return None

def _oom_sentinel_to_rec(s, merge_direct=False, direct_snap=None):
    src = {0: "cgroup", 1: "rss", 2: "none", 3: "meminfo"}.get(s["src_code"], "native")
    used = s["used"]; limit = s["limit"]
    pct = (float(used) / float(limit)) if (limit and limit > 0 and used >= 0) else -1.0
    ju, jm, nh = (-1, -1, -1)
    try: ju, jm, nh = _java_mem()
    except Exception: pass
    m = {"used": used, "limit": limit, "src": src, "pct": pct,
         "java_used": ju, "java_max": jm, "native_heap": nh,
         "rss": s["rss"], "cg_cur": s["cg_cur"], "cg_max": s["cg_max"],
         "cd_total": s["cd_total"]}
    top = []
    for idx, b in s["tops"]:
        nm = _resolve_idx(idx) or ("idx%d" % idx)
        top.append([nm, int(b)])
    if s["untagged"] > 0:
        top.append([_UNTAGGED_LABEL, int(s["untagged"])])
    direct_fields = {}
    _ds = direct_snap if direct_snap is not None else (_direct_snapshot() if merge_direct else None)
    if _ds is not None:
        _premortem = direct_snap is not None
        try:
            _by = _ds.get("live_by_pid") or {}; _unt = int(_ds.get("live_untagged", 0) or 0)
            _combined = {}
            for _nm, _b in top:
                _combined[_nm] = _combined.get(_nm, 0) + int(_b)
            for _pid, _b in _by.items():
                _combined[_pid] = _combined.get(_pid, 0) + int(_b)
            if _unt > 0:
                _combined[_UNTAGGED_LABEL] = _combined.get(_UNTAGGED_LABEL, 0) + _unt
            top = [[_k, _v] for _k, _v in _combined.items()]
            direct_fields = {
                "direct_total": int(_ds.get("total", 0) or 0), "direct_untagged": int(_ds.get("untagged", 0) or 0),
                "direct_live_total": int(_ds.get("live_total", 0) or 0), "direct_live_untagged": int(_ds.get("live_untagged", 0) or 0),
                "direct_merged": ("premortem-live" if _premortem else "live"),
            }
        except Exception:
            direct_fields = {}
    top.sort(key=lambda kv: kv[1], reverse=True)
    top = top[:_OOM_TOPN]
    rbits = s["reason_bits"]; hit = []
    thr_pct = s.get("thr_pct")
    thr_rate = s.get("thr_rate_mbps")
    if rbits & 1:
        hit.append("pct>=%s%%" % format(thr_pct * 100.0, ".12g")
                   if thr_pct is not None else "pct_threshold_exceeded")
    if rbits & 2:
        hit.append("rate>=%dMB/s" % thr_rate
                   if thr_rate is not None else "rate_threshold_exceeded")
    if rbits & 4: hit.append("ambient(device)")
    rec = {"had_oom": True, "reason": "+".join(hit) or "native", "ts": s["ts_ms"],
           "mem": m, "rate_mbps": round(s["rate_mbps"], 2),
           "thr_pct": thr_pct, "thr_rate_mbps": thr_rate,
           "thresholds_source": s.get("thresholds_source", "unavailable"),
           "sentinel_version": s.get("ver"), "reason_bits": rbits,
           "top": top, "native_total": s["cd_total"], "native_live": s["live_count"],
           "dropped": s["dropped"], "dropped_bytes": s["dropped_bytes"], "src": "native"}
    if direct_fields: rec.update(direct_fields)
    try:
        _g = _oom_gref_top()
        if _g: rec["gref"] = _g
    except Exception: pass
    try: rec["verdict"] = _oom_verdict(rec)
    except Exception: pass
    try:
        _mrv = rec.get("verdict")
        if isinstance(_mrv, dict) and _mrv.get("reason_detail") == "ambient_device_pressure":
            rec["culprit"] = "устройство (нехватка ОЗУ)"
            rec["pressure_source"] = "device"
            _mrv["culprit_display"] = "устройство (нехватка ОЗУ)"
            _mrv["pressure_source"] = "device"
    except Exception:
        pass
    try:
        _mrv = rec.get("verdict")
        if isinstance(_mrv, dict) and _mrv.get("reason_detail") in ("no_attribution", "untagged_dominates", "ambient_device_pressure", "untagged_edges_named"):
            _mrh = _mr_untagged_top_module(rec)
            if _mrh:
                _mrv["untagged_top_module"] = _mrh["module"]
                _mrv["untagged_top_module_bytes"] = _mrh["bytes"]
                _mrv["untagged_top_module_bucket"] = _mrh["bucket"]
                _mrv["untagged_top_module_role"] = "holder_hint"
                _mrv["untagged_top_module_owner"] = None
                _mrv["untagged_top_module_attribution"] = False
    except Exception:
        pass
    try:
        if rbits & 4:
            rec["event_type"] = "device_mem_pressure"; rec["dropbox_tag"] = "device_mem_pressure"
            rec["ambient"] = True; rec["scope"] = "device"
            rec["process_scoped"] = False; rec["oom_evidence"] = "device_meminfo_fallback"
        elif (rec.get("verdict") or {}).get("severity") == "init_burst":
            rec["event_type"] = "init_alloc_burst"; rec["dropbox_tag"] = "init_alloc_burst"
            rec["ambient"] = False; rec["scope"] = "process"; rec["process_scoped"] = True
        else:
            rec["event_type"] = "client_oom_leak"; rec["dropbox_tag"] = "client_oom_leak"
            rec["ambient"] = False; rec["scope"] = "process"; rec["process_scoped"] = True
        rec["tombstone_norm_version"] = 1
    except Exception: pass
    try:
        if merge_direct:
            _oom_smaps_annotate(rec, rec.get("verdict"))
    except Exception: pass
    return rec

def _oom_native_emit(where):
    try:
        if not (_OOM_NATIVE_OK and _NLIB is not None and _CTYPES_OK and hasattr(_NLIB, "cd_emit_snapshot")):
            return
        pth = _oom_path("oom_native_emit.json")
        if not pth:
            return
        tmp = pth + ".tmp." + str(os.getpid()) + "." + str(threading.get_ident())
        _NLIB.cd_emit_snapshot(ctypes.c_char_p(tmp.encode("utf-8")),
                               ctypes.c_char_p(pth.encode("utf-8")),
                               ctypes.c_int32(1))
    except Exception:
        pass

def _oom_consume_native(where, do_log=True):
    p = _oom_sentinel_path()
    if not p: return None
    blob = None
    _rp = _rc_take_path(p)
    if not _rp: return None
    try:
        with open(_rp, "rb") as f:
            blob = f.read()
    except Exception:
        blob = None
    try:
        if os.path.exists(_rp): os.remove(_rp)
    except Exception:
        pass
    if not blob: return None
    s = _oom_decode_sentinel(blob)
    if not s: return None
    try: _oom_native_emit(where)
    except Exception: pass
    if where in ("live", "settings"):
        rec = _oom_sentinel_to_rec(s, merge_direct=True)
        if where == "live": _ui_ctx_attach(rec)
    elif where == "boot":
        _pm = _direct_premortem_read_and_clear()
        if _pm is not None:
            try:
                if abs(int(_pm.get("ts", 0)) - int(s.get("ts_ms", 0))) > 120000: _pm = None
            except Exception: pass
        rec = _oom_sentinel_to_rec(s, direct_snap=_pm)
    else:
        rec = _oom_sentinel_to_rec(s)
    global _OOM_MR_SLOTS
    _mr_sup = False
    try:
        if where == "live":
            _mrv = rec.get("verdict") or {}
            _mr_rd = str(_mrv.get("reason_detail"))
            if str(_mrv.get("culprit")) == _UNTAGGED_LABEL and _mr_rd in _OOM_MR_UNTAGGED_FAMILY:
                _mr_rd = "untagged_family"
            _mr_key = (str(_mrv.get("culprit")), _mr_rd, str(_mrv.get("confidence")),
                       str(rec.get("scope")), str(rec.get("event_type")))
            try: _mr_pb = int(float(rec.get("mem", {}).get("pct") or 0.0) * 20.0)
            except Exception: _mr_pb = 0
            _mr_m = _mr_esc_metrics(rec)
            _mr_p = _OOM_MR_SLOTS.get(_mr_key)
            _mr_esc = None
            if _mr_p:
                _mr_b = _mr_p.get("m") or {}
                _mr_e = []
                if _mr_pb > int(_mr_p.get("pb", -1)): _mr_e.append("pct")
                _mr_pr = float(_mr_b.get("rate") or 0.0)
                if _mr_m["rate"] >= _mr_pr * _OOM_REPEAT_ESC_RATE_X and (_mr_m["rate"] - _mr_pr) >= 1.0: _mr_e.append("rate")
                if _mr_m["display_b"] >= int(_mr_b.get("display_b") or 0) + _OOM_REPEAT_ESC_DISPLAY_B: _mr_e.append("display_bytes")
                if _mr_m["growth_b"] >= int(_mr_b.get("growth_b") or 0) + _OOM_REPEAT_ESC_GROWTH_B: _mr_e.append("growth_bytes")
                if _mr_m["untagged_b"] >= int(_mr_b.get("untagged_b") or 0) + _OOM_REPEAT_ESC_UNTAGGED_B: _mr_e.append("untagged_bytes")
                if _mr_m["holder"] != _mr_b.get("holder") and max(int(_mr_m.get("holder_b") or 0), int(_mr_b.get("holder_b") or 0)) >= _OOM_REPEAT_ESC_DISPLAY_B: _mr_e.append("holder")
                if _mr_m["top_named"] != _mr_b.get("top_named") and max(int(_mr_m.get("top_named_b") or 0), int(_mr_b.get("top_named_b") or 0)) >= _OOM_REPEAT_ESC_DISPLAY_B: _mr_e.append("top_named")
                if _mr_e: _mr_esc = ",".join(_mr_e)
            if (_mr_p and str(_mrv.get("confidence")) == "low" and _mr_p.get("key") == _mr_key
                    and _mr_esc is None
                    and (time.time() - float(_mr_p.get("t", 0.0))) < _OOM_REPEAT_COOLDOWN_S):
                _mr_sup = True
                _mr_p["n"] = int(_mr_p.get("n", 0)) + 1
                rec["repeat_suppressed"] = True
                rec["repeat_count"] = _mr_p["n"]
                _mr_h = _mr_p.get("hist")
                if not isinstance(_mr_h, dict):
                    _mr_h = {"first_ts": rec.get("ts"), "min_pct": None, "max_pct": None,
                             "min_rate_mbps": None, "max_rate_mbps": None,
                             "max_growth_bytes": 0, "max_display_bytes": 0, "max_untagged_bytes": 0,
                             "min_growth_bytes": None, "min_display_bytes": None, "min_untagged_bytes": None}
                    _mr_p["hist"] = _mr_h
                try: _mr_pct = round(float(rec.get("mem", {}).get("pct") or 0.0), 4)
                except Exception: _mr_pct = 0.0
                _mr_h["repeat_count"] = _mr_p["n"]
                _mr_h["last_ts"] = rec.get("ts")
                _mr_h["min_pct"] = _mr_pct if _mr_h.get("min_pct") is None else min(float(_mr_h["min_pct"]), _mr_pct)
                _mr_h["max_pct"] = _mr_pct if _mr_h.get("max_pct") is None else max(float(_mr_h["max_pct"]), _mr_pct)
                _mr_h["min_rate_mbps"] = _mr_m["rate"] if _mr_h.get("min_rate_mbps") is None else min(float(_mr_h["min_rate_mbps"]), _mr_m["rate"])
                _mr_h["max_rate_mbps"] = _mr_m["rate"] if _mr_h.get("max_rate_mbps") is None else max(float(_mr_h["max_rate_mbps"]), _mr_m["rate"])
                _mr_h["max_growth_bytes"] = max(int(_mr_h.get("max_growth_bytes") or 0), _mr_m["growth_b"])
                _mr_h["max_display_bytes"] = max(int(_mr_h.get("max_display_bytes") or 0), _mr_m["display_b"])
                _mr_h["max_untagged_bytes"] = max(int(_mr_h.get("max_untagged_bytes") or 0), _mr_m["untagged_b"])
                _mr_h["min_growth_bytes"] = _mr_m["growth_b"] if _mr_h.get("min_growth_bytes") is None else min(int(_mr_h["min_growth_bytes"]), _mr_m["growth_b"])
                _mr_h["min_display_bytes"] = _mr_m["display_b"] if _mr_h.get("min_display_bytes") is None else min(int(_mr_h["min_display_bytes"]), _mr_m["display_b"])
                _mr_h["min_untagged_bytes"] = _mr_m["untagged_b"] if _mr_h.get("min_untagged_bytes") is None else min(int(_mr_h["min_untagged_bytes"]), _mr_m["untagged_b"])
                rec["repeat_history"] = dict(_mr_h)
                _mr_n = int(_mr_p["n"])
                if _mr_n <= 2 or (_mr_n & (_mr_n - 1)) == 0:
                    rec["repeat_sample"] = True
            else:
                if _mr_p and _mr_p.get("key") == _mr_key and int(_mr_p.get("n", 0)) > 0:
                    if _mr_esc: rec["repeat_escalated"] = _mr_esc
                    if isinstance(_mr_p.get("hist"), dict):
                        rec["repeat_history"] = dict(_mr_p["hist"])
                _OOM_MR_SLOTS[_mr_key] = {"key": _mr_key, "t": time.time(), "pb": _mr_pb, "n": 0, "m": _mr_m}
                if len(_OOM_MR_SLOTS) > _OOM_MR_SLOTS_MAX:
                    try:
                        del _OOM_MR_SLOTS[min(_OOM_MR_SLOTS, key=lambda _sk: float(_OOM_MR_SLOTS[_sk].get("t", 0.0)))]
                    except Exception:
                        _OOM_MR_SLOTS.clear()
    except Exception:
        _mr_sup = False
    try: _oom_persist(rec)
    except Exception: pass
    if do_log:
        if _mr_sup:
            try:
                _log("PRE-OOM repeat suppressed (x%d%s): %s/%s conf=low pct=%.1f%% rate=%.1fМБ/с growth=%.1fМБ -- полная эмиссия после кулдауна либо эскалации (pct/rate/bytes/growth/holder)" % (int(rec.get("repeat_count") or 0), (" [sample]" if rec.get("repeat_sample") else ""), (rec.get("verdict") or {}).get("culprit"), (rec.get("verdict") or {}).get("reason_detail"), float(rec.get("mem", {}).get("pct") or 0.0) * 100.0, float(rec.get("rate_mbps") or 0.0), float((rec.get("verdict") or {}).get("growth_bytes") or 0) / 1048576.0))
            except Exception:
                pass
            if rec.get("repeat_sample"):
                try: _oom_log_dump(rec)
                except Exception: pass
        else:
            try:
                if rec.get("repeat_escalated"):
                    _log("PRE-OOM repeat ЭСКАЛАЦИЯ (%s) после x%d подавленных -- полная эмиссия" % (rec.get("repeat_escalated"), int((rec.get("repeat_history") or {}).get("repeat_count") or 0)))
            except Exception:
                pass
            try: _oom_log_dump(rec)
            except Exception: pass
    return rec

def _oom_consume_loop(stop_evt, evfd=-1, seq0=-1, trim0=-1, lowmem0=-1):
    last_seq = seq0
    last_trim_seq = trim0
    last_lowmem_seq = lowmem0
    if last_seq < 0:
        try:
            last_seq = int(_NLIB.cd_oom_seq()) if (_OOM_NATIVE_OK and _NLIB is not None) else 0
        except Exception:
            last_seq = 0
    if last_trim_seq < 0:
        try:
            last_trim_seq = int(_NLIB.cd_trim_seq()) if (_TRIM_NATIVE_OK and _NLIB is not None) else 0
        except Exception:
            last_trim_seq = 0
    if last_lowmem_seq < 0:
        try:
            last_lowmem_seq = int(_NLIB.cd_lowmem_seq()) if (_LOWMEM_NATIVE_OK and _NLIB is not None) else 0
        except Exception:
            last_lowmem_seq = 0
    if evfd < 0:
        try:
            evfd = int(_NLIB.cd_b6_eventfd())
        except Exception:
            evfd = -1
    try:
        _log("Block#6: режим 10s-idle + event-wake + 2s-boost (eventfd=%d, idle=%.0fs, boost=%.0fs/%.0fs)" % (evfd, _B6_IDLE_S, _B6_BOOST_S, _B6_BOOST_WINDOW_S))
    except Exception: pass
    boost_until = 0.0
    last_jt = 0.0
    last_full = 0.0
    while not stop_evt.is_set():
        try: ev = int(_NLIB.cd_b6_events_take())
        except Exception: ev = 0
        if not ev:
            _tn = time.monotonic()
            _until_full = max(0.0, _B6_IDLE_S - (_tn - last_full))
            _mode_wait = _B6_BOOST_S if _tn < boost_until else _B6_IDLE_S
            timo = min(_mode_wait, _until_full)
            try:
                if select.select([evfd], [], [], timo)[0]:
                    try: os.read(evfd, 8)
                    except Exception: pass
            except Exception:
                stop_evt.wait(timo)
            if stop_evt.is_set(): break
            try: ev = int(_NLIB.cd_b6_events_take())
            except Exception: ev = 0
        if ev & 0x37:
            boost_until = time.monotonic() + _B6_BOOST_WINDOW_S
        now = time.monotonic()
        do_full = (now - last_full) >= _B6_IDLE_S
        if do_full:
            last_full = now
        do_jheap = do_full or now < boost_until
        do_kill = do_full or bool(ev & 16)
        do_leak = do_full or bool(ev & 8)
        do_trim = do_full or bool(ev & 2)
        do_lowmem = do_full or bool(ev & 4)
        do_oom = do_full or bool(ev & 1)
        if do_full or (ev & 32):
            try: _b23_native_drain()
            except Exception: pass
        if do_jheap:
            _gil_begin(_GIL_B6_JHEAP)
            try:
                _oom_check_java_heap()
            except Exception: pass
            _gil_end(_GIL_B6_JHEAP)
        if do_kill:
            _gil_begin(_GIL_B6_KILL)
            try:
                _oom_check_killcount("live")
            except Exception: pass
            _gil_end(_GIL_B6_KILL)
        if do_leak:
            _gil_begin(_GIL_B6_LEAK)
            try:
                _leak_check("live")
            except Exception: pass
            _gil_end(_GIL_B6_LEAK)
        try:
            if do_full or now < boost_until:
                _oom_rate_baseline_sample()
        except Exception: pass
        if do_trim:
            try:
                if _TRIM_NATIVE_OK and _NLIB is not None and _OOM_CLIENT_KILL_STATE.get("trim_native"):
                    tseq = int(_NLIB.cd_trim_seq())
                    if tseq != last_trim_seq:
                        last_trim_seq = tseq
                        try: _lv = int(_NLIB.cd_trim_level())
                        except Exception: _lv = -1
                        if _lv != 20 and (_lv < 0 or _lv >= 15):
                            _gil_begin(_GIL_B6)
                            try:
                                _client_lowmem_note("onTrimMemory", _lv,
                                    "система просит освободить память (onTrimMemory level=%d)" % _lv)
                            except Exception: pass
                            _gil_end(_GIL_B6)
            except Exception as _et:
                try: _log(f"Block#6C trim consume err: {_et}")
                except Exception: pass
        if do_lowmem:
            try:
                if _LOWMEM_NATIVE_OK and _NLIB is not None and _OOM_CLIENT_KILL_STATE.get("lowmem_native"):
                    lseq = int(_NLIB.cd_lowmem_seq())
                    if lseq != last_lowmem_seq:
                        last_lowmem_seq = lseq
                        _gil_begin(_GIL_B6)
                        try:
                            _client_lowmem_note("onLowMemory", "low",
                                "система сообщила о критической нехватке памяти (onLowMemory)")
                        except Exception: pass
                        _gil_end(_GIL_B6)
            except Exception as _el:
                try: _log(f"Block#6CL lowmem consume err: {_el}")
                except Exception: pass
        if do_full:
            try:
                _gil_begin(_GIL_B6)
                try: _b10_passive_flush_if_dirty()
                except Exception: pass
                _gil_end(_GIL_B6)
            except Exception: pass
        if do_oom:
            try:
                if _OOM_NATIVE_OK and _NLIB is not None:
                    seq = int(_NLIB.cd_oom_seq())
                    if seq != last_seq:
                        last_seq = seq
                        _gil_begin(_GIL_B6)
                        try:
                            _oom_consume_native("live", do_log=True)
                        finally:
                            _gil_end(_GIL_B6)
            except Exception as e:
                try: _log(f"Block#6 consume err: {e}")
                except Exception: pass
        try:
            jt = float(_OOM_CLIENT_KILL_STATE.get("last_jheap_ts", 0.0))
            if jt != last_jt:
                last_jt = jt
                if jt: boost_until = time.monotonic() + _B6_BOOST_WINDOW_S
        except Exception: pass


_OOM_CLIENT_KILL_STATE = {"last_jheap_ts": 0.0, "trim_native": False, "lowmem_native": False}

def _proc_oom_score():
    adj = None; score = None
    try:
        with open("/proc/self/oom_score_adj", "r") as f:
            adj = int(f.read().strip())
    except Exception:
        adj = None
    try:
        with open("/proc/self/oom_score", "r") as f:
            score = int(f.read().strip())
    except Exception:
        score = None
    return adj, score

def _oom_killcount_now():
    try:
        if _OOM_NATIVE_OK and _NLIB is not None and hasattr(_NLIB, "cd_oom_killcount"):
            v = int(_NLIB.cd_oom_killcount())
            return v if v >= 0 else None
    except Exception:
        pass
    return None

def _oom_killcount_log_diag():
    if not (_OOM_NATIVE_OK and _NLIB is not None and hasattr(_NLIB, "cd_oom_killcount_diag")):
        return
    import ctypes as _c
    b = _c.create_string_buffer(768)
    n = int(_NLIB.cd_oom_killcount_diag(b, 768))
    if n > 0:
        _log("Block#6A +SP: killcount probe: %s" % b.value.decode("utf-8", "replace"))

def _oom_killcount_read_stored():
    try:
        p = _oom_path(_OOM_KILLCOUNT_FILE)
        if p and os.path.exists(p):
            with open(p, "r", encoding="utf-8") as f:
                return int(json.load(f).get("count", -1))
    except Exception:
        pass
    return None

def _oom_killcount_store(n):
    try:
        p = _oom_path(_OOM_KILLCOUNT_FILE)
        if p: _atomic_json_write(p, {"count": int(n), "ts": int(time.time())})
    except Exception:
        pass

def _client_kill_verdict(prev, cur, where):
    try:
        adj, score = _proc_oom_score()
        ju, jm, nh = _java_mem()
        rec = {
            "event_type": "client_oom_killed", "dropbox_tag": "client_oom_killed", "tombstone_norm_version": 1,
            "had_oom": True, "had_client_oom": True, "ts": int(time.time()),
            "culprit": "клиент (хост-процесс)", "culprit_kind": "host", "confidence": "high",
            "reason": "ядро/LMK убило процесс по нехватке памяти (oom_kill %d→%d)" % (prev, cur),
            "where": where,
            "kill_prev": int(prev), "kill_cur": int(cur), "kill_delta": int(cur - prev),
            "oom_score_adj": adj, "oom_score": score,
            "java_used": ju, "java_max": jm, "native_heap": nh,
        }
        _ems = ""
        try:
            _boot = str(where).startswith("boot")
            _ei = _exitinfo_latest(6 * 3600 * 1000 if _boot else 180000, own_only=_boot)
            if _ei is not None:
                _emf = _exitinfo_mem_fields(_ei); rec.update(_emf)
                try: rec["exit_process"] = str(_ei.getProcessName())
                except Exception: pass
                try: rec["exit_reason"] = _b34_reason_str(int(_ei.getReason()), int(_ei.getStatus()))
                except Exception: pass
                _ems = _exitinfo_mem_str(_emf)
                if "exit_foreground" in _emf:
                    rec["kill_context"] = "foreground" if _emf["exit_foreground"] else "background"
                    if not _emf["exit_foreground"]:
                        rec["confidence"] = "medium"
                        rec["reason"] += " [процесс был в фоне (важность=%s) -- фоновая выгрузка LMK ожидаема, не обязательно утечка]" % _emf.get("exit_importance_name")
            if not _boot:
                _uc = _ui_ctx_attach(rec)
        except Exception: pass
        p = _oom_path(_OOM_CLIENT_KILL_NAME)
        if p: _atomic_json_write(p, rec)
        _log("================ CLIENT OOM-KILL ================")
        _log("CLIENT OOM-KILL: where=%s oom_kill %d->%d (delta=%d) oom_score_adj=%s oom_score=%s java=%s/%s" % (
            where, prev, cur, cur - prev, adj, score, ju, jm))
        if _ems: _log("  в момент смерти (%s): %s" % (rec.get("exit_process") or "?", _ems))
        _ucs = _ui_ctx_str(rec.get("ui_ctx"))
        if _ucs: _log("  контекст: %s" % _ucs)
        _log("=================================================")
    except Exception as e:
        try: _log("Block#6A client-kill verdict err: %s" % e)
        except Exception: pass

def _oom_check_killcount(where):
    cur = _oom_killcount_now()
    if cur is None: return
    prev = _oom_killcount_read_stored()
    if prev is not None and cur > prev:
        _client_kill_verdict(prev, cur, where + ": cgroup oom_kill")
    if prev is None or cur != prev:
        _oom_killcount_store(cur)

def _client_lowmem_note(source, level, detail):
    try:
        adj, score = _proc_oom_score()
        ju, jm, nh = _java_mem()
        rec = {
            "event_type": "client_mem_pressure", "dropbox_tag": "client_mem_pressure", "tombstone_norm_version": 1,
            "had_client_lowmem": True, "ts": int(time.time()),
            "culprit": "клиент (хост-процесс)", "culprit_kind": "host", "confidence": "medium",
            "reason": detail, "where": source, "trim_level": level,
            "oom_score_adj": adj, "oom_score": score,
            "java_used": ju, "java_max": jm, "native_heap": nh,
        }
        p = _oom_path(_OOM_TRIM_NAME)
        if p: _atomic_json_write(p, rec)
        _log("CLIENT LOW-MEM: src=%s level=%s java=%s/%s oom_score=%s :: %s" % (
            source, level, ju, jm, score, detail))
    except Exception as e:
        try: _log("Block#6BC lowmem note err: %s" % e)
        except Exception: pass

def _recent_client_lowmem(max_age_ms=180000):
    try:
        p = _oom_path(_OOM_TRIM_NAME)
        if not (p and os.path.exists(p)):
            return None
        with open(p, "r", encoding="utf-8") as f:
            r = json.load(f)
        if not isinstance(r, dict):
            return None
        ts = r.get("ts")
        if ts is not None:
            try:
                if (time.time() - float(ts)) * 1000.0 > max_age_ms:
                    return None
            except Exception:
                pass
        return {"trim_level": r.get("trim_level"), "oom_score_adj": r.get("oom_score_adj"),
                "oom_score": r.get("oom_score"), "where": r.get("where"), "ts": ts}
    except Exception:
        return None

def _recent_oom_dump(max_age_ms=8000):
    try:
        p = _oom_path(_OOM_FILE_NAME)
        if not (p and os.path.exists(p)):
            return None
        with open(p, "r", encoding="utf-8") as f:
            r = json.load(f)
        if not isinstance(r, dict):
            return None
        ts = r.get("ts")
        if ts is not None:
            try:
                _age = (time.time() * 1000.0) - float(ts)
                if _age < 0 or _age > max_age_ms:
                    return None
            except Exception:
                pass
        _vd = r.get("verdict") if isinstance(r.get("verdict"), dict) else {}
        return {"culprit": (r.get("culprit") or _vd.get("culprit") or _vd.get("top_named")),
                "pressure_source": (r.get("pressure_source") or _vd.get("pressure_source")),
                "rate_mbps": r.get("rate_mbps"),
                "confidence": _vd.get("confidence"), "ts": ts}
    except Exception:
        return None

def _oom_check_java_heap():
    try:
        now = time.time()
        if (now - _OOM_CLIENT_KILL_STATE.get("last_jheap_ts", 0.0)) < _OOM_JHEAP_COOLDOWN_S:
            return
        ju, jm, _ = _java_mem()
        if ju > 0 and jm > 0 and (float(ju) / float(jm)) >= _OOM_JHEAP_PCT:
            _OOM_CLIENT_KILL_STATE["last_jheap_ts"] = now
            frac = float(ju) / float(jm)
            _client_lowmem_note("ART/Java-heap", "java_heap",
                "Java-куча у предела: %.0f%% (%d/%d МБ) — близко к OutOfMemoryError" % (
                    frac * 100.0, ju // 1048576, jm // 1048576))
    except Exception:
        pass

def _trim_native_unavailable_marker(detail):

    try:
        adj, score = _proc_oom_score()
        ju, jm, nh = _java_mem()
        rec = {
            "event_type": "client_trim_unavailable", "dropbox_tag": "client_trim_unavailable", "tombstone_norm_version": 1,
            "had_client_trim_unavailable": True, "ts": int(time.time()),
            "diagnostic_only": True, "attribution": False, "capture_disabled_only": True,
            "reason": "нативный off-GIL onTrimMemory interceptor не установился — обработка onTrimMemory отключена (no-op)",
            "detail": str(detail),
            "where": "onTrimMemory (native install unavailable)",
            "oom_score_adj": adj, "oom_score": score,
            "java_used": ju, "java_max": jm, "native_heap": nh,
        }
        p = _oom_path(_OOM_TRIM_UNAVAIL_NAME)
        if p: _atomic_json_write(p, rec)
    except Exception as _em:
        try: _log("Block#6C trim-unavail marker err: %s" % _em)
        except Exception: pass

def _lowmem_native_unavailable_marker(detail):

    try:
        adj, score = _proc_oom_score()
        ju, jm, nh = _java_mem()
        rec = {
            "event_type": "client_lowmem_unavailable", "dropbox_tag": "client_lowmem_unavailable", "tombstone_norm_version": 1,
            "had_client_lowmem_unavailable": True, "ts": int(time.time()),
            "diagnostic_only": True, "attribution": False, "capture_disabled_only": True,
            "reason": "нативный off-GIL onLowMemory interceptor не установился — onLowMemory отключён (no-op)",
            "detail": str(detail),
            "where": "onLowMemory (native install unavailable)",
            "oom_score_adj": adj, "oom_score": score,
            "java_used": ju, "java_max": jm, "native_heap": nh,
        }
        p = _oom_path(_OOM_LOWMEM_UNAVAIL_NAME)
        if p: _atomic_json_write(p, rec)
    except Exception as _em:
        try: _log("Block#6CL lowmem-unavail marker err: %s" % _em)
        except Exception: pass

def _b6_clear_unavailable_marker(name):

    try:
        p = _oom_path(name)
        if p: _rc_remove_both(p)
    except Exception:
        pass

def _b6_memory_native_detail(api, result):
    detail = "%s=%s" % (api, result)
    try:
        if _NLIB is not None and hasattr(_NLIB, "cd_mem_callbacks_last_error"):
            detail += "; ComponentCallbacks2 rc=%d" % int(_NLIB.cd_mem_callbacks_last_error())
    except Exception:
        pass
    return detail

def _b6_register_lowmem_native():


    _OOM_CLIENT_KILL_STATE["lowmem_native"] = False
    try:
        if _LOWMEM_NATIVE_OK and _NLIB is not None and hasattr(_NLIB, "cd_lowmem_install"):
            m = int(_NLIB.cd_lowmem_install(0))
            if m > 0:
                _OOM_CLIENT_KILL_STATE["lowmem_native"] = True
                _b6_clear_unavailable_marker(_OOM_LOWMEM_UNAVAIL_NAME)
                _log("Block#6CL: onLowMemory -> native callback/interceptor=%d (GIL-free, без Python-bounce на UI)" % m)
                return
            detail = _b6_memory_native_detail("cd_lowmem_install", m)
            _lowmem_native_unavailable_marker(detail)
            _log("Block#6CL: native lowmem capture unavailable (%s); причина не установлена, только диагностическая заметка" % detail)
            return
    except Exception as exc:
        try:
            _lowmem_native_unavailable_marker("cd_lowmem_install err: %s" % exc)
            _log("Block#6CL: native lowmem capture install error: %s (диагностика, не виновник)" % exc)
        except Exception: pass
        return
    if _NLIB is None:
        detail = "lib handle missing (_NLIB=None, _LOWMEM_NATIVE_OK=%s)" % _LOWMEM_NATIVE_OK
    elif not _LOWMEM_NATIVE_OK:
        detail = "native API absent or not bound (_LOWMEM_NATIVE_OK=False)"
    else:
        detail = "cd_lowmem_install symbol not bound"
    _lowmem_native_unavailable_marker(detail)
    _log("Block#6CL: native lowmem capture unavailable (%s); только диагностическая заметка" % detail)

def _b6_register_trim_callbacks():

    _OOM_CLIENT_KILL_STATE["trim_native"] = False
    try:
        if _TRIM_NATIVE_OK and _NLIB is not None and hasattr(_NLIB, "cd_trim_install"):
            n = int(_NLIB.cd_trim_install(0))
            if n > 0:
                _OOM_CLIENT_KILL_STATE["trim_native"] = True
                _b6_clear_unavailable_marker(_OOM_TRIM_UNAVAIL_NAME)
                _log("Block#6C: onTrimMemory -> native callback/interceptor=%d (GIL-free, без Python-bounce на UI)" % n)
            else:
                detail = _b6_memory_native_detail("cd_trim_install", n)
                _trim_native_unavailable_marker(detail)
                _log("Block#6C: native trim capture unavailable (%s); причина не установлена, только диагностическая заметка" % detail)
        else:
            if _NLIB is None:
                detail = "lib handle missing (_NLIB=None, _TRIM_NATIVE_OK=%s)" % _TRIM_NATIVE_OK
            elif not _TRIM_NATIVE_OK:
                detail = "native API absent or not bound (_TRIM_NATIVE_OK=False)"
            else:
                detail = "cd_trim_install symbol not bound"
            _trim_native_unavailable_marker(detail)
            _log("Block#6C: native trim capture unavailable (%s); только диагностическая заметка" % detail)
    except Exception as exc:
        try:
            _trim_native_unavailable_marker("cd_trim_install err: %s" % exc)
            _log("Block#6C: native trim capture install error: %s (диагностика, не виновник)" % exc)
        except Exception: pass

    try:
        _b6_register_lowmem_native()
    except Exception as exc:
        try: _log("Block#6CL lowmem register err: %s" % exc)
        except Exception: pass
    return None

def _b6_unregister_trim_callbacks():
    try:
        if _OOM_CLIENT_KILL_STATE.get("trim_native"):
            try:
                if _NLIB is not None and hasattr(_NLIB, "cd_trim_unhook"):
                    _NLIB.cd_trim_unhook()
            except Exception: pass
            _OOM_CLIENT_KILL_STATE["trim_native"] = False
            _log("Block#6C: нативный onTrimMemory interceptor снят")
    except Exception as e:
        try: _log("Block#6C trim unregister err: %s" % e)
        except Exception: pass
    try:
        if _OOM_CLIENT_KILL_STATE.get("lowmem_native"):
            try:
                if _NLIB is not None and hasattr(_NLIB, "cd_lowmem_unhook"):
                    _NLIB.cd_lowmem_unhook()
            except Exception: pass
            _OOM_CLIENT_KILL_STATE["lowmem_native"] = False
            _log("Block#6CL: нативный onLowMemory interceptor снят")
    except Exception as e2:
        try: _log("Block#6CL lowmem unregister err: %s" % e2)
        except Exception: pass

_LEAK_NAME = "client_leak.json"
_NA_NAME = "native_alloc_sites.json"
_NA_SAMPLE_ENABLE = True
_NA_MIN_BYTES = 8192
_NA_NATIVE_OK = False
_LEAK_NATIVE_OK = False
_LEAK_DIM_KEYS = ("rss", "java", "native", "fd", "threads", "jweak", "binder", "pyblocks")
_LEAK_DIM_NAMES = {"rss": "RSS", "java": "Java-heap", "native": "native-heap",
                   "fd": "descriptors (fd)", "threads": "threads",
                   "jweak": "JNI weak refs", "binder": "Binder proxies", "pyblocks": "Python blocks"}
_LEAK_BYTE_DIMS = ("rss", "java", "native")
_LEAK_SNAP_HEAD = 3
_LEAK_SNAP_PER = 7
_LEAK_STATE = {"last_seq": 0}
_LEAK_SEG_KEYS = ("summary.java-heap", "summary.native-heap", "summary.graphics",
                  "summary.stack", "summary.code", "summary.system",
                  "summary.total-pss", "summary.total-swap")
_LEAK_SEG_LABELS = {"summary.java-heap": "java-heap", "summary.native-heap": "native-heap",
                    "summary.graphics": "graphics", "summary.stack": "stack",
                    "summary.code": "code", "summary.system": "system",
                    "summary.total-pss": "total-pss", "summary.total-swap": "total-swap"}
_LEAK_SEG_TOP_SKIP = ("total-pss", "total-swap")
_LEAK_SEG_RING = []
_LEAK_SEG_MIN_GAP_MS = 25000
_LEAK_SEG_RING_MAX = 160

def _leak_seg_read(g=None, roll=None):
    try:
        if g is None:
            g = _smaps_scan_native()
        if not g:
            return None
        def _p(name):
            v = g.get(name)
            return int(v["pss"]) if v else 0
        java_heap = _p("dalvik-heap")
        native_heap = _p("native-malloc")
        graphics = _p("gfx-gpu") + _p("gfx-dmabuf")
        stack = _p("thread-stack")
        code = _p("code-so") + _p("code-dex-oat-art") + _p("code-apk")
        if roll is None:
            roll = _smaps_rollup_native()
        total_pss = int(roll["pss"]) if roll else sum(int(v["pss"]) for v in g.values())
        total_swap = int(roll["swap"]) if roll else sum(int(v["swap"]) for v in g.values())
        system = total_pss - (java_heap + native_heap + graphics + stack + code)
        if system < 0: system = 0
        return {"summary.java-heap": java_heap, "summary.native-heap": native_heap,
                "summary.graphics": graphics, "summary.stack": stack,
                "summary.code": code, "summary.system": system,
                "summary.total-pss": total_pss, "summary.total-swap": total_swap}
    except Exception:
        return None

def _leak_seg_sample():
    try:
        now = int(time.time() * 1000)
        if _LEAK_SEG_RING and (now - _LEAK_SEG_RING[-1][0]) < _LEAK_SEG_MIN_GAP_MS:
            return
        segs = _leak_seg_read()
        if not segs:
            return
        _LEAK_SEG_RING.append((now, segs))
        if len(_LEAK_SEG_RING) > _LEAK_SEG_RING_MAX:
            del _LEAK_SEG_RING[:len(_LEAK_SEG_RING) - _LEAK_SEG_RING_MAX]
    except Exception:
        pass

def _leak_seg_delta(span_s):
    try:
        if len(_LEAK_SEG_RING) < 2:
            return None
        now, cur = _LEAK_SEG_RING[-1][0], _LEAK_SEG_RING[-1][1]
        target = now - int(float(span_s or 0) * 1000)
        base_t, base = _LEAK_SEG_RING[0][0], _LEAK_SEG_RING[0][1]
        for t, segs in _LEAK_SEG_RING:
            if t <= target:
                base_t, base = t, segs
            else:
                break
        out = {"baseline_age_ms": now - base_t, "n_samples": len(_LEAK_SEG_RING),
               "span_s": (now - base_t) / 1000.0, "segments": {}}
        best_name, best_growth = None, None
        for k in _LEAK_SEG_KEYS:
            f, l = base.get(k), cur.get(k)
            if f is None or l is None:
                continue
            lbl = _LEAK_SEG_LABELS.get(k, k)
            g = l - f
            out["segments"][lbl] = {"first": f, "last": l, "growth": g}
            if lbl not in _LEAK_SEG_TOP_SKIP and (best_growth is None or g > best_growth):
                best_name, best_growth = lbl, g
        if best_name is not None:
            out["top"] = {"segment": best_name, "growth": best_growth}
        return out if out["segments"] else None
    except Exception:
        return None

def _leak_feed_java():
    try:
        if not (_LEAK_NATIVE_OK and _NLIB is not None):
            return
        ju, jm, _nh = _java_mem()
        if ju is None:
            return
        _NLIB.cd_leak_feed_java(ctypes.c_int64(int(ju)),
                                ctypes.c_int64(int(jm) if jm else -1))
    except Exception:
        pass

def _leak_read_native_snap():
    try:
        if not (_LEAK_NATIVE_OK and _NLIB is not None):
            return None
        n = int(_NLIB.cd_leak_slots())
        if n <= 0 or n > 4096:
            return None
        arr = (ctypes.c_int64 * n)()
        got = int(_NLIB.cd_leak_read(arr, ctypes.c_int32(n)))
        if got < _LEAK_SNAP_HEAD:
            return None
        vals = [int(arr[i]) for i in range(got)]
        ts_ms, flags, dimn = vals[0], vals[1], vals[2]
        dims = []
        for d in range(dimn):
            base = _LEAK_SNAP_HEAD + d * _LEAK_SNAP_PER
            if base + _LEAK_SNAP_PER > got:
                break
            key = _LEAK_DIM_KEYS[d] if d < len(_LEAK_DIM_KEYS) else ("dim%d" % d)
            dims.append({"dim": key, "leaking": bool(flags & (1 << d)),
                         "first": vals[base + 0], "last": vals[base + 1],
                         "slope_per_s": vals[base + 2] / 1000.0,
                         "r2": vals[base + 3] / 1000.0,
                         "growth": vals[base + 4], "n": vals[base + 5],
                         "span_s": vals[base + 6] / 1000.0})
        return {"ts_ms": ts_ms, "flags": flags, "dims": dims}
    except Exception as e:
        try: _log("Block#6D snap read err: %s" % e)
        except Exception: pass
        return None

def _leak_fmt_amount(dim, v):
    try:
        if dim in _LEAK_BYTE_DIMS:
            return "%.1f MB" % (float(v) / (1024.0 * 1024.0))
        return str(int(v))
    except Exception:
        return str(v)

_FD_CENSUS_STATE = {"baseline": None}
_FD_CENSUS_LOCK = threading.Lock()

def _fd_target_keys(tgt):
    if tgt.startswith("socket:"): return "socket", "socket:", "socket"
    if tgt.startswith("pipe:"): return "pipe", "pipe:", "pipe"
    if tgt.startswith("anon_inode:"):
        v = tgt[11:].lstrip("[").split("]", 1)[0].split(":", 1)[0].split(" ", 1)[0][:24]
        return "anon_inode", tgt, "anon_inode:" + v
    if tgt.startswith("/"):
        if tgt.endswith(" (deleted)"): tgt = tgt[:-10]
        if tgt.startswith("/dev/"):
            return "file", "/dev/*", "/dev/" + tgt[5:].split("/", 1)[0][:58]
        slash = tgt.rfind("/"); dot = tgt.rfind(".")
        return "file", (tgt[:slash] or "") + "/*", ("ext:" + tgt[dot:][:8]) if dot > slash else "file-other"
    return "other", tgt, "other"

def _fd_census():
    snap = {"api": 1, "pid": os.getpid(), "ts_ms": int(time.time()*1000),
            "atomic": False, "complete": False, "total": 0, "vanished": 0,
            "unreadable": 0, "overflow": 0, "truncated": 0, "scan_errno": 0,
            "by_kind": {}, "by_target": {}, "by_category": {}}
    try:
        lib = globals().get("_NLIB")
        if lib is not None and hasattr(lib, "cd_fd_census") and hasattr(lib, "cd_fd_census_api"):
            lib.cd_fd_census_api.restype = ctypes.c_int
            if int(lib.cd_fd_census_api()) != 1: raise ValueError("unsupported FD Census API")
            snap["source"] = "native"
            fn = lib.cd_fd_census
            fn.argtypes = [ctypes.POINTER(ctypes.c_char), ctypes.c_int32]; fn.restype = ctypes.c_int
            buf = ctypes.create_string_buffer(2*1024*1024)
            rc = int(fn(buf, len(buf)))
            snap["native_rc"] = rc
            if rc <= 0: raise RuntimeError("cd_fd_census rc=%d" % rc)
            raw = json.loads(buf.raw[:rc].decode("utf-8"))
            if raw.get("api") != 1: raise ValueError("invalid FD Census response")
            snap.update({k: raw[k] for k in ("complete", "total", "vanished", "unreadable", "overflow", "truncated", "scan_errno")})
            rows = raw["rows"]; snap["source"] = "native"
        else:
            snap["source"] = "python-fallback"; rows = []; grouped = {}
            for index, name in enumerate(os.listdir("/proc/self/fd")):
                if not name.isdigit(): continue
                if index >= 32768: snap["overflow"] += 1; break
                try: tgt = os.readlink("/proc/self/fd/" + name)
                except OSError as e:
                    if e.errno in (2, 9): snap["vanished"] += 1
                    else: snap["unreadable"] += 1
                    continue
                if len(tgt.encode("utf-8")) >= 4095: snap["truncated"] += 1; continue
                keys = _fd_target_keys(tgt); snap["total"] += 1
                if keys not in grouped and len(grouped) >= 256: snap["overflow"] += 1; continue
                grouped[keys] = grouped.get(keys, 0) + 1
            rows = [dict(kind=k[0], category=k[1], target=k[2], count=v) for k,v in grouped.items()]
            snap["complete"] = not (snap["overflow"] or snap["unreadable"] or snap["truncated"])
        for row in rows:
            n = int(row["count"])
            if n < 0: raise ValueError("negative FD count")
            for field, key in (("by_kind", "kind"), ("by_target", "target"), ("by_category", "category")):
                k = row[key]; snap[field][k] = snap[field].get(k, 0) + n
        if snap["complete"] and sum(snap["by_category"].values()) != snap["total"]:
            raise ValueError("FD Census total mismatch")
    except Exception as e:
        snap["complete"] = False; snap["error"] = str(e)
    return snap

def _fd_census_begin():
    with _FD_CENSUS_LOCK:
        old = _FD_CENSUS_STATE["baseline"]
        if old is not None and old.get("pid") == os.getpid(): return False
    baseline = _fd_census()
    with _FD_CENSUS_LOCK:
        _FD_CENSUS_STATE["baseline"] = baseline
    return True

def _fd_census_reset():
    with _FD_CENSUS_LOCK:
        _FD_CENSUS_STATE["baseline"] = None

def _fd_census_delta(current):
    with _FD_CENSUS_LOCK:
        base = _FD_CENSUS_STATE["baseline"]
    out = {"baseline_scope": "detector_leak_watchdog_start", "atomic": False,
           "attribution_kind": "fd_category_growth_not_plugin_owner", "current": current,
           "baseline": base, "status": "unavailable", "top_growth": []}
    if base is None: out["reason"] = "baseline_missing"; return out
    if base.get("pid") != current.get("pid"):
        out["reason"] = "process_changed"; return out
    if not base.get("complete") or not current.get("complete"):
        out["reason"] = "incomplete_snapshot"; return out
    a = base["by_category"]; b = current["by_category"]
    rows = [dict(category=k, baseline=int(a.get(k, 0)), current=int(b.get(k, 0)),
                 delta=int(b.get(k, 0))-int(a.get(k, 0))) for k in set(a) | set(b)]
    rows.sort(key=lambda r: (-r["delta"], r["category"]))
    out.update(status="ok", total_delta=current["total"]-base["total"],
               top_growth=[r for r in rows if r["delta"] > 0][:6],
               decreased_total=sum(-r["delta"] for r in rows if r["delta"] < 0),
               increased_total=sum(r["delta"] for r in rows if r["delta"] > 0))
    return out

def _fd_census_top(census):
    if census.get("status") != "ok": return "unavailable: " + census.get("reason", "unknown")
    rows = census.get("top_growth") or []
    if not rows: return "no growing categories"
    return ", ".join("%s +%d (=%d)" % (json.dumps(r["category"], ensure_ascii=False), r["delta"], r["current"]) for r in rows)


def _leak_mem_snapshot():
    snap = {}
    try:
        g = _smaps_scan_native()
        if g:
            def _p(name):
                v = g.get(name)
                return int(v["pss"]) if v else 0
            roll = _smaps_rollup_native()
            dalvik = _p("dalvik-heap")
            native = _p("native-malloc")
            total = int(roll["pss"]) if roll else sum(int(v["pss"]) for v in g.values())
            other = total - dalvik - native
            if other < 0: other = 0
            snap["pss"] = {"dalvik": dalvik, "native": native, "other": other, "total": total}
            seg = _leak_seg_read(g, roll)
            if seg: snap["memstat"] = seg
    except Exception: pass
    try:
        census = _fd_census()
        snap["fd_by_kind"] = dict(census["by_kind"])
        snap["fd_census"] = _fd_census_delta(census)
    except Exception: pass
    return snap

_LEAK_PEAK_NAME = "client_leak_peak.json"
_LEAK_PEAK_MIN_GAP_MS = 60000
_LEAK_PEAK_STATE = {"last_ms": 0}
_SMAPS_NATIVE_GROUPS = ("native-malloc", "gfx-gpu", "gfx-dmabuf", "shmem-ashmem",
                        "code-so", "code-dex-oat-art", "code-apk", "fonts",
                        "dalvik-heap", "thread-stack", "file-other", "anon-other",
                        "anon-private")
_SMAPS_NATIVE_FIELDS = 4
_SMAPS_NATIVE_LAYOUT_VERSION = 1

_DMABUF_FD_FIELDS = 12
_DMABUF_FD_TTL_S = 1.5
_DMABUF_FD_CACHE = {"ts": -1e9, "v": None}

def _dmabuf_fd_scan(force=False):
    try:
        if _NLIB is None or not hasattr(_NLIB, "cd_dmabuf_fd_scan"):
            return None
        now = time.monotonic()
        cc = _DMABUF_FD_CACHE
        if (not force) and cc["v"] is not None and (now - cc["ts"]) < _DMABUF_FD_TTL_S:
            return cc["v"]
        arr = (ctypes.c_int64 * _DMABUF_FD_FIELDS)()
        got = int(_NLIB.cd_dmabuf_fd_scan(arr, ctypes.c_int32(_DMABUF_FD_FIELDS)))
        if got < _DMABUF_FD_FIELDS or int(arr[0]) != 1:
            return None
        v = {"fds": int(arr[1]), "bufs": int(arr[2]), "bytes": int(arr[3]),
             "unmapped_bufs": int(arr[4]), "unmapped_bytes": int(arr[5]),
             "size_unknown": int(arr[6]), "fds_scanned": int(arr[7]),
             "ino_src": int(arr[8]), "mapped_inodes": int(arr[9]),
             "dedup_overflow": int(arr[10]), "scan_us": int(arr[11])}
        cc["v"] = v; cc["ts"] = now
        return v
    except Exception:
        return None

def _smaps_scan_native():
    try:
        if not (_SMAPS_NATIVE_OK and _NLIB is not None):
            return None
        n = len(_SMAPS_NATIVE_GROUPS) * _SMAPS_NATIVE_FIELDS
        arr = (ctypes.c_int64 * n)()
        got = int(_NLIB.cd_smaps_groups(arr, ctypes.c_int32(n)))
        if got < n:
            return None
        out = {}
        for i, name in enumerate(_SMAPS_NATIVE_GROUPS):
            b = i * _SMAPS_NATIVE_FIELDS
            out[name] = {"rss": int(arr[b + 0]), "pss": int(arr[b + 1]),
                         "swap": int(arr[b + 2]), "n": int(arr[b + 3])}
        try:
            dm = _dmabuf_fd_scan()
            gd = out.get("gfx-dmabuf")
            if dm and gd is not None:
                ub = int(dm.get("unmapped_bytes", 0))
                gd["smaps_pss"] = int(gd["pss"])
                gd["fd_unmapped"] = ub
                gd["fd_bufs"] = int(dm.get("bufs", 0))
                gd["fd_bytes"] = int(dm.get("bytes", 0))
                if ub > 0:
                    gd["rss"] = int(gd["rss"]) + ub
                    gd["pss"] = int(gd["pss"]) + ub
        except Exception:
            pass
        return out
    except Exception:
        return None

def _smaps_rollup_native():
    try:
        if not (_SMAPS_NATIVE_OK and _NLIB is not None):
            return None
        arr = (ctypes.c_int64 * 3)()
        got = int(_NLIB.cd_smaps_rollup(arr, ctypes.c_int32(3)))
        if got < 3:
            return None
        r = {"pss": int(arr[0]), "rss": int(arr[1]), "swap": int(arr[2])}
        try:
            dm = _dmabuf_fd_scan()
            ub = int(dm.get("unmapped_bytes", 0)) if dm else 0
            if ub > 0:
                r["pss_smaps"] = r["pss"]; r["dmabuf_fd_unmapped"] = ub
                r["pss"] += ub; r["rss"] += ub
        except Exception:
            pass
        return r
    except Exception:
        return None

def _smaps_top_groups(limit=14):
    g = _smaps_scan_native()
    if not g:
        return None
    items = [(k, v) for k, v in g.items() if (v["rss"] or v["pss"] or v["swap"] or v["n"])]
    if not items:
        return None
    items.sort(key=lambda kv: kv[1].get("pss", 0), reverse=True)
    res = []
    for k, v in items[:limit]:
        d = {"group": k, "rss": v["rss"], "pss": v["pss"], "swap": v["swap"], "maps": v["n"]}
        if "fd_unmapped" in v:
            d["fd_unmapped"] = v["fd_unmapped"]; d["fd_bufs"] = v.get("fd_bufs", 0)
        res.append(d)
    return res

def _smaps_rollup_text():
    try:
        with open("/proc/self/smaps_rollup", "r") as f:
            return f.read()[:4096]
    except Exception:
        return None

def _leak_fd_detail(census=None):
    if census is None: census = _fd_census()
    return {"by_kind": dict(census.get("by_kind") or {}),
            "by_target": dict(sorted((census.get("by_target") or {}).items(),
                                     key=lambda kv: (-kv[1], kv[0]))[:15]),
            "complete": bool(census.get("complete")), "atomic": False,
            "source": census.get("source"), "unreadable": census.get("unreadable", 0),
            "vanished": census.get("vanished", 0), "overflow": census.get("overflow", 0),
            "truncated": census.get("truncated", 0), "error": census.get("error")}


def _dumpsys_meminfo_text():
    proc = None; rdr = None
    try:
        pid = os.getpid()
        Runtime = jclass("java.lang.Runtime")
        proc = Runtime.getRuntime().exec(["sh", "-c", "dumpsys meminfo %d 2>&1" % pid])
        ins = proc.getInputStream()
        rdr = jclass("java.io.BufferedReader")(jclass("java.io.InputStreamReader")(ins))
        sb = []; n = 0
        while n < 400:
            ln = rdr.readLine()
            if ln is None: break
            sb.append(str(ln)); n += 1
        txt = "\n".join(sb)
        return txt[:8192] if txt.strip() else None
    except Exception:
        return None
    finally:
        if rdr is not None:
            try: rdr.close()
            except Exception: pass
        if proc is not None:
            try: proc.getOutputStream().close()
            except Exception: pass
            try: proc.getErrorStream().close()
            except Exception: pass
            try: proc.destroy()
            except Exception: pass

def _leak_peak_capture(where, rec):
    try:
        now = int(time.time() * 1000)
        if (now - _LEAK_PEAK_STATE.get("last_ms", 0)) < _LEAK_PEAK_MIN_GAP_MS:
            return
        _LEAK_PEAK_STATE["last_ms"] = now
        cap = {"type": "client_leak_peak", "ts": now, "where": where,
               "leaking_dims": rec.get("leaking_dims"),
               "confidence": rec.get("confidence"),
               "rss_top_segment": rec.get("rss_top_segment"),
               "meminfo": rec.get("mem_snapshot") or _leak_mem_snapshot(),
               "smaps_rollup": _smaps_rollup_text(),
               "smaps_top_groups": _smaps_top_groups(),
               "fd_detail": _leak_fd_detail(((rec.get("mem_snapshot") or {}).get("fd_census") or {}).get("current")),
               "fd_census": rec.get("fd_census"),
               "dumpsys_meminfo": _dumpsys_meminfo_text()}
        p = _oom_path(_LEAK_PEAK_NAME)
        if p: _atomic_json_write(p, cap)
        try:
            tg = cap.get("smaps_top_groups") or []
            top = ", ".join("%s=%.1fMB" % (g["group"], g["pss"] / 1048576.0) for g in tg[:5])
            _log("Block#6D peak-capture -> %s | top smaps: %s" % (_LEAK_PEAK_NAME, top))
        except Exception:
            pass
    except Exception as e:
        try: _log("Block#6D peak-capture err: %s" % e)
        except Exception: pass

_NA_CLIENT_LIBS = ("libtmessages", "libetgadblock", "libculprit", "libvosk", "libmaps-mobile", "libimage_processing_util_jni", "liblanguage_id_l2c_jni", "libsurface_util_jni", "libjnidispatch", "libshadowhook", "libdatastore_shared_counter", "libchaquopy_java", "libpython", "libsqlite3_chaquopy", "libsqlite3_python", "libcrypto_chaquopy", "libcrypto_python", "libssl_chaquopy", "libssl_python")
_NA_GFX_LIBS = ("vulkan", "adreno", "libgsl", "libllvm-glnext", "libEGL", "libGLES", "libvulkan", "libVK", "mali", "libgpu", "powervr", "libhwui", "libskia", "libgui", "librenderengine", "libnativewindow", "libjnigraphics")

def _na_frame_cat(fr):
    try:
        m = fr.split("+", 1)[0]
    except Exception:
        return None
    for pfx in _NA_CLIENT_LIBS:
        if m.startswith(pfx):
            return "app"
    for pfx in _NA_GFX_LIBS:
        if m.startswith(pfx):
            return "gfx"
    return None

_NA_GFX_FAMILY_MIN = 3
_NA_TOPBUCKET_MIN_BYTES = 2 * 1024 * 1024
_NA_EPOCH_MS = 0
_NA_EPOCH_MIN_AGE_S = 30.0
_NA_DROPS_UNDERSAMPLE_MIN = 5000
_NA_DROPS_UNDERSAMPLE_FRAC = 0.05
_NA_COVERAGE_LOW = 0.25
_NA_XVAL_MIN_GROWTH = 8 * 1024 * 1024

def _na_mark_epoch():
    global _NA_EPOCH_MS
    try: _NA_EPOCH_MS = int(time.time() * 1000)
    except Exception: _NA_EPOCH_MS = 0


def _na_mod_label(frame):
    try:
        m = frame.split("+", 1)[0]
    except Exception:
        return None
    if not m:
        return None
    if m.endswith(".so"):
        m = m[:-3]
    _p = m.rsplit(".", 1)
    if len(_p) == 2 and _p[1].isdigit():
        m = _p[0]
    return m or None

def _na_top_bucket_summary():
    try:
        p = _oom_path(_NA_NAME)
        if not p or not os.path.exists(p):
            return None
        with open(p, "r", encoding="utf-8") as _f:
            d = json.load(_f)
    except Exception:
        return None
    sites = d.get("sites")
    if not isinstance(sites, list) or not sites:
        return None
    agg = {}
    gfx_frame = {}
    for s in sites:
        try:
            frames = s.get("frames") or []
            bucket = s.get("bucket") or "app"
            rb = int(s.get("retained_bytes") or 0)
        except Exception:
            continue
        if rb <= 0 or not frames:
            continue
        mod = None
        for fr in frames:
            c = _na_frame_cat(fr)
            if (bucket == "app" and c == "app") or (bucket == "gfx" and c == "gfx"):
                mod = _na_mod_label(fr); break
        if not mod:
            mod = _na_mod_label(frames[0]) or "?"
        label = ("%s/%s" % (bucket, mod)) if bucket == "gfx" else mod
        e = agg.get(label)
        if e is None:
            agg[label] = [rb, 1, bucket, mod]
        else:
            e[0] += rb; e[1] += 1
        if bucket == "gfx":
            tf = frames[0]
            g = gfx_frame.get(tf)
            if g is None:
                gfx_frame[tf] = [1, rb]
            else:
                g[0] += 1; g[1] += rb
    if not agg:
        return None
    order = sorted(agg.items(), key=lambda kv: kv[1][0], reverse=True)
    modules = []
    for label, (b, n, bucket, mod) in order:
        if b < _NA_TOPBUCKET_MIN_BYTES:
            continue
        modules.append({"label": label, "module": mod, "bucket": bucket, "bytes": b, "sites": n})
        if len(modules) >= 3:
            break
    parts = []
    for _i, _m in enumerate(modules):
        _mb = _m["bytes"] / 1048576.0
        parts.append(("%s dominant (~%.0fMB)" if _i == 0 else "%s (~%.0fMB)") % (_m["label"], _mb))
    display = ("host_native: " + " + ".join(parts)) if parts else None
    leak_family = None; gfx_family = None
    if gfx_frame:
        _tf, (_cnt, _b) = max(gfx_frame.items(), key=lambda kv: kv[1][0])
        if _cnt >= _NA_GFX_FAMILY_MIN:
            leak_family = "hwui_gfx"
            gfx_family = {"top_frame": _tf, "sites": _cnt, "bytes": _b}
    _stats = None; _under = False; _ureas = None; _eage = None
    try:
        _lsb = int(d.get("live_sampled_bytes") or 0)
        _samp = int(d.get("sampled_allocs") or 0)
        _drops = int(d.get("table_full_drops") or 0)
        _uniq = int(d.get("unique_stacks") or 0)
        _stats = {"live_sampled_bytes": _lsb, "sampled_allocs": _samp,
                  "table_full_drops": _drops, "unique_stacks": _uniq,
                  "min_bytes": int(d.get("min_bytes") or 0)}
        _denom = _samp + _drops
        _dfrac = (float(_drops) / float(_denom)) if _denom > 0 else 0.0
        if _drops >= _NA_DROPS_UNDERSAMPLE_MIN and _dfrac >= _NA_DROPS_UNDERSAMPLE_FRAC:
            _under = True
            _ureas = "table_full_drops=%d (%.0f%% of inserts) -> alloc-site table saturated, sites truncated" % (_drops, _dfrac * 100.0)
        if _NA_EPOCH_MS > 0:
            _eage = max(0.0, (time.time() * 1000 - _NA_EPOCH_MS) / 1000.0)
            if _eage < _NA_EPOCH_MIN_AGE_S:
                _under = True
                _er2 = "alloc-site epoch reset %.0fs ago (recent detector reload) -> cold table" % _eage
                _ureas = (_ureas + "; " + _er2) if _ureas else _er2
    except Exception:
        pass
    return {"display": display, "modules": modules, "leak_family": leak_family, "gfx_family": gfx_family,
            "sampled_stats": _stats, "undersampled": _under, "undersample_reason": _ureas, "epoch_age_s": _eage}

_JR_HOST_LIB_HINTS = ("libhwui", "libtmessages", "libc.so", "libc++", "libjemalloc", "libegl", "libgles", "vulkan", "adreno", "gralloc", "libgui", "libui", "libandroid", "libutils", "libskia", "librs", "libbinder", "libcutils", "libft2", "libharfbuzz", "libsqlite", "libz.so", "libunwind", "libbase", "libnativewindow", "dmabuf", "ashmem", "libmali", "libopencl")
_JR_PYRT_LIB_HINTS = ("libpython", "libchaquopy", "chaquopy", "libpycore")
_JR_NATIVE_HOST_SHARE = 0.80
_JR_PLUGIN_NATIVE_MIN_BYTES = 4194304
_B28C_UNTAG_AMBIENT_LO = 0.60
_OOM_PREV_EMIT = None
_OOM_GROWTH_FRESH_MS = 180000
_OOM_GROWTH_MIN_BYTES = 4 * 1024 * 1024
_OOM_RATE_BASE_RING = []
_OOM_RATE_BASE_MAX = 32
_OOM_RATE_BASE_MIN_GAP_MS = 700
_OOM_RATE_BASE_STATE = {"last_ms": 0}

def _oom_rate_baseline_sample():
    try:
        now = int(time.time() * 1000)
        if now - int(_OOM_RATE_BASE_STATE.get("last_ms") or 0) < _OOM_RATE_BASE_MIN_GAP_MS:
            return
        snap = native_mem_snapshot(top=_OOM_TOPN)
        if not snap:
            return
        m = {}
        for kv in (snap.get("top") or []):
            try: m[str(kv[0])] = max(0, int(kv[1]))
            except Exception: pass
        if not m:
            return
        _OOM_RATE_BASE_STATE["last_ms"] = now
        _OOM_RATE_BASE_RING.append((now, m))
        if len(_OOM_RATE_BASE_RING) > _OOM_RATE_BASE_MAX:
            del _OOM_RATE_BASE_RING[:len(_OOM_RATE_BASE_RING) - _OOM_RATE_BASE_MAX]
    except Exception:
        pass

def _oom_rate_baseline_pick(now_ts):
    try:
        best = None
        for t, m in _OOM_RATE_BASE_RING:
            if t < now_ts and (now_ts - t) <= _OOM_GROWTH_FRESH_MS:
                if best is None or t > best[0]:
                    best = (t, m)
        if best:
            return {"ts": best[0], "top": best[1]}
    except Exception:
        pass
    return None
_OOM_REPEAT_COOLDOWN_S = 600.0
_OOM_REPEAT_ESC_RATE_X = 1.5
_OOM_REPEAT_ESC_DISPLAY_B = 16 * 1048576
_OOM_REPEAT_ESC_GROWTH_B = 8 * 1048576
_OOM_REPEAT_ESC_UNTAGGED_B = 32 * 1048576
_OOM_MR_SLOTS = {}
_OOM_MR_SLOTS_MAX = 6
_OOM_TAGGED_HEADLINE_MIN_SHARE = 0.10
_LEAK_LAST_KIND = {}

def _jr_native_host_split(ns):
    try:
        if not ns or not ns.get("modules"):
            return (0, 0, 0.0)
        host_b = 0; pyrt_b = 0; other_b = 0
        for m in (ns.get("modules") or []):
            try: b = int(m.get("bytes") or 0)
            except Exception: b = 0
            if b <= 0:
                continue
            mod = (m.get("module") or "").lower()
            bucket = m.get("bucket") or "app"
            if any(h in mod for h in _JR_PYRT_LIB_HINTS):
                pyrt_b += b
            elif (bucket == "gfx") or any(h in mod for h in _JR_HOST_LIB_HINTS):
                host_b += b
            else:
                other_b += b
        hostish = host_b + other_b
        tot = hostish + pyrt_b
        sh = (float(hostish) / float(tot)) if tot > 0 else 0.0
        return (hostish, pyrt_b, sh)
    except Exception:
        return (0, 0, 0.0)

_NA_OTHER_TOPN = 40

def _na_filter_client(path):
    try:
        with open(path, "r", encoding="utf-8") as _f:
            d = json.load(_f)
        sites = d.get("sites")
        if not isinstance(sites, list):
            return None
        kept = []; other = []
        for s in sites:
            frames = s.get("frames") or []
            cat = None
            for fr in frames:
                c = _na_frame_cat(fr)
                if c == "app":
                    cat = "app"; break
                if c == "gfx" and cat is None:
                    cat = "gfx"
            if cat:
                s["bucket"] = cat
                kept.append(s)
            else:
                other.append(s)
        def _rb(x):
            try: return int(x.get("retained_bytes") or 0)
            except Exception: return 0
        try:
            kept.sort(key=_rb, reverse=True)
            for _i, _s in enumerate(kept): _s["rank"] = _i + 1
        except Exception: pass
        try:
            other.sort(key=_rb, reverse=True)
            for _i, _s in enumerate(other): _s["rank"] = _i + 1
        except Exception: pass
        kept_bytes = 0
        for _s in kept: kept_bytes += _rb(_s)
        other_bytes = 0
        for _s in other: other_bytes += _rb(_s)
        other_n = len(other)
        other_top = other[:_NA_OTHER_TOPN]
        d["sites"] = kept
        d["other_sites"] = other_top
        _app_n = 0; _gfx_n = 0
        for _s in kept:
            if _s.get("bucket") == "gfx": _gfx_n += 1
            else: _app_n += 1
        d["filtered"] = {"mode": "client_plugin_focused", "kept_sites": len(kept), "kept_app_sites": _app_n, "kept_gfx_sites": _gfx_n, "kept_retained_bytes": kept_bytes, "other_sites": other_n, "other_retained_bytes": other_bytes, "other_sites_listed": len(other_top)}
        _atomic_json_write(path, d)
        return (len(kept), kept_bytes, other_n, other_bytes)
    except Exception as e:
        try: _log("Block#3S na filter err: %s" % e)
        except Exception: pass
        return None

def _na_dump(where):
    try:
        if not (_NA_NATIVE_OK and _NLIB is not None and hasattr(_NLIB, "cd_na_dump")):
            return
        try:
            if not int(_NLIB.cd_na_is_on()):
                return
        except Exception:
            return
        p = _oom_path(_NA_NAME)
        if not p:
            return
        n = int(_NLIB.cd_na_dump(p.encode("utf-8")))
        _flt = _na_filter_client(p)
        try:
            _log("Block#3S native alloc-sites -> %s | live_sampled=%d uniq=%d sampled=%d full_drops=%d" % (
                _NA_NAME, n, int(_NLIB.cd_na_unique()), int(_NLIB.cd_na_sampled_count()), int(_NLIB.cd_na_full_drops())))
        except Exception:
            pass

        try:
            _f3 = int(_NLIB.cd_na_full_drops()) if hasattr(_NLIB, "cd_na_full_drops") else 0
            _s3 = int(_NLIB.cd_na_sampled_count()) if hasattr(_NLIB, "cd_na_sampled_count") else 0
            _p3 = _LE_3S_PREV[0]
            _LE_3S_PREV[0] = (_f3, _s3)
            _df3 = (_f3 - _p3[0]) if _p3 is not None else -1
            _ds3 = (_s3 - _p3[1]) if _p3 is not None else -1
            _attempts3 = _ds3 if _ds3 >= _df3 else _df3
            if _df3 > 0 and _ds3 >= 0 and _attempts3 >= _LE_3S_MIN_INSERTS and (float(_df3) / float(_attempts3)) >= _LE_3S_DROP_FRAC and hasattr(_NLIB, "cd_na_min_bytes") and hasattr(_NLIB, "cd_na_enable"):
                _cur3 = int(_NLIB.cd_na_min_bytes())
                if 0 < _cur3 < _LE_3S_MIN_CAP:
                    _new3 = _cur3 * 2
                    if _new3 > _LE_3S_MIN_CAP:
                        _new3 = _LE_3S_MIN_CAP
                    if int(_NLIB.cd_na_enable(1, int(_new3))) == 0:
                        global _NA_MIN_BYTES
                        _NA_MIN_BYTES = int(_new3)
                        _log("Block#3S +LG: alloc-site table saturated in window (full_drops=+%d, %.0f%% of %d window capture attempts) -> adaptive min_bytes %d -> %d" % (_df3, 100.0 * float(_df3) / float(_attempts3), _attempts3, _cur3, _new3))
        except Exception:
            pass
        if _flt is not None:
            try:
                _log("Block#3S site split: client/plugin=%d (%.2fMB), other/system=%d (%.2fMB) [retained in other_sites]" % (
                    _flt[0], _flt[1] / 1048576.0, _flt[2], _flt[3] / 1048576.0))
            except Exception:
                pass
    except Exception as e:
        try: _log("Block#3S na dump err: %s" % e)
        except Exception: pass

def _iz_proxy_top():
    try:
        p = _b28c_proxy_path()
        if not p or not os.path.exists(p):
            return None
        with open(p, "r", encoding="utf-8") as f:
            data = json.load(f)
        if not isinstance(data, dict) or not data:
            return None
        total = 0; best = None; best_n = -1
        for pid, rec in data.items():
            if not pid or pid == _SELF_ID or pid == __id__:
                continue
            try: n = int((rec or {}).get("count") or 0)
            except Exception: n = 0
            if n <= 0:
                continue
            total += n
            if n > best_n:
                best_n = n; best = pid
        if not best or best_n <= 0 or total <= 0:
            return None
        return {"culprit": best, "count": int(best_n), "total": int(total),
                "untagged": 0, "src": "proxy"}
    except Exception:
        return None



_LE_TAG_HIST = []
_LE_TAG_LAST = [0]
_LE_TAG_PERIOD_MS = 30000
_LE_TAG_KEEP = 80
_LE_MIN_BYTES = 16777216
_LE_SHARE = 0.20
_LE_COVER = 0.5
_LE_3S_DROP_FRAC = 0.10
_LE_3S_MIN_CAP = 131072
_LE_3S_MIN_INSERTS = 2048
_LE_3S_PREV = [None]

def _le_tag_sample():
    try:
        now = int(time.time() * 1000)
        if now - _LE_TAG_LAST[0] < _LE_TAG_PERIOD_MS:
            return
        _LE_TAG_LAST[0] = now
        try:
            _topn = max(16, len(_IDX_PID) + 8)
        except Exception:
            _topn = 64
        s = native_mem_snapshot(top=_topn)
        if not s or not s.get("top"):
            return
        m = {}
        for _pid, _b in (s.get("top") or []):
            if (not _pid) or _pid.startswith("⟨") or _pid in (_SELF_ID, __id__, "__regtest__", "culprit_detector"):
                continue
            try: _b = int(_b)
            except Exception: continue
            if _b > 0:
                m[_pid] = _b
        _LE_TAG_HIST.append((now, m))
        if len(_LE_TAG_HIST) > _LE_TAG_KEEP:
            del _LE_TAG_HIST[:len(_LE_TAG_HIST) - _LE_TAG_KEEP]
    except Exception:
        pass

def _le_tag_attr(dims):
    try:
        nat = None
        for d in dims:
            if d.get("dim") == "native" and d.get("leaking"):
                nat = d
                break
        if not nat:
            return None
        span_ms = int(float(nat.get("span_s") or 0.0) * 1000.0)
        growth = int(nat.get("growth") or 0)
        if span_ms <= 0 or growth <= 0 or len(_LE_TAG_HIST) < 2:
            return None
        now = int(time.time() * 1000)
        lo = now - span_ms - _LE_TAG_PERIOD_MS
        win = [e for e in _LE_TAG_HIST if e[0] >= lo]
        if len(win) < 2:
            return None
        t0, first = win[0]
        t1, last = win[-1]
        if (t1 - t0) < int(span_ms * _LE_COVER):
            return None
        best = None; best_g = 0
        for _pid, _b in last.items():
            _g = int(_b) - int(first.get(_pid, 0))
            if _g > best_g:
                best_g = _g; best = _pid
        if not best:
            return None
        need = _LE_MIN_BYTES
        _shr = int(growth * _LE_SHARE)
        if _shr > need:
            need = _shr
        if best_g < need:
            return None
        return {"culprit": best, "growth": int(best_g), "native_growth": int(growth),
                "share_of_native_growth": (round(float(best_g) / float(growth), 4) if growth > 0 else 0.0),
                "first_bytes": int(first.get(best, 0)), "last_bytes": int(last.get(best, 0)),
                "hist_n": len(win), "hist_span_s": round((t1 - t0) / 1000.0, 1),
                "src": "malloc-tagger", "pseudo": bool(best in _OOM_PSEUDO_TAGS)}
    except Exception:
        return None


_B41_ON = True
_THR_OWN_OK = False
_WREF_OK = False
_LEAK_FEED_DIM_OK = False
_B41_OWN_PERIOD_MS = 30000
_B41_OWN_KEEP = 80
_B41_THR_HIST = []
_B41_WREF_HIST = []
_B41_OWN_LAST = [0]
_B41_THR_MIN = 8
_B41_WREF_MIN = 256
_B41_SHARE = 0.5
_B41_COVER = 0.5
_B41_WREF_CAP = 51200
_B41_WREF_WARN_FRAC = 0.75
_B41_WREF_DEDUP_MS = 1800000
_B41_WREF_LAST = [0]
_B41_WREF_FILE = "weakref_verdict.json"
_B41_RETAIN_FILE = "plugin_retain_verdict.json"
_B41_FEED_LAST = [0]
_B41_DEBUG_CLS = [None]
_B41_CENSUS_HIST = []
_B41_CENSUS_LAST = [0, 0]
_B41_CENSUS_GAP_MS = 600000
_B41_CENSUS_TRIGGER = 40000
_B41_CENSUS_MIN = 10000
_B41_CENSUS_SHARE = 0.15
_B41_MOD_PID = {}
_B41_RETAIN = {}
_B41_RETAIN_LOCK = threading.Lock()
_B41_RETAIN_DELAYS = (90.0, 300.0)
_B41_GEN = "%d:%d" % (id(_B41_RETAIN), int(time.time() * 1000))
_B41_FUNC_MAX = 64
_TB_VERDICT_TOL_MS = 1500
_B41_HOLDER_LEVELS = 6
_B41_HOLDER_FRONTIER = 64
_B41_HOLDER_BUDGET_S = 0.6

def _b41_bind(lib, c):
    global _THR_OWN_OK, _WREF_OK, _LEAK_FEED_DIM_OK
    try:
        if hasattr(lib, "cd_thr_live_topn") and hasattr(lib, "cd_thr_adopt"):
            lib.cd_thr_adopt.argtypes = [c.c_int32]; lib.cd_thr_adopt.restype = c.c_int
            lib.cd_thr_live.argtypes = [c.c_int32]; lib.cd_thr_live.restype = c.c_int64
            lib.cd_thr_live_untagged.restype = c.c_int64
            lib.cd_thr_tracked_total.restype = c.c_int64
            lib.cd_thr_adopted_total.restype = c.c_int64
            lib.cd_thr_track_ok.restype = c.c_int
            lib.cd_thr_live_topn.argtypes = [c.POINTER(c.c_int32), c.POINTER(c.c_int64), c.c_int32]
            lib.cd_thr_live_topn.restype = c.c_int
            _THR_OWN_OK = True
    except Exception:
        _THR_OWN_OK = False
    try:
        if hasattr(lib, "cd_wref_install") and hasattr(lib, "cd_wref_live_topn"):
            lib.cd_wref_install.restype = c.c_int
            lib.cd_wref_running.restype = c.c_int
            lib.cd_wref_total.restype = c.c_int64
            lib.cd_wref_del_total.restype = c.c_int64
            lib.cd_wref_del_untracked.restype = c.c_int64
            lib.cd_wref_overflow.restype = c.c_int64
            lib.cd_wref_live_untagged.restype = c.c_int64
            lib.cd_wref_live_total.restype = c.c_int64
            lib.cd_wref_live.argtypes = [c.c_int32]; lib.cd_wref_live.restype = c.c_int64
            lib.cd_wref_live_topn.argtypes = [c.POINTER(c.c_int32), c.POINTER(c.c_int64), c.c_int32]
            lib.cd_wref_live_topn.restype = c.c_int
            _WREF_OK = True
    except Exception:
        _WREF_OK = False
    try:
        if hasattr(lib, "cd_leak_feed_dim"):
            lib.cd_leak_feed_dim.argtypes = [c.c_int32, c.c_int64]; lib.cd_leak_feed_dim.restype = c.c_int
            _LEAK_FEED_DIM_OK = True
    except Exception:
        _LEAK_FEED_DIM_OK = False

def _b41_wref_install():
    if not (_B41_ON and _WREF_OK and _NLIB is not None):
        return
    try:
        rc = int(_NLIB.cd_wref_install())
        _log("Block#41 +SZ(1): JNI weak-global attribution %s (rc=%d)" % ("ON" if rc > 0 else "OFF", rc))
    except Exception as e:
        _log("Block#41 +SZ(1): cd_wref_install err: %s" % e)

def _b41_thr_adopt(pid):
    if not (_THR_OWN_OK and _NLIB is not None) or not pid:
        return
    try:
        idx = int(_intern(pid))
        if idx >= 0:
            _NLIB.cd_thr_adopt(ctypes.c_int32(idx))
    except Exception:
        pass

def _b41_name(idx):
    nm = None
    try: nm = _resolve_idx(idx)
    except Exception: nm = None
    if not nm:
        try: nm = _resolve_idx_durable(idx)
        except Exception: nm = None
    if (not nm) or nm in (_SELF_ID, __id__, "__regtest__", "culprit_detector"):
        return None
    return nm

def _b41_topn(fn):
    out = {}
    try:
        try: n = max(48, len(_IDX_PID) + 8)
        except Exception: n = 64
        if n > 4096: n = 4096
        ia = (ctypes.c_int32 * n)(); ca = (ctypes.c_int64 * n)()
        got = int(fn(ia, ca, ctypes.c_int32(n)))
        for i in range(max(0, min(got, n))):
            idx = int(ia[i]); cnt = int(ca[i])
            if idx < 0 or cnt <= 0:
                continue
            nm = _b41_name(idx)
            if nm:
                out[nm] = out.get(nm, 0) + cnt
    except Exception:
        pass
    return out

def _b41_feed():
    if not (_B41_ON and _LEAK_FEED_DIM_OK and _NLIB is not None):
        return
    now = int(time.time() * 1000)
    if now - _B41_FEED_LAST[0] < 25000:
        return
    _B41_FEED_LAST[0] = now
    try:
        b = int(_sys.getallocatedblocks())
        if b > 0:
            _NLIB.cd_leak_feed_dim(ctypes.c_int32(7), ctypes.c_int64(b))
    except Exception:
        pass
    if _B41_DEBUG_CLS[0] is not False:
        try:
            if _B41_DEBUG_CLS[0] is None:
                _B41_DEBUG_CLS[0] = jclass("android.os.Debug")
            v = int(_B41_DEBUG_CLS[0].getBinderProxyObjectCount())
            if v >= 0:
                _NLIB.cd_leak_feed_dim(ctypes.c_int32(6), ctypes.c_int64(v))
        except Exception:
            _B41_DEBUG_CLS[0] = False

def _b41_own_sample():
    if not (_B41_ON and _NLIB is not None):
        return
    now = int(time.time() * 1000)
    if now - _B41_OWN_LAST[0] < _B41_OWN_PERIOD_MS:
        return
    _B41_OWN_LAST[0] = now
    if _THR_OWN_OK:
        try:
            _B41_THR_HIST.append((now, _b41_topn(_NLIB.cd_thr_live_topn)))
            if len(_B41_THR_HIST) > _B41_OWN_KEEP:
                del _B41_THR_HIST[:len(_B41_THR_HIST) - _B41_OWN_KEEP]
        except Exception:
            pass
    if _WREF_OK:
        try:
            if int(_NLIB.cd_wref_running()):
                m = _b41_topn(_NLIB.cd_wref_live_topn)
                _B41_WREF_HIST.append((now, m))
                if len(_B41_WREF_HIST) > _B41_OWN_KEEP:
                    del _B41_WREF_HIST[:len(_B41_WREF_HIST) - _B41_OWN_KEEP]
                _b41_wref_guard(now, m)
        except Exception:
            pass
    try: _b41_census(False)
    except Exception: pass

def _b41_owner_attr(dims, dim_key, hist, min_growth):
    d = None
    for x in dims:
        if x.get("dim") == dim_key and x.get("leaking"):
            d = x
            break
    if not d:
        return None
    span_ms = int(float(d.get("span_s") or 0.0) * 1000.0)
    growth = int(d.get("growth") or 0)
    if span_ms <= 0 or growth <= 0 or len(hist) < 2:
        return None
    now = int(time.time() * 1000)
    lo = now - span_ms - _B41_OWN_PERIOD_MS
    win = [e for e in list(hist) if e[0] >= lo]
    if len(win) < 2:
        return None
    t0, first = win[0]
    t1, last = win[-1]
    if (t1 - t0) < int(span_ms * _B41_COVER):
        return None
    best = None; best_g = 0
    for k, v in last.items():
        g = int(v) - int(first.get(k, 0))
        if g > best_g:
            best, best_g = k, g
    if (not best) or best_g < min_growth:
        return None
    share = float(best_g) / float(growth)
    if share < _B41_SHARE:
        return None
    return {"culprit": best, "growth": int(best_g), "dim_growth": int(growth),
            "share": round(min(share, 9.99), 3), "first": int(first.get(best, 0)),
            "last": int(last.get(best, 0)), "window_ms": int(t1 - t0)}

def _b41_append(name, rec, maxn=20):
    p = _data_path(name)
    if not p:
        return False
    _PERSIST_IO_LOCK.acquire()
    try:
        cur = []
        if os.path.exists(p):
            try:
                with open(p, "r", encoding="utf-8") as f:
                    cur = list(json.load(f))
            except Exception:
                cur = []
        cur.append(rec)
        _atomic_json_write(p, cur, maxn)
        return True
    except Exception:
        return False
    finally:
        try: _PERSIST_IO_LOCK.release()
        except Exception: pass

def _b41_wref_guard(now, m):
    try:
        total = int(_NLIB.cd_wref_live_total())
    except Exception:
        return
    if total < int(_B41_WREF_CAP * _B41_WREF_WARN_FRAC):
        return
    if now - _B41_WREF_LAST[0] < _B41_WREF_DEDUP_MS:
        return
    _B41_WREF_LAST[0] = now
    top = sorted(m.items(), key=lambda kv: -kv[1])[:5]
    best, bn = (top[0] if top else (None, 0))
    share = (float(bn) / float(total)) if total > 0 else 0.0
    if best and share >= 0.6: conf = "high"
    elif best and share >= 0.3: conf = "medium"
    else: conf = "low"
    try: untagged = int(_NLIB.cd_wref_live_untagged())
    except Exception: untagged = 0
    pair = _ta_gref_pair(total)
    pxc = None
    wsrc = "native-owner" if conf != "low" else None
    if conf == "low" and untagged >= int(total * 0.5):
        try: pxc = _ta_proxy_census()
        except Exception: pxc = None
        if pxc and pxc.get("culprit"):
            pb = int(pxc.get("count") or 0)
            if pb >= int(untagged * 0.5) and float(pxc.get("share") or 0.0) >= 0.6:
                best, bn = pxc["culprit"], pb
                share = (float(pb) / float(total)) if total > 0 else 0.0
                conf = "medium"
                wsrc = "py-proxy-census"
    rec = {"had_leak": True, "verdict": "JNI WEAK-REF TABLE PRESSURE",
           "culprit": (best if conf != "low" else "client (host process)"),
           "suspect": best, "confidence": conf, "kind": "jni-weakref-pressure",
           "live_weak": total, "cap": _B41_WREF_CAP, "pct": round(100.0 * total / _B41_WREF_CAP, 1),
           "owner_live": int(bn), "share": round(share, 4), "untagged_live": untagged, "top": top,
           "partial": True,
           "reason": "JNI weak-global refs (NewWeakGlobalRef без DeleteWeakGlobalRef) заполнили %.0f%% таблицы ART (лимит %d -> abort)" % (100.0 * total / _B41_WREF_CAP, _B41_WREF_CAP),
           "exc_cls": "WeakGlobalRefPressure", "exc_msg": "weak globals live=%d/%d" % (total, _B41_WREF_CAP),
           "ts": now, "event_type": "jni_weakref_pressure", "dropbox_tag": "app_memory_leak",
           "tombstone_norm_version": 1}
    rec["culprit_src"] = wsrc
    if pair:
        rec["gref_pair"] = pair
        if pair.get("hint"):
            rec["reason"] = rec["reason"] + "; " + pair["hint"]
    if pxc:
        rec["py_proxy_census"] = pxc
    if _b41_append(_B41_WREF_FILE, rec):
        _log("Block#41 +SZ(1): WEAK-REF PRESSURE live=%d/%d (%.0f%%) top=%s conf=%s suspect=%r src=%s" % (
            total, _B41_WREF_CAP, 100.0 * total / _B41_WREF_CAP, top[:3], conf, best, wsrc))
        if pair:
            _log("  +TA(2): global live=%d (untagged=%d) / weak live=%d -> ratio=%.2f paired=%s" % (
                pair["gref_live"], pair["gref_untagged"], total, pair["ratio"], pair["paired"]))
        if pxc:
            _log("  +TA(2): перепись прокси-объектов: лидер=%r count=%s share=%s types=%s (%sms)" % (
                pxc.get("culprit"), pxc.get("count"), pxc.get("share"), pxc.get("top_types"), pxc.get("ms")))

def _ta_gref_pair(wtotal):
    try:
        if not (hasattr(_NLIB, "cd_gref_live_total") and hasattr(_NLIB, "cd_gref_live_untagged")):
            return None
        _NLIB.cd_gref_live_total.restype = ctypes.c_int64
        _NLIB.cd_gref_live_untagged.restype = ctypes.c_int64
        gt = int(_NLIB.cd_gref_live_total())
        gu = int(_NLIB.cd_gref_live_untagged())
    except Exception:
        return None
    if gt <= 0 or wtotal <= 0:
        return None
    r = float(gt) / float(wtotal)
    out = {"gref_live": gt, "gref_untagged": gu, "ratio": round(r, 3), "paired": bool(r >= 0.7)}
    if r >= 0.7:
        out["hint"] = "каждый Python-объект dynamic_proxy/static_proxy (Chaquopy) держит 1 global + 1 weak ref: совместный рост обеих таблиц = накопление прокси-объектов, которые удерживает список/Java-коллекция"
    return out

def _ta_is_bridge_type(t):
    try:
        mm = getattr(type(t), "__module__", "") or ""
        if mm == "java" or mm.startswith("java.") or "chaquopy" in mm:
            return True
        for b in getattr(t, "__mro__", ())[1:]:
            bm = getattr(b, "__module__", "") or ""
            if bm == "java" or bm.startswith("java.") or "chaquopy" in bm:
                return True
    except Exception:
        pass
    return False

def _ta_proxy_census():
    t0 = time.time()
    try:
        cnt = collections.Counter(map(type, _gc.get_objects()))
    except Exception:
        return None
    per = {}; tops = {}
    for t, n in cnt.items():
        try: mn = t.__module__
        except Exception: continue
        if not isinstance(mn, str):
            continue
        pid = _B41_MOD_PID.get(mn, 0)
        if pid == 0:
            try: pid = _pid_of_module_pkg(mn)
            except Exception: pid = None
            if pid and len(_B41_MOD_PID) < 4096:
                _B41_MOD_PID[mn] = pid
        if (not pid) or pid in (_SELF_ID, __id__):
            continue
        if not _ta_is_bridge_type(t):
            continue
        per[pid] = per.get(pid, 0) + int(n)
        tops.setdefault(pid, []).append((int(n), getattr(t, "__qualname__", "?")))
    ms = int((time.time() - t0) * 1000)
    if not per:
        return {"culprit": None, "ms": ms}
    tot = sum(per.values())
    best = max(per.items(), key=lambda kv: kv[1])
    return {"culprit": best[0], "count": int(best[1]), "share": round(float(best[1]) / float(tot), 3),
            "top_types": sorted(tops.get(best[0], []), reverse=True)[:4], "plugins": len(per), "ms": ms}

def _b41_census(force):
    if not _B41_ON:
        return None
    now = int(time.time() * 1000)
    try: blocks = int(_sys.getallocatedblocks())
    except Exception: blocks = 0
    if not force:
        if _B41_CENSUS_LAST[0] == 0:
            _B41_CENSUS_LAST[0] = now - _B41_CENSUS_GAP_MS + 300000
            _B41_CENSUS_LAST[1] = blocks
            return None
        if now - _B41_CENSUS_LAST[0] < _B41_CENSUS_GAP_MS:
            return None
        if _B41_CENSUS_HIST and (blocks - _B41_CENSUS_LAST[1]) < _B41_CENSUS_TRIGGER:
            return None
    _B41_CENSUS_LAST[0] = now
    _B41_CENSUS_LAST[1] = blocks
    t0 = time.time()
    try:
        cnt = collections.Counter(map(type, _gc.get_objects()))
    except Exception:
        return None
    per = {}; tops = {}
    for t, n in cnt.items():
        try: mn = t.__module__
        except Exception: continue
        if not isinstance(mn, str):
            continue
        pid = _B41_MOD_PID.get(mn, 0)
        if pid == 0:
            try: pid = _pid_of_module_pkg(mn)
            except Exception: pid = None
            if pid and len(_B41_MOD_PID) < 4096:
                _B41_MOD_PID[mn] = pid
        if (not pid) or pid in (_SELF_ID, __id__):
            continue
        per[pid] = per.get(pid, 0) + int(n)
        tl = tops.setdefault(pid, [])
        tl.append((int(n), getattr(t, "__qualname__", "?")))
    for pid in tops:
        tops[pid] = sorted(tops[pid], reverse=True)[:4]
    ent = (now, per, tops, blocks, int((time.time() - t0) * 1000))
    _B41_CENSUS_HIST.append(ent)
    if len(_B41_CENSUS_HIST) > 12:
        del _B41_CENSUS_HIST[:len(_B41_CENSUS_HIST) - 12]
    return ent

def _b41_census_attr(dims):
    d = None
    for x in dims:
        if x.get("dim") == "pyblocks" and x.get("leaking"):
            d = x
            break
    if not d:
        return None
    base = None
    span_ms = int(float(d.get("span_s") or 0.0) * 1000.0)
    lo = int(time.time() * 1000) - span_ms - _B41_CENSUS_GAP_MS
    for e in _B41_CENSUS_HIST:
        if e[0] >= lo:
            base = e
            break
    cur = _b41_census(True)
    if cur is None or base is None or base is cur:
        return None
    growth = int(d.get("growth") or 0)
    best = None; bg = 0
    for pid, n in cur[1].items():
        g = int(n) - int(base[1].get(pid, 0))
        if g > bg:
            best, bg = pid, g
    if (not best) or bg < _B41_CENSUS_MIN or growth <= 0:
        return None
    share = float(bg) / float(growth)
    if share < _B41_CENSUS_SHARE:
        return None
    return {"culprit": best, "growth": int(bg), "dim_growth": growth, "share": round(min(share, 9.99), 3),
            "first": int(base[1].get(best, 0)), "last": int(cur[1].get(best, 0)),
            "window_ms": int(cur[0] - base[0]), "top_types": cur[2].get(best, []), "census_ms": cur[4]}

def _b41_pyheap_detail():
    out = {}
    try: out["allocated_blocks"] = int(_sys.getallocatedblocks())
    except Exception: pass
    try: out["gc_garbage"] = len(_gc.garbage)
    except Exception: pass
    try: out["gc_counts"] = list(_gc.get_count())
    except Exception: pass
    try:
        tids = set(os.listdir("/proc/self/task"))
        dummy = stale = 0
        for t in list(getattr(threading, "_active", {}).values()):
            if isinstance(t, getattr(threading, "_DummyThread", ())):
                dummy += 1
                nid = getattr(t, "native_id", None)
                if nid is not None and str(nid) not in tids:
                    stale += 1
        out["dummy_threads"] = dummy
        out["dummy_threads_stale"] = stale
    except Exception:
        pass
    return out

def _b41_enrich_leak(rec, dims):
    ld = rec.get("leaking_dims") or []
    out = {}
    if "threads" in ld and _THR_OWN_OK:
        a = _b41_owner_attr(dims, "threads", _B41_THR_HIST, _B41_THR_MIN)
        if a: out["threads"] = a
    if "jweak" in ld and _WREF_OK:
        a = _b41_owner_attr(dims, "jweak", _B41_WREF_HIST, _B41_WREF_MIN)
        if a: out["jweak"] = a
    if "pyblocks" in ld:
        try: rec["python_heap"] = _b41_pyheap_detail()
        except Exception: pass
        a = _b41_census_attr(dims)
        if a: out["pyblocks"] = a
    if "binder" in ld:
        try:
            Dbg = _B41_DEBUG_CLS[0] or jclass("android.os.Debug")
            rec["binder_counts"] = {"proxy": int(Dbg.getBinderProxyObjectCount()),
                                    "local": int(Dbg.getBinderLocalObjectCount()),
                                    "death": int(Dbg.getBinderDeathObjectCount())}
        except Exception:
            pass
    if out:
        rec["owner_attribution"] = out
    if rec.get("kind") != "host":
        if out:
            _log("Block#41 +SZ: owner side-info (kind=%s kept): %s" % (rec.get("kind"), out))
        if "binder" in ld and rec.get("reason_detail") == "host_unattributed":
            rec["reason_detail"] = "binder_proxy_leak"
        return
    kinds = (("threads", "plugin-thread", "live threads"), ("jweak", "plugin-weakref", "live JNI weak refs"),
             ("pyblocks", "plugin-python-objects", "Python objects"))
    for key, kind, what in kinds:
        a = out.get(key)
        if not a:
            continue
        rec["reason_detail_base"] = rec.get("reason_detail") or "host_unattributed"
        rec["culprit"] = a["culprit"]
        rec["kind"] = kind
        rec["reason_detail"] = "%s_owner: %s +%d %s (%d->%d) = %.0f%% of +%d in window" % (
            key, a["culprit"], a["growth"], what, a["first"], a["last"], 100.0 * min(a["share"], 1.0), a["dim_growth"])
        hi = (ld == [key]) and a["share"] >= 0.8 and key != "pyblocks"
        rec["confidence"] = "high" if hi else "medium"
        _log("Block#41 +SZ: %s leak attributed -> %s (%s, conf=%s)" % (key, a["culprit"], rec["reason_detail"], rec["confidence"]))
        return
    for key, label in (("jweak", "jweak_leak"), ("binder", "binder_proxy_leak"), ("pyblocks", "python_heap_leak")):
        if key in ld and rec.get("reason_detail") == "host_unattributed":
            for d in dims:
                if d.get("dim") == key:
                    rec["reason_detail"] = "%s: %d->%d (+%d)" % (label, int(d.get("first") or 0), int(d.get("last") or 0), int(d.get("growth") or 0))
                    break
            break

def _b41_mod_owned(v, g):
    try:
        for a in list(vars(v).values()):
            f = getattr(a, "__func__", a)
            if getattr(f, "__globals__", None) is g:
                return True
    except Exception:
        pass
    return False

def _b41_plugin_objects(pid, with_funcs=False):
    mods = []; clss = []; fns = []
    _ft = type(_b41_mod_owned)
    for nm, mod in list(_sys.modules.items()):
        if mod is None:
            continue
        try:
            if _pid_of_module_pkg(nm) != pid:
                continue
        except Exception:
            continue
        mods.append((nm, mod))
        try:
            g = vars(mod)
            mn = (nm, g.get("__name__"))
            for k, v in list(g.items()):
                if isinstance(v, type):
                    if getattr(v, "__module__", None) in mn or _b41_mod_owned(v, g):
                        clss.append((nm + "." + str(getattr(v, "__qualname__", k)), v))
                elif with_funcs and isinstance(v, _ft) and getattr(v, "__globals__", None) is g:
                    fns.append((nm + "." + str(getattr(v, "__qualname__", k)), v))
        except Exception:
            pass
    if with_funcs:
        return mods, clss, fns
    return mods, clss

def _b41_pend():
    return _xrl_shared("b41_retain_pending", dict, lambda o: isinstance(o, dict))

_TJ_UNLOAD_WIN_MS = 900000
def _tg_recent_unload(pid):
    try:
        now = int(time.time() * 1000)
        for rec in list(_b41_pend().values()):
            if isinstance(rec, dict) and rec.get("pid") == pid and now - int(rec.get("unload_ts") or 0) < _TJ_UNLOAD_WIN_MS:
                return True
    except Exception:
        pass
    return False

def _b41_retain_track(pid, why="load"):
    if not (_B41_ON and pid) or pid in (_SELF_ID, __id__):
        return
    try:
        mods, clss, fns = _b41_plugin_objects(pid, True)
        wm = []; wc = []; wf = []
        for nm, m in mods:
            try: wm.append((nm, weakref.ref(m)))
            except TypeError: pass
        for q, c in clss[:64]:
            try: wc.append((q, weakref.ref(c)))
            except TypeError: pass
        for q, f in fns[:_B41_FUNC_MAX]:
            try: wf.append((q, weakref.ref(f)))
            except TypeError: pass
        if wm or wc or wf:
            with _B41_RETAIN_LOCK:
                _B41_RETAIN[pid] = {"mods": wm, "cls": wc, "fn": wf, "t": int(time.time() * 1000)}
            _log("Block#41 +TA(3): удержание: отслеживаю %s [%s] (модулей=%d классов=%d функций=%d)" % (pid, why, len(wm), len(wc), len(wf)))
        elif why != "load" and not _tg_recent_unload(pid):
            _log("Block#41 +TA(3): удержание: %s [%s] -- модули плагина не найдены в sys.modules, отслеживание пропущено" % (pid, why))
    except Exception:
        pass

def _b41_retain_unloaded(pid):
    if not (_B41_ON and pid):
        return
    with _B41_RETAIN_LOCK:
        rec = _B41_RETAIN.pop(pid, None)
    if not rec:
        if not _tg_recent_unload(pid):
            _log("Block#41 +TA(3): %s выгружен, но не отслеживался -- проверка удержания пропущена" % pid)
        return
    rec["unload_ts"] = int(time.time() * 1000)
    rec["pid"] = pid
    rec["pkey"] = "%s@%d" % (pid, rec["unload_ts"])
    rec["gen"] = _B41_GEN
    rec["attempt"] = 0
    try:
        _b41_pend()[rec["pkey"]] = rec
    except Exception:
        pass
    try:
        t = threading.Timer(_B41_RETAIN_DELAYS[0], _b41_retain_check, args=(pid, rec, 0))
        t.daemon = True
        t.start()
        _log("Block#41 +TA(3): %s выгружен -> проверка удержания через %.0fс (модулей=%d классов=%d функций=%d)" % (
            pid, _B41_RETAIN_DELAYS[0], len(rec.get("mods") or []), len(rec.get("cls") or []), len(rec.get("fn") or [])))
    except Exception as _ete:
        _log("Block#41 +TA(3): таймер проверки удержания не запущен: %s" % _ete)

def _b41_retain_orphan():
    n = 0
    try:
        for k, rec in list(_b41_pend().items()):
            if isinstance(rec, dict) and rec.get("gen") == _B41_GEN:
                rec["gen"] = "orphan"
                n += 1
        if n:
            _log("Block#41 +TD(3): %d незавершённых проверок удержания оставлено следующему инстансу детектора" % n)
    except Exception:
        pass
    return n

def _b41_retain_adopt():
    if not _B41_ON:
        return 0
    n = 0
    try:
        pend = _b41_pend()
        now = int(time.time() * 1000)
        for k, rec in list(pend.items()):
            try:
                if not isinstance(rec, dict) or rec.get("gen") == _B41_GEN:
                    continue
                pid = rec.get("pid"); ut = int(rec.get("unload_ts") or 0)
                a = int(rec.get("attempt") or 0)
                while a + 1 < len(_B41_RETAIN_DELAYS) and (now - ut) / 1000.0 >= _B41_RETAIN_DELAYS[a + 1]:
                    a += 1
                if not pid or not ut or now - ut > 3600000 or a >= len(_B41_RETAIN_DELAYS):
                    pend.pop(k, None)
                    continue
                rec["gen"] = _B41_GEN
                delay = max(5.0, _B41_RETAIN_DELAYS[a] - (now - ut) / 1000.0)
                t = threading.Timer(delay, _b41_retain_check, args=(pid, rec, a))
                t.daemon = True
                t.start()
                n += 1
                _log("Block#41 +TB(4): проверка удержания %s подхвачена после reload детектора (выгружен %.0fс назад, попытка %d, через %.0fс)" % (pid, (now - ut) / 1000.0, a, delay))
            except Exception:
                pass
    except Exception as e:
        _log("Block#41 +TB(4) adopt err: %s" % e)
    return n

def _b41_stale(pid, rec):
    cur_mods, cur_cls, cur_fns = _b41_plugin_objects(pid, True)
    cur_ids = set(id(m) for _n, m in cur_mods) | set(id(c) for _q, c in cur_cls) | set(id(f) for _q, f in cur_fns)
    try:
        all_mods = set(id(m) for m in list(_sys.modules.values()) if m is not None)
    except Exception:
        all_mods = set()
    out = []
    for nm, wr in rec.get("mods") or []:
        o = wr()
        if o is not None and id(o) not in cur_ids and id(o) not in all_mods:
            out.append(("module", nm, o))
    for q, wr in rec.get("cls") or []:
        o = wr()
        if o is not None and id(o) not in cur_ids:
            out.append(("class", q, o))
    for q, wr in rec.get("fn") or []:
        o = wr()
        if o is not None and id(o) not in cur_ids:
            out.append(("function", q, o))
    return out

def _te_fn_holds(r, fn, fids):
    try:
        sf = getattr(r, "__self__", None)
        if sf is not None and id(sf) in fids:
            return True
        for t in (getattr(fn, "__closure__", None), getattr(fn, "__defaults__", None), getattr(fn, "__kwdefaults__", None)):
            if t is not None and id(t) in fids:
                return True
        for c in (getattr(fn, "__closure__", None) or ()):
            if id(c) in fids:
                return True
        for x in (getattr(fn, "__defaults__", None) or ()):
            if id(x) in fids:
                return True
        for x in list((getattr(fn, "__kwdefaults__", None) or {}).values()):
            if id(x) in fids:
                return True
        d = getattr(fn, "__dict__", None)
        if d is not None and id(d) in fids:
            return True
        g = getattr(fn, "__globals__", None)
        return not (g is not None and id(g) in fids)
    except Exception:
        return True

_TH_EXT_MAX = 32
def _th_ext_roots(cand):
    out = []
    if not cand:
        return out
    try:
        ctl = object()
        objs = [c[2] for c in cand]
        objs.append(ctl)
        ctl = None
        idm = {}
        for k in range(len(objs)):
            idm.setdefault(id(objs[k]), k)
        cnt = [0] * len(objs)
        me = _sys._getframe()
        rs = _gc.get_referrers(*objs)
        for r in rs:
            if r is me or r is idm:
                continue
            for x in _gc.get_referents(r):
                k = idm.get(id(x))
                if k is not None:
                    cnt[k] += 1
            x = None
        rs = None
        r = None
        me = None
        last = len(objs) - 1
        base = _sys.getrefcount(objs[last]) - cnt[last]
        for k in range(last):
            ext = (_sys.getrefcount(objs[k]) - cnt[k]) - base
            if ext > 0:
                out.append("L%d %s held outside Python GC (+%d ref: Java/JNI, C-ext or live thread local)" % (cand[k][0], cand[k][1], ext))
                if len(out) >= 4:
                    break
    except Exception:
        pass
    return out

def _b41_holders(targets):
    import types as _types
    t0 = time.time()
    me = _sys._getframe()
    dg = globals()
    mine = {id(me), id(targets)}
    seen = set(id(t) for t in targets)
    frontier = list(targets)
    own = set()
    for _t in targets:
        try: own.add(getattr(_t, "__module__", None))
        except Exception: pass
    own.discard(None)
    own_g = set()
    for _t in targets:
        try:
            _g = getattr(_t, "__globals__", None)
            if isinstance(_g, dict):
                own_g.add(id(_g))
            elif isinstance(_t, type):
                for _a in list(vars(_t).values()):
                    _g = getattr(getattr(_a, "__func__", _a), "__globals__", None)
                    if isinstance(_g, dict):
                        own_g.add(id(_g))
            elif isinstance(_t, _types.ModuleType):
                own_g.add(id(vars(_t)))
        except Exception:
            pass
    cand = []
    cand_t = []
    for _t in targets:
        if isinstance(_t, (_types.FunctionType, _types.ModuleType)):
            cand_t.append((0, ("module %s" if isinstance(_t, _types.ModuleType) else "function %s") % getattr(_t, "__qualname__", getattr(_t, "__name__", "?")), _t))
    roots = []
    other = {}
    for lvl in range(_B41_HOLDER_LEVELS):
        if not frontier or (time.time() - t0) > _B41_HOLDER_BUDGET_S:
            break
        try:
            refs = _gc.get_referrers(*frontier)
        except Exception:
            break
        mine.add(id(refs)); mine.add(id(frontier))
        fids = set(id(x) for x in frontier)
        nxt = []
        for r in refs:
            if id(r) in seen or id(r) in mine:
                continue
            seen.add(id(r))
            try:
                if r is dg:
                    ks = [k for k, v in list(dg.items()) if id(v) in fids and not isinstance(v, (_types.FunctionType, _types.BuiltinFunctionType, _types.MethodType, type, _types.ModuleType))][:3]
                    if ks:
                        roots.append("detector global %s" % ",".join(ks))
                    continue
                if isinstance(r, _types.FrameType):
                    roots.append("frame path %s (%s:%d)" % (r.f_code.co_name, r.f_code.co_filename.rsplit("/", 1)[-1], r.f_lineno))
                    continue
                if isinstance(r, _types.ModuleType):
                    hp = None
                    try: hp = _pid_of_module_pkg(r.__name__)
                    except Exception: hp = None
                    if r.__name__ == __name__ or hp in (_SELF_ID, __id__):
                        continue
                    roots.append("module %s global" % (hp or r.__name__))
                    if hp: other[hp] = other.get(hp, 0) + 1
                    continue
                if isinstance(r, (_types.FunctionType, _types.MethodType)):
                    fn = getattr(r, "__func__", r)
                    fm = getattr(fn, "__module__", None)
                    _sf = getattr(r, "__self__", None)
                    if (_sf is not None and getattr(type(_sf), "__module__", None) in own) or getattr(fn, _B10_FLAG, False) or getattr(fn, _B_TAGGED_FLAG, False):
                        if len(cand) < _TH_EXT_MAX:
                            cand.append((lvl, ("detector wrapper %s" if (getattr(fn, _B10_FLAG, False) or getattr(fn, _B_TAGGED_FLAG, False)) else "method %s") % getattr(fn, "__qualname__", "?"), r))
                        nxt.append(r)
                        continue
                    if not _te_fn_holds(r, fn, fids):
                        if id(getattr(fn, "__globals__", None)) in own_g:
                            nxt.append(r)
                        continue
                    if fm == __name__:
                        roots.append("detector function path %s (not an exclusive root)" % getattr(fn, "__qualname__", "?"))
                        nxt.append(r)
                        continue
                    if fm not in own:
                        roots.append("L%d function %s (%s)" % (lvl, getattr(fn, "__qualname__", "?"), fm))
                    nxt.append(r)
                    continue
                if isinstance(r, threading.Thread):
                    try:
                        target = getattr(r, "_target", None)
                        target_name = getattr(target, "__qualname__", type(target).__name__) if target is not None else "unknown/custom-run"
                        roots.append("live thread name=%s ident=%s alive=%s target=%s" % (r.name, r.ident, r.is_alive(), target_name))
                        target = None
                    except Exception: pass
                tn = type(r).__module__ + "." + type(r).__qualname__
                if not isinstance(r, (dict, list, tuple, set, frozenset, _types.CellType)):
                    if "proxy" in tn.lower() or tn.startswith("java") or _ta_is_bridge_type(type(r)):
                        roots.append("L%d java-bridge object %s (held from Java: hook/listener/proxy not removed?)" % (lvl, tn))
                    elif lvl <= 2 and getattr(type(r), "__module__", None) not in own:
                        roots.append("L%d %s instance" % (lvl, tn))
                    elif getattr(type(r), "__module__", None) in own and len(cand) < _TH_EXT_MAX:
                        cand.append((lvl, "%s instance" % tn, r))
                nxt.append(r)
            except Exception:
                pass
            if len(nxt) >= _B41_HOLDER_FRONTIER:
                break
        frontier = nxt
    del frontier, me
    r = refs = nxt = _sf = _t = _a = _g = fn = None
    cand.extend(cand_t[:max(0, _TH_EXT_MAX - len(cand))])
    del cand_t
    roots.extend(_th_ext_roots(cand))
    del cand
    uniq = []
    for x in roots:
        if x not in uniq:
            uniq.append(x)
    return uniq[:10], other, int((time.time() - t0) * 1000)

def _b41_retain_check(pid, rec, attempt):
    try:
        if rec.get("gen") not in (None, _B41_GEN):
            return
    except Exception:
        pass
    rec["attempt"] = attempt
    try:
        _b41_retain_check_body(pid, rec, attempt)
    finally:
        if int(rec.get("attempt") or 0) <= attempt:
            try: _b41_pend().pop(rec.get("pkey"), None)
            except Exception: pass

def _ti_java_gc():
    try:
        rt = jclass("java.lang.Runtime").getRuntime()
        sy = jclass("java.lang.System")
        for _i in range(3):
            rt.gc()
            sy.runFinalization()
            time.sleep(0.4)
            _gc.collect()
        return True
    except Exception:
        return False

def _b41_retention_evidence(holders):
    """Paths from a bounded scan are not exclusive GC roots."""
    holders = [str(h) for h in (holders or ())]
    detector = [h for h in holders if h.startswith("detector ")]
    direct = [h for h in detector if h.startswith("detector global ")]
    threads = [h for h in holders if h.startswith("live thread ")]
    live = [h for h in threads if "alive=true" in h.lower()]
    frames = [h for h in holders if h.startswith(("frame path ", "live frame "))]
    external = [h for h in holders if "java-bridge" in h or "outside Python GC" in h]
    return {"detector_paths": detector, "direct_detector_references": direct,
            "thread_paths": threads, "live_execution_paths": live, "frame_paths": frames,
            "external_reference_hints": external,
            "exclusive_root_proven": False, "scan_complete": False}


def _b20_storage_evidence(rec):
    """Direct Python UI caller + sustained sampled MessagesStorage.getMessage."""
    if not rec.get("py_file") or not rec.get("stack"):
        return None
    src = str(rec.get("src") or "")
    if src != "anr/ui-thread" and not src.startswith("anr/ui-thread+"):
        return None
    hf = rec.get("hot_frames") or {}
    method = str(hf.get("top_app_frame") or "").split("(", 1)[0]
    if method != "org.telegram.messenger.MessagesStorage.getMessage": return None
    try:
        if int(hf.get("samples") or 0) < 8 or float(hf.get("top_app_pct") or 0) < 75.0: return None
    except Exception: return None
    return {"initiator": rec.get("py_module") or rec.get("culprit"),
            "blocked_resource": "MessagesStorage.getMessage",
            "attribution_kind": "direct-ui-caller", "resource_owner": None,
            "blocker_status": "not_identified", "samples": hf.get("samples"),
            "top_app_pct": hf.get("top_app_pct"), "wait_frame": hf.get("top_frame")}


def _b41_retain_check_body(pid, rec, attempt):
    try:
        _gc.collect()
        st = _b41_stale(pid, rec)
        _jg = ""
        if st:
            st = None
            if _ti_java_gc():
                st = _b41_stale(pid, rec)
                if not st:
                    _jg = " (после принудительного Java GC: держали Java-обёртки PyObject)"
            else:
                st = _b41_stale(pid, rec)
        if not st:
            _insys = 0
            for _nm, _wr in rec.get("mods") or []:
                _o = _wr()
                if _o is not None and _sys.modules.get(_nm) is _o:
                    _insys += 1
            if _insys:
                _log("Block#41 +TA(3): %s: модуль остаётся в sys.modules через %.0fс после выгрузки (движок не удалил модуль) -- удержание не оценивается" % (pid, _B41_RETAIN_DELAYS[attempt]))
            else:
                _log("Block#41 +TA(3): %s освобождён через %.0fс после выгрузки%s (ok)" % (pid, _B41_RETAIN_DELAYS[attempt], _jg))
            return
        if attempt + 1 < len(_B41_RETAIN_DELAYS):
            _log("Block#41 +SZ(4): %s still alive %.0fs after unload (%d objects: %s) -> re-check in %.0fs" % (
                pid, _B41_RETAIN_DELAYS[attempt], len(st), ", ".join("%s %s" % (k, n) for k, n, _o in st[:4]), _B41_RETAIN_DELAYS[attempt + 1] - _B41_RETAIN_DELAYS[attempt]))
            rec["attempt"] = attempt + 1
            t = threading.Timer(_B41_RETAIN_DELAYS[attempt + 1] - _B41_RETAIN_DELAYS[attempt], _b41_retain_check, args=(pid, rec, attempt + 1))
            t.daemon = True
            t.start()
            return
        targets = [o for _k, _n, o in st]
        names = ["%s %s" % (k, n) for k, n, _o in st][:8]
        del st
        holders, other, hms = _b41_holders(targets)
        del targets
        conf = "medium" if holders else "low"
        held_by = None
        if other:
            held_by = sorted(other.items(), key=lambda kv: -kv[1])[0][0]
            if held_by == pid:
                held_by = None
        now = int(time.time() * 1000)
        r = {"had_leak": True, "verdict": "PLUGIN RETAINED AFTER UNLOAD",
             "culprit": pid, "confidence": conf, "kind": "plugin-retained",
             "retained": names, "holders": holders, "held_by_plugin": held_by,
             "age_ms": now - int(rec.get("unload_ts") or now), "holder_scan_ms": hms,
             "reason": "после выгрузки плагина его модуль/классы остаются в памяти: зарегистрированные хуки, слушатели, потоки, таймеры или Java-прокси не сняты в on_plugin_unload",
             "exc_cls": "PluginRetained", "exc_msg": ", ".join(names[:3]),
             "ts": now, "event_type": "plugin_retained", "dropbox_tag": "app_memory_leak",
             "tombstone_norm_version": 1}
        evidence = _b41_retention_evidence(holders)
        r.update({"retained_plugin": pid, "retention_evidence": evidence,
                  "attribution": False, "culprit": "undetermined",
                  "kind": "plugin-retained-unresolved", "confidence": "low",
                  "reason": "объекты выгруженного плагина остаются живыми; пути через потоки, обёртки и Java/JNI не доказывают единственного виновника"})
        if evidence["direct_detector_references"]:
            r.update({"verdict": "DETECTOR REFERENCE TO RETAINED PLUGIN", "culprit": _SELF_ID,
                      "kind": "detector-reference", "confidence": "medium",
                      "detector_holders": evidence["detector_paths"],
                      "reason": "обнаружена ссылка из глобального состояния детектора; другие держатели не исключены, единственная причина удержания не установлена"})
        elif evidence["detector_paths"]:
            r.update({"verdict": "RETAINED PLUGIN — MIXED/UNRESOLVED HOLDERS",
                      "detector_holders": evidence["detector_paths"]})
        if _b41_append(_B41_RETAIN_FILE, r):
            _log("================ PLUGIN-RETAINED VERDICT (Block#41) ================")
            _log("RETAINED: %r holder=%r conf=%s exclusive_root=false retained=%s" % (pid, r["culprit"], r["confidence"], names[:4]))
            for h in holders[:6]:
                _log("  holder: %s" % h)
            _log("====================================================================")
    except Exception as e:
        try: _log("Block#41 +SZ(4) check err: %s" % e)
        except Exception: pass


