def _b25_try_native_handler():
    global _HANDLER_NATIVE_ACTIVE
    if _HANDLER_NATIVE_ACTIVE:
        return True
    if not (_HANDLER_NATIVE_ON and _HANDLER_NATIVE_OK and _NLIB is not None and _CTYPES_OK):
        return False
    try:
        if int(_NLIB.cd_handler_running()) == 1:
            _HANDLER_NATIVE_ACTIVE = True
            return True
        st = int(_NLIB.cd_handler_selftest(0))
        if st <= 0:
            _log("Block#25N: native handler selftest=%d -> неактивно" % st)
            return False
        n = int(_NLIB.cd_handler_install(0))
        if n > 0:
            _HANDLER_NATIVE_ACTIVE = True
            _log("Block#25N: нативный Handler.dispatchMessage interceptor=%d (GIL-free, без Python-bounce)" % n)
            _b25_try_native_post()
            return True
        _log("Block#25N: native handler install=%d -> неактивно" % n)
        return False
    except Exception as e:
        _log("Block#25N: native handler err: %s -> неактивно" % e)
        return False

def _b25_try_native_post():
    global _POST_NATIVE_ACTIVE
    if _POST_NATIVE_ACTIVE:
        return True
    if not (_POST_NATIVE_ON and _POST_NATIVE_OK and _NLIB is not None and _CTYPES_OK):
        return False
    try:
        if int(_NLIB.cd_post_running()) == 1:
            _POST_NATIVE_ACTIVE = True
            return True
        st = int(_NLIB.cd_post_selftest(0))
        if st <= 0:
            _log("Block#25P: native post selftest=%d -> неактивно (эвристика владельца)" % st)
            return False
        n = int(_NLIB.cd_post_install(0))
        if n > 0:
            _POST_NATIVE_ACTIVE = True
            _log("Block#25P +JD: нативный Handler.enqueueMessage owner-capture=%d (детерминированная привязка осиротевших Runnable)" % n)
            return True
        _log("Block#25P: native post install=%d -> неактивно" % n)
        return False
    except Exception as e:
        _log("Block#25P: native post err: %s -> неактивно" % e)
        return False

def _b25_notif_diag_str():
    try:
        if _NLIB is None or not hasattr(_NLIB, "cd_notif_diag"): return ""
        d = [int(_NLIB.cd_notif_diag(i)) for i in range(5)]
        return " [sh_ierr=%d sh_uerr=%d unhook_fail=%d leftover=%d adopted=%d]" % tuple(d)
    except Exception:
        return ""

def _b25_try_native_notif():
    global _NOTIF_NATIVE_ACTIVE
    if _NOTIF_NATIVE_ACTIVE:
        return True
    if not (_NOTIF_NATIVE_ON and _NOTIF_NATIVE_OK and _NLIB is not None and _CTYPES_OK):
        return False
    try:
        if int(_NLIB.cd_notif_running()) == 1:
            _NOTIF_NATIVE_ACTIVE = True
            return True
        st = int(_NLIB.cd_notif_selftest(0))
        if st <= 0:
            _log("Block#25NC: native notif selftest=%d -> inactive" % st)
            return False
        n = int(_NLIB.cd_notif_install(0))
        if n > 0:
            _NOTIF_NATIVE_ACTIVE = True
            _log("Block#25NC +HT: native postNotificationNameInternal interceptor=%d (GIL-free, no Python bounce)%s" % (n, _b25_notif_diag_str()))
            return True
        _log("Block#25NC: native notif install=%d -> inactive%s" % (n, _b25_notif_diag_str()))
        try:
            _ierr = int(_NLIB.cd_notif_diag(0)) if hasattr(_NLIB, "cd_notif_diag") else 0
        except Exception:
            _ierr = 0
        if _ierr == 40:
            _b25_notif_retry_arm()
        return False
    except Exception as e:
        _log("Block#25NC: native notif err: %s -> inactive" % e)
        return False


_NOTIF_RETRY_THREAD = None
_NOTIF_RETRY_ON = True
_NOTIF_RETRY_DELAYS = (3.0, 8.0, 20.0, 45.0)

def _b25_notif_ui_post(fn):
    try:
        from client_utils import run_on_ui_thread
        run_on_ui_thread(fn); return True
    except Exception:
        pass
    try:
        import android_utils
        android_utils.run_on_ui_thread(fn, 0); return True
    except Exception:
        pass
    return False

def _b25_notif_retry_once():
    res = {"ok": False, "err": None}
    done = threading.Event()
    def _attempt():
        try:
            res["ok"] = bool(_b25_try_native_notif())
        except Exception as e:
            res["err"] = e
        finally:
            done.set()
    if not _b25_notif_ui_post(_attempt):
        return None
    if not done.wait(10.0):
        return None
    if res["err"] is not None:
        raise res["err"]
    return res["ok"]

def _b25_notif_retry_loop():
    for _d in _NOTIF_RETRY_DELAYS:
        try: time.sleep(_d)
        except Exception: return
        if not _NOTIF_RETRY_ON or _NOTIF_NATIVE_ACTIVE: return
        try:
            ok = _b25_notif_retry_once()
            if ok:
                _log("Block#25NC +SP: отложенная установка удалась (island освободился)%s" % _b25_notif_diag_str())
                return
        except Exception as e:
            try: _log("Block#25NC +SP retry err: %s" % e)
            except Exception: pass
            return

def _b25_notif_retry_arm():
    global _NOTIF_RETRY_THREAD
    if not _NOTIF_RETRY_ON or _NOTIF_NATIVE_ACTIVE:
        return
    try:
        t = _NOTIF_RETRY_THREAD
        if t is not None and t.is_alive():
            return
        _NOTIF_RETRY_THREAD = threading.Thread(target=_b25_notif_retry_loop, name="cd-b25nc-retry", daemon=True)
        _NOTIF_RETRY_THREAD.start()
    except Exception as e:
        try: _log("Block#25NC +SP retry arm err: %s" % e)
        except Exception: pass

def _b25_native_notif_uninstall():
    global _NOTIF_NATIVE_ACTIVE, _NOTIF_RETRY_ON
    _NOTIF_RETRY_ON = False
    if not _NOTIF_NATIVE_ACTIVE:
        return False
    try:
        if _NLIB is not None and _NOTIF_NATIVE_OK:
            _NLIB.cd_notif_unhook()
    except Exception as e:
        _log("Block#25NC: native notif unhook err: %s" % e)
    _NOTIF_NATIVE_ACTIVE = False
    _log("Block#25NC +HT: native postNotificationNameInternal interceptor removed%s" % _b25_notif_diag_str())
    return True


def _b25_native_handler_uninstall():
    global _HANDLER_NATIVE_ACTIVE
    if not _HANDLER_NATIVE_ACTIVE:
        return False
    try:
        if _NLIB is not None and _HANDLER_NATIVE_OK:
            _NLIB.cd_handler_unhook()
    except Exception as e:
        _log("Block#25N: native handler unhook err: %s" % e)
    global _POST_NATIVE_ACTIVE
    try:
        if _POST_NATIVE_ACTIVE and _NLIB is not None and _POST_NATIVE_OK:
            _NLIB.cd_post_unhook()
    except Exception as e:
        _log("Block#25P: native post unhook err: %s" % e)
    _POST_NATIVE_ACTIVE = False
    _HANDLER_NATIVE_ACTIVE = False
    _log("Block#25N: нативный Handler interceptor снят")
    return True


def _b25_install(plugin):
    plugin._b25_unhooks = getattr(plugin, "_b25_unhooks", [])
    if not _BLOCK25_ON:
        _log("Block#25: отключён (_BLOCK25_ON=False)"); return
    hooked = 0
    if _b25_try_native_notif():
        hooked = 1
    try:
        cls = _java_lang_class(_B25_HOST_DISPATCH)
        if cls is None:
            _log("Block#25: NotificationCenter class не найден -- пропуск"); return
    except Exception as e:
        _log("Block#25: NotificationCenter hook err: %s: %s" % (type(e).__name__, e)); return
    handler_hooked = 0
    if _B25_HANDLER_ON:
        if _b25_try_native_handler():
            _log("Block#25: Handler.dispatchMessage -> нативный interceptor (GIL-free)")
        else:
            _log("Block#25: «Глубокий хук UI» требует пересобранный .so (cd_handler_*); Python-фолбек удалён -> неактивно")
    _log("Block#25: установлен (host-dispatch attribution: postNotificationNameInternal=%d handler=%d) -> %s"
         % (hooked, handler_hooked, _DISP_FILE_NAME))


_FUT_FILE_NAME = "future_verdict.json"
_FUT_FAILS_MAX = 20
_FUT_DEDUP_MS = 4000
_FUT_SEEN = {}; _FUT_SEEN_LOCK = threading.Lock()
_B17_FLAG = "_culprit_b17"
_B17_WRAP_LOCK = threading.Lock()
_B17_PATCHED = []
_BLOCK17_ON = True

def _fut_verdict_path():
    return _data_path(_FUT_FILE_NAME)

def _fut_verdict_log(rec, when):
    _verdict_log(rec, when, 'FUTURE', 'FUTURE', 'scope-plugin(tid)', "===============================================", '', ('причина', 'modul', 'iskljuchenie'))

def _persist_fut_fail(rec):
