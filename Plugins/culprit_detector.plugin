        _log("============= ASYNCIO VERDICT (%s) =============" % when)
        cul = rec.get("culprit"); conf = rec.get("confidence")
        if cul and cul != "unknown":
            _log("ВИНОВНИК ASYNC: %r conf=%s where=%s src=%s" % (cul, conf, rec.get("where"), rec.get("src")))
        else:
            _log("ВИНОВНИК ASYNC: неизвестен (where=%s)" % rec.get("where"))
        _log("  причина: %s" % rec.get("reason"))
        pf = rec.get("py_file")
        if pf: _log("  modul: %s:%s" % (pf, rec.get("py_line")))
        m = rec.get("aio_message")
        if m: _log("  aio-message: %s" % m)
        _log("  iskljuchenie: %s: %s" % (rec.get("exc_cls"), rec.get("exc_msg")))
        _log("===============================================")
    except Exception: pass

