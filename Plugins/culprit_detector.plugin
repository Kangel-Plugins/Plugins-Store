def _classify_crash_frames(frames):
    try:
        if _gpu_frames_hit_rs(frames) or _frames_hit_gl(frames): return "gpu"
        if _frames_hit_anim(frames): return "anim"
        if _frames_hit_mvel(frames): return "mvel"
        if _frames_hit_camera(frames): return "camera"
        if _frames_hit_mediacodec(frames): return "mediacodec"
        if _frames_hit_binder(frames): return "binder"
    except Exception:
        pass
    return None



def _wref_make(o):
    try: return weakref.ref(o)
    except Exception: return o
def _wref_get(r):
    try: return r() if isinstance(r, weakref.ReferenceType) else r
    except Exception: return r
def _prune_dead_wrefs(lst):
    try:
        i = 0
        for t in lst:
            r = t[0]
            if isinstance(r, weakref.ReferenceType) and r() is None: continue
            lst[i] = t; i += 1
        del lst[i:]
    except Exception: pass
_ENTRY_PATCHED = []
def _instrument_entrypoints():
    n = 0
    dead_c = set()
    try:
        for _rec in list(_b41_pend().values()):
            for _q, _wr in (_rec.get("cls") or []) if isinstance(_rec, dict) else []:
                _c = _wr()
                if _c is not None:
                    dead_c.add(id(_c))
        _c = None
    except Exception:
        pass
    try:
        objs = _gc.get_objects()
    except Exception:
        return 0
    for obj in objs:
        try:
            if not isinstance(obj, BasePlugin):
                continue
            if id(type(obj)) in dead_c:
                continue
            pid = _canonical_pid(obj)
            if pid == _SELF_ID or pid == __id__:
                continue
            for cb in _ENTRY_CBS:
                fn = getattr(obj, cb, None)
                if fn is None or not callable(fn):
                    continue
                if getattr(fn, _B_TAGGED_FLAG, False):
                    continue
                try:
                    wrapped = _wrap_settings_factory(pid, fn) if cb == "create_settings" else _wrap_entry(pid, fn)
                    setattr(obj, cb, wrapped); n += 1
                    try:
                        _prune_dead_wrefs(_ENTRY_PATCHED)
                        _ENTRY_PATCHED.append((_wref_make(obj), cb, _wref_make(wrapped)))
                    except Exception: pass
                except Exception:
                    pass
        except Exception:
            pass
    if n:
        _log(f"PartB scope-widen: обёрнуто entry-колбэков={n}")
    return n

_THREAD_SHIM_ON = False
_PARTB_TIMER = None
_THREAD_SHIM_INSTALLED = None
def _native_thread_inherit():
    try:
        if _NATIVE_OK and _NLIB is not None and hasattr(_NLIB, "cd_thread_inherit_ok"):
            return int(_NLIB.cd_thread_inherit_ok()) == 1
    except Exception:
        pass
    return False

def _thread_shim_release(state, entering=False):
    """Restore only our run override, and drop our strong saved callable."""
    with state["lock"]:
        thread = state["thread"]()
        wrapper = state["wrapper"]()
        owns_override = thread is not None and wrapper is not None and thread.__dict__.get("run") is wrapper
        if not entering and thread is not None and not owns_override:
            return None
        real = state.pop("real_run", None)
        if owns_override:
            if state["had_run"]:
                thread.run = state["saved_run"]
            else:
                del thread.run
            thread._culprit_wrapped = False
        state.pop("saved_run", None)
        return real


def _thread_shim_detach():
    lifetime = globals().get("_THREAD_SHIM_LIFETIME")
    if isinstance(lifetime, dict): lifetime["active"] = False
    for wrapper in list(globals().get("_THREAD_SHIM_RUNS") or ()):
        try: _thread_shim_release(wrapper._culprit_run_state)
        except Exception as e: _log("thread-shim detach err: %s" % e)


def _install_thread_shim():
    global _THREAD_SHIM_ON, _THREAD_SHIM_INSTALLED, _THREAD_SHIM_LIFETIME, _THREAD_SHIM_RUNS
    if _THREAD_SHIM_ON: return
    import weakref as _wr
    lifetime = {"active": True}
    runs = _wr.WeakSet()
    _THREAD_SHIM_LIFETIME = lifetime
    _THREAD_SHIM_RUNS = runs
    try:
        cur = threading.Thread.start
        if threading.Thread.__dict__.get("_culprit_shim_fn") is cur:
            original = getattr(cur, "_culprit_prev", None) or cur
        else:
            original = cur
        def _tagged_start(thread, *args, **kwargs):
            if not lifetime["active"]: return original(thread, *args, **kwargs)
            try:
                parent = _reg_get(_cur_tid())
                pid = _resolve_idx(parent) if parent is not None and parent >= 0 else None
                if pid is None: pid = _provenance_pid(thread, 1)
            except Exception: pid = None
            wrapper = None
            if pid is not None and not getattr(thread, "_culprit_wrapped", False):
                state = {"thread": _wr.ref(thread), "real_run": thread.run,
                         "had_run": "run" in thread.__dict__,
                         "saved_run": thread.__dict__.get("run"), "lock": threading.RLock()}
                def _run_wrapper(*run_args, **run_kwargs):
                    real = _thread_shim_release(state, entering=True)
                    if real is None:
                        t = state["thread"]()
                        real = t.run if t is not None else None
                        t = None
                    if real is None: return None
                    pushed = False
                    try:
                        if lifetime["active"]:
                            pushed = _scoped_set(pid)
                            try: _b41_thr_adopt(pid)
                            except Exception: pass
                        return real(*run_args, **run_kwargs)
                    finally:
                        if pushed:
                            try: _scoped_clear()
                            except Exception: pass
                        real = None
                wrapper = _run_wrapper
                state["wrapper"] = _wr.ref(wrapper)
                wrapper._culprit_run_state = state
                thread.run = wrapper
                thread._culprit_wrapped = True
                runs.add(wrapper)
            try:
                return original(thread, *args, **kwargs)
            except Exception:
                if wrapper is not None: _thread_shim_release(wrapper._culprit_run_state)
                raise
        _tagged_start._culprit_shim = True
        _tagged_start._culprit_prev = original
        threading.Thread.start = _tagged_start
        threading.Thread._culprit_shim = True
        threading.Thread._culprit_shim_fn = _tagged_start
        _THREAD_SHIM_INSTALLED = _tagged_start
        _THREAD_SHIM_ON = True
        _log("PartB +UB: weak thread registry; run restored at entry; native inheritance=%s" % _native_thread_inherit())
    except Exception as e:
        lifetime["active"] = False
        _log("PartB thread-shim err: %s" % e)


def _partb_install():
    try:
        _install_thread_shim()
    except Exception as e:
        _log(f"PartB thread-shim install err: {e}")
    try:
        _install_settings_ctor_scope()
    except Exception as e:
        _log(f"Gap8 settings-ctor install err: {e}")
    try:
        _instrument_entrypoints()
        global _PARTB_TIMER
        try:
            if _PARTB_TIMER is not None: _PARTB_TIMER.cancel()
        except Exception: pass
        _PARTB_TIMER = threading.Timer(2.5, _instrument_entrypoints)
        _PARTB_TIMER.daemon = True; _PARTB_TIMER.start()
    except Exception as e:
        _log(f"PartB install err: {e}")

def _partb_uninstall():
    global _PARTB_TIMER, _THREAD_SHIM_ON, _THREAD_SHIM_INSTALLED
    _thread_shim_detach()
    try:
        if _PARTB_TIMER is not None:
            _PARTB_TIMER.cancel()
            _PARTB_TIMER = None
    except Exception as e:
        _log(f"PartB timer cancel err: {e}")
    try:
        _orig_start = (getattr(_THREAD_SHIM_INSTALLED, "_culprit_prev", None) if _THREAD_SHIM_INSTALLED is not None else None) or getattr(threading.Thread, "_culprit_orig_start", None)
        if (_orig_start is not None and _THREAD_SHIM_INSTALLED is not None
                and threading.Thread.start is _THREAD_SHIM_INSTALLED):
            threading.Thread.start = _orig_start
            try: threading.Thread._culprit_shim = False
            except Exception: pass
            try: threading.Thread._culprit_shim_fn = None
            except Exception: pass
        elif _THREAD_SHIM_INSTALLED is not None and threading.Thread.start is not _THREAD_SHIM_INSTALLED:
            _log("PartB: thread-shim обёрнут поверх другим плагином — оставляю как есть (revert пропущен)")
        _THREAD_SHIM_INSTALLED = None
        _THREAD_SHIM_ON = False
    except Exception as e:
        _log(f"PartB thread-shim uninstall err: {e}")
    try:
        global _SETTINGS_CTOR_HOOKED
        for _cls, _orig, _w in list(_SETTINGS_PATCHED):
            try:
                if _cls.__dict__.get("__init__") is _w:
                    _cls.__init__ = _orig
            except Exception: pass
        _SETTINGS_PATCHED.clear()
        _SETTINGS_CTOR_HOOKED = False
    except Exception as e:
        _log(f"Gap8 settings-ctor uninstall err: {e}")
    try:
        for _tup in list(_ENTRY_PATCHED):
            try:
                _obj = _wref_get(_tup[0])
                if _obj is None: continue
                _cb = _tup[1]
                _ourw = _wref_get(_tup[2]) if len(_tup) > 2 else None
                if _ourw is not None and getattr(_obj, _cb, None) is _ourw:
                    _orig = getattr(_ourw, "__wrapped__", None)
                    if _orig is not None:
                        setattr(_obj, _cb, _orig)
                    else:
                        try: delattr(_obj, _cb)
                        except Exception: pass
            except Exception: pass
        _ENTRY_PATCHED.clear()
    except Exception as e:
        _log(f"PartB entrypoint uninstall err: {e}")


try:
    from base_plugin import MethodReplacement as _MethodReplacement
except Exception:
    _MethodReplacement = None

_BLOCK10_ON = True
_B10_FLAG = "__culprit_hookwrap__"
_B10_METHODS = ("before_hooked_method", "after_hooked_method", "replace_hooked_method")
_B10_PATCHED = {}
_B10_WRAPPED_CLASSES = []
_B10_WRAP_LOCK = threading.Lock()
_B10_TIMERS = []

def _b10_owner_from_module(mod_name):
    if not mod_name:
        return None
    try:
        mod = _sys.modules.get(mod_name)
    except Exception:
        mod = None
    pid = getattr(mod, "__id__", None) if mod is not None else None
    if not (isinstance(pid, str) and pid):
        pid = _canon_pid(mod_name)
    if pid == _SELF_ID or pid == __id__:
        return None
    return pid

def _b10_pyframe_culprit(exc, owner):
    try:
        tb = getattr(exc, "__traceback__", None)
    except Exception:
        tb = None
    best = (None, None, -1)
    best_owner = None
    while tb is not None:
        try:
            f = tb.tb_frame; g = f.f_globals
            mod = g.get("__name__") or ""
            fn = g.get("__file__") or ((mod + ".py") if mod else None)
            ln = tb.tb_lineno
        except Exception:
            mod = ""; fn = None; ln = -1
        pid = None
        if mod and mod != _SELF_ID and mod != __id__:
            try:
                mobj = _sys.modules.get(mod)
                cand = getattr(mobj, "__id__", None) if mobj is not None else None
                if not (isinstance(cand, str) and cand):
                    c2 = _canon_pid(mod)
                    if isinstance(c2, str) and c2 and c2 != mod:
                        cand = c2
                if isinstance(cand, str) and cand and cand != _SELF_ID and cand != __id__:
                    pid = cand
            except Exception:
                pid = None
        if pid is not None:
            best = (pid, fn, int(ln) if ln is not None else -1)
            if owner and pid == owner:
                best_owner = (pid, fn, int(ln) if ln is not None else -1)
        try: tb = tb.tb_next
        except Exception: tb = None
    return best_owner if best_owner is not None else best

def _b10_record(owner, exc, where):
    if not _BLOCK10_ON:
        return
    try: exc_cls = type(exc).__name__
    except Exception: exc_cls = "?"
    try: exc_msg = str(exc)
    except Exception: exc_msg = None
    reason = ("%s: %s" % (exc_cls, exc_msg)) if exc_msg else exc_cls
    py_mod, py_file, py_line = _b10_pyframe_culprit(exc, owner)
    if py_mod:
        culprit = py_mod; src = "py-frame/" + where; conf = "high"
    elif owner:
        culprit = owner; src = "scope/" + where; conf = "medium"
    else:
        culprit = "unknown"; src = "none"; conf = "low"
    _rate_pm, _rate_n = _exc_rate_record(culprit)
    rec = {"had_hook_fail": True, "culprit": culprit, "src": src, "confidence": conf,
           "where": where, "scoped_pid": owner, "py_module": py_mod,
           "py_file": py_file, "py_line": py_line, "reason": reason,
           "throws_per_min": _rate_pm, "throws_in_window": _rate_n,
           "high_rate": bool(_rate_pm >= _EXC_RATE_HOT),
           "exc_cls": exc_cls, "exc_msg": exc_msg, "ts": int(time.time() * 1000)}
    _hook_live_mark(rec)
    key = "%s|%s|%s" % (culprit, reason, where); now = rec["ts"]
    try:
        with _HOOK_SEEN_LOCK:
            if now - _HOOK_SEEN.get(key, 0) < _HOOK_DEDUP_MS:
                return
            _HOOK_SEEN[key] = now
    except Exception:
        pass
    try: _hook_verdict_log(rec, "live")
    except Exception: pass
    try: _persist_hook_fail(rec)
    except Exception: pass

def _b10_make_wrapper(orig, name):
    @_functools.wraps(orig)
    def _w(self, *a, **kw):
        mod_name = None
        try: mod_name = getattr(type(self), "__module__", None)
        except Exception: mod_name = None
        owner = _B10_OWNER_CACHE.get(mod_name, _B10_UNSET) if mod_name else _B10_UNSET
        if owner is _B10_UNSET:
            try: owner = _b10_owner_from_module(mod_name)
            except Exception: owner = None
            if owner is not None and mod_name:
                _B10_OWNER_CACHE[mod_name] = owner
        param0 = a[0] if a else None
        method_name = None
        if param0 is not None:
            try: method_name = str(param0.method.getName())
            except Exception: method_name = None
        if owner is not None and method_name and _KZ_MO_MAP.get(method_name) is None:
            try: _kz_mo_note(method_name, owner)
            except Exception: pass
        _reentry_native = None
        method_key = None
        if owner and _NLIB is not None:
            oidx = _intern(owner)
            wcode = _B10_WHERE_CODE.get(name, 6)
            midx = _b10_method_idx(method_name) if method_name else 0
            try: _proceed = int(_CD_B10_ENTER(int(oidx), int(wcode), int(midx), int(_B10_REENTRY_MAX_DEPTH)))
            except Exception: _proceed = 1
            if _proceed == 0:
                _b10_reentry_log_cut(owner, name, method_name)
                if name != "replace_hooked_method":
                    return None
                try:
                    return orig(self, *a, **kw)
                except BaseException as e:
                    try: _b10_record(owner, e, name)
                    except Exception: pass
                    raise
            _reentry_native = (oidx, wcode, midx)
            method_key = method_name
        _passive = False
        if _B10_PASSIVE_SCOPE_SKIP and owner is not None and method_name:
            try: _passive = _b10_passive_scope_skip(owner, method_name, method_key)
            except Exception: _passive = False
        pushed = False
        if owner is not None and not _passive:
            try: pushed = _scoped_set(owner)
            except Exception: pushed = False
            if name == "before_hooked_method":
                try: _scoped_arm(owner)
                except Exception: pass
        if _BLOCK28_ON and owner is not None and method_name:
            try:
                if method_name in _B28_HOT_METHODS:
                    _b28_reg_hot_hook(owner, method_name, persist=True)
                    try: _b28_hit(owner, method_name)
                    except Exception: pass
            except Exception:
                pass
        try:
            return orig(self, *a, **kw)
        except BaseException as e:
            if owner is not None:
                try:
                    if method_key and _b10_shape_getter(method_name):
                        _b10_passive_mark_force(owner, method_key, method_name, "python_exception")
                except Exception: pass
                try: _b10_record(owner, e, name)
                except Exception: pass
            raise
        finally:
            if pushed:
                try: _scoped_clear()
                except Exception: pass
            if name == "after_hooked_method":
                try: _scoped_arm_clear()
                except Exception: pass
            if _reentry_native is not None:
                try: _CD_B10_LEAVE(int(_reentry_native[0]), int(_reentry_native[1]), int(_reentry_native[2]))
                except Exception: pass
    try:
        setattr(_w, _B10_FLAG, True)
        hf = getattr(orig, "__hook_filters__", None)
        if hf is not None:
            try: _w.__hook_filters__ = dict(hf) if isinstance(hf, dict) else hf
            except Exception: pass
    except Exception:
        pass
    return _w

def _b10_wrap_class(cls):
    if cls is None:
        return 0
    try:
        mod = getattr(cls, "__module__", None)
        if mod == _SELF_ID or mod == __id__ or mod == "base_plugin":
            return 0
    except Exception:
        pass
    n = 0
    for name in _B10_METHODS:
        try:
            fn = cls.__dict__.get(name)
        except Exception:
            fn = None
        if fn is None or not callable(fn):
            continue
        if getattr(fn, _B10_FLAG, False):
            continue
        try:
            wrapped = _b10_make_wrapper(fn, name)
            setattr(cls, name, wrapped)
            with _B10_WRAP_LOCK:
                _prune_dead_wrefs(_B10_WRAPPED_CLASSES)
                _B10_WRAPPED_CLASSES.append((_wref_make(cls), name, _wref_make(fn), _wref_make(wrapped)))
            n += 1
        except Exception:
            pass
    return n

def _b10_all_subclasses(root):
    out = []
    try:
        subs = list(root.__subclasses__())
    except Exception:
        subs = []
    for s in subs:
        out.append(s)
        out.extend(_b10_all_subclasses(s))
    return out

def _b10_sweep(reason="sweep"):
    bases = [MethodHook]
    if _MethodReplacement is not None:
        bases.append(_MethodReplacement)
    seen = set(); total = 0; classes = 0
    for b in bases:
        for cls in [b] + _b10_all_subclasses(b):
            try: k = id(cls)
            except Exception: k = None
            if k in seen: continue
            seen.add(k)
            c = _b10_wrap_class(cls)
            if c: classes += 1; total += c
    if total:
        _log(f"Block#10 {reason}: обёрнуто классов-хуков={classes} методов={total}")
    return total

def _b10_wrap_functional(fn):
    if fn is None or not callable(fn) or getattr(fn, _B10_FLAG, False):
        return fn
    _mod0 = getattr(fn, "__module__", None)
    if _mod0 is None:
        try:
            if isinstance(fn, _functools.partial):
                _mod0 = getattr(fn.func, "__module__", None)
            elif hasattr(fn, "__call__"):
                _mod0 = getattr(fn.__call__, "__module__", None)
        except Exception:
            pass
    try:
        owner0 = _b10_owner_from_module(_mod0)
    except Exception:
        owner0 = None
    @_functools.wraps(fn)
    def _w(*a, **kw):
        pushed = False
        if owner0 is not None:
            try: pushed = _scoped_set(owner0)
            except Exception: pushed = False
        try:
            return fn(*a, **kw)
        except BaseException as e:
            if owner0 is not None:
                try: _b10_record(owner0, e, "functional")
                except Exception: pass
            raise
        finally:
            if pushed:
                try: _scoped_clear()
                except Exception: pass
    try: setattr(_w, _B10_FLAG, True)
    except Exception: pass
    return _w

def _b10_is_hook_instance(obj):
    if obj is None or isinstance(obj, type):
        return False
    try:
        if isinstance(obj, MethodHook):
            return True
    except Exception:
        pass
    try:
        if _MethodReplacement is not None and isinstance(obj, _MethodReplacement):
            return True
    except Exception:
        pass
    try:
        return any(callable(getattr(obj, n, None)) for n in _B10_METHODS)
    except Exception:
        return False

_B10_INSTALLED = {}
def _b10_patch_basehooks():
    if not hasattr(BasePlugin, "hook_method"):
        _log("Block#10: BasePlugin.hook_method не найден — monkeypatch пропущен"); return 0
    patched = 0
    for mname in ("hook_method", "hook_all_methods", "hook_all_constructors"):
        orig = getattr(BasePlugin, mname, None)
        if orig is None or _cp_is_owned_basehook(orig, _B10_FLAG):
            continue
        def _make(orig=orig, mname=mname):
            lifetime = {"active": True}
            @_functools.wraps(orig)
            def _patched(self, *a, **kw):
                if not lifetime["active"] or globals().get("_CP_LIFECYCLE") in ("unloading", "unloaded", "disabled"):
                    return orig(self, *a, **kw)
                try:
                    for arg in list(a) + list(kw.values()):
                        if _b10_is_hook_instance(arg):
                            try: _b10_wrap_class(type(arg))
                            except Exception: pass
                    for fk in ("before", "after", "replace"):
                        if fk in kw and callable(kw[fk]):
                            try: kw[fk] = _b10_wrap_functional(kw[fk])
                            except Exception: pass
                except Exception:
                    pass
                if mname in ("hook_method", "hook_all_methods") and a:
                    try:
                        m_obj = a[0]
                        mname_java = None
                        try: mname_java = str(m_obj.getName())
                        except Exception: pass
                        pid = _canonical_pid(self)
                        if pid and pid != _SELF_ID:
                            if mname_java:
                                _kz_mo_note(mname_java, pid)
                            if mname == "hook_all_methods" and len(a) >= 2 and isinstance(a[1], str):
                                _kz_mo_note(a[1], pid)
                            if _BLOCK28_ON and mname_java and mname_java in _B28_HOT_METHODS:
                                _b28_reg_hot_hook(pid, mname_java, persist=True)
                    except Exception:
                        pass
                return orig(self, *a, **kw)
            try:
                setattr(_patched, _B10_FLAG, True)
                _patched._culprit_basehook_code = _patched.__code__
                _patched._culprit_basehook_lifetime = lifetime
            except Exception: pass
            return _patched
        try:
            _w = _make()
            setattr(BasePlugin, mname, _w)
            _B10_PATCHED[mname] = orig
            _B10_INSTALLED[mname] = _w
            patched += 1
        except Exception as e:
            _log(f"Block#10: monkeypatch {mname} err: {e}")
    if patched:
        _log(f"Block#10: monkeypatch BasePlugin.* установлен ({patched}/3)")
    return patched

def _b10_unpatch():
    for _t in _B10_TIMERS:
        try: _t.cancel()
        except Exception: pass
    _B10_TIMERS.clear()
    for mname, orig in list(_B10_PATCHED.items()):
        try:
            installed = _B10_INSTALLED.get(mname)
            lifetime = getattr(installed, "_culprit_basehook_lifetime", None)
            if isinstance(lifetime, dict): lifetime["active"] = False
            cur = getattr(BasePlugin, mname, None)
            if cur is not None and cur is _B10_INSTALLED.get(mname):
                setattr(BasePlugin, mname, orig)
        except Exception: pass
    _B10_PATCHED.clear()
    _B10_INSTALLED.clear()
    with _B10_WRAP_LOCK:
        items = list(_B10_WRAPPED_CLASSES); _B10_WRAPPED_CLASSES.clear()
    for tup in items:
        try:
            cls = _wref_get(tup[0])
            if cls is None: continue
            name, orig_fn = tup[1], _wref_get(tup[2])
            our_w = _wref_get(tup[3]) if len(tup) > 3 else None
            if orig_fn is None or (len(tup) > 3 and our_w is None):
                continue
            cur = cls.__dict__.get(name)
            if cur is not None and (cur is our_w if our_w is not None else getattr(cur, _B10_FLAG, False)):
                setattr(cls, name, orig_fn)
        except Exception:
            pass

_CP_LIFECYCLE = "unloaded"


def _cp_is_owned_basehook(fn, flag=None):
    """A wraps-copied marker is not ownership. Bind claim to actual code."""
    if fn is None: return False
    try:
        flags = (flag,) if flag else (_B10_FLAG, _B12_FLAG)
        if not any(getattr(fn, f, False) for f in flags): return False
        code = getattr(fn, "__code__", None)
        if code is None: return False
        claim = getattr(fn, "_culprit_basehook_code", None)
        if claim is not None: return claim is code
        return getattr(fn, "__globals__", {}).get("__id__") == "culprit_detector"
    except Exception:
        return False


def _cp_reclaim_basehooks():
    try: bp = BasePlugin
    except Exception: return 0
    count = 0
    for name in ("hook_method", "hook_all_methods", "hook_all_constructors", "add_menu_item"):
        try:
            current = getattr(bp, name, None)
            if not _cp_is_owned_basehook(current): continue
            base = current; seen = set(); layers = []; hops = 0
            while _cp_is_owned_basehook(base):
                if id(base) in seen or hops >= 32:
                    base = None; break
                seen.add(id(base)); layers.append(base); hops += 1
                child = getattr(base, "__wrapped__", None)
                if child is None or child is base:
                    base = None; break
                base = child
            if base is not None and base is not current and getattr(bp, name, None) is current:
                for layer in layers:
                    lifetime = getattr(layer, "_culprit_basehook_lifetime", None)
                    if isinstance(lifetime, dict): lifetime["active"] = False
                setattr(bp, name, base); count += 1
        except Exception: pass
    if count: _log("cooperative-patch +UC: reclaimed %d owned BasePlugin layer(s); foreign chains preserved" % count)
    return count


def _b10_install():
    if not _BLOCK10_ON:
        _log("Block#10: отключён (_BLOCK10_ON=False)"); return
