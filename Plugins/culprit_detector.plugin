_NOTIF_RETRY_THREAD = None
_NOTIF_RETRY_ON = True
_NOTIF_RETRY_DELAYS = (3.0, 8.0, 20.0, 45.0)

def _b25_notif_ui_post(fn):
    try:
        from client_utils import run_on_ui_thread
        run_on_ui_thread(fn); return True
    except Exception:
        pass
    try:
        import android_utils
        android_utils.run_on_ui_thread(fn, 0); return True
    except Exception:
        pass
    return False

def _b25_notif_retry_once():
    res = {"ok": False, "err": None}
    done = threading.Event()
    def _attempt():
        try:
            res["ok"] = bool(_b25_try_native_notif())
        except Exception as e:
            res["err"] = e
        finally:
            done.set()
    if not _b25_notif_ui_post(_attempt):
        return None
    if not done.wait(10.0):
        return None
    if res["err"] is not None:
        raise res["err"]
    return res["ok"]

def _b25_notif_retry_loop():
    for _d in _NOTIF_RETRY_DELAYS:
        try: time.sleep(_d)
        except Exception: return
        if not _NOTIF_RETRY_ON or _NOTIF_NATIVE_ACTIVE: return
        try:
            ok = _b25_notif_retry_once()
            if ok:
                _log("Block#25NC +SP: отложенная установка удалась (island освободился)%s" % _b25_notif_diag_str())
                return
        except Exception as e:
            try: _log("Block#25NC +SP retry err: %s" % e)
            except Exception: pass
            return

def _b25_notif_retry_arm():
    global _NOTIF_RETRY_THREAD
    if not _NOTIF_RETRY_ON or _NOTIF_NATIVE_ACTIVE:
        return
    try:
        t = _NOTIF_RETRY_THREAD
        if t is not None and t.is_alive():
            return
        _NOTIF_RETRY_THREAD = threading.Thread(target=_b25_notif_retry_loop, name="cd-b25nc-retry", daemon=True)
        _NOTIF_RETRY_THREAD.start()
    except Exception as e:
        try: _log("Block#25NC +SP retry arm err: %s" % e)
        except Exception: pass

