                if _zjtidm: rec["tid_candidate"] = _zjcur
                _zjweak = (rec.get("confidence") in (None, "low", "none")) or (not _zjcur) or (_zjcur == "unknown") or _zjtidm or (isinstance(_zjcur, str) and _zjcur.startswith("$Proxy")) or (rec.get("src") in ("stack-pkg", "breadcrumb", "none"))
                if _zjo:
                    rec["reason"] = "зомби Java-proxy слушатель: плагин выгружен/перезагружен (PyObject closed), java.lang.reflect.Proxy остался зарегистрирован у хоста (%s; владелец: %s)" % (_zjp, _zjo)
                    if _zjweak:
