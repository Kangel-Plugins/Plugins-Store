__id__ = "culprit_detector"
__name__ = "Culprit Detector"
__version__ = "1.9.0"
_CULPRIT_DETECTOR_SELF_MARKER = "CULPRIT_DETECTOR_SELF_MARKER_v1"
__description__ = "Passive culprit detector — definitely finds crashing or leaking plugin"
__author__ = "@chestertech & @useful_plugins"
__icon__ = "chestertech/15"
__min_version__ = "12.10.6"

try:
    _LocaleController = jclass("org.telegram.messenger.LocaleController")
except Exception:
    _LocaleController = None

def _cd_lang():
    try:
        if _LocaleController is not None:
            lc = _LocaleController.getInstance()
            if lc is not None and hasattr(lc, "getCurrentLocale"):
                loc = lc.getCurrentLocale()
                if loc is not None and hasattr(loc, "getLanguage"):
                    if str(loc.getLanguage()) == "ru":
                        return "ru"
    except Exception:
        pass
    return "en"

