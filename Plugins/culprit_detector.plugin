                lib.cd_gref_live.argtypes = [c.c_int32]; lib.cd_gref_live.restype = c.c_int64
                lib.cd_gref_live_untagged.restype = c.c_int64
                lib.cd_gref_del_untracked.restype = c.c_int64
                lib.cd_gref_overflow.restype = c.c_int64
                lib.cd_gref_live_top1.argtypes = [c.POINTER(c.c_int64)]; lib.cd_gref_live_top1.restype = c.c_int32
                lib.cd_gref_live_snapshot.argtypes = [c.POINTER(c.c_int64), c.c_int32]; lib.cd_gref_live_snapshot.restype = c.c_int
            globals()["_GREF_LIVE_OK"] = bool(_gref_live_ok)
            if hasattr(lib, "cd_gref_set_time_div"):
                lib.cd_gref_set_time_div.argtypes = [c.c_int]; lib.cd_gref_set_time_div.restype = None
