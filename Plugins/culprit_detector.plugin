            lib.cd_smaps_rollup.argtypes = [c.POINTER(c.c_int64), c.c_int32]; lib.cd_smaps_rollup.restype = c.c_int
            lib.cd_smaps_selftest.restype = c.c_int
            if hasattr(lib, "cd_dmabuf_fd_scan"):
                lib.cd_dmabuf_fd_scan.argtypes = [c.POINTER(c.c_int64), c.c_int32]; lib.cd_dmabuf_fd_scan.restype = c.c_int
            _smaps_layout_ok = True
            try:
                if hasattr(lib, "cd_smaps_group_count"):
                    lib.cd_smaps_group_count.restype = c.c_int32
                    if int(lib.cd_smaps_group_count()) != len(_SMAPS_NATIVE_GROUPS): _smaps_layout_ok = False
                if hasattr(lib, "cd_smaps_field_count"):
                    lib.cd_smaps_field_count.restype = c.c_int32
                    if int(lib.cd_smaps_field_count()) != _SMAPS_NATIVE_FIELDS: _smaps_layout_ok = False
                if hasattr(lib, "cd_smaps_layout_version"):
                    lib.cd_smaps_layout_version.restype = c.c_int32
                    if int(lib.cd_smaps_layout_version()) != _SMAPS_NATIVE_LAYOUT_VERSION: _smaps_layout_ok = False
            except Exception:
                _smaps_layout_ok = False
            _SMAPS_NATIVE_OK = bool(_smaps_layout_ok)
            if _SMAPS_NATIVE_OK:
                try: _log("Block#6D +DU(smaps-native): selftest groups=%d" % int(lib.cd_smaps_selftest()))
                except Exception: pass
                try:
                    if hasattr(lib, "cd_dmabuf_fd_scan"):
                        _da = (c.c_int64 * 12)(); _dr = int(lib.cd_dmabuf_fd_scan(_da, c.c_int32(12)))
                        _log("Block#6S +RK(dmabuf-fd): rc=%d fds=%d bufs=%d bytes=%d unmapped=%d/%dB size_unknown=%d src=%d mapped=%d us=%d" % (_dr, _da[1], _da[2], _da[3], _da[4], _da[5], _da[6], _da[8], _da[9], _da[11]))
                    else:
                        _log("Block#6S +RK(dmabuf-fd): .so without cd_dmabuf_fd_scan -> HW bitmaps (unmapped dma-buf) invisible to gfx-dmabuf")
                except Exception: pass
            else:
                try: _log("Block#6D +DU(smaps-native): layout drift vs .so (groups/fields/version) -> disabled (guards against memory misattribution)")
                except Exception: pass
        else:
            _SMAPS_NATIVE_OK = False
    except Exception:
        _SMAPS_NATIVE_OK = False

def _b4c_decl(lib):
    c = ctypes
    lib.cd_lt_init.argtypes = [c.c_int32]; lib.cd_lt_init.restype = c.c_int
    lib.cd_register_loader.argtypes = [c.c_int64, c.c_int32]; lib.cd_register_loader.restype = c.c_int
    lib.cd_loader_pid.argtypes = [c.c_int64]; lib.cd_loader_pid.restype = c.c_int32
    lib.cd_lt_count.restype = c.c_int32
    lib.cd_lt_clear.restype = None
    lib.cd_set_active_plugin.argtypes = [c.c_int32]; lib.cd_set_active_plugin.restype = None
    lib.cd_clear_active_plugin.restype = None
    lib.cd_active_plugin.restype = c.c_int32
    try: lib.cd_reset_active_plugin.restype = None
    except Exception: pass
    lib.cd_install_crash_handler.argtypes = [c.c_char_p]; lib.cd_install_crash_handler.restype = c.c_int
    lib.cd_uninstall_crash_handler.restype = None
    if hasattr(lib, "cd_crash_handler_mask"):
        lib.cd_crash_handler_mask.restype = c.c_uint
    if hasattr(lib, "cd_set_host_lib_dir"):
        lib.cd_set_host_lib_dir.argtypes = [c.c_char_p]; lib.cd_set_host_lib_dir.restype = c.c_int
    if hasattr(lib, "cd_maps_refresh"):
        lib.cd_maps_refresh.restype = c.c_int
    if hasattr(lib, "cd_maps_count"):
        lib.cd_maps_count.restype = c.c_int
    if hasattr(lib, "cd_tomb_count"):
        lib.cd_tomb_count.restype = c.c_int64
    if hasattr(lib, "cd_compactions"):
        lib.cd_compactions.restype = c.c_int64
    if hasattr(lib, "cd_compact"):
        lib.cd_compact.restype = c.c_int64

def _native_crash_path():
    return _data_path(_NATIVE_CRASH_NAME)

def _native_crash_verdict_path():
    return _data_path(_NATIVE_CRASH_VERDICT_NAME)

def _crash_verdict_durable_path():
    return _data_path(_CRASH_VERDICT_DURABLE_NAME)

_OD_LAST_ENTRY_NAME = "last_py_entry.json"

def _od_entry_path():
    return _data_path(_OD_LAST_ENTRY_NAME)

def _od_entry_flush():
    g = _OD_ENTRY_GEN[0]
    if g == _OD_ENTRY_FLUSHED[0]:
        return
    _oc = False
    try:
        now = int(time.time() * 1000)
        _oc = _OD_OWNER_CHANGED[0]
        if not _oc and (now - _OD_LAST_FLUSH_MS[0]) < 9000:
            return
        if _oc:
            _OD_OWNER_CHANGED[0] = False
        snap = dict(_OD_LAST_ENTRY)
        items = sorted(snap.items(), key=lambda kv: kv[1][1], reverse=True)[:64]
        ents = {}
        for t, v in items:
            ents[str(t)] = {"pid": v[0], "ts": v[1]}
        data = {"od_schema": 2, "proc_pid": int(os.getpid()), "flush_ts": now, "entries": ents}
        p = _od_entry_path()
        if p:
            if _atomic_json_write_impl(p, data):
                _OD_ENTRY_FLUSHED[0] = g
                _OD_LAST_FLUSH_MS[0] = now
            elif _oc:
                _OD_OWNER_CHANGED[0] = True
        if len(_OD_LAST_ENTRY) > 128:
            keep = set(t for t, _v in items)
            for t in list(_OD_LAST_ENTRY.keys()):
                try:
                    if t not in keep and (now - _OD_LAST_ENTRY[t][1]) > 600000:
                        _OD_LAST_ENTRY.pop(t, None)
                except Exception:
                    pass
    except Exception:
        try:
            if _oc:
                _OD_OWNER_CHANGED[0] = True
        except Exception:
            pass

def _host_lib_dir():
    try:
        ctx = _app_context()
        if ctx is None: return None
        ai = ctx.getApplicationInfo()
        d = getattr(ai, "nativeLibraryDir", None)
        return str(d) if d else None
    except Exception:
        return None

def _scope_decl(lib):
    c = ctypes
    if not all(hasattr(lib, n) for n in ("cd_scope_enter", "cd_scope_leave", "cd_scope_current")):
        return False
    lib.cd_scope_enter.argtypes = [c.c_int32]; lib.cd_scope_enter.restype = c.c_int
    lib.cd_scope_leave.argtypes = []; lib.cd_scope_leave.restype = c.c_int
    lib.cd_scope_current.argtypes = []; lib.cd_scope_current.restype = c.c_int32
    global _MARKW_OK
    try:
        if hasattr(lib, "cd_scope_mark_worker"):
            lib.cd_scope_mark_worker.argtypes = []; lib.cd_scope_mark_worker.restype = c.c_int
            _MARKW_OK = True
    except Exception:
        pass
    global _ARM_OK
    try:
        if all(hasattr(lib, n) for n in ("cd_scope_arm", "cd_scope_arm_clear")):
            lib.cd_scope_arm.argtypes = [c.c_int32]; lib.cd_scope_arm.restype = c.c_int
            lib.cd_scope_arm_clear.argtypes = []; lib.cd_scope_arm_clear.restype = c.c_int
            try:
                lib.cd_scope_arm_window_ns.argtypes = [c.c_int64]; lib.cd_scope_arm_window_ns.restype = c.c_int64
            except Exception: pass
            _ARM_OK = True
            try:
                if all(hasattr(lib, n) for n in ("cd_seed_arm", "cd_seed_take")):
                    lib.cd_seed_arm.argtypes = [c.c_int32]; lib.cd_seed_arm.restype = c.c_int
                    lib.cd_seed_take.argtypes = []; lib.cd_seed_take.restype = c.c_int32
                    globals()["_SEED_OK"] = True
            except Exception:
                globals()["_SEED_OK"] = False
    except Exception:
        _ARM_OK = False
    global _PIDCOUNT_OK
    try:
        if hasattr(lib, "cd_reg_set_pid_count"):
            lib.cd_reg_set_pid_count.argtypes = [c.c_int32]; lib.cd_reg_set_pid_count.restype = c.c_int
            _PIDCOUNT_OK = True
            try: lib.cd_reg_set_pid_count(c.c_int32(len(_IDX_PID)))
            except Exception: pass
    except Exception:
        _PIDCOUNT_OK = False
    try:
        if all(hasattr(lib, n) for n in ("cd_b10_enter", "cd_b10_leave", "cd_b10_selftest")):
            lib.cd_b10_enter.argtypes = [c.c_int32, c.c_int32, c.c_int32, c.c_int32]; lib.cd_b10_enter.restype = c.c_int32
            lib.cd_b10_leave.argtypes = [c.c_int32, c.c_int32, c.c_int32]; lib.cd_b10_leave.restype = c.c_int32
            lib.cd_b10_selftest.argtypes = [c.c_int32]; lib.cd_b10_selftest.restype = c.c_int32
            global _CD_B10_ENTER, _CD_B10_LEAVE
            _CD_B10_ENTER = lib.cd_b10_enter
            _CD_B10_LEAVE = lib.cd_b10_leave
            if int(lib.cd_b10_selftest(0)) == 1:
                _log("Block#10/G: нативный reentry-gate (cd_b10_enter/leave) доступен — горячий путь _w без Python-dict")
            else:
                _log("Block#10/G: WARN cd_b10_selftest != 1 -- native reentry-gate self-test failed (out-of-sync .so build!)")
    except Exception:
        pass
    try:
        lib.cd_scope_depth.argtypes = []; lib.cd_scope_depth.restype = c.c_int32
    except Exception: pass
    try:
        lib.cd_thread_inherited.argtypes = []; lib.cd_thread_inherited.restype = c.c_int64
    except Exception: pass
    try:
        if hasattr(lib, "cd_thread_sig_unblock_total"):
            lib.cd_thread_sig_unblock_total.argtypes = []; lib.cd_thread_sig_unblock_total.restype = c.c_int64
        if hasattr(lib, "cd_thread_sig_unblock_set"):
            lib.cd_thread_sig_unblock_set.argtypes = [c.c_int]; lib.cd_thread_sig_unblock_set.restype = None
    except Exception: pass
    return True

def _b4c_init(lib):
    global _B4C_OK
    try:
        _b4c_decl(lib)
    except Exception as e:
        _B4C_OK = False
        _log(f"Block#4C: символы не найдены в .so (старый бинарь?) — #4C отключён: {e}")
        return
    try:
        rc = int(lib.cd_lt_init(int(_LT_SLOTS)))
        ncp = _native_crash_path()
        ncw = None
        try:
            ncw = _aw_mirror_path(ncp) if ncp else None
        except Exception:
            ncw = None
        ncp_install = ncw or ncp
        inst = -1
        if ncp_install:
            inst = int(lib.cd_install_crash_handler(ncp_install.encode("utf-8")))
            if hasattr(lib, "cd_maps_refresh"):
                try:
                    _mc = int(lib.cd_maps_refresh())
                    _log(f"Block#4C +CO maps snapshot: {_mc} modules")
                except Exception as _emr:
                    _log(f"Block#4C +CO cd_maps_refresh err: {_emr}")
        hld = None
        if hasattr(lib, "cd_set_host_lib_dir"):
            try:
                hld = _host_lib_dir()
                lib.cd_set_host_lib_dir((hld or "").encode("utf-8"))
            except Exception as _ehl:
                _log(f"Block#4C: cd_set_host_lib_dir err: {_ehl}"); hld = None
        if rc != 0:
            _B4C_OK = False
            _log(f"Block#4C: cd_lt_init FAIL rc={rc} — #4C отключён (native-crash attribution OFF)")
            return
        if ncp and inst != 0:
            _B4C_OK = False
            _log(f"Block#4C: cd_install_crash_handler FAIL rc={inst} — #4C отключён")
            return
        _B4C_OK = True
        _b4c_cov = ""
        if inst == 0 and hasattr(lib, "cd_crash_handler_mask"):
            try:
                _b4c_msk = int(lib.cd_crash_handler_mask()) & 0x1F
                _b4c_full = (_b4c_msk == 0x1F)
                _b4c_cov = f", coverage={'FULL' if _b4c_full else 'PARTIAL'} mask=0x{_b4c_msk:02x}"
                if not _b4c_full:
                    _log(f"Block#4C: native-crash coverage PARTIAL mask=0x{_b4c_msk:02x} (не все сигналы захвачены)")
            except Exception as _emsk:
                _log(f"Block#4C: cd_crash_handler_mask err: {_emsk}")
        _log(f"Block#4C: lt_init rc={rc} slots={_LT_SLOTS}, crash_handler={'OK' if inst==0 else 'rc=%d' % inst}{_b4c_cov} -> {ncp_install}")
        _log(f"Block#4C +CJ host-native: lib_dir={hld!r} -> {'ON' if hld else 'OFF (старый .so или нет контекста)'}")
        global _SCOPE_OK
        try:
            if _scope_decl(lib):
                lib.cd_scope_enter(-1); lib.cd_scope_leave()
                _SCOPE_OK = True
                try:
                    global _JP_ARM_SEED
                    _jp_rev = int(lib.cd_build_rev()) if hasattr(lib, "cd_build_rev") else 0
                    _JP_ARM_SEED = bool(_SEED_OK and _jp_rev >= 10435)
                    _log("Block#3E +JP: thread-start owner-seed via native seed-slot = %s (rev=%s, seed_ok=%s, arm_ok=%s)" % (("ON" if _JP_ARM_SEED else "OFF (native path unavailable; hook no-op)"), _jp_rev, _SEED_OK, _ARM_OK))
                except Exception: pass
                _log("Block#10/C scope: cd_scope_enter/leave доступны — _scoped_set/clear через ОДИН нативный вызов")
                try:
                    if hasattr(lib, "cd_thread_inherited"):
                        _log("Block#10/C: cd_thread_inherited=%d (порождённые потоки унаследовали тег)" % int(lib.cd_thread_inherited()))
                except Exception: pass
            else:
                _SCOPE_OK = False
                _log("Block#10/C scope: cd_scope_* нет в .so (старый бинарь) — _scoped_set/clear через legacy (2 вызова)")
        except Exception as _esc:
            _SCOPE_OK = False
            _log("Block#10/C scope: декл/round-trip err: %s" % _esc)
    except Exception as e:
        _B4C_OK = False
        _log(f"Block#4C init err: {e}")

def _load_native():
    global _NLIB, _NATIVE_OK
    if not _CTYPES_OK or _REG_BUF is None:
        _log("Block#3: ctypes/shared-реестр недоступен — натив отключён (tid=Java id)")
        return
    if not _SO_ARM64:
        _log("Block#3: .so не вшит (_SO_ARM64 пуст) — запусти embed_so.py; натив отключён")
        return
    try:
        path = _b3_extract_so()
        if not path:
            return
        try:
            jclass("java.lang.System").load(path)
            _log("Block#3 System.load OK (namespace-load удался)")
        except Exception as e:
            _es = str(e)
            if ("getClassLoader" in _es) or ("null object reference" in _es):
                _log("Block#3 System.load: рефлексивный вызов без Java-caller — ожидаемо, .so грузится через ctypes.CDLL (не ошибка)")
            else:
                _log(f"Block#3 System.load warn: {_es}")
        lib = ctypes.CDLL(path)
        _b3_decl(lib)
        try:
            _abi = int(lib.cd_abi_version()) if hasattr(lib, "cd_abi_version") else None
        except Exception:
            _abi = None
        if _abi != _SO_ABI_EXPECT:
            globals()["_ABI_FAIL"] = True
            _log("Block#3 ABI MISMATCH .so=%s expected %d -- native disabled, plugin inert (+DT)" % (str(_abi), _SO_ABI_EXPECT))
            _NLIB = None; _NATIVE_OK = False
            return
        globals()["_SO_ABI_SEEN"] = int(_abi)
        try: _log("Block#3 +HS: native .so ABI=%d OK (expected %d) -- native active" % (int(_abi), _SO_ABI_EXPECT))
        except Exception: pass
        try: _log("Block#3 native build rev=%s" % (str(int(lib.cd_build_rev())) if hasattr(lib, "cd_build_rev") else "<absent: old .so>"))
        except Exception: pass
        info = registry_info()
        rc = int(lib.cd_init(ctypes.c_uint64(info["addr"]), int(info["slots"]), int(info["slot_bytes"])))
        if rc != 0:
            _log(f"Block#3 cd_init FAIL rc={rc} — натив отключён")
            return
        hooks = int(lib.cd_start())
        if hooks < 0:
            _log(f"Block#3 cd_start FAIL rc={hooks} — натив отключён")
            try: lib.cd_stop()
            except Exception: pass
            _NLIB = None; _NATIVE_OK = False
            return
        _NLIB = lib; _NATIVE_OK = True
        try:
            _sm = bool(globals().get("_SAFE_MODE", False))
            if hasattr(lib, "cd_set_safe_mode"):
                lib.cd_set_safe_mode(1 if _sm else 0)
                _log("Block#3 +QI: native safe-mode gate -> %s (raw-kernel SIGSEGV reclaim %s)" % (("ON" if _sm else "OFF"), ("ОТКЛЮЧЁН — детектор остаётся ПОЗАДИ ART через libsigchain" if _sm else "включён")))
            elif _sm:
                _log("Block#3 +QI: safe-mode ON, но .so без cd_set_safe_mode — пересобери/встрой свежий libculprit.so (rev>=10477), иначе raw-kernel SIGSEGV reclaim НЕ будет отключён")
        except Exception as _esm:
            _log("Block#3 +QI safe-mode set err: %s" % _esm)
        try:
            if hasattr(lib, "cd_thread_sig_unblock_total"):
                _log("Block#3 +QM: анблок фатальных сигналов на новых потоках активен (unblocked=%d) -- синхронный фолт на потоке кодека попадёт в наш хендлер вместо тихого force-default" % int(lib.cd_thread_sig_unblock_total()))
            else:
                _log("Block#3 +QM: .so без cd_thread_sig_unblock_* (rev<10478) -- фолт на потоке хоста с заблокированным SIGSEGV останется тихим; пересобери/встрой свежий libculprit.so")
        except Exception as _eqm:
            _log("Block#3 +QM thread-sig-unblock diag err: %s" % _eqm)
        try:
            if _NA_NATIVE_OK and _NA_SAMPLE_ENABLE and hasattr(lib, "cd_na_enable"):
                lib.cd_na_enable(1, int(_NA_MIN_BYTES))
                _log("Block#3S native alloc-site capture: ON min=%d" % int(_NA_MIN_BYTES))
                try: _na_mark_epoch()
                except Exception: pass
        except Exception as _ena:
            _log("Block#3S cd_na_enable err: %s" % _ena)
        _b4c_init(lib)
        try:
            _b19_init(lib)
        except Exception as _e19:
            _log(f"Block#19 init err: {_e19}")
        try:
            _b26_init(lib)
        except Exception as _e26:
            _log(f"Block#26 init err: {_e26}")
        try:
            _b30_init(lib)
        except Exception as _e30kg:
            _log(f"Block#30 init err: {_e30kg}")
        try:
            _b31_init(lib)
        except Exception as _e31fg:
            _log(f"Block#31 init err: {_e31fg}")
        _log(f"Block#3 натив загружен: {path}")
        _log(f"Block#3 cd_init OK (reg=0x{info['addr']:x} slots={info['slots']} slot={info['slot_bytes']}B), хуков malloc={hooks}")
        if hooks <= 0:
            _log("Block#3 ⚠ ноль хуков — sh не перехватил libc (проверь sh)")
    except Exception as e:
        _NLIB = None; _NATIVE_OK = False
        _log(f"Block#3 load err: {e}")

def _so_features_str():
    g = globals()
    flags = [("OOM", "_OOM_NATIVE_OK"), ("ANR", "_ANR_NATIVE_OK"),
             ("GREF", "_GREF_NATIVE_OK"), ("OP", "_OP_NATIVE_OK"),
             ("SCOPE", "_SCOPE_OK"), ("TRIM", "_TRIM_NATIVE_OK"),
             ("LOWMEM", "_LOWMEM_NATIVE_OK"), ("WD", "_WD_NATIVE_OK")]
    try:
        return "  ".join("%s:%s" % (lbl, "on" if g.get(v) else "off") for lbl, v in flags)
    except Exception:
        return ""

def _so_health():
    exp = _SO_ABI_EXPECT
    if not _NATIVE_OK or _NLIB is None:
        return {"ok": False, "state": "not_loaded", "abi": None, "expect": exp}
    abi = None
    try:
        if hasattr(_NLIB, "cd_abi_version"):
            abi = int(_NLIB.cd_abi_version())
    except Exception:
        abi = None
    if abi is None:
        return {"ok": False, "state": "stale", "abi": None, "expect": exp}
    if abi != exp:
        return {"ok": False, "state": "abi_mismatch", "abi": abi, "expect": exp}
    return {"ok": True, "state": "ok", "abi": abi, "expect": exp}


def native_mem_snapshot(top=5):
    d = _direct_snapshot()
    if not _NATIVE_OK or _NLIB is None:
        if not d["live_by_pid"] and d["total"] == 0:
            return None
        _pairs_src = dict(d["live_by_pid"])
        if int(d["live_untagged"]) > 0: _pairs_src["⟨untagged⟩"] = int(d["live_untagged"])
        pairs = sorted(_pairs_src.items(), key=lambda kv: kv[1], reverse=True)
        return {
            "total": 0, "untagged": 0, "dropped": 0, "dropped_bytes": -1, "live": 0,
            "direct_total": d["total"], "direct_untagged": d["untagged"],
            "direct_live_total": d["live_total"], "direct_live_untagged": d["live_untagged"],
            "top": pairs[:top],
        }
    try:
        n = len(_IDX_PID)
        arr = (ctypes.c_int64 * max(n, 1))()
        _NLIB.cd_snapshot(arr, n)
        combined = {}
        for i in range(n):
            pid = _resolve_idx(i) or f"idx{i}"
            combined[pid] = combined.get(pid, 0) + int(arr[i])
        for pid, b in d["live_by_pid"].items():
            combined[pid] = combined.get(pid, 0) + int(b)
        _unt = int(d["live_untagged"]) + int(_NLIB.cd_untagged())
        if _unt > 0: combined["⟨untagged⟩"] = combined.get("⟨untagged⟩", 0) + _unt
        pairs = sorted(combined.items(), key=lambda kv: kv[1], reverse=True)
        return {
            "total": int(_NLIB.cd_total()), "untagged": int(_NLIB.cd_untagged()),
            "dropped": int(_NLIB.cd_dropped()), "dropped_bytes": (int(_NLIB.cd_dropped_bytes()) if hasattr(_NLIB,'cd_dropped_bytes') else -1), "live": int(_NLIB.cd_live_count()),
            "direct_total": d["total"], "direct_untagged": d["untagged"],
            "direct_live_total": d["live_total"], "direct_live_untagged": d["live_untagged"],
            "top": pairs[:top],
        }
    except Exception:
        return None

class _CrumbFile:
    NAME = "last_breadcrumb.txt"
    def __init__(self):
        self.path = None; self._lock = threading.Lock()
        try:
            d = File(_DIR)
            if not d.exists(): d.mkdirs()
            self.path = File(d, self.NAME).getAbsolutePath()
        except Exception as e:
            _log(f"crumb init err: {e}")
    def read_prev(self):
        try:
            if self.path and os.path.exists(self.path):
                with open(self.path, "r", encoding="utf-8") as f:
                    return f.read().strip()
        except Exception: pass
        return None
    def write(self, pid, where):
        if not self.path: return
        with self._lock:
            try:
                with open(self.path, "w", encoding="utf-8") as f:
                    f.write(f"{pid}\t{where}\t{int(time.time()*1000)}"); f.flush()
            except Exception: pass
_CRUMB = None

_B34_WAL_NAME = "load_wal.json"
_B34_PID_NAME = "boot_pid.json"
_B34_SEEN_NAME = "exitinfo_seen.json"
_B34_VERDICT_NAME = "exitinfo_verdict.json"
_B34_GRACE_MS = 20000
_B34_WAL_LOCK = threading.Lock()
_B34_WAL_TIMER = [None]
_B34_WAL_SEQ = [0]
_B34_WIN_LOADING_MS = 300000
_B34_WIN_LOADED_MS = 30000
_B34_WIN_SKEW_MS = 2000
_B34_EARLY_NAME = "early_deaths.json"
_B34_EARLY_MS = 60000
_JAVA_OOM_WIN_MS = 3600000
_B34_OOM_WIN_MS = 900000
_B34_RESKILL_OOM_WIN_MS = 21600000
_B34_EARLY_STREAK_TTL_MS = 90000
_B34_SELF_IDS = frozenset(("culprit_detector", "__regtest__"))
_B34_REASONS = {0: "UNKNOWN", 1: "EXIT_SELF", 2: "SIGNALED", 3: "LOW_MEMORY", 4: "CRASH(Java)", 5: "CRASH_NATIVE", 6: "ANR", 7: "INITIALIZATION_FAILURE", 8: "PERMISSION_CHANGE", 9: "EXCESSIVE_RESOURCE_USAGE", 10: "USER_REQUESTED", 11: "USER_STOPPED", 12: "DEPENDENCY_DIED", 13: "OTHER", 14: "FREEZER", 15: "PACKAGE_STATE_CHANGE", 16: "PACKAGE_UPDATED"}
_B34_SIGNALS = {4: "SIGILL", 5: "SIGTRAP", 6: "SIGABRT", 7: "SIGBUS", 8: "SIGFPE", 9: "SIGKILL", 11: "SIGSEGV", 15: "SIGTERM"}
_EXIT_IMP_NAMES = {100: "foreground", 125: "foreground_service", 200: "visible", 230: "perceptible", 300: "service", 325: "top_sleeping", 350: "cant_save_state", 400: "cached", 1000: "gone"}
_EXIT_BG_IMP = 400

def _exitinfo_mem_fields(ei):
    out = {}
    try:
        _pss = int(ei.getPss())
        if _pss > 0: out["exit_pss_kb"] = _pss
    except Exception: pass
    try:
        _rss = int(ei.getRss())
        if _rss > 0: out["exit_rss_kb"] = _rss
    except Exception: pass
    try:
        imp = int(ei.getImportance())
        out["exit_importance"] = imp
        out["exit_importance_name"] = _EXIT_IMP_NAMES.get(imp, str(imp))
        out["exit_foreground"] = imp <= 200
    except Exception: pass
    return out

def _exitinfo_mem_str(f):
    parts = []
    try:
        if f.get("exit_pss_kb"): parts.append("PSS=%.0f МБ" % (int(f["exit_pss_kb"]) / 1024.0))
        if f.get("exit_rss_kb"): parts.append("RSS=%.0f МБ" % (int(f["exit_rss_kb"]) / 1024.0))
        if "exit_importance" in f:
            parts.append("важность=%s/%s (%s)" % (f["exit_importance"], f.get("exit_importance_name"), "на экране" if f.get("exit_foreground") else "в фоне"))
    except Exception: pass
    return ", ".join(parts)

def _exitinfo_latest(max_age_ms=600000, own_only=True, limit=8):
    try:
        sdk = int(getattr(jclass("android.os.Build$VERSION"), "SDK_INT", 0))
        if sdk < 30: return None
        ctx = _app_context()
        if ctx is None: return None
        am = ctx.getSystemService("activity")
        pkg = str(ctx.getPackageName())
        lst = am.getHistoricalProcessExitReasons(pkg, 0, int(limit))
        n = int(lst.size()) if lst is not None else 0
        now = int(time.time() * 1000); best = None; bts = 0
        for i in range(n):
            try:
                ei = lst.get(i)
                if own_only and str(ei.getProcessName()) != pkg: continue
                ts = int(ei.getTimestamp())
                if now - ts > max_age_ms or ts <= bts: continue
                best = ei; bts = ts
            except Exception: pass
        return best
    except Exception:
        return None

_B34_BLAMELESS = {3, 8, 10, 11, 12, 14, 15, 16}
def _b34_path(name):
    try:
        d = File(_DIR)
        if not d.exists(): d.mkdirs()
        return File(d, name).getAbsolutePath()
    except Exception:
        return None
def _b34_read_json(name):
    try:
        p = _b34_path(name)
        if p and os.path.exists(p):
            with open(p, "r", encoding="utf-8") as f:
                return json.load(f)
    except Exception: pass
    return None
def _b34_clear(name):
    try:
        p = _b34_path(name)
        if p and os.path.exists(p): os.remove(p)
    except Exception: pass
_B34_WAL_STACK = []
def _b34_wal_persist_locked():
    p = _b34_path(_B34_WAL_NAME)
    if not p: return
    try:
        if not _B34_WAL_STACK:
            if os.path.exists(p): os.remove(p)
            return
        tmp = "%s.tmp.%d" % (p, os.getpid())
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump({"seq": _B34_WAL_SEQ[0], "stack": list(_B34_WAL_STACK)}, f)
            f.flush(); os.fsync(f.fileno())
        os.replace(tmp, p)
    except Exception as e:
        _log("B34 wal write err: %s" % e)
def _b34_wal_push(pid):
    with _B34_WAL_LOCK:
        if _B34_WAL_STACK and _B34_WAL_STACK[-1].get("pid") == pid and _B34_WAL_STACK[-1].get("phase") == "loading":
            _B34_WAL_STACK[-1]["ts"] = int(time.time() * 1000)
            _B34_WAL_STACK[-1]["depth"] = int(_B34_WAL_STACK[-1].get("depth", 1)) + 1
            _b34_wal_persist_locked()
            return
        _B34_WAL_SEQ[0] += 1
        _B34_WAL_STACK.append({"pid": pid, "phase": "loading", "ts": int(time.time() * 1000)})
        _b34_wal_persist_locked()
def _b34_wal_mark_loaded(pid):
    with _B34_WAL_LOCK:
        _B34_WAL_SEQ[0] += 1
        for e in reversed(_B34_WAL_STACK):
            if e.get("pid") == pid and e.get("phase") == "loading":
                if int(e.get("depth", 1)) > 1:
                    e["depth"] = int(e.get("depth", 1)) - 1
                else:
                    e["phase"] = "loaded"; e["ts"] = int(time.time() * 1000)
                break
        else:
            for e in reversed(_B34_WAL_STACK):
                if e.get("pid") == pid and e.get("phase") == "loaded":
                    e["ts"] = int(time.time() * 1000)
                    break
            else:
                _B34_WAL_STACK.append({"pid": pid, "phase": "loaded", "ts": int(time.time() * 1000)})
        _b34_wal_persist_locked()
    _b34_wal_schedule_sweep(None)
def _b34_wal_pop_fail(pid):
    with _B34_WAL_LOCK:
        _B34_WAL_SEQ[0] += 1
        for i in range(len(_B34_WAL_STACK) - 1, -1, -1):
            if _B34_WAL_STACK[i].get("pid") == pid:
                if int(_B34_WAL_STACK[i].get("depth", 1)) > 1:
                    _B34_WAL_STACK[i]["depth"] = int(_B34_WAL_STACK[i].get("depth", 1)) - 1
                else:
                    del _B34_WAL_STACK[i]
                break
        _b34_wal_persist_locked()
def _b34_wal_sweep():
    nxt = None
    with _B34_WAL_LOCK:
        now = int(time.time() * 1000)
        keep = []; changed = False
        for e in _B34_WAL_STACK:
            if e.get("phase") == "loaded":
                try: left = _B34_GRACE_MS - (now - int(e.get("ts", 0)))
                except Exception: left = 0
                if left <= 0:
                    changed = True
                    continue
                if nxt is None or left < nxt: nxt = left
            keep.append(e)
        if changed:
            _B34_WAL_SEQ[0] += 1
            del _B34_WAL_STACK[:]
            _B34_WAL_STACK.extend(keep)
            _b34_wal_persist_locked()
    if nxt is not None:
        _b34_wal_schedule_sweep(nxt)
def _b34_wal_schedule_sweep(delay_ms):
    try:
        t = _B34_WAL_TIMER[0]
        if t is not None:
            try: t.cancel()
            except Exception: pass
        d = (_B34_GRACE_MS if delay_ms is None else max(250, int(delay_ms))) / 1000.0
        t = threading.Timer(d, _b34_wal_sweep)
        t.daemon = True
        _B34_WAL_TIMER[0] = t
        t.start()
    except Exception as e:
        _log("B34 wal timer err: %s" % e)
def _b34_reason_str(code, status):
    r = _B34_REASONS.get(code, "reason=%s" % code)
    try:
        if code == 2:
            r += " (%s)" % _B34_SIGNALS.get(status, "sig=%s" % status)
        elif code == 1:
            r += " (exit=%s)" % status
    except Exception: pass
    return r
def _b34_early_note(ets, cands, reason=None, status=None):
    streak = 1
    try:
        ed = _b34_read_json(_B34_EARLY_NAME) or {}
        old = ed.get("plugins") or []
        fresh = True
        try: fresh = (int(ets) - int(ed.get("last_ts", 0) or 0)) <= _B34_EARLY_STREAK_TTL_MS
        except Exception: pass
        if int(ed.get("count", 0)) > 0 and fresh and set(old) == set(cands or []) and ed.get("exit_reason") == reason and ed.get("exit_status") == status:
            streak = int(ed.get("count", 0)) + 1
    except Exception: pass
    try: _atomic_json_write(_b34_path(_B34_EARLY_NAME), {"count": streak, "last_ts": int(ets), "plugins": list(cands or []), "exit_reason": reason, "exit_status": status})
    except Exception: pass
    return streak
_B34_ANR_CORR_WINDOW_MS = 45000
def _b34_anr_host_correlate(ets, prev_boot_ts):
    if ets is None: return None
    lo = int(ets) - _B34_ANR_CORR_WINDOW_MS; hi = int(ets) + _B34_WIN_SKEW_MS
    floor = 0
    try:
        if prev_boot_ts and int(prev_boot_ts) > 0: floor = int(prev_boot_ts) - _B34_WIN_SKEW_MS
    except Exception: pass
    best = None; best_ts = -1; best_m = None; best_m_ts = -1
    for _kind, _pf in (("host_stall", lambda: _oom_path(_HOST_STALL_FILE_NAME)), ("anr_verdict", _b20_anr_path)):
        try:
            p = _rc_read_path(_pf())
            if not p: continue
            with open(p, "r", encoding="utf-8") as f: _obj = json.load(f)
            if isinstance(_obj, list): recs = _obj
            elif isinstance(_obj, dict): recs = [_obj]
            else: continue
        except Exception: continue
        for r in recs:
            if not isinstance(r, dict) or not bool(r.get("had_anr")): continue
            try: rts = int(r.get("ts", 0))
            except Exception: continue
            if rts <= 0 or rts < lo or rts > hi: continue
            if floor and rts < floor: continue
            r = dict(r); r["_corr_file"] = _kind
            _c = r.get("culprit")
            if rts > best_ts: best = r; best_ts = rts
            if isinstance(_c, str) and _c.strip() and _c not in ("unknown", "host/idle", "none", "none (intentional restart)") and rts > best_m_ts:
                best_m = r; best_m_ts = rts
    return best_m if best_m is not None else best

def _b34_instrumentation_owner(soname):
    low = (soname or "").lower()
    if ("engine_fuzzer" in low) or ("enginefuzzer" in low):
        return "engine_fuzzer"
    if "frida" in low:
        return "frida"
    for _m in ("substrate", "libxposed", "riru", "zygisk", "gum-js"):
        if _m in low:
            return _m
    return None

def _ef_registered_name():
    try:
        with _INTERN_LOCK:
            _names = list(_IDX_PID)
    except Exception:
        _names = []
    for _nm in _names:
        if isinstance(_nm, str) and _b34_instrumentation_owner(_nm) == "engine_fuzzer":
            return _nm
    try:
        _p = _idxnames_path()
        if _p:
            with open(_p, "r", encoding="utf-8") as _f:
                _m = json.load(_f)
            if isinstance(_m, dict):
                for _v in _m.values():
                    if isinstance(_v, str) and _b34_instrumentation_owner(_v) == "engine_fuzzer":
                        return _v
    except Exception:
        pass
    return None


def _b34_native_so_correlate(ets, status):
    try:
        tb = _parse_debuggerd_tombstone(signo=status, crash_ts=ets)
    except Exception:
        tb = None
    if not isinstance(tb, dict):
        return None
    frames = tb.get("frames") or []
    if not frames:
        return None
    wild = (tb.get("code") == -1)
    instr = None; instr_path = None; priv = None; priv_path = None
    for fr in frames:
        mod = (fr.get("module") or ""); low = mod.lower()
        if (not mod) or mod == "<unknown>" or mod.startswith("[anon") or mod.startswith("/memfd") or ("jit-cache" in low) or ("dalvik" in low):
            wild = True; continue
        soname = mod.rsplit("/", 1)[-1]
        own = _b34_instrumentation_owner(soname)
        if own and instr is None:
            instr = own; instr_path = mod
        if priv is None and ("/data/" in mod) and low.endswith(".so") and ("/lib/" not in low):
            priv = soname; priv_path = mod
    if instr is not None:
        if instr == "frida" and wild:
            _efn2 = _ef_registered_name()
            if _efn2:
                instr = "engine_fuzzer"
        return {"culprit": instr, "confidence": "medium" if wild else "low",
                "attribution": bool(wild), "culprit_kind": "native_instrumentation",
                "so_path": instr_path, "wild_branch": bool(wild),
                "tombstone_code": tb.get("code"), "match_score": tb.get("match_score")}
    if priv is not None:
        return {"culprit": "<so:%s>" % priv, "confidence": "low",
                "attribution": False, "culprit_kind": "native_so_suspect",
                "so_path": priv_path, "wild_branch": bool(wild),
                "tombstone_code": tb.get("code"), "match_score": tb.get("match_score")}
    return None


def _b4c_instrumentation_frame_scan(frames):
    if not frames:
        return None
    _TRAMPO = ("libsigchain", "frida-gadget", "libfrida", "frida", "gum-js", "[vdso]", "vdso")
    _TOP_N = 6
    agents = []
    top_owner = None; top_idx = None; top_path = None
    ef_seen = False; tramp = False; fault_soname = None
    idx = -1
    for _fr in frames:
        if not isinstance(_fr, str):
            continue
        idx += 1
        _mod = ""
        for _t in _fr.split():
            if _t.startswith("#") or _t.startswith("pc="):
                continue
            _mod = _t; break
        low = _mod.lower()
        _soname = _mod.split("+", 1)[0].rsplit("/", 1)[-1]
        if idx == 0 and _soname:
            fault_soname = _soname
        if any(_m in low for _m in _TRAMPO):
            tramp = True
        own = _b34_instrumentation_owner(_soname)
        if own:
            if own not in agents:
                agents.append(own)
            if own == "engine_fuzzer":
                ef_seen = True
            if top_owner is None and idx <= _TOP_N:
                top_owner = own; top_idx = idx; top_path = _mod
    if top_owner is None:
        return None
    _immediate = (top_idx is not None and top_idx <= 1)
    if not (tramp or _immediate):
        return None
    owner = "engine_fuzzer" if ef_seen else top_owner
    ef_promoted = False
    if (not ef_seen) and top_owner == "frida" and tramp:
        _efn = _ef_registered_name()
        if _efn:
            owner = "engine_fuzzer"; ef_promoted = True
    strong = (ef_seen or ef_promoted) and (tramp or _immediate)
    return {"owner": owner, "agents": agents, "frame_idx": top_idx,
            "so_path": top_path, "trampoline": bool(tramp),
            "confidence": "high" if strong else "medium",
            "ef_promoted": bool(ef_promoted),
            "fault_soname": fault_soname}


def _b34_oom_correlate(ets, prev_boot_ts, win_ms=None):
    if ets is None:
        return None
    _dir = None
    try:
        _probe = _oom_path("oom_dump_probe.json")
        if _probe: _dir = os.path.dirname(_probe)
    except Exception:
        _dir = None
    _cands = []
    if _dir:
        try:
            for _fn in os.listdir(_dir):
                if not (_fn.startswith("oom_dump_") and _fn.endswith(".json")):
                    continue
                _mid = _fn[len("oom_dump_"):-len(".json")]
                if not _mid.isdigit():
                    continue
                _dts = int(_mid)
                if _dts > int(ets) + _B34_WIN_SKEW_MS:
                    continue
                if (int(ets) - _dts) > (win_ms if win_ms is not None else _B34_OOM_WIN_MS):
                    continue
                if prev_boot_ts and prev_boot_ts > 0 and _dts < prev_boot_ts - _B34_WIN_SKEW_MS:
                    continue
                _cands.append((_dts, os.path.join(_dir, _fn)))
        except Exception:
            pass
    _cands.sort(key=lambda x: x[0], reverse=True)
    _named = []
    for _dts, _pth in _cands:
        try:
            with open(_pth, "r", encoding="utf-8") as _f:
                _rec = json.load(_f)
        except Exception:
            continue
        if not isinstance(_rec, dict):
            continue
        _ov = _rec.get("verdict") if isinstance(_rec.get("verdict"), dict) else None
        if _ov is None:
            try: _ov = _oom_verdict(_rec)
            except Exception: _ov = None
        if not isinstance(_ov, dict):
            continue
        _cul = _ov.get("culprit")
        if not (isinstance(_cul, str) and _cul):
            continue
        if _cul == _UNTAGGED_LABEL or _oom_untagged_alias(_cul):
            continue
        if _cul in _B34_SELF_IDS or _cul in (_SELF_ID, __id__, "unknown", "client (host process)"):
            continue
        _named.append((_dts, _cul, _ov))
    if _named:
        _dts0, _cul0, _ov0 = _named[0]
        _consensus = sum(1 for _x in _named if _x[1] == _cul0)
        _ef = (_b34_instrumentation_owner(_cul0) == "engine_fuzzer")
        _ov_conf = str(_ov0.get("confidence") or "low")
        _ov_rd = str(_ov0.get("reason_detail") or "")
        _conf = _ov_conf
        if _conf == "low":
            _conf = "medium"
        if _consensus >= 2 and (_ef or _ov_rd in ("clear_leader", "probable_leader", "globalref_native", "growth_leader")):
            _conf = "high"
        return {"culprit": _cul0, "confidence": _conf, "attribution": True,
                "culprit_kind": "plugin", "src": "oom_verdict",
                "reason_detail": (_ov_rd or "resource_kill_oom_verdict"),
                "oom_confidence": _ov_conf, "consensus": _consensus,
                "instrumentation_agent": _ef,
                "top_named_bytes": int(_ov0.get("top_named_bytes") or _ov0.get("culprit_bytes") or 0),
                "untagged_bytes": int(_ov0.get("untagged_bytes") or 0),
                "dump_ts": _dts0, "dump_delta_ms": int(ets) - int(_dts0)}
    try:
        _nep = _oom_path("oom_native_emit.json")
        if _nep and os.path.exists(_nep):
            with open(_nep, "r", encoding="utf-8") as _f:
                _ne = json.load(_f)
            if isinstance(_ne, dict):
                _ti = _ne.get("top_idx")
                _nm = _resolve_idx_durable(_ti) if _ti is not None else None
                if isinstance(_nm, str) and _nm and _nm not in _B34_SELF_IDS and _nm not in (_SELF_ID, __id__):
                    _tb = int(_ne.get("top_bytes") or 0)
                    _tot = int(_ne.get("total") or 0)
                    _unt = int(_ne.get("untagged") or 0)
                    _tagged = _tot - _unt
                    _tsh = (float(_tb) / float(_tagged)) if _tagged > 0 else 0.0
                    _ef = (_b34_instrumentation_owner(_nm) == "engine_fuzzer")
                    if _tb >= 8388608 and (_tsh >= 0.50 or _ef):
                        return {"culprit": _nm, "confidence": ("high" if _ef else "medium"),
                                "attribution": True, "culprit_kind": "plugin",
                                "src": "oom_native_emit", "reason_detail": "resource_kill_top_native",
                                "top_bytes": _tb, "tagged_share": round(_tsh, 4),
                                "instrumentation_agent": _ef, "consensus": 1}
    except Exception:
        pass
    return None

def _oom_crash_correlate(crash_ts):
    if crash_ts is None:
        return None
    _boot = 0
    try:
        _bp = _b34_read_json(_B34_PID_NAME)
        if isinstance(_bp, dict):
            _boot = int(_bp.get("ts", 0) or 0)
    except Exception:
        _boot = 0
    if _boot <= 0:
        try: _boot = int(_RC_PROC_START * 1000)
        except Exception: _boot = 0
    try:
        return _b34_oom_correlate(int(crash_ts), _boot, win_ms=_JAVA_OOM_WIN_MS)
    except Exception:
        return None

def _b34_read_json_dur(name):
    try:
        _p = _b34_path(name)
        if _p and os.path.exists(_p):
            with open(_p, "r", encoding="utf-8") as _f:
                d = json.load(_f)
            if isinstance(d, dict): return d
    except Exception:
        pass
    best = None
    try:
        for d in _mn_read_json_both(_b34_path(name)):
            if not isinstance(d, dict): continue
            try: t = int(d.get("ts", 0))
            except Exception: t = 0
            if best is None or t > int(best.get("ts", 0) or 0): best = d
    except Exception:
        pass
    return best
def _b34_write_dur(name, obj):
    _p = _b34_path(name)
    if _p: _atomic_json_write(_p, obj)
    try:
        _mp = _aw_mirror_path(_p) if _p else None
        if _mp: _atomic_json_write(_mp, obj)
    except Exception:
        pass
def _b34_boot_postmortem(fresh_verdict=None):
    
    
    
    
    wal = _b34_read_json(_B34_WAL_NAME)
    prev = _b34_read_json_dur(_B34_PID_NAME)
    _b34_clear(_B34_WAL_NAME)
    cur_pid = int(os.getpid())
    
    same_process = False
    try:
        same_process = (prev is not None and int(prev.get("pid", -1)) == cur_pid)
    except Exception: pass
    
    prev_boot_ts = 0
    try:
        if prev is not None: prev_boot_ts = int(prev.get("ts", 0))
    except Exception: pass
    try:
        _b34_write_dur(_B34_PID_NAME, {"pid": cur_pid, "ts": int(time.time() * 1000)})
    except Exception as e:
        _log("B34 boot-pid write err: %s" % e)
    best = None; nrec = -1
    try:
        ctx = _app_context()
        sdk = 0
        try: sdk = int(getattr(jclass("android.os.Build$VERSION"), "SDK_INT", 0))
        except Exception: pass
        if ctx is None:
            _log("B34: контекст недоступен -- ExitInfo пропущен")
        elif sdk < 30:
            _log("B34: API %s < 30 -- ApplicationExitInfo недоступен" % sdk)
        else:
            am = ctx.getSystemService("activity")
            pkg = str(ctx.getPackageName())
            lst = am.getHistoricalProcessExitReasons(pkg, 0, 16)
            nrec = int(lst.size()) if lst is not None else 0
            seen = _b34_read_json_dur(_B34_SEEN_NAME) or {}
            try: last_seen = int(seen.get("ts", 0))
            except Exception: last_seen = 0
            prev_pid = -1
            try:
                if prev is not None: prev_pid = int(prev.get("pid", -1))
            except Exception: pass
            for i in range(nrec):
                ei = lst.get(i)
                try:
                    
                    if str(ei.getProcessName()) != pkg: continue
                    ts = int(ei.getTimestamp())
                    if ts <= last_seen: continue
                    if prev_pid > 0 and int(ei.getPid()) != prev_pid: continue
                    if best is None or ts > int(best.getTimestamp()): best = ei
                except Exception: pass
    except Exception as e:
        _log("B34 ExitInfo query err: %s" % e)
    if same_process and best is None:
        
        _log("B34: reload детектора в том же процессе (pid=%s) -- смерти не было%s" % (cur_pid, ", stale WAL снят" if wal is not None else ""))
        return
    
    culprit = None; phase = None; wal_ts = 0
    stack = None
    if isinstance(wal, dict):
        if isinstance(wal.get("stack"), list):
            stack = wal.get("stack")
        elif wal.get("pid"):
            stack = [wal]
    if stack:
        act = None; lastl = None
        for e in stack:
            try:
                if e.get("phase") == "loading": act = e
                if e.get("phase") == "loaded" and (lastl is None or int(e.get("ts", 0)) >= int(lastl.get("ts", 0))): lastl = e
            except Exception: pass
        pick = act if act is not None else lastl
        
        
        _sd_batch = []
        if act is None and lastl is not None:
            try:
                _lts = int(lastl.get("ts", 0))
                for e in stack:
                    _p = str(e.get("pid") or "")
                    if e.get("phase") == "loaded" and _p and _p not in _B34_SELF_IDS and _p not in _sd_batch and abs(_lts - int(e.get("ts", 0))) <= _B34_WIN_LOADED_MS:
                        _sd_batch.append(_p)
            except Exception: _sd_batch = []
        if pick is not None:
            try:
                culprit = str(pick.get("pid") or "") or None
                phase = str(pick.get("phase") or "?")
                wal_ts = int(pick.get("ts", 0))
            except Exception: pass
    if best is None and culprit is None:
        if nrec >= 0:
            _log("B34 ExitInfo: свежих записей о прошлой сессии нет (records=%s), WAL чист" % nrec)
        return
    
    v = {"src": "exitinfo/b34", "event_type": "process_exit_postmortem", "correlation_kind": "load_window", "process_scoped": True, "ts": int(time.time() * 1000), "detector_version": __version__}
    try: v["safe_mode"] = globals().get("_PREV_SESSION_SAFE_MODE", None)   
    except Exception: v["safe_mode"] = None
    code = -1; status = 0; ets = None
    if best is not None:
        try:
            code = int(best.getReason()); status = int(best.getStatus())
            ets = int(best.getTimestamp())
            try: _b34_write_dur(_B34_SEEN_NAME, {"ts": ets})
            except Exception: pass
            rs = _b34_reason_str(code, status)
            desc = ""
            try: desc = str(best.getDescription() or "")
            except Exception: pass
            _log("=========== POST-MORTEM ПРОШЛОЙ СЕССИИ (Block#34, ExitInfo) ===========")
            _log("процесс (pid=%s) завершён: %s" % (int(best.getPid()), rs))
            if desc: _log("  описание системы: %s" % desc[:220])
            v["exit_reason"] = rs; v["exit_code"] = code; v["exit_status"] = status
            v["exit_ts"] = ets; v["exit_desc"] = desc[:220]; v["exit_pid"] = int(best.getPid())
            
            try:
                _emf = _exitinfo_mem_fields(best); v.update(_emf)
                _ems = _exitinfo_mem_str(_emf)
                if _ems: _log("  в момент смерти: %s" % _ems)
            except Exception: pass
        except Exception as e:
            _log("B34 ExitInfo decode err: %s" % e)
    else:
        _log("=========== POST-MORTEM ПРОШЛОЙ СЕССИИ (Block#34, WAL) ===========")
        _log("причина смерти системой не сообщена (ExitInfo пуст/недоступен)")
        v["exit_reason"] = "unknown"
    if best is not None and code in (2, 5):
        
        
        
        
        
        try:
            import re as _re_qo
            _sdk_qo = 0
            try: _sdk_qo = int(getattr(jclass("android.os.Build$VERSION"), "SDK_INT", 0))
            except Exception: pass
            if _sdk_qo >= 31:
                _tis = best.getTraceInputStream()
                if _tis is not None:
                    try:
                        _raws = ""
                        _sc = jclass("java.util.Scanner")(_tis, "ISO-8859-1").useDelimiter("\\A")
                        if _sc.hasNext(): _raws = str(_sc.next())
                        _tdata = _raws.encode("latin-1", "replace")
                    finally:
                        try: _tis.close()
                        except Exception: pass
                    _tname = "culprit_exitinfo_trace_%s.pb" % (ets or int(time.time() * 1000))
                    try:
                        with open(_b34_path(_tname), "wb") as _tf:
                            _tf.write(_tdata)
                    except Exception:
                        _tname = None
                    _libs = []
                    try:
                        for _m in _re_qo.findall(rb"[ -~]{6,}", _tdata):
                            _s = _m.decode("ascii", "replace")
                            if (".so" in _s or "/data/" in _s or "/apex/" in _s) and _s not in _libs:
                                _libs.append(_s)
                    except Exception:
                        pass
                    v["native_trace_ref"] = {"bytes": len(_tdata), "saved": _tname, "libs": _libs[:12]}
                    _log("  +QO ExitInfo trace: tombstone protobuf %d байт сохранён (%s); библиотеки: %s" % (len(_tdata), _tname, ", ".join(_libs[:8]) or "нет"))
                else:
                    _log("  +QO ExitInfo trace: getTraceInputStream()=null -- tombstone системой НЕ создан (подавлен владельцем raw-слота, напр. libshadowhook)")
        except Exception as _etr:
            _log("  +QO ExitInfo trace err: %s" % _etr)
    life = None
    if ets is not None and prev_boot_ts > 0:
        _raw_life = int(ets) - prev_boot_ts
        
        
        if _raw_life < -_B34_WIN_SKEW_MS:
            v["lifetime_invalid"] = "exit_before_boot"
            _log("  ExitInfo ts раньше бута прошлой сессии (%s мс) -- lifetime невалиден, ранняя атрибуция пропущена" % _raw_life)
        else:
            life = max(0, _raw_life)
            v["session_lifetime_ms"] = life
            _log("  прошлая сессия прожила ~%s мс" % life)
    benign_self = False
    
    
    
    
    
    
    
    if best is not None and code in (1, 2):
        try:
            
            
            
            _pv = fresh_verdict if isinstance(fresh_verdict, dict) else None
            _pv_src = "fresh"
            if _pv is None:
                _pv_src = "durable"
                _pvp = _rc_read_path(_crash_verdict_durable_path())
                if _pvp:
                    with open(_pvp, "r", encoding="utf-8") as _pvf:
                        _pv = json.load(_pvf)
            if _restart_matches_exit(_pv, code, status, ets):
                _km = str(_pv.get("kill_method") or "")
                if code == 1:
                    try: _sig_ok = (int(_pv.get("kill_arg") or 0) == int(status))
                    except Exception: _sig_ok = False
                else:
                    _sig_ok = (int(status) == 9 and "killProcess" in _km)
                _pts = 0
                try: _pts = int(_pv.get("ts") or 0)
                except Exception: pass
                _d = (int(ets) - _pts) if (ets is not None and _pts > 0) else None
                if _sig_ok and _d is not None and -_B34_WIN_SKEW_MS <= _d <= 15000:
                    benign_self = True
                    v["benign_restart"] = True
                    v["self_kill_plugin"] = _pv.get("crashed_plugin_id")
                    v["benign_match"] = {"kill_method": _km, "kill_arg": _pv.get("kill_arg"), "delta_ms": _d, "src": _pv.get("src"), "verdict_src": _pv_src}
                    _log("  намеренный само-рестарт '%s' (%s(%s), delta=%sms) -- НЕ смерть процесса: карточка и автокап подавлены, серия ранних смертей сброшена" % (_pv.get("crashed_plugin_id"), _km, _pv.get("kill_arg"), _d))
        except Exception as _ebs:
            _log("B34 benign-restart correlate err: %s" % _ebs)
    
    if not benign_self and best is not None:
        try:
            if _restart_permit_matches_exit(globals().get("_PREV_SESSION_RESTART_EVIDENCE"), prev,
                                            code, status, int(best.getPid()), ets):
                benign_self = True
                v.update(benign_restart=True, attribution=False, restart_classification="permit-matched-exit",
                    benign_match={"src": "journal/restart-permit+ExitInfo", "permit_ts": _PREV_SESSION_RESTART_EVIDENCE["permit"]["ts"],
                                  "exit_pid": int(best.getPid()), "exit_status": int(status)})
                _log("B34 +UD: свежий restart permit + совпавшие session/PID/EXIT_SELF(0) -- штатный выход, не crash; старый SELF_KILL не восстанавливается")
        except Exception as _eud:
            _log("B34 +UD restart permit correlate err: %s" % _eud)
    _bg_kill = False
    if best is not None and code == 2 and int(status) == 9 and not benign_self:
        try:
            if int(v.get("exit_importance", 0)) >= _EXIT_BG_IMP:
                _bg_kill = True; v["bg_kill"] = True
                _log("  SIGKILL процесса в фоне (важность=%s/%s) -- системная выгрузка, НЕ ранняя смерть: плагин не обвиняется" % (v.get("exit_importance"), v.get("exit_importance_name")))
        except Exception: pass
    blameless = (code in _B34_BLAMELESS) or benign_self or _bg_kill
    
    
    if best is not None and (blameless or (life is not None and life >= _B34_EARLY_MS)):
        try: _atomic_json_write(_b34_path(_B34_EARLY_NAME), {"count": 0})
        except Exception: pass
    if culprit is not None:
        
        v["load_window_plugin"] = culprit; v["load_window_phase"] = phase
        delta = None; in_window = True
        if ets is not None and wal_ts > 0:
            delta = int(ets) - int(wal_ts)
            v["wal_exit_delta_ms"] = delta
            win = _B34_WIN_LOADING_MS if phase == "loading" else _B34_WIN_LOADED_MS
            in_window = (-_B34_WIN_SKEW_MS <= delta <= win)
        if not in_window:
            v["wal_correlation"] = False; v["wal_rejected"] = "timestamp_out_of_window"
            v["culprit"] = "unknown"; v["confidence"] = "low"; v["attribution"] = False
            if blameless: v["culprit_kind"] = "system"
            _log("  WAL вне окна корреляции: %s (phase=%s, delta=%sms) -- плагин НЕ обвиняется" % (culprit, phase, delta))
        elif blameless:
            
            v["wal_correlation"] = True; v["attribution"] = False
            v["culprit"] = "system/user"; v["culprit_kind"] = "system"; v["confidence"] = "low"
            _log("  blameless-причина; окно загрузки: %s (phase=%s, delta=%sms) -- только контекст" % (culprit, phase, delta))
        else:
            
            v["wal_correlation"] = True
            if phase == "loading":
                
                v["attribution"] = True
                v["culprit"] = culprit
                v["confidence"] = "medium" if best is not None else "low"
                _log("  смерть во время загрузки плагина: %s (delta=%sms, conf=%s)" % (culprit, delta, v["confidence"]))
            else:
                
                streak = 0
                _sd_amb = len(_sd_batch) > 1
                if _sd_amb: v["load_window_batch"] = list(_sd_batch); v["load_window_ambiguous"] = True
                
                
                if best is not None and life is not None and life < _B34_EARLY_MS:
                    streak = _b34_early_note(ets, (sorted(_sd_batch) if _sd_amb else [culprit]), code, status)
                    v["early_boot_death"] = True; v["early_death_streak"] = streak
                if _sd_amb:
                    v["attribution"] = False
                    v["culprit"] = "unknown"; v["confidence"] = "low"
                    _log("  смерть вскоре после пакетной загрузки %d плагинов (последний %s, delta=%sms, подряд=%s) -- порядок загрузки не улика, плагин только контекст" % (len(_sd_batch), culprit, delta, streak))
                elif streak >= 2:
                    v["correlation_kind"] = "early_boot_repeat"
                    v["attribution"] = True; v["culprit"] = culprit; v["confidence"] = "medium"
                    _log("  ПОВТОРЯЮЩАЯСЯ ранняя смерть после загрузки %s: %s-я подряд (delta=%sms) -> culprit, conf=medium" % (culprit, streak, delta))
                else:
                    v["attribution"] = False
                    v["culprit"] = "unknown"; v["confidence"] = "low"
                    _log("  смерть вскоре после успешной загрузки %s (delta=%sms) -- корреляция слабая, плагин только контекст%s" % (culprit, delta, "; при повторе будет атрибутирован" if streak == 1 else ""))
    else:
        v["culprit"] = "unknown"; v["confidence"] = "low"; v["attribution"] = False
        if blameless: v["culprit_kind"] = "system"
        
        
        if best is not None and not blameless and life is not None and life < _B34_EARLY_MS:
            cands = []
            try:
                cands = [p for p in (_load_known() or []) if isinstance(p, str) and p and p not in _B34_SELF_IDS]
            except Exception: pass
            streak = _b34_early_note(ets, cands, code, status)
            v["early_boot_death"] = True; v["early_death_streak"] = streak; v["boot_window_plugins"] = cands
            _log("  РАННЯЯ СМЕРТЬ СЕССИИ: прожила %s мс (подряд: %s)" % (life, streak))
            
            
            
            if len(cands) == 1 and streak >= 2:
                v["correlation_kind"] = "early_boot"; v["attribution"] = True
                v["culprit"] = cands[0]
                v["confidence"] = "medium"
                _log("  подозреваемый: %s (единственный известный сторонний плагин, повтор с той же сигнатурой, conf=medium)" % cands[0])
            elif len(cands) == 1:
                v["boot_window_suspect"] = cands[0]
                _log("  единственный известный сторонний плагин: %s -- только контекст, при повторе с той же сигнатурой будет атрибутирован" % cands[0])
            elif cands:
                _log("  известные сторонние плагины (загрузка хуком не покрыта): %s" % ", ".join(cands))
    
    if best is not None and code == 6 and (not v.get("attribution")) and not benign_self:
        try:
            _hc = _b34_anr_host_correlate(ets, prev_boot_ts)  
            if isinstance(_hc, dict):
                _hcul = _hc.get("culprit") or "unknown"
                _hhost = bool(_hc.get("host_side"))
                _hkind = _hc.get("culprit_kind")
                _hsrc_leg = str(_hc.get("src") or "")  
