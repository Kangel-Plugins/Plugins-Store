                            _log("Block#4C +OD: сигнатура JniAbort-during-dump (strong) -> cause=JNI_ABORT_DURING_DUMP (был %s)" % (rec.get("cause_base") or "?",))
                        elif _od_weak and not _od_have_am:
                            rec["jni_abort_dump_suspect"] = True
