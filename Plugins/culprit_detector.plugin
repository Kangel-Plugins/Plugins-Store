            _log("Block#25P +JD: нативный Handler.enqueueMessage owner-capture=%d (детерминированная привязка осиротевших Runnable)" % n)
            return True
        _log("Block#25P: native post install=%d -> неактивно" % n)
        return False
    except Exception as e:
        _log("Block#25P: native post err: %s -> неактивно" % e)
        return False

def _b25_notif_diag_str():
    try:
        if _NLIB is None or not hasattr(_NLIB, "cd_notif_diag"): return ""
        d = [int(_NLIB.cd_notif_diag(i)) for i in range(5)]
        return " [sh_ierr=%d sh_uerr=%d unhook_fail=%d leftover=%d adopted=%d]" % tuple(d)
