                    _log("  B34 +RQ CRASH(Java) skorrelirovan s crash-verdiktom toj zhe smerti (dt=%dms): culprit=%r conf=%s src=%s" % (_c5dt, _c5id, v["confidence"], _c5v.get("src")))
        except Exception as _erq:
            _log("  B34 +RQ java-crash correlate err: %s" % _erq)
    try:
        if v.get("safe_mode") is True and (not benign_self) and (not v.get("attribution")) and str(v.get("culprit")) in ("unknown", "None", "none"):
            _own_qk = globals().get("_PREV_SESSION_SEGV_OWNER"); _ours_qk = globals().get("_PREV_SESSION_SEGV_OURS")
            v["safe_mode_conclusion"] = "not_detector_host_side"; v["culprit_kind"] = "host/native"
            if _own_qk and _ours_qk is False:
                v["silent_signal_owner"] = _own_qk
                _log("  +QK ВЫВОД: краш при ВКЛЮЧЁННОМ безопасном режиме -- детектор пассивен (инвазивные хуки OFF, raw-kernel SIGSEGV reclaim OFF, за ART через libsigchain), а краш всё равно случился => это НЕ детектор, виновник хост/нативный медиастек. Тихий SIGSEGV: raw-слот держит %s (ours=0, не чейнит) => ни наш хендлер, ни debuggerd не исполняются, поэтому culprit=unknown. Для АТРИБУЦИИ этого краша ВЫКЛЮЧИ безопасный режим (реклейм +QF безопасен: circuit-breaker +QD не даёт шторма)." % _own_qk)
            else:
                _log("  +QK ВЫВОД: краш при ВКЛЮЧЁННОМ безопасном режиме -- детектор пассивен, а краш всё равно случился => это НЕ детектор (виновник хост/нативный слой). Для атрибуции выключи безопасный режим.")
    except Exception as _eqk:
        _log("  +QK safe-mode conclusion err: %s" % _eqk)
    try:
        if code == 2 and status == 11 and (globals().get("_PREV_SESSION_NATIVE_CRASH_SEEN") is False) and (not benign_self) and (not v.get("attribution")) and str(v.get("culprit")) in ("unknown", "None", "none"):
            _own_qn = globals().get("_PREV_SESSION_SEGV_OWNER") or "libshadowhook.so"
            v["silent_native_sigsegv"] = True; v["culprit_kind"] = "host/native"
            v["conclusion"] = "host_media_teardown_sigsegv_not_attributable_in_process"
            v["silent_signal_owner"] = _own_qn
            _log("  +QN ВЫВОД: ТИХИЙ SIGSEGV без NATIVE_CRASH(type-8) и без tombstone -- фолт обошёл наш хендлер. Это host/нативный медиастек (teardown ExoPlayer/Media3 + SurfaceView + c2.qti.avc.decoder в PhotoViewer), НЕ детектор. Тихо потому, что raw-слот SIGSEGV держит %s (raw-syscall, не чейнит в debuggerd) и перехватывает его во время самого teardown -- быстрее watchdog'а. Внутри процесса атрибуция невозможна; fault-PC достижим только ВНЕ shadowhook (сборка без libshadowhook / debuggable + tombstone)." % _own_qn)
    except Exception as _eqn:
        _log("  +QN silent-sigsegv conclusion err: %s" % _eqn)
    try:
        _tqs = globals().get("_PREV_SESSION_TRACER")
        if isinstance(_tqs, list) and _tqs:
            _bestq, _cmod, _wild, _self_n = _trc_select_fatal(_tqs, ets, status)
            if _bestq is not None:
                v["tracer_capture"] = True
                v["tracer_excluded_self"] = _self_n
                v["tracer_wild_branch"] = bool(_wild)
                v["tracer_ref"] = {"sig": _bestq.get("sig"), "si_code": _bestq.get("si_code"), "si_addr": _bestq.get("si_addr"), "pc": _bestq.get("pc"), "tid": _bestq.get("tid"), "comm": _bestq.get("comm"), "is_main": _bestq.get("is_main"), "pc_module": _bestq.get("pc_module"), "pc_off": _bestq.get("pc_off"), "realtime_ms": _bestq.get("realtime_ms"), "frames": (_bestq.get("frames") or [])[:16]}
                if (not benign_self) and (not blameless) and not v.get("attribution"):
                    _jown = _trc_jrn_owner(_bestq)
                    _abrt = _trc_abort_like(_bestq)
                    if _jown:
                        v["culprit"] = _jown["plugin"]
                        v["culprit_kind"] = "plugin"
                        v["confidence"] = _jown["conf"]
                        v["tracer_owner_src"] = "journal-" + _jown["src"]
                        _log("  +RO: tracer-захват совпал с journal NATIVE_CRASH (k=plugin %s idx=%d) -> виновник плагин %r conf=%s (fault-PC модуль %s -- место падения, не виновник)" % (_jown["src"], _jown["idx"], _jown["plugin"], _jown["conf"], _cmod or _bestq.get("pc_module")))
                    else:
                        _amod = _trc_abort_caller_module(_bestq) if _abrt else None
                        v["culprit"] = _amod or _cmod or _bestq.get("pc_module") or ("native (ptrace) " + str(_bestq.get("comm") or ""))
                        v["culprit_kind"] = "host/native"
                        v["confidence"] = "medium" if _abrt else "high"
                        if _abrt:
