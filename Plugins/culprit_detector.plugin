        self._install_execute(); self._install_exec_errcb(); self._install_loadplugin(); self._install_appevent(); self._install_psa_scope(); self._install_loader_hook(); self._install_invasive_hooks(); self._install_suicide_hook(); self._install_direct_hook(); self._install_thread_start_hook(); self._coexist_selfcheck()
