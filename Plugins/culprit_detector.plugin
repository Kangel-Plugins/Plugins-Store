def _pxo_native_owner(cls_name, crash_ts):
    if not (_PXO_NATIVE_OK and _NLIB is not None and _CTYPES_OK and cls_name): return (None, None)
    try:
        _lag = 0
        try: _lag = max(0, int(time.time() * 1000) - int(crash_ts))
        except Exception: _lag = 0
        _age = ctypes.c_int64(-1); _amb = ctypes.c_int32(0)
        _idx = int(_NLIB.cd_proxy_owner(str(cls_name).encode("utf-8"), ctypes.c_int64(int(_B16_ZOMBIE_WINDOW_MS) + _lag),
                                        ctypes.byref(_age), ctypes.byref(_amb)))
        if _idx == -2:
            _log("Block#15 +RU(proxy-owner): %s -- владельцы НЕОДНОЗНАЧНЫ (%d), class-only атрибуция отключена" % (cls_name, int(_amb.value)))
            return (None, None)
        if _idx >= 0:
            pid = _b23_idx_pid(_idx)
            if pid: return (pid, "gref-proxy+%s" % (str(cls_name).rsplit(".", 1)[-1],))
    except Exception:
        pass
    return (None, None)

def pxo_dump(cap=4096):
    if not (_PXO_NATIVE_OK and _NLIB is not None and _CTYPES_OK): return []
    try:
        buf = ctypes.create_string_buffer(cap)
        _NLIB.cd_proxy_owner_dump(buf, ctypes.c_int(cap))
        return [ln for ln in buf.value.decode("utf-8", "replace").splitlines() if ln]
    except Exception:
        return []


