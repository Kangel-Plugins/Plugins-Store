                except Exception:
                    _ig_best = None
                _ig_cul = _ig_best.get("culprit") if _ig_best else None
                if _ig_cul and _ig_cul != "unknown" and _ig_cul != rec.get("pid"):
                    rec["pid_native_scope"] = rec.get("pid")
                    rec["pid"] = _ig_cul
                    rec["pid_src"] = "correlated-pyerr"
                    rec["pid_choice_src"] = "ig-correlated"
                    rec["culprit_kind"] = "plugin"
                    rec["confidence"] = "medium"
                    rec["call_path"] = "plugin->managed(pyexc-unwind)"
                    rec["culprit_basis"] = ("native SIGSEGV NULL_DEREF entirely in ART/JNI runtime (top_so=%s) = uncaught PyException unwind; re-attributed from %s to correlated pyerr culprit %r (age=%dms)" % (_ig_top or "runtime", (("registry-scope guess %r" % rec.get("pid_native_scope")) if rec.get("pid_native_scope") is not None else "unresolved native (pid=none)"), _ig_cul, abs(int(_ig_ts) - _ig_best_ts)))
                    rec["ig_correlated"] = {"from": (_ig_best.get("kind") or "pyerr") + "_verdict", "culprit": _ig_cul, "py_file": _ig_best.get("py_file"), "py_line": _ig_best.get("py_line"), "age_ms": abs(int(_ig_ts) - _ig_best_ts)}
                    _log("Block#4C +IH: runtime NULL_DEREF (top_so=%s) reassigned prior=%r -> pyerr culprit %r (conf=medium)" % (_ig_top or "runtime", rec.get("pid_native_scope"), _ig_cul))
                elif _ig_cul and _ig_cul == rec.get("pid"):
                    rec["ig_corroborated"] = True
                    _log("Block#4C +IG: runtime NULL_DEREF (top_so=%s) -- pyerr corroborates scope guess %r" % (_ig_top or "runtime", rec.get("pid")))
                else:
                    rec["runtime_unwind_suspect"] = True
                    rec["confidence"] = "low"
                    if not rec.get("unattributed_reason"):
                        rec["unattributed_reason"] = ("runtime-unwind: native NULL_DEREF confined to ART/JNI (top_so=%s), no correlated pyerr in window -- registry-scope guess %r is low-trust" % (_ig_top or "runtime", rec.get("pid")))
                    _log("Block#4C +IG: runtime NULL_DEREF (top_so=%s), no pyerr in window -> scope guess %r downgraded conf=low (runtime_unwind_suspect)" % (_ig_top or "runtime", rec.get("pid")))
        except Exception as _eig:
            _log("Block#4C +IG enrich err: %s" % _eig)
        if rec.get("pid") is not None and a_pid is not None and a_pid >= 0 and c_pid is not None and c_pid >= 0 and a_pid != c_pid:
            _log(f"Block#4C: scope(active_pid={a_pid}) и culprit_pid={c_pid} расходятся -> выбран источник '{rec.get('pid_choice_src')}' (плагин={rec.get('pid')!r})")
        try:
            if rec.get("ts") is None:
                try: rec["ts"] = int(os.path.getmtime(p) * 1000)
                except Exception: rec["ts"] = int(time.time() * 1000)
        except Exception: pass
        try:
