    except Exception: pass
    try:
        if ("PyObject is closed" in (exc_msg or "")) and rec.get("cause") is None:
            _zjp = None
            for _f in (frames or []):
                if _f.startswith("$Proxy"):
                    _zjp = _f; break
            _zjh = any(("PyInvocationHandler" in _f) or ("java.lang.reflect.Proxy.invoke" in _f) for _f in (frames or []))
            if _zjp and _zjh:
                _zjcls, _zjdot, _zjm = _zjp.rpartition(".")
