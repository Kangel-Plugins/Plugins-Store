BASE_VIDEO_EXTENSIONS = (".mp4", ".mov", ".webm", ".mkv", ".avi", ".m4v", ".3gp", ".flv")

MIME_BY_EXT = {
    ".mp4": "video/mp4",
    ".m4v": "video/mp4",
    ".mov": "video/quicktime",
    ".webm": "video/webm",
    ".mkv": "video/x-matroska",
    ".avi": "video/x-msvideo",
    ".3gp": "video/3gpp",
    ".flv": "video/x-flv",
    ".ts": "video/mp2t",
}

BLOCKED_MIME_PREFIXES = ("text/", "image/", "audio/")

BLOCKED_EXACT_MIMES = {
    "application/json",
    "application/xml",
    "application/javascript",
    "application/x-javascript",
    "application/typescript",
    "application/x-typescript",
    "application/pdf",
    "application/zip",
    "application/x-rar-compressed",
    "application/x-7z-compressed",
    "application/x-tar",
    "application/gzip",
}

IN_APP_THUMB_MARKER = "in_app_video"
FILE_BADGE_PREFIX = "Файл: "
MAX_META_CACHE = 200
MAX_STATE_CACHE = 500
MAX_CELL_REFS = 40

THRESHOLD_OPTIONS = ["3 файла", "5 файлов", "10 файлов", "20 файлов"]
THRESHOLD_VALUES = [3, 5, 10, 20]

SHOW_MSG_CONDITION = (
    "message != null && message.getDocument() != null && "
    "!message.isVideo() && !message.isRoundVideo() && !message.isVoice() && "
    "!message.isGif() && !message.isSticker() && !message.isAnimatedSticker() && !message.isMusic() && "
    "(message.getDocument().mime_type == null || ("
    "!message.getDocument().mime_type.toLowerCase().startsWith(\"text/\") && "
    "!message.getDocument().mime_type.toLowerCase().startsWith(\"image/\") && "
    "!message.getDocument().mime_type.toLowerCase().startsWith(\"audio/\") && "
    "!message.getDocument().mime_type.toLowerCase().equals(\"application/typescript\") && "
    "!message.getDocument().mime_type.toLowerCase().equals(\"application/x-typescript\") && "
    "!message.getDocument().mime_type.toLowerCase().equals(\"application/javascript\")"
    ")) && "
    "((message.getDocument().mime_type != null && message.getDocument().mime_type.toLowerCase().startsWith(\"video/\")) || "
    "(message.getDocumentName() != null && ("
    "message.getDocumentName().toLowerCase().endsWith(\".mp4\") || "
    "message.getDocumentName().toLowerCase().endsWith(\".mov\") || "
    "message.getDocumentName().toLowerCase().endsWith(\".webm\") || "
    "message.getDocumentName().toLowerCase().endsWith(\".mkv\") || "
    "message.getDocumentName().toLowerCase().endsWith(\".avi\") || "
    "message.getDocumentName().toLowerCase().endsWith(\".m4v\") || "
    "message.getDocumentName().toLowerCase().endsWith(\".3gp\") || "
    "message.getDocumentName().toLowerCase().endsWith(\".flv\") || "
    "message.getDocumentName().toLowerCase().endsWith(\".ts\")"
    ")))"
)

HIDE_MSG_CONDITION = (
    "message != null && message.getDocument() != null && message.isVideo() && "
    "message.getDocument().thumbs != null && message.getDocument().thumbs.size() > 0 && "
    "message.getDocument().thumbs.get(0).type != null && "
    "message.getDocument().thumbs.get(0).type.equals(\"in_app_video\")"
)


class _JavaCache:
    _loaded = False
    ArrayList = None
    JavaFile = None
    Bitmap = None
    BitmapConfig = None
    CompressFormat = None
    ByteArrayOutputStream = None
    MediaMetadataRetriever = None
    VideoAttr = None
    PhotoCachedSize = None
    FileLoc = None
    FileLoader = None
    NotificationCenter = None
    NCDelegate = None
    UserConfig = None
    TYPE_VIDEO = 3

    @classmethod
    def ensure_loaded(cls):
        if cls._loaded:
            return
        cls._loaded = True
        cls.ArrayList = find_class("java.util.ArrayList")
        cls.JavaFile = find_class("java.io.File")
        cls.Bitmap = find_class("android.graphics.Bitmap")
        cls.BitmapConfig = find_class("android.graphics.Bitmap$Config")
        cls.CompressFormat = find_class("android.graphics.Bitmap$CompressFormat")
        cls.ByteArrayOutputStream = find_class("java.io.ByteArrayOutputStream")
        cls.MediaMetadataRetriever = find_class("android.media.MediaMetadataRetriever")
        cls.VideoAttr = find_class("org.telegram.tgnet.TLRPC$TL_documentAttributeVideo")
        cls.PhotoCachedSize = find_class("org.telegram.tgnet.TLRPC$TL_photoCachedSize")
        cls.FileLoc = find_class("org.telegram.tgnet.TLRPC$TL_fileLocationToBeDeprecated")
        cls.FileLoader = find_class("org.telegram.messenger.FileLoader")
        cls.NotificationCenter = find_class("org.telegram.messenger.NotificationCenter")
        cls.NCDelegate = find_class("org.telegram.messenger.NotificationCenter$NotificationCenterDelegate")
        cls.UserConfig = find_class("org.telegram.messenger.UserConfig")

        msg_cls = find_class("org.telegram.messenger.MessageObject")
        if msg_cls is not None:
            val = get_static_private_field(msg_cls, "TYPE_VIDEO")
            if val is not None:
                try:
                    cls.TYPE_VIDEO = int(val)
                except Exception:
                    pass


def _jint(val):
    try:
        from java import jint
        return jint(int(val))
    except Exception:
        return int(val)


def _jlong(val):
    try:
        from java import jlong
        return jlong(int(val))
    except Exception:
        return int(val)


def _jbool(val):
    try:
        from java import jboolean
        return jboolean(bool(val))
    except Exception:
        return bool(val)


def _format_bytes(num_bytes):
    size = float(max(0, int(num_bytes)))
    for unit in ("Б", "КБ", "МБ", "ГБ"):
        if size < 1024.0 or unit == "ГБ":
            if unit in ("Б", "КБ"):
                return f"{int(round(size))} {unit}"
            return f"{size:.1f} {unit}"
        size /= 1024.0
    return "0 Б"


def _msg_cache_key(message_obj):
    return (
        int(getattr(message_obj, "currentAccount", 0)),
        int(message_obj.getDialogId()),
        int(message_obj.getId()),
    )


def _get_doc_id(doc):
    if doc is None:
        return 0
    try:
        return int(getattr(doc, "id", 0))
    except Exception:
        return 0


def _get_msg_group_id(message_obj):
    if message_obj is None:
        return 0
    try:
        gid = int(message_obj.getGroupId())
        if gid != 0:
            return gid
    except Exception:
        pass
    try:
        owner = getattr(message_obj, "messageOwner", None)
        if owner is not None:
            return int(getattr(owner, "grouped_id", 0))
    except Exception:
        pass
    return 0


def _has_video_attribute(doc):
    attrs = getattr(doc, "attributes", None)
    if attrs is None:
        return False
    try:
        for i in range(attrs.size()):
            attr = attrs.get(i)
            if attr is not None and "TL_documentAttributeVideo" in str(attr.getClass().getName()):
                return True
    except Exception:
        pass
    return False


def _is_non_document_media(message_obj):
    for method_name in ("isVideo", "isRoundVideo", "isVoice", "isGif", "isSticker", "isAnimatedSticker", "isMusic"):
        try:
            fn = getattr(message_obj, method_name, None)
            if fn is not None and bool(fn()):
                return True
        except Exception:
            pass
    return False


def _is_video_doc(message_obj, doc, allow_ts=True):
    if message_obj is None or doc is None:
        return False, None, ""
    if _is_non_document_media(message_obj) or _has_video_attribute(doc):
        return False, None, ""

    try:
        doc_size = int(getattr(doc, "size", 0))
        if doc_size <= 0:
            return False, None, ""
    except Exception:
        pass

    file_name = ""
    try:
        name = message_obj.getDocumentName()
        if name:
            file_name = str(name).strip()
    except Exception:
        pass

    mime_type = ""
    try:
        if doc.mime_type:
            mime_type = str(doc.mime_type).lower().strip()
    except Exception:
        pass

    if mime_type:
        if any(mime_type.startswith(prefix) for prefix in BLOCKED_MIME_PREFIXES):
            return False, None, file_name
        if mime_type in BLOCKED_EXACT_MIMES:
            return False, None, file_name

    extensions = BASE_VIDEO_EXTENSIONS + ((".ts",) if allow_ts else ())
    name_l = file_name.lower()
    matched_ext = next((ext for ext in extensions if name_l.endswith(ext)), None)
    is_video_mime = mime_type.startswith("video/")

    if matched_ext is None and not is_video_mime:
        return False, None, file_name

    return True, matched_ext, file_name


def _resolve_msg_local_path(message_obj):
    try:
        owner = getattr(message_obj, "messageOwner", None)
        attach_path = getattr(owner, "attachPath", None) if owner is not None else None
        if attach_path:
            p = str(attach_path)
            if os.path.isfile(p) and os.path.getsize(p) > 0:
                return p
    except Exception:
        pass

    account = int(getattr(message_obj, "currentAccount", 0))
    try:
        loader = get_file_loader(account=account)
        if loader is None:
            return None
        owner = getattr(message_obj, "messageOwner", None)
        if owner is not None:
            f = loader.getPathToMessage(owner)
            if f is not None and f.exists() and f.length() > 0:
                return str(f.getAbsolutePath())
        doc = message_obj.getDocument()
        if doc is not None:
            f2 = loader.getPathToAttach(doc)
            if f2 is not None and f2.exists() and f2.length() > 0:
                return str(f2.getAbsolutePath())
    except Exception:
        pass

    return None


def _safe_parse_int(raw_val, default=0):
    if raw_val is None:
        return default
    try:
        return int(str(raw_val).strip())
    except Exception:
        return default


def _utf16_len(text):
    return len(text.encode("utf-16-le")) // 2


def _extract_video_info_and_thumb(file_path):
    _JavaCache.ensure_loaded()
    width, height, duration_sec = 1280, 720, 1.0
    thumb_w, thumb_h = 320, 180
    jpeg_bytes = None
    retriever = None
    meta_dimensions_found = False

    Bitmap = _JavaCache.Bitmap
    CompressFormat = _JavaCache.CompressFormat
    ByteArrayOutputStream = _JavaCache.ByteArrayOutputStream

    try:
        MMR = _JavaCache.MediaMetadataRetriever
        if MMR is not None:
            retriever = MMR()
            retriever.setDataSource(file_path)

            raw_w = _safe_parse_int(retriever.extractMetadata(18), 0)
            raw_h = _safe_parse_int(retriever.extractMetadata(19), 0)
            raw_d = _safe_parse_int(retriever.extractMetadata(9), 0)
            rotation = _safe_parse_int(retriever.extractMetadata(24), 0)

            if raw_w > 0 and raw_h > 0:
                width, height = raw_w, raw_h
                meta_dimensions_found = True
                if rotation in (90, 270):
                    width, height = height, width

            if raw_d > 0:
                duration_sec = max(1.0, raw_d / 1000.0)

            bmp = None
            try:
                bmp = retriever.getFrameAtTime(_jlong(500000))
                if bmp is None:
                    bmp = retriever.getFrameAtTime(_jlong(-1))
            except Exception:
                try:
                    bmp = retriever.getFrameAtTime()
                except Exception:
                    bmp = None

            if bmp is not None:
                try:
                    bw = int(bmp.getWidth())
                    bh = int(bmp.getHeight())
                    if bw > 0 and bh > 0:
                        if not meta_dimensions_found:
                            width, height = bw, bh

                        max_side = 360.0
                        scale = min(1.0, max_side / float(max(bw, bh)))
                        thumb_w = max(16, int(round(bw * scale)))
                        thumb_h = max(16, int(round(bh * scale)))

                        if Bitmap is not None and CompressFormat is not None and ByteArrayOutputStream is not None:
                            target_bmp = bmp
                            if scale < 1.0:
                                target_bmp = Bitmap.createScaledBitmap(bmp, _jint(thumb_w), _jint(thumb_h), _jbool(True))
                            try:
                                baos = ByteArrayOutputStream()
                                target_bmp.compress(CompressFormat.JPEG, _jint(80), baos)
                                jpeg_bytes = baos.toByteArray()
                                baos.close()
                            finally:
                                if target_bmp is not bmp:
                                    target_bmp.recycle()
                finally:
                    bmp.recycle()
    except Exception:
        pass
    finally:
        if retriever is not None:
            try:
                retriever.release()
            except Exception:
                pass

    if jpeg_bytes is None:
        max_side = 360.0
        scale = min(1.0, max_side / float(max(width, height)))
        thumb_w = max(16, int(round(width * scale)))
        thumb_h = max(16, int(round(height * scale)))

        try:
            BitmapConfig = _JavaCache.BitmapConfig
            if Bitmap is not None and BitmapConfig is not None and CompressFormat is not None and ByteArrayOutputStream is not None:
                fallback_bmp = Bitmap.createBitmap(_jint(thumb_w), _jint(thumb_h), BitmapConfig.ARGB_8888)
                try:
                    fallback_bmp.eraseColor(_jint(-16777216))
                    baos = ByteArrayOutputStream()
                    fallback_bmp.compress(CompressFormat.JPEG, _jint(60), baos)
                    jpeg_bytes = baos.toByteArray()
                    baos.close()
                finally:
                    fallback_bmp.recycle()
        except Exception:
            pass

    return width, height, duration_sec, thumb_w, thumb_h, jpeg_bytes


def _save_original_state(message_obj, state_store):
    key = _msg_cache_key(message_obj)
    if key in state_store:
        state_store.move_to_end(key)
        return

    doc = message_obj.getDocument()
    owner = getattr(message_obj, "messageOwner", None)

    orig_attrs = None
    if doc is not None and getattr(doc, "attributes", None) is not None:
        try:
            orig_attrs = [doc.attributes.get(i) for i in range(doc.attributes.size())]
        except Exception:
            orig_attrs = []

    orig_thumbs = None
    if doc is not None and getattr(doc, "thumbs", None) is not None:
        try:
            orig_thumbs = [doc.thumbs.get(i) for i in range(doc.thumbs.size())]
        except Exception:
            orig_thumbs = []

    orig_mime = getattr(doc, "mime_type", None) if doc is not None else None

    orig_type = 9
    try:
        orig_type = int(getattr(message_obj, "type", 9))
    except Exception:
        pass

    orig_caption = getattr(owner, "message", None) if owner is not None else None
    orig_attach_path = getattr(owner, "attachPath", None) if owner is not None else None
    orig_grouped_id = 0
    orig_entity_offsets = None

    if owner is not None:
        try:
            orig_grouped_id = int(getattr(owner, "grouped_id", 0))
        except Exception:
            pass
        entities = getattr(owner, "entities", None)
        if entities is not None:
            try:
                orig_entity_offsets = [int(entities.get(i).offset) for i in range(entities.size())]
            except Exception:
                orig_entity_offsets = None

    if len(state_store) >= MAX_STATE_CACHE:
        state_store.popitem(last=False)

    state_store[key] = {
        "attrs": orig_attrs,
        "thumbs": orig_thumbs,
        "mime": orig_mime,
        "type": orig_type,
        "caption": orig_caption,
        "attach_path": orig_attach_path,
        "grouped_id": orig_grouped_id,
        "entity_offsets": orig_entity_offsets,
    }


def _apply_video_transformation(
    message_obj,
    meta,
    matched_ext,
    file_name,
    local_path,
    state_store,
    doc_local_paths,
    show_badge=False,
):
    _JavaCache.ensure_loaded()
    doc = message_obj.getDocument()
    if doc is None:
        return False

    doc_id = _get_doc_id(doc)
    if local_path and doc_id != 0:
        doc_local_paths[doc_id] = local_path

    owner = getattr(message_obj, "messageOwner", None)
    if _has_video_attribute(doc) and message_obj.isVideo():
        if local_path and owner is not None:
            try:
                if not getattr(owner, "attachPath", None):
                    owner.attachPath = local_path
                    message_obj.checkMediaExistance()
            except Exception:
                pass
        return True

    if _JavaCache.VideoAttr is None or _JavaCache.ArrayList is None:
        return False

    _save_original_state(message_obj, state_store)

    width, height, duration_sec, thumb_w, thumb_h, jpeg_bytes = meta

    attr = _JavaCache.VideoAttr()
    attr.w = int(width)
    attr.h = int(height)
    try:
        attr.duration = float(duration_sec)
    except TypeError:
        attr.duration = int(duration_sec)
    try:
        attr.supports_streaming = False
    except Exception:
        pass

    if getattr(doc, "attributes", None) is None:
        doc.attributes = _JavaCache.ArrayList()
    doc.attributes.add(attr)

    try:
        if _JavaCache.PhotoCachedSize is not None:
            ps = _JavaCache.PhotoCachedSize()
            ps.type = IN_APP_THUMB_MARKER
            ps.w = int(thumb_w)
            ps.h = int(thumb_h)
            ps.bytes = jpeg_bytes if jpeg_bytes is not None else bytes([0])
            if _JavaCache.FileLoc is not None:
                ps.location = _JavaCache.FileLoc()

            if getattr(doc, "thumbs", None) is None:
                doc.thumbs = _JavaCache.ArrayList()
            doc.thumbs.add(_jint(0), ps)
    except Exception:
        pass

    try:
        cur_mime = str(doc.mime_type).lower() if doc.mime_type else ""
    except Exception:
        cur_mime = ""
    if not cur_mime or cur_mime == "application/octet-stream":
        doc.mime_type = MIME_BY_EXT.get(matched_ext, "video/mp4")

    if local_path and owner is not None:
        try:
            owner.attachPath = local_path
        except Exception:
            pass

    try:
        message_obj.type = _JavaCache.TYPE_VIDEO
    except Exception:
        pass

    try:
        message_obj.checkMediaExistance()
    except Exception:
        pass

    try:
        message_obj.photoThumbs = None
        message_obj.photoThumbs2 = None
    except Exception:
        pass
    try:
        message_obj.generateThumbs(_jbool(True))
    except Exception:
        try:
            message_obj.generateThumbs(_jbool(False))
        except Exception:
            pass

    if show_badge and owner is not None:
        try:
            display_name = file_name if file_name else "video"
            badge = f"{FILE_BADGE_PREFIX}{display_name}"
            existing_text = str(owner.message) if getattr(owner, "message", None) else ""
            if not existing_text.startswith(FILE_BADGE_PREFIX):
                if existing_text.strip():
                    prefix = f"{badge}\n\n"
                    owner.message = f"{prefix}{existing_text}"
                    entities = getattr(owner, "entities", None)
                    if entities is not None:
                        shift = _utf16_len(prefix)
                        for i in range(entities.size()):
                            ent = entities.get(i)
                            if ent is not None:
                                ent.offset = int(ent.offset) + shift
                else:
                    owner.message = badge
                message_obj.generateCaption()
        except Exception:
            pass

    return True


def _revert_video_transformation(message_obj, state_store, doc_local_paths):
    _JavaCache.ensure_loaded()
    key = _msg_cache_key(message_obj)
    saved = state_store.get(key)
    doc = message_obj.getDocument()
    owner = getattr(message_obj, "messageOwner", None)

    if saved is None and doc is None:
        return False

    doc_id = _get_doc_id(doc)
    if doc_id != 0:
        doc_local_paths.pop(doc_id, None)

    ArrayList = _JavaCache.ArrayList

    if doc is not None:
        if saved is not None:
            orig_attrs = saved.get("attrs")
            if orig_attrs is None:
                doc.attributes = None
            elif ArrayList is not None:
                new_attrs = ArrayList()
                for item in orig_attrs:
                    new_attrs.add(item)
                doc.attributes = new_attrs

            orig_thumbs = saved.get("thumbs")
            if orig_thumbs is None:
                doc.thumbs = None
            elif ArrayList is not None:
                new_thumbs = ArrayList()
                for item in orig_thumbs:
                    new_thumbs.add(item)
                doc.thumbs = new_thumbs

            doc.mime_type = saved.get("mime")
        else:
            attrs = getattr(doc, "attributes", None)
            if attrs is not None:
                for idx in range(attrs.size() - 1, -1, -1):
                    a = attrs.get(idx)
                    if a is not None and "TL_documentAttributeVideo" in str(a.getClass().getName()):
                        attrs.remove(idx)
            thumbs = getattr(doc, "thumbs", None)
            if thumbs is not None:
                for idx in range(thumbs.size() - 1, -1, -1):
                    t = thumbs.get(idx)
                    if t is not None and (
                        "TL_photoCachedSize" in str(t.getClass().getName())
                        or str(getattr(t, "type", "")) == IN_APP_THUMB_MARKER
                    ):
                        thumbs.remove(idx)

    if owner is not None and saved is not None:
        try:
            owner.attachPath = saved.get("attach_path")
        except Exception:
            pass

    try:
        message_obj.type = int(saved.get("type", 9)) if saved is not None else 9
    except Exception:
        pass

    try:
        message_obj.checkMediaExistance()
    except Exception:
        pass

    try:
        message_obj.photoThumbs = None
        message_obj.photoThumbs2 = None
        if doc is not None and getattr(doc, "thumbs", None) is not None and doc.thumbs.size() > 0:
            message_obj.generateThumbs(_jbool(True))
    except Exception:
        pass

    if owner is not None:
        try:
            if saved is not None:
                owner.message = saved.get("caption")
                orig_offsets = saved.get("entity_offsets")
                entities = getattr(owner, "entities", None)
                if orig_offsets is not None and entities is not None:
                    limit = min(len(orig_offsets), entities.size())
                    for i in range(limit):
                        ent = entities.get(i)
                        if ent is not None:
                            ent.offset = orig_offsets[i]
            else:
                cur_msg = str(owner.message) if getattr(owner, "message", None) else ""
                if cur_msg.startswith(FILE_BADGE_PREFIX):
                    nl_idx = cur_msg.find("\n")
                    owner.message = cur_msg[nl_idx + 1:].lstrip("\n") if nl_idx != -1 else None

            if not getattr(owner, "message", None):
                try:
                    message_obj.caption = None
                except Exception:
                    pass
            message_obj.generateCaption()
        except Exception:
            pass

        if saved is not None and saved.get("grouped_id", 0) != 0:
            try:
                owner.grouped_id = saved["grouped_id"]
            except Exception:
                pass

    state_store.pop(key, None)
    return True


def _recalculate_group_for_videos(grouped_map, group_id, group, detached_groups=None, logger=None):
    if group is None:
        return False
    try:
        msgs = getattr(group, "messages", None)
        if msgs is None or msgs.size() == 0:
            return False

        video_items = []
        non_video_items = []
        for i in range(msgs.size()):
            m = msgs.get(i)
            if m is None:
                continue
            if m.isVideo() or m.isPhoto():
                video_items.append(m)
            else:
                non_video_items.append(m)

        if not video_items:
            return msgs.size() > 1

        if len(non_video_items) == 0:
            pos_map = getattr(group, "positions", None)
            need_recalc = bool(getattr(group, "isDocuments", True)) or (
                pos_map is not None and pos_map.size() != msgs.size()
            )
            if need_recalc:
                try:
                    group.isDocuments = False
                except Exception:
                    pass
                try:
                    if pos_map is not None:
                        pos_map.clear()
                except Exception:
                    pass
                try:
                    if getattr(group, "posArray", None) is not None:
                        group.posArray.clear()
                except Exception:
                    pass
                group.calculate()
            return msgs.size() > 1

        if detached_groups is not None and group_id != 0 and group_id not in detached_groups:
            detached_groups[group_id] = {
                "group": group,
                "siblings": list(non_video_items),
            }

        for m in video_items:
            msgs.remove(m)
            try:
                if getattr(m, "messageOwner", None) is not None:
                    m.messageOwner.grouped_id = 0
            except Exception:
                pass

        if msgs.size() <= 1:
            if msgs.size() == 1:
                try:
                    last_m = msgs.get(0)
                    if getattr(last_m, "messageOwner", None) is not None:
                        last_m.messageOwner.grouped_id = 0
                except Exception:
                    pass
            if grouped_map is not None and group_id != 0:
                try:
                    grouped_map.remove(_jlong(group_id))
                except Exception:
                    pass
            return False

        try:
            if getattr(group, "positions", None) is not None:
                group.positions.clear()
            if getattr(group, "posArray", None) is not None:
                group.posArray.clear()
            group.calculate()
        except Exception:
            pass
        return True
    except Exception:
        if logger is not None:
            logger.exception("Group recalc error")
        return False


def _restore_group_as_documents(grouped_map, group_id, group, extra_messages=None, detached_groups=None, logger=None):
    try:
        detached = detached_groups.pop(group_id, None) if detached_groups is not None else None
        if group is None and detached is not None:
            group = detached.get("group")
            if group is not None and grouped_map is not None and group_id != 0:
                try:
                    grouped_map.put(_jlong(group_id), group)
                except Exception:
                    pass

        if group is None:
            return

        msgs = getattr(group, "messages", None)
        if msgs is None:
            return

        restore_list = []
        if detached is not None:
            for sib in detached.get("siblings", []):
                if sib is not None:
                    try:
                        if getattr(sib, "messageOwner", None) is not None:
                            sib.messageOwner.grouped_id = group_id
                    except Exception:
                        pass
                    restore_list.append(sib)
        if extra_messages:
            restore_list.extend(extra_messages)

        if restore_list:
            existing_ids = set()
            for i in range(msgs.size()):
                m = msgs.get(i)
                if m is not None:
                    existing_ids.add(int(m.getId()))
            for m in restore_list:
                if m is not None and int(m.getId()) not in existing_ids:
                    msgs.add(m)
                    existing_ids.add(int(m.getId()))

        any_video = False
        for i in range(msgs.size()):
            m = msgs.get(i)
            if m is not None and (m.isVideo() or m.isPhoto()):
                any_video = True
                break

        if not any_video:
            try:
                group.isDocuments = True
            except Exception:
                pass
            try:
                if getattr(group, "positions", None) is not None:
                    group.positions.clear()
            except Exception:
                pass
            try:
                if getattr(group, "posArray", None) is not None:
                    group.posArray.clear()
            except Exception:
                pass
            group.calculate()
    except Exception:
        if logger is not None:
            logger.exception("Group restore error")


def _notify(fragment, text, level="info"):
    frag = fragment if (fragment is not None and _is_fragment_alive(fragment)) else None
    try:
        if level == "success":
            BulletinHelper.show_success(str(text), fragment=frag)
        elif level == "error":
            BulletinHelper.show_error(str(text), fragment=frag)
        else:
            BulletinHelper.show_info(str(text), fragment=frag)
    except Exception:
        pass


def _is_fragment_alive(fragment):
    if fragment is None:
        return False
    try:
        return fragment.getParentActivity() is not None
    except Exception:
        return False


def _create_file_load_delegate(plugin):
    _JavaCache.ensure_loaded()
    NCDelegate = _JavaCache.NCDelegate
    if NCDelegate is None:
        return None
    try:
        from java import dynamic_proxy

        class FileLoadDelegate(dynamic_proxy(NCDelegate)):
            def __init__(self, plg):
                super().__init__()
                self.plg = plg

            def didReceivedNotification(self, event_id, account, *args):
                payload = args
                if len(args) == 1 and args[0] is not None and not isinstance(args[0], (str, bytes)):
                    try:
                        len(args[0])
                        payload = args[0]
                    except TypeError:
                        pass
                self.plg._on_notification_received(int(event_id), int(account), payload)

        return FileLoadDelegate(plugin)
    except Exception:
        plugin.logger.exception("Failed to create FileLoadDelegate")
        return None


class GetPathToAttachHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        if not self.plugin.doc_local_paths:
            return
        try:
            args = param.args
            if not args or len(args) == 0:
                return
            attach = args[0]
            if attach is None:
                return
            if len(args) >= 2 and isinstance(args[1], str) and args[1]:
                return
            if not hasattr(attach, "mime_type"):
                return
            doc_id = _get_doc_id(attach)
            if doc_id == 0:
                return
            mapped = self.plugin.doc_local_paths.get(doc_id)
            if mapped and _JavaCache.JavaFile is not None and os.path.isfile(mapped):
                param.setResult(_JavaCache.JavaFile(mapped))
        except Exception:
            pass


class SetMessageObjectHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        auto_reveal = self.plugin._auto_reveal
        if not self.plugin.revealed_messages and not auto_reveal:
            return

        try:
            args = param.args
            if not args or len(args) == 0:
                return

            message_obj = args[0]
            if message_obj is None:
                return

            group = args[1] if len(args) >= 2 else None
            allow_ts = self.plugin._allow_ts
            show_badge = self.plugin._show_file_badge

            candidates = [message_obj]
            if group is not None and getattr(group, "messages", None) is not None:
                for i in range(group.messages.size()):
                    m = group.messages.get(i)
                    if m is not None and m is not message_obj:
                        candidates.append(m)

            targets = []
            for m in candidates:
                m_key = _msg_cache_key(m)
                if m_key in self.plugin.revealed_messages:
                    targets.append((m, m_key))
                elif auto_reveal and m_key not in self.plugin.hidden_messages:
                    doc = m.getDocument()
                    is_cand, _, _ = _is_video_doc(m, doc, allow_ts=allow_ts)
                    if is_cand and _resolve_msg_local_path(m):
                        self.plugin.revealed_messages.add(m_key)
                        targets.append((m, m_key))

            if not targets:
                return

            if param.thisObject is not None:
                self.plugin._remember_cell_ref(_msg_cache_key(message_obj), param.thisObject)

            transformed_any = False
            for m, _ in targets:
                doc = m.getDocument()
                is_candidate, matched_ext, file_name = _is_video_doc(m, doc, allow_ts=allow_ts)
                if not is_candidate:
                    continue
                local_path = _resolve_msg_local_path(m)
                if not local_path:
                    continue
                meta = self.plugin._get_cached_meta(local_path)
                if meta is not None:
                    if _apply_video_transformation(
                        m,
                        meta,
                        matched_ext,
                        file_name,
                        local_path,
                        self.plugin.original_states,
                        self.plugin.doc_local_paths,
                        show_badge=show_badge,
                    ):
                        transformed_any = True
                else:
                    self.plugin._schedule_meta_extraction(m, local_path, matched_ext, file_name, None)

            if group is not None and transformed_any:
                gid = _get_msg_group_id(message_obj)
                group_valid = _recalculate_group_for_videos(
                    None, gid, group, self.plugin.detached_groups, self.plugin.logger
                )
                if not group_valid or _get_msg_group_id(message_obj) == 0:
                    try:
                        param.args[1] = None
                    except Exception:
                        pass
        except Exception:
            self.plugin.logger.exception("SetMessageObjectHook error")


class InAppVideoDocsPlugin(BasePlugin):
    def on_plugin_load(self):
        self.hook_refs = []
        self.menu_items = []
        self.meta_cache = OrderedDict()
        self.revealed_messages = set()
        self.hidden_messages = set()
        self.original_states = OrderedDict()
        self.doc_local_paths = {}
        self.detached_groups = {}
        self.pending_paths = set()
        self.pending_tasks = {}
        self.waiting_downloads = {}
        self.cell_refs = OrderedDict()
        self.nc_delegate = None
        self.registered_accounts = []
        self.file_loaded_event_id = None
        self.file_failed_event_id = None
        self.lock = threading.Lock()

        self._auto_reveal = bool(self.get_setting("auto_reveal", False))
        self._auto_download = bool(self.get_setting("auto_download", True))
        self._show_file_badge = bool(self.get_setting("show_file_badge", False))
        self._allow_ts = bool(self.get_setting("allow_ts", True))
        self._download_threshold_idx = self._parse_threshold_idx(
            self.get_setting("download_confirm_threshold", 1)
        )

        _JavaCache.ensure_loaded()

        try:
            self._hook_chat_message_cell()
            self._hook_file_loader()

            for item_data in (
                MenuItemData(
                    menu_type=MenuItemType.CHAT_ACTION_MENU,
                    text="Показать видеофайлы",
                    on_click=self.on_reveal_chat_videos,
                    icon="msg_video",
                ),
                MenuItemData(
                    menu_type=MenuItemType.CHAT_ACTION_MENU,
                    text="Скрыть видеофайлы",
                    on_click=self.on_hide_chat_videos,
                    icon="msg_cancel",
                ),
                MenuItemData(
                    menu_type=MenuItemType.MESSAGE_CONTEXT_MENU,
                    text="Показать как видео",
                    on_click=self.on_reveal_single_message,
                    icon="msg_video",
                    condition=SHOW_MSG_CONDITION,
                ),
                MenuItemData(
                    menu_type=MenuItemType.MESSAGE_CONTEXT_MENU,
                    text="Скрыть как файл",
                    on_click=self.on_hide_single_message,
                    icon="msg_cancel",
                    condition=HIDE_MSG_CONDITION,
                ),
            ):
                item_id = self.add_menu_item(item_data)
                if item_id is not None:
                    self.menu_items.append(item_id)

            self._register_download_observers()
            self.logger.info("In-App Video v%s loaded", __version__)
        except Exception:
            self.logger.exception("Plugin load error")

    def on_plugin_unload(self):
        self._unregister_download_observers()

        for unhook in getattr(self, "hook_refs", []):
            try:
                self.unhook_method(unhook)
            except Exception:
                pass
        self.hook_refs = []

        for item in getattr(self, "menu_items", []):
            try:
                self.remove_menu_item(item)
            except Exception:
                pass
        self.menu_items = []

        with self.lock:
            self.meta_cache.clear()
            self.pending_paths.clear()
            self.pending_tasks.clear()
            self.waiting_downloads.clear()

        self.revealed_messages.clear()
        self.hidden_messages.clear()
        self.original_states.clear()
        self.doc_local_paths.clear()
        self.detached_groups.clear()
        self.cell_refs.clear()

    def _hook_chat_message_cell(self):
        ChatMessageCell = find_class("org.telegram.ui.Cells.ChatMessageCell")
        if ChatMessageCell is None:
            return

        hook = SetMessageObjectHook(self)
        target_method = None
        max_params = -1
        try:
            for m in ChatMessageCell.getDeclaredMethods():
                if str(m.getName()) == "setMessageObject":
                    n_params = len(m.getParameterTypes())
                    if n_params > max_params:
                        max_params = n_params
                        target_method = m
        except Exception:
            target_method = None

        if target_method is not None:
            unhook = self.hook_method(target_method, hook)
            if unhook is not None:
                self.hook_refs.append(unhook)
                return

        unhooks = self.hook_all_methods(ChatMessageCell, "setMessageObject", hook)
        if unhooks:
            self.hook_refs.extend(unhooks)

    def _hook_file_loader(self):
        FileLoader = _JavaCache.FileLoader
        if FileLoader is None:
            return

        unhooks = self.hook_all_methods(FileLoader, "getPathToAttach", GetPathToAttachHook(self))
        if unhooks:
            self.hook_refs.extend(unhooks)

    def create_settings(self):
        return [
            Header(text="Основные параметры"),
            Switch(
                key="auto_reveal",
                text="Автопоказ скачанных видеофайлов",
                subtext="Автоматически превращать кэшированные видеодокументы в плеер при открытии чата",
                icon="msg_video",
                default=False,
                on_change=self._on_auto_reveal_change,
            ),
            Switch(
                key="auto_download",
                text="Автоскачивание при нажатии",
                subtext="Загружать видеофайл автоматически, если он ещё не скачан на устройство",
                icon="msg_download",
                default=True,
                on_change=self._on_auto_download_change,
            ),
            Selector(
                key="download_confirm_threshold",
                text="Порог подтверждения загрузки",
                icon="msg_list",
                items=THRESHOLD_OPTIONS,
                default=1,
                on_change=self._on_threshold_change,
            ),
            Switch(
                key="show_file_badge",
                text="Добавлять имя файла в подпись",
                subtext="Показывать исходное имя документа перед текстом сообщения с отступом",
                icon="msg_edit",
                default=False,
                on_change=self._on_show_badge_change,
            ),
            Switch(
                key="allow_ts",
                text="Распознавать файлы .ts",
                subtext="Включить поддержку видеофайлов с расширением .ts (MPEG-TS)",
                icon="msg_info",
                default=True,
                on_change=self._on_allow_ts_change,
            ),
            Divider(text="Скрытые вручную видеофайлы не открываются повторно автопоказом до ручного включения."),
            Header(text="Кэш и обслуживание"),
            Text(
                text="Очистить кэш превью",
                subtext="Удалить сохранённые миниатюры и метаданные видео из памяти",
                icon="msg_delete",
                red=True,
                on_click=self._on_clear_cache_click,
            ),
        ]

    def _on_auto_reveal_change(self, value):
        self._auto_reveal = bool(value)

    def _on_auto_download_change(self, value):
        self._auto_download = bool(value)

    def _on_show_badge_change(self, value):
        self._show_file_badge = bool(value)

    def _on_allow_ts_change(self, value):
        self._allow_ts = bool(value)

    def _on_threshold_change(self, value):
        self._download_threshold_idx = self._parse_threshold_idx(value)

    def _parse_threshold_idx(self, idx):
        try:
            i = int(idx)
            if 0 <= i < len(THRESHOLD_VALUES):
                return i
        except Exception:
            pass
        return 1

    def _get_download_threshold(self):
        return THRESHOLD_VALUES[self._download_threshold_idx]

    def _remember_cell_ref(self, msg_key, cell):
        if msg_key in self.cell_refs:
            self.cell_refs[msg_key] = cell
            self.cell_refs.move_to_end(msg_key)
        else:
            if len(self.cell_refs) >= MAX_CELL_REFS:
                self.cell_refs.popitem(last=False)
            self.cell_refs[msg_key] = cell

    def _get_activity(self, fragment=None):
        if fragment is not None:
            try:
                act = fragment.getParentActivity()
                if act is not None:
                    return act
            except Exception:
                pass
        try:
            last_frag = get_last_fragment()
            if last_frag is not None:
                act = last_frag.getParentActivity()
                if act is not None:
                    return act
        except Exception:
            pass
        return None

    def _on_clear_cache_click(self, *args):
        with self.lock:
            count = len(self.meta_cache)
            self.meta_cache.clear()
        _notify(None, f"Кэш превью очищен ({count})", "info")

    def _get_cached_meta(self, local_path):
        with self.lock:
            meta = self.meta_cache.get(local_path)
            if meta is not None:
                self.meta_cache.move_to_end(local_path)
            return meta

    def _put_cached_meta(self, local_path, meta):
        with self.lock:
            if local_path in self.meta_cache:
                self.meta_cache[local_path] = meta
                self.meta_cache.move_to_end(local_path)
            else:
                if len(self.meta_cache) >= MAX_META_CACHE:
                    self.meta_cache.popitem(last=False)
                self.meta_cache[local_path] = meta

    def _register_download_observers(self):
        def _bind():
            try:
                _JavaCache.ensure_loaded()
                NC = _JavaCache.NotificationCenter
                if NC is None:
                    return

                loaded_id = get_static_private_field(NC, "fileLoaded")
                failed_id = get_static_private_field(NC, "fileLoadFailed")
                if loaded_id is None:
                    return

                self.file_loaded_event_id = int(loaded_id)
                self.file_failed_event_id = int(failed_id) if failed_id is not None else None

                max_accounts = 4
                if _JavaCache.UserConfig is not None:
                    val = get_static_private_field(_JavaCache.UserConfig, "MAX_ACCOUNT_COUNT")
                    if val is not None:
                        max_accounts = int(val)

                self.nc_delegate = _create_file_load_delegate(self)
                if self.nc_delegate is None:
                    return
                self.registered_accounts = []

                for acc in range(max_accounts):
                    nc = get_notification_center(account=acc)
                    if nc is not None:
                        nc.addObserver(self.nc_delegate, _jint(self.file_loaded_event_id))
                        if self.file_failed_event_id is not None:
                            nc.addObserver(self.nc_delegate, _jint(self.file_failed_event_id))
                        self.registered_accounts.append(acc)
            except Exception:
                self.logger.exception("Observer bind error")

        run_on_ui_thread(_bind)

    def _unregister_download_observers(self):
        delegate = self.nc_delegate
        accounts = list(self.registered_accounts)
        loaded_id = self.file_loaded_event_id
        failed_id = self.file_failed_event_id
        self.nc_delegate = None
        self.registered_accounts = []

        if delegate is None or not accounts:
            return

        def _unbind():
            try:
                for acc in accounts:
                    nc = get_notification_center(account=acc)
                    if nc is None:
                        continue
                    if loaded_id is not None:
                        nc.removeObserver(delegate, _jint(loaded_id))
                    if failed_id is not None:
                        nc.removeObserver(delegate, _jint(failed_id))
            except Exception:
                pass

        run_on_ui_thread(_unbind)

    def _start_file_download(self, message_obj, matched_ext, file_name, fragment):
        doc = message_obj.getDocument()
        if doc is None:
            return False

        account = int(getattr(message_obj, "currentAccount", 0))
        loader = get_file_loader(account=account)
        if loader is None:
            return False

        attach_name = ""
        try:
            if _JavaCache.FileLoader is not None:
                raw_name = _JavaCache.FileLoader.getAttachFileName(doc)
                if raw_name is not None:
                    attach_name = str(raw_name)
        except Exception:
            pass

        doc_id = _get_doc_id(doc)

        msg_key = _msg_cache_key(message_obj)
        with self.lock:
            self.waiting_downloads[msg_key] = {
                "msg": message_obj,
                "matched_ext": matched_ext,
                "file_name": file_name,
                "fragment": fragment,
                "attach_name": attach_name,
                "doc_id": doc_id,
                "account": account,
            }

        try:
            try:
                loader.loadFile(doc, message_obj, _jint(1), _jint(0))
            except Exception:
                try:
                    loader.loadFile(doc, None, _jint(1), _jint(0))
                except Exception:
                    loader.loadFile(doc, _jint(1), _jint(0))
            return True
        except Exception:
            with self.lock:
                self.waiting_downloads.pop(msg_key, None)
            return False

    def _match_download_entry(self, entry, loaded_name):
        if loaded_name:
            if entry["attach_name"] and loaded_name == entry["attach_name"]:
                return True
            if entry["doc_id"] != 0 and str(entry["doc_id"]) in loaded_name:
                return True
        return False

    def _on_notification_received(self, event_id, account, args):
        if not self.waiting_downloads:
            return

        arg0 = None
        arg1 = None
        if args is not None:
            try:
                n_args = len(args)
                if n_args >= 1:
                    arg0 = args[0]
                if n_args >= 2:
                    arg1 = args[1]
            except Exception:
                pass

        loaded_name = str(arg0) if arg0 is not None else ""

        if event_id == self.file_loaded_event_id:
            ready_entries = []
            with self.lock:
                for key, entry in list(self.waiting_downloads.items()):
                    if entry["account"] != account:
                        continue
                    if not self._match_download_entry(entry, loaded_name):
                        continue
                    local_path = _resolve_msg_local_path(entry["msg"])
                    if local_path:
                        self.waiting_downloads.pop(key, None)
                        ready_entries.append((key, entry, local_path))

            for key, entry, local_path in ready_entries:
                self.hidden_messages.discard(key)
                self.revealed_messages.add(key)
                self._schedule_meta_extraction(
                    entry["msg"],
                    local_path,
                    entry["matched_ext"],
                    entry["file_name"],
                    entry["fragment"],
                    notify_ready=True,
                )

        elif self.file_failed_event_id is not None and event_id == self.file_failed_event_id:
            reason = _safe_parse_int(arg1, 0)
            failed_fragment = None
            with self.lock:
                for key, entry in list(self.waiting_downloads.items()):
                    if entry["account"] != account:
                        continue
                    if self._match_download_entry(entry, loaded_name):
                        self.waiting_downloads.pop(key, None)
                        failed_fragment = entry["fragment"]
            if failed_fragment is not None and reason != 1:
                _notify(failed_fragment, "Не удалось загрузить видеофайл", "error")

    def _schedule_meta_extraction(self, message_obj, local_path, matched_ext, file_name, fragment, notify_ready=False):
        msg_key = _msg_cache_key(message_obj)
        task_item = (message_obj, msg_key, matched_ext, file_name, fragment, notify_ready)

        with self.lock:
            self.pending_tasks.setdefault(local_path, []).append(task_item)
            if local_path in self.pending_paths:
                return
            self.pending_paths.add(local_path)

        def _worker():
            try:
                meta = _extract_video_info_and_thumb(local_path)
                self._put_cached_meta(local_path, meta)
            except Exception:
                meta = None
                self.logger.exception("Metadata extraction worker error")

            with self.lock:
                self.pending_paths.discard(local_path)
                tasks = self.pending_tasks.pop(local_path, [])

            if meta is None or not tasks:
                return

            def _apply_on_ui():
                show_badge = self._show_file_badge
                fragments_to_refresh = set()
                touched_groups = {}
                notified = False

                for m_obj, m_key, m_ext, m_name, frag, should_notify in tasks:
                    if m_key not in self.revealed_messages:
                        continue
                    if _apply_video_transformation(
                        m_obj,
                        meta,
                        m_ext,
                        m_name,
                        local_path,
                        self.original_states,
                        self.doc_local_paths,
                        show_badge=show_badge,
                    ):
                        gid = _get_msg_group_id(m_obj)
                        if frag is not None and _is_fragment_alive(frag):
                            fragments_to_refresh.add(frag)
                            if gid != 0:
                                touched_groups.setdefault(frag, set()).add(gid)
                        else:
                            cell = self.cell_refs.pop(m_key, None)
                            if cell is not None:
                                self._rebind_single_cell(cell, m_obj)
                        if should_notify and not notified:
                            _notify(frag, "Видео готово к просмотру", "success")
                            notified = True

                for frag in fragments_to_refresh:
                    gids = touched_groups.get(frag)
                    if gids:
                        grouped_map = get_private_field(frag, "groupedMessagesMap")
                        if grouped_map is not None:
                            for gid in gids:
                                try:
                                    grp = grouped_map.get(_jlong(gid))
                                    if grp is not None:
                                        _recalculate_group_for_videos(
                                            grouped_map, gid, grp, self.detached_groups, self.logger
                                        )
                                except Exception:
                                    pass
                    self._refresh_chat_ui(frag)

            run_on_ui_thread(_apply_on_ui)

        run_on_queue(_worker, PLUGINS_QUEUE)

    def _rebind_single_cell(self, cell, message_obj):
        try:
            if not hasattr(cell, "getMessageObject") or not hasattr(cell, "setMessageObject"):
                return
            cur_msg = cell.getMessageObject()
            if cur_msg is None or _msg_cache_key(cur_msg) != _msg_cache_key(message_obj):
                return
            p_bot = _jbool(cell.isPinnedBottom()) if hasattr(cell, "isPinnedBottom") else _jbool(False)
            p_top = _jbool(cell.isPinnedTop()) if hasattr(cell, "isPinnedTop") else _jbool(False)
            f_in = _jbool(cell.isFirstInChat()) if hasattr(cell, "isFirstInChat") else _jbool(False)
            try:
                cell.setMessageObject(message_obj, None, p_bot, p_top, f_in)
            except Exception:
                try:
                    cell.setMessageObject(message_obj, None, p_bot, p_top)
                except Exception:
                    pass
            cell.requestLayout()
            cell.invalidate()
        except Exception:
            pass

    def _collect_chat_messages(self, fragment):
        collected = {}
        if fragment is None:
            return []

        msgs_list = get_private_field(fragment, "messages")
        if msgs_list is not None:
            try:
                for i in range(msgs_list.size()):
                    m = msgs_list.get(i)
                    if m is not None:
                        collected[int(m.getId())] = m
            except Exception:
                pass

        chat_list = (
            fragment.getChatListView()
            if hasattr(fragment, "getChatListView")
            else get_private_field(fragment, "chatListView")
        )
        if chat_list is not None:
            for i in range(chat_list.getChildCount()):
                child = chat_list.getChildAt(i)
                if child is not None and hasattr(child, "getMessageObject"):
                    m = child.getMessageObject()
                    if m is not None:
                        collected[int(m.getId())] = m

        return list(collected.values())

    def _split_video_candidates(self, candidates):
        allow_ts = self._allow_ts
        cached = []
        uncached = []
        uncached_bytes = 0

        for msg in candidates:
            if msg is None:
                continue
            doc = msg.getDocument()
            is_candidate, _, _ = _is_video_doc(msg, doc, allow_ts=allow_ts)
            if not is_candidate:
                continue
            local_path = _resolve_msg_local_path(msg)
            if local_path:
                cached.append(msg)
            else:
                uncached.append(msg)
                try:
                    uncached_bytes += max(0, int(getattr(doc, "size", 0)))
                except Exception:
                    pass

        return cached, uncached, uncached_bytes

    def _convert_message_list(self, candidates, fragment, allow_download=False):
        immediate_count = 0
        queued_count = 0
        download_count = 0
        matched_count = 0
        touched_group_ids = set()

        allow_ts = self._allow_ts
        show_badge = self._show_file_badge
        auto_download = allow_download and self._auto_download

        for msg in candidates:
            if msg is None:
                continue
            doc = msg.getDocument()
            is_candidate, matched_ext, file_name = _is_video_doc(msg, doc, allow_ts=allow_ts)
            if not is_candidate:
                continue

            matched_count += 1
            msg_key = _msg_cache_key(msg)
            self.hidden_messages.discard(msg_key)

            local_path = _resolve_msg_local_path(msg)
            if not local_path:
                if auto_download and self._start_file_download(msg, matched_ext, file_name, fragment):
                    download_count += 1
                continue

            self.revealed_messages.add(msg_key)

            meta = self._get_cached_meta(local_path)
            if meta is not None:
                if _apply_video_transformation(
                    msg,
                    meta,
                    matched_ext,
                    file_name,
                    local_path,
                    self.original_states,
                    self.doc_local_paths,
                    show_badge=show_badge,
                ):
                    immediate_count += 1
                    gid = _get_msg_group_id(msg)
                    if gid != 0:
                        touched_group_ids.add(gid)
            else:
                queued_count += 1
                self._schedule_meta_extraction(msg, local_path, matched_ext, file_name, fragment)

        grouped_map = get_private_field(fragment, "groupedMessagesMap")
        if grouped_map is not None and touched_group_ids:
            for gid in touched_group_ids:
                try:
                    grp = grouped_map.get(_jlong(gid))
                    if grp is not None:
                        _recalculate_group_for_videos(
                            grouped_map, gid, grp, self.detached_groups, self.logger
                        )
                except Exception:
                    self.logger.exception("groupedMessagesMap lookup error")

        return immediate_count, queued_count, download_count, matched_count

    def _execute_reveal(self, candidates, fragment, allow_download, is_single=False):
        immediate, queued, downloading, matched = self._convert_message_list(
            candidates, fragment, allow_download=allow_download
        )
        if immediate > 0:
            self._refresh_chat_ui(fragment)

        total_revealed = immediate + queued
        if total_revealed > 0:
            if not is_single:
                if downloading > 0:
                    _notify(fragment, f"Показано: {total_revealed}, загружается: {downloading}", "success")
                else:
                    _notify(fragment, f"Показано видеофайлов: {total_revealed}", "success")
            elif downloading > 0:
                _notify(fragment, f"Показано: {total_revealed}, загружается: {downloading}", "info")
        else:
            if downloading > 0:
                if is_single and downloading == 1:
                    _notify(fragment, "Загрузка видеофайла...", "info")
                else:
                    _notify(fragment, f"Загрузка видеофайлов: {downloading}...", "info")
            elif is_single:
                if matched == 0:
                    _notify(fragment, "Формат файла отключён в настройках или не поддерживается", "info")
                else:
                    _notify(fragment, "Сначала скачайте видеофайл", "info")
            else:
                _notify(fragment, "Новых скачанных видеофайлов не найдено", "info")

    def _show_bulk_download_confirm(self, fragment, cached_msgs, uncached_msgs, uncached_bytes, is_single=False):
        activity = self._get_activity(fragment)
        if activity is None:
            self._execute_reveal(cached_msgs + uncached_msgs, fragment, allow_download=True, is_single=is_single)
            return

        size_str = _format_bytes(uncached_bytes)
        title_text = "Слишком много видеофайлов"
        body_text = (
            f"Найдено {len(uncached_msgs)} нескачанных видеофайлов ({size_str}). "
            "Загрузить и показать их все?"
        )

        def _on_download_all(builder, _which):
            builder.dismiss()
            self._execute_reveal(cached_msgs + uncached_msgs, fragment, allow_download=True, is_single=is_single)

        def _on_cached_only(builder, _which):
            builder.dismiss()
            self._execute_reveal(cached_msgs, fragment, allow_download=False, is_single=is_single)

        def _on_cancel(builder, _which):
            builder.dismiss()

        def _open_dialog():
            try:
                builder = AlertDialogBuilder(activity)
                builder.set_title(title_text)
                builder.set_message(body_text)
                builder.set_positive_button("Скачать все", _on_download_all)
                if cached_msgs:
                    builder.set_neutral_button("Только скачанные", _on_cached_only)
                builder.set_negative_button("Отмена", _on_cancel)
                builder.show()
            except Exception:
                self._execute_reveal(cached_msgs + uncached_msgs, fragment, allow_download=True, is_single=is_single)

        run_on_ui_thread(_open_dialog)

    def _revert_message_list(self, candidates, fragment):
        reverted_count = 0
        reverted_by_gid = {}

        for msg in candidates:
            if msg is None:
                continue
            key = _msg_cache_key(msg)
            if key not in self.revealed_messages and key not in self.original_states:
                continue

            self.revealed_messages.discard(key)
            self.hidden_messages.add(key)

            saved = self.original_states.get(key)
            orig_gid = saved.get("grouped_id", 0) if saved is not None else 0

            if _revert_video_transformation(msg, self.original_states, self.doc_local_paths):
                reverted_count += 1
                gid = _get_msg_group_id(msg) or orig_gid
                if gid != 0:
                    reverted_by_gid.setdefault(gid, []).append(msg)

        grouped_map = get_private_field(fragment, "groupedMessagesMap")
        if reverted_by_gid:
            for gid, msgs in reverted_by_gid.items():
                try:
                    grp = grouped_map.get(_jlong(gid)) if grouped_map is not None else None
                    _restore_group_as_documents(
                        grouped_map, gid, grp, msgs, self.detached_groups, self.logger
                    )
                except Exception:
                    self.logger.exception("Group restore lookup error")

        return reverted_count

    def _refresh_chat_ui(self, fragment):
        if not _is_fragment_alive(fragment):
            return
        try:
            grouped_map = get_private_field(fragment, "groupedMessagesMap")
            chat_list = (
                fragment.getChatListView()
                if hasattr(fragment, "getChatListView")
                else get_private_field(fragment, "chatListView")
            )
            if chat_list is None:
                return

            try:
                adapter = chat_list.getAdapter()
                if adapter is not None:
                    adapter.notifyDataSetChanged()
            except Exception:
                pass

            for i in range(chat_list.getChildCount()):
                child = chat_list.getChildAt(i)
                if child is not None and hasattr(child, "getMessageObject") and hasattr(child, "setMessageObject"):
                    c_msg = child.getMessageObject()
                    if c_msg is not None:
                        c_grp = None
                        gid = _get_msg_group_id(c_msg)
                        if gid != 0 and grouped_map is not None:
                            try:
                                candidate_grp = grouped_map.get(_jlong(gid))
                                if candidate_grp is not None and getattr(candidate_grp, "messages", None) is not None:
                                    if candidate_grp.messages.size() > 1:
                                        c_grp = candidate_grp
                            except Exception:
                                pass

                        p_bot = _jbool(child.isPinnedBottom()) if hasattr(child, "isPinnedBottom") else _jbool(False)
                        p_top = _jbool(child.isPinnedTop()) if hasattr(child, "isPinnedTop") else _jbool(False)
                        f_in = _jbool(child.isFirstInChat()) if hasattr(child, "isFirstInChat") else _jbool(False)
                        try:
                            child.setMessageObject(c_msg, c_grp, p_bot, p_top, f_in)
                        except Exception:
                            try:
                                child.setMessageObject(c_msg, c_grp, p_bot, p_top)
                            except Exception:
                                pass
                        child.requestLayout()
                        child.invalidate()

            chat_list.invalidateViews()
        except Exception:
            self.logger.exception("Refresh UI error")

    def on_reveal_chat_videos(self, context):
        try:
            fragment = context.get("fragment")
            if fragment is None:
                return

            candidates = self._collect_chat_messages(fragment)
            if not self._auto_download:
                self._execute_reveal(candidates, fragment, allow_download=False, is_single=False)
                return

            cached_msgs, uncached_msgs, uncached_bytes = self._split_video_candidates(candidates)
            threshold = self._get_download_threshold()
            if len(uncached_msgs) >= threshold:
                self._show_bulk_download_confirm(
                    fragment, cached_msgs, uncached_msgs, uncached_bytes, is_single=False
                )
            else:
                self._execute_reveal(candidates, fragment, allow_download=True, is_single=False)
        except Exception:
            self.logger.exception("on_reveal_chat_videos error")

    def on_hide_chat_videos(self, context):
        try:
            fragment = context.get("fragment")
            if fragment is None:
                return

            candidates = self._collect_chat_messages(fragment)
            count = self._revert_message_list(candidates, fragment)

            try:
                dialog_id = int(fragment.getDialogId())
                for k in list(self.revealed_messages):
                    if k[1] == dialog_id:
                        self.revealed_messages.discard(k)
                        self.hidden_messages.add(k)
                for k in [k for k in self.original_states.keys() if k[1] == dialog_id]:
                    self.original_states.pop(k, None)
                with self.lock:
                    for k in [k for k in self.waiting_downloads.keys() if k[1] == dialog_id]:
                        self.waiting_downloads.pop(k, None)
            except Exception:
                pass

            self._refresh_chat_ui(fragment)

            if count > 0:
                _notify(fragment, f"Скрыто обратно в файлы: {count}", "info")
            else:
                _notify(fragment, "Нет открытых видеофайлов для скрытия", "info")
        except Exception:
            self.logger.exception("on_hide_chat_videos error")

    def on_reveal_single_message(self, context):
        try:
            fragment = context.get("fragment")
            msg = context.get("message")
            if msg is None or _is_non_document_media(msg):
                return

            targets = [msg]
            gid = _get_msg_group_id(msg)
            if gid != 0 and fragment is not None:
                grouped_map = get_private_field(fragment, "groupedMessagesMap")
                if grouped_map is not None:
                    try:
                        grp = grouped_map.get(_jlong(gid))
                        if grp is not None and getattr(grp, "messages", None) is not None:
                            targets = [grp.messages.get(i) for i in range(grp.messages.size())]
                    except Exception:
                        pass

            if self._auto_download and len(targets) > 1:
                cached_msgs, uncached_msgs, uncached_bytes = self._split_video_candidates(targets)
                threshold = self._get_download_threshold()
                if len(uncached_msgs) >= threshold:
                    self._show_bulk_download_confirm(
                        fragment, cached_msgs, uncached_msgs, uncached_bytes, is_single=True
                    )
                    return

            self._execute_reveal(targets, fragment, allow_download=True, is_single=True)
        except Exception:
            self.logger.exception("on_reveal_single_message error")

    def on_hide_single_message(self, context):
        try:
            fragment = context.get("fragment")
            msg = context.get("message")
            if msg is None:
                return

            targets = [msg]
            gid = _get_msg_group_id(msg)
            if gid != 0 and fragment is not None:
                grouped_map = get_private_field(fragment, "groupedMessagesMap")
                if grouped_map is not None:
                    try:
                        grp = grouped_map.get(_jlong(gid))
                        if grp is not None and getattr(grp, "messages", None) is not None:
                            targets = [grp.messages.get(i) for i in range(grp.messages.size())]
                    except Exception:
                        pass

            count = self._revert_message_list(targets, fragment)
            self._refresh_chat_ui(fragment)

            if count == 0:
                _notify(fragment, "Этот файл не был открыт из документа", "info")
        except Exception:
            self.logger.exception("on_hide_single_message error")
