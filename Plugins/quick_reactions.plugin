FX_BOX = "qr_fx_box"
EFFECT_FLAG = 1 << 18
FX_REQUESTS = ("TL_messages_sendMessage", "TL_messages_sendMedia", "TL_messages_sendMultiMedia")
MARKER_ROW = "qr_row"
DONE_KEY = 0x7e00cd10
SIG_KEY = 0x7e00cd11
PL_KEY = 0x7e00cd12
STATE_KEY = 0x7e00cd14
ATTACH_KEY = 0x7e00cd15
VAL_KEY = 0x7e00cd16
DEFAULT_SLOTS = "❤ 👍 🔥 😁 😢 🎉"
BTN_DP = 40
MAX_ROW_DP = 210
RCL_TYPE_EFFECTS = 5
