}
EMOJI_DISPLAY = {"✍": "✍️", "☃": "☃️", "🕊": "🕊️", "❤": "❤️", "⚡": "⚡️"}

_PLUGIN = None
_FIELD_CACHE = {}
_MISSING = object()


def dp(v):
    return AndroidUtilities.dp(v)


class _Run(dynamic_proxy(JRunnable)):
    def __init__(self, fn):
        super().__init__()
        self._fn = fn

    def run(self):
        try:
            self._fn()
        except Exception:
            pass


class _LongClick(dynamic_proxy(View.OnLongClickListener)):
    def __init__(self, fn):
        super().__init__()
        self._fn = fn

    def onLongClick(self, v):
        try:
            self._fn()
        except Exception:
            pass
        return True


class _Attach(dynamic_proxy(View.OnAttachStateChangeListener)):
    def onViewAttachedToWindow(self, v):
        try:
            d = v.getTag(STATE_KEY)
            if d is not None:
                d.addView(v)
                _apply_bounds(v, d)
        except Exception:
            pass

    def onViewDetachedFromWindow(self, v):
        try:
            d = v.getTag(STATE_KEY)
            if d is not None:
                d.removeView(v)
        except Exception:
            pass


def _field(obj, name):
    try:
        cls = obj.getClass()
        key = (str(cls.getName()), name)
    except Exception:
        return None
    f = _FIELD_CACHE.get(key, _MISSING)
    if f is _MISSING:
        f = None
        c = cls
        while c is not None:
            try:
                f = c.getDeclaredField(name)
                f.setAccessible(True)
                break
            except Exception:
                f = None
            try:
                c = c.getSuperclass()
            except Exception:
                break
        _FIELD_CACHE[key] = f
    if f is None:
        return None
    try:
        return f.get(obj)
    except Exception:
        return None


def _class_name(obj):
    try:
        return str(obj.getClass().getName())
    except Exception:
        return ""


def _res(name):
    try:
        return int(getattr(R.drawable, name))
    except Exception:
        return 0


def _theme(key, fallback):
    try:
        return int(Theme.getColor(getattr(Theme, key)))
    except Exception:
        return fallback


def _icon_color():
    return _theme("key_actionBarDefaultSubmenuItemIcon", -7829368)


def _tv_text(tv):
    try:
        t = tv.getText()
        return str(t).strip() if t else ""
    except Exception:
        return ""


def _item_text(item):
    for name in ("textView", "text", "titleView"):
        v = _field(item, name)
        if v is not None:
            s = _tv_text(v)
            if s:
                return s
    return ""


def _child_with_tag(parent, tag):
    try:
        for i in range(parent.getChildCount()):
            ch = parent.getChildAt(i)
            if ch.getTag() == tag:
                return ch
    except Exception:
        pass
    return None


def _natives(item):
    out = []
    for name in ("textView", "imageView", "checkView", "rightIcon", "subtextView"):
        v = _field(item, name)
        if v is not None and isinstance(v, View):
            out.append(v)
    return out


def _is_custom(e):
    return str(e).startswith("animated_")


def _emoji_disp(e):
    e = (e or "").replace("\ufe0f", "")
    return EMOJI_DISPLAY.get(e, e)


def _label(e):
    return "Премиум-эмодзи" if _is_custom(e) else _emoji_disp(e)


def _acc():
    try:
        return int(UserConfig.selectedAccount)
    except Exception:
        return 0


def _emoji_drawable(e):
    base = (e or "").replace("\ufe0f", "")
    for cand in (_emoji_disp(e), base, base + "\ufe0f"):
        try:
            d = Emoji.getEmojiDrawable(cand)
            if d is not None:
                return d
        except Exception:
            pass
    return None


def _custom_drawable(did, view):
    try:
        from java import jclass
        AED = jclass("org.telegram.ui.Components.AnimatedEmojiDrawable")
    except Exception:
        return None
    try:
        cache = int(getattr(AED, "CACHE_TYPE_KEYBOARD", 1))
    except Exception:
        cache = 1
    acc = _acc()
    d = None
    for args in ((acc, cache, jlong(int(did))),
                 (acc, cache, jlong(int(did)), False),
                 (acc, cache, jlong(int(did)), None)):
        try:
            d = AED.make(*args)
        except Exception:
            d = None
        if d is not None:
            break
    if d is not None and view is not None:
        try:
            d.addView(view)
        except Exception:
            pass
    return d


def _apply_bounds(iv, d, default_dp=28):
    try:
        w = int(iv.getWidth()) or dp(default_dp)
        h = int(iv.getHeight()) or dp(default_dp)
        d.setBounds(0, 0, w, h)
        iv.invalidate()
    except Exception:
        pass


def _release_iv(iv):
    try:
        d = iv.getTag(STATE_KEY)
        if d is not None:
            d.removeView(iv)
            iv.setTag(STATE_KEY, None)
    except Exception:
        pass
    try:
        iv.setImageDrawable(None)
    except Exception:
        pass


def _set_reaction(iv, value):
    _release_iv(iv)
    if iv.getTag(ATTACH_KEY) is None:
        iv.setTag(ATTACH_KEY, "1")
        iv.addOnAttachStateChangeListener(_Attach())
    d = None
    holder = None
    custom = _is_custom(value)
    if custom:
        try:
            holder = _custom_drawable(int(str(value).split("_", 1)[1]), iv)
        except Exception:
            holder = None
        d = holder
    else:
        d = _emoji_drawable(value)
    if d is None:
        d = _emoji_drawable("\u2b50")
        custom = False
        holder = None
    try:
        iv.setScaleType(ImageView.ScaleType.FIT_XY if custom else ImageView.ScaleType.FIT_CENTER)
        iv.setImageDrawable(d)
    except Exception:
        pass
    if holder is not None:
        _apply_bounds(iv, holder)
    if holder is not None:
        iv.setTag(STATE_KEY, holder)


def _reaction_view(ctx, value):
    iv = ImageView(ctx)
    _set_reaction(iv, value)
    return iv


class _ItemHook(MethodHook):
    def __init__(self, plugin, tag):
        self.plugin = plugin
        self.tag = tag

    def after_hooked_method(self, param):
        try:
            item = param.thisObject
            if item is not None:
                self.plugin._on_item(item, self.tag)
        except Exception:
            pass


class _SendParamsHook(MethodHook):

    def __init__(self, plugin):
        self.p = plugin

    def before_hooked_method(self, param):
        try:
            if len(param.args):
                self.p._on_send_params(param.args[0])
        except Exception:
            pass


class _DoubleTapRandomHook(MethodHook):

    def __init__(self, plugin):
        self.p = plugin

    def after_hooked_method(self, param):
        try:
            self.p._random_double_tap(param)
        except Exception:
            pass


class _BoxAttach(dynamic_proxy(View.OnAttachStateChangeListener)):

    def __init__(self, plugin):
        super().__init__()
        self.p = plugin

    def onViewAttachedToWindow(self, v):
        try:
            for d in (0, 150):
                self.p._post(lambda: self.p._fill_fx_box(v), d)
        except Exception:
            pass

    def onViewDetachedFromWindow(self, v):
        pass


class _RclWindowHook(MethodHook):

    def __init__(self, plugin):
        self.p = plugin

    def after_hooked_method(self, param):
        try:
            self.p._schedule_fix_window(param.thisObject)
        except Exception:
            pass


def _make_factory(create, bind, **kwargs):
    while True:
        try:
            return SimpleSettingFactory(create, bind, **kwargs)
        except TypeError:
            for k in ("content_equals", "is_shadow"):
                if k in kwargs:
                    del kwargs[k]
                    break
            else:
                raise


def _row_create(context, list_view=None):
    outer = FrameLayout(context)
    try:
        from java import jclass
        outer.setLayoutParams(jclass("androidx.recyclerview.widget.RecyclerView$LayoutParams")(-1, -2))
    except Exception:
        pass
    row = LinearLayout(context)
    row.setOrientation(LinearLayout.HORIZONTAL)
    row.setGravity(Gravity.CENTER_VERTICAL)
    row.setPadding(dp(16), dp(10), dp(16), dp(10))
    row.setMinimumHeight(dp(56))
    outer.addView(row, FrameLayout.LayoutParams(-1, -2))

    react = FrameLayout(context)
    row.addView(react, LinearLayout.LayoutParams(dp(28), dp(28)))

    col = LinearLayout(context)
    col.setOrientation(LinearLayout.VERTICAL)
    clp = LinearLayout.LayoutParams(0, -2, 1.0)
    clp.setMargins(dp(16), 0, dp(8), 0)
    row.addView(col, clp)

    title = TextView(context)
    title.setTextSize(2, 16.0)
    title.setTextColor(_theme("key_windowBackgroundWhiteBlackText", -16777216))
    title.setSingleLine(True)
    col.addView(title, LinearLayout.LayoutParams(-2, -2))

    return outer


def _row_bind(view, index, kind="react"):
    p = _PLUGIN
    if p is None:
        return
    try:
        row = view.getChildAt(0)
        react = row.getChildAt(0)
        col = row.getChildAt(1)
        if kind == "fx":
            slots = [e for e, _ in p._fx_slots()]
            title = "Анимация %d" % (index + 1)
        else:
            slots = p._slots()
            title = "Слот %d" % (index + 1)
        if index >= len(slots):
            return
        value = slots[index]
        col.getChildAt(0).setText(title)
        if react.getChildCount() > 0 and react.getTag(VAL_KEY) == value:
            return
        react.setTag(VAL_KEY, value)
        try:
            for i in range(react.getChildCount()):
                _release_iv(react.getChildAt(i))
        except Exception:
            pass
        react.removeAllViews()
        react.addView(_reaction_view(view.getContext(), value), FrameLayout.LayoutParams(-1, -1))
    except Exception:
        pass


def _make_row_factory(index, kind="react"):
    if kind == "fx":
        on_click = lambda plugin, item, view, i=index: _PLUGIN and _PLUGIN.replace_fx_slot(i)
        on_long = lambda plugin, item, view, i=index: (_PLUGIN and _PLUGIN.remove_fx_slot(i), True)[1]
    else:
        on_click = lambda plugin, item, view, i=index: _PLUGIN and _PLUGIN.replace_slot(i)
        on_long = lambda plugin, item, view, i=index: (_PLUGIN and _PLUGIN.remove_slot(i), True)[1]
    kwargs = {
        "is_clickable": True,
        "is_shadow": False,
        "on_click": on_click,
        "on_long_click": on_long,
        "content_equals": lambda a, b: False,
    }
    create = lambda context, list_view, account, class_guid, resources_provider: _row_create(context, list_view)
    bind = lambda view, item, divider, adapter, list_view, i=index, k=kind: _row_bind(view, i, k)
    return _make_factory(create, bind, **kwargs)


_ROW_FACTORIES = {}
_FX_ROW_FACTORIES = {}
if SimpleSettingFactory is not None:
    try:
        for _i in range(MAX_SLOTS):
            _ROW_FACTORIES[_i] = _make_row_factory(_i)
            _FX_ROW_FACTORIES[_i] = _make_row_factory(_i, "fx")
    except Exception:
        _ROW_FACTORIES = {}
        _FX_ROW_FACTORIES = {}


def _safe_item(cls, optional, **kw):
    while True:
        try:
            return cls(**kw)
        except TypeError:
            for k in optional:
                if k in kw:
                    del kw[k]
                    break
            else:
                raise


class QuickReactionsPlugin(BasePlugin):

    def __init__(self):
        super().__init__()
        self._active = False
        self._items = {}
        self._hooks = []
        self._plugins_ref = None
        self._latest_ref = None
        self._fx_ref = None
        self._fx_boxes = {}
        self._fx_switches = {}
        self._effects = []
        self._effects_loading = False
        self._effects_waiters = []
        self._fx_field = ""
        self._fx_popup = None
        self._picker_cb = None
        self._picker_type = None
        self._native_layout = None
        self._native_layout_obj = None
        self._card_w = 0
        self._card_top = None
        self._nat_measured = False
        self._reading_current = False
        self._rand_cache = None
        self._flags = {}

    def on_plugin_load(self):
        global _PLUGIN
        _PLUGIN = self
        self._active = True
        for title in (TITLE, TITLE_FX):
            try:
                self.add_menu_item(MenuItemData(
                    menu_type=MenuItemType.CHAT_ACTION_MENU,
                    text=title,
                    icon="msg_reactions",
                    on_click=lambda ctx: None,
                ))
            except Exception:
                pass
        for name in FX_REQUESTS:
            try:
                self.add_hook(name)
            except Exception:
                pass
        self._hook_subitem()
        self._hook_send_params()
        self._hook_double_tap()
        self._hook_rcl_window()
        self._post(lambda: self._load_effects(self._refresh_fx), 1500)

    def on_plugin_unload(self):
        global _PLUGIN
        _PLUGIN = None
        self._active = False
        for h in self._hooks:
            try:
                self.unhook_method(h)
            except Exception:
                pass
        self._hooks = []
        for name in FX_REQUESTS:
            try:
                self.remove_hook(name)
            except Exception:
                pass
        items = [r.get() for r in self._items.values() if r.get() is not None]
        boxes = [r.get() for r in self._fx_boxes.values() if r.get() is not None]
        self._items.clear()
        self._fx_boxes.clear()
        self._fx_switches.clear()
        self._effects = []
        self._effects_waiters = []
        self._picker_cb = None
        self._rand_cache = None
        self._flags.clear()
        run_on_ui_thread(self._close_native_fx)
        run_on_ui_thread(lambda: [self._release(i) for i in items])
        run_on_ui_thread(lambda: [self._remove_fx_box(b) for b in boxes])

    def _hook_double_tap(self):
        n = 0
        try:
            c = Class.forName("org.telegram.messenger.MediaDataController")
            for m in c.getDeclaredMethods():
                if str(m.getName()) == "getDoubleTapReaction" and len(m.getParameterTypes()) == 0:
                    m.setAccessible(True)
                    self._hooks.append(self.hook_method(m, _DoubleTapRandomHook(self)))
                    n += 1
        except Exception:
            pass
        return n

    def _random_double_tap(self, param):
        if self._reading_current or not self._flag("rand_react"):
            return
        now = time.time()
        cache = self._rand_cache
        if cache is not None and now - cache[1] < 0.6:
            val = cache[0]
        else:
            premium = self._is_premium()
            pool = [v for v in self._slots() if premium or not _is_custom(v)]
            if not pool:
                return
            val = random.choice(pool)
            self._rand_cache = (val, now)
        param.setResult(val)

    def _get_bool(self, key):
        try:
            return bool(self.get_setting(key, False))
        except Exception:
            return False

    def _flag(self, key):
        now = time.time()
        c = self._flags.get(key)
        if c is not None and now - c[1] < 1.0:
            return c[0]
        v = self._get_bool(key)
        self._flags[key] = (v, now)
        return v

    def _hook_rcl_window(self):
        n = 0
        try:
            c = Class.forName("org.telegram.ui.Components.ReactionsContainerLayout")
            for m in c.getDeclaredMethods():
                if str(m.getName()) == "onCustomEmojiWindowOpened":
                    m.setAccessible(True)
                    self._hooks.append(self.hook_method(m, _RclWindowHook(self)))
                    n += 1
        except Exception:
            pass
        return n

    def _hook_send_params(self):
        n = 0
        try:
            cls = Class.forName("org.telegram.messenger.SendMessagesHelper")
            for m in cls.getDeclaredMethods():
                try:
                    if str(m.getName()) != "sendMessage":
                        continue
                    types = m.getParameterTypes()
                    if len(types) == 1 and str(types[0].getName()).endswith("SendMessageParams"):
                        m.setAccessible(True)
                        self._hooks.append(self.hook_method(m, _SendParamsHook(self)))
                        n += 1
                except Exception:
                    pass
        except Exception:
            pass
        return n

    def _effect_field(self, sp):
        if self._fx_field != "":
            return self._fx_field or None
        name = None
        try:
            for f in sp.getClass().getDeclaredFields():
                if "effect" in str(f.getName()).lower() and str(f.getType().getName()) == "long":
                    name = str(f.getName())
                    break
        except Exception:
            pass
        self._fx_field = name
        return name

    def _on_send_params(self, sp):
        if sp is None or not self._fx_enabled():
            return
        peer = int(getattr(sp, "peer", 0))
        if peer <= 0:
            return
        try:
            me = int(UserConfig.getInstance(_acc()).getClientUserId())
        except Exception:
            me = 0
        if peer == me:
            return
        field = self._effect_field(sp)
        if not field:
            return
        if int(getattr(sp, field, 0)):
            return
        fid = self._fx_choose()
        if not fid:
            return
        setattr(sp, field, int(fid))

    def _hook_subitem(self):
        n = 0
        try:
            jcls = Class.forName("org.telegram.ui.ActionBar.ActionBarMenuSubItem")
        except Exception:
            return n
        wanted = {"setTextAndIcon", "setText", "onAttachedToWindow"}
        for m in list(jcls.getDeclaredMethods()):
            try:
                if str(m.getName()) in wanted:
                    m.setAccessible(True)
                    self._hooks.append(self.hook_method(m, _ItemHook(self, str(m.getName()))))
                    n += 1
            except Exception:
                pass
        return n

    def create_settings(self) -> List[Any]:
        global _PLUGIN
        _PLUGIN = self
        items = [Header(text="Слоты реакций")]
        if Switch is not None:
            items.append(_safe_item(Switch, ("subtext", "icon", "on_change"),
                                    key="rand_react", text="Рандомные реакции", default=False, icon="menu_random"))
        slots = self._slots()
        for i, value in enumerate(slots[:MAX_SLOTS]):
            f = _ROW_FACTORIES.get(i)
            if f is not None and Custom is not None:
                try:
                    items.append(_safe_item(Custom, ("factory_args",), factory=f.instance.java))
                    continue
                except Exception:
                    pass
            items.append(_safe_item(
                Text, ("on_long_click", "icon"),
                text="Слот %d: %s" % (i + 1, _label(value)),
                icon="msg_reactions",
                on_click=lambda _v, k=i: self.replace_slot(k),
                on_long_click=lambda _v, k=i: (self.remove_slot(k), True)[1],
            ))
        items.append(Header(text="Слоты анимаций"))
        if Switch is not None:
            items.append(_safe_item(Switch, ("subtext", "icon", "on_change"),
                                    key="rand_fx", text="Рандомные анимации", default=False, icon="menu_random"))
        for i, (emoji, _eid) in enumerate(self._fx_slots()[:MAX_SLOTS]):
            f = _FX_ROW_FACTORIES.get(i)
            if f is not None and Custom is not None:
                try:
                    items.append(_safe_item(Custom, ("factory_args",), factory=f.instance.java))
                    continue
                except Exception:
                    pass
            items.append(_safe_item(
                Text, ("on_long_click", "icon"),
                text="Анимация %d: %s" % (i + 1, _emoji_disp(emoji)),
                icon="msg_reactions",
                on_click=lambda _v, k=i: self.replace_fx_slot(k),
                on_long_click=lambda _v, k=i: (self.remove_fx_slot(k), True)[1],
            ))
        return items

    def _reload_settings(self, key, value):
        try:
            self.set_setting(key, value, reload_settings=True)
        except TypeError:
            self.set_setting(key, value)

    def _slots(self):
        raw = self.get_setting("slots", DEFAULT_SLOTS) or ""
        return [s for s in str(raw).split() if s]

    def _save_slots(self, slots):
        self._reload_settings("slots", " ".join(slots))
        self._post(self._refresh_all, 50)

    def replace_slot(self, i):
        def cb(value):
            slots = self._slots()
            if 0 <= i < len(slots):
                slots[i] = value
                self._save_slots(slots)
        self.open_picker(cb)

    def add_slot(self):
        def cb(value):
            slots = self._slots()
            if len(slots) >= MAX_SLOTS:
                BulletinHelper.show_error("Слишком много реакций")
                return
            if value in slots:
                BulletinHelper.show_info("Такая реакция уже есть")
                return
            slots.append(value)
            self._save_slots(slots)
        self.open_picker(cb)

    def remove_slot(self, i):
        slots = self._slots()
        if 0 <= i < len(slots):
            del slots[i]
            self._save_slots(slots)
            BulletinHelper.show_info("Реакция удалена")

    def _mdc(self):
        return MediaDataController.getInstance(_acc())

    def _current(self):
        self._reading_current = True
        try:
            c = self._mdc().getDoubleTapReaction()
            return str(c) if c else ""
        except Exception:
            return ""
        finally:
            self._reading_current = False

    def _set_current(self, value):
        try:
            self._mdc().setDoubleTapReaction(value)
        except Exception:
            BulletinHelper.show_error("Не удалось сменить реакцию")

    def _fx_enabled(self):
        try:
            return bool(self.get_setting("fx_enabled", False))
        except Exception:
            return False

    def _fx_slots(self):
        out = []
        try:
            raw = self.get_setting("fx_slots", "") or ""
            for tok in str(raw).split():
                if "|" in tok:
                    e, i = tok.split("|", 1)
                    out.append((e, int(i)))
        except Exception:
            pass
        return out

    def _save_fx_slots(self, slots):
        self._reload_settings("fx_slots", " ".join("%s|%d" % (e, i) for e, i in slots))

    def _fx_usable(self, eid):
        if self._is_premium():
            return True
        for e in self._effects:
            if e["id"] == eid:
                return not e["premium"]
        return True

    def _fx_choose(self):
        slots = self._fx_slots()
        if not slots:
            return 0
        if self._get_bool("rand_fx"):
            pool = [i for _, i in slots if self._fx_usable(i)]
            return random.choice(pool) if pool else 0
        return self._fx_id()

    def _fx_ready(self):
        if self._get_bool("rand_fx"):
            return bool(self._fx_slots())
        return bool(self._fx_id())

    def _fx_id(self):
        try:
            cur = int(str(self.get_setting("fx_id", "0")))
        except Exception:
            return 0
        return cur if any(i == cur for _, i in self._fx_slots()) else 0

    def _apply_effect(self, request_name, request):
        try:
            if not self._fx_enabled():
                return HookResult()
            peer = getattr(request, "peer", None)
            if peer is None or "inputpeeruser" not in _class_name(peer).lower():
                return HookResult()
            flags = int(request.flags)
            if flags & EFFECT_FLAG:
                return HookResult()
            fid = self._fx_choose()
            if not fid:
                return HookResult()
            request.effect = int(fid)
            request.flags = flags | EFFECT_FLAG
            strategy = getattr(HookStrategy, "MODIFY", None)
            if strategy is not None:
                return HookResult(strategy=strategy, request=request)
        except Exception:
            pass
        return HookResult()

    def pre_request_hook(self, request_name, account, request):
        if request_name in FX_REQUESTS:
            return self._apply_effect(request_name, request)
        return HookResult()

    def _post(self, fn, delay_ms=0):
        def safe():
            if not self._active:
                return
            try:
                fn()
            except Exception:
                pass

        try:
            ApplicationLoader.applicationHandler.postDelayed(_Run(safe), delay_ms)
        except Exception:
            run_on_ui_thread(safe)

    def _on_item(self, item, hook=""):
        if not self._active:
            return
        mark = item.getTag(DONE_KEY)
        if mark is None and hook == "onAttachedToWindow":
            return
        if mark == "fx":
            self._post(lambda: item.setVisibility(View.GONE), 0)
            return
        if mark is not None:
            if hook == "onAttachedToWindow":
                for d in (0, 150):
                    self._post(lambda: self._force_rebuild(item), d)
            else:
                self._post(lambda: self._ensure_row(item), 0)
            return
        text = _item_text(item)
        if text.lower() in PLUGINS_TITLES:
            if item.getTag(PL_KEY) is None:
                item.setTag(PL_KEY, "1")
                self._plugins_ref = WeakReference(item)
                for d in (0, 50, 150, 400, 900):
                    self._post(self._hoist_all, d)
            return
        if text == TITLE_FX:
            item.setTag(DONE_KEY, "fx")
            self._fx_ref = WeakReference(item)
            self._post(lambda: item.setVisibility(View.GONE), 0)
            for d in (0, 100, 300, 800, 1500, 2500, 4000):
                self._post(lambda: self._place_fx(item), d)
            return
        if text != TITLE:
            return
        item.setTag(DONE_KEY, "1")
        self._prune(self._items)
        self._items[int(item.hashCode())] = WeakReference(item)
        self._latest_ref = WeakReference(item)
        self._post(lambda: self._ensure_row(item), 0)
        for d in (0, 100, 300, 800, 1500, 2500, 4000):
            self._post(lambda: self._hoist(item), d)

    @staticmethod
    def _prune(refs):
        for k in [k for k, r in refs.items() if r.get() is None]:
            del refs[k]

    @staticmethod
    def _lp(main, height):
        if isinstance(main, LinearLayout):
            return LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, height)
        return ViewGroup.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, height)

    def _force_rebuild(self, item):
        try:
            item.setTag(SIG_KEY, None)
            self._ensure_row(item)
        except Exception:
            pass

    def _in_wrapper(self, item):
        p = item
        try:
            for _ in range(4):
                p = p.getParent()
                if p is None:
                    return False
                if "PluginsMenuWrapper" in _class_name(p):
                    return True
        except Exception:
            pass
        return False

    def _hoist_all(self):
        ref = self._latest_ref
        item = ref.get() if ref is not None else None
        if item is not None:
            self._hoist(item)
        fref = self._fx_ref
        fitem = fref.get() if fref is not None else None
        if fitem is not None:
            self._place_fx(fitem)

    def _place_fx(self, item):
        try:
            if item.getParent() is None or not self._in_wrapper(item):
                return
            root = self._popup_root(item)
            if "PopupSwipeBackLayout" not in _class_name(root):
                return
            plugins = self._find_plugins_item(root)
            if plugins is None:
                return
            main = plugins.getParent()
            if main is None:
                return
            for i in range(main.getChildCount()):
                ch = main.getChildAt(i)
                if ch is not None and ch.getTag() == FX_BOX:
                    return
            box = self._build_fx_box(main.getContext())
            main.addView(box, main.getChildCount(), self._lp(main, ViewGroup.LayoutParams.WRAP_CONTENT))
            self._prune(self._fx_boxes)
            self._prune(self._fx_switches)
            self._fx_boxes[int(box.hashCode())] = WeakReference(box)
            for d in (0, 200):
                self._post(self._refresh_fx, d)
        except Exception:
            pass

    def _build_fx_box(self, ctx):
        box = LinearLayout(ctx)
        box.setOrientation(LinearLayout.VERTICAL)
        box.setTag(FX_BOX)
        self._fill_fx_box(box)
        box.addOnAttachStateChangeListener(_BoxAttach(self))
        return box

    def _remove_fx_box(self, box):
        try:
            self._clear_fx_box(box)
            par = box.getParent()
            if par is not None:
                par.removeView(box)
        except Exception:
            pass

    def _clear_fx_box(self, box):
        try:
            if box.getChildCount() > 0:
                self._release_row(box.getChildAt(0))
        except Exception:
            pass
        box.removeAllViews()

    def _make_switch(self, ctx, checked):
        w, h, pad = dp(38), dp(22), dp(3)
        size = h - 2 * pad
        sw = FrameLayout(ctx)
        track = GradientDrawable()
        track.setCornerRadius(float(h) / 2.0)
        sw.setBackground(track)
        thumb = View(ctx)
        td = GradientDrawable()
        td.setShape(GradientDrawable.OVAL)
        td.setColor(-1)
        thumb.setBackground(td)
        tlp = FrameLayout.LayoutParams(size, size, Gravity.CENTER_VERTICAL | Gravity.LEFT)
        tlp.leftMargin = pad
        sw.addView(thumb, tlp)
        self._apply_switch(sw, checked, False)
        lp = FrameLayout.LayoutParams(w, h, Gravity.CENTER_VERTICAL | Gravity.RIGHT)
        lp.rightMargin = dp(18)
        return sw, lp

    def _apply_switch(self, sw, checked, animate):
        h, pad = dp(22), dp(3)
        travel = dp(38) - (h - 2 * pad) - 2 * pad
        color = _theme("key_switchTrackChecked", -12877590) if checked else _theme("key_switchTrack", -7829368)
        try:
            sw.getBackground().setColor(color)
        except Exception:
            pass
        thumb = sw.getChildAt(0)
        x = float(travel if checked else 0)
        if animate:
            thumb.animate().translationX(x).setDuration(160).start()
        else:
            thumb.setTranslationX(x)

    def _fill_fx_box(self, box):
        self._clear_fx_box(box)
        ctx = box.getContext()
        selected = self._fx_id()
        enabled = self._fx_enabled()
        slots = self._fx_slots()

        row = LinearLayout(ctx)
        row.setOrientation(LinearLayout.HORIZONTAL)
        row.setGravity(Gravity.CENTER_VERTICAL)
        row.setPadding(dp(10), 0, dp(10), 0)
        for emoji, eid in slots:
            cell = self._cell(ctx, _reaction_view(ctx, emoji), eid == selected)
            cell.setOnClickListener(OnClickListener(lambda v, e=eid: self._fx_select(e)))
            cell.setOnLongClickListener(_LongClick(lambda e=eid: self._fx_remove(e)))
            row.addView(cell, self._cell_lp())
        plus = ImageView(ctx)
        res = _res("msg_add") or _res("input_add")
        if res:
            plus.setImageResource(res)
            plus.setScaleType(ImageView.ScaleType.CENTER)
            plus.setColorFilter(PorterDuffColorFilter(_icon_color(), PorterDuff.Mode.SRC_IN))
        pcell = self._cell(ctx, plus, False)
        pcell.setOnClickListener(OnClickListener(lambda v: self.open_fx_picker()))
        row.addView(pcell, self._cell_lp())

        holder = HorizontalScrollView(ctx)
        holder.setHorizontalScrollBarEnabled(False)
        holder.setOverScrollMode(View.OVER_SCROLL_NEVER)
        holder.addView(row, FrameLayout.LayoutParams(
            FrameLayout.LayoutParams.WRAP_CONTENT, FrameLayout.LayoutParams.MATCH_PARENT))
        width = min(dp(MAX_ROW_DP), max(dp(120), (len(slots) + 1) * dp(BTN_DP + 2) + dp(20)))
        box.addView(holder, LinearLayout.LayoutParams(width, dp(48)))

        srow = FrameLayout(ctx)
        srow.setClickable(True)
        try:
            srow.setBackground(Theme.createSelectorDrawable(Theme.getColor(Theme.key_listSelector), 2))
        except Exception:
            pass
        tv = TextView(ctx)
        tv.setText("С анимацией")
        tv.setTextSize(2, 16.0)
        tv.setSingleLine(True)
        tv.setTextColor(_theme("key_actionBarDefaultSubmenuItem", -1))
        tlp = FrameLayout.LayoutParams(FrameLayout.LayoutParams.WRAP_CONTENT,
                                       FrameLayout.LayoutParams.WRAP_CONTENT,
                                       Gravity.CENTER_VERTICAL | Gravity.LEFT)
        ires = _res("msg2_animations")
        tlp.leftMargin = dp(57) if ires else dp(18)
        tlp.rightMargin = dp(64)
        srow.addView(tv, tlp)
        if ires:
            icon = ImageView(ctx)
            icon.setImageResource(ires)
            icon.setScaleType(ImageView.ScaleType.CENTER)
            icon.setColorFilter(PorterDuffColorFilter(_icon_color(), PorterDuff.Mode.SRC_IN))
            ilp = FrameLayout.LayoutParams(dp(24), dp(24), Gravity.CENTER_VERTICAL | Gravity.LEFT)
            ilp.leftMargin = dp(18)
            srow.addView(icon, ilp)
        sw, slp = self._make_switch(ctx, enabled)
        srow.addView(sw, slp)
        self._fx_switches[int(box.hashCode())] = WeakReference(sw)
        srow.setOnClickListener(OnClickListener(lambda v: self._fx_toggle()))
        box.addView(srow, LinearLayout.LayoutParams(LinearLayout.LayoutParams.MATCH_PARENT, dp(48)))

    def _refresh_fx(self):
        for ref in list(self._fx_boxes.values()):
            box = ref.get()
            if box is not None:
                self._fill_fx_box(box)

    def _fx_select(self, eid):
        self.set_setting("fx_id", str(int(eid)))
        self._refresh_fx()

    def _fx_remove(self, eid):
        self._save_fx_slots([(e, i) for e, i in self._fx_slots() if i != eid])
        try:
            if int(str(self.get_setting("fx_id", "0"))) == eid:
                self.set_setting("fx_id", "0")
        except Exception:
            pass
        BulletinHelper.show_info("Анимация удалена")
        self._refresh_fx()

    def _fx_toggle(self):
        new = not self._fx_enabled()
        self.set_setting("fx_enabled", new)
        for ref in list(self._fx_switches.values()):
            sw = ref.get()
            if sw is None:
                continue
            try:
                self._apply_switch(sw, new, True)
            except Exception:
                pass
        if new and not self._fx_ready():
            self.open_fx_picker()

    def _load_effects(self, cb=None):
        if self._effects:
            if cb:
                run_on_ui_thread(cb)
            return
        if cb:
            self._effects_waiters.append(cb)
        if self._effects_loading:
            return
        self._effects_loading = True
        try:
            from java import jclass
            req = jclass("org.telegram.tgnet.TLRPC$TL_messages_getAvailableEffects")()
            req.hash = 0
            plugin = self

            class _Delegate(dynamic_proxy(jclass("org.telegram.tgnet.RequestDelegate"))):
                def run(self_, response, error):
                    plugin._on_effects(response, error)

            jclass("org.telegram.tgnet.ConnectionsManager").getInstance(_acc()).sendRequest(req, _Delegate())
        except Exception:
            self._effects_loading = False

    def _on_effects(self, response, error):
        try:
            if error is not None:
                return
            effects = getattr(response, "effects", None)
            if effects is None:
                return
            lst = []
            for i in range(int(effects.size())):
                e = effects.get(i)
                lst.append({
                    "id": int(e.id),
                    "emoji": str(e.emoticon),
                    "premium": bool(getattr(e, "premium_required", False)),
                    "sticker": int(getattr(e, "effect_sticker_id", 0)),
                    "icon": int(getattr(e, "static_icon_id", 0)),
                })
            self._effects = lst
        except Exception:
            pass
        finally:
            self._effects_loading = False
            waiters = self._effects_waiters
            self._effects_waiters = []
            for w in waiters:
                run_on_ui_thread(w)

    def _is_premium(self):
        try:
            return bool(UserConfig.getInstance(_acc()).isPremium())
        except Exception:
            return True


    def open_fx_picker(self):
        def go():
            if not self._show_picker(RCL_TYPE_EFFECTS, self._on_fx_reaction):
                BulletinHelper.show_error("Не удалось открыть выбор анимации")

        self._with_effects(go)

    def _make_rcl_delegate(self):
        from java import jclass
        plugin = self

        class _Delegate(dynamic_proxy(jclass(
                "org.telegram.ui.Components.ReactionsContainerLayout$ReactionsContainerDelegate"))):
            def onReactionClicked(self_, view, reaction, longpress, add_to_recent):
                plugin._on_picker_click(reaction)

            def allowLongPress(self_):
                return False

            def drawBackground(self_):
                return False

            def needEnterText(self_):
                return False

            def onEmojiWindowDismissed(self_):
                pass

            def drawRoundRect(self_, canvas, rect, a, b, c, d, e):
                pass

        return _Delegate()

    def _new_rcl(self, ctx, fragment, delegate, ttype):
        from java import jclass
        RCL = jclass("org.telegram.ui.Components.ReactionsContainerLayout")
        prov = None
        try:
            prov = fragment.getResourceProvider()
        except Exception:
            pass
        layout = RCL(int(ttype), fragment, ctx, _acc(), prov)
        lp = FrameLayout.LayoutParams(
            FrameLayout.LayoutParams.WRAP_CONTENT, FrameLayout.LayoutParams.WRAP_CONTENT,
            Gravity.TOP | Gravity.LEFT)
        try:
            dm = ctx.getResources().getDisplayMetrics()
            sw, sh = int(dm.widthPixels), int(dm.heightPixels)
            cw = self._card_w or int(sw * FX_CARD_W_FRACTION)
            if ttype == RCL_TYPE_EFFECTS:
                lp.width = cw
                lp.leftMargin = max(dp(8), (sw - cw) // 2)
                lp.topMargin = int(self._card_top) if self._card_top is not None else int(sh * 0.64)
            else:
                lp.leftMargin = max(dp(8), (sw - int(sw * 0.727)) // 2)
                lp.topMargin = int(sh * 0.28)
        except Exception:
            pass
        layout.setLayoutParams(lp)
        layout.setDelegate(delegate)
        return layout

    def _all_regular_reactions(self, sample):
        try:
            from java.util import ArrayList
            mdc = self._mdc()
            av = None
            for nm in ("getEnabledReactionsList", "getReactionsList"):
                try:
                    av = getattr(mdc, nm)()
                except Exception:
                    av = None
                if av is not None and int(av.size()) > 0:
                    break
            if av is None:
                return None
            make = None
            by_obj = False
            for m in sample.getClass().getDeclaredMethods():
                if str(m.getName()) != "fromEmojicon" or not (int(m.getModifiers()) & 0x8):
                    continue
                pts = m.getParameterTypes()
                if len(pts) != 1:
                    continue
                pn = str(pts[0].getName())
                if pn == "java.lang.String":
                    make, by_obj = m, False
                elif pn.endswith("TL_availableReaction"):
                    make, by_obj = m, True
                    break
            if make is None:
                return None
            make.setAccessible(True)
            out = ArrayList()
            seen = set()
            for i in range(int(av.size())):
                r = av.get(i)
                if bool(getattr(r, "inactive", False)) or bool(getattr(r, "premium", False)):
                    continue
                emo = str(getattr(r, "reaction", "") or "")
                if not emo or emo in seen:
                    continue
                seen.add(emo)
                out.add(make.invoke(None, r if by_obj else emo))
            return out if int(out.size()) > 0 else None
        except Exception:
            return None

    def _enable_expand(self, layout, items=None):
        from java import jclass
        cls = Class.forName("org.telegram.ui.Components.ReactionsContainerLayout")
        f = cls.getDeclaredField("allReactionsAvailable")
        f.setAccessible(True)
        f.set(layout, True)
        m = cls.getDeclaredMethod("setVisibleReactionsList", jclass("java.util.List"),
                                  jclass("java.lang.Boolean").TYPE)
        m.setAccessible(True)
        from java.util import ArrayList
        m.invoke(layout, items if items is not None else ArrayList(layout.getVisibleReactionsList()), False)

    def _is_effect_reaction(self, r):
        try:
            if bool(getattr(r, "isEffect", False)):
                return True
            return int(getattr(r, "effectId", 0) or 0) != 0
        except Exception:
            return False

    def _show_picker(self, ttype, on_reaction):
        try:
            fragment = get_last_fragment()
            ctx = fragment.getParentActivity()
            delegate = self._make_rcl_delegate()
            layout = self._new_rcl(ctx, fragment, delegate, ttype)
            layout.setMessage(None, None, False)
            lst = layout.getVisibleReactionsList()
            if lst is None or int(lst.size()) == 0:
                return False
            if ttype == RCL_TYPE_EFFECTS:
                if not self._is_effect_reaction(lst.get(0)):
                    return False
            else:
                self._enable_expand(layout, self._all_regular_reactions(lst.get(0)))
            self._picker_cb = on_reaction
            self._picker_type = ttype
            self._native_layout = int(layout.hashCode())
            self._native_layout_obj = layout
            self._nat_measured = False
            root = FrameLayout(ctx)
            root.setBackgroundColor(0x66000000)
            root.setOnClickListener(OnClickListener(lambda v: self._close_native_fx()))
            root.addView(layout)
            popup = PopupWindow(root, ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT, False)
            self._fx_popup = popup
            popup.showAtLocation(fragment.getFragmentView(), Gravity.TOP | Gravity.LEFT, 0, 0)
            return True
        except Exception:
            self._close_native_fx()
            return False

    def _on_picker_click(self, reaction):
        try:
            cb = self._picker_cb
            self._close_native_fx()
            if cb is not None:
                cb(reaction)
        except Exception:
            pass

    def open_picker(self, cb):
        def on_reaction(r):
            if bool(getattr(r, "isStar", False)):
                BulletinHelper.show_error("Эта реакция не поддерживается")
                return
            did = int(getattr(r, "documentId", 0) or 0)
            emo = getattr(r, "emojicon", None)
            value = ("animated_%d" % did) if did else (str(emo) if emo else None)
            if not value:
                BulletinHelper.show_error("Не удалось определить реакцию")
                return
            if _is_custom(value) and not self._is_premium():
                BulletinHelper.show_error("Эта реакция доступна с Telegram Premium")
                return
            cb(value)

        if not self._show_picker(0, on_reaction):
            BulletinHelper.show_error("Не удалось открыть выбор реакции")

    def _fx_match(self, reaction):
        eff = int(getattr(reaction, "effectId", 0) or 0)
        did = int(getattr(reaction, "documentId", 0) or 0)
        emo = getattr(reaction, "emojicon", None)
        emo = str(emo) if emo is not None else None
        match = None
        for e in self._effects:
            if eff and e["id"] == eff:
                match = e
                break
        for e in ([] if match is not None else self._effects):
            if did and (e["id"] == did or e["sticker"] == did or e["icon"] == did):
                match = e
                break
        if match is None and emo:
            for e in self._effects:
                if e["emoji"] == emo and not e["premium"]:
                    match = e
                    break
        return match

    def _on_fx_reaction(self, reaction):
        match = self._fx_match(reaction)
        if match is not None:
            self._fx_pick(match)
        else:
            BulletinHelper.show_error("Не удалось определить анимацию")

    def _with_effects(self, fn):
        if self._effects:
            fn()
            return
        BulletinHelper.show_info("Загружаю анимации…")
        self._load_effects(lambda: fn() if self._effects
                           else BulletinHelper.show_error("Не удалось загрузить анимации"))

    def replace_fx_slot(self, i):
        def go():
            def cb(reaction):
                e = self._fx_match(reaction)
                if e is None:
                    BulletinHelper.show_error("Не удалось определить анимацию")
                    return
                if e["premium"] and not self._is_premium():
                    BulletinHelper.show_error("Эта анимация доступна с Telegram Premium")
                    return
                slots = self._fx_slots()
                if not (0 <= i < len(slots)):
                    return
                old = slots[i][1]
                new = []
                for k, x in enumerate(slots):
                    if k == i:
                        new.append((e["emoji"], e["id"]))
                    elif x[1] != e["id"]:
                        new.append(x)
                try:
                    if int(str(self.get_setting("fx_id", "0"))) == old:
                        self.set_setting("fx_id", str(e["id"]))
                except Exception:
                    pass
                self._save_fx_slots(new)
                self._refresh_fx()

            if not self._show_picker(RCL_TYPE_EFFECTS, cb):
                BulletinHelper.show_error("Не удалось открыть выбор анимации")

        self._with_effects(go)

    def remove_fx_slot(self, i):
        slots = self._fx_slots()
        if 0 <= i < len(slots):
            self._fx_remove(slots[i][1])

    def _view_loc(self, v):
        arr = jarray(jint)([0, 0])
        v.getLocationOnScreen(arr)
        return int(arr[0]), int(arr[1])

    def _find_card(self, v, sw, sh, depth=0):
        if v is None or depth > 3:
            return None
        try:
            w, h = int(v.getWidth()), int(v.getHeight())
            if w > dp(150) and h > dp(150) and (w < sw * 0.98 or h < sh * 0.98):
                return v
            if isinstance(v, ViewGroup):
                for i in range(v.getChildCount()):
                    r = self._find_card(v.getChildAt(i), sw, sh, depth + 1)
                    if r is not None:
                        return r
        except Exception:
            pass
        return None

    def _schedule_fix_window(self, layout):
        if self._native_layout is None or int(layout.hashCode()) != self._native_layout:
            return
        for d in (0, 80, 250, 500, 900):
            self._post(lambda: self._fix_native_window(layout), d)

    def _fix_native_window(self, layout):
        try:
            if self._fx_popup is None:
                return
            v = layout.getWindowView()
            if v is None:
                return
            vx, vy = self._view_loc(v)
            vw, vh = int(v.getWidth()), int(v.getHeight())
            if vw <= 0 or vh <= 0:
                return
            card = self._find_card(v, vw, vh)
            if card is None:
                return
            cx, cy = self._view_loc(card)
            w, h = int(card.getWidth()), int(card.getHeight())
            if self._picker_type == RCL_TYPE_EFFECTS and w > 0:
                self._card_w = w
                if not self._nat_measured:
                    self._card_top = cy - vy
                    self._nat_measured = True
            mx, top, bottom = dp(8), dp(8), dp(16)
            tx = max(vx + mx, min(cx, vx + vw - mx - w))
            ty = max(vy + top, min(cy, vy + vh - bottom - h))
            dx, dy = tx - cx, ty - cy
            if dx or dy:
                card.setTranslationX(float(card.getTranslationX() + dx))
                card.setTranslationY(float(card.getTranslationY() + dy))
        except Exception:
            pass

    def _close_native_fx(self):
        try:
            if self._fx_popup is not None:
                self._fx_popup.dismiss()
        except Exception:
            pass
        self._fx_popup = None
        self._native_layout_obj = None
        self._picker_cb = None

    def _fx_pick(self, e):
        if e["premium"] and not self._is_premium():
            BulletinHelper.show_error("Эта анимация доступна с Telegram Premium")
            return
        slots = self._fx_slots()
        if not any(i == e["id"] for _, i in slots):
            slots.append((e["emoji"], e["id"]))
            self._save_fx_slots(slots)
        self.set_setting("fx_id", str(e["id"]))
        self._refresh_fx()

    def _popup_root(self, item):
        p = item
        last = item
        try:
            for _ in range(12):
                p = p.getParent()
                if p is None:
                    break
                last = p
                if "PopupSwipeBackLayout" in _class_name(p):
                    return p
        except Exception:
            pass
        return last

    def _find_plugins_item(self, view, depth=0):
        if view is None or depth > 10:
            return None
        try:
            if "ActionBarMenuSubItem" in _class_name(view) and view.getTag(DONE_KEY) is None:
                if _item_text(view).lower() in PLUGINS_TITLES:
                    return view
            if isinstance(view, ViewGroup):
                for i in range(view.getChildCount()):
                    r = self._find_plugins_item(view.getChildAt(i), depth + 1)
                    if r is not None:
                        return r
        except Exception:
            pass
        return None

    def _hoist(self, item):
        try:
            old = item.getParent()
            if old is None:
                return
            if not self._in_wrapper(item):
                return
            root = self._popup_root(item)
            if "PopupSwipeBackLayout" not in _class_name(root):
                return
            plugins = self._find_plugins_item(root)
            if plugins is None:
                return
            main = plugins.getParent()
            if main is None or int(main.hashCode()) == int(old.hashCode()):
                return
            for i in range(main.getChildCount() - 1, -1, -1):
                ch = main.getChildAt(i)
                if ch is not None and ch.getTag(DONE_KEY) is not None and int(ch.hashCode()) != int(item.hashCode()):
                    row = _child_with_tag(ch, MARKER_ROW)
                    if row is not None:
                        self._release_row(row)
                    main.removeViewAt(i)
            idx = main.getChildCount()
            for i in range(main.getChildCount()):
                ch = main.getChildAt(i)
                if ch is not None and ch.getTag() == FX_BOX:
                    idx = i
                    break
            old.removeView(item)
            main.addView(item, idx, self._lp(main, dp(48)))
            for d in (0, 150):
                self._post(lambda: self._force_rebuild(item), d)
        except Exception:
            pass

    def _ensure_row(self, item):
        if item is None or not isinstance(item, FrameLayout):
            return
        current = self._current()
        sig = str((tuple(self._slots()), current))
        existing = _child_with_tag(item, MARKER_ROW)
        for v in _natives(item):
            try:
                v.setVisibility(View.GONE)
            except Exception:
                pass
        if existing is not None and item.getTag(SIG_KEY) == sig:
            return
        if existing is not None:
            self._release_row(existing)
            item.removeView(existing)

        ctx = item.getContext()
        row = LinearLayout(ctx)
        row.setOrientation(LinearLayout.HORIZONTAL)
        row.setGravity(Gravity.CENTER_VERTICAL)
        row.setPadding(dp(10), 0, dp(10), 0)
        try:
            item.setPadding(0, item.getPaddingTop(), 0, item.getPaddingBottom())
        except Exception:
            pass

        for value in self._slots():
            iv = _reaction_view(ctx, value)
            cell = self._cell(ctx, iv, value == current)
            cell.setOnClickListener(OnClickListener(lambda v, val=value: self._pick_current(val)))
            cell.setOnLongClickListener(_LongClick(lambda val=value: self._remove_value(val)))
            row.addView(cell, self._cell_lp())

        plus = ImageView(ctx)
        res = _res("msg_add") or _res("input_add")
        if res:
            plus.setImageResource(res)
            plus.setScaleType(ImageView.ScaleType.CENTER)
            plus.setColorFilter(PorterDuffColorFilter(_icon_color(), PorterDuff.Mode.SRC_IN))
        pcell = self._cell(ctx, plus, False)
        pcell.setOnClickListener(OnClickListener(lambda v: self.add_slot()))
        row.addView(pcell, self._cell_lp())

        holder = HorizontalScrollView(ctx)
        holder.setTag(MARKER_ROW)
        holder.setHorizontalScrollBarEnabled(False)
        holder.setOverScrollMode(View.OVER_SCROLL_NEVER)
        holder.addView(row, FrameLayout.LayoutParams(
            FrameLayout.LayoutParams.WRAP_CONTENT, FrameLayout.LayoutParams.MATCH_PARENT))
        n_cells = len(self._slots()) + 1
        width = min(dp(MAX_ROW_DP), max(dp(120), n_cells * dp(BTN_DP + 2) + dp(20)))
        item.addView(holder, FrameLayout.LayoutParams(width, FrameLayout.LayoutParams.MATCH_PARENT))
        item.setTag(SIG_KEY, sig)

    def _cell_lp(self):
        lp = LinearLayout.LayoutParams(dp(BTN_DP), dp(BTN_DP))
        lp.rightMargin = dp(2)
        return lp

    def _cell(self, ctx, content, selected):
        cell = FrameLayout(ctx)
        cell.setClickable(True)
        cell.setFocusable(True)
        if selected:
            bg = GradientDrawable()
            bg.setShape(GradientDrawable.OVAL)
            bg.setColor(_theme("key_listSelector", 0x33888888))
            cell.setBackground(bg)
        else:
            try:
                cell.setBackground(Theme.createSelectorDrawable(
                    Theme.getColor(Theme.key_listSelector), 1, dp(20)))
            except Exception:
                pass
        lp = FrameLayout.LayoutParams(dp(28), dp(28))
        lp.gravity = Gravity.CENTER
        cell.addView(content, lp)
        return cell

    def _release_row(self, holder):
        try:
            row = holder.getChildAt(0)
            for i in range(row.getChildCount()):
                cell = row.getChildAt(i)
                iv = cell.getChildAt(0)
                _release_iv(iv)
        except Exception:
            pass

    def _pick_current(self, value):
        self._set_current(value)
        self._refresh_all()

    def _remove_value(self, value):
        slots = [s for s in self._slots() if s != value]
        self._save_slots(slots)
        BulletinHelper.show_info("Реакция удалена")

    def _refresh_all(self):
        self._refresh_fx()
        for ref in list(self._items.values()):
            item = ref.get()
            if item is not None:
                self._ensure_row(item)

    def _release(self, item):
        try:
            row = _child_with_tag(item, MARKER_ROW)
            if row is not None:
                self._release_row(row)
                item.removeView(row)
            for v in _natives(item):
                v.setVisibility(View.VISIBLE)
            item.setTag(DONE_KEY, None)
            item.setTag(SIG_KEY, None)
            item.setPadding(dp(18), item.getPaddingTop(), dp(18), item.getPaddingBottom())
        except Exception:
            pass
