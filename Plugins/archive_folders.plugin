_lang_cache = {"code": None, "at": 0.0}


def _lang():
    # called a lot and every lookup goes through JNI
    now = time.monotonic()
    if _lang_cache["code"] is None or now - _lang_cache["at"] > 3:
        _lang_cache["code"] = _detect_lang()
        _lang_cache["at"] = now
    return _lang_cache["code"]


def _detect_lang():
    try:
        info = jclass("org.telegram.messenger.LocaleController").getInstance().getCurrentLocaleInfo()
        codes = []
        for getter in ("getLangCode", "getBaseLangCode", "getPluralLangCode"):
            try:
                code = str(getattr(info, getter)() or "")
            except Exception:
                continue
            if code:
                codes.append(code.lower().replace("_", "-").split("-")[0])
        if codes:
            return next((c for c in codes if c in STRINGS), "en")
    except Exception:
        pass
    try:
        code = str(jclass("java.util.Locale").getDefault().getLanguage()).lower()
        return code if code in STRINGS else "en"
    except Exception:
        return "en"


def _t(key):
    return STRINGS.get(_lang(), STRINGS["en"]).get(key, key)


def _short(text, limit=22):
    text = " ".join(str(text).split())
    if len(text) <= limit:
        return text
    cut = text[:limit - 1]
    space = cut.rfind(" ")
    if space >= limit // 2:
        cut = cut[:space]
    return cut.rstrip(" ,.-—·") + "…"


def _join_short(names, limit=28):
    out = []
    for i, name in enumerate(names):
        name = _short(name, 16)
        if out and len(", ".join(out + [name])) > limit:
            return ", ".join(out) + " +%d" % (len(names) - i)
        out.append(name)
    return ", ".join(out)


def _chats_n(n):
    if _lang() != "ru":
        return _t("chats_one" if n == 1 else "chats_many") % n
    if n % 10 == 1 and n % 100 != 11:
        key = "chats_one"
    elif 2 <= n % 10 <= 4 and not 12 <= n % 100 <= 14:
        key = "chats_few"
    else:
        key = "chats_many"
    return _t(key) % n


def _haptic(view, strong=False):
    try:
        view.performHapticFeedback(0 if strong else 3, 2)
    except Exception:
        pass


# Closures held by Java listeners must not hold views/fragments directly,
# a java -> python -> java cycle is never collected.
def _weak(obj):
    return WeakReference(obj)


def _alive(ref, obj):
    cur = ref.get() if ref is not None else None
    return cur is not None and cur == obj


def _ident(obj):
    try:
        return int(System.identityHashCode(obj))
    except Exception:
        return 0


def _ui(fn, delay=0):
    def run():
        try:
            fn()
        except Exception:
            traceback.print_exc()
    if delay:
        run_on_ui_thread(run, delay)
    else:
        run_on_ui_thread(run)


_R_drawable = jclass("org.telegram.messenger.R$drawable")


def _drawable(name):
    try:
        return int(getattr(_R_drawable, name))
    except Exception:
        return 0


def _dp(v):
    return int(AndroidUtilities.dp(float(v)))


def _mc(acc):
    return MessagesController.getInstance(acc)


class _Run(dynamic_proxy(jclass("java.lang.Runnable"))):
    def __init__(self, fn):
        super().__init__()
        self._fn = fn

    def run(self):
        try:
            self._fn()
        except Exception:
            traceback.print_exc()


class _Click(dynamic_proxy(jclass("android.view.View$OnClickListener"))):
    def __init__(self, fn):
        super().__init__()
        self._fn = fn

    def onClick(self, view):
        try:
            self._fn(view)
        except Exception:
            traceback.print_exc()


class _Touch(dynamic_proxy(jclass("android.view.View$OnTouchListener"))):
    def __init__(self, fn):
        super().__init__()
        self._fn = fn

    def onTouch(self, view, event):
        try:
            return bool(self._fn(view, event))
        except Exception:
            traceback.print_exc()
            return False


class _Picked(dynamic_proxy(jclass("org.telegram.ui.UsersSelectActivity$FilterUsersActivityDelegate"))):
    def __init__(self, fn):
        super().__init__()
        self._fn = fn

    def didSelectChats(self, ids, flags):
        try:
            self._fn([int(ids.get(i)) for i in range(int(ids.size()))], int(flags))
        except Exception:
            traceback.print_exc()


class _Hook(MethodHook):
    def __init__(self, before=None, after=None):
        self._before = before
        self._after = after

    def before_hooked_method(self, param):
        if self._before is not None:
            try:
                self._before(param)
            except Exception:
                traceback.print_exc()

    def after_hooked_method(self, param):
        if self._after is not None:
            try:
                self._after(param)
            except Exception:
                traceback.print_exc()


_toggle_click = None  # shared by all checkbox rows, holds no views


def _checkbox_toggle():
    global _toggle_click
    if _toggle_click is None:
        CheckBoxCell = jclass("org.telegram.ui.Cells.CheckBoxCell")

        def toggle(v):
            cell = cast(CheckBoxCell, v)
            cell.setChecked(not cell.isChecked(), True)
        _toggle_click = _Click(toggle)
    return _toggle_click


class ArchiveFoldersPlugin(BasePlugin):

    def on_plugin_load(self):
        self._frags = {}         # identityHashCode(DialogsActivity) -> state of an open archive
        self._data = {}          # uid -> stored folders
        self._rules = {}         # uid -> {fid: membership rule}
        self._types = {}         # (acc, did) -> chat type flag
        self._pickers = {}
        self._adapters = {}
        self._helpers = set()
        self._title_views = {}
        self._hooks = []
        self._chat_item = None
        self._file_secret = None
        self._folder_open = False
        self._order_edit = False
        self._hide_sorted = bool(self.get_setting("hide_sorted", False))
        self._notif_ids = set()
        for name in ("dialogsNeedReload", "updateInterfaces", "notificationsSettingsUpdated",
                     "dialogFiltersUpdated", "contactsDidLoad", "messagesDidLoad", "didLoadChatInviter"):
            try:
                self._notif_ids.add(int(getattr(NotificationCenter, name)))
            except Exception:
                pass
        self._hook_all()
        if self.get_setting("chat_menu", True):
            self._add_chat_menu()
        if FilesController is not None:
            try:
                self._file_secret = FilesController.register(
                    FilesController.FileInfo(ext=FILE_EXT, on_click=self._on_file_click))
            except Exception:
                traceback.print_exc()
                self.log("file handler not registered")

    def on_plugin_unload(self):
        if FilesController is not None and self._file_secret:
            try:
                FilesController.unregister(FILE_EXT, self._file_secret)
            except Exception:
                traceback.print_exc()
            self._file_secret = None
        for h in self._hooks:
            try:
                self.unhook_method(h)
            except Exception:
                pass
        self._hooks = []
        for st in list(self._frags.values()):
            frag = st["ref"].get()
            if frag is not None:
                _ui(lambda frag=frag, st=st: self._restore_archive(frag, st))
        self._frags = {}
        for ps in list(self._pickers.values()):
            self._restore_limits(ps)
        self._pickers = {}
        self._adapters = {}
        self._helpers = set()
        self._title_views = {}

    def _restore_archive(self, frag, st):
        self._detach(st, remove_item=True)
        title = st.get("orig_title")
        if not title:
            return
        frag.getActionBar().setTitle(title)
        tv = st["tv"].get() if st.get("tv") is not None else None
        if tv is not None and str(tv.getText() or "") in self._archive_titles(st):
            tv.setText(title, False)

    # settings

    def create_settings(self):
        acc = self._selected_account()
        uid = self._uid(acc)
        d = self._load(uid)
        counts = self._counts(acc, uid)
        title = _t("set_folders")
        if self._account_count() > 1:
            title = "%s · %s" % (title, _short(self._account_name(acc), 24))
        rows = [Header(text=title)]
        if not d["folders"]:
            rows.append(Text(text=_t("set_no_folders"), icon="msg_folders"))

        can_order = len(d["folders"]) > 1
        order_list = self._order_item(uid) if self._order_edit and can_order else None
        if order_list is not None:
            rows += [
                order_list,
                Text(text=_t("done"), icon="ic_ab_done", accent=True, on_click=lambda v: self._toggle_order_edit()),
                Divider(text=_t("order_hint")),
            ]
        else:
            self._order_edit = False
            for f in d["folders"]:
                fid = int(f["id"])
                rows.append(Text(
                    text=_short(f["name"], 30),
                    subtext=_chats_n(counts.get(fid, 0)),
                    icon="msg_folders",
                    create_sub_fragment=lambda fid=fid: self._folder_page(acc, uid, fid),
                ))
            rows.append(Text(text=_t("new_folder"), icon="msg_addfolder", accent=True,
                             on_click=lambda v: self._new_folder_from_settings(uid)))
            if can_order:
                rows.append(Text(text=_t("order_edit"), icon="msg_reorder", on_click=lambda v: self._start_order_edit(uid)))
            rows.append(Divider(text=_t("set_hint")))

        rows += [
            Header(text=_t("set_options")),
            Switch(key="remember", text=_t("set_remember"), subtext=_t("set_remember_sub"), default=True, icon="msg_archive"),
            Switch(key="hide_sorted", text=_t("set_hide"), subtext=_t("set_hide_sub"), default=False, icon="msg_folders",
                   on_change=self._on_hide_changed),
            Switch(key="chat_menu", text=_t("set_chat_menu"), subtext=_t("set_chat_menu_sub"), default=True,
                   icon="msg_addfolder", on_change=self._on_chat_menu_changed),
            Divider(),
            Header(text=_t("transfer_header")),
            Text(text=_t("export"), subtext=_t("export_sub"), icon="msg_shareout", on_click=self._on_export_click),
            Divider(),
            Text(text=_t("set_reset"), subtext=_t("set_reset_sub"), icon="msg_delete", red=True, on_click=self._on_reset_click),
            Divider(),
            Text(text=_t("set_author"), subtext="@" + CHANNEL, icon="msg_channel", accent=True, on_click=self._open_channel),
        ]
        return rows

    @staticmethod
    def _account_count():
        n = 0
        for a in range(int(UserConfig.MAX_ACCOUNT_COUNT)):
            try:
                if UserConfig.getInstance(a).isClientActivated():
                    n += 1
            except Exception:
                pass
        return n

    @staticmethod
    def _account_name(acc):
        try:
            user = UserConfig.getInstance(acc).getCurrentUser()
            return str(jclass("org.telegram.messenger.UserObject").getUserName(user))
        except Exception:
            return "#%d" % acc

    @staticmethod
    def _selected_account():
        return int(UserConfig.selectedAccount)

    def _refresh_settings(self):
        try:
            self.set_setting("_rev", int(self.get_setting("_rev", 0) or 0) + 1, reload_settings=True)
        except Exception:
            traceback.print_exc()

    def _new_folder_from_settings(self, uid):
        frag = get_last_fragment()
        if frag is not None:
            self._ask_name(frag, uid, None, lambda fid: self._refresh_settings())

    def _folder_page(self, acc, uid, fid):
        f = self._folder(uid, fid)
        if f is None:
            return [Text(text=_t("set_no_folders"))]
        self._types = {}
        rule = self._rules_of(uid)[fid]
        index = self._category_index(acc)

        inc_sub = _t("selected_n") % len(f.get("chats", []))
        types = self._types_summary(rule["flags"], TYPE_LABELS)
        if types:
            inc_sub += " · " + types
        ex_sub = _t("selected_n") % len(f.get("exclude", []))
        xtypes = self._types_summary(rule["xflags"], X_LABELS)
        if xtypes:
            ex_sub += " · " + xtypes

        rows = [
            Header(text=_t("manual_header")),
            Text(text=_t("included"), subtext=inc_sub, icon="msg_addfolder", accent=True,
                 on_click=lambda v: self._open_picker_from_settings(acc, uid, fid, False)),
            Text(text=_t("excluded"), subtext=ex_sub, icon="msg_removefolder",
                 on_click=lambda v: self._open_picker_from_settings(acc, uid, fid, True)),
            Divider(text=_t("types_hint")),
            Header(text=_t("category_header")),
        ]
        for cat in CATEGORIES:
            ids = index[cat]
            on = bool(ids) and all(self._in_rule(acc, rule, x, live=False) for x in ids)
            key = "cat_%d_%d_%s" % (uid, fid, cat)
            # the switch takes its state from settings
            if self.get_setting(key, None) != on:
                self.set_setting(key, on)
            rows.append(Switch(
                key=key,
                text=_t("cat_" + cat),
                subtext=_chats_n(len(ids)),
                default=on,
                icon=CATEGORY_ICONS[cat],
                on_change=lambda value, cat=cat: self._on_category(acc, uid, fid, cat, value),
            ))
        rows += [
            Divider(text=_t("category_hint")),
            Header(text=_t("manage_header")),
            Text(text=_t("rename"), icon="msg_edit", on_click=lambda v: self._rename_from_settings(uid, fid)),
            Text(text=_t("delete"), icon="msg_delete", red=True, on_click=lambda v: self._delete_from_settings(uid, fid)),
        ]
        return rows

    def _category_of(self, acc, did):
        mc = _mc(acc)
        if did > 0:
            try:
                user = mc.getUser(Long(did))
                if user is not None and user.bot:
                    return "bot"
            except Exception:
                pass
            return "private_dm"
        try:
            chat = mc.getChat(Long(-did))
        except Exception:
            chat = None
        if chat is None:
            return None
        public = bool(getattr(chat, "username", None))
        if not public:
            try:
                public = chat.usernames is not None and int(chat.usernames.size()) > 0
            except Exception:
                pass
        try:
            channel = bool(chat.broadcast) and not bool(chat.megagroup)
        except Exception:
            channel = False
        if channel:
            return "public_channel" if public else "private_channel"
        return "public_group" if public else "private_group"

    def _category_index(self, acc):
        index = {c: [] for c in CATEGORIES}
        for did, _d in self._archived(acc):
            c = self._category_of(acc, did)
            if c in index:
                index[c].append(did)
        return index

    def _on_category(self, acc, uid, fid, cat, value):
        f = self._folder(uid, fid)
        if f is None:
            return
        ids = self._category_index(acc)[cat]
        rule = self._rules_of(uid)[fid]
        if value:
            changed = [x for x in ids if not self._in_rule(acc, rule, x, live=False)]
            msg = _t("cat_added") % len(changed) if changed else _t("cat_added_none")
        else:
            changed = [x for x in ids if self._in_rule(acc, rule, x, live=False)]
            msg = _t("cat_removed") % len(changed) if changed else _t("cat_removed_none")
        if changed:
            self._set_membership(f, rule["flags"], changed, value, acc)
        self._save(uid, self._load(uid))
        self._reload_all()
        BulletinHelper.show_info(msg)
        self._refresh_settings()

    def _open_picker_from_settings(self, acc, uid, fid, exclude):
        frag = get_last_fragment()
        if frag is not None:
            self._open_picker(frag, acc, uid, fid, self._refresh_settings, exclude)

    def _rename_from_settings(self, uid, fid):
        frag = get_last_fragment()
        if frag is not None:
            self._ask_name(frag, uid, fid, lambda _fid: (self._refresh_titles(uid), self._refresh_settings()))

    def _delete_from_settings(self, uid, fid):
        frag = get_last_fragment()
        if frag is None:
            return
        fr = _weak(frag)

        def done():
            page = fr.get()
            if page is not None:
                page.finishFragment()
            self._refresh_settings()
        self._confirm_delete(frag, uid, fid, done)

    def _refresh_titles(self, uid):
        for st in self._frags.values():
            if st["uid"] == uid:
                _ui(lambda st=st: self._apply_title(st))

    def _on_hide_changed(self, value):
        self._hide_sorted = bool(value)
        for st in self._frags.values():
            st["cache"] = None
        self._reload_all()

    def _on_chat_menu_changed(self, value):
        if value:
            self._add_chat_menu()
        elif self._chat_item is not None:
            try:
                self.remove_menu_item(self._chat_item)
            except Exception:
                pass
            self._chat_item = None

    def _open_channel(self, view):
        jclass("org.telegram.messenger.browser.Browser").openUrl(view.getContext(), "https://t.me/" + CHANNEL)

    def _on_reset_click(self, view):
        uid = self._uid(self._selected_account())
        b = AlertDialogBuilder(view.getContext())
        b.set_title(_t("set_reset"))
        b.set_message(_t("set_reset_q"))

        def ok(_b, _w):
            self._save(uid, {"folders": [], "next": 1})
            self.set_setting("sel_%d" % uid, ALL)
            for st in self._frags.values():
                if st["uid"] == uid:
                    st["folder"] = ALL
                    st["cache"] = None
                    self._apply_title(st)
            self._update_folder_open()
            self._reload_all()
        b.set_positive_button(_t("delete"), ok)
        b.set_negative_button(_t("cancel"))
        b.make_button_red(AlertDialogBuilder.BUTTON_POSITIVE)
        b.show()

    # folder order editing in the settings

    def _toggle_order_edit(self):
        self._order_edit = not self._order_edit
        self._refresh_settings()

    def _start_order_edit(self, uid):
        if Custom is None:
            self._show_order_dialog(get_last_fragment(), uid)
        else:
            self._toggle_order_edit()

    def _order_item(self, uid):
        if Custom is None:
            return None
        try:
            frag = get_last_fragment()
            ctx = frag.getParentActivity() if frag is not None else None
            if ctx is None:
                ctx = jclass("org.telegram.messenger.ApplicationLoader").applicationContext
            box = self._build_order_list(ctx, uid, in_settings=True)
            return Custom(view=box) if box is not None else None
        except Exception:
            traceback.print_exc()
            self.log("order list can't be shown in settings, falling back to a dialog")
            return None

    def _show_order_dialog(self, frag, uid):
        ctx = frag.getParentActivity() if frag is not None else None
        if ctx is None:
            return
        box = self._build_order_list(ctx, uid, in_settings=False)
        if box is None:
            return
        scroll = jclass("android.widget.ScrollView")(ctx)
        scroll.addView(box)
        b = AlertDialogBuilder(ctx)
        b.set_title(_t("order_edit"))
        b.set_message(_t("order_hint"))
        b.set_view(scroll)
        b.set_positive_button(_t("done"))
        b.set_on_dismiss_listener(lambda _b: self._refresh_settings())
        b.show()

    def _build_order_list(self, ctx, uid, in_settings):
        folders = self._load(uid)["folders"]
        if len(folders) < 2:
            return None
        LinearLayout = jclass("android.widget.LinearLayout")
        FrameLayout = jclass("android.widget.FrameLayout")
        ImageView = jclass("android.widget.ImageView")
        TextView = jclass("android.widget.TextView")
        ColorFilter = jclass("android.graphics.PorterDuffColorFilter")
        SRC_IN = jclass("android.graphics.PorterDuff$Mode").SRC_IN

        row_dp = 50 if in_settings else 52
        row_h = _dp(row_dp)
        if in_settings:
            bg = Theme.getColor(Theme.key_windowBackgroundWhite)
            text_color = Theme.getColor(Theme.key_windowBackgroundWhiteBlackText)
            icon_color = Theme.getColor(Theme.key_windowBackgroundWhiteGrayIcon)
        else:
            bg = Theme.getColor(Theme.key_dialogBackground)
            text_color = Theme.getColor(Theme.key_dialogTextBlack)
            icon_color = Theme.getColor(Theme.key_dialogIcon)
        icon_filter = ColorFilter(icon_color, SRC_IN)
        handle_filter = ColorFilter(Theme.getColor(Theme.key_stickers_menu), SRC_IN)

        box = LinearLayout(ctx)
        box.setOrientation(LinearLayout.VERTICAL)
        if in_settings:
            box.setBackgroundColor(bg)
            try:
                box.setLayoutParams(jclass("androidx.recyclerview.widget.RecyclerView$LayoutParams")(-1, -2))
            except Exception:
                pass
        rows = []
        for f in folders:
            row = FrameLayout(ctx)
            row.setBackgroundColor(bg)
            icon = ImageView(ctx)
            icon.setImageResource(_drawable("msg_folders"))
            icon.setColorFilter(icon_filter)
            row.addView(icon, LayoutHelper.createFrame(-2, -2.0, 0x13, 21.0 if in_settings else 24.0, 0.0, 0.0, 0.0))
            name = TextView(ctx)
            name.setTextSize(1, 16.0)
            name.setTextColor(text_color)
            name.setSingleLine(True)
            name.setEllipsize(jclass("android.text.TextUtils$TruncateAt").END)
            name.setText(_short(f["name"], 30))
            row.addView(name, LayoutHelper.createFrame(-1, -2.0, 0x13, 71.0 if in_settings else 68.0, 0.0, 60.0, 0.0))
            handle = ImageView(ctx)
            handle.setScaleType(jclass("android.widget.ImageView$ScaleType").CENTER)
            handle.setImageResource(_drawable("list_reorder"))
            handle.setColorFilter(handle_filter)
            row.addView(handle, LayoutHelper.createFrame(48, 48.0, 0x15, 0.0, 0.0, 8.0, 0.0))
            box.addView(row, LayoutHelper.createLinear(-1, row_dp))
            rows.append(row)

        listener = _Touch(self._order_touch(_weak(box), uid, [int(f["id"]) for f in folders], row_h))
        for row in rows:
            row.setOnTouchListener(listener)
        return box

    def _order_touch(self, box_ref, uid, ids, row_h):
        # rows only move by translation while dragging, the real reorder happens after the drop
        st = {"drag": None, "run": None, "busy": False, "y": 0.0}

        def start(row, raw_y):
            st["run"] = None
            box = box_ref.get()
            if box is None or st["busy"] or st["drag"] is not None:
                return
            idx = int(box.indexOfChild(row))
            if idx < 0:
                return
            st["drag"] = {"row": row, "from": idx, "to": idx, "y0": raw_y, "shift": {}}
            parent = box.getParent()
            if parent is not None:
                parent.requestDisallowInterceptTouchEvent(True)
            row.setElevation(float(_dp(8)))
            row.animate().scaleX(1.02).scaleY(1.02).setDuration(120).start()
            _haptic(row, strong=True)

        def move(raw_y):
            box = box_ref.get()
            g = st["drag"]
            if box is None:
                return
            n = int(box.getChildCount())
            dy = max(-g["from"] * row_h, min((n - 1 - g["from"]) * row_h, raw_y - g["y0"]))
            g["row"].setTranslationY(float(dy))
            to = max(0, min(n - 1, g["from"] + int(round(dy / float(row_h)))))
            if to != g["to"]:
                g["to"] = to
                _haptic(g["row"])
            for k in range(n):
                if k == g["from"]:
                    continue
                if g["from"] < k <= to:
                    shift = -row_h
                elif to <= k < g["from"]:
                    shift = row_h
                else:
                    shift = 0
                if g["shift"].get(k, 0) != shift:
                    g["shift"][k] = shift
                    box.getChildAt(k).animate().translationY(float(shift)).setDuration(150).start()

        def drop():
            g, st["drag"] = st["drag"], None
            if g is None:
                return
            st["busy"] = True

            def finish():
                st["busy"] = False
                box = box_ref.get()
                if box is None:
                    return
                views = [box.getChildAt(k) for k in range(int(box.getChildCount()))]
                params = [v.getLayoutParams() for v in views]
                order = list(range(len(views)))
                order.insert(g["to"], order.pop(g["from"]))
                box.removeAllViews()
                for k in order:
                    v = views[k]
                    v.animate().cancel()
                    v.setTranslationY(0.0)
                    v.setScaleX(1.0)
                    v.setScaleY(1.0)
                    v.setElevation(0.0)
                    box.addView(v, params[k])
                if g["to"] != g["from"]:
                    ids.insert(g["to"], ids.pop(g["from"]))
                    # don't rebuild the screen under the finger
                    self._apply_order(uid, list(ids), reload=False)
                    self._reload_all()

            g["row"].animate().translationY(float((g["to"] - g["from"]) * row_h)).scaleX(1.0).scaleY(1.0) \
                .setDuration(150).withEndAction(_Run(finish)).start()

        def cancel_pending(row):
            run = st.pop("run", None)
            if run is not None:
                row.removeCallbacks(run)

        def touch(row, ev):
            action = int(ev.getActionMasked())
            raw_y = float(ev.getRawY())
            g = st["drag"]
            if g is not None and g["row"] == row:
                if action == 2:
                    move(raw_y)
                elif action in (1, 3):
                    drop()
                return True
            if action == 0:
                cancel_pending(row)
                if st["busy"] or g is not None:
                    return False
                st["y"] = raw_y
                if float(ev.getX()) > row.getWidth() - _dp(64):
                    start(row, raw_y)  # grabbed by the handle
                    return True
                st["run"] = _Run(lambda: start(row, st["y"]))
                row.postDelayed(st["run"], 260)
                return True
            if action == 2 and abs(raw_y - st["y"]) > _dp(8):
                cancel_pending(row)
            elif action in (1, 3):
                cancel_pending(row)
            return True
        return touch

    # storage

    @staticmethod
    def _uid(acc):
        try:
            return int(UserConfig.getInstance(acc).getClientUserId())
        except Exception:
            return int(acc)

    def _load(self, uid):
        d = self._data.get(uid)
        if d is not None:
            return d
        d = {"folders": [], "next": 1}
        raw = self.get_setting("data_%d" % uid, "")
        if raw:
            try:
                parsed = json.loads(raw)
                if isinstance(parsed, dict) and isinstance(parsed.get("folders"), list):
                    d = parsed
                    d.setdefault("next", 1 + max([int(f.get("id", 0)) for f in d["folders"]] or [0]))
            except Exception:
                traceback.print_exc()
        self._data[uid] = d
        self._build_rules(uid)
        return d

    def _save(self, uid, d, reload=True):
        self._data[uid] = d
        self._build_rules(uid)
        self.set_setting("data_%d" % uid, json.dumps(d, ensure_ascii=False), reload_settings=reload)
        for st in self._frags.values():
            if st["uid"] == uid:
                st["cache"] = None

    def _build_rules(self, uid):
        rules = {}
        for f in self._data[uid]["folders"]:
            rules[int(f["id"])] = {
                "chats": set(int(x) for x in f.get("chats", [])),
                "ex": set(int(x) for x in f.get("exclude", [])),
                "flags": int(f.get("flags", 0) or 0) & F_MASK,
                "xflags": int(f.get("xflags", 0) or 0) & X_MASK,
                "pinned": [int(x) for x in f.get("pinned", [])],
            }
        self._rules[uid] = rules

    def _rules_of(self, uid):
        self._load(uid)
        return self._rules[uid]

    def _folder(self, uid, fid):
        for f in self._load(uid)["folders"]:
            if int(f["id"]) == int(fid):
                return f
        return None

    def _name_taken(self, uid, name, except_id=None):
        low = name.strip().lower()
        return any(str(f["name"]).strip().lower() == low and int(f["id"]) != except_id
                   for f in self._load(uid)["folders"])

    # membership: explicit chats + chat types, like regular folders

    def _type_flag(self, acc, did):
        key = (acc, did)
        flag = self._types.get(key)
        if flag is not None:
            return flag
        flag = 0
        mc = _mc(acc)
        try:
            if did > 0:
                user = mc.getUser(Long(did))
                if user is not None and user.bot:
                    flag = F_BOTS
                elif user is not None and (user.contact or user.mutual_contact or user.self):
                    flag = F_CONTACTS
                else:
                    flag = F_NON_CONTACTS
            else:
                chat = mc.getChat(Long(-did))
                if chat is not None:
                    flag = F_CHANNELS if chat.broadcast and not chat.megagroup else F_GROUPS
        except Exception:
            flag = 0
        self._types[key] = flag
        return flag

    @staticmethod
    def _is_muted(acc, did):
        mc = _mc(acc)
        try:
            return bool(mc.isDialogMuted(did, 0))
        except Exception:
            try:
                return bool(mc.isDialogMuted(did))
            except Exception:
                return False

    @staticmethod
    def _is_unread(d):
        try:
            return d.unread_count > 0 or bool(d.unread_mark) or (getattr(d, "unread_mentions_count", 0) or 0) > 0
        except Exception:
            return True

    def _in_rule(self, acc, rule, did, d=None, live=True):
        if did in rule["ex"]:
            return False
        if did not in rule["chats"] and not (rule["flags"] and rule["flags"] & self._type_flag(acc, did)):
            return False
        if live:
            if rule["xflags"] & X_MUTED and self._is_muted(acc, did):
                return False
            if rule["xflags"] & X_READ and d is not None and not self._is_unread(d):
                return False
        return True

    @staticmethod
    def _archived(acc):
        dialogs = _mc(acc).getDialogs(1)
        out = []
        for i in range(int(dialogs.size())):
            d = dialogs.get(i)
            try:
                did = int(d.id)
            except Exception:
                continue
            if did:
                out.append((did, d))
        return out

    def _counts(self, acc, uid):
        rules = self._rules_of(uid)
        counts = dict.fromkeys(rules, 0)
        if rules:
            for did, d in self._archived(acc):
                for fid, rule in rules.items():
                    if self._in_rule(acc, rule, did, d):
                        counts[fid] += 1
        return counts

    @staticmethod
    def _types_summary(flags, labels):
        names = [_t(key) for bit, key in labels if flags & bit]
        return _join_short(names, 30) if names else ""

    def _set_membership(self, f, flags, dids, inside, acc):
        # a chat that matches the folder type needs an exclusion to get out
        chats = [int(x) for x in f.get("chats", [])]
        ex = [int(x) for x in f.get("exclude", [])]
        touched = set(dids)
        if inside:
            chats += [x for x in dids if x not in chats]
            ex = [x for x in ex if x not in touched]
        else:
            chats = [x for x in chats if x not in touched]
            ex += [x for x in dids if flags & self._type_flag(acc, x) and x not in ex]
            f["pinned"] = [x for x in f.get("pinned", []) if int(x) not in touched]
        f["chats"] = chats
        f["exclude"] = ex

    # hooks

    def _hook(self, clazz, name, before=None, after=None):
        try:
            res = self.hook_all_methods(clazz, name, _Hook(before, after))
            if res:
                self._hooks.extend(res)
                return True
        except Exception:
            traceback.print_exc()
        self.log("hook failed: %s" % name)
        return False

    def _hook_exact(self, method, before=None, after=None):
        try:
            unhook = self.hook_method(method, _Hook(before, after))
            if unhook:
                self._hooks.append(unhook)
                return True
        except Exception:
            traceback.print_exc()
        return False

    def _hook_all(self):
        da = find_class("org.telegram.ui.DialogsActivity")
        if da is None:
            self.log("DialogsActivity not found")
            return
        self._hook(da, "getDialogsArray", after=self._after_get_dialogs)
        self._hook(da, "createView", after=self._after_create_view)
        self._hook(da, "createActionMode", after=self._after_create_action_mode)
        self._hook(da, "didReceivedNotification", before=self._before_notification)
        self._hook(da, "onFragmentDestroy", before=self._before_destroy)

        self._pin_actions = set()
        for name, fallback in (("pin", 100), ("pin2", 108)):
            try:
                value = get_static_private_field(da, name)
                self._pin_actions.add(int(value) if value is not None else fallback)
            except Exception:
                self._pin_actions.add(fallback)
        self._hook(da, "performSelectedDialogsAction", before=self._before_dialogs_action)
        # folder pins are dragged like normal ones
        self._hook(da, "isDialogPinned", before=self._before_is_pinned)
        # ≡ handles show up only when getPinnedCount() > 1
        self._hook(da, "getPinnedCount", before=self._before_pinned_count)
        self._hook(da, "hideActionMode", before=self._before_hide_action_mode)
        self._hook(da, "updateCounters", after=self._after_update_counters)
        adapter = find_class("org.telegram.ui.Adapters.DialogsAdapter")
        if adapter is not None:
            self._hook(adapter, "moveDialogs", before=self._before_move_dialogs)

        cell = find_class("org.telegram.ui.Cells.DialogCell")
        if cell is not None:
            try:
                update = cell.getDeclaredMethod("update", JInteger.TYPE, JBoolean.TYPE)
            except Exception:
                update = None
            if update is None or not self._hook_exact(update, after=self._after_cell_update):
                self._hook(cell, "update", after=self._after_cell_update)

        picker = find_class("org.telegram.ui.UsersSelectActivity")
        if picker is not None:
            self._hook(picker, "createView", after=self._picker_after_create_view)
            self._hook(picker, "updateHint", after=self._picker_after_update_hint)
            self._hook(picker, "onFragmentDestroy", before=self._picker_before_destroy)
        picker_adapter = find_class("org.telegram.ui.UsersSelectActivity$GroupCreateAdapter")
        if picker_adapter is not None:
            try:
                res = self.hook_all_constructors(picker_adapter, _Hook(after=self._adapter_after_init))
                if res:
                    self._hooks.extend(res)
                else:
                    self.log("hook failed: GroupCreateAdapter.<init>")
            except Exception:
                traceback.print_exc()
            self._hook(picker_adapter, "onBindViewHolder", after=self._adapter_after_bind)

        atv = find_class("org.telegram.ui.Components.AnimatedTextView")
        if atv is not None:
            try:
                set_text = atv.getDeclaredMethod("setText", jclass("java.lang.CharSequence"), JBoolean.TYPE, JBoolean.TYPE)
            except Exception:
                set_text = None
            if set_text is None or not self._hook_exact(set_text, before=self._before_stories_title):
                self._hook(atv, "setText", before=self._before_stories_title)

        search = find_class("org.telegram.ui.Adapters.SearchAdapterHelper")
        if search is not None:
            self._hook(search, "queryServerSearch", before=self._before_server_search)

    # archive screen state

    def _st_for(self, frag):
        st = self._frags.get(_ident(frag))
        if st is None or not _alive(st["ref"], frag):
            return None
        return st

    def _folder_st(self, frag):
        st = self._st_for(frag)
        return st if st is not None and st["folder"] != ALL else None

    def _update_folder_open(self):
        # checked first by the hot hooks
        self._folder_open = any(st["folder"] != ALL for st in self._frags.values())

    def _detach(self, st, remove_item=False):
        for key in ("item", "sub"):
            ref = st.pop(key, None)
            view = ref.get() if ref is not None else None
            if view is None:
                continue
            view.setOnClickListener(None)
            if key == "item":
                view.setOnTouchListener(None)
            if remove_item and view.getParent() is not None:
                view.getParent().removeView(view)
        st.pop("touch", None)
        st.pop("hold", None)

    def _after_create_view(self, param):
        frag = param.thisObject
        if int(get_private_field(frag, "folderId") or 0) != 1:
            return
        if get_private_field(frag, "onlySelect") or int(get_private_field(frag, "initialDialogsType") or 0) != 0:
            return
        acc = int(frag.getCurrentAccount())
        uid = self._uid(acc)
        self._load(uid)
        self._types = {}
        folder = ALL
        if self.get_setting("remember", True):
            try:
                folder = int(self.get_setting("sel_%d" % uid, ALL) or ALL)
            except Exception:
                folder = ALL
            if folder != ALL and self._folder(uid, folder) is None:
                folder = ALL
        old = self._st_for(frag)
        if old is not None:
            self._detach(old)
        orig = (old or {}).get("orig_title") or str(frag.getActionBar().getTitle() or "")
        st = {"ref": _weak(frag), "orig_title": orig, "acc": acc, "uid": uid, "folder": folder, "cache": None}
        self._frags[_ident(frag)] = st
        self._update_folder_open()
        self._add_button(frag, st)
        self._register_stories_title(frag, st)
        self._apply_title(st)

    def _before_destroy(self, param):
        if not self._frags:
            return
        st = self._st_for(param.thisObject)
        if st is None:
            return
        del self._frags[_ident(param.thisObject)]
        self._detach(st)
        if st.pop("pins_dirty", False):
            self._save(st["uid"], self._load(st["uid"]))
        tv_id = st.pop("tv_id", None)
        if tv_id is not None:
            self._title_views.pop(tv_id, None)
        self._update_folder_open()

    def _before_notification(self, param):
        if not self._frags:
            return
        try:
            nid = int(param.args[0])
        except Exception:
            return
        if self._notif_ids and nid not in self._notif_ids:
            return
        st = self._st_for(param.thisObject)
        if st is not None:
            st["cache"] = None

    def _after_get_dialogs(self, param):
        if not self._frags:
            return
        args = param.args
        if args is None or len(args) < 4 or int(args[2]) != 1 or int(args[1]) != 0 or args[3]:
            return
        st = self._st_for(param.thisObject)
        if st is None:
            return
        rules = self._rules_of(st["uid"])
        folder = st["folder"]
        if folder == ALL:
            if not rules or not self._hide_sorted:
                return
            rule = None
        else:
            rule = rules.get(folder)
            if rule is None:
                return
        src = param.getResult()
        if src is None:
            return
        size = int(src.size())
        key = (_ident(src), size, folder)
        cache = st.get("cache")
        if cache is not None and cache[0] == key:
            param.setResult(cache[1])
            return
        acc = st["acc"]
        out = ArrayList()
        for i in range(size):
            d = src.get(i)
            try:
                did = int(d.id)
            except Exception:
                out.add(d)
                continue
            if rule is not None:
                if self._in_rule(acc, rule, did, d):
                    out.add(d)
            elif not any(self._in_rule(acc, r, did, d) for r in rules.values()):
                out.add(d)
        if rule is not None:
            out = self._order_folder(out, rule)
        st["cache"] = (key, out)
        param.setResult(out)

    @staticmethod
    def _order_folder(lst, rule):
        # folder pins on top, server pins mean nothing inside a folder
        pin_pos = {did: i for i, did in enumerate(rule["pinned"])}
        pinned, natives, rest = [], [], []
        for i in range(int(lst.size())):
            d = lst.get(i)
            try:
                did = int(d.id)
            except Exception:
                did = None
            if did in pin_pos:
                pinned.append((pin_pos[did], d))
            elif getattr(d, "pinned", False):
                natives.append(d)
            else:
                rest.append(d)
        if not pinned and not natives:
            return lst

        def date(d):
            try:
                return int(d.last_message_date)
            except Exception:
                return 0
        for d in sorted(natives, key=date, reverse=True):
            when = date(d)
            pos = next((j for j, other in enumerate(rest) if date(other) < when), len(rest))
            rest.insert(pos, d)
        out = ArrayList()
        for _pos, d in sorted(pinned, key=lambda p: p[0]):
            out.add(d)
        for d in rest:
            out.add(d)
        return out

    def _after_create_action_mode(self, param):
        if not self._frags:
            return
        frag = param.thisObject
        st = self._st_for(frag)
        if st is None or (param.args and param.args[0] is not None):
            return
        mode = frag.getActionBar().getActionMode()
        if mode is None:
            return
        menu_item_cls = jclass("org.telegram.ui.ActionBar.ActionBarMenuItem")
        other = None
        last = None
        for i in range(int(mode.getChildCount())):
            child = mode.getChildAt(i)
            if not isinstance(child, menu_item_cls):
                continue
            last = child
            try:
                if int(child.getTag()) == 0:
                    other = child
            except Exception:
                pass
        other = other or last
        if other is None or other.hasSubItem(ACTION_ID):
            return
        sub = other.addSubItem(ACTION_ID, _drawable("msg_folders"), _t("to_folder"))
        fr, mr = _weak(frag), _weak(other)

        def on_click(_v):
            f, menu = fr.get(), mr.get()
            if menu is not None:
                menu.closeSubMenu()
            if f is None:
                return
            selected = get_private_field(f, "selectedDialogs")
            dids = [int(selected.get(i)) for i in range(int(selected.size()))] if selected is not None else []
            if dids:
                self._show_assign_dialog(f, int(f.getCurrentAccount()), dids, lambda: self._hide_action_mode(fr.get()))
        sub.setOnClickListener(_Click(on_click))
        st["sub"] = _weak(sub)

    @staticmethod
    def _hide_action_mode(frag):
        if frag is None:
            return
        try:
            m = frag.getClass().getDeclaredMethod("hideActionMode", JBoolean.TYPE)
            m.setAccessible(True)
            m.invoke(frag, JBoolean(True))
        except Exception:
            traceback.print_exc()

    # header button and title

    def _add_button(self, frag, st):
        menu = frag.getActionBar().createMenu()
        fr = _weak(frag)

        def on_click(v):
            f = fr.get()
            if f is not None:
                self._show_folders_popup(f, v)
        st["touch"] = _Touch(self._hold_handler(fr, st))
        item = menu.getItem(BUTTON_ID)
        if item is None:
            item = menu.addItem(BUTTON_ID, _drawable("msg_folders"))
            item.setContentDescription(_t("to_folder_title"))
            options = get_private_field(frag, "optionsItem")
            if options is not None and options.getParent() is not None and options.getParent().equals(menu):
                menu.removeView(item)
                menu.addView(item, int(menu.indexOfChild(options)))
        item.setOnClickListener(_Click(on_click))
        item.setOnTouchListener(st["touch"])
        st["item"] = _weak(item)

    def _apply_title(self, st):
        frag = st["ref"].get()
        if frag is None:
            return
        text = self._display_title(st)
        if st.get("tv") is None or st["tv"].get() is None:
            self._register_stories_title(frag, st)
        self._update_stories_title(st, text)
        bar = frag.getActionBar()
        if str(bar.getTitle() or "") == text:
            return
        if st.get("shown"):
            try:
                bar.setTitleAnimated(text, True, 220)
                return
            except Exception:
                pass
        bar.setTitle(text)
        st["shown"] = True

    # with stories collapsed the title lives in DialogStoriesCell, only the archive title is swapped there

    def _register_stories_title(self, frag, st):
        try:
            cell = frag.dialogStoriesCell
        except Exception:
            cell = None
        tv = get_private_field(cell, "titleView") if cell is not None else None
        if tv is None:
            return
        st["tv_id"] = _ident(tv)
        st["tv"] = _weak(tv)
        self._title_views[st["tv_id"]] = st

    def _archive_titles(self, st):
        names = {st.get("orig_title") or "", _t("archive_title"),
                 STRINGS["ru"]["archive_title"], STRINGS["en"]["archive_title"]}
        names.update(_short(f["name"], 24) for f in self._load(st["uid"])["folders"])
        names.discard("")
        return names

    def _display_title(self, st):
        if st["folder"] != ALL:
            f = self._folder(st["uid"], st["folder"])
            if f is not None:
                return _short(f["name"], 24)
        return st.get("orig_title") or _t("archive_title")

    def _before_stories_title(self, param):
        if not self._title_views:
            return
        st = self._title_views.get(_ident(param.thisObject))
        if st is None or not _alive(st.get("tv"), param.thisObject):
            return
        args = param.args
        if not args or args[0] is None:
            return
        cur = str(args[0])
        if cur in self._archive_titles(st):
            want = self._display_title(st)
            if cur != want:
                args[0] = want

    def _update_stories_title(self, st, text):
        tv = st["tv"].get() if st.get("tv") is not None else None
        if tv is None:
            return
        cur = str(tv.getText() or "")
        if cur and cur != text and cur in self._archive_titles(st):
            tv.setText(text, True)

    # local pins inside a folder

    def _before_dialogs_action(self, param):
        if not self._folder_open:
            return
        args = param.args
        if args is None or len(args) < 2:
            return
        try:
            action = int(args[1])
        except Exception:
            return
        if action not in self._pin_actions:
            return
        frag = param.thisObject
        st = self._folder_st(frag)
        if st is None:
            return
        sel = args[0]
        dids = [int(sel.get(i)) for i in range(int(sel.size()))] if sel is not None else []
        param.setResult(None)
        if not dids:
            return
        uid = st["uid"]
        f = self._folder(uid, st["folder"])
        if f is None:
            return
        pinned = [int(x) for x in f.get("pinned", [])]
        unpin = all(x in pinned for x in dids)
        if unpin:
            pinned = [x for x in pinned if x not in set(dids)]
        else:
            pinned = [x for x in dids if x not in pinned] + pinned
        f["pinned"] = pinned
        self._save(uid, self._load(uid))
        self._hide_action_mode(frag)
        self._reload(st["acc"])
        BulletinHelper.show_success(_t("unpinned_local" if unpin else "pinned_local") % _short(f["name"], 20), frag)

    def _before_is_pinned(self, param):
        if not self._folder_open:
            return
        st = self._folder_st(param.thisObject)
        if st is None or not param.args:
            return
        rule = self._rules_of(st["uid"]).get(st["folder"])
        d = param.args[0]
        if rule is None or d is None:
            return
        try:
            did = int(d.id)
        except Exception:
            return
        param.setResult(JBoolean(did in rule["pinned"]))

    def _before_pinned_count(self, param):
        if not self._folder_open:
            return
        frag = param.thisObject
        st = self._folder_st(frag)
        if st is None:
            return
        rule = self._rules_of(st["uid"]).get(st["folder"])
        if rule is None or not rule["pinned"]:
            param.setResult(JInteger(0))
            return
        pins = set(rule["pinned"])
        try:
            lst = frag.getDialogsArray(st["acc"], 0, 1, False)
            n = sum(1 for i in range(int(lst.size())) if int(lst.get(i).id) in pins)
        except Exception:
            n = len(pins)
        param.setResult(JInteger(n))

    def _before_move_dialogs(self, param):
        # only folder pins are reordered here, server pin order stays
        if not self._folder_open:
            return
        adapter = param.thisObject
        frag = get_private_field(adapter, "parentFragment")
        st = self._folder_st(frag) if frag is not None else None
        if st is None:
            return
        f = self._folder(st["uid"], st["folder"])
        args = param.args
        try:
            lst = frag.getDialogsArray(int(get_private_field(adapter, "currentAccount")),
                                       int(get_private_field(adapter, "dialogsType")),
                                       int(get_private_field(adapter, "folderId")), False)
            i = int(adapter.fixPosition(int(args[1])))
            j = int(adapter.fixPosition(int(args[2])))
            n = int(lst.size())
            if not (0 <= i < n and 0 <= j < n):
                return
            a, b = lst.get(i), lst.get(j)
            lst.set(i, b)
            lst.set(j, a)
            pins = set(int(x) for x in f.get("pinned", [])) if f is not None else set()
            order = []
            for k in range(n):
                did = int(lst.get(k).id)
                if did in pins:
                    order.append(did)
        except Exception:
            traceback.print_exc()
            return
        param.setResult(None)
        if f is not None and order:
            # pins of chats that aren't archived right now go last
            order += [int(x) for x in f.get("pinned", []) if int(x) not in order]
            f["pinned"] = order
            self._build_rules(st["uid"])
            st["pins_dirty"] = True
            st["cache"] = None
        try:
            adapter.updateList(None)
        except Exception:
            traceback.print_exc()

    def _before_hide_action_mode(self, param):
        if not self._folder_open:
            return
        frag = param.thisObject
        st = self._folder_st(frag)
        if st is None:
            return
        # stops the native code from sending the archive pin order to the server
        set_private_field(frag, "movingWas", False)
        if st.pop("pins_dirty", False):
            self._save(st["uid"], self._load(st["uid"]))

    def _after_update_counters(self, param):
        if not self._folder_open:
            return
        frag = param.thisObject
        st = self._folder_st(frag)
        if st is None:
            return
        rule = self._rules_of(st["uid"]).get(st["folder"])
        item = get_private_field(frag, "pinItem")
        sel = get_private_field(frag, "selectedDialogs")
        if rule is None or item is None or sel is None or int(sel.size()) == 0:
            return
        unpin = all(int(sel.get(i)) in rule["pinned"] for i in range(int(sel.size())))
        item.setVisibility(0)
        item.setIcon(_drawable("msg_unpin" if unpin else "msg_pin"))

    def _after_cell_update(self, param):
        if not self._folder_open:
            return
        cell = param.thisObject
        frag = get_private_field(cell, "parentFragment")
        st = self._folder_st(frag) if frag is not None else None
        if st is None:
            return
        rule = self._rules_of(st["uid"]).get(st["folder"])
        if rule is None:
            return
        try:
            if int(get_private_field(cell, "currentDialogFolderId") or 0) != 0:
                return
            want = int(cell.getDialogId()) in rule["pinned"]
            has = bool(get_private_field(cell, "drawPin"))
        except Exception:
            return
        if has != want:
            set_private_field(cell, "drawPin", want)
            if int(cell.getMeasuredWidth()) > 0:
                cell.buildLayout()
            cell.invalidate()

    # switching folders

    def _select(self, st, fid):
        st["folder"] = fid
        st["cache"] = None
        if self.get_setting("remember", True):
            self.set_setting("sel_%d" % st["uid"], fid)
        self._update_folder_open()
        self._apply_title(st)
        self._reload(st["acc"])

    @staticmethod
    def _reload(acc):
        _ui(lambda: NotificationCenter.getInstance(acc).postNotificationName(NotificationCenter.dialogsNeedReload))

    def _reload_all(self):
        for acc in set(st["acc"] for st in self._frags.values()):
            self._reload(acc)

    def _show_folders_popup(self, frag, anchor):
        st = self._st_for(frag)
        if st is None:
            return None
        fr = _weak(frag)
        uid, acc = st["uid"], st["acc"]
        folders = self._load(uid)["folders"]
        counts = self._counts(acc, uid)
        o = jclass("org.telegram.ui.Components.ItemOptions").makeOptions(frag, anchor, True)
        # the menu's views hold these callbacks, so they hold the menu weakly
        oref = _weak(o)
        accent = int(Theme.key_featuredStickers_addButton)
        icon_color = int(Theme.key_actionBarDefaultSubmenuItemIcon)
        text_color = int(Theme.key_actionBarDefaultSubmenuItem)
        red = int(Theme.key_text_RedRegular)
        rows = []

        def with_frag(fn):
            def run():
                f = fr.get()
                if f is not None:
                    fn(f)
            return run

        def add(icon, text, fn, active=False, danger=False, target=None):
            if danger:
                ik = tk = red
            elif active:
                ik = tk = accent
            else:
                ik, tk = icon_color, text_color
            menu = target or o
            menu.add(_drawable(icon), text, ik, tk, _Run(fn))
            if target is None:
                row = menu.getLast()
                if row is not None:
                    rows.append(row)

        add("msg_archive", _t("all"), lambda: self._select(st, ALL), active=st["folder"] == ALL)
        for f in folders:
            fid = int(f["id"])
            add("msg_folders", "%s  ·  %d" % (_short(f["name"]), counts.get(fid, 0)),
                lambda fid=fid: self._select(st, fid), active=st["folder"] == fid)
        o.addGap()

        def created(fid):
            self._select(st, fid)
            f = fr.get()
            if f is not None:
                self._open_picker(f, acc, uid, fid)
        add("msg_addfolder", _t("new_folder"), with_frag(lambda f: self._ask_name(f, uid, None, created)))

        cur = self._folder(uid, st["folder"]) if st["folder"] != ALL else None
        if cur is not None:
            # folder actions live in a submenu
            fid = int(cur["id"])
            sub = o.makeSwipeback()
            sref = _weak(sub)

            def act(fn):
                def run():
                    menu = oref.get()
                    if menu is not None:
                        menu.dismiss()
                    fn()
                return run

            def back():
                menu = oref.get()
                if menu is not None:
                    menu.closeSwipeback()

            def open_manage():
                menu, page = oref.get(), sref.get()
                if menu is not None and page is not None:
                    menu.openSwipeback(page)

            ids = [int(x["id"]) for x in folders]
            add("ic_ab_back", _t("back"), back, target=sub)
            sub.addGap()
            add("msg_select", _t("edit_chats"), act(with_frag(lambda f: self._open_picker(f, acc, uid, fid))), target=sub)
            add("msg_removefolder", _t("excluded_short"),
                act(with_frag(lambda f: self._open_picker(f, acc, uid, fid, None, True))), target=sub)
            add("msg_edit", _t("rename"),
                act(with_frag(lambda f: self._ask_name(f, uid, fid, lambda _fid: self._apply_title(st)))), target=sub)
            if ids[0] != fid:
                add("msg_go_up", _t("move_up"), act(lambda: self._move(uid, fid, -1)), target=sub)
            if ids[-1] != fid:
                add("msg_go_down", _t("move_down"), act(lambda: self._move(uid, fid, 1)), target=sub)
            sub.addGap()
            add("msg_delete", _t("delete"), act(with_frag(lambda f: self._confirm_delete(f, uid, fid))),
                danger=True, target=sub)
            add("msg_settings", _t("manage"), open_manage)
        try:
            o.setGravity(jclass("android.view.Gravity").RIGHT)
        except Exception:
            pass

        # newer ItemOptions replace the anchor's touch listener and drop it on release
        anchor_ref = _weak(anchor)

        def restore():
            state = st.get("hold")
            if state is not None:
                self._hold_end(state)
            view, listener, f = anchor_ref.get(), st.get("touch"), fr.get()
            if view is not None and listener is not None and f is not None and self._st_for(f) is st:
                view.setOnTouchListener(listener)
        try:
            o.setOnDismiss(_Run(lambda: _ui(restore, 60)))
        except Exception:
            traceback.print_exc()
        o.show()
        return o, rows

    # hold the button (or drag down from it) and slide to a row, like Telegram's ⋮

    def _hold_handler(self, fr, st):
        state = {}
        st["hold"] = state

        def disarm(v):
            run = state.pop("run", None)
            if run is not None:
                v.removeCallbacks(run)

        def open_menu(v):
            disarm(v)
            frag = fr.get()
            if frag is None or state.get("active"):
                return
            # end the button's own press, otherwise lifting the finger also counts as a tap
            try:
                MotionEvent = jclass("android.view.MotionEvent")
                now = int(jclass("android.os.SystemClock").uptimeMillis())
                cancel = MotionEvent.obtain(now, now, int(MotionEvent.ACTION_CANCEL), 0.0, 0.0, 0)
                v.onTouchEvent(cancel)
                cancel.recycle()
            except Exception:
                traceback.print_exc()
            if v.getParent() is not None:
                v.getParent().requestDisallowInterceptTouchEvent(True)
            shown = self._show_folders_popup(frag, v)
            if shown is None:
                return
            state["active"] = True
            state["menu"], state["rows"] = shown
            state["sel"] = None
            _haptic(v, strong=True)

        def touch(v, ev):
            action = int(ev.getActionMasked())
            if action == 0:
                disarm(v)
                state.clear()
                state["x"], state["y"] = float(ev.getRawX()), float(ev.getRawY())
                try:
                    state["slop"] = int(jclass("android.view.ViewConfiguration").get(v.getContext()).getScaledTouchSlop())
                except Exception:
                    state["slop"] = _dp(8)
                state["run"] = _Run(lambda: open_menu(v))
                v.postDelayed(state["run"], HOLD_MS)
                return False
            if state.get("active"):
                if action == 2:
                    self._hold_move(state, ev)
                elif action == 1:
                    self._hold_up(state)
                elif action == 3:
                    self._hold_end(state)
                return True
            if action == 2 and state.get("run") is not None:
                x, y = float(ev.getX()), float(ev.getY())
                if y > v.getHeight():
                    open_menu(v)
                    if state.get("active"):
                        self._hold_move(state, ev)
                    return True
                if x < 0 or x > v.getWidth() or y < 0:
                    disarm(v)
                return False
            if action in (1, 3):
                disarm(v)
            return False
        return touch

    @staticmethod
    def _hold_move(state, ev):
        x, y = float(ev.getRawX()), float(ev.getRawY())
        slop = state.get("slop", 16)
        if not state.get("moved") and (abs(x - state.get("x", x)) > slop or abs(y - state.get("y", y)) > slop):
            state["moved"] = True
        hit = None
        loc = jarray(jint)([0, 0])
        for row in state.get("rows") or []:
            if not row.isShown():
                continue
            row.getLocationOnScreen(loc)
            left, top = int(loc[0]), int(loc[1])
            if left <= x < left + row.getWidth() and top <= y < top + row.getHeight():
                hit = row
                break
        sel = state.get("sel")
        same = hit is not None and sel is not None and hit == sel
        if sel is not None and not same:
            sel.setPressed(False)
        if hit is not None and not same:
            hit.drawableHotspotChanged(float(x - left), float(y - top))
            hit.setPressed(True)
            _haptic(hit)
        state["sel"] = hit

    def _hold_up(self, state):
        sel, menu, moved = state.get("sel"), state.get("menu"), state.get("moved")
        self._hold_end(state)
        if sel is not None:
            sel.performClick()
        elif moved and menu is not None:
            menu.dismiss()
        # released on the button itself: menu stays open

    @staticmethod
    def _hold_end(state):
        sel = state.pop("sel", None)
        if sel is not None:
            sel.setPressed(False)
        for key in ("menu", "rows", "run"):
            state.pop(key, None)
        state["active"] = False

    # folder operations

    def _move(self, uid, fid, delta):
        d = self._load(uid)
        fs = d["folders"]
        for i, f in enumerate(fs):
            if int(f["id"]) == fid:
                j = i + delta
                if 0 <= j < len(fs):
                    fs[i], fs[j] = fs[j], fs[i]
                    self._save(uid, d)
                return

    def _apply_order(self, uid, ids, reload=True):
        d = self._load(uid)
        by_id = {int(f["id"]): f for f in d["folders"]}
        ordered = [by_id.pop(i) for i in ids if i in by_id]
        d["folders"] = ordered + [f for f in d["folders"] if int(f["id"]) in by_id]
        self._save(uid, d, reload)

    def _confirm_delete(self, frag, uid, fid, on_done=None):
        f = self._folder(uid, fid)
        if f is None:
            return
        b = AlertDialogBuilder(frag.getParentActivity())
        b.set_title(_t("delete"))
        b.set_message(_t("delete_q") % f["name"])

        def ok(_b, _w):
            d = self._load(uid)
            d["folders"] = [x for x in d["folders"] if int(x["id"]) != fid]
            self._save(uid, d)
            for st in self._frags.values():
                if st["uid"] == uid and st["folder"] == fid:
                    self._select(st, ALL)
            BulletinHelper.show_success(_t("deleted"))
            if on_done:
                on_done()
        b.set_positive_button(_t("delete"), ok)
        b.set_negative_button(_t("cancel"))
        b.make_button_red(AlertDialogBuilder.BUTTON_POSITIVE)
        b.show()

    def _store_name(self, uid, fid, name):
        d = self._load(uid)
        if fid is None:
            fid = int(d.get("next", 1))
            d["next"] = fid + 1
            d["folders"].append({"id": fid, "name": name, "chats": []})
        else:
            for f in d["folders"]:
                if int(f["id"]) == fid:
                    f["name"] = name
        self._save(uid, d)
        return fid

    def _ask_name(self, frag, uid, fid, on_done):
        ctx = frag.getParentActivity()
        if ctx is None:
            return
        existing = self._folder(uid, fid) if fid is not None else None
        edit = jclass("org.telegram.ui.Components.EditTextBoldCursor")(ctx)
        edit.setTextSize(1, 18.0)
        edit.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
        edit.setHintText(_t("name_hint"))
        edit.setSingleLine(True)
        edit.setCursorColor(Theme.getColor(Theme.key_dialogTextBlack))
        edit.setCursorSize(_dp(20))
        edit.setCursorWidth(1.5)
        edit.setLineColors(Theme.getColor(Theme.key_windowBackgroundWhiteInputField),
                           Theme.getColor(Theme.key_windowBackgroundWhiteInputFieldActivated),
                           Theme.getColor(Theme.key_text_RedRegular))
        edit.setPadding(0, 0, 0, _dp(8))
        if existing is not None:
            edit.setText(str(existing["name"]))
            edit.setSelection(int(edit.length()))
        frame = jclass("android.widget.FrameLayout")(ctx)
        frame.addView(edit, LayoutHelper.createFrame(-1, -2.0, 0x30, 24.0, 6.0, 24.0, 0.0))

        # dropped on dismiss, otherwise the dialog keeps itself alive through the callbacks
        refs = {"edit": edit, "frag": frag}
        b = AlertDialogBuilder(ctx)
        b.set_title(_t("rename") if existing is not None else _t("new_folder"))
        b.set_view(frame)

        def ok(_b, _w):
            field, page = refs.get("edit"), refs.get("frag")
            if field is None:
                return
            name = str(field.getText().toString()).strip()[:32]
            if not name:
                BulletinHelper.show_error(_t("name_empty"), page)
                return
            if self._name_taken(uid, name, fid):
                BulletinHelper.show_error(_t("name_taken"), page)
                return
            AndroidUtilities.hideKeyboard(field)
            on_done(self._store_name(uid, fid, name))
        b.set_positive_button(_t("save") if existing is not None else _t("create"), ok)
        b.set_negative_button(_t("cancel"))
        b.set_on_dismiss_listener(lambda _b: refs.clear())
        b.show()

        def focus():
            field = refs.get("edit")
            if field is not None:
                field.requestFocus()
                AndroidUtilities.showKeyboard(field)
        _ui(focus, 200)

    # export: zlib'd json under AES-GCM with a key baked into the plugin.
    # not real protection, just keeps the file unreadable

    def _export_payload(self, uid):
        out = []
        for f in self._load(uid)["folders"]:
            item = {"n": str(f["name"])}
            for key, short in (("chats", "c"), ("exclude", "x"), ("pinned", "p")):
                vals = [int(x) for x in f.get(key, [])]
                if vals:
                    item[short] = vals
            for key, short, mask in (("flags", "t", F_MASK), ("xflags", "e", X_MASK)):
                v = int(f.get(key, 0) or 0) & mask
                if v:
                    item[short] = v
            out.append(item)
        return {"v": 2, "f": out}

    @staticmethod
    def _read_payload(items):
        out = []
        for raw in items:
            if not isinstance(raw, dict):
                continue
            name = " ".join(str(raw.get("n") or "").split())[:32]
            if not name:
                continue
            f = {"name": name}
            for key, short in (("chats", "c"), ("exclude", "x"), ("pinned", "p")):
                vals = []
                for x in raw.get(short) or []:
                    try:
                        x = int(x)
                    except (TypeError, ValueError):
                        continue
                    if x and x not in vals:
                        vals.append(x)
                f[key] = vals
            try:
                f["flags"] = int(raw.get("t", 0) or 0) & F_MASK
                f["xflags"] = int(raw.get("e", 0) or 0) & X_MASK
            except (TypeError, ValueError):
                f["flags"] = f["xflags"] = 0
            out.append(f)
        return out or None

    @staticmethod
    def _aes_gcm(encrypt, key, nonce, data):
        Cipher = jclass("javax.crypto.Cipher")
        cipher = Cipher.getInstance("AES/GCM/NoPadding")
        cipher.init(Cipher.ENCRYPT_MODE if encrypt else Cipher.DECRYPT_MODE,
                    jclass("javax.crypto.spec.SecretKeySpec")(key, "AES"),
                    jclass("javax.crypto.spec.GCMParameterSpec")(128, nonce))
        res = cipher.doFinal(data)
        try:
            return bytes(res)
        except Exception:
            return bytes(int(x) & 0xFF for x in res)

    def _seal(self, uid):
        raw = json.dumps(self._export_payload(uid), ensure_ascii=False, separators=(",", ":")).encode("utf-8")
        nonce = os.urandom(12)
        return FILE_MAGIC + nonce + self._aes_gcm(True, FILE_KEY, nonce, zlib.compress(raw, 9))

    def _unseal(self, blob):
        if not blob.startswith(FILE_MAGIC):
            return None
        n = len(FILE_MAGIC)
        try:
            raw = self._aes_gcm(False, FILE_KEY, blob[n:n + 12], blob[n + 12:])
            data = json.loads(zlib.decompress(raw).decode("utf-8"))
        except Exception:
            return None
        if not isinstance(data, dict) or not isinstance(data.get("f"), list):
            return None
        return self._read_payload(data["f"])

    def _on_export_click(self, view):
        acc = self._selected_account()
        uid = self._uid(acc)
        if not self._load(uid)["folders"]:
            BulletinHelper.show_error(_t("export_empty"))
            return
        if send_document is None or get_cache_dir is None:
            BulletinHelper.show_error(_t("export_failed"))
            return
        try:
            path = os.path.join(get_cache_dir(), "Archive Folders.%s" % FILE_EXT)
            with open(path, "wb") as fh:
                fh.write(self._seal(uid))
            send_document(uid, path, "", account=acc)
            BulletinHelper.show_success(_t("exported"))
        except Exception:
            traceback.print_exc()
            BulletinHelper.show_error(_t("export_failed"))

    def _on_file_click(self, args):
        file = getattr(args, "file", None)
        try:
            ready = file is not None and file.exists() and int(file.length()) > 0
        except Exception:
            ready = False
        if not ready:
            _ui(lambda: BulletinHelper.show_error(_t("file_not_loaded")))
            return
        try:
            with open(str(file.getAbsolutePath()), "rb") as fh:
                folders = self._unseal(fh.read(1024 * 1024))
        except OSError:
            folders = None
        if not folders:
            _ui(lambda: BulletinHelper.show_error(_t("import_file_bad")))
            return
        try:
            acc = int(args.message.currentAccount)
        except Exception:
            acc = self._selected_account()
        ctx = getattr(args, "activity", None)
        if ctx is None:
            frag = getattr(args, "parent_fragment", None) or get_last_fragment()
            ctx = frag.getParentActivity() if frag is not None else None
        if ctx is not None:
            uid = self._uid(acc)
            _ui(lambda: self._ask_import(ctx, uid, folders))

    def _ask_import(self, ctx, uid, folders):
        has = bool(self._load(uid)["folders"])
        b = AlertDialogBuilder(ctx)
        b.set_title(_t("import"))
        msg = _t("import_found") % len(folders)
        if has:
            msg += " " + _t("import_merge")
        b.set_message(msg)
        b.set_positive_button(_t("import_add"), lambda _b, _w: self._apply_import(uid, folders, False))
        if has:
            b.set_neutral_button(_t("import_replace"), lambda _b, _w: self._apply_import(uid, folders, True))
            b.make_button_red(AlertDialogBuilder.BUTTON_NEUTRAL)
        b.set_negative_button(_t("cancel"))
        b.show()

    def _apply_import(self, uid, folders, replace):
        d = self._load(uid)
        if replace:
            d["folders"] = []
        taken = set(str(f["name"]).strip().lower() for f in d["folders"])
        for src in folders:
            name, n = src["name"], 2
            while name.strip().lower() in taken:
                suffix = " (%d)" % n
                name = src["name"][:32 - len(suffix)] + suffix
                n += 1
            taken.add(name.strip().lower())
            fid = int(d.get("next", 1))
            d["next"] = fid + 1
            d["folders"].append(dict(src, id=fid, name=name))
        self._save(uid, d)
        for st in self._frags.values():
            if st["uid"] != uid:
                continue
            if st["folder"] != ALL and self._folder(uid, st["folder"]) is None:
                self._select(st, ALL)
            else:
                self._apply_title(st)
        self._reload_all()
        self._refresh_settings()
        BulletinHelper.show_success(_t("imported") % len(folders))

    # putting selected chats into folders

    def _show_assign_dialog(self, frag, acc, dids, on_done=None):
        ctx = frag.getParentActivity()
        if ctx is None:
            return
        uid = self._uid(acc)
        folders = self._load(uid)["folders"]
        if not folders:
            fr = _weak(frag)

            def created(fid):
                self._assign(uid, dids, {fid: True}, acc)
                if on_done:
                    on_done()
                BulletinHelper.show_success(_t("added"), fr.get())
            self._ask_name(frag, uid, None, created)
            return

        rules = self._rules_of(uid)
        CheckBoxCell = jclass("org.telegram.ui.Cells.CheckBoxCell")
        box = jclass("android.widget.LinearLayout")(ctx)
        box.setOrientation(1)
        cells, initial = [], []
        for f in folders:
            inside = sum(1 for x in dids if self._in_rule(acc, rules[int(f["id"])], x, live=False))
            checked = inside == len(dids)
            cell = CheckBoxCell(ctx, 1)
            cell.setBackground(Theme.getSelectorDrawable(False))
            cell.setText(_short(f["name"], 30), "%d/%d" % (inside, len(dids)) if 0 < inside < len(dids) else "", checked, False)
            cell.setOnClickListener(_checkbox_toggle())
            box.addView(cell, LayoutHelper.createLinear(-1, 50))
            cells.append(cell)
            initial.append(checked)
        fids = [int(f["id"]) for f in folders]

        refs = {"cells": cells, "frag": frag}
        b = AlertDialogBuilder(ctx)
        b.set_title(_t("to_folder_title"))
        b.set_view(box)

        def ok(_b, _w):
            boxes = refs.get("cells") or []
            changes = {fid: bool(cell.isChecked()) for fid, cell, was in zip(fids, boxes, initial)
                       if bool(cell.isChecked()) != was}
            if changes:
                self._assign(uid, dids, changes, acc)
                BulletinHelper.show_success(_t("added"), refs.get("frag"))
            if on_done:
                on_done()

        def new_folder(_b, _w):
            page = refs.get("frag")
            if page is None:
                return
            fr = _weak(page)

            def created(_fid):
                f = fr.get()
                if f is not None:
                    self._show_assign_dialog(f, acc, dids, on_done)
            self._ask_name(page, uid, None, created)
        b.set_positive_button(_t("done"), ok)
        b.set_negative_button(_t("cancel"))
        b.set_neutral_button(_t("new_folder"), new_folder)
        b.set_on_dismiss_listener(lambda _b: refs.clear())
        b.show()

    def _assign(self, uid, dids, changes, acc):
        d = self._load(uid)
        rules = self._rules_of(uid)
        for f in d["folders"]:
            fid = int(f["id"])
            if fid in changes:
                self._set_membership(f, rules[fid]["flags"], dids, changes[fid], acc)
        self._save(uid, d)
        self._reload_all()

    # Telegram's chat picker, limited to archived chats

    def _open_picker(self, frag, acc, uid, fid, on_done=None, exclude=False):
        f = self._folder(uid, fid)
        if f is None or frag is None:
            return
        self._types = {}
        ids = ArrayList()
        for x in f.get("exclude" if exclude else "chats", []):
            ids.add(Long(int(x)))
        Picker = jclass("org.telegram.ui.UsersSelectActivity")
        if exclude:
            picker = Picker(False, ids, int(f.get("xflags", 0) or 0) & X_MASK)
        else:
            picker = Picker(True, ids, int(f.get("flags", 0) or 0) & F_MASK)
        picker.noChatTypes = False
        try:
            picker.setCurrentAccount(acc)
        except Exception:
            pass

        def picked(chosen, flags):
            d = self._load(uid)
            chosen_set = set(chosen)
            for x in d["folders"]:
                if int(x["id"]) != fid:
                    continue
                if exclude:
                    x["exclude"] = chosen
                    x["xflags"] = flags & X_MASK
                    x["chats"] = [c for c in x.get("chats", []) if int(c) not in chosen_set]
                else:
                    x["chats"] = chosen
                    x["flags"] = flags & F_MASK
                    x["exclude"] = [c for c in x.get("exclude", []) if int(c) not in chosen_set]
            self._save(uid, d)
            self._reload_all()
            BulletinHelper.show_success(_t("added"))
            if on_done:
                on_done()
        picker.setDelegate(_Picked(picked))
        self._pickers[_ident(picker)] = {"acc": acc, "uid": uid, "fid": fid, "exclude": exclude,
                                         "limits": None, "ref": _weak(picker)}
        frag.presentFragment(picker)

    def _picker_state(self, picker):
        ps = self._pickers.get(_ident(picker))
        if ps is None or not _alive(ps["ref"], picker):
            return None
        return ps

    def _restore_limits(self, ps):
        limits, ps["limits"] = ps.get("limits"), None
        if limits is None:
            return
        try:
            mc = _mc(ps["acc"])
            if int(mc.dialogFiltersChatsLimitDefault) == BIG_LIMIT:
                mc.dialogFiltersChatsLimitDefault = limits[0]
            if int(mc.dialogFiltersChatsLimitPremium) == BIG_LIMIT:
                mc.dialogFiltersChatsLimitPremium = limits[1]
        except Exception:
            traceback.print_exc()

    def _picker_after_create_view(self, param):
        if not self._pickers:
            return
        picker = param.thisObject
        ps = self._picker_state(picker)
        if ps is None:
            return
        f = self._folder(ps["uid"], ps["fid"])
        if f is not None:
            title = _t("excluded_title") % _short(f["name"], 14) if ps["exclude"] else _short(f["name"], 24)
            picker.getActionBar().setTitle(title)
        if ps["limits"] is None:
            # lift the 100/200 chat limit of folders while our picker is open
            mc = _mc(ps["acc"])
            ps["limits"] = (int(mc.dialogFiltersChatsLimitDefault), int(mc.dialogFiltersChatsLimitPremium))
            mc.dialogFiltersChatsLimitDefault = BIG_LIMIT
            mc.dialogFiltersChatsLimitPremium = BIG_LIMIT
        self._picker_subtitle(picker)

    def _picker_subtitle(self, picker):
        n = int(get_private_field(picker, "selectedCount") or 0)
        picker.getActionBar().setSubtitle(_t("selected_n") % n if n else _t("picker_none"))

    def _picker_after_update_hint(self, param):
        if self._pickers and self._picker_state(param.thisObject) is not None:
            self._picker_subtitle(param.thisObject)

    def _picker_before_destroy(self, param):
        if not self._pickers:
            return
        ps = self._picker_state(param.thisObject)
        if ps is None:
            return
        del self._pickers[_ident(param.thisObject)]
        for key in [k for k, v in self._adapters.items() if v[1] is ps]:
            del self._adapters[key]
        self._helpers.discard(ps.get("helper"))
        self._restore_limits(ps)

    def _adapter_after_init(self, param):
        if not self._pickers:
            return
        adapter = param.thisObject
        outer = get_private_field(adapter, "this$0")
        if outer is not None:
            ps = self._picker_state(outer)
        elif len(self._pickers) == 1:
            ps = next(iter(self._pickers.values()))
        else:
            ps = None
        if ps is None:
            return
        self._adapters[_ident(adapter)] = (_weak(adapter), ps)
        helper = get_private_field(adapter, "searchAdapterHelper")
        if helper is not None:
            ps["helper"] = _ident(helper)
            self._helpers.add(ps["helper"])
        contacts = get_private_field(adapter, "contacts")
        if contacts is None:
            return

        # only archived chats, the ones not in another folder first
        uid, fid, acc = ps["uid"], ps["fid"], ps["acc"]
        f = self._folder(uid, fid)
        members = set(int(x) for x in f.get("exclude" if ps["exclude"] else "chats", [])) if f is not None else set()
        archived = [did for did, _d in self._archived(acc)]
        allowed = set(archived) | members
        rank = {did: i for i, did in enumerate(archived)}
        others = [r for ofid, r in self._rules_of(uid).items() if ofid != fid]
        User = jclass("org.telegram.tgnet.TLRPC$User")
        Chat = jclass("org.telegram.tgnet.TLRPC$Chat")
        free, busy = [], []
        for i in range(int(contacts.size())):
            obj = contacts.get(i)
            if isinstance(obj, User):
                did = int(obj.id)
            elif isinstance(obj, Chat):
                did = -int(obj.id)
            else:
                continue
            if did not in allowed:
                continue
            elsewhere = did not in members and any(self._in_rule(acc, r, did, live=False) for r in others)
            (busy if elsewhere else free).append((rank.get(did, 1 << 30), obj))
        free.sort(key=lambda p: p[0])
        busy.sort(key=lambda p: p[0])
        contacts.clear()
        for _rank, obj in free + busy:
            contacts.add(obj)

    def _adapter_after_bind(self, param):
        if not self._adapters:
            return
        entry = self._adapters.get(_ident(param.thisObject))
        if entry is None or not _alive(entry[0], param.thisObject) or not param.args:
            return
        ps = entry[1]
        cell = param.args[0].itemView
        if not isinstance(cell, jclass("org.telegram.ui.Cells.GroupCreateUserCell")):
            return
        obj = cell.getObject()
        if obj is not None and str(obj) in ("archived", "muted", "read", "contacts", "non_contacts",
                                            "groups", "channels", "bots"):
            if str(obj) == "archived" and ps["exclude"]:
                cell.setAlpha(0.35)
                try:
                    cell.setCheckBoxEnabled(False)
                except Exception:
                    pass
            else:
                cell.setAlpha(1.0)
            return
        if isinstance(obj, jclass("org.telegram.tgnet.TLRPC$User")):
            did = int(obj.id)
        elif isinstance(obj, jclass("org.telegram.tgnet.TLRPC$Chat")):
            did = -int(obj.id)
        else:
            return
        rules = self._rules_of(ps["uid"])
        names = [str(f["name"]) for f in self._load(ps["uid"])["folders"]
                 if int(f["id"]) != ps["fid"] and self._in_rule(ps["acc"], rules[int(f["id"])], did, live=False)]
        if not names:
            return
        cell.setObject(obj, get_private_field(cell, "currentName"), _t("in_folders") % _join_short(names))
        cell.getStatusTextView().setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlueText))

    def _before_server_search(self, param):
        # server search is useless in a picker of archived chats
        if self._helpers and _ident(param.thisObject) in self._helpers:
            param.setResult(None)

    # ⋮ menu inside a chat

    def _add_chat_menu(self):
        if self._chat_item is not None:
            return
        try:
            self._chat_item = self.add_menu_item(MenuItemData(
                menu_type=MenuItemType.CHAT_ACTION_MENU,
                text=_t("to_folder"),
                icon="msg_folders",
                item_id="archive_folders_chat",
                on_click=self._on_chat_menu,
            ))
        except Exception:
            traceback.print_exc()

    def _on_chat_menu(self, context):
        frag = context.get("fragment")
        acc = context.get("account")
        did = context.get("dialog_id")
        if did is None:
            if context.get("userId"):
                did = int(context.get("userId"))
            elif context.get("chatId"):
                did = -int(context.get("chatId"))
        if acc is None and frag is not None:
            acc = int(frag.getCurrentAccount())
        if frag is None or acc is None or not did:
            if frag is not None:
                BulletinHelper.show_error(_t("no_dialog"), frag)
            return
        acc, did = int(acc), int(did)
        _ui(lambda: self._show_assign_dialog(frag, acc, [did]))
