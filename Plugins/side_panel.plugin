Long = jclass("java.lang.Long")
UserObject = jclass("org.telegram.messenger.UserObject")
DialogObject = jclass("org.telegram.messenger.DialogObject")
AndroidUtilities = jclass("org.telegram.messenger.AndroidUtilities")
Theme = jclass("org.telegram.ui.ActionBar.Theme")


def argb(c):
    c &= 0xFFFFFFFF
    return c - (1 << 32) if c >= (1 << 31) else c


def safe(fn, *args, default=None):
    try:
        return fn(*args)
    except Exception:
        log(traceback.format_exc())
        return default


def theme_color(name, fallback):
    try:
        return Theme.getColor(getattr(Theme, name)) & 0xFFFFFFFF
    except Exception:
        return fallback


class ClickListener(dynamic_proxy(jclass("android.view.View$OnClickListener"))):
    def __init__(self, fn):
        super().__init__()
        self.fn = fn

    def onClick(self, view):
        safe(self.fn)


class LongClickListener(dynamic_proxy(jclass("android.view.View$OnLongClickListener"))):
    def __init__(self, fn):
        super().__init__()
        self.fn = fn

    def onLongClick(self, view):
        safe(self.fn)
        return True


class TouchListener(dynamic_proxy(jclass("android.view.View$OnTouchListener"))):
    def __init__(self, fn):
        super().__init__()
        self.fn = fn

    def onTouch(self, view, event):
        return bool(safe(self.fn, view, event, default=False))


class RunnableProxy(dynamic_proxy(jclass("java.lang.Runnable"))):
    def __init__(self, fn):
        super().__init__()
        self.fn = fn

    def run(self):
        safe(self.fn)


class DialogClickListener(dynamic_proxy(jclass("android.content.DialogInterface$OnClickListener"))):
    def __init__(self, fn):
        super().__init__()
        self.fn = fn

    def onClick(self, dialog, which):
        safe(self.fn, which)


class PreDrawListener(dynamic_proxy(jclass("android.view.ViewTreeObserver$OnPreDrawListener"))):
    def __init__(self, fn):
        super().__init__()
        self.fn = fn

    def onPreDraw(self):
        safe(self.fn)
        return True


class LayoutChangeListener(dynamic_proxy(jclass("android.view.View$OnLayoutChangeListener"))):
    def __init__(self, fn):
        super().__init__()
        self.fn = fn

    def onLayoutChange(self, view, left, top, right, bottom, old_left, old_top, old_right, old_bottom):
        safe(self.fn)


class CheckedListener(dynamic_proxy(jclass("android.widget.CompoundButton$OnCheckedChangeListener"))):
    def __init__(self, fn):
        super().__init__()
        self.fn = fn

    def onCheckedChanged(self, button, checked):
        safe(self.fn, bool(checked))


class telegramSeekBarDelegate(dynamic_proxy(jclass("org.telegram.ui.Components.SeekBarView$SeekBarViewDelegate"))):
    def __init__(self, on_drag, on_pressed=None):
        super().__init__()
        self.on_drag = on_drag
        self.on_pressed = on_pressed

    def onSeekBarDrag(self, stop, progress):
        safe(self.on_drag, float(progress), bool(stop))

    def onSeekBarPressed(self, pressed):
        if self.on_pressed is not None:
            safe(self.on_pressed, bool(pressed))

    def getContentDescription(self):
        return ""

    def getStepsCount(self):
        return 0


def chat_kind(did, obj):
    if did > 0:
        return "bot" if getattr(obj, "bot", False) else "user"
    return "channel" if getattr(obj, "broadcast", False) else "group"


def chat_info(mc, did):
    if did > 0:
        obj = mc.getUser(Long(did))
        return obj, UserObject.getUserName(obj) if obj else None
    obj = mc.getChat(Long(-did))
    return obj, obj.title if obj else None


def load_dialogs(mc):
    out = []
    dialogs = mc.getAllDialogs()
    for i in range(dialogs.size()):
        dlg = dialogs.get(i)
        did = dlg.id
        if did == 0 or DialogObject.isEncryptedDialog(did) or getattr(dlg, "folder_id", 0) != 0:
            continue
        obj, title = chat_info(mc, did)
        if obj is not None and title:
            out.append((dlg, did, obj, title))
    return out


def char_sequences(items):
    return jarray(jclass("java.lang.CharSequence"))(items)


def show_sheet(ctx, title, items, on_pick):
    listener = DialogClickListener(on_pick)
    try:
        sheet = jclass("org.telegram.ui.ActionBar.BottomSheet$Builder")(ctx)
        sheet.setTitle(title)
        sheet.setItems(char_sequences(items), listener)
        return sheet.show()
    except Exception:
        log(traceback.format_exc())
        builder = jclass("android.app.AlertDialog$Builder")(ctx)
        builder.setTitle(title)
        builder.setItems(char_sequences(items), listener)
        return builder.show()


def show_dialog(ctx, title, view=None, message=None, button="готово"):
    try:
        builder = jclass("org.telegram.ui.ActionBar.AlertDialog$Builder")(ctx)
        builder.setTitle(title)
        if message:
            builder.setMessage(message)
        if view is not None:
            builder.setView(view)
        builder.setPositiveButton(button, None)
        return builder.show()
    except Exception:
        log(traceback.format_exc())
        builder = jclass("android.app.AlertDialog$Builder")(ctx)
        builder.setTitle(title)
        if message:
            builder.setMessage(message)
        if view is not None:
            builder.setView(view)
        builder.setPositiveButton(button, DialogClickListener(lambda which: None))
        return builder.show()


def checklist_view(ctx, rows, on_toggle):
    dp = AndroidUtilities.dp
    LinearLayout = jclass("android.widget.LinearLayout")
    scroll = jclass("android.widget.ScrollView")(ctx)
    col = LinearLayout(ctx)
    col.setOrientation(LinearLayout.VERTICAL)
    col.setPadding(dp(12), 0, dp(12), 0)
    text_color = argb(theme_color("key_dialogTextBlack", 0xFF000000))
    tint = jclass("android.content.res.ColorStateList").valueOf(argb(theme_color("key_dialogTextBlue", 0xFF3390EC)))
    CheckBox = jclass("android.widget.CheckBox")
    for i, (label, checked) in enumerate(rows):
        box = CheckBox(ctx)
        box.setText(label)
        box.setTextSize(15.0)
        box.setTextColor(text_color)
        box.setPadding(dp(6), dp(8), dp(6), dp(8))
        box.setChecked(checked)
        safe(box.setButtonTintList, tint)
        box.setOnCheckedChangeListener(CheckedListener(lambda on, i=i: on_toggle(i, on)))
        col.addView(box)
    scroll.addView(col)
    return scroll


class CreateViewHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        safe(self.plugin.sp_attach, param.thisObject, param.getResult())


class SidePanel(BasePlugin):
    sp_restyle = None

    def __init__(self):
        super().__init__()
        self._sp_cleanups = []
        self._sp_loaded = False

    def on_plugin_load(self):
        chat = find_class("org.telegram.ui.ChatActivity")
        method = chat.getClass().getDeclaredMethod("createView", jclass("android.content.Context"))
        self.hook_method(method, CreateViewHook(self))
        self._sp_loaded = True

    def on_plugin_unload(self):
        # очищаем созданные view и listener при обновлении плагина.
        cleanups = list(getattr(self, "_sp_cleanups", []))
        self._sp_cleanups = []
        for cleanup in cleanups:
            try:
                cleanup()
            except Exception:
                pass
        self.sp_restyle = None
        self._sp_loaded = False

    def _on_chat_mode_change(self, value):
        try:
            self.set_setting("chat_mode", int(value), reload_settings=True)
        except Exception:
            self.set_setting("chat_mode", int(value))

    def _on_color_code_change(self, value):
        code = str(value or "").strip().replace("#", "").upper()
        if len(code) == 6:
            try:
                int(code, 16)
                self.set_setting("panel_color", code)
                if self.sp_restyle is not None:
                    safe(self.sp_restyle)
            except Exception:
                pass

    def _on_ids_change(self, value):
        raw = str(value or "")
        ids = []
        for part in raw.replace(";", ",").split(","):
            part = part.strip()
            if not part:
                continue
            try:
                did = int(part)
                if did != 0 and did not in ids:
                    ids.append(did)
            except Exception:
                continue
        self.sp_save_ids("selected_chats", ids)

    def _on_count_change(self, value):
        raw = str(value or "").strip()
        try:
            n = int(raw)
        except Exception:
            return
        if n > 3000:
            self.set_setting("count_custom", 3000)
            return
        n = max(1, n)
        self.set_setting("count_custom", n)

    def _make_slider_setting(self, key, title, minimum, maximum, default, suffix):
        def create_view(context, list_view, current_account, class_guid, resources_provider):
            LinearLayout = jclass("android.widget.LinearLayout")
            TextView = jclass("android.widget.TextView")
            SeekBarView = jclass("org.telegram.ui.Components.SeekBarView")
            dp = AndroidUtilities.dp
            root = LinearLayout(context)
            root.setOrientation(LinearLayout.VERTICAL)
            root.setPadding(dp(20), dp(10), dp(20), dp(10))
            label = TextView(context)
            label.setText(title)
            label.setTextSize(16.0)
            try:
                label.setTextColor(argb(theme_color("key_windowBackgroundWhiteBlackText", 0xFFFFFFFF)))
            except Exception:
                pass
            root.addView(label, jclass("android.widget.LinearLayout$LayoutParams")(-1, dp(30)))
            value = TextView(context)
            value.setTextSize(14.0)
            value.setGravity(GRAV_CENTER)
            try:
                value.setTextColor(argb(theme_color("key_windowBackgroundWhiteValueText", 0xFFAAAAAA)))
            except Exception:
                pass
            root.addView(value, jclass("android.widget.LinearLayout$LayoutParams")(-1, dp(24)))
            seek = SeekBarView(context)
            safe(seek.setReportChanges, True)
            value._sidepanel_seek = seek
            value._sidepanel_label = label
            root._sidepanel_seek = seek
            root._sidepanel_value = value
            def drag(progress, stop):
                current = minimum + int(round((maximum - minimum) * max(0.0, min(1.0, float(progress)))))
                value.setText(str(current) + suffix)
                self.set_setting(key, current)
                if self.sp_restyle is not None:
                    safe(self.sp_restyle)
            safe(seek.setDelegate, telegramSeekBarDelegate(drag))
            root.addView(seek, jclass("android.widget.LinearLayout$LayoutParams")(-1, dp(42)))
            return root

        def bind_view(view, item, divider, adapter, list_view):
            value = int(self.get_setting(key, default))
            value = max(minimum, min(maximum, value))
            seek = getattr(view, "_sidepanel_seek", None)
            text = getattr(view, "_sidepanel_value", None)
            if text is not None:
                text.setText(str(value) + suffix)
            if seek is not None:
                safe(seek.setProgress, (value - minimum) / float(maximum - minimum))

        return Custom(factory=SimpleSettingFactory(create_view, bind_view, is_clickable=False).instance.java)

    def _on_animation_change(self, new_index):
        try:
            self.set_setting("panel_animation", int(new_index))
        except Exception:
            pass
        if hasattr(self, "sp_restyle"):
            safe(self.sp_restyle)

    def create_settings(self):
        mode = int(self.get_setting("chat_mode", 0))
        base = [
            Header(text="чаты"),
            Selector(
                key="chat_mode",
                text="режим чатов",
                default=0,
                items=["выбранные", "из категории"],
                on_change=self._on_chat_mode_change,
            ),
        ]

        if mode == 0:
            chat_section = [
                Header(text="выбранные чаты"),
                Input(
                    key="selected_ids_text",
                    text="id чатов",
                    default=",".join(str(x) for x in self.sp_get_ids("selected_chats")),
                    subtext="добавьте id через запятую. например: 123456789, -1001234567890",
                    on_change=self._on_ids_change,
                ),
                Header(text="фильтры"),
                Switch(key="show_saved", text="показывать избранное", default=True),
                Switch(key="show_pinned", text="показывать закреплённые чаты", default=True),
            ]
        else:
            chat_section = [
                Header(text="категории"),
                Switch(key="show_users", text="личные чаты", default=True),
                Switch(key="show_bots", text="боты", default=True),
                Switch(key="show_groups", text="группы", default=True),
                Switch(key="show_channels", text="каналы", default=True),
                Text(text="исключения", on_click=lambda view: self.sp_open_exceptions(None)),
                Header(text="фильтры"),
                Switch(key="show_saved", text="показывать избранное", default=True),
                Switch(key="show_pinned", text="показывать закреплённые чаты", default=True),
                Input(
                    key="count_custom",
                    text="количество чатов",
                    default=str(self.get_setting("count_custom", 50)),
                    subtext="Введите число от 1 до 3000",
                    on_change=self._on_count_change,
                ),
            ]

        return base + chat_section + [
            Header(text="панель"),
            self._make_slider_setting("panel_width", "размер панели", 44, 100, 60, " dp"),
            self._make_slider_setting("vertical_offset", "вертикальное смещение", -120, 240, 0, " dp"),
            Switch(key="close_on_tap", text="закрывать по тапу вне панели", default=True),
            Switch(key="keyboard_hide", text="скрывать при наборе текста", default=False),
            Header(text="внешний вид"),
            Text(text="цвет панели", on_click=lambda view: self.sp_open_palette(None)),
            Selector(
                key="panel_animation",
                text="анимация панели",
                default=0,
                items=["плавная", "быстрая", "масштаб", "без анимации"],
                on_change=self._on_animation_change,
            ),
            self._make_slider_setting("opacity", "прозрачность панели", 20, 100, 100, "%"),
            self._make_slider_setting("corner_radius", "закругление", 0, 28, 14, " dp"),
            Header(text="дополнительно"),
            Text(text="скрытые чаты", on_click=lambda view: self.sp_open_hidden(None)),
        ]

    def sp_context(self, ctx):
        if ctx is None and get_last_fragment is not None:
            ctx = get_last_fragment().getParentActivity()
        return ctx

    def sp_get_ids(self, key):
        try:
            raw = str(self.get_setting(key, "") or "")
            return [int(x) for x in raw.split(",") if x.strip()]
        except Exception:
            return []

    def sp_save_ids(self, key, ids):
        safe(self.set_setting, key, ",".join(str(x) for x in ids))

    def sp_kind_flags(self):
        return {kind: bool(self.get_setting(key, True)) for kind, key in KIND_KEYS.items()}

    def sp_color_choice(self):
        choice = str(self.get_setting("panel_color", DEFAULT_COLOR) or DEFAULT_COLOR).strip().replace("#", "").upper()
        if len(choice) != 6:
            return DEFAULT_COLOR
        try:
            int(choice, 16)
            return choice
        except Exception:
            return DEFAULT_COLOR

    def sp_open_palette(self, ctx):
        try:
            ctx = self.sp_context(ctx)
            if ctx is None:
                return
            frag = get_last_fragment() if get_last_fragment is not None else None
            if frag is None:
                return
            act = frag.getParentActivity()
            if act is None:
                return
            try:
                resources_provider = frag.getResourceProvider()
            except Exception:
                resources_provider = None
            Color = jclass("android.graphics.Color")
            try:
                initial_color = Color.parseColor("#" + self.sp_color_choice())
            except Exception:
                initial_color = argb(theme_color("key_dialogBackground", 0xFF1B1B1B))

            try:
                from org.telegram.ui.Components.Paint import ColorPickerBottomSheet
                from androidx.core.util import Consumer
                PipetteDelegate = find_class("org.telegram.ui.Components.Paint.ColorPickerBottomSheet$PipetteDelegate")
                PipetteDelegateProxy = dynamic_proxy(PipetteDelegate)

                class _PipetteDelegate(PipetteDelegateProxy):
                    def __init__(self):
                        super().__init__()
                    def onStartColorPipette(self): return None
                    def onStopColorPipette(self): return None
                    def getContainerView(self): return None
                    def getSnapshotDrawingView(self): return None
                    def onDrawImageOverCanvas(self, bitmap, canvas): return None
                    def isPipetteVisible(self): return False
                    def isPipetteAvailable(self): return False
                    def onColorSelected(self, color): return None

                ConsumerProxy = dynamic_proxy(Consumer)

                class _ColorConsumer(ConsumerProxy):
                    def __init__(self, plugin):
                        super().__init__()
                        self._plugin = plugin
                    def accept(self, color):
                        try:
                            color_int = int(color)
                        except Exception:
                            return
                        self._plugin.set_setting("panel_color", "{:06X}".format(color_int & 0xFFFFFF))
                        if self._plugin.sp_restyle is not None:
                            safe(self._plugin.sp_restyle)

                self._sp_color_picker_pipette = _PipetteDelegate()
                self._sp_color_picker_consumer = _ColorConsumer(self)
                sheet = ColorPickerBottomSheet(act, resources_provider)
                try:
                    sheet.setCanceledOnTouchOutside(False)
                except Exception:
                    pass
                sheet.setPipetteDelegate(self._sp_color_picker_pipette)
                sheet.setColor(initial_color)
                sheet.setColorListener(self._sp_color_picker_consumer)
                run_on_ui_thread(sheet.show)
                return
            except Exception:
                pass

            try:
                ColorPicker = jclass("org.telegram.ui.Components.ColorPicker")
                ColorPickerDelegate = find_class("org.telegram.ui.Components.ColorPicker$ColorPickerDelegate")
                ColorPickerDelegateProxy = dynamic_proxy(ColorPickerDelegate)
                selected = {"color": initial_color}

                class _PickerDelegate(ColorPickerDelegateProxy):
                    def __init__(self):
                        super().__init__()
                    def setColor(self, color, num, applyNow):
                        try:
                            selected["color"] = int(color)
                        except Exception:
                            pass

                self._sp_color_picker_delegate = _PickerDelegate()
                picker = ColorPicker(act, False, self._sp_color_picker_delegate)
                try:
                    picker.setColor(initial_color, 0)
                except Exception:
                    pass
                def save_color(_dialog=None):
                    self.set_setting("panel_color", "{:06X}".format(int(selected["color"]) & 0xFFFFFF))
                    if self.sp_restyle is not None:
                        safe(self.sp_restyle)
                dialog = show_dialog(act, "цвет панели", view=picker, button="готово")
                return dialog
            except Exception:
                log(traceback.format_exc())
        except Exception:
            log(traceback.format_exc())

    def sp_open_slider(self, ctx, title, key, minimum, maximum, default, suffix=""):
        try:
            ctx = self.sp_context(ctx)
            if ctx is None:
                return
            LinearLayout = jclass("android.widget.LinearLayout")
            TextView = jclass("android.widget.TextView")
            dp = AndroidUtilities.dp
            root = LinearLayout(ctx)
            root.setOrientation(LinearLayout.VERTICAL)
            root.setPadding(dp(18), dp(6), dp(18), dp(8))

            value = int(self.get_setting(key, default))
            value = max(minimum, min(maximum, value))

            label = TextView(ctx)
            label.setText(str(value) + suffix)
            label.setTextSize(18.0)
            label.setGravity(GRAV_CENTER)
            root.addView(label, jclass("android.widget.LinearLayout$LayoutParams")(-1, dp(42)))

            try:
                SeekBarView = jclass("org.telegram.ui.Components.SeekBarView")
                seek = SeekBarView(ctx)
                safe(seek.setReportChanges, True)
                progress = (value - minimum) / float(maximum - minimum) if maximum != minimum else 0.0
                safe(seek.setProgress, progress)
                safe(seek.setDelegate, telegramSeekBarDelegate(lambda p, stop: self._slider_changed(key, minimum, maximum, p, suffix, label)))
                root.addView(seek, jclass("android.widget.LinearLayout$LayoutParams")(-1, dp(48)))
            except Exception:
                SeekBar = jclass("android.widget.SeekBar")
                seek = SeekBar(ctx)
                seek.setMax(maximum - minimum)
                seek.setProgress(value - minimum)
                root.addView(seek, jclass("android.widget.LinearLayout$LayoutParams")(-1, dp(48)))

                class SeekListener(dynamic_proxy(jclass("android.widget.SeekBar$OnSeekBarChangeListener"))):
                    def onProgressChanged(self, bar, progress, fromUser):
                        current = minimum + int(progress)
                        label.setText(str(current) + suffix)
                        if fromUser:
                            self_outer.set_setting(key, current)
                            if self_outer.sp_restyle is not None:
                                safe(self_outer.sp_restyle)

                    def onStartTrackingTouch(self, bar):
                        pass

                    def onStopTrackingTouch(self, bar):
                        pass

                self_outer = self
                seek.setOnSeekBarChangeListener(SeekListener())

            show_dialog(ctx, title, view=root, button="готово")
        except Exception:
            log(traceback.format_exc())

    def _slider_changed(self, key, minimum, maximum, progress, suffix, label):
        current = minimum + int(round((maximum - minimum) * max(0.0, min(1.0, float(progress)))))
        label.setText(str(current) + suffix)
        self.set_setting(key, current)
        if self.sp_restyle is not None:
            safe(self.sp_restyle)

    def sp_open_hidden(self, ctx):
        try:
            ctx = self.sp_context(ctx)
            if ctx is None:
                return
            UC = jclass("org.telegram.messenger.UserConfig")
            mc = jclass("org.telegram.messenger.MessagesController").getInstance(UC.selectedAccount)
            ids = self.sp_get_ids("hidden")
            if not ids:
                show_dialog(ctx, "скрытые чаты", message="скрытых чатов нет", button="ок")
                return

            def title_of(did):
                obj, title = chat_info(mc, did)
                return str(title) if title else str(did)

            rows = [(did, title_of(did)) for did in ids]

            def toggled(which, checked):
                did = rows[which][0]
                cur = self.sp_get_ids("hidden")
                if checked and did not in cur:
                    cur.append(did)
                elif not checked and did in cur:
                    cur.remove(did)
                self.sp_save_ids("hidden", cur)

            view = checklist_view(ctx, [(r[1], True) for r in rows], toggled)
            show_dialog(ctx, "скрытые чаты", view=view)
        except Exception:
            log(traceback.format_exc())

    def sp_open_exceptions(self, ctx):
        try:
            ctx = self.sp_context(ctx)
            if ctx is None:
                return
            UC = jclass("org.telegram.messenger.UserConfig")
            mc = jclass("org.telegram.messenger.MessagesController").getInstance(UC.selectedAccount)
            me = UC.getInstance(UC.selectedAccount).getClientUserId()
            flags = self.sp_kind_flags()
            exc = self.sp_get_ids("exceptions")

            rows = []
            for dlg, did, obj, title in load_dialogs(mc):
                kind = chat_kind(did, obj)
                if did != me and (not flags[kind] or did in exc):
                    rows.append((did, "%s (%s)" % (title, KIND_LABELS[kind]), did in exc))

            if not rows:
                show_dialog(
                    ctx, "всегда показывать",
                    message="все типы чатов включены. отключите нужный тип, и его чаты появятся здесь.",
                    button="ок",
                )
                return

            def toggled(which, checked):
                did = rows[which][0]
                cur = self.sp_get_ids("exceptions")
                if checked and did not in cur:
                    cur.append(did)
                elif not checked and did in cur:
                    cur.remove(did)
                self.sp_save_ids("exceptions", cur)
                if self.sp_restyle is not None:
                    safe(self.sp_restyle)

            view = checklist_view(ctx, [(r[1], r[2]) for r in rows], toggled)
            show_dialog(ctx, "всегда показывать", view=view)
        except Exception:
            log(traceback.format_exc())

    def sp_attach(self, fragment, root):
        if root is None or root.findViewWithTag(TAG) is not None:
            return
        added = []
        try:
            self.sp_build(fragment, root, added)
        except Exception:
            log(traceback.format_exc())
            for v in added:
                safe(root.removeView, v)

    def sp_build(self, fragment, root, added):
        def pick(key, default, table):
            try:
                return table[int(self.get_setting(key, default))]
            except Exception:
                return table[default]

        chat_mode = pick_mode = int(self.get_setting("chat_mode", 0))
        show_users = bool(self.get_setting("show_users", True))
        show_bots = bool(self.get_setting("show_bots", True))
        show_groups = bool(self.get_setting("show_groups", True))
        show_channels = bool(self.get_setting("show_channels", True))
        show_saved = bool(self.get_setting("show_saved", True))
        show_pinned = bool(self.get_setting("show_pinned", True))
        panel_animation = max(0, min(3, int(self.get_setting("panel_animation", 0))))
        close_on_tap = bool(self.get_setting("close_on_tap", True))
        hide_on_keyboard = bool(self.get_setting("keyboard_hide", False))
        limit = max(1, min(3000, int(self.get_setting("count_custom", 50))))
        panel_width = max(44, min(100, int(self.get_setting("panel_width", 60))))
        S = dict(SIZES[1])
        scale = panel_width / 60.0
        S["width"] = panel_width
        S["avatar"] = max(28, int(S["avatar"] * scale))
        S["item_height"] = max(58, int(S["item_height"] * scale))
        S["text_size"] = max(9.0, S["text_size"] * min(scale, 1.15))
        S["badge"] = max(12, int(S["badge"] * min(scale, 1.2)))
        S["handle_width"] = max(18, int(S["handle_width"] * scale))
        S["handle_height"] = max(40, int(S["handle_height"] * scale))

        UC = jclass("org.telegram.messenger.UserConfig")
        CM = jclass("org.telegram.tgnet.ConnectionsManager")
        LinearLayout = jclass("android.widget.LinearLayout")
        FrameLayout = jclass("android.widget.FrameLayout")
        ScrollView = jclass("android.widget.ScrollView")
        TextView = jclass("android.widget.TextView")
        View = jclass("android.view.View")
        LP = jclass("android.widget.LinearLayout$LayoutParams")
        FLP = jclass("android.widget.FrameLayout$LayoutParams")
        Gradient = jclass("android.graphics.drawable.GradientDrawable")
        Typeface = jclass("android.graphics.Typeface")
        BackupImageView = jclass("org.telegram.ui.Components.BackupImageView")
        AvatarDrawable = jclass("org.telegram.ui.Components.AvatarDrawable")
        TextUtils = jclass("android.text.TextUtils")
        Bundle = jclass("android.os.Bundle")
        ChatActivity = jclass("org.telegram.ui.ChatActivity")

        dp = AndroidUtilities.dp
        ctx = root.getContext()
        acc = UC.selectedAccount
        mc = jclass("org.telegram.messenger.MessagesController").getInstance(acc)
        me = UC.getInstance(acc).getClientUserId()
        slop = jclass("android.view.ViewConfiguration").get(ctx).getScaledTouchSlop()
        pin_set = set()
        pin_order = []
        dlg_map = {}
        style = {}
        guard = {"view": None, "since": 0.0}

        def read_style():
            choice = self.sp_color_choice()
            if choice == "THEME":
                rgb = theme_color("key_windowBackgroundWhite", 0xFF1B1B1B) & 0xFFFFFF
                text = theme_color("key_windowBackgroundWhiteBlackText", 0xFFFFFFFF)
            else:
                rgb = int(choice, 16)
                luma = 0.299 * (rgb >> 16 & 255) + 0.587 * (rgb >> 8 & 255) + 0.114 * (rgb & 255)
                text = 0xFF000000 if luma > 160 else 0xFFFFFFFF
            style["rgb"] = rgb
            style["text"] = text
            try:
                raw_opacity = int(self.get_setting("opacity", 100))
            except Exception:
                raw_opacity = 100
            if raw_opacity in (0, 1, 2):
                alpha = OPACITY[raw_opacity]
            else:
                alpha = max(20, min(100, raw_opacity)) * 255 // 100
            style["alpha"] = alpha

        read_style()

        def is_muted(did):
            try:
                return bool(mc.isDialogMuted(did, 0))
            except Exception:
                return bool(safe(mc.isDialogMuted, did, default=False))

        vertical_offset = max(-120, min(240, int(self.get_setting("vertical_offset", 0))))
        corner_radius = max(0, min(28, int(self.get_setting("corner_radius", 14))))
        show_unread_badges = True
        def top_px():
            base = dp(TOP_FALLBACK)
            try:
                ab = fragment.getActionBar()
                h = int(ab.getY()) + int(ab.getHeight())
                if h > 0:
                    base = h + dp(6) + dp(TOP_OFFSET)
            except Exception:
                pass
            return max(0, base + dp(vertical_offset))

        def make_badge(count, muted, size):
            badge = TextView(ctx)
            badge.setText("99+" if count > 99 else str(count))
            badge.setTextSize(float(size) * 0.68)
            badge.setTypeface(Typeface.DEFAULT_BOLD)
            badge.setTextColor(argb(theme_color("key_chats_unreadCounterText", 0xFFFFFFFF)))
            badge.setGravity(GRAV_CENTER)
            badge.setPadding(dp(4), 0, dp(4), 0)
            badge.setMinWidth(dp(size))
            badge.setIncludeFontPadding(False)
            bg = Gradient()
            bg.setCornerRadius(float(dp(size)) / 2.0)
            if muted:
                bg.setColor(argb(theme_color("key_chats_unreadCounterMuted", 0xFF5A5A5A)))
            else:
                bg.setColor(argb(theme_color("key_chats_unreadCounter", 0xFFB06CEC)))
            badge.setBackground(bg)
            return badge

        def make_pin_dot():
            dot = View(ctx)
            bg = Gradient()
            bg.setShape(OVAL)
            bg.setColor(argb(theme_color("key_chats_unreadCounter", 0xFFB06CEC)))
            dot.setBackground(bg)
            return dot

        def is_online(did, obj):
            try:
                if did <= 0 or did == me or getattr(obj, "bot", False):
                    return False
                return bool(UserObject.isUserOnline(obj))
            except Exception:
                try:
                    status = getattr(obj, "status", None)
                    return status is not None and int(getattr(status, "expires", 0)) > int(CM.getInstance(acc).getCurrentTime())
                except Exception:
                    return False

        def make_online_dot():
            dot = View(ctx)
            bg = Gradient()
            bg.setShape(OVAL)
            bg.setColor(argb(theme_color("key_chats_onlineCircle", 0xFF4DCD5E)))
            bg.setStroke(dp(2), argb(0xFF000000 | style["rgb"]))
            dot.setBackground(bg)
            return dot

        def make_avatar(did, obj, size_dp):
            avatar = BackupImageView(ctx)
            avatar.setRoundRadius(dp(size_dp // 2))
            ad = AvatarDrawable()
            if did == me:
                try:
                    ad.setAvatarType(AvatarDrawable.AVATAR_TYPE_SAVED)
                    avatar.setImageDrawable(ad)
                    return avatar
                except Exception:
                    pass
            ad.setInfo(acc, obj)
            avatar.setForUserOrChat(obj, ad)
            return avatar

        def make_args(did):
            args = Bundle()
            if did > 0:
                args.putLong("user_id", did)
            else:
                args.putLong("chat_id", -did)
            return args

        def open_chat(did):
            fragment.presentFragment(ChatActivity(make_args(did)))
            # telegram отмечает диалог прочитанным не мгновенно, поэтому обновляем счётчик после открытия.
            root.postDelayed(RunnableProxy(refill), 500)
            root.postDelayed(RunnableProxy(refill), 1200)

        def open_profile(did):
            try:
                if did > 0:
                    ProfileActivity = jclass("org.telegram.ui.ProfileActivity")
                    args = Bundle()
                    args.putLong("user_id", did)
                    fragment.presentFragment(ProfileActivity(args))
                else:
                    ChatProfileActivity = jclass("org.telegram.ui.ChatProfileActivity")
                    args = Bundle()
                    args.putLong("chat_id", -did)
                    fragment.presentFragment(ChatProfileActivity(args))
            except Exception:
                open_chat(did)

        def toggle_pin(did):
            ids = self.sp_get_ids("pinned")
            if did in ids:
                ids.remove(did)
            else:
                ids.append(did)
            self.sp_save_ids("pinned", ids)
            refill()

        def refill_later():
            root.postDelayed(RunnableProxy(refill), 400)

        def mark_read(did):
            dlg = dlg_map.get(did)
            if dlg is None:
                return
            mc.markDialogAsRead(did, dlg.top_message, dlg.top_message, dlg.last_message_date, False, 0, dlg.unread_count, True, 0)
            refill_later()

        def toggle_mute(did):
            notifications = jclass("org.telegram.messenger.NotificationsController").getInstance(acc)
            mute = not is_muted(did)
            try:
                notifications.muteDialog(did, 0, mute)
            except Exception:
                notifications.muteDialog(did, mute)
            refill_later()

        def hide_chat(did):
            ids = self.sp_get_ids("hidden")
            if did not in ids:
                ids.append(did)
            self.sp_save_ids("hidden", ids)
            self.sp_save_ids("pinned", [x for x in self.sp_get_ids("pinned") if x != did])
            refill()

        def move_pin(did, delta):
            ids = self.sp_get_ids("pinned")
            if did not in ids:
                return
            i = ids.index(did)
            j = i + delta
            if 0 <= j < len(ids):
                ids[i], ids[j] = ids[j], ids[i]
                self.sp_save_ids("pinned", ids)
                refill()

        def menu_entries(did, in_peek=False):
            entries = [("открыть", lambda: open_chat(did))] if in_peek else [("предпросмотр", lambda: preview(did))]
            if did != me:
                entries.append(("открыть профиль", lambda: open_profile(did)))
            if did != me:
                entries.append(("открепить" if did in pin_set else "закрепить", lambda: toggle_pin(did)))
            if did in pin_set:
                idx = pin_order.index(did)
                if idx > 0:
                    entries.append(("переместить выше", lambda: move_pin(did, -1)))
                if idx < len(pin_order) - 1:
                    entries.append(("переместить ниже", lambda: move_pin(did, 1)))
            dlg = dlg_map.get(did)
            if dlg is not None and int(dlg.unread_count) > 0:
                entries.append(("отметить прочитанным", lambda: mark_read(did)))
            if did != me:
                entries.append(("включить звук" if is_muted(did) else "выключить звук", lambda: toggle_mute(did)))
                entries.append(("скрыть из панели", lambda: hide_chat(did)))
            return entries

        def show_menu(did, title):
            entries = menu_entries(did)
            show_sheet(ctx, title, [e[0] for e in entries], lambda which: entries[which][1]())

        def clear_guard():
            view = guard["view"]
            guard["view"] = None
            if view is not None:
                safe(root.removeView, view)

        def close_preview():
            safe(fragment.finishPreviewFragment)
            clear_guard()

        def add_guard():
            clear_guard()

            def on_touch(view, event):
                if event.getActionMasked() == 0:
                    close_preview()
                return True

            view = View(ctx)
            view.setOnTouchListener(TouchListener(on_touch))
            root.addView(view, FLP(MATCH, MATCH))
            guard["view"] = view
            guard["since"] = time.monotonic()

        def preview_closed():
            if guard["view"] is None or time.monotonic() - guard["since"] < 0.8:
                return False
            return not safe(lambda: bool(fragment.getParentLayout().isInPreviewMode()), default=True)

        def after_peek(action):
            close_preview()
            root.post(RunnableProxy(action))

        def peek_menu(did):
            Layout = jclass("org.telegram.ui.ActionBar.ActionBarPopupWindow$ActionBarPopupWindowLayout")
            SubItem = jclass("org.telegram.ui.ActionBar.ActionBarMenuSubItem")
            menu = Layout(ctx)
            entries = menu_entries(did, in_peek=True)
            for i, (label, action) in enumerate(entries):
                row = SubItem(ctx, i == 0, i == len(entries) - 1)
                row.setTextAndIcon(label, 0)
                row.setMinimumWidth(dp(180))
                row.setOnClickListener(ClickListener(lambda action=action: after_peek(action)))
                menu.addView(row)
            return menu

        def preview(did):
            def go():
                chat = ChatActivity(make_args(did))
                shown = safe(lambda: bool(fragment.presentFragmentAsPreviewWithMenu(chat, peek_menu(did))), default=False)
                if shown:
                    root.postDelayed(RunnableProxy(lambda: fragment.getParentLayout().movePreviewFragment(float(dp(120)))), 150)
                elif safe(fragment.presentFragmentAsPreview, ChatActivity(make_args(did)), default=False):
                    shown = True
                else:
                    open_chat(did)
                if shown:
                    add_guard()
            root.post(RunnableProxy(go))

        dialog_cache = load_dialogs(mc)
        by_id_cache = {e[1]: e for e in dialog_cache}
        dlg_map.clear()
        dlg_map.update({e[1]: e[0] for e in dialog_cache})
        me_entry = next((e for e in dialog_cache if e[1] == me), None)

        # порядок обычных чатов меняется только когда у чата появляется новое сообщение.
        # прочтение чата само по себе его не перемещает.
        message_order = []
        seen_top_messages = {}
        order_initialized = False

        def collect():
            selected = set(self.sp_get_ids("selected_chats"))
            hidden = set(self.sp_get_ids("hidden"))
            pinned = [x for x in self.sp_get_ids("pinned") if x != me and x not in hidden]
            pin_set.clear()
            pin_set.update(pinned)
            pin_order[:] = pinned

            out = []
            if show_saved and me_entry is not None:
                out.append((me_entry[0], me_entry[1], me_entry[2], "избранное"))

            if show_pinned:
                for pid in pinned:
                    entry = by_id_cache.get(pid)
                    if entry is not None:
                        out.append(entry)

            if chat_mode == 0:
                candidates = selected
            else:
                candidates = set(by_id_cache.keys())

            current_flags = self.sp_kind_flags()
            exceptions = set(self.sp_get_ids("exceptions"))

            normal = []
            for did in candidates:
                if did == me or did in hidden:
                    continue
                if show_pinned and did in pin_set:
                    continue
                entry = by_id_cache.get(did)
                if entry is None:
                    continue
                dlg, _, obj, _ = entry
                if chat_mode != 0:
                    kind = chat_kind(did, obj)
                    # исключение имеет приоритет над фильтром категории.
                    if not current_flags.get(kind, False) and did not in exceptions:
                        continue
                normal.append(entry)

            nonlocal order_initialized

            current_ids = {e[1] for e in normal}
            entry_by_id = {e[1]: e for e in normal}

            if not order_initialized:
                # Первый показ панели — обычная сортировка по последнему сообщению.
                normal.sort(key=lambda e: int(getattr(e[0], "last_message_date", 0)), reverse=True)
                message_order[:] = [e[1] for e in normal]
                for e in normal:
                    seen_top_messages[e[1]] = int(getattr(e[0], "top_message", 0))
                order_initialized = True
            else:
                # Новое top_message = новое сообщение. Такой чат поднимается наверх.
                new_messages = []
                for e in normal:
                    did = e[1]
                    top_message = int(getattr(e[0], "top_message", 0))
                    previous = seen_top_messages.get(did)
                    if previous is not None and top_message != previous:
                        new_messages.append(did)
                    seen_top_messages[did] = top_message

                # Сначала убираем исчезнувшие чаты из порядка.
                message_order[:] = [did for did in message_order if did in current_ids]

                # Каждый чат с новым сообщением поднимается наверх.
                for did in new_messages:
                    if did in message_order:
                        message_order.remove(did)
                    message_order.insert(0, did)

                # Новые для панели чаты добавляем в конец.
                for e in normal:
                    did = e[1]
                    if did not in message_order:
                        message_order.append(did)

            ordered_normal = [entry_by_id[did] for did in message_order if did in entry_by_id]
            out.extend(ordered_normal)
            return out[:limit]

        W = dp(S["width"])
        AV = S["avatar"]
        HW, HH = dp(S["handle_width"]), dp(S["handle_height"])

        cont = FrameLayout(ctx)
        cont.setTag(TAG)
        cont.setClipChildren(False)

        wrap = FrameLayout(ctx)
        rr = float(dp(corner_radius))
        wbg = Gradient()
        wbg.setCornerRadius(rr)
        wrap.setBackground(wbg)
        wrap.setClipChildren(True)
        wrap.setClipToOutline(True)
        try:
            wrap.setOutlineProvider(jclass("android.view.ViewOutlineProvider").BACKGROUND)
        except Exception:
            pass

        scroll = ScrollView(ctx)
        scroll.setClipToPadding(True)
        scroll.setVerticalScrollBarEnabled(False)
        scroll.setOverScrollMode(OVERSCROLL_NEVER)
        wrap.addView(scroll, FLP(MATCH, MATCH))

        col = LinearLayout(ctx)
        col.setOrientation(LinearLayout.VERTICAL)
        col.setPadding(0, dp(6), 0, dp(6))
        scroll.addView(col, FLP(MATCH, WRAP))
        cont.addView(wrap, FLP(W, MATCH, GRAV_END))

        def make_item(dlg, did, obj, title):
            item = LinearLayout(ctx)
            item.setOrientation(LinearLayout.VERTICAL)
            item.setGravity(GRAV_CENTER_H)

            box = FrameLayout(ctx)
            box.setClipChildren(False)
            box.addView(make_avatar(did, obj, AV), FLP(dp(AV), dp(AV)))

            unread = int(dlg.unread_count) if dlg is not None else 0
            if show_unread_badges and unread > 0:
                blp = FLP(WRAP, dp(S["badge"]), GRAV_TOP_LEFT)
                blp.leftMargin = dp(-2)
                blp.topMargin = dp(-1)
                box.addView(make_badge(unread, is_muted(did), S["badge"]), blp)
            if did in pin_set:
                plp = FLP(dp(7), dp(7), GRAV_TOP_RIGHT)
                plp.rightMargin = dp(-1)
                plp.topMargin = dp(-1)
                box.addView(make_pin_dot(), plp)
            if is_online(did, obj):
                olp = FLP(dp(11), dp(11), GRAV_BOTTOM_RIGHT)
                olp.rightMargin = dp(-1)
                olp.bottomMargin = dp(-1)
                box.addView(make_online_dot(), olp)
            item.addView(box, LP(dp(AV), dp(AV)))

            if True:
                label = TextView(ctx)
                label.setText(title)
                label.setTextSize(S["text_size"])
                label.setTextColor(argb(style["text"]))
                label.setLines(2)
                label.setEllipsize(TextUtils.TruncateAt.END)
                label.setGravity(GRAV_TOP_CENTER_H)
                llp = LP(W - dp(4), dp(int(S["text_size"] * 2.4) + 2))
                llp.topMargin = dp(2)
                item.addView(label, llp)

            item.setOnClickListener(ClickListener(lambda: open_chat(did)))
            item.setOnLongClickListener(LongClickListener(lambda: show_menu(did, title)))
            return item

        def refill():
            col.removeAllViews()
            for dlg, did, obj, title in collect():
                item = safe(make_item, dlg, did, obj, title)
                if item is not None:
                    col.addView(item, LP(MATCH, dp(S["item_height"])))

        refill()

        handle = TextView(ctx)
        handle.setGravity(GRAV_CENTER)
        handle.setTypeface(Typeface.DEFAULT_BOLD)
        handle.setTextSize(float(S["handle_height"]) * 0.55)
        handle.setIncludeFontPadding(False)
        hbg = Gradient()
        r = float(HH) / 2.0
        hbg.setCornerRadii([r, r, 0.0, 0.0, 0.0, 0.0, r, r])
        handle.setBackground(hbg)

        def apply_colors():
            alpha = style["alpha"]
            wbg.setStroke(0, argb(0))
            wbg.setColor(argb((alpha << 24) | style["rgb"]))
            hbg.setColor(argb((min(alpha, HANDLE_ALPHA) << 24) | style["rgb"]))
            handle.setTextColor(argb(style["text"]))

        apply_colors()

        def restyle():
            nonlocal corner_radius, W, HW, HH, panel_animation
            read_style()
            corner_radius = max(0, min(28, int(self.get_setting("corner_radius", 14))))
            show_pinned = bool(self.get_setting("show_pinned", True))
            panel_animation = max(0, min(3, int(self.get_setting("panel_animation", 0))))
            wbg.setCornerRadius(float(dp(corner_radius)))
            apply_colors()
            refill()
            try:
                lp = cont.getLayoutParams()
                if lp is not None:
                    lp.topMargin = top_px()
                    cont.setLayoutParams(lp)
            except Exception:
                pass

        self.sp_restyle = restyle

        hlp = FLP(HW, HH, GRAV_START_CENTER_V)
        hlp.topMargin = dp(HANDLE_SHIFT * 2)
        cont.addView(handle, hlp)

        scrim = View(ctx)
        scrim.setVisibility(GONE)
        root.addView(scrim, FLP(MATCH, MATCH))
        added.append(scrim)

        clp = FLP(W + HW, MATCH, GRAV_END)
        clp.topMargin = top_px()
        clp.bottomMargin = dp(BOTTOM_MARGIN)
        root.addView(cont, clp)
        added.append(cont)

        pos_bar = jarray(jint)([0, 0])
        pos_root = jarray(jint)([0, 0])

        def bottom_limit():
            # Нижняя граница панели должна следовать за верхом поля ввода.
            # Это особенно важно при открытой клавиатуре: не даём панели
            # схлопнуться из-за разных координат root/window/IME.
            root_h = int(root.getHeight())
            limit = root_h - dp(BOTTOM_MARGIN)
            top = int(top_px())
            min_h = dp(110)

            bar = safe(fragment.getChatActivityEnterView)
            if bar is not None and bar.getVisibility() == VISIBLE and bar.getHeight() > 0:
                try:
                    bar.getLocationOnScreen(pos_bar)
                    root.getLocationOnScreen(pos_root)
                    bar_bottom = int(pos_bar[1]) - int(pos_root[1]) - dp(8)
                    if bar_bottom > top + min_h:
                        limit = min(limit, bar_bottom)
                except Exception:
                    pass

            try:
                rect = jclass("android.graphics.Rect")()
                root.getWindowVisibleDisplayFrame(rect)
                loc = jarray(jint)([0, 0])
                root.getLocationOnScreen(loc)
                visible_bottom = int(rect.bottom) - int(loc[1]) - dp(8)
                if visible_bottom > top + min_h:
                    limit = min(limit, visible_bottom)
            except Exception:
                pass

            # getKeyboardHeight() используем только как запасной источник.
            # В некоторых версиях Telegram он возвращает координату/высоту
            # в другой системе, из-за чего панель раньше могла исчезать.
            if hide_on_keyboard:
                try:
                    kh = int(root.getKeyboardHeight())
                    keyboard_bottom = root_h - kh - dp(8)
                    if kh > dp(80) and keyboard_bottom > top + min_h:
                        limit = min(limit, keyboard_bottom)
                except Exception:
                    pass

            return max(top + min_h, limit)

        def fit():
            if root.getHeight() <= 0:
                return
            lp = cont.getLayoutParams()
            t = top_px()
            nh = bottom_limit() - t
            if nh > 0 and (lp.height != nh or lp.topMargin != t):
                lp.height = nh
                lp.topMargin = t
                cont.setLayoutParams(lp)

        root.post(RunnableProxy(fit))

        try:
            interpolator = jclass("org.telegram.ui.Components.CubicBezierInterpolator").DEFAULT
        except Exception:
            interpolator = None
        arrow = {"open": None}

        def keyboard_open():
            try:
                return int(root.getKeyboardHeight()) > dp(80)
            except Exception:
                rect = jclass("android.graphics.Rect")()
                root.getWindowVisibleDisplayFrame(rect)
                return root.getRootView().getHeight() - rect.bottom > dp(120)

        keyboard = {"hidden": False}
        frame_state = {"height": -1, "top": -1, "bottom": -1, "keyboard": None}

        def sync_geometry():
            try:
                height = int(root.getHeight())
                if height <= 0:
                    return
                typing = keyboard_open() if hide_on_keyboard else False
                top = int(top_px())
                bottom = int(bottom_limit())
                changed = (frame_state["height"] != height or
                           frame_state["top"] != top or
                           frame_state["bottom"] != bottom or
                           frame_state["keyboard"] != typing)
                if not changed:
                    return
                frame_state["height"] = height
                frame_state["top"] = top
                frame_state["bottom"] = bottom
                frame_state["keyboard"] = typing
                # При наборе текста панель не прячем: она должна просто
                # подняться до верхней границы поля ввода/клавиатуры.
                hidden = bottom - top < dp(110)
                if hidden != keyboard["hidden"]:
                    keyboard["hidden"] = hidden
                    cont.setVisibility(GONE if hidden else VISIBLE)
                    scrim.setVisibility(VISIBLE if (not hidden and arrow["open"] and close_on_tap) else GONE)
                if not hidden:
                    fit()
            except Exception:
                pass

        # не проверяем preview на каждом кадре.
        root_layout_listener = LayoutChangeListener(sync_geometry)
        root.addOnLayoutChangeListener(root_layout_listener)
        enter_view_listener = None
        try:
            enter_view = fragment.getChatActivityEnterView()
            if enter_view is not None:
                enter_view_listener = LayoutChangeListener(sync_geometry)
                enter_view.addOnLayoutChangeListener(enter_view_listener)
        except Exception:
            enter_view_listener = None

        def cleanup_instance():
            try:
                if enter_view_listener is not None:
                    ev = fragment.getChatActivityEnterView()
                    if ev is not None:
                        ev.removeOnLayoutChangeListener(enter_view_listener)
            except Exception:
                pass
            try:
                root.removeOnLayoutChangeListener(root_layout_listener)
            except Exception:
                pass
            try:
                cont.animate().cancel()
            except Exception:
                pass
            try:
                for v in list(added):
                    root.removeView(v)
            except Exception:
                pass

        self._sp_cleanups.append(cleanup_instance)
        root.post(RunnableProxy(sync_geometry))

        def set_arrow(is_open):
            if arrow["open"] is is_open:
                return
            arrow["open"] = is_open
            handle.setText("\u203a" if is_open else "\u2039")

        def set_tx(x):
            x = max(0.0, min(float(W), x))
            cont.setTranslationX(x)
            set_arrow(x < W / 2.0)

        def animate_to(x):
            cont.animate().cancel()
            opening = x < W / 2.0
            duration = 220 if panel_animation == 0 else 120
            if panel_animation == 3:
                set_tx(float(x))
                cont.setAlpha(1.0)
                cont.setScaleX(1.0)
                cont.setScaleY(1.0)
            elif panel_animation == 2:
                start_scale = 0.94 if opening else 1.0
                end_scale = 1.0 if opening else 0.94
                if opening:
                    cont.setScaleX(start_scale)
                    cont.setScaleY(start_scale)
                anim = cont.animate().translationX(float(x)).scaleX(end_scale).scaleY(end_scale).setDuration(duration)
                if interpolator is not None:
                    anim.setInterpolator(interpolator)
                anim.start()
            else:
                anim = cont.animate().translationX(float(x)).setDuration(duration)
                if interpolator is not None:
                    anim.setInterpolator(interpolator)
                anim.start()
            is_open = x < W / 2.0
            set_arrow(is_open)
            scrim.setVisibility(VISIBLE if (is_open and close_on_tap) else GONE)

        def toggle():
            if cont.getTranslationX() >= W / 2.0:
                fit()
                refill()
                animate_to(0.0)
            else:
                animate_to(float(W))

        drag = {"x0": 0.0, "base": 0.0, "moved": False}

        def on_handle(v, e):
            action = e.getActionMasked()
            if action == 0:
                drag["x0"] = e.getRawX()
                drag["base"] = float(cont.getTranslationX())
                drag["moved"] = False
                cont.animate().cancel()
                v.getParent().requestDisallowInterceptTouchEvent(True)
            elif action == 2:
                dx = e.getRawX() - drag["x0"]
                if not drag["moved"] and abs(dx) > slop:
                    drag["moved"] = True
                    if drag["base"] >= W / 2.0:
                        fit()
                        refill()
                if drag["moved"]:
                    set_tx(drag["base"] + dx)
            elif action in (1, 3):
                if drag["moved"]:
                    animate_to(0.0 if cont.getTranslationX() < W / 2.0 else float(W))
                elif action == 1:
                    toggle()
            return True

        handle.setOnTouchListener(TouchListener(on_handle))

        def on_scrim(v, e):
            if e.getActionMasked() == 0:
                animate_to(float(W))
            return True

        scrim.setOnTouchListener(TouchListener(on_scrim))
        set_tx(float(W))