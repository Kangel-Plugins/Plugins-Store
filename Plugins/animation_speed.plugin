__id__ = "animation_speed"
__name__ = "Animation Speed"
__description__ = "Меняет скорость всех анимаций в Telegram: от 0.5x до 2x."
__author__ = "@qwukato"
__version__ = "3.1"
__icon__ = "materialexpressive/55"
__category__ = ["appearance"]
__app_version__ = ">=12.10.6"

import traceback

from base_plugin import BasePlugin, MethodHook
from hook_utils import find_class
from java import jclass, jfloat, jint, jlong

try:
    from java import dynamic_proxy
except Exception:
    dynamic_proxy = None
try:
    from java import jarray
except Exception:
    jarray = None
try:
    from ui.settings import Header, Switch, Selector, Divider, Text
except Exception:
    Header = Switch = Selector = Divider = Text = None
try:
    from ui.settings import Custom, SimpleSettingFactory
except Exception:
    Custom = SimpleSettingFactory = None

INSTANT = 9999.0        # «мгновенно», как в Inugram
SPEED_MIN = 0.5
SPEED_STEP = 0.05
STEPS = 30              # 0.5 … 2.0 шагом 0.05 → позиции 0…30
SEEK_MAX = STEPS + 1    # позиция 31 — «мгновенно»
INT_MIN = -2147483648   # RecyclerView.UNDEFINED_DURATION

SELECTOR_VALUES = [INSTANT, 2.0, 1.75, 1.5, 1.25, 1.0, 0.75, 0.5]  # запасной вариант


# ------------------------------------------------------------- значения
def snap(v):
    """Округление до 0.05 в диапазоне 0.5…2.0 (мгновенно не трогаем)."""
    if v >= 100:
        return INSTANT
    v = round(float(v) / SPEED_STEP) * SPEED_STEP
    return round(max(SPEED_MIN, min(2.0, v)), 2)


def fmt(v):
    if v >= 100:
        return "Мгновенно"
    return ("%.2f" % v).rstrip("0").rstrip(".") + "x"


def progress_of(v):
    if v >= 100:
        return SEEK_MAX
    return int(round((snap(v) - SPEED_MIN) / SPEED_STEP))


def speed_of(p):
    if p >= SEEK_MAX:
        return INSTANT
    return round(SPEED_MIN + SPEED_STEP * p, 2)


# ------------------------------------- ползунок: родной SeekBarView Telegram
_PLUGIN = [None]


def _create_slider_row(context, list_view, account, class_guid, resources_provider):
    from android.widget import LinearLayout, TextView
    from org.telegram.messenger import AndroidUtilities
    from org.telegram.ui.ActionBar import Theme
    from org.telegram.ui.Components import LayoutHelper, SeekBarView

    dp = AndroidUtilities.dp
    root = LinearLayout(context)
    root.setOrientation(LinearLayout.VERTICAL)
    root.setBackgroundColor(Theme.getColor(Theme.key_windowBackgroundWhite))
    root.setPadding(dp(21), dp(14), dp(21), dp(6))

    top = LinearLayout(context)
    top.setOrientation(LinearLayout.HORIZONTAL)
    title = TextView(context)
    title.setText("Скорость анимаций")
    title.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText))
    title.setTextSize(1, 16.0)
    value = TextView(context)
    value.setText("1x")
    value.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteValueText))
    value.setTextSize(1, 16.0)
    top.addView(title, LayoutHelper.createLinear(0, -2, 1.0))
    top.addView(value, LayoutHelper.createLinear(-2, -2))
    root.addView(top, LayoutHelper.createLinear(-1, -2))

    bar = SeekBarView(context)
    bar.setReportChanges(True)
    bar.setSeparatorsCount(SEEK_MAX + 1)
    state = {"p": None}

    def commit():
        plugin = _PLUGIN[0]
        if plugin is not None and state["p"] is not None:
            plugin.set_speed(speed_of(state["p"]))
            state["p"] = None

    def on_drag(stop, progress):
        p = max(0, min(SEEK_MAX, int(round(float(progress) * SEEK_MAX))))
        state["p"] = p
        value.setText(fmt(speed_of(p)))
        if stop:
            commit()

    def on_pressed(pressed):
        if not pressed:
            commit()

    iface = jclass("org.telegram.ui.Components.SeekBarView$SeekBarViewDelegate")
    delegate = type("_SeekDelegate", (dynamic_proxy(iface),), {
        "onSeekBarDrag": lambda self_, stop, progress: on_drag(stop, progress),
        "onSeekBarPressed": lambda self_, pressed: on_pressed(pressed),
        "getContentDescription": lambda self_: None,
        "getStepsCount": lambda self_: 0,
    })()
    bar.setDelegate(delegate)
    root.addView(bar, LayoutHelper.createLinear(-1, 38))
    return root


def _bind_slider_row(view, item, divider, adapter, list_view):
    plugin = _PLUGIN[0]
    sp = plugin.speed if plugin is not None else 1.0
    view.getChildAt(0).getChildAt(1).setText(fmt(sp))
    view.getChildAt(1).setProgress(progress_of(sp) / float(SEEK_MAX))


_SLIDER_FACTORY = None
if SimpleSettingFactory is not None and dynamic_proxy is not None:
    try:
        _SLIDER_FACTORY = SimpleSettingFactory(
            _create_slider_row, _bind_slider_row, is_clickable=False, is_shadow=False)
    except Exception:
        _SLIDER_FACTORY = None


# ---------------------------------------------------------------- хуки
class _AFSetDuration(MethodHook):
    """AnimatedFloat/AnimatedColor.setDuration(long): запоминаем оригинал, делим на скорость."""
    def __init__(self, p, reg):
        self.p = p
        self.reg = reg

    def before_hooked_method(self, param):
        try:
            orig = int(param.args[0])
            self.reg.put(param.thisObject, jlong(orig))
            s = self.p.eff_speed()
            if s != 1.0:
                param.args[0] = jlong(max(1, int(orig / s)))
        except Exception:
            pass


class _AFCtor(MethodHook):
    """Конструктор: запоминаем оригинальную длительность и масштабируем."""
    def __init__(self, p, field, reg):
        self.p = p
        self.field = field
        self.reg = reg

    def after_hooked_method(self, param):
        try:
            obj = param.thisObject
            orig = int(self.field.getLong(obj))
            self.reg.put(obj, jlong(orig))
            s = self.p.eff_speed()
            if s != 1.0:
                self.field.setLong(obj, jlong(max(1, int(orig / s))))
        except Exception:
            pass


class _DynFrame(MethodHook):
    """DynamicAnimation.doAnimationFrame: ускоряем/замедляем время пружин и fling."""
    def __init__(self, p, field):
        self.p = p
        self.field = field

    def before_hooked_method(self, param):
        try:
            if not self.p.springs:
                return
            s = min(self.p.eff_speed(), 1000.0)
            if s == 1.0:
                return
            obj = param.thisObject
            frame = int(param.args[0])
            last = int(self.field.getLong(obj))
            if last > 0 and frame > last:
                self.field.setLong(obj, jlong(frame - int((frame - last) * s)))
        except Exception:
            pass


class _SpringStiffness(MethodHook):
    """Запасной путь для пружин: жёсткость ~ скорость²."""
    def __init__(self, p):
        self.p = p

    def before_hooked_method(self, param):
        try:
            if not self.p.springs:
                return
            s = min(self.p.eff_speed(), 8.0)
            if s != 1.0:
                param.args[0] = jfloat(float(param.args[0]) * s * s)
        except Exception:
            pass


class _StartScroll(MethodHook):
    """Scroller/OverScroller.startScroll(x, y, dx, dy, duration): плавные прокрутки
    (RecyclerView.smoothScrollBy, прокрутка к сообщению, свои скроллеры)."""
    def __init__(self, p):
        self.p = p

    def before_hooked_method(self, param):
        try:
            s = self.p.eff_speed()
            if not self.p.scroll or s == 1.0 or len(param.args) != 5:
                return
            d = int(param.args[4])
            if d > 0:
                param.args[4] = jint(max(1, int(d / s)))
        except Exception:
            pass


class _AnimDuration(MethodHook):
    """android.view.animation.Animation.setDuration(long) — старые Animation-классы."""
    def __init__(self, p):
        self.p = p

    def before_hooked_method(self, param):
        try:
            s = self.p.eff_speed()
            if s != 1.0:
                param.args[0] = jlong(max(1, int(int(param.args[0]) / s)))
        except Exception:
            pass


class _VAStart(MethodHook):
    """Ручной режим: если Android не дал выставить масштаб, делим длительность
    каждого ValueAnimator при старте (повторные старты не накапливают деление)."""
    def __init__(self, p):
        self.p = p

    def before_hooked_method(self, param):
        try:
            p = self.p
            if not p.manual_active:
                return
            s = p.eff_speed()
            obj = param.thisObject
            d = int(obj.getDuration())
            orig = p._va_orig.get(obj)
            scaled = p._va_scaled.get(obj)
            base = int(orig) if (orig is not None and scaled is not None and d == int(scaled)) else d
            new = max(1, int(base / s)) if s != 1.0 else base
            p._va_orig.put(obj, jlong(base))
            p._va_scaled.put(obj, jlong(new))
            if new != d:
                obj.setDuration(jlong(new))
        except Exception:
            pass


class _NavStart(MethodHook):
    def __init__(self, p):
        self.p = p

    def after_hooked_method(self, param):
        try:
            self.p._apply_scale()
            self.p.nav_attach(param.thisObject)
        except Exception:
            self.p._log("nav attach error: " + traceback.format_exc())


class _NavRun(MethodHook):
    def __init__(self, p):
        self.p = p

    def before_hooked_method(self, param):
        try:
            self.p.nav_before(param)
        except Exception:
            self.p._log("nav before error: " + traceback.format_exc())

    def after_hooked_method(self, param):
        try:
            self.p.nav_after(param)
        except Exception:
            self.p._log("nav after error: " + traceback.format_exc())


class _OnResume(MethodHook):
    def __init__(self, p):
        self.p = p

    def after_hooked_method(self, param):
        self.p._load()
        self.p._apply_scale()


# --------------------------------------------------------------- плагин
class AnimationSpeed(BasePlugin):
    def on_plugin_load(self):
        self.speed = 1.0
        self.enabled = True
        self.nav = True
        self.springs = True
        self.scroll = True
        self._af = []            # [(class, field, weak-registry)]
        self._nav_hooked = set()
        self._nav_outer = {}
        self._nav_layout = None
        self._nav_rfield = None
        self._f_prog = None
        self._f_last = None
        self._nav_p0 = 0.0
        self._AL = None
        _PLUGIN[0] = self
        self.status = {}
        self._scale_ok = False
        self.manual_active = False
        self._manual_hooked = False
        Collections = jclass("java.util.Collections")
        WHM = jclass("java.util.WeakHashMap")
        self._va_orig = Collections.synchronizedMap(WHM())
        self._va_scaled = Collections.synchronizedMap(WHM())
        self.System = jclass("java.lang.System")
        self._load()
        self.apply()

        # 1) AnimatedFloat / AnimatedColor — основа анимаций интерфейса Telegram
        for cname in ("org.telegram.ui.Components.AnimatedFloat",
                      "org.telegram.ui.Components.AnimatedColor"):
            try:
                C = find_class(cname)
                f = C.getDeclaredField("transitionDuration")
                f.setAccessible(True)
                Collections = jclass("java.util.Collections")
                reg = Collections.synchronizedMap(jclass("java.util.WeakHashMap")())
                self.hook_all_methods(C, "setDuration", _AFSetDuration(self, reg))
                ctor_hook = _AFCtor(self, f, reg)
                ok = len(self.hook_all_constructors(C, ctor_hook) or [])
                self._af.append((C, f, reg))
                self._mark(cname.split(".")[-1], ok > 0,
                           "конструкторов: %d" % ok if ok else "конструкторы не перехвачены")
                if not ok:
                    self._log(cname + ": constructors not hooked")
            except Exception:
                self._mark(cname.split(".")[-1], False, "класс/поле не найдены")
                self._log(cname + " hook failed: " + traceback.format_exc())

        # 2) переходы между экранами (покадровая анимация ActionBarLayout)
        try:
            AL = find_class("org.telegram.ui.ActionBar.ActionBarLayout")
            self._AL = AL
            self._f_prog = AL.getDeclaredField("animationProgress")
            self._f_last = AL.getDeclaredField("lastFrameTime")
            self._f_prog.setAccessible(True)
            self._f_last.setAccessible(True)
            self.hook_all_methods(AL, "startLayoutAnimation", _NavStart(self))
            self._mark("Переходы между экранами", True, "ждёт первого перехода")
        except Exception:
            self._mark("Переходы между экранами", False, "поля ActionBarLayout не найдены")
            self._log("nav hook failed: " + traceback.format_exc())

        # 3) пружины и fling: время кадра DynamicAnimation (запасной путь — жёсткость)
        frame_ok = False
        for cname in ("androidx.dynamicanimation.animation.DynamicAnimation",
                      "org.telegram.ui.Components.spring.DynamicAnimation"):
            try:
                D = find_class(cname)
                f = D.getDeclaredField("mLastFrameTime")
                f.setAccessible(True)
                self.hook_all_methods(D, "doAnimationFrame", _DynFrame(self, f))
                frame_ok = True
            except Exception:
                pass
        self._mark("Пружины и fling", True, "по времени кадра" if frame_ok else "через жёсткость")
        if not frame_ok:
            for cname in ("androidx.dynamicanimation.animation.SpringForce",
                          "org.telegram.ui.Components.spring.SpringForce"):
                try:
                    SF = find_class(cname)
                    self.hook_all_methods(SF, "setStiffness", _SpringStiffness(self))
                except Exception:
                    pass

        # 4) автопрокрутка: любые startScroll с заданной длительностью
        ok = 0
        for cname in ("android.widget.OverScroller", "android.widget.Scroller"):
            try:
                self.hook_all_methods(find_class(cname), "startScroll", _StartScroll(self))
                ok += 1
            except Exception:
                self._log(cname + " hook failed: " + traceback.format_exc())
        self._mark("Автопрокрутка", ok > 0, "Scroller/OverScroller: %d/2" % ok)

        # 4b) старые android.view.animation.Animation
        try:
            self.hook_all_methods(find_class("android.view.animation.Animation"),
                                  "setDuration", _AnimDuration(self))
            self._mark("Animation (старые)", True)
        except Exception:
            self._mark("Animation (старые)", False, "хук не встал")

        # 5) подтверждаем масштаб при возврате в приложение
        try:
            LA = find_class("org.telegram.ui.LaunchActivity")
            self.hook_all_methods(LA, "onResume", _OnResume(self))
        except Exception:
            self._log("resume hook failed: " + traceback.format_exc())

    def on_plugin_unload(self):
        self.enabled = False
        self.apply()
        _PLUGIN[0] = None

    # ----------------------------------------------------------- настройки
    def _load(self):
        self.enabled = bool(self.get_setting("enabled", True))
        self.nav = bool(self.get_setting("nav", True))
        self.springs = bool(self.get_setting("springs", True))
        self.scroll = bool(self.get_setting("scroll", True))
        v = self.get_setting("speed", None)
        if v is None:
            i = self.get_setting("speed_i", None)
            try:
                v = SELECTOR_VALUES[int(i)] if i is not None else 1.0
            except Exception:
                v = 1.0
        try:
            self.speed = snap(float(v))
        except Exception:
            self.speed = 1.0

    def eff_speed(self):
        return self.speed if self.enabled else 1.0

    def _log(self, msg):
        try:
            self.logger.error(msg)
        except Exception:
            try:
                self.log(msg)
            except Exception:
                pass

    def _on_change(self, *args):
        self.apply()

    def set_speed(self, v):
        """Вызывается ползунком: сохраняем и применяем."""
        self.speed = snap(v)
        self.set_setting("speed", float(self.speed))
        self.apply()

    def _reset(self, *args):
        self.set_setting("speed", 1.0, reload_settings=True)
        self.apply()

    def create_settings(self):
        if Header is None:
            return []
        self._load()
        items = [Header(text="Скорость")]
        if Custom is not None and _SLIDER_FACTORY is not None:
            items.append(Custom(factory=_SLIDER_FACTORY.instance.java))
        else:  # запасной вариант, если у приложения нет кастомных строк
            idx = min(range(len(SELECTOR_VALUES)),
                      key=lambda i: abs(SELECTOR_VALUES[i] - self.speed))
            items.append(Selector(key="speed_i", text="Скорость анимаций", default=idx,
                                  items=[fmt(v) for v in SELECTOR_VALUES],
                                  on_change=self._on_change))
        items += [
            Header(text="Что ускорять"),
            Switch(key="nav", text="Переходы между экранами", default=True,
                   on_change=self._on_change),
            Switch(key="springs", text="Пружины и жесты", default=True,
                   subtext="Шторки, всплывающие окна", on_change=self._on_change),
            Switch(key="scroll", text="Автопрокрутка", default=True,
                   subtext="Переход к сообщению", on_change=self._on_change),
            Divider(),
            Text(text="Сбросить до 1x", accent=True, on_click=self._reset),
        ]
        return items

    # ----------------------------------------- масштаб всех анимаций
    def _mark(self, name, ok, info=""):
        self.status[name] = (bool(ok), info)

    def _va_class(self):
        return jclass("java.lang.Class").forName("android.animation.ValueAnimator")

    def _set_scale(self, scale):
        Float = jclass("java.lang.Float")
        m = self._va_class().getMethod("setDurationScale", Float.TYPE)
        m.invoke(None, Float.valueOf(jfloat(scale)))

    def _get_scale(self):
        try:
            return float(self._va_class().getMethod("getDurationScale").invoke(None).floatValue())
        except Exception:
            return None

    def _exempt_hidden_api(self):
        """Обход ограничений на скрытое API (мета-рефлексия) — запасной путь."""
        try:
            Cls = jclass("java.lang.Class")
            Obj = jclass("java.lang.Object")
            Str = jclass("java.lang.String")
            cc = Cls.forName("java.lang.Class")
            gdm = cc.getDeclaredMethod("getDeclaredMethod", Cls.forName("java.lang.String"),
                                       Cls.forName("[Ljava.lang.Class;"))
            vm = Cls.forName("dalvik.system.VMRuntime")
            get_rt = gdm.invoke(vm, "getRuntime", jarray(Cls)([]))
            set_ex = gdm.invoke(vm, "setHiddenApiExemptions",
                                jarray(Cls)([Cls.forName("[Ljava.lang.String;")]))
            rt = get_rt.invoke(None)
            set_ex.invoke(rt, jarray(Obj)([jarray(Str)(["L"])]))
        except Exception:
            self._log("hidden api exemption failed: " + traceback.format_exc())

    def _apply_scale(self):
        """ValueAnimator.setDurationScale (как в Inugram) + проверка + запасной путь."""
        scale = 1.0 / self.eff_speed()
        ok = False
        for attempt in range(2):
            try:
                self._set_scale(scale)
                cur = self._get_scale()
                ok = cur is None or abs(cur - scale) <= max(1e-6, scale * 1e-3)
                if ok:
                    break
            except Exception:
                if attempt == 0 and jarray is not None:
                    self._exempt_hidden_api()
        self._scale_ok = ok
        self.manual_active = (not ok) and self.eff_speed() != 1.0
        if not ok and not self._manual_hooked:
            self._enable_manual()
        cur = self._get_scale()
        self._mark("Масштаб ValueAnimator", ok,
                   ("масштаб %s" % ("%.4g" % cur if cur is not None else "?")) if ok
                   else "недоступен — включён ручной режим")
        return ok

    def _enable_manual(self):
        try:
            self.hook_all_methods(find_class("android.animation.ValueAnimator"),
                                  "start", _VAStart(self))
            self._manual_hooked = True
        except Exception:
            self._log("manual ValueAnimator hook failed: " + traceback.format_exc())

    def apply(self):
        self._load()
        self._apply_scale()
        self._rescale_af()

    def _rescale_af(self):
        """Уже созданные AnimatedFloat/AnimatedColor тоже подхватывают новую скорость."""
        s = self.eff_speed()
        for C, f, reg in self._af:
            try:
                keys = jclass("java.util.ArrayList")(reg.keySet())
                for i in range(int(keys.size())):
                    obj = keys.get(i)
                    orig = reg.get(obj)
                    if orig is None:
                        continue
                    f.setLong(obj, jlong(max(1, int(int(orig) / s))))
            except Exception:
                self._log("rescale error: " + traceback.format_exc())

    # ------------------------------------------- переходы между экранами
    def nav_attach(self, layout):
        """После startLayoutAnimation вешаем хук на run() анимационного Runnable."""
        self._nav_layout = layout
        if self._nav_rfield is None:
            for f in self._AL.getDeclaredFields():
                if str(f.getName()) == "animationRunnable":
                    f.setAccessible(True)
                    self._nav_rfield = f
                    break
            if self._nav_rfield is None:
                self._log("animationRunnable field not found")
                return
        r = self._nav_rfield.get(layout)
        if r is None:
            return
        rc = r.getClass()
        cn = str(rc.getName())
        if cn in self._nav_hooked:
            return
        self._nav_hooked.add(cn)
        self.hook_method(rc.getDeclaredMethod("run"), _NavRun(self))
        self._mark("Переходы между экранами", True, "подключены")
        al_name = str(self._AL.getName())
        for g in rc.getDeclaredFields():
            if str(g.getType().getName()) == al_name:
                g.setAccessible(True)
                self._nav_outer[cn] = g
                break

    def _nav_layout_of(self, runnable):
        g = self._nav_outer.get(str(runnable.getClass().getName()))
        if g is not None:
            try:
                return g.get(runnable)
            except Exception:
                pass
        return self._nav_layout

    def nav_before(self, param):
        s = self.eff_speed()
        if not self.nav or s == 1.0:
            return
        layout = self._nav_layout_of(param.thisObject)
        if layout is None:
            return
        self._nav_p0 = float(self._f_prog.getFloat(layout))
        if s < 1.0:
            # медленнее: уменьшаем dt кадра
            now = int(self.System.nanoTime()) // 1000000
            dt = now - int(self._f_last.getLong(layout))
            if 0 < dt < 100:
                self._f_last.setLong(layout, jlong(now - int(dt * s)))

    def nav_after(self, param):
        s = self.eff_speed()
        if not self.nav or s <= 1.0:
            return
        layout = self._nav_layout_of(param.thisObject)
        if layout is None:
            return
        p1 = float(self._f_prog.getFloat(layout))
        p0 = self._nav_p0
        if p0 < p1 < 1.0:
            self._f_prog.setFloat(layout, jfloat(min(1.0, p0 + (p1 - p0) * s)))
