except Exception:  # pragma: no cover
    def get_private_field(obj, name):
        c = obj.getClass()
        while c is not None:
            try:
                f = c.getDeclaredField(name)
                f.setAccessible(True)
                return f.get(obj)
            except Exception:
                c = c.getSuperclass()
        raise AttributeError(name)


# ───────────────────────── Логи / тосты ─────────────────────────

def log(msg):
    try:
        _log("[MusicStats] " + str(msg))
    except Exception:
        pass


def toast(msg):
    def _t():
        try:
            ctx = jclass("org.telegram.messenger.ApplicationLoader").applicationContext
            jclass("android.widget.Toast").makeText(ctx, str(msg)[:300], 1).show()
        except Exception as e:
            log("toast error: %r" % (e,))

    try:
        run_on_ui_thread(_t)
    except Exception as e:
        log("toast error: %r" % (e,))


# ───────────────────────── Java-прокси ─────────────────────────

View = jclass("android.view.View")
DialogOnClick = jclass("android.content.DialogInterface$OnClickListener")
DialogOnDismiss = jclass("android.content.DialogInterface$OnDismissListener")
Runnable = jclass("java.lang.Runnable")
AnimUpdate = jclass("android.animation.ValueAnimator$AnimatorUpdateListener")
OnTouch = jclass("android.view.View$OnTouchListener")
OnInsets = jclass("android.view.View$OnApplyWindowInsetsListener")


class _Click(dynamic_proxy(View.OnClickListener)):
    def __init__(self, fn):
        super().__init__()
        self.fn = fn

    def onClick(self, v):
        try:
            self.fn()
        except Exception as e:
            log("click error: %r" % (e,))


class _DialogClick(dynamic_proxy(DialogOnClick)):
    def __init__(self, fn):
        super().__init__()
        self.fn = fn

    def onClick(self, dialog, which):
        try:
            self.fn()
        except Exception as e:
            log("dialog click error: %r" % (e,))


class _Dismiss(dynamic_proxy(DialogOnDismiss)):
    def __init__(self, fn):
        super().__init__()
        self.fn = fn

    def onDismiss(self, dialog):
        try:
            self.fn()
        except Exception as e:
            log("dismiss error: %r" % (e,))


class _Run(dynamic_proxy(Runnable)):
    def __init__(self, fn):
        super().__init__()
        self.fn = fn

    def run(self):
        try:
            self.fn()
        except Exception as e:
            log("run error: %r" % (e,))


class _AnimListener(dynamic_proxy(AnimUpdate)):
    def __init__(self, fn):
        super().__init__()
        self.fn = fn

    def onAnimationUpdate(self, anim):
        try:
            self.fn(float(anim.getAnimatedValue()))
        except Exception as e:
            log("anim error: %r" % (e,))


class _Touch(dynamic_proxy(OnTouch)):
    def __init__(self, fn):
        super().__init__()
        self.fn = fn

    def onTouch(self, v, event):
        try:
            return bool(self.fn(v, event))
        except Exception as e:
            log("touch error: %r" % (e,))
            return False


class _Insets(dynamic_proxy(OnInsets)):
    def __init__(self, fn):
        super().__init__()
        self.fn = fn

    def onApplyWindowInsets(self, v, insets):
        try:
            self.fn(int(insets.getSystemWindowInsetTop()), int(insets.getSystemWindowInsetBottom()))
        except Exception as e:
            log("insets error: %r" % (e,))
        return insets


