             "сентябре", "октябре", "ноябре", "декабре"]
WDAYS = ["Пн", "Вт", "Ср", "Чт", "Пт", "Сб", "Вс"]
WDAYS_PLURAL = ["Понедельники", "Вторники", "Среды", "Четверги", "Пятницы", "Субботы", "Воскресенья"]
WDAYS_ON = ["по понедельникам", "по вторникам", "по средам", "по четвергам", "по пятницам",
            "по субботам", "по воскресеньям"]


def fmt_dur(s):
    s = int(round(s))
    h, rem = divmod(s, 3600)
    m, sec = divmod(rem, 60)
    if h:
        return "%dч %02dм" % (h, m)
    if m:
        return "%dм" % m
    return "%dс" % sec


def fmt_hms(s):
    s = int(s)
    h, rem = divmod(s, 3600)
    m, sec = divmod(rem, 60)
    if h:
        return "%dч %02dм %02dс" % (h, m, sec)
    if m:
        return "%dм %02dс" % (m, sec)
    return "%dс" % sec


def fmt_smart(s):
    """< 1 часа -> минуты, >= 24 часов -> дни, иначе часы и минуты."""
    if s >= 86400:
        return ("%.1f" % (s / 86400.0)).replace(".", ",") + " дн"
    if s >= 3600:
        h, m = divmod(int(s) // 60, 60)
        return "%dч %02dм" % (h, m)
    if s < 30:
        return "<1 мин"
    return "%d мин" % min(59, max(1, int(round(s / 60.0))))


def fmt_short(s):
    if s >= 3600:
        return "%.1fч" % (s / 3600.0)
    if s >= 60:
        return "%dм" % int(s // 60)
    return "%dс" % int(s)


def fmt_date(ts):
    return time.strftime("%d.%m.%Y", time.localtime(ts))


def day_label(ts):
    lt = time.localtime(ts)
    return "%d %s" % (lt.tm_mday, MONTHS[lt.tm_mon - 1])


def with_alpha(c, a):
    v = ((int(a) & 0xFF) << 24) | (int(c) & 0xFFFFFF)
    return v - (1 << 32) if v >= (1 << 31) else v


def hex_color(h):
    v = int(h.lstrip("#"), 16)
    if len(h.lstrip("#")) <= 6:
        v |= 0xFF000000
    return v - (1 << 32) if v >= (1 << 31) else v


def mix(c1, c2, t):
    a, b = int(c1) & 0xFFFFFF, int(c2) & 0xFFFFFF
    out = 0xFF000000
    for sh in (16, 8, 0):
        x, y = (a >> sh) & 255, (b >> sh) & 255
        out |= int(x + (y - x) * t) << sh
    return out - (1 << 32) if out >= (1 << 31) else out


def luminance(c):
    c = int(c) & 0xFFFFFFFF
    r, g, b = (c >> 16) & 255, (c >> 8) & 255, c & 255
    return (0.299 * r + 0.587 * g + 0.114 * b) / 255.0


def ease_out(x):
    x = max(0.0, min(1.0, x))
    return 1.0 - (1.0 - x) ** 3


def theme_color(name, fallback_hex):
    try:
        Theme = jclass("org.telegram.ui.ActionBar.Theme")
        key = getattr(Theme, name)
        return int(Theme.getColor(key))
    except Exception as e:
        log("theme color %s failed: %r" % (name, e))
        return hex_color(fallback_hex)


def get_palette():
    pal = {
        "page": theme_color("key_windowBackgroundGray", "#F0F0F0"),
        "card": theme_color("key_windowBackgroundWhite", "#FFFFFF"),
        "text": theme_color("key_windowBackgroundWhiteBlackText", "#000000"),
        "gray": theme_color("key_windowBackgroundWhiteGrayText", "#8A8D93"),
        "accent": theme_color("key_windowBackgroundWhiteBlueText", "#2A9EF1"),
        "bar": theme_color("key_actionBarDefault", "#527DA3"),
        "bar_text": theme_color("key_actionBarDefaultTitle", "#FFFFFF"),
        "divider": theme_color("key_divider", "#1F000000"),
        "white": hex_color("#FFFFFF"),
    }
    # в чёрных темах фон карточек совпадает со страницей: слегка подсвечиваем карточки
    if abs(luminance(pal["card"]) - luminance(pal["page"])) < 0.03:
        target = hex_color("#FFFFFF") if luminance(pal["page"]) < 0.5 else hex_color("#000000")
        pal["card"] = mix(pal["page"], target, 0.08)
    return pal


def db_path():
    try:
        ctx = jclass("org.telegram.messenger.ApplicationLoader").applicationContext
        base = str(ctx.getFilesDir().getAbsolutePath())
    except Exception:
        base = os.path.expanduser("~")
    return os.path.join(base, "music_stats.db")


def jlist(x):
    """Превращает Java List / массив в обычный Python-список (ArrayList здесь не итерируется)."""
    if x is None:
        return []
    try:
        n = int(x.size())
        return [x.get(i) for i in range(n)]
    except Exception:
        pass
    try:
        return list(x)
    except Exception:
        pass
    try:
        return [x[i] for i in range(len(x))]
    except Exception:
        return []


def _find_super(obj, name):
    c = obj.getClass()
    while c is not None:
        if str(c.getName()) == name:
            return c
        c = c.getSuperclass()
    return None


def file_loader_call(method, params, args, account=None):
    """FileLoader.<method>(...) для TL-объектов Telegram.
    В этой версии getPathToAttach/getPathToMessage НЕстатические (вызов на классе даёт
    'cannot be applied', а invoke(null) даёт 'null receiver'), поэтому вызываем на
    экземпляре FileLoader.getInstance(account): прямой вызов -> cast -> рефлексия."""
    FL = jclass("org.telegram.messenger.FileLoader")
    if account is None:
        try:
            account = int(jclass("org.telegram.messenger.UserConfig").selectedAccount)
        except Exception:
            account = 0
    inst = FL.getInstance(int(account))
    try:
        return getattr(inst, method)(*args)
    except TypeError:
        pass
    try:
        from java import cast
        cargs = [a if t == "boolean" else cast(jclass(t), a) for t, a in zip(params, args)]
        return getattr(inst, method)(*cargs)
    except Exception:
        pass
    ClassCls = jclass("java.lang.Class")
    ObjCls = jclass("java.lang.Object")
    ptypes = []
    for t, a in zip(params, args):
        if t == "boolean":
            ptypes.append(jclass("java.lang.Boolean").TYPE)
        else:
            c = _find_super(a, t)
            if c is None:
                raise TypeError("%s не является %s" % (a.getClass().getName(), t))
            ptypes.append(c)
    m = FL.getClass().getDeclaredMethod(method, jarray(ClassCls)(ptypes))
    m.setAccessible(True)
    return m.invoke(inst, jarray(ObjCls)(list(args)))


def track_from_mo(mo):
    title = str(mo.getMusicTitle() or "").strip() or "Без названия"
    artist = str(mo.getMusicAuthor() or "").strip() or "Неизвестный исполнитель"
    try:
        dur = int(mo.getDuration())
    except Exception:
        dur = 0
    return artist, title, dur


# ───────────────────────── Обложки ─────────────────────────

def _bitmap_classes():
    return (jclass("android.graphics.Bitmap"), jclass("android.graphics.Bitmap$Config"),
            jclass("android.graphics.Canvas"), jclass("android.graphics.Paint"),
            jclass("android.graphics.RectF"))


def square_scaled(src, size):
    Bitmap = jclass("android.graphics.Bitmap")
    w, h = src.getWidth(), src.getHeight()
    side = min(w, h)
    sq = Bitmap.createBitmap(src, (w - side) // 2, (h - side) // 2, side, side)
    return Bitmap.createScaledBitmap(sq, size, size, True)


def round_bitmap(src, size, radius):
    Bitmap, Config, Canvas, Paint, RectF = _bitmap_classes()
    BitmapShader = jclass("android.graphics.BitmapShader")
    TileMode = jclass("android.graphics.Shader$TileMode")
    scaled = square_scaled(src, size)
    out = Bitmap.createBitmap(size, size, Config.ARGB_8888)
    c = Canvas(out)
    p = Paint()
    p.setAntiAlias(True)
    p.setShader(BitmapShader(scaled, TileMode.CLAMP, TileMode.CLAMP))
    c.drawRoundRect(RectF(0.0, 0.0, float(size), float(size)), float(radius), float(radius), p)
    return out


def placeholder_bitmap(size, radius, pal):
    Bitmap, Config, Canvas, Paint, RectF = _bitmap_classes()
    Align = jclass("android.graphics.Paint$Align")
    out = Bitmap.createBitmap(size, size, Config.ARGB_8888)
    c = Canvas(out)
    p = Paint()
    p.setAntiAlias(True)
    p.setColor(jint(with_alpha(pal["accent"], 60)))
    c.drawRoundRect(RectF(0.0, 0.0, float(size), float(size)), float(radius), float(radius), p)
    p.setColor(jint(pal["accent"]))
    p.setTextAlign(Align.CENTER)
    p.setTextSize(size * 0.5)
    c.drawText("♪", size / 2.0, size * 0.66, p)
    return out


def save_cover(bmp, path):
    scaled = square_scaled(bmp, 384)
    fos = jclass("java.io.FileOutputStream")(path)
    try:
        scaled.compress(jclass("android.graphics.Bitmap$CompressFormat").JPEG, 88, fos)
        fos.flush()
    finally:
        fos.close()


# ───────────────────────── Тексты песен (LRCLIB) ─────────────────────────

LRCLIB = "https://lrclib.net/api"
_LRC_TS = re.compile(r"\[(\d{1,3}):(\d{2}(?:[.:]\d{1,3})?)\]")


def _http_json(url):
    req = urllib.request.Request(
        url, headers={"User-Agent": "MusicStatsPlugin/2.3 (exteraGram plugin by PA3MA3AH)"}
    )
    with urllib.request.urlopen(req, timeout=10) as r:
        return json.loads(r.read().decode("utf-8"))


def parse_lrc(text):
    out = []
    for raw in text.splitlines():
        stamps = _LRC_TS.findall(raw)
        if not stamps:
            continue
        line = _LRC_TS.sub("", raw).strip() or "♪"
        for mm, ss in stamps:
            out.append((int(mm) * 60 + float(ss.replace(":", ".")), line))
    out.sort(key=lambda x: x[0])
    return out


def _pick_lyrics(results, duration):
    results = [r for r in (results or []) if r.get("syncedLyrics") or r.get("plainLyrics")]
    if not results:
        return None

    def score(r):
        synced = 0 if r.get("syncedLyrics") else 1
        dd = abs((r.get("duration") or 0) - duration) if duration else 0
        return (synced, dd)

    return min(results, key=score)


def fetch_lyrics(artist, title, duration):
    unknown = artist.startswith("Неизвестн")
    attempts = []
    params = {"track_name": title}
    if not unknown:
        params["artist_name"] = artist
    attempts.append(params)
    attempts.append({"q": title if unknown else "%s %s" % (artist, title)})

    item = None
    for prm in attempts:
        try:
            res = _http_json(LRCLIB + "/search?" + urllib.parse.urlencode(prm))
        except urllib.error.HTTPError as e:
            if e.code == 404:
                continue
            raise
        item = _pick_lyrics(res, duration)
        if item:
            break
    if not item:
        return {"status": "none", "lines": [], "times": [], "plain": None}

    lines = parse_lrc(item["syncedLyrics"]) if item.get("syncedLyrics") else []
    plain = item.get("plainLyrics") or None
    if not lines and not plain:
        return {"status": "none", "lines": [], "times": [], "plain": None}
    return {"status": "ok", "lines": lines, "times": [t for t, _ in lines], "plain": plain}


# ───────────────────────── Хранилище ─────────────────────────

class Store:
    def __init__(self, path):
        self.lock = threading.Lock()
        self.pending = {}
        self.added = 0.0  # секунд добавлено с момента запуска (для live-обновления)
        self.added_track = {}   # (artist, title) -> секунд с момента запуска
        self.added_artist = {}  # artist -> секунд с момента запуска
        self.cover_dir = os.path.join(os.path.dirname(path), "music_stats_covers")
        try:
            os.makedirs(self.cover_dir, exist_ok=True)
        except Exception as e:
            log("cover dir error: %r" % (e,))
        self.db = sqlite3.connect(path, check_same_thread=False)
        self.db.execute(
            "CREATE TABLE IF NOT EXISTS listens("
            "ts INTEGER NOT NULL, artist TEXT NOT NULL, title TEXT NOT NULL, "
            "secs REAL NOT NULL, PRIMARY KEY(ts, artist, title))"
        )
        self.db.execute("CREATE INDEX IF NOT EXISTS idx_listens_ts ON listens(ts)")
        self.db.execute(
            "CREATE TABLE IF NOT EXISTS tracks("
            "artist TEXT NOT NULL, title TEXT NOT NULL, duration INTEGER NOT NULL, "
            "PRIMARY KEY(artist, title))"
        )
        self.db.commit()

    def cover_path(self, artist, title):
        h = hashlib.sha1(("%s|%s" % (artist, title)).encode("utf-8")).hexdigest()
        return os.path.join(self.cover_dir, h + ".jpg")

    def add(self, ts, artist, title, secs):
        with self.lock:
            key = (ts, artist, title)
            self.pending[key] = self.pending.get(key, 0.0) + secs
            self.added += secs
            tk = (artist, title)
            self.added_track[tk] = self.added_track.get(tk, 0.0) + secs
            self.added_artist[artist] = self.added_artist.get(artist, 0.0) + secs

    def set_duration(self, artist, title, dur):
        with self.lock:
            self.db.execute(
                "INSERT INTO tracks(artist, title, duration) VALUES(?,?,?) "
                "ON CONFLICT(artist, title) DO UPDATE SET duration = excluded.duration",
                (artist, title, int(dur)),
            )
            self.db.commit()

    def flush(self):
        with self.lock:
            self._flush_locked()

    def _flush_locked(self):
        if not self.pending:
            return
        items = list(self.pending.items())
        self.pending.clear()
        try:
            self.db.executemany(
                "INSERT INTO listens(ts, artist, title, secs) VALUES(?,?,?,?) "
                "ON CONFLICT(ts, artist, title) DO UPDATE SET secs = secs + excluded.secs",
                [(k[0], k[1], k[2], v) for k, v in items],
            )
            self.db.commit()
        except Exception as e:
            log("flush error: %r" % (e,))
            for k, v in items:
                self.pending[k] = self.pending.get(k, 0.0) + v

    def reset(self):
        with self.lock:
            self.pending.clear()
            self.db.execute("DELETE FROM listens")
            self.db.commit()

    def snapshot(self):
        now = int(time.time())
        with self.lock:
            self._flush_locked()
            q = self.db.execute
            lt = time.localtime(now)
            midnight = int(time.mktime((lt.tm_year, lt.tm_mon, lt.tm_mday, 0, 0, 0, 0, 0, -1)))

            def total_since(ts):
                return q("SELECT COALESCE(SUM(secs), 0) FROM listens WHERE ts >= ?", (ts,)).fetchone()[0]

            return {
                "now": now,
                "added_at": self.added,
                "total": q("SELECT COALESCE(SUM(secs), 0) FROM listens").fetchone()[0],
                "today": total_since(midnight),
                "week": total_since(now - 7 * 86400),
                "month": total_since(now - 30 * 86400),
                "tracks": q(
                    "SELECT COUNT(*) FROM (SELECT 1 FROM listens GROUP BY artist, title)"
                ).fetchone()[0],
                "hourly": q(
                    "SELECT (ts / 3600) * 3600 AS h, SUM(secs) FROM listens GROUP BY h"
                ).fetchall(),
                "top_tracks": q(
                    "SELECT artist, title, SUM(secs) AS s FROM listens "
                    "GROUP BY artist, title ORDER BY s DESC LIMIT 8"
                ).fetchall(),
                "top_artists": q(
                    "SELECT artist, SUM(secs) AS s FROM listens "
                    "GROUP BY artist ORDER BY s DESC LIMIT 8"
                ).fetchall(),
                "last": q("SELECT artist, title FROM listens ORDER BY ts DESC LIMIT 1").fetchone(),
            }

    # ----- детализация по столбцу графика -----
    def tracks_for_bucket(self, bucket):
        with self.lock:
            self._flush_locked()
            q = self.db.execute
            if bucket["kind"] == "range":
                return q(
                    "SELECT artist, title, SUM(secs) AS s FROM listens "
                    "WHERE ts >= ? AND ts < ? GROUP BY artist, title ORDER BY s DESC",
                    (bucket["t0"], bucket["t1"]),
                ).fetchall()
            rows = q(
                "SELECT (ts / 3600) * 3600 AS h, artist, title, SUM(secs) FROM listens "
                "GROUP BY h, artist, title"
            ).fetchall()
        agg = {}
        for h, artist, title, secs in rows:
            if time.localtime(h).tm_wday == bucket["wday"]:
                agg[(artist, title)] = agg.get((artist, title), 0.0) + secs
        out = [(a, t, s) for (a, t), s in agg.items()]
        out.sort(key=lambda r: -r[2])
        return out

    def artist_snapshot(self, artist):
        with self.lock:
            self._flush_locked()
            rows = self.db.execute(
                "SELECT artist, title, SUM(secs) AS s FROM listens WHERE artist = ? "
                "GROUP BY title ORDER BY s DESC", (artist,)
            ).fetchall()
            return rows, self.added_artist.get(artist, 0.0)

    def tracks_for_artist(self, artist):
        with self.lock:
            self._flush_locked()
            return self.db.execute(
                "SELECT artist, title, SUM(secs) AS s FROM listens WHERE artist = ? "
                "GROUP BY title ORDER BY s DESC", (artist,)
            ).fetchall()

    # ----- статистика одного трека -----
    def track_stats(self, artist, title):
        with self.lock:
            self._flush_locked()
            q = self.db.execute
            row = q(
                "SELECT COALESCE(SUM(secs), 0), MIN(ts), MAX(ts) FROM listens "
                "WHERE artist = ? AND title = ?", (artist, title)
            ).fetchone()
            hourly = q(
                "SELECT (ts / 3600) * 3600 AS h, SUM(secs) FROM listens "
                "WHERE artist = ? AND title = ? GROUP BY h", (artist, title)
            ).fetchall()
            drow = q(
                "SELECT duration FROM tracks WHERE artist = ? AND title = ?", (artist, title)
            ).fetchone()
            added_at = self.added_track.get((artist, title), 0.0)
        return {
            "total": row[0], "first": row[1], "last": row[2],
            "hourly": hourly, "duration": drow[0] if drow else 0, "added_at": added_at,
        }


# ───────────────────────── Данные для графиков ─────────────────────────

def build_series(snap, mode):
    """-> (заголовок, значения, подписи, описания столбцов)"""
    now = time.time()
    hourly = snap["hourly"]

    if mode == "hour":
        base = int(now // 3600 * 3600) - 23 * 3600
        d = dict(hourly)
        vals, labels, buckets = [], [], []
        for i in range(24):
            t0 = base + i * 3600
            hh = time.localtime(t0).tm_hour
            vals.append(d.get(t0, 0.0))
            labels.append("%02d" % hh if i % 3 == 0 else "")
            buckets.append({
                "kind": "range", "t0": t0, "t1": t0 + 3600,
                "label": "%s, %02d:00–%02d:00" % (day_label(t0), hh, (hh + 1) % 24),
            })
        return "Последние 24 часа · по часам", vals, labels, buckets

    if mode == "wday":
        sums = [0.0] * 7
        for h, s in hourly:
            sums[time.localtime(h).tm_wday] += s
        buckets = [{"kind": "wday", "wday": i, "label": WDAYS_PLURAL[i] + " · все недели"} for i in range(7)]
        return "По дням недели · всё время", sums, list(WDAYS), buckets

    lt = time.localtime(now)
    y, m = lt.tm_year, lt.tm_mon
    keys = []
    for _ in range(12):
        keys.append((y, m))
        m -= 1
        if m == 0:
            m = 12
            y -= 1
    keys.reverse()
    sums = {k: 0.0 for k in keys}
    for h, s in hourly:
        t = time.localtime(h)
        k = (t.tm_year, t.tm_mon)
        if k in sums:
            sums[k] += s
    vals = [sums[k] for k in keys]
    labels = [MONTHS[k[1] - 1] for k in keys]
    buckets = []
    for (yy, mm) in keys:
        t0 = int(time.mktime((yy, mm, 1, 0, 0, 0, 0, 0, -1)))
        ny, nm = (yy + 1, 1) if mm == 12 else (yy, mm + 1)
        t1 = int(time.mktime((ny, nm, 1, 0, 0, 0, 0, 0, -1)))
        buckets.append({"kind": "range", "t0": t0, "t1": t1, "label": "%s %d" % (MONTHS_FULL[mm - 1], yy)})
    return "Последние 12 месяцев", vals, labels, buckets


def build_segments(rows, with_artist):
    """Делит столбец на части: топ-3 трека + «другие» (если треков больше 4)."""
    total = sum(r[2] for r in rows) or 1.0
    top = rows if len(rows) <= 4 else rows[:3]
    segs = []
    for k, (a, t, secs) in enumerate(top):
        parts = [a] if with_artist else []
        parts += [fmt_smart(secs), "%d%%" % round(secs * 100.0 / total)]
        segs.append({"name": "%d. %s" % (k + 1, t), "sub": " · ".join(parts),
                     "share": secs / total, "first": k == 0})
    rest = rows[len(top):]
    if rest:
        rs = sum(r[2] for r in rest)
        segs.append({"name": "Другие треки (%d)" % len(rest),
                     "sub": "%s · %d%%" % (fmt_smart(rs), round(rs * 100.0 / total)),
                     "share": rs / total, "first": False})
    return segs


# ───────────────────────── Рисование графика ─────────────────────────

class ChartRenderer:
    """Рисует график в один переиспользуемый Bitmap (рост столбцов + выделение)."""

    def __init__(self, w, h, density):
        Bitmap, Config, Canvas, Paint, RectF = _bitmap_classes()
        self.Align = jclass("android.graphics.Paint$Align")
        self.LinearGradient = jclass("android.graphics.LinearGradient")
        self.TileMode = jclass("android.graphics.Shader$TileMode")
        self.w, self.h, self.d = int(w), int(h), float(density)
        self.bmp = Bitmap.createBitmap(self.w, self.h, Config.ARGB_8888)
        self.c = Canvas(self.bmp)
        self.p = Paint()
        self.p.setAntiAlias(True)
        self.rect = RectF()

    def bounds(self):
        d = self.d
        return 42.0 * d, self.w - 6.0 * d, 26.0 * d, self.h - 24.0 * d

    def hit(self, x, n):
        left, right, _t, _b = self.bounds()
        if n <= 0 or x < left or x > right:
            return None
        return min(n - 1, int((x - left) / ((right - left) / n)))

    def draw(self, vals, labels, pal, progress, selected=-1):
        c, p, d, Align = self.c, self.p, self.d, self.Align
        w, h = float(self.w), float(self.h)
        self.bmp.eraseColor(jint(0))
        left, right, top, bottom = self.bounds()
        accent, gray = pal["accent"], pal["gray"]
        mx = max(vals) if vals else 0

        if mx <= 0:
            p.setShader(None)
            p.setColor(jint(gray))
            p.setTextAlign(Align.CENTER)
            p.setTextSize(15.0 * d)
            c.drawText("Пока пусто", w / 2.0, h / 2.0, p)
            p.setTextSize(12.0 * d)
            c.drawText("Включи музыку в Telegram", w / 2.0, h / 2.0 + 22.0 * d, p)
            return

        p.setShader(None)
        p.setTextSize(10.5 * d)
        for i in range(4):
            frac = i / 3.0
            y = bottom - frac * (bottom - top)
            p.setColor(jint(with_alpha(gray, 50 if i else 110)))
            p.setStrokeWidth(max(1.0, 0.8 * d))
            c.drawLine(left, y, right, y, p)
            if i:
                p.setColor(jint(gray))
                p.setTextAlign(Align.RIGHT)
                c.drawText(fmt_short(mx * frac), left - 6.0 * d, y + 4.0 * d, p)

        n = len(vals)
        slot = (right - left) / n
        bw = slot * (0.62 if n <= 12 else 0.7)
        radius = min(bw / 2.0, 6.0 * d)

        if selected >= 0:  # подложка выбранного столбца
            self.rect.set(left + selected * slot + 1.0 * d, top - 8.0 * d,
                          left + (selected + 1) * slot - 1.0 * d, bottom + 2.0 * d)
            p.setShader(None)
            p.setColor(jint(with_alpha(accent, 38)))
            c.drawRoundRect(self.rect, 8.0 * d, 8.0 * d, p)

        shader = self.LinearGradient(
            0.0, top, 0.0, bottom,
            jint(accent), jint(with_alpha(accent, 110)),
            self.TileMode.CLAMP,
        )
        stagger = 0.55
        max_i = max(range(n), key=lambda k: vals[k])

        for i, v in enumerate(vals):
            if v <= 0:
                continue
            local = progress * (1.0 + stagger) - (i / float(n)) * stagger
            e = ease_out(local)
            full = (v / mx) * (bottom - top)
            hh = max(full, 2.5 * d) * e
            if hh <= 0.5:
                continue
            x0 = left + i * slot + (slot - bw) / 2.0
            self.rect.set(x0, bottom - hh, x0 + bw, bottom)
            p.setShader(shader)
            p.setColor(jint(accent))
            p.setAlpha(120 if (selected >= 0 and i != selected) else 255)
            c.drawRoundRect(self.rect, radius, radius, p)
            p.setShader(None)

            if (n <= 12 or i == max_i or i == selected) and e > 0.6:
                p.setTextAlign(Align.CENTER)
                p.setTextSize(10.5 * d)
                alpha = int(255 * min(1.0, (e - 0.6) / 0.4))
                p.setColor(jint(with_alpha(accent if i in (max_i, selected) else pal["text"], alpha)))
                c.drawText(fmt_short(v), x0 + bw / 2.0, bottom - hh - 6.0 * d, p)

        p.setShader(None)
        p.setTextAlign(Align.CENTER)
        p.setTextSize(10.5 * d)
        for i, lab in enumerate(labels):
            if lab:
                p.setColor(jint(accent if i == selected else gray))
                c.drawText(lab, left + i * slot + slot / 2.0, bottom + 17.0 * d, p)


# ───────────────────────── UI-кит ─────────────────────────

class UIKit:
    def __init__(self, act):
        self.act = act
        self.d = float(act.getResources().getDisplayMetrics().density)
        self.LinearLayout = jclass("android.widget.LinearLayout")
        self.TextView = jclass("android.widget.TextView")
        self.GradientDrawable = jclass("android.graphics.drawable.GradientDrawable")
        self.TruncateAt = jclass("android.text.TextUtils$TruncateAt")

    def dp(self, x):
        return int(x * self.d)

    def lp(self, w, h, weight=None, l=0, t=0, r=0, b=0):
        LP = self.LinearLayout.LayoutParams
        p = LP(w, h) if weight is None else LP(w, h, float(weight))
        p.setMargins(self.dp(l), self.dp(t), self.dp(r), self.dp(b))
        return p

    def text(self, txt, size, color, bold=False, single=False):
        tv = self.TextView(self.act)
        tv.setText(txt)
        tv.setTextSize(float(size))
        tv.setTextColor(jint(color))
        if bold:
            tv.setTypeface(tv.getTypeface(), 1)
        if single:
            tv.setMaxLines(1)
            tv.setEllipsize(self.TruncateAt.END)
        return tv

    def vbox(self):
        b = self.LinearLayout(self.act)
        b.setOrientation(self.LinearLayout.VERTICAL)
        return b

    def hbox(self):
        b = self.LinearLayout(self.act)
        b.setOrientation(self.LinearLayout.HORIZONTAL)
        return b

    def rounded(self, color, radius):
        gd = self.GradientDrawable()
        gd.setColor(jint(color))
        gd.setCornerRadius(float(self.dp(radius)))
        return gd


def make_fullscreen_dialog(act, pal):
    Dialog = jclass("android.app.Dialog")
    RStyle = jclass("android.R$style")
    ColorDrawable = jclass("android.graphics.drawable.ColorDrawable")
    dlg = Dialog(act, RStyle.Theme_DeviceDefault_NoActionBar)
    try:
        win = dlg.getWindow()
        win.setLayout(-1, -1)
        win.setBackgroundDrawable(ColorDrawable(jint(pal["page"])))
        win.setStatusBarColor(jint(pal["bar"]))
        win.setNavigationBarColor(jint(pal["page"]))
        flags = 0
        if luminance(pal["bar"]) > 0.6:
            flags |= 0x2000
        if luminance(pal["page"]) > 0.6:
            flags |= 0x10
        win.getDecorView().setSystemUiVisibility(jint(flags))
    except Exception as e:
        log("window setup error: %r" % (e,))
    return dlg


class Win:
    pass


def setup_window(act, pal, title):
    """Полноэкранное окно с верхней панелью; панель уходит под статус-бар корректно."""
    w = Win()
    ui = UIKit(act)
    dp = ui.dp
    w.ui = ui
    w.dlg = make_fullscreen_dialog(act, pal)
    w.root = ui.vbox()
    w.root.setBackgroundColor(jint(pal["page"]))
    w.bar = ui.hbox()
    w.bar.setBackgroundColor(jint(pal["bar"]))
    w.bar.setGravity(16)
    back = ui.text("←", 26, pal["bar_text"], True)
    back.setPadding(dp(18), dp(12), dp(18), dp(12))
    back.setOnClickListener(_Click(lambda: w.dlg.dismiss()))
    w.bar.addView(back, ui.lp(-2, -2))
    w.title_tv = ui.text(title, 20, pal["bar_text"], True, single=True)
    w.bar.addView(w.title_tv, ui.lp(0, -2, 1.0))
    w.root.addView(w.bar, ui.lp(-1, dp(56)))
    w.cbs = []

    def on_insets(top, bottom):
        w.bar.setPadding(0, top, 0, 0)
        p = w.bar.getLayoutParams()
        p.height = dp(56) + top
        w.bar.setLayoutParams(p)
        for cb in w.cbs:
            try:
                cb(top, bottom)
            except Exception as e:
                log("inset callback error: %r" % (e,))

    w.root.setOnApplyWindowInsetsListener(_Insets(on_insets))
    try:
        w.root.requestApplyInsets()
    except Exception:
        pass
    return w


# ───────────────────────── Блок графика с вкладками ─────────────────────────

class ChartBox:
    def __init__(self, ui, pal, handler, card, modes, get_series, width, height, default):
        ImageView = jclass("android.widget.ImageView")
        ImageScale = jclass("android.widget.ImageView$ScaleType")
        dp = ui.dp
        self.ui, self.pal, self.handler = ui, pal, handler
        self.get_series = get_series
        self.mode = default
        self.sel = -1
        self.series = ([], [], [])
        self.alive = True
        self.anim = None
        self.on_tap = None
        self.on_mode = None
        self.pills = {}
        self._down = (0.0, 0.0)

        box = ui.hbox()
        box.setBackground(ui.rounded(pal["page"], 12))
        box.setPadding(dp(3), dp(3), dp(3), dp(3))
        card.addView(box, ui.lp(-1, -2))
        for mode, name in modes:
            tv = ui.text(name, 14, pal["gray"], True)
            tv.setGravity(17)
            tv.setPadding(dp(4), dp(9), dp(4), dp(9))
            tv.setOnClickListener(_Click(lambda m=mode: self.select_mode(m)))
            self.pills[mode] = tv
            box.addView(tv, ui.lp(0, -2, 1.0))

        self.title_tv = ui.text("", 13, pal["gray"])
        card.addView(self.title_tv, ui.lp(-2, -2, t=14, b=4))

        self.renderer = ChartRenderer(width, height, ui.d)
        self.image = ImageView(ui.act)
        self.image.setScaleType(ImageScale.FIT_XY)
        self.image.setImageBitmap(self.renderer.bmp)
        self.image.setOnTouchListener(_Touch(self._touch))
        card.addView(self.image, ui.lp(width, height))
        self.style_pills()

    def _touch(self, v, ev):
        action = ev.getAction()
        if action == 0:
            self._down = (ev.getX(), ev.getY())
            return True
        if action == 1:
            slop = self.ui.dp(14)
            if abs(ev.getX() - self._down[0]) < slop and abs(ev.getY() - self._down[1]) < slop:
                idx = self.renderer.hit(ev.getX(), len(self.series[0]))
                if idx is not None and self.on_tap is not None:
                    self.on_tap(idx)
        return True

    def bar_rect(self, i):
        """Прямоугольник столбца i в экранных координатах (для анимации зума)."""
        vals = self.series[0]
        n = len(vals)
        left, right, top, bottom = self.renderer.bounds()
        d = self.renderer.d
        slot = (right - left) / n
        bw = slot * (0.62 if n <= 12 else 0.7)
        mx = max(vals) or 1.0
        hh = max((vals[i] / mx) * (bottom - top), 2.5 * d)
        loc = jarray(jint)([0, 0])
        self.image.getLocationOnScreen(loc)
        x0 = loc[0] + left + i * slot + (slot - bw) / 2.0
        return (x0, loc[1] + bottom - hh, x0 + bw, loc[1] + bottom)

    def style_pills(self):
        for m, tv in self.pills.items():
            if m == self.mode:
                tv.setBackground(self.ui.rounded(self.pal["accent"], 10))
                tv.setTextColor(jint(self.pal["white"]))
            else:
                tv.setBackgroundColor(jint(0))
                tv.setTextColor(jint(self.pal["gray"]))

    def draw(self, progress):
        title, vals, labels, buckets = self.get_series(self.mode)
        self.series = (vals, labels, buckets)
        self.title_tv.setText(title)
        self.renderer.draw(vals, labels, self.pal, progress, self.sel)
        self.image.invalidate()

    def animate(self):
        ValueAnimator = jclass("android.animation.ValueAnimator")
        Decelerate = jclass("android.view.animation.DecelerateInterpolator")
        if self.anim is not None:
            try:
                self.anim.cancel()
            except Exception:
                pass
        anim = ValueAnimator.ofFloat(jarray(jfloat)([0.0, 1.0]))
        anim.setDuration(700)
        anim.setInterpolator(Decelerate(1.2))
        anim.addUpdateListener(_AnimListener(lambda v: self.alive and self.draw(v)))
        self.anim = anim
        anim.start()

    def running(self):
        try:
            return self.anim is not None and self.anim.isRunning()
        except Exception:
            return False

    def bounce(self, v):
        Overshoot = jclass("android.view.animation.OvershootInterpolator")
        v.animate().scaleX(0.9).scaleY(0.9).setDuration(80).withEndAction(
            _Run(lambda: v.animate().scaleX(1.0).scaleY(1.0).setDuration(220)
                 .setInterpolator(Overshoot(3.0)).start())
        ).start()

    def select_mode(self, mode):
        self.mode = mode
        self.sel = -1
        self.style_pills()
        self.bounce(self.pills[mode])
        self.animate()
        if self.on_mode is not None:
            self.on_mode()

    def stop(self):
        self.alive = False
        try:
            if self.anim is not None:
                self.anim.cancel()
        except Exception:
            pass


# ───────────────────────── Хуки меню ⋮ плеера (AudioPlayerAlert) ─────────────────────────

PLAYER_ITEM_BASE_ID = 6771
PLAYER_ITEMS = (
    ("Статистика", ("msg_stats", "msg_info")),
    ("Текст песни", ("msg_photo_text2", "msg_text", "msg_info")),
    ("Статистика трека", ("msg_info", "msg_stats")),
)

if MethodHook is not None:
    class _PlayerCtorHook(MethodHook):
        def __init__(self, plugin):
            self.plugin = plugin

        def after_hooked_method(self, param):
            try:
                self.plugin._player_after_ctor(param)
            except Exception as e:
                self.plugin.menu_status["error"] = "ctor: %r" % (e,)
                log("player ctor hook error: %r" % (e,))

    class _ItemOptionsHook(MethodHook):
        def __init__(self, plugin):
            self.plugin = plugin

        def after_hooked_method(self, param):
            try:
                self.plugin._player_after_item_options(param)
            except Exception as e:
                self.plugin.menu_status["error"] = "ItemOptions: %r" % (e,)

    class _SubItemSeenHook(MethodHook):
        def __init__(self, plugin):
            self.plugin = plugin

        def after_hooked_method(self, param):
            try:
                self.plugin._player_after_subitem(param)
            except Exception:
                pass

    class _PopupShowHook(MethodHook):
        def __init__(self, plugin):
            self.plugin = plugin

        def before_hooked_method(self, param):
            try:
                self.plugin._player_before_popup(param)
            except Exception as e:
                self.plugin.menu_status["error"] = "popup: %r" % (e,)

    class _PlayerAddHook(MethodHook):
        def __init__(self, plugin):
            self.plugin = plugin

        def after_hooked_method(self, param):
            try:
                self.plugin._player_after_add(param)
            except Exception as e:
                self.plugin.menu_status["error"] = "add: %r" % (e,)

    class _PlayerToggleHook(MethodHook):
        def __init__(self, plugin):
            self.plugin = plugin

        def before_hooked_method(self, param):
            try:
                self.plugin._player_before_toggle(param)
            except Exception as e:
                self.plugin.menu_status["error"] = "toggle: %r" % (e,)

    class _PlayerTitleHook(MethodHook):
        def __init__(self, plugin):
            self.plugin = plugin

        def after_hooked_method(self, param):
            try:
                self.plugin._player_update_visibility(param)
            except Exception:
                pass

    class _PlayerClickHook(MethodHook):
        def __init__(self, plugin):
            self.plugin = plugin

        def before_hooked_method(self, param):
            try:
                self.plugin._player_before_click(param)
            except Exception as e:
                self.plugin.menu_status["error"] = "click: %r" % (e,)
                log("player click hook error: %r" % (e,))


# ───────────────────────── Плагин ─────────────────────────

class MusicStatsPlugin(BasePlugin):
    def on_plugin_load(self):
        self.store = Store(db_path())
        self.now_playing = None   # (artist, title) — только пока реально играет
        self.cur = None           # (artist, title, duration) — даже на паузе
        self.paused = False
        self._cover_next = {}
        self._cover_tries = {}
        self._dur_seen = {}
        self._lyrics = {}
        self._lyrics_busy = set()
        self._stop = threading.Event()
        self._thread = threading.Thread(target=self._loop, name="MusicStatsLoop", daemon=True)
        self._thread.start()
        try:
            self.add_on_send_message_hook()
        except Exception as e:
            log("send hook unavailable: %r" % (e,))
        self.menu_status = {"hook": "не установлен", "injected": 0, "clicks": 0, "opened": 0,
                            "present": 0, "toggle": 0, "error": "", "ctor": 0, "title": 0,
                            "chromecast": 0, "add_hooks": 0, "io_hooks": 0, "io_chromecast": 0,
                            "sub_hooks": 0, "sub_chromecast": 0, "popup_hooks": 0, "popup_shows": 0,
                            "popup_chromecast": 0, "popup_injected": 0, "stacks": []}
        self._opt_btn = None
        self._btn_added = set()
        self._ensuring = False
        self._install_player_menu_hook()
        self._register_menu_items()
        log("loaded, db=" + db_path())

    def on_plugin_unload(self):
        try:
            self._stop.set()
            self.store.flush()
        except Exception as e:
            log("unload error: %r" % (e,))

    # ----- пункты в меню ⋮ плеера Telegram (тот же способ, что у Comfort Lyrics++) -----
    def _install_player_menu_hook(self):
        st = self.menu_status
        if MethodHook is None:
            st["hook"] = "в этой версии клиента нет MethodHook"
            return
        try:
            cls = jclass("org.telegram.ui.Components.AudioPlayerAlert").getClass()
            Boolean = jclass("java.lang.Boolean")
            Integer = jclass("java.lang.Integer")
            ctors = cls.getDeclaredConstructors()
            self.hook_method(ctors[0], _PlayerCtorHook(self))
            st["ctor_count"] = len(ctors)
            try:
                self.hook_method(cls.getDeclaredMethod("updateTitle", Boolean.TYPE), _PlayerTitleHook(self))
            except Exception as e:
                st["error"] = "updateTitle: %r" % (e,)
            self.hook_method(cls.getDeclaredMethod("onSubItemClick", Integer.TYPE), _PlayerClickHook(self))
            try:
                item_cls = jclass("org.telegram.ui.ActionBar.ActionBarMenuItem").getClass()
                for m in item_cls.getDeclaredMethods():
                    if str(m.getName()) == "toggleSubMenu":
                        self.hook_method(m, _PlayerToggleHook(self))
                        st["toggle"] += 1
            except Exception as e:
                st["error"] = "toggleSubMenu: %r" % (e,)
            try:  # запасной путь: ловим добавление пункта Chromecast в любое меню ActionBarMenuItem
                item_cls2 = jclass("org.telegram.ui.ActionBar.ActionBarMenuItem").getClass()
                for m in item_cls2.getDeclaredMethods():
                    if str(m.getName()) == "addSubItem":
                        self.hook_method(m, _PlayerAddHook(self))
                        st["add_hooks"] += 1
            except Exception as e:
                st["error"] = "addSubItem: %r" % (e,)
            self._hook_by_name("org.telegram.ui.Components.ItemOptions", ("add",), True,
                               _ItemOptionsHook, "io_hooks", "ItemOptions")
            self._hook_by_name("org.telegram.ui.ActionBar.ActionBarMenuSubItem",
                               ("setTextAndIcon", "setText"), False, _SubItemSeenHook, "sub_hooks", "SubItem")
            self._hook_by_name("android.widget.PopupWindow", ("show",), True, _PopupShowHook,
                               "popup_hooks", "PopupWindow")
            st["hook"] = "установлен"
        except Exception as e:
            st["hook"] = "не удалось установить"
            st["error"] = repr(e)
            log("player menu hook failed: %r" % (e,))

    def _hook_by_name(self, class_name, names, prefix, hook_cls, counter, tag):
        """Вешает хук на все методы класса с подходящим именем (точное имя или префикс)."""
        st = self.menu_status
        try:
            cls = jclass(class_name).getClass()
            methods = cls.getDeclaredMethods()
            for i in range(len(methods)):
                m = methods[i]
                nm = str(m.getName())
                ok = any(nm.startswith(x) for x in names) if prefix else nm in names
                if ok:
                    try:
                        self.hook_method(m, hook_cls(self))
                        st[counter] += 1
                    except Exception as e:
                        st["error"] = "%s.%s: %r" % (tag, nm, e)
        except Exception as e:
            st["error"] = "%s: %r" % (tag, e)

    def _arg_texts(self, param):
        out = []
        for a in jlist(param.args):
            if a is None or isinstance(a, (bool, int, float)):
                continue
            try:
                out.append(str(a))
            except Exception:
                pass
        return out

    def _note_stack(self, tag):
        try:
            frames = jclass("java.lang.Throwable")().getStackTrace()
            names = []
            for i in range(len(frames)):
                f = frames[i]
                cn = str(f.getClassName())
                low = cn.lower()
                if "hook" in low or "lsp" in low or cn.startswith("java.lang.Throwable"):
                    continue
                names.append(cn.split(".")[-1] + "." + str(f.getMethodName()))
                if len(names) >= 8:
                    break
            stacks = self.menu_status["stacks"]
            line = tag + ": " + " ← ".join(names)
            if line not in stacks:
                stacks.append(line)
            del stacks[:-4]
        except Exception as e:
            self.menu_status["error"] = "stack: %r" % (e,)

    def _player_action(self, k):
        def run():
            self.menu_status["clicks"] += 1
            if k == 0:
                self.open_stats()
            elif k == 1:
                self.open_lyrics()
            else:
                self.open_current_track_stats()
        return run

    def _player_after_item_options(self, param):
        """ItemOptions.add(...): когда добавляют Chromecast, дописываем свои пункты в это же меню."""
        if self._ensuring or not self.get_setting("player_menu", True):
            return
        if "Chromecast" not in self._arg_texts(param):
            return
        st = self.menu_status
        st["io_chromecast"] += 1
        self._note_stack("ItemOptions")
        self._ensuring = True
        try:
            opts = param.thisObject
            for k, (label, icons) in enumerate(PLAYER_ITEMS):
                opts.add(self._icon_id(*icons), label, _Run(self._player_action(k)))
            st["injected"] += 1
        finally:
            self._ensuring = False

    def _player_after_subitem(self, param):
        """Только для диагностики: кто создаёт строку Chromecast."""
        if "Chromecast" in self._arg_texts(param):
            self.menu_status["sub_chromecast"] += 1
            self._note_stack("SubItem")

    def _player_before_popup(self, param):
        """Универсальный путь: перед показом любого PopupWindow ищем в нём строку Chromecast
        и вставляем свои строки прямо в иерархию вью."""
        if not self.get_setting("player_menu", True):
            return
        popup = param.thisObject
        content = popup.getContentView()
        if content is None:
            return
        st = self.menu_status
        st["popup_shows"] += 1
        TextView = jclass("android.widget.TextView")
        LinearLayout = jclass("android.widget.LinearLayout")
        found = []
        labels = [x[0] for x in PLAYER_ITEMS]

        def walk(v, depth):
            if v is None or depth > 14:
                return
            try:
                if isinstance(v, TextView):
                    t = str(v.getText())
                    if t == "Chromecast" or t in labels:
                        found.append((t, v))
            except Exception:
                pass
            try:
                n = int(v.getChildCount())
            except Exception:
                return
            for i in range(n):
                walk(v.getChildAt(i), depth + 1)

        walk(content, 0)
        if not any(t == "Chromecast" for t, _ in found):
            return
        if any(t in labels for t, _ in found):
            return  # наши пункты уже вставлены
        st["popup_chromecast"] += 1
        self._note_stack("PopupWindow")
        tv = [v for t, v in found if t == "Chromecast"][0]

        row, parent = tv, tv.getParent()
        while parent is not None:
            is_menu_column = False
            try:
                is_menu_column = (isinstance(parent, LinearLayout)
                                  and int(parent.getOrientation()) == 1 and int(parent.getChildCount()) >= 3)
            except Exception:
                pass
            if is_menu_column:
                break
            row, parent = parent, parent.getParent()
        if parent is None:
            st["error"] = "popup: контейнер меню не найден"
            return

        ctx = parent.getContext()
        density = float(ctx.getResources().getDisplayMetrics().density)
        SubItem = jclass("org.telegram.ui.ActionBar.ActionBarMenuSubItem")
        color = int(tv.getCurrentTextColor())
        idx = int(parent.indexOfChild(row))

        def make_click(k):
            fn = self._player_action(k)

            def on_click():
                try:
                    popup.dismiss()
                except Exception:
                    pass
                fn()
            return on_click

        for k, (label, icons) in enumerate(PLAYER_ITEMS):
            item = SubItem(ctx, False, False)
            item.setTextAndIcon(label, self._icon_id(*icons))
            try:
                item.setColors(color, color)
            except Exception:
                pass
            item.setOnClickListener(_Click(make_click(k)))
            parent.addView(item, idx + 1 + k, LinearLayout.LayoutParams(-1, int(48 * density)))
        st["popup_injected"] += 1

    def _icon_id(self, *names):
        ctx = jclass("org.telegram.messenger.ApplicationLoader").applicationContext
        res = ctx.getResources()
        pkg = ctx.getPackageName()
        for n in names:
            try:
                i = int(res.getIdentifier(n, "drawable", pkg))
                if i:
                    return i
            except Exception:
                pass
        return 0

    def _is_music(self):
        try:
            mo = jclass("org.telegram.messenger.MediaController").getInstance().getPlayingMessageObject()
            return bool(mo is not None and mo.isMusic())
        except Exception:
            return False

    def _ensure_player_items(self, btn):
        """Идемпотентно добавляет наши пункты в меню ⋮ и делает их видимыми."""
        if self._ensuring:
            return
        self._ensuring = True
        try:
            self._ensure_player_items_impl(btn)
        finally:
            self._ensuring = False

    def _ensure_player_items_impl(self, btn):
        System = jclass("java.lang.System")
        Integer = jclass("java.lang.Integer")
        ident = int(System.identityHashCode(btn))
        layout = None
        try:
            layout = get_private_field(btn, "popupLayout")
        except Exception:
            layout = None
        verified = layout is not None
        present = 0
        for i, (label, icons) in enumerate(PLAYER_ITEMS):
            iid = PLAYER_ITEM_BASE_ID + i
            exists = ident in self._btn_added
            if not exists:
                btn.addSubItem(iid, self._icon_id(*icons), label)
                self.menu_status["injected"] += 1
            present += 1
            btn.setSubItemShown(iid, True)
        if len(self._btn_added) > 100:
            self._btn_added.clear()
        self._btn_added.add(ident)
        self.menu_status["present"] = present

    def _player_after_ctor(self, param):
        self.menu_status["ctor"] += 1
        if not self.get_setting("player_menu", True):
            return
        btn = get_private_field(param.thisObject, "optionsButton")
        self._opt_btn = btn
        self._ensure_player_items(btn)

    def _player_update_visibility(self, param):
        self.menu_status["title"] += 1
        if not self.get_setting("player_menu", True):
            return
        btn = get_private_field(param.thisObject, "optionsButton")
        self._opt_btn = btn
        self._ensure_player_items(btn)

    def _player_after_add(self, param):
        """Запасной путь: как только в меню добавляют Chromecast, дописываем свои пункты."""
        if self._ensuring or not self.get_setting("player_menu", True):
            return
        texts = []
        for a in (list(param.args) if param.args is not None else []):
            if a is None or isinstance(a, (bool, int, float)):
                continue
            try:
                texts.append(str(a))
            except Exception:
                pass
        if "Chromecast" not in texts:
            return
        self.menu_status["chromecast"] += 1
        self._ensure_player_items(param.thisObject)

    def _player_before_toggle(self, param):
        """Прямо перед открытием меню ⋮ плеера ещё раз проверяем, что наши пункты на месте."""
        btn = self._opt_btn
        if btn is None or not self.get_setting("player_menu", True):
            return
        System = jclass("java.lang.System")
        if int(System.identityHashCode(param.thisObject)) != int(System.identityHashCode(btn)):
            return
        self.menu_status["opened"] += 1
        self._ensure_player_items(btn)

    def _player_before_click(self, param):
        item_id = int(param.args[0])
        idx = item_id - PLAYER_ITEM_BASE_ID
        if not (0 <= idx < len(PLAYER_ITEMS)):
            return
        param.setResult(None)
        self.menu_status["clicks"] += 1
        if idx == 0:
            self.open_stats()
        elif idx == 1:
            self.open_lyrics()
        else:
            self.open_current_track_stats()

    def menu_diagnostics(self):
        st = self.menu_status
        popup = "кнопка ⋮ плеера ещё не создавалась"
        btn = self._opt_btn
        if btn is not None:
            try:
                layout = get_private_field(btn, "popupLayout")
                try:
                    n = int(layout.getItemsCount())
                except Exception:
                    n = int(layout.getChildCount())
                popup = "элементов в меню ⋮: %d" % n
            except Exception as e:
                popup = "popupLayout недоступен: %r" % (e,)
        lines = [
            "Версия плагина: " + __version__,
            "Хук: " + st["hook"],
            "Конструкторов у плеера: %s" % st.get("ctor_count", "?"),
            "Плеер создавался (конструктор): %d" % st["ctor"],
            "Заголовок трека обновлялся: %d" % st["title"],
            "Меню ⋮ открывалось (хуков %d): %d" % (st["toggle"], st["opened"]),
            "Пункт Chromecast замечен (хуков %d): %d" % (st["add_hooks"], st["chromecast"]),
            "Наших пунктов в меню: %d, добавлено раз: %d" % (st["present"], st["injected"]),
            "Нажатий на наши пункты: %d" % st["clicks"],
            "ItemOptions: хуков %d, Chromecast %d" % (st["io_hooks"], st["io_chromecast"]),
            "ActionBarMenuSubItem: хуков %d, Chromecast %d" % (st["sub_hooks"], st["sub_chromecast"]),
            "PopupWindow: хуков %d, показов %d, с Chromecast %d, вставлено %d" % (
                st["popup_hooks"], st["popup_shows"], st["popup_chromecast"], st["popup_injected"]),
            popup,
        ] + ["Стек " + x for x in st["stacks"]]
        if st["error"]:
            lines.append("Ошибка: " + st["error"])

        def show():
            act = self._activity()
            if act is None:
                toast(" | ".join(lines)[:290])
                return
            Builder = jclass("android.app.AlertDialog$Builder")
            bld = Builder(act)
            bld.setTitle("Меню плеера: диагностика")
            bld.setMessage("\n".join(lines))
            bld.setPositiveButton("OK", _DialogClick(lambda: None))
            bld.show()

        run_on_ui_thread(show)

    # ----- пункты меню сообщений и бокового меню -----
    def _register_menu_items(self):
        try:
            from base_plugin import MenuItemData, MenuItemType
        except Exception as e:
            log("menu api unavailable: %r" % (e,))
            return

        def add(menu_type, text, fn, condition=None):
            try:
                kwargs = dict(menu_type=menu_type, text=text, on_click=fn)
                if condition:
                    kwargs["condition"] = condition
                self.add_menu_item(MenuItemData(**kwargs))
            except Exception as e:
                log("menu item '%s' failed: %r" % (text, e))

        msg_type = getattr(MenuItemType, "MESSAGE_CONTEXT_MENU", None)
        if msg_type is not None:
            cond = "message.isMusic()"
            add(msg_type, "Статистика", lambda *a, **k: self.open_stats(), cond)
            add(msg_type, "Текст", lambda *a, **k: self.open_lyrics(), cond)
            add(msg_type, "Статистика трека",
                lambda *a, **k: self._track_stats_from_context(a[0] if a else None), cond)
        drawer = getattr(MenuItemType, "DRAWER_MENU", None)
        if drawer is not None:
            add(drawer, "Музыка: статистика", lambda *a, **k: self.open_stats())
            add(drawer, "Музыка: текст песни", lambda *a, **k: self.open_lyrics())

    def _track_stats_from_context(self, ctx):
        msg = None
        try:
            msg = ctx.get("message") if isinstance(ctx, dict) else getattr(ctx, "message", None)
        except Exception:
            msg = None
        try:
            if msg is not None and msg.isMusic():
                artist, title, dur = track_from_mo(msg)
                self.open_track_stats(artist, title, dur)
                return
        except Exception as e:
            log("context track error: %r" % (e,))
        self.open_current_track_stats()

    # ----- команды -----
    def on_send_message_hook(self, account, params):
        try:
            msg = getattr(params, "message", None)
            if msg is None:
                msg = getattr(params, "text", None)
            low = str(msg).strip().lower() if msg is not None else ""
            if low in (".music", ".музыка"):
                self.open_stats()
                return HookResult(strategy=HookStrategy.CANCEL)
            if low in (".lyrics", ".текст"):
                self.open_lyrics()
                return HookResult(strategy=HookStrategy.CANCEL)
            if low in (".track", ".трек"):
                self.open_current_track_stats()
                return HookResult(strategy=HookStrategy.CANCEL)
        except Exception as e:
            log("hook error: %r" % (e,))
        return HookResult()

    # ----- фоновый учёт -----
    def _loop(self):
        MC = jclass("org.telegram.messenger.MediaController")
        last = time.monotonic()
        last_flush = last
        while not self._stop.wait(1.0):
            now = time.monotonic()
            dt = min(now - last, 2.0)
            last = now
            try:
                mc = MC.getInstance()
                mo = mc.getPlayingMessageObject()
                if mo is not None and mo.isMusic():
                    artist, title, dur = track_from_mo(mo)
                    paused = bool(mc.isMessagePaused())
                    self.cur = (artist, title, dur)
                    self.paused = paused
                    if self.get_setting("enabled", True):
                        self._maybe_cover(mo, artist, title, now)
                        if dur > 0 and self._dur_seen.get((artist, title)) != dur:
                            self._dur_seen[(artist, title)] = dur
                            self.store.set_duration(artist, title, dur)
                        if not paused:
                            self.now_playing = (artist, title)
                            self.store.add(int(time.time() // 60 * 60), artist, title, dt)
                        else:
                            self.now_playing = None
                    else:
                        self.now_playing = None
                else:
                    self.cur = None
                    self.paused = False
                    self.now_playing = None
            except Exception as e:
                log("tick error: %r" % (e,))
            if now - last_flush >= 10:
                last_flush = now
                try:
                    self.store.flush()
                except Exception as e:
                    log("flush error: %r" % (e,))
        try:
            self.store.flush()
        except Exception:
            pass

    # ----- обложки -----
    def _extract_cover(self, mo, artist, title, notes=None):
        path = self.store.cover_path(artist, title)

        def note(m):
            if notes is not None:
                notes.append(m)
            log("cover: " + m)

        BitmapFactory = jclass("android.graphics.BitmapFactory")
        bmp = None
        acc = None
        try:
            acc = int(mo.currentAccount)
        except Exception:
            acc = None

        # A: миниатюра документа (то, что показывает сам Telegram)
        try:
            doc = mo.getDocument()
            best = None
            if doc is not None and doc.thumbs is not None:
                for t in jlist(doc.thumbs):
                    nm = str(t.getClass().getSimpleName())
                    if "Stripped" in nm or "Empty" in nm or "Path" in nm:
                        continue
                    if best is None or t.w > best.w:
                        best = t
            if best is None:
                note("A: у трека нет миниатюры")
            else:
                TL = "org.telegram.tgnet.TLObject"
                f = file_loader_call("getPathToAttach", [TL], [best], acc)
                if f is None or not f.exists():
                    f = file_loader_call("getPathToAttach", [TL, "boolean"], [best, True], acc)
                if f is not None and f.exists():
                    bmp = BitmapFactory.decodeFile(str(f.getAbsolutePath()))
                    note("A: ok" if bmp is not None else "A: файл не декодируется")
                else:
                    note("A: файл миниатюры не найден (%s, %sx%s): %s" % (
                        str(best.getClass().getSimpleName()), best.w, best.h,
                        str(f.getAbsolutePath()) if f is not None else "путь не получен"))
        except Exception as e:
            note("A: ошибка %r" % (e,))

        # B: AudioInfo из плеера Telegram
        if bmp is None:
            try:
                info = jclass("org.telegram.messenger.MediaController").getInstance().getAudioInfo()
                cover = info.getCover() if info is not None else None
                if cover is not None:
                    bmp = cover
                    note("B: ok")
                else:
                    note("B: в плеере нет обложки")
            except Exception as e:
                note("B: ошибка %r" % (e,))

        # C: встроенная обложка из тегов файла
        if bmp is None:
            try:
                f = file_loader_call("getPathToMessage", ["org.telegram.tgnet.TLRPC$Message"], [mo.messageOwner], acc)
                if f is None or not f.exists():
                    note("C: файл трека не найден: %s" % (str(f.getAbsolutePath()) if f is not None else "путь не получен"))
                else:
                    mmr = jclass("android.media.MediaMetadataRetriever")()
                    try:
                        mmr.setDataSource(str(f.getAbsolutePath()))
                        pic = mmr.getEmbeddedPicture()
                    finally:
                        try:
                            mmr.release()
                        except Exception:
                            pass
                    if pic is None:
                        note("C: в файле нет обложки")
                    else:
                        bmp = BitmapFactory.decodeByteArray(pic, 0, len(pic))
                        note("C: ok" if bmp is not None else "C: не декодируется")
            except Exception as e:
                note("C: ошибка %r" % (e,))

        if bmp is None:
            return False
        try:
            save_cover(bmp, path)
            return True
        except Exception as e:
            note("сохранение: ошибка %r" % (e,))
            return False

    def _maybe_cover(self, mo, artist, title, now):
        key = (artist, title)
        if os.path.exists(self.store.cover_path(artist, title)):
            return
        if self._cover_tries.get(key, 0) >= 12 or now < self._cover_next.get(key, 0):
            return
        self._cover_tries[key] = self._cover_tries.get(key, 0) + 1
        self._cover_next[key] = now + 6
        self._extract_cover(mo, artist, title)

    def _info_dialog(self, title, message):
        def show():
            act = self._activity()
            if act is None:
                toast((title + ": " + message.replace("\n", " | "))[:290])
                return
            Builder = jclass("android.app.AlertDialog$Builder")
            bld = Builder(act)
            bld.setTitle(title)
            bld.setMessage(message)
            bld.setPositiveButton("OK", _DialogClick(lambda: None))
            bld.show()

        run_on_ui_thread(show)

    def diagnose_cover(self):
        def work():
            try:
                mc = jclass("org.telegram.messenger.MediaController").getInstance()
                mo = mc.getPlayingMessageObject()
                if mo is None or not mo.isMusic():
                    toast("Диагностика: включи трек в Telegram")
                    return
                artist, title, _d = track_from_mo(mo)
                notes = []
                ok = self._extract_cover(mo, artist, title, notes)
                self._info_dialog("Обложка: " + ("сохранена" if ok else "не найдена"), "\n".join(notes))
            except Exception as e:
                toast("Диагностика: ошибка %r" % (e,))

        threading.Thread(target=work, daemon=True).start()

    # ----- позиция воспроизведения и тексты -----
    def current_position(self):
        try:
            mc = jclass("org.telegram.messenger.MediaController").getInstance()
            mo = mc.getPlayingMessageObject()
            if mo is None:
                return None
            dur = float(mo.getDuration())
            if dur > 0:
                return float(mo.audioProgress) * dur
            return float(mo.audioProgressSec)
        except Exception:
            return None

    def get_lyrics(self, artist, title, duration):
        key = (artist, title)
        entry = self._lyrics.get(key)
        if entry is not None:
            if entry["status"] != "error" or time.time() - entry.get("ts", 0) < 30:
                return entry
        if key in self._lyrics_busy:
            return {"status": "loading"}
        self._lyrics_busy.add(key)

        def work():
            try:
                res = fetch_lyrics(artist, title, duration)
            except Exception as e:
                log("lyrics error: %r" % (e,))
                res = {"status": "error", "lines": [], "times": [], "plain": None}
            res["ts"] = time.time()
            self._lyrics[key] = res
            if len(self._lyrics) > 30:
                try:
                    self._lyrics.pop(next(iter(self._lyrics)))
                except Exception:
                    pass
            self._lyrics_busy.discard(key)

        threading.Thread(target=work, daemon=True).start()
        return {"status": "loading"}

    # ----- настройки -----
    def create_settings(self):
        return [
            Header(text="Статистика прослушивания"),
            Switch(
                key="enabled",
                text="Вести учёт",
                default=True,
                subtext="Считается только музыка (аудиофайлы), без голосовых и кружков",
            ),
            Switch(
                key="player_menu",
                text="Пункты в меню ⋮ плеера",
                default=True,
                subtext="Статистика, Текст песни и Статистика трека в меню трёх точек плеера Telegram",
            ),
            Text(text="Открыть статистику", accent=True, on_click=lambda *a: self.open_stats()),
            Text(text="Открыть текст песни", accent=True, on_click=lambda *a: self.open_lyrics()),
            Text(text="Статистика текущего трека", accent=True, on_click=lambda *a: self.open_current_track_stats()),
            Text(text="Проверить обложку текущего трека", on_click=lambda *a: self.diagnose_cover()),
            Text(text="Проверить меню плеера", on_click=lambda *a: self.menu_diagnostics()),
            Text(text="Сбросить все данные", red=True, on_click=lambda *a: self.confirm_reset()),
            Divider(text="Команды в любом чате: .music статистика, .lyrics текст песни, .track статистика трека"),
        ]

    # ----- общие помощники UI -----
    def _activity(self):
        try:
            frag = get_last_fragment()
            act = frag.getParentActivity() if frag is not None else None
            if act is not None:
                return act
        except Exception as e:
            log("fragment error: %r" % (e,))
        try:
            return jclass("org.telegram.ui.LaunchActivity").instance
        except Exception as e:
            log("launch activity error: %r" % (e,))
            return None

    def _safe(self, fn, *args):
        try:
            fn(*args)
        except Exception as e:
            import traceback
            log("window error: " + traceback.format_exc())
            try:
                fr = traceback.extract_tb(e.__traceback__)[-1]
                where = "стр. %s: %s" % (fr.lineno, (fr.line or "").strip()[:70])
            except Exception:
                where = "?"
            msg = str(e)
            toast("MusicStats %s" % where)
            for i in range(0, min(len(msg), 360), 70):
                toast(msg[i:i + 70])

    def confirm_reset(self):
        def show():
            act = self._activity()
            if act is None:
                return
            Builder = jclass("android.app.AlertDialog$Builder")
            b = Builder(act)
            b.setTitle("Сбросить статистику?")
            b.setMessage("Все накопленные данные будут удалены без возможности восстановления.")
            b.setPositiveButton("Сбросить", _DialogClick(lambda: self.store.reset()))
            b.setNegativeButton("Отмена", _DialogClick(lambda: None))
            b.show()

        run_on_ui_thread(show)

    # ----- точки входа -----
    def open_stats(self):
        def work():
            try:
                snap = self.store.snapshot()
                run_on_ui_thread(lambda: self._safe(self._show_stats, snap))
            except Exception as e:
                log("open_stats error: %r" % (e,))
                toast("MusicStats: ошибка данных: %r" % (e,))

        threading.Thread(target=work, daemon=True).start()

    def open_lyrics(self):
        run_on_ui_thread(lambda: self._safe(self._show_lyrics))

    def open_track_stats(self, artist, title, duration=0):
        def work():
            try:
                ts = self.store.track_stats(artist, title)
                if duration and not ts["duration"]:
                    ts["duration"] = duration
                run_on_ui_thread(lambda: self._safe(self._show_track_stats, artist, title, ts))
            except Exception as e:
                log("open_track_stats error: %r" % (e,))
                toast("MusicStats: ошибка данных: %r" % (e,))

        threading.Thread(target=work, daemon=True).start()

    def open_current_track_stats(self):
        cur = self.cur
        if not cur:
            toast("Сейчас ничего не играет")
            return
        self.open_track_stats(cur[0], cur[1], cur[2])

    # ───────── окно: общая статистика ─────────
    def _show_stats(self, snap):
        act = self._activity()
        if act is None:
            toast("MusicStats: не найдено окно приложения")
            return

        ScrollView = jclass("android.widget.ScrollView")
        ImageView = jclass("android.widget.ImageView")
        ImageScale = jclass("android.widget.ImageView$ScaleType")
        Handler = jclass("android.os.Handler")
        Looper = jclass("android.os.Looper")
        ValueAnimator = jclass("android.animation.ValueAnimator")
        Decelerate = jclass("android.view.animation.DecelerateInterpolator")
        BitmapFactory = jclass("android.graphics.BitmapFactory")

        pal = get_palette()
        win = setup_window(act, pal, "Музыка в Telegram")
        ui, dlg, root = win.ui, win.dlg, win.root
        dp, lp, text = ui.dp, ui.lp, ui.text
        store = self.store
        handler = Handler(Looper.getMainLooper())
        screen_w = int(act.getResources().getDisplayMetrics().widthPixels)

        state = {"snap": snap, "alive": True, "busy": False, "ticks": 0, "f": 0.0, "sel": -1, "gen": 0}
        cards = []

        def card():
            c = ui.vbox()
            c.setBackground(ui.rounded(pal["card"], 16))
            c.setPadding(dp(16), dp(16), dp(16), dp(16))
            cards.append(c)
            return c

        scroll = ScrollView(act)
        scroll.setVerticalScrollBarEnabled(False)
        content = ui.vbox()
        content.setPadding(dp(12), dp(12), dp(12), dp(20))
        scroll.addView(content)
        root.addView(scroll, lp(-1, 0, 1.0))
        win.cbs.append(lambda t, b: content.setPadding(dp(12), dp(12), dp(12), dp(20) + b))

        # ---- итог ----
        hero = card()
        hero.addView(text("Всего прослушано", 13, pal["gray"]))
        total_tv = text("0с", 34, pal["accent"], True)
        hero.addView(total_tv, lp(-2, -2, t=2))
        tracks_tv = text("", 13, pal["gray"])
        hero.addView(tracks_tv, lp(-2, -2, t=2))
        sep = View(act)
        sep.setBackgroundColor(jint(pal["divider"]))
        hero.addView(sep, lp(-1, 1, t=14, b=12))
        stats_row = ui.hbox()
        stat_vals = {}
        for key, cap in (("today", "Сегодня"), ("week", "7 дней"), ("month", "30 дней")):
            col = ui.vbox()
            v = text("0с", 17, pal["text"], True)
            col.addView(v)
            col.addView(text(cap, 12, pal["gray"]))
            stat_vals[key] = v
            stats_row.addView(col, lp(0, -2, 1.0))
        hero.addView(stats_row)
        content.addView(hero, lp(-1, -2, b=12))

        # ---- самый прослушиваемый трек ----
        top_card = card()
        top_row = ui.hbox()
        top_row.setGravity(16)
        cover_size = dp(92)
        cover_iv = ImageView(act)
        cover_iv.setScaleType(ImageScale.FIT_XY)
        top_row.addView(cover_iv, lp(cover_size, cover_size, r=14))
        top_col = ui.vbox()
        top_col.addView(text("Самый прослушиваемый трек", 12, pal["gray"]))
        top_title = text("—", 18, pal["text"], True)
        top_title.setMaxLines(2)
        top_title.setEllipsize(ui.TruncateAt.END)
        top_col.addView(top_title, lp(-2, -2, t=3))
        top_artist = text("", 14, pal["gray"], single=True)
        top_col.addView(top_artist)
        top_time = text("", 14, pal["accent"], True)
        top_col.addView(top_time, lp(-2, -2, t=4))
        top_row.addView(top_col, lp(0, -2, 1.0))
        top_card.addView(top_row)
        content.addView(top_card, lp(-1, -2, b=12))

        def open_top():
            tt = state["snap"]["top_tracks"]
            if tt:
                self.open_track_stats(tt[0][0], tt[0][1])

        top_card.setOnClickListener(_Click(open_top))

        # ---- сейчас играет ----
        np_card = card()
        np_row = ui.hbox()
        np_row.setGravity(16)
        dot = text("●", 16, pal["accent"])
        np_row.addView(dot, lp(-2, -2, r=12))
        np_col = ui.vbox()
        np_title = text("Ничего не играет", 16, pal["text"], True, single=True)
        np_artist = text("Включи музыку в Telegram", 13, pal["gray"], single=True)
        np_col.addView(np_title)
        np_col.addView(np_artist)
        np_row.addView(np_col, lp(0, -2, 1.0))
        np_card.addView(np_row)
        btn_row = ui.hbox()

        def pill_btn(label, fn):
            tv = text(label, 13, pal["accent"], True)
            tv.setBackground(ui.rounded(with_alpha(pal["accent"], 40), 12))
            tv.setPadding(dp(14), dp(8), dp(14), dp(8))
            tv.setOnClickListener(_Click(fn))
            return tv

        btn_row.addView(pill_btn("Текст песни", lambda: self.open_lyrics()), lp(-2, -2, r=8))
        btn_row.addView(pill_btn("Статистика трека", lambda: self.open_current_track_stats()), lp(-2, -2))
        np_card.addView(btn_row, lp(-2, -2, t=12))
        content.addView(np_card, lp(-1, -2, b=12))

        # ---- график ----
        chart_card = card()
        chart_w = screen_w - dp(24) - dp(32)
        chart_h = dp(220)
        chart = ChartBox(
            ui, pal, handler, chart_card,
            (("hour", "Часы"), ("wday", "Дни"), ("month", "Месяцы")),
            lambda mode: build_series(state["snap"], mode), chart_w, chart_h, "hour",
        )
        chart_card.addView(text("Нажми на столбец, чтобы увидеть треки за этот период", 12, pal["gray"]),
                           lp(-2, -2, t=6))
        content.addView(chart_card, lp(-1, -2, b=12))

        # ---- топы ----
        tracks_card = card()
        tracks_card.addView(text("Топ треков", 17, pal["text"], True), lp(-2, -2, b=6))
        tracks_box = ui.vbox()
        tracks_card.addView(tracks_box)
        content.addView(tracks_card, lp(-1, -2, b=12))

        artists_card = card()
        artists_card.addView(text("Топ исполнителей", 17, pal["text"], True), lp(-2, -2, b=2))
        artists_card.addView(text("Нажми на исполнителя, чтобы увидеть его треки", 12, pal["gray"]), lp(-2, -2, b=6))
        artists_box = ui.vbox()
        artists_card.addView(artists_box)
        content.addView(artists_card, lp(-1, -2, b=4))

        # ───── логика ─────
        def make_row(box, rank, title, subtitle, value, share, on_click=None):
            wrap = ui.vbox()
            wrap.setPadding(0, dp(7), 0, dp(7))
            row = ui.hbox()
            row.setGravity(16)
            rk = text(str(rank), 15, pal["accent"], True)
            rk.setMinWidth(dp(26))
            row.addView(rk, lp(-2, -2))
            mid = ui.vbox()
            mid.addView(text(title, 15, pal["text"], True, single=True))
            if subtitle:
                mid.addView(text(subtitle, 12.5, pal["gray"], single=True))
            row.addView(mid, lp(0, -2, 1.0, l=4, r=8))
            row.addView(text(value, 13, pal["gray"], True), lp(-2, -2))
            wrap.addView(row)
            share = max(0.03, min(1.0, share))
            meter = ui.hbox()
            meter.setWeightSum(1.0)
            fill = View(act)
            fill.setBackground(ui.rounded(pal["accent"], 2))
            meter.addView(fill, lp(0, dp(3), share))
            if share < 1.0:
                meter.addView(View(act), lp(0, dp(3), 1.0 - share))
            wrap.addView(meter, lp(-1, dp(3), t=6, l=30))
            if on_click is not None:
                wrap.setOnClickListener(_Click(on_click))
            box.addView(wrap)

        def fill_tops(s):
            tracks_box.removeAllViews()
            artists_box.removeAllViews()
            if s["top_tracks"]:
                mx = max(r[2] for r in s["top_tracks"]) or 1.0
                for i, (artist, title, secs) in enumerate(s["top_tracks"], 1):
                    make_row(tracks_box, i, title, artist, fmt_dur(secs), secs / mx,
                             lambda a=artist, t=title: self.open_track_stats(a, t))
            else:
                tracks_box.addView(text("Пока нет данных", 14, pal["gray"]))
            if s["top_artists"]:
                mx = max(r[1] for r in s["top_artists"]) or 1.0
                for i, (artist, secs) in enumerate(s["top_artists"], 1):
                    make_row(artists_box, i, artist, "", fmt_dur(secs), secs / mx,
                             lambda a=artist: self.open_artist_breakdown(a))
            else:
                artists_box.addView(text("Пока нет данных", 14, pal["gray"]))

        cover_sig = {"v": None}

        def update_top(s):
            path, exists = None, False
            if s["top_tracks"]:
                artist, title, secs = s["top_tracks"][0]
                top_title.setText(title)
                top_artist.setText(artist)
                top_time.setText("прослушано %s" % fmt_dur(secs))
                path = store.cover_path(artist, title)
                exists = os.path.exists(path)
                sig = (artist, title, exists)
            else:
                top_title.setText("Пока нет данных")
                top_artist.setText("")
                top_time.setText("")
                sig = ("none",)
            if cover_sig["v"] == sig:
                return
            cover_sig["v"] = sig
            bmp = None
            if exists:
                try:
                    src = BitmapFactory.decodeFile(path)
                    if src is not None:
                        bmp = round_bitmap(src, cover_size, float(dp(14)))
                except Exception as e:
                    log("cover load error: %r" % (e,))
            if bmp is None:
                bmp = placeholder_bitmap(cover_size, float(dp(14)), pal)
            cover_iv.setImageBitmap(bmp)

        def update_texts():
            s = state["snap"]
            delta = max(0.0, store.added - s["added_at"])
            f = state["f"]
            total_tv.setText(fmt_hms((s["total"] + delta) * f))
            stat_vals["today"].setText(fmt_hms((s["today"] + delta) * f))
            stat_vals["week"].setText(fmt_dur((s["week"] + delta) * f))
            stat_vals["month"].setText(fmt_dur((s["month"] + delta) * f))
            tracks_tv.setText("уникальных треков: %d" % s["tracks"])
            np = self.now_playing
            if np:
                np_title.setText(np[1])
                np_artist.setText(np[0])
            elif self.cur:
                np_title.setText(self.cur[1])
                np_artist.setText("На паузе · " + self.cur[0])
            else:
                np_title.setText("Ничего не играет")
                if s["last"]:
                    np_artist.setText("Последний: %s — %s" % (s["last"][0], s["last"][1]))
                else:
                    np_artist.setText("Включи музыку в Telegram")

        # ---- тап по столбцу: отдельное окно с разбором по трекам ----
        def select_bar(i):
            vals, labels, buckets = chart.series
            if not (0 <= i < len(vals)):
                return
            chart.sel = i
            if not chart.running():
                chart.draw(1.0)
            try:
                origin = chart.bar_rect(i)
            except Exception as e:
                log("bar rect error: %r" % (e,))
                origin = None
            self.open_bucket_breakdown(list(buckets), i, origin)

        chart.on_tap = select_bar

        def apply_snapshot(s):
            if not state["alive"]:
                return
            state["snap"] = s
            fill_tops(s)
            update_top(s)
            update_texts()
            if not chart.running():
                chart.draw(1.0)

        def refresh():
            if state["busy"] or not state["alive"]:
                return
            state["busy"] = True

            def work():
                try:
                    s = store.snapshot()
                    run_on_ui_thread(lambda: apply_snapshot(s))
                except Exception as e:
                    log("refresh error: %r" % (e,))
                finally:
                    state["busy"] = False

            threading.Thread(target=work, daemon=True).start()

        def tick():
            if not state["alive"]:
                return
            state["ticks"] += 1
            update_texts()
            try:
                if self.now_playing:
                    dot.animate().alpha(0.25 if state["ticks"] % 2 else 1.0).setDuration(800).start()
                else:
                    dot.animate().alpha(0.25).setDuration(300).start()
            except Exception:
                pass
            if state["ticks"] % 3 == 0:
                refresh()
            handler.postDelayed(tick_runnable, 1000)

        tick_runnable = _Run(tick)

        def on_dismiss():
            state["alive"] = False
            chart.stop()
            try:
                handler.removeCallbacksAndMessages(None)
            except Exception:
                pass

        dlg.setOnDismissListener(_Dismiss(on_dismiss))

        fill_tops(snap)
        update_top(snap)
        update_texts()
        chart.draw(0.0)

        dlg.setContentView(root)
        dlg.show()

        win.bar.setAlpha(0.0)
        win.bar.animate().alpha(1.0).setDuration(250).start()
        for i, c in enumerate(cards):
            c.setAlpha(0.0)
            c.setTranslationY(float(dp(28)))
            c.animate().alpha(1.0).translationY(0.0).setStartDelay(90 * i + 80).setDuration(420) \
                .setInterpolator(Decelerate(2.0)).start()

        count = ValueAnimator.ofFloat(jarray(jfloat)([0.0, 1.0]))
        count.setDuration(1100)
        count.setInterpolator(Decelerate(2.0))

        def on_count(v):
            state["f"] = v
            if state["alive"]:
                update_texts()

        count.addUpdateListener(_AnimListener(on_count))
        count.start()

        handler.postDelayed(_Run(chart.animate), 350)
        handler.postDelayed(tick_runnable, 1000)

    # ───────── окно: статистика трека ─────────
    def _show_track_stats(self, artist, title, ts):
        act = self._activity()
        if act is None:
            toast("MusicStats: не найдено окно приложения")
            return

        ScrollView = jclass("android.widget.ScrollView")
        ImageView = jclass("android.widget.ImageView")
        ImageScale = jclass("android.widget.ImageView$ScaleType")
        Handler = jclass("android.os.Handler")
        Looper = jclass("android.os.Looper")
        Decelerate = jclass("android.view.animation.DecelerateInterpolator")
        BitmapFactory = jclass("android.graphics.BitmapFactory")

        pal = get_palette()
        win = setup_window(act, pal, "Статистика трека")
        ui, dlg, root = win.ui, win.dlg, win.root
        dp, lp, text = ui.dp, ui.lp, ui.text
        handler = Handler(Looper.getMainLooper())
        screen_w = int(act.getResources().getDisplayMetrics().widthPixels)
        store = self.store
        key = (artist, title)

        st = {"alive": True, "ts": ts, "added_at": float(ts.get("added_at", 0.0)),
              "ticks": 0, "busy": False, "cover": None}
        arrays = {"hod": [0.0] * 24, "wd": [0.0] * 7, "moy": [0.0] * 12}

        def recompute(t):
            hod, wd, moy = [0.0] * 24, [0.0] * 7, [0.0] * 12
            for h, secs in t["hourly"]:
                lt = time.localtime(h)
                hod[lt.tm_hour] += secs
                wd[lt.tm_wday] += secs
                moy[lt.tm_mon - 1] += secs
            arrays["hod"], arrays["wd"], arrays["moy"] = hod, wd, moy

        recompute(ts)

        def series(mode):
            if mode == "hour":
                return ("По времени суток · всё время", arrays["hod"],
                        ["%02d" % i if i % 3 == 0 else "" for i in range(24)], [])
            if mode == "wday":
                return "По дням недели · всё время", arrays["wd"], list(WDAYS), []
            return "По месяцам года · всё время", arrays["moy"], list(MONTHS), []

        cards = []

        def card():
            c = ui.vbox()
            c.setBackground(ui.rounded(pal["card"], 16))
            c.setPadding(dp(16), dp(16), dp(16), dp(16))
            cards.append(c)
            return c

        scroll = ScrollView(act)
        scroll.setVerticalScrollBarEnabled(False)
        content = ui.vbox()
        content.setPadding(dp(12), dp(12), dp(12), dp(20))
        scroll.addView(content)
        root.addView(scroll, lp(-1, 0, 1.0))
        win.cbs.append(lambda t, b: content.setPadding(dp(12), dp(12), dp(12), dp(20) + b))

        # ---- шапка ----
        head = card()
        row = ui.hbox()
        row.setGravity(16)
        cover_size = dp(92)
        cover_iv = ImageView(act)
        cover_iv.setScaleType(ImageScale.FIT_XY)
        row.addView(cover_iv, lp(cover_size, cover_size, r=14))
        col = ui.vbox()
        t_tv = text(title, 18, pal["text"], True)
        t_tv.setMaxLines(3)
        t_tv.setEllipsize(ui.TruncateAt.END)
        col.addView(t_tv)
        col.addView(text(artist, 14, pal["gray"], single=True), lp(-2, -2, t=3))
        len_tv = text("", 13, pal["gray"])
        col.addView(len_tv, lp(-2, -2, t=3))
        row.addView(col, lp(0, -2, 1.0))
        head.addView(row)
        content.addView(head, lp(-1, -2, b=12))

        # ---- цифры ----
        nums = card()
        nums.addView(text("Прослушано", 13, pal["gray"]))
        total_tv = text("0с", 32, pal["accent"], True)
        nums.addView(total_tv, lp(-2, -2, t=2))
        plays_tv = text("", 15, pal["text"], True)
        nums.addView(plays_tv, lp(-2, -2, t=10))
        dates_tv = text("", 13, pal["gray"])
        nums.addView(dates_tv, lp(-2, -2, t=6))
        content.addView(nums, lp(-1, -2, b=12))

        # ---- график ----
        chart_card = card()
        chart_w = screen_w - dp(24) - dp(32)
        chart = ChartBox(
            ui, pal, handler, chart_card,
            (("hour", "Часы"), ("wday", "Дни"), ("month", "Месяцы")),
            series, chart_w, dp(220), "hour",
        )
        content.addView(chart_card, lp(-1, -2, b=12))

        # ---- когда слушаешь чаще всего ----
        best = card()
        best.addView(text("Чаще всего ты слушаешь его", 13, pal["gray"]))
        best_tv = text("", 17, pal["text"], True)
        best.addView(best_tv, lp(-2, -2, t=6))
        content.addView(best, lp(-1, -2, b=4))

        # ───── live-обновление ─────
        def live_total():
            extra = max(0.0, store.added_track.get(key, 0.0) - st["added_at"])
            return float(st["ts"]["total"] or 0.0) + extra

        def update_numbers():
            t = st["ts"]
            total = live_total()
            duration = int(t["duration"] or 0)
            total_tv.setText(fmt_hms(total) if total > 0 else "0с")
            if duration > 0:
                plays_tv.setText("Прослушиваний: %d" % int(total // duration))
                len_tv.setText("длина %d:%02d" % (duration // 60, duration % 60))
            else:
                plays_tv.setText("Прослушиваний: — (длина трека пока неизвестна, включи его ещё раз)")
                len_tv.setText("")
            playing = self.now_playing == key
            first = t["first"] or (int(time.time()) if playing else None)
            last = int(time.time()) if playing else t["last"]
            if first:
                dates_tv.setText("Первый раз: %s · последний: %s" % (fmt_date(first), fmt_date(last)))
            else:
                dates_tv.setText("По этому треку пока нет данных")
            if total > 0:
                hod, wd, moy = arrays["hod"], arrays["wd"], arrays["moy"]
                th = max(range(24), key=lambda i: hod[i])
                tw = max(range(7), key=lambda i: wd[i])
                tm = max(range(12), key=lambda i: moy[i])
                best_tv.setText("в %02d:00–%02d:00\n%s\nв %s" % (th, (th + 1) % 24, WDAYS_ON[tw], MONTHS_IN[tm]))
            else:
                best_tv.setText("Пока нет данных")

        def update_cover():
            path = store.cover_path(artist, title)
            exists = os.path.exists(path)
            if st["cover"] == exists:
                return
            st["cover"] = exists
            bmp = None
            if exists:
                try:
                    src = BitmapFactory.decodeFile(path)
                    if src is not None:
                        bmp = round_bitmap(src, cover_size, float(dp(14)))
                except Exception as e:
                    log("cover load error: %r" % (e,))
            if bmp is None:
                bmp = placeholder_bitmap(cover_size, float(dp(14)), pal)
            cover_iv.setImageBitmap(bmp)

        def apply_ts(t2):
            if not st["alive"]:
                return
            st["ts"] = t2
            st["added_at"] = float(t2.get("added_at", 0.0))
            recompute(t2)
            update_numbers()
            update_cover()
            if not chart.running():
                chart.draw(1.0)

        def refresh():
            if st["busy"] or not st["alive"]:
                return
            st["busy"] = True

            def work():
                try:
                    t2 = store.track_stats(artist, title)
                    if not t2["duration"] and st["ts"]["duration"]:
                        t2["duration"] = st["ts"]["duration"]
                    run_on_ui_thread(lambda: apply_ts(t2))
                except Exception as e:
                    log("track refresh error: %r" % (e,))
                finally:
                    st["busy"] = False

            threading.Thread(target=work, daemon=True).start()

        def tick():
            if not st["alive"]:
                return
            st["ticks"] += 1
            update_numbers()
            if st["ticks"] % 3 == 0:
                refresh()
            handler.postDelayed(tick_runnable, 1000)

        tick_runnable = _Run(tick)

        def on_dismiss():
            st["alive"] = False
            chart.stop()
            try:
                handler.removeCallbacksAndMessages(None)
            except Exception:
                pass

        dlg.setOnDismissListener(_Dismiss(on_dismiss))
        update_numbers()
        update_cover()
        chart.draw(0.0)
        dlg.setContentView(root)
        dlg.show()

        win.bar.setAlpha(0.0)
        win.bar.animate().alpha(1.0).setDuration(250).start()
        for i, c in enumerate(cards):
            c.setAlpha(0.0)
            c.setTranslationY(float(dp(28)))
            c.animate().alpha(1.0).translationY(0.0).setStartDelay(90 * i + 80).setDuration(420) \
                .setInterpolator(Decelerate(2.0)).start()
        handler.postDelayed(_Run(chart.animate), 350)
        handler.postDelayed(tick_runnable, 1000)

    # ───────── окно: текст песни ─────────
    def _show_lyrics(self):
        act = self._activity()
        if act is None:
            toast("MusicStats: не найдено окно приложения")
            return

        ScrollView = jclass("android.widget.ScrollView")
        ImageView = jclass("android.widget.ImageView")
        ImageScale = jclass("android.widget.ImageView$ScaleType")
        Handler = jclass("android.os.Handler")
        Looper = jclass("android.os.Looper")
        Overshoot = jclass("android.view.animation.OvershootInterpolator")
        BitmapFactory = jclass("android.graphics.BitmapFactory")
        Typeface = jclass("android.graphics.Typeface")

        pal = get_palette()
        win = setup_window(act, pal, "Текст песни")
        ui, dlg, root = win.ui, win.dlg, win.root
        dp = ui.dp
        store = self.store
        metrics = act.getResources().getDisplayMetrics()
        screen_w, screen_h = int(metrics.widthPixels), int(metrics.heightPixels)
        handler = Handler(Looper.getMainLooper())

        state = {
            "alive": True, "key": None, "status": None, "idx": -2,
            "views": [], "times": [], "cover_sig": None, "sub": None, "ticks": 0,
        }

        # ---- шапка: обложка, название, исполнитель ----
        header = ui.vbox()
        header.setGravity(1)
        header.setPadding(dp(20), dp(8), dp(20), dp(10))
        cover_size = min(dp(170), int(screen_w * 0.5))
        cover_iv = ImageView(act)
        cover_iv.setScaleType(ImageScale.FIT_XY)
        header.addView(cover_iv, ui.lp(cover_size, cover_size, t=12, b=14))
        title_tv = ui.text("", 22, pal["text"], True)
        title_tv.setGravity(17)
        title_tv.setMaxLines(2)
        title_tv.setEllipsize(ui.TruncateAt.END)
        header.addView(title_tv, ui.lp(-1, -2))
        artist_tv = ui.text("", 15, pal["gray"], single=True)
        artist_tv.setGravity(17)
        header.addView(artist_tv, ui.lp(-1, -2, t=2))
        sub_tv = ui.text("", 12, pal["accent"])
        sub_tv.setGravity(17)
        header.addView(sub_tv, ui.lp(-1, -2, t=2))
        root.addView(header, ui.lp(-1, -2))

        # ---- бегущий текст ----
        scroll = ScrollView(act)
        scroll.setVerticalScrollBarEnabled(False)
        scroll.setVerticalFadingEdgeEnabled(True)
        scroll.setFadingEdgeLength(dp(48))
        lines_box = ui.vbox()
        lines_box.setPadding(dp(8), int(screen_h * 0.12), dp(8), int(screen_h * 0.3))
        scroll.addView(lines_box)
        root.addView(scroll, ui.lp(-1, 0, 1.0))
        win.cbs.append(lambda t, b: lines_box.setPadding(dp(8), int(screen_h * 0.12), dp(8), int(screen_h * 0.3) + b))

        def line_color(dist):
            if dist == 0:
                return pal["accent"]
            alpha = 225 if dist == 1 else (175 if dist == 2 else 120)
            return with_alpha(pal["text"], alpha)

        def update_cover():
            cur = self.cur
            path, exists = None, False
            if cur:
                path = store.cover_path(cur[0], cur[1])
                exists = os.path.exists(path)
                sig = (cur[0], cur[1], exists)
            else:
                sig = ("none",)
            if sig == state["cover_sig"]:
                return
            state["cover_sig"] = sig
            bmp = None
            if exists:
                try:
                    src = BitmapFactory.decodeFile(path)
                    if src is not None:
                        bmp = round_bitmap(src, cover_size, float(dp(18)))
                except Exception as e:
                    log("cover load error: %r" % (e,))
            if bmp is None:
                bmp = placeholder_bitmap(cover_size, float(dp(18)), pal)
            cover_iv.setImageBitmap(bmp)

        def add_message(msg):
            tv = ui.text(msg, 15, pal["gray"])
            tv.setGravity(17)
            tv.setPadding(dp(20), dp(30), dp(20), dp(30))
            lines_box.addView(tv, ui.lp(-1, -2))

        def render():
            cur = self.cur
            lines_box.removeAllViews()
            state["views"] = []
            state["times"] = []
            state["idx"] = -2
            scroll.scrollTo(0, 0)
            if not cur:
                state["status"] = "idle"
                add_message("Включи трек в Telegram, и здесь появится текст")
                return
            entry = self.get_lyrics(cur[0], cur[1], cur[2])
            st = entry.get("status")
            state["status"] = st
            if st == "loading":
                add_message("Ищу текст на LRCLIB…")
            elif st == "ok" and entry["lines"]:
                for _t, txt in entry["lines"]:
                    tv = ui.text(txt, 20, line_color(3))
                    tv.setGravity(17)
                    tv.setPadding(dp(16), dp(9), dp(16), dp(9))
                    lines_box.addView(tv, ui.lp(-1, -2))
                    state["views"].append(tv)
                state["times"] = entry["times"]
            elif st == "ok":
                tv = ui.text((entry["plain"] or "")[:4000], 17, pal["text"])
                tv.setGravity(17)
                tv.setPadding(dp(16), dp(10), dp(16), dp(10))
                lines_box.addView(tv, ui.lp(-1, -2))
            else:
                add_message("Текст для этого трека не найден")

        def set_track():
            cur = self.cur
            state["key"] = (cur[0], cur[1]) if cur else None
            state["cover_sig"] = None
            if cur:
                title_tv.setText(cur[1])
                artist_tv.setText(cur[0])
            else:
                title_tv.setText("Ничего не играет")
                artist_tv.setText("Включи трек в Telegram")
            update_cover()
            for v in (cover_iv, title_tv, artist_tv):
                v.setAlpha(0.0)
                v.animate().alpha(1.0).setDuration(380).start()
            cover_iv.setScaleX(0.88)
            cover_iv.setScaleY(0.88)
            cover_iv.animate().scaleX(1.0).scaleY(1.0).setDuration(450).setInterpolator(Overshoot(1.6)).start()
            render()

        def highlight(idx):
            if idx == state["idx"]:
                return
            views = state["views"]
            if not views:
                return
            if idx >= 0:
                tv = views[idx]
                if scroll.getHeight() == 0 or tv.getHeight() == 0:
                    return  # макет ещё не готов, повторим на следующем тике
            old = state["idx"]
            state["idx"] = idx
            for i, v in enumerate(views):
                dist = abs(i - idx) if idx >= 0 else 3
                v.setTextColor(jint(line_color(dist)))
                v.setTypeface(Typeface.DEFAULT, 1 if i == idx else 0)
            if 0 <= old < len(views):
                views[old].animate().scaleX(1.0).scaleY(1.0).setDuration(220).start()
            if idx >= 0:
                tv = views[idx]
                tv.animate().scaleX(1.06).scaleY(1.06).setDuration(260).start()
                target = tv.getTop() - (scroll.getHeight() - tv.getHeight()) // 2
                scroll.smoothScrollTo(0, max(0, int(target)))
            else:
                scroll.smoothScrollTo(0, 0)

        def tick():
            if not state["alive"]:
                return
            try:
                state["ticks"] += 1
                cur = self.cur
                key = (cur[0], cur[1]) if cur else None
                if key != state["key"]:
                    set_track()
                elif cur:
                    entry = self.get_lyrics(cur[0], cur[1], cur[2])
                    if entry.get("status") != state["status"]:
                        render()
                if state["ticks"] % 3 == 0:
                    update_cover()
                    sub = "⏸ На паузе" if (cur and self.paused) else ""
                    if sub != state["sub"]:
                        state["sub"] = sub
                        sub_tv.setText(sub)
                if state["views"]:
                    pos = self.current_position()
                    if pos is not None:
                        idx = bisect.bisect_right(state["times"], pos + 0.15) - 1
                        highlight(idx)
            except Exception as e:
                log("lyrics window tick error: %r" % (e,))
            handler.postDelayed(runnable, 300)

        runnable = _Run(tick)

        def on_dismiss():
            state["alive"] = False
            try:
                handler.removeCallbacksAndMessages(None)
            except Exception:
                pass

        dlg.setOnDismissListener(_Dismiss(on_dismiss))

        set_track()
        dlg.setContentView(root)
        dlg.show()

        win.bar.setAlpha(0.0)
        win.bar.animate().alpha(1.0).setDuration(250).start()
        handler.postDelayed(runnable, 300)

    # ───────── разбор по трекам: столбец графика или исполнитель ─────────
    def open_bucket_breakdown(self, buckets, index, origin=None):
        def work():
            try:
                rows = self.store.tracks_for_bucket(buckets[index])
                run_on_ui_thread(lambda: self._safe(self._show_breakdown, "bucket", buckets, index, None, rows, origin))
            except Exception as e:
                log("breakdown error: %r" % (e,))
                toast("MusicStats: ошибка данных: %r" % (e,))

        threading.Thread(target=work, daemon=True).start()

    def open_artist_breakdown(self, artist):
        def work():
            try:
                rows, added = self.store.artist_snapshot(artist)
                run_on_ui_thread(lambda: self._safe(self._show_breakdown, "artist", None, 0, artist, rows, None, added))
            except Exception as e:
                log("artist breakdown error: %r" % (e,))
                toast("MusicStats: ошибка данных: %r" % (e,))

        threading.Thread(target=work, daemon=True).start()

    def _show_breakdown(self, kind, buckets, index, artist, rows, origin, added_at=0.0):
        act = self._activity()
        if act is None:
            toast("MusicStats: не найдено окно приложения")
            return

        ScrollView = jclass("android.widget.ScrollView")
        ImageView = jclass("android.widget.ImageView")
        ImageScale = jclass("android.widget.ImageView$ScaleType")
        Handler = jclass("android.os.Handler")
        Looper = jclass("android.os.Looper")
        Decelerate = jclass("android.view.animation.DecelerateInterpolator")
        BitmapFactory = jclass("android.graphics.BitmapFactory")
        ColorDrawable = jclass("android.graphics.drawable.ColorDrawable")

        is_artist = kind == "artist"
        pal = get_palette()
        win = setup_window(act, pal, ("статистика " + artist) if is_artist else "Статистика")
        ui, dlg, root = win.ui, win.dlg, win.root
        dp, lp, text = ui.dp, ui.lp, ui.text
        store = self.store
        handler = Handler(Looper.getMainLooper())
        st = {"alive": True, "index": index, "gen": 0, "rows": rows, "added_at": float(added_at),
              "ticks": 0, "busy": False}
        covers = {}

        if origin is not None:  # прозрачное окно: поверх видна статистика, пока столбец «увеличивается»
            try:
                dlg.getWindow().setBackgroundDrawable(ColorDrawable(jint(0)))
            except Exception:
                pass

        scroll = ScrollView(act)
        scroll.setVerticalScrollBarEnabled(False)
        content = ui.vbox()
        content.setPadding(dp(12), dp(12), dp(12), dp(20))
        scroll.addView(content)
        root.addView(scroll, lp(-1, 0, 1.0))
        win.cbs.append(lambda t, b: content.setPadding(dp(12), dp(12), dp(12), dp(20) + b))

        # ---- шапка: время за столбец и стрелки ----
        head = ui.hbox()
        head.setGravity(16)
        left_arrow = text("‹", 34, pal["accent"], True)
        left_arrow.setPadding(dp(10), 0, dp(14), dp(4))
        right_arrow = text("›", 34, pal["accent"], True)
        right_arrow.setPadding(dp(14), 0, dp(10), dp(4))
        mid = ui.vbox()
        label_tv = text("", 17, pal["text"], True)
        label_tv.setGravity(17)
        total_tv = text("", 30, pal["accent"], True)
        total_tv.setGravity(17)
        sub_tv = text("", 13, pal["gray"])
        sub_tv.setGravity(17)
        mid.addView(label_tv, lp(-1, -2))
        mid.addView(total_tv, lp(-1, -2, t=2))
        mid.addView(sub_tv, lp(-1, -2, t=2))
        if not is_artist:
            head.addView(left_arrow, lp(-2, -2))
        head.addView(mid, lp(0, -2, 1.0))
        if not is_artist:
            head.addView(right_arrow, lp(-2, -2))
        content.addView(head, lp(-1, -2, b=8))
        body = ui.vbox()
        content.addView(body, lp(-1, -2))

        def cover(a, t, size, radius):
            key = (a, t, size)
            if key in covers:
                return covers[key]
            bmp = None
            path = store.cover_path(a, t)
            if os.path.exists(path):
                try:
                    src = BitmapFactory.decodeFile(path)
                    if src is not None:
                        bmp = round_bitmap(src, size, float(radius))
                except Exception as e:
                    log("cover load error: %r" % (e,))
            if bmp is None:
                bmp = placeholder_bitmap(size, float(radius), pal)
            covers[key] = bmp
            return bmp

        def list_row(box, rank, a, t, secs):
            row = ui.hbox()
            row.setGravity(16)
            row.setPadding(0, dp(7), 0, dp(7))
            rk = text(str(rank), 14, pal["accent"], True)
            rk.setMinWidth(dp(22))
            row.addView(rk, lp(-2, -2))
            iv = ImageView(act)
            iv.setScaleType(ImageScale.FIT_XY)
            iv.setImageBitmap(cover(a, t, dp(52), dp(10)))
            row.addView(iv, lp(dp(52), dp(52), l=2, r=12))
            col = ui.vbox()
            col.addView(text(t, 15, pal["text"], True, single=True))
            col.addView(text(a, 12.5, pal["gray"], single=True))
            row.addView(col, lp(0, -2, 1.0, r=8))
            row.addView(text(fmt_smart(secs), 13, pal["gray"], True), lp(-2, -2))
            row.setOnClickListener(_Click(lambda a=a, t=t: self.open_track_stats(a, t)))
            box.addView(row)

        def seg_color(k):
            return mix(pal["accent"], pal["page"], min(0.78, 0.2 * k))

        def render(rows_, label):
            body.removeAllViews()
            total = sum(r[2] for r in rows_)
            label_tv.setText(label)
            total_tv.setText((fmt_hms if is_artist else fmt_smart)(total) if rows_ else "—")
            sub_tv.setText("треков: %d" % len(rows_))
            if not rows_:
                m = text("В это время ничего не слушал", 15, pal["gray"])
                m.setGravity(17)
                m.setPadding(0, dp(40), 0, dp(40))
                body.addView(m, lp(-1, -2))
                return None

            segs = build_segments(rows_, not is_artist)
            H = dp(300)
            weights = [max(sg["share"], 0.14) for sg in segs]  # крошечные части слегка подтянуты, чтобы влезла подпись
            bar_col = ui.vbox()
            bar_col.setWeightSum(float(sum(weights)))
            labels_col = ui.vbox()
            labels_col.setWeightSum(float(sum(weights)))
            for k, sg in enumerate(segs):
                seg = View(act)
                seg.setBackground(ui.rounded(seg_color(k), 8))
                bar_col.addView(seg, lp(-1, 0, weights[k], b=3 if k < len(segs) - 1 else 0))
                lab = ui.vbox()
                lab.setGravity(16)
                lab.addView(text(sg["name"], 17 if sg["first"] else 15, pal["text"], True, single=True))
                lab.addView(text(sg["sub"], 12.5, pal["gray"], single=True))
                labels_col.addView(lab, lp(-1, 0, weights[k]))
            section = ui.hbox()
            section.addView(bar_col, lp(dp(92), H, r=14))
            section.addView(labels_col, lp(0, H, 1.0))
            body.addView(section, lp(-1, H, t=6, b=14))

            limit = 30 if is_artist else 8
            list_card = ui.vbox()
            list_card.setBackground(ui.rounded(pal["card"], 16))
            list_card.setPadding(dp(16), dp(12), dp(16), dp(12))
            title = "Все треки исполнителя" if is_artist else "Топ %d треков" % min(limit, len(rows_))
            list_card.addView(text(title, 17, pal["text"], True), lp(-2, -2, b=4))
            for k, (a, t, secs) in enumerate(rows_[:limit], 1):
                list_row(list_card, k, a, t, secs)
            body.addView(list_card, lp(-1, -2))
            return bar_col, labels_col, list_card

        def update_arrows():
            if is_artist:
                return
            left_arrow.setAlpha(0.3 if st["index"] <= 0 else 1.0)
            right_arrow.setAlpha(0.3 if st["index"] >= len(buckets) - 1 else 1.0)

        def zoom_bar(bar_col):
            """Столбец «вырастает» из позиции на графике и уезжает к левому краю."""
            ox0, oy0, ox1, oy1 = origin
            loc = jarray(jint)([0, 0])
            bar_col.getLocationOnScreen(loc)
            fx, fy = float(loc[0]), float(loc[1])
            fw, fh = float(bar_col.getWidth()), float(bar_col.getHeight())
            if fw <= 0 or fh <= 0:
                bar_col.setAlpha(1.0)
                return
            bar_col.setPivotX(0.0)
            bar_col.setPivotY(0.0)
            bar_col.setScaleX(max(0.02, (ox1 - ox0) / fw))
            bar_col.setScaleY(max(0.02, (oy1 - oy0) / fh))
            bar_col.setTranslationX(ox0 - fx)
            bar_col.setTranslationY(oy0 - fy)
            bar_col.setAlpha(1.0)
            bar_col.animate().scaleX(1.0).scaleY(1.0).translationX(0.0).translationY(0.0) \
                .setDuration(560).setInterpolator(Decelerate(2.2)).start()

        def animate_in(parts):
            bar_col, labels_col, list_card = parts
            for v, delay in ((labels_col, 300), (list_card, 420)):
                v.setAlpha(0.0)
                v.setTranslationY(float(dp(20)))
                v.animate().alpha(1.0).translationY(0.0).setStartDelay(delay).setDuration(380) \
                    .setInterpolator(Decelerate(2.0)).start()
            if origin is None:
                return
            bar_col.setAlpha(0.0)

            def go():
                try:
                    zoom_bar(bar_col)
                except Exception as e:
                    log("zoom error: %r" % (e,))
                    bar_col.setAlpha(1.0)

            handler.postDelayed(_Run(go), 70)

        def go_to(delta):
            if is_artist:
                return
            j = st["index"] + delta
            if not (0 <= j < len(buckets)):
                return
            st["index"] = j
            st["gen"] += 1
            gen = st["gen"]
            direction = 1 if delta > 0 else -1

            def work():
                try:
                    r = store.tracks_for_bucket(buckets[j])
                    run_on_ui_thread(lambda: swap(gen, j, r, direction))
                except Exception as e:
                    log("breakdown switch error: %r" % (e,))

            threading.Thread(target=work, daemon=True).start()

        def swap(gen, j, r, direction):
            if gen != st["gen"] or not st["alive"]:
                return
            dx = float(dp(60) * direction)

            def apply():
                render(r, buckets[j]["label"])
                update_arrows()
                body.setTranslationX(dx)
                body.setAlpha(0.0)
                body.animate().translationX(0.0).alpha(1.0).setDuration(240) \
                    .setInterpolator(Decelerate(2.0)).start()

            body.animate().translationX(-dx).alpha(0.0).setDuration(140).withEndAction(_Run(apply)).start()

        left_arrow.setOnClickListener(_Click(lambda: go_to(-1)))
        right_arrow.setOnClickListener(_Click(lambda: go_to(1)))

        def on_dismiss():
            st["alive"] = False
            try:
                handler.removeCallbacksAndMessages(None)
            except Exception:
                pass

        dlg.setOnDismissListener(_Dismiss(on_dismiss))

        def artist_refresh():
            if st["busy"] or not st["alive"]:
                return
            st["busy"] = True

            def work():
                try:
                    r, a = store.artist_snapshot(artist)
                    run_on_ui_thread(lambda: artist_apply(r, a))
                except Exception as e:
                    log("artist refresh error: %r" % (e,))
                finally:
                    st["busy"] = False

            threading.Thread(target=work, daemon=True).start()

        def artist_apply(r, a):
            if not st["alive"]:
                return
            st["rows"], st["added_at"] = r, float(a)
            render(r, artist)

        def artist_tick():
            if not st["alive"]:
                return
            st["ticks"] += 1
            delta = max(0.0, store.added_artist.get(artist, 0.0) - st["added_at"])
            base = sum(x[2] for x in st["rows"])
            total_tv.setText(fmt_hms(base + delta))
            if st["ticks"] % 3 == 0:
                artist_refresh()
            handler.postDelayed(tick_runnable, 1000)

        tick_runnable = _Run(artist_tick)

        parts = render(rows, artist if is_artist else buckets[index]["label"])
        update_arrows()
        dlg.setContentView(root)
        dlg.show()

        win.bar.setAlpha(0.0)
        win.bar.animate().alpha(1.0).setDuration(250).start()
        if origin is not None:
            root.setAlpha(0.0)
            root.animate().alpha(1.0).setDuration(220).start()
        if parts is not None:
            animate_in(parts)
        if is_artist:
            handler.postDelayed(tick_runnable, 1000)
