import threading
try:
    from client_utils import run_on_queue, GLOBAL_QUEUE
    def _run_bg(task):
        try:
            run_on_queue(task, GLOBAL_QUEUE)
        except TypeError:
            try:
                run_on_queue(task)
            except Exception:
                threading.Thread(target=task, daemon=True).start()
except Exception:
    def _run_bg(task):
        threading.Thread(target=task, daemon=True).start()

import base64
import zlib
from base_plugin import BasePlugin
from java import jclass
from java.nio import ByteBuffer
from dalvik.system import InMemoryDexClassLoader
from org.telegram.messenger import ApplicationLoader

__id__ = "jpeg_quality"
__name__ = "JPEG Quality Slider"
__description__ = "Добавляет слайдер регулировки качества JPEG в ползунки редактирования фото с real-time предпросмотром"
__author__ = "@dekma0091 && @DefinitelyNotDekma"
__version__ = "2.2"
__icon__ = "pixelcamera/10"
__min_version__ = "12.5.1"

ENTRY_CLASS = "ni.dekma.jpeg_quality.JpegQualityBridge"


class NativeBridge:
    def __init__(self, entry_class_name):
        self.entry_class_name = entry_class_name
        self.target_class = None
        self.is_active = False
        self.is_loading = False
        self.is_stopped = False
        self._lock = threading.Lock()

    def start_async(self):
        _run_bg(self.start)

    def start(self):
        with self._lock:
            if self.is_active or self.is_loading or self.is_stopped:
                return
            self.is_loading = True
        try:
            if self.target_class is None:
                ctx = ApplicationLoader.applicationContext
                if ctx is None:
                    raise RuntimeError("Application context is unavailable")
                if not _DEX_BASE64:
                    raise RuntimeError("Payload data is missing")
                dex_data = base64.b64decode(_DEX_BASE64)
                try:
                    dex_data = zlib.decompress(dex_data)
                except Exception:
                    pass
                dex_buffer = ByteBuffer.wrap(dex_data)
                class_loader = InMemoryDexClassLoader(
                    dex_buffer,
                    ctx.getClassLoader(),
                )
                self.target_class = class_loader.loadClass(self.entry_class_name)
            self._invoke_static("attach")
            with self._lock:
                if self.is_stopped:
                    try:
                        self._invoke_static("detach")
                    except Exception:
                        pass
                    self.is_active = False
                else:
                    self.is_active = True
                self.is_loading = False
        except Exception:
            with self._lock:
                self.is_active = False
                self.is_loading = False
            try:
                self._invoke_static("detach")
            except Exception:
                pass
            raise

    def stop(self):
        with self._lock:
            self.is_stopped = True
            if self.target_class is None or not self.is_active:
                return
            self.is_active = False
        try:
            self._invoke_static("detach")
        except Exception:
            pass

    def _invoke_static(self, method_name, *args):
        if self.target_class is None:
            raise RuntimeError("Target class reference is null")
        methods = []
        for method in self.target_class.getDeclaredMethods():
            if str(method.getName()) == method_name and len(method.getParameterTypes()) == len(args):
                method.setAccessible(True)
                methods.append(method)
        if not methods:
            raise RuntimeError(f"Static method not found: {method_name}")
        if len(methods) > 1:
            raise RuntimeError(f"Multiple method signature matches: {method_name}")
        return methods[0].invoke(None, *args)


class JpegQualityPlugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self.bridge = NativeBridge(ENTRY_CLASS)

    def on_plugin_load(self):
        self.bridge.start_async()

    def on_plugin_unload(self):
        try:
            self.bridge.stop()
        except Exception as err:
            self.log(f"Unload error: {err}")


_DEX_BASE64 = ""
