def _lang() -> str:
    codes = []
    try:
        info = LocaleController.getInstance().getCurrentLocaleInfo()
        for name in ("pluralLangCode", "baseLangCode", "shortName"):
            v = getattr(info, name, None)
            if v:
                codes.append(str(v).lower())
    except Exception:
        pass
    try:
        codes.append(str(LocaleController.getLocaleStringIso639()).lower())
    except Exception:
        pass
    for c in codes:
        if c.startswith("uk"):
            return "uk"
        if c.startswith("ru"):
            return "ru"
        if c.startswith("en"):
            return "en"
    return "en"


def _t(key: str) -> Any:
    return STRINGS.get(_lang(), STRINGS["en"]).get(key) or STRINGS["en"][key]


def _headers(extra: Optional[dict] = None) -> dict:
    h = {"User-Agent": UA, "Accept-Language": "en-US,en;q=0.9"}
    if extra:
        h.update(extra)
    return h


def _err(e: Exception) -> str:
    code = getattr(getattr(e, "response", None), "status_code", None)
    if code:
        return "HTTP %s" % code
    return ("%s %s" % (type(e).__name__, e)).strip()[:60]


def _key(url: str) -> str:
    return url.rsplit("/", 1)[-1].split(".")[0].lower()


def _sized(url: str, size: str) -> str:
    return SIZE_RE.sub("i.pinimg.com/%s/" % size, url)


def _pin(url: str, w: int = 0, h: int = 0, thumb: Optional[str] = None,
         small: Optional[str] = None, exact: bool = False) -> dict:
    if not w or not h:
        w, h = 736, 981
    if not exact:
        thumb, small, url = _sized(url, "474x"), _sized(url, "236x"), _sized(url, "736x")
    thumb = thumb or url
    return {"thumb": thumb, "small": small or thumb, "url": url, "w": int(w), "h": int(h), "key": _key(url)}


def _pin_from_item(item: Any) -> Optional[dict]:
    if not isinstance(item, dict):
        return None
    if item.get("type") not in (None, "pin"):
        return None
    if item.get("is_promoted") or item.get("is_ad") or item.get("promoter"):
        return None
    images = item.get("images")
    if not isinstance(images, dict):
        return None
    main = next((images[k] for k in SIZE_KEYS
                 if isinstance(images.get(k), dict) and images[k].get("url")), None)
    if main is None or not str(main["url"]).startswith(PIN_HOST):
        return None
    w, h = int(main.get("width") or 0), int(main.get("height") or 0)
    if w and h and min(w, h) < MIN_SIDE:
        return None
    thumb = next((images[k]["url"] for k in THUMB_KEYS
                  if isinstance(images.get(k), dict) and images[k].get("url")), None)
    small = (images.get("236x") or {}).get("url") if isinstance(images.get("236x"), dict) else None
    return _pin(main["url"], w, h, thumb=thumb, small=small, exact=True)


def _walk_pins(obj: Any, out: List[dict], depth: int = 0):
    if depth > 14 or len(out) >= BATCH * 2:
        return
    if isinstance(obj, dict):
        p = _pin_from_item(obj)
        if p:
            out.append(p)
            return
        for v in obj.values():
            _walk_pins(v, out, depth + 1)
    elif isinstance(obj, list):
        for v in obj:
            _walk_pins(v, out, depth + 1)


def _parse_api_json(payload: Any) -> List[dict]:
    results = (((payload or {}).get("resource_response") or {}).get("data") or {}).get("results") or []
    pins: List[dict] = []
    _walk_pins(results, pins)
    return pins


def _api_bookmark(payload: Any) -> Optional[str]:
    payload = payload or {}
    b = (payload.get("resource_response") or {}).get("bookmark")
    if not b:
        marks = ((payload.get("resource") or {}).get("options") or {}).get("bookmarks")
        if isinstance(marks, list) and marks:
            b = marks[0]
    return str(b) if b else None


def _is_end(bookmark: Optional[str]) -> bool:
    return not bookmark or bookmark.startswith("-end-")


def _parse_html_json(html: str) -> List[dict]:
    pins: List[dict] = []
    for _id, body in SCRIPT_RE.findall(html):
        try:
            _walk_pins(json.loads(body), pins)
        except Exception:
            continue
    return pins


def _parse_bing(html: str) -> List[dict]:
    pins, seen = [], set()
    for m in BING_M_RE.finditer(html):
        raw = m.group(1) or m.group(2)
        try:
            data = json.loads(htmllib.unescape(raw))
        except Exception:
            continue
        murl = str(data.get("murl") or "")
        if not murl.startswith(PIN_HOST) or not SIZE_RE.search(murl):
            continue
        k = _key(murl)
        if k not in seen:
            seen.add(k)
            pins.append(_pin(murl))
    return pins


def _from_api(session: requests.Session, query: str, app_version: str,
              bookmark: Optional[str] = None) -> Tuple[List[dict], Optional[str]]:
    csrf = session.cookies.get("csrftoken") or ""
    source_url = "/search/pins/?q=" + quote(query) + "&rs=typed"
    options = {
        "query": query, "scope": "pins", "page_size": BATCH, "rs": "typed",
        "source_url": source_url, "redux_normalize_feed": True,
    }
    if bookmark:
        options["bookmarks"] = [bookmark]
    r = session.get(
        BASE + "/resource/BaseSearchResource/get/",
        params={
            "source_url": source_url,
            "data": json.dumps({"options": options, "context": {}}, separators=(",", ":")),
            "_": str(int(time.time() * 1000)),
        },
        headers=_headers({
            "Accept": "application/json, text/javascript, */*, q=0.01",
            "X-Requested-With": "XMLHttpRequest",
            "X-APP-VERSION": app_version or "0",
            "X-Pinterest-AppState": "active",
            "X-Pinterest-Source-Url": source_url,
            "X-Pinterest-PWS-Handler": "www/search/[scope].js",
            "X-CSRFToken": csrf,
            "Referer": BASE + source_url,
        }),
        timeout=TIMEOUT,
    )
    r.raise_for_status()
    payload = r.json()
    return _parse_api_json(payload), _api_bookmark(payload)


def _from_bing(session: requests.Session, query: str, first: int = 1) -> Tuple[List[dict], int]:
    r = session.get(
        "https://www.bing.com/images/search",
        params={"q": "%s site:pinterest.com" % query, "first": str(first), "count": "50",
                "adlt": "off", "mkt": "en-US"},
        headers=_headers({"Accept": "text/html,application/xhtml+xml"}),
        timeout=TIMEOUT,
    )
    r.raise_for_status()
    return _parse_bing(r.text), len(BING_M_RE.findall(r.text))


class Searcher:
    def __init__(self, query: str):
        self.query = query
        self.lock = threading.Lock()
        self.pins: List[dict] = []
        self.exhausted = False
        self.source = ""
        self.errors: List[str] = []
        self.ts = time.time()
        self._seen = set()
        self._session: Optional[requests.Session] = None
        self._app_version = ""
        self._bookmark: Optional[str] = None
        self._bing_first = 1
        self._started = False
        self._fails = 0

    def ensure(self, count: int) -> "Searcher":
        with self.lock:
            tries = 0
            while len(self.pins) < count and not self.exhausted and tries < 6:
                tries += 1
                try:
                    self._fetch_more()
                    self._fails = 0
                except Exception as e:
                    self.errors.append(_err(e))
                    self._fails += 1
                    if self._fails >= 2:
                        self.exhausted = True
                    break
            if len(self.pins) >= MAX_PINS:
                self.exhausted = True
        return self

    def _add(self, pins: List[dict]) -> int:
        n = 0
        for p in pins:
            if p["key"] not in self._seen and len(self.pins) < MAX_PINS:
                self._seen.add(p["key"])
                self.pins.append(p)
                n += 1
        return n

    def _fetch_more(self):
        if self._session is None:
            self._session = requests.Session()
        if not self._started:
            self._started = True
            self._first_batch()
            return
        if self.source == "api":
            if _is_end(self._bookmark):
                self._switch_to_bing()
                return
            pins, bookmark = _from_api(self._session, self.query, self._app_version, self._bookmark)
            self._bookmark = bookmark
            if self._add(pins) == 0:
                self._switch_to_bing()
        elif self.source == "bing":
            pins, raw = _from_bing(self._session, self.query, self._bing_first)
            self._bing_first += max(raw, 1)
            if self._add(pins) == 0:
                self.exhausted = True
        else:
            self._switch_to_bing()

    def _switch_to_bing(self):
        self.source = "bing"
        self._bing_first = 1

    def _first_batch(self):
        s = self._session
        html = ""
        try:
            r = s.get(
                BASE + "/search/pins/?q=" + quote(self.query) + "&rs=typed",
                headers=_headers({"Accept": "text/html,application/xhtml+xml"}),
                timeout=TIMEOUT,
            )
            r.raise_for_status()
            html = r.text
            m = APPVER_RE.search(html)
            self._app_version = m.group(1) if m else ""
        except Exception as e:
            self.errors.append("page: %s" % _err(e))

        try:
            pins, bookmark = _from_api(s, self.query, self._app_version, None)
            if self._add(pins):
                self.source = "api"
                self._bookmark = bookmark
                return
            self.errors.append("api: 0")
        except Exception as e:
            self.errors.append("api: %s" % _err(e))

        if html and self._add(_parse_html_json(html)):
            self.source = "page"
            return
        if html:
            self.errors.append("page: 0")

        try:
            pins, raw = _from_bing(s, self.query, 1)
            self._bing_first = 1 + max(raw, 1)
            if self._add(pins):
                self.source = "bing"
                return
            self.errors.append("bing: 0")
        except Exception as e:
            self.errors.append("bing: %s" % _err(e))
        self.exhausted = True


_searchers: Dict[str, Searcher] = {}
_searchers_lock = threading.Lock()


def get_searcher(query: str) -> Searcher:
    key = query.strip().lower()
    now = time.time()
    with _searchers_lock:
        s = _searchers.get(key)
        if s is None or now - s.ts > CACHE_TTL or (s.exhausted and not s.pins):
            s = Searcher(query)
            _searchers[key] = s
            if len(_searchers) > 20:
                _searchers.pop(min(_searchers, key=lambda k: _searchers[k].ts), None)
        s.ts = now
        return s


def search_task(query: str, count: int) -> Searcher:
    return get_searcher(query).ensure(count)


def _web_doc(url: str, w: int, h: int):
    d = TLRPC.TL_webDocument()
    d.url = url
    d.size = 0
    d.mime_type = "image/jpeg"
    a = TLRPC.TL_documentAttributeImageSize()
    a.w = w
    a.h = h
    d.attributes.add(a)
    return d


def _make_result(p: dict, scale: float, small: bool):
    w = max(1, int(round(p["w"] * scale)))
    r = TLRPC.TL_botInlineResult()
    r.flags = 0
    r.id = ID_PREFIX + p["key"]
    r.type = "photo"
    r.thumb = _web_doc(p["small"] if small else p["thumb"], w, p["h"])
    r.content = _web_doc(p["url"], w, p["h"])
    msg = TLRPC.TL_botInlineMessageMediaAuto()
    msg.message = ""
    r.send_message = msg
    return r


def build_response(chunk: List[dict], next_offset: str, scale: float = 1.0, small: bool = False):
    res = TLRPC.TL_messages_botResults()
    res.gallery = True
    res.flags = 1
    res.query_id = random.getrandbits(62)
    res.cache_time = 0
    if next_offset:
        res.next_offset = next_offset
        res.flags |= 2
    else:
        res.next_offset = ""
    for p in chunk:
        res.results.add(_make_result(p, scale, small))
    return res


def _tmp_dir() -> str:
    d = os.path.join(tempfile.gettempdir(), "pinterest_pic")
    os.makedirs(d, exist_ok=True)
    return d


def _cleanup_tmp():
    try:
        d, now = _tmp_dir(), time.time()
        for n in os.listdir(d):
            p = os.path.join(d, n)
            try:
                if now - os.path.getmtime(p) > TMP_TTL:
                    os.remove(p)
            except OSError:
                pass
    except Exception:
        pass


def download_image(url: str, original: bool) -> Optional[str]:
    candidates = []
    if original:
        candidates.append(_sized(url, "originals"))
    candidates += [url, _sized(url, "736x")]
    tried = set()
    for cand in candidates:
        if cand in tried:
            continue
        tried.add(cand)
        try:
            r = requests.get(
                cand,
                headers=_headers({"Referer": BASE + "/", "Accept": "image/*,*/*;q=0.8"}),
                timeout=TIMEOUT,
            )
            if r.status_code != 200 or len(r.content) < 2048:
                continue
            img = Image.open(io.BytesIO(r.content))
            if min(img.size) < 100:
                continue
            img.thumbnail((4096, 4096))
            if img.mode != "RGB":
                img = img.convert("RGB")
            path = os.path.join(_tmp_dir(), "pin_%d_%d.jpg" % (int(time.time() * 1000), random.randint(0, 9999)))
            img.save(path, "JPEG", quality=95)
            return path
        except Exception:
            continue
    return None


def _find_field(obj: Any, name: str):
    cls = obj.getClass()
    while cls is not None:
        try:
            f = cls.getDeclaredField(name)
            f.setAccessible(True)
            return f
        except Exception:
            cls = cls.getSuperclass()
    return None


def _get_field(obj: Any, name: str, default: Any = None) -> Any:
    try:
        f = _find_field(obj, name)
        return f.get(obj) if f is not None else default
    except Exception:
        return default


def _web_file_url(web_file: Any) -> str:
    try:
        return str(web_file.url or "")
    except Exception:
        pass
    return str(_get_field(web_file, "url", "") or "")


def _cell_result(cell: Any):
    for name in ("getBotInlineResult", "getResult"):
        try:
            r = getattr(cell, name)()
            if r is not None:
                return r
        except Exception:
            continue
    return None


def _usernames(user: Any) -> List[str]:
    names = []
    try:
        if getattr(user, "username", None):
            names.append(str(user.username).lower())
    except Exception:
        pass
    try:
        for u in (getattr(user, "usernames", None) or []):
            n = getattr(u, "username", None)
            if n:
                names.append(str(n).lower())
    except Exception:
        pass
    return names


def _is_pic_user(user: Any) -> bool:
    return user is not None and REAL_BOT in _usernames(user)


_smoothed = set()


def _smooth_cell(cell: Any):
    try:
        k = int(System.identityHashCode(cell))
    except Exception:
        return
    if k in _smoothed:
        return
    recv = _get_field(cell, "linkImageView")
    if recv is None:
        return
    for method, value, field, setter in (
        ("setCrossfadeDuration", jint(FADE_MS), "crossfadeDuration", "setInt"),
        ("setForceCrossfade", True, "forceCrossfade", "setBoolean"),
    ):
        try:
            getattr(recv, method)(value)
        except Exception:
            try:
                f = _find_field(recv, field)
                if f is not None:
                    getattr(f, setter)(recv, value)
            except Exception:
                pass
    if len(_smoothed) > 300:
        _smoothed.clear()
    _smoothed.add(k)


class _Hook(MethodHook):
    method = ""
    phase = "before"

    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin

    def _run(self, param):
        self.plugin.guard(self.method, getattr(self.plugin, self.method), param)

    def before_hooked_method(self, param):
        if self.phase == "before":
            self._run(param)

    def after_hooked_method(self, param):
        if self.phase == "after":
            self._run(param)


class _ImageLocationHook(MethodHook):
    def before_hooked_method(self, param):
        try:
            args = param.args
            if args is None or len(args) < 1 or args[0] is None:
                return
            url = _web_file_url(args[0])
            if url.startswith(PIN_HOST):
                param.setResult(ImageLocation.getForPath(url))
        except Exception:
            pass


class _SendHook(_Hook):
    method = "on_send_bot_result"


class _AliasHook(_Hook):
    method = "rewrite_alias"

    def after_hooked_method(self, param):
        if not self.plugin.users_hooked:
            self.plugin.guard("inject_after", self.plugin.inject_after, param)


class _CacheHook(_Hook):
    method = "skip_cache"


class _TileHook(_Hook):
    method = "resize_tile"


class _LinkHook(_Hook):
    method = "fade_tile"
    phase = "after"


class _UsersHook(_Hook):
    method = "inject_plate"


class _CellHook(_Hook):
    method = "style_cell"
    phase = "after"


class PinterestPicPlugin(BasePlugin):
    def on_plugin_load(self):
        self._pool = ThreadPoolExecutor(max_workers=4)
        self._pending: Dict[int, tuple] = {}
        self._lock = threading.Lock()
        self._prefix: Optional[str] = None
        self._via_alias = False
        self._plate_user = None
        self._reported = set()
        self._failed: List[str] = []
        self.users_hooked = False

        self.add_hook(REQ_NAME)

        self._install("org.telegram.messenger.ImageLocation", "getForWebFile", _ImageLocationHook())
        self._install("org.telegram.messenger.SendMessagesHelper", "prepareSendingBotContextResult", _SendHook(self))
        self._install("org.telegram.ui.Adapters.MentionsAdapter", "searchUsernameOrHashtag", _AliasHook(self))
        self._install("org.telegram.ui.Adapters.MentionsAdapter", "searchForContextBotResults", _CacheHook(self))
        self._install("org.telegram.ui.Cells.ContextLinkCell", "onMeasure", _TileHook(self))
        self._install("org.telegram.ui.Cells.ContextLinkCell", "setLink", _LinkHook(self))
        self.users_hooked = self._install("org.telegram.ui.Adapters.MentionsAdapter", "showUsersResult", _UsersHook(self))
        self._install("org.telegram.ui.Cells.MentionCell", "setUser", _CellHook(self))

        if self._failed:
            BulletinHelper.show_error(_t("err_hooks") % ", ".join(self._failed))

    def _install(self, class_name: str, method: str, handler) -> bool:
        label = "%s.%s" % (class_name.rsplit(".", 1)[-1], method)
        try:
            cls = find_class(class_name)
            if cls is None:
                self.logger.error("class not found: %s" % class_name)
                self._failed.append(label)
                return False
            try:
                if self.hook_all_methods(cls, method, handler):
                    return True
            except Exception:
                self.logger.exception("hook_all_methods failed: %s" % label)
            n = 0
            for m in cls.getDeclaredMethods():
                if str(m.getName()) == method:
                    m.setAccessible(True)
                    if self.hook_method(m, handler):
                        n += 1
            if n:
                return True
        except Exception:
            self.logger.exception("hook failed: %s" % label)
        self.logger.error("not hooked: %s" % label)
        self._failed.append(label)
        return False

    def guard(self, name: str, fn, *args):
        try:
            return fn(*args)
        except Exception as e:
            self.logger.exception("error in %s" % name)
            if name not in self._reported:
                self._reported.add(name)
                try:
                    BulletinHelper.show_error(_t("err_runtime") % (name, ("%s: %s" % (type(e).__name__, e))[:80]))
                except Exception:
                    pass
            return None

    def on_plugin_unload(self):
        try:
            self._pool.shutdown(wait=False)
        except Exception:
            pass

    def create_settings(self) -> List[Any]:
        return [
            Header(text="Pinterest Pic"),
            Input(
                key="alias",
                text=_t("alias_title"),
                default=REAL_BOT,
                subtext=_t("alias_sub"),
                icon="msg_mention",
            ),
            Selector(
                key="tile",
                text=_t("tile_title"),
                default=DEFAULT_TILE,
                items=_t("tile_items"),
                icon="msg_media",
            ),
            Switch(
                key="original",
                text=_t("orig_title"),
                default=False,
                subtext=_t("orig_sub"),
                icon="msg_photo_settings",
            ),
            Divider(text=_t("footer")),
        ]

    def _alias(self) -> str:
        return (self.get_setting("alias", REAL_BOT) or REAL_BOT).strip().lstrip("@").lower()

    def _tile_dp(self) -> int:
        try:
            idx = int(self.get_setting("tile", DEFAULT_TILE))
        except Exception:
            idx = DEFAULT_TILE
        return TILE_DP[idx] if 0 <= idx < len(TILE_DP) else BASE_TILE_DP

    def _replace_enabled(self) -> bool:
        return self._alias() == REAL_BOT or self._via_alias

    def rewrite_alias(self, param):
        args = param.args
        if args is None or len(args) < 2 or args[0] is None:
            return
        text = str(args[0])
        if text.startswith("@") and " " not in text and len(text) <= 33:
            self._prefix = text[1:].lower()
        else:
            self._prefix = None
        alias = self._alias()
        end = text.find(" ")
        if not text.startswith("@") or end <= 1:
            return
        name = text[1:end].lower()
        if alias != REAL_BOT and name == alias:
            self._via_alias = True
            new = "@" + REAL_BOT + text[end:]
            args[0] = new
            try:
                args[1] = jint(int(args[1]) + (len(new) - len(text)))
            except Exception:
                pass
        elif name == REAL_BOT:
            self._via_alias = False

    def skip_cache(self, param):
        args = param.args
        if args is None or len(args) < 3 or not self._replace_enabled():
            return
        if _is_pic_user(args[1]) and bool(args[0]):
            args[0] = jboolean(False)

    def fade_tile(self, param):
        res = param.args[0] if param.args is not None and len(param.args) > 0 else None
        if res is not None and str(getattr(res, "id", "") or "").startswith(ID_PREFIX):
            _smooth_cell(param.thisObject)

    def resize_tile(self, param):
        cell = param.thisObject
        res = _cell_result(cell)
        if res is None or not str(res.id or "").startswith(ID_PREFIX):
            return
        _smooth_cell(cell)
        dp = self._tile_dp()
        if dp == BASE_TILE_DP:
            return
        px = int(dp * float(AndroidUtilities.density))
        param.args[1] = jint((1 << 30) | (px & 0x3FFFFFFF))

    def _make_plate_user(self, alias: str):
        u = self._plate_user
        if u is None or str(u.username) != alias:
            u = TLRPC.TL_user()
            u.id = FAKE_USER_ID
            u.bot = True
            u.first_name = _t("bar_title")
            u.username = alias
            self._plate_user = u
        return u

    def _add_plate(self, adapter, items, id_map) -> bool:
        alias = self._alias()
        prefix = self._prefix
        if alias == REAL_BOT or prefix is None or not alias.startswith(prefix) or items is None:
            return False
        if not bool(_get_field(adapter, "needBotContext", True)):
            return False
        for i in range(int(items.size())):
            if getattr(items.get(i), "id", None) == FAKE_USER_ID:
                return False
        user = self._make_plate_user(alias)
        items.add(0, user)
        if id_map is not None:
            id_map.put(FAKE_USER_ID, user)
        return True

    def inject_plate(self, param):
        self._add_plate(param.thisObject, param.args[0], param.args[1])

    def inject_after(self, param):
        adapter = param.thisObject
        items = _get_field(adapter, "searchResultUsernames")
        if self._add_plate(adapter, items, _get_field(adapter, "searchResultUsernamesMap")):
            adapter.notifyDataSetChanged()

    def style_cell(self, param):
        user = param.args[0] if param.args is not None and len(param.args) > 0 else None
        if user is None:
            return
        is_plate = getattr(user, "id", 0) == FAKE_USER_ID
        is_real = self._alias() == REAL_BOT and bool(getattr(user, "bot", False)) and _is_pic_user(user)
        if not (is_plate or is_real):
            return
        cell = param.thisObject
        name_view = _get_field(cell, "nameTextView")
        if name_view is not None:
            name_view.setText(_t("bar_title"))
        image = _get_field(cell, "imageView")
        if image is not None:
            MediaDataController.getInstance(get_selected_account()).setPlaceholderImageByIndex(
                image, STICKER_PACK, jint(STICKER_INDEX), "28_28"
            )

    def _is_pic_bot(self, account: int, request: Any) -> bool:
        bot = getattr(request, "bot", None)
        uid = getattr(bot, "user_id", None)
        if not uid:
            return False
        mc = get_messages_controller(account)
        try:
            user = mc.getUser(int(uid))
        except Exception:
            from java.lang import Long
            user = mc.getUser(Long(int(uid)))
        return _is_pic_user(user)

    def pre_request_hook(self, request_name: str, account: int, request: Any) -> HookResult:
        if request_name != REQ_NAME:
            return HookResult()
        try:
            if not self._replace_enabled() or not self._is_pic_bot(account, request):
                return HookResult()
            query = str(getattr(request, "query", "") or "").strip()
            offset = str(getattr(request, "offset", "") or "")
            if not query:
                return HookResult()
            page = int(offset) if offset.isdigit() else 0
            fut = self._pool.submit(search_task, query, (page + 1) * PAGE + 1)
            with self._lock:
                self._pending[account] = (query, page, fut, time.time())
            if offset:
                request.offset = ""
                return HookResult(strategy=HookStrategy.MODIFY, request=request)
        except Exception:
            self.logger.exception("pre_request_hook failed")
        return HookResult()

    def post_request_hook(self, request_name: str, account: int, response: Any, error: Any) -> HookResult:
        if request_name != REQ_NAME:
            return HookResult()
        with self._lock:
            entry = self._pending.pop(account, None)
        if entry is None:
            return HookResult()
        query, page, fut, ts = entry
        if error is not None or response is None or time.time() - ts > 60:
            return HookResult()
        try:
            if not isinstance(response, TLRPC.TL_messages_botResults):
                return HookResult()
            searcher = fut.result(timeout=WAIT_FOR_SEARCH)
            pins = list(searcher.pins)
            start = page * PAGE
            chunk = pins[start:start + PAGE]
            if not chunk:
                if page == 0:
                    self.logger.info("no results for %r [%s]" % (query, "; ".join(searcher.errors)))
                    return HookResult()
                new = build_response([], "")
            else:
                has_more = len(pins) > start + PAGE
                dp = self._tile_dp()
                new = build_response(chunk, str(page + 1) if has_more else "",
                                     dp / float(BASE_TILE_DP), dp <= BASE_TILE_DP)
                if has_more:
                    self._pool.submit(search_task, query, (page + 2) * PAGE + 1)
            self.logger.info("%r page %d via %s: %d pins total" % (query, page, searcher.source, len(pins)))
            return HookResult(strategy=HookStrategy.MODIFY, response=new)
        except Exception:
            self.logger.exception("post_request_hook failed, keeping original response")
            return HookResult()

    def on_send_bot_result(self, param):
        args = list(param.args)
        result = next((a for a in args if isinstance(a, TLRPC.BotInlineResult)), None)
        if result is None or not str(result.id or "").startswith(ID_PREFIX):
            return

        dialog_id = None
        try:
            for i, t in enumerate(param.method.getParameterTypes()):
                if str(t.getName()) == "long":
                    dialog_id = int(args[i])
                    break
        except Exception:
            pass
        if dialog_id is None:
            dialog_id = next((int(a) for a in args if isinstance(a, int) and not isinstance(a, bool)), None)
        if dialog_id is None:
            return

        reply_id = None
        reply = next((a for a in args if isinstance(a, MessageObject)), None)
        if reply is not None:
            try:
                reply_id = int(reply.getId())
            except Exception:
                reply_id = None

        acc = next((a for a in args if isinstance(a, AccountInstance)), None)
        account = int(acc.getCurrentAccount()) if acc is not None else get_selected_account()

        url = str(result.content.url)
        param.setResult(None)
        run_on_queue(lambda: self._send_pin(account, dialog_id, reply_id, url))

    def _send_pin(self, account: int, dialog_id: int, reply_id: Optional[int], url: str):
        try:
            _cleanup_tmp()
            path = download_image(url, bool(self.get_setting("original", False)))
            if not path:
                BulletinHelper.show_error(_t("err_download"))
                return
            if reply_id:
                try:
                    send_photo(dialog_id, path, replyToMsg=reply_id, account=account)
                    return
                except TypeError:
                    pass
            send_photo(dialog_id, path, account=account)
        except Exception as e:
            self.logger.exception("send failed")
            BulletinHelper.show_error(_t("err_generic") % str(e)[:120])