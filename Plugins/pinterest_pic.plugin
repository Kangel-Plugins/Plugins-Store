FAKE_USER_ID = 7777777777777

UA = (
    "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 "
    "(KHTML, like Gecko) Chrome/130.0.0.0 Safari/537.36"
)
BASE = "https://www.pinterest.com"
TIMEOUT = 15
BATCH = 50
PAGE = 30
MAX_PINS = 400
CACHE_TTL = 600
TMP_TTL = 600
WAIT_FOR_SEARCH = 12
MIN_SIDE = 200

SIZE_RE = re.compile(r"i\.pinimg\.com/(?:originals|\d+x(?:\d+)?)/")
SCRIPT_RE = re.compile(r'<script[^>]+id="(__PWS_[A-Z_]+)"[^>]*>(.*?)</script>', re.DOTALL)
APPVER_RE = re.compile(r'"appVersion"\s*:\s*"([0-9a-f]{7,})"')
BING_M_RE = re.compile(r"""class="iusc"[^>]*?\sm=(?:"([^"]+)"|'([^']+)')""", re.DOTALL)
SIZE_KEYS = ("736x", "564x", "474x", "orig")
THUMB_KEYS = ("474x", "236x", "564x")


