def _lang() -> str:
    codes = []
    try:
        info = LocaleController.getInstance().getCurrentLocaleInfo()
        for name in ("pluralLangCode", "baseLangCode", "shortName"):
            v = getattr(info, name, None)
            if v:
                codes.append(str(v).lower())
    except Exception:
        pass
    try:
        codes.append(str(LocaleController.getLocaleStringIso639()).lower())
    except Exception:
        pass
    for c in codes:
        if c.startswith("uk"):
            return "uk"
        if c.startswith("ru"):
            return "ru"
        if c.startswith("en"):
            return "en"
    return "en"


def _t(key: str) -> Any:
    return STRINGS.get(_lang(), STRINGS["en"]).get(key) or STRINGS["en"][key]


_URLLIB3_WRAPPER = "Urllib3PercentREOverride"


def _fix_urllib3():
    """Repairs urllib3 when another plugin broke it for everyone.

    yt-dlp replaces urllib3's percent-encoding regex with a wrapper (Urllib3PercentREOverride) when it is
    imported. All plugins share one Python process, so if yt-dlp is imported twice (a plugin that uses it
    is reloaded or reinstalled) the wrapper ends up wrapping a wrapper, and every `requests` call in every
    plugin fails with "'Urllib3PercentREOverride' object has no attribute 'sub'". Here the wrapper is
    flattened back to a single layer (yt-dlp keeps its behaviour); if that is impossible urllib3's own
    pattern is restored. Cheap, so it runs before network work."""
    try:
        import urllib3.util.url as _u
    except Exception:
        return
    for name in ("_PERCENT_RE", "PERCENT_RE"):
        cur = getattr(_u, name, None)
        if cur is None or type(cur).__name__ != _URLLIB3_WRAPPER:
            continue
        try:
            layers, inner = 0, cur
            while type(inner).__name__ == _URLLIB3_WRAPPER and layers < 20:
                inner = inner.__dict__.get("re")      # __dict__: does not trigger the wrapper's __getattr__
                layers += 1
            if layers <= 1 and hasattr(inner, "sub"):
                continue                               # one layer around a real pattern: the normal yt-dlp state
            if hasattr(inner, "sub") and hasattr(inner, "findall"):
                setattr(_u, name, type(cur)(inner))    # flatten to one layer
            else:
                setattr(_u, name, re.compile(r"%[a-fA-F0-9]{2}"))   # urllib3's own pattern
        except Exception:
            try:
                setattr(_u, name, re.compile(r"%[a-fA-F0-9]{2}"))
            except Exception:
                pass


def _headers(extra: Optional[dict] = None) -> dict:
    h = {"User-Agent": UA, "Accept-Language": "en-US,en;q=0.9"}
    if extra:
        h.update(extra)
    return h


def _err(e: Exception) -> str:
    code = getattr(getattr(e, "response", None), "status_code", None)
    if code:
        return "HTTP %s" % code
    return ("%s %s" % (type(e).__name__, e)).strip()[:60]


def _key(url: str) -> str:
    return url.rsplit("/", 1)[-1].split(".")[0].lower()


def _sized(url: str, size: str) -> str:
    return SIZE_RE.sub("i.pinimg.com/%s/" % size, url)


def _pin(url: str, w: int = 0, h: int = 0, thumb: Optional[str] = None,
         small: Optional[str] = None, exact: bool = False) -> dict:
    if not w or not h:
        w, h = 736, 981
    if not exact:
        thumb, small, url = _sized(url, "474x"), _sized(url, "236x"), _sized(url, "736x")
    thumb = thumb or url
    return {"thumb": thumb, "small": small or thumb, "url": url, "w": int(w), "h": int(h), "key": _key(url)}


def _pin_from_item(item: Any) -> Optional[dict]:
    if not isinstance(item, dict):
        return None
    if item.get("type") not in (None, "pin"):
        return None
    if item.get("is_promoted") or item.get("is_ad") or item.get("promoter"):
        return None
    images = item.get("images")
    if not isinstance(images, dict):
        return None
    main = next((images[k] for k in SIZE_KEYS
                 if isinstance(images.get(k), dict) and images[k].get("url")), None)
    if main is None or not str(main["url"]).startswith(PIN_HOST):
        return None
    w, h = int(main.get("width") or 0), int(main.get("height") or 0)
    if w and h and min(w, h) < MIN_SIDE:
        return None
    thumb = next((images[k]["url"] for k in THUMB_KEYS
                  if isinstance(images.get(k), dict) and images[k].get("url")), None)
    small = (images.get("236x") or {}).get("url") if isinstance(images.get("236x"), dict) else None
    return _pin(main["url"], w, h, thumb=thumb, small=small, exact=True)


def _walk_pins(obj: Any, out: List[dict], depth: int = 0):
    if depth > 14 or len(out) >= BATCH * 2:
        return
    if isinstance(obj, dict):
        p = _pin_from_item(obj)
        if p:
            out.append(p)
            return
        for v in obj.values():
            _walk_pins(v, out, depth + 1)
    elif isinstance(obj, list):
        for v in obj:
            _walk_pins(v, out, depth + 1)


def _parse_api_json(payload: Any) -> List[dict]:
    results = (((payload or {}).get("resource_response") or {}).get("data") or {}).get("results") or []
    pins: List[dict] = []
    _walk_pins(results, pins)
    return pins


def _api_bookmark(payload: Any) -> Optional[str]:
    payload = payload or {}
    b = (payload.get("resource_response") or {}).get("bookmark")
    if not b:
        marks = ((payload.get("resource") or {}).get("options") or {}).get("bookmarks")
        if isinstance(marks, list) and marks:
            b = marks[0]
    return str(b) if b else None


def _is_end(bookmark: Optional[str]) -> bool:
    return not bookmark or bookmark.startswith("-end-")


def _parse_html_json(html: str) -> List[dict]:
    pins: List[dict] = []
    for _id, body in SCRIPT_RE.findall(html):
        try:
            _walk_pins(json.loads(body), pins)
        except Exception:
            continue
    return pins


def _parse_bing(html: str) -> List[dict]:
    pins, seen = [], set()
    for m in BING_M_RE.finditer(html):
        raw = m.group(1) or m.group(2)
        try:
            data = json.loads(htmllib.unescape(raw))
        except Exception:
            continue
        murl = str(data.get("murl") or "")
        if not murl.startswith(PIN_HOST) or not SIZE_RE.search(murl):
            continue
        k = _key(murl)
        if k not in seen:
            seen.add(k)
            pins.append(_pin(murl))
    return pins


def _from_api(session: requests.Session, query: str, app_version: str,
              bookmark: Optional[str] = None, base: str = BASE) -> Tuple[List[dict], Optional[str]]:
    csrf = session.cookies.get("csrftoken") or ""
    source_url = "/search/pins/?q=" + quote(query) + "&rs=typed"
    options = {
        "query": query, "scope": "pins", "page_size": BATCH, "rs": "typed",
        "source_url": source_url, "redux_normalize_feed": True,
    }
    if bookmark:
        options["bookmarks"] = [bookmark]
    r = session.get(
        base + "/resource/BaseSearchResource/get/",
        params={
            "source_url": source_url,
            "data": json.dumps({"options": options, "context": {}}, separators=(",", ":")),
            "_": str(int(time.time() * 1000)),
        },
        headers=_headers({
            "Accept": "application/json, text/javascript, */*, q=0.01",
            "X-Requested-With": "XMLHttpRequest",
            "X-APP-VERSION": app_version or "0",
            "X-Pinterest-AppState": "active",
            "X-Pinterest-Source-Url": source_url,
            "X-Pinterest-PWS-Handler": "www/search/[scope].js",
            "X-CSRFToken": csrf,
            "Referer": base + source_url,
        }),
        timeout=TIMEOUT,
    )
    r.raise_for_status()
    payload = r.json()
    return _parse_api_json(payload), _api_bookmark(payload)


def _from_bing(session: requests.Session, query: str, first: int = 1) -> Tuple[List[dict], int]:
    r = session.get(
        "https://www.bing.com/images/search",
        params={"q": "%s site:pinterest.com" % query, "first": str(first), "count": "50",
                "adlt": "off", "mkt": "en-US"},
        headers=_headers({"Accept": "text/html,application/xhtml+xml"}),
        timeout=TIMEOUT,
    )
    r.raise_for_status()
    return _parse_bing(r.text), len(BING_M_RE.findall(r.text))


class Searcher:
    def __init__(self, query: str):
        self.query = query
        self.lock = threading.Lock()
        self.pins: List[dict] = []
        self.exhausted = False
        self.source = ""
        self.errors: List[str] = []
        self.ts = time.time()
        self._seen = set()
        self._session: Optional[requests.Session] = None
        self._app_version = ""
        self._bookmark: Optional[str] = None
        self._base = BASE
        self._bing_first = 1
        self._started = False
        self._fails = 0

    def ensure(self, count: int) -> "Searcher":
        _fix_urllib3()
        with self.lock:
            tries = 0
            while len(self.pins) < count and not self.exhausted and tries < 6:
                tries += 1
                try:
                    self._fetch_more()
                    self._fails = 0
                except Exception as e:
                    self.errors.append(_err(e))
                    self._fails += 1
                    if self._fails >= 2:
                        self.exhausted = True
                    break
            if len(self.pins) >= MAX_PINS:
                self.exhausted = True
        return self

    def _add(self, pins: List[dict]) -> int:
        n = 0
        for p in pins:
            if p["key"] not in self._seen and len(self.pins) < MAX_PINS:
                self._seen.add(p["key"])
                self.pins.append(p)
                n += 1
        return n

    def _fetch_more(self):
        if self._session is None:
            self._session = requests.Session()
        if not self._started:
            self._started = True
            self._first_batch()
            return
        if self.source == "api":
            if _is_end(self._bookmark):
                self._switch_to_bing()
                return
            pins, bookmark = _from_api(self._session, self.query, self._app_version, self._bookmark, self._base)
            self._bookmark = bookmark
            if self._add(pins) == 0:
                self._switch_to_bing()
        elif self.source == "bing":
            pins, raw = _from_bing(self._session, self.query, self._bing_first)
            self._bing_first += max(raw, 1)
            if self._add(pins) == 0:
                self.exhausted = True
        else:
            self._switch_to_bing()

    def _switch_to_bing(self):
        self.source = "bing"
        self._bing_first = 1

    def _first_batch(self):
        s = self._session
        html = ""
        try:
            r = s.get(
                BASE + "/search/pins/?q=" + quote(self.query) + "&rs=typed",
                headers=_headers({"Accept": "text/html,application/xhtml+xml"}),
                timeout=TIMEOUT,
            )
            r.raise_for_status()
            html = r.text
            try:
                host = urlparse(str(r.url)).hostname or ""
                if host.endswith("pinterest.com"):
                    self._base = "https://" + host
            except Exception:
                pass
            m = APPVER_RE.search(html)
            self._app_version = m.group(1) if m else ""
        except Exception as e:
            self.errors.append("page: %s" % _err(e))

        try:
            pins, bookmark = _from_api(s, self.query, self._app_version, None, self._base)
            if self._add(pins):
                self.source = "api"
                self._bookmark = bookmark
                return
            self.errors.append("api: 0")
        except Exception as e:
            self.errors.append("api: %s" % _err(e))

        if html and self._add(_parse_html_json(html)):
            self.source = "page"
            return
        if html:
            self.errors.append("page: 0")

        try:
            pins, raw = _from_bing(s, self.query, 1)
            self._bing_first = 1 + max(raw, 1)
            if self._add(pins):
                self.source = "bing"
                return
            self.errors.append("bing: 0")
        except Exception as e:
            self.errors.append("bing: %s" % _err(e))
        self.exhausted = True


_searchers: Dict[str, Searcher] = {}
_searchers_lock = threading.Lock()


def get_searcher(query: str) -> Searcher:
    key = query.strip().lower()
    now = time.time()
    with _searchers_lock:
        s = _searchers.get(key)
        if s is None or now - s.ts > CACHE_TTL or (s.exhausted and not s.pins):
            s = Searcher(query)
            _searchers[key] = s
            if len(_searchers) > 20:
                _searchers.pop(min(_searchers, key=lambda k: _searchers[k].ts), None)
        s.ts = now
        return s


def search_task(query: str, count: int) -> Searcher:
    return get_searcher(query).ensure(count)


def _web_doc(url: str, w: int, h: int):
    d = TLRPC.TL_webDocument()
    d.url = url
    d.size = 0
    d.mime_type = "image/jpeg"
    a = TLRPC.TL_documentAttributeImageSize()
    a.w = w
    a.h = h
    d.attributes.add(a)
    return d


def _make_result(p: dict, scale: float, small: bool):
    w = max(1, int(round(p["w"] * scale)))
    r = TLRPC.TL_botInlineResult()
    r.flags = 0
    r.id = ID_PREFIX + p["key"]
    r.type = "photo"
    r.thumb = _web_doc(p["small"] if small else p["thumb"], w, p["h"])
    r.content = _web_doc(p["url"], w, p["h"])
    msg = TLRPC.TL_botInlineMessageMediaAuto()
    msg.message = ""
    r.send_message = msg
    return r


def build_response(chunk: List[dict], next_offset: str, scale: float = 1.0, small: bool = False):
    res = TLRPC.TL_messages_botResults()
    res.gallery = True
    res.flags = 1
    res.query_id = random.getrandbits(62)
    res.cache_time = 0
    if next_offset:
        res.next_offset = next_offset
        res.flags |= 2
    else:
        res.next_offset = ""
    for p in chunk:
        res.results.add(_make_result(p, scale, small))
    return res


def build_hint_response(title: str, desc: str):
    """One plain row instead of the grid. Used when Pinterest gives nothing: the user sees why,
    and the original (Yandex) answer of the bot is never shown."""
    res = TLRPC.TL_messages_botResults()
    res.gallery = False
    res.flags = 0
    res.query_id = random.getrandbits(62)
    res.cache_time = 0
    res.next_offset = ""
    r = TLRPC.TL_botInlineResult()
    r.flags = 0
    r.id = HINT_PREFIX + "row"
    r.type = "article"
    r.title = title
    r.description = desc
    msg = TLRPC.TL_botInlineMessageText()
    msg.message = title
    r.send_message = msg
    res.results.add(r)
    return res


def _hint_for(searcher: Optional["Searcher"], fallback_error: str = ""):
    """Nothing found, or Pinterest/Bing could not be reached (blocked, VPN, no connection)."""
    errors = [e for e in (searcher.errors if searcher is not None else []) if not e.endswith(": 0")]
    if fallback_error:
        errors.append(fallback_error)
    if errors:
        return build_hint_response(_t("unreachable"), _t("unreachable_d") % "; ".join(errors[-2:])[:90])
    return build_hint_response(_t("no_results"), _t("no_results_d"))


def _tmp_dir() -> str:
    d = os.path.join(tempfile.gettempdir(), "pinterest_pic")
    os.makedirs(d, exist_ok=True)
    return d


def _cleanup_tmp():
    try:
        d, now = _tmp_dir(), time.time()
        for n in os.listdir(d):
            p = os.path.join(d, n)
            try:
                if now - os.path.getmtime(p) > TMP_TTL:
                    os.remove(p)
            except OSError:
                pass
    except Exception:
        pass


def download_image(url: str, original: bool) -> Optional[str]:
    _fix_urllib3()
    candidates = []
    if original:
        candidates.append(_sized(url, "originals"))
    candidates += [url, _sized(url, "736x")]
    tried = set()
    for cand in candidates:
        if cand in tried:
            continue
        tried.add(cand)
        try:
            r = requests.get(
                cand,
                headers=_headers({"Referer": BASE + "/", "Accept": "image/*,*/*;q=0.8"}),
                timeout=TIMEOUT,
            )
            if r.status_code != 200 or len(r.content) < 2048:
                continue
            img = Image.open(io.BytesIO(r.content))
            if min(img.size) < 100:
                continue
            img.thumbnail((4096, 4096))
            if img.mode != "RGB":
                img = img.convert("RGB")
            path = os.path.join(_tmp_dir(), "pin_%d_%d.jpg" % (int(time.time() * 1000), random.randint(0, 9999)))
            img.save(path, "JPEG", quality=95)
            return path
        except Exception:
            continue
    return None


def _find_field(obj: Any, name: str):
    cls = obj.getClass()
    while cls is not None:
        try:
            f = cls.getDeclaredField(name)
            f.setAccessible(True)
            return f
        except Exception:
            cls = cls.getSuperclass()
    return None


def _get_field(obj: Any, name: str, default: Any = None) -> Any:
    try:
        f = _find_field(obj, name)
        return f.get(obj) if f is not None else default
    except Exception:
        return default


def _web_file_url(web_file: Any) -> str:
    try:
        return str(web_file.url or "")
    except Exception:
        pass
    return str(_get_field(web_file, "url", "") or "")


def _cell_result(cell: Any):
    for name in ("getBotInlineResult", "getResult"):
        try:
            r = getattr(cell, name)()
            if r is not None:
                return r
        except Exception:
            continue
    return None


def _usernames(user: Any) -> List[str]:
    names = []
    try:
        if getattr(user, "username", None):
            names.append(str(user.username).lower())
    except Exception:
        pass
    try:
        for u in (getattr(user, "usernames", None) or []):
            n = getattr(u, "username", None)
            if n:
                names.append(str(n).lower())
    except Exception:
        pass
    return names


def _is_pic_user(user: Any) -> bool:
    return user is not None and REAL_BOT in _usernames(user)


_smoothed = set()


def _smooth_cell(cell: Any):
    try:
        k = int(System.identityHashCode(cell))
    except Exception:
        return
    if k in _smoothed:
        return
    recv = _get_field(cell, "linkImageView")
    if recv is None:
        return
    for method, value, field, setter in (
        ("setCrossfadeDuration", jint(FADE_MS), "crossfadeDuration", "setInt"),
        ("setForceCrossfade", True, "forceCrossfade", "setBoolean"),
    ):
        try:
            getattr(recv, method)(value)
        except Exception:
            try:
                f = _find_field(recv, field)
                if f is not None:
                    getattr(f, setter)(recv, value)
            except Exception:
                pass
    if len(_smoothed) > 300:
        _smoothed.clear()
    _smoothed.add(k)


def _argb(v: int) -> int:
    """0xAARRGGBB literal -> signed 32-bit int, which is what Java color methods take."""
    v &= 0xFFFFFFFF
    return v - (1 << 32) if v > 0x7FFFFFFF else v


def _run_ui(fn):
    """Runs fn on the Telegram UI thread."""
    try:
        from java import dynamic_proxy
        from java.lang import Runnable

        class _Task(dynamic_proxy(Runnable)):
            def run(self):
                fn()

        AndroidUtilities.runOnUIThread(_Task())
    except Exception:
        from android_utils import run_on_ui_thread
        run_on_ui_thread(fn)


class _BypassInternalUriHook(MethodReplacement):
    """Lets the document sender accept a file from the plugin's own temp folder."""

    def replace_hooked_method(self, param):
        return False


def _make_provider(photo_viewer_provider_cls, handlers: dict, allow_caption: bool):
    """A PhotoViewerProvider implemented in Python. handlers: sendButtonPressed / willHidePhotoViewer."""
    from java import dynamic_proxy

    def const(value):
        def fn(self, *a):
            return value
        return fn

    ns = {name: const(val) for name, val in PROVIDER_DEFAULTS.items()}
    ns["allowCaption"] = const(bool(allow_caption))
    ns["isEditingSticker"] = const(False)

    def send_pressed(self, *a):
        handlers["send"]()

    def will_hide(self, *a):
        handlers.get("hide", lambda: None)()

    ns["sendButtonPressed"] = send_pressed
    ns["willHidePhotoViewer"] = will_hide
    return type("PinPhotoProvider", (dynamic_proxy(photo_viewer_provider_cls),), ns)()


def make_sticker_file(src: str) -> Optional[str]:
    """Photo -> 512px WEBP with a transparent margin-free canvas, the format Telegram treats as a sticker."""
    out = os.path.join(_tmp_dir(), "sticker_%d_%d.webp" % (int(time.time() * 1000), random.randint(0, 9999)))
    try:
        img = Image.open(src).convert("RGBA")
        w, h = img.size
        k = float(STICKER_SIDE) / max(w, h)
        resample = getattr(getattr(Image, "Resampling", Image), "LANCZOS")
        img = img.resize((max(1, int(round(w * k))), max(1, int(round(h * k)))), resample)
        img.save(out, "WEBP", quality=92, method=4)
        return out
    except Exception:
        pass
    try:   # Pillow built without WEBP: let Android encode it
        from android.graphics import Bitmap, BitmapFactory
        from java.io import FileOutputStream
        bmp = BitmapFactory.decodeFile(src)
        w, h = int(bmp.getWidth()), int(bmp.getHeight())
        k = float(STICKER_SIDE) / max(w, h)
        bmp = Bitmap.createScaledBitmap(bmp, max(1, int(round(w * k))), max(1, int(round(h * k))), True)
        stream = FileOutputStream(out)
        bmp.compress(Bitmap.CompressFormat.WEBP, 92, stream)
        stream.close()
        return out
    except Exception:
        return None



class _Hook(MethodHook):
    method = ""
    phase = "before"

    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin

    def _run(self, param):
        self.plugin.guard(self.method, getattr(self.plugin, self.method), param)

    def before_hooked_method(self, param):
        if self.phase == "before":
            self._run(param)

    def after_hooked_method(self, param):
        if self.phase == "after":
            self._run(param)


class _ImageLocationHook(MethodHook):
    def before_hooked_method(self, param):
        try:
            args = param.args
            if args is None or len(args) < 1 or args[0] is None:
                return
            url = _web_file_url(args[0])
            if url.startswith(PIN_HOST):
                param.setResult(ImageLocation.getForPath(url))
        except Exception:
            pass


class _SendHook(_Hook):
    method = "on_send_bot_result"


class _PickHook(_Hook):
    method = "on_open_preview"


class _AliasHook(_Hook):
    method = "rewrite_alias"

    def after_hooked_method(self, param):
        if not self.plugin.users_hooked:
            self.plugin.guard("inject_after", self.plugin.inject_after, param)


class _CacheHook(_Hook):
    method = "skip_cache"


class _TileHook(_Hook):
    method = "resize_tile"


class _LinkHook(_Hook):
    method = "fade_tile"
    phase = "after"


class _UsersHook(_Hook):
    method = "inject_plate"


class _CellHook(_Hook):
    method = "style_cell"
    phase = "after"


class PinterestPicPlugin(BasePlugin):
    def on_plugin_load(self):
        self._pool = ThreadPoolExecutor(max_workers=4)
        self._pending: Dict[int, tuple] = {}
        self._lock = threading.Lock()
        self._prefix: Optional[str] = None
        self._via_alias = False
        self._plate_user = None
        self._reported = set()
        self._failed: List[str] = []
        self.users_hooked = False
        self._btn = None
        self._btn_host = None
        self._btn_state = None
        self._uri_hooked = False

        self.add_hook(REQ_NAME)
        _fix_urllib3()

        self._install("org.telegram.messenger.ImageLocation", "getForWebFile", _ImageLocationHook())
        self._install("org.telegram.messenger.SendMessagesHelper", "prepareSendingBotContextResult", _SendHook(self))
        self._install("org.telegram.ui.PhotoViewer", "openPhotoForSelect", _PickHook(self))
        self._install("org.telegram.ui.Adapters.MentionsAdapter", "searchUsernameOrHashtag", _AliasHook(self))
        self._install("org.telegram.ui.Adapters.MentionsAdapter", "searchForContextBotResults", _CacheHook(self))
        self._install("org.telegram.ui.Cells.ContextLinkCell", "onMeasure", _TileHook(self))
        self._install("org.telegram.ui.Cells.ContextLinkCell", "setLink", _LinkHook(self))
        self.users_hooked = self._install("org.telegram.ui.Adapters.MentionsAdapter", "showUsersResult", _UsersHook(self))
        self._install("org.telegram.ui.Cells.MentionCell", "setUser", _CellHook(self))

        if self._failed:
            BulletinHelper.show_error(_t("err_hooks") % ", ".join(self._failed))

    def _install(self, class_name: str, method: str, handler) -> bool:
        label = "%s.%s" % (class_name.rsplit(".", 1)[-1], method)
        try:
            cls = find_class(class_name)
            if cls is None:
                self.logger.error("class not found: %s" % class_name)
                self._failed.append(label)
                return False
            try:
                if self.hook_all_methods(cls, method, handler):
                    return True
            except Exception:
                self.logger.exception("hook_all_methods failed: %s" % label)
            n = 0
            for m in cls.getDeclaredMethods():
                if str(m.getName()) == method:
                    m.setAccessible(True)
                    if self.hook_method(m, handler):
                        n += 1
            if n:
                return True
        except Exception:
            self.logger.exception("hook failed: %s" % label)
        self.logger.error("not hooked: %s" % label)
        self._failed.append(label)
        return False

    def guard(self, name: str, fn, *args):
        try:
            return fn(*args)
        except Exception as e:
            self.logger.exception("error in %s" % name)
            if name not in self._reported:
                self._reported.add(name)
                try:
                    BulletinHelper.show_error(_t("err_runtime") % (name, ("%s: %s" % (type(e).__name__, e))[:80]))
                except Exception:
                    pass
            return None

    def on_plugin_unload(self):
        try:
            _run_ui(self._hide_button)
        except Exception:
            pass
        try:
            self._pool.shutdown(wait=False)
        except Exception:
            pass

    def create_settings(self) -> List[Any]:
        def safe(factory):
            """One broken control must not empty the whole settings screen."""
            try:
                return [factory()]
            except Exception:
                self.logger.exception("settings item")
                return []

        items: List[Any] = [
            Header(text="Pinterest Pic"),
            Input(
                key="alias",
                text=_t("alias_title"),
                default=REAL_BOT,
                subtext=_t("alias_sub"),
                icon="msg_mention",
            ),
            Selector(
                key="tile",
                text=_t("tile_title"),
                default=DEFAULT_TILE,
                items=_t("tile_items"),
                icon="msg_media",
            ),
        ]
        items += safe(lambda: Selector(
            key="sticker_mode",
            text=_t("st_title"),
            default=STICKER_OFF,
            items=_t("st_items"),
            icon="msg_sticker",
        ))
        items += safe(lambda: Divider(text=_t("st_sub")))
        items += [
            Switch(
                key="original",
                text=_t("orig_title"),
                default=False,
                subtext=_t("orig_sub"),
                icon="msg_photo_settings",
            ),
            Divider(text=_t("footer")),
        ]
        return items

    def _alias(self) -> str:
        return (self.get_setting("alias", REAL_BOT) or REAL_BOT).strip().lstrip("@").lower()

    def _tile_dp(self) -> int:
        try:
            idx = int(self.get_setting("tile", DEFAULT_TILE))
        except Exception:
            idx = DEFAULT_TILE
        return TILE_DP[idx] if 0 <= idx < len(TILE_DP) else BASE_TILE_DP

    def _replace_enabled(self) -> bool:
        return self._alias() == REAL_BOT or self._via_alias

    def rewrite_alias(self, param):
        args = param.args
        if args is None or len(args) < 2 or args[0] is None:
            return
        text = str(args[0])
        self._sync_button(text)
        if text.startswith("@") and " " not in text and len(text) <= 33:
            self._prefix = text[1:].lower()
        else:
            self._prefix = None
        alias = self._alias()
        end = text.find(" ")
        if not text.startswith("@") or end <= 1:
            return
        name = text[1:end].lower()
        if alias != REAL_BOT and name == alias:
            self._via_alias = True
            new = "@" + REAL_BOT + text[end:]
            args[0] = new
            try:
                args[1] = jint(int(args[1]) + (len(new) - len(text)))
            except Exception:
                pass
        elif name == REAL_BOT:
            self._via_alias = False

    def skip_cache(self, param):
        args = param.args
        if args is None or len(args) < 3 or not self._replace_enabled():
            return
        if _is_pic_user(args[1]) and bool(args[0]):
            args[0] = jboolean(False)

    def fade_tile(self, param):
        res = param.args[0] if param.args is not None and len(param.args) > 0 else None
        if res is not None and str(getattr(res, "id", "") or "").startswith(ID_PREFIX):
            _smooth_cell(param.thisObject)

    def resize_tile(self, param):
        cell = param.thisObject
        res = _cell_result(cell)
        if res is None or not str(res.id or "").startswith(ID_PREFIX):
            return
        _smooth_cell(cell)
        dp = self._tile_dp()
        if dp == BASE_TILE_DP:
            return
        px = int(dp * float(AndroidUtilities.density))
        param.args[1] = jint((1 << 30) | (px & 0x3FFFFFFF))

    def _make_plate_user(self, alias: str):
        u = self._plate_user
        if u is None or str(u.username) != alias:
            u = TLRPC.TL_user()
            u.id = FAKE_USER_ID
            u.bot = True
            u.first_name = _t("bar_title")
            u.username = alias
            self._plate_user = u
        return u

    def _add_plate(self, adapter, items, id_map) -> bool:
        alias = self._alias()
        prefix = self._prefix
        if alias == REAL_BOT or prefix is None or not alias.startswith(prefix) or items is None:
            return False
        if not bool(_get_field(adapter, "needBotContext", True)):
            return False
        for i in range(int(items.size())):
            if getattr(items.get(i), "id", None) == FAKE_USER_ID:
                return False
        user = self._make_plate_user(alias)
        items.add(0, user)
        if id_map is not None:
            id_map.put(FAKE_USER_ID, user)
        return True

    def inject_plate(self, param):
        self._add_plate(param.thisObject, param.args[0], param.args[1])

    def inject_after(self, param):
        adapter = param.thisObject
        items = _get_field(adapter, "searchResultUsernames")
        if self._add_plate(adapter, items, _get_field(adapter, "searchResultUsernamesMap")):
            adapter.notifyDataSetChanged()

    def style_cell(self, param):
        user = param.args[0] if param.args is not None and len(param.args) > 0 else None
        if user is None:
            return
        is_plate = getattr(user, "id", 0) == FAKE_USER_ID
        is_real = self._alias() == REAL_BOT and bool(getattr(user, "bot", False)) and _is_pic_user(user)
        if not (is_plate or is_real):
            return
        cell = param.thisObject
        name_view = _get_field(cell, "nameTextView")
        if name_view is not None:
            name_view.setText(_t("bar_title"))
        image = _get_field(cell, "imageView")
        if image is not None:
            MediaDataController.getInstance(get_selected_account()).setPlaceholderImageByIndex(
                image, STICKER_PACK, jint(STICKER_INDEX), "28_28"
            )

    def _is_pic_bot(self, account: int, request: Any) -> bool:
        bot = getattr(request, "bot", None)
        uid = getattr(bot, "user_id", None)
        if not uid:
            return False
        mc = get_messages_controller(account)
        try:
            user = mc.getUser(int(uid))
        except Exception:
            from java.lang import Long
            user = mc.getUser(Long(int(uid)))
        return _is_pic_user(user)

    def pre_request_hook(self, request_name: str, account: int, request: Any) -> HookResult:
        if request_name != REQ_NAME:
            return HookResult()
        try:
            if not self._replace_enabled() or not self._is_pic_bot(account, request):
                return HookResult()
            query = str(getattr(request, "query", "") or "").strip()
            offset = str(getattr(request, "offset", "") or "")
            if not query:
                return HookResult()
            page = int(offset) if offset.isdigit() else 0
            fut = self._pool.submit(search_task, query, (page + 1) * PAGE + 1)
            with self._lock:
                self._pending[account] = (query, page, fut, time.time())
            if offset:
                request.offset = ""
                return HookResult(strategy=HookStrategy.MODIFY, request=request)
        except Exception:
            self.logger.exception("pre_request_hook failed")
        return HookResult()

    def post_request_hook(self, request_name: str, account: int, response: Any, error: Any) -> HookResult:
        if request_name != REQ_NAME:
            return HookResult()
        with self._lock:
            entry = self._pending.pop(account, None)
        if entry is None:
            return HookResult()
        query, page, fut, ts = entry
        if error is not None or response is None or time.time() - ts > 60:
            return HookResult()
        try:
            if not isinstance(response, TLRPC.TL_messages_botResults):
                return HookResult()
            searcher = fut.result(timeout=WAIT_FOR_SEARCH)
            pins = list(searcher.pins)
            start = page * PAGE
            chunk = pins[start:start + PAGE]
            if not chunk:
                if page == 0:
                    self.logger.info("no results for %r [%s]" % (query, "; ".join(searcher.errors)))
                    return HookResult(strategy=HookStrategy.MODIFY, response=_hint_for(searcher))
                new = build_response([], "")
            else:
                has_more = len(pins) > start + PAGE
                dp = self._tile_dp()
                new = build_response(chunk, str(page + 1) if has_more else "",
                                     dp / float(BASE_TILE_DP), dp <= BASE_TILE_DP)
                if has_more:
                    self._pool.submit(search_task, query, (page + 2) * PAGE + 1)
            self.logger.info("%r page %d via %s: %d pins total" % (query, page, searcher.source, len(pins)))
            return HookResult(strategy=HookStrategy.MODIFY, response=new)
        except Exception as e:
            self.logger.exception("post_request_hook failed")
            # never leave the bot's own (Yandex) results on screen, show the reason instead
            try:
                if page == 0:
                    return HookResult(strategy=HookStrategy.MODIFY, response=_hint_for(None, _err(e)))
                return HookResult(strategy=HookStrategy.MODIFY, response=build_response([], ""))
            except Exception:
                pass
            return HookResult()

    def on_send_bot_result(self, param):
        args = list(param.args)
        result = next((a for a in args if isinstance(a, TLRPC.BotInlineResult)), None)
        if result is not None and str(result.id or "").startswith(HINT_PREFIX):
            param.setResult(None)     # the hint row is not a picture, nothing to send
            return
        if result is None or not str(result.id or "").startswith(ID_PREFIX):
            return

        dialog_id = None
        try:
            for i, t in enumerate(param.method.getParameterTypes()):
                if str(t.getName()) == "long":
                    dialog_id = int(args[i])
                    break
        except Exception:
            pass
        if dialog_id is None:
            dialog_id = next((int(a) for a in args if isinstance(a, int) and not isinstance(a, bool)), None)
        if dialog_id is None:
            return

        # prepareSendingBotContextResult(..., long dialogId, MessageObject replyToMsg, MessageObject replyToTopMsg, ...)
        # replyToMsg is the message the user replies to; replyToTopMsg is the root of the thread / forum topic.
        # They are taken by position: "the first non-null MessageObject" mixed them up in forum topics.
        reply_obj = top_obj = None
        try:
            idx = [i for i, t in enumerate(param.method.getParameterTypes())
                   if str(t.getName()) == "org.telegram.messenger.MessageObject"]
            if idx:
                reply_obj = args[idx[0]]
            if len(idx) > 1:
                top_obj = args[idx[1]]
        except Exception:
            msgs = [a for a in args if isinstance(a, MessageObject)]
            reply_obj = msgs[0] if msgs else None

        acc = next((a for a in args if isinstance(a, AccountInstance)), None)
        account = int(acc.getCurrentAccount()) if acc is not None else get_selected_account()

        url = str(result.content.url)
        param.setResult(None)
        run_on_queue(lambda: self._send_pin(account, dialog_id, reply_obj, top_obj, url))

    def on_open_preview(self, param):
        """Tapping a picture in the inline grid opens Telegram's own preview (PhotoViewer type 3) with a Send
        button, and only after that comes the plugin's editor. The preview is skipped: the tap goes straight
        to the editor / sticker flow."""
        args = param.args
        if args is None or len(args) < 3 or int(args[2]) != 3 or args[0] is None:
            return
        item = args[0].get(int(args[1]))
        if item is None or not str(getattr(item, "id", "") or "").startswith(ID_PREFIX):
            return
        fragment = self._chat_fragment()
        if fragment is None:
            return
        url = str(item.content.url)
        account = int(fragment.getCurrentAccount())
        dialog_id = int(fragment.getDialogId())
        reply_obj = _get_field(fragment, "replyingMessageObject")
        try:
            top_obj = fragment.getThreadMessage()
        except Exception:
            top_obj = _get_field(fragment, "threadMessageObject")
        param.setResult(True)
        _run_ui(self._hide_button)
        try:    # what ChatActivity.sendBotInlineResult does after sending
            enter = _get_field(fragment, "chatActivityEnterView")
            if enter is not None:
                enter.setFieldText("")
            fragment.hideFieldPanel(False)
        except Exception:
            self.logger.exception("clear input")
        run_on_queue(lambda: self._send_pin(account, dialog_id, reply_obj, top_obj, url))

    @staticmethod
    def _msg_id(obj: Any) -> Optional[int]:
        try:
            return int(obj.getId()) if obj is not None else None
        except Exception:
            return None

    def _reply_variants(self, reply_obj: Any, top_obj: Any) -> List[Tuple[str, dict]]:
        """Reply parameters to try, best first. In a forum topic the topic root (replyToTopMsg) must be passed,
        otherwise the message lands in the General topic of the group."""
        reply_id, top_id = self._msg_id(reply_obj), self._msg_id(top_obj)
        variants: List[Tuple[str, dict]] = []
        if top_obj is not None:
            variants.append(("objects", {"replyToMsg": reply_obj if reply_obj is not None else top_obj,
                                         "replyToTopMsg": top_obj}))
            variants.append(("ids", {"replyToMsg": reply_id if reply_id else top_id, "replyToTopMsg": top_id}))
            variants.append(("reply id only", {"replyToMsg": reply_id if reply_id else top_id}))
        elif reply_obj is not None:
            variants.append(("reply id", {"replyToMsg": reply_id}))
        variants.append(("plain", {}))
        return variants

    def _send_photo(self, account: int, dialog_id: int, path: str, reply_obj: Any, top_obj: Any,
                    caption: str = ""):
        """Sends the photo into the right place: the chat, a reply, or a forum topic / comment thread."""
        reply_id, top_id = self._msg_id(reply_obj), self._msg_id(top_obj)
        for name, kwargs in self._reply_variants(reply_obj, top_obj):
            if caption:
                kwargs = dict(kwargs, caption=caption)
            try:
                send_photo(dialog_id, path, account=account, **kwargs)
                self.logger.info("photo sent (%s): dialog=%s reply=%s top=%s" % (name, dialog_id, reply_id, top_id))
                return
            except TypeError:
                self.logger.exception("send_photo(%s) rejected, trying the next variant" % name)
        raise RuntimeError("send_photo failed in every variant")

    def _send_sticker(self, account: int, dialog_id: int, path: str, reply_obj: Any, top_obj: Any):
        """Sends a WEBP file as a sticker (a document with the sticker attribute)."""
        document = _prepare_document(path, "image/webp")
        if document is None:
            raise RuntimeError("could not prepare the sticker document")
        try:
            attrs = document.attributes
            if not any(isinstance(a, TLRPC.TL_documentAttributeSticker) for a in attrs):
                st = TLRPC.TL_documentAttributeSticker()
                st.alt = ""
                st.stickerset = TLRPC.TL_inputStickerSetEmpty()
                attrs.add(st)
            if not any(isinstance(a, TLRPC.TL_documentAttributeImageSize) for a in attrs):
                size = TLRPC.TL_documentAttributeImageSize()
                with Image.open(path) as im:
                    size.w, size.h = int(im.size[0]), int(im.size[1])
                attrs.add(size)
        except Exception:
            self.logger.exception("sticker attributes")
        self._hook_uri()
        try:
            for name, extra in self._reply_variants(reply_obj, top_obj):
                params = {"peer": dialog_id, "document": document, "path": path, "account": account}
                params.update(extra)
                try:
                    send_message(params)
                except TypeError:
                    self.logger.exception("send_message(%s) rejected, trying the next variant" % name)
                    continue
                self.logger.info("sticker sent (%s): dialog=%s" % (name, dialog_id))
                return
            raise RuntimeError("send_message failed in every variant")
        finally:
            self._unhook_uri()

    def _hook_uri(self):
        if self._uri_hooked:
            return
        try:
            self.hook_all_methods(AndroidUtilities, "isInternalUri", _BypassInternalUriHook())
            self._uri_hooked = True
        except Exception:
            pass

    def _unhook_uri(self):
        if not self._uri_hooked:
            return
        try:
            self.unhook_all_methods(AndroidUtilities, "isInternalUri")
        except Exception:
            pass
        self._uri_hooked = False

    # ------------------------------------------------------------------ settings helpers
    def _sticker_mode(self) -> int:
        try:
            v = int(self.get_setting("sticker_mode", STICKER_OFF))
        except Exception:
            v = STICKER_OFF
        return v if v in (STICKER_OFF, STICKER_AUTO, STICKER_EDITOR) else STICKER_OFF

    def _sticker_checked(self) -> bool:
        return bool(self.get_setting("sticker_checked", False))

    # ------------------------------------------------------------------ floating button
    def _sync_button(self, text: str):
        """Shows the sticker button while an inline command of this plugin is being typed, hides it otherwise."""
        want = False
        try:
            if self._sticker_mode() != STICKER_OFF and text.startswith("@"):
                end = text.find(" ")
                want = end > 1 and text[1:end].lower() == self._alias()
        except Exception:
            want = False
        if not want and self._btn is None:
            return
        _run_ui(lambda: self.guard("floating_button", self._show_button if want else self._hide_button))

    def _chat_fragment(self):
        """The chat that is on screen now, or None."""
        from org.telegram.ui import ChatActivity
        fragment = None
        try:
            from client_utils import get_last_fragment
            fragment = get_last_fragment()
        except Exception:
            fragment = None
        if fragment is None:
            from org.telegram.ui import LaunchActivity
            fragment = LaunchActivity.getLastFragment()
        return fragment if fragment is not None and isinstance(fragment, ChatActivity) else None

    def _hide_button(self):
        btn = self._btn
        self._btn = self._btn_host = self._btn_state = None
        if btn is None:
            return
        try:
            parent = btn.getParent()
            if parent is not None:
                parent.removeView(btn)
        except Exception:
            self.logger.exception("hide button")

    def _show_button(self):
        fragment = self._chat_fragment()
        if fragment is None:
            return self._hide_button()
        activity = fragment.getParentActivity()
        # The button lives in the activity's content frame, a plain FrameLayout that always lays out its
        # children, unlike the chat's own container which positions views by its own rules.
        host = activity.findViewById(16908290) if activity is not None else None
        if host is None:
            raise RuntimeError("no content frame")
        if self._btn is not None and self._btn_host is host and self._btn.getParent() is not None:
            self._place_button(fragment, host)
            return
        self._hide_button()
        self._build_button(fragment, host)

    def _place_button(self, fragment, host):
        """Keeps the button just above the input field (it moves with the keyboard)."""
        from android.view import Gravity
        from android.widget import FrameLayout
        from java import jarray, jint

        btn = self._btn
        size = int(AndroidUtilities.dp(52.0))
        x = int(host.getWidth()) - size - int(AndroidUtilities.dp(14.0))
        enter = _get_field(fragment, "chatActivityEnterView")
        if enter is not None and int(enter.getHeight()) > 0:
            a, b = jarray(jint)([0, 0]), jarray(jint)([0, 0])
            enter.getLocationInWindow(a)
            host.getLocationInWindow(b)
            y = int(a[1]) - int(b[1]) - size - int(AndroidUtilities.dp(12.0))
        else:
            y = int(host.getHeight()) - size - int(AndroidUtilities.dp(160.0))
        state = (x, y)
        if state == self._btn_state:
            return
        lp = FrameLayout.LayoutParams(size, size, Gravity.TOP | Gravity.LEFT)
        lp.leftMargin, lp.topMargin = x, max(y, 0)
        btn.setLayoutParams(lp)
        btn.bringToFront()
        self._btn_state = state

    def _build_button(self, fragment, host):
        from android.graphics.drawable import GradientDrawable
        from android.view import Gravity, View
        from android.widget import FrameLayout, ImageView, TextView
        from java import dynamic_proxy
        from org.telegram.messenger import ApplicationLoader
        from org.telegram.ui.ActionBar import Theme

        accent = _argb(0xFF3390EC)
        try:
            accent = int(Theme.getColor(Theme.key_chat_messagePanelSend))
        except Exception:
            pass
        white = _argb(0xFFFFFFFF)
        dark = _argb(0xE6303030)

        ctx = host.getContext()
        size = int(AndroidUtilities.dp(52.0))
        root = FrameLayout(ctx)

        # a sticker icon from Telegram's own resources; a smiley text if the resource cannot be found
        res = ApplicationLoader.applicationContext.getResources()
        pkg = ApplicationLoader.applicationContext.getPackageName()
        rid = 0
        for name in ("msg_sticker", "input_smile", "msg_stickers"):
            try:
                rid = int(res.getIdentifier(name, "drawable", pkg))
            except Exception:
                rid = 0
            if rid:
                break
        if rid:
            icon = ImageView(ctx)
            icon.setScaleType(ImageView.ScaleType.CENTER)
            icon.setImageResource(rid)
            icon.setColorFilter(white)
        else:
            icon = TextView(ctx)
            icon.setText("\U0001F642")
            icon.setTextSize(24.0)
            icon.setGravity(Gravity.CENTER)
        root.addView(icon, FrameLayout.LayoutParams(size, size))

        badge = TextView(ctx)
        badge.setText("✓")
        badge.setTextSize(12.0)
        badge.setGravity(Gravity.CENTER)
        badge.setTextColor(white)
        bg_badge = GradientDrawable()
        bg_badge.setShape(GradientDrawable.OVAL)
        bg_badge.setColor(_argb(0xFF2EB85C))
        bg_badge.setStroke(int(AndroidUtilities.dp(1.5)), white)
        badge.setBackground(bg_badge)
        bsz = int(AndroidUtilities.dp(20.0))
        root.addView(badge, FrameLayout.LayoutParams(bsz, bsz, Gravity.RIGHT | Gravity.TOP))

        def paint():
            checked = self._sticker_checked()
            bg = GradientDrawable()
            bg.setShape(GradientDrawable.OVAL)
            bg.setColor(accent if checked else dark)
            root.setBackground(bg)
            badge.setVisibility(View.VISIBLE if checked else View.GONE)

        class _Click(dynamic_proxy(View.OnClickListener)):
            def onClick(inner, view):
                new = not self._sticker_checked()
                try:
                    self.set_setting("sticker_checked", new)
                except Exception:
                    self.logger.exception("set_setting")
                paint()
                try:
                    BulletinHelper.show_info(_t("btn_sticker") if new else _t("btn_image"))
                except Exception:
                    pass

        root.setOnClickListener(_Click())
        paint()
        try:
            root.setElevation(AndroidUtilities.dp(6.0))
        except Exception:
            pass

        host.addView(root, FrameLayout.LayoutParams(size, size, Gravity.TOP | Gravity.LEFT))
        self._btn, self._btn_host, self._btn_state = root, host, None
        self._place_button(fragment, host)

    # ------------------------------------------------------------------ editor / sticker editor
    def _open_viewer(self, kind: str, entry_path: str, account: int, dialog_id: int,
                     reply_obj: Any, top_obj: Any, source_path: str) -> bool:
        """Opens Telegram's own editor for the picture. kind: "photo" (edit + caption) or "sticker".
        Must run on the UI thread. Returns False if the editor could not be opened."""
        try:
            from java import jclass
            from java.util import ArrayList
            from org.telegram.messenger import MediaController
            from org.telegram.ui import ContentPreviewViewer, PhotoViewer

            fragment = self._chat_fragment()
            if fragment is None:
                return False
            try:
                if int(fragment.getDialogId()) != int(dialog_id):
                    return False
            except Exception:
                pass
            try:
                AndroidUtilities.hideKeyboard(fragment.getFragmentView())
            except Exception:
                pass

            entry = MediaController.PhotoEntry(0, 0, jlong(0), entry_path, 0, False, 0, 0, jlong(0))
            sticker = kind == "sticker"

            def on_send():
                try:
                    edited = getattr(entry, "imagePath", None)
                    path = str(edited) if edited else str(getattr(entry, "path", None) or entry_path)
                    caption = ""
                    if not sticker:
                        cap = getattr(entry, "caption", None)
                        caption = str(cap) if cap is not None else ""
                except Exception:
                    path, caption = entry_path, ""
                run_on_queue(lambda: self._finish_pick(kind, account, dialog_id, reply_obj, top_obj, path, caption,
                                                       source_path))

            provider = _make_provider(
                jclass("org.telegram.ui.PhotoViewer$PhotoViewerProvider"),
                {"send": on_send},
                allow_caption=not sticker,
            )
            viewer = PhotoViewer.getInstance()
            try:
                viewer.setParentActivity(fragment, fragment.getResourceProvider())
            except Exception:
                viewer.setParentActivity(fragment.getParentActivity())
            photos = ArrayList()
            photos.add(entry)
            opened = viewer.openPhotoForSelect(photos, jint(0), jint(PICK_TYPE_STICKER if sticker else PICK_TYPE_CHAT),
                                               jboolean(False), provider, fragment)
            if sticker:
                viewer.enableStickerMode(None, None, jboolean(False), None)
                viewer.prepareSegmentImage()
                ContentPreviewViewer.getInstance().setStickerSetForCustomSticker(None)
            return opened is None or bool(opened)
        except Exception:
            self.logger.exception("open editor")
            return False

    def _finish_pick(self, kind: str, account: int, dialog_id: int, reply_obj: Any, top_obj: Any,
                     path: str, caption: str, source_path: str):
        """Called after the editor's Send button, off the UI thread."""
        try:
            if kind == "sticker":
                self._deliver_sticker(account, dialog_id, reply_obj, top_obj, path, source_path)
            else:
                self._send_photo(account, dialog_id, path, reply_obj, top_obj, caption)
        except Exception as e:
            self.logger.exception("send after editor failed")
            BulletinHelper.show_error(_t("err_generic") % str(e)[:120])

    def _deliver_sticker(self, account: int, dialog_id: int, reply_obj: Any, top_obj: Any, path: str,
                         fallback_photo: str):
        """path is already a WEBP (from the editor) or a photo that must be converted first."""
        webp = path if path.lower().endswith(".webp") else make_sticker_file(path)
        try:
            if not webp:
                raise RuntimeError("no webp")
            self._send_sticker(account, dialog_id, webp, reply_obj, top_obj)
        except Exception:
            self.logger.exception("sticker failed, sending a picture")
            BulletinHelper.show_error(_t("err_sticker"))
            self._send_photo(account, dialog_id, fallback_photo or path, reply_obj, top_obj)

    def _send_pin(self, account: int, dialog_id: int, reply_obj: Any, top_obj: Any, url: str):
        try:
            _cleanup_tmp()
            path = download_image(url, bool(self.get_setting("original", False)))
            if not path:
                BulletinHelper.show_error(_t("err_download"))
                return
            mode = self._sticker_mode()
            as_sticker = mode != STICKER_OFF and self._sticker_checked()

            if as_sticker and mode == STICKER_AUTO:
                self._deliver_sticker(account, dialog_id, reply_obj, top_obj, path, path)
                return

            if True:   # the editor / caption screen is always shown
                kind = "sticker" if as_sticker else "photo"
                done = []

                def open_it():
                    done.append(self._open_viewer(kind, path, account, dialog_id, reply_obj, top_obj, path))

                _run_ui(open_it)
                for _ in range(40):          # the UI thread answers within a few ms
                    if done:
                        break
                    time.sleep(0.05)
                if done and done[0]:
                    return
                BulletinHelper.show_error(_t("err_editor"))
                if as_sticker:
                    self._deliver_sticker(account, dialog_id, reply_obj, top_obj, path, path)
                    return
            self._send_photo(account, dialog_id, path, reply_obj, top_obj)
        except Exception as e:
            self.logger.exception("send failed")
            BulletinHelper.show_error(_t("err_generic") % str(e)[:120])
