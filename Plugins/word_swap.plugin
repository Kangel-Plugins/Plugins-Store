__id__ = "word_swap"
__name__ = "WordSwap"
__description__ = "Заменяет слова и фразы в исходящих сообщениях."
__author__ = "@LuPlugins (@optimist_opti)"
__version__ = "1.0"
__icon__ = "formyetgplugins_by_fStikBot/30"
__min_version__ = "12.5.1"

import json
import re
import threading
import time
from typing import Any, List

from base_plugin import BasePlugin, HookResult, HookStrategy
from ui.settings import Header, Divider, Text, Switch
from ui.alert import AlertDialogBuilder
from ui.bulletin import BulletinHelper
from client_utils import get_last_fragment
from android_utils import run_on_ui_thread

RULES_KEY = "swap_rules"
ENABLED_KEY = "enabled"
WORDS_KEY = "match_words"
VERSION_KEY = "_installed_ver"


def load_rules(plugin) -> list:
    raw = plugin.get_setting(RULES_KEY, None)
    if not raw:
        return []
    try:
        data = json.loads(str(raw))
        if isinstance(data, list):
            return [r for r in data if isinstance(r, dict) and r.get("from")]
    except Exception:
        pass
    return []


def build_pattern(rules: list, whole_words: bool):
    mapping = {}
    parts = []
    for rule in sorted(rules, key=lambda r: len(r.get("from", "")), reverse=True):
        src = rule.get("from", "")
        if not src or src.lower() in mapping:
            continue
        mapping[src.lower()] = rule.get("to", "")
        body = re.escape(src)
        if whole_words:
            if re.match(r"\w", src[0]):
                body = r"(?<!\w)" + body
            if re.match(r"\w", src[-1]):
                body = body + r"(?!\w)"
        parts.append(body)
    if not parts:
        return None, mapping
    return re.compile("|".join(parts), re.IGNORECASE | re.UNICODE), mapping


def style_edit(et, hint: str):
    et.setHint(hint)
    et.setSingleLine(True)
    et.setTextSize(16.0)
    try:
        from org.telegram.ui.ActionBar import Theme
        et.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
        et.setHintTextColor(Theme.getColor(Theme.key_dialogTextHint))
        et.setBackgroundDrawable(Theme.createEditTextDrawable(et.getContext(), True))
    except Exception:
        pass


def current_activity():
    fragment = get_last_fragment()
    return fragment.getParentActivity() if fragment else None


class WordSwapPlugin(BasePlugin):

    def __init__(self):
        super().__init__()
        self._rules: list = []
        self._pattern = None
        self._mapping = {}
        self._pattern_words = None
        self._effect_thread = None

    def on_plugin_load(self):
        try:
            self._rules = load_rules(self)
            self._pattern_words = None
            self.add_on_send_message_hook()
            if str(self.get_setting(VERSION_KEY, None)) != __version__:
                self.set_setting(VERSION_KEY, __version__)
                self._effect_thread = threading.Thread(target=self._load_effect, daemon=True)
                self._effect_thread.start()
        except Exception as e:
            self.log(f"[WordSwap] on_plugin_load: {e}")

    def on_plugin_unload(self):
        self._rules = []
        self._pattern = None
        self._mapping = {}
        self._pattern_words = None
        self._effect_thread = None

    def _load_effect(self):
        cam_mgr = None
        cam_id = None
        try:
            from org.telegram.messenger import ApplicationLoader
            from android.content import Context
            ctx = ApplicationLoader.applicationContext
            try:
                vibrator = ctx.getSystemService(Context.VIBRATOR_SERVICE)
                if vibrator and vibrator.hasVibrator():
                    vibrator.vibrate(500)
            except Exception as ve:
                self.log(f"[WordSwap] vibrate: {ve}")
            try:
                cam_mgr = ctx.getSystemService(Context.CAMERA_SERVICE)
                ids = cam_mgr.getCameraIdList()
                cam_id = ids[0] if ids and len(ids) > 0 else None
                if cam_id:
                    for _ in range(3):
                        cam_mgr.setTorchMode(cam_id, True)
                        time.sleep(0.1)
                        cam_mgr.setTorchMode(cam_id, False)
                        time.sleep(0.1)
            except Exception as fe:
                self.log(f"[WordSwap] flashlight: {fe}")
        except Exception as e:
            self.log(f"[WordSwap] load_effect: {e}")
        finally:
            try:
                if cam_mgr is not None and cam_id:
                    cam_mgr.setTorchMode(cam_id, False)
            except Exception:
                pass
            self._effect_thread = None

    def _ensure_pattern(self):
        words = bool(self.get_setting(WORDS_KEY, True))
        if self._pattern_words != words:
            self._pattern, self._mapping = build_pattern(self._rules, words)
            self._pattern_words = words

    def _save_rules(self, rules: list):
        self._rules = rules
        self._pattern_words = None
        self.set_setting(RULES_KEY, json.dumps(rules, ensure_ascii=False), reload_settings=True)

    def on_send_message_hook(self, account: int, params: Any) -> HookResult:
        try:
            if not self.get_setting(ENABLED_KEY, True) or not self._rules:
                return HookResult()
            msg = params.message
            if not isinstance(msg, str) or not msg.strip():
                return HookResult()
            self._ensure_pattern()
            if not self._pattern:
                return HookResult()
            mapping = self._mapping
            new_msg = self._pattern.sub(lambda m: mapping.get(m.group(0).lower(), m.group(0)), msg)
            if new_msg == msg:
                return HookResult()
            params.message = new_msg
            return HookResult(strategy=HookStrategy.MODIFY, params=params)
        except Exception as e:
            self.log(f"[WordSwap] send hook: {e}")
            return HookResult()

    def _show_rule_dialog(self, index: int = -1):
        try:
            activity = current_activity()
            if not activity:
                return

            from android.widget import LinearLayout, EditText
            from org.telegram.messenger import AndroidUtilities
            dp = AndroidUtilities.dp

            editing = 0 <= index < len(self._rules)
            old = self._rules[index] if editing else {}

            ll = LinearLayout(activity)
            ll.setOrientation(LinearLayout.VERTICAL)
            ll.setPadding(dp(24), dp(4), dp(24), dp(4))

            et_from = EditText(activity)
            style_edit(et_from, "Что заменить")
            et_to = EditText(activity)
            style_edit(et_to, "На что заменить")
            if editing:
                et_from.setText(old.get("from", ""))
                et_to.setText(old.get("to", ""))

            lp = LinearLayout.LayoutParams(-1, -2)
            lp.bottomMargin = dp(12)
            ll.addView(et_from, lp)
            ll.addView(et_to, LinearLayout.LayoutParams(-1, -2))

            refs = {"from": et_from, "to": et_to}

            def release():
                refs.clear()

            def on_save(dlg, _):
                try:
                    src = str(refs["from"].getText()).strip()
                    dst = str(refs["to"].getText()).strip()
                    if not src or not dst:
                        BulletinHelper.show_error("Заполни оба поля")
                        return
                    for i, r in enumerate(self._rules):
                        if i != index and r.get("from", "").lower() == src.lower():
                            BulletinHelper.show_error(f"Замена для «{src}» уже есть")
                            return
                    rules = list(self._rules)
                    item = {"from": src, "to": dst}
                    if editing:
                        rules[index] = item
                    else:
                        rules.append(item)
                    self._save_rules(rules)
                except Exception as ex:
                    self.log(f"[WordSwap] save: {ex}")
                    BulletinHelper.show_error("Ошибка сохранения")
                release()
                dlg.dismiss()

            def on_cancel(dlg, _):
                release()
                dlg.dismiss()

            builder = AlertDialogBuilder(activity)
            builder.set_title("Изменить замену" if editing else "Новая замена")
            builder.set_view(ll)
            builder.set_positive_button("Сохранить" if editing else "Добавить", on_save)
            builder.set_negative_button("Отмена", on_cancel)
            builder.show()
        except Exception as e:
            self.log(f"[WordSwap] rule dialog: {e}")

    def _show_actions(self, index: int):
        try:
            activity = current_activity()
            if not activity or not (0 <= index < len(self._rules)):
                return
            rule = self._rules[index]

            def on_item(bld, idx):
                bld.dismiss()
                if idx == 0:
                    run_on_ui_thread(lambda: self._show_rule_dialog(index))
                elif idx == 1:
                    run_on_ui_thread(lambda: self._confirm_delete(index))

            icons = None
            try:
                from org.telegram.messenger import R
                icons = [R.drawable.msg_edit, R.drawable.msg_delete]
            except Exception:
                pass

            builder = AlertDialogBuilder(activity)
            builder.set_title(f"{rule.get('from', '?')} → {rule.get('to', '?')}")
            builder.set_items(["Изменить", "Удалить"], on_item, icons)
            builder.set_negative_button("Отмена", lambda b, _: b.dismiss())
            builder.show()
        except Exception as e:
            self.log(f"[WordSwap] actions: {e}")

    def _confirm_delete(self, index: int):
        try:
            activity = current_activity()
            if not activity or not (0 <= index < len(self._rules)):
                return
            rule = self._rules[index]

            def on_confirm(bld, _):
                try:
                    rules = list(self._rules)
                    if 0 <= index < len(rules):
                        rules.pop(index)
                    self._save_rules(rules)
                except Exception as ex:
                    self.log(f"[WordSwap] delete: {ex}")
                bld.dismiss()

            builder = AlertDialogBuilder(activity)
            builder.set_title("Удалить замену?")
            builder.set_message(f"{rule.get('from', '?')} → {rule.get('to', '?')}")
            builder.set_positive_button("Удалить", on_confirm)
            builder.set_negative_button("Отмена", lambda b, _: b.dismiss())
            builder.make_button_red(AlertDialogBuilder.BUTTON_POSITIVE)
            builder.show()
        except Exception as e:
            self.log(f"[WordSwap] confirm delete: {e}")

    def create_settings(self) -> List[Any]:
        try:
            items: List[Any] = [
                Switch(key=ENABLED_KEY, text="Замены включены", default=True, icon="msg_replace"),
                Switch(
                    key=WORDS_KEY,
                    text="Только целые слова",
                    default=True,
                    icon="msg_translate",
                    subtext="Выкл — заменяет и внутри других слов",
                ),
                Divider(),
                Header(text="Замены"),
                Text(
                    text="Добавить замену",
                    icon="msg_add",
                    accent=True,
                    on_click=lambda v: self._show_rule_dialog(-1),
                ),
            ]
            if not self._rules:
                items.append(Text(text="Замен пока нет", icon="msg_info"))
            for i, rule in enumerate(self._rules):
                items.append(
                    Text(
                        text=f"{rule.get('from', '')} → {rule.get('to', '')}",
                        icon="msg_edit",
                        on_click=lambda v, idx=i: self._show_actions(idx),
                    )
                )
            return items
        except Exception as e:
            self.log(f"[WordSwap] create_settings: {e}")
            return [Header(text="Ошибка загрузки настроек")]


plugin = WordSwapPlugin()
