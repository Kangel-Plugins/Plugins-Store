TOP_RESULTS_COUNT = 5

DEFAULT_QUICK_REACTIONS = (
    "👍, ❤️, 🔥, 😂, ⭐, 💎, 🎉, 😁, 😱, 😢, "
    "👎, 💩, 🤡, 🤬, 🥰, 🤯, 🤔, 👏, 💯, 🐳"
)


def to_color(hex_val):
    return int(hex_val - 0x100000000) if hex_val > 0x7FFFFFFF else hex_val


def get_theme_colors():
    """Возвращает цвета текста и элементов в зависимости от текущей темы Telegram."""
    is_dark = False
    try:
        is_dark = Theme.isCurrentThemeDark()
    except Exception:
        pass

    if is_dark:
        return {
            "primary": to_color(0xFFFFFFFF),     # Белый
            "secondary": to_color(0xFFB0B0B0),   # Светло-серый
            "accent": to_color(0xFF64B5F6),      # Голубой акцент
            "custom_bg": to_color(0x2664B5F6),   # Фон плашки кастомного эмодзи
            "hint": to_color(0xFF888888),        # Подсказки
            "divider": to_color(0x33FFFFFF),     # Разделитель
            "card_bg": to_color(0x18FFFFFF)      # Фон карточки сообщения
        }
    else:
        return {
            "primary": to_color(0xFF000000),     # Чёрный
            "secondary": to_color(0xFF555555),   # Тёмно-серый
            "accent": to_color(0xFF1976D2),      # Синий акцент
            "custom_bg": to_color(0x1A1976D2),   # Фон плашки кастомного эмодзи
            "hint": to_color(0xFF888888),        # Подсказки
            "divider": to_color(0x22000000),     # Разделитель
            "card_bg": to_color(0x0D000000)      # Фон карточки сообщения
        }


def normalize_emoji(emj):
    """Убирает невидимые селекторы вариаций (\ufe0f), чтобы ❤️ и ❤ совпадали."""
    if not emj:
        return ""
    return emj.replace("\ufe0f", "").replace("\ufe0e", "").strip()


def fmt_date(ts):
    if not ts:
        return ""
    try:
        return datetime.fromtimestamp(ts).strftime("%d.%m.%Y %H:%M")
    except Exception:
        return ""


def get_custom_emoji_alt(account, doc_id, custom_cache=None):
    """Пытается получить базовый смайлик (alt) для кастомного эмодзи по его document_id."""
    if custom_cache and doc_id in custom_cache:
        return custom_cache[doc_id]
    try:
        doc = AnimatedEmojiDrawable.findDocument(account, int(doc_id))
        if doc:
            alt = MessageObject.findAnimatedEmojiEmoticon(doc, "💎")
            if alt:
                if custom_cache is not None:
                    custom_cache[doc_id] = alt
                return alt
    except Exception:
        pass
    return "💎"


def extract_custom_doc_id_from_edit(edit_text):
    """
    Извлекает document_id кастомного эмодзи, если пользователь вставил
    Premium-эмодзи в EditText (через AnimatedEmojiSpan) или ввел числовой ID.
    """
    try:
        editable = edit_text.getText()
        if isinstance(editable, Spanned):
            spans = editable.getSpans(0, editable.length(), AnimatedEmojiSpan)
            if spans and len(spans) > 0:
                return int(spans[0].getDocumentId())
    except Exception:
        pass

    raw = edit_text.getText().toString().strip()
    if raw.startswith("id:"):
        raw = raw[3:].strip()
    if raw.isdigit() and len(raw) >= 10:
        return int(raw)
    return None


def get_reaction_info(account, reaction_obj, custom_cache=None):
    """
    Возвращает кортеж (key, label):
    - для обычного эмодзи: ("emoji:👍", "👍")
    - для Telegram Stars: ("paid", "⭐")
    - для кастомного эмодзи: ("custom:<doc_id>", "💎<alt>")
    """
    if reaction_obj is None:
        return ("unknown", "❓")
    cls_name = reaction_obj.getClass().getSimpleName()
    if isinstance(reaction_obj, TLRPC.TL_reactionEmoji) or "reactionEmoji" in cls_name:
        emj = getattr(reaction_obj, "emoticon", "❓")
        return ("emoji:" + normalize_emoji(emj), emj)
    if "reactionPaid" in cls_name:
        return ("paid", "⭐")
    if isinstance(reaction_obj, TLRPC.TL_reactionCustomEmoji) or "reactionCustomEmoji" in cls_name:
        doc_id = int(getattr(reaction_obj, "document_id", 0))
        alt = get_custom_emoji_alt(account, doc_id, custom_cache)
        lbl = f"💎{alt}" if alt != "💎" else f"💎({str(doc_id)[-4:]})"
        return (f"custom:{doc_id}", lbl)
    return ("unknown", "❓")


def get_sender_name(account, msg, self_id):
    """Определяет имя отправителя сообщения."""
    try:
        if getattr(msg, "out", False):
            return "Вы"
        from_id = getattr(msg, "from_id", None)
        if not from_id:
            return "Канал"
        ctrl = MessagesController.getInstance(account)
        if isinstance(from_id, TLRPC.TL_peerUser):
            uid = from_id.user_id
            if uid == self_id:
                return "Вы"
            user = ctrl.getUser(uid)
            if user:
                name = ContactsController.formatName(
                    getattr(user, "first_name", "") or "",
                    getattr(user, "last_name", "") or ""
                ).strip()
                return name if name else (getattr(user, "username", "") or f"ID {uid}")
            return f"User {uid}"
        if isinstance(from_id, (TLRPC.TL_peerChat, TLRPC.TL_peerChannel)):
            cid = getattr(from_id, "channel_id", 0) or getattr(from_id, "chat_id", 0)
            chat = ctrl.getChat(cid)
            if chat and getattr(chat, "title", None):
                return chat.title
    except Exception:
        pass
    return "Участник"


def format_msg_reactions_breakdown(account, msg, custom_cache):
    """Формирует строку всех реакций под сообщением (включая кастомные и Stars)."""
    try:
        reactions_obj = getattr(msg, "reactions", None)
        if not reactions_obj:
            return ""
        results = getattr(reactions_obj, "results", None)
        if not results:
            return ""
        items = []
        for i in range(results.size()):
            rc = results.get(i)
            cnt = getattr(rc, "count", 0)
            if cnt > 0:
                _key, lbl = get_reaction_info(account, getattr(rc, "reaction", None), custom_cache)
                items.append((lbl, cnt))
        items.sort(key=lambda x: -x[1])
        return "   ".join([f"{lbl} {cnt}" for lbl, cnt in items[:8]])
    except Exception:
        return ""


class TopReactionFinderPlugin(BasePlugin):

    def __init__(self):
        super().__init__()
        self.is_processing = False
        self.cancelled = False
        self.progress_dialog = None
        self.current_dialog_id = 0
        self.chosen_filter = None       # None (все), "paid", "custom_all", "custom:<doc_id>", "emoji:<norm>"
        self.chosen_display = "🔥"
        self.selected_custom_id = None  # Если выбрали конкретный кастомный эмодзи кнопкой
        self.only_mine = False
        self.top_messages = []          # Список (count, msg_id, msg)
        self.global_reactions = {}      # label -> общее число
        self.custom_alt_cache = {}      # doc_id -> alt emoji
        self.total_reactions_sum = 0
        self.last_msg_id = 0
        self.total_scanned = 0
        self.search_limit = 500

    def on_plugin_load(self):
        self.add_menu_item(MenuItemData(
            menu_type=MenuItemType.CHAT_ACTION_MENU,
            text="Поиск по реакции",
            icon="msg_reactions_solar",
            on_click=self.on_menu_click
        ))

    # ------------------------------------------------------------------
    # Настройки плагина (лимит + свой набор быстрых эмодзи)
    # ------------------------------------------------------------------
    def create_settings(self):
        try:
            limit = self._get_limit()
            current_lim = str(limit) if limit > 0 else "Без ограничений"
            custom_list = self._get_quick_reactions_str()
            return [
                Header(text="Настройки поиска"),
                Text(
                    text="Лимит по умолчанию: " + current_lim,
                    icon="msg_list",
                    on_click=lambda *args: run_on_ui_thread(self._show_limit_dialog)
                ),
                Text(
                    text="Свои быстрые эмодзи: " + (custom_list[:28] + "..." if len(custom_list) > 28 else custom_list),
                    icon="msg_reactions_solar",
                    on_click=lambda *args: run_on_ui_thread(self._show_custom_quick_list_dialog)
                ),
                Header(text="Как искать кастомные эмодзи"),
                Text(
                    text="1. Нажми на найденный кастомный эмодзи из блока «Кастомные реакции в этом чате».\n"
                         "2. Или просто вставь любой кастомный Premium-эмодзи с клавиатуры Telegram прямо в поле ввода!",
                    icon="msg_info"
                ),
            ]
        except Exception as e:
            return [Header(text="Ошибка настроек: " + str(e))]

    def _get_limit(self):
        try:
            val = int(self.get_setting("msg_limit", 500))
            return max(0, val)
        except Exception:
            return 500

    def _get_quick_reactions_str(self):
        try:
            val = self.get_setting("quick_emojis", DEFAULT_QUICK_REACTIONS)
            return str(val) if val else DEFAULT_QUICK_REACTIONS
        except Exception:
            return DEFAULT_QUICK_REACTIONS

    def _get_quick_reactions_list(self):
        raw = self._get_quick_reactions_str()
        items = [x.strip() for x in raw.replace(";", ",").split(",") if x.strip()]
        return items if items else ["👍", "❤️", "🔥", "😂", "⭐", "💎"]

    def _show_limit_dialog(self):
        act = LaunchActivity.instance
        if not act:
            return
        colors = get_theme_colors()
        dp = AndroidUtilities.dp
        current = self._get_limit()

        container = LinearLayout(act)
        container.setOrientation(LinearLayout.VERTICAL)
        container.setPadding(dp(20), dp(12), dp(20), dp(8))

        hint = TextView(act)
        hint.setText("Макс. сообщений по умолчанию (0 = без ограничений):")
        hint.setTextSize(14.0)
        hint.setTextColor(colors["primary"])
        hint.setPadding(0, 0, 0, dp(8))
        container.addView(hint)

        edit = EditText(act)
        edit.setInputType(0x00000002)
        edit.setText(str(current))
        edit.setTextColor(colors["primary"])
        edit.setHintTextColor(colors["hint"])
        edit.setSelectAllOnFocus(True)
        container.addView(edit)

        def on_save(b, w):
            try:
                val = max(0, int(edit.getText().toString().strip()))
                self.set_setting("msg_limit", val)
                lbl = str(val) if val > 0 else "Без ограничений"
                BulletinHelper.show_success("Лимит сохранён: " + lbl)
            except Exception:
                BulletinHelper.show_error("Введите корректное число")
            b.dismiss()

        builder = AlertDialogBuilder(act)
        builder.set_title("Лимит сообщений")
        builder.set_view(container)
        builder.set_positive_button("Сохранить", on_save)
        builder.set_negative_button("Отмена", lambda b, w: b.dismiss())
        builder.show()

    def _show_custom_quick_list_dialog(self):
        act = LaunchActivity.instance
        if not act:
            return
        colors = get_theme_colors()
        dp = AndroidUtilities.dp

        container = LinearLayout(act)
        container.setOrientation(LinearLayout.VERTICAL)
        container.setPadding(dp(20), dp(12), dp(20), dp(8))

        hint = TextView(act)
        hint.setText("Укажи свои любимые эмодзи или ID кастомных реакций через запятую:")
        hint.setTextSize(13.5)
        hint.setTextColor(colors["primary"])
        hint.setPadding(0, 0, 0, dp(8))
        container.addView(hint)

        edit = EditText(act)
        edit.setText(self._get_quick_reactions_str())
        edit.setTextColor(colors["primary"])
        edit.setHintTextColor(colors["hint"])
        container.addView(edit)

        def on_save(b, w):
            val = edit.getText().toString().strip()
            self.set_setting("quick_emojis", val if val else DEFAULT_QUICK_REACTIONS)
            BulletinHelper.show_success("Список быстрых реакций обновлён")
            b.dismiss()

        def on_reset(b, w):
            self.set_setting("quick_emojis", DEFAULT_QUICK_REACTIONS)
            BulletinHelper.show_info("Восстановлен список по умолчанию")
            b.dismiss()

        builder = AlertDialogBuilder(act)
        builder.set_title("Свои быстрые эмодзи")
        builder.set_view(container)
        builder.set_positive_button("Сохранить", on_save)
        builder.set_neutral_button("Сброс", on_reset)
        builder.set_negative_button("Отмена", lambda b, w: b.dismiss())
        builder.show()

    # ------------------------------------------------------------------
    # Окно выбора реакции + авто-поиск кастомных эмодзи в чате
    # ------------------------------------------------------------------
    def on_menu_click(self, param):
        if self.is_processing:
            BulletinHelper.show_error("Поиск уже выполняется...")
            return
        self.current_dialog_id = param.get("dialog_id")
        run_on_ui_thread(self._show_reaction_picker)

    def _show_reaction_picker(self):
        act = LaunchActivity.instance
        if not act:
            return

        colors = get_theme_colors()
        dp = AndroidUtilities.dp
        self.selected_custom_id = None

        container = LinearLayout(act)
        container.setOrientation(LinearLayout.VERTICAL)
        container.setPadding(dp(20), dp(12), dp(20), dp(8))

        hint = TextView(act)
        hint.setText("Введи/вставь любой эмодзи (включая свой Premium-эмодзи) или выбери ниже:")
        hint.setTextSize(13.0)
        hint.setTextColor(colors["secondary"])
        hint.setPadding(0, 0, 0, dp(6))
        container.addView(hint)

        edit = EditText(act)
        edit.setHint("Все реакции сразу (🔥)")
        edit.setTextSize(20.0)
        edit.setGravity(Gravity.CENTER)
        edit.setTextColor(colors["primary"])
        edit.setHintTextColor(colors["hint"])
        container.addView(edit)

        status_tv = TextView(act)
        status_tv.setText("Режим: поиск по сумме ВСЕХ реакций")
        status_tv.setTextSize(12.0)
        status_tv.setTextColor(colors["accent"])
        status_tv.setGravity(Gravity.CENTER)
        status_tv.setPadding(0, dp(2), 0, dp(4))
        container.addView(status_tv)

        def select_quick_item(item_str):
            if item_str == "":
                self.selected_custom_id = None
                edit.setText("")
                status_tv.setText("Режим: поиск по сумме ВСЕХ реакций")
            elif item_str == "⭐":
                self.selected_custom_id = None
                edit.setText("⭐")
                status_tv.setText("Режим: поиск платных реакций (Telegram Stars)")
            elif item_str == "💎":
                self.selected_custom_id = None
                edit.setText("💎")
                status_tv.setText("Режим: поиск ВСЕХ кастомных Premium-эмодзи")
            else:
                self.selected_custom_id = None
                edit.setText(item_str)
                status_tv.setText(f"Режим: поиск реакции {item_str}")

        # 1. Быстрые кнопки из настроек
        h_scroll = HorizontalScrollView(act)
        h_scroll.setPadding(0, dp(4), 0, dp(4))
        emoji_row = LinearLayout(act)
        emoji_row.setOrientation(LinearLayout.HORIZONTAL)

        clear_btn = TextView(act)
        clear_btn.setText("ВСЕ")
        clear_btn.setTextSize(13.0)
        clear_btn.setTypeface(None, Typeface.BOLD)
        clear_btn.setTextColor(colors["accent"])
        clear_btn.setGravity(Gravity.CENTER)
        clear_btn.setPadding(dp(10), dp(6), dp(10), dp(6))
        clear_btn.setOnClickListener(OnClickListener(lambda _v: select_quick_item("")))
        emoji_row.addView(clear_btn)

        for emj in self._get_quick_reactions_list():
            btn = TextView(act)
            btn.setText(emj)
            btn.setTextSize(21.0)
            btn.setPadding(dp(8), dp(4), dp(8), dp(4))
            btn.setOnClickListener(OnClickListener(lambda _v, e=emj: select_quick_item(e)))
            emoji_row.addView(btn)

        h_scroll.addView(emoji_row)
        container.addView(h_scroll)

        # 2. Динамический блок кастомных эмодзи, обнаруженных в этом чате
        custom_hdr = TextView(act)
        custom_hdr.setText("Кастомные реакции в этом чате (загрузка...):")
        custom_hdr.setTextSize(12.5)
        custom_hdr.setTextColor(colors["secondary"])
        custom_hdr.setPadding(0, dp(6), 0, dp(4))
        container.addView(custom_hdr)

        custom_scroll = HorizontalScrollView(act)
        custom_scroll.setPadding(0, dp(2), 0, dp(6))
        custom_row = LinearLayout(act)
        custom_row.setOrientation(LinearLayout.HORIZONTAL)
        custom_scroll.addView(custom_row)
        container.addView(custom_scroll)

        def on_custom_chip_click(doc_id, label_str):
            self.selected_custom_id = doc_id
            edit.setText(f"id:{doc_id}")
            status_tv.setText(f"Выбран кастомный эмодзи {label_str} (ID: {doc_id})")

        # Фоновая подгрузка кастомных эмодзи из последних 100 сообщений чата
        self._preload_chat_custom_emojis(custom_hdr, custom_row, on_custom_chip_click, colors)

        # Чекбокс "Только мои сообщения"
        only_mine_cb = CheckBox(act)
        only_mine_cb.setText("Искать только среди моих сообщений")
        only_mine_cb.setTextSize(14.0)
        only_mine_cb.setTextColor(colors["primary"])
        only_mine_cb.setChecked(False)
        container.addView(only_mine_cb)

        # Лимит сообщений
        lim_lbl = TextView(act)
        lim_lbl.setText("Лимит сообщений для проверки (0 = все):")
        lim_lbl.setTextSize(13.0)
        lim_lbl.setTextColor(colors["secondary"])
        lim_lbl.setPadding(0, dp(6), 0, dp(2))
        container.addView(lim_lbl)

        lim_edit = EditText(act)
        lim_edit.setInputType(0x00000002)
        lim_edit.setText(str(self._get_limit()))
        lim_edit.setTextSize(14.0)
        lim_edit.setTextColor(colors["primary"])
        lim_edit.setHintTextColor(colors["hint"])
        container.addView(lim_edit)

        def on_search(b, w):
            b.dismiss()
            raw_lim = lim_edit.getText().toString().strip()
            try:
                limit = max(0, int(raw_lim)) if raw_lim else self._get_limit()
            except ValueError:
                limit = self._get_limit()

            only_mine = bool(only_mine_cb.isChecked())
            account = UserConfig.selectedAccount

                        # 1. Проверяем, вставлен ли кастомный эмодзи через клавиатуру (AnimatedEmojiSpan) или выбран чипом
            span_doc_id = extract_custom_doc_id_from_edit(edit)
            if span_doc_id:
                alt = get_custom_emoji_alt(account, span_doc_id, self.custom_alt_cache)
                disp = f"💎{alt}" if alt != "💎" else f"💎({str(span_doc_id)[-4:]})"
                self._start_search(f"custom:{span_doc_id}", disp, limit, only_mine)
                return

            raw_text = edit.getText().toString().strip()
            if not raw_text:
                self._start_search(None, "🔥", limit, only_mine)
            elif raw_text == "⭐":
                self._start_search("paid", "⭐", limit, only_mine)
            elif raw_text == "💎":
                self._start_search("custom_all", "💎", limit, only_mine)
            else:
                self._start_search("emoji:" + normalize_emoji(raw_text), raw_text, limit, only_mine)

        builder = AlertDialogBuilder(act)
        builder.set_title("Поиск по реакции")
        builder.set_view(container)
        builder.set_positive_button("Найти", on_search)
        builder.set_negative_button("Отмена", lambda b, w: b.dismiss())
        builder.show()

    def _preload_chat_custom_emojis(self, header_tv, row_layout, on_chip_click, colors):
        """Сканирует последние 100 сообщений чата, чтобы показать кнопки всех кастомных реакций чата."""
        account = UserConfig.selectedAccount
        controller = MessagesController.getInstance(account)
        req = TLRPC.TL_messages_getHistory()
        req.peer = controller.getInputPeer(self.current_dialog_id)
        req.offset_id = 0
        req.limit = 100
        req.add_offset = 0
        req.min_id = 0
        req.max_id = 0
        req.hash = 0

        def on_resp(response, error):
            if error or not response or response.messages.isEmpty():
                run_on_ui_thread(lambda: header_tv.setText("Кастомные реакции: вставь любой Premium-эмодзи в поле выше"))
                return

            found_custom = {}  # doc_id -> sum_count
            msgs = response.messages
            for i in range(msgs.size()):
                m = msgs.get(i)
                r_obj = getattr(m, "reactions", None)
                if not r_obj or not getattr(r_obj, "results", None):
                    continue
                res = r_obj.results
                for j in range(res.size()):
                    rc = res.get(j)
                    react = getattr(rc, "reaction", None)
                    if react is None:
                        continue
                    cls_name = react.getClass().getSimpleName()
                    if isinstance(react, TLRPC.TL_reactionCustomEmoji) or "reactionCustomEmoji" in cls_name:
                        did = int(getattr(react, "document_id", 0))
                        if did:
                            found_custom[did] = found_custom.get(did, 0) + getattr(rc, "count", 0)

            def _populate_ui():
                act = LaunchActivity.instance
                if not act:
                    return
                if not found_custom:
                    header_tv.setText("В последних 100 сообщ. нет кастомных (можно вставить свой в поле выше)")
                    return

                header_tv.setText("Кастомные реакции в этом чате (нажми для выбора):")
                dp = AndroidUtilities.dp
                for did, cnt in sorted(found_custom.items(), key=lambda x: -x[1])[:15]:
                    alt = get_custom_emoji_alt(account, did, self.custom_alt_cache)
                    lbl = f"💎{alt}" if alt != "💎" else f"💎#{str(did)[-4:]}"
                    chip = TextView(act)
                    chip.setText(f"{lbl} ({cnt})")
                    chip.setTextSize(13.5)
                    chip.setTypeface(None, Typeface.BOLD)
                    chip.setTextColor(colors["primary"])
                    chip.setBackgroundColor(colors["custom_bg"])
                    chip.setPadding(dp(10), dp(6), dp(10), dp(6))
                    lp = LinearLayout.LayoutParams(
                        LinearLayout.LayoutParams.WRAP_CONTENT,
                        LinearLayout.LayoutParams.WRAP_CONTENT
                    )
                    lp.rightMargin = dp(6)
                    chip.setLayoutParams(lp)
                    chip.setOnClickListener(OnClickListener(lambda _v, d=did, l=lbl: on_chip_click(d, l)))
                    row_layout.addView(chip)

            run_on_ui_thread(_populate_ui)

        send_request(req, on_resp)

    # ------------------------------------------------------------------
    # Сканирование истории
    # ------------------------------------------------------------------
    def _start_search(self, filter_key, display_lbl, limit, only_mine):
        self.chosen_filter = filter_key
        self.chosen_display = display_lbl
        self.only_mine = only_mine
        self.top_messages = []
        self.global_reactions = {}
        self.total_reactions_sum = 0
        self.last_msg_id = 0
        self.total_scanned = 0
        self.search_limit = limit
        self.is_processing = True
        self.cancelled = False

        self._show_progress()
        self._fetch_chunk()

    def _show_progress(self):
        def _run():
            try:
                act = LaunchActivity.instance
                if not act:
                    return
                lim_str = str(self.search_limit) if self.search_limit > 0 else "MAX"
                self.progress_dialog = ProgressDialog(act)
                self.progress_dialog.setMessage(f"Просмотрено: 0 / {lim_str}")
                self.progress_dialog.setCancelable(False)

                def on_cancel(_dlg, _which):
                    self.cancelled = True

                self.progress_dialog.setButton(
                    DialogInterface.BUTTON_NEGATIVE,
                    "Стоп",
                    on_cancel
                )
                self.progress_dialog.show()
            except Exception:
                pass
        run_on_ui_thread(_run)

    def _update_progress(self):
        def _run():
            if self.progress_dialog and self.progress_dialog.isShowing():
                lim_str = str(self.search_limit) if self.search_limit > 0 else "MAX"
                msg = f"Просмотрено: {self.total_scanned} / {lim_str}"
                if self.top_messages:
                    best_cnt = self.top_messages[0][0]
                    msg += f" | Лидер: {best_cnt} {self.chosen_display}"
                self.progress_dialog.setMessage(msg)
        run_on_ui_thread(_run)

    def _hide_progress(self):
        def _run():
            if self.progress_dialog:
                try:
                    self.progress_dialog.dismiss()
                except Exception:
                    pass
                self.progress_dialog = None
        run_on_ui_thread(_run)

    def _fetch_chunk(self):
        if not self.is_processing or self.cancelled:
            self._finish()
            return

        if self.search_limit > 0 and self.total_scanned >= self.search_limit:
            self._finish()
            return

        account = UserConfig.selectedAccount
        controller = MessagesController.getInstance(account)

        remaining = (self.search_limit - self.total_scanned) if self.search_limit > 0 else 100
        batch_size = min(100, remaining) if self.search_limit > 0 else 100

        req = TLRPC.TL_messages_getHistory()
        req.peer = controller.getInputPeer(self.current_dialog_id)
        req.offset_id = self.last_msg_id
        req.limit = batch_size
        req.add_offset = 0
        req.min_id = 0
        req.max_id = 0
        req.hash = 0

        send_request(req, lambda resp, err: self._on_history_response(resp, err, batch_size))

    def _on_history_response(self, response, error, batch_size):
        if self.cancelled:
            self._finish()
            return

        if error:
            err_text = getattr(error, "text", "Unknown error")
            if "FLOOD_WAIT" in err_text and self.total_scanned > 0:
                run_on_ui_thread(lambda: BulletinHelper.show_error(f"Лимит Telegram ({err_text}). Показаны собранные результаты."))
                self._finish()
            else:
                self.is_processing = False
                self._hide_progress()
                run_on_ui_thread(lambda: BulletinHelper.show_error("Ошибка: " + str(err_text)))
            return

        messages = response.messages
        if messages.isEmpty():
            self._finish()
            return

        account = UserConfig.selectedAccount
        self_id = UserConfig.getInstance(account).getClientUserId()
        scanned_in_batch = 0

        for i in range(messages.size()):
            if self.cancelled or (self.search_limit > 0 and self.total_scanned + scanned_in_batch >= self.search_limit):
                break

            msg = messages.get(i)
            self.last_msg_id = msg.id
            scanned_in_batch += 1

            if getattr(msg, "action", None) is not None:
                continue

            if self.only_mine:
                is_mine = bool(getattr(msg, "out", False))
                from_id = getattr(msg, "from_id", None)
                if isinstance(from_id, TLRPC.TL_peerUser) and from_id.user_id == self_id:
                    is_mine = True
                if not is_mine:
                    continue

            count = self._process_message_reactions(account, msg, self.chosen_filter)
            if count > 0:
                self.top_messages.append((count, msg.id, msg))
                self.top_messages.sort(key=lambda x: (x[0], x[1]), reverse=True)
                if len(self.top_messages) > TOP_RESULTS_COUNT:
                    self.top_messages = self.top_messages[:TOP_RESULTS_COUNT]

        self.total_scanned += scanned_in_batch
        self._update_progress()

        limit_reached = (self.search_limit > 0 and self.total_scanned >= self.search_limit)
        if messages.size() < batch_size or limit_reached or self.cancelled:
            self._finish()
        else:
            threading.Timer(0.15, self._fetch_chunk).start()

    def _process_message_reactions(self, account, msg, filter_key):
        """Считает общую статистику реакций и возвращает число целевых реакций для сообщения."""
        try:
            reactions_obj = getattr(msg, "reactions", None)
            if not reactions_obj:
                return 0
            results = getattr(reactions_obj, "results", None)
            if not results:
                return 0

            matched_count = 0

            for i in range(results.size()):
                rc = results.get(i)
                cnt = getattr(rc, "count", 0)
                if cnt <= 0:
                    continue

                reaction = getattr(rc, "reaction", None)
                r_key, r_label = get_reaction_info(account, reaction, self.custom_alt_cache)

                # Обновляем глобальную сводку чата
                self.global_reactions[r_label] = self.global_reactions.get(r_label, 0) + cnt
                self.total_reactions_sum += cnt

                # Сопоставление с выбранным фильтром
                if filter_key is None:
                    matched_count += cnt
                elif filter_key == "custom_all":
                    if r_key.startswith("custom:"):
                        matched_count += cnt
                elif filter_key == r_key:
                    matched_count += cnt
                elif filter_key.startswith("emoji:") and r_key.startswith("custom:"):
                    # Если пользователь ввел обычный смайлик, но это кастомный эмодзи с таким же alt
                    target_emj = filter_key.split(":", 1)[1]
                    doc_id = int(r_key.split(":", 1)[1])
                    alt_emj = normalize_emoji(get_custom_emoji_alt(account, doc_id, self.custom_alt_cache))
                    if target_emj and alt_emj == target_emj:
                        matched_count += cnt

            return matched_count
        except Exception:
            return 0

    # ------------------------------------------------------------------
    # Отображение Топ-5 и сводки
    # ------------------------------------------------------------------
    def _finish(self):
        self.is_processing = False
        self._hide_progress()
        if not self.top_messages:
            run_on_ui_thread(lambda: BulletinHelper.show_info("Сообщений с такой реакцией не найдено."))
            return
        run_on_ui_thread(self._show_result_dialog)

    def _show_result_dialog(self):
        act = LaunchActivity.instance
        if not act:
            return

        colors = get_theme_colors()
        dp = AndroidUtilities.dp
        account = UserConfig.selectedAccount
        self_id = UserConfig.getInstance(account).getClientUserId()

        main = LinearLayout(act)
        main.setOrientation(LinearLayout.VERTICAL)

        scroll = ScrollView(act)
        scroll.setPadding(dp(16), dp(10), dp(16), dp(10))

        container = LinearLayout(act)
        container.setOrientation(LinearLayout.VERTICAL)

        # 1. Блок общей сводки
        summary_title = TextView(act)
        filter_lbl = f"фильтр: {self.chosen_display}" if self.chosen_filter else "все реакции"
        if self.only_mine:
            filter_lbl += ", только мои"
        summary_title.setText(f"Сводка ({filter_lbl})")
        summary_title.setTextSize(14.0)
        summary_title.setTypeface(None, Typeface.BOLD)
        summary_title.setTextColor(colors["primary"])
        container.addView(summary_title)

        top_global = sorted(self.global_reactions.items(), key=lambda x: -x[1])[:6]
        top_global_str = "  ".join([f"{k} {v}" for k, v in top_global]) if top_global else "—"

        summary_info = TextView(act)
        status_sfx = " (остановлено)" if self.cancelled else ""
        summary_info.setText(
            f"Проверено сообщений: {self.total_scanned}{status_sfx}\n"
            f"Всего реакций найдено: {self.total_reactions_sum}\n"
            f"Топ реакций чата: {top_global_str}"
        )
        summary_info.setTextSize(13.0)
        summary_info.setTextColor(colors["secondary"])
        summary_info.setPadding(0, dp(4), 0, dp(8))
        container.addView(summary_info)

        div = View(act)
        div_lp = LinearLayout.LayoutParams(LinearLayout.LayoutParams.MATCH_PARENT, dp(1))
        div_lp.bottomMargin = dp(8)
        div.setLayoutParams(div_lp)
        div.setBackgroundColor(colors["divider"])
        container.addView(div)

        hint_click = TextView(act)
        hint_click.setText(f"Топ-{len(self.top_messages)} сообщений (нажми на карточку для перехода):")
        hint_click.setTextSize(13.0)
        hint_click.setTypeface(None, Typeface.BOLD)
        hint_click.setTextColor(colors["primary"])
        hint_click.setPadding(0, 0, 0, dp(6))
        container.addView(hint_click)

        builder = AlertDialogBuilder(act)

        # 2. Карточки Топ-5 сообщений
        for rank, (cnt, _mid, msg) in enumerate(self.top_messages, 1):
            card = LinearLayout(act)
            card.setOrientation(LinearLayout.VERTICAL)
            card.setBackgroundColor(colors["card_bg"])
            card.setPadding(dp(12), dp(10), dp(12), dp(10))

            card_lp = LinearLayout.LayoutParams(
                LinearLayout.LayoutParams.MATCH_PARENT,
                LinearLayout.LayoutParams.WRAP_CONTENT
            )
            card_lp.bottomMargin = dp(8)
            card.setLayoutParams(card_lp)

            sender = get_sender_name(account, msg, self_id)
            date_str = fmt_date(getattr(msg, "date", 0))

            header_tv = TextView(act)
            header_tv.setText(f"#{rank}  •  {self.chosen_display} {cnt}  •  {sender}")
            header_tv.setTextSize(14.0)
            header_tv.setTypeface(None, Typeface.BOLD)
            header_tv.setTextColor(colors["accent"])
            card.addView(header_tv)

            if date_str:
                date_tv = TextView(act)
                date_tv.setText(date_str)
                date_tv.setTextSize(11.0)
                date_tv.setTextColor(colors["secondary"])
                date_tv.setPadding(0, dp(1), 0, dp(4))
                card.addView(date_tv)

            raw_text = (getattr(msg, "message", "") or "").strip()
            if raw_text:
                preview = raw_text.replace("\n", " ")
                if len(preview) > 140:
                    preview = preview[:140] + "..."
            else:
                preview = "[Медиафайл / без текста]"

            body_tv = TextView(act)
            body_tv.setText(preview)
            body_tv.setTextSize(13.5)
            body_tv.setTextColor(colors["primary"])
            card.addView(body_tv)

            breakdown = format_msg_reactions_breakdown(account, msg, self.custom_alt_cache)
            if breakdown:
                brk_tv = TextView(act)
                brk_tv.setText(breakdown)
                brk_tv.setTextSize(12.0)
                brk_tv.setTextColor(colors["secondary"])
                brk_tv.setPadding(0, dp(6), 0, 0)
                card.addView(brk_tv)

            card.setOnClickListener(OnClickListener(lambda _v, m=msg: self._on_card_click(m)))
            container.addView(card)

        scroll.addView(container)
        main.addView(scroll)

        builder.set_title("Топ сообщений по реакциям")
        builder.set_view(main)

        best_msg = self.top_messages[0][2]
        builder.set_positive_button("К #1 сообщению", lambda b, w: (b.dismiss(), self._navigate_to_message(best_msg)))
        builder.set_negative_button("Закрыть", lambda b, w: b.dismiss())
        self._result_dialog = builder.show()

    def _on_card_click(self, msg):
        try:
            if hasattr(self, "_result_dialog") and self._result_dialog:
                self._result_dialog.dismiss()
        except Exception:
            pass
        self._navigate_to_message(msg)

    def _navigate_to_message(self, msg):
        try:
            dialog_id = self.current_dialog_id
            args = Bundle()
            if dialog_id > 0:
                args.putLong("user_id", int(dialog_id))
            else:
                chat_id = -dialog_id
                if chat_id > 1000000000000:
                    chat_id -= 1000000000000
                elif chat_id > 1000000000:
                    account = UserConfig.selectedAccount
                    ctrl = MessagesController.getInstance(account)
                    if not ctrl.getChat(chat_id) and ctrl.getChat(chat_id - 1000000000):
                        chat_id -= 1000000000
                args.putLong("chat_id", int(chat_id))

            args.putInt("message_id", int(msg.id))
            LaunchActivity.instance.presentFragment(ChatActivity(args))
        except Exception as e:
            log("[TopReactionFinder] navigate error: " + str(e))
            BulletinHelper.show_error("Не удалось перейти к сообщению")