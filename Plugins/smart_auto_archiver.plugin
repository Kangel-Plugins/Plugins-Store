import re, time, threading
from base_plugin import BasePlugin
from android_utils import run_on_ui_thread
from ui.settings import Header, Switch, Input, Divider, Text
from ui.bulletin import BulletinHelper
from org.telegram.messenger import DialogObject, MessagesController, UserConfig

__id__ = "smart_auto_archiver"
__name__ = "Auto Archive Chats"
__description__ = "Архивация неактивных чатов по таймеру"
__author__ = "@nainraft"
__version__ = "1.0.0"
__icon__ = "exteraPlugins/1"
__app_version__ = ">=12.10.6"
__min_version__ = "12.10.6"

class AutoArchivePlugin(BasePlugin):
    def on_plugin_load(self):
        self._run = True
        self._st, self._act, self._thr = {}, {}, None
        self._sched(5.0)

    def on_plugin_unload(self):
        self._run = False
        t = getattr(self, "_t", None)
        if t:
            try: t.cancel()
            except Exception: pass

    def _sched(self, delay):
        if not getattr(self, "_run", False): return
        t = threading.Timer(delay, self._work)
        t.daemon = True
        self._t = t
        t.start()

    def _work(self):
        if not getattr(self, "_run", False): return
        try:
            if self.get_setting("enabled", True):
                self.archive_chats(False, False)
        except Exception: pass
        finally:
            if getattr(self, "_run", False):
                raw = str(self.get_setting("check_interval", "10")).strip().replace(",", ".")
                try: iv = max(5.0, float(raw))
                except Exception: iv = 10.0
                self._sched(iv)

    def create_settings(self):
        return [
            Header(text="Настройки времени"),
            Switch(key="enabled", text="Автоархивация", subtext="Проверка неактивности чатов", default=True, icon="msg_archive"),
            Input(key="inactive_time", text="Время неактивности", subtext="5м, 2ч, 7д, 30с (число = минуты)", default="5м", icon="msg_calendar2"),
            Input(key="check_interval", text="Интервал проверки (сек)", default="10", icon="msg_retry"),
            Divider(text="Фильтры"),
            Switch(key="skip_pinned", text="Игнорировать закрепленные", default=True, icon="msg_pin"),
            Switch(key="skip_unread", text="Игнорировать непрочитанные", default=True, icon="msg_markunread"),
            Switch(key="only_private", text="Только личные диалоги", default=False, icon="msg_contacts"),
            Divider(text="Действия"),
            Text(text="Проверить по таймеру", icon="msg_check", on_click=lambda *a: self.archive_chats(True, False)),
            Text(text="Архивировать по дате сообщения", icon="msg_delete", on_click=lambda *a: self.archive_chats(True, True)),
        ]

    def _get_thr(self):
        raw = str(self.get_setting("inactive_time", "5м")).strip().lower().replace(",", ".")
        tot = 0.0
        for v, u in re.findall(r"(\d+(?:\.\d+)?)\s*([a-zа-я]*)", raw):
            val = float(v)
            if u.startswith(("д", "d")): tot += val * 86400
            elif u.startswith(("ч", "h")): tot += val * 3600
            elif u.startswith(("с", "s")): tot += val
            else: tot += val * 60
        return int(tot) if tot > 0 else 300

    def archive_chats(self, manual=False, by_date=False):
        def _task():
            try:
                if not hasattr(self, "_st"):
                    self._st, self._act, self._thr = {}, {}, None
                acc = UserConfig.selectedAccount
                mc = MessagesController.getInstance(acc)
                if not mc or not mc.allDialogs: return
                now, thr = int(time.time()), self._get_thr()
                if self._thr != thr:
                    self._thr = thr
                    for k in list(self._act.keys()): self._act[k] = now
                pin = self.get_setting("skip_pinned", True)
                unr = self.get_setting("skip_unread", True)
                prv = self.get_setting("only_private", False)
                me = UserConfig.getInstance(acc).getClientUserId()
                res, dlgs = [], mc.allDialogs
                for i in range(dlgs.size()):
                    d = dlgs.get(i)
                    if not d: continue
                    did = d.id
                    if getattr(d, "folder_id", 0) == 1:
                        self._st.pop(did, None); self._act.pop(did, None)
                        continue
                    if did in (777000, me): continue
                    if prv and not DialogObject.isUserDialog(did): continue
                    if pin and getattr(d, "pinned", False): continue
                    if unr and getattr(d, "unread_count", 0) > 0: continue
                    md = getattr(d, "last_message_date", 0)
                    sig = (getattr(d, "top_message", 0), md, getattr(d, "unread_count", 0))
                    if self._st.get(did) != sig:
                        self._st[did] = sig
                        self._act[did] = now
                    ref = md if by_date else self._act.get(did, now)
                    if ref > 0 and (now - ref) >= thr:
                        res.append(did)
                for did in res:
                    mc.addDialogToFolder(did, 1, -1, 0)
                    self._st.pop(did, None); self._act.pop(did, None)
                if manual:
                    BulletinHelper.show_info(f"Архивировано чатов: {len(res)}")
            except Exception as e:
                if manual: BulletinHelper.show_error(f"Ошибка: {e}")
        run_on_ui_thread(_task)
