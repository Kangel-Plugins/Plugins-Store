def _read_clipboard_text() -> str:
    ctx = ApplicationLoader.applicationContext
    try:
        cm = ctx.getSystemService(Context.CLIPBOARD_SERVICE)
        if cm and cm.hasPrimaryClip():
            clip = cm.getPrimaryClip()
            if clip and clip.getItemCount() > 0:
                parts = []
                for i in range(clip.getItemCount()):
                    item = clip.getItemAt(i)
                    if item:
                        cs = item.coerceToText(ctx)
                        if cs:
                            parts.append(str(cs.toString()))
                res = "\n".join(parts).strip()
                if res:
                    return res
    except Exception:
        pass
    try:
        from android_utils import get_clipboard
        t = get_clipboard()
        if t:
            return str(t).strip()
    except Exception:
        pass
    return ""


def _write_clipboard_text(text: str) -> bool:
    try:
        AndroidUtilities.addToClipboard(text)
        return True
    except Exception:
        pass
    try:
        from android_utils import copy_to_clipboard
        copy_to_clipboard(text)
        return True
    except Exception:
        pass
    try:
        ctx = ApplicationLoader.applicationContext
        cm = ctx.getSystemService(Context.CLIPBOARD_SERVICE)
        cm.setPrimaryClip(ClipData.newPlainText("proxies", text))
        return True
    except Exception:
        pass
    return False


def _jget(obj: Any, methods: Tuple[str, ...], attrs: Tuple[str, ...] = ()) -> str:
    if obj is None:
        return ""
    for m in methods:
        try:
            v = getattr(obj, m)()
            if v is not None and str(v) != "":
                return str(v)
        except Exception:
            pass
    for a in attrs:
        try:
            v = getattr(obj, a)
            if v is not None and str(v) != "":
                return str(v)
        except Exception:
            pass
    return ""


def _clean_server(raw_srv: str, keep_path: bool = False) -> str:
    s = urllib.parse.unquote(raw_srv or "").strip()
    s = re.sub(r"^(?:https?|socks5|mtproto)://", "", s, flags=re.IGNORECASE)
    s = s.split("?")[0].split("#")[0]
    if keep_path and "/" in s:
        host, rest = s.split("/", 1)
        host = host.lower().rstrip(".")
        if host.startswith("[") and host.endswith("]"):
            host = host[1:-1]
        clean_path = "/" + rest.rstrip("/") if rest.rstrip("/") else ""
        return host + clean_path
    host = s.split("/")[0].lower().rstrip(".")
    if host.startswith("[") and host.endswith("]"):
        host = host[1:-1]
    return host


def _extract_connect_host(server_with_optional_path: str) -> str:
    return (server_with_optional_path or "").split("/")[0].strip()


def _normalize_secret(raw_sec: str) -> str:
    s = urllib.parse.unquote(raw_sec or "").strip()
    s_clean = s.rstrip("=")
    if re.fullmatch(r"[0-9a-fA-F]+", s_clean):
        return s_clean.lower()
    return s_clean.replace("+", "-").replace("/", "_")


def _secret_to_bytes(secret: str) -> bytes:
    s = (secret or "").strip()
    if not s:
        return b""
    try:
        if re.fullmatch(r"[0-9a-fA-F]+", s) and len(s) % 2 == 0:
            return bytes.fromhex(s)
    except Exception:
        pass
    try:
        t = s.replace("-", "+").replace("_", "/")
        t += "=" * (-len(t) % 4)
        return base64.b64decode(t)
    except Exception:
        pass
    return b""


def _is_faketls_secret(secret: str) -> bool:
    b = _secret_to_bytes(secret)
    return len(b) >= 17 and b[0] == 0xEE


def _classify_dpi_badge(kind: str, secret: str) -> str:
    if kind == "web":
        return "🌐"
    if kind == "socks5" or not secret:
        return "🧦"
    b = _secret_to_bytes(secret)
    if len(b) == 16:
        return "⚠️"
    if len(b) >= 17 and b[0] == 0xEE:
        dom = ""
        try:
            dom = b[17:].decode("utf-8", "replace").strip().lower()
        except Exception:
            pass
        if dom and any(dom == d or dom.endswith("." + d) for d in _GOOD_FRONTS):
            return "🛡️"
        return "🔒"
    if len(b) == 17 and b[0] == 0xDD:
        return "➿"
    return "⚠️"


def _ping_color(ms: int) -> int:
    if ms <= 0:
        return COLOR_SLOW
    if ms < PING_FAST_MS:
        return COLOR_FAST
    if ms < PING_MID_MS:
        return COLOR_MID
    return COLOR_SLOW


def _get_proxy_ping_and_avail(info: Any) -> Tuple[bool, int]:
    if info is None:
        return False, 0
    av = False
    ping = 0
    try:
        av = bool(getattr(info, "available", False))
    except Exception:
        pass
    if not av:
        try:
            if hasattr(info, "isAvailable"):
                av = bool(info.isAvailable())
        except Exception:
            pass

    try:
        ping = int(getattr(info, "ping", 0) or 0)
    except Exception:
        ping = 0
    if ping <= 0:
        try:
            if hasattr(info, "getPing"):
                ping = int(info.getPing() or 0)
        except Exception:
            pass
    if ping <= 0:
        s = getattr(info, "settings", None)
        if s is not None:
            try:
                ping = int(getattr(s, "ping", 0) or 0)
            except Exception:
                pass
    return av, ping


def _extract_proxy_details(info_or_settings: Any) -> Tuple[str, str, str, int, str, str, str]:
    if info_or_settings is None:
        return "", "", "", 0, "", "", ""

    obj_id = 0
    try:
        obj_id = int(System.identityHashCode(info_or_settings))
        cached = _DETAILS_CACHE.get(obj_id)
        if cached is not None:
            return cached
    except Exception:
        obj_id = 0

    s = getattr(info_or_settings, "settings", None) or info_or_settings
    info = info_or_settings if hasattr(info_or_settings, "settings") else None

    ptype = _jget(s, ("getType",), ("type",)).upper()
    is_web = "WEB" in ptype

    raw_addr = _jget(s, ("getAddress", "getHost", "getServer"), ("address",)) or _jget(
        info, ("getAddress",), ("address",)
    )
    addr = _clean_server(raw_addr, keep_path=is_web)

    port_str = _jget(s, ("getPort",), ("port",)) or _jget(info, ("getPort",), ("port",))
    try:
        port = int(port_str)
    except Exception:
        port = 443 if is_web else 0
    eff_port = port if (1 <= port <= 65535) else 443

    raw_secret = _jget(s, ("getSecret",), ("secret",)) or _jget(info, ("getSecret",), ("secret",))
    norm_sec = _normalize_secret(raw_secret)

    user = (
        _jget(s, ("getUsername", "getUser"), ("username", "user"))
        or _jget(info, ("getUsername",), ("username",))
    ).strip()
    pwd = (
        _jget(s, ("getPassword", "getPass"), ("password", "pass"))
        or _jget(info, ("getPassword",), ("password",))
    ).strip()

    if not addr:
        return "", "", "", 0, "", "", ""

    if is_web:
        res = (f"web:{addr}:{norm_sec.lower()}", "web", addr, eff_port, raw_secret.strip(), "", "")
    elif raw_secret or "MTPROTO" in ptype:
        res = (f"mtproto:{addr}:{eff_port}:{norm_sec.lower()}", "mtproto", addr, eff_port, raw_secret.strip(), "", "")
    else:
        res = (f"socks5:{addr}:{eff_port}:{user}:{pwd}", "socks5", addr, eff_port, "", user, pwd)

    if obj_id != 0:
        if len(_DETAILS_CACHE) > 1024:
            _DETAILS_CACHE.clear()
        _DETAILS_CACHE[obj_id] = res
    return res


def _get_active_proxy_key(PC: Any) -> str:
    for candidate in (
        PC.getCurrentProxy() if hasattr(PC, "getCurrentProxy") else None,
        getattr(PC, "currentProxy", None),
        getattr(SharedConfig, "currentProxy", None),
    ):
        if candidate is not None:
            k, _, _, _, _, _, _ = _extract_proxy_details(candidate)
            if k:
                return k
    return ""


def _is_proxy_enabled_in_client() -> bool:
    try:
        if hasattr(SharedConfig, "proxyEnabled"):
            return bool(SharedConfig.proxyEnabled)
    except Exception:
        pass
    try:
        prefs = ApplicationLoader.applicationContext.getSharedPreferences("mainconfig", 0)
        return bool(prefs.getBoolean("proxy_enabled", False))
    except Exception:
        return False


def _activate_proxy_info(PC: Any, info: Any) -> bool:
    if info is None:
        return False
    for method_name in ("setCurrentProxy", "connectProxy", "selectProxy", "enableProxy"):
        if hasattr(PC, method_name):
            try:
                getattr(PC, method_name)(info)
                return True
            except Exception:
                pass
    try:
        SharedConfig.currentProxy = info
        SharedConfig.proxyEnabled = True
        prefs = ApplicationLoader.applicationContext.getSharedPreferences("mainconfig", 0)
        prefs.edit().putBoolean("proxy_enabled", True).commit()
        s = getattr(info, "settings", None)
        addr = _jget(s, ("getAddress",), ("address",)) if s else str(getattr(info, "address", ""))
        port = int(_jget(s, ("getPort",), ("port",)) or getattr(info, "port", 0) or 0)
        user = _jget(s, ("getUsername", "getUser"), ("username",)) if s else str(getattr(info, "username", ""))
        pwd = _jget(s, ("getPassword", "getPass"), ("password",)) if s else str(getattr(info, "password", ""))
        sec = _jget(s, ("getSecret",), ("secret",)) if s else str(getattr(info, "secret", ""))
        ConnectionsManager.setProxySettings(True, addr, port, user, pwd, sec)
        NotificationCenter.getGlobalInstance().postNotificationName(
            NotificationCenter.proxySettingsChanged
        )
        return True
    except Exception as e:
        _plog(f"activate fallback err: {e}")
        return False


def _delete_proxy_from_controller(PC: Any, info: Any) -> bool:
    for method_name in ("deleteProxy", "removeProxy"):
        if hasattr(PC, method_name):
            try:
                getattr(PC, method_name)(info)
                return True
            except Exception:
                pass
    try:
        SharedConfig.deleteProxy(info)
        return True
    except Exception:
        pass
    try:
        pl = PC.getProxyList()
        if pl is not None and pl.contains(info):
            pl.remove(info)
            _persist_proxy_controller(PC)
            return True
    except Exception:
        pass
    return False


def _persist_proxy_controller(PC: Any):
    try:
        if hasattr(PC, "save"):
            PC.save()
        if hasattr(PC, "syncProxyList"):
            PC.syncProxyList()
    except Exception:
        pass


def _sync_fragment_proxy_list(PC: Any, sorted_items: List[Any]):
    """Обновляет собственный proxyList и RecyclerView внутри активного ProxyListActivity."""
    try:
        frag = get_last_fragment()
        if frag is None or "ProxyListActivity" not in frag.getClass().getName():
            return

        frag_pl = get_private_field(frag, "proxyList")
        pc_pl = PC.getProxyList()
        if frag_pl is not None and frag_pl is not pc_pl:
            try:
                frag_pl.clear()
                for it in sorted_items:
                    frag_pl.add(it)
            except Exception:
                f_cls = _resolve_jclass(frag)
                for f in f_cls.getDeclaredFields():
                    if str(f.getName()) == "proxyList":
                        f.setAccessible(True)
                        new_al = ArrayList()
                        for it in sorted_items:
                            new_al.add(it)
                        f.set(frag, new_al)
                        break

        f_cls = _resolve_jclass(frag)
        for m in f_cls.getDeclaredMethods():
            if m.getName() == "updateRows":
                m.setAccessible(True)
                pts = list(m.getParameterTypes())
                if len(pts) == 0:
                    m.invoke(frag, [])
                elif len(pts) == 1:
                    m.invoke(frag, [True])
                break

        adapter = get_private_field(frag, "listAdapter")
        if adapter is not None:
            adapter.notifyDataSetChanged()
    except Exception as e:
        _plog(f"sync fragment list err: {e}")


def _replace_proxy_list_in_controller(PC: Any, sorted_items: List[Any]) -> bool:
    pl = PC.getProxyList()
    if pl is None:
        return False

    try:
        pl.clear()
        for it in sorted_items:
            pl.add(it)
        _persist_proxy_controller(PC)
        _sync_fragment_proxy_list(PC, sorted_items)
        return True
    except Exception:
        pass

    try:
        pc_cls = _resolve_jclass(PC)
        for f in pc_cls.getDeclaredFields():
            if str(f.getName()) == "proxyList":
                f.setAccessible(True)
                new_al = ArrayList()
                for it in sorted_items:
                    new_al.add(it)
                f.set(PC, new_al)
                _persist_proxy_controller(PC)
                _sync_fragment_proxy_list(PC, sorted_items)
                return True
    except Exception as e:
        _plog(f"replace list err: {e}")

    return False


_AES_SBOX = (
    0x63,0x7c,0x77,0x7b,0xf2,0x6b,0x6f,0xc5,0x30,0x01,0x67,0x2b,0xfe,0xd7,0xab,0x76,
    0xca,0x82,0xc9,0x7d,0xfa,0x59,0x47,0xf0,0xad,0xd4,0xa2,0xaf,0x9c,0xa4,0x72,0xc0,
    0xb7,0xfd,0x93,0x26,0x36,0x3f,0xf7,0xcc,0x34,0xa5,0xe5,0xf1,0x71,0xd8,0x31,0x15,
    0x04,0xc7,0x23,0xc3,0x18,0x96,0x05,0x9a,0x07,0x12,0x80,0xe2,0xeb,0x27,0xb2,0x75,
    0x09,0x83,0x2c,0x1a,0x1b,0x6e,0x5a,0xa0,0x52,0x3b,0xd6,0xb3,0x29,0xe3,0x2f,0x84,
    0x53,0xd1,0x00,0xed,0x20,0xfc,0xb1,0x5b,0x6a,0xcb,0xbe,0x39,0x4a,0x4c,0x58,0xcf,
    0xd0,0xef,0xaa,0xfb,0x43,0x4d,0x33,0x85,0x45,0xf9,0x02,0x7f,0x50,0x3c,0x9f,0xa8,
    0x51,0xa3,0x40,0x8f,0x92,0x9d,0x38,0xf5,0xbc,0xb6,0xda,0x21,0x10,0xff,0xf3,0xd2,
    0xcd,0x0c,0x13,0xec,0x5f,0x97,0x44,0x17,0xc4,0xa7,0x7e,0x3d,0x64,0x5d,0x19,0x73,
    0x60,0x81,0x4f,0xdc,0x22,0x2a,0x90,0x88,0x46,0xee,0xb8,0x14,0xde,0x5e,0x0b,0xdb,
    0xe0,0x32,0x3a,0x0a,0x49,0x06,0x24,0x5c,0xc2,0xd3,0xac,0x62,0x91,0x95,0xe4,0x79,
    0xe7,0xc8,0x37,0x6d,0x8d,0xd5,0x4e,0xa9,0x6c,0x56,0xf4,0xea,0x65,0x7a,0xae,0x08,
    0xba,0x78,0x25,0x2e,0x1c,0xa6,0xb4,0xc6,0xe8,0xdd,0x74,0x1f,0x4b,0xbd,0x8b,0x8a,
    0x70,0x3e,0xb5,0x66,0x48,0x03,0xf6,0x0e,0x61,0x35,0x57,0xb9,0x86,0xc1,0x1d,0x9e,
    0xe1,0xf8,0x98,0x11,0x69,0xd9,0x8e,0x94,0x9b,0x1e,0x87,0xe9,0xce,0x55,0x28,0xdf,
    0x8c,0xa1,0x89,0x0d,0xbf,0xe6,0x42,0x68,0x41,0x99,0x2d,0x0f,0xb0,0x54,0xbb,0x16,
)
_AES_RCON = (0x01,0x02,0x04,0x08,0x10,0x20,0x40,0x80,0x1b,0x36,0x6c,0xd8,0xab,0x4d)


def _aes_xtime(a: int) -> int:
    a <<= 1
    if a & 0x100:
        a ^= 0x11b
    return a & 0xff


_AES_MUL2 = tuple(_aes_xtime(i) for i in range(256))
_AES_MUL3 = tuple(_aes_xtime(i) ^ i for i in range(256))


class _AES256:
    __slots__ = ("_rk",)

    def __init__(self, key: bytes):
        self._rk = self._expand_key(key)

    @staticmethod
    def _expand_key(key: bytes):
        Nk, Nr = 8, 14
        words = [list(key[4 * i:4 * i + 4]) for i in range(Nk)]
        for i in range(Nk, 4 * (Nr + 1)):
            temp = list(words[i - 1])
            if i % Nk == 0:
                temp = temp[1:] + temp[:1]
                temp = [_AES_SBOX[b] for b in temp]
                temp[0] ^= _AES_RCON[i // Nk - 1]
            elif i % Nk == 4:
                temp = [_AES_SBOX[b] for b in temp]
            prev = words[i - Nk]
            words.append([prev[j] ^ temp[j] for j in range(4)])
        return [[b for w in range(4) for b in words[r * 4 + w]] for r in range(Nr + 1)]

    def encrypt_block(self, block: bytes) -> bytes:
        rk = self._rk
        s = [block[i] ^ rk[0][i] for i in range(16)]
        sbox, m2, m3 = _AES_SBOX, _AES_MUL2, _AES_MUL3
        for rnd in range(1, 14):
            s = [sbox[b] for b in s]
            s = [s[0], s[5], s[10], s[15], s[4], s[9], s[14], s[3],
                 s[8], s[13], s[2], s[7], s[12], s[1], s[6], s[11]]
            ns = [0] * 16
            for c in range(4):
                col = c * 4
                a0, a1, a2, a3 = s[col], s[col+1], s[col+2], s[col+3]
                ns[col]   = m2[a0] ^ m3[a1] ^ a2     ^ a3
                ns[col+1] = a0     ^ m2[a1] ^ m3[a2] ^ a3
                ns[col+2] = a0     ^ a1     ^ m2[a2] ^ m3[a3]
                ns[col+3] = m3[a0] ^ a1     ^ a2     ^ m2[a3]
            k = rk[rnd]
            s = [ns[i] ^ k[i] for i in range(16)]
        s = [sbox[b] for b in s]
        s = [s[0], s[5], s[10], s[15], s[4], s[9], s[14], s[3],
             s[8], s[13], s[2], s[7], s[12], s[1], s[6], s[11]]
        k = rk[14]
        return bytes(s[i] ^ k[i] for i in range(16))


class _AESCTR:
    __slots__ = ("_aes", "_counter", "_keystream", "_ks_off")

    def __init__(self, key: bytes, iv: bytes):
        self._aes = _AES256(key)
        self._counter = int.from_bytes(iv, "big")
        self._keystream = b""
        self._ks_off = 0

    def crypt(self, data: bytes) -> bytes:
        out = bytearray(len(data))
        ks, off = self._keystream, self._ks_off
        mask = (1 << 128) - 1
        for i in range(len(data)):
            if off >= len(ks):
                ks = self._aes.encrypt_block((self._counter & mask).to_bytes(16, "big"))
                self._counter = (self._counter + 1) & mask
                off = 0
            out[i] = data[i] ^ ks[off]
            off += 1
        self._keystream, self._ks_off = ks, off
        return bytes(out)


def _ft_build_client_hello(session_id: bytes, domain: str, secret_key: bytes) -> bytes:
    buf, stack, ro = bytearray(), [], [0]
    def S(b): buf.extend(b)
    def Z(n): ro[0] = len(buf); buf.extend(b"\x00" * n)
    def R(): buf.extend(session_id)
    def D(): buf.extend(domain.encode("utf-8", "ignore"))
    def K(): buf.extend(b"\x00" * 32)
    def Open(): stack.append(len(buf)); buf.extend(b"\x00\x00")
    def Close():
        s = stack.pop(); struct.pack_into(">H", buf, s, len(buf) - (s + 2))

    S(b"\x16\x03\x01\x02\x00\x01\x00\x01\xfc\x03\x03"); Z(32); S(b"\x20"); R(); S(b"\x00\x20")
    S(b"\x13\x01\x13\x02\x13\x03\xc0\x2b\xc0\x2f\xc0\x2c\xc0\x30\xcc\xa9"
      b"\xcc\xa8\xc0\x13\xc0\x14\x00\x9c\x00\x9d\x00\x2f\x00\x35\x01\x00\x01\x93")
    S(b"\x00\x00\x00\x00"); Open(); Open(); S(b"\x00"); Open(); D(); Close(); Close(); Close()
    S(b"\x00\x17\x00\x00\xff\x01\x00\x01\x00\x00\x0a\x00\x0a\x00\x08")
    S(b"\x00\x1d\x00\x17\x00\x18\x00\x0b\x00\x02\x01\x00\x00\x23\x00\x00"
      b"\x00\x10\x00\x0e\x00\x0c\x02\x68\x32\x08\x68\x74\x74\x70\x2f\x31"
      b"\x2e\x31\x00\x05\x00\x05\x01\x00\x00\x00\x00\x00\x0d\x00\x12\x00"
      b"\x10\x04\x03\x08\x04\x04\x01\x05\x03\x08\x05\x05\x01\x08\x06\x06"
      b"\x01\x00\x12\x00\x00\x00\x33\x00\x2b\x00\x29")
    S(b"\x00\x01\x00\x00\x1d\x00\x20"); K(); S(b"\x00\x2d\x00\x02\x01\x01\x00\x2b\x00\x0b\x0a")
    S(b"\x03\x04\x03\x03\x03\x02\x03\x01\x00\x1b\x00\x03\x02\x00\x02")
    S(b"\x00\x01\x00\x00\x15")
    pad = 517 - len(buf)
    if pad > 0:
        buf.extend(b"\x00" * pad)
    digest = hmac.new(secret_key, bytes(buf), hashlib.sha256).digest()
    buf[ro[0]:ro[0] + 32] = digest
    off = ro[0] + 28
    v = struct.unpack_from("<I", buf, off)[0] ^ (int(time.time()) & 0xffffffff)
    struct.pack_into("<I", buf, off, v & 0xffffffff)
    return bytes(buf)


def _probe_faketls(host: str, port: int, secret_bytes: bytes, timeout: float) -> Optional[int]:
    key = secret_bytes[1:17]
    domain = secret_bytes[17:].decode("ascii", "ignore") or "www.google.com"
    sock = None
    try:
        t0 = time.monotonic()
        sock = socket.create_connection((host, port), timeout=timeout)
        sock.settimeout(timeout)
        sock.sendall(_ft_build_client_hello(os.urandom(32), domain, key))
        resp = sock.recv(64)
        if len(resp) >= 6 and resp[0] == 0x16 and resp[5] == 0x02:
            return max(1, int((time.monotonic() - t0) * 1000))
        return None
    except Exception:
        return None
    finally:
        if sock:
            try:
                sock.close()
            except Exception:
                pass


def _probe_mtproto(host: str, port: int, secret_bytes: bytes, timeout: float) -> Optional[int]:
    if len(secret_bytes) >= 17 and secret_bytes[0] == 0xDD:
        key, secured = secret_bytes[1:17], True
    else:
        key, secured = secret_bytes[:16], False
    if len(key) != 16:
        return None

    forbidden = (0x44414548, 0x504f5354, 0x47455420, 0x4954504f, 0xeeeeeeee, 0xdddddddd, 0x16030102)
    while True:
        rnd = bytearray(os.urandom(64))
        if rnd[0] != 0xef and struct.unpack(">I", rnd[0:4])[0] not in forbidden and rnd[4:8] != b"\x00\x00\x00\x00":
            break
    enc_key = hashlib.sha256(bytes(rnd[8:40]) + key).digest()
    enc_iv = bytes(rnd[40:56])
    rev = bytes(rnd[55:7:-1])
    dec_key = hashlib.sha256(rev[0:32] + key).digest()
    dec_iv = rev[32:48]
    enc = _AESCTR(enc_key, enc_iv)
    dec = _AESCTR(dec_key, dec_iv)
    tag = 0xdddddddd if secured else 0xeeeeeeee
    rnd[56:60] = struct.pack("<I", tag)
    rnd[56:64] = enc.crypt(bytes(rnd))[56:64]

    nonce = os.urandom(16)
    body = struct.pack("<I", 0xbe7e8ef1) + nonce
    msg_id = (int(time.time()) << 32) & ~3
    msg = struct.pack("<qqI", 0, msg_id, len(body)) + body
    if secured:
        msg += os.urandom(4 * (os.urandom(1)[0] % 4))
    frame = struct.pack("<I", len(msg)) + msg

    sock = None
    try:
        t0 = time.monotonic()
        sock = socket.create_connection((host, port), timeout=timeout)
        sock.settimeout(timeout)
        sock.sendall(bytes(rnd) + enc.crypt(frame))
        hdr = b""
        while len(hdr) < 4:
            c = sock.recv(4 - len(hdr))
            if not c:
                return None
            hdr += c
        resp_len = struct.unpack("<I", dec.crypt(hdr))[0]
        if resp_len < 40 or resp_len > 65536:
            return None
        payload = b""
        while len(payload) < 40:
            c = sock.recv(40 - len(payload))
            if not c:
                return None
            payload += c
        dec_body = dec.crypt(payload)
        if struct.unpack("<I", dec_body[20:24])[0] == 0x05162463 and dec_body[24:40] == nonce:
            return max(1, int((time.monotonic() - t0) * 1000))
        return None
    except Exception:
        return None
    finally:
        if sock:
            try:
                sock.close()
            except Exception:
                pass


def _probe_socks5(host: str, port: int, user: str, pwd: str, timeout: float) -> Optional[int]:
    sock = None
    try:
        t0 = time.monotonic()
        sock = socket.create_connection((host, port), timeout=timeout)
        sock.settimeout(timeout)
        sock.sendall(b"\x05\x02\x00\x02")
        resp = sock.recv(2)
        if len(resp) < 2 or resp[0] != 0x05:
            return None
        rtt = max(1, int((time.monotonic() - t0) * 1000))
        if resp[1] == 0x00:
            return rtt
        if resp[1] == 0x02:
            u = (user or "").encode()[:255]
            p = (pwd or "").encode()[:255]
            sock.sendall(b"\x01" + bytes([len(u)]) + u + bytes([len(p)]) + p)
            ar = sock.recv(2)
            return rtt if (len(ar) >= 2 and ar[0] == 0x01 and ar[1] == 0x00) else None
        return None
    except Exception:
        return None
    finally:
        if sock:
            try:
                sock.close()
            except Exception:
                pass


def _probe_web_tls(server_with_path: str, port: int, timeout: float) -> Optional[int]:
    host = _extract_connect_host(server_with_path)
    raw_sock = None
    tls_sock = None
    try:
        t0 = time.monotonic()
        raw_sock = socket.create_connection((host, port), timeout=timeout)
        raw_sock.settimeout(timeout)
        tls_sock = _UNVERIFIED_SSL_CTX.wrap_socket(raw_sock, server_hostname=host)
        return max(1, int((time.monotonic() - t0) * 1000))
    except Exception:
        return None
    finally:
        for s in (tls_sock, raw_sock):
            if s:
                try:
                    s.close()
                except Exception:
                    pass


def _check_proxy_alive(
    kind: str,
    server: str,
    port: int,
    secret: str,
    user: str,
    pwd: str,
    use_handshake: bool = True,
    timeout: float = 4.0,
) -> Optional[int]:
    host = _extract_connect_host(server)
    if _is_local_host(host):
        return 1
    if not host or not (1 <= port <= 65535):
        return None

    if not use_handshake:
        t0 = time.monotonic()
        try:
            with socket.create_connection((host, port), timeout=timeout):
                return max(1, int((time.monotonic() - t0) * 1000))
        except Exception:
            return None

    if kind == "web":
        return _probe_web_tls(server, port, timeout)
    if kind == "socks5" or not secret:
        return _probe_socks5(host, port, user, pwd, timeout)

    sb = _secret_to_bytes(secret)
    if len(sb) >= 17 and sb[0] == 0xEE:
        return _probe_faketls(host, port, sb, timeout)
    return _probe_mtproto(host, port, sb, timeout)


class ParsedProxy:
    __slots__ = ("kind", "server", "port", "username", "password", "secret", "norm_secret")

    def __init__(
        self,
        kind: str,
        server: str,
        port: int,
        username: str = "",
        password: str = "",
        secret: str = "",
    ):
        self.kind = kind
        self.server = _clean_server(server, keep_path=(kind == "web"))
        self.port = int(port) if (1 <= int(port) <= 65535) else 443
        self.username = username.strip()
        self.password = password.strip()
        self.secret = secret.strip()
        self.norm_secret = _normalize_secret(secret)

    @property
    def host_only(self) -> str:
        return _extract_connect_host(self.server)

    @property
    def key(self) -> str:
        addr = self.server.lower()
        sec = self.norm_secret.lower()
        if self.kind == "web":
            return f"web:{addr}:{sec}"
        if self.kind == "mtproto":
            return f"mtproto:{addr}:{self.port}:{sec}"
        return f"socks5:{addr}:{self.port}:{self.username}:{self.password}"

    def to_uri(self) -> str:
        if self.kind == "web":
            return f"tg://webproxy?server={urllib.parse.quote(self.server, safe='.:-[]/')}&secret={urllib.parse.quote(self.secret, safe='-_.')}"
        if self.kind == "mtproto":
            return f"tg://proxy?server={self.server}&port={self.port}&secret={urllib.parse.quote(self.secret, safe='')}"
        uri = f"tg://socks?server={self.server}&port={self.port}"
        if self.username:
            uri += f"&user={urllib.parse.quote(self.username, safe='')}"
        if self.password:
            uri += f"&pass={urllib.parse.quote(self.password, safe='')}"
        return uri


class NoRedirectHandler(urllib.request.HTTPRedirectHandler):
    def http_error_301(self, req, fp, code, msg, headers):
        return fp

    def http_error_302(self, req, fp, code, msg, headers):
        return fp

    def http_error_303(self, req, fp, code, msg, headers):
        return fp

    def http_error_307(self, req, fp, code, msg, headers):
        return fp

    def http_error_308(self, req, fp, code, msg, headers):
        return fp


def _parse_proxy_url(url: str) -> Optional[ParsedProxy]:
    try:
        cleaned = url.strip().replace("&amp;", "&").rstrip(").,;!'\"»]")
        if cleaned.lower().startswith("socks5://"):
            parsed = urllib.parse.urlparse(cleaned)
            if parsed.hostname and parsed.port and (1 <= int(parsed.port) <= 65535):
                return ParsedProxy(
                    kind="socks5",
                    server=parsed.hostname,
                    port=int(parsed.port),
                    username=urllib.parse.unquote(parsed.username or ""),
                    password=urllib.parse.unquote(parsed.password or ""),
                )
            return None

        if "?" not in cleaned:
            return None

        base_part, query_part = cleaned.split("?", 1)
        query_part = query_part.split("#")[0].rstrip(").,;!'\"»]")
        qs = urllib.parse.parse_qs(query_part, keep_blank_values=True)
        base_low = base_part.lower()

        is_web = "webproxy" in base_low

        raw_server = (qs.get("server") or qs.get("host") or qs.get("ip") or [""])[0].strip()
        secret = urllib.parse.unquote((qs.get("secret") or [""])[0].strip())
        port_str = (qs.get("port") or [""])[0].strip()

        if is_web:
            server = _clean_server(raw_server, keep_path=True)
            if not server or "." not in _extract_connect_host(server) or not secret:
                return None
            port = int(port_str) if (port_str.isdigit() and 1 <= int(port_str) <= 65535) else 443
            return ParsedProxy(kind="web", server=server, port=port, secret=secret)

        server = _clean_server(raw_server, keep_path=False)
        if not server or "." not in server or not port_str.isdigit():
            return None

        port = int(port_str)
        if not (1 <= port <= 65535):
            return None

        user = urllib.parse.unquote((qs.get("user") or qs.get("username") or [""])[0].strip())
        pwd = urllib.parse.unquote((qs.get("pass") or qs.get("password") or [""])[0].strip())

        if secret or ("proxy" in base_low and "socks" not in base_low):
            if not secret:
                return None
            return ParsedProxy(kind="mtproto", server=server, port=port, secret=secret)

        return ParsedProxy(kind="socks5", server=server, port=port, username=user, password=pwd)
    except Exception:
        return None


def _resolve_redirect_url(url: str) -> List[ParsedProxy]:
    results: List[ParsedProxy] = []
    direct = _parse_proxy_url(url)
    if direct is not None:
        results.append(direct)
        return results

    if not url.lower().startswith(("http://", "https://")):
        return results

    try:
        opener = urllib.request.build_opener(NoRedirectHandler())
        req = urllib.request.Request(
            url,
            headers={"User-Agent": "Mozilla/5.0 (Android 14; Mobile) ProxyCollector/1.0"},
        )
        with opener.open(req, timeout=2.5) as resp:
            loc = resp.headers.get("Location") or resp.headers.get("location")
            if loc:
                p = _parse_proxy_url(loc)
                if p is not None:
                    results.append(p)
                    return results

            body = resp.read(24576).decode("utf-8", errors="ignore")
            for match in URL_REGEX.findall(body):
                p = _parse_proxy_url(match)
                if p is not None:
                    results.append(p)
    except Exception:
        pass
    return results


def extract_proxies_from_text(
    raw_text: str,
    allow_mtproto: bool = True,
    allow_socks5: bool = True,
    allow_web: bool = True,
    only_faketls: bool = False,
) -> List[ParsedProxy]:
    if not raw_text:
        return []

    text = raw_text.strip()
    stripped = re.sub(r"\s+", "", text)
    if stripped and "://" not in text and len(stripped) > 20:
        try:
            pad = stripped.replace("-", "+").replace("_", "/")
            pad += "=" * (-len(pad) % 4)
            decoded = base64.b64decode(pad).decode("utf-8", "ignore")
            if any(k in decoded.lower() for k in ("proxy?", "socks?", "webproxy?", ":")):
                text = decoded
        except Exception:
            pass

    found: List[ParsedProxy] = []
    seen_keys: Set[str] = set()

    def _add(p: Optional[ParsedProxy]):
        if p is None or not p.server or "." not in p.host_only or not (1 <= p.port <= 65535):
            return
        if p.kind == "mtproto":
            if not allow_mtproto:
                return
            if only_faketls and not _is_faketls_secret(p.secret):
                return
        elif p.kind == "socks5":
            if not allow_socks5:
                return
        elif p.kind == "web":
            if not allow_web:
                return
        if p.key not in seen_keys:
            seen_keys.add(p.key)
            found.append(p)

    if text.startswith("[") and text.endswith("]"):
        try:
            arr = json.loads(text)
            if isinstance(arr, list):
                for entry in arr:
                    if not isinstance(entry, dict):
                        continue
                    srv = str(entry.get("server") or entry.get("host") or "").strip()
                    sec = str(entry.get("secret") or "").strip()
                    via = entry.get("via")
                    if via and srv and sec:
                        _add(ParsedProxy(kind="web", server=srv, port=443, secret=sec))
                    elif srv and entry.get("port"):
                        prt = int(entry.get("port"))
                        if sec:
                            _add(ParsedProxy(kind="mtproto", server=srv, port=prt, secret=sec))
                        else:
                            _add(
                                ParsedProxy(
                                    kind="socks5",
                                    server=srv,
                                    port=prt,
                                    username=str(entry.get("user") or entry.get("username") or ""),
                                    password=str(entry.get("pass") or entry.get("password") or ""),
                                )
                            )
        except Exception:
            pass

    norm = (
        text.replace("tg://", " tg://")
        .replace("https://t.me/", " https://t.me/")
        .replace("http://t.me/", " http://t.me/")
    )
    for raw_u in URL_REGEX.findall(norm):
        _add(_parse_proxy_url(raw_u))

    low = text.lower()
    is_web_post = any(w in low for w in ("webproxy", "web proxy", "web-proxy", "веб-прокси", "веб прокси"))

    if allow_web and is_web_post:
        srv_m = WEB_BLOCK_SERVER_RE.search(text)
        sec_m = WEB_BLOCK_SECRET_RE.search(text)
        if srv_m and sec_m:
            srv_val = _clean_server(srv_m.group(1), keep_path=True)
            sec_val = sec_m.group(1).strip()
            if "." in _extract_connect_host(srv_val) and len(sec_val) >= 16:
                _add(ParsedProxy(kind="web", server=srv_val, port=443, secret=sec_val))

    for m in RAW_PROXY_REGEX.finditer(text):
        ip, port_s, p3, p4 = m.group(1), m.group(2), m.group(3) or "", m.group(4) or ""
        if not port_s.isdigit():
            continue
        port = int(port_s)
        if p3 and not p4 and len(p3) >= 16:
            kind = "web" if (is_web_post and port == 443) else "mtproto"
            _add(ParsedProxy(kind=kind, server=ip, port=port, secret=p3))
        else:
            _add(ParsedProxy(kind="socks5", server=ip, port=port, username=p3, password=p4))

    return found


def _download_and_read_attachment(msg: Any, account_id: int) -> str:
    try:
        media = getattr(msg, "media", None)
        doc = getattr(media, "document", None) if media is not None else None
        if doc is None:
            return ""

        size = int(getattr(doc, "size", 0) or 0)
        if size <= 0 or size > MAX_ATTACHMENT_BYTES:
            return ""

        file_name = ""
        attrs = getattr(doc, "attributes", None)
        if attrs is not None and hasattr(attrs, "size"):
            for i in range(int(attrs.size())):
                a = attrs.get(i)
                fn = getattr(a, "file_name", None)
                if fn:
                    file_name = str(fn).strip()
                    break

        mime = str(getattr(doc, "mime_type", "") or "").lower()
        fn_low = file_name.lower()
        is_text_file = (
            fn_low.endswith((".txt", ".json", ".list", ".conf", ".cfg"))
            or "text/" in mime
            or "json" in mime
        )
        if not is_text_file:
            return ""

        fl = FileLoader.getInstance(account_id)
        f_obj = fl.getPathToAttach(doc, True)
        if f_obj is not None:
            p_str = str(f_obj.getAbsolutePath())
            if os.path.isfile(p_str):
                with open(p_str, "r", encoding="utf-8", errors="ignore") as fp:
                    return fp.read()

        ev_loaded = getattr(NotificationCenter, "fileLoaded", None)
        ev_failed = getattr(NotificationCenter, "fileLoadFailed", None)
        if ev_loaded is None:
            return ""

        attach_name = str(FileLoader.getAttachFileName(doc) or "")
        if not attach_name:
            return ""

        done = threading.Event()
        result_path = [""]

        class _FileWatcher(dynamic_proxy(NotificationCenter.NotificationCenterDelegate)):
            def didReceivedNotification(self, notif_id, acc, args):
                try:
                    if not args or len(args) == 0:
                        return
                    fname = str(args[0] or "")
                    if fname != attach_name:
                        return
                    if notif_id == ev_loaded and len(args) > 1 and args[1] is not None:
                        result_path[0] = str(args[1].getAbsolutePath())
                        done.set()
                    elif ev_failed is not None and notif_id == ev_failed:
                        done.set()
                except Exception:
                    pass

        watcher = _FileWatcher()
        nc = get_notification_center(account_id)
        run_on_ui_thread(
            lambda: (
                nc.addObserver(watcher, ev_loaded),
                nc.addObserver(watcher, ev_failed) if ev_failed else None,
                fl.loadFile(doc, msg, 1, 0),
            )
        )
        done.wait(timeout=10.0)
        run_on_ui_thread(
            lambda: (
                nc.removeObserver(watcher, ev_loaded),
                nc.removeObserver(watcher, ev_failed) if ev_failed else None,
            )
        )

        if result_path[0] and os.path.isfile(result_path[0]):
            with open(result_path[0], "r", encoding="utf-8", errors="ignore") as fp:
                return fp.read()
    except Exception:
        pass
    return ""


def extract_proxies_from_message(
    msg: Any,
    allow_mtproto: bool = True,
    allow_socks5: bool = True,
    allow_web: bool = True,
    only_faketls: bool = False,
    parse_attachments: bool = True,
    account_id: int = 0,
) -> List[ParsedProxy]:
    found: List[ParsedProxy] = []
    seen_keys: Set[str] = set()

    def _add(p: Optional[ParsedProxy]):
        if p is None or not p.server or "." not in p.host_only or not (1 <= p.port <= 65535):
            return
        if p.kind == "mtproto":
            if not allow_mtproto:
                return
            if only_faketls and not _is_faketls_secret(p.secret):
                return
        elif p.kind == "socks5":
            if not allow_socks5:
                return
        elif p.kind == "web":
            if not allow_web:
                return
        if p.key not in seen_keys:
            seen_keys.add(p.key)
            found.append(p)

    text = str(getattr(msg, "message", "") or "")
    url_candidates: List[Tuple[str, str]] = []

    entities = getattr(msg, "entities", None)
    if entities is not None and hasattr(entities, "size"):
        for i in range(int(entities.size())):
            ent = entities.get(i)
            if ent is None:
                continue
            ent_url = str(getattr(ent, "url", "") or "").strip()
            offset = int(getattr(ent, "offset", 0) or 0)
            length = int(getattr(ent, "length", 0) or 0)
            label = text[offset : offset + length] if (0 <= offset < len(text) and length > 0) else ""
            if ent_url:
                url_candidates.append((ent_url, label))

    reply_markup = getattr(msg, "reply_markup", None)
    if reply_markup is not None:
        rows = getattr(reply_markup, "rows", None)
        if rows is not None and hasattr(rows, "size"):
            for r_idx in range(int(rows.size())):
                row = rows.get(r_idx)
                buttons = getattr(row, "buttons", None) if row is not None else None
                if buttons is not None and hasattr(buttons, "size"):
                    for b_idx in range(int(buttons.size())):
                        btn = buttons.get(b_idx)
                        if btn is None:
                            continue
                        btn_url = str(getattr(btn, "url", "") or "").strip()
                        btn_text = str(getattr(btn, "text", "") or "").strip()
                        if btn_url:
                            url_candidates.append((btn_url, btn_text))

    media = getattr(msg, "media", None)
    if media is not None:
        webpage = getattr(media, "webpage", None)
        if webpage is not None:
            wp_url = str(getattr(webpage, "url", "") or "").strip()
            if wp_url:
                url_candidates.append((wp_url, ""))

    for raw_u in URL_REGEX.findall(text):
        url_candidates.append((raw_u, ""))

    redirect_checks = 0
    for u, label in url_candidates:
        parsed = _parse_proxy_url(u)
        if parsed is not None:
            _add(parsed)
            continue

        if redirect_checks < MAX_REDIRECT_CHECKS_PER_MSG:
            u_low = u.lower()
            lbl_low = label.lower()
            is_tg = any(d in u_low for d in ("t.me/", "telegram.me/", "telegram.dog/", "tx.me/", "tg://"))
            if not is_tg and any(w in lbl_low for w in ("прокси", "proxy", "web", "веб", "socks", "mtproto")):
                redirect_checks += 1
                for redir_p in _resolve_redirect_url(u):
                    _add(redir_p)

    for p in extract_proxies_from_text(
        text,
        allow_mtproto=allow_mtproto,
        allow_socks5=allow_socks5,
        allow_web=allow_web,
        only_faketls=only_faketls,
    ):
        _add(p)

    if parse_attachments and media is not None and getattr(media, "document", None) is not None:
        file_text = _download_and_read_attachment(msg, account_id)
        if file_text:
            for p in extract_proxies_from_text(
                file_text,
                allow_mtproto=allow_mtproto,
                allow_socks5=allow_socks5,
                allow_web=allow_web,
                only_faketls=only_faketls,
            ):
                _add(p)

    return found


def _mtp_sort_key(e: dict):
    try:
        ip_key = (0, int(ipaddress.ip_address(e["addr"])))
    except Exception:
        ip_key = (1, e["addr"])
    return (ip_key, e["port"], len(e["secret"]), e["secret"])


def _apply_press_scale(view: Any, scale_to: float = 0.96):
    try:
        class _TouchAnim(dynamic_proxy(View.OnTouchListener)):
            def onTouch(self, v, event):
                try:
                    act = event.getActionMasked()
                    if act == MotionEvent.ACTION_DOWN:
                        v.animate().scaleX(scale_to).scaleY(scale_to).setDuration(90).start()
                    elif act in (MotionEvent.ACTION_UP, MotionEvent.ACTION_CANCEL):
                        v.animate().scaleX(1.0).scaleY(1.0).setDuration(180).start()
                except Exception:
                    pass
                return False

        view.setOnTouchListener(_TouchAnim())
    except Exception:
        pass


def _show_action_sheet(
    act: Any,
    title: str,
    actions: List[Tuple[str, str, Callable[[], None], bool]],
    subtitle: str = "",
    cancel_text: str = "Закрыть",
):
    if act is None:
        return

    def ui():
        try:
            sheet = BottomSheet(act, False)
            sheet.setApplyBottomPadding(False)
            sheet.setApplyTopPadding(False)

            root = LinearLayout(act)
            root.setOrientation(LinearLayout.VERTICAL)
            root.setPadding(
                AndroidUtilities.dp(18),
                AndroidUtilities.dp(10),
                AndroidUtilities.dp(18),
                AndroidUtilities.dp(16),
            )

            bg = GradientDrawable()
            bg.setShape(GradientDrawable.RECTANGLE)
            bg.setCornerRadii([
                AndroidUtilities.dp(20), AndroidUtilities.dp(20),
                AndroidUtilities.dp(20), AndroidUtilities.dp(20),
                0, 0, 0, 0,
            ])
            bg.setColor(Theme.getColor(Theme.key_dialogBackground))
            root.setBackground(bg)

            pill = View(act)
            pill_bg = GradientDrawable()
            pill_bg.setCornerRadius(AndroidUtilities.dp(2))
            pill_bg.setColor(0x40808080)
            pill.setBackground(pill_bg)
            root.addView(pill, LayoutHelper.createLinear(36, 4, Gravity.CENTER_HORIZONTAL, 0, 0, 0, 12))

            tv_title = TextView(act)
            tv_title.setText(title)
            tv_title.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 19)
            tv_title.setTypeface(AndroidUtilities.getTypeface("fonts/rmedium.ttf"))
            tv_title.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
            tv_title.setGravity(Gravity.CENTER)
            root.addView(tv_title, LayoutHelper.createLinear(-1, -2, Gravity.CENTER, 0, 0, 0, 4 if subtitle else 14))

            if subtitle:
                tv_sub = TextView(act)
                tv_sub.setText(subtitle)
                tv_sub.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13)
                tv_sub.setTextColor(Theme.getColor(Theme.key_dialogTextGray3))
                tv_sub.setGravity(Gravity.CENTER)
                root.addView(tv_sub, LayoutHelper.createLinear(-1, -2, Gravity.CENTER, 4, 0, 4, 14))

            scroll = ScrollView(act)
            scroll.setVerticalScrollBarEnabled(False)

            card = LinearLayout(act)
            card.setOrientation(LinearLayout.VERTICAL)
            card.setPadding(
                AndroidUtilities.dp(8),
                AndroidUtilities.dp(8),
                AndroidUtilities.dp(8),
                AndroidUtilities.dp(8),
            )
            card_bg = GradientDrawable()
            card_bg.setShape(GradientDrawable.RECTANGLE)
            card_bg.setCornerRadius(AndroidUtilities.dp(16))
            try:
                card_bg.setColor(Theme.getColor(Theme.key_windowBackgroundGray))
            except Exception:
                card_bg.setColor(0x18808080)
            card.setBackground(card_bg)

            for idx, (label, icon_name, cb, is_red) in enumerate(actions):
                row = FrameLayout(act)
                row.setPadding(
                    AndroidUtilities.dp(14),
                    AndroidUtilities.dp(12),
                    AndroidUtilities.dp(14),
                    AndroidUtilities.dp(12),
                )
                row_bg = GradientDrawable()
                row_bg.setCornerRadius(AndroidUtilities.dp(12))
                row_bg.setColor(Theme.getColor(Theme.key_dialogBackground))
                try:
                    ripple = RippleDrawable(ColorStateList.valueOf(0x25808080), row_bg, None)
                    row.setBackground(ripple)
                except Exception:
                    row.setBackground(row_bg)

                inner = LinearLayout(act)
                inner.setOrientation(LinearLayout.HORIZONTAL)
                inner.setGravity(Gravity.CENTER_VERTICAL)

                accent_col = (
                    Theme.getColor(Theme.key_text_RedRegular)
                    if is_red
                    else Theme.getColor(Theme.key_dialogTextBlue)
                )
                text_col = (
                    Theme.getColor(Theme.key_text_RedRegular)
                    if is_red
                    else Theme.getColor(Theme.key_dialogTextBlack)
                )

                ico_res = _get_drawable_res(icon_name, _get_drawable_res("msg_retry", 0))
                if ico_res:
                    iv = ImageView(act)
                    iv.setImageResource(ico_res)
                    iv.setScaleType(ImageView.ScaleType.CENTER)
                    iv.setColorFilter(accent_col)
                    inner.addView(iv, LayoutHelper.createLinear(24, 24, Gravity.CENTER_VERTICAL, 0, 0, 12, 0))

                tv = TextView(act)
                tv.setText(label)
                tv.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 15)
                tv.setTextColor(text_col)
                tv.setTypeface(AndroidUtilities.getTypeface("fonts/rmedium.ttf"))
                inner.addView(tv, LayoutHelper.createLinear(-1, -2, Gravity.CENTER_VERTICAL))

                row.addView(inner, FrameLayout.LayoutParams(-1, -2))
                row.setClickable(True)
                row.setOnClickListener(OnClickListener(lambda _v, fn=cb: (sheet.dismiss(), fn())))
                _apply_press_scale(row, 0.97)

                lp = LayoutHelper.createLinear(-1, -2, 0, 0 if idx == 0 else 6, 0, 0)
                card.addView(row, lp)

            scroll.addView(card)
            root.addView(scroll, LayoutHelper.createLinear(-1, 0, 1.0))

            btn_close = TextView(act)
            btn_close.setText(cancel_text)
            btn_close.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 15)
            btn_close.setTypeface(AndroidUtilities.getTypeface("fonts/rmedium.ttf"))
            btn_close.setGravity(Gravity.CENTER)
            btn_close.setTextColor(Theme.getColor(Theme.key_featuredStickers_buttonText))
            btn_close.setPadding(0, AndroidUtilities.dp(13), 0, AndroidUtilities.dp(13))
            btn_bg = GradientDrawable()
            btn_bg.setCornerRadius(AndroidUtilities.dp(14))
            btn_bg.setColor(Theme.getColor(Theme.key_featuredStickers_addButton))
            btn_close.setBackground(btn_bg)
            btn_close.setClickable(True)
            btn_close.setOnClickListener(OnClickListener(lambda _v: sheet.dismiss()))
            _apply_press_scale(btn_close, 0.97)
            root.addView(btn_close, LayoutHelper.createLinear(-1, -2, 0, 12, 0, 0))

            sheet.setCustomView(root)
            sheet.show()
        except Exception as e:
            _plog(f"action sheet err: {e}")

    run_on_ui_thread(ui)


def _show_input_sheet(
    act: Any,
    title: str,
    hint: str,
    on_submit: Callable[[str], None],
    multiline: bool = False,
):
    if act is None:
        return

    def ui():
        try:
            sheet = BottomSheet(act, True)
            sheet.setApplyBottomPadding(False)
            sheet.setApplyTopPadding(False)

            root = LinearLayout(act)
            root.setOrientation(LinearLayout.VERTICAL)
            root.setPadding(
                AndroidUtilities.dp(20),
                AndroidUtilities.dp(12),
                AndroidUtilities.dp(20),
                AndroidUtilities.dp(16),
            )
            bg = GradientDrawable()
            bg.setCornerRadii([
                AndroidUtilities.dp(20), AndroidUtilities.dp(20),
                AndroidUtilities.dp(20), AndroidUtilities.dp(20),
                0, 0, 0, 0,
            ])
            bg.setColor(Theme.getColor(Theme.key_dialogBackground))
            root.setBackground(bg)

            tv_title = TextView(act)
            tv_title.setText(title)
            tv_title.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 18)
            tv_title.setTypeface(AndroidUtilities.getTypeface("fonts/rmedium.ttf"))
            tv_title.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
            tv_title.setGravity(Gravity.CENTER)
            root.addView(tv_title, LayoutHelper.createLinear(-1, -2, Gravity.CENTER, 0, 4, 0, 12))

            box = FrameLayout(act)
            box.setPadding(
                AndroidUtilities.dp(12),
                AndroidUtilities.dp(8),
                AndroidUtilities.dp(12),
                AndroidUtilities.dp(8),
            )
            box_bg = GradientDrawable()
            box_bg.setCornerRadius(AndroidUtilities.dp(14))
            box_bg.setStroke(AndroidUtilities.dp(1.5), Theme.getColor(Theme.key_dialogTextBlue))
            box_bg.setColor(Theme.getColor(Theme.key_windowBackgroundWhite))
            box.setBackground(box_bg)

            edit = EditText(act)
            edit.setHint(hint)
            edit.setBackgroundColor(Color.TRANSPARENT)
            edit.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 15)
            edit.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
            edit.setHintTextColor(Theme.getColor(Theme.key_dialogTextGray3))
            if multiline:
                edit.setInputType(InputType.TYPE_CLASS_TEXT | InputType.TYPE_TEXT_FLAG_MULTI_LINE)
                edit.setMinLines(3)
                edit.setMaxLines(7)
            else:
                edit.setSingleLine(True)
            box.addView(edit, FrameLayout.LayoutParams(-1, -2))
            root.addView(box, LayoutHelper.createLinear(-1, -2, 0, 0, 0, 12))

            row_btns = LinearLayout(act)
            row_btns.setOrientation(LinearLayout.HORIZONTAL)

            btn_paste = TextView(act)
            btn_paste.setText("Вставить")
            btn_paste.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 15)
            btn_paste.setTypeface(AndroidUtilities.getTypeface("fonts/rmedium.ttf"))
            btn_paste.setGravity(Gravity.CENTER)
            btn_paste.setTextColor(Theme.getColor(Theme.key_dialogTextBlue))
            btn_paste.setPadding(0, AndroidUtilities.dp(12), 0, AndroidUtilities.dp(12))
            p_bg = GradientDrawable()
            p_bg.setCornerRadius(AndroidUtilities.dp(14))
            try:
                p_bg.setColor(Theme.getColor(Theme.key_windowBackgroundGray))
            except Exception:
                p_bg.setColor(0x20808080)
            btn_paste.setBackground(p_bg)
            btn_paste.setClickable(True)
            btn_paste.setOnClickListener(
                OnClickListener(
                    lambda _v: (
                        edit.setText(_read_clipboard_text()),
                        edit.setSelection(edit.getText().length()),
                    )
                )
            )
            _apply_press_scale(btn_paste, 0.97)
            row_btns.addView(btn_paste, LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1.0))

            spacer = View(act)
            row_btns.addView(spacer, LayoutHelper.createLinear(10, 1))

            btn_ok = TextView(act)
            btn_ok.setText("Готово")
            btn_ok.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 15)
            btn_ok.setTypeface(AndroidUtilities.getTypeface("fonts/rmedium.ttf"))
            btn_ok.setGravity(Gravity.CENTER)
            btn_ok.setTextColor(Theme.getColor(Theme.key_featuredStickers_buttonText))
            btn_ok.setPadding(0, AndroidUtilities.dp(12), 0, AndroidUtilities.dp(12))
            ok_bg = GradientDrawable()
            ok_bg.setCornerRadius(AndroidUtilities.dp(14))
            ok_bg.setColor(Theme.getColor(Theme.key_featuredStickers_addButton))
            btn_ok.setBackground(ok_bg)
            btn_ok.setClickable(True)

            def do_ok(_v):
                val = str(edit.getText().toString()).strip()
                sheet.dismiss()
                if val:
                    on_submit(val)

            btn_ok.setOnClickListener(OnClickListener(do_ok))
            _apply_press_scale(btn_ok, 0.97)
            row_btns.addView(btn_ok, LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1.2))

            root.addView(row_btns, LayoutHelper.createLinear(-1, -2))
            sheet.setCustomView(root)
            sheet.show()
            run_on_ui_thread(lambda: edit.requestFocus(), 200)
        except Exception as e:
            _plog(f"input sheet err: {e}")

    run_on_ui_thread(ui)


class SourcePickerDelegate(dynamic_proxy(DialogsActivity.DialogsActivityDelegate)):
    def __init__(self, on_picked: Callable[[int, int], None]):
        super().__init__()
        self.on_picked = on_picked

    def canSelectStories(self, *args) -> bool:
        return False

    def didSelectDialogs(self, *args) -> bool:
        try:
            if len(args) < 2:
                return False
            fragment = args[0]
            dids = args[1]
            if dids is None or dids.isEmpty():
                return False

            first_item = dids.get(0)
            target_did = 0
            target_tid = 0

            if hasattr(first_item, "dialogId"):
                target_did = int(first_item.dialogId)
                if hasattr(first_item, "topicId"):
                    target_tid = int(first_item.topicId or 0)
            else:
                raw_did = get_private_field(first_item, "dialogId")
                if raw_did is not None:
                    target_did = int(raw_did)
                    target_tid = int(get_private_field(first_item, "topicId") or 0)
                else:
                    target_did = int(first_item)

            topics_frag = args[-1] if len(args) >= 6 else None
            if topics_frag is not None and topics_frag is not fragment and hasattr(topics_frag, "finishFragment"):
                try:
                    topics_frag.finishFragment()
                except Exception:
                    pass
                try:
                    fragment.removeSelfFromStack()
                except Exception:
                    pass
            else:
                try:
                    fragment.finishFragment()
                except Exception:
                    pass

            if target_did != 0 and self.on_picked:
                norm_did = _normalize_dialog_id(target_did)
                if not _is_forum_chat(norm_did):
                    target_tid = 0
                self.on_picked(norm_did, int(target_tid))
            return True
        except Exception:
            return False


class SlideCallback(dynamic_proxy(Utilities.Callback)):
    def __init__(self, on_choose: Callable[[int], None]):
        super().__init__()
        self.on_choose = on_choose

    def run(self, arg: Any):
        try:
            self.on_choose(int(arg))
        except Exception:
            pass


class RealtimeMessagesHook(MethodHook):
    def __init__(self, plugin: "AutoProxyCollectorPlugin"):
        super().__init__()
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            if not self.plugin.get_setting("enabled", True):
                return
            if not self.plugin.get_setting("realtime_enabled", True):
                return
            if not param.args or len(param.args) < 2:
                return

            dialog_id = _normalize_dialog_id(param.args[0])
            messages_list = param.args[1]
            if dialog_id == 0 or messages_list is None or not hasattr(messages_list, "size"):
                return

            sources = self.plugin._get_sources()
            if not sources:
                return

            is_forum = _is_forum_chat(dialog_id)
            whole_key = _make_source_key(dialog_id, 0)

            has_matching_chat = any(
                not meta.get("paused", False) and _parse_source_key(k, meta)[0] == dialog_id
                for k, meta in sources.items()
            )
            if not has_matching_chat:
                return

            for i in range(int(messages_list.size())):
                mo = messages_list.get(i)
                owner = getattr(mo, "messageOwner", mo)
                if owner is None or not hasattr(owner, "id"):
                    continue

                if whole_key in sources and not sources[whole_key].get("paused", False):
                    self.plugin.enqueue_realtime_message(whole_key, owner)

                if is_forum:
                    tid = _get_message_topic_id(owner, mo)
                    t_key = _make_source_key(dialog_id, tid)
                    if tid > 0 and t_key in sources and not sources[t_key].get("paused", False):
                        self.plugin.enqueue_realtime_message(t_key, owner)
        except Exception:
            pass


class ProxyListScreenHook(MethodHook):
    def __init__(self, plugin: "AutoProxyCollectorPlugin"):
        super().__init__()
        self.plugin = plugin

    def after_hooked_method(self, param):
        obj = param.thisObject
        if obj and "ProxyListActivity" in obj.getClass().getName():
            self.plugin._inject_proxy_screen_button(obj)


class CellSetProxyHook(MethodHook):
    def __init__(self, plugin: "AutoProxyCollectorPlugin"):
        super().__init__()
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            cell = param.thisObject
            info = param.args[0] if param.args else None
            if not info:
                return
            tv = get_private_field(cell, "textView")
            if tv is None:
                return

            _, kind, srv, port, sec, _, _ = _extract_proxy_details(info)
            if not srv:
                return

            host_only = _extract_connect_host(srv)
            if _is_local_host(host_only):
                if self.plugin.get_setting("show_local_label", True):
                    tv.setText("Локальный туннель")
                return

            prefix = ""
            if self.plugin.get_setting("show_dpi_badges", True):
                prefix += _classify_dpi_badge(kind, sec)
            if self.plugin.get_setting("show_geo_flags", True):
                geo = self.plugin._get_cached_geo(host_only)
                if geo and geo.get("flag"):
                    prefix += geo["flag"]
                elif not self.plugin._cleaning:
                    self.plugin._request_geo(host_only)

            base = srv if kind == "web" else f"{host_only}:{port}"
            tv.setText(f"{prefix} {base}".strip() if prefix else base)
        except Exception:
            pass


class CellUpdateStatusHook(MethodHook):
    def __init__(self, plugin: "AutoProxyCollectorPlugin"):
        super().__init__()
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            cell = param.thisObject
            info = get_private_field(cell, "currentInfo")
            if not info:
                return
            vv = get_private_field(cell, "valueTextView")
            if vv is None:
                return

            if self.plugin.get_setting("show_ping_color", True):
                try:
                    av, ping_ms = _get_proxy_ping_and_avail(info)
                    if av and ping_ms > 0:
                        vv.setTextColor(_ping_color(ping_ms))
                    elif av:
                        vv.setTextColor(COLOR_FAST)
                    else:
                        vv.setTextColor(0xFF9E9E9E)
                except Exception:
                    pass

            if self.plugin.get_setting("show_geo_flags", True):
                _, _, srv, _, _, _, _ = _extract_proxy_details(info)
                host_only = _extract_connect_host(srv)
                if host_only and not _is_local_host(host_only):
                    geo = self.plugin._get_cached_geo(host_only)
                    if geo and geo.get("isp"):
                        cur = str(vv.getText() or "")
                        isp = geo["isp"]
                        if isp not in cur:
                            vv.setText(f"{cur} · {isp}")
        except Exception:
            pass


class ConnectionStateObserver(dynamic_proxy(NotificationCenter.NotificationCenterDelegate)):
    def __init__(self, plugin: "AutoProxyCollectorPlugin"):
        super().__init__()
        self.plugin = plugin

    def didReceivedNotification(self, notif_id, account, args):
        try:
            self.plugin._on_connection_state_event()
        except Exception:
            pass


class SettingsHeaderHook(MethodHook):
    def __init__(self, plugin: "AutoProxyCollectorPlugin"):
        super().__init__()
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            if HeaderSetting is None:
                return
            activity = param.thisObject
            items = param.args[0]
            if not items or items.size() == 0:
                return
            for i in range(items.size()):
                item = items.get(i)
                if hasattr(item, "settingItem") and str(item.settingItem) == "proxy_collector_header":
                    return
            plugin_obj = get_private_field(activity, "plugin")
            if not plugin_obj or str(plugin_obj.getId()) != __id__:
                return
            if get_private_field(activity, "createSubFragmentCallback") is not None:
                return
            if get_private_field(activity, "searching"):
                return
            header = self.plugin._build_settings_header(activity.getContext())
            if header is not None:
                item = UItem.asCustom(header)
                item.settingItem = HeaderSetting("proxy_collector_header")
                try:
                    item.setTransparent(True)
                except Exception:
                    pass
                items.add(0, item)
                items.add(1, UItem.asShadow())
        except Exception:
            pass


class AutoProxyCollectorPlugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self._alive = False
        self._scanning = False
        self._cleaning = False
        self._hooks: List[Any] = []
        self._keep_callbacks: List[Any] = []
        self._chat_menu_item = None
        self._msg_menu_item = None
        self._picker_delegate = None
        self._conn_observer = None
        self._timer_token = 0
        self._lock = threading.Lock()

        self._rt_queue: Dict[str, List[Any]] = {}
        self._rt_worker_running = False

        self._dead_cache: Dict[str, float] = {}
        self._strikes: Dict[str, int] = {}
        self._ip_cache: Dict[str, Dict[str, Any]] = {}
        self._pending_geo: Set[str] = set()
        self._inflight_geo: Set[str] = set()
        self._geo_running = False
        self._geo_lock = threading.Lock()

        self._last_net_sig = ""
        self._last_net_check_ts = 0.0

    def on_plugin_load(self):
        self._alive = True
        self._load_caches()
        self._last_net_sig = _get_network_signature()

        mc_class = find_class("org.telegram.messenger.MessagesController")
        if mc_class:
            refs = self.hook_all_methods(
                mc_class, "updateInterfaceWithMessages", RealtimeMessagesHook(self)
            )
            if refs:
                self._hooks.extend(refs)

        self._hook_proxy_list_and_cells()
        self._hook_settings_header()
        self._register_connection_observer()

        self._sync_chat_menu(bool(self.get_setting("show_chat_menu", True)))
        self._sync_msg_menu(bool(self.get_setting("show_msg_menu", True)))
        self._start_periodic_timer()
        _plog("loaded v" + __version__)

    def on_plugin_unload(self):
        self._alive = False
        self._timer_token += 1
        self._sync_chat_menu(False)
        self._sync_msg_menu(False)
        self._unregister_connection_observer()

        for h in self._hooks:
            try:
                self.unhook_method(h)
            except Exception:
                pass
        self._hooks.clear()
        self._keep_callbacks.clear()
        self._rt_queue.clear()
        _DETAILS_CACHE.clear()
        self._picker_delegate = None

    def _get_header_tools_config(self) -> Tuple[List[str], Set[str]]:
        raw_order = self.get_setting("header_tools_order", None)
        if isinstance(raw_order, list):
            order = [k for k in raw_order if k in HEADER_TOOLS_META]
        else:
            order = list(DEFAULT_HEADER_TOOLS)
        for k in DEFAULT_HEADER_TOOLS:
            if k not in order:
                order.append(k)

        raw_disabled = self.get_setting("header_tools_disabled", None)
        disabled = set(raw_disabled) if isinstance(raw_disabled, list) else set()
        return order, disabled

    def _save_header_tools_config(self, order: List[str], disabled: Set[str], reload_ui: bool = False):
        self.set_setting("header_tools_order", list(order), reload_settings=False)
        self.set_setting("header_tools_disabled", list(disabled), reload_settings=reload_ui)

    def _load_caches(self):
        now = time.time()
        try:
            raw_dead = json.loads(str(self.get_setting("dead_cache_json", "{}")))
            if isinstance(raw_dead, dict):
                self._dead_cache = {k: float(v) for k, v in raw_dead.items() if float(v) > now}
        except Exception:
            self._dead_cache = {}

        try:
            raw_strikes = json.loads(str(self.get_setting("strikes_json", "{}")))
            if isinstance(raw_strikes, dict):
                self._strikes = {k: int(v) for k, v in raw_strikes.items() if int(v) > 0}
        except Exception:
            self._strikes = {}

        try:
            raw_ip = json.loads(str(self.get_setting("ip_cache_json", "{}")))
            if isinstance(raw_ip, dict):
                self._ip_cache = raw_ip
        except Exception:
            self._ip_cache = {}

    def _save_dead_and_strikes(self):
        now = time.time()
        self._dead_cache = {k: v for k, v in self._dead_cache.items() if v > now}
        if len(self._dead_cache) > 1500:
            items = sorted(self._dead_cache.items(), key=lambda x: x[1])[-1500:]
            self._dead_cache = dict(items)
        self.set_setting("dead_cache_json", json.dumps(self._dead_cache), reload_settings=False)
        self.set_setting("strikes_json", json.dumps(self._strikes), reload_settings=False)

    def _save_ip_cache(self):
        if len(self._ip_cache) > 2000:
            items = sorted(self._ip_cache.items(), key=lambda x: x[1].get("ts", 0))[-2000:]
            self._ip_cache = dict(items)
        self.set_setting("ip_cache_json", json.dumps(self._ip_cache, ensure_ascii=False), reload_settings=False)

    def _get_cached_geo(self, host: str) -> Optional[Dict[str, Any]]:
        d = self._ip_cache.get(host)
        if not d:
            return None
        if (time.time() - float(d.get("ts", 0))) > 7 * 86400:
            return None
        return d

    def _request_geo(self, host: str):
        with self._geo_lock:
            if self._get_cached_geo(host) is not None:
                return
            if host in self._pending_geo or host in self._inflight_geo:
                return
            self._pending_geo.add(host)
            if self._geo_running:
                return
            self._geo_running = True
        threading.Thread(target=self._geo_worker, daemon=True).start()

    def _geo_worker(self):
        try:
            while self._alive:
                time.sleep(0.8)
                with self._geo_lock:
                    batch = list(self._pending_geo)[:100]
                    if not batch:
                        self._geo_running = False
                        return
                    for h in batch:
                        self._pending_geo.discard(h)
                        self._inflight_geo.add(h)

                self._fetch_geo_batch(batch)

                with self._geo_lock:
                    for h in batch:
                        self._inflight_geo.discard(h)
        except Exception:
            with self._geo_lock:
                self._geo_running = False

    def _fetch_geo_batch(self, hosts: List[str]):
        try:
            queries = []
            for h in hosts:
                try:
                    ip = h if re.match(r"^\d{1,3}(\.\d{1,3}){3}$", h) else socket.gethostbyname(h)
                except Exception:
                    ip = h
                queries.append({"query": ip})

            req = urllib.request.Request(
                "http://ip-api.com/batch?fields=query,countryCode,isp,status",
                data=json.dumps(queries).encode("utf-8"),
                headers={"Content-Type": "application/json"},
            )
            with urllib.request.urlopen(req, timeout=10.0) as resp:
                if resp.getcode() == 429:
                    with self._geo_lock:
                        self._pending_geo.update(hosts)
                    time.sleep(5.0)
                    return
                data = json.loads(resp.read().decode("utf-8", "ignore"))

            now = time.time()
            changed = False
            for i, item in enumerate(data):
                if i >= len(hosts):
                    break
                h = hosts[i]
                cc = str(item.get("countryCode") or "").upper()
                isp = str(item.get("isp") or "")
                isp = re.sub(
                    r"(?i)\s+(LLC|Inc\.|Ltd\.|Corporation|Corp\.|Hosting|Network|Communications|GmbH)",
                    "",
                    isp,
                ).strip(" ,.")
                if len(isp) > 18:
                    isp = isp[:16] + ".."
                flag = (chr(ord(cc[0]) + 127397) + chr(ord(cc[1]) + 127397)) if len(cc) == 2 else ""
                self._ip_cache[h] = {"flag": flag, "isp": isp, "cc": cc, "ts": now}
                changed = True

            if changed:
                self._save_ip_cache()
                run_on_ui_thread(
                    lambda: NotificationCenter.getGlobalInstance().postNotificationName(
                        NotificationCenter.proxySettingsChanged
                    )
                )
        except Exception:
            pass

    def _hook_proxy_list_and_cells(self):
        act_cls = _resolve_jclass("org.telegram.ui.ProxyListActivity")
        if act_cls is not None:
            try:
                for m in act_cls.getDeclaredMethods():
                    if m.getName() == "createView":
                        m.setAccessible(True)
                        self._hooks.append(self.hook_method(m, ProxyListScreenHook(self)))
                        break
                curr = act_cls
                while curr is not None:
                    done = False
                    for m in curr.getDeclaredMethods():
                        if m.getName() == "onResume":
                            m.setAccessible(True)
                            self._hooks.append(self.hook_method(m, ProxyListScreenHook(self)))
                            done = True
                            break
                    if done:
                        break
                    curr = curr.getSuperclass()
            except Exception as e:
                _plog(f"hook ProxyListActivity err: {e}")

        cell_cls = _resolve_jclass("org.telegram.ui.ProxyListActivity$TextDetailProxyCell") or _resolve_jclass(
            "org.telegram.ui.Cells.TextDetailProxyCell"
        )
        if cell_cls is not None:
            try:
                for m in cell_cls.getDeclaredMethods():
                    if m.getName() == "setProxy":
                        m.setAccessible(True)
                        self._hooks.append(self.hook_method(m, CellSetProxyHook(self)))
                    elif m.getName() == "updateStatus":
                        m.setAccessible(True)
                        self._hooks.append(self.hook_method(m, CellUpdateStatusHook(self)))
            except Exception as e:
                _plog(f"hook cell err: {e}")

    def _hook_settings_header(self):
        try:
            psa_cls = _resolve_jclass("com.exteragram.messenger.plugins.ui.PluginSettingsActivity")
            if psa_cls is not None:
                for m in psa_cls.getDeclaredMethods():
                    if m.getName() == "fillItems" and len(m.getParameterTypes()) == 2:
                        m.setAccessible(True)
                        self._hooks.append(self.hook_method(m, SettingsHeaderHook(self)))
                        break
        except Exception:
            pass

    def _register_connection_observer(self):
        try:
            ev_id = getattr(NotificationCenter, "didUpdateConnectionState", None)
            if ev_id is None:
                return
            self._conn_observer = ConnectionStateObserver(self)
            nc = get_notification_center(UserConfig.selectedAccount)
            run_on_ui_thread(lambda: nc.addObserver(self._conn_observer, ev_id))
        except Exception:
            pass

    def _unregister_connection_observer(self):
        try:
            ev_id = getattr(NotificationCenter, "didUpdateConnectionState", None)
            if ev_id is not None and self._conn_observer is not None:
                nc = get_notification_center(UserConfig.selectedAccount)
                obs = self._conn_observer
                run_on_ui_thread(lambda: nc.removeObserver(obs, ev_id))
        except Exception:
            pass
        self._conn_observer = None

    def _on_connection_state_event(self):
        if not self.get_setting("network_switch_failover", True):
            return
        cur_sig = _get_network_signature()
        if cur_sig in ("offline", "unknown"):
            self._last_net_sig = cur_sig
            return
        if cur_sig != self._last_net_sig:
            self._last_net_sig = cur_sig
            now = time.time()
            if (now - self._last_net_check_ts) < 5.0:
                return
            self._last_net_check_ts = now
            if _is_proxy_enabled_in_client():
                threading.Thread(target=self._verify_active_proxy_on_net_change, daemon=True).start()

    def _verify_active_proxy_on_net_change(self):
        time.sleep(1.5)
        if not self._alive or self._cleaning:
            return
        try:
            PC, _, _ = _get_cached_classes()
            active_key = _get_active_proxy_key(PC)
            if not active_key:
                return
            pl = PC.getProxyList()
            if pl is None:
                return
            active_info = None
            for i in range(int(pl.size())):
                info = pl.get(i)
                k, _, _, _, _, _, _ = _extract_proxy_details(info)
                if k == active_key:
                    active_info = info
                    break
            if active_info is None:
                return
            _, kind, srv, port, sec, user, pwd = _extract_proxy_details(active_info)
            if _is_local_host(srv):
                return
            use_hs = bool(self.get_setting("real_handshake_ping", True))
            ping_ms = _check_proxy_alive(kind, srv, port, sec, user, pwd, use_hs, 3.5)
            if ping_ms is None:
                self.cleanup_dead_proxies_async(manual_trigger=False)
        except Exception:
            pass

    def _inject_proxy_screen_button(self, fragment: Any):
        if fragment is None or not self.get_setting("show_proxy_bar_btn", True):
            return

        def ui():
            try:
                ab = _get_action_bar(fragment)
                if ab is None:
                    return
                menu = ab.createMenu()
                if menu is None:
                    return
                if menu.getItem(MENU_TOOLS_ID) is None:
                    iw = AndroidUtilities.dp(40)
                    ico = _get_drawable_res("msg_settings", _get_drawable_res("ic_ab_other", 0))
                    it = menu.addItemWithWidth(MENU_TOOLS_ID, ico, iw, "Инструменты")
                    it.setOnClickListener(OnClickListener(lambda _v: self._open_proxy_screen_tools(fragment)))
            except Exception:
                pass

        run_on_ui_thread(ui)

    def enqueue_realtime_message(self, source_key: str, tl_msg: Any):
        with self._lock:
            self._rt_queue.setdefault(source_key, []).append(tl_msg)
            if self._rt_worker_running:
                return
            self._rt_worker_running = True

        def _rt_drain_worker():
            time.sleep(0.5)
            while self._alive:
                with self._lock:
                    if not self._rt_queue:
                        self._rt_worker_running = False
                        return
                    batch_map = dict(self._rt_queue)
                    self._rt_queue.clear()

                for s_key, msgs in batch_map.items():
                    if not self._alive:
                        break
                    try:
                        self._process_source_messages_bg(s_key, msgs, manual=False)
                    except Exception:
                        pass

        threading.Thread(target=_rt_drain_worker, daemon=True).start()

    def _pick_menu_icon(self, *candidates: str) -> str:
        for name in candidates:
            if _get_drawable_res(name, 0) != 0:
                return name
        return "msg_download"

    def _sync_chat_menu(self, enabled: bool):
        self.remove_menu_item("apc_chat_menu")
        self._chat_menu_item = None
        if enabled:
            try:
                ico = self._pick_menu_icon(
                    "msg_policy",
                    "msg_proxy",
                    "msg2_proxy",
                    "msg_download",
                )
                self._chat_menu_item = self.add_menu_item(
                    MenuItemData(
                        menu_type=MenuItemType.CHAT_ACTION_MENU,
                        text="Автосбор прокси",
                        icon=ico,
                        item_id="apc_chat_menu",
                        on_click=self._on_chat_menu_click,
                    )
                )
            except Exception:
                pass

    def _sync_msg_menu(self, enabled: bool):
        self.remove_menu_item("apc_msg_menu")
        self._msg_menu_item = None
        if enabled:
            try:
                ico = self._pick_menu_icon(
                    "msg_policy",
                    "msg_proxy",
                    "msg2_proxy",
                    "msg_download",
                )
                self._msg_menu_item = self.add_menu_item(
                    MenuItemData(
                        menu_type=MenuItemType.MESSAGE_CONTEXT_MENU,
                        text="Собрать прокси из поста",
                        icon=ico,
                        item_id="apc_msg_menu",
                        on_click=self._on_message_context_click,
                    )
                )
            except Exception:
                pass
        elif not enabled and self._msg_menu_item is not None:
            try:
                self.remove_menu_item(self._msg_menu_item)
            except Exception:
                pass
            self._msg_menu_item = None

    def _on_message_context_click(self, ctx: dict):
        msg_obj = ctx.get("message") or ctx.get("messageObject")
        owner = getattr(msg_obj, "messageOwner", msg_obj)
        if owner is None:
            BulletinHelper.show_error("Не удалось прочитать сообщение")
            return

        BulletinHelper.show_info("Поиск прокси в сообщении...")

        def worker():
            try:
                acc = int(UserConfig.selectedAccount)
                found = extract_proxies_from_message(
                    owner,
                    allow_mtproto=True,
                    allow_socks5=True,
                    allow_web=True,
                    only_faketls=bool(self.get_setting("only_faketls", False)),
                    parse_attachments=True,
                    account_id=acc,
                )
                self._save_proxies_native(found, manual=True, bypass_dead_cache=True)
            except Exception as e:
                run_on_ui_thread(lambda: BulletinHelper.show_error(f"Ошибка разбора поста: {e}"))

        threading.Thread(target=worker, daemon=True).start()

    def _get_sources(self) -> Dict[str, Dict[str, Any]]:
        raw = self.get_setting("sources_json", "{}")
        try:
            data = json.loads(str(raw))
            if isinstance(data, dict):
                return data
        except Exception:
            pass
        return {}

    def _save_sources(self, sources: Dict[str, Dict[str, Any]], reload_ui: bool = False):
        self.set_setting(
            "sources_json",
            json.dumps(sources, ensure_ascii=False),
            reload_settings=reload_ui,
        )

    def _add_source(
        self, dialog_id: int, topic_id: int = 0, custom_title: str = "", reload_ui: bool = True
    ) -> str:
        did = _normalize_dialog_id(dialog_id)
        tid = int(topic_id or 0) if _is_forum_chat(did) else 0
        key = _make_source_key(did, tid)

        base_title = _get_dialog_title(did)
        if custom_title and str(custom_title).strip() not in ("", "0"):
            title = str(custom_title).strip()
        else:
            title = f"{base_title} [Топик #{tid}]" if tid > 0 else base_title

        with self._lock:
            sources = self._get_sources()
            prev = sources.get(key, {})
            sources[key] = {
                "type": "chat",
                "dialog_id": did,
                "topic_id": tid,
                "title": title,
                "last_msg_id": int(prev.get("last_msg_id", 0) or 0),
                "added_count": int(prev.get("added_count", 0) or 0),
                "paused": bool(prev.get("paused", False)),
            }
            self._save_sources(sources, reload_ui=reload_ui)
        return title

    def _add_url_source(self, url: str, reload_ui: bool = True) -> str:
        u = url.strip()
        if not u.startswith(("http://", "https://")):
            u = "https://" + u
        key = _make_url_source_key(u)
        parsed = urllib.parse.urlparse(u)
        short_name = f"{parsed.netloc}{parsed.path[:24]}"
        with self._lock:
            sources = self._get_sources()
            prev = sources.get(key, {})
            sources[key] = {
                "type": "url",
                "url": u,
                "title": short_name,
                "added_count": int(prev.get("added_count", 0) or 0),
                "paused": bool(prev.get("paused", False)),
            }
            self._save_sources(sources, reload_ui=reload_ui)
        return short_name

    def _connect_random_working_proxy(self):
        try:
            PC, _, _ = _get_cached_classes()
            pl = PC.getProxyList()
            if pl is None or int(pl.size()) == 0:
                BulletinHelper.show_info("Список прокси пуст")
                return

            active_key = _get_active_proxy_key(PC)
            working = []
            fallback = []

            for i in range(int(pl.size())):
                info = pl.get(i)
                if info is None:
                    continue
                k, _, srv, _, _, _, _ = _extract_proxy_details(info)
                if not k or k == active_key or _is_local_host(srv):
                    continue
                av, ping = _get_proxy_ping_and_avail(info)
                host = _extract_connect_host(srv)
                if av:
                    working.append((info, host, ping))
                else:
                    fallback.append((info, host, 0))

            pool = working if working else fallback
            if not pool:
                BulletinHelper.show_info("Нет других прокси для переключения")
                return

            chosen, host, ping = random.choice(pool)
            if _activate_proxy_info(PC, chosen):
                suffix = f" ({ping} мс)" if ping > 0 else ""
                BulletinHelper.show_success(f"Подключён: {host}{suffix}")
            else:
                BulletinHelper.show_error("Не удалось активировать прокси")
        except Exception as e:
            BulletinHelper.show_error(f"Ошибка: {e}")

    def deduplicate_existing_proxies_ui(self, show_toast_if_zero: bool = False) -> int:
        removed_dups = 0
        try:
            PC, _, _ = _get_cached_classes()
            pl = PC.getProxyList()
            if pl is None or int(pl.size()) <= 1:
                if show_toast_if_zero:
                    BulletinHelper.show_info("Дубликатов в списке нет")
                return 0

            active_key = _get_active_proxy_key(PC)
            seen_keys: Set[str] = set()
            if active_key:
                seen_keys.add(active_key)

            kept_active = False
            to_delete: List[Any] = []

            for i in range(int(pl.size())):
                info = pl.get(i)
                if info is None:
                    continue
                k, _, _, _, _, _, _ = _extract_proxy_details(info)
                if not k:
                    continue
                if active_key and k == active_key and not kept_active:
                    kept_active = True
                    continue
                if k in seen_keys:
                    to_delete.append(info)
                else:
                    seen_keys.add(k)

            for dup_info in to_delete:
                if _delete_proxy_from_controller(PC, dup_info):
                    removed_dups += 1

            if removed_dups > 0:
                try:
                    _persist_proxy_controller(PC)
                    _sync_fragment_proxy_list(PC, [pl.get(i) for i in range(int(pl.size()))])
                except Exception:
                    pass
                if show_toast_if_zero or self.get_setting("show_bulletin", True):
                    BulletinHelper.show_success(f"Удалено дубликатов: {removed_dups}")
            elif show_toast_if_zero:
                BulletinHelper.show_success("Дубликатов не обнаружено")
        except Exception as e:
            _plog(f"dedup err: {e}")
        return removed_dups

    def _sort_proxies_by_ping_inplace(self, PC: Any, silent: bool = False):
        def ui():
            try:
                pl = PC.getProxyList()
                if pl is None or int(pl.size()) <= 1:
                    if not silent:
                        BulletinHelper.show_info("Нечего сортировать")
                    return

                items = [pl.get(i) for i in range(int(pl.size())) if pl.get(i) is not None]

                def sort_key(info):
                    _, _, srv, _, _, _, _ = _extract_proxy_details(info)
                    if _is_local_host(srv):
                        return (0, 0)
                    try:
                        if hasattr(PC, "isPinned") and bool(PC.isPinned(info)):
                            pin_idx = int(PC.getPinnedIndex(info)) if hasattr(PC, "getPinnedIndex") else 0
                            return (0, pin_idx + 1)
                    except Exception:
                        pass
                    av, ping = _get_proxy_ping_and_avail(info)
                    if av and ping > 0:
                        return (1, ping)
                    if av:
                        return (1, 99999)
                    return (2, 0)

                items.sort(key=sort_key)

                if _replace_proxy_list_in_controller(PC, items):
                    if not silent:
                        BulletinHelper.show_success("Отсортировано по пингу")
                elif not silent:
                    BulletinHelper.show_error("Не удалось изменить порядок списка")
            except Exception as e:
                if not silent:
                    BulletinHelper.show_error(f"Ошибка сортировки: {e}")

        run_on_ui_thread(ui)

    def _save_proxies_native(
        self,
        proxies: List[ParsedProxy],
        source_key: Optional[str] = None,
        dialog_id: int = 0,
        max_msg_id: int = 0,
        manual: bool = False,
        bypass_dead_cache: bool = False,
    ):
        def ui():
            try:
                self.deduplicate_existing_proxies_ui(show_toast_if_zero=False)

                PC, ProxyInfo, PS = _get_cached_classes()
                max_per_host = self._get_max_per_host()
                now = time.time()

                existing_keys: Set[str] = set()
                host_counts: Dict[str, int] = {}

                pl = PC.getProxyList()
                if pl is not None:
                    for i in range(int(pl.size())):
                        info = pl.get(i)
                        if info is not None:
                            k, _, srv, _, _, _, _ = _extract_proxy_details(info)
                            if k:
                                existing_keys.add(k)
                            h = _extract_connect_host(srv)
                            if h:
                                host_counts[h] = host_counts.get(h, 0) + 1

                added = 0
                dups = 0
                blacklisted = 0
                skipped = 0
                counts = {"mtproto": 0, "socks5": 0, "web": 0}

                for p in proxies:
                    if p.key in existing_keys:
                        dups += 1
                        continue

                    if not bypass_dead_cache and self._dead_cache.get(p.key, 0) > now:
                        blacklisted += 1
                        continue

                    h_only = p.host_only
                    if max_per_host > 0 and host_counts.get(h_only, 0) >= max_per_host:
                        skipped += 1
                        continue

                    try:
                        uri_str = p.to_uri()
                        ps = PS.fromUri(Uri.parse(uri_str))
                        if ps is None:
                            skipped += 1
                            continue

                        ps_key, _, _, _, _, _, _ = _extract_proxy_details(ps)
                        if ps_key and ps_key in existing_keys:
                            dups += 1
                            continue

                        PC.addProxy(ProxyInfo(ps))
                        existing_keys.add(p.key)
                        if ps_key:
                            existing_keys.add(ps_key)
                        host_counts[h_only] = host_counts.get(h_only, 0) + 1
                        added += 1
                        counts[p.kind] = counts.get(p.kind, 0) + 1
                    except Exception:
                        skipped += 1

                if source_key:
                    with self._lock:
                        sources = self._get_sources()
                        if source_key in sources:
                            if max_msg_id > 0:
                                prev_max = int(sources[source_key].get("last_msg_id", 0) or 0)
                                if max_msg_id > prev_max:
                                    sources[source_key]["last_msg_id"] = int(max_msg_id)
                            sources[source_key]["added_count"] = (
                                int(sources[source_key].get("added_count", 0) or 0) + added
                            )
                            self._save_sources(sources, reload_ui=False)

                if self.get_setting("mark_read_after_collect", False) and dialog_id != 0 and max_msg_id > 0:
                    self._mark_dialog_read_safely(dialog_id, max_msg_id)

                if added > 0:
                    total_ever = int(self.get_setting("total_collected_count", 0) or 0) + added
                    self.set_setting("total_collected_count", total_ever, reload_settings=False)

                    try:
                        _persist_proxy_controller(PC)
                        pl_now = PC.getProxyList()
                        if pl_now is not None:
                            _sync_fragment_proxy_list(PC, [pl_now.get(i) for i in range(int(pl_now.size()))])
                    except Exception:
                        pass

                    if self.get_setting("show_bulletin", True):
                        parts = []
                        if counts["mtproto"]:
                            parts.append(f"MTProto: {counts['mtproto']}")
                        if counts["socks5"]:
                            parts.append(f"SOCKS5: {counts['socks5']}")
                        if counts["web"]:
                            parts.append(f"WEB: {counts['web']}")
                        suffix = f" ({', '.join(parts)})" if parts else ""
                        BulletinHelper.show_success(f"Добавлено прокси: {added}{suffix}")
                elif manual:
                    if dups > 0:
                        BulletinHelper.show_info(f"Все найденные прокси ({dups}) уже в списке")
                    elif blacklisted > 0:
                        BulletinHelper.show_info(f"Пропущено мёртвых из кэша: {blacklisted}")
                    elif skipped > 0:
                        BulletinHelper.show_info(f"Пропущено по лимиту/формату: {skipped}")
                    else:
                        BulletinHelper.show_info("Новых прокси не найдено")

                if self.get_setting("auto_clean_on_limit", False):
                    pl_after = PC.getProxyList()
                    cur_size = int(pl_after.size()) if pl_after is not None else 0
                    max_limit = self._get_max_proxy_limit()
                    if max_limit > 0 and cur_size > max_limit:
                        self.cleanup_dead_proxies_async(manual_trigger=False)

            except Exception as e:
                if manual:
                    BulletinHelper.show_error(f"Ошибка сохранения: {e}")

        run_on_ui_thread(ui)

    @staticmethod
    def _mark_dialog_read_safely(dialog_id: int, max_msg_id: int):
        try:
            acc = int(UserConfig.selectedAccount)
            mc = MessagesController.getInstance(acc)
            mc.markDialogAsRead(int(dialog_id), int(max_msg_id), int(max_msg_id), 0, False, 0, 0, True, 0)
        except Exception:
            pass

    def cleanup_dead_proxies_async(self, manual_trigger: bool = False):
        if self._cleaning:
            if manual_trigger:
                BulletinHelper.show_info("Проверка уже выполняется...")
            return

        def _collect_on_ui():
            try:
                removed_dups = self.deduplicate_existing_proxies_ui(show_toast_if_zero=False)
                PC, _, _ = _get_cached_classes()
                pl = PC.getProxyList()
                if pl is None or int(pl.size()) == 0:
                    if manual_trigger:
                        BulletinHelper.show_info("Список прокси пуст")
                    return

                active_key = _get_active_proxy_key(PC)
                use_handshake = bool(self.get_setting("real_handshake_ping", True))

                targets: List[Tuple[str, str, str, int, str, str, str]] = []
                seen_keys: Set[str] = set()

                for i in range(int(pl.size())):
                    info = pl.get(i)
                    if info is None:
                        continue
                    k, kind, srv, port, sec, user, pwd = _extract_proxy_details(info)
                    if not k or _is_local_host(srv):
                        continue
                    if k not in seen_keys:
                        seen_keys.add(k)
                        targets.append((k, kind, srv, port, sec, user, pwd))

                if not targets:
                    if manual_trigger:
                        BulletinHelper.show_info("Нет внешних прокси для проверки")
                    return

                if manual_trigger:
                    BulletinHelper.show_info(f"Проверка {len(targets)} прокси...")

                threading.Thread(
                    target=_ping_worker_bg,
                    args=(targets, active_key, use_handshake, removed_dups),
                    daemon=True,
                ).start()
            except Exception:
                pass

        def _ping_worker_bg(
            targets: List[Tuple[str, str, str, int, str, str, str]],
            active_key: str,
            use_handshake: bool,
            removed_dups: int,
        ):
            self._cleaning = True
            dead_keys: Set[str] = set()
            alive_pings: Dict[str, int] = {}

            try:
                with ThreadPoolExecutor(max_workers=10) as pool:
                    future_map = {
                        pool.submit(
                            _check_proxy_alive, kind, srv, port, sec, user, pwd, use_handshake, 4.0
                        ): k
                        for (k, kind, srv, port, sec, user, pwd) in targets
                    }
                    for fut in as_completed(future_map):
                        k = future_map[fut]
                        try:
                            ping_ms = fut.result()
                        except Exception:
                            ping_ms = None

                        if ping_ms is None:
                            dead_keys.add(k)
                        else:
                            alive_pings[k] = ping_ms

                run_on_ui_thread(
                    lambda: _apply_results_on_ui(
                        len(targets), dead_keys, alive_pings, active_key, removed_dups
                    )
                )
            except Exception:
                self._cleaning = False

        def _apply_results_on_ui(
            total_checked: int,
            dead_keys: Set[str],
            alive_pings: Dict[str, int],
            active_key: str,
            removed_dups: int,
        ):
            try:
                PC, _, _ = _get_cached_classes()
                pl = PC.getProxyList()
                if pl is None:
                    return

                if not manual_trigger and total_checked >= 4 and len(dead_keys) > (total_checked * 0.5):
                    return

                max_limit = self._get_max_proxy_limit()
                trim_slowest = bool(self.get_setting("trim_slowest_on_limit", True))
                do_failover = bool(self.get_setting("auto_failover", True))
                auto_sort = bool(self.get_setting("auto_sort_after_check", True))
                strikes_needed = self._get_strike_limit()
                dead_ttl_sec = self._get_dead_ttl_hours() * 3600

                to_delete_dead: List[Tuple[str, Any]] = []
                alive_objects: List[Tuple[int, str, Any]] = []
                now_rt = _elapsed_ms()
                now_wall = time.time()
                cache_dirty = False

                for i in range(int(pl.size())):
                    info = pl.get(i)
                    if info is None:
                        continue
                    k, _, srv, _, _, _, _ = _extract_proxy_details(info)
                    if not k or _is_local_host(srv):
                        continue

                    if k in dead_keys:
                        try:
                            info.available = False
                            info.ping = 0
                            info.availableCheckTime = now_rt
                        except Exception:
                            pass

                        cur_strikes = self._strikes.get(k, 0) + 1
                        self._strikes[k] = cur_strikes
                        cache_dirty = True
                        if cur_strikes >= strikes_needed and k != active_key:
                            to_delete_dead.append((k, info))
                    elif k in alive_pings:
                        p_ms = alive_pings[k]
                        if self._strikes.pop(k, None) is not None:
                            cache_dirty = True
                        if self._dead_cache.pop(k, None) is not None:
                            cache_dirty = True
                        try:
                            info.ping = int(p_ms)
                            info.available = True
                            info.availableCheckTime = now_rt
                        except Exception:
                            pass
                        alive_objects.append((p_ms, k, info))

                alive_objects.sort(key=lambda x: x[0])

                switched_msg = ""
                if (
                    do_failover
                    and active_key
                    and active_key in dead_keys
                    and _is_proxy_enabled_in_client()
                    and alive_objects
                ):
                    best_ping, best_key, best_info = alive_objects[0]
                    if _activate_proxy_info(PC, best_info):
                        if self._strikes.get(active_key, 0) >= strikes_needed:
                            for i in range(int(pl.size())):
                                old_inf = pl.get(i)
                                ok_k, _, _, _, _, _, _ = _extract_proxy_details(old_inf)
                                if ok_k == active_key:
                                    to_delete_dead.append((active_key, old_inf))
                                    break
                        active_key = best_key
                        switched_msg = f" · Failover → {best_ping} мс"

                deleted_dead = 0
                deleted_slow = 0

                for k, info in to_delete_dead:
                    if k == active_key:
                        continue
                    if _delete_proxy_from_controller(PC, info):
                        deleted_dead += 1
                        self._strikes.pop(k, None)
                        if dead_ttl_sec > 0:
                            self._dead_cache[k] = now_wall + dead_ttl_sec
                        cache_dirty = True

                cur_size = int(pl.size())
                if trim_slowest and max_limit > 0 and cur_size > max_limit:
                    excess = cur_size - max_limit
                    for _ping, k, info in reversed(alive_objects):
                        if excess <= 0:
                            break
                        if k == active_key:
                            continue
                        if _delete_proxy_from_controller(PC, info):
                            deleted_slow += 1
                            excess -= 1

                if cache_dirty:
                    self._save_dead_and_strikes()

                if auto_sort:
                    self._sort_proxies_by_ping_inplace(PC, silent=True)
                else:
                    _persist_proxy_controller(PC)
                    _sync_fragment_proxy_list(PC, [pl.get(i) for i in range(int(pl.size()))])

                total_removed = deleted_dead + deleted_slow + removed_dups
                if manual_trigger or switched_msg or (total_removed > 0 and self.get_setting("show_bulletin", True)):
                    remaining = int(pl.size())
                    if total_removed > 0 or switched_msg:
                        parts = [f"удалено: {deleted_dead}"]
                        if deleted_slow > 0:
                            parts.append(f"медл.: {deleted_slow}")
                        if removed_dups > 0:
                            parts.append(f"дублей: {removed_dups}")
                        BulletinHelper.show_success(
                            f"Очистка ({', '.join(parts)}){switched_msg} · Осталось: {remaining}"
                        )
                    elif manual_trigger:
                        if dead_keys and strikes_needed > 1:
                            BulletinHelper.show_info(
                                f"Выданы страйки ({len(dead_keys)} шт., удаление после {strikes_needed})"
                            )
                        else:
                            BulletinHelper.show_success(f"Все прокси рабочие ({remaining} шт.)")
            except Exception as e:
                _plog(f"apply results err: {e}")
            finally:
                self._cleaning = False

        run_on_ui_thread(_collect_on_ui)

    def _run_header_tool_action(self, tool_key: str, act: Any):
        if tool_key == "collect":
            self._scan_sources_async(manual=True)
        elif tool_key == "random":
            self._connect_random_working_proxy()
        elif tool_key == "import":
            self._open_import_sheet(act)
        elif tool_key == "export":
            self._open_export_sheet(act)
        elif tool_key == "sort":
            self._sort_proxies_by_ping_inplace(_get_cached_classes()[0], silent=False)
        elif tool_key == "country":
            self._open_country_filter_sheet(act)
        elif tool_key == "dedup":
            self.deduplicate_existing_proxies_ui(show_toast_if_zero=True)
        elif tool_key == "clean":
            self.cleanup_dead_proxies_async(manual_trigger=True)

    def _open_proxy_screen_tools(self, fragment: Any):
        act = fragment.getParentActivity() if fragment else None
        if act is None:
            return

        order, disabled = self._get_header_tools_config()
        actions: List[Tuple[str, str, Callable[[], None], bool]] = []

        for key in order:
            if key in disabled or key not in HEADER_TOOLS_META:
                continue
            label, ico, is_red = HEADER_TOOLS_META[key]
            actions.append(
                (label, ico, lambda k=key, a=act: self._run_header_tool_action(k, a), is_red)
            )

        show_edit_btn = bool(self.get_setting("show_edit_menu_btn", True))
        if show_edit_btn or not actions:
            actions.append(
                ("Настроить это меню", "msg_settings", lambda a=act: self._open_header_tools_editor_sheet(a), False)
            )

        _show_action_sheet(act, "Инструменты прокси", actions)

    def _open_header_tools_editor_sheet(self, act: Any = None):
        if act is None:
            frag = get_last_fragment()
            act = frag.getParentActivity() if frag else None
        if act is None:
            return

        def ui():
            try:
                sheet = BottomSheet(act, False)
                sheet.setApplyBottomPadding(False)
                sheet.setApplyTopPadding(False)

                root = LinearLayout(act)
                root.setOrientation(LinearLayout.VERTICAL)
                root.setPadding(
                    AndroidUtilities.dp(18),
                    AndroidUtilities.dp(10),
                    AndroidUtilities.dp(18),
                    AndroidUtilities.dp(16),
                )
                bg = GradientDrawable()
                bg.setCornerRadii([
                    AndroidUtilities.dp(20), AndroidUtilities.dp(20),
                    AndroidUtilities.dp(20), AndroidUtilities.dp(20),
                    0, 0, 0, 0,
                ])
                bg.setColor(Theme.getColor(Theme.key_dialogBackground))
                root.setBackground(bg)

                pill = View(act)
                pill_bg = GradientDrawable()
                pill_bg.setCornerRadius(AndroidUtilities.dp(2))
                pill_bg.setColor(0x40808080)
                pill.setBackground(pill_bg)
                root.addView(pill, LayoutHelper.createLinear(36, 4, Gravity.CENTER_HORIZONTAL, 0, 0, 0, 12))

                tv_title = TextView(act)
                tv_title.setText("Меню в шапке прокси")
                tv_title.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 19)
                tv_title.setTypeface(AndroidUtilities.getTypeface("fonts/rmedium.ttf"))
                tv_title.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
                tv_title.setGravity(Gravity.CENTER)
                root.addView(tv_title, LayoutHelper.createLinear(-1, -2, Gravity.CENTER, 0, 0, 0, 4))

                tv_hint = TextView(act)
                tv_hint.setText("Нажмите — скрыть или вернуть · Зажмите ≡ — перетащить")
                tv_hint.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13)
                tv_hint.setTextColor(Theme.getColor(Theme.key_dialogTextGray3))
                tv_hint.setGravity(Gravity.CENTER)
