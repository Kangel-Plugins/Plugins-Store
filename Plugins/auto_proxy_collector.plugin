def _is_collect_proxy_url(raw: str) -> bool:
    try:
        p = urllib.parse.urlsplit(str(raw).strip().rstrip(").,\"'»]"))
        return p.scheme.lower() in ("http", "https") and (p.hostname or "").lower() == "collect.proxy"
    except Exception:
        return False

def _read_http_text(response: Any, limit: int = MAX_SOURCE_BYTES) -> str:
    data = response.read(limit + 1)
    if len(data) > limit:
        raise ValueError(f"Источник слишком большой (максимум {limit // 1024} КБ)")
    return data.decode("utf-8", errors="ignore")

def _utf16_slice(value: str, offset: int, length: int) -> str:
    data = value.encode("utf-16-le")
    start = max(0, offset) * 2
    stop = start + max(0, length) * 2
    return data[start:stop].decode("utf-16-le", errors="ignore")

def _utf16_len(value: str) -> int:
    return len(value.encode("utf-16-le")) // 2

def _proxy_quality_label(pings: List[int], working: List[bool]) -> str:
    measured = [int(p) for p in pings if int(p) > 0]
    if not measured:
        return "Без проверки"
    if len(measured) != len(pings):
        return "Без проверки"
    if working and not all(working):
        return "Сойдёт"
    worst = max(measured)
    if worst <= 80:
        return "Идеально"
    if worst <= 150:
        return "Стабильно"
    if worst <= 250:
        return "Хорошо"
    if worst <= 400:
        return "Нормально"
    return "Сойдёт"

def _build_proxy_post(
    links: List[str], start_number: int, pings: List[int], working: List[bool],
):
    prefix = "🔗Telegram Proxy\n"
    measured = [int(p) for p in pings if int(p) > 0]
    ping_label = f"от {min(measured)}мс до {max(measured)} мс" if measured else "нет данных"
    prefix += f"🏓Пинг: {ping_label}\n🛠Оценка задержки: {_proxy_quality_label(pings, working)}\n"
    quote = ""
    link_entities = []
    for i, url in enumerate(links):
        if i:
            quote += "\n" if (i % 5 == 0) else " "
        label = f"Proxy#{start_number + i}"
        off = _utf16_len(prefix) + _utf16_len(quote)
        link_entities.append((off, _utf16_len(label), url))
        quote += label
    return prefix + quote, _utf16_len(prefix), _utf16_len(quote), link_entities

def _plan_proxy_export_chunks(
    entries: List[Tuple[str, int, bool]], start_number: int, requested_batch: int,
) -> List[Tuple[int, int]]:
    if requested_batch < 1:
        raise ValueError("Размер пачки должен быть положительным")
    chunks: List[Tuple[int, int]] = []
    cursor = 0
    while cursor < len(entries):
        max_count = min(requested_batch, EXPORT_MAX_LINKS_PER_POST, len(entries) - cursor)
        count = 0
        url_bytes = 0
        for index in range(max_count):
            url = entries[cursor + index][0]
            size = len(url.encode("utf-8"))
            if index and url_bytes + size > EXPORT_MAX_URL_BYTES_PER_POST:
                break
            url_bytes += size
            count += 1
            if url_bytes > EXPORT_MAX_URL_BYTES_PER_POST:
                break
        while count > 0:
            chosen = entries[cursor:cursor + count]
            text, quote_offset, quote_length, links = _build_proxy_post(
                [p[0] for p in chosen], start_number + cursor,
                [p[1] for p in chosen], [p[2] for p in chosen],
            )
            text_size = _utf16_len(text)
            if text_size <= EXPORT_MAX_TEXT_UTF16:
                if quote_length <= 0 or quote_offset + quote_length != text_size:
                    raise ValueError("Ошибка диапазона цитаты Proxy#")
                previous_end = quote_offset
                for offset, length, _url in links:
                    if length <= 0 or offset < previous_end or offset + length > text_size:
                        raise ValueError("Ошибка UTF-16 диапазона ссылки Proxy#")
                    previous_end = offset + length
                chunks.append((cursor, count))
                cursor += count
                break
            count -= 1
        if count <= 0:
            raise ValueError("Не удалось сформировать сообщение допустимой длины")
    return chunks

def _plog(msg: str):
    log(f"[ProxyCollector] {msg}")

def _resolve_jclass(cls_or_name: Any):
    if cls_or_name is None:
        return None
    if isinstance(cls_or_name, str):
        try:
            return jclass("java.lang.Class").forName(
                cls_or_name, False, ApplicationLoader.applicationContext.getClassLoader()
            )
        except Exception:
            try:
                obj = find_class(cls_or_name)
                if obj is not None:
                    return obj if hasattr(obj, "getDeclaredMethods") else obj.getClass()
            except Exception:
                pass
            return None
    if hasattr(cls_or_name, "getDeclaredMethods"):
        return cls_or_name
    if hasattr(cls_or_name, "getClass"):
        try:
            c = cls_or_name.getClass()
            if c is not None and hasattr(c, "getDeclaredMethods"):
                return c
        except Exception:
            pass
    return None

class _ProxyControllerCompat:
    def __init__(self, inst: Any, cls: Any):
        self._inst = inst
        self._cls = cls
        self._method_cache: Dict[Tuple[str, int], Tuple[Any, Any]] = {}

    def _invoke(self, names: Tuple[str, ...], *args) -> Tuple[bool, Any]:
        n_args = len(args)
        for name in names:
            cache_key = (name, n_args)
            if cache_key in self._method_cache:
                target, fn = self._method_cache[cache_key]
                if fn is None:
                    continue
                try:
                    if target == "attr":
                        return True, fn(*args)
                    return True, fn.invoke(target, list(args))
                except Exception:
                    self._method_cache.pop(cache_key, None)

            for candidate in (self._inst, self._cls):
                if candidate is None:
                    continue
                try:
                    attr = getattr(candidate, name, None)
                    if callable(attr):
                        res = attr(*args)
                        self._method_cache[cache_key] = ("attr", attr)
                        return True, res
                except Exception:
                    pass

            jcls_obj = _resolve_jclass(self._cls)
            if jcls_obj is not None:
                try:
                    for m in jcls_obj.getDeclaredMethods():
                        if str(m.getName()) != name:
                            continue
                        if len(list(m.getParameterTypes())) != n_args:
                            continue
                        m.setAccessible(True)
                        is_static = bool(int(m.getModifiers()) & 8)
                        target_obj = None if is_static else self._inst
                        if not is_static and target_obj is None:
                            continue
                        res = m.invoke(target_obj, list(args))
                        self._method_cache[cache_key] = (target_obj, m)
                        return True, res
                except Exception:
                    pass

            self._method_cache[cache_key] = (None, None)
        return False, None

    def getProxyList(self):
        ok, res = self._invoke(("getProxyList", "getProxies"))
        if ok and res is not None:
            return res
        try:
            SharedConfig.loadProxyList()
            return getattr(SharedConfig, "proxyList", None)
        except Exception:
            return None

    def addProxy(self, info: Any) -> bool:
        ok, _ = self._invoke(("addProxy",), info)
        if ok:
            return True
        try:
            if hasattr(SharedConfig, "addProxy"):
                SharedConfig.addProxy(info)
                return True
        except Exception:
            pass
        try:
            SharedConfig.loadProxyList()
            pl = getattr(SharedConfig, "proxyList", None)
            if pl is not None:
                pl.add(info)
                SharedConfig.saveProxyList()
                return True
        except Exception:
            pass
        return False

    def deleteProxy(self, info: Any) -> bool:
        ok, _ = self._invoke(("deleteProxy", "removeProxy"), info)
        try:
            SharedConfig.deleteProxy(info)
        except Exception:
            pass
        return ok

    def removeProxy(self, info: Any) -> bool:
        return self.deleteProxy(info)

    def setCurrentProxy(self, info: Any):
        ok, _ = self._invoke(
            (
                "setCurrentProxy",
                "connectProxy",
                "selectProxy",
                "enableProxy",
                "setProxy",
                "switchProxy",
                "activateProxy",
                "setCurrentProxyInfo",
            ),
            info,
        )
        if ok:
            return
        jcls_obj = _resolve_jclass(self._cls)
        if jcls_obj is not None:
            ps_obj = getattr(info, "settings", None)
            for m in jcls_obj.getDeclaredMethods():
                try:
                    m_name = str(m.getName())
                    m_low = m_name.lower()
                    if any(bad in m_low for bad in ("add", "delete", "remove", "pin", "check", "update", "save", "sync", "load", "get")):
                        continue
                    pts = list(m.getParameterTypes())
                    if len(pts) != 1:
                        continue
                    p_type = str(pts[0].getName())
                    arg_to_pass = None
                    if "ProxyInfo" in p_type:
                        arg_to_pass = info
                    elif "ProxySettings" in p_type and ps_obj is not None:
                        arg_to_pass = ps_obj
                    if arg_to_pass is None:
                        continue
                    m.setAccessible(True)
                    is_static = bool(int(m.getModifiers()) & 8)
                    target_obj = None if is_static else self._inst
                    if not is_static and target_obj is None:
                        continue
                    m.invoke(target_obj, [arg_to_pass])
                    self._method_cache[(m_name, 1)] = (target_obj, m)
                    return
                except Exception:
                    pass
        raise AttributeError("setCurrentProxy unavailable")

    def getCurrentProxy(self):
        ok, res = self._invoke(("getCurrentProxy",))
        if ok and res is not None:
            return res
        for holder in (self._inst, self._cls, SharedConfig):
            if holder is not None:
                cur = getattr(holder, "currentProxy", None)
                if cur is not None:
                    return cur
        return None

    def isPinned(self, info: Any) -> bool:
        ok, res = self._invoke(("isPinned",), info)
        return bool(res) if ok else False

    def getPinnedIndex(self, info: Any) -> int:
        ok, res = self._invoke(("getPinnedIndex",), info)
        return int(res) if (ok and res is not None) else 0

    def save(self):
        ok, _ = self._invoke(("save", "saveProxyList"))
        if not ok:
            try:
                SharedConfig.saveProxyList()
            except Exception:
                pass

    def syncProxyList(self):
        self._invoke(("syncProxyList",))

    def checkProxyList(self):
        self._invoke(("checkProxyList",))

    def buildSettings(self, *args):
        ok, res = self._invoke(("buildSettings",), *args)
        return res if ok else None


def _get_cached_classes() -> Tuple[Any, Any, Any]:
    if "PC_compat" not in _JAVA_CACHE:
        try:
            SharedConfig.loadProxyList()
        except Exception:
            pass
        pc_cls = None
        pc_inst = None
        try:
            pc_cls = jclass("com.exteragram.messenger.proxy.ProxyController")
        except Exception:
            pc_cls = None
        if pc_cls is not None:
            try:
                pc_inst = pc_cls.getInstance()
            except Exception:
                pc_inst = getattr(pc_cls, "INSTANCE", None)
        _JAVA_CACHE["PC_compat"] = _ProxyControllerCompat(pc_inst, pc_cls)
    if "ProxyInfo_cls" not in _JAVA_CACHE:
        _JAVA_CACHE["ProxyInfo_cls"] = jclass("org.telegram.messenger.SharedConfig$ProxyInfo")
    if "PS_cls" not in _JAVA_CACHE:
        _JAVA_CACHE["PS_cls"] = jclass("org.telegram.utils.proxy.ProxySettings")
    return (
        _JAVA_CACHE["PC_compat"],
        _JAVA_CACHE["ProxyInfo_cls"],
        _JAVA_CACHE["PS_cls"],
    )

def _elapsed_ms() -> int:
    try:
        return int(SystemClock.elapsedRealtime())
    except Exception:
        return int(time.monotonic() * 1000)

def _is_vpn_active() -> bool:
    try:
        ctx = ApplicationLoader.applicationContext
        cm = ctx.getSystemService(Context.CONNECTIVITY_SERVICE)
        if cm is not None:
            try:
                info = cm.getActiveNetworkInfo()
                if info is not None and info.isConnected() and int(info.getType()) == 17:
                    return True
            except Exception:
                pass
            try:
                active_net = cm.getActiveNetwork()
                if active_net is not None:
                    caps = cm.getNetworkCapabilities(active_net)
                    if caps is not None and bool(caps.hasTransport(4)):
                        return True
            except Exception:
                pass
            try:
                nets = cm.getAllNetworks()
                if nets is not None:
                    for net in nets:
                        if net is None:
                            continue
                        caps = cm.getNetworkCapabilities(net)
                        if caps is not None and bool(caps.hasTransport(4)):
                            return True
            except Exception:
                pass
    except Exception:
        pass
    try:
        NetworkInterface = jclass("java.net.NetworkInterface")
        ifaces = NetworkInterface.getNetworkInterfaces()
        while ifaces is not None and ifaces.hasMoreElements():
            nif = ifaces.nextElement()
            if nif is None or not bool(nif.isUp()) or bool(nif.isLoopback()):
                continue
            name = str(nif.getName() or "").lower()
            if name.startswith(("tun", "ppp", "wg", "utun")):
                return True
    except Exception:
        pass
    return False


def _get_network_signature() -> str:
    try:
        ctx = ApplicationLoader.applicationContext
        cm = ctx.getSystemService(Context.CONNECTIVITY_SERVICE)
        if cm is None:
            return "vpn" if _is_vpn_active() else "unknown"
        info = cm.getActiveNetworkInfo()
        if info is None or not info.isConnected():
            return "offline"
        if _is_vpn_active():
            return "vpn"
        ntype = int(info.getType())
        if ntype == 1:
            return "wifi"
        if ntype == 0:
            return "mobile"
        if ntype == 17:
            return "vpn"
        return f"net_{ntype}"
    except Exception:
        return "vpn" if _is_vpn_active() else "unknown"

def _is_screen_interactive() -> bool:
    try:
        ctx = ApplicationLoader.applicationContext
        pm = ctx.getSystemService(Context.POWER_SERVICE)
        if pm is not None and hasattr(pm, "isInteractive"):
            return bool(pm.isInteractive())
    except Exception:
        pass
    return True

def _is_local_host(addr: str) -> bool:
    h = (addr or "").split("/")[0].strip().lower()
    return h in ("127.0.0.1", "localhost", "::1", "0.0.0.0") or h.startswith("127.")

def _normalize_dialog_id(raw_id: Any) -> int:
    try:
        val = int(str(raw_id).strip())
    except Exception:
        return 0
    if val == 0:
        return 0
    s = str(abs(val))
    if val < 0 and s.startswith("100") and len(s) >= 12:
        try:
            return -int(s[3:])
        except Exception:
            pass
    return val

def _make_source_key(dialog_id: int, topic_id: int = 0) -> str:
    did = _normalize_dialog_id(dialog_id)
    tid = int(topic_id or 0)
    return f"{did}_{tid}" if tid > 0 else f"{did}"

def _make_url_source_key(url: str) -> str:
    digest = hashlib.sha1(url.strip().encode("utf-8")).hexdigest()[:12]
    return f"url_{digest}"

def _parse_source_key(key: str, meta: Optional[Dict[str, Any]] = None) -> Tuple[int, int]:
    if meta:
        if meta.get("type") == "url" or str(key).startswith("url_"):
            return 0, 0
        did = _normalize_dialog_id(meta.get("dialog_id", 0))
        tid = int(meta.get("topic_id", 0) or 0)
        if did != 0:
            return did, tid
    s = str(key)
    if s.startswith("url_"):
        return 0, 0
    if "_" in s:
        p1, p2 = s.split("_", 1)
        return _normalize_dialog_id(p1), int(p2 or 0)
    return _normalize_dialog_id(s), 0

def _get_dialog_title(dialog_id: int) -> str:
    try:
        acc = int(UserConfig.selectedAccount)
        mc = MessagesController.getInstance(acc)
        if dialog_id > 0:
            user = mc.getUser(dialog_id)
            if user is not None:
                first = str(getattr(user, "first_name", "") or "").strip()
                last = str(getattr(user, "last_name", "") or "").strip()
                full = f"{first} {last}".strip()
                if full:
                    return full
                uname = str(getattr(user, "username", "") or "").strip()
                if uname:
                    return f"@{uname}"
        else:
            chat = mc.getChat(-dialog_id)
            if chat is not None:
                title = str(getattr(chat, "title", "") or "").strip()
                if title:
                    return title
    except Exception:
        pass
    return f"Чат {dialog_id}"

def _is_forum_chat(dialog_id: int) -> bool:
    if dialog_id >= 0:
        return False
    try:
        acc = int(UserConfig.selectedAccount)
        chat = MessagesController.getInstance(acc).getChat(-dialog_id)
        if chat is not None:
            return bool(getattr(chat, "forum", False))
    except Exception:
        pass
    return False

def _get_fragment_topic_id(frag: Any) -> int:
    if frag is None:
        return 0
    try:
        if hasattr(frag, "getTopicId"):
            tid = int(frag.getTopicId() or 0)
            if tid > 0:
                return tid
    except Exception:
        pass
    try:
        tid = int(get_private_field(frag, "topicId") or 0)
        if tid > 0:
            return tid
    except Exception:
        pass
    try:
        thread_msg = get_private_field(frag, "threadMessageObject")
        if thread_msg is not None and hasattr(thread_msg, "getId"):
            tid = int(thread_msg.getId() or 0)
            if tid > 0:
                return tid
    except Exception:
        pass
    return 0

def _get_message_topic_id(tl_msg: Any, mo: Any = None) -> int:
    try:
        if mo is not None and hasattr(mo, "getTopicId"):
            tid = int(mo.getTopicId() or 0)
            if tid > 0:
                return tid
    except Exception:
        pass
    try:
        reply_to = getattr(tl_msg, "reply_to", None)
        if reply_to is None:
            return 1
        top_id = int(getattr(reply_to, "reply_to_top_id", 0) or 0)
        if top_id > 0:
            return top_id
        if bool(getattr(reply_to, "forum_topic", False)):
            msg_id = int(getattr(reply_to, "reply_to_msg_id", 0) or 0)
            if msg_id > 0:
                return msg_id
    except Exception:
        pass
    return 1

def _resolve_action_icon(icon_name: str) -> int:
    if not icon_name:
        return 0
    if icon_name == "flash_on_solar":
        return _get_drawable_res(
            "flash_on_solar",
            _get_drawable_res("flash_on", _get_drawable_res("msg_media_shuffle", 0)),
        )
    return _get_drawable_res(icon_name, _get_drawable_res("msg_retry", 0))


def _get_drawable_res(name: str, fallback: int = 0) -> int:
    if not name:
        return fallback
    cached = _DRAWABLE_CACHE.get(name)
    if cached is not None:
        return cached if cached != 0 else fallback

    res_id = 0
    try:
        val = getattr(R_tg.drawable, name, None)
        if val is not None:
            res_id = int(val)
    except Exception:
        pass
    if res_id == 0:
        try:
            ctx = ApplicationLoader.applicationContext
            res_id = int(ctx.getResources().getIdentifier(name, "drawable", ctx.getPackageName()) or 0)
        except Exception:
            pass
    _DRAWABLE_CACHE[name] = res_id
    return res_id if res_id != 0 else fallback

def _get_action_bar(fragment: Any):
    if fragment is None:
        return None
    try:
        ab = fragment.getActionBar()
        if ab is not None:
            return ab
    except Exception:
        pass
    try:
        return get_private_field(fragment, "actionBar")
    except Exception:
        return None

def _read_clipboard_text() -> str:
    ctx = ApplicationLoader.applicationContext
    try:
        cm = ctx.getSystemService(Context.CLIPBOARD_SERVICE)
        if cm and cm.hasPrimaryClip():
            clip = cm.getPrimaryClip()
            if clip and clip.getItemCount() > 0:
                parts = []
                for i in range(clip.getItemCount()):
                    item = clip.getItemAt(i)
                    if item:
                        cs = item.coerceToText(ctx)
                        if cs:
                            parts.append(str(cs.toString()))
                res = "\n".join(parts).strip()
                if res:
                    return res
    except Exception:
        pass
    try:
        from android_utils import get_clipboard
        t = get_clipboard()
        if t:
            return str(t).strip()
    except Exception:
        pass
    return ""

def _write_clipboard_text(text: str) -> bool:
    try:
        AndroidUtilities.addToClipboard(text)
        return True
    except Exception:
        pass
    try:
        from android_utils import copy_to_clipboard
        copy_to_clipboard(text)
        return True
    except Exception:
        pass
    try:
        ctx = ApplicationLoader.applicationContext
        cm = ctx.getSystemService(Context.CLIPBOARD_SERVICE)
        cm.setPrimaryClip(ClipData.newPlainText("proxies", text))
        return True
    except Exception:
        pass
    return False

def _jget(obj: Any, methods: Tuple[str, ...], attrs: Tuple[str, ...] = ()) -> str:
    if obj is None:
        return ""
    for m in methods:
        try:
            v = getattr(obj, m)()
            if v is not None and str(v) != "":
                return str(v)
        except Exception:
            pass
    for a in attrs:
        try:
            v = getattr(obj, a)
            if v is not None and str(v) != "":
                return str(v)
        except Exception:
            pass
    return ""

def _clean_server(raw_srv: str, keep_path: bool = False) -> str:
    s = urllib.parse.unquote(raw_srv or "").strip()
    s = re.sub(r"^(?:https?|socks5|mtproto)://", "", s, flags=re.IGNORECASE)
    s = s.split("?")[0].split("#")[0].split("&")[0]
    if keep_path and "/" in s:
        host, rest = s.split("/", 1)
        host = host.lower().rstrip(".")
        if host.startswith("[") and host.endswith("]"):
            host = host[1:-1]
        clean_path = "/" + rest.rstrip("/") if rest.rstrip("/") else ""
        return host + clean_path
    host = s.split("/")[0].lower().rstrip(".")
    if host.startswith("[") and host.endswith("]"):
        host = host[1:-1]
    return host

def _extract_connect_host(server_with_optional_path: str) -> str:
    return (server_with_optional_path or "").split("/")[0].strip()

def _normalize_secret(raw_sec: str) -> str:
    s = urllib.parse.unquote(raw_sec or "").strip()
    s_clean = s.rstrip("=")
    if re.fullmatch(r"[0-9a-fA-F]+", s_clean):
        return s_clean.lower()
    return s_clean.replace("+", "-").replace("/", "_")

def _secret_to_bytes(secret: str) -> bytes:
    s = (secret or "").strip()
    if not s:
        return b""
    try:
        if re.fullmatch(r"[0-9a-fA-F]+", s) and len(s) % 2 == 0:
            return bytes.fromhex(s)
    except Exception:
        pass
    try:
        t = s.replace("-", "+").replace("_", "/")
        t += "=" * (-len(t) % 4)
        return base64.b64decode(t)
    except Exception:
        pass
    return b""

def _is_faketls_secret(secret: str) -> bool:
    b = _secret_to_bytes(secret)
    return len(b) >= 17 and b[0] == 0xEE

def _classify_dpi_badge(kind: str, secret: str) -> str:
    if kind == "web":
        return "🌐"
    if kind == "socks5" or not secret:
        return "🧦"
    b = _secret_to_bytes(secret)
    if len(b) == 16:
        return "⚠️"
    if len(b) >= 17 and b[0] == 0xEE:
        dom = ""
        try:
            dom = b[17:].decode("utf-8", "replace").strip().lower()
        except Exception:
            pass
        if dom and any(dom == d or dom.endswith("." + d) for d in _GOOD_FRONTS):
            return "🛡️"
        return "🔒"
    if len(b) == 17 and b[0] == 0xDD:
        return "➿"
    return "⚠️"

def _ping_color(ms: int) -> int:
    if ms <= 0:
        return COLOR_SLOW
    if ms < PING_FAST_MS:
        return COLOR_FAST
    if ms < PING_MID_MS:
        return COLOR_MID
    return COLOR_SLOW

