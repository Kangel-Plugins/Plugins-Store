                )
                et_bg = GradientDrawable()
                et_bg.setCornerRadius(AndroidUtilities.dp(14))
                try:
                    et_bg.setColor(Theme.getColor(Theme.key_windowBackgroundGray))
                except Exception:
                    et_bg.setColor(0x18808080)
                edit_btn_toggle_row.setBackground(et_bg)

                et_inner = LinearLayout(act)
                et_inner.setOrientation(LinearLayout.HORIZONTAL)
                et_inner.setGravity(Gravity.CENTER_VERTICAL)

                et_tv = TextView(act)
                et_tv.setText("Кнопка «Настроить это меню»")
                et_tv.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 14)
                et_tv.setTypeface(AndroidUtilities.getTypeface("fonts/rmedium.ttf"))
                et_tv.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
                et_inner.addView(et_tv, LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1.0))

                et_state_tv = TextView(act)
                et_state_tv.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13)
                et_state_tv.setTypeface(AndroidUtilities.getTypeface("fonts/rmedium.ttf"))
                et_inner.addView(et_state_tv, LayoutHelper.createLinear(-2, -2, Gravity.CENTER_VERTICAL))

                edit_btn_toggle_row.addView(et_inner, FrameLayout.LayoutParams(-1, -2))
                edit_btn_toggle_row.setClickable(True)

                def refresh_edit_btn_toggle():
                    on = bool(self.get_setting("show_edit_menu_btn", True))
                    et_state_tv.setText("Показана" if on else "Скрыта")
                    et_state_tv.setTextColor(
