URL_REGEX = re.compile(
    r"(?:tg://(?:webproxy|proxy|socks)\?[^\s<>\"']+|"
    r"(?:https?://)?(?:t\.me|telegram\.me|telegram\.dog|tx\.me)/(?:webproxy|proxy|socks)\?[^\s<>\"']+|"
    r"https?://[^\s<>\"']+|"
    r"socks5://[^\s<>\"']+|"
    r"mtproto://[^\s<>\"']+)",
    re.IGNORECASE,
)

RAW_PROXY_REGEX = re.compile(
    r"\b((?:25[0-5]|2[0-4]\d|1?\d?\d)(?:\.(?:25[0-5]|2[0-4]\d|1?\d?\d)){3}):(\d{2,5})(?::([^\s:;,\n]+)(?::([^\s:;,\n]+))?)?\b"
)

WEB_BLOCK_SERVER_RE = re.compile(
    r"(?:server|сервер|host|хост|domain|домен)\s*[:=]\s*([^\s<>\"']+)",
    re.IGNORECASE,
)
WEB_BLOCK_SECRET_RE = re.compile(
    r"(?:secret|секрет|ключ)\s*[:=]\s*([0-9a-fA-F\-_A-Za-z]{16,})",
    re.IGNORECASE,
)

