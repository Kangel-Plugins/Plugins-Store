def _get_proxy_ping_and_avail(info: Any) -> Tuple[bool, int]:
    if info is None:
        return False, 0
    av = False
    ping = 0
    try:
        av = bool(getattr(info, "available", False))
    except Exception:
        pass
    if not av:
        try:
            if hasattr(info, "isAvailable"):
                av = bool(info.isAvailable())
        except Exception:
            pass

    try:
        ping = int(getattr(info, "ping", 0) or 0)
    except Exception:
        ping = 0
    if ping <= 0:
        try:
            if hasattr(info, "getPing"):
                ping = int(info.getPing() or 0)
        except Exception:
            pass
    if ping <= 0:
        s = getattr(info, "settings", None)
        if s is not None:
            try:
                ping = int(getattr(s, "ping", 0) or 0)
            except Exception:
                pass
    return av, ping

def _is_fresh_working(info: Any, max_age_ms: int = MAX_PING_AGE_MS) -> bool:
    available, ping = _get_proxy_ping_and_avail(info)
    if not available or ping <= 0:
        return False
    try:
        checked_at = int(getattr(info, "availableCheckTime", 0) or 0)
        if checked_at <= 0:
            return False
        now_rt = _elapsed_ms()
        if 0 <= (now_rt - checked_at) <= max_age_ms:
            return True
        now_wall = int(time.time() * 1000)
        if 0 <= (now_wall - checked_at) <= max_age_ms:
            return True
        return False
    except Exception:
        return False

def _extract_proxy_details(info_or_settings: Any) -> Tuple[str, str, str, int, str, str, str]:
    if info_or_settings is None:
        return "", "", "", 0, "", "", ""

    obj_id = 0
    try:
        obj_id = int(System.identityHashCode(info_or_settings))
        cached = _DETAILS_CACHE.get(obj_id)
        if cached is not None:
            return cached
    except Exception:
        obj_id = 0

    s = getattr(info_or_settings, "settings", None) or info_or_settings
    info = info_or_settings if hasattr(info_or_settings, "settings") else None

    ptype = _jget(s, ("getType",), ("type",)).upper()
    is_web = "WEB" in ptype

    raw_addr = _jget(s, ("getAddress", "getHost", "getServer"), ("address",)) or _jget(
        info, ("getAddress",), ("address",)
    )
    addr = _clean_server(raw_addr, keep_path=is_web)

    port_str = _jget(s, ("getPort",), ("port",)) or _jget(info, ("getPort",), ("port",))
    try:
        port = int(port_str)
    except Exception:
        port = 443 if is_web else 0
    eff_port = port if (1 <= port <= 65535) else 443

    raw_secret = _jget(s, ("getSecret",), ("secret",)) or _jget(info, ("getSecret",), ("secret",))
    norm_sec = _normalize_secret(raw_secret)

    user = (
        _jget(s, ("getUsername", "getUser"), ("username", "user"))
        or _jget(info, ("getUsername",), ("username",))
    ).strip()
    pwd = (
        _jget(s, ("getPassword", "getPass"), ("password", "pass"))
        or _jget(info, ("getPassword",), ("password",))
    ).strip()

    if not addr:
        return "", "", "", 0, "", "", ""

    if is_web:
        res = (f"web:{addr}:{norm_sec.lower()}", "web", addr, eff_port, raw_secret.strip(), "", "")
    elif raw_secret or "MTPROTO" in ptype:
        res = (f"mtproto:{addr}:{eff_port}:{norm_sec.lower()}", "mtproto", addr, eff_port, raw_secret.strip(), "", "")
    else:
        res = (f"socks5:{addr}:{eff_port}:{user}:{pwd}", "socks5", addr, eff_port, "", user, pwd)

    if obj_id != 0:
        if len(_DETAILS_CACHE) > 1024:
            _DETAILS_CACHE.clear()
        _DETAILS_CACHE[obj_id] = res
    return res

def _get_active_proxy_key(PC: Any) -> str:
    for candidate in (
        PC.getCurrentProxy() if hasattr(PC, "getCurrentProxy") else None,
        getattr(PC, "currentProxy", None),
        getattr(SharedConfig, "currentProxy", None),
    ):
        if candidate is not None:
            k, _, _, _, _, _, _ = _extract_proxy_details(candidate)
            if k:
                return k
    try:
        prefs = ApplicationLoader.applicationContext.getSharedPreferences("mainconfig", 0)
        ip = str(prefs.getString("proxy_ip", "") or "").strip()
        port = int(prefs.getInt("proxy_port", 0) or 0)
        sec = str(prefs.getString("proxy_secret", "") or "").strip()
        user = str(prefs.getString("proxy_user", "") or "").strip()
        pwd = str(prefs.getString("proxy_pass", "") or "").strip()
        if ip and port > 0:
            addr = _clean_server(ip, keep_path=("/" in ip))
            if "/" in ip:
                return f"web:{addr}:{_normalize_secret(sec).lower()}"
            if sec:
                return f"mtproto:{addr}:{port}:{_normalize_secret(sec).lower()}"
            return f"socks5:{addr}:{port}:{user}:{pwd}"
    except Exception:
        pass
    return ""

def _is_proxy_enabled_in_client() -> bool:
    try:
        if hasattr(SharedConfig, "proxyEnabled"):
            return bool(SharedConfig.proxyEnabled)
    except Exception:
        pass
    try:
        prefs = ApplicationLoader.applicationContext.getSharedPreferences("mainconfig", 0)
        return bool(prefs.getBoolean("proxy_enabled", False))
    except Exception:
        return False


def _get_native_auto_switch_sec() -> int:
    try:
        prefs = ApplicationLoader.applicationContext.getSharedPreferences("mainconfig", 0)
        enabled = False
        for k in ("proxy_auto_switch", "proxyAutoSwitch", "auto_switch_proxy", "autoSwitchProxy"):
            if prefs.contains(k):
                try:
                    enabled = bool(prefs.getBoolean(k, False))
                    break
                except Exception:
                    pass
        if not enabled:
            for attr in ("proxyAutoSwitch", "autoSwitchProxy", "proxyAutoSwitchEnabled"):
                if hasattr(SharedConfig, attr):
                    enabled = bool(getattr(SharedConfig, attr))
                    break
        if not enabled:
            return 0
        for tk in ("proxy_auto_switch_timeout", "proxy_switch_timeout", "proxyAutoSwitchTimeout", "auto_switch_timeout"):
            if prefs.contains(tk):
                try:
                    val = int(prefs.getInt(tk, 0) or 0)
                    if val > 0:
                        return val
                except Exception:
                    pass
        for t_attr in ("proxyAutoSwitchTimeout", "proxySwitchTimeout", "autoSwitchProxyTimeout"):
            if hasattr(SharedConfig, t_attr):
                val = int(getattr(SharedConfig, t_attr) or 0)
                if val > 0:
                    return val
        return 10
    except Exception:
        return 0

def _sync_active_proxy_fields(info: Any):
    try:
        SharedConfig.currentProxy = info
        SharedConfig.proxyEnabled = True
    except Exception:
        pass
    try:
        frag = get_last_fragment()
        if frag is not None and "ProxyListActivity" in str(frag.getClass().getName()):
            f_cls = _resolve_jclass(frag)
            for fname in ("currentProxyInfo", "selectedProxy"):
                for f in f_cls.getDeclaredFields():
                    if str(f.getName()) == fname:
                        f.setAccessible(True)
                        f.set(frag, info)
                        break
    except Exception:
        pass

def _activate_proxy_info(PC: Any, info: Any) -> bool:
    if info is None:
        return False
    for method_name in ("setCurrentProxy", "connectProxy", "selectProxy", "enableProxy"):
        if hasattr(PC, method_name):
            try:
                getattr(PC, method_name)(info)
                _sync_active_proxy_fields(info)
                try:
                    NotificationCenter.getGlobalInstance().postNotificationName(
                        NotificationCenter.proxySettingsChanged
                    )
                    pl = PC.getProxyList()
                    if pl is not None:
                        _sync_fragment_proxy_list(PC, [pl.get(i) for i in range(int(pl.size()))])
                except Exception:
                    pass
                return True
            except Exception:
                pass
    try:
        _, _, srv, port, sec, user, pwd = _extract_proxy_details(info)
        host_conn = _extract_connect_host(srv)
        if not host_conn:
            return False
        _sync_active_proxy_fields(info)
        try:
            prefs = ApplicationLoader.applicationContext.getSharedPreferences("mainconfig", 0)
            ed = prefs.edit()
            ed.putBoolean("proxy_enabled", True)
            ed.putString("proxy_ip", str(srv))
            ed.putInt("proxy_port", int(port))
            ed.putString("proxy_user", str(user or ""))
            ed.putString("proxy_pass", str(pwd or ""))
            ed.putString("proxy_secret", str(sec or ""))
            ed.commit()
        except Exception:
            pass
        applied_native = False
        try:
            ConnectionsManager.setProxySettings(
                True,
                str(host_conn),
                int(port),
                str(user or ""),
                str(pwd or ""),
                str(sec or ""),
            )
            applied_native = True
        except Exception:
            pass
        if not applied_native:
            ps = getattr(info, "settings", None)
            if ps is not None:
                try:
                    ConnectionsManager.setProxySettings(True, ps)
                    applied_native = True
                except Exception:
                    pass
        try:
            SharedConfig.saveConfig()
        except Exception:
            pass
        NotificationCenter.getGlobalInstance().postNotificationName(
            NotificationCenter.proxySettingsChanged
        )
        try:
            pl = PC.getProxyList()
            if pl is not None:
                _sync_fragment_proxy_list(PC, [pl.get(i) for i in range(int(pl.size()))])
        except Exception:
            pass
        return applied_native
    except Exception as e:
        _plog(f"activate fallback err: {e}")
        return False

def _delete_proxy_from_controller(PC: Any, info: Any) -> bool:
    if info is None:
        return False
    try:
        pl0 = PC.getProxyList()
        before_sz = int(pl0.size()) if pl0 is not None else -1
    except Exception:
        before_sz = -1

    target_key, _, _, _, _, _, _ = _extract_proxy_details(info)

    for method_name in ("deleteProxy", "removeProxy"):
        if hasattr(PC, method_name):
            try:
                getattr(PC, method_name)(info)
            except Exception:
                pass

    try:
        SharedConfig.deleteProxy(info)
    except Exception:
        pass

    try:
        pl_after = PC.getProxyList()
        if pl_after is not None:
            after_sz = int(pl_after.size())
            if before_sz >= 0 and after_sz < before_sz:
                return True

            kept = []
            removed_any = False
            for i in range(after_sz):
                item = pl_after.get(i)
                if item is None:
                    continue
                if item is info:
                    removed_any = True
                    continue
                if target_key:
                    ik, _, _, _, _, _, _ = _extract_proxy_details(item)
                    if ik == target_key:
                        removed_any = True
                        continue
                kept.append(item)

            if removed_any:
                if _replace_proxy_list_in_controller(PC, kept):
                    try:
                        sc_list = getattr(SharedConfig, "proxyList", None)
                        if sc_list is not None:
                            sc_list.clear()
                            for it in kept:
                                sc_list.add(it)
                            SharedConfig.saveProxyList()
                    except Exception:
                        pass
                    return True
    except Exception as e:
        _plog(f"delete proxy fallback err: {e}")

    return False

def _persist_proxy_controller(PC: Any):
    try:
        if hasattr(PC, "save"):
            PC.save()
        if hasattr(PC, "syncProxyList"):
            PC.syncProxyList()
    except Exception:
        pass

def _sync_fragment_proxy_list(PC: Any, sorted_items: List[Any]):
    try:
        frag = get_last_fragment()
        if frag is None or "ProxyListActivity" not in frag.getClass().getName():
            return

        frag_pl = get_private_field(frag, "proxyList")
        pc_pl = PC.getProxyList()
        if frag_pl is not None and frag_pl is not pc_pl:
            try:
                frag_pl.clear()
                for it in sorted_items:
                    frag_pl.add(it)
            except Exception:
                f_cls = _resolve_jclass(frag)
                for f in f_cls.getDeclaredFields():
                    if str(f.getName()) == "proxyList":
                        f.setAccessible(True)
                        new_al = ArrayList()
                        for it in sorted_items:
                            new_al.add(it)
                        f.set(frag, new_al)
                        break

        f_cls = _resolve_jclass(frag)
        for m in f_cls.getDeclaredMethods():
            if m.getName() == "updateRows":
                m.setAccessible(True)
                pts = list(m.getParameterTypes())
                if len(pts) == 0:
                    m.invoke(frag, [])
                elif len(pts) == 1:
                    m.invoke(frag, [True])
                break

        adapter = get_private_field(frag, "listAdapter")
        if adapter is not None:
            adapter.notifyDataSetChanged()
    except Exception as e:
        _plog(f"sync fragment list err: {e}")

def _replace_proxy_list_in_controller(PC: Any, sorted_items: List[Any]) -> bool:
    pl = PC.getProxyList()
    if pl is None:
        return False

    try:
        pl.clear()
        for it in sorted_items:
            pl.add(it)
        _persist_proxy_controller(PC)
        _sync_fragment_proxy_list(PC, sorted_items)
        return True
    except Exception:
        pass

    try:
        raw_cls = getattr(PC, "_cls", None) or PC
        raw_inst = getattr(PC, "_inst", None)
        pc_cls = _resolve_jclass(raw_cls)
        if pc_cls is not None:
            for f in pc_cls.getDeclaredFields():
                if str(f.getName()) == "proxyList":
                    f.setAccessible(True)
                    is_static = bool(int(f.getModifiers()) & 8)
                    new_al = ArrayList()
                    for it in sorted_items:
                        new_al.add(it)
                    f.set(None if is_static else raw_inst, new_al)
                    _persist_proxy_controller(PC)
                    _sync_fragment_proxy_list(PC, sorted_items)
                    return True
    except Exception as e:
        _plog(f"replace list err: {e}")

    return False

def _to_jbytes(data: bytes):
    return jarray(jclass("java.lang.Byte").TYPE)([b - 256 if b >= 128 else b for b in data])


class _AESCTR:
    __slots__ = ("_cipher",)

    def __init__(self, key: bytes, iv: bytes):
        Cipher = jclass("javax.crypto.Cipher")
        SecretKeySpec = jclass("javax.crypto.spec.SecretKeySpec")
        IvParameterSpec = jclass("javax.crypto.spec.IvParameterSpec")
        cipher = Cipher.getInstance("AES/CTR/NoPadding")
        cipher.init(
            int(Cipher.ENCRYPT_MODE),
            SecretKeySpec(_to_jbytes(key), "AES"),
            IvParameterSpec(_to_jbytes(iv)),
        )
        self._cipher = cipher

    def crypt(self, data: bytes) -> bytes:
        if not data:
            return b""
        out_arr = self._cipher.update(_to_jbytes(data))
        return bytes(int(b) & 0xFF for b in out_arr) if out_arr is not None else b""


def _ft_build_client_hello(session_id: bytes, domain: str, secret_key: bytes) -> bytes:
    buf, stack, ro = bytearray(), [], [0]
    def S(b): buf.extend(b)
    def Z(n): ro[0] = len(buf); buf.extend(b"\x00" * n)
    def R(): buf.extend(session_id)
    def D(): buf.extend(domain.encode("utf-8", "ignore"))
    def K(): buf.extend(b"\x00" * 32)
    def Open(): stack.append(len(buf)); buf.extend(b"\x00\x00")
    def Close():
        s = stack.pop(); struct.pack_into(">H", buf, s, len(buf) - (s + 2))

    S(b"\x16\x03\x01\x02\x00\x01\x00\x01\xfc\x03\x03"); Z(32); S(b"\x20"); R(); S(b"\x00\x20")
    S(b"\x13\x01\x13\x02\x13\x03\xc0\x2b\xc0\x2f\xc0\x2c\xc0\x30\xcc\xa9"
      b"\xcc\xa8\xc0\x13\xc0\x14\x00\x9c\x00\x9d\x00\x2f\x00\x35\x01\x00\x01\x93")
    S(b"\x00\x00\x00\x00"); Open(); Open(); S(b"\x00"); Open(); D(); Close(); Close(); Close()
    S(b"\x00\x17\x00\x00\xff\x01\x00\x01\x00\x00\x0a\x00\x0a\x00\x08")
    S(b"\x00\x1d\x00\x17\x00\x18\x00\x0b\x00\x02\x01\x00\x00\x23\x00\x00"
      b"\x00\x10\x00\x0e\x00\x0c\x02\x68\x32\x08\x68\x74\x74\x70\x2f\x31"
      b"\x2e\x31\x00\x05\x00\x05\x01\x00\x00\x00\x00\x00\x0d\x00\x12\x00"
      b"\x10\x04\x03\x08\x04\x04\x01\x05\x03\x08\x05\x05\x01\x08\x06\x06"
      b"\x01\x00\x12\x00\x00\x00\x33\x00\x2b\x00\x29")
    S(b"\x00\x01\x00\x00\x1d\x00\x20"); K(); S(b"\x00\x2d\x00\x02\x01\x01\x00\x2b\x00\x0b\x0a")
    S(b"\x03\x04\x03\x03\x03\x02\x03\x01\x00\x1b\x00\x03\x02\x00\x02")
    S(b"\x00\x01\x00\x00\x15")
    pad = 517 - len(buf)
    if pad > 0:
        buf.extend(b"\x00" * pad)
    digest = hmac.new(secret_key, bytes(buf), hashlib.sha256).digest()
    buf[ro[0]:ro[0] + 32] = digest
    off = ro[0] + 28
    v = struct.unpack_from("<I", buf, off)[0] ^ (int(time.time()) & 0xffffffff)
    struct.pack_into("<I", buf, off, v & 0xffffffff)
    return bytes(buf)

def _open_tcp_nodelay(host: str, port: int, timeout: float) -> socket.socket:
    sock = socket.create_connection((host, port), timeout=timeout)
    sock.settimeout(timeout)
    try:
        sock.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
    except Exception:
        pass
    return sock


def _probe_faketls(host: str, port: int, secret_bytes: bytes, timeout: float) -> Optional[int]:
    key = secret_bytes[1:17]
    domain = secret_bytes[17:].decode("ascii", "ignore") or "www.google.com"
    sock = None
    try:
        t0 = time.monotonic()
        sock = _open_tcp_nodelay(host, port, timeout)
        sock.sendall(_ft_build_client_hello(os.urandom(32), domain, key))
        resp = sock.recv(64)
        if len(resp) >= 6 and resp[0] == 0x16 and resp[5] == 0x02:
            return max(1, int((time.monotonic() - t0) * 1000))
        return None
    except Exception:
        return None
    finally:
        if sock:
            try:
                sock.close()
            except Exception:
                pass

def _probe_mtproto(host: str, port: int, secret_bytes: bytes, timeout: float) -> Optional[int]:
    if len(secret_bytes) >= 17 and secret_bytes[0] == 0xDD:
        key, secured = secret_bytes[1:17], True
    else:
        key, secured = secret_bytes[:16], False
    if len(key) != 16:
        return None

    forbidden = (0x44414548, 0x504f5354, 0x47455420, 0x4954504f, 0xeeeeeeee, 0xdddddddd, 0x16030102)
    while True:
        rnd = bytearray(os.urandom(64))
        if rnd[0] != 0xef and struct.unpack(">I", rnd[0:4])[0] not in forbidden and rnd[4:8] != b"\x00\x00\x00\x00":
            break
    enc_key = hashlib.sha256(bytes(rnd[8:40]) + key).digest()
    enc_iv = bytes(rnd[40:56])
    rev = bytes(rnd[55:7:-1])
    dec_key = hashlib.sha256(rev[0:32] + key).digest()
    dec_iv = rev[32:48]
    enc = _AESCTR(enc_key, enc_iv)
    dec = _AESCTR(dec_key, dec_iv)
    tag = 0xdddddddd if secured else 0xeeeeeeee
    rnd[56:60] = struct.pack("<I", tag)
    rnd[56:64] = enc.crypt(bytes(rnd))[56:64]

    nonce = os.urandom(16)
    body = struct.pack("<I", 0xbe7e8ef1) + nonce
    msg_id = (int(time.time()) << 32) & ~3
    msg = struct.pack("<qqI", 0, msg_id, len(body)) + body
    if secured:
        msg += os.urandom(4 * (os.urandom(1)[0] % 4))
    frame = struct.pack("<I", len(msg)) + msg

    sock = None
    try:
        t0 = time.monotonic()
        sock = _open_tcp_nodelay(host, port, timeout)
        sock.sendall(bytes(rnd) + enc.crypt(frame))
        hdr = b""
        while len(hdr) < 4:
            c = sock.recv(4 - len(hdr))
            if not c:
                return None
            hdr += c
        resp_len = struct.unpack("<I", dec.crypt(hdr))[0]
        if resp_len < 40 or resp_len > 65536:
            return None
        payload = b""
        while len(payload) < 40:
            c = sock.recv(40 - len(payload))
            if not c:
                return None
            payload += c
        dec_body = dec.crypt(payload)
        if struct.unpack("<I", dec_body[20:24])[0] == 0x05162463 and dec_body[24:40] == nonce:
            return max(1, int((time.monotonic() - t0) * 1000))
        return None
    except Exception:
        return None
    finally:
        if sock:
            try:
                sock.close()
            except Exception:
                pass

def _probe_socks5(host: str, port: int, user: str, pwd: str, timeout: float) -> Optional[int]:
    sock = None
    try:
        t0 = time.monotonic()
        sock = _open_tcp_nodelay(host, port, timeout)
        sock.sendall(b"\x05\x02\x00\x02")
        resp = sock.recv(2)
        if len(resp) < 2 or resp[0] != 0x05:
            return None
        rtt = max(1, int((time.monotonic() - t0) * 1000))
        if resp[1] == 0x00:
            return rtt
        if resp[1] == 0x02:
            u = (user or "").encode()[:255]
            p = (pwd or "").encode()[:255]
            sock.sendall(b"\x01" + bytes([len(u)]) + u + bytes([len(p)]) + p)
            ar = sock.recv(2)
            return rtt if (len(ar) >= 2 and ar[0] == 0x01 and ar[1] == 0x00) else None
        return None
    except Exception:
        return None
    finally:
        if sock:
            try:
                sock.close()
            except Exception:
                pass

def _probe_web_tls(server_with_path: str, port: int, timeout: float) -> Optional[int]:
    raw_clean = (server_with_path or "").strip()
    if "/" in raw_clean:
        host, rest = raw_clean.split("/", 1)
        path = "/" + rest.lstrip("/")
    else:
        host, path = raw_clean, "/"
    host = host.strip()
    if not host:
        return None
    raw_sock = None
    tls_sock = None
    try:
        t0 = time.monotonic()
        raw_sock = _open_tcp_nodelay(host, port, timeout)
        tls_sock = _UNVERIFIED_SSL_CTX.wrap_socket(raw_sock, server_hostname=host)
        req_bytes = (
            f"GET {path} HTTP/1.1\r\n"
            f"Host: {host}\r\n"
            "User-Agent: Mozilla/5.0\r\n"
            "Connection: close\r\n\r\n"
        ).encode("ascii", "ignore")
        tls_sock.sendall(req_bytes)
        resp = tls_sock.recv(256)
        if not resp or not resp.startswith(b"HTTP/1."):
            return None
        parts = resp.split(b" ", 2)
        if len(parts) < 2 or not parts[1].isdigit():
            return None
        code = int(parts[1])
        if code >= 500 or code in (403, 451):
            return None
        return max(1, int((time.monotonic() - t0) * 1000))
    except Exception:
        return None
    finally:
        for s in (tls_sock, raw_sock):
            if s:
                try:
                    s.close()
                except Exception:
                    pass

def _check_proxy_alive(
    kind: str,
    server: str,
    port: int,
    secret: str,
    user: str,
    pwd: str,
    use_handshake: bool = True,
    timeout: float = 4.0,
) -> Optional[int]:
    host = _extract_connect_host(server)
    if _is_local_host(host):
        return 1
    if not host or not (1 <= port <= 65535):
        return None

    if not use_handshake:
        t0 = time.monotonic()
        try:
            with socket.create_connection((host, port), timeout=timeout):
                return max(1, int((time.monotonic() - t0) * 1000))
        except Exception:
            return None

    if kind == "web":
        return _probe_web_tls(server, port, timeout)
    if kind == "socks5" or not secret:
        return _probe_socks5(host, port, user, pwd, timeout)

    sb = _secret_to_bytes(secret)
    if len(sb) >= 17 and sb[0] == 0xEE:
        return _probe_faketls(host, port, sb, timeout)
    return _probe_mtproto(host, port, sb, timeout)

class ParsedProxy:
    __slots__ = ("kind", "server", "port", "username", "password", "secret", "norm_secret")

    def __init__(
        self,
        kind: str,
        server: str,
        port: int,
        username: str = "",
        password: str = "",
        secret: str = "",
    ):
        self.kind = kind
        self.server = _clean_server(server, keep_path=(kind == "web"))
        self.port = int(port) if (1 <= int(port) <= 65535) else 443
        self.username = username.strip()
        self.password = password.strip()
        self.secret = secret.strip()
        self.norm_secret = _normalize_secret(secret)

    @property
    def host_only(self) -> str:
        return _extract_connect_host(self.server)

    @property
    def key(self) -> str:
        addr = self.server.lower()
        sec = self.norm_secret.lower()
        if self.kind == "web":
            return f"web:{addr}:{sec}"
        if self.kind == "mtproto":
            return f"mtproto:{addr}:{self.port}:{sec}"
        return f"socks5:{addr}:{self.port}:{self.username}:{self.password}"

    def to_uri(self) -> str:
        if self.kind == "web":
            return f"tg://webproxy?server={urllib.parse.quote(self.server, safe='.:-[]/')}&secret={urllib.parse.quote(self.secret, safe='-_.')}"
        if self.kind == "mtproto":
            return f"tg://proxy?server={self.server}&port={self.port}&secret={urllib.parse.quote(self.secret, safe='')}"
        uri = f"tg://socks?server={self.server}&port={self.port}"
        if self.username:
            uri += f"&user={urllib.parse.quote(self.username, safe='')}"
        if self.password:
            uri += f"&pass={urllib.parse.quote(self.password, safe='')}"
        return uri

class NoRedirectHandler(urllib.request.HTTPRedirectHandler):
    def http_error_301(self, req, fp, code, msg, headers):
        return fp

    def http_error_302(self, req, fp, code, msg, headers):
        return fp

    def http_error_303(self, req, fp, code, msg, headers):
        return fp

    def http_error_307(self, req, fp, code, msg, headers):
        return fp

    def http_error_308(self, req, fp, code, msg, headers):
        return fp

def _parse_proxy_url(url: str) -> Optional[ParsedProxy]:
    try:
        cleaned = url.strip().replace("&amp;", "&").rstrip(").,;!'\"»]")
        low = cleaned.lower()
        if low.startswith("mtproto://"):
            rest = cleaned[len("mtproto://"):]
            parts = rest.split(":")
            if len(parts) >= 3:
                host = parts[0].strip()
                try:
                    port = int(parts[1])
                except Exception:
                    return None
                secret = ":".join(parts[2:]).strip()
                if host and "." in host and 1 <= port <= 65535 and secret:
                    return ParsedProxy(kind="mtproto", server=host, port=port, secret=secret)
            return None
        if low.startswith("socks5://"):
            parsed = urllib.parse.urlparse(cleaned)
            if parsed.hostname and parsed.port and (1 <= int(parsed.port) <= 65535):
                return ParsedProxy(
                    kind="socks5",
                    server=parsed.hostname,
                    port=int(parsed.port),
                    username=urllib.parse.unquote(parsed.username or ""),
                    password=urllib.parse.unquote(parsed.password or ""),
                )
            return None

        if "?" not in cleaned:
            return None

        base_part, query_part = cleaned.split("?", 1)
        query_part = query_part.split("#")[0].rstrip(").,;!'\"»]")
        qs = urllib.parse.parse_qs(query_part, keep_blank_values=True)
        base_low = base_part.lower()

        is_web = "webproxy" in base_low

        raw_server = (qs.get("server") or qs.get("host") or qs.get("ip") or [""])[0].strip()
        secret = urllib.parse.unquote((qs.get("secret") or [""])[0].strip())
        port_str = (qs.get("port") or [""])[0].strip()

        if is_web:
            server = _clean_server(raw_server, keep_path=True)
            if not server or "." not in _extract_connect_host(server) or not secret:
                return None
            port = int(port_str) if (port_str.isdigit() and 1 <= int(port_str) <= 65535) else 443
            return ParsedProxy(kind="web", server=server, port=port, secret=secret)

        server = _clean_server(raw_server, keep_path=False)
        if not server or "." not in server or not port_str.isdigit():
            return None

        port = int(port_str)
        if not (1 <= port <= 65535):
            return None

        user = urllib.parse.unquote((qs.get("user") or qs.get("username") or [""])[0].strip())
        pwd = urllib.parse.unquote((qs.get("pass") or qs.get("password") or [""])[0].strip())

        if secret or ("proxy" in base_low and "socks" not in base_low):
            if not secret:
                return None
            return ParsedProxy(kind="mtproto", server=server, port=port, secret=secret)

        return ParsedProxy(kind="socks5", server=server, port=port, username=user, password=pwd)
    except Exception:
        return None

def _resolve_redirect_url(url: str) -> List[ParsedProxy]:
    results: List[ParsedProxy] = []
    if _is_collect_proxy_url(url):
        return results
    direct = _parse_proxy_url(url)
    if direct is not None:
        results.append(direct)
        return results

    if not url.lower().startswith(("http://", "https://")):
        return results

    try:
        opener = urllib.request.build_opener(NoRedirectHandler())
        req = urllib.request.Request(
            url,
            headers={"User-Agent": "Mozilla/5.0 (Android 14; Mobile) ProxyCollector/1.0"},
        )
        with opener.open(req, timeout=2.5) as resp:
            loc = resp.headers.get("Location") or resp.headers.get("location")
            if loc:
                p = _parse_proxy_url(loc)
                if p is not None:
                    results.append(p)
                    return results

            body = resp.read(24576).decode("utf-8", errors="ignore")
            for match in URL_REGEX.findall(body):
                p = _parse_proxy_url(match)
                if p is not None:
                    results.append(p)
    except Exception:
        pass
    return results

def extract_proxies_from_text(
    raw_text: str,
    allow_mtproto: bool = True,
    allow_socks5: bool = True,
    allow_web: bool = True,
    only_faketls: bool = False,
) -> List[ParsedProxy]:
    if not raw_text:
        return []

    text = raw_text.strip()
    stripped = re.sub(r"\s+", "", text)
    if stripped and "://" not in text and len(stripped) > 20:
        try:
            pad = stripped.replace("-", "+").replace("_", "/")
            pad += "=" * (-len(pad) % 4)
            decoded = base64.b64decode(pad).decode("utf-8", "ignore")
            if any(k in decoded.lower() for k in ("proxy?", "socks?", "webproxy?", ":")):
                text = decoded
        except Exception:
            pass

    found: List[ParsedProxy] = []
    seen_keys: Set[str] = set()

    def _add(p: Optional[ParsedProxy]):
        if p is None or not p.server or "." not in p.host_only or not (1 <= p.port <= 65535):
            return
        if only_faketls and (p.kind != "mtproto" or not _is_faketls_secret(p.secret)):
            return
        if p.kind == "mtproto":
            if not allow_mtproto:
                return
        elif p.kind == "socks5":
            if not allow_socks5:
                return
        elif p.kind == "web":
            if not allow_web:
                return
        if p.key not in seen_keys:
            seen_keys.add(p.key)
            found.append(p)

    def _ingest_json_list(arr: Any):
        if not isinstance(arr, list):
            return
        for entry in arr:
            if not isinstance(entry, dict):
                continue
            srv = str(entry.get("server") or entry.get("host") or "").strip()
            sec = str(entry.get("secret") or "").strip()
            via = entry.get("via")
            if via and srv and sec:
                _add(ParsedProxy(kind="web", server=srv, port=443, secret=sec))
            elif srv and entry.get("port"):
                prt = int(entry.get("port"))
                if sec:
                    _add(ParsedProxy(kind="mtproto", server=srv, port=prt, secret=sec))
                else:
                    _add(
                        ParsedProxy(
                            kind="socks5",
                            server=srv,
                            port=prt,
                            username=str(entry.get("user") or entry.get("username") or ""),
                            password=str(entry.get("pass") or entry.get("password") or ""),
                        )
                    )

    if text.startswith("[") and text.endswith("]"):
        try:
            _ingest_json_list(json.loads(text))
        except Exception:
            pass
    elif "[{" in text:
        for jm in re.finditer(r"\[\s*\{.*?\}\s*\]", text, flags=re.DOTALL):
            try:
                _ingest_json_list(json.loads(jm.group(0)))
            except Exception:
                pass

    parsed_url_spans: List[Tuple[int, int]] = []
    for m in URL_REGEX.finditer(text):
        p = _parse_proxy_url(m.group(0))
        if p is not None:
            _add(p)
            parsed_url_spans.append(m.span())

    def _inside_parsed_url(pos: int) -> bool:
        return any(s <= pos < e for s, e in parsed_url_spans)

    low = text.lower()
    is_web_post = any(w in low for w in ("webproxy", "web proxy", "web-proxy", "веб-прокси", "веб прокси"))

    if allow_web and is_web_post:
        srv_m = WEB_BLOCK_SERVER_RE.search(text)
        sec_m = WEB_BLOCK_SECRET_RE.search(text)
        if srv_m and sec_m and not _inside_parsed_url(srv_m.start()) and not _inside_parsed_url(sec_m.start()):
            srv_val = _clean_server(srv_m.group(1), keep_path=True)
            sec_val = sec_m.group(1).strip()
            if "." in _extract_connect_host(srv_val) and len(sec_val) >= 16:
                _add(ParsedProxy(kind="web", server=srv_val, port=443, secret=sec_val))

    url_host_ports = {(p.host_only, p.port) for p in found}
    for m in RAW_PROXY_REGEX.finditer(text):
        if _inside_parsed_url(m.start()):
            continue
        ip, port_s, p3, p4 = m.group(1), m.group(2), m.group(3) or "", m.group(4) or ""
        if not port_s.isdigit():
            continue
        port = int(port_s)
        if (ip, port) in url_host_ports:
            continue
        if p3 and not p4 and len(p3) >= 16:
            kind = "web" if (is_web_post and port == 443) else "mtproto"
            _add(ParsedProxy(kind=kind, server=ip, port=port, secret=p3))
        else:
            _add(ParsedProxy(kind="socks5", server=ip, port=port, username=p3, password=p4))

    return found

def _read_attachment_text(path: str) -> str:
    if os.path.getsize(path) > MAX_ATTACHMENT_BYTES:
        return ""
    with open(path, "r", encoding="utf-8", errors="ignore") as fp:
        return fp.read(MAX_ATTACHMENT_BYTES + 1)

def _download_and_read_attachment(msg: Any, account_id: int) -> str:
    try:
        media = getattr(msg, "media", None)
        doc = getattr(media, "document", None) if media is not None else None
        if doc is None:
            return ""

        size = int(getattr(doc, "size", 0) or 0)
        if size <= 0 or size > MAX_ATTACHMENT_BYTES:
            return ""

        file_name = ""
        attrs = getattr(doc, "attributes", None)
        if attrs is not None and hasattr(attrs, "size"):
            for i in range(int(attrs.size())):
                a = attrs.get(i)
                fn = getattr(a, "file_name", None)
                if fn:
                    file_name = str(fn).strip()
                    break

        mime = str(getattr(doc, "mime_type", "") or "").lower()
        fn_low = file_name.lower()
        is_text_file = (
            fn_low.endswith((".txt", ".json", ".list", ".conf", ".cfg"))
            or "text/" in mime
            or "json" in mime
        )
        if not is_text_file:
            return ""

        fl = FileLoader.getInstance(account_id)
        f_obj = fl.getPathToAttach(doc, True)
        if f_obj is not None:
            p_str = str(f_obj.getAbsolutePath())
            if os.path.isfile(p_str):
                return _read_attachment_text(p_str)

        ev_loaded = getattr(NotificationCenter, "fileLoaded", None)
        ev_failed = getattr(NotificationCenter, "fileLoadFailed", None)
        if ev_loaded is None:
            return ""

        attach_name = str(FileLoader.getAttachFileName(doc) or "")
        if not attach_name:
            return ""

        done = threading.Event()
        result_path = [""]

        class _FileWatcher(dynamic_proxy(NotificationCenter.NotificationCenterDelegate)):
            def didReceivedNotification(self, notif_id, acc, args):
                try:
                    if not args or len(args) == 0:
                        return
                    fname = str(args[0] or "")
                    if fname != attach_name:
                        return
                    if notif_id == ev_loaded and len(args) > 1 and args[1] is not None:
                        result_path[0] = str(args[1].getAbsolutePath())
                        done.set()
                    elif ev_failed is not None and notif_id == ev_failed:
                        done.set()
                except Exception:
                    pass

        watcher = _FileWatcher()
        nc = get_notification_center(account_id)
        run_on_ui_thread(
            lambda: (
                nc.addObserver(watcher, ev_loaded),
                nc.addObserver(watcher, ev_failed) if ev_failed else None,
                fl.loadFile(doc, msg, 1, 0),
            )
        )
        done.wait(timeout=10.0)
        run_on_ui_thread(
            lambda: (
                nc.removeObserver(watcher, ev_loaded),
                nc.removeObserver(watcher, ev_failed) if ev_failed else None,
            )
        )

        if result_path[0] and os.path.isfile(result_path[0]):
            return _read_attachment_text(result_path[0])
    except Exception:
        pass
    return ""

def extract_proxies_from_message(
    msg: Any,
    allow_mtproto: bool = True,
    allow_socks5: bool = True,
    allow_web: bool = True,
    only_faketls: bool = False,
    parse_attachments: bool = True,
    account_id: int = 0,
) -> List[ParsedProxy]:
    found: List[ParsedProxy] = []
    seen_keys: Set[str] = set()

    def _add(p: Optional[ParsedProxy]):
        if p is None or not p.server or "." not in p.host_only or not (1 <= p.port <= 65535):
            return
        if only_faketls and (p.kind != "mtproto" or not _is_faketls_secret(p.secret)):
            return
        if p.kind == "mtproto":
            if not allow_mtproto:
                return
        elif p.kind == "socks5":
            if not allow_socks5:
                return
        elif p.kind == "web":
            if not allow_web:
                return
        if p.key not in seen_keys:
            seen_keys.add(p.key)
            found.append(p)

    text = str(getattr(msg, "message", "") or "")
    url_candidates: List[Tuple[str, str]] = []

    entities = getattr(msg, "entities", None)
    if entities is not None and hasattr(entities, "size"):
        for i in range(int(entities.size())):
            ent = entities.get(i)
            if ent is None:
                continue
            ent_url = str(getattr(ent, "url", "") or "").strip()
            offset = int(getattr(ent, "offset", 0) or 0)
            length = int(getattr(ent, "length", 0) or 0)
            label = _utf16_slice(text, offset, length) if (offset >= 0 and length > 0) else ""
            if ent_url:
                url_candidates.append((ent_url, label))

    reply_markup = getattr(msg, "reply_markup", None)
    if reply_markup is not None:
        rows = getattr(reply_markup, "rows", None)
        if rows is not None and hasattr(rows, "size"):
            for r_idx in range(int(rows.size())):
                row = rows.get(r_idx)
                buttons = getattr(row, "buttons", None) if row is not None else None
                if buttons is not None and hasattr(buttons, "size"):
                    for b_idx in range(int(buttons.size())):
                        btn = buttons.get(b_idx)
                        if btn is None:
                            continue
                        btn_url = str(getattr(btn, "url", "") or "").strip()
                        btn_text = str(getattr(btn, "text", "") or "").strip()
                        if btn_url:
                            url_candidates.append((btn_url, btn_text))

    media = getattr(msg, "media", None)
    if media is not None:
        webpage = getattr(media, "webpage", None)
        if webpage is not None:
            wp_url = str(getattr(webpage, "url", "") or "").strip()
            if wp_url:
                url_candidates.append((wp_url, ""))

    for raw_u in URL_REGEX.findall(text):
        url_candidates.append((raw_u, ""))

    redirect_checks = 0
    for u, label in url_candidates:
        parsed = _parse_proxy_url(u)
        if parsed is not None:
            _add(parsed)
            continue

        if redirect_checks < MAX_REDIRECT_CHECKS_PER_MSG:
            u_low = u.lower()
            lbl_low = label.lower()
            is_tg = any(d in u_low for d in ("t.me/", "telegram.me/", "telegram.dog/", "tx.me/", "tg://"))
            if not is_tg and any(w in lbl_low for w in ("прокси", "proxy", "web", "веб", "socks", "mtproto")):
                redirect_checks += 1
                for redir_p in _resolve_redirect_url(u):
                    _add(redir_p)

    for p in extract_proxies_from_text(
        text,
        allow_mtproto=allow_mtproto,
        allow_socks5=allow_socks5,
        allow_web=allow_web,
        only_faketls=only_faketls,
    ):
        _add(p)

    if parse_attachments and media is not None and getattr(media, "document", None) is not None:
        file_text = _download_and_read_attachment(msg, account_id)
        if file_text:
            for p in extract_proxies_from_text(
                file_text,
                allow_mtproto=allow_mtproto,
                allow_socks5=allow_socks5,
                allow_web=allow_web,
                only_faketls=only_faketls,
            ):
                _add(p)

    return found

def _mtp_sort_key(e: dict):
    try:
        ip_key = (0, int(ipaddress.ip_address(e["addr"])))
    except Exception:
        ip_key = (1, e["addr"])
    return (ip_key, e["port"], len(e["secret"]), e["secret"])

def _retain_view_listener(view: Any, listener: Any) -> Any:
    try:
        bag = view.getTag()
        if not isinstance(bag, ArrayList):
            previous = bag
            bag = ArrayList()
            if previous is not None:
                bag.add(previous)
            view.setTag(bag)
        bag.add(listener)
    except Exception:
        pass
    return listener

def _set_view_click(view: Any, listener: Any):
    view.setOnClickListener(_retain_view_listener(view, listener))

def _apply_press_scale(view: Any, scale_to: float = 0.96):
    try:
        anim = _SHARED_TOUCH_ANIMS.get(scale_to)
        if anim is None:
            class _TouchAnim(dynamic_proxy(View.OnTouchListener)):
                def onTouch(self, v, event):
                    try:
                        act = event.getActionMasked()
                        if act == MotionEvent.ACTION_DOWN:
                            v.animate().scaleX(scale_to).scaleY(scale_to).setDuration(90).start()
                        elif act in (MotionEvent.ACTION_UP, MotionEvent.ACTION_CANCEL):
                            v.animate().scaleX(1.0).scaleY(1.0).setDuration(180).start()
                    except Exception:
                        pass
                    return False

            anim = _TouchAnim()
            _SHARED_TOUCH_ANIMS[scale_to] = anim
        view.setOnTouchListener(anim)
    except Exception:
        pass

def _show_action_sheet(
    act: Any,
    title: str,
    actions: List[Tuple[str, str, Callable[[], None], bool]],
    subtitle: str = "",
    cancel_text: str = "Закрыть",
):
    if act is None:
        return

    def ui():
        try:
            sheet = BottomSheet(act, False)
            sheet.setApplyBottomPadding(False)
            sheet.setApplyTopPadding(False)

            root = LinearLayout(act)
            root.setOrientation(LinearLayout.VERTICAL)
            root.setPadding(
                AndroidUtilities.dp(18),
                AndroidUtilities.dp(10),
                AndroidUtilities.dp(18),
                AndroidUtilities.dp(16),
            )

            bg = GradientDrawable()
            bg.setShape(GradientDrawable.RECTANGLE)
            bg.setCornerRadii([
                AndroidUtilities.dp(20), AndroidUtilities.dp(20),
                AndroidUtilities.dp(20), AndroidUtilities.dp(20),
                0, 0, 0, 0,
            ])
            bg.setColor(Theme.getColor(Theme.key_dialogBackground))
            root.setBackground(bg)

            pill = View(act)
            pill_bg = GradientDrawable()
            pill_bg.setCornerRadius(AndroidUtilities.dp(2))
            pill_bg.setColor(0x40808080)
            pill.setBackground(pill_bg)
            root.addView(pill, LayoutHelper.createLinear(36, 4, Gravity.CENTER_HORIZONTAL, 0, 0, 0, 12))

            tv_title = TextView(act)
            tv_title.setText(title)
            tv_title.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 19)
            tv_title.setTypeface(AndroidUtilities.getTypeface("fonts/rmedium.ttf"))
            tv_title.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
            tv_title.setGravity(Gravity.CENTER)
            root.addView(tv_title, LayoutHelper.createLinear(-1, -2, Gravity.CENTER, 0, 0, 0, 4 if subtitle else 14))

            if subtitle:
                tv_sub = TextView(act)
                tv_sub.setText(subtitle)
                tv_sub.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13)
                tv_sub.setTextColor(Theme.getColor(Theme.key_dialogTextGray3))
                tv_sub.setGravity(Gravity.CENTER)
                root.addView(tv_sub, LayoutHelper.createLinear(-1, -2, Gravity.CENTER, 4, 0, 4, 14))

            scroll = ScrollView(act)
            scroll.setVerticalScrollBarEnabled(False)

            card = LinearLayout(act)
            card.setOrientation(LinearLayout.VERTICAL)
            card.setPadding(
                AndroidUtilities.dp(8),
                AndroidUtilities.dp(8),
                AndroidUtilities.dp(8),
                AndroidUtilities.dp(8),
            )
            card_bg = GradientDrawable()
            card_bg.setShape(GradientDrawable.RECTANGLE)
            card_bg.setCornerRadius(AndroidUtilities.dp(16))
            try:
                card_bg.setColor(Theme.getColor(Theme.key_windowBackgroundGray))
            except Exception:
                card_bg.setColor(0x18808080)
            card.setBackground(card_bg)

            for idx, (label, icon_name, cb, is_red) in enumerate(actions):
                row = FrameLayout(act)
                row.setPadding(
                    AndroidUtilities.dp(14),
                    AndroidUtilities.dp(12),
                    AndroidUtilities.dp(14),
                    AndroidUtilities.dp(12),
                )
                dlg_bg = Theme.getColor(Theme.key_dialogBackground)
                try:
                    pressed_bg = Theme.getColor(Theme.key_listSelector)
                except Exception:
                    pressed_bg = 0x20808080
                try:
                    row.setBackground(
                        Theme.createSimpleSelectorRoundRectDrawable(
                            AndroidUtilities.dp(12), dlg_bg, pressed_bg
                        )
                    )
                except Exception:
                    row_bg = GradientDrawable()
                    row_bg.setCornerRadius(AndroidUtilities.dp(12))
                    row_bg.setColor(dlg_bg)
                    row.setBackground(row_bg)

                inner = LinearLayout(act)
                inner.setOrientation(LinearLayout.HORIZONTAL)
                inner.setGravity(Gravity.CENTER_VERTICAL)

                accent_col = (
                    Theme.getColor(Theme.key_text_RedRegular)
                    if is_red
                    else Theme.getColor(Theme.key_dialogTextBlue)
                )
                text_col = (
                    Theme.getColor(Theme.key_text_RedRegular)
                    if is_red
                    else Theme.getColor(Theme.key_dialogTextBlack)
                )

                ico_res = _resolve_action_icon(icon_name)
                if ico_res:
                    iv = ImageView(act)
                    iv.setImageResource(ico_res)
                    iv.setScaleType(ImageView.ScaleType.CENTER)
                    iv.setColorFilter(accent_col)
                    inner.addView(iv, LayoutHelper.createLinear(24, 24, Gravity.CENTER_VERTICAL, 0, 0, 12, 0))

                tv = TextView(act)
                tv.setText(label)
                tv.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 15)
                tv.setTextColor(text_col)
                tv.setTypeface(AndroidUtilities.getTypeface("fonts/rmedium.ttf"))
                inner.addView(tv, LayoutHelper.createLinear(-1, -2, Gravity.CENTER_VERTICAL))

                row.addView(inner, FrameLayout.LayoutParams(-1, -2))
                row.setClickable(True)
                _set_view_click(row, OnClickListener(lambda _v, fn=cb: (sheet.dismiss(), fn())))
                _apply_press_scale(row, 0.97)

                lp = LayoutHelper.createLinear(-1, -2, 0, 0 if idx == 0 else 6, 0, 0)
                card.addView(row, lp)

            scroll.addView(card)
            root.addView(scroll, LayoutHelper.createLinear(-1, 0, 1.0))

            btn_close = TextView(act)
            btn_close.setText(cancel_text)
            btn_close.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 15)
            btn_close.setTypeface(AndroidUtilities.getTypeface("fonts/rmedium.ttf"))
            btn_close.setGravity(Gravity.CENTER)
            btn_close.setTextColor(Theme.getColor(Theme.key_featuredStickers_buttonText))
            btn_close.setPadding(0, AndroidUtilities.dp(13), 0, AndroidUtilities.dp(13))
            btn_bg = GradientDrawable()
            btn_bg.setCornerRadius(AndroidUtilities.dp(14))
            btn_bg.setColor(Theme.getColor(Theme.key_featuredStickers_addButton))
            btn_close.setBackground(btn_bg)
            btn_close.setClickable(True)
            _set_view_click(btn_close, OnClickListener(lambda _v: sheet.dismiss()))
            _apply_press_scale(btn_close, 0.97)
            root.addView(btn_close, LayoutHelper.createLinear(-1, -2, 0, 12, 0, 0))

            try:
                dlg_if = jclass("android.content.DialogInterface$OnDismissListener")

                class _SheetDismiss(dynamic_proxy(dlg_if)):
                    def onDismiss(self_d, _dlg):
                        try:
                            frag_now = get_last_fragment()
                            ab_now = _get_action_bar(frag_now)
                            if ab_now is not None:
                                ab_now.requestLayout()
                                ab_now.invalidate()
                        except Exception:
                            pass

                sheet.setOnDismissListener(_SheetDismiss())
            except Exception:
                pass
            sheet.setCustomView(root)
            sheet.show()
        except Exception as e:
            _plog(f"action sheet err: {e}")

    run_on_ui_thread(ui)

def _show_input_sheet(
    act: Any,
    title: str,
    hint: str,
    on_submit: Callable[[str], None],
    multiline: bool = False,
):
    if act is None:
        return

    def ui():
        try:
            sheet = BottomSheet(act, True)
            sheet.setApplyBottomPadding(False)
            sheet.setApplyTopPadding(False)

            root = LinearLayout(act)
            root.setOrientation(LinearLayout.VERTICAL)
            root.setPadding(
                AndroidUtilities.dp(20),
                AndroidUtilities.dp(12),
                AndroidUtilities.dp(20),
                AndroidUtilities.dp(16),
            )
            bg = GradientDrawable()
            bg.setCornerRadii([
                AndroidUtilities.dp(20), AndroidUtilities.dp(20),
                AndroidUtilities.dp(20), AndroidUtilities.dp(20),
                0, 0, 0, 0,
            ])
            bg.setColor(Theme.getColor(Theme.key_dialogBackground))
            root.setBackground(bg)

            tv_title = TextView(act)
            tv_title.setText(title)
            tv_title.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 18)
            tv_title.setTypeface(AndroidUtilities.getTypeface("fonts/rmedium.ttf"))
            tv_title.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
            tv_title.setGravity(Gravity.CENTER)
            root.addView(tv_title, LayoutHelper.createLinear(-1, -2, Gravity.CENTER, 0, 4, 0, 12))

            box = FrameLayout(act)
            box.setPadding(
                AndroidUtilities.dp(12),
                AndroidUtilities.dp(8),
                AndroidUtilities.dp(12),
                AndroidUtilities.dp(8),
            )
            box_bg = GradientDrawable()
            box_bg.setCornerRadius(AndroidUtilities.dp(14))
            box_bg.setStroke(AndroidUtilities.dp(1.5), Theme.getColor(Theme.key_dialogTextBlue))
            box_bg.setColor(Theme.getColor(Theme.key_windowBackgroundWhite))
            box.setBackground(box_bg)

            edit = EditText(act)
            edit.setHint(hint)
            edit.setBackgroundColor(Color.TRANSPARENT)
            edit.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 15)
            edit.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
            edit.setHintTextColor(Theme.getColor(Theme.key_dialogTextGray3))
            if multiline:
                edit.setInputType(InputType.TYPE_CLASS_TEXT | InputType.TYPE_TEXT_FLAG_MULTI_LINE)
                edit.setMinLines(3)
                edit.setMaxLines(7)
            else:
                edit.setSingleLine(True)
            box.addView(edit, FrameLayout.LayoutParams(-1, -2))
            root.addView(box, LayoutHelper.createLinear(-1, -2, 0, 0, 0, 12))

            row_btns = LinearLayout(act)
            row_btns.setOrientation(LinearLayout.HORIZONTAL)

            btn_paste = TextView(act)
            btn_paste.setText("Вставить")
            btn_paste.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 15)
            btn_paste.setTypeface(AndroidUtilities.getTypeface("fonts/rmedium.ttf"))
            btn_paste.setGravity(Gravity.CENTER)
            btn_paste.setTextColor(Theme.getColor(Theme.key_dialogTextBlue))
            btn_paste.setPadding(0, AndroidUtilities.dp(12), 0, AndroidUtilities.dp(12))
            p_bg = GradientDrawable()
            p_bg.setCornerRadius(AndroidUtilities.dp(14))
            try:
                p_bg.setColor(Theme.getColor(Theme.key_windowBackgroundGray))
            except Exception:
                p_bg.setColor(0x20808080)
            btn_paste.setBackground(p_bg)
            btn_paste.setClickable(True)
            _set_view_click(
                btn_paste,
                OnClickListener(
                    lambda _v: (
                        edit.setText(_read_clipboard_text()),
                        edit.setSelection(edit.getText().length()),
                    )
                ),
            )
            _apply_press_scale(btn_paste, 0.97)
            row_btns.addView(btn_paste, LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1.0))

            spacer = View(act)
            row_btns.addView(spacer, LayoutHelper.createLinear(10, 1))

            btn_ok = TextView(act)
            btn_ok.setText("Готово")
            btn_ok.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 15)
            btn_ok.setTypeface(AndroidUtilities.getTypeface("fonts/rmedium.ttf"))
            btn_ok.setGravity(Gravity.CENTER)
            btn_ok.setTextColor(Theme.getColor(Theme.key_featuredStickers_buttonText))
            btn_ok.setPadding(0, AndroidUtilities.dp(12), 0, AndroidUtilities.dp(12))
            ok_bg = GradientDrawable()
            ok_bg.setCornerRadius(AndroidUtilities.dp(14))
            ok_bg.setColor(Theme.getColor(Theme.key_featuredStickers_addButton))
            btn_ok.setBackground(ok_bg)
            btn_ok.setClickable(True)

            def do_ok(_v):
                val = str(edit.getText().toString()).strip()
                sheet.dismiss()
                if val:
                    on_submit(val)

            _set_view_click(btn_ok, OnClickListener(do_ok))
            _apply_press_scale(btn_ok, 0.97)
            row_btns.addView(btn_ok, LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1.2))

            root.addView(row_btns, LayoutHelper.createLinear(-1, -2))
            sheet.setCustomView(root)
            sheet.show()
            run_on_ui_thread(lambda: edit.requestFocus(), 200)
        except Exception as e:
            _plog(f"input sheet err: {e}")

    run_on_ui_thread(ui)

class SourcePickerDelegate(dynamic_proxy(DialogsActivity.DialogsActivityDelegate)):
    def __init__(self, on_picked: Callable[[int, int], None]):
        super().__init__()
        self.on_picked = on_picked

    def canSelectStories(self, *args) -> bool:
        return False

    def didSelectDialogs(self, *args) -> bool:
        try:
            if len(args) < 2:
                return False
            fragment = args[0]
            dids = args[1]
            if dids is None or dids.isEmpty():
                return False

            first_item = dids.get(0)
            target_did = 0
            target_tid = 0

            if hasattr(first_item, "dialogId"):
                target_did = int(first_item.dialogId)
                if hasattr(first_item, "topicId"):
                    target_tid = int(first_item.topicId or 0)
            else:
                raw_did = get_private_field(first_item, "dialogId")
                if raw_did is not None:
                    target_did = int(raw_did)
                    target_tid = int(get_private_field(first_item, "topicId") or 0)
                else:
                    target_did = int(first_item)

            topics_frag = args[-1] if len(args) >= 6 else None
            if topics_frag is not None and topics_frag is not fragment and hasattr(topics_frag, "finishFragment"):
                try:
                    topics_frag.finishFragment()
                except Exception:
                    pass
                try:
                    fragment.removeSelfFromStack()
                except Exception:
                    pass
            else:
                try:
                    fragment.finishFragment()
                except Exception:
                    pass

            if target_did != 0 and self.on_picked:
                norm_did = _normalize_dialog_id(target_did)
                if not _is_forum_chat(norm_did):
                    target_tid = 0
                self.on_picked(norm_did, int(target_tid))
            return True
        except Exception:
            return False

class SlideCallback(dynamic_proxy(Utilities.Callback)):
    def __init__(self, on_choose: Callable[[int], None]):
        super().__init__()
        self.on_choose = on_choose

    def run(self, arg: Any):
        try:
            self.on_choose(int(arg))
        except Exception:
            pass

class _ProxyRpcDelegate(dynamic_proxy(RequestDelegate)):
    def __init__(self, callback: Callable[[Any, Any], None]):
        super().__init__()
        self.callback = callback

    def run(self, response, error):
        try:
            self.callback(response, error)
        except Exception as exc:
            _plog(f"RPC delegate callback: {exc}")

class CanSendMessagesPickerHook(MethodHook):

    def __init__(self, plugin: "AutoProxyCollectorPlugin"):
        super().__init__()
        self.plugin = plugin

    def before_hooked_method(self, param):
        try:
            if self.plugin._is_picker_active():
                param.setResult(True)
        except Exception:
            pass

class RealtimeMessagesHook(MethodHook):
    def __init__(self, plugin: "AutoProxyCollectorPlugin"):
        super().__init__()
        self.plugin = plugin

    def after_hooked_method(self, param):
        if not self.plugin._alive:
            return
        try:
            if not param.args or len(param.args) < 2:
                return
            raw_acc = get_private_field(param.thisObject, "currentAccount")
            account = int(raw_acc) if raw_acc is not None else int(UserConfig.selectedAccount)
            self.plugin._handle_realtime_batch(account, param.args[0], param.args[1])
        except Exception:
            pass

class NewMessagesObserver(dynamic_proxy(NotificationCenter.NotificationCenterDelegate)):
    def __init__(self, plugin: "AutoProxyCollectorPlugin", account_id: int):
        super().__init__()
        self.plugin = plugin
        self.account_id = int(account_id)

    def didReceivedNotification(self, notif_id, account, args):
        if not self.plugin._alive:
            return
        try:
            if args is not None and len(args) >= 2:
                self.plugin._handle_realtime_batch(self.account_id, args[0], args[1])
        except Exception:
            pass

def _invoke_time_delegate_safe(delegate: Any, ms_val: int):
    if delegate is None:
        return
    try:
        delegate.run(int(ms_val))
    except Exception:
        try:
            delegate.run(JLong(int(ms_val)))
        except Exception as exc:
            _plog(f"time delegate run err: {exc}")


class NativeCheckProxyHook(MethodHook):
    def __init__(self, plugin: "AutoProxyCollectorPlugin"):
        super().__init__()
        self.plugin = plugin

    def before_hooked_method(self, param):
        try:
            if getattr(self.plugin._tls, "bypass_native_hook", False):
                return
            if not self.plugin._alive or not self.plugin.get_setting("replace_native_ping", True):
                return
            if not param.args or len(param.args) < 2:
                return

            if len(param.args) == 2:
                ps_obj = param.args[0]
                delegate = param.args[1]
            elif len(param.args) >= 6:
                ps_obj = None
                delegate = param.args[5]
            else:
                return

            param.setResult(0)
            if delegate is None:
                return

            candidate_keys = []
            if ps_obj is not None:
                k_ps, _, addr_ps, port_ps, sec_ps, user_ps, pwd_ps = _extract_proxy_details(ps_obj)
                if k_ps:
                    candidate_keys.append(k_ps)
                if sec_ps:
                    ns = _normalize_secret(sec_ps).lower()
                    candidate_keys.append(f"web:{addr_ps}:{ns}")
                    candidate_keys.append(f"mtproto:{addr_ps}:{port_ps}:{ns}")
                elif addr_ps:
                    candidate_keys.append(f"socks5:{addr_ps}:{port_ps}:{user_ps}:{pwd_ps}")
            else:
                raw_addr = str(param.args[0] or "")
                port = int(param.args[1] or 443)
                user = str(param.args[2] or "").strip()
                pwd = str(param.args[3] or "").strip()
                sec = str(param.args[4] or "").strip()
                is_web = "/" in raw_addr or (port == 443 and sec and "." in raw_addr and not raw_addr.replace(".", "").isdigit())
                addr = _clean_server(raw_addr, keep_path=is_web)
                norm_sec = _normalize_secret(sec).lower()
                if sec:
                    candidate_keys.append(f"web:{addr}:{norm_sec}")
                    candidate_keys.append(f"mtproto:{addr}:{port}:{norm_sec}")
                else:
                    candidate_keys.append(f"socks5:{addr}:{port}:{user}:{pwd}")

            cached = None
            for ck in candidate_keys:
                cached = self.plugin._get_cached_ping(ck)
                if cached is not None:
                    break
            ms = int(cached["ping"]) if (cached and cached.get("alive")) else -1
            run_on_ui_thread(lambda d=delegate, v=ms: _invoke_time_delegate_safe(d, v))
        except Exception as exc:
            _plog(f"native checkProxy hook: {exc}")
            try:
                if param.args:
                    d = param.args[1] if len(param.args) == 2 else (param.args[5] if len(param.args) >= 6 else None)
                    if d is not None:
                        run_on_ui_thread(lambda: _invoke_time_delegate_safe(d, -1))
            except Exception:
                pass


class ProxyListScreenHook(MethodHook):
    def __init__(self, plugin: "AutoProxyCollectorPlugin"):
        super().__init__()
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            if not self.plugin._alive:
                return
            fragment = param.thisObject
            if fragment is None or "ProxyListActivity" not in str(fragment.getClass().getName()):
                return
            m_name = str(param.method.getName())
            if m_name == "onFragmentDestroy":
                frag_id = int(System.identityHashCode(fragment))
                self.plugin._toolbar_listeners.pop(frag_id, None)
                self.plugin._click_wrappers.pop(frag_id, None)
                self.plugin._refresh_row_orig_text.pop(frag_id, None)
                self.plugin._refresh_action_views.pop(frag_id, None)
            elif m_name == "updateRows":
                self.plugin._attach_refresh_row_interceptor(fragment)
                if self.plugin.get_setting("replace_native_ping", True):
                    self.plugin._set_refresh_button_locked(fragment, self.plugin._is_proxy_check_busy())
            else:
                self.plugin._proxy_screen_opened_at = time.monotonic()
                self.plugin._inject_proxy_screen_button(fragment)
                self.plugin._attach_refresh_row_interceptor(fragment)
                if self.plugin.get_setting("show_geo_flags", True) and self.plugin.get_setting("geo_remote_lookup", False):
                    self.plugin._prefetch_geo_for_all_proxies(manual=False)
                if self.plugin.get_setting("replace_native_ping", True):
                    self.plugin._hydrate_all_proxies()
                    self.plugin._refresh_visible_proxy_cells(notify_adapter=True)
                    self.plugin._set_refresh_button_locked(fragment, self.plugin._is_proxy_check_busy())
        except Exception as exc:
            _plog(f"proxy screen hook: {exc}")


class RefreshActionHook(MethodHook):
    def __init__(self, plugin: "AutoProxyCollectorPlugin"):
        super().__init__()
        self.plugin = plugin

    def before_hooked_method(self, param):
        if not self.plugin._alive or not self.plugin.get_setting("replace_native_ping", True):
            return
        try:
            m_name = str(param.method.getName())
            busy = self.plugin._is_proxy_check_busy()
            if "isRefreshActionEnabled" in m_name:
                if busy:
                    param.setResult(False)
            elif "updateRefreshActionState" in m_name and param.args and len(param.args) >= 1:
                if busy:
                    param.args[0] = False
        except Exception:
            pass

    def after_hooked_method(self, param):
        if not self.plugin._alive:
            return
        try:
            fragment = param.thisObject
            if fragment is None:
                return
            frag_id = int(System.identityHashCode(fragment))
            m_name = str(param.method.getName())
            if "bindRefreshActionView" in m_name and param.args and len(param.args) >= 1 and param.args[0] is not None:
                stv = param.args[0]
                self.plugin._refresh_action_views[frag_id] = stv
                self.plugin._wrap_refresh_action_view(fragment, stv)
                if self.plugin.get_setting("replace_native_ping", True):
                    self.plugin._apply_refresh_widget_state(stv, None, frag_id, self.plugin._is_proxy_check_busy())
            elif "updateRefreshActionState" in m_name and self.plugin.get_setting("replace_native_ping", True):
                self.plugin._set_refresh_button_locked(fragment, self.plugin._is_proxy_check_busy())
        except Exception:
            pass


class CellSetProxyHook(MethodHook):
    def __init__(self, plugin: "AutoProxyCollectorPlugin"):
        super().__init__()
        self.plugin = plugin

    def after_hooked_method(self, param):
        if not self.plugin._alive:
            return
        try:
            cell = param.thisObject
            info = param.args[0] if param.args else None
            if not info:
                return
            cfg = self.plugin._get_hot_ui_cfg()
            if cfg["replace_ping"]:
                self.plugin._hydrate_proxy_info(info)
            tv = get_private_field(cell, "textView")
            if tv is None:
                return

            _, kind, srv, port, sec, _, _ = _extract_proxy_details(info)
            if not srv:
                return

            host_only = _extract_connect_host(srv)
            if _is_local_host(host_only):
                if cfg["local_label"]:
                    tv.setText("Локальный туннель")
                return

            prefix = ""
            if cfg["dpi_badges"]:
                prefix += _classify_dpi_badge(kind, sec)
            if cfg["geo_flags"]:
                geo = self.plugin._get_cached_geo(host_only)
                if geo and geo.get("flag"):
                    prefix += geo["flag"]
                elif cfg["geo_remote"] and not self.plugin._cleaning and not self.plugin._pinging:
                    self.plugin._request_geo(host_only)

            base = srv if kind == "web" else f"{host_only}:{port}"
            tv.setText(f"{prefix} {base}".strip() if prefix else base)
        except Exception:
            pass


class CellUpdateStatusHook(MethodHook):
    def __init__(self, plugin: "AutoProxyCollectorPlugin"):
        super().__init__()
        self.plugin = plugin

    def after_hooked_method(self, param):
        if not self.plugin._alive:
            return
        try:
            cell = param.thisObject
            info = get_private_field(cell, "currentInfo")
            if not info:
                return
            vv = get_private_field(cell, "valueTextView")
            if vv is None:
                return

            cfg = self.plugin._get_hot_ui_cfg()
            k, _, srv, _, _, _, _ = _extract_proxy_details(info)
            host_only = _extract_connect_host(srv)

            if cfg["replace_ping"]:
                active_key = cfg.get("active_key", "")
                is_active = bool(k and k == active_key and cfg.get("proxy_enabled", False))

                forced_key = self.plugin._forced_active_key
                if forced_key and (time.monotonic() - self.plugin._forced_active_ts) < 4.0:
                    is_active = bool(k and k == forced_key)

                if _is_local_host(host_only):
                    _set_status_text_compat(
                        vv,
                        "Подключён · Локальный" if is_active else "Локальный · 1 мс",
                        COLOR_FAST,
                        cell=cell,
                    )
                    return

                is_checking = bool(k and k in self.plugin._checking_keys)
                cached = self.plugin._hydrate_proxy_info(info)
                av, ping_ms = _get_proxy_ping_and_avail(info)
                if cached is not None:
                    av = bool(cached["alive"])
                    ping_ms = int(cached["ping"])

                if is_active:
                    acc = int(UserConfig.selectedAccount)
                    conn_state = int(ConnectionsManager.getInstance(acc).getConnectionState())
                    st_conn = int(getattr(ConnectionsManager, "ConnectionStateConnecting", 1))
                    st_conn_p = int(getattr(ConnectionsManager, "ConnectionStateConnectingToProxy", 4))
                    st_upd = int(getattr(ConnectionsManager, "ConnectionStateUpdating", 5))
                    st_wait = int(getattr(ConnectionsManager, "ConnectionStateWaitingForNetwork", 2))

                    if conn_state in (st_conn, st_conn_p, st_upd):
                        status_txt = f"Подключение... ({ping_ms} мс)" if ping_ms > 0 else "Подключение..."
                        status_col = COLOR_MID
                    elif conn_state == st_wait:
                        status_txt = "Ожидание сети..."
                        status_col = 0xFF9E9E9E
                    else:
                        status_txt = f"Подключён · {ping_ms} мс" if ping_ms > 0 else "Подключён"
                        status_col = COLOR_FAST
                elif is_checking:
                    status_txt = "⏳ Проверка..."
                    status_col = 0xFF2196F3
                else:
                    if av and ping_ms > 0:
                        status_txt = f"{ping_ms} мс"
                        status_col = _ping_color(ping_ms)
                    elif cached is not None and not cached["alive"]:
                        s_cnt = self.plugin._strikes.get(k, 0)
                        s_lim = self.plugin._get_strike_limit()
                        status_txt = f"Недоступен ({s_cnt}/{s_lim})" if s_cnt > 1 else "Недоступен"
                        status_col = COLOR_SLOW
                    else:
                        status_txt = "Не проверен"
                        status_col = 0xFF9E9E9E

                if cfg["geo_flags"] and host_only:
                    geo = self.plugin._get_cached_geo(host_only)
                    if geo and geo.get("isp"):
                        status_txt = f"{status_txt} · {geo['isp']}"

                _set_status_text_compat(vv, status_txt, status_col, cell=cell)
                return

            if self.plugin.get_setting("show_ping_color", True):
                try:
                    av, ping_ms = _get_proxy_ping_and_avail(info)
                    if av and ping_ms > 0:
                        vv.setTextColor(_ping_color(ping_ms))
                    elif av:
                        vv.setTextColor(COLOR_FAST)
                    else:
                        vv.setTextColor(0xFF9E9E9E)
                except Exception:
                    pass

            if self.plugin.get_setting("show_geo_flags", True):
                if host_only and not _is_local_host(host_only):
                    geo = self.plugin._get_cached_geo(host_only)
                    if geo and geo.get("isp"):
                        cur = str(vv.getText() or "")
                        isp = geo["isp"]
                        if isp not in cur:
                            _set_status_text_compat(
                                vv,
                                f"{cur} · {isp}",
                                vv.getCurrentTextColor() if hasattr(vv, "getCurrentTextColor") else COLOR_FAST,
                            )
        except Exception:
            pass


class ConnectionStateObserver(dynamic_proxy(NotificationCenter.NotificationCenterDelegate)):
    def __init__(self, plugin: "AutoProxyCollectorPlugin"):
        super().__init__()
        self.plugin = plugin

    def didReceivedNotification(self, notif_id, account, args):
        if not self.plugin._alive:
            return
        try:
            self.plugin._on_connection_state_event()
        except Exception:
            pass


class SettingsHeaderHook(MethodHook):
    def __init__(self, plugin: "AutoProxyCollectorPlugin"):
        super().__init__()
        self.plugin = plugin

    def after_hooked_method(self, param):
        if not self.plugin._alive:
            return
        try:
            activity = param.thisObject
            m_name = str(param.method.getName())
            plugin_obj = get_private_field(activity, "plugin")
            if not plugin_obj or str(plugin_obj.getId()) != __id__:
                return

            if m_name == "onResume":
                if self.plugin._settings_dirty and get_private_field(activity, "createSubFragmentCallback") is None:
                    self.plugin._settings_dirty = False
                    run_on_ui_thread(self.plugin._refresh_settings_ui, 40)
                return

            items = param.args[0]
            if not items or items.size() == 0:
                return
            for i in range(items.size()):
                item = items.get(i)
                if (hasattr(item, "settingItem") and str(item.settingItem) == "proxy_collector_header") or (
                    getattr(item, "object", None) == "proxy_collector_header"
                ):
                    return
            if get_private_field(activity, "createSubFragmentCallback") is not None:
                return
            if get_private_field(activity, "searching"):
                return
            header = self.plugin._build_settings_header(activity.getContext())
            if header is not None:
                item = UItem.asCustom(header)
                item.object = "proxy_collector_header"
                if HeaderSetting is not None:
                    try:
                        item.settingItem = HeaderSetting("proxy_collector_header")
                    except Exception:
                        pass
                try:
                    item.setTransparent(True)
                except Exception:
                    pass
                items.add(0, item)
                items.add(1, UItem.asShadow())
        except Exception:
            pass

class AutoProxyCollectorPlugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self._alive = False
        self._settings_dirty = False
        self._scanning = False
        self._cleaning = False
        self._pinging = False
        self._force_ping_active = False
        self._proxy_screen_opened_at = 0.0
        self._tls = threading.local()
        self._cells_refresh_scheduled = False
        self._forced_active_key = ""
        self._forced_active_ts = 0.0
        self._hot_cfg_ts = 0.0
        self._hot_cfg_cache: Dict[str, Any] = {}
        self._checking_keys: Set[str] = set()
        self._ping_done_count = 0
        self._ping_total_count = 0
        self._ping_cache: Dict[str, Dict[str, Any]] = {}
        self._ping_cache_lock = threading.Lock()
        self._hooks: List[Any] = []
        self._keep_callbacks: List[Any] = []
        self._chat_menu_item = None
        self._msg_menu_item = None
        self._picker_delegate = None
        self._conn_observer = None
        self._msg_observer = None
        self._conn_observer_account = None
        self._timer_token = 0
        self._resume_scan_at = 0.0
        self._lock = threading.Lock()

        self._rt_queue: Dict[Tuple[int, str], List[Any]] = {}
        self._rt_worker_running = False
        self._rt_seen_ids: Set[Tuple[int, str, int]] = set()
        self._rt_generation = 0

        self._dead_cache: Dict[str, float] = {}
        self._strikes: Dict[str, int] = {}
        self._ip_cache: Dict[str, Dict[str, Any]] = {}
        self._pending_geo: Set[str] = set()
        self._inflight_geo: Set[str] = set()
        self._geo_running = False
        self._geo_lock = threading.Lock()
        self._geo_generation = 0

        self._last_net_sig = ""
        self._last_net_check_ts = 0.0
        self._last_health_check_ts = 0.0
        self._last_connected_ts = 0.0
        self._header_sub_tv = None
        self._easter_tap_count = 0
        self._last_meme_idx = -1
        self._last_anim_idx = -1
        self._stall_check_token = 0
        self._export_posts_in_progress = False
        self._rpc_lock = threading.Lock()
        self._pending_rpc: Dict[int, Any] = {}
        self._toolbar_listeners: Dict[int, Any] = {}
        self._click_wrappers: Dict[int, Any] = {}
        self._refresh_row_orig_text: Dict[int, str] = {}
        self._refresh_action_views: Dict[int, Any] = {}
        self._wrapped_refresh_views: Set[int] = set()

    def on_plugin_load(self):
        self._alive = True
        with self._lock:
            self._rt_generation += 1
            self._rt_queue.clear()
            self._rt_seen_ids.clear()
            self._rt_worker_running = False
        with self._geo_lock:
            self._geo_generation += 1
            self._pending_geo.clear()
            self._inflight_geo.clear()
            self._geo_running = False
        self._load_caches()
        if self.get_setting("replace_native_ping", True):
            self._hydrate_all_proxies()
        self._last_net_sig = _get_network_signature()

        try:
            mc_class = _resolve_jclass("org.telegram.messenger.MessagesController")
            if mc_class is not None:
                refs = self.hook_all_methods(
                    mc_class, "updateInterfaceWithMessages", RealtimeMessagesHook(self)
                )
                if refs:
                    self._hooks.extend(refs)
        except Exception as exc:
            _plog(f"hook MessagesController: {exc}")

        try:
            chat_obj_cls = _resolve_jclass("org.telegram.messenger.ChatObject")
            if chat_obj_cls is not None:
                refs = self.hook_all_methods(
                    chat_obj_cls, "canSendMessages", CanSendMessagesPickerHook(self)
                )
                if refs:
                    self._hooks.extend(refs)
        except Exception as exc:
            _plog(f"hook ChatObject: {exc}")

        self._hook_proxy_list_and_cells()
        self._hook_settings_header()
        self._register_connection_observer()

        self._sync_chat_menu(bool(self.get_setting("show_chat_menu", True)))
        self._sync_msg_menu(bool(self.get_setting("show_msg_menu", False)))
        self._start_periodic_timer()
        _plog("loaded v" + __version__)

    def on_app_event(self, event_type):
        try:
            event = str(getattr(event_type, "name", event_type)).upper()
            now = time.monotonic()
            if ("RESUME" in event and self._alive and self.get_setting("enabled", True)
                    and now - self._resume_scan_at >= 20):
                self._resume_scan_at = now
                run_on_ui_thread(lambda: self._scan_sources_async(manual=False))
        except Exception as exc:
            _plog(f"resume scan: {exc}")

    def on_plugin_unload(self):
        self._alive = False
        self._timer_token += 1
        try:
            fragment = get_last_fragment()
            if fragment is not None:
                def hide_tools():
                    try:
                        menu = _get_action_bar(fragment).createMenu()
                        item = menu.getItem(MENU_TOOLS_ID) if menu else None
                        if item is not None:
                            item.setVisibility(View.GONE)
                    except Exception:
                        pass
                run_on_ui_thread(hide_tools)
        except Exception:
            pass
        with self._lock:
            self._rt_generation += 1
            self._rt_queue.clear()
            self._rt_seen_ids.clear()
            self._rt_worker_running = False
        with self._geo_lock:
            self._geo_generation += 1
            self._pending_geo.clear()
            self._inflight_geo.clear()
            self._geo_running = False
        with self._rpc_lock:
            pending = list(self._pending_rpc.values())
        for _delegate, account_id, request_id, completed in pending:
            completed.set()
            if request_id is not None:
                try:
                    ConnectionsManager.getInstance(account_id).cancelRequest(request_id, True)
                except Exception as exc:
                    _plog(f"RPC cancel on unload: {exc}")
        for cleanup in (
            lambda: self._sync_chat_menu(False),
            lambda: self._sync_msg_menu(False),
            self._unregister_connection_observer,
        ):
            try:
                cleanup()
            except Exception as exc:
                _plog(f"unload cleanup: {exc}")

        for h in self._hooks:
            try:
                self.unhook_method(h)
            except Exception:
                pass
        self._hooks.clear()
        self._keep_callbacks.clear()
        self._toolbar_listeners.clear()
        self._click_wrappers.clear()
        self._refresh_row_orig_text.clear()
        self._refresh_action_views.clear()
        self._wrapped_refresh_views.clear()
        self._checking_keys.clear()
        self._ping_done_count = 0
        self._ping_total_count = 0
        self._rt_queue.clear()
        _DETAILS_CACHE.clear()
        _DRAWABLE_CACHE.clear()
        _SHARED_TOUCH_ANIMS.clear()
        self._picker_delegate = None

    def _request_sync(self, req: Any, account_id: int, timeout: float = 18.0) -> Any:
        if not self._alive:
            raise RuntimeError("Плагин выгружен")
        completed = threading.Event()
        result: List[Any] = [None, None]
        started = time.monotonic()
        acc = int(account_id)
        request_name = type(req).__name__
        request_id = None

        def on_result(resp, err):
            try:
                result[0] = resp
                result[1] = err
            finally:
                completed.set()

        delegate = _ProxyRpcDelegate(on_result)
        callback_key = id(delegate)
        with self._rpc_lock:
            self._pending_rpc[callback_key] = (delegate, acc, None, completed)
        try:
            if not self._alive:
                raise RuntimeError("Плагин выгружен")
            request_id = int(ConnectionsManager.getInstance(acc).sendRequest(req, delegate))
            with self._rpc_lock:
                if callback_key in self._pending_rpc:
                    self._pending_rpc[callback_key] = (delegate, acc, request_id, completed)
            _plog(f"RPC sent {request_name}: account={acc}, token={request_id}")
            if not completed.wait(timeout=float(timeout)):
                elapsed = time.monotonic() - started
                _plog(
                    f"RPC timeout {request_name}: account={acc}, token={request_id}, "
                    f"elapsed={elapsed:.1f}s, network={_get_network_signature()}"
                )
                try:
                    ConnectionsManager.getInstance(acc).cancelRequest(request_id, True)
                except Exception as cancel_exc:
                    _plog(f"RPC cancel {request_name}: {cancel_exc}")
                raise TimeoutError(
                    f"{request_name}: нет callback за {elapsed:.1f}с (token={request_id})"
                )
            if not self._alive:
                raise RuntimeError("Плагин выгружен")
            elapsed = time.monotonic() - started
            if result[1] is not None:
                error = result[1]
                error_text = str(getattr(error, "text", error))
                error_code = getattr(error, "code", "?")
                _plog(
                    f"RPC error {request_name}: token={request_id}, "
                    f"code={error_code}, text={error_text}, elapsed={elapsed:.1f}s"
                )
                raise RuntimeError(f"{request_name}: {error_text} (code={error_code})")
            if result[0] is None:
                _plog(f"RPC empty {request_name}: token={request_id}, elapsed={elapsed:.1f}s")
                raise RuntimeError(f"{request_name}: пустой ответ Telegram")
            _plog(
                f"RPC ok {request_name}: token={request_id}, "
                f"response={type(result[0]).__name__}, elapsed={elapsed:.1f}s"
            )
            return result[0]
        finally:
            with self._rpc_lock:
                self._pending_rpc.pop(callback_key, None)

    def _get_header_tools_config(self) -> Tuple[List[str], Set[str]]:
        raw_order = self.get_setting("header_tools_order", None)
        if isinstance(raw_order, list):
            order = [k for k in raw_order if k in HEADER_TOOLS_META]
        else:
            order = list(DEFAULT_HEADER_TOOLS)
        for k in DEFAULT_HEADER_TOOLS:
            if k not in order:
                order.append(k)

        raw_disabled = self.get_setting("header_tools_disabled", None)
        disabled = set(raw_disabled) if isinstance(raw_disabled, list) else set()
        return order, disabled.intersection(order)

    def _save_header_tools_config(self, order: List[str], disabled: Set[str], reload_ui: bool = False):
        self.set_setting("header_tools_order", list(order), reload_settings=False)
        self.set_setting("header_tools_disabled", list(disabled), reload_settings=reload_ui)

    def _load_caches(self):
        now = time.time()
        try:
            raw_dead = json.loads(str(self.get_setting("dead_cache_json", "{}")))
            if isinstance(raw_dead, dict):
                self._dead_cache = {k: float(v) for k, v in raw_dead.items() if float(v) > now}
        except Exception:
            self._dead_cache = {}

        try:
            raw_strikes = json.loads(str(self.get_setting("strikes_json", "{}")))
            if isinstance(raw_strikes, dict):
                self._strikes = {k: int(v) for k, v in raw_strikes.items() if int(v) > 0}
        except Exception:
            self._strikes = {}

        try:
            raw_ip = json.loads(str(self.get_setting("ip_cache_json", "{}")))
            if isinstance(raw_ip, dict):
                self._ip_cache = {
                    k: v for k, v in raw_ip.items()
                    if isinstance(k, str) and isinstance(v, dict)
                }
        except Exception:
            self._ip_cache = {}
        self._prune_ip_cache()

        try:
            raw_ping = json.loads(str(self.get_setting("ping_cache_json", "{}")))
            if isinstance(raw_ping, dict):
                with self._ping_cache_lock:
                    self._ping_cache = {
                        k: v for k, v in raw_ping.items()
                        if isinstance(k, str) and isinstance(v, dict)
                    }
        except Exception:
            self._ping_cache = {}
        self._prune_ping_cache()

    def _get_ping_cache_ttl_sec(self) -> int:
        idx = self._get_closest_index("ping_cache_ttl_min", 60, PING_CACHE_TTL_MIN)
        return int(PING_CACHE_TTL_MIN[idx]) * 60

    def _prune_ping_cache(self) -> int:
        now = time.time()
        max_age = max(self._get_ping_cache_ttl_sec(), 3600)
        removed = 0
        with self._ping_cache_lock:
            before = len(self._ping_cache)
            fresh = {}
            for k, v in self._ping_cache.items():
                if not isinstance(v, dict):
                    continue
                try:
                    ts_val = float(v.get("ts", 0))
                except (TypeError, ValueError):
                    continue
                if 0 < ts_val <= now and (now - ts_val) <= max_age:
                    fresh[k] = v
            if len(fresh) > MAX_PING_CACHE_ENTRIES:
                items = sorted(fresh.items(), key=lambda x: float(x[1].get("ts", 0)))[-MAX_PING_CACHE_ENTRIES:]
                fresh = dict(items)
            removed = max(0, before - len(fresh))
            self._ping_cache = fresh
        return removed

    def _prune_ip_cache(self) -> int:
        now = time.time()
        before = len(self._ip_cache)
        fresh = {}
        for k, v in self._ip_cache.items():
            if not isinstance(v, dict):
                continue
            try:
                ts_val = float(v.get("ts", 0))
            except (TypeError, ValueError):
                continue
            if 0 < ts_val <= now and (now - ts_val) <= 7 * 86400:
                fresh[k] = v
        if len(fresh) > MAX_GEO_CACHE_ENTRIES:
            items = sorted(fresh.items(), key=lambda x: float(x[1].get("ts", 0)))[-MAX_GEO_CACHE_ENTRIES:]
            fresh = dict(items)
        self._ip_cache = fresh
        return max(0, before - len(fresh))

    def _get_cached_ping(self, key: str) -> Optional[Dict[str, Any]]:
        if not key:
            return None
        ttl_sec = self._get_ping_cache_ttl_sec()
        if ttl_sec <= 0:
            return None
        with self._ping_cache_lock:
            entry = self._ping_cache.get(key)
            if not isinstance(entry, dict):
                return None
            try:
                saved_at = float(entry.get("ts", 0))
            except (TypeError, ValueError):
                return None
            if not (0 < saved_at <= time.time()) or (time.time() - saved_at) > ttl_sec:
                return None
            return dict(entry)

    def _set_cached_ping(self, key: str, ping_ms: Optional[int], save_now: bool = False):
        if not key:
            return
        alive = ping_ms is not None and int(ping_ms) > 0
        with self._ping_cache_lock:
            self._ping_cache[key] = {
                "ping": int(ping_ms) if alive else 0,
                "alive": alive,
                "ts": time.time(),
            }
        if save_now:
            self._save_ping_cache()

    def _save_ping_cache(self):
        try:
            self._prune_ping_cache()
            with self._ping_cache_lock:
                payload = json.dumps(self._ping_cache, ensure_ascii=False)
            self.set_setting("ping_cache_json", payload, reload_settings=False)
        except Exception as exc:
            _plog(f"save ping cache: {exc}")

    def _hydrate_proxy_info(self, info: Any) -> Optional[Dict[str, Any]]:
        if info is None:
            return None
        k, _, srv, _, _, _, _ = _extract_proxy_details(info)
        if not k or _is_local_host(srv) or k in self._checking_keys:
            return None
        cached = self._get_cached_ping(k)
        if cached is None:
            return None
        try:
            alive = bool(cached.get("alive", False))
            ping_val = int(cached.get("ping", 0) or 0)
            info.available = alive
            info.ping = ping_val if alive else 0
            info.checking = False
            if int(getattr(info, "availableCheckTime", 0) or 0) <= 0:
                info.availableCheckTime = _elapsed_ms()
        except Exception:
            pass
        return cached

    def _hydrate_all_proxies(self):
        try:
            PC, _, _ = _get_cached_classes()
            pl = PC.getProxyList()
            if pl is None:
                return
            for i in range(int(pl.size())):
                self._hydrate_proxy_info(pl.get(i))
        except Exception:
            pass

    def _is_proxy_check_busy(self) -> bool:
        return bool(self._pinging or self._cleaning or self._checking_keys)

    @staticmethod
    def _extract_refresh_text_widget(view: Any, depth: int = 0) -> Tuple[Optional[Any], str]:
        if view is None or depth > 3:
            return None, ""
        try:
            if get_private_field(view, "currentInfo") is not None:
                return None, ""
        except Exception:
            pass
        labels = ("обновить", "оновити", "проверк", "refresh", "checking")
        for fname in ("textView", "valueTextView"):
            try:
                tv = get_private_field(view, fname)
                if tv is not None and hasattr(tv, "getText"):
                    txt = str(tv.getText() or "").strip()
                    if any(lbl in txt.lower() for lbl in labels):
                        return tv, txt
            except Exception:
                pass
        try:
            if hasattr(view, "getText"):
                txt = str(view.getText() or "").strip()
                if any(lbl in txt.lower() for lbl in labels):
                    return view, txt
        except Exception:
            pass
        try:
            if hasattr(view, "getChildCount"):
                for i in range(int(view.getChildCount())):
                    ch = view.getChildAt(i)
                    w, t = AutoProxyCollectorPlugin._extract_refresh_text_widget(ch, depth + 1)
                    if w is not None:
                        return w, t
        except Exception:
            pass
        return None, ""

    def _find_refresh_row_views(self, fragment: Any) -> Tuple[Optional[Any], Optional[Any]]:
        try:
            frag = fragment if fragment is not None else get_last_fragment()
            if frag is None or "ProxyListActivity" not in str(frag.getClass().getName()):
                return None, None
            frag_id = int(System.identityHashCode(frag))
            lv = get_private_field(frag, "listView")
            refresh_pos = -1
            try:
                rr = get_private_field(frag, "refreshRow")
                if rr is not None:
                    refresh_pos = int(rr)
            except Exception:
                refresh_pos = -1

            if lv is not None:
                for i in range(int(lv.getChildCount())):
                    row = lv.getChildAt(i)
                    if row is None:
                        continue
                    if refresh_pos >= 0 and hasattr(lv, "getChildAdapterPosition"):
                        try:
                            if int(lv.getChildAdapterPosition(row)) == refresh_pos:
                                tv_pos = get_private_field(row, "textView") or get_private_field(row, "valueTextView")
                                if tv_pos is not None:
                                    return row, tv_pos
                        except Exception:
                            pass
                    tv, _ = self._extract_refresh_text_widget(row)
                    if tv is not None:
                        return row, tv
            cached_stv = self._refresh_action_views.get(frag_id)
            if cached_stv is not None:
                parent = cached_stv.getParent() if hasattr(cached_stv, "getParent") else None
                return (parent or cached_stv), cached_stv
        except Exception:
            pass
        return None, None

    def _format_refresh_busy_label(self) -> str:
        tot = int(self._ping_total_count or 0)
        done = int(self._ping_done_count or 0)
        if tot > 1:
            return f"Проверка {min(done, tot)}/{tot}..."
        return "Проверка..."

    def _apply_refresh_widget_state(self, tv: Any, row: Any, frag_id: int, locked: bool):
        try:
            if tv is not None and hasattr(tv, "getText"):
                cur_txt = str(tv.getText() or "").strip()
                if locked:
                    if cur_txt and "проверк" not in cur_txt.lower() and "checking" not in cur_txt.lower():
                        self._refresh_row_orig_text[frag_id] = cur_txt
                    busy_lbl = self._format_refresh_busy_label()
                    if cur_txt != busy_lbl:
                        tv.setText(busy_lbl)
                    if hasattr(tv, "setAlpha"):
                        tv.setAlpha(0.55)
                else:
                    orig = self._refresh_row_orig_text.pop(frag_id, None) or "Обновить"
                    if cur_txt != orig:
                        tv.setText(orig)
                    if hasattr(tv, "setAlpha"):
                        tv.setAlpha(1.0)
            if row is not None and row is not tv:
                if hasattr(row, "setAlpha"):
                    row.setAlpha(0.55 if locked else 1.0)
                if hasattr(row, "setEnabled"):
                    row.setEnabled(not locked)
                if hasattr(row, "setClickable"):
                    row.setClickable(False)
        except Exception:
            pass

    def _set_refresh_button_locked(self, fragment: Any, locked: bool):
        try:
            frag = fragment if fragment is not None else get_last_fragment()
            if frag is None or "ProxyListActivity" not in str(frag.getClass().getName()):
                return
            frag_id = int(System.identityHashCode(frag))
            row, tv = self._find_refresh_row_views(frag)
            self._apply_refresh_widget_state(tv, row, frag_id, locked)
            stv = self._refresh_action_views.get(frag_id)
            if stv is not None and stv is not tv:
                self._apply_refresh_widget_state(stv, None, frag_id, locked)
        except Exception:
            pass

    def _wrap_refresh_action_view(self, fragment: Any, target_view: Any):
        if fragment is None or target_view is None or not self._alive:
            return
        try:
            v_hash = int(System.identityHashCode(target_view))
            if v_hash in self._wrapped_refresh_views:
                return
            orig_click = None
            try:
                li = get_private_field(target_view, "mListenerInfo")
                if li is not None:
                    orig_click = get_private_field(li, "mOnClickListener")
            except Exception:
                orig_click = None

            plugin_ref = self

            def _on_refresh_btn_click(v):
                if not plugin_ref._alive:
                    return
                if plugin_ref.get_setting("replace_native_ping", True):
                    if plugin_ref._is_proxy_check_busy():
                        return
                    plugin_ref._set_refresh_button_locked(fragment, True)
                    plugin_ref.ping_all_proxies_async(force=True, manual=True)
                    return
                if orig_click is not None:
                    try:
                        orig_click.onClick(v)
                    except Exception:
                        pass

            listener = OnClickListener(_on_refresh_btn_click)
            self._wrapped_refresh_views.add(v_hash)
            _set_view_click(target_view, listener)
        except Exception as exc:
            _plog(f"wrap refresh action view err: {exc}")

    def _attach_refresh_row_interceptor(self, fragment: Any):
        if fragment is None or not self._alive:
            return

        def _attach():
            if not self._alive:
                return
            try:
                frag_id = int(System.identityHashCode(fragment))
                stv = self._refresh_action_views.get(frag_id)
                if stv is not None:
                    self._wrap_refresh_action_view(fragment, stv)
                row_v, tv_v = self._find_refresh_row_views(fragment)
                if tv_v is not None:
                    self._wrap_refresh_action_view(fragment, tv_v)
                if row_v is not None and row_v is not tv_v:
                    try:
                        li_r = get_private_field(row_v, "mListenerInfo")
                        if li_r is not None and get_private_field(li_r, "mOnClickListener") is not None:
                            self._wrap_refresh_action_view(fragment, row_v)
                    except Exception:
                        pass

                lv = get_private_field(fragment, "listView")
                if lv is None:
                    return
                orig_ext = get_private_field(lv, "onItemClickListenerExtended")
                orig_std = get_private_field(lv, "onItemClickListener")
                existing_wrapper = self._click_wrappers.get(frag_id)
                if existing_wrapper is not None and (orig_ext is existing_wrapper or orig_std is existing_wrapper):
                    return

                plugin_ref = self

                def _is_refresh_click(view: Any, pos: int) -> bool:
                    try:
                        rr = get_private_field(fragment, "refreshRow")
                        if rr is not None and int(rr) >= 0 and int(pos) == int(rr):
                            return True
                    except Exception:
                        pass
                    tv, _ = plugin_ref._extract_refresh_text_widget(view)
                    return tv is not None

                if orig_ext is not None:
                    ext_iface = jclass("org.telegram.ui.Components.RecyclerListView$OnItemClickListenerExtended")

                    class _RefreshExtProxy(dynamic_proxy(ext_iface)):
                        def hasDoubleTap(self_p, view, position):
                            try:
                                return bool(orig_ext.hasDoubleTap(view, position))
                            except Exception:
                                return False

                        def onDoubleTap(self_p, view, position, x, y):
                            try:
                                orig_ext.onDoubleTap(view, position, x, y)
                            except Exception:
                                pass

                        def onItemClick(self_p, view, position, x, y):
                            try:
                                if plugin_ref._alive and plugin_ref.get_setting("replace_native_ping", True):
                                    if _is_refresh_click(view, position):
                                        if plugin_ref._is_proxy_check_busy():
                                            return
                                        plugin_ref._set_refresh_button_locked(fragment, True)
                                        plugin_ref.ping_all_proxies_async(force=True, manual=True)
                                        return
                            except Exception:
                                pass
                            orig_ext.onItemClick(view, position, x, y)

                    wrapper = _RefreshExtProxy()
                    self._click_wrappers[frag_id] = wrapper
                    lv.setOnItemClickListener(wrapper)
                    return

                if orig_std is not None:
                    std_iface = jclass("org.telegram.ui.Components.RecyclerListView$OnItemClickListener")

                    class _RefreshStdProxy(dynamic_proxy(std_iface)):
                        def onItemClick(self_p, view, position):
                            try:
                                if plugin_ref._alive and plugin_ref.get_setting("replace_native_ping", True):
                                    if _is_refresh_click(view, position):
                                        if plugin_ref._is_proxy_check_busy():
                                            return
                                        plugin_ref._set_refresh_button_locked(fragment, True)
                                        plugin_ref.ping_all_proxies_async(force=True, manual=True)
                                        return
                            except Exception:
                                pass
                            orig_std.onItemClick(view, position)

                    wrapper = _RefreshStdProxy()
                    self._click_wrappers[frag_id] = wrapper
                    lv.setOnItemClickListener(wrapper)
            except Exception:
                pass

        run_on_ui_thread(_attach)
        run_on_ui_thread(_attach, 220)

    def _get_hot_ui_cfg(self) -> Dict[str, Any]:
        now = time.monotonic()
        if (now - self._hot_cfg_ts) < 0.4 and self._hot_cfg_cache:
            return self._hot_cfg_cache
        active_key = ""
        proxy_enabled = False
        try:
            PC, _, _ = _get_cached_classes()
            active_key = _get_active_proxy_key(PC)
            proxy_enabled = _is_proxy_enabled_in_client()
        except Exception:
            pass
        self._hot_cfg_cache = {
            "replace_ping": bool(self.get_setting("replace_native_ping", True)),
            "local_label": bool(self.get_setting("show_local_label", True)),
            "dpi_badges": bool(self.get_setting("show_dpi_badges", True)),
            "geo_flags": bool(self.get_setting("show_geo_flags", True)),
            "geo_remote": bool(self.get_setting("geo_remote_lookup", False)),
            "ping_color": bool(self.get_setting("show_ping_color", True)),
            "active_key": active_key,
            "proxy_enabled": proxy_enabled,
        }
        self._hot_cfg_ts = now
        return self._hot_cfg_cache

    def _invalidate_hot_ui_cfg(self):
        self._hot_cfg_ts = 0.0

    def _save_dead_and_strikes(self):
        now = time.time()
        self._dead_cache = {k: v for k, v in self._dead_cache.items() if v > now}
        if len(self._dead_cache) > 1500:
            items = sorted(self._dead_cache.items(), key=lambda x: x[1])[-1500:]
            self._dead_cache = dict(items)
        self.set_setting("dead_cache_json", json.dumps(self._dead_cache), reload_settings=False)
        self.set_setting("strikes_json", json.dumps(self._strikes), reload_settings=False)

    def _save_ip_cache(self):
        self._prune_ip_cache()
        self.set_setting("ip_cache_json", json.dumps(self._ip_cache, ensure_ascii=False), reload_settings=False)

    def _get_cached_geo(self, host: str) -> Optional[Dict[str, Any]]:
        d = self._ip_cache.get(host)
        if not isinstance(d, dict):
            return None
        try:
            saved_at = float(d.get("ts", 0))
        except (ValueError, TypeError):
            return None
        if not 0 < saved_at <= time.time() or time.time() - saved_at > 7 * 86400:
            return None
        return d

    def _prefetch_geo_for_all_proxies(self, manual: bool = False):
        try:
            PC, _, _ = _get_cached_classes()
            pl = PC.getProxyList()
            if pl is None:
                if manual:
                    BulletinHelper.show_info("Список прокси пуст")
                return
            queued = 0
            for i in range(int(pl.size())):
                info = pl.get(i)
                if info is None:
                    continue
                _, _, srv, _, _, _, _ = _extract_proxy_details(info)
                host = _extract_connect_host(srv)
                if not host or _is_local_host(host):
                    continue
                if self._get_cached_geo(host) is None:
                    self._request_geo(host)
                    queued += 1
            if manual:
                if queued > 0:
                    BulletinHelper.show_info(f"Загружаю GeoIP для {queued} серверов...")
                else:
                    BulletinHelper.show_success("Страны и провайдеры уже в кэше")
        except Exception as exc:
            _plog(f"prefetch geo err: {exc}")

    def _on_geo_lookup_toggled(self, enabled: bool):
        on = bool(enabled)
        self.set_setting("geo_remote_lookup", on, reload_settings=True)
        self._invalidate_hot_ui_cfg()
        if on:
            self._prefetch_geo_for_all_proxies(manual=True)

    def _on_proxy_bar_btn_toggled(self, enabled: bool):
        on = bool(enabled)
        self.set_setting("show_proxy_bar_btn", on, reload_settings=True)

    def _on_show_geo_toggled(self, enabled: bool):
        on = bool(enabled)
        self.set_setting("show_geo_flags", on, reload_settings=False)
        self._invalidate_hot_ui_cfg()
        if on and self.get_setting("geo_remote_lookup", False):
            self._prefetch_geo_for_all_proxies(manual=False)
        try:
            NotificationCenter.getGlobalInstance().postNotificationName(
                NotificationCenter.proxySettingsChanged
            )
            self._refresh_visible_proxy_cells()
        except Exception:
            pass

    @staticmethod
    def _format_geo_entry(cc_raw: str, isp_raw: str, now_ts: float) -> Dict[str, Any]:
        cc = str(cc_raw or "").strip().upper()
        isp = str(isp_raw or "").strip()
        isp = re.sub(
            r"(?i)\s+(LLC|Inc\.|Ltd\.|Corporation|Corp\.|Hosting|Network|Communications|GmbH)",
            "",
            isp,
        ).strip(" ,.")
        if len(isp) > 18:
            isp = isp[:16] + ".."
        flag = (chr(ord(cc[0]) + 127397) + chr(ord(cc[1]) + 127397)) if len(cc) == 2 else ""
        return {"flag": flag, "isp": isp, "cc": cc, "ts": now_ts}

    def _request_geo(self, host: str):
        if not self.get_setting("geo_remote_lookup", False):
            return
        with self._geo_lock:
            if self._get_cached_geo(host) is not None:
                return
            if host in self._pending_geo or host in self._inflight_geo:
                return
            self._pending_geo.add(host)
            if self._geo_running:
                return
            self._geo_running = True
            generation = self._geo_generation
        try:
            threading.Thread(target=self._geo_worker, args=(generation,), daemon=True).start()
        except Exception:
            with self._geo_lock:
                if generation == self._geo_generation:
                    self._geo_running = False
            raise

    def _geo_worker(self, generation: int):
        try:
            first_pass = True
            while self._alive and generation == self._geo_generation:
                time.sleep(0.15 if first_pass else 0.7)
                first_pass = False
                with self._geo_lock:
                    batch = list(self._pending_geo)[:100]
                    if not batch:
                        if generation == self._geo_generation:
                            self._geo_running = False
                        return
                    for h in batch:
                        self._pending_geo.discard(h)
                        self._inflight_geo.add(h)

                self._fetch_geo_batch(batch, generation)

                with self._geo_lock:
                    for h in batch:
                        self._inflight_geo.discard(h)
        except Exception as exc:
            _plog(f"GeoIP worker: {exc}")
            with self._geo_lock:
                if generation == self._geo_generation:
                    self._geo_running = False

    def _fetch_geo_batch(self, hosts: List[str], generation: int):
        if not self._alive or not self.get_setting("geo_remote_lookup", False):
            return
        now = time.time()
        changed = False
        resolved_ips: List[Tuple[str, str]] = []
        for h in hosts:
            try:
                ip = h if _IPV4_RE.match(h) else socket.gethostbyname(h)
            except Exception:
                ip = h
            resolved_ips.append((h, ip))

        def _lookup_one(pair: Tuple[str, str]) -> Optional[Tuple[str, Dict[str, Any]]]:
            h_name, ip_addr = pair
            if not self._alive or generation != self._geo_generation:
                return None
            try:
                url = f"https://ipwho.is/{urllib.parse.quote(ip_addr)}?fields=success,country_code,connection"
                req = urllib.request.Request(url, headers={"User-Agent": "ProxyCollector/1.3"})
                with urllib.request.urlopen(req, timeout=3.5) as resp:
                    item = json.loads(_read_http_text(resp, MAX_GEO_RESPONSE_BYTES))
                if isinstance(item, dict) and item.get("success", True) and item.get("country_code"):
                    conn = item.get("connection") if isinstance(item.get("connection"), dict) else {}
                    isp_val = conn.get("isp") or conn.get("org") or ""
                    return h_name, self._format_geo_entry(item.get("country_code", ""), isp_val, now)
            except Exception:
                pass
            try:
                url2 = f"https://freeipapi.com/api/json/{urllib.parse.quote(ip_addr)}"
                req2 = urllib.request.Request(url2, headers={"User-Agent": "ProxyCollector/1.3"})
                with urllib.request.urlopen(req2, timeout=3.5) as resp2:
                    item2 = json.loads(_read_http_text(resp2, MAX_GEO_RESPONSE_BYTES))
                if isinstance(item2, dict) and item2.get("countryCode"):
                    return h_name, self._format_geo_entry(item2.get("countryCode", ""), "", now)
            except Exception:
                pass
            return None

        with ThreadPoolExecutor(max_workers=8) as pool:
            for res in pool.map(_lookup_one, resolved_ips[:40]):
                if res is not None and self._alive and generation == self._geo_generation:
                    h_ok, entry_ok = res
                    self._ip_cache[h_ok] = entry_ok
                    changed = True

        if changed and self._alive:
            self._save_ip_cache()

            def _notify_geo_ui():
                try:
                    NotificationCenter.getGlobalInstance().postNotificationName(
                        NotificationCenter.proxySettingsChanged
                    )
                    self._refresh_visible_proxy_cells()
                except Exception:
                    pass

            run_on_ui_thread(_notify_geo_ui)

    def _hook_proxy_list_and_cells(self):
        act_cls = _resolve_jclass("org.telegram.ui.ProxyListActivity")
        if act_cls is None:
            _plog("ProxyListActivity not found")
        else:
            for method_name in ("createView", "onResume", "onFragmentDestroy"):
                total = 0
                curr = act_cls
                while curr is not None:
                    try:
                        methods = curr.getDeclaredMethods()
                    except Exception as exc:
                        _plog(f"ProxyListActivity {method_name}: reflection {exc}")
                        break
                    for method in methods:
                        try:
                            if str(method.getName()) != method_name:
                                continue
                            method.setAccessible(True)
                            ref = self.hook_method(method, ProxyListScreenHook(self))
                            if ref is not None:
                                self._hooks.append(ref)
                                total += 1
                        except Exception as exc:
                            _plog(f"ProxyListActivity {method_name}: {exc}")
                    if total or method_name == "createView":
                        break
                    try:
                        curr = curr.getSuperclass()
                    except Exception:
                        break
                _plog(f"ProxyListActivity {method_name} hooks: {total}")

            try:
                refresh_hook = RefreshActionHook(self)
                for method in act_cls.getDeclaredMethods():
                    m_name = str(method.getName())
                    if m_name == "updateRows":
                        method.setAccessible(True)
                        ref = self.hook_method(method, ProxyListScreenHook(self))
                        if ref is not None:
                            self._hooks.append(ref)
                    elif any(
                        token in m_name
                        for token in ("bindRefreshActionView", "updateRefreshActionState", "isRefreshActionEnabled")
                    ):
                        method.setAccessible(True)
                        ref = self.hook_method(method, refresh_hook)
                        if ref is not None:
                            self._hooks.append(ref)
            except Exception as exc:
                _plog(f"ProxyListActivity updateRows/refresh hook err: {exc}")

        try:
            cm_cls = _resolve_jclass("org.telegram.tgnet.ConnectionsManager")
            if cm_cls is not None:
                cm_hooks = 0
                for method in cm_cls.getDeclaredMethods():
                    if str(method.getName()) == "checkProxy":
                        method.setAccessible(True)
                        ref = self.hook_method(method, NativeCheckProxyHook(self))
                        if ref is not None:
                            self._hooks.append(ref)
                            cm_hooks += 1
                _plog(f"ConnectionsManager checkProxy hooks: {cm_hooks}")
        except Exception as exc:
            _plog(f"ConnectionsManager checkProxy hook err: {exc}")

        cell_cls = _resolve_jclass("org.telegram.ui.ProxyListActivity$TextDetailProxyCell") or _resolve_jclass(
            "org.telegram.ui.Cells.TextDetailProxyCell"
        )
        if cell_cls is not None:
            try:
                methods = cell_cls.getDeclaredMethods()
            except Exception as exc:
                _plog(f"proxy cell reflection: {exc}")
                methods = []
            for method in methods:
                try:
                    name = str(method.getName())
                    if name not in ("setProxy", "updateStatus"):
                        continue
                    method.setAccessible(True)
                    handler = CellSetProxyHook(self) if name == "setProxy" else CellUpdateStatusHook(self)
                    ref = self.hook_method(method, handler)
                    if ref is not None:
                        self._hooks.append(ref)
                except Exception as exc:
                    _plog(f"proxy cell method: {exc}")
    def _hook_settings_header(self):
        try:
            psa_cls = _resolve_jclass("com.exteragram.messenger.plugins.ui.PluginSettingsActivity")
            if psa_cls is not None:
                hook_handler = SettingsHeaderHook(self)
                for m in psa_cls.getDeclaredMethods():
                    if m.getName() == "fillItems" and len(m.getParameterTypes()) == 2:
                        m.setAccessible(True)
                        ref = self.hook_method(m, hook_handler)
                        if ref is not None:
                            self._hooks.append(ref)
                    elif m.getName() == "onResume" and len(m.getParameterTypes()) == 0:
                        m.setAccessible(True)
                        ref = self.hook_method(m, hook_handler)
                        if ref is not None:
                            self._hooks.append(ref)
        except Exception:
            pass

    def _register_connection_observer(self):
        try:
            account_id = int(UserConfig.selectedAccount)
            self._conn_observer_account = account_id
            nc = get_notification_center(account_id)

            ev_conn = getattr(NotificationCenter, "didUpdateConnectionState", None)
            if ev_conn is not None:
                self._conn_observer = ConnectionStateObserver(self)
                obs_c = self._conn_observer
                run_on_ui_thread(lambda: nc.addObserver(obs_c, ev_conn) if self._alive else None)

            ev_msgs = getattr(NotificationCenter, "didReceiveNewMessages", None)
            if ev_msgs is not None:
                self._msg_observer = NewMessagesObserver(self, account_id)
                obs_m = self._msg_observer
                run_on_ui_thread(lambda: nc.addObserver(obs_m, ev_msgs) if self._alive else None)

        except Exception:
            pass

    def _unregister_connection_observer(self):
        try:
            account_id = self._conn_observer_account
            if account_id is not None:
                nc = get_notification_center(account_id)
                ev_conn = getattr(NotificationCenter, "didUpdateConnectionState", None)
                if ev_conn is not None and self._conn_observer is not None:
                    obs_c = self._conn_observer
                    run_on_ui_thread(lambda: nc.removeObserver(obs_c, ev_conn))
                ev_msgs = getattr(NotificationCenter, "didReceiveNewMessages", None)
                if ev_msgs is not None and self._msg_observer is not None:
                    obs_m = self._msg_observer
                    run_on_ui_thread(lambda: nc.removeObserver(obs_m, ev_msgs))
        except Exception:
            pass
        self._conn_observer = None
        self._msg_observer = None
        self._conn_observer_account = None

    def _handle_realtime_batch(self, account: int, raw_dialog_id: Any, messages_list: Any):
        if not self._alive or not self.get_setting("enabled", True):
            return
        if not self.get_setting("realtime_enabled", True):
            return
        if int(account) != int(UserConfig.selectedAccount):
            return

        dialog_id = _normalize_dialog_id(raw_dialog_id)
        if dialog_id == 0 or messages_list is None or not hasattr(messages_list, "size"):
            return

        sources = self._get_sources(account)
        if not sources:
            return

        has_matching_chat = any(
            not meta.get("paused", False) and _parse_source_key(k, meta)[0] == dialog_id
            for k, meta in sources.items()
        )
        if not has_matching_chat:
            return

        is_forum = _is_forum_chat(dialog_id)
        whole_key = _make_source_key(dialog_id, 0)

        for i in range(int(messages_list.size())):
            mo = messages_list.get(i)
            owner = getattr(mo, "messageOwner", mo)
            if owner is None or not hasattr(owner, "id"):
                continue

            msg_id = int(getattr(owner, "id", 0) or 0)
            if msg_id <= 0:
                continue

            if (whole_key in sources and not sources[whole_key].get("paused", False)
                    and msg_id > int(sources[whole_key].get("last_msg_id", 0) or 0)):
                self.enqueue_realtime_message(whole_key, owner, account)

            if is_forum:
                tid = _get_message_topic_id(owner, mo)
                t_key = _make_source_key(dialog_id, tid)
                if (tid > 0 and t_key in sources and not sources[t_key].get("paused", False)
                        and msg_id > int(sources[t_key].get("last_msg_id", 0) or 0)):
                    self.enqueue_realtime_message(t_key, owner, account)

    def _score_candidate_proxy(self, kind: str, sec: str, ping_ms: int) -> float:
        eff_score = float(ping_ms)
        badge = _classify_dpi_badge(kind, sec)
        if badge == "🛡️":
            eff_score -= 15.0
        elif badge in ("🔒", "🌐"):
            eff_score -= 8.0
        elif badge == "⚠️":
            eff_score += 25.0
        return eff_score

    def _probe_top_candidates_fast(
        self,
        candidates: List[Tuple[float, int, Any, str]],
        batch_size: int = 3,
        timeout: float = 1.35,
    ) -> Optional[Tuple[int, str, Any, str]]:
        if not candidates:
            return None
        use_hs = bool(self.get_setting("replace_native_ping", True))
        ordered = sorted(candidates, key=lambda row: row[0])
        for start in range(0, min(len(ordered), batch_size * 2), batch_size):
            chunk = ordered[start:start + batch_size]
            if not chunk:
                break
            live_hits: List[Tuple[float, int, str, Any, str]] = []
            with ThreadPoolExecutor(max_workers=len(chunk)) as pool:
                fut_map = {}
                for (_sc, _old_p, info, host_lbl) in chunk:
                    k, kind, srv, port, sec, user, pwd = _extract_proxy_details(info)
                    if not k or _is_local_host(srv):
                        continue
                    fut = pool.submit(_check_proxy_alive, kind, srv, port, sec, user, pwd, use_hs, timeout)
                    fut_map[fut] = (k, kind, sec, info, host_lbl)
                for fut in as_completed(fut_map):
                    k, kind, sec, info, host_lbl = fut_map[fut]
                    try:
                        ms_val = fut.result()
                    except Exception:
                        ms_val = None
                    self._set_cached_ping(k, ms_val, save_now=False)
                    if ms_val is not None and int(ms_val) > 0:
                        live_ms = int(ms_val)
                        try:
                            info.available = True
                            info.ping = live_ms
                            info.availableCheckTime = _elapsed_ms()
                        except Exception:
                            pass
                        live_hits.append((self._score_candidate_proxy(kind, sec, live_ms), live_ms, k, info, host_lbl))
                    else:
                        try:
                            info.available = False
                            info.ping = 0
                            info.availableCheckTime = _elapsed_ms()
                        except Exception:
                            pass
            if live_hits:
                live_hits.sort(key=lambda row: row[0])
                _, best_ms, best_k, best_info, best_host = live_hits[0]
                return best_ms, best_k, best_info, best_host
        return None

    def _is_vpn_ping_paused(self) -> bool:
        return bool(self.get_setting("pause_ping_on_vpn", True)) and _is_vpn_active()

    def _schedule_stall_watchdog(self, tok: int, delay_ms: int, stalled_ticks: int):
        def _watchdog():
            if not self._alive or tok != self._stall_check_token:
                return
            if not self.get_setting("auto_failover", True) or not _is_proxy_enabled_in_client():
                return
            if _get_network_signature() in ("offline", "unknown", "vpn") or self._is_vpn_ping_paused():
                return
            try:
                acc = int(UserConfig.selectedAccount)
                st_now = int(ConnectionsManager.getInstance(acc).getConnectionState())
                st_connected = int(getattr(ConnectionsManager, "ConnectionStateConnected", 3))
                st_conn = int(getattr(ConnectionsManager, "ConnectionStateConnecting", 1))
                st_conn_p = int(getattr(ConnectionsManager, "ConnectionStateConnectingToProxy", 4))
                if st_now == st_connected:
                    self._last_connected_ts = time.monotonic()
                    self._stall_check_token += 1
                    return
                if st_now in (st_conn, st_conn_p):
                    if not self._is_proxy_check_busy():
                        self._last_net_check_ts = time.time()
                        force_switch = stalled_ticks >= 2
                        threading.Thread(
                            target=self._verify_active_proxy_on_net_change,
                            args=(0.0, force_switch),
                            daemon=True,
                        ).start()
                    self._schedule_stall_watchdog(tok, 6500, stalled_ticks + 1)
            except Exception:
                pass

        run_on_ui_thread(_watchdog, delay_ms)

    def _on_connection_state_event(self):
        if not self._alive:
            return
        cur_sig = _get_network_signature()
        if cur_sig in ("offline", "unknown"):
            self._last_net_sig = cur_sig
            return

        if cur_sig == "vpn" or self._is_vpn_ping_paused():
            self._last_net_sig = "vpn"
            self._stall_check_token += 1
            return

        if cur_sig != self._last_net_sig:
            prev_sig = self._last_net_sig
            self._last_net_sig = cur_sig
            if self.get_setting("network_switch_failover", True) and cur_sig != "vpn" and prev_sig != "vpn":
                now = time.time()
                if (now - self._last_net_check_ts) >= 5.0 and not self._is_proxy_check_busy():
                    self._last_net_check_ts = now
                    if _is_proxy_enabled_in_client():
                        threading.Thread(
                            target=self._verify_active_proxy_on_net_change,
                            args=(1.0, False),
                            daemon=True,
                        ).start()
                        return

        if not self.get_setting("auto_failover", True) or not _is_proxy_enabled_in_client():
            return

        try:
            acc = int(UserConfig.selectedAccount)
            conn_state = int(ConnectionsManager.getInstance(acc).getConnectionState())
            st_connected = int(getattr(ConnectionsManager, "ConnectionStateConnected", 3))
            st_conn = int(getattr(ConnectionsManager, "ConnectionStateConnecting", 1))
            st_conn_p = int(getattr(ConnectionsManager, "ConnectionStateConnectingToProxy", 4))

            if conn_state == st_connected:
                self._last_connected_ts = time.monotonic()
                self._stall_check_token += 1
                return

            if conn_state in (st_conn, st_conn_p):
                native_sec = _get_native_auto_switch_sec()
                base_delay_ms = max(4200, min(native_sec * 1000 + 800, 15000)) if native_sec > 0 else 4200
                now = time.time()
                if (now - self._last_net_check_ts) < 4.0 or self._is_proxy_check_busy():
                    return
                self._stall_check_token += 1
                tok = self._stall_check_token
                self._schedule_stall_watchdog(tok, base_delay_ms, 0)
        except Exception:
            pass

    def _verify_active_proxy_on_net_change(self, initial_delay: float = 1.2, force_switch: bool = False):
        if initial_delay > 0:
            time.sleep(initial_delay)
        if not self._alive or self._is_proxy_check_busy() or self._is_vpn_ping_paused():
            return
        try:
            PC, _, _ = _get_cached_classes()
            active_key = _get_active_proxy_key(PC)
            if not active_key:
                return
            pl = PC.getProxyList()
            if pl is None:
                return
            active_info = None
            cached_candidates: List[Tuple[float, int, Any, str]] = []
            untested_candidates: List[Tuple[float, int, Any, str]] = []
            for i in range(int(pl.size())):
                info = pl.get(i)
                if info is None:
                    continue
                k, kind, srv, port, sec, user, pwd = _extract_proxy_details(info)
                if not k or _is_local_host(srv):
                    continue
                if k == active_key:
                    active_info = info
                    continue
                host_lbl = _extract_connect_host(srv)
                c_entry = self._get_cached_ping(k)
                if c_entry is not None:
                    if c_entry.get("alive") and int(c_entry.get("ping", 0) or 0) > 0:
                        p_val = int(c_entry["ping"])
                        cached_candidates.append((self._score_candidate_proxy(kind, sec, p_val), p_val, info, host_lbl))
                else:
                    av_i, p_i = _get_proxy_ping_and_avail(info)
                    if av_i and p_i > 0:
                        cached_candidates.append((self._score_candidate_proxy(kind, sec, p_i), p_i, info, host_lbl))
                    else:
                        untested_candidates.append((self._score_candidate_proxy(kind, sec, 500), 500, info, host_lbl))

            if active_info is None:
                return
            _, kind, srv, port, sec, user, pwd = _extract_proxy_details(active_info)
            if _is_local_host(srv):
                return
            use_hs = bool(self.get_setting("replace_native_ping", True))
            if not force_switch:
                ping_ms = _check_proxy_alive(kind, srv, port, sec, user, pwd, use_hs, 2.5)
                if ping_ms is not None:
                    return

            self._set_cached_ping(active_key, None, save_now=False)
            pool_list = cached_candidates if cached_candidates else untested_candidates
            if not pool_list or not self._alive or not bool(self.get_setting("auto_failover", True)):
                return

            picked = self._probe_top_candidates_fast(pool_list, batch_size=3, timeout=1.35)
            if picked is None and cached_candidates and untested_candidates:
                picked = self._probe_top_candidates_fast(untested_candidates, batch_size=3, timeout=1.35)
            self._save_ping_cache()

            if picked is not None and self._alive and bool(self.get_setting("auto_failover", True)):
                b_ping, b_key, b_info, b_host = picked

                def _switch_ui():
                    if not self._alive or not _is_proxy_enabled_in_client():
                        return
                    if _activate_proxy_info(PC, b_info):
                        self._forced_active_key = b_key
                        self._forced_active_ts = time.monotonic()
                        self._refresh_visible_proxy_cells(notify_adapter=True)
                        self._refresh_settings_ui()
                        if self.get_setting("show_bulletin", True):
                            BulletinHelper.show_success(f"Failover → {b_host} ({b_ping} мс)")

                run_on_ui_thread(_switch_ui)
        except Exception as exc:
            _plog(f"failover verify err: {exc}")

    def _inject_proxy_screen_button(self, fragment: Any):
        if fragment is None or not self._alive or not self.get_setting("show_proxy_bar_btn", True):
            return

        def insert():
            if not self._alive or not self.get_setting("show_proxy_bar_btn", True):
                return
            try:
                ab = _get_action_bar(fragment)
                if ab is None:
                    return
                menu = ab.createMenu()
                if menu is None or menu.getItem(MENU_TOOLS_ID) is not None:
                    return
                icon = _get_drawable_res("msg_settings", _get_drawable_res("ic_ab_other", 0))
                if not icon:
                    _plog("ProxyListActivity: toolbar icon unavailable")
                    return
                item = menu.addItemWithWidth(
                    MENU_TOOLS_ID, icon, AndroidUtilities.dp(40), "Инструменты"
                )

                def _on_tools_click(v):
                    try:
                        v.setPressed(False)
                        v.jumpDrawablesToCurrentState()
                        v.cancelPendingInputEvents()
                        parent = v.getParent()
                        if parent is not None:
                            parent.cancelPendingInputEvents()
                    except Exception:
                        pass
                    run_on_ui_thread(lambda: self._open_proxy_screen_tools(fragment), 20)

                listener = OnClickListener(_on_tools_click)
                self._toolbar_listeners[int(System.identityHashCode(fragment))] = listener
                item.setOnClickListener(listener)
            except Exception as exc:
                _plog(f"ProxyListActivity button: {exc}")

        run_on_ui_thread(insert)
        run_on_ui_thread(insert, 240)
    def enqueue_realtime_message(self, source_key: str, tl_msg: Any, account_id: int):
        if not self._alive:
            return
        with self._lock:
            queue_key = (int(account_id), source_key)
            msg_id = int(getattr(tl_msg, "id", 0) or 0)
            seen_key = (int(account_id), source_key, msg_id)
            if msg_id > 0 and seen_key in self._rt_seen_ids:
                return
            if len(self._rt_seen_ids) >= 5000:
                self._rt_seen_ids.clear()
            if msg_id > 0:
                self._rt_seen_ids.add(seen_key)
            items = self._rt_queue.setdefault(queue_key, [])
            if len(items) < 1000:
                items.append(tl_msg)
            else:
                _plog("realtime queue full; periodic scan will catch up")
            if self._rt_worker_running:
                return
            self._rt_worker_running = True
            generation = self._rt_generation

        def drain():
            try:
                time.sleep(0.4)
                while self._alive and generation == self._rt_generation:
                    with self._lock:
                        if not self._rt_queue:
                            return
                        batch = dict(self._rt_queue)
                        self._rt_queue.clear()
                    for (acc, key), msgs in batch.items():
                        if not self._alive or generation != self._rt_generation:
                            break
                        try:
                            self._process_source_messages_bg(key, msgs, manual=False,
                                                             account_id=acc, checkpoint=False)
                        except Exception as exc:
                            _plog(f"realtime process {key}: {exc}")
            finally:
                with self._lock:
                    self._rt_worker_running = False
                    pending = bool(self._rt_queue)
                if pending and self._alive and generation == self._rt_generation:
                    threading.Thread(target=lambda: self._flush_realtime_pending(), daemon=True).start()
        threading.Thread(target=drain, daemon=True).start()

    def _flush_realtime_pending(self):
        if not self._alive:
            return
        with self._lock:
            snapshot = dict(self._rt_queue)
            self._rt_queue.clear()
        for (acc, key), msgs in snapshot.items():
            if self._alive:
                try:
                    self._process_source_messages_bg(key, msgs, manual=False, account_id=acc,
                                                     checkpoint=False)
                except Exception as exc:
                    _plog(f"realtime flush {key}: {exc}")

    def _pick_menu_icon(self, *candidates: str) -> str:
        for name in candidates:
            if _get_drawable_res(name, 0) != 0:
                return name
        return "msg_download"

    def _sync_chat_menu(self, enabled: bool):
        try:
            self.remove_menu_item("apc_chat_menu")
        except Exception as exc:
            _plog(f"chat menu removal: {exc}")
        self._chat_menu_item = None
        if enabled:
            try:
                ico = self._pick_menu_icon(
                    "msg_policy",
                    "msg_proxy",
                    "msg2_proxy",
                    "msg_download",
                )
                self._chat_menu_item = self.add_menu_item(
                    MenuItemData(
                        menu_type=MenuItemType.CHAT_ACTION_MENU,
                        text="Автосбор прокси",
                        icon=ico,
                        item_id="apc_chat_menu",
                        on_click=self._on_chat_menu_click,
                    )
                )
            except Exception:
                pass

    def _sync_msg_menu(self, enabled: bool):
        try:
            self.remove_menu_item("apc_msg_menu")
        except Exception as exc:
            _plog(f"message menu removal: {exc}")
        self._msg_menu_item = None
        if enabled:
            try:
                ico = self._pick_menu_icon(
                    "msg_policy",
                    "msg_proxy",
                    "msg2_proxy",
                    "msg_download",
                )
                self._msg_menu_item = self.add_menu_item(
                    MenuItemData(
                        menu_type=MenuItemType.MESSAGE_CONTEXT_MENU,
                        text="Собрать прокси из поста",
                        icon=ico,
                        item_id="apc_msg_menu",
                        on_click=self._on_message_context_click,
                    )
                )
            except Exception:
                pass
        elif not enabled and self._msg_menu_item is not None:
            try:
                self.remove_menu_item(self._msg_menu_item)
            except Exception:
                pass
            self._msg_menu_item = None

    def _on_message_context_click(self, ctx: dict):
        msg_obj = ctx.get("message") or ctx.get("messageObject")
        owner = getattr(msg_obj, "messageOwner", msg_obj)
        if owner is None:
            BulletinHelper.show_error("Не удалось прочитать сообщение")
            return

        BulletinHelper.show_info("Поиск прокси в сообщении...")

        def worker():
            try:
                acc = int(UserConfig.selectedAccount)
                found = extract_proxies_from_message(
                    owner,
                    allow_mtproto=True,
                    allow_socks5=True,
                    allow_web=True,
                    only_faketls=bool(self.get_setting("only_faketls", False)),
                    parse_attachments=True,
                    account_id=acc,
                )
                self._save_proxies_native(found, manual=True, bypass_dead_cache=bool(self.get_setting("import_ignore_dead_cache", False)))
            except Exception as e:
                run_on_ui_thread(lambda: BulletinHelper.show_error(f"Ошибка разбора поста: {e}"))

        threading.Thread(target=worker, daemon=True).start()

    def _get_sources(self, account_id: Optional[int] = None) -> Dict[str, Dict[str, Any]]:
        acc = int(UserConfig.selectedAccount) if account_id is None else int(account_id)
        setting_key = f"sources_json_account_{acc}"
        raw = self.get_setting(setting_key, None)
        if raw is None:
            migrated_to = self.get_setting("sources_legacy_migrated_to_account", None)
            if migrated_to is None:
                raw = self.get_setting("sources_json", "{}")
                self.set_setting(setting_key, raw, reload_settings=False)
                self.set_setting("sources_legacy_migrated_to_account", acc, reload_settings=False)
            else:
                raw = "{}"
        try:
            data = json.loads(str(raw))
            if isinstance(data, dict):
                result = {str(k): v for k, v in data.items() if isinstance(v, dict)}
                for meta in result.values():
                    if _is_collect_proxy_url(str(meta.get("url", ""))):
                        meta["paused"] = True
                return result
        except Exception as exc:
            _plog(f"sources parse account={acc}: {exc}")
        return {}

    def _save_sources(self, sources: Dict[str, Dict[str, Any]], reload_ui: bool = False,
                      account_id: Optional[int] = None):
        acc = int(UserConfig.selectedAccount) if account_id is None else int(account_id)
        self._settings_dirty = True
        self.set_setting(f"sources_json_account_{acc}",
                         json.dumps(sources, ensure_ascii=False), reload_settings=reload_ui)

    def _add_source(
        self, dialog_id: int, topic_id: int = 0, custom_title: str = "", reload_ui: bool = True
    ) -> str:
        did = _normalize_dialog_id(dialog_id)
        tid = int(topic_id or 0) if _is_forum_chat(did) else 0
        key = _make_source_key(did, tid)

        base_title = _get_dialog_title(did)
        if custom_title and str(custom_title).strip() not in ("", "0"):
            title = str(custom_title).strip()
        else:
            title = f"{base_title} [Топик #{tid}]" if tid > 0 else base_title

        with self._lock:
            sources = self._get_sources()
            prev = sources.get(key, {})
            sources[key] = {
                "type": "chat",
                "dialog_id": did,
                "topic_id": tid,
                "title": title,
                "last_msg_id": int(prev.get("last_msg_id", 0) or 0),
                "added_count": int(prev.get("added_count", 0) or 0),
                "paused": bool(prev.get("paused", False)),
            }
            self._save_sources(sources, reload_ui=reload_ui)
        return title

    def _add_url_source(self, url: str, reload_ui: bool = True) -> str:
        u = url.strip()
        if not u.startswith(("http://", "https://")):
            u = "https://" + u
        if _is_collect_proxy_url(u):
            raise ValueError("Вместо collect.proxy добавь исходный канал как источник")
        key = _make_url_source_key(u)
        parsed = urllib.parse.urlparse(u)
        short_name = f"{parsed.netloc}{parsed.path[:24]}"
        with self._lock:
            sources = self._get_sources()
            prev = sources.get(key, {})
            sources[key] = {
                "type": "url",
                "url": u,
                "title": short_name,
                "added_count": int(prev.get("added_count", 0) or 0),
                "paused": bool(prev.get("paused", False)),
            }
            self._save_sources(sources, reload_ui=reload_ui)
        return short_name

    def _get_list_health_summary(self) -> Tuple[int, int, int, str, int]:
        total_remote = 0
        working_cnt = 0
        overall_best_ms = 0
        next_best_ms = 0
        next_best_host = ""
        cleanup_candidates = 0
        seen_keys: Set[str] = set()
        try:
            PC, _, _ = _get_cached_classes()
            pl = PC.getProxyList()
            if pl is None:
                return 0, 0, 0, "", 0
            active_key = _get_active_proxy_key(PC) if _is_proxy_enabled_in_client() else ""
            if self._forced_active_key and (time.monotonic() - self._forced_active_ts) < 6.0:
                active_key = self._forced_active_key

            for i in range(int(pl.size())):
                info = pl.get(i)
                if info is None:
                    continue
                k, _, srv, _, _, _, _ = _extract_proxy_details(info)
                if not k or _is_local_host(srv):
                    continue
                total_remote += 1
                if k in seen_keys and k != active_key:
                    cleanup_candidates += 1
                    continue
                seen_keys.add(k)
                cached = self._get_cached_ping(k)
                p = 0
                if cached is not None:
                    if cached.get("alive") and int(cached.get("ping", 0) or 0) > 0:
                        p = int(cached["ping"])
                    elif k != active_key:
                        cleanup_candidates += 1
                else:
                    av, p_raw = _get_proxy_ping_and_avail(info)
                    if av and p_raw > 0:
                        p = int(p_raw)
                    elif self._strikes.get(k, 0) > 0 and k != active_key:
                        cleanup_candidates += 1

                if p > 0:
                    working_cnt += 1
                    if overall_best_ms == 0 or p < overall_best_ms:
                        overall_best_ms = p
                    if k != active_key and (next_best_ms == 0 or p < next_best_ms):
                        next_best_ms = p
                        next_best_host = _extract_connect_host(srv)
        except Exception:
            pass
        best_ms = next_best_ms if next_best_ms > 0 else overall_best_ms
        return total_remote, working_cnt, best_ms, next_best_host, cleanup_candidates

    def _connect_random_working_proxy(self):
        try:
            self._hydrate_all_proxies()
            PC, _, _ = _get_cached_classes()
            pl = PC.getProxyList()
            if pl is None or int(pl.size()) == 0:
                BulletinHelper.show_info("Список прокси пуст")
                return
            active_key = _get_active_proxy_key(PC)
            working: List[Tuple[float, int, Any, str]] = []
            for i in range(int(pl.size())):
                info = pl.get(i)
                if info is None:
                    continue
                key, kind, srv, _, sec, _, _ = _extract_proxy_details(info)
                if not key or key == active_key or _is_local_host(srv):
                    continue
                cached = self._get_cached_ping(key)
                if cached is not None:
                    if not cached.get("alive") or int(cached.get("ping", 0) or 0) <= 0:
                        continue
                    ping = int(cached["ping"])
                elif _is_fresh_working(info):
                    _, ping = _get_proxy_ping_and_avail(info)
                else:
                    continue

                eff_score = self._score_candidate_proxy(kind, sec, ping)
                working.append((eff_score, int(ping), info, _extract_connect_host(srv)))
            if not working:
                BulletinHelper.show_info("Нет проверенных рабочих прокси. Нажми «Проверить список»")
                return

            working.sort(key=lambda row: row[0])

            def _probe_and_connect():
                picked = self._probe_top_candidates_fast(working, batch_size=3, timeout=1.35)
                self._save_ping_cache()

                def _apply_ui():
                    if not self._alive:
                        return
                    if picked is None:
                        self._refresh_visible_proxy_cells(notify_adapter=True)
                        self._refresh_settings_ui()
                        BulletinHelper.show_info("Топ-кандидаты не ответили. Запусти «Проверить список»")
                        return
                    live_ping, chosen_key, chosen_info, host = picked
                    if _activate_proxy_info(PC, chosen_info):
                        self._forced_active_key = chosen_key
                        self._forced_active_ts = time.monotonic()
                        self._refresh_visible_proxy_cells(notify_adapter=True)
                        run_on_ui_thread(self._refresh_visible_proxy_cells, 120)
                        self._refresh_settings_ui()
                        BulletinHelper.show_success(f"Подключён лучший: {host} ({live_ping} мс)")
                    else:
                        BulletinHelper.show_error("Не удалось активировать прокси")

                run_on_ui_thread(_apply_ui)

            threading.Thread(target=_probe_and_connect, daemon=True).start()
        except Exception as exc:
            _plog(f"connect best: {exc}")
            BulletinHelper.show_error(f"Ошибка: {exc}")

    def deduplicate_existing_proxies_ui(self, show_toast_if_zero: bool = False) -> int:
        removed_dups = 0
        try:
            PC, _, _ = _get_cached_classes()
            pl = PC.getProxyList()
            if pl is None or int(pl.size()) <= 1:
                if show_toast_if_zero:
                    BulletinHelper.show_info("Дубликатов в списке нет")
                return 0

            active_key = _get_active_proxy_key(PC)
            seen_keys: Set[str] = set()
            if active_key:
                seen_keys.add(active_key)

            kept_active = False
            to_delete: List[Any] = []

            for i in range(int(pl.size())):
                info = pl.get(i)
                if info is None:
                    continue
                k, _, _, _, _, _, _ = _extract_proxy_details(info)
                if not k:
                    continue
                if active_key and k == active_key and not kept_active:
                    kept_active = True
                    continue
                if k in seen_keys:
                    to_delete.append(info)
                else:
                    seen_keys.add(k)

            for dup_info in to_delete:
                if _delete_proxy_from_controller(PC, dup_info):
                    removed_dups += 1

            if removed_dups > 0:
                try:
                    _persist_proxy_controller(PC)
                    _sync_fragment_proxy_list(PC, [pl.get(i) for i in range(int(pl.size()))])
                except Exception:
                    pass
                self._refresh_settings_ui()
                if show_toast_if_zero or self.get_setting("show_bulletin", True):
                    BulletinHelper.show_success(f"Удалено дубликатов: {removed_dups}")
            elif show_toast_if_zero:
                BulletinHelper.show_success("Дубликатов не обнаружено")
        except Exception as e:
            _plog(f"dedup err: {e}")
        return removed_dups

    def _get_sort_mode(self) -> str:
        mode = str(self.get_setting("sort_mode", "smart") or "smart").strip()
        return mode if mode in SORT_MODE_LABELS else "smart"

    def _set_sort_mode(self, mode: str, sort_now: bool = True):
        m = mode if mode in SORT_MODE_LABELS else "smart"
        self._settings_dirty = True
        self.set_setting("sort_mode", m, reload_settings=True)
        if sort_now:
            try:
                PC, _, _ = _get_cached_classes()
                self._sort_proxies_by_ping_inplace(PC, silent=False)
            except Exception:
                pass

    def _build_proxy_sort_key(self, PC: Any):
        mode = self._get_sort_mode()
        active_key = _get_active_proxy_key(PC) if _is_proxy_enabled_in_client() else ""
        dpi_rank_map = {"🛡️": 0, "🔒": 1, "🌐": 2, "➿": 3, "🧦": 4, "⚠️": 5}

        def sort_key(info):
            k_s, kind, srv, _, sec, _, _ = _extract_proxy_details(info)
            if _is_local_host(srv):
                return (0, 0, 0, "")
            try:
                if hasattr(PC, "isPinned") and bool(PC.isPinned(info)):
                    pin_idx = int(PC.getPinnedIndex(info)) if hasattr(PC, "getPinnedIndex") else 0
                    return (0, pin_idx + 1, 0, "")
            except Exception:
                pass

            c_entry = self._get_cached_ping(k_s) if k_s else None
            if c_entry is not None:
                c_alive = bool(c_entry.get("alive", False))
                c_ping = int(c_entry.get("ping", 0) or 0) if c_alive else 0
            else:
                c_alive, c_ping = _get_proxy_ping_and_avail(info)

            is_working = bool(c_alive and c_ping > 0)
            is_known_dead = (
                not is_working
                and (
                    (c_entry is not None and not c_alive)
                    or self._strikes.get(k_s, 0) > 0
                )
            )

            if is_known_dead:
                strikes = int(self._strikes.get(k_s, 1))
                return (3, strikes, 0, srv)

            if not is_working:
                return (2, 0, 0, srv)

            eff_c = c_ping if c_ping > 0 else 99999
            badge = _classify_dpi_badge(kind, sec)
            dpi_rank = dpi_rank_map.get(badge, 5)

            if mode == "ping":
                return (1, eff_c, dpi_rank, srv)
            if mode == "dpi":
                return (1, dpi_rank, eff_c, srv)

            dpi_bonus = {0: -15.0, 1: -8.0, 2: -8.0, 3: -4.0, 4: 0.0, 5: 25.0}.get(dpi_rank, 0.0)
            active_bonus = -10.0 if (active_key and k_s == active_key) else 0.0
            score = max(1.0, float(eff_c) + dpi_bonus + active_bonus)
            return (1, int(round(score * 10)), dpi_rank, srv)

        return sort_key

    def _sort_proxies_by_ping_now(self, PC: Any, silent: bool = True):
        try:
            pl = PC.getProxyList()
            if pl is None or int(pl.size()) <= 1:
                if not silent:
                    BulletinHelper.show_info("Нечего сортировать")
                return

            items = [pl.get(i) for i in range(int(pl.size())) if pl.get(i) is not None]
            items.sort(key=self._build_proxy_sort_key(PC))

            if _replace_proxy_list_in_controller(PC, items):
                if not silent:
                    mode_lbl = SORT_MODE_LABELS.get(self._get_sort_mode(), "Умная")
                    top_hint = ""
                    for it in items:
                        _, _, srv_t, _, _, _, _ = _extract_proxy_details(it)
                        if srv_t and not _is_local_host(srv_t):
                            av_t, p_t = _get_proxy_ping_and_avail(it)
                            if av_t and p_t > 0:
                                geo_t = self._get_cached_geo(_extract_connect_host(srv_t))
                                fl_t = f"{geo_t['flag']} " if (geo_t and geo_t.get("flag")) else ""
                                top_hint = f" · Топ: {fl_t}{p_t} мс"
                            break
                    BulletinHelper.show_success(f"Упорядочено ({mode_lbl}){top_hint}")
            elif not silent:
                BulletinHelper.show_error("Не удалось изменить порядок списка")
        except Exception as e:
            if not silent:
                BulletinHelper.show_error(f"Ошибка сортировки: {e}")

    def _sort_proxies_by_ping_inplace(self, PC: Any, silent: bool = False):
        if Looper.myLooper() == Looper.getMainLooper():
            self._sort_proxies_by_ping_now(PC, silent=silent)
        else:
            run_on_ui_thread(lambda: self._sort_proxies_by_ping_now(PC, silent=silent))

    def _save_proxies_native(
        self,
        proxies: List[ParsedProxy],
        source_key: Optional[str] = None,
        dialog_id: int = 0,
        max_msg_id: int = 0,
        manual: bool = False,
        bypass_dead_cache: bool = False,
        duplicate_posts: int = 0,
        account_id: Optional[int] = None,
    ):
        def ui():
            if not self._alive:
                return
            if account_id is not None and int(account_id) != int(UserConfig.selectedAccount):
                _plog("source save deferred: selected account changed")
                return
            try:
                _DETAILS_CACHE.clear()

                PC, ProxyInfo, PS = _get_cached_classes()
                max_per_host = self._get_max_per_host()
                now = time.time()

                existing_keys: Set[str] = set()
                host_counts: Dict[str, int] = {}
                remote_count = 0
                max_limit = self._get_max_proxy_limit()

                pl = PC.getProxyList()
                if pl is not None:
                    for i in range(int(pl.size())):
                        info = pl.get(i)
                        if info is not None:
                            k, _, srv, _, _, _, _ = _extract_proxy_details(info)
                            if k:
                                existing_keys.add(k)
                            if srv and not _is_local_host(srv):
                                remote_count += 1
                            h = _extract_connect_host(srv)
                            if h:
                                host_counts[h] = host_counts.get(h, 0) + 1

                added = 0
                dups = 0
                blacklisted = 0
                skipped = 0
                limit_blocked = 0
                counts = {"mtproto": 0, "socks5": 0, "web": 0}

                auto_dedup = bool(self.get_setting("auto_dedup", True))
                for p in proxies:
                    if auto_dedup and p.key in existing_keys:
                        dups += 1
                        continue

                    if not bypass_dead_cache and self._dead_cache.get(p.key, 0) > now:
                        blacklisted += 1
                        continue

                    h_only = p.host_only
                    if max_per_host > 0 and host_counts.get(h_only, 0) >= max_per_host:
                        skipped += 1
                        continue

                    if max_limit > 0 and remote_count >= max_limit:
                        freed = self._trim_dead_over_limit(PC, max_limit - 1)
                        if freed > 0:
                            remote_count = max(0, remote_count - freed)
                        if remote_count >= max_limit:
                            limit_blocked += 1
                            continue

                    try:
                        uri_str = p.to_uri()
                        ps = PS.fromUri(Uri.parse(uri_str))
                        if ps is None:
                            skipped += 1
                            continue

                        ps_key, _, _, _, _, _, _ = _extract_proxy_details(ps)
                        if auto_dedup and ps_key and ps_key in existing_keys:
                            dups += 1
                            continue

                        if PC.addProxy(ProxyInfo(ps)):
                            existing_keys.add(p.key)
                            if ps_key:
                                existing_keys.add(ps_key)
                            host_counts[h_only] = host_counts.get(h_only, 0) + 1
                            remote_count += 1
                            added += 1
                            counts[p.kind] = counts.get(p.kind, 0) + 1
                        else:
                            skipped += 1
                    except Exception:
                        skipped += 1

                if source_key:
                    with self._lock:
                        sources = self._get_sources(account_id)
                        if source_key in sources:
                            if max_msg_id > 0:
                                prev_max = int(sources[source_key].get("last_msg_id", 0) or 0)
                                if max_msg_id > prev_max:
                                    sources[source_key]["last_msg_id"] = int(max_msg_id)
                            sources[source_key]["added_count"] = (
                                int(sources[source_key].get("added_count", 0) or 0) + added
                            )
                            self._save_sources(sources, reload_ui=False, account_id=account_id)

                if (self.get_setting("mark_read_after_collect", False) and dialog_id != 0
                        and max_msg_id > 0 and (account_id is None or int(account_id) == int(UserConfig.selectedAccount))):
                    self._mark_dialog_read_safely(dialog_id, max_msg_id)

                if added > 0:
                    total_ever = int(self.get_setting("total_collected_count", 0) or 0) + added
                    self.set_setting("total_collected_count", total_ever, reload_settings=False)

                    try:
                        _persist_proxy_controller(PC)
                        pl_now = PC.getProxyList()
                        if pl_now is not None:
                            _sync_fragment_proxy_list(PC, [pl_now.get(i) for i in range(int(pl_now.size()))])
                    except Exception:
                        pass
                    self._refresh_settings_ui()
                    if self.get_setting("show_geo_flags", True) and self.get_setting("geo_remote_lookup", False):
                        self._prefetch_geo_for_all_proxies(manual=False)

                    if self.get_setting("show_bulletin", True):
                        parts = []
                        if counts["mtproto"]:
                            parts.append(f"MTProto: {counts['mtproto']}")
                        if counts["socks5"]:
                            parts.append(f"SOCKS5: {counts['socks5']}")
                        if counts["web"]:
                            parts.append(f"WEB: {counts['web']}")
                        suffix = f" ({', '.join(parts)})" if parts else ""
                        extra = ""
                        if manual and (dups or duplicate_posts):
                            extra = f" · уже были: {dups} · повторы в постах: {duplicate_posts}"
                        BulletinHelper.show_success(f"Добавлено прокси: {added}{suffix}{extra}")
                elif manual:
                    if dups > 0 or duplicate_posts > 0:
                        BulletinHelper.show_info(
                            f"Новых нет · уже в списке: {dups} · повторов в постах: {duplicate_posts}"
                        )
                    elif limit_blocked > 0:
                        BulletinHelper.show_info(f"Достигнут лимит списка ({max_limit} шт.)")
                    elif blacklisted > 0:
                        BulletinHelper.show_info(f"Пропущено мёртвых из кэша: {blacklisted}")
                    elif skipped > 0:
                        BulletinHelper.show_info(f"Пропущено по лимиту/формату: {skipped}")
                    else:
                        BulletinHelper.show_info("Новых прокси не найдено")

                if (
                    added > 0
                    and self.get_setting("auto_verify_new", True)
                    and not self._pinging
                    and not self._cleaning
                    and not self._is_vpn_ping_paused()
                ):
                    run_on_ui_thread(lambda: self.ping_all_proxies_async(force=False, manual=False), 300)

                if max_limit > 0:
                    self._enforce_proxy_limit(PC, max_limit)

            except Exception as e:
                if manual:
                    BulletinHelper.show_error(f"Ошибка сохранения: {e}")

        run_on_ui_thread(ui)

    def _trim_dead_over_limit(self, PC: Any, max_limit: int) -> int:
        removed = 0
        try:
            pl = PC.getProxyList()
            if pl is None:
                return 0
            remote_items = []
            for i in range(int(pl.size())):
                info = pl.get(i)
                if info is None:
                    continue
                k, _, srv, _, _, _, _ = _extract_proxy_details(info)
                if k and not _is_local_host(srv):
                    remote_items.append((k, info))
            if len(remote_items) <= max_limit:
                return 0
            active_key = _get_active_proxy_key(PC)
            dead_candidates: List[Tuple[int, str, Any]] = []
            for k, info in remote_items:
                if k == active_key:
                    continue
                c_entry = self._get_cached_ping(k)
                s_cnt = self._strikes.get(k, 0)
                if (c_entry is not None and not c_entry.get("alive", False)) or s_cnt > 0:
                    dead_candidates.append((s_cnt, k, info))

            dead_candidates.sort(key=lambda x: -x[0])
            excess = len(remote_items) - max_limit
            dead_ttl_sec = self._get_dead_ttl_hours() * 3600
            now_wall = time.time()
            for _, k, info in dead_candidates:
                if excess <= 0:
                    break
                if _delete_proxy_from_controller(PC, info):
                    removed += 1
                    excess -= 1
                    self._strikes.pop(k, None)
                    if dead_ttl_sec > 0:
                        self._dead_cache[k] = now_wall + dead_ttl_sec
            if removed > 0:
                self._save_dead_and_strikes()
                _persist_proxy_controller(PC)
                pl_now = PC.getProxyList()
                if pl_now is not None:
                    _sync_fragment_proxy_list(PC, [pl_now.get(i) for i in range(int(pl_now.size()))])
        except Exception as exc:
            _plog(f"trim dead over limit err: {exc}")
        return removed

    def _enforce_proxy_limit(self, PC: Any, max_limit: int) -> int:
        if max_limit <= 0:
            return 0
        removed = 0
        try:
            pl = PC.getProxyList()
            if pl is None:
                return 0
            remote_infos: List[Any] = []
            for i in range(int(pl.size())):
                info = pl.get(i)
                if info is None:
                    continue
                k, _, srv, _, _, _, _ = _extract_proxy_details(info)
                if k and not _is_local_host(srv):
                    remote_infos.append(info)
            if len(remote_infos) <= max_limit:
                return 0

            active_key = _get_active_proxy_key(PC)
            remote_infos.sort(key=self._build_proxy_sort_key(PC))
            overflow = remote_infos[max_limit:]
            dead_ttl_sec = self._get_dead_ttl_hours() * 3600
            now_wall = time.time()
            cache_dirty = False

            for info in overflow:
                k, _, _, _, _, _, _ = _extract_proxy_details(info)
                if k and k == active_key:
                    continue
                c_entry = self._get_cached_ping(k) if k else None
                is_dead = bool((c_entry is not None and not c_entry.get("alive", False)) or self._strikes.get(k, 0) > 0)
                if _delete_proxy_from_controller(PC, info):
                    removed += 1
                    if is_dead and k:
                        self._strikes.pop(k, None)
                        if dead_ttl_sec > 0:
                            self._dead_cache[k] = now_wall + dead_ttl_sec
                        cache_dirty = True

            if cache_dirty:
                self._save_dead_and_strikes()
            if removed > 0:
                _persist_proxy_controller(PC)
                pl_now = PC.getProxyList()
                if pl_now is not None:
                    _sync_fragment_proxy_list(PC, [pl_now.get(i) for i in range(int(pl_now.size()))])
        except Exception as exc:
            _plog(f"enforce proxy limit err: {exc}")
        return removed

    @staticmethod
    def _mark_dialog_read_safely(dialog_id: int, max_msg_id: int):
        try:
            acc = int(UserConfig.selectedAccount)
            mc = MessagesController.getInstance(acc)
            mc.markDialogAsRead(int(dialog_id), int(max_msg_id), int(max_msg_id), 0, False, 0, 0, True, 0)
        except Exception:
            pass

    def _refresh_settings_ui(self):
        def _ui():
            if not self._alive:
                return
            try:
                frag = get_last_fragment()
                if frag is None or "PluginSettingsActivity" not in str(frag.getClass().getName()):
                    return
                plugin_obj = get_private_field(frag, "plugin")
                if not plugin_obj or str(plugin_obj.getId()) != __id__:
                    return
                self.set_setting("enabled", bool(self.get_setting("enabled", True)), reload_settings=True)
            except Exception:
                pass

        run_on_ui_thread(_ui)

    def _schedule_cells_refresh(self, delay_ms: int = 50):
        if self._cells_refresh_scheduled:
            return
        self._cells_refresh_scheduled = True

        def _do():
            self._cells_refresh_scheduled = False
            self._refresh_visible_proxy_cells()

        run_on_ui_thread(_do, delay_ms)

    def _refresh_visible_proxy_cells(self, notify_adapter: bool = False):
        try:
            frag = get_last_fragment()
            if frag is None or "ProxyListActivity" not in str(frag.getClass().getName()):
                return
            lv = get_private_field(frag, "listView")
            if lv is not None:
                for i in range(int(lv.getChildCount())):
                    ch = lv.getChildAt(i)
                    if ch is not None and hasattr(ch, "updateStatus"):
                        try:
                            ch.updateStatus()
                        except Exception:
                            pass
            if notify_adapter:
                adapter = get_private_field(frag, "listAdapter")
                if adapter is not None:
                    adapter.notifyDataSetChanged()
            if self.get_setting("replace_native_ping", True):
                self._set_refresh_button_locked(frag, self._is_proxy_check_busy())
        except Exception:
            pass

    def ping_all_proxies_async(
        self,
        force: bool = True,
        manual: bool = True,
        purge_dead_now: bool = False,
    ):
        if not manual and self._is_vpn_ping_paused():
            return
        if self._pinging or self._cleaning:
            if manual:
                BulletinHelper.show_info("Проверка уже выполняется...")
            return

        self._pinging = True
        self._cleaning = True
        self._force_ping_active = force
        self._ping_done_count = 0
        self._ping_total_count = 0
        if Looper.myLooper() == Looper.getMainLooper():
            self._set_refresh_button_locked(get_last_fragment(), True)

        def _reset_busy_and_unlock():
            self._checking_keys.clear()
            self._ping_done_count = 0
            self._ping_total_count = 0
            self._force_ping_active = False
            self._cleaning = False
            self._pinging = False
            self._set_refresh_button_locked(get_last_fragment(), False)

        def _start_on_ui():
            try:
                self._set_refresh_button_locked(get_last_fragment(), True)
                removed_dups = self.deduplicate_existing_proxies_ui(show_toast_if_zero=False) if manual else 0
                PC, _, _ = _get_cached_classes()
                pl = PC.getProxyList()
                if pl is None or int(pl.size()) == 0:
                    _reset_busy_and_unlock()
                    if manual:
                        BulletinHelper.show_info("Список прокси пуст")
                    return

                active_key = _get_active_proxy_key(PC)
                targets: List[Tuple[str, str, str, int, str, str, str, Any]] = []
                seen_keys: Set[str] = set()

                for i in range(int(pl.size())):
                    info = pl.get(i)
                    if info is None:
                        continue
                    k, kind, srv, port, sec, user, pwd = _extract_proxy_details(info)
                    if not k or _is_local_host(srv) or k in seen_keys:
                        continue
                    seen_keys.add(k)

                    if not force:
                        cached_c = self._hydrate_proxy_info(info)
                        if cached_c is not None:
                            continue

                    targets.append((k, kind, srv, port, sec, user, pwd, info))

                if not targets:
                    _reset_busy_and_unlock()
                    self._refresh_visible_proxy_cells()
                    if purge_dead_now:
                        self.purge_dead_proxies_ui(allow_auto_scan=False)
                    elif manual:
                        BulletinHelper.show_info("Все прокси уже в свежем кэше пинга")
                    return

                self._ping_done_count = 0
                self._ping_total_count = len(targets)
                for (k, _, _, _, _, _, _, info) in targets:
                    self._checking_keys.add(k)
                    try:
                        info.checking = True
                    except Exception:
                        pass

                self._set_refresh_button_locked(get_last_fragment(), True)
                self._refresh_visible_proxy_cells(notify_adapter=False)
                if manual:
                    if self._is_vpn_ping_paused():
                        BulletinHelper.show_info(f"Включён VPN · пинг ({len(targets)}) может быть неточным")
                    else:
                        label = "Проверяю и очищаю" if purge_dead_now else "Проверяю пинг"
                        BulletinHelper.show_info(f"{label} ({len(targets)} прокси)...")

                threading.Thread(
                    target=_worker_bg,
                    args=(targets, active_key, removed_dups),
                    daemon=True,
                ).start()
            except Exception as exc:
                _plog(f"ping start err: {exc}")
                _reset_busy_and_unlock()

        def _worker_bg(
            targets: List[Tuple[str, str, str, int, str, str, str, Any]],
            active_key: str,
            removed_dups: int,
        ):
            t_batch_start = time.monotonic()
            dead_keys: Set[str] = set()
            alive_pings: Dict[str, int] = {}
            res_lock = threading.Lock()
            ui_push_state = [time.monotonic()]

            def _maybe_push_ui():
                now_m = time.monotonic()
                if (now_m - ui_push_state[0]) >= 0.22:
                    ui_push_state[0] = now_m
                    run_on_ui_thread(self._refresh_visible_proxy_cells)

            def _check_one_proxy(item: Tuple[str, str, str, int, str, str, str, Any]):
                k, kind, srv, port, sec, user, pwd, info = item
                if not self._alive:
                    self._checking_keys.discard(k)
                    return

                try:
                    ping_ms = _check_proxy_alive(kind, srv, port, sec, user, pwd, True, 3.0)
                except Exception:
                    ping_ms = None

                self._set_cached_ping(k, ping_ms, save_now=False)
                with res_lock:
                    self._ping_done_count += 1
                    if ping_ms is not None and ping_ms > 0:
                        alive_pings[k] = int(ping_ms)
                    else:
                        dead_keys.add(k)

                self._checking_keys.discard(k)

                def _apply_step(inf=info, p_val=ping_ms):
                    try:
                        inf.checking = False
                        inf.available = p_val is not None and int(p_val) > 0
                        inf.ping = int(p_val) if inf.available else 0
                        inf.availableCheckTime = _elapsed_ms()
                    except Exception:
                        pass

                run_on_ui_thread(_apply_step)
                _maybe_push_ui()

            try:
                with ThreadPoolExecutor(max_workers=16) as pool:
                    list(pool.map(_check_one_proxy, targets))

                elapsed_batch = time.monotonic() - t_batch_start
                if manual and elapsed_batch < 0.45:
                    time.sleep(0.45 - elapsed_batch)
                self._save_ping_cache()

                def _finish_ui():
                    if not self._alive:
                        return
                    try:
                        PC, _, _ = _get_cached_classes()
                        pl = PC.getProxyList()
                        if pl is None:
                            return

                        total_checked = len(targets)
                        mass_outage = (
                            self._is_vpn_ping_paused()
                            or (
                                not manual
                                and total_checked >= 4
                                and len(dead_keys) > (total_checked * 0.5)
                            )
                        )

                        max_limit = self._get_max_proxy_limit()
                        do_failover = bool(self.get_setting("auto_failover", True))
                        auto_sort = bool(self.get_setting("auto_sort_after_check", True))
                        auto_del_dead = bool(self.get_setting("auto_delete_dead_on_check", False))
                        strikes_needed = self._get_strike_limit()
                        dead_ttl_sec = self._get_dead_ttl_hours() * 3600

                        to_delete_dead: List[Tuple[str, Any]] = []
                        alive_objects: List[Tuple[int, str, Any]] = []
                        now_rt = _elapsed_ms()
                        now_wall = time.time()
                        cache_dirty = False
                        cur_active = active_key

                        for i in range(int(pl.size())):
                            info = pl.get(i)
                            if info is None:
                                continue
                            k, _, srv, _, _, _, _ = _extract_proxy_details(info)
                            if not k or _is_local_host(srv):
                                continue

                            if k in dead_keys and not mass_outage:
                                try:
                                    info.available = False
                                    info.ping = 0
                                    info.availableCheckTime = now_rt
                                except Exception:
                                    pass
                                cur_strikes = self._strikes.get(k, 0) + 1
                                self._strikes[k] = cur_strikes
                                cache_dirty = True
                                should_remove = purge_dead_now or (
                                    auto_del_dead and cur_strikes >= strikes_needed
                                )
                                if should_remove and k != cur_active:
                                    to_delete_dead.append((k, info))
                            elif k in alive_pings:
                                p_ms = alive_pings[k]
                                if self._strikes.pop(k, None) is not None:
                                    cache_dirty = True
                                if self._dead_cache.pop(k, None) is not None:
                                    cache_dirty = True
                                try:
                                    info.ping = int(p_ms)
                                    info.available = True
                                    info.availableCheckTime = now_rt
                                except Exception:
                                    pass
                                alive_objects.append((p_ms, k, info))
                            else:
                                av_old, p_old = _get_proxy_ping_and_avail(info)
                                if av_old and p_old > 0:
                                    alive_objects.append((p_old, k, info))

                        alive_objects.sort(key=lambda x: x[0])

                        switched_msg = ""
                        if (
                            do_failover
                            and cur_active
                            and cur_active in dead_keys
                            and not mass_outage
                            and _is_proxy_enabled_in_client()
                            and alive_objects
                        ):
                            best_ping, best_key, best_info = alive_objects[0]
                            if _activate_proxy_info(PC, best_info):
                                if purge_dead_now or (
                                    auto_del_dead and self._strikes.get(cur_active, 0) >= strikes_needed
                                ):
                                    for i in range(int(pl.size())):
                                        old_inf = pl.get(i)
                                        ok_k, _, _, _, _, _, _ = _extract_proxy_details(old_inf)
                                        if ok_k == cur_active:
                                            to_delete_dead.append((cur_active, old_inf))
                                            break
                                cur_active = best_key
                                switched_msg = f" · Failover → {best_ping} мс"

                        deleted_dead = 0
                        for k, info in to_delete_dead:
                            if k == cur_active:
                                continue
                            if _delete_proxy_from_controller(PC, info):
                                deleted_dead += 1
                                self._strikes.pop(k, None)
                                if dead_ttl_sec > 0:
                                    self._dead_cache[k] = now_wall + dead_ttl_sec
                                cache_dirty = True

                        if cache_dirty:
                            self._save_dead_and_strikes()

                        if max_limit > 0:
                            deleted_dead += self._enforce_proxy_limit(PC, max_limit)

                        if auto_sort:
                            self._sort_proxies_by_ping_now(PC, silent=True)
                        else:
                            _persist_proxy_controller(PC)

                        _reset_busy_and_unlock()
                        self._refresh_visible_proxy_cells(notify_adapter=True)
                        self._refresh_settings_ui()

                        total_removed = deleted_dead + removed_dups
                        if manual or switched_msg or (total_removed > 0 and self.get_setting("show_bulletin", True)):
                            best_ms = alive_objects[0][0] if alive_objects else 0
                            alive_cnt = len(alive_pings)
                            dead_cnt = len(dead_keys)
                            if total_removed > 0:
                                parts = []
                                if deleted_dead > 0:
                                    parts.append(f"мёртвых: {deleted_dead}")
                                if removed_dups > 0:
                                    parts.append(f"дублей: {removed_dups}")
                                head = f"Раб.: {alive_cnt} ({best_ms} мс) · " if alive_cnt > 0 else ""
                                BulletinHelper.show_success(
                                    f"{head}Удалено ({', '.join(parts)}){switched_msg}"
                                )
                            elif manual:
                                if alive_cnt > 0:
                                    extra = f" · недоступно: {dead_cnt}" if dead_cnt > 0 else ""
                                    BulletinHelper.show_success(
                                        f"Рабочих: {alive_cnt} (лучший: {best_ms} мс){extra}{switched_msg}"
                                    )
                                else:
                                    BulletinHelper.show_info(
                                        f"Рабочих не найдено ({dead_cnt} недоступно)"
                                    )
                    except Exception as e:
                        _plog(f"finish ping ui err: {e}")
                    finally:
                        _reset_busy_and_unlock()

                run_on_ui_thread(_finish_ui)
            except Exception as exc:
                _plog(f"ping worker err: {exc}")
                for (k, _, _, _, _, _, _, info) in targets:
                    self._checking_keys.discard(k)
                    try:
                        info.checking = False
                    except Exception:
                        pass
                run_on_ui_thread(_reset_busy_and_unlock)

        if Looper.myLooper() == Looper.getMainLooper():
            _start_on_ui()
        else:
            run_on_ui_thread(_start_on_ui)

    def purge_dead_proxies_ui(self, allow_auto_scan: bool = True):
        if self._pinging or self._cleaning:
            BulletinHelper.show_info("Проверка уже выполняется...")
            return

        def _ui():
            try:
                removed_dups = self.deduplicate_existing_proxies_ui(show_toast_if_zero=False)
                PC, _, _ = _get_cached_classes()
                pl = PC.getProxyList()
                if pl is None or int(pl.size()) == 0:
                    BulletinHelper.show_info("Список прокси пуст")
                    return

                active_key = _get_active_proxy_key(PC)
                dead_ttl_sec = self._get_dead_ttl_hours() * 3600
                now_wall = time.time()

                to_remove: List[Tuple[str, Any]] = []
                has_any_checked = False

                for i in range(int(pl.size())):
                    info = pl.get(i)
                    if info is None:
                        continue
                    k, _, srv, _, _, _, _ = _extract_proxy_details(info)
                    if not k or _is_local_host(srv):
                        continue

                    cached = self._get_cached_ping(k)
                    strikes = self._strikes.get(k, 0)
                    av, ping_ms = _get_proxy_ping_and_avail(info)

                    if cached is not None or strikes > 0 or (av and ping_ms > 0):
                        has_any_checked = True

                    is_known_dead = (cached is not None and not cached.get("alive", False)) or strikes > 0
                    if is_known_dead and k != active_key:
                        to_remove.append((k, info))

                if to_remove:
                    deleted = 0
                    for k, info in to_remove:
                        if _delete_proxy_from_controller(PC, info):
                            deleted += 1
                            self._strikes.pop(k, None)
                            if dead_ttl_sec > 0:
                                self._dead_cache[k] = now_wall + dead_ttl_sec
                    self._save_dead_and_strikes()
                    _persist_proxy_controller(PC)
                    pl_now = PC.getProxyList()
                    rem = int(pl_now.size()) if pl_now is not None else 0
                    if pl_now is not None:
                        _sync_fragment_proxy_list(PC, [pl_now.get(i) for i in range(rem)])
                    self._refresh_settings_ui()
                    dup_str = f", дублей: {removed_dups}" if removed_dups > 0 else ""
                    BulletinHelper.show_success(f"Удалено мёртвых: {deleted}{dup_str} · Осталось: {rem}")
                    return

                if allow_auto_scan:
                    self.ping_all_proxies_async(force=not has_any_checked, manual=True, purge_dead_now=True)
                else:
                    BulletinHelper.show_success(f"Все прокси рабочие ({int(pl.size())} шт.)")
            except Exception as exc:
                _plog(f"purge dead err: {exc}")

        run_on_ui_thread(_ui)

    def _open_sort_mode_sheet(self, act: Any = None):
        if act is None:
            frag = get_last_fragment()
            act = frag.getParentActivity() if frag else None
        if act is None:
            return
        cur_mode = self._get_sort_mode()
        actions: List[Tuple[str, str, Callable[[], None], bool]] = []
        for m_key, m_label in SORT_MODES:
            mark = "✓ " if m_key == cur_mode else ""
            actions.append(
                (f"{mark}{m_label}", "", lambda mk=m_key: self._set_sort_mode(mk, sort_now=True), False)
            )
        _show_action_sheet(
            act,
            "Режим упорядочивания",
            actions,
        )

    def _run_header_tool_action(self, tool_key: str, act: Any):
        if tool_key == "collect":
            self._scan_sources_async(manual=True)
        elif tool_key == "random":
            self._connect_random_working_proxy()
        elif tool_key == "import":
            self._open_import_sheet(act)
        elif tool_key == "export":
            self._open_export_sheet(act)
        elif tool_key == "sort":
            self._sort_proxies_by_ping_inplace(_get_cached_classes()[0], silent=False)
        elif tool_key == "sort_mode":
            self._open_sort_mode_sheet(act)
        elif tool_key == "country":
            self._open_country_filter_sheet(act)
        elif tool_key == "dedup":
            self.deduplicate_existing_proxies_ui(show_toast_if_zero=True)
        elif tool_key == "clean":
            self.purge_dead_proxies_ui(allow_auto_scan=True)

    def _open_proxy_screen_tools(self, fragment: Any):
        act = fragment.getParentActivity() if fragment else None
        if act is None:
            return

        order, disabled = self._get_header_tools_config()
        actions: List[Tuple[str, str, Callable[[], None], bool]] = []
        cur_sort_short = SORT_MODE_LABELS.get(self._get_sort_mode(), "Умная").split("(", 1)[0].strip()

        for key in order:
            if key in disabled or key not in HEADER_TOOLS_META:
                continue
            label, ico, is_red = HEADER_TOOLS_META[key]
            if key == "sort":
                label = f"Упорядочить ({cur_sort_short})"
            actions.append(
                (label, ico, lambda k=key, a=act: self._run_header_tool_action(k, a), is_red)
            )

        show_edit_btn = bool(self.get_setting("show_edit_menu_btn", True))
        if show_edit_btn or not actions:
            actions.append(
                ("Настроить это меню", "msg_settings", lambda a=act: self._open_header_tools_editor_sheet(a), False)
            )

        _show_action_sheet(act, "Инструменты прокси", actions)

    def _open_header_tools_editor_sheet(self, act: Any = None):
        if act is None:
            frag = get_last_fragment()
            act = frag.getParentActivity() if frag else None
        if act is None:
            return

        def ui():
            try:
                sheet = BottomSheet(act, False)
                sheet.setApplyBottomPadding(False)
                sheet.setApplyTopPadding(False)

                root = LinearLayout(act)
                root.setOrientation(LinearLayout.VERTICAL)
                root.setPadding(
                    AndroidUtilities.dp(18),
                    AndroidUtilities.dp(10),
                    AndroidUtilities.dp(18),
                    AndroidUtilities.dp(16),
                )
                bg = GradientDrawable()
                bg.setCornerRadii([
                    AndroidUtilities.dp(20), AndroidUtilities.dp(20),
                    AndroidUtilities.dp(20), AndroidUtilities.dp(20),
                    0, 0, 0, 0,
                ])
                bg.setColor(Theme.getColor(Theme.key_dialogBackground))
                root.setBackground(bg)

                pill = View(act)
                pill_bg = GradientDrawable()
                pill_bg.setCornerRadius(AndroidUtilities.dp(2))
                pill_bg.setColor(0x40808080)
                pill.setBackground(pill_bg)
                root.addView(pill, LayoutHelper.createLinear(36, 4, Gravity.CENTER_HORIZONTAL, 0, 0, 0, 12))

                tv_title = TextView(act)
                tv_title.setText("Меню в шапке прокси")
                tv_title.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 19)
                tv_title.setTypeface(AndroidUtilities.getTypeface("fonts/rmedium.ttf"))
                tv_title.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
                tv_title.setGravity(Gravity.CENTER)
                root.addView(tv_title, LayoutHelper.createLinear(-1, -2, Gravity.CENTER, 0, 0, 0, 4))

                tv_hint = TextView(act)
                tv_hint.setText("Нажмите — скрыть или вернуть · Зажмите ≡ — перетащить")
                tv_hint.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13)
                tv_hint.setTextColor(Theme.getColor(Theme.key_dialogTextGray3))
                tv_hint.setGravity(Gravity.CENTER)
                root.addView(tv_hint, LayoutHelper.createLinear(-1, -2, Gravity.CENTER, 4, 0, 4, 14))

                scroll = ScrollView(act)
                scroll.setVerticalScrollBarEnabled(False)

                scroll_body = LinearLayout(act)
                scroll_body.setOrientation(LinearLayout.VERTICAL)

                lbl_active = TextView(act)
                lbl_active.setText("В МЕНЮ ШАПКИ")
                lbl_active.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 12)
                lbl_active.setTypeface(AndroidUtilities.getTypeface("fonts/rmedium.ttf"))
                lbl_active.setTextColor(Theme.getColor(Theme.key_dialogTextBlue))
                scroll_body.addView(lbl_active, LayoutHelper.createLinear(-1, -2, 6, 0, 0, 6))

                active_card = LinearLayout(act)
                active_card.setOrientation(LinearLayout.VERTICAL)
                active_card.setPadding(
                    AndroidUtilities.dp(8),
                    AndroidUtilities.dp(8),
                    AndroidUtilities.dp(8),
                    AndroidUtilities.dp(8),
                )
                ac_bg = GradientDrawable()
                ac_bg.setCornerRadius(AndroidUtilities.dp(16))
                try:
                    ac_bg.setColor(Theme.getColor(Theme.key_windowBackgroundGray))
                except Exception:
                    ac_bg.setColor(0x18808080)
                active_card.setBackground(ac_bg)
                scroll_body.addView(active_card, LayoutHelper.createLinear(-1, -2, 0, 0, 0, 14))

                lbl_hidden = TextView(act)
                lbl_hidden.setText("СКРЫТЫЕ ПУНКТЫ")
                lbl_hidden.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 12)
                lbl_hidden.setTypeface(AndroidUtilities.getTypeface("fonts/rmedium.ttf"))
                lbl_hidden.setTextColor(Theme.getColor(Theme.key_dialogTextGray3))
                scroll_body.addView(lbl_hidden, LayoutHelper.createLinear(-1, -2, 6, 0, 0, 6))

                hidden_card = LinearLayout(act)
                hidden_card.setOrientation(LinearLayout.VERTICAL)
                hidden_card.setPadding(
                    AndroidUtilities.dp(8),
                    AndroidUtilities.dp(8),
                    AndroidUtilities.dp(8),
                    AndroidUtilities.dp(8),
                )
                hc_bg = GradientDrawable()
                hc_bg.setCornerRadius(AndroidUtilities.dp(16))
                try:
                    hc_bg.setColor(Theme.getColor(Theme.key_windowBackgroundGray))
                except Exception:
                    hc_bg.setColor(0x18808080)
                hidden_card.setBackground(hc_bg)
                scroll_body.addView(hidden_card, LayoutHelper.createLinear(-1, -2, 0, 0, 0, 12))

                edit_btn_toggle_row = FrameLayout(act)
                edit_btn_toggle_row.setPadding(
                    AndroidUtilities.dp(14),
                    AndroidUtilities.dp(12),
                    AndroidUtilities.dp(14),
                    AndroidUtilities.dp(12),
                )
                et_bg = GradientDrawable()
                et_bg.setCornerRadius(AndroidUtilities.dp(14))
                try:
                    et_bg.setColor(Theme.getColor(Theme.key_windowBackgroundGray))
                except Exception:
                    et_bg.setColor(0x18808080)
                edit_btn_toggle_row.setBackground(et_bg)

                et_inner = LinearLayout(act)
                et_inner.setOrientation(LinearLayout.HORIZONTAL)
                et_inner.setGravity(Gravity.CENTER_VERTICAL)

                et_tv = TextView(act)
                et_tv.setText("Кнопка «Настроить это меню»")
                et_tv.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 14)
                et_tv.setTypeface(AndroidUtilities.getTypeface("fonts/rmedium.ttf"))
                et_tv.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
                et_inner.addView(et_tv, LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1.0))

                et_state_tv = TextView(act)
                et_state_tv.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13)
                et_state_tv.setTypeface(AndroidUtilities.getTypeface("fonts/rmedium.ttf"))
                et_inner.addView(et_state_tv, LayoutHelper.createLinear(-2, -2, Gravity.CENTER_VERTICAL))

                edit_btn_toggle_row.addView(et_inner, FrameLayout.LayoutParams(-1, -2))
                edit_btn_toggle_row.setClickable(True)

                def refresh_edit_btn_toggle():
                    on = bool(self.get_setting("show_edit_menu_btn", True))
                    et_state_tv.setText("Показана" if on else "Скрыта")
                    et_state_tv.setTextColor(
                        Theme.getColor(Theme.key_dialogTextBlue)
                        if on
                        else Theme.getColor(Theme.key_dialogTextGray3)
                    )

                def toggle_edit_btn(_v):
                    cur = bool(self.get_setting("show_edit_menu_btn", True))
                    self.set_setting("show_edit_menu_btn", not cur, reload_settings=False)
                    refresh_edit_btn_toggle()

                refresh_edit_btn_toggle()
                _set_view_click(edit_btn_toggle_row, OnClickListener(toggle_edit_btn))
                _apply_press_scale(edit_btn_toggle_row, 0.98)
                scroll_body.addView(edit_btn_toggle_row, LayoutHelper.createLinear(-1, -2, 0, 0, 0, 6))

                scroll.addView(scroll_body)
                root.addView(scroll, LayoutHelper.createLinear(-1, 0, 1.0))

                bottom_row = LinearLayout(act)
                bottom_row.setOrientation(LinearLayout.HORIZONTAL)

                btn_reset = TextView(act)
                btn_reset.setText("Сбросить")
                btn_reset.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 15)
                btn_reset.setTypeface(AndroidUtilities.getTypeface("fonts/rmedium.ttf"))
                btn_reset.setGravity(Gravity.CENTER)
                btn_reset.setTextColor(Theme.getColor(Theme.key_dialogTextBlue))
                btn_reset.setPadding(0, AndroidUtilities.dp(13), 0, AndroidUtilities.dp(13))
                r_bg = GradientDrawable()
                r_bg.setCornerRadius(AndroidUtilities.dp(14))
                try:
                    r_bg.setColor(Theme.getColor(Theme.key_windowBackgroundGray))
                except Exception:
                    r_bg.setColor(0x20808080)
                btn_reset.setBackground(r_bg)
                btn_reset.setClickable(True)
                _apply_press_scale(btn_reset, 0.97)
                bottom_row.addView(btn_reset, LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1.0))

                bottom_row.addView(View(act), LayoutHelper.createLinear(10, 1))

                btn_done = TextView(act)
                btn_done.setText("Готово")
                btn_done.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 15)
                btn_done.setTypeface(AndroidUtilities.getTypeface("fonts/rmedium.ttf"))
                btn_done.setGravity(Gravity.CENTER)
                btn_done.setTextColor(Theme.getColor(Theme.key_featuredStickers_buttonText))
                btn_done.setPadding(0, AndroidUtilities.dp(13), 0, AndroidUtilities.dp(13))
                d_bg = GradientDrawable()
                d_bg.setCornerRadius(AndroidUtilities.dp(14))
                d_bg.setColor(Theme.getColor(Theme.key_featuredStickers_addButton))
                btn_done.setBackground(d_bg)
                btn_done.setClickable(True)
                _set_view_click(btn_done, OnClickListener(lambda _v: sheet.dismiss()))
                _apply_press_scale(btn_done, 0.97)
                bottom_row.addView(btn_done, LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1.4))

                root.addView(bottom_row, LayoutHelper.createLinear(-1, -2, 0, 12, 0, 0))

                init_order, init_disabled = self._get_header_tools_config()
                state = {
                    "active": [k for k in init_order if k not in init_disabled],
                    "hidden": [k for k in init_order if k in init_disabled],
                }
                handler = Handler(Looper.getMainLooper())
                touch_slop = ViewConfiguration.get(act).getScaledTouchSlop()
                row_gap = AndroidUtilities.dp(6)

                def persist_state():
                    full_order = list(state["active"]) + list(state["hidden"])
                    self._save_header_tools_config(full_order, set(state["hidden"]), reload_ui=False)

                def make_empty_placeholder(text: str):
                    tv_emp = TextView(act)
                    tv_emp.setText(text)
                    tv_emp.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13)
                    tv_emp.setTextColor(Theme.getColor(Theme.key_dialogTextGray3))
                    tv_emp.setGravity(Gravity.CENTER)
                    tv_emp.setPadding(0, AndroidUtilities.dp(12), 0, AndroidUtilities.dp(12))
                    return tv_emp

                def rebuild_lists():
                    active_card.removeAllViews()
                    hidden_card.removeAllViews()

                    active_rows: List[Any] = []

                    if not state["active"]:
                        active_card.addView(make_empty_placeholder("Нет активных пунктов — нажмите на скрытый ниже"))
                    else:
                        for idx, key in enumerate(state["active"]):
                            label, ico_name, is_red = HEADER_TOOLS_META[key]
                            row = FrameLayout(act)
                            row.setPadding(
                                AndroidUtilities.dp(14),
                                AndroidUtilities.dp(11),
                                AndroidUtilities.dp(10),
                                AndroidUtilities.dp(11),
                            )
                            r_bg = GradientDrawable()
                            r_bg.setCornerRadius(AndroidUtilities.dp(12))
                            r_bg.setColor(Theme.getColor(Theme.key_dialogBackground))
                            row.setBackground(r_bg)

                            inner = LinearLayout(act)
                            inner.setOrientation(LinearLayout.HORIZONTAL)
                            inner.setGravity(Gravity.CENTER_VERTICAL)

                            acc_col = (
                                Theme.getColor(Theme.key_text_RedRegular)
                                if is_red
                                else Theme.getColor(Theme.key_dialogTextBlue)
                            )
                            txt_col = (
                                Theme.getColor(Theme.key_text_RedRegular)
                                if is_red
                                else Theme.getColor(Theme.key_dialogTextBlack)
                            )

                            ico_res = _resolve_action_icon(ico_name)
                            if ico_res:
                                iv = ImageView(act)
                                iv.setImageResource(ico_res)
                                iv.setScaleType(ImageView.ScaleType.CENTER)
                                iv.setColorFilter(acc_col)
                                inner.addView(iv, LayoutHelper.createLinear(24, 24, Gravity.CENTER_VERTICAL, 0, 0, 12, 0))

                            tv = TextView(act)
                            tv.setText(label)
                            tv.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 15)
                            tv.setTextColor(txt_col)
                            tv.setTypeface(AndroidUtilities.getTypeface("fonts/rmedium.ttf"))
                            inner.addView(tv, LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1.0))

                            drag_ico = _get_drawable_res("list_reorder", _get_drawable_res("msg_list", 0))
                            if drag_ico:
                                iv_drag = ImageView(act)
                                iv_drag.setImageResource(drag_ico)
                                iv_drag.setScaleType(ImageView.ScaleType.CENTER)
                                iv_drag.setColorFilter(Theme.getColor(Theme.key_dialogTextGray3))
                                inner.addView(iv_drag, LayoutHelper.createLinear(32, 24, Gravity.CENTER_VERTICAL, 6, 0, 2, 0))

                            row.addView(inner, FrameLayout.LayoutParams(-1, -2))
                            active_rows.append(row)
                            active_card.addView(
                                row,
                                LayoutHelper.createLinear(-1, -2, 0, 0 if idx == 0 else 6, 0, 0),
                            )

                    for row_idx, row_view in enumerate(active_rows):
                        item_key = state["active"][row_idx]

                        class _DragOrTapListener(dynamic_proxy(View.OnTouchListener)):
                            def __init__(self, r_idx: int, r_v: Any, k_str: str):
                                super().__init__()
                                self.r_idx = r_idx
                                self.r_v = r_v
                                self.k_str = k_str
                                self.start_raw_y = 0.0
                                self.dragging = False
                                self.moved_far = False
                                self.target_idx = r_idx
                                self.last_offsets: Dict[int, float] = {}
                                self.lp_cb = None

                            def _begin_drag(self):
                                if self.dragging:
                                    return
                                self.dragging = True
                                try:
                                    scroll.requestDisallowInterceptTouchEvent(True)
                                except Exception:
                                    pass
                                try:
                                    self.r_v.performHapticFeedback(HapticFeedbackConstants.LONG_PRESS)
                                except Exception:
                                    pass
                                try:
                                    self.r_v.setTranslationZ(float(AndroidUtilities.dp(8)))
                                    self.r_v.animate().scaleX(1.03).scaleY(1.03).alpha(0.95).setDuration(110).start()
                                except Exception:
                                    pass

                            def _cancel_lp(self):
                                if self.lp_cb is not None:
                                    try:
                                        handler.removeCallbacks(self.lp_cb)
                                    except Exception:
                                        pass
                                    self.lp_cb = None

                            def onTouch(self, v, event):
                                act_code = event.getActionMasked()
                                if act_code == MotionEvent.ACTION_DOWN:
                                    self.start_raw_y = float(event.getRawY())
                                    self.dragging = False
                                    self.moved_far = False
                                    self.target_idx = self.r_idx
                                    self.last_offsets.clear()

                                    w = float(self.r_v.getWidth() or 0)
                                    x = float(event.getX() or 0)
                                    if w > 0 and x >= (w - float(AndroidUtilities.dp(54))):
                                        self._begin_drag()
                                    else:
                                        self.r_v.animate().scaleX(0.97).scaleY(0.97).setDuration(90).start()

                                        class _LPRun(dynamic_proxy(Runnable)):
                                            def run(self_r):
                                                if not self.moved_far:
                                                    self._begin_drag()

                                        self.lp_cb = _LPRun()
                                        handler.postDelayed(self.lp_cb, 230)
                                    return True

                                elif act_code == MotionEvent.ACTION_MOVE:
                                    dy = float(event.getRawY()) - self.start_raw_y
                                    if not self.dragging:
                                        if abs(dy) > touch_slop:
                                            self.moved_far = True
                                            self._cancel_lp()
                                            self.r_v.animate().scaleX(1.0).scaleY(1.0).setDuration(100).start()
                                            return False
                                        return True

                                    self.r_v.setTranslationY(dy)
                                    step = float((self.r_v.getHeight() or AndroidUtilities.dp(46)) + row_gap)
                                    shift = int(round(dy / max(1.0, step)))
                                    new_t = max(0, min(len(active_rows) - 1, self.r_idx + shift))
                                    self.target_idx = new_t

                                    for j, other_v in enumerate(active_rows):
                                        if j == self.r_idx:
                                            continue
                                        if self.r_idx < j <= new_t:
                                            off = -step
                                        elif new_t <= j < self.r_idx:
                                            off = step
                                        else:
                                            off = 0.0
                                        if self.last_offsets.get(j, 0.0) != off:
                                            self.last_offsets[j] = off
                                            other_v.animate().translationY(off).setDuration(130).start()
                                    return True

                                elif act_code in (MotionEvent.ACTION_UP, MotionEvent.ACTION_CANCEL):
                                    self._cancel_lp()
                                    try:
                                        scroll.requestDisallowInterceptTouchEvent(False)
                                    except Exception:
                                        pass

                                    if self.dragging:
                                        self.dragging = False
                                        try:
                                            self.r_v.setTranslationZ(0.0)
                                        except Exception:
                                            pass
                                        if self.target_idx != self.r_idx and 0 <= self.r_idx < len(state["active"]):
                                            moved_k = state["active"].pop(self.r_idx)
                                            state["active"].insert(self.target_idx, moved_k)
                                            persist_state()
                                        rebuild_lists()
                                        return True

                                    self.r_v.animate().scaleX(1.0).scaleY(1.0).setDuration(120).start()
                                    if act_code == MotionEvent.ACTION_UP and not self.moved_far:
                                        if self.k_str in state["active"]:
                                            state["active"].remove(self.k_str)
                                            if self.k_str not in state["hidden"]:
                                                state["hidden"].append(self.k_str)
                                            persist_state()
                                            rebuild_lists()
                                    return True

                                return False

                        row_view.setOnTouchListener(
                            _retain_view_listener(row_view, _DragOrTapListener(row_idx, row_view, item_key))
                        )

                    if not state["hidden"]:
                        hidden_card.addView(make_empty_placeholder("Все пункты отображаются в меню"))
                    else:
                        for h_idx, h_key in enumerate(state["hidden"]):
                            label, ico_name, _ = HEADER_TOOLS_META[h_key]
                            h_row = FrameLayout(act)
                            h_row.setPadding(
                                AndroidUtilities.dp(14),
                                AndroidUtilities.dp(11),
                                AndroidUtilities.dp(14),
                                AndroidUtilities.dp(11),
                            )
                            dlg_bg_h = Theme.getColor(Theme.key_dialogBackground)
                            try:
                                pressed_bg_h = Theme.getColor(Theme.key_listSelector)
                            except Exception:
                                pressed_bg_h = 0x20808080
                            try:
                                h_row.setBackground(
                                    Theme.createSimpleSelectorRoundRectDrawable(
                                        AndroidUtilities.dp(12), dlg_bg_h, pressed_bg_h
                                    )
                                )
                            except Exception:
                                hr_bg = GradientDrawable()
                                hr_bg.setCornerRadius(AndroidUtilities.dp(12))
                                hr_bg.setColor(dlg_bg_h)
                                h_row.setBackground(hr_bg)

                            h_inner = LinearLayout(act)
                            h_inner.setOrientation(LinearLayout.HORIZONTAL)
                            h_inner.setGravity(Gravity.CENTER_VERTICAL)

                            ico_res = _resolve_action_icon(ico_name)
                            if ico_res:
                                iv = ImageView(act)
                                iv.setImageResource(ico_res)
                                iv.setScaleType(ImageView.ScaleType.CENTER)
                                iv.setColorFilter(Theme.getColor(Theme.key_dialogTextGray3))
                                h_inner.addView(iv, LayoutHelper.createLinear(24, 24, Gravity.CENTER_VERTICAL, 0, 0, 12, 0))

                            tv = TextView(act)
                            tv.setText(label)
                            tv.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 15)
                            tv.setTextColor(Theme.getColor(Theme.key_dialogTextGray))
                            h_inner.addView(tv, LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1.0))

                            plus_ico = _get_drawable_res("msg_add", 0)
                            if plus_ico:
                                iv_p = ImageView(act)
                                iv_p.setImageResource(plus_ico)
                                iv_p.setScaleType(ImageView.ScaleType.CENTER)
                                iv_p.setColorFilter(Theme.getColor(Theme.key_dialogTextBlue))
                                h_inner.addView(iv_p, LayoutHelper.createLinear(24, 24, Gravity.CENTER_VERTICAL, 6, 0, 0, 0))

                            h_row.addView(h_inner, FrameLayout.LayoutParams(-1, -2))
                            h_row.setClickable(True)

                            def restore_item(_v, rk=h_key):
                                if rk in state["hidden"]:
                                    state["hidden"].remove(rk)
                                    if rk not in state["active"]:
                                        state["active"].append(rk)
                                    persist_state()
                                    rebuild_lists()

                            _set_view_click(h_row, OnClickListener(restore_item))
                            _apply_press_scale(h_row, 0.97)
                            hidden_card.addView(
                                h_row,
                                LayoutHelper.createLinear(-1, -2, 0, 0 if h_idx == 0 else 6, 0, 0),
                            )

                def on_reset_click(_v):
                    state["active"] = list(DEFAULT_HEADER_TOOLS)
                    state["hidden"] = []
                    self.set_setting("show_edit_menu_btn", True, reload_settings=False)
                    refresh_edit_btn_toggle()
                    persist_state()
                    rebuild_lists()
                    BulletinHelper.show_success("Порядок сброшен")

                _set_view_click(btn_reset, OnClickListener(on_reset_click))

                try:
                    dlg_if = jclass("android.content.DialogInterface$OnDismissListener")

                    class _EditorDismiss(dynamic_proxy(dlg_if)):
                        def onDismiss(self_d, _dlg):
                            try:
                                full_order = list(state["active"]) + list(state["hidden"])
                                self._save_header_tools_config(full_order, set(state["hidden"]), reload_ui=True)
                            except Exception:
                                pass

                    sheet.setOnDismissListener(_EditorDismiss())
                except Exception:
                    pass

                rebuild_lists()
                sheet.setCustomView(root)
                sheet.show()
            except Exception as e:
                _plog(f"tools editor err: {e}")

        run_on_ui_thread(ui)

    def _open_import_export_hub_sheet(self, fragment: Any):
        act = fragment.getParentActivity() if fragment else None
        if act is None:
            return
        _show_action_sheet(act, "Импорт и экспорт", [
            ("Импорт прокси", "msg_download", lambda: self._open_import_sheet(act), False),
            ("Экспорт прокси", "msg_share", lambda: self._open_export_sheet(act), False),
        ])

    def _open_country_filter_sheet(self, act: Any):
        try:
            PC, _, _ = _get_cached_classes()
            pl = PC.getProxyList()
            if pl is None or int(pl.size()) == 0:
                BulletinHelper.show_info("Список прокси пуст")
                return
            groups: Dict[str, List[Tuple[Any, str, int]]] = {}
            for i in range(int(pl.size())):
                info = pl.get(i)
                if info is None:
                    continue
                _key, _kind, srv, _port, _sec, _usr, _pwd = _extract_proxy_details(info)
                geo = self._get_cached_geo(_extract_connect_host(srv))
                if not geo or not geo.get("cc"):
                    continue
                cc = str(geo["cc"])
                _avail, ping = _get_proxy_ping_and_avail(info)
                groups.setdefault(cc, []).append((info, str(geo.get("flag", "")), ping))
            if not groups:
                BulletinHelper.show_info("Нет данных GeoIP. Проверь настройки определения стран")
                return
            actions = []
            for cc, items in sorted(groups.items()):
                flag = items[0][1]
                actions.append((f"{flag} {cc} · {len(items)}", "msg_location",
                                lambda code=cc, arr=items: self._show_country_proxies(act, code, arr), False))
            _show_action_sheet(act, "Прокси по странам", actions,
                               subtitle="Просмотр не удаляет прокси из списка")
        except Exception as exc:
            BulletinHelper.show_error(f"Ошибка просмотра: {exc}")

    def _connect_specific_proxy_info(self, info: Any):
        try:
            PC, _, _ = _get_cached_classes()
            k, _, srv, _, _, _, _ = _extract_proxy_details(info)
            _, ping = _get_proxy_ping_and_avail(info)
            host = _extract_connect_host(srv)
            if _activate_proxy_info(PC, info):
                self._forced_active_key = k
                self._forced_active_ts = time.monotonic()
                self._refresh_visible_proxy_cells()
                run_on_ui_thread(self._refresh_visible_proxy_cells, 120)
                ms_txt = f" ({ping} мс)" if ping > 0 else ""
                BulletinHelper.show_success(f"Подключён: {host}{ms_txt}")
            else:
                BulletinHelper.show_error("Не удалось активировать прокси")
        except Exception as exc:
            BulletinHelper.show_error(f"Ошибка подключения: {exc}")

    def _show_country_proxies(self, act: Any, cc: str, rows: List[Tuple[Any, str, int]]):
        actions = []
        working_in_country = []
        for inf, _fl, p in rows:
            if inf is not None and p > 0:
                _, kd, sr, _, sc, _, _ = _extract_proxy_details(inf)
                working_in_country.append((self._score_candidate_proxy(kd, sc, p), p, inf, _extract_connect_host(sr)))
        if working_in_country:
            working_in_country.sort(key=lambda x: x[0])
            best_p = working_in_country[0][1]

            def _connect_country_best(cands=working_in_country):
                def _bg():
                    picked = self._probe_top_candidates_fast(cands, batch_size=3, timeout=1.35)
                    self._save_ping_cache()

                    def _ui():
                        if picked is None:
                            BulletinHelper.show_info("Серверы этой страны сейчас не ответили")
                            return
                        l_ping, c_key, c_inf, c_host = picked
                        PC, _, _ = _get_cached_classes()
                        if _activate_proxy_info(PC, c_inf):
                            self._forced_active_key = c_key
                            self._forced_active_ts = time.monotonic()
                            self._refresh_visible_proxy_cells(notify_adapter=True)
                            BulletinHelper.show_success(f"Подключён: {c_host} ({l_ping} мс)")
                        else:
                            BulletinHelper.show_error("Не удалось активировать прокси")

                    run_on_ui_thread(_ui)

                threading.Thread(target=_bg, daemon=True).start()

            actions.append((
                f"Подключить лучший ({best_p} мс)",
                "msg_media_shuffle",
                _connect_country_best,
                False,
            ))
        for info, _flag, ping in rows[:80]:
            _key, kind, host, port, secret, username, password = _extract_proxy_details(info)
            if not host:
                continue
            address = _extract_connect_host(host)
            name = f"{address}:{port} · {ping} мс" if ping > 0 else f"{address}:{port} · не проверен"
            actions.append((name, "msg_copy", lambda k=kind,h=host,p=port,s=secret,u=username,w=password:
                            self._copy_proxy_uri(k,h,p,s,u,w), False))
        if not actions:
            BulletinHelper.show_info("Список пуст")
            return
        _show_action_sheet(act, f"{cc} · {len(rows)} прокси", actions,
                           subtitle="Нажми на прокси, чтобы скопировать ссылку")

    def _copy_proxy_uri(self, kind: str, host: str, port: int, secret: str, user: str, pwd: str):
        uri = ParsedProxy(kind, host, port, user, pwd, secret).to_uri()
        if _write_clipboard_text(uri):
            BulletinHelper.show_success("Ссылка на прокси скопирована")
        else:
            BulletinHelper.show_error("Не удалось скопировать ссылку")

    def _open_import_sheet(self, act: Any):
        if act is None:
            frag = get_last_fragment()
            act = frag.getParentActivity() if frag else None
        if act is None:
            return

        def do_clip():
            raw = _read_clipboard_text()
            if not raw:
                BulletinHelper.show_error("Буфер обмена пуст")
                return
            parsed = extract_proxies_from_text(
                raw,
                allow_mtproto=True,
                allow_socks5=True,
                allow_web=True,
                only_faketls=bool(self.get_setting("only_faketls", False)),
            )
            self._save_proxies_native(parsed, manual=True, bypass_dead_cache=bool(self.get_setting("import_ignore_dead_cache", False)))

        def do_url():
            _show_input_sheet(act, "Импорт по ссылке", "https://...", self._import_from_url_async, multiline=False)

        def do_text():
            _show_input_sheet(
                act,
                "Вставьте прокси",
                "tg://proxy?... или tg://webproxy?...",
                lambda txt: self._save_proxies_native(
                    extract_proxies_from_text(
                        txt,
                        allow_mtproto=True,
                        allow_socks5=True,
                        allow_web=True,
                        only_faketls=bool(self.get_setting("only_faketls", False)),
                    ),
                    manual=True,
                    bypass_dead_cache=bool(self.get_setting("import_ignore_dead_cache", False)),
                ),
                multiline=True,
            )

        actions = [
            ("Из буфера обмена", "msg_log", do_clip, False),
            ("По ссылке (URL / подписка)", "msg_link", do_url, False),
            ("Вставить текст вручную", "msg_edit", do_text, False),
        ]
        _show_action_sheet(act, "Импорт прокси", actions)

    def _import_from_url_async(self, url: str):
        if _is_collect_proxy_url(url):
            BulletinHelper.show_info("Добавь канал в источники вместо collect.proxy")
            return

        def worker():
            try:
                u = url.strip()
                if not u.startswith(("http://", "https://")):
                    u = "https://" + u
                req = urllib.request.Request(u, headers={"User-Agent": "Mozilla/5.0"})
                with urllib.request.urlopen(req, timeout=12.0) as resp:
                    body = _read_http_text(resp)
                parsed = extract_proxies_from_text(
                    body,
                    allow_mtproto=True,
                    allow_socks5=True,
                    allow_web=True,
                    only_faketls=bool(self.get_setting("only_faketls", False)),
                )
                self._save_proxies_native(parsed, manual=True, bypass_dead_cache=bool(self.get_setting("import_ignore_dead_cache", False)))
            except Exception as e:
                run_on_ui_thread(lambda: BulletinHelper.show_error(f"Ошибка загрузки: {e}"))

        threading.Thread(target=worker, daemon=True).start()

    def _open_export_sheet(self, act: Any):
        if act is None:
            frag = get_last_fragment()
            act = frag.getParentActivity() if frag else None
        if act is None:
            return

        actions = [
            ("Скопировать все в буфер", "msg_copy", lambda: self._export_proxies_ui(False, True), False),
            ("Скопировать рабочие в буфер", "msg_check", lambda: self._export_proxies_ui(True, True), False),
            ("Отправить все в Избранное", "msg_saved", lambda: self._export_proxies_ui(False, False), False),
            ("Отправить рабочие в Избранное", "msg_send", lambda: self._export_proxies_ui(True, False), False),
            ("Посты Proxy# в Избранное (пачками)", "msg_link", lambda: self._open_export_posts_sheet(act), False),
        ]
        _show_action_sheet(act, "Экспорт прокси", actions)

    def _open_export_posts_sheet(self, act: Any = None):
        if act is None:
            fragment = get_last_fragment()
            act = fragment.getParentActivity() if fragment else None
        if act is None:
            BulletinHelper.show_error("Экран экспорта недоступен")
            return

        account = int(UserConfig.selectedAccount)
        next_key = f"export_next_proxy_number_{account}"

        def ui():
            try:
                sheet = BottomSheet(act, True)
                sheet.setApplyBottomPadding(False)
                sheet.setApplyTopPadding(False)
                root = LinearLayout(act)
                root.setOrientation(LinearLayout.VERTICAL)
                root.setPadding(AndroidUtilities.dp(20), AndroidUtilities.dp(12),
                                AndroidUtilities.dp(20), AndroidUtilities.dp(18))
                background = GradientDrawable()
                background.setCornerRadii([AndroidUtilities.dp(20)] * 4 + [0] * 4)
                background.setColor(Theme.getColor(Theme.key_dialogBackground))
                root.setBackground(background)

                handle = View(act)
                handle_bg = GradientDrawable()
                handle_bg.setCornerRadius(AndroidUtilities.dp(2))
                handle_bg.setColor(0x40808080)
                handle.setBackground(handle_bg)
                root.addView(handle, LayoutHelper.createLinear(36, 4, Gravity.CENTER_HORIZONTAL, 0, 0, 0, 12))

                title = TextView(act)
                title.setText("Экспорт Proxy#")
                title.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 19)
                title.setTypeface(AndroidUtilities.getTypeface("fonts/rmedium.ttf"))
                title.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
                title.setGravity(Gravity.CENTER)
                root.addView(title, LayoutHelper.createLinear(-1, -2, Gravity.CENTER, 0, 0, 0, 16))

                card = LinearLayout(act)
                card.setOrientation(LinearLayout.VERTICAL)
                card.setPadding(AndroidUtilities.dp(14), AndroidUtilities.dp(12),
                                AndroidUtilities.dp(14), AndroidUtilities.dp(12))
                card_bg = GradientDrawable()
                card_bg.setCornerRadius(AndroidUtilities.dp(16))
                card_bg.setColor(Theme.getColor(Theme.key_windowBackgroundGray))
                card.setBackground(card_bg)

                def numeric_field(label: str, value: int, last: bool = False):
                    caption = TextView(act)
                    caption.setText(label)
                    caption.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13)
                    caption.setTextColor(Theme.getColor(Theme.key_dialogTextGray3))
                    card.addView(caption, LayoutHelper.createLinear(-1, -2, 0, 0 if label.startswith("Прокси") else 12, 0, 6))
                    field = EditText(act)
                    field.setInputType(InputType.TYPE_CLASS_NUMBER)
                    field.setSingleLine(True)
                    field.setSelectAllOnFocus(True)
                    field.setText(str(value))
                    field.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
                    field.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 16)
                    field.setPadding(AndroidUtilities.dp(12), AndroidUtilities.dp(8),
                                     AndroidUtilities.dp(12), AndroidUtilities.dp(8))
                    edit_bg = GradientDrawable()
                    edit_bg.setColor(Theme.getColor(Theme.key_dialogBackground))
                    edit_bg.setCornerRadius(AndroidUtilities.dp(12))
                    field.setBackground(edit_bg)
                    card.addView(field, LayoutHelper.createLinear(-1, -2))
                    return field

                per_message = numeric_field("Прокси в одном сообщении · 1–100", int(self.get_setting("export_batch_size", 25) or 25))
                max_total = numeric_field("Сколько прокси отправить (0 = все)", int(self.get_setting("export_max_total", 0) or 0))
                first_number = numeric_field("Начать нумерацию с Proxy#", int(self.get_setting(next_key, 1) or 1))

                def make_check(label: str, key: str):
                    item = CheckBox(act)
                    item.setText(label)
                    item.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 14)
                    item.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
                    item.setChecked(bool(self.get_setting(key, False)))
                    try:
                        item.setButtonTintList(ColorStateList.valueOf(Theme.getColor(Theme.key_dialogTextBlue)))
                    except Exception:
                        pass
                    card.addView(item, LayoutHelper.createLinear(-1, -2, 0, 12, 0, 0))
                    return item

                working_only = make_check("Только рабочие прокси", "export_only_working")
                root.addView(card, LayoutHelper.createLinear(-1, -2, 0, 0, 0, 12))

                preview = LinearLayout(act)
                preview.setOrientation(LinearLayout.VERTICAL)
                preview.setPadding(AndroidUtilities.dp(14), AndroidUtilities.dp(11),
                                   AndroidUtilities.dp(14), AndroidUtilities.dp(11))
                preview_bg = GradientDrawable()
                preview_bg.setCornerRadius(AndroidUtilities.dp(14))
                preview_bg.setColor(Theme.getColor(Theme.key_windowBackgroundGray))
                preview.setBackground(preview_bg)

                preview_label = TextView(act)
                preview_label.setText("Формат поста (ссылка вшита в Proxy#)")
                preview_label.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 11)
                preview_label.setTextColor(Theme.getColor(Theme.key_dialogTextGray3))
                preview.addView(preview_label, LayoutHelper.createLinear(-1, -2, 0, 0, 0, 6))

                preview_links = TextView(act)
                next_number = int(self.get_setting(next_key, 1) or 1)
                preview_links.setText("   ".join(f"Proxy#{n}" for n in range(next_number, next_number + 3)))
                preview_links.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 14)
                preview_links.setTextColor(Theme.getColor(Theme.key_dialogTextBlue))
                preview_links.setTypeface(AndroidUtilities.getTypeface("fonts/rmedium.ttf"))
                preview.addView(preview_links, LayoutHelper.createLinear(-1, -2))
                root.addView(preview, LayoutHelper.createLinear(-1, -2, 0, 0, 0, 14))

                send_btn = TextView(act)
                send_btn.setText("Отправить в Избранное")
                send_btn.setGravity(Gravity.CENTER)
                send_btn.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 15)
                send_btn.setTypeface(AndroidUtilities.getTypeface("fonts/rmedium.ttf"))
                send_btn.setTextColor(Theme.getColor(Theme.key_featuredStickers_buttonText))
                send_btn.setPadding(0, AndroidUtilities.dp(14), 0, AndroidUtilities.dp(14))
                send_bg = GradientDrawable()
                send_bg.setCornerRadius(AndroidUtilities.dp(14))
                send_bg.setColor(Theme.getColor(Theme.key_featuredStickers_addButton))
                send_btn.setBackground(send_bg)

                def do_send(_view):
                    try:
                        batch = int(str(per_message.getText().toString()).strip())
                        total_cap = int(str(max_total.getText().toString()).strip() or "0")
                        start = int(str(first_number.getText().toString()).strip())
                        if not 1 <= batch <= 100 or total_cap < 0 or not 1 <= start <= 100000000:
                            raise ValueError("Размер поста: 1–100; лимит >= 0; номер >= 1")
                        only_work = bool(working_only.isChecked())
                        self.set_setting("export_batch_size", batch, reload_settings=False)
                        self.set_setting("export_max_total", total_cap, reload_settings=False)
                        self.set_setting("export_only_working", only_work, reload_settings=False)
                        sheet.dismiss()
                        self._export_proxy_posts_ui(batch, start, only_work, next_key, account, total_cap)
                    except Exception as e:
                        BulletinHelper.show_error(f"Экспорт: {e}")

                _set_view_click(send_btn, OnClickListener(do_send))
                _apply_press_scale(send_btn)
                root.addView(send_btn, LayoutHelper.createLinear(-1, -2))
                sheet.setCustomView(root)
                sheet.show()
            except Exception as e:
                _plog(f"Proxy# sheet: {e}")
                BulletinHelper.show_error(f"Не удалось открыть экспорт: {e}")

        run_on_ui_thread(ui)

    def _export_proxy_posts_ui(
        self, batch_size: int, start: int, only_working: bool, next_key: str, acc: int, max_total: int = 0,
    ):
        if self._export_posts_in_progress:
            BulletinHelper.show_info("Экспорт уже выполняется")
            return
        try:
            self._hydrate_all_proxies()
            PC, _, _ = _get_cached_classes()
            pl = PC.getProxyList()
            result: List[Tuple[str, int, bool]] = []
            seen: Set[str] = set()
            if pl is not None:
                for i in range(int(pl.size())):
                    info = pl.get(i)
                    if info is None:
                        continue
                    key, kind, host, port, sec, user, pwd = _extract_proxy_details(info)
                    if not host or _is_local_host(host) or not key or key in seen:
                        continue
                    cached = self._get_cached_ping(key)
                    if cached is not None:
                        av = bool(cached.get("alive", False))
                        ping = int(cached.get("ping", 0) or 0)
                        fresh_ok = av and ping > 0
                    else:
                        av, ping = _get_proxy_ping_and_avail(info)
                        fresh_ok = _is_fresh_working(info)

                    if only_working and not fresh_ok:
                        continue
                    if kind in ("mtproto", "web") and not sec:
                        continue
                    seen.add(key)
                    url = ParsedProxy(kind, host, port, user, pwd, sec).to_uri()
                    if url.startswith("tg://proxy?"):
                        url = "https://t.me/proxy?" + url.split("?", 1)[1]
                    elif url.startswith("tg://socks?"):
                        url = "https://t.me/socks?" + url.split("?", 1)[1]
                    result.append((url, ping, av))
                    if max_total > 0 and len(result) >= max_total:
                        break
            if not result:
                BulletinHelper.show_info("Нет прокси, подходящих под фильтр")
                return
            pages = _plan_proxy_export_chunks(result, start, batch_size)
            self._export_posts_in_progress = True
            BulletinHelper.show_info(f"Отправка {len(result)} прокси в {len(pages)} пост(ах)…")
        except Exception as e:
            self._export_posts_in_progress = False
            BulletinHelper.show_error(f"Не удалось подготовить экспорт: {e}")
            return

        def worker():
            try:
                uid = get_user_config().getClientUserId()
                sent = 0
                for page_idx, (first, count) in enumerate(pages):
                    if not self._alive:
                        break
                    if page_idx > 0:
                        time.sleep(0.35)
                    chosen = result[first:first + count]
                    message, quote_start, quote_length, links = _build_proxy_post(
                        [p[0] for p in chosen], start + first,
                        [p[1] for p in chosen], [p[2] for p in chosen],
                    )
                    entities = []
                    if quote_length > 0:
                        quote = TLRPC.TL_messageEntityBlockquote()
                        quote.collapsed = True
                        quote.offset = int(quote_start)
                        quote.length = int(quote_length)
                        entities.append(quote)
                    for offset, length, url in links:
                        entity = TLRPC.TL_messageEntityTextUrl()
                        entity.offset = int(offset)
                        entity.length = int(length)
                        entity.url = url
                        entities.append(entity)

                    send_message({
                        "peer": uid,
                        "message": message,
                        "entities": entities,
                        "no_webpage": True,
                    })
                    sent += count

                next_num = start + sent
                if sent > 0:
                    run_on_ui_thread(
                        lambda number=next_num: self.set_setting(next_key, number, reload_settings=False)
                    )
                run_on_ui_thread(lambda: BulletinHelper.show_success(
                    f"Отправлено: {sent} прокси ({len(pages)} сообщ.) · Следующий Proxy#{next_num}"
                ))
            except Exception as e:
                _plog(f"Proxy# export worker: {e}")
                run_on_ui_thread(lambda err=str(e): BulletinHelper.show_error(f"Экспорт: {err}"))
            finally:
                self._export_posts_in_progress = False

        threading.Thread(target=worker, daemon=True).start()

    def _export_proxies_ui(self, only_working: bool = False, to_clipboard: bool = True):
        try:
            PC, _, _ = _get_cached_classes()
            pl = PC.getProxyList()
            if pl is None or int(pl.size()) == 0:
                BulletinHelper.show_info("Нет прокси для экспорта")
                return

            faketls, padding, web, socks = [], [], [], []
            for i in range(int(pl.size())):
                info = pl.get(i)
                if info is None:
                    continue
                av, _ = _get_proxy_ping_and_avail(info)
                if only_working and not _is_fresh_working(info):
                    continue
                _, kind, srv, port, sec, user, pwd = _extract_proxy_details(info)
                if not srv or _is_local_host(srv):
                    continue
                if kind == "web":
                    web.append(f"tg://webproxy?server={srv}&secret={sec}")
                elif kind == "mtproto":
                    entry = {
                        "addr": srv,
                        "port": port,
                        "secret": sec,
                        "line": f"tg://proxy?server={srv}&port={port}&secret={sec}",
                    }
                    (faketls if sec.lower().startswith("ee") else padding).append(entry)
                else:
                    line = f"tg://socks?server={srv}&port={port}"
                    if user:
                        line += f"&user={urllib.parse.quote(user, safe='')}"
                    if pwd:
                        line += f"&pass={urllib.parse.quote(pwd, safe='')}"
                    socks.append({"addr": srv, "port": port, "secret": "", "line": line})

            faketls.sort(key=_mtp_sort_key)
            padding.sort(key=_mtp_sort_key)
            web.sort()
            socks.sort(key=_mtp_sort_key)

            sections = []
            if faketls:
                sections.append("FakeTLS (MTProto):\n" + "\n".join(e["line"] for e in faketls))
            if padding:
                sections.append("Padding (MTProto):\n" + "\n".join(e["line"] for e in padding))
            if web:
                sections.append("WebProxy:\n" + "\n".join(web))
            if socks:
                sections.append("SOCKS5:\n" + "\n".join(e["line"] for e in socks))

            if not sections:
                BulletinHelper.show_info("Нет подходящих прокси для экспорта")
                return

            txt = "\n\n".join(sections)
            total = len(faketls) + len(padding) + len(web) + len(socks)

            if to_clipboard:
                if _write_clipboard_text(txt):
                    BulletinHelper.show_success(f"Скопировано в буфер: {total}")
                else:
                    BulletinHelper.show_error("Не удалось записать в буфер")
                return

            def send_bg():
                try:
                    uid = get_user_config().getClientUserId()
                    if len(txt.encode("utf-16-le")) // 2 <= 4096:
                        q = TLRPC.TL_messageEntityBlockquote()
                        q.collapsed = True
                        q.offset = 0
                        q.length = len(txt.encode("utf-16-le")) // 2
                        send_message({"peer": uid, "message": txt, "entities": [q]})
                        run_on_ui_thread(
                            lambda: BulletinHelper.show_success(f"Отправлено в Избранное: {total}")
                        )
                    else:
                        cache_dir = get_cache_dir()
                        try:
                            for old_name in os.listdir(cache_dir):
                                if old_name.startswith("proxies_") and old_name.endswith(".txt"):
                                    os.remove(os.path.join(cache_dir, old_name))
                        except Exception:
                            pass
                        fp = os.path.join(cache_dir, f"proxies_{int(time.time())}.txt")
                        write_file(fp, txt)
                        send_document(uid, fp, caption=f"Экспорт прокси ({total} шт.)")
                        run_on_ui_thread(
                            lambda: BulletinHelper.show_success(f"Отправлено файлом в Избранное ({total})")
                        )
                except Exception as e:
                    run_on_ui_thread(lambda: BulletinHelper.show_error(f"Ошибка отправки: {e}"))

            threading.Thread(target=send_bg, daemon=True).start()
        except Exception as e:
            BulletinHelper.show_error(f"Ошибка экспорта: {e}")

    def _start_periodic_timer(self):
        self._timer_token += 1
        tok = self._timer_token

        def _tick():
            if not self._alive or tok != self._timer_token:
                return
            try:
                cur_acc = int(UserConfig.selectedAccount)
                if self._conn_observer_account is not None and cur_acc != self._conn_observer_account:
                    self._unregister_connection_observer()
                    self._register_connection_observer()
            except Exception:
                pass
            saver_on = bool(
                self.get_setting(
                    "battery_saver_bg",
                    self.get_setting("adaptive_timer", True) and self.get_setting("skip_when_screen_off", True),
                )
            )
            net_sig = _get_network_signature()
            net_ok = net_sig != "offline"
            vpn_paused = (net_sig == "vpn") and bool(self.get_setting("pause_ping_on_vpn", True))
            screen_ok = _is_screen_interactive() if saver_on else True

            if self.get_setting("enabled", True) and net_ok and screen_ok:
                self._scan_sources_async(manual=False)

            now = time.monotonic()
            if (
                net_ok
                and not vpn_paused
                and self.get_setting("periodic_health_check", True)
                and self.get_setting("auto_failover", True)
                and (now - self._last_health_check_ts) >= 90.0
                and not self._is_proxy_check_busy()
                and _is_proxy_enabled_in_client()
            ):
                self._last_health_check_ts = now
                threading.Thread(
                    target=self._verify_active_proxy_on_net_change,
                    args=(0.0,),
                    daemon=True,
                ).start()

            if self._prune_ping_cache() > 0:
                self._save_ping_cache()
            if self._prune_ip_cache() > 0:
                self._save_ip_cache()

            interval_min = self._get_interval_minutes()
            run_on_ui_thread(_tick, interval_min * 60 * 1000)

        run_on_ui_thread(_tick, 10000)

    def _process_source_messages_bg(self, source_key: str, tl_messages: List[Any],
                                    manual: bool = False, min_msg_id: int = 0,
                                    account_id: Optional[int] = None,
                                    checkpoint: bool = True):
        if not self._alive:
            return
        acc = int(UserConfig.selectedAccount) if account_id is None else int(account_id)
        sources = self._get_sources(acc)
        meta = sources.get(source_key, {})
        dialog_id, _ = _parse_source_key(source_key, meta)
        allow_mt = bool(self.get_setting("collect_mtproto", True))
        allow_sk = bool(self.get_setting("collect_socks5", True))
        allow_web = bool(self.get_setting("collect_web", True))
        only_faketls = bool(self.get_setting("only_faketls", False))
        parse_files = bool(self.get_setting("parse_attachments", True))
        ping_before_save = bool(self.get_setting("ping_before_save", False))
        use_handshake = bool(self.get_setting("real_handshake_ping", True))
        valid = [m for m in tl_messages if int(getattr(m, "id", 0) or 0) > min_msg_id]
        if not valid:
            if manual:
                run_on_ui_thread(lambda: BulletinHelper.show_info("Новых сообщений не найдено"))
            return
        valid.sort(key=lambda m: int(m.id))
        max_id = max(int(m.id) for m in valid)
        found: List[ParsedProxy] = []
        seen: Set[str] = set()
        duplicate_posts = 0
        for msg in valid:
            if not self._alive:
                return
            try:
                candidates = extract_proxies_from_message(
                    msg, allow_mtproto=allow_mt, allow_socks5=allow_sk,
                    allow_web=allow_web, only_faketls=only_faketls,
                    parse_attachments=parse_files, account_id=acc,
                )
            except Exception as exc:
                _plog(f"source parser failed at {msg.id}: {exc}")
                return
            for p in candidates:
                if p.key in seen:
                    duplicate_posts += 1
                else:
                    seen.add(p.key)
                    found.append(p)
        if ping_before_save and found:
            def check(p):
                return _check_proxy_alive(p.kind, p.server, p.port, p.secret,
                                          p.username, p.password, use_handshake, 3.5) is not None
            try:
                with ThreadPoolExecutor(max_workers=6) as pool:
                    result = list(pool.map(check, found))
                found = [p for p, ok in zip(found, result) if ok]
            except Exception as exc:
                _plog(f"source ping failed: {exc}")
                return
        if not self._alive:
            return
        self._save_proxies_native(found, source_key=source_key, dialog_id=dialog_id,
                                  max_msg_id=max_id if checkpoint else 0, manual=manual,
                                  duplicate_posts=duplicate_posts, account_id=acc)

    def _process_url_source_bg(self, source_key: str, url: str, manual: bool = False,
                               account_id: Optional[int] = None):
        if _is_collect_proxy_url(url):
            if manual:
                run_on_ui_thread(lambda: BulletinHelper.show_info(
                    "Старая collect.proxy-подписка не поддерживается. Добавь канал"
                ))
            return
        try:
            if not self._alive:
                return
            req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"})
            with urllib.request.urlopen(req, timeout=12.0) as response:
                body = _read_http_text(response)
            parsed = extract_proxies_from_text(
                body,
                allow_mtproto=bool(self.get_setting("collect_mtproto", True)),
                allow_socks5=bool(self.get_setting("collect_socks5", True)),
                allow_web=bool(self.get_setting("collect_web", True)),
                only_faketls=bool(self.get_setting("only_faketls", False)),
            )
            if parsed and self.get_setting("ping_before_save", False):
                handshake = bool(self.get_setting("real_handshake_ping", True))
                def check(p):
                    return _check_proxy_alive(p.kind, p.server, p.port, p.secret,
                                              p.username, p.password, handshake, 3.5) is not None
                with ThreadPoolExecutor(max_workers=6) as pool:
                    statuses = list(pool.map(check, parsed))
                parsed = [p for p, good in zip(parsed, statuses) if good]
            if self._alive:
                self._save_proxies_native(parsed, source_key=source_key,
                                          account_id=account_id, manual=manual)
        except Exception as exc:
            _plog(f"URL source {source_key}: {exc}")
            if manual:
                run_on_ui_thread(lambda msg=str(exc): BulletinHelper.show_error(f"Ошибка подписки: {msg}"))

    def _scan_sources_async(self, target_sources: Optional[Dict[str, Dict[str, Any]]] = None,
                            manual: bool = True):
        if not self._alive or not self.get_setting("enabled", True):
            return
        with self._lock:
            if self._scanning:
                busy = True
            else:
                busy = False
                self._scanning = True
        if busy:
            if manual:
                BulletinHelper.show_info("Сбор уже выполняется")
            return
        acc = int(UserConfig.selectedAccount)
        sources = target_sources if target_sources is not None else self._get_sources(acc)
        active = {k: v for k, v in sources.items()
                  if (target_sources is not None or not v.get("paused", False))
                  and isinstance(v, dict)}
        if not active:
            self._scanning = False
            if manual:
                BulletinHelper.show_info("Нет активных источников")
            return
        if manual:
            BulletinHelper.show_info(f"Проверка источников ({len(active)})…")

        def worker():
            failures = []
            before_total = int(self.get_setting("total_collected_count", 0) or 0)
            try:
                limit = self._get_scan_limit()
                single = manual and len(active) == 1
                for key, meta in list(active.items()):
                    if not self._alive or int(UserConfig.selectedAccount) != acc:
                        break
                    if meta.get("type") == "url" or str(key).startswith("url_"):
                        url = str(meta.get("url", "") or "")
                        if url:
                            self._process_url_source_bg(key, url, manual=single, account_id=acc)
                        continue
                    did, tid = _parse_source_key(key, meta)
                    if did == 0:
                        continue
                    saved_id = int(meta.get("last_msg_id", 0) or 0)
                    try:
                        msgs = self._fetch_messages_sync(acc, did, tid, limit, saved_id)
                        if msgs:
                            self._process_source_messages_bg(key, msgs, manual=single,
                                                             min_msg_id=saved_id,
                                                             account_id=acc)
                        elif single:
                            run_on_ui_thread(lambda: BulletinHelper.show_info("Новых сообщений нет"))
                    except Exception as exc:
                        failures.append(str(meta.get("title") or key))
                        _plog(f"source scan {key}: {exc}")
                    time.sleep(0.12)

                if manual and len(active) > 1:
                    def _multi_summary():
                        after_total = int(self.get_setting("total_collected_count", 0) or 0)
                        added_diff = max(0, after_total - before_total)
                        if failures and added_diff == 0:
                            BulletinHelper.show_error(f"Ошибка чтения источников ({len(failures)} шт.)")
                        elif added_diff == 0:
                            BulletinHelper.show_info("Новых прокси в источниках не найдено")
                    run_on_ui_thread(_multi_summary, 250)
                elif failures and manual:
                    run_on_ui_thread(lambda n=len(failures): BulletinHelper.show_error(
                        f"Не удалось прочитать {n} источников"
                    ))
            finally:
                with self._lock:
                    self._scanning = False
        try:
            threading.Thread(target=worker, daemon=True).start()
        except Exception:
            with self._lock:
                self._scanning = False
            raise

    def _fetch_messages_sync(self, account_id: int, dialog_id: int, topic_id: int,
                             limit: int, min_msg_id: int = 0) -> List[Any]:
        mc = MessagesController.getInstance(int(account_id))
        peer = mc.getInputPeer(int(dialog_id))
        if peer is None or isinstance(peer, TLRPC.TL_inputPeerEmpty):
            raise RuntimeError("Источник недоступен в этом аккаунте")
        page_size = min(100, max(1, int(limit)))
        budget = MAX_BACKFILL_PAGES if min_msg_id > 0 else 1
        offset = 0
        found: Dict[int, Any] = {}
        finished = False
        last_oldest = None
        for _page in range(budget):
            if not self._alive:
                raise RuntimeError("Плагин выгружен")
            if topic_id > 1:
                req = TLRPC.TL_messages_getReplies()
                req.peer = peer
                req.msg_id = int(topic_id)
            else:
                req = TLRPC.TL_messages_getHistory()
                req.peer = peer
            req.offset_id = int(offset)
            req.offset_date = 0
            req.add_offset = 0
            req.limit = int(page_size)
            req.max_id = 0
            req.min_id = 0
            req.hash = 0
            response = self._request_sync(req, int(account_id), timeout=22.0)
            raw = getattr(response, "messages", None)
            if raw is None or not hasattr(raw, "size"):
                raise RuntimeError("Telegram вернул историю без списка сообщений")
            n = int(raw.size())
            if not n:
                finished = True
                break
            ids = []
            saw_checkpoint = False
            for i in range(n):
                msg = raw.get(i)
                if msg is None:
                    continue
                msg_id = int(getattr(msg, "id", 0) or 0)
                if msg_id <= 0:
                    continue
                ids.append(msg_id)
                if min_msg_id > 0 and msg_id <= min_msg_id:
                    saw_checkpoint = True
                    continue
                if topic_id > 0 and _get_message_topic_id(msg) != topic_id:
                    continue
                found[msg_id] = msg
            if saw_checkpoint or n < page_size or not ids:
                finished = True
                break
            oldest = min(ids)
            if last_oldest is not None and oldest >= last_oldest:
                raise RuntimeError("Telegram повторил одну и ту же страницу истории")
            last_oldest = oldest
            offset = oldest
        if not finished and min_msg_id > 0:
            raise RuntimeError("Очередь постов слишком большая; курсор сохранён, попробуй снова")
        return [found[k] for k in sorted(found)]

    def _fetch_forum_topics_and_prompt(self, dialog_id: int):
        base_title = _get_dialog_title(dialog_id)
        BulletinHelper.show_info(f"Загрузка топиков «{base_title}»...")

        def worker():
            topics: List[Tuple[int, str]] = []
            try:
                acc = int(UserConfig.selectedAccount)
                mc = MessagesController.getInstance(acc)

                try:
                    tc = mc.getTopicsController()
                    cached = tc.getTopics(-dialog_id) if tc is not None else None
                    if cached is not None and hasattr(cached, "size"):
                        for i in range(int(cached.size())):
                            t_obj = cached.get(i)
                            if t_obj is not None:
                                tid = int(getattr(t_obj, "id", 0) or 0)
                                t_title = str(getattr(t_obj, "title", "") or f"Топик #{tid}").strip()
                                if tid > 0:
                                    topics.append((tid, t_title))
                except Exception:
                    pass

                if not topics:
                    req_cls = find_class("org.telegram.tgnet.TLRPC$TL_channels_getForumTopics") or find_class(
                        "org.telegram.tgnet.tl.TL_forum$TL_messages_getForumTopics"
                    )
                    if req_cls is not None:
                        req = req_cls()
                        if hasattr(req, "channel"):
                            req.channel = mc.getInputChannel(-dialog_id)
                        elif hasattr(req, "peer"):
                            req.peer = mc.getInputPeer(int(dialog_id))
                        req.limit = 100

                        ev = threading.Event()
                        box: List[Any] = [None]

                        def _cb(resp, err):
                            if err is None and resp is not None:
                                box[0] = getattr(resp, "topics", None)
                            ev.set()

                        send_request(req, _cb, account=acc)
                        ev.wait(timeout=8.0)

                        raw_t = box[0]
                        if raw_t is not None and hasattr(raw_t, "size"):
                            for i in range(int(raw_t.size())):
                                t_obj = raw_t.get(i)
                                if t_obj is not None:
                                    tid = int(getattr(t_obj, "id", 0) or 0)
                                    t_title = str(getattr(t_obj, "title", "") or f"Топик #{tid}").strip()
                                    if tid > 0:
                                        topics.append((tid, t_title))
            except Exception:
                pass

            run_on_ui_thread(lambda: self._show_topic_picker_sheet(dialog_id, base_title, topics))

        threading.Thread(target=worker, daemon=True).start()

    def _show_topic_picker_sheet(
        self, dialog_id: int, base_title: str, topics: List[Tuple[int, str]]
    ):
        frag = get_last_fragment()
        act = frag.getParentActivity() if frag else None
        if act is None or not topics:
            disp = self._add_source(dialog_id, 0, base_title, reload_ui=True)
            BulletinHelper.show_success(f"Добавлен: {disp}")
            self._scan_sources_async(
                {_make_source_key(dialog_id, 0): {"type": "chat", "dialog_id": dialog_id, "topic_id": 0}}
            )
            return

        def pick_whole():
            disp = self._add_source(dialog_id, 0, base_title, reload_ui=True)
            BulletinHelper.show_success(f"Добавлен: {disp}")
            self._scan_sources_async(
                {_make_source_key(dialog_id, 0): {"type": "chat", "dialog_id": dialog_id, "topic_id": 0}}
            )

        def pick_topic(t_id: int, t_name: str):
            disp = self._add_source(dialog_id, t_id, f"{base_title} → {t_name}", reload_ui=True)
            BulletinHelper.show_success(f"Добавлен: {disp}")
            k = _make_source_key(dialog_id, t_id)
            self._scan_sources_async({k: {"type": "chat", "dialog_id": dialog_id, "topic_id": t_id}})

        actions = [(f"Весь форум «{base_title}» целиком", "msg_folders", pick_whole, False)]
        for tid, t_title in topics:
            actions.append((f"{t_title} (#{tid})", "msg_topic", lambda i=tid, n=t_title: pick_topic(i, n), False))

        _show_action_sheet(act, f"Выбор топика: {base_title}", actions)

    def _on_chat_menu_click(self, ctx: dict):
        frag = ctx.get("fragment") or get_last_fragment()
        raw_did = ctx.get("dialog_id")
        if raw_did is None and frag is not None and hasattr(frag, "getDialogId"):
            try:
                raw_did = frag.getDialogId()
            except Exception:
                pass
        if raw_did is None and frag is not None:
            raw_did = get_private_field(frag, "dialog_id")

        did = _normalize_dialog_id(raw_did)
        if did == 0:
            BulletinHelper.show_error("Не удалось определить чат")
            return

        is_forum = _is_forum_chat(did)
        tid = int(ctx.get("topic_id") or 0) or _get_fragment_topic_id(frag) if is_forum else 0

        act = frag.getParentActivity() if frag else None
        if act is None:
            return

        sources = self._get_sources()
        base_title = _get_dialog_title(did)
        topic_key = _make_source_key(did, tid)
        whole_key = _make_source_key(did, 0)
        header = f"{base_title} [Топик #{tid}]" if tid > 0 else base_title

        def scan_now():
            target = {topic_key: {"type": "chat", "dialog_id": did, "topic_id": tid}}
            self._scan_sources_async(target_sources=target, manual=True)

        def toggle_current():
            if topic_key in sources:
                sources.pop(topic_key, None)
                self._save_sources(sources, reload_ui=False)
                BulletinHelper.show_info(f"«{header}» убран из автосбора")
            else:
                self._add_source(did, tid, header, reload_ui=False)
                BulletinHelper.show_success(f"«{header}» добавлен")
                self._scan_sources_async(
                    target_sources={topic_key: {"type": "chat", "dialog_id": did, "topic_id": tid}},
                    manual=True,
                )

        actions = [("Собрать прокси сейчас", "msg_retry", scan_now, False)]
        if tid > 0:
            in_t = topic_key in sources
            actions.append(
                (
                    f"Убрать топик #{tid} из автосбора" if in_t else f"Автосбор из топика #{tid}",
                    "msg_delete" if in_t else "msg_add",
                    toggle_current,
                    in_t,
                )
            )
            in_w = whole_key in sources

            def toggle_whole():
                if whole_key in sources:
                    sources.pop(whole_key, None)
                    self._save_sources(sources, reload_ui=False)
                    BulletinHelper.show_info(f"Весь форум «{base_title}» убран")
                else:
                    self._add_source(did, 0, base_title, reload_ui=False)
                    BulletinHelper.show_success(f"Весь форум «{base_title}» добавлен")
                    self._scan_sources_async(
                        target_sources={whole_key: {"type": "chat", "dialog_id": did, "topic_id": 0}},
                        manual=True,
                    )

            actions.append(
                (
                    "Убрать весь форум из автосбора" if in_w else "Автосбор всего форума",
                    "msg_delete" if in_w else "msg_folders",
                    toggle_whole,
                    in_w,
                )
            )
        else:
            in_w = whole_key in sources
            actions.append(
                (
                    "Убрать чат из автосбора" if in_w else "Добавить чат в автосбор",
                    "msg_delete" if in_w else "msg_add",
                    toggle_current,
                    in_w,
                )
            )

        _show_action_sheet(act, header, actions)

    def _open_add_source_sheet(self, _v=None):
        frag = get_last_fragment()
        act = frag.getParentActivity() if frag else None
        if act is None:
            return

        def add_url():
            def on_url(u: str):
                name = self._add_url_source(u, reload_ui=True)
                BulletinHelper.show_success(f"Подписка добавлена: {name}")
                key = _make_url_source_key(u if u.startswith(("http://", "https://")) else "https://" + u)
                src = self._get_sources().get(key)
                if src:
                    self._scan_sources_async({key: src}, manual=True)

            _show_input_sheet(act, "URL-подписка", "https://...", on_url, multiline=False)

        actions = [
            ("Чат, группа, канал или топик", "msg_groups", self._open_picker, False),
            ("URL-подписка (HTTP / HTTPS)", "msg_link", add_url, False),
        ]
        _show_action_sheet(act, "Новый источник", actions)

    def _is_picker_active(self) -> bool:
        if not self._alive or self._picker_delegate is None:
            return False
        try:
            frag = get_last_fragment()
            if frag is None:
                self._picker_delegate = None
                return False
            cls_name = str(frag.getClass().getName())
            if "DialogsActivity" in cls_name or "TopicsFragment" in cls_name:
                return True
            self._picker_delegate = None
            return False
        except Exception:
            return False

    def _open_picker(self):
        frag = get_last_fragment()
        if frag is None:
            return
        try:
            args = Bundle()
            args.putBoolean("onlySelect", True)
            args.putBoolean("canSelectTopics", True)
            args.putInt("dialogsType", 0)

            picker = DialogsActivity(args)

            def on_picked(did: int, tid: int):
                self._picker_delegate = None
                if did == 0:
                    return

                def after_close():
                    if tid == 0 and _is_forum_chat(did):
                        self._fetch_forum_topics_and_prompt(did)
                        return
                    disp = self._add_source(did, tid, reload_ui=True)
                    BulletinHelper.show_success(f"Добавлен: {disp}")
                    key = _make_source_key(did, tid)
                    self._scan_sources_async({key: {"type": "chat", "dialog_id": did, "topic_id": tid}})

                run_on_ui_thread(after_close, 250)

            self._picker_delegate = SourcePickerDelegate(on_picked)
            picker.setDelegate(self._picker_delegate)
            frag.presentFragment(picker)
        except Exception:
            pass

    def _show_sources_manager_sheet(self, _v=None):
        frag = get_last_fragment()
        act = frag.getParentActivity() if frag else None
        if act is None:
            return

        sources = self._get_sources()
        if not sources:
            BulletinHelper.show_info("Список источников пуст")
            return

        actions = []
        for k, meta in sources.items():
            paused = bool(meta.get("paused", False))
            ico = "msg_media_stop" if paused else ("msg_link" if meta.get("type") == "url" else "msg_channel")
            prefix = "[Пауза] " if paused else ""
            title = f"{prefix}{meta.get('title', k)} (+{int(meta.get('added_count', 0) or 0)})"
            actions.append((title, ico, lambda key=k: self._open_single_source_sheet(act, key), paused))

        def reset_all():
            for k in sources:
                if "last_msg_id" in sources[k]:
                    sources[k]["last_msg_id"] = 0
            self._save_sources(sources, reload_ui=True)
            BulletinHelper.show_info("Чекпоинты сброшены")
            self._scan_sources_async(manual=True)

        actions.append(("Сбросить все чекпоинты", "msg_retry", reset_all, False))
        _show_action_sheet(act, f"Источники ({len(sources)})", actions)

    def _open_single_source_sheet(self, act: Any, key: str):
        sources = self._get_sources()
        meta = sources.get(key)
        if not meta:
            return
        paused = bool(meta.get("paused", False))
        title = meta.get("title", key)

        def toggle_pause():
            sources[key]["paused"] = not paused
            self._save_sources(sources, reload_ui=True)
            BulletinHelper.show_info("Поставлен на паузу" if not paused else "Автосбор возобновлён")

        def delete_src():
            sources.pop(key, None)
            self._save_sources(sources, reload_ui=True)
            BulletinHelper.show_info(f"Удалён: {title}")

        actions = [
            ("Возобновить автосбор" if paused else "Поставить на паузу", "msg_play" if paused else "msg_media_stop", toggle_pause, False),
            ("Собрать прокси сейчас", "msg_retry", lambda: self._scan_sources_async({key: meta}, manual=True), False),
            ("Удалить источник", "msg_delete", delete_src, True),
        ]
        _show_action_sheet(act, title, actions)

    def _export_sources_backup(self, to_clipboard: bool):
        sources = self._get_sources()
        if not sources:
            BulletinHelper.show_info("Список источников пуст")
            return
        payload = json.dumps({"proxy_collector_backup": 1, "sources": sources}, ensure_ascii=False, indent=2)
        if to_clipboard:
            if _write_clipboard_text(payload):
                BulletinHelper.show_success(f"Бэкап скопирован ({len(sources)} ист.)")
            else:
                BulletinHelper.show_error("Ошибка копирования")
            return

        def send_bg():
            try:
                uid = get_user_config().getClientUserId()
                if len(payload.encode("utf-16-le")) // 2 <= 4000:
                    send_message({"peer": uid, "message": payload})
                else:
                    fp = os.path.join(get_cache_dir(), "proxy_sources_backup.json")
                    write_file(fp, payload)
                    send_document(uid, fp, caption="Резервная копия источников Proxy Collector")
                run_on_ui_thread(lambda: BulletinHelper.show_success("Бэкап отправлен в Избранное"))
            except Exception as e:
                run_on_ui_thread(lambda: BulletinHelper.show_error(f"Ошибка отправки: {e}"))

        threading.Thread(target=send_bg, daemon=True).start()

    def _restore_sources_backup(self, raw_json: str):
        try:
            data = json.loads(raw_json.strip())
            incoming = data.get("sources") if isinstance(data, dict) and "sources" in data else data
            if not isinstance(incoming, dict) or not incoming:
                BulletinHelper.show_error("Некорректный формат резервной копии")
                return
            current = self._get_sources()
            restored = 0
            for k, meta in incoming.items():
                if isinstance(meta, dict) and k not in current:
                    current[k] = meta
                    restored += 1
            self._save_sources(current, reload_ui=True)
            BulletinHelper.show_success(f"Восстановлено новых источников: {restored}")
        except Exception as e:
            BulletinHelper.show_error(f"Ошибка чтения JSON: {e}")

    def _export_config_backup(self, _v=None):
        try:
            sources = self._get_sources()
            settings = {}
            for key in CONFIG_BACKUP_KEYS:
                value = self.get_setting(key, None)
                if isinstance(value, (str, int, float, bool, list, dict)):
                    settings[key] = value
            data = {"proxy_collector_config": 1, "account": int(UserConfig.selectedAccount),
                    "settings": settings, "sources": sources}
            raw = json.dumps(data, ensure_ascii=False, indent=2)
            if _write_clipboard_text(raw):
                BulletinHelper.show_success("Настройки и источники скопированы")
            else:
                BulletinHelper.show_error("Не удалось скопировать конфигурацию")
        except Exception as exc:
            BulletinHelper.show_error(f"Ошибка бэкапа: {exc}")

    def _restore_config_backup(self, raw_json: str):
        try:
            if len(raw_json) > MAX_SOURCE_BYTES:
                raise ValueError("Бэкап слишком большой")
            data = json.loads(raw_json)
            if not isinstance(data, dict) or data.get("proxy_collector_config") != 1:
                raise ValueError("Нужен JSON конфигурации Proxy Collector")
            settings = data.get("settings", {})
            incoming_sources = data.get("sources", {})
            if not isinstance(settings, dict) or not isinstance(incoming_sources, dict):
                raise ValueError("Неверный формат полей")
            allowed = set(CONFIG_BACKUP_KEYS)
            restored = 0
            for key, value in settings.items():
                if key in allowed and isinstance(value, (str, int, float, bool, list, dict)):
                    self.set_setting(key, value, reload_settings=False)
                    restored += 1
            clean_sources = {str(k): v for k, v in incoming_sources.items()
                             if isinstance(k, str) and len(k) < 300 and isinstance(v, dict)}
            current = self._get_sources()
            fresh = 0
            for key, value in clean_sources.items():
                if key not in current:
                    if _is_collect_proxy_url(str(value.get("url", ""))):
                        value = dict(value)
                        value["paused"] = True
                    current[key] = value
                    fresh += 1
            self._save_sources(current, reload_ui=True)
            self._sync_chat_menu(bool(self.get_setting("show_chat_menu", True)))
            self._sync_msg_menu(bool(self.get_setting("show_msg_menu", False)))
            BulletinHelper.show_success(f"Настройки: {restored} · источники: +{fresh}")
        except Exception as exc:
            BulletinHelper.show_error(f"Ошибка восстановления: {exc}")

    def _get_closest_index(self, key: str, default_val: int, choices: Tuple[int, ...]) -> int:
        try:
            val = int(self.get_setting(key, default_val))
        except Exception:
            val = default_val
        return min(range(len(choices)), key=lambda i: abs(choices[i] - val))

    def _get_interval_minutes(self) -> int:
        return INTERVAL_MINUTES[self._get_closest_index("interval_min", 5, INTERVAL_MINUTES)]

    def _get_scan_limit(self) -> int:
        return SCAN_LIMITS[self._get_closest_index("scan_limit", 25, SCAN_LIMITS)]

    def _get_max_proxy_limit(self) -> int:
        return MAX_PROXY_LIMITS[self._get_closest_index("max_proxy_limit", 100, MAX_PROXY_LIMITS)]

    def _get_max_per_host(self) -> int:
        return MAX_PER_HOST_LIMITS[self._get_closest_index("max_per_host", 0, MAX_PER_HOST_LIMITS)]

    def _get_strike_limit(self) -> int:
        return STRIKE_LIMITS[self._get_closest_index("strikes_limit", 1, STRIKE_LIMITS)]

    def _get_dead_ttl_hours(self) -> int:
        return DEAD_TTL_HOURS[self._get_closest_index("dead_ttl_hours", 24, DEAD_TTL_HOURS)]

    def _build_slider(
        self,
        key: str,
        default_val: int,
        choices: Tuple[int, ...],
        suffix: str = "",
        custom_labels: Optional[List[str]] = None,
    ) -> Any:
        chosen_idx = self._get_closest_index(key, default_val, choices)
        labels = custom_labels if custom_labels is not None else [f"{c}{suffix}" if c > 0 else "Выкл" for c in choices]

        def on_choose(index: int):
            if 0 <= index < len(choices):
                val = int(choices[index])
                item.intValue = index
                self._settings_dirty = True
                self.set_setting(key, val, reload_settings=False)
                if key == "interval_min":
                    self._start_periodic_timer()
                elif key == "max_proxy_limit" and val > 0:
                    def _trim_now():
                        try:
                            PC, _, _ = _get_cached_classes()
                            cut = self._enforce_proxy_limit(PC, val)
                            if cut > 0:
                                BulletinHelper.show_info(f"Список сокращён до {val} (убрано: {cut})")
                        except Exception:
                            pass
                    run_on_ui_thread(_trim_now)

        cb = SlideCallback(on_choose)
        self._keep_callbacks.append(cb)
        if len(self._keep_callbacks) > 128:
            del self._keep_callbacks[:-128]
        item = UItem.asSlideView(jarray(String)(labels), chosen_idx, cb)
        return Custom(item=item)

    def _try_load_header_sticker(self, img_view: Any, sticker_spec: str) -> bool:
        try:
            if "/" not in str(sticker_spec):
                return False
            pack_name, idx_str = str(sticker_spec).split("/", 1)
            raw_idx = int(idx_str)
            acc = int(UserConfig.selectedAccount)
            mdc = MediaDataController.getInstance(acc)
            ss = mdc.getStickerSetByName(pack_name) or mdc.getStickerSetByEmojiOrName(pack_name)
            if ss and ss.documents:
                sz = int(ss.documents.size())
                if sz > 0:
                    safe_idx = raw_idx if raw_idx < sz else max(0, sz - 1)
                    img_view.setImage(
                        ImageLocation.getForDocument(ss.documents.get(safe_idx)),
                        "120_120",
                        None,
                        None,
                        0,
                        1,
                    )
                    return True
            input_set = TLRPC.TL_inputStickerSetShortName()
            input_set.short_name = pack_name
            mdc.getStickerSet(input_set, None, False, None)
        except Exception:
            pass
        return False

    def _build_settings_header(self, context: Any):
        try:
            container = FrameLayout(context)
            try:
                container.setClipChildren(False)
                container.setClipToPadding(False)
            except Exception:
                pass
            if StarParticlesView is not None:
                try:
                    pv = StarParticlesView(context)
                    pv.doNotFling = True
                    pv.setClipWithGradient()
                    pv.drawable.colorKey = Theme.key_premiumGradient1
                    pv.drawable.isCircle = False
                    pv.drawable.roundEffect = False
                    pv.drawable.useRotate = False
                    pv.drawable.useBlur = True
                    pv.drawable.checkBounds = True
                    pv.drawable.useScale = True
                    pv.drawable.startFromCenter = True
                    pv.drawable.centerOffsetY = -AndroidUtilities.dp(8)
                    pv.drawable.size1 = 15
                    pv.drawable.size2 = 16
                    pv.drawable.size3 = 17
                    pv.drawable.init()
                    container.addView(pv, LayoutHelper.createFrame(-1, 232, Gravity.CENTER_HORIZONTAL | Gravity.TOP, 0, 0, 0, 0))
                except Exception:
                    pass

            col = LinearLayout(context)
            col.setOrientation(LinearLayout.VERTICAL)
            col.setGravity(Gravity.CENTER)
            col.setPadding(AndroidUtilities.dp(20), AndroidUtilities.dp(48), AndroidUtilities.dp(20), AndroidUtilities.dp(14))
            try:
                col.setClipChildren(False)
                col.setClipToPadding(False)
            except Exception:
                pass

            avatar_box = FrameLayout(context)
            try:
                avatar_box.setClipChildren(False)
                avatar_box.setClipToPadding(False)
            except Exception:
                pass

            fallback_badge = FrameLayout(context)
            badge_bg = GradientDrawable()
            badge_bg.setShape(GradientDrawable.OVAL)
            badge_bg.setColor(Theme.getColor(Theme.key_featuredStickers_addButton))
            fallback_badge.setBackground(badge_bg)
            ico_res = _get_drawable_res("msg2_proxy", _get_drawable_res("msg_proxy", 0))
            if ico_res:
                iv = ImageView(context)
                iv.setImageResource(ico_res)
                iv.setScaleType(ImageView.ScaleType.CENTER)
                iv.setColorFilter(Theme.getColor(Theme.key_featuredStickers_buttonText))
                fallback_badge.addView(iv, LayoutHelper.createFrame(48, 48, Gravity.CENTER))
            avatar_box.addView(fallback_badge, LayoutHelper.createFrame(104, 104, Gravity.CENTER))

            sticker_view = BackupImageView(context)
            sticker_view.setRoundRadius(AndroidUtilities.dp(28))
            avatar_box.addView(sticker_view, LayoutHelper.createFrame(116, 116, Gravity.CENTER))

            if self._try_load_header_sticker(sticker_view, __icon__):
                fallback_badge.setVisibility(View.GONE)
            else:
                sticker_view.setAlpha(0.0)

                def retry_sticker():
                    if self._try_load_header_sticker(sticker_view, __icon__):
                        sticker_view.animate().alpha(1.0).setDuration(250).start()
                        fallback_badge.animate().alpha(0.0).setDuration(250).start()

                run_on_ui_thread(retry_sticker, 1200)

            easter_memes = (
                "Окак. Бро тапнул по котику ради инета 💀",
                "Скебоб одобряет: пинг -14 мс через Саратов",
                "Трафик идёт на голубях с FakeTLS 🕊️",
                "Этот прокси притворяется микроволновкой",
                "Сигма-режим: пакеты летят на честном слове",
                "Котик на иконке теперь работает за корм 🐾",
                "Чилловый парень просто сидит на SOCKS5 😎",
                "Тунг-тунг-тунг Сахур раздаёт Wi-Fi 🪵",
                "База выдана: ни одного разрыва за сегодня",
                "Абоба-туннель подключён, полёт нормальный",
                "Секретный узел: умный чайник в Казани ☕",
                "Пинг настолько низкий, что ответы из завтра",
                "Не тыкай в котика, он держит весь трафик!",
                "Плаки-плаки? Нет, у нас тут 12 мс пинга",
                "Кринж заблокирован, пропущен только мем",
                "Прокси заряжен на 100% чилла и скорости ⚡",
                "Хакерман в здании: SNI замаскирован под гугл",
                "Кот устал крутить колесо, дай ему рыбов 🐟",
                "Легенда: кто тапнет 50 раз — получит 0 мс",
                "Окак. Даже РКН не понял, куда ушёл пакет",
                "Подключён спутник Илона Маска на изоленте",
                "Лабубу охраняет твой MTProto от детекта 🧸",
                "Трафик завернут в лаваш с двойным FakeTLS",
                "Бро думает, что тапы ускоряют интернет 😭",
            )

            def _play_diverse_icon_anim(anim_kind: int):
                try:
                    avatar_box.performHapticFeedback(HapticFeedbackConstants.LONG_PRESS)
                    if anim_kind == 0:
                        avatar_box.animate().scaleX(1.12).scaleY(1.12).translationY(float(-AndroidUtilities.dp(22))).rotationBy(360.0).setDuration(260).start()
                        run_on_ui_thread(
                            lambda: avatar_box.animate().scaleX(1.0).scaleY(1.0).translationY(0.0).setDuration(240).start(),
                            265,
                        )
                    elif anim_kind == 1:
                        avatar_box.animate().scaleX(1.24).scaleY(0.76).translationY(float(AndroidUtilities.dp(6))).setDuration(110).start()
                        run_on_ui_thread(
                            lambda: avatar_box.animate().scaleX(0.86).scaleY(1.18).translationY(float(-AndroidUtilities.dp(18))).setDuration(150).start(),
                            115,
                        )
                        run_on_ui_thread(
                            lambda: avatar_box.animate().scaleX(1.0).scaleY(1.0).translationY(0.0).setDuration(180).start(),
                            270,
                        )
                    elif anim_kind == 2:
                        avatar_box.animate().rotation(-18.0).scaleX(1.10).scaleY(1.10).setDuration(90).start()
                        run_on_ui_thread(lambda: avatar_box.animate().rotation(18.0).setDuration(110).start(), 95)
                        run_on_ui_thread(lambda: avatar_box.animate().rotation(-10.0).setDuration(95).start(), 210)
                        run_on_ui_thread(lambda: avatar_box.animate().rotation(0.0).scaleX(1.0).scaleY(1.0).setDuration(110).start(), 310)
                    elif anim_kind == 3:
                        avatar_box.animate().rotationBy(720.0).scaleX(1.14).scaleY(1.14).setDuration(360).start()
                        run_on_ui_thread(
                            lambda: avatar_box.animate().scaleX(1.0).scaleY(1.0).setDuration(180).start(),
                            365,
                        )
                    elif anim_kind == 4:
                        avatar_box.animate().rotationYBy(360.0).translationY(float(-AndroidUtilities.dp(14))).scaleX(1.08).scaleY(1.08).setDuration(320).start()
                        run_on_ui_thread(
                            lambda: avatar_box.animate().translationY(0.0).scaleX(1.0).scaleY(1.0).setDuration(200).start(),
                            325,
                        )
                    elif anim_kind == 5:
                        avatar_box.animate().scaleX(1.18).scaleY(1.18).setDuration(100).start()
                        run_on_ui_thread(lambda: avatar_box.animate().scaleX(0.94).scaleY(0.94).setDuration(90).start(), 105)
                        run_on_ui_thread(lambda: avatar_box.animate().scaleX(1.15).scaleY(1.15).setDuration(100).start(), 200)
                        run_on_ui_thread(lambda: avatar_box.animate().scaleX(1.0).scaleY(1.0).setDuration(140).start(), 305)
                    else:
                        avatar_box.animate().translationX(float(-AndroidUtilities.dp(16))).rotation(-12.0).setDuration(95).start()
                        run_on_ui_thread(lambda: avatar_box.animate().translationX(float(AndroidUtilities.dp(16))).rotation(12.0).setDuration(130).start(), 100)
                        run_on_ui_thread(lambda: avatar_box.animate().translationX(0.0).rotation(0.0).setDuration(120).start(), 235)
                except Exception:
                    pass

            def _on_icon_tap(_v):
                self._easter_tap_count += 1
                if self._easter_tap_count >= 5:
                    self._easter_tap_count = 0
                    m_pool = [i for i in range(len(easter_memes)) if i != self._last_meme_idx]
                    m_idx = random.choice(m_pool) if m_pool else 0
                    self._last_meme_idx = m_idx

                    a_pool = [i for i in range(7) if i != self._last_anim_idx]
                    a_idx = random.choice(a_pool) if a_pool else 0
                    self._last_anim_idx = a_idx

                    _play_diverse_icon_anim(a_idx)
                    BulletinHelper.show_info(easter_memes[m_idx])
                else:
                    try:
                        avatar_box.animate().scaleX(0.92).scaleY(0.92).setDuration(75).start()
                        run_on_ui_thread(
                            lambda: avatar_box.animate().scaleX(1.0).scaleY(1.0).setDuration(140).start(),
                            80,
                        )
                    except Exception:
                        pass

            avatar_box.setClickable(True)
            _set_view_click(avatar_box, OnClickListener(_on_icon_tap))
            col.addView(avatar_box, LayoutHelper.createLinear(116, 116, Gravity.CENTER, 0, 0, 0, 12))

            tv_title = TextView(context)
            tv_title.setText(f"{__name__} · {__version__}")
            tv_title.setTypeface(AndroidUtilities.getTypeface("fonts/rmedium.ttf"))
            tv_title.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 20)
            tv_title.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText))
            tv_title.setGravity(Gravity.CENTER)
            col.addView(tv_title, LayoutHelper.createLinear(-1, -2, Gravity.CENTER, 0, 0, 0, 4))

            cnt_p, _working_p, best_ms, _, _ = self._get_list_health_summary()
            sources_map = self._get_sources()
            cnt_s = len(sources_map)
            active_s = sum(1 for v in sources_map.values() if not v.get("paused", False))
            enabled_now = bool(self.get_setting("enabled", True))

            tv_sub = TextView(context)
            tv_sub.setText("Автосбор активен" if enabled_now else "Автосбор на паузе")
            tv_sub.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13)
            tv_sub.setTypeface(AndroidUtilities.getTypeface("fonts/rmedium.ttf"))
            tv_sub.setTextColor(
                (COLOR_FAST - 0x100000000)
                if enabled_now
                else Theme.getColor(Theme.key_windowBackgroundWhiteGrayText)
            )
            tv_sub.setGravity(Gravity.CENTER)
            self._header_sub_tv = tv_sub
            col.addView(tv_sub, LayoutHelper.createLinear(-1, -2, Gravity.CENTER, 0, 0, 0, 12))

            accent_blue = Theme.getColor(Theme.key_featuredStickers_addButton)
            text_black = Theme.getColor(Theme.key_windowBackgroundWhiteBlackText)
            text_gray = Theme.getColor(Theme.key_windowBackgroundWhiteGrayText)

            stats_bar = LinearLayout(context)
            stats_bar.setOrientation(LinearLayout.HORIZONTAL)
            stats_bar.setGravity(Gravity.CENTER)
            stats_bar.setPadding(
                AndroidUtilities.dp(8),
                AndroidUtilities.dp(9),
                AndroidUtilities.dp(8),
                AndroidUtilities.dp(9),
            )
            sb_bg = GradientDrawable()
            sb_bg.setCornerRadius(AndroidUtilities.dp(14))
            try:
                sb_bg.setColor(Theme.getColor(Theme.key_windowBackgroundWhite))
            except Exception:
                sb_bg.setColor(0x14808080)
            stats_bar.setBackground(sb_bg)

            best_txt = f"{best_ms} мс" if best_ms > 0 else "—"
            best_col = _ping_color(best_ms) - 0x100000000 if best_ms > 0 else text_gray
            metrics = [
                (str(cnt_p), "В списке", accent_blue if cnt_p > 0 else text_black),
                (f"{active_s}/{cnt_s}", "Источников", accent_blue if active_s > 0 else text_gray),
                (best_txt, "Лучший пинг", best_col),
            ]
            for idx, (val_txt, lbl_txt, val_col) in enumerate(metrics):
                if idx > 0:
                    sep = View(context)
                    sep.setBackgroundColor(0x1E808080)
                    stats_bar.addView(sep, LayoutHelper.createLinear(1, 24, Gravity.CENTER_VERTICAL))

                cell = LinearLayout(context)
                cell.setOrientation(LinearLayout.VERTICAL)
                cell.setGravity(Gravity.CENTER)

                tv_val = TextView(context)
                tv_val.setText(val_txt)
                tv_val.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 14)
                tv_val.setTypeface(AndroidUtilities.getTypeface("fonts/rmedium.ttf"))
                tv_val.setTextColor(val_col)
                tv_val.setGravity(Gravity.CENTER)
                cell.addView(tv_val, LayoutHelper.createLinear(-1, -2, Gravity.CENTER))

                tv_lbl = TextView(context)
                tv_lbl.setText(lbl_txt)
                tv_lbl.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 11)
                tv_lbl.setTextColor(text_gray)
                tv_lbl.setGravity(Gravity.CENTER)
                cell.addView(tv_lbl, LayoutHelper.createLinear(-1, -2, Gravity.CENTER, 0, 2, 0, 0))

                stats_bar.addView(cell, LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1.0))

            col.addView(stats_bar, LayoutHelper.createLinear(-1, -2, Gravity.CENTER))

            container.addView(col, LayoutHelper.createFrame(-1, -2, Gravity.CENTER))
            return container
        except Exception:
            return None

    def _show_guide_sheet(self, _v=None):
        frag = get_last_fragment()
        act = frag.getParentActivity() if frag else None
        if act is None:
            return

        guide = (
            "**1. Автосбор из источников**\n"
            "Добавляйте каналы, группы, отдельные ветки форумов и ссылки-подписки. "
            "Плагин распознаёт ссылки, кнопки, списки в Base64 и текстовые файлы .txt / .json.\n\n"
            "**2. Умный пинг и сортировка**\n"
            "Проверяется реальный ответ сервера (Handshake), а результаты сохраняются в кэш. "
            "Доступны 3 режима упорядочивания: Умная, По минимальному пингу и По типу шифрования.\n\n"
            "**3. Автопереключение (Failover)**\n"
            "Если активный прокси перестал отвечать или сменился Wi-Fi на мобильный интернет, "
            "плагин проверит кандидатов и подключит самый быстрый рабочий сервер.\n\n"
            "**4. Страйки, карантин и лимит**\n"
            "Нерабочие прокси накапливают страйки, после удаления попадают в карантин на заданное время, "
            "а при превышении лимита списка автоматически удаляются только недоступные.\n\n"
            "**5. Импорт, экспорт Proxy# и меню**\n"
            "Можно загружать прокси из буфера или по URL, отправлять пачками Proxy# в Избранное "
            "и настраивать кнопки быстрого меню в шапке списка прокси.\n\n"
            "**6. Обозначения в списке**\n"
            "🌐 WebProxy · 🛡️ FakeTLS (SNI) · 🔒 FakeTLS · ➿ Padding · ⚠️ Plain · 🧦 SOCKS5."
        )

        def ui():
            try:
                sheet = BottomSheet(act, False)
                sheet.setApplyBottomPadding(False)
                sheet.setApplyTopPadding(False)

                root = LinearLayout(act)
                root.setOrientation(LinearLayout.VERTICAL)
                root.setPadding(
                    AndroidUtilities.dp(18),
                    AndroidUtilities.dp(10),
                    AndroidUtilities.dp(18),
                    AndroidUtilities.dp(16),
                )
                bg = GradientDrawable()
                bg.setCornerRadii([
                    AndroidUtilities.dp(20), AndroidUtilities.dp(20),
                    AndroidUtilities.dp(20), AndroidUtilities.dp(20),
                    0, 0, 0, 0,
                ])
                bg.setColor(Theme.getColor(Theme.key_dialogBackground))
                root.setBackground(bg)

                pill = View(act)
                pill_bg = GradientDrawable()
                pill_bg.setCornerRadius(AndroidUtilities.dp(2))
                pill_bg.setColor(0x40808080)
                pill.setBackground(pill_bg)
                root.addView(pill, LayoutHelper.createLinear(36, 4, Gravity.CENTER_HORIZONTAL, 0, 0, 0, 12))

                title = TextView(act)
                title.setText("Как это работает")
                title.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 19)
                title.setTypeface(AndroidUtilities.getTypeface("fonts/rmedium.ttf"))
                title.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
                title.setGravity(Gravity.CENTER)
                root.addView(title, LayoutHelper.createLinear(-1, -2, Gravity.CENTER, 0, 0, 0, 14))

                scroll = ScrollView(act)
                scroll.setVerticalScrollBarEnabled(False)

                card = LinearLayout(act)
                card.setOrientation(LinearLayout.VERTICAL)
                card.setPadding(
                    AndroidUtilities.dp(14),
                    AndroidUtilities.dp(12),
                    AndroidUtilities.dp(14),
                    AndroidUtilities.dp(12),
                )
                card_bg = GradientDrawable()
                card_bg.setCornerRadius(AndroidUtilities.dp(16))
                try:
                    card_bg.setColor(Theme.getColor(Theme.key_windowBackgroundGray))
                except Exception:
                    card_bg.setColor(0x18808080)
                card.setBackground(card_bg)

                tv = TextView(act)
                tv.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 14)
                tv.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
                tv.setLineSpacing(AndroidUtilities.dp(3), 1.15)

                parts = []
                last = 0
                for m in re.finditer(r"\*\*(.*?)\*\*", guide):
                    if m.start() > last:
                        parts.append((guide[last:m.start()], False))
                    parts.append((m.group(1), True))
                    last = m.end()
                if last < len(guide):
                    parts.append((guide[last:], False))
                sp = SpannableString("".join(p[0] for p in parts))
                pos = 0
                for txt_p, bold in parts:
                    if bold:
                        sp.setSpan(StyleSpan(Typeface.BOLD), pos, pos + len(txt_p), SpannableString.SPAN_EXCLUSIVE_EXCLUSIVE)
                    pos += len(txt_p)
                tv.setText(sp)
                card.addView(tv, LayoutHelper.createLinear(-1, -2))
                scroll.addView(card)
                root.addView(scroll, LayoutHelper.createLinear(-1, 0, 1.0))

                btn = TextView(act)
                btn.setText("Понятно")
                btn.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 15)
                btn.setTypeface(AndroidUtilities.getTypeface("fonts/rmedium.ttf"))
                btn.setGravity(Gravity.CENTER)
                btn.setTextColor(Theme.getColor(Theme.key_featuredStickers_buttonText))
                btn.setPadding(0, AndroidUtilities.dp(13), 0, AndroidUtilities.dp(13))
                b_bg = GradientDrawable()
                b_bg.setCornerRadius(AndroidUtilities.dp(14))
                b_bg.setColor(Theme.getColor(Theme.key_featuredStickers_addButton))
                btn.setBackground(b_bg)
                btn.setClickable(True)
                _set_view_click(btn, OnClickListener(lambda _v: sheet.dismiss()))
                _apply_press_scale(btn, 0.97)
                root.addView(btn, LayoutHelper.createLinear(-1, -2, 0, 12, 0, 0))

                sheet.setCustomView(root)
                sheet.show()
            except Exception:
                pass

        run_on_ui_thread(ui)

    def _build_autoscan_banner(self) -> Any:
        try:
            frag = get_last_fragment()
            ctx = frag.getParentActivity() if frag else ApplicationLoader.applicationContext
            if ctx is None:
                return None

            row = LinearLayout(ctx)
            row.setOrientation(LinearLayout.HORIZONTAL)
            row.setGravity(Gravity.CENTER)
            row.setPadding(
                AndroidUtilities.dp(20),
                AndroidUtilities.dp(13),
                AndroidUtilities.dp(20),
                AndroidUtilities.dp(13),
            )
            bg = GradientDrawable()
            bg.setCornerRadius(AndroidUtilities.dp(14))
            try:
                bg.setColor(Theme.getColor(Theme.key_windowBackgroundWhite))
            except Exception:
                bg.setColor(0x14808080)
            row.setBackground(bg)

            dot = View(ctx)
            dot_bg = GradientDrawable()
            dot_bg.setShape(GradientDrawable.OVAL)
            dot.setBackground(dot_bg)
            row.addView(dot, LayoutHelper.createLinear(9, 9, Gravity.CENTER_VERTICAL, 0, 0, 10, 0))

            tv_lbl = TextView(ctx)
            tv_lbl.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 15)
            tv_lbl.setTypeface(AndroidUtilities.getTypeface("fonts/rmedium.ttf"))
            tv_lbl.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText))
            row.addView(tv_lbl, LayoutHelper.createLinear(-2, -2, Gravity.CENTER_VERTICAL, 0, 0, 12, 0))

            tv_badge = TextView(ctx)
            tv_badge.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 12)
            tv_badge.setTypeface(AndroidUtilities.getTypeface("fonts/rmedium.ttf"))
            tv_badge.setPadding(
                AndroidUtilities.dp(10),
                AndroidUtilities.dp(3),
                AndroidUtilities.dp(10),
                AndroidUtilities.dp(3),
            )
            badge_bg = GradientDrawable()
            badge_bg.setCornerRadius(AndroidUtilities.dp(10))
            tv_badge.setBackground(badge_bg)
            row.addView(tv_badge, LayoutHelper.createLinear(-2, -2, Gravity.CENTER_VERTICAL))

            def _sync_visual(is_on: bool):
                green_col = COLOR_FAST - 0x100000000
                gray_col = Theme.getColor(Theme.key_windowBackgroundWhiteGrayText)
                dot_bg.setColor(green_col if is_on else gray_col)
                tv_lbl.setText("Автосбор прокси")
                tv_badge.setText("ВКЛ" if is_on else "ВЫКЛ")
                tv_badge.setTextColor(green_col if is_on else gray_col)
                badge_bg.setColor(0x224CAF50 if is_on else 0x1A808080)

            _sync_visual(bool(self.get_setting("enabled", True)))
            row.setClickable(True)

            def _on_toggle(_v):
                cur = bool(self.get_setting("enabled", True))
                nxt = not cur
                self.set_setting("enabled", nxt, reload_settings=False)
                _sync_visual(nxt)
                try:
                    sub_tv = self._header_sub_tv
                    if sub_tv is not None:
                        sub_tv.setText("Автосбор активен" if nxt else "Автосбор на паузе")
                        sub_tv.setTextColor(
                            (COLOR_FAST - 0x100000000)
                            if nxt
                            else Theme.getColor(Theme.key_windowBackgroundWhiteGrayText)
                        )
                except Exception:
                    pass

            _set_view_click(row, OnClickListener(_on_toggle))
            _apply_press_scale(row, 0.98)

            wrapper = FrameLayout(ctx)
            wrapper.setPadding(
                AndroidUtilities.dp(16),
                AndroidUtilities.dp(6),
                AndroidUtilities.dp(16),
                AndroidUtilities.dp(4),
            )
            wrapper.addView(row, FrameLayout.LayoutParams(-1, -2))
            item = UItem.asCustom(wrapper)
            try:
                item.setTransparent(True)
            except Exception:
                pass
            return Custom(item=item)
        except Exception:
            return Switch(
                key="enabled",
                text="Автосбор прокси",
                default=True,
            )

    def _sub_sources(self) -> List[Any]:
        sources = self._get_sources()
        active_s = sum(1 for v in sources.values() if not v.get("paused", False))
        return [
            Header(text="Источники"),
            Text(
                text="Добавить источник",
                icon="msg_add",
                accent=True,
                on_click=self._open_add_source_sheet,
            ),
            Text(
                text=f"Мои источники ({active_s} из {len(sources)})",
                icon="msg_list",
                on_click=self._show_sources_manager_sheet,
            ),
            Divider(text="Поддерживаются каналы, группы, отдельные ветки форумов и прямые ссылки на списки прокси."),
            Header(text="Интервал фоновой проверки"),
            self._build_slider("interval_min", 5, INTERVAL_MINUTES, " м"),
            Header(text="Глубина первого сбора"),
            self._build_slider("scan_limit", 25, SCAN_LIMITS, ""),
            Header(text="Лимит прокси с одного сервера"),
            self._build_slider("max_per_host", 0, MAX_PER_HOST_LIMITS, ""),
            Divider(text="Лимит на один сервер не даёт одному хостингу забить весь список одинаковыми адресами."),
            Header(text="Фильтры"),
            Switch(key="collect_mtproto", text="MTProto прокси", default=True),
            Switch(key="only_faketls", text="Только FakeTLS (ee...)", default=False),
            Switch(key="collect_socks5", text="SOCKS5 прокси", default=True),
            Switch(key="collect_web", text="WEB-прокси (HTTPS)", default=True),
            Switch(key="parse_attachments", text="Читать файлы .txt и .json", default=True),
            Switch(key="auto_dedup", text="Не добавлять дубликаты", default=True),
            Switch(key="import_ignore_dead_cache", text="Игнорировать карантин при импорте", default=False),
            Divider(text="FakeTLS маскирует трафик под обычные сайты и лучше всего проходит через блокировки."),
            Header(text="Автоматизация"),
            Switch(key="auto_verify_new", text="Проверять новые после сбора", default=True),
            Switch(key="realtime_enabled", text="Сбор при новых сообщениях", default=True),
            Switch(key="battery_saver_bg", text="Экономия батареи в фоне", default=True),
            Switch(key="mark_read_after_collect", text="Помечать источник прочитанным", default=False),
            Divider(text="При включённой экономии батареи фоновый сбор ставится на паузу без интернета и при выключенном экране."),
        ]

    def _on_replace_ping_toggled(self, enabled: bool):
        on = bool(enabled)
        self._invalidate_hot_ui_cfg()
        self.set_setting("replace_native_ping", on, reload_settings=True)
        try:
            PC, _, _ = _get_cached_classes()
            if on:
                self._hydrate_all_proxies()
            else:
                pl = PC.getProxyList()
                if pl is not None:
                    for i in range(int(pl.size())):
                        inf = pl.get(i)
                        if inf is not None:
                            try:
                                inf.checking = False
                                inf.availableCheckTime = 0
                            except Exception:
                                pass
                PC.checkProxyList()
            NotificationCenter.getGlobalInstance().postNotificationName(
                NotificationCenter.proxySettingsChanged
            )
        except Exception:
            pass

    def _sub_ping_and_failover(self) -> List[Any]:
        return [
            Header(text="Проверка задержки"),
            Switch(
                key="replace_native_ping",
                text="Умный пинг (Handshake)",
                default=True,
                on_change=self._on_replace_ping_toggled,
            ),
            Switch(
                key="ping_before_save",
                text="Проверять до добавления",
                default=False,
            ),
            Divider(text="Умный пинг проверяет реальный ответ протокола сервера, а не просто открытый порт."),
            Header(text="Срок кэша пинга"),
            self._build_slider("ping_cache_ttl_min", 60, PING_CACHE_TTL_MIN, "", custom_labels=["Выкл", "15 м", "30 м", "1 ч", "3 ч", "24 ч"]),
            Text(
                text=f"Очистить кэш пинга ({len(self._ping_cache)})",
                on_click=lambda _: (
                    self._ping_cache.clear(),
                    self._save_ping_cache(),
                    BulletinHelper.show_success("Кэш пинга очищен"),
                ),
            ),
            Divider(text="Устаревшие замеры очищаются автоматически, а размер кэша ограничен 500 записями."),
            Header(text="Сортировка списка"),
            Text(
                text="Режим упорядочивания",
                subtext=SORT_MODE_LABELS.get(self._get_sort_mode(), "Умная (скорость и защита)"),
                on_click=lambda _: self._open_sort_mode_sheet(),
            ),
            Switch(
                key="auto_sort_after_check",
                text="Сортировать после проверки",
                default=True,
            ),
            Text(
                text="Упорядочить сейчас",
                on_click=lambda _: self._sort_proxies_by_ping_inplace(_get_cached_classes()[0], silent=False),
            ),
            Divider(
                text={
                    "smart": "Умный режим учитывает скорость в миллисекундах и поднимает выше защищённые прокси (FakeTLS, WebProxy).",
                    "ping": "Сортировка строго по минимальному пингу (мс) — самые быстрые серверы всегда в самом начале списка.",
                    "dpi": "Сортировка по уровню маскировки трафика: сначала FakeTLS с SNI и WebProxy, затем Padding и SOCKS5.",
                }.get(self._get_sort_mode(), "Умный режим учитывает скорость и уровень защиты протокола.")
            ),
            Header(text="Автопереключение (Failover)"),
            Switch(
                key="auto_failover",
                text="Переключать при сбое активного",
                default=True,
            ),
            Switch(
                key="network_switch_failover",
                text="Проверять при смене сети",
                default=True,
            ),
            Switch(
                key="periodic_health_check",
                text="Контроль активного раз в 5 мин",
                default=True,
            ),
            Switch(
                key="pause_ping_on_vpn",
                text="Не пинговать и не переключать при VPN",
                default=True,
            ),
            Divider(text="Если прокси перестанет отвечать или сменится сеть, плагин переключится на рабочий. При включённом VPN пинг и failover ставятся на паузу."),
        ]

    def _sub_cleanup_and_appearance(self) -> List[Any]:
        order, disabled = self._get_header_tools_config()
        active_tools_cnt = len(order) - len(disabled)
        geo_remote_on = bool(self.get_setting("geo_remote_lookup", False))
        show_bar_btn = bool(self.get_setting("show_proxy_bar_btn", True))

        items: List[Any] = [
            Header(text="Очистка и карантин"),
            Switch(
                key="auto_delete_dead_on_check",
                text="Автоудалять мёртвые при проверке",
                default=False,
            ),
            Header(text="Страйков до удаления"),
            self._build_slider("strikes_limit", 2, STRIKE_LIMITS, ""),
            Header(text="Карантин мёртвых"),
            self._build_slider("dead_ttl_hours", 24, DEAD_TTL_HOURS, " ч"),
            Header(text="Лимит размера списка"),
            self._build_slider("max_proxy_limit", 150, MAX_PROXY_LIMITS, ""),
            Text(
                text=f"Сбросить карантин и страйки ({len(self._dead_cache)} / {len(self._strikes)})",
                on_click=lambda _: (
                    self._dead_cache.clear(),
                    self._strikes.clear(),
                    self._save_dead_and_strikes(),
                    BulletinHelper.show_success("Карантин и страйки очищены"),
                ),
            ),
            Divider(text="Недоступные серверы получают страйки и после удаления попадают в карантин, чтобы не добавляться повторно."),
            Header(text="Карточки прокси"),
            Switch(
                key="show_geo_flags",
                text="Флаги стран и провайдер",
                default=True,
                on_change=self._on_show_geo_toggled,
            ),
            Switch(
                key="geo_remote_lookup",
                text="Загружать GeoIP из сети",
                default=False,
                on_change=self._on_geo_lookup_toggled,
            ),
        ]
        if geo_remote_on:
            items.append(
                Text(
                    text=f"Обновить GeoIP сейчас ({len(self._ip_cache)})",
                    on_click=lambda _: self._prefetch_geo_for_all_proxies(manual=True),
                )
            )
        if geo_remote_on or len(self._ip_cache) > 0:
            items.append(
                Text(
                    text=f"Очистить кэш GeoIP ({len(self._ip_cache)})",
                    on_click=lambda _: (
                        self._ip_cache.clear(),
                        self._save_ip_cache(),
                        self._refresh_settings_ui(),
                        BulletinHelper.show_success("Кэш GeoIP очищен"),
                    ),
                )
            )
        items.append(
            Text(
                text="Обзор прокси по странам",
                on_click=lambda _: self._open_country_filter_sheet(
                    get_last_fragment().getParentActivity() if get_last_fragment() else None
                ),
            )
        )
        items.extend([
            Switch(
                key="show_dpi_badges",
                text="Значки защиты (DPI)",
                default=True,
            ),
            Switch(
                key="show_ping_color",
                text="Цветная индикация скорости",
                default=True,
            ),
            Switch(
                key="show_local_label",
                text="Подпись «Локальный туннель»",
                default=True,
            ),
            Divider(text="GeoIP определяет страну и хостинг сервера (кэш автоочищается старше 7 дней и ограничен 500 записями)."),
            Header(text="Интерфейс и меню"),
            Switch(
                key="show_proxy_bar_btn",
                text="Кнопка инструментов в шапке",
                default=True,
                on_change=self._on_proxy_bar_btn_toggled,
            ),
        ])
        if show_bar_btn:
            items.append(
                Text(
                    text=f"Меню в шапке ({active_tools_cnt} из {len(order)})",
                    on_click=lambda _: self._open_header_tools_editor_sheet(),
                )
            )
        items.extend([
            Switch(
                key="show_chat_menu",
                text="Пункт в меню чата (⋮)",
                default=True,
                on_change=lambda v: (
                    self.set_setting("show_chat_menu", bool(v), reload_settings=False),
                    self._sync_chat_menu(bool(v)),
                ),
            ),
            Switch(
                key="show_msg_menu",
                text="Пункт в меню поста",
                default=False,
                on_change=lambda v: (
                    self.set_setting("show_msg_menu", bool(v), reload_settings=False),
                    self._sync_msg_menu(bool(v)),
                ),
            ),
            Switch(
                key="show_bulletin",
                text="Всплывающие уведомления",
                default=True,
            ),
            Divider(text="Позволяет управлять прокси прямо из шапки списка и добавлять каналы в один клик из меню чата."),
        ])
        return items

    def _sub_transfer_and_backup(self) -> List[Any]:
        frag = get_last_fragment()
        act = frag.getParentActivity() if frag else None
        return [
            Header(text="Обмен прокси"),
            Text(
                text="Импорт прокси",
                icon="msg_download",
                on_click=lambda _: self._open_import_sheet(
                    act or (get_last_fragment().getParentActivity() if get_last_fragment() else None)
                ),
            ),
            Text(
                text="Экспорт прокси",
                icon="msg_share",
                on_click=lambda _: self._open_export_sheet(
                    act or (get_last_fragment().getParentActivity() if get_last_fragment() else None)
                ),
            ),
            Divider(text="Поддерживаются ссылки tg://, буфер обмена, подписки по URL и отправка пачками Proxy# в Избранное."),
            Header(text="Полный бэкап плагина"),
            Text(
                text="Скопировать настройки и источники",
                icon="msg_copy",
                on_click=self._export_config_backup,
            ),
            Text(
                text="Восстановить всё из буфера",
                icon="msg_download",
                on_click=lambda _: self._restore_config_backup(_read_clipboard_text()),
            ),
            Divider(text="Сохраняет все настройки плагина и список источников в буфер обмена в формате JSON."),
            Header(text="Только источники"),
            Text(
                text="Скопировать источники",
                icon="msg_copy",
                on_click=lambda _: self._export_sources_backup(to_clipboard=True),
            ),
            Text(
                text="Отправить источники в Избранное",
                icon="msg_saved",
                on_click=lambda _: self._export_sources_backup(to_clipboard=False),
            ),
            Text(
                text="Восстановить источники из буфера",
                icon="msg_download",
                on_click=lambda _: self._restore_sources_backup(_read_clipboard_text()),
            ),
            Text(
                text="Вставить JSON источников",
                icon="msg_edit",
                on_click=lambda _: _show_input_sheet(
                    act or (get_last_fragment().getParentActivity() if get_last_fragment() else None),
                    "Восстановление источников",
                    '{"sources": ...}',
                    self._restore_sources_backup,
                    multiline=True,
                ),
            ),
        ]

    def create_settings(self) -> List[Any]:
        sources = self._get_sources()
        active_cnt = sum(1 for v in sources.values() if not v.get("paused", False))
        interval = self._get_interval_minutes()
        cnt_p, working_p, best_ms, best_host, cleanup_cnt = self._get_list_health_summary()
        sort_short = SORT_MODE_LABELS.get(self._get_sort_mode(), "Умная").split("(", 1)[0].strip()
        best_sub = f"{best_host} · {best_ms} мс" if best_ms > 0 else "Самый быстрый сервер"
        clean_sub = (
            f"К очистке: {cleanup_cnt} · Карантин: {len(self._dead_cache)}"
            if cleanup_cnt > 0
            else f"Карантин: {len(self._dead_cache)}"
        )
        flash_icon = self._pick_menu_icon("flash_on_solar", "flash_on", "msg_media_shuffle")

        return [
            self._build_autoscan_banner(),
            Divider(text="Автоматически собирает свежие прокси из выбранных каналов, чатов и ссылок-подписок."),
            Header(text="Управление"),
            Text(
                text="Собрать сейчас",
                subtext=f"Активно источников: {active_cnt} из {len(sources)}",
                icon="msg_retry",
                accent=True,
                on_click=lambda _: self._scan_sources_async(manual=True),
            ),
            Text(
                text="Проверить список",
                subtext=f"Рабочих: {working_p} из {cnt_p}",
                icon="msg_speed",
                accent=True,
                on_click=lambda _: self.ping_all_proxies_async(force=True, manual=True),
            ),
            Text(
                text="Подключить лучший",
                subtext=best_sub,
                icon=flash_icon,
                on_click=lambda _: self._connect_random_working_proxy(),
            ),
            Text(
                text="Очистить недоступные",
                subtext=clean_sub,
                icon="msg_delete",
                on_click=lambda _: self.purge_dead_proxies_ui(allow_auto_scan=True),
            ),
            Divider(),
            Header(text="Настройки"),
            Text(
                text="Источники и сбор",
                subtext=f"{active_cnt}/{len(sources)} · каждые {interval} мин",
                icon="msg_folders",
                create_sub_fragment=self._sub_sources,
            ),
            Text(
                text="Пинг, сортировка и Failover",
                subtext=sort_short,
                icon="msg_speed",
                create_sub_fragment=self._sub_ping_and_failover,
            ),
            Text(
                text="Очистка, GeoIP и вид",
                icon="msg_theme",
                create_sub_fragment=self._sub_cleanup_and_appearance,
            ),
            Text(
                text="Импорт, экспорт и бэкап",
                icon="msg_share",
                create_sub_fragment=self._sub_transfer_and_backup,
            ),
            Divider(),
            Header(text="Справка"),
            Text(
                text="Как это работает",
                icon="msg_info",
                on_click=self._show_guide_sheet,
            ),
        ]
