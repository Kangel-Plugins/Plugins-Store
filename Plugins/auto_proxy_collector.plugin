def _plog(msg: str):
    log(f"[ProxyCollector] {msg}")


def _resolve_jclass(cls_or_name: Any):
    c = find_class(cls_or_name) if isinstance(cls_or_name, str) else cls_or_name
    if c is None:
        return None
    if hasattr(c, "getDeclaredMethods"):
        return c
    if hasattr(c, "getClass"):
        try:
            c2 = c.getClass()
            if hasattr(c2, "getDeclaredMethods"):
                return c2
        except Exception:
            pass
    return c


def _get_cached_classes() -> Tuple[Any, Any, Any]:
    SharedConfig.loadProxyList()
    if "PC_cls" not in _JAVA_CACHE:
        _JAVA_CACHE["PC_cls"] = jclass("com.exteragram.messenger.proxy.ProxyController")
    if "ProxyInfo_cls" not in _JAVA_CACHE:
        _JAVA_CACHE["ProxyInfo_cls"] = jclass("org.telegram.messenger.SharedConfig$ProxyInfo")
    if "PS_cls" not in _JAVA_CACHE:
        _JAVA_CACHE["PS_cls"] = jclass("org.telegram.utils.proxy.ProxySettings")
    return (
        _JAVA_CACHE["PC_cls"].getInstance(),
        _JAVA_CACHE["ProxyInfo_cls"],
        _JAVA_CACHE["PS_cls"],
    )


def _elapsed_ms() -> int:
    try:
        return int(SystemClock.elapsedRealtime())
    except Exception:
        return int(time.monotonic() * 1000)


def _get_network_signature() -> str:
    try:
        ctx = ApplicationLoader.applicationContext
        cm = ctx.getSystemService(Context.CONNECTIVITY_SERVICE)
        if cm is None:
            return "unknown"
        info = cm.getActiveNetworkInfo()
        if info is None or not info.isConnected():
            return "offline"
        ntype = int(info.getType())
        if ntype == 1:
            return "wifi"
        if ntype == 0:
            return "mobile"
        if ntype == 17:
            return "vpn"
        return f"net_{ntype}"
    except Exception:
        return "unknown"


def _is_screen_interactive() -> bool:
    try:
        ctx = ApplicationLoader.applicationContext
        pm = ctx.getSystemService(Context.POWER_SERVICE)
        if pm is not None and hasattr(pm, "isInteractive"):
            return bool(pm.isInteractive())
    except Exception:
        pass
    return True


def _is_local_host(addr: str) -> bool:
    h = (addr or "").split("/")[0].strip().lower()
    return h in ("127.0.0.1", "localhost", "::1", "0.0.0.0") or h.startswith("127.")


def _normalize_dialog_id(raw_id: Any) -> int:
    try:
        val = int(str(raw_id).strip())
    except Exception:
        return 0
    if val == 0:
        return 0
    s = str(abs(val))
    if val < 0 and s.startswith("100") and len(s) >= 12:
        try:
            return -int(s[3:])
        except Exception:
            pass
    return val


def _make_source_key(dialog_id: int, topic_id: int = 0) -> str:
    did = _normalize_dialog_id(dialog_id)
    tid = int(topic_id or 0)
    return f"{did}_{tid}" if tid > 0 else f"{did}"


def _make_url_source_key(url: str) -> str:
    digest = hashlib.sha1(url.strip().encode("utf-8")).hexdigest()[:12]
    return f"url_{digest}"


def _parse_source_key(key: str, meta: Optional[Dict[str, Any]] = None) -> Tuple[int, int]:
    if meta:
        if meta.get("type") == "url" or str(key).startswith("url_"):
            return 0, 0
        did = _normalize_dialog_id(meta.get("dialog_id", 0))
        tid = int(meta.get("topic_id", 0) or 0)
        if did != 0:
            return did, tid
    s = str(key)
    if s.startswith("url_"):
        return 0, 0
    if "_" in s:
        p1, p2 = s.split("_", 1)
        return _normalize_dialog_id(p1), int(p2 or 0)
    return _normalize_dialog_id(s), 0


def _get_dialog_title(dialog_id: int) -> str:
    try:
        acc = int(UserConfig.selectedAccount)
        mc = MessagesController.getInstance(acc)
        if dialog_id > 0:
            user = mc.getUser(dialog_id)
            if user is not None:
                first = str(getattr(user, "first_name", "") or "").strip()
                last = str(getattr(user, "last_name", "") or "").strip()
                full = f"{first} {last}".strip()
                if full:
                    return full
                uname = str(getattr(user, "username", "") or "").strip()
                if uname:
                    return f"@{uname}"
        else:
            chat = mc.getChat(-dialog_id)
            if chat is not None:
                title = str(getattr(chat, "title", "") or "").strip()
                if title:
                    return title
    except Exception:
        pass
    return f"Чат {dialog_id}"


def _is_forum_chat(dialog_id: int) -> bool:
    if dialog_id >= 0:
        return False
    try:
        acc = int(UserConfig.selectedAccount)
        chat = MessagesController.getInstance(acc).getChat(-dialog_id)
        if chat is not None:
            return bool(getattr(chat, "forum", False))
    except Exception:
        pass
    return False


def _get_fragment_topic_id(frag: Any) -> int:
    if frag is None:
        return 0
    try:
        if hasattr(frag, "getTopicId"):
            tid = int(frag.getTopicId() or 0)
            if tid > 0:
                return tid
    except Exception:
        pass
    try:
        tid = int(get_private_field(frag, "topicId") or 0)
        if tid > 0:
            return tid
    except Exception:
        pass
    try:
        thread_msg = get_private_field(frag, "threadMessageObject")
        if thread_msg is not None and hasattr(thread_msg, "getId"):
            tid = int(thread_msg.getId() or 0)
            if tid > 0:
                return tid
    except Exception:
        pass
    return 0


def _get_message_topic_id(tl_msg: Any, mo: Any = None) -> int:
    try:
        if mo is not None and hasattr(mo, "getTopicId"):
            tid = int(mo.getTopicId() or 0)
            if tid > 0:
                return tid
    except Exception:
        pass
    try:
        reply_to = getattr(tl_msg, "reply_to", None)
        if reply_to is None:
            return 1
        top_id = int(getattr(reply_to, "reply_to_top_id", 0) or 0)
        if top_id > 0:
            return top_id
        if bool(getattr(reply_to, "forum_topic", False)):
            msg_id = int(getattr(reply_to, "reply_to_msg_id", 0) or 0)
            if msg_id > 0:
                return msg_id
    except Exception:
        pass
    return 1


def _get_drawable_res(name: str, fallback: int = 0) -> int:
    if not name:
        return fallback
    cached = _DRAWABLE_CACHE.get(name)
    if cached is not None:
        return cached if cached != 0 else fallback

    res_id = 0
    try:
        val = getattr(R_tg.drawable, name, None)
        if val is not None:
            res_id = int(val)
    except Exception:
        pass
    if res_id == 0:
        try:
            ctx = ApplicationLoader.applicationContext
            res_id = int(ctx.getResources().getIdentifier(name, "drawable", ctx.getPackageName()) or 0)
        except Exception:
            pass
    _DRAWABLE_CACHE[name] = res_id
    return res_id if res_id != 0 else fallback


