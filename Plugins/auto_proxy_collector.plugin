                hidden_card = LinearLayout(act)
                hidden_card.setOrientation(LinearLayout.VERTICAL)
                hidden_card.setPadding(
                    AndroidUtilities.dp(8),
                    AndroidUtilities.dp(8),
                    AndroidUtilities.dp(8),
                    AndroidUtilities.dp(8),
                )
                hc_bg = GradientDrawable()
                hc_bg.setCornerRadius(AndroidUtilities.dp(16))
                try:
