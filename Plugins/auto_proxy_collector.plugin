    r"(?<![@\d.])((?:25[0-5]|2[0-4]\d|1?\d?\d)(?:\.(?:25[0-5]|2[0-4]\d|1?\d?\d)){3}):(\d{2,5})(?::([^\s:;,\n]+)(?::([^\s:;,\n]+))?)?\b"
)

