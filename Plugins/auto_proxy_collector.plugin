    if cell is not None:
        for fname in ("threeDotsDrawable", "checkDrawable", "dotsDrawable"):
            try:
                dr = get_private_field(cell, fname)
                if dr is not None and hasattr(dr, "stop"):
                    dr.stop()
            except Exception:
