                text="Пункт в меню чата (⋮)",
                default=True,
                on_change=lambda v: (
                    self.set_setting("show_chat_menu", bool(v), reload_settings=False),
                    self._sync_chat_menu(bool(v)),
                ),
            ),
            Switch(
                key="show_msg_menu",
                text="Пункт «Собрать прокси из поста»",
                default=True,
                on_change=lambda v: (
                    self.set_setting("show_msg_menu", bool(v), reload_settings=False),
                    self._sync_msg_menu(bool(v)),
                ),
            ),
            Switch(
                key="show_bulletin",
                text="Всплывающие уведомления",
                default=True,
            ),
        ]

    def _sub_backup(self) -> List[Any]:
        frag = get_last_fragment()
        act = frag.getParentActivity() if frag else None
        return [
            Header(text="Экспорт конфигурации источников"),
            Text(
                text="Скопировать JSON в буфер обмена",
                icon="msg_copy",
                on_click=lambda _: self._export_sources_backup(to_clipboard=True),
            ),
            Text(
                text="Отправить бэкап в Избранное",
                icon="msg_saved",
                on_click=lambda _: self._export_sources_backup(to_clipboard=False),
            ),
            Divider(),
            Header(text="Восстановление"),
            Text(
                text="Восстановить из буфера обмена",
                icon="msg_download",
                on_click=lambda _: self._restore_sources_backup(_read_clipboard_text()),
            ),
            Text(
                text="Вставить JSON вручную",
                icon="msg_edit",
                on_click=lambda _: _show_input_sheet(
                    act or (get_last_fragment().getParentActivity() if get_last_fragment() else None),
                    "Восстановление источников",
                    '{"sources": ...}',
                    self._restore_sources_backup,
                    multiline=True,
                ),
            ),
        ]

    def create_settings(self) -> List[Any]:
        sources = self._get_sources()
        active_cnt = sum(1 for v in sources.values() if not v.get("paused", False))
        interval = self._get_interval_minutes()
        max_lim = self._get_max_proxy_limit()
        strikes = self._get_strike_limit()

        return [
            Header(text="Управление"),
            Switch(
                key="enabled",
                text="Автосбор прокси",
                subtext="Фоновый сбор из выбранных источников",
                default=True,
                icon="msg_proxy",
            ),
            Text(
                text="Собрать прокси сейчас",
                icon="msg_retry",
                accent=True,
                on_click=lambda _: self._scan_sources_async(manual=True),
            ),
            Text(
                text="Проверить и очистить мёртвые",
                icon="msg_delete",
                accent=True,
                on_click=lambda _: self.cleanup_dead_proxies_async(manual_trigger=True),
            ),
            Text(
                text="Импорт и экспорт прокси",
                icon="msg_share",
                on_click=lambda _: self._open_import_export_hub_sheet(get_last_fragment()),
            ),
            Divider(),
            Header(text="Параметры"),
            Text(
                text="Источники и парсинг",
                subtext=f"Активно: {active_cnt} из {len(sources)} · Каждые {interval} мин",
                icon="msg_folders",
                create_sub_fragment=self._sub_sources,
            ),
            Text(
                text="Проверка, очистка и Failover",
                subtext=f"Лимит: {max_lim} · Страйки: {strikes} · Кэш мёртвых",
                icon="msg_settings",
                create_sub_fragment=self._sub_cleaning,
            ),
            Text(
                text="Оформление списка прокси",
                subtext="Флаги, DPI-значки, цвет пинга, меню шапки",
                icon="msg_theme",
                create_sub_fragment=self._sub_appearance,
            ),
            Text(
                text="Резервное копирование",
                subtext="Экспорт и восстановление списка источников",
                icon="msg_saved",
                create_sub_fragment=self._sub_backup,
            ),
            Divider(),
            Header(text="Справка"),
            Text(
                text="Как это работает",
                icon="msg_info",
                on_click=self._show_guide_sheet,
            ),
        ]