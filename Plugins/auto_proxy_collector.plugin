                        if on
                        else Theme.getColor(Theme.key_dialogTextGray3)
                    )

                def toggle_edit_btn(_v):
                    cur = bool(self.get_setting("show_edit_menu_btn", True))
                    self.set_setting("show_edit_menu_btn", not cur, reload_settings=False)
                    refresh_edit_btn_toggle()

                refresh_edit_btn_toggle()
                edit_btn_toggle_row.setOnClickListener(OnClickListener(toggle_edit_btn))
                _apply_press_scale(edit_btn_toggle_row, 0.98)
                scroll_body.addView(edit_btn_toggle_row, LayoutHelper.createLinear(-1, -2, 0, 0, 0, 6))

                scroll.addView(scroll_body)
                root.addView(scroll, LayoutHelper.createLinear(-1, 0, 1.0))

                bottom_row = LinearLayout(act)
                bottom_row.setOrientation(LinearLayout.HORIZONTAL)

                btn_reset = TextView(act)
                btn_reset.setText("Сбросить")
                btn_reset.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 15)
                btn_reset.setTypeface(AndroidUtilities.getTypeface("fonts/rmedium.ttf"))
                btn_reset.setGravity(Gravity.CENTER)
                btn_reset.setTextColor(Theme.getColor(Theme.key_dialogTextBlue))
                btn_reset.setPadding(0, AndroidUtilities.dp(13), 0, AndroidUtilities.dp(13))
                r_bg = GradientDrawable()
                r_bg.setCornerRadius(AndroidUtilities.dp(14))
                try:
                    r_bg.setColor(Theme.getColor(Theme.key_windowBackgroundGray))
                except Exception:
                    r_bg.setColor(0x20808080)
                btn_reset.setBackground(r_bg)
                btn_reset.setClickable(True)
                _apply_press_scale(btn_reset, 0.97)
                bottom_row.addView(btn_reset, LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1.0))

                bottom_row.addView(View(act), LayoutHelper.createLinear(10, 1))

                btn_done = TextView(act)
                btn_done.setText("Готово")
                btn_done.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 15)
                btn_done.setTypeface(AndroidUtilities.getTypeface("fonts/rmedium.ttf"))
                btn_done.setGravity(Gravity.CENTER)
                btn_done.setTextColor(Theme.getColor(Theme.key_featuredStickers_buttonText))
                btn_done.setPadding(0, AndroidUtilities.dp(13), 0, AndroidUtilities.dp(13))
                d_bg = GradientDrawable()
                d_bg.setCornerRadius(AndroidUtilities.dp(14))
                d_bg.setColor(Theme.getColor(Theme.key_featuredStickers_addButton))
                btn_done.setBackground(d_bg)
                btn_done.setClickable(True)
                btn_done.setOnClickListener(OnClickListener(lambda _v: sheet.dismiss()))
                _apply_press_scale(btn_done, 0.97)
                bottom_row.addView(btn_done, LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1.4))

                root.addView(bottom_row, LayoutHelper.createLinear(-1, -2, 0, 12, 0, 0))

                init_order, init_disabled = self._get_header_tools_config()
                state = {
                    "active": [k for k in init_order if k not in init_disabled],
                    "hidden": [k for k in init_order if k in init_disabled],
                }
                handler = Handler(Looper.getMainLooper())
                touch_slop = ViewConfiguration.get(act).getScaledTouchSlop()
                row_gap = AndroidUtilities.dp(6)

                def persist_state():
                    full_order = list(state["active"]) + list(state["hidden"])
                    self._save_header_tools_config(full_order, set(state["hidden"]), reload_ui=False)

                def make_empty_placeholder(text: str):
                    tv_emp = TextView(act)
                    tv_emp.setText(text)
                    tv_emp.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13)
                    tv_emp.setTextColor(Theme.getColor(Theme.key_dialogTextGray3))
                    tv_emp.setGravity(Gravity.CENTER)
                    tv_emp.setPadding(0, AndroidUtilities.dp(12), 0, AndroidUtilities.dp(12))
                    return tv_emp

                def rebuild_lists():
                    active_card.removeAllViews()
                    hidden_card.removeAllViews()

                    active_rows: List[Any] = []

                    if not state["active"]:
                        active_card.addView(make_empty_placeholder("Нет активных пунктов — нажмите на скрытый ниже"))
                    else:
                        for idx, key in enumerate(state["active"]):
                            label, ico_name, is_red = HEADER_TOOLS_META[key]
                            row = FrameLayout(act)
                            row.setPadding(
                                AndroidUtilities.dp(14),
                                AndroidUtilities.dp(11),
                                AndroidUtilities.dp(10),
                                AndroidUtilities.dp(11),
                            )
                            r_bg = GradientDrawable()
                            r_bg.setCornerRadius(AndroidUtilities.dp(12))
                            r_bg.setColor(Theme.getColor(Theme.key_dialogBackground))
                            row.setBackground(r_bg)

                            inner = LinearLayout(act)
                            inner.setOrientation(LinearLayout.HORIZONTAL)
                            inner.setGravity(Gravity.CENTER_VERTICAL)

                            acc_col = (
                                Theme.getColor(Theme.key_text_RedRegular)
                                if is_red
                                else Theme.getColor(Theme.key_dialogTextBlue)
                            )
                            txt_col = (
                                Theme.getColor(Theme.key_text_RedRegular)
                                if is_red
                                else Theme.getColor(Theme.key_dialogTextBlack)
                            )

                            ico_res = _get_drawable_res(ico_name, _get_drawable_res("msg_retry", 0))
                            if ico_res:
                                iv = ImageView(act)
                                iv.setImageResource(ico_res)
                                iv.setScaleType(ImageView.ScaleType.CENTER)
                                iv.setColorFilter(acc_col)
                                inner.addView(iv, LayoutHelper.createLinear(24, 24, Gravity.CENTER_VERTICAL, 0, 0, 12, 0))

                            tv = TextView(act)
                            tv.setText(label)
                            tv.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 15)
                            tv.setTextColor(txt_col)
                            tv.setTypeface(AndroidUtilities.getTypeface("fonts/rmedium.ttf"))
                            inner.addView(tv, LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1.0))

                            drag_ico = _get_drawable_res("list_reorder", _get_drawable_res("msg_list", 0))
                            if drag_ico:
                                iv_drag = ImageView(act)
                                iv_drag.setImageResource(drag_ico)
                                iv_drag.setScaleType(ImageView.ScaleType.CENTER)
                                iv_drag.setColorFilter(Theme.getColor(Theme.key_dialogTextGray3))
                                inner.addView(iv_drag, LayoutHelper.createLinear(32, 24, Gravity.CENTER_VERTICAL, 6, 0, 2, 0))

                            row.addView(inner, FrameLayout.LayoutParams(-1, -2))
                            active_rows.append(row)
                            active_card.addView(
                                row,
                                LayoutHelper.createLinear(-1, -2, 0, 0 if idx == 0 else 6, 0, 0),
                            )

                    for row_idx, row_view in enumerate(active_rows):
                        item_key = state["active"][row_idx]

                        class _DragOrTapListener(dynamic_proxy(View.OnTouchListener)):
                            def __init__(self, r_idx: int, r_v: Any, k_str: str):
                                super().__init__()
                                self.r_idx = r_idx
                                self.r_v = r_v
                                self.k_str = k_str
                                self.start_raw_y = 0.0
                                self.dragging = False
                                self.moved_far = False
                                self.target_idx = r_idx
                                self.last_offsets: Dict[int, float] = {}
                                self.lp_cb = None

                            def _begin_drag(self):
                                if self.dragging:
                                    return
                                self.dragging = True
                                try:
                                    scroll.requestDisallowInterceptTouchEvent(True)
                                except Exception:
                                    pass
                                try:
                                    self.r_v.performHapticFeedback(HapticFeedbackConstants.LONG_PRESS)
                                except Exception:
                                    pass
                                try:
                                    self.r_v.setTranslationZ(float(AndroidUtilities.dp(8)))
                                    self.r_v.animate().scaleX(1.03).scaleY(1.03).alpha(0.95).setDuration(110).start()
                                except Exception:
                                    pass

                            def _cancel_lp(self):
                                if self.lp_cb is not None:
                                    try:
                                        handler.removeCallbacks(self.lp_cb)
                                    except Exception:
                                        pass
                                    self.lp_cb = None

                            def onTouch(self, v, event):
                                act_code = event.getActionMasked()
                                if act_code == MotionEvent.ACTION_DOWN:
                                    self.start_raw_y = float(event.getRawY())
                                    self.dragging = False
                                    self.moved_far = False
                                    self.target_idx = self.r_idx
                                    self.last_offsets.clear()

                                    w = float(self.r_v.getWidth() or 0)
                                    x = float(event.getX() or 0)
                                    if w > 0 and x >= (w - float(AndroidUtilities.dp(54))):
                                        self._begin_drag()
                                    else:
                                        self.r_v.animate().scaleX(0.97).scaleY(0.97).setDuration(90).start()

                                        class _LPRun(dynamic_proxy(Runnable)):
                                            def run(self_r):
                                                if not self.moved_far:
                                                    self._begin_drag()

                                        self.lp_cb = _LPRun()
                                        handler.postDelayed(self.lp_cb, 230)
                                    return True

                                elif act_code == MotionEvent.ACTION_MOVE:
                                    dy = float(event.getRawY()) - self.start_raw_y
                                    if not self.dragging:
                                        if abs(dy) > touch_slop:
                                            self.moved_far = True
                                            self._cancel_lp()
                                            self.r_v.animate().scaleX(1.0).scaleY(1.0).setDuration(100).start()
                                            return False
                                        return True

                                    self.r_v.setTranslationY(dy)
                                    step = float((self.r_v.getHeight() or AndroidUtilities.dp(46)) + row_gap)
                                    shift = int(round(dy / max(1.0, step)))
                                    new_t = max(0, min(len(active_rows) - 1, self.r_idx + shift))
                                    self.target_idx = new_t

                                    for j, other_v in enumerate(active_rows):
                                        if j == self.r_idx:
                                            continue
                                        if self.r_idx < j <= new_t:
                                            off = -step
                                        elif new_t <= j < self.r_idx:
                                            off = step
                                        else:
                                            off = 0.0
                                        if self.last_offsets.get(j, 0.0) != off:
                                            self.last_offsets[j] = off
                                            other_v.animate().translationY(off).setDuration(130).start()
                                    return True

                                elif act_code in (MotionEvent.ACTION_UP, MotionEvent.ACTION_CANCEL):
                                    self._cancel_lp()
                                    try:
                                        scroll.requestDisallowInterceptTouchEvent(False)
                                    except Exception:
                                        pass

                                    if self.dragging:
                                        self.dragging = False
                                        try:
                                            self.r_v.setTranslationZ(0.0)
                                        except Exception:
                                            pass
                                        if self.target_idx != self.r_idx and 0 <= self.r_idx < len(state["active"]):
                                            moved_k = state["active"].pop(self.r_idx)
                                            state["active"].insert(self.target_idx, moved_k)
                                            persist_state()
                                        rebuild_lists()
                                        return True

                                    self.r_v.animate().scaleX(1.0).scaleY(1.0).setDuration(120).start()
                                    if act_code == MotionEvent.ACTION_UP and not self.moved_far:
                                        if self.k_str in state["active"]:
                                            state["active"].remove(self.k_str)
                                            if self.k_str not in state["hidden"]:
                                                state["hidden"].append(self.k_str)
                                            persist_state()
                                            rebuild_lists()
                                    return True

                                return False

                        row_view.setOnTouchListener(_DragOrTapListener(row_idx, row_view, item_key))

                    if not state["hidden"]:
                        hidden_card.addView(make_empty_placeholder("Все пункты отображаются в меню"))
                    else:
                        for h_idx, h_key in enumerate(state["hidden"]):
                            label, ico_name, _ = HEADER_TOOLS_META[h_key]
                            h_row = FrameLayout(act)
                            h_row.setPadding(
                                AndroidUtilities.dp(14),
                                AndroidUtilities.dp(11),
                                AndroidUtilities.dp(14),
                                AndroidUtilities.dp(11),
                            )
                            hr_bg = GradientDrawable()
                            hr_bg.setCornerRadius(AndroidUtilities.dp(12))
                            hr_bg.setColor(Theme.getColor(Theme.key_dialogBackground))
                            try:
                                h_row.setBackground(RippleDrawable(ColorStateList.valueOf(0x25808080), hr_bg, None))
                            except Exception:
                                h_row.setBackground(hr_bg)

                            h_inner = LinearLayout(act)
                            h_inner.setOrientation(LinearLayout.HORIZONTAL)
                            h_inner.setGravity(Gravity.CENTER_VERTICAL)

                            ico_res = _get_drawable_res(ico_name, _get_drawable_res("msg_retry", 0))
                            if ico_res:
                                iv = ImageView(act)
                                iv.setImageResource(ico_res)
                                iv.setScaleType(ImageView.ScaleType.CENTER)
                                iv.setColorFilter(Theme.getColor(Theme.key_dialogTextGray3))
                                h_inner.addView(iv, LayoutHelper.createLinear(24, 24, Gravity.CENTER_VERTICAL, 0, 0, 12, 0))

                            tv = TextView(act)
                            tv.setText(label)
                            tv.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 15)
                            tv.setTextColor(Theme.getColor(Theme.key_dialogTextGray))
                            h_inner.addView(tv, LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1.0))

                            plus_ico = _get_drawable_res("msg_add", 0)
                            if plus_ico:
                                iv_p = ImageView(act)
                                iv_p.setImageResource(plus_ico)
                                iv_p.setScaleType(ImageView.ScaleType.CENTER)
                                iv_p.setColorFilter(Theme.getColor(Theme.key_dialogTextBlue))
                                h_inner.addView(iv_p, LayoutHelper.createLinear(24, 24, Gravity.CENTER_VERTICAL, 6, 0, 0, 0))

                            h_row.addView(h_inner, FrameLayout.LayoutParams(-1, -2))
                            h_row.setClickable(True)

                            def restore_item(_v, rk=h_key):
                                if rk in state["hidden"]:
                                    state["hidden"].remove(rk)
                                    if rk not in state["active"]:
                                        state["active"].append(rk)
                                    persist_state()
                                    rebuild_lists()

                            h_row.setOnClickListener(OnClickListener(restore_item))
                            _apply_press_scale(h_row, 0.97)
                            hidden_card.addView(
                                h_row,
                                LayoutHelper.createLinear(-1, -2, 0, 0 if h_idx == 0 else 6, 0, 0),
                            )

                def on_reset_click(_v):
                    state["active"] = list(DEFAULT_HEADER_TOOLS)
                    state["hidden"] = []
                    self.set_setting("show_edit_menu_btn", True, reload_settings=False)
                    refresh_edit_btn_toggle()
                    persist_state()
                    rebuild_lists()
                    BulletinHelper.show_success("Порядок сброшен")

                btn_reset.setOnClickListener(OnClickListener(on_reset_click))

                rebuild_lists()
                sheet.setCustomView(root)
                sheet.show()
            except Exception as e:
                _plog(f"tools editor err: {e}")

        run_on_ui_thread(ui)

    def _open_import_export_hub_sheet(self, fragment: Any):
        act = fragment.getParentActivity() if fragment else None
        if act is None:
            return

        def do_clip():
            raw = _read_clipboard_text()
            if not raw:
                BulletinHelper.show_error("Буфер обмена пуст")
                return
            parsed = extract_proxies_from_text(
                raw,
                allow_mtproto=True,
                allow_socks5=True,
                allow_web=True,
                only_faketls=bool(self.get_setting("only_faketls", False)),
            )
            self._save_proxies_native(parsed, manual=True, bypass_dead_cache=True)

        def do_url():
            _show_input_sheet(act, "Импорт по ссылке", "https://...", self._import_from_url_async, multiline=False)

        def do_text():
            _show_input_sheet(
                act,
                "Вставьте прокси",
                "tg://proxy?... или tg://webproxy?...",
                lambda txt: self._save_proxies_native(
                    extract_proxies_from_text(
                        txt,
                        allow_mtproto=True,
                        allow_socks5=True,
                        allow_web=True,
                        only_faketls=bool(self.get_setting("only_faketls", False)),
                    ),
                    manual=True,
                    bypass_dead_cache=True,
                ),
                multiline=True,
            )

        actions = [
            ("Импорт из буфера обмена", "msg_log", do_clip, False),
            ("Импорт по ссылке (URL / подписка)", "msg_link", do_url, False),
            ("Импорт текстом вручную", "msg_edit", do_text, False),
            ("Экспорт: все в буфер обмена", "msg_copy", lambda: self._export_proxies_ui(False, True), False),
            ("Экспорт: только рабочие в буфер", "msg_check", lambda: self._export_proxies_ui(True, True), False),
            ("Экспорт: все в Избранное", "msg_saved", lambda: self._export_proxies_ui(False, False), False),
            ("Экспорт: только рабочие в Избранное", "msg_send", lambda: self._export_proxies_ui(True, False), False),
        ]
        _show_action_sheet(act, "Импорт и экспорт прокси", actions)

    def _open_country_filter_sheet(self, act: Any):
        try:
            PC, _, _ = _get_cached_classes()
            pl = PC.getProxyList()
            if pl is None or int(pl.size()) == 0:
                BulletinHelper.show_info("Список прокси пуст")
                return

            counts: Dict[str, List[Any]] = {}
            for i in range(int(pl.size())):
                info = pl.get(i)
                if info is None:
                    continue
                _, _, srv, _, _, _, _ = _extract_proxy_details(info)
                h = _extract_connect_host(srv)
                geo = self._get_cached_geo(h)
                if geo and geo.get("cc"):
                    cc = geo["cc"]
                    flag = geo.get("flag", "")
                    counts.setdefault(cc, [0, flag])
                    counts[cc][0] += 1

            if not counts:
                BulletinHelper.show_info("Флаги стран ещё загружаются — подождите пару секунд")
                return

            actions = []
            for cc in sorted(counts.keys()):
                cnt, flag = counts[cc]
                actions.append(
                    (f"{flag} Оставить только {cc} ({cnt})", "msg_location", lambda c=cc: self._keep_only_country(c), False)
                )
            _show_action_sheet(act, "Фильтр по стране", actions, subtitle="Активный прокси и локальные туннели сохранятся")
        except Exception as e:
            BulletinHelper.show_error(f"Ошибка фильтра: {e}")

    def _keep_only_country(self, target_cc: str):
        try:
            PC, _, _ = _get_cached_classes()
            pl = PC.getProxyList()
            if pl is None:
                return
            active_key = _get_active_proxy_key(PC)
            to_del = []
            for i in range(int(pl.size())):
                info = pl.get(i)
                if info is None:
                    continue
                k, _, srv, _, _, _, _ = _extract_proxy_details(info)
                h = _extract_connect_host(srv)
                if k == active_key or _is_local_host(h):
                    continue
                geo = self._get_cached_geo(h)
                if geo and geo.get("cc") and geo["cc"] != target_cc:
                    to_del.append(info)

            removed = sum(1 for inf in to_del if _delete_proxy_from_controller(PC, inf))
            if removed > 0:
                _persist_proxy_controller(PC)
                _sync_fragment_proxy_list(PC, [pl.get(i) for i in range(int(pl.size()))])
                BulletinHelper.show_success(f"Удалено прокси других стран: {removed}")
            else:
                BulletinHelper.show_info("Нечего удалять")
        except Exception as e:
            BulletinHelper.show_error(f"Ошибка: {e}")

    def _open_import_sheet(self, act: Any):
        if act is None:
            frag = get_last_fragment()
            act = frag.getParentActivity() if frag else None
        if act is None:
            return

        def do_clip():
            raw = _read_clipboard_text()
            if not raw:
                BulletinHelper.show_error("Буфер обмена пуст")
                return
            parsed = extract_proxies_from_text(
                raw,
                allow_mtproto=True,
                allow_socks5=True,
                allow_web=True,
                only_faketls=bool(self.get_setting("only_faketls", False)),
            )
            self._save_proxies_native(parsed, manual=True, bypass_dead_cache=True)

        def do_url():
            _show_input_sheet(act, "Импорт по ссылке", "https://...", self._import_from_url_async, multiline=False)

        def do_text():
            _show_input_sheet(
                act,
                "Вставьте прокси",
                "tg://proxy?... или tg://webproxy?...",
                lambda txt: self._save_proxies_native(
                    extract_proxies_from_text(
                        txt,
                        allow_mtproto=True,
                        allow_socks5=True,
                        allow_web=True,
                        only_faketls=bool(self.get_setting("only_faketls", False)),
                    ),
                    manual=True,
                    bypass_dead_cache=True,
                ),
                multiline=True,
            )

        actions = [
            ("Из буфера обмена", "msg_log", do_clip, False),
            ("По ссылке (URL / подписка)", "msg_link", do_url, False),
            ("Вставить текст вручную", "msg_edit", do_text, False),
        ]
        _show_action_sheet(act, "Импорт прокси", actions)

    def _import_from_url_async(self, url: str):
        def worker():
            try:
                u = url.strip()
                if not u.startswith(("http://", "https://")):
                    u = "https://" + u
                req = urllib.request.Request(u, headers={"User-Agent": "Mozilla/5.0"})
                with urllib.request.urlopen(req, timeout=12.0) as resp:
                    body = resp.read().decode("utf-8", "ignore")
                parsed = extract_proxies_from_text(
                    body,
                    allow_mtproto=True,
                    allow_socks5=True,
                    allow_web=True,
                    only_faketls=bool(self.get_setting("only_faketls", False)),
                )
                self._save_proxies_native(parsed, manual=True, bypass_dead_cache=True)
            except Exception as e:
                run_on_ui_thread(lambda: BulletinHelper.show_error(f"Ошибка загрузки: {e}"))

        threading.Thread(target=worker, daemon=True).start()

    def _open_export_sheet(self, act: Any):
        if act is None:
            frag = get_last_fragment()
            act = frag.getParentActivity() if frag else None
        if act is None:
            return

        actions = [
            ("Скопировать все в буфер", "msg_copy", lambda: self._export_proxies_ui(False, True), False),
            ("Только рабочие в буфер", "msg_check", lambda: self._export_proxies_ui(True, True), False),
            ("Отправить все в Избранное", "msg_saved", lambda: self._export_proxies_ui(False, False), False),
            ("Только рабочие в Избранное", "msg_send", lambda: self._export_proxies_ui(True, False), False),
        ]
        _show_action_sheet(act, "Экспорт прокси", actions)

    def _export_proxies_ui(self, only_working: bool = False, to_clipboard: bool = True):
        try:
            PC, _, _ = _get_cached_classes()
            pl = PC.getProxyList()
            if pl is None or int(pl.size()) == 0:
                BulletinHelper.show_info("Нет прокси для экспорта")
                return

            faketls, padding, web, socks = [], [], [], []
            for i in range(int(pl.size())):
                info = pl.get(i)
                if info is None:
                    continue
                av, _ = _get_proxy_ping_and_avail(info)
                if only_working and not av:
                    continue
                _, kind, srv, port, sec, user, pwd = _extract_proxy_details(info)
                if not srv or _is_local_host(srv):
                    continue
                if kind == "web":
                    web.append(f"tg://webproxy?server={srv}&secret={sec}")
                elif kind == "mtproto":
                    entry = {
                        "addr": srv,
                        "port": port,
                        "secret": sec,
                        "line": f"tg://proxy?server={srv}&port={port}&secret={sec}",
                    }
                    (faketls if sec.lower().startswith("ee") else padding).append(entry)
                else:
                    line = f"tg://socks?server={srv}&port={port}"
                    if user:
                        line += f"&user={urllib.parse.quote(user, safe='')}"
                    if pwd:
                        line += f"&pass={urllib.parse.quote(pwd, safe='')}"
                    socks.append({"addr": srv, "port": port, "secret": "", "line": line})

            faketls.sort(key=_mtp_sort_key)
            padding.sort(key=_mtp_sort_key)
            web.sort()
            socks.sort(key=_mtp_sort_key)

            sections = []
            if faketls:
                sections.append("FakeTLS (MTProto):\n" + "\n".join(e["line"] for e in faketls))
            if padding:
                sections.append("Padding (MTProto):\n" + "\n".join(e["line"] for e in padding))
            if web:
                sections.append("WebProxy:\n" + "\n".join(web))
            if socks:
                sections.append("SOCKS5:\n" + "\n".join(e["line"] for e in socks))

            if not sections:
                BulletinHelper.show_info("Нет подходящих прокси для экспорта")
                return

            txt = "\n\n".join(sections)
            total = len(faketls) + len(padding) + len(web) + len(socks)

            if to_clipboard:
                if _write_clipboard_text(txt):
                    BulletinHelper.show_success(f"Скопировано в буфер: {total}")
                else:
                    BulletinHelper.show_error("Не удалось записать в буфер")
                return

            def send_bg():
                try:
                    uid = get_user_config().getClientUserId()
                    if len(txt.encode("utf-16-le")) // 2 <= 4096:
                        q = TLRPC.TL_messageEntityBlockquote()
                        q.collapsed = True
                        q.offset = 0
                        q.length = len(txt.encode("utf-16-le")) // 2
                        send_message({"peer": uid, "message": txt, "entities": [q]})
                        run_on_ui_thread(
                            lambda: BulletinHelper.show_success(f"Отправлено в Избранное: {total}")
                        )
                    else:
                        fp = os.path.join(get_cache_dir(), f"proxies_{int(time.time())}.txt")
                        write_file(fp, txt)
                        send_document(uid, fp, caption=f"Экспорт прокси ({total} шт.)")
                        run_on_ui_thread(
                            lambda: BulletinHelper.show_success(f"Отправлено файлом в Избранное ({total})")
                        )
                except Exception as e:
                    run_on_ui_thread(lambda: BulletinHelper.show_error(f"Ошибка отправки: {e}"))

            threading.Thread(target=send_bg, daemon=True).start()
        except Exception as e:
            BulletinHelper.show_error(f"Ошибка экспорта: {e}")

    def _start_periodic_timer(self):
        self._timer_token += 1
        tok = self._timer_token

        def _tick():
            if not self._alive or tok != self._timer_token:
                return
            if self.get_setting("enabled", True):
                should_run = True
                if self.get_setting("adaptive_timer", True):
                    if _get_network_signature() == "offline":
                        should_run = False
                    elif self.get_setting("skip_when_screen_off", True) and not _is_screen_interactive():
                        should_run = False
                if should_run:
                    self._scan_sources_async(manual=False)

            interval_min = self._get_interval_minutes()
            run_on_ui_thread(_tick, interval_min * 60 * 1000)

        run_on_ui_thread(_tick, 10000)

    def _process_source_messages_bg(
        self,
        source_key: str,
        tl_messages: List[Any],
        manual: bool = False,
        min_msg_id: int = 0,
    ):
        sources = self._get_sources()
        meta = sources.get(source_key, {})
        dialog_id, _ = _parse_source_key(source_key, meta)

        allow_mt = bool(self.get_setting("collect_mtproto", True))
        allow_sk = bool(self.get_setting("collect_socks5", True))
        allow_web = bool(self.get_setting("collect_web", True))
        only_faketls = bool(self.get_setting("only_faketls", False))
        parse_files = bool(self.get_setting("parse_attachments", True))
        ping_before_save = bool(self.get_setting("ping_before_save", False))
        use_handshake = bool(self.get_setting("real_handshake_ping", True))
        acc = int(UserConfig.selectedAccount)

        valid_msgs = [m for m in tl_messages if int(getattr(m, "id", 0) or 0) > min_msg_id]
        if not valid_msgs:
            if manual:
                run_on_ui_thread(lambda: BulletinHelper.show_info("Новых постов не найдено"))
            return

        valid_msgs.sort(key=lambda m: int(m.id))
        max_msg_id = max(int(m.id) for m in valid_msgs)

        extracted: List[ParsedProxy] = []
        seen_batch_keys: Set[str] = set()

        for msg in valid_msgs:
            for p in extract_proxies_from_message(
                msg,
                allow_mtproto=allow_mt,
                allow_socks5=allow_sk,
                allow_web=allow_web,
                only_faketls=only_faketls,
                parse_attachments=parse_files,
                account_id=acc,
            ):
                if p.key in seen_batch_keys:
                    continue
                if ping_before_save:
                    if _check_proxy_alive(
                        p.kind, p.server, p.port, p.secret, p.username, p.password, use_handshake, 3.5
                    ) is None:
                        continue
                seen_batch_keys.add(p.key)
                extracted.append(p)

        self._save_proxies_native(
            extracted,
            source_key=source_key,
            dialog_id=dialog_id,
            max_msg_id=max_msg_id,
            manual=manual,
        )

    def _process_url_source_bg(self, source_key: str, url: str, manual: bool = False):
        allow_mt = bool(self.get_setting("collect_mtproto", True))
        allow_sk = bool(self.get_setting("collect_socks5", True))
        allow_web = bool(self.get_setting("collect_web", True))
        only_faketls = bool(self.get_setting("only_faketls", False))
        ping_before_save = bool(self.get_setting("ping_before_save", False))
        use_handshake = bool(self.get_setting("real_handshake_ping", True))

        try:
            req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"})
            with urllib.request.urlopen(req, timeout=12.0) as resp:
                body = resp.read().decode("utf-8", "ignore")

            parsed = extract_proxies_from_text(
                body,
                allow_mtproto=allow_mt,
                allow_socks5=allow_sk,
                allow_web=allow_web,
                only_faketls=only_faketls,
            )

            if ping_before_save and parsed:
                parsed = [
                    p for p in parsed
                    if _check_proxy_alive(
                        p.kind, p.server, p.port, p.secret, p.username, p.password, use_handshake, 3.5
                    ) is not None
                ]

            self._save_proxies_native(parsed, source_key=source_key, manual=manual)
        except Exception as e:
            if manual:
                run_on_ui_thread(lambda: BulletinHelper.show_error(f"Ошибка подписки: {e}"))

    def _scan_sources_async(
        self,
        target_sources: Optional[Dict[str, Dict[str, Any]]] = None,
        manual: bool = True,
    ):
        if self._scanning:
            if manual:
                BulletinHelper.show_info("Сбор уже выполняется...")
            return

        all_sources = target_sources if target_sources is not None else self._get_sources()
        active_sources = {
            k: v for k, v in all_sources.items() if target_sources is not None or not v.get("paused", False)
        }

        if not active_sources:
            if manual:
                BulletinHelper.show_error("Нет активных источников")
            return

        if manual:
            BulletinHelper.show_info(f"Проверка источников ({len(active_sources)})...")

        def worker():
            self._scanning = True
            try:
                acc = int(UserConfig.selectedAccount)
                limit = self._get_scan_limit()
                single_mode = manual and len(active_sources) == 1

                for key, meta in list(active_sources.items()):
                    if not self._alive:
                        break
                    if meta.get("type") == "url" or str(key).startswith("url_"):
                        url = str(meta.get("url", "") or "")
                        if url:
                            self._process_url_source_bg(key, url, manual=single_mode)
                        continue

                    did, tid = _parse_source_key(key, meta)
                    if did == 0:
                        continue
                    saved_last_id = int(meta.get("last_msg_id", 0) or 0)
                    min_id = 0 if manual else saved_last_id

                    msgs = self._fetch_messages_sync(acc, did, tid, limit, min_id)
                    if msgs:
                        self._process_source_messages_bg(
                            key, msgs, manual=single_mode, min_msg_id=min_id
                        )
                    elif single_mode:
                        run_on_ui_thread(
                            lambda: BulletinHelper.show_info("В этом источнике постов не найдено")
                        )
                    time.sleep(0.25)
            except Exception as e:
                if manual:
                    run_on_ui_thread(lambda: BulletinHelper.show_error(f"Ошибка сбора: {e}"))
            finally:
                self._scanning = False

        threading.Thread(target=worker, daemon=True).start()

    def _fetch_messages_sync(
        self, account_id: int, dialog_id: int, topic_id: int, limit: int, min_msg_id: int = 0
    ) -> List[Any]:
        try:
            mc = MessagesController.getInstance(account_id)
            peer = mc.getInputPeer(int(dialog_id))
            if peer is None or isinstance(peer, TLRPC.TL_inputPeerEmpty):
                return []

            if topic_id > 1:
                req = TLRPC.TL_messages_getReplies()
                req.peer = peer
                req.msg_id = int(topic_id)
                req.offset_id = 0
                req.offset_date = 0
                req.add_offset = 0
                req.limit = limit
                req.max_id = 0
                req.min_id = 0
                req.hash = 0

                ev = threading.Event()
                box: List[Any] = [None]

                def _cb_rep(resp, err):
                    if err is None and resp is not None:
                        box[0] = getattr(resp, "messages", None)
                    ev.set()

                send_request(req, _cb_rep, account=account_id)
                ev.wait(timeout=10.0)

                raw_rep = box[0]
                if raw_rep is not None and hasattr(raw_rep, "size") and int(raw_rep.size()) > 0:
                    return [
                        raw_rep.get(i)
                        for i in range(int(raw_rep.size()))
                        if raw_rep.get(i) is not None
                        and int(getattr(raw_rep.get(i), "id", 0) or 0) > min_msg_id
                    ]

            req_hist = TLRPC.TL_messages_getHistory()
            req_hist.peer = peer
            req_hist.offset_id = 0
            req_hist.offset_date = 0
            req_hist.add_offset = 0
            req_hist.limit = limit if topic_id == 0 else max(limit, 80)
            req_hist.max_id = 0
            req_hist.min_id = 0
            req_hist.hash = 0

            ev2 = threading.Event()
            box2: List[Any] = [None]

            def _cb_hist(resp, err):
                if err is None and resp is not None:
                    box2[0] = getattr(resp, "messages", None)
                ev2.set()

            send_request(req_hist, _cb_hist, account=account_id)
            ev2.wait(timeout=10.0)

            raw_hist = box2[0]
            if raw_hist is None or not hasattr(raw_hist, "size"):
                return []

            out = []
            for i in range(int(raw_hist.size())):
                m = raw_hist.get(i)
                if m is None or int(getattr(m, "id", 0) or 0) <= min_msg_id:
                    continue
                if topic_id > 0 and _get_message_topic_id(m) != topic_id:
                    continue
                out.append(m)
            return out
        except Exception:
            return []

    def _fetch_forum_topics_and_prompt(self, dialog_id: int):
        base_title = _get_dialog_title(dialog_id)
        BulletinHelper.show_info(f"Загрузка топиков «{base_title}»...")

        def worker():
            topics: List[Tuple[int, str]] = []
            try:
                acc = int(UserConfig.selectedAccount)
                mc = MessagesController.getInstance(acc)

                try:
                    tc = mc.getTopicsController()
                    cached = tc.getTopics(-dialog_id) if tc is not None else None
                    if cached is not None and hasattr(cached, "size"):
                        for i in range(int(cached.size())):
                            t_obj = cached.get(i)
                            if t_obj is not None:
                                tid = int(getattr(t_obj, "id", 0) or 0)
                                t_title = str(getattr(t_obj, "title", "") or f"Топик #{tid}").strip()
                                if tid > 0:
                                    topics.append((tid, t_title))
                except Exception:
                    pass

                if not topics:
                    req_cls = find_class("org.telegram.tgnet.TLRPC$TL_channels_getForumTopics") or find_class(
                        "org.telegram.tgnet.tl.TL_forum$TL_messages_getForumTopics"
                    )
                    if req_cls is not None:
                        req = req_cls()
                        if hasattr(req, "channel"):
                            req.channel = mc.getInputChannel(-dialog_id)
                        elif hasattr(req, "peer"):
                            req.peer = mc.getInputPeer(int(dialog_id))
                        req.limit = 100

                        ev = threading.Event()
                        box: List[Any] = [None]

                        def _cb(resp, err):
                            if err is None and resp is not None:
                                box[0] = getattr(resp, "topics", None)
                            ev.set()

                        send_request(req, _cb, account=acc)
                        ev.wait(timeout=8.0)

                        raw_t = box[0]
                        if raw_t is not None and hasattr(raw_t, "size"):
                            for i in range(int(raw_t.size())):
                                t_obj = raw_t.get(i)
                                if t_obj is not None:
                                    tid = int(getattr(t_obj, "id", 0) or 0)
                                    t_title = str(getattr(t_obj, "title", "") or f"Топик #{tid}").strip()
                                    if tid > 0:
                                        topics.append((tid, t_title))
            except Exception:
                pass

            run_on_ui_thread(lambda: self._show_topic_picker_sheet(dialog_id, base_title, topics))

        threading.Thread(target=worker, daemon=True).start()

    def _show_topic_picker_sheet(
        self, dialog_id: int, base_title: str, topics: List[Tuple[int, str]]
    ):
        frag = get_last_fragment()
        act = frag.getParentActivity() if frag else None
        if act is None or not topics:
            disp = self._add_source(dialog_id, 0, base_title, reload_ui=True)
            BulletinHelper.show_success(f"Добавлен: {disp}")
            self._scan_sources_async(
                {_make_source_key(dialog_id, 0): {"type": "chat", "dialog_id": dialog_id, "topic_id": 0}}
            )
            return

        def pick_whole():
            disp = self._add_source(dialog_id, 0, base_title, reload_ui=True)
            BulletinHelper.show_success(f"Добавлен: {disp}")
            self._scan_sources_async(
                {_make_source_key(dialog_id, 0): {"type": "chat", "dialog_id": dialog_id, "topic_id": 0}}
            )

        def pick_topic(t_id: int, t_name: str):
            disp = self._add_source(dialog_id, t_id, f"{base_title} → {t_name}", reload_ui=True)
            BulletinHelper.show_success(f"Добавлен: {disp}")
            k = _make_source_key(dialog_id, t_id)
            self._scan_sources_async({k: {"type": "chat", "dialog_id": dialog_id, "topic_id": t_id}})

        actions = [(f"Весь форум «{base_title}» целиком", "msg_folders", pick_whole, False)]
        for tid, t_title in topics:
            actions.append((f"{t_title} (#{tid})", "msg_topic", lambda i=tid, n=t_title: pick_topic(i, n), False))

        _show_action_sheet(act, f"Выбор топика: {base_title}", actions)

    def _on_chat_menu_click(self, ctx: dict):
        frag = ctx.get("fragment") or get_last_fragment()
        raw_did = ctx.get("dialog_id")
        if raw_did is None and frag is not None and hasattr(frag, "getDialogId"):
            try:
                raw_did = frag.getDialogId()
            except Exception:
                pass
        if raw_did is None and frag is not None:
            raw_did = get_private_field(frag, "dialog_id")

        did = _normalize_dialog_id(raw_did)
        if did == 0:
            BulletinHelper.show_error("Не удалось определить чат")
            return

        is_forum = _is_forum_chat(did)
        tid = int(ctx.get("topic_id") or 0) or _get_fragment_topic_id(frag) if is_forum else 0

        act = frag.getParentActivity() if frag else None
        if act is None:
            return

        sources = self._get_sources()
        base_title = _get_dialog_title(did)
        topic_key = _make_source_key(did, tid)
        whole_key = _make_source_key(did, 0)
        header = f"{base_title} [Топик #{tid}]" if tid > 0 else base_title

        def scan_now():
            target = {topic_key: {"type": "chat", "dialog_id": did, "topic_id": tid}}
            self._scan_sources_async(target_sources=target, manual=True)

        def toggle_current():
            if topic_key in sources:
                sources.pop(topic_key, None)
                self._save_sources(sources, reload_ui=False)
                BulletinHelper.show_info(f"«{header}» убран из автосбора")
            else:
                self._add_source(did, tid, header, reload_ui=False)
                BulletinHelper.show_success(f"«{header}» добавлен")
                self._scan_sources_async(
                    target_sources={topic_key: {"type": "chat", "dialog_id": did, "topic_id": tid}},
                    manual=True,
                )

        actions = [("Собрать прокси сейчас", "msg_retry", scan_now, False)]
        if tid > 0:
            in_t = topic_key in sources
            actions.append(
                (
                    f"Убрать топик #{tid} из автосбора" if in_t else f"Автосбор из топика #{tid}",
                    "msg_delete" if in_t else "msg_add",
                    toggle_current,
                    in_t,
                )
            )
            in_w = whole_key in sources

            def toggle_whole():
                if whole_key in sources:
                    sources.pop(whole_key, None)
                    self._save_sources(sources, reload_ui=False)
                    BulletinHelper.show_info(f"Весь форум «{base_title}» убран")
                else:
                    self._add_source(did, 0, base_title, reload_ui=False)
                    BulletinHelper.show_success(f"Весь форум «{base_title}» добавлен")
                    self._scan_sources_async(
                        target_sources={whole_key: {"type": "chat", "dialog_id": did, "topic_id": 0}},
                        manual=True,
                    )

            actions.append(
                (
                    "Убрать весь форум из автосбора" if in_w else "Автосбор всего форума",
                    "msg_delete" if in_w else "msg_folders",
                    toggle_whole,
                    in_w,
                )
            )
        else:
            in_w = whole_key in sources
            actions.append(
                (
                    "Убрать чат из автосбора" if in_w else "Добавить чат в автосбор",
                    "msg_delete" if in_w else "msg_add",
                    toggle_current,
                    in_w,
                )
            )

        _show_action_sheet(act, header, actions)

    def _open_add_source_sheet(self, _v=None):
        frag = get_last_fragment()
        act = frag.getParentActivity() if frag else None
        if act is None:
            return

        def add_url():
            def on_url(u: str):
                name = self._add_url_source(u, reload_ui=True)
                BulletinHelper.show_success(f"Подписка добавлена: {name}")
                key = _make_url_source_key(u if u.startswith(("http://", "https://")) else "https://" + u)
                src = self._get_sources().get(key)
                if src:
                    self._scan_sources_async({key: src}, manual=True)

            _show_input_sheet(act, "URL-подписка", "https://...", on_url, multiline=False)

        actions = [
            ("Чат, группа, канал или топик", "msg_groups", self._open_picker, False),
            ("URL-подписка (HTTP / HTTPS)", "msg_link", add_url, False),
        ]
        _show_action_sheet(act, "Новый источник", actions)

    def _open_picker(self):
        frag = get_last_fragment()
        if frag is None:
            return
        try:
            args = Bundle()
            args.putBoolean("onlySelect", True)
            args.putBoolean("canSelectTopics", True)
            args.putInt("dialogsType", 0)

            picker = DialogsActivity(args)

            def on_picked(did: int, tid: int):
                self._picker_delegate = None
                if did == 0:
                    return

                def after_close():
                    if tid == 0 and _is_forum_chat(did):
                        self._fetch_forum_topics_and_prompt(did)
                        return
                    disp = self._add_source(did, tid, reload_ui=True)
                    BulletinHelper.show_success(f"Добавлен: {disp}")
                    key = _make_source_key(did, tid)
                    self._scan_sources_async({key: {"type": "chat", "dialog_id": did, "topic_id": tid}})

                run_on_ui_thread(after_close, 250)

            self._picker_delegate = SourcePickerDelegate(on_picked)
            picker.setDelegate(self._picker_delegate)
            frag.presentFragment(picker)
        except Exception:
            pass

    def _show_sources_manager_sheet(self, _v=None):
        frag = get_last_fragment()
        act = frag.getParentActivity() if frag else None
        if act is None:
            return

        sources = self._get_sources()
        if not sources:
            BulletinHelper.show_info("Список источников пуст")
            return

        actions = []
        for k, meta in sources.items():
            paused = bool(meta.get("paused", False))
            ico = "msg_media_stop" if paused else ("msg_link" if meta.get("type") == "url" else "msg_channel")
            prefix = "[Пауза] " if paused else ""
            title = f"{prefix}{meta.get('title', k)} (+{int(meta.get('added_count', 0) or 0)})"
            actions.append((title, ico, lambda key=k: self._open_single_source_sheet(act, key), paused))

        def reset_all():
            for k in sources:
                if "last_msg_id" in sources[k]:
                    sources[k]["last_msg_id"] = 0
            self._save_sources(sources, reload_ui=True)
            BulletinHelper.show_info("Чекпоинты сброшены")
            self._scan_sources_async(manual=True)

        actions.append(("Сбросить все чекпоинты", "msg_retry", reset_all, False))
        _show_action_sheet(act, f"Источники ({len(sources)})", actions)

    def _open_single_source_sheet(self, act: Any, key: str):
        sources = self._get_sources()
        meta = sources.get(key)
        if not meta:
            return
        paused = bool(meta.get("paused", False))
        title = meta.get("title", key)

        def toggle_pause():
            sources[key]["paused"] = not paused
            self._save_sources(sources, reload_ui=True)
            BulletinHelper.show_info("Поставлен на паузу" if not paused else "Автосбор возобновлён")

        def delete_src():
            sources.pop(key, None)
            self._save_sources(sources, reload_ui=True)
            BulletinHelper.show_info(f"Удалён: {title}")

        actions = [
            ("Возобновить автосбор" if paused else "Поставить на паузу", "msg_play" if paused else "msg_media_stop", toggle_pause, False),
            ("Собрать прокси сейчас", "msg_retry", lambda: self._scan_sources_async({key: meta}, manual=True), False),
            ("Удалить источник", "msg_delete", delete_src, True),
        ]
        _show_action_sheet(act, title, actions)

    def _export_sources_backup(self, to_clipboard: bool):
        sources = self._get_sources()
        if not sources:
            BulletinHelper.show_info("Список источников пуст")
            return
        payload = json.dumps({"proxy_collector_backup": 1, "sources": sources}, ensure_ascii=False, indent=2)
        if to_clipboard:
            if _write_clipboard_text(payload):
                BulletinHelper.show_success(f"Бэкап скопирован ({len(sources)} ист.)")
            else:
                BulletinHelper.show_error("Ошибка копирования")
            return

        def send_bg():
            try:
                uid = get_user_config().getClientUserId()
                if len(payload.encode("utf-16-le")) // 2 <= 4000:
                    send_message({"peer": uid, "message": payload})
                else:
                    fp = os.path.join(get_cache_dir(), "proxy_sources_backup.json")
                    write_file(fp, payload)
                    send_document(uid, fp, caption="Резервная копия источников Proxy Collector")
                run_on_ui_thread(lambda: BulletinHelper.show_success("Бэкап отправлен в Избранное"))
            except Exception as e:
                run_on_ui_thread(lambda: BulletinHelper.show_error(f"Ошибка отправки: {e}"))

        threading.Thread(target=send_bg, daemon=True).start()

    def _restore_sources_backup(self, raw_json: str):
        try:
            data = json.loads(raw_json.strip())
            incoming = data.get("sources") if isinstance(data, dict) and "sources" in data else data
            if not isinstance(incoming, dict) or not incoming:
                BulletinHelper.show_error("Некорректный формат резервной копии")
                return
            current = self._get_sources()
            restored = 0
            for k, meta in incoming.items():
                if isinstance(meta, dict) and k not in current:
                    current[k] = meta
                    restored += 1
            self._save_sources(current, reload_ui=True)
            BulletinHelper.show_success(f"Восстановлено новых источников: {restored}")
        except Exception as e:
            BulletinHelper.show_error(f"Ошибка чтения JSON: {e}")

    def _get_closest_index(self, key: str, default_val: int, choices: Tuple[int, ...]) -> int:
        try:
            val = int(self.get_setting(key, default_val))
        except Exception:
            val = default_val
        return min(range(len(choices)), key=lambda i: abs(choices[i] - val))

    def _get_interval_minutes(self) -> int:
        return INTERVAL_MINUTES[self._get_closest_index("interval_min", 5, INTERVAL_MINUTES)]

    def _get_scan_limit(self) -> int:
        return SCAN_LIMITS[self._get_closest_index("scan_limit", 25, SCAN_LIMITS)]

    def _get_max_proxy_limit(self) -> int:
        return MAX_PROXY_LIMITS[self._get_closest_index("max_proxy_limit", 100, MAX_PROXY_LIMITS)]

    def _get_max_per_host(self) -> int:
        return MAX_PER_HOST_LIMITS[self._get_closest_index("max_per_host", 0, MAX_PER_HOST_LIMITS)]

    def _get_strike_limit(self) -> int:
        return STRIKE_LIMITS[self._get_closest_index("strikes_limit", 3, STRIKE_LIMITS)]

    def _get_dead_ttl_hours(self) -> int:
        return DEAD_TTL_HOURS[self._get_closest_index("dead_ttl_hours", 24, DEAD_TTL_HOURS)]

    def _build_slider(
        self, key: str, default_val: int, choices: Tuple[int, ...], suffix: str = ""
    ) -> Any:
        chosen_idx = self._get_closest_index(key, default_val, choices)
        labels = [f"{c}{suffix}" if c > 0 else "Выкл" for c in choices]

        def on_choose(index: int):
            if 0 <= index < len(choices):
                item.intValue = index
                self.set_setting(key, choices[index], reload_settings=False)
                if key == "interval_min":
                    self._start_periodic_timer()

        cb = SlideCallback(on_choose)
        self._keep_callbacks.append(cb)
        item = UItem.asSlideView(jarray(String)(labels), chosen_idx, cb)
        return Custom(item=item)

    def _try_load_header_sticker(self, img_view: Any, sticker_spec: str) -> bool:
        try:
            if "/" not in str(sticker_spec):
                return False
            pack_name, idx_str = str(sticker_spec).split("/", 1)
            raw_idx = int(idx_str)
            acc = int(UserConfig.selectedAccount)
            mdc = MediaDataController.getInstance(acc)
            ss = mdc.getStickerSetByName(pack_name) or mdc.getStickerSetByEmojiOrName(pack_name)
            if ss and ss.documents:
                sz = int(ss.documents.size())
                if sz > 0:
                    safe_idx = raw_idx if raw_idx < sz else max(0, sz - 1)
                    img_view.setImage(
                        ImageLocation.getForDocument(ss.documents.get(safe_idx)),
                        "120_120",
                        None,
                        None,
                        0,
                        1,
                    )
                    return True
            input_set = TLRPC.TL_inputStickerSetShortName()
            input_set.short_name = pack_name
            mdc.getStickerSet(input_set, None, False, None)
        except Exception:
            pass
        return False

    def _build_settings_header(self, context: Any):
        try:
            container = FrameLayout(context)
            if StarParticlesView is not None:
                try:
                    pv = StarParticlesView(context)
                    pv.doNotFling = True
                    pv.setClipWithGradient()
                    pv.drawable.colorKey = Theme.key_premiumGradient1
                    pv.drawable.useBlur = True
                    pv.drawable.useScale = True
                    pv.drawable.startFromCenter = True
                    pv.drawable.centerOffsetY = AndroidUtilities.dp(20)
                    pv.drawable.init()
                    container.addView(pv, LayoutHelper.createFrame(-1, 200, Gravity.CENTER_HORIZONTAL | Gravity.TOP, 0, -6, 0, 0))
                except Exception:
                    pass

            col = LinearLayout(context)
            col.setOrientation(LinearLayout.VERTICAL)
            col.setGravity(Gravity.CENTER)
            col.setPadding(AndroidUtilities.dp(20), AndroidUtilities.dp(18), AndroidUtilities.dp(20), AndroidUtilities.dp(16))

            avatar_box = FrameLayout(context)

            fallback_badge = FrameLayout(context)
            badge_bg = GradientDrawable()
            badge_bg.setShape(GradientDrawable.OVAL)
            badge_bg.setColor(Theme.getColor(Theme.key_featuredStickers_addButton))
            fallback_badge.setBackground(badge_bg)
            ico_res = _get_drawable_res("msg2_proxy", _get_drawable_res("msg_proxy", 0))
            if ico_res:
                iv = ImageView(context)
                iv.setImageResource(ico_res)
                iv.setScaleType(ImageView.ScaleType.CENTER)
                iv.setColorFilter(Theme.getColor(Theme.key_featuredStickers_buttonText))
                fallback_badge.addView(iv, LayoutHelper.createFrame(42, 42, Gravity.CENTER))
            avatar_box.addView(fallback_badge, LayoutHelper.createFrame(88, 88, Gravity.CENTER))

            sticker_view = BackupImageView(context)
            sticker_view.setRoundRadius(AndroidUtilities.dp(24))
            avatar_box.addView(sticker_view, LayoutHelper.createFrame(96, 96, Gravity.CENTER))

            if self._try_load_header_sticker(sticker_view, __icon__):
                fallback_badge.setVisibility(View.GONE)
            else:
                sticker_view.setAlpha(0.0)

                def retry_sticker():
                    if self._try_load_header_sticker(sticker_view, __icon__):
                        sticker_view.animate().alpha(1.0).setDuration(250).start()
                        fallback_badge.animate().alpha(0.0).setDuration(250).start()

                run_on_ui_thread(retry_sticker, 1200)

            col.addView(avatar_box, LayoutHelper.createLinear(96, 96, Gravity.CENTER, 0, 0, 0, 12))

            tv_title = TextView(context)
            tv_title.setText(f"{__name__} · {__version__}")
            tv_title.setTypeface(AndroidUtilities.getTypeface("fonts/rmedium.ttf"))
            tv_title.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 20)
            tv_title.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText))
            tv_title.setGravity(Gravity.CENTER)
            col.addView(tv_title, LayoutHelper.createLinear(-1, -2, Gravity.CENTER, 0, 0, 0, 4))

            try:
                PC, _, _ = _get_cached_classes()
                pl = PC.getProxyList()
                cnt_p = int(pl.size()) if pl is not None else 0
            except Exception:
                cnt_p = 0
            cnt_s = len(self._get_sources())

            tv_sub = TextView(context)
            tv_sub.setText(f"В списке: {cnt_p} прокси · Источников: {cnt_s}")
            tv_sub.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13)
            tv_sub.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText))
            tv_sub.setGravity(Gravity.CENTER)
            col.addView(tv_sub, LayoutHelper.createLinear(-1, -2, Gravity.CENTER))

            container.addView(col, LayoutHelper.createFrame(-1, -2, Gravity.CENTER))
            return container
        except Exception:
            return None

    def _show_guide_sheet(self, _v=None):
        frag = get_last_fragment()
        act = frag.getParentActivity() if frag else None
        if act is None:
            return

        guide = (
            "**1. Источники и парсинг**\n"
            "Добавляйте каналы, группы, отдельные топики форумов и прямые URL-подписки. "
            "Плагин автоматически читает ссылки, кнопки, Base64-списки и прикреплённые .txt / .json файлы до 512 КБ.\n\n"
            "**2. Проверка и умная очистка**\n"
            "Проверяется реальный TLS/MTProto/SOCKS5-хэндшейк. "
            "Мёртвые прокси удаляются только после заданного числа страйков подряд и попадают в чёрный список на время TTL, чтобы спам-каналы не добавляли их заново.\n\n"
            "**3. Failover при смене сети**\n"
            "При переходе с Wi-Fi на мобильный интернет плагин сразу проверяет активный прокси и при недоступности переключает клиент на самый быстрый рабочий сервер.\n\n"
            "**4. Обозначения в списке**\n"
            "🌐 WebProxy · 🛡️ FakeTLS (сильный SNI) · 🔒 FakeTLS · ➿ Padding · ⚠️ Plain · 🧦 SOCKS5."
        )

        def ui():
            try:
                sheet = BottomSheet(act, False)
                root = LinearLayout(act)
                root.setOrientation(LinearLayout.VERTICAL)
                root.setPadding(AndroidUtilities.dp(20), AndroidUtilities.dp(16), AndroidUtilities.dp(20), AndroidUtilities.dp(16))
                bg = GradientDrawable()
                bg.setCornerRadii([AndroidUtilities.dp(20), AndroidUtilities.dp(20), AndroidUtilities.dp(20), AndroidUtilities.dp(20), 0, 0, 0, 0])
                bg.setColor(Theme.getColor(Theme.key_dialogBackground))
                root.setBackground(bg)

                title = TextView(act)
                title.setText("Справка по работе")
                title.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 19)
                title.setTypeface(AndroidUtilities.getTypeface("fonts/rmedium.ttf"))
                title.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
                title.setGravity(Gravity.CENTER)
                root.addView(title, LayoutHelper.createLinear(-1, -2, Gravity.CENTER, 0, 0, 0, 12))

                scroll = ScrollView(act)
                scroll.setVerticalScrollBarEnabled(False)
                tv = TextView(act)
                tv.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 14)
                tv.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
                tv.setLineSpacing(AndroidUtilities.dp(3), 1.15)

                parts = []
                last = 0
                for m in re.finditer(r"\*\*(.*?)\*\*", guide):
                    if m.start() > last:
                        parts.append((guide[last:m.start()], False))
                    parts.append((m.group(1), True))
                    last = m.end()
                if last < len(guide):
                    parts.append((guide[last:], False))
                sp = SpannableString("".join(p[0] for p in parts))
                pos = 0
                for txt_p, bold in parts:
                    if bold:
                        sp.setSpan(StyleSpan(Typeface.BOLD), pos, pos + len(txt_p), SpannableString.SPAN_EXCLUSIVE_EXCLUSIVE)
                    pos += len(txt_p)
                tv.setText(sp)
                scroll.addView(tv)
                root.addView(scroll, LayoutHelper.createLinear(-1, 0, 1.0))

                btn = TextView(act)
                btn.setText("Понятно")
                btn.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 15)
                btn.setTypeface(AndroidUtilities.getTypeface("fonts/rmedium.ttf"))
                btn.setGravity(Gravity.CENTER)
                btn.setTextColor(Theme.getColor(Theme.key_featuredStickers_buttonText))
                btn.setPadding(0, AndroidUtilities.dp(13), 0, AndroidUtilities.dp(13))
                b_bg = GradientDrawable()
                b_bg.setCornerRadius(AndroidUtilities.dp(14))
                b_bg.setColor(Theme.getColor(Theme.key_featuredStickers_addButton))
                btn.setBackground(b_bg)
                btn.setClickable(True)
                btn.setOnClickListener(OnClickListener(lambda _v: sheet.dismiss()))
                root.addView(btn, LayoutHelper.createLinear(-1, -2, 0, 14, 0, 0))

                sheet.setCustomView(root)
                sheet.show()
            except Exception:
                pass

        run_on_ui_thread(ui)

