                except Exception:
                    hc_bg.setColor(0x18808080)
                hidden_card.setBackground(hc_bg)
                scroll_body.addView(hidden_card, LayoutHelper.createLinear(-1, -2, 0, 0, 0, 12))

                edit_btn_toggle_row = FrameLayout(act)
                edit_btn_toggle_row.setPadding(
                    AndroidUtilities.dp(14),
                    AndroidUtilities.dp(12),
                    AndroidUtilities.dp(14),
