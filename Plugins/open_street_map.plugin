def ui_text(key, **values):
    text = UI_TEXT[key]
    for name, value in values.items():
        text = text.replace("{" + name + "}", str(value))
    return text


def debug_enabled(plugin):
    return False


def history_tail(value, limit=64000):
    if len(value) <= limit:
        return value
    tail = value[-limit:]
    boundary = tail.find("\n[")
    return tail[boundary + 1:] if boundary >= 0 else tail.split("\n", 1)[-1]


def timestamp():
    try:
        return datetime.now(timezone.utc).isoformat(timespec="milliseconds")
    except Exception:
        return "unix=" + str(time.time())


class DurableJournal:
    LIMIT = 256 * 1024

    def __init__(self, directory):
        os.makedirs(directory, exist_ok=True)
        self.path = os.path.join(directory, "journal.jsonl")
        self.state_path = os.path.join(directory, "session.json")
        self.lock = threading.RLock()
        self.session = secrets.token_hex(6)
        self.sequence = 0
        self.state = {"session": self.session, "version": __version__, "clean": False}

    def read_state(self):
        try:
            with open(self.state_path, encoding="utf-8") as stream:
                value = json.load(stream)
                if not isinstance(value, dict):
                    raise ValueError("Session marker must be an object")
                return value
        except FileNotFoundError:
            return {}
        except (ValueError, TypeError):
            return {"session": "unknown", "clean": False,
                    "checkpoint": {"detail": "Previous session marker could not be decoded; journal records are retained."}}

    def save_state(self):
        temporary = self.state_path + ".tmp"
        with open(temporary, "w", encoding="utf-8") as stream:
            json.dump(self.state, stream, ensure_ascii=False)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, self.state_path)
        descriptor = os.open(os.path.dirname(self.state_path), os.O_RDONLY)
        try:
            os.fsync(descriptor)
        finally:
            os.close(descriptor)

    def append(self, detail, critical=False, failure=False, record=None):
        with self.lock:
            if record is None:
                record = {"time": timestamp(), "session": self.session, "seq": self.sequence + 1,
                          "version": __version__, "detail": detail}
            self.sequence = record["seq"]
            if failure:
                record["failure"] = True
            if os.path.exists(self.path) and os.path.getsize(self.path) > self.LIMIT:
                os.replace(self.path, self.path + ".previous")
            incomplete = False
            if os.path.exists(self.path) and os.path.getsize(self.path):
                with open(self.path, "rb") as stream:
                    stream.seek(-1, os.SEEK_END)
                    incomplete = stream.read(1) != b"\n"
            with open(self.path, "a", encoding="utf-8") as stream:
                if incomplete:
                    stream.write("\n")
                stream.write(json.dumps(record, ensure_ascii=False) + "\n")
                stream.flush()
                if critical or failure:
                    os.fsync(stream.fileno())
            if critical or failure:
                self.state["clean"] = False
                self.state["checkpoint"] = record
                if failure:
                    self.state["failure"] = record
                if record.get("api3_probe"):
                    self.state["api3_probe"] = record
                self.save_state()

    def finish(self):
        with self.lock:
            self.state["clean"] = True
            self.save_state()

    def clear(self):
        with self.lock:
            for path in (self.path, self.path + ".previous"):
                try:
                    os.remove(path)
                except FileNotFoundError:
                    pass
            self.state = {"session": self.session, "version": __version__, "clean": False}
            self.save_state()

    def text(self):
        lines = []
        with self.lock:
            for path in [self.path + ".previous", self.path]:
                try:
                    with open(path, encoding="utf-8", errors="replace") as stream:
                        for line in stream:
                            try:
                                item = json.loads(line)
                                lines.append("[" + item["time"] + "] session=" + item["session"] +
                                             " seq=" + str(item["seq"]) + " v=" + item["version"] + " | " + item["detail"])
                            except (ValueError, KeyError, TypeError):
                                continue
                except FileNotFoundError:
                    pass
        return history_tail("\n".join(lines))


class QueuedJournal:
    def __init__(self, directory, legacy="", failure="", on_error=None):
        self.directory = directory
        self.path = os.path.join(directory, "journal.jsonl")
        self.state_path = os.path.join(directory, "session.json")
        self.session = secrets.token_hex(6)
        self.sequence = 0
        self.lock = threading.Lock()
        self.queue = queue.Queue(maxsize=1024)
        self.past, self.current = "", ""
        self.failure_text, self.new_failure = failure, False
        self.probe_text, self.new_probe = "", False
        self.dropped, self.max_write_ms = 0, 0
        self.closed, self.storage_ready = False, False
        self.clear_requested = False
        self.on_error = on_error
        self.legacy = legacy
        self.append("Session start; runtime version=" + __version__ + "; background file journal", critical=True)
        self.worker = threading.Thread(target=self.run, name="AyuMapsJournal", daemon=True)
        self.worker.start()

    @staticmethod
    def format_record(record):
        return "[" + record["time"] + "] session=" + record["session"] + " seq=" + str(record["seq"]) + " v=" + record["version"] + " | " + record["detail"]

    def append(self, detail, critical=False, failure=False, probe=False):
        with self.lock:
            if self.closed:
                return
            self.sequence += 1
            record = {"time": timestamp(), "session": self.session, "seq": self.sequence,
                      "version": __version__, "detail": detail}
            if failure:
                record["failure"] = True
                self.new_failure = True
                self.failure_text = "[" + record["time"] + "] " + detail
            if probe:
                record["api3_probe"] = True
                critical = True
                self.probe_text, self.new_probe = detail, True
            self.current = history_tail(self.current + "\n" + self.format_record(record))
            try:
                self.queue.put_nowait((record, critical, failure))
            except queue.Full:
                self.dropped += 1

    def text(self):
        with self.lock:
            return history_tail(self.past + "\n" + self.current).strip()

    def clear(self):
        with self.lock:
            if self.closed:
                return
            while True:
                try:
                    self.queue.get_nowait()
                    self.queue.task_done()
                except queue.Empty:
                    break
            self.clear_requested = True
            self.past = ""
            self.failure_text, self.new_failure = "", True
            self.probe_text, self.new_probe = "", True
            self.dropped = 0
            self.sequence += 1
            record = {"time": timestamp(), "session": self.session, "seq": self.sequence,
                      "version": __version__, "detail": ui_text("journal_cleared"), "operation": "clear"}
            self.current = self.format_record(record)
            self.queue.put_nowait((record, True, False))

    def clear_probe(self):
        with self.lock:
            if self.closed:
                return
            self.probe_text, self.new_probe = "", True
            self.sequence += 1
            record = {"time": timestamp(), "session": self.session, "seq": self.sequence,
                      "version": __version__, "detail": ui_text("probe_cleared"), "operation": "clear_probe"}
            self.current = history_tail(self.current + "\n" + self.format_record(record))
            self.queue.put_nowait((record, True, False))

    def finish(self):
        with self.lock:
            self.closed = True

    def issue(self, operation, exc):
        if self.on_error is not None:
            self.on_error(operation, exc)

    def run(self):
        raw, guard = None, None
        try:
            os.makedirs(self.directory, exist_ok=True)
            guard = open(os.path.join(self.directory, "writer.lock"), "a")
            fcntl.flock(guard.fileno(), fcntl.LOCK_EX)
            raw = DurableJournal(self.directory)
            raw.session = self.session
            raw.state["session"] = self.session
            previous = raw.read_state()
            recovered_failure = previous.get("failure")
            raw.state["failure"] = recovered_failure
            recovered_probe = previous.get("api3_probe")
            if recovered_probe:
                raw.state["api3_probe"] = recovered_probe
            history = raw.text()
            recovery = ""
            if not previous and not history and self.legacy:
                recovery = "Legacy settings history (without reliable session dates):\n" + self.legacy
            elif previous and not previous.get("clean", False):
                checkpoint = previous.get("checkpoint", {})
                recovery = f"Previous session {previous.get('session', '?')!s} has no normal unload marker; this alone does not prove a crash. Last durable checkpoint:\n{checkpoint.get('time', '?')!s} | {checkpoint.get('detail', 'none')!s}"
            if recovery:
                record = {"time": timestamp(), "session": self.session, "seq": 0, "version": __version__, "detail": recovery}
                raw.append(recovery, critical=True, record=record)
                history = raw.text()
            with self.lock:
                if not self.clear_requested:
                    self.past = history
                if isinstance(recovered_failure, dict) and not self.new_failure:
                    self.failure_text = "[" + recovered_failure.get("time", "?") + "] " + recovered_failure.get("detail", "")
                if isinstance(recovered_probe, dict) and not self.new_probe:
                    self.probe_text = recovered_probe.get("detail", "")
                self.storage_ready = True
        except Exception as exc:
            self.issue("Open persistent journal", exc)
        try:
            while True:
                try:
                    record, critical, failure = self.queue.get(timeout=0.1)
                except queue.Empty:
                    if self.closed:
                        break
                    continue
                try:
                    if raw is not None:
                        started = time.monotonic()
                        if record.get("operation") == "clear":
                            raw.clear()
                        elif record.get("operation") == "clear_probe":
                            raw.state.pop("api3_probe", None)
                        raw.append(record["detail"], critical=critical, failure=failure, record=record)
                        self.max_write_ms = max(self.max_write_ms, int((time.monotonic() - started) * 1000))
                except Exception as exc:
                    self.issue("Write persistent journal", exc)
                finally:
                    self.queue.task_done()
            if raw is not None:
                raw.finish()
        except Exception as exc:
            self.issue("Finish journal session", exc)
        finally:
            if guard is not None:
                guard.close()


def python_state(peer, name, default=None):
    return object.__getattribute__(peer, "__dict__").get(name, default)


def map_log(view, detail, bucket=None, critical=False):
    try:
        if not debug_enabled(view.plugin):
            return
        if bucket:
            counts = python_state(view, "trace_counts")
            if counts is None:
                counts = view.trace_counts = {}
            count = counts[bucket] = counts.get(bucket, 0) + 1
            if count > 5 and count % 50:
                return
            detail += f' [count={count!s}]'
        label = f"map={python_state(view, 'trace_id', '?')!s} page={python_state(view, 'page_seq', 0)!s} API={python_state(view, 'engine', '?')!s}"
        elapsed = int((time.monotonic() - python_state(view, "trace_started", time.monotonic())) * 1000)
        text = label + " +" + str(elapsed) + "ms | " + detail
        if critical:
            view.plugin.remember(text, critical=True)
        else:
            view.plugin.remember(text)
    except Exception as exc:
        try:
            view.plugin.storage_warning("Format map diagnostic", exc)
        except Exception:
            pass


