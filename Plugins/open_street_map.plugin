    def clicked(self, view):
        if not getattr(self.plugin, "active", False) or not getattr(self.plugin, "enabled", False):
            return
        try:
            self.callback(view)
        except Exception as exc:
            self.plugin.report("Settings action", exc)


def preview_caption(view):
    caption = python_state(view, "preview_caption")
    if caption is None:
        return
    caption.setVisibility(0 if debug_enabled(view.plugin) else 8)
    if not view.ready:
        key = "preview_loading"
    elif view.engine == 3:
        key = "preview_native"
    elif view.map.dark and view.map.map_type == 0 and False:
        key = "preview_dimmed"
    else:
        key = "preview_fallback"
    caption.setText(ui_text(key))


@java_subclass(Object, jclass("android.view.View$OnAttachStateChangeListener"))
class PreviewLifecycle(Base):
    def __init__(self, context, slot, plugin, caption=None):
        self.context, self.slot, self.plugin, self.caption = context, slot, plugin, caption
        self.preview = None

    @joverload("onViewAttachedToWindow", ["android.view.View"])
    def attached(self, view):
        if self.preview is not None and not self.preview.destroyed:
            return
        self.preview = None
        try:
            self.slot.removeAllViews()
            preview = YandexMapView.new_instance(init_args=[self.context, self.plugin])
            self.preview = preview
            preview.is_preview = True
            preview.preview_caption = self.caption
            preview_caption(preview)
            preview.map.zoom = 15.0
            self.slot.addView(preview.container, jclass("android.widget.FrameLayout$LayoutParams")(-1, -1))
            preview.onCreate(None)
            preview.onResume()
            map_log(preview, "Settings preview attached; live scale enabled; location subscriptions disabled")
        except Exception as exc:
            if self.preview is not None:
                self.preview.destroy()
                self.preview = None
            self.plugin.report("Create settings preview", exc)

    @joverload("onViewDetachedFromWindow", ["android.view.View"])
    def detached(self, view):
        if self.preview is not None:
            self.preview.onPause()
            self.preview.destroy()
            self.preview = None


def resolved_theme(view, choice=None):
    plugin = python_state(view, "plugin")
    if choice is None:
        choice = plugin.get_setting("map_theme", 0) if plugin is not None else 0
    try:
        choice = int(choice)
    except (ValueError, TypeError):
        choice = 0
    if choice in (1, 2):
        return choice == 2
    try:
        context = jclass("org.telegram.messenger.ApplicationLoader").applicationContext
        return (int(context.getResources().getConfiguration().uiMode) & 0x30) == 0x20
    except Exception:
        return False


@java_subclass(Object, jclass(P + "$IMap"))
class YandexMap(Base):
    def __init__(self, view):
        self.view = view
        self.center, self.zoom = [55.751244, 37.618423], 10.0
        self.padding = [0, 0, 0, 0]
        self.eccentricity = 0.0 if python_state(view, "engine", 2) == 3 else ECCENTRICITY
        self.dark = resolved_theme(view)
        self.map_type = 0
        self.zoom_controls = self.location_button = False
        self.markers, self.circles = {}, {}
        self.next_id = 0
        self.listeners = {}
        self.animations = {}
        self.animation_id = 0
        self.location_enabled = False
        self.location = None
        self.location_manager = None
        self.location_listener = None
        map_log(view, "IMap constructor: UISettings proxy begin")
        self.ui_settings = UISettings.new_instance(init_args=[self])
        map_log(view, "IMap constructor: Projection proxy begin")
        self.projection = Projection.new_instance(init_args=[self])
        map_log(view, "IMap constructor: child proxies returned")

    def emit(self, event, *args):
        methods = {"move": "run", "idle": "run", "loaded": "run", "start": "onCameraMoveStarted", "location": "accept", "marker": "onClick"}
        try:
            return call_listener(self.listeners.get(event), methods[event], *args)
        except Exception as exc:
            self.view.plugin.report("Callback " + event, exc)

    def camera(self, update, duration=0, callback=None):
        self.cancel_animations()
        payload = dict(CameraUpdate.from_java(update).payload)
        if "center" in payload:
            self.center = list(payload["center"])
        if "zoom" in payload:
            self.zoom = float(payload["zoom"])
        if "bounds" in payload and viewport(self.view).getWidth() > 0:
            d = self.view.density
            pad = [x / d + payload.get("padding", 0) / d for x in self.padding]
            self.center, self.zoom = fit_camera(payload["bounds"], viewport(self.view).getWidth() / d, viewport(self.view).getHeight() / d, pad, self.eccentricity)
        self.animation_id += 1
        ident = self.animation_id
        if callback is not None:
            self.animations[ident] = callback
        payload.update(duration=int(duration), animation=ident, density=self.view.density)
        self.view.command("camera", payload)

    def cancel_animations(self):
        callbacks, self.animations = self.animations, {}
        for callback in callbacks.values():
            try:
                callback.onCancel()
            except Exception as exc:
                self.view.plugin.report("Animation cancellation", exc)

    def location_changed(self, location):
        if self.view.destroyed or self.view.failed or not self.location_enabled:
            return
        self.location = location
        self.view.command("location", {"position": [float(location.getLatitude()), float(location.getLongitude())], "accuracy": max(0, float(location.getAccuracy()))})
        self.emit("location", location)

    def start_location(self):
        if not self.location_enabled or not self.view.resumed or self.view.destroyed or self.view.failed or self.location_manager is not None:
            map_log(self.view, f'Location subscribe skipped: enabled={self.location_enabled!s}; resumed={self.view.resumed!s}; destroyed={self.view.destroyed!s}; failed={self.view.failed!s}; subscribed={self.location_manager is not None!s}', bucket="location-subscribe")
            return
        ctx = self.view.context
        fine = ctx.checkSelfPermission("android.permission.ACCESS_FINE_LOCATION") == 0
        coarse = ctx.checkSelfPermission("android.permission.ACCESS_COARSE_LOCATION") == 0
        map_log(self.view, f'Location permissions: fine={fine!s}; coarse={coarse!s}')
        if not (fine or coarse):
            return
        manager = ctx.getSystemService("location")
        listener = LocationListener.new_instance(init_args=[self])
        providers = ["network", "gps"] if fine else ["network"]
        self.location_manager, self.location_listener = manager, listener
        latest = None
        for provider in providers:
            try:
                last = manager.getLastKnownLocation(provider)
                if last is not None and (latest is None or last.getTime() > latest.getTime()):
                    latest = last
                if manager.isProviderEnabled(provider):
                    map_log(self.view, "Location provider " + provider + ": request updates begin; last_known=" + str(last is not None))
                    manager.requestLocationUpdates(provider, 1000, 2.0, listener.java, Looper.getMainLooper())
                    map_log(self.view, "Location provider " + provider + ": request updates registered")
                else:
                    map_log(self.view, "Location provider " + provider + ": disabled")
            except Exception as exc:
                self.view.plugin.report("Location provider " + provider, exc)
        if latest is not None:
            map_log(self.view, "Location last-known sample available (coordinates omitted)")
            self.location_changed(latest)

    def stop_location(self):
        if self.location_manager is not None and self.location_listener is not None:
            try:
                self.location_manager.removeUpdates(self.location_listener.java)
            except Exception as exc:
                self.view.plugin.report("Stop location", exc)
        self.location_manager = self.location_listener = None

    @joverload("addMarker", [P + "$IMarkerOptions"])
    def addMarker(self, options):
        opt = MarkerOptions.from_java(options)
        data = dict(opt.data)
        data["icon"] = icon_data(self.view.context, opt.image)
        self.next_id += 1
        item = Marker.new_instance(init_args=[self, "m" + str(self.next_id), data])
        self.markers[item.ident] = item
        item.sync()
        return item.java

    @joverload("addCircle", [P + "$ICircleOptions"])
    def addCircle(self, options):
        data = dict(CircleOptions.from_java(options).data)
        data["width"] /= self.view.density
        self.next_id += 1
        item = Circle.new_instance(init_args=[self, "c" + str(self.next_id), data])
        self.circles[item.ident] = item
        item.sync()
        return item.java

    @joverload("moveCamera", [P + "$ICameraUpdate"])
    def moveCamera(self, update):
        self.camera(update)

    @joverload("animateCamera", [P + "$ICameraUpdate"])
    def animate_camera(self, update):
        self.camera(update, 300)

    @joverload("animateCamera", [P + "$ICameraUpdate", P + "$ICancelableCallback"])
    def animate_with_callback(self, update, callback):
        self.camera(update, 300, callback)

    @joverload("animateCamera", [P + "$ICameraUpdate", "int", P + "$ICancelableCallback"])
    def animate_with_duration(self, update, duration, callback):
        self.camera(update, max(0, int(duration)), callback)

    @joverload("getCameraPosition", [])
    def getCameraPosition(self):
        return CameraPosition(lnglat(self.center), float(self.zoom))

    @joverload("getMinZoomLevel", [])
    def getMinZoomLevel(self):
        return 0.0

    @joverload("getMaxZoomLevel", [])
    def getMaxZoomLevel(self):
        return 21.0

    @joverload("getProjection", [])
    def getProjection(self):
        return self.projection.java

    @joverload("getUiSettings", [])
    def getUiSettings(self):
        return self.ui_settings.java

    @joverload("setPadding", ["int", "int", "int", "int"])
    def setPadding(self, left, top, right, bottom):
        padding = [max(0, int(x)) for x in [left, top, right, bottom]]
        if padding == self.padding:
            return
        self.padding = padding
        self.view.command("padding", {"value": [x / self.view.density for x in self.padding]})

    @joverload("setMapType", ["int"])
    def setMapType(self, value):
        self.map_type = int(value)
        if hasattr(self.view, "switch_engine"):
            self.view.switch_engine(self.view.scheme_engine() if self.map_type == 0 else 2)
        self.view.command("type", {"value": {0: "yandex#map", 1: "yandex#satellite", 2: "yandex#hybrid"}.get(int(value), "yandex#map")})
        preview_caption(self.view)

    @joverload("setMapStyle", [P + "$IMapStyleOptions"])
    def setMapStyle(self, style):
        self.dark = resolved_theme(self.view)
        self.view.command("dark", {"enabled": self.dark})
        preview_caption(self.view)

    @joverload("setMyLocationEnabled", ["boolean"])
    def setMyLocationEnabled(self, enabled):
        self.location_enabled = bool(enabled)
        if enabled:
            ui(self.start_location)
        else:
            ui(self.stop_location)
            self.view.command("location", {"position": None})

    @joverload("setOnCameraMoveStartedListener", [P + "$OnCameraMoveStartedListener"])
    def setOnCameraMoveStartedListener(self, value):
        self.listeners["start"] = value

    @joverload("setOnCameraMoveListener", ["java.lang.Runnable"])
    def setOnCameraMoveListener(self, value):
        self.listeners["move"] = value

    @joverload("setOnCameraIdleListener", ["java.lang.Runnable"])
    def setOnCameraIdleListener(self, value):
        self.listeners["idle"] = value

    @joverload("setOnMapLoadedCallback", ["java.lang.Runnable"])
    def setOnMapLoadedCallback(self, value):
        self.listeners["loaded"] = value
        if self.view.ready or self.view.failed:
            ui(lambda: self.emit("loaded") if not self.view.destroyed else None)

    @joverload("setOnMarkerClickListener", [P + "$OnMarkerClickListener"])
    def setOnMarkerClickListener(self, value):
        self.listeners["marker"] = value

    @joverload("setOnMyLocationChangeListener", ["androidx.core.util.Consumer"])
    def setOnMyLocationChangeListener(self, value):
        self.listeners["location"] = value
        if self.location is not None and self.location_enabled:
            ui(lambda: self.emit("location", self.location))


