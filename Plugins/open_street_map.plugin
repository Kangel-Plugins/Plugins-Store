    if Looper.myLooper() == Looper.getMainLooper():
        fn()
    else:
        run_on_ui_thread(fn)


def viewport(view):
    return python_state(view, "container") or view.web


def coord(value):
    lat, lon = float(value.latitude), float(value.longitude)
    if not math.isfinite(lat) or not math.isfinite(lon):
        raise ValueError("Non-finite coordinates")
    return [max(-MAX_LAT, min(MAX_LAT, lat)), (lon + 180.0) % 360.0 - 180.0]


def lnglat(value):
    return LatLng(float(value[0]), float(value[1]))


def project(value, zoom, eccentricity=ECCENTRICITY):
    lat = math.radians(max(-MAX_LAT, min(MAX_LAT, value[0])))
    scale = 256.0 * 2.0 ** zoom
    sine = math.sin(lat)
    merc = math.log(math.tan(math.pi / 4.0 + lat / 2.0))
    merc += eccentricity / 2.0 * math.log((1 - eccentricity * sine) / (1 + eccentricity * sine))
    return [(value[1] + 180.0) / 360.0 * scale, (0.5 - merc / (2.0 * math.pi)) * scale]


def unproject(value, zoom, eccentricity=ECCENTRICITY):
    scale = 256.0 * 2.0 ** zoom
    merc = (0.5 - value[1] / scale) * 2.0 * math.pi
    lat = 2.0 * math.atan(math.exp(merc)) - math.pi / 2.0
    for _ in range(12):
        sine = math.sin(lat)
        lat = 2 * math.atan(math.exp(merc) * ((1 + eccentricity * sine) / (1 - eccentricity * sine)) ** (eccentricity / 2)) - math.pi / 2
    return [math.degrees(lat), (value[0] / scale * 360.0) % 360.0 - 180.0]


def bounds_for(points):
    if not points:
        raise ValueError("Bounds require at least one point")
    lons = sorted(p[1] % 360.0 for p in points)
    gaps = [(lons[(i + 1) % len(lons)] + (360 if i == len(lons) - 1 else 0) - lons[i], i) for i in range(len(lons))]
    _, index = max(gaps)
    west = lons[(index + 1) % len(lons)]
    east = lons[index]
    if east < west:
        east += 360.0
    return [[min(p[0] for p in points), west], [max(p[0] for p in points), east]]


def fit_camera(bounds, width, height, padding, eccentricity=ECCENTRICITY):
    sw, ne = bounds
    a, b = project(sw, 0, eccentricity), project(ne, 0, eccentricity)
    left, top, right, bottom = padding
    w, h = max(1, width - left - right), max(1, height - top - bottom)
    dx, dy = max(abs(b[0] - a[0]), 1e-8), max(abs(b[1] - a[1]), 1e-8)
    zoom = max(0.0, min(21.0, math.log2(min(w / dx, h / dy))))
    return unproject([(a[0] + b[0]) / 2, (a[1] + b[1]) / 2], 0, eccentricity), zoom


def rgba(value):
    value = int(value) & 0xFFFFFFFF
    return "#%06x%02x" % (value & 0xFFFFFF, value >> 24)


def origin_url(value):
    value = str(value).strip()
    parsed = urlparse(value)
    if parsed.scheme != "https" or not parsed.hostname or parsed.username or parsed.password or parsed.fragment or parsed.query:
        raise ValueError("Base URL must be an HTTPS URL without credentials, query, or fragment")
    return value if value.endswith("/") else value + "/"


JS_MIME_TYPES = ("application/javascript", "text/javascript", "application/x-javascript",
                 "text/ecmascript", "application/ecmascript")


def redact_key(detail, key):
    if key:
        detail = detail.replace(key, "[API KEY]").replace(urlencode({"apikey": key})[7:], "[API KEY]")
    return detail


def key_diagnostic(key):
    fingerprint = hashlib.sha256(key.encode("utf-8")).hexdigest()[:12] if key else "absent"
    uuid_format = bool(re.fullmatch(r"[0-9a-fA-F]{8}(?:-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}", key))
    return ("SHA256-id=" + fingerprint + "; UUID-format=" + str(uuid_format) +
            "; non_ASCII=" + str(sum(ord(char) > 127 for char in key)) +
            "; whitespace_inside=" + str(any(char.isspace() for char in key)))


def referer_diagnostic(origin):
    parsed = urlparse(origin)
    return ("scheme=" + parsed.scheme + "; host=" + str(parsed.hostname) +
            "; port=" + str(parsed.port or (443 if parsed.scheme == "https" else 80)))


def localhost_probe_variants(origin, api3, api2):
    if urlparse(origin).hostname != "localhost" or api3.get("status") != 403 or not api2.get("js"):
        return ()
    return ("http://localhost/", "http://localhost:3000/")


def response_hint(status, mime, body):
    text = body.lower()
    if "referer" in text or "referrer" in text:
        return "Ответ упоминает Referer: проверь разрешённый домен и срок применения настроек (15 минут)."
    if re.search(r"invalid[ _-]*(?:api[ _-]*key|apikey)|(?:api[ _-]*key|apikey).{0,30}(?:invalid|not valid)", text):
        return "Сервер сообщает Invalid API key. Это не доказывает платное ограничение: проверь продукт ключа, активацию и обязательный HTTP Referer."
    if status == 429 or "quota" in text or "limit exceeded" in text:
        return "Ответ указывает на частоту/квоту запросов. Проверь использование ключа в кабинете Яндекса."
    if status == 402:
        return "HTTP 402: сервер требует проверить состояние лицензии/тарифа. Причину уточняет текст ответа."
    if 300 <= status < 400:
        return "Получен редирект. Проверка не следует ему; его обработку в карте выполняет WebView."
    if status >= 500:
        return "Ошибка сервера или промежуточного шлюза; это не подтверждает проблему тарифа."
    if status in (401, 403):
        return "Сервер отказал в доступе. По одному HTTP-коду нельзя различить ключ, домен, ограничение по IP или состояние доступа."
    if status == 200 and mime in JS_MIME_TYPES:
        return "Стартовый скрипт доступен. Готовность ymaps3 и загрузка тайлов этим ещё не проверены."
    return "Вместо ожидаемого JavaScript получен другой ответ; смотри HTTP-код, Content-Type и текст сервера."



ICON_CACHE = OrderedDict()


def icon_data(context, value):
    cache_key = None
    if value is not None and not isinstance(value, int):
        try:
            if int(value.getByteCount()) <= 262144:
                cache_key = (int(value.hashCode()), int(value.getGenerationId()),
                             float(context.getResources().getDisplayMetrics().density))
                old = ICON_CACHE.get(cache_key)
                if old is not None and old[0] == value:
                    ICON_CACHE.move_to_end(cache_key)
                    return old[1]
        except Exception:
            cache_key = None
    result = encode_icon(context, value)
    if cache_key is not None:
        ICON_CACHE[cache_key] = (value, result)
        while len(ICON_CACHE) > 16:
            ICON_CACHE.popitem(last=False)
    return result


def encode_icon(context, value):
    if value is None:
        return None
    bitmap = value
    created = False
    Bitmap = jclass("android.graphics.Bitmap")
    if isinstance(value, int):
        if value == 0:
            return None
        drawable = context.getResources().getDrawable(value, context.getTheme())
        w, h = max(1, drawable.getIntrinsicWidth()), max(1, drawable.getIntrinsicHeight())
        bitmap = Bitmap.createBitmap(w, h, Bitmap.Config.ARGB_8888)
        created = True
        drawable.setBounds(0, 0, w, h)
        drawable.draw(jclass("android.graphics.Canvas")(bitmap))
    stream = jclass("java.io.ByteArrayOutputStream")()
    try:
        bitmap.compress(Bitmap.CompressFormat.PNG, 100, stream)
        encoded = str(jclass("android.util.Base64").encodeToString(stream.toByteArray(), 2))
        density = float(context.getResources().getDisplayMetrics().density)
        return {"url": "data:image/png;base64," + encoded,
                "size": [bitmap.getWidth() / density, bitmap.getHeight() / density]}
    finally:
        stream.close()
        if created:
            bitmap.recycle()


def call_listener(listener, method, *args):
    if listener is not None:
        getattr(listener, method)(*args)


@java_subclass(Object, jclass(P + "$ICameraUpdate"))
class CameraUpdate(Base):
    def __init__(self, payload):
        self.payload = payload


@java_subclass(Object, jclass(P + "$IMapStyleOptions"))
class MapStyle(Base):
    def __init__(self, dark):
        self.dark = dark


@java_subclass(Object, jclass(P + "$ILatLngBounds"))
class Bounds(Base):
    def __init__(self, points):
        self.bounds = bounds_for(points)

    @joverload("getCenter", [])
    def getCenter(self):
        a, b = self.bounds
        return lnglat([(a[0] + b[0]) / 2, ((a[1] + b[1]) / 2 + 180) % 360 - 180])


