@java_subclass(Object, jclass("android.view.View$OnTouchListener"))
class MapTouchListener(Base):
    def __init__(self, owner):
        self.owner = owner

    @joverload("onTouch", ["android.view.View", "android.view.MotionEvent"])
    def onTouch(self, view, event):
        owner = self.owner
        if python_state(owner, "renderer_gone", False):
            return True
        if owner.destroyed:
            return False
        owner.touch_result = None
        try:
            action = int(event.getActionMasked())
            if python_state(owner, "is_preview", False):
                parent = view.getParent()
                if parent is not None:
                    parent.requestDisallowInterceptTouchEvent(action not in (1, 3))
            if action == 0:
                owner.map.cancel_animations()
                owner.gesture_move_logged = False
                owner.gesture_moves = 0
            if action == 2:
                owner.gesture_moves = python_state(owner, "gesture_moves", 0) + 1
            checkpoint = debug_enabled(owner.plugin) and owner.plugin.get_setting("touch_diagnostics", True) and (action in [0,1,3,5,6] or (action == 2 and not owner.gesture_move_logged))
            if checkpoint:
                touch_label = f"map={python_state(owner, 'trace_id', '?')!s} MotionEvent={action!s} moves={python_state(owner, 'gesture_moves', 0)!s}"
                if action == 2:
                    owner.gesture_move_logged = True
                owner.plugin.checkpoint(touch_label + ": вход; dispatch_interceptor=" + str(owner.dispatch_interceptor is not None) + "; intercept=" + str(owner.intercept_interceptor is not None))
            if owner.dispatch_interceptor is not None:
                result = bool(owner.dispatch_interceptor.onInterceptTouchEvent(event, owner.dispatch_call.java))
            else:
                result = owner.forward_touch(event)
            if checkpoint:
                owner.plugin.checkpoint(touch_label + ": обработано; native_result=" + str(owner.touch_result))
            return True if owner.touch_result is not None else bool(result)
        except Exception as exc:
            owner.plugin.report("Touch callback", exc)
            return owner.touch_result is not None


@java_subclass(Object, jclass("android.view.View$OnLayoutChangeListener"))
class MapLayoutListener(Base):
    def __init__(self, owner):
        self.owner = owner

    @joverload("onLayoutChange", ["android.view.View", "int", "int", "int", "int", "int", "int", "int", "int"])
    def onLayoutChange(self, view, left, top, right, bottom, old_left, old_top, old_right, old_bottom):
        owner = self.owner
        if owner.destroyed or python_state(owner, "renderer_gone", False):
            return
        try:
            if (left, top, right, bottom) != (old_left, old_top, old_right, old_bottom):
                owner.command("resize", {})
            call_listener(owner.layout_listener, "run")
        except Exception as exc:
            owner.plugin.report("Layout callback", exc)


@java_subclass(WebChromeClient)
class MapChrome(Base):
    def __init__(self, owner):
        self.owner = owner

    @joverload("onConsoleMessage", ["android.webkit.ConsoleMessage"])
    def console(self, message):
        if self.owner.destroyed or python_state(self.owner, "renderer_gone", False):
            return True
        text = str(message.message())
        if text.startswith(self.owner.bridge_prefix):
            try:
                data = json.loads(text[len(self.owner.bridge_prefix):])
                prefix = self.owner.bridge_prefix
                if isinstance(data, dict) and data.get("event") == "diagnostics":
                    entries = data.get("entries", [])
                    if isinstance(entries, list):
                        map_log(self.owner, "JS diagnostics batch:\n" + "\n".join(str(x)[:1200] for x in entries[:16]))
                    return True
                if isinstance(data, dict) and data.get("event") == "diagnostic":
                    map_log(self.owner, str(data.get("detail", ""))[:3000], critical=bool(data.get("critical")))
                    return True
                if isinstance(data, dict) and data.get("event") in ["ready", "error"]:
                    map_log(self.owner, f"Bridge {data['event']!s}: received before deferred host callback; " + str(data.get("detail", ""))[:3000], critical=True)
                def dispatch():
                    if prefix != self.owner.bridge_prefix or self.owner.destroyed:
                        return
                    try:
                        self.owner.event(data)
                    except Exception as exc:
                        self.owner.plugin.report("Web event " + str(data.get("event")), exc)
                run_on_ui_thread(dispatch, 1)
            except Exception as exc:
                self.owner.plugin.report("Web bridge", exc)
            return True
        try:
            if not self.owner.ready and str(message.messageLevel()) in ["ERROR", "WARNING"]:
                if self.owner.console_errors < 12:
                    self.owner.console_errors += 1
                    prefix = self.owner.bridge_prefix
                    line = -1
                    try:
                        line = int(message.lineNumber())
                    except Exception:
                        pass
                    detail = f'line={line!s}; ' + self.owner.plugin.redact(text)[:3000]
                    def record():
                        if not self.owner.destroyed and prefix == self.owner.bridge_prefix:
                            map_log(self.owner, "Web console\n" + detail)
                    run_on_ui_thread(record, 1)
        except Exception:
            pass
        return False


@java_subclass(WebViewClient)
class MapClient(Base):
    def __init__(self, owner):
        self.owner = owner


    @joverload("onRenderProcessGone", ["android.webkit.WebView", "android.webkit.RenderProcessGoneDetail"])
    def render_process_gone(self, view, detail):
        crashed, priority = "unknown", "unknown"
        try:
            crashed = str(bool(detail.didCrash()))
            priority = str(int(detail.rendererPriorityAtExit()))
        except Exception:
            pass
        try:
            self.owner.renderer_failed(view, "didCrash=" + crashed + "; rendererPriorityAtExit=" + priority)
        except Exception as exc:
            self.owner.plugin.report("Renderer termination callback", exc)
        return True

    def open_external(self, url):
        if urlparse(str(url)).scheme in ["https", "http"]:
            try:
                Intent = jclass("android.content.Intent")
                intent = Intent(Intent.ACTION_VIEW, jclass("android.net.Uri").parse(str(url)))
                intent.addFlags(0x10000000)
                self.owner.context.startActivity(intent)
            except Exception as exc:
                self.owner.plugin.report("Open map link", exc)
        return True

    @joverload("shouldOverrideUrlLoading", ["android.webkit.WebView", "java.lang.String"])
    def navigation_old(self, view, url):
        return self.open_external(url)

    @joverload("shouldOverrideUrlLoading", ["android.webkit.WebView", "android.webkit.WebResourceRequest"])
    def navigation(self, view, request):
        if not request.isForMainFrame():
            return False
        return self.open_external(request.getUrl().toString())


    @staticmethod
    def issue(self, detail, fatal=False):
        prefix = self.owner.bridge_prefix
        def dispatch():
            if self.owner.destroyed or self.owner.bridge_prefix != prefix:
                return
            map_log(self.owner, detail, bucket="resource-errors" if not fatal else None)
            if fatal:
                self.owner.fail(detail)
        run_on_ui_thread(dispatch, 1)

    @joverload("onPageStarted", ["android.webkit.WebView", "java.lang.String", "android.graphics.Bitmap"])
    def page_started(self, view, url, favicon):
        map_log(self.owner, "WebView main HTML: load started")

    @joverload("onPageFinished", ["android.webkit.WebView", "java.lang.String"])
    def page_finished(self, view, url):
        map_log(self.owner, "WebView main HTML: load finished (not API/tile readiness)")

    @joverload("onReceivedSslError", ["android.webkit.WebView", "android.webkit.SslErrorHandler", "android.net.http.SslError"])
    def ssl_error(self, view, handler, error):
        handler.cancel()
        try:
            host = urlparse(str(error.getUrl())).hostname
            self.issue(f'SSL error={error.getPrimaryError()!s}; host={host!s}; request cancelled')
        except Exception as exc:
            self.owner.plugin.report("SSL callback", exc)

@java_subclass(Object, jclass(P + "$IMapView"))
class YandexMapView(Base):
    def __init__(self, context, plugin):
        self.context, self.plugin = context, plugin
        self.trace_id, self.trace_started = secrets.token_hex(4), time.monotonic()
        self.page_seq, self.trace_counts = 0, {}
        map_log(self, "IMapView constructor: begin", critical=True)
        self.destroyed = self.ready = self.created = self.resumed = self.failed = False
        self.dispatch_interceptor = self.intercept_interceptor = self.layout_listener = None
        self.consumers, self.pending = [], []
        self.send_buffer, self.send_scheduled = [], False
        self.scheme_fallback = False
        self.engine = self.scheme_engine()
        self.console_errors = 0
        self.touch_result = None
        self.renderer_gone = False
        self.gesture_move_logged = False
        self.gesture_moves = 0
        self.base_density = float(context.getResources().getDisplayMetrics().density)
        self.scale = scale_percent(plugin.get_setting("map_scale", 100)) / 100.0
        self.density = self.base_density * self.scale
        self.bridge_prefix = "AYU_MAP_" + secrets.token_hex(16) + ":"
        map_log(self, "IMap proxy constructor: begin", critical=True)
        self.map = YandexMap.new_instance(init_args=[self])
        map_log(self, "IMap proxy constructor: returned", critical=True)
        self.container = jclass("android.widget.FrameLayout")(context)
        map_log(self, "Native WebView constructor: begin", critical=True)
        self.web = WebView(context)
        map_log(self, "Native WebView constructor: returned", critical=True)
        self.container.addView(self.web, jclass("android.widget.FrameLayout$LayoutParams")(-1, -1))
        self.touch_listener = MapTouchListener.new_instance(init_args=[self])
        self.layout_change_listener = MapLayoutListener.new_instance(init_args=[self])
        self.dispatch_call = TouchCall.new_instance(init_args=[self.forward_touch])
        self.intercept_call = TouchCall.new_instance(init_args=[lambda event: False])
        self.web.setOnTouchListener(self.touch_listener.java)
        self.web.addOnLayoutChangeListener(self.layout_change_listener.java)
        self.chrome = MapChrome.new_instance(init_args=[self])
        self.client = MapClient.new_instance(init_args=[self])
        settings = self.web.getSettings()
        try:
            plugin.last_webview_agent = str(settings.getUserAgentString())
        except Exception:
            pass
        settings.setJavaScriptEnabled(True)
        settings.setDomStorageEnabled(True)
        settings.setUseWideViewPort(True)
        settings.setLoadWithOverviewMode(False)
        try:
            font_scale = float(context.getResources().getConfiguration().fontScale)
            settings.setTextZoom(round(100 * font_scale))
        except Exception:
            font_scale = 1.0
        map_log(self, f'Display: density={self.base_density!s}; fontScale={font_scale!s}; map_scale={self.scale!s}; css_density={self.density!s}')
        settings.setAllowFileAccess(False)
        settings.setAllowContentAccess(False)
        settings.setGeolocationEnabled(False)
        settings.setMixedContentMode(1)  
        settings.setSupportMultipleWindows(False)
        settings.setJavaScriptCanOpenWindowsAutomatically(False)
        sdk = int(jclass("android.os.Build$VERSION").SDK_INT)
        if sdk >= 29:
            self.web.setForceDarkAllowed(False)
            settings.setForceDark(0)
        if sdk >= 33:
            settings.setAlgorithmicDarkeningAllowed(False)
        self.web.setWebChromeClient(self.chrome.java)
        self.web.setWebViewClient(self.client.java)
        self.web.setBackgroundColor(0)
        plugin.views.add(self)
        map_log(self, f'IMapView constructor: WebView/listeners installed; Android API={sdk!s}; dark={self.map.dark!s}; forced dark disabled', critical=True)

    def forward_touch(self, event):
        if self.intercept_interceptor is not None:
            self.intercept_interceptor.onInterceptTouchEvent(event, self.intercept_call.java)
        self.touch_result = bool(self.web.onTouchEvent(event))
        return self.touch_result

    def scheme_engine(self):
        return 2 if self.scheme_fallback else 3

    def switch_engine(self, engine):
        def switch():
            if self.destroyed or python_state(self, "renderer_gone", False) or self.engine == engine:
                return
            map_log(self, f'Engine switch: {self.engine!s} -> {engine!s}; markers={len(self.map.markers)!s}; circles={len(self.map.circles)!s}; queued={len(self.pending)!s}')
            self.map.cancel_animations()
            self.engine = engine
            self.map.eccentricity = ECCENTRICITY if engine == 2 else 0.0
            if not self.created:
                return
            self.ready = self.failed = False
            self.pending.clear()
            self.send_buffer.clear()
            self.send_scheduled = False
            self.bridge_prefix = "AYU_MAP_" + secrets.token_hex(16) + ":"
            self.web.stopLoading()
            self.load_page()
            self.command("padding", {"value": [x / self.density for x in self.map.padding]})
            self.command("camera", {"center": list(self.map.center), "zoom": self.map.zoom, "animation": -1, "duration": 0})
            self.command("type", {"value": {0: "yandex#map", 1: "yandex#satellite", 2: "yandex#hybrid"}.get(self.map.map_type, "yandex#map")})
            self.command("dark", {"enabled": self.map.dark})
            self.command("control", {"name": "zoomControl", "enabled": self.map.zoom_controls})
            self.command("locationButton", {"enabled": self.map.location_button})
            for marker in self.map.markers.values():
                marker.sync(force=True)
            for circle in self.map.circles.values():
                circle.sync()
            if self.map.location is not None and self.map.location_enabled:
                self.map.location_changed(self.map.location)
            map_log(self, "Engine switch: state queued for restoration; queued=" + str(len(self.pending)))
        ui(switch)

    def load_page(self):
        self.console_errors = 0
        self.page_seq += 1
        self.trace_counts.clear()
        origin = origin_url(self.plugin.get_setting("origin", DEFAULT_ORIGIN))
        self.loader_origin = origin  
        self.loader_prefix = self.bridge_prefix
        self.loader_failure = None
        key = str(self.plugin.get_setting("api_key", "")).strip()
        self.loader_key = key
        map_log(self, f'HTML build: begin; key_present={bool(key)!s}; Referer host={urlparse(origin).hostname!s}; dark={self.map.dark!s}; map_type={self.map.map_type!s}')
        if debug_enabled(self.plugin):
            try:
                package = WebView.getCurrentWebViewPackage()
                map_log(self, f'WebView package={package.packageName!s}; version={package.versionName!s}')
            except Exception:
                map_log(self, "WebView package/version query unavailable")
        document = make_html(key, self.bridge_prefix,
                             engine=self.engine, dark=self.map.dark, center=self.map.center, zoom=self.map.zoom,
                             scale=python_state(self, "scale", 1.0), dim_fallback=False,
                             debug=debug_enabled(self.plugin))
        map_log(self, f'HTML build: finished; chars={len(document)!s}; loadDataWithBaseURL begin', critical=True)
        self.web.loadDataWithBaseURL(origin, document, "text/html", "UTF-8", None)
        map_log(self, "loadDataWithBaseURL returned; awaiting API bridge", critical=True)

    def command(self, name, data):
        payload = json.dumps({"name": name, "data": data}, separators=(",", ":"), allow_nan=False)
        def send():
            if self.destroyed or self.failed:
                map_log(self, "Command discarded: " + name + "; destroyed=" + str(self.destroyed) + "; failed=" + str(self.failed), bucket="discard-" + name)
                return
            description = name
            if name == "camera":
                description += f"; bounds={'bounds' in data!s}; duration={data.get('duration', 0)!s}; animation={data.get('animation', -1)!s}"
            elif name in ["marker", "circle", "remove"]:
                description += "; object=" + str(data.get("id", "?"))
            elif name == "type":
                description += "; value=" + str(data.get("value", "?"))
            elif name in ["dark", "control", "locationButton"]:
                description += "; enabled=" + str(data.get("enabled", False))
            if not self.ready:
                self.pending.append(payload)
                map_log(self, "Command queued: " + description + "; queue=" + str(len(self.pending)), bucket="cmd-" + name)
                return
            map_log(self, "Command send: " + description, bucket="cmd-" + name)
            self.send_buffer.append(payload)
            if not self.send_scheduled:
                self.send_scheduled = True
                prefix = self.bridge_prefix
                run_on_ui_thread(lambda: self.flush_commands(prefix), 16)
        ui(send)

    def flush_commands(self, prefix):
        if prefix != self.bridge_prefix or self.destroyed or self.failed or not self.ready:
            return
        self.send_scheduled = False
        values, self.send_buffer = self.send_buffer, []
        if not values:
            return
        compact = compact_commands(values)
        batch, rest = compact[:8], compact[8:]
        self.web.evaluateJavascript("window.ayuBatch([" + ",".join(batch) + "]);", None)
        if rest:
            self.send_buffer = rest + self.send_buffer
            self.send_scheduled = True
            run_on_ui_thread(lambda: self.flush_commands(prefix), 16)
        map_log(self, f'Command batch: input={len(values)!s}; compact={len(compact)!s}; sent={len(batch)!s}; remaining={len(rest)!s}', bucket="batch")

    def start_ui_probe(self):
        if not debug_enabled(self.plugin):
            return
        remaining, worst = 30, 0.0
        deadline = time.monotonic() + 0.05
        def tick():
            nonlocal remaining, worst, deadline
            if self.destroyed or not debug_enabled(self.plugin):
                return
            now = time.monotonic()
            late = max(0.0, (now - deadline) * 1000)
            worst = max(worst, late)
            if late >= 32:
                map_log(self, f'UI scheduling delay={round(late)!s}ms; ready={self.ready!s}')
            remaining -= 1
            if remaining:
                deadline = now + 0.05
                run_on_ui_thread(tick, 50)
            else:
                map_log(self, f'UI startup probe finished; max_lateness={round(worst)!s}ms')
        run_on_ui_thread(tick, 50)

    def fail(self, message):
        if self.destroyed or self.failed:
            return
        if python_state(self, "engine", 2) == 3 and self.map.map_type == 0 and not self.scheme_fallback:
            loader_failure = python_state(self, "loader_failure")
            if loader_failure and loader_failure[0] == self.bridge_prefix:
                message += "\n" + loader_failure[1]
            map_log(self, f'API 3 failed; ready={self.ready!s}; falling back to API 2.1; ' + message)
            self.plugin.report("Схема API 3: переход на API 2.1; map=" + str(python_state(self, "trace_id", "?")), RuntimeError(message))
            self.scheme_fallback = True
            self.switch_engine(2)
            return
        self.failed = True
        self.pending.clear()
        self.map.stop_location()
        self.map.cancel_animations()
        self.plugin.report("Map load; map=" + str(python_state(self, "trace_id", "?")), RuntimeError(message))
        map_log(self, "Map failed; queue cleared; location subscriptions stopped; loading callback released")
        self.map.emit("loaded")

    def event(self, data):
        if self.destroyed or python_state(self, "renderer_gone", False) or not isinstance(data, dict):
            return
        event = data.get("event")
        if event == "diagnostic":
            map_log(self, self.plugin.redact(str(data.get("detail", "")))[:3000])
        elif event == "display":
            width = float(data.get("width", 0))
            physical = float(viewport(self).getWidth())
            if width > 0 and physical > 0 and 0.1 <= physical / width <= 20:
                self.density = physical / width
                self.command("padding", {"value": [x / self.density for x in self.map.padding]})
            map_log(self, f"Web display: css_width={width!s}; physical_width={physical!s}; DPR={data.get('dpr')!s}; visual_scale={data.get('scale')!s}; effective_density={self.density!s}")
        elif event == "error":
            self.fail("Яндекс не загрузился. " + str(data.get("detail", ""))[:3000])
        elif event == "ready" and not self.ready and not self.failed:
            if python_state(self, "engine", 2) == 3:
                self.map.eccentricity = ECCENTRICITY if data.get("ellipsoid") else 0.0
            self.ready = True
            map_log(self, f'Bridge ready: received; queued={len(self.pending)!s}; markers={len(self.map.markers)!s}; circles={len(self.map.circles)!s}; ellipsoid={bool(self.map.eccentricity)!s}')
            preview_caption(self)
            self.plugin.checkpoint("Карта готова; JS API " + str(python_state(self, "engine", 2)))
            consumers, self.consumers = self.consumers, []
            pending, self.pending = self.pending, []
            compact = compact_commands(pending)
            self.send_buffer = compact
            self.send_scheduled = False
            YandexMapView.flush_commands(self, self.bridge_prefix)
            for callback in consumers:
                callback.accept(self.map.java)
            self.map.emit("loaded")
            map_log(self, f"Bridge ready: queue flushed; consumers={len(consumers)!s}; host loaded listener present={self.map.listeners.get('loaded') is not None!s}")
        elif event == "camera":
            center = data.get("center")
            zoom = data.get("zoom")
            if not isinstance(center, list) or len(center) != 2:
                return
            values = [float(center[0]), float(center[1]), float(zoom)]
            if not all(math.isfinite(x) for x in values) or abs(values[0]) > 90 or not 0 <= values[2] <= 23:
                return
            self.map.center = [values[0], (values[1] + 180) % 360 - 180]
            self.map.zoom = values[2]
            self.map.emit("move")
            if data.get("idle"):
                self.map.emit("idle")
                map_log(self, "Camera idle: host notified; zoom=" + str(round(self.map.zoom, 2)), bucket="camera-idle")
        elif event == "start":
            map_log(self, "Camera start: gesture=" + str(bool(data.get("gesture"))), bucket="camera-start")
            self.map.emit("start", 1 if data.get("gesture") else 3)
        elif event in ["finish", "cancel"]:
            callback = self.map.animations.pop(int(data.get("animation", -1)), None)
            call_listener(callback, "onFinish" if event == "finish" else "onCancel")
            map_log(self, "Animation " + event + "; id=" + str(data.get("animation", -1)) + "; host_callback=" + str(callback is not None), bucket="animation")
        elif event == "marker":
            marker = self.map.markers.get(str(data.get("id")))
            if marker is not None and not marker.removed:
                self.map.emit("marker", marker.java)
        elif event == "locate" and self.map.location is not None:
            self.map.camera(CameraUpdate.new_instance(init_args=[{"center": [float(self.map.location.getLatitude()), float(self.map.location.getLongitude())], "zoom": 16}]).java, 300)

    @joverload("getView", [])
    def getView(self):
        return self.container

    @joverload("getGlSurfaceView", [])
    def getGlSurfaceView(self):
        return None

    @joverload("onCreate", ["android.os.Bundle"])
    def onCreate(self, bundle):
        def create():
            if self.created or self.destroyed:
                return
            self.created = True
            map_log(self, "Lifecycle onCreate")
            self.start_ui_probe()
            def load():
                if not self.destroyed and self.page_seq == 0:
                    self.load_page()
            run_on_ui_thread(load, 32)
        ui(create)

    @joverload("getMapAsync", ["androidx.core.util.Consumer"])
    def getMapAsync(self, consumer):
        def get():
            if self.destroyed:
                return
            consumer.accept(self.map.java)
            map_log(self, "getMapAsync: host adapter supplied; ready=" + str(self.ready))
        ui(get)

    @joverload("onResume", [])
    def onResume(self):
        def resume():
            if not self.destroyed:
                self.resumed = True
                if self.web is None:
                    map_log(self, "Lifecycle onResume: renderer gone; native error panel retained")
                    return
                self.map.dark = resolved_theme(self)
                self.command("dark", {"enabled": self.map.dark})
                self.web.onResume()
                map_log(self, f'Lifecycle onResume; ready={self.ready!s}; location_enabled={self.map.location_enabled!s}')
                try:
                    map_log(self, f'Attached WebView: width={self.web.getWidth()!s}; height={self.web.getHeight()!s}; hardware_accelerated={self.web.isHardwareAccelerated()!s}')
                except Exception:
                    pass
                self.map.start_location()
                self.command("resize", {})
        ui(resume)

    @joverload("onPause", [])
    def onPause(self):
        def pause():
            if not self.destroyed:
                self.resumed = False
                self.map.stop_location()
                if self.web is not None:
                    self.web.onPause()
                map_log(self, "Lifecycle onPause; location subscriptions stopped")
        ui(pause)

    @joverload("onLowMemory", [])
    def onLowMemory(self):
        pass

    @joverload("onDestroy", [])
    def onDestroy(self):
        ui(self.destroy)

    def renderer_failed(self, web, detail):
        if self.renderer_gone:
            return
        map_log(self, "WebView renderer exited: " + detail, critical=True)
        self.plugin.report("WebView renderer; map=" + self.trace_id, RuntimeError(detail))
        self.renderer_gone, self.failed, self.ready = True, True, False
        self.bridge_prefix = "CLOSED_" + secrets.token_hex(8) + ":"
        self.pending.clear()
        self.send_buffer = []
        self.send_scheduled = False
        self.consumers.clear()
        self.web = None
        try:
            parent = web.getParent()
            if parent is not None:
                parent.removeView(web)
        except Exception as exc:
            self.plugin.report("Detach dead WebView", exc)
        try:
            web.destroy()
        except Exception as exc:
            self.plugin.report("Destroy dead WebView", exc)
        map_log(self, "Renderer cleanup: dead WebView removed; future commands blocked", critical=True)
        def notify():
            if self.destroyed:
                return
            try:
                self.map.stop_location()
                self.map.cancel_animations()
                text = jclass("android.widget.TextView")(self.context)
                text.setText(ui_text("renderer_error"))
                text.setTextColor(-1 if self.map.dark else -16777216)
                text.setTextSize(16)
                padding = int(16 * self.density)
                text.setPadding(padding, padding, padding, padding)
                self.container.setBackgroundColor(-14737119 if self.map.dark else -1)
                self.container.addView(text, jclass("android.widget.FrameLayout$LayoutParams")(-1, -1))
                self.map.emit("loaded")
                map_log(self, "Renderer cleanup: host notified; native error panel shown", critical=True)
            except Exception as exc:
                self.plugin.report("Renderer error panel", exc)
        run_on_ui_thread(notify, 1)

    def destroy(self):
        if self.destroyed:
            return
        map_log(self, "Lifecycle onDestroy: cleanup begin; event_counts=" + json.dumps(self.trace_counts, separators=(",", ":")))
        self.destroyed = True
        self.map.stop_location()
        self.map.cancel_animations()
        self.map.listeners.clear()
        self.map.markers.clear()
        self.map.circles.clear()
        self.pending.clear()
        self.send_buffer = []
        self.send_scheduled = False
        self.consumers.clear()
        self.dispatch_interceptor = self.intercept_interceptor = self.layout_listener = None
        if self.web is not None:
            self.web.setOnTouchListener(None)
            self.web.removeOnLayoutChangeListener(self.layout_change_listener.java)
            self.web.stopLoading()
            self.web.setWebChromeClient(None)
            parent = self.web.getParent()
            if parent is not None:
                parent.removeView(self.web)
            self.web.destroy()
            self.web = None
        self.chrome = self.client = None
        self.plugin.views.discard(self)
        map_log(self, "Lifecycle onDestroy: WebView destroyed and callbacks detached", critical=True)

    @joverload("setOnDispatchTouchEventInterceptor", [P + "$ITouchInterceptor"])
    def setOnDispatchTouchEventInterceptor(self, interceptor):
        self.dispatch_interceptor = interceptor

    @joverload("setOnInterceptTouchEventInterceptor", [P + "$ITouchInterceptor"])
    def setOnInterceptTouchEventInterceptor(self, interceptor):
        self.intercept_interceptor = interceptor

    @joverload("setOnLayoutListener", ["java.lang.Runnable"])
    def setOnLayoutListener(self, listener):
        self.layout_listener = listener


@java_subclass(Object, jclass(P))
class YandexProvider(Base):
    def __init__(self, plugin):
        self.plugin = plugin

    @joverload("initializeMaps", ["android.content.Context"])
    def initializeMaps(self, context):
        pass

    @joverload("onCreateMapView", ["android.content.Context"])
    def onCreateMapView(self, context):
        started = time.monotonic()
        self.plugin.remember("Provider.onCreateMapView: entered; main_thread=" + str(Looper.myLooper() == Looper.getMainLooper()), critical=True)
        try:
            view = YandexMapView.new_instance(init_args=[context, self.plugin])
            self.plugin.remember("Provider.onCreateMapView: returned; elapsed_ms=" + str(int((time.monotonic() - started) * 1000)), critical=True)
            return view.java
        except Exception as exc:
            self.plugin.report("Provider.onCreateMapView", exc)
            raise

    @joverload("onCreateMarkerOptions", [])
    def onCreateMarkerOptions(self):
        return MarkerOptions.new_instance().java

    @joverload("onCreateCircleOptions", [])
    def onCreateCircleOptions(self):
        return CircleOptions.new_instance().java

    @joverload("onCreateLatLngBoundsBuilder", [])
    def onCreateLatLngBoundsBuilder(self):
        return BoundsBuilder.new_instance().java

    @joverload("newCameraUpdateLatLng", [P + "$LatLng"])
    def newCameraUpdateLatLng(self, position):
        return CameraUpdate.new_instance(init_args=[{"center": coord(position)}]).java

    @joverload("newCameraUpdateLatLngZoom", [P + "$LatLng", "float"])
    def newCameraUpdateLatLngZoom(self, position, zoom):
        return CameraUpdate.new_instance(init_args=[{"center": coord(position), "zoom": max(0, min(21, float(zoom)))}]).java

    @joverload("newCameraUpdateLatLngBounds", [P + "$ILatLngBounds", "int"])
    def newCameraUpdateLatLngBounds(self, bounds, padding):
        return CameraUpdate.new_instance(init_args=[{"bounds": Bounds.from_java(bounds).bounds, "padding": max(0, int(padding))}]).java

    @joverload("loadRawResourceStyle", ["android.content.Context", "int"])
    def loadRawResourceStyle(self, context, resource):
        return MapStyle.new_instance(init_args=[True]).java

    @joverload("getMapsAppPackageName", [])
    def getMapsAppPackageName(self):
        return "ru.yandex.yandexmaps"

    @joverload("getInstallMapsString", [])
    def getInstallMapsString(self):
        return int(jclass("org.telegram.messenger.GoogleMapsProvider")().getInstallMapsString())


class ProviderHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        plugin = self.plugin
        if not plugin.active:
            return
        if any(not view.destroyed for view in getattr(plugin, "views", [])):
            param.setResult(plugin.provider.java)
            return
        if not plugin.get_setting("enabled", True):
            return
        try:
            origin_url(plugin.get_setting("origin", DEFAULT_ORIGIN))
            param.setResult(plugin.provider.java)
        except Exception as exc:
            plugin.report("Provider configuration", exc)


class ScreenTraceHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        if self.plugin.active:
            self.plugin.remember("Fullscreen LocationActivity.createView: entered", critical=True)

    def after_hooked_method(self, param):
        if not self.plugin.active:
            return
        try:
            error = param.getThrowable()
            if error is not None:
                stack = "\n".join(str(frame) for frame in list(error.getStackTrace())[:24])
                self.plugin.report("Fullscreen LocationActivity.createView: Java exception", RuntimeError(str(error) + "\n" + stack))
            else:
                self.plugin.remember("Fullscreen LocationActivity.createView: returned", critical=True)
        except Exception as exc:
            self.plugin.report("Fullscreen diagnostic callback", exc)


class AyuYandexMapsPlugin(BasePlugin):
    def on_plugin_load(self):
        self.views = weakref.WeakSet()
        self.screen_hook = None
        self.last_error = self.get_setting("last_diagnostic", "")
        self.active = False
        self.remember("Plugin load: begin; runtime version=" + __version__, critical=True)
        self.migrate_origin()
        self.provider = YandexProvider.new_instance(init_args=[self])
        cls = jclass("org.telegram.messenger.ApplicationLoader").getClass()
        method = cls.getDeclaredMethod("getMapsProvider")
        method.setAccessible(True)
        self.provider_hook = self.hook_method(method, ProviderHook(self))
        if not self.provider_hook:
            raise RuntimeError("Could not hook getMapsProvider")
        self.active = True
        self.remember("Plugin load: provider hook installed (OpenStreetMap)", critical=True)
        self.runtime_log("info", "OpenStreetMap provider hook installed; reopen location screens after settings changes")
        self.remember("Plugin load: completed; awaiting SDK activation", critical=True)

    def start_screen_trace(self):
        if not debug_enabled(self) or getattr(self, "screen_hook", None):
            return
        try:
            cls = jclass("org.telegram.ui.LocationActivity").getClass()
            context_class = jclass("android.content.Context").getClass()
            method = cls.getDeclaredMethod("createView", context_class)
            method.setAccessible(True)
            self.screen_hook = self.hook_method(method, ScreenTraceHook(self))
            self.remember("Fullscreen createView diagnostic hook installed=" + str(bool(self.screen_hook)))
        except Exception as exc:
            self.remember("Fullscreen diagnostic hook unavailable: " + type(exc).__name__)

    def runtime_log(self, level, message):
        if not debug_enabled(self):
            return
        try:
            logger = getattr(self, "logger", None)
            sink = getattr(logger, level, None)
            if callable(sink):
                sink(message)
                return
        except Exception:
            pass
        try:
            self.log("[" + level + "] " + message)
        except Exception:
            pass

    def storage_warning(self, operation, error):
        value = operation + ": " + type(error).__name__ + "; " + str(error)[:600]
        try:
            value = self.redact(value)
        except Exception:
            value = operation + ": " + type(error).__name__
        self.journal_issue = value
        self.runtime_log("error", "Diagnostic storage: " + value)

    def start_journal(self):
        self.journal, self.journal_issue = None, ""
        self.history_memory = str(self.get_setting("diagnostic_history", ""))[-64000:]
        self.failure_memory = str(self.get_setting("last_failure", ""))
        self.session_id = secrets.token_hex(6)
        if not debug_enabled(self):
            return
        try:
            context = jclass("org.telegram.messenger.ApplicationLoader").applicationContext
            directory = os.path.join(str(context.getFilesDir().getAbsolutePath()), "ayu_yandex_maps_diagnostics")
            self.journal = QueuedJournal(directory, legacy=self.redact(self.history_memory),
                                         failure=self.redact(self.failure_memory), on_error=self.journal_write_error)
            self.session_id = self.journal.session
            self.history_memory = ""
        except Exception as exc:
            self.storage_warning("Start background journal", exc)

    def journal_write_error(self, operation, error):
        self.storage_warning(operation, error)
        journal = getattr(self, "journal", None)
        if journal is not None:
            try:
                self.set_setting("diagnostic_history", journal.text(), reload_settings=False)
                self.set_setting("last_failure", journal.failure_text, reload_settings=False)
                self.set_setting("last_api3_probe", journal.probe_text, reload_settings=False)
            except Exception as exc:
                self.storage_warning("Journal and settings unavailable", exc)

    def migrate_origin(self):
        value = str(self.get_setting("origin", "")).strip().rstrip("/")
        if value == LEGACY_ORIGIN.rstrip("/"):
            self.set_setting("origin", DEFAULT_ORIGIN)

    def on_plugin_unload(self):
        self.active = False
        ICON_CACHE.clear()
        self.remember("Plugin unload: begin", critical=True)
        for view in list(getattr(self, "views", [])):
            ui(view.destroy)
        hook = getattr(self, "provider_hook", None)
        if hook:
            self.unhook_method(hook)
            self.provider_hook = None
        screen_hook = getattr(self, "screen_hook", None)
        if screen_hook:
            self.unhook_method(screen_hook)
            self.screen_hook = None
        self.remember("Plugin unload: completed", critical=True)
        journal = getattr(self, "journal", None)
        if journal is not None:
            try:
                journal.finish()
            except Exception as exc:
                self.storage_warning("Finish journal session", exc)

    def report(self, operation, error):
        if not debug_enabled(self):
            return
        detail = operation + "\n" + "".join(traceback.format_exception(type(error), error, error.__traceback__))
        self.last_error = self.redact(detail)[-7000:]
        self.failure_memory = "[" + timestamp() + "] " + self.last_error
        self.remember(self.last_error, critical=True, failure=True)
        try:
            if not isinstance(getattr(self, "journal", None), QueuedJournal):
                self.set_setting("last_failure", self.failure_memory, reload_settings=False)
        except Exception as exc:
            self.storage_warning("Mirror last failure to settings", exc)
        self.runtime_log("error", self.last_error)

    def redact(self, detail):
        key = str(self.get_setting("api_key", "")).strip()
        detail = redact_key(detail, key)
        detail = re.sub(r"https?://[^\s<>\"']+", "[URL]", detail)
        detail = re.sub(r"data:image/[a-zA-Z0-9.+-]+;base64,[A-Za-z0-9+/=]+", "[IMAGE]", detail)
        number = r"[-+]?\d+(?:\.\d+)?(?:[eE][-+]?\d+)?"
        detail = re.sub(r"\[\s*" + number + r"\s*,\s*" + number + r"\s*\]", "[COORDINATES/PAIR]", detail)
        return re.sub(r"(?i)([\"']?(?:latitude|longitude|lat|lon|lng)[\"']?\s*[:=]\s*)" + number, r"\1[COORDINATE]", detail)

    def remember(self, detail, critical=False, failure=False, probe=False):
        if not debug_enabled(self):
            return
        try:
            detail = self.redact(str(detail))
            line = "[" + timestamp() + "] " + detail
            journal = getattr(self, "journal", None)
            if journal is not None:
                try:
                    if probe and isinstance(journal, QueuedJournal):
                        journal.append(detail, critical=True, probe=True)
                    else:
                        journal.append(detail, critical=critical, failure=failure)
                    return
                except Exception as exc:
                    self.storage_warning("Write persistent journal", exc)
            previous = getattr(self, "history_memory", self.get_setting("diagnostic_history", ""))
            self.history_memory = history_tail(previous + "\n" + line)
            try:
                self.set_setting("diagnostic_history", self.history_memory, reload_settings=False)
                self.set_setting("last_diagnostic", detail, reload_settings=False)
                if probe:
                    self.set_setting("last_api3_probe", detail, reload_settings=False)
            except Exception as exc:
                self.storage_warning("Write diagnostic settings", exc)
        except Exception as exc:
            self.storage_warning("Format diagnostic entry", exc)

    def checkpoint(self, detail):
        if debug_enabled(self) and self.get_setting("touch_diagnostics", True):
            self.remember(detail, critical=True)

    def diagnostic_text(self):
        history = getattr(self, "history_memory", "") or self.get_setting("diagnostic_history", "")
        journal = getattr(self, "journal", None)
        if journal is not None:
            try:
                history = journal.text() + ("\n\nРезерв в памяти:\n" + getattr(self, "history_memory", "") if getattr(self, "history_memory", "") else "")
            except Exception as exc:
                self.storage_warning("Read persistent journal", exc)
        history = history or getattr(self, "last_error", "") or ui_text("empty_journal")
        header = ui_text("plugin_name") + " " + __version__ + "\nСовместимая схема: " + str(bool(self.get_setting("compatible_scheme", False)))
        header += f"\nМасштаб карты: {scale_percent(self.get_setting('map_scale', 100))!s}%"
        header += "\nСессия: " + str(getattr(self, "session_id", "not loaded"))
        header += "\nХранилище: " + ("файл приложения; запись и fsync в фоновом потоке" if journal is not None else "резерв настроек")
        if isinstance(journal, QueuedJournal):
            header += f'\nОчередь журнала: {journal.queue.qsize()!s}; пропущено: {journal.dropped!s}; максимальная запись: {journal.max_write_ms!s} ms'
        issue = getattr(self, "journal_issue", "")
        if issue:
            header += "\nОшибка сохранения журнала: " + issue
        failure = journal.failure_text if isinstance(journal, QueuedJournal) else (getattr(self, "failure_memory", "") or self.get_setting("last_failure", ""))
        return self.redact(header + ("\n\nПоследняя ошибка (сохранена отдельно):\n" + failure if failure else "") + "\n\nИстория:\n" + history)

    def copy_diagnostics(self, *_):
        def copy():
            try:
                copy_to_clipboard(self.diagnostic_text())
            except Exception as exc:
                self.report("Copy diagnostics", exc)
        ui(copy)
        return True

    def clear_diagnostics(self, *_):
        self.api_probe_generation = getattr(self, "api_probe_generation", 0) + 1
        self.history_memory, self.failure_memory, self.last_error = "", "", ""
        journal = getattr(self, "journal", None)
        try:
            if journal is not None:
                journal.clear()
            for key in ("diagnostic_history", "last_failure", "last_diagnostic", "last_api3_probe"):
                self.set_setting(key, "", reload_settings=False)
            if journal is None:
                self.remember(ui_text("journal_cleared"), critical=True)
        except Exception as exc:
            self.report("Clear diagnostics", exc)
        return True

    def api3_probe_text(self):
        journal = getattr(self, "journal", None)
        text = journal.probe_text if isinstance(journal, QueuedJournal) else ""
        text = text or self.get_setting("last_api3_probe", "")
        return self.redact(text or ui_text("probe_running" if getattr(self, "api_probe_busy", False) else "empty_probe"))

    def clear_api3_probe(self, *_):
        self.api_probe_generation = getattr(self, "api_probe_generation", 0) + 1
        try:
            journal = getattr(self, "journal", None)
            if isinstance(journal, QueuedJournal):
                journal.clear_probe()
            self.set_setting("last_api3_probe", "", reload_settings=False)
        except Exception as exc:
            self.report("Clear API access probe", exc)
        return True

    def show_api3_probe(self, *_):
        def show():
            try:
                fragment = get_last_fragment()
                activity = fragment.getParentActivity() if fragment is not None else None
                if activity is None:
                    self.copy_api3_probe()
                    return
                builder = AlertDialogBuilder(activity)
                builder.set_title(ui_text("probe_title"))
                builder.set_message(self.api3_probe_text())
                builder.set_positive_button(ui_text("copy"), lambda b, which: self.copy_api3_probe())
                builder.set_negative_button(ui_text("close"), lambda b, which: b.dismiss())
                def check(b, which):
                    b.dismiss()
                    self.check_api3()
                builder.set_neutral_button(ui_text("run_probe"), check)
                previous = getattr(self, "probe_dialog", None)
                if previous is not None:
                    previous.dismiss()
                builder.show()
                self.probe_dialog = builder
            except Exception as exc:
                self.report("Show API access probe", exc)
        ui(show)

    def copy_api3_probe(self, *_):
        def copy():
            try:
                copy_to_clipboard(self.api3_probe_text())
            except Exception as exc:
                self.report("Copy API access probe", exc)
        ui(copy)
        return True

    def check_api3(self, *_):
        if getattr(self, "api_probe_busy", False):
            return True
        self.api_probe_busy = True
        generation = getattr(self, "api_probe_generation", 0)
        key = str(self.get_setting("api_key", "")).strip()
        raw_origin = self.get_setting("origin", DEFAULT_ORIGIN)
        agent = getattr(self, "last_webview_agent", "")
        self.remember("API access probe: requested; 2 HTTPS requests, up to 2 extra localhost header comparisons after API 3 HTTP 403", critical=True)
        def worker():
            sanitize = lambda value: self.redact(redact_key(str(value), key))
            trace = lambda value: self.remember(sanitize(value), critical=True)
            try:
                origin = origin_url(raw_origin)
                report = ui_text("plugin_name") + " " + __version__ + " — проверка " + timestamp()
                report += "\nReferer: " + referer_diagnostic(origin)
                report += f'\nКлюч: присутствует={bool(key)!s}; длина={len(key)!s}; значение скрыто'
                report += "\nКлюч: " + key_diagnostic(key)
                report += "\nUA: " + ("cached WebView" if agent else "HTTP client default")
                report += "\nПроверка использует снимок настроек и не загружает карту/тайлы."
                report += "\nclient_header_matches — чтение настроек клиента до соединения, не подтверждение получения заголовка сервером."
                if not key:
                    report += "\nНет ключа: сетевые запросы не выполнялись."
                else:
                    outcomes = [api_probe_request(key, origin, engine, agent, sanitize, trace) for engine in (3, 2)]
                    report += "\n\n" + "\n\n".join(item["detail"] for item in outcomes)
                    if outcomes[0]["js"]:
                        report += "\n\nAPI 3 отдаёт JavaScript через HTTPS. Если карта всё ещё не запускается, проверяй в журнале этап ymaps3.ready и ошибки следующих ресурсов WebView."
                    elif outcomes[1]["js"]:
                        report += "\n\nAPI 2.1 отдаёт JavaScript, API 3 — нет. Это различие доступа/ответов двух версий; само по себе оно не доказывает платное ограничение."
                    else:
                        report += "\n\nОба загрузчика не подтвердили доступный JavaScript. Смотри код/тело отказа или стадию транспортной ошибки."
                    variants = localhost_probe_variants(origin, outcomes[0], outcomes[1])
                    if variants:
                        report += "\n\nСравнение форматов Referer localhost. Все запросы идут к Яндексу по HTTPS; меняется только заголовок. Настройки карты не меняются."
                        successful, statuses = [], []
                        for variant in variants:
                            trace("API 3 Referer comparison: begin; " + referer_diagnostic(variant))
                            result = api_probe_request(key, variant, 3, agent, sanitize, trace)
                            report += "\n\nВариант Referer: " + referer_diagnostic(variant) + "\n" + result["detail"]
                            statuses.append(result.get("status"))
                            if result["js"]:
                                successful.append(referer_diagnostic(variant))
                        if successful:
                            report += "\n\nРезультат зависит от формата Referer. JavaScript доступен с: " + " | ".join(successful)
                            report += "\nЭто диагностический результат: формат страницы карты не переключён автоматически, рендеринг не проверен."
                        elif all(status == 403 for status in statuses):
                            report += "\n\nВсе проверенные форматы localhost возвращают 403. Смена схемы/порта Referer не устранила отказ."
                            report += "\nСверь ключ повторным копированием из кабинета в плагин; если после применения ограничений отказ сохраняется, передай этот отчёт поддержке Яндекса для проверки доступа ключа к API 3."
                        else:
                            report += "\n\nДополнительные варианты не подтвердили доступный JavaScript; смотри их HTTP-коды и транспортные ошибки."
                if generation == getattr(self, "api_probe_generation", 0):
                    self.remember(sanitize(report), critical=True, probe=True)
            except Exception as exc:
                if generation == getattr(self, "api_probe_generation", 0):
                    self.remember(sanitize("Проверка API 3 не завершилась:\n" + str(exc)), critical=True, probe=True)
            finally:
                self.api_probe_busy = False
                def show():
                    if getattr(self, "active", True) and debug_enabled(self) and generation == getattr(self, "api_probe_generation", 0):
                        self.show_api3_probe()
                run_on_ui_thread(show, 1)
        self.api_probe_worker = threading.Thread(target=worker, name="AyuMapsAPIProbe", daemon=True)
        try:
            self.api_probe_worker.start()
        except Exception as exc:
            self.api_probe_busy = False
            self.remember("Не удалось запустить проверку API 3:\n" + str(exc), critical=True, probe=True)
            self.show_api3_probe()
        return True

    def show_diagnostics(self, *_):
        def show():
            try:
                fragment = get_last_fragment()
                activity = fragment.getParentActivity() if fragment is not None else None
                if activity is None:
                    self.copy_diagnostics()
                    return
                builder = AlertDialogBuilder(activity)
                builder.set_title(ui_text("journal_title", version=__version__))
                builder.set_message(self.diagnostic_text())
                builder.set_positive_button(ui_text("copy"), lambda b, which: self.copy_diagnostics())
                builder.set_negative_button(ui_text("close"), lambda b, which: b.dismiss())
                def clear(b, which):
                    self.clear_diagnostics()
                    b.dismiss()
                builder.set_neutral_button(ui_text("clear"), clear)
                builder.show()
            except Exception as exc:
                self.report("Show diagnostics", exc)
        ui(show)

    def create_scale_preview(self, context, list_view, current_account, class_guid, resources_provider):
        self.__dict__.setdefault("views", weakref.WeakSet())
        self.__dict__.setdefault("previews", weakref.WeakSet())
        density = float(context.getResources().getDisplayMetrics().density)
        layout = jclass("android.widget.LinearLayout")(context)
        layout.setOrientation(1)
        layout.setLayoutParams(jclass("androidx.recyclerview.widget.RecyclerView$LayoutParams")(-1, -2))
        pad = round(16 * density)
        layout.setPadding(pad, pad, pad, pad)
        label = jclass("android.widget.TextView")(context)
        label.setTextSize(16)
        Theme = jclass("org.telegram.ui.ActionBar.Theme")
        label.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlueHeader))
        bar = jclass("org.telegram.ui.Components.SeekBarView")(context, resources_provider)
        value = scale_percent(self.get_setting("map_scale", 100))
        listener = ScaleListener.new_instance(init_args=[label, value, self])
        bar.setDelegate(listener.java)
        bar.setTag(listener.java)
        bar.setReportChanges(True)
        bar.setProgress((value - 50) / 130.0)
        listener.show_value(value)
        layout.addView(label)
        params = jclass("android.widget.LinearLayout$LayoutParams")
        layout.addView(bar, params(-1, round(48 * density)))
        slot = jclass("android.widget.FrameLayout")(context)
        background = jclass("android.graphics.drawable.GradientDrawable")()
        background.setColor(Theme.getColor(Theme.key_windowBackgroundWhite))
        background.setCornerRadius(12 * density)
        slot.setBackground(background)
        slot.setClipToOutline(True)
        layout.addView(slot, params(-1, round(240 * density)))
        caption = jclass("android.widget.TextView")(context)
        caption.setTextSize(12)
        caption.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText))
        caption.setText(ui_text("preview_loading"))
        caption.setVisibility(0 if debug_enabled(self) else 8)
        caption.setPadding(0, round(8 * density), 0, 0)
        layout.addView(caption)
        lifecycle = PreviewLifecycle.new_instance(init_args=[context, slot, self, caption])
        self.previews.add(lifecycle)
        layout.addOnAttachStateChangeListener(lifecycle.java)
        return layout

    def bind_scale_preview(self, view, item, divider, adapter, list_view):
        bar = view.getChildAt(1)
        listener = ScaleListener.from_java(bar.getTag())
        if not bar.isDragging():
            value = scale_percent(self.get_setting("map_scale", 100))
            listener.show_value(value)
            bar.setProgress((value - 50) / 130.0)

    def apply_scale(self, value):
        percent = scale_percent(value)
        def apply():
            for view in list(self.views):
                if view.destroyed:
                    continue
                view.scale = percent / 100.0
                view.density = python_state(view, "base_density", view.density) * view.scale
                view.command("scale", {"value": view.scale})
        ui(apply)

    def on_dim_change(self, value):
        self.set_setting("dim_fallback", bool(value), reload_settings=False)
        for view in list(self.views):
            if not view.destroyed:
                view.command("dimFallback", {"enabled": bool(value)})
                preview_caption(view)

    def refresh_previews(self, *_):
        def refresh():
            for lifecycle in list(getattr(self, "previews", [])):
                if lifecycle.slot.isAttachedToWindow():
                    lifecycle.detached(None)
                    lifecycle.attached(None)
        run_on_ui_thread(refresh, 50)

    def on_key_change(self, value):
        self.set_setting("api_key", str(value).strip(), reload_settings=True)
        self.refresh_previews()

    def on_origin_change(self, value):
        self.set_setting("origin", str(value).strip(), reload_settings=True)
        self.refresh_previews()

    def on_theme_change(self, value):
        def apply():
            for view in list(self.views):
                if view.destroyed:
                    continue
                view.map.dark = resolved_theme(view, value)
                map_log(view, f'Theme preference={value!s}; resolved_dark={view.map.dark!s}')
                view.command("dark", {"enabled": view.map.dark})
                preview_caption(view)
        ui(apply)

    def create_diagnostic_row(self, kind, context, list_view, current_account, class_guid, resources_provider):
        Theme = jclass("org.telegram.ui.ActionBar.Theme")
        density = float(context.getResources().getDisplayMetrics().density)
        row = jclass("android.widget.LinearLayout")(context)
        row.setOrientation(0)
        row.setLayoutParams(jclass("androidx.recyclerview.widget.RecyclerView$LayoutParams")(-1, -2))
        row.setGravity(16)
        row.setMinimumHeight(round(56 * density))
        row.setPadding(round(20 * density), 0, round(8 * density), 0)
        params = jclass("android.widget.LinearLayout$LayoutParams")
        label = jclass("android.widget.TextView")(context)
        label.setText(ui_text(kind))
        label.setTextSize(16)
        label.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlueHeader))
        label.setGravity(16)
        label.setPadding(0, round(12 * density), round(8 * density), round(12 * density))
        show = self.show_diagnostics if kind == "journal" else self.show_api3_probe
        listener = SettingsClick.new_instance(init_args=[self, show])
        label.setOnClickListener(listener.java)
        label.setTag(listener.java)
        row.addView(label, params(0, -2, 1.0))
        actions = [("msg_copy", "copy_journal", self.copy_diagnostics), ("msg_delete", "clear_journal", self.clear_diagnostics)] if kind == "journal" else [
            ("msg_copy", "copy_probe", self.copy_api3_probe), ("msg_delete", "clear_probe", self.clear_api3_probe)]
        for icon, description, callback in actions:
            try:
                resource = context.getResources().getIdentifier(icon, "drawable", context.getPackageName())
                if not resource:
                    continue
                button = jclass("android.widget.ImageView")(context)
                button.setImageResource(resource)
                button.setColorFilter(Theme.getColor(Theme.key_windowBackgroundWhiteGrayIcon))
                button.setPadding(round(12 * density), round(12 * density), round(12 * density), round(12 * density))
                button.setContentDescription(ui_text(description))
                button.setBackground(Theme.createSelectorDrawable(Theme.getColor(Theme.key_listSelector), 2))
                listener = SettingsClick.new_instance(init_args=[self, callback])
                button.setOnClickListener(listener.java)
                button.setTag(listener.java)
                row.addView(button, params(round(48 * density), round(48 * density)))
            except Exception as exc:
                self.remember("Settings icon unavailable: " + icon + "; " + type(exc).__name__)
        return row

    def diagnostic_setting(self, kind):
        factories = self.__dict__.setdefault("diagnostic_factories", {})
        if kind not in factories:
            factories[kind] = SimpleSettingFactory(
                lambda *args: self.create_diagnostic_row(kind, *args),
                lambda *args: None, is_clickable=False, is_shadow=False)
        return Custom(factory=factories[kind].instance.java, link_alias=kind,
                      on_click=self.show_diagnostics if kind == "journal" else self.show_api3_probe,
                      on_long_click=self.copy_diagnostics if kind == "journal" else self.copy_api3_probe)

    def create_settings(self):
        if self.__dict__.get("scale_factory") is None:
            self.scale_factory = SimpleSettingFactory(
                self.create_scale_preview, self.bind_scale_preview, is_clickable=False, is_shadow=False)
        rows = [Header(text=ui_text("map_header"))]
        rows.extend([
            Switch(key="enabled", text=ui_text("enabled"), default=True, icon="msg_location"),
            Selector(key="map_theme", text=ui_text("theme"), default=0, icon="msg_colors",
                     items=[ui_text("theme_system"), ui_text("theme_light"), ui_text("theme_dark")], on_change=self.on_theme_change),
            Custom(factory=self.scale_factory.instance.java),
            Divider()])
        return rows


PAGE_COMMON = r"""
 const started = Date.now(), commandCounts = Object.create(null);
 let diagnosticQueue = [], diagnosticTimer = null;
 function flushDiagnostics() {
   clearTimeout(diagnosticTimer); diagnosticTimer = null;
   if (!config.debug) {diagnosticQueue = []; return;}
   if (diagnosticQueue.length) {
     emit({event:'diagnostics',entries:diagnosticQueue}); diagnosticQueue = [];
   }
 }
 const diag = (value, critical=false) => {
   if (!config.debug) return;
   const detail = 'API '+apiVersion+' +'+(Date.now()-started)+'ms: '+value;
   if (critical) {flushDiagnostics(); emit({event:'diagnostic',critical,detail});}
   else {
     diagnosticQueue.push(detail);
     if (diagnosticQueue.length >= 16) flushDiagnostics();
     else if (!diagnosticTimer) diagnosticTimer = setTimeout(flushDiagnostics, 32);
   }
 };
 const note = value => {phase=value; diag(value,true);};
 const applied = name => {if(!config.debug) return; const n=commandCounts[name]=(commandCounts[name]||0)+1; if(n<=3 || n%50===0) diag('command '+name+' applied; count='+n);};
 note('inline script initialized; waiting external API script');
 let resourceObserver = null;
 function observeResources() {
   if (!config.debug || resourceObserver || !window.PerformanceObserver) return;
   try {
     let resources=0;
     resourceObserver = new window.PerformanceObserver(list => list.getEntries().forEach(entry => {
       if (++resources<=12 || resources%50===0) {
         try {diag('resource downloaded: host='+new URL(entry.name).hostname+'; type='+entry.initiatorType+'; duration='+Math.round(entry.duration)+'ms; HTTP='+String(entry.responseStatus||'not exposed')+'; count='+resources);} catch (_) {}
       }
     }));
     resourceObserver.observe({entryTypes:['resource']});
   } catch (_) {diag('resource timing observer unavailable');}
 }
 observeResources();
 function reportDisplay() {
   emit({event:'display',width:window.innerWidth||0,dpr:window.devicePixelRatio||1,
     scale:window.visualViewport ? window.visualViewport.scale : 1});
 }
 if (window.addEventListener) window.addEventListener('resize', reportDisplay);
"""


PAGE_JS = r"""
(function () {
 'use strict';
 const config = window.AYU_CONFIG;
 let map = null, objects = Object.create(null), failed = false;
 let idleTimer = null, moveTimer = null, programmatic = 0, animation = 0;
 let dark = !!config.dark;
 const emit = data => console.log(config.prefix + JSON.stringify(data));
 let phase = 'script';
 const apiVersion = 'OSM';

 const started = Date.now(), commandCounts = Object.create(null);
 let diagnosticQueue = [], diagnosticTimer = null;
 function flushDiagnostics() {
   clearTimeout(diagnosticTimer); diagnosticTimer = null;
   if (!config.debug) {diagnosticQueue = []; return;}
   if (diagnosticQueue.length) {
     emit({event:'diagnostics',entries:diagnosticQueue}); diagnosticQueue = [];
   }
 }
 const diag = (value, critical=false) => {
   if (!config.debug) return;
   const detail = 'API '+apiVersion+' +'+(Date.now()-started)+'ms: '+value;
   if (critical) {flushDiagnostics(); emit({event:'diagnostic',critical,detail});}
   else {
     diagnosticQueue.push(detail);
     if (diagnosticQueue.length >= 16) flushDiagnostics();
     else if (!diagnosticTimer) diagnosticTimer = setTimeout(flushDiagnostics, 32);
   }
 };
 const note = value => {phase=value; diag(value,true);};
 const applied = name => {if(!config.debug) return; const n=commandCounts[name]=(commandCounts[name]||0)+1; if(n<=3 || n%50===0) diag('command '+name+' applied; count='+n);};
 note('inline script initialized; waiting external API script');
 let resourceObserver = null;
 function observeResources() {
   if (!config.debug || resourceObserver || !window.PerformanceObserver) return;
   try {
     let resources=0;
     resourceObserver = new window.PerformanceObserver(list => list.getEntries().forEach(entry => {
       if (++resources<=12 || resources%50===0) {
         try {diag('resource downloaded: host='+new URL(entry.name).hostname+'; type='+entry.initiatorType+'; duration='+Math.round(entry.duration)+'ms; HTTP='+String(entry.responseStatus||'not exposed')+'; count='+resources);} catch (_) {}
       }
     }));
     resourceObserver.observe({entryTypes:['resource']});
   } catch (_) {diag('resource timing observer unavailable');}
 }
 observeResources();
 function reportDisplay() {
   emit({event:'display',width:window.innerWidth||0,dpr:window.devicePixelRatio||1,
     scale:window.visualViewport ? window.visualViewport.scale : 1});
 }
 if (window.addEventListener) window.addEventListener('resize', reportDisplay);

 const status = document.getElementById('status');

 function error(reason) {
   if (failed) return;
   failed = true;
   flushDiagnostics();
   clearTimeout(watchdog);
   status.style.display = 'block';
   status.textContent = config.errorText;
   emit({event:'error',detail:'Leaflet/OpenStreetMap '+phase+'\n'+
     (reason && (reason.stack || reason.message) ? String(reason.stack || reason.message).slice(0,2500) : 'script/timeout')});
 }
 window.ayuLoadError = error;
 const watchdog = setTimeout(() => error(new Error('Leaflet loading timeout')), 20000);

 function snapshot(idle) {
   if (!map || failed) return;
   const c = map.getCenter();
   emit({event:'camera',center:[c.lat,c.lng],zoom:map.getZoom(),idle:!!idle});
 }
 function settle() {
   if (!moveTimer) moveTimer = setTimeout(() => {moveTimer=null; snapshot(false);}, 40);
   clearTimeout(idleTimer);
   idleTimer = setTimeout(() => snapshot(true), 120);
 }
 function applyTheme() {
   document.body.dataset.theme = dark ? 'dark' : 'light';
   const tilePane = map && map.getPane('tilePane');
   if (tilePane) tilePane.style.filter = dark ? 'brightness(0.55) saturate(0.75)' : '';
   diag('theme: '+(dark ? 'dark' : 'light')+'; renderer=Leaflet; tiles=OpenStreetMap');
 }
 function iconFor(d) {
   if (d.icon) {
     const size = d.icon.size || [24,24], anchor = d.anchor || [0.5,1];
     if (!/^data:image\/png;base64,[A-Za-z0-9+/=]+$/.test(d.icon.url))
       throw new Error('Invalid icon');
     return L.icon({
       iconUrl:d.icon.url,
       iconSize:size,
       iconAnchor:[size[0]*anchor[0], size[1]*anchor[1]],
       className:'ayu-marker-'+String(d.rotation || 0).replace(/[^0-9.-]/g,'')
     });
   }
   return L.divIcon({
     className:'ayu-default-marker',
     html:'<span style="background:'+(d.silent ? '#4285f4' : '#ef3d37')+'"></span>',
     iconSize:[14,14],
     iconAnchor:[7,7]
   });
 }
 function putMarker(d) {
   let item = objects[d.id];
   if (!item) {
     item = objects[d.id] = L.marker(d.position, {
       icon:iconFor(d),
       title:String(d.title || ''),
       zIndexOffset:d.silent ? 1000 : 0
     });
     item.addTo(map);
     item.on('click', () => { if (!d.silent) emit({event:'marker',id:d.id}); });
   } else {
     item.setLatLng(d.position);
     item.setIcon(iconFor(d));
     item.setTooltipContent(String(d.title || ''));
   }
   if (d.title) {
     if (!item.getTooltip()) item.bindTooltip(String(d.title), {direction:'top',opacity:0.9});
   } else if (item.getTooltip()) item.unbindTooltip();
 }
 function putCircle(d) {
   let item = objects[d.id];
   const opts = {
     color:d.stroke || '#4285f4',
     weight:Number(d.width || 1),
     fillColor:d.fill || '#4285f4',
     fillOpacity:0.18,
     opacity:1
   };
   if (!item) {
     item = objects[d.id] = L.circle(d.position, Object.assign({radius:Math.max(0,Number(d.radius)||0)},opts));
     item.addTo(map);
   } else {
     item.setLatLng(d.position);
     item.setRadius(Math.max(0,Number(d.radius)||0));
     item.setStyle(opts);
   }
 }
 function remove(id) {
   if (objects[id]) {
     try { map.removeLayer(objects[id]); } catch (_) {}
     delete objects[id];
   }
 }
 function fitBounds(bounds, padding) {
   const sw = bounds[0], ne = bounds[1];
   return L.latLngBounds([sw[0],sw[1]],[ne[0],ne[1]]);
 }

 window.ayuDispatch = function (message) {
   if (!map || failed) return;
   const d = message.data || {};
   try {
     phase = 'command '+message.name;
     switch (message.name) {
       case 'scale': {
         const value = Math.max(0.5, Math.min(1.8, Number(d.value)||1));
         const viewport = document.getElementById('viewport');
         viewport.content = 'width=device-width,initial-scale='+value+',minimum-scale='+value+',maximum-scale='+value+',user-scalable=no';
         setTimeout(() => { map.invalidateSize(false); reportDisplay(); snapshot(true); }, 50);
         break;
       }
       case 'dimFallback':
         config.dimFallback = !!d.enabled; applyTheme(); break;
       case 'camera': {
         const id = d.animation;
         programmatic++;
         emit({event:'start',gesture:false});
         const done = cancelled => {
           programmatic = Math.max(0,programmatic-1);
           snapshot(true);
           emit({event:cancelled ? 'cancel' : 'finish',animation:id});
         };
         if (d.bounds) {
           const b = fitBounds(d.bounds, d.padding || 0);
           map.fitBounds(b, {padding:[d.padding||0,d.padding||0], animate:(d.duration||0)>0, duration:(d.duration||0)/1000});
         } else {
           const center = d.center || [map.getCenter().lat,map.getCenter().lng];
           const zoom = d.zoom === undefined ? map.getZoom() : d.zoom;
           map.setView(center, zoom, {animate:(d.duration||0)>0, duration:(d.duration||0)/1000});
         }
         setTimeout(() => done(false), Math.max(0,Number(d.duration)||0)+80);
         break;
       }
       case 'marker': putMarker(d); break;
       case 'circle': putCircle(d); break;
       case 'remove': remove(d.id); break;
       case 'type':
         // OpenStreetMap provides the standard street map. Satellite/hybrid is intentionally ignored.
         diag('map type ignored: OpenStreetMap standard tiles');
         break;
       case 'padding': {
         const v=d.value || [0,0,0,0];
         const top=Number(v[1])||0,right=Number(v[2])||0,bottom=Number(v[3])||0,left=Number(v[0])||0;
         map.getContainer().style.padding = top+'px '+right+'px '+bottom+'px '+left+'px';
         map.invalidateSize(false); settle(); break;
       }
       case 'resize':
         map.invalidateSize(false); settle(); break;
       case 'control':
         if (d.name === 'zoomControl') {
           if (d.enabled && !window.ayuZoomControl) {
             window.ayuZoomControl = L.control.zoom({position:'topright'});
             map.addControl(window.ayuZoomControl);
           } else if (!d.enabled && window.ayuZoomControl) {
             map.removeControl(window.ayuZoomControl);
             window.ayuZoomControl = null;
           }
         }
         break;
       case 'dark':
         dark = !!d.enabled; applyTheme(); break;
       case 'locationButton':
         document.getElementById('locate').hidden = !d.enabled; break;
       case 'location':
         if (!d.position) { remove('mydot'); remove('myaccuracy'); }
         else {
           putCircle({id:'myaccuracy',position:d.position,radius:d.accuracy,fill:'#4285f425',stroke:'#4285f450',width:1});
           putMarker({id:'mydot',position:d.position,silent:true});
         }
         break;
     }
     applied(message.name);
   } catch (exc) { error(exc); }
 };
 window.ayuBatch = messages => { for (const message of messages) window.ayuDispatch(message); };

 window.ayuBoot = function () {
   if (failed) return;
   try {
     if (!window.L) { error(new Error('Leaflet is unavailable')); return; }
     note('Leaflet loaded; creating OpenStreetMap map');
     map = L.map('map', {
       center:config.center || [55.751244,37.618423],
       zoom:config.zoom === undefined ? 10 : config.zoom,
       zoomControl:false,
       attributionControl:true,
       worldCopyJump:true,
       preferCanvas:false
     });
     L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
       maxZoom:19,
       minZoom:1,
       tileSize:256,
       subdomains:'abc',
       attribution:'&copy; OpenStreetMap contributors'
     }).addTo(map);
     map.on('move', settle);
     map.on('zoom', settle);
     map.on('moveend', () => { if (!programmatic) snapshot(true); });
     map.on('zoomend', () => { if (!programmatic) snapshot(true); });
     map.on('dragstart', () => emit({event:'start',gesture:true}));
     map.on('zoomstart', () => emit({event:'start',gesture:true}));
     map.on('dragend', settle);
     map.on('zoomend', settle);
     document.getElementById('locate').onclick = () => emit({event:'locate'});
     clearTimeout(watchdog);
     status.style.display = 'none';
     applyTheme();
     map.invalidateSize(false);
     note('ready');
     reportDisplay();
     emit({event:'ready',ellipsoid:false});
     snapshot(true);
   } catch (exc) { error(exc); }
 };
})();
"""

PAGE_JS_V3 = PAGE_JS

def make_html(key, prefix, engine=3, dark=False, center=None, zoom=10, scale=1.0, dim_fallback=False, debug=False):
    scale = scale_percent(round(float(scale) * 100)) / 100.0
    config = json.dumps({
        "prefix": prefix,
        "dimFallback": bool(dim_fallback),
        "dark": bool(dark),
        "debug": bool(debug),
        "errorText": ui_text("map_error"),
        "center": center or [55.751244, 37.618423],
        "zoom": zoom
    }, ensure_ascii=True).replace("<", "\\u003c")
    leaflet_css = "https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
    leaflet_js_url = "https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
    return (
        "<!doctype html><html><head><meta charset='utf-8'>"
        "<meta id='viewport' name='viewport' content='width=device-width,initial-scale=" + str(scale) +
        ",minimum-scale=" + str(scale) + ",maximum-scale=" + str(scale) + ",user-scalable=no'>"
        "<link rel='stylesheet' href='" + leaflet_css + "'>"
        "<style>"
        "html,body,#map{width:100%;height:100%;margin:0;overflow:hidden}"
        "html{-webkit-text-size-adjust:100%;text-size-adjust:100%}"
        "body{--bg:#eee;--fg:#222;background:var(--bg)}"
        "body[data-theme=dark]{--bg:#1b1d20;--fg:#eee}"
        "#status{display:none;position:absolute;top:12px;left:12px;right:12px;padding:12px;border-radius:8px;background:var(--bg);color:var(--fg);font:14px sans-serif;z-index:2000}"
        "#locate{position:absolute;right:12px;bottom:40px;z-index:1500;background:var(--bg);color:var(--fg);border:0;border-radius:8px;padding:12px}"
        ".ayu-default-marker{background:transparent;border:0}"
        ".ayu-default-marker span{display:block;width:10px;height:10px;margin:0;border:2px solid white;border-radius:50%;background:#ef3d37;box-shadow:0 1px 4px #0008}"
        ".leaflet-container{font:inherit}"
        ".leaflet-control-attribution{font-size:9px}"
        "[hidden]{display:none!important}"
        "</style></head><body data-theme='" + ("dark" if dark else "light") + "'>"
        "<div id='map'></div><button id='locate' hidden>" + html.escape(ui_text("location_button")) +
        "</button><div id='status'></div>"
        "<script>window.AYU_CONFIG=" + config + ";</script>"
        "<script>" + PAGE_JS +
        "</script><script src='" + leaflet_js_url +
        "' onload='ayuBoot()' onerror='ayuLoadError(new Error(\"Leaflet script download failed\"))'></script>"
        "</body></html>"
    )
