@java_subclass(Object, jclass(P + "$IProjection"))
class Projection(Base):
    def __init__(self, owner):
        self.owner = owner

    @joverload("toScreenLocation", [P + "$LatLng"])
    def toScreenLocation(self, position):
        owner = self.owner
        a, b = project(coord(position), owner.zoom, owner.eccentricity), project(owner.center, owner.zoom, owner.eccentricity)
        world = 256.0 * 2 ** owner.zoom
        dx = (a[0] - b[0] + world / 2) % world - world / 2
        l, t, r, bottom = owner.padding
        x = (viewport(owner.view).getWidth() + l - r) / 2 + dx * owner.view.density
        y = (viewport(owner.view).getHeight() + t - bottom) / 2 + (a[1] - b[1]) * owner.view.density
        return Point(round(x), round(y))


