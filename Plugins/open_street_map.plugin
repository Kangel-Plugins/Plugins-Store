def scale_percent(value):
    try:
        return max(50, min(180, int(value)))
    except (ValueError, TypeError, OverflowError):
        return 100


def compact_commands(payloads):
    result, seen = [], set()
    for payload in reversed(payloads):
        message = json.loads(payload)
        name, data = message["name"], message["data"]
        key = None
        if name in ("marker", "circle", "remove"):
            key = ("object", data.get("id"))
        elif name == "control":
            key = (name, data.get("name"))
        elif name in ("location", "resize", "padding", "dark", "type", "locationButton", "scale", "dimFallback", "debug"):
            key = (name,)
        if key is not None:
            if key in seen:
                continue
            seen.add(key)
        result.append(payload)
    return list(reversed(result))


@java_subclass(Object, jclass("org.telegram.ui.Components.SeekBarView$SeekBarViewDelegate"))
class ScaleListener(Base):
    def __init__(self, label, value, plugin=None):
        self.label, self.value, self.plugin = label, value, plugin

    def show_value(self, value):
        self.value = scale_percent(value)
        self.label.setText(ui_text("scale_value", value=self.value))

    @joverload("onSeekBarDrag", ["boolean", "float"])
    def dragged(self, stop, progress):
        self.show_value(round(50 + 130 * float(progress)))
        if self.plugin is not None:
            self.plugin.apply_scale(self.value)
            if stop:
                self.plugin.set_setting("map_scale", self.value, reload_settings=False)
                self.plugin.remember(f'Map scale saved={self.value!s}%')

    @joverload("onSeekBarPressed", ["boolean"])
