"""iOS Experience - iPhone-style liquid-glass chat header for exteraGram / AyuGram.

This file is only the boot loader and the settings screen. The whole header engine lives in
res/ios_adaptive_header.dex (Java, package com.itsrin.iosexp); if the dex cannot be loaded the stock header stays untouched.
"""

import base64
import hashlib
import os
import threading
import zlib

from base_plugin import BasePlugin
from hook_utils import find_class
from java import jclass
from java.util import Locale
from ui.settings import Divider, Header, Selector, Switch

__id__ = "ios_adaptive_header"
__name__ = "iOS Experience"
__description__ = "A carefully crafted collection of iOS-inspired header designs, animations, and interface details.."
__author__ = "Rin (@itsRin)"
__version__ = "1.0.0"
__icon__ = "itsRin_icon/0"
__min_version__ = "12.10.6"
__app_version__ = ">=12.10.6"
__sdk_version__ = ">=1.4.4.3"
__category__ = ["appearance"]

_TAG = "iOSExperience"
_DEX_SHA1 = "54e0b6cd543f8998f4337988931264be4ec6a2f3"
_ENGINE = "com.itsrin.iosexp.Bridge"
_POLL_SECONDS = 0.4          # settings have no change callback: they are re-read at this interval
_LOG_EVERY = 4               # polls between two checks of the "copy log" switch


def _log(message, error=None):
    """Writes to logcat only; never raises (a plugin must not break the app)."""
    try:
        text = message if error is None else "%s: %s" % (message, error)
        jclass("android.util.Log").w(_TAG, text)
    except Exception:
        pass


def _int(value, default=0):
    try:
        return default if value is None else int(value)
    except (TypeError, ValueError):
        return default


# ---------------------------------------------------------------------------------------------------------------------
# Java engine bridge
# ---------------------------------------------------------------------------------------------------------------------
class _Engine:
    """Loads the dex once, talks to it through the string protocol of Bridge.cmd(), pushes the settings."""

    def __init__(self):
        self.bridge = None
        self.running = False
        self._last_cfg = None
        self._stop = threading.Event()
        self._thread = None

    # -- dex ----------------------------------------------------------------------------------------------------
    @staticmethod
    def _find_dex(context):
        """A .plugin is one file, so the engine dex travels inside it (_DEX_DATA) and is written next to the app files
        once. The file name carries the dex hash: an existing file is never rewritten (a loaded dex must stay read-only)."""
        try:
            folder = os.path.join(str(context.getFilesDir().getAbsolutePath()), "iosexp")
            path = os.path.join(folder, "%s-%s.dex" % (__id__, _DEX_SHA1[:10]))
            if os.path.exists(path):
                return path
            os.makedirs(folder, exist_ok=True)
            for name in os.listdir(folder):                 # dex files of older plugin versions
                if name.startswith(__id__ + "-") and name.endswith(".dex"):
                    try:
                        os.remove(os.path.join(folder, name))
                    except OSError:
                        pass
            data = zlib.decompress(base64.b64decode(_DEX_DATA))
            if hashlib.sha1(data).hexdigest() != _DEX_SHA1:
                _log("embedded dex is corrupted")
                return None
            tmp = path + ".tmp"
            with open(tmp, "wb") as f:
                f.write(data)
            os.replace(tmp, path)
            return path
        except Exception as e:
            _log("dex extract failed", e)
            return None

    def _load(self):
        context = find_class("org.telegram.messenger.ApplicationLoader").applicationContext
        path = self._find_dex(context) if context else None
        if not context or not path:
            _log("dex or context not found")
            return False
        try:                                          # Android 14+: a loaded dex must be read-only
            os.chmod(path, 0o444)
        except OSError:
            pass
        loader = jclass("dalvik.system.DexClassLoader")(
            path, context.getDir("dex_opt", 0).getAbsolutePath(), None, context.getClassLoader())
        bridge = loader.loadClass(_ENGINE)
        bridge.getMethod("init", jclass("android.content.Context"), jclass("java.lang.String")).invoke(None, context, path)
        self.bridge = bridge
        engine_version = self.cmd("version")
        if engine_version != __version__:             # a stale dex next to a newer main.py (or the other way round)
            _log("engine %s does not match plugin %s: not started" % (engine_version or "?", __version__))
            self.unload()
            return False
        return True

    # -- protocol -----------------------------------------------------------------------------------------------
    def cmd(self, text):
        if self.bridge is None:
            return ""
        try:
            result = self.bridge.getMethod("cmd", jclass("java.lang.String")).invoke(None, text)
            return "" if result is None else str(result)
        except Exception as e:
            _log("cmd failed", e)
            return ""

    # -- lifecycle ----------------------------------------------------------------------------------------------
    def start(self, plugin):
        try:
            if not self._load():
                return False
            self.push_settings(plugin)
            self.running = _int(self.cmd("engine:full")) > 0
            if self.running:
                self._stop.clear()
                self._thread = threading.Thread(target=self._poll, args=(plugin,), name="iosexp-cfg", daemon=True)
                self._thread.start()
            else:
                _log("engine installed no hooks: the stock header stays")
            return self.running
        except Exception as e:
            _log("engine start failed", e)
            return False

    def unload(self):
        self.running = False
        self._stop.set()
        bridge, self.bridge = self.bridge, None
        self._last_cfg = None
        if bridge is not None:
            try:
                bridge.getMethod("unload").invoke(None)
            except Exception as e:
                _log("engine unload failed", e)

    # -- settings -----------------------------------------------------------------------------------------------
    def push_settings(self, plugin):
        """Sends every setting the engine reads as one 'cfg:k=v;...' line (integers only), only when something changed."""
        if self.bridge is None:
            return
        values = read_settings(plugin)
        line = "cfg:" + ";".join("%s=%d" % (k, int(v)) for k, v in sorted(values.items()))
        if line != self._last_cfg:
            self._last_cfg = line
            self.cmd(line)

    def _poll(self, plugin):
        tick = 0
        while not self._stop.wait(_POLL_SECONDS):
            try:
                self.push_settings(plugin)
                tick += 1
                if tick % _LOG_EVERY == 0:
                    self._copy_log_if_asked(plugin)
            except Exception as e:
                _log("settings poll failed", e)

    def _copy_log_if_asked(self, plugin):
        if not plugin.get_setting("copy_log", False):
            return
        plugin.set_setting("copy_log", False)
        find_class("org.telegram.messenger.AndroidUtilities").addToClipboard(self.cmd("log") or "(empty log)")


def read_settings(plugin):
    """Every value the engine reads (keys are part of the Bridge protocol: do not rename)."""
    get = plugin.get_setting
    return {
        "scrolling": bool(get("scrolling_enabled", True)),
        "margin": _int(str(get("safe_margin", "12")), 12),
        "x_idx": _int(get("x_idx", 3), 3),
        "y_idx": _int(get("y_idx", 4), 4),
        "bubble": bool(get("bubble_enabled", True)),
        "adaptive": bool(get("bubble_adaptive", True)),
        "glass": bool(get("bubble_glass", True)),
        "pad_idx": _int(get("bubble_pad_v3", 2), 2),
        "gap_idx": _int(get("avatar_gap_idx", 1), 1),
        "glare": _int(get("glare_v4", 0), 0),
        "liquid": _int(get("liquid_idx", 0), 0),
        "ios_glass": bool(get("ios_liquid_glass", True)),
        "ios_str": _int(get("ios_glass_strength", 0), 0),
        "press_on": bool(get("ios_press", True)),
        "badge": bool(get("unread_badge", True)),
        "pfade": bool(get("bubble_profile_fade", True)),
        "ios_chat_enter": bool(get("ios_chat_enter", False)),
        "ios_search_bar": bool(get("ios_search_bar", True)),
        "ios_profile_open": bool(get("ios_profile_open", True)),
        "ios_selection": bool(get("ios_selection", True)),
    }


_engine = _Engine()


