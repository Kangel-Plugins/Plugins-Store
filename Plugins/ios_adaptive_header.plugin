def _texts():
    try:
        language = str(Locale.getDefault().getLanguage())
    except Exception:
        language = "en"
    texts = dict(_TEXT["en"])
    texts.update(_TEXT.get(language, {}))
    return texts


class IOSAdaptiveHeaderPlugin(BasePlugin):
    """Boots the Java engine and shows the settings screen."""

    def on_plugin_load(self):
        if not _engine.start(self):
            _log("Java engine did not start; the stock header stays")

    def on_plugin_unload(self):
        _engine.unload()

    def create_settings(self):
        t = _texts()

        def switch(key, default):
            title, subtitle = t[key]
            value = bool(self.get_setting(key, default))
            try:
                return Switch(key=key, text=title, default=value, subtext=subtitle)
            except Exception:
                return Switch(key=key, text=title, default=value)

        def selector(key, items, default=0):
            return Selector(key=key, text=t[key], items=t[items], default=_int(self.get_setting(key, default), default))

        return [
            Header(text=t["sec_look"]),
            switch("bubble_enabled", True),
            switch("ios_liquid_glass", True),
            selector("ios_glass_strength", "strength"),
            selector("glare_v4", "glare"),
            Divider(),
            Header(text=t["sec_motion"]),
            switch("ios_press", True),
            switch("ios_chat_enter", False),
            switch("ios_profile_open", True),
            Divider(),
            Header(text=t["sec_features"]),
            switch("unread_badge", True),
            switch("ios_search_bar", True),
            switch("ios_selection", True),
            Divider(),
            Header(text=t["sec_support"]),
            switch("copy_log", False),
            Divider(text=t["about"] % __version__),
        ]


