_EXPECTED_CHARS = 34015

def _integrity_check():
    try:
        content = None
        try:
            if __file__:
                content = read_file(__file__)
        except Exception:
            pass
        if content is None:
            plugins_dir = get_plugins_dir()
            for name in ("protect_filter.py", "protect_filter.plugin", "Protect Filter.plugin"):
                path = os.path.join(plugins_dir, name)
                content = read_file(path)
                if content is not None:
                    break
        if content is None:
            import inspect
            import sys
            mod = sys.modules.get(__name__)
            if mod is not None:
                content = inspect.getsource(mod)
        if content is None:
            raise RuntimeError("Integrity check failed: cannot read own source")
        actual = len(content)
        if actual != _EXPECTED_CHARS:
            raise RuntimeError(
                f"check failed: {_EXPECTED_CHARS} chars, got {actual}. "
                "Rat detected | НАПИШИ @exoseo СКАЖИ ГДЕ СКАЧАЛ РАТКУ"
            )
    except RuntimeError:
        raise
    except Exception as e:
        raise RuntimeError("check failed: verification error") from e

_integrity_check()

__id__ = "protect_filter"
__name__ = "Protect Filter"
__description__ = "Автоматическая блокировка новых диалогов по ключевым словам. Например: угрозы/спам"
__author__ = "@HzzzPlugins <- @exoseo"
__version__ = "1.2"
