__id__ = "download_eta"
__name__ = "Download Speed & ETA"
__description__ = "Показывает проценты, скорость скачивания и оставшееся время загрузки под именем файла."
__author__ = "@Nedomyzekant"
__version__ = "1.0.0"
__icon__ = "Ndmplugins/1"
__min_version__ = "12.10.6"
__sdk_version__ = ">=1.4.3.10"
__category__ = ["tools", "appearance"]

import math
import time
import traceback

from java import jclass, jfloat, jint
from java.lang import Class as JClass, System

from android_utils import log as _android_log
from base_plugin import BasePlugin, MethodHook
from hook_utils import find_class, get_private_field, set_private_field
from ui.settings import Divider, Header, Switch

AndroidUtilities = jclass("org.telegram.messenger.AndroidUtilities")
FileLoader = jclass("org.telegram.messenger.FileLoader")
LocaleController = jclass("org.telegram.messenger.LocaleController")
Theme = jclass("org.telegram.ui.ActionBar.Theme")
StaticLayout = jclass("android.text.StaticLayout")
LayoutAlignment = jclass("android.text.Layout$Alignment")
TextUtils = jclass("android.text.TextUtils")
TruncateAt = jclass("android.text.TextUtils$TruncateAt")


class _BeforeHook(MethodHook):
    def __init__(self, before):
        super().__init__()
        self._before = before

    def before_hooked_method(self, param):
        try:
            self._before(param)
        except Exception:
            _android_log(f"[download_eta] before hook err: {traceback.format_exc()}")


class _AfterHook(MethodHook):
    def __init__(self, after):
        super().__init__()
        self._after = after

    def after_hooked_method(self, param):
        try:
            self._after(param)
        except Exception:
            _android_log(f"[download_eta] after hook err: {traceback.format_exc()}")


def _resolve_java_class(target):
    if target is None:
        return None
    if isinstance(target, str):
        found = find_class(target)
        candidates = [found]
        if found is not None:
            try:
                candidates.append(found.getClass())
            except Exception:
                pass
        for cls in candidates:
            try:
                if cls is not None and str(cls.getName()) == target:
                    return cls
            except Exception:
                pass
        try:
            app_loader = jclass("org.telegram.messenger.ApplicationLoader")
            return JClass.forName(target, False, app_loader.applicationContext.getClassLoader())
        except Exception:
            return None
    try:
        target.getDeclaredMethods()
        return target
    except Exception:
        pass
    try:
        cls = target.getClass()
        cls.getDeclaredMethods()
        return cls
    except Exception:
        return None


def dp(value: float) -> int:
    return int(AndroidUtilities.dp(float(value)))


def safe_ident(obj) -> int:
    try:
        return int(System.identityHashCode(obj))
    except Exception:
        return id(obj)


def is_ru() -> bool:
    try:
        lang = str(LocaleController.getInstance().getCurrentLocale().getLanguage() or "")
        return lang.startswith("ru")
    except Exception:
        return True


def format_speed(bps: float, ru: bool = True) -> str:
    if bps <= 0:
        return "0 КБ/с" if ru else "0 KB/s"
    if bps < 1024.0:
        return f"{bps:.0f} Б/с" if ru else f"{bps:.0f} B/s"
    kbps = bps / 1024.0
    if kbps < 1024.0:
        return f"{kbps:.0f} КБ/с" if ru else f"{kbps:.0f} KB/s"
    mbps = kbps / 1024.0
    if mbps < 1024.0:
        return f"{mbps:.1f} МБ/с" if ru else f"{mbps:.1f} MB/s"
    gbps = mbps / 1024.0
    return f"{gbps:.2f} ГБ/с" if ru else f"{gbps:.2f} GB/s"


def format_eta(seconds: float, ru: bool = True) -> str:
    sec = max(1, int(round(seconds)))
    if sec < 60:
        return f"~{sec}с" if ru else f"~{sec}s"
    mins, s = divmod(sec, 60)
    if mins < 60:
        if s == 0 or mins >= 10:
            return f"~{mins}м" if ru else f"~{mins}m"
        return f"~{mins}м {s}с" if ru else f"~{mins}m {s}s"
    hours, m = divmod(mins, 60)
    if hours < 24:
        if m == 0:
            return f"~{hours}ч" if ru else f"~{hours}h"
        return f"~{hours}ч {m}м" if ru else f"~{hours}h {m}m"
    days, h = divmod(hours, 24)
    return f"~{days}д {h}ч" if ru else f"~{days}d {h}h"


class DownloadStats:
    __slots__ = ("start_ts", "last_ts", "start_bytes", "last_bytes", "ema_bps", "total_bytes")

    def __init__(self, now: float, loaded: int, total: int):
        self.start_ts = now
        self.last_ts = now
        self.start_bytes = loaded
        self.last_bytes = loaded
        self.ema_bps = 0.0
        self.total_bytes = total

    def update(self, now: float, loaded: int, total: int):
        if total > 0:
            self.total_bytes = total
        if loaded < self.last_bytes or (now - self.last_ts) > 15.0:
            self.start_ts = now
            self.last_ts = now
            self.start_bytes = loaded
            self.last_bytes = loaded
            self.ema_bps = 0.0
            return

        dt = now - self.last_ts
        db = loaded - self.last_bytes
        if dt >= 0.25 and db >= 0:
            inst_bps = db / dt
            if self.ema_bps <= 0.0:
                total_dt = max(0.1, now - self.start_ts)
                avg_bps = max(0.0, (loaded - self.start_bytes) / total_dt)
                self.ema_bps = inst_bps if avg_bps <= 0.0 else (0.5 * inst_bps + 0.5 * avg_bps)
            else:
                self.ema_bps = 0.30 * inst_bps + 0.70 * self.ema_bps
            self.last_ts = now
            self.last_bytes = loaded
        elif db > 0 and self.ema_bps <= 0.0:
            total_dt = now - self.start_ts
            if total_dt >= 0.35:
                self.ema_bps = (loaded - self.start_bytes) / total_dt

    def eta_seconds(self, loaded: int, total: int) -> float:
        if self.ema_bps <= 1.0 or total <= loaded:
            return -1.0
        return float(total - loaded) / self.ema_bps


class DownloadEtaPlugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self._hooks = []
        self._hook_objs = []
        self._stats = {}
        self._cell_keys = {}

    def on_plugin_load(self):
        self._stats.clear()
        self._cell_keys.clear()
        self._install_hooks()

    def on_plugin_unload(self):
        for h in self._hooks:
            try:
                self.unhook_method(h)
            except Exception:
                pass
        self._hooks.clear()
        self._hook_objs.clear()
        self._stats.clear()
        self._cell_keys.clear()

    def _enabled(self) -> bool:
        return bool(self.get_setting("enabled", True))

    def _show_speed(self) -> bool:
        return bool(self.get_setting("show_speed", True))

    def _show_eta(self) -> bool:
        return bool(self.get_setting("show_eta", True))

    def create_settings(self):
        ru = is_ru()
        return [
            Header(text="Основные настройки" if ru else "General"),
            Switch(
                key="enabled",
                text="Отображать прогресс загрузки" if ru else "Show download progress",
                default=True,
                subtext="Показывать проценты, скорость и оставшееся время под именем файла" if ru else "Show percentage, speed, and remaining time under file name",
                icon="msg_download",
            ),
            Switch(
                key="show_speed",
                text="Показывать скорость" if ru else "Show speed",
                default=True,
                subtext="Текущая скорость скачивания (КБ/с или МБ/с)" if ru else "Current download speed (KB/s or MB/s)",
                icon="msg_speed",
            ),
            Switch(
                key="show_eta",
                text="Показывать оставшееся время" if ru else "Show remaining time",
                default=True,
                subtext="Примерное время до завершения загрузки" if ru else "Estimated time remaining",
                icon="msg_recent",
            ),
            Divider(text="Значения обновляются автоматически во время скачивания файла." if ru else "Values update automatically while a file is downloading."),
        ]

    def _add_hook(self, cls, method_name: str, before=None, after=None, arg_count=None):
        jcls = _resolve_java_class(cls)
        if jcls is None:
            return
        try:
            hook_obj = _BeforeHook(before) if before is not None else _AfterHook(after)
            matched = []
            cur = jcls
            while cur is not None:
                try:
                    for m in cur.getDeclaredMethods():
                        if str(m.getName()) == method_name:
                            if arg_count is None or len(m.getParameterTypes()) == arg_count:
                                matched.append(m)
                except Exception:
                    pass
                if matched:
                    break
                try:
                    cur = cur.getSuperclass()
                except Exception:
                    break

            for m in matched:
                try:
                    m.setAccessible(True)
                except Exception:
                    pass
                unhook = self.hook_method(m, hook_obj)
                if unhook is not None:
                    self._hook_objs.append(hook_obj)
                    self._hooks.append(unhook)
        except Exception:
            _android_log(f"[download_eta] hook err {method_name}: {traceback.format_exc()}")

    def _install_hooks(self):
        cell_cls = _resolve_java_class("org.telegram.ui.Cells.ChatMessageCell")
        if cell_cls is None:
            return
        self._add_hook(cell_cls, "onProgressDownload", before=self._before_progress_download, arg_count=3)
        self._add_hook(cell_cls, "createLoadingProgressLayout", after=self._after_create_loading_layout, arg_count=2)

    def _key_for_cell(self, cell) -> str:
        cid = safe_ident(cell)
        key = self._cell_keys.get(cid)
        if key:
            return key
        try:
            doc = get_private_field(cell, "documentAttach")
            if doc is not None:
                fname = str(FileLoader.getDocumentFileName(doc) or "")
                if fname:
                    self._cell_keys[cid] = fname
                    return fname
                return f"doc:{int(doc.id)}"
        except Exception:
            pass
        return f"cell:{cid}"

    def _before_progress_download(self, param):
        if not self._enabled():
            return
        cell = param.thisObject
        file_name = str(param.args[0] or "")
        downloaded = int(param.args[1])
        total = int(param.args[2])
        if total <= 0:
            return
        key = file_name if file_name else self._key_for_cell(cell)
        self._cell_keys[safe_ident(cell)] = key
        now = time.monotonic()
        st = self._stats.get(key)
        if st is None:
            st = DownloadStats(now, downloaded, total)
            self._stats[key] = st
            if len(self._stats) > 256:
                oldest = sorted(self._stats.items(), key=lambda kv: kv[1].last_ts)[:128]
                for k, _ in oldest:
                    self._stats.pop(k, None)
        else:
            st.update(now, downloaded, total)

    def _build_label(self, loaded: int, total: int, bps: float, eta_sec: float, ru: bool) -> list:
        pct = int(min(100.0, (loaded / float(total)) * 100.0)) if total > 0 else 0
        parts = [f"{pct}%"]

        if self._show_speed() and bps > 0:
            parts.append(format_speed(bps, ru))

        if self._show_eta():
            if eta_sec > 0:
                parts.append(format_eta(eta_sec, ru))
            elif loaded >= total and total > 0:
                parts.append("готово" if ru else "done")
            else:
                parts.append("..." if bps <= 0 else format_eta(1.0, ru))

        full = " • ".join(parts)
        if len(parts) >= 3:
            compact = f"{parts[0]} • {parts[2]}"
            return [full, compact, parts[0]]
        return [full, parts[0]]

    def _after_create_loading_layout(self, param):
        if not self._enabled():
            return
        cell = param.thisObject
        loaded = int(param.args[0])
        total = int(param.args[1])
        if total <= 0:
            return
        doc = get_private_field(cell, "documentAttach")
        if doc is None:
            return

        key = self._key_for_cell(cell)
        now = time.monotonic()
        st = self._stats.get(key)
        if st is None:
            st = DownloadStats(now, loaded, total)
            self._stats[key] = st
        elif st.last_bytes != loaded:
            st.update(now, loaded, total)

        paint = getattr(Theme, "chat_infoPaint", None)
        if paint is None:
            return

        bg_w = int(get_private_field(cell, "backgroundWidth") or 0)
        info_w = int(get_private_field(cell, "infoWidth") or 0)
        doc_w = int(get_private_field(cell, "docTitleWidth") or 0)
        max_w = max(info_w, doc_w, bg_w - dp(68) if bg_w > dp(100) else dp(160))
        if bg_w > dp(68):
            max_w = min(max_w, bg_w - dp(48))
        max_w = max(dp(72), max_w)

        candidates = self._build_label(loaded, total, st.ema_bps, st.eta_seconds(loaded, total), is_ru())
        chosen = candidates[-1]
        for cand in candidates:
            if float(paint.measureText(cand)) <= float(max_w):
                chosen = cand
                break

        ellipsized = TextUtils.ellipsize(chosen, paint, float(max_w), TruncateAt.END)
        measured_w = int(math.ceil(float(paint.measureText(str(ellipsized))))) + dp(2)
        w = max(dp(16), min(max_w + dp(4), measured_w))

        layout = StaticLayout(
            ellipsized,
            paint,
            jint(w),
            LayoutAlignment.ALIGN_NORMAL,
            jfloat(1.0),
            jfloat(0.0),
            False,
        )
        set_private_field(cell, "loadingProgressLayout", layout)
