def is_ru():
    try:
        info = jclass("org.telegram.messenger.LocaleController").getInstance().getCurrentLocaleInfo()
        for name in ("shortName", "pluralLangCode", "langCode"):
            value = getattr(info, name, None)
            if value:
                return str(value).lower().split("_")[0].split("-")[0] == "ru"
    except Exception:
        pass
    try:
        return str(jclass("java.util.Locale").getDefault().getLanguage()) == "ru"
    except Exception:
        return False


def tr(ru, en):
    return ru if is_ru() else en


