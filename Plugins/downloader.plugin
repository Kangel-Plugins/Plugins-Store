class DownloadError(Exception):
    def __init__(self, code, detail=""):
        self.code, self.detail = code, safe_detail(detail)
        super().__init__(code)


class Cancelled(DownloadError):
    def __init__(self):
        super().__init__("cancelled")


def safe_detail(value):
    text = re.sub(r"\x1b\[[0-9;]*m", "", str(value))
    text = re.sub(r"https?://\S+", "[URL]", text)
    text = re.sub(
        r"(?i)(authorization|cookie|api[-_ ]?key|token|password)\s*[:=]\s*\S+",
        r"\1: ***",
        text,
    )
    return re.sub(r"[\x00-\x08\x0b-\x1f]", "", text).strip()[:260]


def normalize_url(value):
    value = str(value or "").strip()
    try:
        p = urllib.parse.urlsplit(value)
        if (
            len(value) > 8192
            or re.search(r"[\s\x00-\x1f\x7f]", value)
            or p.scheme.lower() not in ("http", "https")
            or not p.hostname
            or p.username is not None
            or p.password is not None
        ):
            raise ValueError()
        p.port
        return urllib.parse.urlunsplit(
            (p.scheme.lower(), p.netloc, p.path or "/", p.query, "")
        )
    except (ValueError, UnicodeError):
        raise DownloadError("invalid_url")


def service_for(url):
    host = (urllib.parse.urlsplit(url).hostname or "").lower().rstrip(".")
    return next(
        (
            key
            for key, _, domains in SERVICES
            if any(host == d or host.endswith("." + d) for d in domains)
        ),
        None,
    )


def youtube_id(url):
    p = urllib.parse.urlsplit(url)
    value = (
        urllib.parse.parse_qs(p.query).get("v", [""])[0]
        or p.path.strip("/").split("/")[-1]
    )
    if service_for(url) != "youtube" or not re.fullmatch(r"[A-Za-z0-9_-]{11}", value):
        raise DownloadError("unsupported")
    return value


def option(items, index, default):
    return (
        items[index]
        if isinstance(index, int)
        and not isinstance(index, bool)
        and 0 <= index < len(items)
        else default
    )


def proxy_url(settings):
    kind = settings.get("proxy_type_set", 0)
    if kind == 0:
        return ""
    if kind == 4:
        raise DownloadError("mtproto")
    scheme = {1: "http", 2: "https", 3: "socks5h"}.get(kind)
    raw = str(settings.get("proxy_url_set", "") or "").strip()
    try:
        p = urllib.parse.urlsplit(raw if "://" in raw else str(scheme) + "://" + raw)
        if (
            not scheme
            or not p.hostname
            or not p.port
            or p.path not in ("", "/")
            or p.query
            or p.fragment
        ):
            raise ValueError()
        host = "[" + p.hostname + "]" if ":" in p.hostname else p.hostname
        user = str(
            settings.get("proxy_username_set", "") or ""
        ) or urllib.parse.unquote(p.username or "")
        password = str(
            settings.get("proxy_password_set", "") or ""
        ) or urllib.parse.unquote(p.password or "")
        auth = (
            urllib.parse.quote(user, safe="")
            + ":"
            + urllib.parse.quote(password, safe="")
            + "@"
            if user or password
            else ""
        )
        return scheme + "://" + auth + host + ":" + str(p.port)
    except (ValueError, UnicodeError):
        raise DownloadError("proxy")


def format_bytes(value):
    size = max(0, int(value or 0))
    for unit in ("B", "KB", "MB", "GB"):
        if size < 1024 or unit == "GB":
            return ("%.1f" % size if unit != "B" else str(size)) + " " + unit
        size /= 1024


@dataclass
class Target:
    account: int
    user_id: int
    peer: int
    reply: object = None
    top: object = None
    notify: bool = True
    schedule: int = 0
    repeat: int = 0
    story: object = None
    quote: object = None
    send_args: object = None
    effect: int = 0
    invert: bool = False
    stars: int = 0
    mono_peer: int = 0
    suggestion: object = None


@dataclass
class Media:
    path: str
    kind: str


@dataclass
class DownloadJob:
    url: str
    mode: str
    target: Target
    settings: dict
    limit: int
    epoch: int
    id: str = field(default_factory=lambda: uuid.uuid4().hex)
    state: str = "queued"
    backend: str = ""
    title: str = ""
    current: int = 0
    total: int = 0
    item: int = 1
    items: int = 1
    speed: float = 0.0
    error: object = None
    directory: str = ""
    hidden: bool = False
    send_started: bool = False
    staged: list = field(default_factory=list)
    handed_off: set = field(default_factory=set)
    sent_chunks: int = 0
    auth_only: bool = False
    auth_code: str = ""
    auth_url: str = ""
    cancel_event: object = field(default_factory=threading.Event)
    lock: object = field(default_factory=threading.RLock)
    resources: set = field(default_factory=set)

    def check(self):
        if self.cancel_event.is_set():
            raise Cancelled()

    def cancel(self):
        with self.lock:
            if self.send_started or self.state in ("done", "failed", "cancelled"):
                return False
            self.cancel_event.set()
        threading.Thread(target=self.close_resources, daemon=True).start()
        return True

    def close_resources(self):
        with self.lock:
            resources = list(self.resources)
        for resource in resources:
            try:
                resource.close()
            except Exception:
                pass


def _ytdlp_percent_pattern(pattern):
    wrappers, seen = [], set()
    while (
        type(pattern).__name__ == "Urllib3PercentREOverride"
        and type(pattern).__module__ == "yt_dlp.networking._requests"
    ):
        if id(pattern) in seen or len(seen) >= 128:
            return None, []
        seen.add(id(pattern))
        wrappers.append(type(pattern))
        try:
            pattern = object.__getattribute__(pattern, "re")
        except AttributeError:
            return None, []
    return (pattern, wrappers) if isinstance(pattern, re.Pattern) else (None, [])


def _ytdlp_percent_sub(self, repl, string, count=0):
    pattern, _ = _ytdlp_percent_pattern(self)
    if pattern is None:
        raise DownloadError("http_dependency")
    return pattern.sub(repl, string, count=count)


def repair_ytdlp_http_compatibility():
    # Shared SDK imports can leave old or nested yt-dlp percent wrappers.
    # Add only the missing regex method; retain subn's signed-path behavior
    # and urllib3's host validation, sessions, proxies and certificate checks.
    from urllib3.util import url

    current = getattr(url, "_PERCENT_RE", None)
    if callable(getattr(current, "sub", None)):
        return False
    pattern, wrappers = _ytdlp_percent_pattern(current)
    if pattern is None:
        return False
    for wrapper in wrappers:
        if not callable(getattr(wrapper, "sub", None)):
            wrapper.sub = _ytdlp_percent_sub
    return bool(wrappers)


class HttpClient:
    def __init__(self, job):
        self.job = job
        self.session = requests.Session()
        self.session.trust_env = False
        self.session.headers.update(
            {"User-Agent": USER_AGENT, "Accept-Encoding": "identity"}
        )
        proxy = proxy_url(job.settings)
        if proxy:
            self.session.proxies.update({"http": proxy, "https": proxy})

    def close(self):
        self.session.close()

    def request(self, method, url, headers=None, api=False, **kwargs):
        repair_ytdlp_http_compatibility()
        url, headers = normalize_url(url), dict(headers or {})
        for _ in range(6):
            self.job.check()
            try:
                response = self.session.request(
                    method,
                    url,
                    headers=headers,
                    timeout=(8, 12),
                    stream=True,
                    allow_redirects=False,
                    **kwargs,
                )
            except requests.Timeout:
                raise DownloadError("timeout")
            except requests.RequestException:
                self.job.check()
                raise DownloadError("network")
            if response.status_code not in (301, 302, 303, 307, 308):
                with self.job.lock:
                    self.job.resources.add(response)
                return response
            location = response.headers.get("Location", "")
            response.close()
            if api:
                raise DownloadError("api_redirect")
            next_url = normalize_url(urllib.parse.urljoin(url, location))
            previous, following = (
                urllib.parse.urlsplit(url),
                urllib.parse.urlsplit(next_url),
            )
            if previous.scheme == "https" and following.scheme != "https":
                raise DownloadError("network")
            if (previous.scheme, previous.netloc) != (
                following.scheme,
                following.netloc,
            ):
                headers = {
                    k: v
                    for k, v in headers.items()
                    if k.lower()
                    not in ("authorization", "cookie", "proxy-authorization")
                }
            url = next_url
        raise DownloadError("network")

    def release(self, response):
        with self.job.lock:
            self.job.resources.discard(response)
        response.close()

    @staticmethod
    def status(response, data=None):
        if response.status_code >= 400:
            code = "http_" + str(response.status_code)
            error = data.get("error") if isinstance(data, dict) else None
            raise DownloadError(
                code if code in ("http_403", "http_429") else "http",
                error.get("code", "") if isinstance(error, dict) else "",
            )

    def json(self, method, url, headers=None, **kwargs):
        response = self.request(method, url, headers, api=True, **kwargs)
        try:
            raw = bytearray()
            for chunk in response.iter_content(65536):
                self.job.check()
                if len(raw) + len(chunk) > JSON_LIMIT:
                    raise DownloadError("api_json")
                raw.extend(chunk)
            try:
                data = json.loads(raw.decode("utf-8-sig"))
            except (ValueError, UnicodeError):
                self.status(response)
                raise DownloadError("api_json")
            self.status(response, data)
            return data
        finally:
            self.release(response)


def media_signature(first, content_type="", hint=""):
    first = bytes(first)
    mime = (content_type or "").split(";", 1)[0].lower().strip()
    text = first.lstrip().lower()
    if (
        not first
        or text.startswith((b"<!doctype", b"<html", b"<head", b"{", b"[", b"<?xml"))
        or mime in ("text/html", "application/json", "application/xhtml+xml")
    ):
        raise DownloadError("not_media")
    if (
        text.startswith(b"#extm3u")
        or "mpegurl" in mime
        or mime == "application/dash+xml"
    ):
        raise DownloadError("processing")
    for signature, ext, kind in (
        (b"\xff\xd8\xff", "jpg", "photo"),
        (b"\x89PNG\r\n\x1a\n", "png", "photo"),
        (b"GIF87a", "gif", "gif"),
        (b"GIF89a", "gif", "gif"),
        (b"OggS", "ogg", "audio"),
        (b"fLaC", "flac", "audio"),
        (b"ID3", "mp3", "audio"),
    ):
        if first.startswith(signature):
            return ext, kind
    if first.startswith(b"RIFF") and first[8:12] in (b"WEBP", b"WAVE"):
        return ("webp", "photo") if first[8:12] == b"WEBP" else ("wav", "audio")
    if len(first) >= 12 and first[4:8] == b"ftyp":
        if first[8:12] in (b"avif", b"avis"):
            return "avif", "photo"
        if first[8:12] in (b"heic", b"heix", b"hevc", b"hevx", b"mif1", b"msf1"):
            return "heic", "photo"
        if first[8:12] == b"qt  ":
            return "mov", "video"
        return (
            ("m4a", "audio")
            if mime.startswith("audio/")
            or hint == "audio"
            or first[8:12] in (b"M4A ", b"M4B ")
            else ("mp4", "video")
        )
    if first.startswith(b"\x1aE\xdf\xa3"):
        ext = "mkv" if b"matroska" in first[:1024] else "webm"
        kind = "audio" if hint == "audio" or mime.startswith("audio/") else "video"
        return ext, kind
    if len(first) >= 2 and first[0] == 255 and first[1] & 246 == 240:
        return "aac", "audio"
    if len(first) >= 2 and first[0] == 255 and first[1] & 224 == 224:
        return "mp3", "audio"
    if first[0] == 0x47 and (len(first) < 189 or first[188] == 0x47):
        return "ts", "video"
    raise DownloadError("not_media")


def ensure_space(directory, needed=0):
    if shutil.disk_usage(directory).free < max(0, needed) + RESERVE_BYTES:
        raise DownloadError("disk_full")


def fetch_media(job, http, url, progress, hint="", headers=None):
    response = http.request("GET", url, headers)
    path, stream = "", None
    try:
        http.status(response)
        try:
            total = max(0, int(response.headers.get("Content-Length", "0")))
        except ValueError:
            total = 0
        if total > job.limit:
            raise DownloadError("too_large")
        ensure_space(job.directory, total)
        current, began, kind = 0, time.monotonic(), ""
        for chunk in response.iter_content(65536):
            job.check()
            if not chunk:
                continue
            if not path:
                ext, kind = media_signature(
                    chunk, response.headers.get("Content-Type", ""), hint
                )
                path = os.path.join(job.directory, uuid.uuid4().hex + "." + ext)
                stream = open(path + ".part", "xb")
            current += len(chunk)
            if current > job.limit:
                raise DownloadError("too_large")
            if current % (4 * 1024 * 1024) < len(chunk):
                ensure_space(job.directory)
            stream.write(chunk)
            progress(
                job,
                state="downloading",
                current=current,
                total=total,
                speed=current / max(0.01, time.monotonic() - began),
            )
        if not path:
            raise DownloadError("empty")
        stream.close()
        if (
            total
            and current != total
            and response.headers.get("Content-Encoding", "identity").lower()
            in ("", "identity")
        ):
            raise DownloadError("truncated")
        job.check()
        os.replace(path + ".part", path)
        return Media(path, kind)
    except requests.Timeout:
        job.check()
        raise DownloadError("timeout")
    except requests.RequestException:
        job.check()
        raise DownloadError("network")
    finally:
        if stream:
            stream.close()
        if path and os.path.exists(path + ".part"):
            os.remove(path + ".part")
        http.release(response)


def backend_plan(job):
    selected = option(BACKENDS, job.settings.get("backend_set", 0), "auto")
    if service_for(job.url) == "yandex_music" and selected in (
        "auto",
        "local",
        "yandex",
    ):
        return ["yandex"]
    if selected != "auto":
        return [selected]
    plan = ["local"]
    if (
        os.path.splitext(urllib.parse.urlsplit(job.url).path)[1].lower().lstrip(".")
        in MEDIA_EXTS
    ):
        plan.insert(0, "direct")
    if job.settings.get("auto_fallback_set", True):
        if service_for(job.url) == "tiktok" and job.settings.get(
            "tikwm_fallback_set", True
        ):
            plan.append("tikwm")
        if job.settings.get("cobalt_url_set", ""):
            plan.append("cobalt")
        if service_for(job.url) == "youtube":
            plan.extend(
                x
                for x in ("invidious", "piped")
                if job.settings.get(x + "_url_set", "")
            )
    return plan


def choose_formats(formats, mode, quality):
    normalized = []
    for f in formats:
        if (
            not isinstance(f, dict)
            or not f.get("url")
            or f.get("has_drm")
            or f.get("is_drm")
        ):
            continue
        f = dict(f)
        if f.get("vcodec") is None:
            f["vcodec"] = (
                "none"
                if f.get("ext") in ("m4a", "mp3", "ogg", "opus", "wav", "flac", "aac")
                else "unknown"
            )
        if f.get("acodec") is None:
            f["acodec"] = "unknown"
        normalized.append(f)
    formats = normalized
    ceiling = int(quality) if str(quality).isdigit() else 100000
    videos = [
        f
        for f in formats
        if f.get("vcodec") not in (None, "none") and (f.get("height") or 0) <= ceiling
    ]
    key = lambda f: (
        f.get("height") or 0,
        f.get("tbr") or f.get("abr") or 0,
        f.get("width") or 0,
    )
    audios = [
        f
        for f in formats
        if f.get("acodec") not in (None, "none") and f.get("vcodec") == "none"
    ]
    combined = [f for f in videos if f.get("acodec") not in (None, "none")]
    audio_only_source = not any(f.get("vcodec") != "none" for f in formats)
    if mode == "audio" or (mode == "auto" and audio_only_source and audios):
        if audios:
            return [
                max(
                    audios,
                    key=lambda f: (
                        f.get("abr") or f.get("tbr") or 0,
                        f.get("asr") or 0,
                    ),
                )
            ]
        if combined:
            return [max(combined, key=key)]
    else:
        avc = [
            f
            for f in videos
            if f.get("acodec") == "none"
            and f.get("ext") in ("mp4", "m4v")
            and str(f.get("vcodec", "")).startswith(("avc1", "h264"))
        ]
        aac = [
            f
            for f in audios
            if f.get("ext") in ("m4a", "mp4")
            and str(f.get("acodec", "")).startswith(("mp4a", "aac"))
        ]
        best = max(combined, key=key) if combined else None
        if avc and aac:
            video = max(avc, key=key)
            if best is None or key(video) > key(best):
                return [
                    video,
                    max(aac, key=lambda f: f.get("abr") or f.get("tbr") or 0),
                ]
        if best:
            return [best]
        # Animations and intentionally silent source videos have no audio track.
        if videos and not audios:
            return [max(videos, key=key)]
    raise DownloadError("no_format")


class DownloadEngine:
    def __init__(
        self,
        progress,
        mux,
        js_runtime=None,
        logger=None,
        register_js=None,
        yandex_authorize=None,
    ):
        self.progress, self.mux, self.js_runtime = progress, mux, js_runtime
        self.logger, self.register_js = logger or (lambda _: None), register_js
        self.yandex_authorize = yandex_authorize

    def run(self, job):
        http = HttpClient(job)
        last_error = DownloadError("unsupported")
        try:
            for backend in backend_plan(job):
                job.check()
                self.progress(
                    job,
                    backend=backend,
                    state="resolving",
                    current=0,
                    total=0,
                    speed=0,
                    item=1,
                    items=1,
                    title="",
                )
                try:
                    media = getattr(self, backend)(job, http)
                    job.check()
                    if not media:
                        raise DownloadError("empty")
                    for item in media:
                        size = os.path.getsize(item.path)
                        if not size or size > job.limit:
                            raise DownloadError("empty" if not size else "too_large")
                    return media
                except Cancelled:
                    raise
                except Exception as error:
                    job.check()
                    last_error = (
                        error
                        if isinstance(error, DownloadError)
                        else DownloadError(
                            "disk_full"
                            if isinstance(error, OSError) and error.errno == 28
                            else "unknown",
                            type(error).__name__ + ": " + str(error),
                        )
                    )
                    self.logger("[downloader] " + backend + ": " + last_error.code)
                    if last_error.code in (
                        "disk_full",
                        "too_large",
                        "mtproto",
                        "proxy",
                    ):
                        raise last_error
                    for name in os.listdir(job.directory):
                        path = os.path.join(job.directory, name)
                        if os.path.isfile(path):
                            os.remove(path)
            raise last_error
        finally:
            http.close()

    def direct(self, job, http):
        media = fetch_media(job, http, job.url, self.progress)
        if job.mode == "audio" and media.kind == "video" or media.path.endswith(".ts"):
            return [
                self.mux(job, [media.path], "audio" if job.mode == "audio" else "video")
            ]
        return [media]

    def yandex(self, job, http):
        if self.yandex_authorize is None:
            raise DownloadError("music_login")
        return yandex_download(job, http, self.progress, self.yandex_authorize)

    def cobalt(self, job, http):
        base = str(job.settings.get("cobalt_url_set", "") or "").strip()
        if not base:
            raise DownloadError("api_config")
        headers = {"Accept": "application/json", "Content-Type": "application/json"}
        key = str(job.settings.get("api_key_set", "") or "").strip()
        if key:
            headers["Authorization"] = "Api-Key " + key
        payload = {
            "url": job.url,
            "downloadMode": "audio" if job.mode == "audio" else "auto",
            "videoQuality": option(
                QUALITY, job.settings.get("video_quality_set", 5), "1080"
            ),
            "audioBitrate": option(
                BITRATE, job.settings.get("audio_bitrate_set", 5), "320"
            ),
            "audioFormat": "mp3" if job.mode == "audio" else "best",
            "filenameStyle": "basic",
            "localProcessing": "disabled",
            "convertGif": False,
        }
        data = http.json(
            "POST", normalize_url(base).rstrip("/") + "/", headers, json=payload
        )
        if not isinstance(data, dict):
            raise DownloadError("api_json")
        status = data.get("status")
        if status == "error":
            error = data.get("error")
            raise DownloadError(
                "api_error", error.get("code", "") if isinstance(error, dict) else ""
            )
        if status in ("redirect", "tunnel"):
            return [
                fetch_media(
                    job,
                    http,
                    data.get("url"),
                    self.progress,
                    "audio" if job.mode == "audio" else "",
                )
            ]
        if status == "picker":
            entries = data.get("picker")
            if not isinstance(entries, list) or not entries:
                raise DownloadError("api_json")
            if len(entries) > MAX_ITEMS:
                raise DownloadError("too_many")
            if job.mode == "audio":
                if not data.get("audio"):
                    raise DownloadError("unsupported")
                return [fetch_media(job, http, data["audio"], self.progress, "audio")]
            output = []
            for i, entry in enumerate(entries):
                if not isinstance(entry, dict):
                    raise DownloadError("api_json")
                self.progress(job, item=i + 1, items=len(entries))
                output.append(
                    fetch_media(
                        job,
                        http,
                        entry.get("url"),
                        self.progress,
                        entry.get("type", ""),
                    )
                )
            if data.get("audio") and job.settings.get("album_audio_set", False):
                output.append(
                    fetch_media(job, http, data["audio"], self.progress, "audio")
                )
            return output
        if status == "local-processing":
            tunnels, processing, audio = (
                data.get("tunnel"),
                data.get("type"),
                data.get("audio") or {},
            )
            if (
                not isinstance(tunnels, list)
                or not tunnels
                or len(tunnels) > 2
                or data.get("isHLS")
                or (data.get("output") or {}).get("subtitles")
            ):
                raise DownloadError("processing")
            if (
                processing not in ("merge", "remux", "mute", "audio")
                or processing == "audio"
                and not audio.get("copy", True)
            ):
                raise DownloadError("processing")
            parts = [fetch_media(job, http, url, self.progress) for url in tunnels]
            return [
                self.mux(
                    job,
                    [p.path for p in parts],
                    "audio"
                    if processing == "audio"
                    else "mute"
                    if processing == "mute"
                    else "video",
                )
            ]
        raise DownloadError("api_json")

    def tikwm(self, job, http):
        if service_for(job.url) != "tiktok":
            raise DownloadError("unsupported")
        response = http.json(
            "POST", "https://www.tikwm.com/api/", data={"url": job.url, "hd": "1"}
        )
        if (
            not isinstance(response, dict)
            or response.get("code") != 0
            or not isinstance(response.get("data"), dict)
        ):
            raise DownloadError("api_error")
        data = response["data"]
        self.progress(job, title=str(data.get("title", ""))[:100])
        if job.mode == "audio":
            return [fetch_media(job, http, data.get("music"), self.progress, "audio")]
        images = data.get("images")
        if images:
            if not isinstance(images, list) or len(images) > MAX_ITEMS:
                raise DownloadError("too_many")
            result = []
            for i, image in enumerate(images):
                self.progress(job, item=i + 1, items=len(images))
                result.append(fetch_media(job, http, image, self.progress, "photo"))
            if data.get("music") and job.settings.get("album_audio_set", False):
                result.append(
                    fetch_media(job, http, data["music"], self.progress, "audio")
                )
            return result
        return [
            fetch_media(
                job,
                http,
                urllib.parse.urljoin(
                    "https://www.tikwm.com/",
                    data.get("hdplay") or data.get("play") or "",
                ),
                self.progress,
            )
        ]

    def invidious(self, job, http):
        base = job.settings.get("invidious_url_set", "")
        if not base:
            raise DownloadError("api_config")
        data = http.json(
            "GET",
            normalize_url(base).rstrip("/") + "/api/v1/videos/" + youtube_id(job.url),
        )
        if not isinstance(data, dict) or data.get("error"):
            raise DownloadError("api_error")
        if data.get("liveNow"):
            raise DownloadError("live")
        formats = []
        for source in data.get("formatStreams", []) + data.get("adaptiveFormats", []):
            if not isinstance(source, dict):
                continue
            mime = str(source.get("type", ""))
            match = re.search(r"(\d+)", str(source.get("resolution", "")))
            audio, combined = (
                mime.startswith("audio/"),
                source in data.get("formatStreams", []),
            )
            formats.append(
                dict(
                    source,
                    ext="m4a"
                    if audio and "mp4" in mime
                    else "mp4"
                    if "mp4" in mime
                    else "webm",
                    height=int(match.group(1)) if match and not audio else 0,
                    vcodec="none" if audio else "avc1" if "avc1" in mime else "vp9",
                    acodec="mp4a"
                    if audio and "mp4" in mime or combined
                    else "opus"
                    if audio
                    else "none",
                    abr=_number(source.get("bitrate")),
                )
            )
        return self._api_formats(job, http, formats)

    def piped(self, job, http):
        base = job.settings.get("piped_url_set", "")
        if not base:
            raise DownloadError("api_config")
        data = http.json(
            "GET", normalize_url(base).rstrip("/") + "/streams/" + youtube_id(job.url)
        )
        if not isinstance(data, dict) or data.get("error"):
            raise DownloadError("api_error")
        if data.get("livestream"):
            raise DownloadError("live")
        formats = []
        for source in data.get("videoStreams", []) + data.get("audioStreams", []):
            if not isinstance(source, dict):
                continue
            audio, mime = (
                source in data.get("audioStreams", []),
                str(source.get("mimeType", "")),
            )
            match = re.search(r"(\d+)", str(source.get("quality", "")))
            formats.append(
                dict(
                    source,
                    ext="m4a"
                    if audio and "mp4" in mime
                    else "mp4"
                    if "mp4" in mime
                    else "webm",
                    height=_number(source.get("height"))
                    or (int(match.group(1)) if match and not audio else 0),
                    vcodec="none"
                    if audio
                    else "avc1"
                    if "avc" in str(source.get("codec", ""))
                    else "vp9",
                    acodec="mp4a"
                    if audio
                    and "mp4" in mime
                    or not audio
                    and not source.get("videoOnly", True)
                    else "opus"
                    if audio
                    else "none",
                    abr=_number(source.get("bitrate")),
                )
            )
        return self._api_formats(job, http, formats)

    def _api_formats(self, job, http, formats):
        selected = choose_formats(
            formats,
            job.mode,
            option(QUALITY, job.settings.get("video_quality_set", 5), "1080"),
        )
        parts = [
            fetch_media(
                job,
                http,
                f["url"],
                self.progress,
                "audio" if f.get("vcodec") == "none" else "video",
            )
            for f in selected
        ]
        if (
            len(parts) > 1
            or job.mode == "audio"
            and parts[0].kind == "video"
            or parts[0].path.endswith(".ts")
        ):
            return [
                self.mux(
                    job,
                    [p.path for p in parts],
                    "audio" if job.mode == "audio" else "video",
                )
            ]
        return parts

    def local(self, job, http):
        try:
            import yt_dlp
        except ImportError:
            raise DownloadError("dependency")
        repair_ytdlp_http_compatibility()
        if self.js_runtime and self.register_js:
            self.register_js()
        logger = _YtdlpLogger(job)
        options = {
            "quiet": True,
            "no_warnings": True,
            "logger": logger,
            "noprogress": True,
            "noplaylist": True,
            "playlistend": MAX_ITEMS + 1,
            "lazy_playlist": True,
            "format": "best/bestvideo/bestaudio",
            "fixup": "never",
            "postprocessors": [],
            "socket_timeout": 12,
            "retries": 1,
            "extractor_retries": 1,
            "fragment_retries": 1,
            "skip_unavailable_fragments": False,
            "concurrent_fragment_downloads": 1,
            "cachedir": False,
            "overwrites": True,
            "continuedl": False,
            "max_filesize": job.limit,
            "hls_prefer_native": True,
            "js_runtimes": {},
            "remote_components": [],
            "proxy": proxy_url(job.settings),
            "progress_hooks": [lambda data: self._ytdlp_progress(job, data)],
            "_media_downloader_js": (lambda code: self.js_runtime(job, code))
            if self.js_runtime
            else None,
            "outtmpl": os.path.join(job.directory, "extract.%(ext)s"),
        }
        try:
            with yt_dlp.YoutubeDL(options) as ydl:
                info = ydl.extract_info(job.url, download=False)
                job.check()
                entries = []
                if isinstance(info, dict) and info.get("entries") is not None:
                    for entry in info["entries"]:
                        job.check()
                        if not isinstance(entry, dict):
                            raise DownloadError("extract")
                        entries.append(entry)
                        if len(entries) > MAX_ITEMS:
                            raise DownloadError("too_many")
                elif isinstance(info, dict):
                    entries = [info]
                if not entries:
                    raise DownloadError("extract")
                result = []
                for i, entry in enumerate(entries):
                    if entry.get("is_live") or entry.get("live_status") in (
                        "is_live",
                        "is_upcoming",
                    ):
                        raise DownloadError("live")
                    if entry.get("has_drm"):
                        raise DownloadError("unsupported")
                    self.progress(
                        job,
                        title=str(entry.get("title", ""))[:100],
                        item=i + 1,
                        items=len(entries),
                    )
                    selected = choose_formats(
                        entry.get("formats") or [entry],
                        job.mode,
                        option(
                            QUALITY, job.settings.get("video_quality_set", 5), "1080"
                        ),
                    )
                    parts = []
                    for n, fmt in enumerate(selected):
                        job.check()
                        declared = fmt.get("filesize") or 0
                        if declared > job.limit:
                            raise DownloadError("too_large")
                        ensure_space(job.directory, declared)
                        ext = str(fmt.get("ext", "mp4"))
                        if ext not in MEDIA_EXTS:
                            raise DownloadError("processing")
                        destination = os.path.join(
                            job.directory, "local_%d_%d.%s" % (i, n, ext)
                        )
                        download_info = dict(entry, **fmt)
                        for key in (
                            "requested_formats",
                            "requested_downloads",
                            "entries",
                            "__postprocessors",
                        ):
                            download_info.pop(key, None)
                        download_info["_filename"] = destination
                        ydl.params["outtmpl"] = {"default": destination}
                        ydl.process_info(download_info)
                        job.check()
                        if not os.path.isfile(destination):
                            raise DownloadError("empty")
                        if os.path.getsize(destination) > job.limit:
                            raise DownloadError("too_large")
                        with open(destination, "rb") as stream:
                            actual_ext, kind = media_signature(
                                stream.read(4096),
                                hint="audio" if fmt.get("vcodec") == "none" else "",
                            )
                        if actual_ext != ext:
                            renamed = (
                                os.path.splitext(destination)[0] + "." + actual_ext
                            )
                            os.replace(destination, renamed)
                            destination = renamed
                        parts.append(Media(destination, kind))
                    if (
                        len(parts) > 1
                        or job.mode == "audio"
                        and parts[0].kind == "video"
                        or parts[0].path.endswith(".ts")
                    ):
                        parts = [
                            self.mux(
                                job,
                                [p.path for p in parts],
                                "audio" if job.mode == "audio" else "video",
                            )
                        ]
                    result.extend(parts)
                return result
        except DownloadError:
            raise
        except Exception:
            job.check()
            raise DownloadError("extract", logger.last_error)

    def _ytdlp_progress(self, job, data):
        job.check()
        downloaded = int(data.get("downloaded_bytes") or 0)
        if downloaded > job.limit:
            raise DownloadError("too_large")
        ensure_space(job.directory)
        self.progress(
            job,
            state="downloading",
            current=downloaded,
            total=int(data.get("total_bytes") or data.get("total_bytes_estimate") or 0),
            speed=float(data.get("speed") or 0),
        )


def _number(value):
    try:
        return max(0, float(value or 0))
    except (ValueError, TypeError):
        return 0


class _YtdlpLogger:
    def __init__(self, job):
        self.job, self.last_error = job, ""

    def debug(self, message):
        self.job.check()

    def warning(self, message):
        self.job.check()

    def error(self, message):
        self.job.check()
        self.last_error = safe_detail(message)


"""Yandex Music transport and private credential storage; joined into the plugin."""

import base64
import hashlib
import inspect
import xml.etree.ElementTree as ET

YANDEX_API = "https://api.music.yandex.net"
YANDEX_DEVICE_URL = "https://oauth.yandex.ru/device"
MUSIC_BITRATES = (128, 192, 320)


def music_token(value):
    if (
        not isinstance(value, str)
        or not 16 <= len(value) <= 4096
        or re.search(r"\s", value)
    ):
        raise DownloadError("music_login")
    return value


def music_json(http, method, url, headers=None, **kwargs):
    response = http.request(method, url, headers=headers, api=True, **kwargs)
    try:
        raw = bytearray()
        for chunk in response.iter_content(65536):
            http.job.check()
            if len(raw) + len(chunk) > JSON_LIMIT:
                raise DownloadError("api_json")
            raw.extend(chunk)
        try:
            data = json.loads(raw.decode("utf-8-sig"))
        except (ValueError, UnicodeError):
            raise DownloadError("api_json")
        return response.status_code, data
    finally:
        http.release(response)


class MusicSlowDown(Exception):
    pass


class YandexOAuthTransport:
    def __init__(self, http):
        self.http = http

    def set_and_return_client(self, client):
        return client

    def set_language(self, language):
        pass

    def post(self, url, data, **kwargs):
        if url not in (
            "https://oauth.yandex.ru/device/code",
            "https://oauth.yandex.ru/token",
        ):
            raise DownloadError("music_auth")
        status, body = music_json(self.http, "POST", url, data=data)
        if not isinstance(body, dict):
            raise DownloadError("music_auth")
        error = body.get("error")
        if error == "authorization_pending":
            from yandex_music.exceptions import BadRequestError

            raise BadRequestError("authorization_pending")
        if error == "slow_down":
            raise MusicSlowDown()
        if error in ("expired_token", "code_expired"):
            raise DownloadError("music_expired")
        if error in ("access_denied", "authorization_declined"):
            raise DownloadError("music_denied")
        if status == 429:
            raise DownloadError("http_429")
        if status >= 400 or error:
            raise DownloadError("music_auth")
        return body


def yandex_device_login(job, http, progress):
    try:
        from yandex_music import Client
    except ImportError:
        raise DownloadError("music_dependency")
    client = Client(request=YandexOAuthTransport(http))
    # The SDK's debug decorator prints OAuth models. Unwrap only these calls;
    # never change global logging or the installed library for other plugins.
    try:
        code = inspect.unwrap(Client.request_device_code)(
            client, device_name="Media Downloader"
        )
        if (
            not code
            or not isinstance(code.user_code, str)
            or not re.fullmatch(r"[A-Za-z0-9-]{4,32}", code.user_code)
        ):
            raise DownloadError("music_auth")
        if not code.device_code or not isinstance(code.expires_in, (int, float)):
            raise DownloadError("music_auth")
        interval = min(60, max(2, float(code.interval or 5)))
        deadline = time.monotonic() + min(900, max(1, float(code.expires_in)))
        progress(
            job,
            state="authorizing",
            backend="yandex",
            auth_code=code.user_code,
            auth_url=YANDEX_DEVICE_URL,
            title="Яндекс Музыка",
        )
        while time.monotonic() < deadline:
            if job.cancel_event.wait(
                min(interval, max(0, deadline - time.monotonic()))
            ):
                raise Cancelled()
            job.check()
            if time.monotonic() >= deadline:
                break
            try:
                token = inspect.unwrap(Client.poll_device_token)(
                    client, code.device_code
                )
            except MusicSlowDown:
                interval = min(60, interval + 5)
                continue
            if token is not None:
                job.check()
                return music_token(token.access_token)
        raise DownloadError("music_expired")
    except (DownloadError, MusicSlowDown):
        raise
    except Exception:
        # OAuth exceptions may contain credentials or raw response bodies.
        raise DownloadError("music_auth")
    finally:
        progress(job, auth_code="", auth_url="")


class MusicTokenStore:
    """Only encrypted data is persisted, outside Android backup and settings."""

    def __init__(self, directory, crypto):
        self.path = os.path.join(directory, "downloader-yandex-v1.json")
        self.crypto = crypto

    def exists(self):
        return os.path.isfile(self.path)

    def load(self):
        if not self.exists():
            return None
        try:
            with open(self.path, "rb") as stream:
                raw = stream.read(16385)
            if len(raw) > 16384:
                raise ValueError()
            data = json.loads(raw)
            if data.get("version") != 1:
                raise ValueError()
            iv = base64.b64decode(data["iv"], validate=True)
            payload = base64.b64decode(data["ciphertext"], validate=True)
            return music_token(self.crypto.decrypt(iv, payload).decode("utf-8"))
        except Exception:
            raise DownloadError("music_storage")

    def save(self, token):
        temporary = self.path + "." + uuid.uuid4().hex + ".tmp"
        try:
            iv, payload = self.crypto.encrypt(music_token(token).encode("utf-8"))
            data = {
                "version": 1,
                "iv": base64.b64encode(iv).decode("ascii"),
                "ciphertext": base64.b64encode(payload).decode("ascii"),
            }
            os.makedirs(os.path.dirname(self.path), mode=0o700, exist_ok=True)
            with open(temporary, "x", encoding="utf-8") as stream:
                os.chmod(temporary, 0o600)
                json.dump(data, stream)
                stream.flush()
                os.fsync(stream.fileno())
            os.replace(temporary, self.path)
        except Exception:
            raise DownloadError("music_storage")
        finally:
            if os.path.exists(temporary):
                os.remove(temporary)

    def clear(self):
        try:
            if self.exists():
                os.remove(self.path)
            self.crypto.clear()
        except Exception:
            raise DownloadError("music_storage")


def yandex_reference(url):
    if service_for(url) != "yandex_music":
        raise DownloadError("music_url")
    parts = urllib.parse.urlsplit(normalize_url(url)).path.strip("/").split("/")
    if (
        len(parts) == 4
        and parts[0] == "album"
        and parts[2] == "track"
        and all(re.fullmatch(r"\d{1,20}", p) for p in (parts[1], parts[3]))
    ):
        return "track", parts[3] + ":" + parts[1]
    if (
        len(parts) == 2
        and parts[0] in ("track", "album")
        and re.fullmatch(r"\d{1,20}", parts[1])
    ):
        return parts[0], parts[1]
    if (
        len(parts) == 4
        and parts[0] == "users"
        and parts[2] == "playlists"
        and re.fullmatch(r"\d{1,20}", parts[3])
    ):
        login = urllib.parse.unquote(parts[1])
        if not re.fullmatch(r"[A-Za-z0-9_.@-]{1,100}", login):
            raise DownloadError("music_url")
        return "playlist", urllib.parse.quote(login, safe="") + "/" + parts[3]
    if len(parts) == 2 and parts[0] == "playlists":
        try:
            return "uuid", str(uuid.UUID(parts[1]))
        except ValueError:
            pass
    raise DownloadError("music_url")


class YandexMusicAPI:
    def __init__(self, http, token):
        self.http, self.token = http, music_token(token)

    def call(self, method, path, **kwargs):
        if (
            not path.startswith("/")
            or path.startswith("//")
            or "?" in path
            or "#" in path
        ):
            raise DownloadError("music_url")
        status, body = music_json(
            self.http,
            method,
            YANDEX_API + path,
            headers={
                "Authorization": "OAuth " + self.token,
                "X-Yandex-Music-Client": "YandexMusicAndroid/24023621",
            },
            **kwargs,
        )
        if status == 401:
            raise DownloadError("music_login")
        if status == 403:
            raise DownloadError("music_access")
        if status == 404:
            raise DownloadError("music_unavailable")
        if status == 429:
            raise DownloadError("http_429")
        if status >= 400 or not isinstance(body, dict) or body.get("error"):
            raise DownloadError(
                "music_api", "API " + path.split("/")[-1] + ": HTTP " + str(status)
            )
        if "result" not in body:
            raise DownloadError("music_api", "API: no result")
        return body["result"]

    def tracks(self, reference):
        kind, ident = reference
        if kind == "track":
            items = self.call("POST", "/tracks", data={"track-ids": ident})
        elif kind == "album":
            album = self.call("GET", "/albums/" + ident + "/with-tracks")
            if not isinstance(album, dict) or not isinstance(
                album.get("volumes"), list
            ):
                raise DownloadError("music_api")
            items = [t for volume in album["volumes"] for t in volume]
            if album.get("trackCount") and int(album["trackCount"]) != len(items):
                raise DownloadError("music_incomplete")
        else:
            if kind == "uuid":
                path = "/playlist/" + ident
            else:
                owner, playlist = ident.split("/")
                path = "/users/" + owner + "/playlists/" + playlist
            playlist = self.call("GET", path)
            if not isinstance(playlist, dict):
                raise DownloadError("music_api")
            entries = playlist.get("tracks", [])
            if not isinstance(entries, list):
                raise DownloadError("music_api")
            count = int(playlist.get("trackCount", len(entries)))
            if count > MAX_ITEMS:
                raise DownloadError("too_many")
            if count != len(entries):
                raise DownloadError("music_incomplete")
            items = []
            for entry in entries:
                if not isinstance(entry, dict):
                    raise DownloadError("music_unavailable")
                track = entry.get("track")
                if not isinstance(track, dict):
                    track_id = str(entry.get("id", ""))
                    album_id = str(entry.get("albumId", ""))
                    if not re.fullmatch(r"\d{1,20}", track_id):
                        raise DownloadError("music_unavailable")
                    if re.fullmatch(r"\d{1,20}", album_id):
                        track_id += ":" + album_id
                    resolved = self.call(
                        "POST", "/tracks", data={"track-ids": track_id}
                    )
                    if not isinstance(resolved, list) or len(resolved) != 1:
                        raise DownloadError("music_unavailable")
                    track = resolved[0]
                items.append(track)
        if not isinstance(items, list) or not items:
            raise DownloadError("empty")
        if len(items) > MAX_ITEMS:
            raise DownloadError("too_many")
        for track in items:
            if not isinstance(track, dict) or not re.fullmatch(
                r"\d{1,20}", str(track.get("id", ""))
            ):
                raise DownloadError("music_unavailable")
            if (
                track.get("available") is False
                or track.get("availableForPremiumUsers") is False
                and track.get("available") is not True
            ):
                raise DownloadError("music_unavailable")
        return items


def yandex_direct_url(job, http, info):
    url = normalize_url(info.get("downloadInfoUrl", ""))
    if urllib.parse.urlsplit(url).scheme != "https":
        raise DownloadError("music_api", "download-info: HTTP URL")
    response = http.request("GET", url, api=True)
    try:
        http.status(response)
        raw = bytearray()
        for chunk in response.iter_content(8192):
            job.check()
            raw.extend(chunk)
            if len(raw) > 65536:
                raise DownloadError("music_api")
        if b"<!DOCTYPE" in raw.upper() or b"<!ENTITY" in raw.upper():
            raise DownloadError("music_api")
        try:
            root = ET.fromstring(raw)
            host, path, stamp, salt = (
                root.findtext(k) for k in ("host", "path", "ts", "s")
            )
            if (
                not host
                or not re.fullmatch(r"[A-Za-z0-9.-]+", host)
                or not path
                or not path.startswith("/")
                or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._~-]{0,127}", stamp or "")
                or not salt
            ):
                invalid = []
                if not host or not re.fullmatch(r"[A-Za-z0-9.-]+", host):
                    invalid.append("host")
                if not path or not path.startswith("/"):
                    invalid.append("path")
                if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._~-]{0,127}", stamp or ""):
                    invalid.append("ts")
                if not salt:
                    invalid.append("s")
                raise DownloadError(
                    "music_api", "download-info: invalid " + ", ".join(invalid)
                )
            from yandex_music.download_info import SIGN_SALT

            signature = hashlib.md5(
                (SIGN_SALT + path[1:] + salt).encode("utf-8")
            ).hexdigest()
            return normalize_url(
                "https://" + host + "/get-mp3/" + signature + "/" + stamp + path
            )
        except DownloadError:
            raise
        except Exception:
            raise DownloadError("music_api", "download-info: unexpected XML")
    finally:
        http.release(response)


def yandex_tag_mp3(path, track):
    try:
        from mutagen.mp3 import MP3
        from mutagen.id3 import ID3, TIT2, TPE1, TALB, TRCK
    except ImportError:
        raise DownloadError("music_dependency")
    try:
        audio = MP3(path)
        expected = float(track.get("durationMs", 0)) / 1000
        if expected > 45 and audio.info.length + 10 < expected:
            raise DownloadError("music_preview")
        title = str(track.get("title") or "Яндекс Музыка")
        if track.get("version"):
            title += " (" + str(track["version"]) + ")"
        artists = [
            str(a["name"])
            for a in track.get("artists", [])
            if isinstance(a, dict) and a.get("name")
        ]
        albums = track.get("albums") or []
        album = albums[0] if albums and isinstance(albums[0], dict) else {}
        tags = audio.tags or ID3()
        tags.add(TIT2(encoding=3, text=title))
        tags.add(TPE1(encoding=3, text=artists))
        if album.get("title"):
            tags.add(TALB(encoding=3, text=str(album["title"])))
        position = album.get("trackPosition") or {}
        if position.get("index"):
            tags.add(TRCK(encoding=3, text=str(position["index"])))
        tags.save(path, v2_version=3)
    except DownloadError:
        raise
    except Exception:
        raise DownloadError("not_media")


def yandex_download(job, http, progress, authorize):
    reference = yandex_reference(job.url)
    if job.mode == "video":
        raise DownloadError("music_audio")
    token = authorize(job, http)
    api = YandexMusicAPI(http, token)
    tracks = api.tracks(reference)
    media = []
    bitrate = option(MUSIC_BITRATES, job.settings.get("yandex_quality_set", 2), 320)
    for index, track in enumerate(tracks, 1):
        job.check()
        progress(
            job,
            state="resolving",
            title=str(track.get("title", "")),
            item=index,
            items=len(tracks),
            current=0,
            total=0,
            speed=0,
        )
        infos = api.call("GET", "/tracks/" + str(track["id"]) + "/download-info")
        if not isinstance(infos, list):
            raise DownloadError("music_api")
        full = [
            i
            for i in infos
            if isinstance(i, dict)
            and i.get("preview") is False
            and str(i.get("codec", "")).lower() == "mp3"
            and isinstance(i.get("bitrateInKbps"), (int, float))
        ]
        if not full:
            raise DownloadError(
                "music_preview"
                if any(isinstance(i, dict) and i.get("preview") is True for i in infos)
                else "music_access"
            )
        below = [i for i in full if i["bitrateInKbps"] <= bitrate]
        chosen = (
            max(below, key=lambda i: i["bitrateInKbps"])
            if below
            else min(full, key=lambda i: i["bitrateInKbps"])
        )
        url = yandex_direct_url(job, http, chosen)
        item = fetch_media(job, http, url, progress, "audio")
        if item.kind != "audio" or not item.path.endswith(".mp3"):
            raise DownloadError("not_media")
        yandex_tag_mp3(item.path, track)
        media.append(item)
    return media


