def mux_tracks(job, paths, mode, progress):
    job.check()
    progress(job, state="processing", speed=0)
    ensure_space(job.directory, sum(os.path.getsize(p) for p in paths))
    destination = os.path.join(
        job.directory, uuid.uuid4().hex + (".m4a" if mode == "audio" else ".mp4")
    )
    extractors, muxer, started = [], None, False
    try:
        Extractor = jclass("android.media.MediaExtractor")
        Muxer = jclass("android.media.MediaMuxer")
        BufferInfo = jclass("android.media.MediaCodec$BufferInfo")
        muxer = Muxer(destination, Muxer.OutputFormat.MUXER_OUTPUT_MPEG_4)
        track_sets, kinds = [], set()
        for path in paths:
            extractor = Extractor()
            extractors.append(extractor)
            extractor.setDataSource(path)
            mapping = {}
            for index in range(extractor.getTrackCount()):
                fmt = extractor.getTrackFormat(index)
                mime = str(fmt.getString("mime"))
                kind = (
                    "audio"
                    if mime.startswith("audio/")
                    else "video"
                    if mime.startswith("video/")
                    else ""
                )
                if (
                    not kind
                    or mode == "audio"
                    and kind != "audio"
                    or mode == "mute"
                    and kind != "video"
                ):
                    continue
                if kind in kinds:
                    raise DownloadError("mux")
                kinds.add(kind)
                mapping[index] = muxer.addTrack(fmt)
                extractor.selectTrack(index)
                if kind == "video" and fmt.containsKey("rotation-degrees"):
                    muxer.setOrientationHint(fmt.getInteger("rotation-degrees"))
            track_sets.append(mapping)
        if (
            not kinds
            or mode == "audio"
            and "audio" not in kinds
            or mode != "audio"
            and "video" not in kinds
            or len(paths) > 1
            and mode == "video"
            and "audio" not in kinds
        ):
            raise DownloadError("mux")
        muxer.start()
        started = True
        capacity = 16 * 1024 * 1024
        buffer = jclass("java.nio.ByteBuffer").allocateDirect(capacity)
        sample = BufferInfo()
        initial = [
            e.getSampleTime()
            for e, tracks in zip(extractors, track_sets)
            if tracks and e.getSampleTrackIndex() >= 0
        ]
        baseline = min(initial) if initial else 0
        active = [(e, tracks) for e, tracks in zip(extractors, track_sets) if tracks]
        while active:
            job.check()
            active = [
                (e, tracks) for e, tracks in active if e.getSampleTrackIndex() >= 0
            ]
            if not active:
                break
            # Feed both tracks in timestamp order; avoid buffering a whole video
            # while the native writer waits for the first audio sample.
            extractor, tracks = min(active, key=lambda pair: pair[0].getSampleTime())
            index = extractor.getSampleTrackIndex()
            buffer.clear()
            size = extractor.readSampleData(buffer, 0)
            if size < 0:
                active.remove((extractor, tracks))
                continue
            if size > capacity or extractor.getSampleFlags() & 2:
                raise DownloadError("mux")
            sample.set(
                0,
                size,
                max(0, extractor.getSampleTime() - baseline),
                extractor.getSampleFlags() & 1,
            )
            muxer.writeSampleData(tracks[index], buffer, sample)
            extractor.advance()
        muxer.stop()
        started = False
        job.check()
        if not os.path.getsize(destination):
            raise DownloadError("empty")
        if os.path.getsize(destination) > job.limit:
            raise DownloadError("too_large")
        return Media(destination, "audio" if mode == "audio" else "video")
    except DownloadError:
        raise
    except Exception:
        job.check()
        raise DownloadError("mux")
    finally:
        if muxer is not None:
            if started:
                try:
                    muxer.stop()
                except Exception:
                    pass
            muxer.release()
        for extractor in extractors:
            extractor.release()


def js_document(source):
    if len(source) > 12 * 1024 * 1024:
        raise DownloadError("js")
    escaped = json.dumps(source, ensure_ascii=True).replace("<", "\\u003c")
    return (
        '<!doctype html><meta charset="utf-8"><script>window.__md=null;try{window.__md=(function(){var result="";var console={log:function(x){result=String(x)},warn:function(){},error:function(){}};eval('
        + escaped
        + ");return {ok:true,value:result}})()}catch(e){window.__md={ok:false}}</script>"
    )


def android_javascript(job, source):
    html = js_document(source)
    ready, closed, result, references = threading.Event(), threading.Event(), {}, []

    class ResultCallback(dynamic_proxy(jclass("android.webkit.ValueCallback"))):
        def onReceiveValue(self, value):
            if closed.is_set():
                return
            try:
                data = json.loads(str(value))
                if isinstance(data, dict):
                    result.update(data)
                    ready.set()
            except (TypeError, ValueError):
                pass

    callback = ResultCallback()

    def poll():
        if closed.is_set() or not references:
            return
        try:
            references[0].evaluateJavascript("window.__md || null", callback)
            if not ready.is_set():
                run_on_ui_thread(poll, 200)
        except Exception:
            ready.set()

    def create():
        if closed.is_set() or job.cancel_event.is_set():
            ready.set()
            return
        try:
            context = jclass(
                "org.telegram.messenger.ApplicationLoader"
            ).applicationContext
            view = jclass("android.webkit.WebView")(context)
            references.append(view)
            settings = view.getSettings()
            settings.setJavaScriptEnabled(True)
            settings.setAllowFileAccess(False)
            settings.setAllowContentAccess(False)
            settings.setBlockNetworkLoads(True)
            settings.setDomStorageEnabled(False)
            settings.setSaveFormData(False)
            settings.setAllowFileAccessFromFileURLs(False)
            settings.setAllowUniversalAccessFromFileURLs(False)
            view.loadDataWithBaseURL(
                "https://media-downloader.invalid/", html, "text/html", "UTF-8", None
            )
            run_on_ui_thread(poll, 200)
        except Exception:
            ready.set()

    def destroy():
        if references:
            references[0].stopLoading()
            references[0].destroy()
            references.clear()

    run_on_ui_thread(create)
    deadline = time.monotonic() + 35
    try:
        while not ready.wait(0.2):
            job.check()
            if time.monotonic() > deadline:
                raise DownloadError("js")
        job.check()
        if (
            not result.get("ok")
            or not isinstance(result.get("value"), str)
            or len(result["value"]) > JSON_LIMIT
        ):
            raise DownloadError("js")
        return result["value"]
    finally:
        closed.set()
        run_on_ui_thread(destroy)


_JSC_CLASS = None
_JSC_LOCK = threading.Lock()


def register_android_jsc():
    global _JSC_CLASS
    with _JSC_LOCK:
        if _JSC_CLASS is not None:
            return
        try:
            from yt_dlp.extractor.youtube.jsc._builtin.ejs import EJSBaseJCP
            from yt_dlp.extractor.youtube.jsc._registry import _jsc_providers

            class MediaDownloaderWebViewJCP(EJSBaseJCP):
                JS_RUNTIME_NAME = "Android System WebView"
                PROVIDER_VERSION = __version__
                BUG_REPORT_LOCATION = "Media Downloader plugin settings"

                def is_available(self):
                    return callable(self.ie.get_param("_media_downloader_js"))

                def _run_js_runtime(self, source):
                    return self.ie.get_param("_media_downloader_js")(source)

            # Stateless provider: each YoutubeDL instance supplies its own job callback.
            _jsc_providers.value[MediaDownloaderWebViewJCP.PROVIDER_KEY] = (
                MediaDownloaderWebViewJCP
            )
            _JSC_CLASS = MediaDownloaderWebViewJCP
        except ImportError:
            log("[downloader] installed yt-dlp has no compatible JS provider API")


def unregister_android_jsc():
    global _JSC_CLASS
    with _JSC_LOCK:
        if _JSC_CLASS is not None:
            try:
                from yt_dlp.extractor.youtube.jsc._registry import _jsc_providers

                if _jsc_providers.value.get(_JSC_CLASS.PROVIDER_KEY) is _JSC_CLASS:
                    _jsc_providers.value.pop(_JSC_CLASS.PROVIDER_KEY)
            except ImportError:
                pass
            _JSC_CLASS = None


def send_parameter(params, name, default=None):
    """Read Java fields explicitly: Object.notify can shadow the notify field."""
    if isinstance(params, dict):
        value = params.get(name, default)
        return default if callable(value) else value
    get_class = getattr(params, "getClass", None)
    if callable(get_class):
        try:
            owner = get_class()
            for _ in range(12):
                if owner is None:
                    break
                try:
                    field = owner.getDeclaredField(name)
                except Exception:
                    owner = owner.getSuperclass()
                    continue
                field.setAccessible(True)
                kind = str(field.getType().getName())
                getter = {
                    "boolean": "getBoolean",
                    "int": "getInt",
                    "long": "getLong",
                }.get(kind, "get")
                value = getattr(field, getter)(params)
                return default if callable(value) else value
        except Exception:
            pass
    value = getattr(params, name, default)
    return default if callable(value) else value


def send_scalar(value, kind):
    """Never coerce Java methods or arbitrary truthy objects into send flags."""
    if kind == "boolean":
        if type(value) is bool:
            return value
        if type(value) is int and value in (0, 1):
            return bool(value)
    elif type(value) is int:
        bits = 32 if kind == "int" else 64
        if -(1 << (bits - 1)) <= value < (1 << (bits - 1)):
            return value
    raise DownloadError(
        "send",
        tr(
            "Некорректные параметры отправки клиента",
            "Invalid client sending parameters",
        ),
    )


def media_send_arguments(types, target, account, media, force_document):
    prefix = (
        "AccountInstance",
        "ArrayList",
        "long",
        "MessageObject",
        "MessageObject",
        "StoryItem",
        "ReplyQuote",
        "boolean",
        "boolean",
        "MessageObject",
    )
    short = [str(t).split(".")[-1].split("$")[-1] for t in types]
    if tuple(short[:10]) != prefix:
        return None
    args = [
        account,
        media,
        target.peer,
        target.reply,
        target.top,
        target.story,
        target.quote,
        force_document,
        not force_document,
        None,
    ]
    tail = list(types[10:])
    if tail and str(tail[0]).endswith("TL_inputPollAnswer"):
        args.append(None)
        tail.pop(0)
    if not tail or tail.pop(0) != "boolean":
        return None
    args.append(target.notify)
    ints = 0
    while tail and tail[0] == "int":
        tail.pop(0)
        ints += 1
    if ints not in (2, 3):
        return None
    args.extend(
        [target.schedule, 0] if ints == 2 else [target.schedule, target.repeat, 0]
    )
    longs, invert_seen = 0, False
    nullable = (
        "InputContentInfoCompat",
        "SendMessageChatArguments",
        "MessageSuggestionParams",
        "PollSendParams",
    )
    for typ in tail:
        if typ == "boolean":
            args.append(target.invert if longs and not invert_seen else False)
            if longs:
                invert_seen = True
        elif typ == "long":
            if longs >= 3:
                return None
            args.append((target.effect, target.stars, target.mono_peer)[longs])
            longs += 1
        elif typ == "int":
            args.append(0)
        elif any(str(typ).endswith(x) for x in nullable):
            args.append(
                target.send_args
                if str(typ).endswith("SendMessageChatArguments")
                else target.suggestion
                if str(typ).endswith("MessageSuggestionParams")
                else None
            )
        else:
            return None
    return args if len(args) == len(types) else None


def native_send(target, items, caption, force_document=False):
    account = jclass("org.telegram.messenger.AccountInstance").getInstance(
        target.account
    )
    if int(account.getUserConfig().getClientUserId()) != target.user_id:
        raise DownloadError("account")
    helper = jclass("org.telegram.messenger.SendMessagesHelper")
    media = jclass("java.util.ArrayList")()
    for index, item in enumerate(items):
        info = helper.SendingMediaInfo()
        info.path = item.path
        info.isVideo = item.kind == "video"
        info.forceImage = item.kind == "photo" and os.path.splitext(item.path)[
            1
        ].lower() in (".jpg", ".jpeg", ".png", ".webp")
        if index == 0 and caption:
            info.caption = caption
        media.add(info)
    loader = jclass(
        "org.telegram.messenger.ApplicationLoader"
    ).applicationContext.getClassLoader()
    helper_class = jclass("java.lang.Class").forName(
        "org.telegram.messenger.SendMessagesHelper", False, loader
    )
    methods = [
        m
        for m in helper_class.getDeclaredMethods()
        if str(m.getName()) == "prepareSendingMedia"
    ]
    for method in sorted(methods, key=lambda m: len(m.getParameterTypes())):
        types = [str(t.getName()) for t in method.getParameterTypes()]
        args = media_send_arguments(types, target, account, media, force_document)
        if args is None:
            continue
        boxed = []
        for typ, value in zip(types, args):
            if typ in ("long", "int", "boolean"):
                value = send_scalar(value, typ)
                value = jclass(
                    {
                        "long": "java.lang.Long",
                        "int": "java.lang.Integer",
                        "boolean": "java.lang.Boolean",
                    }[typ]
                )(value)
            boxed.append(value)
        method.invoke(None, jarray(jclass("java.lang.Object"))(boxed))
        return
    raise DownloadError(
        "send",
        tr(
            "Версия интерфейса отправки клиента не поддерживается",
            "Unsupported client media-sending interface",
        ),
    )


class AndroidMusicCrypto:
    ALIAS = "downloader.yandex_music.oauth.v1"
    AAD = b"downloader:yandex:oauth:v1"

    @staticmethod
    def java_bytes(value):
        return jarray("B")([b if b < 128 else b - 256 for b in value])

    @staticmethod
    def python_bytes(value):
        return bytes(int(b) & 255 for b in value)

    def store(self):
        store = jclass("java.security.KeyStore").getInstance("AndroidKeyStore")
        store.load(None)
        return store

    def key(self, create):
        store = self.store()
        if store.containsAlias(self.ALIAS):
            return store.getKey(self.ALIAS, None)
        if not create:
            raise DownloadError("music_storage")
        properties = jclass("android.security.keystore.KeyProperties")
        spec = jclass("android.security.keystore.KeyGenParameterSpec$Builder")(
            self.ALIAS, properties.PURPOSE_ENCRYPT | properties.PURPOSE_DECRYPT
        )
        spec.setBlockModes(jarray(jclass("java.lang.String"))(["GCM"]))
        spec.setEncryptionPaddings(jarray(jclass("java.lang.String"))(["NoPadding"]))
        spec.setKeySize(256)
        generator = jclass("javax.crypto.KeyGenerator").getInstance(
            "AES", "AndroidKeyStore"
        )
        generator.init(spec.build())
        return generator.generateKey()

    def encrypt(self, plaintext):
        Cipher = jclass("javax.crypto.Cipher")
        cipher = Cipher.getInstance("AES/GCM/NoPadding")
        cipher.init(Cipher.ENCRYPT_MODE, self.key(True))
        cipher.updateAAD(self.java_bytes(self.AAD))
        result = cipher.doFinal(self.java_bytes(plaintext))
        return self.python_bytes(cipher.getIV()), self.python_bytes(result)

    def decrypt(self, iv, ciphertext):
        if len(iv) != 12 or len(ciphertext) < 16:
            raise DownloadError("music_storage")
        Cipher = jclass("javax.crypto.Cipher")
        cipher = Cipher.getInstance("AES/GCM/NoPadding")
        params = jclass("javax.crypto.spec.GCMParameterSpec")(128, self.java_bytes(iv))
        cipher.init(Cipher.DECRYPT_MODE, self.key(False), params)
        cipher.updateAAD(self.java_bytes(self.AAD))
        return self.python_bytes(cipher.doFinal(self.java_bytes(ciphertext)))

    def clear(self):
        store = self.store()
        if store.containsAlias(self.ALIAS):
            store.deleteEntry(self.ALIAS)


class VideoDownloaderPlugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self._lock = threading.RLock()
        self._jobs = collections.OrderedDict()
        self._queue = collections.deque()
        self._worker = None
        self._loaded = False
        self._epoch = 0
        self._dialog = None
        self._dialog_job = ""
        self._views = None
        self._last_progress = 0
        self._menu_ids = []
        self._music_lock = threading.RLock()
        self._music_generation = 0

    def on_plugin_load(self):
        self._migrate_settings()
        with self._lock:
            self._epoch += 1
            self._loaded = True
        self.add_on_send_message_hook()
        self._add_menus()

    def on_plugin_unload(self):
        with self._lock:
            self._loaded = False
            self._epoch += 1
            for job in self._jobs.values():
                job.cancel()
            self._queue.clear()
        for item in self._menu_ids:
            try:
                self.remove_menu_item(item)
            except Exception:
                pass
        self._menu_ids.clear()
        unregister_android_jsc()
        dialog_id = self._dialog_job
        run_on_ui_thread(lambda: self._dismiss_progress(dialog_id))

    def _migrate_settings(self):
        if self.get_setting("downloader_schema", 0) >= 3:
            return
        if self.get_setting("cobalt_url_set", None) is None:
            legacy_choice = self.get_setting("api_url_choice_set", None)
            custom = str(self.get_setting("api_url_set", "") or "").strip()
            endpoint = option(LEGACY_COBALT, legacy_choice, custom)
            if endpoint:
                self.set_setting("cobalt_url_set", endpoint, reload_settings=False)
        enabled = self._auto_services()
        for key, _, _ in SERVICES:
            self.set_setting(
                "auto_service_" + key, key in enabled, reload_settings=False
            )
        self.set_setting("downloader_schema", 3, reload_settings=False)

    def _auto_services(self):
        saved = self.get_setting("auto_link_services_set", None)
        known = {key for key, _, _ in SERVICES}
        return (
            known
            if saved is None
            else set(saved) & known
            if isinstance(saved, (list, tuple, set))
            else known
        )

    def _toggle_service(self, key, value):
        current = self._auto_services()
        current.add(key) if value else current.discard(key)
        self.set_setting("auto_service_" + key, bool(value), reload_settings=False)
        self.set_setting(
            "auto_link_services_set", sorted(current), reload_settings=False
        )

    def _setting_changed(self, key, value):
        self.set_setting(key, value, reload_settings=True)

    def _snapshot(self):
        defaults = {
            "backend_set": 0,
            "auto_fallback_set": True,
            "tikwm_fallback_set": True,
            "include_source_set": True,
            "album_audio_set": False,
            "video_quality_set": 5,
            "audio_bitrate_set": 5,
            "yandex_quality_set": 2,
            "cobalt_url_set": "",
            "api_key_set": "",
            "invidious_url_set": "",
            "piped_url_set": "",
            "proxy_type_set": 0,
            "proxy_url_set": "",
            "proxy_username_set": "",
            "proxy_password_set": "",
        }
        return {key: self.get_setting(key, value) for key, value in defaults.items()}

    def create_settings(self):
        return [
            Header(text=tr("Загрузки", "Downloads")),
            Text(
                text=tr("Скачать по ссылке", "Download a URL"),
                subtext=tr(
                    "Видео, фото или аудио — в Избранное",
                    "Video, photos or audio to Saved Messages",
                ),
                icon="msg_download",
                accent=True,
                on_click=lambda _: self._prompt_url(),
            ),
            Text(
                text=tr("Мои загрузки", "My downloads"),
                subtext=tr(
                    "Прогресс, очередь и повтор после ошибки",
                    "Progress, queue and retry",
                ),
                icon="msg_list",
                on_click=lambda _: self._show_jobs(),
            ),
            Header(text=tr("Скачивание", "Downloading")),
            Selector(
                key="backend_set",
                text=tr("Как скачивать", "Download method"),
                default=self.get_setting("backend_set", 0),
                items=[backend_name(x) for x in BACKENDS],
                icon="msg2_devices",
                on_change=lambda value: self._setting_changed("backend_set", value),
            ),
            Divider(text=self._backend_hint()),
            Selector(
                key="video_quality_set",
                text=tr("Качество видео", "Video quality"),
                default=self.get_setting("video_quality_set", 5),
                items=[
                    x + "p" if x.isdigit() else tr("Максимальное", "Best available")
                    for x in QUALITY
                ],
                icon="msg_video",
            ),
            Switch(
                key="include_source_set",
                text=tr("Добавлять ссылку в подпись", "Include source URL in caption"),
                default=self.get_setting("include_source_set", True),
                icon="msg_link",
            ),
            Switch(
                key="album_audio_set",
                text=tr("Музыка альбома файлом", "Slideshow music as a file"),
                default=self.get_setting("album_audio_set", False),
                icon="input_mic",
            ),
            self._music_icon_row(),
            Header(text=tr("Автоматически", "Automatic downloads")),
            Text(
                text=tr("Автозагрузка ссылок", "Automatic link downloads"),
                subtext=(
                    tr("Включена · сайтов: %d", "Enabled · sites: %d")
                    % len(self._auto_services())
                    if self.get_setting("auto_link_set", False)
                    else tr(
                        "Выключена · настройте сайты для автозагрузки",
                        "Off · choose sites to download automatically",
                    )
                ),
                icon="msg_link",
                create_sub_fragment=self._auto_settings,
            ),
            Header(text=tr("Дополнительно", "Advanced")),
            Text(
                text=tr("Онлайн-сервисы", "Online services"),
                subtext=tr(
                    "Резервные способы и свой сервер Cobalt",
                    "Fallback services and your Cobalt server",
                ),
                icon="msg2_devices",
                create_sub_fragment=self._online_settings,
            ),
            Text(
                text=tr("Прокси плагина", "Download proxy"),
                subtext=option(
                    [
                        tr("Выключен · прямое подключение", "Off · direct connection"),
                        "HTTP",
                        "HTTPS",
                        "SOCKS5",
                        tr(
                            "MTProto не подходит для сайтов",
                            "MTProto cannot download websites",
                        ),
                    ],
                    self.get_setting("proxy_type_set", 0),
                    tr("Проверьте настройки", "Check configuration"),
                ),
                icon="proxy_check",
                create_sub_fragment=self._proxy_settings,
            ),
            Divider(),
            Text(
                text=tr("Как пользоваться", "How to use"),
                icon="msg_info",
                on_click=lambda _: self._help(),
            ),
        ]

    def _backend_hint(self):
        selected = option(BACKENDS, self.get_setting("backend_set", 0), "auto")
        hints = {
            "auto": tr(
                "Рекомендуется. Сначала скачивает телефон; если не получилось — пробует включённые онлайн-сервисы.",
                "Recommended. Downloads on your phone first, then tries enabled online services.",
            ),
            "local": tr(
                "Телефон скачивает с исходного сайта через yt-dlp. Настраивать сервер не нужно.",
                "Your phone downloads from the original website using yt-dlp. No server setup is needed.",
            ),
            "yandex": tr(
                "Треки, альбомы и плейлисты Яндекс Музыки. Войдите в аккаунт в разделе «Яндекс Музыка».",
                "Yandex Music tracks, albums and playlists. Sign in under Yandex Music in settings.",
            ),
            "tikwm": tr(
                "Только TikTok: видео, фото и музыка. Дополнительная настройка не нужна.",
                "TikTok videos, photos and music. No additional setup needed.",
            ),
            "direct": tr(
                "Нужна ссылка прямо на файл, например MP4. Для ссылки на страницу выберите автоматический способ.",
                "Use a direct file URL, such as MP4. For a webpage, choose Automatic.",
            ),
        }
        if selected in hints:
            return hints[selected]
        configured = bool(
            str(self.get_setting(selected + "_url_set", "") or "").strip()
        )
        return (
            tr(
                "Используется только выбранный сервис. Его адрес указан в «Онлайн-сервисы».",
                "Only the selected service is used. Its URL is configured in Online services.",
            )
            if configured
            else tr(
                "Сначала укажите адрес этого сервиса в разделе «Онлайн-сервисы» ниже.",
                "First enter this service's URL in Online services below.",
            )
        )

    def _music_store(self):
        context = jclass("org.telegram.messenger.ApplicationLoader").applicationContext
        directory = str(context.getNoBackupFilesDir().getAbsolutePath())
        return MusicTokenStore(directory, AndroidMusicCrypto())

    def _add_service_icon(self, parent, key):
        context = parent.getContext()
        dp = jclass("org.telegram.messenger.AndroidUtilities").dp
        size = dp(28)
        kind, data = SERVICE_LOGOS[key]
        if kind == "svg":
            bitmap = jclass("org.telegram.messenger.SvgHelper").getBitmap(
                data, size, size, False
            )
        else:
            raw = jclass("android.util.Base64").decode(data, 0)
            bitmap = jclass("android.graphics.BitmapFactory").decodeByteArray(
                raw, 0, len(raw)
            )
        if bitmap is None:
            raise ValueError("Cannot render bundled service logo: " + key)
        bitmap.setDensity(context.getResources().getDisplayMetrics().densityDpi)
        image = jclass("android.widget.ImageView")(context)
        image.setImageBitmap(bitmap)
        image.setImportantForAccessibility(2)
        rtl = jclass("org.telegram.messenger.LocaleController").isRTL
        params = jclass("android.widget.FrameLayout$LayoutParams")(
            size, size, 21 if rtl else 19
        )
        if rtl:
            params.rightMargin = dp(20)
        else:
            params.leftMargin = dp(20)
        parent.addView(image, params)

    def _service_switch(self, key, title):
        if Custom is not None:
            try:
                context = jclass(
                    "org.telegram.messenger.ApplicationLoader"
                ).applicationContext
                cell = jclass("org.telegram.ui.Cells.TextCheckCell")(context, 72)
                cell.setTextAndCheck(title, key in self._auto_services(), False)
                self._add_service_icon(cell, key)

                def toggle(_view):
                    enabled = key not in self._auto_services()
                    self._toggle_service(key, enabled)
                    cell.setChecked(enabled)

                return Custom(view=cell, on_click=toggle)
            except Exception:
                pass
        return Switch(
            key="auto_service_" + key,
            text=title,
            default=key in self._auto_services(),
            on_change=lambda value: self._toggle_service(key, value),
        )

    def _music_icon_row(self):
        title = tr("Яндекс Музыка", "Yandex Music")
        if Custom is not None:
            try:
                context = jclass(
                    "org.telegram.messenger.ApplicationLoader"
                ).applicationContext
                frame = jclass("android.widget.FrameLayout")(context)
                FrameParams = jclass("android.widget.FrameLayout$LayoutParams")
                dp = jclass("org.telegram.messenger.AndroidUtilities").dp
                frame.setLayoutParams(
                    jclass("android.view.ViewGroup$LayoutParams")(-1, dp(64))
                )
                frame.setMinimumHeight(dp(56))
                self._add_service_icon(frame, "yandex_music")
                label = jclass("android.widget.TextView")(context)
                label.setText(title)
                label.setTextSize(16)
                label.setGravity(19)
                Theme = jclass("org.telegram.ui.ActionBar.Theme")
                label.setTextColor(
                    Theme.getColor(Theme.key_windowBackgroundWhiteBlackText)
                )
                text_params = FrameParams(-1, dp(56), 19)
                text_params.leftMargin, text_params.rightMargin = dp(72), dp(20)
                frame.addView(label, text_params)
                return Custom(
                    view=frame,
                    create_sub_fragment=self._music_settings,
                    link_alias="yandex_music",
                )
            except Exception:
                pass
        return Text(
            text=title, icon="input_mic", create_sub_fragment=self._music_settings
        )

    def _refresh_music_settings(self):
        epoch = self._epoch

        def refresh():
            if self._loaded and self._epoch == epoch:
                revision = self.get_setting("yandex_auth_revision", 0)
                self.set_setting(
                    "yandex_auth_revision", int(revision) + 1, reload_settings=True
                )

        run_on_ui_thread(refresh)

    def _music_settings(self):
        try:
            connected = self._music_store().exists()
        except Exception:
            connected = False
        return [
            Header(text=tr("Яндекс Музыка", "Yandex Music")),
            Text(
                text=tr("Выйти", "Sign out") if connected else tr("Войти", "Sign in"),
                subtext=tr(
                    "Вход сохранён на этом устройстве", "Sign-in saved on this device"
                )
                if connected
                else tr(
                    "Подтвердите код на странице Яндекса",
                    "Confirm a device code on Yandex's website",
                ),
                icon="msg_leave" if connected else "msg_login",
                on_click=(lambda _: self._music_logout())
                if connected
                else (lambda _: self._music_login()),
            ),
            Selector(
                key="yandex_quality_set",
                text=tr("Качество музыки", "Music quality"),
                default=self.get_setting("yandex_quality_set", 2),
                items=[str(b) + tr(" кбит/с", " kbps") for b in MUSIC_BITRATES],
                icon="files_music",
            ),
            Divider(
                text=tr(
                    "Поддерживаются ссылки на треки, альбомы и плейлисты до 50 треков. Доступ к полным записям зависит от аккаунта, подписки и региона. Код входа открывается только на странице Яндекса; пароль плагину не нужен.",
                    "Supports tracks, albums and playlists of up to 50 tracks. Full recordings depend on your account, subscription and region. Sign-in codes are entered on Yandex's website; the plugin does not need your password.",
                )
            ),
        ]

    def _music_login(self):
        try:
            self._enqueue(
                "https://music.yandex.ru/",
                "audio",
                self._context_target(),
                auth_only=True,
            )
        except Exception as error:
            self._notify(error_text(error))

    def _music_logout(self):
        def clear():
            try:
                with self._music_lock:
                    self._music_generation += 1
                    with self._lock:
                        for job in self._jobs.values():
                            if job.auth_only or service_for(job.url) == "yandex_music":
                                job.cancel()
                    self._music_store().clear()
                self._refresh_music_settings()
                self._notify(
                    tr("Вход в Яндекс Музыку удалён", "Yandex Music sign-in removed"),
                    False,
                )
            except Exception:
                self._notify(error_text(DownloadError("music_storage")))

        threading.Thread(
            target=clear, daemon=True, name="DownloaderMusicLogout"
        ).start()

    def _music_authorize(self, job, http, force=False):
        with self._music_lock:
            generation = self._music_generation
            if not force:
                token = self._music_store().load()
                if token:
                    return token
        token = yandex_device_login(job, http, self._progress)
        with self._music_lock:
            job.check()
            with self._lock:
                if (
                    not self._loaded
                    or job.epoch != self._epoch
                    or generation != self._music_generation
                ):
                    raise Cancelled()
                self._music_store().save(token)
        self._refresh_music_settings()
        return token

    def _music_open_code(self, job):
        with job.lock:
            code = job.auth_code
            if (
                job.state != "authorizing"
                or not code
                or job.auth_url != YANDEX_DEVICE_URL
            ):
                return
        context = self._context()
        if context is None:
            return
        try:
            clipboard = context.getSystemService("clipboard")
            clipboard.setPrimaryClip(
                jclass("android.content.ClipData").newPlainText("Yandex", code)
            )
            jclass("org.telegram.messenger.browser.Browser").openUrl(
                context, YANDEX_DEVICE_URL
            )
            self._notify(
                tr(
                    "Код скопирован. Введите его на странице Яндекса",
                    "Code copied. Enter it on Yandex's website",
                ),
                False,
            )
        except Exception:
            self._message(
                tr("Вход в Яндекс", "Yandex sign-in"),
                tr("Откройте %s и введите код %s", "Open %s and enter code %s")
                % (YANDEX_DEVICE_URL, code),
            )

    def _auto_settings(self):
        controls = [
            Header(text=tr("Автозагрузка ссылок", "Automatic link downloads")),
            Switch(
                key="auto_link_set",
                text=tr(
                    "Скачивать вместо отправки ссылки",
                    "Download instead of sending the URL",
                ),
                default=self.get_setting("auto_link_set", False),
                icon="msg_link",
            ),
            Divider(
                text=tr(
                    "Отправьте в чат одну ссылку — плагин заменит её готовым медиа. Действует только для выбранных ниже сайтов. Команда .dl работает и при выключенной автозагрузке.",
                    "Send a single URL in a chat to replace it with downloaded media. Applies to sites selected below. The .dl command also works when automatic downloads are off.",
                )
            ),
            Header(
                text=tr("С каких сайтов скачивать", "Sites to download automatically")
            ),
        ]
        for key, name, _ in SERVICES:
            controls.append(self._service_switch(key, name))
        return controls

    def _online_settings(self):
        return [
            Header(
                text=tr("Если телефон не смог скачать", "When on-device downloads fail")
            ),
            Switch(
                key="auto_fallback_set",
                text=tr(
                    "Пробовать резервные сервисы",
                    "Try fallback services",
                ),
                default=self.get_setting("auto_fallback_set", True),
            ),
            Switch(
                key="tikwm_fallback_set",
                text=tr("Использовать TikWM для TikTok", "Use TikWM for TikTok"),
                default=self.get_setting("tikwm_fallback_set", True),
            ),
            Divider(
                text=tr(
                    "TikWM готов к работе. Остальные сервисы ниже необязательны: добавьте адрес своего сервера, если хотите их использовать. Переключение действует в способе «Автоматически».",
                    "TikWM is ready to use. The services below are optional: enter a server URL if you want to use one. Fallback applies in Automatic mode.",
                )
            ),
            Header(text="Cobalt"),
            Input(
                key="cobalt_url_set",
                text=tr("Адрес API Cobalt", "Cobalt API URL"),
                default=self.get_setting("cobalt_url_set", ""),
                subtext="https://your-cobalt.example",
            ),
            Input(
                key="api_key_set",
                text=tr("API-ключ выбранного Cobalt", "Selected Cobalt API key"),
                default=self.get_setting("api_key_set", ""),
                subtext=tr(
                    "Оставьте пустым, если сервер не требует ключ",
                    "Leave empty if your server does not require a key",
                ),
            ),
            Selector(
                key="audio_bitrate_set",
                text=tr("Качество MP3 через Cobalt", "Cobalt MP3 quality"),
                default=self.get_setting("audio_bitrate_set", 5),
                items=[x + tr(" кбит/с", " kbps") for x in BITRATE],
            ),
            Header(text="YouTube"),
            Input(
                key="invidious_url_set",
                text=tr("Адрес Invidious", "Invidious URL"),
                default=self.get_setting("invidious_url_set", ""),
            ),
            Input(
                key="piped_url_set",
                text=tr("Адрес API Piped", "Piped API URL"),
                default=self.get_setting("piped_url_set", ""),
            ),
            Divider(
                text=tr(
                    "Ключ Cobalt используется только для этого адреса. Случайные серверы из каталогов не перебираются.",
                    "The Cobalt key is used only for that endpoint. Random instance directories are not queried.",
                )
            ),
        ]

    def _proxy_settings(self):
        kind = self.get_setting("proxy_type_set", 0)
        controls = [
            Header(
                text=tr("Подключение плагина к сайтам", "Plugin connection to websites")
            ),
            Selector(
                key="proxy_type_set",
                text=tr("Тип прокси", "Proxy type"),
                default=self.get_setting("proxy_type_set", 0),
                items=[
                    tr("Без прокси", "No proxy"),
                    "HTTP",
                    "HTTPS",
                    "SOCKS5",
                ]
                + (
                    [tr("MTProto · не поддерживается", "MTProto · unsupported")]
                    if kind == 4
                    else []
                ),
                on_change=lambda value: self._setting_changed("proxy_type_set", value),
            ),
        ]
        if kind == 0:
            return controls + [
                Divider(
                    text=tr(
                        "Сайты скачиваются напрямую. Если они недоступны, выберите HTTP, HTTPS или SOCKS5. Прокси Telegram не применяется автоматически.",
                        "Downloads use a direct connection. Choose HTTP, HTTPS or SOCKS5 if websites are blocked. Telegram's proxy is not applied automatically.",
                    )
                )
            ]
        if kind == 4:
            return controls + [
                Divider(
                    text=tr(
                        "MTProto предназначен для Telegram. Выберите другой тип прокси или «Без прокси». Сохранённый адрес не удаляется.",
                        "MTProto is for Telegram. Choose another proxy type or No proxy. Your saved address is kept.",
                    )
                )
            ]
        return controls + [
            Input(
                key="proxy_url_set",
                text=tr("Адрес прокси", "Proxy address"),
                default=self.get_setting("proxy_url_set", ""),
                subtext=tr("Например: 127.0.0.1:1080", "For example: 127.0.0.1:1080"),
            ),
            Input(
                key="proxy_username_set",
                text=tr("Логин · если требуется", "Username · if required"),
                default=self.get_setting("proxy_username_set", ""),
            ),
            Input(
                key="proxy_password_set",
                text=tr("Пароль · если требуется", "Password · if required"),
                default=self.get_setting("proxy_password_set", ""),
            ),
            Divider(
                text=tr(
                    "Прокси применяется только к запросам плагина. При ошибке подключение без него не выполняется. Telegram MTProto не переносит HTTP-трафик сайтов.",
                    "The proxy applies only to this plugin. A failed proxy never falls back to a direct connection. Telegram MTProto does not carry website HTTP traffic.",
                )
            ),
        ]

    def _help(self):
        self._message(
            tr("Как скачать медиа", "Download media"),
            tr(
                "Отправьте в нужный чат:\n.dl https://ссылка\n.dl https://ссылка audio\n\nИли выберите «Скачать по ссылке» в меню чата. В настройках ссылка отправляется в Избранное.\n\n«Скрыть» оставляет загрузку в фоне. Вернуться к ней можно через «Загрузки» в меню или настройках. «Отменить» останавливает скачивание и убирает его временные файлы. После передачи файла загрузкой в Telegram управляет сам клиент.\n\nСайты с входом, платные записи и DRM могут быть недоступны. Записи прямых эфиров скачиваются после их завершения.",
                "Send in the destination chat:\n.dl https://url\n.dl https://url audio\n\nOr choose Download a URL in the chat menu. The settings action uses Saved Messages.\n\nHide keeps the download running. Open Downloads to return to it. Cancel stops the download and removes its temporary files. Telegram manages the upload after handoff.\n\nLogin-only, paid and DRM media may be unavailable. Live-stream recordings can be downloaded after the stream ends.",
            ),
        )

    def _add_menus(self):
        entries = [
            (
                MenuItemType.CHAT_ACTION_MENU,
                "downloader_link",
                tr("Скачать по ссылке", "Download a URL"),
                self._prompt_url,
            ),
            (
                MenuItemType.CHAT_ACTION_MENU,
                "downloader_jobs_chat",
                tr("Загрузки", "Downloads"),
                lambda _: self._show_jobs(),
            ),
            (
                MenuItemType.DRAWER_MENU,
                "downloader_jobs",
                tr("Загрузки медиа", "Media downloads"),
                lambda _: self._show_jobs(),
            ),
            (
                MenuItemType.MESSAGE_CONTEXT_MENU,
                "downloader_message",
                tr("Скачать медиа по ссылке", "Download linked media"),
                self._message_url,
            ),
        ]
        for kind, item_id, text, callback in entries:
            try:
                self.add_menu_item(
                    MenuItemData(
                        menu_type=kind,
                        item_id=item_id,
                        text=text,
                        icon="msg_download",
                        on_click=callback,
                    )
                )
                self._menu_ids.append(item_id)
            except Exception:
                log("[downloader] menu registration failed")

    def _target(self, account, peer=None, params=None):
        instance = jclass("org.telegram.messenger.AccountInstance").getInstance(
            int(account)
        )
        user_id = int(instance.getUserConfig().getClientUserId())
        if not user_id:
            raise DownloadError("account")
        target = Target(int(account), user_id, int(peer or user_id))
        if params is not None:
            fields = {
                "reply": "replyToMsg",
                "top": "replyToTopMsg",
                "notify": "notify",
                "schedule": "scheduleDate",
                "repeat": "scheduleRepeatPeriod",
                "story": "replyToStoryItem",
                "quote": "replyQuote",
                "send_args": "sendMessageChatArguments",
                "effect": "effect_id",
                "invert": "invert_media",
                "stars": "payStars",
                "mono_peer": "monoForumPeer",
                "suggestion": "suggestionParams",
            }
            for field_name, native_name in fields.items():
                value = send_parameter(params, native_name)
                if value is not None:
                    if field_name in ("notify", "invert"):
                        value = send_scalar(value, "boolean")
                    elif field_name in ("schedule", "repeat"):
                        value = send_scalar(value, "int")
                    elif field_name in ("effect", "stars", "mono_peer"):
                        value = send_scalar(value, "long")
                    setattr(target, field_name, value)
        return target

    def _context_target(self, context=None):
        context = context if isinstance(context, dict) else {}
        fragment = context.get("fragment") or get_last_fragment()
        account = context.get("account")
        if account is None:
            account = (
                fragment.getCurrentAccount()
                if fragment
                else jclass("org.telegram.messenger.UserConfig").selectedAccount
            )
        peer = context.get("dialog_id")
        if not peer and fragment and hasattr(fragment, "getDialogId"):
            peer = fragment.getDialogId()
        return self._target(account, peer)

    def on_send_message_hook(self, account, params):
        message = send_parameter(params, "message")
        if not isinstance(message, str):
            return HookResult()
        message = message.strip()
        command = re.match(r"^\.(?:dl|down|up)(?:\s|$)", message, re.I)
        automatic = bool(self.get_setting("auto_link_set", False)) and bool(
            re.fullmatch(r"https?://\S+", message)
        )
        if not command and not automatic:
            return HookResult()
        try:
            if command:
                parts = message.split()
                if len(parts) not in (2, 3):
                    raise DownloadError("invalid_url")
                url, mode = (
                    normalize_url(parts[1]),
                    parts[2].lower() if len(parts) == 3 else "auto",
                )
                if mode not in ("auto", "video", "audio"):
                    raise DownloadError("invalid_mode")
            else:
                url, mode = normalize_url(message), "auto"
                if service_for(url) not in self._auto_services():
                    return HookResult()
            target = self._target(account, send_parameter(params, "peer", 0), params)
            accepted = self._enqueue(url, mode, target)
            return (
                HookResult(strategy=HookStrategy.CANCEL)
                if accepted or command
                else HookResult()
            )
        except Exception as error:
            self._notify(error_text(error))
            return HookResult(strategy=HookStrategy.CANCEL) if command else HookResult()

    def _enqueue(self, url, mode, target, auth_only=False):
        url = normalize_url(url)
        if mode not in ("auto", "video", "audio"):
            raise DownloadError("invalid_mode")
        settings = self._snapshot()
        proxy_url(settings)
        instance = jclass("org.telegram.messenger.AccountInstance").getInstance(
            target.account
        )
        limit = PREMIUM_LIMIT if instance.getUserConfig().isPremium() else FREE_LIMIT
        with self._lock:
            if not self._loaded:
                return False
            self._queue = collections.deque(
                j for j in self._queue if not j.cancel_event.is_set()
            )
            active = [
                j
                for j in self._jobs.values()
                if j.state not in ("done", "failed", "cancelled")
            ]
            if any(
                (j.target.account, j.target.peer, j.url, j.mode, j.auth_only)
                == (target.account, target.peer, url, mode, auth_only)
                for j in active
            ):
                self._notify(
                    tr("Эта ссылка уже загружается", "This URL is already queued"),
                    False,
                )
                return True
            if len(active) >= MAX_QUEUE:
                self._notify(
                    tr(
                        "Очередь заполнена. Дождитесь завершения загрузки",
                        "The queue is full. Wait for a download to finish",
                    )
                )
                return False
            job = DownloadJob(
                url,
                mode,
                target,
                settings,
                limit,
                self._epoch,
                hidden=bool(active),
                auth_only=auth_only,
            )
            self._jobs[job.id] = job
            self._queue.append(job)
            for key in list(self._jobs):
                if len(self._jobs) <= 20:
                    break
                if self._jobs[key].state in ("done", "failed", "cancelled"):
                    self._jobs.pop(key)
            if self._worker is None or not self._worker.is_alive():
                self._worker = threading.Thread(
                    target=self._work, daemon=True, name="MediaDownloader"
                )
                self._worker.start()
        if active:
            self._notify(tr("Добавлено в очередь", "Added to the queue"), False)
        else:
            run_on_ui_thread(lambda: self._show_progress(job))
        return True

    def _work(self):
        while True:
            with self._lock:
                if not self._loaded or not self._queue:
                    self._worker = None
                    return
                job = self._queue.popleft()
            try:
                job.check()
                root = os.path.join(
                    str(
                        jclass("org.telegram.messenger.ApplicationLoader")
                        .getFilesDirFixed()
                        .getAbsolutePath()
                    ),
                    "MediaDownloader3",
                )
                os.makedirs(root, exist_ok=True)
                self._cleanup_incomplete(root)
                job.directory = os.path.join(root, job.id)
                os.makedirs(job.directory, exist_ok=False)
                engine = DownloadEngine(
                    self._progress,
                    lambda j, paths, mode: mux_tracks(j, paths, mode, self._progress),
                    android_javascript,
                    log,
                    register_android_jsc,
                    self._music_authorize,
                )
                if job.auth_only:
                    http = HttpClient(job)
                    try:
                        self._music_authorize(job, http, force=True)
                    finally:
                        http.close()
                else:
                    media = engine.run(job)
                    job.check()
                    self._stage_and_send(job, media)
                self._progress(job, state="done")
            except Cancelled as error:
                job.error = error
                self._progress(job, state="cancelled")
            except Exception as error:
                job.error = (
                    error
                    if isinstance(error, DownloadError)
                    else DownloadError(
                        "disk_full"
                        if isinstance(error, OSError) and error.errno == 28
                        else "unknown",
                        type(error).__name__ + ": " + str(error),
                    )
                )
                self._progress(
                    job, state="cancelled" if job.cancel_event.is_set() else "failed"
                )
                log("[downloader] task ended: " + job.error.code)
            finally:
                job.close_resources()
                if job.directory:
                    shutil.rmtree(job.directory, ignore_errors=True)
                for path in job.staged:
                    if path not in job.handed_off:
                        try:
                            os.remove(path)
                        except OSError:
                            pass
                run_on_ui_thread(lambda j=job: self._finish_ui(j))

    def _cleanup_incomplete(self, root):
        with self._lock:
            active = {
                j.id
                for j in self._jobs.values()
                if j.state not in ("done", "failed", "cancelled")
            }
        for name in os.listdir(root):
            path = os.path.join(root, name)
            if (
                name not in active
                and re.fullmatch(r"[0-9a-f]{32}", name)
                and os.path.isdir(path)
                and not os.path.islink(path)
            ):
                try:
                    if time.time() - os.path.getmtime(path) > 86400:
                        shutil.rmtree(path)
                except OSError:
                    pass

    def _stage_and_send(self, job, media):
        loader = jclass("org.telegram.messenger.FileLoader")
        cache = str(loader.getDirectory(loader.MEDIA_DIR_CACHE).getAbsolutePath())
        staged = []
        for item in media:
            job.check()
            ensure_space(cache, os.path.getsize(item.path))
            ext = os.path.splitext(item.path)[1].lower()
            destination = os.path.join(
                cache, "media_downloader_" + uuid.uuid4().hex + ext
            )
            shutil.move(item.path, destination)
            job.staged.append(destination)
            staged.append(Media(destination, item.kind))
        complete, outcome = threading.Event(), []
        self._progress(job, state="sending")

        def send():
            try:
                if not self._loaded or job.epoch != self._epoch:
                    raise Cancelled()
                with job.lock:
                    job.check()
                    job.send_started = True
                caption = (
                    job.url if job.settings.get("include_source_set", True) else None
                )
                chunks = []
                for item in staged:
                    ext = os.path.splitext(item.path)[1]
                    document = item.kind not in ("photo", "video") or ext not in (
                        ".mp4",
                        ".mov",
                        ".m4v",
                        ".jpg",
                        ".jpeg",
                        ".png",
                        ".webp",
                    )
                    send_kind = (
                        "animation"
                        if ext == ".gif"
                        else "document"
                        if document
                        else "media"
                    )
                    if (
                        not chunks
                        or chunks[-1][0] != send_kind
                        or len(chunks[-1][1]) == 10
                        or send_kind != "media"
                    ):
                        chunks.append((send_kind, []))
                    chunks[-1][1].append(item)
                for index, (send_kind, chunk) in enumerate(chunks):
                    # Telegram owns attempted handoffs; never delete an in-flight upload.
                    job.handed_off.update(item.path for item in chunk)
                    native_send(
                        job.target,
                        chunk,
                        caption if index == 0 else None,
                        send_kind == "document",
                    )
                    job.sent_chunks += 1
                outcome.append(None)
            except Exception as error:
                failure = (
                    error
                    if isinstance(error, DownloadError)
                    else DownloadError("send", str(error))
                )
                if job.sent_chunks:
                    failure = DownloadError(
                        "partial_send", getattr(failure, "detail", "")
                    )
                log("[downloader] handoff: " + failure.code + " " + failure.detail)
                outcome.append(failure)
            finally:
                complete.set()

        run_on_ui_thread(send)
        while not complete.wait(0.2):
            if not job.send_started:
                job.check()
        if outcome[0] is not None:
            raise outcome[0]

    def _progress(self, job, **values):
        with job.lock:
            for key, value in values.items():
                setattr(job, key, value)
        now = time.monotonic()
        if now - self._last_progress > 0.25 or values.get("state") in (
            "done",
            "failed",
            "cancelled",
            "sending",
            "authorizing",
        ):
            self._last_progress = now
            run_on_ui_thread(lambda: self._update_progress(job))

    def _context(self):
        fragment = get_last_fragment()
        return fragment.getParentActivity() if fragment else None

    def _show_progress(self, job):
        if (
            not self._loaded
            or job.epoch != self._epoch
            or job.state in ("done", "failed", "cancelled")
        ):
            return
        context = self._context()
        if context is None:
            job.hidden = True
            return
        if self._dialog_job == job.id and self._dialog is not None:
            self._update_progress(job)
            return
        self._dismiss_progress()
        job.hidden = False
        LinearLayout = jclass("android.widget.LinearLayout")
        TextView = jclass("android.widget.TextView")
        Utilities = jclass("org.telegram.messenger.AndroidUtilities")
        Theme = jclass("org.telegram.ui.ActionBar.Theme")
        content = LinearLayout(context)
        content.setOrientation(1)
        content.setGravity(1)
        content.setPadding(
            Utilities.dp(24), Utilities.dp(12), Utilities.dp(24), Utilities.dp(16)
        )

        def add(view, height=-2, width=-1, top=0, bottom=0):
            layout = LinearLayout.LayoutParams(
                Utilities.dp(width) if width > 0 else width,
                Utilities.dp(height) if height > 0 else height,
            )
            layout.gravity = 1
            layout.topMargin, layout.bottomMargin = (
                Utilities.dp(top),
                Utilities.dp(bottom),
            )
            content.addView(view, layout)

        def label(size, color, bold=False):
            view = TextView(context)
            view.setTextSize(size)
            view.setTextColor(Theme.getColor(color))
            view.setGravity(17)
            view.setIncludeFontPadding(False)
            if bold:
                view.setTypeface(Utilities.bold())
            return view

        try:
            sticker = jclass("org.telegram.ui.Components.StickerImageView")(
                context, job.target.account
            )
            sticker.getImageReceiver().setAutoRepeat(1)
            sticker.setStickerPackName("UtyaDuck")
            sticker.setStickerNum(16)
            sticker.setImportantForAccessibility(2)
            add(sticker, 140, 140, bottom=8)
        except Exception:
            log("[downloader] sticker component unavailable")

        animated = False
        try:
            percent = jclass("org.telegram.ui.Components.AnimatedTextView")(
                context, False, True, True
            )
            percent.setTextSize(float(Utilities.dp(28)))
            percent.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
            percent.setTypeface(Utilities.bold())
            percent.setGravity(17)
            percent.setAnimationProperties(
                0.35,
                0,
                150,
                jclass("org.telegram.ui.Components.CubicBezierInterpolator").EASE_OUT,
            )
            animated = True
        except Exception:
            percent = label(28, Theme.key_dialogTextBlack, True)
        add(percent, 40, bottom=10)
        stage = label(17, Theme.key_dialogTextBlack, True)
        add(stage, bottom=8)
        title = label(14, Theme.key_dialogTextGray2)
        title.setMaxLines(2)
        title.setEllipsize(jclass("android.text.TextUtils$TruncateAt").END)
        add(title, bottom=22)
        progress = jclass("android.widget.ProgressBar")(
            context, None, jclass("android.R$attr").progressBarStyleHorizontal
        )
        progress.setMax(100)
        colors = jclass("android.content.res.ColorStateList")
        accent = Theme.getColor(Theme.key_dialogButton)
        progress.setProgressTintList(colors.valueOf(accent))
        progress.setIndeterminateTintList(colors.valueOf(accent))
        progress.setProgressBackgroundTintList(
            colors.valueOf((accent & 0x00FFFFFF) | 0x22000000)
        )
        add(progress, 6, bottom=14)
        details = label(13, Theme.key_dialogTextGray2)
        add(details, bottom=16)
        auth = label(16, Theme.key_dialogButton, True)
        auth.setPadding(
            Utilities.dp(8), Utilities.dp(14), Utilities.dp(8), Utilities.dp(14)
        )

        plugin = self

        class MusicCodeClick(
            dynamic_proxy(jclass("android.view.View$OnClickListener"))
        ):
            def onClick(self, view):
                plugin._music_open_code(job)

        auth_listener = MusicCodeClick()
        auth.setOnClickListener(auth_listener)
        auth.setVisibility(8)
        add(auth, bottom=12)
        hint = label(12, Theme.key_dialogTextGray2)
        hint.setText(
            tr(
                "Можно скрыть окно — загрузка продолжится",
                "You can hide this window; the download will continue",
            )
        )
        add(hint)
        scroll = jclass("android.widget.ScrollView")(context)
        scroll.addView(content)
        scroll.setVerticalScrollBarEnabled(False)
        builder = AlertDialogBuilder(context)
        builder.set_view(scroll)
        builder.set_positive_button(
            tr("Скрыть", "Hide"), lambda *_: self._hide_progress(job)
        )
        builder.set_negative_button(
            tr("Отменить", "Cancel"), lambda *_: self._cancel_job(job)
        )
        builder.set_on_dismiss_listener(lambda *_: self._on_dismiss(job.id))
        builder.show()
        builder.set_cancelable(False)
        self._dialog, self._dialog_job = builder, job.id
        self._views = {
            "stage": stage,
            "bar": progress,
            "details": details,
            "auth": auth,
            "auth_listener": auth_listener,
            "title": title,
            "percent": percent,
            "animated": animated,
            "last_state": "",
            "last_item": 0,
        }
        self._update_progress(job)
        content.setAlpha(0)
        content.animate().alpha(1).setDuration(180).start()

    def _update_progress(self, job):
        if not self._loaded or self._dialog_job != job.id or self._views is None:
            return
        views = self._views
        stage, bar, details = (views[k] for k in ("stage", "bar", "details"))
        with job.lock:
            stage.setText(state_text(job))
            if views["last_state"] and views["last_state"] != job.state:
                stage.setAlpha(0.4)
                stage.animate().alpha(1).setDuration(180).start()
            views["last_state"] = job.state
            determinate = job.state == "downloading" and job.total > 0
            bar.setIndeterminate(not determinate)
            percent_text = "…"
            if determinate:
                value = min(100, int(job.current * 100 / job.total))
                bar.setProgress(value, views["last_item"] == job.item)
                percent_text = str(value) + "%"
            if views["animated"]:
                views["percent"].setText(percent_text, views["last_item"] == job.item)
            else:
                views["percent"].setText(percent_text)
            views["last_item"] = job.item
            views["title"].setText(
                safe_detail(job.title)[:180]
                or urllib.parse.urlsplit(job.url).hostname
                or ""
            )
            lines = [
                backend_name(
                    job.backend
                    or option(BACKENDS, job.settings.get("backend_set", 0), "auto")
                ),
            ]
            if job.items > 1:
                lines[0] += " · " + tr("Файл %d из %d", "File %d of %d") % (
                    job.item,
                    job.items,
                )
            if job.state == "downloading":
                text = format_bytes(job.current) + (
                    " / " + format_bytes(job.total) if job.total else ""
                )
                if job.speed:
                    text += " · " + format_bytes(job.speed) + tr("/с", "/s")
                    if job.total > job.current:
                        text += " · ~%d " % max(
                            1, int((job.total - job.current) / job.speed)
                        ) + tr("с", "s")
                lines.append(text)
            if job.cancel_event.is_set():
                lines.append(tr("Останавливаем загрузку…", "Stopping download…"))
            if job.state == "authorizing" and job.auth_code:
                lines.append(
                    tr(
                        "Откройте Яндекс и подтвердите код. Скачивание продолжится после входа.",
                        "Open Yandex and confirm the code. The download will resume after sign-in.",
                    )
                )
                views["auth"].setText(
                    tr("Код: %s · Открыть Яндекс", "Code: %s · Open Yandex")
                    % job.auth_code
                )
                views["auth"].setVisibility(0)
            else:
                views["auth"].setVisibility(8)
            details.setText("\n".join(lines))

    def _hide_progress(self, job):
        job.hidden = True
        if self._dialog_job == job.id:
            self._dismiss_progress()

    def _on_dismiss(self, job_id):
        if self._dialog_job == job_id:
            self._dialog, self._dialog_job, self._views = None, "", None

    def _dismiss_progress(self, expected_id=None):
        if expected_id is not None and self._dialog_job != expected_id:
            return
        dialog = self._dialog
        self._dialog, self._dialog_job, self._views = None, "", None
        if dialog is not None:
            try:
                dialog.dismiss()
            except Exception:
                pass

    def _cancel_job(self, job):
        if job.cancel():
            with self._lock:
                if job in self._queue:
                    self._queue.remove(job)
                    job.error, job.state = Cancelled(), "cancelled"
            self._hide_progress(job)
            self._notify(tr("Загрузка отменяется", "Cancelling download"), False)
        else:
            self._hide_progress(job)
            self._notify(
                tr(
                    "Файл уже передан Telegram. Отменить отправку можно в чате",
                    "Telegram already owns the file. Cancel its upload in the chat",
                )
                if job.send_started
                else state_text(job),
                False,
            )

    def _finish_ui(self, job):
        if not self._loaded or job.epoch != self._epoch:
            return
        if self._dialog_job == job.id:
            self._dismiss_progress()
        if job.state == "failed":
            if job.hidden:
                self._notify(error_text(job.error))
            else:
                self._message(
                    tr("Не удалось скачать", "Download failed"),
                    error_text(job.error),
                    self._job_retry_action(job),
                )
        elif job.state == "done":
            self._notify(
                tr("Яндекс Музыка подключена", "Yandex Music connected")
                if job.auth_only
                else tr("Медиа передано Telegram", "Media handed to Telegram"),
                False,
            )
        elif job.state == "cancelled":
            self._notify(tr("Загрузка отменена", "Download cancelled"), False)

    def _show_jobs(self):
        def show():
            context = self._context()
            if context is None:
                return
            with self._lock:
                jobs = list(reversed(self._jobs.values()))
            if not jobs:
                self._message(
                    tr("Загрузки", "Downloads"),
                    tr(
                        "Пока нет загрузок. Используйте .dl ссылка или меню чата.",
                        "No downloads yet. Use .dl URL or the chat menu.",
                    ),
                )
                return
            builder = AlertDialogBuilder(context)
            builder.set_title(tr("Загрузки", "Downloads"))
            builder.set_items(
                [
                    state_text(j)
                    + " · "
                    + (
                        safe_detail(j.title)[:64]
                        or urllib.parse.urlsplit(j.url).hostname
                        or ""
                    )
                    for j in jobs
                ],
                lambda _, index: self._show_job(jobs[index]),
            )
            builder.set_negative_button(tr("Закрыть", "Close"), None)
            builder.show()

        run_on_ui_thread(show)

    def _show_job(self, job):
        if job.state in ("failed", "cancelled"):
            self._message(
                state_text(job),
                error_text(job.error or Cancelled()),
                self._job_retry_action(job),
            )
        elif job.state == "done":
            self._message(
                state_text(job),
                tr(
                    "Теперь отправьте .dl и ссылку на трек, альбом или плейлист.",
                    "Now send .dl followed by a track, album or playlist URL.",
                )
                if job.auth_only
                else tr(
                    "Файлы переданы клиенту для отправки в исходный чат.",
                    "The client received the files for upload to the original chat.",
                ),
            )
        else:
            self._show_progress(job)

    def _job_retry_action(self, job):
        return (
            None
            if job.sent_chunks
            else lambda: self._enqueue(
                job.url, job.mode, job.target, auth_only=job.auth_only
            )
        )

    def _prompt_url(self, context=None, initial=""):
        try:
            target = self._context_target(context)
        except Exception as error:
            self._notify(error_text(error))
            return

        def show():
            activity = self._context()
            if activity is None:
                return
            field = jclass("android.widget.EditText")(activity)
            field.setSingleLine(True)
            field.setHint("https://…")
            field.setInputType(17)
            field.setText(initial)
            builder = AlertDialogBuilder(activity)
            builder.set_title(tr("Скачать по ссылке", "Download a URL"))
            builder.set_message(
                tr(
                    "В Избранное" if target.peer == target.user_id else "В этот чат",
                    "To Saved Messages"
                    if target.peer == target.user_id
                    else "To this chat",
                )
            )
            builder.set_view(field)

            def start(*_):
                try:
                    self._enqueue(str(field.getText()), "auto", target)
                except Exception as error:
                    self._notify(error_text(error))

            builder.set_positive_button(tr("Скачать", "Download"), start)
            builder.set_negative_button(tr("Отмена", "Cancel"), None)
            builder.show()

        run_on_ui_thread(show)

    def _message_url(self, context):
        message = context.get("message") if isinstance(context, dict) else None
        text = str(getattr(message, "messageText", "") or "")
        matches = re.findall(r"https?://[^\s<>]+", text)
        if not matches:
            self._notify(tr("В этом сообщении нет ссылки", "This message has no URL"))
            return
        self._prompt_url(context, matches[0].rstrip(".,!;"))

    def _message(self, title, message, retry=None):
        epoch = self._epoch

        def show():
            if not self._loaded or self._epoch != epoch:
                return
            context = self._context()
            if context is None:
                self._notify(message)
                return
            builder = AlertDialogBuilder(context)
            builder.set_title(title)
            builder.set_message(message)
            if retry is not None:
                builder.set_positive_button(
                    tr("Повторить", "Retry"), lambda *_: self._retry(retry)
                )
                builder.set_negative_button(tr("Закрыть", "Close"), None)
            else:
                builder.set_positive_button("OK", None)
            builder.show()

        run_on_ui_thread(show)

    def _retry(self, action):
        try:
            action()
        except Exception as error:
            self._notify(error_text(error))

    def _notify(self, text, error=True):
        epoch = self._epoch

        def show():
            if self._loaded and self._epoch == epoch:
                (BulletinHelper.show_error if error else BulletinHelper.show_info)(
                    str(text)
                )

        run_on_ui_thread(show)
