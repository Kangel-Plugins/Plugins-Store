def error_text(error):
    result = tr(*ERRORS.get(getattr(error, "code", "unknown"), ERRORS["unknown"]))
    detail = safe_detail(getattr(error, "detail", ""))
    return result + ("\n" + detail if detail else "")


def state_text(job):
    states = {
        "queued": ("В очереди", "Queued"),
        "resolving": ("Получение ссылки на медиа…", "Resolving media…"),
        "authorizing": ("Ожидание входа в Яндекс…", "Waiting for Yandex sign-in…"),
        "downloading": ("Скачивание…", "Downloading…"),
        "processing": ("Объединение дорожек…", "Combining tracks…"),
        "sending": ("Передача в Telegram…", "Handing to Telegram…"),
        "done": ("Передано в Telegram", "Handed to Telegram"),
        "failed": ("Ошибка загрузки", "Download failed"),
        "cancelled": ("Отменено", "Cancelled"),
    }
    if job.auth_only and job.state == "done":
        return tr("Яндекс Музыка подключена", "Yandex Music connected")
    return tr(*states.get(job.state, states["queued"]))


