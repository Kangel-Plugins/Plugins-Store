    def _proxy_settings(self):
        kind = self.get_setting("proxy_type_set", 0)
        controls = [
            Header(text=tr("Подключение плагина к сайтам", "Plugin connection to websites")),
            Selector(
                key="proxy_type_set",
                text=tr("Тип прокси", "Proxy type"),
                default=self.get_setting("proxy_type_set", 0),
                items=[
                    tr("Без прокси", "No proxy"),
                    "HTTP",
                    "HTTPS",
                    "SOCKS5",
                ]
                + ([tr("MTProto · не поддерживается", "MTProto · unsupported")] if kind == 4 else []),
                on_change=lambda value: self._setting_changed("proxy_type_set", value),
            ),
        ]
        if kind == 0:
            return controls + [
                Divider(
                    text=tr(
                        "Сайты скачиваются напрямую. Если они недоступны, выберите HTTP, HTTPS или SOCKS5. Прокси Telegram не применяется автоматически.",
                        "Downloads use a direct connection. Choose HTTP, HTTPS or SOCKS5 if websites are blocked. Telegram's proxy is not applied automatically.",
                    )
                )
            ]
        if kind == 4:
            return controls + [
                Divider(
                    text=tr(
                        "MTProto предназначен для Telegram. Выберите другой тип прокси или «Без прокси». Сохранённый адрес не удаляется.",
                        "MTProto is for Telegram. Choose another proxy type or No proxy. Your saved address is kept.",
                    )
                )
            ]
        return controls + [
            Input(
                key="proxy_url_set",
                text=tr("Адрес прокси", "Proxy address"),
                default=self.get_setting("proxy_url_set", ""),
                subtext=tr("Например: 127.0.0.1:1080", "For example: 127.0.0.1:1080"),
            ),
            Input(
                key="proxy_username_set",
                text=tr("Логин · если требуется", "Username · if required"),
                default=self.get_setting("proxy_username_set", ""),
            ),
            Input(
                key="proxy_password_set",
                text=tr("Пароль · если требуется", "Password · if required"),
                default=self.get_setting("proxy_password_set", ""),
            ),
            Divider(
                text=tr(
                    "Прокси применяется только к запросам плагина. При ошибке подключение без него не выполняется. Telegram MTProto не переносит HTTP-трафик сайтов.",
                    "The proxy applies only to this plugin. A failed proxy never falls back to a direct connection. Telegram MTProto does not carry website HTTP traffic.",
                )
            ),
        ]

    def _help(self):
        self._message(
            tr("Как скачать медиа", "Download media"),
            tr(
                "Отправьте в нужный чат:\n.dl https://ссылка\n.dl https://ссылка audio\n\nИли выберите «Скачать по ссылке» в меню чата. В настройках ссылка отправляется в Избранное.\n\n«Скрыть» оставляет загрузку в фоне. Вернуться к ней можно через «Загрузки» в меню или настройках. «Отменить» останавливает скачивание и убирает его временные файлы. После передачи файла загрузкой в Telegram управляет сам клиент.\n\nСайты с входом, платные записи и DRM могут быть недоступны. Записи прямых эфиров скачиваются после их завершения.",
                "Send in the destination chat:\n.dl https://url\n.dl https://url audio\n\nOr choose Download a URL in the chat menu. The settings action uses Saved Messages.\n\nHide keeps the download running. Open Downloads to return to it. Cancel stops the download and removes its temporary files. Telegram manages the upload after handoff.\n\nLogin-only, paid and DRM media may be unavailable. Live-stream recordings can be downloaded after the stream ends.",
            ),
        )

    def _add_menus(self):
        entries = [
            (
                MenuItemType.CHAT_ACTION_MENU,
                "downloader_link",
                tr("Скачать по ссылке", "Download a URL"),
                self._prompt_url,
            ),
            (
                MenuItemType.CHAT_ACTION_MENU,
                "downloader_jobs_chat",
                tr("Загрузки", "Downloads"),
                lambda _: self._show_jobs(),
            ),
            (
                MenuItemType.DRAWER_MENU,
                "downloader_jobs",
                tr("Загрузки медиа", "Media downloads"),
                lambda _: self._show_jobs(),
            ),
            (
                MenuItemType.MESSAGE_CONTEXT_MENU,
                "downloader_message",
                tr("Скачать медиа по ссылке", "Download linked media"),
                self._message_url,
            ),
        ]
        for kind, item_id, text, callback in entries:
            try:
                self.add_menu_item(
                    MenuItemData(
                        menu_type=kind, item_id=item_id, text=text, icon="msg_download", on_click=callback
                    )
                )
                self._menu_ids.append(item_id)
            except Exception:
                log("[downloader] menu registration failed")

    def _target(self, account, peer=None, params=None):
        instance = jclass("org.telegram.messenger.AccountInstance").getInstance(int(account))
        user_id = int(instance.getUserConfig().getClientUserId())
        if not user_id:
            raise DownloadError("account")
        target = Target(int(account), user_id, int(peer or user_id))
        if params is not None:
            fields = {
                "reply": "replyToMsg",
                "top": "replyToTopMsg",
                "notify": "notify",
                "schedule": "scheduleDate",
                "repeat": "scheduleRepeatPeriod",
                "story": "replyToStoryItem",
                "quote": "replyQuote",
                "send_args": "sendMessageChatArguments",
                "effect": "effect_id",
                "invert": "invert_media",
                "stars": "payStars",
                "mono_peer": "monoForumPeer",
                "suggestion": "suggestionParams",
            }
            for field_name, native_name in fields.items():
                value = getattr(params, native_name, None)
                if value is not None:
                    setattr(target, field_name, value)
        return target

    def _context_target(self, context=None):
        context = context if isinstance(context, dict) else {}
        fragment = context.get("fragment") or get_last_fragment()
        account = context.get("account")
        if account is None:
            account = (
                fragment.getCurrentAccount()
                if fragment
                else jclass("org.telegram.messenger.UserConfig").selectedAccount
            )
        peer = context.get("dialog_id")
        if not peer and fragment and hasattr(fragment, "getDialogId"):
            peer = fragment.getDialogId()
        return self._target(account, peer)

    def on_send_message_hook(self, account, params):
        message = getattr(params, "message", None)
        if not isinstance(message, str):
            return HookResult()
        message = message.strip()
        command = re.match(r"^\.(?:dl|down|up)(?:\s|$)", message, re.I)
        automatic = bool(self.get_setting("auto_link_set", False)) and bool(
            re.fullmatch(r"https?://\S+", message)
        )
        if not command and not automatic:
            return HookResult()
        try:
            if command:
                parts = message.split()
                if len(parts) not in (2, 3):
                    raise DownloadError("invalid_url")
                url, mode = normalize_url(parts[1]), parts[2].lower() if len(parts) == 3 else "auto"
                if mode not in ("auto", "video", "audio"):
                    raise DownloadError("invalid_mode")
            else:
                url, mode = normalize_url(message), "auto"
                if service_for(url) not in self._auto_services():
                    return HookResult()
            target = self._target(account, getattr(params, "peer", 0), params)
            accepted = self._enqueue(url, mode, target)
            return HookResult(strategy=HookStrategy.CANCEL) if accepted or command else HookResult()
        except Exception as error:
            self._notify(error_text(error))
            return HookResult(strategy=HookStrategy.CANCEL) if command else HookResult()

    def _enqueue(self, url, mode, target):
        url = normalize_url(url)
        if mode not in ("auto", "video", "audio"):
            raise DownloadError("invalid_mode")
        settings = self._snapshot()
        proxy_url(settings)
        instance = jclass("org.telegram.messenger.AccountInstance").getInstance(target.account)
        limit = PREMIUM_LIMIT if instance.getUserConfig().isPremium() else FREE_LIMIT
        with self._lock:
            if not self._loaded:
                return False
            self._queue = collections.deque(j for j in self._queue if not j.cancel_event.is_set())
            active = [j for j in self._jobs.values() if j.state not in ("done", "failed", "cancelled")]
            if any(
                (j.target.account, j.target.peer, j.url, j.mode) == (target.account, target.peer, url, mode)
                for j in active
            ):
                self._notify(tr("Эта ссылка уже загружается", "This URL is already queued"), False)
                return True
            if len(active) >= MAX_QUEUE:
                self._notify(
                    tr(
                        "Очередь заполнена. Дождитесь завершения загрузки",
                        "The queue is full. Wait for a download to finish",
                    )
                )
                return False
            job = DownloadJob(url, mode, target, settings, limit, self._epoch, hidden=bool(active))
            self._jobs[job.id] = job
            self._queue.append(job)
            for key in list(self._jobs):
                if len(self._jobs) <= 20:
                    break
                if self._jobs[key].state in ("done", "failed", "cancelled"):
                    self._jobs.pop(key)
            if self._worker is None or not self._worker.is_alive():
                self._worker = threading.Thread(target=self._work, daemon=True, name="MediaDownloader")
                self._worker.start()
        if active:
            self._notify(tr("Добавлено в очередь", "Added to the queue"), False)
        else:
            run_on_ui_thread(lambda: self._show_progress(job))
        return True

    def _work(self):
        while True:
            with self._lock:
                if not self._loaded or not self._queue:
                    self._worker = None
                    return
                job = self._queue.popleft()
            try:
                job.check()
                root = os.path.join(
                    str(
                        jclass("org.telegram.messenger.ApplicationLoader")
                        .getFilesDirFixed()
                        .getAbsolutePath()
                    ),
                    "MediaDownloader3",
                )
                os.makedirs(root, exist_ok=True)
                self._cleanup_incomplete(root)
                job.directory = os.path.join(root, job.id)
                os.makedirs(job.directory, exist_ok=False)
                engine = DownloadEngine(
                    self._progress,
                    lambda j, paths, mode: mux_tracks(j, paths, mode, self._progress),
                    android_javascript,
                    log,
                    register_android_jsc,
                )
                media = engine.run(job)
                job.check()
                self._stage_and_send(job, media)
                self._progress(job, state="done")
            except Cancelled as error:
                job.error = error
                self._progress(job, state="cancelled")
            except Exception as error:
                job.error = (
                    error
                    if isinstance(error, DownloadError)
                    else DownloadError(
                        "disk_full" if isinstance(error, OSError) and error.errno == 28 else "unknown",
                        type(error).__name__ + ": " + str(error),
                    )
                )
                self._progress(job, state="cancelled" if job.cancel_event.is_set() else "failed")
                log("[downloader] task ended: " + job.error.code)
            finally:
                job.close_resources()
                if job.directory:
                    shutil.rmtree(job.directory, ignore_errors=True)
                for path in job.staged:
                    if path not in job.handed_off:
                        try:
                            os.remove(path)
                        except OSError:
                            pass
                run_on_ui_thread(lambda j=job: self._finish_ui(j))

    def _cleanup_incomplete(self, root):
        with self._lock:
            active = {j.id for j in self._jobs.values() if j.state not in ("done", "failed", "cancelled")}
        for name in os.listdir(root):
            path = os.path.join(root, name)
            if (
                name not in active
                and re.fullmatch(r"[0-9a-f]{32}", name)
                and os.path.isdir(path)
                and not os.path.islink(path)
            ):
                try:
                    if time.time() - os.path.getmtime(path) > 86400:
                        shutil.rmtree(path)
                except OSError:
                    pass

    def _stage_and_send(self, job, media):
        loader = jclass("org.telegram.messenger.FileLoader")
        cache = str(loader.getDirectory(loader.MEDIA_DIR_CACHE).getAbsolutePath())
        staged = []
        for item in media:
            job.check()
            ensure_space(cache, os.path.getsize(item.path))
            ext = os.path.splitext(item.path)[1].lower()
            destination = os.path.join(cache, "media_downloader_" + uuid.uuid4().hex + ext)
            shutil.move(item.path, destination)
            job.staged.append(destination)
            staged.append(Media(destination, item.kind))
        complete, outcome = threading.Event(), []
        self._progress(job, state="sending")

        def send():
            try:
                if not self._loaded or job.epoch != self._epoch:
                    raise Cancelled()
                with job.lock:
                    job.check()
                    job.send_started = True
                caption = job.url if job.settings.get("include_source_set", True) else None
                chunks = []
                for item in staged:
                    document = item.kind not in ("photo", "video") or os.path.splitext(item.path)[1] not in (
                        ".mp4",
                        ".mov",
                        ".m4v",
                        ".jpg",
                        ".jpeg",
                        ".png",
                        ".webp",
                    )
                    if not chunks or chunks[-1][0] != document or len(chunks[-1][1]) == 10 or document:
                        chunks.append((document, []))
                    chunks[-1][1].append(item)
                for index, (document, chunk) in enumerate(chunks):
                    # Telegram owns attempted handoffs; never delete an in-flight upload.
                    job.handed_off.update(item.path for item in chunk)
                    native_send(job.target, chunk, caption if index == 0 else None, document)
                outcome.append(None)
            except Exception as error:
                failure = error if isinstance(error, DownloadError) else DownloadError("send", str(error))
                log("[downloader] handoff: " + failure.code + " " + failure.detail)
                outcome.append(failure)
            finally:
                complete.set()

        run_on_ui_thread(send)
        while not complete.wait(0.2):
            if not job.send_started:
                job.check()
        if outcome[0] is not None:
            raise outcome[0]

    def _progress(self, job, **values):
        with job.lock:
            for key, value in values.items():
                setattr(job, key, value)
        now = time.monotonic()
        if now - self._last_progress > 0.25 or values.get("state") in (
            "done",
            "failed",
            "cancelled",
            "sending",
        ):
            self._last_progress = now
            run_on_ui_thread(lambda: self._update_progress(job))

    def _context(self):
        fragment = get_last_fragment()
        return fragment.getParentActivity() if fragment else None

    def _show_progress(self, job):
        if not self._loaded or job.epoch != self._epoch or job.state in ("done", "failed", "cancelled"):
            return
        context = self._context()
        if context is None:
            job.hidden = True
            return
        if self._dialog_job == job.id and self._dialog is not None:
            self._update_progress(job)
            return
        self._dismiss_progress()
        job.hidden = False
        LinearLayout = jclass("android.widget.LinearLayout")
        TextView = jclass("android.widget.TextView")
        Utilities = jclass("org.telegram.messenger.AndroidUtilities")
        Theme = jclass("org.telegram.ui.ActionBar.Theme")
        content = LinearLayout(context)
        content.setOrientation(1)
        content.setGravity(1)
        content.setPadding(Utilities.dp(24), Utilities.dp(12), Utilities.dp(24), Utilities.dp(16))

        def add(view, height=-2, width=-1, top=0, bottom=0):
            layout = LinearLayout.LayoutParams(
                Utilities.dp(width) if width > 0 else width, Utilities.dp(height) if height > 0 else height
            )
            layout.gravity = 1
            layout.topMargin, layout.bottomMargin = Utilities.dp(top), Utilities.dp(bottom)
            content.addView(view, layout)

        def label(size, color, bold=False):
            view = TextView(context)
            view.setTextSize(size)
            view.setTextColor(Theme.getColor(color))
            view.setGravity(17)
            view.setIncludeFontPadding(False)
            if bold:
                view.setTypeface(Utilities.bold())
            return view

        try:
            sticker = jclass("org.telegram.ui.Components.StickerImageView")(context, job.target.account)
            sticker.getImageReceiver().setAutoRepeat(1)
            sticker.setStickerPackName("UtyaDuck")
            sticker.setStickerNum(16)
            sticker.setImportantForAccessibility(2)
            add(sticker, 140, 140, bottom=8)
        except Exception:
            log("[downloader] sticker component unavailable")

        animated = False
        try:
            percent = jclass("org.telegram.ui.Components.AnimatedTextView")(context, False, True, True)
            percent.setTextSize(float(Utilities.dp(28)))
            percent.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
            percent.setTypeface(Utilities.bold())
            percent.setGravity(17)
            percent.setAnimationProperties(
                0.35, 0, 150, jclass("org.telegram.ui.Components.CubicBezierInterpolator").EASE_OUT
            )
            animated = True
        except Exception:
            percent = label(28, Theme.key_dialogTextBlack, True)
        add(percent, 40, bottom=10)
        stage = label(17, Theme.key_dialogTextBlack, True)
        add(stage, bottom=8)
        title = label(14, Theme.key_dialogTextGray2)
        title.setMaxLines(2)
        title.setEllipsize(jclass("android.text.TextUtils$TruncateAt").END)
        add(title, bottom=22)
        progress = jclass("android.widget.ProgressBar")(
            context, None, jclass("android.R$attr").progressBarStyleHorizontal
        )
        progress.setMax(100)
        colors = jclass("android.content.res.ColorStateList")
        accent = Theme.getColor(Theme.key_dialogButton)
        progress.setProgressTintList(colors.valueOf(accent))
        progress.setIndeterminateTintList(colors.valueOf(accent))
        progress.setProgressBackgroundTintList(colors.valueOf((accent & 0x00FFFFFF) | 0x22000000))
        add(progress, 6, bottom=14)
        details = label(13, Theme.key_dialogTextGray2)
        add(details, bottom=16)
        hint = label(12, Theme.key_dialogTextGray2)
        hint.setText(
            tr(
                "Можно скрыть окно — загрузка продолжится",
                "You can hide this window; the download will continue",
            )
        )
        add(hint)
        scroll = jclass("android.widget.ScrollView")(context)
        scroll.addView(content)
        scroll.setVerticalScrollBarEnabled(False)
        builder = AlertDialogBuilder(context)
        builder.set_view(scroll)
        builder.set_positive_button(tr("Скрыть", "Hide"), lambda *_: self._hide_progress(job))
        builder.set_negative_button(tr("Отменить", "Cancel"), lambda *_: self._cancel_job(job))
        builder.set_on_dismiss_listener(lambda *_: self._on_dismiss(job.id))
        builder.show()
        builder.set_cancelable(False)
        self._dialog, self._dialog_job = builder, job.id
        self._views = {
            "stage": stage,
            "bar": progress,
            "details": details,
            "title": title,
            "percent": percent,
            "animated": animated,
            "last_state": "",
            "last_item": 0,
        }
        self._update_progress(job)
        content.setAlpha(0)
        content.animate().alpha(1).setDuration(180).start()

    def _update_progress(self, job):
        if not self._loaded or self._dialog_job != job.id or self._views is None:
            return
        views = self._views
        stage, bar, details = (views[k] for k in ("stage", "bar", "details"))
        with job.lock:
            stage.setText(state_text(job))
            if views["last_state"] and views["last_state"] != job.state:
                stage.setAlpha(0.4)
                stage.animate().alpha(1).setDuration(180).start()
            views["last_state"] = job.state
            determinate = job.state == "downloading" and job.total > 0
            bar.setIndeterminate(not determinate)
            percent_text = "…"
            if determinate:
                value = min(100, int(job.current * 100 / job.total))
                bar.setProgress(value, views["last_item"] == job.item)
                percent_text = str(value) + "%"
            if views["animated"]:
                views["percent"].setText(percent_text, views["last_item"] == job.item)
            else:
                views["percent"].setText(percent_text)
            views["last_item"] = job.item
            views["title"].setText(
                safe_detail(job.title)[:180] or urllib.parse.urlsplit(job.url).hostname or ""
            )
            lines = [
                backend_name(job.backend or option(BACKENDS, job.settings.get("backend_set", 0), "auto")),
            ]
            if job.items > 1:
                lines[0] += " · " + tr("Файл %d из %d", "File %d of %d") % (job.item, job.items)
            if job.state == "downloading":
                text = format_bytes(job.current) + (" / " + format_bytes(job.total) if job.total else "")
                if job.speed:
                    text += " · " + format_bytes(job.speed) + tr("/с", "/s")
                    if job.total > job.current:
                        text += " · ~%d " % max(1, int((job.total - job.current) / job.speed)) + tr("с", "s")
                lines.append(text)
            if job.cancel_event.is_set():
                lines.append(tr("Останавливаем загрузку…", "Stopping download…"))
            details.setText("\n".join(lines))

    def _hide_progress(self, job):
        job.hidden = True
        if self._dialog_job == job.id:
            self._dismiss_progress()

    def _on_dismiss(self, job_id):
        if self._dialog_job == job_id:
            self._dialog, self._dialog_job, self._views = None, "", None

    def _dismiss_progress(self, expected_id=None):
        if expected_id is not None and self._dialog_job != expected_id:
            return
        dialog = self._dialog
        self._dialog, self._dialog_job, self._views = None, "", None
        if dialog is not None:
            try:
                dialog.dismiss()
            except Exception:
                pass

    def _cancel_job(self, job):
        if job.cancel():
            with self._lock:
                if job in self._queue:
                    self._queue.remove(job)
                    job.error, job.state = Cancelled(), "cancelled"
            self._hide_progress(job)
            self._notify(tr("Загрузка отменяется", "Cancelling download"), False)
        else:
            self._hide_progress(job)
            self._notify(
                tr(
                    "Файл уже передан Telegram. Отменить отправку можно в чате",
                    "Telegram already owns the file. Cancel its upload in the chat",
                )
                if job.send_started
                else state_text(job),
                False,
            )

    def _finish_ui(self, job):
        if not self._loaded or job.epoch != self._epoch:
            return
        if self._dialog_job == job.id:
            self._dismiss_progress()
        if job.state == "failed":
            if job.hidden:
                self._notify(error_text(job.error))
            else:
                self._message(
                    tr("Не удалось скачать", "Download failed"),
                    error_text(job.error),
                    lambda: self._enqueue(job.url, job.mode, job.target),
                )
        elif job.state == "done":
            self._notify(tr("Медиа передано Telegram", "Media handed to Telegram"), False)
        elif job.state == "cancelled":
            self._notify(tr("Загрузка отменена", "Download cancelled"), False)

    def _show_jobs(self):
        def show():
            context = self._context()
            if context is None:
                return
            with self._lock:
                jobs = list(reversed(self._jobs.values()))
            if not jobs:
                self._message(
                    tr("Загрузки", "Downloads"),
                    tr(
                        "Пока нет загрузок. Используйте .dl ссылка или меню чата.",
                        "No downloads yet. Use .dl URL or the chat menu.",
                    ),
                )
                return
            builder = AlertDialogBuilder(context)
            builder.set_title(tr("Загрузки", "Downloads"))
            builder.set_items(
                [
                    state_text(j)
                    + " · "
                    + (safe_detail(j.title)[:64] or urllib.parse.urlsplit(j.url).hostname or "")
                    for j in jobs
                ],
                lambda _, index: self._show_job(jobs[index]),
            )
            builder.set_negative_button(tr("Закрыть", "Close"), None)
            builder.show()

        run_on_ui_thread(show)

    def _show_job(self, job):
        if job.state in ("failed", "cancelled"):
            self._message(
                state_text(job),
                error_text(job.error or Cancelled()),
                lambda: self._enqueue(job.url, job.mode, job.target),
            )
        elif job.state == "done":
            self._message(
                state_text(job),
                tr(
                    "Файлы переданы клиенту для отправки в исходный чат.",
                    "The client received the files for upload to the original chat.",
                ),
            )
        else:
            self._show_progress(job)

    def _prompt_url(self, context=None, initial=""):
        try:
            target = self._context_target(context)
        except Exception as error:
            self._notify(error_text(error))
            return

        def show():
            activity = self._context()
            if activity is None:
                return
            field = jclass("android.widget.EditText")(activity)
            field.setSingleLine(True)
            field.setHint("https://…")
            field.setInputType(17)
            field.setText(initial)
            builder = AlertDialogBuilder(activity)
            builder.set_title(tr("Скачать по ссылке", "Download a URL"))
            builder.set_message(
                tr(
                    "В Избранное" if target.peer == target.user_id else "В этот чат",
                    "To Saved Messages" if target.peer == target.user_id else "To this chat",
                )
            )
            builder.set_view(field)

            def start(*_):
                try:
                    self._enqueue(str(field.getText()), "auto", target)
                except Exception as error:
                    self._notify(error_text(error))

            builder.set_positive_button(tr("Скачать", "Download"), start)
            builder.set_negative_button(tr("Отмена", "Cancel"), None)
            builder.show()

        run_on_ui_thread(show)

    def _message_url(self, context):
        message = context.get("message") if isinstance(context, dict) else None
        text = str(getattr(message, "messageText", "") or "")
        matches = re.findall(r"https?://[^\s<>]+", text)
        if not matches:
            self._notify(tr("В этом сообщении нет ссылки", "This message has no URL"))
            return
        self._prompt_url(context, matches[0].rstrip(".,!;"))

    def _message(self, title, message, retry=None):
        epoch = self._epoch

        def show():
            if not self._loaded or self._epoch != epoch:
                return
            context = self._context()
            if context is None:
                self._notify(message)
                return
            builder = AlertDialogBuilder(context)
            builder.set_title(title)
            builder.set_message(message)
            if retry is not None:
                builder.set_positive_button(tr("Повторить", "Retry"), lambda *_: self._retry(retry))
                builder.set_negative_button(tr("Закрыть", "Close"), None)
            else:
                builder.set_positive_button("OK", None)
            builder.show()

        run_on_ui_thread(show)

    def _retry(self, action):
        try:
            action()
        except Exception as error:
            self._notify(error_text(error))

    def _notify(self, text, error=True):
        epoch = self._epoch

        def show():
            if self._loaded and self._epoch == epoch:
                (BulletinHelper.show_error if error else BulletinHelper.show_info)(str(text))

        run_on_ui_thread(show)
