def _client_lang():
    try:
        lc = find_class("org.telegram.messenger.LocaleController")
        if lc is not None:
            loc = lc.getInstance().getCurrentLocale()
            if loc is not None:
                lang = str(loc.getLanguage() or "")
                if lang:
                    return lang.lower()
    except Exception:
        pass
    try:
        return str(Locale.getDefault().getLanguage() or "en").lower()
    except Exception:
        return "en"


def _texts():
    lang = _client_lang()
    base = dict(_TEXT["en"])
    if lang.startswith("ru"):
        base.update(_TEXT["ru"])
    return base


class IOSProfileV2Plugin(BasePlugin):
    def _sync_description(self):
        try:
            pc = find_class("com.exteragram.messenger.plugins.PluginsController")
            if pc is not None:
                plg = pc.getInstance().getPlugins().get(__id__)
                if plg is not None:
                    plg.setDescription(__description__ if _client_lang().startswith("ru") else _DESC_EN)
        except Exception:
            pass

    def on_plugin_load(self):
        self._sync_description()
        if not _engine.start(self):
            _log("Profile V2 DEX engine could not start; stock profile remains")

    def on_plugin_unload(self):
        _engine.unload()

    def _on_change(self, key):
        def _callback(new_value):
            try:
                _engine.push_settings(self, {key: new_value})
            except Exception as e:
                _log("setting update failed", e)
        return _callback

    def _make_switch(self, t, key, default=True):
        title, sub = t[key]
        val = bool(self.get_setting(key, default))
        cb = self._on_change(key)
        try:
            return Switch(key=key, text=title, default=val, subtext=sub, on_change=cb)
        except Exception:
            try:
                return Switch(key=key, text=title, default=val, on_change=cb)
            except Exception:
                return Switch(key=key, text=title, default=val)

    def _make_selector(self, t, key, items_key, default=0):
        cb = self._on_change(key)
        val = _int(self.get_setting(key, default), default)
        try:
            return Selector(
                key=key,
                text=t[key],
                items=t[items_key],
                default=val,
                on_change=cb,
            )
        except Exception:
            return Selector(
                key=key,
                text=t[key],
                items=t[items_key],
                default=val,
            )

    def _create_fine_tuning_settings(self):
        t = _texts()
        sw = lambda key, default=True: self._make_switch(t, key, default)
        sel = lambda key, items_key, default=0: self._make_selector(t, key, items_key, default)
        return [
            Header(text=t["sub_music"]),
            sel("beat_jump_strength", "beat_jumps", 2),
            sel("beat_sensitivity", "beat_sens_items", 1),
            sel("beat_sync_offset", "beat_off_items", 0),
            sel("avatar_pulse_strength", "av_pulses", 2),
            sw("system_music_fallback", True),
            Divider(),
            Header(text=t["sub_gifts"]),
            sel("bubble_size", "bub_sizes", 1),
            sel("bubble_orbit_radius", "orb_rads", 1),
            sel("bubble_orbit_speed", "orb_spds", 1),
            sel("bubble_stretch_strength", "stretches", 2),
            sel("bubble_bounce_strength", "bounces", 1),
            sel("avatar_rim_mode", "av_rims", 0),
            sel("avatar_rim_color", "av_rim_cols", 0),
            sw("gift_real_patterns", True),
            sw("interactive_bubbles", True),
            Divider(),
            Header(text=t["sub_ui"]),
            sel("header_align_mode", "hdr_aligns", 0),
            sel("glass_intensity", "intensities", 0),
            sel("rim_style", "rims", 0),
            sw("gpu_liquid_glass", True),
            sw("glass_nav_pills", True),
            sw("lowercase_labels", True),
            sw("liquid_press_swell", True),
            sw("seamless_expanded_fade", True),
            sw("center_expanded_title", True),
        ]

    def create_settings(self):
        _engine.push_settings(self)
        t = _texts()
        sw = lambda key, default=True: self._make_switch(t, key, default)
        sel = lambda key, items_key, default=0: self._make_selector(t, key, items_key, default)

        ft_title, ft_sub = t["fine_tuning"]
        try:
            fine_row = Text(
                text=ft_title,
                subtext=ft_sub,
                icon="msg_settings",
                create_sub_fragment=self._create_fine_tuning_settings,
            )
        except Exception:
            try:
                fine_row = Text(
                    text=ft_title,
                    icon="msg_settings",
                    create_sub_fragment=self._create_fine_tuning_settings,
                )
            except Exception:
                fine_row = Text(
                    text=ft_title,
                    create_sub_fragment=self._create_fine_tuning_settings,
                )

        return [
            Header(text=t["sec_main"]),
            sw("enabled", True),
            sw("adaptive_avatar_color", True),
            sel("palette_style", "palettes", 0),
            Divider(),
            Header(text=t["sec_glass"]),
            sel("ui_style", "ui_styles", 0),
            sw("circular_action_buttons", True),
            sw("liquid_glass", True),
            sw("glass_cards", True),
            sw("beta_glass_header", False),
            Divider(),
            Header(text=t["sec_motion"]),
            sw("floating_gift_bubbles", True),
            sw("dancing_music_sync", True),
            Divider(),
            fine_row,
            Divider(text=t["about"] % __version__),
        ]


