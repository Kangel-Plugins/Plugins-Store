__id__ = "advanced_search"
__name__ = "Продвинутый поиск"
__description__ = "Продвинутый поиск по чатам, документам с фильтрами по дате, юзеру, типу медиа"
__author__ = "@dekma0091 && @DefinitelyNotDekma && @semyy174 (idea)"
__version__ = "1.0"
__icon__ = "pixelcamera/16"
__min_version__ = "12.5.1"

import base64
import os
import zlib
from base_plugin import BasePlugin, MenuItemData, MenuItemType
from ui.settings import Header, Switch
from java import jclass
from org.telegram.messenger import ApplicationLoader
from client_utils import get_last_fragment

ENTRY_CLASS = "ni.dekma.advanced_search.AdvancedSearchBridge"
BuildVersion = jclass("android.os.Build$VERSION")

_DEX_BASE64 = ""

class NativeBridge:
    def __init__(self, entry_class):
        self.entry_class = entry_class
        self.clazz = None
        self.loaded = False

    def load(self):
        if self.loaded:
            return
        if self.clazz is None:
            context = ApplicationLoader.applicationContext
            if context is None:
                raise RuntimeError("application context is not ready")
            if int(BuildVersion.SDK_INT) < 26:
                raise RuntimeError("embedded DEX requires Android API 26+")
            raw_bytes = base64.b64decode(_DEX_BASE64)
            try:
                payload = zlib.decompress(raw_bytes)
            except Exception:
                payload = raw_bytes
            ByteBuffer = jclass("java.nio.ByteBuffer")
            InMemoryDexClassLoader = jclass("dalvik.system.InMemoryDexClassLoader")
            loader = InMemoryDexClassLoader(
                ByteBuffer.wrap(payload),
                context.getClassLoader(),
            )
            self.clazz = loader.loadClass(self.entry_class)
        try:
            self._invoke("load")
            self.loaded = True
        except Exception:
            try:
                self._invoke("unload")
            except Exception:
                pass
            self.loaded = False
            raise

    def unload(self):
        if self.clazz is None or not self.loaded:
            return
        try:
            self._invoke("unload")
        except Exception:
            pass
        self.loaded = False

    def set_show_in_main_search(self, show: bool):
        self._invoke("setShowInMainSearch", bool(show))

    def open_search(self, context, peer_id=0, query=""):
        self._invoke("openSearch", context, int(peer_id), str(query))

    def open_search_with_user(self, context, peer_id=0, query="", user_id=0, user_name=""):
        self._invoke("openSearchWithUser", context, int(peer_id), str(query), int(user_id), str(user_name))

    def _invoke(self, method_name, *args):
        if self.clazz is None:
            raise RuntimeError("embedded DEX class is not loaded")
        for method in self.clazz.getDeclaredMethods():
            if str(method.getName()) == method_name and len(method.getParameterTypes()) == len(args):
                method.setAccessible(True)
                return method.invoke(None, *args)
        raise RuntimeError(f"core method not found: {method_name}/{len(args)}")

class AdvancedSearchPlugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self.bridge = NativeBridge(ENTRY_CLASS)

    def on_plugin_load(self):
        self.bridge.load()
        show_main = self.get_setting("show_main_search_btn", True)
        try:
            self.bridge.set_show_in_main_search(bool(show_main))
        except Exception:
            pass
        self._register_menu_items()

    def on_plugin_unload(self):
        self.bridge.unload()

    def create_settings(self):
        return [
            Header(text="Отображение кнопки"),
            Switch(
                key="show_main_search_btn",
                text="Показывать кнопку расширенного поиска в строке главного экрана",
                default=True,
                icon="msg_search",
                on_change=self.on_show_main_search_changed,
            ),
        ]

    def on_show_main_search_changed(self, *args):
        val = True
        if args:
            val = bool(args[0])
        try:
            self.set_setting("show_main_search_btn", val)
            self.bridge.set_show_in_main_search(val)
        except Exception:
            pass

    def _register_menu_items(self):
        try:
            self.add_menu_item(
                MenuItemData(
                    menu_type=MenuItemType.MESSAGE_CONTEXT_MENU,
                    text="⚡ Расширенный поиск автора",
                    on_click=self.on_message_context_click,
                    icon="user_search",
                    priority=100
                )
            )
            self.add_menu_item(
                MenuItemData(
                    menu_type=MenuItemType.DRAWER_MENU,
                    text="⚡ Расширенный поиск",
                    on_click=self.on_global_menu_click,
                    icon="user_search",
                    priority=100
                )
            )
        except Exception:
            pass

    def on_message_context_click(self, context):
        if not context:
            return
        try:
            dialog_id = 0
            user_id = 0
            user_name = ""
            if isinstance(context, dict):
                dialog_id = context.get("dialog_id", 0)
                if not dialog_id:
                    dialog_id = context.get("chatId", 0)
                user_id = context.get("userId", 0)
                user_obj = context.get("user")
                msg_obj = context.get("message")
                if not user_id and user_obj is not None:
                    try:
                        user_id = int(getattr(user_obj, "id", 0))
                    except Exception:
                        pass
                if not user_id and msg_obj is not None:
                    try:
                        from_id_obj = getattr(msg_obj, "from_id", None)
                        if from_id_obj is not None:
                            user_id = int(getattr(from_id_obj, "user_id", 0))
                    except Exception:
                        pass
                if user_obj is not None:
                    try:
                        user_name = str(getattr(user_obj, "username", "") or "")
                        if not user_name:
                            fn = str(getattr(user_obj, "first_name", "") or "")
                            ln = str(getattr(user_obj, "last_name", "") or "")
                            user_name = (fn + " " + ln).strip()
                    except Exception:
                        pass
            frag = (context.get("fragment") if isinstance(context, dict) else None) or get_last_fragment()
            if not dialog_id and frag is not None:
                try:
                    dialog_id = int(frag.getDialogId())
                except Exception:
                    pass
            act = frag.getParentActivity() if frag and hasattr(frag, "getParentActivity") else None
            if not act:
                act = ApplicationLoader.applicationContext
            if user_id:
                self.bridge.open_search_with_user(act, int(dialog_id), "", int(user_id), str(user_name))
            else:
                self.bridge.open_search(act, int(dialog_id), "")
        finally:
            del context

    def on_global_menu_click(self, context):
        if not context:
            return
        try:
            frag = (context.get("fragment") if isinstance(context, dict) else None) or get_last_fragment()
            act = frag.getParentActivity() if frag and hasattr(frag, "getParentActivity") else None
            if not act:
                act = ApplicationLoader.applicationContext
            self.bridge.open_search(act, 0, "")
        finally:
            del context
