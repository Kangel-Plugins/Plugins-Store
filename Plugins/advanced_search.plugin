__id__ = "advanced_search"
__name__ = "Продвинутый поиск"
__description__ = "Продвинутый поиск по чатам, документам с различными фильтрами"
__author__ = "@dekma0091"
__version__ = "1.2"
__icon__ = "pixelcamera/16"
__app_version__ = ">=12.5.1"
__sdk_version__ = ">=1.4.0"
__requirements__ = []

import base64
import hashlib
import os
import zlib
from base_plugin import BasePlugin
from ui.settings import Header, Switch, Text
from java import jclass
from org.telegram.messenger import ApplicationLoader, LocaleController

def is_english():
    try:
        lang = str(LocaleController.getLocaleStringIso639() or "").lower()
        if lang:
            return not (lang.startswith("ru") or lang.startswith("uk") or lang.startswith("be"))
    except Exception:
        pass
    try:
        Locale = jclass("java.util.Locale")
        lang = str(Locale.getDefault().getLanguage() or "").lower()
        return not (lang.startswith("ru") or lang.startswith("uk") or lang.startswith("be"))
    except Exception:
        return False

def tr(ru, en):
    return en if is_english() else ru

ENTRY_CLASS = "ni.dekma.advanced_search.AdvancedSearchBridge"
BuildVersion = jclass("android.os.Build$VERSION")

_DEX_BASE64 = ""

class NativeBridge:
    def __init__(self, entry_class):
        self.entry_class = entry_class
        self.clazz = None
        self.loader = None
        self.loaded = False

    def load(self):
        if self.loaded:
            try:
                self.unload()
            except Exception:
                pass
        context = ApplicationLoader.applicationContext
        if context is None:
            raise RuntimeError("application context is not ready")
        raw_bytes = base64.b64decode(_DEX_BASE64)
        try:
            payload = zlib.decompress(raw_bytes)
        except Exception:
            payload = raw_bytes
        try:
            ByteBuffer = jclass("java.nio.ByteBuffer")
            InMemoryDexClassLoader = jclass("dalvik.system.InMemoryDexClassLoader")
            parent_loader = context.getClassLoader()
            self.loader = InMemoryDexClassLoader(
                ByteBuffer.wrap(payload),
                parent_loader,
            )
            self.clazz = self.loader.loadClass(self.entry_class)
        except Exception:
            try:
                cache_dir = context.getCacheDir().getAbsolutePath()
                dex_hash = hashlib.sha256(_DEX_BASE64.encode("utf-8")).hexdigest()[:12]
                dex_path = os.path.join(cache_dir, f"advanced_search_{dex_hash}.dex")
                opt_dir = os.path.join(cache_dir, f"dex_opt_{dex_hash}")
                os.makedirs(opt_dir, exist_ok=True)
                if not os.path.exists(dex_path):
                    with open(dex_path, "wb") as f:
                        f.write(payload)
                DexClassLoader = jclass("dalvik.system.DexClassLoader")
                parent_loader = context.getClassLoader()
                self.loader = DexClassLoader(dex_path, opt_dir, None, parent_loader)
                self.clazz = self.loader.loadClass(self.entry_class)
            except Exception:
                raise
        self._invoke("load")
        self.loaded = True

    def unload(self):
        if self.clazz is not None:
            try:
                self._invoke("unload")
            except Exception:
                pass
        self.clazz = None
        self.loader = None
        self.loaded = False

    def set_show_in_main_search(self, show: bool):
        self._invoke("setShowInMainSearch", bool(show))

    def open_search(self, context, peer_id=0, query=""):
        self._invoke("openSearch", context, int(peer_id), str(query))

    def open_search_with_user(self, context, peer_id=0, query="", user_id=0, user_name=""):
        self._invoke("openSearchWithUser", context, int(peer_id), str(query), int(user_id), str(user_name))

    def reset_hint_tutorial(self, context):
        self._invoke("resetHintTutorial", context)

    def _invoke(self, method_name, *args):
        if self.clazz is None:
            raise RuntimeError("embedded DEX class is not loaded")
        for method in self.clazz.getDeclaredMethods():
            if str(method.getName()) == method_name and len(method.getParameterTypes()) == len(args):
                method.setAccessible(True)
                return method.invoke(None, *args)
        raise RuntimeError(f"core method not found: {method_name}/{len(args)}")

_ACTIVE_SEARCH_INSTANCE = None

class AdvancedSearchPlugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self.bridge = NativeBridge(ENTRY_CLASS)

    def on_plugin_load(self):
        global _ACTIVE_SEARCH_INSTANCE
        if _ACTIVE_SEARCH_INSTANCE is not None and _ACTIVE_SEARCH_INSTANCE is not self:
            try:
                _ACTIVE_SEARCH_INSTANCE.on_plugin_unload()
            except Exception:
                pass
        _ACTIVE_SEARCH_INSTANCE = self
        self.bridge.load()
        show_main = self.get_setting("show_main_search_btn", True)
        try:
            self.bridge.set_show_in_main_search(bool(show_main))
        except Exception:
            pass

    def on_plugin_unload(self):
        global _ACTIVE_SEARCH_INSTANCE
        try:
            self.bridge.unload()
        except Exception:
            pass
        if _ACTIVE_SEARCH_INSTANCE is self:
            _ACTIVE_SEARCH_INSTANCE = None

    def create_settings(self):
        return [
            Header(text=tr("Отображение кнопки", "Button display")),
            Switch(
                key="show_main_search_btn",
                text=tr("Показывать кнопку расширенного поиска в строке главного экрана", "Show advanced search button in main screen bar"),
                default=True,
                icon="msg_search",
                on_change=self.on_show_main_search_changed,
            ),
            Header(text=tr("Обучение и подсказки", "Tutorial & hints")),
            Text(
                text=tr("Сбросить подсказку первого запуска", "Reset first launch hint"),
                subtext=tr("Показать подсказку по долгому тапу при следующем поиске", "Show long tap hint on next search"),
                icon="help",
                on_click=self.on_reset_hint_click,
            ),
        ]

    def on_reset_hint_click(self, *args):
        try:
            self.bridge.reset_hint_tutorial(ApplicationLoader.applicationContext)
        except Exception:
            pass

    def on_show_main_search_changed(self, *args):
        val = True
        if args:
            val = bool(args[0])
        try:
            self.set_setting("show_main_search_btn", val)
            self.bridge.set_show_in_main_search(val)
        except Exception:
            pass
