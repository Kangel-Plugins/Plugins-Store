def _c32(val):
    val = int(val) & 0xFFFFFFFF
    if val > 0x7FFFFFFF:
        val -= 0x100000000
    return val


def _argb_to_css_hex(color_int):
    v = int(color_int) & 0xFFFFFF
    return f"#{v:06x}"


def _is_dark_color(color_int):
    v = int(color_int) & 0xFFFFFF
    r = (v >> 16) & 0xFF
    g = (v >> 8) & 0xFF
    b = v & 0xFF
    lum = 0.299 * r + 0.587 * g + 0.114 * b
    return lum < 128


def _safe_theme_color(theme_cls, attr_name, fallback):
    if theme_cls is None:
        return _c32(fallback)
    try:
        key = getattr(theme_cls, attr_name, None)
        if key is None:
            return _c32(fallback)
        return _c32(theme_cls.getColor(key))
    except BaseException:
        return _c32(fallback)


def _round_bg(color, radius_px, stroke_px=0, stroke_color=0):
    d = GradientDrawable()
    d.setShape(GradientDrawable.RECTANGLE)
    d.setColor(_c32(color))
    d.setCornerRadius(float(radius_px))
    if stroke_px > 0:
        d.setStroke(int(stroke_px), _c32(stroke_color))
    return d


def _get_activity():
    try:
        frag = get_last_fragment()
        if frag is not None:
            act = frag.getParentActivity()
            if act is not None:
                return act
    except BaseException:
        pass
    try:
        return find_class("org.telegram.ui.LaunchActivity").instance
    except BaseException:
        return None


def _get_current_account():
    try:
        if UserConfig is not None:
            return int(UserConfig.selectedAccount)
    except BaseException:
        pass
    return 0


def _normalize_doc_text(text: str) -> str:
    """统一换行符并去除首尾空白，避免不同入口末尾差 1 个换行符导致缓存键不一致"""
    return (text or "").replace("\r\n", "\n").replace("\r", "\n").strip()


def _compute_wab_btn_margins(
    bar_w: int,
    bar_h: int,
    right_children_rects,
    btn_h: int,
    dp_unit: float,
    extra_right_clearance_dp: float = 0.0,
):
    """
    根据 WebActionBar 现有右侧图标位置自适应计算单个「译」按钮的 rightMargin / topMargin，
    避让右侧三点菜单、收起按钮以及多标签页计数徽章（如 18），并对齐图标垂直中心线。
    """
    def dp(v):
        return int(round(v * dp_unit))

    default_right = dp(56 + extra_right_clearance_dp)
    default_top = max(dp(8), bar_h - btn_h - dp(12)) if bar_h > btn_h + dp(12) else dp(8)
    if bar_w <= 0 or bar_h <= 0:
        return default_right, default_top

    valid = []
    for (l, t, r, b) in right_children_rects or []:
        w = r - l
        h = b - t
        if w <= 0 or h <= 0:
            continue
        # 放宽左侧边界至 44%，覆盖右侧第 3 个多标签计数图标（如 `18`）
        if l > bar_w * 0.44 and w < bar_w * 0.26:
            valid.append((l, t, r, b))

    if not valid:
        return default_right, default_top

    min_left = min(x[0] for x in valid)
    ref = max(valid, key=lambda x: x[2])  # 以最右侧标准菜单图标作为垂直居中参考
    center_y = (ref[1] + ref[3]) // 2

    occupied_right = bar_w - min_left
    # 若仅探测到右侧 1~2 个按钮，但顶栏存在自绘多标签计数徽章，则额外预留一个图标位
    extra_px = dp(extra_right_clearance_dp) if extra_right_clearance_dp > 0 else 0
    if extra_px > 0 and occupied_right < dp(122):
        occupied_right += extra_px

    right_margin = occupied_right + dp(6)
    max_right = max(dp(56), int(bar_w * 0.48))
    right_margin = max(dp(46), min(right_margin, max_right))

    top_margin = center_y - (btn_h // 2)
    max_top = max(dp(4), bar_h - btn_h - dp(4))
    top_margin = max(dp(4), min(top_margin, max_top))
    return int(right_margin), int(top_margin)


# ==================== 本地持久化译文缓存 ====================
class _DocTranslationCache:
    """按「内容 SHA256 + 目标语言」将完整译文落盘，支持重启秒开与 LRU 自动瘦身"""

    def __init__(self, cache_dir: str = None, max_files: int = CACHE_MAX_FILES, max_bytes: int = CACHE_MAX_BYTES):
        self._dir_override = cache_dir
        self._max_files = max_files
        self._max_bytes = max_bytes
        self._lock = threading.Lock()

    def _resolve_dir(self) -> str:
        if self._dir_override:
            base = self._dir_override
        else:
            base = ""
            try:
                ctx = None
                if ApplicationLoader is not None:
                    ctx = ApplicationLoader.applicationContext
                if ctx is None:
                    ctx = _get_activity()
                if ctx is not None:
                    cdir = ctx.getCacheDir()
                    if cdir is not None:
                        base = os.path.join(str(cdir.getAbsolutePath()), "zephyr_tr_doc_cache")
            except BaseException:
                base = ""
            if not base:
                base = os.path.join(tempfile.gettempdir(), "zephyr_tr_doc_cache")
        try:
            os.makedirs(base, exist_ok=True)
        except BaseException:
            pass
        return base

    @staticmethod
    def make_key(src_text: str, target_lang: str) -> str:
        norm_src = _normalize_doc_text(src_text)
        raw = f"{(target_lang or 'zh-CN').strip()}\x00{norm_src}".encode("utf-8", errors="replace")
        return hashlib.sha256(raw).hexdigest()[:28]

    def _entry_path(self, key: str) -> str:
        return os.path.join(self._resolve_dir(), f"{key}.json")

    def get(self, src_text: str, target_lang: str):
        key = self.make_key(src_text, target_lang)
        path = self._entry_path(key)
        with self._lock:
            if not os.path.isfile(path):
                return None
            try:
                with open(path, "r", encoding="utf-8") as f:
                    obj = json.load(f)
                txt = obj.get("text") if isinstance(obj, dict) else None
                if isinstance(txt, str) and txt:
                    try:
                        os.utime(path, None)
                    except BaseException:
                        pass
                    return txt
            except BaseException:
                try:
                    os.remove(path)
                except BaseException:
                    pass
            return None

    def put(self, src_text: str, target_lang: str, translated_text: str, title: str = ""):
        if not translated_text:
            return
        key = self.make_key(src_text, target_lang)
        path = self._entry_path(key)
        tmp = path + ".tmp"
        payload = {
            "v": 1,
            "lang": target_lang,
            "title": (title or "")[:120],
            "ts": time.time(),
            "text": translated_text,
        }
        with self._lock:
            try:
                with open(tmp, "w", encoding="utf-8") as f:
                    json.dump(payload, f, ensure_ascii=False)
                os.replace(tmp, path)
                self._evict_locked()
            except BaseException:
                try:
                    if os.path.exists(tmp):
                        os.remove(tmp)
                except BaseException:
                    pass

    def delete(self, src_text: str, target_lang: str):
        key = self.make_key(src_text, target_lang)
        path = self._entry_path(key)
        with self._lock:
            try:
                if os.path.isfile(path):
                    os.remove(path)
            except BaseException:
                pass

    def _evict_locked(self):
        cdir = self._resolve_dir()
        try:
            entries = []
            total_sz = 0
            for name in os.listdir(cdir):
                if not name.endswith(".json"):
                    continue
                fp = os.path.join(cdir, name)
                try:
                    st = os.stat(fp)
                    entries.append((st.st_mtime, st.st_size, fp))
                    total_sz += st.st_size
                except BaseException:
                    continue
            if len(entries) <= self._max_files and total_sz <= self._max_bytes:
                return
            entries.sort(key=lambda x: x[0])  # 最旧在前
            while entries and (len(entries) > self._max_files or total_sz > self._max_bytes):
                _, sz, fp = entries.pop(0)
                total_sz -= sz
                try:
                    os.remove(fp)
                except BaseException:
                    pass
        except BaseException:
            pass

    def stats(self):
        cdir = self._resolve_dir()
        cnt = 0
        total_sz = 0
        with self._lock:
            try:
                for name in os.listdir(cdir):
                    if not name.endswith(".json"):
                        continue
                    fp = os.path.join(cdir, name)
                    try:
                        total_sz += os.path.getsize(fp)
                        cnt += 1
                    except BaseException:
                        pass
            except BaseException:
                pass
        return cnt, total_sz

    def clear(self) -> int:
        cdir = self._resolve_dir()
        removed = 0
        with self._lock:
            try:
                for name in os.listdir(cdir):
                    if not (name.endswith(".json") or name.endswith(".tmp")):
                        continue
                    fp = os.path.join(cdir, name)
                    try:
                        os.remove(fp)
                        if name.endswith(".json"):
                            removed += 1
                    except BaseException:
                        pass
            except BaseException:
                pass
        return removed


def _read_text_file_safe(path: str):
    if not path or not os.path.isfile(path):
        return None, "文件尚未下载或路径不存在"
    try:
        size = os.path.getsize(path)
    except BaseException as err:
        return None, f"读取文件大小失败: {err}"
    if size <= 0:
        return "", None
    if size > MAX_DOC_BYTES:
        return None, f"文件过大 ({size / (1024 * 1024):.1f} MB)，超出 2 MB 阅读限制"
    try:
        with open(path, "rb") as f:
            raw = f.read()
    except BaseException as err:
        return None, f"读取文件失败: {err}"

    # 兼容 UTF-8 / BOM / 中文 GB18030 / 俄文 Windows-1251
    for enc in ("utf-8-sig", "utf-8", "gb18030", "cp1251", "latin-1"):
        try:
            return raw.decode(enc), None
        except UnicodeDecodeError:
            continue
    return raw.decode("utf-8", errors="replace"), None


def _strip_html_to_readable(html_text: str) -> str:
    s = re.sub(r"(?is)<(script|style)[^>]*>.*?</\1>", "", html_text or "")
    s = re.sub(r"(?i)<br\s*/?>", "\n", s)
    s = re.sub(r"(?i)</(p|div|li|tr|h[1-6]|blockquote)>", "\n", s)
    s = re.sub(r"<[^>]+>", "", s)
    s = html.unescape(s)
    s = re.sub(r"\n{3,}", "\n\n", s)
    return s.strip()


# ==================== 电报 TLRPC.Page / RichText 递归提取器 ====================
def _extract_tg_richtext(rt, depth: int = 0) -> str:
    if rt is None or depth > 14:
        return ""
    if isinstance(rt, str):
        return rt
    try:
        cname = ""
        try:
            cname = str(rt.getClass().getSimpleName())
        except BaseException:
            cname = type(rt).__name__
        low = cname.lower()

        parts = []
        texts = getattr(rt, "texts", None)
        if texts is not None:
            try:
                cnt = int(texts.size()) if hasattr(texts, "size") else len(texts)
                for i in range(cnt):
                    item = texts.get(i) if hasattr(texts, "get") else texts[i]
                    sub = _extract_tg_richtext(item, depth + 1)
                    if sub:
                        parts.append(sub)
            except BaseException:
                pass

        inner_t = getattr(rt, "text", None)
        if inner_t is not None:
            if isinstance(inner_t, str):
                parts.append(inner_t)
            else:
                sub = _extract_tg_richtext(inner_t, depth + 1)
                if sub:
                    parts.append(sub)

        if not parts:
            for fname in ("str", "value", "caption"):
                fv = getattr(rt, fname, None)
                if isinstance(fv, str) and fv:
                    parts.append(fv)
                    break

        joined = "".join(parts)
        if not joined:
            return ""

        # 保留核心行内格式（粗体 / 斜体 / 删除线 / 行内代码 / 超链接）
        if not joined.strip():
            return joined

        lead_ws = joined[: len(joined) - len(joined.lstrip())]
        trail_ws = joined[len(joined.rstrip()) :]
        core = joined.strip()

        if "texturl" in low:
            url = getattr(rt, "url", None)
            if isinstance(url, str) and url.strip().lower().startswith(("http://", "https://", "tg://")):
                return f"{lead_ws}[{core}]({url.strip()}){trail_ws}"
        elif "textbold" in low:
            return f"{lead_ws}**{core}**{trail_ws}"
        elif "textitalic" in low:
            return f"{lead_ws}*{core}*{trail_ws}"
        elif "textstrike" in low:
            return f"{lead_ws}~~{core}~~{trail_ws}"
        elif "textfixed" in low:
            safe_core = core.replace("`", "'")
            return f"{lead_ws}`{safe_core}`{trail_ws}"

        return joined
    except BaseException:
        return ""


def _extract_tg_caption(cap_obj, depth: int = 0) -> str:
    if cap_obj is None or depth > 8:
        return ""
    try:
        t1 = _extract_tg_richtext(getattr(cap_obj, "text", None), depth + 1).strip()
        t2 = _extract_tg_richtext(getattr(cap_obj, "credit", None), depth + 1).strip()
        if t1 and t2:
            return f"{t1} ({t2})"
        return t1 or t2
    except BaseException:
        return ""


def _extract_tg_blocks_list(blocks, out_lines, depth: int = 0, budget=None):
    if blocks is None or depth > 10:
        return
    if budget is None:
        budget = [900]
    try:
        cnt = int(blocks.size()) if hasattr(blocks, "size") else len(blocks)
    except BaseException:
        return

    for i in range(min(cnt, 800)):
        if budget[0] <= 0:
            break
        budget[0] -= 1
        try:
            blk = blocks.get(i) if hasattr(blocks, "get") else blocks[i]
        except BaseException:
            continue
        if blk is None:
            continue

        cname = ""
        try:
            cname = str(blk.getClass().getSimpleName())
        except BaseException:
            cname = type(blk).__name__
        low = cname.lower()

        # 分隔线
        if "divider" in low:
            out_lines.append("---")
            continue

        # 封面块（嵌套单个 cover block）
        if "cover" in low:
            cov = getattr(blk, "cover", None)
            if cov is not None:
                _extract_tg_blocks_list([cov], out_lines, depth + 1, budget)
            continue

        # 作者与发布日期
        if "authordate" in low:
            author_s = _extract_tg_richtext(getattr(blk, "author", None)).strip()
            pub_ts = getattr(blk, "published_date", 0)
            date_s = ""
            try:
                if isinstance(pub_ts, int) and pub_ts > 0:
                    date_s = datetime.datetime.fromtimestamp(pub_ts).strftime("%Y-%m-%d")
            except BaseException:
                date_s = ""
            meta = " · ".join(x for x in (author_s, date_s) if x)
            if meta:
                out_lines.append(f"*{meta}*")
            continue

        # 折叠详情块（TL_pageBlockDetails: title + 子 blocks）
        if "details" in low:
            d_title = _extract_tg_richtext(getattr(blk, "title", None)).strip()
            if d_title:
                out_lines.append(f"### {d_title}")
            sub_blks = getattr(blk, "blocks", None)
            if sub_blks is not None:
                _extract_tg_blocks_list(sub_blks, out_lines, depth + 1, budget)
            continue

        # 表格（TL_pageBlockTable: title + rows）
        if "table" in low:
            tbl_title = _extract_tg_richtext(getattr(blk, "title", None)).strip()
            if tbl_title:
                out_lines.append(f"### {tbl_title}")
            rows = getattr(blk, "rows", None)
            if rows is not None:
                try:
                    rcnt = int(rows.size()) if hasattr(rows, "size") else len(rows)
                    table_rows = []
                    for r_i in range(min(rcnt, 200)):
                        row = rows.get(r_i) if hasattr(rows, "get") else rows[r_i]
                        cells = getattr(row, "cells", None) if row is not None else None
                        if cells is None:
                            continue
                        ccnt = int(cells.size()) if hasattr(cells, "size") else len(cells)
                        row_vals = []
                        for c_i in range(ccnt):
                            cell = cells.get(c_i) if hasattr(cells, "get") else cells[c_i]
                            row_vals.append(
                                _extract_tg_richtext(getattr(cell, "text", None)).strip().replace("|", "\\|").replace("\n", " ")
                            )
                        if any(row_vals):
                            table_rows.append(row_vals)
                    if table_rows:
                        col_n = max(len(r) for r in table_rows)
                        for r_i, rv in enumerate(table_rows):
                            padded = rv + [""] * (col_n - len(rv))
                            out_lines.append("| " + " | ".join(padded) + " |")
                            if r_i == 0:
                                out_lines.append("| " + " | ".join(["---"] * col_n) + " |")
                except BaseException:
                    pass
            continue

        # 无序 / 有序列表（同时兼容纯文本项与嵌套子块项）
        if "list" in low and getattr(blk, "items", None) is not None:
            is_ordered = "ordered" in low
            items = getattr(blk, "items", None)
            try:
                icnt = int(items.size()) if hasattr(items, "size") else len(items)
                for j in range(min(icnt, 300)):
                    it = items.get(j) if hasattr(items, "get") else items[j]
                    if it is None:
                        continue
                    num_str = str(getattr(it, "num", j + 1) or (j + 1)).strip()
                    prefix = f"{num_str}. " if is_ordered else "- "
                    it_blocks = getattr(it, "blocks", None)
                    if it_blocks is not None:
                        sub_lines = []
                        _extract_tg_blocks_list(it_blocks, sub_lines, depth + 1, budget)
                        if sub_lines:
                            out_lines.append(prefix + sub_lines[0])
                            for extra_l in sub_lines[1:]:
                                out_lines.append("  " + extra_l)
                    else:
                        it_txt = _extract_tg_richtext(getattr(it, "text", it)).strip()
                        if it_txt:
                            out_lines.append(prefix + it_txt)
            except BaseException:
                pass
            continue

        # 常规正文 / 标题 / 引用 / 代码块 / 页脚
        t_obj = getattr(blk, "text", None)
        t_str = _extract_tg_richtext(t_obj).strip() if t_obj is not None else ""
        if t_str:
            if "subtitle" in low or "subheader" in low:
                out_lines.append(f"### {t_str}")
            elif "title" in low:
                out_lines.append(f"# {t_str}")
            elif "header" in low:
                out_lines.append(f"## {t_str}")
            elif "kicker" in low:
                out_lines.append(f"> **{t_str}**")
            elif "preformatted" in low:
                lang = str(getattr(blk, "language", "") or "").strip()
                out_lines.append(f"```{lang}\n{t_str}\n```")
            elif "blockquote" in low or "pullquote" in low:
                q_txt = "\n".join(f"> {ln}" for ln in t_str.splitlines())
                cap_s = _extract_tg_richtext(getattr(blk, "caption", None)).strip()
                if cap_s:
                    q_txt += f"\n> — {cap_s}"
                out_lines.append(q_txt)
            elif "footer" in low:
                out_lines.append(f"> {t_str}")
            else:
                out_lines.append(t_str)
            continue

        # 嵌入式帖子 / 媒体块说明文字
        sub_blks = getattr(blk, "blocks", None)
        if sub_blks is not None:
            author_s = str(getattr(blk, "author", "") or "").strip()
            if author_s:
                out_lines.append(f"> **{author_s}**")
            _extract_tg_blocks_list(sub_blks, out_lines, depth + 1, budget)

        cap_obj = getattr(blk, "caption", None)
        if cap_obj is not None:
            cap_s = _extract_tg_caption(cap_obj, depth + 1)
            if cap_s:
                out_lines.append(f"> {cap_s}")


def _extract_tg_page_blocks(page_obj) -> str:
    if page_obj is None:
        return ""
    try:
        blocks = getattr(page_obj, "blocks", None)
        if blocks is None:
            cached = getattr(page_obj, "cached_page", None)
            if cached is not None:
                blocks = getattr(cached, "blocks", None)
        if blocks is None:
            return ""
        lines = []
        _extract_tg_blocks_list(blocks, lines, depth=0, budget=[900])
        return "\n\n".join(x for x in lines if x and x.strip())
    except BaseException:
        return ""


# ==================== 纯 Python Markdown 渲染器（带无闪烁增量更新壳） ====================
def _render_inline_md(text: str) -> str:
    tokens = []

    def _hold(rendered: str) -> str:
        idx = len(tokens)
        tokens.append(rendered)
        return f"\x00INL{idx}\x00"

    def _code_sub(m):
        return _hold(f"<code>{html.escape(m.group(1))}</code>")

    s = re.sub(r"`([^`\n]+)`", _code_sub, text)
    s = html.escape(s)

    def _link_sub(m):
        label = m.group(1)
        href = m.group(2).strip()
        if href.lower().startswith(("http://", "https://", "tg://")):
            return _hold(f'<a href="{href}">{label}</a>')
        return label

    s = re.sub(r"\[([^\]]+)\]\(([^)\s]+)\)", _link_sub, s)

    s = re.sub(r"\*\*([^\*\n]+)\*\*", r"<strong>\1</strong>", s)
    s = re.sub(r"__([^_\n]+)__", r"<strong>\1</strong>", s)
    s = re.sub(r"~~([^~\n]+)~~", r"<del>\1</del>", s)
    s = re.sub(r"(?<!\*)\*([^\*\n]+)\*(?!\*)", r"<em>\1</em>", s)

    def _autolink_sub(m):
        u = m.group(0)
        return f'<a href="{u}">{u}</a>'

    s = re.sub(r"https?://[^\s<&\"']+", _autolink_sub, s)

    for idx, val in enumerate(tokens):
        s = s.replace(f"\x00INL{idx}\x00", val)
    return s


def _is_table_sep(line: str) -> bool:
    s = line.strip()
    if "|" not in s:
        return False
    cells = [c.strip() for c in s.strip("|").split("|")]
    return bool(cells) and all(re.match(r"^:?-{2,}:?$", c) for c in cells)


def _split_table_row(line: str):
    s = line.strip()
    if s.startswith("|"):
        s = s[1:]
    if s.endswith("|"):
        s = s[:-1]
    return [c.strip() for c in s.split("|")]


def _markdown_to_html_body(md_text: str, is_plain: bool = False) -> str:
    if is_plain:
        escaped = html.escape(md_text or "")
        paras = [p.replace("\n", "<br>") for p in re.split(r"\n{2,}", escaped)]
        return "".join(f"<p>{p}</p>" for p in paras if p.strip()) or "<p></p>"

    lines = (md_text or "").replace("\r\n", "\n").replace("\r", "\n").split("\n")
    out = []
    i = 0
    n = len(lines)
    in_ul = False
    in_ol = False

    def close_lists():
        nonlocal in_ul, in_ol
        if in_ul:
            out.append("</ul>")
            in_ul = False
        if in_ol:
            out.append("</ol>")
            in_ol = False

    while i < n:
        line = lines[i]
        stripped = line.strip()

        if stripped.startswith("```"):
            close_lists()
            lang = html.escape(stripped[3:].strip())
            code_lines = []
            i += 1
            while i < n and not lines[i].strip().startswith("```"):
                code_lines.append(lines[i])
                i += 1
            if i < n:
                i += 1
            lang_cls = f' class="lang-{lang}"' if lang else ""
            out.append(f"<pre><code{lang_cls}>{html.escape(chr(10).join(code_lines))}</code></pre>")
            continue

        if not stripped:
            close_lists()
            i += 1
            continue

        if re.match(r"^([-*_]\s*){3,}$", stripped):
            close_lists()
            out.append("<hr>")
            i += 1
            continue

        hm = re.match(r"^(#{1,6})\s+(.*)$", stripped)
        if hm:
            close_lists()
            lvl = len(hm.group(1))
            out.append(f"<h{lvl}>{_render_inline_md(hm.group(2).strip())}</h{lvl}>")
            i += 1
            continue

        if stripped.startswith(">"):
            close_lists()
            q_lines = []
            while i < n and lines[i].strip().startswith(">"):
                q_lines.append(re.sub(r"^\s*>\s?", "", lines[i]))
                i += 1
            inner = "<br>".join(_render_inline_md(x) for x in q_lines)
            out.append(f"<blockquote>{inner}</blockquote>")
            continue

        if "|" in stripped and (i + 1) < n and _is_table_sep(lines[i + 1]):
            close_lists()
            headers = _split_table_row(lines[i])
            i += 2
            rows = []
            while i < n and "|" in lines[i] and lines[i].strip():
                rows.append(_split_table_row(lines[i]))
                i += 1
            t_html = ['<div class="tbl-wrap"><table><thead><tr>']
            for h_cell in headers:
                t_html.append(f"<th>{_render_inline_md(h_cell)}</th>")
            t_html.append("</tr></thead><tbody>")
            for row in rows:
                t_html.append("<tr>")
                for col_idx in range(max(len(headers), len(row))):
                    val = row[col_idx] if col_idx < len(row) else ""
                    t_html.append(f"<td>{_render_inline_md(val)}</td>")
                t_html.append("</tr>")
            t_html.append("</tbody></table></div>")
            out.append("".join(t_html))
            continue

        um = re.match(r"^\s*[-*+]\s+(.*)$", line)
        if um:
            if in_ol:
                out.append("</ol>")
                in_ol = False
            if not in_ul:
                out.append("<ul>")
                in_ul = True
            out.append(f"<li>{_render_inline_md(um.group(1).strip())}</li>")
            i += 1
            continue

        om = re.match(r"^\s*\d+[.)]\s+(.*)$", line)
        if om:
            if in_ul:
                out.append("</ul>")
                in_ul = False
            if not in_ol:
                out.append("<ol>")
                in_ol = True
            out.append(f"<li>{_render_inline_md(om.group(1).strip())}</li>")
            i += 1
            continue

        close_lists()
        p_lines = [stripped]
        i += 1
        while i < n:
            nxt = lines[i].strip()
            if (
                not nxt
                or nxt.startswith(("```", "#", ">"))
                or re.match(r"^([-*_]\s*){3,}$", nxt)
                or re.match(r"^\s*[-*+]\s+", lines[i])
                or re.match(r"^\s*\d+[.)]\s+", lines[i])
                or ("|" in nxt and (i + 1) < n and _is_table_sep(lines[i + 1]))
            ):
                break
            p_lines.append(nxt)
            i += 1
        out.append(f"<p>{'<br>'.join(_render_inline_md(x) for x in p_lines)}</p>")

    close_lists()
    return "\n".join(out)


def _build_reader_html(
    body_html: str,
    bg_hex: str,
    text_hex: str,
    accent_hex: str,
    is_dark: bool,
    font_size_px: int = 16,
    use_serif: bool = False,
    banner_text: str = "",
) -> str:
    sub_bg = "rgba(255,255,255,0.06)" if is_dark else "rgba(0,0,0,0.045)"
    border_col = "rgba(255,255,255,0.15)" if is_dark else "rgba(0,0,0,0.11)"
    quote_col = "rgba(255,255,255,0.74)" if is_dark else "rgba(0,0,0,0.66)"
    font_family = (
        "Georgia, 'Noto Serif CJK SC', 'Songti SC', serif"
        if use_serif
        else "-apple-system, BlinkMacSystemFont, 'Roboto', 'Noto Sans CJK SC', sans-serif"
    )
    banner_display = "block" if banner_text else "none"
    banner_safe = html.escape(banner_text or "")

    return f"""<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=3.0">
<style>
  html, body {{
    margin: 0;
    padding: 14px 18px 64px 18px;
    background: {bg_hex};
    color: {text_hex};
    font-family: {font_family};
    font-size: {int(font_size_px)}px;
    line-height: 1.72;
    word-wrap: break-word;
    overflow-wrap: anywhere;
    -webkit-font-smoothing: antialiased;
  }}
  #doc-banner {{
    display: {banner_display};
    font-size: 12.5px;
    line-height: 1.45;
    padding: 8px 12px;
    margin-bottom: 14px;
    border-radius: 10px;
    background: {sub_bg};
    border-left: 3px solid {accent_hex};
    opacity: 0.92;
  }}
  h1, h2, h3, h4, h5, h6 {{
    margin: 1.15em 0 0.48em 0;
    line-height: 1.38;
    font-weight: 700;
  }}
  h1 {{ font-size: 1.38em; border-bottom: 1px solid {border_col}; padding-bottom: 6px; }}
  h2 {{ font-size: 1.22em; }}
  h3 {{ font-size: 1.09em; }}
  p {{ margin: 0.62em 0; }}
  a {{ color: {accent_hex}; text-decoration: none; }}
  code {{
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.87em;
    background: {sub_bg};
    padding: 1.5px 5px;
    border-radius: 5px;
    overflow-wrap: anywhere;
  }}
  pre {{
    background: {sub_bg};
    padding: 11px 13px;
    border-radius: 10px;
    overflow-x: auto;
    border: 1px solid {border_col};
    line-height: 1.5;
  }}
  pre code {{
    background: transparent;
    padding: 0;
    font-size: 0.84em;
    overflow-wrap: normal;
  }}
  blockquote {{
    margin: 0.78em 0;
    padding: 6px 12px;
    border-left: 3px solid {accent_hex};
    background: {sub_bg};
    color: {quote_col};
    border-radius: 0 8px 8px 0;
  }}
  ul, ol {{ padding-left: 22px; margin: 0.55em 0; }}
  li {{ margin: 0.3em 0; }}
  hr {{ border: none; border-top: 1px solid {border_col}; margin: 16px 0; }}
  .tbl-wrap {{
    width: 100%;
    overflow-x: auto;
    margin: 12px 0;
    border-radius: 10px;
    border: 1px solid {border_col};
  }}
  table {{
    border-collapse: collapse;
    width: 100%;
    font-size: 0.92em;
  }}
  th, td {{
    border: 1px solid {border_col};
    padding: 8px 10px;
    text-align: left;
    vertical-align: top;
  }}
  th {{
    background: {sub_bg};
    font-weight: 600;
  }}
</style>
<script>
  window.__patchReader = function(bodyHtml, bannerText, fontPx, useSerif) {{
    try {{
      var b = document.getElementById('doc-banner');
      if (b && bannerText !== null) {{
        if (bannerText) {{
          b.textContent = bannerText;
          b.style.display = 'block';
        }} else {{
          b.style.display = 'none';
        }}
      }}
      var c = document.getElementById('doc-content');
      if (c && bodyHtml !== null) {{
        var sy = window.scrollY || document.documentElement.scrollTop || 0;
        c.innerHTML = bodyHtml;
        window.scrollTo(0, sy);
      }}
      if (fontPx) {{
        document.body.style.fontSize = fontPx + 'px';
      }}
      if (useSerif !== null) {{
        document.body.style.fontFamily = useSerif
          ? "Georgia, 'Noto Serif CJK SC', 'Songti SC', serif"
          : "-apple-system, BlinkMacSystemFont, 'Roboto', 'Noto Sans CJK SC', sans-serif";
      }}
      return "ok";
    }} catch (e) {{
      return "err:" + e;
    }}
  }};
</script>
</head>
<body>
<div id="doc-banner">{banner_safe}</div>
<div id="doc-content">{body_html}</div>
</body>
</html>"""


# ==================== 首屏秒出 + 后台接力保格式分段翻译引擎 ====================
def _google_translate_chunk(text: str, target_lang: str, timeout: float = 18.0) -> str:
    if not text or not text.strip():
        return text
    tl = urllib.parse.quote(target_lang, safe="")
    endpoints = (
        ("single", f"https://translate.googleapis.com/translate_a/single?client=gtx&sl=auto&tl={tl}&dt=t"),
        ("single", f"https://translate.google.com/translate_a/single?client=gtx&sl=auto&tl={tl}&dt=t"),
        ("chrome", f"https://clients5.google.com/translate_a/t?client=dict-chrome-ex&sl=auto&tl={tl}"),
    )
    payload = urllib.parse.urlencode({"q": text}).encode("utf-8")
    last_err = None
    for kind, ep in endpoints:
        for attempt in range(2):
            try:
                req = urllib.request.Request(
                    ep,
                    data=payload,
                    headers={
                        "User-Agent": "Mozilla/5.0 (Linux; Android 14) AppleWebKit/537.36 Chrome/126.0.0.0 Mobile Safari/537.36",
                        "Content-Type": "application/x-www-form-urlencoded; charset=UTF-8",
                    },
                    method="POST",
                )
                with urllib.request.urlopen(req, timeout=timeout) as resp:
                    raw = resp.read().decode("utf-8", errors="replace")
                data = json.loads(raw)
                if kind == "chrome":
                    if isinstance(data, list) and data:
                        first = data[0]
                        if isinstance(first, list) and first:
                            return str(first[0])
                        if isinstance(first, str):
                            return first
                    raise ValueError("备选翻译接口返回格式异常")
                if not isinstance(data, list) or not data or not isinstance(data[0], list):
                    raise ValueError("翻译接口返回格式异常")
                parts = []
                for seg in data[0]:
                    if isinstance(seg, list) and seg and seg[0] is not None:
                        parts.append(str(seg[0]))
                return "".join(parts)
            except BaseException as err:
                last_err = err
                time.sleep(0.35 * (attempt + 1))
    raise last_err if last_err is not None else RuntimeError("翻译请求失败")


def _protect_inline_tokens(text: str):
    """保护行内代码、URL 与长哈希值，避免被翻译引擎破坏。"""
    holders = []

    def _sub(m):
        idx = len(holders)
        holders.append(m.group(0))
        return f"XPH{idx}X"

    pattern = r"`[^`\n]+`|https?://[^\s)\]>\"']+|\b[0-9a-fA-F]{24,}\b"
    protected = re.sub(pattern, _sub, text)
    return protected, holders


def _restore_inline_tokens(text: str, holders) -> str:
    if not holders:
        return text
    out = text
    for idx, orig in enumerate(holders):
        out = re.sub(rf"(?i)\bX\s*P\s*H\s*{idx}\s*X\b", lambda _m, v=orig: v, out)
    return out


def _assemble_translated_md(orig_lines, table_templates, slots, translated_map) -> str:
    """将当前已完成的 translated_map 拼装回完整文档（未翻批次平滑保留原文，保证随时可渲染）。"""
    result_lines = list(orig_lines)
    table_buffers = {}
    for line_idx, (cells, has_lead, has_trail) in table_templates.items():
        table_buffers[line_idx] = [list(cells), has_lead, has_trail]

    for s_idx, slot in enumerate(slots):
        if s_idx not in translated_map:
            continue
        kind = slot[0]
        line_idx = slot[1]
        holders = slot[4]
        restored = _restore_inline_tokens(translated_map[s_idx], holders)
        if kind == "line":
            prefix = slot[2]
            result_lines[line_idx] = prefix + restored
        elif kind == "cell":
            c_i = slot[2]
            if line_idx in table_buffers:
                table_buffers[line_idx][0][c_i] = restored.replace("|", "\\|")

    for line_idx, (cells, has_lead, has_trail) in table_buffers.items():
        row_str = " | ".join(cells)
        if has_lead:
            row_str = "| " + row_str
        if has_trail:
            row_str = row_str + " |"
        result_lines[line_idx] = row_str

    return "\n".join(result_lines)


def _translate_document_streaming(
    src_text: str,
    target_lang: str,
    is_markdown: bool = True,
    on_batch_ready=None,
    cancel_check=None,
):
    """
    首屏秒出 + 后台静默接力保格式翻译：
    - 第 1 批精简为 ~700 字（最多 12 段），1~2 秒返回即回调 on_batch_ready 展示首屏译文；
    - 后续批次每批 ~1000 字后台接力翻译，每完成一批实时无感替换；
    - 保留围栏代码块、行内代码、URL、长哈希与表格结构。
    返回 (final_text, failed_batches_count)
    """
    lines = (src_text or "").replace("\r\n", "\n").replace("\r", "\n").split("\n")
    slots = []
    table_templates = {}
    in_code_fence = False

    for idx, line in enumerate(lines):
        stripped = line.strip()
        if is_markdown and stripped.startswith("```"):
            in_code_fence = not in_code_fence
            continue
        if in_code_fence or not stripped:
            continue
        if is_markdown and re.match(r"^([-*_]\s*){3,}$", stripped):
            continue
        if is_markdown and _is_table_sep(line):
            continue

        if is_markdown and "|" in stripped and (
            stripped.startswith("|")
            or (idx + 1 < len(lines) and _is_table_sep(lines[idx + 1]))
            or (idx > 0 and ("|" in lines[idx - 1]))
        ):
            cells = _split_table_row(line)
            has_lead = stripped.startswith("|")
            has_trail = stripped.endswith("|")
            cell_added = False
            for c_i, cell in enumerate(cells):
                if cell.strip():
                    prot, holders = _protect_inline_tokens(cell)
                    slots.append(("cell", idx, c_i, prot, holders))
                    cell_added = True
            if cell_added:
                table_templates[idx] = (cells, has_lead, has_trail)
            continue

        prefix = ""
        body = line
        if is_markdown:
            m = re.match(r"^(\s*(?:#{1,6}\s+|>\s*|[-*+]\s+|\d+[.)]\s+))(.*)$", line)
            if m:
                prefix, body = m.group(1), m.group(2)

        if not body.strip():
            continue

        prot, holders = _protect_inline_tokens(body)
        if not re.search(
            r"[A-Za-z\u00C0-\u024F\u0400-\u04FF\u0600-\u06FF\u3040-\u30FF\uAC00-\uD7AF\u0E00-\u0E7F\u4E00-\u9FFF]",
            re.sub(r"XPH\d+X", "", prot),
        ):
            continue

        slots.append(("line", idx, prefix, prot, holders))

    if not slots:
        if on_batch_ready is not None:
            on_batch_ready(1, 1, src_text, 0)
        return src_text, 0

    # 第 1 批精简加速首屏出字，后续批次常规长度提高吞吐
    batches = []
    cur_batch = []
    cur_len = 0
    for s_idx, slot in enumerate(slots):
        seg = slot[3].replace("\n", " ")
        seg_len = len(seg) + 14
        is_first = len(batches) == 0
        max_chars = 720 if is_first else 1000
        max_items = 12 if is_first else 18
        if cur_batch and (cur_len + seg_len > max_chars or len(cur_batch) >= max_items):
            batches.append(cur_batch)
            cur_batch = []
            cur_len = 0
        cur_batch.append((s_idx, seg))
        cur_len += seg_len
    if cur_batch:
        batches.append(cur_batch)

    total_batches = len(batches)
    translated_map = {}
    failed_batches = 0

    for b_idx, batch in enumerate(batches):
        if cancel_check is not None and cancel_check():
            raise RuntimeError("已取消翻译")
        if b_idx > 0:
            time.sleep(0.10)

        joined = "\n".join(f"【{k}】 {seg}" for k, seg in batch)
        try:
            trans_chunk = _google_translate_chunk(joined, target_lang)
        except BaseException as b_err:
            failed_batches += 1
            if failed_batches >= max(3, total_batches):
                raise b_err
            for k, seg in batch:
                translated_map[k] = seg
            if on_batch_ready is not None:
                partial = _assemble_translated_md(lines, table_templates, slots, translated_map)
                on_batch_ready(b_idx + 1, total_batches, partial, failed_batches)
            continue

        found = {}
        matches = list(re.finditer(r"(?:【|\[)\s*(\d+)\s*(?:】|\])\s*", trans_chunk))
        if matches:
            for mi, m in enumerate(matches):
                key = int(m.group(1))
                start = m.end()
                end = matches[mi + 1].start() if mi + 1 < len(matches) else len(trans_chunk)
                found[key] = trans_chunk[start:end].strip()

        for k, seg in batch:
            if k in found and found[k]:
                translated_map[k] = found[k]
            else:
                try:
                    translated_map[k] = _google_translate_chunk(seg, target_lang).strip()
                except BaseException:
                    translated_map[k] = seg

        if on_batch_ready is not None:
            partial = _assemble_translated_md(lines, table_templates, slots, translated_map)
            on_batch_ready(b_idx + 1, total_batches, partial, failed_batches)

    final_text = _assemble_translated_md(lines, table_templates, slots, translated_map)
    return final_text, failed_batches


# ==================== Hook 处理器 ====================
class _OpenUrlHook(MethodHook):
    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin

    def before_hooked_method(self, param):
        try:
            args = param.args
            if not args or len(args) < 2 or args[1] is None:
                return

            arg1 = args[1]
            is_str = isinstance(arg1, str)
            is_uri = False
            if not is_str:
                try:
                    cls_name = str(arg1.getClass().getName())
                    is_uri = "android.net.Uri" in cls_name or cls_name.endswith("Uri")
                except BaseException:
                    is_uri = False

            if not is_str and not is_uri:
                return

            raw_url = arg1.strip() if is_str else str(arg1).strip()
            if not raw_url:
                return

            low = raw_url.lower()
            if not (low.startswith("http://") or low.startswith("https://")):
                return

            # 打开在线网页时清空旧的本地文档记忆，防止与之前的 .md 文档串台
            self.plugin._mark_av_web_context(raw_url)

            if not self.plugin.get_setting("auto_intercept", True):
                return
            if self.plugin._is_bypassed():
                return

            if not self.plugin.should_translate_url(raw_url):
                self.plugin._log("SKIP", f"放行链接: {self.plugin._short_url(raw_url)}")
                return

            mode = self.plugin._get_open_mode()
            if mode == "float":
                param.setResult(None)
                now = time.monotonic()
                if (
                    raw_url == self.plugin._last_hook_url
                    and (now - self.plugin._last_hook_ts) < 0.45
                ):
                    return
                self.plugin._last_hook_url = raw_url
                self.plugin._last_hook_ts = now
                self.plugin._log("FLOAT", f"悬浮窗拦截翻译: {self.plugin._short_url(raw_url)}")
                run_on_ui_thread(lambda u=raw_url: self.plugin.show_translated_float(u))
            else:
                new_url = self.plugin.to_translate_url(raw_url)
                if not new_url or new_url == raw_url:
                    return
                self.plugin._last_url = new_url
                self.plugin._mark_av_web_context(new_url)
                if is_str:
                    param.args[1] = new_url
                elif Uri is not None:
                    param.args[1] = Uri.parse(new_url)
                self.plugin._log("BUILTIN", f"内置浏览器翻译: {self.plugin._short_url(raw_url)}")
        except BaseException as err:
            self.plugin._log("ERROR", f"拦截外链异常: {err}")


class _DocOpenHook(MethodHook):
    """拦截 AndroidUtilities.openDocument / openForView，记录打开的本地文档并按需自动接管"""

    def __init__(self, plugin, method_name: str):
        super().__init__()
        self.plugin = plugin
        self.method_name = method_name

    def before_hooked_method(self, param):
        try:
            if not self.plugin.get_setting("doc_translate_enabled", True):
                return

            file_path, file_name, msg_obj = self.plugin._inspect_args_for_doc(param.args)
            if not file_path or not self.plugin._is_supported_text_doc(file_name or file_path):
                return
            if not os.path.isfile(file_path):
                return

            self.plugin._remember_av_doc(file_path, file_name or os.path.basename(file_path), msg_obj)

            if not self.plugin.get_setting("doc_auto_intercept", False):
                return
            if self.plugin._is_doc_bypassed():
                return

            now = time.monotonic()
            if (
                file_path == self.plugin._last_doc_hook_path
                and (now - self.plugin._last_doc_hook_ts) < 0.65
            ):
                return
            self.plugin._last_doc_hook_path = file_path
            self.plugin._last_doc_hook_ts = now

            ret_name = ""
            try:
                ret_name = str(param.method.getReturnType().getName())
            except BaseException:
                ret_name = ""
            if ret_name in ("boolean", "java.lang.Boolean"):
                param.setResult(True)
            elif ret_name in ("void", "java.lang.Void"):
                param.setResult(None)
            else:
                return

            self.plugin._log("DOC", f"自动接管文档({self.method_name}): {file_name or os.path.basename(file_path)}")
            run_on_ui_thread(
                lambda p=file_path, n=(file_name or os.path.basename(file_path)), m=msg_obj: self.plugin.open_document_file(
                    p, n, msg_obj=m
                )
            )
        except BaseException as err:
            self.plugin._log("ERROR", f"拦截文档打开异常({self.method_name}): {err}")


class _ArticleViewerHook(MethodHook):
    """监听 org.telegram.ui.ArticleViewer：记录文档/即时预览/网页上下文，支持即时预览开关拦截并注入顶栏「译」按钮"""

    def __init__(self, plugin, method_name: str):
        super().__init__()
        self.plugin = plugin
        self.method_name = method_name

    def before_hooked_method(self, param):
        try:
            # 1. 先检查是否为本地支持的文本/文档（.md / .txt 等）
            file_path, file_name, msg_obj = self.plugin._inspect_args_for_doc(param.args)
            if file_path and self.plugin._is_supported_text_doc(file_name or file_path) and os.path.isfile(file_path):
                if not self.plugin.get_setting("doc_translate_enabled", True):
                    return
                disp_name = file_name or os.path.basename(file_path)
                self.plugin._remember_av_doc(file_path, disp_name, msg_obj)
                self.plugin._log("AV_DOC", f"ArticleViewer.{self.method_name} 捕获文档: {disp_name}")

                if self.plugin.get_setting("doc_auto_intercept", False) and not self.plugin._is_doc_bypassed():
                    ret_name = ""
                    try:
                        ret_name = str(param.method.getReturnType().getName())
                    except BaseException:
                        ret_name = ""
                    if ret_name in ("void", "java.lang.Void", "boolean", "java.lang.Boolean"):
                        now = time.monotonic()
                        if not (
                            file_path == self.plugin._last_doc_hook_path
                            and (now - self.plugin._last_doc_hook_ts) < 0.65
                        ):
                            self.plugin._last_doc_hook_path = file_path
                            self.plugin._last_doc_hook_ts = now
                            param.setResult(True if "boolean" in ret_name.lower() else None)
                            self.plugin._log("AV_INTERCEPT", f"ArticleViewer 自动接管进全屏阅读器: {disp_name}")
                            run_on_ui_thread(
                                lambda p=file_path, n=disp_name, m=msg_obj: self.plugin.open_document_file(
                                    p, n, msg_obj=m
                                )
                            )
                            return
                return

            # 2. 检查是否为带即时预览（TLRPC$WebPage）的链接，防串台旧文档并按独立开关决定是否拦截
            iv_url, iv_title, wp_obj = self.plugin._inspect_args_for_webpage(param.args)
            if iv_url:
                self.plugin._mark_av_iv_context(iv_url, iv_title, wp_obj)
                now = time.monotonic()

                if (
                    self.plugin.get_setting("auto_intercept", True)
                    and self.plugin.get_setting("iv_auto_intercept", False)
                    and not self.plugin._is_bypassed()
                ):
                    if self.plugin.should_translate_url(iv_url):
                        ret_name = ""
                        try:
                            ret_name = str(param.method.getReturnType().getName())
                        except BaseException:
                            ret_name = ""
                        if ret_name in ("void", "java.lang.Void", "boolean", "java.lang.Boolean"):
                            param.setResult(True if "boolean" in ret_name.lower() else None)
                            if not (
                                iv_url == self.plugin._last_iv_hook_url
                                and (now - self.plugin._last_iv_hook_ts) < 0.65
                            ):
                                self.plugin._last_iv_hook_url = iv_url
                                self.plugin._last_iv_hook_ts = now
                                self.plugin._log("IV_INTERCEPT", f"拦截即时预览走网页翻译: {self.plugin._short_url(iv_url)}")
                                run_on_ui_thread(lambda u=iv_url: self.plugin._open_url_by_mode(u, force_trans=True))
                            return
                    else:
                        if not (
                            iv_url == self.plugin._last_iv_log_url
                            and (now - self.plugin._last_iv_log_ts) < 0.8
                        ):
                            self.plugin._last_iv_log_url = iv_url
                            self.plugin._last_iv_log_ts = now
                            self.plugin._log("IV_SKIP", f"即时预览链接放行: {self.plugin._short_url(iv_url)}")
                else:
                    if not (
                        iv_url == self.plugin._last_iv_log_url
                        and (now - self.plugin._last_iv_log_ts) < 0.8
                    ):
                        self.plugin._last_iv_log_url = iv_url
                        self.plugin._last_iv_log_ts = now
                        self.plugin._log("AV_IV", f"即时预览(保留原生): {self.plugin._short_url(iv_url)}")
                return

            # 3. 检查普通在线网址参数
            found_url = self.plugin._inspect_args_for_url(param.args)
            if found_url:
                self.plugin._mark_av_web_context(found_url)
        except BaseException as err:
            self.plugin._log("ERROR", f"ArticleViewer.{self.method_name} 前置异常: {err}")

    def after_hooked_method(self, param):
        try:
            viewer = getattr(param, "thisObject", None)
            if viewer is not None:
                self.plugin._av_instance = viewer
            if not self.plugin.get_setting("doc_translate_enabled", True):
                return
            if not self.plugin.get_setting("av_inject_btn", True):
                return
            if viewer is not None:
                self.plugin._schedule_av_inject(viewer, self.method_name)
        except BaseException as err:
            self.plugin._log("ERROR", f"ArticleViewer.{self.method_name} 后置异常: {err}")


class _WebActionBarHook(MethodHook):
    """监听 org.telegram.ui.web.WebActionBar 状态更新，在顶栏注入唯一「译」按钮并跟踪网页上下文"""

    def __init__(self, plugin, method_name: str):
        super().__init__()
        self.plugin = plugin
        self.method_name = method_name

    def after_hooked_method(self, param):
        try:
            bar = getattr(param, "thisObject", None)
            if bar is None:
                return
            if not self.plugin._is_real_web_action_bar(bar):
                return

            # 若顶栏正在设置 http(s) 网址/域名副标题，同步标记为网页上下文，防止串台旧文档
            if self.method_name in ("setUrl", "setSubtitle", "setTitle") and param.args:
                for a in param.args:
                    if a is None:
                        continue
                    s = str(a).strip()
                    if s.lower().startswith(("http://", "https://")) or (
                        self.method_name == "setSubtitle"
                        and "." in s
                        and " " not in s
                        and not self.plugin._is_supported_text_doc(s)
                    ):
                        self.plugin._mark_av_web_context(s)
                        break

            if not self.plugin.get_setting("doc_translate_enabled", True):
                return
            if not self.plugin.get_setting("av_inject_btn", True):
                return
            if self.plugin._has_injected_btn(bar):
                return
            run_on_ui_thread(lambda b=bar, m=self.method_name: self.plugin._inject_web_action_bar_btn(b, source=m))
        except BaseException:
            pass


class UnifiedTranslatePlugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self._hook_refs = []
        self._doc_hook_refs = []
        self._av_hook_refs = []
        self._wab_hook_refs = []
        self._menu_item_ref = None
        self._bypass_until = 0.0
        self._doc_bypass_until = 0.0
        self._last_hook_url = ""
        self._last_hook_ts = 0.0
        self._last_doc_hook_path = ""
        self._last_doc_hook_ts = 0.0

        # 本地磁盘译文缓存 & 后台翻译任务池（关闭阅读页后仍在后台续翻并自动落盘）
        self._cache = _DocTranslationCache()
        self._jobs_lock = threading.Lock()
        self._active_jobs = {}  # cache_key -> dict(state)

        # ArticleViewer / WebActionBar 状态
        self._av_instance = None
        self._av_last_doc = None  # (file_path, file_name, msg_obj, ts)
        self._av_last_iv = None  # (iv_url, iv_title, wp_obj, ts)
        self._av_mode = "unknown"  # "doc" | "iv" | "web" | "unknown"
        self._av_last_web_url = ""
        self._av_last_web_ts = 0.0
        self._last_iv_hook_url = ""
        self._last_iv_hook_ts = 0.0
        self._last_iv_log_url = ""
        self._last_iv_log_ts = 0.0
        self._av_last_inject_ts = 0.0
        self._injected_bars = []  # [(bar_view, btn_view, layout_listener), ...]
        self._injected_bar_ids = set()

        # 网页悬浮窗状态（仅外链打开方式选“悬浮窗”时使用）
        self._wm = None
        self._root = None
        self._root_bg = None
        self._lp = None
        self._webview = None
        self._content_box = None
        self._bar_row = None
        self._bubble_btn = None
        self._btn_toggle = None
        self._btn_kb = None

        self._minimized = False
        self._focusable = False
        self._accent_col = _c32(0xFF3A8DFF)
        self._text_col = _c32(0xFFFFFFFF)

        self._win_w = 0
        self._win_x = 0
        self._win_y = 0
        self._saved_x = 0
        self._saved_y = 0
        self._drag_x = 0.0
        self._drag_y = 0.0
        self._drag_ox = 0
        self._drag_oy = 0
        self._b_drag_x = 0.0
        self._b_drag_y = 0.0
        self._b_ox = 0
        self._b_oy = 0
        self._b_moved = False
        self._last_url = ""

        # 全屏原生流畅阅读页（Dialog）状态
        self._r_dialog = None
        self._r_wv = None
        self._r_wv_ready = False
        self._r_title_tv = None
        self._r_sub_tv = None
        self._r_btn_trans = None
        self._r_font_size = 16
        self._r_use_serif = False

        # 当前全屏阅读文档数据
        self._r_doc_title = ""
        self._r_doc_raw = ""
        self._r_doc_trans = None
        self._r_doc_trans_lang = ""
        self._r_doc_cache_key = ""
        self._r_doc_from_cache = False
        self._r_doc_is_md = True
        self._r_doc_is_plain = False
        self._r_showing_trans = False
        self._r_msg_obj = None
        self._r_doc_url = ""
        self._r_bg_hex = "#1c1c1e"
        self._r_text_hex = "#ffffff"
        self._r_accent_hex = "#3a8dff"
        self._r_is_dark = True
        self._r_last_banner = ""

        self._logs = []

    def create_settings(self):
        mode_idx = self.get_setting("open_mode_idx", 0)
        if not isinstance(mode_idx, int) or not (0 <= mode_idx < len(OPEN_MODE_ITEMS)):
            mode_idx = 0

        lang_idx = self.get_setting("lang_idx", 0)
        if not isinstance(lang_idx, int) or not (0 <= lang_idx < len(GOOGLE_TRANSLATE_LANGUAGES)):
            lang_idx = 0

        doc_eng_idx = self.get_setting("doc_engine_idx", 0)
        if not isinstance(doc_eng_idx, int) or not (0 <= doc_eng_idx < len(DOC_ENGINE_ITEMS)):
            doc_eng_idx = 0

        iv_mode_idx = self.get_setting("iv_click_mode_idx", 0)
        if not isinstance(iv_mode_idx, int) or not (0 <= iv_mode_idx < len(IV_CLICK_MODE_ITEMS)):
            iv_mode_idx = 0

        c_cnt, c_bytes = self._cache.stats()
        c_mb = c_bytes / (1024.0 * 1024.0)
        cache_sub = f"当前已缓存 {c_cnt} 篇译文（约 {c_mb:.2f} MB），点击立即清空"

        return [
            Divider(text="网页链接翻译设置"),
            Switch(
                key="auto_intercept",
                text="点击外部链接自动网页翻译",
                subtext="自动识别源语言并翻译为目标语言；默认放行 t.me 频道/消息链接",
                default=self.get_setting("auto_intercept", True),
            ),
            Switch(
                key="iv_auto_intercept",
                text="自动拦截带即时预览的链接走网页翻译",
                subtext="默认关闭（保留电报原生即时预览，点顶栏「译」按下方默认方式翻译）；开启后直接走网页翻译并遵守黑白名单",
                default=self.get_setting("iv_auto_intercept", False),
            ),
            Selector(
                key="iv_click_mode_idx",
                text="即时预览点「译」默认方式",
                items=[x[0] for x in IV_CLICK_MODE_ITEMS],
                default=iv_mode_idx,
            ),
            Selector(
                key="open_mode_idx",
                text="外链打开方式",
                items=[x[0] for x in OPEN_MODE_ITEMS],
                default=mode_idx,
            ),
            Selector(
                key="lang_idx",
                text="目标翻译语言（支持全部谷歌语言）",
                items=[x[0] for x in GOOGLE_TRANSLATE_LANGUAGES],
                default=lang_idx,
            ),
            Input(
                key="custom_lang_code",
                text="手动输入语言代码（可选，优先于上方列表）",
                default=self.get_setting("custom_lang_code", ""),
            ),
            Input(
                key="custom_cmd",
                text="自定义翻译指令前缀",
                subtext="支持 .tr <网址>、.tr <短文本>，或回复 .md/.txt 文档消息发 .tr",
                default=self.get_setting("custom_cmd", ".tr"),
            ),
            Divider(text="文档与查看器翻译（.md / .txt）"),
            Switch(
                key="doc_translate_enabled",
                text="启用文档与文本翻译",
                subtext="控制查看器顶栏「译」按钮、全屏阅读器、消息菜单与指令短文本直翻",
                default=self.get_setting("doc_translate_enabled", True),
            ),
            Switch(
                key="av_inject_btn",
                text="在原生查看器顶栏注入「译」按钮（推荐）",
                subtext="短按立即翻译（首屏秒出 + 本地缓存秒开）；长按可临时切换翻译方式",
                default=self.get_setting("av_inject_btn", True),
            ),
            Selector(
                key="doc_engine_idx",
                text="文档与短文本翻译优先级",
                items=[x[0] for x in DOC_ENGINE_ITEMS],
                default=doc_eng_idx,
            ),
            Switch(
                key="doc_auto_intercept",
                text="点击聊天内 .md / .txt 直接进插件全屏阅读器",
                subtext="默认关闭（保留客户端原生查看器，按需点顶栏「译」按钮更顺手）",
                default=self.get_setting("doc_auto_intercept", False),
            ),
            Text(
                text="清理本地译文缓存",
                icon="msg_delete",
                subtext=cache_sub,
                on_click=lambda v=None: run_on_ui_thread(self._clear_cache_action),
            ),
            Divider(text="域名白名单与免翻译列表"),
            Input(
                key="force_whitelist",
                text="强制翻译白名单（逗号分隔）",
                subtext="填入 t.me 后，t.me 首页会翻译，但带路径如 t.me/Mkataba/1615 依然不翻",
                default=self.get_setting("force_whitelist", ""),
            ),
            Input(
                key="skip_domains",
                text="免翻译域名列表（逗号分隔）",
                subtext="填入不想走翻译的网站（如 wiki.com, baidu.com），直接原样打开",
                default=self.get_setting("skip_domains", ""),
            ),
            Divider(text="诊断与排障"),
            Text(
                text="运行与报错日志记录",
                icon="msg_log",
                subtext="查看链接分流、缓存命中、顶栏按钮与翻译报错轨迹，支持一键复制",
                on_click=lambda v=None: run_on_ui_thread(self._show_logs_dialog),
            ),
        ]

    def _clear_cache_action(self):
        removed = self._cache.clear()
        with self._jobs_lock:
            for job in self._active_jobs.values():
                job["cancelled"] = True
            self._active_jobs.clear()
        self._log("CACHE", f"手动清空译文缓存: {removed} 篇")
        BulletinHelper.show_info(f"已清空 {removed} 篇本地译文缓存")

    def _short_url(self, url: str, limit: int = 64) -> str:
        s = (url or "").strip()
        if len(s) <= limit:
            return s
        return s[: limit - 3] + "..."

    def _log(self, level: str, msg: str):
        try:
            ts = datetime.datetime.now().strftime("%H:%M:%S")
            line = f"[{ts}] [{level}] {msg}"
            self._logs.append(line)
            if len(self._logs) > 80:
                del self._logs[:-80]
        except BaseException:
            pass

    def on_plugin_load(self):
        self._hook_refs = []
        self._doc_hook_refs = []
        self._av_hook_refs = []
        self._wab_hook_refs = []
        self._menu_item_ref = None
        self._bypass_until = 0.0
        self._doc_bypass_until = 0.0
        self._last_hook_url = ""
        self._last_hook_ts = 0.0
        self._last_doc_hook_path = ""
        self._last_doc_hook_ts = 0.0
        self._av_instance = None
        self._av_last_doc = None
        self._av_last_iv = None
        self._av_mode = "unknown"
        self._av_last_web_url = ""
        self._av_last_web_ts = 0.0
        self._last_iv_hook_url = ""
        self._last_iv_hook_ts = 0.0
        self._last_iv_log_url = ""
        self._last_iv_log_ts = 0.0
        self._av_last_inject_ts = 0.0
        self._injected_bars = []
        self._injected_bar_ids = set()

        try:
            self.add_on_send_message_hook()
        except BaseException as err:
            self._log("ERROR", f"挂载发送指令 Hook 失败: {err}")
        self._install_url_hooks()
        self._install_doc_hooks()
        self._install_article_viewer_hooks()
        self._install_web_action_bar_hooks()
        self._install_message_menu()

    def on_plugin_unload(self):
        all_refs = (
            list(self._hook_refs)
            + list(self._doc_hook_refs)
            + list(self._av_hook_refs)
            + list(self._wab_hook_refs)
        )
        for ref in all_refs:
            try:
                self.unhook_method(ref)
            except BaseException:
                pass
        self._hook_refs = []
        self._doc_hook_refs = []
        self._av_hook_refs = []
        self._wab_hook_refs = []

        if self._menu_item_ref is not None:
            try:
                if hasattr(self, "remove_menu_item"):
                    self.remove_menu_item(self._menu_item_ref)
            except BaseException:
                pass
            self._menu_item_ref = None

        with self._jobs_lock:
            for job in self._active_jobs.values():
                job["cancelled"] = True
            self._active_jobs.clear()

        self._bypass_until = 0.0
        self._doc_bypass_until = 0.0
        run_on_ui_thread(self._cleanup_injected_buttons)
        run_on_ui_thread(self.close_float)
        run_on_ui_thread(self.close_reader)

    def _install_url_hooks(self):
        if Browser is None:
            self._log("ERROR", "未找到 Browser 类，外链自动拦截未生效")
            return
        try:
            count = 0
            for m in list(Browser.getClass().getDeclaredMethods()):
                if str(m.getName()) == "openUrl":
                    try:
                        ref = self.hook_method(m, _OpenUrlHook(self))
                        if ref is not None:
                            self._hook_refs.append(ref)
                            count += 1
                    except BaseException as err:
                        self._log("ERROR", f"挂载 openUrl 重载失败: {err}")
            self._log("INFO", f"外链 Hook 就绪: {count} 个 openUrl 入口")
        except BaseException as err:
            self._log("ERROR", f"扫描 Browser.openUrl 异常: {err}")

    def _install_doc_hooks(self):
        try:
            au_cls = find_class("org.telegram.messenger.AndroidUtilities")
            if au_cls is None:
                return
            count = 0
            for m in list(au_cls.getClass().getDeclaredMethods()):
                mname = str(m.getName())
                if mname in ("openDocument", "openForView"):
                    try:
                        ref = self.hook_method(m, _DocOpenHook(self, mname))
                        if ref is not None:
                            self._doc_hook_refs.append(ref)
                            count += 1
                    except BaseException:
                        pass
            self._log("INFO", f"AndroidUtilities 文档 Hook 就绪: {count} 个入口")
        except BaseException as err:
            self._log("ERROR", f"安装 AndroidUtilities Hook 异常: {err}")

    def _install_article_viewer_hooks(self):
        av_cls = ArticleViewer or find_class("org.telegram.ui.ArticleViewer")
        if av_cls is None:
            self._log("WARN", "未找到 org.telegram.ui.ArticleViewer")
            return
        try:
            count = 0
            hooked_names = set()
            for m in list(av_cls.getClass().getDeclaredMethods()):
                mname = str(m.getName())
                if mname in AV_HOOK_METHOD_NAMES:
                    try:
                        ref = self.hook_method(m, _ArticleViewerHook(self, mname))
                        if ref is not None:
                            self._av_hook_refs.append(ref)
                            hooked_names.add(mname)
                            count += 1
                    except BaseException:
                        pass
            names_txt = ", ".join(sorted(hooked_names)) if hooked_names else "无"
            self._log("INFO", f"ArticleViewer Hook 就绪: {count} 个入口 ({names_txt})")
        except BaseException as err:
            self._log("ERROR", f"扫描 ArticleViewer 异常: {err}")

    def _install_web_action_bar_hooks(self):
        wab_cls = WebActionBar or find_class("org.telegram.ui.web.WebActionBar")
        if wab_cls is None:
            self._log("WARN", "未找到 org.telegram.ui.web.WebActionBar")
            return
        try:
            count = 0
            hooked_names = set()
            for m in list(wab_cls.getClass().getDeclaredMethods()):
                mname = str(m.getName())
                if mname in WAB_HOOK_METHOD_NAMES:
                    try:
                        ref = self.hook_method(m, _WebActionBarHook(self, mname))
                        if ref is not None:
                            self._wab_hook_refs.append(ref)
                            hooked_names.add(mname)
                            count += 1
                    except BaseException:
                        pass
            names_txt = ", ".join(sorted(hooked_names)) if hooked_names else "无"
            self._log("INFO", f"WebActionBar Hook 就绪: {count} 个入口 ({names_txt})")
        except BaseException as err:
            self._log("ERROR", f"扫描 WebActionBar 异常: {err}")

    def _install_message_menu(self):
        if MenuItemData is None or MenuItemType is None:
            return
        if not hasattr(self, "add_menu_item"):
            return
        try:
            item = MenuItemData(
                menu_type=MenuItemType.MESSAGE_CONTEXT_MENU,
                text="阅读并翻译文档",
                icon="msg_translate",
                on_click=self._on_message_menu_click,
            )
            self._menu_item_ref = self.add_menu_item(item)
            self._log("INFO", "已注册消息菜单「阅读并翻译文档」")
        except BaseException as err:
            self._log("WARN", f"注册消息菜单失败: {err}")

    # ==================== ArticleViewer & WebActionBar 顶栏注入与上下文隔离 ====================
    def _remember_av_doc(self, file_path: str, file_name: str, msg_obj=None):
        self._av_last_doc = (file_path, file_name, msg_obj, time.monotonic())
        self._av_mode = "doc"

    def _mark_av_web_context(self, url_or_host: str):
        self._av_mode = "web"
        self._av_last_web_url = (url_or_host or "").strip()
        self._av_last_web_ts = time.monotonic()

    def _mark_av_iv_context(self, iv_url: str, iv_title: str = "", wp_obj=None):
        self._av_mode = "iv"
        self._av_last_iv = ((iv_url or "").strip(), (iv_title or "").strip(), wp_obj, time.monotonic())

    def _extract_webpage_info(self, obj):
        """从 TLRPC$WebPage、MessageObject 或 TLRPC$Page 提取 (url, title, wp_or_page_obj)"""
        if obj is None:
            return "", "", None
        try:
            cname = str(obj.getClass().getName())
        except BaseException:
            cname = type(obj).__name__

        wp = None
        if "MessageObject" in cname:
            try:
                owner = getattr(obj, "messageOwner", None)
                media = getattr(owner, "media", None) if owner is not None else None
                wp = getattr(media, "webpage", None) if media is not None else None
            except BaseException:
                wp = None
        elif "WebPage" in cname or "TL_webPage" in cname or "TLRPC$Page" in cname or "TL_page" in cname:
            wp = obj

        if wp is None:
            return "", "", None

        url = ""
        title = ""
        try:
            for attr in ("url", "display_url"):
                u = getattr(wp, attr, None)
                if isinstance(u, str) and u.strip():
                    cand = u.strip()
                    if cand.lower().startswith(("http://", "https://")):
                        url = cand
                        break
                    if attr == "display_url" and "." in cand and " " not in cand:
                        url = "https://" + cand
                        break
            for attr in ("title", "site_name"):
                t = getattr(wp, attr, None)
                if isinstance(t, str) and t.strip():
                    title = t.strip()
                    break
        except BaseException:
            pass
        return url, title, wp

    def _inspect_args_for_webpage(self, args):
        if not args:
            return "", "", None
        for a in args:
            if a is None or isinstance(a, (str, int, float, bool)):
                continue
            url, title, wp = self._extract_webpage_info(a)
            if url:
                return url, title, wp
        return "", "", None

    def _inspect_args_for_url(self, args) -> str:
        if not args:
            return ""
        for a in args:
            if a is None:
                continue
            if isinstance(a, str):
                s = a.strip()
                if s.lower().startswith(("http://", "https://")):
                    return s
            else:
                try:
                    cname = str(a.getClass().getName())
                    if "android.net.Uri" in cname or cname.endswith("Uri"):
                        s = str(a).strip()
                        if s.lower().startswith(("http://", "https://")):
                            return s
                except BaseException:
                    pass
        return ""

    def _inspect_args_for_doc(self, args):
        if not args:
            return "", "", None
        msg_obj = None
        explicit_name = ""
        file_path = ""

        for a in args:
            if a is None:
                continue
            if isinstance(a, str):
                s = a.strip()
                if s.startswith("file://"):
                    cand = urllib.parse.unquote(s[7:])
                    if os.path.isfile(cand):
                        file_path = cand
                        explicit_name = os.path.basename(cand)
                elif os.path.isfile(s):
                    file_path = s
                    explicit_name = os.path.basename(s)
                elif "." in s and len(s) < 260 and not s.lower().startswith(("http://", "https://")):
                    if not explicit_name:
                        explicit_name = os.path.basename(s)
                continue

            try:
                cname = str(a.getClass().getName())
            except BaseException:
                cname = ""

            if "MessageObject" in cname and msg_obj is None:
                msg_obj = a
            elif cname == "java.io.File" and not file_path:
                try:
                    cand = str(a.getAbsolutePath())
                    if os.path.isfile(cand):
                        file_path = cand
                        explicit_name = explicit_name or str(a.getName())
                except BaseException:
                    pass
            elif ("android.net.Uri" in cname or cname.endswith("Uri")) and not file_path:
                try:
                    u_str = str(a)
                    if u_str.startswith("file://"):
                        cand = urllib.parse.unquote(u_str[7:])
                        if os.path.isfile(cand):
                            file_path = cand
                            explicit_name = explicit_name or os.path.basename(cand)
                except BaseException:
                    pass

        if msg_obj is not None:
            mp, mn = self._resolve_message_document(msg_obj)
            if mp:
                file_path = mp
            if mn:
                explicit_name = mn

        return file_path, explicit_name, msg_obj

    def _is_real_web_action_bar(self, obj) -> bool:
        if obj is None or not hasattr(obj, "addView"):
            return False
        try:
            cls = obj.getClass()
            cname = str(cls.getName())
            if cname.startswith("org.telegram.ui.web.WebActionBar$"):
                return False
            if cname == "org.telegram.ui.web.WebActionBar":
                return True
            sc = cls.getSuperclass()
            while sc is not None:
                sn = str(sc.getName())
                if sn == "org.telegram.ui.web.WebActionBar":
                    return True
                if sn.startswith(("android.", "java.")):
                    break
                sc = sc.getSuperclass()
        except BaseException:
            pass
        return False

    def _has_injected_btn(self, bar_view) -> bool:
        try:
            if not self._is_real_web_action_bar(bar_view):
                return True
            if id(bar_view) in self._injected_bar_ids:
                return True
            if bar_view.findViewWithTag(AV_BTN_TAG) is not None:
                return True
        except BaseException:
            pass
        return False

    def _schedule_av_inject(self, viewer, source_method: str = ""):
        now = time.monotonic()
        if (now - self._av_last_inject_ts) < 0.25:
            return
        self._av_last_inject_ts = now
        run_on_ui_thread(lambda v=viewer, s=source_method: self._find_and_inject_from_viewer(v, s))

    def _find_and_inject_from_viewer(self, viewer, source_method: str = ""):
        try:
            bars = self._locate_web_action_bars(viewer)
            for bar in bars:
                if not self._has_injected_btn(bar):
                    self._inject_web_action_bar_btn(bar, source=f"AV.{source_method}")
        except BaseException as err:
            self._log("ERROR", f"扫描 ArticleViewer 顶栏异常: {err}")

    def _locate_web_action_bars(self, viewer):
        found = []
        seen_ids = set()

        def _collect_bar(obj):
            if obj is None:
                return
            oid = id(obj)
            if oid in seen_ids:
                return
            if self._is_real_web_action_bar(obj):
                seen_ids.add(oid)
                found.append(obj)

        def _walk_view(v, depth=0, budget=None):
            if v is None or depth > 10:
                return
            if budget is None:
                budget = [220]
            if budget[0] <= 0:
                return
            budget[0] -= 1
            _collect_bar(v)
            try:
                if hasattr(v, "getChildCount") and hasattr(v, "getChildAt"):
                    cnt = int(v.getChildCount())
                    for i in range(min(cnt, 40)):
                        _walk_view(v.getChildAt(i), depth + 1, budget)
            except BaseException:
                pass

        if viewer is None:
            return found

        try:
            cls = viewer.getClass()
            for f in list(cls.getDeclaredFields()):
                try:
                    fname = str(f.getName()).lower()
                    ft = str(f.getType().getName())
                    if not (
                        "webactionbar" in ft.lower()
                        or "actionbar" in fname
                        or "windowview" in fname
                        or "sheet" in fname
                        or "container" in fname
                        or "ArticleViewer$" in ft
                    ):
                        continue
                    f.setAccessible(True)
                    val = f.get(viewer)
                    if val is None:
                        continue
                    _collect_bar(val)
                    if hasattr(val, "getChildCount"):
                        _walk_view(val, 0, [160])
                    elif "Sheet" in str(val.getClass().getName()):
                        for sf in list(val.getClass().getDeclaredFields()):
                            try:
                                sf.setAccessible(True)
                                sval = sf.get(val)
                                if sval is None:
                                    continue
                                _collect_bar(sval)
                                if hasattr(sval, "getChildCount"):
                                    _walk_view(sval, 0, [120])
                            except BaseException:
                                pass
                except BaseException:
                    continue
        except BaseException:
            pass
        return found

    def _inject_web_action_bar_btn(self, bar_view, source: str = ""):
        if not self._is_real_web_action_bar(bar_view):
            return
        try:
            existing = bar_view.findViewWithTag(AV_BTN_TAG)
            if existing is not None:
                existing.setVisibility(View.VISIBLE)
                existing.bringToFront()
                return

            ctx = bar_view.getContext()
            if ctx is None:
                return

            ThemeCls = find_class("org.telegram.ui.ActionBar.Theme")
            accent_col = _safe_theme_color(ThemeCls, "key_dialogButtonBlue", 0xFF3A8DFF)

            btn = TextView(ctx)
            btn.setTag(AV_BTN_TAG)
            btn.setText("译")
            btn.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 12.5)
            btn.setTextColor(_c32(0xFFFFFFFF))
            btn.setGravity(Gravity.CENTER)
            btn.setSingleLine(True)
            btn.setPadding(AndroidUtilities.dp(9), AndroidUtilities.dp(3), AndroidUtilities.dp(9), AndroidUtilities.dp(3))
            btn.setBackground(_round_bg(accent_col, AndroidUtilities.dp(14), AndroidUtilities.dp(1), 0x44FFFFFF))
            try:
                btn.setElevation(float(AndroidUtilities.dp(4)))
            except BaseException:
                pass

            btn.setOnClickListener(OnClickListener(lambda v, b=bar_view: self._on_av_btn_click(b, force_picker=False)))

            OnLongClickCls = find_class("android.view.View$OnLongClickListener")
            if OnLongClickCls is not None:
                host_self = self

                class _AvLongClick(dynamic_proxy(OnLongClickCls)):
                    def onLongClick(self, v):
                        try:
                            host_self._on_av_btn_click(bar_view, force_picker=True)
                        except BaseException:
                            pass
                        return True

                btn.setOnLongClickListener(_AvLongClick())

            btn_h = AndroidUtilities.dp(28)
            sb_h = 0
            try:
                sb_h = int(AndroidUtilities.statusBarHeight)
            except BaseException:
                sb_h = AndroidUtilities.dp(24)

            lp = FrameLayout.LayoutParams(-2, btn_h, Gravity.TOP | Gravity.END)
            lp.topMargin = sb_h + AndroidUtilities.dp(14)
            lp.rightMargin = AndroidUtilities.dp(144)

            bar_view.addView(btn, lp)
            btn.bringToFront()

            # 轻量监听顶栏布局变化（如多标签计数徽章显示/隐藏时自动避让，内置防抖防循环）
            layout_listener = None
            try:
                OnLayoutCls = find_class("android.view.View$OnLayoutChangeListener")
                if OnLayoutCls is not None:
                    host_self = self
                    last_adj = [0.0]

                    class _WabLayoutWatch(dynamic_proxy(OnLayoutCls)):
                        def onLayoutChange(self, v, l, t, r, b, ol, ot, orr, ob):
                            now_t = time.monotonic()
                            if (now_t - last_adj[0]) < 0.25:
                                return
                            last_adj[0] = now_t
                            try:
                                host_self._reposition_av_btn(bar_view, btn)
                            except BaseException:
                                pass

                    layout_listener = _WabLayoutWatch()
                    bar_view.addOnLayoutChangeListener(layout_listener)
            except BaseException:
                layout_listener = None

            self._injected_bars.append((bar_view, btn, layout_listener))
            first_time = id(bar_view) not in self._injected_bar_ids
            self._injected_bar_ids.add(id(bar_view))
            if first_time:
                self._log("WAB_BTN", f"已向 WebActionBar 注入「译」按钮 (触发源: {source})")

            try:
                RunnableCls = find_class("java.lang.Runnable")
                if RunnableCls is not None:
                    host_self = self

                    class _AdjustPos(dynamic_proxy(RunnableCls)):
                        def run(self):
                            host_self._reposition_av_btn(bar_view, btn)

                    bar_view.postDelayed(_AdjustPos(), 120)
                    bar_view.postDelayed(_AdjustPos(), 420)
            except BaseException:
                pass
        except BaseException as err:
            self._log("ERROR", f"注入 WebActionBar 按钮失败: {err}")

    def _detect_wab_tabs_clearance(self, bar_view) -> float:
        """检测 WebActionBar 是否展示多标签页计数按钮（部分版本在 Canvas 自绘或由内部按钮控制）"""
        try:
            cls = bar_view.getClass()
            while cls is not None:
                cname = str(cls.getName())
                if cname.startswith(("android.", "java.")):
                    break
                for f in list(cls.getDeclaredFields()):
                    try:
                        fn = str(f.getName()).lower()
                        if "tab" not in fn:
                            continue
                        f.setAccessible(True)
                        val = f.get(bar_view)
                        if val is None:
                            continue
                        if isinstance(val, bool) and val:
                            return 44.0
                        if isinstance(val, int) and val > 0:
                            return 44.0
                        if hasattr(val, "getVisibility") and int(val.getVisibility()) == View.VISIBLE:
                            if hasattr(val, "getWidth") and int(val.getWidth()) > 0:
                                return 44.0
                    except BaseException:
                        continue
                cls = cls.getSuperclass()
        except BaseException:
            pass

        # 辅助检测 ArticleViewer 是否存在多标签页集合
        viewer = self._av_instance
        if viewer is not None:
            try:
                for f in list(viewer.getClass().getDeclaredFields()):
                    fn = str(f.getName()).lower()
                    if "sheet" in fn or "tab" in fn:
                        f.setAccessible(True)
                        val = f.get(viewer)
                        if val is not None and hasattr(val, "size"):
                            if int(val.size()) > 0:
                                return 44.0
            except BaseException:
                pass
        return 0.0

    def _reposition_av_btn(self, bar_view, btn):
        try:
            if bar_view is None or btn is None:
                return
            bar_w = int(bar_view.getWidth())
            bar_h = int(bar_view.getHeight())
            if bar_w <= 0 or bar_h <= 0:
                return
            dp_unit = float(bar_view.getContext().getResources().getDisplayMetrics().density)
            max_icon_w = int(round(68 * dp_unit))
            rects = []

            def _maybe_add_rect(v_obj, off_x=0, off_y=0):
                if v_obj is None or v_obj == btn:
                    return
                try:
                    if int(v_obj.getVisibility()) != View.VISIBLE or v_obj.getTag() == AV_BTN_TAG:
                        return
                    if hasattr(v_obj, "getAlpha") and float(v_obj.getAlpha()) < 0.05:
                        return
                    l = off_x + int(v_obj.getLeft())
                    t = off_y + int(v_obj.getTop())
                    r = off_x + int(v_obj.getRight())
                    b = off_y + int(v_obj.getBottom())
                    w = r - l
                    h = b - t
                    if w <= 0 or h <= 0 or w > max_icon_w:
                        return
                    if l > bar_w * 0.44:
                        rects.append((l, t, r, b))
                except BaseException:
                    pass

            cnt = int(bar_view.getChildCount())
            for i in range(cnt):
                ch = bar_view.getChildAt(i)
                if ch is None or ch == btn:
                    continue
                try:
                    if int(ch.getVisibility()) != View.VISIBLE or ch.getTag() == AV_BTN_TAG:
                        continue
                    l, t, r, b = int(ch.getLeft()), int(ch.getTop()), int(ch.getRight()), int(ch.getBottom())
                    w = r - l
                    cname = str(ch.getClass().getName())
                    if (ch.isClickable() or "ImageView" in cname or "WebActionBar$" in cname or "Tab" in cname) and 0 < w <= max_icon_w:
                        _maybe_add_rect(ch)
                    elif hasattr(ch, "getChildCount"):
                        sub_cnt = int(ch.getChildCount())
                        for j in range(min(sub_cnt, 16)):
                            sub = ch.getChildAt(j)
                            if sub is not None and sub != btn:
                                _maybe_add_rect(sub, off_x=l, off_y=t)
                except BaseException:
                    continue

            # 反射扫描 WebActionBar 内部可能存在的多标签/图标 Rect 或 View 字段
            try:
                cls = bar_view.getClass()
                while cls is not None:
                    cname = str(cls.getName())
                    if cname.startswith(("android.", "java.")):
                        break
                    for f in list(cls.getDeclaredFields()):
                        try:
                            fn = str(f.getName()).lower()
                            if not any(k in fn for k in ("tab", "menu", "collapse", "forward", "share", "search", "close", "btn", "button")):
                                continue
                            f.setAccessible(True)
                            val = f.get(bar_view)
                            if val is None or val == btn:
                                continue
                            if hasattr(val, "getLeft") and hasattr(val, "getVisibility"):
                                _maybe_add_rect(val)
                            elif hasattr(val, "left") and hasattr(val, "right") and hasattr(val, "top") and hasattr(val, "bottom"):
                                rl, rt, rr, rb = int(val.left), int(val.top), int(val.right), int(val.bottom)
                                if 0 < (rr - rl) <= max_icon_w and rl > bar_w * 0.44:
                                    rects.append((rl, rt, rr, rb))
                        except BaseException:
                            continue
                    cls = cls.getSuperclass()
            except BaseException:
                pass

            extra_dp = self._detect_wab_tabs_clearance(bar_view)
            btn_h = int(btn.getHeight()) or AndroidUtilities.dp(28)
            rm, tm = _compute_wab_btn_margins(bar_w, bar_h, rects, btn_h, dp_unit, extra_right_clearance_dp=extra_dp)
            lp = btn.getLayoutParams()
            if lp is not None:
                tol = max(2, int(round(2 * dp_unit)))
                if abs(int(lp.rightMargin) - rm) > tol or abs(int(lp.topMargin) - tm) > tol:
                    lp.rightMargin = rm
                    lp.topMargin = tm
                    btn.setLayoutParams(lp)
                    btn.bringToFront()
        except BaseException:
            pass

    def _cleanup_injected_buttons(self):
        for entry in list(self._injected_bars):
            try:
                bar = entry[0]
                btn = entry[1]
                listener = entry[2] if len(entry) > 2 else None
                if bar is not None and listener is not None:
                    try:
                        bar.removeOnLayoutChangeListener(listener)
                    except BaseException:
                        pass
                if bar is not None and btn is not None:
                    bar.removeView(btn)
            except BaseException:
                pass
        self._injected_bars = []
        self._injected_bar_ids = set()

    def _read_wab_meta(self, bar_view):
        """从 WebActionBar 实例字段反射读取 title / subtitle / url（兼容自绘标题栏）"""
        title = ""
        subtitle = ""
        url = ""
        if bar_view is None:
            return title, subtitle, url
        try:
            cls = bar_view.getClass()
            # 向上扫描到 WebActionBar 基类
            while cls is not None:
                cname = str(cls.getName())
                if cname.startswith(("android.", "java.")):
                    break
                for f in list(cls.getDeclaredFields()):
                    try:
                        fn = str(f.getName()).lower()
                        if not any(k in fn for k in ("title", "url", "sub", "address", "host")):
                            continue
                        f.setAccessible(True)
                        val = f.get(bar_view)
                        if val is None:
                            continue
                        s = ""
                        if isinstance(val, str):
                            s = val.strip()
                        elif hasattr(val, "getText"):
                            s = str(val.getText() or "").strip()
                        elif "Text" in str(val.getClass().getSimpleName()) and hasattr(val, "toString"):
                            cand = str(val.toString() or "").strip()
                            if cand and "@" not in cand:
                                s = cand
                        if not s or s == "译":
                            continue
                        if s.lower().startswith(("http://", "https://")) and not url:
                            url = s
                        elif "sub" in fn and not subtitle:
                            subtitle = s
                        elif "title" in fn and not title:
                            title = s
                    except BaseException:
                        continue
                cls = cls.getSuperclass()
        except BaseException:
            pass

        if not title:
            title = self._read_bar_title(bar_view)
        return title, subtitle, url

    def _on_av_btn_click(self, bar_view, force_picker: bool = False):
        try:
            self._log("WAB_CLICK", f"点击顶栏「译」按钮 (长按选方式={force_picker})")
            root_view = bar_view.getRootView() if bar_view is not None else None
            bar_title, bar_sub, bar_url = self._read_wab_meta(bar_view)

            # ===== 优先判定 1：当前窗口是可见的在线网页 WebView（严防与之前的本地 .md 串台）=====
            wv = self._find_webview_in_tree(root_view)
            wv_url = ""
            wv_title = ""
            if wv is not None:
                try:
                    wv_url = str(wv.getUrl() or "").strip()
                    wv_title = str(wv.getTitle() or "").strip()
                except BaseException:
                    pass

            active_web_url = ""
            if wv_url.lower().startswith(("http://", "https://")):
                active_web_url = wv_url
            elif bar_url.lower().startswith(("http://", "https://")):
                active_web_url = bar_url
            elif self._av_mode == "web" and (time.monotonic() - self._av_last_web_ts) < 1800:
                if self._av_last_web_url.lower().startswith(("http://", "https://")):
                    active_web_url = self._av_last_web_url
                elif bar_sub and "." in bar_sub and not self._is_supported_text_doc(bar_sub):
                    active_web_url = "https://" + bar_sub.strip()

            if active_web_url:
                self._log("WAB_WEB", f"识别为在线网页上下文: {self._short_url(active_web_url, 48)}")
                if self.is_translated_url(active_web_url) and not force_picker:
                    if ".translate.goog" in active_web_url.lower():
                        orig = self.from_translate_url(active_web_url)
                        if orig and orig != active_web_url:
                            if wv is not None:
                                wv.loadUrl(orig)
                            else:
                                self._open_raw_url_in_builtin(orig)
                            self._mark_av_web_context(orig)
                            BulletinHelper.show_info("已切回原网页")
                            return
                    BulletinHelper.show_info("当前已在谷歌翻译页（长按「译」可选更多操作）")
                    return

                if not force_picker:
                    # 在内置浏览器里短按「译」，直接将当前外语网页切为谷歌网页翻译
                    tr_url = self.to_translate_url(active_web_url, bypass_check=True)
                    if tr_url and tr_url != active_web_url and wv is not None:
                        wv.loadUrl(tr_url)
                        BulletinHelper.show_info("正在切换至谷歌网页翻译…")
                        return
                    self._open_url_by_mode(active_web_url, force_trans=True)
                    return

                # 长按在线网页的「译」：提取网页正文供选择阅读器/电报译/整页翻译
                final_title = wv_title or bar_title or "当前网页"
                if wv is not None and self._extract_text_from_webview_async(
                    wv,
                    lambda txt, t=final_title, u=active_web_url: self._show_av_method_picker(
                        t, (txt or "").strip() or u, False, u, None
                    ),
                ):
                    return
                self._show_av_method_picker(final_title, active_web_url, False, active_web_url, None)
                return

            # ===== 判定 2：电报原生即时预览（TLRPC$WebPage）与本地文档（严格隔离上下文防串台）=====
            doc_path, doc_name, doc_msg, page_text, page_url, page_title = self._extract_from_av_instance()

            # 情况 2A：识别为原生即时预览页面（无本地文档，命中 live WebPage URL 或最近 IV 上下文）
            iv_url = ""
            iv_title = ""
            iv_wp = None
            if not doc_path:
                if page_url and page_url.lower().startswith(("http://", "https://")):
                    iv_url = page_url
                    iv_title = page_title or bar_title or "即时预览"
                elif self._av_mode == "iv" and self._av_last_iv is not None:
                    lu, lt, lwp, lts = self._av_last_iv
                    if lu and (time.monotonic() - lts) < 1800:
                        iv_url = lu
                        iv_title = lt or bar_title or "即时预览"
                        iv_wp = lwp

            if iv_url and not doc_path:
                iv_click_mode = self._get_iv_click_mode()
                self._log("IV_CLICK", f"即时预览点击「译」: {self._short_url(iv_url, 48)} (模式={iv_click_mode}, 长按={force_picker})")
                iv_text = page_text
                if (not iv_text or len(iv_text.strip()) < 10) and iv_wp is not None:
                    iv_text = _extract_tg_page_blocks(iv_wp)
                if not iv_text or len(iv_text.strip()) < 10:
                    iv_text = self._collect_visible_text_from_tree(root_view, skip_view=bar_view)
                iv_text_clean = (iv_text or "").strip()

                if force_picker:
                    self._show_av_method_picker(
                        iv_title,
                        iv_text_clean or iv_url,
                        is_md=bool(iv_text_clean),
                        url=iv_url,
                        msg_obj=None,
                        prefer_web_first=(iv_click_mode == "web"),
                    )
                    return

                if iv_click_mode == "web":
                    BulletinHelper.show_info("正在跳转谷歌网页翻译…")
                    self._open_url_by_mode(iv_url, force_trans=True)
                    return

                # 文档模式翻译：提取结构化 Markdown 走全屏阅读器/电报译 + 持久化缓存；若无正文自动回退网页翻译
                if len(iv_text_clean) >= 10:
                    self._log("IV_DOC", f"即时预览按文档模式翻译: {iv_title} ({len(iv_text_clean)} 字)")
                    self._execute_av_translation(
                        title=iv_title,
                        text=iv_text_clean,
                        is_md=True,
                        url=iv_url,
                        msg_obj=None,
                        force_picker=False,
                    )
                    return

                BulletinHelper.show_info("未提取到正文，自动切换谷歌网页翻译…")
                self._open_url_by_mode(iv_url, force_trans=True)
                return

            title = doc_name or page_title or bar_title or "查看器文档"

            # 仅在当前上下文确认为本地文档时，允许回退到最近捕获的本地文档（绝不与网页/即时预览串台）
            if not doc_path and self._av_mode == "doc" and self._av_last_doc is not None:
                lp, ln, lm, lts = self._av_last_doc
                if lp and os.path.isfile(lp) and (time.monotonic() - lts) < 1200:
                    doc_path, doc_name, doc_msg = lp, ln, lm
                    title = ln or title

            # 情况 A：命中本地 .md / .txt 文件（全文最完整，支持持久化缓存）
            if doc_path and os.path.isfile(doc_path) and self._is_supported_text_doc(doc_name or doc_path):
                content, err = _read_text_file_safe(doc_path)
                if err is None and content is not None and content.strip():
                    ext = os.path.splitext((doc_name or doc_path).lower())[1]
                    is_md = ext in (".md", ".markdown")
                    if ext in (".html", ".htm"):
                        content = _strip_html_to_readable(content)
                        is_md = False
                    self._log("WAB_EXTRACT", f"从本地文档提取全文: {doc_name} ({len(content)} 字)")
                    self._execute_av_translation(
                        title=doc_name or os.path.basename(doc_path),
                        text=content,
                        is_md=is_md,
                        url=page_url,
                        msg_obj=doc_msg,
                        force_picker=force_picker,
                    )
                    return

            # 情况 B：本地 HTML/非 http WebView 提取
            if wv is not None:
                if self._extract_text_from_webview_async(
                    wv,
                    lambda txt, t=(wv_title or title), u=page_url, m=doc_msg, fp=force_picker, pt=page_text, rv=root_view, bv=bar_view: self._on_webview_text_ready(
                        txt, t, u, m, fp, pt, rv, bv
                    ),
                ):
                    return

            # 情况 C：回退到 TLRPC.Page 块提取 或 可见 TextView 文本收集
            extracted = page_text
            is_md_guess = bool(page_text)
            if not extracted or len(extracted.strip()) < 10:
                extracted = self._collect_visible_text_from_tree(root_view, skip_view=bar_view)
                is_md_guess = False

            if extracted and extracted.strip():
                self._log("WAB_EXTRACT", f"从查看器页面结构提取文本 ({len(extracted)} 字)")
                self._execute_av_translation(
                    title=title,
                    text=extracted,
                    is_md=is_md_guess,
                    url=page_url,
                    msg_obj=doc_msg,
                    force_picker=force_picker,
                )
                return

            if page_url and page_url.lower().startswith(("http://", "https://")):
                self._open_url_by_mode(page_url, force_trans=True)
                return

            summary = self._summarize_view_tree(root_view)
            self._log("WARN", f"未在当前查看器提取到文本 | 视图摘要: {summary}")
            BulletinHelper.show_info("未在当前页面提取到正文，可长按消息选「阅读并翻译文档」")
        except BaseException as err:
            self._log("ERROR", f"顶栏「译」按钮点击异常: {err}")
            BulletinHelper.show_error(f"翻译触发失败: {err}")

    def _on_webview_text_ready(self, js_text, title, url, msg_obj, force_picker, fallback_page_text, root_view, bar_view):
        txt = (js_text or "").strip()
        if not txt and fallback_page_text:
            txt = fallback_page_text.strip()
        if not txt:
            txt = self._collect_visible_text_from_tree(root_view, skip_view=bar_view)

        if txt:
            self._log("WAB_EXTRACT", f"从 WebView 提取正文成功 ({len(txt)} 字)")
            is_md = title.lower().endswith((".md", ".markdown"))
            self._execute_av_translation(
                title=title,
                text=txt,
                is_md=is_md,
                url=url,
                msg_obj=msg_obj,
                force_picker=force_picker,
            )
        elif url and url.lower().startswith(("http://", "https://")):
            self._open_url_by_mode(url, force_trans=True)
        else:
            BulletinHelper.show_info("未能从当前页面提取到可翻译文本")

    def _execute_av_translation(self, title: str, text: str, is_md: bool, url: str = "", msg_obj=None, force_picker: bool = False):
        clean_text = (text or "").strip()
        if not clean_text:
            BulletinHelper.show_info("当前页面没有可翻译的文本")
            return

        if force_picker:
            self._show_av_method_picker(title, clean_text, is_md, url, msg_obj)
            return

        engine = self._get_doc_engine()
        if engine == "chunk_reader":
            self.open_text_reader(title, clean_text, is_md=is_md, is_plain=(not is_md), auto_translate=True, msg_obj=msg_obj, source_url=url)
            return
        if engine == "tg_native":
            if len(clean_text) <= 4000 and self._open_tg_native_translate(clean_text):
                return
            self.open_text_reader(title, clean_text, is_md=is_md, is_plain=(not is_md), auto_translate=True, msg_obj=msg_obj, source_url=url)
            return
        if engine == "google_web":
            if len(clean_text) <= 3200:
                self._open_google_web_text(clean_text)
                return
            self.open_text_reader(title, clean_text, is_md=is_md, is_plain=(not is_md), auto_translate=True, msg_obj=msg_obj, source_url=url)
            return

        # 智能优先级：Markdown 或中长文本进全屏流畅阅读器（首屏秒出+缓存）；短纯文本优先电报原生面板
        if is_md or len(clean_text) > 1800:
            self.open_text_reader(title, clean_text, is_md=is_md, is_plain=(not is_md), auto_translate=True, msg_obj=msg_obj, source_url=url)
        else:
            if not self._open_tg_native_translate(clean_text):
                self.open_text_reader(title, clean_text, is_md=is_md, is_plain=(not is_md), auto_translate=True, msg_obj=msg_obj, source_url=url)

    def _show_av_method_picker(self, title: str, text: str, is_md: bool, url: str = "", msg_obj=None, prefer_web_first: bool = False):
        try:
            act = _get_activity()
            if act is None:
                if prefer_web_first and url:
                    self._open_url_by_mode(url, force_trans=True)
                else:
                    self.open_text_reader(title, text, is_md=is_md, is_plain=(not is_md), auto_translate=True, msg_obj=msg_obj)
                return

            has_web_url = bool(url and url.lower().startswith(("http://", "https://")) and not self.is_translated_url(url))
            actions = []
            if prefer_web_first and has_web_url:
                actions.append(("谷歌整页网页翻译（当前网址）", "web_page"))
            actions.extend([
                ("全屏流畅阅读器（首屏秒出 + 自动缓存）", "reader"),
                ("重新翻译（忽略本地缓存）", "retranslate"),
                ("电报自带翻译面板（适合中短文本）", "tg_native"),
                ("谷歌在线文本翻译网页", "google_text"),
                ("复制当前提取的原文", "copy"),
            ])
            if not prefer_web_first and has_web_url:
                actions.append(("谷歌整页网页翻译（当前网址）", "web_page"))

            items = [a[0] for a in actions]
            builder = AlertDialogBuilder(act)
            builder.set_title(f"选择翻译方式 ({len(text)} 字)")

            def _on_pick(d, which):
                try:
                    idx = int(which)
                    if not (0 <= idx < len(actions)):
                        return
                    act_key = actions[idx][1]
                    if act_key == "web_page":
                        self._open_url_by_mode(url, force_trans=True)
                    elif act_key == "reader":
                        self.open_text_reader(title, text, is_md=is_md, is_plain=(not is_md), auto_translate=True, msg_obj=msg_obj, source_url=url)
                    elif act_key == "retranslate":
                        self.open_text_reader(title, text, is_md=is_md, is_plain=(not is_md), auto_translate=True, force_retranslate=True, msg_obj=msg_obj, source_url=url)
                    elif act_key == "tg_native":
                        if not self._open_tg_native_translate(text):
                            BulletinHelper.show_info("未调起电报自带翻译，已切换至全屏阅读器")
                            self.open_text_reader(title, text, is_md=is_md, is_plain=(not is_md), auto_translate=True, msg_obj=msg_obj, source_url=url)
                    elif act_key == "google_text":
                        self._open_google_web_text(text)
                    elif act_key == "copy":
                        self._copy_to_clipboard(text, "已复制提取的原文到剪贴板")
                except BaseException as err:
                    self._log("ERROR", f"执行翻译方式失败: {err}")

            builder.set_items(items, _on_pick)
            builder.set_negative_button("取消", None)
            builder.show()
        except BaseException as err:
            self._log("ERROR", f"弹出翻译方式选择器失败: {err}")
            self.open_text_reader(title, text, is_md=is_md, is_plain=(not is_md), auto_translate=True, msg_obj=msg_obj)

    def _extract_from_av_instance(self):
        doc_path = ""
        doc_name = ""
        doc_msg = None
        page_text = ""
        page_url = ""
        page_title = ""

        viewer = self._av_instance
        if viewer is None and ArticleViewer is not None:
            try:
                if hasattr(ArticleViewer, "getInstance"):
                    viewer = ArticleViewer.getInstance()
            except BaseException:
                viewer = None
        if viewer is None:
            return doc_path, doc_name, doc_msg, page_text, page_url, page_title

        try:
            for f in list(viewer.getClass().getDeclaredFields()):
                try:
                    fname = str(f.getName()).lower()
                    ft = str(f.getType().getName())
                    if not (
                        "messageobject" in ft.lower()
                        or "webpage" in ft.lower()
                        or "page" in fname
                        or "url" in fname
                        or "file" in fname
                        or "title" in fname
                        or "current" in fname
                    ):
                        continue
                    f.setAccessible(True)
                    val = f.get(viewer)
                    if val is None:
                        continue
                    vc = str(val.getClass().getName())

                    # 兼容 pagesStack / pages ArrayList：取栈顶当前正在展示的页面对象
                    if hasattr(val, "size") and hasattr(val, "get") and ("page" in fname or "stack" in fname):
                        try:
                            sz = int(val.size())
                            if sz > 0:
                                val = val.get(sz - 1)
                                if val is None:
                                    continue
                                vc = str(val.getClass().getName())
                        except BaseException:
                            continue

                    if "MessageObject" in vc:
                        if doc_msg is None:
                            mp, mn = self._resolve_message_document(val)
                            if mp or mn:
                                doc_path, doc_name, doc_msg = mp, mn, val
                        if not page_url:
                            wu, wt, wp = self._extract_webpage_info(val)
                            if wu:
                                page_url = wu
                            if wt and not page_title:
                                page_title = wt
                            if wp is not None and not page_text:
                                t = _extract_tg_page_blocks(wp)
                                if t:
                                    page_text = t
                    elif vc == "java.io.File" and not doc_path:
                        cand = str(val.getAbsolutePath())
                        if os.path.isfile(cand):
                            doc_path = cand
                            doc_name = str(val.getName())
                    elif isinstance(val, str):
                        s = val.strip()
                        if s.lower().startswith(("http://", "https://")) and not page_url:
                            page_url = s
                        elif "title" in fname and s and not page_title:
                            page_title = s
                    elif "TLRPC$Page" in vc or "TLRPC$WebPage" in vc or "TL_page" in vc or "TL_webPage" in vc:
                        if not page_text:
                            t = _extract_tg_page_blocks(val)
                            if t:
                                page_text = t
                        if not page_url:
                            wu, wt, _ = self._extract_webpage_info(val)
                            if wu:
                                page_url = wu
                            if wt and not page_title:
                                page_title = wt
                except BaseException:
                    continue
        except BaseException:
            pass

        return doc_path, doc_name, doc_msg, page_text, page_url, page_title

    def _read_bar_title(self, bar_view) -> str:
        if bar_view is None:
            return ""
        texts = []

        def _walk(v, depth=0):
            if v is None or depth > 5:
                return
            try:
                if v.getTag() == AV_BTN_TAG:
                    return
                if hasattr(v, "getText"):
                    t = str(v.getText() or "").strip()
                    if t and t != "译":
                        texts.append(t)
                if hasattr(v, "getChildCount"):
                    for i in range(min(int(v.getChildCount()), 20)):
                        _walk(v.getChildAt(i), depth + 1)
            except BaseException:
                pass

        _walk(bar_view)
        return texts[0] if texts else ""

    def _is_webview_instance(self, v) -> bool:
        if v is None:
            return False
        try:
            if hasattr(v, "evaluateJavascript") and hasattr(v, "getUrl"):
                return True
            cls = v.getClass()
            while cls is not None:
                cn = str(cls.getName())
                if "WebView" in cn:
                    return True
                if cn in ("android.view.View", "java.lang.Object"):
                    break
                cls = cls.getSuperclass()
        except BaseException:
            pass
        return False

    def _find_webview_in_tree(self, root_view):
        if root_view is None:
            return None
        best = [None]
        fallback = [None]
        budget = [1200]

        def _walk(v, depth=0):
            if v is None or best[0] is not None or depth > 18 or budget[0] <= 0:
                return
            budget[0] -= 1
            try:
                if self._is_webview_instance(v):
                    if int(v.getVisibility()) == View.VISIBLE:
                        u = ""
                        try:
                            u = str(v.getUrl() or "").strip()
                        except BaseException:
                            u = ""
                        if u.lower().startswith(("http://", "https://")):
                            best[0] = v
                            return
                        if fallback[0] is None:
                            fallback[0] = v
                if hasattr(v, "getChildCount"):
                    cnt = int(v.getChildCount())
                    for i in range(min(cnt, 80)):
                        _walk(v.getChildAt(i), depth + 1)
            except BaseException:
                pass

        _walk(root_view)
        return best[0] if best[0] is not None else fallback[0]

    def _extract_text_from_webview_async(self, webview, callback) -> bool:
        try:
            ValCbCls = find_class("android.webkit.ValueCallback")
            if ValCbCls is None:
                return False

            class _JsCb(dynamic_proxy(ValCbCls)):
                def onReceiveValue(self, value):
                    parsed = ""
                    try:
                        if value is not None:
                            s = str(value)
                            if s and s != "null":
                                try:
                                    parsed = json.loads(s)
                                    if not isinstance(parsed, str):
                                        parsed = str(parsed)
                                except BaseException:
                                    parsed = s.strip('"')
                    except BaseException:
                        parsed = ""
                    run_on_ui_thread(lambda p=parsed: callback(p))

            js = "(function(){try{var b=document.body;return b?(b.innerText||b.textContent||''):'';}catch(e){return '';}})()"
            webview.evaluateJavascript(js, _JsCb())
            return True
        except BaseException as err:
            self._log("WARN", f"WebView JS 取文失败: {err}")
            return False

    def _collect_visible_text_from_tree(self, root_view, skip_view=None) -> str:
        if root_view is None:
            return ""
        chunks = []
        seen = set()
        budget = [400]

        def _walk(v, depth=0):
            if v is None or v == skip_view or depth > 12 or budget[0] <= 0:
                return
            budget[0] -= 1
            try:
                if int(v.getVisibility()) != View.VISIBLE:
                    return
                if v.getTag() == AV_BTN_TAG:
                    return
                cname = str(v.getClass().getName())
                if "WebActionBar" in cname:
                    return
                if hasattr(v, "getText"):
                    t = str(v.getText() or "").strip()
                    if len(t) >= 2 and t not in seen:
                        seen.add(t)
                        chunks.append(t)
                if hasattr(v, "getChildCount"):
                    cnt = int(v.getChildCount())
                    for i in range(min(cnt, 50)):
                        _walk(v.getChildAt(i), depth + 1)
            except BaseException:
                pass

        _walk(root_view)
        return "\n\n".join(chunks)

    def _summarize_view_tree(self, root_view) -> str:
        if root_view is None:
            return "(root=None)"
        names = []
        budget = [60]

        def _walk(v, depth=0):
            if v is None or depth > 6 or budget[0] <= 0:
                return
            budget[0] -= 1
            try:
                cname = str(v.getClass().getSimpleName()) or str(v.getClass().getName())
                names.append(cname)
                if hasattr(v, "getChildCount"):
                    for i in range(min(int(v.getChildCount()), 8)):
                        _walk(v.getChildAt(i), depth + 1)
            except BaseException:
                pass

        _walk(root_view)
        return " > ".join(names[:18])

    def _open_url_by_mode(self, raw_url: str, force_trans: bool = True):
        mode = self._get_open_mode()
        if mode == "float":
            self.show_translated_float(raw_url, force_trans=force_trans)
        else:
            self._open_in_builtin_browser(raw_url, force_trans=force_trans)

    # ==================== 消息菜单与消息文档解析 ====================
    def _on_message_menu_click(self, context):
        try:
            if not self.get_setting("doc_translate_enabled", True):
                BulletinHelper.show_info("请先在插件设置中开启「启用文档与文本翻译」")
                return
            msg_obj = None
            if isinstance(context, dict):
                msg_obj = context.get("message") or context.get("messageObject")
            else:
                msg_obj = getattr(context, "message", None)
            if msg_obj is None:
                BulletinHelper.show_info("未获取到消息内容")
                return
            run_on_ui_thread(lambda m=msg_obj: self._handle_message_object(m))
        except BaseException as err:
            self._log("ERROR", f"消息菜单点击异常: {err}")
            BulletinHelper.show_error(f"打开失败: {err}")

    def _handle_message_object(self, msg_obj):
        file_path, file_name = self._resolve_message_document(msg_obj)
        if file_name or file_path:
            if not self._is_supported_text_doc(file_name or file_path):
                BulletinHelper.show_info(f"暂不支持翻译该文件格式: {file_name or os.path.basename(file_path)}")
                return
            if not file_path or not os.path.isfile(file_path):
                BulletinHelper.show_info("请先点击下载该文档，再打开阅读翻译")
                return
            self.open_document_file(file_path, file_name or os.path.basename(file_path), msg_obj=msg_obj, auto_translate=True)
            return

        msg_text = self._extract_message_text(msg_obj)
        if msg_text:
            self._dispatch_plain_text(msg_text, title="消息文本翻译")
        else:
            BulletinHelper.show_info("该消息不含可翻译的文档或文字")

    def _extract_message_text(self, msg_obj) -> str:
        try:
            t = getattr(msg_obj, "messageText", None)
            if t is not None and str(t).strip():
                return str(t).strip()
            owner = getattr(msg_obj, "messageOwner", None)
            if owner is not None:
                mt = getattr(owner, "message", None)
                if mt is not None and str(mt).strip():
                    return str(mt).strip()
        except BaseException:
            pass
        return ""

    def _resolve_message_document(self, msg_obj):
        file_name = ""
        file_path = ""
        try:
            doc = None
            if hasattr(msg_obj, "getDocument"):
                doc = msg_obj.getDocument()
            if doc is None:
                owner = getattr(msg_obj, "messageOwner", None)
                media = getattr(owner, "media", None) if owner is not None else None
                doc = getattr(media, "document", None) if media is not None else None

            if hasattr(msg_obj, "getDocumentName"):
                dn = msg_obj.getDocumentName()
                if dn:
                    file_name = str(dn).strip()

            if not file_name and doc is not None and FileLoader is not None:
                try:
                    dn = FileLoader.getDocumentFileName(doc)
                    if dn:
                        file_name = str(dn).strip()
                except BaseException:
                    pass

            owner = getattr(msg_obj, "messageOwner", None)
            if owner is not None:
                ap = getattr(owner, "attachPath", None)
                if ap and os.path.isfile(str(ap)):
                    file_path = str(ap)

            if not file_path and FileLoader is not None:
                acc = _get_current_account()
                fl = FileLoader.getInstance(acc)
                if fl is not None:
                    if owner is not None:
                        try:
                            f_obj = fl.getPathToMessage(owner)
                            if f_obj is not None:
                                cand = str(f_obj.getAbsolutePath())
                                if os.path.isfile(cand):
                                    file_path = cand
                        except BaseException:
                            pass
                    if not file_path and doc is not None:
                        try:
                            f_obj = fl.getPathToAttach(doc, True)
                            if f_obj is not None:
                                cand = str(f_obj.getAbsolutePath())
                                if os.path.isfile(cand):
                                    file_path = cand
                        except BaseException:
                            pass
        except BaseException as err:
            self._log("ERROR", f"解析文档路径异常: {err}")
        return file_path, file_name

    def _is_supported_text_doc(self, name_or_path: str) -> bool:
        s = (name_or_path or "").strip().lower()
        if not s:
            return False
        _, ext = os.path.splitext(s)
        return ext in TEXT_DOC_EXTENSIONS

    def _is_bypassed(self) -> bool:
        return time.monotonic() < self._bypass_until

    def _is_doc_bypassed(self) -> bool:
        return time.monotonic() < self._doc_bypass_until

    def _get_open_mode(self) -> str:
        idx = self.get_setting("open_mode_idx", 0)
        if isinstance(idx, int) and 0 <= idx < len(OPEN_MODE_ITEMS):
            return OPEN_MODE_ITEMS[idx][1]
        return "builtin"

    def _get_doc_engine(self) -> str:
        idx = self.get_setting("doc_engine_idx", 0)
        if isinstance(idx, int) and 0 <= idx < len(DOC_ENGINE_ITEMS):
            return DOC_ENGINE_ITEMS[idx][1]
        return "auto"

    def _get_iv_click_mode(self) -> str:
        idx = self.get_setting("iv_click_mode_idx", 0)
        if isinstance(idx, int) and 0 <= idx < len(IV_CLICK_MODE_ITEMS):
            return IV_CLICK_MODE_ITEMS[idx][1]
        return "doc"

    def _target_lang(self) -> str:
        custom = str(self.get_setting("custom_lang_code", "") or "").strip()
        if custom and re.match(r"^[a-zA-Z]{2,3}(-[a-zA-Z0-9]{2,8})*$", custom):
            return custom
        idx = self.get_setting("lang_idx", 0)
        if isinstance(idx, int) and 0 <= idx < len(GOOGLE_TRANSLATE_LANGUAGES):
            return GOOGLE_TRANSLATE_LANGUAGES[idx][1]
        return "zh-CN"

    def _tg_native_lang(self) -> str:
        lang = self._target_lang()
        low = lang.lower()
        if low in ("zh-cn", "zh-hans"):
            return "zh"
        if low in ("zh-tw", "zh-hant", "zh-hk"):
            return "zh-TW"
        return lang.split("-")[0] if "-" in lang else lang

    def _parse_domain_list(self, setting_key: str):
        raw = str(self.get_setting(setting_key, "") or "")
        out = []
        for item in re.split(r"[,，;\s]+", raw):
            d = item.strip().lower()
            if not d:
                continue
            if "://" in d:
                try:
                    d = (urllib.parse.urlsplit(d).hostname or "").lower()
                except BaseException:
                    pass
            d = d.lstrip(".").rstrip(".")
            if d:
                out.append(d)
        return out

    def _host_matches(self, host: str, domain_list) -> bool:
        for d in domain_list:
            if host == d or host.endswith("." + d):
                return True
        return False

    def is_telegram_domain(self, host: str) -> bool:
        return any(host == d or host.endswith("." + d) for d in TELEGRAM_ROOT_DOMAINS)

    def is_translated_url(self, url: str) -> bool:
        try:
            host = (urllib.parse.urlsplit(url).hostname or "").lower().rstrip(".")
            return host.endswith(".translate.goog") or host in (
                "translate.google.com",
                "translate.googleusercontent.com",
            )
        except BaseException:
            return False

    def should_translate_url(self, url: str) -> bool:
        try:
            p = urllib.parse.urlsplit(url.strip())
            if (p.scheme or "").lower() not in ("http", "https"):
                return False
            host = (p.hostname or "").lower().rstrip(".")
            if not host or p.port is not None:
                return False
            if self.is_translated_url(url):
                return False
            if host == "localhost" or re.match(r"^[\d.:]+$", host):
                return False

            skip_list = self._parse_domain_list("skip_domains")
            if self._host_matches(host, skip_list):
                return False

            whitelist = self._parse_domain_list("force_whitelist")
            in_whitelist = self._host_matches(host, whitelist)

            if self.is_telegram_domain(host):
                path = (p.path or "").strip()
                has_subpath = bool(path and path != "/") or bool(p.query)
                if has_subpath:
                    return False
                return in_whitelist

            return True
        except BaseException:
            return False

    def to_translate_url(self, url: str, bypass_check: bool = False) -> str:
        try:
            if not bypass_check and not self.should_translate_url(url):
                return url
            p = urllib.parse.urlsplit(url.strip())
            scheme = (p.scheme or "").lower()
            if scheme not in ("http", "https"):
                return url
            host = (p.hostname or "").lower().rstrip(".")
            if not host or p.port is not None or self.is_translated_url(url):
                return url
            if host == "localhost" or re.match(r"^[\d.:]+$", host):
                return url

            try:
                ascii_host = host.encode("idna").decode("ascii")
            except BaseException:
                ascii_host = host

            trans_host = ascii_host.replace("-", "--").replace(".", "-") + ".translate.goog"
            lang = self._target_lang()
            q = urllib.parse.parse_qs(p.query, keep_blank_values=True)
            q["_x_tr_sl"] = ["auto"]
            q["_x_tr_tl"] = [lang]
            q["_x_tr_hl"] = [lang]
            q["_x_tr_pto"] = ["wapp"]
            if scheme == "http":
                q["_x_tr_sch"] = ["http"]

            path = p.path if p.path else "/"
            return urllib.parse.urlunsplit(
                ("https", trans_host, path, urllib.parse.urlencode(q, doseq=True), p.fragment)
            )
        except BaseException:
            return url

    def to_google_text_translate_url(self, text: str) -> str:
        lang = self._target_lang()
        base = f"https://translate.google.com/?sl=auto&tl={urllib.parse.quote(lang, safe='')}&op=translate"
        s = (text or "").strip()
        if not s:
            return base
        encoded = urllib.parse.quote(s, safe="")
        if len(encoded) <= 4500:
            return base + "&text=" + encoded
        return base

    def from_translate_url(self, url: str) -> str:
        try:
            p = urllib.parse.urlsplit(url.strip())
            host = (p.hostname or "").lower().rstrip(".")
            if not host.endswith(".translate.goog"):
                return url
            raw_host = host[:-len(".translate.goog")]
            orig_host = raw_host.replace("--", "\x00").replace("-", ".").replace("\x00", "-")
            q = urllib.parse.parse_qs(p.query, keep_blank_values=True)
            orig_scheme = "http" if q.get("_x_tr_sch") == ["http"] else "https"
            clean_q = {k: v for k, v in q.items() if not k.startswith("_x_tr_")}
            return urllib.parse.urlunsplit(
                (orig_scheme, orig_host, p.path, urllib.parse.urlencode(clean_q, doseq=True), p.fragment)
            )
        except BaseException:
            return url

    def _extract_url(self, text: str) -> str:
        s = (text or "").strip()
        if not s:
            return ""
        trail_chars = ".,;:!?)]}。，！？》】）\"'"
        if "\n" not in s and len(s.split()) == 1:
            m = re.match(r"^https?://[^\s<>\"']+$", s, re.I)
            if m:
                return s.rstrip(trail_chars)
            tok = s.strip("([{\"'<《【（").rstrip(trail_chars)
            if re.match(r"^[a-zA-Z0-9][-a-zA-Z0-9]{0,62}(\.[a-zA-Z]{2,})+(/.*)?$", tok):
                return "https://" + tok
        return ""

    # ==================== 自定义指令分发（支持网址 / 纯文本 / 回复文档） ====================
    def on_send_message_hook(self, account, params) -> HookResult:
        try:
            if not isinstance(getattr(params, "message", None), str):
                return HookResult()
            raw = params.message.strip()
            if not raw:
                return HookResult()

            cmd = str(self.get_setting("custom_cmd", ".tr") or ".tr").strip() or ".tr"
            parts = raw.split(None, 1)
            if parts[0].lower() != cmd.lower():
                return HookResult()

            mode = self._get_open_mode()
            arg = parts[1].strip() if len(parts) > 1 else ""

            if not arg:
                reply_msg = getattr(params, "replyToMsg", None)
                if reply_msg is not None and self.get_setting("doc_translate_enabled", True):
                    self._log("CMD", f"通过回复指令 {cmd} 触发消息/文档翻译")
                    run_on_ui_thread(lambda m=reply_msg: self._handle_message_object(m))
                    return HookResult(strategy=HookStrategy.CANCEL, params=params)

                if mode == "float" and self._is_window_alive() and self._minimized:
                    run_on_ui_thread(self._expand)
                    return HookResult(strategy=HookStrategy.CANCEL, params=params)

                if self._last_url:
                    target = self._last_url
                    run_on_ui_thread(lambda u=target: self._open_url_by_mode(u, force_trans=True))
                    return HookResult(strategy=HookStrategy.CANCEL, params=params)

                BulletinHelper.show_info(f"用法：{cmd} <网址或文本>，或回复 .md/.txt 消息发 {cmd}")
                return HookResult(strategy=HookStrategy.CANCEL, params=params)

            target_url = self._extract_url(arg)
            if target_url:
                run_on_ui_thread(lambda u=target_url: self._open_url_by_mode(u, force_trans=True))
                return HookResult(strategy=HookStrategy.CANCEL, params=params)

            if not self.get_setting("doc_translate_enabled", True):
                BulletinHelper.show_info("已关闭文本/文档翻译，请在插件设置中开启")
                return HookResult(strategy=HookStrategy.CANCEL, params=params)

            self._log("CMD", f"指令纯文本翻译 ({len(arg)} 字)")
            run_on_ui_thread(lambda t=arg: self._dispatch_plain_text(t, title="指令文本翻译"))
            return HookResult(strategy=HookStrategy.CANCEL, params=params)
        except BaseException as err:
            self._log("ERROR", f"处理指令异常: {err}")
            return HookResult()

    # ==================== 文档与文本优先级路由 ====================
    def _dispatch_plain_text(self, text: str, title: str = "文本翻译"):
        s = (text or "").strip()
        if not s:
            BulletinHelper.show_info("没有可翻译的文本内容")
            return
        engine = self._get_doc_engine()
        n = len(s)

        if engine == "tg_native":
            if n <= 4000 and self._open_tg_native_translate(s):
                return
            self.open_text_reader(title, s, is_md=False, is_plain=True, auto_translate=True)
            return

        if engine == "google_web":
            if n <= 3200:
                self._open_google_web_text(s)
                return
            BulletinHelper.show_info("文本较长，已自动切换至全屏阅读器分段翻译")
            self.open_text_reader(title, s, is_md=False, is_plain=True, auto_translate=True)
            return

        if engine == "chunk_reader":
            self.open_text_reader(title, s, is_md=False, is_plain=True, auto_translate=True)
            return

        if n <= 1800:
            if self._open_tg_native_translate(s):
                return
            self._open_google_web_text(s)
        else:
            self.open_text_reader(title, s, is_md=False, is_plain=True, auto_translate=True)

    def open_document_file(self, file_path: str, file_name: str, msg_obj=None, auto_translate: bool = True):
        content, err = _read_text_file_safe(file_path)
        if err is not None:
            self._log("ERROR", f"读取文档失败({file_name}): {err}")
            BulletinHelper.show_error(err)
            return

        ext = os.path.splitext((file_name or file_path).lower())[1]
        is_html = ext in (".html", ".htm")
        is_md = ext in (".md", ".markdown")
        is_plain = not is_md

        if is_html:
            content = _strip_html_to_readable(content)
            is_md = False
            is_plain = True

        engine = self._get_doc_engine()
        if engine == "tg_native" and len(content) <= 3500 and not is_md:
            if self._open_tg_native_translate(content):
                return
        elif engine == "google_web" and len(content) <= 2800 and not is_md:
            self._open_google_web_text(content)
            return

        self.open_text_reader(
            title=file_name or os.path.basename(file_path),
            raw_text=content,
            is_md=is_md,
            is_plain=is_plain,
            auto_translate=auto_translate,
            msg_obj=msg_obj,
        )

    def _open_google_web_text(self, text: str):
        s = (text or "").strip()
        if not s:
            return
        url = self.to_google_text_translate_url(s)
        if "&text=" not in url:
            self._copy_to_clipboard(s, silent_msg="文本较长已自动复制，请在谷歌翻译页直接粘贴")
        mode = self._get_open_mode()
        self._log("TEXT_WEB", f"跳转谷歌在线文本翻译 ({len(s)} 字, mode={mode})")
        self._mark_av_web_context(url)
        if mode == "float":
            self.show_translated_float(url, force_trans=False)
        else:
            self._open_raw_url_in_builtin(url)

    def _open_raw_url_in_builtin(self, url: str):
        if Browser is None:
            BulletinHelper.show_error("未找到 Browser 类")
            return
        try:
            ctx = _get_activity() or (ApplicationLoader.applicationContext if ApplicationLoader else None)
            if ctx is None:
                return
            self._last_url = url
            self._mark_av_web_context(url)
            self._bypass_until = time.monotonic() + 1.2
            Browser.openUrl(ctx, url)
        except BaseException as err:
            self._log("ERROR", f"打开内置浏览器失败: {err}")
            BulletinHelper.show_error(f"打开内置浏览器失败: {err}")

    def _open_tg_native_translate(self, text: str) -> bool:
        """
        调用电报原生 TranslateAlert2.showAlert 底部翻译面板：
        优先直接静态调用（解决 Chaquopy 反射 Object... 将 int 误装箱为 Long 的问题），
        再辅以强类型 jint / jboolean 反射兜底。
        """
        if TranslateAlert2 is None:
            self._log("WARN", "未找到 TranslateAlert2 类，无法调起电报自带翻译")
            return False
        try:
            act = _get_activity()
            if act is None:
                return False
            frag = None
            try:
                frag = get_last_fragment()
            except BaseException:
                frag = None
            acc = _get_current_account()
            tg_lang = self._tg_native_lang()
            snippet = (text or "").strip()
            if not snippet:
                return False
            truncated = False
            if len(snippet) > 4000:
                snippet = snippet[:4000] + "\n\n……（后文过长，已截取前 4000 字；整篇请用全屏阅读器）"
                truncated = True

            ArrayListCls = find_class("java.util.ArrayList")
            entities = ArrayListCls() if ArrayListCls is not None else None
            acc_arg = jint(acc) if jint is not None else int(acc)
            false_arg = jboolean(False) if jboolean is not None else False

            # 通道 1：直接调用 10 参静态重载 (Context, BaseFragment, int, String, String, CharSequence, ArrayList, boolean, CallbackReturn, Runnable)
            direct_attempts = (
                (act, frag, acc_arg, None, tg_lang, snippet, entities, false_arg, None, None),
                (act, frag, acc_arg, "", tg_lang, snippet, entities, false_arg, None, None),
                (act, frag, int(acc), None, tg_lang, snippet, entities, False, None, None),
            )
            direct_err = ""
            for d_args in direct_attempts:
                try:
                    TranslateAlert2.showAlert(*d_args)
                    self._log("TG_NATIVE", f"已调起电报自带翻译面板 ({len(snippet)} 字, lang={tg_lang})")
                    if truncated:
                        BulletinHelper.show_info("文档较长仅截取前 4000 字，整篇请看全屏阅读器")
                    return True
                except BaseException as err:
                    direct_err = str(err)

            # 通道 2：强类型反射回退（使用 java.jint / java.jboolean 防止变 Long）
            candidates = []
            for m in list(TranslateAlert2.getClass().getDeclaredMethods()):
                if str(m.getName()) != "showAlert":
                    continue
                ptypes = [str(pt.getName()) for pt in list(m.getParameterTypes())]
                candidates.append((m, ptypes))
            candidates.sort(key=lambda item: len(item[1]))

            last_inv_err = direct_err
            for m, ptypes in candidates:
                if not any("CharSequence" in t for t in ptypes):
                    continue
                str_count = sum(1 for t in ptypes if t == "java.lang.String")
                call_args = []
                seen_int = 0
                seen_str = 0
                for t in ptypes:
                    if "android.content.Context" in t or t.endswith("Activity"):
                        call_args.append(act)
                    elif "BaseFragment" in t:
                        call_args.append(frag)
                    elif t in ("int", "java.lang.Integer"):
                        v = acc if seen_int == 0 else 0
                        call_args.append(jint(v) if jint is not None else int(v))
                        seen_int += 1
                    elif t == "java.lang.String":
                        if str_count >= 2:
                            call_args.append(None if seen_str == 0 else tg_lang)
                        else:
                            call_args.append(tg_lang)
                        seen_str += 1
                    elif "CharSequence" in t:
                        call_args.append(snippet)
                    elif "ArrayList" in t:
                        call_args.append(entities)
                    elif t in ("boolean", "java.lang.Boolean"):
                        call_args.append(jboolean(False) if jboolean is not None else False)
                    elif t in ("long", "java.lang.Long"):
                        call_args.append(jlong(0) if jlong is not None else 0)
                    else:
                        call_args.append(None)

                try:
                    m.setAccessible(True)
                    m.invoke(None, *call_args)
                    self._log("TG_NATIVE", f"已调起电报自带翻译面板[反射] ({len(snippet)} 字, lang={tg_lang})")
                    if truncated:
                        BulletinHelper.show_info("文档较长仅截取前 4000 字，整篇请看全屏阅读器")
                    return True
                except BaseException as err:
                    last_inv_err = str(err)
                    continue

            self._log("WARN", f"TranslateAlert2.showAlert 调起失败: {last_inv_err[:160]}")
            return False
        except BaseException as err:
            self._log("ERROR", f"调起电报自带翻译异常: {err}")
            return False

    # ==================== 内置浏览器模式与日志弹窗 ====================
    def _open_in_builtin_browser(self, raw_url: str, force_trans: bool = False):
        if Browser is None:
            self._log("ERROR", "内置浏览器打开失败: 未找到 Browser 类")
            BulletinHelper.show_error("未找到 Browser 类")
            return
        try:
            ctx = _get_activity() or (ApplicationLoader.applicationContext if ApplicationLoader else None)
            if ctx is None:
                self._log("ERROR", "内置浏览器打开失败: Context 为空")
                return
            final_url = self.to_translate_url(raw_url, bypass_check=force_trans)
            self._last_url = final_url
            self._mark_av_web_context(final_url)
            self._bypass_until = time.monotonic() + 1.0
            self._log("CMD", f"触发内置浏览器翻译: {self._short_url(raw_url)}")
            Browser.openUrl(ctx, final_url)
        except BaseException as err:
            self._log("ERROR", f"打开内置浏览器失败: {err}")
            BulletinHelper.show_error(f"打开内置浏览器失败: {err}")

    def _build_diagnostic_text(self) -> str:
        mode = self._get_open_mode()
        lang = self._target_lang()
        doc_eng = self._get_doc_engine()
        cmd = str(self.get_setting("custom_cmd", ".tr") or ".tr").strip() or ".tr"
        wl = str(self.get_setting("force_whitelist", "") or "").strip() or "(空)"
        sl = str(self.get_setting("skip_domains", "") or "").strip() or "(空)"
        c_cnt, c_bytes = self._cache.stats()
        header = (
            f"插件: {__name__} v{__version__}\n"
            f"外链模式: {mode} | 语言: {lang} | 指令: {cmd}\n"
            f"文档引擎: {doc_eng} | 顶栏按钮: {bool(self.get_setting('av_inject_btn', True))} | 拦即时预览: {bool(self.get_setting('iv_auto_intercept', False))} | 预览点译: {self._get_iv_click_mode()} | 自动接管文档: {bool(self.get_setting('doc_auto_intercept', False))}\n"
            f"本地译文缓存: {c_cnt} 篇 ({c_bytes / 1024:.1f} KB)\n"
            f"白名单: {wl}\n"
            f"免翻译: {sl}\n"
            f"Hooks -> 外链:{len(self._hook_refs)} | AU文档:{len(self._doc_hook_refs)} | AV:{len(self._av_hook_refs)} | WAB:{len(self._wab_hook_refs)} | 菜单:{self._menu_item_ref is not None}\n"
            f"------------------------------\n"
        )
        if not self._logs:
            return header + "暂无运行或报错记录。"
        return header + "\n".join(self._logs)

    def _copy_to_clipboard(self, text: str, silent_msg: str = "已复制到剪贴板"):
        try:
            ctx = _get_activity() or (ApplicationLoader.applicationContext if ApplicationLoader else None)
            if ctx is None:
                BulletinHelper.show_error("复制失败：无法获取上下文")
                return
            ClipDataCls = find_class("android.content.ClipData")
            cm = ctx.getSystemService("clipboard")
            if cm is not None and ClipDataCls is not None:
                cm.setPrimaryClip(ClipDataCls.newPlainText("plugin_text", text))
                if silent_msg:
                    BulletinHelper.show_info(silent_msg)
                return
        except BaseException as err:
            self._log("ERROR", f"复制文本失败: {err}")
        BulletinHelper.show_error("复制失败")

    def _show_logs_dialog(self):
        try:
            act = _get_activity()
            if act is None:
                BulletinHelper.show_info("无法获取当前界面窗口")
                return
            report_text = self._build_diagnostic_text()
            builder = AlertDialogBuilder(act)
            builder.set_title("运行与报错日志")
            builder.set_message(report_text)
            builder.set_positive_button(
                "复制全部",
                lambda d, w, t=report_text: self._copy_to_clipboard(t, "已复制完整诊断日志到剪贴板"),
            )
            builder.set_neutral_button(
                "清空日志",
                lambda d, w: (self._logs.clear(), BulletinHelper.show_info("日志已清空")),
            )
            builder.set_negative_button("关闭", None)
            builder.show()
        except BaseException as err:
            self._log("ERROR", f"弹出日志窗口失败: {err}")
            BulletinHelper.show_error(f"日志弹窗失败: {err}")

    # ==================== 全屏原生流畅阅读页（Dialog + 首屏秒出 + 磁盘缓存） ====================
    def _is_reader_alive(self) -> bool:
        if self._r_dialog is None or self._r_wv is None:
            return False
        try:
            return bool(self._r_dialog.isShowing())
        except BaseException:
            return False

    def open_text_reader(
        self,
        title: str,
        raw_text: str,
        is_md: bool = True,
        is_plain: bool = False,
        auto_translate: bool = True,
        force_retranslate: bool = False,
        msg_obj=None,
        source_url: str = "",
    ):
        target_lang = self._target_lang()
        norm_text = _normalize_doc_text(raw_text)
        cache_key = self._cache.make_key(norm_text, target_lang)

        self._r_doc_title = (title or "外文文档").strip()
        self._r_doc_raw = norm_text
        self._r_doc_is_md = bool(is_md)
        self._r_doc_is_plain = bool(is_plain)
        self._r_doc_cache_key = cache_key
        self._r_doc_trans_lang = target_lang
        self._r_doc_from_cache = False
        self._r_msg_obj = msg_obj
        self._r_doc_url = (source_url or "").strip()
        self._r_doc_trans = None
        self._r_showing_trans = False

        if force_retranslate:
            self._cache.delete(self._r_doc_raw, target_lang)
            with self._jobs_lock:
                old_job = self._active_jobs.pop(cache_key, None)
                if old_job is not None:
                    old_job["cancelled"] = True

        # 1. 先检查本地持久化磁盘缓存（命中直接秒开！）
        cached_txt = None if force_retranslate else self._cache.get(self._r_doc_raw, target_lang)
        active_job = None
        if cached_txt is not None:
            self._r_doc_trans = cached_txt
            self._r_doc_from_cache = True
            self._r_showing_trans = True
            self._log("CACHE_HIT", f"命中本地译文缓存秒开: {self._r_doc_title} -> {target_lang}")
        else:
            # 2. 检查是否已有同一文档的后台翻译任务在跑，直接复用最新进度
            with self._jobs_lock:
                active_job = self._active_jobs.get(cache_key)
                if active_job is not None and not active_job.get("cancelled"):
                    if active_job.get("partial"):
                        self._r_doc_trans = active_job["partial"]
                        self._r_showing_trans = True

        if not self._is_reader_alive():
            self._create_reader_dialog()

        if not self._is_reader_alive():
            return

        self._r_update_chrome()
        self._r_render_current(full_reload=True)
        self._log("READER", f"打开全屏阅读页: {self._r_doc_title} ({len(self._r_doc_raw)} 字, 缓存={self._r_doc_from_cache})")

        if auto_translate and not self._r_doc_from_cache:
            if active_job is None or active_job.get("cancelled") or active_job.get("done"):
                self._r_start_streaming_job(force=force_retranslate)

    def _get_current_job(self):
        with self._jobs_lock:
            return self._active_jobs.get(self._r_doc_cache_key)

    def _r_update_chrome(self):
        try:
            job = self._get_current_job()
            is_running = bool(job is not None and not job.get("done") and not job.get("cancelled"))

            if self._r_title_tv is not None:
                self._r_title_tv.setText(self._r_doc_title)

            if self._r_sub_tv is not None:
                if is_running:
                    cur = int(job.get("cur", 0))
                    tot = int(job.get("total", 0))
                    if tot > 0:
                        self._r_sub_tv.setText(f"后台接力翻译 {cur}/{tot} · {self._r_doc_trans_lang}")
                    else:
                        self._r_sub_tv.setText(f"正在翻译首屏… · {self._r_doc_trans_lang}")
                elif self._r_showing_trans and self._r_doc_trans is not None:
                    tag = "本地缓存" if self._r_doc_from_cache else "已缓存"
                    self._r_sub_tv.setText(f"{self._r_doc_trans_lang} · {tag}")
                else:
                    self._r_sub_tv.setText(f"原文 · {len(self._r_doc_raw)} 字")

            if self._r_btn_trans is not None:
                if is_running:
                    cur = int(job.get("cur", 0))
                    tot = int(job.get("total", 0))
                    if self._r_showing_trans and self._r_doc_trans is not None:
                        self._r_btn_trans.setText(f"原文 ({cur}/{tot})" if tot > 0 else "原文")
                    else:
                        self._r_btn_trans.setText(f"译 {cur}/{tot}" if tot > 0 else "译中…")
                elif self._r_showing_trans and self._r_doc_trans is not None:
                    self._r_btn_trans.setText("原文")
                else:
                    self._r_btn_trans.setText("译文")
        except BaseException:
            pass

    def _compute_reader_banner(self) -> str:
        job = self._get_current_job()
        is_running = bool(job is not None and not job.get("done") and not job.get("cancelled"))
        if is_running:
            cur = int(job.get("cur", 0))
            tot = int(job.get("total", 0))
            if cur == 0:
                return f"正在快速翻译首屏为 {self._r_doc_trans_lang}（完成后自动缓存在本地）…"
            return f"首屏已译出 · 后台静默接力 {cur}/{tot}（可正常下滑阅读，退出后也会继续翻完并缓存）"
        if self._r_showing_trans and self._r_doc_trans is not None:
            if job is not None and int(job.get("failed", 0)) > 0:
                return f"已译出大部分内容（{job.get('failed')} 段超时保留原文），点右上角 ⋯ 可「重新翻译」"
            src_lbl = "已从本地缓存秒开" if self._r_doc_from_cache else "翻译完成并已自动缓存"
            return f"{src_lbl}（{self._r_doc_trans_lang}，保留代码块与排版） · 点右上角可切原文"
        return ""

    def _r_render_current(self, banner: str = None, full_reload: bool = False):
        if self._r_wv is None:
            return
        try:
            text_to_show = (
                self._r_doc_trans
                if (self._r_showing_trans and self._r_doc_trans is not None)
                else self._r_doc_raw
            )
            body = _markdown_to_html_body(text_to_show, is_plain=self._r_doc_is_plain)
            final_banner = self._compute_reader_banner() if banner is None else banner
            self._r_last_banner = final_banner

            if not full_reload and self._r_wv_ready:
                # 原位无闪烁 DOM 替换，保持滚动位置不跳动
                js = (
                    "window.__patchReader("
                    + json.dumps(body, ensure_ascii=False)
                    + ","
                    + json.dumps(final_banner, ensure_ascii=False)
                    + ","
                    + str(int(self._r_font_size))
                    + ","
                    + ("true" if self._r_use_serif else "false")
                    + ");"
                )
                self._r_wv.evaluateJavascript(js, None)
                return

            self._r_wv_ready = False
            page_html = _build_reader_html(
                body_html=body,
                bg_hex=self._r_bg_hex,
                text_hex=self._r_text_hex,
                accent_hex=self._r_accent_hex,
                is_dark=self._r_is_dark,
                font_size_px=self._r_font_size,
                use_serif=self._r_use_serif,
                banner_text=final_banner,
            )
            self._r_wv.loadDataWithBaseURL("https://local.reader/", page_html, "text/html", "UTF-8", None)
        except BaseException as err:
            self._log("ERROR", f"渲染阅读页 HTML 失败: {err}")

    def _r_toggle_translate(self):
        if not self._is_reader_alive():
            return
        target_lang = self._target_lang()
        # 如果已经缓存或已有部分译文，直接秒切原文/译文
        if self._r_doc_trans is not None and self._r_doc_trans_lang == target_lang:
            self._r_showing_trans = not self._r_showing_trans
            self._r_update_chrome()
            self._r_render_current()
            return

        # 若目标语言变化，重新查磁盘缓存
        if self._r_doc_trans_lang != target_lang:
            self._r_doc_trans_lang = target_lang
            self._r_doc_cache_key = self._cache.make_key(self._r_doc_raw, target_lang)
            cached = self._cache.get(self._r_doc_raw, target_lang)
            if cached is not None:
                self._r_doc_trans = cached
                self._r_doc_from_cache = True
                self._r_showing_trans = True
                self._r_update_chrome()
                self._r_render_current()
                return

        self._r_start_streaming_job(force=False)

    def _r_start_streaming_job(self, force: bool = False):
        src_snapshot = self._r_doc_raw
        title_snapshot = self._r_doc_title
        target_lang = self._target_lang()
        is_md = self._r_doc_is_md
        cache_key = self._cache.make_key(src_snapshot, target_lang)
        self._r_doc_cache_key = cache_key
        self._r_doc_trans_lang = target_lang

        if force:
            self._cache.delete(src_snapshot, target_lang)

        with self._jobs_lock:
            existing = self._active_jobs.get(cache_key)
            if existing is not None and not existing.get("done") and not existing.get("cancelled"):
                if not force:
                    self._r_update_chrome()
                    self._r_render_current()
                    return
                existing["cancelled"] = True

            job = {
                "key": cache_key,
                "title": title_snapshot,
                "lang": target_lang,
                "cur": 0,
                "total": 0,
                "partial": None,
                "failed": 0,
                "done": False,
                "cancelled": False,
            }
            self._active_jobs[cache_key] = job

        self._r_update_chrome()
        self._r_render_current()

        def _worker():
            try:
                def _on_batch(cur, total, partial_text, failed_cnt):
                    if job["cancelled"]:
                        return
                    job["cur"] = cur
                    job["total"] = total
                    job["partial"] = partial_text
                    job["failed"] = failed_cnt

                    def _apply_ui():
                        if job["cancelled"]:
                            return
                        if self._is_reader_alive() and self._r_doc_cache_key == cache_key:
                            was_none = self._r_doc_trans is None
                            self._r_doc_trans = partial_text
                            # 首屏第一批返回时自动切到译文视图；后续批次若用户在看译文则原地更新
                            if cur == 1 or was_none:
                                self._r_showing_trans = True
                            self._r_update_chrome()
                            if self._r_showing_trans:
                                self._r_render_current()

                    run_on_ui_thread(_apply_ui)

                final_text, failed_cnt = _translate_document_streaming(
                    src_snapshot,
                    target_lang,
                    is_markdown=is_md,
                    on_batch_ready=_on_batch,
                    cancel_check=lambda: bool(job["cancelled"]),
                )

                if job["cancelled"]:
                    return

                job["done"] = True
                job["partial"] = final_text
                job["failed"] = failed_cnt

                # 完整无失败时写入本地持久化磁盘缓存，退出重进秒开
                if failed_cnt == 0 and final_text:
                    self._cache.put(src_snapshot, target_lang, final_text, title=title_snapshot)
                    self._log("CACHE_SAVE", f"完整译文已落盘缓存: {title_snapshot} -> {target_lang}")
                else:
                    self._log("READER", f"翻译结束(有 {failed_cnt} 批超时保留原文，未写缓存): {title_snapshot}")

                def _done_ui():
                    if self._is_reader_alive() and self._r_doc_cache_key == cache_key:
                        self._r_doc_trans = final_text
                        self._r_doc_from_cache = False
                        self._r_showing_trans = True
                        self._r_update_chrome()
                        self._r_render_current()
                    else:
                        if failed_cnt == 0:
                            BulletinHelper.show_info(f"《{title_snapshot}》后台翻译完成并已缓存")
                    with self._jobs_lock:
                        if self._active_jobs.get(cache_key) is job:
                            self._active_jobs.pop(cache_key, None)

                run_on_ui_thread(_done_ui)
            except BaseException as err:
                err_msg = str(err)
                job["done"] = True

                def _fail_ui():
                    with self._jobs_lock:
                        if self._active_jobs.get(cache_key) is job:
                            self._active_jobs.pop(cache_key, None)
                    if job["cancelled"]:
                        return
                    self._log("ERROR", f"分段翻译失败: {err_msg}")
                    if self._is_reader_alive() and self._r_doc_cache_key == cache_key:
                        self._r_update_chrome()
                        self._r_render_current(banner=f"翻译失败: {err_msg}（可点右上角「电报译」或 ⋯ 重试）")
                    BulletinHelper.show_error(f"翻译失败: {err_msg}")

                run_on_ui_thread(_fail_ui)

        t = threading.Thread(target=_worker, daemon=True)
        t.start()

    def _r_trigger_tg_native(self):
        src = (self._r_doc_raw or "").strip()
        if not src:
            return
        if not self._open_tg_native_translate(src):
            BulletinHelper.show_info("未调起电报自带翻译（可看日志排查）")

    def _r_show_more_menu(self):
        try:
            act = _get_activity()
            if act is None:
                return
            serif_lbl = "切换为默认无衬线字体" if self._r_use_serif else "切换为衬线阅读字体"
            actions = [
                ("重新翻译（忽略本地缓存）", "retranslate"),
                ("放大字号 (A+)", "font_up"),
                ("缩小字号 (A-)", "font_down"),
                (serif_lbl, "serif"),
                ("复制当前显示的全文", "copy"),
            ]
            has_src_url = bool(self._r_doc_url and self._r_doc_url.lower().startswith(("http://", "https://")))
            if has_src_url:
                actions.append(("打开谷歌整页网页翻译（带图版）", "web_page"))
            actions.extend([
                ("跳转谷歌在线文本翻译", "google_text"),
                ("清理全部本地译文缓存", "clear_cache"),
            ])

            items = [a[0] for a in actions]
            builder = AlertDialogBuilder(act)
            builder.set_title("阅读器选项")

            def _on_pick(d, which):
                idx = int(which)
                if not (0 <= idx < len(actions)):
                    return
                key = actions[idx][1]
                if key == "retranslate":
                    self._r_doc_trans = None
                    self._r_doc_from_cache = False
                    self._r_start_streaming_job(force=True)
                elif key == "font_up":
                    self._r_change_font(2)
                elif key == "font_down":
                    self._r_change_font(-2)
                elif key == "serif":
                    self._r_use_serif = not self._r_use_serif
                    self._r_render_current()
                elif key == "copy":
                    self._r_copy_current()
                elif key == "web_page" and has_src_url:
                    target_u = self._r_doc_url
                    self.close_reader()
                    self._open_url_by_mode(target_u, force_trans=True)
                elif key == "google_text":
                    self._open_google_web_text(self._r_doc_raw)
                elif key == "clear_cache":
                    self._clear_cache_action()

            builder.set_items(items, _on_pick)
            builder.set_negative_button("取消", None)
            builder.show()
        except BaseException as err:
            self._log("ERROR", f"弹出阅读器菜单失败: {err}")

    def _r_change_font(self, delta: int):
        nxt = max(12, min(26, self._r_font_size + delta))
        if nxt != self._r_font_size:
            self._r_font_size = nxt
            self._r_render_current()

    def _r_copy_current(self):
        txt = (
            self._r_doc_trans
            if (self._r_showing_trans and self._r_doc_trans is not None)
            else self._r_doc_raw
        )
        label = "已复制译文到剪贴板" if (self._r_showing_trans and self._r_doc_trans is not None) else "已复制原文到剪贴板"
        self._copy_to_clipboard(txt, label)

    def _create_reader_dialog(self):
        """创建全屏原生体验阅读器 Dialog（贴合系统返回手势、全屏流畅滑动、零悬浮小窗卡顿）"""
        try:
            if self._r_dialog is not None:
                self.close_reader()

            DialogCls = find_class("android.app.Dialog")
            ThemeCls = find_class("org.telegram.ui.ActionBar.Theme")
            WebViewCls = find_class("android.webkit.WebView")
            WebViewClientCls = find_class("android.webkit.WebViewClient")
            OnDismissCls = find_class("android.content.DialogInterface$OnDismissListener")

            if DialogCls is None or WebViewCls is None:
                BulletinHelper.show_error("缺少 Dialog 或 WebView 类")
                return

            act = _get_activity()
            if act is None:
                BulletinHelper.show_error("无法获取当前 Activity")
                return

            bg_col = _safe_theme_color(ThemeCls, "key_windowBackgroundWhite", 0xFF1C1C1E)
            bar_col = _safe_theme_color(ThemeCls, "key_actionBarDefault", bg_col)
            divider_col = _safe_theme_color(ThemeCls, "key_divider", 0x33888888)
            accent_col = _safe_theme_color(ThemeCls, "key_dialogButtonBlue", 0xFF3A8DFF)
            text_col = _safe_theme_color(ThemeCls, "key_windowBackgroundWhiteBlackText", 0xFFFFFFFF)
            sub_col = _safe_theme_color(ThemeCls, "key_windowBackgroundWhiteGrayText", 0xFF999999)

            self._r_bg_hex = _argb_to_css_hex(bg_col)
            self._r_text_hex = _argb_to_css_hex(text_col)
            self._r_accent_hex = _argb_to_css_hex(accent_col)
            self._r_is_dark = _is_dark_color(bg_col)

            # 顶部状态栏高度适配
            sb_h = 0
            try:
                sb_h = int(AndroidUtilities.statusBarHeight)
            except BaseException:
                sb_h = AndroidUtilities.dp(24)

            root = LinearLayout(act)
            root.setOrientation(LinearLayout.VERTICAL)
            root.setBackgroundColor(bg_col)

            # 顶栏（使用背景色融合原生阅读观感，单行整洁不占高度）
            header = LinearLayout(act)
            header.setOrientation(LinearLayout.HORIZONTAL)
            header.setGravity(Gravity.CENTER_VERTICAL)
            header.setBackgroundColor(bg_col)
            header.setPadding(
                AndroidUtilities.dp(8),
                sb_h + AndroidUtilities.dp(6),
                AndroidUtilities.dp(10),
                AndroidUtilities.dp(8),
            )

            def make_action_btn(label, cb, highlight=False, pad_h=10):
                tv = TextView(act)
                tv.setText(label)
                tv.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13)
                tv.setSingleLine(True)
                tv.setGravity(Gravity.CENTER)
                tv.setPadding(AndroidUtilities.dp(pad_h), AndroidUtilities.dp(6), AndroidUtilities.dp(pad_h), AndroidUtilities.dp(6))
                if highlight:
                    tv.setTextColor(_c32(0xFFFFFFFF))
                    tv.setBackground(_round_bg(accent_col, AndroidUtilities.dp(14)))
                else:
                    tv.setTextColor(text_col)
                    tv.setBackground(_round_bg(0x20888888, AndroidUtilities.dp(14)))
                if cb is not None:
                    tv.setOnClickListener(OnClickListener(cb))
                return tv

            btn_back = TextView(act)
            btn_back.setText("←")
            btn_back.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 20)
            btn_back.setTextColor(text_col)
            btn_back.setGravity(Gravity.CENTER)
            btn_back.setPadding(AndroidUtilities.dp(10), AndroidUtilities.dp(4), AndroidUtilities.dp(10), AndroidUtilities.dp(4))
            btn_back.setOnClickListener(OnClickListener(lambda v: self.close_reader()))

            title_col = LinearLayout(act)
            title_col.setOrientation(LinearLayout.VERTICAL)
            title_tv = TextView(act)
            title_tv.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 15)
            title_tv.setTextColor(text_col)
            title_tv.setSingleLine(True)
            try:
                TruncateAt = find_class("android.text.TextUtils$TruncateAt")
                if TruncateAt is not None:
                    title_tv.setEllipsize(TruncateAt.END)
            except BaseException:
                pass

            sub_tv = TextView(act)
            sub_tv.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 11.5)
            sub_tv.setTextColor(sub_col)
            sub_tv.setSingleLine(True)

            title_col.addView(title_tv, LinearLayout.LayoutParams(-1, -2))
            title_col.addView(sub_tv, LinearLayout.LayoutParams(-1, -2))

            btn_trans = make_action_btn("译文", lambda v: self._r_toggle_translate(), highlight=True, pad_h=12)
            btn_tg = make_action_btn("电报译", lambda v: self._r_trigger_tg_native(), highlight=False, pad_h=9)
            btn_more = make_action_btn("⋯", lambda v: self._r_show_more_menu(), highlight=False, pad_h=9)

            header.addView(btn_back, LinearLayout.LayoutParams(-2, -2))
            lp_tc = LinearLayout.LayoutParams(0, -2, 1.0)
            lp_tc.leftMargin = AndroidUtilities.dp(4)
            lp_tc.rightMargin = AndroidUtilities.dp(6)
            header.addView(title_col, lp_tc)

            for b in (btn_trans, btn_tg, btn_more):
                lp_b = LinearLayout.LayoutParams(-2, -2)
                lp_b.leftMargin = AndroidUtilities.dp(5)
                header.addView(b, lp_b)

            root.addView(header, LinearLayout.LayoutParams(-1, -2))

            div = View(act)
            div.setBackgroundColor(divider_col)
            root.addView(div, LinearLayout.LayoutParams(-1, max(1, AndroidUtilities.dp(0.6))))

            wv = WebViewCls(act)
            wv.setBackgroundColor(bg_col)
            s = wv.getSettings()
            # 仅用于本地安全转义 HTML 的无闪烁 DOM 增量更新（window.__patchReader）
            s.setJavaScriptEnabled(True)
            s.setSupportZoom(True)
            s.setBuiltInZoomControls(True)
            s.setDisplayZoomControls(False)
            s.setDefaultTextEncodingName("utf-8")

            # 挂载轻量 WebViewClient：就绪后同步最新状态，点击文档内链接交给客户端浏览器
            try:
                host_self = self
                if WebViewClientCls is not None:
                    class _ReaderWvClient(WebViewClientCls):
                        def onPageFinished(self, view, url):
                            host_self._r_wv_ready = True
                            # 如果页面加载期间后台已有新批次完成，立即补刷一次
                            try:
                                if host_self._is_reader_alive() and host_self._r_showing_trans and host_self._r_doc_trans is not None:
                                    host_self._r_render_current(full_reload=False)
                            except BaseException:
                                pass

                        def shouldOverrideUrlLoading(self, view, request_or_url):
                            try:
                                u = str(request_or_url.getUrl()) if hasattr(request_or_url, "getUrl") else str(request_or_url)
                                if u.lower().startswith(("http://", "https://")) and not u.startswith("https://local.reader"):
                                    run_on_ui_thread(lambda target=u: host_self._open_url_by_mode(target, force_trans=False))
                                    return True
                            except BaseException:
                                pass
                            return False

                    wv.setWebViewClient(_ReaderWvClient())
            except BaseException:
                if WebViewClientCls is not None:
                    wv.setWebViewClient(WebViewClientCls())

            root.addView(wv, LinearLayout.LayoutParams(-1, 0, 1.0))

            # 使用全屏无标题栏主题创建原生 Dialog
            style_id = 0x01030006  # android.R.style.Theme_NoTitleBar
            try:
                RStyle = find_class("android.R$style")
                if RStyle is not None:
                    style_id = int(getattr(RStyle, "Theme_DeviceDefault_NoActionBar", style_id))
            except BaseException:
                pass

            dlg = DialogCls(act, style_id)
            dlg.setContentView(root)
            dlg.setCancelable(True)
            try:
                win = dlg.getWindow()
                if win is not None:
                    win.setLayout(-1, -1)
                    win.setBackgroundDrawable(ColorDrawable(bg_col))
                    try:
                        # 同步状态栏颜色与浅/深色图标
                        win.setStatusBarColor(bg_col)
                        win.setNavigationBarColor(bg_col)
                        if not self._r_is_dark:
                            dv = win.getDecorView()
                            if dv is not None:
                                dv.setSystemUiVisibility(int(dv.getSystemUiVisibility()) | 0x00002000)
                    except BaseException:
                        pass
            except BaseException:
                pass

            if OnDismissCls is not None:
                host_self = self

                class _OnReaderDismiss(dynamic_proxy(OnDismissCls)):
                    def onDismiss(self, d):
                        host_self._on_reader_dismissed(d)

                dlg.setOnDismissListener(_OnReaderDismiss())

            self._r_dialog = dlg
            self._r_wv = wv
            self._r_wv_ready = False
            self._r_title_tv = title_tv
            self._r_sub_tv = sub_tv
            self._r_btn_trans = btn_trans

            dlg.show()
        except BaseException as err:
            self._log("ERROR", f"全屏阅读页启动失败: {err}")
            self.close_reader()
            BulletinHelper.show_error(f"阅读页启动失败: {err}")

    def _on_reader_dismissed(self, dlg):
        if self._r_dialog is not dlg:
            return
        wv = self._r_wv
        self._r_dialog = None
        self._r_wv = None
        self._r_wv_ready = False
        self._r_title_tv = None
        self._r_sub_tv = None
        self._r_btn_trans = None
        if wv is not None:
            try:
                wv.stopLoading()
                wv.loadUrl("about:blank")
                wv.destroy()
            except BaseException:
                pass

    def close_reader(self):
        dlg = self._r_dialog
        wv = self._r_wv
        self._r_dialog = None
        self._r_wv = None
        self._r_wv_ready = False
        self._r_title_tv = None
        self._r_sub_tv = None
        self._r_btn_trans = None

        try:
            if dlg is not None:
                try:
                    dlg.dismiss()
                except BaseException:
                    pass
            if wv is not None:
                try:
                    wv.stopLoading()
                    wv.loadUrl("about:blank")
                    wv.destroy()
                except BaseException:
                    pass
        except BaseException:
            pass

    # ==================== 网页悬浮窗模式（外链可选） ====================
    def _is_window_alive(self) -> bool:
        if self._root is None or self._webview is None or self._wm is None:
            return False
        try:
            if hasattr(self._root, "isAttachedToWindow"):
                return bool(self._root.isAttachedToWindow())
        except BaseException:
            pass
        return True

    def _update_toggle_btn(self, url: str):
        if self._btn_toggle is None:
            return
        try:
            self._btn_toggle.setText("原页" if self.is_translated_url(url) else "译页")
        except BaseException:
            pass

    def _refresh_kb_btn(self):
        if self._btn_kb is None:
            return
        try:
            if self._focusable:
                self._btn_kb.setTextColor(_c32(0xFFFFFFFF))
                self._btn_kb.setBackground(_round_bg(self._accent_col, AndroidUtilities.dp(9)))
            else:
                self._btn_kb.setTextColor(self._text_col)
                self._btn_kb.setBackground(_round_bg(0x22888888, AndroidUtilities.dp(9)))
        except BaseException:
            pass

    def _set_focusable(self, on: bool):
        if not self._is_window_alive() or self._lp is None:
            return
        if self._focusable == on:
            return
        try:
            LayoutParamsCls = find_class("android.view.WindowManager$LayoutParams")
            if LayoutParamsCls is None:
                return
            nf = LayoutParamsCls.FLAG_NOT_FOCUSABLE
            if on:
                self._lp.flags &= ~nf
            else:
                self._lp.flags |= nf
                try:
                    self._webview.clearFocus()
                except BaseException:
                    pass
            self._focusable = on
            self._wm.updateViewLayout(self._root, self._lp)
            self._refresh_kb_btn()
        except BaseException:
            pass

    def _toggle_kb_focus(self):
        target = not self._focusable
        self._set_focusable(target)
        if target:
            try:
                if self._webview is not None:
                    self._webview.requestFocus()
            except BaseException:
                pass
            BulletinHelper.show_info("已允许网页输入（点悬浮窗外自动归还焦点）")

    def show_translated_float(self, raw_url: str, force_trans: bool = False):
        final_url = self.to_translate_url(raw_url, bypass_check=force_trans)
        self._last_url = final_url

        if self._is_window_alive():
            try:
                if self._minimized:
                    self._expand()
                self._webview.loadUrl(final_url)
                self._update_toggle_btn(final_url)
                return
            except BaseException:
                self.close_float()

        self._create_float(final_url)

    def _create_float(self, url: str):
        try:
            if self._root is not None or self._webview is not None:
                self.close_float()

            WindowManagerCls = find_class("android.view.WindowManager")
            LayoutParamsCls = find_class("android.view.WindowManager$LayoutParams")
            ThemeCls = find_class("org.telegram.ui.ActionBar.Theme")
            WebViewCls = find_class("android.webkit.WebView")
            WebViewClientCls = find_class("android.webkit.WebViewClient")
            OnTouchCls = find_class("android.view.View$OnTouchListener")
            BuildVerCls = find_class("android.os.Build$VERSION")

            if WindowManagerCls is None or LayoutParamsCls is None or WebViewCls is None:
                BulletinHelper.show_error("缺少 WebView 或 WindowManager")
                return

            act = _get_activity()
            ctx = act if act is not None else (ApplicationLoader.applicationContext if ApplicationLoader else None)
            if ctx is None:
                return

            wm = act.getSystemService("window") if act is not None else ctx.getSystemService("window")
            if wm is None:
                return
            self._wm = wm

            dm = ctx.getResources().getDisplayMetrics()
            sw, sh = int(dm.widthPixels), int(dm.heightPixels)

            bg_col = _safe_theme_color(ThemeCls, "key_windowBackgroundWhite", 0xFF1C1C1E)
            border_col = _safe_theme_color(ThemeCls, "key_divider", 0x44FFFFFF)
            accent_col = _safe_theme_color(ThemeCls, "key_dialogButtonBlue", 0xFF3A8DFF)
            text_col = _safe_theme_color(ThemeCls, "key_windowBackgroundWhiteBlackText", 0xFFFFFFFF)
            self._accent_col = accent_col
            self._text_col = text_col

            win_w = min(AndroidUtilities.dp(356), int(sw * 0.92))
            win_h = int(sh * 0.52)
            self._win_w = win_w
            self._win_x = max(AndroidUtilities.dp(8), (sw - win_w) // 2)
            self._win_y = AndroidUtilities.dp(64)

            root = LinearLayout(ctx)
            root.setOrientation(LinearLayout.VERTICAL)
            pad = AndroidUtilities.dp(6)
            root.setPadding(pad, pad, pad, pad)
            root_bg = _round_bg(bg_col, AndroidUtilities.dp(14), AndroidUtilities.dp(1), border_col)
            root.setBackground(root_bg)
            try:
                root.setClipToOutline(True)
                root.setElevation(float(AndroidUtilities.dp(12)))
            except BaseException:
                pass
            self._root_bg = root_bg

            bar = LinearLayout(ctx)
            bar.setOrientation(LinearLayout.HORIZONTAL)
            bar.setGravity(Gravity.CENTER_VERTICAL)
            bar.setPadding(AndroidUtilities.dp(4), AndroidUtilities.dp(2), AndroidUtilities.dp(4), AndroidUtilities.dp(6))

            def make_btn(label, cb, highlight=False):
                tv = TextView(ctx)
                tv.setText(label)
                tv.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 12)
                tv.setSingleLine(True)
                tv.setGravity(Gravity.CENTER)
                tv.setPadding(AndroidUtilities.dp(7), AndroidUtilities.dp(4), AndroidUtilities.dp(7), AndroidUtilities.dp(4))
                if highlight:
                    tv.setTextColor(_c32(0xFFFFFFFF))
                    tv.setBackground(_round_bg(accent_col, AndroidUtilities.dp(9)))
                else:
                    tv.setTextColor(text_col)
                    tv.setBackground(_round_bg(0x22888888, AndroidUtilities.dp(9)))
                if cb is not None:
                    tv.setOnClickListener(OnClickListener(cb))
                return tv

            btn_back = make_btn("◀", lambda v: self._go_nav("back"))
            btn_fwd = make_btn("▶", lambda v: self._go_nav("forward"))

            drag_hint = TextView(ctx)
            drag_hint.setText("≡ 译")
            drag_hint.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 12)
            drag_hint.setTextColor(accent_col)
            drag_hint.setGravity(Gravity.CENTER)
            drag_hint.setSingleLine(True)

            btn_toggle = make_btn("原页" if self.is_translated_url(url) else "译页", lambda v: self._switch_orig_trans())
            btn_ext = make_btn("↗", lambda v: self._open_external())
            btn_kb = make_btn("⌨", lambda v: self._toggle_kb_focus())
            btn_min = make_btn("—", lambda v: self._minimize())
            btn_close = make_btn("✕", lambda v: self.close_float(), highlight=True)

            for b in (btn_back, btn_fwd):
                lp_b = LinearLayout.LayoutParams(-2, -2)
                lp_b.rightMargin = AndroidUtilities.dp(4)
                bar.addView(b, lp_b)

            lp_d = LinearLayout.LayoutParams(0, -2, 1.0)
            lp_d.leftMargin = AndroidUtilities.dp(2)
            lp_d.rightMargin = AndroidUtilities.dp(2)
            bar.addView(drag_hint, lp_d)

            for b in (btn_toggle, btn_ext, btn_kb, btn_min, btn_close):
                lp_b = LinearLayout.LayoutParams(-2, -2)
                lp_b.leftMargin = AndroidUtilities.dp(4)
                bar.addView(b, lp_b)

            root.addView(bar, LinearLayout.LayoutParams(-1, -2))

            box = FrameLayout(ctx)
            wv = WebViewCls(ctx)
            s = wv.getSettings()
            s.setJavaScriptEnabled(True)
            s.setDomStorageEnabled(True)
            s.setSupportZoom(True)
            s.setBuiltInZoomControls(True)
            s.setDisplayZoomControls(False)
            s.setUseWideViewPort(True)
            s.setLoadWithOverviewMode(True)
            try:
                s.setMixedContentMode(0)
            except BaseException:
                pass
            if WebViewClientCls is not None:
                wv.setWebViewClient(WebViewClientCls())
            wv.loadUrl(url)
            box.addView(wv, FrameLayout.LayoutParams(-1, -1))
            root.addView(box, LinearLayout.LayoutParams(-1, win_h))

            b_size = AndroidUtilities.dp(48)
            bubble = FrameLayout(ctx)
            bubble.setBackground(_round_bg(accent_col, b_size // 2))
            try:
                bubble.setElevation(float(AndroidUtilities.dp(10)))
            except BaseException:
                pass
            b_txt = TextView(ctx)
            b_txt.setText("译")
            b_txt.setTextColor(_c32(0xFFFFFFFF))
            b_txt.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 16)
            b_txt.setGravity(Gravity.CENTER)
            bubble.addView(b_txt, FrameLayout.LayoutParams(-1, -1))
            bubble.setVisibility(View.GONE)
            root.addView(bubble, LinearLayout.LayoutParams(b_size, b_size))

            lp = LayoutParamsCls()
            lp.width = win_w
            lp.height = -2
            lp.gravity = Gravity.TOP | Gravity.START
            lp.x = self._win_x
            lp.y = self._win_y
            flag_outside = getattr(LayoutParamsCls, "FLAG_WATCH_OUTSIDE_TOUCH", 0x00040000)
            lp.flags = (
                LayoutParamsCls.FLAG_NOT_FOCUSABLE
                | LayoutParamsCls.FLAG_NOT_TOUCH_MODAL
                | flag_outside
                | LayoutParamsCls.FLAG_LAYOUT_IN_SCREEN
                | LayoutParamsCls.FLAG_LAYOUT_NO_LIMITS
            )
            lp.softInputMode = 48
            lp.format = -3

            added_panel = False
            try:
                token = act.getWindow().getDecorView().getWindowToken() if act is not None else None
                if token is not None:
                    lp.type = LayoutParamsCls.TYPE_APPLICATION_PANEL
                    lp.token = token
                    wm.addView(root, lp)
                    added_panel = True
            except BaseException:
                added_panel = False

            if not added_panel:
                sdk = int(BuildVerCls.SDK_INT) if BuildVerCls is not None else 26
                lp.type = LayoutParamsCls.TYPE_APPLICATION_OVERLAY if sdk >= 26 else LayoutParamsCls.TYPE_PHONE
                lp.token = None
                wm.addView(root, lp)

            if OnTouchCls is not None:
                host_self = self
                action_outside = getattr(MotionEvent, "ACTION_OUTSIDE", 4)

                class _OutsideWatcher(dynamic_proxy(OnTouchCls)):
                    def onTouch(self, v, ev):
                        try:
                            if ev.getActionMasked() == action_outside and host_self._focusable:
                                host_self._set_focusable(False)
                        except BaseException:
                            pass
                        return False

                root.setOnTouchListener(_OutsideWatcher())

                class _BarDrag(dynamic_proxy(OnTouchCls)):
                    def onTouch(self, v, ev):
                        try:
                            act_code = ev.getActionMasked()
                            if act_code == MotionEvent.ACTION_DOWN:
                                host_self._drag_x = float(ev.getRawX())
                                host_self._drag_y = float(ev.getRawY())
                                host_self._drag_ox = host_self._win_x
                                host_self._drag_oy = host_self._win_y
                                return True
                            if act_code == MotionEvent.ACTION_MOVE:
                                cur_dm = root.getContext().getResources().getDisplayMetrics()
                                cur_sw, cur_sh = int(cur_dm.widthPixels), int(cur_dm.heightPixels)
                                nx = int(host_self._drag_ox + (float(ev.getRawX()) - host_self._drag_x))
                                ny = int(host_self._drag_oy + (float(ev.getRawY()) - host_self._drag_y))
                                nx = max(0, min(nx, max(0, cur_sw - host_self._win_w)))
                                ny = max(AndroidUtilities.dp(20), min(ny, max(AndroidUtilities.dp(20), cur_sh - AndroidUtilities.dp(80))))
                                host_self._win_x, host_self._win_y = nx, ny
                                lp.x, lp.y = nx, ny
                                wm.updateViewLayout(root, lp)
                                return True
                        except BaseException:
                            pass
                        return False

                bar.setOnTouchListener(_BarDrag())

                class _BubbleTouch(dynamic_proxy(OnTouchCls)):
                    def onTouch(self, v, ev):
                        try:
                            act_code = ev.getActionMasked()
                            if act_code == MotionEvent.ACTION_DOWN:
                                host_self._b_drag_x = float(ev.getRawX())
                                host_self._b_drag_y = float(ev.getRawY())
                                host_self._b_ox = host_self._win_x
                                host_self._b_oy = host_self._win_y
                                host_self._b_moved = False
                                return True
                            if act_code == MotionEvent.ACTION_MOVE:
                                dx = float(ev.getRawX()) - host_self._b_drag_x
                                dy = float(ev.getRawY()) - host_self._b_drag_y
                                if not host_self._b_moved and (abs(dx) + abs(dy)) > AndroidUtilities.dp(6):
                                    host_self._b_moved = True
                                if host_self._b_moved:
                                    cur_dm = root.getContext().getResources().getDisplayMetrics()
                                    cur_sw, cur_sh = int(cur_dm.widthPixels), int(cur_dm.heightPixels)
                                    nx = max(0, min(int(host_self._b_ox + dx), max(0, cur_sw - b_size)))
                                    ny = max(AndroidUtilities.dp(24), min(int(host_self._b_oy + dy), max(AndroidUtilities.dp(24), cur_sh - b_size - AndroidUtilities.dp(24))))
                                    host_self._win_x, host_self._win_y = nx, ny
                                    lp.x, lp.y = nx, ny
                                    wm.updateViewLayout(root, lp)
                                return True
                            if act_code in (MotionEvent.ACTION_UP, MotionEvent.ACTION_CANCEL):
                                if not host_self._b_moved:
                                    host_self._expand()
                                return True
                        except BaseException:
                            pass
                        return False

                bubble.setOnTouchListener(_BubbleTouch())

            self._root = root
            self._lp = lp
            self._webview = wv
            self._content_box = box
            self._bar_row = bar
            self._bubble_btn = bubble
            self._btn_toggle = btn_toggle
            self._btn_kb = btn_kb
            self._minimized = False
            self._focusable = False
        except BaseException as err:
            self._log("ERROR", f"悬浮窗启动失败: {err}")
            self.close_float()
            BulletinHelper.show_error("悬浮窗启动失败: %s" % err)

    def _minimize(self):
        if not self._is_window_alive() or self._lp is None or self._minimized:
            return
        try:
            self._set_focusable(False)
            self._saved_x = self._win_x
            self._saved_y = self._win_y
            if self._bar_row is not None:
                self._bar_row.setVisibility(View.GONE)
            if self._content_box is not None:
                self._content_box.setVisibility(View.GONE)
            self._root.setBackground(None)
            self._root.setPadding(0, 0, 0, 0)
            if self._bubble_btn is not None:
                self._bubble_btn.setVisibility(View.VISIBLE)

            dm = self._root.getContext().getResources().getDisplayMetrics()
            sw, sh = int(dm.widthPixels), int(dm.heightPixels)
            b_size = AndroidUtilities.dp(48)
            self._win_x = max(0, sw - b_size - AndroidUtilities.dp(10))
            self._win_y = max(AndroidUtilities.dp(100), min(self._win_y, max(AndroidUtilities.dp(100), sh - b_size - AndroidUtilities.dp(24))))
            self._lp.width = -2
            self._lp.height = -2
            self._lp.x = self._win_x
            self._lp.y = self._win_y
            self._minimized = True
            self._wm.updateViewLayout(self._root, self._lp)
        except BaseException:
            pass

    def _expand(self):
        if not self._is_window_alive() or self._lp is None or not self._minimized:
            return
        try:
            if self._bubble_btn is not None:
                self._bubble_btn.setVisibility(View.GONE)
            ctx = self._root.getContext()
            pad = AndroidUtilities.dp(6)
            self._root.setPadding(pad, pad, pad, pad)
            if self._root_bg is not None:
                self._root.setBackground(self._root_bg)
            if self._bar_row is not None:
                self._bar_row.setVisibility(View.VISIBLE)
            if self._content_box is not None:
                self._content_box.setVisibility(View.VISIBLE)

            dm = ctx.getResources().getDisplayMetrics()
            sw, sh = int(dm.widthPixels), int(dm.heightPixels)
            win_w = min(AndroidUtilities.dp(356), int(sw * 0.92))
            self._win_w = win_w
            self._win_x = max(0, min(self._saved_x, max(0, sw - win_w)))
            self._win_y = max(AndroidUtilities.dp(20), min(self._saved_y, max(AndroidUtilities.dp(20), sh - AndroidUtilities.dp(120))))
            self._lp.width = win_w
            self._lp.height = -2
            self._lp.x = self._win_x
            self._lp.y = self._win_y
            self._minimized = False
            self._wm.updateViewLayout(self._root, self._lp)
        except BaseException:
            pass

    def _go_nav(self, direction: str):
        if self._webview is None:
            return
        try:
            if direction == "back" and self._webview.canGoBack():
                self._webview.goBack()
            elif direction == "forward" and self._webview.canGoForward():
                self._webview.goForward()
        except BaseException:
            pass

    def _switch_orig_trans(self):
        if self._webview is None:
            return
        try:
            cur = str(self._webview.getUrl() or self._last_url or "").strip()
            if not cur:
                return
            nxt = self.from_translate_url(cur) if self.is_translated_url(cur) else self.to_translate_url(cur, bypass_check=True)
            if nxt == cur:
                BulletinHelper.show_info("当前链接不支持谷歌网页翻译代理")
                return
            self._last_url = nxt
            self._webview.loadUrl(nxt)
            self._update_toggle_btn(nxt)
        except BaseException:
            pass

    def _open_external(self):
        if self._webview is None or Browser is None:
            return
        try:
            cur = str(self._webview.getUrl() or self._last_url or "").strip()
            if not cur:
                return
            orig = self.from_translate_url(cur)
            ctx = _get_activity() or (ApplicationLoader.applicationContext if ApplicationLoader else None)
            if ctx is None:
                return
            self._bypass_until = time.monotonic() + 1.5
            Browser.openUrl(ctx, orig)
        except BaseException:
            pass

    def close_float(self):
        root = self._root
        wv = self._webview
        wm = self._wm

        try:
            if wv is not None:
                try:
                    u = wv.getUrl()
                    if u:
                        self._last_url = str(u)
                except BaseException:
                    pass
            if root is not None:
                removed = False
                if wm is not None:
                    try:
                        wm.removeViewImmediate(root)
                        removed = True
                    except BaseException:
                        try:
                            wm.removeView(root)
                            removed = True
                        except BaseException:
                            pass
                if not removed:
                    try:
                        wm_fallback = root.getContext().getSystemService("window")
                        if wm_fallback is not None:
                            wm_fallback.removeViewImmediate(root)
                    except BaseException:
                        pass
            if wv is not None:
                try:
                    wv.stopLoading()
                    wv.loadUrl("about:blank")
                    wv.destroy()
                except BaseException:
                    pass
        except BaseException:
            pass

        self._wm = None
        self._root = None
        self._root_bg = None
        self._lp = None
        self._webview = None
        self._content_box = None
        self._bar_row = None
        self._bubble_btn = None
        self._btn_toggle = None
        self._btn_kb = None
        self._minimized = False
        self._focusable = False
