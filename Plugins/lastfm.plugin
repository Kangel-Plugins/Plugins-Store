locali = LocalizationManager()


class _NowPlayingCallback(dynamic_proxy(BiConsumer)):
    def __init__(self, plugin, original):
        super().__init__()
        self.plugin = plugin
        self.original = original

    def accept(self, track, elapsed):
        try:
            data = self.plugin._local_track
            if (self.plugin._running and self.plugin.get_setting("music_source", 0) == 1
                    and self.plugin.get_setting("koito_profile_card", False) and data
                    and time.monotonic() - self.plugin._local_track_time < 45):
                dto = jclass("com.exteragram.messenger.api.dto.NowPlayingDTO")
                artists = ArrayList()
                artists.add(data["artist"])
                track = dto(data["name"], artists, None, data.get("profile_image") or self.plugin._fallback_cover(),
                            None, data.get("track_url"), True, None, "KOITO", None)
        except Exception as e:
            log(f"[LastFM] Local Now Playing callback: {e}")
        self.original.accept(track, elapsed)


class _NowPlayingHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        try:
            if (self.plugin._running and self.plugin.get_setting("music_source", 0) == 1
                    and self.plugin.get_setting("koito_profile_card", False)
                    and int(param.args[0]) == int(get_user_config().getClientUserId())):
                param.args[3] = _NowPlayingCallback(self.plugin, param.args[3])
        except Exception as e:
            log(f"[LastFM] Local Now Playing hook: {e}")


class _CoverPickerHook(MethodHook):
    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin

    def before_hooked_method(self, param):
        if int(param.args[0]) in (0x6A53, 0x6A54):
            param.setResult(None)
            self.plugin._cover_picker_result(param.args[0], param.args[1], param.args[2])


class _KoitoCardClickHook(MethodHook):
    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin

    def before_hooked_method(self, param):
        try:
            dto = param.args[0]
            if (self.plugin._running and self.plugin.get_setting("music_source", 0) == 1
                    and self.plugin.get_setting("koito_profile_card", False)
                    and dto and str(dto.getPlatform()) == "KOITO" and dto.getSongUrl()):
                from org.telegram.messenger.browser import Browser
                Browser.openUrl(param.args[3].getContext(), dto.getSongUrl())
                param.setResult(None)
        except Exception as e:
            log(f"[LastFM] Koito card click: {e}")


class LastFMPlugin(BasePlugin):

    def __init__(self):
        super().__init__()
        self._temp_dir = None
        self.alert_manager = AlertManager()
        self._running = False
        self._stop_event = threading.Event()
        self._local_track = None
        self._local_track_time = 0
        self._cover_picker_hook = None

    def _fallback_cover(self):
        if not self._temp_dir:
            return None
        path = File(self._temp_dir, "fallback_cover.png").getAbsolutePath()
        return path if os.path.isfile(path) else None

    def _pick_fallback_cover(self, view):
        self._pick_file(False)

    def _pick_font(self, view):
        self._pick_file(True)

    def _pick_file(self, is_font):
        try:
            from hook_utils import find_class
            from android.content import Intent
            fragment = get_last_fragment()
            activity = fragment.getParentActivity() if fragment else None
            if not activity:
                raise RuntimeError("Activity unavailable")
            if self._cover_picker_hook:
                self.unhook_method(self._cover_picker_hook)
            integer = find_class("java.lang.Integer")
            intent_class = find_class("android.content.Intent")
            method = activity.getClass().getDeclaredMethod("onActivityResult", integer.TYPE, integer.TYPE, intent_class)
            self._cover_picker_hook = self.hook_method(method, _CoverPickerHook(self))
            intent = Intent(Intent.ACTION_GET_CONTENT).setType("*/*" if is_font else "image/*")
            activity.startActivityForResult(Intent.createChooser(intent, "Choose font" if is_font else "Choose cover"), 0x6A54 if is_font else 0x6A53)
        except Exception as e:
            self._remove_cover_picker_hook()
            log(f"[LastFM] Cover picker: {e}")
            BulletinHelper.show_error("Не удалось открыть галерею / Could not open gallery")

    def _remove_cover_picker_hook(self):
        if self._cover_picker_hook:
            try:
                self.unhook_method(self._cover_picker_hook)
            finally:
                self._cover_picker_hook = None

    def _cover_picker_result(self, request, result, data):
        self._remove_cover_picker_hook()
        if int(result) == -1 and data and data.getData():
            uri = data.getData()
            target = self._save_font if int(request) == 0x6A54 else self._save_fallback_cover
            threading.Thread(target=lambda: target(uri), daemon=True).start()

    def _save_font(self, uri):
        stream = None
        temp_path = None
        try:
            if not self._temp_dir:
                raise ValueError("Storage unavailable")
            temp_path = File(self._temp_dir, "font_" + str(uuid.uuid4()) + ".tmp").getAbsolutePath()
            stream = ApplicationLoader.applicationContext.getContentResolver().openInputStream(uri)
            if not stream:
                raise ValueError("Cannot open font")
            buf = jarray(jbyte)(8192)
            total = 0
            with open(temp_path, "wb") as output:
                while True:
                    count = stream.read(buf)
                    if count == -1:
                        break
                    total += count
                    if total > 20 * 1024 * 1024:
                        raise ValueError("Font too large")
                    output.write(bytes((int(value) & 255 for value in buf[:count])))
            ImageFont.truetype(temp_path, 35)
            os.replace(temp_path, File(self._temp_dir, "selected_font.ttf").getAbsolutePath())
            temp_path = None
            run_on_ui_thread(lambda: BulletinHelper.show_success("Шрифт сохранён / Font saved"))
        except Exception as e:
            log(f"[LastFM] Font import failed: {type(e).__name__}")
            run_on_ui_thread(lambda: BulletinHelper.show_error("Не удалось открыть шрифт / Invalid font file"))
        finally:
            if stream:
                stream.close()
            if temp_path and os.path.exists(temp_path):
                os.remove(temp_path)

    def _save_fallback_cover(self, uri):
        stream = None
        temp_path = None
        try:
            if not self._temp_dir:
                raise ValueError("Storage unavailable")
            temp_path = File(self._temp_dir, "fallback_" + str(uuid.uuid4()) + ".tmp").getAbsolutePath()
            stream = ApplicationLoader.applicationContext.getContentResolver().openInputStream(uri)
            if not stream:
                raise ValueError("Cannot open image")
            buf = jarray(jbyte)(8192)
            total = 0
            with open(temp_path, "wb") as output:
                while True:
                    count = stream.read(buf)
                    if count == -1:
                        break
                    total += count
                    if total > 10 * 1024 * 1024:
                        raise ValueError("Image too large")
                    output.write(bytes((int(value) & 255 for value in buf[:count])))
            with Image.open(temp_path) as image:
                if image.width * image.height > 25000000:
                    raise ValueError("Image dimensions too large")
                image.verify()
            target = File(self._temp_dir, "fallback_cover.png").getAbsolutePath()
            converted_path = temp_path + ".png"
            try:
                with Image.open(temp_path) as image:
                    image.convert("RGB").save(converted_path, "PNG")
                os.replace(converted_path, target)
            finally:
                if os.path.exists(converted_path):
                    os.remove(converted_path)
            run_on_ui_thread(lambda: BulletinHelper.show_success("Обложка-заглушка сохранена / Fallback cover saved"))
        except Exception as e:
            log(f"[LastFM] Fallback cover: {e}")
            run_on_ui_thread(lambda: BulletinHelper.show_error("Не удалось сохранить фото / Could not save photo"))
        finally:
            if stream:
                stream.close()
            if temp_path and os.path.exists(temp_path):
                os.remove(temp_path)

    def _clear_fallback_cover(self, view):
        path = self._fallback_cover()
        if path:
            os.remove(path)
        BulletinHelper.show_info("Заглушка удалена / Fallback cover removed")

    def _fetch_koito(self):
        base = self.get_setting("koito_url", "").strip().rstrip("/")
        parsed = urlparse(base)
        if parsed.scheme != "https" or not parsed.netloc or parsed.username or parsed.password or parsed.query or parsed.fragment:
            raise ValueError("Koito URL must be an HTTPS address without credentials or query")
        token = self.get_setting("koito_token", "").strip()
        headers = {"Authorization": "Token " + token} if token else {}
        response = requests.get(base + "/apis/web/v1/now-playing", headers=headers,
                                timeout=10, allow_redirects=False)
        response.raise_for_status()
        if response.status_code != 200:
            raise ValueError("Unexpected Koito response")
        data = response.json()
        if not isinstance(data, dict) or not isinstance(data.get("currently_playing"), bool):
            raise ValueError("Invalid Koito response")
        if not data["currently_playing"]:
            return None
        track = data.get("track")
        if not isinstance(track, dict) or not isinstance(track.get("title"), str) or not track["title"].strip():
            raise ValueError("Invalid Koito track")
        artists = track.get("artists") or []
        if not isinstance(artists, list):
            artists = []
        names = [a["name"].strip() for a in artists if isinstance(a, dict)
                 and isinstance(a.get("name"), str) and a["name"].strip()]
        images = track.get("image") or {}
        image = next((images.get(size) for size in ("xl", "large", "medium", "small", "xs")
                      if isinstance(images, dict) and isinstance(images.get(size), str) and images.get(size)), None)
        if image:
            image = urljoin(base + "/", image)
            image_url = urlparse(image)
            if image_url.scheme != "https" or image_url.netloc != parsed.netloc:
                image = None
        track_id = track.get("id")
        track_url = base + "/track/" + str(track_id) if isinstance(track_id, int) and not isinstance(track_id, bool) and track_id > 0 else None
        return {"name": track["title"].strip(), "artist": ", ".join(names) or "Unknown Artist", "album_image": image, "track_url": track_url}

    def _fetch_recent_tracks(self, username):
        if self.get_setting("music_source", 0) == 1:
            track = self._fetch_koito()
            if not track:
                return {"recenttracks": {"track": [{"name": "", "artist": {"#text": ""}}]}}
            return {"recenttracks": {"track": [{"name": track["name"],
                "artist": {"#text": track["artist"]}, "@attr": {"nowplaying": "true"},
                "image": [{"size": "large", "#text": track["album_image"] or ""}]}]}}
        response = requests.get("https://ws.audioscrobbler.com/2.0/", params={
            "method": "user.getrecenttracks", "nowplaying": "true", "user": username,
            "api_key": self.get_setting("lastfm_api_key", "").strip() or API_KEY,
            "format": "json"}, timeout=10)
        response.raise_for_status()
        return response.json()

    def _recent_response(self, username):
        response = requests.Response()
        response.status_code = 200
        response._content = json.dumps(self._fetch_recent_tracks(username)).encode("utf-8")
        return response

    def _update_local_track(self):
        while not self._stop_event.is_set():
            if self.get_setting("music_source", 0) == 1 and self.get_setting("koito_profile_card", False):
                try:
                    track = self._fetch_koito()
                    if track:
                        track["profile_image"] = self._profile_cover(track.get("album_image"))
                    self._local_track = track
                    self._local_track_time = time.monotonic()
                except Exception as e:
                    log(f"[LastFM] Koito profile update failed: {type(e).__name__}")
            else:
                self._local_track = None
            self._stop_event.wait(15)

    def _profile_cover(self, url):
        if not url or not self._temp_dir:
            return None
        path = File(self._temp_dir, "koito_" + hashlib.sha256(url.encode("utf-8")).hexdigest() + ".png").getAbsolutePath()
        if os.path.isfile(path):
            return path
        temp = path + "." + str(uuid.uuid4()) + ".tmp"
        try:
            with requests.get(url, timeout=5, stream=True, allow_redirects=False) as response:
                response.raise_for_status()
                if response.status_code != 200 or not response.headers.get("Content-Type", "").lower().startswith("image/"):
                    return None
                content = bytearray()
                for chunk in response.iter_content(8192):
                    content.extend(chunk)
                    if len(content) > 5 * 1024 * 1024:
                        return None
            with Image.open(io.BytesIO(content)) as image:
                if image.width * image.height > 25000000:
                    return None
                image.convert("RGB").save(temp, "PNG")
            os.replace(temp, path)
            return path
        except Exception as e:
            log(f"[LastFM] Koito cover unavailable: {type(e).__name__}")
            return None
        finally:
            if os.path.exists(temp):
                os.remove(temp)

    def _streamer(self):
        log("[LastFM] Streamer started")
        while self._running:
            try:
                try:
                    update_interval = int(self.get_setting("update_interval", "30"))
                    if update_interval < 5:
                        update_interval = 5
                except:
                    update_interval = 30
                
                if self.get_setting("update_bio", False):
                    log("[LastFM] Update bio is enabled")
                    userFull = get_messages_controller().getUserFull(get_user_config().getClientUserId())
                    if not userFull:
                        log("[LastFM] Failed to get userFull")
                        self._stop_event.wait(update_interval)
                        continue

                    stream_place = self.get_setting("stream_place", 1 if get_user_config().isPremium() else 0)
                    max_len = 140 if get_user_config().isPremium() else 70

                    username = self.get_setting("lastfm_username", "")
                    if not username and self.get_setting("music_source", 0) == 0:
                        log("[LastFM] LastFM username is not set")
                        self._stop_event.wait(update_interval)
                        continue

                    log(f"[LastFM] Fetching track for user {username}")
                    response = self._recent_response(username)
                    
                    if response.status_code == 200:
                        data = response.json()
                        log(f"[LastFM] Got response: {data}")
                        if 'recenttracks' in data and 'track' in data['recenttracks'] and data['recenttracks']['track']:
                            log(f"[LastFM] Found tracks in response: {len(data['recenttracks']['track'])} tracks")
                            nowplaying_track = None
                            for track in data['recenttracks']['track']:
                                if '@attr' in track and 'nowplaying' in track['@attr']:
                                    nowplaying_track = track
                                    log(f"[LastFM] Found now playing track: {track}")
                                    break

                            if nowplaying_track:
                                log(f"[LastFM] Processing now playing track")
                                track_info = {
                                    'name': nowplaying_track.get('name', 'Unknown Track'),
                                    'artist': nowplaying_track.get('artist', {}).get('#text', 'Unknown Artist'),
                                    'album_image': None
                                }

                                log(f"[LastFM] Track info: {track_info}")

                                images = nowplaying_track.get('image', [])
                                log(f"[LastFM] Available images: {images}")
                                for size in ['extralarge', 'large', 'medium', 'small']:
                                    for img in images:
                                        if img.get('size') == size:
                                            track_info['album_image'] = img.get('#text')
                                            if track_info['album_image'] and track_info['album_image'].strip():
                                                log(f"[LastFM] Selected image size {size}: {track_info['album_image']}")
                                                break
                                    if track_info['album_image']:
                                        break

                                log(f"[LastFM] Final track info: {track_info}")
                                
                                try:
                                    
                                    np_format = self.get_setting("track_display_format", DEFAULT_STREAM_STRING)
                                    bio_text = np_format.replace("{title}", track_info['name']).replace("{artist}", track_info['artist'])
                                    
                                    if stream_place == 0:
                                        if userFull.about != bio_text[:max_len]:
                                            try:
                                                req = TL_account.updateProfile()
                                                req.flags = 4
                                                req.about = bio_text[:max_len]
                                                send_request(req, ())
                                                log(f"[LastFM] Updated bio with: {bio_text[:max_len]}")
                                            except Exception as e:
                                                log(f"[LastFM] Error updating bio: {e}")
                                    else:
                                        if not get_user_config().isPremium():
                                            log("[LastFM] User is not premium, can't update business location")
                                            self._stop_event.wait(update_interval)
                                            continue
                                        try:
                                            req = TL_account.updateBusinessLocation()
                                            req.address = bio_text[:96]
                                            req.flags = 1
                                            send_request(req, ())
                                            log(f"[LastFM] Updated business location with: {bio_text[:96]}")
                                        except Exception as e:
                                            log(f"[LastFM] Error updating business location: {e}")
                                            
                                except Exception as e:
                                    log(f"[LastFM] Error in bio update: {e}")
                                    import traceback
                                    log(f"[LastFM] Traceback: {traceback.format_exc()}")

                            else:
                                log("[LastFM] No now playing track found")
                                default_bio = self.get_setting("default_stream_text", DEFAULT_STREAM_TEXT)
                                if stream_place == 0:
                                    if userFull.about != default_bio[:max_len]:
                                        try:
                                            req = TL_account.updateProfile()
                                            req.flags = 4
                                            req.about = default_bio[:max_len]
                                            send_request(req, ())
                                            log("[LastFM] Set default bio")
                                        except Exception as e:
                                            log(f"[LastFM] Error setting default bio: {e}")
                                else:
                                    if not get_user_config().isPremium():
                                        log("[LastFM] User is not premium, can't update business location")
                                        self._stop_event.wait(update_interval)
                                        continue
                                    try:
                                        req = TL_account.updateBusinessLocation()
                                        req.address = default_bio[:96]
                                        req.flags = 1
                                        send_request(req, ())
                                        log("[LastFM] Set default bio in business location")
                                    except Exception as e:
                                        log(f"[LastFM] Error setting default bio in business location: {e}")
                        else:
                            log("[LastFM] No tracks found in response")
                    else:
                        log(f"[LastFM] Bad response from LastFM API: {response.status_code}")
                        default_bio = self.get_setting("default_stream_text", DEFAULT_STREAM_TEXT)
                        if stream_place == 0:
                            if userFull.about != default_bio[:max_len]:
                                try:
                                    req = TL_account.updateProfile()
                                    req.flags = 4
                                    req.about = default_bio[:max_len]
                                    send_request(req, ())
                                    log("[LastFM] Set default bio after bad response")
                                except Exception as e:
                                    log(f"[LastFM] Error setting default bio after bad response: {e}")
                        else:
                            if not get_user_config().isPremium():
                                log("[LastFM] User is not premium, can't update business location")
                                self._stop_event.wait(update_interval)
                                continue
                            try:
                                req = TL_account.updateBusinessLocation()
                                req.address = default_bio[:96]
                                req.flags = 1
                                send_request(req, ())
                                log("[LastFM] Set default bio in business location after bad response")
                            except Exception as e:
                                log(f"[LastFM] Error setting default bio in business location after bad response: {e}")

                self._stop_event.wait(update_interval)
            except Exception as e:
                log(f"[LastFM] Streamer error: {e}")
                self._stop_event.wait(10)

    def _dismiss_dialog(self):
        global progress_dialog
        try:
            if progress_dialog is not None and progress_dialog.isShowing():
                progress_dialog.dismiss()
        except Exception:
            pass
        finally:
            progress_dialog = None

    def on_plugin_load(self):
        self._running = True
        self._stop_event.clear()
        threading.Thread(target=self._streamer, daemon=True).start()
        threading.Thread(target=self._update_local_track, daemon=True).start()
        try:
            from hook_utils import find_class
            controller = find_class("com.exteragram.messenger.nowplaying.NowPlayingController")
            if controller is None:
                raise RuntimeError("NowPlayingController class not found")
            try:
                methods = controller.getDeclaredMethods()
            except Exception:
                try:
                    methods = controller.class_.getDeclaredMethods()
                except Exception:
                    methods = jclass("java.lang.Class").forName("com.exteragram.messenger.nowplaying.NowPlayingController").getDeclaredMethods()
            installed = False
            for method in methods:
                if method.getName() == "getCurrentPlayingTrack" and len(method.getParameterTypes()) == 4:
                    self.hook_method(method, _NowPlayingHook(self))
                    installed = True
                    log("[LastFM] Local Now Playing hook installed")
                    break
            if not installed:
                log("[LastFM] Local Now Playing method not found")
        except Exception as e:
            log(f"[LastFM] Local Now Playing unavailable: {e}")
        try:
            from hook_utils import find_class
            card = find_class("com.exteragram.messenger.nowplaying.ui.components.NowPlayingCard")
            methods = card.getDeclaredMethods()
            installed = False
            for method in methods:
                types = method.getParameterTypes()
                if (len(types) == 6 and str(types[0].getName()) == "com.exteragram.messenger.api.dto.NowPlayingDTO"
                        and str(types[2].getName()) == "boolean"
                        and str(types[3].getName()) == "android.widget.FrameLayout"
                        and str(types[4].getName()) == "com.exteragram.messenger.nowplaying.ui.components.NowPlayingCardData"):
                    self.hook_method(method, _KoitoCardClickHook(self))
                    installed = True
                    break
            if not installed:
                log("[LastFM] Koito click hook unavailable; long press still works")
        except Exception as e:
            log(f"[LastFM] Koito click hook unavailable: {e}")
        self.add_on_send_message_hook()
        self._temp_dir = self._get_temp_dir()
        if self._temp_dir:
            threading.Thread(target=self._download_fonts, daemon=True).start()
            log("LastFM plugin loaded successfully")
        else:
            log("Failed to initialize temp directory for LastFM")

    def on_plugin_unload(self):
        self._running = False
        self._stop_event.set()
        self._local_track = None
        self._remove_cover_picker_hook()
        log("LastFM plugin unloaded")
        self.alert_manager.dismiss_dialog()

    def _download_fonts(self):
        try:
            for font_name, font_url in FONTS.items():
                font_path = File(self._temp_dir, f"{font_name}-Regular.ttf").getAbsolutePath()
                if not os.path.exists(font_path):
                    response = requests.get(font_url)
                    with open(font_path, 'wb') as f:
                        f.write(response.content)
                    log(f"Downloaded font: {font_name}")
        except Exception as e:
            log(f"Error downloading fonts: {e}")

    def _handle_show_faq_alert_click(self, view):
        title = locali.get_string("FONT_FAQ_TITLE")
        text = locali.get_string("FONT_FAQ_TEXT")
        close_button = locali.get_string("ALERT_CLOSE_BUTTON")
        self.alert_manager.show_info_alert(title, text, close_button)

