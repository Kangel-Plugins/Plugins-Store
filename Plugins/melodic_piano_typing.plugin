# ---------------------------------------------------------------------------
# Смычковые (wavetable + вибрато + смычковый шум)
# formants — (центр Гц, ширина Гц, усиление): резонансы корпуса
# ---------------------------------------------------------------------------
STRINGS = {
    "vn": {  # скрипка
        "tilt": 0.95, "roll": 4800.0, "maxh": 28,
        "formants": [(290.0, 100.0, 0.7), (520.0, 160.0, 1.0), (1500.0, 500.0, 0.8), (3000.0, 900.0, 0.6)],
        "att": 0.045, "sd": 0.35, "vr": 5.6, "vd": 0.0065, "vdelay": 0.12, "am": 0.07,
        "noise": 0.05, "scratch": 3.0, "dur": 1.15,
    },
    "vc": {  # виолончель
        "tilt": 1.0, "roll": 2800.0, "maxh": 30,
        "formants": [(120.0, 40.0, 0.5), (200.0, 70.0, 1.0), (450.0, 150.0, 0.8),
                     (1000.0, 350.0, 0.7), (2000.0, 600.0, 0.35)],
        "att": 0.065, "sd": 0.30, "vr": 5.0, "vd": 0.0050, "vdelay": 0.15, "am": 0.06,
        "noise": 0.06, "scratch": 3.0, "dur": 1.35,
    },
}


def _midi_to_freq(m):
    return 440.0 * (2.0 ** ((m - 69.0) / 12.0))


def _token_to_midis(token: str):
    res = []
    for part in token.upper().split("+"):
        p = part.strip()
        if len(p) < 2:
            continue
        octv = int(p[-1]) if p[-1].isdigit() else 4
        note = p[:-1] if p[-1].isdigit() else p
        if note in SEMITONES:
            res.append((octv + 1) * 12 + SEMITONES[note])
    return res


def _token_to_freqs(token: str):
    return [_midi_to_freq(m) for m in _token_to_midis(token)]


# ------------------------------ пианино -------------------------------------

def _piano_partials(f0, midi, P):
    """Список обертонов ноты: (частота, громкость, множитель скорости затухания)."""
    res = []
    fc = P["fc"]
    custom = P.get("partials")
    if custom:
        for r, a, dm in custom:
            fk = f0 * r
            if fk <= FMAX:
                res.append((fk, a / (1.0 + (fk / fc) ** 2), dm))
    else:
        bcoef = P["b"] * 2.0 ** ((midi - 36.0) / 14.0)
        beta = min(0.16, max(0.075, 0.125 - 0.0016 * (midi - 60.0)))  # точка удара молоточка
        for k in range(1, 41):
            fk = k * f0 * math.sqrt(1.0 + bcoef * k * k)
            if fk > FMAX:
                break
            a = (k ** -P["alpha"]) * abs(math.sin(math.pi * k * beta)) / (1.0 + (fk / fc) ** 2)
            if fk < 150.0:
                a *= (fk / 150.0) ** 1.2
            res.append((fk, a, 1.0 + P["gamma"] * (k - 1)))
    if not res:
        return res
    amax = max(a for _, a, _ in res)
    res = [t for t in res if t[1] >= amax * 0.025]
    sym = P.get("sym", 0.0)
    if sym:
        res.append((f0 * 0.5, amax * sym, 0.5))
        res.append((f0 / 3.0, amax * sym * 0.6, 0.5))
    return res


def _render_piano(midis, P, dur_s, strum=0.0):
    """Рендер ноты/аккорда. Каждая гармоника = две слегка расстроенные струны
    (быстрое + медленное затухание), как у настоящего фортепиано."""
    n = int(SR * dur_s)
    acc = [0j] * n
    rng = random.Random(7919 + sum(midis) * 31)
    two_pi_sr = 2.0 * math.pi / SR
    wf = P["wf"]
    comps = ((wf, P["df"], -P["cents"] / 2.0), (1.0 - wf, P["ds"], P["cents"] / 2.0))
    wander = P.get("wander", 0.0)

    for ni, midi in enumerate(midis):
        off = int(ni * strum * SR)
        if off >= n - 8:
            continue
        f0 = _midi_to_freq(midi)
        pf = (f0 / 261.63) ** 0.45
        shift = 2.0 ** (rng.uniform(-wander, wander) / 1200.0) if wander else 1.0
        for fk, a, dm in _piano_partials(f0, midi, P):
            fk *= shift
            for wgt, rbase, cents in comps:
                if wgt <= 0.0:
                    continue
                rate = rbase * pf * dm
                m = min(n - off, int(SR * 7.0 / rate) + 2)
                step = cmath.rect(math.exp(-rate / SR), two_pi_sr * fk * (2.0 ** (cents / 1200.0)))
                series = accumulate(repeat(step, m - 1), mul, initial=complex(a * wgt, 0.0))
                end = off + m
                acc[off:end] = map(add, acc[off:end], series)

    out = [z.imag for z in acc]
    pk = max(abs(x) for x in out) or 1.0

    nz = P.get("noise", 0.0)
    if nz > 0.0:
        tau = 0.0035 * SR
        amp = pk * nz * 3.0
        lp = 0.0
        for i in range(min(int(0.016 * SR), n)):
            lp += 0.30 * ((rng.random() * 2.0 - 1.0) * math.exp(-i / tau) - lp)
            out[i] += lp * amp

    na = max(1, int(SR * P["att"] / 1000.0))
    for i in range(min(na, n)):
        out[i] *= i / na

    fst = int(n * 0.78)
    fl = max(1, n - fst)
    for i in range(fst, n):
        out[i] *= 0.5 * (1.0 + math.cos(math.pi * (i - fst) / fl))
    return out


# ------------------------------ смычковые -----------------------------------

_STR_CACHE = {}


def _make_table(amps):
    acc = [0j] * WT
    for h, a in enumerate(amps, 1):
        if a < 1e-4:
            continue
        step = cmath.rect(1.0, 2.0 * math.pi * h / WT)
        series = accumulate(repeat(step, WT - 1), mul, initial=complex(a, 0.0))
        acc = list(map(add, acc, series))
    t = [z.imag for z in acc]
    pk = max(abs(x) for x in t) or 1.0
    t = [x / pk for x in t]
    t.append(t[0])  # для линейной интерполяции
    return t


def _string_shared(key):
    """Вибрато, огибающая и смычковый шум одинаковы для всех нот инструмента — считаем один раз."""
    c = _STR_CACHE.get(key)
    if c:
        return c
    S = STRINGS[key]
    n = int(SR * S["dur"])
    two_pi = 2.0 * math.pi
    tau = S["att"] / 3.0
    rng = random.Random(4242)
    fade_start = int(n * 0.66)
    fade_len = max(1, n - fade_start)
    vm, env, noise = [], [], []
    lp = 0.0
    for i in range(n):
        t = i / SR
        vb = min(1.0, max(0.0, (t - S["vdelay"]) / 0.30))
        ph = two_pi * S["vr"] * t
        vm.append(1.0 + S["vd"] * vb * math.sin(ph))
        e = (1.0 - math.exp(-t / tau)) * math.exp(-S["sd"] * t)
        e *= 1.0 + S["am"] * vb * math.sin(ph - 1.0)
        if i >= fade_start:
            e *= 0.5 * (1.0 + math.cos(math.pi * (i - fade_start) / fade_len))
        env.append(e)
        lp += 0.45 * ((rng.random() * 2.0 - 1.0) - lp)
        noise.append(lp * S["noise"] * (1.0 + S["scratch"] * math.exp(-t / 0.06)) * e)
    c = (vm, env, noise)
    _STR_CACHE[key] = c
    return c


def _render_bowed(midi, key):
    S = STRINGS[key]
    f0 = _midi_to_freq(midi)
    vm, env, noise = _string_shared(key)
    nh = max(1, min(S["maxh"], int(0.46 * SR / f0)))
    amps = []
    for h in range(1, nh + 1):
        fh = h * f0
        form = 0.30 + sum(g * math.exp(-((fh - c) / w) ** 2) for c, w, g in S["formants"])
        amps.append((h ** -S["tilt"]) * form / (1.0 + (fh / S["roll"]) ** 2))
    wt = _make_table(amps)
    inc0 = f0 * WT / SR
    out = []
    ap = out.append
    p = 0.0
    for v, e, z in zip(vm, env, noise):
        p += inc0 * v
        i = int(p)
        fr = p - i
        i &= WT_MASK
        a = wt[i]
        ap((a + (wt[i + 1] - a) * fr) * e + z)
    return out


def _violin_midi(midis):
    m = max(midis)          # скрипка ведёт верхний голос
    while m < 55:
        m += 12
    while m > 100:
        m -= 12
    return m


def _cello_midi(midis):
    m = min(midis) - 12     # виолончель — нижний голос на октаву ниже
    while m < 36:
        m += 12
    while m > 79:
        m -= 12
    return m


def _save_wav(path: str, samples):
    pk = max(abs(x) for x in samples) or 1.0
    g = 32767.0 * NORM_PEAK / pk
    arr = array("h", [int(x * g) for x in samples])
    if sys.byteorder == "big":
        arr.byteswap()
    raw = arr.tobytes()
    sz = len(raw)
    tmp = path + ".tmp"
    with open(tmp, "wb") as fp:
        fp.write(struct.pack("<4sI4s4sIHHIIHH4sI", b"RIFF", 36 + sz, b"WAVE", b"fmt ", 16, 1, 1, SR, SR * 2, 2, 16, b"data", sz))
        fp.write(raw)
    os.replace(tmp, path)


def _note_duration(midis, P):
    top = max(midis)
    return max(0.4, max(1.0, min(1.8, 2.0 - (top - 48) * 0.022)) * P["dur"])


class _Abort(Exception):
    pass


class _Watcher(dynamic_proxy(TextWatcher)):
    def __init__(self, plg, vid: int):
        super().__init__()
        self.plg = plg
        self.vid = vid

    def beforeTextChanged(self, s, st, c, a):
        pass

    def onTextChanged(self, s, st, bef, cnt):
        try:
            self.plg.on_text(self.vid, s, st, bef, cnt)
        except Exception:
            pass

    def afterTextChanged(self, s):
        pass


class MelodicPianoSequencer(BasePlugin):
    def __init__(self):
        super().__init__()
        self._sp = None
        self._token_ids = {}
        self._vn_ids = {}
        self._vc_ids = {}
        self._seq = []
        self._step = 0
        self._bs_id = 0
        self._send_id = 0
        self._vn_send_id = 0
        self._vc_send_id = 0
        self._busy = False
        self._dirty = False
        self._want_prev = False
        self._lock = threading.Lock()
        self._stop = threading.Event()
        self._thr = None
        self._views = set()
        self._wlist = []
        self._vtime = {}
        self._lts = 0.0
        self._cleaned = False

    def on_plugin_load(self):
        self._init_sp()
        self.add_on_send_message_hook()
        if self.get_setting("enabled", True):
            self._reload_async(False)
            self._start_mon()

    def on_plugin_unload(self):
        self._stop_mon()
        if self._sp:
            try:
                self._sp.release()
            except Exception:
                pass
            self._sp = None

    def create_settings(self):
        return [
            Header(text="Основные настройки"),
            Switch(key="enabled", text="Включить мелодию при наборе", subtext="Каждое нажатие клавиши играет следующую ноту мелодии", default=True, icon="msg_music", on_change=self._on_tgl),
            Selector(key="preset", text="Выбор мелодии", default=1, items=PRESET_NAMES, icon="msg_ton", on_change=self._on_cfg),
            Divider(),
            Header(text="Конструктор своей мелодии (4 такта 4/4)"),
            Input(key="bar1", text="Такт 1 (4/4)", subtext="4 четвертные или 8 восьмых нот (или вставьте все 4 такта через |)", default="D#5 G#4 A#4 G#4 D#5 G#4 A#4 G#4", icon="msg_edit", on_change=self._on_bar_change),
            Input(key="bar2", text="Такт 2 (4/4)", subtext="Второй такт (аккорды пишутся через +, например C4+E4+G4)", default="D#5 G#4 A#4 G#4 F5 G#4 A#4 G#4", icon="msg_edit", on_change=self._on_bar_change),
            Input(key="bar3", text="Такт 3 (4/4)", subtext="Третий такт (можно оставить пустым, если нужно меньше тактов)", default="D5 G4 A#4 G4 D5 G4 A#4 G4", icon="msg_edit", on_change=self._on_bar_change),
            Input(key="bar4", text="Такт 4 (4/4)", subtext="Четвёртый завершающий такт квадрата", default="D5 G4 A#4 G4 F5 G4 A#4 G4", icon="msg_edit", on_change=self._on_bar_change),
            Divider(),
            Header(text="Инструмент"),
            Selector(key="timbre", text="Тембр инструмента", default=0, items=TIMBRE_NAMES, icon="msg_voice_pip", on_change=self._on_cfg),
            Input(key="volume", text="Громкость (10-100)", default="80", icon="msg_notifications", on_change=lambda _: self._preview_step()),
            Switch(key="humanize", text="Живая игра", subtext="Лёгкие случайные отличия в силе каждого нажатия, как у живого исполнителя", default=True, icon="msg_music"),
            Divider(),
            Header(text="Струнные (добавляются к пианино)"),
            Switch(key="violin_enabled", text="Скрипка", subtext="Ведёт верхний голос смычком, с вибрато. По умолчанию выключена", default=False, icon="msg_voice_pip", on_change=self._on_str_cfg),
            Switch(key="cello_enabled", text="Виолончель", subtext="Играет нижний голос на октаву ниже, тёплый смычковый тон. По умолчанию выключена", default=False, icon="msg_voice_pip", on_change=self._on_str_cfg),
            Input(key="strings_volume", text="Громкость струнных (10-100)", subtext="Относительно основной громкости", default="60", icon="msg_notifications", on_change=lambda _: self._preview_step()),
            Divider(),
            Header(text="Поведение"),
            Input(key="reset_sec", text="Сброс мелодии после паузы (сек)", subtext="0 = не сбрасывать после паузы", default="8", icon="msg_timer"),
            Switch(key="reset_on_send", text="Сбрасывать мелодию при отправке", subtext="Начинать сначала при отправке сообщения + финальный аккорд", default=True, icon="msg_send"),
            Switch(key="enable_backspace", text="Откатывать ноту назад при Backspace", subtext="При стирании символа шаг мелодии возвращается на 1 ноту назад", default=True, icon="msg_delete"),
        ]

    def _tid(self) -> int:
        try:
            return max(0, min(len(TIMBRES) - 1, int(self.get_setting("timbre", 0))))
        except Exception:
            return 0

    def _pid(self) -> int:
        try:
            return max(0, min(len(PRESET_NOTES) - 1, int(self.get_setting("preset", 1))))
        except Exception:
            return 1

    def _vol(self) -> float:
        try:
            return max(5, min(100, int(str(self.get_setting("volume", "80")).strip()))) / 100.0
        except Exception:
            return 0.80

    def _svol(self) -> float:
        try:
            return max(5, min(100, int(str(self.get_setting("strings_volume", "60")).strip()))) / 100.0
        except Exception:
            return 0.60

    def _flag(self, key: str) -> bool:
        try:
            return bool(self.get_setting(key, False))
        except Exception:
            return False

    def _reset_timeout(self) -> float:
        try:
            return float(max(0, int(str(self.get_setting("reset_sec", "8")).strip())))
        except Exception:
            return 8.0

    def _on_tgl(self, en: bool):
        if en:
            self._reload_async(True)
            self._start_mon()
        else:
            self._stop_mon()

    def _on_cfg(self, _v):
        self._step = 0
        self._reload_async(True)

    def _on_str_cfg(self, _v):
        self._reload_async(True)

    def _on_bar_change(self, _v):
        b1 = str(self.get_setting("bar1", ""))
        if "|" in b1:
            parts = [p.strip() for p in b1.split("|")]
            for idx in range(min(4, len(parts))):
                self.set_setting(f"bar{idx + 1}", parts[idx])
        self.set_setting("preset", 0)
        self._step = 0
        self._reload_async(True)

    def _init_sp(self):
        try:
            a = AABuilder().setUsage(AAttr.USAGE_MEDIA).setContentType(AAttr.CONTENT_TYPE_MUSIC).build()
            self._sp = SPBuilder().setMaxStreams(20).setAudioAttributes(a).build()
        except Exception as e:
            log(f"[PianoSeq] SP err: {e}")

    def _get_melody_tokens(self):
        pid = self._pid()
        if pid == 0:
            bars = [str(self.get_setting(f"bar{i}", "")) for i in range(1, 5)]
            raw = " ".join(bars)
        else:
            raw = PRESET_NOTES[pid]
        tokens = [t.strip().upper() for t in str(raw).replace(",", " ").replace("|", " ").split() if _token_to_freqs(t)]
        return tokens if tokens else ["C4", "E4", "G4", "C5"]

    def _reload_async(self, prev: bool):
        # Любое изменение настроек во время синтеза не теряется: рендер перезапускается.
        with self._lock:
            self._dirty = True
            if prev:
                self._want_prev = True
            if self._busy:
                return
            self._busy = True

        def _run():
            while True:
                with self._lock:
                    if not self._dirty:
                        self._busy = False
                        return
                    self._dirty = False
                    prev_now = self._want_prev
                    self._want_prev = False
                try:
                    self._synth_melody()
                    if prev_now and not self._dirty:
                        time.sleep(0.08)
                        self._preview_step()
                except Exception as e:
                    log(f"[PianoSeq] Synth err: {e}")

        threading.Thread(target=_run, daemon=True).start()

    def _cleanup_old_cache(self, base: str):
        if self._cleaned:
            return
        self._cleaned = True
        for name in OLD_CACHE_DIRS:
            try:
                shutil.rmtree(os.path.join(base, name), ignore_errors=True)
            except Exception:
                pass

    def _synth_melody(self):
        if not self._sp:
            self._init_sp()
        if not self._sp:
            return
        tid = self._tid()
        P = TIMBRES[tid]
        want_vn = self._flag("violin_enabled")
        want_vc = self._flag("cello_enabled")
        tokens = self._get_melody_tokens()
        base = str(AppLoader.applicationContext.getCacheDir().getAbsolutePath())
        cdir = os.path.join(base, CACHE_DIR)
        os.makedirs(cdir, exist_ok=True)
        self._cleanup_old_cache(base)

        loaded = []

        def load(path):
            sid = self._sp.load(path, 1)
            loaded.append(sid)
            return sid

        def ensure(path, make):
            if not os.path.exists(path):
                _save_wav(path, make())

        new_p, new_vn, new_vc = {}, {}, {}
        try:
            for tok in dict.fromkeys(tokens):
                if self._dirty:
                    raise _Abort()
                safe = tok.replace("#", "s").replace("+", "_")
                midis = _token_to_midis(tok)
                strum = 0.015 if len(midis) > 1 else 0.0

                p = os.path.join(cdir, f"p{tid}_{safe}.wav")
                ensure(p, lambda: _render_piano(midis, P, _note_duration(midis, P), strum))
                new_p[tok] = load(p)

                if want_vn:
                    vm = _violin_midi(midis)
                    p = os.path.join(cdir, f"vn_{safe}.wav")
                    ensure(p, lambda: _render_bowed(vm, "vn"))
                    new_vn[tok] = load(p)
                if want_vc:
                    cm = _cello_midi(midis)
                    p = os.path.join(cdir, f"vc_{safe}.wav")
                    ensure(p, lambda: _render_bowed(cm, "vc"))
                    new_vc[tok] = load(p)

            if self._dirty:
                raise _Abort()

            p_bs = os.path.join(cdir, f"p{tid}_bs.wav")
            ensure(p_bs, lambda: _render_piano([55, 50], P, 0.35, 0.01))
            bs_id = load(p_bs)

            p_snd = os.path.join(cdir, f"p{tid}_snd.wav")
            ensure(p_snd, lambda: _render_piano([57, 61, 64, 69], P, 1.2, 0.02))
            snd_id = load(p_snd)

            vn_snd = vc_snd = 0
            if want_vn:
                p = os.path.join(cdir, "vn_snd.wav")
                ensure(p, lambda: _render_bowed(76, "vn"))
                vn_snd = load(p)
            if want_vc:
                p = os.path.join(cdir, "vc_snd.wav")
                ensure(p, lambda: _render_bowed(45, "vc"))
                vc_snd = load(p)
        except _Abort:
            for sid in loaded:
                try:
                    self._sp.unload(sid)
                except Exception:
                    pass
            return

        old = (list(self._token_ids.values()) + list(self._vn_ids.values()) + list(self._vc_ids.values())
               + [self._bs_id, self._send_id, self._vn_send_id, self._vc_send_id])
        self._token_ids = new_p
        self._vn_ids = new_vn
        self._vc_ids = new_vc
        self._seq = tokens
        self._bs_id = bs_id
        self._send_id = snd_id
        self._vn_send_id = vn_snd
        self._vc_send_id = vc_snd
        for oid in old:
            if oid and oid > 0:
                try:
                    self._sp.unload(oid)
                except Exception:
                    pass

    def _play(self, sid: int, sc: float = 1.0, human: bool = False):
        if sid and self._sp:
            v = max(0.02, min(1.0, self._vol() * sc))
            rate = 1.0
            if human and self.get_setting("humanize", True):
                v = max(0.02, min(1.0, v * random.uniform(0.90, 1.0)))
                rate = random.uniform(0.9985, 1.0015)
            try:
                self._sp.play(sid, v, v, 1, 0, rate)
            except Exception:
                pass

    def _play_layers(self, tok: str, sc: float, human: bool):
        self._play(self._token_ids.get(tok, 0), sc, human)
        if self._vn_ids and self._flag("violin_enabled"):
            self._play(self._vn_ids.get(tok, 0), self._svol() * 0.75 * sc, human)
        if self._vc_ids and self._flag("cello_enabled"):
            self._play(self._vc_ids.get(tok, 0), self._svol() * 0.90 * sc, human)

    def _preview_step(self):
        if self._seq:
            tok = self._seq[self._step % len(self._seq)]
            self._play_layers(tok, 0.95, False)

    def _play_next_step(self):
        if not self._seq:
            return
        now = time.time()
        if now - self._lts < 0.018:
            return
        rsec = self._reset_timeout()
        if rsec > 0 and self._lts > 0 and (now - self._lts) > rsec:
            self._step = 0
        self._lts = now
        tok = self._seq[self._step % len(self._seq)]
        self._step += 1
        self._play_layers(tok, 1.0, True)

    def on_text(self, vid: int, s, st: int, bef: int, cnt: int):
        if not self.get_setting("enabled", True) or s is None:
            return
        if time.time() - self._vtime.get(vid, 0.0) < 0.18:
            return
        txt = str(s)
        if not txt and bef > 1:
            return
        df = cnt - bef
        if df >= 1 and (st + cnt) <= len(txt):
            self._play_next_step()
        elif df == -1 and cnt >= 0:
            if self.get_setting("enable_backspace", True):
                self._step = max(0, self._step - 1)
                if time.time() - self._lts >= 0.025:
                    self._lts = time.time()
                    self._play(self._bs_id, 0.45)

    def on_send_message_hook(self, account, params):
        if self.get_setting("enabled", True) and self.get_setting("reset_on_send", True):
            self._step = 0
            self._play(self._send_id, 0.85)
            if self._flag("violin_enabled"):
                self._play(self._vn_send_id, self._svol() * 0.75 * 0.85)
            if self._flag("cello_enabled"):
                self._play(self._vc_send_id, self._svol() * 0.90 * 0.85)
        return HookResult()

    def _start_mon(self):
        self._stop_mon()
        self._stop.clear()
        self._thr = threading.Thread(target=self._loop, daemon=True)
        self._thr.start()

    def _stop_mon(self):
        self._stop.set()
        if self._thr and self._thr.is_alive():
            self._thr.join(timeout=1.0)
        self._thr = None

    def _hook(self, v):
        if v is None:
            return
        try:
            if isinstance(v, EditText):
                vid = int(Sys.identityHashCode(v))
                if vid not in self._views:
                    self._views.add(vid)
                    self._vtime[vid] = time.time()
                    w = _Watcher(self, vid)
                    self._wlist.append(w)
                    v.addTextChangedListener(w)
            elif isinstance(v, ViewGroup):
                for i in range(v.getChildCount()):
                    self._hook(v.getChildAt(i))
        except Exception:
            pass

    def _scan(self):
        try:
            from client_utils import get_last_fragment
            f = get_last_fragment()
            if not f:
                return
            a = f.getParentActivity()
            if a:
                self._hook(a.getCurrentFocus())
            d = f.getVisibleDialog()
            if d:
                self._hook(d.getCurrentFocus())
            fv = f.getFragmentView()
            if fv:
                self._hook(fv.findFocus())
        except Exception:
            pass

    def _loop(self):
        while not self._stop.is_set():
            if self.get_setting("enabled", True):
                run_on_ui_thread(self._scan)
            if self._stop.wait(timeout=0.35):
                break
