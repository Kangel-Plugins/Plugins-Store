SR = 22050
FMAX = 8000.0          # выше этой частоты гармоники не синтезируются
NORM_PEAK = 0.80       # пиковый уровень готовых сэмплов (доля от полной шкалы)
WT = 4096              # размер wavetable для смычковых
WT_MASK = WT - 1
CACHE_DIR = "piano_seq_v3"
OLD_CACHE_DIRS = ("piano_seq_v2",)

SEMITONES = {
    "C": 0, "C#": 1, "DB": 1, "D": 2, "D#": 3, "EB": 3, "E": 4, "F": 5,
    "F#": 6, "GB": 6, "G": 7, "G#": 8, "AB": 8, "A": 9, "A#": 10, "BB": 10, "B": 11
}

