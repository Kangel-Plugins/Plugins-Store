import base64
import time
import zlib
from base_plugin import BasePlugin
from java import jclass
from org.telegram.messenger import ApplicationLoader, LocaleController

_last_lang_check = 0.0
_cached_is_eng = False

def is_english():
    global _last_lang_check, _cached_is_eng
    now = time.time()
    if now - _last_lang_check < 2.0:
        return _cached_is_eng
    try:
        lang = str(LocaleController.getLocaleStringIso639() or "").lower()
        if lang:
            _cached_is_eng = not (lang.startswith("ru") or lang.startswith("uk") or lang.startswith("be"))
            _last_lang_check = now
            return _cached_is_eng
    except Exception:
        pass
    try:
        Locale = jclass("java.util.Locale")
        lang = str(Locale.getDefault().getLanguage() or "").lower()
        _cached_is_eng = not (lang.startswith("ru") or lang.startswith("uk") or lang.startswith("be"))
        _last_lang_check = now
        return _cached_is_eng
    except Exception:
        return False

def tr(ru, en):
    return en if is_english() else ru

__id__ = "fast_crop"
__name__ = "FastCrop"
__description__ = "Быстрый кроп фото\видео\гиф жестом зума в буфер обмена как в галерее на iOS"
__author__ = "@dekma0091 && @DefinitelyNotDekma"
__version__ = "1.0"
__icon__ = "pixelcamera/19"
__min_version__ = "12.10.6"

ENTRY_CLASS = "ni.dekma.fastcrop.FastCropBridge"
BuildVersion = jclass("android.os.Build$VERSION")
_DEX_BASE64 = ""

class NativeBridge:
    def __init__(self, entry_class):
        self.entry_class = entry_class
        self.clazz = None
        self.loader = None
        self.loaded = False
        self._method_cache = {}

    def load(self):
        if self.loaded:
            try:
                self.unload()
            except Exception:
                pass
        context = ApplicationLoader.applicationContext
        if context is None:
            raise RuntimeError("application context is not ready")
        if int(BuildVersion.SDK_INT) < 26:
            raise RuntimeError("embedded DEX requires Android API 26+")
        if not _DEX_BASE64:
            raise RuntimeError("DEX payload is empty")
        raw_bytes = base64.b64decode(_DEX_BASE64)
        try:
            payload = zlib.decompress(raw_bytes)
        except Exception:
            payload = raw_bytes
        ByteBuffer = jclass("java.nio.ByteBuffer")
        InMemoryDexClassLoader = jclass("dalvik.system.InMemoryDexClassLoader")
        parent_loader = context.getClassLoader()
        self.loader = InMemoryDexClassLoader(ByteBuffer.wrap(payload), parent_loader)
        self.clazz = self.loader.loadClass(self.entry_class)
        self._method_cache.clear()
        try:
            self._invoke("load")
        except Exception:
            self._invoke("attach")
        self.loaded = True

    def unload(self):
        if self.clazz is not None:
            try:
                self._invoke("unload")
            except Exception:
                try:
                    self._invoke("detach")
                except Exception:
                    pass
        self._method_cache.clear()
        self.clazz = None
        self.loader = None
        self.loaded = False

    def _invoke(self, method_name, *args):
        if self.clazz is None:
            raise RuntimeError("embedded DEX class is not loaded")
        cache_key = (method_name, len(args))
        cached = self._method_cache.get(cache_key)
        if not cached:
            for method in self.clazz.getDeclaredMethods():
                if str(method.getName()) == method_name and len(method.getParameterTypes()) == len(args):
                    method.setAccessible(True)
                    cached = method
                    self._method_cache[cache_key] = cached
                    break
            if not cached:
                raise RuntimeError(f"method not found: {method_name}/{len(args)}")
        method = cached
        return method.invoke(None, *args)

class fast_crop(BasePlugin):
    def __init__(self):
        super().__init__()
        self._bridge = NativeBridge(ENTRY_CLASS)

    def on_plugin_load(self):
        try:
            self._bridge.load()
        except Exception:
            pass

    def on_plugin_unload(self):
        if hasattr(self, "_bridge") and self._bridge:
            try:
                self._bridge.unload()
            except Exception:
                pass
            self._bridge = None

    def on_load(self):
        self.on_plugin_load()

    def on_unload(self):
        self.on_plugin_unload()

FastCrop = fast_crop
FastCropPlugin = fast_crop
