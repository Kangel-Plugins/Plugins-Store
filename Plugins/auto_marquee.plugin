_LANG_NAME_MAP = {
    'english': 'en',
    'russian': 'ru',
    'русский': 'ru',
}


def _locale_controller():
    try:
        cls = find_class(LOCALE_CONTROLLER)
        if cls is not None:
            return cls
    except Exception:
        pass
    try:
        return jclass(LOCALE_CONTROLLER)
    except Exception:
        return None


def _locale_instance():
    cls = _locale_controller()
    if cls is None:
        return None
    try:
        return cls.getInstance()
    except Exception:
        return None


def _norm_lang(raw):
    if raw is None:
        return None
    try:
        code = str(raw).strip().lower()
    except Exception:
        return None
    if not code or code in ("null", "none"):
        return None
    code = _LANG_NAME_MAP.get(code, code)
    code = code.replace('_', '-').split('-', 1)[0]
    return code if code in STRINGS else None


def _lang_from_locale_info(inst):
    info = None
    if _has_method(inst, "getCurrentLocaleInfo"):
        try:
            info = inst.getCurrentLocaleInfo()
        except Exception:
            info = None

    if info is None:
        info = _get_field(inst, "currentLocaleInfo")
    if info is None:
        return None

    for getter in ("getLangCode", "getBaseLangCode", "getPluralLangCode", "getKey"):
        if not _has_method(info, getter):
            continue
        try:
            code = _norm_lang(getattr(info, getter)())
        except Exception:
            code = None
        if code:
            return code

    for fld in ("shortName", "pluralLangCode", "baseLangCode", "langCode", "name"):
        code = _norm_lang(_get_field(info, fld))
        if code:
            return code
    return None


def _get_lang():
    inst = _locale_instance()

    if inst is not None:
        try:
            code = _lang_from_locale_info(inst)
            if code:
                return code
        except Exception:
            pass

        if _has_method(inst, "getCurrentLocale"):
            try:
                locale_obj = inst.getCurrentLocale()
                if locale_obj is not None:
                    code = _norm_lang(locale_obj.getLanguage())
                    if code:
                        return code
            except Exception:
                pass

        locale_obj = _get_field(inst, "currentLocale")
        if locale_obj is not None:
            try:
                code = _norm_lang(locale_obj.getLanguage())
                if code:
                    return code
            except Exception:
                pass

        if _has_method(inst, "getCurrentLanguageName"):
            try:
                code = _norm_lang(inst.getCurrentLanguageName())
                if code:
                    return code
            except Exception:
                pass

    try:
        Locale = jclass("java.util.Locale")
        code = _norm_lang(Locale.getDefault().getLanguage())
        if code:
            return code
    except Exception:
        pass

    return 'en'


def _get_field(obj: Any, name: str) -> Any:
    try:
        cls = obj.getClass()
    except Exception:
        return None
    while cls is not None:
        try:
            field = cls.getDeclaredField(name)
            field.setAccessible(True)
            return field.get(obj)
        except Exception:
            try:
                cls = cls.getSuperclass()
            except Exception:
                return None
    return None


def _read_view_state(view, simple):
    if simple:
        value = _get_field(view, "scrollNonFitText")
        # Do not overwrite a state which cannot be restored safely.
        if value is None:
            return None
        return {"scroll": bool(value)}
    try:
        try:
            horizontal = view.isHorizontallyScrollable()
        except Exception:
            horizontal = _get_field(view, "mHorizontallyScrolling")
            if horizontal is None:
                return None
        return {
            "ellipsize": view.getEllipsize(),
            "repeat": view.getMarqueeRepeatLimit(),
            "fading": view.isHorizontalFadingEdgeEnabled(),
            "selected": view.isSelected(),
            "min_lines": view.getMinLines(),
            "max_lines": view.getMaxLines(),
            "horizontal": bool(horizontal),
        }
    except Exception:
        return None


def _set_marquee(view, simple):
    if simple:
        view.setScrollNonFitText(True)
    else:
        # Unlike setSingleLine(), these calls do not change the input type
        # or replace the view's transformation method.
        view.setMaxLines(1)
        view.setHorizontallyScrolling(True)
        view.setEllipsize(TruncateAt.MARQUEE)
        view.setMarqueeRepeatLimit(-1)
        view.setHorizontalFadingEdgeEnabled(True)
        view.setSelected(True)


def _restore_view(view, simple, state):
    if simple:
        operations = [("setScrollNonFitText", state["scroll"])]
    else:
        operations = [
            ("setEllipsize", state["ellipsize"]),
            ("setMarqueeRepeatLimit", state["repeat"]),
            ("setHorizontalFadingEdgeEnabled", state["fading"]),
            ("setSelected", state["selected"]),
            ("setMinLines", state["min_lines"]),
            ("setMaxLines", state["max_lines"]),
            ("setHorizontallyScrolling", state["horizontal"]),
        ]
    # One failing setter must not prevent the remaining restoration.
    for name, value in operations:
        try:
            getattr(view, name)(value)
        except Exception:
            pass


class _ViewRegistry:
    def __init__(self):
        self.entries = {}
        self.additions = 0
        self.queue = ReferenceQueue() if ReferenceQueue is not None else None
        self.reference_keys = {}

    def _remove(self, key):
        entry = self.entries.pop(key, None)
        if entry is None:
            return
        ref_id = entry.get("ref_id")
        keys = self.reference_keys.get(ref_id)
        if keys is not None:
            keys.discard(key)
            if not keys:
                self.reference_keys.pop(ref_id, None)

    def _drain_queue(self):
        if self.queue is None:
            return
        while True:
            ref = self.queue.poll()
            if ref is None:
                return
            ref_id = int(JavaSystem.identityHashCode(ref))
            # Handle identity-hash collisions without holding any referent.
            for key in list(self.reference_keys.get(ref_id, ())):
                entry = self.entries.get(key)
                if entry is not None and entry["ref"].get() is None:
                    self._remove(key)

    def _prune(self):
        for key, entry in list(self.entries.items()):
            if entry["ref"].get() is None:
                self._remove(key)

    def track(self, view, section):
        if WeakReference is None or JavaSystem is None:
            return None
        self._drain_queue()
        # Identity-hash lookup avoids a linear search in hot hooks.
        # Identity is compared only among still-live weak references.
        try:
            identity = int(JavaSystem.identityHashCode(view))
        except Exception:
            return None
        bucket = self.entries.get(identity)
        if bucket is not None:
            old = bucket["ref"].get()
            if old is not None:
                try:
                    same = bool(old.equals(view))
                except Exception:
                    same = old is view
                if same:
                    bucket["sections"].add(section)
                    return bucket
                # Extremely rare identity-hash collision: skip safely.
                return None
            self._remove(identity)
        simple = _has_method(view, "setScrollNonFitText")
        if not simple and (TruncateAt is None or not _has_method(view, "setEllipsize")):
            return None
        state = _read_view_state(view, simple)
        if state is None:
            return None
        ref = WeakReference(view, self.queue) if self.queue is not None else WeakReference(view)
        ref_id = int(JavaSystem.identityHashCode(ref))
        entry = {"ref": ref, "ref_id": ref_id, "simple": simple,
                 "state": state, "sections": {section}, "applied": False}
        self.entries[identity] = entry
        self.reference_keys.setdefault(ref_id, set()).add(identity)
        self.additions += 1
        if self.additions % 64 == 0:
            self._prune()
        return entry

    def refresh(self, plugin=None, unloading=False):
        try:
            self._drain_queue()
            for key, entry in list(self.entries.items()):
                try:
                    view = entry["ref"].get()
                    if view is None:
                        self._remove(key)
                        continue
                    wanted = (not unloading and plugin is not None
                              and any(plugin._section_enabled(s) for s in entry["sections"]))
                    _update_entry(view, entry, wanted)
                except Exception:
                    # An invalid/destroyed view must not block cleanup of others.
                    continue
        finally:
            if unloading:
                self.entries.clear()
                self.reference_keys.clear()
                self._drain_queue()


def _update_entry(view, entry, wanted):
    if wanted == entry["applied"]:
        return
    if wanted:
        # Capture again when re-enabling: the app may have changed the view.
        state = _read_view_state(view, entry["simple"])
        if state is None:
            return
        entry["state"] = state
        try:
            _set_marquee(view, entry["simple"])
            entry["applied"] = True
        except Exception:
            _restore_view(view, entry["simple"], state)
    else:
        _restore_view(view, entry["simple"], entry["state"])
        entry["applied"] = False


def _apply_marquee(plugin: "AutoMarqueePlugin", view: Any, section: str) -> None:
    if view is None or not plugin._section_enabled(section):
        return
    entry = plugin._registry.track(view, section)
    if entry is not None:
        _update_entry(view, entry, True)


class _PluginHook(MethodHook):
    def __init__(self, plugin):
        self._plugin_ref = weakref.ref(plugin)

    @property
    def _plugin(self):
        plugin = self._plugin_ref()
        return plugin if plugin is not None and getattr(plugin, "_active", False) else None


class _ChatAvatarContainerHook(_PluginHook):
    _section = "chat_header"

    def __init__(self, plugin: "AutoMarqueePlugin"):
        self._plugin_ref = weakref.ref(plugin)

    def after_hooked_method(self, param):
        p = self._plugin
        if p is None:
            return
        try:
            if not (p.get_setting("enabled", True) and p.get_setting("chat_header", True)):
                return
            container = param.thisObject
            if container is None:
                return
            if not _has_method(container, "getTitleTextView"):
                _apply_marquee(p, _get_field(container, "titleTextView"), "chat_header")
                return
            try:
                _apply_marquee(p, container.getTitleTextView(), "chat_header")
            except Exception:
                pass
        except Exception:
            pass


class _ActionBarTitleHook(_PluginHook):
    _section = "action_bar"

    def __init__(self, plugin: "AutoMarqueePlugin"):
        self._plugin_ref = weakref.ref(plugin)

    def after_hooked_method(self, param):
        p = self._plugin
        if p is None:
            return
        try:
            if not (p.get_setting("enabled", True) and p.get_setting("action_bar", True)):
                return
            action_bar = param.thisObject
            if action_bar is None:
                return

            title_view = None
            if _has_method(action_bar, "getTitleTextView"):
                try:
                    title_view = action_bar.getTitleTextView()
                except Exception:
                    title_view = None

            if title_view is None:
                title_view = _get_field(action_bar, "titleTextView")
            if title_view is None:
                return

            if hasattr(title_view, "__len__") and not _has_method(title_view, "setEllipsize"):
                try:
                    for view in title_view:
                        _apply_marquee(p, view, "action_bar")
                    return
                except Exception:
                    pass

            _apply_marquee(p, title_view, "action_bar")
        except Exception:
            pass


class _ProfileNameHook(_PluginHook):
    _section = "profile_name"

    def __init__(self, plugin: "AutoMarqueePlugin"):
        self._plugin_ref = weakref.ref(plugin)

    def after_hooked_method(self, param):
        p = self._plugin
        if p is None:
            return
        try:
            if not (p.get_setting("enabled", True) and p.get_setting("profile_name", True)):
                return
            fragment = param.thisObject
            if fragment is None:
                return
            names = _get_field(fragment, "nameTextView")
            if names is None:
                return
            if hasattr(names, "__len__") and not _has_method(names, "setScrollNonFitText"):
                try:
                    for view in names:
                        _apply_marquee(p, view, "profile_name")
                    return
                except Exception:
                    pass
            _apply_marquee(p, names, "profile_name")
        except Exception:
            pass


class _SettingsCellHook(_PluginHook):
    _section = "settings_cells"

    def __init__(self, plugin: "AutoMarqueePlugin"):
        self._plugin_ref = weakref.ref(plugin)

    def after_hooked_method(self, param):
        p = self._plugin
        if p is None:
            return
        try:
            if not (p.get_setting("enabled", True) and p.get_setting("settings_cells", True)):
                return
            cell = param.thisObject
            if cell is None:
                return
            for field_name in TEXT_FIELD_CANDIDATES:
                view = _get_field(cell, field_name)
                if view is not None:
                    _apply_marquee(p, view, "settings_cells")
        except Exception:
            pass


class _LanguageChangeHook(_PluginHook):

    def __init__(self, plugin: "AutoMarqueePlugin"):
        self._plugin_ref = weakref.ref(plugin)

    def after_hooked_method(self, param):
        plugin = self._plugin
        if plugin is None:
            return
        try:
            plugin._refresh_language()
        except Exception:
            pass


def _weak_setting_callback(plugin, method_name, *prefix):
    plugin_ref = weakref.ref(plugin)

    def callback(value):
        owner = plugin_ref()
        if owner is not None and getattr(owner, "_active", False):
            getattr(owner, method_name)(*prefix, value)
    return callback


class AutoMarqueePlugin(BasePlugin):
    def _section_enabled(self, section):
        return (getattr(self, "_active", False)
                and bool(self.get_setting("enabled", True))
                and bool(self.get_setting(section, True)))

    def _sync_gates(self):
        for section, gate in getattr(self, "_gates", {}).items():
            gate.set(self._section_enabled(section))

    def _hook_members(self, members: List[Any], hook: Any) -> List[Any]:
        unhooks = []
        section = getattr(hook, "_section", None)
        gate = self._gates.get(section)
        for member in members:
            try:
                member.setAccessible(True)
            except Exception:
                pass
            unhook = None
            if gate is not None and HookFilter is not None:
                try:
                    # Java AtomicBoolean is mutable; MVEL never calls Python
                    # to read the enabled/section switches.
                    unhook = self.hook_method(
                        member, after=hook.after_hooked_method,
                        after_filters=[HookFilter.Condition(
                            "object.get() && param.thisObject != null", object=gate)],
                    )
                except (TypeError, AttributeError):
                    pass  # Older SDK: fall back to the class-based hook.
                except Exception as exc:
                    self._report("Filtered hook registration failed", exc)
            if not unhook:
                try:
                    unhook = self.hook_method(member, hook)
                except Exception as exc:
                    self._report("Hook registration failed", exc)
            if unhook:
                unhooks.append(unhook)
        self._unhooks.extend(unhooks)
        return unhooks

    def _report(self, message, exc):
        try:
            self.log("Auto Marquee: %s: %s" % (message, exc))
        except Exception:
            pass

    def _hook_constructors(self, clazz: Any, hook: Any) -> List[Any]:
        return self._hook_members(_collect_constructors(clazz), hook)

    def _hook_methods(self, clazz: Any, method_name: str, hook: Any) -> List[Any]:
        return self._hook_members(_collect_methods(clazz, method_name), hook)

    def on_plugin_load(self):
        global _LAST_LANG
        self._active = True
        self._registry = _ViewRegistry()
        self._gates = {}
        if AtomicBoolean is not None and HookFilter is not None:
            for section in ("chat_header", "action_bar", "profile_name", "settings_cells"):
                self._gates[section] = AtomicBoolean(self._section_enabled(section))
        self._unhooks = []
        _CAPABILITY_CACHE.clear()

        try:
            _LAST_LANG = _get_lang()
        except Exception:
            _LAST_LANG = None

        try:
            clazz = _find_hook_class(CHAT_AVATAR_CONTAINER)
            if clazz:
                self._hook_constructors(clazz, _ChatAvatarContainerHook(self))
        except Exception:
            pass

        try:
            clazz = _find_hook_class(ACTION_BAR)
            if clazz:
                self._hook_methods(clazz, "setTitle", _ActionBarTitleHook(self))
        except Exception:
            pass

        try:
            clazz = _find_hook_class(PROFILE_ACTIVITY)
            if clazz:
                profile_hook = _ProfileNameHook(self)
                for method_name in ("updateProfileData", "createView"):
                    self._hook_methods(clazz, method_name, profile_hook)
        except Exception:
            pass

        cell_hook = _SettingsCellHook(self)
        for class_name in SETTINGS_CELL_CLASSES:
            try:
                clazz = _find_hook_class(class_name)
                if clazz:
                    self._hook_constructors(clazz, cell_hook)
            except Exception:
                pass

        try:
            clazz = _locale_controller()
            if clazz:
                lang_hook = _LanguageChangeHook(self)
                for method_name in ("applyLanguage", "recreateFormatters"):
                    self._hook_methods(clazz, method_name, lang_hook)
        except Exception:
            pass

    def on_plugin_unload(self):
        self._active = False
        self._sync_gates()
        # Do not rely solely on the SDK's later automatic teardown.
        for unhook in list(getattr(self, "_unhooks", ())):
            try:
                self.unhook_method(unhook)
            except Exception as exc:
                self._report("Explicit unhook failed (SDK cleanup still applies)", exc)
        self._unhooks.clear()
        self._gates.clear()
        registry = getattr(self, "_registry", None)
        self._refresh_views(unloading=True)
        # The queued restoration owns only this old weak registry, not self.
        # Replace it so callbacks cannot re-use the unloaded generation.
        if self._registry is registry:
            self._registry = _ViewRegistry()
        _CAPABILITY_CACHE.clear()

    def _refresh_views(self, unloading=False):
        registry = getattr(self, "_registry", None)
        if registry is None:
            return
        plugin_ref = weakref.ref(self)

        def update():
            plugin = plugin_ref()
            if unloading:
                registry.refresh(unloading=True)
            elif (plugin is not None and getattr(plugin, "_active", False)
                  and getattr(plugin, "_registry", None) is registry):
                registry.refresh(plugin)

        try:
            if run_on_ui_thread is not None:
                run_on_ui_thread(update)
            else:
                update()
        except Exception as exc:
            if unloading:
                # Scheduling failure must not leave stale registry metadata.
                # No unsafe off-thread writes to Android views here.
                registry.entries.clear()
                registry.reference_keys.clear()
            self._report("View refresh failed", exc)

    def _refresh_language(self):
        global _LAST_LANG
        if not getattr(self, "_active", False):
            return
        try:
            lang = _get_lang()
        except Exception:
            return
        if lang == _LAST_LANG:
            return
        _LAST_LANG = lang

        plugin_ref = weakref.ref(self)
        generation = self._registry

        def do_reload():
            plugin = plugin_ref()
            if (plugin is None or not getattr(plugin, "_active", False)
                    or getattr(plugin, "_registry", None) is not generation):
                return
            for name in ("reload_settings", "reloadSettings"):
                fn = getattr(plugin, name, None)
                if callable(fn):
                    try:
                        fn()
                        return
                    except Exception:
                        pass
            try:
                tick = int(plugin.get_setting("lang_tick", 0) or 0) + 1
            except Exception:
                tick = 1
            try:
                plugin.set_setting("lang_tick", tick, reload_settings=True)
            except Exception:
                pass

        try:
            if run_on_ui_thread is not None:
                run_on_ui_thread(do_reload)
            else:
                do_reload()
        except Exception:
            pass

    def _on_master_switch(self, enabled: bool):
        self.set_setting("enabled", bool(enabled), reload_settings=True)
        self._sync_gates()
        self._refresh_views()

    def _on_section_switch(self, section, enabled):
        self.set_setting(section, bool(enabled), reload_settings=False)
        self._sync_gates()
        self._refresh_views()

    def create_settings(self) -> List[Any]:
        global _LAST_LANG
        lang = _get_lang()
        _LAST_LANG = lang

        def tr(key):
            return STRINGS.get(lang, STRINGS['en']).get(key, key)

        self._sync_gates()
        items = [
            Header(text=tr('header_main')),
            Switch(
                key="enabled",
                text=tr('enabled_title'),
                subtext=tr('enabled_sub'),
                default=True,
                on_change=_weak_setting_callback(self, "_on_master_switch"),
            ),
        ]
        if not self.get_setting("enabled", True):
            return items + [Divider(), Text(text=tr('note'))]
        items.extend([
            Divider(),
            Header(text=tr('header_where')),
            Switch(
                key="chat_header",
                on_change=_weak_setting_callback(self, "_on_section_switch", "chat_header"),
                text=tr('chat_header_title'),
                subtext=tr('chat_header_sub'),
                default=True,
            ),
            Switch(
                key="profile_name",
                on_change=_weak_setting_callback(self, "_on_section_switch", "profile_name"),
                text=tr('profile_name_title'),
                subtext=tr('profile_name_sub'),
                default=True,
            ),
            Switch(
                key="action_bar",
                on_change=_weak_setting_callback(self, "_on_section_switch", "action_bar"),
                text=tr('action_bar_title'),
                subtext=tr('action_bar_sub'),
                default=True,
            ),
            Switch(
                key="settings_cells",
                on_change=_weak_setting_callback(self, "_on_section_switch", "settings_cells"),
                text=tr('settings_cells_title'),
                subtext=tr('settings_cells_sub'),
                default=True,
            ),
            Divider(),
            Text(
                text=tr('note'),
            ),
        ])
        return items


def create_plugin():
    return AutoMarqueePlugin()
