__id__ = "nfl"
__name__ = "NoForwardLimit"
__description__ = (
    "Полностью удаляет лимит в чате и профиле\n"
    "Completely removes the chat and profile limit\n\n"
    "FORK: **[NoForwardLimit](https://t.me/zwyPlugins/53)** by @zwylair • @zwyPlugins"
)
__author__ = "@ka1Plugins"
__version__ = "1.0"
__icon__ = "ka1Plugins/3"
__app_version__ = ">=12.10.6"
__sdk_version__ = ">=1.4.5.7"

from base_plugin import BasePlugin, MethodHook
from hook_utils import find_class, get_private_field, set_private_field
from java.lang import Boolean
from android.view import View
from org.telegram.messenger import MessageObject
from org.telegram.ui.Components import RecyclerListView
from java import dynamic_proxy

class MyMultiSelectionChanged(dynamic_proxy(RecyclerListView.onMultiSelectionChanged)):
    def __init__(self, original):
        self.original = original

    def onSelectionChanged(self, position, selected, x, y):
        self.original.onSelectionChanged(position, selected, x, y)

    def canSelect(self, position):
        return self.original.canSelect(position)

    def checkPosition(self, position, selectionTop):
        return self.original.checkPosition(position, selectionTop)

    def limitReached(self):
        return False

class ChatAddToSelectedHook(MethodHook):
    def __init__(self):
        self.saved_items0 = None
        self.saved_items1 = None
        self.depth = 0

    def before_hooked_method(self, param):
        try:
            layout = param.thisObject
            msg = param.args[0]
            if not msg: return
            
            did = get_private_field(layout, "dialog_id")
            idx = 0 if msg.getDialogId() == did else 1
            
            sel = get_private_field(layout, "selectedMessagesIds")
            if not sel: return
            
            if sel[idx].indexOfKey(msg.getId()) < 0:
                total = sel[0].size() + sel[1].size()
                if total >= 100 or self.depth > 0:
                    if self.depth == 0:
                        self.saved_items0 = sel[0].clone()
                        self.saved_items1 = sel[1].clone()
                        sel[0].clear()
                        sel[1].clear()
                    self.depth += 1
        except Exception: pass

    def after_hooked_method(self, param):
        if self.depth > 0:
            self.depth -= 1
            if self.depth == 0:
                try:
                    layout = param.thisObject
                    sel = get_private_field(layout, "selectedMessagesIds")
                    if sel:
                        for i in range(self.saved_items0.size()):
                            sel[0].put(self.saved_items0.keyAt(i), self.saved_items0.valueAt(i))
                        for i in range(self.saved_items1.size()):
                            sel[1].put(self.saved_items1.keyAt(i), self.saved_items1.valueAt(i))
                            
                        total = sel[0].size() + sel[1].size()
                        can_edit = 0
                        if total == 1:
                            msg = sel[0].valueAt(0) if sel[0].size() == 1 else sel[1].valueAt(0)
                            if msg.isOut() and not msg.isScheduled():
                                can_edit = 1
                        set_private_field(layout, "canEditMessagesCount", can_edit)
                        
                        edit_item = get_private_field(layout, "editItem")
                        if edit_item:
                            edit_item.setVisibility(View.VISIBLE if can_edit else View.GONE)
                except Exception: pass
                finally:
                    self.saved_items0 = None
                    self.saved_items1 = None

class UpdateActionModeTitleHook(MethodHook):
    def after_hooked_method(self, param):
        try:
            layout = param.thisObject
            sel = get_private_field(layout, "selectedMessagesIds")
            if sel:
                total = sel[0].size() + sel[1].size()
                can_edit = 0
                if total == 1:
                    msg = sel[0].valueAt(0) if sel[0].size() == 1 else sel[1].valueAt(0)
                    if msg.isOut() and not msg.isScheduled():
                        can_edit = 1
                edit_item = get_private_field(layout, "editItem")
                if edit_item:
                    edit_item.setVisibility(View.VISIBLE if can_edit else View.GONE)
        except Exception: pass

class RecyclerListViewStartMultiselectHook(MethodHook):
    def before_hooked_method(self, param):
        try:
            listener = param.args[2]
            if listener:
                param.args[2] = MyMultiSelectionChanged(listener)
        except Exception: pass

class ClickHook(MethodHook):
    def before_hooked_method(self, param):
        layout = param.thisObject
        if not get_private_field(layout, "isActionModeShowed"): return
        
        message = param.args[2]
        view = param.args[1]
        a = param.args[3]
        
        if message is None: return
        
        selectedMode = param.args[4]
        tab = layout.getClosestTab()
        if selectedMode == 8 and not layout.canEditStories(): return
        
        did = get_private_field(layout, "dialog_id")
        sel = get_private_field(layout, "selectedFiles")
        loadIndex = 0 if message.getDialogId() == did else 1
        
        cant_del = get_private_field(layout, "cantDeleteMessagesCount")
        
        if sel[loadIndex].indexOfKey(message.getId()) >= 0:
            sel[loadIndex].remove(message.getId())
            if not message.canDeleteMessage(False, None):
                cant_del -= 1
        else:
            sel[loadIndex].put(message.getId(), message)
            if not message.canDeleteMessage(False, None):
                cant_del += 1
                
        set_private_field(layout, "cantDeleteMessagesCount", cant_del)
        
        layout.onActionModeSelectedUpdate(sel[0])
        
        count_view = get_private_field(layout, "selectedMessagesCountTextView")
        del_item = get_private_field(layout, "deleteItem")
        goto_item = get_private_field(layout, "gotoItem")
        fwd_item = get_private_field(layout, "forwardItem")
        
        if sel[0].size() == 0 and sel[1].size() == 0:
            layout.showActionMode(False)
        else:
            if count_view: count_view.setNumber(sel[0].size() + sel[1].size(), True)
            if del_item: del_item.setVisibility(View.VISIBLE if cant_del == 0 else View.GONE)
            
            is_spec = tab in (8, 13, 14)
            
            if goto_item:
                goto_item.setVisibility(View.VISIBLE if (not is_spec and sel[0].size() == 1) else View.GONE)
            if fwd_item:
                fwd_item.setVisibility(View.GONE if is_spec else View.VISIBLE)
                
            try: layout.updateStoriesPinButton()
            except Exception: pass
            
        set_private_field(layout, "scrolling", False)
        
        name = view.getClass().getName()
        is_checked = sel[loadIndex].indexOfKey(message.getId()) >= 0
        if "SharedDocumentCell" in name:
            view.setChecked(is_checked, True)
        elif "SharedPhotoVideoCell2" in name:
            view.setChecked(is_checked, True)
        elif "SharedPhotoVideoCell" in name:
            view.setChecked(a, is_checked, True)
        elif "SharedLinkCell" in name or "SharedAudioCell" in name or "ContextLinkCell" in name:
            view.setChecked(is_checked, True)
            
        try:
            m = layout.getClass().getDeclaredMethod("updateForwardItem")
            m.setAccessible(True)
            m.invoke(layout)
        except Exception:
            pass
            
        param.setResult(None)

class NoForwardLimitPlugin(BasePlugin):
    def on_plugin_load(self):
        try:
            if clazz := find_class("org.telegram.ui.Components.SharedMediaLayout").getClass():
                for m in clazz.getDeclaredMethods():
                    if m.getName() == "onItemClick" and len(m.getParameterTypes()) == 5:
                        m.setAccessible(True)
                        self.hook_method(m, ClickHook())
                        break
                        
            if chat_clazz := find_class("org.telegram.ui.ChatActivity").getClass():
                try:
                    m2 = chat_clazz.getDeclaredMethod("addToSelectedMessages", MessageObject, Boolean.TYPE)
                    m2.setAccessible(True)
                    self.hook_method(m2, ChatAddToSelectedHook())
                except Exception:
                    pass
                    
                try:
                    m3 = chat_clazz.getDeclaredMethod("updateActionModeTitle")
                    m3.setAccessible(True)
                    self.hook_method(m3, UpdateActionModeTitleHook())
                except Exception:
                    pass
                
            if rlv_clazz := find_class("org.telegram.ui.Components.RecyclerListView").getClass():
                for m4 in rlv_clazz.getDeclaredMethods():
                    if m4.getName() == "startMultiselect":
                        m4.setAccessible(True)
                        self.hook_method(m4, RecyclerListViewStartMultiselectHook())
                        break
        except Exception: pass

    def on_plugin_unload(self):
        pass