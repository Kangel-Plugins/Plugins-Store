    def __init__(self, handler):
        super().__init__()
        self.handler = handler

    def run(self):
        try:
            self.handler()
        except Exception:
            pass


def is_track_path(path):
    if path is None:
        return False
    try:
        s = str(path).lower()
    except Exception:
        return False
    if s.startswith("audio/") or s.startswith("video/ogg"):
        return True
    if s.endswith((".mp3", ".m4a", ".aac", ".ogg", ".opus", ".wav", ".flac", ".amr", ".oga", ".wma")):
        return True
    return False


def media_kind(path):
    if is_track_path(path):
        return "audio"
    if is_video_path(path):
        return "video"
    if path and str(path).lower().endswith((".mp3", ".m4a", ".aac", ".ogg", ".opus", ".wav", ".flac", ".amr")):
        return "audio"
    return None


def safe_kind(value):
    try:
        return media_kind(str(value))
    except Exception:
        return None


def path_from_entry(entry):
    if entry is None:
        return None
    try:
        if safe_kind(entry):
            return str(entry)
    except Exception:
        pass
    try:
        raw = get_field(entry, "path")
    except Exception:
        raw = None
    if raw is not None and safe_kind(raw):
        return str(raw)
    try:
        owner = get_field(entry, "messageOwner")
    except Exception:
        owner = None
    if owner is not None:
        try:
            raw = get_field(owner, "attachPath")
        except Exception:
            raw = None
        if raw is not None and safe_kind(raw):
            return str(raw)
        try:
            media = get_field(owner, "media")
            doc = get_field(media, "document") if media is not None else None
            if doc is not None:
                mime = str(getattr(doc, "mime_type", "") or "").lower()
                fl = resolve_class("org.telegram.messenger.FileLoader")
                fpath = None
                if fl is not None:
                    fpath = audio_document_path(doc)
                is_audio = mime.startswith("audio/")
                if not is_audio:
                    try:
                        from org.telegram.messenger import FileLoader as _FL
                        fname = str(_FL.getDocumentFileName(doc) or "")
                    except Exception:
                        fname = ""
                    is_audio = fname.lower().endswith((".mp3", ".m4a", ".aac", ".ogg", ".opus", ".wav", ".flac", ".amr"))
                if is_audio and fpath:
                    return fpath
        except Exception:
            pass
    try:
        for f in _cached_fields(entry.getClass()):
            try:
                v = f.get(entry)
            except Exception:
                continue
            if v is None:
                continue
            if safe_kind(v):
                return str(v)
            inner = get_field(v, "path")
            if inner is not None and safe_kind(inner):
                return str(inner)
    except Exception:
        pass
    return None

def make_temporary_audio_copy(source):
    import shutil
    import tempfile

    base = str(context().getExternalFilesDir(None).getAbsolutePath())
    folder = os.path.join(base, "Circlet", "temporary")
    os.makedirs(folder, exist_ok=True)

    suffix = os.path.splitext(source)[1] or ".audio"
    fd, destination = tempfile.mkstemp(prefix="source_", suffix=suffix, dir=folder)
    os.close(fd)

    try:
        shutil.copyfile(source, destination)
        return destination
    except Exception:
        try:
            os.remove(destination)
        except Exception:
            pass
        raise


def remove_temporary_audio(path):
    if not path:
        slog("temporary audio cleanup: path not set")
        return

    try:
        ctx = context()
        base = os.path.realpath(
            os.path.join(
                str(ctx.getExternalFilesDir(None).getAbsolutePath()),
                "Circlet",
                "temporary",
            )
        )
        target = os.path.realpath(str(path))

        if os.path.dirname(target) != base:
            slog(f"temporary audio cleanup: refused {target}")
            return

        if os.path.isfile(target):
            os.remove(target)
            slog(f"temporary audio removed: {target}")
        else:
            slog(f"temporary audio cleanup: already absent {target}")
    except Exception as e:
        slog(f"temporary audio cleanup failed: {e}")

def audio_document_path(doc):
    if doc is None:
        return None

    try:
        from org.telegram.messenger import FileLoader as FL

        cls = resolve_class("org.telegram.messenger.FileLoader")
        if cls is None:
            return None

        instance = FL.getInstance(int(UserConfig.selectedAccount))

        for count in (1, 2):
            for method in array_items(cls.getMethods()):
                if str(method.getName()) != "getPathToAttach":
                    continue

                types = array_items(method.getParameterTypes())
                if len(types) != count:
                    continue
                if str(types[0].getName()) != "org.telegram.tgnet.TLObject":
                    continue
                if count == 2 and str(types[1].getName()) != "boolean":
                    continue

                target = None if int(method.getModifiers()) & 8 else instance
                args = [doc] if count == 1 else [doc, JBoolean(False)]

                try:
                    result = method.invoke(target, args)
                    if result is not None:
                        path = str(result.getAbsolutePath())
                        return path
                except Exception as e:
                    slog(f"getPathToAttach invoke failed: {e}")

    except Exception as e:
        slog(f"audio_document_path failed: {e}")

    return None

def selected_attachment_message(alert):
    if alert is None:
        return None
    for layout_name, mname in (("audioLayout", "getSelected"), ("documentLayout", "getSelectedFiles"), ("photoLayout", "getSelectedPhotos")):
        try:
            layout = get_field(alert, layout_name)
            if layout is None:
                continue
            m = find_method(layout.getClass(), mname, 0)
            if m is None:
                continue
            sel = m.invoke(layout, None)
            if sel is None:
                continue
            try:
                if int(sel.size()) != 1:
                    continue
                item = sel.get(0)
                if item is not None:
                    return item
            except Exception:
                continue
        except Exception:
            continue
    return None


def ensure_local_file(plugin, path, on_ready, on_fail):
    if path and os.path.exists(path):
        on_ready(path)
        return
    alert = attach_alert_from_fragment()
    mo = selected_attachment_message(alert)
    doc = None
    if mo is not None:
        owner = get_field(mo, "messageOwner")
        media = get_field(owner, "media") if owner is not None else None
        doc = get_field(media, "document") if media is not None else None
    if doc is None:
        on_fail()
        return
    from org.telegram.messenger import FileLoader as FL
    fl = resolve_class("org.telegram.messenger.FileLoader")
    if fl is None:
        on_fail()
        return
    inst = FL.getInstance(int(UserConfig.selectedAccount))
    best = None
    for m in inst.getClass().getMethods():
        if m.getName() != "loadFile":
            continue
        types = [p.getName() for p in m.getParameterTypes()]
        if types and types[0] == "org.telegram.tgnet.TLRPC$Document":
            if best is None or len(types) < len([p.getName() for p in best.getParameterTypes()]):
                best = m
    if best is None:
        on_fail()
        return
    types = [p.getName() for p in best.getParameterTypes()]
    args = [doc]
    for t in types[1:]:
        if t == "boolean":
            args.append(JBoolean(False))
        elif t == "int":
            args.append(JInteger(1))
        elif t == "long":
            args.append(JLong(0))
        else:
            args.append(None)
    try:
        best.invoke(inst, args)
    except Exception as e:
        slog(f"loadFile fail: {e}")
        on_fail()
        return
    toast(localized("Загружаю трек…", "Downloading track…"))

    def poll(tries):
        p = str(getattr(FileLoader.getPathToAttach(doc), "getAbsolutePath", lambda: "")()) 
        p = audio_document_path(doc)
        if p and os.path.exists(p) and os.path.getsize(p) > 0:
            toast(localized("Трек загружен", "Track downloaded"))
            on_ready(p)
            return
        if tries > 240:
            toast(localized("Не удалось загрузить трек", "Could not download the track"))
            on_fail()
            return
        run_on_ui_thread(lambda: poll(tries + 1), 500)

    run_on_ui_thread(lambda: poll(0), 700)


def _hier_fields(obj, max_depth=4):
    out = []
    try:
        cls = obj.getClass()
    except Exception:
        return out
    depth = 0
    while cls is not None and depth < max_depth:
        try:
            fs = array_items(cls.getDeclaredFields())
        except Exception:
            fs = []
        for f in fs or []:
            try:
                f.setAccessible(True)
                out.append((str(f.getName()), f.get(obj)))
            except Exception:
                continue
        try:
            cls = cls.getSuperclass()
        except Exception:
            break
        depth += 1
    return out


def _audio_doc_from_entry(entry):
    if entry is None:
        return None
    media = get_field(entry, "media")
    if media is not None:
        doc = get_field(media, "document")
        if doc is not None:
            return doc
    mo = get_field(entry, "messageObject") or get_field(entry, "message") or get_field(entry, "messageOwner")
    if mo is not None:
        media = get_field(mo, "media")
        if media is None:
            owner = get_field(mo, "messageOwner")
            media = get_field(owner, "media") if owner is not None else None
        doc = get_field(media, "document") if media is not None else None
        if doc is not None:
            return doc
    doc = get_field(entry, "document")
    if doc is not None:
        return doc
    try:
        mime = str(getattr(entry, "mime_type", "") or "").lower()
        if mime.startswith("audio/"):
            return entry
    except Exception:
        pass
    return None


def deep_selected_audio(alert, deadline=None):
    if alert is None:
        return None
    pairs = _hier_fields(alert, 4)
    for nm, v in pairs:
        try:
            if deadline and time.time() > deadline:
                return None
            if v is None or "ArrayList" not in str(v.getClass().getName()):
                continue
            if int(v.size()) != 1:
                continue
            item = v.get(0)
        except Exception:
            continue
        p = path_from_entry(item)
        if p and media_kind(p) == "audio":
            return p
    for nm, v in pairs:
        try:
            if deadline and time.time() > deadline:
                return None
            if v is None:
                continue
            cn = str(v.getClass().getName())
        except Exception:
            continue
        if "ArrayList" in cn or cn.startswith("java.") or cn.startswith("android."):
            continue
        pairs2 = _hier_fields(v, 1)
        for nm2, v2 in pairs2:
            try:
                if v2 is None or "ArrayList" not in str(v2.getClass().getName()):
                    continue
                if int(v2.size()) != 1:
                    continue
                item2 = v2.get(0)
            except Exception:
                continue
            p2 = path_from_entry(item2)
            if p2 and media_kind(p2) == "audio":
                return p2
    return None


def _build_waveform(bars):
    try:
        if not bars:
            return None
        n = len(bars)
        take = 126
        vals = []
        for k in range(take):
            v = bars[min(n - 1, int(k * (n - 1) / float(max(1, take - 1))))]
            iv = int(round(float(v) * 15.0))
            if iv < 0:
                iv = 0
            if iv > 15:
                iv = 15
            vals.append(iv)
        data = bytearray()
        for k in range(0, take, 2):
            hi = vals[k]
            lo = vals[k + 1] if k + 1 < take else 0
            data.append((hi << 4) | lo)
        while len(data) < 63:
            data.append(0)
        return bytes(data[:63])
    except Exception:
        return None


def music_row_path(view):
    if view is None:
        return None
    mo = None
    for name in ("messageObject", "currentMessageObject", "message"):
        try:
            mo = get_field(view, name)
        except Exception:
            mo = None
        if mo is not None:
            break
    if mo is None:
        return None
    owner = get_field(mo, "messageOwner")
    media = get_field(owner, "media") if owner is not None else None
    doc = get_field(media, "document") if media is not None else None
    if doc is None:
        return None
    mime = str(getattr(doc, "mime_type", "") or "").lower()
    try:
        from org.telegram.messenger import FileLoader as _FL
        fname = str(_FL.getDocumentFileName(doc) or "")
    except Exception:
        fname = ""
    if not (mime.startswith("audio/") or fname.lower().endswith((".mp3", ".m4a", ".aac", ".ogg", ".opus", ".wav", ".flac", ".amr"))):
        return None
    return mo, path_from_entry(mo)


def selected_attachment_path(alert):
    if alert is None:
        return None
    for layout_name, mname in (("audioLayout", "getSelected"), ("documentLayout", "getSelectedFiles"), ("photoLayout", "getSelectedPhotos")):
        try:
            layout = get_field(alert, layout_name)
            if layout is None:
                continue
            m = find_method(layout.getClass(), mname, 0)
            if m is None:
                continue
            sel = m.invoke(layout, None)
            if sel is None:
                continue
            try:
                if int(sel.size()) != 1:
                    continue
            except Exception:
                continue
            item = sel.get(0)
            if layout_name == "audioLayout":
                doc = _audio_doc_from_entry(item)
                if doc is not None:
                    found = audio_document_path(doc)
                    slog(f"selected audio doc path={found}")
                    if found:
                        ARMED["doc"] = doc
                        ARMED["mo"] = item
                        return found
            found = path_from_entry(item)
            if found:
                return found
        except Exception:
            continue
    for name in ("selectedAudios", "selectedDocs", "selectedMusic", "selectedFiles", "selectedPhotos", "selectedDocuments"):
        try:
            sel = get_field(alert, name)
            if sel is None:
                continue
            try:
                if int(sel.size()) != 1:
                    continue
            except Exception:
                continue
            item = sel.get(0)
            found = path_from_entry(item)
            if found:
                return found
        except Exception:
            continue
    return None


def menu_caption(path, once=False):
    if media_kind(path) == "audio":
        return localized("Отправить одноразовым ГС", "Send as one-time voice") if once else localized("Отправить как ГС", "Send as voice message")
    return localized("Отправить с одним просмотром", "Send with one view") if once else localized("Отправить кружком", "Send as video message")


def resolve_send_path():
    path = photoviewer_path()
    if path:
        return path
    alert = attach_alert_from_fragment()
    if alert is not None:
        path = selected_video_path(alert) or selected_attachment_path(alert)
        if path:
            return path
        try:
            holder0 = get_surrounding(alert) or alert
        except Exception:
            holder0 = alert
        if holder0 is not None and holder0 is not alert:
            path = selected_video_path(holder0)
            if path:
                return path
            path = selected_attachment_path(holder0)
            if path:
                return path
    path = selected_attachment_path(alert)
    if path:
        return path
    if not sender_visible():
        return None
    alert = attach_alert_from_fragment()
    if alert is not None:
        path = selected_video_path(alert)
        if path:
            return path
    path = photoviewer_path()
    if path:
        return path
    probe_alert = attach_alert_from_fragment()
    if probe_alert is not None:
        try:
            holder = get_surrounding(probe_alert) or probe_alert
        except Exception:
            holder = probe_alert
        if holder is not None and holder is not alert:
            path = selected_video_path(holder)
            if path:
                return path
            path = selected_attachment_path(holder)
            if path:
                return path
    frag = get_last_fragment()
    if frag is not None:
        for name in ("chatAttachAlert", "chatActivityAttachAlert"):
            holder = get_field(frag, name)
            if holder is None:
                continue
            path = selected_video_path(holder)
            if path:
                return path
    if ARMED["active"]:
        path = ARMED["path"]
        if path:
            return path
    return None


def resolve_live_media_path():
    alert = attach_alert_from_fragment()
    if alert is not None:
        try:
            path = selected_attachment_path(alert)
            if path:
                return path
            path = selected_video_path(alert)
            if path:
                return path
        except Exception as e:
            boot_log("LIVE resolve fail %s" % e)
    path = photoviewer_path()
    if path:
        return path
    return None


_SEND_WATCH = {"ts": 0.0}
_VOICE_ONCE_PATHS = {}
_VOICE_ONCE_LOCK = threading.Lock()
_VOICE_DIAG = {"until": 0.0}


def _rpc_diag_object(obj):
    if obj is None:
        return "None"

    try:
        name = str(obj.getClass().getSimpleName())
    except Exception:
        name = "?"

    parts = [name]
    for field in ("flags", "ttl_seconds", "ttl", "voice", "round_message"):
        value = get_field(obj, field)
        if value is not None:
            try:
                parts.append(f"{field}={value}")
            except Exception:
                pass
    return " ".join(parts)


class SendPipelineHook(MethodHook):
    def __init__(self, tag, plugin=None):
        super().__init__()
        self.tag = tag
        self.plugin = plugin

    @staticmethod
    def _mark(arg):
        try:
            if arg is None:
                return None
            doc = None
            try:
                owner = get_field(arg, "messageOwner")
                media = get_field(owner, "media") if owner is not None else None
                doc = get_field(media, "document") if media is not None else None
            except Exception:
                doc = None
            if doc is None:
                try:
                    doc = get_field(arg, "document")
                except Exception:
                    doc = None
            if doc is not None:
                lp = get_field(doc, "localPath")
                if lp and "circlet_" in str(lp):
                    return "circlet-voice"
            return None
        except Exception:
            return None

    def before_hooked_method(self, param):
        if self.tag != "sendMessage":
            return

        try:
            args = param.args or []
            if not args or args[0] is None:
                return

            obj = args[0]
            if self.plugin is not None:
                for status in list(self.plugin._round_uploads):
                    if status.active:
                        status.bind(obj)
            if "SendMessageParams" not in str(obj.getClass().getName()):
                return

            path = get_field(obj, "path")
            if path is None:
                return

            path = str(path)

            with _VOICE_ONCE_LOCK:
                deadline = _VOICE_ONCE_PATHS.get(path)
                if deadline is None:
                    return

                if time.time() > deadline:
                    _VOICE_ONCE_PATHS.pop(path, None)
                    slog("voice once: matching params expired")
                    return

                written = set_typed_field(obj, "ttl", ONCE_TTL)
                if written is None or int(written) != ONCE_TTL:
                    slog("voice once: could not set SendMessageParams.ttl")
                    return

                _VOICE_ONCE_PATHS.pop(path, None)

            slog("voice once: SendMessageParams.ttl applied to " + os.path.basename(path))
        except Exception as e:
            slog(f"voice once: params hook failed: {type(e).__name__}: {e}")

    def after_hooked_method(self, param):
        try:
            for a in (param.args or []):
                d = self._mark(a)
                if d:
                    extra = ""
                    try:
                        got_doc = get_field(a, "document")
                        got_msg = get_field(a, "message")
                        extra = f" doc_after={got_doc is not None} msg_len={len(str(got_msg or ''))}"
                    except Exception:
                        pass
                    slog(f"PIPE {self.tag}: {d}{extra}")
                    return
        except Exception:
            pass


class ItemOptionsHook(MethodHook):
    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin

    def before_hooked_method(self, param):
        try:
            opts = param.thisObject
            if opts is None:
                return
            t0 = time.time()
            key = JSystem.identityHashCode(opts)
            if key in _INJECTED_OPTIONS:
                return
            if not sender_visible():
                return
            path = ARMED["path"] if ARMED["active"] else None
            if not path:
                path = resolve_live_media_path()
            if not path or not media_kind(path):
                return
            add = None
            for count in (3, 4, 5):
                cand = find_method(opts.getClass(), "add", count)
                if cand is None:
                    continue
                types = [p.getName() for p in array_items(cand.getParameterTypes())]
                if count == 3 and types[0] == "int" and types[1] in ("java.lang.CharSequence", "java.lang.String") and types[2] == "java.lang.Runnable":
                    add = cand
                    break
            if add is None:
                return
            _INJECTED_OPTIONS.add(key)
            if len(_INJECTED_OPTIONS) > 64:
                _INJECTED_OPTIONS.clear()
            for once in (False, True):
                runnable = ClickRunnable(lambda p=path, o=once: self.plugin.open_from_send_ui(p, o))
                self.plugin.keep(runnable)
                add.invoke(opts, [JInteger(menu_icon(path)), JString(menu_caption(path, once)), runnable])
            prepare_circlet_options(opts)
            slog(f"IOPTS inject {media_kind(path)} in {int((time.time() - t0) * 1000)} ms")
        except Exception as e:
            boot_log("IOPTS fail %s: %s" % (type(e).__name__, e))


class SendPreviewHook(MethodHook):
    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            args = param.args
            if args is None or len(args) < 1 or args[0] is None:
                return
            options = args[0]

            HOSTS["preview"] = param.thisObject

            path = resolve_send_path()
            if not path:
                path = ARMED["path"] if ARMED["active"] else None
            doc = None
            try:
                mos = get_field(param.thisObject, "messageObjects")
                if mos is not None and int(mos.size()) >= 1:
                    mo = mos.get(int(mos.size()) - 1)
                    if not path:
                        path = path_from_entry(mo)
                    owner = get_field(mo, "messageOwner")
                    media = get_field(owner, "media") if owner is not None else None
                    doc = get_field(media, "document") if media is not None else None
            except Exception:
                doc = None
            if not path or not media_kind(path):
                return
            PREVIEW_STATE["path"] = path
            PREVIEW_STATE["doc"] = doc
            PREVIEW_STATE["ts"] = time.time()
            try:
                _INJECTED_OPTIONS.add(JSystem.identityHashCode(options))
            except Exception:
                pass

            add = None
            for count in (3, 4):
                add = find_method(options.getClass(), "add", count)
                if add is not None:
                    break
            if add is None:
                return

            for once in (False, True):
                runnable = ClickRunnable(lambda p=path, o=once: self.plugin.open_from_send_ui(p, o))
                self.plugin.keep(runnable)
                params = array_items(add.getParameterTypes())
                call = []
                for spec in params:
                    kind = spec.getName()
                    if kind == "int":
                        call.append(JInteger(menu_icon(path)))
                    elif kind == "java.lang.Runnable":
                        call.append(runnable)
                    elif kind == "boolean":
                        call.append(JBoolean(False))
                    else:
                        call.append(JString(menu_caption(path, once)))
                add.invoke(options, call)
                tint_last_icon(options)
            prepare_circlet_options(options)
        except Exception as e:
            boot_log("PREVIEW inject fail %s: %s" % (type(e).__name__, e))
            pass


def descendants(view, depth=0):
    out = [view]
    if depth > 6:
        return out
    try:
        count = int(view.getChildCount())
    except Exception:
        return out
    for i in range(count):
        try:
            out.extend(descendants(view.getChildAt(i), depth + 1))
        except Exception:
            continue
    return out


def tint_last_icon(options):
    items = get_field(options, "items")
    if items is not None:
        try:
            views = [v for v in array_items(items.toArray())
                     if v is not None and hasattr(v, "getChildCount")]
        except Exception:
            views = []
        if len(views) >= 2 and copy_icon_look(views[-1], views[-2]):
            return

    root = None
    for name in ("linearLayout", "layout", "lastLayout", "windowView"):
        candidate = get_field(options, name)
        if candidate is not None and hasattr(candidate, "getChildCount"):
            root = candidate
            break

    image_cls = resolve_class("android.widget.ImageView")
    images = []
    if root is not None and image_cls is not None:
        images = [v for v in descendants(root) if image_cls.isInstance(v)]
    if len(images) >= 2:
        try:
            flt = images[-2].getColorFilter()
            if flt is not None:
                images[-1].setColorFilter(flt)
                return
        except Exception:
            pass

    color = sibling_text_color(root) if root is not None else None
    if color is None and root is not None:
        color = sibling_icon_color(root)
    if color is None:
        color = theme_color("key_actionBarDefaultSubmenuItem", "key_dialogTextBlack")
    if color is None:
        color = Color.argb(255, 255, 255, 255)

    if images:
        try:
            images[-1].setColorFilter(PorterDuffColorFilter(color, PorterDuff.Mode.SRC_IN))
            return
        except Exception:
            pass

    sub_cls = resolve_class("org.telegram.ui.ActionBar.ActionBarMenuSubItem")
    if root is not None and sub_cls is not None:
        subs = [v for v in descendants(root) if sub_cls.isInstance(v)]
        if subs:
            method = find_method(subs[-1].getClass(), "setColors", 2)
            if method is not None:
                try:
                    method.invoke(subs[-1], [JInteger(color), JInteger(color)])
                except Exception:
                    pass


def listener_class(holder, field_name):
    view = get_field(holder, field_name)
    if view is None:
        return None
    for name in ("mOnLongClickListener", "onLongClickListener"):
        listener = get_field(view, name)
        if listener is None:
            info = get_field(view, "mListenerInfo")
            if info is not None:
                listener = get_field(info, "mOnLongClickListener")
        if listener is not None:
            try:
                return listener.getClass()
            except Exception:
                continue
    return None


def selected_video_path(alert):
    layout = photo_layout(alert)
    if layout is None:
        return None
    method = find_method(layout.getClass(), "getSelectedPhotos", 0)
    if method is None:
        return None
    try:
        selected = method.invoke(layout, None)
        if selected is None:
            return None
        if int(selected.size()) != 1:
            return None
        values = selected.values().toArray()
        for entry in array_items(values):
            raw = get_field(entry, "path")
            if not raw:
                continue
            candidate = str(raw)
            if candidate.lower().endswith((".mp4", ".mov", ".mkv", ".webm", ".3gp", ".avi")):
                return candidate
    except Exception:
        pass
    return None


def is_video_path(path):
    return bool(path) and str(path).lower().endswith((".mp4", ".mov", ".mkv", ".webm", ".3gp", ".avi"))


def photoviewer_path():
    cls = resolve_class(PHOTO_VIEWER)
    if cls is None:
        return None

    has = find_method(cls, "hasInstance", 0)
    if has is not None:
        try:
            if not bool(has.invoke(None, None)):
                return None
        except Exception:
            pass

    getter = find_method(cls, "getInstance", 0)
    if getter is None:
        return None
    try:
        viewer = getter.invoke(None, None)
    except Exception:
        return None
    if viewer is None:
        return None

    try:
        vis = get_field(viewer, "isVisible")
        if vis is not None and not bool(vis):
            return None
    except Exception:
        pass
    try:
        vm = find_method(viewer.getClass(), "isVisible", 0)
        if vm is not None and not bool(vm.invoke(viewer, None)):
            return None
    except Exception:
        pass

    raw = get_field(viewer, "currentPathObject")
    if is_video_path(raw):
        return str(raw)

    entries = get_field(viewer, "imagesArrLocals")
    index = get_field(viewer, "currentIndex")
    if entries is not None and index is not None:
        try:
            size = int(entries.size())
            pos = int(index)
            if 0 <= pos < size:
                candidate = get_field(entries.get(pos), "path")
                if is_video_path(candidate):
                    return str(candidate)
        except Exception:
            pass

    return None


class SendLongClickHook(MethodHook):
    def before_hooked_method(self, param):
        t0 = time.time()
        sur_ms = res_ms = pv_ms = 0
        try:
            ARMED["active"] = False
            ARMED["path"] = None
            ARMED["mo"] = None
            ARMED["doc"] = None
            path = photoviewer_path()
            alert = HOSTS.get("alert") or attach_alert_from_fragment()
            if not path and alert is not None:
                path = selected_video_path(alert) or selected_attachment_path(alert)
            if path and media_kind(path):
                ARMED["active"] = True
                ARMED["path"] = path
                if media_kind(path) == "audio":
                    _wave_prefetch(path)
                return
            if alert is not None:
                audio_layout = get_field(alert, "audioLayout")
                if audio_layout is not None:
                    selected = find_method(audio_layout.getClass(), "getSelected", 0)
                    if selected is not None:
                        items = selected.invoke(audio_layout, None)
                        if items is not None and int(items.size()) == 1:
                            item = items.get(0)
                            doc = _audio_doc_from_entry(item)
                            path = audio_document_path(doc)
                            if path:
                                ARMED["active"] = True
                                ARMED["path"] = path
                                ARMED["mo"] = item
                                ARMED["doc"] = doc
                                slog(f"selected audio armed: {path}")
            if ARMED["active"]:
                _wave_prefetch(ARMED["path"])
                return
            ts = time.time()
            holders = []
            if param.thisObject is not None:
                holders.append(param.thisObject)
                try:
                    holders.extend(get_surroundings(param.thisObject))
                except Exception:
                    pass
            holders.append(None)
            sur_ms = int((time.time() - ts) * 1000)
            ts = time.time()
            tried = set()
            for hi, holder in enumerate(holders):
                try:
                    path = None
                    if holder is not None:
                        key = JSystem.identityHashCode(holder)
                        if key in tried:
                            continue
                        tried.add(key)
                        path = selected_video_path(holder)
                        if not path:
                            path = selected_attachment_path(holder)
                        if not path:
                            row = music_row_path(holder)
                            if row is not None:
                                ARMED["mo"] = row[0]
                                path = row[1]
                                slog(f"music row armed: {path}")
                        if not path:
                            path = deep_selected_audio(holder)
                    if not path and hi == 0:
                        alert = HOSTS.get("alert") or attach_alert_from_fragment()
                        if alert is not None:
                            akey = JSystem.identityHashCode(alert)
                            if akey not in tried:
                                tried.add(akey)
                                path = selected_attachment_path(alert)
                    if path:
                        ARMED["active"] = True
                        ARMED["path"] = path
                        if media_kind(path) == "audio":
                            _wave_prefetch(path)
                        break
                except Exception:
                    continue
            if DEV_BUILD and not ARMED["active"]:
                t_diag = time.time()
                alert = HOSTS.get("alert") or attach_alert_from_fragment()
                try:
                    if alert is not None:
                        slog(f"longclick unresolved alert={alert.getClass().getName()} this={param.thisObject.getClass().getName() if param.thisObject is not None else None}")
                        dbg = []
                        for nm, v in _hier_fields(alert, 4):
                            try:
                                cn = str(v.getClass().getName())
                            except Exception:
                                continue
                            if "ArrayList" in cn:
                                try:
                                    dbg.append(nm + "[" + str(int(v.size())) + "]")
                                    if int(v.size()) == 1:
                                        dbg.append(nm + "=1:" + str(v.get(0).getClass().getName()))
                                except Exception:
                                    pass
                            elif not (cn.startswith("java.") or cn.startswith("android.") or cn.startswith("com.")):
                                try:
                                    dbg.append(nm + ":" + cn.split(".")[-1])
                                except Exception:
                                    pass
                        slog("ALERT " + " ".join(dbg[:40]))
                        cls_chain = []
                        c = alert.getClass()
                        for _ in range(6):
                            cls_chain.append(str(c.getName()))
                            c = c.getSuperclass()
                            if c is None:
                                break
                        slog("ALERTCLS " + " > ".join(cls_chain))
                        p2 = deep_selected_audio(alert, time.time() + 0.35)
                        if p2:
                            ARMED["active"] = True
                            ARMED["path"] = p2
                            _wave_prefetch(p2)
                            slog(f"alert deep armed: {p2}")
                except Exception:
                    pass
                try:
                    alay = get_field(alert, "audioLayout") or get_field(alert, "currentAttachLayout")
                    if alay is not None:
                        dbg3 = []
                        for nm3, v3 in _hier_fields(alay, 3):
                            try:
                                if v3 is None:
                                    continue
                                cn3 = str(v3.getClass().getName())
                            except Exception:
                                continue
                            if "ArrayList" in cn3:
                                try:
                                    dbg3.append(nm3 + "[" + str(int(v3.size())) + "]")
                                    if int(v3.size()) == 1:
                                        dbg3.append(nm3 + "=1:" + str(v3.get(0).getClass().getName()))
                                except Exception:
                                    pass
                        m_sel = find_method(alay.getClass(), "getSelected", 0)
                        if m_sel is not None:
                            try:
                                sel = m_sel.invoke(alay, None)
                                sz = int(sel.size()) if sel is not None else 0
                                dbg3.append("getSelected[" + str(sz) + "]")
                                if sz == 1 and not ARMED["active"]:
                                    item = sel.get(0)
                                    doc = _audio_doc_from_entry(item)
                                    fpath = None
                                    fname = ""
                                    if doc is not None:
                                        fpath = audio_document_path(doc)
                                        try:
                                            from org.telegram.messenger import FileLoader as _FL
                                            fname = str(_FL.getDocumentFileName(doc) or "")
                                        except Exception:
                                            fname = ""
                                    mime = str(getattr(doc, "mime_type", "") or "").lower() if doc is not None else ""
                                    if fpath and (mime.startswith("audio/") or fname.lower().endswith((".mp3", ".m4a", ".aac", ".ogg", ".opus", ".wav", ".flac", ".amr"))):
                                        ARMED["active"] = True
                                        ARMED["path"] = fpath
                                        ARMED["doc"] = doc
                                        if os.path.isfile(fpath):
                                            _wave_prefetch(fpath)
                                        slog(f"alay selected armed: {fpath}")
                                    else:
                                        dbg3.append("arm fail: doc=" + ("yes" if doc is not None else "no") + " mime=" + mime + " fname=" + fname)
                                        idbg = [str(item.getClass().getName())]
                                        try:
                                            for nm9, v9 in _hier_fields(item, 3):
                                                try:
                                                    if v9 is None:
                                                        continue
                                                    cn9 = str(v9.getClass().getName())
                                                    if "ArrayList" in cn9:
                                                        idbg.append(str(nm9) + "[" + str(int(v9.size())) + "]")
                                                    elif not (cn9.startswith("java.") or cn9.startswith("android.")):
                                                        idbg.append(str(nm9) + ":" + cn9.split(".")[-1])
                                                except Exception:
                                                    continue
                                        except Exception:
                                            pass
                                        slog("SELITEM " + " ".join(idbg[:30]))
                            except Exception:
                                dbg3.append("getSelected fail")
                        slog("ALAY " + alay.getClass().getName() + " " + " ".join(dbg3[:30]))
                        p4 = deep_selected_audio(alay)
                        if p4 and not ARMED["active"]:
                            ARMED["active"] = True
                            ARMED["path"] = p4
                            _wave_prefetch(p4)
                            slog(f"alay deep armed: {p4}")
                except Exception:
                    pass
                try:
                    if time.time() - t_diag > 0.2:
                        raise Exception("diag budget")
                    frag = get_last_fragment()
                    if frag is not None and not ARMED["active"]:
                        dbg2 = []
                        fl = None
                        try:
                            fl = array_items(frag.getClass().getDeclaredFields())
                        except Exception:
                            fl = None
                        for f in fl or []:
                            try:
                                f.setAccessible(True)
                                v = f.get(frag)
                            except Exception:
                                continue
                            if v is None:
                                continue
                            try:
                                cn = str(v.getClass().getName())
                            except Exception:
                                continue
                            nm = str(f.getName())
                            if "ArrayList" in cn:
                                try:
                                    dbg2.append(nm + "[" + str(int(v.size())) + "]")
                                    if int(v.size()) == 1:
                                        dbg2.append(nm + "=1:" + str(v.get(0).getClass().getName()))
                                except Exception:
                                    pass
                            elif not (cn.startswith("java.") or cn.startswith("android.") or cn.startswith("com.")):
                                try:
                                    dbg.append(nm + ":" + cn.split(".")[-1])
                                except Exception:
                                    pass
                                try:
                                    for f2 in array_items(v.getClass().getDeclaredFields()) or []:
                                        try:
                                            f2.setAccessible(True)
                                            v2 = f2.get(v)
                                        except Exception:
                                            continue
                                        if v2 is not None and "ArrayList" in str(v2.getClass().getName()):
                                            dbg2.append(nm + "." + str(f2.getName()) + "[" + str(int(v2.size())) + "]")
                                except Exception:
                                    pass
                        slog("FRAG " + frag.getClass().getName() + " " + " ".join(dbg2[:40]))
                        p3 = deep_selected_audio(frag)
                        if p3:
                            ARMED["active"] = True
                            ARMED["path"] = p3
                            _wave_prefetch(p3)
                            slog(f"frag deep armed: {p3}")
                except Exception as e:
                    slog(f"frag diag fail: {e}")
                try:
                    slog("HOLDERS " + " ".join(str(h.getClass().getName()) for h in holders if h is not None))
                except Exception:
                    pass
            res_ms = int((time.time() - ts) * 1000)
            ts = time.time()
            if not ARMED["active"]:
                pv = photoviewer_path()
                if pv:
                    ARMED["active"] = True
                    ARMED["path"] = pv

            pv_ms = int((time.time() - ts) * 1000)
        except Exception:
            pass
        finally:
            try:
                slog(f"LONGCLICK {int((time.time() - t0) * 1000)} ms (sur={sur_ms} res={res_ms} pv={pv_ms})")
            except Exception:
                pass


def get_surrounding(obj):
    outs = get_surroundings(obj)
    return outs[0] if outs else None


def get_surroundings(obj, depth=0):
    if obj is None:
        return []
    result = []
    cls = obj.getClass()
    try:
        fields = array_items(cls.getDeclaredFields())
    except Exception:
        fields = []
    for f in fields:
        try:
            name = f.getName()
            if not (name.startswith("this$") or name.startswith("f$") or name.startswith("arg$")):
                continue
            f.setAccessible(True)
            v = f.get(obj)
            if v is None:
                continue
            if name.startswith("this$"):
                if not any(v is x for x in result):
                    result.append(v)
            elif depth < 1:
                if any(v is x for x in result):
                    continue
                inner = get_surroundings(v, depth + 1)
                for item in inner:
                    if not any(item is x for x in result):
                        result.append(item)
        except Exception:
            continue
    return result


class PopupShowHook(MethodHook):
    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin

    def before_hooked_method(self, param):
        t0 = time.time()
        try:
            window = param.thisObject
            HOSTS["popup"] = window
            content = None
            for name in ("contentView", "mContentView"):
                content = get_field(window, name)
                if content is not None:
                    break
            if content is None:
                return

            tag = None
            try:
                tag = content.getTag()
            except Exception:
                pass
            if tag is not None and str(tag) == INJECT_TAG:
                return

            if not sender_visible():
                return
            probe_path = ARMED["path"] if ARMED["active"] else None
            if not probe_path:
                probe_path = resolve_send_path()
            if not probe_path or not media_kind(probe_path):
                return
            old_height = int(content.getMeasuredHeight())
            ctx = content.getContext()
            neighbour = sibling_text_color(content)
            icon = sibling_icon_color(content)
            if icon is None:
                icon = neighbour
            path = probe_path
            for once in (False, True):
                item = ActionBarMenuSubItem(ctx, False, False)
                item.setTextAndIcon(JString(menu_caption(path, once)), menu_icon(path))
                apply_submenu_colors(item, neighbour, icon)
                listener = OnClickListener(lambda *_, p=path, o=once: self.plugin.open_from_send_ui(p, o))
                self.plugin.keep(listener)
                item.setOnClickListener(listener)
                content.addView(item)
            try:
                content.setTag(JString(INJECT_TAG))
            except Exception:
                pass
            raise_circlet_popup(param, content, old_height)
            slog(f"POPUP inject {media_kind(path)} in {int((time.time() - t0) * 1000)} ms")
        except Exception as e:
            boot_log("POPUP inject fail %s: %s" % (type(e).__name__, e))
            pass


def _decode_wave_manual(path, bins, on_partial=None):
    from android.media import MediaCodec, MediaExtractor, MediaFormat
    ex = MediaExtractor()
    ex.setDataSource(path)
    track = -1
    tf = None
    mime = None
    for i in range(ex.getTrackCount()):
        f = ex.getTrackFormat(i)
        m = str(f.getString(MediaFormat.KEY_MIME))
        if m.startswith("audio/"):
            track = i
            tf = f
            mime = m
            break
    if track < 0:
        ex.release()
        raise Exception("no audio track")
    ex.selectTrack(track)
    duration_us = 0
    try:
        duration_us = int(tf.getLong(MediaFormat.KEY_DURATION))
    except Exception:
        duration_us = 0
    if duration_us <= 0:
        try:
            duration_us = int((os.path.getsize(path) * 8) // 128)
        except Exception:
            duration_us = 60000000
    dec = MediaCodec.createDecoderByType(mime)
    dec.configure(tf, None, None, 0)
    dec.start()
    info = MediaCodec.BufferInfo()
    peaks = [0.0] * bins
    per_bin = max(1, duration_us // bins)
    t0 = time.time()
    input_done = False
    eos = False
    spin = 0
    counter = 0
    wave_skip = max(1, int(duration_us // 26000) // 150)
    last_post = 0.0
    dead = time.time() + 30
    ex.seekTo(0, 2)
    while not eos and time.time() < dead:
        if not input_done:
            pts = ex.getSampleTime()
            if pts < 0:
                input_done = True
        if not input_done:
            counter += 1
            if counter % wave_skip != 0:
                ex.advance()
                out_i = dec.dequeueOutputBuffer(info, 0)
            else:
                idx = dec.dequeueInputBuffer(2000)
                if idx >= 0:
                    buf = dec.getInputBuffer(idx)
                    size = int(ex.readSampleData(buf, 0))
                    pts = int(ex.getSampleTime())
                    if size < 0 or pts < 0:
                        dec.queueInputBuffer(idx, 0, 0, 0, MediaCodec.BUFFER_FLAG_END_OF_STREAM)
                        input_done = True
                    else:
                        dec.queueInputBuffer(idx, 0, size, pts, 0)
                        ex.advance()
                out_i = dec.dequeueOutputBuffer(info, 2000)
        else:
            out_i = dec.dequeueOutputBuffer(info, 2000)
        if out_i >= 0:
            spin = 0
            size = int(info.size)
            pts_us = int(info.presentationTimeUs)
            if size > 1:
                bi = min(bins - 1, max(0, pts_us // per_bin))
                buf = dec.getOutputBuffer(out_i)
                buf.position(int(info.offset))
                buf.limit(int(info.offset) + size)
                chunk = bytearray(size)
                buf.get(chunk)
                b = bytes(chunk)
                step = max(2, len(b) // 32)
                sq = 0.0
                cnt = 0
                for off in range(0, len(b) - 1, step):
                    v = int.from_bytes(b[off:off + 2], "little", signed=True)
                    sq += v * v
                    cnt += 1
                val = (sq / max(1, cnt)) ** 0.5 / 32768.0
                if val > peaks[bi]:
                    peaks[bi] = val
            dec.releaseOutputBuffer(out_i, False)
            if (info.flags & MediaCodec.BUFFER_FLAG_END_OF_STREAM) != 0:
                eos = True
            elif on_partial is not None and time.time() - last_post > 0.15:
                last_post = time.time()
                try:
                    on_partial(list(peaks))
                except Exception:
                    pass
        elif input_done:
            spin += 1
            if spin > 3:
                break
    try:
        dec.stop()
    except Exception:
        pass
    try:
        dec.release()
    except Exception:
        pass
    try:
        ex.release()
    except Exception:
        pass
    mx = max(peaks) if peaks else 0.0
    if mx > 0:
        peaks = [min(1.0, p / (mx * 0.85)) for p in peaks]
    slog(f"wave decode done in {int((time.time() - t0) * 1000)} ms")
    if all(v == 0.0 for v in peaks):
        raise Exception("wave empty")
    return peaks


def _decode_wave(path, bins=120, on_partial=None):
    slog(f"wave decode: {path}")
    vals = _decode_wave_manual(path, bins, on_partial)
    if not vals:
        raise Exception("wave empty")
    if len(vals) == bins:
        bars = [max(0.0, float(v)) for v in vals]
    else:
        bars = []
        per = max(1, len(vals) // bins)
        for b in range(bins):
            chunk = vals[b * per:(b + 1) * per]
            if not chunk:
                bars.append(0.0)
                continue
            bars.append(max(0, max(chunk)) / 31.0)
    peak = max(bars) if bars else 0.0
    if peak > 0:
        bars = [min(1.0, b / peak) for b in bars]
    slog("wave bars: " + " ".join("%.2f" % float(b) for b in bars))
    return bars, 0


def _decode_audio_segment(path, start_ms, end_ms):
    from android.media import AudioFormat, MediaCodec, MediaExtractor, MediaFormat, MediaMuxer
    from array import array
    import uuid

    started = time.time()
    start_us = int(start_ms) * 1000
    end_us = int(end_ms) * 1000

    if end_us <= start_us:
        raise ValueError("empty audio selection")

    out_path = os.path.join(
        _circlet_cache_dir(),
        "circlet_%s.ogg" % uuid.uuid4().hex,
    )

    extractor = None
    decoder = None
    encoder = None
    muxer = None
    muxer_started = False
    decoder_started = False
    encoder_started = False
    completed = False

    try:
        extractor = MediaExtractor()
        extractor.setDataSource(path)

        track = -1
        source_format = None
        mime = None

        for i in range(extractor.getTrackCount()):
            candidate = extractor.getTrackFormat(i)
            candidate_mime = str(candidate.getString(MediaFormat.KEY_MIME))
            if candidate_mime.startswith("audio/"):
                track = i
                source_format = candidate
                mime = candidate_mime
                break

        if track < 0:
            raise RuntimeError("no audio track")

        extractor.selectTrack(track)

        if start_us > 0:
            extractor.seekTo(
                max(0, start_us - 600000),
                MediaExtractor.SEEK_TO_PREVIOUS_SYNC,
            )

        sample_rate = int(source_format.getInteger(MediaFormat.KEY_SAMPLE_RATE))
        channels = int(source_format.getInteger(MediaFormat.KEY_CHANNEL_COUNT))

        if sample_rate <= 0 or channels <= 0:
            raise RuntimeError("invalid audio format")

        try:
            import audioop
        except ImportError:
            audioop = None

        decoder = MediaCodec.createDecoderByType(mime)
        decoder.configure(source_format, None, None, 0)
        decoder.start()
        decoder_started = True

        encoder = MediaCodec.createEncoderByType("audio/opus")
        encode_format = MediaFormat.createAudioFormat("audio/opus", 48000, 1)
        encode_format.setInteger(
            MediaFormat.KEY_BIT_RATE,
            int(_SETTINGS.get("bitrate", 64000)),
        )
        encoder.configure(
            encode_format,
            None,
            None,
            MediaCodec.CONFIGURE_FLAG_ENCODE,
        )
        encoder.start()
        encoder_started = True

        decode_info = MediaCodec.BufferInfo()
        encode_info = MediaCodec.BufferInfo()

        decoder_input_done = False
        decoder_output_done = False
        encoder_input_done = False
        encoder_output_done = False

        pending = bytearray()
        resample_state = None
        fallback_previous = None
        fallback_source_index = 0
        fallback_output_index = 0

        input_samples = 0
        output_samples = 0
        last_source_pts = 0
        track_index = -1

        deadline = time.time() + max(
            120.0,
            (end_ms - start_ms) / 1000.0 * 3.0 + 60.0,
        )

        def convert_pcm(pcm):
            nonlocal resample_state
            nonlocal fallback_previous
            nonlocal fallback_source_index
            nonlocal fallback_output_index

            if channels == 1:
                mono = pcm
            elif channels == 2 and audioop is not None:
                mono = audioop.tomono(pcm, 2, 0.5, 0.5)
            else:
                samples = array("h")
                samples.frombytes(pcm)
                mixed = array("h")

                for offset in range(0, len(samples), channels):
                    frame = samples[offset:offset + channels]
                    if len(frame) == channels:
                        mixed.append(int(sum(frame) / channels))

                mono = mixed.tobytes()

            if sample_rate == 48000:
                return mono

            if audioop is not None:
                mono, resample_state = audioop.ratecv(
                    mono,
                    2,
                    1,
                    sample_rate,
                    48000,
                    resample_state,
                )
                return mono

            source = array("h")
            source.frombytes(mono)
            converted = array("h")

            for current in source:
                index = fallback_source_index

                if fallback_previous is None:
                    fallback_previous = current

                while fallback_output_index * sample_rate <= index * 48000:
                    numerator = fallback_output_index * sample_rate
                    base = (index - 1) * 48000
                    fraction = max(
                        0.0,
                        min(1.0, (numerator - base) / 48000.0),
                    )

                    value = int(
                        fallback_previous
                        + (current - fallback_previous) * fraction
                    )
                    converted.append(max(-32768, min(32767, value)))
                    fallback_output_index += 1

                fallback_previous = current
                fallback_source_index += 1

            return converted.tobytes()

        while not encoder_output_done:
            if time.time() >= deadline:
                raise TimeoutError("audio conversion timed out")

            if not decoder_input_done and len(pending) < 262144:
                input_index = decoder.dequeueInputBuffer(1000)

                if input_index >= 0:
                    input_buffer = decoder.getInputBuffer(input_index)
                    input_buffer.clear()

                    size = int(extractor.readSampleData(input_buffer, 0))
                    pts = int(extractor.getSampleTime())

                    if size < 0 or pts < 0 or pts >= end_us:
                        decoder.queueInputBuffer(
                            input_index,
                            0,
                            0,
                            max(0, last_source_pts),
                            MediaCodec.BUFFER_FLAG_END_OF_STREAM,
                        )
                        decoder_input_done = True
                    else:
                        decoder.queueInputBuffer(
                            input_index,
                            0,
                            size,
                            pts,
                            0,
                        )
                        last_source_pts = pts
                        extractor.advance()

            if not decoder_output_done and len(pending) < 262144:
                output_index = decoder.dequeueOutputBuffer(
                    decode_info,
                    1000,
                )

                if output_index == MediaCodec.INFO_OUTPUT_FORMAT_CHANGED:
                    decoded_format = decoder.getOutputFormat()
                    new_rate = int(
                        decoded_format.getInteger(MediaFormat.KEY_SAMPLE_RATE)
                    )
                    new_channels = int(
                        decoded_format.getInteger(MediaFormat.KEY_CHANNEL_COUNT)
                    )

                    if input_samples and (
                        new_rate != sample_rate or new_channels != channels
                    ):
                        raise RuntimeError(
                            "audio format changed during conversion"
                        )

                    sample_rate = new_rate
                    channels = new_channels

                    if decoded_format.containsKey(
                        MediaFormat.KEY_PCM_ENCODING
                    ):
                        encoding = int(
                            decoded_format.getInteger(
                                MediaFormat.KEY_PCM_ENCODING
                            )
                        )
                        if encoding != AudioFormat.ENCODING_PCM_16BIT:
                            raise RuntimeError(
                                "unsupported decoded PCM encoding"
                            )

                elif output_index >= 0:
                    size = int(decode_info.size)
                    pts = int(decode_info.presentationTimeUs)
                    frame_bytes = channels * 2

                    if size > 0 and frame_bytes > 0:
                        output_buffer = decoder.getOutputBuffer(output_index)
                        output_buffer.position(int(decode_info.offset))
                        output_buffer.limit(int(decode_info.offset) + size)

                        raw = bytearray(size)
                        output_buffer.get(raw)

                        frames = len(raw) // frame_bytes

                        first = max(
                            0,
                            (start_us - pts) * sample_rate // 1000000,
                        )
                        last = min(
                            frames,
                            max(
                                0,
                                (end_us - pts) * sample_rate // 1000000,
                            ),
                        )

                        if last > first:
                            selected = bytes(
                                raw[
                                    first * frame_bytes:
                                    last * frame_bytes
                                ]
                            )
                            input_samples += last - first
                            pending.extend(convert_pcm(selected))

                    flags = int(decode_info.flags)
                    decoder.releaseOutputBuffer(output_index, False)

                    if flags & MediaCodec.BUFFER_FLAG_END_OF_STREAM:
                        decoder_output_done = True

            if not encoder_input_done and (
                pending or decoder_output_done
            ):
                input_index = encoder.dequeueInputBuffer(1000)

                if input_index >= 0:
                    input_buffer = encoder.getInputBuffer(input_index)
                    input_buffer.clear()

                    capacity = int(input_buffer.capacity())
                    take = min(len(pending), capacity, 1920)
                    take -= take % 2

                    pts = output_samples * 1000000 // 48000

                    if take > 0:
                        input_buffer.put(bytes(pending[:take]))
                        del pending[:take]

                        encoder.queueInputBuffer(
                            input_index,
                            0,
                            take,
                            pts,
                            0,
                        )
                        output_samples += take // 2
                    elif decoder_output_done:
                        encoder.queueInputBuffer(
                            input_index,
                            0,
                            0,
                            pts,
                            MediaCodec.BUFFER_FLAG_END_OF_STREAM,
                        )
                        encoder_input_done = True

            output_index = encoder.dequeueOutputBuffer(
                encode_info,
                1000,
            )

            if output_index == MediaCodec.INFO_OUTPUT_FORMAT_CHANGED:
                if muxer is not None:
                    raise RuntimeError("Opus output format changed twice")

                muxer = MediaMuxer(
                    out_path,
                    MediaMuxer.OutputFormat.MUXER_OUTPUT_OGG,
                )
                track_index = muxer.addTrack(encoder.getOutputFormat())
                muxer.start()
                muxer_started = True

            elif output_index >= 0:
                size = int(encode_info.size)
                flags = int(encode_info.flags)

                if size > 0:
                    if not muxer_started:
                        raise RuntimeError("Opus muxer was not started")

                    output_buffer = encoder.getOutputBuffer(output_index)
                    output_buffer.position(int(encode_info.offset))
                    output_buffer.limit(int(encode_info.offset) + size)

                    sample_info = MediaCodec.BufferInfo()
                    sample_info.set(
                        int(encode_info.offset),
                        size,
                        int(encode_info.presentationTimeUs),
                        flags,
                    )
                    muxer.writeSampleData(
                        track_index,
                        output_buffer,
                        sample_info,
                    )

                encoder.releaseOutputBuffer(output_index, False)

                if flags & MediaCodec.BUFFER_FLAG_END_OF_STREAM:
                    encoder_output_done = True

        if input_samples <= 0 or output_samples <= 0:
            raise RuntimeError("empty audio segment")

        duration_sec = max(
            1,
            int(round(output_samples / 48000.0)),
        )

        completed = True
        slog(
            f"ogg streamed: input={input_samples} samples "
            f"output={output_samples} samples "
            f"in {int((time.time() - started) * 1000)} ms"
        )
        return out_path, duration_sec

    finally:
        if decoder is not None:
            if decoder_started:
                try:
                    decoder.stop()
                except Exception:
                    pass
            try:
                decoder.release()
            except Exception:
                pass

        if encoder is not None:
            if encoder_started:
                try:
                    encoder.stop()
                except Exception:
                    pass
            try:
                encoder.release()
            except Exception:
                pass

        if extractor is not None:
            try:
                extractor.release()
            except Exception:
                pass

        if muxer is not None:
            if muxer_started:
                try:
                    muxer.stop()
                except Exception:
                    pass
            try:
                muxer.release()
            except Exception:
                pass

        if not completed:
            try:
                if os.path.isfile(out_path):
                    os.remove(out_path)
            except Exception:
                pass


class CircletPlugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self._pending = None
        self._alive = False
        self._round_uploads = []
        self._voice_once_hooked = False
        self._voice_params_hooked = False
        self._hooks = []
        self._keep = []

    def create_settings(self):
        return [
            Header(text="Circlet"),
            Selector(key='round_resolution', text=localized('Разрешение кружка', 'Video message resolution'),
                     default=3, items=['240 × 240', '384 × 384', '480 × 480', '640 × 640'],
                     icon='msg_video', on_change=self._on_round_resolution_change),
            Switch(key='round_upload_status',
                   text=localized('Показывать отправку видеосообщения', 'Show video message upload activity'),
                   subtext=localized('Статус в чате до подтверждения отправки', 'Chat activity until sending is confirmed'),
                   default=True, icon='msg_video', on_change=self._on_round_upload_status_change),
            Selector(
                key="bitrate",
                text="Битрейт голосовых",
                default=0,
                items=["64 кбит/с", "96 кбит/с", "128 кбит/с", "160 кбит/с"],
                icon="msg_settings",
                on_change=self._on_bitrate_change,
            ),
            Text(
                text=localized("Очистить старые голосовые", "Clean up old voice files"),
                subtext=localized(
                    "Файлы Circlet старше 30 дней",
                    "Circlet files older than 30 days",
                ),
                icon="msg_delete",
                on_click=self._show_cleanup_dialog,
            ),
        ]

    def _on_round_resolution_change(self, idx):
        index = max(0, min(len(ROUND_RESOLUTIONS) - 1, int(idx)))
        self.set_setting('round_resolution', index)
        _SETTINGS['round_resolution'] = ROUND_RESOLUTIONS[index]

    def _on_round_upload_status_change(self, enabled):
        self.set_setting('round_upload_status', bool(enabled))
        if not enabled:
            for status in list(self._round_uploads):
                status.stop()

    def _on_bitrate_change(self, idx):
        try:
            _SETTINGS["bitrate"] = BITRATE_LEVELS[max(0, min(3, int(idx)))][1]
        except Exception:
            pass

    def keep(self, obj):
        self._keep.append(obj)

    def on_plugin_load(self):
        self._alive = True
        try:
            index = max(0, min(len(ROUND_RESOLUTIONS) - 1, int(self.get_setting('round_resolution', 3))))
            _SETTINGS['round_resolution'] = ROUND_RESOLUTIONS[index]
        except Exception:
            _SETTINGS['round_resolution'] = ROUND_SIZE
        _VOICE_DIAG["until"] = time.time() + 600
        try:
            _SETTINGS["bitrate"] = BITRATE_LEVELS[max(0, min(3, int(self.get_setting("bitrate", 0))))][1]
        except Exception:
            pass
        boot_log("BOOT v2 plugin load")
        try:
            self._hook_attach_flow()
            boot_log("BOOT v2 hooks done count=%d" % len(self._hooks))
        except Exception as e:
            boot_log("BOOT v2 hook fail: %s" % e)
        try:
            helper = AccountInstance.getInstance(
                int(UserConfig.selectedAccount)
            ).getSendMessagesHelper()

            for method in array_items(helper.getClass().getMethods()):
                if method.getName() == "prepareSendingVoice":
                    slog("VOICE SIGNATURE " + str(method.toGenericString()))
        except Exception as e:
            slog(f"VOICE SIGNATURE failed: {e}")


    def _hook_attach_flow(self):
        boot_log("HOOK popup=" + str(resolve_class(POPUP_WINDOW) is not None) + " attach=" + str(resolve_class(ATTACH_ALERT) is not None) + " viewer=" + str(resolve_class(PHOTO_VIEWER) is not None) + " preview=" + str(resolve_class(SEND_PREVIEW) is not None))
        popup_cls = resolve_class(POPUP_WINDOW)
        if popup_cls is not None:
            method = find_method(popup_cls, "showAtLocation", 4)
            if method is not None:
                try:
                    ref = self.hook_method(method, PopupShowHook(self))
                    if ref is not None:
                        self._hooks.append(ref)
                        boot_log("HOOK popup showAtLocation ok")
                    else:
                        boot_log("HOOK popup showAtLocation ref None")
                except Exception as e:
                    boot_log("HOOK popup fail: %s" % e)
            else:
                pass

        for cls_name, field in ((ATTACH_ALERT, "writeButton"),
                                (PHOTO_VIEWER, "pickerViewSendButton")):
            cls = resolve_class(cls_name)
            if cls is None:
                continue
            try:
                refs = self.hook_all_constructors(cls, ButtonSeekHook(self, field))
                count = len(list(refs or []))
                self._hooks.extend(list(refs or []))
                boot_log("HOOK ctor %s %s count=%d" % (cls_name, field, count))
            except Exception as e:
                boot_log("HOOK ctor fail %s %s: %s" % (cls_name, field, e))

        iopts_cls = resolve_class("org.telegram.ui.Components.ItemOptions") or resolve_class("org.telegram.ui.ActionBar.ItemOptions")
        boot_log("HOOK iopts=%s" % (iopts_cls is not None))
        smh_cls = resolve_class("org.telegram.messenger.SendMessagesHelper")
        if smh_cls is not None:
            sp_count = 0
            for m in array_items(smh_cls.getDeclaredMethods()):
                try:
                    if m.getName() != "sendMessage":
                        continue

                    types = array_items(m.getParameterTypes())
                    if not types or "SendMessageParams" not in str(types[0].getName()):
                        continue

                    m.setAccessible(True)
                    ref = self.hook_method(m, SendPipelineHook("sendMessage", self))
                    if ref is not None:
                        self._hooks.append(ref)
                        self._voice_params_hooked = True
                        sp_count += 1
                except Exception as e:
                    slog(f"sendMessage hook failed: {e}")

            boot_log(f"HOOK voice params hooked={sp_count}")
        if iopts_cls is not None:
            for m in iopts_cls.getDeclaredMethods():
                if m.getName() != "show":
                    continue
                if len(m.getParameterTypes()) != 0:
                    continue
                m.setAccessible(True)
                try:
                    ref = self.hook_method(m, ItemOptionsHook(self))
                    if ref is not None:
                        self._hooks.append(ref)
                        boot_log("HOOK iopts show ok")
                except Exception as e:
                    boot_log("HOOK iopts fail: %s" % e)

        preview_cls = resolve_class(SEND_PREVIEW)
        if preview_cls is not None:
            method = find_method(preview_cls, "setItemOptions", 1)
            boot_log("HOOK preview setItemOptions found=%s" % (method is not None))
            if method is not None:
                try:
                    ref = self.hook_method(method, SendPreviewHook(self))
                    if ref is not None:
                        self._hooks.append(ref)
                        boot_log("HOOK preview ok")
                    else:
                        boot_log("HOOK preview ref None")
                except Exception as e:
                    boot_log("HOOK preview fail: %s" % e)
            else:
                pass
        else:
            pass

        self._hook_live_viewer()

    def _hook_live_viewer(self):
        cls = resolve_class(PHOTO_VIEWER)
        if cls is None:
            return
        has = find_method(cls, "hasInstance", 0)
        if has is not None:
            try:
                if not bool(has.invoke(None, None)):
                    return
            except Exception:
                pass
        getter = find_method(cls, "getInstance", 0)
        if getter is None:
            return
        try:
            viewer = getter.invoke(None, None)
        except Exception:
            return
        if viewer is None:
            return
        listener_cls = listener_class(viewer, "pickerViewSendButton")
        if listener_cls is None:
            return
        method = find_method(listener_cls, "onLongClick", 1)
        if method is None:
            return
        boot_log("HOOK live longclick found=%s" % (method is not None))
        try:
            ref = self.hook_method(method, SendLongClickHook())
            if ref is not None:
                self._hooks.append(ref)
                boot_log("HOOK live longclick ok")
            else:
                boot_log("HOOK live longclick ref None")
        except Exception as e:
            boot_log("HOOK live longclick fail: %s" % e)

    def on_plugin_unload(self):
        self._alive = False
        sheet = ACTIVE.get('sheet')
        if sheet is not None and getattr(sheet.probe, 'plugin', None) is self:
            sheet._dismiss()
        for status in list(self._round_uploads):
            status.stop()
        for ref in list(self._hooks):
            try:
                self.unhook_method(ref)
            except Exception:
                pass
        self._hooks = []
        self._keep = []
        self._pending = None
        ARMED["active"] = False
        ARMED["path"] = None
        ARMED["mo"] = None
        ARMED["doc"] = None

    def open_from_send_ui(self, path=None, once=False):
        try:
            dismiss_popup()
            current_path = resolve_send_path()
            if path is not None and path != current_path:
                if not (current_path is None and preview_state_path() == path):
                    toast(localized("Выбранный файл изменился", "Selected file changed"))
                    return False
            if current_path:
                path = current_path
            if not path or not media_kind(path):
                toast(localized("Выберите один видео- или аудиофайл", "Select one video or audio file"))
                return False
            if once and not once_allowed(get_last_fragment(), int(UserConfig.selectedAccount)):
                toast(localized("Одноразовые сообщения доступны только в личном чате с пользователем", "View-once messages require a private chat with another user"))
                return False
            if media_kind(path) == "audio":
                return self.open_audio(path, once)
            return self.open_for_path(path, once)
        except Exception as e:
            slog(f"open_from_send_ui failed: {e}")
            toast(localized("Не удалось открыть превью", "Could not open the preview"))
            return False

    def open_for_path(self, path, once=False):
        existing = ACTIVE.get("sheet")
        if existing is not None:
            dialog = existing.dialog
            showing = False
            if dialog is not None:
                try:
                    showing = bool(dialog.isShowing())
                except Exception:
                    showing = False
            if showing:
                return False
            ACTIVE["sheet"] = None

        if not path or not os.path.exists(path):
            toast("Файл не найден")
            return False

        probe = VideoProbe(path)
        probe.ttl = ONCE_TTL if once else 0
        probe.target_fragment = get_last_fragment()
        probe.account = int(UserConfig.selectedAccount)
        probe.plugin = self
        probe.round_size = round_resolution()
        probe.send_context = capture_round_context(probe.target_fragment, probe.account)

        def _prepare():
            ok = probe.run()
            if ok:
                slog(f"probe ok: {probe.width}x{probe.height} dur={probe.duration_ms} ms")
            else:
                slog("probe failed")

            def _open():
                if not self._alive or get_last_fragment() != probe.target_fragment or int(UserConfig.selectedAccount) != probe.account:
                    return
                if not ok:
                    toast(localized("Не удалось прочитать размеры видео", "Could not read video dimensions"))
                    return
                try:
                    vw_start, vw_end = viewer_trim_window_ms(int(probe.duration_ms), path)
                except Exception:
                    vw_start, vw_end = -1, -1
                if vw_end > 0 and vw_start > 0:
                    probe.fetch_frame_at(vw_start * 1000)
                    slog(f"preview frame re-fetched at {vw_start} ms")
                sheet = CropSheet(probe, send_round)
                self._pending = sheet
                try:
                    sheet.show()
                except Exception as e:
                    slog(f"sheet show failed: {e}")
                    toast(localized("Не удалось открыть превью", "Could not open the preview"))

            run_on_ui_thread(_open)

        threading.Thread(target=_prepare, daemon=True).start()
        return True

    def open_audio(self, path, once=False):
        frag = get_last_fragment()
        if frag is None:
            toast(localized("Нет открытого чата", "No open chat"))
            return False

        if not path:
            toast(localized("Файл не найден", "File not found"))
            return False

        account = int(UserConfig.selectedAccount)
        if once and not once_allowed(frag, account):
            toast(localized(
                "Одноразовые сообщения доступны только в личном чате с пользователем",
                "View-once messages require a private chat with another user",
            ))
            return False

        dialog_id = resolve_dialog_id(frag)
        if not dialog_id:
            toast(localized(
                "Не понял, в какой чат отправлять",
                "Could not determine the chat",
            ))
            return False

        self._audio_wait_token = getattr(self, "_audio_wait_token", 0) + 1
        token = self._audio_wait_token
        source_path = path
        needs_temporary_copy = not os.path.isfile(source_path)

        def still_current():
            return (
                getattr(self, "_audio_wait_token", 0) == token
                and get_last_fragment() == frag
            )

        def open_ready(ready_path, temporary_path=None):
            if not still_current():
                remove_temporary_audio(temporary_path)
                return

            retriever = None
            duration_ms = 0

            try:
                retriever = MediaMetadataRetriever()
                retriever.setDataSource(ready_path)
                raw = retriever.extractMetadata(
                    MediaMetadataRetriever.METADATA_KEY_DURATION
                )
                duration_ms = int(raw) if raw else 0
            except Exception as e:
                slog(f"audio duration failed: {e}")
            finally:
                if retriever is not None:
                    try:
                        retriever.release()
                    except Exception:
                        pass

            if duration_ms <= 0:
                remove_temporary_audio(temporary_path)
                toast(localized(
                    "Не удалось прочитать загруженный трек",
                    "Could not read the downloaded track",
                ))
                return

            class _AudioProbe:
                pass

            probe = _AudioProbe()
            probe.path = ready_path
            probe.duration_ms = duration_ms
            probe.width = 0
            probe.height = 0
            probe.rotation = 0
            probe.frame = None
            probe.ttl = ONCE_TTL if once else 0
            probe.dialog_id = int(dialog_id)
            probe.account = account
            probe.target_fragment = frag
            probe.temporary_audio_path = temporary_path

            sheet = None
            try:
                sheet = CropSheet(
                    probe,
                    lambda pp, cs, r: self.send_voice_segment(pp),
                    audio_mode=True,
                )
                sheet.temporary_audio_path = temporary_path

                if not sheet.show():
                    raise RuntimeError("sheet.show returned False")

                self._pending = sheet
            except Exception as e:
                slog(f"audio sheet failed: {e}")
                remove_temporary_audio(temporary_path)
                toast(localized(
                    "Не удалось открыть превью",
                    "Could not open the preview",
                ))

        if not needs_temporary_copy:
            open_ready(source_path)
            return True

        alert = attach_alert_from_fragment()
        mo = selected_attachment_message(alert) if alert is not None else None
        doc = _audio_doc_from_entry(mo) if mo is not None else None

        if doc is None:
            doc = ARMED.get("doc")

        if doc is None:
            doc = _audio_doc_from_entry(ARMED.get("mo"))

        if doc is None:
            doc = preview_state_doc()

        if doc is None:
            toast(localized(
                "Не удалось определить выбранный трек",
                "Could not identify the selected track",
            ))
            return False

        try:
            expected_size = int(doc.size)
        except Exception:
            expected_size = 0

        if expected_size <= 0:
            toast(localized(
                "Не удалось определить размер трека",
                "Could not determine track size",
            ))
            return False

        toast(localized(
            "Нажмите значок загрузки у трека. После загрузки откроется превью",
            "Tap the track's download icon. Preview will open when it finishes",
        ))

        state = {"tries": 0, "copying": False}

        def copy_downloaded_file(downloaded_path):
            try:
                temporary_path = make_temporary_audio_copy(downloaded_path)
            except Exception as e:
                slog(f"temporary audio copy failed: {e}")

                def copy_failed():
                    if still_current():
                        toast(localized(
                            "Не удалось подготовить загруженный трек",
                            "Could not prepare the downloaded track",
                        ))

                run_on_ui_thread(copy_failed)
                return

            run_on_ui_thread(
                lambda p=temporary_path: open_ready(p, p)
            )

        def poll():
            if not still_current() or state["copying"]:
                return

            state["tries"] += 1
            current_path = audio_document_path(doc) or source_path

            try:
                size = (
                    os.path.getsize(current_path)
                    if current_path and os.path.isfile(current_path)
                    else 0
                )
            except Exception:
                size = 0

            if size >= expected_size:
                state["copying"] = True
                slog(f"audio download ready: {size}/{expected_size}")
                toast(localized("Трек загружен", "Track downloaded"))
                threading.Thread(
                    target=lambda p=current_path: copy_downloaded_file(p),
                    daemon=True,
                ).start()
                return

            if state["tries"] % 10 == 1:
                slog(f"waiting for track download: {size}/{expected_size}")

            if state["tries"] >= 360:
                toast(localized(
                    "Трек не загружен. Попробуйте нажать значок загрузки ещё раз",
                    "Track was not downloaded. Try tapping its download icon again",
                ))
                return

            run_on_ui_thread(poll, 500)

        run_on_ui_thread(poll, 700)
        return True

    def send_voice_segment(self, probe):
        start_ms, end_ms = getattr(probe, "trim_ms", (0, 0)) or (0, 0)
        if end_ms - start_ms < 500:
            return False

        temporary_source = getattr(probe, "temporary_audio_path", None)

        toast(localized("Готовлю голосовое…", "Preparing voice message…"))
        run_on_ui_thread(dismiss_popup, 0)
        run_on_ui_thread(close_hosts, 0)

        sheet = self._pending if getattr(self, "_pending", None) is not None else ACTIVE.get("sheet")
        bars = getattr(sheet, "wave_bars", None) if sheet is not None else None

        def work():
            try:
                wav_path, duration_sec = _decode_audio_segment(
                    probe.path,
                    start_ms,
                    end_ms,
                )

                def send():
                    self.send_voice_file(wav_path, duration_sec, probe, bars)

                run_on_ui_thread(send)
            except Exception as e:
                slog(f"audio decode failed: {e}")
                toast(localized(
                    "Не удалось подготовить голосовое",
                    "Could not prepare the voice message",
                ))
            finally:
                if temporary_source:
                    remove_temporary_audio(temporary_source)
                else:
                    slog(f"voice cleanup: probe has no temporary path, source={probe.path}")

        threading.Thread(target=work, daemon=True).start()
        return True

    def send_voice_file(self, wav_path, duration_sec, probe, bars=None):
        try:
            account = int(getattr(probe, "account", int(UserConfig.selectedAccount)))
            dialog_id = int(getattr(probe, "dialog_id", 0))
            ttl = int(getattr(probe, "ttl", 0) or 0)
            helper = AccountInstance.getInstance(account).getSendMessagesHelper()

            _SEND_WATCH["ts"] = time.time()
            wf = _build_waveform(bars)

            if ttl:
                if not self._voice_params_hooked:
                    raise RuntimeError("SendMessageParams hook is not installed")

                with _VOICE_ONCE_LOCK:
                    _VOICE_ONCE_PATHS[wav_path] = time.time() + 120

                try:
                    self._send_voice_params(
                        helper, wav_path, duration_sec, probe,
                        account, dialog_id, ttl, bars
                    )
                except Exception:
                    with _VOICE_ONCE_LOCK:
                        _VOICE_ONCE_PATHS.pop(wav_path, None)
                    raise
            elif self._try_send_voice_native(
                helper, wav_path, duration_sec, dialog_id, wf, ttl
            ):
                slog("voice sent via prepareSendingVoice")
            else:
                self._send_voice_params(
                    helper, wav_path, duration_sec, probe,
                    account, dialog_id, ttl, bars
                )

            toast(localized("Голосовое отправляется", "Voice message is being sent"))
            run_on_ui_thread(dismiss_popup, 0)
            run_on_ui_thread(close_hosts, 60)
        except Exception as e:
            slog(f"send voice failed: {e}")
            toast(localized("Не удалось отправить голосовое", "Could not send voice message"))

    def _try_send_voice_native(self, helper, wav_path, duration_sec, dialog_id, wf, ttl):
        try:
            cls = helper.getClass()
            cands = []
            for m in array_items(cls.getMethods()):
                if m.getName() == "prepareSendingVoice":
                    m.setAccessible(True)
                    cands.append(m)
            if not cands:
                slog("prepareSendingVoice not found")
                return False
            cands.sort(key=lambda m: -JArray.getLength(m.getParameterTypes()))
            for m in cands:
                types = [p.getName() for p in array_items(m.getParameterTypes())]
                if not types or types[0] != "java.lang.String":
                    continue
                args = []
                for i, t in enumerate(types):
                    if t == "java.lang.String":
                        args.append(JString(wav_path))
                    elif t == "int" and i == 1:
                        args.append(JInteger(int(duration_sec)))
                    elif t == "int":
                        args.append(JInteger(0))
                    elif t == "long":
                        args.append(JLong(dialog_id))
                    elif t == "byte[]":
                        args.append(wf if wf is not None else bytes(1))
                    elif t == "boolean":
                        args.append(JBoolean(False))
                    else:
                        args.append(None)
                slog(f"prepareSendingVoice types={types}")
                m.invoke(helper, args)
                return True
            slog("prepareSendingVoice unusable signatures")
            return False
        except Exception as e:
            slog(f"prepareSendingVoice fail: {e}")
            return False

    def _send_voice_params(self, helper, wav_path, duration_sec, probe, account, dialog_id, ttl, bars=None):
        doc = resolve_class("org.telegram.tgnet.TLRPC$TL_document").newInstance()
        set_typed_field(doc, "id", 0)
        set_typed_field(doc, "size", int(os.path.getsize(wav_path)))
        set_typed_field(doc, "date", int(time.time()))
        set_typed_field(doc, "mime_type", "audio/ogg")
        doc.file_reference = bytearray(0)
        doc.dc_id = 0
        attr = resolve_class("org.telegram.tgnet.TLRPC$TL_documentAttributeAudio").newInstance()
        attr.voice = True
        attr.duration = int(duration_sec)
        wf2 = _build_waveform(bars)
        if wf2:
            try:
                attr.waveform = wf2
            except Exception:
                pass
        doc.attributes.add(attr)
        from client_utils import send_message
        send_message({
            "peer": int(dialog_id),
            "path": wav_path,
            "document": doc,
        }, account=account)
        slog("voice sent via client_utils.send_message")
    
    def _show_cleanup_dialog(self, view):
        try:
            from org.telegram.ui.ActionBar import AlertDialog as TelegramAlertDialog

            class CleanupButton(dynamic_proxy(TelegramAlertDialog.OnButtonClickListener)):
                def __init__(self, handler):
                    super().__init__()
                    self.handler = handler

                def onClick(self, *args):
                    self.handler()

            confirm = CleanupButton(self._start_voice_cleanup)
            cancel = CleanupButton(lambda: None)
            self.keep(confirm)
            self.keep(cancel)

            builder = TelegramAlertDialog.Builder(view.getContext())
            builder.setTitle(JString(localized(
                "Очистка файлов",
                "Clean up files",
            )))
            builder.setMessage(JString(localized(
                "Удалить голосовые файлы Circlet старше 30 дней? "
                "Если старое сообщение ещё ожидает повторной отправки, "
                "его файл может понадобиться Telegram.",
                "Delete Circlet voice files older than 30 days? "
                "Telegram may still need a file if an old message is waiting to be retried.",
            )))
            builder.setNegativeButton(
                JString(localized("Отмена", "Cancel")),
                cancel,
            )
            builder.setPositiveButton(
                JString(localized("Удалить", "Delete")),
                confirm,
            )
            builder.show()
        except Exception as e:
            slog(f"cleanup dialog failed: {type(e).__name__}: {e}")
            toast(localized(
                "Не удалось открыть подтверждение",
                "Could not open confirmation",
            ))


    def _start_voice_cleanup(self):
        def work():
            try:
                removed, freed, failed = clean_old_voice_files(30)

                def done():
                    mb = freed / (1024.0 * 1024.0)
                    message = localized(
                        f"Удалено файлов: {removed}, освобождено: {mb:.1f} МБ",
                        f"Files deleted: {removed}, freed: {mb:.1f} MB",
                    )
                    if failed:
                        message += localized(
                            f". Ошибок: {failed}",
                            f". Errors: {failed}",
                        )
                    toast(message)

                run_on_ui_thread(done)
            except Exception as e:
                slog(f"voice cleanup failed: {e}")
                run_on_ui_thread(lambda: toast(localized(
                    "Не удалось очистить файлы",
                    "Could not clean up files",
                )))

        threading.Thread(target=work, daemon=True).start()

ROUND_RESOLUTIONS = (240, 384, 480, 640)


def round_resolution(value=None):
    try:
        size = int(_SETTINGS.get('round_resolution', ROUND_SIZE) if value is None else value)
        return size if size in ROUND_RESOLUTIONS else ROUND_SIZE
    except Exception:
        return ROUND_SIZE


def context_value(obj, method, field=None):
    if obj is None:
        return None
    try:
        found = find_method(obj.getClass(), method, 0)
        if found is not None:
            return found.invoke(obj, None)
    except Exception:
        pass
    return get_field(obj, field) if field else None


def capture_round_context(frag, account):
    did = resolve_dialog_id(frag)
    instance = AccountInstance.getInstance(account)
    reply = context_value(frag, 'getReplyMessage', 'replyingMessageObject')
    if reply is None:
        enter = get_field(frag, 'chatActivityEnterView')
        reply = context_value(enter, 'getReplyingMessageObject', 'replyingMessageObject')
    top = context_value(frag, 'getThreadMessage', 'threadMessageObject')
    if top is None:
        top = context_value(frag, 'getReplyTopMessage', 'replyingTopMessage')
    if top is None:
        _, top = topic_pair(instance, frag, did)
    return dict(dialog_id=did, account=int(account), reply=reply, top=top,
                quote=context_value(frag, 'getReplyQuote', 'replyingQuote'),
                topic_id=int(context_value(frag, 'getTopicId') or 0),
                chat_args=context_value(frag, 'getMessageChatSendParams'),
                mono_peer=int(context_value(frag, 'getSendMonoForumPeerId') or 0))


def crop_preview_dimensions(screen_w, screen_h):
    width = max(64, int(screen_w) - AndroidUtilities.dp(16))
    insets = int(getattr(AndroidUtilities, 'statusBarHeight', 0) or 0) + int(getattr(AndroidUtilities, 'navigationBarHeight', 0) or 0)
    height = max(64, int(screen_h) - insets - AndroidUtilities.dp(250))
    return width, height


def prepare_circlet_options(options):
    for name in ('layout', 'lastLayout'):
        view = get_field(options, name)
        if view is not None:
            try:
                view.setTag(JString(INJECT_TAG))
            except Exception:
                pass
    for name, value in (('forceBottom', False), ('forceTop', True), ('setLongPressSelectionEnabled', False)):
        try:
            method = find_method(options.getClass(), name, 1)
            if method is not None:
                method.invoke(options, [JBoolean(value)])
        except Exception:
            pass
    try:
        method = find_method(options.getClass(), 'translate', 2)
        if method is not None:
            method.invoke(options, [JFloat(0.0), JFloat(-AndroidUtilities.dp(12))])
    except Exception:
        pass


def send_button_top(default):
    candidates = []
    alert = HOSTS.get('alert') or attach_alert_from_fragment()
    if alert is not None:
        candidates.append(get_field(alert, 'writeButton'))
    try:
        cls = resolve_class(PHOTO_VIEWER)
        getter = find_method(cls, 'getInstance', 0) if cls is not None else None
        viewer = getter.invoke(None, None) if getter is not None else None
        if viewer is not None:
            candidates.insert(0, get_field(viewer, 'pickerViewSendButton'))
    except Exception:
        pass
    for button in candidates:
        try:
            rect = Rect()
            if button is not None and button.isShown() and button.getGlobalVisibleRect(rect) and rect.top > 0:
                return int(rect.top)
        except Exception:
            pass
    return int(default)


def popup_top(y, old_height, new_height, anchor_top, top_limit, gap):
    return max(int(top_limit), min(int(y) - max(0, int(new_height) - int(old_height)), int(anchor_top) - int(gap) - int(new_height)))


def raise_circlet_popup(param, content, old_height):
    try:
        width = int(AndroidUtilities.displaySize.x)
        height = int(AndroidUtilities.displaySize.y)
        content.measure(View.MeasureSpec.makeMeasureSpec(width - AndroidUtilities.dp(16), View.MeasureSpec.AT_MOST), View.MeasureSpec.makeMeasureSpec(height - AndroidUtilities.dp(96), View.MeasureSpec.AT_MOST))
        measured = int(content.getMeasuredHeight())
        if measured <= 0:
            return
        gap = AndroidUtilities.dp(12)
        anchor_top = send_button_top(height - AndroidUtilities.dp(80))
        gravity = int(param.args[1])
        if gravity & Gravity.BOTTOM == Gravity.BOTTOM:
            param.args[3] = JInteger(max(int(param.args[3]), height - anchor_top + gap))
        elif gravity & Gravity.CENTER_VERTICAL != Gravity.CENTER_VERTICAL:
            param.args[3] = JInteger(popup_top(param.args[3], old_height, measured, anchor_top, AndroidUtilities.dp(8) + int(getattr(AndroidUtilities, 'statusBarHeight', 0) or 0), gap))
    except Exception as exc:
        slog('popup position: ' + str(exc))


class RoundUploadStatus:
    def __init__(self, plugin, probe, context, info=None):
        self.info = info
        self.plugin = plugin
        self.account = int(context['account'])
        self.dialog_id = int(context['dialog_id'])
        self.topic_id = int(context.get('topic_id', 0))
        self.path = str(probe.path)
        self.paths = {self.path}
        self.mid = None
        self.message_ids = set()
        self.message = None
        self.random_id = None
        self._typing_callbacks = {}
        self._typing_blocked = False
        self.center = None
        self.observer = None
        self.events = {}
        self.started = self.last_activity = time.monotonic()
        self.active = False

    def start(self):
        if not self.plugin._alive or not bool(self.plugin.get_setting("round_upload_status", True)):
            return
        from org.telegram.messenger import NotificationCenter
        status = self
        class Observer(dynamic_proxy(NotificationCenter.NotificationCenterDelegate)):
            def didReceivedNotification(self, event, account, args):
                if status.active and int(account) == status.account:
                    try:
                        status.received(int(event), list(args or []))
                    except Exception as exc:
                        slog('round status event: ' + str(exc))
        self.center = NotificationCenter.getInstance(self.account)
        self.observer = Observer()
        self.active = True
        self.plugin._round_uploads.append(self)
        for name in ('didReceiveNewMessages', 'filePreparingStarted', 'filePreparingFailed', 'fileNewChunkAvailable', 'fileUploadProgressChanged', 'fileUploaded', 'fileUploadFailed', 'messageReceivedByServer', 'messageSendError', 'messagesDeleted'):
            event = getattr(NotificationCenter, name, None)
            if event is not None:
                self.events[int(event)] = name
                self.center.addObserver(self.observer, int(event))
        self.pulse()

    def action(self, value):
        try:
            controller = AccountInstance.getInstance(self.account).getMessagesController()
            if self.private_action(controller, value):
                return
            method = find_method(controller.getClass(), 'sendTyping', 4)
            if method is not None:
                method.invoke(controller, [JLong(self.dialog_id), JLong(self.topic_id), JInteger(value), JInteger(0)])
                return
            method = find_method(controller.getClass(), 'sendTyping', 3)
            if method is not None and not self.topic_id:
                method.invoke(controller, [JLong(self.dialog_id), JInteger(value), JInteger(0)])
        except Exception as exc:
            slog('round upload activity: ' + str(exc))

    def private_action(self, controller, value):
        if self.dialog_id <= 0:
            return False
        from org.telegram.messenger import DialogObject
        if DialogObject.isEncryptedDialog(self.dialog_id):
            return False
        if self.dialog_id == int(AccountInstance.getInstance(self.account).getUserConfig().getClientUserId()):
            return True
        method = find_method(controller.getClass(), 'getInputPeer', 1)
        if method is None:
            return False
        peer = method.invoke(controller, [JLong(self.dialog_id)])
        if peer is None or not int(get_field(peer, 'user_id') or 0):
            return False
        if self._typing_blocked or (value == 8 and 8 in self._typing_callbacks):
            return True
        from org.telegram.tgnet import TLRPC, RequestDelegate
        request = TLRPC.TL_messages_setTyping()
        request.peer = peer
        request.action = TLRPC.TL_sendMessageUploadRoundAction() if value == 8 else TLRPC.TL_sendMessageCancelAction()
        if value == 8:
            request.action.progress = 0
        status = self
        class Callback(dynamic_proxy(RequestDelegate)):
            def run(self, response, error):
                def finish():
                    if status._typing_callbacks.get(value) is self:
                        status._typing_callbacks.pop(value, None)
                    if error is not None:
                        status._typing_blocked = True
                        slog('round private activity unavailable: ' + str(get_field(error, 'text') or 'request failed'))
                run_on_ui_thread(finish, 0)
        callback = Callback()
        self._typing_callbacks[value] = callback
        try:
            manager = AccountInstance.getInstance(self.account).getConnectionsManager()
            send = find_method(manager.getClass(), 'sendRequest', 2)
            if send is None:
                self._typing_callbacks.pop(value, None)
                return False
            send.invoke(manager, [request, callback])
        except Exception:
            self._typing_callbacks.pop(value, None)
            raise
        return True

    def pulse(self):
        if not self.active:
            return
        if not self.plugin._alive or not bool(self.plugin.get_setting("round_upload_status", True)):
            self.stop()
            return
        if self.message is not None:
            owner = get_field(self.message, 'messageOwner')
            state = get_field(owner, 'send_state')
            mid = get_field(owner, 'id')
            if state is not None and (int(state) == 2 or (int(state) == 0 and mid is not None and int(mid) > 0)):
                self.stop()
                return
        self.action(8)
        run_on_ui_thread(self.pulse, 4000)

    def bind(self, params):
        info = get_field(params, 'videoEditedInfo')
        if info is None or not bool(get_field(info, 'roundVideo')) or str(get_field(info, 'originalPath') or '') != self.path or int(get_field(params, 'peer') or 0) != self.dialog_id:
            return
        if self.info is not None and info != self.info:
            return
        self.last_activity = time.monotonic()
        path = get_field(params, 'path')
        if path:
            self.paths.add(str(path))

    def matches(self, message):
        if message is None:
            return False
        info = get_field(message, 'videoEditedInfo')
        owner = get_field(message, 'messageOwner')
        path = get_field(owner, 'attachPath') if owner is not None else None
        original = get_field(info, 'originalPath') if info is not None else None
        did = context_value(message, 'getDialogId') or get_field(owner, 'dialog_id')
        if did is not None and int(did) != self.dialog_id:
            return False
        known_path = bool(path) and str(path) in self.paths
        same_info = info is not None and self.info is not None and info == self.info
        if not known_path and not same_info:
            if self.info is not None or str(original or '') != self.path:
                return False
        if get_field(owner, 'out') is not None and not bool(get_field(owner, 'out')):
            return False
        self.last_activity = time.monotonic()
        if path:
            self.paths.add(str(path))
        self.message = message
        random_id = get_field(owner, 'random_id')
        if random_id is not None and int(random_id) != 0:
            self.random_id = int(random_id)
        mid = context_value(message, 'getId') or get_field(owner, 'id')
        if mid is not None:
            self.mid = int(mid)
            self.message_ids.add(self.mid)
        return True

    def received(self, event, args):
        name = self.events.get(event)
        if name == 'didReceiveNewMessages' and len(args) > 1 and int(args[0]) == self.dialog_id:
            for message in array_items(args[1]):
                self.matches(message)
        elif name in ('filePreparingStarted', 'filePreparingFailed', 'fileNewChunkAvailable') and args:
            if self.matches(args[0]):
                if len(args) > 1:
                    self.paths.add(str(args[1]))
                if name == 'filePreparingFailed':
                    self.stop()
        elif name == 'fileUploadProgressChanged' and args and str(args[0]) in self.paths:
            self.last_activity = time.monotonic()
        elif name == 'fileUploaded' and args and str(args[0]) in self.paths:
            self.last_activity = time.monotonic()
        elif name == 'fileUploadFailed' and args and str(args[0]) in self.paths:
            self.stop()
        elif name in ('messageReceivedByServer', 'messageSendError') and args:
            matched = int(args[0]) in self.message_ids or (self.mid is not None and int(args[0]) == self.mid)
            if not matched and name == 'messageReceivedByServer' and len(args) > 2:
                owner = args[2]
                random_id = get_field(owner, 'random_id')
                matched = self.random_id is not None and random_id is not None and int(random_id) == self.random_id
                if len(args) > 3 and int(args[3]) != self.dialog_id:
                    matched = False
            if matched:
                self.stop()
        elif name == 'messagesDeleted' and args:
            ids = {int(mid) for mid in array_items(args[0])}
            if ids.intersection(self.message_ids) or (self.mid is not None and self.mid in ids):
                self.stop()

    def stop(self):
        if not self.active:
            return
        self.active = False
        for event in self.events:
            try:
                self.center.removeObserver(self.observer, event)
            except Exception:
                pass
        if self in self.plugin._round_uploads:
            self.plugin._round_uploads.remove(self)
        if not any(item.active and (item.account, item.dialog_id, item.topic_id) == (self.account, self.dialog_id, self.topic_id) for item in self.plugin._round_uploads):
            self.action(2)
        self.observer = None
        self.center = None
        self.message = None
