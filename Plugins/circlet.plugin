class _VPSurfaceListener(dynamic_proxy(TextureView.SurfaceTextureListener)):
    def __init__(self, sheet):
        super().__init__()
        self.sheet = sheet

    def onSurfaceTextureAvailable(self, surface_texture, width, height):
        s = self.sheet
        if s is not None:
            try:
                s.on_video_surface_ready(surface_texture)
            except Exception as e:
                slog(f"surface available fail: {e}")

    def onSurfaceTextureSizeChanged(self, surface_texture, width, height):
        pass

    def onSurfaceTextureDestroyed(self, surface_texture):
        s = self.sheet
        if s is not None:
            try:
                s.on_video_surface_gone()
            except Exception:
                pass
        return True

    def onSurfaceTextureUpdated(self, surface_texture):
        pass


