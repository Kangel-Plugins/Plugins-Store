__description__ = """Отправка видео кружком с превью обрезки.

Выбираете видео, видите живое превью круга на весь экран. Один палец двигает круг, два пальца меняют его размер. Если видео длиннее минуты, отправится выбранный кусок, а без обрезки — первая минута. Только потом отправка."""


ACTIVE = {"sheet": None}

ROUND_SIZE = 384
ROUND_SAFE_MS = 59990
ROUND_START_SHIFT_MS = 100
PREVIEW_DP = 240
MIN_ZOOM = 1.0
MAX_ZOOM = 4.0

_CLASS_CACHE = {}
_METHOD_CACHE = {}


def slog(message):
    return


def resolve_class(name):
    if name in _CLASS_CACHE:
        return _CLASS_CACHE[name]
    cls = None
    try:
        cls = JClass.forName(name)
    except Exception:
        try:
            from hook_utils import find_class
            raw = find_class(name)
            if raw is not None:
                cls = raw if hasattr(raw, "getName") else raw.getClass()
        except Exception:
            cls = None
    _CLASS_CACHE[name] = cls
    return cls


def array_items(arr):
    if arr is None:
        return []
    try:
        n = JArray.getLength(arr)
        return [JArray.get(arr, i) for i in range(n)]
    except Exception:
        return []


def find_method(cls, name, param_count=None):
    if cls is None:
        return None
    key = (getattr(cls, "getName", lambda: str(cls))(), name, param_count)
    if key in _METHOD_CACHE:
        return _METHOD_CACHE[key]

    by_count = None
    by_name = None
    methods = []
    walker = cls
    while walker is not None:
        methods.extend(array_items(walker.getDeclaredMethods()))
        try:
            walker = walker.getSuperclass()
        except Exception:
            walker = None

    for m in methods:
        try:
            if m.getName() != name:
                continue
            if by_name is None:
                by_name = m
            count = JArray.getLength(m.getParameterTypes())
            if param_count is not None and count == param_count and by_count is None:
                by_count = m
        except Exception:
            continue

    chosen = by_count or by_name
    if chosen is not None:
        try:
            chosen.setAccessible(True)
        except Exception:
            pass
    _METHOD_CACHE[key] = chosen
    return chosen

def set_typed_field(obj, name, value):
    cls = obj.getClass()
    while cls is not None:
        try:
            f = cls.getDeclaredField(name)
        except Exception:
            try:
                cls = cls.getSuperclass()
                continue
            except Exception:
                return None
        try:
            f.setAccessible(True)
            kind = f.getType().getName()
            if kind == "boolean":
                f.setBoolean(obj, bool(value))
            elif kind == "int":
                f.setInt(obj, int(value))
            elif kind == "long":
                f.setLong(obj, int(value))
            elif kind == "float":
                f.setFloat(obj, float(value))
            elif kind == "double":
                f.setDouble(obj, float(value))
            elif kind == "java.lang.String":
                f.set(obj, JString(str(value)))
            else:
                f.set(obj, value)
            return f.get(obj)
        except Exception:
            return None
    return None


def get_field(obj, name, default=None):
    cls = obj.getClass()
    while cls is not None:
        try:
            f = cls.getDeclaredField(name)
            f.setAccessible(True)
            return f.get(obj)
        except Exception:
            try:
                cls = cls.getSuperclass()
            except Exception:
                return default
    return default


def context():
    frag = get_last_fragment()
    ctx = frag.getParentActivity() if frag is not None else None
    if ctx is not None:
        return ctx
    try:
        from org.telegram.messenger import ApplicationLoader
        return ApplicationLoader.applicationContext
    except Exception:
        return None


class VideoProbe:
    def __init__(self, path):
        self.path = path
        self.width = 0
        self.height = 0
        self.rotation = 0
        self.duration_ms = 0
        self.frame = None
        self.frame_time_us = 0
        self.ok = False

    def run(self):
        retriever = None
        try:
            retriever = MediaMetadataRetriever()
            retriever.setDataSource(self.path)
            self.width = self._meta(retriever, MediaMetadataRetriever.METADATA_KEY_VIDEO_WIDTH)
            self.height = self._meta(retriever, MediaMetadataRetriever.METADATA_KEY_VIDEO_HEIGHT)
            self.rotation = self._meta(retriever, MediaMetadataRetriever.METADATA_KEY_VIDEO_ROTATION)
            self.duration_ms = self._meta(retriever, MediaMetadataRetriever.METADATA_KEY_DURATION)
            if self.rotation in (90, 270):
                self.width, self.height = self.height, self.width
            self._fetch_frame(retriever, 0)
            self.ok = self.width > 0 and self.height > 0
        except Exception:
            pass
        finally:
            if retriever is not None:
                try:
                    retriever.release()
                except Exception:
                    pass
        return self.ok

    def _fetch_frame(self, retriever, time_us):
        try:
            self.frame = retriever.getFrameAtTime(int(time_us), MediaMetadataRetriever.OPTION_CLOSEST_SYNC)
        except Exception:
            self.frame = None
        if self.frame is None:
            try:
                self.frame = retriever.getFrameAtTime(int(time_us), MediaMetadataRetriever.OPTION_CLOSEST)
            except Exception:
                self.frame = None
        self.frame_time_us = int(time_us)

    def fetch_frame_at(self, time_us):
        retriever = None
        try:
            retriever = MediaMetadataRetriever()
            retriever.setDataSource(self.path)
            self._fetch_frame(retriever, time_us)
        except Exception:
            pass
        finally:
            if retriever is not None:
                try:
                    retriever.release()
                except Exception:
                    pass

    @staticmethod
    def _meta(retriever, key):
        try:
            raw = retriever.extractMetadata(key)
            return int(str(raw)) if raw is not None else 0
        except Exception:
            return 0


class CropModel:
    def __init__(self, width, height):
        self.width = max(1, width)
        self.height = max(1, height)
        self.center_x = 0.5
        self.center_y = 0.5
        self.zoom = MIN_ZOOM

    def side(self):
        return min(self.width, self.height) / self.zoom

    def clamp(self):
        half_w = (self.side() / 2.0) / self.width
        half_h = (self.side() / 2.0) / self.height
        self.center_x = min(max(self.center_x, half_w), 1.0 - half_w)
        self.center_y = min(max(self.center_y, half_h), 1.0 - half_h)

    def move(self, dx_frac, dy_frac):
        self.center_x += dx_frac
        self.center_y += dy_frac
        self.clamp()

    def set_zoom(self, value):
        self.zoom = min(max(float(value), MIN_ZOOM), MAX_ZOOM)
        self.clamp()

    def rect(self):
        side = self.side()
        left = self.center_x * self.width - side / 2.0
        top = self.center_y * self.height - side / 2.0
        return left, top, side

    def build_crop_state(self):
        left, top, side = self.rect()
        state = MediaController.CropState()
        center_x = (left + side / 2.0) / self.width - 0.5
        center_y = (top + side / 2.0) / self.height - 0.5
        values = (
            ("cropPx", float(-center_x)),
            ("cropPy", float(-center_y)),
            ("cropPw", float(side / self.width)),
            ("cropPh", float(side / self.height)),
            ("cropScale", 1.0),
            ("cropRotate", 0.0),
            ("transformWidth", ROUND_SIZE),
            ("transformHeight", ROUND_SIZE),
            ("transformRotation", 0),
            ("mirrored", False),
            ("width", int(self.width)),
            ("height", int(self.height)),
            ("freeform", False),
            ("lockedAspectRatio", 1.0),
            ("initied", True),
            ("useMatrix", None),
            ("stateScale", 1.0),
            ("scale", 1.0),
        )
        written = {}
        for name, value in values:
            written[name] = set_typed_field(state, name, value)
        return state


class PreviewPainter:
    def __init__(self, frame, model, size_px):
        self.frame = frame
        self.model = model
        self.size = max(64, int(size_px))
        self.canvas_bitmap = Bitmap.createBitmap(self.size, self.size, Bitmap.Config.ARGB_8888)
        self.paint = Paint()
        self.paint.setAntiAlias(True)
        self.shade = Paint()
        self.shade.setAntiAlias(True)
        self.shade.setARGB(150, 0, 0, 0)
        self.stroke = Paint()
        self.stroke.setAntiAlias(True)
        self.stroke.setStyle(Paint.Style.STROKE)
        self.stroke.setStrokeWidth(float(AndroidUtilities.dp(2)))
        self.stroke.setARGB(255, 255, 255, 255)

    def render(self):
        canvas = Canvas(self.canvas_bitmap)
        canvas.drawARGB(255, 0, 0, 0)

        if self.frame is not None:
            src = Rect(0, 0, self.frame.getWidth(), self.frame.getHeight())
            scale = min(
                float(self.size) / max(1, self.frame.getWidth()),
                float(self.size) / max(1, self.frame.getHeight()),
            )
            draw_w = int(self.frame.getWidth() * scale)
            draw_h = int(self.frame.getHeight() * scale)
            off_x = (self.size - draw_w) // 2
            off_y = (self.size - draw_h) // 2
            dst = Rect(off_x, off_y, off_x + draw_w, off_y + draw_h)
            canvas.drawBitmap(self.frame, src, dst, self.paint)
        else:
            off_x = 0
            off_y = 0
            draw_w = self.size
            draw_h = self.size

        radius = (min(draw_w, draw_h) / 2.0) / self.model.zoom
        cx = off_x + self.model.center_x * draw_w
        cy = off_y + self.model.center_y * draw_h

        hole = Path()
        hole.addCircle(float(cx), float(cy), float(radius), Path.Direction.CW)
        hole.setFillType(Path.FillType.INVERSE_WINDING)
        canvas.drawPath(hole, self.shade)
        canvas.drawCircle(float(cx), float(cy), float(radius), self.stroke)

        return self.canvas_bitmap

    def frame_box(self):
        if self.frame is None:
            return 0, 0, self.size, self.size
        scale = min(
            float(self.size) / max(1, self.frame.getWidth()),
            float(self.size) / max(1, self.frame.getHeight()),
        )
        draw_w = int(self.frame.getWidth() * scale)
        draw_h = int(self.frame.getHeight() * scale)
        return (self.size - draw_w) // 2, (self.size - draw_h) // 2, draw_w, draw_h


class DragListener(dynamic_proxy(View.OnTouchListener)):
    def __init__(self, sheet):
        super().__init__()
        self.sheet = sheet
        self.last_x = 0.0
        self.last_y = 0.0
        self.mode = None
        self.base_dist = 0.0
        self.base_zoom = MIN_ZOOM

    @staticmethod
    def _distance(event):
        try:
            dx = event.getX(0) - event.getX(1)
            dy = event.getY(0) - event.getY(1)
            return float((dx * dx + dy * dy) ** 0.5)
        except Exception:
            return 0.0

    def onTouch(self, view, event):
        try:
            action = event.getActionMasked()
            count = int(event.getPointerCount())

            if action == MotionEvent.ACTION_DOWN:
                self.last_x = event.getX()
                self.last_y = event.getY()
                self.mode = "pan"
                return True

            if action == MotionEvent.ACTION_POINTER_DOWN and count >= 2:
                self.base_dist = self._distance(event)
                self.base_zoom = self.sheet.model.zoom
                self.mode = "zoom"
                return True

            if action == MotionEvent.ACTION_MOVE:
                if self.mode == "zoom" and count >= 2:
                    current = self._distance(event)
                    if self.base_dist > 20.0 and current > 20.0:
                        self.sheet.on_zoom(self.base_zoom * self.base_dist / current)
                    return True
                if self.mode == "pan" and count == 1:
                    dx = event.getX() - self.last_x
                    dy = event.getY() - self.last_y
                    self.last_x = event.getX()
                    self.last_y = event.getY()
                    self.sheet.on_drag(dx, dy)
                    return True
                return True

            if action == MotionEvent.ACTION_POINTER_UP:
                if count <= 2:
                    remaining = 0 if int(event.getActionIndex()) == 1 else 1
                    try:
                        self.last_x = event.getX(remaining)
                        self.last_y = event.getY(remaining)
                    except Exception:
                        pass
                    self.mode = "pan"
                return True

            if action in (MotionEvent.ACTION_UP, MotionEvent.ACTION_CANCEL):
                self.mode = None
                return True
        except Exception:
            pass
        return False

class DismissProxy(dynamic_proxy(DialogInterface.OnDismissListener)):
    def __init__(self, sheet):
        super().__init__()
        self.sheet = sheet

    def onDismiss(self, dialog):
        self.sheet.dialog = None
        self.sheet.root = None
        if ACTIVE.get("sheet") is self.sheet:
            ACTIVE["sheet"] = None


class CropSheet:
    def __init__(self, probe, on_confirm):
        self.probe = probe
        self.on_confirm = on_confirm
        self.model = CropModel(probe.width, probe.height)
        self.painter = None
        self.image = None
        self.label = None
        self.root = None
        self.dialog = None
        self._keep_alive = []

    def show(self):
        ctx = context()
        if ctx is None:
            return False

        frag = get_last_fragment()
        activity = frag.getParentActivity() if frag is not None else None
        if activity is None:
            return False
        try:
            screen_w = int(AndroidUtilities.displaySize.x)
            screen_h = int(AndroidUtilities.displaySize.y)
        except Exception:
            screen_w = AndroidUtilities.dp(360)
            screen_h = AndroidUtilities.dp(640)

        canvas_side = min(screen_w, screen_h - AndroidUtilities.dp(180))
        self.painter = PreviewPainter(self.probe.frame, self.model, canvas_side)

        self.root = FrameLayout(ctx)
        self.root.setBackgroundColor(Color.argb(242, 0, 0, 0))
        self.root.setClickable(True)

        column = LinearLayout(ctx)
        column.setOrientation(LinearLayout.VERTICAL)
        column.setGravity(Gravity.CENTER_HORIZONTAL)

        self.label = TextView(ctx)
        self.label.setTextSize(14.0)
        self.label.setGravity(Gravity.CENTER)
        try:
            self.label.setTextColor(Color.argb(160, 255, 255, 255))
        except Exception:
            pass
        pad = AndroidUtilities.dp(18)
        self.label.setPadding(pad, pad, pad, AndroidUtilities.dp(10))
        column.addView(self.label, LinearLayout.LayoutParams(-1, -2))

        self.image = ImageView(ctx)
        self.image.setScaleType(ImageView.ScaleType.FIT_CENTER)
        drag = DragListener(self)
        self._keep_alive.append(drag)
        self.image.setOnTouchListener(drag)
        column.addView(self.image, LinearLayout.LayoutParams(canvas_side, canvas_side))

        hint = TextView(ctx)
        hint.setTextSize(13.0)
        hint.setGravity(Gravity.CENTER)
        try:
            hint.setTextColor(Color.argb(110, 255, 255, 255))
        except Exception:
            pass
        hint.setText(JString("Перетащите круг, двумя пальцами меняйте размер"))
        hint.setPadding(pad, AndroidUtilities.dp(14), pad, AndroidUtilities.dp(6))
        column.addView(hint, LinearLayout.LayoutParams(-1, -2))

        buttons = LinearLayout(ctx)
        buttons.setOrientation(LinearLayout.HORIZONTAL)
        buttons.addView(self._make_button(ctx, "Отмена", self._dismiss),
                        LinearLayout.LayoutParams(0, -2, 1.0))
        buttons.addView(self._make_button(ctx, "Отправить", self._confirm_and_close),
                        LinearLayout.LayoutParams(0, -2, 1.0))
        column.addView(buttons, LinearLayout.LayoutParams(-1, -2))

        self.root.addView(column, FrameLayout.LayoutParams(-1, -2, Gravity.CENTER))

        from android import R as AndroidR
        self.dialog = Dialog(activity, AndroidR.style.Theme_Translucent_NoTitleBar_Fullscreen)
        self.dialog.setContentView(self.root)
        self.dialog.setCanceledOnTouchOutside(False)
        dismiss_proxy = DismissProxy(self)
        self._keep_alive.append(dismiss_proxy)
        self.dialog.setOnDismissListener(dismiss_proxy)
        window = self.dialog.getWindow()
        if window is not None:
            window.setBackgroundDrawable(ColorDrawable(Color.argb(0, 0, 0, 0)))
            window.setLayout(-1, -1)
        self._keep_alive.append(self.root)
        self.refresh()
        self.root.setAlpha(0.0)
        self.dialog.show()
        try:
            fade = self.root.animate()
            fade.alpha(1.0)
            fade.setDuration(180)
            fade.start()
        except Exception:
            self.root.setAlpha(1.0)
        ACTIVE["sheet"] = self
        return True

    def _make_button(self, ctx, caption, handler):
        view = TextView(ctx)
        view.setText(JString(caption))
        view.setTextSize(15.0)
        view.setGravity(Gravity.CENTER)
        pad = AndroidUtilities.dp(14)
        view.setPadding(pad, pad, pad, pad)
        try:
            view.setTextColor(Theme.getColor(Theme.key_dialogTextBlue2))
        except Exception:
            pass
        listener = OnClickListener(handler)
        self._keep_alive.append(listener)
        view.setOnClickListener(listener)
        return view

    def _dismiss(self, *_):
        try:
            if self.dialog is not None:
                self.dialog.dismiss()
        except Exception:
            pass
        self.dialog = None
        self.root = None
        if ACTIVE.get("sheet") is self:
            ACTIVE["sheet"] = None

    def _confirm_and_close(self, *_):
        dismiss_popup()
        self.fade_out(delay=120)
        run_on_ui_thread(self.confirm, 400)

    def fade_out(self, delay=0):
        if self.root is None:
            return
        try:
            anim = self.root.animate()
            anim.alpha(0.0)
            anim.setDuration(200)
            anim.setStartDelay(int(delay))
            ending = ClickRunnable(self._dismiss)
            self._keep_alive.append(ending)
            anim.withEndAction(ending)
            anim.start()
        except Exception:
            self._dismiss()

    def refresh(self):
        try:
            bitmap = self.painter.render()
            self.image.setImageBitmap(bitmap)
            self.image.invalidate()
            side = int(self.model.side())
            self.label.setText(JString(f"Кружок {side}x{side} из {self.probe.width}x{self.probe.height}"))
        except Exception:
            pass

    def on_drag(self, dx_px, dy_px):
        off_x, off_y, draw_w, draw_h = self.painter.frame_box()
        if draw_w <= 0 or draw_h <= 0:
            return
        self.model.move(dx_px / float(draw_w), dy_px / float(draw_h))
        self.refresh()

    def on_zoom(self, value):
        self.model.set_zoom(value)
        self.refresh()

    def confirm(self):
        try:
            state = self.model.build_crop_state()
            self.on_confirm(self.probe, state, self.model.rect())
        except Exception:
            BulletinHelper.show_error("Не удалось собрать кружок")


def native_edited_info(path):
    cls = resolve_class("org.telegram.messenger.SendMessagesHelper")
    method = find_method(cls, "createCompressionSettings")
    if method is None:
        return None

    params = array_items(method.getParameterTypes())
    args = [JString(path)]
    for kind in params[1:]:
        name = kind.getName()
        if name == "long":
            args.append(JLong(0))
        elif name == "int":
            args.append(JInteger(0))
        elif name == "boolean":
            args.append(JBoolean(False))
        else:
            args.append(None)

    try:
        info = method.invoke(None, args)
        slog(f"createCompressionSettings -> {'ok' if info is not None else 'None'}")
        return info
    except Exception:
        slog("createCompressionSettings invoke failed")
        return None


def round_estimated_size(info, duration_ms):
    original_w = get_field(info, "originalWidth") or 0
    original_h = get_field(info, "originalHeight") or 0
    original_bitrate = get_field(info, "bitrate") or 0
    bitrate = None
    try:
        method = find_method(resolve_class("org.telegram.messenger.MediaController"),
                             "makeVideoBitrate", 5)
        if method is not None:
            bitrate = int(method.invoke(None, [
                JInteger(int(original_h)), JInteger(int(original_w)),
                JInteger(int(original_bitrate)),
                JInteger(ROUND_SIZE), JInteger(ROUND_SIZE)]))
    except Exception:
        pass
    if not bitrate:
        bitrate = 600000

    encoder = None
    try:
        method = find_method(resolve_class("org.telegram.messenger.MediaController"),
                             "extractRealEncoderBitrate", 4)
        if method is not None:
            encoder = int(method.invoke(None, [
                JInteger(ROUND_SIZE), JInteger(ROUND_SIZE),
                JInteger(bitrate), JBoolean(False)]))
    except Exception:
        pass
    if not encoder:
        encoder = bitrate

    seconds = max(0.1, float(duration_ms) / 1000.0)
    audio = seconds * 16000.0
    return bitrate, encoder, int(seconds * encoder / 8.0 + audio) + 1


def viewer_trim_window_ms(total_ms, expected_path):
    cls = resolve_class(PHOTO_VIEWER)
    if cls is None:
        return -1, -1
    try:
        has = find_method(cls, "hasInstance", 0)
        if has is not None and not bool(has.invoke(None, None)):
            return -1, -1
    except Exception:
        return -1, -1
    getter = find_method(cls, "getInstance", 0)
    if getter is None:
        return -1, -1
    try:
        viewer = getter.invoke(None, None)
    except Exception:
        return -1, -1
    if viewer is None:
        return -1, -1
    current = get_field(viewer, "currentPathObject")
    if current is None:
        slog("viewer closed (currentPathObject=None) -> no trim window")
        return -1, -1
    if expected_path is not None:
        try:
            if str(current) != str(expected_path):
                slog(f"viewer path mismatch: viewer={current} probe={expected_path}")
                return -1, -1
        except Exception:
            slog("viewer path compare failed")
            return -1, -1
    vis = get_field(viewer, "isVisible")
    if vis is not None and not bool(vis):
        slog("viewer not visible -> no trim window")
        return -1, -1
    start_raw = get_field(viewer, "startTime")
    end_raw = get_field(viewer, "endTime")
    try:
        start_us = int(start_raw)
    except Exception:
        start_us = -1
    try:
        end_us = int(end_raw)
    except Exception:
        end_us = -1
    if start_us < 0 and end_us <= 0:
        slog(f"viewer trim raw: start_us={start_us} end_us={end_us} -> no trim in viewer")
        return -1, -1
    start_ms = 0 if start_us < 0 else start_us // 1000
    end_ms = int(total_ms) if end_us <= 0 else end_us // 1000
    if end_ms > int(total_ms) + 500:
        return -1, -1
    return start_ms, end_ms


def build_edited_info(probe, crop_state):
    try:
        total = int(probe.duration_ms)
    except Exception:
        total = 0
    slog(f"build_edited_info: total={total} ms path={probe.path}")
    info = native_edited_info(probe.path)
    if info is None:
        cls = resolve_class("org.telegram.messenger.VideoEditedInfo")
        if cls is None:
            return None
        try:
            info = cls.newInstance()
        except Exception:
            return None
        for name, value in (
            ("originalWidth", probe.width),
            ("originalHeight", probe.height),
            ("rotationValue", probe.rotation),
            ("originalPath", probe.path),
            ("startTime", -1),
            ("endTime", -1),
            ("framerate", 30),
            ("bitrate", 900000),
            ("estimatedDuration", int(probe.duration_ms)),
            ("originalDuration", int(probe.duration_ms) * 1000),
        ):
            set_typed_field(info, name, value)

    total_ms = int(probe.duration_ms)
    start_ms, end_ms = viewer_trim_window_ms(total_ms, probe.path)
    if end_ms <= 0:
        if total_ms > ROUND_SAFE_MS:
            start_ms, end_ms = 0, int(total_ms)
        else:
            start_ms, end_ms = -1, -1
    if end_ms > 0:
        if end_ms - start_ms > ROUND_SAFE_MS:
            end_ms = start_ms + ROUND_SAFE_MS
        start_ms = max(0, int(start_ms))
        end_ms = min(int(end_ms), int(total_ms))
        if end_ms - start_ms < 1000:
            start_ms = max(0, end_ms - ROUND_SAFE_MS)
        if start_ms < ROUND_START_SHIFT_MS:
            start_ms = ROUND_START_SHIFT_MS
            if end_ms <= start_ms:
                end_ms = min(int(total_ms), start_ms + ROUND_SAFE_MS)
        start_us = start_ms * 1000
        end_us = end_ms * 1000
        written_start = set_typed_field(info, "startTime", start_us)
        written_end = set_typed_field(info, "endTime", end_us)
        try:
            ok_start = written_start is not None and int(written_start) == start_us
            ok_end = written_end is not None and int(written_end) == end_us
        except Exception:
            ok_start = ok_end = False
        if not (ok_start and ok_end):
            slog(f"trim window write failed: start={written_start} end={written_end}")
            return None
        set_typed_field(info, "estimatedDuration", int(end_ms - start_ms))
        duration = int(end_ms - start_ms)
        slog(f"trim window: {start_ms}-{end_ms} ms")
    else:
        duration = int(get_field(info, "estimatedDuration") or 0) or int(probe.duration_ms)
    bitrate, encoder, estimated = round_estimated_size(info, duration)

    max_est_size = 8388608
    if estimated > max_est_size:
        seconds = max(0.1, duration / 1000.0)
        audio_bytes = seconds * 16000.0
        cap = int(max(200000, (max_est_size - audio_bytes) * 8.0 / seconds))
        bitrate = min(bitrate, cap)
        encoder = min(encoder, cap)
        estimated = int(seconds * encoder / 8.0 + audio_bytes) + 1
        slog(f"size cap: est={estimated} bitrate={bitrate} encoder={encoder}")

    written = {}
    for name, value in (
        ("resultWidth", ROUND_SIZE),
        ("resultHeight", ROUND_SIZE),
        ("roundVideo", True),
        ("muted", False),
        ("bitrate", bitrate),
        ("estimatedSize", estimated),
    ):
        written[name] = set_typed_field(info, name, value)

    written["cropState"] = set_typed_field(info, "cropState", crop_state)

    slog(f"info fields: start={get_field(info, 'startTime')} end={get_field(info, 'endTime')} estDur={get_field(info, 'estimatedDuration')} round={written.get('roundVideo')} muted={written.get('muted')} estSize={written.get('estimatedSize')} crop={written.get('cropState') is not None}")


    if not bool(written.get("roundVideo")):
        return None

    need = find_method(info.getClass(), "needConvert", 0)
    if need is not None:
        try:
            pass
        except Exception:
            pass

    return info


HOSTS = {"alert": None, "popup": None, "preview": None, "dumped": False}


def dismiss_popup():
    window = HOSTS.get("popup")
    if window is not None:
        for name in ("dismiss", "dismissInternal"):
            method = find_method(window.getClass(), name, 0)
            if method is None:
                continue
            try:
                method.invoke(window, None)
                break
            except Exception:
                pass
    HOSTS["popup"] = None

    preview = HOSTS.get("preview")
    if preview is not None:
        for name in ("dismiss", "hide", "close"):
            method = find_method(preview.getClass(), name, 0)
            if method is None:
                continue
            try:
                method.invoke(preview, None)
                break
            except Exception:
                pass
    HOSTS["preview"] = None


def sibling_text_color(container):
    sub_cls = resolve_class("org.telegram.ui.ActionBar.ActionBarMenuSubItem")
    if sub_cls is None:
        return None
    for view in descendants(container):
        if not sub_cls.isInstance(view):
            continue
        label = get_field(view, "textView")
        if label is None:
            continue
        try:
            return int(label.getCurrentTextColor())
        except Exception:
            continue
    return None


def sibling_icon_color(container):
    sub_cls = resolve_class("org.telegram.ui.ActionBar.ActionBarMenuSubItem")
    if sub_cls is None:
        return None
    for view in descendants(container):
        if not sub_cls.isInstance(view):
            continue
        value = get_field(view, "iconColor")
        if value is None:
            continue
        try:
            return int(value)
        except Exception:
            continue
    return None


def item_icon_view(view):
    if view is None:
        return None
    icon = get_field(view, "imageView")
    if icon is not None:
        return icon
    image_cls = resolve_class("android.widget.ImageView")
    if image_cls is None:
        return None
    for sub in descendants(view):
        if image_cls.isInstance(sub):
            return sub
    return None


def item_text_color(view):
    if view is None:
        return None
    label = get_field(view, "textView")
    if label is None:
        text_cls = resolve_class("android.widget.TextView")
        if text_cls is not None:
            for sub in descendants(view):
                if text_cls.isInstance(sub):
                    label = sub
                    break
    if label is None:
        return None
    try:
        return int(label.getCurrentTextColor())
    except Exception:
        return None


def copy_icon_look(ours, sibling):
    if ours is None:
        return False
    ours_icon = item_icon_view(ours)
    if ours_icon is None:
        return False
    sib_icon = item_icon_view(sibling)
    if sib_icon is not None:
        try:
            flt = sib_icon.getColorFilter()
            if flt is not None:
                ours_icon.setColorFilter(flt)
                return True
        except Exception:
            pass
    color = item_text_color(sibling)
    if color is None:
        return False
    try:
        ours_icon.setColorFilter(PorterDuffColorFilter(color, PorterDuff.Mode.SRC_IN))
        return True
    except Exception:
        return False


def attach_alert_from_fragment():
    frag = get_last_fragment()
    if frag is None:
        return None
    for name in ("chatAttachAlert", "chatActivityAttachAlert", "attachAlert"):
        alert = get_field(frag, name)
        if alert is not None:
            return alert
    return None


def sender_visible():
    for alert in (HOSTS.get("alert"), attach_alert_from_fragment()):
        if alert is None:
            continue
        method = find_method(alert.getClass(), "isShowing", 0)
        if method is None:
            continue
        try:
            if bool(method.invoke(alert, None)):
                return True
        except Exception:
            continue

    cls = resolve_class(PHOTO_VIEWER)
    if cls is not None:
        has = find_method(cls, "hasInstance", 0)
        try:
            if has is None or bool(has.invoke(None, None)):
                getter = find_method(cls, "getInstance", 0)
                if getter is not None:
                    viewer = getter.invoke(None, None)
                    visible = find_method(cls, "isVisible", 0)
                    if visible is not None and bool(visible.invoke(viewer, None)):
                        return True
        except Exception:
            pass
    return False

def photo_layout(alert):
    if alert is None:
        return None
    getter = find_method(alert.getClass(), "getPhotoLayout", 0)
    if getter is not None:
        try:
            layout = getter.invoke(alert, None)
            if layout is not None:
                return layout
        except Exception:
            pass
    for name in ("photoLayout", "attachPhotoLayout"):
        layout = get_field(alert, name)
        if layout is not None:
            return layout
    return None


def clear_attach_selection(alert):
    if alert is None:
        return False
    cleared = False
    layout = photo_layout(alert)
    if layout is not None:
        method = find_method(layout.getClass(), "clearSelectedPhotos", 2)
        if method is not None:
            for flag in ((True, True), (True, False), (False, True)):
                try:
                    method.invoke(layout, [JBoolean(flag[0]), JBoolean(flag[1])])
                    cleared = True
                    break
                except Exception:
                    continue
        getter = find_method(layout.getClass(), "getSelectedPhotos", 0)
        if getter is not None:
            try:
                selected = getter.invoke(layout, None)
                if selected is not None and not selected.isEmpty():
                    selected.clear()
                    cleared = True
            except Exception:
                pass
        order_getter = find_method(layout.getClass(), "getSelectedPhotosOrder", 0)
        if order_getter is not None:
            try:
                order = order_getter.invoke(layout, None)
                if order is not None and not order.isEmpty():
                    order.clear()
                    cleared = True
            except Exception:
                pass
        for name in ("selectedPhotos", "selectedPhotosOrder", "photos"):
            container = get_field(layout, name)
            if container is not None:
                try:
                    container.clear()
                    cleared = True
                except Exception:
                    pass
        if cleared:
            updater = find_method(layout.getClass(), "updatePhotosButton", 2)
            if updater is not None:
                try:
                    updater.invoke(layout, [JBoolean(False), JBoolean(False)])
                except Exception:
                    pass
    for name in ("selectedPhotos", "selectedPhotosOrder", "photos"):
        container = get_field(alert, name)
        if container is not None:
            try:
                container.clear()
                cleared = True
            except Exception:
                pass
    return cleared


def close_hosts():
    cls = resolve_class(PHOTO_VIEWER)
    if cls is not None:
        has = find_method(cls, "hasInstance", 0)
        alive = True
        if has is not None:
            try:
                alive = bool(has.invoke(None, None))
            except Exception:
                alive = True
        if alive:
            getter = find_method(cls, "getInstance", 0)
            if getter is not None:
                try:
                    viewer = getter.invoke(None, None)
                    closer = find_method(viewer.getClass(), "closePhoto", 2)
                    if closer is not None:
                        closer.invoke(viewer, [JBoolean(False), JBoolean(False)])
                    else:
                        pass
                except Exception:
                    pass

    alert = HOSTS.get("alert")
    if alert is None:
        alert = attach_alert_from_fragment()

    if alert is not None:
        clear_attach_selection(alert)
        closed = False
        for name in ("dismissInternal", "dismiss", "hide"):
            method = find_method(alert.getClass(), name, 0)
            if method is None:
                continue
            try:
                method.invoke(alert, None)
                closed = True
                break
            except Exception:
                pass

    frag = get_last_fragment()
    if frag is not None:
        if alert is None:
            live = attach_alert_from_fragment()
            if live is not None:
                clear_attach_selection(live)
        for name in ("dismissCurrentDialog", "closeChatAttachAlert"):
            method = find_method(frag.getClass(), name, 0)
            if method is None:
                continue
            try:
                method.invoke(frag, None)
                break
            except Exception:
                continue


def find_static_send():
    cls = resolve_class("org.telegram.messenger.SendMessagesHelper")
    if cls is None:
        return None, 0
    best = None
    best_count = 0
    try:
        methods = array_items(cls.getDeclaredMethods())
    except Exception:
        methods = []
    for m in methods:
        try:
            if m.getName() != "prepareSendingVideo":
                continue
            count = JArray.getLength(m.getParameterTypes())
            if best is None or count < best_count:
                best = m
                best_count = count
        except Exception:
            continue
    if best is not None:
        try:
            best.setAccessible(True)
        except Exception:
            pass
    return best, best_count


def resolve_dialog_id(frag):
    for name in ("dialog_id", "dialogId"):
        value = get_field(frag, name)
        if value:
            try:
                return int(value)
            except Exception:
                continue
    method = find_method(frag.getClass(), "getDialogId", 0)
    if method is not None:
        try:
            return int(method.invoke(frag, None))
        except Exception:
            pass
    return 0


def square_thumb(frame, rect, size=320):
    if frame is None or rect is None:
        return None
    try:
        left, top, side = rect
        left = max(0, min(int(left), frame.getWidth() - 1))
        top = max(0, min(int(top), frame.getHeight() - 1))
        side = max(1, min(int(side), frame.getWidth() - left, frame.getHeight() - top))
        cut = Bitmap.createBitmap(frame, left, top, side, side)
        scaled = Bitmap.createScaledBitmap(cut, size, size, True)
        try:
            from org.telegram.messenger import Utilities
            Utilities.blurBitmap(scaled, 3, 1, scaled.getWidth(),
                                 scaled.getHeight(), scaled.getRowBytes())
        except Exception:
            pass
        return scaled
    except Exception:
        return None


def replace_round_thumb(frame, rect):
    bitmap = square_thumb(frame, rect)
    if bitmap is None:
        return

    frag = get_last_fragment()
    messages = get_field(frag, "messages") if frag is not None else None
    if messages is None:
        return
    try:
        msg = messages.get(0)
    except Exception:
        return

    owner = get_field(msg, "messageOwner")
    media = get_field(owner, "media") if owner is not None else None
    document = get_field(media, "document") if media is not None else None
    if document is None:
        return
    try:
        thumbs = document.thumbs
        if int(thumbs.size()) == 0:
            return
        size = thumbs.get(0)
    except Exception:
        return

    location = get_field(size, "location")
    volume = get_field(location, "volume_id") if location is not None else None
    local = get_field(location, "local_id") if location is not None else None

    try:
        side_dp = int(AndroidUtilities.roundMessageSize / AndroidUtilities.density)
        key = f"{volume}_{local}@{side_dp}_{side_dp}_b"
        from org.telegram.messenger import ImageLoader
        drawable = BitmapDrawable(bitmap)
        ImageLoader.getInstance().putImageToCache(drawable, key, False)
    except Exception:
        pass

    try:
        account = UserConfig.selectedAccount
        path = FileLoader.getInstance(account).getPathToAttach(size, True)
        if path is not None:
            from java.io import FileOutputStream
            stream = FileOutputStream(path)
            bitmap.compress(Bitmap.CompressFormat.JPEG, 87, stream)
            stream.close()
    except Exception:
        pass

    for name in ("chatAdapter", "chatListView"):
        holder = get_field(frag, name)
        if holder is None:
            continue
        method = find_method(holder.getClass(), "notifyDataSetChanged", 0)
        if method is None:
            continue
        try:
            method.invoke(holder, None)
            break
        except Exception:
            pass


def topic_pair(instance, frag, dialog_id):
    topic_id = 0
    try:
        method = find_method(frag.getClass(), "getTopicId", 0)
        if method is not None:
            topic_id = int(method.invoke(frag, None) or 0)
    except Exception:
        topic_id = 0
    if not topic_id:
        return None, None

    try:
        method = find_method(frag.getClass(), "getThreadMessage", 0)
        if method is not None:
            thread = method.invoke(frag, None)
            if thread is not None:
                if not bool(get_field(thread, "isTopicMainMessage") or False):
                    set_typed_field(thread, "isTopicMainMessage", True)
                return thread, thread
    except Exception:
        pass

    try:
        mc = instance.getMessagesController()
        topics = mc.getTopicsController()
        finder = find_method(topics.getClass(), "findTopic", 2)
        if finder is None:
            return None, None
        topic = finder.invoke(topics, [JLong.valueOf(-int(dialog_id)), JLong.valueOf(int(topic_id))])
        start = get_field(topic, "topicStartMessage") if topic is not None else None
        if start is None:
            return None, None
        mo_cls = resolve_class("org.telegram.messenger.MessageObject")
        ctor = None
        for candidate in array_items(mo_cls.getDeclaredConstructors()):
            kinds = [p.getName() for p in candidate.getParameterTypes()]
            if kinds == ["int", "org.telegram.tgnet.TLRPC$Message", "boolean", "boolean"]:
                ctor = candidate
                break
        if ctor is None:
            return None, None
        ctor.setAccessible(True)
        mo = ctor.newInstance([JInteger(int(UserConfig.selectedAccount)), start, JBoolean(False), JBoolean(False)])
        set_typed_field(mo, "isTopicMainMessage", True)
        return mo, mo
    except Exception:
        return None, None


def send_round(probe, crop_state, rect=None):
    frag = get_last_fragment()
    if frag is None:
        BulletinHelper.show_error("Нет открытого чата")
        return False

    dialog_id = resolve_dialog_id(frag)
    if not dialog_id:
        BulletinHelper.show_error("Не понял, в какой чат отправлять")
        return False

    info = build_edited_info(probe, crop_state)
    if info is None:
        BulletinHelper.show_error("Не удалось подготовить видео")
        return False

    method, count = find_static_send()
    if method is None:
        BulletinHelper.show_error("Метод отправки не найден")
        return False
    slog(f"prepareSendingVideo: params={count}")


    account = UserConfig.selectedAccount
    try:
        instance = AccountInstance.getInstance(account)
    except Exception:
        BulletinHelper.show_error("Не удалось получить аккаунт")
        return False

    topic_msg, topic_top = topic_pair(instance, frag, dialog_id)

    args = [
        instance,
        JString(probe.path),
        info,
        None,
        None,
        JLong(int(dialog_id)),
        topic_msg,
        topic_top,
        None,
        None,
        None,
        JInteger(0),
        None,
        JBoolean(True),
        JInteger(0),
        JInteger(0),
        JBoolean(False),
        JBoolean(False),
        None,
        None,
        JInteger(0),
        JLong(0),
        JLong(0),
    ]

    if count > len(args):
        params = array_items(method.getParameterTypes())
        for index in range(len(args), count):
            kind = params[index].getName() if index < len(params) else ""
            if kind == "boolean":
                args.append(JBoolean(False))
            elif kind == "int":
                args.append(JInteger(0))
            elif kind == "long":
                args.append(JLong(0))
            else:
                args.append(None)
    elif count < len(args):
        args = args[:count]

    def fire():
        try:
            method.invoke(None, args)
            slog("prepareSendingVideo invoked ok")
            run_on_ui_thread(close_hosts, 60)
        except Exception:
            slog("prepareSendingVideo invoke failed")

    try:
        run_on_ui_thread(fire, 0)
        run_on_ui_thread(lambda: replace_round_thumb(probe.frame, rect), 700)
    except Exception:
        fire()
    return True

class ButtonSeekHook(MethodHook):
    def __init__(self, plugin, field_name):
        super().__init__()
        self.plugin = plugin
        self.field_name = field_name
        self.done = False

    def after_hooked_method(self, param):
        try:
            if self.field_name == "writeButton":
                HOSTS["alert"] = param.thisObject
                if not HOSTS.get("dumped"):
                    HOSTS["dumped"] = True
        except Exception:
            pass
        if self.done:
            return
        try:
            cls = listener_class(param.thisObject, self.field_name)
            if cls is None:
                return
            method = find_method(cls, "onLongClick", 1)
            if method is None:
                return
            ref = self.plugin.hook_method(method, SendLongClickHook())
            if ref is not None:
                self.plugin._hooks.append(ref)
                self.done = True
        except Exception:
            pass

ATTACH_ALERT = "org.telegram.ui.Components.ChatAttachAlert"
PHOTO_VIEWER = "org.telegram.ui.PhotoViewer"
POPUP_WINDOW = "org.telegram.ui.ActionBar.ActionBarPopupWindow"

ARMED = {"active": False, "path": None}
INJECT_TAG = "circlet_item"

SEND_PREVIEW = "org.telegram.ui.MessageSendPreview"

ICON_CANDIDATES = ("msg_round", "input_video", "msg_videocall", "chats_video", "msg_video")

_ICON_CACHE = [None]


def round_icon():
    if _ICON_CACHE[0] is not None:
        return _ICON_CACHE[0]
    res = 0
    try:
        from org.telegram.messenger import ApplicationLoader
        ctx = ApplicationLoader.applicationContext
        pkg = ctx.getPackageName()
        for name in ICON_CANDIDATES:
            try:
                found = int(ctx.getResources().getIdentifier(name, "drawable", pkg))
            except Exception:
                found = 0
            if found:
                res = found
                break
        if not res:
            pass
    except Exception:
        pass
    _ICON_CACHE[0] = res
    return res


def theme_color(*names):
    for name in names:
        try:
            key = getattr(Theme, name, None)
            if key is None:
                continue
            return int(Theme.getColor(key))
        except Exception:
            continue
    return None


def apply_submenu_colors(item, neighbour=None, icon=None):
    text = neighbour
    if text is None:
        text = theme_color("key_actionBarDefaultSubmenuItem", "key_dialogTextBlack")
    if icon is None:
        icon = text
    if text is None or icon is None:
        return
    method = find_method(item.getClass(), "setColors", 2)
    if method is None:
        return
    try:
        method.invoke(item, [JInteger(text), JInteger(icon)])
    except Exception:
        pass


class ClickRunnable(dynamic_proxy(JRunnable)):
    def __init__(self, handler):
        super().__init__()
        self.handler = handler

    def run(self):
        try:
            self.handler()
        except Exception:
            pass


def resolve_send_path():
    alert = attach_alert_from_fragment()
    if alert is not None:
        path = selected_video_path(alert)
        if path:
            return path
    path = photoviewer_path()
    if path:
        return path
    if ARMED["active"]:
        path = ARMED["path"]
        if path:
            return path
    frag = get_last_fragment()
    if frag is not None:
        for name in ("chatAttachAlert", "chatActivityAttachAlert"):
            holder = get_field(frag, name)
            if holder is None:
                continue
            path = selected_video_path(holder)
            if path:
                return path
    return None


class SendPreviewHook(MethodHook):
    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            args = param.args
            if args is None or len(args) < 1 or args[0] is None:
                return
            options = args[0]

            HOSTS["preview"] = param.thisObject

            path = resolve_send_path()
            if not path:
                return

            add = None
            for count in (3, 4):
                add = find_method(options.getClass(), "add", count)
                if add is not None:
                    break
            if add is None:
                return

            runnable = ClickRunnable(lambda: self.plugin.open_from_send_ui())
            self.plugin.keep(runnable)

            params = array_items(add.getParameterTypes())
            call = []
            for spec in params:
                kind = spec.getName()
                if kind == "int":
                    call.append(JInteger(round_icon()))
                elif kind == "java.lang.Runnable":
                    call.append(runnable)
                elif kind == "boolean":
                    call.append(JBoolean(False))
                else:
                    call.append(JString("Отправить кружком"))
            add.invoke(options, call)
            tint_last_icon(options)
        except Exception:
            pass


def descendants(view, depth=0):
    out = [view]
    if depth > 6:
        return out
    try:
        count = int(view.getChildCount())
    except Exception:
        return out
    for i in range(count):
        try:
            out.extend(descendants(view.getChildAt(i), depth + 1))
        except Exception:
            continue
    return out


def tint_last_icon(options):
    items = get_field(options, "items")
    if items is not None:
        try:
            views = [v for v in array_items(items.toArray())
                     if v is not None and hasattr(v, "getChildCount")]
        except Exception:
            views = []
        if len(views) >= 2 and copy_icon_look(views[-1], views[-2]):
            return

    root = None
    for name in ("linearLayout", "layout", "lastLayout", "windowView"):
        candidate = get_field(options, name)
        if candidate is not None and hasattr(candidate, "getChildCount"):
            root = candidate
            break

    image_cls = resolve_class("android.widget.ImageView")
    images = []
    if root is not None and image_cls is not None:
        images = [v for v in descendants(root) if image_cls.isInstance(v)]
    if len(images) >= 2:
        try:
            flt = images[-2].getColorFilter()
            if flt is not None:
                images[-1].setColorFilter(flt)
                return
        except Exception:
            pass

    color = sibling_text_color(root) if root is not None else None
    if color is None and root is not None:
        color = sibling_icon_color(root)
    if color is None:
        color = theme_color("key_actionBarDefaultSubmenuItem", "key_dialogTextBlack")
    if color is None:
        color = Color.argb(255, 255, 255, 255)

    if images:
        try:
            images[-1].setColorFilter(PorterDuffColorFilter(color, PorterDuff.Mode.SRC_IN))
            return
        except Exception:
            pass

    sub_cls = resolve_class("org.telegram.ui.ActionBar.ActionBarMenuSubItem")
    if root is not None and sub_cls is not None:
        subs = [v for v in descendants(root) if sub_cls.isInstance(v)]
        if subs:
            method = find_method(subs[-1].getClass(), "setColors", 2)
            if method is not None:
                try:
                    method.invoke(subs[-1], [JInteger(color), JInteger(color)])
                except Exception:
                    pass


def listener_class(holder, field_name):
    view = get_field(holder, field_name)
    if view is None:
        return None
    for name in ("mOnLongClickListener", "onLongClickListener"):
        listener = get_field(view, name)
        if listener is None:
            info = get_field(view, "mListenerInfo")
            if info is not None:
                listener = get_field(info, "mOnLongClickListener")
        if listener is not None:
            try:
                return listener.getClass()
            except Exception:
                continue
    return None


def selected_video_path(alert):
    layout = photo_layout(alert)
    if layout is None:
        return None
    method = find_method(layout.getClass(), "getSelectedPhotos", 0)
    if method is None:
        return None
    try:
        selected = method.invoke(layout, None)
        if selected is None:
            return None
        values = selected.values().toArray()
        for entry in array_items(values):
            raw = get_field(entry, "path")
            if not raw:
                continue
            candidate = str(raw)
            if candidate.lower().endswith((".mp4", ".mov", ".mkv", ".webm", ".3gp", ".avi")):
                return candidate
    except Exception:
        pass
    return None


def is_video_path(path):
    return bool(path) and str(path).lower().endswith((".mp4", ".mov", ".mkv", ".webm", ".3gp", ".avi"))


def photoviewer_path():
    cls = resolve_class(PHOTO_VIEWER)
    if cls is None:
        return None

    has = find_method(cls, "hasInstance", 0)
    if has is not None:
        try:
            if not bool(has.invoke(None, None)):
                return None
        except Exception:
            pass

    getter = find_method(cls, "getInstance", 0)
    if getter is None:
        return None
    try:
        viewer = getter.invoke(None, None)
    except Exception:
        return None
    if viewer is None:
        return None

    raw = get_field(viewer, "currentPathObject")
    if is_video_path(raw):
        return str(raw)

    entries = get_field(viewer, "imagesArrLocals")
    index = get_field(viewer, "currentIndex")
    if entries is not None:
        try:
            size = int(entries.size())
            pos = int(index) if index is not None else 0
            if 0 <= pos < size:
                entry = entries.get(pos)
                candidate = get_field(entry, "path")
                if is_video_path(candidate):
                    return str(candidate)
            for pos in range(size):
                candidate = get_field(entries.get(pos), "path")
                if is_video_path(candidate):
                    return str(candidate)
        except Exception:
            pass

    return None


class SendLongClickHook(MethodHook):
    def before_hooked_method(self, param):
        try:
            ARMED["active"] = False
            ARMED["path"] = None
            holder = get_surrounding(param.thisObject)
            if holder is None:
                return
            path = selected_video_path(holder)
            if not path:
                path = photoviewer_path()
            if path:
                ARMED["active"] = True
                ARMED["path"] = path
            else:
                pass
        except Exception:
            pass


def get_surrounding(obj):
    cls = obj.getClass()
    try:
        fields = array_items(cls.getDeclaredFields())
    except Exception:
        fields = []
    for f in fields:
        try:
            name = f.getName()
            if name.startswith("this$"):
                f.setAccessible(True)
                return f.get(obj)
        except Exception:
            continue
    return None


class PopupShowHook(MethodHook):
    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin

    def before_hooked_method(self, param):
        try:
            if not sender_visible():
                return
            if not resolve_send_path():
                return
            window = param.thisObject
            HOSTS["popup"] = window
            content = None
            for name in ("contentView", "mContentView"):
                content = get_field(window, name)
                if content is not None:
                    break
            if content is None:
                return

            tag = None
            try:
                tag = content.getTag()
            except Exception:
                pass
            if tag is not None and str(tag) == INJECT_TAG:
                return

            ctx = content.getContext()
            neighbour = sibling_text_color(content)
            icon = sibling_icon_color(content)
            if icon is None:
                icon = neighbour
            item = ActionBarMenuSubItem(ctx, False, False)
            item.setTextAndIcon(JString("Отправить кружком"), round_icon())
            apply_submenu_colors(item, neighbour, icon)
            listener = OnClickListener(lambda *_: self.plugin.open_from_send_ui())
            self.plugin.keep(listener)
            item.setOnClickListener(listener)
            content.addView(item)
            try:
                content.setTag(JString(INJECT_TAG))
            except Exception:
                pass
        except Exception:
            pass


class CircletPlugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self._pending = None
        self._hooks = []
        self._keep = []

    def keep(self, obj):
        self._keep.append(obj)

    def on_plugin_load(self):
        try:
            self._hook_attach_flow()
        except Exception:
            pass

    def _hook_attach_flow(self):
        popup_cls = resolve_class(POPUP_WINDOW)
        if popup_cls is not None:
            method = find_method(popup_cls, "showAtLocation", 4)
            if method is not None:
                try:
                    ref = self.hook_method(method, PopupShowHook(self))
                    if ref is not None:
                        self._hooks.append(ref)
                except Exception:
                    pass
            else:
                pass

        for cls_name, field in ((ATTACH_ALERT, "writeButton"),
                                (PHOTO_VIEWER, "pickerViewSendButton")):
            cls = resolve_class(cls_name)
            if cls is None:
                continue
            try:
                refs = self.hook_all_constructors(cls, ButtonSeekHook(self, field))
                count = len(list(refs or []))
                self._hooks.extend(list(refs or []))
            except Exception:
                pass

        preview_cls = resolve_class(SEND_PREVIEW)
        if preview_cls is not None:
            method = find_method(preview_cls, "setItemOptions", 1)
            if method is not None:
                try:
                    ref = self.hook_method(method, SendPreviewHook(self))
                    if ref is not None:
                        self._hooks.append(ref)
                except Exception:
                    pass
            else:
                pass
        else:
            pass

        self._hook_live_viewer()

    def _hook_live_viewer(self):
        cls = resolve_class(PHOTO_VIEWER)
        if cls is None:
            return
        has = find_method(cls, "hasInstance", 0)
        if has is not None:
            try:
                if not bool(has.invoke(None, None)):
                    return
            except Exception:
                pass
        getter = find_method(cls, "getInstance", 0)
        if getter is None:
            return
        try:
            viewer = getter.invoke(None, None)
        except Exception:
            return
        if viewer is None:
            return
        listener_cls = listener_class(viewer, "pickerViewSendButton")
        if listener_cls is None:
            return
        method = find_method(listener_cls, "onLongClick", 1)
        if method is None:
            return
        try:
            ref = self.hook_method(method, SendLongClickHook())
            if ref is not None:
                self._hooks.append(ref)
        except Exception:
            pass

    def on_plugin_unload(self):
        for ref in list(self._hooks):
            try:
                self.unhook_method(ref)
            except Exception:
                pass
        self._hooks = []
        self._keep = []
        self._pending = None
        ARMED["active"] = False
        ARMED["path"] = None

    def open_from_send_ui(self):
        path = resolve_send_path()
        if not path:
            BulletinHelper.show_error("Не нашёл выбранное видео")
            return False
        return self.open_for_path(path)

    def open_for_path(self, path):
        existing = ACTIVE.get("sheet")
        if existing is not None:
            dialog = existing.dialog
            showing = False
            if dialog is not None:
                try:
                    showing = bool(dialog.isShowing())
                except Exception:
                    showing = False
            if showing:
                return False
            ACTIVE["sheet"] = None

        if not path or not os.path.exists(path):
            BulletinHelper.show_error("Файл не найден")
            return False

        probe = VideoProbe(path)
        if not probe.run():
            BulletinHelper.show_error("Не удалось прочитать размеры видео")
            return False
        slog(f"probe ok: {probe.width}x{probe.height} dur={probe.duration_ms} ms")
        try:
            vw_start, vw_end = viewer_trim_window_ms(int(probe.duration_ms), path)
        except Exception:
            vw_start, vw_end = -1, -1
        if vw_end > 0 and vw_start > 0:
            probe.fetch_frame_at(vw_start * 1000)
            slog(f"preview frame re-fetched at {vw_start} ms")

        sheet = CropSheet(probe, send_round)
        self._pending = sheet
        return sheet.show()
