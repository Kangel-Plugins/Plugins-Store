ARMED = {"active": False, "path": None, "mo": None, "doc": None}
INJECT_TAG = "circlet_item"

SEND_PREVIEW = "org.telegram.ui.MessageSendPreview"

ICON_CANDIDATES = ("msg_round", "input_video", "msg_videocall", "chats_video", "msg_video")

_ICON_CACHE = [None]


_VOICE_CACHE = [None]


def voice_icon():
    if _VOICE_CACHE[0] is not None:
        return _VOICE_CACHE[0]
    res = 0
    try:
        from org.telegram.messenger import ApplicationLoader
        ctx = ApplicationLoader.applicationContext
        pkg = ctx.getPackageName()
        for name in ("input_mic", "msg_tabs_mic1", "preview_mic", "msg_voice", "voice_outlined"):
            try:
                found = int(ctx.getResources().getIdentifier(name, "drawable", pkg))
            except Exception:
                found = 0
            if found:
                res = found
                break
    except Exception as _exc:
        slog(f"voice_icon: {_exc}")
    _VOICE_CACHE[0] = res
    return res


def menu_icon(path):
    if media_kind(path) == "audio":
        icon = voice_icon()
        if icon:
            return icon
    return round_icon()


