def boot_log(message):
    if not DEV_BUILD:
        return
    text = str(message)
    try:
        from android.util import Log
        Log.i("Circlet", text)
    except Exception:
        pass
    try:
        print(text)
    except Exception:
        pass


boot_log("BOOT v2 start")

ONCE_TTL = 0x7FFFFFFF
ROUND_SIZE = 384
ROUND_SAFE_MS = 59990
ROUND_START_SHIFT_MS = 100
PREVIEW_DP = 240
MIN_ZOOM = 1.0
MAX_ZOOM = 4.0

_CLASS_CACHE = {}
_METHOD_CACHE = {}


def slog(message):
    try:
        boot_log("[Circlet] " + str(message))
    except Exception:
        pass


def app_language():
    cached = getattr(app_language, "_cache", None)
    if cached:
        return cached
    lang = "en"
    try:
        lc = LocaleController.getInstance()
        method = None
        for m in lc.getClass().getMethods():
            if m.getName() == "getString" and len(m.getParameterTypes()) >= 1 and m.getParameterTypes()[0].getName() == "java.lang.String":
                method = m
                break
        cyr = 0
        total = 0
        if method is not None:
            method.setAccessible(True)
            for key in ("Save", "Cancel", "Next", "Delete", "Send"):
                try:
                    text = str(method.invoke(lc, [JString(key)]))
                    total += 1
                    if any("\u0400" <= ch <= "\u04FF" for ch in text):
                        cyr += 1
                except Exception:
                    continue
        if total > 0 and cyr * 2 >= total:
            lang = "ru"
    except Exception:
        lang = "en"
    try:
        info = LocaleController.getInstance().getCurrentLocaleInfo()
        if str(info.shortName).lower().startswith("ru"):
            lang = "ru"
    except Exception:
        pass
    app_language._cache = lang
    return lang


def toast(text):
    try:
        ctx = context()
        if ctx is None:
            return
        from android.widget import Toast
        t = Toast.makeText(ctx, JString(text), Toast.LENGTH_SHORT)
        t.show()
    except Exception:
        pass


def localized(ru, en):
    return ru if app_language() == "ru" else en


def resolve_class(name):
    if name in _CLASS_CACHE:
        return _CLASS_CACHE[name]
    cls = None
    try:
        cls = JClass.forName(name)
    except Exception:
        try:
            from hook_utils import find_class
            raw = find_class(name)
            if raw is not None:
                cls = raw if hasattr(raw, "getName") else raw.getClass()
        except Exception:
            cls = None
    _CLASS_CACHE[name] = cls
    return cls


def array_items(arr):
    if arr is None:
        return []
    try:
        n = JArray.getLength(arr)
        return [JArray.get(arr, i) for i in range(n)]
    except Exception:
        return []


def find_method(cls, name, param_count=None):
    if cls is None:
        return None
    key = (getattr(cls, "getName", lambda: str(cls))(), name, param_count)
    if key in _METHOD_CACHE:
        return _METHOD_CACHE[key]

    by_count = None
    by_name = None
    methods = []
    walker = cls
    while walker is not None:
        methods.extend(array_items(walker.getDeclaredMethods()))
        try:
            walker = walker.getSuperclass()
        except Exception:
            walker = None

    for m in methods:
        try:
            if m.getName() != name:
                continue
            if by_name is None:
                by_name = m
            count = JArray.getLength(m.getParameterTypes())
            if param_count is not None and count == param_count and by_count is None:
                by_count = m
        except Exception:
            continue

    chosen = by_name if param_count is None else by_count
    if chosen is not None:
        try:
            chosen.setAccessible(True)
        except Exception:
            pass
    _METHOD_CACHE[key] = chosen
    return chosen

def set_typed_field(obj, name, value):
    cls = obj.getClass()
    while cls is not None:
        try:
            f = cls.getDeclaredField(name)
        except Exception:
            try:
                cls = cls.getSuperclass()
                continue
            except Exception:
                return None
        try:
            f.setAccessible(True)
            kind = f.getType().getName()
            if kind == "boolean":
                f.setBoolean(obj, bool(value))
            elif kind == "int":
                f.setInt(obj, int(value))
            elif kind == "long":
                f.setLong(obj, int(value))
            elif kind == "float":
                f.setFloat(obj, float(value))
            elif kind == "double":
                f.setDouble(obj, float(value))
            elif kind == "java.lang.String":
                f.set(obj, JString(str(value)))
            else:
                f.set(obj, value)
            return f.get(obj)
        except Exception:
            return None
    return None


_FIELD_CACHE = {}
_FIELDS_CACHE = {}


def _cached_field(cls, name):
    key = (cls.getName(), name)
    if key in _FIELD_CACHE:
        return _FIELD_CACHE[key]
    walker = cls
    found = None
    while walker is not None:
        try:
            f = walker.getDeclaredField(name)
            f.setAccessible(True)
            found = f
            break
        except Exception:
            try:
                walker = walker.getSuperclass()
            except Exception:
                break
    _FIELD_CACHE[key] = found
    return found


def _cached_fields(cls):
    key = cls.getName()
    if key in _FIELDS_CACHE:
        return _FIELDS_CACHE[key]
    try:
        result = array_items(cls.getDeclaredFields())
    except Exception:
        result = []
    _FIELDS_CACHE[key] = result
    return result


def get_field(obj, name, default=None):
    if obj is None:
        return default
    try:
        f = _cached_field(obj.getClass(), name)
        if f is not None:
            return f.get(obj)
    except Exception:
        pass
    return default


def _circlet_cache_dir():
    try:
        from org.telegram.messenger import ApplicationLoader
        ctx = ApplicationLoader.applicationContext
        d = ctx.getExternalFilesDir(None)
        base = str(d.getAbsolutePath()) if d is not None else str(ctx.getCacheDir().getAbsolutePath())
        sub = base + "/Circlet"
        if not os.path.exists(sub):
            os.makedirs(sub)
        return sub
    except Exception:
        return str(AndroidUtilities.getCacheDir())

_CIRCLET_OGG_NAME = re.compile(r"^circlet_[0-9a-f]{32}\.ogg$")


def clean_old_voice_files(days=30):
    folder = _circlet_cache_dir()
    cutoff = time.time() - int(days) * 86400
    removed = 0
    freed = 0
    failed = 0

    for name in os.listdir(folder):
        if not _CIRCLET_OGG_NAME.fullmatch(name):
            continue

        path = os.path.join(folder, name)

        try:
            if os.path.islink(path) or not os.path.isfile(path):
                continue

            stat = os.stat(path)
            if stat.st_mtime >= cutoff:
                continue

            with _VOICE_ONCE_LOCK:
                if path in _VOICE_ONCE_PATHS:
                    continue

            os.remove(path)
            removed += 1
            freed += stat.st_size
        except Exception as e:
            failed += 1
            slog(f"voice cleanup failed for {name}: {e}")

    return removed, freed, failed


def _wave_cache_path():
    try:
        return _circlet_cache_dir() + "/wave_cache.txt"
    except Exception:
        return None


def _wave_cache_load(path):
    try:
        p = _wave_cache_path()
        if not p or not os.path.exists(p):
            return None
        with open(p, "r", encoding="utf-8") as f:
            for line in f:
                if line.startswith(path + "\t"):
                    vals = line.rstrip("\n").split("\t", 1)[1].split(",")
                    if len(vals) == 120:
                        slog("wave cache hit")
                        return [max(0.0, float(v)) for v in vals]
                    return None
    except Exception:
        pass
    return None


def _wave_cache_save(path, bars):
    try:
        p = _wave_cache_path()
        if not p:
            return
        lines = []
        if os.path.exists(p):
            with open(p, "r", encoding="utf-8") as f:
                lines = [l for l in f.read().splitlines() if l and not l.startswith(path + "\t")]
        lines.append(path + "\t" + ",".join("%.3f" % float(b) for b in bars))
        if len(lines) > 24:
            lines = lines[-24:]
        with open(p, "w", encoding="utf-8") as f:
            f.write("\n".join(lines) + "\n")
        slog(f"wave cache saved: {p}")
    except Exception:
        pass


def _wave_prefetch(path):
    if not path or not os.path.isfile(path):
        return
    if path in _WAVE_CACHE or path in _WAVE_PREFETCH:
        return

    _WAVE_PREFETCH.add(path)

    def work():
        try:
            def part(peaks):
                if not peaks:
                    return
                mx = max(peaks)
                if mx <= 0:
                    return
                partial = [min(1.0, p / mx) for p in peaks]

                def apply(values=partial):
                    sheet = ACTIVE.get("sheet")
                    if (
                        sheet is not None
                        and not sheet._closed
                        and sheet.probe.path == path
                    ):
                        sheet._set_wave_bars(values)

                run_on_ui_thread(apply)

            bars, _total = _decode_wave(path, 120, part)
            _WAVE_CACHE[path] = bars
            _wave_cache_save(path, bars)

            def apply_final(values=bars):
                sheet = ACTIVE.get("sheet")
                if (
                    sheet is not None
                    and not sheet._closed
                    and sheet.probe.path == path
                ):
                    sheet._set_wave_bars(values)

            run_on_ui_thread(apply_final)
        except Exception as e:
            slog(f"wave prefetch failed: {e}")
        finally:
            _WAVE_PREFETCH.discard(path)

    threading.Thread(target=work, daemon=True).start()


def context():
    frag = get_last_fragment()
    ctx = frag.getParentActivity() if frag is not None else None
    if ctx is not None:
        return ctx
    try:
        from org.telegram.messenger import ApplicationLoader
        return ApplicationLoader.applicationContext
    except Exception:
        return None


class VideoProbe:
    def __init__(self, path):
        self.path = path
        self.width = 0
        self.height = 0
        self.rotation = 0
        self.duration_ms = 0
        self.frame = None
        self.frame_time_us = 0
        self.ok = False

    def run(self):
        retriever = None
        try:
            retriever = MediaMetadataRetriever()
            retriever.setDataSource(self.path)
            self.width = self._meta(retriever, MediaMetadataRetriever.METADATA_KEY_VIDEO_WIDTH)
            self.height = self._meta(retriever, MediaMetadataRetriever.METADATA_KEY_VIDEO_HEIGHT)
            self.rotation = self._meta(retriever, MediaMetadataRetriever.METADATA_KEY_VIDEO_ROTATION)
            self.duration_ms = self._meta(retriever, MediaMetadataRetriever.METADATA_KEY_DURATION)
            if self.rotation in (90, 270):
                self.width, self.height = self.height, self.width
            self._fetch_frame(retriever, 0)
            self.ok = self.width > 0 and self.height > 0
        except Exception:
            pass
        finally:
            if retriever is not None:
                try:
                    retriever.release()
                except Exception:
                    pass
        return self.ok

    def _fetch_frame(self, retriever, time_us):
        try:
            self.frame = retriever.getFrameAtTime(int(time_us), MediaMetadataRetriever.OPTION_CLOSEST_SYNC)
        except Exception:
            self.frame = None
        if self.frame is None:
            try:
                self.frame = retriever.getFrameAtTime(int(time_us), MediaMetadataRetriever.OPTION_CLOSEST)
            except Exception:
                self.frame = None
        self.frame_time_us = int(time_us)

    def fetch_frame_at(self, time_us):
        retriever = None
        try:
            retriever = MediaMetadataRetriever()
            retriever.setDataSource(self.path)
            self._fetch_frame(retriever, time_us)
        except Exception:
            pass
        finally:
            if retriever is not None:
                try:
                    retriever.release()
                except Exception:
                    pass

    @staticmethod
    def _meta(retriever, key):
        try:
            raw = retriever.extractMetadata(key)
            return int(str(raw)) if raw is not None else 0
        except Exception:
            return 0


class CropModel:
    def __init__(self, width, height, output_size=None):
        self.output_size = round_resolution(output_size)
        self.width = max(1, width)
        self.height = max(1, height)
        self.center_x = 0.5
        self.center_y = 0.5
        self.zoom = MIN_ZOOM

    def side(self):
        return min(self.width, self.height) / self.zoom

    def clamp(self):
        half_w = (self.side() / 2.0) / self.width
        half_h = (self.side() / 2.0) / self.height
        self.center_x = min(max(self.center_x, half_w), 1.0 - half_w)
        self.center_y = min(max(self.center_y, half_h), 1.0 - half_h)

    def move(self, dx_frac, dy_frac):
        self.center_x += dx_frac
        self.center_y += dy_frac
        self.clamp()

    def set_zoom(self, value):
        self.zoom = min(max(float(value), MIN_ZOOM), MAX_ZOOM)
        self.clamp()

    def rect(self):
        side = self.side()
        left = self.center_x * self.width - side / 2.0
        top = self.center_y * self.height - side / 2.0
        return left, top, side

    def build_crop_state(self):
        left, top, side = self.rect()
        state = MediaController.CropState()
        center_x = (left + side / 2.0) / self.width - 0.5
        center_y = (top + side / 2.0) / self.height - 0.5
        values = (
            ("cropPx", float(-center_x)),
            ("cropPy", float(-center_y)),
            ("cropPw", float(side / self.width)),
            ("cropPh", float(side / self.height)),
            ("cropScale", 1.0),
            ("cropRotate", 0.0),
            ("transformWidth", self.output_size),
            ("transformHeight", self.output_size),
            ("transformRotation", 0),
            ("mirrored", False),
            ("width", int(self.width)),
            ("height", int(self.height)),
            ("freeform", False),
            ("lockedAspectRatio", 1.0),
            ("initied", True),
            ("useMatrix", None),
            ("stateScale", 1.0),
            ("scale", 1.0),
        )
        written = {}
        for name, value in values:
            written[name] = set_typed_field(state, name, value)
        return state


class PreviewPainter:
    def __init__(self, frame, model, size_px, height_px=None):
        self.frame = frame
        self.model = model
        self.size = self.width = max(64, int(size_px))
        self.height = max(64, int(height_px if height_px is not None else size_px))
        self.canvas_bitmap = Bitmap.createBitmap(self.width, self.height, Bitmap.Config.ARGB_8888)
        self.paint = Paint()
        self.paint.setAntiAlias(True)
        self.shade = Paint()
        self.shade.setAntiAlias(True)
        self.shade.setARGB(150, 0, 0, 0)
        self.stroke = Paint()
        self.stroke.setAntiAlias(True)
        self.stroke.setStyle(Paint.Style.STROKE)
        self.stroke.setStrokeWidth(float(AndroidUtilities.dp(2)))
        self.stroke.setARGB(255, 255, 255, 255)

    def render(self):
        canvas = Canvas(self.canvas_bitmap)
        canvas.drawARGB(255, 0, 0, 0)

        if self.frame is not None:
            src = Rect(0, 0, self.frame.getWidth(), self.frame.getHeight())
            scale = min(
                float(self.width) / max(1, self.frame.getWidth()),
                float(self.height) / max(1, self.frame.getHeight()),
            )
            draw_w = int(self.frame.getWidth() * scale)
            draw_h = int(self.frame.getHeight() * scale)
            off_x = (self.width - draw_w) // 2
            off_y = (self.height - draw_h) // 2
            dst = Rect(off_x, off_y, off_x + draw_w, off_y + draw_h)
            canvas.drawBitmap(self.frame, src, dst, self.paint)
        else:
            off_x = 0
            off_y = 0
            draw_w = self.width
            draw_h = self.height

        radius = (min(draw_w, draw_h) / 2.0) / self.model.zoom
        cx = off_x + self.model.center_x * draw_w
        cy = off_y + self.model.center_y * draw_h

        hole = Path()
        hole.addCircle(float(cx), float(cy), float(radius), Path.Direction.CW)
        hole.setFillType(Path.FillType.INVERSE_WINDING)
        canvas.drawPath(hole, self.shade)
        canvas.drawCircle(float(cx), float(cy), float(radius), self.stroke)

        return self.canvas_bitmap

    def frame_box(self):
        if self.frame is None:
            return 0, 0, self.width, self.height
        scale = min(
            float(self.width) / max(1, self.frame.getWidth()),
            float(self.height) / max(1, self.frame.getHeight()),
        )
        draw_w = int(self.frame.getWidth() * scale)
        draw_h = int(self.frame.getHeight() * scale)
        return (self.width - draw_w) // 2, (self.height - draw_h) // 2, draw_w, draw_h


class DragListener(dynamic_proxy(View.OnTouchListener)):
    def __init__(self, sheet):
        super().__init__()
        self.sheet = sheet
        self.last_x = 0.0
        self.last_y = 0.0
        self.mode = None
        self.base_dist = 0.0
        self.base_zoom = MIN_ZOOM

    @staticmethod
    def _distance(event):
        try:
            dx = event.getX(0) - event.getX(1)
            dy = event.getY(0) - event.getY(1)
            return float((dx * dx + dy * dy) ** 0.5)
        except Exception:
            return 0.0

    def onTouch(self, view, event):
        try:
            action = event.getActionMasked()
            count = int(event.getPointerCount())

            if action == MotionEvent.ACTION_DOWN:
                parent = view.getParent()
                if parent is not None:
                    parent.requestDisallowInterceptTouchEvent(True)
                self.last_x = event.getX()
                self.last_y = event.getY()
                self.mode = "pan"
                return True

            if action == MotionEvent.ACTION_POINTER_DOWN and count >= 2:
                self.base_dist = self._distance(event)
                self.base_zoom = self.sheet.model.zoom
                self.mode = "zoom"
                return True

            if action == MotionEvent.ACTION_MOVE:
                if self.mode == "zoom" and count >= 2:
                    current = self._distance(event)
                    if self.base_dist > 20.0 and current > 20.0:
                        self.sheet.on_zoom(self.base_zoom * self.base_dist / current)
                    return True
                if self.mode == "pan" and count == 1:
                    dx = event.getX() - self.last_x
                    dy = event.getY() - self.last_y
                    self.last_x = event.getX()
                    self.last_y = event.getY()
                    self.sheet.on_drag(dx, dy)
                    return True
                return True

            if action == MotionEvent.ACTION_POINTER_UP:
                if count <= 2:
                    remaining = 0 if int(event.getActionIndex()) == 1 else 1
                    try:
                        self.last_x = event.getX(remaining)
                        self.last_y = event.getY(remaining)
                    except Exception:
                        pass
                    self.mode = "pan"
                return True

            if action in (MotionEvent.ACTION_UP, MotionEvent.ACTION_CANCEL):
                parent = view.getParent()
                if parent is not None:
                    parent.requestDisallowInterceptTouchEvent(False)
                self.mode = None
                s = self.sheet
                if s is not None:
                    try:
                        s._show_overlay()
                    except Exception:
                        pass
                return True
        except Exception:
            pass
        return False

class TrimRange:
    def __init__(self, total_ms, start_ms=0, end_ms=None, max_ms=60000):
        self.total = max(1, int(total_ms))
        self.cap = max(0, int(max_ms)) or self.total
        self.minimum = min(1000, self.total)
        self.start = min(max(0, int(start_ms)), self.total - self.minimum)
        end = self.total if end_ms is None else int(end_ms)
        self.end = min(self.total, self.start + self.cap, max(self.start + self.minimum, end))
        self.cursor = self.start

    def change(self, edge, value):
        value = int(value)
        if edge == "start":
            self.start = min(self.end - self.minimum, max(0, self.end - self.cap, value))
        elif edge == "end":
            self.end = max(self.start + self.minimum, min(self.total, self.start + self.cap, value))
        elif edge == "move":
            length = self.end - self.start
            self.start = min(max(0, value), self.total - length)
            self.end = self.start + length
        else:
            self.cursor = value
        self.cursor = min(max(self.cursor, self.start), self.end)


def time_label(ms):
    seconds = max(0, int(ms)) // 1000
    return f"{seconds // 60}:{seconds % 60:02d}"


class TimelineTouch(dynamic_proxy(View.OnTouchListener)):
    def __init__(self, sheet):
        super().__init__()
        self.sheet = sheet
        self.edge = None
        self.offset = 0

    def onTouch(self, view, event):
        sheet = self.sheet
        if sheet._closed or sheet._sending:
            return True
        trim = sheet.trim
        width = max(1, int(view.getWidth()) - 2 * sheet.timeline_pad)
        value = int((float(event.getX()) - sheet.timeline_pad) / width * trim.total)
        action = int(event.getActionMasked())
        if action == MotionEvent.ACTION_DOWN:
            left = sheet.timeline_pad + width * trim.start / trim.total
            right = sheet.timeline_pad + width * trim.end / trim.total
            x = float(event.getX())
            threshold = AndroidUtilities.dp(20)
            if min(abs(x - left), abs(x - right)) <= threshold:
                self.edge = "start" if abs(x - left) <= abs(x - right) else "end"
            elif float(event.getY()) > view.getHeight() * 0.65 and left < x < right:
                self.edge = "move"
                self.offset = value - trim.start
            else:
                self.edge = "cursor"
            view.getParent().requestDisallowInterceptTouchEvent(True)
        if action in (MotionEvent.ACTION_DOWN, MotionEvent.ACTION_MOVE, MotionEvent.ACTION_UP):
            trim.change(self.edge, value - self.offset if self.edge == "move" else value)
            if self.edge in ("start", "move"):
                trim.cursor = trim.start
            elif self.edge == "end":
                trim.cursor = trim.end
            sheet.update_timeline()
            sheet.request_frame(min(trim.cursor, trim.total - 1))
        if action in (MotionEvent.ACTION_UP, MotionEvent.ACTION_CANCEL):
            self.edge = None
            view.getParent().requestDisallowInterceptTouchEvent(False)
        return True


class DismissProxy(dynamic_proxy(DialogInterface.OnDismissListener)):
    def __init__(self, sheet):
        super().__init__()
        self.sheet = sheet

    def onDismiss(self, dialog):
        sheet = self.sheet
        sending = bool(sheet._sending)
        temporary_path = (
            getattr(sheet, "temporary_audio_path", None)
            or getattr(sheet.probe, "temporary_audio_path", None)
        )

        try:
            sheet.release_preview()
        finally:
            if not sending and temporary_path:
                remove_temporary_audio(temporary_path)

            sheet.dialog = None
            sheet.root = None

            if ACTIVE.get("sheet") is sheet:
                ACTIVE["sheet"] = None


from org.telegram.ui.Components import VideoTimelinePlayView as _VTL_BASE
_VTL_DELEGATE = _VTL_BASE.VideoTimelineViewDelegate

if _VTL_BASE is not None and _VTL_DELEGATE is not None:
    from extera_utils.classes import Base as _ProxyBase, java_subclass as _java_subclass, joverride as _joverride

    @_java_subclass(_VTL_BASE, _VTL_DELEGATE)
    class NativeTimeline(_ProxyBase):
        sheet = None

        @_joverride()
        def onLeftProgressChanged(self, progress):
            s = self.sheet
            if s is not None:
                s.on_native_left(float(progress))

        @_joverride()
        def onRightProgressChanged(self, progress):
            s = self.sheet
            if s is not None:
                s.on_native_right(float(progress))

        @_joverride()
        def onPlayProgressChanged(self, progress):
            s = self.sheet
            if s is not None:
                s.on_native_play(float(progress))

        @_joverride()
        def didStartDragging(self, type):
            s = self.sheet
            if s is not None:
                try:
                    s.on_scrub_start(int(type))
                except Exception:
                    pass

        @_joverride()
        def didStopDragging(self, type):
            s = self.sheet
            if s is not None:
                try:
                    s.on_scrub_end(int(type))
                except Exception:
                    pass

        @_joverride()
        def customBlur(self):
            return False

        @_joverride()
        def invalidateBlur(self):
            pass

        @_joverride()
        def onDraw(self, canvas):
            super().onDraw(canvas)
            try:
                s = self.sheet
                if s is None or not s.audio_mode:
                    return

                bars = getattr(s, "wave_bars", None)
                if not bars:
                    return

                w = float(self.getMeasuredWidth())
                grid_l = float(AndroidUtilities.dpf2(12.0) + AndroidUtilities.dp(10))
                grid_w = float(w - AndroidUtilities.dpf2(24.0) - AndroidUtilities.dp(16))
                if grid_w <= 1.0:
                    return

                total = max(1.0, float(s.trim.total))
                start = min(1.0, max(0.0, float(s.trim.start) / total))
                end = min(1.0, max(0.0, float(s.trim.end) / total))
                left = grid_l + grid_w * start
                right = grid_l + grid_w * end

                left_gap = float(AndroidUtilities.dp(3))
                right_gap = float(AndroidUtilities.dp(8))
                wave_l = grid_l + left_gap
                wave_r = grid_l + grid_w - right_gap
                clip_l = max(left, wave_l)
                clip_r = min(right, wave_r)
                if clip_r <= clip_l:
                    return

                stroke = float(AndroidUtilities.dpf2(2.2))
                half = stroke / 2.0
                mid = float(AndroidUtilities.dpf2(25.0))
                amp = float(AndroidUtilities.dp(18))
                n = len(bars)

                first_x = wave_l + half
                last_x = wave_r - half
                step = (last_x - first_x) / float(max(1, n - 1))

                paint = Paint(Paint.ANTI_ALIAS_FLAG)
                paint.setStyle(Paint.Style.STROKE)
                paint.setStrokeWidth(stroke)
                paint.setStrokeCap(Paint.Cap.ROUND)
                paint.setARGB(255, 255, 255, 255)

                saved = canvas.save()
                try:
                    canvas.clipRect(
                        float(clip_l),
                        float(AndroidUtilities.dp(7)),
                        float(clip_r),
                        float(AndroidUtilities.dp(43)),
                    )

                    for i, value in enumerate(bars):
                        x = first_x + step * i
                        if x + half < clip_l or x - half > clip_r:
                            continue

                        v = min(1.0, max(0.0, float(value)))
                        height = max(float(AndroidUtilities.dp(4)), amp * (v ** 0.5))
                        canvas.drawLine(
                            float(x),
                            float(mid - height / 2.0),
                            float(x),
                            float(mid + height / 2.0),
                            paint,
                        )
                finally:
                    canvas.restoreToCount(saved)
            except Exception as e:
                slog(f"vtl wave draw fail: {e}")
else:
    NativeTimeline = None


class CropSheet:
    def __init__(self, probe, on_confirm, audio_mode=False):
        self.audio_mode = audio_mode
        self.probe = probe
        self.on_confirm = on_confirm
        self.model = CropModel(probe.width, probe.height, getattr(probe, "round_size", None))
        self.painter = None
        self.image = None
        self.label = None
        self.root = None
        self.dialog = None
        self.temporary_audio_path = None
        self._keep_alive = []
        interval = getattr(probe, "trim_ms", None)
        if interval is None:
            start, end = viewer_trim_window_ms(probe.duration_ms, probe.path)
            interval = (max(0, start), end if end > 0 else probe.duration_ms)
        self.trim = TrimRange(probe.duration_ms, *interval, 0 if audio_mode else 60000)
        self.timeline_pad = AndroidUtilities.dp(6)
        self.band_top = AndroidUtilities.dp(8)
        self.band_bot = AndroidUtilities.dp(48)
        self.timeline = None
        self.timeline_text = None
        self.timeline_bitmap = None
        self.strip_bmp = None
        self.wave_bars = None
        self.player = None
        self.video_player = None
        self._dim_bmp = None
        self._ap_playing = False
        self._vp_playing = False
        self._vp_paused = False
        self._vp_pending = False
        self._scrubbing = False
        self._trim_dragging = False
        self._resume_after_trim = False
        self._closed = False
        self._sending = False
        self._frame_busy = False
        self._frame_request = None
        self._frame_serial = 0
        self._display_frame = None
        self._mmr = None
        self._target = get_last_fragment()

    def show(self):
        ctx = context()
        if ctx is None:
            return False

        frag = get_last_fragment()
        activity = frag.getParentActivity() if frag is not None else None
        if activity is None:
            return False
        try:
            screen_w = int(AndroidUtilities.displaySize.x)
            screen_h = int(AndroidUtilities.displaySize.y)
        except Exception:
            screen_w = AndroidUtilities.dp(360)
            screen_h = AndroidUtilities.dp(640)

        canvas_w, canvas_h = crop_preview_dimensions(screen_w, screen_h)
        canvas_side = min(canvas_w, canvas_h)
        if self.audio_mode:
            self.painter = None
            self.image = None
        else:
            self.painter = PreviewPainter(self.probe.frame, self.model, canvas_w, canvas_h)

        self.root = FrameLayout(ctx)
        self.root.setBackgroundColor(Color.argb(242, 0, 0, 0))
        self.root.setClickable(True)

        column = LinearLayout(ctx)
        column.setOrientation(LinearLayout.VERTICAL)
        column.setGravity(Gravity.CENTER_HORIZONTAL)

        self.label = TextView(ctx)
        self.label.setTextSize(14.0)
        self.label.setGravity(Gravity.CENTER)
        try:
            self.label.setTextColor(Color.argb(160, 255, 255, 255))
        except Exception:
            pass
        pad = AndroidUtilities.dp(18)
        self.label.setPadding(pad, pad, pad, AndroidUtilities.dp(10))
        column.addView(self.label, LinearLayout.LayoutParams(-1, -2))

        if not self.audio_mode:
            holder = FrameLayout(ctx)
            self.image = ImageView(ctx)
            self.image.setScaleType(ImageView.ScaleType.FIT_CENTER)
            drag = DragListener(self)
            self._keep_alive.append(drag)
            self.image.setOnTouchListener(drag)
            holder.addView(self.image, FrameLayout.LayoutParams(canvas_w, canvas_h))

            self.vtv = TextureView(ctx)
            self.vtv.setVisibility(View.GONE)
            surface_listener = _VPSurfaceListener(self)
            self._keep_alive.append(surface_listener)
            self.vtv.setSurfaceTextureListener(surface_listener)
            self._keep_alive.append(self.vtv)
            tv_box = self.painter.frame_box()
            tv_w = tv_box[2] if tv_box[2] > 0 else canvas_w
            tv_h = tv_box[3] if tv_box[3] > 0 else canvas_h
            tv_lp = FrameLayout.LayoutParams(tv_w, tv_h)
            tv_lp.leftMargin = tv_box[0]
            tv_lp.topMargin = tv_box[1]
            holder.addView(self.vtv, tv_lp)

            self.dim_iv = ImageView(ctx)
            self.dim_iv.setVisibility(View.GONE)
            self.dim_iv.setScaleType(ImageView.ScaleType.FIT_XY)
            self._keep_alive.append(self.dim_iv)
            holder.addView(self.dim_iv, FrameLayout.LayoutParams(canvas_w, canvas_h))

            from android.graphics.drawable import GradientDrawable
            overlay = FrameLayout(ctx)
            ov_bg = GradientDrawable()
            ov_bg.setShape(GradientDrawable.OVAL)
            ov_bg.setColor(Color.argb(110, 0, 0, 0))
            overlay.setBackground(ov_bg)
            pi = play_icon()
            if pi:
                icon_view = ImageView(ctx)
                icon_view.setImageResource(pi)
                icon_side = AndroidUtilities.dp(26)
                overlay.addView(icon_view, FrameLayout.LayoutParams(icon_side, icon_side, Gravity.CENTER))
            else:
                icon_view = TextView(ctx)
                icon_view.setText(JString("▶"))
                icon_view.setTextSize(16.0)
                icon_view.setGravity(Gravity.CENTER)
                try:
                    icon_view.setTextColor(Color.argb(255, 255, 255, 255))
                except Exception:
                    pass
                overlay.addView(icon_view, FrameLayout.LayoutParams(-2, -2, Gravity.CENTER))
            self._icon_view = icon_view
            ov_side = int(canvas_side * 0.20)
            overlay.setClickable(True)
            self._keep_alive.append(OnClickListener(self.toggle_video_play))
            overlay.setOnClickListener(self._keep_alive[-1])
            self._keep_alive.append(overlay)
            holder.addView(overlay, FrameLayout.LayoutParams(ov_side, ov_side, Gravity.CENTER))
            self.overlay = overlay
            column.addView(holder, LinearLayout.LayoutParams(canvas_w, canvas_h))

            hint = TextView(ctx)
            hint.setTextSize(13.0)
            hint.setGravity(Gravity.CENTER)
            try:
                hint.setTextColor(Color.argb(110, 255, 255, 255))
            except Exception:
                pass
            hint.setText(JString(localized("Перетащите круг, двумя пальцами меняйте размер", "Drag the circle, pinch to resize")))
            hint.setPadding(pad, AndroidUtilities.dp(14), pad, AndroidUtilities.dp(6))
            column.addView(hint, LinearLayout.LayoutParams(-1, -2))

        if not self.audio_mode:
            quality = TextView(ctx)
            quality.setTextSize(14.0)
            quality.setGravity(Gravity.CENTER)
            quality.setTextColor(Color.WHITE)
            quality.setPadding(pad, AndroidUtilities.dp(8), pad, AndroidUtilities.dp(8))
            quality.setText(JString(localized('Разрешение: ', 'Resolution: ') + str(self.model.output_size) + ' × ' + str(self.model.output_size) + '  ▾'))
            self.quality_label = quality
            self._keep_alive.append(OnClickListener(self.choose_resolution))
            quality.setOnClickListener(self._keep_alive[-1])
            column.addView(quality, LinearLayout.LayoutParams(-1, -2))

        self.timeline_text = TextView(ctx)
        self.timeline_text.setTextSize(13.0)
        self.timeline_text.setGravity(Gravity.CENTER)
        self.timeline_text.setTextColor(Color.argb(220, 255, 255, 255))
        column.addView(self.timeline_text, LinearLayout.LayoutParams(-1, -2))
        if not self.audio_mode:
            self.timeline = None
            self.timeline_bitmap = None
            if NativeTimeline is None:
                toast(localized("Компонент таймлайна недоступен", "Timeline component unavailable"))
                return False
            self.vtl = NativeTimeline.new_instance(ctx)
            self.vtl.sheet = self
            self.vtl.setDelegate(self.vtl.java)
            total = max(1.0, float(self.trim.total))
            self.vtl.setVideoPath(self.probe.path, 0, float(self.trim.start) / total, float(self.trim.end) / total, 0)
            self.vtl.setMaxProgressDiff(min(1.0, 60000.0 / total))
            column.addView(self.vtl.java, LinearLayout.LayoutParams(-1, AndroidUtilities.dp(48)))
        else:
            self.vtl = NativeTimeline.new_instance(ctx)
            self.vtl.sheet = self
            self.vtl.setDelegate(self.vtl.java)
            self.vtl.setVideoPath(self.probe.path, 0, 0.0, 1.0, 0)
            self.vtl.setMaxProgressDiff(1.0)
            column.addView(self.vtl.java, LinearLayout.LayoutParams(-1, AndroidUtilities.dp(48)))
            self.build_wave()
            play_btn = TextView(ctx)
            play_btn.setTextSize(14.0)
            play_btn.setGravity(Gravity.CENTER)
            play_btn.setTextColor(Color.argb(255, 255, 255, 255))
            play_btn.setText(JString("▶  " + localized("Прослушать отрезок", "Play the selected part")))
            from android.graphics.drawable import GradientDrawable
            pb_bg = GradientDrawable()
            pb_bg.setColor(Color.argb(70, 255, 255, 255))
            pb_bg.setCornerRadius(float(AndroidUtilities.dp(20)))
            play_btn.setBackground(pb_bg)
            pb_pad = AndroidUtilities.dp(10)
            play_btn.setPadding(pb_pad, AndroidUtilities.dp(6), pb_pad, AndroidUtilities.dp(6))
            lp = LinearLayout.LayoutParams(-2, -2)
            lp.gravity = Gravity.CENTER_HORIZONTAL
            lp.setMargins(0, AndroidUtilities.dp(6), 0, AndroidUtilities.dp(8))
            self._keep_alive.append(OnClickListener(self.toggle_play))
            play_btn.setOnClickListener(self._keep_alive[-1])
            self.play_btn = play_btn
            column.addView(play_btn, lp)

        self.update_timeline()

        buttons = LinearLayout(ctx)
        buttons.setOrientation(LinearLayout.HORIZONTAL)
        buttons.addView(self._make_button(ctx, localized("Отмена", "Cancel"), self._dismiss),
                        LinearLayout.LayoutParams(0, -2, 1.0))
        buttons.addView(self._make_button(ctx, localized("Отправить", "Send"), self._confirm_and_close),
                        LinearLayout.LayoutParams(0, -2, 1.0))
        column.addView(buttons, LinearLayout.LayoutParams(-1, -2))

        scroll = ScrollView(ctx)
        scroll.setFillViewport(False)
        scroll.setClipToPadding(False)
        scroll.setPadding(0, int(getattr(AndroidUtilities, 'statusBarHeight', 0) or 0), 0, int(getattr(AndroidUtilities, 'navigationBarHeight', 0) or 0))
        scroll.addView(column, FrameLayout.LayoutParams(-1, -2))
        self.root.addView(scroll, FrameLayout.LayoutParams(-1, -1))

        from android import R as AndroidR
        self.dialog = Dialog(activity, AndroidR.style.Theme_Translucent_NoTitleBar_Fullscreen)
        self.dialog.setContentView(self.root)
        self.dialog.setCanceledOnTouchOutside(False)
        dismiss_proxy = DismissProxy(self)
        self._keep_alive.append(dismiss_proxy)
        self.dialog.setOnDismissListener(dismiss_proxy)
        window = self.dialog.getWindow()
        if window is not None:
            window.setBackgroundDrawable(ColorDrawable(Color.argb(0, 0, 0, 0)))
            window.setLayout(-1, -1)
        self._keep_alive.append(self.root)
        self.refresh()
        self.root.setAlpha(0.0)
        self.dialog.show()
        try:
            fade = self.root.animate()
            fade.alpha(1.0)
            fade.setDuration(180)
            fade.start()
        except Exception:
            self.root.setAlpha(1.0)
        ACTIVE["sheet"] = self
        if not self.audio_mode:
            self.request_frame(self.trim.cursor)
        return True

    def _make_button(self, ctx, caption, handler):
        view = TextView(ctx)
        view.setText(JString(caption))
        view.setTextSize(15.0)
        view.setGravity(Gravity.CENTER)
        pad = AndroidUtilities.dp(14)
        view.setPadding(pad, pad, pad, pad)
        try:
            view.setTextColor(Theme.getColor(Theme.key_dialogTextBlue2))
        except Exception:
            pass
        listener = OnClickListener(handler)
        self._keep_alive.append(listener)
        view.setOnClickListener(listener)
        return view

    def _dismiss(self, *_):
        sending = bool(self._sending)
        temporary_path = (
            getattr(self, "temporary_audio_path", None)
            or getattr(self.probe, "temporary_audio_path", None)
        )

        try:
            self.release_preview()
        finally:
            if not sending and temporary_path:
                remove_temporary_audio(temporary_path)

            dialog = self.dialog
            self.dialog = None
            self.root = None

            if dialog is not None:
                try:
                    dialog.dismiss()
                except Exception as e:
                    slog(f"audio dialog dismiss failed: {e}")

            if ACTIVE.get("sheet") is self:
                ACTIVE["sheet"] = None

    def _confirm_and_close(self, *_):
        if self._sending or self._closed:
            return
        if get_last_fragment() != self._target:
            toast(localized("Чат изменился. Откройте превью заново", "Chat changed. Open the preview again"))
            return
        if self.audio_mode and self.trim.end - self.trim.start < 500:
            toast(localized(
                "Выберите отрезок длиннее половины секунды",
                "Select a segment longer than half a second",
            ))
            return
        self._sending = True
        self.probe.trim_ms = (self.trim.start, self.trim.end)
        dismiss_popup()
        self.fade_out(delay=120)
        run_on_ui_thread(self.confirm, 400)

    def fade_out(self, delay=0):
        if self.root is None:
            return
        try:
            anim = self.root.animate()
            anim.alpha(0.0)
            anim.setDuration(200)
            anim.setStartDelay(int(delay))
            ending = ClickRunnable(self._dismiss)
            self._keep_alive.append(ending)
            anim.withEndAction(ending)
            anim.start()
        except Exception:
            self._dismiss()

    def build_filmstrip(self, width, height):
        if self._closed:
            return

        def work():
            retriever = None
            try:
                from android.media import MediaMetadataRetriever as _MMR
                retriever = _MMR()
                retriever.setDataSource(self.probe.path)
                slots = 12
                usable = max(1, width - 2 * self.timeline_pad)
                slot_w = max(8, usable // slots)
                strip = Bitmap.createBitmap(width, height, Bitmap.Config.ARGB_8888)
                sc = Canvas(strip)
                filler = Paint()
                filler.setARGB(255, 26, 26, 26)
                band_top = self.band_top
                band_h = self.band_bot - self.band_top
                sc.drawRect(0.0, 0.0, float(width), float(height), filler)
                x = float(self.timeline_pad)
                index = 0
                while x < width - self.timeline_pad - 1:
                    slot = min(slot_w, int(width - self.timeline_pad - x))
                    if slot < 2:
                        break
                    frac = (index + 0.5) / slots
                    time_ms = int(self.trim.total * frac)
                    frame = None
                    try:
                        frame = retriever.getFrameAtTime(int(time_ms) * 1000, _MMR.OPTION_CLOSEST_SYNC)
                    except Exception:
                        frame = None
                    if frame is None:
                        try:
                            frame = retriever.getFrameAtTime(int(time_ms) * 1000, _MMR.OPTION_CLOSEST)
                        except Exception:
                            frame = None
                    if frame is not None:
                        fw = int(frame.getWidth())
                        fh = int(frame.getHeight())
                        if fw > 0 and fh > 0:
                            h2 = band_h
                            w2 = int(fw * band_h / fh)
                            if w2 < slot:
                                w2 = slot
                                h2 = int(fh * slot / fw)
                            scaled = Bitmap.createScaledBitmap(frame, max(1, w2), max(1, h2), True)
                            x0 = max(0, (scaled.getWidth() - slot) // 2)
                            y0 = max(0, (scaled.getHeight() - band_h) // 2)
                            pw = min(slot, scaled.getWidth() - x0)
                            ph = min(band_h, scaled.getHeight() - y0)
                            if pw > 0 and ph > 0:
                                piece = Bitmap.createBitmap(scaled, x0, y0, pw, ph)
                                sc.drawBitmap(piece, float(x), float(band_top), filler)
                    x += slot
                    index += 1

                def done():
                    if self._closed:
                        return
                    self.strip_bmp = strip
                    self.update_timeline()

                run_on_ui_thread(done)
            except Exception as e:
                slog(f"filmstrip failed: {e}")
            finally:
                if retriever is not None:
                    try:
                        retriever.release()
                    except Exception:
                        pass

        threading.Thread(target=work, daemon=True).start()

    def update_timeline(self):
        trim = self.trim
        self.probe.trim_ms = (trim.start, trim.end)
        if self.audio_mode:
            length = (trim.end - trim.start) / 1000.0
            if self.timeline_text is not None:
                first_ms = trim.cursor if trim.cursor > trim.start else trim.start
                first = time_label(first_ms)
                self.timeline_text.setText(JString(localized(f"Выбрано {first} — {time_label(trim.end)} · {time_label(int(length * 1000))} из {time_label(trim.total)}", f"Selected {first} — {time_label(trim.end)} · {time_label(int(length * 1000))} of {time_label(trim.total)}")))
            if self.timeline_bitmap is None:
                return
        elif getattr(self, "vtl", None) is not None:
            length = (trim.end - trim.start) / 1000.0
            if self.timeline_text is not None:
                self.timeline_text.setText(JString(f"{time_label(trim.start)} — {time_label(trim.end)}  ·  {length:.2f} / 60 s"))
            return
        elif self.timeline_bitmap is None:
            return
        bitmap = self.timeline_bitmap
        width, height = bitmap.getWidth(), bitmap.getHeight()
        pad = self.timeline_pad
        usable = max(1, width - 2 * pad)
        left = pad + usable * trim.start / trim.total
        right = pad + usable * trim.end / trim.total
        band_top = self.band_top
        band_bot = self.band_bot

        canvas = Canvas(bitmap)
        bitmap.eraseColor(0)
        paint = Paint()
        base = self.strip_bmp
        dp10 = float(AndroidUtilities.dp(10))
        band_path = Path()
        band_path.addRoundRect(pad, band_top, width - pad, band_bot, dp10, dp10, Path.Direction.CW)
        if self.audio_mode:
            bg = Paint()
            bg.setARGB(255, 255, 255, 255)
            canvas.drawRoundRect(pad, band_top, width - pad, band_bot, dp10, dp10, bg)
            bars = self.wave_bars
            if bars:
                mid = (band_top + band_bot) / 2.0
                inner_w = width - 2 * pad
                step = inner_w / float(len(bars))
                in_left = pad + inner_w * trim.start / trim.total
                in_right = pad + inner_w * trim.end / trim.total
                bar_h_max = band_bot - band_top - AndroidUtilities.dp(6)
                for bi, val in enumerate(bars):
                    bx = pad + step * (bi + 0.5)
                    h = max(float(AndroidUtilities.dp(2)), bar_h_max * val)
                    bw = Paint()
                    if in_left <= bx <= in_right:
                        bw.setARGB(255, 45, 45, 45)
                    else:
                        bw.setARGB(255, 205, 205, 205)
                    canvas.drawLine(float(bx), mid - h / 2.0, float(bx), mid + h / 2.0, bw)
        elif base is not None:
            paint.setFilterBitmap(True)
            canvas.save()
            canvas.clipPath(band_path)
            canvas.drawBitmap(base, 0.0, 0.0, paint)
            canvas.restore()

        dp2 = float(AndroidUtilities.dp(2))
        dp6 = float(AndroidUtilities.dp(6))

        stroke = Paint(Paint.ANTI_ALIAS_FLAG)
        stroke.setARGB(255, 255, 255, 255)
        stroke.setStrokeWidth(dp2)
        stroke.setStyle(Paint.Style.STROKE)
        canvas.drawRoundRect(left, band_top, right, band_bot, dp10, dp10, stroke)

        handle_w = dp6
        handle = Paint(Paint.ANTI_ALIAS_FLAG)
        handle.setARGB(255, 255, 255, 255)
        notch = Paint(Paint.ANTI_ALIAS_FLAG)
        notch.setARGB(255, 0, 0, 0)
        notch_w = float(AndroidUtilities.dp(1.0))
        notch_h = float(AndroidUtilities.dp(7))
        for x in (left, right):
            if x == left:
                canvas.drawRoundRect(x - handle_w, band_top, x, band_bot, handle_w, handle_w, handle)
                cx = x - handle_w / 2.0
            else:
                canvas.drawRoundRect(x, band_top, x + handle_w, band_bot, handle_w, handle_w, handle)
                cx = x + handle_w / 2.0
            ny = (band_top + band_bot) / 2.0 - notch_h / 2.0
            canvas.drawRoundRect(cx - notch_w, ny, cx + notch_w, ny + notch_h, notch_w, notch_w, notch)

        cur = pad + usable * trim.cursor / trim.total
        cursor_paint = Paint(Paint.ANTI_ALIAS_FLAG)
        cursor_paint.setARGB(255, 255, 255, 255)
        cw = float(AndroidUtilities.dp(1.2))
        canvas.drawRoundRect(float(cur) - cw, 0.0, float(cur) + cw, height, cw, cw, cursor_paint)
        self.timeline.setImageBitmap(bitmap)
        length = (trim.end - trim.start) / 1000.0
        if self.timeline_text is not None:
            if self.audio_mode:
                self.timeline_text.setText(JString(localized(f"Выбрано {time_label(trim.start)} — {time_label(trim.end)} · {time_label(int(length * 1000))} из {time_label(trim.total)}", f"Selected {time_label(trim.start)} — {time_label(trim.end)} · {time_label(int(length * 1000))} of {time_label(trim.total)}")))
            else:
                self.timeline_text.setText(JString(f"{time_label(trim.start)} — {time_label(trim.end)}  ·  {length:.2f} / 60 s"))

    def request_frame(self, time_ms):
        if self._closed:
            return
        self._frame_serial += 1
        self._frame_request = (self._frame_serial, int(time_ms))
        if not self._frame_busy:
            self._decode_next_frame()

    def _decode_next_frame(self):
        if self._closed or self._frame_request is None:
            return
        serial, time_ms = self._frame_request
        self._frame_request = None
        self._frame_busy = True
        path = self.probe.path

        def work():
            t_fr = time.time()
            frame = None
            try:
                mmr = self._mmr
                if mmr is None:
                    mmr = MediaMetadataRetriever()
                    mmr.setDataSource(path)
                    self._mmr = mmr
                ratio = min(1.0, 640.0 / max(self.probe.width, self.probe.height))
                try:
                    frame = mmr.getScaledFrameAtTime(time_ms * 1000, MediaMetadataRetriever.OPTION_CLOSEST_SYNC, max(1, int(self.probe.width * ratio)), max(1, int(self.probe.height * ratio)))
                except Exception:
                    frame = mmr.getFrameAtTime(time_ms * 1000, MediaMetadataRetriever.OPTION_CLOSEST_SYNC)
            except Exception:
                frame = None
            slog(f"frame {time_ms} in {int((time.time() - t_fr) * 1000)} ms")
            run_on_ui_thread(lambda: self._accept_frame(serial, frame))

        threading.Thread(target=work, daemon=True).start()

    def _accept_frame(self, serial, frame):
        self._frame_busy = False
        if self._closed or serial != self._frame_serial:
            if frame is not None:
                frame.recycle()
        elif frame is not None:
            previous = self._display_frame
            self._display_frame = frame
            self.painter.frame = frame
            self.refresh()
            if previous is not None:
                previous.recycle()
        if not self._closed:
            self._decode_next_frame()

    def make_vtl_delegate(self):
        iface = JClass.forName("org.telegram.ui.Components.VideoTimelinePlayView$VideoTimelineViewDelegate")
        sheet = self

        class _Delegate(dynamic_proxy(iface)):
            def onLeftProgressChanged(self, progress):
                try:
                    sheet.on_native_left(float(progress))
                except Exception:
                    pass

            def onRightProgressChanged(self, progress):
                try:
                    sheet.on_native_right(float(progress))
                except Exception:
                    pass

            def onPlayProgressChanged(self, progress):
                try:
                    sheet.on_native_play(float(progress))
                except Exception:
                    pass

            def didStartDragging(self, type):
                pass

            def didStopDragging(self, type):
                try:
                    sheet_obj = self
                    sheet_obj._show_overlay()
                except Exception:
                    pass

        return _Delegate()

    def on_scrub_start(self, type):
        if type == 2:
            self._scrubbing = True
            self._seek_check = None
        elif type in (0, 1):
            self._trim_dragging = True
            self._resume_after_trim = False
            ap = getattr(self, "player", None)
            if ap is not None and self._ap_playing:
                self._ap_playing = False
                self._resume_after_trim = True
                try:
                    ap.pause()
                except Exception:
                    pass
            vp = getattr(self, "video_player", None)
            if vp is not None and self._vp_playing:
                self._vp_playing = False
                self._vp_paused = True
                self._resume_after_trim = True
                self._set_play_state(False)
                try:
                    vp.pause()
                except Exception:
                    pass

    def on_scrub_end(self, type):
        if type == 2:
            self._scrubbing = False
            pos = max(0, int(self.trim.cursor))
            self._seek_pin = pos
            self._seek_pin_ts = time.time()
            ap = getattr(self, "player", None)
            if ap is not None:
                try:
                    ap.seekTo(pos)
                except Exception as e:
                    slog(f"ap seek fail: {e}")
            vp = getattr(self, "video_player", None)
            if vp is not None:
                try:
                    vp.seekTo(pos, MediaPlayer.SEEK_CLOSEST)
                    slog(f"vp seek to {pos}")
                    self._seek_check = (time.time() + 0.7, pos, 0)
                except Exception as e:
                    slog(f"vp seek fail: {e}")
            slog(f"scrub end pos={pos} ap={ap is not None} vp={vp is not None} playing={getattr(self, '_vp_playing', False)}")
            return
        if type not in (0, 1):
            self._show_overlay()
            return
        self._trim_dragging = False
        self.trim.cursor = min(max(self.trim.cursor, self.trim.start), self.trim.end)
        resume = self._resume_after_trim
        self._resume_after_trim = False
        self._show_overlay()
        if not resume:
            return
        pos = int(self.trim.cursor)
        ap = getattr(self, "player", None)
        if ap is not None:
            try:
                ap.seekTo(max(pos, int(self.trim.start)))
                ap.start()
                self._ap_playing = True
                self._ap_tick()
            except Exception:
                pass
        vp = getattr(self, "video_player", None)
        if vp is not None:
            try:
                vp.seekTo(max(pos, int(self.trim.start)), MediaPlayer.SEEK_CLOSEST)
                vp.start()
                self._vp_playing = True
                self._vp_paused = False
                self._set_play_state(True)
                self._vp_tick()
            except Exception:
                pass

    def _pin_caret_to(self, pos_ms):
        if not self._trim_dragging:
            return
        total = max(1.0, float(self.trim.total))
        try:
            if getattr(self, "vtl", None) is not None:
                self.vtl.setProgress(min(1.0, pos_ms / total))
        except Exception:
            pass

    def _sync_from_native(self):
        self.probe.trim_ms = (self.trim.start, self.trim.end)
        self.update_timeline()

    def on_native_left(self, p):
        total = max(1.0, float(self.trim.total))
        self.trim.start = int(p * total)
        self.trim.cursor = self.trim.start
        self._sync_from_native()
        self._pin_caret_to(self.trim.start)

    def on_native_right(self, p):
        total = max(1.0, float(self.trim.total))
        self.trim.end = int(p * total)
        if self._trim_dragging:
            self.trim.cursor = self.trim.end
        self._sync_from_native()
        self._pin_caret_to(self.trim.end)

    def on_native_play(self, p):
        total = max(1.0, float(self.trim.total))
        self.trim.cursor = min(max(int(p * total), self.trim.start), self.trim.end)
        self._sync_from_native()
        if not self._closed and not getattr(self, "_vp_playing", False):
            self.request_frame(min(self.trim.cursor, self.trim.total - 1))

    def _set_play_state(self, playing):
        iv = getattr(self, "_icon_view", None)
        if iv is None:
            return
        res = pause_icon() if playing else play_icon()
        if res:
            try:
                iv.setImageResource(res)
                return
            except Exception:
                pass
        try:
            iv.setText(JString("❚❚" if playing else "▶"))
        except Exception:
            pass

    def on_video_surface_ready(self, surface_texture):
        if self._closed or not self._vp_pending:
            return
        self._vp_pending = False
        try:
            self._vp_start(Surface(surface_texture))
        except Exception as e:
            slog(f"vp surface start failed: {e}")
            self._vp_stop()

    def on_video_surface_gone(self):
        self._vp_stop()

    def _render_dim(self):
        iv = getattr(self, "dim_iv", None)
        if iv is None:
            return
        try:
            width, height = self.painter.width, self.painter.height
            bmp = getattr(self, "_dim_bmp", None)
            if bmp is None:
                bmp = Bitmap.createBitmap(width, height, Bitmap.Config.ARGB_8888)
                self._dim_bmp = bmp
            bmp.eraseColor(0)
            canvas = Canvas(bmp)
            off_x, off_y, draw_w, draw_h = self.painter.frame_box()
            radius = (min(draw_w, draw_h) / 2.0) / self.model.zoom
            cx = off_x + self.model.center_x * draw_w
            cy = off_y + self.model.center_y * draw_h
            hole = Path()
            hole.addCircle(cx, cy, radius, Path.Direction.CW)
            hole.setFillType(Path.FillType.INVERSE_WINDING)
            dim = Paint(Paint.ANTI_ALIAS_FLAG)
            dim.setARGB(225, 0, 0, 0)
            canvas.drawPath(hole, dim)
            ring = Paint(Paint.ANTI_ALIAS_FLAG)
            ring.setStyle(Paint.Style.STROKE)
            ring.setStrokeWidth(float(AndroidUtilities.dp(2)))
            ring.setARGB(255, 255, 255, 255)
            canvas.drawCircle(cx, cy, radius - AndroidUtilities.dp(1), ring)
            iv.setImageBitmap(bmp)
            iv.invalidate()
        except Exception as e:
            slog(f"dim render fail: {e}")

    def _vp_start(self, surface):
        p = MediaPlayer()
        p.setDataSource(self.probe.path)
        p.setSurface(surface)
        p.setOnPreparedListener(_MPPreparedListener(self, "video"))
        self.video_player = p
        self._render_dim()
        iv = getattr(self, "dim_iv", None)
        if iv is not None:
            iv.setVisibility(View.VISIBLE)
        p.prepareAsync()
        self._set_play_state(True)

    def on_media_prepared(self, mp, mode):
        if self._closed:
            return
        if mode == "video" and getattr(self, "video_player", None) is not None:
            pos = int(self.trim.cursor)
            if pos <= int(self.trim.start) or pos >= int(self.trim.end):
                pos = int(self.trim.start)
            mp.seekTo(pos, MediaPlayer.SEEK_CLOSEST)
            mp.start()
            self._vp_playing = True
            self._vp_paused = False
            self._vp_tick()
        elif mode == "audio" and getattr(self, "player", None) is not None:
            pos = int(self.trim.cursor)
            if pos <= int(self.trim.start) or pos >= int(self.trim.end):
                pos = int(self.trim.start)
            mp.seekTo(pos)
            mp.start()
            self._ap_playing = True
            self._ap_tick()

    def on_media_done(self, mp, mode):
        if mode == "video":
            self._vp_stop()
        else:
            self._ap_stop()

    def _vp_stop(self, show_icon=True):
        self._vp_playing = False
        self._vp_paused = False
        self._vp_pending = False
        p = getattr(self, "video_player", None)
        if p is not None:
            self.video_player = None
            try:
                p.stop()
            except Exception:
                pass
            try:
                p.release()
            except Exception:
                pass
        tv = getattr(self, "vtv", None)
        if tv is not None:
            try:
                tv.setVisibility(View.GONE)
            except Exception:
                pass
        iv = getattr(self, "dim_iv", None)
        if iv is not None:
            try:
                iv.setVisibility(View.GONE)
            except Exception:
                pass
        if show_icon:
            self._set_play_state(False)

    def _vp_tick(self):
        p = getattr(self, "video_player", None)
        if p is None or not self._vp_playing or self._closed:
            return
        try:
            pos = int(p.getCurrentPosition())
        except Exception:
            pos = 0
        chk = getattr(self, "_seek_check", None)
        if chk is not None:
            due, target, tries = chk
            if pos > target - 400:
                self._seek_check = None
            elif time.time() >= due:
                if tries >= 2:
                    slog(f"vp seek stuck: pos={pos} target={target}")
                    self._seek_check = None
                else:
                    try:
                        p.seekTo(target, MediaPlayer.SEEK_CLOSEST)
                        slog(f"vp re-seek to {target} (pos={pos})")
                    except Exception:
                        pass
                    self._seek_check = (time.time() + 0.7, target, tries + 1)
        total = max(1.0, float(self.trim.total))
        if not self._scrubbing:
            show = pos
            pin = getattr(self, "_seek_pin", None)
            if pin is not None:
                if abs(pos - pin) < 300 or time.time() - getattr(self, "_seek_pin_ts", 0.0) > 2.0:
                    self._seek_pin = None
                else:
                    show = pin
            try:
                if getattr(self, "vtl", None) is not None:
                    self.vtl.setProgress(min(1.0, show / total))
            except Exception:
                pass
            self.trim.cursor = min(max(int(show), self.trim.start), self.trim.end)
            self._sync_from_native()
        if pos >= int(self.trim.end) - 40:
            p.pause()
            self._vp_playing = False
            self._vp_paused = True
            self._set_play_state(False)
            return
        run_on_ui_thread(self._vp_tick, 50)

    def toggle_video_play(self, *_):
        try:
            if getattr(self, "video_player", None) is not None:
                p = self.video_player
                if self._vp_playing:
                    p.pause()
                    self._vp_playing = False
                    self._vp_paused = True
                    self._set_play_state(False)
                else:
                    try:
                        pos = int(p.getCurrentPosition())
                    except Exception:
                        pos = 0
                    pin = getattr(self, "_seek_pin", None)
                    if pin is not None and time.time() - getattr(self, "_seek_pin_ts", 0.0) < 10.0:
                        pos = int(pin)
                    if pos >= int(self.trim.end) - 50:
                        p.seekTo(int(self.trim.start), MediaPlayer.SEEK_CLOSEST)
                    p.start()
                    self._vp_playing = True
                    self._vp_paused = False
                    self._set_play_state(True)
                    self._vp_tick()
                return
            tv = getattr(self, "vtv", None)
            if tv is None:
                return
            self._ap_stop(show_btn=False)
            self._vp_pending = True
            self._set_play_state(True)
            tv.setVisibility(View.VISIBLE)
            st = tv.getSurfaceTexture()
            if st is None:
                return
            self._vp_pending = False
            self._vp_start(Surface(st))
        except Exception as e:
            slog(f"video play failed: {e}")
            toast(localized("Не удалось воспроизвести", "Could not play"))

    def _set_wave_bars(self, bars):
        if self._closed or not bars:
            return
        try:
            nz = [i for i, v in enumerate(bars) if float(v) > 0.05]
            if len(nz) > 8 and nz[-1] > nz[0]:
                a, b = nz[0], nz[-1]
                old = list(bars)
                stretched = []
                for k in range(len(old)):
                    pos = a + (b - a) * k / float(len(old) - 1)
                    i0 = int(pos)
                    f = pos - i0
                    s0 = float(old[i0])
                    s1 = float(old[min(len(old) - 1, i0 + 1)])
                    stretched.append(s0 + (s1 - s0) * f)
                bars = stretched
        except Exception:
            pass
        self.wave_bars = bars
        slog(f"wave bars set: {len(bars)}")
        vtl = getattr(self, "vtl", None)
        if vtl is not None:
            try:
                vtl.java.invalidate()
            except Exception:
                pass

    def build_wave(self):
        def work():
            path = self.probe.path
            try:
                if path in _WAVE_PREFETCH:
                    return

                bars = _WAVE_CACHE.get(path)
                if bars is None:
                    bars = _wave_cache_load(path)
                    if bars is not None:
                        _WAVE_CACHE[path] = bars

                if bars is None:
                    def part(peaks):
                        if self._closed or not peaks:
                            return
                        mx = max(peaks)
                        if mx <= 0:
                            return
                        partial = [min(1.0, p / mx) for p in peaks]
                        run_on_ui_thread(
                            lambda values=partial: self._set_wave_bars(values)
                        )

                    bars, _total = _decode_wave(path, 120, part)
                    _WAVE_CACHE[path] = bars
                    _wave_cache_save(path, bars)

                run_on_ui_thread(
                    lambda values=bars: self._set_wave_bars(values)
                )
            except Exception as e:
                slog(f"wave decode failed: {e}")

        threading.Thread(target=work, daemon=True).start()

    def _set_btn_state(self, playing):
        pb = getattr(self, "play_btn", None)
        if pb is None:
            return
        if playing:
            pb.setText(JString("■  " + localized("Остановить", "Stop")))
        else:
            pb.setText(JString("▶  " + localized("Прослушать отрезок", "Play the selected part")))

    def _ap_stop(self, show_btn=True):
        self._ap_playing = False
        p = getattr(self, "player", None)
        if p is not None:
            self.player = None
            try:
                p.stop()
            except Exception:
                pass
            try:
                p.release()
            except Exception:
                pass
        if show_btn:
            self._set_btn_state(False)

    def _ap_tick(self):
        p = getattr(self, "player", None)
        if p is None or not self._ap_playing or self._closed:
            return
        try:
            pos = int(p.getCurrentPosition())
        except Exception:
            pos = 0
        chk = getattr(self, "_seek_check", None)
        if chk is not None:
            due, target, tries = chk
            if pos > target - 400:
                self._seek_check = None
            elif time.time() >= due:
                if tries >= 2:
                    slog(f"ap seek stuck: pos={pos} target={target}")
                    self._seek_check = None
                else:
                    try:
                        p.seekTo(target)
                        slog(f"ap re-seek to {target} (pos={pos})")
                    except Exception:
                        pass
                    self._seek_check = (time.time() + 0.7, target, tries + 1)
        if not self._scrubbing:
            total = max(1.0, float(self.trim.total))
            show = pos
            pin = getattr(self, "_seek_pin", None)
            if pin is not None:
                if abs(pos - pin) < 300 or time.time() - getattr(self, "_seek_pin_ts", 0.0) > 2.0:
                    self._seek_pin = None
                else:
                    show = pin
            try:
                if getattr(self, "vtl", None) is not None:
                    self.vtl.setProgress(min(1.0, show / total))
            except Exception:
                pass
            self.trim.cursor = min(max(int(show), self.trim.start), self.trim.end)
        if pos >= int(self.trim.end) - 60:
            self._ap_stop()
            return
        run_on_ui_thread(self._ap_tick, 60)

    def toggle_play(self, *_):
        try:
            if getattr(self, "player", None) is not None:
                self._ap_stop()
                return
            p = MediaPlayer()
            p.setDataSource(self.probe.path)
            p.setOnPreparedListener(_MPPreparedListener(self, "audio"))
            p.setOnCompletionListener(_MPDoneListener(self, "audio"))
            self.player = p
            self._ap_playing = False
            p.prepareAsync()
            self._set_btn_state(True)
        except Exception as e:
            slog(f"play failed: {e}")
            toast(localized("Не удалось воспроизвести", "Could not play"))

    def release_preview(self):
        if self._closed:
            return
        self._closed = True
        try:
            if getattr(self, "vtl", None) is not None:
                self.vtl.sheet = None
                self.vtl.destroy()
                self.vtl = None
        except Exception:
            pass
        self._ap_stop(show_btn=False)
        self._vp_stop(show_icon=False)
        db = getattr(self, "_dim_bmp", None)
        if db is not None:
            self._dim_bmp = None
            try:
                db.recycle()
            except Exception:
                pass
        self._frame_serial += 1
        self._frame_request = None
        mmr = getattr(self, "_mmr", None)
        if mmr is not None:
            self._mmr = None
            try:
                mmr.release()
            except Exception:
                pass
        if self.image is not None:
            self.image.setImageDrawable(None)
        if self.timeline is not None:
            self.timeline.setImageDrawable(None)
        if self.painter is not None:
            self.painter.frame = None
        self.timeline_bitmap = None
        if self._display_frame is not None:
            self._display_frame.recycle()
            self._display_frame = None
        if not self._sending:
            self.probe.frame = None
        self._keep_alive.clear()

    def refresh(self):
        if self.audio_mode:
            try:
                self.label.setText(JString(""))
            except Exception:
                pass
            return
        try:
            bitmap = self.painter.render()
            self.image.setImageBitmap(bitmap)
            self.image.invalidate()
            side = int(self.model.side())
            self.label.setText(JString(localized(f"Область {side} × {side} из {self.probe.width} × {self.probe.height}", f"Crop {side} × {side} from {self.probe.width} × {self.probe.height}")))
        except Exception:
            pass
        self._render_dim()

    def on_drag(self, dx_px, dy_px):
        self._vp_stop()
        self._hide_overlay()
        off_x, off_y, draw_w, draw_h = self.painter.frame_box()
        if draw_w <= 0 or draw_h <= 0:
            return
        self.model.move(dx_px / float(draw_w), dy_px / float(draw_h))
        self.refresh()

    def on_zoom(self, value):
        self._vp_stop()
        self._hide_overlay()
        self.model.set_zoom(value)
        self.refresh()

    def _hide_overlay(self):
        try:
            ov = getattr(self, "overlay", None)
            if ov is not None and ov.getVisibility() != View.GONE:
                ov.setVisibility(View.GONE)
                self._overlay_hidden = True
        except Exception:
            pass

    def _show_overlay(self):
        try:
            ov = getattr(self, "overlay", None)
            if ov is not None and getattr(self, "_overlay_hidden", False):
                ov.setVisibility(View.VISIBLE)
                self._overlay_hidden = False
                try:
                    off_x, off_y, draw_w, draw_h = self.painter.frame_box()
                    if draw_w > 0 and draw_h > 0:
                        cx = off_x + self.model.center_x * draw_w
                        cy = off_y + self.model.center_y * draw_h
                        lp = ov.getLayoutParams()
                        lp.gravity = Gravity.TOP | Gravity.LEFT
                        lp.leftMargin = int(cx - lp.width / 2.0)
                        lp.topMargin = int(cy - lp.height / 2.0)
                        parent = ov.getParent()
                        if parent is not None:
                            parent.requestLayout()
                except Exception:
                    pass
        except Exception:
            pass

    def choose_resolution(self, *_):
        if self._sending or self._closed:
            return
        from org.telegram.ui.ActionBar import AlertDialog as TelegramAlertDialog
        sheet = self
        class Choice(dynamic_proxy(DialogInterface.OnClickListener)):
            def onClick(self, dialog, index):
                index = int(index)
                if sheet._closed or sheet._sending or not 0 <= index < len(ROUND_RESOLUTIONS):
                    return
                size = ROUND_RESOLUTIONS[index]
                sheet.model.output_size = size
                sheet.probe.round_size = size
                _SETTINGS['round_resolution'] = size
                plugin = getattr(sheet.probe, 'plugin', None)
                if plugin is not None:
                    plugin.set_setting('round_resolution', index)
                sheet.quality_label.setText(JString(localized('Разрешение: ', 'Resolution: ') + str(size) + ' × ' + str(size) + '  ▾'))
                dialog.dismiss()
        try:
            listener = Choice()
            self._keep_alive.append(listener)
            builder = TelegramAlertDialog.Builder(context())
            builder.setTitle(JString(localized('Разрешение кружка', 'Video message resolution')))
            items = JArray.newInstance(JClass.forName("java.lang.CharSequence"), len(ROUND_RESOLUTIONS))
            for index, size in enumerate(ROUND_RESOLUTIONS):
                JArray.set(items, index, JString(str(size) + ' × ' + str(size)))
            builder.setItems(items, listener)
            builder.show()
        except Exception as error:
            boot_log("resolution picker: %s: %s" % (type(error).__name__, error))
            toast(localized("Не удалось открыть выбор разрешения", "Could not open resolution picker"))

    def confirm(self):
        try:
            state = self.model.build_crop_state()
            self.on_confirm(self.probe, state, self.model.rect())
        except Exception:
            toast("Не удалось собрать кружок")


def native_edited_info(path):
    cls = resolve_class("org.telegram.messenger.SendMessagesHelper")
    method = find_method(cls, "createCompressionSettings")
    if method is None:
        return None

    params = array_items(method.getParameterTypes())
    args = [JString(path)]
    for kind in params[1:]:
        name = kind.getName()
        if name == "long":
            args.append(JLong(0))
        elif name == "int":
            args.append(JInteger(0))
        elif name == "boolean":
            args.append(JBoolean(False))
        else:
            args.append(None)

    try:
        info = method.invoke(None, args)
        slog(f"createCompressionSettings -> {'ok' if info is not None else 'None'}")
        return info
    except Exception:
        slog("createCompressionSettings invoke failed")
        return None


def round_estimated_size(info, duration_ms, output_size=None):
    size = round_resolution(output_size)
    original_w = get_field(info, "originalWidth") or 0
    original_h = get_field(info, "originalHeight") or 0
    original_bitrate = get_field(info, "bitrate") or 0
    bitrate = None
    try:
        method = find_method(resolve_class("org.telegram.messenger.MediaController"),
                             "makeVideoBitrate", 5)
        if method is not None:
            bitrate = int(method.invoke(None, [
                JInteger(int(original_h)), JInteger(int(original_w)),
                JInteger(int(original_bitrate)),
                JInteger(size), JInteger(size)]))
    except Exception:
        pass
    if not bitrate:
        bitrate = int(600000 * (size / float(ROUND_SIZE)) ** 2)

    encoder = None
    try:
        method = find_method(resolve_class("org.telegram.messenger.MediaController"),
                             "extractRealEncoderBitrate", 4)
        if method is not None:
            encoder = int(method.invoke(None, [
                JInteger(size), JInteger(size),
                JInteger(bitrate), JBoolean(False)]))
    except Exception:
        pass
    if not encoder:
        encoder = bitrate

    seconds = max(0.1, float(duration_ms) / 1000.0)
    audio = seconds * 16000.0
    return bitrate, encoder, int(seconds * encoder / 8.0 + audio) + 1


def viewer_trim_window_ms(total_ms, expected_path):
    cls = resolve_class(PHOTO_VIEWER)
    if cls is None:
        return -1, -1
    try:
        has = find_method(cls, "hasInstance", 0)
        if has is not None and not bool(has.invoke(None, None)):
            return -1, -1
    except Exception:
        return -1, -1
    getter = find_method(cls, "getInstance", 0)
    if getter is None:
        return -1, -1
    try:
        viewer = getter.invoke(None, None)
    except Exception:
        return -1, -1
    if viewer is None:
        return -1, -1
    current = get_field(viewer, "currentPathObject")
    if current is None:
        return -1, -1
    if expected_path is not None:
        try:
            if str(current) != str(expected_path):
                slog(f"viewer path mismatch: viewer={current} probe={expected_path}")
                return -1, -1
        except Exception:
            slog("viewer path compare failed")
            return -1, -1
    vis = get_field(viewer, "isVisible")
    if vis is not None and not bool(vis):
        slog("viewer not visible -> no trim window")
        return -1, -1
    start_raw = get_field(viewer, "startTime")
    end_raw = get_field(viewer, "endTime")
    try:
        start_us = int(start_raw)
    except Exception:
        start_us = -1
    try:
        end_us = int(end_raw)
    except Exception:
        end_us = -1
    if start_us < 0 and end_us <= 0:
        return -1, -1
    start_ms = 0 if start_us < 0 else start_us // 1000
    end_ms = int(total_ms) if end_us <= 0 else end_us // 1000
    if end_ms > int(total_ms) + 500:
        return -1, -1
    return start_ms, end_ms


def build_edited_info(probe, crop_state):
    size = round_resolution(getattr(probe, "round_size", None))
    set_typed_field(crop_state, "transformWidth", size)
    set_typed_field(crop_state, "transformHeight", size)
    try:
        total = int(probe.duration_ms)
    except Exception:
        total = 0
    slog(f"build_edited_info: total={total} ms path={probe.path}")
    info = native_edited_info(probe.path)
    if info is None:
        cls = resolve_class("org.telegram.messenger.VideoEditedInfo")
        if cls is None:
            return None
        try:
            info = cls.newInstance()
        except Exception:
            return None
        for name, value in (
            ("originalWidth", probe.width),
            ("originalHeight", probe.height),
            ("rotationValue", probe.rotation),
            ("originalPath", probe.path),
            ("startTime", -1),
            ("endTime", -1),
            ("framerate", 30),
            ("bitrate", 900000),
            ("estimatedDuration", int(probe.duration_ms)),
            ("originalDuration", int(probe.duration_ms) * 1000),
        ):
            set_typed_field(info, name, value)

    total_ms = int(probe.duration_ms)
    selected_trim = getattr(probe, "trim_ms", None)
    start_ms, end_ms = selected_trim if selected_trim is not None else viewer_trim_window_ms(total_ms, probe.path)
    if end_ms <= 0:
        if total_ms > ROUND_SAFE_MS:
            start_ms, end_ms = 0, int(total_ms)
        else:
            start_ms, end_ms = -1, -1
    if end_ms > 0:
        if end_ms - start_ms > ROUND_SAFE_MS:
            end_ms = start_ms + ROUND_SAFE_MS
        start_ms = max(0, int(start_ms))
        end_ms = min(int(end_ms), int(total_ms))
        if selected_trim is None and end_ms - start_ms < 1000:
            start_ms = max(0, end_ms - ROUND_SAFE_MS)
        if start_ms < ROUND_START_SHIFT_MS:
            start_ms = ROUND_START_SHIFT_MS
            if end_ms <= start_ms:
                end_ms = min(int(total_ms), start_ms + ROUND_SAFE_MS)
        start_us = start_ms * 1000
        end_us = end_ms * 1000
        written_start = set_typed_field(info, "startTime", start_us)
        written_end = set_typed_field(info, "endTime", end_us)
        try:
            ok_start = written_start is not None and int(written_start) == start_us
            ok_end = written_end is not None and int(written_end) == end_us
        except Exception:
            ok_start = ok_end = False
        if not (ok_start and ok_end):
            slog(f"trim window write failed: start={written_start} end={written_end}")
            return None
        set_typed_field(info, "estimatedDuration", int(end_ms - start_ms))
        duration = int(end_ms - start_ms)
        slog(f"trim window: {start_ms}-{end_ms} ms")
    else:
        duration = int(get_field(info, "estimatedDuration") or 0) or int(probe.duration_ms)
    bitrate, encoder, estimated = round_estimated_size(info, duration, size)

    max_est_size = 8388608
    if estimated > max_est_size:
        seconds = max(0.1, duration / 1000.0)
        audio_bytes = seconds * 16000.0
        cap = int(max(200000, (max_est_size - audio_bytes) * 8.0 / seconds))
        bitrate = min(bitrate, cap)
        encoder = min(encoder, cap)
        estimated = int(seconds * encoder / 8.0 + audio_bytes) + 1
        slog(f"size cap: est={estimated} bitrate={bitrate} encoder={encoder}")

    written = {}
    for name, value in (
        ("resultWidth", size),
        ("resultHeight", size),
        ("roundVideo", True),
        ("muted", False),
        ("bitrate", bitrate),
        ("estimatedSize", estimated),
    ):
        written[name] = set_typed_field(info, name, value)

    written["cropState"] = set_typed_field(info, "cropState", crop_state)

    slog(f"info fields: start={get_field(info, 'startTime')} end={get_field(info, 'endTime')} estDur={get_field(info, 'estimatedDuration')} round={written.get('roundVideo')} muted={written.get('muted')} estSize={written.get('estimatedSize')} crop={written.get('cropState') is not None}")


    if not bool(written.get("roundVideo")) or written.get("resultWidth") != size or written.get("resultHeight") != size:
        return None

    need = find_method(info.getClass(), "needConvert", 0)
    if need is not None:
        try:
            pass
        except Exception:
            pass

    return info


HOSTS = {"alert": None, "popup": None, "preview": None, "dumped": False}
PREVIEW_STATE = {"path": None, "doc": None, "ts": 0.0}
_INJECTED_OPTIONS = set()

_PREVIEW_TTL = 600.0


def preview_state_path():
    st = PREVIEW_STATE
    if st["path"] and (time.time() - st["ts"]) < _PREVIEW_TTL:
        return st["path"]
    return None


def preview_state_doc():
    st = PREVIEW_STATE
    if st["doc"] is not None and (time.time() - st["ts"]) < _PREVIEW_TTL:
        return st["doc"]
    return None


def dismiss_popup():
    window = HOSTS.get("popup")
    if window is not None:
        for name in ("dismiss", "dismissInternal"):
            method = find_method(window.getClass(), name, 0)
            if method is None:
                continue
            try:
                method.invoke(window, None)
                break
            except Exception:
                pass
    HOSTS["popup"] = None

    preview = HOSTS.get("preview")
    if preview is not None:
        for name in ("dismiss", "hide", "close"):
            method = find_method(preview.getClass(), name, 0)
            if method is None:
                continue
            try:
                method.invoke(preview, None)
                break
            except Exception:
                pass
    HOSTS["preview"] = None


def sibling_text_color(container):
    sub_cls = resolve_class("org.telegram.ui.ActionBar.ActionBarMenuSubItem")
    if sub_cls is None:
        return None
    for view in descendants(container):
        if not sub_cls.isInstance(view):
            continue
        label = get_field(view, "textView")
        if label is None:
            continue
        try:
            return int(label.getCurrentTextColor())
        except Exception:
            continue
    return None


def sibling_icon_color(container):
    sub_cls = resolve_class("org.telegram.ui.ActionBar.ActionBarMenuSubItem")
    if sub_cls is None:
        return None
    for view in descendants(container):
        if not sub_cls.isInstance(view):
            continue
        value = get_field(view, "iconColor")
        if value is None:
            continue
        try:
            return int(value)
        except Exception:
            continue
    return None


def item_icon_view(view):
    if view is None:
        return None
    icon = get_field(view, "imageView")
    if icon is not None:
        return icon
    image_cls = resolve_class("android.widget.ImageView")
    if image_cls is None:
        return None
    for sub in descendants(view):
        if image_cls.isInstance(sub):
            return sub
    return None


def item_text_color(view):
    if view is None:
        return None
    label = get_field(view, "textView")
    if label is None:
        text_cls = resolve_class("android.widget.TextView")
        if text_cls is not None:
            for sub in descendants(view):
                if text_cls.isInstance(sub):
                    label = sub
                    break
    if label is None:
        return None
    try:
        return int(label.getCurrentTextColor())
    except Exception:
        return None


def copy_icon_look(ours, sibling):
    if ours is None:
        return False
    ours_icon = item_icon_view(ours)
    if ours_icon is None:
        return False
    sib_icon = item_icon_view(sibling)
    if sib_icon is not None:
        try:
            flt = sib_icon.getColorFilter()
            if flt is not None:
                ours_icon.setColorFilter(flt)
                return True
        except Exception:
            pass
    color = item_text_color(sibling)
    if color is None:
        return False
    try:
        ours_icon.setColorFilter(PorterDuffColorFilter(color, PorterDuff.Mode.SRC_IN))
        return True
    except Exception:
        return False


def attach_alert_from_fragment():
    frag = get_last_fragment()
    if frag is None:
        return None
    for name in ("chatAttachAlert", "chatActivityAttachAlert", "attachAlert"):
        alert = get_field(frag, name)
        if alert is not None:
            return alert
    return None


def sender_visible():
    for alert in (HOSTS.get("alert"), attach_alert_from_fragment()):
        if alert is None:
            continue
        method = find_method(alert.getClass(), "isShowing", 0)
        if method is None:
            continue
        try:
            if bool(method.invoke(alert, None)):
                return True
        except Exception:
            continue

    cls = resolve_class(PHOTO_VIEWER)
    if cls is not None:
        has = find_method(cls, "hasInstance", 0)
        try:
            if has is None or bool(has.invoke(None, None)):
                getter = find_method(cls, "getInstance", 0)
                if getter is not None:
                    viewer = getter.invoke(None, None)
                    visible = find_method(cls, "isVisible", 0)
                    if visible is not None and bool(visible.invoke(viewer, None)):
                        return True
        except Exception:
            pass
    return False

def photo_layout(alert):
    if alert is None:
        return None
    getter = find_method(alert.getClass(), "getPhotoLayout", 0)
    if getter is not None:
        try:
            layout = getter.invoke(alert, None)
            if layout is not None:
                return layout
        except Exception:
            pass
    for name in ("photoLayout", "attachPhotoLayout"):
        layout = get_field(alert, name)
        if layout is not None:
            return layout
    return None


def clear_attach_selection(alert):
    if alert is None:
        return False
    cleared = False
    layout = photo_layout(alert)
    if layout is not None:
        method = find_method(layout.getClass(), "clearSelectedPhotos", 2)
        if method is not None:
            for flag in ((True, True), (True, False), (False, True)):
                try:
                    method.invoke(layout, [JBoolean(flag[0]), JBoolean(flag[1])])
                    cleared = True
                    break
                except Exception:
                    continue
        getter = find_method(layout.getClass(), "getSelectedPhotos", 0)
        if getter is not None:
            try:
                selected = getter.invoke(layout, None)
                if selected is not None and not selected.isEmpty():
                    selected.clear()
                    cleared = True
            except Exception:
                pass
        order_getter = find_method(layout.getClass(), "getSelectedPhotosOrder", 0)
        if order_getter is not None:
            try:
                order = order_getter.invoke(layout, None)
                if order is not None and not order.isEmpty():
                    order.clear()
                    cleared = True
            except Exception:
                pass
        for name in ("selectedPhotos", "selectedPhotosOrder", "photos"):
            container = get_field(layout, name)
            if container is not None:
                try:
                    container.clear()
                    cleared = True
                except Exception:
                    pass
        if cleared:
            updater = find_method(layout.getClass(), "updatePhotosButton", 2)
            if updater is not None:
                try:
                    updater.invoke(layout, [JBoolean(False), JBoolean(False)])
                except Exception:
                    pass
    for name in ("selectedPhotos", "selectedPhotosOrder", "photos"):
        container = get_field(alert, name)
        if container is not None:
            try:
                container.clear()
                cleared = True
            except Exception:
                pass
    return cleared


def close_hosts():
    cls = resolve_class(PHOTO_VIEWER)
    if cls is not None:
        has = find_method(cls, "hasInstance", 0)
        alive = True
        if has is not None:
            try:
                alive = bool(has.invoke(None, None))
            except Exception:
                alive = True
        if alive:
            getter = find_method(cls, "getInstance", 0)
            if getter is not None:
                try:
                    viewer = getter.invoke(None, None)
                    closer = find_method(viewer.getClass(), "closePhoto", 2)
                    if closer is not None:
                        closer.invoke(viewer, [JBoolean(False), JBoolean(False)])
                    else:
                        pass
                except Exception:
                    pass

    alert = HOSTS.get("alert")
    if alert is None:
        alert = attach_alert_from_fragment()

    if alert is not None:
        clear_attach_selection(alert)
        for name in ("dismissInternal", "dismiss", "hide"):
            method = find_method(alert.getClass(), name, 0)
            if method is None:
                continue
            try:
                method.invoke(alert, None)
                break
            except Exception:
                pass

    frag = get_last_fragment()
    if frag is not None:
        if alert is None:
            live = attach_alert_from_fragment()
            if live is not None:
                clear_attach_selection(live)
        for name in ("dismissCurrentDialog", "closeChatAttachAlert"):
            method = find_method(frag.getClass(), name, 0)
            if method is None:
                continue
            try:
                method.invoke(frag, None)
                break
            except Exception:
                continue


def find_static_send():
    cls = resolve_class("org.telegram.messenger.SendMessagesHelper")
    if cls is None:
        return None, 0
    best = None
    best_count = 0
    try:
        methods = array_items(cls.getDeclaredMethods())
    except Exception:
        methods = []
    for m in methods:
        try:
            if m.getName() != "prepareSendingVideo":
                continue
            count = JArray.getLength(m.getParameterTypes())
            if best is None or count < best_count:
                best = m
                best_count = count
        except Exception:
            continue
    if best is not None:
        try:
            best.setAccessible(True)
        except Exception:
            pass
    return best, best_count


def resolve_dialog_id(frag):
    for name in ("dialog_id", "dialogId"):
        value = get_field(frag, name)
        if value:
            try:
                return int(value)
            except Exception:
                continue
    method = find_method(frag.getClass(), "getDialogId", 0)
    if method is not None:
        try:
            return int(method.invoke(frag, None))
        except Exception:
            pass
    return 0


def square_thumb(frame, rect, size=320):
    if frame is None or rect is None:
        return None
    try:
        left, top, side = rect
        left = max(0, min(int(left), frame.getWidth() - 1))
        top = max(0, min(int(top), frame.getHeight() - 1))
        side = max(1, min(int(side), frame.getWidth() - left, frame.getHeight() - top))
        cut = Bitmap.createBitmap(frame, left, top, side, side)
        scaled = Bitmap.createScaledBitmap(cut, size, size, True)
        try:
            from org.telegram.messenger import Utilities
            Utilities.blurBitmap(scaled, 3, 1, scaled.getWidth(),
                                 scaled.getHeight(), scaled.getRowBytes())
        except Exception:
            pass
        return scaled
    except Exception:
        return None


def replace_round_thumb(frame, rect):
    bitmap = square_thumb(frame, rect)
    if bitmap is None:
        return

    frag = get_last_fragment()
    messages = get_field(frag, "messages") if frag is not None else None
    if messages is None:
        return
    try:
        msg = messages.get(0)
    except Exception:
        return

    owner = get_field(msg, "messageOwner")
    media = get_field(owner, "media") if owner is not None else None
    document = get_field(media, "document") if media is not None else None
    if document is None:
        return
    try:
        thumbs = document.thumbs
        if int(thumbs.size()) == 0:
            return
        size = thumbs.get(0)
    except Exception:
        return

    location = get_field(size, "location")
    volume = get_field(location, "volume_id") if location is not None else None
    local = get_field(location, "local_id") if location is not None else None

    try:
        side_dp = int(AndroidUtilities.roundMessageSize / AndroidUtilities.density)
        key = f"{volume}_{local}@{side_dp}_{side_dp}_b"
        from org.telegram.messenger import ImageLoader
        drawable = BitmapDrawable(bitmap)
        ImageLoader.getInstance().putImageToCache(drawable, key, False)
    except Exception:
        pass

    try:
        account = UserConfig.selectedAccount
        path = FileLoader.getInstance(account).getPathToAttach(size, True)
        if path is not None:
            from java.io import FileOutputStream
            stream = FileOutputStream(path)
            bitmap.compress(Bitmap.CompressFormat.JPEG, 87, stream)
            stream.close()
    except Exception:
        pass

    for name in ("chatAdapter", "chatListView"):
        holder = get_field(frag, name)
        if holder is None:
            continue
        method = find_method(holder.getClass(), "notifyDataSetChanged", 0)
        if method is None:
            continue
        try:
            method.invoke(holder, None)
            break
        except Exception:
            pass


def topic_pair(instance, frag, dialog_id):
    topic_id = 0
    try:
        method = find_method(frag.getClass(), "getTopicId", 0)
        if method is not None:
            topic_id = int(method.invoke(frag, None) or 0)
    except Exception:
        topic_id = 0
    if not topic_id:
        return None, None

    try:
        method = find_method(frag.getClass(), "getThreadMessage", 0)
        if method is not None:
            thread = method.invoke(frag, None)
            if thread is not None:
                if not bool(get_field(thread, "isTopicMainMessage") or False):
                    set_typed_field(thread, "isTopicMainMessage", True)
                return thread, thread
    except Exception:
        pass

    try:
        mc = instance.getMessagesController()
        topics = mc.getTopicsController()
        finder = find_method(topics.getClass(), "findTopic", 2)
        if finder is None:
            return None, None
        topic = finder.invoke(topics, [JLong.valueOf(-int(dialog_id)), JLong.valueOf(int(topic_id))])
        start = get_field(topic, "topicStartMessage") if topic is not None else None
        if start is None:
            return None, None
        mo_cls = resolve_class("org.telegram.messenger.MessageObject")
        ctor = None
        for candidate in array_items(mo_cls.getDeclaredConstructors()):
            kinds = [p.getName() for p in candidate.getParameterTypes()]
            if kinds == ["int", "org.telegram.tgnet.TLRPC$Message", "boolean", "boolean"]:
                ctor = candidate
                break
        if ctor is None:
            return None, None
        ctor.setAccessible(True)
        mo = ctor.newInstance([JInteger(int(UserConfig.selectedAccount)), start, JBoolean(False), JBoolean(False)])
        set_typed_field(mo, "isTopicMainMessage", True)
        return mo, mo
    except Exception:
        return None, None


def once_allowed(frag, account):
    if frag is None:
        return False
    try:
        did = resolve_dialog_id(frag)
        if did <= 0 or get_field(frag, "currentEncryptedChat") is not None:
            return False
        instance = AccountInstance.getInstance(account)
        if did == int(instance.getUserConfig().getClientUserId()):
            return False
        user = instance.getMessagesController().getUser(JLong(did))
        return user is not None and not bool(user.bot) and not bool(user.deleted)
    except Exception:
        return False


def send_round(probe, crop_state, rect=None):
    plugin = getattr(probe, 'plugin', None)
    if plugin is not None and not plugin._alive:
        return False
    frag = get_last_fragment()
    if frag != getattr(probe, "target_fragment", frag) or int(UserConfig.selectedAccount) != getattr(probe, "account", int(UserConfig.selectedAccount)):
        toast(localized("Чат или аккаунт изменился", "Chat or account changed"))
        return False
    ttl = getattr(probe, "ttl", 0)
    if ttl and not once_allowed(frag, int(UserConfig.selectedAccount)):
        toast(localized("Одноразовые сообщения доступны только в личном чате с пользователем", "View-once messages require a private chat with another user"))
        return False
    if frag is None:
        toast("Нет открытого чата")
        return False

    dialog_id = resolve_dialog_id(frag)
    saved_context = getattr(probe, "send_context", None)
    if saved_context is not None and (int(saved_context["dialog_id"]) != int(dialog_id) or int(saved_context["topic_id"]) != int(context_value(frag, "getTopicId") or 0) or int(saved_context["mono_peer"]) != int(context_value(frag, "getSendMonoForumPeerId") or 0)):
        toast(localized("Чат или тема изменились. Откройте превью заново", "Chat or topic changed. Open preview again"))
        return False
    if not dialog_id:
        toast("Не понял, в какой чат отправлять")
        return False

    info = build_edited_info(probe, crop_state)
    if info is None:
        toast("Не удалось подготовить видео")
        return False

    method, count = find_static_send()
    if method is None:
        toast("Метод отправки не найден")
        return False
    slog(f"prepareSendingVideo: params={count}")


    account = UserConfig.selectedAccount
    try:
        instance = AccountInstance.getInstance(account)
    except Exception:
        toast("Не удалось получить аккаунт")
        return False

    sending = saved_context if saved_context is not None else capture_round_context(frag, int(account))

    args = [
        instance,
        JString(probe.path),
        info,
        None,
        None,
        JLong(int(dialog_id)),
        sending["reply"] if sending["reply"] is not None else sending["top"],
        sending["top"],
        None,
        sending["quote"],
        None,
        JInteger(ttl),
        None,
        JBoolean(True),
        JInteger(0),
        JInteger(0),
        JBoolean(False),
        JBoolean(False),
        None,
        sending["chat_args"],
        JLong(0),
        JLong(0),
        JLong(sending["mono_peer"]),
    ]

    if count > len(args):
        params = array_items(method.getParameterTypes())
        for index in range(len(args), count):
            kind = params[index].getName() if index < len(params) else ""
            if kind == "boolean":
                args.append(JBoolean(False))
            elif kind == "int":
                args.append(JInteger(0))
            elif kind == "long":
                args.append(JLong(0))
            else:
                args.append(None)
    elif count < len(args):
        args = args[:count]

    def fire():
        status = None
        try:
            if get_last_fragment() != frag or int(UserConfig.selectedAccount) != int(account) or resolve_dialog_id(frag) != int(dialog_id):
                toast(localized('Чат или аккаунт изменился', 'Chat or account changed'))
                return
            plugin = getattr(probe, 'plugin', None)
            if plugin is not None and plugin._alive and bool(plugin.get_setting('round_upload_status', True)):
                status = RoundUploadStatus(plugin, probe, sending, info)
                try:
                    status.start()
                except Exception as exc:
                    status.stop()
                    slog('round status unavailable: ' + str(exc))
            method.invoke(None, args)
            slog("prepareSendingVideo invoked ok")
            run_on_ui_thread(close_hosts, 60)
        except Exception:
            if status is not None:
                status.stop()
            toast(localized("Не удалось отправить кружок", "Could not send video message"))

    try:
        run_on_ui_thread(fire, 0)
    except Exception:
        toast(localized('Не удалось начать отправку', 'Could not start sending'))
        return False
    if not ttl:
        try:
            run_on_ui_thread(lambda: replace_round_thumb(probe.frame, rect), 700)
        except Exception:
            pass
    return True

class ButtonSeekHook(MethodHook):
    def __init__(self, plugin, field_name):
        super().__init__()
        self.plugin = plugin
        self.field_name = field_name
        self.done = False

    def after_hooked_method(self, param):
        try:
            if self.field_name == "writeButton":
                HOSTS["alert"] = param.thisObject
                if not HOSTS.get("dumped"):
                    HOSTS["dumped"] = True
        except Exception:
            pass
        if self.done:
            return
        try:
            cls = listener_class(param.thisObject, self.field_name)
            if cls is None:
                return
            method = find_method(cls, "onLongClick", 1)
            if method is None:
                return
            boot_log("HOOK longclick listener")
            ref = self.plugin.hook_method(method, SendLongClickHook())
            if ref is not None:
                self.plugin._hooks.append(ref)
                self.done = True
                boot_log("HOOK longclick ok")
            else:
                boot_log("HOOK longclick ref None")
        except Exception:
            boot_log("HOOK longclick fail")
            pass

