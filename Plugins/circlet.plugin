class _VPSurfaceListener(dynamic_proxy(TextureView.SurfaceTextureListener)):
    def __init__(self, sheet):
        super().__init__()
        self.sheet = sheet

    def onSurfaceTextureAvailable(self, surface_texture, width, height):
        s = self.sheet
        if s is not None:
            try:
                s.on_video_surface_ready(surface_texture)
            except Exception as e:
                slog(f"surface available fail: {e}")

    def onSurfaceTextureSizeChanged(self, surface_texture, width, height):
        return None

    def onSurfaceTextureDestroyed(self, surface_texture):
        s = self.sheet
        if s is not None:
            _safe(s.on_video_surface_gone)
        return True

    def onSurfaceTextureUpdated(self, surface_texture):
        return None


class _MPPreparedListener(dynamic_proxy(MediaPlayer.OnPreparedListener)):
    def __init__(self, sheet, mode):
        super().__init__()
        self.sheet = sheet
        self.mode = mode

    def onPrepared(self, mp):
        s = self.sheet
        if s is not None:
            try:
                s.on_media_prepared(mp, self.mode)
            except Exception as e:
                slog(f"media prepared fail: {e}")


class _MPDoneListener(dynamic_proxy(MediaPlayer.OnCompletionListener)):
    def __init__(self, sheet, mode):
        super().__init__()
        self.sheet = sheet
        self.mode = mode

    def onCompletion(self, mp):
        s = self.sheet
        if s is not None:
            try:
                s.on_media_done(mp, self.mode)
            except Exception as _exc:
                slog(f"onCompletion: {_exc}")


def round_icon():
    if _ICON_CACHE[0] is not None:
        return _ICON_CACHE[0]
    res = 0
    try:
        from org.telegram.messenger import ApplicationLoader
        ctx = ApplicationLoader.applicationContext
        pkg = ctx.getPackageName()
        for name in ICON_CANDIDATES:
            try:
                found = int(ctx.getResources().getIdentifier(name, "drawable", pkg))
            except Exception:
                found = 0
            if found:
                res = found
                break
    except Exception as _exc:
        slog(f"round_icon: {_exc}")
    _ICON_CACHE[0] = res
    return res


def theme_color(*names, resources_provider=None):
    for name in names:
        key = getattr(Theme, name, None)
        if key is None:
            continue
        if resources_provider is not None:
            val = _safe(lambda k=key: int(Theme.getColor(k, resources_provider)))
            if val is not None and _rgba(val)[0] >= 16:
                return _jcolor(val)
        val = _safe(lambda k=key: int(Theme.getColor(k)))
        if val is not None and _rgba(val)[0] >= 16:
            return _jcolor(val)
    return None


def apply_submenu_colors(item, neighbour=None, icon=None):
    text = neighbour
    if text is None:
        text = theme_color("key_actionBarDefaultSubmenuItem", "key_dialogTextBlack")
    if icon is None:
        icon = text
    if text is None or icon is None:
        return
    method = find_method(item.getClass(), "setColors", 2)
    if method is None:
        return
    try:
        method.invoke(item, [JInteger(text), JInteger(icon)])
    except Exception as _exc:
        slog(f"apply_submenu_colors: {_exc}")


class ClickRunnable(dynamic_proxy(JRunnable)):
    def __init__(self, handler):
        super().__init__()
        self.handler = handler

    def run(self):
        try:
            self.handler()
        except Exception as _exc:
            slog(f"run: {_exc}")


def is_track_path(path):
    if path is None:
        return False
    try:
        s = str(path).lower()
    except Exception:
        return False
    if s.startswith("audio/") or s.startswith("video/ogg"):
        return True
    if s.endswith((".mp3", ".m4a", ".aac", ".ogg", ".opus", ".wav", ".flac", ".amr", ".oga", ".wma")):
        return True
    return False


def media_kind(path):
    if is_track_path(path):
        return "audio"
    if is_video_path(path):
        return "video"
    if path and str(path).lower().endswith((".mp3", ".m4a", ".aac", ".ogg", ".opus", ".wav", ".flac", ".amr")):
        return "audio"
    return None


def safe_kind(value):
    try:
        return media_kind(str(value))
    except Exception:
        return None


def path_from_entry(entry):
    if entry is None:
        return None
    try:
        if safe_kind(entry):
            return str(entry)
    except Exception as _exc:
        slog(f"path_from_entry: {_exc}")
    try:
        raw = get_field(entry, "path")
    except Exception:
        raw = None
    if raw is not None and safe_kind(raw):
        return str(raw)
    try:
        owner = get_field(entry, "messageOwner")
    except Exception:
        owner = None
    if owner is not None:
        try:
            raw = get_field(owner, "attachPath")
        except Exception:
            raw = None
        if raw is not None and safe_kind(raw):
            return str(raw)
        try:
            media = get_field(owner, "media")
            doc = get_field(media, "document") if media is not None else None
            if doc is not None:
                mime = str(getattr(doc, "mime_type", "") or "").lower()
                fl = resolve_class("org.telegram.messenger.FileLoader")
                fpath = None
                if fl is not None:
                    fpath = audio_document_path(doc)
                is_audio = mime.startswith("audio/")
                if not is_audio:
                    try:
                        from org.telegram.messenger import FileLoader as _FL
                        fname = str(_FL.getDocumentFileName(doc) or "")
                    except Exception:
                        fname = ""
                    is_audio = fname.lower().endswith((".mp3", ".m4a", ".aac", ".ogg", ".opus", ".wav", ".flac", ".amr"))
                if is_audio and fpath:
                    return fpath
        except Exception as _exc:
            slog(f"path_from_entry: {_exc}")
    try:
        for f in _cached_fields(entry.getClass()):
            try:
                v = f.get(entry)
            except Exception:
                continue
            if v is None:
                continue
            if safe_kind(v):
                return str(v)
            inner = get_field(v, "path")
            if inner is not None and safe_kind(inner):
                return str(inner)
    except Exception as _exc:
        slog(f"path_from_entry: {_exc}")
    return None

def make_temporary_audio_copy(source):
    import shutil
    import tempfile

    base = str(context().getExternalFilesDir(None).getAbsolutePath())
    folder = os.path.join(base, "Circlet", "temporary")
    os.makedirs(folder, exist_ok=True)

    suffix = os.path.splitext(source)[1] or ".audio"
    fd, destination = tempfile.mkstemp(prefix="source_", suffix=suffix, dir=folder)
    os.close(fd)

    try:
        shutil.copyfile(source, destination)
        return destination
    except Exception:
        try:
            os.remove(destination)
        except Exception as _exc:
            slog(f"make_temporary_audio_copy: {_exc}")
        raise


def remove_temporary_audio(path):
    if not path:
        slog("temporary audio cleanup: path not set")
        return

    try:
        ctx = context()
        base = os.path.realpath(
            os.path.join(
                str(ctx.getExternalFilesDir(None).getAbsolutePath()),
                "Circlet",
                "temporary",
            )
        )
        target = os.path.realpath(str(path))

        if os.path.dirname(target) != base:
            slog(f"temporary audio cleanup: refused {target}")
            return

        if os.path.isfile(target):
            os.remove(target)
            slog(f"temporary audio removed: {target}")
        else:
            slog(f"temporary audio cleanup: already absent {target}")
    except Exception as e:
        slog(f"temporary audio cleanup failed: {e}")

def audio_document_path(doc):
    if doc is None:
        return None

    try:
        from org.telegram.messenger import FileLoader as FL

        cls = resolve_class("org.telegram.messenger.FileLoader")
        if cls is None:
            return None

        instance = FL.getInstance(int(UserConfig.selectedAccount))

        for count in (1, 2):
            for method in array_items(cls.getMethods()):
                if str(method.getName()) != "getPathToAttach":
                    continue

                types = array_items(method.getParameterTypes())
                if len(types) != count:
                    continue
                if str(types[0].getName()) != "org.telegram.tgnet.TLObject":
                    continue
                if count == 2 and str(types[1].getName()) != "boolean":
                    continue

                target = None if int(method.getModifiers()) & 8 else instance
                args = [doc] if count == 1 else [doc, JBoolean(False)]

                try:
                    result = method.invoke(target, args)
                    if result is not None:
                        path = str(result.getAbsolutePath())
                        return path
                except Exception as e:
                    slog(f"getPathToAttach invoke failed: {e}")

    except Exception as e:
        slog(f"audio_document_path failed: {e}")

    return None

def selected_attachment_message(alert):
    if alert is None:
        return None
    for layout_name, mname in (("audioLayout", "getSelected"), ("documentLayout", "getSelectedFiles"), ("photoLayout", "getSelectedPhotos")):
        try:
            layout = get_field(alert, layout_name)
            if layout is None:
                continue
            m = find_method(layout.getClass(), mname, 0)
            if m is None:
                continue
            sel = m.invoke(layout, None)
            if sel is None:
                continue
            try:
                if int(sel.size()) != 1:
                    continue
                item = sel.get(0)
                if item is not None:
                    return item
            except Exception:
                continue
        except Exception:
            continue
    return None


def _hier_fields(obj, max_depth=4):
    out = []
    try:
        cls = obj.getClass()
    except Exception:
        return out
    depth = 0
    while cls is not None and depth < max_depth:
        try:
            fs = array_items(cls.getDeclaredFields())
        except Exception:
            fs = []
        for f in fs or []:
            try:
                f.setAccessible(True)
                out.append((str(f.getName()), f.get(obj)))
            except Exception:
                continue
        try:
            cls = cls.getSuperclass()
        except Exception:
            break
        depth += 1
    return out


def _audio_doc_from_entry(entry):
    if entry is None:
        return None
    media = get_field(entry, "media")
    if media is not None:
        doc = get_field(media, "document")
        if doc is not None:
            return doc
    mo = get_field(entry, "messageObject") or get_field(entry, "message") or get_field(entry, "messageOwner")
    if mo is not None:
        media = get_field(mo, "media")
        if media is None:
            owner = get_field(mo, "messageOwner")
            media = get_field(owner, "media") if owner is not None else None
        doc = get_field(media, "document") if media is not None else None
        if doc is not None:
            return doc
    doc = get_field(entry, "document")
    if doc is not None:
        return doc
    try:
        mime = str(getattr(entry, "mime_type", "") or "").lower()
        if mime.startswith("audio/"):
            return entry
    except Exception as _exc:
        slog(f"_audio_doc_from_entry: {_exc}")
    return None


def deep_selected_audio(alert, deadline=None):
    if alert is None:
        return None
    pairs = _hier_fields(alert, 4)
    for nm, v in pairs:
        try:
            if deadline and time.time() > deadline:
                return None
            if v is None or "ArrayList" not in str(v.getClass().getName()):
                continue
            if int(v.size()) != 1:
                continue
            item = v.get(0)
        except Exception:
            continue
        p = path_from_entry(item)
        if p and media_kind(p) == "audio":
            return p
    for nm, v in pairs:
        try:
            if deadline and time.time() > deadline:
                return None
            if v is None:
                continue
            cn = str(v.getClass().getName())
        except Exception:
            continue
        if "ArrayList" in cn or cn.startswith("java.") or cn.startswith("android."):
            continue
        pairs2 = _hier_fields(v, 1)
        for nm2, v2 in pairs2:
            try:
                if v2 is None or "ArrayList" not in str(v2.getClass().getName()):
                    continue
                if int(v2.size()) != 1:
                    continue
                item2 = v2.get(0)
            except Exception:
                continue
            p2 = path_from_entry(item2)
            if p2 and media_kind(p2) == "audio":
                return p2
    return None


def _build_waveform(bars):
    try:
        if not bars:
            return None
        n = len(bars)
        take = 126
        vals = []
        for k in range(take):
            v = bars[min(n - 1, int(k * (n - 1) / float(max(1, take - 1))))]
            iv = int(round(float(v) * 15.0))
            if iv < 0:
                iv = 0
            if iv > 15:
                iv = 15
            vals.append(iv)
        data = bytearray()
        for k in range(0, take, 2):
            hi = vals[k]
            lo = vals[k + 1] if k + 1 < take else 0
            data.append((hi << 4) | lo)
        while len(data) < 63:
            data.append(0)
        return bytes(data[:63])
    except Exception:
        return None


def music_row_path(view):
    if view is None:
        return None
    mo = None
    for name in ("messageObject", "currentMessageObject", "message"):
        try:
            mo = get_field(view, name)
        except Exception:
            mo = None
        if mo is not None:
            break
    if mo is None:
        return None
    owner = get_field(mo, "messageOwner")
    media = get_field(owner, "media") if owner is not None else None
    doc = get_field(media, "document") if media is not None else None
    if doc is None:
        return None
    mime = str(getattr(doc, "mime_type", "") or "").lower()
    try:
        from org.telegram.messenger import FileLoader as _FL
        fname = str(_FL.getDocumentFileName(doc) or "")
    except Exception:
        fname = ""
    if not (mime.startswith("audio/") or fname.lower().endswith((".mp3", ".m4a", ".aac", ".ogg", ".opus", ".wav", ".flac", ".amr"))):
        return None
    return mo, path_from_entry(mo)


def selected_attachment_path(alert):
    if alert is None:
        return None
    for layout_name, mname in (("audioLayout", "getSelected"), ("documentLayout", "getSelectedFiles"), ("photoLayout", "getSelectedPhotos")):
        try:
            layout = get_field(alert, layout_name)
            if layout is None:
                continue
            m = find_method(layout.getClass(), mname, 0)
            if m is None:
                continue
            sel = m.invoke(layout, None)
            if sel is None:
                continue
            try:
                if int(sel.size()) != 1:
                    continue
            except Exception:
                continue
            item = sel.get(0)
            if layout_name == "audioLayout":
                direct = path_from_entry(item)
                if direct and media_kind(direct) == "audio" and os.path.isfile(direct):
                    doc = _audio_doc_from_entry(item)
                    if doc is not None:
                        ARMED["doc"] = doc
                        ARMED["mo"] = item
                    slog(f"selected local audio path={direct}")
                    return direct
                doc = _audio_doc_from_entry(item)
                if doc is not None:
                    found = audio_document_path(doc)
                    slog(f"selected audio doc path={found}")
                    if found:
                        ARMED["doc"] = doc
                        ARMED["mo"] = item
                        return found
            found = path_from_entry(item)
            if found:
                return found
        except Exception:
            continue
    for name in ("selectedAudios", "selectedDocs", "selectedMusic", "selectedFiles", "selectedPhotos", "selectedDocuments"):
        try:
            sel = get_field(alert, name)
            if sel is None:
                continue
            try:
                if int(sel.size()) != 1:
                    continue
            except Exception:
                continue
            item = sel.get(0)
            found = path_from_entry(item)
            if found:
                return found
        except Exception:
            continue
    return None


def menu_caption(path, once=False):
    if media_kind(path) == "audio":
        return localized("Отправить одноразовым ГС", "Send as one-time voice") if once else localized("Отправить как ГС", "Send as voice message")
    return localized("Отправить с одним просмотром", "Send with one view") if once else localized("Отправить кружком", "Send as video message")


def resolve_send_path():
    path = photoviewer_path()
    if path:
        return path
    alert = attach_alert_from_fragment()
    if alert is not None:
        path = selected_video_path(alert) or selected_attachment_path(alert)
        if path:
            return path
        holder = _safe(get_surrounding, alert, default=None)
        if holder is not None and holder is not alert:
            path = selected_video_path(holder) or selected_attachment_path(holder)
            if path:
                return path
    if not sender_visible():
        return None
    frag = get_last_fragment()
    if frag is not None:
        for name in ("chatAttachAlert", "chatActivityAttachAlert"):
            holder = get_field(frag, name)
            if holder is None or holder is alert:
                continue
            path = selected_video_path(holder) or selected_attachment_path(holder)
            if path:
                return path
    if ARMED["active"] and ARMED["path"]:
        return ARMED["path"]
    return None


def resolve_live_media_path():
    alert = attach_alert_from_fragment()
    if alert is not None:
        try:
            path = selected_attachment_path(alert) or selected_video_path(alert)
            if path:
                return path
        except Exception as e:
            boot_log("LIVE resolve fail %s" % e)
    return photoviewer_path()


_VOICE_ONCE_PATHS = {}
_VOICE_ONCE_LOCK = threading.Lock()
class SendPipelineHook(MethodHook):
    def __init__(self, tag, plugin=None):
        super().__init__()
        self.tag = tag
        self.plugin = plugin

    @staticmethod
    def _mark(arg):
        try:
            if arg is None:
                return None
            doc = None
            try:
                owner = get_field(arg, "messageOwner")
                media = get_field(owner, "media") if owner is not None else None
                doc = get_field(media, "document") if media is not None else None
            except Exception:
                doc = None
            if doc is None:
                try:
                    doc = get_field(arg, "document")
                except Exception:
                    doc = None
            if doc is not None:
                lp = get_field(doc, "localPath")
                if lp and "circlet_" in str(lp):
                    return "circlet-voice"
            return None
        except Exception:
            return None

    def before_hooked_method(self, param):
        if self.tag != "sendMessage":
            return

        try:
            args = param.args or []
            if not args or args[0] is None:
                return

            obj = args[0]
            if self.plugin is not None:
                for status in list(self.plugin._round_uploads):
                    if status.active:
                        status.bind(obj)
                voice_progress = getattr(self.plugin, "_voice_progress", None)
                if voice_progress is not None and voice_progress.active:
                    voice_progress.bind(obj)
            if "SendMessageParams" not in str(obj.getClass().getName()):
                return

            path = get_field(obj, "path")
            if path is None:
                return

            path = str(path)

            with _VOICE_ONCE_LOCK:
                deadline = _VOICE_ONCE_PATHS.get(path)
                if deadline is None:
                    return

                if time.time() > deadline:
                    _VOICE_ONCE_PATHS.pop(path, None)
                    slog("voice once: matching params expired")
                    return

                written = set_typed_field(obj, "ttl", ONCE_TTL)
                if written is None or int(written) != ONCE_TTL:
                    slog("voice once: could not set SendMessageParams.ttl")
                    return

                _VOICE_ONCE_PATHS.pop(path, None)

            slog("voice once: SendMessageParams.ttl applied to " + os.path.basename(path))
        except Exception as e:
            slog(f"voice once: params hook failed: {type(e).__name__}: {e}")

    def after_hooked_method(self, param):
        try:
            for a in (param.args or []):
                d = self._mark(a)
                if d:
                    extra = ""
                    try:
                        got_doc = get_field(a, "document")
                        got_msg = get_field(a, "message")
                        extra = f" doc_after={got_doc is not None} msg_len={len(str(got_msg or ''))}"
                    except Exception as _exc:
                        slog(f"after_hooked_method: {_exc}")
                    slog(f"PIPE {self.tag}: {d}{extra}")
                    return
        except Exception as _exc:
            slog(f"after_hooked_method: {_exc}")


class ItemOptionsHook(MethodHook):
    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin

    def before_hooked_method(self, param):
        try:
            opts = param.thisObject
            if opts is None:
                return
            t0 = time.time()
            key = JSystem.identityHashCode(opts)
            if key in _INJECTED_OPTIONS:
                return
            if not sender_visible():
                return
            path = ARMED["path"] if ARMED["active"] else None
            if not path:
                path = resolve_live_media_path()
            if not path or not media_kind(path):
                return
            add = None
            for count in (3, 4, 5):
                cand = find_method(opts.getClass(), "add", count)
                if cand is None:
                    continue
                types = [p.getName() for p in array_items(cand.getParameterTypes())]
                if count == 3 and types[0] == "int" and types[1] in ("java.lang.CharSequence", "java.lang.String") and types[2] == "java.lang.Runnable":
                    add = cand
                    break
            if add is None:
                return
            _INJECTED_OPTIONS.add(key)
            if len(_INJECTED_OPTIONS) > 64:
                _INJECTED_OPTIONS.clear()
            for once in (False, True):
                runnable = ClickRunnable(lambda p=path, o=once: self.plugin.open_from_send_ui(p, o))
                self.plugin.keep(runnable)
                add.invoke(opts, [JInteger(menu_icon(path)), JString(menu_caption(path, once)), runnable])
            prepare_circlet_options(opts)
            slog(f"IOPTS inject {media_kind(path)} in {int((time.time() - t0) * 1000)} ms")
        except Exception as e:
            error_log("item options injection failed", e)


class SendPreviewHook(MethodHook):
    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            args = param.args
            if args is None or len(args) < 1 or args[0] is None:
                return
            options = args[0]

            HOSTS["preview"] = param.thisObject

            path = resolve_send_path()
            if not path:
                path = ARMED["path"] if ARMED["active"] else None
            doc = None
            try:
                mos = get_field(param.thisObject, "messageObjects")
                if mos is not None and int(mos.size()) >= 1:
                    mo = mos.get(int(mos.size()) - 1)
                    if not path:
                        path = path_from_entry(mo)
                    owner = get_field(mo, "messageOwner")
                    media = get_field(owner, "media") if owner is not None else None
                    doc = get_field(media, "document") if media is not None else None
            except Exception:
                doc = None
            if not path or not media_kind(path):
                return
            PREVIEW_STATE["path"] = path
            PREVIEW_STATE["doc"] = doc
            PREVIEW_STATE["ts"] = time.time()
            try:
                _INJECTED_OPTIONS.add(JSystem.identityHashCode(options))
            except Exception as _exc:
                slog(f"after_hooked_method: {_exc}")

            add = None
            for count in (3, 4):
                add = find_method(options.getClass(), "add", count)
                if add is not None:
                    break
            if add is None:
                return

            for once in (False, True):
                runnable = ClickRunnable(lambda p=path, o=once: self.plugin.open_from_send_ui(p, o))
                self.plugin.keep(runnable)
                params = array_items(add.getParameterTypes())
                call = []
                for spec in params:
                    kind = spec.getName()
                    if kind == "int":
                        call.append(JInteger(menu_icon(path)))
                    elif kind == "java.lang.Runnable":
                        call.append(runnable)
                    elif kind == "boolean":
                        call.append(JBoolean(False))
                    else:
                        call.append(JString(menu_caption(path, once)))
                add.invoke(options, call)
                tint_last_icon(options)
            prepare_circlet_options(options)
        except Exception as e:
            error_log("send preview injection failed", e)


def descendants(view, depth=0):
    out = [view]
    if depth > 6:
        return out
    try:
        count = int(view.getChildCount())
    except Exception:
        return out
    for i in range(count):
        try:
            out.extend(descendants(view.getChildAt(i), depth + 1))
        except Exception:
            continue
    return out


def tint_last_icon(options):
    items = get_field(options, "items")
    if items is not None:
        try:
            views = [v for v in array_items(items.toArray())
                     if v is not None and hasattr(v, "getChildCount")]
        except Exception:
            views = []
        if len(views) >= 2 and copy_icon_look(views[-1], views[-2]):
            return

    root = None
    for name in ("linearLayout", "layout", "lastLayout", "windowView"):
        candidate = get_field(options, name)
        if candidate is not None and hasattr(candidate, "getChildCount"):
            root = candidate
            break

    image_cls = resolve_class("android.widget.ImageView")
    images = []
    if root is not None and image_cls is not None:
        images = [v for v in descendants(root) if image_cls.isInstance(v)]
    if len(images) >= 2:
        try:
            flt = images[-2].getColorFilter()
            if flt is not None:
                images[-1].setColorFilter(flt)
                return
        except Exception as _exc:
            slog(f"tint_last_icon: {_exc}")

    color = sibling_text_color(root) if root is not None else None
    if color is None and root is not None:
        color = sibling_icon_color(root)
    if color is None:
        color = theme_color("key_actionBarDefaultSubmenuItem", "key_dialogTextBlack")
    if color is None:
        color = _rgb(255, 255, 255)

    if images:
        try:
            images[-1].setColorFilter(PorterDuffColorFilter(jint(_jcolor(color)), PorterDuff.Mode.SRC_IN))
            return
        except Exception as _exc:
            slog(f"tint_last_icon: {_exc}")

    sub_cls = resolve_class("org.telegram.ui.ActionBar.ActionBarMenuSubItem")
    if root is not None and sub_cls is not None:
        subs = [v for v in descendants(root) if sub_cls.isInstance(v)]
        if subs:
            method = find_method(subs[-1].getClass(), "setColors", 2)
            if method is not None:
                try:
                    method.invoke(subs[-1], [JInteger(color), JInteger(color)])
                except Exception as _exc:
                    slog(f"tint_last_icon: {_exc}")


def listener_class(holder, field_name):
    view = get_field(holder, field_name)
    if view is None:
        return None
    for name in ("mOnLongClickListener", "onLongClickListener"):
        listener = get_field(view, name)
        if listener is None:
            info = get_field(view, "mListenerInfo")
            if info is not None:
                listener = get_field(info, "mOnLongClickListener")
        if listener is not None:
            try:
                return listener.getClass()
            except Exception:
                continue
    return None


def selected_video_path(alert):
    layout = photo_layout(alert)
    if layout is None:
        return None
    method = find_method(layout.getClass(), "getSelectedPhotos", 0)
    if method is None:
        return None
    try:
        selected = method.invoke(layout, None)
        if selected is None:
            return None
        if int(selected.size()) != 1:
            return None
        values = selected.values().toArray()
        for entry in array_items(values):
            raw = get_field(entry, "path")
            if not raw:
                continue
            candidate = str(raw)
            if candidate.lower().endswith((".mp4", ".mov", ".mkv", ".webm", ".3gp", ".avi")):
                return candidate
    except Exception as _exc:
        slog(f"selected_video_path: {_exc}")
    return None


def _drawable_id(*names):
    try:
        from org.telegram.messenger import ApplicationLoader
        ctx = ApplicationLoader.applicationContext
        pkg = ctx.getPackageName()
        res = ctx.getResources()
        for name in names:
            try:
                found = int(res.getIdentifier(name, "drawable", pkg))
            except Exception:
                found = 0
            if found:
                return found
    except Exception as _exc:
        slog(f"_drawable_id: {_exc}")
    return 0


def _visible_viewer():
    cls = resolve_class(PHOTO_VIEWER)
    if cls is None:
        return None
    try:
        has = find_method(cls, "hasInstance", 0)
        if has is not None and not bool(has.invoke(None, None)):
            return None
        getter = find_method(cls, "getInstance", 0)
        viewer = getter.invoke(None, None) if getter is not None else None
    except Exception:
        return None
    if viewer is None:
        return None
    visible = get_field(viewer, "isVisible")
    if visible is not None and not bool(visible):
        return None
    return viewer


def _same_path(a, b):
    if not a or not b:
        return False
    try:
        return os.path.realpath(str(a)) == os.path.realpath(str(b))
    except Exception:
        return str(a) == str(b)


def _edit_source(path):
    viewer = _visible_viewer()
    if viewer is not None:
        entries = get_field(viewer, "imagesArrLocals")
        index = get_field(viewer, "currentIndex")
        try:
            pos = int(index)
            if entries is not None and 0 <= pos < int(entries.size()):
                entry = entries.get(pos)
                if _same_path(get_field(entry, "path"), path):
                    return entry, viewer
        except Exception as _exc:
            slog(f"_edit_source: {_exc}")
        if _same_path(get_field(viewer, "currentPathObject"), path):
            return None, viewer
    holders = []
    alert = attach_alert_from_fragment()
    if alert is not None:
        holders.append(alert)
        try:
            extra = get_surrounding(alert)
            if extra is not None and extra is not alert:
                holders.append(extra)
        except Exception as _exc:
            slog(f"_edit_source: {_exc}")
    for holder in holders:
        layout = photo_layout(holder)
        method = find_method(layout.getClass(), "getSelectedPhotos", 0) if layout is not None else None
        if method is None:
            continue
        try:
            selected = method.invoke(layout, None)
            if selected is None:
                continue
            for entry in array_items(selected.values().toArray()):
                if _same_path(get_field(entry, "path"), path):
                    return entry, None
        except Exception:
            continue
    return None, None


def _has_items(value):
    if value is None:
        return False
    try:
        return int(value.size()) > 0
    except Exception:
        return True


def _filters_used(state):
    if state is None:
        return False
    method = find_method(state.getClass(), "isEmpty", 0)
    if method is None:
        return False
    try:
        return not bool(method.invoke(state, None))
    except Exception:
        return False


def _num(obj, name, default):
    value = get_field(obj, name)
    try:
        return float(value) if value is not None else float(default)
    except Exception:
        return float(default)


def read_edits(path):
    edits = {"turn": 0, "mirror": False, "muted": False, "region": None, "trim": None, "extras": [], "imported": []}
    try:
        entry, viewer = _edit_source(path)
        state = get_field(viewer, "editState") if viewer is not None else None
        info = get_field(entry, "editedInfo") if entry is not None else None
        crop = get_field(entry, "cropState") if entry is not None else None
        if crop is None and state is not None:
            crop = get_field(state, "cropState")
        if crop is None and info is not None:
            crop = get_field(info, "cropState")
        if viewer is not None:
            edits["muted"] = bool(get_field(viewer, "muteVideo") or False)
        elif info is not None:
            edits["muted"] = bool(get_field(info, "muted") or False)
            start_us = int(_num(info, "startTime", -1))
            end_us = int(_num(info, "endTime", -1))
            if start_us > 0 or end_us > 0:
                edits["trim"] = (max(0, start_us // 1000), end_us // 1000 if end_us > 0 else -1)
        if crop is not None:
            turn = int(_num(crop, "transformRotation", 0)) % 360
            if turn in (90, 180, 270):
                edits["turn"] = turn
            edits["mirror"] = bool(get_field(crop, "mirrored") or False)
            scale = _num(crop, "cropScale", 1.0)
            if scale <= 0.01:
                scale = 1.0
            fw = min(1.0, _num(crop, "cropPw", 1.0) / scale)
            fh = min(1.0, _num(crop, "cropPh", 1.0) / scale)
            if 0.0 < fw < 0.98 or 0.0 < fh < 0.98:
                edits["region"] = (0.5 - _num(crop, "cropPx", 0.0), 0.5 - _num(crop, "cropPy", 0.0), fw, fh)
            if abs(_num(crop, "cropRotate", 0.0)) >= 0.5:
                edits["extras"].append("tilt")
        paint = stickers = filters = False
        for source in (entry, state):
            if source is None:
                continue
            if get_field(source, "paintPath") or get_field(source, "croppedPaintPath"):
                paint = True
            if _has_items(get_field(source, "mediaEntities")) or _has_items(get_field(source, "croppedMediaEntities")):
                stickers = True
            if _filters_used(get_field(source, "savedFilterState")):
                filters = True
        if paint:
            edits["extras"].append("paint")
        if stickers:
            edits["extras"].append("stickers")
        if filters:
            edits["extras"].append("filters")
        for key in ("turn", "mirror", "muted", "region", "trim"):
            if edits.get(key):
                edits["imported"].append(key)
        slog(f"editor edits: {edits}")
    except Exception as e:
        slog(f"read edits failed: {e}")
    return edits


def is_video_path(path):
    return bool(path) and str(path).lower().endswith((".mp4", ".mov", ".mkv", ".webm", ".3gp", ".avi"))


def photoviewer_path():
    cls = resolve_class(PHOTO_VIEWER)
    if cls is None:
        return None

    has = find_method(cls, "hasInstance", 0)
    if has is not None:
        try:
            if not bool(has.invoke(None, None)):
                return None
        except Exception as _exc:
            slog(f"photoviewer_path: {_exc}")

    getter = find_method(cls, "getInstance", 0)
    if getter is None:
        return None
    try:
        viewer = getter.invoke(None, None)
    except Exception:
        return None
    if viewer is None:
        return None

    try:
        vis = get_field(viewer, "isVisible")
        if vis is not None and not bool(vis):
            return None
    except Exception as _exc:
        slog(f"photoviewer_path: {_exc}")
    try:
        vm = find_method(viewer.getClass(), "isVisible", 0)
        if vm is not None and not bool(vm.invoke(viewer, None)):
            return None
    except Exception as _exc:
        slog(f"photoviewer_path: {_exc}")

    raw = get_field(viewer, "currentPathObject")
    if is_video_path(raw):
        return str(raw)

    entries = get_field(viewer, "imagesArrLocals")
    index = get_field(viewer, "currentIndex")
    if entries is not None and index is not None:
        try:
            size = int(entries.size())
            pos = int(index)
            if 0 <= pos < size:
                candidate = get_field(entries.get(pos), "path")
                if is_video_path(candidate):
                    return str(candidate)
        except Exception as _exc:
            slog(f"photoviewer_path: {_exc}")

    return None


class SendLongClickHook(MethodHook):
    def _arm_audio_layout(self, alert):
        if alert is None:
            return False
        audio_layout = get_field(alert, "audioLayout")
        if audio_layout is None:
            return False
        selected = find_method(audio_layout.getClass(), "getSelected", 0)
        if selected is None:
            return False
        items = selected.invoke(audio_layout, None)
        if items is None or int(items.size()) != 1:
            return False
        item = items.get(0)
        doc = _audio_doc_from_entry(item)
        path = audio_document_path(doc)
        if not path:
            return False
        ARMED["active"] = True
        ARMED["path"] = path
        ARMED["mo"] = item
        ARMED["doc"] = doc
        slog(f"selected audio armed: {path}")
        _wave_prefetch(path)
        return True

    def _probe_holder(self, holder, tried, deadline):
        if holder is None:
            return None
        key = JSystem.identityHashCode(holder)
        if key in tried:
            return None
        tried.add(key)
        path = selected_video_path(holder) or selected_attachment_path(holder)
        if path:
            return path
        row = music_row_path(holder)
        if row is not None:
            ARMED["mo"] = row[0]
            slog(f"music row armed: {row[1]}")
            return row[1]
        return deep_selected_audio(holder, deadline=deadline)

    def before_hooked_method(self, param):
        t0 = time.time()
        sur_ms = res_ms = pv_ms = 0
        try:
            ARMED["active"] = False
            ARMED["path"] = None
            ARMED["mo"] = None
            ARMED["doc"] = None
            path = photoviewer_path()
            alert = HOSTS.get("alert") or attach_alert_from_fragment()
            if not path and alert is not None:
                path = selected_video_path(alert) or selected_attachment_path(alert)
            if path and media_kind(path):
                ARMED["active"] = True
                ARMED["path"] = path
                if media_kind(path) == "audio":
                    _wave_prefetch(path)
                return
            if self._arm_audio_layout(alert):
                return
            ts = time.time()
            holders = []
            if param.thisObject is not None:
                holders.append(param.thisObject)
                holders.extend(_safe(get_surroundings, param.thisObject, default=[]))
            holders.append(None)
            sur_ms = int((time.time() - ts) * 1000)
            ts = time.time()
            tried = set()
            deadline = time.monotonic() + 0.25
            for hi, holder in enumerate(holders):
                try:
                    path = self._probe_holder(holder, tried, deadline)
                    if not path and hi == 0 and alert is not None:
                        akey = JSystem.identityHashCode(alert)
                        if akey not in tried:
                            tried.add(akey)
                            path = selected_attachment_path(alert)
                    if path:
                        ARMED["active"] = True
                        ARMED["path"] = path
                        if media_kind(path) == "audio":
                            _wave_prefetch(path)
                        break
                except Exception as e:
                    error_log("long-click holder resolution failed", e)
            res_ms = int((time.time() - ts) * 1000)
            ts = time.time()
            if not ARMED["active"]:
                pv = photoviewer_path()
                if pv:
                    ARMED["active"] = True
                    ARMED["path"] = pv
            pv_ms = int((time.time() - ts) * 1000)
        except Exception as e:
            error_log("long-click media resolution failed", e)
            toast(localized("Не удалось определить выбранный файл", "Could not determine the selected file"))
        finally:
            slog(f"LONGCLICK {int((time.time() - t0) * 1000)} ms (sur={sur_ms} res={res_ms} pv={pv_ms})")


def get_surrounding(obj):
    outs = get_surroundings(obj)
    return outs[0] if outs else None


def get_surroundings(obj, depth=0):
    if obj is None:
        return []
    result = []
    cls = obj.getClass()
    try:
        fields = array_items(cls.getDeclaredFields())
    except Exception:
        fields = []
    for f in fields:
        try:
            name = f.getName()
            if not (name.startswith("this$") or name.startswith("f$") or name.startswith("arg$")):
                continue
            f.setAccessible(True)
            v = f.get(obj)
            if v is None:
                continue
            if name.startswith("this$"):
                if not any(v is x for x in result):
                    result.append(v)
            elif depth < 1:
                if any(v is x for x in result):
                    continue
                inner = get_surroundings(v, depth + 1)
                for item in inner:
                    if not any(item is x for x in result):
                        result.append(item)
        except Exception:
            continue
    return result


class PopupShowHook(MethodHook):
    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin

    def before_hooked_method(self, param):
        t0 = time.time()
        try:
            window = param.thisObject
            HOSTS["popup"] = window
            content = None
            for name in ("contentView", "mContentView"):
                content = get_field(window, name)
                if content is not None:
                    break
            if content is None:
                return

            tag = None
            try:
                tag = content.getTag()
            except Exception as _exc:
                slog(f"before_hooked_method: {_exc}")
            if tag is not None and str(tag) == INJECT_TAG:
                return

            if not sender_visible():
                return
            probe_path = ARMED["path"] if ARMED["active"] else None
            if not probe_path:
                probe_path = resolve_send_path()
            if not probe_path or not media_kind(probe_path):
                return
            old_height = int(content.getMeasuredHeight())
            ctx = content.getContext()
            neighbour = sibling_text_color(content)
            icon = sibling_icon_color(content)
            if icon is None:
                icon = neighbour
            path = probe_path
            for once in (False, True):
                item = ActionBarMenuSubItem(ctx, False, False)
                item.setTextAndIcon(JString(menu_caption(path, once)), menu_icon(path))
                apply_submenu_colors(item, neighbour, icon)
                listener = OnClickListener(lambda *_, p=path, o=once: self.plugin.open_from_send_ui(p, o))
                self.plugin.keep(listener)
                item.setOnClickListener(listener)
                content.addView(item)
            try:
                content.setTag(JString(INJECT_TAG))
            except Exception as _exc:
                slog(f"before_hooked_method: {_exc}")
            raise_circlet_popup(param, content, old_height)
            slog(f"POPUP inject {media_kind(path)} in {int((time.time() - t0) * 1000)} ms")
        except Exception as e:
            error_log("popup injection failed", e)


def _open_audio_extractor(path):
    from android.media import MediaExtractor, MediaFormat
    ex = MediaExtractor()
    ex.setDataSource(path)
    for i in range(ex.getTrackCount()):
        fmt = ex.getTrackFormat(i)
        mime = str(fmt.getString(MediaFormat.KEY_MIME))
        if mime.startswith("audio/"):
            ex.selectTrack(i)
            return ex, fmt, mime
    ex.release()
    raise RuntimeError("no audio track")


def _wave_chunk_rms(buf, offset, size):
    buf.position(int(offset))
    buf.limit(int(offset) + size)
    chunk = bytearray(size)
    buf.get(chunk)
    raw = bytes(chunk)
    step = max(2, len(raw) // 32)
    sq = 0.0
    cnt = 0
    for off in range(0, len(raw) - 1, step):
        val = int.from_bytes(raw[off:off + 2], "little", signed=True)
        sq += val * val
        cnt += 1
    return (sq / max(1, cnt)) ** 0.5 / 32768.0


def _decode_wave_manual(path, bins, on_partial=None, stop_check=None):
    from android.media import MediaCodec, MediaFormat
    ex, tf, mime = _open_audio_extractor(path)
    dec = None
    try:
        duration_us = _safe(lambda: int(tf.getLong(MediaFormat.KEY_DURATION)), default=0)
        if duration_us <= 0:
            duration_us = _safe(lambda: int((os.path.getsize(path) * 8) // 128), default=60000000)
        dec = MediaCodec.createDecoderByType(mime)
        dec.configure(tf, None, None, 0)
        dec.start()
        info = MediaCodec.BufferInfo()
        peaks = [0.0] * bins
        per_bin = max(1, duration_us // bins)
        t0 = time.time()
        input_done = False
        eos = False
        spin = 0
        counter = 0
        wave_skip = max(1, int(duration_us // 26000) // 150)
        last_post = 0.0
        dead = time.time() + 30
        ex.seekTo(0, 2)
        while not eos and time.time() < dead:
            if stop_check is not None and stop_check():
                return peaks
            if not input_done and ex.getSampleTime() < 0:
                input_done = True
            if not input_done:
                counter += 1
                if counter % wave_skip != 0:
                    ex.advance()
                    out_i = dec.dequeueOutputBuffer(info, 0)
                else:
                    idx = dec.dequeueInputBuffer(2000)
                    if idx >= 0:
                        buf = dec.getInputBuffer(idx)
                        size = int(ex.readSampleData(buf, 0))
                        pts = int(ex.getSampleTime())
                        if size < 0 or pts < 0:
                            dec.queueInputBuffer(idx, 0, 0, 0, MediaCodec.BUFFER_FLAG_END_OF_STREAM)
                            input_done = True
                        else:
                            dec.queueInputBuffer(idx, 0, size, pts, 0)
                            ex.advance()
                    out_i = dec.dequeueOutputBuffer(info, 2000)
            else:
                out_i = dec.dequeueOutputBuffer(info, 2000)
            if out_i >= 0:
                spin = 0
                size = int(info.size)
                pts_us = int(info.presentationTimeUs)
                if size > 1:
                    bi = min(bins - 1, max(0, pts_us // per_bin))
                    val = _wave_chunk_rms(dec.getOutputBuffer(out_i), info.offset, size)
                    if val > peaks[bi]:
                        peaks[bi] = val
                dec.releaseOutputBuffer(out_i, False)
                if (info.flags & MediaCodec.BUFFER_FLAG_END_OF_STREAM) != 0:
                    eos = True
                elif on_partial is not None and time.time() - last_post > 0.15:
                    last_post = time.time()
                    _safe(on_partial, list(peaks))
            elif input_done:
                spin += 1
                if spin > 3:
                    break
        mx = max(peaks) if peaks else 0.0
        if mx > 0:
            peaks = [min(1.0, p / (mx * 0.85)) for p in peaks]
        slog(f"wave decode done in {int((time.time() - t0) * 1000)} ms")
        if all(v == 0.0 for v in peaks):
            raise RuntimeError("wave empty")
        return peaks
    finally:
        if dec is not None:
            _safe(dec.stop)
            _safe(dec.release)
        _safe(ex.release)


def _decode_wave(path, bins=120, on_partial=None, stop_check=None):
    slog(f"wave decode: {path}")
    vals = _decode_wave_manual(path, bins, on_partial, stop_check=stop_check)
    if stop_check is not None and stop_check():
        return [], 0
    if not vals:
        raise RuntimeError("wave empty")
    if len(vals) == bins:
        bars = [max(0.0, float(v)) for v in vals]
    else:
        bars = []
        per = max(1, len(vals) // bins)
        for b in range(bins):
            chunk = vals[b * per:(b + 1) * per]
            bars.append(max(0, max(chunk)) / 31.0 if chunk else 0.0)
    peak = max(bars) if bars else 0.0
    if peak > 0:
        bars = [min(1.0, b / peak) for b in bars]
    slog("wave bars: " + " ".join("%.2f" % float(b) for b in bars))
    return bars, 0


def _convert_pcm_to_mono(pcm, channels, sample_rate, audioop_module, state):
    from array import array

    if channels == 1:
        mono = pcm
    elif channels == 2 and audioop_module is not None:
        mono = audioop_module.tomono(pcm, 2, 0.5, 0.5)
    else:
        samples = array("h")
        samples.frombytes(pcm)
        mixed = array("h")
        for offset in range(0, len(samples), channels):
            frame = samples[offset:offset + channels]
            if len(frame) == channels:
                mixed.append(int(sum(frame) / channels))
        mono = mixed.tobytes()

    if sample_rate == 48000:
        return mono

    if audioop_module is not None:
        mono, state["resample"] = audioop_module.ratecv(
            mono, 2, 1, sample_rate, 48000, state["resample"]
        )
        return mono

    source = array("h")
    source.frombytes(mono)
    converted = array("h")

    for current in source:
        index = state["source_index"]
        if state["previous"] is None:
            state["previous"] = current
        while state["output_index"] * sample_rate <= index * 48000:
            numerator = state["output_index"] * sample_rate
            base = (index - 1) * 48000
            fraction = max(0.0, min(1.0, (numerator - base) / 48000.0))
            value = int(state["previous"] + (current - state["previous"]) * fraction)
            converted.append(max(-32768, min(32767, value)))
            state["output_index"] += 1
        state["previous"] = current
        state["source_index"] += 1

    return converted.tobytes()


def _feed_audio_decoder(decoder, extractor, end_us, state):
    from android.media import MediaCodec
    if state["decoder_input_done"] or len(state["pending"]) >= 262144:
        return
    input_index = decoder.dequeueInputBuffer(1000)
    if input_index < 0:
        return
    input_buffer = decoder.getInputBuffer(input_index)
    input_buffer.clear()
    size = int(extractor.readSampleData(input_buffer, 0))
    pts = int(extractor.getSampleTime())
    if size < 0 or pts < 0 or pts >= end_us:
        decoder.queueInputBuffer(
            input_index, 0, 0, max(0, state["last_source_pts"]), MediaCodec.BUFFER_FLAG_END_OF_STREAM
        )
        state["decoder_input_done"] = True
    else:
        decoder.queueInputBuffer(input_index, 0, size, pts, 0)
        state["last_source_pts"] = pts
        extractor.advance()


def _drain_audio_decoder(decoder, decode_info, start_us, end_us, audioop_mod, state):
    from android.media import AudioFormat, MediaCodec, MediaFormat
    if state["decoder_output_done"] or len(state["pending"]) >= 262144:
        return
    output_index = decoder.dequeueOutputBuffer(decode_info, 1000)
    if output_index == MediaCodec.INFO_OUTPUT_FORMAT_CHANGED:
        fmt = decoder.getOutputFormat()
        new_rate = int(fmt.getInteger(MediaFormat.KEY_SAMPLE_RATE))
        new_channels = int(fmt.getInteger(MediaFormat.KEY_CHANNEL_COUNT))
        if state["input_samples"] and (new_rate != state["sample_rate"] or new_channels != state["channels"]):
            raise RuntimeError("audio format changed during conversion")
        state["sample_rate"] = new_rate
        state["channels"] = new_channels
        if fmt.containsKey(MediaFormat.KEY_PCM_ENCODING):
            if int(fmt.getInteger(MediaFormat.KEY_PCM_ENCODING)) != AudioFormat.ENCODING_PCM_16BIT:
                raise RuntimeError("unsupported decoded PCM encoding")
        return
    if output_index < 0:
        return
    size = int(decode_info.size)
    pts = int(decode_info.presentationTimeUs)
    frame_bytes = state["channels"] * 2
    if size > 0 and frame_bytes > 0:
        out_buf = decoder.getOutputBuffer(output_index)
        out_buf.position(int(decode_info.offset))
        out_buf.limit(int(decode_info.offset) + size)
        raw = bytearray(size)
        out_buf.get(raw)
        frames = len(raw) // frame_bytes
        sr = state["sample_rate"]
        first = max(0, (start_us - pts) * sr // 1000000)
        last = min(frames, max(0, (end_us - pts) * sr // 1000000))
        if last > first:
            selected = bytes(raw[first * frame_bytes:last * frame_bytes])
            state["input_samples"] += last - first
            state["pending"].extend(
                _convert_pcm_to_mono(selected, state["channels"], sr, audioop_mod, state["pcm_state"])
            )
    flags = int(decode_info.flags)
    decoder.releaseOutputBuffer(output_index, False)
    if flags & MediaCodec.BUFFER_FLAG_END_OF_STREAM:
        state["decoder_output_done"] = True


def _feed_opus_encoder(encoder, state):
    from android.media import MediaCodec
    if state["encoder_input_done"] or not (state["pending"] or state["decoder_output_done"]):
        return
    input_index = encoder.dequeueInputBuffer(1000)
    if input_index < 0:
        return
    input_buffer = encoder.getInputBuffer(input_index)
    input_buffer.clear()
    take = min(len(state["pending"]), int(input_buffer.capacity()), 1920)
    take -= take % 2
    pts = state["output_samples"] * 1000000 // 48000
    if take > 0:
        input_buffer.put(bytes(state["pending"][:take]))
        del state["pending"][:take]
        encoder.queueInputBuffer(input_index, 0, take, pts, 0)
        state["output_samples"] += take // 2
    elif state["decoder_output_done"]:
        encoder.queueInputBuffer(input_index, 0, 0, pts, MediaCodec.BUFFER_FLAG_END_OF_STREAM)
        state["encoder_input_done"] = True


def _drain_opus_encoder(encoder, encode_info, out_path, state):
    from android.media import MediaCodec, MediaMuxer
    output_index = encoder.dequeueOutputBuffer(encode_info, 1000)
    if output_index == MediaCodec.INFO_OUTPUT_FORMAT_CHANGED:
        if state["muxer"] is not None:
            raise RuntimeError("Opus output format changed twice")
        muxer = MediaMuxer(out_path, MediaMuxer.OutputFormat.MUXER_OUTPUT_OGG)
        state["track_index"] = muxer.addTrack(encoder.getOutputFormat())
        muxer.start()
        state["muxer"] = muxer
        state["muxer_started"] = True
        return
    if output_index < 0:
        return
    size = int(encode_info.size)
    flags = int(encode_info.flags)
    if size > 0:
        if not state["muxer_started"]:
            raise RuntimeError("Opus muxer was not started")
        out_buf = encoder.getOutputBuffer(output_index)
        out_buf.position(int(encode_info.offset))
        out_buf.limit(int(encode_info.offset) + size)
        sample_info = MediaCodec.BufferInfo()
        sample_info.set(int(encode_info.offset), size, int(encode_info.presentationTimeUs), flags)
        state["muxer"].writeSampleData(state["track_index"], out_buf, sample_info)
    encoder.releaseOutputBuffer(output_index, False)
    if flags & MediaCodec.BUFFER_FLAG_END_OF_STREAM:
        state["encoder_output_done"] = True


def _release_audio_pipeline(res, out_path, completed):
    if res["decoder"] is not None:
        if res["decoder_started"]:
            _safe(res["decoder"].stop)
        _safe(res["decoder"].release)
    if res["encoder"] is not None:
        if res["encoder_started"]:
            _safe(res["encoder"].stop)
        _safe(res["encoder"].release)
    if res["extractor"] is not None:
        _safe(res["extractor"].release)
    if res["muxer"] is not None:
        if res["muxer_started"]:
            _safe(res["muxer"].stop)
        _safe(res["muxer"].release)
    if not completed and os.path.isfile(out_path):
        _safe(os.remove, out_path)


def _decode_audio_segment(path, start_ms, end_ms, stop_check=None):
    from android.media import MediaCodec, MediaExtractor, MediaFormat
    import uuid

    started = time.time()
    start_us = int(start_ms) * 1000
    end_us = int(end_ms) * 1000
    if end_us <= start_us:
        raise ValueError("empty audio selection")

    out_path = os.path.join(_circlet_cache_dir(), "circlet_%s.ogg" % uuid.uuid4().hex)
    res = {
        "extractor": None,
        "decoder": None,
        "encoder": None,
        "muxer": None,
        "muxer_started": False,
        "decoder_started": False,
        "encoder_started": False,
    }
    completed = False

    try:
        extractor, source_format, mime = _open_audio_extractor(path)
        res["extractor"] = extractor
        if start_us > 0:
            extractor.seekTo(max(0, start_us - 600000), MediaExtractor.SEEK_TO_PREVIOUS_SYNC)
        sample_rate = int(source_format.getInteger(MediaFormat.KEY_SAMPLE_RATE))
        channels = int(source_format.getInteger(MediaFormat.KEY_CHANNEL_COUNT))
        if sample_rate <= 0 or channels <= 0:
            raise RuntimeError("invalid audio format")
        try:
            import audioop
        except ImportError:
            audioop = None

        decoder = MediaCodec.createDecoderByType(mime)
        res["decoder"] = decoder
        decoder.configure(source_format, None, None, 0)
        decoder.start()
        res["decoder_started"] = True

        encoder = MediaCodec.createEncoderByType("audio/opus")
        res["encoder"] = encoder
        encode_format = MediaFormat.createAudioFormat("audio/opus", 48000, 1)
        encode_format.setInteger(MediaFormat.KEY_BIT_RATE, int(_SETTINGS.get("bitrate", 64000)))
        encoder.configure(encode_format, None, None, MediaCodec.CONFIGURE_FLAG_ENCODE)
        encoder.start()
        res["encoder_started"] = True

        decode_info = MediaCodec.BufferInfo()
        encode_info = MediaCodec.BufferInfo()
        state = {
            "decoder_input_done": False,
            "decoder_output_done": False,
            "encoder_input_done": False,
            "encoder_output_done": False,
            "pending": bytearray(),
            "pcm_state": {"resample": None, "previous": None, "source_index": 0, "output_index": 0},
            "sample_rate": sample_rate,
            "channels": channels,
            "input_samples": 0,
            "output_samples": 0,
            "last_source_pts": 0,
            "muxer": None,
            "muxer_started": False,
            "track_index": -1,
        }
        deadline = time.time() + max(120.0, (end_ms - start_ms) / 1000.0 * 3.0 + 60.0)
        while not state["encoder_output_done"]:
            if stop_check is not None and stop_check():
                raise RuntimeError("cancelled on unload")
            if time.time() >= deadline:
                raise TimeoutError("audio conversion timed out")
            _feed_audio_decoder(decoder, extractor, end_us, state)
            _drain_audio_decoder(decoder, decode_info, start_us, end_us, audioop, state)
            _feed_opus_encoder(encoder, state)
            _drain_opus_encoder(encoder, encode_info, out_path, state)
            res["muxer"] = state["muxer"]
            res["muxer_started"] = state["muxer_started"]

        if state["input_samples"] <= 0 or state["output_samples"] <= 0:
            raise RuntimeError("empty audio segment")
        duration_sec = max(1, int(round(state["output_samples"] / 48000.0)))
        completed = True
        slog(
            f"ogg streamed: input={state['input_samples']} samples "
            f"output={state['output_samples']} samples in {int((time.time() - started) * 1000)} ms"
        )
        return out_path, duration_sec
    finally:
        _release_audio_pipeline(res, out_path, completed)


class VoiceProgress:
    def __init__(self, plugin, account=0, path=None):
        self.plugin = plugin
        self.account = int(account)
        self.paths = {str(path)} if path else set()
        self.active = False
        self.phase = "prepare"
        self.started = 0.0
        self.token = 0
        self.limit = 15 * 60
        self.center = None
        self.observer = None
        self.events = {}
        self.view = None
        self.label = None
        self.progress = None
        self.root = None
        self._drag_proxy = None
        self._end_action = None
        self.position_saved = False
        self.dragged = False
        self._load_position()

    def start(self):
        self.stop()
        self.active = True
        self.phase = "prepare"
        self.started = time.monotonic()
        self.token += 1
        self._observe()
        token = self.token
        run_on_ui_thread(lambda: self._show_view(token), 0)
        run_on_ui_thread(lambda: self._tick(token), 6000)

    def set_phase(self, phase):
        if self.active:
            self.phase = phase
            self._update_label()

    def stop(self):
        if self.center is not None and self.observer is not None:
            for event in self.events:
                _safe(lambda ev=event: self.center.removeObserver(self.observer, ev))
        self.center = None
        self.observer = None
        self.events = {}
        self.active = False
        self.token += 1
        view = self.view
        self.view = None
        self.label = None
        self.progress = None
        self.root = None
        self._drag_proxy = None
        if view is not None:
            run_on_ui_thread(lambda v=view: self._remove_view(v), 0)

    def bind(self, params):
        path = get_field(params, "path")
        if path and (str(path) in self.paths or time.monotonic() - self.started < 5):
            self.paths.add(str(path))

    def add_path(self, path):
        if path:
            self.paths.add(str(path))

    def _matches_path(self, value):
        if not value:
            return False
        path = str(value)
        if path in self.paths:
            return True
        return (
            os.path.basename(path).lower().startswith("circlet_")
            and path.lower().endswith((".ogg", ".opus"))
        )

    def _observe(self):
        try:
            from org.telegram.messenger import NotificationCenter
            status = self

            class Observer(dynamic_proxy(NotificationCenter.NotificationCenterDelegate)):
                def didReceivedNotification(self, event, account, args):
                    if status.active and int(account) == status.account:
                        try:
                            status.received(int(event), list(args or []))
                        except Exception as exc:
                            error_log("voice progress event failed", exc)

            self.center = NotificationCenter.getInstance(self.account)
            self.observer = Observer()
            for name in (
                "filePreparingStarted",
                "filePreparingFailed",
                "fileUploadProgressChanged",
                "fileUploaded",
                "fileUploadFailed",
                "didReceiveNewMessages",
            ):
                event = getattr(NotificationCenter, name, None)
                if event is not None:
                    self.events[int(event)] = name
                    self.center.addObserver(self.observer, int(event))
        except Exception as exc:
            error_log("voice progress observer failed", exc)
            self.center = None
            self.observer = None
            self.events = {}

    def received(self, event, args):
        name = self.events.get(event)
        if name == "fileUploadProgressChanged" and len(args) > 2:
            if self._matches_path(args[0]):
                try:
                    uploaded = int(args[1])
                    total = int(args[2])
                    if total > 0:
                        self._set_progress(uploaded * 100 // total)
                except Exception as exc:
                    error_log("voice progress value failed", exc)
        elif name in ("filePreparingFailed", "fileUploadFailed"):
            if args and self._matches_path(args[0]):
                self.stop()
                toast(localized("Не удалось отправить голосовое", "Could not send the voice message"))
        elif name == "fileUploaded":
            if args and self._matches_path(args[0]):
                self.stop()
        elif name == "didReceiveNewMessages" and len(args) > 1:
            messages = args[1]
            try:
                count = int(messages.size())
                values = [messages.get(i) for i in range(count)]
            except Exception:
                values = array_items(messages)
            for message in values:
                owner = get_field(message, "messageOwner")
                path = get_field(owner, "attachPath") if owner is not None else None
                if path and self._matches_path(path):
                    self.stop()
                    return

    def _text(self):
        elapsed = time.monotonic() - self.started
        if self.phase == "prepare":
            return localized("Готовлю голосовое…", "Preparing voice message…")
        if self.phase == "finalizing":
            return localized("Завершаю отправку…", "Finishing upload…")
        if elapsed >= 15:
            return localized("Голосовое всё ещё отправляется…", "Voice message is still being sent…")
        return localized("Голосовое отправляется…", "Voice message is being sent…")

    def _preferences(self):
        try:
            ctx = context()
            return ctx.getSharedPreferences("circlet_voice_progress", 0) if ctx is not None else None
        except Exception as exc:
            error_log("voice progress preferences failed", exc)
            return None

    def _load_position(self):
        prefs = self._preferences()
        if prefs is None:
            return
        try:
            if bool(prefs.getBoolean("position_saved", False)):
                self.position_saved = True
                self.saved_left = int(prefs.getInt("left", 0))
                self.saved_top = int(prefs.getInt("top", 0))
        except Exception as exc:
            error_log("voice progress position load failed", exc)

    def _save_position(self, left, top):
        prefs = self._preferences()
        if prefs is None:
            return
        try:
            prefs.edit().putBoolean("position_saved", True).putInt("left", int(left)).putInt("top", int(top)).apply()
            self.position_saved = True
            self.saved_left = int(left)
            self.saved_top = int(top)
        except Exception as exc:
            error_log("voice progress position save failed", exc)

    @staticmethod
    def _safe_theme_color(names, fallback, resources_provider=None):
        color = theme_color(*names, resources_provider=resources_provider)
        if color is None:
            return _jcolor(fallback)
        return _jcolor(color) if _rgba(color)[0] >= 16 else _jcolor(fallback)

    def _resolve_palette(self, frag):
        default_accent = _rgb(100, 181, 246)
        fallback = (
            _rgb(34, 38, 46),
            _rgb(245, 247, 250),
            default_accent,
            _argb(44, 255, 255, 255),
            _argb(56, 100, 181, 246),
        )
        try:
            rp = _safe(frag.getResourceProvider) if frag is not None else None
            surface = _opaque_color(self._safe_theme_color(
                ("key_dialogBackground", "key_actionBarDefaultSubmenuBackground", "key_windowBackgroundWhite"),
                _rgb(34, 38, 46),
                resources_provider=rp,
            ))
            text = _opaque_color(self._safe_theme_color(
                ("key_dialogTextBlack", "key_actionBarDefaultSubmenuItem", "key_windowBackgroundWhiteBlackText"),
                _rgb(245, 247, 250),
                resources_provider=rp,
            ))
            accent = _opaque_color(self._safe_theme_color(
                ("key_dialogTextBlue2", "key_featuredStickers_addButton", "key_windowBackgroundWhiteBlueText4"),
                default_accent,
                resources_provider=rp,
            ))
            surf_luma = _color_luma(surface)
            dark = surf_luma < 128
            if abs(_color_luma(text) - surf_luma) < 120:
                text = _rgb(245, 247, 250) if dark else _rgb(22, 24, 29)
            if abs(_color_luma(accent) - surf_luma) < 55:
                accent = _mix_color(accent, _rgb(255, 255, 255) if dark else _rgb(20, 24, 30), 0.5)
            stroke = _argb(46, 255, 255, 255) if dark else _argb(32, 0, 0, 0)
            _, ar, ag, ab = _rgba(accent)
            track = _argb(56, ar, ag, ab)
            return surface, text, accent, stroke, track
        except Exception as exc:
            slog(f"voice progress palette fallback: {exc}")
            return fallback

    def _find_input_rect(self, root):
        frag = get_last_fragment()
        for name in ("chatActivityEnterView", "chatActivityEnterViewAnimated", "enterView"):
            candidate = get_field(frag, name)
            if candidate is None:
                continue
            rect = Rect()
            ok = _safe(lambda c=candidate, r=rect: bool(c.isShown() and c.getGlobalVisibleRect(r) and r.height() > 0), default=False)
            if ok:
                return rect
        return None

    def _clamp_position(self, left, top):
        view = self.view
        root = self.root
        if view is None or root is None:
            return int(left), int(top)
        width = max(int(view.getWidth()), int(view.getMeasuredWidth()), AndroidUtilities.dp(1))
        height = max(int(view.getHeight()), int(view.getMeasuredHeight()), AndroidUtilities.dp(1))
        root_width = max(int(root.getWidth()), width)
        root_height = max(int(root.getHeight()), height)
        margin = AndroidUtilities.dp(6)
        return (
            max(margin, min(int(left), root_width - width - margin)),
            max(margin, min(int(top), root_height - height - margin)),
        )

    def _move_view(self, left, top, save=False):
        view = self.view
        if view is None:
            return
        left, top = self._clamp_position(left, top)
        try:
            lp = view.getLayoutParams()
            lp.gravity = Gravity.TOP | Gravity.LEFT
            lp.leftMargin = int(left)
            lp.topMargin = int(top)
            view.setLayoutParams(lp)
            if save:
                self._save_position(left, top)
        except Exception as exc:
            error_log("voice progress position update failed", exc)

    def _place_view(self):
        view = self.view
        root = self.root
        if view is None or root is None or not self.active:
            return
        try:
            root_rect = Rect()
            root.getGlobalVisibleRect(root_rect)
            width = max(int(view.getMeasuredWidth()), int(view.getWidth()))
            height = max(int(view.getMeasuredHeight()), int(view.getHeight()))
            if width <= 0 or height <= 0:
                view.measure(
                    View.MeasureSpec.makeMeasureSpec(max(1, int(root.getWidth()) - AndroidUtilities.dp(12)), View.MeasureSpec.AT_MOST),
                    View.MeasureSpec.makeMeasureSpec(max(1, int(root.getHeight()) - AndroidUtilities.dp(12)), View.MeasureSpec.AT_MOST),
                )
                width = int(view.getMeasuredWidth())
                height = int(view.getMeasuredHeight())
            if self.position_saved:
                left, top = self.saved_left, self.saved_top
            else:
                input_rect = self._find_input_rect(root)
                left = (int(root.getWidth()) - width) // 2
                if input_rect is not None:
                    top = int(input_rect.top - root_rect.top) - height - AndroidUtilities.dp(8)
                else:
                    top = int(root.getHeight()) - int(getattr(AndroidUtilities, "navigationBarHeight", 0) or 0) - height - AndroidUtilities.dp(88)
            self._move_view(left, top)
        except Exception as exc:
            error_log("voice progress placement failed", exc)

    def _drag_listener(self):
        status = self

        class MoveListener(dynamic_proxy(View.OnTouchListener)):
            def __init__(self):
                super().__init__()
                self.down_x = 0.0
                self.down_y = 0.0
                self.start_left = 0
                self.start_top = 0
                self.moved = False

            def onTouch(self, view, event):
                try:
                    action = event.getActionMasked()
                    if action == MotionEvent.ACTION_DOWN:
                        parent = view.getParent()
                        if parent is not None:
                            parent.requestDisallowInterceptTouchEvent(True)
                        lp = view.getLayoutParams()
                        self.down_x = float(event.getRawX())
                        self.down_y = float(event.getRawY())
                        self.start_left = int(lp.leftMargin)
                        self.start_top = int(lp.topMargin)
                        self.moved = False
                        return True
                    if action == MotionEvent.ACTION_MOVE:
                        dx = float(event.getRawX()) - self.down_x
                        dy = float(event.getRawY()) - self.down_y
                        if abs(dx) > AndroidUtilities.dp(3) or abs(dy) > AndroidUtilities.dp(3):
                            self.moved = True
                        status._move_view(self.start_left + int(dx), self.start_top + int(dy))
                        return True
                    if action in (MotionEvent.ACTION_UP, MotionEvent.ACTION_CANCEL):
                        parent = view.getParent()
                        if parent is not None:
                            parent.requestDisallowInterceptTouchEvent(False)
                        if self.moved:
                            lp = view.getLayoutParams()
                            status._save_position(lp.leftMargin, lp.topMargin)
                        return True
                except Exception as exc:
                    error_log("voice progress drag failed", exc)
                return False

        return MoveListener()

    def _build_header_row(self, ctx, text_color, accent_color):
        from android import R as AndroidR
        from android.content.res import ColorStateList
        from android.widget import ProgressBar

        row = LinearLayout(ctx)
        row.setGravity(Gravity.CENTER_VERTICAL)
        spinner = None
        try:
            spinner = ProgressBar(ctx, None, AndroidR.attr.progressBarStyleSmall)
            spinner.setIndeterminate(True)
            accent_val = _jcolor(accent_color)
            accent_csl = _safe(lambda: ColorStateList.valueOf(jint(accent_val)))
            if accent_csl is not None:
                _safe(lambda: spinner.setIndeterminateTintList(accent_csl))
                _safe(lambda: spinner.setIndeterminateTintMode(PorterDuff.Mode.SRC_IN))
            drawable = _safe(spinner.getIndeterminateDrawable)
            if drawable is not None:
                _safe(lambda: drawable.mutate().setColorFilter(PorterDuffColorFilter(jint(accent_val), PorterDuff.Mode.SRC_IN)))
            row.addView(spinner, LinearLayout.LayoutParams(AndroidUtilities.dp(18), AndroidUtilities.dp(18)))
        except Exception as exc:
            slog(f"voice spinner failed: {exc}")
            spinner = None

        label = TextView(ctx)
        label.setTextSize(13.0)
        _set_text_color(label, text_color)
        label.setSingleLine(True)
        label.setText(JString(self._text()))
        try:
            from android.graphics import Typeface
            label.setTypeface(Typeface.create(JString("sans-serif-medium"), Typeface.NORMAL))
            label.setLetterSpacing(0.01)
        except Exception as exc:
            slog(f"voice typeface failed: {exc}")
        text_params = LinearLayout.LayoutParams(-2, -2)
        text_params.leftMargin = AndroidUtilities.dp(10 if spinner is not None else 0)
        row.addView(label, text_params)
        return row, label

    def _build_progress_bar(self, ctx, accent_color, track_color):
        from android import R as AndroidR
        from android.content.res import ColorStateList
        from android.graphics.drawable import ClipDrawable, GradientDrawable, LayerDrawable
        from android.widget import ProgressBar

        try:
            progress = ProgressBar(ctx, None, AndroidR.attr.progressBarStyleHorizontal)
            progress.setPadding(0, 0, 0, 0)
            progress.setMax(100)
            progress.setProgress(0)
            accent_val = _jcolor(accent_color)
            accent_csl = _safe(lambda: ColorStateList.valueOf(jint(accent_val)))
            try:
                radius = float(AndroidUtilities.dp(2))
                track = GradientDrawable()
                _set_drawable_color(track, track_color)
                track.setCornerRadius(radius)
                fill = GradientDrawable()
                _set_drawable_color(fill, accent_val)
                fill.setCornerRadius(radius)
                clip = ClipDrawable(fill, Gravity.LEFT, ClipDrawable.HORIZONTAL)
                drawables = JArray.newInstance(JClass.forName("android.graphics.drawable.Drawable"), 2)
                JArray.set(drawables, 0, track)
                JArray.set(drawables, 1, clip)
                layers = LayerDrawable(drawables)
                layers.setId(0, AndroidR.id.background)
                layers.setId(1, AndroidR.id.progress)
                progress.setProgressDrawable(layers)
            except Exception as exc:
                slog(f"voice progress layers failed: {exc}")
                if accent_csl is not None:
                    _safe(lambda: progress.setProgressTintList(accent_csl))
            if accent_csl is not None:
                _safe(lambda: progress.setIndeterminateTintList(accent_csl))
                _safe(lambda: progress.setIndeterminateTintMode(PorterDuff.Mode.SRC_IN))
            indet = _safe(progress.getIndeterminateDrawable)
            if indet is not None:
                _safe(lambda: indet.mutate().setColorFilter(PorterDuffColorFilter(jint(accent_val), PorterDuff.Mode.SRC_IN)))
            progress.setIndeterminate(True)
            return progress
        except Exception as exc:
            error_log("voice progress bar failed", exc)
            return None

    def _show_view(self, token):
        if not self.active or token != self.token or self.view is not None:
            return
        try:
            from android import R as AndroidR
            from android.graphics.drawable import GradientDrawable
            frag = get_last_fragment()
            activity = frag.getParentActivity() if frag is not None else None
            if activity is None:
                return
            content = activity.findViewById(AndroidR.id.content)
            if content is None:
                return

            surface_color, text_color, accent_color, stroke_color, track_color = self._resolve_palette(frag)
            box = LinearLayout(activity)
            box.setOrientation(LinearLayout.VERTICAL)
            box.setPadding(AndroidUtilities.dp(16), AndroidUtilities.dp(12), AndroidUtilities.dp(16), AndroidUtilities.dp(12))
            background = GradientDrawable()
            _set_drawable_color(background, surface_color)
            background.setCornerRadius(float(AndroidUtilities.dp(20)))
            _set_drawable_stroke(background, AndroidUtilities.dp(1), stroke_color)
            box.setBackground(background)
            _safe(lambda: box.setElevation(float(AndroidUtilities.dp(8))))

            row, label = self._build_header_row(activity, text_color, accent_color)
            box.addView(row, LinearLayout.LayoutParams(-2, -2))

            progress = self._build_progress_bar(activity, accent_color, track_color)
            if progress is not None:
                bar_params = LinearLayout.LayoutParams(-1, AndroidUtilities.dp(4))
                bar_params.topMargin = AndroidUtilities.dp(10)
                box.addView(progress, bar_params)

            lp = FrameLayout.LayoutParams(-2, -2, Gravity.TOP | Gravity.LEFT)
            lp.leftMargin = AndroidUtilities.dp(6)
            lp.topMargin = AndroidUtilities.dp(6)
            self._drag_proxy = self._drag_listener()
            box.setOnTouchListener(self._drag_proxy)
            self.root = content
            content.addView(box, lp)
            self.view = box
            self.label = label
            self.progress = progress
            try:
                box.setAlpha(0.0)
                box.setTranslationY(float(AndroidUtilities.dp(12)))
                animation = box.animate()
                animation.alpha(1.0)
                animation.translationY(0.0)
                animation.setDuration(240)
                animation.start()
            except Exception:
                box.setAlpha(1.0)
                box.setTranslationY(0.0)
            self._place_view()
            run_on_ui_thread(self._place_view, 160)
            run_on_ui_thread(self._place_view, 700)
        except Exception as exc:
            error_log("voice progress view failed", exc)

    def _remove_view(self, view):
        def detach():
            self._end_action = None
            _safe(lambda: view.setOnTouchListener(None))
            try:
                parent = view.getParent()
                if parent is not None:
                    parent.removeView(view)
            except Exception as exc:
                error_log("voice progress view removal failed", exc)

        try:
            _safe(lambda: view.setOnTouchListener(None))
            if view.getParent() is None:
                return
            _safe(lambda: view.animate().cancel())
            animation = view.animate()
            animation.alpha(0.0)
            animation.translationY(float(AndroidUtilities.dp(10)))
            animation.setDuration(220)
            self._end_action = ClickRunnable(detach)
            animation.withEndAction(self._end_action)
            animation.start()
        except Exception:
            detach()

    def _update_label(self):
        label = self.label
        if label is None:
            return
        run_on_ui_thread(lambda: _safe(lambda: label.setText(JString(self._text()))), 0)

    def _set_progress(self, value):
        progress = self.progress
        if progress is None:
            return

        def update():
            try:
                progress.setIndeterminate(False)
                progress.setProgress(max(0, min(100, int(value))))
            except Exception as exc:
                error_log("voice progress view update failed", exc)

        run_on_ui_thread(update, 0)

    def _tick(self, token):
        if not self.active or token != self.token:
            return
        if not self.plugin._alive:
            self.stop()
            return
        if time.monotonic() - self.started >= self.limit:
            self.stop()
            toast(localized("Отправка не подтверждена. Проверьте чат", "Sending was not confirmed. Check the chat"))
            return
        self._update_label()
        run_on_ui_thread(lambda: self._tick(token), 6000)


class CircletPlugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self._pending = None
        self._alive = False
        self._voice_progress = None
        self._round_uploads = []
        self._voice_params_hooked = False
        self._hooks = []
        self._keep = []
        self._blocked = None

    def create_settings(self):
        if self._blocked:
            return [
                Header(text="Circlet"),
                Divider(text=self._blocked),
            ]
        unit = localized("кбит/с", "kbps")
        return [
            Header(text="Circlet"),
            Selector(
                key="round_resolution",
                text=localized("Разрешение кружка", "Video message resolution"),
                default=3,
                items=["240 × 240", "384 × 384", "480 × 480", "640 × 640"],
                icon="msg_video",
                on_change=self._on_round_resolution_change,
            ),
            Switch(
                key="round_upload_status",
                text=localized("Показывать отправку видеосообщения", "Show video message upload activity"),
                subtext=localized("Статус в чате до подтверждения отправки", "Chat activity until sending is confirmed"),
                default=True,
                icon="msg_video",
                on_change=self._on_round_upload_status_change,
            ),
            Selector(
                key="bitrate",
                text=localized("Битрейт голосовых", "Voice bitrate"),
                default=0,
                items=[f"64 {unit}", f"96 {unit}", f"128 {unit}", f"160 {unit}"],
                icon="msg_settings",
                on_change=self._on_bitrate_change,
            ),
            Text(
                text=localized("Очистить старые голосовые", "Clean up old voice files"),
                subtext=localized(
                    "Файлы Circlet старше 30 дней",
                    "Circlet files older than 30 days",
                ),
                icon="msg_delete",
                on_click=self._show_cleanup_dialog,
            ),
        ]

    def _on_round_resolution_change(self, idx):
        index = max(0, min(len(ROUND_RESOLUTIONS) - 1, int(idx)))
        self.set_setting("round_resolution", index)
        _SETTINGS["round_resolution"] = ROUND_RESOLUTIONS[index]

    def _on_round_upload_status_change(self, enabled):
        self.set_setting("round_upload_status", bool(enabled))
        if not enabled:
            for status in list(self._round_uploads):
                status.stop()

    def _on_bitrate_change(self, idx):
        try:
            _SETTINGS["bitrate"] = BITRATE_LEVELS[max(0, min(3, int(idx)))][1]
        except Exception as e:
            slog(f"bitrate setting failed: {e}")

    def keep(self, obj):
        self._keep.append(obj)

    def on_plugin_load(self):
        self._alive = True
        self._blocked = _client_problem()
        if self._blocked:
            boot_log(self._blocked)
            _show_blocked(self._blocked, is_alive=lambda: self._alive)
            return
        try:
            index = max(0, min(len(ROUND_RESOLUTIONS) - 1, int(self.get_setting("round_resolution", 3))))
            _SETTINGS["round_resolution"] = ROUND_RESOLUTIONS[index]
        except Exception:
            _SETTINGS["round_resolution"] = ROUND_SIZE
        try:
            _SETTINGS["bitrate"] = BITRATE_LEVELS[max(0, min(3, int(self.get_setting("bitrate", 0))))][1]
        except Exception as e:
            slog(f"bitrate init failed: {e}")
        boot_log("BOOT v2 plugin load")
        try:
            self._hook_attach_flow()
            boot_log("BOOT v2 hooks done count=%d" % len(self._hooks))
        except Exception as e:
            boot_log("BOOT v2 hook fail: %s" % e)
        try:
            helper = AccountInstance.getInstance(
                int(UserConfig.selectedAccount)
            ).getSendMessagesHelper()
            for method in array_items(helper.getClass().getMethods()):
                if method.getName() == "prepareSendingVoice":
                    slog("VOICE SIGNATURE " + str(method.toGenericString()))
        except Exception as e:
            slog(f"VOICE SIGNATURE failed: {e}")

    def _hook_send_pipeline(self):
        smh_cls = resolve_class("org.telegram.messenger.SendMessagesHelper")
        if smh_cls is None:
            return
        sp_count = 0
        for m in array_items(smh_cls.getDeclaredMethods()):
            try:
                if m.getName() != "sendMessage":
                    continue
                types = array_items(m.getParameterTypes())
                if not types or "SendMessageParams" not in str(types[0].getName()):
                    continue
                m.setAccessible(True)
                ref = self.hook_method(m, SendPipelineHook("sendMessage", self))
                if ref is not None:
                    self._hooks.append(ref)
                    self._voice_params_hooked = True
                    sp_count += 1
            except Exception as e:
                slog(f"sendMessage hook failed: {e}")
        boot_log(f"HOOK voice params hooked={sp_count}")

    def _hook_item_options(self):
        iopts_cls = resolve_class("org.telegram.ui.Components.ItemOptions") or resolve_class("org.telegram.ui.ActionBar.ItemOptions")
        boot_log("HOOK iopts=%s" % (iopts_cls is not None))
        if iopts_cls is not None:
            for m in iopts_cls.getDeclaredMethods():
                if m.getName() != "show" or len(m.getParameterTypes()) != 0:
                    continue
                m.setAccessible(True)
                try:
                    ref = self.hook_method(m, ItemOptionsHook(self))
                    if ref is not None:
                        self._hooks.append(ref)
                        boot_log("HOOK iopts show ok")
                except Exception as e:
                    boot_log("HOOK iopts fail: %s" % e)
        preview_cls = resolve_class(SEND_PREVIEW)
        if preview_cls is not None:
            method = find_method(preview_cls, "setItemOptions", 1)
            boot_log("HOOK preview setItemOptions found=%s" % (method is not None))
            if method is not None:
                try:
                    ref = self.hook_method(method, SendPreviewHook(self))
                    if ref is not None:
                        self._hooks.append(ref)
                        boot_log("HOOK preview ok")
                    else:
                        boot_log("HOOK preview ref None")
                except Exception as e:
                    boot_log("HOOK preview fail: %s" % e)

    def _hook_attach_flow(self):
        boot_log("HOOK popup=" + str(resolve_class(POPUP_WINDOW) is not None) + " attach=" + str(resolve_class(ATTACH_ALERT) is not None) + " viewer=" + str(resolve_class(PHOTO_VIEWER) is not None) + " preview=" + str(resolve_class(SEND_PREVIEW) is not None))
        popup_cls = resolve_class(POPUP_WINDOW)
        if popup_cls is not None:
            method = find_method(popup_cls, "showAtLocation", 4)
            if method is not None:
                try:
                    ref = self.hook_method(method, PopupShowHook(self))
                    if ref is not None:
                        self._hooks.append(ref)
                        boot_log("HOOK popup showAtLocation ok")
                    else:
                        boot_log("HOOK popup showAtLocation ref None")
                except Exception as e:
                    boot_log("HOOK popup fail: %s" % e)
        for cls_name, field in ((ATTACH_ALERT, "writeButton"), (PHOTO_VIEWER, "pickerViewSendButton")):
            cls = resolve_class(cls_name)
            if cls is None:
                continue
            try:
                refs = self.hook_all_constructors(cls, ButtonSeekHook(self, field))
                items = list(refs or [])
                self._hooks.extend(items)
                boot_log("HOOK ctor %s %s count=%d" % (cls_name, field, len(items)))
            except Exception as e:
                boot_log("HOOK ctor fail %s %s: %s" % (cls_name, field, e))
        self._hook_send_pipeline()
        self._hook_item_options()
        self._hook_live_viewer()

    def _hook_live_viewer(self):
        cls = resolve_class(PHOTO_VIEWER)
        if cls is None:
            return
        has = find_method(cls, "hasInstance", 0)
        if has is not None:
            try:
                if not bool(has.invoke(None, None)):
                    return
            except Exception as e:
                slog(f"hasInstance failed: {e}")
        getter = find_method(cls, "getInstance", 0)
        if getter is None:
            return
        try:
            viewer = getter.invoke(None, None)
        except Exception:
            return
        if viewer is None:
            return
        listener_cls = listener_class(viewer, "pickerViewSendButton")
        if listener_cls is None:
            return
        method = find_method(listener_cls, "onLongClick", 1)
        if method is None:
            return
        boot_log("HOOK live longclick found=%s" % (method is not None))
        try:
            ref = self.hook_method(method, SendLongClickHook())
            if ref is not None:
                self._hooks.append(ref)
                boot_log("HOOK live longclick ok")
            else:
                boot_log("HOOK live longclick ref None")
        except Exception as e:
            boot_log("HOOK live longclick fail: %s" % e)

    def on_plugin_unload(self):
        global _UNLOAD_GEN
        self._alive = False
        _UNLOAD_GEN += 1
        self._audio_wait_token = getattr(self, "_audio_wait_token", 0) + 1
        self._stop_voice_progress()
        sheet = ACTIVE.get("sheet")
        if sheet is not None and getattr(sheet.probe, "plugin", None) is self:
            sheet._dismiss()
        ACTIVE["sheet"] = None
        for status in list(self._round_uploads):
            status.stop()
        self._round_uploads = []
        for ref in list(self._hooks):
            _safe(self.unhook_method, ref)
        self._hooks = []
        self._keep = []
        self._pending = None
        self._voice_params_hooked = False
        HOSTS["alert"] = None
        HOSTS["popup"] = None
        HOSTS["preview"] = None
        HOSTS["dumped"] = False
        PREVIEW_STATE["path"] = None
        PREVIEW_STATE["doc"] = None
        PREVIEW_STATE["ts"] = 0.0
        ARMED["active"] = False
        ARMED["path"] = None
        ARMED["mo"] = None
        ARMED["doc"] = None
        _INJECTED_OPTIONS.clear()
        _WAVE_PREFETCH.clear()
        with _VOICE_ONCE_LOCK:
            _VOICE_ONCE_PATHS.clear()
        with _CACHE_LOCK:
            _CLASS_CACHE.clear()
            _METHOD_CACHE.clear()
            _FIELD_CACHE.clear()
            _FIELDS_CACHE.clear()

    def _start_voice_progress(self, probe):
        old = self._voice_progress
        if old is not None:
            old.stop()
        progress = VoiceProgress(
            self,
            getattr(probe, "account", UserConfig.selectedAccount),
            getattr(probe, "path", None),
        )
        self._voice_progress = progress
        progress.start()

    def _set_voice_progress_phase(self, phase):
        progress = self._voice_progress
        if progress is not None:
            progress.set_phase(phase)

    def _stop_voice_progress(self):
        progress = self._voice_progress
        self._voice_progress = None
        if progress is not None:
            progress.stop()

    def open_from_send_ui(self, path=None, once=False):
        try:
            dismiss_popup()
            current_path = resolve_send_path()
            if path is not None and path != current_path:
                if not (current_path is None and preview_state_path() == path):
                    toast(localized("Выбранный файл изменился", "Selected file changed"))
                    return False
            if current_path:
                path = current_path
            if not path or not media_kind(path):
                toast(localized("Выберите один видео- или аудиофайл", "Select one video or audio file"))
                return False
            if once and not once_allowed(get_last_fragment(), int(UserConfig.selectedAccount)):
                toast(localized("Одноразовые сообщения доступны только в личном чате с пользователем", "View-once messages require a private chat with another user"))
                return False
            if media_kind(path) == "audio":
                return self.open_audio(path, once)
            return self.open_for_path(path, once)
        except Exception as e:
            error_log("open from send UI failed", e)
            toast(localized("Не удалось открыть превью", "Could not open the preview"))
            return False

    def open_for_path(self, path, once=False):
        existing = ACTIVE.get("sheet")
        if existing is not None:
            dialog = existing.dialog
            showing = False
            if dialog is not None:
                try:
                    showing = bool(dialog.isShowing())
                except Exception:
                    showing = False
            if showing:
                return False
            ACTIVE["sheet"] = None

        if not path or not os.path.exists(path):
            toast(localized("Файл не найден", "File not found"))
            return False

        probe = VideoProbe(path)
        probe.ttl = ONCE_TTL if once else 0
        probe.target_fragment = get_last_fragment()
        probe.account = int(UserConfig.selectedAccount)
        probe.plugin = self
        probe.round_size = round_resolution()
        probe.send_context = capture_round_context(probe.target_fragment, probe.account)
        probe.edits = read_edits(path)

        def _prepare():
            ok = probe.run()
            if ok:
                slog(f"probe ok: {probe.width}x{probe.height} dur={probe.duration_ms} ms")
            else:
                slog("probe failed")

            def _open():
                if not self._alive or get_last_fragment() != probe.target_fragment or int(UserConfig.selectedAccount) != probe.account:
                    return
                if not ok:
                    toast(localized("Не удалось прочитать размеры видео", "Could not read video dimensions"))
                    return
                try:
                    vw_start, vw_end = viewer_trim_window_ms(int(probe.duration_ms), path)
                except Exception:
                    vw_start, vw_end = -1, -1
                saved_trim = (probe.edits or {}).get("trim")
                if vw_end <= 0 and saved_trim:
                    start_ms, end_ms = saved_trim
                    total_ms = int(probe.duration_ms)
                    if end_ms <= 0 or end_ms > total_ms:
                        end_ms = total_ms
                    if 0 <= start_ms < end_ms:
                        probe.trim_ms = (int(start_ms), int(end_ms))
                        vw_start, vw_end = probe.trim_ms
                if vw_end > 0 and vw_start > 0:
                    probe.fetch_frame_at(vw_start * 1000)
                    slog(f"preview frame re-fetched at {vw_start} ms")
                sheet = CropSheet(probe, send_round)
                self._pending = sheet
                try:
                    sheet.show()
                except Exception as e:
                    slog(f"sheet show failed: {e}")
                    toast(localized("Не удалось открыть превью", "Could not open the preview"))

            run_on_ui_thread(_open)

        threading.Thread(target=_prepare, daemon=True).start()
        return True

    def _read_audio_duration(self, ready_path):
        retriever = None
        duration_ms = 0
        try:
            retriever = MediaMetadataRetriever()
            retriever.setDataSource(ready_path)
            raw = retriever.extractMetadata(MediaMetadataRetriever.METADATA_KEY_DURATION)
            duration_ms = int(raw) if raw else 0
        except Exception as e:
            slog(f"audio duration failed: {e}")
        finally:
            if retriever is not None:
                _safe(retriever.release)
        return duration_ms

    def _open_ready_audio(self, ready_path, temporary_path, frag, account, dialog_id, once, token):
        if not self._alive or getattr(self, "_audio_wait_token", 0) != token or get_last_fragment() != frag:
            remove_temporary_audio(temporary_path)
            return
        duration_ms = self._read_audio_duration(ready_path)
        if duration_ms <= 0:
            remove_temporary_audio(temporary_path)
            toast(localized("Не удалось прочитать загруженный трек", "Could not read the downloaded track"))
            return

        class _AudioProbe:
            pass

        probe = _AudioProbe()
        probe.path = ready_path
        probe.duration_ms = duration_ms
        probe.width = 0
        probe.height = 0
        probe.rotation = 0
        probe.frame = None
        probe.ttl = ONCE_TTL if once else 0
        probe.dialog_id = int(dialog_id)
        probe.account = account
        probe.target_fragment = frag
        probe.plugin = self
        probe.temporary_audio_path = temporary_path

        try:
            sheet = CropSheet(
                probe,
                lambda pp, cs, r: self.send_voice_segment(pp),
                audio_mode=True,
            )
            sheet.temporary_audio_path = temporary_path
            if not sheet.show():
                raise RuntimeError("sheet.show returned False")
            self._pending = sheet
        except Exception as e:
            error_log("audio sheet failed", e)
            remove_temporary_audio(temporary_path)
            toast(localized("Не удалось открыть превью", "Could not open the preview"))

    def _resolve_audio_doc(self):
        alert = attach_alert_from_fragment()
        mo = selected_attachment_message(alert) if alert is not None else None
        doc = _audio_doc_from_entry(mo) if mo is not None else None
        if doc is None:
            doc = ARMED.get("doc")
        if doc is None:
            doc = _audio_doc_from_entry(ARMED.get("mo"))
        if doc is None:
            doc = preview_state_doc()
        return doc

    def _watch_audio_download(self, doc, source_path, expected_size, frag, account, dialog_id, once, token):
        state = {"tries": 0, "copying": False}

        def still_current():
            return self._alive and getattr(self, "_audio_wait_token", 0) == token and get_last_fragment() == frag

        def copy_downloaded_file(downloaded_path):
            try:
                temporary_path = make_temporary_audio_copy(downloaded_path)
            except Exception as e:
                slog(f"temporary audio copy failed: {e}")

                def copy_failed():
                    if still_current():
                        toast(localized("Не удалось подготовить загруженный трек", "Could not prepare the downloaded track"))

                run_on_ui_thread(copy_failed)
                return
            run_on_ui_thread(
                lambda p=temporary_path: self._open_ready_audio(p, p, frag, account, dialog_id, once, token)
            )

        def poll():
            if not still_current() or state["copying"]:
                return
            state["tries"] += 1
            current_path = audio_document_path(doc) or source_path
            try:
                size = os.path.getsize(current_path) if current_path and os.path.isfile(current_path) else 0
            except Exception:
                size = 0
            if size >= expected_size:
                state["copying"] = True
                slog(f"audio download ready: {size}/{expected_size}")
                toast(localized("Трек загружен", "Track downloaded"))
                threading.Thread(target=lambda p=current_path: copy_downloaded_file(p), daemon=True).start()
                return
            if state["tries"] % 10 == 1:
                slog(f"waiting for track download: {size}/{expected_size}")
            if state["tries"] >= 360:
                toast(localized(
                    "Трек не загружен. Попробуйте нажать значок загрузки ещё раз",
                    "Track was not downloaded. Try tapping its download icon again",
                ))
                return
            run_on_ui_thread(poll, 500)

        run_on_ui_thread(poll, 700)

    def open_audio(self, path, once=False):
        frag = get_last_fragment()
        if frag is None:
            toast(localized("Нет открытого чата", "No open chat"))
            return False
        if not path:
            toast(localized("Файл не найден", "File not found"))
            return False
        account = int(UserConfig.selectedAccount)
        if once and not once_allowed(frag, account):
            toast(localized(
                "Одноразовые сообщения доступны только в личном чате с пользователем",
                "View-once messages require a private chat with another user",
            ))
            return False
        dialog_id = resolve_dialog_id(frag)
        if not dialog_id:
            toast(localized("Не понял, в какой чат отправлять", "Could not determine the chat"))
            return False
        self._audio_wait_token = getattr(self, "_audio_wait_token", 0) + 1
        token = self._audio_wait_token
        if os.path.isfile(path):
            self._open_ready_audio(path, None, frag, account, dialog_id, once, token)
            return True
        doc = self._resolve_audio_doc()
        if doc is None:
            toast(localized("Не удалось определить выбранный трек", "Could not identify the selected track"))
            return False
        try:
            expected_size = int(doc.size)
        except Exception:
            expected_size = 0
        if expected_size <= 0:
            toast(localized("Не удалось определить размер трека", "Could not determine track size"))
            return False
        toast(localized(
            "Нажмите значок загрузки у трека. После загрузки откроется превью",
            "Tap the track's download icon. Preview will open when it finishes",
        ))
        self._watch_audio_download(doc, path, expected_size, frag, account, dialog_id, once, token)
        return True

    def send_voice_segment(self, probe):
        start_ms, end_ms = getattr(probe, "trim_ms", (0, 0)) or (0, 0)
        if end_ms - start_ms < 500:
            return False
        temporary_source = getattr(probe, "temporary_audio_path", None)
        gen = _UNLOAD_GEN
        self._start_voice_progress(probe)
        run_on_ui_thread(dismiss_popup, 0)
        run_on_ui_thread(close_hosts, 0)
        sheet = self._pending if getattr(self, "_pending", None) is not None else ACTIVE.get("sheet")
        bars = getattr(sheet, "wave_bars", None) if sheet is not None else None

        def work():
            try:
                wav_path, duration_sec = _decode_audio_segment(
                    probe.path,
                    start_ms,
                    end_ms,
                    stop_check=lambda: (not self._alive) or (_UNLOAD_GEN != gen),
                )

                def send():
                    if not self._alive or _UNLOAD_GEN != gen:
                        return
                    self._set_voice_progress_phase("sending")
                    self.send_voice_file(wav_path, duration_sec, probe, bars)

                run_on_ui_thread(send)
            except Exception as e:
                error_log("audio decode failed", e)
                self._stop_voice_progress()
                if self._alive and _UNLOAD_GEN == gen:
                    toast(localized(
                        "Не удалось подготовить голосовое",
                        "Could not prepare the voice message",
                    ))
            finally:
                if temporary_source:
                    remove_temporary_audio(temporary_source)
                else:
                    slog(f"voice cleanup: probe has no temporary path, source={probe.path}")

        threading.Thread(target=work, daemon=True).start()
        return True

    def send_voice_file(self, wav_path, duration_sec, probe, bars=None):
        try:
            progress = self._voice_progress
            if progress is not None:
                progress.add_path(wav_path)
            self._set_voice_progress_phase("sending")
            account = int(getattr(probe, "account", int(UserConfig.selectedAccount)))
            dialog_id = int(getattr(probe, "dialog_id", 0))
            ttl = int(getattr(probe, "ttl", 0) or 0)
            helper = AccountInstance.getInstance(account).getSendMessagesHelper()
            wf = _build_waveform(bars)

            if ttl:
                if not self._voice_params_hooked:
                    raise RuntimeError("SendMessageParams hook is not installed")
                with _VOICE_ONCE_LOCK:
                    _VOICE_ONCE_PATHS[wav_path] = time.time() + 120
                try:
                    self._send_voice_params(
                        helper, wav_path, duration_sec, probe,
                        account, dialog_id, ttl, bars,
                    )
                except Exception:
                    with _VOICE_ONCE_LOCK:
                        _VOICE_ONCE_PATHS.pop(wav_path, None)
                    raise
            elif self._try_send_voice_native(
                helper, wav_path, duration_sec, dialog_id, wf, ttl
            ):
                slog("voice sent via prepareSendingVoice")
            else:
                self._send_voice_params(
                    helper, wav_path, duration_sec, probe,
                    account, dialog_id, ttl, bars,
                )

            run_on_ui_thread(dismiss_popup, 0)
            run_on_ui_thread(close_hosts, 60)
        except Exception as e:
            error_log("send voice failed", e)
            self._stop_voice_progress()
            toast(localized("Не удалось отправить голосовое", "Could not send voice message"))

    def _try_send_voice_native(self, helper, wav_path, duration_sec, dialog_id, wf, ttl):
        try:
            cls = helper.getClass()
            cands = []
            for m in array_items(cls.getMethods()):
                if m.getName() == "prepareSendingVoice":
                    m.setAccessible(True)
                    cands.append(m)
            if not cands:
                slog("prepareSendingVoice not found")
                return False
            cands.sort(key=lambda m: -JArray.getLength(m.getParameterTypes()))
            for m in cands:
                types = [p.getName() for p in array_items(m.getParameterTypes())]
                if not types or types[0] != "java.lang.String":
                    continue
                args = []
                for i, t in enumerate(types):
                    if t == "java.lang.String":
                        args.append(JString(wav_path))
                    elif t == "int" and i == 1:
                        args.append(JInteger(int(duration_sec)))
                    elif t == "int":
                        args.append(JInteger(0))
                    elif t == "long":
                        args.append(JLong(dialog_id))
                    elif t == "byte[]":
                        args.append(wf if wf is not None else bytes(1))
                    elif t == "boolean":
                        args.append(JBoolean(False))
                    else:
                        args.append(None)
                slog(f"prepareSendingVoice types={types}")
                m.invoke(helper, args)
                return True
            slog("prepareSendingVoice unusable signatures")
            return False
        except Exception as e:
            slog(f"prepareSendingVoice fail: {e}")
            return False

    def _send_voice_params(self, helper, wav_path, duration_sec, probe, account, dialog_id, ttl, bars=None):
        doc = resolve_class("org.telegram.tgnet.TLRPC$TL_document").newInstance()
        set_typed_field(doc, "id", 0)
        set_typed_field(doc, "size", int(os.path.getsize(wav_path)))
        set_typed_field(doc, "date", int(time.time()))
        set_typed_field(doc, "mime_type", "audio/ogg")
        doc.file_reference = bytearray(0)
        doc.dc_id = 0
        attr = resolve_class("org.telegram.tgnet.TLRPC$TL_documentAttributeAudio").newInstance()
        attr.voice = True
        attr.duration = int(duration_sec)
        wf2 = _build_waveform(bars)
        if wf2:
            try:
                attr.waveform = wf2
            except Exception as e:
                slog(f"waveform assign failed: {e}")
        doc.attributes.add(attr)
        from client_utils import send_message
        send_message({
            "peer": int(dialog_id),
            "path": wav_path,
            "document": doc,
        }, account=account)
        slog("voice sent via client_utils.send_message")
    
    def _show_cleanup_dialog(self, view):
        try:
            from org.telegram.ui.ActionBar import AlertDialog as TelegramAlertDialog

            class CleanupButton(dynamic_proxy(TelegramAlertDialog.OnButtonClickListener)):
                def __init__(self, handler):
                    super().__init__()
                    self.handler = handler

                def onClick(self, *args):
                    self.handler()

            confirm = CleanupButton(self._start_voice_cleanup)
            cancel = CleanupButton(lambda: None)
            self.keep(confirm)
            self.keep(cancel)

            builder = TelegramAlertDialog.Builder(view.getContext())
            builder.setTitle(JString(localized(
                "Очистка файлов",
                "Clean up files",
            )))
            builder.setMessage(JString(localized(
                "Удалить голосовые файлы Circlet старше 30 дней? "
                "Если старое сообщение ещё ожидает повторной отправки, "
                "его файл может понадобиться Telegram.",
                "Delete Circlet voice files older than 30 days? "
                "Telegram may still need a file if an old message is waiting to be retried.",
            )))
            builder.setNegativeButton(
                JString(localized("Отмена", "Cancel")),
                cancel,
            )
            builder.setPositiveButton(
                JString(localized("Удалить", "Delete")),
                confirm,
            )
            builder.show()
        except Exception as e:
            slog(f"cleanup dialog failed: {type(e).__name__}: {e}")
            toast(localized(
                "Не удалось открыть подтверждение",
                "Could not open confirmation",
            ))


    def _start_voice_cleanup(self):
        def work():
            try:
                removed, freed, failed = clean_old_voice_files(30)

                def done():
                    mb = freed / (1024.0 * 1024.0)
                    message = localized(
                        f"Удалено файлов: {removed}, освобождено: {mb:.1f} МБ",
                        f"Files deleted: {removed}, freed: {mb:.1f} MB",
                    )
                    if failed:
                        message += localized(
                            f". Ошибок: {failed}",
                            f". Errors: {failed}",
                        )
                    toast(message)

                run_on_ui_thread(done)
            except Exception as e:
                slog(f"voice cleanup failed: {e}")
                run_on_ui_thread(lambda: toast(localized(
                    "Не удалось очистить файлы",
                    "Could not clean up files",
                )))

        threading.Thread(target=work, daemon=True).start()

ROUND_RESOLUTIONS = (240, 384, 480, 640)


def round_resolution(value=None):
    try:
        size = int(_SETTINGS.get('round_resolution', ROUND_SIZE) if value is None else value)
        return size if size in ROUND_RESOLUTIONS else ROUND_SIZE
    except Exception:
        return ROUND_SIZE


def context_value(obj, method, field=None):
    if obj is None:
        return None
    found = find_method(obj.getClass(), method, 0)
    if found is not None:
        val = _safe(found.invoke, obj, None)
        if val is not None:
            return val
    return get_field(obj, field) if field else None


def capture_round_context(frag, account):
    did = resolve_dialog_id(frag)
    instance = AccountInstance.getInstance(account)
    reply = context_value(frag, "getReplyMessage", "replyingMessageObject")
    if reply is None:
        enter = get_field(frag, "chatActivityEnterView")
        reply = context_value(enter, "getReplyingMessageObject", "replyingMessageObject")
    top = context_value(frag, "getThreadMessage", "threadMessageObject")
    if top is None:
        top = context_value(frag, "getReplyTopMessage", "replyingTopMessage")
    if top is None:
        _, top = topic_pair(instance, frag, did)
    return dict(
        dialog_id=did,
        account=int(account),
        reply=reply,
        top=top,
        quote=context_value(frag, "getReplyQuote", "replyingQuote"),
        topic_id=int(context_value(frag, "getTopicId") or 0),
        chat_args=context_value(frag, "getMessageChatSendParams"),
        mono_peer=int(context_value(frag, "getSendMonoForumPeerId") or 0),
    )


def crop_preview_dimensions(screen_w, screen_h):
    width = max(64, int(screen_w) - AndroidUtilities.dp(16))
    insets = int(getattr(AndroidUtilities, "statusBarHeight", 0) or 0) + int(getattr(AndroidUtilities, "navigationBarHeight", 0) or 0)
    height = max(64, int(screen_h) - insets - AndroidUtilities.dp(250))
    return width, height


def prepare_circlet_options(options):
    for name in ("layout", "lastLayout"):
        view = get_field(options, name)
        if view is not None:
            _safe(view.setTag, JString(INJECT_TAG))
    for name, value in (("forceBottom", False), ("forceTop", True), ("setLongPressSelectionEnabled", False)):
        method = find_method(options.getClass(), name, 1)
        if method is not None:
            _safe(method.invoke, options, [JBoolean(value)])
    method = find_method(options.getClass(), "translate", 2)
    if method is not None:
        _safe(method.invoke, options, [JFloat(0.0), JFloat(-AndroidUtilities.dp(12))])


def send_button_top(default):
    candidates = []
    alert = HOSTS.get("alert") or attach_alert_from_fragment()
    if alert is not None:
        candidates.append(get_field(alert, "writeButton"))
    cls = resolve_class(PHOTO_VIEWER)
    getter = find_method(cls, "getInstance", 0) if cls is not None else None
    viewer = _safe(getter.invoke, None, None) if getter is not None else None
    if viewer is not None:
        candidates.insert(0, get_field(viewer, "pickerViewSendButton"))
    for button in candidates:
        if button is None:
            continue
        try:
            rect = Rect()
            if button.isShown() and button.getGlobalVisibleRect(rect) and rect.top > 0:
                return int(rect.top)
        except Exception as exc:
            slog("send button rect: " + str(exc))
    return int(default)


def popup_top(y, old_height, new_height, anchor_top, top_limit, gap):
    return max(int(top_limit), min(int(y) - max(0, int(new_height) - int(old_height)), int(anchor_top) - int(gap) - int(new_height)))


def raise_circlet_popup(param, content, old_height):
    try:
        width = int(AndroidUtilities.displaySize.x)
        height = int(AndroidUtilities.displaySize.y)
        content.measure(View.MeasureSpec.makeMeasureSpec(width - AndroidUtilities.dp(16), View.MeasureSpec.AT_MOST), View.MeasureSpec.makeMeasureSpec(height - AndroidUtilities.dp(96), View.MeasureSpec.AT_MOST))
        measured = int(content.getMeasuredHeight())
        if measured <= 0:
            return
        gap = AndroidUtilities.dp(12)
        anchor_top = send_button_top(height - AndroidUtilities.dp(80))
        gravity = int(param.args[1])
        if gravity & Gravity.BOTTOM == Gravity.BOTTOM:
            param.args[3] = JInteger(max(int(param.args[3]), height - anchor_top + gap))
        elif gravity & Gravity.CENTER_VERTICAL != Gravity.CENTER_VERTICAL:
            param.args[3] = JInteger(popup_top(param.args[3], old_height, measured, anchor_top, AndroidUtilities.dp(8) + int(getattr(AndroidUtilities, "statusBarHeight", 0) or 0), gap))
    except Exception as exc:
        slog("popup position: " + str(exc))


class RoundUploadStatus:
    def __init__(self, plugin, probe, context, info=None):
        self.info = info
        self.plugin = plugin
        self.account = int(context["account"])
        self.dialog_id = int(context["dialog_id"])
        self.topic_id = int(context.get("topic_id", 0))
        self.path = str(probe.path)
        self.paths = {self.path}
        self.mid = None
        self.message_ids = set()
        self.message = None
        self.random_id = None
        self._typing_callbacks = {}
        self._typing_blocked = False
        self.center = None
        self.observer = None
        self.events = {}
        self.started = self.last_activity = time.monotonic()
        self.active = False

    def start(self):
        if not self.plugin._alive or not bool(self.plugin.get_setting("round_upload_status", True)):
            return
        from org.telegram.messenger import NotificationCenter
        status = self

        class Observer(dynamic_proxy(NotificationCenter.NotificationCenterDelegate)):
            def didReceivedNotification(self, event, account, args):
                if status.active and int(account) == status.account:
                    try:
                        status.received(int(event), list(args or []))
                    except Exception as exc:
                        slog("round status event: " + str(exc))

        self.center = NotificationCenter.getInstance(self.account)
        self.observer = Observer()
        self.active = True
        self.plugin._round_uploads.append(self)
        for name in ("didReceiveNewMessages", "filePreparingStarted", "filePreparingFailed", "fileNewChunkAvailable", "fileUploadProgressChanged", "fileUploaded", "fileUploadFailed", "messageReceivedByServer", "messageSendError", "messagesDeleted"):
            event = getattr(NotificationCenter, name, None)
            if event is not None:
                self.events[int(event)] = name
                self.center.addObserver(self.observer, int(event))
        self.pulse()

    def action(self, value):
        try:
            controller = AccountInstance.getInstance(self.account).getMessagesController()
            if self.private_action(controller, value):
                return
            method = find_method(controller.getClass(), "sendTyping", 4)
            if method is not None:
                method.invoke(controller, [JLong(self.dialog_id), JLong(self.topic_id), JInteger(value), JInteger(0)])
                return
            method = find_method(controller.getClass(), "sendTyping", 3)
            if method is not None and not self.topic_id:
                method.invoke(controller, [JLong(self.dialog_id), JInteger(value), JInteger(0)])
        except Exception as exc:
            slog("round upload activity: " + str(exc))

    def private_action(self, controller, value):
        if self.dialog_id <= 0:
            return False
        from org.telegram.messenger import DialogObject
        if DialogObject.isEncryptedDialog(self.dialog_id):
            return False
        if self.dialog_id == int(AccountInstance.getInstance(self.account).getUserConfig().getClientUserId()):
            return True
        method = find_method(controller.getClass(), "getInputPeer", 1)
        if method is None:
            return False
        peer = method.invoke(controller, [JLong(self.dialog_id)])
        if peer is None or not int(get_field(peer, "user_id") or 0):
            return False
        if self._typing_blocked or (value == 8 and 8 in self._typing_callbacks):
            return True
        from org.telegram.tgnet import TLRPC, RequestDelegate
        request = TLRPC.TL_messages_setTyping()
        request.peer = peer
        request.action = TLRPC.TL_sendMessageUploadRoundAction() if value == 8 else TLRPC.TL_sendMessageCancelAction()
        if value == 8:
            request.action.progress = 0
        status = self

        class Callback(dynamic_proxy(RequestDelegate)):
            def run(self, response, error):
                def finish():
                    if status._typing_callbacks.get(value) is self:
                        status._typing_callbacks.pop(value, None)
                    if error is not None:
                        status._typing_blocked = True
                        slog("round private activity unavailable: " + str(get_field(error, "text") or "request failed"))
                run_on_ui_thread(finish, 0)

        callback = Callback()
        self._typing_callbacks[value] = callback
        try:
            manager = AccountInstance.getInstance(self.account).getConnectionsManager()
            send = find_method(manager.getClass(), "sendRequest", 2)
            if send is None:
                self._typing_callbacks.pop(value, None)
                return False
            send.invoke(manager, [request, callback])
        except Exception:
            self._typing_callbacks.pop(value, None)
            raise
        return True

    def pulse(self):
        if not self.active:
            return
        if not self.plugin._alive or not bool(self.plugin.get_setting("round_upload_status", True)):
            self.stop()
            return
        if self.message is not None:
            owner = get_field(self.message, "messageOwner")
            state = get_field(owner, "send_state")
            mid = get_field(owner, "id")
            if state is not None and (int(state) == 2 or (int(state) == 0 and mid is not None and int(mid) > 0)):
                self.stop()
                return
        self.action(8)
        run_on_ui_thread(self.pulse, 4000)

    def bind(self, params):
        info = get_field(params, "videoEditedInfo")
        if info is None or not bool(get_field(info, "roundVideo")) or str(get_field(info, "originalPath") or "") != self.path or int(get_field(params, "peer") or 0) != self.dialog_id:
            return
        if self.info is not None and info != self.info:
            return
        self.last_activity = time.monotonic()
        path = get_field(params, "path")
        if path:
            self.paths.add(str(path))

    def matches(self, message):
        if message is None:
            return False
        info = get_field(message, "videoEditedInfo")
        owner = get_field(message, "messageOwner")
        path = get_field(owner, "attachPath") if owner is not None else None
        original = get_field(info, "originalPath") if info is not None else None
        did = context_value(message, "getDialogId") or get_field(owner, "dialog_id")
        if did is not None and int(did) != self.dialog_id:
            return False
        known_path = bool(path) and str(path) in self.paths
        same_info = info is not None and self.info is not None and info == self.info
        if not known_path and not same_info:
            if self.info is not None or str(original or "") != self.path:
                return False
        if get_field(owner, "out") is not None and not bool(get_field(owner, "out")):
            return False
        self.last_activity = time.monotonic()
        if path:
            self.paths.add(str(path))
        self.message = message
        random_id = get_field(owner, "random_id")
        if random_id is not None and int(random_id) != 0:
            self.random_id = int(random_id)
        mid = context_value(message, "getId") or get_field(owner, "id")
        if mid is not None:
            self.mid = int(mid)
            self.message_ids.add(self.mid)
        return True

    def received(self, event, args):
        name = self.events.get(event)
        if name == "didReceiveNewMessages" and len(args) > 1 and int(args[0]) == self.dialog_id:
            for message in array_items(args[1]):
                self.matches(message)
        elif name in ("filePreparingStarted", "filePreparingFailed", "fileNewChunkAvailable") and args:
            if self.matches(args[0]):
                if len(args) > 1:
                    self.paths.add(str(args[1]))
                if name == "filePreparingFailed":
                    self.stop()
        elif name == "fileUploadProgressChanged" and args and str(args[0]) in self.paths:
            self.last_activity = time.monotonic()
        elif name == "fileUploaded" and args and str(args[0]) in self.paths:
            self.last_activity = time.monotonic()
        elif name == "fileUploadFailed" and args and str(args[0]) in self.paths:
            self.stop()
        elif name in ("messageReceivedByServer", "messageSendError") and args:
            matched = int(args[0]) in self.message_ids or (self.mid is not None and int(args[0]) == self.mid)
            if not matched and name == "messageReceivedByServer" and len(args) > 2:
                owner = args[2]
                random_id = get_field(owner, "random_id")
                matched = self.random_id is not None and random_id is not None and int(random_id) == self.random_id
                if len(args) > 3 and int(args[3]) != self.dialog_id:
                    matched = False
            if matched:
                self.stop()
        elif name == "messagesDeleted" and args:
            ids = {int(mid) for mid in array_items(args[0])}
            if ids.intersection(self.message_ids) or (self.mid is not None and self.mid in ids):
                self.stop()

    def stop(self):
        if not self.active:
            return
        self.active = False
        for event in self.events:
            _safe(self.center.removeObserver, self.observer, event)
        if self in self.plugin._round_uploads:
            self.plugin._round_uploads.remove(self)
        if not any(item.active and (item.account, item.dialog_id, item.topic_id) == (self.account, self.dialog_id, self.topic_id) for item in self.plugin._round_uploads):
            self.action(2)
        self._typing_callbacks.clear()
        self.observer = None
        self.center = None
        self.message = None
