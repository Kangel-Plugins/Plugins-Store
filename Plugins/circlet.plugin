def voice_icon():
    if _VOICE_CACHE[0] is not None:
        return _VOICE_CACHE[0]
    res = 0
    try:
        from org.telegram.messenger import ApplicationLoader
        ctx = ApplicationLoader.applicationContext
        pkg = ctx.getPackageName()
        for name in ("input_mic", "msg_tabs_mic1", "preview_mic", "msg_voice", "voice_outlined"):
            try:
                found = int(ctx.getResources().getIdentifier(name, "drawable", pkg))
            except Exception:
                found = 0
            if found:
                res = found
                break
    except Exception:
        pass
    _VOICE_CACHE[0] = res
    return res


