            ),
            Switch(
                key="enable_grid_animation",
                text="Анимация смены сетки",
                subtext="Плавный эффект масштабирования (zoom pop) при смене количества столбцов",
                default=True,
                icon="msg_autodelete",
            ),
            Divider(),
            Selector(
                key="grid_columns_portrait",
                text="Столбцов (вертикально)",
