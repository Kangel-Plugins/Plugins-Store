_MEASURED_WIDTH_FIELD = None
_UPDATE_ITEMS_METHOD = None


def set_view_measured_width(view, width_val):
    global _MEASURED_WIDTH_FIELD
    if view is None:
        return False
    try:
        if _MEASURED_WIDTH_FIELD is not None:
            try:
                _MEASURED_WIDTH_FIELD.setInt(view, int(width_val))
                return True
            except Exception:
                _MEASURED_WIDTH_FIELD.set(view, Integer(int(width_val)))
                return True
        curr = view.getClass()
        while curr is not None:
            try:
                for f in curr.getDeclaredFields():
                    if f.getName() == "mMeasuredWidth":
                        f.setAccessible(True)
                        _MEASURED_WIDTH_FIELD = f
                        try:
                            f.setInt(view, int(width_val))
                        except Exception:
                            f.set(view, Integer(int(width_val)))
                        return True
            except Exception:
                pass
            curr = curr.getSuperclass()
    except Exception:
        pass
    return False


def invoke_update_items(adapter):
    global _UPDATE_ITEMS_METHOD
    if adapter is None:
        return False
    try:
        if _UPDATE_ITEMS_METHOD is not None:
            _UPDATE_ITEMS_METHOD.invoke(adapter)
            return True
        curr = adapter.getClass()
        while curr is not None:
            try:
                for m in curr.getDeclaredMethods():
                    if m.getName() == "updateItems" and len(m.getParameterTypes()) == 0:
                        m.setAccessible(True)
                        _UPDATE_ITEMS_METHOD = m
                        m.invoke(adapter)
                        return True
            except Exception:
                pass
            curr = curr.getSuperclass()
    except Exception:
        pass
    return False


class StickersUpdateItemsHook(MethodHook):
    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin
        self._pending = {}

    def before_hooked_method(self, param):
        try:
            adapter = param.thisObject
            if adapter is None:
                return
            ev = get_java_field(adapter, "this$0") or getattr(self.plugin, "_last_emoji_view", None)
            if ev is None:
                return
            self.plugin._last_emoji_view = ev
            target_cols = self.plugin.get_target_sticker_columns(ev)
            dp72 = get_telegram_dp(72) or 144
            fake_w = int(target_cols * dp72 + dp72 // 2)
            orig_w = ev.getMeasuredWidth()
            self._pending[id(param)] = (ev, orig_w)
            set_view_measured_width(ev, fake_w)
        except Exception:
            pass

    def after_hooked_method(self, param):
        try:
            stored = self._pending.pop(id(param), None)
            if stored is not None:
                ev, orig_w = stored
                set_view_measured_width(ev, orig_w)
        except Exception:
            pass


def is_sticker_emoji_cell(obj_or_cls):
    """Проверяет, является ли объект или класс экземпляром StickerEmojiCell (с кэшированием O(1))."""
    if obj_or_cls is None:
        return False
    try:
        cls = obj_or_cls.getClass() if hasattr(obj_or_cls, "getClass") else obj_or_cls
        cached = _STICKER_CELL_CACHE.get(cls)
        if cached is not None:
            return cached
        curr = cls
        is_match = False
        while curr is not None:
            name = str(curr.getName())
            if name.endswith("StickerSetNameCell") or "EmptyCell" in name or name.endswith("FeaturedStickerSetInfoCell"):
                is_match = False
                break
            if name.endswith("StickerEmojiCell") or name == "org.telegram.ui.Cells.StickerEmojiCell":
                is_match = True
                break
            curr = curr.getSuperclass()
        _STICKER_CELL_CACHE[cls] = is_match
        return is_match
    except Exception:
        pass
    return False


def is_create_sticker_cell(v):
    if v is None:
        return False
    try:
        cname = str(v.getClass().getName())
        if "FrameLayout" in cname and hasattr(v, "getChildCount") and v.getChildCount() == 1:
            ch = v.getChildAt(0)
            if ch is not None and "LinearLayout" in str(ch.getClass().getName()) and hasattr(ch, "getChildCount") and ch.getChildCount() >= 2:
                return True
    except Exception:
        pass
    return False


