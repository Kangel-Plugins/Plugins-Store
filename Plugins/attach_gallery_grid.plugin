__id__ = "attach_gallery_grid"
__name__ = "Attach Gallery Grid"
__description__ = "Attachment gallery, stickers, GIF & emoji grids: pinch-to-zoom columns, square proportional cells, smooth zoom animations, swipe-up keyboard expansion, in-place gallery sorting, and instant selection circle scaling."
__version__ = "1.5.8"
__author__ = "@qe4ank & Gemini Argon"
__min_version__ = "12.10.6"
__app_version__ = ">=12.10.6"
__category__ = ["appearance"]

import math
import time
from base_plugin import BasePlugin, MethodHook
