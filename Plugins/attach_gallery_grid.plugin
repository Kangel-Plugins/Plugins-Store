            if holder is not None:
                v = getattr(holder, "itemView", None)
                if v is not None:
                    if is_sticker_emoji_cell(v):
                        self.plugin.ensure_sticker_cell_hooked(v.getClass())
                    elif is_create_sticker_cell(v) or (param.args and len(param.args) > 1 and to_py_int(param.args[1], -1) == 7):
                        self.plugin.setup_create_sticker_cell(v)
        except Exception:
            pass


