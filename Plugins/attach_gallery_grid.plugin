                                    can_scroll_up = False
                                if not can_scroll_up:
                                    self.drag_expanded_triggered = True
                                    collapse_keyboard(enter_view)
                                    try:
                                        v.performHapticFeedback(3)
                                    except Exception:
                                        pass
                                    try:
                                        v.stopScroll()
                                    except Exception:
                                        pass
                                    return True

                elif action in (1, 3):  # ACTION_UP, ACTION_CANCEL
                    self.is_scrolling = False
                    self.drag_expanded_triggered = False

            if not self.plugin.get_setting("enable_gif_pinch", True):
                return self._forward_to_preview_viewer(v, event)

            if (now - self.last_pinch_end_time) < 0.35:
                disallow_all_parents_intercept(v, True)
                cancel_recycler_touch_and_scroll(v, self.orig_listener)
                return True

            if pointer_count >= 2:
                disallow_all_parents_intercept(v, True)
                set_emoji_view_ignore_pager_scroll(self.emoji_view, True)

                try:
                    v.stopScroll()
                except Exception:
                    pass

                x0 = event.getX(0)
                y0 = event.getY(0)
                x1 = event.getX(1)
                y1 = event.getY(1)
                dist = math.hypot(x0 - x1, y0 - y1)
                center_x = (x0 + x1) / 2.0
                center_y = (y0 + y1) / 2.0

                if action in (5, 0) or not self.is_pinching:
                    self.initial_dist = dist
                    self.is_pinching = True
                    self.was_pinching = True
                    cancel_content_preview_viewer(v)
                    cancel_recycler_touch_and_scroll(v, self.orig_listener)
                    return True

                elif action == 2:
                    if self.initial_dist <= 0:
                        self.initial_dist = dist
                        self.is_pinching = True
                        self.was_pinching = True

                    delta = dist - self.initial_dist
                    ctx_ev = self.emoji_view.getContext() if self.emoji_view is not None else None
                    is_land = is_device_landscape(ctx_ev, self.emoji_view)
                    threshold = get_telegram_dp(60) if is_land else get_telegram_dp(38)
                    cooldown = 0.35 if is_land else 0.28

                    if now - self.last_change_time > cooldown:
                        if delta > threshold:
                            self.initial_dist = dist
                            self.last_change_time = now
                            self.plugin.change_gif_density(self.emoji_view, v, delta=-1, center_x=center_x, center_y=center_y)
                            return True
                        elif delta < -threshold:
                            self.initial_dist = dist
                            self.last_change_time = now
                            self.plugin.change_gif_density(self.emoji_view, v, delta=+1, center_x=center_x, center_y=center_y)
                            return True

                    return True

            elif self.was_pinching:
                disallow_all_parents_intercept(v, True)
                cancel_recycler_touch_and_scroll(v, self.orig_listener)

                if action in (1, 3):
                    self.is_pinching = False
                    self.was_pinching = False
                    self.initial_dist = 0.0
                    self.last_pinch_end_time = now
                    disallow_all_parents_intercept(v, False)
                    set_emoji_view_ignore_pager_scroll(self.emoji_view, False)
                    self._ensure_click_listener(v)
                    return True

                return True

            return self._forward_to_preview_viewer(v, event)
        except Exception:
            return False


class PhotoLayoutPreMeasureHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        photo_layout = param.thisObject
        if photo_layout is None or not param.args:
            return

        width = to_py_int(param.args[0], 0)
        height = to_py_int(param.args[1], 0) if len(param.args) > 1 else 0

        self.plugin._last_photo_layout = photo_layout
        if ViewDetachListener is not None:
            try:
                def on_pl_detach(v):
                    if getattr(self.plugin, "_last_photo_layout", None) == v:
                        self.plugin._last_photo_layout = None
                photo_layout.addOnAttachStateChangeListener(ViewDetachListener(on_pl_detach))
            except Exception:
                pass
        self.plugin.ensure_sort_menu_item(photo_layout)
        handled = self.plugin.handle_pre_measure(photo_layout, width, height)
        if handled:
            param.setResult(None)


