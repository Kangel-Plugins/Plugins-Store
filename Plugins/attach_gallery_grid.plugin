from ui.settings import Header, Switch, Selector, Divider
from java import dynamic_proxy
from java.lang import Integer, Boolean
try:
    from java.lang import Float
except Exception:
    Float = float

CLS_PHOTO_LAYOUT = "org.telegram.ui.Components.ChatAttachAlertPhotoLayout"
CLS_PHOTO_CELL = "org.telegram.ui.Cells.PhotoAttachPhotoCell"
CLS_EMOJI_VIEW = "org.telegram.ui.Components.EmojiView"
CLS_STICKERS_ADAPTER = "org.telegram.ui.Components.EmojiView$StickersGridAdapter"
CLS_STICKER_CELL = "org.telegram.ui.Cells.StickerEmojiCell"
CLS_EXTENDED_GRID = "org.telegram.ui.Components.ExtendedGridLayoutManager"
CLS_CONTEXT_LINK_CELL = "org.telegram.ui.Cells.ContextLinkCell"
CLS_PREVIEW_VIEWER = "org.telegram.ui.ContentPreviewViewer"

SORT_MENU_ID = 9999


def get_drawable_id(name, fallback=0):
    try:
        r_drawable_cls = find_class("org.telegram.messenger.R$drawable")
        if r_drawable_cls is not None and hasattr(r_drawable_cls, name):
            return int(getattr(r_drawable_cls, name))
    except Exception:
        pass
    try:
        app_loader = find_class("org.telegram.messenger.ApplicationLoader")
        if app_loader is not None:
            ctx = app_loader.applicationContext
            if ctx is not None:
                res_id = ctx.getResources().getIdentifier(name, "drawable", ctx.getPackageName())
                if res_id != 0:
                    return int(res_id)
    except Exception:
        pass
    return fallback


_FIELD_CACHE = {}
_SET_MEASURED_DIMENSION = None


def to_py_int(val, default=0):
    if val is None:
        return default
    if isinstance(val, int):
        return val
    try:
        return int(val.longValue())
    except Exception:
        pass
    try:
        return int(val.intValue())
    except Exception:
        pass
    try:
        return int(val)
    except Exception:
        pass
    return default


def to_py_bool(val, default=False):
    if val is None:
        return default
    if isinstance(val, bool):
        return val
    try:
        return bool(val.booleanValue())
    except Exception:
        pass
    try:
        s = str(val).lower()
        if s == "true":
            return True
        elif s == "false":
            return False
    except Exception:
        pass
    try:
        return bool(int(val))
    except Exception:
        pass
    return default


def _get_cached_field(obj, field_name):
    if obj is None:
        return None
    try:
        cls = obj.getClass()
        key = (str(cls.getName()), field_name)
        if key in _FIELD_CACHE:
            return _FIELD_CACHE[key]

        curr = cls
        while curr is not None:
            try:
                for f in curr.getDeclaredFields():
                    if f.getName() == field_name:
                        f.setAccessible(True)
                        _FIELD_CACHE[key] = f
                        return f
            except Exception:
                pass
            curr = curr.getSuperclass()

        _FIELD_CACHE[key] = None
    except Exception:
        pass
    return None


def get_java_field(obj, field_name):
    if obj is None:
        return None
    try:
        f = _get_cached_field(obj, field_name)
        if f is not None:
            return f.get(obj)
    except Exception:
        pass
    try:
        return get_private_field(obj, field_name)
    except Exception:
        return None


def set_java_field(obj, field_name, value):
    if obj is None:
        return False
    try:
        f = _get_cached_field(obj, field_name)
        if f is not None:
            f.set(obj, value)
            return True
    except Exception:
        pass
    try:
        set_private_field(obj, field_name, value)
        return True
    except Exception:
        return False


def get_telegram_dp(val):
    try:
        au_cls = find_class("org.telegram.messenger.AndroidUtilities")
        if au_cls is not None:
            res = au_cls.dp(float(val))
            return to_py_int(res)
    except Exception:
        pass
    try:
        au_cls = find_class("org.telegram.messenger.AndroidUtilities")
        if au_cls is not None:
            res = au_cls.dp(int(val))
            return to_py_int(res)
    except Exception:
        pass
    return int(math.ceil(float(val) * 2.75))


def get_nav_bar_height():
    try:
        au_cls = find_class("org.telegram.messenger.AndroidUtilities")
        if au_cls is not None:
            val = get_java_field(au_cls, "navigationBarHeight")
            return to_py_int(val, 0)
    except Exception:
        pass
    return 0


def get_action_bar_height():
    try:
        ab_cls = find_class("org.telegram.ui.ActionBar.ActionBar")
        if ab_cls is not None:
            return to_py_int(ab_cls.getCurrentActionBarHeight(), get_telegram_dp(56))
    except Exception:
        pass
    return get_telegram_dp(56)


def is_device_landscape(context=None, view=None):
    """Определяет альбомную ориентацию устройства."""
    ctx = context or (view.getContext() if view is not None else None)
    if ctx is not None:
        try:
            cfg = ctx.getResources().getConfiguration()
            if cfg is not None:
                if cfg.orientation == 2:  # Configuration.ORIENTATION_LANDSCAPE
                    return True
                if cfg.orientation == 1:  # Configuration.ORIENTATION_PORTRAIT
                    return False
        except Exception:
            pass

    try:
        au_cls = find_class("org.telegram.messenger.AndroidUtilities")
        if au_cls is not None:
            ds = getattr(au_cls, "displaySize", None)
            if ds is not None:
                x = to_py_int(getattr(ds, "x", 0), 0)
                y = to_py_int(getattr(ds, "y", 0), 0)
                if x > 0 and y > 0:
                    return x > y
    except Exception:
        pass

    if ctx is not None:
        try:
            dm = ctx.getResources().getDisplayMetrics()
            if dm is not None:
                w = to_py_int(getattr(dm, "widthPixels", 0), 0)
                h = to_py_int(getattr(dm, "heightPixels", 0), 0)
                if w > 0 and h > 0:
                    return w > h
        except Exception:
            pass

    return False



def disallow_all_parents_intercept(view, disallow=True):
    """Рекурсивно запрещает родительским View (ViewPager, контейнерам) перехватывать жесты."""
    curr = view
    while curr is not None:
        try:
            curr.requestDisallowInterceptTouchEvent(disallow)
        except Exception:
            pass
        try:
            curr = curr.getParent()
        except Exception:
            break


_STICKER_CELL_CACHE = {}


def set_emoji_view_ignore_pager_scroll(emoji_view, ignore=True):
    """Блокирует горизонтальный скролл ViewPager при щипке (зуме), чтобы вкладки не съезжали."""
    if emoji_view is None:
        return
    try:
        set_java_field(emoji_view, "ignorePagerScroll", java.lang.Boolean(bool(ignore)))
    except Exception:
        pass
    try:
        pager = get_java_field(emoji_view, "pager")
        if pager is not None:
            pager.requestDisallowInterceptTouchEvent(bool(ignore))
    except Exception:
        pass


def is_preview_viewer_active():
    """Проверяет, активен ли оверлей предпросмотра стикеров/GIF (ContentPreviewViewer)."""
    try:
        cpv_cls = find_class(CLS_PREVIEW_VIEWER)
        if cpv_cls is not None:
            inst = cpv_cls.getInstance()
            if inst is not None and inst.isVisible():
                return True
    except Exception:
        pass
    return False


def cancel_content_preview_viewer(list_view=None, listener=None):
    """Отменяет активный просмотр стикера/GIF."""
    try:
        cpv_cls = find_class(CLS_PREVIEW_VIEWER)
        if cpv_cls is not None:
            inst = cpv_cls.getInstance()
            if inst is not None:
                try:
                    if inst.isVisible():
                        inst.close()
                except Exception:
                    pass
                try:
                    inst.reset()
                except Exception:
                    pass
    except Exception:
        pass
    if list_view is not None and listener is not None:
        try:
            if list_view.getOnItemClickListener() is None:
                list_view.setOnItemClickListener(listener)
        except Exception:
            pass


def call_set_measured_dimension(view, width, height):
    """Корректно устанавливает измеренные размеры View через защищенный метод setMeasuredDimension."""
    global _SET_MEASURED_DIMENSION
    try:
        if _SET_MEASURED_DIMENSION is None:
            view_cls = find_class("android.view.View")
            if view_cls is not None:
                for m in view_cls.getDeclaredMethods():
                    if m.getName() == "setMeasuredDimension" and len(m.getParameterTypes()) == 2:
                        m.setAccessible(True)
                        _SET_MEASURED_DIMENSION = m
                        break
        if _SET_MEASURED_DIMENSION is not None:
            _SET_MEASURED_DIMENSION.invoke(view, Integer(width), Integer(height))
            return True
    except Exception:
        pass

    try:
        set_java_field(view, "mMeasuredWidth", Integer(width))
        set_java_field(view, "mMeasuredHeight", Integer(height))
        return True
    except Exception:
        return False


def cancel_grid_touch_and_selection(photo_layout, grid_view):
    """Сбрасывает выделение фотографий, клики и останавливает скролл сетки фото."""
    if grid_view is None:
        return

    try:
        grid_view.stopScroll()
    except Exception:
        pass

    try:
        from android.view import MotionEvent
        from android.os import SystemClock
        now_ms = SystemClock.uptimeMillis()
        cancel_ev = MotionEvent.obtain(now_ms, now_ms, 3, 0.0, 0.0, 0)  # ACTION_CANCEL = 3
        grid_view.onTouchEvent(cancel_ev)
        cancel_ev.recycle()
    except Exception:
        pass

    if photo_layout is not None:
        try:
            irs = get_java_field(photo_layout, "itemRangeSelector")
            if irs is not None:
                set_java_field(irs, "dragSelectActive", Boolean(False))
        except Exception:
            pass

    try:
        child_count = grid_view.getChildCount()
        for i in range(child_count):
            child = grid_view.getChildAt(i)
            if child is not None:
                try:
                    child.setPressed(False)
                    set_java_field(child, "pressed", Boolean(False))
                except Exception:
                    pass
    except Exception:
        pass


def cancel_recycler_touch_and_scroll(recycler_view, orig_listener=None):
    """Сбрасывает клики, зажатия (preview), останавливает скролл и свайпы страниц."""
    if recycler_view is None:
        return

    cancel_content_preview_viewer()

    try:
        recycler_view.stopScroll()
    except Exception:
        pass

    try:
        from android.view import MotionEvent
        from android.os import SystemClock
        now_ms = SystemClock.uptimeMillis()
        cancel_ev = MotionEvent.obtain(now_ms, now_ms, 3, 0.0, 0.0, 0)  # ACTION_CANCEL = 3
        recycler_view.onTouchEvent(cancel_ev)

        parent = recycler_view.getParent()
        if parent is not None and hasattr(parent, "onTouchEvent"):
            try:
                parent.onTouchEvent(cancel_ev)
            except Exception:
                pass
        cancel_ev.recycle()
    except Exception:
        pass

    try:
        child_count = recycler_view.getChildCount()
        for i in range(child_count):
            child = recycler_view.getChildAt(i)
            if child is not None:
                try:
                    child.setPressed(False)
                    set_java_field(child, "pressed", Boolean(False))
                except Exception:
                    pass
    except Exception:
        pass

def is_enter_view(obj):
    if obj is None:
        return False
    try:
        cls = obj.getClass()
        while cls is not None:
            name = str(cls.getName())
            if (name == "org.telegram.ui.Components.ChatActivityEnterView" or name.endswith(".ChatActivityEnterView")) and "$" not in name:
                return True
            cls = cls.getSuperclass()
    except Exception:
        pass
    return False


def unwrap_enter_view(obj):
    if obj is None:
        return None
    if is_enter_view(obj):
        return obj
    try:
        outer = get_java_field(obj, "this$0")
        if outer is not None and is_enter_view(outer):
            return outer
    except Exception:
        pass
    return None


def get_enter_view(emoji_view):
    """Находит настоящий ChatActivityEnterView всеми надежными способами."""
    if emoji_view is None:
        return None

    # Путь 1: Прямая ссылка из fragment (ChatActivity.chatActivityEnterView)
    try:
        frag = get_java_field(emoji_view, "fragment")
        if frag is not None:
            ev = get_java_field(frag, "chatActivityEnterView")
            res = unwrap_enter_view(ev)
            if res is not None:
                return res
    except Exception:
        pass

    # Путь 2: Общий родитель (sizeNotifierLayout) -> перебор соседних View
    try:
        p = emoji_view.getParent()
        for _ in range(4):
            if p is None:
                break
            if hasattr(p, "getChildCount"):
                cnt = p.getChildCount()
                for i in range(cnt):
                    ch = p.getChildAt(i)
                    res = unwrap_enter_view(ch)
                    if res is not None:
                        return res
            p = p.getParent()
    except Exception:
        pass

    # Путь 3: Внутренние слушатели (dragListener, delegate, this$0)
    for fname in ("dragListener", "delegate", "currentChatActivity", "this$0"):
        try:
            obj = get_java_field(emoji_view, fname)
            res = unwrap_enter_view(obj)
            if res is not None:
                return res
        except Exception:
            pass

    return None


def get_expand_button(enter_view):
    """Находит кнопку со стрелочкой expandStickersButton."""
    if enter_view is None:
        return None

    # 1. Прямое поле
    try:
        btn = get_java_field(enter_view, "expandStickersButton")
        if btn is not None:
            return btn
    except Exception:
        pass

    # 2. Поиск в sendButtonContainer
    try:
        sbc = get_java_field(enter_view, "sendButtonContainer")
        if sbc is not None and hasattr(sbc, "getChildCount"):
            for i in range(sbc.getChildCount()):
                ch = sbc.getChildAt(i)
                if ch is not None and "ImageView" in str(ch.getClass().getName()):
                    return ch
    except Exception:
        pass

    # 3. Рекурсивный поиск в детях enter_view
    try:
        def find_btn(v, depth=0):
            if v is None or depth > 4:
                return None
            name = str(v.getClass().getName())
            if "ImageView" in name:
                desc = str(v.getContentDescription() or "")
                if any(k in desc.lower() for k in ("expand", "collapse", "панел", "раскрыть", "свернуть")):
                    return v
            if hasattr(v, "getChildCount"):
                for i in range(v.getChildCount()):
                    res = find_btn(v.getChildAt(i), depth + 1)
                    if res is not None:
                        return res
            return None
        btn = find_btn(enter_view)
        if btn is not None:
            return btn
    except Exception:
        pass

    return None


def is_keyboard_expanded(enter_view):
    """Проверяет, раскрыта ли клавиатура стикеров/GIF на весь экран."""
    if enter_view is None:
        return False
    try:
        val = get_java_field(enter_view, "stickersExpanded")
        if val is not None:
            return to_py_bool(val)
    except Exception:
        pass
    try:
        btn = get_expand_button(enter_view)
        if btn is not None:
            desc = str(btn.getContentDescription() or "").lower()
            if any(k in desc for k in ("collapse", "свернуть")):
                return True
            if any(k in desc for k in ("expand", "раскрыть")):
                return False
    except Exception:
        pass
    try:
        for m in enter_view.getClass().getMethods():
            if m.getName() in ("isStickersExpanded", "isExpanded"):
                return to_py_bool(m.invoke(enter_view))
    except Exception:
        pass
    return False


def set_keyboard_expanded(enter_view, expanded, animated=True):
    """Принудительно раскрывает/сворачивает панель стикеров/GIF или эмодзи через ChatActivityEnterView."""
    if enter_view is None:
        return False

    # 1. Сначала пробуем вызвать метод setStickersExpanded через рефлексию
    curr = enter_view.getClass()
    while curr is not None:
        try:
            for m in curr.getDeclaredMethods():
                if m.getName() == "setStickersExpanded":
                    m.setAccessible(True)
                    types = m.getParameterTypes()
                    if len(types) == 3:
                        m.invoke(enter_view, Boolean(expanded), Boolean(animated), Boolean(False))
                        return True
                    elif len(types) == 4:
                        m.invoke(enter_view, Boolean(expanded), Boolean(animated), Boolean(False), Boolean(True))
                        return True
                    elif len(types) == 2:
                        m.invoke(enter_view, Boolean(expanded), Boolean(animated))
                        return True
                    elif len(types) == 1:
                        m.invoke(enter_view, Boolean(expanded))
                        return True
        except Exception:
            pass
        curr = curr.getSuperclass()

    # 2. Временная смена видимости кнопки expandStickersButton и вызов performClick
    try:
        btn = get_expand_button(enter_view)
        if btn is not None:
            old_vis = btn.getVisibility() if hasattr(btn, "getVisibility") else 8
            old_alpha = btn.getAlpha() if hasattr(btn, "getAlpha") else 1.0
            try:
                if hasattr(btn, "setVisibility"):
                    btn.setVisibility(0)
                if hasattr(btn, "setAlpha"):
                    btn.setAlpha(1.0)
                if not btn.performClick():
                    btn.callOnClick()
            finally:
                if hasattr(btn, "setVisibility"):
                    btn.setVisibility(old_vis)
                if hasattr(btn, "setAlpha"):
                    btn.setAlpha(old_alpha)
            return True
    except Exception:
        pass

    # 3. Напрямую выставляем поле stickersExpanded и запрашиваем layout
    try:
        set_java_field(enter_view, "stickersExpanded", Boolean(expanded))
        if hasattr(enter_view, "requestLayout"):
            enter_view.requestLayout()
        parent = enter_view.getParent() if hasattr(enter_view, "getParent") else None
        if parent is not None and hasattr(parent, "requestLayout"):
            parent.requestLayout()
        return True
    except Exception:
        pass

    return False


def trigger_keyboard_toggle(enter_view, target_expanded):
    def _do_toggle():
        curr = is_keyboard_expanded(enter_view)
        if curr == target_expanded:
            return

        # 1. Если кнопка есть и она ВИДИМА (вкладка стикеров или GIF) - нажимаем её
        try:
            btn = get_expand_button(enter_view)
            if btn is not None:
                vis = btn.getVisibility() if hasattr(btn, "getVisibility") else 0
                if vis == 0:
                    if not btn.performClick():
                        btn.callOnClick()
                    if is_keyboard_expanded(enter_view) == target_expanded:
                        return
        except Exception:
            pass

        # 2. Если кнопки нет, она скрыта (вкладка Эмодзи) или клик не сработал -
        # напрямую раскрываем через set_keyboard_expanded
        try:
            set_keyboard_expanded(enter_view, target_expanded, True)
        except Exception:
            pass

    _do_toggle()
    try:
        if ProxyRunnable is not None and enter_view is not None and hasattr(enter_view, "post"):
            enter_view.post(ProxyRunnable(_do_toggle))
    except Exception:
        pass


def expand_keyboard(enter_view):
    trigger_keyboard_toggle(enter_view, True)
    return True


def collapse_keyboard(enter_view):
    trigger_keyboard_toggle(enter_view, False)
    return True

RunnableClass = find_class("java.lang.Runnable")
if RunnableClass is not None:
    class ProxyRunnable(dynamic_proxy(RunnableClass)):
        def __init__(self, callback):
            super().__init__()
            self._cb = callback

        def run(self):
            try:
                if self._cb is not None:
                    self._cb()
            except Exception:
                pass
else:
    ProxyRunnable = None

ViewOnClickListenerClass = find_class("android.view.View$OnClickListener")
if ViewOnClickListenerClass is not None:
    class ProxyClickListener(dynamic_proxy(ViewOnClickListenerClass)):
        def __init__(self, callback):
            super().__init__()
            self._cb = callback

        def onClick(self, v):
            try:
                if self._cb is not None:
                    self._cb(v)
            except Exception:
                pass
else:
    ProxyClickListener = None


class GridUpdateRunnable(dynamic_proxy(RunnableClass)):
    def __init__(self, plugin, grid_view):
        super().__init__()
        self.plugin = plugin
        self.grid_view = grid_view

    def run(self):
        try:
            self.plugin.update_visible_cells_checkbox(self.grid_view)
        except Exception:
            pass



OnAttachStateChangeListenerClass = find_class("android.view.View$OnAttachStateChangeListener")
OnLayoutChangeListenerClass = find_class("android.view.View$OnLayoutChangeListener")

if OnAttachStateChangeListenerClass is not None:
    class ViewDetachListener(dynamic_proxy(OnAttachStateChangeListenerClass)):
        def __init__(self, callback):
            super().__init__()
            self.callback = callback

        def onViewAttachedToWindow(self, v):
            pass

        def onViewDetachedFromWindow(self, v):
            try:
                if self.callback is not None:
                    self.callback(v)
                    self.callback = None
            except Exception:
                pass
            try:
                v.removeOnAttachStateChangeListener(self)
            except Exception:
                pass
else:
    ViewDetachListener = None

if OnLayoutChangeListenerClass is not None:
    class SquareLayoutChangeListener(dynamic_proxy(OnLayoutChangeListenerClass)):
        def onLayoutChange(self, v, left, top, right, bottom, oldLeft, oldTop, oldRight, oldBottom):
            try:
                w = right - left
                h = bottom - top
                if w > 0 and h != w:
                    lp = v.getLayoutParams()
                    if lp is not None and lp.height != w:
                        lp.height = w
                        v.setLayoutParams(lp)

                if w > 0 and hasattr(v, "getChildCount") and v.getChildCount() > 0:
                    container = v.getChildAt(0)
                    if container is not None and hasattr(container, "getChildCount"):
                        lp_c = container.getLayoutParams()
                        if lp_c is not None and hasattr(lp_c, "leftMargin"):
                            m4 = get_telegram_dp(4)
                            if lp_c.leftMargin != m4 or lp_c.rightMargin != m4:
                                lp_c.leftMargin = m4
                                lp_c.rightMargin = m4
                                lp_c.topMargin = m4
                                lp_c.bottomMargin = m4
                                container.setLayoutParams(lp_c)

                        tsize = 8.0 if w < get_telegram_dp(55) else (9.5 if w < get_telegram_dp(75) else 11.0)
                        icon_sz = get_telegram_dp(18) if w < get_telegram_dp(55) else get_telegram_dp(22)
                        for ci in range(container.getChildCount()):
                            ch = container.getChildAt(ci)
                            cname = str(ch.getClass().getName())
                            if "TextView" in cname:
                                ch.setSingleLine(True)
                                ch.setMaxLines(1)
                                ch.setTextSize(1, float(tsize))
                            elif "ImageView" in cname:
                                lp_i = ch.getLayoutParams()
                                if lp_i is not None and (lp_i.width != icon_sz or lp_i.height != icon_sz):
                                    lp_i.width = icon_sz
                                    lp_i.height = icon_sz
                                    ch.setLayoutParams(lp_i)
            except Exception:
                pass
else:
    SquareLayoutChangeListener = None

OnTouchListenerClass = find_class("android.view.View$OnTouchListener")


class GridPinchTouchListener(dynamic_proxy(OnTouchListenerClass)):
    def __init__(self, plugin, photo_layout):
        super().__init__()
        self.plugin = plugin
        self.photo_layout = photo_layout
        self.initial_dist = 0.0
        self.is_pinching = False
        self.was_pinching = False
        self.last_change_time = 0.0
        self.last_pinch_end_time = 0.0

    def onTouch(self, v, event):
        try:
            if not self.plugin.get_setting("enable_pinch_zoom", True):
                return False

            action = event.getActionMasked()
            pointer_count = event.getPointerCount()
            now = time.time()

            if (now - self.last_pinch_end_time) < 0.30:
                disallow_all_parents_intercept(v, True)
                cancel_grid_touch_and_selection(self.photo_layout, v)
                return True

            if pointer_count >= 2:
                disallow_all_parents_intercept(v, True)
                x0 = event.getX(0)
                y0 = event.getY(0)
                x1 = event.getX(1)
                y1 = event.getY(1)
                dist = math.hypot(x0 - x1, y0 - y1)
                center_x = (x0 + x1) / 2.0
                center_y = (y0 + y1) / 2.0

                if action in (5, 0) or not self.is_pinching:
                    self.initial_dist = dist
                    self.is_pinching = True
                    self.was_pinching = True
                    cancel_grid_touch_and_selection(self.photo_layout, v)
                    return True

                elif action == 2:
                    if self.initial_dist <= 0:
                        self.initial_dist = dist
                        self.is_pinching = True
                        self.was_pinching = True

                    delta = dist - self.initial_dist
                    ctx_pl = self.photo_layout.getContext() if self.photo_layout is not None else None
                    is_land = is_device_landscape(ctx_pl, self.photo_layout)
                    threshold = get_telegram_dp(64) if is_land else get_telegram_dp(40)
                    cooldown = 0.36 if is_land else 0.28

                    if now - self.last_change_time > cooldown:
                        if delta > threshold:
                            self.initial_dist = dist
                            self.last_change_time = now
                            self.plugin.change_columns(self.photo_layout, v, delta=-1, center_x=center_x, center_y=center_y)
                            return True
                        elif delta < -threshold:
                            self.initial_dist = dist
                            self.last_change_time = now
                            self.plugin.change_columns(self.photo_layout, v, delta=+1, center_x=center_x, center_y=center_y)
                            return True

                    return True

            elif self.was_pinching:
                disallow_all_parents_intercept(v, True)
                cancel_grid_touch_and_selection(self.photo_layout, v)

                if action in (1, 3):
                    self.is_pinching = False
                    self.was_pinching = False
                    self.initial_dist = 0.0
                    self.last_pinch_end_time = now
                    disallow_all_parents_intercept(v, False)
                    return True

                return True

            return False
        except Exception:
            return False



def forward_pinch_touch_to_preview_viewer(listener_obj, v, event, content_type_str="stickers"):
    """
    Единая диспетчеризация MotionEvent в ContentPreviewViewer для стикеров, GIF и эмодзи.
    Решает проблему «2 степеней зажатия»:
    - 1-я степень (краткое удержание до 200мс или предпросмотр без меню):
      при отпускании пальца (ACTION_UP / ACTION_CANCEL) немедленно закрывает и сбрасывает
      предпросмотр, отменяет openPreviewRunnable и возвращает масштаб ячейки, не давая превью зависнуть.
    - 2-я степень (долгое удержание >1.3с с открытым контекстным меню):
      меню остается открытым для выбора действия.
    - Обычный быстрый тап:
      мгновенно отменяет runnable предпросмотра и отправляет стикер/GIF без задержки.
    """
    try:
        action = event.getActionMasked()
        pv_active = is_preview_viewer_active()
        if getattr(listener_obj, "is_scrolling", False) and not pv_active:
            return False

        emoji_view = getattr(listener_obj, "emoji_view", None)
        orig_listener = getattr(listener_obj, "orig_listener", None)

        cpv_inst = None
        try:
            cpv_cls = find_class(CLS_PREVIEW_VIEWER)
            if cpv_cls is not None:
                cpv_inst = cpv_cls.getInstance()
        except Exception:
            pass

        # 1. Сначала отдаем событие нативному обработчику
        res = False
        if orig_listener is not None:
            try:
                res = bool(orig_listener.onTouch(v, event))
            except Exception:
                res = False
        elif cpv_inst is not None and emoji_view is not None:
            try:
                h = 0 if content_type_str == "gif" else emoji_view.getMeasuredHeight()
                listener = None
                if content_type_str == "stickers":
                    listener = get_java_field(emoji_view, "stickersOnItemClickListener")
                elif content_type_str == "gif":
                    listener = get_java_field(emoji_view, "gifOnItemClickListener")
                delegate = get_java_field(emoji_view, "contentPreviewViewerDelegate")
                resourcesProvider = get_java_field(emoji_view, "resourcesProvider")
                res = bool(cpv_inst.onTouch(event, v, h, listener, delegate, resourcesProvider))
            except Exception:
                res = False

        # 2. Обработка отпускания пальца (ACTION_UP / ACTION_CANCEL)
        if action in (1, 3):
            if cpv_inst is not None:
                try:
                    if cpv_inst.isVisible():
                        menu_vis = bool(get_java_field(cpv_inst, "menuVisible"))
                        if not menu_vis:
                            try:
                                cpv_inst.close()
                            except Exception:
                                pass
                            try:
                                cpv_inst.reset()
                            except Exception:
                                pass
                    else:
                        try:
                            cpv_inst.reset()
                        except Exception:
                            pass
                except Exception:
                    pass

                try:
                    cell = get_java_field(cpv_inst, "currentPreviewCell")
                    if cell is not None:
                        try:
                            cell.setScaled(False)
                        except Exception:
                            pass
                        set_java_field(cpv_inst, "currentPreviewCell", None)
                except Exception:
                    pass

            try:
                listener_obj._ensure_click_listener(v)
            except Exception:
                pass

            if pv_active or is_preview_viewer_active():
                return True
            return False

        if action == 0:
            if pv_active or is_preview_viewer_active():
                return True
            return False

        return True if (pv_active or is_preview_viewer_active()) else res
    except Exception:
        return False


class StickersPinchTouchListener(dynamic_proxy(OnTouchListenerClass)):
    def __init__(self, plugin, emoji_view, grid_view, orig_listener=None):
        super().__init__()
        self.plugin = plugin
        self.emoji_view = emoji_view
        self.grid_view = grid_view
        self.orig_listener = orig_listener
        self.initial_dist = 0.0
        self.is_pinching = False
        self.was_pinching = False
        self.last_change_time = 0.0
        self.last_pinch_end_time = 0.0
        self.start_x = 0.0
        self.start_y = 0.0
        self.is_scrolling = False
        self._cached_enter_view = None
        self.down_raw_y = 0.0
        self.down_y = 0.0
        self.drag_expanded_triggered = False

    def _ensure_click_listener(self, v):
        try:
            if is_preview_viewer_active():
                return
            if v is not None and v.getOnItemClickListener() is None and self.emoji_view is not None:
                l = get_java_field(self.emoji_view, "stickersOnItemClickListener")
                if l is not None:
                    v.setOnItemClickListener(l)
        except Exception:
            pass

    def _forward_to_preview_viewer(self, v, event):
        return forward_pinch_touch_to_preview_viewer(self, v, event, "stickers")

    def onTouch(self, v, event):
        try:
            action = event.getActionMasked()
            pointer_count = event.getPointerCount()
            now = time.time()

            if pointer_count == 1:
                x = event.getX()
                y = event.getY()
                raw_y = event.getRawY()

                if is_preview_viewer_active():
                    self.is_scrolling = False
                    disallow_all_parents_intercept(v, True)
                    self._forward_to_preview_viewer(v, event)
                    if action in (1, 3):
                        self.is_scrolling = False
                        disallow_all_parents_intercept(v, False)
                        self._ensure_click_listener(v)
                    return True

                if action == 0:  # ACTION_DOWN
                    self.start_x = x
                    self.start_y = y
                    self.down_raw_y = raw_y
                    self.down_y = y
                    self.drag_expanded_triggered = False
                    is_scrolling = False
                    try:
                        if hasattr(v, "getScrollState") and v.getScrollState() != 0:
                            is_scrolling = True
                    except Exception:
                        pass
                    self.is_scrolling = is_scrolling

                elif action == 2:  # ACTION_MOVE
                    start_x = getattr(self, "start_x", x)
                    start_y = getattr(self, "start_y", y)
                    if math.hypot(x - start_x, y - start_y) > get_telegram_dp(10):
                        self.is_scrolling = True
                        cancel_content_preview_viewer(v)

                    if self.plugin.get_setting("enable_drag_expand", True) and not getattr(self, "drag_expanded_triggered", False):
                        down_raw = getattr(self, "down_raw_y", raw_y)
                        delta_y = raw_y - down_raw
                        enter_view = getattr(self, "_cached_enter_view", None)
                        if enter_view is None or not is_enter_view(enter_view):
                            enter_view = get_enter_view(self.emoji_view)
                            self._cached_enter_view = enter_view

                        if enter_view is not None:
                            is_expanded = is_keyboard_expanded(enter_view)
                            if not is_expanded and delta_y < -get_telegram_dp(30) and y < get_telegram_dp(20):
                                self.drag_expanded_triggered = True
                                expand_keyboard(enter_view)
                                try:
                                    v.performHapticFeedback(3)
                                except Exception:
                                    pass
                                try:
                                    v.stopScroll()
                                except Exception:
                                    pass
                                return True
                            elif is_expanded and delta_y > get_telegram_dp(45):
                                try:
                                    can_scroll_up = v.canScrollVertically(-1)
                                except Exception:
                                    can_scroll_up = False
                                if not can_scroll_up:
                                    self.drag_expanded_triggered = True
                                    collapse_keyboard(enter_view)
                                    try:
                                        v.performHapticFeedback(3)
                                    except Exception:
                                        pass
                                    try:
                                        v.stopScroll()
                                    except Exception:
                                        pass
                                    return True

                elif action in (1, 3):  # ACTION_UP, ACTION_CANCEL
                    self.is_scrolling = False
                    self.drag_expanded_triggered = False

            if not self.plugin.get_setting("enable_stickers_pinch", True):
                return self._forward_to_preview_viewer(v, event)

            if (now - self.last_pinch_end_time) < 0.35:
                disallow_all_parents_intercept(v, True)
                cancel_recycler_touch_and_scroll(v, self.orig_listener)
                return True

            if pointer_count >= 2:
                disallow_all_parents_intercept(v, True)
                set_emoji_view_ignore_pager_scroll(self.emoji_view, True)

                try:
                    v.stopScroll()
                except Exception:
                    pass

                x0 = event.getX(0)
                y0 = event.getY(0)
                x1 = event.getX(1)
                y1 = event.getY(1)
                dist = math.hypot(x0 - x1, y0 - y1)
                center_x = (x0 + x1) / 2.0
                center_y = (y0 + y1) / 2.0

                if action in (5, 0) or not self.is_pinching:
                    self.initial_dist = dist
                    self.is_pinching = True
                    self.was_pinching = True
                    cancel_content_preview_viewer(v)
                    cancel_recycler_touch_and_scroll(v, self.orig_listener)
                    return True

                elif action == 2:
                    if self.initial_dist <= 0:
                        self.initial_dist = dist
                        self.is_pinching = True
                        self.was_pinching = True

                    delta = dist - self.initial_dist
                    ctx_ev = self.emoji_view.getContext() if self.emoji_view is not None else None
                    is_land = is_device_landscape(ctx_ev, self.emoji_view)
                    threshold = get_telegram_dp(60) if is_land else get_telegram_dp(38)
                    cooldown = 0.35 if is_land else 0.28

                    if now - self.last_change_time > cooldown:
                        if delta > threshold:
                            self.initial_dist = dist
                            self.last_change_time = now
                            self.plugin.change_sticker_columns(self.emoji_view, v, delta=-1, center_x=center_x, center_y=center_y)
                            return True
                        elif delta < -threshold:
                            self.initial_dist = dist
                            self.last_change_time = now
                            self.plugin.change_sticker_columns(self.emoji_view, v, delta=+1, center_x=center_x, center_y=center_y)
                            return True

                    return True

            elif self.was_pinching:
                disallow_all_parents_intercept(v, True)
                cancel_recycler_touch_and_scroll(v, self.orig_listener)

                if action in (1, 3):
                    self.is_pinching = False
                    self.was_pinching = False
                    self.initial_dist = 0.0
                    self.last_pinch_end_time = now
                    disallow_all_parents_intercept(v, False)
                    set_emoji_view_ignore_pager_scroll(self.emoji_view, False)
                    self._ensure_click_listener(v)
                    return True

                return True

            return self._forward_to_preview_viewer(v, event)
        except Exception:
            return False


class EmojiPinchTouchListener(dynamic_proxy(OnTouchListenerClass)):
    def __init__(self, plugin, emoji_view, grid_view, orig_listener=None):
        super().__init__()
        self.plugin = plugin
        self.emoji_view = emoji_view
        self.grid_view = grid_view
        self.orig_listener = orig_listener
        self.initial_dist = 0.0
        self.is_pinching = False
        self.was_pinching = False
        self.last_change_time = 0.0
        self.last_pinch_end_time = 0.0
        self.start_x = 0.0
        self.start_y = 0.0
        self.is_scrolling = False
        self._cached_enter_view = None
        self.down_raw_y = 0.0
        self.down_y = 0.0
        self.drag_expanded_triggered = False

    def _ensure_click_listener(self, v):
        pass

    def _forward_to_preview_viewer(self, v, event):
        return forward_pinch_touch_to_preview_viewer(self, v, event, "emoji")

    def onTouch(self, v, event):
        try:
            action = event.getActionMasked()
            pointer_count = event.getPointerCount()
            now = time.time()

            if pointer_count == 1:
                x = event.getX()
                y = event.getY()
                raw_y = event.getRawY()

                if is_preview_viewer_active():
                    self.is_scrolling = False
                    disallow_all_parents_intercept(v, True)
                    self._forward_to_preview_viewer(v, event)
                    if action in (1, 3):
                        self.is_scrolling = False
                        disallow_all_parents_intercept(v, False)
                        self._ensure_click_listener(v)
                    return True

                if action == 0:  # ACTION_DOWN
                    self.start_x = x
                    self.start_y = y
                    self.down_raw_y = raw_y
                    self.down_y = y
                    self.drag_expanded_triggered = False
                    is_scrolling = False
                    try:
                        if hasattr(v, "getScrollState") and v.getScrollState() != 0:
                            is_scrolling = True
                    except Exception:
                        pass
                    self.is_scrolling = is_scrolling

                elif action == 2:  # ACTION_MOVE
                    start_x = getattr(self, "start_x", x)
                    start_y = getattr(self, "start_y", y)
                    if math.hypot(x - start_x, y - start_y) > get_telegram_dp(10):
                        self.is_scrolling = True
                        cancel_content_preview_viewer(v)

                    if self.plugin.get_setting("enable_drag_expand", True) and not getattr(self, "drag_expanded_triggered", False):
                        down_raw = getattr(self, "down_raw_y", raw_y)
                        delta_y = raw_y - down_raw
                        enter_view = getattr(self, "_cached_enter_view", None)
                        if enter_view is None or not is_enter_view(enter_view):
                            enter_view = get_enter_view(self.emoji_view)
                            self._cached_enter_view = enter_view

                        if enter_view is not None:
                            is_expanded = is_keyboard_expanded(enter_view)
                            if not is_expanded and delta_y < -get_telegram_dp(30) and y < get_telegram_dp(20):
                                self.drag_expanded_triggered = True
                                expand_keyboard(enter_view)
                                try:
                                    v.performHapticFeedback(3)
                                except Exception:
                                    pass
                                try:
                                    v.stopScroll()
                                except Exception:
                                    pass
                                return True
                            elif is_expanded and delta_y > get_telegram_dp(45):
                                try:
                                    can_scroll_up = v.canScrollVertically(-1)
                                except Exception:
                                    can_scroll_up = False
                                if not can_scroll_up:
                                    self.drag_expanded_triggered = True
                                    collapse_keyboard(enter_view)
                                    try:
                                        v.performHapticFeedback(3)
                                    except Exception:
                                        pass
                                    try:
                                        v.stopScroll()
                                    except Exception:
                                        pass
                                    return True

                elif action in (1, 3):  # ACTION_UP, ACTION_CANCEL
                    self.is_scrolling = False
                    self.drag_expanded_triggered = False

            if not self.plugin.get_setting("enable_emoji_pinch", True):
                return self._forward_to_preview_viewer(v, event)

            if (now - self.last_pinch_end_time) < 0.35:
                disallow_all_parents_intercept(v, True)
                cancel_recycler_touch_and_scroll(v, self.orig_listener)
                return True

            if pointer_count >= 2:
                disallow_all_parents_intercept(v, True)
                set_emoji_view_ignore_pager_scroll(self.emoji_view, True)

                try:
                    v.stopScroll()
                except Exception:
                    pass

                x0 = event.getX(0)
                y0 = event.getY(0)
                x1 = event.getX(1)
                y1 = event.getY(1)
                dist = math.hypot(x0 - x1, y0 - y1)
                center_x = (x0 + x1) / 2.0
                center_y = (y0 + y1) / 2.0

                if action in (5, 0) or not self.is_pinching:
                    self.initial_dist = dist
                    self.is_pinching = True
                    self.was_pinching = True
                    cancel_content_preview_viewer(v)
                    cancel_recycler_touch_and_scroll(v, self.orig_listener)
                    return True

                elif action == 2:
                    if self.initial_dist <= 0:
                        self.initial_dist = dist
                        self.is_pinching = True
                        self.was_pinching = True

                    delta = dist - self.initial_dist
                    ctx_ev = self.emoji_view.getContext() if self.emoji_view is not None else None
                    is_land = is_device_landscape(ctx_ev, self.emoji_view)
                    threshold = get_telegram_dp(55) if is_land else get_telegram_dp(35)
                    cooldown = 0.35 if is_land else 0.28

                    if now - self.last_change_time > cooldown:
                        if delta > threshold:
                            self.initial_dist = dist
                            self.last_change_time = now
                            self.plugin.change_emoji_columns(self.emoji_view, v, delta=-1, center_x=center_x, center_y=center_y)
                            return True
                        elif delta < -threshold:
                            self.initial_dist = dist
                            self.last_change_time = now
                            self.plugin.change_emoji_columns(self.emoji_view, v, delta=+1, center_x=center_x, center_y=center_y)
                            return True

                    return True

            elif self.was_pinching:
                disallow_all_parents_intercept(v, True)
                cancel_recycler_touch_and_scroll(v, self.orig_listener)

                if action in (1, 3):
                    self.is_pinching = False
                    self.was_pinching = False
                    self.initial_dist = 0.0
                    self.last_pinch_end_time = now
                    disallow_all_parents_intercept(v, False)
                    set_emoji_view_ignore_pager_scroll(self.emoji_view, False)
                    return True

                return True

            return self._forward_to_preview_viewer(v, event)
        except Exception:
            return False


