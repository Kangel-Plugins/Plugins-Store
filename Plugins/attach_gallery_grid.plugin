            ),
            Selector(
                key="emoji_columns_landscape",
                text="Столбцов эмодзи (горизонтально)",
                default=4,
                items=self.EMOJI_LANDSCAPE_ITEMS,
                icon="msg_emoji",
                on_change=self._on_setting_changed,
            ),
            Divider(text="Количество столбцов эмодзи в альбомной (горизонтальной) ориентации"),
            Divider(),
            Header(text="Выезжание клавиатуры"),
            Switch(
                key="enable_drag_expand",
                text="Выезжание клавиатуры свайпом вверх",
                subtext="Раскрывать клавиатуру стикеров, эмодзи и GIF во весь экран при свайпе пальцем вверх за пределы клавиатуры",
                default=True,
                icon="msg_openin",
            ),
            Divider(text="Если просто скроллить внутри стикеров/эмодзи/GIF — работает обычный скролл. Если одним движением провести палец вверх выше клавиатуры — она плавно раскроется во весь экран. Свайп вниз у самого верха списка свернёт её обратно."),
        ]

    def on_plugin_load(self):
        self._unhooks = []
        self._attached_sort_menus = set()
        self._last_photo_layout = None
        self._last_emoji_view = None
        self._last_applied_columns = -1
        self._last_applied_size = -1
        self._current_columns = -1
        self._current_item_size = -1
        self._attached_pinch_layouts = {}
        self._attached_stickers_pinch = {}
        self._attached_gif_pinch = {}
        self._attached_emoji_pinch = {}
        self._hooked_emoji_grid_classes = set()
        self._hooked_sticker_classes = set()
        self._is_updating_stickers = False
        self._photo_cell_hooked = False
        self._emoji_view_hooked = False
        _FIELD_CACHE.clear()

        photo_layout_cls = find_class(CLS_PHOTO_LAYOUT)
        if photo_layout_cls is not None:
            pre_hook = PhotoLayoutPreMeasureHook(self)
            u_pre = self.hook_all_methods(photo_layout_cls, "onPreMeasure", pre_hook)
            if u_pre:
                self._unhooks.extend(u_pre)

            # setTranslationY hook removed to prevent 60-120fps reflection lags on bottom sheet scroll
            pass

            show_hook = PhotoLayoutOnShowHook(self)
            u_show = self.hook_all_methods(photo_layout_cls, "onShow", show_hook)
            if u_show:
                self._unhooks.extend(u_show)

            menu_hook = PhotoLayoutOnMenuItemClickHook(self)
            u_menu = self.hook_all_methods(photo_layout_cls, "onMenuItemClick", menu_hook)
            if u_menu:
                self._unhooks.extend(u_menu)

            notif_hook = PhotoLayoutNotificationHook(self)
            u_notif = self.hook_all_methods(photo_layout_cls, "didReceivedNotification", notif_hook)
            if u_notif:
                self._unhooks.extend(u_notif)

        self.ensure_photo_cell_hooked()
        self.ensure_emoji_view_hooked()

    def on_plugin_unload(self):
        if hasattr(self, "_unhooks") and self._unhooks:
            for u in self._unhooks:
                try:
                    u.unhook()
                except Exception:
                    pass
            self._unhooks.clear()
        self._photo_cell_hooked = False
        self._emoji_view_hooked = False
        self._last_photo_layout = None
        self._last_emoji_view = None
        self._last_applied_columns = -1
        self._last_applied_size = -1
        self._current_columns = -1
        self._current_item_size = -1
        self._attached_pinch_layouts.clear()
        self._attached_stickers_pinch.clear()
        self._attached_gif_pinch.clear()
        self._attached_emoji_pinch.clear()
        self._hooked_emoji_grid_classes.clear()
        self._hooked_sticker_classes.clear()
        _FIELD_CACHE.clear()

    def _parse_columns(self, key, default_idx, items_list):
        val = self.get_setting(key, default_idx)
        try:
            min_c = int(items_list[0])
            max_c = int(items_list[-1])
        except Exception:
            min_c, max_c = 2, 16

        if isinstance(val, int):
            if 0 <= val < len(items_list):
                try:
                    return int(items_list[val])
                except Exception:
                    pass
            if min_c <= val <= max_c:
                return val
            if val > max_c:
                return max_c
            if val < min_c:
                return min_c

        if isinstance(val, str):
            val = val.strip()
            if val in items_list:
                try:
                    return int(val)
                except Exception:
                    pass
            if val.isdigit():
                idx = int(val)
                if 0 <= idx < len(items_list):
                    return int(items_list[idx])
                if min_c <= idx <= max_c:
                    return idx
                if idx > max_c:
                    return max_c
                if idx < min_c:
                    return min_c

        return int(items_list[default_idx])

    def get_target_columns(self, photo_layout, width, height):
        ctx = photo_layout.getContext() if photo_layout is not None else None
        if is_device_landscape(ctx, photo_layout) and self.get_setting("separate_landscape", True):
            return self._parse_columns("grid_columns_landscape", 3, self.LANDSCAPE_ITEMS)
        else:
            return self._parse_columns("grid_columns_portrait", 2, self.PORTRAIT_ITEMS)

    def ensure_photo_cell_hooked(self):
        if getattr(self, "_photo_cell_hooked", False):
            return
        try:
            photo_cell_cls = find_class(CLS_PHOTO_CELL)
            if photo_cell_cls is not None:
                cell_hook = PhotoCellSetItemSizeHook(self)
                u1 = self.hook_all_methods(photo_cell_cls, "setItemSize", cell_hook)
                if u1:
                    self._unhooks.extend(u1)

                attach_hook = PhotoCellAttachedHook(self)
                u2 = self.hook_all_methods(photo_cell_cls, "onAttachedToWindow", attach_hook)
                if u2:
                    self._unhooks.extend(u2)

                self._photo_cell_hooked = True
        except Exception:
            pass

    def ensure_sticker_cell_hooked(self, cell_cls):
        """Хукает onMeasure для ячеек StickerEmojiCell, чтобы задать квадратную высоту (1:1)."""
        if cell_cls is None or cell_cls in self._hooked_sticker_classes:
            return
        try:
            measure_hook = StickerCellMeasureHook(self)
            u = self.hook_all_methods(cell_cls, "onMeasure", measure_hook)
            if u:
                self._unhooks.extend(u)
                self._hooked_sticker_classes.add(cell_cls)
                # Перемеряем сетку, чтобы ячейки немедленно стали квадратными
                ev = getattr(self, "_last_emoji_view", None)
                if ev is not None:
                    grid = get_java_field(ev, "stickersGridView")
                    if grid is not None:
                        try:
                            grid.requestLayout()
                        except Exception:
                            pass
        except Exception as e:
            self.log(f"[AttachGalleryGrid] ensure_sticker_cell_hooked error: {e}")

    def setup_create_sticker_cell(self, cell):
        try:
            if cell is None:
                return
            if SquareLayoutChangeListener is not None:
                listener = SquareLayoutChangeListener()
                cell.addOnLayoutChangeListener(listener)

            w = cell.getWidth()
            if w > 0:
                lp = cell.getLayoutParams()
                if lp is not None and lp.height != w:
                    lp.height = w
                    cell.setLayoutParams(lp)

            if hasattr(cell, "getChildCount") and cell.getChildCount() > 0:
                container = cell.getChildAt(0)
                if container is not None:
                    lp = container.getLayoutParams()
                    if lp is not None and hasattr(lp, "leftMargin"):
                        m4 = get_telegram_dp(4)
                        lp.leftMargin = m4
                        lp.rightMargin = m4
                        lp.topMargin = m4
                        lp.bottomMargin = m4
                        container.setLayoutParams(lp)

                    if hasattr(container, "getChildCount"):
                        for ci in range(container.getChildCount()):
                            ch = container.getChildAt(ci)
                            cname = str(ch.getClass().getName())
                            if "TextView" in cname:
                                ch.setSingleLine(True)
                                ch.setMaxLines(1)
                                ch.setTextSize(1, 9.5)
                            elif "ImageView" in cname:
                                lp_i = ch.getLayoutParams()
                                if lp_i is not None:
                                    s20 = get_telegram_dp(20)
                                    lp_i.width = s20
                                    lp_i.height = s20
                                    ch.setLayoutParams(lp_i)
        except Exception as e:
            self.log(f"[AttachGalleryGrid] setup_create_sticker_cell error: {e}")

    def ensure_emoji_view_hooked(self):
        if getattr(self, "_emoji_view_hooked", False):
            return
        try:
            ev_cls = find_class(CLS_EMOJI_VIEW)
            if ev_cls is not None:
                attach_hook = EmojiViewAttachedHook(self)
                u1 = self.hook_all_methods(ev_cls, "onAttachedToWindow", attach_hook)
                if u1:
                    self._unhooks.extend(u1)

                config_hook = EmojiViewConfigHook(self)
                u_cfg = self.hook_all_methods(ev_cls, "onConfigurationChanged", config_hook)
                if u_cfg:
                    self._unhooks.extend(u_cfg)

                size_hook = EmojiViewSizeChangedHook(self)
                u_sz = self.hook_all_methods(ev_cls, "onSizeChanged", size_hook)
                if u_sz:
                    self._unhooks.extend(u_sz)



            stickers_adapter_cls = find_class(CLS_STICKERS_ADAPTER)
            if stickers_adapter_cls is not None:
                update_hook = StickersUpdateItemsHook(self)
                u3 = self.hook_all_methods(stickers_adapter_cls, "updateItems", update_hook)
                if u3:
                    self._unhooks.extend(u3)

                create_vh_hook = StickersCreateViewHolderHook(self)
                u3b = self.hook_all_methods(stickers_adapter_cls, "onCreateViewHolder", create_vh_hook)
                if u3b:
                    self._unhooks.extend(u3b)

            sticker_cell_cls = find_class(CLS_STICKER_CELL)
            if sticker_cell_cls is not None:
                self.ensure_sticker_cell_hooked(sticker_cell_cls)
                attach_cell_hook = StickerEmojiCellAttachedHook(self)
                u_sc = self.hook_all_methods(sticker_cell_cls, "onAttachedToWindow", attach_cell_hook)
                if u_sc:
                    self._unhooks.extend(u_sc)

            view_pager_cls = find_class("androidx.viewpager.widget.ViewPager")
            if view_pager_cls is not None:
                pager_hook = EmojiPagerSetCurrentItemHook(self)
                u_vp = self.hook_all_methods(view_pager_cls, "setCurrentItem", pager_hook)
                if u_vp:
                    self._unhooks.extend(u_vp)

            extended_grid_cls = find_class(CLS_EXTENDED_GRID)
            if extended_grid_cls is not None:
                prep_hook = GifPrepareLayoutHook(self)
                u4 = self.hook_all_methods(extended_grid_cls, "prepareLayout", prep_hook)
                if u4:
                    self._unhooks.extend(u4)

            context_link_cls = find_class(CLS_CONTEXT_LINK_CELL)
            if context_link_cls is not None:
                clc_hook = ContextLinkCellAttachedHook(self)
                u_clc = self.hook_all_methods(context_link_cls, "onAttachedToWindow", clc_hook)
                if u_clc:
                    self._unhooks.extend(u_clc)

            glm_cls = find_class("androidx.recyclerview.widget.GridLayoutManager")
            if glm_cls is not None:
                span_hook = EmojiLayoutManagerSetSpanCountHook(self)
                u_span = self.hook_all_methods(glm_cls, "setSpanCount", span_hook)
                if u_span:
                    self._unhooks.extend(u_span)

            self._emoji_view_hooked = True
        except Exception as e:
            self.log(f"[AttachGalleryGrid] ensure_emoji_view_hooked error: {e}")

    def setup_emoji_view(self, emoji_view):
        """Настраивает сетки стикеров и GIF с ультра-компактными аккуратными отступами."""
        if emoji_view is None:
            return
        self._last_emoji_view = emoji_view
        if ViewDetachListener is not None:
            try:
                def on_ev_detach(v):
                    if getattr(self, "_last_emoji_view", None) == v:
                        self._last_emoji_view = None
                emoji_view.addOnAttachStateChangeListener(ViewDetachListener(on_ev_detach))
            except Exception:
                pass

        stickers_grid_view = get_java_field(emoji_view, "stickersGridView")
        if stickers_grid_view is not None:
            try:
                cnt = stickers_grid_view.getChildCount()
                for i in range(cnt):
                    ch = stickers_grid_view.getChildAt(i)
                    if ch is not None:
                        if is_sticker_emoji_cell(ch):
                            self.ensure_sticker_cell_hooked(ch.getClass())
                        elif is_create_sticker_cell(ch):
                            self.setup_create_sticker_cell(ch)
            except Exception:
                pass
            self.attach_stickers_pinch_listener(emoji_view, stickers_grid_view)

            # Минимальные компактные отступы: всего 2dp по бокам, 38dp сверху, 40dp снизу
            pad_h = get_telegram_dp(2)
            pad_top = get_telegram_dp(38)
            pad_bottom = get_telegram_dp(40)
            if (stickers_grid_view.getPaddingLeft() != pad_h or
                    stickers_grid_view.getPaddingTop() != pad_top or
                    stickers_grid_view.getPaddingRight() != pad_h):
                stickers_grid_view.setPadding(pad_h, pad_top, pad_h, pad_bottom)
                stickers_grid_view.setClipToPadding(False)

            target_cols = self.get_target_sticker_columns(emoji_view)
            lm = get_java_field(emoji_view, "stickersLayoutManager")
            curr_cols = to_py_int(lm.getSpanCount(), 0) if lm is not None else 0
            if curr_cols != target_cols and not getattr(self, "_is_updating_stickers", False):
                self._is_updating_stickers = True
                try:
                    self.update_stickers_items(emoji_view, target_cols)
                    stickers_grid_view.requestLayout()
                    adapter = stickers_grid_view.getAdapter()
                    if adapter is not None:
                        adapter.notifyDataSetChanged()
                except Exception:
                    pass
                finally:
                    self._is_updating_stickers = False

        gif_grid_view = get_java_field(emoji_view, "gifGridView")
        if gif_grid_view is not None:
            self.attach_gif_pinch_listener(emoji_view, gif_grid_view)

        emoji_grid_view = get_java_field(emoji_view, "emojiGridView")
        if emoji_grid_view is not None:
            self.attach_emoji_pinch_listener(emoji_view, emoji_grid_view)
            target_cols = self.get_target_emoji_columns(emoji_view)
            lm = get_java_field(emoji_view, "emojiLayoutManager")
            if lm is not None:
                try:
                    if lm.getSpanCount() != target_cols:
                        lm.setSpanCount(target_cols)
                        adapter = get_java_field(emoji_view, "emojiAdapter")
                        if adapter is not None:
                            adapter.notifyDataSetChanged()
                except Exception:
                    pass
            pad_h = get_telegram_dp(2)
            if gif_grid_view.getPaddingLeft() != pad_h or gif_grid_view.getPaddingRight() != pad_h:
                pad_top = gif_grid_view.getPaddingTop()
                pad_bottom = gif_grid_view.getPaddingBottom()
                gif_grid_view.setPadding(pad_h, pad_top, pad_h, pad_bottom)

    def attach_stickers_pinch_listener(self, emoji_view, grid_view):
        try:
            view_id = id(grid_view)
            if view_id in self._attached_stickers_pinch:
                return

            if OnTouchListenerClass is None:
                return

            orig_listener = None
            try:
                li = get_java_field(grid_view, "mListenerInfo")
                if li is not None:
                    orig_listener = get_java_field(li, "mOnTouchListener")
            except Exception:
                pass

            listener = StickersPinchTouchListener(self, emoji_view, grid_view, orig_listener)
            grid_view.setOnTouchListener(listener)
            self._attached_stickers_pinch[view_id] = listener

            if ViewDetachListener is not None:
                try:
                    def on_detach_s(v):
                        self._attached_stickers_pinch.pop(view_id, None)
                        if getattr(self, "_last_emoji_view", None) == emoji_view:
                            self._last_emoji_view = None
                        listener.emoji_view = None
                        listener.grid_view = None
                        listener.orig_listener = None
                    grid_view.addOnAttachStateChangeListener(ViewDetachListener(on_detach_s))
                except Exception:
                    pass
        except Exception as e:
            self.log(f"[AttachGalleryGrid] attach_stickers_pinch_listener error: {e}")

    def attach_gif_pinch_listener(self, emoji_view, grid_view):
        try:
            view_id = id(grid_view)
            if view_id in self._attached_gif_pinch:
                return

            if OnTouchListenerClass is None:
                return

            orig_listener = None
            try:
                li = get_java_field(grid_view, "mListenerInfo")
                if li is not None:
                    orig_listener = get_java_field(li, "mOnTouchListener")
            except Exception:
                pass

            listener = GifPinchTouchListener(self, emoji_view, grid_view, orig_listener)
            grid_view.setOnTouchListener(listener)
            self._attached_gif_pinch[view_id] = listener

            if ViewDetachListener is not None:
                try:
                    def on_detach_g(v):
                        self._attached_gif_pinch.pop(view_id, None)
                        if getattr(self, "_last_emoji_view", None) == emoji_view:
                            self._last_emoji_view = None
                        listener.emoji_view = None
                        listener.grid_view = None
                        listener.orig_listener = None
                    grid_view.addOnAttachStateChangeListener(ViewDetachListener(on_detach_g))
                except Exception:
                    pass
        except Exception as e:
            self.log(f"[AttachGalleryGrid] attach_gif_pinch_listener error: {e}")

    def attach_emoji_pinch_listener(self, emoji_view, grid_view):
        try:
            view_id = id(grid_view)
            if view_id in self._attached_emoji_pinch:
                return

            if OnTouchListenerClass is None:
                return

            orig_listener = None
            try:
                li = get_java_field(grid_view, "mListenerInfo")
                if li is not None:
                    orig_listener = get_java_field(li, "mOnTouchListener")
            except Exception:
                pass

            listener = EmojiPinchTouchListener(self, emoji_view, grid_view, orig_listener)
            grid_view.setOnTouchListener(listener)
            self._attached_emoji_pinch[view_id] = listener

            grid_cls = grid_view.getClass()
            if grid_cls not in self._hooked_emoji_grid_classes:
                try:
                    u = self.hook_all_methods(grid_cls, "onMeasure", EmojiGridMeasureHook(self))
                    if u:
                        self._unhooks.extend(u)
                        self._hooked_emoji_grid_classes.add(grid_cls)
                except Exception:
                    pass

            lm = get_java_field(emoji_view, "emojiLayoutManager")
            if lm is not None:
                lm_cls = lm.getClass()
                if lm_cls not in self._hooked_emoji_grid_classes:
                    try:
                        u_lm = self.hook_all_methods(lm_cls, "setSpanCount", EmojiLayoutManagerSetSpanCountHook(self))
                        if u_lm:
                            self._unhooks.extend(u_lm)
                            self._hooked_emoji_grid_classes.add(lm_cls)
                    except Exception:
                        pass

            if ViewDetachListener is not None:
                try:
                    def on_detach_e(v):
                        self._attached_emoji_pinch.pop(view_id, None)
                        if getattr(self, "_last_emoji_view", None) == emoji_view:
                            self._last_emoji_view = None
                        listener.emoji_view = None
                        listener.grid_view = None
                        listener.orig_listener = None
                    grid_view.addOnAttachStateChangeListener(ViewDetachListener(on_detach_e))
                except Exception:
                    pass
        except Exception as e:
            self.log(f"[AttachGalleryGrid] attach_emoji_pinch_listener error: {e}")

    def get_target_emoji_columns(self, emoji_view=None):
        ev = emoji_view or getattr(self, "_last_emoji_view", None)
        ctx = ev.getContext() if ev is not None else None
        if is_device_landscape(ctx, ev) and self.get_setting("emoji_separate_landscape", True):
            return self._parse_columns("emoji_columns_landscape", 4, self.EMOJI_LANDSCAPE_ITEMS)
        else:
            return self._parse_columns("emoji_columns_portrait", 3, self.EMOJI_PORTRAIT_ITEMS)

    def change_emoji_columns(self, emoji_view, view=None, delta=0, center_x=None, center_y=None):
        if view is None and emoji_view is not None:
            view = get_java_field(emoji_view, "emojiGridView")
        if emoji_view is None or view is None:
            return

        ctx = emoji_view.getContext() if emoji_view is not None else None
        is_landscape = (is_device_landscape(ctx, emoji_view) and self.get_setting("emoji_separate_landscape", True))
        key = "emoji_columns_landscape" if is_landscape else "emoji_columns_portrait"
        items_list = self.EMOJI_LANDSCAPE_ITEMS if is_landscape else self.EMOJI_PORTRAIT_ITEMS

        current_cols = self.get_target_emoji_columns(emoji_view)
        new_cols = current_cols + delta

        valid_cols = []
        for it in items_list:
            try:
                valid_cols.append(int(it))
            except Exception:
                pass
        if not valid_cols:
            valid_cols = list(range(5, 15))

        min_c = min(valid_cols)
        max_c = max(valid_cols)
        new_cols = max(min_c, min(max_c, new_cols))

        if new_cols == current_cols:
            return

        best_idx = 0
        best_diff = 999
        for idx, it in enumerate(items_list):
            try:
                val = int(it)
                if abs(val - new_cols) < best_diff:
                    best_diff = abs(val - new_cols)
                    best_idx = idx
            except Exception:
                pass

        self.set_setting(key, best_idx)
        if self.get_setting("enable_grid_animation", True):
            self.animate_grid_transition(view, delta, center_x, center_y)

        lm = get_java_field(emoji_view, "emojiLayoutManager")
        if lm is not None:
            try:
                lm.setSpanCount(new_cols)
            except Exception:
                pass

        adapter = get_java_field(emoji_view, "emojiAdapter")
        if adapter is not None:
            try:
                adapter.notifyDataSetChanged()
            except Exception:
                pass

        try:
            view.requestLayout()
        except Exception:
            pass


    def get_target_sticker_columns(self, emoji_view=None):
        ev = emoji_view or getattr(self, "_last_emoji_view", None)
        ctx = ev.getContext() if ev is not None else None
        if is_device_landscape(ctx, ev) and self.get_setting("stickers_separate_landscape", True):
            return self._parse_columns("stickers_columns_landscape", 4, self.STICKERS_LANDSCAPE_ITEMS)
        else:
            return self._parse_columns("stickers_columns_portrait", 2, self.STICKERS_PORTRAIT_ITEMS)

    def update_stickers_items(self, emoji_view, custom_cols):
        try:
            lm = get_java_field(emoji_view, "stickersLayoutManager")
            if lm is not None:
                try:
                    lm.setSpanCount(custom_cols)
                except Exception:
                    pass
            grid_view = get_java_field(emoji_view, "stickersGridView")
            adapter = grid_view.getAdapter() if grid_view is not None else get_java_field(emoji_view, "stickersGridAdapter")
            if adapter is not None:
                try:
                    set_java_field(adapter, "stickersPerRow", Integer(custom_cols))
                except Exception:
                    pass
                try:
                    call_update_items(adapter)
                except Exception:
                    pass
        except Exception as e:
            self.log(f"[AttachGalleryGrid] update_stickers_items error: {e}")

    def change_sticker_columns(self, emoji_view, view=None, delta=0, center_x=None, center_y=None):
        if view is None and emoji_view is not None:
            view = get_java_field(emoji_view, "stickersGridView")
        try:
            ctx = emoji_view.getContext() if emoji_view is not None else None
            is_landscape = (is_device_landscape(ctx, emoji_view) and self.get_setting("stickers_separate_landscape", True))
            setting_key = "stickers_columns_landscape" if is_landscape else "stickers_columns_portrait"
            items_list = self.STICKERS_LANDSCAPE_ITEMS if is_landscape else self.STICKERS_PORTRAIT_ITEMS
            default_idx = 4 if is_landscape else 2

            curr_cols = self._parse_columns(setting_key, default_idx, items_list)
            min_cols = int(items_list[0])
            max_cols = int(items_list[-1])

            new_cols = max(min_cols, min(curr_cols + delta, max_cols))
            if new_cols == curr_cols:
                return False

            str_cols = str(new_cols)
            if str_cols in items_list:
                new_idx = items_list.index(str_cols)
                self.set_setting(setting_key, new_idx)

            if view is not None:
                try:
                    view.performHapticFeedback(3)
                except Exception:
                    pass

            self.update_stickers_items(emoji_view, new_cols)

            try:
                view.requestLayout()
                view.invalidate()
                adapter = view.getAdapter()
                if adapter is not None:
                    adapter.notifyDataSetChanged()
            except Exception:
                pass

            if self.get_setting("enable_grid_animation", True):
                self.animate_grid_transition(view, delta, center_x, center_y)

            return True
        except Exception as e:
            self.log(f"[AttachGalleryGrid] change_sticker_columns error: {e}")
            return False

    def get_current_gif_factor(self):
        idx = self.get_setting("gif_density", 2)
        if isinstance(idx, int) and 0 <= idx < len(self.GIF_FACTORS):
            return self.GIF_FACTORS[idx]
        return 1.0

    def refresh_gif_grid(self, emoji_view):
        if emoji_view is None:
            return
        try:
            lm = get_java_field(emoji_view, "gifLayoutManager")
            gif_grid_view = get_java_field(emoji_view, "gifGridView")
            if lm is not None:
                set_java_field(lm, "calculatedWidth", Integer(0))
                item_spans = get_java_field(lm, "itemSpans")
                if item_spans is not None:
                    try:
                        item_spans.clear()
                    except Exception:
                        pass
                items_to_row = get_java_field(lm, "itemsToRow")
                if items_to_row is not None:
                    try:
                        items_to_row.clear()
                    except Exception:
                        pass
                try:
                    lm.requestLayout()
                except Exception:
                    pass

            if gif_grid_view is not None:
                try:
                    target_h = int(get_telegram_dp(100) * self.get_current_gif_factor())
                    child_count = gif_grid_view.getChildCount()
                    for i in range(child_count):
                        child = gif_grid_view.getChildAt(i)
                        if child is not None:
                            lp = child.getLayoutParams()
                            if lp is not None and lp.height != target_h:
                                lp.height = target_h
                                child.setLayoutParams(lp)
                    gif_grid_view.requestLayout()
                    gif_grid_view.invalidate()
                    adapter = gif_grid_view.getAdapter()
                    if adapter is not None:
                        adapter.notifyDataSetChanged()
                except Exception:
                    pass
        except Exception as e:
            self.log(f"[AttachGalleryGrid] refresh_gif_grid error: {e}")

    def change_gif_density(self, emoji_view, view, delta, center_x=None, center_y=None):
        try:
            curr_idx = self.get_setting("gif_density", 2)
            if not isinstance(curr_idx, int) or curr_idx < 0 or curr_idx >= len(self.GIF_DENSITY_ITEMS):
                curr_idx = 2

            new_idx = max(0, min(curr_idx + delta, len(self.GIF_DENSITY_ITEMS) - 1))
            if new_idx == curr_idx:
                return False

            self.set_setting("gif_density", new_idx)

            if view is not None:
                try:
                    view.performHapticFeedback(3)
                except Exception:
                    pass

            self.refresh_gif_grid(emoji_view)

            if self.get_setting("enable_grid_animation", True):
                self.animate_grid_transition(view, delta, center_x, center_y)

            return True
        except Exception as e:
            self.log(f"[AttachGalleryGrid] change_gif_density error: {e}")
            return False

    def get_target_columns_fallback(self):
        try:
            pl = getattr(self, "_last_photo_layout", None)
            if pl is not None:
                w = pl.getMeasuredWidth()
                h = pl.getMeasuredHeight()
                return self.get_target_columns(pl, w, h)
        except Exception:
            pass
        return self._parse_columns("grid_columns_portrait", 2, self.PORTRAIT_ITEMS)

    def get_target_checkbox_scale(self, cols, item_size=0):
        mode = self.get_setting("checkbox_scale_mode", 0)
        if mode is None:
            mode = 0
        if isinstance(mode, str) and mode.isdigit():
            mode = int(mode)
        elif not isinstance(mode, int):
            mode = 0

        if mode == 1:
            return 1.0, 5.0, 42
        elif mode == 2:
            return 0.70, 2.5, 26
        elif mode == 3:
            return 0.50, 1.5, 19

        if cols >= 8:
            scale_by_cols = 0.50
            margin_by_cols = 1.5
            frame_by_cols = 19
        elif cols == 7:
            scale_by_cols = 0.58
            margin_by_cols = 2.0
            frame_by_cols = 22
        elif cols == 6:
            scale_by_cols = 0.68
            margin_by_cols = 2.5
            frame_by_cols = 26
        elif cols == 5:
            scale_by_cols = 0.82
            margin_by_cols = 3.0
            frame_by_cols = 32
        else:
            scale_by_cols = 1.0
            margin_by_cols = 5.0
            frame_by_cols = 42

        if item_size > 0:
            dp2 = get_telegram_dp(2)
            dp_factor = (float(dp2) / 2.0) if dp2 > 0 else 1.0
            size_dp = float(item_size) / dp_factor

            if size_dp < 48:
                scale_by_size = 0.50
                margin_by_size = 1.5
                frame_by_size = 19
            elif size_dp < 58:
                scale_by_size = 0.58
                margin_by_size = 2.0
                frame_by_size = 22
            elif size_dp < 70:
                scale_by_size = 0.68
                margin_by_size = 2.5
                frame_by_size = 26
            elif size_dp < 88:
                scale_by_size = 0.82
                margin_by_size = 3.0
                frame_by_size = 32
            else:
                scale_by_size = 1.0
                margin_by_size = 5.0
                frame_by_size = 42

            return min(scale_by_cols, scale_by_size), min(margin_by_cols, margin_by_size), min(frame_by_cols, frame_by_size)

        return scale_by_cols, margin_by_cols, frame_by_cols

    def apply_checkbox_scale_in_layout(self, photo_layout):
        try:
            cols = getattr(self, "_current_columns", -1)
            if cols <= 0:
                cols = self.get_target_columns_fallback()

            scale, _, _ = self.get_target_checkbox_scale(cols)
            if abs(scale - 1.0) < 0.01:
                return

            grid_view = get_java_field(photo_layout, "gridView") or get_java_field(photo_layout, "listView")
            if grid_view is None:
                return

            count = grid_view.getChildCount()
            for i in range(count):
                child = grid_view.getChildAt(i)
                if child is not None:
                    cb = None
                    try:
                        cb = child.getCheckBox()
                    except Exception:
                        pass
                    if cb is None:
                        cb = get_java_field(child, "checkBox")

                    if cb is not None:
                        cb_w = cb.getWidth()
                        if cb_w <= 0:
                            cb_w = get_telegram_dp(26)
                        cb.setPivotX(float(cb_w))
                        cb.setPivotY(0.0)
                        cb.setScaleX(float(scale))
                        cb.setScaleY(float(scale))

                        try:
                            cb_base = cb.getCheckBoxBase()
                            if cb_base is not None:
                                cb_base.setSize(float(24.0 * scale))
                                cb_base.checkScale = float(scale)
                        except Exception:
                            pass
        except Exception:
            pass

    def schedule_grid_updates(self, grid_view):
        if grid_view is None:
            return
        try:
            self.update_visible_cells_checkbox(grid_view)
        except Exception:
            pass

        # Removed delayed runnable spam to prevent Looper queue overload
        pass

    def adjust_photo_cell_checkbox(self, cell, item_size=0, columns=None):
        try:
            if cell is None:
                return

            cols = columns or getattr(self, "_current_columns", -1)
            if cols <= 0:
                cols = getattr(self, "_last_applied_columns", -1)
            if cols <= 0:
                cols = self.get_target_columns_fallback()

            scale, margin_dp, frame_dp = self.get_target_checkbox_scale(cols, item_size)

            check_box = None
            try:
                check_box = cell.getCheckBox()
            except Exception:
                pass
            if check_box is None:
                check_box = get_java_field(cell, "checkBox")

            if check_box is not None:
                curr_s = 1.0
                try:
                    curr_s = float(check_box.getScaleX())
                except Exception:
                    pass
                if abs(curr_s - scale) < 0.01:
                    return

                cb_w = 0
                try:
                    cb_w = check_box.getWidth()
                except Exception:
                    pass
                if cb_w <= 0:
                    cb_w = get_telegram_dp(26)

                try:
                    check_box.setPivotX(float(cb_w))
                    check_box.setPivotY(0.0)
                    check_box.setScaleX(float(scale))
                    check_box.setScaleY(float(scale))
                except Exception:
                    pass

                try:
                    cb_base = check_box.getCheckBoxBase()
                    if cb_base is not None:
                        cb_base.setSize(float(24.0 * scale))
                        cb_base.checkScale = float(scale)
                except Exception:
                    pass

                try:
                    cb_lp = check_box.getLayoutParams()
                    if cb_lp is not None:
                        margin_px = get_telegram_dp(int(round(margin_dp)))
                        cb_lp.rightMargin = margin_px
                        cb_lp.topMargin = margin_px
                except Exception:
                    pass

            check_frame = None
            try:
                check_frame = cell.getCheckFrame()
            except Exception:
                pass
            if check_frame is None:
                check_frame = get_java_field(cell, "checkFrame")

            if check_frame is not None:
                try:
                    cf_lp = check_frame.getLayoutParams()
                    if cf_lp is not None:
                        frame_px = get_telegram_dp(int(round(frame_dp)))
                        cf_lp.width = frame_px
                        cf_lp.height = frame_px
                except Exception:
                    pass

        except Exception:
            pass

    def update_visible_cells_checkbox(self, grid_view, item_size=0, columns=None):
        if grid_view is None:
            return
        cols = columns or getattr(self, "_current_columns", -1)
        if cols <= 3 and item_size <= 0:
            return
        try:
            count = grid_view.getChildCount()
            for i in range(count):
                child = grid_view.getChildAt(i)
                if child is not None:
                    self.adjust_photo_cell_checkbox(child, item_size, columns)
        except Exception:
            pass

    def animate_grid_transition(self, grid_view, delta, pivot_x=None, pivot_y=None):
        try:
            if grid_view is None:
                return

            try:
                grid_view.animate().cancel()
            except Exception:
                pass

            w = float(grid_view.getWidth())
            h = float(grid_view.getHeight())

            if pivot_x is not None and pivot_x > 0:
                grid_view.setPivotX(float(pivot_x))
            elif w > 0:
                grid_view.setPivotX(w / 2.0)

            if pivot_y is not None and pivot_y > 0:
                grid_view.setPivotY(float(pivot_y))
            elif h > 0:
                grid_view.setPivotY(h / 2.0)

            start_scale = 0.90 if delta < 0 else 1.10

            grid_view.setScaleX(float(start_scale))
            grid_view.setScaleY(float(start_scale))
            grid_view.setAlpha(0.75)

            interpolator = None
            try:
                cbi_cls = find_class("org.telegram.ui.Components.CubicBezierInterpolator")
                if cbi_cls is not None:
                    interpolator = get_java_field(cbi_cls, "EASE_OUT_QUINT")
            except Exception:
                pass

            if interpolator is None:
                try:
                    dec_cls = find_class("android.view.animation.DecelerateInterpolator")
                    if dec_cls is not None:
                        interpolator = dec_cls()
                except Exception:
                    pass

            anim = grid_view.animate().scaleX(1.0).scaleY(1.0).alpha(1.0).setDuration(220)
            if interpolator is not None:
                anim.setInterpolator(interpolator)
            anim.start()
        except Exception as e:
            self.log(f"[AttachGalleryGrid] animate_grid_transition error: {e}")

    def change_columns(self, photo_layout, view, delta, center_x=None, center_y=None):
        try:
            ctx = photo_layout.getContext() if photo_layout is not None else None
            width = photo_layout.getMeasuredWidth()
            height = photo_layout.getMeasuredHeight()
            is_landscape = (is_device_landscape(ctx, photo_layout) and self.get_setting("separate_landscape", True))
            setting_key = "grid_columns_landscape" if is_landscape else "grid_columns_portrait"
            items_list = self.LANDSCAPE_ITEMS if is_landscape else self.PORTRAIT_ITEMS
            default_idx = 3 if is_landscape else 2

            curr_cols = self._parse_columns(setting_key, default_idx, items_list)
            min_cols = int(items_list[0])
            max_cols = int(items_list[-1])

            new_cols = max(min_cols, min(curr_cols + delta, max_cols))
            if new_cols == curr_cols:
                return False

            str_cols = str(new_cols)
            if str_cols in items_list:
                new_idx = items_list.index(str_cols)
                self.set_setting(setting_key, new_idx)

            if view is not None:
                try:
                    view.performHapticFeedback(3)
                except Exception:
                    pass

            self._last_applied_columns = -1
            self._last_applied_size = -1
            self._current_columns = new_cols
            self.handle_pre_measure(photo_layout, width, height)

            grid_view = get_java_field(photo_layout, "gridView") or get_java_field(photo_layout, "listView")

            try:
                photo_layout.requestLayout()
                if grid_view is not None:
                    grid_view.requestLayout()
                    grid_view.invalidate()
            except Exception:
                pass

            if grid_view is not None and self.get_setting("enable_grid_animation", True):
                self.animate_grid_transition(grid_view, delta, center_x, center_y)

            return True
        except Exception as e:
            self.log(f"[AttachGalleryGrid] change_columns error: {e}")
            return False

    def attach_pinch_listener(self, photo_layout, grid_view):
        try:
            layout_id = id(photo_layout)
            if layout_id in self._attached_pinch_layouts:
                return

            if OnTouchListenerClass is None:
                return

            listener = GridPinchTouchListener(self, photo_layout)
            grid_view.setOnTouchListener(listener)
            self._attached_pinch_layouts[layout_id] = listener

            if ViewDetachListener is not None:
                try:
                    def on_detach_p(v):
                        self._attached_pinch_layouts.pop(layout_id, None)
                        if getattr(self, "_last_photo_layout", None) == photo_layout:
                            self._last_photo_layout = None
                        listener.photo_layout = None
                    grid_view.addOnAttachStateChangeListener(ViewDetachListener(on_detach_p))
                except Exception:
                    pass
        except Exception as e:
            self.log(f"[AttachGalleryGrid] attach_pinch_listener error: {e}")

    def handle_pre_measure(self, photo_layout, available_width, available_height):
        try:
            ctx = photo_layout.getContext()
            if ctx is None:
                return False

            grid_view = get_java_field(photo_layout, "gridView") or get_java_field(photo_layout, "listView")
            if grid_view is None:
                return False

            layout_manager = get_java_field(photo_layout, "layoutManager")
            if layout_manager is None:
                return False

            self.ensure_photo_cell_hooked()
            self.attach_pinch_listener(photo_layout, grid_view)

            set_java_field(photo_layout, "ignoreLayout", Boolean(True))

            target_columns = max(2, min(self.get_target_columns(photo_layout, available_width, available_height), 12))

            if available_width <= 0:
                available_width = photo_layout.getMeasuredWidth()
            if available_width <= 0:
                available_width = photo_layout.getWidth()
            if available_width <= 0:
                try:
                    available_width = ctx.getResources().getDisplayMetrics().widthPixels
                except Exception:
                    available_width = 1080

            if available_height <= 0:
                available_height = photo_layout.getMeasuredHeight()
            if available_height <= 0:
                available_height = photo_layout.getHeight()
            if available_height <= 0:
                try:
                    available_height = ctx.getResources().getDisplayMetrics().heightPixels
                except Exception:
                    available_height = 1920

            nav_bar_h = get_nav_bar_height()
            list_add_h = nav_bar_h + get_telegram_dp(48)
            set_java_field(photo_layout, "listAdditionalH", Integer(list_add_h))

            lp = grid_view.getLayoutParams()
            if lp is not None and lp.topMargin != -list_add_h:
                lp.topMargin = -list_add_h
                grid_view.setLayoutParams(lp)

            gap_px = get_telegram_dp(2)
            padding_px = get_telegram_dp(2)
            total_gap_px = gap_px * (target_columns - 1)
            total_padding_px = padding_px * 2

            inner_width = available_width - total_padding_px
            new_item_size = max(get_telegram_dp(32), (inner_width - total_gap_px) // target_columns)
            new_span_count = new_item_size * target_columns + total_gap_px

            old_items_per_row = to_py_int(get_java_field(photo_layout, "itemsPerRow"), 0)
            curr_size = to_py_int(get_java_field(photo_layout, "itemSize"), 0)
            curr_last_size = to_py_int(get_java_field(photo_layout, "lastItemSize"), 0)

            size_changed = (old_items_per_row != target_columns or curr_size != new_item_size)
            self._current_columns = target_columns
            self._current_item_size = new_item_size
            try:
                grid_view.setItemAnimator(None)
                grid_view.setLayoutAnimation(None)
                grid_view.setLayoutTransition(None)
            except Exception:
                pass
            if size_changed:
                self.schedule_grid_updates(grid_view)

            set_java_field(photo_layout, "itemsPerRow", Integer(target_columns))
            try:
                set_private_field(photo_layout, "itemsPerRow", target_columns)
            except Exception:
                pass

            set_java_field(photo_layout, "itemSize", Integer(new_item_size))
            try:
                set_private_field(photo_layout, "itemSize", new_item_size)
            except Exception:
                pass

            layout_manager.setSpanCount(new_span_count)

            adapter = get_java_field(photo_layout, "adapter")
            if adapter is not None:
                try:
                    set_java_field(adapter, "itemSize", Integer(new_item_size))
                    set_java_field(adapter, "itemsPerRow", Integer(target_columns))
                except Exception:
                    pass

            if size_changed or curr_last_size != new_item_size:
                set_java_field(photo_layout, "lastItemSize", Integer(new_item_size))
                try:
                    set_private_field(photo_layout, "lastItemSize", new_item_size)
                except Exception:
                    pass
                if adapter is not None:
                    try:
                        if hasattr(grid_view, "isComputingLayout") and grid_view.isComputingLayout():
                            grid_view.post(lambda: adapter.notifyDataSetChanged())
                        else:
                            adapter.notifyDataSetChanged()
                    except Exception:
                        pass

            if adapter is not None:
                try:
                    item_count = adapter.getItemCount()
                    rows = int(math.ceil((item_count - 1) / float(target_columns)))
                    content_size = rows * new_item_size + (rows - 1) * gap_px
                    insets_top = get_action_bar_height()
                    insets_bottom = nav_bar_h
                    new_space = max(0, available_height - content_size - insets_top - insets_bottom - get_telegram_dp(6))
                    curr_space = to_py_int(get_java_field(photo_layout, "gridExtraSpace"), 0)
                    if curr_space != new_space:
                        set_java_field(photo_layout, "gridExtraSpace", Integer(new_space))
                except Exception:
                    pass

            is_tablet = False
            try:
                au_cls = find_class("org.telegram.messenger.AndroidUtilities")
                if au_cls is not None:
                    is_tablet = bool(au_cls.isTablet())
            except Exception:
                pass

            insets_top = get_action_bar_height()
            if not is_tablet and available_width > available_height:
                padding_top = int(available_height / 3.5)
            else:
                padding_top = int(available_height / 5.0 * 2.0)

            padding_top += insets_top
            padding_top -= get_telegram_dp(52)
            padding_top += list_add_h
            if padding_top < 0:
                padding_top = 0

            list_padding_bottom = to_py_int(get_java_field(photo_layout, "listPaddingBottom"), nav_bar_h)
            target_bottom = list_padding_bottom + get_telegram_dp(48)

            if grid_view.getPaddingTop() != padding_top or grid_view.getPaddingBottom() != target_bottom or grid_view.getPaddingLeft() != padding_px or grid_view.getPaddingRight() != padding_px:
                grid_view.setPadding(padding_px, padding_top, padding_px, target_bottom)

            camera_view = get_java_field(photo_layout, "cameraView")
            if camera_view is not None:
                try:
                    set_java_field(camera_view, "itemSize", Integer(new_item_size))
                    lp_cam = camera_view.getLayoutParams()
                    if lp_cam is not None and (lp_cam.width != new_item_size or lp_cam.height != new_item_size):
                        lp_cam.width = new_item_size
                        lp_cam.height = new_item_size
                        camera_view.setLayoutParams(lp_cam)
                except Exception:
                    pass

            anim_vals = get_java_field(photo_layout, "animateCameraValues")
            if anim_vals is not None and len(anim_vals) >= 3:
                try:
                    anim_vals[1] = float(new_item_size)
                    anim_vals[2] = float(new_item_size * 2 + gap_px)
                except Exception:
                    pass

            drop_down = get_java_field(photo_layout, "dropDown")
            if drop_down is not None and hasattr(drop_down, "setTextSize"):
                try:
                    drop_down.setTextSize(17)
                except Exception:
                    pass

            set_java_field(photo_layout, "ignoreLayout", Boolean(False))
            return True

        except Exception as e:
            self.log(f"[AttachGalleryGrid] Error in handle_pre_measure: {e}")
            try:
                set_java_field(photo_layout, "ignoreLayout", Boolean(False))
            except Exception:
                pass
            return False
