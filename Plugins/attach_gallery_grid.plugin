                text="Отдельно для горизонтального режима",
                subtext="Использовать другое число колонок при повороте экрана на бок",
                default=True,
                icon="msg_rotate",
                on_change=self._on_setting_changed,
            ),
            Selector(
                key="grid_columns_landscape",
