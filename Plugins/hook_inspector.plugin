# ─────────────────────────────────────────────────────────────────────────────
#  ЦВЕТ / UI-ХЕЛПЕРЫ  (палитра MD3 из текущей темы Telegram)
# ─────────────────────────────────────────────────────────────────────────────

def _u(c):
    return c & 0xFFFFFFFF


def _s32(c):
    c &= 0xFFFFFFFF
    return c - 0x100000000 if c >= 0x80000000 else c


def _alpha(c, a):
    return ((a & 0xFF) << 24) | (_u(c) & 0xFFFFFF)


def _blend(fg, bg, t):
    fg, bg = _u(fg), _u(bg)

    def ch(sh):
        return int(((fg >> sh) & 0xFF) * t + ((bg >> sh) & 0xFF) * (1 - t))
    return 0xFF000000 | (ch(16) << 16) | (ch(8) << 8) | ch(0)


def _lum(c):
    c = _u(c)
    return (0.299 * ((c >> 16) & 0xFF) + 0.587 * ((c >> 8) & 0xFF) + 0.114 * (c & 0xFF)) / 255.0


def _dp(v):
    return int(AndroidUtilities.dp(float(v)))


def _theme_color(names, fallback):
    try:
        from org.telegram.ui.ActionBar import Theme
        for n in names:
            key = getattr(Theme, n, None)
            if key is None:
                continue
            try:
                return _u(Theme.getColor(key))
            except Exception:
                continue
    except Exception:
        pass
    return fallback


class _Palette:
    def __init__(self, win_alpha=255):
        self.surface = _theme_color(["key_windowBackgroundWhite"], 0xFF1C1B1F)
        self.on_surface = _theme_color(["key_windowBackgroundWhiteBlackText"], 0xFFE6E1E5)
        self.primary = _theme_color(
            ["key_featuredStickers_addButton", "key_windowBackgroundWhiteBlueText4",
             "key_windowBackgroundWhiteBlueText"], 0xFF8AB4F8)
        self.on_surface_var = _theme_color(
            ["key_windowBackgroundWhiteGrayText", "key_windowBackgroundWhiteGrayText2"],
            _blend(self.on_surface, self.surface, 0.65))
        self.dark = _lum(self.surface) < 0.5
        self.on_primary = 0xFF000000 if _lum(self.primary) > 0.55 else 0xFFFFFFFF
        self.outline = _blend(self.on_surface, self.surface, 0.18)
        self.container = _blend(self.primary, self.surface, 0.06)
        self.container_high = _blend(self.primary, self.surface, 0.12)
        self.win_alpha = win_alpha
        if self.dark:
            self.c_attr, self.c_hook = 0xFF81C784, 0xFFFFD54F
            self.c_theme, self.c_res, self.c_err = 0xFFCE93D8, 0xFF80CBC4, 0xFFFF8A80
            self.hier = [0xFF90CAF9, 0xFFB0BEC5, 0xFFA5D6A7, 0xFFFFE082, 0xFFEF9A9A, 0xFFCE93D8]
        else:
            self.c_attr, self.c_hook = 0xFF2E7D32, 0xFFB26A00
            self.c_theme, self.c_res, self.c_err = 0xFF7B1FA2, 0xFF00796B, 0xFFC62828
            self.hier = [0xFF1565C0, 0xFF546E7A, 0xFF2E7D32, 0xFFB26A00, 0xFFC62828, 0xFF7B1FA2]


def _rounded(color, radius_dp, stroke_color=None, stroke_dp=1.0, shape=None):
    from android.graphics.drawable import GradientDrawable
    d = GradientDrawable()
    if shape is not None:
        d.setShape(shape)
    d.setColor(_s32(color))
    d.setCornerRadius(float(_dp(radius_dp)))
    if stroke_color is not None:
        d.setStroke(max(1, _dp(stroke_dp)), _s32(stroke_color))
    return d


def _with_ripple(content, color, radius_dp=None):
    try:
        from android.graphics.drawable import RippleDrawable
        from android.content.res import ColorStateList
        mask = _rounded(0xFFFFFFFF, radius_dp or 0, shape=(1 if radius_dp is None else None))
        csl = ColorStateList.valueOf(_s32(_alpha(color, 0x33)))
        return RippleDrawable(csl, content, mask)
    except Exception:
        return content


def _lin_lp(w, h, weight=None, m=None):
    from android.widget import LinearLayout
    p = LinearLayout.LayoutParams(w, h, float(weight)) if weight is not None \
        else LinearLayout.LayoutParams(w, h)
    if m:
        p.setMargins(int(m[0]), int(m[1]), int(m[2]), int(m[3]))
    return p


def _fr_lp(w, h, gravity=None, m=None):
    from android.widget import FrameLayout
    p = FrameLayout.LayoutParams(w, h, gravity) if gravity is not None \
        else FrameLayout.LayoutParams(w, h)
    if m:
        p.setMargins(int(m[0]), int(m[1]), int(m[2]), int(m[3]))
    return p


def _make_runnable(fn):
    Runnable = find_class("java.lang.Runnable")

    class _R(dynamic_proxy(Runnable)):
        def run(self_r):
            try:
                fn()
            except Exception as ex:
                log(f"{TAG} runnable: {ex}")
    return _R()


def _bold_typeface():
    try:
        return AndroidUtilities.bold()
    except Exception:
        pass
    try:
        return AndroidUtilities.getTypeface("fonts/rmedium.ttf")
    except Exception:
        return None


_SYS = None


def _identity(obj) -> int:
    """Стабильный идентификатор Java-объекта (id() у Python-обёрток нестабилен)."""
    global _SYS
    try:
        if _SYS is None:
            _SYS = find_class("java.lang.System")
        return int(_SYS.identityHashCode(obj))
    except Exception:
        return id(obj)


# ─────────────────────────────────────────────────────────────────────────────
#  HELPERS
# ─────────────────────────────────────────────────────────────────────────────

def _simple(full: str) -> str:
    return full.split(".")[-1].split("$")[0]


def _find_hooks(simple_name: str) -> List[str]:
    low = simple_name.lower()
    result, seen = [], set()
    for key, hooks in HOOK_DB.items():
        if key in low:
            for h in hooks:
                if h not in seen:
                    seen.add(h)
                    result.append(h)
    return result


def _find_theme_info(classes: List[str]) -> List[Tuple[str, str, List[str]]]:
    """Return [(pattern, section_name, [keys])] for view hierarchy."""
    seen_keys: set = set()
    result = []
    for cls in classes:
        low = _simple(cls).lower()
        for pattern, sections in THEME_KEY_DB.items():
            if pattern in low:
                for section_name, keys in sections:
                    fresh = [k for k in keys if k not in seen_keys]
                    if not fresh:
                        continue
                    seen_keys.update(fresh)
                    result.append((pattern, section_name, fresh))
    return result


def _get_tg_color(key: str):
    """Живой цвет по имени ключа. В новых Telegram ключи — int-поля Theme.key_*."""
    try:
        Theme = find_class("org.telegram.ui.ActionBar.Theme")
        if not Theme:
            return None
        k = getattr(Theme, "key_" + key, None)
        if k is not None:
            return Theme.getColor(k)
        return Theme.getColor(key)
    except Exception:
        return None


def _theme_call(key: str) -> str:
    return f"Theme.getColor(Theme.key_{key})"


def _int_to_hex(color: int) -> str:
    return f"#{color & 0xFFFFFFFF:08X}"


def _hierarchy(view, max_depth: int) -> List[str]:
    chain, cur = [], view
    for _ in range(max_depth):
        if cur is None:
            break
        try:
            chain.append(cur.getClass().getName())
            cur = cur.getParent()
        except Exception:
            break
    return chain


def _view_attrs(view) -> dict:
    d = {}
    try: d["w"] = view.getMeasuredWidth()
    except Exception: pass
    try: d["h"] = view.getMeasuredHeight()
    except Exception: pass
    try: d["pl"] = view.getPaddingLeft()
    except Exception: pass
    try: d["pr"] = view.getPaddingRight()
    except Exception: pass
    try: d["pt"] = view.getPaddingTop()
    except Exception: pass
    try: d["pb"] = view.getPaddingBottom()
    except Exception: pass
    try:
        vis = view.getVisibility()
        d["vis"] = {0: "VISIBLE", 4: "INVISIBLE", 8: "GONE"}.get(vis, str(vis))
    except Exception: pass
    try: d["enabled"] = str(view.isEnabled())
    except Exception: pass
    try: d["clickable"] = str(view.isClickable())
    except Exception: pass
    try: d["focused"] = str(view.isFocused())
    except Exception: pass
    try:
        bg = view.getBackground()
        if bg and "ColorDrawable" in bg.getClass().getName():
            d["bg_color"] = _int_to_hex(bg.getColor())
    except Exception: pass
    try:
        d["text_color"] = _int_to_hex(view.getCurrentTextColor())
    except Exception: pass
    try:
        vid = view.getId()
        if vid > 0:
            d["res_id"] = view.getResources().getResourceEntryName(vid)
    except Exception: pass
    return d


def _clipboard(ctx, text: str) -> bool:
    try:
        ClipData = find_class("android.content.ClipData")
        cm = ctx.getSystemService("clipboard")
        if not cm:
            return False
        cm.setPrimaryClip(ClipData.newPlainText("HookInspector", text))
        return True
    except Exception as e:
        log(f"{TAG} clipboard: {e}")
        return False


def _save_text(name: str, text: str) -> str:
    """Сохранить текст в Загрузки (MediaStore на Android 10+). Возвращает путь или ''."""
    try:
        ctx = find_class("org.telegram.messenger.ApplicationLoader").applicationContext
        Build = find_class("android.os.Build")
        if Build.VERSION.SDK_INT >= 29:
            CV = find_class("android.content.ContentValues")
            MSD = find_class("android.provider.MediaStore$Downloads")
            OSW = find_class("java.io.OutputStreamWriter")
            cv = CV()
            cv.put("_display_name", name)
            cv.put("mime_type", "text/plain")
            cv.put("relative_path", "Download/HookInspector")
            resolver = ctx.getContentResolver()
            uri = resolver.insert(MSD.EXTERNAL_CONTENT_URI, cv)
            w = OSW(resolver.openOutputStream(uri), "UTF-8")
            w.write(text)
            w.close()
            return f"Загрузки/HookInspector/{name}"
        path = f"{EXPORT_DIR}/{name}"
        os.makedirs(EXPORT_DIR, exist_ok=True)
        with open(path, "w", encoding="utf-8") as f:
            f.write(text)
        return path
    except Exception as e:
        log(f"{TAG} save_text: {e}")
        return ""


_KNOWN_TYPES = {
    "String": "java.lang.String", "CharSequence": "java.lang.CharSequence",
    "Object": "java.lang.Object", "Runnable": "java.lang.Runnable",
    "ArrayList": "java.util.ArrayList", "Canvas": "android.graphics.Canvas",
    "MotionEvent": "android.view.MotionEvent", "View": "android.view.View",
    "Menu": "android.view.Menu", "Bundle": "android.os.Bundle",
    "Drawable": "android.graphics.drawable.Drawable",
}
_PRIMITIVES = {"int": "Integer", "boolean": "Boolean", "float": "Float", "long": "Long",
               "double": "Double", "byte": "Byte", "short": "Short", "char": "Character"}


def _hook_snippet(hook: str, chain: List[str]) -> str:
    """Готовый шаблон кода плагина для строки вида «Hook Class.method(Type, ...) -> описание»."""
    m = re.match(r"Hook\s+([A-Za-z0-9_]+)\.([A-Za-z0-9_]+)\(([^)]*)\)", hook)
    if not m:
        return hook
    cls_simple, method, params = m.group(1), m.group(2), m.group(3)
    fqn = next((c for c in chain if _simple(c) == cls_simple), None)
    todo = []
    if fqn:
        cls_expr = f'find_class("{fqn}")'
    else:
        cls_expr = f'find_class("{cls_simple}")'
        todo.append(cls_simple)
    args = []
    for raw in [p.strip() for p in params.split(",") if p.strip()]:
        if raw == "..." or raw.endswith("..."):
            todo.append("остальные параметры")
            continue
        t = raw.replace("[]", "").split(".")[-1]
        if t in _PRIMITIVES:
            args.append(f'find_class("java.lang.{_PRIMITIVES[t]}").TYPE')
        elif t in _KNOWN_TYPES:
            args.append(f'find_class("{_KNOWN_TYPES[t]}").getClass()')
        else:
            args.append(f'find_class("{t}").getClass()')
            todo.append(t)
    lines = [f"# {hook.split('->')[0].strip()}"]
    if todo:
        lines.append("# TODO: уточните полные имена / параметры: " + ", ".join(dict.fromkeys(todo)))
    lines.append(f"cls = {cls_expr}.getClass()")
    if args:
        lines.append(f'method = cls.getDeclaredMethod("{method}",')
        lines.append(",\n".join("    " + a for a in args) + ")")
    else:
        lines.append(f'method = cls.getDeclaredMethod("{method}")')
    lines += [
        "method.setAccessible(True)",
        "self.hook_method(method, MyHook(), 10)",
        "",
        "",
        "class MyHook(MethodHook):",
        "    def before_hooked_method(self, param):",
        "        # param.thisObject — объект, param.args — аргументы",
        "        pass",
        "",
        "    def after_hooked_method(self, param):",
        "        # param.getResult() / param.setResult(...)",
        "        pass",
    ]
    return "\n".join(lines)


# ── DEBUG LOG ─────────────────────────────────────────────────────────────────
_DEBUG_BUF: deque = deque(maxlen=300)


def _dlog(plugin, msg: str):
    """Записать в debug-буфер. В logcat только если debug_mode включён."""
    ts = time.strftime("%H:%M:%S")
    _DEBUG_BUF.appendleft(f"[{ts}] {msg}")
    try:
        if plugin and plugin.get_setting("debug_mode", False):
            log(f"{TAG} {msg}")
    except Exception:
        pass


class HookInspectorPlugin(BasePlugin):

    def __init__(self):
        super().__init__()
        self._enabled = False

        self.panel_open = False
        self.panel_view = None
        self.wm = None
        self._ctx = None
        self._handler = None
        self._lp = None
        self._pal = None
        self._root_bg = None
        self._perm_asked = False

        self._column = self._grip = self._mini = None
        self._title_tv = self._sub_tv = None
        self._body = self._sv = None
        self._tab_texts = []
        self._tab_inds = []
        self._btn_search = None
        self._search_row = self._search_et = None
        self._menu = self._scrim = None
        self._own_ids = set()
        self._minimized = False
        self._search_open = False
        self._setting_query = False
        self._query_r = None

        # Tabs: 0=Элемент 1=Тема 2=Монитор 3=База 4=Лог
        self._tab_idx = 0
        self._queries = {0: "", 1: "", 3: ""}

        self._current_chain: List[str] = []
        self._current_hooks: List[str] = []
        self._current_attrs: dict = {}
        self._current_theme_info: List[Tuple[str, str, List[str]]] = []

        self._history: deque = deque(maxlen=MAX_HISTORY)
        self._hist_idx: int = -1
        self._monitor_log: deque = deque(maxlen=MAX_MONITOR)

        self._sw, self._sh = 1080, 1920
        self._win_w = self._win_h = 0

        self._fire_lock = threading.Lock()
        self._last_fire_ms = 0.0
        self._last_fire_id = 0

    # ── Lifecycle ──────────────────────────────────────────────────────────────

    def on_plugin_load(self):
        _dlog(self, "on_plugin_load start")
        try:
            self._enabled = bool(self.get_setting("inspector_enabled", False))
            self._setup_hooks()
            self.add_menu_item(MenuItemData(
                menu_type=MenuItemType.DRAWER_MENU,
                text="Hook Inspector",
                icon="msg_search",
                subtext="UI Inspector v12 — Theme Keys + Full Touch",
                on_click=self._drawer_click,
                priority=10,
            ))
            _dlog(self, "on_plugin_load complete")
        except Exception as e:
            _dlog(self, f"CRITICAL on_plugin_load: {e}\n{traceback.format_exc()}")
            log(f"{TAG} load: {e}\n{traceback.format_exc()}")

    def on_plugin_unload(self):
        self._enabled = False
        run_on_ui_thread(self._destroy_all)

    def _drawer_click(self, ctx):
        new_val = not self._enabled
        self._enabled = new_val
        self.set_setting("inspector_enabled", new_val, reload_settings=True)
        if new_val:
            self._perm_asked = False
            BulletinHelper.show_info("Инспектор включён — тапните любой элемент")
        else:
            BulletinHelper.show_info("Инспектор выключен")
            run_on_ui_thread(self._destroy_all)

    def _safe(self, fn, *a):
        try:
            return fn(*a)
        except Exception as e:
            log(f"{TAG} {getattr(fn, '__name__', 'cb')}: {e}\n{traceback.format_exc()}")

    def _click(self, fn):
        return OnClickListener(lambda v, f=fn: self._safe(f))

    # ── Xposed hooks ──────────────────────────────────────────────────────────

    def _setup_hooks(self):
        """performClick + performLongClick + dispatchTouchEvent на базовом View."""
        dbg = lambda msg: _dlog(self, f"[hooks] {msg}")
        try:
            V = find_class("android.view.View")
            if V is None:
                dbg("FAIL: View class is None")
                return
            # find_class даёт Python-обёртку; getDeclaredMethod — у java.lang.Class
            ViewClass = V.getClass()

            for name, hook in (("performClick", _ClickHook(self)),
                               ("performLongClick", _LongClickHook(self))):
                try:
                    m = ViewClass.getDeclaredMethod(name)
                    m.setAccessible(True)
                    self.hook_method(m, hook, 10)
                    dbg(f"{name} hooked OK")
                except Exception as e1:
                    dbg(f"FAIL {name}: {e1}\n{traceback.format_exc()}")

            try:
                me_cls = find_class("android.view.MotionEvent").getClass()
                try:
                    m3 = ViewClass.getDeclaredMethod("dispatchTouchEvent", me_cls)
                except Exception:
                    m3 = ViewClass.getDeclaredMethod("dispatchTouchEvent", [me_cls])
                m3.setAccessible(True)
                self.hook_method(m3, _DispatchTouchHook(self), 10)
                dbg("dispatchTouchEvent hooked OK")
            except Exception as e3:
                dbg(f"FAIL dispatchTouchEvent: {e3}\n{traceback.format_exc()}")
        except Exception as e:
            dbg(f"CRITICAL exception: {e}\n{traceback.format_exc()}")
            log(f"{TAG} setup_hooks critical: {e}\n{traceback.format_exc()}")

    # ── View event handler ────────────────────────────────────────────────────

    def _is_own_view(self, view) -> bool:
        """Принадлежит ли view нашему окну (иначе панель инспектирует сама себя)."""
        try:
            if not self._own_ids:
                return False
            return _identity(view.getRootView()) in self._own_ids
        except Exception:
            return False

    def on_view_clicked(self, view, is_long=False):
        if not self._enabled or self._is_own_view(view):
            return
        try:
            depth_idx = max(0, min(2, int(self.get_setting("hierarchy_depth", 1))))
        except Exception:
            depth_idx = 1
        only_known = self.get_setting("show_only_known", False)
        max_depth = [3, 5, 10][depth_idx]
        plugin = self
        try:
            _dlog(self, f"on_view_clicked cls={view.getClass().getName()} long={is_long}")
        except Exception:
            pass
        try:
            attrs = _view_attrs(view)
        except Exception:
            attrs = {}

        def analyze():
            try:
                chain = _hierarchy(view, max_depth)
                if not chain:
                    return
                seen, merged = set(), []
                for cls in chain:
                    for h in _find_hooks(_simple(cls)):
                        if h not in seen:
                            seen.add(h)
                            merged.append(h)
                if only_known and not merged:
                    return
                theme_info = _find_theme_info(chain)
                ts = time.strftime("%H:%M:%S")
                n_tk = sum(len(keys) for _, _, keys in theme_info)
                plugin._monitor_log.appendleft(
                    f"[{ts}]{'[L]' if is_long else '   '} {_simple(chain[0])}  "
                    f"({len(merged)} hooks, {n_tk} theme keys)")

                def on_ui():
                    plugin._current_chain = chain
                    plugin._current_hooks = merged
                    plugin._current_attrs = attrs
                    plugin._current_theme_info = theme_info
                    plugin._push_history(chain, merged, attrs, theme_info)
                    plugin._refresh_monitor_view()
                    if plugin.panel_open:
                        if not plugin._minimized:
                            plugin._fill_current_tab()
                        plugin._update_title()
                    else:
                        plugin._open_panel(chain, merged, attrs, theme_info)
                run_on_ui_thread(on_ui)
            except Exception as e:
                log(f"{TAG} analyze: {e}")

        run_on_queue(analyze, PLUGINS_QUEUE)

    # ── History ───────────────────────────────────────────────────────────────

    def _push_history(self, chain, hooks, attrs, theme_info):
        if self._hist_idx > 0:
            for _ in range(self._hist_idx):
                try: self._history.popleft()
                except Exception: pass
        self._history.appendleft((chain, hooks, attrs, theme_info))
        self._hist_idx = 0

    def _hist_go(self, delta):
        idx = self._hist_idx + delta
        if idx < 0 or idx >= len(self._history):
            return
        self._hist_idx = idx
        chain, hooks, attrs, ti = self._history[idx]
        self._current_chain, self._current_hooks = chain, hooks
        self._current_attrs, self._current_theme_info = attrs, ti
        self._fill_current_tab()
        self._update_title()

    # ── WM / CTX ──────────────────────────────────────────────────────────────

    def _ensure_wm_ctx(self):
        if self.wm and self._ctx:
            return True
        try:
            AppLoader = find_class("org.telegram.messenger.ApplicationLoader")
            ctx = AppLoader.applicationContext
            if not ctx:
                return False
            wm = ctx.getSystemService("window")
            if not wm:
                return False
            Build = find_class("android.os.Build")
            Settings = find_class("android.provider.Settings")
            if Build.VERSION.SDK_INT >= 23 and not Settings.canDrawOverlays(ctx):
                if not self._perm_asked:
                    self._perm_asked = True
                    BulletinHelper.show_error("Нужно разрешение «Поверх других окон»")
                    try:
                        Intent_cls = find_class("android.content.Intent")
                        Uri_cls = find_class("android.net.Uri")
                        it = Intent_cls(Settings.ACTION_MANAGE_OVERLAY_PERMISSION)
                        it.setData(Uri_cls.parse(f"package:{ctx.getPackageName()}"))
                        it.addFlags(Intent_cls.FLAG_ACTIVITY_NEW_TASK)
                        ctx.startActivity(it)
                    except Exception:
                        pass
                return False
            Handler_cls = find_class("android.os.Handler")
            Looper_cls = find_class("android.os.Looper")
            self._ctx = ctx
            self.wm = wm
            self._handler = Handler_cls(Looper_cls.getMainLooper())
            return True
        except Exception as e:
            log(f"{TAG} ensure_wm: {e}")
            return False

    def _post(self, fn, ms):
        try:
            if self._handler is not None:
                self._handler.postDelayed(_make_runnable(fn), ms)
        except Exception as e:
            log(f"{TAG} post: {e}")

    # ── Drag / resize ─────────────────────────────────────────────────────────

    def _drag_listener(self, on_tap=None):
        plugin = self
        OnTouch = find_class("android.view.View$OnTouchListener")

        class _T(dynamic_proxy(OnTouch)):
            def __init__(self):
                super().__init__()
                self.sx = self.sy = 0.0
                self.vx = self.vy = 0
                self.moved = False

            def onTouch(self, v, ev):
                lp = plugin._lp
                if plugin.panel_view is None or lp is None or plugin.wm is None:
                    return False
                a = ev.getAction()
                if a == 0:
                    self.sx, self.sy = ev.getRawX(), ev.getRawY()
                    self.vx, self.vy = lp.x, lp.y
                    self.moved = False
                    return True
                if a == 2:
                    dx, dy = ev.getRawX() - self.sx, ev.getRawY() - self.sy
                    if abs(dx) > _dp(4) or abs(dy) > _dp(4):
                        self.moved = True
                    if self.moved:
                        lp.x = int(self.vx + dx)
                        lp.y = int(self.vy + dy)
                        plugin._clamp_pos()
                        plugin._update_layout()
                    return True
                if a == 1:
                    if self.moved:
                        plugin.set_setting("pos_x", int(lp.x))
                        plugin.set_setting("pos_y", int(lp.y))
                    elif on_tap:
                        plugin._safe(on_tap)
                    return True
                return a == 3
        return _T()

    def _resize_listener(self):
        plugin = self
        OnTouch = find_class("android.view.View$OnTouchListener")

        class _T(dynamic_proxy(OnTouch)):
            def __init__(self):
                super().__init__()
                self.sx = self.sy = 0.0
                self.w0 = self.h0 = 0

            def onTouch(self, v, ev):
                lp = plugin._lp
                if plugin.panel_view is None or lp is None or plugin.wm is None:
                    return False
                a = ev.getAction()
                if a == 0:
                    self.sx, self.sy = ev.getRawX(), ev.getRawY()
                    self.w0, self.h0 = lp.width, lp.height
                    return True
                if a == 2:
                    w = int(self.w0 + ev.getRawX() - self.sx)
                    h = int(self.h0 + ev.getRawY() - self.sy)
                    lp.width = max(_dp(260), min(w, plugin._sw - lp.x))
                    lp.height = max(_dp(220), min(h, plugin._sh - lp.y))
                    plugin._update_layout()
                    return True
                if a == 1:
                    plugin._win_w, plugin._win_h = int(lp.width), int(lp.height)
                    plugin.set_setting("width_dp", plugin._win_w)
                    plugin.set_setting("height_dp", plugin._win_h)
                    return True
                return a == 3
        return _T()

    def _clamp_pos(self):
        lp = self._lp
        if lp is None:
            return
        lp.x = max(0, min(int(lp.x), max(0, self._sw - _dp(48))))
        lp.y = max(0, min(int(lp.y), max(0, self._sh - _dp(48))))

    def _update_layout(self):
        try:
            if self.wm and self.panel_view and self._lp:
                self.wm.updateViewLayout(self.panel_view, self._lp)
        except Exception:
            pass

    # ── UI-билдеры ────────────────────────────────────────────────────────────

    def _load_icon(self, names, color):
        try:
            ctx = self._ctx
            res = ctx.getResources()
            PdcFilter = find_class("android.graphics.PorterDuffColorFilter")
            try:
                from org.telegram.messenger import R as TR
            except Exception:
                TR = None
            for name in names:
                rid = 0
                if TR:
                    try:
                        rid = getattr(TR.drawable, name, 0)
                    except Exception:
                        rid = 0
                if not rid:
                    rid = res.getIdentifier(name, "drawable", ctx.getPackageName())
                if rid:
                    d = res.getDrawable(rid).mutate()
                    d.setColorFilter(PdcFilter(_s32(color), PorterDuff.Mode.SRC_IN))
                    return d
        except Exception as ex:
            log(f"{TAG} load_icon {names}: {ex}")
        return None

    def _icon_view(self, names, glyph, color, size_dp):
        from android.widget import ImageView, TextView
        from android.view import Gravity
        d = self._load_icon(names, color)
        if d is not None:
            v = ImageView(self._ctx)
            v.setImageDrawable(d)
            v.setScaleType(find_class("android.widget.ImageView$ScaleType").CENTER)
        else:
            v = TextView(self._ctx)
            v.setText(glyph)
            v.setGravity(Gravity.CENTER)
            v.setTextSize(2, 16.0)
            v.setTextColor(_s32(color))
            v.setIncludeFontPadding(False)
        v.setLayoutParams(_lin_lp(_dp(size_dp), _dp(size_dp)))
        return v

    def _icon_btn(self, names, glyph, color, fn):
        v = self._icon_view(names, glyph, color, 38)
        v.setBackground(_with_ripple(None, color))
        v.setClickable(True)
        v.setFocusable(True)
        v.setOnClickListener(self._click(fn))
        return v

    def _t(self, text, size=13.0, color=None, mono=False, bold=False, single=False):
        from android.widget import TextView
        from android.graphics import Typeface
        tv = TextView(self._ctx)
        tv.setText(text)
        tv.setTextSize(2, float(size))
        tv.setTextColor(_s32(color if color is not None else self._pal.on_surface))
        if mono:
            tv.setTypeface(Typeface.MONOSPACE)
        elif bold:
            tf = _bold_typeface()
            if tf:
                tv.setTypeface(tf)
        if single:
            tv.setSingleLine(True)
            tv.setEllipsize(find_class("android.text.TextUtils$TruncateAt").END)
        return tv

    def _vbox(self):
        from android.widget import LinearLayout
        ll = LinearLayout(self._ctx)
        ll.setOrientation(LinearLayout.VERTICAL)
        return ll

    def _hbox(self):
        from android.widget import LinearLayout
        from android.view import Gravity
        ll = LinearLayout(self._ctx)
        ll.setOrientation(LinearLayout.HORIZONTAL)
        ll.setGravity(Gravity.CENTER_VERTICAL)
        return ll

    def _card(self, parent):
        c = self._vbox()
        c.setBackground(_rounded(self._pal.container, 14))
        c.setPadding(_dp(12), _dp(10), _dp(12), _dp(10))
        parent.addView(c, _lin_lp(-1, -2, m=(0, 0, 0, _dp(8))))
        return c

    def _label(self, parent, text, color, trailing=None):
        row = self._hbox()
        row.addView(self._t(text, 11.0, color, bold=True), _lin_lp(-2, -2))
        if trailing:
            row.addView(self._t("  " + trailing, 11.0, self._pal.on_surface_var), _lin_lp(-2, -2))
        parent.addView(row, _lin_lp(-1, -2, m=(0, 0, 0, _dp(4))))

    def _tap_copy(self, view, text, msg="Скопировано", long_text=None, long_msg=None):
        view.setBackground(_with_ripple(None, self._pal.on_surface, 8))
        view.setClickable(True)
        view.setOnClickListener(self._click(lambda t=text, m=msg: self._copy(t, m)))
        if long_text:
            plugin = self
            OLC = find_class("android.view.View$OnLongClickListener")

            class _LC(dynamic_proxy(OLC)):
                def onLongClick(self_l, v):
                    plugin._safe(plugin._copy, long_text, long_msg or "Скопировано")
                    return True
            view.setOnLongClickListener(_LC())

    def _copy(self, text, msg="Скопировано"):
        ok = _clipboard(self._ctx, text)
        BulletinHelper.show_info(msg if ok else "Не удалось скопировать")

    def _empty(self, text):
        from android.view import Gravity
        tv = self._t(text, 13.0, self._pal.on_surface_var)
        tv.setGravity(Gravity.CENTER)
        tv.setPadding(_dp(16), _dp(32), _dp(16), _dp(32))
        self._body.addView(tv, _lin_lp(-1, -2))

    def _tonal_btn(self, parent, label, fn):
        from android.view import Gravity
        pal = self._pal
        b = self._t(label, 13.0, pal.primary, bold=True)
        b.setGravity(Gravity.CENTER)
        b.setPadding(_dp(16), 0, _dp(16), 0)
        b.setBackground(_with_ripple(_rounded(_blend(pal.primary, pal.surface, 0.18), 20),
                                     pal.primary, 20))
        b.setClickable(True)
        b.setOnClickListener(self._click(fn))
        parent.addView(b, _lin_lp(-2, _dp(40), m=(0, 0, _dp(8), 0)))
        return b

    def _swatch(self, color, size=18):
        from android.view import View
        v = View(self._ctx)
        v.setBackground(_rounded(color, 5, self._pal.outline, 1.0))
        return v, _lin_lp(_dp(size), _dp(size), m=(0, 0, _dp(10), 0))

    # ── PANEL ─────────────────────────────────────────────────────────────────

    def _open_panel(self, chain, hooks, attrs, theme_info=None):
        self._current_chain, self._current_hooks = chain, hooks
        self._current_attrs = attrs
        self._current_theme_info = theme_info or []
        if self.panel_open:
            if not self._minimized:
                self._fill_current_tab()
            self._update_title()
            return
        try:
            if not self._ensure_wm_ctx():
                return
            from android.widget import (FrameLayout, LinearLayout, ScrollView, EditText)
            from android.view import Gravity, View

            LayoutParams = find_class("android.view.WindowManager$LayoutParams")
            PixelFormat = find_class("android.graphics.PixelFormat")
            Build = find_class("android.os.Build")
            ctx, wm, plugin = self._ctx, self.wm, self

            dm = ctx.getResources().getDisplayMetrics()
            self._sw, self._sh = int(dm.widthPixels), int(dm.heightPixels)
            try:
                op_idx = max(0, min(len(OPACITIES) - 1, int(self.get_setting("opacity", 0))))
            except Exception:
                op_idx = 0
            pal = _Palette(OPACITIES[op_idx])
            self._pal = pal

            root = FrameLayout(ctx)
            self._root_bg = _rounded(_alpha(pal.surface, pal.win_alpha), 24, pal.outline, 1.0)
            root.setBackground(self._root_bg)

            column = LinearLayout(ctx)
            column.setOrientation(LinearLayout.VERTICAL)
            root.addView(column, _fr_lp(-1, -1))
            self._column = column

            # ── шапка ────────────────────
            header = self._hbox()
            header.setPadding(_dp(16), _dp(8), _dp(4), 0)
            title_box = self._vbox()
            title_tv = self._t("Hook Inspector", 16.0, pal.on_surface, bold=True, single=True)
            sub_tv = self._t("Тапните любой элемент интерфейса", 11.0, pal.on_surface_var, single=True)
            title_box.addView(title_tv)
            title_box.addView(sub_tv)
            header.addView(title_box, _lin_lp(0, -2, 1.0))
            self._title_tv, self._sub_tv = title_tv, sub_tv

            c_icon = pal.on_surface_var
            self._btn_search = self._icon_btn(["msg_search"], "?", c_icon, self._toggle_search)
            header.addView(self._btn_search)
            header.addView(self._icon_btn(["ic_ab_other", "msg_settings"], "⋮", c_icon, self._toggle_menu))
            header.addView(self._icon_btn(["arrow_more"], "▾", c_icon, lambda: self._set_minimized(True)))
            header.addView(self._icon_btn(["msg_cancel_solar", "ic_close_white"], "✕", c_icon,
                                          self._disable_inspector))
            column.addView(header, _lin_lp(-1, _dp(52)))

            # ── вкладки ───────────────────
            tabs = LinearLayout(ctx)
            tabs.setOrientation(LinearLayout.HORIZONTAL)
            tabs.setPadding(_dp(8), 0, _dp(8), 0)
            self._tab_texts, self._tab_inds = [], []
            for i, label in enumerate(TAB_LABELS):
                cell = self._vbox()
                cell.setClickable(True)
                cell.setOnClickListener(self._click(lambda idx=i: self._select_tab(idx)))
                tt = self._t(label, 13.0, pal.on_surface_var, bold=True, single=True)
                tt.setGravity(Gravity.CENTER)
                cell.addView(tt, _lin_lp(-1, _dp(38)))
                ind = View(ctx)
                cell.addView(ind, _lin_lp(-1, _dp(3), m=(_dp(10), 0, _dp(10), 0)))
                tabs.addView(cell, _lin_lp(0, -2, 1.0))
                self._tab_texts.append(tt)
                self._tab_inds.append(ind)
            column.addView(tabs, _lin_lp(-1, _dp(41)))
            line = View(ctx)
            line.setBackgroundColor(_s32(pal.outline))
            column.addView(line, _lin_lp(-1, 1))

            # ── поиск ─────────────────────
            search_row = LinearLayout(ctx)
            search_row.setOrientation(LinearLayout.HORIZONTAL)
            search_row.setGravity(Gravity.CENTER_VERTICAL)
            search_row.setPadding(_dp(12), _dp(8), _dp(12), _dp(2))
            search_row.setVisibility(8)
            box = self._hbox()
            box.setBackground(_rounded(pal.container_high, 22))
            et = EditText(ctx)
            et.setHint("Фильтр")
            et.setHintTextColor(_s32(pal.on_surface_var))
            et.setTextColor(_s32(pal.on_surface))
            et.setTextSize(2, 14.0)
            et.setSingleLine(True)
            et.setImeOptions(3)
            et.setBackground(None)
            et.setPadding(_dp(16), 0, _dp(4), 0)

            TextWatcher = find_class("android.text.TextWatcher")

            class _TW(dynamic_proxy(TextWatcher)):
                def afterTextChanged(self_w, s):
                    plugin._on_query_changed(str(s))

                def beforeTextChanged(self_w, s, a, b, c):
                    pass

                def onTextChanged(self_w, s, a, b, c):
                    pass
            et.addTextChangedListener(_TW())

            OnKey = find_class("android.view.View$OnKeyListener")

            class _KL(dynamic_proxy(OnKey)):
                def onKey(self_k, v, code, ev):
                    try:
                        if code == 4 and ev.getAction() == 1:
                            plugin._close_search()
                            return True
                    except Exception:
                        pass
                    return False
            et.setOnKeyListener(_KL())

            EditorAction = find_class("android.widget.TextView$OnEditorActionListener")

            class _EA(dynamic_proxy(EditorAction)):
                def onEditorAction(self_e, v, action_id, ev):
                    plugin._hide_keyboard()
                    return True
            et.setOnEditorActionListener(_EA())

            clear = self._t("✕", 14.0, pal.on_surface_var)
            clear.setGravity(Gravity.CENTER)
            clear.setOnClickListener(self._click(lambda: et.setText("")))
            box.addView(et, _lin_lp(0, -1, 1.0))
            box.addView(clear, _lin_lp(_dp(44), -1))
            search_row.addView(box, _lin_lp(-1, _dp(44)))
            column.addView(search_row, _lin_lp(-1, -2))
            self._search_row, self._search_et = search_row, et

            # ── тело ──────────────────────
            sv = ScrollView(ctx)
            sv.setOverScrollMode(2)
            body = self._vbox()
            body.setPadding(_dp(12), _dp(10), _dp(12), _dp(8))
            sv.addView(body, _fr_lp(-1, -2))
            column.addView(sv, _lin_lp(-1, 0, 1.0))
            self._sv, self._body = sv, body

            # ── нижняя ручка (перетаскивание) ──
            drag_bar = LinearLayout(ctx)
            drag_bar.setOrientation(LinearLayout.VERTICAL)
            drag_bar.setGravity(Gravity.CENTER)
            drag_bar.setOnTouchListener(self._drag_listener())
            pill = View(ctx)
            pill.setBackground(_rounded(pal.outline, 2))
            drag_bar.addView(pill, _lin_lp(_dp(40), _dp(4)))
            column.addView(drag_bar, _lin_lp(-1, _dp(28)))

            # ── ресайз-уголок ─────────────
            grip = self._t("◢", 13.0, _alpha(pal.on_surface_var, 0xAA))
            grip.setGravity(Gravity.BOTTOM | Gravity.RIGHT)
            grip.setPadding(0, 0, _dp(8), _dp(4))
            grip.setIncludeFontPadding(False)
            grip.setOnTouchListener(self._resize_listener())
            root.addView(grip, _fr_lp(_dp(32), _dp(32), Gravity.BOTTOM | Gravity.RIGHT))
            self._grip = grip

            # ── меню ──────────────────────
            scrim = FrameLayout(ctx)
            scrim.setClickable(True)
            scrim.setVisibility(8)
            scrim.setOnClickListener(self._click(self._hide_menu))
            root.addView(scrim, _fr_lp(-1, -1))
            self._scrim = scrim

            menu_sv = ScrollView(ctx)
            menu_sv.setBackground(_rounded(pal.container_high, 16, pal.outline, 1.0))
            try:
                menu_sv.setElevation(float(_dp(6)))
            except Exception:
                pass
            menu_sv.setVisibility(8)
            menu_ll = self._vbox()
            menu_ll.setPadding(0, _dp(8), 0, _dp(8))
            menu_sv.addView(menu_ll, _fr_lp(-1, -2))
            on_s = pal.on_surface
            rows = [
                ("Назад по истории", ["msg_arrow_back"], lambda: self._hist_go(1)),
                ("Вперёд по истории", ["msg_arrow_next"], lambda: self._hist_go(-1)),
                ("Копировать всё", ["msg_copy"], self._copy_all),
                ("Копировать класс", ["msg_copy"], self._copy_class),
                ("Копировать хуки", ["msg_copy"], self._copy_hooks),
                ("Копировать ключи темы", ["msg_theme", "msg_copy"], self._copy_theme_keys),
                ("Сохранить в файл", ["msg_download", "msg_saved"], self._export_current),
            ]
            for label, icons, fn in rows:
                menu_ll.addView(self._menu_row(label, icons, on_s, fn))
            root.addView(menu_sv, _fr_lp(_dp(240), -2, Gravity.TOP | Gravity.RIGHT,
                                         (0, _dp(52), _dp(8), 0)))
            self._menu = menu_sv

            # ── свёрнутое состояние ───────
            mini = self._icon_view(["msg_search"], "HI", pal.on_primary, 56)
            mini.setBackground(_rounded(pal.primary, 28, shape=1))
            mini.setClickable(True)
            mini.setVisibility(8)
            mini.setOnTouchListener(self._drag_listener(on_tap=lambda: self._set_minimized(False)))
            root.addView(mini, _fr_lp(_dp(56), _dp(56), Gravity.TOP | Gravity.LEFT))
            self._mini = mini

            # ── окно ──────────────────────
            w = int(self.get_setting("width_dp", 0) or 0) or int(self._sw * 0.92)
            h = int(self.get_setting("height_dp", 0) or 0) or int(self._sh * 0.58)
            self._win_w = max(_dp(260), min(w, self._sw))
            self._win_h = max(_dp(220), min(h, self._sh))
            px = int(self.get_setting("pos_x", 0) or 0)
            py = int(self.get_setting("pos_y", 0) or 0)
            if not px and not py:
                px = (self._sw - self._win_w) // 2
                py = int(self._sh * 0.06)

            lp_type = (LayoutParams.TYPE_APPLICATION_OVERLAY if Build.VERSION.SDK_INT >= 26
                       else LayoutParams.TYPE_PHONE)
            flags = (LayoutParams.FLAG_NOT_FOCUSABLE | LayoutParams.FLAG_NOT_TOUCH_MODAL
                     | LayoutParams.FLAG_LAYOUT_NO_LIMITS)
            lp = LayoutParams(self._win_w, self._win_h, px, py, lp_type, flags,
                              PixelFormat.TRANSLUCENT)
            lp.gravity = Gravity.TOP | Gravity.LEFT
            lp.softInputMode = 0x30  # ADJUST_NOTHING
            self._lp = lp
            self._clamp_pos()

            root.setAlpha(0.0)
            root.setTranslationY(float(-_dp(16)))
            wm.addView(root, lp)
            self.panel_view = root
            self.panel_open = True
            self._minimized = False
            self._search_open = False
            self._own_ids = {_identity(root)}
            root.animate().alpha(1.0).translationY(0.0).setDuration(220).start()

            self._select_tab(self._tab_idx)
            self._update_title()

        except Exception as e:
            log(f"{TAG} _open_panel: {e}\n{traceback.format_exc()}")
            BulletinHelper.show_error(f"Inspector: {e}")
            try:
                if self.panel_view is not None and self.wm is not None:
                    self.wm.removeView(self.panel_view)
            except Exception:
                pass
            self._reset_refs()

    def _menu_row(self, label, icon_names, color, fn):
        from android.view import View
        pal = self._pal
        row = self._hbox()
        row.setPadding(_dp(16), 0, _dp(16), 0)
        row.setBackground(_with_ripple(None, pal.on_surface, 0))
        row.setClickable(True)
        if self._load_icon(icon_names, color) is not None:
            row.addView(self._icon_view(icon_names, "", color, 24),
                        _lin_lp(_dp(24), _dp(24), m=(0, 0, _dp(16), 0)))
        else:
            row.addView(View(self._ctx), _lin_lp(_dp(24), _dp(24), m=(0, 0, _dp(16), 0)))
        row.addView(self._t(label, 14.0, color, single=True), _lin_lp(0, -2, 1.0))

        def _on(v, f=fn):
            self._hide_menu()
            self._safe(f)
        row.setOnClickListener(OnClickListener(_on))
        row.setLayoutParams(_lin_lp(-1, _dp(44)))
        return row

    def _reset_refs(self):
        self.panel_view = None
        self.panel_open = False
        self._lp = None
        self._column = self._grip = self._mini = None
        self._title_tv = self._sub_tv = None
        self._body = self._sv = None
        self._tab_texts, self._tab_inds = [], []
        self._btn_search = None
        self._search_row = self._search_et = None
        self._menu = self._scrim = None
        self._own_ids = set()
        self._minimized = False
        self._search_open = False

    def _destroy_all(self):
        try:
            if self._search_open:
                self._hide_keyboard()
            if self.panel_view is not None and self.wm is not None:
                try:
                    self.wm.removeView(self.panel_view)
                except Exception:
                    pass
        finally:
            self._reset_refs()
            self.wm = None
            self._ctx = None
            self._handler = None

    def _disable_inspector(self):
        self._enabled = False
        self.set_setting("inspector_enabled", False, reload_settings=True)
        self._destroy_all()
        BulletinHelper.show_info("Инспектор выключен")

    # ── Свернуть / развернуть ─────────────────────────────────────────────────

    def _set_minimized(self, flag):
        if not self.panel_open or flag == self._minimized:
            return
        self._hide_menu()
        if self._search_open:
            self._close_search()
        self._minimized = flag
        lp = self._lp
        if flag:
            self._column.setVisibility(8)
            self._grip.setVisibility(8)
            self.panel_view.setBackground(None)
            self._mini.setVisibility(0)
            self._mini.setScaleX(0.6)
            self._mini.setScaleY(0.6)
            self._mini.animate().scaleX(1.0).scaleY(1.0).setDuration(160).start()
            lp.width = lp.height = _dp(56)
        else:
            self._mini.setVisibility(8)
            self.panel_view.setBackground(self._root_bg)
            self._column.setVisibility(0)
            self._grip.setVisibility(0)
            self._column.setAlpha(0.0)
            self._column.animate().alpha(1.0).setDuration(180).start()
            lp.width = min(self._win_w, self._sw)
            lp.height = min(self._win_h, self._sh)
            lp.x = max(0, min(lp.x, self._sw - lp.width))
            lp.y = max(0, min(lp.y, self._sh - lp.height))
            self._fill_current_tab()
        self._update_layout()

    # ── Меню ──────────────────────────────────────────────────────────────────

    def _toggle_menu(self):
        if self._menu is not None and self._menu.getVisibility() == 0:
            self._hide_menu()
            return
        try:
            avail = max(_dp(120), self.panel_view.getHeight() - _dp(60))
            lp = self._menu.getLayoutParams()
            lp.height = min(_dp(7 * 44 + 16), avail)
            self._menu.setLayoutParams(lp)
        except Exception:
            pass
        self._scrim.setVisibility(0)
        self._menu.setVisibility(0)
        self._menu.setAlpha(0.0)
        self._menu.animate().alpha(1.0).setDuration(120).start()

    def _hide_menu(self):
        try:
            if self._menu is not None:
                self._menu.setVisibility(8)
            if self._scrim is not None:
                self._scrim.setVisibility(8)
        except Exception:
            pass

    # ── Вкладки и поиск ───────────────────────────────────────────────────────

    _HINTS = {0: "Фильтр хуков", 1: "Фильтр ключей темы",
              3: "Имя класса, например chatmessagecell"}

    def _select_tab(self, idx):
        self._tab_idx = idx
        pal = self._pal
        for i, (tt, ind) in enumerate(zip(self._tab_texts, self._tab_inds)):
            sel = i == idx
            tt.setTextColor(_s32(pal.primary if sel else pal.on_surface_var))
            ind.setBackground(_rounded(pal.primary if sel else 0x00000000, 2))
        searchable = idx in self._HINTS
        if self._btn_search is not None:
            self._btn_search.setVisibility(0 if searchable else 8)
        if searchable:
            self._setting_query = True
            try:
                self._search_et.setHint(self._HINTS[idx])
                self._search_et.setText(self._queries.get(idx, ""))
            finally:
                self._setting_query = False
        elif self._search_open:
            self._close_search()
        self._hide_menu()
        self._fill_current_tab()

    def _on_query_changed(self, text):
        if self._setting_query or self._tab_idx not in self._queries:
            return
        self._queries[self._tab_idx] = text.strip()
        if self._query_r is None:
            self._query_r = _make_runnable(self._fill_current_tab)
        try:
            self._handler.removeCallbacks(self._query_r)
            self._handler.postDelayed(self._query_r, 220)
        except Exception:
            pass

    def _toggle_search(self):
        if self._search_open:
            self._close_search()
        else:
            self._open_search()

    def _open_search(self):
        if not self.panel_open or self._search_open or self._tab_idx not in self._queries:
            return
        self._hide_menu()
        LP = find_class("android.view.WindowManager$LayoutParams")
        self._lp.flags = LP.FLAG_NOT_TOUCH_MODAL | LP.FLAG_LAYOUT_NO_LIMITS
        self._update_layout()
        self._search_row.setVisibility(0)
        self._search_open = True
        et = self._search_et

        def _kb():
            try:
                et.requestFocus()
                self._ctx.getSystemService("input_method").showSoftInput(et, 1)
            except Exception as ex:
                log(f"{TAG} showSoftInput: {ex}")
        self._post(_kb, 120)

    def _hide_keyboard(self):
        try:
            imm = self._ctx.getSystemService("input_method")
            imm.hideSoftInputFromWindow(self._search_et.getWindowToken(), 0)
        except Exception:
            pass

    def _close_search(self):
        if not self._search_open:
            return
        self._hide_keyboard()
        self._search_open = False
        try:
            self._search_row.setVisibility(8)
        except Exception:
            pass
        LP = find_class("android.view.WindowManager$LayoutParams")
        if self._lp is not None:
            self._lp.flags = (LP.FLAG_NOT_FOCUSABLE | LP.FLAG_NOT_TOUCH_MODAL
                              | LP.FLAG_LAYOUT_NO_LIMITS)
            self._update_layout()

    # ── Заполнение вкладок ────────────────────────────────────────────────────

    def _update_title(self):
        try:
            if self._title_tv is None:
                return
            chain = self._current_chain
            if chain:
                n_tk = sum(len(k) for _, _, k in self._current_theme_info)
                self._title_tv.setText(_simple(chain[0]))
                self._sub_tv.setText(f"Хуков: {len(self._current_hooks)} · ключей темы: {n_tk}")
            else:
                self._title_tv.setText("Hook Inspector")
                self._sub_tv.setText("Тапните любой элемент интерфейса")
        except Exception:
            pass

    def _fill_current_tab(self):
        try:
            if self._body is None or self._minimized:
                return
            self._body.removeAllViews()
            try:
                self._sv.scrollTo(0, 0)
            except Exception:
                pass
            idx = self._tab_idx
            if idx == 0: self._fill_inspector()
            elif idx == 1: self._fill_theme_tab()
            elif idx == 2: self._fill_monitor()
            elif idx == 3: self._fill_db_search()
            elif idx == 4: self._fill_debug_log()
        except Exception as e:
            log(f"{TAG} fill_tab: {e}\n{traceback.format_exc()}")

    def _kv(self, parent, key, value, swatch_hex=None, color=None):
        row = self._hbox()
        row.addView(self._t(key, 11.0, self._pal.on_surface_var), _lin_lp(_dp(84), -2))
        if swatch_hex:
            try:
                sw, sw_lp = self._swatch(int(swatch_hex.replace("#", ""), 16), 14)
                row.addView(sw, sw_lp)
            except Exception:
                pass
        row.addView(self._t(value, 11.5, color if color is not None else self._pal.on_surface,
                            mono=True), _lin_lp(0, -2, 1.0))
        parent.addView(row, _lin_lp(-1, -2, m=(0, _dp(2), 0, _dp(2))))

    # [0] ЭЛЕМЕНТ
    def _fill_inspector(self):
        body, pal = self._body, self._pal
        chain, hooks, attrs = self._current_chain, self._current_hooks, self._current_attrs
        if not chain:
            self._empty("Тапните любой элемент интерфейса —\nздесь появятся класс, хуки и ключи темы")
            return
        filt = self._queries[0].lower()

        card = self._card(body)
        self._label(card, "КЛАСС", pal.primary)
        cls = self._t(chain[0], 12.0, pal.on_surface, mono=True)
        card.addView(cls, _lin_lp(-1, -2))
        self._tap_copy(cls, chain[0], "Класс скопирован")
        res = attrs.get("res_id", "")
        if res:
            card.addView(self._t(f"@id/{res}", 11.5, pal.c_res, mono=True),
                         _lin_lp(-1, -2, m=(0, _dp(4), 0, 0)))

        if attrs:
            card = self._card(body)
            self._label(card, "АТРИБУТЫ", pal.c_attr)
            if "w" in attrs and "h" in attrs:
                self._kv(card, "size", f"{attrs['w']} × {attrs['h']} px")
            pads = [attrs.get(k) for k in ("pl", "pt", "pr", "pb")]
            if all(p is not None for p in pads):
                self._kv(card, "padding", f"L{pads[0]} T{pads[1]} R{pads[2]} B{pads[3]}")
            for k in ("vis", "enabled", "clickable", "focused"):
                if k in attrs:
                    self._kv(card, k, attrs[k])
            for k in ("bg_color", "text_color"):
                if k in attrs:
                    self._kv(card, k, attrs[k], swatch_hex=attrs[k])

        if len(chain) > 1:
            card = self._card(body)
            self._label(card, "ИЕРАРХИЯ", pal.on_surface_var)
            for i, c in enumerate(chain[1:], 1):
                tv = self._t(_simple(c), 11.5, pal.hier[i % len(pal.hier)], mono=True)
                tv.setPadding(_dp(8 * (i - 1)), 0, 0, 0)
                card.addView(tv, _lin_lp(-1, -2, m=(0, _dp(1), 0, _dp(1))))

        filtered = [h for h in hooks if filt in h.lower()] if filt else hooks
        card = self._card(body)
        self._label(card, "ХУКИ", pal.c_hook,
                    (f"{len(filtered)} из {len(hooks)}" if filt else str(len(hooks))))
        if filtered:
            card.addView(self._t("Нажмите — скопировать хук, удерживайте — шаблон кода", 10.5,
                                 pal.on_surface_var), _lin_lp(-1, -2, m=(0, 0, 0, _dp(4))))
            for h in filtered:
                tv = self._t("› " + h, 12.0, pal.on_surface)
                tv.setPadding(_dp(4), _dp(5), _dp(4), _dp(5))
                self._tap_copy(tv, h, "Хук скопирован",
                               long_text=_hook_snippet(h, chain), long_msg="Шаблон кода скопирован")
                card.addView(tv, _lin_lp(-1, -2))
        else:
            snippet = f'find_class("{chain[0]}")'
            tv = self._t(f"Ничего не найдено по «{filt}»" if filt
                         else f"Класса нет в базе.\n{snippet}", 12.0, pal.on_surface_var,
                         mono=not filt)
            if not filt:
                self._tap_copy(tv, snippet, "Скопировано")
            card.addView(tv, _lin_lp(-1, -2))

    # [1] ТЕМА
    def _fill_theme_tab(self):
        body, pal = self._body, self._pal
        chain, ti, attrs = self._current_chain, self._current_theme_info, self._current_attrs
        if not chain:
            self._empty("Сначала тапните любой элемент интерфейса")
            return
        filt = self._queries[1].lower()

        if attrs.get("bg_color") or attrs.get("text_color"):
            card = self._card(body)
            self._label(card, "ЦВЕТА ЭЛЕМЕНТА", pal.primary)
            for k in ("bg_color", "text_color"):
                if k in attrs:
                    self._kv(card, k, attrs[k], swatch_hex=attrs[k], color=pal.c_attr)

        if not ti:
            self._empty("Для этого класса нет ключей темы в базе.\nПопробуйте вкладку «База».")
            return

        shown = 0
        last_pattern = None
        for pattern, section, keys in ti:
            ks = [k for k in keys if filt in k.lower()] if filt else keys
            if not ks:
                continue
            card = self._card(body)
            self._label(card, section.upper(), pal.c_theme,
                        pattern if pattern != last_pattern else None)
            last_pattern = pattern
            for key in ks:
                shown += 1
                row = self._hbox()
                row.setPadding(_dp(2), _dp(5), _dp(2), _dp(5))
                color_val = _get_tg_color(key)
                if color_val is not None:
                    sw, sw_lp = self._swatch(color_val, 18)
                    row.addView(sw, sw_lp)
                row.addView(self._t(key, 11.5, pal.on_surface, mono=True), _lin_lp(0, -2, 1.0))
                if color_val is not None:
                    row.addView(self._t(_int_to_hex(color_val), 10.0, pal.on_surface_var, mono=True),
                                _lin_lp(-2, -2, m=(_dp(8), 0, 0, 0)))
                self._tap_copy(row, _theme_call(key), "Скопировано")
                card.addView(row, _lin_lp(-1, -2))
        if not shown:
            self._empty(f"Нет ключей по «{filt}»")
        else:
            hint = self._t("Нажмите на ключ — скопируется Theme.getColor(Theme.key_…)", 10.5,
                           pal.on_surface_var)
            body.addView(hint, _lin_lp(-1, -2, m=(_dp(4), 0, 0, _dp(8))))

    # [2] МОНИТОР
    def _fill_monitor(self):
        body, pal = self._body, self._pal
        btns = self._hbox()
        self._tonal_btn(btns, "Сохранить", self._export_monitor)
        self._tonal_btn(btns, "Очистить", self._clear_monitor)
        body.addView(btns, _lin_lp(-1, -2, m=(0, 0, 0, _dp(8))))
        if not self._monitor_log:
            self._empty("Событий пока нет — тапайте элементы интерфейса")
            return
        card = self._card(body)
        self._label(card, "ПОСЛЕДНИЕ СОБЫТИЯ", pal.on_surface_var, f"до {MAX_MONITOR}")
        for entry in self._monitor_log:
            card.addView(self._t(entry, 10.5, pal.on_surface, mono=True),
                         _lin_lp(-1, -2, m=(0, _dp(1), 0, _dp(1))))

    def _refresh_monitor_view(self):
        if self.panel_open and not self._minimized and self._tab_idx == 2:
            self._fill_current_tab()

    def _clear_monitor(self):
        self._monitor_log.clear()
        self._fill_current_tab()

    def _export_monitor(self):
        path = _save_text(f"monitor_{time.strftime('%Y%m%d_%H%M%S')}.txt", "\n".join(self._monitor_log))
        if path:
            BulletinHelper.show_success(f"Сохранено: {path}")
        else:
            BulletinHelper.show_error("Не удалось сохранить")

    # [3] БАЗА
    def _fill_db_search(self):
        body, pal = self._body, self._pal
        q = self._queries[3].lower()
        if not q:
            card = self._card(body)
            self._label(card, "ПОИСК ПО КЛАССУ", pal.primary)
            card.addView(self._t("Нажмите 🔍 и введите часть имени класса. Ищет и хуки, и ключи темы.",
                                 12.0, pal.on_surface), _lin_lp(-1, -2))
            card = self._card(body)
            self._label(card, "КЛАССЫ В БАЗЕ ХУКОВ", pal.on_surface_var, str(len(HOOK_DB)))
            card.addView(self._t(", ".join(sorted(HOOK_DB.keys())), 11.0, pal.on_surface_var, mono=True),
                         _lin_lp(-1, -2))
            return

        hook_found = [h for key, hs in HOOK_DB.items() if q in key for h in hs]
        theme_found = [(sn, ks) for key, secs in THEME_KEY_DB.items() if q in key for sn, ks in secs]
        if not hook_found and not theme_found:
            self._empty(f"По «{q}» ничего не найдено")
            return
        if hook_found:
            card = self._card(body)
            self._label(card, "ХУКИ", pal.c_hook, str(len(hook_found)))
            card.addView(self._t("Нажмите — скопировать хук, удерживайте — шаблон кода", 10.5,
                                 pal.on_surface_var), _lin_lp(-1, -2, m=(0, 0, 0, _dp(4))))
            for h in hook_found:
                tv = self._t("› " + h, 12.0, pal.on_surface)
                tv.setPadding(_dp(4), _dp(5), _dp(4), _dp(5))
                self._tap_copy(tv, h, "Хук скопирован",
                               long_text=_hook_snippet(h, []), long_msg="Шаблон кода скопирован")
                card.addView(tv, _lin_lp(-1, -2))
        for sn, ks in theme_found:
            card = self._card(body)
            self._label(card, sn.upper(), pal.c_theme, str(len(ks)))
            for k in ks:
                tv = self._t(k, 11.5, pal.on_surface, mono=True)
                tv.setPadding(_dp(4), _dp(5), _dp(4), _dp(5))
                self._tap_copy(tv, _theme_call(k), "Скопировано")
                card.addView(tv, _lin_lp(-1, -2))

    # [4] ЛОГ
    def _fill_debug_log(self):
        body, pal = self._body, self._pal
        btns = self._hbox()
        self._tonal_btn(btns, "Диагностика", self._diag_and_refresh)
        self._tonal_btn(btns, "Очистить", self._clear_debug)
        body.addView(btns, _lin_lp(-1, -2, m=(0, 0, 0, _dp(8))))
        if not _DEBUG_BUF:
            self._empty("Лог пуст — тапните элемент или запустите диагностику")
            return
        card = self._card(body)
        self._label(card, "ОТЛАДОЧНЫЙ ЛОГ", pal.on_surface_var, f"{len(_DEBUG_BUF)} записей")
        for entry in _DEBUG_BUF:
            if "FAIL" in entry or "CRITICAL" in entry or "ERROR" in entry:
                col = pal.c_err
            elif "OK" in entry or "hooked" in entry or "complete" in entry:
                col = pal.c_attr
            elif "WARN" in entry:
                col = pal.c_hook
            else:
                col = pal.on_surface
            card.addView(self._t(entry, 10.5, col, mono=True), _lin_lp(-1, -2, m=(0, _dp(1), 0, _dp(1))))

    def _diag_and_refresh(self):
        self._run_diagnostics()
        self._fill_current_tab()

    def _clear_debug(self):
        _DEBUG_BUF.clear()
        self._fill_current_tab()

    # ── Действия меню ─────────────────────────────────────────────────────────

    def _plain_text(self) -> str:
        chain, hooks = self._current_chain, self._current_hooks
        attrs, ti = self._current_attrs, self._current_theme_info
        lines = ["Hook Inspector", "=" * 40,
                 f"Class: {chain[0] if chain else '?'}"]
        res = attrs.get("res_id", "")
        if res:
            lines.append(f"ResID: @id/{res}")
        if attrs:
            if attrs.get("w") and attrs.get("h"):
                lines.append(f"Size: {attrs['w']}x{attrs['h']} px")
            for k in ("vis", "enabled", "clickable", "focused", "bg_color", "text_color"):
                if k in attrs:
                    lines.append(f"{k}: {attrs[k]}")
        if len(chain) > 1:
            lines.append("Parents:")
            for i, c in enumerate(chain[1:], 1):
                lines.append("  " * i + "- " + c)
        if hooks:
            lines.append(f"\nHooks ({len(hooks)}):")
            lines.extend(f"* {hk}" for hk in hooks)
        if ti:
            lines.append(f"\nTheme Keys ({sum(len(kk) for _, _, kk in ti)}):")
            for _, sec, keys in ti:
                lines.append(f"  // {sec}")
                lines.extend(f"  {_theme_call(k)}" for k in keys)
        return "\n".join(lines)

    def _copy_all(self):
        self._copy(self._plain_text(), "Скопировано")

    def _copy_class(self):
        if self._current_chain:
            self._copy(self._current_chain[0], "Класс скопирован")
        else:
            BulletinHelper.show_info("Нет данных")

    def _copy_hooks(self):
        if self._current_hooks:
            self._copy("\n".join(f"* {h}" for h in self._current_hooks),
                       f"Скопировано хуков: {len(self._current_hooks)}")
        else:
            BulletinHelper.show_info("Нет хуков")

    def _copy_theme_keys(self):
        ti = self._current_theme_info
        if not ti:
            BulletinHelper.show_info("Нет ключей темы")
            return
        lines = []
        for _, sec, keys in ti:
            lines.append(f"// {sec}")
            lines.extend(_theme_call(k) for k in keys)
        self._copy("\n".join(lines), f"Скопировано ключей: {sum(len(k) for _, _, k in ti)}")

    def _export_current(self):
        path = _save_text(f"{time.strftime('%Y%m%d_%H%M%S')}.txt", self._plain_text())
        if path:
            BulletinHelper.show_success(f"Сохранено: {path}")
        else:
            BulletinHelper.show_error("Не удалось сохранить")

    # ── Settings ───────────────────────────────────────────────────────────────

    def _on_inspector_toggle(self, enabled: bool):
        self._enabled = bool(enabled)
        if enabled:
            self._perm_asked = False
        else:
            run_on_ui_thread(self._destroy_all)

    def _on_opacity_change(self, value):
        def _apply():
            try:
                if self.panel_open and self._root_bg is not None:
                    idx = max(0, min(len(OPACITIES) - 1, int(self.get_setting("opacity", 0))))
                    self._pal.win_alpha = OPACITIES[idx]
                    self._root_bg.setColor(_s32(_alpha(self._pal.surface, self._pal.win_alpha)))
            except Exception:
                pass
        run_on_ui_thread(_apply)

    def _reset_pos(self, v=None):
        for k in ("pos_x", "pos_y", "width_dp", "height_dp"):
            self.set_setting(k, 0)
        if self.panel_open:
            chain, hooks = self._current_chain, self._current_hooks
            attrs, ti = self._current_attrs, self._current_theme_info

            def _reopen():
                self._destroy_all()
                self._open_panel(chain, hooks, attrs, ti)
            run_on_ui_thread(_reopen)
        BulletinHelper.show_success("Позиция и размер сброшены")

    def _run_diagnostics(self, v=None):
        """Диагностика — результат пишется в _DEBUG_BUF (вкладка «Лог»)."""
        try:
            _dlog(self, "=== DIAGNOSTICS START ===")
            _dlog(self, f"inspector_enabled={self._enabled}")
            _dlog(self, f"debug_mode={self.get_setting('debug_mode', False)}")
            _dlog(self, f"hierarchy_depth={self.get_setting('hierarchy_depth', 1)}")
            _dlog(self, f"show_only_known={self.get_setting('show_only_known', False)}")
            _dlog(self, f"panel_open={self.panel_open} minimized={self._minimized}")
            _dlog(self, f"wm={self.wm is not None} ctx={self._ctx is not None}")
            checks = [
                ("android.view.View", "View"),
                ("android.view.MotionEvent", "MotionEvent"),
                ("org.telegram.ui.ActionBar.Theme", "Telegram Theme"),
                ("org.telegram.messenger.ApplicationLoader", "ApplicationLoader"),
                ("android.os.Build", "Build"),
                ("android.provider.Settings", "Settings"),
                ("android.view.WindowManager$LayoutParams", "WM LayoutParams"),
            ]
            for cls_name, label in checks:
                try:
                    _dlog(self, f"[OK] {label}: {find_class(cls_name)}")
                except Exception as e:
                    _dlog(self, f"[FAIL] {label}: {e}")
            try:
                ctx = find_class("org.telegram.messenger.ApplicationLoader").applicationContext
                sdk = find_class("android.os.Build").VERSION.SDK_INT
                if sdk >= 23:
                    if find_class("android.provider.Settings").canDrawOverlays(ctx):
                        _dlog(self, f"[OK] canDrawOverlays SDK={sdk}")
                    else:
                        _dlog(self, f"[FAIL] canDrawOverlays=False SDK={sdk} — overlay НЕ работает!")
                else:
                    _dlog(self, f"[OK] SDK={sdk} < 23 — разрешение не нужно")
            except Exception as e:
                _dlog(self, f"[FAIL] overlay check: {e}")
            try:
                red = _get_tg_color("windowBackgroundWhite")
                _dlog(self, f"[OK] Theme color probe: {_int_to_hex(red)}" if red is not None
                      else "[FAIL] Theme color probe: None")
            except Exception as e:
                _dlog(self, f"[FAIL] Theme color probe: {e}")
            _dlog(self, "=== DIAGNOSTICS END ===")
            BulletinHelper.show_info("Диагностика готова — вкладка «Лог»")
        except Exception as e:
            _dlog(self, f"[CRITICAL] _run_diagnostics: {e}")
            log(f"{TAG} diagnostics: {e}\n{traceback.format_exc()}")

    def _show_debug_log(self, v=None):
        run_on_ui_thread(self._open_log_panel)

    def _open_log_panel(self):
        self._tab_idx = 4
        if self.panel_open:
            if self._minimized:
                self._set_minimized(False)
            self._select_tab(4)
        else:
            self._open_panel(self._current_chain, self._current_hooks,
                             self._current_attrs, self._current_theme_info)

    def _on_debug_toggle(self, enabled: bool):
        if enabled:
            BulletinHelper.show_info("Отладка включена — логи в logcat [HI]")
            _dlog(self, "debug_mode enabled by user")
        else:
            BulletinHelper.show_info("Отладка выключена")

    def create_settings(self) -> list:
        enabled = self._enabled
        n_hook_cls = len(HOOK_DB)
        n_hook_tot = sum(len(v) for v in HOOK_DB.values())
        n_th_cls = len(THEME_KEY_DB)
        n_th_tot = sum(len(k) for secs in THEME_KEY_DB.values() for _, k in secs)
        return [
            Header(text="Инспектор"),
            Switch(
                key="inspector_enabled",
                text="Режим инспектора",
                default=False,
                subtext="Тапните по любому элементу интерфейса — откроется панель с классом, "
                        "хуками и ключами темы.",
                icon="msg_search",
                on_change=self._on_inspector_toggle,
                link_alias="inspector_toggle",
            ),
            Text(
                text="Сейчас включён — тапайте по элементам" if enabled else "Сейчас выключен",
                icon="msg_info",
                accent=enabled,
            ),
            Divider(),

            Header(text="Анализ"),
            Selector(
                key="hierarchy_depth",
                text="Глубина иерархии",
                default=1,
                items=["3 уровня", "5 уровней (рекомендуется)", "10 уровней"],
                icon="msg_forward",
                link_alias="hierarchy_depth",
            ),
            Switch(
                key="show_only_known",
                text="Пропускать неизвестные классы",
                default=False,
                subtext="Не открывать панель, если класса нет в базе хуков.",
                icon="msg_filter",
                link_alias="skip_unknown",
            ),
            Divider(),

            Header(text="Окно"),
            Selector(
                key="opacity",
                text="Непрозрачность панели",
                default=0,
                items=["100%", "92%", "84%", "75%"],
                icon="msg_theme",
                on_change=self._on_opacity_change,
                link_alias="panel_opacity",
            ),
            Text(
                text="Сбросить позицию и размер окна",
                icon="msg_retract",
                on_click=self._reset_pos,
                red=True,
            ),
            Divider(text="Цвета панели берутся из текущей темы Telegram."),

            Header(text="База данных"),
            Text(
                text=f"Хуки: {n_hook_cls} классов · {n_hook_tot} подсказок",
                icon="msg_info",
            ),
            Text(
                text=f"Ключи темы: {n_th_cls} классов · {n_th_tot} ключей",
                icon="msg_theme",
            ),
            Divider(text="В панели нажмите на хук — скопируется строка, удерживайте — "
                         "готовый шаблон кода."),

            Header(text="Отладка"),
            Switch(
                key="debug_mode",
                text="Режим отладки",
                default=False,
                subtext="Подробные логи в logcat с тегом [HI].",
                icon="msg_info",
                on_change=self._on_debug_toggle,
                link_alias="debug_mode",
            ),
            Text(
                text=f"Открыть лог ({len(_DEBUG_BUF)} записей)",
                icon="msg_search",
                accent=True,
                on_click=self._show_debug_log,
            ),
            Text(
                text="Запустить диагностику",
                icon="msg_info",
                on_click=self._run_diagnostics,
            ),
            Divider(text="Результат диагностики пишется во вкладку «Лог»."),
        ]


# ─────────────────────────────────────────────────────────────────────────────
#  HOOK CLASSES
#  В Chaquopy hook на базовый View ставится через V.getClass().getDeclaredMethod().
# ─────────────────────────────────────────────────────────────────────────────

def _fire_view(plugin, view, is_long: bool):
    """Общая точка входа из всех хуков (с debounce по идентичности Java-объекта)."""
    try:
        now = time.time() * 1000.0
        vid = _identity(view)
        debounce = 600 if is_long else 400
        with plugin._fire_lock:
            if now - plugin._last_fire_ms < debounce and vid == plugin._last_fire_id:
                return False
            plugin._last_fire_ms = now
            plugin._last_fire_id = vid
        run_on_ui_thread(lambda: plugin.on_view_clicked(view, is_long=is_long))
        return True
    except Exception as e:
        log(f"{TAG} _fire_view: {e}")
        return False


class _ClickHook(MethodHook):
    """performClick() — обычные кнопки с OnClickListener."""
    def __init__(self, plugin):
        self._plugin = plugin

    def before_hooked_method(self, param):
        try:
            p = self._plugin
            if not p._enabled:
                return
            view = param.thisObject
            if view is not None and not p._is_own_view(view):
                _fire_view(p, view, False)
        except Exception as e:
            log(f"{TAG} click_hook: {e}")


class _LongClickHook(MethodHook):
    """performLongClick() — долгий тап."""
    def __init__(self, plugin):
        self._plugin = plugin

    def before_hooked_method(self, param):
        try:
            p = self._plugin
            if not p._enabled:
                return
            view = param.thisObject
            if view is not None and not p._is_own_view(view):
                _fire_view(p, view, True)
        except Exception as e:
            log(f"{TAG} longclick_hook: {e}")


class _DispatchTouchHook(MethodHook):
    """
    View.dispatchTouchEvent(MotionEvent) — ловит то, что не идёт через performClick:
    кнопка отправки, canvas-кнопки, медиа. Реагируем на ACTION_UP потреблённого события.
    """
    def __init__(self, plugin):
        self._plugin = plugin
        self._pending = {}  # identity -> view (ACTION_DOWN -> ACTION_UP)

    def before_hooked_method(self, param):
        try:
            if not self._plugin._enabled:
                return
            ev = param.args[0] if param.args else None
            if ev is None or (ev.getAction() & 0xFF) != 0:
                return
            view = param.thisObject
            if view is None:
                return
            self._pending[_identity(view)] = view
            if len(self._pending) > 20:
                del self._pending[next(iter(self._pending))]
        except Exception:
            pass

    def after_hooked_method(self, param):
        try:
            p = self._plugin
            if not p._enabled:
                return
            ev = param.args[0] if param.args else None
            if ev is None or (ev.getAction() & 0xFF) != 1:
                return
            view = param.thisObject
            if view is None:
                return
            vid = _identity(view)
            try:
                consumed = bool(param.getResult())
            except Exception:
                consumed = vid in self._pending
            self._pending.pop(vid, None)
            if not consumed or p._is_own_view(view):
                return
            _fire_view(p, view, False)
        except Exception as e:
            log(f"{TAG} dispatch_touch_hook: {e}")
