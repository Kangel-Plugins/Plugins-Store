        "Hook HeaderCell.setTextColor(int) -> цвет заголовка",
    ],
    "textsettingscell": [
        "Hook TextSettingsCell.setTextAndValue(CharSequence, CharSequence, boolean) -> биндинг",
        "Hook TextSettingsCell.setTextColor(int) -> цвет текста",
        "Hook TextSettingsCell.setCanDisable(boolean) -> блокировка ячейки",
    ],
    "textcheckcell": [
        "Hook TextCheckCell.setTextAndCheck(String, boolean, boolean) -> биндинг и состояние",
        "Hook TextCheckCell.setChecked(boolean) -> смена состояния",
        "Hook TextCheckCell.setDrawCheckRipple(boolean) -> эффект нажатия",
    ],
    "shadowsectioncell": [
        "Hook ShadowSectionCell.setSize(int) -> высота разделителя секций",
    ],
    "checkbox": [
        "Hook CheckBox2.setChecked(boolean, boolean) -> состояние (с анимацией)",
        "Hook CheckBox2.setColor(int, int, int) -> цвета фона, галочки, рамки",
        "Hook CheckBox2.isChecked() -> текущее состояние",
    ],
    "switch": [
        "Hook Switch.setChecked(boolean, boolean) -> состояние переключателя",
        "Hook Switch.setOnCheckedChangeListener(Switch.OnCheckedChangeListener) -> реакция на переключение",
    ],
    "buttonwithcounterview": [
        "Hook ButtonWithCounterView.setText(CharSequence, boolean) -> текст кнопки",
        "Hook ButtonWithCounterView.setLoading(boolean) -> состояние загрузки",
        "Hook ButtonWithCounterView.setEnabled(boolean) -> блокировка кнопки",
    ],
    "rlottieimageview": [
        "Hook RLottieImageView.setAnimation(int, int, int) -> анимация из ресурса",
        "Hook RLottieImageView.playAnimation() -> запуск анимации",
        "Hook RLottieImageView.setAutoRepeat(boolean) -> зацикливание",
    ],
    "filtertabsview": [
        "Hook FilterTabsView.selectTabWithId(int, float) -> выбор папки",
        "Hook FilterTabsView.setDelegate(FilterTabsView.FilterTabsViewDelegate) -> события вкладок",
    ],
    "chatavatarcontainer": [
        "Hook ChatAvatarContainer.setTitle(CharSequence) -> заголовок чата в шапке",
        "Hook ChatAvatarContainer.setSubtitle(CharSequence) -> подзаголовок (статус, участники)",
        "Hook ChatAvatarContainer.onMeasure(int, int) -> размеры шапки",
    ],
    "chatattachalert": [
        "Hook ChatAttachAlert.show() -> открытие меню вложений",
        "Hook ChatAttachAlert.dismiss() -> закрытие меню вложений",
    ],
    "emojiview": [
        "Hook EmojiView.setVisibility(int) -> показ панели эмодзи",
        "Hook EmojiView.onMeasure(int, int) -> размеры панели",
    ],
    "videoplayer": [
        "Hook VideoPlayer.play() -> старт воспроизведения",
        "Hook VideoPlayer.pause() -> пауза",
        "Hook VideoPlayer.seekTo(long) -> перемотка",
        "Hook VideoPlayer.setVolume(float) -> громкость",
    ],
    "viewgroup": [
        "Hook ViewGroup.dispatchDraw(Canvas) -> отрисовка дочерних view",
        "Hook ViewGroup.onLayout(boolean, int, int, int, int) -> раскладка",
        "Hook ViewGroup.addView(View, int, ViewGroup.LayoutParams) -> добавление дочернего view",
        "Hook ViewGroup.onInterceptTouchEvent(MotionEvent) -> перехват тача у детей",
    ],
}

