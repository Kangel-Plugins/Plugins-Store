__id__          = "hook_inspector"
__name__        = "Hook Inspector"
__description__ = "Dev Tool: тапни любой UI-элемент — класс, ключи редактора тем, хуки, атрибуты View. Theme.getColor() с live-цветами и свотчами."
__author__      = "@LuPlugins (@lyzos)"
__version__     = "1.0"
__icon__        = "formyetgplugins_by_fStikBot/16"
__min_version__ = "12.5.1"


