__id__ = "songlinker"
__name__ = "Song Linker"
__description__ = "Converts a link into hypertext."
__author__ = "@thrzxd • @kotilnya"
__version__ = "1.0.2"
__icon__ = "Konataizumi0_by_fStikBot/6"
__app_version__ = ">=12.5.1"

PATTERNS = [
    r'open\.spotify\.com/(?:track|album|playlist|artist|user)/',
    r'music\.yandex\.(?:com|ru)/(?:album|playlists|artist)/',
    r'music\.apple\.com/(?:profile/|[^/]+/(?:album|song|artist)/)',
    r'music\.youtube\.com/',
    r'(?:on\.)?soundcloud\.com/',
    r'tidal\.com/',
    r'zvuk\.com/',
]

URL_REGEX = re.compile(
    r'(?P<full_url>(?:https?://)?(?:www\.)?(?P<platform>' + '|'.join(PATTERNS) + r')[^\s]+)',
    re.IGNORECASE,
)

GENERIC_URL_REGEX = re.compile(
    r'(?P<full_url>(?:https?://|www\.)[^\s]+|(?:[a-zA-Z0-9-]+\.)+[a-zA-Z]{2,}(?:/[^\s]*)?)',
    re.IGNORECASE,
)

SEPARATOR = "•"

