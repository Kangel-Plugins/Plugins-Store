PATTERNS = [
    r'open\.spotify\.com/(?:track|album|playlist|artist|user)/',
    r'music\.yandex\.(?:com|ru)/(?:album|playlists|artist)/',
    r'music\.apple\.com/(?:profile/|[^/]+/(?:album|song|artist)/)',
    r'music\.youtube\.com/',
    r'(?:on\.)?soundcloud\.com/',
    r'tidal\.com/',
    r'zvuk\.com/',
    r'deezer\.com(?:/[a-zA-Z]{2})?/(?:track|album|artist|playlist)/',
    r'link\.deezer\.com/s/',
    r'song\.link/',
]

MEDIA_PATTERNS = [
    r'(?:twitter|x)\.com/',
    r'pixiv\.net/',
    r'danbooru\.donmai\.us/',
    r'zerochan\.net/',
    r'unsplash\.com/',
    r'deviantart\.com/',
]

URL_REGEX = re.compile(
    r'(?P<full_url>(?:https?://)?(?:www\.)?(?P<platform>' + '|'.join(PATTERNS) + r')[^\s]+)',
    re.IGNORECASE,
)

MEDIA_URL_REGEX = re.compile(
    r'(?P<full_url>(?:https?://)?(?:www\.)?(?P<platform>' + '|'.join(MEDIA_PATTERNS) + r')[^\s]+)',
    re.IGNORECASE,
)

SEPARATOR = "•"

