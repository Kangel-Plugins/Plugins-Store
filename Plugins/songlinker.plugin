def get_language() -> str:
    try:
        return Locale.getDefault().getLanguage()
    except Exception:
        return "en"

def get_string(key: str, **kwargs: Any) -> str:
    lang = get_language()
    lang_dict = STRINGS.get(lang, STRINGS["en"])
    text = lang_dict.get(key, STRINGS["en"].get(key, key))
    if kwargs:
        try:
            return text.format(**kwargs)
        except Exception:
            return text
    return text

def get_webpage_from_params(params: Any) -> TLRPC.WebPage | None:
    webpage = getattr(params, "webPage", None)
    if not webpage and getattr(params, "mediaWebPage", None):
        webpage = getattr(params.mediaWebPage, "webpage", None)
    return webpage

def is_webpage_loaded(webpage: Any) -> bool:
    return bool(webpage) and not isinstance(webpage, (TLRPC.TL_webPagePending, TLRPC.TL_webPageEmpty))

def get_webpage_media_from_params(params: Any) -> TLRPC.TL_messageMediaWebPage | None:
    media = getattr(params, "mediaWebPage", None)
    if isinstance(media, TLRPC.TL_messageMediaWebPage):
        return media
    return None

def get_force_small_media(params: Any) -> bool:
    media = get_webpage_media_from_params(params)
    return bool(getattr(media, "force_small_media", False)) if media else False

def set_force_small_media(params: Any, small: bool = True) -> TLRPC.TL_messageMediaWebPage | None:
    media = getattr(params, "mediaWebPage", None)
    if not media and getattr(params, "webPage", None):
        media = TLRPC.TL_messageMediaWebPage()
        media.webpage = params.webPage
        params.mediaWebPage = media

    if media:
        media.force_small_media = small
        media.force_large_media = not small

    return media

def to_list(java_or_py_list: Any) -> list:
    if java_or_py_list is None:
        return []
    if hasattr(java_or_py_list, "size") and callable(java_or_py_list.size):
        try:
            count = int(java_or_py_list.size())
            return [java_or_py_list.get(i) for i in range(count)]
        except Exception:
            pass
    try:
        return list(java_or_py_list)
    except Exception:
        return []

def get_utf16_length(text: str) -> int:
    return len(text.encode("utf-16-le")) // 2

def normalize_link(url: str) -> str:
    url = url.strip()
    url = re.sub(r'^https?://', '', url, flags=re.IGNORECASE)
    url = re.sub(r'^www\.', '', url, flags=re.IGNORECASE)
    url = url.rstrip('/')
    return url.lower()

def is_url_excluded(url: str, exceptions_str: str) -> bool:
    if not exceptions_str or not exceptions_str.strip():
        return False
    raw_items = re.split(r'[,;\n]+', exceptions_str)
    target = normalize_link(url)
    for raw_item in raw_items:
        exc = normalize_link(raw_item)
        if not exc:
            continue
        if target == exc or target.startswith(exc + '/') or target.startswith(exc + '?') or target.startswith(exc + '#'):
            return True
    return False

class SongLinkerPlugin(BasePlugin):
    def on_plugin_load(self):
        self.add_on_send_message_hook()
        self.log("plugin loaded")

    def on_send_message_hook(self, account: int, params: Any) -> HookResult:
        message = None
        text_prop = "message"
        
        if hasattr(params, "message") and isinstance(params.message, str) and params.message:
            message = params.message
            text_prop = "message"
        elif hasattr(params, "caption") and isinstance(params.caption, str) and params.caption:
            message = params.caption
            text_prop = "caption"
            
        if not message:
            return HookResult()
            
        apply_to_media_platforms = bool(self.get_setting("apply_to_media_platforms", False))

        matched = self.find_matched_url(message)
        media_platform_matched = None
        if not matched and apply_to_media_platforms:
            media_platform_matched = self.find_media_url(message)

        if not matched and not media_platform_matched:
            return HookResult()

        if media_platform_matched and not matched:
            full_url, platform, start, end = media_platform_matched

            webpage_metadata = self.extract_metadata(params)
            if not webpage_metadata and bool(self.get_setting("fetch_metadata", False)):
                self.log(f"No preview, fetching metadata via API for {full_url}")
                webpage_metadata = self.fetch_metadata_via_api(full_url, account)
            if not webpage_metadata:
                return HookResult()

            url_title, url_desc = webpage_metadata

            webpage = get_webpage_from_params(params)
            webpage_url = getattr(webpage, "url", None) if webpage else None
            target_url = str(webpage_url) if webpage_url else full_url
            
            raw_separator = self.get_setting("separator", SEPARATOR)
            separator = raw_separator if raw_separator else SEPARATOR
            swap_order = bool(self.get_setting("swap_order", False))
            display_platform_name = bool(self.get_setting("display_platform_name", False))
            platform_name = self.get_platform_name(platform) if display_platform_name else ""

            metadata = self.parse_media_platform_info(platform, url_title, url_desc, target_url)
            if isinstance(metadata, tuple):
                title, authors = metadata
                label = self.format_label(separator, title, authors, swap_order=swap_order, platform=platform_name)
            else:
                label = self.format_label(separator, str(metadata), "", swap_order=swap_order, platform=platform_name)

            if bool(self.get_setting("always_lowercase", False)):
                label = label.lower()

            if self.apply_hyperlink(params, label, target_url, start, end, text_prop):
                self.log(f"Media platform hyperlink: {label} -> {target_url}")
                if bool(self.get_setting("small_link_preview", False)):
                    if not self.is_small_preview_excluded(target_url):
                        self.apply_force_small_media(params)
                return HookResult(strategy=HookStrategy.MODIFY, params=params)
            return HookResult()

        full_url, platform, start, end = matched

        webpage_metadata = self.extract_metadata(params)
        if not webpage_metadata and bool(self.get_setting("fetch_metadata", False)):
            self.log(f"No preview, fetching metadata via API for {full_url}")
            webpage_metadata = self.fetch_metadata_via_api(full_url, account)
        if not webpage_metadata:
            return HookResult()

        url_title, url_desc = webpage_metadata

        webpage = get_webpage_from_params(params)
        webpage_url = getattr(webpage, "url", None) if webpage else None
        target_url = str(webpage_url) if webpage_url else full_url

        metadata = self.parse_info(platform, url_title, url_desc)
        raw_separator = self.get_setting("separator", SEPARATOR)
        separator = raw_separator if raw_separator else SEPARATOR
        swap_order = bool(self.get_setting("swap_order", False))
        display_platform_name = bool(self.get_setting("display_platform_name", False))
        platform_name = self.get_platform_name(platform) if display_platform_name else ""

        if isinstance(metadata, tuple):
            title, authors = metadata
            label = self.format_label(separator, title, authors, swap_order=swap_order, platform=platform_name)
        else:
            label = self.format_label(separator, str(metadata), "", swap_order=swap_order, platform=platform_name)

        if bool(self.get_setting("always_lowercase", False)):
            label = label.lower()

        if self.apply_hyperlink(params, label, target_url, start, end, text_prop):
            self.log(f"Formatted message with hyperlink: {label} -> {target_url}")
            if bool(self.get_setting("small_link_preview", False)):
                if not self.is_small_preview_excluded(target_url):
                    self.apply_force_small_media(params)
                    self.log("Applied force small media preview")
                else:
                    self.log(f"URL {target_url} excluded from small preview")
            return HookResult(strategy=HookStrategy.MODIFY, params=params)

        return HookResult()

    def extract_metadata(self, params: Any) -> tuple[str, str] | None:
        webpage = get_webpage_from_params(params)

        if not is_webpage_loaded(webpage):
            self.log("webpage preview is not loaded yet or empty")
            return None

        raw_title = getattr(webpage, "title", None) or getattr(webpage, "site_name", None)
        if not raw_title:
            self.log("webpage has no title or site_name")
            return None

        raw_desc = getattr(webpage, "description", None) or ""

        return str(raw_title), str(raw_desc)

    def apply_hyperlink(self, params: Any, label: str, raw_url: str, start: int, end: int, text_prop: str = "message") -> bool:
        if not raw_url.startswith(("http://", "https://")):
            raw_url = f"https://{raw_url}"

        message = getattr(params, text_prop, None)
        if not isinstance(message, str) or start < 0 or end > len(message) or start >= end:
            return False

        try:
            link_offset = get_utf16_length(message[:start])
            old_len = get_utf16_length(message[start:end])
            new_len = get_utf16_length(label)
            diff = new_len - old_len

            setattr(params, text_prop, message[:start] + label + message[end:])

            url_entity = TLRPC.TL_messageEntityTextUrl()
            url_entity.offset = int(link_offset)
            url_entity.length = int(new_len)
            url_entity.url = str(raw_url)

            entities_list: List[Any] = []
            raw_entities = getattr(params, "entities", None)
            for entity in to_list(raw_entities):
                ent_offset = int(getattr(entity, "offset", 0))
                ent_length = int(getattr(entity, "length", 0))
                ent_end = ent_offset + ent_length

                is_url = isinstance(entity, (TLRPC.TL_messageEntityUrl, TLRPC.TL_messageEntityTextUrl)) or (
                    "messageEntityUrl" in type(entity).__name__ or "messageEntityTextUrl" in type(entity).__name__
                )
                if ent_offset == link_offset and ent_length == old_len and is_url:
                    continue

                if ent_end <= link_offset:
                    entities_list.append(entity)
                elif ent_offset >= link_offset + old_len:
                    entity.offset = int(ent_offset + diff)
                    entities_list.append(entity)
                elif ent_offset <= link_offset and ent_end >= link_offset + old_len:
                    entity.length = int(ent_length + diff)
                    entities_list.append(entity)
                else:
                    if ent_offset < link_offset:
                        entity.length = int(max(0, link_offset - ent_offset))
                        entities_list.append(entity)
                    elif ent_offset < link_offset + old_len:
                        overlap = (link_offset + old_len) - ent_offset
                        entity.offset = int(link_offset + new_len)
                        entity.length = int(max(0, ent_length - overlap))
                        if entity.length > 0:
                            entities_list.append(entity)

            entities_list.append(url_entity)
            entities_list.sort(key=lambda e: getattr(e, "offset", 0))

            new_entities = ArrayList()
            for e in entities_list:
                new_entities.add(e)
            params.entities = new_entities

            return True
        except Exception as e:
            self.log(f"Error while formatting hyperlink: {e}")
            return False

    def fetch_metadata_via_api(self, url: str, account: int, timeout: float = 10.0) -> tuple[str, str] | None:
        if not url.startswith(("http://", "https://")):
            url = f"https://{url}"

        req = None
        # Try legacy method first (older API layers)
        try:
            req = TLRPC.TL_messages_getWebPagePreview()
            req.message = url
            self.log("Using TL_messages_getWebPagePreview")
        except (AttributeError, Exception):
            pass

        # Fall back to newer method (layer 178+)
        if req is None:
            try:
                req = TLRPC.TL_messages_getWebPage()
                req.url = url
                req.hash = 0
                self.log("Using TL_messages_getWebPage")
            except (AttributeError, Exception) as e:
                self.log(f"No suitable getWebPage method found: {e}")
                return None

        event = threading.Event()
        result = {"webpage": None}

        class Delegate(dynamic_proxy(RequestDelegate)):
            def run(self, response, error):
                if error is None and response is not None:
                    # TL_messages_getWebPagePreview returns TL_messageMediaWebPage
                    if isinstance(response, TLRPC.TL_messageMediaWebPage):
                        result["webpage"] = response.webpage
                    # TL_messages_getWebPage returns an object with a .webpage field
                    elif hasattr(response, "webpage"):
                        result["webpage"] = response.webpage
                event.set()

        try:
            ConnectionsManager.getInstance(account).sendRequest(req, Delegate())
        except Exception as e:
            self.log(f"Failed to send request: {e}")
            return None

        if not event.wait(timeout):
            self.log("getWebPage request timed out")
            return None

        webpage = result["webpage"]
        if not webpage or isinstance(webpage, (TLRPC.TL_webPagePending, TLRPC.TL_webPageEmpty)):
            self.log("API returned empty or pending webpage")
            return None

        raw_title = getattr(webpage, "title", None) or getattr(webpage, "site_name", None)
        if not raw_title:
            self.log("API webpage has no title or site_name")
            return None

        raw_desc = getattr(webpage, "description", None) or ""
        self.log(f"API fetched metadata: title='{raw_title}', desc='{raw_desc[:60]}...'")
        return str(raw_title), str(raw_desc)

    def is_small_preview_excluded(self, url: str) -> bool:
        raw_exceptions = str(self.get_setting("small_preview_exceptions", ""))
        return is_url_excluded(url, raw_exceptions)

    def apply_force_small_media(self, params: Any) -> None:
        webpage = get_webpage_from_params(params)
        if not is_webpage_loaded(webpage):
            return
        res = set_force_small_media(params, small=True)
        if res:
            self.log("Set force_small_media=True on mediaWebPage")

    def find_matched_url(self, message: str) -> tuple[str, str, int, int] | None:
        match = URL_REGEX.search(message)
        if not match:
            return None
        raw_full = match.group("full_url")
        full_url = raw_full.rstrip(".,;:!?)\"'>")
        platform = match.group("platform")
        start = match.start("full_url")
        end = start + len(full_url)
        return full_url, platform, start, end


    def find_media_url(self, message: str) -> tuple[str, str, int, int] | None:
        match = MEDIA_URL_REGEX.search(message)
        if not match:
            return None
        raw_full = match.group("full_url")
        full_url = raw_full.rstrip(".,;:!?)\"\'>")  
        platform = match.group("platform")
        start = match.start("full_url")
        end = start + len(full_url)
        return full_url, platform, start, end

    def find_matched_prefix(self, url: str) -> str | None:
        match = URL_REGEX.search(url)
        return match.group("platform") if match else None

    def format_label(self, separator: str, title: str, authors: str = "", swap_order: bool = False, platform: str = "") -> str:
        if not authors:
            label = f"{title}"
        else:
            first, second = (authors, title) if swap_order else (title, authors)
            sep = separator.strip()
            if not sep:
                label = f"{first} {second}"
            else:
                label = f"{first} {sep} {second}"

        if platform:
            label = f"{label} | {platform}"

        return label

    def format_divider_hint(self, separator: str, swap_order: bool = False, display_platform_name: bool = False, always_lowercase: bool = False) -> str:
        lang = get_language()
        if lang == "ru":
            prefix = "Пример: "
            title = "Название"
            author = "Автор"
            platform = "Платформа"
        else:
            prefix = "Example: "
            title = "Title"
            author = "Author"
            platform = "Platform"

        platform_str = platform if display_platform_name else ""
        label = self.format_label(separator, title, author, swap_order=swap_order, platform=platform_str)
        if always_lowercase:
            label = label.lower()
        return f"{prefix}{label}."

    def get_platform_name(self, platform: str) -> str:
        if not platform or not isinstance(platform, str):
            return ""

        p = platform.lower()
        is_ru = get_language() == "ru"

        if "spotify" in p:
            return "Spotify"
        if "yandex" in p:
            return "Яндекс Музыка" if is_ru else "Yandex Music"
        if "apple" in p:
            return "Apple Music"
        if "youtube" in p:
            return "YouTube Music"
        if "soundcloud" in p:
            return "SoundCloud"
        if "tidal" in p:
            return "Tidal"
        if "zvuk" in p:
            return "Звук" if is_ru else "Zvuk"
        if "deezer" in p:
            return "Deezer"
        if "song.link" in p:
            return "song.link"

        if "twitter" in p:
            return "Twitter"
        if "x.com" in p:
            return "X"
        if "pixiv" in p:
            return "Pixiv"
        if "danbooru" in p:
            return "Danbooru"
        if "zerochan" in p:
            return "Zerochan"
        if "unsplash" in p:
            return "Unsplash"
        if "deviantart" in p:
            return "DeviantArt"

        return ""

    def parse_info(self, platform: str, url_title: str, url_description: str = ""):
        match platform:
            case "open.spotify.com/track/" | "music.yandex.com/album/" | "music.yandex.ru/album/":
                if platform == "open.spotify.com/track/":
                    sections = url_description.split("·") 
                else:
                    sections = url_description.split("•")

                title = url_title
                authors = sections[0].strip()

                return title, authors

            case "open.spotify.com/album/": 
                sections_title = re.split(r'\s+[-–—−]\s+', url_title)
                # "Back-off! - Single by junoes | Spotify" 
                # -> ['Back-off!', 'Single by junoes | Spotify']

                title = sections_title[0]

                sections_desc = url_description.split("·")
                authors = sections_desc[0].strip()

                return title, authors

            case "music.apple.com/ru/album/" | "music.apple.com/ru/song/":
                # "Альбом «Album Name - Single» (Author) в Apple Music"
                # "Песня «Track Name» (Author 1, Author 2, ...) в Apple Music"

                title_matches = re.findall(r'«([^»]*)»', url_title)           # extract all from '«»'
                authors_matches = re.findall(r'»\s*\(([^)]*)\)', url_title)   # extract all from '()'

                sections = re.split(r'\s+[-–—−]\s+', " ".join(title_matches)) 

                if len(sections) > 1:
                    cleared_title = re.split(r'\s+[-–—−]\s+', " ".join(title_matches))   
                    title = cleared_title[0]  # remove 'Single' or 'EP'
                else:
                    title = " ".join(title_matches)
                    
                authors = " ".join(authors_matches)

                return title, authors

            case "music.apple.com/us/album/" | "music.apple.com/us/song/":
                # "Album Name - Single by Artist on Apple Music"
                # or "Album Name by Artist on Apple Music"
                # "Track Name by Artist 1, Artist 2 on Apple Music"

                clean_title = re.sub(r'\s+on\s+Apple\s+Music$', '', url_title, flags=re.IGNORECASE).strip()
                by_matches = re.findall(r'\s+by\s+', clean_title, flags=re.IGNORECASE)

                if len(by_matches) == 1:
                    raw_title, raw_author = re.split(r'\s+by\s+', clean_title, maxsplit=1, flags=re.IGNORECASE)
                    title = re.sub(r'\s+[-–—−]\s+(?:Single|EP)$', '', raw_title, flags=re.IGNORECASE).strip()
                    author = raw_author.strip()
                    return title, author
                return clean_title

            case "music.apple.com/us/playlist/" | "music.apple.com/ru/playlist/":
                # ru: Плейлист «Playlist Name» в Apple Music
                # en: PLaylist Name on Apple Music
                match = re.findall(r'«([^»]*)»', url_title) 
                if match:
                    title = " ".join(match)
                else:
                    title = re.sub(r'\s+on\s+Apple\s+Music$', '', url_title, flags=re.IGNORECASE).strip()

                return title

            case "tidal.com/":
                sections = re.split(r'\s+[-–—−]\s+', url_title) 
                if len(sections) > 1:
                    title = sections[1]
                    authors = sections[0]

                    return title, authors
                else:
                    return url_title
                
            case "zvuk.com/":
                sections = re.split(r'\s+[-–—−]\s+', url_title) 
                if len(sections) > 1:
                    title = sections[0]
                    return title
                else:
                    return url_title

            case "deezer.com/track/" | "deezer.com/album/" | "link.deezer.com/s/" | "deezer.com/playlist/":
                title = url_title
                authors = url_description
                return title, authors

            case "deezer.com/artist":
                title = url_title
                return title

            case "song.link/":
                by_matches = re.findall(r'\s+by\s+', url_title, flags=re.IGNORECASE)
                if len(by_matches) == 1:
                    raw_title, raw_author = re.split(r'\s+by\s+', url_title, maxsplit=1, flags=re.IGNORECASE)
                    title = re.sub(r'\s+[-–—−]\s+(?:Single|EP)$', '', raw_title, flags=re.IGNORECASE).strip()
                    author = raw_author.strip()
                    return title, author
                return url_title
    
            case _:
                return url_title # fallback

    def parse_media_platform_info(self, platform: str, url_title: str, url_description: str = "", url: str = ""):
        p = platform.lower()

        if 'twitter.com/' in p or 'x.com/' in p:
            # "Display Name (@handle) on X"
            # or "Display Name on X" (no handle)
            author = re.sub(r'\s+on\s+X$', '', url_title, flags=re.IGNORECASE).strip()
            author = re.sub(r'\s*\(@[^)]+\)$', '', author).strip()

            is_status = '/status/' in url.lower()
            use_post_text = bool(self.get_setting("twitter_post_text", False))

            if is_status and use_post_text and url_description:
                desc = html.unescape(url_description)
                desc = re.sub(r'\s+', ' ', desc).strip()
                desc = desc.lstrip('“"\'«').strip()
                desc = re.sub(r'^(?:@[\w_]+[,\s:]*)+', '', desc).strip()
                desc = desc.lstrip('“"\'«').strip()
                desc = desc.rstrip('”"\'»').strip()

                is_fallback_profile = bool(re.search(r'\(@[\w_]+\)\s+on\s+X$', desc, re.IGNORECASE))
                if desc and not is_fallback_profile and desc != url_title:
                    return desc

            return author if author else url_title

        if 'pixiv.net/' in p:
            # Artwork: "tag1, tag2 / September 5th, 2026 - pixiv"
            #   -> strip date and " - pixiv", keep tags part
            cleaned = re.sub(r'\s*-\s*pixiv$', '', url_title, flags=re.IGNORECASE).strip()
            cleaned = re.sub(
                r'\s*/\s*(?:January|February|March|April|May|June|July|August|September|October|November|December)'
                r'\s+\d{1,2}(?:st|nd|rd|th)?,?\s*\d{4}$',
                '', cleaned, flags=re.IGNORECASE
            ).strip()
            return cleaned if cleaned else url_title

        if 'danbooru.donmai.us/' in p:
            # "char_name (series) drawn by artist_name | Danbooru"
            title_clean = re.sub(r'\s*\|\s*Danbooru\s*$', '', url_title, flags=re.IGNORECASE).strip()
            m = re.match(r'^(.+?)\s+drawn\s+by\s+(.+)$', title_clean, re.IGNORECASE)
            if m:
                subject = m.group(1).strip()
                artist = m.group(2).strip()
                
                return subject, artist
            return title_clean if title_clean else url_title

        if 'zerochan.net/' in p:
            # "Series Image by Author #id - Zerochan Anime Image Board"
            title_clean = re.sub(
                r'\s*-\s*Zerochan(?:\s+Anime\s+Image\s+Board)?\s*$', '',
                url_title, flags=re.IGNORECASE
            ).strip()

            title_clean = re.sub(r'\s*#\d+$', '', title_clean).strip()

            # "Series Image by Author"
            m_by = re.match(r'^(.+?)\s+(?:Image\s+)?by\s+(.+)$', title_clean, re.IGNORECASE)
            if m_by:
                series = m_by.group(1).strip()
                author = m_by.group(2).strip()

                if re.match(r'^Pixiv\s+ID\s+\d+$', author, re.IGNORECASE):
                    return series
                return series, author

            parts = [p.strip() for p in title_clean.split(' - ') if p.strip()]
            if len(parts) >= 2:
                char = parts[0]
                series = parts[-1]
                return char, series

            return title_clean if title_clean else url_title

        if 'unsplash.com/' in p:
            # Photo page:   "Photo by Author on Unsplash"
            # Profile: "Name (@handle) | Unsplash Photo Community"
            m_profile = re.match(
                r'^(.+?)\s*\(@[^)]+\)\s*\|\s*Unsplash',
                url_title, re.IGNORECASE
            )
            if m_profile:
                return m_profile.group(1).strip()

            m_photo = re.match(
                r'^[Pp]hoto\s+by\s+(.+?)\s+on\s+Unsplash$',
                url_title, re.IGNORECASE
            )
            if m_photo:
                author = m_photo.group(1).strip()
                return author
            cleaned = re.sub(r'\s*\|\s*Unsplash.*$', '', url_title, flags=re.IGNORECASE).strip()
            return cleaned if cleaned else url_title

        if 'deviantart.com/' in p:
            # Artwork / Collection: "Title by Author on DeviantArt"
            # User profile:         "Author on DeviantArt" or "Author | DeviantArt"
            # Gallery / Favourites: "Author's Gallery on DeviantArt", "Author's Favourites on DeviantArt"
            # About page:           "About Author | DeviantArt"
            # Tagline:              "Author - Tagline | DeviantArt"
            cleaned = re.sub(r'\s+(?:on|\|)\s+DeviantArt$', '', url_title, flags=re.IGNORECASE).strip()
            m = re.match(r'^(.*?)\s+by\s+([^/]+)$', cleaned, flags=re.IGNORECASE)
            if m:
                title = m.group(1).strip()
                author = m.group(2).strip()
                if title and author:
                    return title, author
            return cleaned if cleaned else url_title

        # fallback
        return url_title

    def show_about_dialog(self, *args: Any, **kwargs: Any) -> None:
        self.log("Opening about dialog")
        view = args[0] if args else None
        context = None
        if view and hasattr(view, "getContext"):
            context = view.getContext()
        if not context:
            fragment = get_last_fragment()
            if fragment:
                context = fragment.getParentActivity() or fragment.getContext()
        if not context:
            self.log("Failed to obtain context for dialog")
            return

        try:
            builder = AlertDialogBuilder(context)
            builder.set_title("Song Linker")
            builder.set_message(get_string("about_dialog_message"))
            builder.set_positive_button(
                "OK",
                lambda *b_args: b_args[0].dismiss() if b_args else None,
            )
            builder.show()
        except Exception as e:
            self.log(f"Error displaying about dialog: {e}")

    def _on_small_preview_change(self, *args: Any) -> None:
        value = bool(args[0]) if args else False
        self.log(f"small_link_preview changed to {value}")
        self.set_setting("small_link_preview", value, reload_settings=True)


    def _on_apply_to_media_platforms_change(self, *args: Any) -> None:
        value = bool(args[0]) if args else False
        self.log(f"apply_to_media_platforms changed to {value}")
        self.set_setting("apply_to_media_platforms", value, reload_settings=True)

    def create_settings(self) -> List[Any]:
        current_sep = self.get_setting("separator", SEPARATOR)
        sep_display = current_sep.strip() if current_sep and current_sep.strip() else SEPARATOR
        swap_order = bool(self.get_setting("swap_order", False))
        display_platform_name = bool(self.get_setting("display_platform_name", False))
        always_lowercase = bool(self.get_setting("always_lowercase", False))
        small_link_preview = bool(self.get_setting("small_link_preview", False))
        apply_to_media_platforms = bool(self.get_setting("apply_to_media_platforms", False))

        divider_text = self.format_divider_hint(
            separator=sep_display,
            swap_order=swap_order,
            display_platform_name=display_platform_name,
            always_lowercase=always_lowercase,
        )

        items = [
            Header(text=get_string("settings_header")),
            Switch(
                key="swap_order",
                text=get_string("swap_order_title"),
                default=swap_order,
                icon="msg_forward_replace",
            ),
            Switch(
                key="display_platform_name",
                text=get_string("display_platform_name_title"),
                default=display_platform_name,
                icon="msg_link",
            ),
            Switch(
                key="always_lowercase",
                text=get_string("always_lowercase_title"),
                default=always_lowercase,
                icon="iv_text",
            ),
            Input(
                key="separator",
                text=get_string("separator_title"),
                default=self.get_setting("separator", SEPARATOR),
                subtext=get_string("separator_sub"),
                icon="msg_edit",
            ),
            Divider(
                text=divider_text,
            ),
        ]
        items.extend([
            Header(text=get_string("link_preview_header")),
            Switch(
                key="small_link_preview",
                text=get_string("force_small_preview"),
                default=small_link_preview,
                subtext=get_string("force_small_preview_sub"),
                icon="msg_link2",
                on_change=self._on_small_preview_change,
            ),
        ])

        if small_link_preview:
            items.extend([
                EditText(
                    key="small_preview_exceptions",
                    hint=get_string("small_preview_exceptions_hint"),
                    default=self.get_setting("small_preview_exceptions", ""),
                    multiline=True,
                    max_length=2000,
                ),
                Divider(
                    text=get_string("small_preview_exceptions_divider_hint"),
                ),
            ])

        items.extend([
            Header(text=get_string("additional_header")),
            Switch(
                key="apply_to_media_platforms",
                text=get_string("apply_to_media_platforms"),
                default=apply_to_media_platforms,
                subtext=get_string("apply_to_media_platforms_sub"),
                icon="msg_photos",
                on_change=self._on_apply_to_media_platforms_change,
            ),
        ])

        if apply_to_media_platforms:
            items.extend([
                Switch(
                    key="twitter_post_text",
                    text=get_string("twitter_post_text_title"),
                    default=bool(self.get_setting("twitter_post_text", False)),
                    subtext=get_string("twitter_post_text_sub"),
                    icon="msg_share",
                ),
            ])

        items.extend([
            Switch(
                key="fetch_metadata",
                text=get_string("fetch_metadata_title"),
                default=bool(self.get_setting("fetch_metadata", False)),
                subtext=get_string("fetch_metadata_sub"),
                icon="msg_download",
            ),
        ])

        items.extend([
            Header(text=get_string("info_header")),
            Text(
                text=get_string("about_title"),
                icon="msg_info",
                accent=True,
                on_click=self.show_about_dialog,
            ),
        ])

        return items