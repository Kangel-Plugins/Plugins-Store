from android_utils import log
from base_plugin import BasePlugin, MethodHook
from java import cast, jclass, jint
from java.lang import Class

__id__ = "instant_tab_switch"
__name__ = "Instant Tab Switch"
__description__ = "Мгновенное переключение вкладки нижней панели при перетаскивании пальца, без ожидания отпускания."
__author__ = "@akresik"
__version__ = "1.0.0"
__icon__ = "Clawde/68"
__min_version__ = "12.10.6"
__category__ = ["appearance"]

def find_field_value(obj, name):
    try:
        cls = obj.getClass()
        while cls is not None:
            for field in cls.getDeclaredFields():
                if field.getName() == name:
                    field.setAccessible(True)
                    return field.get(obj)
            cls = cls.getSuperclass()
        return None
    except Exception as e:
        log(f"[ITS] find_field_value error: {e}")
        return None

def call_int_method(obj, name, *args):
    try:
        cls = obj.getClass()
        while cls is not None:
            for method in cls.getDeclaredMethods():
                if method.getName() == name and len(method.getParameterTypes()) == len(args):
                    method.setAccessible(True)
                    return int(method.invoke(obj, *[jint(a) for a in args]))
            cls = cls.getSuperclass()
        return None
    except Exception as e:
        log(f"[ITS] call_int_method error: {e}")
        return None

class LongMoveHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            self.plugin.handle_long_move(param.thisObject, bool(param.args[2]), bool(param.args[3]))
        except Exception as e:
            log(f"[ITS] LongMoveHook error: {e}")

class ActivityHook(MethodHook):
    def __init__(self, plugin, reconcile):
        self.plugin = plugin
        self.reconcile = reconcile

    def after_hooked_method(self, param):
        try:
            self.plugin.activity = param.thisObject
            if self.reconcile:
                self.plugin.reconcile()
        except Exception as e:
            log(f"[ITS] ActivityHook error: {e}")

class InstantTabSwitch(BasePlugin):
    def on_plugin_load(self):
        try:
            self.last_clicked = None
            self.clicked_in_gesture = False
            self.target = None
            self.attempts = 0
            self.activity = None
            layout_class = Class.forName("org.telegram.ui.MainTabsLayout")
            self.selected_field = layout_class.getDeclaredField("lastLongSelectedView")
            self.selected_field.setAccessible(True)
            self.hook_all_methods(layout_class, "checkLongMove", LongMoveHook(self))
            activity_class = Class.forName("org.telegram.ui.MainTabsActivity")
            self.hook_all_methods(activity_class, "selectTab", ActivityHook(self, False))
            self.hook_all_methods(activity_class, "onViewPagerScrollEnd", ActivityHook(self, True))
        except Exception as e:
            log(f"[ITS] on_plugin_load error: {e}")

    def click_tab(self, tab):
        try:
            cast(jclass("android.view.View"), tab).performClick()
        except Exception as e:
            log(f"[ITS] click_tab error: {e}")

    def reconcile(self):
        try:
            activity = self.activity
            target = self.target
            if activity is None or target is None:
                return
            if self.attempts >= 4:
                self.target = None
                return
            pager = find_field_value(activity, "viewPager")
            tabs = activity.tabs
            target_position = None
            for i in range(len(tabs)):
                if tabs[i] == target:
                    target_position = call_int_method(activity, "indexToPosition", i)
                    break
            if pager is None or target_position is None:
                self.target = None
                return
            if call_int_method(pager, "getCurrentPosition") == target_position:
                self.target = None
                return
            self.attempts += 1
            self.click_tab(target)
        except Exception as e:
            log(f"[ITS] reconcile error: {e}")

    def handle_long_move(self, layout, start, end):
        try:
            found = self.selected_field.get(layout)
            if start:
                self.last_clicked = found
                self.clicked_in_gesture = False
                self.target = None
                self.attempts = 0
                return
            if end:
                if self.clicked_in_gesture and found is not None:
                    self.target = found
                    self.selected_field.set(layout, None)
                    self.reconcile()
                self.last_clicked = None
                self.clicked_in_gesture = False
                return
            if found is not None and found != self.last_clicked:
                self.last_clicked = found
                self.clicked_in_gesture = True
                self.target = found
                self.attempts = 0
                self.click_tab(found)
        except Exception as e:
            log(f"[ITS] handle_long_move error: {e}")