__id__ = "PremiumDialogCards"
__name__ = "Premium Dialog Cards"
__author__ = "@nneeuurr"
__version__ = "2.1.1"
__description__ = "Современный дизайн карточек чатов. Только для тёмной темы."
__min_version__ = "12.5.1"
__icon__ = "msg_theme"

import time
import weakref
import threading
from concurrent.futures import ThreadPoolExecutor

from base_plugin import BasePlugin, MethodHook
from hook_utils import find_class
from android_utils import log

from android.graphics import (
    Bitmap, LinearGradient, Paint, Shader, Matrix, BitmapShader, Canvas
)
from android.graphics.drawable import BitmapDrawable
from org.telegram.messenger import AndroidUtilities, Utilities
from ui.settings import Header, Switch, Input

try:
    from java.lang import System, Integer, Long
except:
    System = find_class("java.lang.System")
    Integer = None
    Long = None

try:
    from java import jarray, jint, jlong
except:
    jarray = None
    jint = None
    jlong = None

def to_signed32(value):
    v = int(value) & 0xFFFFFFFF
    return v - 0x100000000 if v >= 0x80000000 else v

DEFAULT_ROUNDING_DP = 15.0
CARD_MARGIN_X_DP = 6.0
CARD_MARGIN_Y_DP = 5.0
DEFAULT_STROKE_WIDTH_DP = 0.5
STATUS_STROKE_RATIO = 1.6
AVATAR_SCALE = 0.75

BLUR_SIZE = 90
BLUR_CACHE_LIMIT = 64
SHADER_CACHE_LIMIT = 64
CELL_STATE_LIMIT = 96
GEOMETRY_CACHE_LIMIT = 32
SOLID_PAINT_LIMIT = 64
FADE_DURATION = 0.16

SMALL_SOURCE_GRACE = 0.4
DEFAULT_STROKE_ALPHA = 24
DEFAULT_BLUR = 7
COLOR_ONLINE_FILL = 0x26B1E548
COLOR_ONLINE_BORDER = 0xFFB1E548
COLOR_BG_DARK = 0xFF141923

STATIC_AVATAR_COLORS = (
    0xFFE17076, 0xFFFAA774, 0xFFA695E7, 0xFF7BC862,
    0xFF6EC9CB, 0xFF65AADD, 0xFFEE7AEC
)

try:
    STYLE_FILL = Paint.Style.FILL
    STYLE_STROKE = Paint.Style.STROKE
    TILE_MIRROR = Shader.TileMode.MIRROR
    TILE_CLAMP = Shader.TileMode.CLAMP
    CFG_ARGB = Bitmap.Config.ARGB_8888
except:
    STYLE_FILL = None
    STYLE_STROKE = None
    TILE_MIRROR = None
    TILE_CLAMP = None
    CFG_ARGB = None

SPECIAL_COLORS = {
    "saved": (to_signed32(0xFF28184F), to_signed32(0xFF122D5B)),
    "replies": (to_signed32(0xFF0D3E44), to_signed32(0xFF1A253B)),
}

MUTED_FIELD_NAMES = ("dialogMuted", "isMuted", "muted")
AVATAR_FIELD_NAMES = ("avatarImage", "avatarImageView", "avatarDrawable")
DIALOG_ID_FIELD_NAMES = ("currentDialogId", "dialogId", "dialog_id")
SUPPRESS_FIELD_NAMES = ("drawBackground", "needBackground", "drawPinBackground", "drawClockBackground", "drawTimeBackground")
SEPARATOR_FIELD_NAMES = ("needDivider", "useSeparator", "hasDivider", "drawDivider")

_jint_cache = {}

def _make_jint(val):
    s_val = to_signed32(val)
    if jint is not None:
        try:
            return jint(s_val)
        except:
            pass
    if Integer is not None:
        try:
            return Integer(s_val)
        except:
            pass
    return s_val

def to_jint(val):
    s_val = to_signed32(val)
    cached = _jint_cache.get(s_val)
    if cached is None:
        cached = _make_jint(s_val)
        if len(_jint_cache) > 512:
            _jint_cache.clear()
        _jint_cache[s_val] = cached
    return cached

def to_jlong(val):
    ival = int(val)
    if jlong is not None:
        try:
            return jlong(ival)
        except:
            pass
    if Long is not None:
        try:
            return Long(ival)
        except:
            pass
    try:
        LongClass = find_class("java.lang.Long")
        if LongClass:
            return LongClass(ival)
    except:
        pass
    return ival

def argb_to_signed(a, r, g, b):
    val = ((a & 0xFF) << 24) | ((r & 0xFF) << 16) | ((g & 0xFF) << 8) | (b & 0xFF)
    return to_signed32(val)

def get_java_class(class_name):
    try:
        ClassClass = find_class("java.lang.Class")
        if ClassClass is None:
            return None
        return ClassClass.forName(class_name)
    except:
        try:
            ClassClass = find_class("java.lang.Class")
            ApplicationLoader = find_class("org.telegram.messenger.ApplicationLoader")
            loader = ApplicationLoader.applicationContext.getClassLoader()
            return ClassClass.forName(class_name, True, loader)
        except:
            return None

def is_image_receiver_instance(obj):
    if obj is None:
        return False
    try:
        if "ImageReceiver" in obj.getClass().getName():
            return True
        if hasattr(obj, "setImageCoords") and hasattr(obj, "draw"):
            return True
    except:
        pass
    return False

class _Geo:
    __slots__ = (
        'gid', 'w', 'h', 'epoch', 'rounding_dp',
        'left', 'top', 'right', 'bottom',
        'card_w', 'card_h', 'radius',
        'stroke_paint', 'draw_stroke',
        'cs_l', 'cs_t', 'cs_r', 'cs_b',
        'ss_l', 'ss_t', 'ss_r', 'ss_b'
    )

    def __init__(self):
        self.gid = 0
        self.w = 0
        self.h = 0
        self.epoch = -1
        self.rounding_dp = DEFAULT_ROUNDING_DP
        self.left = 0.0
        self.top = 0.0
        self.right = 0.0
        self.bottom = 0.0
        self.card_w = 0.0
        self.card_h = 0.0
        self.radius = 0.0
        self.stroke_paint = None
        self.draw_stroke = True
        self.cs_l = 0.0
        self.cs_t = 0.0
        self.cs_r = 0.0
        self.cs_b = 0.0
        self.ss_l = 0.0
        self.ss_t = 0.0
        self.ss_r = 0.0
        self.ss_b = 0.0

class _CellState:
    __slots__ = (
        'cell', 'hash', 'dialog_id', 'is_folder', 'special',
        'is_muted', 'is_online',
        'configured', 'orig_background',
        'receiver', 'avatar_orig', 'avatar_scaled',
        'entry', 'solid_paint',
        'fade_from', 'fade_start',
        'settled', 'small_since', 'bmp_id', 'image_key',
        'style_epoch', 'geo_gid', 'geo'
    )

    def __init__(self, cell, h):
        self.cell = cell
        self.hash = h
        self.dialog_id = 0
        self.is_folder = False
        self.special = None
        self.is_muted = False
        self.is_online = False
        self.configured = False
        self.orig_background = None
        self.receiver = None
        self.avatar_orig = None
        self.avatar_scaled = False
        self.entry = None
        self.solid_paint = None
        self.fade_from = None
        self.fade_start = None
        self.settled = False
        self.small_since = 0.0
        self.bmp_id = 0
        self.image_key = None
        self.style_epoch = -1
        self.geo_gid = -1
        self.geo = None

class _DialogsActivityResumeHook(MethodHook):
    def __init__(self, plugin):
        super().__init__()
        self._plugin_ref = weakref.ref(plugin)

    def after_hooked_method(self, param):
        plugin = self._plugin_ref()
        if plugin and plugin._enabled:
            try:
                plugin.suppress_pinned_overlay()
                plugin.prune_detached_cells()
            except:
                pass

class _DialogCellDrawHook(MethodHook):
    def __init__(self, plugin):
        super().__init__()
        self._plugin_ref = weakref.ref(plugin)

    def before_hooked_method(self, param):
        plugin = self._plugin_ref()
        if plugin and plugin._enabled:
            try:
                plugin.on_cell_before_draw(param)
            except:
                pass

    def after_hooked_method(self, param):
        plugin = self._plugin_ref()
        if plugin and plugin._enabled:
            try:
                cell = param.thisObject
                if cell is not None:
                    h = System.identityHashCode(cell) if System else id(cell)
                    state = plugin._cell_states.get(h)
                    if state:
                        plugin.on_cell_after_draw(param, state)
            except:
                pass

class _DialogCellIsOnlineHook(MethodHook):
    def __init__(self, plugin):
        super().__init__()
        self._plugin_ref = weakref.ref(plugin)

    def before_hooked_method(self, param):
        plugin = self._plugin_ref()
        if plugin and plugin._enabled:
            if not plugin._online_badge_cached:
                try:
                    cell = param.thisObject
                    if cell is not None:
                        dialog_id = plugin.get_dialog_id(cell)
                        if not plugin.is_archive_or_folder(cell, dialog_id):
                            param.setResult(False)
                except:
                    pass

class _DialogCellUpdateHook(MethodHook):
    def __init__(self, plugin):
        super().__init__()
        self._plugin_ref = weakref.ref(plugin)

    def before_hooked_method(self, param):
        plugin = self._plugin_ref()
        if plugin and plugin._enabled:
            try:
                plugin.on_cell_updated(param.thisObject, param.args)
            except:
                pass

class PremiumDialogCardsPlugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self._hooks = []
        self._enabled = False
        self._hook_isonline_active = False

        self._blur_cache = {}
        self._blur_order = []
        self._blur_inflight = set()
        self._shader_cache = {}
        self._shader_order = []
        self._solid_paints = {}
        self._solid_order = []
        self._placeholder_color_cache = {}

        self._cell_states = {}
        self._geometry_cache = {}
        self._geo_order = []
        self._geo_last = None
        self._geo_counter = 0
        self._dp_cache = {}
        self._static_cache = {}
        self._field_cache = {}
        self._class_profiles = {}

        self._f_avatar = None
        self._f_dialog_id = None
        self._f_user = None
        self._f_account = None
        self._f_muted = None

        self._mc_cache = {}
        self._cm_cache = {}
        self._cm_time_cache = {}

        self._lock = threading.Lock()
        self._executor = None
        self._style_epoch = 0
        self._lifecycle_generation = 0

        self._card_rounding_cached = int(DEFAULT_ROUNDING_DP)
        self._blur_radius_cached = DEFAULT_BLUR
        self._darken_percent_cached = 55
        self._stroke_width_cached = DEFAULT_STROKE_WIDTH_DP
        self._stroke_alpha_cached = DEFAULT_STROKE_ALPHA
        self._online_border_cached = False
        self._online_badge_cached = True
        self._mute_dim_cached = False
        self._mute_opacity_cached = 30
        self._mute_stroke_cached = False

        self._tint_color = None
        self._paint_fade = None
        self._paint_muted_fill = None
        self._paint_muted_stroke = None
        self._paint_online_fill = None
        self._paint_online_stroke = None

        self._orig_pinned_paint_color = None

        self._last_account = -1
        self._self_user_id = 0
        self._settled_min_w = 36
        self._invalidate_mode = 0
        self._dialogid_mode = 0
        self._imagekey_mode = 0

        self.UserConfigClass = None
        self.MessagesControllerClass = None
        self.ThemeClass = None
        self.ConnectionsManagerClass = None
        self.DialogCellClass = None
        self.DialogsActivityClass = None

    def on_plugin_load(self):
        try:
            self._teardown()
            self._lifecycle_generation += 1
            self.cache_classes()
            self.init_metrics()
            self.update_cached_settings()

            self._enabled = self._get_bool("rcards.enable", True)

            self.suppress_pinned_overlay()
            self.rebuild_paints()
            self._executor = ThreadPoolExecutor(max_workers=2)

            self.hook_dialogs_activity()
            self.hook_dialog_cell()
            self.update_isonline_hook()
            self.sync_account()
        except:
            pass

    def on_plugin_unload(self):
        try:
            self._teardown()
        except:
            pass

    def _teardown(self):
        self._enabled = False
        self._lifecycle_generation += 1

        self.restore_pinned_overlay()

        for h in self._hooks:
            try:
                self.unhook_method(h)
            except:
                pass
        self._hooks.clear()
        self._hook_isonline_active = False

        if self._executor:
            try:
                self._executor.shutdown(wait=False, cancel_futures=True)
            except:
                pass
            self._executor = None

        self.restore_all_cells()

        with self._lock:
            self._blur_cache.clear()
            self._blur_order.clear()
            self._blur_inflight.clear()
            self._shader_cache.clear()
            self._shader_order.clear()
            self._solid_paints.clear()
            self._solid_order.clear()
            self._placeholder_color_cache.clear()
            self._cell_states.clear()
            self._geometry_cache.clear()
            self._geo_order.clear()
            self._geo_last = None
            self._field_cache.clear()
            self._class_profiles.clear()
            self._mc_cache.clear()
            self._cm_cache.clear()
            self._cm_time_cache.clear()
            self._f_avatar = None
            self._f_dialog_id = None
            self._f_user = None
            self._f_account = None
            self._f_muted = None

    def cache_classes(self):
        self.UserConfigClass = get_java_class("org.telegram.messenger.UserConfig")
        self.MessagesControllerClass = get_java_class("org.telegram.messenger.MessagesController")
        self.ThemeClass = get_java_class("org.telegram.ui.ActionBar.Theme")
        self.ConnectionsManagerClass = get_java_class("org.telegram.tgnet.ConnectionsManager")
        self.DialogCellClass = get_java_class("org.telegram.ui.Cells.DialogCell")
        self.DialogsActivityClass = get_java_class("org.telegram.ui.DialogsActivity")

        if self.DialogCellClass is not None:
            self._f_avatar = self.find_first_field(self.DialogCellClass, AVATAR_FIELD_NAMES)
            self._f_dialog_id = self.find_first_field(self.DialogCellClass, DIALOG_ID_FIELD_NAMES)
            self._f_user = self.find_first_field(self.DialogCellClass, ("user",))
            self._f_account = self.find_first_field(self.DialogCellClass, ("currentAccount",))
            self._f_muted = self.find_first_field(self.DialogCellClass, MUTED_FIELD_NAMES)

    def get_messages_controller(self, acc):
        cached = self._mc_cache.get(acc)
        if cached is not None:
            return cached
        if self.MessagesControllerClass:
            try:
                cached = self.MessagesControllerClass.getInstance(acc)
                self._mc_cache[acc] = cached
                return cached
            except:
                pass
        return None

    def get_connections_manager(self, acc):
        cached = self._cm_cache.get(acc)
        if cached is not None:
            return cached
        if self.ConnectionsManagerClass:
            try:
                cached = self.ConnectionsManagerClass.getInstance(acc)
                self._cm_cache[acc] = cached
                return cached
            except:
                pass
        return None

    def get_current_time(self, acc):
        now = time.monotonic()
        cached_entry = self._cm_time_cache.get(acc)
        if cached_entry and (now - cached_entry[0] < 1.0):
            return cached_entry[1]
        cm = self.get_connections_manager(acc)
        t = cm.getCurrentTime() if cm else int(time.time())
        self._cm_time_cache[acc] = (now, t)
        return t

    def theme_field(self, name):
        if name in self._static_cache:
            return self._static_cache[name]
        val = None
        cls = self.ThemeClass
        if cls is not None:
            try:
                val = getattr(cls, name, None)
            except:
                val = None
            if val is None:
                try:
                    f = cls.getDeclaredField(name)
                    f.setAccessible(True)
                    val = f.get(None)
                except:
                    val = None
        self._static_cache[name] = val
        return val

    def dp(self, val):
        vf = float(val)
        if vf in self._dp_cache:
            return self._dp_cache[vf]
        try:
            res = AndroidUtilities.dp(vf)
            self._dp_cache[vf] = res
            return res
        except:
            return int(vf * 2.0)

    def init_metrics(self):
        self._dp_cache.clear()
        self._settled_min_w = max(32, int(self.dp(36.0)))

    def suppress_pinned_overlay(self):
        paint = self.theme_field("dialogs_pinnedPaint")
        if paint is not None:
            try:
                if self._orig_pinned_paint_color is None:
                    self._orig_pinned_paint_color = paint.getColor()
                paint.setColor(0)
            except:
                pass

    def restore_pinned_overlay(self):
        if self._orig_pinned_paint_color is not None:
            paint = self.theme_field("dialogs_pinnedPaint")
            if paint is not None:
                try:
                    paint.setColor(self._orig_pinned_paint_color)
                except:
                    pass
            self._orig_pinned_paint_color = None

    def bump_style_epoch(self):
        self._style_epoch += 1
        with self._lock:
            self._blur_cache.clear()
            self._blur_order.clear()
            self._blur_inflight.clear()
        self._geometry_cache.clear()
        self._geo_order.clear()
        self._geo_last = None
        self._shader_cache.clear()
        self._shader_order.clear()
        self._solid_paints.clear()
        self._solid_order.clear()
        self._placeholder_color_cache.clear()
        self.rebuild_paints()
        self.invalidate_all_cells()

    def rebuild_paints(self):
        p = Paint()
        p.setAntiAlias(True)
        p.setStyle(STYLE_FILL)
        self._paint_fade = p

        opacity = self._mute_opacity_cached
        muted_fill = argb_to_signed(int((100 - opacity) * 2.3), 0x22, 0x24, 0x2B)
        muted_border = argb_to_signed(int((100 - opacity) * 1.91), 0x43, 0x47, 0x53)
        status_w = float(self.dp(max(0.1, self._stroke_width_cached * STATUS_STROKE_RATIO)))

        p = Paint()
        p.setAntiAlias(True)
        p.setStyle(STYLE_FILL)
        p.setColor(to_jint(muted_fill))
        self._paint_muted_fill = p

        p = Paint()
        p.setAntiAlias(True)
        p.setStyle(STYLE_STROKE)
        p.setStrokeWidth(status_w)
        p.setColor(to_jint(muted_border))
        self._paint_muted_stroke = p

        p = Paint()
        p.setAntiAlias(True)
        p.setStyle(STYLE_FILL)
        p.setColor(to_jint(COLOR_ONLINE_FILL))
        self._paint_online_fill = p

        p = Paint()
        p.setAntiAlias(True)
        p.setStyle(STYLE_STROKE)
        p.setStrokeWidth(status_w)
        p.setColor(to_jint(COLOR_ONLINE_BORDER))
        self._paint_online_stroke = p

    def build_geometry(self, w, h):
        self._geo_counter += 1
        geo = _Geo()
        geo.gid = self._geo_counter
        geo.w = w
        geo.h = h
        geo.epoch = self._style_epoch
        geo.rounding_dp = self._card_rounding_cached

        mx = self.dp(CARD_MARGIN_X_DP)
        my = self.dp(CARD_MARGIN_Y_DP)
        geo.left = float(mx)
        geo.top = float(my)
        geo.right = float(w - mx)
        geo.bottom = float(h - my)
        geo.card_w = max(1.0, geo.right - geo.left)
        geo.card_h = max(1.0, geo.bottom - geo.top)
        geo.radius = float(self.dp(self._card_rounding_cached))

        width = self._stroke_width_cached
        stroke_alpha = int(round(255.0 * self._stroke_alpha_cached / 100.0))
        geo.draw_stroke = width > 0.0 and stroke_alpha > 0
        csw = float(self.dp(width)) if geo.draw_stroke else 0.0
        half = csw / 2.0
        geo.cs_l = geo.left + half
        geo.cs_t = geo.top + half
        geo.cs_r = geo.right - half
        geo.cs_b = geo.bottom - half

        ssw = float(self.dp(max(0.1, width * STATUS_STROKE_RATIO)))
        shalf = ssw / 2.0
        geo.ss_l = geo.left + shalf
        geo.ss_t = geo.top + shalf
        geo.ss_r = geo.right - shalf
        geo.ss_b = geo.bottom - shalf

        if geo.draw_stroke:
            stroke = Paint()
            stroke.setAntiAlias(True)
            stroke.setStyle(STYLE_STROKE)
            stroke.setStrokeWidth(csw if csw > 0.0 else 1.0)
            c_top = to_jint(argb_to_signed(stroke_alpha, 255, 255, 255))
            c_bot = to_jint(0x00FFFFFF)
            stroke.setShader(LinearGradient(0.0, float(geo.top), 0.0, float(geo.bottom), c_top, c_bot, TILE_CLAMP))
            geo.stroke_paint = stroke
        else:
            geo.stroke_paint = None
        return geo

    def get_geometry(self, w, h):
        geo = self._geo_last
        if geo is not None and geo.w == w and geo.h == h and geo.epoch == self._style_epoch and geo.rounding_dp == self._card_rounding_cached:
            return geo
        key = (w, h)
        geo = self._geometry_cache.get(key)
        if geo is None or geo.epoch != self._style_epoch or geo.rounding_dp != self._card_rounding_cached:
            geo = self.build_geometry(w, h)
            if key not in self._geometry_cache:
                self._geo_order.append(key)
            self._geometry_cache[key] = geo
            while len(self._geo_order) > GEOMETRY_CACHE_LIMIT:
                old = self._geo_order.pop(0)
                if old != key:
                    self._geometry_cache.pop(old, None)
        self._geo_last = geo
        return geo

    def _get_bool(self, key, default=False):
        try:
            v = self.get_setting(key, default)
            if v is default:
                return default
            if isinstance(v, bool):
                return v
            s = str(v).strip().lower()
            if s in ("true", "1", "yes", "on"):
                return True
            if s in ("false", "0", "no", "off"):
                return False
            return default
        except:
            return default

    def _get_int(self, key, default=0):
        try:
            v = self.get_setting(key, default)
            if v is default:
                return default
            return int(v)
        except:
            return default

    def _get_float(self, key, default=0.0):
        try:
            v = self.get_setting(key, default)
            if v is default:
                return default
            return float(str(v).strip().replace(",", "."))
        except:
            return default

    def _on_setting_changed(self, key, value):
        try:
            self.set_setting(key, value)
            self._apply_settings_change(hard=(key == "rcards.enable"))
        except:
            pass

    def _on_setting_changed_int(self, key, value):
        try:
            cleaned = str(value or "").strip()
            if cleaned:
                val = int(cleaned)
            elif key == "rcards.blur":
                val = DEFAULT_BLUR
            elif key == "rcards.darken":
                val = 55
            elif key == "rcards.mute_opacity":
                val = 30
            elif key == "rcards.rounding":
                val = int(DEFAULT_ROUNDING_DP)
            elif key == "rcards.stroke_alpha":
                val = DEFAULT_STROKE_ALPHA
            else:
                val = 0
            self.set_setting(key, val)
            self._apply_settings_change(False)
        except:
            pass

    def _on_setting_changed_float(self, key, value):
        try:
            cleaned = str(value or "").strip().replace(",", ".")
            val = float(cleaned) if cleaned else DEFAULT_STROKE_WIDTH_DP
            self.set_setting(key, str(val))
            self._apply_settings_change(False)
        except:
            pass

    def create_settings(self):
        return [
            Header(text="Основные настройки"),
            Switch(
                key="rcards.enable",
                text="Включить карточки",
                subtext="Включает плавающий стеклянный дизайн для карточек чатов.",
                default=self._get_bool("rcards.enable", True),
                on_change=lambda v: self._on_setting_changed("rcards.enable", bool(v))
            ),
            Input(
                key="rcards.rounding",
                text="Радиус скругления карточек (dp)",
                subtext="Число от 0 (прямоугольные) до 30. По умолчанию: 15.",
                default=str(self._get_int("rcards.rounding", int(DEFAULT_ROUNDING_DP))),
                on_change=lambda v: self._on_setting_changed_int("rcards.rounding", v)
            ),
            Header(text="Индикация онлайна"),
            Switch(
                key="rcards.online_badge",
                text="Системная точка на аватаре",
                subtext="Стандартная зеленая точка Telegram на аватаре собеседника.",
                default=self._get_bool("rcards.online_badge", True),
                on_change=lambda v: self._on_setting_changed("rcards.online_badge", bool(v))
            ),
            Switch(
                key="rcards.online_border",
                text="Неоновая обводка карточки",
                subtext="Подсвечивает контур карточки собеседника в сети мягким неоновым свечением.",
                default=self._get_bool("rcards.online_border", False),
                on_change=lambda v: self._on_setting_changed("rcards.online_border", bool(v))
            ),
            Header(text="Стиль и эффекты"),
            Input(
                key="rcards.blur",
                text="Сила размытия фона",
                subtext="Число от 1 до 25. Одинаково для всех чатов. По умолчанию: 7.",
                default=str(self._get_int("rcards.blur", DEFAULT_BLUR)),
                on_change=lambda v: self._on_setting_changed_int("rcards.blur", v)
            ),
            Input(
                key="rcards.darken",
                text="Сила затемнения (%)",
                subtext="Число от 0 до 100. По умолчанию: 55.",
                default=str(self._get_int("rcards.darken", 55)),
                on_change=lambda v: self._on_setting_changed_int("rcards.darken", v)
            ),
            Input(
                key="rcards.stroke_width",
                text="Толщина обводки карточки (dp)",
                subtext="Толщина обводки карточек в dp. 0 отключает обводку. По умолчанию: 0.5.",
                default=str(self._get_float("rcards.stroke_width", DEFAULT_STROKE_WIDTH_DP)),
                on_change=lambda v: self._on_setting_changed_float("rcards.stroke_width", v)
            ),
            Input(
                key="rcards.stroke_alpha",
                text="Непрозрачность обводки (0-100%)",
                subtext="Число от 0 до 100. Яркость верхней грани карточки. По умолчанию: 24.",
                default=str(self._get_int("rcards.stroke_alpha", DEFAULT_STROKE_ALPHA)),
                on_change=lambda v: self._on_setting_changed_int("rcards.stroke_alpha", v)
            ),
            Header(text="Чаты без звука (Muted)"),
            Switch(
                key="rcards.mute_dim",
                text="Затемнять замьюченные чаты",
                subtext="Включите, чтобы приглушать их карточки.",
                default=self._get_bool("rcards.mute_dim", False),
                on_change=lambda v: self._on_setting_changed("rcards.mute_dim", bool(v))
            ),
            Input(
                key="rcards.mute_opacity",
                text="Яркость замьюченных чатов (0-100%)",
                subtext="Работает только при включённом затемнении. По умолчанию: 30.",
                default=str(self._get_int("rcards.mute_opacity", 30)),
                on_change=lambda v: self._on_setting_changed_int("rcards.mute_opacity", v)
            ),
            Switch(
                key="rcards.mute_stroke",
                text="Обводка для замьюченных чатов",
                subtext="Работает только при включённом затемнении.",
                default=self._get_bool("rcards.mute_stroke", False),
                on_change=lambda v: self._on_setting_changed("rcards.mute_stroke", bool(v))
            )
        ]

    def update_cached_settings(self):
        self._card_rounding_cached = max(0, min(30, self._get_int("rcards.rounding", int(DEFAULT_ROUNDING_DP))))
        self._blur_radius_cached = max(1, min(25, self._get_int("rcards.blur", DEFAULT_BLUR)))
        self._darken_percent_cached = max(0, min(100, self._get_int("rcards.darken", 55)))
        self._enabled = self._get_bool("rcards.enable", True)
        self._online_border_cached = self._get_bool("rcards.online_border", False)
        self._online_badge_cached = self._get_bool("rcards.online_badge", True)
        self._mute_stroke_cached = self._get_bool("rcards.mute_stroke", False)
        self._mute_dim_cached = self._get_bool("rcards.mute_dim", False)
        self._mute_opacity_cached = max(0, min(100, self._get_int("rcards.mute_opacity", 30)))
        self._stroke_width_cached = max(0.0, min(6.0, self._get_float("rcards.stroke_width", DEFAULT_STROKE_WIDTH_DP)))
        self._stroke_alpha_cached = max(0, min(100, self._get_int("rcards.stroke_alpha", DEFAULT_STROKE_ALPHA)))

        percent = self._darken_percent_cached
        alpha = int(round(255.0 * percent / 100.0))
        self._tint_color = argb_to_signed(alpha, 0, 0, 0) if alpha > 0 else None
        self.bump_style_epoch()

    def _apply_settings_change(self, hard):
        self.update_cached_settings()
        self.update_isonline_hook()
        if not self._enabled:
            self.restore_all_cells()
        else:
            self.invalidate_all_cells()

    def update_isonline_hook(self):
        want = self._enabled and not self._online_badge_cached
        if want and not self._hook_isonline_active:
            self.hook_is_online()
        elif not want and self._hook_isonline_active:
            self.unhook_is_online()

    def get_reflected_field(self, cls, field_name):
        if not cls or not field_name:
            return None
        key = (cls.getName(), field_name)
        if key in self._field_cache:
            return self._field_cache[key]
        cur = cls
        field = None
        for _ in range(6):
            if not cur:
                break
            try:
                field = cur.getDeclaredField(field_name)
                field.setAccessible(True)
                break
            except:
                try:
                    cur = cur.getSuperclass()
                except:
                    break
        self._field_cache[key] = field
        return field

    def find_first_field(self, cls, names, bool_only=False):
        for n in names:
            f = self.get_reflected_field(cls, n)
            if f:
                if bool_only:
                    try:
                        tname = f.getType().getName()
                        if tname in ("boolean", "java.lang.Boolean"):
                            return f
                    except:
                        pass
                else:
                    return f
        return None

    def get_class_profile(self, cls):
        cname = cls.getName()
        if cname in self._class_profiles:
            return self._class_profiles[cname]
        profile = {}
        for n in SUPPRESS_FIELD_NAMES:
            f = self.find_first_field(cls, (n,), bool_only=True)
            if f:
                profile[n] = f
        for n in SEPARATOR_FIELD_NAMES:
            f = self.find_first_field(cls, (n,), bool_only=True)
            if f:
                profile[n] = f
        self._class_profiles[cname] = profile
        return profile

    def hook_dialogs_activity(self):
        cls = self.DialogsActivityClass
        if cls:
            try:
                m = cls.getDeclaredMethod("onResume")
                m.setAccessible(True)
                h = self.hook_method(m, _DialogsActivityResumeHook(self))
                if h:
                    self._hooks.append(h)
            except:
                pass

    def hook_dialog_cell(self):
        cls = self.DialogCellClass
        if not cls:
            return
        try:
            m = cls.getDeclaredMethod("onDraw", get_java_class("android.graphics.Canvas"))
            m.setAccessible(True)
            h = self.hook_method(m, _DialogCellDrawHook(self))
            if h:
                self._hooks.append(h)
        except:
            pass

        try:
            for m in cls.getDeclaredMethods():
                if m.getName() == "update":
                    pts = m.getParameterTypes()
                    if len(pts) == 2 and pts[0].getName() == "int" and pts[1].getName() == "boolean":
                        m.setAccessible(True)
                        h = self.hook_method(m, _DialogCellUpdateHook(self))
                        if h:
                            self._hooks.append(h)
                        break
        except:
            pass

    def hook_is_online(self):
        cls = self.DialogCellClass
        if not cls or self._hook_isonline_active:
            return
        try:
            m = cls.getDeclaredMethod("isOnline")
            m.setAccessible(True)
            h = self.hook_method(m, _DialogCellIsOnlineHook(self))
            if h:
                self._hooks.append(h)
                self._hook_isonline_active = True
        except:
            pass

    def unhook_is_online(self):
        if not self._hook_isonline_active:
            return
        self._hooks = [h for h in self._hooks if not isinstance(h.getCallback(), _DialogCellIsOnlineHook)]
        self._hook_isonline_active = False

    def is_folder_dialog_id(self, dialog_id):
        if dialog_id is None:
            return False
        if isinstance(dialog_id, (int, float)) and 0 < dialog_id < 100:
            return True
        try:
            val = int(dialog_id)
            if val <= 0:
                return False
            return (val & 0x2000000000000000) != 0 and (val & 0x8000000000000000) == 0
        except:
            return False

    def is_archive_or_folder(self, cell, dialog_id):
        if dialog_id is None or dialog_id == 0:
            return False
        if dialog_id == 1 or dialog_id == 0x2000000000000000:
            return True
        return self.is_folder_dialog_id(dialog_id)

    def new_state(self, cell, cell_hash):
        state = _CellState(cell, cell_hash)
        self._cell_states[cell_hash] = state
        return state

    def clear_visual_cache(self, state):
        state.entry = None
        state.solid_paint = None
        state.fade_from = None
        state.fade_start = None
        state.settled = False

    def configure_cell(self, cell, state):
        if state.configured:
            return
        try:
            state.orig_background = cell.getBackground()
            cell.setBackground(None)
            profile = self.get_class_profile(cell.getClass())
            for f in profile.values():
                try:
                    f.set(cell, False)
                except:
                    pass
            state.configured = True
        except:
            pass

    def restore_cell_configuration(self, state):
        if not state.configured:
            return
        try:
            cell = state.cell
            if cell:
                if state.orig_background:
                    cell.setBackground(state.orig_background)
                if state.receiver and state.avatar_orig:
                    ox, oy, ow, oh = state.avatar_orig
                    state.receiver.setImageCoords(float(ox), float(oy), float(ow), float(oh))
            state.configured = False
            state.avatar_scaled = False
        except:
            pass

    def restore_all_cells(self):
        with self._lock:
            states = list(self._cell_states.values())
        for st in states:
            self.restore_cell_configuration(st)
        self.invalidate_all_cells()

    def invalidate_all_cells(self):
        with self._lock:
            states = list(self._cell_states.values())
        for st in states:
            try:
                c = st.cell
                if c:
                    c.postInvalidate()
            except:
                pass

    def prune_detached_cells(self):
        with self._lock:
            keys_to_del = []
            for k, st in self._cell_states.items():
                c = st.cell
                if c is None:
                    keys_to_del.append(k)
                else:
                    try:
                        if not c.isAttachedToWindow():
                            keys_to_del.append(k)
                    except:
                        pass
            for k in keys_to_del:
                del self._cell_states[k]

    def apply_avatar_scale(self, cell, state):
        if state.avatar_scaled:
            return
        receiver = state.receiver
        if receiver is None:
            receiver = self.get_avatar_receiver(cell)
            state.receiver = receiver
        if receiver is None:
            return
        try:
            cur_w = receiver.getImageWidth()
            cur_h = receiver.getImageHeight()
            if cur_w <= 0.0 or cur_h <= 0.0:
                return

            x = receiver.getImageX()
            y = receiver.getImageY()
            new_w = float(cur_w) * AVATAR_SCALE
            new_h = float(cur_h) * AVATAR_SCALE
            receiver.setImageCoords(float(x + (cur_w - new_w) / 2.0),
                                    float(y + (cur_h - new_h) / 2.0),
                                    float(new_w), float(new_h))
            state.avatar_orig = (x, y, cur_w, cur_h)
            state.avatar_scaled = True
        except:
            pass

    def on_cell_updated(self, cell, args):
        if cell is None or not self._enabled:
            return
        cell_hash = System.identityHashCode(cell) if System else id(cell)
        state = self._cell_states.get(cell_hash)
        if state is None:
            state = self.new_state(cell, cell_hash)

        mask = int(args[0]) if args and len(args) > 0 else 0
        dialog_id = self.get_dialog_id(cell)

        avatar_changed = bool(mask & 2) or bool(mask & 64)
        same_dialog = (state.dialog_id == dialog_id and dialog_id != 0)

        if not same_dialog or avatar_changed:
            self.clear_visual_cache(state)
            state.receiver = None
            state.avatar_scaled = False
            state.cell = cell
            state.dialog_id = dialog_id
            state.is_folder = self.is_archive_or_folder(cell, dialog_id)
            state.configured = False
            self.refresh_state_flags(state, cell, dialog_id)
        else:
            state.cell = cell
            if bool(mask & 4):
                self.refresh_state_flags(state, cell, dialog_id)

    def refresh_state_flags(self, state, cell, dialog_id):
        self_id = self._self_user_id
        if self_id > 0 and dialog_id == self_id:
            special = "saved"
        elif dialog_id == 1271266957:
            special = "replies"
        else:
            special = None

        state.special = special
        state.is_muted = self.is_dialog_muted(cell, dialog_id)
        state.is_online = self.check_user_online(cell, dialog_id)

    def check_user_online(self, cell, dialog_id):
        if dialog_id <= 0:
            return False
        try:
            user = self._f_user.get(cell) if self._f_user else None
            if not user or getattr(user, "self", False) or getattr(user, "bot", False):
                return False

            status = getattr(user, "status", None)
            if not status:
                return False

            expires = int(getattr(status, "expires", 0))
            acc = int(self._f_account.getInt(cell)) if self._f_account else 0

            if expires <= 0:
                mc = self.get_messages_controller(acc)
                if mc and hasattr(mc, "onlinePrivacy"):
                    uid = getattr(user, "id", None)
                    if uid is not None and (mc.onlinePrivacy.containsKey(uid) or mc.onlinePrivacy.containsKey(to_jlong(uid))):
                        return True
                return False

            cur_time = self.get_current_time(acc)
            return expires > cur_time
        except:
            pass
        return False

    def on_cell_before_draw(self, param):
        cell = param.thisObject
        canvas = param.args[0]
        if cell is None or canvas is None:
            return

        w = cell.getMeasuredWidth()
        h = cell.getMeasuredHeight()
        if w <= 0 or h <= 0:
            return

        cell_hash = System.identityHashCode(cell) if System else id(cell)
        state = self._cell_states.get(cell_hash)
        if state is None:
            state = self.new_state(cell, cell_hash)
            state.dialog_id = self.get_dialog_id(cell)
            state.is_folder = self.is_archive_or_folder(cell, state.dialog_id)
            self.refresh_state_flags(state, cell, state.dialog_id)
        state.cell = cell

        if state.is_folder:
            return

        geo = self.get_geometry(w, h)

        if not state.configured:
            self.configure_cell(cell, state)

        if not state.avatar_scaled:
            self.apply_avatar_scale(cell, state)

        self.draw_card_background(canvas, state, geo)
        state.geo = geo

    def draw_card_background(self, canvas, state, geo):
        epoch = self._style_epoch
        if state.style_epoch != epoch or state.geo_gid != geo.gid:
            self.clear_visual_cache(state)
            state.style_epoch = epoch
            state.geo_gid = geo.gid

        radius = geo.radius

        if state.special is not None:
            entry = state.entry
            if entry is None:
                entry = self.get_special_entry(state.special, geo)
                state.entry = entry
            if entry is not None:
                canvas.drawRoundRect(geo.left, geo.top, geo.right, geo.bottom,
                                     radius, radius, entry[1])
            if geo.draw_stroke and geo.stroke_paint:
                canvas.drawRoundRect(geo.cs_l, geo.cs_t, geo.cs_r, geo.cs_b,
                                     radius, radius, geo.stroke_paint)
            return

        entry = state.entry
        if entry is not None and state.settled and state.fade_start is None:
            canvas.drawRoundRect(geo.left, geo.top, geo.right, geo.bottom,
                                 radius, radius, entry[1])
            if geo.draw_stroke and geo.stroke_paint:
                canvas.drawRoundRect(geo.cs_l, geo.cs_t, geo.cs_r, geo.cs_b,
                                     radius, radius, geo.stroke_paint)
            return

        if entry is None or not state.settled:
            self.probe_avatar_fast(state, geo)
            entry = state.entry

        if entry is None:
            self.draw_solid_background(canvas, state, geo)
        else:
            fade_start = state.fade_start
            if fade_start is None:
                canvas.drawRoundRect(geo.left, geo.top, geo.right, geo.bottom,
                                     radius, radius, entry[1])
            else:
                now = time.monotonic()
                progress = (now - fade_start) / FADE_DURATION
                if progress >= 1.0:
                    state.fade_start = None
                    state.fade_from = None
                    canvas.drawRoundRect(geo.left, geo.top, geo.right, geo.bottom,
                                         radius, radius, entry[1])
                else:
                    if progress < 0.0:
                        progress = 0.0
                    previous = state.fade_from
                    if previous is None:
                        self.draw_solid_background(canvas, state, geo)
                    else:
                        canvas.drawRoundRect(geo.left, geo.top, geo.right, geo.bottom,
                                             radius, radius, previous[1])
                    eased = progress * (2.0 - progress)
                    paint = self._paint_fade
                    paint.setShader(entry[0])
                    paint.setAlpha(int(255.0 * eased))
                    canvas.drawRoundRect(geo.left, geo.top, geo.right, geo.bottom,
                                         radius, radius, paint)
                    paint.setAlpha(255)
                    self.schedule_frame(state.cell)

        muted = state.is_muted
        online = state.is_online and self._online_border_cached
        if not self._mute_dim_cached:
            muted = False
        elif muted:
            online = False
        if geo.draw_stroke and geo.stroke_paint and not (muted or online):
            canvas.drawRoundRect(geo.cs_l, geo.cs_t, geo.cs_r, geo.cs_b,
                                 radius, radius, geo.stroke_paint)

    def draw_solid_background(self, canvas, state, geo):
        paint = state.solid_paint
        if paint is None:
            paint = self.get_solid_paint(self.get_placeholder_color(state.dialog_id))
            state.solid_paint = paint
        canvas.drawRoundRect(geo.left, geo.top, geo.right, geo.bottom,
                             geo.radius, geo.radius, paint)

    def get_solid_paint(self, color):
        paint = self._solid_paints.get(color)
        if paint is not None:
            return paint
        paint = Paint()
        paint.setAntiAlias(True)
        paint.setStyle(STYLE_FILL)
        paint.setColor(to_jint(color))
        self._solid_paints[color] = paint
        self._solid_order.append(color)
        while len(self._solid_order) > SOLID_PAINT_LIMIT:
            old = self._solid_order.pop(0)
            if old != color:
                self._solid_paints.pop(old, None)
        return paint

    def on_cell_after_draw(self, param, state):
        geo = state.geo
        if geo is None or state.is_folder:
            return

        muted = state.is_muted
        online = state.is_online and self._online_border_cached
        if not self._mute_dim_cached:
            muted = False
        elif muted:
            online = False
        if not (muted or online):
            return

        canvas = param.args[0]
        if online:
            fill_paint = self._paint_online_fill
            stroke_paint = self._paint_online_stroke
            draw_stroke = True
        else:
            fill_paint = self._paint_muted_fill
            stroke_paint = self._paint_muted_stroke
            draw_stroke = self._mute_stroke_cached
        draw_stroke = draw_stroke and self._stroke_width_cached > 0.0

        canvas.drawRoundRect(geo.left, geo.top, geo.right, geo.bottom,
                             geo.radius, geo.radius, fill_paint)
        if draw_stroke and stroke_paint:
            canvas.drawRoundRect(geo.ss_l, geo.ss_t, geo.ss_r, geo.ss_b,
                                 geo.radius, geo.radius, stroke_paint)

    def schedule_frame(self, cell):
        if cell is None:
            return
        if self._invalidate_mode != 2:
            try:
                cell.postInvalidateOnAnimation()
                self._invalidate_mode = 1
                return
            except:
                self._invalidate_mode = 2
        try:
            cell.postInvalidate()
        except:
            pass

    def probe_avatar_fast(self, state, geo):
        receiver = state.receiver
        if receiver is None:
            receiver = self.get_avatar_receiver(state.cell)
            state.receiver = receiver
            if receiver is None:
                return

        bmp = self.get_receiver_bitmap(receiver)
        if bmp is None:
            return

        try:
            bmp_id = int(System.identityHashCode(bmp)) if System else id(bmp)
            src_w = int(bmp.getWidth())
        except:
            return

        if src_w < self._settled_min_w:
            if state.entry is not None:
                return
            now = time.monotonic()
            if state.small_since == 0.0:
                state.small_since = now
            if now - state.small_since < SMALL_SOURCE_GRACE:
                return
        else:
            state.small_since = 0.0

        if bmp_id != state.bmp_id:
            state.bmp_id = bmp_id
            state.image_key = self.read_image_key(receiver)

        epoch = self._style_epoch
        image_key = state.image_key
        key = ("i", epoch, image_key, src_w) if image_key else ("d", epoch, int(state.dialog_id or 0), bmp_id, src_w)

        cached = self._blur_cache.get(key)
        if cached is None:
            self.request_blur_async(key, bmp, epoch)
            return

        entry = self.get_shader_entry(key, cached, geo)
        if entry is not None and entry is not state.entry:
            if state.entry is not None or state.solid_paint is not None:
                state.fade_from = state.entry
                state.fade_start = time.monotonic()
            state.entry = entry
        if entry is not None and src_w >= self._settled_min_w:
            state.settled = True

    def read_image_key(self, receiver):
        if self._imagekey_mode == 2:
            return None
        try:
            raw = receiver.getImageKey()
            self._imagekey_mode = 1
            return None if raw is None else str(raw)
        except:
            self._imagekey_mode = 2
            return None

    def request_blur_async(self, key, src_bmp, epoch):
        executor = self._executor
        if executor is None:
            return

        with self._lock:
            if key in self._blur_inflight:
                return
            self._blur_inflight.add(key)

        try:
            executor.submit(self._blur_task_background, key, src_bmp,
                            self._blur_radius_cached, self._tint_color,
                            self._lifecycle_generation, epoch)
        except:
            with self._lock:
                self._blur_inflight.discard(key)

    def _blur_task_background(self, key, src_bmp, radius, tint_color, generation, epoch):
        try:
            if generation != self._lifecycle_generation or epoch != self._style_epoch:
                return

            scaled = Bitmap.createScaledBitmap(src_bmp, BLUR_SIZE, BLUR_SIZE, True)
            if scaled is None:
                return

            effective = max(1, min(25, int(radius)))
            Utilities.stackBlurBitmap(scaled, effective)
            if tint_color is not None:
                Canvas(scaled).drawColor(to_jint(tint_color))

            if generation != self._lifecycle_generation or epoch != self._style_epoch:
                return

            with self._lock:
                cache = self._blur_cache
                order = self._blur_order
                cache[key] = scaled
                order.append(key)
                while len(order) > BLUR_CACHE_LIMIT:
                    old = order.pop(0)
                    if old != key:
                        cache.pop(old, None)
        except:
            pass
        finally:
            with self._lock:
                self._blur_inflight.discard(key)
            self.wake_cell_for_key(key)

    def wake_cell_for_key(self, key):
        with self._lock:
            states = list(self._cell_states.values())
        for st in states:
            if st.cell is not None:
                if key[0] == "d" and st.dialog_id == key[2]:
                    self.schedule_frame(st.cell)
                elif key[0] == "i" and st.image_key == key[2]:
                    self.schedule_frame(st.cell)

    def make_shader(self, bmp, geo):
        shader = BitmapShader(bmp, TILE_MIRROR, TILE_MIRROR)
        matrix = Matrix()
        bw = bmp.getWidth()
        bh = bmp.getHeight()
        if bw <= 0 or bh <= 0:
            return None
        scale = max(geo.card_w / float(bw), geo.card_h / float(bh))
        dx = geo.left + (geo.card_w - bw * scale) / 2.0
        dy = geo.top + (geo.card_h - bh * scale) / 2.0
        matrix.postScale(float(scale), float(scale))
        matrix.postTranslate(float(dx), float(dy))
        shader.setLocalMatrix(matrix)
        return shader

    def store_entry(self, key, entry):
        self._shader_cache[key] = entry
        self._shader_order.append(key)
        while len(self._shader_order) > SHADER_CACHE_LIMIT:
            old = self._shader_order.pop(0)
            if old != key:
                self._shader_cache.pop(old, None)
        return entry

    def get_shader_entry(self, key, bmp, geo):
        ck = (key, geo.w, geo.h)
        entry = self._shader_cache.get(ck)
        if entry is not None:
            return entry
        try:
            shader = self.make_shader(bmp, geo)
        except:
            return None
        if shader is None:
            return None
        paint = Paint()
        paint.setAntiAlias(True)
        paint.setStyle(STYLE_FILL)
        paint.setShader(shader)
        return self.store_entry(ck, (shader, paint))

    def get_placeholder_color(self, dialog_id):
        color = self._placeholder_color_cache.get(dialog_id)
        if color is not None:
            return color
        did = abs(int(dialog_id or 0))
        base = STATIC_AVATAR_COLORS[did % len(STATIC_AVATAR_COLORS)]
        keep = 0.18 * (1.0 - self._darken_percent_cached / 100.0)
        r = int(((base >> 16) & 0xFF) * keep)
        g = int(((base >> 8) & 0xFF) * keep)
        b = int((base & 0xFF) * keep)
        color = argb_to_signed(255, r, g, b)

        if len(self._placeholder_color_cache) > 256:
            self._placeholder_color_cache = {}
        self._placeholder_color_cache[dialog_id] = color
        return color

    def get_special_entry(self, kind, geo):
        colors = SPECIAL_COLORS.get(kind)
        if colors is None:
            return None
        key = ("special", kind, geo.w, geo.h)
        entry = self._shader_cache.get(key)
        if entry is not None:
            return entry
        span = max(geo.card_w, geo.card_h)
        x0 = geo.left + (geo.card_w - span) / 2.0
        y0 = geo.top + (geo.card_h - span) / 2.0
        try:
            c_top = to_jint(colors[0])
            c_bot = to_jint(colors[1])
            shader = LinearGradient(float(x0), float(y0),
                                    float(x0 + span), float(y0 + span),
                                    c_top, c_bot, TILE_CLAMP)
        except:
            return None
        paint = Paint()
        paint.setAntiAlias(True)
        paint.setStyle(STYLE_FILL)
        paint.setShader(shader)
        return self.store_entry(key, (shader, paint))

    def sync_account(self):
        try:
            if self.UserConfigClass is None:
                self.cache_classes()
            if self.UserConfigClass:
                acc = int(getattr(self.UserConfigClass, "selectedAccount", 0))
                if acc != self._last_account:
                    self._last_account = acc
                    inst = self.UserConfigClass.getInstance(acc)
                    if inst:
                        self._self_user_id = int(inst.getClientUserId())
        except:
            pass

    def get_dialog_id(self, cell):
        if cell is None:
            return 0
        if self._dialogid_mode != 2:
            try:
                val = cell.getDialogId()
                self._dialogid_mode = 1
                if val is not None and val != 0:
                    return int(val) if isinstance(val, (int, float)) else int(val.longValue())
            except:
                self._dialogid_mode = 2
        if self._f_dialog_id is not None:
            try:
                val = self._f_dialog_id.get(cell)
                if val is not None and val != 0:
                    return int(val) if isinstance(val, (int, float)) else int(val.longValue())
            except:
                pass
        return 0

    def get_avatar_receiver(self, cell):
        if cell is None:
            return None
        if self._f_avatar is not None:
            try:
                val = self._f_avatar.get(cell)
                if is_image_receiver_instance(val):
                    return val
            except:
                pass
        return None

    def get_receiver_bitmap(self, rec):
        try:
            b = rec.getBitmap()
            if b:
                return b
        except:
            pass
        try:
            d = rec.getDrawable()
            if isinstance(d, BitmapDrawable):
                return d.getBitmap()
            if d and hasattr(d, "getBitmap"):
                return d.getBitmap()
        except:
            pass
        return None

    def is_dialog_muted(self, cell, dialog_id):
        if self._f_muted is not None:
            try:
                return bool(self._f_muted.getBoolean(cell))
            except:
                pass
        mc = self.get_messages_controller(self._last_account)
        if mc and dialog_id:
            try:
                return bool(mc.isDialogMuted(dialog_id))
            except:
                pass
        return False
