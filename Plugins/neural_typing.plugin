__id__ = "neural_typing"
__name__ = "Neural Typing"
__description__ = ("Входящие сообщения появляются так, будто их в реальном времени пишет "
                   "нейросеть. Десять готовых стилей (проявление, машинка, волна, всплытие, "
                   "расшифровка, свечение и другие) и тонкая настройка каждого эффекта с "
                   "живым примером прямо в настройках. Длительность зависит от длины "
                   "сообщения. Чистая косметика на вашей стороне, собеседник ничего не видит.")
__version__ = "2.3.1"
__author__ = "@van1lLove (идея: @calm_rio)"
__min_version__ = "12.5.1"
__icon__ = "exteraPlugins/1"

import base64
import io
import random
import threading
import time

from base_plugin import BasePlugin, MethodHook
from android_utils import run_on_ui_thread
from client_utils import get_connections_manager
from ui.settings import Header, Switch, Divider, Input, Text
try:
    from ui.settings import Selector
except ImportError:
    Selector = None
try:
    from ui.settings import Custom          # свой View прямо в списке настроек
except ImportError:
    Custom = None
try:
    from client_utils import get_last_fragment
except ImportError:
    get_last_fragment = None
from java import jclass
from java.util import ArrayList

from org.telegram.messenger import ApplicationLoader

# ядро собирается из dex/src скриптом dex/build.sh и вставляется сюда
DEX_B64 = ""
CORE_CLASS = "com.neuraltyping.NeuralTypingCore"
CORE_VERSION = "nt-core-9"
CELL_CLASS = "org.telegram.ui.Cells.ChatMessageCell"

FRESH_WINDOW_SEC = 15      # анимируем только что пришедшие, не историю при скролле
# "Пузырь растёт с текстом" и "Сообщения по очереди": проверены на телефоне 02.10.2026
# (ядро nt-core-9). False снова спрячет тумблеры, а ядру будут уходить grow=0/queue=0
FEATURES_LATER = True
# другие плагины, которые сами печатают входящие (подменяют текст по буквам): с ними
# Neural Typing на таких сообщениях уступает, в настройках об этом предупреждаем
CONFLICTING = {"typewriter": "Typewriter", "text_animation": "Text Animation"}
STATS_EVERY_MS = 5000

DEFAULTS = {
    "cps": 25, "max_sec": "10", "glyph_ms": 280, "start_pause_ms": 600, "max_len": 4096,
    "punct_ms": 250, "max_active": 4, "move_dp": 7, "scale_from": 30, "rotate_deg": -30,
    "queue_gap_ms": 250, "queue_wait_sec": 30, "queue_max": 5,
}

# ---- стили ---------------------------------------------------------------
# Настройки внешнего вида. Готовый стиль просто выставляет их все разом, дальше
# любую можно поменять руками, и стиль сам станет "Свой".
STYLE_DEFAULTS = {
    "glyph_ms": 280, "blur": True, "blur_level": 1, "move": 1, "move_dp": 7, "spring": False,
    "scale": False, "scale_from": 30, "rotate": False, "rotate_deg": -30, "scramble": False,
    "glow": False, "glow_color": 0, "by_words": False, "cursor_style": 1, "cursor_blink": False,
    "cursor_color": 0,
}
STYLE_KEYS = list(STYLE_DEFAULTS)
INPUT_KEYS = {"glyph_ms", "move_dp", "scale_from", "rotate_deg"}
CHOICE_KEYS = {"blur_level", "move", "glow_color", "cursor_style", "cursor_color"}


def _preset(**changes):
    values = dict(STYLE_DEFAULTS)
    values.update(changes)
    return values


PRESETS = [
    ("Нейросеть", _preset()),
    ("Печатная машинка", _preset(glyph_ms=60, blur=False, move=0, cursor_style=2, cursor_blink=True)),
    ("Волна", _preset(glyph_ms=420, blur=False, move=2, move_dp=10, spring=True)),
    ("Всплытие", _preset(glyph_ms=380, blur=False, move=0, spring=True, scale=True, scale_from=30,
                         cursor_style=4, cursor_blink=True)),
    ("Падение", _preset(glyph_ms=450, blur=False, move=1, move_dp=16, spring=True, cursor_style=0)),
    ("Туман", _preset(glyph_ms=700, blur_level=3, move=0, cursor_style=0)),
    ("Вихрь", _preset(glyph_ms=480, blur=False, move=4, move_dp=12, spring=True, scale=True, scale_from=50,
                      rotate=True, rotate_deg=-35)),
    ("Расшифровка", _preset(glyph_ms=520, blur=False, move=0, scramble=True, glow=True, glow_color=0,
                            cursor_style=3, cursor_blink=True, cursor_color=1)),
    ("Свечение", _preset(glyph_ms=600, move_dp=5, glow=True, glow_color=1, cursor_color=1)),
    ("По словам", _preset(glyph_ms=350, move=2, move_dp=6, by_words=True, cursor_style=0)),
]
CUSTOM_STYLE = len(PRESETS)
PRESET_NAMES = [name for name, _ in PRESETS] + ["Свой"]
BLUR_NAMES = ["Слабое", "Среднее", "Сильное", "Очень сильное"]
MOVE_NAMES = ["Не двигается", "Сверху", "Снизу", "Слева", "Справа"]
CURSOR_NAMES = ["Нет", "Черта", "Блок", "Подчёркивание", "Точка"]
PALETTE_NAMES = ["Акцент темы", "Голубой", "Фиолетовый", "Розовый", "Золотой", "Зелёный", "Красный"]


def _norm(key, value):
    """Значение настройки в сравнимом виде: поля хранятся строками, выборы числами."""
    try:
        if key in INPUT_KEYS:
            return round(float(str(value).strip().replace(",", ".")), 3)
        if key in CHOICE_KEYS:
            return int(value)
        return bool(value)
    except Exception:
        return value

# ---- классический режим (как в 1.3.x) ---------------------------------------
DEFAULT_TICK_MS = 22       # не чаще: каждый шаг перестраивает раскладку и перепривязывает ячейку
CURSOR = "▍"


def now():
    """Серверное время: часы устройства могут расходиться с ним на часы, а дата
    сообщения серверная. С time.time() на таком телефоне не анимировалось бы
    вообще ничего."""
    try:
        value = int(get_connections_manager().getCurrentTime())
        if value > 0:
            return value
    except Exception:
        pass
    return int(time.time())


class BindHook(MethodHook):
    """Классический режим: после setMessageObject. Ставится, только когда этот
    режим действительно нужен: иначе это лишний переход в Python на каждой
    привязке каждой ячейки."""

    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            self.plugin.on_cell_bound(param)
        except Exception as e:
            self.plugin._log(f"bind: {e}")


class NeuralTypingPlugin(BasePlugin):

    # ---- диагностика ------------------------------------------------------

    def _write_log(self, text):
        try:
            base = ApplicationLoader.applicationContext.getExternalFilesDir(None)
            with io.open(str(base.getAbsolutePath()) + "/neural_typing_log.txt",
                         "a", encoding="utf-8") as f:
                f.write(text)
        except Exception:
            pass

    def _log(self, msg):
        if not self._opt("debug", False):
            return
        self._write_log(time.strftime("%H:%M:%S ") + str(msg) + "\n")

    # ---- настройки --------------------------------------------------------

    def _opt(self, key, default=None):
        """Значение настройки. SDK сохраняет новое значение до вызова on_change,
        поэтому читаем только сохранённое: так и сброс настроек виден сразу."""
        try:
            return self.get_setting(key, default)
        except Exception:
            return default

    def _int(self, key, lo, hi):
        try:
            return max(lo, min(hi, int(str(self._opt(key, str(DEFAULTS.get(key, lo)))).strip())))
        except Exception:
            return DEFAULTS.get(key, lo)

    def _float(self, key, lo, hi):
        try:
            raw = str(self._opt(key, str(DEFAULTS.get(key, lo)))).strip().replace(",", ".")
            return max(lo, min(hi, float(raw)))
        except Exception:
            return float(DEFAULTS.get(key, lo))

    def _classic_wanted(self):
        # выгруженный экземпляр не работает никогда: ядра у него нет, и без этой
        # проверки он решил бы, что нужен классический режим (так и появлялся
        # "зомби", который сам печатал сообщения рядом с новой версией)
        if getattr(self, "_unloaded", False):
            return False
        return self._core is None or bool(self._opt("classic", False))

    def _sel(self, key, default, lo, hi):
        try:
            return max(lo, min(hi, int(self._opt(key, default))))
        except Exception:
            return default

    def _move(self):
        """Откуда приходит буква. До 2.2 был переключатель "Сдвиг сверху"."""
        if self._opt("move", None) is None:
            return 1 if self._opt("slide", True) else 0
        return self._sel("move", 1, 0, 4)

    def _cursor_style(self):
        """Вид курсора. До 2.2 был переключатель "Курсор"."""
        if self._opt("cursor_style", None) is None:
            return 1 if self._opt("cursor", True) else 0
        return self._sel("cursor_style", 1, 0, 4)

    def _settings_str(self):
        def on(key, default):
            return "1" if bool(self._opt(key, default)) else "0"
        enabled = bool(self._opt("enabled", True)) and not self._classic_wanted()
        pause = self._int("start_pause_ms", 100, 3000) if self._opt("word_pause", False) else 0
        punct = self._int("punct_ms", 50, 3000) if self._opt("punct_pause", False) else 0
        parts = [
            ("enabled", "1" if enabled else "0"),
            ("glyph", self._int("glyph_ms", 40, 2000)),
            ("blur", on("blur", True)),
            ("blurlvl", self._sel("blur_level", 1, 0, 3)),
            ("move", self._move()),
            ("movedp", self._float("move_dp", 0.0, 60.0)),
            ("spring", on("spring", False)),
            ("scale", on("scale", False)),
            ("scalefrom", self._float("scale_from", 0.0, 300.0)),
            ("rotate", on("rotate", False)),
            ("angle", self._float("rotate_deg", -360.0, 360.0)),
            ("scramble", on("scramble", False)),
            ("glow", on("glow", False)),
            ("glowcolor", self._sel("glow_color", 0, 0, len(PALETTE_NAMES) - 1)),
            ("words", on("by_words", False)),
            ("cursor", self._cursor_style()),
            ("blink", on("cursor_blink", False)),
            ("curcolor", self._sel("cursor_color", 0, 0, 1)),
            ("cps", self._int("cps", 5, 400)),
            ("maxsec", self._float("max_sec", 0.5, 60.0)),
            ("jitter", on("jitter", True)),
            ("pause", pause),
            ("punct", punct),
            ("private", on("only_private", False)),
            ("outgoing", on("animate_outgoing", False)),
            ("maxlen", self._int("max_len", 10, 4096)),
            ("maxactive", self._int("max_active", 1, 20)),
            ("blursave", on("blur_save", True)),
            # пузырь и очередь временно спрятаны до проверки на телефоне: ядру всегда
            # выключены, даже если у кого-то сохранены включёнными
            ("grow", "0") if not FEATURES_LATER else ("grow", on("grow_bubble", False)),
            ("queue", "0") if not FEATURES_LATER else ("queue", on("queue", False)),
            ("qgap", self._int("queue_gap_ms", 0, 3000)),
            ("qwait", self._int("queue_wait_sec", 0, 120)),
            ("qmax", self._int("queue_max", 1, 20)),
            ("debug", on("debug", False)),
        ]
        return ";".join(f"{k}={v}" for k, v in parts)

    def _push_settings(self):
        if self._core is None:
            return
        try:
            self._call("configure", self._settings_str())
        except Exception as e:
            self._log(f"настройки в ядро: {e}")

    def _style_value(self, key):
        if key == "move":
            return self._move()
        if key == "cursor_style":
            return self._cursor_style()
        return self._opt(key, STYLE_DEFAULTS[key])

    def _matching_preset(self):
        """Какой готовый стиль совпадает с текущими настройками, иначе "Свой"."""
        for index, (_, values) in enumerate(PRESETS):
            if all(_norm(k, self._style_value(k)) == _norm(k, v) for k, v in values.items()):
                return index
        return CUSTOM_STYLE

    def _apply_preset(self, index):
        if not 0 <= index < len(PRESETS):
            return
        for key, value in PRESETS[index][1].items():
            if key in INPUT_KEYS:
                value = str(value)
            self.set_setting(key, value)

    def _changed(self, key, value):
        """on_change любого переключателя или поля: сразу отдаём ядру. Выбор
        стиля выставляет все его настройки, ручная правка настройки стиля
        переводит выбор на совпавший стиль или на "Свой"."""
        try:
            if key == "style":
                self._apply_preset(int(value))
            elif key in STYLE_KEYS:
                match = self._matching_preset()
                if match != self._sel("style", 0, 0, CUSTOM_STYLE):
                    self.set_setting("style", match)
        except Exception as e:
            self._log(f"стиль: {e}")
        try:
            self._apply_mode()
            if key == "debug":
                self._restart_tick()
                if value:
                    self._log_plugins()
        except Exception as e:
            self._log(f"смена настройки {key}: {e}")

    # ---- ядро -------------------------------------------------------------

    def _load_core(self):
        """Грузим DEX из строки в плагине прямо в память. Возвращает причину
        отказа или None, если всё хорошо."""
        self._core = None
        self._m = {}
        if not DEX_B64 or DEX_B64.startswith("@@"):
            return "ядро не вшито в плагин"
        try:
            data = base64.b64decode(DEX_B64)
        except Exception as e:
            return f"ядро повреждено: {e}"
        parent = ApplicationLoader.applicationContext.getClassLoader()
        loader = None
        try:
            from dalvik.system import InMemoryDexClassLoader
            from java.nio import ByteBuffer
            loader = InMemoryDexClassLoader(ByteBuffer.wrap(data), parent)
        except Exception as e:
            self._log(f"загрузка из памяти не вышла ({e}), пробую через файл")
            try:
                from dalvik.system import DexClassLoader
                cache = ApplicationLoader.applicationContext.getCodeCacheDir()
                path = str(cache.getAbsolutePath()) + "/neural_typing_core.dex"
                # прошлый файл помечен только для чтения, перезаписать его нельзя
                jclass("java.io.File")(path).delete()
                with io.open(path, "wb") as f:
                    f.write(data)
                jclass("java.io.File")(path).setReadOnly()  # Android 14 требует только чтение
                loader = DexClassLoader(path, str(cache.getAbsolutePath()), None, parent)
            except Exception as e2:
                return f"не загрузить ядро: {e2}"
        try:
            cls = loader.loadClass(CORE_CLASS)
            for m in cls.getMethods():
                self._m.setdefault(str(m.getName()), m)
            # у ядра только статические методы: объект своего класса из чужого
            # загрузчика Chaquopy обернуть не может ("cannot create ... proxy")
            version = str(self._m["version"].invoke(None, []))
            if version != CORE_VERSION:
                return f"не та версия ядра: {version}"
            if not bool(self._m["supported"].invoke(None, [])):
                return "в клиенте нет родного аниматора: " + str(self._m["stats"].invoke(None, []))
            self._core = cls
            self._loader = loader  # держим, иначе класс выгрузится
        except Exception as e:
            self._core = None
            return f"ядро не запустилось: {e}"
        # настройки до хуков: первый же вызов хука должен видеть их
        self._push_settings()
        try:
            err = str(self._call("install") or "")
        except Exception as e:
            err = f"установка хуков: {e}"
        if err:
            # мог встать один хук из двух: выключаем ядро и снимаем всё, иначе
            # вместе с классикой работали бы два движка сразу
            try:
                self._call("configure", "enabled=0")
                self._call("uninstall")
            except Exception:
                pass
            self._core = None
            return err
        return None

    def _call(self, name, *args):
        return self._m[name].invoke(None, list(args))

    # ---- жизненный цикл ---------------------------------------------------

    def on_plugin_load(self):
        self._unloaded = False
        self._hooks = []           # хуки классического режима
        self._core = None
        self._m = {}
        self._done = {}            # что уже анимировали, чтобы не повторять при скролле
        self._gen = int(getattr(self, "_gen", 0)) + 1
        self._ticking = False
        self._last_stats = ""
        # классический режим
        self._timers = {}
        self._classic = {}         # идущие печати: tkey -> anim, чтобы вернуть текст при выгрузке
        self._recent_out = {}
        self._active_out = {}
        self._suppress = False
        self._tk = 0

        # после обновления с 2.1 стиль ещё не сохранён: выбираем тот, что совпадает
        # с настройками пользователя, иначе "Свой"
        try:
            if self.get_setting("style", None) is None:
                self.set_setting("style", self._matching_preset())
        except Exception:
            pass
        reason = self._load_core()
        self._core_status = reason
        if reason is None:
            self._log(f"ядро {CORE_VERSION}: хуки стоят, Python на горячих путях не участвует")
        else:
            self._log(f"нативный режим недоступен: {reason}")
        self._apply_mode()
        self._restart_tick()
        if self._opt("debug", False):
            self._log_plugins()

    def on_plugin_unload(self):
        self._unloaded = True
        self._gen = int(getattr(self, "_gen", 0)) + 1
        if getattr(self, "_core", None) is not None:
            try:
                self._call("uninstall")
            except Exception:
                pass
            self._flush_core_log()
        self._stop_classic()
        self._remove_classic_hook()
        self._core = None
        self._loader = None
        self._m = {}

    def _apply_mode(self):
        """Нативный или классический режим: ядру настройки (там же вкл/выкл),
        классический хук ставим только когда он нужен."""
        if getattr(self, "_unloaded", False):
            # экран настроек старого экземпляра может ещё жить после переустановки
            self._stop_classic()
            self._remove_classic_hook()
            return
        self._push_settings()
        if self._classic_wanted() and bool(self._opt("enabled", True)):
            self._install_classic_hook()
        else:
            self._stop_classic()
            self._remove_classic_hook()

    def _install_classic_hook(self):
        if self._hooks or getattr(self, "_unloaded", False):
            return
        try:
            cell_cls = jclass(CELL_CLASS).getClass()
            hooks = self.hook_all_methods(cell_cls, "setMessageObject", BindHook(self))
            self._hooks.extend(self._each_hook(hooks))
            self._log(f"классический режим: хук стоит ({len(self._hooks)})")
        except Exception as e:
            self._log(f"классический хук: {e}")

    @staticmethod
    def _each_hook(hooks):
        """hook_all_methods отдаёт то питоновский список, то Java-список: раскладываем
        по одному, иначе снятие не находило хуков и они оставались жить."""
        if hooks is None:
            return []
        if isinstance(hooks, (list, tuple)):
            return [h for h in hooks if h is not None]
        try:
            return [hooks.get(i) for i in range(int(hooks.size())) if hooks.get(i) is not None]
        except Exception:
            pass
        try:
            return [h for h in hooks if h is not None]
        except Exception:
            return [hooks]

    @staticmethod
    def _plugins():
        """Все установленные плагины клиента: id -> (название, включён)."""
        pc = jclass("com.exteragram.messenger.plugins.PluginsController")
        inst = None
        for get in (lambda: pc.getInstance(), lambda: pc.INSTANCE, lambda: pc.Companion.getInstance()):
            try:
                inst = get()
                if inst is not None:
                    break
            except Exception:
                continue
        plugins = inst.getPlugins()
        out = {}
        for key in list(plugins.keySet().toArray()):
            plugin = plugins.get(key)
            try:
                on = bool(plugin.isEnabled())
            except Exception:
                on = True
            try:
                name = str(plugin.getName())
            except Exception:
                name = ""
            out[str(key)] = (name, on)
        return out

    def _conflicts(self):
        """Включённые плагины, которые сами печатают входящие."""
        try:
            return [name or CONFLICTING[pid] for pid, (name, on) in self._plugins().items()
                    if on and pid in CONFLICTING]
        except Exception:
            return []

    def _log_plugins(self):
        """Какие ещё плагины включены: если сообщения печатает кто-то кроме нас,
        по этому списку видно кто."""
        try:
            names = [f"{key}{f' ({name})' if name and name != key else ''}{'' if on else ' [выкл]'}"
                     for key, (name, on) in self._plugins().items()]
            self._log("плагины: " + ", ".join(sorted(names)))
            found = self._conflicts()
            if found:
                self._log("мешают, тоже печатают входящие: " + ", ".join(found))
        except Exception as e:
            self._log(f"список плагинов: {e}")

    def _remove_classic_hook(self):
        left = 0
        for h in list(getattr(self, "_hooks", [])):
            try:
                self.unhook_method(h)
                continue
            except Exception:
                pass
            try:
                h.unhook()
            except Exception:
                left += 1
        if getattr(self, "_hooks", None) and not left:
            self._log("классический хук снят")
        elif left:
            self._log(f"классический хук: не снялось {left}")
        self._hooks = []

    # ---- журнал ядра ------------------------------------------------------

    def _restart_tick(self):
        if self._opt("debug", False) and not self._ticking:
            self._ticking = True
            gen = self._gen
            run_on_ui_thread(lambda: self._stats_tick(gen), STATS_EVERY_MS)

    def _flush_core_log(self):
        try:
            text = str(self._call("drainLog") or "")
            if text:
                self._write_log(text)
        except Exception as e:
            self._write_log(time.strftime("%H:%M:%S ") + f"журнал ядра: {e}\n")

    def _stats_tick(self, gen):
        if gen != self._gen or not self._opt("debug", False):
            if gen == self._gen:
                self._ticking = False
            return
        if self._core is not None:
            self._flush_core_log()
            try:
                stats = str(self._call("stats"))
                if stats != self._last_stats:
                    self._last_stats = stats
                    self._log("ядро: " + stats)
            except Exception as e:
                self._log(f"статистика: {e}")
        run_on_ui_thread(lambda: self._stats_tick(gen), STATS_EVERY_MS)

    # ---- кого анимировать (классический режим) ----------------------------

    def _key(self, mo):
        did = int(mo.getDialogId())
        if mo.isOutOwner():
            # у исходящего id меняется при подтверждении сервером, random_id нет
            try:
                rid = int(mo.messageOwner.random_id)
                if rid:
                    return ("out", did, rid)
            except Exception:
                pass
        return ("in", did, int(mo.getId()))

    def _eligible(self, mo, check_done=True):
        if not self._opt("enabled", True):
            return False
        try:
            outgoing = bool(mo.isOutOwner())
            if outgoing and not self._opt("animate_outgoing", False):
                return False
            if not outgoing and int(mo.getId()) <= 0:
                return False
            if check_done and self._key(mo) in self._done:
                return False
            if self._opt("only_private", False) and int(mo.getDialogId()) < 0:
                return False
            date = int(getattr(mo.messageOwner, "date", 0) or 0)
            if now() - date > FRESH_WINDOW_SEC:
                return False
            text = str(mo.messageText or "")
            if len(text) < 2 or len(text) > self._int("max_len", 10, 4096):
                return False
        except Exception:
            return False
        return True

    def _remember(self, key):
        self._done[key] = True
        if len(self._done) > 600:
            for k in list(self._done)[:300]:
                self._done.pop(k, None)

    # ---- классический режим (1.3.x) ---------------------------------------
    # applyNewText + resetLayout на каждом шаге: тяжело, но работает на любой
    # сборке. Включается, если родного аниматора нет или выбран вручную.

    def _word_stops(self, full):
        stops = []
        i, n = 0, len(full)
        while i < n:
            j = i
            while j < n and not full[j].isspace():
                j += 1
            while j < n and full[j].isspace():
                j += 1
            stops.append(j)
            i = j
        return stops

    def _advance(self, anim):
        stops = anim.get("stops")
        if stops:
            anim["stop_idx"] += anim["words_per_step"]
            idx = anim["stop_idx"]
            return stops[idx] if idx < len(stops) else len(anim["full"])
        return anim["pos"] + anim["step_chars"]

    def _snapshot_entities(self, mo):
        out = []
        try:
            ents = mo.messageOwner.entities
            if ents is not None:
                for i in range(ents.size()):
                    e = ents.get(i)
                    out.append((e, int(e.offset), int(e.length)))
        except Exception:
            pass
        return out

    def _set_entities(self, mo, anim, n):
        ents = anim.get("entities")
        if not ents:
            return
        try:
            lst = ArrayList()
            for e, off, ln in ents:
                if n is None:
                    e.length = ln
                    lst.add(e)
                elif off < n:
                    e.length = min(ln, n - off)
                    lst.add(e)
            mo.messageOwner.entities = lst
        except Exception:
            pass

    def _cursor_for(self, full, stops, step_chars, words_per_step):
        if self._cursor_style() == 0:
            return False
        if len(full.split()) <= 1:
            return False
        if stops:
            steps = -(-len(stops) // max(1, words_per_step))
        else:
            steps = -(-len(full) // max(1, step_chars))
        return steps > 2

    def on_cell_bound(self, param):
        if getattr(self, "_unloaded", False):
            return
        if not self._classic_wanted() or self._suppress or not self._opt("enabled", True):
            return
        args = list(param.args or [])
        mo = args[0] if args else None
        if mo is None:
            return
        try:
            outgoing = bool(mo.isOutOwner())
            full = str(mo.messageText or "")
            sig = self._key(mo) if outgoing else None
            if outgoing:
                active = self._active_out.get(sig)
                if active is not None:
                    active["mo"] = mo
                    active["cell"] = param.thisObject
                    active["args"] = args
                    active["msg_id"] = int(mo.getId())
                    active["entities"] = self._snapshot_entities(mo)
                    try:
                        self._apply_text(mo, active, active["pos"])
                        self._redraw(param.thisObject, active)
                    except Exception:
                        pass
                    return
                if time.time() - self._recent_out.get(sig, 0) < 12:
                    return
            if not self._eligible(mo):
                return
            self._remember(self._key(mo))
            entities = self._snapshot_entities(mo)
        except Exception:
            return

        # тот же темп, что у нативного режима: символов в секунду и не дольше max_sec
        n = max(1, len(full))
        total = min(n / float(self._int("cps", 5, 400)), self._float("max_sec", 0.5, 60.0))
        steps = max(1, min(n, int(total * 1000 / DEFAULT_TICK_MS)))
        step_chars = max(1, -(-n // steps))
        stops = self._word_stops(full) if self._opt("by_words", False) else None
        if stops:
            steps = max(1, min(steps, len(stops)))
            words_per_step = max(1, -(-len(stops) // steps))
            stop_idx = words_per_step - 1
            init_pos = stops[min(stop_idx, len(stops) - 1)]
        else:
            stops = None
            words_per_step = 1
            stop_idx = 0
            init_pos = step_chars

        self._tk += 1
        anim = {
            "mo": mo, "cell": param.thisObject, "args": args, "full": full,
            "pos": init_pos, "msg_id": int(mo.getId()), "step_chars": step_chars,
            "entities": entities, "stops": stops, "stop_idx": stop_idx,
            "words_per_step": words_per_step, "sig": sig, "tkey": self._tk,
            "cursor": self._cursor_for(full, stops, step_chars, words_per_step),
            "tick": total / steps,
        }
        if sig is not None:
            self._active_out[sig] = anim
        self._classic[anim["tkey"]] = anim
        try:
            self._apply_text(mo, anim, init_pos)
            self._redraw(anim["cell"], anim)
        except Exception:
            pass
        self._schedule(anim)

    def _schedule(self, anim):
        if (anim["pos"] > 0 and not anim.get("start_pause_done")
                and self._opt("word_pause", False)):
            anim["start_pause_done"] = True
            tick = self._int("start_pause_ms", 100, 3000) / 1000.0
        else:
            tick = anim.get("tick", DEFAULT_TICK_MS / 1000.0)
            if self._opt("jitter", True):
                tick *= random.uniform(0.55, 1.6)
        t = threading.Timer(tick, lambda: run_on_ui_thread(lambda: self._step(anim)))
        t.daemon = True
        self._timers[anim["tkey"]] = t
        t.start()

    def _apply_text(self, mo, anim, n):
        self._set_entities(mo, anim, n)
        prefix = anim["full"][:n]
        mo.applyNewText(prefix + CURSOR if anim.get("cursor") else prefix)
        try:
            mo.resetLayout()
        except Exception:
            pass

    def _restore_text(self, mo, anim):
        self._set_entities(mo, anim, None)
        try:
            mo.applyNewText()
        except Exception:
            try:
                mo.applyNewText(anim["full"])
            except Exception:
                pass
        try:
            mo.resetLayout()
        except Exception:
            pass

    def _redraw(self, cell, anim):
        self._suppress = True
        try:
            cell.setMessageObject(*anim["args"])
        except Exception:
            pass
        finally:
            self._suppress = False
        try:
            cell.requestLayout()
            cell.invalidate()
        except Exception:
            pass

    def _finish_out(self, anim):
        sig = anim.get("sig")
        if sig is not None:
            self._active_out.pop(sig, None)
            self._recent_out[sig] = time.time()

    def _step(self, anim):
        self._timers.pop(anim["tkey"], None)
        mo = anim["mo"]
        cell = anim["cell"]
        try:
            cur = cell.getMessageObject()
            alive = cur is not None and int(cur.getId()) == anim["msg_id"]
            anim["pos"] = self._advance(anim)
            if not alive or anim["pos"] >= len(anim["full"]):
                self._restore_text(mo, anim)
                if alive:
                    self._redraw(cell, anim)
                self._finish_out(anim)
                self._classic.pop(anim["tkey"], None)
                return
            self._apply_text(mo, anim, anim["pos"])
            self._redraw(cell, anim)
            self._schedule(anim)
        except Exception as e:
            self._restore_text(mo, anim)
            self._finish_out(anim)
            self._classic.pop(anim["tkey"], None)
            self._log(f"классика: {e}")

    def _stop_classic(self):
        """Выгрузка или уход из классики посреди печати: таймеры гасим, а
        недопечатанный текст возвращаем целиком, иначе сообщение так и осталось
        бы обрезанным, с курсором и укороченным форматированием."""
        for t in list(getattr(self, "_timers", {}).values()):
            try:
                t.cancel()
            except Exception:
                pass
        self._timers = {}
        pending = list(getattr(self, "_classic", {}).values())
        self._classic = {}
        for anim in pending:
            def restore(anim=anim):
                try:
                    self._restore_text(anim["mo"], anim)
                    cur = anim["cell"].getMessageObject()
                    if cur is not None and int(cur.getId()) == anim["msg_id"]:
                        self._redraw(anim["cell"], anim)
                except Exception:
                    pass
                self._finish_out(anim)
            run_on_ui_thread(restore)

    # ---- настройки: экран -------------------------------------------------

    def _ctl(self, cls, **kw):
        """Переключатель, поле или выбор, который сразу сообщает ядру о смене.
        Если SDK не знает on_change, настройки дойдут до ядра при пересборке
        экрана (create_settings)."""
        key = kw.get("key")
        if key:
            kw["on_change"] = lambda value, k=key: self._changed(k, value)
        try:
            return cls(**kw)
        except TypeError:
            kw.pop("on_change", None)
            try:
                return cls(**kw)
            except TypeError:
                kw.pop("icon", None)
                return cls(**kw)

    def _choice(self, key, text, default, items, icon=None, subtext=None):
        """Выбор из списка. Без Selector в SDK: поле с номером варианта."""
        kw = {"key": key, "text": text, "default": default}
        if icon:
            kw["icon"] = icon
        if Selector is not None:
            return self._ctl(Selector, items=items, **kw)
        kw["default"] = str(default)
        kw["subtext"] = subtext or " / ".join(f"{i} {n}" for i, n in enumerate(items))
        return self._ctl(Input, **kw)

    def _context(self):
        try:
            fragment = get_last_fragment() if get_last_fragment is not None else None
            activity = fragment.getParentActivity() if fragment is not None else None
            if activity is not None:
                return activity
        except Exception:
            pass
        return ApplicationLoader.applicationContext

    def _preview_items(self):
        """Живой пример: пузырь сообщения, в котором текст проявляется с текущими
        настройками. Смена любой настройки сразу перезапускает его."""
        if self._core is None:
            return []
        if self._opt("classic", False):
            return [Text(text="Пример показывает нативный режим",
                         subtext="Сейчас включён классический режим, в чате будет старая печать")]
        if Custom is not None:
            try:
                return [Custom(view=self._call("createPreview", self._context()))]
            except Exception as e:
                self._log(f"пример в настройках: {e}")
        return [Text(text="Показать пример", icon="msg_photo_curve_solar", accent=True,
                     on_click=self._show_preview_dialog)]

    def _show_preview_dialog(self, *args):
        try:
            from ui.alert import AlertDialogBuilder
            activity = self._context()
            builder = AlertDialogBuilder(activity)
            builder.set_title("Пример анимации")
            builder.set_view(self._call("createPreview", activity), -2)   # высота по содержимому
            builder.set_positive_button("Закрыть", lambda dialog, which: dialog.dismiss())
            builder.show()
        except Exception as e:
            self._log(f"окно примера: {e}")

    def _page(self, title, icon, build_items):
        """Раздел настроек отдельной страницей с примером сверху: так пример
        всегда на виду, что бы ни менялось. Без подстраниц в SDK раздел идёт
        прямо в общем списке."""
        def build():
            try:
                self._apply_mode()
            except Exception:
                pass
            return self._preview_items() + build_items()
        try:
            return [Text(text=title, icon=icon, create_sub_fragment=build)]
        except TypeError:
            return [Divider(), Header(text=title)] + build_items()

    def _look_items(self):
        S = Switch
        items = [
            Header(text="Как появляется буква"),
            self._ctl(Input, key="glyph_ms", text="Длительность появления буквы, мс",
                      default=str(STYLE_DEFAULTS["glyph_ms"]), icon="msg_contacts_time_solar",
                      subtext="От 40 до 2000. Больше значит мягче и медленнее"),
            self._ctl(S, key="blur", text="Размытие", default=STYLE_DEFAULTS["blur"],
                      icon="msg_photo_blur_solar", subtext="Буква проступает из размытия"),
        ]
        if self._opt("blur", STYLE_DEFAULTS["blur"]):
            items.append(self._choice("blur_level", "Сила размытия", STYLE_DEFAULTS["blur_level"],
                                      BLUR_NAMES))
        items.append(self._choice("move", "Откуда приходит буква", STYLE_DEFAULTS["move"], MOVE_NAMES,
                                  icon="msg_map_type_solar"))
        if self._move() != 0:
            items.append(self._ctl(Input, key="move_dp", text="Расстояние, dp",
                                   default=str(STYLE_DEFAULTS["move_dp"]), subtext="От 0 до 60"))
        items += [
            self._ctl(S, key="spring", text="Пружина", default=STYLE_DEFAULTS["spring"],
                      icon="msg_noise_on_solar", subtext="Буква проскакивает своё место и возвращается"),
            self._ctl(S, key="scale", text="Масштаб", default=STYLE_DEFAULTS["scale"],
                      icon="msg_zoomin_solar", subtext="Буква вырастает до своего размера"),
        ]
        if self._opt("scale", STYLE_DEFAULTS["scale"]):
            items.append(self._ctl(Input, key="scale_from", text="Начальный размер, %",
                                   default=str(STYLE_DEFAULTS["scale_from"]),
                                   subtext="0 рост из точки, 100 без изменения, 200 сжатие из крупной"))
        items.append(self._ctl(S, key="rotate", text="Поворот", default=STYLE_DEFAULTS["rotate"],
                               icon="msg_reset_solar", subtext="Буква доворачивается на место"))
        if self._opt("rotate", STYLE_DEFAULTS["rotate"]):
            items.append(self._ctl(Input, key="rotate_deg", text="Начальный угол, градусы",
                                   default=str(STYLE_DEFAULTS["rotate_deg"]), subtext="От -360 до 360"))
        items += [
            self._ctl(S, key="scramble", text="Расшифровка", default=STYLE_DEFAULTS["scramble"],
                      icon="msg_secret_solar",
                      subtext="Сначала мелькают случайные символы, потом проступает буква"),
            self._ctl(S, key="glow", text="Подсветка новых букв", default=STYLE_DEFAULTS["glow"],
                      icon="msg_trending_solar", subtext="Свежая буква горит цветом и остывает до цвета текста"),
        ]
        if self._opt("glow", STYLE_DEFAULTS["glow"]):
            items.append(self._choice("glow_color", "Цвет подсветки", STYLE_DEFAULTS["glow_color"], PALETTE_NAMES))
        items.append(self._ctl(S, key="by_words", text="По словам", default=STYLE_DEFAULTS["by_words"],
                               icon="msg_edit", subtext="Проявляются целые слова, а не отдельные буквы"))
        return items

    def _cursor_items(self):
        items = [
            Header(text="Курсор"),
            self._choice("cursor_style", "Вид курсора", STYLE_DEFAULTS["cursor_style"], CURSOR_NAMES,
                         icon="msg_channel_14_solar"),
        ]
        if self._cursor_style() != 0:
            items += [
                self._ctl(Switch, key="cursor_blink", text="Мигание", default=STYLE_DEFAULTS["cursor_blink"],
                          subtext="Курсор плавно пульсирует"),
                self._choice("cursor_color", "Цвет курсора", STYLE_DEFAULTS["cursor_color"],
                             ["Как текст", "Как подсветка"]),
            ]
        return items

    def _speed_items(self):
        items = [
            Header(text="Скорость"),
            self._ctl(Input, key="cps", text="Символов в секунду", default=str(DEFAULTS["cps"]),
                      icon="msg_speed", subtext="Скорость постоянная, поэтому длинное сообщение печатается "
                                                "дольше короткого. От 5 до 400"),
            self._ctl(Input, key="max_sec", text="Не дольше, секунд", default=DEFAULTS["max_sec"],
                      icon="msg_contacts_time_solar",
                      subtext="Очень длинное сообщение ускоряется, чтобы уложиться в это время"),
            self._ctl(Switch, key="jitter", text="Живая скорость", default=True,
                      subtext="Текст то ускоряется, то притормаживает, как настоящий стриминг"),
            Header(text="Паузы"),
            # ключ новый: у тех, кто включал старую "паузу после первых символов",
            # сохранённое значение больше не действует и пауза выключена
            self._ctl(Switch, key="word_pause", text="Пауза после первого слова", default=False,
                      subtext="Первое слово, пауза, дальше ровно, как у DeepSeek. Со стороны похоже "
                              "на подвисание"),
        ]
        if self._opt("word_pause", False):
            items.append(self._ctl(Input, key="start_pause_ms", text="Длительность паузы, мс",
                                   default=str(DEFAULTS["start_pause_ms"]), subtext="От 100 до 3000"))
        items.append(self._ctl(Switch, key="punct_pause", text="Паузы на знаках препинания", default=False,
                               subtext="Текст запинается на точках и запятых, как будто думает"))
        if self._opt("punct_pause", False):
            items.append(self._ctl(Input, key="punct_ms", text="Пауза на точке, мс",
                                   default=str(DEFAULTS["punct_ms"]),
                                   subtext="На запятой вдвое короче. От 50 до 3000"))
        return items

    def _where_items(self):
        return [
            Header(text="Где анимировать"),
            self._ctl(Switch, key="only_private", text="Только личные чаты", default=False,
                      subtext="Не анимировать сообщения в группах и каналах"),
            self._ctl(Switch, key="animate_outgoing", text="Анимировать свои сообщения", default=False,
                      subtext="Проявлять эффектом и ваши отправленные"),
            self._ctl(Input, key="max_len", text="Максимальная длина", default=str(DEFAULTS["max_len"]),
                      subtext="Сообщения длиннее показываются сразу"),
            self._ctl(Input, key="max_active", text="Одновременно не больше", default=str(DEFAULTS["max_active"]),
                      subtext="Сколько сообщений проявляются разом, лишние показываются сразу. "
                              "Ждущие своей очереди не считаются. Меньше значит легче телефону"),
        ]

    def _behavior_items(self):
        # иконки не ставим: непроверенное имя иконки роняет экран настроек
        items = [
            Divider(),
            Header(text="Поведение"),
            self._ctl(Switch, key="grow_bubble", text="Пузырь растёт с текстом", default=False,
                      subtext="Облачко не появляется сразу во весь размер, а растёт по мере печати. "
                              "Для входящих текстовых сообщений без цитат, кода и превью ссылок"),
            self._ctl(Switch, key="queue", text="Сообщения по очереди", default=False,
                      subtext="Следующее сообщение появляется в чате, только когда допечатается "
                              "предыдущее. Ваш ответ показывает всё сразу"),
        ]
        if self._opt("queue", False):
            items += [
                self._ctl(Input, key="queue_gap_ms", text="Пауза между сообщениями, мс",
                          default=str(DEFAULTS["queue_gap_ms"]), subtext="От 0 до 3000"),
                self._ctl(Input, key="queue_wait_sec", text="Ждать не дольше, секунд",
                          default=str(DEFAULTS["queue_wait_sec"]),
                          subtext="Дольше ждавшие показываются сразу. 0 без ограничения (но не больше 2 минут)"),
                self._ctl(Input, key="queue_max", text="Ждут не больше",
                          default=str(DEFAULTS["queue_max"]),
                          subtext="Сколько сообщений ждут в одном чате. Если больше, текущее "
                                  "допечатывается сразу и очередь идёт дальше. От 1 до 20"),
            ]
        return items

    def create_settings(self):
        # SDK пересобирает экран после каждой смены настройки и после сброса
        # настроек (сброс on_change не вызывает): тут же сверяем ядро с тем, что
        # сохранено, и на SDK без on_change настройки тоже доходят до ядра
        try:
            if getattr(self, "_m", None) is not None and hasattr(self, "_timers"):
                self._apply_mode()
                self._restart_tick()
        except Exception:
            pass
        status = getattr(self, "_core_status", "ещё не загружено")
        if self._opt("classic", False) and getattr(self, "_core", None) is not None:
            mode = "Сейчас: классический режим (выбран вручную)"
        elif status is None:
            mode = f"Сейчас: нативный режим, ядро {CORE_VERSION}"
        else:
            mode = f"Сейчас: классический режим. Нативный недоступен: {status}"
        items = [
            Header(text="Neural Typing"),
            self._ctl(Switch, key="enabled", text="Включено", default=True),
        ]
        items += self._preview_items()
        items.append(self._choice("style", "Стиль анимации", 0, PRESET_NAMES, icon="msg_photo_curve_solar"))
        items += self._page("Появление букв", "msg_photo_blur_solar", self._look_items)
        items += self._page("Курсор", "msg_channel_14_solar", self._cursor_items)
        items += self._page("Скорость и паузы", "msg_speed", self._speed_items)
        items += self._page("Где анимировать", "msg_list_solar", self._where_items)
        if FEATURES_LATER:
            items += self._behavior_items()
        items += [
            Divider(),
            Header(text="Дополнительно"),
            Text(text="Режим работы", subtext=mode),
            self._ctl(Switch, key="blur_save", text="Экономить на размытии", default=True,
                      icon="msg_photo_blur_solar",
                      subtext="Пока текст печатается под размытым полем ввода, размытие не "
                              "пересчитывается каждый кадр. Меньше лагов"),
            self._ctl(Switch, key="classic", text="Классический режим", default=False,
                      subtext="Старая печать с перестройкой текста, как в 1.3. Нужна, если "
                              "нативный режим повёл себя странно"),
            self._ctl(Switch, key="debug", text="Запись диагностики", default=False,
                      icon="msg_settings_solar",
                      subtext="Пишет ход работы в neural_typing_log.txt: для каждого "
                              "сообщения план и факт длительности, пропущенные кадры"),
        ]
        return items
