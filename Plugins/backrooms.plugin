# Файл сгенерирован catalib (https://github.com/cataIystdev/catalib) из модульного дерева исходников.
# Редактировать вручную не следует: правьте исходники и пересоберите.
__id__ = 'backrooms'
__name__ = 'Backrooms'
__version__ = '1.1.0'
__description__ = 'Процедурный хоррор-лабиринт Backrooms на Three.js внутри WebView'
__author__ = '@RoflPlugins & @CatalystDevPlugins'

"""Встраиваемый загрузчик модульного плагина.

Исходник этого модуля целиком встраивается в собранный ``<plugin_id>.py``.
Он не зависит ни от чего, кроме стандартной библиотеки, и не порождает
процессы (подпроцессы в Chaquopy недоступны).

Идея: собранный файл импортируется exteraGram как модуль ``<plugin_id>``.
Этот модуль объявляется пакетом, а все исходные модули плагина
регистрируются как его подмодули ``<plugin_id>.<имя>`` через собственный
finder в ``sys.meta_path``. Имена уникальны, так как ``<plugin_id>``
уникален в exteraGram. Каждый модуль компилируется с собственным origin и
регистрируется в ``linecache`` — трейсбеки указывают на исходные файлы.
"""

import importlib
import importlib.util
import linecache
import sys

#: Ключ в ``sources``: значение — кортеж ``(исходник, признак_пакета, origin)``.
#: Ключи — полные рантайм-имена модулей (``<plugin_id>`` и ``<plugin_id>.*``).


class _CatalibLoader:
    """Загрузчик одного встроенного модуля из строки-исходника."""

    def __init__(self, plugin_id, source, origin, is_package):
        self._catalib_plugin = plugin_id
        self._source = source
        self._origin = origin
        self._is_package = is_package

    def create_module(self, spec):
        """Использовать стандартное создание модуля."""
        return None

    def exec_module(self, module):
        """Зарегистрировать исходник в linecache и исполнить модуль."""
        linecache.cache[self._origin] = (
            len(self._source),
            None,
            self._source.splitlines(keepends=True),
            self._origin,
        )
        # Пометка: модуль создан встроенным загрузчиком из этого плагина.
        # По ней при следующей загрузке вычищается устаревшая вендоренная
        # копия (общее имя catalib.* в sys.modules между деплоями).
        module.__catalib_vendored__ = self._catalib_plugin
        code = compile(self._source, self._origin, "exec")
        exec(code, module.__dict__)


class _CatalibFinder:
    """Finder в ``sys.meta_path``, отдающий подмодули конкретного плагина."""

    def __init__(self, plugin_id, sources):
        self._catalib_plugin = plugin_id
        self._sources = sources

    def find_spec(self, fullname, path=None, target=None):
        """Вернуть spec для встроенного подмодуля плагина либо ``None``."""
        entry = self._sources.get(fullname)
        if entry is None or fullname == self._catalib_plugin:
            return None
        source, is_package, origin = entry
        loader = _CatalibLoader(self._catalib_plugin, source, origin, is_package)
        return importlib.util.spec_from_loader(
            fullname, loader, origin=origin, is_package=is_package
        )


def _find_plugin_class(namespace, entry_module_name):
    """Найти класс плагина, определённый в модуле точки входа.

    Учитываются только классы, объявленные именно в модуле ``entry_module_name``
    (импортированные ``CatalibPlugin``/``BasePlugin`` и т. п. исключаются по
    ``__module__``). Принадлежность к плагину определяется строгой проверкой
    через ``base_plugin.BasePlugin``, а при отсутствии SDK — по именам базовых
    классов в MRO.
    """
    base_cls = None
    try:
        import base_plugin

        base_cls = base_plugin.BasePlugin
    except Exception:
        base_cls = None

    candidates = []
    for value in namespace.values():
        if not isinstance(value, type):
            continue
        if getattr(value, "__module__", None) != entry_module_name:
            continue
        if base_cls is not None:
            if issubclass(value, base_cls) and value is not base_cls:
                candidates.append(value)
        else:
            base_names = {klass.__name__ for klass in value.__mro__[1:]}
            if base_names & {"BasePlugin", "CatalibPlugin"}:
                candidates.append(value)
    for value in candidates:
        if getattr(value, "__catalib_plugin__", False):
            return value
    return candidates[0] if candidates else None


def catalib_install(module_name, module_globals, sources, entry_fullname):
    """Активировать встроенный загрузчик плагина.

    :param module_name: имя верхнего модуля (``<plugin_id>``).
    :param module_globals: ``globals()`` собранного модуля.
    :param sources: отображение «полное имя -> (исходник, пакет?, origin)».
    :param entry_fullname: полное имя модуля точки входа.
    """
    # Снять прежние finder'ы и подмодули этого плагина (безопасный reload).
    sys.meta_path[:] = [
        f for f in sys.meta_path if getattr(f, "_catalib_plugin", None) != module_name
    ]
    prefix = module_name + "."
    for name in [n for n in sys.modules if n.startswith(prefix)]:
        del sys.modules[name]

    # Вычистить устаревшие вендоренные модули (catalib.support и т. п.):
    # имя catalib.* общее между плагинами, и в общем sys.modules могла
    # остаться копия из прошлого деплоя/другого плагина (в т. ч. собранная
    # старым загрузчиком без пометки). Признак вендоренного модуля —
    # пометка __catalib_vendored__ ИЛИ синтетический origin вида
    # "<...>" (его ставит встроенный загрузчик). Настоящий host-catalib
    # (тесты) имеет origin-путь файла и не трогается.
    def _is_vendored(mod):
        if getattr(mod, "__catalib_vendored__", None) is not None:
            return True
        spec = getattr(mod, "__spec__", None)
        origin = getattr(spec, "origin", None) if spec is not None else None
        return isinstance(origin, str) and origin.startswith("<")

    for name in [
        n
        for n, mod in list(sys.modules.items())
        if (n == "catalib" or n.startswith("catalib.")) and _is_vendored(mod)
    ]:
        del sys.modules[name]

    sys.meta_path.insert(0, _CatalibFinder(module_name, sources))

    # Метаданные плагина задаются литералом ``__name__ = "<display>"``, что
    # перетирает реальное имя модуля и ломает относительные импорты.
    # Восстанавливаем идентичность модуля и делаем его пакетом.
    module_globals["__name__"] = module_name
    module_globals["__package__"] = module_name
    module_globals.setdefault("__path__", [])
    # Согласовать __spec__ с тем, что модуль теперь пакет, иначе Python
    # предупреждает о расхождении __package__ и __spec__.parent.
    spec = module_globals.get("__spec__")
    if spec is not None and getattr(spec, "submodule_search_locations", None) is None:
        spec.submodule_search_locations = []

    # Тело корневого модуля (src/__init__.py) исполнить в этом же модуле.
    root = sources.get(module_name)
    if root is not None:
        source, _is_package, origin = root
        linecache.cache[origin] = (
            len(source),
            None,
            source.splitlines(keepends=True),
            origin,
        )
        exec(compile(source, origin, "exec"), module_globals)

    # Импортировать точку входа и поднять класс плагина на верхний уровень.
    if entry_fullname != module_name:
        entry_module = importlib.import_module(entry_fullname)
        plugin_class = _find_plugin_class(vars(entry_module), entry_fullname)
        if plugin_class is not None and plugin_class.__name__ not in module_globals:
            module_globals[plugin_class.__name__] = plugin_class

_CATALIB_SOURCES = {
    'backrooms': ('"""Корневой пакет плагина Backrooms.\n\nМодульное дерево исходников. На устройстве становится модулем\n``backrooms``; подпакеты (``webview``, ``settings``, ``webui``) — его\nподмодули. Сборка в один файл выполняется catalib.\n"""\n', True, '<backrooms>/__init__.py'),
    'backrooms.config': ('"""Константы плагина Backrooms.\n\nЕдиный источник имён каталогов, версии web UI, ключей и значений по\nумолчанию настроек. Модуль не зависит от Android/SDK и тестируется\nофлайн.\n"""\n\nfrom __future__ import annotations\n\n#: Версия web UI. Маркер для решения об обновлении установленного\n#: ``index.html``: при изменении собранного UI значение увеличивается,\n#: установщик перезаписывает файл.\nUI_VERSION = "1.1.0"\n\n#: Имя каталога web UI внутри каталога данных плагина.\nWEBUI_DIRNAME = "backrooms_webui"\n\n#: Имя файла точки входа web UI.\nWEBUI_INDEX = "index.html"\n\n#: Имя файла-маркера с установленной версией web UI.\nWEBUI_VERSION_MARKER = ".version"\n\n#: Ключ настройки: всегда переустанавливать web UI при открытии.\n#: Полезно при отладке свежесобранного UI.\nSETTING_FORCE_REINSTALL = "backrooms_force_reinstall"\n\n#: Значение по умолчанию для :data:`SETTING_FORCE_REINSTALL`.\nDEFAULT_FORCE_REINSTALL = False\n\n#: Подпись пункта бокового меню запуска игры.\nMENU_LAUNCH_TEXT = "Backrooms"\n\n#: Подпись кликабельной строки запуска на странице настроек.\nSETTINGS_LAUNCH_TEXT = "Запустить"\n', False, '<backrooms>/config.py'),
    'backrooms.plugin': ('"""Точка входа плагина Backrooms.\n\nЕдинственный подкласс :class:`~catalib.support.CatalibPlugin` в модуле\nточки входа. Хук-меню и регистрация — автоматические (мини-фреймворк\ncatalib). Метаданные (включая автора «@RoflPlugins &\n@CatalystDevPlugins») берутся из ``catalib.toml`` и эмитятся сборкой\nстроковыми литералами.\n\nЗапуск игры — пунктом бокового меню «Backrooms» (надёжный путь для\ncatalib) и кликом по строке «Запустить» на странице настроек.\n"""\n\nfrom __future__ import annotations\n\nfrom typing import Any\n\nfrom catalib.support import CatalibPlugin, log, menu_item\n\nfrom . import config\nfrom .settings.schema import build_settings\nfrom .webview.dialog import open_webview_dialog\n\n\nclass BackroomsPlugin(CatalibPlugin):\n    """Backrooms — процедурный хоррор-лабиринт в полноэкранном WebView."""\n\n    def on_load(self) -> None:\n        """Пользовательская инициализация плагина."""\n        log("[Backrooms] плагин загружен")\n\n    def _force_reinstall(self) -> bool:\n        """Прочитать настройку принудительной переустановки web UI."""\n        return bool(\n            self.get_setting(config.SETTING_FORCE_REINSTALL, config.DEFAULT_FORCE_REINSTALL)\n        )\n\n    def _launch(self) -> None:\n        """Открыть игру (установив web UI с учётом настройки)."""\n        open_webview_dialog(force=self._force_reinstall())\n\n    @menu_item(config.MENU_LAUNCH_TEXT, menu_type="DRAWER_MENU")\n    def launch_from_menu(self, context: dict) -> None:\n        """Обработчик пункта бокового меню: запустить игру.\n\n        :param context: контекст вызова пункта меню (не используется).\n        """\n        self._launch()\n\n    def settings(self) -> list[Any]:\n        """Элементы страницы настроек (декларативно).\n\n        Кликабельная строка «Запустить» включена как запасной путь к\n        запуску в дополнение к пункту бокового меню. Построение элементов\n        для exteraGram выполняет унаследованный ``create_settings``.\n        """\n        return build_settings(lambda *_args: self._launch())\n', False, '<backrooms>/plugin.py'),
    'backrooms.settings': ('"""Декларативная схема настроек плагина.\n\nСодержит построение элементов страницы настроек и фабрику кликабельной\nстроки запуска игры (запасной путь к запуску помимо пункта меню).\n"""\n', True, '<backrooms>/settings/__init__.py'),
    'backrooms.settings.schema': ('"""Декларативная схема настроек, включая кликабельную строку запуска.\n\nВсе элементы описываются типобезопасно через ``catalib.support.settings``.\nКликабельная строка «Запустить» строится первоклассным API\n``settings.text(..., on_click=...)`` и служит запасным путём к запуску\nпомимо пункта бокового меню.\n"""\n\nfrom __future__ import annotations\n\nfrom collections.abc import Callable\nfrom typing import Any\n\nfrom catalib.support import SettingItem, settings\n\nfrom .. import config\n\n\ndef build_settings(on_launch: Callable[..., Any]) -> list[SettingItem]:\n    """Элементы страницы настроек плагина.\n\n    :param on_launch: вызывается при клике по строке «Запустить»\n        (дополнительный путь к запуску помимо пункта бокового меню).\n    :returns: список элементов: заголовок, переключатель принудительной\n        переустановки web UI, информационная строка о запуске, разделитель\n        и кликабельная строка «Запустить».\n    """\n    return [\n        settings.header("Backrooms"),\n        settings.switch(\n            config.SETTING_FORCE_REINSTALL,\n            "Всегда переустанавливать web UI",\n            default=config.DEFAULT_FORCE_REINSTALL,\n            subtext="Полезно при отладке свежесобранного интерфейса",\n        ),\n        settings.text(\n            "Запуск: пункт бокового меню «Backrooms»",\n            subtext="Либо строка «Запустить» ниже",\n        ),\n        settings.divider(),\n        settings.text(config.SETTINGS_LAUNCH_TEXT, on_click=on_launch),\n    ]\n', False, '<backrooms>/settings/schema.py'),
    'backrooms.webui': ('"""Сборка web UI плагина в единый ``index.html``.\n\ncatalib бандлит только Python-модули, поэтому web UI хранится строковыми\nконстантами модулей. Модульность — в разбиении на когезивные части\n(скелет документа, стили, игровой JS по подсистемам) и сборке билдером.\n"""\n', True, '<backrooms>/webui/__init__.py'),
    'backrooms.webui.builder': ('"""Сборка финального ``index.html`` web UI из модулей.\n\nБилдер соединяет HTML-скелет (`document`), стили (`styles`) и собранный\nигровой ``<script>`` (`game.assembly`). catalib бандлит только Python,\nпоэтому web UI хранится строковыми константами модулей, а единый\nдокумент собирается здесь.\n"""\n\nfrom __future__ import annotations\n\nfrom .document import BODY_DOM, HEAD, THREE_CDN\nfrom .game.assembly import game_script\nfrom .styles import CSS\n\n\ndef build_index_html() -> str:\n    """Собрать полный документ ``index.html`` страницы web UI.\n\n    :returns: HTML-документ: голова и стили, DOM тела, CDN Three.js и\n        единственный ``<script>`` с собранным игровым кодом.\n    """\n    head = HEAD.strip("\\n")\n    body_dom = BODY_DOM.strip("\\n")\n    css = CSS.strip("\\n")\n    return (\n        f"{head}\\n"\n        f"    <style>\\n{css}\\n    </style>\\n"\n        f"</head>\\n"\n        f"<body>\\n"\n        f"{body_dom}\\n\\n"\n        f"    {THREE_CDN}\\n"\n        f"    <script>\\n"\n        f"{game_script()}\\n"\n        f"    </script>\\n"\n        f"</body>\\n"\n        f"</html>\\n"\n    )\n', False, '<backrooms>/webui/builder.py'),
    'backrooms.webui.document': ('"""HTML-скелет страницы web UI: голова документа, DOM тела, CDN.\n\nСтили и игровой JS подставляются билдером отдельно.\n"""\n\nHEAD = r"""\n<!DOCTYPE html>\n<html lang="ru">\n<head>\n    <meta charset="UTF-8">\n    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no, maximum-scale=1.0">\n    <title>Generative Horror Maze - Backrooms Bodycam</title>\n"""\n\nBODY_DOM = r"""\n    <div id="start-menu">\n        <h1>AXN_SYSTEM_BOOT</h1>\n        <p>SELECT VISUAL PROFILE</p>\n        <button class="quality-btn" onclick="startBootSequence(\'LOW\')">LOW <span>Performance</span></button>\n        <button class="quality-btn" onclick="startBootSequence(\'MEDIUM\')">MEDIUM <span>Balanced</span></button>\n        <button class="quality-btn" onclick="startBootSequence(\'HIGH\')">HIGH <span>Quality</span></button>\n        <button class="quality-btn" onclick="startBootSequence(\'ULTRA\')">ULTRA <span>Full Shadows (GPU Heavy)</span></button>\n    </div>\n\n    <div id="loading-screen">\n        <div id="loading-log"></div>\n    </div>\n\n    <div id="game-container">\n        <div id="bodycam-hud">\n            <div class="rec-container"><div class="rec-dot"></div> REC</div>\n            <div class="hud-top-right">AXN BODY 3<br><span id="time-display"></span></div>\n            <div class="hud-bottom">\n                <span>BAT 84%</span>\n                <span>MEM 23H 14M</span>\n                <span id="fps-display" class="fps-text">FPS --</span>\n            </div>\n        </div>\n        <div id="crosshair"></div>\n        <div id="boombox-indicator">\n            <div class="bb-arrow">▲</div>\n            <div class="bb-text">◈ SIGNAL DETECTED ◈</div>\n            <div class="bb-dist" id="boombox-dist-text"></div>\n        </div>\n        <div id="dev-panel">\n            <span>[ DEV MODE ACTIVE ]</span>\n            <button onclick="triggerDeath()">EXECUTE: DIE()</button>\n            <button onclick="spawnTest01()">SPAWN: test01</button>\n            <button onclick="forceSpawnExit()">SPAWN: EXIT</button>\n            <button onclick="spawnBoomboxDev()">SPAWN: BOOMBOX</button>\n            <button id="toggle-mode-btn" onclick="toggleMobMode()">MODE: HOSTILE</button>\n        </div>\n    </div>\n\n    <div id="death-screen">\n        <div class="signal-text">SIGNAL LOST</div>\n        <button id="respawn-btn" onclick="respawn()">REBOOT SYSTEM</button>\n    </div>\n    <div id="win-screen">\n        <div class="win-text">CONNECTION SECURED</div>\n        <button id="win-btn" onclick="location.reload()">EXTRACT</button>\n    </div>\n\n    <div id="joystick-zone"><div id="joystick-knob"></div></div>\n"""\n\n#: Единственная внешняя зависимость web UI — ядро Three.js r128.\n#: SSAO-пайплайн самодостаточен (свои render target и полноэкранные\n#: проходы), внешние postprocessing-аддоны не подключаются: это\n#: убирает класс отказов «не запускается на части устройств».\nTHREE_CDN = \'<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>\'\n', False, '<backrooms>/webui/document.py'),
    'backrooms.webui.game': ('"""Игровой JS, разложенный по смыслу.\n\nПакеты:\n\n- ``core`` — общий движок: игрок и камера, фонарик и пул освещения,\n  ввод, звук, пост-обработка, загрузка, главный цикл, константы и\n  состояние (то, что одинаково для всех или большинства уровней).\n- ``level0`` — контент этого уровня: сущности и их ИИ, бумбокс,\n  декали, исходы прохождения, хоррор-эффекты, а также подпакет\n  ``level0.map`` — карта именно этого уровня и её генерация\n  (лабиринт, утилиты сетки, текстуры, построение геометрии).\n\nКаждый модуль экспортирует строковую константу ``JS`` — фрагмент кода\nединственного ``<script>`` игры. Порядок склейки задаёт ``assembly.py``.\n"""\n', True, '<backrooms>/webui/game/__init__.py'),
    'backrooms.webui.game.assembly': ('"""Порядок склейки JS-фрагментов в единственный ``<script>`` игры.\n\nМодули сгруппированы по смыслу: пакет ``core`` (общий движок и игрок) и\nпакет ``level0`` (контент этого уровня), внутри которого лежит подпакет\n``level0.map`` (карта и генерация именно этого уровня). Порядок\nфрагментов сохраняет исходную последовательность кода: объявления\nфункций поднимаются (hoisting) в пределах одного скрипта, поэтому\nпорядок функциональных модулей на исполнение не влияет; верхнеуровневые\n``const``/``let`` сгруппированы в начальных фрагментах (``constants``,\n``state``), а единственные исполняемые на этапе загрузки выражения\n(таймер времени, регистрация ресайза) — соответственно в начале и в\nконце.\n"""\n\nfrom __future__ import annotations\n\nfrom .core import (\n    audio,\n    boot,\n    constants,\n    lighting,\n    loop,\n    player,\n    postprocessing,\n    ssao,\n    state,\n)\nfrom .core import input as input_module\nfrom .level0 import ai, boombox, decals, entities, horror, outcomes\nfrom .level0.map import environment, generation\n\n#: Упорядоченные фрагменты JS единственного ``<script>`` игры.\n#: Последовательность совпадает с исходной (поведение неизменно).\nGAME_FRAGMENTS: tuple[str, ...] = (\n    constants.JS,\n    state.JS,\n    boombox.JS,\n    decals.JS,\n    boot.JS,\n    generation.JS,\n    environment.JS,\n    lighting.JS,\n    ssao.JS,\n    postprocessing.JS,\n    entities.JS,\n    outcomes.JS,\n    audio.JS,\n    input_module.JS,\n    ai.JS,\n    loop.JS,\n    player.JS,\n    horror.JS,\n)\n\n\ndef game_script() -> str:\n    """Собрать тело игрового ``<script>`` из упорядоченных фрагментов."""\n    return "\\n".join(fragment.strip("\\n") for fragment in GAME_FRAGMENTS)\n', False, '<backrooms>/webui/game/assembly.py'),
    'backrooms.webui.game.core': ('"""Общее ядро игры: то, что одинаково для всех (или большинства) уровней.\n\nИгрок и камера, фонарик и инфраструктура освещения (пул света/теней),\nввод, звук, пост-обработка, загрузка, главный цикл, игровые константы и\nглобальное состояние. Уровень-специфичный контент — в пакете\n``level0``; карта и её генерация — в пакете ``map``.\n"""\n', True, '<backrooms>/webui/game/core/__init__.py'),
    'backrooms.webui.game.core.audio': ('"""Процедурный хум, эмбиент и звук шагов."""\n\nJS = r"""\n\n    /* ============================================================\n       ЗВУК\n    ============================================================ */\n    function createHumBuffer(ctx){\n        const length=ctx.sampleRate*1.0, buffer=ctx.createBuffer(1,length,ctx.sampleRate);\n        const data=buffer.getChannelData(0);\n        for(let i=0;i<length;i++){\n            const t=i/ctx.sampleRate;\n            const saw=2*(t*60-Math.floor(t*60+0.5));\n            const sine=Math.sin(2*Math.PI*120*t);\n            data[i]=(saw*0.05)+(sine*0.1);\n        }\n        return buffer;\n    }\n    function scheduleNextRandomSound(){\n        nextRandomSoundTime=time+RANDOM_SOUNDS_CONFIG.minDelay+Math.random()*(RANDOM_SOUNDS_CONFIG.maxDelay-RANDOM_SOUNDS_CONFIG.minDelay);\n    }\n    function playRandomAmbientSound(){\n        if(randomAudioBuffers.length===0)return;\n        if(ambientSoundPlayer.isPlaying)ambientSoundPlayer.stop();\n        ambientSoundPlayer.setBuffer(randomAudioBuffers[Math.floor(Math.random()*randomAudioBuffers.length)]);\n        ambientSoundPlayer.play();\n    }\n    function playFootstepSound(volume=0.3){\n        if(!audioCtx)return;\n        const osc=audioCtx.createOscillator(), gn=audioCtx.createGain();\n        osc.type=\'sine\'; osc.frequency.setValueAtTime(120,audioCtx.currentTime);\n        osc.frequency.exponentialRampToValueAtTime(30,audioCtx.currentTime+0.1);\n        gn.gain.setValueAtTime(volume,audioCtx.currentTime);\n        gn.gain.exponentialRampToValueAtTime(0.01,audioCtx.currentTime+0.15);\n        osc.connect(gn); gn.connect(audioCtx.destination);\n        osc.start(); osc.stop(audioCtx.currentTime+0.2);\n    }\n"""\n', False, '<backrooms>/webui/game/core/audio.py'),
    'backrooms.webui.game.core.boot': ('"""Загрузка: профиль качества, инициализация, аудио-ассеты."""\n\nJS = r"""\n\n    /* ============================================================\n       ЗАГРУЗКА\n    ============================================================ */\n    async function startBootSequence(quality){\n        graphicsQuality=quality;\n        lampSettings = LAMP_QUALITY_TABLE[quality] || LAMP_QUALITY_TABLE.HIGH;\n        MAX_LAMPS = lampSettings.maxLamps;\n        document.getElementById(\'start-menu\').style.display=\'none\';\n        const ls=document.getElementById(\'loading-screen\');\n        const logContainer=document.getElementById(\'loading-log\');\n        ls.style.display=\'flex\';\n        const log=async(msg,delay=100)=>{\n            const span=document.createElement(\'div\'); span.innerText=`> ${msg}`;\n            logContainer.appendChild(span); logContainer.scrollTop=logContainer.scrollHeight;\n            if(delay>0) await new Promise(r=>setTimeout(r,delay));\n        };\n        try{\n            await log("AXN_OS v3.11.4 INITIALIZING...",300);\n            await log(`Setting graphics profile to [${quality}]`,150);\n            await log("Mounting virtual environment...",200);\n\n            scene=new THREE.Scene();\n            scene.fog=new THREE.FogExp2(0x1a1813,LIGHTING_SETTINGS.fogDensity);\n            camera=new THREE.PerspectiveCamera(baseFov,window.innerWidth/window.innerHeight,0.1,50);\n            targetEuler.setFromQuaternion(camera.quaternion);\n            flashlightEuler.copy(targetEuler); cameraEuler.copy(targetEuler);\n\n            renderer=new THREE.WebGLRenderer({antialias:false,powerPreference:"high-performance"});\n            renderer.setSize(window.innerWidth,window.innerHeight);\n            \n            // Настройка графики\n            if(graphicsQuality===\'LOW\'){\n                renderer.setPixelRatio(0.7); renderer.shadowMap.enabled=false;\n            } else if(graphicsQuality===\'MEDIUM\'){\n                renderer.setPixelRatio(1.0); renderer.shadowMap.enabled=true; renderer.shadowMap.type=THREE.PCFShadowMap;\n            } else if(graphicsQuality===\'HIGH\') {\n                renderer.setPixelRatio(Math.min(window.devicePixelRatio,1.2));\n                renderer.shadowMap.enabled=true; renderer.shadowMap.type=THREE.PCFSoftShadowMap;\n            } else if(graphicsQuality===\'ULTRA\') {\n                renderer.setPixelRatio(Math.min(window.devicePixelRatio,1.5));\n                renderer.shadowMap.enabled=true; renderer.shadowMap.type=THREE.PCFSoftShadowMap;\n            }\n            \n            renderer.setClearColor(0x1a1813,1.0);\n            renderer.outputEncoding=THREE.sRGBEncoding;\n            renderer.toneMapping=THREE.ACESFilmicToneMapping;\n            renderer.toneMappingExposure=0.8;\n            document.getElementById(\'game-container\').appendChild(renderer.domElement);\n            clock=new THREE.Clock();\n            setupPostProcessing();\n\n            await log("Fetching texture maps...",100);\n            const tLoader=new THREE.TextureLoader();\n            const loadT=url=>new Promise(res=>tLoader.load(url,res,undefined,()=>res(null)));\n            await Promise.all([\n                loadT(WALL_CONFIG.textureUrl).then(t=>preloadedTextures.wall=t),\n                loadT(FLOOR_CONFIG.textureUrl).then(t=>preloadedTextures.floor=t),\n                loadT(CEILING_CONFIG.textureUrl).then(t=>preloadedTextures.ceiling=t)\n            ]);\n\n            await log("Loading wall decals...",100);\n            await Promise.all(DECAL_CONFIG.items.map(async item=>{\n                const t=await loadT(item.url);\n                if(t){t.encoding=THREE.sRGBEncoding; loadedDecals.push({tex:t,weight:item.weight,size:item.size});}\n            }));\n            await log("Texture maps parsed successfully.",100);\n\n            await log("Generating procedural maze topology...",200);\n            generateMazeData();\n            await log("Compiling geometry and entities...",100);\n            buildEnvironment();\n            setupLighting();\n\n            await log("Initializing audio drivers...",100);\n            // Сбой аудио-подсистемы не должен ронять всю загрузку (иначе\n            // тихо пропадают и игра, и звук). Логируем и продолжаем.\n            try{ await preloadAudioAssets(); }\n            catch(audioErr){ console.error("[audio] preloadAudioAssets упал: "+(audioErr&&audioErr.message||audioErr)); }\n            setupInputs();\n            const humStride=Math.max(1,Math.ceil(lamps.length/LAMP_HUM_MAX));\n            lamps.forEach((l,i)=>{\n                if(!l.anchor)return;\n                if(i%humStride!==0)return;\n                const sound=new THREE.PositionalAudio(audioListener);\n                sound.setBuffer(humBuffer);\n                sound.setRefDistance(3); sound.setMaxDistance(12); sound.setRolloffFactor(2); sound.setLoop(true);\n                l.anchor.add(sound);\n                l.sound=sound;\n            });\n\n            await log("ALL SYSTEMS NOMINAL. READY FOR CONNECTION.",500);\n            const finalMsg=document.createElement(\'div\');\n            finalMsg.innerText="> [ PRĒßS ÅNY KÊY ØR TĀP TÕ ÇÖÑNÊCT]";\n            finalMsg.className="blinking-cursor"; finalMsg.style.color="#fff"; finalMsg.style.marginTop="20px";\n            logContainer.appendChild(finalMsg); logContainer.scrollTop=logContainer.scrollHeight;\n\n            const startHandler=e=>{\n                if(e.type===\'pointerdown\'&&e.target.closest(\'#dev-panel\'))return;\n                document.removeEventListener(\'pointerdown\',startHandler);\n                document.removeEventListener(\'keydown\',startHandler);\n                ls.style.display=\'none\';\n                document.getElementById(\'game-container\').style.display=\'block\';\n                if(devMode) document.getElementById(\'dev-panel\').style.display=\'flex\';\n                if(audioCtx&&audioCtx.state===\'suspended\')audioCtx.resume();\n                lamps.forEach(l=>{if(l.sound)l.sound.play();});\n                audioInitialized=true;\n                setupBoomboxRadioAudio();\n                if(!isMobile&&document.body.requestPointerLock)document.body.requestPointerLock();\n                isStarted=true;\n                \n                // Сброс таймера FPS перед началом\n                lastFpsTime = performance.now();\n                fpsFrames = 0;\n                \n                animate();\n            };\n            document.addEventListener(\'pointerdown\',startHandler);\n            document.addEventListener(\'keydown\',startHandler);\n        } catch(err){\n            await log(`CRITICAL FAILURE: ${err.message}`,0);\n            await log("INIT SEQUENCE HALTED. PLEASE REFRESH.",0);\n            console.error(err);\n        }\n    }\n\n    async function preloadAudioAssets(){\n        window.AudioContext=window.AudioContext||window.webkitAudioContext;\n        if(!window.AudioContext){console.error("[audio] AudioContext API недоступен в этом WebView");return;}\n        audioCtx=new AudioContext();\n        console.log("[audio] AudioContext создан, state="+audioCtx.state);\n        audioListener=new THREE.AudioListener();\n        camera.add(audioListener);\n        ambientSoundPlayer=new THREE.Audio(audioListener);\n        ambientSoundPlayer.setVolume(RANDOM_SOUNDS_CONFIG.volume);\n        const aLoader=new THREE.AudioLoader();\n        // Ошибку загрузки не глотаем молча: иначе при недоступности\n        // хоста/CORS звук «просто пропадает» без следа в логах.\n        const loadA=url=>new Promise(res=>aLoader.load(url,res,undefined,\n            e=>{console.error("[audio] не загрузилось: "+url+" — "+((e&&(e.message||e.type))||e));res(null);}));\n        let p1=Promise.all(DEATH_SOUND_URLS.map(u=>loadA(u))).then(b=>deathSoundBuffers=b.filter(x=>x));\n        let p2=Promise.all(WIN_SOUND_URLS.map(u=>loadA(u))).then(b=>winSoundBuffers=b.filter(x=>x));\n        let p3=Promise.all(RANDOM_SOUNDS_CONFIG.urls.map(u=>loadA(u))).then(b=>randomAudioBuffers=b.filter(x=>x));\n        chaseSoundPlayer=new THREE.Audio(audioListener);\n        let p4=loadA(MONSTER_CONFIG.chaseSoundUrl).then(buf=>{\n            if(buf){chaseSoundPlayer.setBuffer(buf);chaseSoundPlayer.setLoop(true);chaseSoundPlayer.setVolume(0);}\n        });\n        await Promise.all([p1,p2,p3,p4]);\n        humBuffer=createHumBuffer(audioCtx);\n        scheduleNextRandomSound();\n    }\n"""\n', False, '<backrooms>/webui/game/core/boot.py'),
    'backrooms.webui.game.core.constants': ('"""Игровые константы и конфигурация пула освещения ламп."""\n\nJS = r"""\n    setInterval(() => {\n        const d = document.getElementById(\'time-display\');\n        if (d) d.innerText = new Date().toISOString().replace(\'T\',\' \').slice(0,19)+\'Z\';\n    }, 1000);\n\n    /* ===================== НАСТРОЙКИ ===================== */\n    let devMode = false;\n    let isDead = false, isWon = false;\n    let devMobMode = \'HOSTILE\';\n\n    const EXIT_RARITY         = 0.08;\n    const MIN_EXIT_DISTANCE   = 35.0;\n    const TEST01_RARITY       = 0.02;\n\n    const BACKROOMS_TINT_STRENGTH = 0.35;\n\n    const LAMP_SPAWN_CHANCE   = 0.16;\n    const LAMP_LIGHT_DISTANCE = 14;\n    const LAMP_HUM_MAX        = 24;\n    const LAMP_POOL_UPDATE_INTERVAL = 1 / 8;\n    const LAMP_QUALITY_TABLE = {\n        LOW:    { maxLamps: 70,  poolSize: 0,  shadowPool: 0 },\n        MEDIUM: { maxLamps: 110, poolSize: 12, shadowPool: 0 },\n        HIGH:   { maxLamps: 130, poolSize: 16, shadowPool: 2 },\n        ULTRA:  { maxLamps: 150, poolSize: 20, shadowPool: 4 }\n    };\n    let lampSettings = LAMP_QUALITY_TABLE.HIGH;\n    let MAX_LAMPS = lampSettings.maxLamps;\n\n    // Экранный детектор вогнутых рёбер (только ULTRA): затемняет\n    // СТРОГО стыки (вогнутость + расхождение нормалей), плоскости/\n    // выпуклости/края экрана дают ноль. Не полусферный SSAO.\n    // AO_STRENGTH   — множитель силы (crease мал — обычно 4..8);\n    // AO_POWER      — контраст кривой: >1 резче/уже, <1 шире/мягче;\n    // AO_BIAS       — порог вогнутости dot(к соседу, нормаль): срезает\n    //                 шум на плоскостях (больше — чище плоскости);\n    // AO_EDGE_PX    — радиус выборки соседей в пикселях (толщина линии\n    //                 стыка);\n    // AO_MAXDIFF    — макс. разрыв глубины соседа (ед. вида): дальше —\n    //                 игнор, чтобы фон/край экрана/другой объект НЕ\n    //                 чернели;\n    // AO_BLUR       — половина окна bilateral-blur (денойз линии);\n    // AO_BLUR_DEPTH — порог глубины в blur (ед. мира): стык не мажется;\n    // AO_FADE_START — дистанция (ед. вида), с которой AO гаснет;\n    // AO_FADE_END   — где гаснет полностью (дальний шум точности).\n    const AO_STRENGTH   = 6.0;\n    const AO_POWER      = 1.0;\n    const AO_BIAS       = 0.05;\n    const AO_EDGE_PX    = 3.0;\n    const AO_MAXDIFF    = 1.0;\n    const AO_BLUR       = 3;\n    const AO_BLUR_DEPTH = 0.5;\n    const AO_FADE_START = 6.0;\n    const AO_FADE_END   = 16.0;\n\n    const DECAL_CONFIG = {\n        globalChance: 1.58,\n        items: [\n            { url: "https://files.nothalk.fun/sounds/d.png",  weight: 40, size: 3 },\n            { url: "https://files.nothalk.fun/sounds/d2.png", weight: 40, size: 3 },\n            { url: "https://files.nothalk.fun/sounds/d3.png", weight: 40, size: 3 },\n            { url: "https://files.nothalk.fun/sounds/d4.png", weight: 40, size: 3 }\n        ]\n    };\n    let loadedDecals = [];\n\n    const MONSTER_CONFIG = {\n        speedPassive: 1.5, speedHostile: 4.5, aggroRadius: 12.0, radius: 0.4,\n        chaseSoundUrl: "https://files.nothalk.fun/sounds/chase.mp3", chaseVolume: 0.8\n    };\n    const BOOMBOX_MIN_DISTANCE = 2.0;\n    const BOOMBOX_CONFIG = {\n        sizeScale: 0.1, maxVolume: 0.3, maxHearDist: 55.0,\n        bassBoostGain: 15.0, reverbDry: 0.8, reverbWet: 1.3,\n        musicUrls: [\n            "https://files.nothalk.fun/sounds/radio.mp3",\n            "https://files.nothalk.fun/sounds/radio2.mp3"\n        ]\n    };\n\n    let boomboxObject=null, boomboxAudioSource=null, boomboxGainNode=null;\n    let boomboxBassNode=null, boomboxDryNode=null, boomboxWetNode=null, boomboxNearby=false;\n\n    let deathState = {\n        velocityY: 0, velocityXZ: new THREE.Vector3(),\n        angularVelocity: new THREE.Vector3(), gravity: 25.0, floorY: 0.2\n    };\n    let winTargetPos = null, impactEndTime = 0;\n\n    const LIGHTING_SETTINGS = {\n        ambientBrightness: 0.02, flashlightBrightness: 2.5,\n        flashlightDistance: 20, fogDensity: 0.01\n    };\n    const RANDOM_SOUNDS_CONFIG = {\n        urls: [\n            "https://files.nothalk.fun/sounds/1.mp3","https://files.nothalk.fun/sounds/2.mp3",\n            "https://files.nothalk.fun/sounds/3.mp3","https://files.nothalk.fun/sounds/4.mp3",\n            "https://files.nothalk.fun/sounds/5.mp3"\n        ],\n        volume: 0.1, minDelay: 50, maxDelay: 150\n    };\n    const DEATH_SOUND_URLS = ["https://files.nothalk.fun/sounds/die.mp3","https://files.nothalk.fun/sounds/die3.mp3"];\n    let deathSoundBuffers = [];\n    const WIN_SOUND_URLS   = ["https://files.nothalk.fun/sounds/1.mp3"];\n    let winSoundBuffers    = [];\n\n    const WALL_CONFIG = {\n        textureUrl: "https://files.nothalk.fun/sounds/wall.jpg",\n        bumpScale: 0.15, roughness: 0.8, metalness: 0.05, textureRepeat: 1\n    };\n    const FLOOR_CONFIG = {\n        textureUrl: "https://files.nothalk.fun/sounds/floor.jpg",\n        bumpScale: 0.1, roughness: 1.5, metalness: 0, textureRepeat: 45\n    };\n    const CEILING_CONFIG = {\n        textureUrl: "https://files.nothalk.fun/sounds/floor.jpg",\n        bumpScale: 0.1, roughness: 0.9, metalness: 0.0, textureRepeat: 45\n    };\n\n"""\n', False, '<backrooms>/webui/game/core/constants.py'),
    'backrooms.webui.game.core.input': ('"""Ввод: клавиатура, мышь, тач, ресайз окна."""\n\nJS = r"""\n\n    /* ============================================================\n       ВВОД\n    ============================================================ */\n    function setupInputs(){\n        document.addEventListener(\'keydown\',e=>onKey(e.code,true));\n        document.addEventListener(\'keyup\',e=>onKey(e.code,false));\n        if(!isMobile){\n            document.getElementById(\'crosshair\').style.display=\'block\';\n            document.addEventListener(\'mousemove\',onMouseMove);\n        } else {\n            document.getElementById(\'joystick-zone\').style.display=\'block\';\n            document.addEventListener(\'touchstart\',onTouchStart,{passive:false});\n            document.addEventListener(\'touchmove\',onTouchMove,{passive:false});\n            document.addEventListener(\'touchend\',onTouchEnd,{passive:false});\n        }\n    }\n    function onKey(code,isDown){\n        switch(code){\n            case\'KeyW\':case\'ArrowUp\':keys.w=isDown;break;\n            case\'KeyA\':case\'ArrowLeft\':keys.a=isDown;break;\n            case\'KeyS\':case\'ArrowDown\':keys.s=isDown;break;\n            case\'KeyD\':case\'ArrowRight\':keys.d=isDown;break;\n            case\'ShiftLeft\':case\'ShiftRight\':keys.shift=isDown;break;\n        }\n    }\n    function onMouseMove(e){\n        if(!isStarted||isMobile||isDead||isWon)return;\n        targetEuler.y-=(e.movementX||0)*0.002;\n        targetEuler.x-=(e.movementY||0)*0.002;\n        targetEuler.x=Math.max(-PI_2,Math.min(PI_2,targetEuler.x));\n    }\n    function onTouchStart(e){\n        if(!isStarted||isDead||isWon)return;\n        if(e.target.closest(\'#dev-panel\'))return;\n        for(let i=0;i<e.changedTouches.length;i++){\n            const t=e.changedTouches[i];\n            if(t.clientX<window.innerWidth/2){\n                touchLeft.active=true; touchLeft.id=t.identifier;\n                touchLeft.startX=t.clientX; touchLeft.startY=t.clientY;\n            } else {\n                touchRight.active=true; touchRight.id=t.identifier;\n                touchRight.lastX=t.clientX; touchRight.lastY=t.clientY;\n            }\n        }\n    }\n    function onTouchMove(e){\n        if(!isStarted||isDead||isWon)return;\n        if(e.target.closest(\'#dev-panel\'))return;\n        e.preventDefault();\n        for(let i=0;i<e.changedTouches.length;i++){\n            const t=e.changedTouches[i];\n            if(touchLeft.active&&t.identifier===touchLeft.id){\n                const maxDist=65;\n                let dx=t.clientX-touchLeft.startX, dy=t.clientY-touchLeft.startY;\n                let dist=Math.sqrt(dx*dx+dy*dy);\n                touchLeft.isSprinting=(dist>52);\n                if(dist>maxDist){dx=dx*(maxDist/dist);dy=dy*(maxDist/dist);}\n                touchLeft.deltaX=dx/maxDist; touchLeft.deltaY=dy/maxDist;\n                document.getElementById(\'joystick-knob\').style.transform=`translate(${dx}px,${dy}px)`;\n            }\n            if(touchRight.active&&t.identifier===touchRight.id){\n                targetEuler.y-=(t.clientX-touchRight.lastX)*0.005;\n                targetEuler.x-=(t.clientY-touchRight.lastY)*0.005;\n                targetEuler.x=Math.max(-PI_2,Math.min(PI_2,targetEuler.x));\n                touchRight.lastX=t.clientX; touchRight.lastY=t.clientY;\n            }\n        }\n    }\n    function onTouchEnd(e){\n        for(let i=0;i<e.changedTouches.length;i++){\n            const t=e.changedTouches[i];\n            if(touchLeft.active&&t.identifier===touchLeft.id){\n                touchLeft.active=false; touchLeft.deltaX=0; touchLeft.deltaY=0; touchLeft.isSprinting=false;\n                document.getElementById(\'joystick-knob\').style.transform=\'translate(0px,0px)\';\n            }\n            if(touchRight.active&&t.identifier===touchRight.id)touchRight.active=false;\n        }\n    }\n    function onWindowResize(){\n        if(!camera)return;\n        const w=window.innerWidth, h=window.innerHeight;\n        camera.aspect=w/h; camera.updateProjectionMatrix();\n        renderer.setSize(w,h);\n        if(usePostSSAO){\n            if(sceneRT){\n                sceneRT.setSize(w,h);\n                if(sceneRT.depthTexture){\n                    sceneRT.depthTexture.image.width=w;\n                    sceneRT.depthTexture.image.height=h;\n                    sceneRT.depthTexture.needsUpdate=true;\n                }\n            }\n            if(aoRT)aoRT.setSize(w,h);\n            if(aoBlurRT)aoBlurRT.setSize(w,h);\n            if(normalRT)normalRT.setSize(w,h);\n            // Свои ShaderMaterial — uniform\'ы живые (матрицы по ссылке),\n            // обновляем только resolution.\n            if(ssaoMat)ssaoMat.uniforms.resolution.value.set(w,h);\n            if(blurMat)blurMat.uniforms.resolution.value.set(w,h);\n            if(postUniforms&&postUniforms.resolution)postUniforms.resolution.value.set(w,h);\n        } else if(renderTarget){\n            renderTarget.setSize(w,h);\n            if(postUniforms&&postUniforms.resolution)postUniforms.resolution.value.set(w,h);\n        }\n    }\n"""\n', False, '<backrooms>/webui/game/core/input.py'),
    'backrooms.webui.game.core.lighting': ('"""Освещение и фиксированный пул источников света и теней ламп."""\n\nJS = r"""\n    let lampPool=[];\n    let lampPoolAcc=0;\n    let lampShadowCount=0;\n\n\n    /* ============================================================\n       ОСВЕЩЕНИЕ\n    ============================================================ */\n    function setupLighting(){\n        scene.add(new THREE.AmbientLight(0xffffff,LIGHTING_SETTINGS.ambientBrightness));\n        flashlight=new THREE.SpotLight(0xfffae6,LIGHTING_SETTINGS.flashlightBrightness,\n            LIGHTING_SETTINGS.flashlightDistance,Math.PI/5.5,0.6,3.5);\n        if(graphicsQuality!==\'LOW\'){\n            flashlight.castShadow=true;\n            flashlight.shadow.mapSize.width=(graphicsQuality===\'HIGH\'||graphicsQuality===\'ULTRA\')?1024:512;\n            flashlight.shadow.mapSize.height=(graphicsQuality===\'HIGH\'||graphicsQuality===\'ULTRA\')?1024:512;\n            flashlight.shadow.bias=-0.0005; flashlight.shadow.normalBias=0.02;\n            flashlight.shadow.camera.near=0.1; flashlight.shadow.camera.far=25;\n        }\n        scene.add(flashlight); scene.add(flashlight.target);\n        redLight=new THREE.PointLight(0x880000,2,10); scene.add(redLight);\n        createLampLightPool();\n    }\n\n    /* ============================================================\n       ПУЛ ИСТОЧНИКОВ СВЕТА И ТЕНЕЙ ЛАМП\n       Число ламп развязано с числом источников света и теней:\n       пул фиксирован, создаётся один раз (постоянное число\n       источников => шейдер не пересобирается и не превышает\n       лимиты текстурных юнитов WebGL), и каждый кадр переносится\n       на ближайшие к игроку лампы.\n    ============================================================ */\n    function createLampLightPool(){\n        lampPool.length=0; lampPoolAcc=0; lampShadowCount=0;\n        const cfg=lampSettings||LAMP_QUALITY_TABLE.HIGH;\n        const poolSize=cfg.poolSize|0;\n        let shadowWanted=cfg.shadowPool|0;\n        if(poolSize<=0)return;\n        let maxShadow=shadowWanted;\n        try{\n            const gl=renderer.getContext();\n            const units=gl.getParameter(gl.MAX_TEXTURE_IMAGE_UNITS)||8;\n            // Резерв текстурных юнитов под карты материалов и тени\n            // фонаря/бумбокса; остаток отдаём теневым лампам.\n            const budget=Math.max(0,units-12);\n            maxShadow=Math.max(0,Math.min(shadowWanted,budget));\n        }catch(e){ maxShadow=Math.min(shadowWanted,2); }\n        if(!renderer.shadowMap||!renderer.shadowMap.enabled) maxShadow=0;\n        lampShadowCount=maxShadow;\n        for(let i=0;i<poolSize;i++){\n            const pl=new THREE.PointLight(0xfffdd0,0.0,LAMP_LIGHT_DISTANCE);\n            pl.visible=false;\n            if(i<maxShadow){\n                pl.castShadow=true;\n                pl.shadow.mapSize.width=512; pl.shadow.mapSize.height=512;\n                pl.shadow.bias=-0.005;\n                pl.shadow.camera.near=0.1; pl.shadow.camera.far=LAMP_LIGHT_DISTANCE;\n            }\n            scene.add(pl);\n            lampPool.push(pl);\n        }\n    }\n\n    function updateLampPool(delta){\n        if(lampPool.length===0||lamps.length===0)return;\n        const n=lampPool.length;\n        lampPoolAcc+=delta;\n        if(lampPoolAcc>=LAMP_POOL_UPDATE_INTERVAL){\n            lampPoolAcc=0;\n            const cx=camera.position.x, cz=camera.position.z;\n            // Частичный выбор n ближайших ламп без полной сортировки\n            // всего массива (вставка в короткий упорядоченный список).\n            const chosen=[];\n            for(let li=0; li<lamps.length; li++){\n                const l=lamps[li];\n                const dx=l.x-cx, dz=l.z-cz;\n                const d2=dx*dx+dz*dz;\n                l._d2=d2;\n                if(chosen.length<n){\n                    chosen.push(l);\n                    if(chosen.length===n) chosen.sort((a,b)=>a._d2-b._d2);\n                } else if(d2<chosen[n-1]._d2){\n                    let pos=n-1;\n                    while(pos>0 && chosen[pos-1]._d2>d2){ chosen[pos]=chosen[pos-1]; pos--; }\n                    chosen[pos]=l;\n                }\n            }\n            if(chosen.length<n && chosen.length>1) chosen.sort((a,b)=>a._d2-b._d2);\n            for(let li=0; li<lamps.length; li++) lamps[li].poolLight=null;\n            for(let i=0;i<n;i++){\n                const pl=lampPool[i];\n                const l=chosen[i];\n                if(!l){ pl.visible=false; pl.intensity=0; continue; }\n                pl.position.set(l.x, wallHeight-0.1, l.z);\n                pl.visible=true;\n                pl.intensity=l.baseIntensity;\n                l.poolLight=pl;\n            }\n        }\n        // Мерцание/интенсивность для ламп, попавших в пул (поведение\n        // прежнего пер-лампового цикла, но на фиксированном пуле).\n        for(let li=0; li<lamps.length; li++){\n            const l=lamps[li];\n            const pl=l.poolLight;\n            if(!pl) continue;\n            if(l.isFlickering){\n                if(Math.random()<0.08){\n                    const isOn=Math.random()>0.4;\n                    pl.intensity=isOn?l.baseIntensity:0;\n                    if(l.sound)l.sound.setVolume(isOn?1.0:0.0);\n                }\n            } else {\n                pl.intensity=l.baseIntensity+Math.sin(time*50)*0.05;\n            }\n        }\n    }\n"""\n', False, '<backrooms>/webui/game/core/lighting.py'),
    'backrooms.webui.game.core.loop': ('"""Главный цикл рендера и обновления."""\n\nJS = r"""\n\n    /* ============================================================\n       ГЛАВНЫЙ ЦИКЛ\n    ============================================================ */\n    function animate(){\n        requestAnimationFrame(animate);\n        \n        // --- FPS CALCULATION ---\n        const now = performance.now();\n        fpsFrames++;\n        if (now >= lastFpsTime + 1000) {\n            const fpsText = document.getElementById(\'fps-display\');\n            if (fpsText) fpsText.innerText = `FPS ${Math.round((fpsFrames * 1000) / (now - lastFpsTime))}`;\n            fpsFrames = 0;\n            lastFpsTime = now;\n        }\n        // -----------------------\n\n        if(!isStarted||!scene)return;\n        const delta=Math.min(clock.getDelta(),0.1);\n        time+=delta;\n        if(postUniforms)postUniforms.time.value=time;\n\n        if(audioInitialized&&randomAudioBuffers.length>0&&nextRandomSoundTime>0&&time>nextRandomSoundTime){\n            playRandomAmbientSound(); scheduleNextRandomSound();\n        }\n        if(time<impactEndTime){\n            const phase=Math.floor((impactEndTime-time)*25.0)%4;\n            if(postUniforms)postUniforms.impactState.value=[1.0,3.0,2.0,4.0][phase];\n        } else if(postUniforms&&postUniforms.impactState.value!==0.0){\n            postUniforms.impactState.value=0.0;\n        }\n\n        updatePhysics(delta);\n        updateMonsterAI(delta);\n        updateBoombox(delta);\n        applyHorrorEffects();\n\n        if(lampInstancedMesh){\n            lampInstancedMesh.material.emissiveIntensity=5.0+Math.sin(time*50)*0.3;\n        }\n        updateLampPool(delta);\n\n        renderPost();\n    }\n"""\n', False, '<backrooms>/webui/game/core/loop.py'),
    'backrooms.webui.game.core.player': ('"""Физика игрока, камера, болтанка."""\n\nJS = r"""\n\n    /* ============================================================\n       ФИЗИКА ИГРОКА\n    ============================================================ */\n    function updatePhysics(delta){\n        const flLerp=25.0;\n        flashlightEuler.x+=(targetEuler.x-flashlightEuler.x)*flLerp*delta;\n        flashlightEuler.y+=(targetEuler.y-flashlightEuler.y)*flLerp*delta;\n        const camLerp=5.0;\n        cameraEuler.x+=(flashlightEuler.x-cameraEuler.x)*camLerp*delta;\n        cameraEuler.y+=(flashlightEuler.y-cameraEuler.y)*camLerp*delta;\n\n        if(isWon&&winTargetPos){\n            let dir=new THREE.Vector3().subVectors(winTargetPos,camera.position); dir.y=0;\n            if(dir.length()>0.5){dir.normalize();camera.position.x+=dir.x*2.0*delta;camera.position.z+=dir.z*2.0*delta;}\n            let tq=new THREE.Quaternion().setFromRotationMatrix(\n                new THREE.Matrix4().lookAt(camera.position,new THREE.Vector3(winTargetPos.x,camera.position.y,winTargetPos.z),new THREE.Vector3(0,1,0))\n            );\n            camera.quaternion.slerp(tq,delta*3.0);\n            const fq=new THREE.Quaternion().setFromEuler(new THREE.Euler(flashlightEuler.x,flashlightEuler.y,0,\'YXZ\'));\n            flashlight.position.copy(camera.position).add(new THREE.Vector3(0.2,-0.3,0).applyQuaternion(camera.quaternion));\n            flashlight.target.position.copy(flashlight.position).add(new THREE.Vector3(0,0,-1).applyQuaternion(fq));\n            return;\n        }\n\n        if(isDead){\n            deathState.velocityY-=deathState.gravity*delta;\n            camera.position.y+=deathState.velocityY*delta;\n            let onGround=false;\n            if(camera.position.y<=deathState.floorY){\n                camera.position.y=deathState.floorY; onGround=true;\n                if(Math.abs(deathState.velocityY)>1.5){\n                    playFootstepSound(Math.min(1.0,Math.abs(deathState.velocityY)*0.15));\n                    deathState.velocityY=Math.abs(deathState.velocityY)*0.4;\n                    deathState.angularVelocity.add(new THREE.Vector3((Math.random()-0.5)*15,(Math.random()-0.5)*15,(Math.random()-0.5)*15));\n                } else {deathState.velocityY=0;}\n            }\n            if(deathState.velocityXZ.lengthSq()>0.001){\n                let nx=camera.position.x+deathState.velocityXZ.x*delta;\n                let nz=camera.position.z+deathState.velocityXZ.z*delta;\n                if(canEntityMoveTo(nx,camera.position.z,playerRadius))camera.position.x=nx;\n                else deathState.velocityXZ.x*=-0.5;\n                if(canEntityMoveTo(camera.position.x,nz,playerRadius))camera.position.z=nz;\n                else deathState.velocityXZ.z*=-0.5;\n                deathState.velocityXZ.lerp(new THREE.Vector3(0,0,0),(onGround?8:0.5)*delta);\n            }\n            cameraEuler.x=THREE.MathUtils.lerp(cameraEuler.x,deathState.targetPitch,delta*3);\n            cameraEuler.y=THREE.MathUtils.lerp(cameraEuler.y,deathState.targetYaw,delta*2);\n            cameraEuler.z=THREE.MathUtils.lerp(cameraEuler.z,deathState.targetRoll,delta*4);\n            let dj=deathState.velocityY===0?Math.sin(time*50)*0.005:0;\n            let as=deathState.angularVelocity.length();\n            if(as>0.001){\n                let ax=deathState.angularVelocity.clone().normalize();\n                camera.quaternion.multiplyQuaternions(new THREE.Quaternion().setFromAxisAngle(ax,as*delta),camera.quaternion);\n            }\n            if(onGround)deathState.angularVelocity.lerp(new THREE.Vector3(0,0,0),10.0*delta);\n            else deathState.angularVelocity.lerp(new THREE.Vector3(0,0,0),0.5*delta);\n            let fe=new THREE.Euler().setFromQuaternion(camera.quaternion,\'YXZ\'); fe.x+=dj;\n            camera.quaternion.setFromEuler(fe);\n            const fq=new THREE.Quaternion().setFromEuler(new THREE.Euler(flashlightEuler.x,flashlightEuler.y,0,\'YXZ\'));\n            flashlight.position.copy(camera.position).add(new THREE.Vector3(0.2,-0.3,0).applyQuaternion(camera.quaternion));\n            flashlight.target.position.copy(flashlight.position).add(new THREE.Vector3(0,0,-1).applyQuaternion(camera.quaternion));\n            return;\n        }\n\n        if(!isDead&&!isWon&&exits.length>0){\n            for(let exit of exits){\n                let dist=Math.hypot(camera.position.x-exit.position.x,camera.position.z-exit.position.z);\n                if(dist<2.0){triggerWin(exit.position);return;}\n            }\n        }\n\n        let turnVelocity=flashlightEuler.y-cameraEuler.y;\n        let targetTurnTilt=Math.max(-0.25,Math.min(0.25,turnVelocity*3.0));\n        currentTurnTilt+=(targetTurnTilt-currentTurnTilt)*5.0*delta;\n\n        let inputDirection=new THREE.Vector3();\n        if(!isMobile){\n            if(keys.w)inputDirection.z-=1; if(keys.s)inputDirection.z+=1;\n            if(keys.a)inputDirection.x-=1; if(keys.d)inputDirection.x+=1;\n        } else {\n            inputDirection.x=touchLeft.deltaX; inputDirection.z=touchLeft.deltaY;\n        }\n\n        const isMovingInput=inputDirection.length()>0.001;\n        let isSprinting=isMovingInput&&((!isMobile&&keys.shift)||(isMobile&&touchLeft.active&&touchLeft.isSprinting));\n        let targetSpeed=isMovingInput?(isSprinting?speed*1.85:speed):0;\n        if(isMovingInput&&!isMobile)inputDirection.normalize();\n        else if(isMobile&&inputDirection.length()>1)inputDirection.normalize();\n\n        playerVelocity.lerp(inputDirection.clone().multiplyScalar(targetSpeed),(isMovingInput?4.5:3.5)*delta);\n\n        let speedMag=playerVelocity.length();\n        const isMoving=speedMag>0.1;\n        playerDirection.copy(playerVelocity).applyEuler(new THREE.Euler(0,cameraEuler.y,0));\n\n        if(isMoving){\n            let cr=speedMag/speed;\n            bobTime+=delta*THREE.MathUtils.mapLinear(cr,0,1.85,4.5,11.0);\n        }\n\n        let tBY=0,tBP=0,tBR=0,tBYaw=0;\n        if(isMoving){\n            let cr=speedMag/speed;\n            let ifac=THREE.MathUtils.mapLinear(cr,0,1.85,0.2,1.6);\n            tBY=Math.sin(bobTime*2)*0.06*ifac;\n            tBP=(Math.sin(bobTime*2+1.5)*0.02+Math.sin(bobTime*4.5)*0.008)*ifac;\n            tBR=(Math.cos(bobTime)*0.025+Math.sin(bobTime*3.7)*0.01)*ifac;\n            if(speedMag>speed*1.05){\n                let sp=Math.max(0,Math.min(1,(speedMag-speed)/(speed*0.85)));\n                tBP+=Math.sin(time*28)*0.015*sp; tBR+=Math.cos(time*24)*0.022*sp;\n                tBYaw=Math.sin(time*32)*0.018*sp; tBY+=Math.cos(time*35)*0.015*sp;\n            }\n        } else {\n            tBY=Math.sin(time*1.5)*0.015; tBP=Math.sin(time*1.8)*0.005;\n            tBR=Math.cos(time*1.3)*0.004; tBYaw=Math.sin(time*1.1)*0.003;\n        }\n\n        if(isMoving){\n            const isBD=tBY<lastTargetBobY;\n            if(wasBobbingDown&&!isBD) playFootstepSound(THREE.MathUtils.mapLinear(speedMag/speed,0.1,1.85,0.15,0.65));\n            wasBobbingDown=isBD;\n        } else {wasBobbingDown=false;}\n        lastTargetBobY=tBY;\n\n        const ls=isMoving?14:5;\n        currentBobY+=(tBY-currentBobY)*ls*delta;\n        currentBobPitch+=(tBP-currentBobPitch)*ls*delta;\n        currentBobRoll+=(tBR-currentBobRoll)*ls*delta;\n        currentBobYaw+=(tBYaw-currentBobYaw)*ls*delta;\n\n        camera.position.y=1.6+currentBobY;\n        const nx=camera.position.x+playerDirection.x*delta;\n        const nz=camera.position.z+playerDirection.z*delta;\n        if(canEntityMoveTo(nx,camera.position.z,playerRadius))camera.position.x=nx;\n        if(canEntityMoveTo(camera.position.x,nz,playerRadius))camera.position.z=nz;\n\n        camera.quaternion.setFromEuler(new THREE.Euler(\n            cameraEuler.x+currentBobPitch, cameraEuler.y+currentBobYaw,\n            cameraEuler.z+currentBobRoll-currentTurnTilt, \'YXZ\'\n        ));\n\n        const fq=new THREE.Quaternion().setFromEuler(new THREE.Euler(flashlightEuler.x,flashlightEuler.y,0,\'YXZ\'));\n        flashlight.position.copy(camera.position).add(new THREE.Vector3(0.2,-0.3,0).applyQuaternion(camera.quaternion));\n        flashlight.target.position.copy(flashlight.position).add(new THREE.Vector3(0,0,-1).applyQuaternion(fq));\n    }\n"""\n', False, '<backrooms>/webui/game/core/player.py'),
    'backrooms.webui.game.core.postprocessing': ('"""Пост-обработка: общий CRT-шейдер и самодостаточный SSAO-пайплайн.\n\nПрофиль ULTRA при поддержке depth-текстуры рендерит сцену в ``sceneRT``\n(цвет + ``DepthTexture``) и прогоняет три собственных полноэкранных\nпрохода: SSAO -> bilateral-blur -> финальный CRT-композит. Пайплайн\nручной (свои ``WebGLRenderTarget`` и полноэкранный ``ShaderMaterial``-\nквад) — никаких внешних аддонов и CDN-скриптов: единственная\nзависимость, как и в исходной игре, — ядро ``three.min.js``. Это\nснимает класс отказов «не запускается на части устройств». Прочие\nпрофили или отсутствие depth-текстуры — единственный CRT-проход\n(поведение и стоимость как в исходной игре).\n\nCRT-шейдер общий: при ``aoEnabled>0.5`` источник цвета — ``tColor`` и\nумножение на AO из ``tDiffuse``; иначе — ``tDiffuse`` как раньше.\n"""\n\nJS = r"""\n\n    /* ============================================================\n       ПОСТ-ОБРАБОТКА\n    ============================================================ */\n    // Блок bloom собирается по профилю качества; сэмплит источник цвета\n    // (srcRGB), а не tDiffuse — в SSAO-пути tDiffuse это AO-буфер.\n    function buildGlowBlock(){\n        if(graphicsQuality===\'HIGH\'||graphicsQuality===\'ULTRA\'){\n            return `\n                vec3 glow=vec3(0.0);\n                vec2 gstep=vec2(0.006)*(resolution.y/resolution.x);\n                vec2 offs[8];\n                offs[0]=vec2(-gstep.x,-gstep.y);offs[1]=vec2(0.0,-gstep.y*1.4);offs[2]=vec2(gstep.x,-gstep.y);\n                offs[3]=vec2(-gstep.x*1.4,0.0);offs[4]=vec2(gstep.x*1.4,0.0);\n                offs[5]=vec2(-gstep.x,gstep.y);offs[6]=vec2(0.0,gstep.y*1.4);offs[7]=vec2(gstep.x,gstep.y);\n                for(int i=0;i<8;i++){\n                    vec3 s=srcRGB(clamp(distortedUv+offs[i],0.0,1.0));\n                    float l=dot(s,vec3(0.2126,0.7152,0.0722));\n                    if(l>0.55){glow+=s*(l-0.55)*1.6;}\n                }\n                color+=glow*0.15;`;\n        } else if(graphicsQuality===\'MEDIUM\'){\n            return `\n                vec3 glow=vec3(0.0);\n                vec2 gstep=vec2(0.006)*(resolution.y/resolution.x);\n                vec2 offs[4];\n                offs[0]=vec2(-gstep.x,-gstep.y);offs[1]=vec2(gstep.x,-gstep.y);\n                offs[2]=vec2(-gstep.x,gstep.y);offs[3]=vec2(gstep.x,gstep.y);\n                for(int i=0;i<4;i++){\n                    vec3 s=srcRGB(clamp(distortedUv+offs[i],0.0,1.0));\n                    float l=dot(s,vec3(0.2126,0.7152,0.0722));\n                    if(l>0.55){glow+=s*(l-0.55)*1.6;}\n                }\n                color+=glow*0.15;`;\n        }\n        return "";\n    }\n\n    // Общий CRT-шейдер. aoEnabled=0 -> источник цвета tDiffuse (один\n    // проход, как в исходной игре); aoEnabled=1 -> цвет из tColor,\n    // умноженный на AO из tDiffuse (SSAO-путь). Экранные эффекты те же.\n    function buildCrtShader(glowBlock){\n        return {\n            uniforms:{\n                tDiffuse:{value:null},\n                tColor:{value:null},\n                aoEnabled:{value:0.0},\n                time:{value:0.0},\n                resolution:{value:new THREE.Vector2(window.innerWidth,window.innerHeight)},\n                glitchIntensity:{value:0.0},\n                impactState:{value:0.0},\n                backroomsTintStrength:{value:BACKROOMS_TINT_STRENGTH}\n            },\n            vertexShader:POST_VS,\n            fragmentShader:`\n                uniform sampler2D tDiffuse;uniform sampler2D tColor;uniform float aoEnabled;\n                uniform float time;uniform vec2 resolution;\n                uniform float glitchIntensity;uniform float impactState;uniform float backroomsTintStrength;\n                varying vec2 vUv;\n                float rand(vec2 co){return fract(sin(dot(co.xy,vec2(12.9898,78.233)))*43758.5453);}\n                vec3 srcRGB(vec2 c){ return (aoEnabled>0.5)?texture2D(tColor,c).rgb:texture2D(tDiffuse,c).rgb; }\n                void main(){\n                    vec2 uv=(vUv-0.5)*0.5+0.5;\n                    float aspect=resolution.x/resolution.y;\n                    vec2 d=uv-0.5;d.x*=aspect;\n                    float r=dot(d,d);\n                    vec2 push=d*(r*4.5);push.x/=aspect;\n                    vec2 distortedUv=clamp(uv+push,0.0,1.0);\n                    if(glitchIntensity>0.0){\n                        float freq=60.0+rand(vec2(time,1.0))*60.0;\n                        float sliceY=floor(distortedUv.y*freq);\n                        float sliceOffset=(rand(vec2(sliceY,floor(time*15.0)))-0.5)*0.03*glitchIntensity;\n                        if(rand(vec2(sliceY,floor(time*10.0)+1.0))>0.3){\n                            distortedUv.x+=sliceOffset;distortedUv.x=clamp(distortedUv.x,0.0,1.0);\n                        }\n                    }\n                    float jitter=sin(time*50.0)*0.001+(rand(uv*time)*0.02*glitchIntensity);\n                    float rgbShift=0.003+jitter+(glitchIntensity*0.015);\n                    float rCol=srcRGB(clamp(distortedUv+vec2(rgbShift,0.0),0.0,1.0)).r;\n                    float gCol=srcRGB(clamp(distortedUv,0.0,1.0)).g;\n                    float bCol=srcRGB(clamp(distortedUv-vec2(rgbShift,0.0),0.0,1.0)).b;\n                    vec3 color=vec3(rCol,gCol,bCol);\n                    if(aoEnabled>0.5){ color*=texture2D(tDiffuse,clamp(distortedUv,0.0,1.0)).r; }\n                    ${glowBlock}\n                    color+=rand(distortedUv*time)*(0.05+glitchIntensity*0.1);\n                    color-=sin(distortedUv.y*1300.0-time*-30.0)*0.01;\n                    if(mod(time,3.0)<0.1&&abs(distortedUv.y-0.5)<0.05)color+=vec3(0.1);\n                    if(glitchIntensity>0.5&&rand(vec2(time,distortedUv.y))>0.8){color.g*=0.5;color.b+=0.2;}\n                    color=mix(color,vec3(dot(color,vec3(0.299,0.587,0.114))),0.3);\n                    color=clamp(color*1.1,0.0,1.0);\n                    color*=1.0-smoothstep(0.2,0.9,length(d)*1.3);\n                    vec3 backroomsColor=color*vec3(1.3,0.95,0.5);\n                    color=mix(color,backroomsColor,backroomsTintStrength);\n                    if(impactState==1.0)color=vec3(1.0)-color;\n                    else if(impactState==2.0)color=vec3(1.0);\n                    else if(impactState==3.0)color=vec3(0.0);\n                    else if(impactState==4.0)color=vec3(0.6,0.0,0.0);\n                    gl_FragColor=vec4(color,1.0);\n                }`\n        };\n    }\n\n    function makePostMaterial(shaderDef){\n        const m=new THREE.ShaderMaterial(shaderDef);\n        m.depthTest=false; m.depthWrite=false;\n        return m;\n    }\n\n    // Пер-объектная подмена материала на нормаль-материал и обратно.\n    // НЕ глобальный override материала сцены: именно он ломает смесь\n    // InstancedMesh/Mesh в r128 (известный баг рендерера). Пер-объектная\n    // замена безопасна — каждый объект рисуется своей программой.\n    function ssaoSwapToNormal(o){\n        if(o.isMesh){ o.userData.__ssaoMat=o.material; o.material=normalMat; }\n    }\n    function ssaoRestoreMaterial(o){\n        if(o.isMesh && o.userData.__ssaoMat){\n            o.material=o.userData.__ssaoMat; o.userData.__ssaoMat=null;\n        }\n    }\n\n    // Самодостаточный SSAO-пайплайн (ULTRA): сцена -> sceneRT\n    // (цвет+глубина), затем 3 собственных полноэкранных прохода\n    // (SSAO -> bilateral-blur -> CRT-композит). Без внешних\n    // postprocessing-аддонов и CDN-скриптов — только ядро three.js.\n    function setupSsaoPipeline(glowBlock){\n        const w=window.innerWidth, h=window.innerHeight;\n        // Гард поддержки depth-текстуры: WebGL2 (ядро) либо расширение\n        // WEBGL_depth_texture (WebGL1). Нет поддержки -> исключение ->\n        // чистый CRT-проход без AO, а не битая «сетка» на устройстве.\n        const gl=renderer.getContext();\n        const depthOK=renderer.capabilities.isWebGL2\n            || !!gl.getExtension(\'WEBGL_depth_texture\');\n        if(!depthOK) throw new Error(\'depth texture unsupported\');\n\n        const rtOpts={minFilter:THREE.LinearFilter,magFilter:THREE.LinearFilter,format:THREE.RGBFormat};\n        sceneRT=new THREE.WebGLRenderTarget(w,h,rtOpts);\n        sceneRT.texture.encoding=THREE.sRGBEncoding;\n        sceneRT.depthTexture=new THREE.DepthTexture(w,h);\n        sceneRT.depthTexture.format=THREE.DepthFormat;\n        // 16-бит глубина (UNSIGNED_SHORT) — максимально совместима со\n        // всеми мобильными WebGL1; чистая 24-бит — WebGL2-only и ломала\n        // часть телефонов. Устойчивость к точности — в SSAO-шейдере.\n        sceneRT.depthTexture.type=THREE.UnsignedShortType;\n        aoRT=new THREE.WebGLRenderTarget(w,h,rtOpts);\n        aoBlurRT=new THREE.WebGLRenderTarget(w,h,rtOpts);\n        // Буфер view-space нормалей: отдельный проход рисует сцену\n        // MeshNormalMaterial\'ом (пер-объектная подмена, НЕ глобальный\n        // override материала сцены — он ломает InstancedMesh в r128).\n        // Реальные нормали убирают полосы/кляксы depth-only SSAO.\n        normalRT=new THREE.WebGLRenderTarget(w,h,rtOpts);\n        normalMat=new THREE.MeshNormalMaterial();\n\n        ssaoMat=makePostMaterial({\n            uniforms:{\n                tDepth:{value:sceneRT.depthTexture},\n                tNormal:{value:normalRT.texture},\n                projInverse:{value:camera.projectionMatrixInverse},\n                resolution:{value:new THREE.Vector2(w,h)},\n                aoStrength:{value:AO_STRENGTH},\n                aoPower:{value:AO_POWER},\n                aoBias:{value:AO_BIAS},\n                aoEdgePx:{value:AO_EDGE_PX},\n                aoMaxDiff:{value:AO_MAXDIFF},\n                aoFadeStart:{value:AO_FADE_START},\n                aoFadeEnd:{value:AO_FADE_END}\n            },\n            vertexShader:POST_VS,\n            fragmentShader:ssaoFragmentShader()\n        });\n        blurMat=makePostMaterial({\n            uniforms:{\n                tDiffuse:{value:null},\n                tDepth:{value:sceneRT.depthTexture},\n                projInverse:{value:camera.projectionMatrixInverse},\n                resolution:{value:new THREE.Vector2(w,h)},\n                aoBlurDepth:{value:AO_BLUR_DEPTH}\n            },\n            vertexShader:POST_VS,\n            fragmentShader:ssaoBlurFragmentShader(AO_BLUR)\n        });\n        postMaterial=makePostMaterial(buildCrtShader(glowBlock));\n        postMaterial.uniforms.tColor.value=sceneRT.texture;\n        postMaterial.uniforms.aoEnabled.value=1.0;\n\n        postCamera=new THREE.OrthographicCamera(-1,1,1,-1,0,1);\n        postScene=new THREE.Scene();\n        postQuad=new THREE.Mesh(new THREE.PlaneGeometry(2,2),postMaterial);\n        postScene.add(postQuad);\n\n        postUniforms=postMaterial.uniforms;\n        usePostSSAO=true;\n    }\n\n    // Единственный CRT-проход (не ULTRA или нет depth-текстуры) —\n    // поведение и стоимость в точности как в исходной игре.\n    function setupManualPipeline(glowBlock){\n        renderTarget=new THREE.WebGLRenderTarget(window.innerWidth,window.innerHeight,{\n            minFilter:THREE.LinearFilter,magFilter:THREE.LinearFilter,format:THREE.RGBFormat\n        });\n        renderTarget.texture.encoding=THREE.sRGBEncoding;\n        postCamera=new THREE.OrthographicCamera(-1,1,1,-1,0,1);\n        postScene=new THREE.Scene();\n        postMaterial=makePostMaterial(buildCrtShader(glowBlock));\n        postMaterial.uniforms.tDiffuse.value=renderTarget.texture;\n        postMaterial.uniforms.aoEnabled.value=0.0;\n        postQuad=new THREE.Mesh(new THREE.PlaneGeometry(2,2),postMaterial);\n        postScene.add(postQuad);\n        postUniforms=postMaterial.uniforms;\n        usePostSSAO=false;\n    }\n\n    function setupPostProcessing(){\n        const glowBlock=buildGlowBlock();\n        if(graphicsQuality===\'ULTRA\'){\n            try{\n                setupSsaoPipeline(glowBlock);\n                return;\n            }catch(e){\n                console.warn(\'SSAO pipeline unavailable, plain post:\',e);\n                usePostSSAO=false;\n            }\n        }\n        setupManualPipeline(glowBlock);\n    }\n\n    // Единая точка рендера пост-обработки (вызывается из главного цикла).\n    // При сбое SSAO-прохода в рантайме один раз деградируем на чистый\n    // CRT-проход — кадр не чернеет на проблемном устройстве.\n    function renderPost(){\n        if(usePostSSAO){\n            try{\n                renderer.setRenderTarget(sceneRT);\n                renderer.render(scene,camera);\n                // Проход нормалей: пер-объектная подмена материала\n                // (без глобального override сцены) -> view-space нормали.\n                scene.traverse(ssaoSwapToNormal);\n                renderer.setRenderTarget(normalRT);\n                renderer.render(scene,camera);\n                scene.traverse(ssaoRestoreMaterial);\n                postQuad.material=ssaoMat;\n                renderer.setRenderTarget(aoRT);\n                renderer.render(postScene,postCamera);\n                blurMat.uniforms.tDiffuse.value=aoRT.texture;\n                postQuad.material=blurMat;\n                renderer.setRenderTarget(aoBlurRT);\n                renderer.render(postScene,postCamera);\n                postMaterial.uniforms.tDiffuse.value=aoBlurRT.texture;\n                postQuad.material=postMaterial;\n                renderer.setRenderTarget(null);\n                renderer.render(postScene,postCamera);\n                return;\n            }catch(e){\n                console.warn(\'SSAO render failed, switching to plain post:\',e);\n                // Если сбой пришёлся на нормаль-проход — вернуть\n                // подменённые материалы, иначе сцена останется в\n                // нормаль-материале.\n                scene.traverse(ssaoRestoreMaterial);\n                usePostSSAO=false;\n                postMaterial.uniforms.aoEnabled.value=0.0;\n                if(!renderTarget){\n                    renderTarget=new THREE.WebGLRenderTarget(window.innerWidth,window.innerHeight,{\n                        minFilter:THREE.LinearFilter,magFilter:THREE.LinearFilter,format:THREE.RGBFormat\n                    });\n                    renderTarget.texture.encoding=THREE.sRGBEncoding;\n                }\n                postMaterial.uniforms.tDiffuse.value=renderTarget.texture;\n            }\n        }\n        renderer.setRenderTarget(renderTarget);\n        renderer.render(scene,camera);\n        renderer.setRenderTarget(null);\n        renderer.render(postScene,postCamera);\n    }\n"""\n', False, '<backrooms>/webui/game/core/postprocessing.py'),
    'backrooms.webui.game.core.ssao': ('"""Экранный детектор вогнутых рёбер (crease) для пайплайна пост-обработки.\n\nНе полусферный SSAO: требование — затемнять строго стыки. Затемнение\nвозникает только там, где поверхность вогнута (сосед над касательной\nплоскостью вдоль нормали) И нормали соседей расходятся (= шов). На\nплоскостях, выпуклостях и по краям экрана результат — ноль; дальние\nразрывы глубины отсекаются. Позиция берётся из текстуры глубины,\nнормаль — из настоящего буфера нормалей (``tNormal``); далее\nbilateral-blur денойзит линию шва перед композитингом.\n\nЭкспортирует JS-функции, используемые ``postprocessing``: вершинный\nшейдер пассов (``POST_VS``), исходник фрагментного шейдера детектора\nрёбер (``ssaoFragmentShader``) и bilateral-блюра\n(``ssaoBlurFragmentShader``; окно подставляется литералом, чтобы\nграницы циклов GLSL были константными).\n"""\n\nJS = r"""\n\n    /* ============================================================\n       SSAO (экранное затенение, профиль ULTRA)\n    ============================================================ */\n    // Вершинный шейдер полноэкранных пассов (passthrough UV).\n    const POST_VS = \'varying vec2 vUv; void main(){ vUv = uv; gl_Position = projectionMatrix * modelViewMatrix * vec4( position, 1.0 ); }\';\n\n    // Детектор вогнутых рёбер (crease), а НЕ полусферный SSAO.\n    // Требование: затемнять ТОЛЬКО стыки. Полусферный SSAO по природе\n    // затемняет всё, где геометрия загораживает полусферу (стены под\n    // углом, края экрана). Здесь затемнение возникает строго там, где\n    // поверхность вогнута И нормали соседей расходятся (= шов): на\n    // плоскостях, выпуклостях и по краям экрана результат — ноль.\n    function ssaoFragmentShader(){\n        return `\n        uniform sampler2D tDepth;\n        uniform sampler2D tNormal;\n        uniform mat4 projInverse;\n        uniform vec2 resolution;\n        uniform float aoStrength;\n        uniform float aoPower;\n        uniform float aoBias;\n        uniform float aoEdgePx;\n        uniform float aoMaxDiff;\n        uniform float aoFadeStart;\n        uniform float aoFadeEnd;\n        varying vec2 vUv;\n        vec3 viewPos(vec2 uv){\n            float z=texture2D(tDepth,uv).x;\n            vec4 c=vec4(uv*2.0-1.0, z*2.0-1.0, 1.0);\n            vec4 v=projInverse*c;\n            return v.xyz/v.w;\n        }\n        // Вклад одного соседа: >0 только если сосед лежит над\n        // касательной плоскостью вдоль нормали (вогнутость) И нормали\n        // расходятся (грань между гранями). Дальние разрывы глубины\n        // (фон/край экрана/другой объект) отсекаются aoMaxDiff -> край\n        // экрана и плоскости дают ноль, ничего лишнего не чернеет.\n        float creaseTap(vec2 uvc, vec2 e, vec3 P, vec3 N){\n            vec2 uv2=uvc+e;\n            if(uv2.x<0.0||uv2.x>1.0||uv2.y<0.0||uv2.y>1.0) return 0.0;\n            vec3 S=viewPos(uv2);\n            if(abs(P.z-S.z)>aoMaxDiff) return 0.0;\n            vec3 Ns=normalize(texture2D(tNormal,uv2).xyz*2.0-1.0);\n            vec3 d=S-P; float dl=length(d);\n            if(dl<1e-5) return 0.0;\n            float concave=max(0.0, dot(d/dl,N)-aoBias);\n            float ndiff=max(0.0, 1.0-dot(N,Ns));\n            return concave*ndiff;\n        }\n        void main(){\n            float dz=texture2D(tDepth,vUv).x;\n            if(dz>=0.9999){ gl_FragColor=vec4(1.0); return; }\n            vec3 P=viewPos(vUv);\n            vec3 N=normalize(texture2D(tNormal,vUv).xyz*2.0-1.0);\n            vec2 px=aoEdgePx/resolution;\n            float crease=0.0;\n            crease+=creaseTap(vUv,vec2( px.x,0.0),P,N);\n            crease+=creaseTap(vUv,vec2(-px.x,0.0),P,N);\n            crease+=creaseTap(vUv,vec2(0.0, px.y),P,N);\n            crease+=creaseTap(vUv,vec2(0.0,-px.y),P,N);\n            crease+=creaseTap(vUv,vec2( px.x, px.y),P,N);\n            crease+=creaseTap(vUv,vec2(-px.x, px.y),P,N);\n            crease+=creaseTap(vUv,vec2( px.x,-px.y),P,N);\n            crease+=creaseTap(vUv,vec2(-px.x,-px.y),P,N);\n            crease/=8.0;\n            // Вдали стык не разглядеть (туман/виньетка) — гасим, чтобы\n            // не ловить шум точности на далёких поверхностях.\n            float distFade=1.0-smoothstep(aoFadeStart,aoFadeEnd,-P.z);\n            float c=pow(clamp(crease*aoStrength,0.0,1.0),aoPower);\n            float ao=clamp(1.0-c*distFade,0.0,1.0);\n            gl_FragColor=vec4(vec3(ao),1.0);\n        }`;\n    }\n\n    // Bilateral-blur AO-буфера: окно покрывает тайл шума (убирает\n    // сеточный паттерн на плоскостях), но веса спадают по разнице\n    // глубины — стыки не размазываются и AO не «течёт» на открытые\n    // поверхности. half — половина окна (>= стороны тайла шума).\n    function ssaoBlurFragmentShader(half){\n        return `\n        uniform sampler2D tDiffuse;\n        uniform sampler2D tDepth;\n        uniform mat4 projInverse;\n        uniform vec2 resolution;\n        uniform float aoBlurDepth;\n        varying vec2 vUv;\n        float viewZ(vec2 uv){\n            float z=texture2D(tDepth,uv).x;\n            vec4 c=vec4(uv*2.0-1.0, z*2.0-1.0, 1.0);\n            vec4 v=projInverse*c;\n            return (v.z/v.w);\n        }\n        void main(){\n            vec2 texel=1.0/resolution;\n            float cz=viewZ(vUv);\n            float sum=0.0; float wsum=0.0;\n            for(int x=-${half};x<=${half};x++){\n                for(int y=-${half};y<=${half};y++){\n                    vec2 o=vec2(float(x),float(y))*texel;\n                    float sz=viewZ(vUv+o);\n                    float w=1.0-smoothstep(0.0,aoBlurDepth,abs(cz-sz));\n                    sum+=texture2D(tDiffuse,vUv+o).r*w;\n                    wsum+=w;\n                }\n            }\n            float ao=(wsum>0.0)?(sum/wsum):texture2D(tDiffuse,vUv).r;\n            gl_FragColor=vec4(vec3(ao),1.0);\n        }`;\n    }\n"""\n', False, '<backrooms>/webui/game/core/ssao.py'),
    'backrooms.webui.game.core.state': ('"""Глобальное изменяемое состояние игры."""\n\nJS = r"""\n    let bobTime=0, currentBobY=0, currentBobPitch=0, currentBobRoll=0, currentBobYaw=0, currentTurnTilt=0;\n    let lastTargetBobY=0, wasBobbingDown=false;\n\n    let scene, camera, renderer, clock, audioListener;\n    let isStarted=false, audioInitialized=false;\n    let graphicsQuality=\'HIGH\';\n    let isMobile = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);\n\n    // FPS Variables\n    let fpsFrames = 0;\n    let lastFpsTime = performance.now();\n\n    const mapSize=25, cellSize=7, wallHeight=4;\n    let mazeMap=[];\n    let globalEmptyCells=[], exits=[];\n    let playerVelocity=new THREE.Vector3(), playerDirection=new THREE.Vector3();\n    let flashlight, redLight, shadowFigure;\n    let test01Monsters=[];\n    let wallsMesh=null;\n\n    let lamps=[];\n    let lampInstancedMesh=null;  \n    let lampAnchorObjects=[];    \n\n    let time=0, baseFov=110;\n    const speed=3.5, playerRadius=0.4;\n    const keys={w:false,a:false,s:false,d:false,shift:false};\n    let targetEuler=new THREE.Euler(0,0,0,\'YXZ\');\n    let flashlightEuler=new THREE.Euler(0,0,0,\'YXZ\');\n    let cameraEuler=new THREE.Euler(0,0,0,\'YXZ\');\n    const PI_2=Math.PI/2;\n\n    let touchLeft={active:false,id:null,startX:0,startY:0,deltaX:0,deltaY:0,isSprinting:false};\n    let touchRight={active:false,id:null,lastX:0,lastY:0};\n\n    let audioCtx, renderTarget, postCamera, postScene, postMaterial, humBuffer;\n    let usePostSSAO=false, sceneRT, aoRT, aoBlurRT, normalRT, normalMat, postQuad, ssaoMat, blurMat, postUniforms;\n    let ambientSoundPlayer, randomAudioBuffers=[], nextRandomSoundTime=0;\n    let chaseSoundPlayer;\n    let preloadedTextures={wall:null,floor:null,ceiling:null};\n\n"""\n', False, '<backrooms>/webui/game/core/state.py'),
    'backrooms.webui.game.level0': ('"""Нулевой уровень: контент именно этого уровня.\n\nСущности (монстры, выходы, test01) и их ИИ, бумбокс, декали, исходы\nпрохождения (победа/смерть/респаун) и хоррор-эффекты этого уровня.\nКарта уровня и её генерация — в подпакете ``map``. Переиспользуемый\nдвижок — в пакете ``core``.\n"""\n', True, '<backrooms>/webui/game/level0/__init__.py'),
    'backrooms.webui.game.level0.ai': ('"""ИИ монстров: поиск пути BFS и поведение."""\n\nJS = r"""\n\n    /* ============================================================\n       ИИ МОНСТРОВ (BFS)\n    ============================================================ */\n    function getNextStepBFS(sx,sy,tx,ty){\n        if(sx===tx&&sy===ty)return null;\n        let queue=[{x:sx,y:sy,path:[]}];\n        let visited=Array(mapSize).fill(0).map(()=>Array(mapSize).fill(false));\n        visited[sy][sx]=true;\n        const dirs=[[0,1],[1,0],[0,-1],[-1,0]];\n        let iters=0;\n        while(queue.length>0&&iters<1000){\n            iters++;\n            let curr=queue.shift();\n            if(curr.x===tx&&curr.y===ty)return curr.path.length>0?curr.path[0]:null;\n            for(let d of dirs){\n                let nx=curr.x+d[0],ny=curr.y+d[1];\n                if(nx>=0&&nx<mapSize&&ny>=0&&ny<mapSize&&mazeMap[ny][nx]===0&&!visited[ny][nx]){\n                    visited[ny][nx]=true;\n                    queue.push({x:nx,y:ny,path:[...curr.path,{x:nx,y:ny}]});\n                }\n            }\n        }\n        return queue.length>0&&queue[0].path.length>0?queue[0].path[0]:null;\n    }\n\n    function updateMonsterAI(delta){\n        if(isDead||isWon)return;\n        let isAnyAggro=false, minAggroDist=MONSTER_CONFIG.aggroRadius;\n        for(let mObj of test01Monsters){\n            let monster=mObj.mesh, state=mObj.state;\n            let mPos=monster.position, pPos=camera.position;\n            let distToPlayer=mPos.distanceTo(pPos);\n            if(distToPlayer<1.2){triggerDeath();return;}\n            if(devMobMode===\'STAY\')continue;\n            let isAggro=(devMobMode===\'HOSTILE\'&&distToPlayer<state.aggroRadius);\n            if(isAggro){isAnyAggro=true;if(distToPlayer<minAggroDist)minAggroDist=distToPlayer;}\n            let targetPos=null;\n            if(isAggro){\n                targetPos=pPos;\n            } else {\n                if(!state.roamTarget||mPos.distanceTo(state.roamTarget)<2.0){\n                    let rCell=globalEmptyCells[Math.floor(Math.random()*globalEmptyCells.length)];\n                    state.roamTarget=new THREE.Vector3(rCell.pos.x,1.6,rCell.pos.z);\n                }\n                targetPos=state.roamTarget;\n            }\n            if(time-state.lastPathCalc>0.2){\n                state.lastPathCalc=time+Math.random()*0.1;\n                let mg=getGridCoord(mPos.x,mPos.z), tg=getGridCoord(targetPos.x,targetPos.z);\n                let nextNode=getNextStepBFS(mg.x,mg.y,tg.x,tg.y);\n                if(nextNode){let wp=getWorldPos(nextNode.x,nextNode.y);state.pathNode=new THREE.Vector3(wp.x,1.6,wp.z);}\n                else{state.pathNode=targetPos;}\n            }\n            if(state.pathNode){\n                let dir=new THREE.Vector3().subVectors(state.pathNode,mPos); dir.y=0;\n                if(dir.length()>0.1){\n                    dir.normalize();\n                    let cs=isAggro?state.speedHostile:state.speedPassive;\n                    let nx=mPos.x+dir.x*cs*delta, nz=mPos.z+dir.z*cs*delta;\n                    if(canEntityMoveTo(nx,mPos.z,state.radius))mPos.x=nx;\n                    if(canEntityMoveTo(mPos.x,nz,state.radius))mPos.z=nz;\n                    monster.lookAt(new THREE.Vector3(mPos.x+dir.x,mPos.y,mPos.z+dir.z));\n                }\n            }\n        }\n        if(chaseSoundPlayer&&chaseSoundPlayer.buffer&&audioCtx&&audioCtx.state===\'running\'){\n            if(isAnyAggro){\n                if(!chaseSoundPlayer.isPlaying){chaseSoundPlayer.setVolume(0);chaseSoundPlayer.play();}\n                let dr=Math.max(0,Math.min(1,(MONSTER_CONFIG.aggroRadius-minAggroDist)/(MONSTER_CONFIG.aggroRadius-1.2)));\n                let tv=MONSTER_CONFIG.chaseVolume*(0.3+dr*0.7);\n                chaseSoundPlayer.setVolume(THREE.MathUtils.lerp(chaseSoundPlayer.getVolume(),tv,delta*2));\n            } else {\n                if(chaseSoundPlayer.isPlaying){\n                    let nv=THREE.MathUtils.lerp(chaseSoundPlayer.getVolume(),0,delta*3);\n                    chaseSoundPlayer.setVolume(nv);\n                    if(nv<0.01)chaseSoundPlayer.stop();\n                }\n            }\n        }\n    }\n"""\n', False, '<backrooms>/webui/game/level0/ai.py'),
    'backrooms.webui.game.level0.boombox': ('"""Бумбокс: меш, радио-аудио, обновление."""\n\nJS = r"""\n    /* ============================================================\n       БУМБОКС\n    ============================================================ */\n    function createBoomboxMesh() {\n        const group=new THREE.Group();\n        const S=BOOMBOX_CONFIG.sizeScale;\n        const bodyMat=new THREE.MeshStandardMaterial({color:0x1a1a1a,roughness:0.7,metalness:0.4});\n        const bodyMat2=new THREE.MeshStandardMaterial({color:0x222222,roughness:0.6,metalness:0.3});\n        const speakerMat=new THREE.MeshStandardMaterial({color:0x080808,roughness:0.9});\n        const detailMat=new THREE.MeshStandardMaterial({color:0x444444,roughness:0.5,metalness:0.8});\n        const accentMat=new THREE.MeshStandardMaterial({color:0x00ffcc,emissive:0x00aa88,emissiveIntensity:1.5,roughness:0.2,metalness:0.1});\n\n        group.add(new THREE.Mesh(new THREE.BoxGeometry(8*S,4*S,2.5*S),bodyMat));\n        const sL=new THREE.Mesh(new THREE.BoxGeometry(0.3*S,4.2*S,2.7*S),bodyMat2); sL.position.set(-4.15*S,0,0); group.add(sL);\n        const sR=new THREE.Mesh(new THREE.BoxGeometry(0.3*S,4.2*S,2.7*S),bodyMat2); sR.position.set(4.15*S,0,0); group.add(sR);\n\n        const spkGeo=new THREE.CylinderGeometry(1.2*S,1.2*S,0.15*S,32); spkGeo.rotateX(Math.PI/2);\n        const speakerL=new THREE.Mesh(spkGeo,speakerMat); speakerL.position.set(-2.5*S,-0.2*S,1.26*S); group.add(speakerL);\n        const speakerR=new THREE.Mesh(spkGeo,speakerMat); speakerR.position.set(2.5*S,-0.2*S,1.26*S); group.add(speakerR);\n\n        for(let r=0.3;r<=1.0;r+=0.25){\n            const rGeo=new THREE.TorusGeometry(r*S,0.04*S,8,24);\n            const rl=new THREE.Mesh(rGeo,detailMat); rl.position.set(-2.5*S,-0.2*S,1.3*S); rl.rotation.x=Math.PI/2; group.add(rl);\n            const rr=new THREE.Mesh(rGeo,detailMat); rr.position.set(2.5*S,-0.2*S,1.3*S); rr.rotation.x=Math.PI/2; group.add(rr);\n        }\n        const tGeo=new THREE.CylinderGeometry(0.38*S,0.38*S,0.15*S,24); tGeo.rotateX(Math.PI/2);\n        const tL=new THREE.Mesh(tGeo,speakerMat); tL.position.set(-2.5*S,1.2*S,1.26*S); group.add(tL);\n        const tR=new THREE.Mesh(tGeo,speakerMat); tR.position.set(2.5*S,1.2*S,1.26*S); group.add(tR);\n\n        const deck=new THREE.Mesh(new THREE.BoxGeometry(2.4*S,1.4*S,0.18*S),detailMat); deck.position.set(0,-0.4*S,1.33*S); group.add(deck);\n        const di=new THREE.Mesh(new THREE.BoxGeometry(2.1*S,1.1*S,0.05*S),speakerMat); di.position.set(0,-0.4*S,1.42*S); group.add(di);\n\n        const hL=new THREE.Mesh(new THREE.BoxGeometry(0.4*S,1.3*S,0.4*S),bodyMat2); hL.position.set(-3.2*S,2.75*S,0); group.add(hL);\n        const hR=new THREE.Mesh(new THREE.BoxGeometry(0.4*S,1.3*S,0.4*S),bodyMat2); hR.position.set(3.2*S,2.75*S,0); group.add(hR);\n        const hT=new THREE.Mesh(new THREE.BoxGeometry(6.8*S,0.4*S,0.4*S),bodyMat2); hT.position.set(0,3.15*S,0); group.add(hT);\n\n        const btnGeo=new THREE.BoxGeometry(0.38*S,0.28*S,0.55*S);\n        for(let i=0;i<5;i++){\n            const btn=new THREE.Mesh(btnGeo,i===2?accentMat.clone():detailMat);\n            btn.position.set((-1+i*0.5)*S,2.0*S,0.8*S); group.add(btn);\n        }\n        const ant=new THREE.Mesh(new THREE.CylinderGeometry(0.045*S,0.045*S,3.8*S,8),detailMat);\n        ant.position.set(3.4*S,3.9*S,-0.7*S); ant.rotation.z=-Math.PI/8; ant.rotation.x=-Math.PI/16; group.add(ant);\n\n        group.userData.speakerL=speakerL; group.userData.speakerR=speakerR;\n        group.userData.tweeterL=tL; group.userData.tweeterR=tR;\n        group.userData.accentMat=accentMat; group.userData.S=S;\n        return group;\n    }\n\n    function setupBoomboxRadioAudio(){\n        if(!audioCtx||boomboxAudioSource||!boomboxObject)return;\n        try{\n            const audioEl=new Audio(); audioEl.crossOrigin="anonymous";\n            audioEl.src=boomboxObject.trackUrl; audioEl.loop=true;\n            const ms=audioCtx.createMediaElementSource(audioEl);\n            const bass=audioCtx.createBiquadFilter(); bass.type=\'lowshelf\'; bass.frequency.value=120; bass.gain.value=BOOMBOX_CONFIG.bassBoostGain;\n            const conv=audioCtx.createConvolver();\n            const sr=audioCtx.sampleRate, len=sr*1.5;\n            const imp=audioCtx.createBuffer(2,len,sr);\n            for(let c=0;c<2;c++){const d=imp.getChannelData(c);for(let i=0;i<len;i++)d[i]=(Math.random()*2-1)*Math.pow(1-i/len,4);}\n            conv.buffer=imp;\n            const dry=audioCtx.createGain(); dry.gain.value=BOOMBOX_CONFIG.reverbDry;\n            const wet=audioCtx.createGain(); wet.gain.value=BOOMBOX_CONFIG.reverbWet;\n            boomboxGainNode=audioCtx.createGain(); boomboxGainNode.gain.value=0;\n            ms.connect(bass); bass.connect(dry); bass.connect(conv); conv.connect(wet);\n            dry.connect(boomboxGainNode); wet.connect(boomboxGainNode); boomboxGainNode.connect(audioCtx.destination);\n            boomboxBassNode=bass; boomboxDryNode=dry; boomboxWetNode=wet; boomboxAudioSource=audioEl;\n            audioEl.play().catch(e=>console.log("Boombox play failed:",e));\n        }catch(err){console.warn("Boombox audio setup failed:",err);}\n    }\n\n    function spawnBoomboxAt(x,z){\n        if(boomboxObject)return;\n        const mesh=createBoomboxMesh();\n        const S=mesh.userData.S;\n        mesh.position.set(x,2.2*S,z);\n        mesh.rotation.y=Math.random()*Math.PI*2;\n        scene.add(mesh);\n        const bbLight=new THREE.PointLight(0x00ffcc,2.5,12);\n        bbLight.position.set(x,0.8,z);\n        if(graphicsQuality!==\'LOW\'){\n            bbLight.castShadow=true;\n            bbLight.shadow.mapSize.width=256; bbLight.shadow.mapSize.height=256;\n            bbLight.shadow.bias=-0.005;\n            bbLight.shadow.camera.near=0.1; bbLight.shadow.camera.far=15;\n        }\n        scene.add(bbLight);\n        const trackUrl=BOOMBOX_CONFIG.musicUrls[Math.floor(Math.random()*BOOMBOX_CONFIG.musicUrls.length)];\n        boomboxObject={mesh,light:bbLight,pos:new THREE.Vector3(x,0,z),bobPhase:Math.random()*Math.PI*2,trackUrl};\n    }\n\n    function spawnBoomboxDev(){\n        if(boomboxObject){scene.remove(boomboxObject.mesh);scene.remove(boomboxObject.light);boomboxObject=null;}\n        let dir=new THREE.Vector3(); camera.getWorldDirection(dir); dir.y=0; dir.normalize();\n        spawnBoomboxAt(camera.position.x+dir.x*3, camera.position.z+dir.z*3);\n        if(audioInitialized&&boomboxAudioSource){boomboxAudioSource.src=boomboxObject.trackUrl;boomboxAudioSource.play().catch(()=>{});}\n    }\n\n    function updateBoombox(delta){\n        if(!boomboxObject)return;\n        const bb=boomboxObject, mesh=bb.mesh, S=mesh.userData.S;\n        const dist=camera.position.distanceTo(new THREE.Vector3(bb.pos.x,camera.position.y,bb.pos.z));\n        if(boomboxGainNode&&audioCtx){\n            if(dist<BOOMBOX_CONFIG.maxHearDist){\n                const dr=Math.max(0,Math.min(1,dist/BOOMBOX_CONFIG.maxHearDist));\n                boomboxGainNode.gain.setTargetAtTime((1-dr)*BOOMBOX_CONFIG.maxVolume,audioCtx.currentTime,0.2);\n                if(boomboxBassNode&&boomboxDryNode&&boomboxWetNode){\n                    boomboxBassNode.gain.setTargetAtTime(BOOMBOX_CONFIG.bassBoostGain*(1-dr),audioCtx.currentTime,0.2);\n                    boomboxDryNode.gain.setTargetAtTime(BOOMBOX_CONFIG.reverbDry*(1-dr*0.3),audioCtx.currentTime,0.2);\n                    boomboxWetNode.gain.setTargetAtTime(BOOMBOX_CONFIG.reverbWet*dr,audioCtx.currentTime,0.2);\n                }\n            } else {\n                boomboxGainNode.gain.setTargetAtTime(0,audioCtx.currentTime,0.2);\n            }\n        }\n        const indicator=document.getElementById(\'boombox-indicator\');\n        if(dist<BOOMBOX_CONFIG.maxHearDist&&dist>1.5){\n            indicator.style.display=\'flex\';\n            document.getElementById(\'boombox-dist-text\').innerText=`${Math.round(dist)}m`;\n            boomboxNearby=true;\n        } else {\n            indicator.style.display=\'none\'; boomboxNearby=false;\n        }\n        const bassBeat=Math.pow(Math.abs(Math.sin(time*5+bb.bobPhase)),8);\n        const highBeat=Math.pow(Math.abs(Math.cos(time*10+bb.bobPhase)),4);\n        if(mesh.userData.speakerL){\n            const ss=1+bassBeat*0.5;\n            mesh.userData.speakerL.scale.set(1,1,ss); mesh.userData.speakerR.scale.set(1,1,ss);\n            const ts=1+highBeat*0.3;\n            mesh.userData.tweeterL.scale.set(1,1,ts); mesh.userData.tweeterR.scale.set(1,1,ts);\n        }\n        if(mesh.userData.accentMat) mesh.userData.accentMat.emissiveIntensity=0.8+bassBeat*3.0;\n        mesh.position.y=2.2*S+bassBeat*0.01;\n        if(bb.light) bb.light.intensity=1.8+bassBeat*2.5;\n    }\n"""\n', False, '<backrooms>/webui/game/level0/boombox.py'),
    'backrooms.webui.game.level0.decals': ('"""Декали на стенах."""\n\nJS = r"""\n\n    /* ============================================================\n       ДЕКАЛИ\n    ============================================================ */\n    function spawnDecalAt(col,row,dir){\n        if(loadedDecals.length===0)return;\n        let total=loadedDecals.reduce((s,i)=>s+i.weight,0), roll=Math.random()*total, selected=null;\n        for(let item of loadedDecals){roll-=item.weight;if(roll<=0){selected=item;break;}}\n        if(!selected)return;\n        const mat=new THREE.MeshStandardMaterial({\n            map:selected.tex,transparent:true,alphaTest:0.1,roughness:0.8,\n            polygonOffset:true,polygonOffsetFactor:-4,polygonOffsetUnits:-4\n        });\n        const mesh=new THREE.Mesh(new THREE.PlaneGeometry(selected.size,selected.size),mat);\n        const wPos=getWorldPos(col,row), offset=cellSize/2;\n        mesh.position.set(wPos.x, wallHeight/2+(Math.random()*0.8-0.4), wPos.z);\n        if(dir===\'N\'){mesh.position.z-=offset;mesh.rotation.y=Math.PI;}\n        if(dir===\'S\'){mesh.position.z+=offset;mesh.rotation.y=0;}\n        if(dir===\'W\'){mesh.position.x-=offset;mesh.rotation.y=-Math.PI/2;}\n        if(dir===\'E\'){mesh.position.x+=offset;mesh.rotation.y=Math.PI/2;}\n        scene.add(mesh);\n    }\n"""\n', False, '<backrooms>/webui/game/level0/decals.py'),
    'backrooms.webui.game.level0.entities': ('"""Спавн выходов и монстров, переключение режима моба."""\n\nJS = r"""\n\n    /* ============================================================\n       СПАВН ВЫХОДОВ И МОНСТРОВ\n    ============================================================ */\n    function spawnExitAt(cell,openDir){\n        let pos=getWorldPos(cell.col,cell.row);\n        let exitGroup=new THREE.Group();\n        exitGroup.position.set(pos.x,0,pos.z);\n        const geo=new THREE.BoxGeometry(cellSize*0.5,wallHeight*0.8,0.1);\n        const mat=new THREE.MeshBasicMaterial({color:0xffffff});\n        const mesh=new THREE.Mesh(geo,mat);\n        mesh.position.y=wallHeight*0.4;\n        if(openDir===\'N\'){mesh.position.z=cellSize*0.45;}\n        else if(openDir===\'S\'){mesh.position.z=-cellSize*0.45;}\n        else if(openDir===\'W\'){mesh.position.x=cellSize*0.45;mesh.rotation.y=Math.PI/2;}\n        else if(openDir===\'E\'){mesh.position.x=-cellSize*0.45;mesh.rotation.y=Math.PI/2;}\n        exitGroup.add(mesh);\n        const light=new THREE.PointLight(0xffffff,3.5,20);\n        light.position.y=wallHeight*0.5;\n        if(openDir===\'N\')light.position.z-=1.0;\n        else if(openDir===\'S\')light.position.z+=1.0;\n        else if(openDir===\'W\')light.position.x-=1.0;\n        else if(openDir===\'E\')light.position.x+=1.0;\n        exitGroup.add(light);\n        scene.add(exitGroup);\n        exits.push(exitGroup);\n    }\n\n    function spawnTest01At(x,z){\n        let m=new THREE.Mesh(new THREE.BoxGeometry(0.8,3.2,0.8),new THREE.MeshBasicMaterial({color:0x050505}));\n        m.position.set(x,1.6,z); scene.add(m);\n        test01Monsters.push({mesh:m,state:{\n            roamTarget:null,pathNode:null,lastPathCalc:0,\n            speedPassive:MONSTER_CONFIG.speedPassive,speedHostile:MONSTER_CONFIG.speedHostile,\n            aggroRadius:MONSTER_CONFIG.aggroRadius,radius:MONSTER_CONFIG.radius\n        }});\n    }\n\n    function spawnTest01(){\n        let dir=new THREE.Vector3(); camera.getWorldDirection(dir); dir.y=0; dir.normalize();\n        let sp=new THREE.Vector3(camera.position.x,1.6,camera.position.z);\n        for(let i=1;i<=6;i++){\n            let tx=camera.position.x+dir.x*i, tz=camera.position.z+dir.z*i;\n            if(isWallAt(tx,tz))break; sp.set(tx,1.6,tz);\n        }\n        spawnTest01At(sp.x,sp.z);\n        let added=test01Monsters[test01Monsters.length-1];\n        added.mesh.lookAt(camera.position); added.mesh.rotation.x=0; added.mesh.rotation.z=0;\n    }\n\n    function forceSpawnExit(){\n        let dir=new THREE.Vector3(); camera.getWorldDirection(dir); dir.y=0; dir.normalize();\n        let sp=new THREE.Vector3(camera.position.x,0,camera.position.z);\n        for(let i=1;i<=5;i++){\n            let tx=camera.position.x+dir.x*i, tz=camera.position.z+dir.z*i;\n            if(isWallAt(tx,tz))break; sp.set(tx,0,tz);\n        }\n        let eg=new THREE.Group(); eg.position.set(sp.x,0,sp.z);\n        const mesh=new THREE.Mesh(new THREE.BoxGeometry(cellSize*0.5,wallHeight*0.8,0.1),new THREE.MeshBasicMaterial({color:0xffffff}));\n        mesh.position.y=wallHeight*0.4; mesh.lookAt(camera.position.x,wallHeight*0.4,camera.position.z); eg.add(mesh);\n        const light=new THREE.PointLight(0xffffff,3.5,20); light.position.y=wallHeight*0.5; eg.add(light);\n        scene.add(eg); exits.push(eg);\n    }\n\n    function toggleMobMode(){\n        if(devMobMode===\'HOSTILE\')devMobMode=\'PASSIVE\';\n        else if(devMobMode===\'PASSIVE\')devMobMode=\'STAY\';\n        else devMobMode=\'HOSTILE\';\n        document.getElementById(\'toggle-mode-btn\').innerText=`MODE: ${devMobMode}`;\n    }\n"""\n', False, '<backrooms>/webui/game/level0/entities.py'),
    'backrooms.webui.game.level0.horror': ('"""Хоррор-эффекты и регистрация ресайза."""\n\nJS = r"""\n\n    /* ============================================================\n       ХОРРОР ЭФФЕКТЫ\n    ============================================================ */\n    function applyHorrorEffects(){\n        if(shadowFigure){\n            redLight.position.copy(shadowFigure.position); redLight.position.y=1;\n            redLight.intensity=1.5+Math.sin(time*4)*0.5;\n            if(camera.position.distanceTo(shadowFigure.position)<5){\n                let att=0;\n                while(att<50){\n                    let rx=Math.floor(Math.random()*mapSize), rz=Math.floor(Math.random()*mapSize);\n                    if(mazeMap[rz][rx]===0){\n                        const np=getWorldPos(rx,rz);\n                        if(camera.position.distanceTo(new THREE.Vector3(np.x,1.4,np.z))>15){\n                            shadowFigure.position.set(np.x,1.4,np.z); break;\n                        }\n                    }\n                    att++;\n                }\n            }\n            shadowFigure.lookAt(camera.position); shadowFigure.rotation.x=0; shadowFigure.rotation.z=0;\n        }\n\n        let maxGlitch=0.0;\n        if(!isDead){\n            for(let mObj of test01Monsters){\n                let monster=mObj.mesh;\n                let toM=new THREE.Vector3().subVectors(monster.position,camera.position);\n                let dist=toM.length();\n                if(dist<25.0){\n                    toM.normalize();\n                    let cd=new THREE.Vector3(); camera.getWorldDirection(cd);\n                    let dot=cd.dot(toM);\n                    if(dot>0.7){\n                        let li=(dot-0.7)/0.3, di=1.0-(dist/25.0);\n                        let mg=li*di;\n                        if(wallsMesh){\n                            const rc=new THREE.Raycaster(camera.position,toM);\n                            const ints=rc.intersectObject(wallsMesh);\n                            if(ints.length>0&&ints[0].distance<dist)mg*=0.5;\n                        }\n                        if(mg>maxGlitch)maxGlitch=mg;\n                    }\n                }\n            }\n        }\n        if(postUniforms)postUniforms.glitchIntensity.value=maxGlitch;\n    }\n\n    window.addEventListener(\'resize\',onWindowResize);\n"""\n', False, '<backrooms>/webui/game/level0/horror.py'),
    'backrooms.webui.game.level0.map': ('"""Карта нулевого уровня и её генерация.\n\n``generation`` — процедурная генерация лабиринта, утилиты сетки и\nпроцедурные текстуры; ``environment`` — построение геометрии окружения\n(стены, пол, потолок) и размещение сущностей уровня на карте. Является\nчастью контента уровня (пакет ``level0``), а не общего движка.\n"""\n', True, '<backrooms>/webui/game/level0/map/__init__.py'),
    'backrooms.webui.game.level0.map.environment': ('"""Построение геометрии окружения и размещение сущностей."""\n\nJS = r"""\n\n    /* ============================================================\n       СТРОИТЕЛЬСТВО ОКРУЖЕНИЯ\n    ============================================================ */\n    function buildEnvironment(){\n        const useBump=graphicsQuality!==\'LOW\';\n\n        const wallMat=new THREE.MeshStandardMaterial({roughness:WALL_CONFIG.roughness,metalness:WALL_CONFIG.metalness,bumpScale:useBump?WALL_CONFIG.bumpScale:0});\n        if(preloadedTextures.wall){\n            if(useBump)wallMat.bumpMap=preloadedTextures.wall;\n            preloadedTextures.wall.wrapS=preloadedTextures.wall.wrapT=THREE.RepeatWrapping;\n            preloadedTextures.wall.repeat.set(WALL_CONFIG.textureRepeat,WALL_CONFIG.textureRepeat);\n            wallMat.map=preloadedTextures.wall;\n        } else {\n            const wt=createNoiseTexture(512,512,\'#b89c56\',\'#d1b66b\'); const wb=createNoiseTexture(512,512,\'\',\'\',true);\n            wt.repeat.set(2,2); wb.repeat.set(2,2); wallMat.map=wt; if(useBump)wallMat.bumpMap=wb;\n        }\n        const floorMat=new THREE.MeshStandardMaterial({roughness:FLOOR_CONFIG.roughness,metalness:FLOOR_CONFIG.metalness,bumpScale:useBump?FLOOR_CONFIG.bumpScale:0});\n        if(preloadedTextures.floor){\n            if(useBump)floorMat.bumpMap=preloadedTextures.floor;\n            preloadedTextures.floor.wrapS=preloadedTextures.floor.wrapT=THREE.RepeatWrapping;\n            preloadedTextures.floor.repeat.set(FLOOR_CONFIG.textureRepeat,FLOOR_CONFIG.textureRepeat);\n            floorMat.map=preloadedTextures.floor;\n        } else {\n            const ft=createNoiseTexture(512,512,\'#6b5c3e\',\'#7a6a4a\'); const fb=createNoiseTexture(512,512,\'\',\'\',true);\n            ft.repeat.set(mapSize*2,mapSize*2); fb.repeat.set(mapSize*2,mapSize*2); floorMat.map=ft; if(useBump)floorMat.bumpMap=fb;\n        }\n        const ceilingMat=new THREE.MeshStandardMaterial({roughness:CEILING_CONFIG.roughness,metalness:CEILING_CONFIG.metalness,bumpScale:useBump?CEILING_CONFIG.bumpScale:0});\n        if(preloadedTextures.ceiling){\n            if(useBump)ceilingMat.bumpMap=preloadedTextures.ceiling;\n            preloadedTextures.ceiling.wrapS=preloadedTextures.ceiling.wrapT=THREE.RepeatWrapping;\n            preloadedTextures.ceiling.repeat.set(CEILING_CONFIG.textureRepeat,CEILING_CONFIG.textureRepeat);\n            ceilingMat.map=preloadedTextures.ceiling;\n        } else {\n            const ct=createNoiseTexture(512,512,\'#d9c89e\',\'#e8d8b3\'); const cb=createNoiseTexture(512,512,\'\',\'\',true);\n            ct.repeat.set(mapSize*2,mapSize*2); cb.repeat.set(mapSize*2,mapSize*2); ceilingMat.map=ct; if(useBump)ceilingMat.bumpMap=cb;\n        }\n\n        let wallCount=0;\n        globalEmptyCells=[];\n        let deadEnds=[];\n\n        for(let y=0;y<mapSize;y++){\n            for(let x=0;x<mapSize;x++){\n                if(mazeMap[y][x]===1){wallCount++;}\n                else if(y>0&&y<mapSize-1&&x>0&&x<mapSize-1){\n                    globalEmptyCells.push({pos:getWorldPos(x,y),col:x,row:y});\n                    let wc=0, openDir=null;\n                    if(mazeMap[y-1][x]===1)wc++; else openDir=\'N\';\n                    if(mazeMap[y+1][x]===1)wc++; else openDir=\'S\';\n                    if(mazeMap[y][x-1]===1)wc++; else openDir=\'W\';\n                    if(mazeMap[y][x+1]===1)wc++; else openDir=\'E\';\n                    if(wc>=3) deadEnds.push({col:x,row:y,openDir});\n                }\n            }\n        }\n\n        wallsMesh=new THREE.InstancedMesh(new THREE.BoxGeometry(cellSize,wallHeight,cellSize),wallMat,wallCount);\n        wallsMesh.castShadow=graphicsQuality!==\'LOW\';\n        wallsMesh.receiveShadow=graphicsQuality!==\'LOW\';\n\n        let i=0; const dummy=new THREE.Object3D();\n        for(let row=0;row<mapSize;row++){\n            for(let col=0;col<mapSize;col++){\n                const pos=getWorldPos(col,row);\n                if(mazeMap[row][col]===1){\n                    dummy.position.set(pos.x,wallHeight/2,pos.z); dummy.updateMatrix();\n                    wallsMesh.setMatrixAt(i++,dummy.matrix);\n\n                    if(Math.random()<DECAL_CONFIG.globalChance){\n                        const neighbors=[{dx:0,dz:-1,dir:\'N\'},{dx:0,dz:1,dir:\'S\'},{dx:-1,dz:0,dir:\'W\'},{dx:1,dz:0,dir:\'E\'}];\n                        let openFaces=[];\n                        for(let n of neighbors){\n                            let nx=col+n.dx,ny=row+n.dz;\n                            if(nx>=0&&nx<mapSize&&ny>=0&&ny<mapSize&&mazeMap[ny][nx]===0)openFaces.push(n.dir);\n                        }\n                        if(openFaces.length>0){\n                            spawnDecalAt(col,row,openFaces[Math.floor(Math.random()*openFaces.length)]);\n                        }\n                    }\n                }\n            }\n        }\n        wallsMesh.instanceMatrix.needsUpdate=true;\n        scene.add(wallsMesh);\n\n        const startP=getWorldPos(1,1);\n\n        let safeDeadEnds=deadEnds.filter(de=>{\n            let wp=getWorldPos(de.col,de.row);\n            return Math.hypot(wp.x-startP.x,wp.z-startP.z)>=MIN_EXIT_DISTANCE;\n        });\n        if(safeDeadEnds.length>0){\n            safeDeadEnds.sort(()=>Math.random()-0.5);\n            let exitCount=Math.max(1,Math.floor(safeDeadEnds.length*EXIT_RARITY));\n            for(let j=0;j<exitCount;j++){if(safeDeadEnds[j])spawnExitAt(safeDeadEnds[j],safeDeadEnds[j].openDir);}\n        }\n\n        let bbCandidates=globalEmptyCells.filter(cell=>{\n            let wp=getWorldPos(cell.col,cell.row);\n            let dStart=Math.hypot(wp.x-startP.x,wp.z-startP.z);\n            let farExits=exits.every(ext=>Math.hypot(wp.x-ext.position.x,wp.z-ext.position.z)>cellSize*2);\n            return dStart>=BOOMBOX_MIN_DISTANCE&&farExits;\n        });\n        if(bbCandidates.length>0){\n            bbCandidates.sort(()=>Math.random()-0.5);\n            const bc=bbCandidates[0]; const bwp=getWorldPos(bc.col,bc.row);\n            spawnBoomboxAt(bwp.x,bwp.z);\n        }\n\n        let safeCellsForMonsters=globalEmptyCells.filter(cell=>{\n            let wp=getWorldPos(cell.col,cell.row);\n            return Math.hypot(wp.x-startP.x,wp.z-startP.z)>=20.0;\n        });\n        let monsterCount=Math.floor(safeCellsForMonsters.length*TEST01_RARITY);\n        safeCellsForMonsters.sort(()=>Math.random()-0.5);\n        for(let k=0;k<monsterCount;k++){\n            if(safeCellsForMonsters[k]){\n                let wp=getWorldPos(safeCellsForMonsters[k].col,safeCellsForMonsters[k].row);\n                spawnTest01At(wp.x,wp.z);\n            }\n        }\n\n        const lampPositions=[];\n        for(let cell of globalEmptyCells){\n            if(lampPositions.length>=MAX_LAMPS) break;\n            const isNearExit=exits.some(ext=>Math.hypot(cell.pos.x-ext.position.x,cell.pos.z-ext.position.z)<cellSize*1.5);\n            if(!isNearExit&&Math.random()<LAMP_SPAWN_CHANCE){\n                lampPositions.push({x:cell.pos.x,z:cell.pos.z,isFlickering:Math.random()<0.3});\n            }\n        }\n\n        if(lampPositions.length>0){\n            const lampGeo=new THREE.BoxGeometry(1.2,0.02,1.2);\n            const lampMat=new THREE.MeshStandardMaterial({\n                color:0x222222, emissive:0xfffdd0, emissiveIntensity:5.0, roughness:0.4\n            });\n            lampInstancedMesh=new THREE.InstancedMesh(lampGeo,lampMat,lampPositions.length);\n            lampInstancedMesh.count=lampPositions.length;\n\n            lampPositions.forEach((lp,idx)=>{\n                dummy.position.set(lp.x,wallHeight-0.01,lp.z);\n                dummy.updateMatrix();\n                lampInstancedMesh.setMatrixAt(idx,dummy.matrix);\n\n                const anchor=new THREE.Object3D();\n                anchor.position.set(lp.x,wallHeight-0.1,lp.z);\n                scene.add(anchor);\n                lampAnchorObjects.push(anchor);\n                // Источник света на лампу не создаётся: освещение\n                // даёт фиксированный пул (см. модуль lighting). Лампа\n                // хранит позицию, чтобы пул переносился на ближайшие\n                // к игроку лампы.\n                lamps.push({\n                    anchor, idx,\n                    x:lp.x, z:lp.z,\n                    baseIntensity:1.2,\n                    isFlickering:lp.isFlickering,\n                    poolLight:null\n                });\n            });\n\n            lampInstancedMesh.instanceMatrix.needsUpdate=true;\n            scene.add(lampInstancedMesh);\n        }\n\n        const planeSize=mapSize*cellSize;\n        const floor=new THREE.Mesh(new THREE.PlaneGeometry(planeSize,planeSize),floorMat);\n        floor.rotation.x=-Math.PI/2; floor.receiveShadow=graphicsQuality!==\'LOW\'; scene.add(floor);\n        const ceiling=new THREE.Mesh(new THREE.PlaneGeometry(planeSize,planeSize),ceilingMat);\n        ceiling.rotation.x=Math.PI/2; ceiling.position.y=wallHeight; scene.add(ceiling);\n\n        shadowFigure=new THREE.Mesh(new THREE.CylinderGeometry(0.3,0.3,2.8,8),new THREE.MeshBasicMaterial({color:0x000000}));\n        if(globalEmptyCells.length>0){\n            let rCell=globalEmptyCells[Math.floor(Math.random()*globalEmptyCells.length)];\n            shadowFigure.position.set(rCell.pos.x,1.4,rCell.pos.z); scene.add(shadowFigure);\n        }\n    }\n"""\n', False, '<backrooms>/webui/game/level0/map/environment.py'),
    'backrooms.webui.game.level0.map.generation': ('"""Генерация лабиринта и утилиты сетки."""\n\nJS = r"""\n\n    /* ============================================================\n       ГЕНЕРАЦИЯ ЛАБИРИНТА\n    ============================================================ */\n    function generateMazeData(){\n        for(let y=0;y<mapSize;y++) mazeMap.push(new Array(mapSize).fill(1));\n\n        function carveIterative(startX,startY){\n            mazeMap[startY][startX]=0;\n            const stack=[{x:startX,y:startY,dirs:[[0,-2],[0,2],[-2,0],[2,0]].sort(()=>Math.random()-0.5),di:0}];\n            while(stack.length>0){\n                const curr=stack[stack.length-1];\n                if(curr.di>=curr.dirs.length){stack.pop();continue;}\n                const d=curr.dirs[curr.di++];\n                const nx=curr.x+d[0], ny=curr.y+d[1];\n                if(nx>0&&nx<mapSize-1&&ny>0&&ny<mapSize-1&&mazeMap[ny][nx]===1){\n                    mazeMap[curr.y+d[1]/2][curr.x+d[0]/2]=0;\n                    mazeMap[ny][nx]=0;\n                    stack.push({x:nx,y:ny,dirs:[[0,-2],[0,2],[-2,0],[2,0]].sort(()=>Math.random()-0.5),di:0});\n                }\n            }\n        }\n\n        carveIterative(1,1);\n\n        for(let i=0;i<mapSize*2;i++){\n            let rx=Math.floor(Math.random()*(mapSize-2))+1;\n            let ry=Math.floor(Math.random()*(mapSize-2))+1;\n            mazeMap[ry][rx]=0;\n        }\n        const startPos=getWorldPos(1,1);\n        camera.position.set(startPos.x,1.7,startPos.z);\n    }\n\n    function getWorldPos(col,row){\n        const off=Math.floor(mapSize/2);\n        return {x:(col-off)*cellSize, z:(row-off)*cellSize};\n    }\n    function getGridCoord(x,z){\n        const off=Math.floor(mapSize/2);\n        return {x:Math.round(x/cellSize)+off, y:Math.round(z/cellSize)+off};\n    }\n    function isWallAt(x,z){\n        const off=Math.floor(mapSize/2);\n        const col=Math.round(x/cellSize)+off, row=Math.round(z/cellSize)+off;\n        if(col<0||col>=mapSize||row<0||row>=mapSize)return true;\n        return mazeMap[row][col]===1;\n    }\n    function canEntityMoveTo(x,z,r){\n        return !isWallAt(x+r,z+r)&&!isWallAt(x-r,z+r)&&!isWallAt(x+r,z-r)&&!isWallAt(x-r,z-r);\n    }\n\n    function createNoiseTexture(w,h,darkColor,lightColor,isBump=false){\n        const canvas=document.createElement(\'canvas\'); canvas.width=w; canvas.height=h;\n        const ctx=canvas.getContext(\'2d\');\n        ctx.fillStyle=isBump?\'#888888\':darkColor; ctx.fillRect(0,0,w,h);\n        for(let i=0;i<30000;i++){\n            const val=Math.random();\n            if(isBump){const c=Math.floor(val*255);ctx.fillStyle=`rgb(${c},${c},${c})`;}\n            else{ctx.fillStyle=val>0.5?lightColor:darkColor;}\n            const size=Math.random()*3;\n            ctx.fillRect(Math.random()*w,Math.random()*h,size,size);\n        }\n        const tex=new THREE.CanvasTexture(canvas); tex.wrapS=tex.wrapT=THREE.RepeatWrapping; return tex;\n    }\n"""\n', False, '<backrooms>/webui/game/level0/map/generation.py'),
    'backrooms.webui.game.level0.outcomes': ('"""Победа, смерть, респавн."""\n\nJS = r"""\n\n    /* ============================================================\n       ПОБЕДА / СМЕРТЬ / RESPAWN\n    ============================================================ */\n    function triggerWin(targetPos){\n        if(isDead||isWon)return;\n        isWon=true; winTargetPos=targetPos;\n        document.getElementById(\'bodycam-hud\').style.display=\'none\';\n        document.getElementById(\'boombox-indicator\').style.display=\'none\';\n        if(devMode)document.getElementById(\'dev-panel\').style.display=\'none\';\n        if(audioCtx&&winSoundBuffers.length>0){\n            winSoundBuffers.forEach(buf=>{const p=new THREE.Audio(audioListener);p.setBuffer(buf);p.setVolume(1.0);p.play();});\n        }\n        if(chaseSoundPlayer&&chaseSoundPlayer.isPlaying)chaseSoundPlayer.stop();\n        if(boomboxGainNode&&audioCtx)boomboxGainNode.gain.setTargetAtTime(0,audioCtx.currentTime,0.5);\n        setTimeout(()=>{\n            const ws=document.getElementById(\'win-screen\');\n            ws.style.opacity=\'1\'; ws.style.pointerEvents=\'auto\';\n            setTimeout(()=>document.getElementById(\'win-btn\').classList.add(\'show-btn\'),2000);\n        },500);\n    }\n\n    function triggerDeath(){\n        if(isDead||isWon)return;\n        isDead=true; impactEndTime=time+0.4;\n        document.getElementById(\'bodycam-hud\').style.display=\'none\';\n        document.getElementById(\'boombox-indicator\').style.display=\'none\';\n        if(devMode)document.getElementById(\'dev-panel\').style.display=\'none\';\n        deathState.targetRoll=(Math.random()>0.5?1:-1)*(Math.PI/2.2);\n        deathState.targetPitch=-Math.PI/4+(Math.random()*0.2);\n        deathState.targetYaw=cameraEuler.y+(Math.random()>0.5?0.8:-0.8);\n        deathState.velocityY=playerVelocity.length()>0.1?3.0:0.0;\n        deathState.velocityXZ.copy(playerDirection).multiplyScalar(1.5);\n        deathState.angularVelocity.set((Math.random()-0.5)*8,(Math.random()-0.5)*8,(Math.random()-0.5)*8);\n        if(audioCtx&&deathSoundBuffers.length>0){\n            deathSoundBuffers.forEach(buf=>{const p=new THREE.Audio(audioListener);p.setBuffer(buf);p.setVolume(1.0);p.play();});\n        }\n        if(chaseSoundPlayer&&chaseSoundPlayer.isPlaying)chaseSoundPlayer.stop();\n        if(boomboxGainNode&&audioCtx)boomboxGainNode.gain.setTargetAtTime(0,audioCtx.currentTime,0.5);\n        setTimeout(()=>{\n            const ds=document.getElementById(\'death-screen\');\n            ds.style.opacity=\'1\'; ds.style.pointerEvents=\'auto\';\n            setTimeout(()=>document.getElementById(\'respawn-btn\').classList.add(\'show-btn\'),2000);\n        },2500);\n    }\n\n    function respawn(){\n        isDead=false;\n        deathState.velocityY=0; deathState.velocityXZ.set(0,0,0); deathState.angularVelocity.set(0,0,0);\n        currentTurnTilt=0;\n        if(globalEmptyCells.length>0){\n            let best=globalEmptyCells[0],maxD=0;\n            for(let i=0;i<5;i++){\n                let tc=globalEmptyCells[Math.floor(Math.random()*globalEmptyCells.length)];\n                let d=Math.hypot(tc.pos.x-camera.position.x,tc.pos.z-camera.position.z);\n                if(d>maxD){maxD=d;best=tc;}\n            }\n            camera.position.x=best.pos.x; camera.position.z=best.pos.z;\n        } else {\n            const sp=getWorldPos(1,1); camera.position.x=sp.x; camera.position.z=sp.z;\n        }\n        camera.position.y=1.7;\n        cameraEuler.set(0,targetEuler.y,0,\'YXZ\');\n        camera.quaternion.setFromEuler(cameraEuler);\n        flashlightEuler.copy(cameraEuler); targetEuler.copy(cameraEuler);\n        document.getElementById(\'bodycam-hud\').style.display=\'flex\';\n        if(devMode)document.getElementById(\'dev-panel\').style.display=\'flex\';\n        const ds=document.getElementById(\'death-screen\');\n        ds.style.opacity=\'0\'; ds.style.pointerEvents=\'none\';\n        document.getElementById(\'respawn-btn\').classList.remove(\'show-btn\');\n        if(boomboxAudioSource&&audioCtx){if(boomboxAudioSource.paused)boomboxAudioSource.play().catch(()=>{});}\n        if(!isMobile&&document.body.requestPointerLock)document.body.requestPointerLock();\n    }\n"""\n', False, '<backrooms>/webui/game/level0/outcomes.py'),
    'backrooms.webui.styles': ('"""CSS страницы web UI (содержимое тега <style>)."""\n\nCSS = r"""\n        body {\n            margin: 0; overflow: hidden; background-color: #000;\n            font-family: \'Courier New\', Courier, monospace;\n            touch-action: none; user-select: none;\n        }\n        #start-menu {\n            position: absolute; top: 0; left: 0; width: 100vw; height: 100vh;\n            background-color: #080808; color: #fff;\n            display: flex; flex-direction: column; justify-content: center; align-items: center;\n            z-index: 1000; box-sizing: border-box; padding: 20px;\n        }\n        #start-menu h1 { font-size: 24px; margin-bottom: 5px; color: #e0e0e0; font-weight: normal; letter-spacing: 2px;}\n        #start-menu p { font-size: 14px; margin-bottom: 30px; color: #666; }\n        .quality-btn {\n            background: transparent; border: 1px solid #333; color: #aaa;\n            padding: 12px 20px; margin: 8px; font-size: 16px; font-family: inherit;\n            cursor: pointer; width: 300px; text-align: left; transition: all 0.15s;\n            display: flex; justify-content: space-between; align-items: center;\n        }\n        .quality-btn span { font-size: 12px; color: #555; }\n        .quality-btn:hover { background: #fff; color: #000; border-color: #fff; }\n        .quality-btn:hover span { color: #888; }\n        .quality-btn::before { content: ">"; margin-right: 10px; opacity: 0; font-weight: bold; }\n        .quality-btn:hover::before { opacity: 1; }\n        #loading-screen {\n            position: absolute; top: 0; left: 0; width: 100vw; height: 100vh;\n            background-color: #050505; color: #00ff00; z-index: 2000;\n            display: none; flex-direction: column; justify-content: flex-end;\n            padding: 20px; box-sizing: border-box; font-size: 14px;\n        }\n        #loading-log { display: flex; flex-direction: column; gap: 4px; max-height: 100%; overflow-y: auto; word-wrap: break-word; }\n        .blinking-cursor::after { content: \'_\'; animation: blink 1s step-end infinite; }\n        #game-container { position: relative; width: 100vw; height: 100vh; display: none; }\n        canvas { display: block; }\n        #joystick-zone {\n            position: absolute; bottom: 30px; left: 30px; width: 140px; height: 140px;\n            border-radius: 50%; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08);\n            display: none; z-index: 5; pointer-events: none;\n        }\n        #joystick-knob {\n            position: absolute; top: 50px; left: 50px; width: 40px; height: 40px;\n            border-radius: 50%; background: rgba(255,255,255,0.15); pointer-events: none;\n        }\n        #crosshair {\n            position: absolute; top: 50%; left: 50%; width: 4px; height: 4px;\n            background: rgba(255,255,255,0.3); border-radius: 50%;\n            transform: translate(-50%, -50%); z-index: 4; pointer-events: none; display: none;\n        }\n        #bodycam-hud {\n            position: absolute; top: 0; left: 0; width: 100%; height: 100%;\n            pointer-events: none; z-index: 10; display: flex; flex-direction: column;\n            justify-content: space-between; padding: 30px; box-sizing: border-box;\n            color: #fff; text-shadow: 1px 1px 2px #000;\n        }\n        .rec-container { display: flex; align-items: center; font-size: 24px; font-weight: bold; letter-spacing: 2px; color: #ff3333; }\n        .rec-dot { width: 16px; height: 16px; background-color: #ff3333; border-radius: 50%; margin-right: 10px; animation: blink 1s infinite; }\n        .hud-top-right { position: absolute; top: 30px; right: 30px; text-align: right; font-size: 18px; }\n        .hud-bottom { font-size: 18px; display: flex; gap: 20px;}\n        .fps-text { color: #88ff88; }\n        @keyframes blink { 0% { opacity: 1; } 50% { opacity: 0; } 100% { opacity: 1; } }\n        #dev-panel {\n            position: absolute; top: 20px; right: 20px; z-index: 9999;\n            background: rgba(10,10,10,0.85); border: 1px solid #444;\n            padding: 15px; display: none; flex-direction: column; gap: 10px;\n            color: #0f0; font-size: 14px;\n        }\n        #dev-panel button {\n            background: #111; color: #ff3333; border: 1px solid #ff3333;\n            padding: 8px 15px; font-family: \'Courier New\', Courier, monospace;\n            cursor: pointer; transition: 0.2s; font-weight: bold;\n        }\n        #dev-panel button:hover { background: #ff3333; color: #000; }\n        #death-screen {\n            position: absolute; top: 0; left: 0; width: 100vw; height: 100vh;\n            background-color: #000; z-index: 9000;\n            display: flex; flex-direction: column; justify-content: center; align-items: center;\n            opacity: 0; pointer-events: none; transition: opacity 1.5s ease-in;\n        }\n        .signal-text { font-size: 32px; font-weight: normal; letter-spacing: 5px; color: #e0e0e0; margin-bottom: 50px; text-align: center; }\n        #respawn-btn {\n            background: transparent; color: #999; border: 1px solid #555;\n            padding: 10px 20px; font-size: 14px; font-family: \'Courier New\', Courier, monospace;\n            cursor: pointer; text-transform: uppercase; font-weight: normal;\n            opacity: 0; pointer-events: none; transition: all 0.3s; letter-spacing: 2px;\n        }\n        #respawn-btn:hover { background: #fff; color: #000; border-color: #fff; }\n        #win-screen {\n            position: absolute; top: 0; left: 0; width: 100vw; height: 100vh;\n            background-color: #001a00; z-index: 9000;\n            display: flex; flex-direction: column; justify-content: center; align-items: center;\n            opacity: 0; pointer-events: none; transition: opacity 2s ease-in;\n        }\n        .win-text { font-size: 36px; font-weight: normal; letter-spacing: 8px; color: #88ff88; text-shadow: 0 0 15px #00ff00; margin-bottom: 50px; text-align: center; }\n        #win-btn {\n            background: transparent; color: #88ff88; border: 1px solid #22aa22;\n            padding: 10px 20px; font-size: 14px; font-family: \'Courier New\', Courier, monospace;\n            cursor: pointer; text-transform: uppercase; font-weight: normal;\n            opacity: 0; pointer-events: none; transition: all 0.3s; letter-spacing: 2px;\n        }\n        #win-btn:hover { background: #88ff88; color: #000; border-color: #88ff88; }\n        .show-btn { opacity: 1 !important; pointer-events: auto !important; }\n        #boombox-indicator {\n            position: absolute; bottom: 80px; left: 50%; transform: translateX(-50%);\n            z-index: 20; pointer-events: none;\n            display: none; flex-direction: column; align-items: center; gap: 4px;\n        }\n        #boombox-indicator .bb-text { font-size: 11px; color: #00ffcc; letter-spacing: 3px; opacity: 0.8; animation: blink 1.5s infinite; }\n        #boombox-indicator .bb-dist { font-size: 10px; color: #888; letter-spacing: 1px; }\n        #boombox-indicator .bb-arrow { font-size: 20px; color: #00ffcc; opacity: 0.7; }\n"""\n', False, '<backrooms>/webui/styles.py'),
    'backrooms.webview': ('"""Инфраструктура устройства: установка web UI и показ WebView-диалога.\n\nМодуль изолирует зависимость от Android/SDK exteraGram: установщик пишет\nсобранный ``index.html`` в каталог плагина, диалог строит и показывает\nполноэкранный ``WebView`` с корректной очисткой при закрытии.\n"""\n', True, '<backrooms>/webview/__init__.py'),
    'backrooms.webview.dialog': ('"""Построение и показ полноэкранного WebView-диалога с игрой.\n\nВсе зависимости от Android/SDK импортируются защищённо, поэтому модуль\nимпортируется и офлайн (для тестов), а реальный показ доступен только на\nустройстве. Логика воспроизводит исходный плагин: локальный ``file://``\nURL, иммерсивный полный экран и полная очистка WebView при закрытии.\n"""\n\nfrom __future__ import annotations\n\nimport traceback\n\nfrom catalib.support import log, run_on_ui_thread\n\nfrom .installer import ensure_webui_installed\n\ntry:  # pragma: no cover - SDK есть только на устройстве\n    from android.app import Dialog\n    from android.content import DialogInterface\n    from android.graphics import Color\n    from android.graphics.drawable import ColorDrawable\n    from android.view import View, ViewGroup, WindowManager\n    from android.webkit import WebChromeClient, WebSettings, WebView, WebViewClient\n    from android.widget import FrameLayout\n    from client_utils import get_last_fragment\n\n    _SDK = True\nexcept Exception:  # pragma: no cover - офлайн-окружение\n    _SDK = False\n\ntry:  # pragma: no cover - на устройстве\n    from java import dynamic_proxy\nexcept Exception:  # pragma: no cover\n    dynamic_proxy = None\n\n\ndef open_webview_dialog(force: bool = False) -> None:\n    """Установить web UI и показать полноэкранный WebView-диалог.\n\n    :param force: принудительно переустановить web UI перед показом.\n\n    Вне exteraGram (нет SDK) функция логирует причину и завершается —\n    это позволяет импортировать и тестировать модуль офлайн.\n    """\n    if not _SDK:\n        log("[Backrooms] SDK недоступен: показ WebView пропущен")\n        return\n\n    index_path = ensure_webui_installed(force=force)\n    url = "file://" + index_path\n\n    fragment = get_last_fragment()\n    if fragment is None:\n        log("[Backrooms] get_last_fragment() вернул None")\n        return\n    activity = fragment.getParentActivity() if hasattr(fragment, "getParentActivity") else None\n    if activity is None:\n        log("[Backrooms] родительская Activity недоступна")\n        return\n\n    def _show() -> None:\n        try:\n            try:\n                WebView.setWebContentsDebuggingEnabled(True)\n            except Exception:\n                pass\n\n            dialog = Dialog(activity)\n            dialog.setTitle("Backrooms")\n\n            root = FrameLayout(activity)\n            root.setLayoutParams(\n                ViewGroup.LayoutParams(\n                    ViewGroup.LayoutParams.MATCH_PARENT,\n                    ViewGroup.LayoutParams.MATCH_PARENT,\n                )\n            )\n\n            web = WebView(activity)\n            web.setLayoutParams(\n                ViewGroup.LayoutParams(\n                    ViewGroup.LayoutParams.MATCH_PARENT,\n                    ViewGroup.LayoutParams.MATCH_PARENT,\n                )\n            )\n\n            web_settings = web.getSettings()\n            web_settings.setJavaScriptEnabled(True)\n            web_settings.setDomStorageEnabled(True)\n            web_settings.setAllowFileAccess(True)\n            web_settings.setAllowContentAccess(True)\n            try:\n                web_settings.setCacheMode(WebSettings.LOAD_NO_CACHE)\n                web.clearCache(True)\n                web.clearHistory()\n            except Exception:\n                pass\n            try:\n                # Локальный HTML: доступ к file:// нужен, универсальный\n                # доступ к file:// намеренно запрещён.\n                web_settings.setAllowFileAccessFromFileURLs(True)\n                web_settings.setAllowUniversalAccessFromFileURLs(False)\n            except Exception:\n                pass\n            try:\n                web.setWebViewClient(WebViewClient())\n            except Exception:\n                pass\n\n            # Прокидываем JS-консоль и ошибки страницы в лог приложения.\n            # Без этого сбои в WebView (например загрузка звука) не видны\n            # вообще нигде — диагностировать нечем.\n            if dynamic_proxy is not None:\n                try:\n\n                    class _ChromeClient(dynamic_proxy(WebChromeClient)):\n                        def onConsoleMessage(self, cm) -> bool:\n                            try:\n                                log(\n                                    "[Backrooms JS] "\n                                    + str(cm.message())\n                                    + " ("\n                                    + str(cm.sourceId())\n                                    + ":"\n                                    + str(cm.lineNumber())\n                                    + ")"\n                                )\n                            except Exception:\n                                pass\n                            return False\n\n                    web.setWebChromeClient(_ChromeClient())\n                except Exception as exc:\n                    log(f"[Backrooms] WebChromeClient не установлен: {exc}")\n\n            root.addView(web)\n            dialog.setContentView(root)\n\n            def cleanup_webview() -> None:\n                """Остановить медиа и полностью уничтожить WebView."""\n                try:\n                    web.loadUrl("about:blank")\n                    web.onPause()\n                    web.removeAllViews()\n                    web.destroy()\n                    log("[Backrooms] WebView уничтожен, звуки остановлены")\n                except Exception as exc:\n                    log(f"[Backrooms] ошибка очистки WebView: {exc}")\n\n            if dynamic_proxy is not None:\n                class DialogDismissListener(dynamic_proxy(DialogInterface.OnDismissListener)):\n                    def onDismiss(self, _dialog) -> None:\n                        cleanup_webview()\n\n                dialog.setOnDismissListener(DialogDismissListener())\n            else:\n                class DialogDismissListener:\n                    def onDismiss(self, _dialog) -> None:\n                        cleanup_webview()\n\n                try:\n                    dialog.setOnDismissListener(DialogDismissListener())\n                except Exception as exc:\n                    log(f"[Backrooms] не удалось повесить OnDismissListener: {exc}")\n\n            dialog.show()\n\n            try:\n                window = dialog.getWindow()\n                if window:\n                    window.setLayout(\n                        ViewGroup.LayoutParams.MATCH_PARENT,\n                        ViewGroup.LayoutParams.MATCH_PARENT,\n                    )\n                    window.setBackgroundDrawable(ColorDrawable(Color.TRANSPARENT))\n                    flags = (\n                        View.SYSTEM_UI_FLAG_LAYOUT_STABLE\n                        | View.SYSTEM_UI_FLAG_LAYOUT_HIDE_NAVIGATION\n                        | View.SYSTEM_UI_FLAG_LAYOUT_FULLSCREEN\n                        | View.SYSTEM_UI_FLAG_HIDE_NAVIGATION\n                        | View.SYSTEM_UI_FLAG_FULLSCREEN\n                        | View.SYSTEM_UI_FLAG_IMMERSIVE_STICKY\n                    )\n                    window.getDecorView().setSystemUiVisibility(flags)\n                    window.addFlags(WindowManager.LayoutParams.FLAG_FULLSCREEN)\n            except Exception as exc:\n                log(f"[Backrooms] ошибка полноэкранного режима: {exc}")\n\n            log("[Backrooms] loadUrl: " + url)\n            web.loadUrl(url)\n        except Exception as exc:\n            log("[Backrooms] показ не удался: " + repr(exc))\n            log(traceback.format_exc())\n\n    run_on_ui_thread(_show)\n', False, '<backrooms>/webview/dialog.py'),
    'backrooms.webview.installer': ('"""Установка собранного web UI в каталог данных плагина.\n\nЛогика решения об обновлении и записи файлов чистая и тестируется\nофлайн. Резолв каталога данных устройства изолирован за функцией с\nбезопасным офлайн-фолбэком.\n"""\n\nfrom __future__ import annotations\n\nimport os\nimport tempfile\n\nfrom catalib.support import log\n\nfrom .. import config\nfrom ..webui.builder import build_index_html\n\n\ndef files_dir() -> str:\n    """Каталог данных приложения для записи web UI.\n\n    На устройстве — ``filesDir`` приложения (как в исходном плагине);\n    вне exteraGram — временный каталог (для офлайн-тестов).\n    """\n    try:  # pragma: no cover - выполняется только на устройстве\n        from org.telegram.messenger import ApplicationLoader\n\n        ctx = ApplicationLoader.applicationContext\n        return ctx.getFilesDir().getAbsolutePath()\n    except Exception:\n        return tempfile.gettempdir()\n\n\ndef webui_dir(base: str | None = None) -> str:\n    """Каталог web UI внутри каталога данных.\n\n    :param base: базовый каталог; по умолчанию :func:`files_dir`.\n    """\n    root = base if base is not None else files_dir()\n    return os.path.join(root, config.WEBUI_DIRNAME)\n\n\ndef needs_rewrite(dir_path: str, version: str, force: bool) -> bool:\n    """Нужно ли перезаписывать установленный ``index.html``.\n\n    :param dir_path: каталог web UI.\n    :param version: текущая версия web UI (:data:`config.UI_VERSION`).\n    :param force: принудительная переустановка (из настроек).\n    :returns: ``True``, если файла нет, маркер версии отличается или\n        запрошена принудительная переустановка.\n    """\n    if force:\n        return True\n    index_path = os.path.join(dir_path, config.WEBUI_INDEX)\n    marker_path = os.path.join(dir_path, config.WEBUI_VERSION_MARKER)\n    if not (os.path.exists(index_path) and os.path.exists(marker_path)):\n        return True\n    try:\n        with open(marker_path, encoding="utf-8") as marker:\n            return marker.read().strip() != version\n    except OSError:\n        return True\n\n\ndef write_text(path: str, text: str) -> None:\n    """Записать текст в файл, создав родительские каталоги.\n\n    :param path: путь файла.\n    :param text: содержимое (UTF-8).\n    """\n    parent = os.path.dirname(path)\n    if parent and not os.path.exists(parent):\n        os.makedirs(parent, exist_ok=True)\n    with open(path, "w", encoding="utf-8") as out:\n        out.write(text)\n\n\ndef ensure_webui_installed(force: bool = False, base: str | None = None) -> str:\n    """Гарантировать наличие свежего ``index.html`` и вернуть путь к нему.\n\n    Документ собирается :func:`webui.builder.build_index_html`. Запись\n    идёт, если :func:`needs_rewrite` истинно; затем обновляется маркер\n    версии. Диагностика пишется в лог приложения.\n\n    :param force: принудительная переустановка независимо от версии.\n    :param base: базовый каталог (для тестов); по умолчанию устройство.\n    :returns: абсолютный путь к установленному ``index.html``.\n    """\n    dir_path = webui_dir(base)\n    index_path = os.path.join(dir_path, config.WEBUI_INDEX)\n    marker_path = os.path.join(dir_path, config.WEBUI_VERSION_MARKER)\n\n    if needs_rewrite(dir_path, config.UI_VERSION, force):\n        os.makedirs(dir_path, exist_ok=True)\n        write_text(index_path, build_index_html())\n        try:\n            write_text(marker_path, config.UI_VERSION)\n        except OSError:\n            pass\n\n    try:\n        size = os.path.getsize(index_path) if os.path.exists(index_path) else -1\n        log(f"[Backrooms] webui path={index_path} exists={os.path.exists(index_path)} size={size}")\n    except OSError:\n        pass\n\n    return index_path\n', False, '<backrooms>/webview/installer.py'),
    'catalib': ('"""catalib — инструмент сборки модульных плагинов exteraGram в один файл.\n\nПакет содержит две среды исполнения с жёсткой границей между ними:\n\n- Среда инструмента (подпакеты ``cli``, ``manifest``, ``bundler``, ``deploy``,\n  ``scaffold``) — исполняется на машине разработчика.\n- Встраиваемая среда (подпакеты ``runtime``, ``support``) — её исходники\n  попадают внутрь собранного плагина и исполняются под Chaquopy на устройстве,\n  поэтому зависят только от стандартной библиотеки и SDK exteraGram.\n\nЗдесь же объявлена :func:`check_for_updates` — безопасная проверка наличия\nболее новой версии catalib на PyPI. Все её зависимости (``urllib``,\n``json`` и т. п.) импортируются **лениво внутри функции**: при обычном\n``import catalib`` (в т. ч. в вендоренном виде внутри плагина на\nустройстве) никаких сетевых запросов и тяжёлых импортов не происходит.\nВызывается из CLI; никогда не роняет команду.\n"""\n\nfrom __future__ import annotations\n\n__all__ = ["__version__", "check_for_updates"]\n\n#: Версия пакета. Единый источник истины — синхронизирована с ``pyproject.toml``.\n__version__ = "0.3.2"\n\n#: Имя пакета на PyPI и переменная окружения для отключения проверки.\n_PYPI_JSON_URL = "https://pypi.org/pypi/catalib/json"\n_OPT_OUT_ENV = "CATALIB_NO_UPDATE_CHECK"\n#: Срок жизни кеша последней проверки, секунд (сутки).\n_CACHE_TTL_SECONDS = 24 * 60 * 60\n\n\ndef _parse_version(value: str) -> tuple[int, ...]:\n    """Разобрать строку версии ``X.Y.Z`` в кортеж чисел для сравнения.\n\n    Нечисловые/пред-релизные части отбрасываются с первого нечислового\n    сегмента (грубое, но безопасное сравнение SemVer без внешних\n    зависимостей: ложного «доступно обновление» не даёт).\n    """\n    parts: list[int] = []\n    for chunk in value.strip().split("."):\n        if chunk.isdigit():\n            parts.append(int(chunk))\n        else:\n            break\n    return tuple(parts)\n\n\ndef _is_newer(latest: str, current: str) -> bool:\n    """``True``, если ``latest`` строго новее ``current``."""\n    lp, cp = _parse_version(latest), _parse_version(current)\n    if not lp or not cp:\n        return False\n    return lp > cp\n\n\ndef _cache_path() -> str:\n    """Путь к файлу кеша проверки обновлений (в каталоге кеша пользователя)."""\n    import os\n\n    base = os.environ.get("XDG_CACHE_HOME") or os.path.join(\n        os.path.expanduser("~"), ".cache"\n    )\n    return os.path.join(base, "catalib", "update-check.json")\n\n\ndef _read_cache(now: float) -> str | None:\n    """Вернуть закешированную последнюю версию, если кеш свежий, иначе ``None``."""\n    import json\n\n    try:\n        with open(_cache_path(), encoding="utf-8") as handle:\n            data = json.load(handle)\n        if now - float(data["ts"]) < _CACHE_TTL_SECONDS:\n            latest = data.get("latest")\n            return latest if isinstance(latest, str) else None\n    except Exception:\n        return None\n    return None\n\n\ndef _write_cache(now: float, latest: str) -> None:\n    """Сохранить результат проверки (без падения при ошибке ФС)."""\n    import json\n    import os\n\n    try:\n        path = _cache_path()\n        os.makedirs(os.path.dirname(path), exist_ok=True)\n        with open(path, "w", encoding="utf-8") as handle:\n            json.dump({"ts": now, "latest": latest}, handle)\n    except Exception:\n        pass\n\n\ndef _fetch_latest_version(timeout: float) -> str | None:\n    """Запросить последнюю версию catalib с PyPI (или ``None`` при ошибке)."""\n    import json\n    import urllib.request\n\n    try:\n        with urllib.request.urlopen(_PYPI_JSON_URL, timeout=timeout) as response:\n            payload = json.loads(response.read().decode("utf-8"))\n        version = payload["info"]["version"]\n        return version if isinstance(version, str) else None\n    except Exception:\n        return None\n\n\ndef check_for_updates(timeout: float = 2.5) -> str | None:\n    """Проверить, есть ли на PyPI более новая версия catalib.\n\n    Полностью безопасна: при отключении, любой ошибке сети, таймауте или\n    проблеме с кешем возвращает ``None`` и ничего не печатает. Сетевой\n    запрос делается не чаще раза в сутки (кеш\n    ``~/.cache/catalib/update-check.json``). Отключается переменной\n    окружения ``CATALIB_NO_UPDATE_CHECK=1``. Не вызывается при импорте\n    пакета — только из CLI.\n\n    :param timeout: таймаут HTTP-запроса к PyPI в секундах.\n    :returns: строка более новой версии (например ``"0.4.0"``) либо\n        ``None``, если обновления нет или проверку выполнить не удалось.\n    """\n    import os\n    import time\n\n    if os.environ.get(_OPT_OUT_ENV, "").strip() not in ("", "0", "false", "False"):\n        return None\n\n    now = time.time()\n    latest = _read_cache(now)\n    if latest is None:\n        latest = _fetch_latest_version(timeout)\n        if latest is None:\n            return None\n        _write_cache(now, latest)\n\n    return latest if _is_newer(latest, __version__) else None\n', True, '<catalib-vendor>/catalib/__init__.py'),
    'catalib.support': ('"""Урезанный фасад catalib.support (сгенерирован catalib).\n\nИмпортирует только то, что использует плагин, чтобы фасад не\nтянул отсечённые подмодули."""\n\nfrom __future__ import annotations\n\nfrom catalib.support import settings\nfrom catalib.support.plugin import CatalibPlugin, menu_item\nfrom catalib.support.sdk import log, run_on_ui_thread\nfrom catalib.support.settings import SettingItem\n\n__all__ = [\'CatalibPlugin\', \'SettingItem\', \'log\', \'menu_item\', \'run_on_ui_thread\', \'settings\']\n', True, '<catalib-vendor>/catalib/support/__init__.py'),
    'catalib.support.hooks': ('"""Декларативная разметка хуков плагина.\n\nДокументированная типичная ошибка: реализовать ``on_send_message_hook`` и\nзабыть вызвать ``add_on_send_message_hook`` в ``on_plugin_load``. Здесь метод\nпомечается декоратором, а :class:`~catalib.support.plugin.CatalibPlugin`\nрегистрирует его автоматически — забыть регистрацию невозможно.\n"""\n\nfrom __future__ import annotations\n\nfrom collections.abc import Callable\nfrom dataclasses import dataclass\nfrom typing import Any\n\n#: Имя атрибута-маркера на функции с описанием хука.\nHOOK_ATTR = "__catalib_hook__"\n\n#: Имя атрибута-маркера на методе-обработчике события приложения.\nAPP_EVENT_ATTR = "__catalib_app_event__"\n\n\n#: Виды хуков, привязанных к фиксированным методам SDK по имени\n#: запроса/апдейта (диспетчеризуются :class:`CatalibPlugin`).\nREQUEST_HOOK_KINDS = ("pre_request", "post_request", "on_update", "on_updates")\n\n\n@dataclass(frozen=True, slots=True)\nclass HookSpec:\n    """Описание хука, привязанного к методу плагина.\n\n    :param kind: ``"send_message"`` — хук исходящих сообщений;\n        ``"request"`` — общая регистрация по имени запроса (как раньше);\n        ``"pre_request"``/``"post_request"``/``"on_update"``/\n        ``"on_updates"`` — конкретные хук-методы SDK с диспетчеризацией.\n    :param name: имя запроса/апдейта (для ``send_message`` — пусто).\n    :param priority: приоритет регистрации хука.\n    :param match_substring: матчить ``name`` как подстроку (как в\n        ``add_hook(match_substring=True)``); по умолчанию ``False``.\n    """\n\n    kind: str\n    name: str\n    priority: int\n    match_substring: bool = False\n\n\n@dataclass(frozen=True, slots=True)\nclass AppEventSpec:\n    """Описание подписки метода на события жизненного цикла приложения.\n\n    :param events: кортеж событий (значения ``AppEvent``); пустой кортеж —\n        обработчик вызывается на всех событиях.\n    """\n\n    events: tuple[Any, ...]\n\n\ndef _mark(func: Callable, spec: HookSpec) -> Callable:\n    setattr(func, HOOK_ATTR, spec)\n    return func\n\n\ndef _mark_app_event(func: Callable, events: tuple[Any, ...]) -> Callable:\n    setattr(func, APP_EVENT_ATTR, AppEventSpec(events=events))\n    return func\n\n\nclass _Hook:\n    """Фабрика декораторов хуков (экземпляр доступен как ``hook``)."""\n\n    def send_message(self, func: Callable | None = None, *, priority: int = 0) -> Callable:\n        """Пометить метод как хук исходящих сообщений.\n\n        Применяется и как ``@hook.send_message``, и как\n        ``@hook.send_message(priority=5)``.\n        """\n\n        def decorator(target: Callable) -> Callable:\n            return _mark(target, HookSpec(kind="send_message", name="", priority=priority))\n\n        return decorator(func) if func is not None else decorator\n\n    def request(self, name: str, *, priority: int = 0) -> Callable[[Callable], Callable]:\n        """Пометить метод как хук сетевого запроса ``name``."""\n        if not isinstance(name, str) or not name:\n            raise ValueError("имя запроса для hook.request должно быть непустой строкой")\n\n        def decorator(target: Callable) -> Callable:\n            return _mark(target, HookSpec(kind="request", name=name, priority=priority))\n\n        return decorator\n\n    def _request_kind(\n        self, kind: str, name: str, priority: int, match_substring: bool\n    ) -> Callable[[Callable], Callable]:\n        """Общий конструктор декораторов хук-методов запроса/апдейта."""\n        if not isinstance(name, str) or not name:\n            raise ValueError(f"имя для hook.{kind} должно быть непустой строкой")\n\n        def decorator(target: Callable) -> Callable:\n            return _mark(\n                target,\n                HookSpec(\n                    kind=kind,\n                    name=name,\n                    priority=priority,\n                    match_substring=match_substring,\n                ),\n            )\n\n        return decorator\n\n    def pre_request(\n        self, name: str, *, priority: int = 0, match_substring: bool = False\n    ) -> Callable[[Callable], Callable]:\n        """Пометить метод как хук ``pre_request_hook`` запроса ``name``.\n\n        Обработчик: ``handler(request_name, account, request) ->\n        HookResult | None``. catalib регистрирует ``add_hook(name)`` и\n        диспетчеризует вызов ``pre_request_hook`` в помеченный метод.\n        """\n        return self._request_kind("pre_request", name, priority, match_substring)\n\n    def post_request(\n        self, name: str, *, priority: int = 0, match_substring: bool = False\n    ) -> Callable[[Callable], Callable]:\n        """Пометить метод как хук ``post_request_hook`` запроса ``name``.\n\n        Обработчик: ``handler(request_name, account, response, error) ->\n        HookResult | None``.\n        """\n        return self._request_kind("post_request", name, priority, match_substring)\n\n    def on_update(\n        self, name: str, *, priority: int = 0, match_substring: bool = False\n    ) -> Callable[[Callable], Callable]:\n        """Пометить метод как хук ``on_update_hook`` апдейта ``name``.\n\n        Обработчик: ``handler(update_name, account, update) ->\n        HookResult | None``.\n        """\n        return self._request_kind("on_update", name, priority, match_substring)\n\n    def on_updates(\n        self, name: str, *, priority: int = 0, match_substring: bool = False\n    ) -> Callable[[Callable], Callable]:\n        """Пометить метод как хук ``on_updates_hook`` контейнера ``name``.\n\n        Обработчик: ``handler(container_name, account, updates) ->\n        HookResult | None``.\n        """\n        return self._request_kind("on_updates", name, priority, match_substring)\n\n    def app_event(self, *events: Any) -> Callable:\n        """Пометить метод как обработчик событий жизненного цикла приложения.\n\n        exteraGram вызывает ``plugin.on_app_event(event_type)`` при смене\n        состояния приложения. :class:`~catalib.support.plugin.CatalibPlugin`\n        реализует диспетчер ``on_app_event``, который вызывает помеченные\n        методы; ручная проверка ``event_type`` в одном большом методе не\n        нужна. Сам обработчик получает ``event_type``.\n\n        Формы применения:\n\n        - ``@hook.app_event`` или ``@hook.app_event()`` — все события;\n        - ``@hook.app_event(AppEvent.START)`` — только указанные события;\n        - ``@hook.app_event(AppEvent.PAUSE, AppEvent.RESUME)`` — несколько.\n\n        :param events: значения ``AppEvent``; без аргументов — все события.\n            Перечень событий не валидируется: будущая сборка SDK может\n            добавить новые, и catalib не должен их отвергать.\n        """\n        # Бар-форма: @hook.app_event — единственный аргумент это сам метод\n        # (он callable; значения AppEvent — не callable).\n        if len(events) == 1 and callable(events[0]):\n            return _mark_app_event(events[0], ())\n\n        def decorator(target: Callable) -> Callable:\n            return _mark_app_event(target, tuple(events))\n\n        return decorator\n\n\n#: Единственный публичный экземпляр фабрики декораторов хуков.\nhook = _Hook()\n', False, '<catalib-vendor>/catalib/support/hooks.py'),
    'catalib.support.plugin': ('"""Базовый класс плагина с автоматической регистрацией хуков и меню.\n\n``CatalibPlugin`` устраняет шаблон и класс ошибок «хук определён, но не\nзарегистрирован»: помеченные :mod:`~catalib.support.hooks` методы и\nобъявленные пункты меню регистрируются автоматически в ``on_plugin_load``.\nПрямой доступ к API SDK не ограничивается — слой только убирает шаблон.\n"""\n\nfrom __future__ import annotations\n\nfrom collections.abc import Callable\nfrom dataclasses import dataclass\nfrom typing import Any\n\nfrom catalib.support.hooks import (\n    APP_EVENT_ATTR,\n    HOOK_ATTR,\n    REQUEST_HOOK_KINDS,\n    AppEventSpec,\n    HookSpec,\n)\nfrom catalib.support.sdk import BasePlugin\nfrom catalib.support.settings import SettingItem\nfrom catalib.support.xposed import (\n    XPOSED_ATTR,\n    XposedSpec,\n    register_xposed,\n    unregister_xposed,\n)\n\n#: Атрибут-маркер метода-обработчика пункта меню.\nMENU_ATTR = "__catalib_menu__"\n\n\n#: Допустимые типы меню exteraGram (значения MenuItemType).\nMENU_TYPES = (\n    "DRAWER_MENU",\n    "MESSAGE_CONTEXT_MENU",\n    "CHAT_ACTION_MENU",\n    "PROFILE_ACTION_MENU",\n)\n\n\n@dataclass(frozen=True, slots=True)\nclass MenuSpec:\n    """Описание пункта меню, привязанного к методу-обработчику.\n\n    Метод-обработчик получает один аргумент ``context: dict`` (см. SDK).\n\n    :param item_id: необязательный стабильный идентификатор пункта.\n    :param condition: необязательный предикат показа пункта (как в SDK).\n    :param priority: необязательный приоритет пункта (по умолчанию 0 —\n        в ``MenuItemData`` не передаётся, действует значение SDK).\n    """\n\n    text: str\n    menu_type: str\n    icon: str = ""\n    subtext: str = ""\n    item_id: str = ""\n    condition: Any = None\n    priority: int = 0\n\n\ndef menu_item(\n    text: str,\n    menu_type: str = "DRAWER_MENU",\n    icon: str = "",\n    subtext: str = "",\n    *,\n    item_id: str = "",\n    condition: Any = None,\n    priority: int = 0,\n) -> Callable[[Callable], Callable]:\n    """Пометить метод как обработчик пункта меню.\n\n    :param text: подпись пункта меню.\n    :param menu_type: тип меню — одно из значений :data:`MENU_TYPES`\n        (``DRAWER_MENU``, ``MESSAGE_CONTEXT_MENU``, ``CHAT_ACTION_MENU``,\n        ``PROFILE_ACTION_MENU``).\n    :param icon: необязательное имя иконки (drawable).\n    :param subtext: необязательная подпись под текстом.\n    :param item_id: необязательный стабильный идентификатор пункта.\n    :param condition: необязательный предикат показа пункта.\n    :param priority: необязательный приоритет (0 — не передаётся в SDK).\n\n    Декорируемый метод обязан принимать аргумент ``context: dict``.\n    Новые параметры — keyword-only; прежние позиционные вызовы и\n    формируемый ``MenuItemData`` не меняются.\n    """\n    if not isinstance(text, str) or not text:\n        raise ValueError("текст пункта меню должен быть непустой строкой")\n    if menu_type not in MENU_TYPES:\n        raise ValueError(f"menu_type должен быть одним из {MENU_TYPES}")\n\n    def decorator(func: Callable) -> Callable:\n        setattr(\n            func,\n            MENU_ATTR,\n            MenuSpec(\n                text=text,\n                menu_type=menu_type,\n                icon=icon,\n                subtext=subtext,\n                item_id=item_id,\n                condition=condition,\n                priority=priority,\n            ),\n        )\n        return func\n\n    return decorator\n\n\nclass CatalibPlugin(BasePlugin):\n    """Базовый класс плагина catalib с автоматической регистрацией.\n\n    Подклассы реализуют помеченные хуки/меню и при необходимости методы\n    ``settings`` (вернуть список :class:`SettingItem`) и ``on_load``\n    (пользовательская инициализация). Регистрация хуков и меню происходит\n    автоматически — повторять её вручную не нужно.\n    """\n\n    #: Распознаётся загрузчиком как класс плагина (см. bootstrap).\n    __catalib_plugin__ = True\n\n    #: Собранные при создании класса хуки: list[(имя_метода, HookSpec)].\n    _catalib_hooks: tuple[tuple[str, HookSpec], ...] = ()\n    #: Собранные пункты меню: list[(имя_метода, MenuSpec)].\n    _catalib_menu: tuple[tuple[str, MenuSpec], ...] = ()\n    #: Собранные обработчики событий приложения: list[(имя_метода, AppEventSpec)].\n    _catalib_app_events: tuple[tuple[str, AppEventSpec], ...] = ()\n    #: Собранные Xposed-хуки: list[(имя_метода, XposedSpec)].\n    _catalib_xposed: tuple[tuple[str, XposedSpec], ...] = ()\n\n    def __init_subclass__(cls, **kwargs: object) -> None:\n        super().__init_subclass__(**kwargs)\n        hooks: list[tuple[str, HookSpec]] = []\n        menu: list[tuple[str, MenuSpec]] = []\n        app_events: list[tuple[str, AppEventSpec]] = []\n        xposed: list[tuple[str, XposedSpec]] = []\n        for attr_name in dir(cls):\n            member = getattr(cls, attr_name, None)\n            if not callable(member):\n                continue\n            hook_spec = getattr(member, HOOK_ATTR, None)\n            if isinstance(hook_spec, HookSpec):\n                hooks.append((attr_name, hook_spec))\n            menu_spec = getattr(member, MENU_ATTR, None)\n            if isinstance(menu_spec, MenuSpec):\n                menu.append((attr_name, menu_spec))\n            app_event_spec = getattr(member, APP_EVENT_ATTR, None)\n            if isinstance(app_event_spec, AppEventSpec):\n                app_events.append((attr_name, app_event_spec))\n            xposed_spec = getattr(member, XPOSED_ATTR, None)\n            if isinstance(xposed_spec, XposedSpec):\n                xposed.append((attr_name, xposed_spec))\n        cls._catalib_hooks = tuple(sorted(hooks))\n        cls._catalib_menu = tuple(sorted(menu))\n        cls._catalib_app_events = tuple(sorted(app_events, key=lambda pair: pair[0]))\n        cls._catalib_xposed = tuple(sorted(xposed, key=lambda pair: pair[0]))\n\n    #: Дескрипторы зарегистрированных Xposed-хуков (для on_plugin_unload).\n    #: Класс-умолчание — безопасный неизменяемый ``()``; экземпляр получает\n    #: новый список в ``on_plugin_load`` (нет общего мутабельного состояния).\n    _catalib_xposed_handles: tuple[Any, ...] | list[Any] = ()\n\n    def on_plugin_load(self) -> None:\n        """Зарегистрировать хуки, меню и Xposed-хуки, затем вызвать on_load."""\n        for _attr_name, spec in self._catalib_hooks:\n            if spec.kind == "send_message":\n                self._register_send_message_hook(spec.priority)\n            elif spec.kind == "request":\n                self.add_hook(spec.name)\n            elif spec.kind in REQUEST_HOOK_KINDS:\n                self._register_request_hook(spec)\n        for attr_name, menu_spec in self._catalib_menu:\n            self._register_menu_item(attr_name, menu_spec)\n        handles: list[Any] = []\n        for attr_name, xposed_spec in self._catalib_xposed:\n            handle = register_xposed(self, attr_name, xposed_spec)\n            if handle is not None:\n                handles.append(handle)\n        self._catalib_xposed_handles = handles\n        self.on_load()\n\n    def on_plugin_unload(self) -> None:\n        """Снять зарегистрированные Xposed-хуки и вызвать on_unload.\n\n        Прежнее поведение сохранено: без Xposed-хуков и без переопределения\n        ``on_unload`` метод фактически ничего не делает (как до 0.2.0, когда\n        ``on_plugin_unload`` не определялся вовсе). Подкласс, переопределивший\n        ``on_plugin_unload`` напрямую, продолжает работать как раньше.\n        """\n        for handle in getattr(self, "_catalib_xposed_handles", ()):\n            unregister_xposed(self, handle)\n        self._catalib_xposed_handles = []\n        self.on_unload()\n\n    def on_app_event(self, event_type: Any) -> None:\n        """Диспетчер событий жизненного цикла приложения.\n\n        exteraGram вызывает этот метод при смене состояния приложения.\n        Вызывает все методы, помеченные ``@hook.app_event``, у которых\n        событие подходит (без указанных событий — на любое). Обработчику\n        передаётся ``event_type``.\n\n        Прямое переопределение ``on_app_event`` в подклассе по-прежнему\n        работает (поведение SDK не ограничивается). Если декораторы не\n        использовались, метод ничего не делает — это эквивалентно\n        отсутствию обработчика, как было до 0.2.0.\n        """\n        for attr_name, spec in self._catalib_app_events:\n            if not spec.events or event_type in spec.events:\n                getattr(self, attr_name)(event_type)\n\n    def _register_request_hook(self, spec: HookSpec) -> None:\n        """Зарегистрировать имя запроса/апдейта через ``add_hook``.\n\n        SDK по этому имени будет вызывать фиксированные методы\n        ``pre_request_hook``/``post_request_hook``/``on_update_hook``/\n        ``on_updates_hook``; их реализуют диспетчеры ниже. Сигнатура\n        ``add_hook`` на старых сборках без ``match_substring``/``priority``\n        — graceful fallback.\n        """\n        try:\n            self.add_hook(\n                spec.name,\n                match_substring=spec.match_substring,\n                priority=spec.priority,\n            )\n        except TypeError:\n            self.add_hook(spec.name)\n\n    def _dispatch_request_hook(self, kind: str, name: str, *args: Any) -> Any:\n        """Вызвать помеченные ``@hook.<kind>`` обработчики по имени.\n\n        Совпадение по равенству имени либо по подстроке (если у спецификации\n        ``match_substring``). Возвращается первый не-``None`` результат\n        обработчика, иначе ``HookResult()`` (стратегия DEFAULT — поведение\n        не меняется, если обработчиков нет: эквивалентно их отсутствию до\n        0.3.0). Прямое переопределение метода-хука в подклассе по-прежнему\n        перекрывает диспетчер (MRO).\n        """\n        from catalib.support.sdk import HookResult\n\n        for attr_name, spec in self._catalib_hooks:\n            if spec.kind != kind:\n                continue\n            matched = (\n                spec.name in name if spec.match_substring else spec.name == name\n            )\n            if not matched:\n                continue\n            result = getattr(self, attr_name)(name, *args)\n            if result is not None:\n                return result\n        return HookResult()\n\n    def pre_request_hook(self, request_name: str, account: int, request: Any) -> Any:\n        """Диспетчер ``@hook.pre_request`` (см. :meth:`_dispatch_request_hook`)."""\n        return self._dispatch_request_hook(\n            "pre_request", request_name, account, request\n        )\n\n    def post_request_hook(\n        self, request_name: str, account: int, response: Any, error: Any\n    ) -> Any:\n        """Диспетчер ``@hook.post_request``."""\n        return self._dispatch_request_hook(\n            "post_request", request_name, account, response, error\n        )\n\n    def on_update_hook(self, update_name: str, account: int, update: Any) -> Any:\n        """Диспетчер ``@hook.on_update``."""\n        return self._dispatch_request_hook(\n            "on_update", update_name, account, update\n        )\n\n    def on_updates_hook(\n        self, container_name: str, account: int, updates: Any\n    ) -> Any:\n        """Диспетчер ``@hook.on_updates``."""\n        return self._dispatch_request_hook(\n            "on_updates", container_name, account, updates\n        )\n\n    def _register_send_message_hook(self, priority: int) -> None:\n        """Зарегистрировать хук исходящих сообщений с приоритетом, если он поддержан."""\n        try:\n            self.add_on_send_message_hook(priority)\n        except TypeError:\n            # Старые сборки SDK: метод без аргумента приоритета.\n            self.add_on_send_message_hook()\n\n    def _register_menu_item(self, attr_name: str, menu_spec: MenuSpec) -> None:\n        """Построить и зарегистрировать пункт меню для метода-обработчика.\n\n        Использует реальный API SDK: ``MenuItemData(menu_type=MenuItemType.X,\n        text=..., on_click=...)``. Обработчик получает ``context: dict``.\n        """\n        from catalib.support.sdk import MenuItemData, MenuItemType\n\n        handler = getattr(self, attr_name)\n        kwargs = {\n            "menu_type": getattr(MenuItemType, menu_spec.menu_type),\n            "text": menu_spec.text,\n            "on_click": handler,\n        }\n        if menu_spec.icon:\n            kwargs["icon"] = menu_spec.icon\n        if menu_spec.subtext:\n            kwargs["subtext"] = menu_spec.subtext\n        # Необязательные поля пробрасываются только когда заданы: прежний\n        # вызов (без них) формирует тот же MenuItemData, что и раньше.\n        if menu_spec.item_id:\n            kwargs["item_id"] = menu_spec.item_id\n        if menu_spec.condition is not None:\n            kwargs["condition"] = menu_spec.condition\n        if menu_spec.priority:\n            kwargs["priority"] = menu_spec.priority\n        self.add_menu_item(MenuItemData(**kwargs))\n\n    def settings(self) -> list[SettingItem]:\n        """Переопределяемый метод: вернуть список элементов настроек."""\n        return []\n\n    def create_settings(self) -> list[object]:\n        """Построить элементы настроек для exteraGram из объявленных."""\n        return [item.build() for item in self.settings()]\n\n    def on_load(self) -> None:\n        """Переопределяемый хук пользовательской инициализации плагина."""\n\n    def on_unload(self) -> None:\n        """Переопределяемый хук пользовательской очистки плагина.\n\n        Вызывается из ``on_plugin_unload`` после автоснятия Xposed-хуков.\n        По умолчанию ничего не делает.\n        """\n', False, '<catalib-vendor>/catalib/support/plugin.py'),
    'catalib.support.sdk': ('"""Безопасные импорты SDK exteraGram с заглушками для офлайн-тестов.\n\nЕдинственная точка адаптации к SDK: если плагин исполняется в exteraGram —\nиспользуются настоящие классы и функции; вне приложения (юнит-тесты на\nобычном Python) подключаются минимальные заглушки с тем же интерфейсом.\nЭто устраняет россыпь ``try/except`` по плагину и даёт офлайн-тестируемость\nдоменной логики. Код только стандартной библиотеки и SDK.\n"""\n\nfrom __future__ import annotations\n\nimport tempfile\nfrom typing import Any\n\n#: Истинно, если плагин исполняется внутри exteraGram (SDK доступен).\nSDK_AVAILABLE: bool\n\ntry:  # pragma: no cover - ветка выполняется только на устройстве\n    from base_plugin import (\n        BasePlugin,\n        HookResult,\n        HookStrategy,\n        MenuItemData,\n        MenuItemType,\n    )\n\n    SDK_AVAILABLE = True\nexcept Exception:  # pragma: no cover - ветка для обычного Python\n    SDK_AVAILABLE = False\n\n    class HookStrategy:\n        """Заглушка стратегий хука, повторяющая значения SDK."""\n\n        DEFAULT = "DEFAULT"\n        CANCEL = "CANCEL"\n        MODIFY = "MODIFY"\n        MODIFY_FINAL = "MODIFY_FINAL"\n\n    class HookResult:\n        """Заглушка результата хука со всеми полями SDK.\n\n        Поля соответствуют документации plugin-class: ``strategy``,\n        ``request``, ``response``, ``update``, ``updates``, ``params``.\n        ``strategy``/``params`` остаются первыми позиционными (обратная\n        совместимость), остальные — необязательные.\n        """\n\n        def __init__(\n            self,\n            strategy: str | None = None,\n            params: Any = None,\n            request: Any = None,\n            response: Any = None,\n            update: Any = None,\n            updates: Any = None,\n        ) -> None:\n            self.strategy = strategy or HookStrategy.DEFAULT\n            self.params = params\n            self.request = request\n            self.response = response\n            self.update = update\n            self.updates = updates\n\n    class MenuItemType:\n        """Заглушка типов пунктов меню (значения как в SDK exteraGram)."""\n\n        DRAWER_MENU = "DRAWER_MENU"\n        MESSAGE_CONTEXT_MENU = "MESSAGE_CONTEXT_MENU"\n        CHAT_ACTION_MENU = "CHAT_ACTION_MENU"\n        PROFILE_ACTION_MENU = "PROFILE_ACTION_MENU"\n\n    class MenuItemData:\n        """Заглушка описания пункта меню."""\n\n        def __init__(self, **kwargs: Any) -> None:\n            self.__dict__.update(kwargs)\n\n    class BasePlugin:\n        """Заглушка базового класса плагина для офлайн-тестов.\n\n        Повторяет минимальный публичный интерфейс SDK, фиксируя вызовы\n        регистрации, чтобы их можно было проверить в тестах.\n        """\n\n        def __init__(self) -> None:\n            self._settings: dict[str, Any] = {}\n            self.registered_hooks: list[Any] = []\n            self.registered_menu_items: list[Any] = []\n            self.removed_menu_items: list[Any] = []\n            self.registered_xposed: list[Any] = []\n            self.registered_hook_all: list[Any] = []\n            self.hook_method_calls: list[dict[str, Any]] = []\n            self.unhooked: list[Any] = []\n            self.logged: list[str] = []\n            self._menu_seq = 0\n            self._menu_by_id: dict[Any, Any] = {}\n\n        def add_on_send_message_hook(self, priority: int = 0) -> None:\n            self.registered_hooks.append(("send_message", priority))\n\n        def add_hook(\n            self, name: str, match_substring: bool = False, priority: int = 0\n        ) -> None:\n            # Кортеж (name, priority) сохранён прежним для обратной\n            # совместимости; match_substring фиксируется отдельно.\n            self.registered_hooks.append((name, priority))\n            if match_substring:\n                self.registered_hooks.append((name, "substring"))\n\n        def hook_method(\n            self,\n            member: Any,\n            handler: Any = None,\n            priority: int = 10,\n            before_filters: Any = (),\n            after_filters: Any = (),\n            before: Any = None,\n            after: Any = None,\n        ) -> Any:\n            """Зафиксировать Xposed-хук; вернуть дескриптор для unhook.\n\n            Дескриптор — прежний 4-кортеж (обратная совместимость); полный\n            набор аргументов фиксируется в ``hook_method_calls``.\n            """\n            handle = ("xposed", member, handler, priority)\n            self.registered_xposed.append(handle)\n            self.hook_method_calls.append(\n                {\n                    "member": member,\n                    "handler": handler,\n                    "priority": priority,\n                    "before_filters": tuple(before_filters),\n                    "after_filters": tuple(after_filters),\n                    "before": before,\n                    "after": after,\n                }\n            )\n            return handle\n\n        def hook_all_methods(\n            self, clazz: Any, method_name: str, handler: Any\n        ) -> list[Any]:\n            """Зафиксировать хук всех перегрузок метода; вернуть список."""\n            handle = ("xposed_all_methods", clazz, method_name, handler)\n            self.registered_hook_all.append(handle)\n            return [handle]\n\n        def hook_all_constructors(self, clazz: Any, handler: Any) -> list[Any]:\n            """Зафиксировать хук всех конструкторов; вернуть список."""\n            handle = ("xposed_all_constructors", clazz, handler)\n            self.registered_hook_all.append(handle)\n            return [handle]\n\n        def unhook_method(self, handle: Any) -> None:\n            """Зафиксировать снятие Xposed-хука."""\n            self.unhooked.append(handle)\n\n        def add_menu_item(self, data: Any) -> Any:\n            """Зафиксировать пункт меню; вернуть его идентификатор."""\n            self._menu_seq += 1\n            item_id = getattr(data, "item_id", None) or self._menu_seq\n            self.registered_menu_items.append(data)\n            self._menu_by_id[item_id] = data\n            return item_id\n\n        def remove_menu_item(self, item_id: Any) -> None:\n            """Зафиксировать удаление пункта меню по идентификатору."""\n            self.removed_menu_items.append(item_id)\n            data = self._menu_by_id.pop(item_id, None)\n            if data is not None and data in self.registered_menu_items:\n                self.registered_menu_items.remove(data)\n\n        def get_setting(self, key: str, default: Any = None) -> Any:\n            return self._settings.get(key, default)\n\n        def set_setting(\n            self, key: str, value: Any, reload_settings: bool = False\n        ) -> None:\n            self._settings[key] = value\n\n        def export_settings(self) -> dict[str, Any]:\n            """Вернуть копию всех настроек плагина."""\n            return dict(self._settings)\n\n        def import_settings(\n            self, settings: dict[str, Any], reload_settings: bool = True\n        ) -> None:\n            """Заменить/дополнить настройки плагина переданными."""\n            self._settings.update(settings)\n\n        def log(self, message: str) -> None:\n            self.logged.append(message)\n\n\n# --------------------------------------------------------------------------\n# Расширенный SDK (события приложения и Xposed-хуки).\n#\n# Импортируется НЕЗАВИСИМЫМИ ``try/except``, отдельно от ядра выше: на\n# старой сборке SDK какого-то из этих имён может не быть, и это не должно\n# сбрасывать ``SDK_AVAILABLE`` и подменять ядро (``BasePlugin`` и пр.)\n# заглушками. Каждое имя при отсутствии получает собственную офлайн-заглушку\n# с тем же интерфейсом — для офлайн-тестов.\n# --------------------------------------------------------------------------\n\ntry:  # pragma: no cover - ветка выполняется только на устройстве\n    from base_plugin import AppEvent\nexcept Exception:  # pragma: no cover - ветка для обычного Python\n\n    class AppEvent:\n        """Заглушка событий жизненного цикла приложения (значения как в SDK)."""\n\n        START = "START"\n        STOP = "STOP"\n        PAUSE = "PAUSE"\n        RESUME = "RESUME"\n\n\ntry:  # pragma: no cover - ветка выполняется только на устройстве\n    from base_plugin import BaseHook\nexcept Exception:  # pragma: no cover - ветка для обычного Python\n\n    class BaseHook:\n        """Заглушка базового класса Xposed-хука."""\n\n\ntry:  # pragma: no cover - ветка выполняется только на устройстве\n    from base_plugin import MethodHook\nexcept Exception:  # pragma: no cover - ветка для обычного Python\n\n    class MethodHook(BaseHook):\n        """Заглушка хука метода: переопределяемые before/after — no-op офлайн."""\n\n        def before_hooked_method(self, param: Any) -> None:\n            """Вызывается до оригинального метода (офлайн — ничего не делает)."""\n\n        def after_hooked_method(self, param: Any) -> None:\n            """Вызывается после оригинального метода (офлайн — ничего не делает)."""\n\n\ntry:  # pragma: no cover - ветка выполняется только на устройстве\n    from base_plugin import MethodReplacement\nexcept Exception:  # pragma: no cover - ветка для обычного Python\n\n    class MethodReplacement(BaseHook):\n        """Заглушка полной замены метода (офлайн — возвращает ``None``)."""\n\n        def replace_hooked_method(self, param: Any) -> Any:\n            """Замещает оригинальный метод (офлайн — ничего не делает)."""\n            return None\n\n\ntry:  # pragma: no cover - ветка выполняется только на устройстве\n    from base_plugin import HookFilter\nexcept Exception:  # pragma: no cover - ветка для обычного Python\n\n    class HookFilter:\n        """Заглушка фильтров Xposed-хуков.\n\n        Константы — строки, параметрические фильтры возвращают кортеж-маркер\n        ``(имя, *аргументы)``. Этого достаточно офлайн-тестам, чтобы\n        проверить, что фильтр дошёл до регистрации без изменений.\n        """\n\n        RESULT_IS_NULL = "RESULT_IS_NULL"\n        RESULT_IS_TRUE = "RESULT_IS_TRUE"\n        RESULT_IS_FALSE = "RESULT_IS_FALSE"\n        RESULT_NOT_NULL = "RESULT_NOT_NULL"\n\n        @staticmethod\n        def ResultIsInstanceOf(clazz: Any) -> tuple:\n            """Результат является экземпляром ``clazz``."""\n            return ("ResultIsInstanceOf", clazz)\n\n        @staticmethod\n        def ResultEqual(value: Any) -> tuple:\n            """Результат равен ``value``."""\n            return ("ResultEqual", value)\n\n        @staticmethod\n        def ResultNotEqual(value: Any) -> tuple:\n            """Результат не равен ``value``."""\n            return ("ResultNotEqual", value)\n\n        @staticmethod\n        def ArgumentIsNull(index: int) -> tuple:\n            """Аргумент ``index`` равен ``null``."""\n            return ("ArgumentIsNull", index)\n\n        @staticmethod\n        def ArgumentNotNull(index: int) -> tuple:\n            """Аргумент ``index`` не ``null``."""\n            return ("ArgumentNotNull", index)\n\n        @staticmethod\n        def ArgumentIsFalse(index: int) -> tuple:\n            """Аргумент ``index`` равен ``false``."""\n            return ("ArgumentIsFalse", index)\n\n        @staticmethod\n        def ArgumentIsTrue(index: int) -> tuple:\n            """Аргумент ``index`` равен ``true``."""\n            return ("ArgumentIsTrue", index)\n\n        @staticmethod\n        def ArgumentIsInstanceOf(index: int, clazz: Any) -> tuple:\n            """Аргумент ``index`` является экземпляром ``clazz``."""\n            return ("ArgumentIsInstanceOf", index, clazz)\n\n        @staticmethod\n        def ArgumentEqual(index: int, value: Any) -> tuple:\n            """Аргумент ``index`` равен ``value``."""\n            return ("ArgumentEqual", index, value)\n\n        @staticmethod\n        def ArgumentNotEqual(index: int, value: Any) -> tuple:\n            """Аргумент ``index`` не равен ``value``."""\n            return ("ArgumentNotEqual", index, value)\n\n        @staticmethod\n        def Condition(mvel_expr: str, obj: Any = None) -> tuple:\n            """MVEL-выражение истинно."""\n            return ("Condition", mvel_expr, obj)\n\n        @staticmethod\n        def Or(*filters: Any) -> tuple:\n            """Хотя бы один из вложенных фильтров истинен."""\n            return ("Or", *filters)\n\n\ntry:  # pragma: no cover - ветка выполняется только на устройстве\n    from base_plugin import hook_filters\nexcept Exception:  # pragma: no cover - ветка для обычного Python\n\n    def hook_filters(*filters: Any) -> Any:\n        """Заглушка декоратора фильтров Xposed-хука.\n\n        Офлайн сохраняет фильтры в атрибуте функции (``__catalib_filters__``),\n        чтобы тест мог проверить, что фильтры применены, и возвращает функцию\n        без изменений.\n        """\n\n        def decorator(func: Any) -> Any:\n            existing = getattr(func, "__catalib_filters__", ())\n            func.__catalib_filters__ = tuple(existing) + tuple(filters)\n            return func\n\n        return decorator\n\n\ntry:  # pragma: no cover - ветка выполняется только на устройстве\n    from hook_utils import find_class\nexcept Exception:  # pragma: no cover - ветка для обычного Python\n\n    def find_class(name: str) -> Any:\n        """Заглушка поиска Java-класса: вне exteraGram класса нет."""\n        return None\n\n\ndef log(message: str) -> None:\n    """Записать строку в лог приложения (или в no-op вне exteraGram)."""\n    try:  # pragma: no cover - на устройстве\n        from android_utils import log as _log\n\n        _log(message)\n    except Exception:\n        pass\n\n\ndef run_on_ui_thread(callback: Any, delay: int = 0) -> None:\n    """Выполнить callback в UI-потоке (на устройстве) или сразу (офлайн).\n\n    :param callback: вызываемый объект без аргументов.\n    :param delay: задержка в миллисекундах (на устройстве; офлайн\n        игнорируется — вызов выполняется немедленно).\n    """\n    try:  # pragma: no cover - на устройстве\n        from android_utils import run_on_ui_thread as _ui\n\n        try:\n            _ui(callback, delay)\n        except TypeError:\n            # Старые сборки SDK: run_on_ui_thread без аргумента задержки.\n            _ui(callback)\n        return\n    except Exception:\n        callback()\n\n\ndef get_plugins_dir() -> str:\n    """Каталог плагинов на устройстве; во офлайн-режиме — временный каталог."""\n    try:  # pragma: no cover - на устройстве\n        from file_utils import get_plugins_dir as _dir\n\n        return _dir()\n    except Exception:\n        return tempfile.gettempdir()\n\n\n__all__ = [\n    "SDK_AVAILABLE",\n    "AppEvent",\n    "BaseHook",\n    "BasePlugin",\n    "HookFilter",\n    "HookResult",\n    "HookStrategy",\n    "MenuItemData",\n    "MenuItemType",\n    "MethodHook",\n    "MethodReplacement",\n    "find_class",\n    "get_plugins_dir",\n    "hook_filters",\n    "log",\n    "run_on_ui_thread",\n]\n', False, '<catalib-vendor>/catalib/support/sdk.py'),
    'catalib.support.settings': ('"""Типизированные декларативные настройки плагина.\n\nОписание настроек не зависит от наличия SDK: на устройстве элементы\nконвертируются в классы ``ui.settings`` exteraGram, в офлайн-тестах остаются\nсамодостаточными объектами с теми же полями.\n\nПолный паритет с публичным SDK ``ui.settings`` (ADR-0006): компоненты\n``header``, ``divider``, ``switch``, ``selector``, ``text_input`` (Input),\n``edit_text`` (EditText), ``text`` (кликабельный Text), ``custom`` со всеми\nпараметрами SDK (``on_click``, ``on_change``, ``icon``, ``accent``, ``red``,\n``link_alias``, ``create_sub_fragment``, ``multiline``, ``max_length``,\n``mask``).\n\nРасширения строго аддитивны: прежние позиционные сигнатуры ``header``,\n``switch``, ``text_input``, ``text`` сохранены, а новые параметры — только\nkeyword-only и со «незаданным» значением по умолчанию, поэтому для прежнего\nкода итоговый ``params`` (и вызов ``ui.settings``) не меняется.\n"""\n\nfrom __future__ import annotations\n\nfrom collections.abc import Callable\nfrom dataclasses import dataclass, field\nfrom typing import Any\n\n#: Поддерживаемые типы элементов настроек и соответствующие классы ui.settings.\n_SDK_CLASS_BY_KIND = {\n    "header": "Header",\n    "divider": "Divider",\n    "switch": "Switch",\n    "selector": "Selector",\n    "input": "Input",\n    "edittext": "EditText",\n    "text": "Text",\n    "custom": "Custom",\n}\n\n\n@dataclass(frozen=True, slots=True)\nclass SettingItem:\n    """Один элемент настроек плагина.\n\n    :param kind: тип элемента — ключ из :data:`_SDK_CLASS_BY_KIND`\n        (``header`` | ``divider`` | ``switch`` | ``selector`` | ``input`` |\n        ``edittext`` | ``text`` | ``custom``).\n    :param params: именованные параметры, передаваемые классу ``ui.settings``.\n    """\n\n    kind: str\n    params: dict[str, Any] = field(default_factory=dict)\n\n    def build(self) -> Any:\n        """Построить объект ``ui.settings`` (на устройстве) либо вернуть себя.\n\n        В офлайн-окружении SDK недоступен — возвращается сам элемент, что\n        удобно для модульных тестов.\n        """\n        try:  # pragma: no cover - выполняется только на устройстве\n            from ui import settings as sdk_settings\n\n            sdk_class = getattr(sdk_settings, _SDK_CLASS_BY_KIND[self.kind])\n            return sdk_class(**self.params)\n        except Exception:\n            return self\n\n\ndef header(text: str) -> SettingItem:\n    """Заголовок секции настроек.\n\n    :param text: текст заголовка.\n    """\n    return SettingItem("header", {"text": text})\n\n\ndef divider(text: str = "") -> SettingItem:\n    """Разделитель с необязательной подписью.\n\n    :param text: необязательная подпись разделителя; если пусто — без неё.\n    """\n    params: dict[str, Any] = {}\n    if text:\n        params["text"] = text\n    return SettingItem("divider", params)\n\n\ndef switch(\n    key: str,\n    text: str,\n    default: bool = False,\n    subtext: str = "",\n    *,\n    icon: str = "",\n    on_change: Callable[..., Any] | None = None,\n    on_long_click: Callable[..., Any] | None = None,\n    link_alias: str = "",\n) -> SettingItem:\n    """Переключатель булевой настройки.\n\n    :param key: ключ настройки (``get_setting``/``set_setting``).\n    :param text: подпись переключателя.\n    :param default: значение по умолчанию.\n    :param subtext: необязательная подпись под текстом.\n    :param icon: необязательная иконка (drawable).\n    :param on_change: необязательный обработчик изменения значения.\n    :param on_long_click: необязательный обработчик долгого нажатия.\n    :param link_alias: необязательный алиас для ссылки на настройку.\n    """\n    params: dict[str, Any] = {"key": key, "text": text, "default": default}\n    if subtext:\n        params["subtext"] = subtext\n    if icon:\n        params["icon"] = icon\n    if on_change is not None:\n        params["on_change"] = on_change\n    if on_long_click is not None:\n        params["on_long_click"] = on_long_click\n    if link_alias:\n        params["link_alias"] = link_alias\n    return SettingItem("switch", params)\n\n\ndef selector(\n    key: str,\n    text: str,\n    default: int,\n    items: list[str],\n    *,\n    icon: str = "",\n    on_change: Callable[..., Any] | None = None,\n    on_long_click: Callable[..., Any] | None = None,\n    link_alias: str = "",\n) -> SettingItem:\n    """Выпадающий список (выбор одного значения из набора).\n\n    :param key: ключ настройки; хранит индекс выбранного пункта.\n    :param text: подпись селектора.\n    :param default: индекс выбранного по умолчанию пункта.\n    :param items: непустой список подписей пунктов.\n    :param icon: необязательная иконка (drawable).\n    :param on_change: необязательный обработчик изменения значения.\n    :param on_long_click: необязательный обработчик долгого нажатия.\n    :param link_alias: необязательный алиас для ссылки на настройку.\n    :raises ValueError: если ``items`` не является непустым списком строк.\n    """\n    if not isinstance(items, list) or not items:\n        raise ValueError("items селектора должен быть непустым списком")\n    if not all(isinstance(it, str) for it in items):\n        raise ValueError("items селектора должен содержать только строки")\n    params: dict[str, Any] = {\n        "key": key,\n        "text": text,\n        "default": default,\n        "items": items,\n    }\n    if icon:\n        params["icon"] = icon\n    if on_change is not None:\n        params["on_change"] = on_change\n    if on_long_click is not None:\n        params["on_long_click"] = on_long_click\n    if link_alias:\n        params["link_alias"] = link_alias\n    return SettingItem("selector", params)\n\n\ndef text_input(\n    key: str,\n    text: str,\n    default: str = "",\n    subtext: str = "",\n    icon: str = "",\n    *,\n    on_change: Callable[..., Any] | None = None,\n    on_long_click: Callable[..., Any] | None = None,\n    link_alias: str = "",\n) -> SettingItem:\n    """Однострочное текстовое поле ввода (``ui.settings.Input``).\n\n    :param key: ключ настройки.\n    :param text: подпись поля.\n    :param default: значение по умолчанию.\n    :param subtext: необязательная подпись под текстом.\n    :param icon: необязательная иконка (drawable).\n    :param on_change: необязательный обработчик изменения значения.\n    :param on_long_click: необязательный обработчик долгого нажатия.\n    :param link_alias: необязательный алиас для ссылки на настройку.\n    """\n    params: dict[str, Any] = {"key": key, "text": text, "default": default}\n    if subtext:\n        params["subtext"] = subtext\n    if icon:\n        params["icon"] = icon\n    if on_change is not None:\n        params["on_change"] = on_change\n    if on_long_click is not None:\n        params["on_long_click"] = on_long_click\n    if link_alias:\n        params["link_alias"] = link_alias\n    return SettingItem("input", params)\n\n\ndef edit_text(\n    key: str,\n    hint: str,\n    default: str = "",\n    *,\n    multiline: bool = False,\n    max_length: int = 0,\n    mask: str = "",\n    on_change: Callable[..., Any] | None = None,\n) -> SettingItem:\n    """Многострочное текстовое поле (``ui.settings.EditText``).\n\n    :param key: ключ настройки.\n    :param hint: текст-подсказка (placeholder).\n    :param default: значение по умолчанию; добавляется при непустом значении.\n    :param multiline: разрешить многострочный ввод.\n    :param max_length: ограничение длины (>0 — добавляется в параметры).\n    :param mask: необязательная маска ввода.\n    :param on_change: необязательный обработчик изменения значения.\n    """\n    params: dict[str, Any] = {"key": key, "hint": hint}\n    if default:\n        params["default"] = default\n    if multiline:\n        params["multiline"] = True\n    if max_length:\n        params["max_length"] = max_length\n    if mask:\n        params["mask"] = mask\n    if on_change is not None:\n        params["on_change"] = on_change\n    return SettingItem("edittext", params)\n\n\ndef text(\n    text: str,\n    subtext: str = "",\n    icon: str = "",\n    *,\n    accent: bool = False,\n    red: bool = False,\n    on_click: Callable[..., Any] | None = None,\n    on_long_click: Callable[..., Any] | None = None,\n    create_sub_fragment: Callable[..., Any] | None = None,\n    link_alias: str = "",\n) -> SettingItem:\n    """Информационная или кликабельная строка (``ui.settings.Text``).\n\n    Первоклассный способ сделать строку настроек кликабельной — передать\n    ``on_click``; ручной перебор API клика в плагине больше не нужен.\n\n    :param text: основной текст строки.\n    :param subtext: необязательная подпись под текстом.\n    :param icon: необязательная иконка (drawable).\n    :param accent: выделить акцентным цветом.\n    :param red: выделить красным (деструктивное действие).\n    :param on_click: обработчик клика по строке.\n    :param on_long_click: необязательный обработчик долгого нажатия.\n    :param create_sub_fragment: фабрика вложенного экрана настроек.\n    :param link_alias: необязательный алиас для ссылки на настройку.\n    """\n    params: dict[str, Any] = {"text": text}\n    if subtext:\n        params["subtext"] = subtext\n    if icon:\n        params["icon"] = icon\n    if accent:\n        params["accent"] = True\n    if red:\n        params["red"] = True\n    if on_click is not None:\n        params["on_click"] = on_click\n    if on_long_click is not None:\n        params["on_long_click"] = on_long_click\n    if create_sub_fragment is not None:\n        params["create_sub_fragment"] = create_sub_fragment\n    if link_alias:\n        params["link_alias"] = link_alias\n    return SettingItem("text", params)\n\n\ndef custom(\n    *,\n    item: Any = None,\n    view: Any = None,\n    factory: Callable[..., Any] | None = None,\n    factory_args: Any = None,\n    on_click: Callable[..., Any] | None = None,\n    on_long_click: Callable[..., Any] | None = None,\n    create_sub_fragment: Callable[..., Any] | None = None,\n    link_alias: str = "",\n) -> SettingItem:\n    """Кастомная строка настроек (``ui.settings.Custom``).\n\n    Источник содержимого задаётся одним из ``item`` / ``view`` / ``factory``.\n\n    :param item: готовый элемент строки.\n    :param view: готовое Android-``View``.\n    :param factory: фабрика, создающая ``View`` (см. :func:`simple_setting_factory`).\n    :param factory_args: аргументы фабрики.\n    :param on_click: необязательный обработчик клика.\n    :param on_long_click: необязательный обработчик долгого нажатия.\n    :param create_sub_fragment: фабрика вложенного экрана настроек.\n    :param link_alias: необязательный алиас для ссылки на настройку.\n    :raises ValueError: если не задан ни ``item``, ни ``view``, ни ``factory``.\n    """\n    if item is None and view is None and factory is None:\n        raise ValueError("custom требует один из аргументов: item, view или factory")\n    params: dict[str, Any] = {}\n    if item is not None:\n        params["item"] = item\n    if view is not None:\n        params["view"] = view\n    if factory is not None:\n        params["factory"] = factory\n    if factory_args is not None:\n        params["factory_args"] = factory_args\n    if on_click is not None:\n        params["on_click"] = on_click\n    if on_long_click is not None:\n        params["on_long_click"] = on_long_click\n    if create_sub_fragment is not None:\n        params["create_sub_fragment"] = create_sub_fragment\n    if link_alias:\n        params["link_alias"] = link_alias\n    return SettingItem("custom", params)\n\n\ndef simple_setting_factory(\n    create_view: Callable[..., Any],\n    bind_view: Callable[..., Any],\n    *,\n    is_clickable: bool = False,\n    is_shadow: bool = False,\n    create_item: Callable[..., Any] | None = None,\n    on_click: Callable[..., Any] | None = None,\n    on_long_click: Callable[..., Any] | None = None,\n    attached_view: Callable[..., Any] | None = None,\n    equals: Callable[..., Any] | None = None,\n    content_equals: Callable[..., Any] | None = None,\n) -> Any:\n    """Построить ``ui.settings.SimpleSettingFactory`` для строки ``custom``.\n\n    На устройстве возвращается настоящий ``SimpleSettingFactory``; офлайн —\n    самодостаточный объект с теми же полями и вызываемый\n    (``factory(link_alias=..., *args)``), что удобно для модульных тестов.\n\n    :param create_view: ``create_view(context, list_view, current_account,\n        class_guid, resources_provider) -> View``.\n    :param bind_view: ``bind_view(view, item, divider, adapter, list_view)``.\n    :param is_clickable: строка кликабельна.\n    :param is_shadow: строка-тень (разделитель).\n    :param create_item: фабрика элемента строки.\n    :param on_click: ``on_click(plugin, item, view)``.\n    :param on_long_click: ``on_long_click(plugin, item, view) -> bool``.\n    :param attached_view: фабрика прикреплённого ``View``.\n    :param equals: сравнение элементов.\n    :param content_equals: сравнение содержимого элементов.\n    """\n    kwargs: dict[str, Any] = {\n        "create_view": create_view,\n        "bind_view": bind_view,\n        "is_clickable": is_clickable,\n        "is_shadow": is_shadow,\n    }\n    for name, value in (\n        ("create_item", create_item),\n        ("on_click", on_click),\n        ("on_long_click", on_long_click),\n        ("attached_view", attached_view),\n        ("equals", equals),\n        ("content_equals", content_equals),\n    ):\n        if value is not None:\n            kwargs[name] = value\n    try:  # pragma: no cover - выполняется только на устройстве\n        from ui.settings import SimpleSettingFactory as _SSF\n\n        return _SSF(**kwargs)\n    except Exception:\n        return _OfflineSettingFactory(kwargs)\n\n\nclass _OfflineSettingFactory:\n    """Офлайн-двойник ``SimpleSettingFactory``: хранит поля и вызываем."""\n\n    def __init__(self, kwargs: dict[str, Any]) -> None:\n        self.kwargs = kwargs\n\n    def __call__(self, *args: Any, link_alias: str = "", **extra: Any) -> _OfflineSettingFactory:\n        self.link_alias = link_alias\n        self.call_args = args\n        return self\n', False, '<catalib-vendor>/catalib/support/settings.py'),
    'catalib.support.xposed': ('"""Декларативные Xposed-хуки методов Java.\n\nДокументированный паттерн exteraGram (см. шаблон ``xposed_demo``):\n``find_class`` → ``getDeclaredMethod``/``getDeclaredConstructor`` →\n``self.hook_method(method, MethodHook(), priority=...)`` → в\n``on_plugin_unload`` ``self.unhook_method(handle)``. Это много шаблона и\nтиповая ошибка — забыть ``unhook``.\n\nЗдесь хук объявляется одним декоратором :func:`xposed` на методе плагина;\n:class:`~catalib.support.plugin.CatalibPlugin` регистрирует его в\n``on_plugin_load`` и снимает в ``on_plugin_unload`` автоматически. Все\nошибки рефлексии перехватываются и логируются (рефлексия хрупка при\nобновлении приложения — pitfall #7), кадр загрузки не падает.\n\nСлой не скрывает SDK: те же ``MethodHook``/``MethodReplacement``/\n``HookFilter``/``find_class`` доступны напрямую через\n:mod:`catalib.support.sdk`. Зависит только от стандартной библиотеки и SDK.\n"""\n\nfrom __future__ import annotations\n\nfrom collections.abc import Callable\nfrom dataclasses import dataclass, field\nfrom typing import Any\n\nimport catalib.support.sdk as sdk\n\n#: Имя атрибута-маркера на методе-обработчике Xposed-хука.\nXPOSED_ATTR = "__catalib_xposed__"\n\n#: Допустимые фазы хука.\n_PHASES = ("before", "after", "replace")\n\n\n@dataclass(frozen=True, slots=True)\nclass XposedSpec:\n    """Описание декларативного Xposed-хука, привязанного к методу плагина.\n\n    :param class_fqn: полное имя Java-класса (``org.telegram.ui.ChatActivity``).\n    :param method_name: имя метода; для конструктора игнорируется.\n    :param phase: ``before`` | ``after`` | ``replace``.\n    :param priority: приоритет хука (по умолчанию 10, как в SDK).\n    :param is_constructor: хукать конструктор, а не метод.\n    :param arg_types: типы аргументов для разрешения перегрузки —\n        кортеж FQN-строк (резолвятся ``find_class``) либо уже готовых\n        Java-``Class``; ``None`` — без уточнения (метод без перегрузок).\n    :param filters: кортеж фильтров ``HookFilter`` (применяются через\n        ``hook_filters`` к методу моста).\n    """\n\n    class_fqn: str\n    method_name: str\n    phase: str\n    priority: int = 10\n    is_constructor: bool = False\n    arg_types: tuple[Any, ...] | None = None\n    filters: tuple[Any, ...] = field(default_factory=tuple)\n\n\ndef xposed(\n    class_fqn: str,\n    method_name: str = "",\n    *,\n    phase: str = "after",\n    priority: int = 10,\n    is_constructor: bool = False,\n    arg_types: tuple[Any, ...] | list[Any] | None = None,\n    filters: tuple[Any, ...] | list[Any] = (),\n) -> Callable[[Callable], Callable]:\n    """Пометить метод плагина как обработчик Xposed-хука.\n\n    Обработчик получает один аргумент ``param`` (``MethodHookParam`` SDK):\n    ``param.thisObject``, ``param.args``, ``param.getResult()``,\n    ``param.setResult(v)`` и т. д. Для ``phase="replace"`` возвращаемое\n    значение обработчика становится результатом метода.\n\n    :param class_fqn: полное имя Java-класса (непустая строка).\n    :param method_name: имя метода; для конструктора можно опустить.\n    :param phase: ``before`` (до оригинала), ``after`` (после) или\n        ``replace`` (полная замена).\n    :param priority: приоритет хука.\n    :param is_constructor: хукать конструктор.\n    :param arg_types: типы аргументов для разрешения перегрузки.\n    :param filters: фильтры ``HookFilter`` (см. :mod:`catalib.support.sdk`).\n    :raises ValueError: при пустом ``class_fqn``, неизвестной ``phase`` или\n        пустом ``method_name`` для не-конструктора.\n    """\n    if not isinstance(class_fqn, str) or not class_fqn:\n        raise ValueError("class_fqn должен быть непустой строкой")\n    if phase not in _PHASES:\n        raise ValueError(f"phase должен быть одним из {_PHASES}")\n    if not is_constructor and (not isinstance(method_name, str) or not method_name):\n        raise ValueError("method_name обязателен для хука метода (не конструктора)")\n\n    spec = XposedSpec(\n        class_fqn=class_fqn,\n        method_name=method_name,\n        phase=phase,\n        priority=priority,\n        is_constructor=is_constructor,\n        arg_types=tuple(arg_types) if arg_types is not None else None,\n        filters=tuple(filters),\n    )\n\n    def decorator(func: Callable) -> Callable:\n        setattr(func, XPOSED_ATTR, spec)\n        return func\n\n    return decorator\n\n\ndef _make_bridge(handler: Callable[[Any], Any], phase: str, filters: tuple[Any, ...]) -> Any:\n    """Построить объект-мост SDK, делегирующий в связанный метод плагина.\n\n    Методы ``MethodHook``/``MethodReplacement`` получают ``self`` моста; сам\n    обработчик плагина уже связан (``self`` плагина захвачен). Фильтры\n    применяются к методу фазы через ``hook_filters`` ровно как в\n    документации SDK (``@hook_filters(...) def before_hooked_method``).\n    """\n\n    def phase_call(_self: Any, param: Any) -> Any:\n        return handler(param)\n\n    if filters:\n        phase_call = sdk.hook_filters(*filters)(phase_call)\n\n    if phase == "replace":\n        return type(\n            "_CatalibReplaceHook",\n            (sdk.MethodReplacement,),\n            {"replace_hooked_method": phase_call},\n        )()\n    method_name = "before_hooked_method" if phase == "before" else "after_hooked_method"\n    return type("_CatalibMethodHook", (sdk.MethodHook,), {method_name: phase_call})()\n\n\ndef _log(plugin: Any, message: str) -> None:\n    """Записать диагностику Xposed-слоя.\n\n    Предпочтительно через логгер плагина (есть и в SDK, и в офлайн-заглушке —\n    диагностику видно в тестах); при его отсутствии — через модульный\n    ``sdk.log`` (на устройстве уходит в ``android_utils.log``).\n    """\n    try:\n        plugin.log(message)\n    except Exception:\n        sdk.log(message)\n\n\ndef _resolve_member(spec: XposedSpec) -> Any:\n    """Найти Java-класс и нужный метод/конструктор по спецификации.\n\n    :returns: объект метода/конструктора либо ``None``, если класс или тип\n        аргумента не найдены (вне exteraGram ``find_class`` всегда ``None``).\n    """\n    cls_obj = sdk.find_class(spec.class_fqn)\n    if cls_obj is None:\n        return None\n    resolved: list[Any] = []\n    for arg in spec.arg_types or ():\n        if isinstance(arg, str):\n            arg_cls = sdk.find_class(arg)\n            if arg_cls is None:\n                return None\n            resolved.append(arg_cls)\n        else:\n            resolved.append(arg)\n    if spec.is_constructor:\n        return cls_obj.getDeclaredConstructor(*resolved)\n    return cls_obj.getDeclaredMethod(spec.method_name, *resolved)\n\n\ndef register_xposed(plugin: Any, attr_name: str, spec: XposedSpec) -> Any:\n    """Зарегистрировать один декларативный Xposed-хук на устройстве.\n\n    Безопасно: любая ошибка рефлексии логируется и не роняет загрузку\n    плагина (рефлексия хрупка при обновлении приложения — pitfall #7).\n\n    :param plugin: экземпляр плагина (источник ``hook_method`` и обработчика).\n    :param attr_name: имя метода-обработчика на плагине.\n    :param spec: спецификация хука.\n    :returns: дескриптор для ``unhook_method`` либо ``None`` при неуспехе.\n    """\n    try:\n        member = _resolve_member(spec)\n        if member is None:\n            _log(\n                plugin,\n                f"[catalib] Xposed: класс/метод не найден "\n                f"({spec.class_fqn}.{spec.method_name or \'<init>\'}) — хук пропущен",\n            )\n            return None\n        handler = getattr(plugin, attr_name)\n        bridge = _make_bridge(handler, spec.phase, spec.filters)\n        return plugin.hook_method(member, bridge, priority=spec.priority)\n    except Exception as exc:  # рефлексия/SDK хрупки — не валим on_plugin_load\n        _log(plugin, f"[catalib] Xposed: ошибка регистрации {spec.class_fqn}: {exc}")\n        return None\n\n\ndef unregister_xposed(plugin: Any, handle: Any) -> None:\n    """Снять один Xposed-хук, не роняя выгрузку при ошибке."""\n    try:\n        plugin.unhook_method(handle)\n    except Exception as exc:\n        _log(plugin, f"[catalib] Xposed: ошибка снятия хука: {exc}")\n', False, '<catalib-vendor>/catalib/support/xposed.py'),
}
_CATALIB_ENTRY = 'backrooms.plugin'

catalib_install('backrooms', globals(), _CATALIB_SOURCES, _CATALIB_ENTRY)
