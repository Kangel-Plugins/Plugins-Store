from typing import Any, List

from base_plugin import BasePlugin, MethodHook
from ui.settings import Header, Switch
from android_utils import log, run_on_ui_thread, OnClickListener
from hook_utils import find_class

from android.view import View, ViewGroup, Gravity
from android.view.animation import DecelerateInterpolator
from android.widget import ImageView, LinearLayout
from android.graphics import PorterDuff, PorterDuffColorFilter
from android.transition import AutoTransition, TransitionSet, ChangeBounds, Fade, TransitionManager
from org.telegram.messenger import AndroidUtilities, R
from org.telegram.ui.ActionBar import Theme
from org.telegram.ui.Components import CubicBezierInterpolator
from java import dynamic_proxy
from java.lang import Runnable as JRunnable, System
from java.lang.ref import WeakReference

__id__ = "compact_plugin_list"
__name__ = "CompactPluginList"
__description__ = "Скрывает описания и зависимости плагинов."
__author__ = "@rei_plugins (@optimist_opti)"
__version__ = "1.2"
__icon__ = "rei_plugins/2"
__app_version__ = ">=12.5.1"
__sdk_version__ = ">=1.4.4.3"

TAG = "[CPL]"
CELL_CLASS = "com.exteragram.messenger.plugins.ui.components.PluginCell"
MARKER = "cpl_expand_btn"

DESC_FIELDS = ("descriptionView", "description", "descView")
REQ_FIELDS = (
    "requirementsView", "requirementsLayout", "requirementsContainer",
    "depsView", "depsLayout", "chipsLayout", "tagsLayout", "requirements",
)
ROW_FIELDS = ("actionsFrame", "actionLayout", "buttonsLayout", "rowLayout")
GEAR_FIELDS = ("settingsButton", "settingsView", "settingsIcon", "pluginSettingsButton", "settings")
RECYCLER_TOKENS = ("RecyclerView", "RecyclerListView")

# --- Kangel Plugins Manager (KPM) -------------------------------------------------
# KPM сам перестраивает строку кнопок в своих ячейках: создаёт новый LinearLayout
# с тегом "kpm_buttons" и переносит туда shareButton, а детей штатного actionsFrame
# прячет (setVisibility GONE). Теги взяты из исходников KPM:
#   src/views/lists/plugin_list.py -> setTag("kpm_buttons"), setTag("kpm_translate_btn"),
#                                     setTag("kpm_bubbles")
#   src/hooks/install_top_actions.py -> "kpm_top_actions", "kpm_open_in_btn"
#   __id__ KPM -> "kangel_plugins_manager"
KPM_ID = "kangel_plugins_manager"
KPM_ROW_TAG = "kpm_buttons"
KPM_TAGS = ("kpm_bubbles", "kpm_translate_btn", "kpm_buttons", "kpm_top_actions", "kpm_open_in_btn")


def _field(obj, name):
    cls = obj.getClass()
    while cls is not None:
        try:
            f = cls.getDeclaredField(name)
            f.setAccessible(True)
            return f.get(obj)
        except Exception:
            pass
        try:
            cls = cls.getSuperclass()
        except Exception:
            break
    return None


def _first_field(obj, names):
    for name in names:
        v = _field(obj, name)
        if v is not None:
            return v
    return None


def _cid(obj) -> int:
    return int(System.identityHashCode(obj))


def _class_name(obj) -> str:
    try:
        return str(obj.getClass().getName())
    except Exception:
        return ""


def _find_ancestor(view, tokens, limit=10):
    p = view.getParent()
    for _ in range(limit):
        if p is None:
            return None
        if any(t in _class_name(p) for t in tokens):
            return p
        try:
            p = p.getParent()
        except Exception:
            return None
    return None


def _res(name: str) -> int:
    try:
        return int(getattr(R.drawable, name))
    except Exception:
        return 0


def _ease():
    try:
        return CubicBezierInterpolator.EASE_OUT_QUINT
    except Exception:
        return DecelerateInterpolator(1.8)


def _has_text(view) -> bool:
    try:
        t = view.getText()
        return bool(t and str(t).strip())
    except Exception:
        return True


def _set_shown(view, shown):
    try:
        view.setVisibility(View.VISIBLE if shown else View.GONE)
    except Exception:
        pass


def _walk_desc(view, depth=0):
    if depth > 10 or view is None:
        return None
    if "EffectsTextView" in _class_name(view):
        try:
            if len(str(view.getText() or "")) > 15:
                return view
        except Exception:
            return view
    if isinstance(view, ViewGroup):
        try:
            for i in range(view.getChildCount()):
                r = _walk_desc(view.getChildAt(i), depth + 1)
                if r is not None:
                    return r
        except Exception:
            pass
    return None


def _find_desc(cell):
    v = _first_field(cell, DESC_FIELDS)
    return v if v is not None else _walk_desc(cell)


def _find_requirements(cell):
    return _first_field(cell, REQ_FIELDS)


def _content_views(cell):
    return [v for v in (_find_desc(cell), _find_requirements(cell)) if v is not None]


def _plugin_key(cell) -> str:
    p = _field(cell, "plugin")
    if p is not None:
        for m in ("getId", "getPluginId"):
            try:
                v = getattr(p, m)()
                if v:
                    return str(v)
            except Exception:
                pass
    return "c%d" % _cid(cell)


def _declared_methods(cls):
    try:
        methods = cls.getDeclaredMethods()
        if methods is not None:
            return list(methods)
    except Exception:
        pass
    try:
        from java.lang import Class
        return list(Class.forName(CELL_CLASS).getDeclaredMethods())
    except Exception as e:
        log(TAG + " methods: %s" % e)
    return []


def _visible(view) -> bool:
    try:
        return view is not None and view.getVisibility() == View.VISIBLE
    except Exception:
        return False


def _visible_children(view) -> int:
    n = 0
    try:
        for i in range(view.getChildCount()):
            if _visible(view.getChildAt(i)):
                n += 1
    except Exception:
        pass
    return n


def _last_visible_index(row, skip=None) -> int:
    """Индекс последнего ВИДИМОГО ребёнка строки (нашу кнопку пропускаем)."""
    try:
        for i in range(row.getChildCount() - 1, -1, -1):
            ch = row.getChildAt(i)
            if ch is skip:
                continue
            if _visible(ch):
                return i
    except Exception:
        pass
    return -1



def _index_of(row, view) -> int:
    if view is None or row is None:
        return -1
    try:
        return int(row.indexOfChild(view))
    except Exception:
        return -1
def _kpm_row(cell):
    """Строка кнопок, которую построил KPM (LinearLayout с тегом kpm_buttons)."""
    try:
        v = cell.findViewWithTag(KPM_ROW_TAG)
        if isinstance(v, ViewGroup):
            return v
    except Exception:
        pass
    return None


def _is_kpm_cell(cell) -> bool:
    """Ячейка нарисована самим KPM (его список плагинов), а не штатным списком."""
    p = _field(cell, "plugin")
    if p is not None:
        try:
            if str(p.getEngine()) == KPM_ID:
                return True
        except Exception:
            pass
    for name in KPM_TAGS:
        try:
            if cell.findViewWithTag(name) is not None:
                return True
        except Exception:
            pass
    return False


def _find_icons_row(cell, kpm_fix=True):
    # Сначала пробуем строку KPM: если она есть, значит штатный actionsFrame
    # в этой ячейке пустой/скрытый, и наша кнопка "уезжает" именно из-за этого.
    if kpm_fix:
        k = _kpm_row(cell)
        if k is not None:
            return k

    v = _first_field(cell, ROW_FIELDS)
    if isinstance(v, ViewGroup) and _visible_children(v) > 0:
        return v

    best = None
    best_n = 0

    def walk(view, depth=0):
        nonlocal best, best_n
        if depth > 10 or not isinstance(view, ViewGroup):
            return
        try:
            n = view.getChildCount()
            imgs = 0
            for i in range(n):
                ch = view.getChildAt(i)
                # считаем только ВИДИМЫЕ иконки: у скрытых кнопок нулевой размер
                if _visible(ch) and "ImageView" in _class_name(ch):
                    imgs += 1
            if imgs >= 3 and isinstance(view, LinearLayout) and imgs > best_n:
                best_n = imgs
                best = view
            for i in range(n):
                walk(view.getChildAt(i), depth + 1)
        except Exception:
            pass

    walk(cell)
    return best


def _find_our(row):
    if row is None:
        return None
    try:
        for i in range(row.getChildCount()):
            ch = row.getChildAt(i)
            if ch.getTag() == MARKER:
                return ch
    except Exception:
        pass
    return None


def _find_gear(cell, row):
    # Шестерёнка настроек - наш якорь: стрелка всегда должна стоять сразу ПОСЛЕ
    # неё. Учитываем её, даже когда она сейчас скрыта: приложение обычно не
    # удаляет её из строки, а только переключает видимость. Если её не учесть,
    # кнопка встанет левее настроек - снаружи это выглядит как "настройки уехали
    # на место стрелки".
    def _in_row(v):
        try:
            return v is not None and row.indexOfChild(v) >= 0
        except Exception:
            return False

    def _is_icon(v):
        try:
            if isinstance(v, ImageView):
                return True
        except Exception:
            pass
        return "Image" in _class_name(v)

    for name in GEAR_FIELDS:            # 1) видимая
        v = _field(cell, name)
        if _in_row(v) and _is_icon(v) and _visible(v):
            return v
    for name in GEAR_FIELDS:            # 2) скрытая, но всё ещё в строке
        v = _field(cell, name)
        if _in_row(v) and _is_icon(v):
            return v
    try:                                # 3) по описанию кнопки
        for i in range(row.getChildCount()):
            ch = row.getChildAt(i)
            d = ch.getContentDescription()
            if d is not None:
                s = str(d).lower()
                if "настрой" in s or "setting" in s:
                    return ch
    except Exception:
        pass
    return None
def _button_params(row):
    size = AndroidUtilities.dp(28)
    left = right = 0
    for i in range(row.getChildCount()):
        ch = row.getChildAt(i)
        if ch.getTag() == MARKER or "ImageView" not in _class_name(ch):
            continue
        # у скрытых кнопок чужие/нулевые отступы - берём размеры у видимой
        if not _visible(ch):
            continue
        try:
            lp = ch.getLayoutParams()
            w = int(lp.width)
            if AndroidUtilities.dp(20) <= w <= AndroidUtilities.dp(48):
                size = w
            left, right = int(lp.leftMargin), int(lp.rightMargin)
        except Exception:
            pass
        break
    lp = LinearLayout.LayoutParams(size, size)
    lp.gravity = Gravity.CENTER_VERTICAL
    lp.leftMargin = left
    lp.rightMargin = right
    return lp


def _strip(root, depth=0):
    if depth > 14 or not isinstance(root, ViewGroup):
        return
    try:
        i = 0
        while i < root.getChildCount():
            ch = root.getChildAt(i)
            try:
                if ch.getTag() == MARKER:
                    root.removeViewAt(i)
                    continue
            except Exception:
                pass
            _strip(ch, depth + 1)
            i += 1
    except Exception:
        pass


def _strip_but(root, keep_row, depth=0):
    """Убирает наши кнопки отовсюду, кроме строки keep_row.
    Нужно, если KPM перестроил строку и кнопка осталась в прежнем контейнере."""
    if depth > 14 or not isinstance(root, ViewGroup):
        return
    try:
        i = 0
        while i < root.getChildCount():
            ch = root.getChildAt(i)
            try:
                if ch.getTag() == MARKER and root is not keep_row:
                    root.removeViewAt(i)
                    continue
            except Exception:
                pass
            if ch.getTag() != MARKER:
                _strip_but(ch, keep_row, depth + 1)
            i += 1
    except Exception:
        pass


_LAYOUT_PROXY = []


def _layout_proxy_cls():
    """Прокси android.view.View.OnLayoutChangeListener.

    Нужен, чтобы ПОСЛЕ КАЖДОЙ раскладки строки проверять позицию нашей кнопки:
    приложение (и KPM) достраивают строку кнопок уже ПОСЛЕ bind, из-за чего
    кнопка иногда вставала на место настроек. Если интерфейс недоступен в рантайме -
    возвращаем None, и плагин продолжает работать на повторных отложенных проверках.
    """
    if _LAYOUT_PROXY:
        return _LAYOUT_PROXY[0]
    cls = None
    try:
        cls = find_class("android.view.View$OnLayoutChangeListener")
    except Exception:
        cls = None
    if cls is None:
        _LAYOUT_PROXY.append(None)
        return None

    class _LayoutListener(dynamic_proxy(cls)):
        def __init__(self, plugin):
            super().__init__()
            self._plugin = plugin

        def onLayoutChange(self, v, left, top, right, bottom, ol, ot, orr, ob):
            try:
                self._plugin._on_row_layout(v)
            except Exception as e:
                log(TAG + " layout: %s" % e)

    _LAYOUT_PROXY.append(_LayoutListener)
    return _LayoutListener


class _BindHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            cell = param.thisObject
            if cell is not None:
                self.plugin._on_cell_bound(cell)
        except Exception as e:
            log(TAG + " bind: %s" % e)


class _Run(dynamic_proxy(JRunnable)):
    def __init__(self, fn):
        super().__init__()
        self._fn = fn

    def run(self):
        try:
            self._fn()
        except Exception as e:
            log(TAG + " run: %s" % e)


class _RowListener(dynamic_proxy(ViewGroup.OnHierarchyChangeListener)):
    def __init__(self, plugin):
        super().__init__()
        self._plugin = plugin

    def onChildViewAdded(self, parent, child):
        try:
            if child is not None and child.getTag() == MARKER:
                return
            self._plugin._schedule_place(parent)
        except Exception as e:
            log(TAG + " hierarchy: %s" % e)

    def onChildViewRemoved(self, parent, child):
        # Приложение может убрать или переставить свою кнопку (например шестерёнку)
        # - после этого наша кнопка тоже смещается, поэтому проверяем.
        try:
            self._plugin._schedule_place(parent)
        except Exception as e:
            log(TAG + " hierarchy remove: %s" % e)


class CompactPluginListPlugin(BasePlugin):

    def __init__(self):
        super().__init__()
        self._expanded = set()
        self._pending = set()
        self._cells = {}
        self._hooked = False
        self._icon_down = 0
        self._icon_up = 0
        self._row_listener = None
        self._row_watch_off = False
        self._placing = set()
        self._scheduled = set()
        self._muted = set()
        self._watched = set()
        self._lay_rows = set()

    def on_plugin_load(self):
        self._expanded = set()
        self._pending = set()
        self._cells = {}
        self._row_watch_off = False
        self._placing = set()
        self._scheduled = set()
        self._muted = set()
        self._watched = set()
        self._lay_rows = set()
        self._row_listener = _RowListener(self)
        try:
            _cls = _layout_proxy_cls()
            self._layout_listener = _cls(self) if _cls else None
        except Exception:
            self._layout_listener = None
        self._icon_down = _res("msg_go_down") or _res("page_down")
        self._icon_up = _res("msg_go_up") or _res("msg_to_beginning") or self._icon_down
        self._install_hooks()

    def on_plugin_unload(self):
        cells = [c for c in (r.get() for r in self._cells.values()) if c is not None]
        self._cells.clear()
        self._expanded.clear()
        self._pending.clear()
        self._hooked = False
        self._row_listener = None
        self._placing = set()
        self._scheduled = set()
        self._muted = set()
        self._watched = set()
        self._lay_rows = set()
        self._layout_listener = None
        if cells:
            run_on_ui_thread(lambda: [self._release(c) for c in cells])

    def create_settings(self) -> List[Any]:
        return [
            Header(text="Compact Plugin List"),
            Switch(
                key="collapse_others",
                text="Только одно открытое",
                default=True,
                subtext="При раскрытии остальные сворачиваются",
                icon="msg_expand",
            ),
            Switch(
                key="animate",
                text="Анимация",
                default=True,
                subtext="Раскрытие и сворачивание",
                icon="msg_photo_settings",
            ),
            Switch(
                key="kpm_fix",
                text="Совместимость с KPM",
                default=True,
                subtext="Ставить кнопку в строку кнопок Kangel Plugins Manager",
                icon="msg_settings",
            ),
            Switch(
                key="kpm_skip",
                text="Скрывать в KPM",
                default=False,
                subtext="Не трогать список плагинов Kangel Plugins Manager",
                icon="msg_close",
            ),
        ]

    def _install_hooks(self) -> bool:
        if self._hooked:
            return True
        try:
            cell_cls = find_class(CELL_CLASS)
        except Exception:
            cell_cls = None
        if cell_cls is None:
            log(TAG + " class not found")
            return False
        for m in _declared_methods(cell_cls):
            try:
                if str(m.getName()) != "bindNormalState":
                    continue
                m.setAccessible(True)
                self.hook_method(m, _BindHook(self))
                self._hooked = True
            except Exception as e:
                log(TAG + " hook: %s" % e)
        return self._hooked

    def _track(self, cell):
        cid = _cid(cell)
        ref = self._cells.get(cid)
        if ref is not None and ref.get() is not None:
            return
        if len(self._cells) > 64:
            self._cells = {k: r for k, r in self._cells.items() if r.get() is not None}
        self._cells[cid] = WeakReference(cell)

    def _on_cell_bound(self, cell):
        cid = _cid(cell)
        if cid in self._pending:
            return
        self._pending.add(cid)

        def ui():
            try:
                self._process_cell(cell)
            except Exception as e:
                log(TAG + " process: %s" % e)
            finally:
                self._pending.discard(cid)

        run_on_ui_thread(ui)

    def _process_cell(self, cell):
        if "PluginCell" not in _class_name(cell):
            return

        kpm_cell = _is_kpm_cell(cell)
        if kpm_cell and self.get_setting("kpm_skip", False):
            # Пункт "Скрывать в KPM": ячейки списка KPM не трогаем вообще -
            # ни описания не прячем, ни свою кнопку не добавляем
            _strip(cell)
            for v in _content_views(cell):
                _set_shown(v, True)
            return

        desc = _find_desc(cell)
        reqs = _find_requirements(cell)
        has_desc = desc is not None and _has_text(desc)
        has_reqs = reqs is not None
        if not has_desc and not has_reqs:
            _strip(cell)
            return

        key = _plugin_key(cell)
        shown = key in self._expanded
        if has_desc:
            _set_shown(desc, shown)
        if has_reqs:
            _set_shown(reqs, shown)
        self._track(cell)

        kpm_fix = self.get_setting("kpm_fix", True)
        row = _find_icons_row(cell, kpm_fix)
        if row is not None:
            # если строка сменилась (KPM перестроил разметку) - убираем старую
            # кнопку из прежнего контейнера, иначе получались дубли
            _strip_but(cell, row)

        def place():
            try:
                self._ensure_button(cell, key, kpm_fix)
            except Exception as e:
                log(TAG + " place: %s" % e)

        try:
            cell.post(_Run(place))
        except Exception:
            place()

        # Позицию проверяем ВСЕГДА - и В ЛЮБОЙ ветке (кнопка уже была,
        # кнопка новая, ячейка KPM), и повторно с задержкой. Строку кнопок
        # приложение достраивает уже после bind - именно из-за этого кнопка иногда
        # вставала на место настроек.
        self._verify_later(cell, row, kpm_cell)

    def _target_index(self, row, cell, btn) -> int:
        """Индекс, ПЕРЕД которым должна стоять наша кнопка.

        Правило одинаково при каждом связывании ячейки и не зависит от того,
        какие кнопки в этот момент видимы, - это главное при переиспользовании
        View в RecyclerView.
        """
        if row.getTag() == KPM_ROW_TAG:
            # строка, собранная KPM: наша кнопка идёт первой
            return 0

        # 1) сразу после настроек (шестерёнки), в т.ч. если она сейчас скрыта
        g = _index_of(row, _find_gear(cell, row))
        if g >= 0:
            return g + 1

        # 2) иначе - ПЕРЕД последней кнопкой строки (обычно это удаление),
        #    а не в конец строки
        try:
            for i in range(row.getChildCount() - 1, -1, -1):
                if row.getChildAt(i) is not btn:
                    return i
        except Exception:
            pass
        return max(0, row.getChildCount() - 1)

    def _place(self, row, cell):
        btn = _find_our(row)
        if btn is None:
            return
        try:
            target = self._target_index(row, cell, btn)
            cur = row.indexOfChild(btn)
            if cur == target:
                return
            # Перестановка внутри строки триггерит hierarchy-listener, а тот
            # снова зовёт _place. Помечаем строку как "переставляемую", чтобы
            # не было рекурсии и дрожания кнопки.
            rid = _cid(row)
            self._placing.add(rid)
            self._set_row_watch(row, False)
            try:
                row.removeView(btn)
                idx = target - 1 if cur < target else target
                idx = max(0, min(idx, row.getChildCount()))
                row.addView(btn, idx)
            finally:
                self._set_row_watch(row, True)
                self._placing.discard(rid)
        except Exception as e:
            log(TAG + " park: %s" % e)
    def _set_row_watch(self, row, on):
        """Слушатель изменений строки. Состояние теперь хранится ПО СТРОКЕ.

        Раньше это был один общий флаг на весь плагин: если он уже стоял в "нужном"
        положении, вызов ничего не делал, и строка могла остаться без
        слушателя. Тогда перестройку строки приложением (настройки и стрелка менялись
        местами) мы не замечали - это и есть баг "кнопка настроек уехала на место стрелки".
        """
        if row is None:
            return
        rid = _cid(row)
        muted = getattr(self, "_muted", None)
        if muted is None:
            muted = set()
            self._muted = muted
        watched = getattr(self, "_watched", None)
        if watched is None:
            watched = set()
            self._watched = watched
        try:
            if on:
                muted.discard(rid)
                watched.add(rid)
                row.setOnHierarchyChangeListener(self._row_listener)
            else:
                muted.add(rid)
                watched.discard(rid)
                row.setOnHierarchyChangeListener(None)
        except Exception as e:
            log(TAG + " watch: %s" % e)

    def _watch_row(self, row):
        """Слушаем и изменения структуры строки, и завершение её раскладки."""
        if row is None:
            return
        self._set_row_watch(row, True)
        lsn = getattr(self, "_layout_listener", None)
        if lsn is None:
            return
        rows = getattr(self, "_lay_rows", None)
        if rows is None:
            rows = set()
            self._lay_rows = rows
        rid = _cid(row)
        if rid in rows:
            return
        try:
            if len(rows) > 200:
                rows.clear()
            row.addOnLayoutChangeListener(lsn)
            rows.add(rid)
        except Exception as e:
            log(TAG + " layout watch: %s" % e)

    def _needs_fix(self, row, cell) -> bool:
        """True, если наша кнопка стоит не на своём месте."""
        try:
            btn = _find_our(row)
            if btn is None:
                return False
            return int(row.indexOfChild(btn)) != int(self._target_index(row, cell, btn))
        except Exception:
            return False

    def _on_row_layout(self, row):
        """После каждой раскладки строки проверяем позицию кнопки."""
        try:
            if row is None or self._row_listener is None:
                return
            cell = _find_ancestor(row, ("PluginCell",))
            if cell is None or not self._needs_fix(row, cell):
                return
            # защита от зацикливания: не чаще одной правки строки за 250 мс
            rid = _cid(row)
            now = 0
            try:
                now = int(System.currentTimeMillis())
            except Exception:
                pass
            seen = getattr(self, "_lay_fix", None)
            if seen is None:
                seen = {}
                self._lay_fix = seen
            if now and (now - int(seen.get(rid) or 0)) < 250:
                return
            if len(seen) > 200:
                seen.clear()
            seen[rid] = now
            self._schedule_place(row)
        except Exception as e:
            log(TAG + " on layout: %s" % e)

    def _heal(self, cell, row, tries=8, delay=300):
        """Повторные проверки позиции: строку кнопок приложение (и KPM)
        достраивает уже ПОСЛЕ bind, поэтому одной попытки мало."""
        if tries <= 0 or row is None or self._row_listener is None:
            return
        key = _plugin_key(cell)
        kpm_fix = self.get_setting("kpm_fix", True)

        def go():
            try:
                if self._row_listener is None or _plugin_key(cell) != key:
                    return
                if _is_kpm_cell(cell) and self.get_setting("kpm_skip", False):
                    return
                self._ensure_button(cell, key, kpm_fix)
                if self._needs_fix(row, cell):
                    self._heal(cell, row, tries - 1, delay)
            except Exception as e:
                log(TAG + " heal: %s" % e)

        try:
            row.postDelayed(_Run(go), delay)
        except Exception as e:
            log(TAG + " heal post: %s" % e)

    def _verify_later(self, cell, row, kpm_cell=False):
        """Проверить позицию несколько раз после bind, пока она не станет верной.
        Работает для ВСЕХ веток: и когда кнопка уже была, и когда она новая."""
        if row is None:
            row = _find_icons_row(cell, self.get_setting("kpm_fix", True))
        self._heal(cell, row, 10 if kpm_cell else 8, 300)

    def _schedule_place(self, row, delay=0):
        rid = _cid(row)
        muted = getattr(self, "_muted", None)
        # свою же перестановку и повторные события одной строки игнорируем -
        # иначе кнопка дёргается туда-сюда
        if muted is not None and rid in muted:
            return
        if rid in self._placing or rid in self._scheduled:
            return
        cell = _find_ancestor(row, ("PluginCell",))
        if cell is None:
            return
        self._scheduled.add(rid)

        def go():
            self._scheduled.discard(rid)
            self._place(row, cell)

        try:
            if delay:
                row.postDelayed(_Run(go), delay)
            else:
                row.post(_Run(go))
        except Exception:
            self._scheduled.discard(rid)

    def _reset_btn(self, btn):
        """Ячейки переиспользует RecyclerView: перед каждой привязкой возвращаем
        нашу кнопку в чистое состояние: чтобы от прошлой строки не осталось
        ни смещения, ни полупрозрачности, ни скрытости."""
        if btn is None:
            return
        try:
            btn.setVisibility(View.VISIBLE)
            btn.setTranslationX(0.0)
            btn.setTranslationY(0.0)
            if btn.getAlpha() < 1.0 or btn.getScaleX() < 1.0 or btn.getScaleY() < 1.0:
                btn.animate().cancel()
                btn.setAlpha(1.0)
                btn.setScaleX(1.0)
                btn.setScaleY(1.0)
            btn.setTag(MARKER)
        except Exception as e:
            log(TAG + " reset btn: %s" % e)

    def _ensure_button(self, cell, key, kpm_fix=True):
        row = _find_icons_row(cell, kpm_fix)
        if row is None:
            return
        self._watch_row(row)

        expanded = key in self._expanded
        _strip_but(cell, row)
        existing = _find_our(row)
        if existing is not None:
            self._reset_btn(existing)
            self._apply_icon(existing, expanded)
            self._place(row, cell)
            return

        _strip(cell)

        btn = ImageView(cell.getContext())
        btn.setScaleType(ImageView.ScaleType.CENTER)
        btn.setTag(MARKER)
        self._reset_btn(btn)
        self._apply_icon(btn, expanded)
        try:
            btn.setBackground(Theme.createSelectorDrawable(
                Theme.getColor(Theme.key_listSelector), 1, AndroidUtilities.dp(14)
            ))
        except Exception:
            pass
        btn.setOnClickListener(OnClickListener(self._on_click))
        btn.setClickable(True)

        try:
            self._set_row_watch(row, False)
            try:
                row.addView(btn, row.getChildCount(), _button_params(row))
            finally:
                self._set_row_watch(row, True)
        except Exception as e:
            log(TAG + " add: %s" % e)
            return
        self._place(row, cell)

    def _set_icon(self, iv, expanded):
        res = self._icon_up if expanded else self._icon_down
        if not res:
            return
        try:
            iv.setImageResource(res)
            iv.setSelected(expanded)
            color = Theme.getColor(Theme.key_windowBackgroundWhiteGrayIcon)
            iv.setColorFilter(PorterDuffColorFilter(color, PorterDuff.Mode.MULTIPLY))
        except Exception as e:
            log(TAG + " icon: %s" % e)

    def _apply_icon(self, iv, expanded, animate=False):
        try:
            # Если состояние кнопки уже совпадает с нужным - вообще ничего не делаем.
            # Раньше при animate=True анимация запускалась всегда, из-за чего
            # перерисовывались (мигали) все кнопки списка.
            unchanged = iv.isSelected() == expanded and iv.getDrawable() is not None
            if unchanged:
                # Состояние уже нужное: ни анимации, ни setImageResource (он вызывает
                # requestLayout). Только снимаем возможный "зависший" кадр от
                # переиспользованной View во время анимации.
                if iv.getAlpha() < 1.0 or iv.getScaleX() < 1.0 or iv.getScaleY() < 1.0:
                    iv.animate().cancel()
                    iv.setScaleX(1.0)
                    iv.setScaleY(1.0)
                    iv.setAlpha(1.0)
                return
            iv.animate().cancel()
            iv.setSelected(expanded)
            if not animate:
                iv.setScaleX(1.0)
                iv.setScaleY(1.0)
                iv.setAlpha(1.0)
                self._set_icon(iv, expanded)
                return

            def swap():
                self._set_icon(iv, expanded)
                iv.animate().scaleX(1.0).scaleY(1.0).alpha(1.0).setDuration(170).setInterpolator(_ease()).start()

            # Не гасим кнопку до нуля (иначе она "пропадает"), а слегка сжимаем
            iv.animate().scaleX(0.65).scaleY(0.65).alpha(0.45).setDuration(110).withEndAction(_Run(swap)).start()
        except Exception as e:
            log(TAG + " icon anim: %s" % e)

    def _apply_state(self, cell, expanded, animate):
        for v in _content_views(cell):
            _set_shown(v, expanded)
        btn = _find_our(_find_icons_row(cell))
        if btn is not None:
            self._apply_icon(btn, expanded, animate)

    def _release(self, cell):
        try:
            for v in _content_views(cell):
                _set_shown(v, True)
            row = _find_icons_row(cell)
            _strip(cell)
            if row is not None:
                lsn = getattr(self, "_layout_listener", None)
                if lsn is not None:
                    try:
                        row.removeOnLayoutChangeListener(lsn)
                    except Exception:
                        pass
                try:
                    getattr(self, "_lay_rows", set()).discard(_cid(row))
                except Exception:
                    pass
                self._set_row_watch(row, False)
        except Exception as e:
            log(TAG + " release: %s" % e)

    def _open_siblings(self, container, cell):
        out = []
        try:
            for i in range(container.getChildCount()):
                ch = container.getChildAt(i)
                if ch == cell or "PluginCell" not in _class_name(ch):
                    continue
                if _find_our(_find_icons_row(ch)) is not None:
                    out.append(ch)
        except Exception:
            pass
        return out

    def _begin_transition(self, container, show, hide):
        try:
            ease = _ease()
            ts = TransitionSet()
            ts.setOrdering(TransitionSet.ORDERING_TOGETHER)
            try:
                ts.excludeTarget(ImageView, True)
            except Exception:
                pass

            bounds = ChangeBounds()
            bounds.setDuration(320)
            bounds.setInterpolator(ease)
            ts.addTransition(bounds)

            if show:
                fade_in = Fade(Fade.IN)
                fade_in.setDuration(240)
                fade_in.setStartDelay(90)
                fade_in.setInterpolator(ease)
                for v in show:
                    fade_in.addTarget(v)
                ts.addTransition(fade_in)

            if hide:
                fade_out = Fade(Fade.OUT)
                fade_out.setDuration(140)
                fade_out.setInterpolator(ease)
                for v in hide:
                    fade_out.addTarget(v)
                ts.addTransition(fade_out)

            TransitionManager.beginDelayedTransition(container, ts)
        except Exception:
            try:
                t = AutoTransition()
                t.setDuration(280)
                TransitionManager.beginDelayedTransition(container, t)
            except Exception as e:
                log(TAG + " transition: %s" % e)

    def _on_click(self, v):
        try:
            cell = _find_ancestor(v, ("PluginCell",))
            if cell is not None:
                self._toggle(cell)
        except Exception as e:
            log(TAG + " click: %s" % e)

    def _toggle(self, cell):
        key = _plugin_key(cell)
        expanded = key in self._expanded
        animate = self.get_setting("animate", True)

        container = _find_ancestor(cell, RECYCLER_TOKENS, 8)
        if container is None:
            container = cell.getParent()

        siblings = []
        if not expanded and self.get_setting("collapse_others", True):
            # Сворачиваем и анимируем только те ячейки, которые реально раскрыты.
            # Раньше в список попадали все видимые ячейки, и при каждом клике
            # запускалась анимация на всех кнопках сразу - они мигали.
            siblings = [s for s in self._open_siblings(container, cell)
                        if _plugin_key(s) in self._expanded]

        if animate:
            own = _content_views(cell)
            hide = own if expanded else [v for s in siblings for v in _content_views(s)]
            self._begin_transition(container, [] if expanded else own, hide)

        if expanded:
            self._expanded.discard(key)
        else:
            if siblings or self.get_setting("collapse_others", True):
                self._expanded.clear()
            self._expanded.add(key)

        for s in siblings:
            self._apply_state(s, False, animate)
        self._apply_state(cell, not expanded, animate)
