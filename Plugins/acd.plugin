__id__ = "acd"
__name__ = "Album Cover Downloader"
__description__ = "Сохраняет обложку трека в галерею\nSaves track cover to gallery"
__author__ = "@ka1Plugins"
__version__ = "1.0"
__icon__ = "ka1Plugins/0"
__app_version__ = ">=12.10.6"
__sdk_version__ = ">=1.4.5.7"

import time
from java import dynamic_proxy
from base_plugin import BasePlugin, MethodHook
from hook_utils import find_class, get_private_field
from android_utils import run_on_ui_thread, log, OnClickListener, R
from client_utils import run_on_queue

_BTN_TAG_ID = 0x0ACD0001
_WRAPPER_TAG_ID = 0x0ACD0002

def to_signed_32(val: int) -> int:
    val = val & 0xFFFFFFFF
    return val if val < 0x80000000 else val - 0x100000000

def _t(ru, en):
    try:
        from org.telegram.messenger import LocaleController
        loc = LocaleController.getCurrentLocale()
        if loc and loc.getLanguage() == "ru": return ru
    except Exception: pass
    return en

class _ShowAlbumCoverHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            self.plugin._on_visibility(param.thisObject, bool(param.args[0]))
        except Exception as e:
            self.plugin.log(f"showAlbumCover hook error: {e}")

class AudioCoverDownloaderPlugin(BasePlugin):
    class RunnableProxy(dynamic_proxy(find_class("java.lang.Runnable"))):
        def __init__(self, func):
            super().__init__()
            self.func = func
        def run(self):
            try: self.func()
            except Exception as e: log(f"RunnableProxy Error: {e}")

    def __init__(self):
        super().__init__()
        from android.os import Handler, Looper
        self.handler = Handler(Looper.getMainLooper())
        self.notification_view, self.hide_notification_runnable, self.window_manager = None, None, None
        self.is_downloading, self.active_btn = False, None

    def on_plugin_load(self):
        try:
            cls = find_class("org.telegram.ui.Components.AudioPlayerAlert")
            if not cls: return
            from java.lang import Boolean as JBoolean
            method = None
            try: method = cls.getClass().getDeclaredMethod("showAlbumCover", JBoolean.TYPE, JBoolean.TYPE)
            except Exception:
                for m in cls.getClass().getDeclaredMethods():
                    if m.getName() == "showAlbumCover": method = m; break
            if method:
                try: method.setAccessible(True)
                except Exception: pass
                self.hook_method(method, _ShowAlbumCoverHook(self))
        except Exception as e: self.log(f"on_plugin_load error: {e}")

    def on_plugin_unload(self):
        self._hide_custom_notification()
        self.is_downloading, self.active_btn = False, None

    def _on_visibility(self, alert, show):
        try:
            if not alert: return
            if show: self._ensure_button(alert)
            bv = get_private_field(alert, "blurredView")
            if bv:
                w = bv.getTag(_WRAPPER_TAG_ID)
                if w:
                    btn = w.getTag(_BTN_TAG_ID)
                    if btn: btn.animate().scaleX(1.0 if show else 0.9).scaleY(1.0 if show else 0.9).setDuration(180).start()
        except Exception as e: self.log(f"visibility error: {e}")

    def _ensure_button(self, alert):
        try:
            bv = get_private_field(alert, "blurredView")
            big = get_private_field(alert, "bigAlbumConver")
            if not bv or not big: return
            
            wrapper = bv.getTag(_WRAPPER_TAG_ID)
            if not wrapper:
                from android.widget import FrameLayout
                from android.view import ViewGroup
                orig = big.getLayoutParams()
                bv.removeView(big)
                wrapper = FrameLayout(bv.getContext())
                bv.addView(wrapper, orig)
                wrapper.addView(big, FrameLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT))
                bv.setTag(_WRAPPER_TAG_ID, wrapper)
                
            btn = wrapper.getTag(_BTN_TAG_ID)
            if not btn:
                btn = self._create_button(wrapper, alert)
                if btn: wrapper.setTag(_BTN_TAG_ID, btn)
            if btn: self._position_button(btn, big, 20)
        except Exception as e: self.log(f"ensure_button error: {e}")

    def _position_button(self, btn, big, retries=20):
        try:
            rcv = big.getImageReceiver()
            if not rcv: return
            b = rcv.getBitmap()
            if not b or b.isRecycled() or big.getWidth() <= 0 or big.getHeight() <= 0:
                if retries > 0: btn.postDelayed(R(lambda: self._position_button(btn, big, retries - 1)), 50)
                return

            vw, vh, bw, bh = big.getWidth(), big.getHeight(), b.getWidth(), b.getHeight()
            ai, av = bw / float(bh), vw / float(vh)
            if ai > av: dw, dh, dx, dy = float(vw), vw / ai, 0.0, (vh - (vw / ai)) / 2.0
            else: dw, dh, dx, dy = vh * ai, float(vh), (vw - (vh * ai)) / 2.0, 0.0

            from org.telegram.messenger import AndroidUtilities
            dp = AndroidUtilities.dp
            bs, off = dp(40), dp(10)
            x, y = dw + dx - bs - off, dh + dy - bs - off

            btn.setX(float(x)); btn.setY(float(y))
            btn.setPivotX(float(dx + dw / 2.0 - x)); btn.setPivotY(float(dy + dh / 2.0 - y))

            from android.view import View
            if btn.getVisibility() != View.VISIBLE: btn.setVisibility(View.VISIBLE)
        except Exception as e: self.log(f"position button error: {e}")

    def _create_button(self, parent, alert):
        try:
            from android.widget import ImageView, FrameLayout
            from android.view import Gravity, View
            from org.telegram.messenger import R as R_tg, AndroidUtilities
            from android.graphics.drawable import GradientDrawable

            dp = AndroidUtilities.dp
            btn = ImageView(parent.getContext())
            btn.setClickable(True); btn.setFocusable(True); btn.setVisibility(View.INVISIBLE)
            btn.setContentDescription(_t("Сохранить обложку", "Save cover"))

            bg = GradientDrawable()
            bg.setShape(GradientDrawable.OVAL); bg.setColor(to_signed_32(0x66000000))
            btn.setBackground(bg)

            btn.setPadding(dp(8), dp(8), dp(8), dp(8))
            btn.setImageResource(R_tg.drawable.msg_download)
            btn.setColorFilter(to_signed_32(0xFFFFFFFF))
            btn.setOnClickListener(OnClickListener(lambda v: self._on_button_click(alert, v)))

            lp = FrameLayout.LayoutParams(dp(40), dp(40)); lp.gravity = Gravity.TOP | Gravity.LEFT
            parent.addView(btn, lp)
            return btn
        except Exception as e:
            self.log(f"create button error: {e}")
            return None

    def _show_custom_notification(self, alert, message, is_success=True):
        def _action():
            try:
                from android.content import Context
                from android.view import WindowManager, Gravity
                from android.widget import TextView
                from android.graphics.drawable import GradientDrawable
                from android.graphics import PixelFormat
                from org.telegram.messenger import ApplicationLoader, AndroidUtilities
                from org.telegram.ui.ActionBar import Theme

                LayoutParams = find_class("android.view.WindowManager$LayoutParams")
                activity = get_private_field(alert, "parentActivity")
                cur_context = activity if activity else ApplicationLoader.applicationContext

                if not self.window_manager: self.window_manager = cur_context.getSystemService(Context.WINDOW_SERVICE)
                if self.notification_view and self.notification_view.isAttachedToWindow(): self.window_manager.removeView(self.notification_view)
                if self.hide_notification_runnable: self.handler.removeCallbacks(self.hide_notification_runnable)

                try: bg_color = to_signed_32(Theme.getColor(Theme.key_featuredStickers_addButton if is_success else Theme.key_text_RedRegular))
                except Exception: bg_color = to_signed_32(0xFF4CAF50 if is_success else 0xFFF44336)

                u = bg_color & 0xFFFFFFFF
                text_color = to_signed_32(0xFF000000 if ((u>>16)&0xFF)*299 + ((u>>8)&0xFF)*587 + (u&0xFF)*114 >= 128000 else 0xFFFFFFFF)

                self.notification_view = TextView(cur_context)
                self.notification_view.setText(message)
                self.notification_view.setTextColor(text_color)
                self.notification_view.setTypeface(None, 1); self.notification_view.setTextSize(14); self.notification_view.setGravity(Gravity.CENTER)
                self.notification_view.setPadding(AndroidUtilities.dp(18), AndroidUtilities.dp(14), AndroidUtilities.dp(18), AndroidUtilities.dp(14))
                
                d = GradientDrawable(); d.setCornerRadius(AndroidUtilities.dp(12)); d.setColor(bg_color)
                self.notification_view.setBackground(d); self.notification_view.setElevation(AndroidUtilities.dp(12))
                
                params = LayoutParams(-2, -2, 1000, LayoutParams.FLAG_NOT_FOCUSABLE | LayoutParams.FLAG_NOT_TOUCHABLE, PixelFormat.TRANSLUCENT)
                try:
                    bv = get_private_field(alert, "blurredView")
                    params.token = (bv.getWindowToken() if bv else None) or alert.getWindow().getDecorView().getWindowToken()
                except Exception: pass
                
                params.gravity = Gravity.BOTTOM | Gravity.CENTER_HORIZONTAL; params.y = AndroidUtilities.dp(100)
                
                self.window_manager.addView(self.notification_view, params)
                self.notification_view.setAlpha(0.0); self.notification_view.setTranslationY(AndroidUtilities.dp(50))
                self.notification_view.animate().alpha(1.0).translationY(0).setDuration(300).start()
                
                self.hide_notification_runnable = self.RunnableProxy(self._hide_custom_notification)
                self.handler.postDelayed(self.hide_notification_runnable, 2500)
            except Exception as e: self.log(f"Notification error: {e}")
        run_on_ui_thread(_action)

    def _hide_custom_notification(self):
        def _action():
            if self.hide_notification_runnable:
                self.handler.removeCallbacks(self.hide_notification_runnable); self.hide_notification_runnable = None
            v = self.notification_view
            if v and v.isAttachedToWindow():
                self.notification_view = None
                def _rm():
                    try:
                        if v.isAttachedToWindow(): v.setVisibility(8); self.window_manager.removeView(v)
                    except Exception: pass
                from org.telegram.messenger import AndroidUtilities
                v.animate().alpha(0.0).translationY(AndroidUtilities.dp(50)).setDuration(300).withEndAction(self.RunnableProxy(_rm)).start()
        run_on_ui_thread(_action)

    def _extract_cover(self, alert):
        from org.telegram.messenger import MediaController
        track_name = "track"
        try:
            p = MediaController.getInstance().getPlayingMessageObject()
            if p: track_name = str(p.getMusicTitle() or p.getDocumentName() or track_name)
        except Exception: pass

        for field in ("coverContainer", "bigAlbumConver"):
            try:
                obj = get_private_field(alert, field)
                if obj:
                    b = obj.getImageReceiver().getBitmap()
                    if b and not b.isRecycled(): return b, track_name
            except Exception: pass

        try:
            ai = MediaController.getInstance().getAudioInfo()
            if ai:
                b = ai.getCover()
                if b and not b.isRecycled(): return b, track_name
        except Exception: pass
        return None, track_name

    def _on_button_click(self, alert, btn):
        try:
            if self.is_downloading: return
            self.is_downloading = True; self.active_btn = btn
            run_on_ui_thread(lambda: btn.setAlpha(0.5))

            def _task():
                try:
                    bmp, track_name = self._extract_cover(alert)
                    if not bmp: self._finish_save(btn, alert, False, _t("Обложка недоступна", "Cover unavailable")); return
                    run_on_queue(lambda: self._do_save_bg(alert, bmp, track_name, btn))
                except Exception as e: self._finish_save(btn, alert, False, str(e))
            run_on_ui_thread(_task)
        except Exception as e: self._finish_save(btn, alert, False, str(e))

    def _do_save_bg(self, alert, bitmap, track_name, btn):
        try:
            self._save_to_gallery(bitmap, track_name)
            self._finish_save(btn, alert, True, _t("Обложка сохранена в галерею", "Cover saved to gallery"))
        except Exception as e: self._finish_save(btn, alert, False, str(e))

    def _finish_save(self, btn, alert, success, msg):
        def _action():
            self.is_downloading = False
            if btn: 
                try: btn.setAlpha(1.0)
                except Exception: pass
            self.active_btn = None
            self._show_custom_notification(alert, msg, success)
        run_on_ui_thread(_action)

    def _save_to_gallery(self, bitmap, track_name):
        from android.graphics import Bitmap
        from android.content import ContentValues
        from android.provider import MediaStore
        from android.os import Build, Environment
        from org.telegram.messenger import ApplicationLoader
        from java.io import File, FileOutputStream
        from java.lang import Integer as JInteger

        w, h = bitmap.getWidth(), bitmap.getHeight()
        if w <= 0 or h <= 0: raise Exception(_t("Некорректный размер изображения", "Invalid image size"))

        side, target = min(w, h), min(w, h) if min(w, h) < 720 else (720 if min(w, h) < 1080 else 1080)
        sq = Bitmap.createBitmap(bitmap, (w-side)//2, (h-side)//2, side, side)
        if sq.getWidth() != target: sq = Bitmap.createScaledBitmap(sq, target, target, True) or sq

        ts = int(time.time() * 1000)
        name = "".join(c if c.isalnum() else "_" for c in (track_name or "track"))[:30] or "track"
        fn = f"{name}_{ts}.png"
        ctx, res, sdk = ApplicationLoader.applicationContext, ApplicationLoader.applicationContext.getContentResolver(), Build.VERSION.SDK_INT

        if sdk >= 29:
            v = ContentValues()
            v.put(MediaStore.Images.Media.DISPLAY_NAME, fn); v.put(MediaStore.Images.Media.MIME_TYPE, "image/png")
            v.put(MediaStore.Images.Media.RELATIVE_PATH, "Pictures/exteraGram"); v.put(MediaStore.Images.Media.IS_PENDING, JInteger(1))
            uri = res.insert(MediaStore.Images.Media.EXTERNAL_CONTENT_URI, v)
            if not uri: raise Exception(_t("Ошибка MediaStore", "MediaStore error"))
            out = res.openOutputStream(uri)
            if not out: raise Exception(_t("Ошибка потока", "Stream error"))
            sq.compress(Bitmap.CompressFormat.PNG, 100, out); out.close()
            v2 = ContentValues(); v2.put(MediaStore.Images.Media.IS_PENDING, JInteger(0)); res.update(uri, v2, None, None)
        else:
            f = File(Environment.getExternalStoragePublicDirectory(Environment.DIRECTORY_PICTURES), "exteraGram")
            f.mkdirs()
            fos = FileOutputStream(File(f, fn))
            sq.compress(Bitmap.CompressFormat.PNG, 100, fos); fos.close()
            try:
                from android.media import MediaScannerConnection
                MediaScannerConnection.scanFile(ctx, [str(File(f, fn).getAbsolutePath())], ["image/png"], None)
            except Exception: pass
        self.log(f"saved cover: {fn}")