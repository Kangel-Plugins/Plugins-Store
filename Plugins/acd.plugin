__id__ = "acd"
__name__ = "Album Cover Downloader"
__description__ = "Сохраняет обложку трека в галерею\nSaves track cover to gallery"
__author__ = "@ka1Plugins"
__version__ = "1.1"
__icon__ = "ka1Plugins/0"
__app_version__ = ">=13.1.1"
__sdk_version__ = ">=1.4.6.3"

import time
from java import dynamic_proxy

from base_plugin import BasePlugin, MethodHook
from hook_utils import find_class, get_private_field
from android_utils import run_on_ui_thread, log, OnClickListener, R
from client_utils import run_on_queue

_BTN_OLD = 0x0ACD0001
_WRAPPER = 0x0ACD0002
_BTN_NEW = 0x0ACD0003


def to_signed_32(val: int) -> int:
    val = val & 0xFFFFFFFF
    return val if val < 0x80000000 else val - 0x100000000


def _t(ru, en):
    try:
        from org.telegram.messenger import LocaleController
        loc = LocaleController.getCurrentLocale()
        if loc and loc.getLanguage() == "ru":
            return ru
    except Exception:
        pass
    return en


class _OldHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            self.plugin._on_old_vis(param.thisObject, bool(param.args[0]))
        except Exception as e:
            self.plugin.log(f"Old hook error: {e}")


class _NewRectHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            self.plugin._on_new_rect(
                param.thisObject, float(param.args[0]), 
                float(param.args[1]), float(param.args[2]), float(param.args[4])
            )
        except Exception as e:
            self.plugin.log(f"New rect hook error: {e}")


class _NewDrawHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        try:
            self.plugin._on_new_draw(param.thisObject)
        except Exception:
            pass


class _NewDetachHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            self.plugin._hide_btn(param.thisObject, _BTN_NEW)
        except Exception:
            pass


class AlbumCoverDownloaderPlugin(BasePlugin):

    class RunnableProxy(dynamic_proxy(find_class("java.lang.Runnable"))):
        def __init__(self, func):
            super().__init__()
            self.func = func

        def run(self):
            try:
                self.func()
            except Exception as e:
                log(f"RunnableProxy error: {e}")

    def __init__(self):
        super().__init__()
        from android.os import Handler, Looper
        self.handler = Handler(Looper.getMainLooper())
        self.notif_view, self.hide_notif_run, self.wm = None, None, None
        self.is_downloading, self.active_btn = False, None
        self.f_rect, self.f_pause, self.f_compact = None, None, None

    def on_plugin_load(self):
        try:
            if (cls := find_class("org.telegram.ui.Components.AudioPlayerAlert")):
                for m in cls.getClass().getDeclaredMethods():
                    if m.getName() == "showAlbumCover":
                        m.setAccessible(True)
                        self.hook_method(m, _OldHook(self))
                        break
        except Exception as e:
            self.log(f"Old plugin load error: {e}")

        try:
            if (cls := find_class("com.exteragram.messenger.player.ui.PlayerCoverView")):
                jcls = cls.getClass()
                for name, attr in [("coverRect", "f_rect"), ("pauseScale", "f_pause"), ("compact", "f_compact")]:
                    try:
                        setattr(self, attr, jcls.getDeclaredField(name))
                        getattr(self, attr).setAccessible(True)
                    except Exception:
                        pass
                
                for m in jcls.getDeclaredMethods():
                    if m.getName() == "setCoverRect":
                        m.setAccessible(True)
                        self.hook_method(m, _NewRectHook(self))
                    elif m.getName() == "onDraw":
                        m.setAccessible(True)
                        self.hook_method(m, _NewDrawHook(self))
                    elif m.getName() == "onDetachedFromWindow":
                        m.setAccessible(True)
                        self.hook_method(m, _NewDetachHook(self))
        except Exception as e:
            self.log(f"New plugin load error: {e}")

    def on_plugin_unload(self):
        self._hide_notif()
        self.is_downloading, self.active_btn = False, None

    def _on_old_vis(self, alert, show):
        try:
            if not alert:
                return
            if show:
                self._ensure_old(alert)
            if (bv := get_private_field(alert, "blurredView")) and (w := bv.getTag(_WRAPPER)):
                if (btn := w.getTag(_BTN_OLD)):
                    btn.animate().scaleX(1.0 if show else 0.9).scaleY(1.0 if show else 0.9).setDuration(180).start()
        except Exception as e:
            self.log(f"Old visibility error: {e}")

    def _ensure_old(self, alert):
        try:
            bv, big = get_private_field(alert, "blurredView"), get_private_field(alert, "bigAlbumConver")
            if not bv or not big:
                return
            if not (w := bv.getTag(_WRAPPER)):
                from android.widget import FrameLayout
                from android.view import ViewGroup
                orig = big.getLayoutParams()
                bv.removeView(big)
                w = FrameLayout(bv.getContext())
                bv.addView(w, orig)
                w.addView(big, FrameLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT))
                bv.setTag(_WRAPPER, w)
            if not (btn := w.getTag(_BTN_OLD)):
                if (btn := self._make_btn(w, lambda v: self._handle_click(alert, btn, False))):
                    w.setTag(_BTN_OLD, btn)
            if btn:
                self._pos_old(btn, big)
        except Exception as e:
            self.log(f"Old ensure error: {e}")

    def _pos_old(self, btn, big, retries=20):
        try:
            rcv = big.getImageReceiver()
            if not rcv or not (b := rcv.getBitmap()) or b.isRecycled() or big.getWidth() <= 0:
                if retries > 0:
                    btn.postDelayed(R(lambda: self._pos_old(btn, big, retries - 1)), 50)
                return
            
            vw, vh, bw, bh = big.getWidth(), big.getHeight(), b.getWidth(), b.getHeight()
            ai, av = bw / float(bh), vw / float(vh)
            if ai > av:
                dw, dh, dx, dy = float(vw), vw / ai, 0.0, (vh - (vw / ai)) / 2.0
            else:
                dw, dh, dx, dy = vh * ai, float(vh), (vw - (vh * ai)) / 2.0, 0.0

            from org.telegram.messenger import AndroidUtilities
            bs, off = AndroidUtilities.dp(40), AndroidUtilities.dp(10)
            x, y = dw + dx - bs - off, dh + dy - bs - off

            btn.setX(float(x))
            btn.setY(float(y))
            btn.setPivotX(float(dx + dw / 2.0 - x))
            btn.setPivotY(float(dy + dh / 2.0 - y))

            from android.view import View
            if btn.getVisibility() != View.VISIBLE:
                btn.setVisibility(View.VISIBLE)
        except Exception:
            pass

    def _on_new_rect(self, view, left, top, width, compact):
        def _action():
            try:
                if not view or not view.isAttachedToWindow() or compact > 0.01:
                    self._hide_btn(view, _BTN_NEW)
                    return
                if not (parent := view.getParent()):
                    return
                if not (btn := parent.getTag(_BTN_NEW)):
                    if (btn := self._make_btn(parent, lambda v: self._handle_click(view, btn, True))):
                        parent.setTag(_BTN_NEW, btn)
                if btn:
                    from android.view import View
                    if btn.getVisibility() != View.VISIBLE:
                        btn.setVisibility(View.VISIBLE)
                        btn.bringToFront()
                    self._on_new_draw(view)
            except Exception as e:
                self.log(f"New rect error: {e}")
        run_on_ui_thread(_action)

    def _on_new_draw(self, view):
        try:
            if not (parent := view.getParent()) or not (btn := parent.getTag(_BTN_NEW)) or not self.f_rect:
                return
            from android.view import View
            if btn.getVisibility() != View.VISIBLE:
                return
            
            rect = self.f_rect.get(view)
            pause_scale = self.f_pause.getFloat(view)
            compact = self.f_compact.getFloat(view)
            if not rect:
                return
            
            from org.telegram.messenger import AndroidUtilities
            scale = AndroidUtilities.lerp(float(pause_scale), 1.0, float(compact))
            f_width = (rect.width() * (1.0 - scale)) / 2.0
            bs, off = AndroidUtilities.dp(40), AndroidUtilities.dp(10)
            
            x = view.getX() + rect.left + float(view.getPageOffset()) + rect.width() - f_width - bs - off
            y = view.getY() + rect.top + rect.width() - f_width - bs - off
            
            if abs(btn.getX() - x) > 0.1 or abs(btn.getY() - y) > 0.1 or abs(btn.getScaleX() - scale) > 0.01:
                btn.setX(float(x))
                btn.setY(float(y))
                btn.setScaleX(float(scale))
                btn.setScaleY(float(scale))
                btn.setPivotX(float(bs))
                btn.setPivotY(float(bs))
        except Exception:
            pass

    def _hide_btn(self, view, tag):
        def _action():
            try:
                if (parent := view.getParent()) and (btn := parent.getTag(tag)):
                    from android.view import View
                    btn.setVisibility(View.GONE)
            except Exception:
                pass
        run_on_ui_thread(_action)

    def _make_btn(self, parent, on_click):
        try:
            from android.widget import ImageView
            from android.view import View, ViewGroup
            from org.telegram.messenger import R as R_tg, AndroidUtilities
            from android.graphics.drawable import GradientDrawable
            
            dp, ctx = AndroidUtilities.dp, parent.getContext()
            btn = ImageView(ctx)
            btn.setClickable(True)
            btn.setFocusable(True)
            btn.setVisibility(View.INVISIBLE)
            btn.setContentDescription(_t("Сохранить обложку", "Save cover"))
            
            bg = GradientDrawable()
            bg.setShape(GradientDrawable.OVAL)
            bg.setColor(to_signed_32(0x66000000))
            btn.setBackground(bg)
            btn.setElevation(float(dp(10)))
            btn.setPadding(dp(8), dp(8), dp(8), dp(8))
            
            res_id = R_tg.drawable.msg_download or ctx.getResources().getIdentifier("msg_download", "drawable", ctx.getPackageName()) or ctx.getResources().getIdentifier("msg_download", "drawable", "org.telegram.messenger")
            btn.setImageResource(res_id)
            btn.setColorFilter(to_signed_32(0xFFFFFFFF))
            btn.setOnClickListener(OnClickListener(on_click))
            
            parent.addView(btn, ViewGroup.LayoutParams(dp(40), dp(40)))
            return btn
        except Exception as e:
            self.log(f"Button creation error: {e}")
            return None

    def _handle_click(self, source, btn, is_new):
        if self.is_downloading:
            return
        self.is_downloading, self.active_btn = True, btn
        run_on_ui_thread(lambda: btn.setAlpha(0.5))
        
        def _task():
            try:
                track_name = "track"
                if is_new:
                    if (msg := source.getMessageObject()):
                        track_name = str(msg.getMusicTitle() or msg.getDocumentName() or track_name)
                    rcv = source.getImageReceiver()
                else:
                    from org.telegram.messenger import MediaController
                    if (p := MediaController.getInstance().getPlayingMessageObject()):
                        track_name = str(p.getMusicTitle() or p.getDocumentName() or track_name)
                    
                    cc = get_private_field(source, "coverContainer")
                    rcv = cc.getImageReceiver() if cc else get_private_field(source, "bigAlbumConver").getImageReceiver()
                
                bmp = rcv.getBitmap() if rcv else None
                if not bmp or bmp.isRecycled():
                    self._finish(source, btn, False, _t("Обложка недоступна", "Cover unavailable"))
                    return
                run_on_queue(lambda: self._save_bg(source, btn, bmp, track_name))
            except Exception as e:
                self._finish(source, btn, False, str(e))
        run_on_ui_thread(_task)

    def _save_bg(self, source, btn, bmp, track_name):
        try:
            from android.graphics import Bitmap
            from android.content import ContentValues
            from android.provider import MediaStore
            from android.os import Build, Environment
            from org.telegram.messenger import ApplicationLoader
            from java.io import File, FileOutputStream
            from java.lang import Integer as JInt
            
            w, h = bmp.getWidth(), bmp.getHeight()
            side = min(w, h)
            target = min(w, h) if min(w, h) < 720 else (720 if min(w, h) < 1080 else 1080)
            
            sq = Bitmap.createBitmap(bmp, (w - side) // 2, (h - side) // 2, side, side)
            if sq.getWidth() != target:
                sq = Bitmap.createScaledBitmap(sq, target, target, True) or sq
                
            fn = f"{''.join(c if c.isalnum() else '_' for c in (track_name or 'track'))[:30] or 'track'}_{int(time.time() * 1000)}.png"
            ctx, res, sdk = ApplicationLoader.applicationContext, ApplicationLoader.applicationContext.getContentResolver(), Build.VERSION.SDK_INT
            
            if sdk >= 29:
                v = ContentValues()
                v.put(MediaStore.Images.Media.DISPLAY_NAME, fn)
                v.put(MediaStore.Images.Media.MIME_TYPE, "image/png")
                v.put(MediaStore.Images.Media.RELATIVE_PATH, "Pictures/exteraGram")
                v.put(MediaStore.Images.Media.IS_PENDING, JInt(1))
                
                if not (uri := res.insert(MediaStore.Images.Media.EXTERNAL_CONTENT_URI, v)):
                    raise Exception("MediaStore error")
                if not (out := res.openOutputStream(uri)):
                    raise Exception("Stream error")
                    
                sq.compress(Bitmap.CompressFormat.PNG, 100, out)
                out.close()
                
                v2 = ContentValues()
                v2.put(MediaStore.Images.Media.IS_PENDING, JInt(0))
                res.update(uri, v2, None, None)
            else:
                d = File(Environment.getExternalStoragePublicDirectory(Environment.DIRECTORY_PICTURES), "exteraGram")
                d.mkdirs()
                fos = FileOutputStream(File(d, fn))
                sq.compress(Bitmap.CompressFormat.PNG, 100, fos)
                fos.close()
                try:
                    from android.media import MediaScannerConnection
                    MediaScannerConnection.scanFile(ctx, [str(File(d, fn).getAbsolutePath())], ["image/png"], None)
                except Exception:
                    pass
                    
            self._finish(source, btn, True, _t("Обложка сохранена в галерею", "Cover saved to gallery"))
        except Exception as e:
            self._finish(source, btn, False, str(e))

    def _finish(self, source, btn, success, msg):
        def _action():
            self.is_downloading = False
            if btn:
                try:
                    btn.setAlpha(1.0)
                except Exception:
                    pass
            self.active_btn = None
            self._show_notif(source, msg, success)
        run_on_ui_thread(_action)

    def _show_notif(self, view, msg, is_success=True):
        def _action():
            try:
                from android.content import Context
                from android.view import WindowManager, Gravity
                from android.widget import TextView
                from android.graphics.drawable import GradientDrawable
                from android.graphics import PixelFormat
                from org.telegram.messenger import ApplicationLoader, AndroidUtilities
                from org.telegram.ui.ActionBar import Theme
                from hook_utils import find_class
                
                LP = find_class("android.view.WindowManager$LayoutParams")
                ctx = view.getContext() if view else ApplicationLoader.applicationContext
                
                if not self.wm:
                    self.wm = ctx.getSystemService(Context.WINDOW_SERVICE)
                if self.notif_view and self.notif_view.isAttachedToWindow():
                    self.wm.removeView(self.notif_view)
                if self.hide_notif_run:
                    self.handler.removeCallbacks(self.hide_notif_run)
                
                try:
                    bg_color = to_signed_32(Theme.getColor(Theme.key_featuredStickers_addButton if is_success else Theme.key_text_RedRegular))
                except Exception:
                    bg_color = to_signed_32(0xFF4CAF50 if is_success else 0xFFF44336)
                    
                u = bg_color & 0xFFFFFFFF
                text_color = to_signed_32(0xFF000000 if ((u>>16)&0xFF)*299 + ((u>>8)&0xFF)*587 + (u&0xFF)*114 >= 128000 else 0xFFFFFFFF)
                
                tv = TextView(ctx)
                tv.setText(msg)
                tv.setTextColor(text_color)
                tv.setTypeface(None, 1)
                tv.setTextSize(14)
                tv.setGravity(Gravity.CENTER)
                tv.setPadding(AndroidUtilities.dp(18), AndroidUtilities.dp(14), AndroidUtilities.dp(18), AndroidUtilities.dp(14))
                
                d = GradientDrawable()
                d.setCornerRadius(AndroidUtilities.dp(12))
                d.setColor(bg_color)
                tv.setBackground(d)
                tv.setElevation(AndroidUtilities.dp(12))
                
                p = LP(-2, -2, 1000, LP.FLAG_NOT_FOCUSABLE | LP.FLAG_NOT_TOUCHABLE, PixelFormat.TRANSLUCENT)
                try:
                    if view:
                        p.token = view.getWindowToken()
                except Exception:
                    pass
                p.gravity = Gravity.BOTTOM | Gravity.CENTER_HORIZONTAL
                p.y = AndroidUtilities.dp(100)
                
                self.wm.addView(tv, p)
                tv.setAlpha(0.0)
                tv.setTranslationY(AndroidUtilities.dp(50))
                tv.animate().alpha(1.0).translationY(0).setDuration(300).start()
                
                self.notif_view = tv
                self.hide_notif_run = self.RunnableProxy(self._hide_notif)
                self.handler.postDelayed(self.hide_notif_run, 2500)
            except Exception as e:
                self.log(f"Notification error: {e}")
        run_on_ui_thread(_action)

    def _hide_notif(self):
        def _action():
            if self.hide_notif_run:
                self.handler.removeCallbacks(self.hide_notif_run)
                self.hide_notif_run = None
            if self.notif_view and self.notif_view.isAttachedToWindow():
                v = self.notif_view
                self.notif_view = None
                def _rm():
                    try:
                        if v.isAttachedToWindow():
                            v.setVisibility(8)
                            self.wm.removeView(v)
                    except Exception:
                        pass
                from org.telegram.messenger import AndroidUtilities
                v.animate().alpha(0.0).translationY(AndroidUtilities.dp(50)).setDuration(300).withEndAction(self.RunnableProxy(_rm)).start()
        run_on_ui_thread(_action)