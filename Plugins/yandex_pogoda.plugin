def clean_text(value):
    if not value:
        return ""
    value = str(value)
    for ch in ("\u2060", "\u200b", "\u200c", "\u200d", "\ufeff", "\u00ad"):
        value = value.replace(ch, "")
    value = value.replace("\u2044", "/").replace("\n", " ").replace("\r", " ").replace("\t", " ")
    value = re.sub(r"\s+", " ", value)
    return value.strip()


def clean_multiline(value):
    if not value:
        return ""
    value = str(value)
    for ch in ("\u2060", "\u200b", "\u200c", "\u200d", "\ufeff", "\u00ad"):
        value = value.replace(ch, "")
    value = value.replace("\u2044", "/")
    value = re.sub(r"<br\s*/?\s*>", "\n", value, flags=re.I)
    value = re.sub(r"<[^>]+>", "", value)
    value = re.sub(r"[ \t]+", " ", value)
    value = re.sub(r"\s*\n\s*", "\n", value)
    return value.strip()


def to_int(value):
    if value is None or isinstance(value, bool):
        return None
    if isinstance(value, int):
        return value
    text = str(value).strip().replace("\u2212", "-").replace("\u2013", "-").replace("\u2014", "-")
    try:
        return int(round(float(text.replace(",", "."))))
    except (TypeError, ValueError):
        return None


def to_float(value):
    if value is None or isinstance(value, bool):
        return None
    if isinstance(value, (int, float)):
        return float(value)
    text = str(value).strip().replace("\u2212", "-").replace("\u2013", "-").replace(",", ".")
    try:
        return float(text)
    except (TypeError, ValueError):
        return None


def fmt_temp(value):
    number = to_int(value)
    if number is None:
        return "—"
    if number > 0:
        return "+%d°" % number
    if number < 0:
        return "−%d°" % abs(number)
    return "0°"


def fmt_temp_c(value):
    text = fmt_temp(value)
    return text + "C" if text.endswith("°") else text


def normalize_dir(raw):
    text = clean_text(raw)
    if not text:
        return None
    low = text.lower()
    if low in FULL_DIRS:
        return low
    short = SHORT_DIRS.get(text.upper()) or SHORT_DIRS.get(text)
    if short:
        return short
    if low.startswith("штил"):
        return "штиль"
    return low


def wind_strength(speed):
    if speed is None:
        return None
    if speed < 1:
        return "штиль"
    if speed < 6:
        return "слабый"
    if speed < 12:
        return "умеренный"
    if speed < 18:
        return "сильный"
    return "очень сильный"


def pressure_hint(mm):
    if mm is None:
        return ""
    if mm < 745:
        return "пониженное"
    if mm > 765:
        return "повышенное"
    return "в норме"


def parse_hm(text):
    try:
        h, m = str(text).strip().split(":")
        return int(h) * 60 + int(m)
    except Exception:
        return None


def daylight_duration(sunrise, sunset):
    sr = parse_hm(sunrise)
    ss = parse_hm(sunset)
    if sr is None or ss is None or ss <= sr:
        return None
    total = ss - sr
    hours, mins = divmod(total, 60)
    return "%d ч %02d мин" % (hours, mins)


def find_condition(*texts):
    joined = " ".join(clean_text(t).lower() for t in texts if t)
    for cond in CONDITIONS:
        if cond in joined:
            return cond
    return None


def http_get(url, params=None, headers=None):
    response = _HTTP_SESSION.get(url, params=params, headers=headers, timeout=15)
    response.raise_for_status()
    return response.text


