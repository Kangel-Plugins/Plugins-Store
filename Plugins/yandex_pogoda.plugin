_FONT_CACHE = {}
IMG_S = 2
IMG_W = 860


def img_font(size, bold=False, mono=False):
    size_px = max(8, int(size * IMG_S))
    key = (size_px, bold, mono)
    if key in _FONT_CACHE:
        return _FONT_CACHE[key]
    candidates = MONO_FILES if mono else (FONT_BOLD_FILES if bold else FONT_REGULAR_FILES)
    result = None
    for path in candidates:
        if os.path.exists(path):
            try:
                result = ImageFont.truetype(path, size_px)
                break
            except Exception:
                continue
    if result is None and (bold or mono):
        result = img_font(size, bold=False, mono=False)
    if result is None:
        try:
            result = ImageFont.load_default(size_px)
        except Exception:
            result = ImageFont.load_default()
    _FONT_CACHE[key] = result
    return result


def img_fit(d, text, f, max_w):
    if d.textlength(text, font=f) <= max_w:
        return text
    while text and d.textlength(text + "…", font=f) > max_w:
        text = text[:-1]
    return text + "…"


def temp_str(t):
    if t is None:
        return "—"
    if t > 0:
        return "+%d°" % t
    if t < 0:
        return "−%d°" % abs(t)
    return "0°"


def icon_kind(condition):
    c = (condition or "").lower()
    if "гроз" in c:
        return "thunder"
    if "дожд" in c or "лив" in c or "морось" in c:
        return "rain"
    if "снег" in c or "метел" in c:
        return "snow"
    if "туман" in c or "дым" in c or "мгла" in c:
        return "fog"
    if "ясно" in c:
        return "clear"
    if "малообл" in c or "переменная" in c or "проясн" in c:
        return "partly"
    return "overcast"


def is_night_now(weather, tz_name):
    now = local_now(tz_name or weather.get("_tz"))
    mins_now = now.hour * 60 + now.minute
    sr = parse_hm(weather.get("sunrise"))
    ss = parse_hm(weather.get("sunset"))
    if sr is not None and ss is not None:
        return mins_now < sr or mins_now > ss
    return now.hour >= 20 or now.hour < 6


def condition_tint(kind, night, pal):
    if kind == "clear":
        return pal["cool"] if night else pal["warm"]
    if kind == "partly":
        return pal["cool"] if night else pal["warm"]
    if kind in ("rain", "snow", "thunder"):
        return pal["accent"]
    return pal["secondary"]


def draw_soft_halo(d, cx, cy, radius, rgb, max_alpha=24):
    steps = 5
    for i in range(steps, 0, -1):
        r = radius * (i / steps)
        alpha = int(max_alpha * (1.0 - (i - 1) / steps) * 0.7)
        if alpha > 0:
            d.ellipse((cx - r, cy - r, cx + r, cy + r), fill=(rgb[0], rgb[1], rgb[2], alpha))


def hairline(d, x1, x2, y, pal):
    d.rectangle((int(x1), int(y), int(x2), int(y) + IMG_S), fill=pal["hairline"])


def stroke_w(size):
    return max(2, int(size * 0.075))


def icon_wind(d, x, y, s, c):
    w = stroke_w(s)
    d.line((x, y + s * 0.28, x + s * 0.72, y + s * 0.28), fill=c, width=w)
    d.line((x + s * 0.14, y + s * 0.52, x + s * 0.92, y + s * 0.52), fill=c, width=w)
    d.line((x, y + s * 0.76, x + s * 0.56, y + s * 0.76), fill=c, width=w)


def icon_drop(d, x, y, s, c):
    w = stroke_w(s)
    d.arc((x + s * 0.14, y + s * 0.28, x + s * 0.86, y + s * 0.92), 0, 180, fill=c, width=w)
    d.line((x + s * 0.14, y + s * 0.6, x + s * 0.5, y + s * 0.08), fill=c, width=w)
    d.line((x + s * 0.5, y + s * 0.08, x + s * 0.86, y + s * 0.6), fill=c, width=w)


def icon_gauge(d, x, y, s, c):
    w = stroke_w(s)
    d.arc((x, y + s * 0.1, x + s, y + s * 1.05), 180, 360, fill=c, width=w)
    d.line((x + s * 0.5, y + s * 0.58, x + s * 0.78, y + s * 0.28), fill=c, width=w)


def icon_sun_horizon(d, x, y, s, c):
    w = stroke_w(s)
    d.line((x, y + s * 0.78, x + s, y + s * 0.78), fill=c, width=w)
    d.arc((x + s * 0.2, y + s * 0.36, x + s * 0.8, y + s * 0.96), 180, 360, fill=c, width=w)
    d.line((x + s * 0.5, y + s * 0.1, x + s * 0.5, y + s * 0.26), fill=c, width=w)


def icon_sun(d, x, y, s, c):
    w = stroke_w(s)
    r = s * 0.25
    cx, cy = x + s * 0.5, y + s * 0.5
    d.ellipse((cx - r, cy - r, cx + r, cy + r), fill=(c[0], c[1], c[2], 46), outline=c, width=w)
    for i in range(8):
        a = i * math.pi / 4
        d.line(
            (
                cx + math.cos(a) * r * 1.4,
                cy + math.sin(a) * r * 1.4,
                cx + math.cos(a) * r * 1.82,
                cy + math.sin(a) * r * 1.82,
            ),
            fill=c,
            width=w,
        )


def icon_moon(d, x, y, s, c):
    w = stroke_w(s)
    d.arc((x + s * 0.12, y + s * 0.08, x + s * 0.88, y + s * 0.92), 300, 120, fill=c, width=w)
    d.arc((x + s * 0.28, y + s * 0.2, x + s * 0.76, y + s * 0.8), 120, 300, fill=c, width=w)


def icon_cloud(d, x, y, s, c):
    w = stroke_w(s)
    sz = max(4, int(math.ceil(s)) + 2)
    mask = Image.new("L", (sz, sz), 0)
    md = ImageDraw.Draw(mask)

    l_cx, l_cy, l_r = s * 0.28, s * 0.58, s * 0.18
    t_cx, t_cy, t_r = s * 0.50, s * 0.42, s * 0.22
    r_cx, r_cy, r_r = s * 0.72, s * 0.58, s * 0.18
    base_y = s * 0.76

    # Uniform-opacity silhouette (no overlapping alpha seams)
    md.ellipse((l_cx - l_r, l_cy - l_r, l_cx + l_r, l_cy + l_r), fill=44)
    md.ellipse((t_cx - t_r, t_cy - t_r, t_cx + t_r, t_cy + t_r), fill=44)
    md.ellipse((r_cx - r_r, r_cy - r_r, r_cx + r_r, r_cy + r_r), fill=44)
    md.rectangle((l_cx, l_cy - l_r * 0.2, r_cx, base_y), fill=44)
    d.bitmap((int(x), int(y)), mask, fill=c)

    # Crisp joined outline
    d.arc((x + l_cx - l_r, y + l_cy - l_r, x + l_cx + l_r, y + l_cy + l_r), 90, 270, fill=c, width=w)
    d.arc((x + t_cx - t_r, y + t_cy - t_r, x + t_cx + t_r, y + t_cy + t_r), 185, 355, fill=c, width=w)
    d.arc((x + r_cx - r_r, y + r_cy - r_r, x + r_cx + r_r, y + r_cy + r_r), 270, 90, fill=c, width=w)
    d.line((x + l_cx, y + base_y - w * 0.4, x + r_cx, y + base_y - w * 0.4), fill=c, width=w)


def icon_rain(d, x, y, s, c, drop_c=None):
    icon_cloud(d, x, y - s * 0.12, s * 0.9, c)
    w = stroke_w(s)
    dc = drop_c or c
    d.line((x + s * 0.32, y + s * 0.72, x + s * 0.25, y + s * 0.92), fill=dc, width=w)
    d.line((x + s * 0.52, y + s * 0.72, x + s * 0.45, y + s * 0.92), fill=dc, width=w)
    d.line((x + s * 0.72, y + s * 0.72, x + s * 0.65, y + s * 0.92), fill=dc, width=w)


def icon_snow(d, x, y, s, c, drop_c=None):
    icon_cloud(d, x, y - s * 0.12, s * 0.9, c)
    w = stroke_w(s)
    dc = drop_c or c
    r = s * 0.055
    for dx in (0.3, 0.5, 0.7):
        d.ellipse((x + s * dx - r, y + s * 0.84 - r, x + s * dx + r, y + s * 0.84 + r), outline=dc, width=w)


def icon_thunder(d, x, y, s, c, bolt_c=None):
    icon_cloud(d, x, y - s * 0.12, s * 0.9, c)
    w = stroke_w(s)
    bc = bolt_c or c
    d.line((x + s * 0.52, y + s * 0.62, x + s * 0.38, y + s * 0.78), fill=bc, width=w)
    d.line((x + s * 0.38, y + s * 0.78, x + s * 0.54, y + s * 0.78), fill=bc, width=w)
    d.line((x + s * 0.54, y + s * 0.78, x + s * 0.42, y + s * 0.96), fill=bc, width=w)


def icon_fog(d, x, y, s, c):
    w = stroke_w(s)
    d.line((x + s * 0.06, y + s * 0.3, x + s * 0.94, y + s * 0.3), fill=c, width=w)
    d.line((x + s * 0.18, y + s * 0.52, x + s * 0.82, y + s * 0.52), fill=c, width=w)
    d.line((x + s * 0.06, y + s * 0.74, x + s * 0.94, y + s * 0.74), fill=c, width=w)


def icon_weather(d, kind, x, y, s, pal, night=False):
    sec = pal["secondary"]
    if kind == "clear":
        if night:
            icon_moon(d, x, y, s, pal["cool"])
        else:
            icon_sun(d, x, y, s, pal["warm"])
    elif kind == "partly":
        if night:
            icon_moon(d, x + s * 0.22, y - s * 0.06, s * 0.64, pal["cool"])
        else:
            icon_sun(d, x + s * 0.22, y - s * 0.06, s * 0.64, pal["warm"])
        icon_cloud(d, x, y + s * 0.18, s * 0.76, sec)
    elif kind == "rain":
        icon_rain(d, x, y, s, sec, drop_c=pal["accent"])
    elif kind == "snow":
        icon_snow(d, x, y, s, sec, drop_c=pal["accent"])
    elif kind == "thunder":
        icon_thunder(d, x, y, s, sec, bolt_c=pal["warm"])
    elif kind == "fog":
        icon_fog(d, x, y, s, sec)
    else:
        icon_cloud(d, x, y, s, sec)


def pick_palette(dark):
    return PAL_DARK if dark else PAL_LIGHT


def widget_frame(W, H, pal):
    img = Image.new("RGB", (W, H), pal["bg"])
    d = ImageDraw.Draw(img, "RGBA")
    d.rounded_rectangle(
        (IMG_S, IMG_S, W - IMG_S - 1, H - IMG_S - 1),
        radius=18 * IMG_S,
        outline=pal["border"],
        width=IMG_S,
    )
    return img, d


def draw_pill(d, x, y, text, font, bg_rgba, fg_rgb):
    tw = d.textlength(text, font=font)
    px = 10 * IMG_S
    h = 24 * IMG_S
    d.rounded_rectangle((x, y, x + tw + px * 2, y + h), radius=h // 2, fill=bg_rgba)
    d.text((x + px, y + h / 2), text, font=font, fill=fg_rgb, anchor="lm")
    return tw + px * 2


def render_today_card(path, city, date_str, current, tomorrow=False, dark=True):
    pal = pick_palette(dark)
    night = (not tomorrow) and is_night_now(current, current.get("_tz"))
    cond = current.get("condition") or ""
    kind = icon_kind(cond)
    W = IMG_W * IMG_S
    H = 528 * IMG_S
    img, d = widget_frame(W, H, pal)

    pad = 28 * IMG_S
    col = pal["text"]
    sec = pal["secondary"]
    mut = pal["muted"]
    acc = pal["accent"]
    tint = condition_tint(kind, night, pal)

    # Top header bar
    d.text((pad, 22 * IMG_S), img_fit(d, city, img_font(20, bold=True), W - pad * 2 - 220 * IMG_S), font=img_font(20, bold=True), fill=col, anchor="la")
    d.text((W - pad, 26 * IMG_S), date_str, font=img_font(13, mono=True), fill=mut, anchor="ra")
    hairline(d, pad, W - pad, 58 * IMG_S, pal)

    # Hero block
    hero_y = 74 * IMG_S
    temp_text = temp_str(current.get("temp"))
    temp_f = img_font(62, bold=True, mono=True)
    d.text((pad, hero_y), temp_text, font=temp_f, fill=col, anchor="la")

    temp_w = d.textlength(temp_text, font=temp_f)
    info_x = pad + temp_w + 22 * IMG_S
    if cond:
        d.text((info_x, hero_y + 10 * IMG_S), img_fit(d, cond[0].upper() + cond[1:], img_font(18, bold=True), W - info_x - 130 * IMG_S), font=img_font(18, bold=True), fill=col, anchor="la")

    feels = current.get("feels")
    if feels is not None:
        d.text((info_x, hero_y + 38 * IMG_S), "Ощущается как %s" % temp_str(feels), font=img_font(13), fill=sec, anchor="la")

    # Delta pill badge
    t_val, y_val = current.get("temp"), current.get("yesterday")
    if t_val is not None and y_val is not None:
        delta = t_val - y_val
        ref = "сегодня" if tomorrow else "вчера"
        if delta == 0:
            p_txt, p_bg, p_fg = "как %s" % ref, pal["pill_neu"], sec
        elif delta > 0:
            p_txt, p_bg, p_fg = "на %d° выше, чем %s" % (delta, ref), pal["pill_pos"], pal["positive"]
        else:
            p_txt, p_bg, p_fg = "на %d° ниже, чем %s" % (abs(delta), ref), pal["pill_neg"], pal["cool"]
        draw_pill(d, info_x, hero_y + 60 * IMG_S, p_txt, img_font(11, bold=True), p_bg, p_fg)

    # Right hero weather icon + subtle ambient halo
    icon_s = 64 * IMG_S
    ix = W - pad - icon_s - 8 * IMG_S
    iy = hero_y + 10 * IMG_S
    draw_soft_halo(d, ix + icon_s / 2, iy + icon_s / 2, icon_s * 0.95, tint, max_alpha=24 if dark else 18)
    icon_weather(d, kind, ix, iy, icon_s, pal, night=night)

    # 4 Metric Tiles
    gap = 12 * IMG_S
    tile_w = (W - pad * 2 - 3 * gap) / 4
    tile_y = 180 * IMG_S
    tile_h = 104 * IMG_S

    w_speed = current.get("wind_speed")
    w_dir = DIR_SHORT.get(current.get("wind_dir") or "", current.get("wind_dir") or "")
    w_str = wind_strength(w_speed) or ""
    w_sub = " · ".join(x for x in (w_dir, w_str) if x)

    hum = current.get("humidity")
    pres = current.get("pressure")
    sr = current.get("sunrise") or "—"
    ss = current.get("sunset") or "—"
    dl = daylight_duration(current.get("sunrise"), current.get("sunset")) or "световой день"

    tiles = [
        (icon_wind, "Ветер", ("%g м/с" % w_speed).replace(".", ",") if w_speed is not None else "—", w_sub, None),
        (icon_drop, "Влажность", ("%d%%" % hum) if hum is not None else "—", "воздуха", (hum / 100.0) if hum is not None else None),
        (icon_gauge, "Давление", ("%d мм" % pres) if pres is not None else "—", pressure_hint(pres) or "рт. ст.", max(0.0, min(1.0, (pres - 720) / 70.0)) if pres is not None else None),
        (icon_sun_horizon, "Солнце", "%s–%s" % (sr, ss), dl, None),
    ]

    for i, (ico, label, val, sub, bar_frac) in enumerate(tiles):
        tx = pad + i * (tile_w + gap)
        d.rounded_rectangle((tx, tile_y, tx + tile_w, tile_y + tile_h), radius=12 * IMG_S, fill=pal["surface"], outline=pal["hairline"], width=IMG_S)
        ico(d, tx + 14 * IMG_S, tile_y + 14 * IMG_S, 16 * IMG_S, mut)
        d.text((tx + 36 * IMG_S, tile_y + 14 * IMG_S), label, font=img_font(12), fill=mut, anchor="la")
        d.text((tx + 14 * IMG_S, tile_y + 40 * IMG_S), img_fit(d, val, img_font(18, bold=True, mono=True), tile_w - 28 * IMG_S), font=img_font(18, bold=True, mono=True), fill=col, anchor="la")
        d.text((tx + 14 * IMG_S, tile_y + 68 * IMG_S), img_fit(d, sub, img_font(11), tile_w - 28 * IMG_S), font=img_font(11), fill=sec, anchor="la")
        if bar_frac is not None:
            bx1 = tx + 14 * IMG_S
            bx2 = tx + tile_w - 14 * IMG_S
            by = tile_y + tile_h - 12 * IMG_S
            bh = 4 * IMG_S
            d.rounded_rectangle((bx1, by, bx2, by + bh), radius=bh // 2, fill=pal["bar_bg"])
            fw = max(bh, (bx2 - bx1) * max(0.0, min(1.0, bar_frac)))
            d.rounded_rectangle((bx1, by, bx1 + fw, by + bh), radius=bh // 2, fill=acc)

    # Time-of-day panel with temperature curve
    panel_y = 300 * IMG_S
    panel_h = 156 * IMG_S
    d.rounded_rectangle((pad, panel_y, W - pad, panel_y + panel_h), radius=14 * IMG_S, fill=pal["surface"], outline=pal["hairline"], width=IMG_S)
    d.text((pad + 16 * IMG_S, panel_y + 12 * IMG_S), "По времени суток", font=img_font(12, bold=True), fill=mut, anchor="la")

    parts_detail = current.get("parts_detail") or {}
    part_items = []
    for key, label in PART_LABELS:
        p = parts_detail.get(key) or {}
        t_p = p.get("temp") if p.get("temp") is not None else current.get(key)
        part_items.append((label, t_p, p.get("cond") or "", p.get("wind")))

    cw = (W - pad * 2) / 4
    valid_t = [x[1] for x in part_items if x[1] is not None]
    t_min = min(valid_t) if valid_t else 0
    t_max = max(valid_t) if valid_t else 1
    t_span = max(1, t_max - t_min)

    pts = []
    curve_top = panel_y + 92 * IMG_S
    curve_bot = panel_y + 114 * IMG_S

    for i, (label, t_p, p_cond, p_wind) in enumerate(part_items):
        cx_p = pad + i * cw + cw / 2
        if i > 0:
            d.rectangle((pad + i * cw, panel_y + 34 * IMG_S, pad + i * cw + IMG_S, panel_y + panel_h - 14 * IMG_S), fill=pal["hairline"])
        d.text((cx_p, panel_y + 34 * IMG_S), label, font=img_font(12), fill=sec, anchor="ma")
        if p_cond:
            icon_weather(d, icon_kind(p_cond), cx_p - 10 * IMG_S, panel_y + 52 * IMG_S, 20 * IMG_S, pal, night=(label == "Ночью"))
            temp_y_pos = panel_y + 122 * IMG_S
        else:
            temp_y_pos = panel_y + 122 * IMG_S
        d.text((cx_p, temp_y_pos), temp_str(t_p), font=img_font(17, bold=True, mono=True), fill=col, anchor="ma")
        if t_p is not None:
            norm = (t_p - t_min) / t_span
            py = curve_bot - norm * (curve_bot - curve_top)
            pts.append((cx_p, py))

    # Draw subtle sparkline connecting temperatures
    if len(pts) >= 2:
        d.line(pts, fill=acc, width=max(2, int(2.2 * IMG_S)))
        for px, py in pts:
            r = 4 * IMG_S
            d.ellipse((px - r, py - r, px + r, py + r), fill=pal["surface"], outline=acc, width=2 * IMG_S)

    # Bottom info strip
    foot_y = 472 * IMG_S
    summary = ""
    if current.get("today_line") and not tomorrow:
        summary = "Сегодня: %s" % current["today_line"]
    elif current.get("yesterday") is not None:
        summary = "%s: %s" % ("Сегодня днём" if tomorrow else "Вчера в это время", temp_str(current.get("yesterday")))
    if summary:
        d.text((pad, foot_y), img_fit(d, summary, img_font(12), W - pad * 2 - 220 * IMG_S), font=img_font(12), fill=sec, anchor="la")
    d.text((W - pad, foot_y), "%s · .pogoda" % BRAND_TAG, font=img_font(12), fill=mut, anchor="ra")

    d.text((pad, H - 24 * IMG_S), ".pogoda завтра   ·   .pogoda неделя", font=img_font(11, mono=True), fill=mut, anchor="la")

    out = img.resize((IMG_W, int(H / IMG_S)), Image.LANCZOS)
    out.save(path, "PNG")
    return path


def short_day(title):
    t = (title or "").lower()
    if "сегодня" in t:
        return "Сегодня"
    if "завтра" in t:
        return "Завтра"
    for name, short in (
        ("понедельник", "Пн"),
        ("вторник", "Вт"),
        ("среда", "Ср"),
        ("четверг", "Чт"),
        ("пятница", "Пт"),
        ("суббота", "Сб"),
        ("воскресенье", "Вс"),
    ):
        if name in t:
            return short
    return (title or "")[:8]


def short_date(title):
    m = re.search(r"(\d{1,2})\s+([а-яё]+)", title or "", re.I)
    if not m:
        return ""
    day_num = m.group(1)
    month_word = m.group(2).lower()
    for prefix, abbr in MONTH_ABBR:
        if month_word.startswith(prefix):
            return "%s %s" % (day_num, abbr)
    return ""


def render_week_card(path, city, days, dark=True):
    pal = pick_palette(dark)
    W = IMG_W * IMG_S
    items = (days or [])[:7]
    H = 388 * IMG_S
    img, d = widget_frame(W, H, pal)
    pad = 28 * IMG_S
    col = pal["text"]
    sec = pal["secondary"]
    mut = pal["muted"]
    acc = pal["accent"]

    # Calculate global weekly temp range for proportional range bars
    all_t = []
    for day in items:
        for pk in ("day", "night"):
            t = (day["parts"].get(pk) or {}).get("temp")
            if t is not None:
                all_t.append(t)
    w_min = min(all_t) if all_t else 0
    w_max = max(all_t) if all_t else 1
    w_span = max(1, w_max - w_min)

    # Header
    d.text((pad, 22 * IMG_S), img_fit(d, city, img_font(20, bold=True), W - pad * 2 - 260 * IMG_S), font=img_font(20, bold=True), fill=col, anchor="la")
    range_txt = "Прогноз на 7 дней"
    if all_t:
        range_txt += "  ·  %s … %s" % (temp_str(w_min), temp_str(w_max))
    d.text((W - pad, 26 * IMG_S), range_txt, font=img_font(13, mono=True), fill=mut, anchor="ra")
    hairline(d, pad, W - pad, 58 * IMG_S, pal)

    n = max(1, len(items))
    gap = 8 * IMG_S
    cw = (W - pad * 2 - (n - 1) * gap) / n
    top = 74 * IMG_S
    card_h = 266 * IMG_S

    bar_top = top + 132 * IMG_S
    bar_bot = top + 194 * IMG_S

    for i, day in enumerate(items):
        day_p = day["parts"].get("day") or {}
        night_p = day["parts"].get("night") or {}
        title = day.get("title") or ""
        cond = day_p.get("cond") or ""
        x1 = pad + i * (cw + gap)
        x2 = x1 + cw
        cx = (x1 + x2) / 2

        bg_tile = pal["raised"] if i == 0 else pal["surface"]
        d.rounded_rectangle((x1, top, x2, top + card_h), radius=12 * IMG_S, fill=bg_tile, outline=pal["border"] if i == 0 else pal["hairline"], width=IMG_S)
        if i == 0:
            d.rounded_rectangle((x1 + 14 * IMG_S, top, x2 - 14 * IMG_S, top + 3 * IMG_S), radius=2 * IMG_S, fill=acc)

        d.text((cx, top + 14 * IMG_S), short_day(title), font=img_font(13, bold=(i == 0)), fill=acc if i == 0 else col, anchor="ma")
        d.text((cx, top + 34 * IMG_S), short_date(title), font=img_font(11, mono=True), fill=mut, anchor="ma")

        icon_weather(d, icon_kind(cond), cx - 14 * IMG_S, top + 56 * IMG_S, 28 * IMG_S, pal)

        t_day = day_p.get("temp")
        t_night = night_p.get("temp")
        d.text((cx, top + 98 * IMG_S), temp_str(t_day), font=img_font(18, bold=True, mono=True), fill=col, anchor="ma")

        # Proportional temperature range bar
        bw = 6 * IMG_S
        d.rounded_rectangle((cx - bw / 2, bar_top, cx + bw / 2, bar_bot), radius=bw // 2, fill=pal["bar_bg"])
        if t_day is not None or t_night is not None:
            hi = max(x for x in (t_day, t_night) if x is not None)
            lo = min(x for x in (t_day, t_night) if x is not None)
            y_hi = bar_bot - ((hi - w_min) / w_span) * (bar_bot - bar_top)
            y_lo = bar_bot - ((lo - w_min) / w_span) * (bar_bot - bar_top)
            if y_lo - y_hi < bw:
                y_lo = min(bar_bot, y_hi + bw)
            d.rounded_rectangle((cx - bw / 2, y_hi, cx + bw / 2, y_lo), radius=bw // 2, fill=acc if i == 0 else pal["warm"] if hi > 0 else pal["cool"])

        d.text((cx, top + 206 * IMG_S), temp_str(t_night), font=img_font(14, mono=True), fill=sec, anchor="ma")
        w_spd = day_p.get("wind")
        if w_spd is not None:
            d.text((cx, top + 234 * IMG_S), ("%g м/с" % w_spd).replace(".", ","), font=img_font(11), fill=mut, anchor="ma")

    d.text((pad, H - 28 * IMG_S), ".pogoda   ·   .pogoda завтра", font=img_font(11, mono=True), fill=mut, anchor="la")
    d.text((W - pad, H - 28 * IMG_S), BRAND_TAG, font=img_font(12), fill=mut, anchor="ra")

    out = img.resize((IMG_W, int(H / IMG_S)), Image.LANCZOS)
    out.save(path, "PNG")
    return path


def image_cache_dir():
    base = None
    try:
        base = get_cache_dir() if get_cache_dir else None
    except Exception:
        base = None
    if not base:
        base = tempfile.gettempdir()
    path = os.path.join(base, "yandex_pogoda")
    try:
        if ensure_dir_exists:
            ensure_dir_exists(path)
        else:
            os.makedirs(path, exist_ok=True)
    except Exception:
        os.makedirs(path, exist_ok=True)
    return path


def _safe_delete(path):
    try:
        if delete_file:
            delete_file(path)
        elif os.path.exists(path):
            os.remove(path)
    except Exception:
        pass


def cleanup_stale_images(folder):
    now = time.time()
    try:
        for name in os.listdir(folder):
            if not name.endswith(".png"):
                continue
            full = os.path.join(folder, name)
            try:
                if now - os.path.getmtime(full) > STALE_IMAGE_AGE:
                    _safe_delete(full)
            except Exception:
                pass
    except Exception:
        pass


class YandexPogodaPlugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self._geo_cache = {}
        self._weather_cache = {}
        self._last_request = 0.0
        self._menu_items = []

    def on_plugin_load(self):
        self.add_on_send_message_hook()
        weather_cond = (
            'message != null && message.messageOwner != null && '
            'message.messageOwner.message != null && ('
            'message.messageOwner.message.contains("Яндекс Погода") || '
            'message.messageOwner.message.contains(".pogoda")'
            ')'
        )
        self._menu_items = [
            self.add_menu_item(
                MenuItemData(
                    menu_type=MenuItemType.MESSAGE_CONTEXT_MENU,
                    text="Погода сейчас",
                    on_click=self._on_today_click,
                    condition=weather_cond,
                    priority=12,
                )
            ),
            self.add_menu_item(
                MenuItemData(
                    menu_type=MenuItemType.MESSAGE_CONTEXT_MENU,
                    text="Погода на завтра",
                    on_click=self._on_tomorrow_click,
                    condition=weather_cond,
                    priority=11,
                )
            ),
            self.add_menu_item(
                MenuItemData(
                    menu_type=MenuItemType.MESSAGE_CONTEXT_MENU,
                    text="Погода на неделю",
                    on_click=self._on_week_click,
                    condition=weather_cond,
                    priority=10,
                )
            ),
            self.add_menu_item(
                MenuItemData(
                    menu_type=MenuItemType.CHAT_ACTION_MENU,
                    text="Яндекс Погода",
                    on_click=self._on_chat_menu_click,
                    priority=5,
                )
            ),
        ]
        self.logger.info("Yandex Pogoda plugin loaded")

    def on_plugin_unload(self):
        for item_id in self._menu_items:
            if item_id:
                try:
                    self.remove_menu_item(item_id)
                except Exception:
                    pass
        self._menu_items = []
        self._weather_cache.clear()
        self.logger.info("Yandex Pogoda plugin unloaded")

    def create_settings(self):
        return [
            Header(text="Основные настройки"),
            Input(
                key="city",
                text="Город по умолчанию",
                default=DEFAULT_CITY,
                subtext="Используется, если после .pogoda не указан город",
                icon="msg_search",
            ),
            Input(
                key="api_key",
                text="API-ключ Яндекс Погоды",
                default="",
                subtext="Необязательно. Без ключа данные загружаются с сайта yandex.ru/pogoda",
                icon="msg_edit",
            ),
            Divider(),
            Header(text="Оформление и отчёт"),
            Switch(
                key="image",
                text="Карточка картинкой",
                default=True,
                subtext="Отправлять графический виджет с графиком температуры и показателями",
                icon="msg_photos",
            ),
            Switch(
                key="compact_caption",
                text="Короткая подпись к карточке",
                default=False,
                subtext="Выключено — под картинкой отправляется полный подробный отчёт по часам и параметрам",
                icon="msg_list",
            ),
            Switch(
                key="dark_theme",
                text="Тёмная тема карточек",
                default=True,
                subtext="Использовать тёмное оформление для графических виджетов",
                icon="msg_theme",
            ),
            Divider(
                text="Команды: .pogoda, .pogoda завтра, .pogoda неделя, .pogoda Казань на неделю. "
                "Быстрый вызов также доступен через меню чата (⋮ → Яндекс Погода)."
            ),
            Text(
                text="Очистить кеш погоды",
                subtext="Сбросить сохранённые прогнозы и координаты городов",
                icon="msg_delete",
                on_click=self._on_clear_cache_click,
            ),
        ]

    def _on_clear_cache_click(self, _view):
        self._geo_cache.clear()
        self._weather_cache.clear()
        BulletinHelper.show_success("Кеш погоды очищен")

    def _on_chat_menu_click(self, context):
        account = context.get("account") or 0
        peer = self._peer_from_context(context)
        if peer is None:
            return
        city = (self.get_setting("city", DEFAULT_CITY) or DEFAULT_CITY).strip() or DEFAULT_CITY

        def _show():
            fragment = context.get("fragment") or get_last_fragment()
            if fragment is None:
                return
            activity = fragment.getParentActivity()
            if activity is None:
                return
            items = [
                "Сейчас (%s)" % city,
                "На завтра (%s)" % city,
                "На неделю (%s)" % city,
            ]
            periods = ("today", "tomorrow", "week")

            def _on_pick(builder, which):
                builder.dismiss()
                if 0 <= which < len(periods):
                    run_on_queue(
                        lambda p=periods[which]: self._worker(account, peer, city, p, None),
                        queue_name=EXTERNAL_NETWORK_QUEUE,
                    )

            builder = AlertDialogBuilder(activity)
            builder.set_title("Яндекс Погода")
            builder.set_items(items, _on_pick)
            builder.set_negative_button("Отмена", lambda b, _w: b.dismiss())
            builder.show()

        run_on_ui_thread(_show)

    def _origin_from_params(self, params):
        origin = {}
        raw_peer = getattr(params, "peer", None)
        if raw_peer is not None:
            origin["peer"] = raw_peer
        for field in (
            "replyToMsg",
            "replyToTopMsg",
            "replyToMsgId",
            "reply_to_msg_id",
            "messageThreadInfo",
            "reply_to",
            "send_to_channel",
            "dialog_id",
        ):
            val = getattr(params, field, None)
            if val is not None:
                origin[field] = val
        return origin

    def on_send_message_hook(self, account, params):
        message = getattr(params, "message", None)
        if not isinstance(message, str):
            return HookResult()
        raw = message.strip()
        raw_low = raw.lower()
        if not (
            raw_low == PREFIX
            or raw_low.startswith(PREFIX + " ")
            or raw_low.startswith(PREFIX + "\n")
            or raw_low.startswith(PREFIX + "\t")
        ):
            return HookResult()
        origin = self._origin_from_params(params)
        raw_peer = origin.get("peer")
        if raw_peer is None or isinstance(raw_peer, bool):
            return HookResult()
        peer = None
        if isinstance(raw_peer, int):
            peer = raw_peer
        else:
            try:
                peer = int(raw_peer)
            except Exception:
                inner = getattr(raw_peer, "dialog_id", None)
                try:
                    peer = int(inner) if inner is not None else None
                except Exception:
                    peer = None
        if peer is None:
            return HookResult()
        origin["peer"] = peer
        rest = raw[len(PREFIX) :].strip(" \t\n\r,;:")
        period, city = split_city_and_period(rest)
        run_on_queue(
            lambda: self._worker(account, peer, city, period, origin),
            queue_name=EXTERNAL_NETWORK_QUEUE,
        )
        return HookResult(strategy=HookStrategy.CANCEL)

    def _city_from_message(self, message):
        text = ""
        if message is not None:
            owner = getattr(message, "messageOwner", None)
            if owner is not None:
                text = str(getattr(owner, "message", "") or "")
            if not text:
                text = str(getattr(message, "caption", "") or "")
            if not text:
                text = str(getattr(message, "messageText", "") or "")
        text = text.strip()
        first = text.split("\n", 1)[0].strip()
        first = re.sub(r"<[^>]+>", "", first).strip()
        if " — " in first:
            return first.split(" — ", 1)[0].strip(" ,;:")
        if "—" in first:
            return first.split("—", 1)[0].strip(" ,;:")
        return ""

    def _peer_from_context(self, context):
        dialog_id = context.get("dialog_id")
        if dialog_id is None:
            message = context.get("message")
            owner = getattr(message, "messageOwner", None) if message is not None else None
            dialog_id = getattr(owner, "dialog_id", None)
            if dialog_id is None:
                get_did = getattr(message, "getDialogId", None)
                if callable(get_did):
                    try:
                        dialog_id = get_did()
                    except Exception:
                        dialog_id = None
        try:
            return int(dialog_id) if dialog_id is not None else None
        except Exception:
            return None

    def _on_tomorrow_click(self, context):
        self._menu_period(context, "tomorrow")

    def _on_week_click(self, context):
        self._menu_period(context, "week")

    def _on_today_click(self, context):
        self._menu_period(context, "today")

    def _menu_period(self, context, period):
        account = context.get("account") or 0
        peer = self._peer_from_context(context)
        if peer is None:
            return
        message = context.get("message")
        city = self._city_from_message(message)
        origin = {"replyToMsg": message} if message is not None else None
        run_on_queue(
            lambda: self._worker(account, peer, city, period, origin),
            queue_name=EXTERNAL_NETWORK_QUEUE,
        )

    def _send_java_text(self, account, peer, text, origin):
        if not (HAS_JAVA_SEND and get_send_messages_helper and parse_text):
            return False
        try:
            parsed = parse_text(text, parse_mode="HTML")
            helper = get_send_messages_helper(account)
            params = SendMessagesHelper.SendMessageParams()
            params.peer = peer
            params.message = parsed.get("message") or text
            entities = parsed.get("entities")
            if entities:
                params.entities = entities
            for field in ("replyToMsg", "replyToTopMsg", "messageThreadInfo", "reply_to"):
                val = origin.get(field)
                if val is not None and hasattr(params, field):
                    setattr(params, field, val)
            helper.sendMessage(params, False)
            return True
        except Exception:
            self.logger.exception("java send failed")
            return False

    def _send_text(self, account, peer, text, origin=None):
        origin = origin or {}
        if self._send_java_text(account, peer, text, origin):
            return
        if send_message is not None:
            payload = {"peer": peer, "message": text}
            for key in ("replyToMsg", "replyToTopMsg", "messageThreadInfo"):
                val = origin.get(key)
                if val is not None:
                    payload[key] = val
            try:
                send_message(payload, parse_mode="HTML", account=account)
                return
            except TypeError as e:
                self.logger.info("send_message TypeError: %s", e)
            except Exception:
                self.logger.exception("send_message failed")
        try:
            kwargs = {"parse_mode": "HTML", "account": account}
            if origin.get("replyToMsg") is not None:
                kwargs["replyToMsg"] = origin["replyToMsg"]
            send_text(peer, text, **kwargs)
            return
        except TypeError as e:
            self.logger.warning("send_text TypeError: %s", e)
        send_text(peer, text, parse_mode="HTML", account=account)

    def _send_photo(self, account, peer, path, caption, origin=None):
        if send_photo is None:
            return False
        origin = origin or {}
        base = {"caption": caption, "parse_mode": "HTML"}
        for key in ("replyToMsg", "replyToTopMsg", "messageThreadInfo"):
            val = origin.get(key)
            if val is not None:
                base[key] = val
        attempts = [
            dict(base, high_quality=True, account=account),
            dict(base, account=account),
            dict(base, high_quality=True),
            dict(base),
        ]
        for kwargs in attempts:
            try:
                send_photo(peer, path, **kwargs)
                return True
            except TypeError as e:
                self.logger.info("send_photo TypeError %s", e)
                continue
            except Exception:
                self.logger.exception("send_photo failed")
                return False
        return False

    def _worker(self, account, peer, city, period="today", origin=None):
        origin = origin or {}
        try:
            data = self._load_weather(city, period)
        except Exception as error:
            self.logger.exception("Failed to build weather")
            BulletinHelper.show_error("Яндекс Погода: %s" % error)
            return

        image_path = None
        text = data["text"]
        caption = data["caption"] if self.get_setting("compact_caption", False) else safe_caption(text, data["caption"])

        if self.get_setting("image", True) and HAS_PIL:
            try:
                dark = self.get_setting("dark_theme", True)
                folder = image_cache_dir()
                cleanup_stale_images(folder)
                fname = "card_%s_%d.png" % (data["period"], int(time.time() * 1000))
                path = os.path.join(folder, fname)
                if data["period"] == "week":
                    render_week_card(path, data["city"], data["days"], dark=dark)
                elif data["period"] == "tomorrow":
                    render_today_card(path, data["city"], data["date_str"], data["current"], tomorrow=True, dark=dark)
                else:
                    render_today_card(path, data["city"], data["date_str"], data["current"], tomorrow=False, dark=dark)
                image_path = path
            except Exception:
                self.logger.exception("render failed")
                image_path = None

        sent = False
        if image_path:
            sent = self._send_photo(account, peer, image_path, caption, origin)
            run_on_queue(
                lambda p=image_path: _safe_delete(p),
                queue_name=CACHE_CLEAR_QUEUE,
                delay=30000,
            )
        if not sent:
            self._send_text(account, peer, text, origin)

    def _fetch_bundle_cached(self, key, geo, api_key):
        cache_key = (key, bool(api_key))
        now = time.time()
        cached = self._weather_cache.get(cache_key)
        if cached and (now - cached[0]) < WEATHER_CACHE_TTL:
            return dict(cached[1]), cached[2]

        if now - self._last_request < 1.5:
            time.sleep(1.5 - (now - self._last_request))
        self._last_request = time.time()

        if api_key:
            current, days = fetch_api_bundle(geo["lat"], geo["lon"], api_key)
        else:
            current, days = fetch_site_bundle(geo["lat"], geo["lon"])

        if not current.get("sunrise") and days:
            current["sunrise"] = days[0].get("sunrise")
            current["sunset"] = days[0].get("sunset")

        if len(self._weather_cache) >= GEO_CACHE_LIMIT:
            self._weather_cache.clear()
        self._weather_cache[cache_key] = (time.time(), dict(current), days)
        return dict(current), days

    def _load_weather(self, city, period):
        city = (city or "").strip()
        if not city:
            city = (self.get_setting("city", DEFAULT_CITY) or DEFAULT_CITY).strip()
        if not city:
            raise ValueError("Укажите город: .pogoda Москва")

        key = city.lower()
        geo = self._geo_cache.get(key)
        if not geo:
            geo = geocode_city(city)
            if len(self._geo_cache) >= GEO_CACHE_LIMIT:
                self._geo_cache.clear()
            self._geo_cache[key] = geo

        api_key = (self.get_setting("api_key", "") or "").strip()
        current, days = self._fetch_bundle_cached(key, geo, api_key)

        name = geo.get("name") or city
        tz = geo.get("tz") or ""
        current["_tz"] = tz
        now_dt = local_now(tz)
        date_str = "%d %s, %02d:%02d" % (now_dt.day, MONTHS_GEN[now_dt.month - 1], now_dt.hour, now_dt.minute)

        if period == "tomorrow":
            today_ref = current.get("day") if current.get("day") is not None else current.get("temp")
            target = None
            for day in days:
                if "завтра" in (day.get("title") or "").lower():
                    target = day
                    break
            if target is None and len(days) > 1:
                target = days[1]
            if target is None:
                target = days[0] if days else None
            if target:
                parts = target.get("parts") or {}
                day_p = parts.get("day") or {}
                morning = parts.get("morning") or {}
                evening = parts.get("evening") or {}
                night = parts.get("night") or {}
                view = {
                    "temp": day_p.get("temp"),
                    "feels": day_p.get("feels"),
                    "condition": day_p.get("cond") or morning.get("cond"),
                    "wind_speed": day_p.get("wind"),
                    "wind_dir": day_p.get("dir"),
                    "humidity": day_p.get("humidity"),
                    "pressure": day_p.get("pressure"),
                    "yesterday": today_ref,
                    "morning": morning.get("temp"),
                    "day": day_p.get("temp"),
                    "evening": evening.get("temp"),
                    "night": night.get("temp"),
                    "parts_detail": parts,
                    "sunrise": target.get("sunrise") or current.get("sunrise"),
                    "sunset": target.get("sunset") or current.get("sunset"),
                    "_tz": tz,
                }
                title = target.get("title") or "завтра"
                low = title.lower()
                date_str = (title[0].lower() + title[1:]) if low.startswith("завтра") else ("завтра, %s" % title)
                current = view
            text = build_tomorrow_quote(name, days, today_ref=today_ref)
            caption = "<blockquote><b>%s — %s</b>\nДнём: %s\n\n%s\n<code>.pogoda</code>\n<code>.pogoda неделя</code></blockquote>" % (
                escape(name),
                escape(date_str),
                temp_str(current.get("temp")),
                BRAND_TAG,
            )
            return {
                "city": name,
                "period": "tomorrow",
                "days": days,
                "current": current,
                "date_str": date_str,
                "text": text,
                "caption": caption,
            }

        if period == "week":
            text = build_week_quote(name, days)
            caption = "<blockquote><b>%s — на неделю</b>\n\n%s\n<code>.pogoda</code>\n<code>.pogoda завтра</code></blockquote>" % (
                escape(name),
                BRAND_TAG,
            )
            return {
                "city": name,
                "period": "week",
                "days": days,
                "current": current,
                "date_str": "на неделю",
                "text": text,
                "caption": caption,
            }

        text = build_quote(name, current, tz)
        compare = comparison_line(current, tomorrow=False) or (current.get("condition") or "")
        caption = (
            "<blockquote><b>%s — %s</b>\n%s\nТемпература: %s (ощущается как %s)\n"
            "\n%s\n<code>.pogoda завтра</code>\n<code>.pogoda неделя</code></blockquote>"
        ) % (
            escape(name),
            escape(date_str),
            escape(compare),
            temp_str(current.get("temp")),
            temp_str(current.get("feels")),
            BRAND_TAG,
        )
        return {
            "city": name,
            "period": "today",
            "days": days,
            "current": current,
            "date_str": date_str,
            "text": text,
            "caption": caption,
        }
