    return {
        "title": "",
        "parts": {},
        "sunrise": None,
        "sunset": None,
    }


def extract_faq(html):
    out = []
    for block in re.findall(r"<script[^>]*application/ld\+json[^>]*>(.*?)</script>", html, re.S):
        try:
            data = json.loads(block)
        except Exception:
            continue
        if not isinstance(data, dict) or data.get("@type") != "FAQPage":
            continue
        for item in data.get("mainEntity") or []:
            if not isinstance(item, dict):
                continue
            name = clean_text(item.get("name"))
            answer = item.get("acceptedAnswer") or {}
            text = clean_text(answer.get("text") if isinstance(answer, dict) else "")
            if name and text:
                out.append((name, text))
        if out:
            break
    return out


def find_answer(answers, keyword):
    for name, text in answers:
        if keyword in name.lower():
            return text
    return ""


def apply_a11y(weather, a11y):
    if not a11y:
        return
    match = re.search(r"Температура воздуха\s+([+\-−–—]?\d+)", a11y)
    if match:
        weather["temp"] = to_int(match.group(1))
    match = re.search(r"ощущается как\s+([+\-−–—]?\d+)", a11y)
    if match:
        weather["feels"] = to_int(match.group(1))
    match = re.search(r"Скорость ветра\s+([0-9]+(?:[.,][0-9]+)?)\s*м/с\s*,\s*([а-яёА-ЯЁ\-]+)", a11y)
    if match:
        weather["wind_speed"] = to_float(match.group(1))
        weather["wind_dir"] = normalize_dir(match.group(2))
    match = re.search(r"Давление\s+(\d+)\s*мм", a11y)
    if match:
        weather["pressure"] = to_int(match.group(1))
    match = re.search(r"Влажность\s+(\d+)", a11y)
    if match:
        weather["humidity"] = to_int(match.group(1))
    match = re.search(r"Вчера в это время\s+([+\-−–—]?\d+)", a11y)
    if match:
        weather["yesterday"] = to_int(match.group(1))
    match = re.search(r"Восход\s+(\d{1,2}:\d{2}),\s*Закат\s+(\d{1,2}:\d{2})", a11y)
    if match:
        a, b = match.group(1), match.group(2)
        ma, mb = parse_hm(a), parse_hm(b)
        if ma is not None and mb is not None and ma > mb:
            a, b = b, a
        weather["sunrise"] = a
        weather["sunset"] = b
    if not weather["condition"]:
        weather["condition"] = find_condition(a11y)


def apply_main_answer(weather, text):
    if not text:
        return
    match = re.search(r"температура воздуха\s+([+\-−–—]?\d+)", text, re.I)
    if match and weather["temp"] is None:
        weather["temp"] = to_int(match.group(1))
    match = re.search(r"ощущается как\s+([+\-−–—]?\d+)", text, re.I)
    if match and weather["feels"] is None:
        weather["feels"] = to_int(match.group(1))
    match = re.search(r"Ветер\s+([0-9]+(?:[.,][0-9]+)?)\s*м/с\s*,\s*([а-яёА-ЯЁ\-]+)", text)
    if match and weather["wind_speed"] is None:
        weather["wind_speed"] = to_float(match.group(1))
        weather["wind_dir"] = weather["wind_dir"] or normalize_dir(match.group(2))
    match = re.search(r"влажност[аи]\s+(\d+)", text, re.I)
    if match and weather["humidity"] is None:
        weather["humidity"] = to_int(match.group(1))
    match = re.search(r"давление\s+(\d+)", text, re.I)
    if match and weather["pressure"] is None:
        weather["pressure"] = to_int(match.group(1))
    match = re.search(r"Сегодня:\s*(.+)", text)
    if match:
        today = match.group(1)
        warning = ""
        for needle in ("Предупреждение", "Гидрометцентр"):
            idx = today.find(needle)
            if idx >= 0:
                warning = today[idx:]
                today = today[:idx]
                break
        today = today.strip(" ,.;")
        if today and not weather["today_line"]:
            weather["today_line"] = today
        if warning and not weather["warning"]:
            weather["warning"] = warning.strip(" ,.;")
    if not weather["condition"]:
        weather["condition"] = find_condition(text)


def apply_degrees_answer(weather, text):
    if not text:
        return
    match = re.search(r"температура воздуха\s+([+\-−–—]?\d+)", text, re.I)
    if match and weather["temp"] is None:
        weather["temp"] = to_int(match.group(1))
    match = re.search(r"ощущается как\s+([+\-−–—]?\d+)", text, re.I)
    if match and weather["feels"] is None:
        weather["feels"] = to_int(match.group(1))
    match = re.search(
        r"Температура утром\s+([+\-−–—]?\d+)°\s*,\s*днем\s+([+\-−–—]?\d+)°\s*,\s*вечером\s+([+\-−–—]?\d+)°\s*,\s*ночью\s+([+\-−–—]?\d+)°",
        text,
        re.I,
    )
    if match:
        weather["morning"] = to_int(match.group(1))
        weather["day"] = to_int(match.group(2))
        weather["evening"] = to_int(match.group(3))
        weather["night"] = to_int(match.group(4))
    if not weather["condition"]:
        weather["condition"] = find_condition(text)


def apply_wind_answer(weather, text):
    if not text:
        return
    match = re.search(r"сейчас\s+([0-9]+(?:[.,][0-9]+)?)\s*м/с\s*,\s*([а-яёА-ЯЁ\-]+)", text)
    if match:
        if weather["wind_speed"] is None:
            weather["wind_speed"] = to_float(match.group(1))
        if not weather["wind_dir"]:
            weather["wind_dir"] = normalize_dir(match.group(2))
    match = re.search(r"давление\s+(\d+)", text, re.I)
    if match and weather["pressure"] is None:
        weather["pressure"] = to_int(match.group(1))


def apply_humidity_answer(weather, text):
    if not text:
        return
    match = re.search(r"составляет\s+(\d+)", text)
    if match and weather["humidity"] is None:
        weather["humidity"] = to_int(match.group(1))


def parse_site(html):
    weather = new_weather()
    a11y = ""
    match = re.search(r"погода сейчас:\s*([^<]+)", html)
    if match:
        a11y = clean_text(match.group(1))
    apply_a11y(weather, a11y)
    answers = extract_faq(html)
    apply_main_answer(weather, find_answer(answers, "какая погода"))
    apply_degrees_answer(weather, find_answer(answers, "сколько градусов"))
    apply_wind_answer(weather, find_answer(answers, "ветр"))
    apply_humidity_answer(weather, find_answer(answers, "влажност"))
    if not weather["condition"]:
        weather["condition"] = find_condition(a11y, *[text for _, text in answers])
    return weather


def parse_part_line(line):
    match = re.search(
        r"([+\-−–—]?\d+)°\s*,\s*ощущается как\s+([+\-−–—]?\d+)°\s*,\s*([^,]+?)\s*,\s*скорость ветра\s+([0-9]+(?:[.,][0-9]+)?)\s*м/с",
        line,
    )
    if not match:
        simple = re.search(r"([+\-−–—]?\d+)°", line)
        if not simple:
            return None
        return {
            "temp": to_int(simple.group(1)),
            "feels": None,
            "cond": find_condition(line),
            "wind": None,
            "dir": None,
            "humidity": None,
            "pressure": None,
        }
    rest = line[match.end() :].lower()
    direction = None
    for chunk in re.findall(r"[а-яё\-]+", rest):
        normalized = normalize_dir(chunk)
        if normalized in FULL_DIRS:
            direction = normalized
            break
    humidity = re.search(r"влажность\s+(\d+)", rest)
    pressure = re.search(r"давление\s+(\d+)", rest)
    return {
        "temp": to_int(match.group(1)),
        "feels": to_int(match.group(2)),
        "cond": find_condition(match.group(3)) or clean_text(match.group(3)).lower(),
        "wind": to_float(match.group(4)),
        "dir": direction,
        "humidity": to_int(humidity.group(1)) if humidity else None,
        "pressure": to_int(pressure.group(1)) if pressure else None,
    }


def parse_site_days(html):
    days = []
    seen = set()
    for match in re.finditer(r'<p class="A11Y[^"]*"[^>]*>(.*?)</p>', html, re.S):
        text = clean_multiline(match.group(1))
        if not text or "утром" not in text or "ночью" not in text:
            continue
        first = text.split("\n", 1)[0].strip()
        title = first.rstrip(":").strip()
        if not title:
            continue
        key = title.lower()
        if key in seen:
            continue
        day = new_day()
        day["title"] = title
        for line in text.split("\n")[1:]:
            line = line.strip()
            low = line.lower()
            for key_part, prefix in PART_KEYS:
                if low.startswith(prefix):
                    day["parts"][key_part] = parse_part_line(line)
                    break
            else:
                m_sr = re.search(r"восход\s+(\d{1,2}:\d{2})", low)
                if m_sr and not day["sunrise"]:
                    day["sunrise"] = m_sr.group(1)
                m_ss = re.search(r"закат\s+(\d{1,2}:\d{2})", low)
                if m_ss and not day["sunset"]:
                    day["sunset"] = m_ss.group(1)
        if day["parts"]:
            seen.add(key)
            days.append(day)
    return days


def geocode_city(city):
    query = city.strip()
    if not query:
        raise ValueError("Укажите город: .pogoda Москва")
    data = http_get(
        "https://geocoding-api.open-meteo.com/v1/search",
        params={"name": query, "count": 1, "language": "ru", "format": "json"},
    )
    try:
        payload = json.loads(data)
    except Exception:
        payload = {}
    results = payload.get("results") or []
    if results:
        item = results[0]
        return {
            "name": clean_text(item.get("name")) or query,
            "lat": item.get("latitude"),
            "lon": item.get("longitude"),
            "tz": item.get("timezone") or "",
        }
    data = http_get(
        "https://nominatim.openstreetmap.org/search",
        params={"q": query, "format": "json", "limit": 1, "accept-language": "ru"},
    )
    try:
        payload = json.loads(data)
    except Exception:
        payload = []
    if isinstance(payload, list) and payload:
        item = payload[0]
        lat = to_float(item.get("lat"))
        lon = to_float(item.get("lon"))
        if lat is None or lon is None:
            raise ValueError("Город не найден: %s" % query)
        name = clean_text(item.get("display_name") or query).split(",")[0]
        return {"name": name or query, "lat": lat, "lon": lon, "tz": ""}
    raise ValueError("Город не найден: %s" % query)


def fetch_site_bundle(lat, lon):
    html = http_get("https://yandex.ru/pogoda/", params={"lat": lat, "lon": lon})
    if "SmartCaptcha" in html or "Captcha" in html[:5000]:
        raise ValueError("Яндекс запросил проверку. Укажите API-ключ в настройках плагина")
    current = parse_site(html)
    days = parse_site_days(html)
    if current["temp"] is None and current["feels"] is None and not current["condition"] and not days:
        raise ValueError("Не удалось разобрать данные Яндекс Погоды")
    if days:
        today_parts = days[0].get("parts") or {}
        current["parts_detail"] = today_parts
        for key in ("morning", "day", "evening", "night"):
            if current[key] is None and today_parts.get(key):
                current[key] = today_parts[key].get("temp")
    return current, days


def apply_api_fact(weather, fact):
    weather["temp"] = to_int(fact.get("temp"))
    weather["feels"] = to_int(fact.get("feels_like"))
    weather["condition"] = API_CONDITIONS.get(fact.get("condition"), fact.get("condition"))
    weather["wind_speed"] = to_float(fact.get("wind_speed"))
    weather["wind_dir"] = API_DIRS.get(fact.get("wind_dir"), fact.get("wind_dir"))
    weather["humidity"] = to_int(fact.get("humidity"))
    weather["pressure"] = to_int(fact.get("pressure_mm"))


def _iter_api_parts(raw_parts):
    if isinstance(raw_parts, dict):
        for name, part in raw_parts.items():
            if isinstance(part, dict):
                yield name, part
    elif isinstance(raw_parts, list):
        for part in raw_parts:
            if isinstance(part, dict):
                yield part.get("part_name"), part


def api_day_from_forecast(item):
    day = new_day()
    raw_date = item.get("date") or ""
    try:
        parsed = date_cls.fromisoformat(str(raw_date))
        weekday = WEEKDAYS[parsed.weekday()]
        day["title"] = "%s, %d %s" % (weekday, parsed.day, MONTHS_GEN[parsed.month - 1])
    except Exception:
        day["title"] = clean_text(raw_date) or "День"
    day["sunrise"] = clean_text(item.get("sunrise")) or None
    day["sunset"] = clean_text(item.get("sunset")) or None
    for name, part in _iter_api_parts(item.get("parts")):
        if name not in ("morning", "day", "evening", "night"):
            continue
        day["parts"][name] = {
            "temp": to_int(part.get("temp_avg")),
            "feels": to_int(part.get("feels_like")),
            "cond": API_CONDITIONS.get(part.get("condition"), part.get("condition")),
            "wind": to_float(part.get("wind_speed")),
            "dir": API_DIRS.get(part.get("wind_dir"), part.get("wind_dir")),
            "humidity": to_int(part.get("humidity")),
            "pressure": to_int(part.get("pressure_mm")),
            "temp_min": to_int(part.get("temp_min")),
            "temp_max": to_int(part.get("temp_max")),
        }
    return day


def fetch_api_bundle(lat, lon, api_key):
    text = http_get(
        "https://api.weather.yandex.ru/v2/forecast",
        params={"lat": lat, "lon": lon, "lang": "ru_RU", "limit": 7, "hours": "false", "extra": "true"},
        headers={"X-Yandex-API-Key": api_key},
    )
    try:
        data = json.loads(text)
    except Exception:
        raise ValueError("Яндекс API вернул неожиданный ответ")
    if "fact" not in data:
        raise ValueError("Яндекс API не вернул данные о погоде")
    current = new_weather()
    apply_api_fact(current, data.get("fact") or {})

    yesterday = data.get("yesterday")
    if isinstance(yesterday, dict):
        current["yesterday"] = to_int(yesterday.get("temp"))

    raw_forecasts = data.get("forecasts")
    if raw_forecasts is None:
        raw_forecasts = data.get("forecast")

    days = []
    if isinstance(raw_forecasts, list):
        days = [api_day_from_forecast(x) for x in raw_forecasts if isinstance(x, dict)]
    elif isinstance(raw_forecasts, dict):
        if current["yesterday"] is None and isinstance(raw_forecasts.get("yesterday"), dict):
            current["yesterday"] = to_int(raw_forecasts["yesterday"].get("temp"))
        raw_days = raw_forecasts.get("days") or []
        if raw_days:
            days = [api_day_from_forecast(x) for x in raw_days if isinstance(x, dict)]
        else:
            single = api_day_from_forecast(raw_forecasts)
            if single["parts"]:
                days = [single]

    if days:
        today = days[0]
        current["sunrise"] = current.get("sunrise") or today.get("sunrise")
        current["sunset"] = current.get("sunset") or today.get("sunset")
        current["parts_detail"] = today.get("parts") or {}
        for key in ("morning", "day", "evening", "night"):
            part = today["parts"].get(key)
            if part and current[key] is None:
                current[key] = part.get("temp")
        day_part = today["parts"].get("day")
        if day_part and not current["today_line"]:
            tmin = day_part.get("temp_min")
            tmax = day_part.get("temp_max")
            cond = day_part.get("cond")
            if tmin is not None and tmax is not None:
                line = "%s…%s" % (fmt_temp(tmin), fmt_temp(tmax))
                if cond:
                    line += ", %s" % cond
                current["today_line"] = line

    return current, days


def local_now(tz_name):
    if tz_name:
        try:
            from zoneinfo import ZoneInfo

            return datetime.now(ZoneInfo(tz_name))
        except Exception:
            pass
    return datetime.now()


def comparison_line(weather, tomorrow=False):
    if weather["temp"] is None or weather["yesterday"] is None:
        return None
    delta = weather["temp"] - weather["yesterday"]
    ref = "сегодня днём" if tomorrow else "вчера в это время"
    if delta == 0:
        return "Так же, как %s" % ref
    if delta < 0:
        return "На %d° холоднее, чем %s" % (abs(delta), ref)
    return "На %d° теплее, чем %s" % (delta, ref)


def wind_line(speed, direction):
    if speed is None:
        return None
    direction = direction or ""
    strength = wind_strength(speed)
    speed_text = ("%g" % speed).replace(".", ",")
    chunks = ["Ветер: %s м/с" % speed_text]
    if direction:
        chunks.append(direction)
    if strength and strength != direction:
        chunks.append(strength)
    return ", ".join(chunks)


def format_part_row(label, part, fallback_temp=None):
    t = part.get("temp") if part else fallback_temp
    if t is None:
        return None
    head = "%s: %s" % (label, fmt_temp(t))
    if part and part.get("feels") is not None and part.get("feels") != t:
        head += " (как %s)" % fmt_temp(part["feels"])
    chunks = [head]
    if part:
        if part.get("cond"):
            chunks.append(escape(part["cond"]))
        if part.get("wind") is not None:
            w = ("%g" % part["wind"]).replace(".", ",")
            d_short = DIR_SHORT.get(part.get("dir") or "", "")
            chunks.append("ветер %s м/с%s" % (w, (" " + d_short) if d_short else ""))
    return " · ".join(chunks)


def build_quote(city_name, weather, tz_name):
    now = local_now(tz_name)
    date_str = "%d %s %d, %02d:%02d" % (now.day, MONTHS_GEN[now.month - 1], now.year, now.hour, now.minute)
    lines = ["<b>%s — %s</b>" % (escape(city_name), date_str)]

    if weather["condition"]:
        cond = weather["condition"][0].upper() + weather["condition"][1:]
        compare = comparison_line(weather, tomorrow=False)
        if compare:
            lines.append("%s · %s" % (escape(cond), escape(compare)))
        else:
            lines.append(escape(cond))
    else:
        compare = comparison_line(weather, tomorrow=False)
        if compare:
            lines.append(escape(compare))

    lines.append("")
    if weather["temp"] is not None:
        temp = "Температура: <b>%s</b>" % fmt_temp_c(weather["temp"])
        if weather["feels"] is not None:
            temp += " (ощущается как %s)" % fmt_temp_c(weather["feels"])
        lines.append(temp)
    elif weather["feels"] is not None:
        lines.append("Ощущается как: <b>%s</b>" % fmt_temp_c(weather["feels"]))

    wind = wind_line(weather["wind_speed"], weather["wind_dir"])
    if wind:
        lines.append(escape(wind))

    atm = []
    if weather["humidity"] is not None:
        atm.append("Влажность: %d%%" % weather["humidity"])
    if weather["pressure"] is not None:
        hint = pressure_hint(weather["pressure"])
        p_txt = "Давление: %d мм рт. ст." % weather["pressure"]
        if hint:
            p_txt += " (%s)" % hint
        atm.append(p_txt)
    if atm:
        lines.append(" · ".join(atm))

    if weather.get("sunrise") or weather.get("sunset"):
        dl = daylight_duration(weather.get("sunrise"), weather.get("sunset"))
        sun = "Восход %s · Закат %s" % (escape(weather.get("sunrise") or "—"), escape(weather.get("sunset") or "—"))
        if dl:
            sun += " (%s)" % dl
        lines.append(sun)

    parts_detail = weather.get("parts_detail") or {}
    part_rows = []
    for key, label in PART_LABELS:
        row = format_part_row(label, parts_detail.get(key), weather.get(key))
        if row:
            part_rows.append(row)
    if part_rows:
        lines.append("")
        lines.append("<b>По времени суток:</b>")
        lines.extend(part_rows)

    if weather["today_line"]:
        lines.append("")
        lines.append("Сегодня: %s" % escape(weather["today_line"]))
    if weather["warning"]:
        lines.append("")
        lines.append("<b>Внимание:</b> %s" % escape(weather["warning"]))

    lines.append("")
    lines.append(BRAND_TAG)
    lines.append("<code>.pogoda завтра</code>")
    lines.append("<code>.pogoda неделя</code>")
    return "<blockquote>" + "\n".join(lines) + "</blockquote>"


def build_tomorrow_quote(city_name, days, today_ref=None):
    if not days:
        return (
            "<blockquote><b>%s — завтра</b>\n\nПрогноз на завтра пока недоступен.\n\n%s\n<code>.pogoda</code></blockquote>"
            % (escape(city_name), BRAND_TAG)
        )
    target = None
    for day in days:
        if "завтра" in (day.get("title") or "").lower():
            target = day
            break
    if target is None and len(days) > 1:
        target = days[1]
    if target is None:
        target = days[0]
    title = target.get("title") or "завтра"
    low = title.lower()
    display = (title[0].lower() + title[1:]) if low.startswith("завтра") else ("завтра, %s" % title)
    lines = ["<b>%s — %s</b>" % (escape(city_name), escape(display))]

    parts = target.get("parts") or {}
    day_part = parts.get("day") or {}
    morning_part = parts.get("morning") or {}

    cond = day_part.get("cond") or morning_part.get("cond")
    compare = None
    if day_part.get("temp") is not None and today_ref is not None:
        compare = comparison_line({"temp": day_part.get("temp"), "yesterday": today_ref}, tomorrow=True)
    if cond and compare:
        lines.append("%s · %s" % (escape(cond[0].upper() + cond[1:]), escape(compare)))
    elif cond:
        lines.append(escape(cond[0].upper() + cond[1:]))
    elif compare:
        lines.append(escape(compare))

    lines.append("")
    if day_part.get("temp") is not None:
        temp = "Днём: <b>%s</b>" % fmt_temp_c(day_part.get("temp"))
        if day_part.get("feels") is not None:
            temp += " (ощущается как %s)" % fmt_temp_c(day_part.get("feels"))
        lines.append(temp)

    wind = wind_line(day_part.get("wind"), day_part.get("dir"))
    if wind:
        lines.append(escape(wind))

    atm = []
    if day_part.get("humidity") is not None:
        atm.append("Влажность: %d%%" % day_part["humidity"])
    if day_part.get("pressure") is not None:
        hint = pressure_hint(day_part["pressure"])
        p_txt = "Давление: %d мм рт. ст." % day_part["pressure"]
        if hint:
            p_txt += " (%s)" % hint
        atm.append(p_txt)
    if atm:
        lines.append(" · ".join(atm))

    if target.get("sunrise") or target.get("sunset"):
        dl = daylight_duration(target.get("sunrise"), target.get("sunset"))
        sun = "Восход %s · Закат %s" % (escape(target.get("sunrise") or "—"), escape(target.get("sunset") or "—"))
        if dl:
            sun += " (%s)" % dl
        lines.append(sun)

    part_rows = []
    for key, label in PART_LABELS:
        row = format_part_row(label, parts.get(key))
        if row:
            part_rows.append(row)
    if part_rows:
        lines.append("")
        lines.append("<b>По времени суток:</b>")
        lines.extend(part_rows)

    lines.append("")
    lines.append(BRAND_TAG)
    lines.append("<code>.pogoda</code>")
    lines.append("<code>.pogoda неделя</code>")
    return "<blockquote>" + "\n".join(lines) + "</blockquote>"


def build_week_quote(city_name, days):
    if not days:
        return (
            "<blockquote><b>%s — на неделю</b>\n\nПрогноз на неделю пока недоступен.\n\n%s\n<code>.pogoda</code></blockquote>"
            % (escape(city_name), BRAND_TAG)
        )
    items = days[:7]
    all_temps = []
    for day in items:
        for pk in ("day", "night"):
            t = (day["parts"].get(pk) or {}).get("temp")
            if t is not None:
                all_temps.append(t)

    lines = ["<b>%s — прогноз на неделю</b>" % escape(city_name)]
    if all_temps:
        lines.append("Диапазон недели: от %s до %s" % (fmt_temp_c(min(all_temps)), fmt_temp_c(max(all_temps))))
    lines.append("")

    for day in items:
        day_part = day["parts"].get("day") or {}
        night_part = day["parts"].get("night") or {}
        cond = day_part.get("cond")
        chunk = "<b>%s</b>: днём %s, ночью %s" % (
            escape(day.get("title") or "—"),
            fmt_temp(day_part.get("temp")),
            fmt_temp(night_part.get("temp")),
        )
        if cond:
            chunk += " · %s" % escape(cond)
        if day_part.get("wind") is not None:
            w = ("%g" % day_part["wind"]).replace(".", ",")
            chunk += " · %s м/с" % w
        lines.append(chunk)

    lines.append("")
    lines.append(BRAND_TAG)
    lines.append("<code>.pogoda</code>")
    lines.append("<code>.pogoda завтра</code>")
    return "<blockquote>" + "\n".join(lines) + "</blockquote>"


def safe_caption(html_text, fallback_html):
    plain = re.sub(r"<[^>]+>", "", html_text)
    if len(plain) <= 980:
        return html_text
    return fallback_html


def split_city_and_period(rest):
    tokens = rest.split()
    period = "today"
    city = []
    i = 0
    while i < len(tokens):
        token = tokens[i]
        t = token.lower().strip(",.;:!?")
        nxt = tokens[i + 1].lower().strip(",.;:!?") if i + 1 < len(tokens) else ""
        if t == "на" and nxt in ("завтра", "tomorrow", "неделю", "неделя", "недели", "week", "7", "семь"):
            period = "tomorrow" if nxt in ("завтра", "tomorrow") else "week"
            i += 2
            continue
        if t in ("завтра", "tomorrow"):
            period = "tomorrow"
        elif t.startswith("недел") or t == "week" or t in ("7", "семь"):
            period = "week"
        elif t in ("дней", "дня", "день") and period == "week":
            pass
        elif t in ("сегодня", "today"):
            period = "today"
        else:
            city.append(token)
        i += 1
    text = " ".join(city).strip(" ,;:")
    if text.lower().endswith(" на"):
        text = text[:-3].rstrip(" ,;:")
    if text.lower() in ("на", "и", "или"):
        text = ""
    return period, text


