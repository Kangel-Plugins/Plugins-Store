def to_class(value: Any):
    if value is None:
        return None
    try:
        if hasattr(value, "getDeclaredMethods"):
            return value
    except Exception:
        pass
    try:
        return value.getClass()
    except Exception:
        return value


def safe(fn: Callable[..., Any]) -> Callable[..., Any]:
    def wrapper(*args, **kwargs):
        try:
            return fn(*args, **kwargs)
        except Exception as exc:
            log(f"[PST] callback error in {getattr(fn, '__name__', fn)}: {exc}")
        return None
    return wrapper


def first_available(*getters: Callable[[], Any]) -> Any:
    for getter in getters:
        try:
            value = getter()
        except Exception:
            continue
        if value is not None:
            return value
    return None


def java_get(obj: Any, name: str) -> Any:
    if obj is None:
        return None
    getter = "get" + name[:1].upper() + name[1:]
    return first_available(
        lambda: getattr(obj, name, None),
        lambda: getattr(obj, getter)(),
    )


def java_items(container: Any) -> List[Any]:
    try:
        count = int(container.size())
    except Exception:
        try:
            count = len(container)
        except Exception:
            return []
    items = []
    for i in range(count):
        item = first_available(lambda: container.get(i), lambda: container[i])
        if item is not None:
            items.append(item)
    return items


def parse_color(hex_code: str) -> int:
    from android.graphics import Color
    return Color.parseColor(hex_code)


def pick_color(theme_key: str, fallback_hex: str) -> int:
    try:
        return Theme.getColor(theme_key)
    except Exception:
        return parse_color(fallback_hex)


def as_java_color(color: int) -> int:
    value = int(color) & 0xFFFFFFFF
    return value - 0x100000000 if value >= 0x80000000 else value


def single_color_state_list(color_state_list_cls: Any, color: int) -> Optional[Any]:
    try:
        from java import jarray, jint
        states = jarray(jarray(jint))([jarray(jint)(0)])
        colors = jarray(jint)([as_java_color(color)])
        return color_state_list_cls(states, colors)
    except Exception as exc:
        log(f"[PST] color state list failed: {exc}")
        return None


def find_drawable(*names: str) -> int:
    for name in names:
        try:
            return getattr(R.drawable, name)
        except Exception:
            continue
    return 0


def attach_press_animation(view, scale: float, listener_sink: List[Any]) -> None:
    if view is None:
        return
    try:
        from java import dynamic_proxy
        from android.view import MotionEvent, View as AndroidView
        try:
            from org.telegram.ui.Components import CubicBezierInterpolator
            press_interpolator = CubicBezierInterpolator.DEFAULT
        except Exception:
            from android.view.animation import DecelerateInterpolator
            press_interpolator = DecelerateInterpolator()
        try:
            from android.view.animation import OvershootInterpolator
            release_interpolator = OvershootInterpolator(2.0)
        except Exception:
            release_interpolator = None

        target_scale = float(scale)

        class PressListener(dynamic_proxy(AndroidView.OnTouchListener)):
            def onTouch(self, view, event):
                try:
                    action = event.getActionMasked()
                    if action == MotionEvent.ACTION_DOWN:
                        try:
                            view.animate().cancel()
                        except Exception:
                            pass
                        anim = view.animate().scaleX(target_scale).scaleY(target_scale).setDuration(90)
                        if press_interpolator is not None:
                            anim.setInterpolator(press_interpolator)
                        anim.start()
                    elif action in (MotionEvent.ACTION_UP,
                                    MotionEvent.ACTION_CANCEL,
                                    MotionEvent.ACTION_OUTSIDE):
                        try:
                            view.animate().cancel()
                        except Exception:
                            pass
                        anim = view.animate().scaleX(1.0).scaleY(1.0).setDuration(260)
                        if release_interpolator is not None:
                            anim.setInterpolator(release_interpolator)
                        anim.start()
                except Exception:
                    pass
                return False

        listener = PressListener()
        view.setOnTouchListener(listener)
        listener_sink.append(listener)
    except Exception as exc:
        log(f"[PST] press animation failed: {exc}")


def language_code(index: int) -> str:
    try:
        return LANGUAGES[index]["code"]
    except Exception:
        return LANGUAGES[DEFAULT_LANGUAGE_INDEX]["code"]


def cache_key(target: str, text: str) -> str:
    return f"{target}\n{text}"


def as_plain_text(value: Any) -> Optional[str]:
    if value is None:
        return None
    try:
        text = str(value)
    except Exception:
        return None
    text = text.strip()
    return text or None


def should_translate(text: Optional[str]) -> bool:
    if not text:
        return False
    if len(text) > 1200:
        return False
    if text.startswith(("tg://", "http://", "https://")):
        return False
    return any(ch.isalpha() for ch in text)


class TranslateState:
    session: Any = None
    last_request: float = 0.0
    cooldown: Dict[str, float] = {}
    bing_params: Optional[Dict[str, str]] = None
    bing_params_time: float = 0.0


def http_session() -> Any:
    if TranslateState.session is None:
        TranslateState.session = requests.Session()
    return TranslateState.session


def provider_blocked(provider: str) -> bool:
    return time.monotonic() < TranslateState.cooldown.get(provider, 0.0)


def block_provider(provider: str) -> None:
    TranslateState.cooldown[provider] = time.monotonic() + TRANSLATE_COOLDOWN
    log(f"[PST] {provider} unavailable, paused for {int(TRANSLATE_COOLDOWN)}s")


def in_cooldown() -> bool:
    return all(provider_blocked(provider) for provider, _ in TRANSLATE_PROVIDERS)


def throttle() -> None:
    with REQUEST_LOCK:
        wait = TRANSLATE_MIN_INTERVAL - (time.monotonic() - TranslateState.last_request)
        if wait > 0:
            time.sleep(wait)
        TranslateState.last_request = time.monotonic()


def retry_delay(response: Any, fallback: float) -> float:
    try:
        return max(fallback, float(response.headers.get("Retry-After")))
    except Exception:
        return fallback


def http_request(method: str, url: str, provider: str, **kwargs: Any) -> Optional[Any]:
    delay = TRANSLATE_RETRY_DELAY

    for attempt in range(TRANSLATE_RETRIES):
        throttle()
        try:
            response = http_session().request(
                method, url, timeout=TRANSLATE_TIMEOUT, **kwargs
            )
        except Exception as exc:
            log(f"[PST] {provider} request failed: {exc}")
            return None

        if response.status_code in (429, 500, 502, 503):
            if attempt == TRANSLATE_RETRIES - 1:
                break
            time.sleep(retry_delay(response, delay))
            delay *= 2
            continue

        if response.status_code != 200:
            log(f"[PST] {provider} http {response.status_code}")
            return None
        return response

    block_provider(provider)
    return None


def bing_params() -> Optional[Dict[str, str]]:
    cached = TranslateState.bing_params
    if cached and time.monotonic() - TranslateState.bing_params_time < BING_TOKEN_TTL:
        return cached

    response = http_request("GET", BING_PAGE_URL, "bing", headers=BING_HEADERS)
    if response is None:
        return None

    page = response.text
    ig = BING_IG_RE.search(page)
    iid = BING_IID_RE.search(page)
    token = BING_TOKEN_RE.search(page)
    if not (ig and iid and token):
        log("[PST] bing tokens not found")
        return None

    TranslateState.bing_params = {
        "ig": ig.group(1),
        "iid": iid.group(1),
        "key": token.group(1),
        "token": token.group(2),
    }
    TranslateState.bing_params_time = time.monotonic()
    return TranslateState.bing_params


def bing_translate(texts: List[str], target: str) -> Optional[List[str]]:
    params = bing_params()
    if params is None:
        return None

    response = http_request(
        "POST", BING_TRANSLATE_URL, "bing",
        headers=BING_HEADERS,
        params={"isVertical": "1", "IG": params["ig"], "IID": params["iid"]},
        data={
            "fromLang": "auto-detect",
            "to": BING_LANG_ALIASES.get(target, target),
            "text": "\n".join(texts),
            "token": params["token"],
            "key": params["key"],
        },
    )
    if response is None:
        return None

    try:
        translated = response.json()[0]["translations"][0]["text"]
    except Exception:
        TranslateState.bing_params = None
        log(f"[PST] bing rejected request: {response.text[:120]}")
        return None

    values = translated.split("\n")
    return values if len(values) == len(texts) else None


def google_translate(texts: List[str], target: str) -> Optional[List[str]]:
    params = [("client", "dict-chrome-ex"), ("sl", "auto"), ("tl", target)]
    params.extend(("q", text) for text in texts)

    response = http_request(
        "GET", GOOGLE_TRANSLATE_URL, "google", headers=GOOGLE_HEADERS, params=params
    )
    if response is None:
        return None

    try:
        data = response.json()
    except Exception as exc:
        log(f"[PST] google response error: {exc}")
        return None
    if not isinstance(data, list) or len(data) != len(texts):
        return None

    values = []
    for entry in data:
        if not isinstance(entry, list) or not entry or not isinstance(entry[0], str):
            return None
        values.append(entry[0])
    return values


TRANSLATE_PROVIDERS = (("bing", bing_translate), ("google", google_translate))


def translate_chunks(texts: List[str]) -> List[List[str]]:
    chunks: List[List[str]] = []
    chunk: List[str] = []
    chars = 0
    for text in texts:
        alone = "\n" in text
        too_many = len(chunk) >= TRANSLATE_CHUNK_SIZE
        too_long = chars + len(text) > TRANSLATE_CHUNK_CHARS
        if chunk and (alone or too_many or too_long):
            chunks.append(chunk)
            chunk = []
            chars = 0
        chunk.append(text)
        chars += len(text)
        if alone:
            chunks.append(chunk)
            chunk = []
            chars = 0
    if chunk:
        chunks.append(chunk)
    return chunks


def provider_translate(
    provider: str,
    translate: Callable[[List[str], str], Optional[List[str]]],
    texts: List[str],
    target: str,
) -> Dict[str, str]:
    values = translate(texts, target)
    if values is not None:
        return dict(zip(texts, values))
    if len(texts) == 1 or provider_blocked(provider):
        return {}

    log(f"[PST] {provider} batch failed, retrying one by one")
    results: Dict[str, str] = {}
    for text in texts:
        if provider_blocked(provider):
            break
        values = translate([text], target)
        if values is None:
            break
        results[text] = values[0]
    return results


def translate_texts(texts: List[str], target: str) -> Dict[str, str]:
    for provider, translate in TRANSLATE_PROVIDERS:
        if provider_blocked(provider):
            continue
        results = provider_translate(provider, translate, texts, target)
        if results:
            return results
    return {}


def run_background(name: str, target: Callable[[], None]) -> None:
    try:
        Thread(target=target, name=name, daemon=True).start()
    except Exception as exc:
        log(f"[PST] background start failed: {exc}")


def is_plugin_settings_fragment(fragment: Any) -> bool:
    try:
        return str(fragment.getClass().getName()).endswith("PluginSettingsActivity")
    except Exception:
        return False


def refresh_fragment_adapter(fragment: Any) -> None:
    list_view = first_available(
        lambda: get_private_field(fragment, "listView"),
        lambda: getattr(fragment, "listView", None),
    )
    if list_view is None:
        return

    adapter = first_available(
        lambda: getattr(list_view, "adapter", None),
        lambda: get_private_field(list_view, "adapter"),
        lambda: list_view.getAdapter(),
    )
    if adapter is None:
        return

    try:
        adapter.update(True)
        return
    except Exception as exc:
        log(f"[PST] adapter.update failed: {exc}")
    try:
        adapter.notifyDataSetChanged()
    except Exception as exc:
        log(f"[PST] notifyDataSetChanged failed: {exc}")


def refresh_plugin_settings() -> None:
    def post():
        fragment = first_available(get_last_fragment)
        if fragment is None or not is_plugin_settings_fragment(fragment):
            return
        refresh_fragment_adapter(fragment)

    try:
        run_on_ui_thread(safe(post))
    except Exception:
        safe(post)()


class PluginSettingsTranslatePlugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self.press_listeners: List[Any] = []
        self.settings_hooks: List[Any] = []
        self.settings_menu_items: List[Any] = []
        self.refresh_token: int = 0

    def on_plugin_load(self):
        self.install_settings_action_button()
        self.install_settings_translation_hook()

    def on_plugin_unload(self):
        from android.view import View

        for unhook in list(self.settings_hooks):
            try:
                self.unhook_method(unhook)
            except Exception:
                pass
        self.settings_hooks.clear()

        for item in list(self.settings_menu_items):
            try:
                item.setVisibility(View.GONE)
            except Exception:
                pass
        self.settings_menu_items.clear()
        self.press_listeners.clear()

    def create_settings(self) -> List[Any]:
        return [
            Header(text="Автоперевод"),
            Switch(
                key=ENABLED_SETTING,
                text="Включить автоперевод",
                subtext="Переводить интерфейс настроек плагинов на выбранный язык",
                default=True,
                icon="msg_translate",
                on_change=self.on_enabled_change,
            ),
            Selector(
                key=TARGET_LANG_SETTING,
                text="Язык автоперевода",
                items=LANGUAGE_DISPLAY,
                default=DEFAULT_LANGUAGE_INDEX,
                icon="msg_language",
                on_change=self.on_target_lang_change,
            ),
        ]

    def on_enabled_change(self, new_value: bool) -> None:
        if not new_value:
            TRANSLATION_CACHE.clear()
            PENDING_TRANSLATIONS.clear()
        refresh_plugin_settings()

    def on_target_lang_change(self, new_index: int) -> None:
        TRANSLATION_CACHE.clear()
        PENDING_TRANSLATIONS.clear()
        refresh_plugin_settings()

    def is_enabled(self) -> bool:
        try:
            return bool(self.get_setting(ENABLED_SETTING, True))
        except Exception:
            return True

    def target_lang_index(self) -> int:
        try:
            index = int(self.get_setting(TARGET_LANG_SETTING, DEFAULT_LANGUAGE_INDEX))
        except Exception:
            index = DEFAULT_LANGUAGE_INDEX
        return max(0, min(index, len(LANGUAGES) - 1))

    def target_lang_code(self) -> str:
        return language_code(self.target_lang_index())

    def install_settings_action_button(self) -> None:
        try:
            activity_cls = find_class("com.exteragram.messenger.plugins.ui.PluginSettingsActivity")
            context_cls = find_class("android.content.Context")
            if activity_cls is None or context_cls is None:
                return
            method = to_class(activity_cls).getDeclaredMethod("createView", to_class(context_cls))
            method.setAccessible(True)
            unhook = self.hook_method(method, SettingsCreateViewHook(self))
            if unhook is not None:
                self.settings_hooks.append(unhook)
        except Exception as exc:
            log(f"[PST] createView hook failed: {exc}")

    def install_settings_translation_hook(self) -> None:
        try:
            activity_cls = find_class("com.exteragram.messenger.plugins.ui.PluginSettingsActivity")
            array_list_cls = find_class("java.util.ArrayList")
            adapter_cls = find_class("org.telegram.ui.Components.UniversalAdapter")
            if activity_cls is None or array_list_cls is None or adapter_cls is None:
                return
            method = to_class(activity_cls).getDeclaredMethod(
                "fillItems", to_class(array_list_cls), to_class(adapter_cls)
            )
            method.setAccessible(True)
            unhook = self.hook_method(method, SettingsFillItemsHook(self))
            if unhook is not None:
                self.settings_hooks.append(unhook)
        except Exception as exc:
            log(f"[PST] fillItems hook failed: {exc}")

    def on_settings_create_view(self, fragment: Any) -> None:
        if fragment is None:
            return

        def add_button():
            action_bar = first_available(lambda: get_private_field(fragment, "actionBar"))
            if action_bar is None:
                return
            menu = action_bar.createMenu()
            if menu is None:
                return

            item = first_available(lambda: menu.getItem(SETTINGS_BUTTON_ID))
            if item is None:
                item = menu.addItem(SETTINGS_BUTTON_ID, find_drawable("msg_language", "msg_translate"))
            try:
                item.setContentDescription("Выбрать язык")
            except Exception:
                pass
            item.setOnClickListener(
                OnClickListener(safe(lambda *args: run_on_ui_thread(safe(self.open_picker))))
            )
            self.settings_menu_items.append(item)

        run_on_ui_thread(safe(add_button))

    def open_picker(self) -> None:
        try:
            fragment = get_last_fragment()
            if not fragment:
                return
            activity = fragment.getParentActivity()
            if not activity:
                return
            LanguagePicker(self, activity).show()
        except Exception as exc:
            log(f"[PST] picker error: {exc}")
            try:
                BulletinHelper.show_simple("Не удалось открыть список языков", R.raw.error)
            except Exception:
                pass

    def translate_settings_items(self, items: Any) -> None:
        if not self.is_enabled():
            return
        target = self.target_lang_code()
        if not target:
            return

        missing: List[str] = []

        def remember(text: Optional[str]) -> None:
            if not should_translate(text):
                return
            key = cache_key(target, text)
            if key in TRANSLATION_CACHE or key in PENDING_TRANSLATIONS or text in missing:
                return
            missing.append(text)

        def translated(text: Optional[str]) -> Optional[str]:
            if not should_translate(text):
                return text
            return TRANSLATION_CACHE.get(cache_key(target, text), text)

        for item in java_items(items):
            self.apply_cached_translation(item, translated, remember)

        if not missing or in_cooldown():
            return
        batch = missing[:TRANSLATE_BATCH_LIMIT]
        for text in batch:
            PENDING_TRANSLATIONS.add(cache_key(target, text))
        run_background(
            "PSTSettingsTranslate",
            lambda: self.load_translations(target, batch),
        )

    def apply_cached_translation(
        self,
        item: Any,
        translated: Callable[[Optional[str]], Optional[str]],
        remember: Callable[[Optional[str]], None],
    ) -> None:
        if item is None:
            return

        setting = getattr(item, "settingItem", None)

        for field in ITEM_TEXT_FIELDS:
            current = as_plain_text(getattr(item, field, None))
            if field == "textValue":
                original = self.original_text_value(setting, item, current)
            else:
                original = self.original_text(setting, field, current)
            if original is None:
                continue

            remember(original)
            new_value = translated(original)
            if new_value and new_value != current:
                try:
                    setattr(item, field, new_value)
                except Exception:
                    pass

        try:
            texts = getattr(item, "texts", None)
            if texts is None:
                return
            originals = self.original_items(setting)
            current_values = [as_plain_text(texts[i]) for i in range(len(texts))]
            new_values = list(current_values)
            changed = False
            for i, current in enumerate(current_values):
                original = originals[i] if originals is not None and i < len(originals) else current
                remember(original)
                new_value = translated(original)
                if new_value and new_value != current:
                    new_values[i] = new_value
                    changed = True
            if changed:
                self.assign_texts(item, new_values)
        except Exception as exc:
            log(f"[PST] selector texts failed: {exc}")

    @staticmethod
    def assign_texts(item: Any, values: List[Optional[str]]) -> None:
        try:
            from java import jarray
            from java.lang import String as JString
            item.texts = jarray(JString)([value if value is not None else "" for value in values])
        except Exception as exc:
            log(f"[PST] texts copy failed: {exc}")

    def original_text_value(self, setting: Any, item: Any, current: Optional[str]) -> Optional[str]:
        if setting is None:
            return None
        if java_get(setting, "items") is None:
            return self.original_text(setting, "subtext", current)

        originals = self.original_items(setting)
        if not originals:
            return None
        try:
            index = int(getattr(item, "intValue", -1))
        except Exception:
            return None
        if index < 0 or index >= len(originals):
            return None
        return originals[index] or None

    def original_text(self, setting: Any, field: str, current: Optional[str]) -> Optional[str]:
        if setting is None:
            return current
        key = self.setting_key(setting)
        if key is None:
            return current
        mapped = ITEM_FIELD_TO_SETTING_FIELD.get(field)
        if mapped is None:
            return current
        bag = ORIGINAL_SETTING_TEXTS.setdefault(key, {})
        if mapped not in bag:
            bag[mapped] = as_plain_text(java_get(setting, mapped))
        return bag.get(mapped)

    def original_items(self, setting: Any) -> Optional[List[str]]:
        if setting is None:
            return None
        key = self.setting_key(setting)
        if key is None:
            return None
        bag = ORIGINAL_SETTING_TEXTS.setdefault(key, {})
        if "items" not in bag:
            values = java_get(setting, "items")
            if values is None:
                return None
            try:
                bag["items"] = [as_plain_text(values[i]) or "" for i in range(len(values))]
            except Exception:
                return None
        return bag.get("items")

    @staticmethod
    def setting_key(setting: Any) -> Optional[str]:
        for attr in ("key", "text"):
            value = as_plain_text(java_get(setting, attr))
            if value:
                try:
                    return f"{type(setting).__name__}:{value}"
                except Exception:
                    return str(value)
        try:
            icon = as_plain_text(java_get(setting, "icon")) or ""
            kind = as_plain_text(java_get(setting, "type")) or type(setting).__name__
            return f"{kind}:#{icon}"
        except Exception:
            return None

    def load_translations(self, target: str, texts: List[str]) -> None:
        try:
            for chunk in translate_chunks(texts):
                if in_cooldown():
                    break
                results = translate_texts(chunk, target)
                if not results:
                    continue
                for text, value in results.items():
                    TRANSLATION_CACHE[cache_key(target, text)] = value
                self.schedule_refresh()
        except Exception as exc:
            log(f"[PST] translation loader error: {exc}")
        finally:
            for text in texts:
                PENDING_TRANSLATIONS.discard(cache_key(target, text))
        self.schedule_refresh()

    def schedule_refresh(self) -> None:
        with REFRESH_LOCK:
            self.refresh_token += 1
            token = self.refresh_token

        def trigger():
            with REFRESH_LOCK:
                if self.refresh_token != token:
                    return
            refresh_plugin_settings()

        try:
            run_on_ui_thread(safe(trigger), TRANSLATE_REFRESH_DEBOUNCE_MS)
        except Exception:
            try:
                run_on_ui_thread(safe(trigger))
            except Exception:
                pass


class SettingsCreateViewHook(MethodHook):
    def __init__(self, plugin: "PluginSettingsTranslatePlugin"):
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            self.plugin.on_settings_create_view(param.thisObject)
        except Exception as exc:
            log(f"[PST] createView hook error: {exc}")


class SettingsFillItemsHook(MethodHook):
    def __init__(self, plugin: "PluginSettingsTranslatePlugin"):
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            if not param.args:
                return
            self.plugin.translate_settings_items(param.args[0])
        except Exception as exc:
            log(f"[PST] fillItems hook error: {exc}")


class LanguagePicker:
    def __init__(self, plugin: "PluginSettingsTranslatePlugin", context: Any):
        self.plugin = plugin
        self.context = context

        self.bg_color        = pick_color(Theme.key_dialogBackground,              FALLBACK_COLORS["bg"])
        self.card_color      = pick_color(Theme.key_windowBackgroundWhite,         FALLBACK_COLORS["card"])
        self.surface_color   = pick_color(Theme.key_windowBackgroundGray,          FALLBACK_COLORS["surface"])
        self.text_primary    = pick_color(Theme.key_dialogTextBlack,               FALLBACK_COLORS["text"])
        self.text_secondary  = pick_color(Theme.key_windowBackgroundWhiteGrayText, FALLBACK_COLORS["text_muted"])
        self.accent          = pick_color(Theme.key_featuredStickers_addButton,    FALLBACK_COLORS["accent"])
        self.radio_unchecked = pick_color(Theme.key_checkboxDisabled,              FALLBACK_COLORS["radio"])

        self.selected_index = plugin.target_lang_index()
        self.rows: Dict[int, Dict[str, Any]] = {}
        self.visible: Dict[int, bool] = {}
        self.header_visible: Dict[str, bool] = {"popular": True, "all": True}
        self.first_filter = True
        self.anim_tokens: Dict[int, int] = {}
        self.filter_token = 0

        self.sheet: Optional[Any] = None
        self.popular_wrap: Any = None
        self.all_wrap: Any = None
        self.popular_header: Any = None
        self.all_header: Any = None

        self.decelerate = self.safe_find("android.view.animation.DecelerateInterpolator")
        self.overshoot = self.safe_find("android.view.animation.OvershootInterpolator")
        self.accelerate = self.safe_find("android.view.animation.AccelerateInterpolator")

    @staticmethod
    def safe_find(path: str):
        try:
            return find_class(path)
        except Exception:
            return None

    def show(self) -> None:
        root = self.build_root()
        self.sheet = BottomSheet(self.context, True)
        try:
            self.sheet.fixNavigationBar(self.bg_color)
        except Exception:
            pass
        try:
            self.sheet.setFocusable(True)
        except Exception:
            pass
        self.sheet.setCustomView(root)
        self.sheet.show()

    def build_root(self):
        from android.widget import LinearLayout

        root = LinearLayout(self.context)
        root.setOrientation(LinearLayout.VERTICAL)
        root.setBackgroundColor(self.bg_color)
        root.setPadding(
            AndroidUtilities.dp(16), AndroidUtilities.dp(14),
            AndroidUtilities.dp(16), AndroidUtilities.dp(14),
        )

        root.addView(self.build_search(), LayoutHelper.createLinear(-1, -2, 0, 0, 0, 12))
        root.addView(self.build_scroll(), LayoutHelper.createLinear(-1, 0, 1.0))
        root.addView(self.build_actions(), LayoutHelper.createLinear(-1, -2, 0, 8, 0, 0))
        return root

    def build_search(self):
        from android.view import Gravity
        from android.util import TypedValue
        from android.widget import EditText, FrameLayout, ImageView, LinearLayout
        from android.graphics.drawable import GradientDrawable
        from android.text import InputType
        try:
            from java import dynamic_proxy
            text_watcher_cls = find_class("android.text.TextWatcher")
        except Exception:
            text_watcher_cls = None
            dynamic_proxy = None

        container = FrameLayout(self.context)
        search_bg = GradientDrawable()
        search_bg.setCornerRadius(AndroidUtilities.dp(SEARCH_CORNER_DP))
        search_bg.setColor(self.surface_color)
        container.setBackground(search_bg)
        container.setPadding(
            AndroidUtilities.dp(14), AndroidUtilities.dp(6),
            AndroidUtilities.dp(14), AndroidUtilities.dp(6),
        )

        row = LinearLayout(self.context)
        row.setOrientation(LinearLayout.HORIZONTAL)
        row.setGravity(Gravity.CENTER_VERTICAL)

        search_icon = ImageView(self.context)
        icon_res = find_drawable("smiles_tab_search", "msg_search")
        if icon_res:
            try:
                from android.graphics import PorterDuff
                search_icon.setImageResource(icon_res)
                search_icon.setColorFilter(self.text_secondary, PorterDuff.Mode.SRC_IN)
            except Exception:
                pass
        row.addView(
            search_icon,
            LayoutHelper.createLinear(20, 20, Gravity.CENTER_VERTICAL, 0, 0, 10, 0),
        )

        search_input = EditText(self.context)
        search_input.setHint("Поиск языка")
        search_input.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 15)
        search_input.setTextColor(self.text_primary)
        search_input.setHintTextColor(self.text_secondary)
        search_input.setSingleLine(True)
        search_input.setInputType(InputType.TYPE_CLASS_TEXT)
        search_input.setBackground(None)
        search_input.setPadding(0, AndroidUtilities.dp(8), 0, AndroidUtilities.dp(8))
        try:
            search_input.setFocusable(True)
            search_input.setFocusableInTouchMode(True)
            search_input.setCursorVisible(True)
            search_input.setImeOptions(IME_ACTION_DONE)
            search_input.setHighlightColor((self.accent & 0x00FFFFFF) | 0x33000000)
        except Exception:
            pass

        def focus_input():
            search_input.requestFocus()
            AndroidUtilities.showKeyboard(search_input)

        search_input.setOnClickListener(OnClickListener(safe(lambda *args: focus_input())))
        row.addView(
            search_input,
            LayoutHelper.createLinear(0, -2, 1.0, Gravity.CENTER_VERTICAL),
        )

        container.setClickable(True)
        container.setFocusable(True)
        container.setOnClickListener(OnClickListener(safe(lambda *args: focus_input())))
        container.addView(row)

        if text_watcher_cls is not None and dynamic_proxy is not None:
            self.install_text_watcher(search_input, text_watcher_cls, dynamic_proxy)

        return container

    def install_text_watcher(self, search_input, text_watcher_cls, dynamic_proxy):
        picker = self

        def schedule_filter(text_value: str):
            picker.filter_token += 1
            token = picker.filter_token

            def run():
                if picker.filter_token == token:
                    picker.apply_filter(text_value)

            run_on_ui_thread(safe(run), 90)

        class Watcher(dynamic_proxy(text_watcher_cls)):
            def beforeTextChanged(self, source, start, count, after):
                pass

            def onTextChanged(self, source, start, before, count):
                pass

            def afterTextChanged(self, editable):
                try:
                    schedule_filter(str(editable.toString()))
                except Exception:
                    pass

        try:
            search_input.addTextChangedListener(Watcher())
        except Exception as exc:
            log(f"[PST] search watcher failed: {exc}")

    def build_scroll(self):
        from android.widget import LinearLayout, ScrollView

        scroll = ScrollView(self.context)
        scroll.setVerticalScrollBarEnabled(False)
        scroll.setFillViewport(True)

        list_container = LinearLayout(self.context)
        list_container.setOrientation(LinearLayout.VERTICAL)
        scroll.addView(list_container)

        popular_entries: List[Dict[str, Any]] = []
        other_entries: List[Dict[str, Any]] = []
        for index, lang in enumerate(LANGUAGES):
            entry = {"index": index, "lang": lang}
            if lang["code"] in POPULAR_CODES:
                popular_entries.append(entry)
            else:
                other_entries.append(entry)
        popular_entries.sort(key=lambda entry: POPULAR_CODES.index(entry["lang"]["code"]))

        popular_icon = find_drawable("filled_rating_crown", "msg_premium_prolfilestar", "msg_stars")
        self.popular_header = self.build_section_header(popular_icon, "Популярные")
        list_container.addView(self.popular_header, LayoutHelper.createLinear(-1, -2))

        self.popular_wrap = LinearLayout(self.context)
        self.popular_wrap.setOrientation(LinearLayout.VERTICAL)
        for entry in popular_entries:
            self.popular_wrap.addView(
                self.build_row(entry["index"], entry["lang"]),
                LayoutHelper.createLinear(-1, -2, 0, 0, 0, 0, ROW_GAP_DP),
            )
        list_container.addView(self.popular_wrap, LayoutHelper.createLinear(-1, -2))

        all_icon = find_drawable("msg_language", "msg_translate")
        self.all_header = self.build_section_header(all_icon, "Все языки")
        list_container.addView(self.all_header, LayoutHelper.createLinear(-1, -2))

        self.all_wrap = LinearLayout(self.context)
        self.all_wrap.setOrientation(LinearLayout.VERTICAL)
        for entry in other_entries:
            self.all_wrap.addView(
                self.build_row(entry["index"], entry["lang"]),
                LayoutHelper.createLinear(-1, -2, 0, 0, 0, 0, ROW_GAP_DP),
            )
        list_container.addView(self.all_wrap, LayoutHelper.createLinear(-1, -2))

        self.install_layout_transition(list_container)
        return scroll

    def install_layout_transition(self, container):
        transition_cls = self.safe_find("android.animation.LayoutTransition")
        if transition_cls is None:
            return
        try:
            transition = transition_cls()
            try:
                transition.setDuration(transition_cls.APPEARING, 260)
                transition.setDuration(transition_cls.DISAPPEARING, 180)
                transition.setDuration(transition_cls.CHANGE_APPEARING, 220)
                transition.setDuration(transition_cls.CHANGE_DISAPPEARING, 220)
            except Exception:
                try:
                    transition.setDuration(220)
                except Exception:
                    pass
            try:
                transition.enableTransitionType(transition_cls.CHANGING)
            except Exception:
                pass
            if self.decelerate is not None:
                try:
                    interpolator = self.decelerate(1.8)
                    transition.setInterpolator(transition_cls.APPEARING, interpolator)
                    transition.setInterpolator(transition_cls.DISAPPEARING, interpolator)
                    transition.setInterpolator(transition_cls.CHANGE_APPEARING, interpolator)
                    transition.setInterpolator(transition_cls.CHANGE_DISAPPEARING, interpolator)
                except Exception:
                    pass
            container.setLayoutTransition(transition)
        except Exception as exc:
            log(f"[PST] layout transition failed: {exc}")

    def build_section_header(self, icon_res: int, title: str):
        from android.view import Gravity
        from android.util import TypedValue
        from android.widget import ImageView, LinearLayout, TextView

        row = LinearLayout(self.context)
        row.setOrientation(LinearLayout.HORIZONTAL)
        row.setGravity(Gravity.CENTER_VERTICAL)
        row.setPadding(
            AndroidUtilities.dp(4), AndroidUtilities.dp(14),
            AndroidUtilities.dp(4), AndroidUtilities.dp(8),
        )

        icon = ImageView(self.context)
        if icon_res:
            try:
                from android.graphics import PorterDuff
                icon.setImageResource(icon_res)
                icon.setColorFilter(self.accent, PorterDuff.Mode.SRC_IN)
            except Exception:
                pass
        row.addView(icon, LayoutHelper.createLinear(16, 16, Gravity.CENTER_VERTICAL, 0, 0, 8, 0))

        title_view = TextView(self.context)
        title_view.setText(title)
        title_view.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 14)
        try:
            title_view.setTypeface(AndroidUtilities.bold())
        except Exception:
            pass
        title_view.setTextColor(self.accent)
        row.addView(title_view, LayoutHelper.createLinear(-2, -2, Gravity.CENTER_VERTICAL))
        return row

    def build_row(self, index: int, lang: Dict[str, str]):
        from android.view import Gravity
        from android.util import TypedValue
        from android.widget import FrameLayout, ImageView, LinearLayout, TextView
        from android.graphics.drawable import GradientDrawable

        row_wrap = FrameLayout(self.context)
        row_wrap.setClickable(True)
        row_wrap.setFocusable(True)

        inner = LinearLayout(self.context)
        inner.setOrientation(LinearLayout.HORIZONTAL)
        inner.setGravity(Gravity.CENTER_VERTICAL)
        inner.setPadding(
            AndroidUtilities.dp(12), AndroidUtilities.dp(10),
            AndroidUtilities.dp(12), AndroidUtilities.dp(10),
        )

        flag_wrap = FrameLayout(self.context)
        flag_bg = GradientDrawable()
        flag_bg.setShape(GradientDrawable.OVAL)
        flag_bg.setColor(self.surface_color)
        flag_wrap.setBackground(flag_bg)

        flag_view = TextView(self.context)
        flag_view.setText(lang["flag"])
        flag_view.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 22)
        flag_view.setGravity(Gravity.CENTER)
        flag_wrap.addView(flag_view, LayoutHelper.createFrame(-1, -1, Gravity.CENTER))
        inner.addView(
            flag_wrap,
            LayoutHelper.createLinear(40, 40, Gravity.CENTER_VERTICAL, 0, 0, 14, 0),
        )

        text_column = LinearLayout(self.context)
        text_column.setOrientation(LinearLayout.VERTICAL)

        name_view = TextView(self.context)
        name_view.setText(lang["name"])
        name_view.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 16)
        try:
            name_view.setTypeface(AndroidUtilities.bold())
        except Exception:
            pass
        name_view.setTextColor(self.text_primary)
        text_column.addView(name_view, LayoutHelper.createLinear(-2, -2))

        sub_view = TextView(self.context)
        sub_view.setText(lang.get("en", lang["name"]))
        sub_view.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13)
        sub_view.setTextColor(self.text_secondary)
        text_column.addView(sub_view, LayoutHelper.createLinear(-2, -2, 0, 2, 0, 0))

        inner.addView(text_column, LayoutHelper.createLinear(0, -2, 1.0, Gravity.CENTER_VERTICAL))

        radio = ImageView(self.context)
        inner.addView(radio, LayoutHelper.createLinear(22, 22, Gravity.CENTER_VERTICAL))

        row_wrap.addView(inner, LayoutHelper.createFrame(-1, -2))
        row_wrap.setOnClickListener(OnClickListener(safe(lambda view, i=index: self.select_index(i))))
        attach_press_animation(row_wrap, 0.97, self.plugin.press_listeners)

        self.rows[index] = {"wrap": row_wrap, "radio": radio, "lang": lang}
        self.paint_row(row_wrap, radio, index == self.selected_index)
        return row_wrap

    def paint_row(self, row_wrap, radio, selected: bool):
        from android.graphics import Color, PorterDuff
        from android.graphics.drawable import GradientDrawable

        row_bg = GradientDrawable()
        row_bg.setCornerRadius(AndroidUtilities.dp(ROW_CORNER_DP))
        row_bg.setColor(self.card_color)
        if selected:
            row_bg.setStroke(AndroidUtilities.dp(2), self.accent)
        row_wrap.setBackground(row_bg)

        radio_bg = GradientDrawable()
        radio_bg.setShape(GradientDrawable.OVAL)
        if selected:
            radio_bg.setColor(self.accent)
            radio.setBackground(radio_bg)
            check_res = find_drawable("ic_ab_done", "msg_check_s")
            if check_res:
                try:
                    radio.setImageResource(check_res)
                    radio.setColorFilter(Color.WHITE, PorterDuff.Mode.SRC_IN)
                except Exception:
                    pass
        else:
            radio_bg.setColor(Color.TRANSPARENT)
            radio_bg.setStroke(AndroidUtilities.dp(2), self.radio_unchecked)
            radio.setBackground(radio_bg)
            radio.setImageDrawable(None)

    def select_index(self, new_index: int) -> None:
        if self.selected_index == new_index:
            return
        self.selected_index = new_index
        for index, row in self.rows.items():
            self.paint_row(row["wrap"], row["radio"], index == new_index)

    def bump_token(self, view) -> int:
        key = id(view)
        token = int(self.anim_tokens.get(key, 0)) + 1
        self.anim_tokens[key] = token
        return token

    def is_latest(self, view, token: int) -> bool:
        return self.anim_tokens.get(id(view), 0) == token

    def animate_show(self, view, order_index: int) -> None:
        from android.view import View
        try:
            view.animate().cancel()
        except Exception:
            pass
        self.bump_token(view)
        try:
            view.setVisibility(View.VISIBLE)
            view.setAlpha(0.0)
            view.setTranslationY(AndroidUtilities.dp(10))
            view.setScaleX(0.96)
            view.setScaleY(0.96)
            anim = view.animate() \
                .alpha(1.0).translationY(0.0) \
                .scaleX(1.0).scaleY(1.0) \
                .setDuration(260).setStartDelay(int(order_index) * 22)
            if self.overshoot is not None:
                try:
                    anim.setInterpolator(self.overshoot(0.9))
                except Exception:
                    if self.decelerate is not None:
                        try:
                            anim.setInterpolator(self.decelerate(1.6))
                        except Exception:
                            pass
            anim.start()
        except Exception:
            pass

    def animate_hide(self, view, order_index: int, delay_base: int = 14) -> None:
        from android.view import View
        try:
            view.animate().cancel()
        except Exception:
            pass
        token = self.bump_token(view)
        try:
            anim = view.animate() \
                .alpha(0.0).translationY(-AndroidUtilities.dp(6)) \
                .scaleX(0.94).scaleY(0.94) \
                .setDuration(160).setStartDelay(int(order_index) * int(delay_base))
            if self.accelerate is not None:
                try:
                    anim.setInterpolator(self.accelerate(1.4))
                except Exception:
                    pass

            def finalize():
                if not self.is_latest(view, token):
                    return
                view.setVisibility(View.GONE)
                view.setAlpha(1.0)
                view.setTranslationY(0.0)
                view.setScaleX(1.0)
                view.setScaleY(1.0)

            run_on_ui_thread(safe(finalize), 160 + int(order_index) * int(delay_base) + 20)
            anim.start()
        except Exception:
            pass

    def set_header_visibility(self, view, key: str, want_visible: bool, animate: bool) -> None:
        from android.view import View

        if self.header_visible.get(key, True) == want_visible:
            if want_visible:
                try:
                    view.setVisibility(View.VISIBLE)
                    view.setAlpha(1.0)
                    view.setTranslationY(0.0)
                except Exception:
                    pass
            return

        self.header_visible[key] = want_visible
        if not animate:
            try:
                view.setVisibility(View.VISIBLE if want_visible else View.GONE)
                view.setAlpha(1.0)
                view.setTranslationY(0.0)
                view.setScaleX(1.0)
                view.setScaleY(1.0)
            except Exception:
                pass
        elif want_visible:
            self.animate_show(view, 0)
        else:
            self.animate_hide(view, 0, delay_base=0)

    def apply_filter(self, query: str) -> None:
        from android.view import View

        needle = (query or "").strip().lower()
        any_popular = False
        any_other = False
        shown_order = 0
        hidden_order = 0
        first = self.first_filter

        for index, row in self.rows.items():
            lang = row["lang"]
            wrap = row["wrap"]
            visible = True
            if needle:
                haystack = f"{lang['name']} {lang.get('en', '')} {lang['code']}".lower()
                visible = needle in haystack
            was_visible = self.visible.get(index, True)

            if visible:
                if lang["code"] in POPULAR_CODES:
                    any_popular = True
                else:
                    any_other = True

            self.visible[index] = visible

            if visible == was_visible and not first:
                if visible:
                    try:
                        wrap.setVisibility(View.VISIBLE)
                    except Exception:
                        pass
                continue

            if first:
                try:
                    wrap.setVisibility(View.VISIBLE if visible else View.GONE)
                    wrap.setAlpha(1.0)
                    wrap.setTranslationY(0.0)
                    wrap.setScaleX(1.0)
                    wrap.setScaleY(1.0)
                except Exception:
                    pass
            elif visible:
                self.animate_show(wrap, shown_order)
                shown_order += 1
            else:
                self.animate_hide(wrap, hidden_order)
                hidden_order += 1

        self.set_header_visibility(self.popular_header, "popular", any_popular, not first)
        self.set_header_visibility(self.all_header, "all", any_other, not first)

        try:
            self.popular_wrap.setVisibility(View.VISIBLE if any_popular else View.GONE)
            self.all_wrap.setVisibility(View.VISIBLE if any_other else View.GONE)
        except Exception:
            pass

        self.first_filter = False

    def build_actions(self):
        from android.view import Gravity
        from android.widget import LinearLayout

        actions = LinearLayout(self.context)
        actions.setOrientation(LinearLayout.HORIZONTAL)
        actions.setPadding(0, AndroidUtilities.dp(10), 0, 0)

        cancel_icon = find_drawable("msg_cancel", "msg_close", "ic_close_white", "ic_ab_back")
        reset_icon = find_drawable("msg_reset", "msg_reset_solar", "msg_reset_remix")
        apply_icon = find_drawable("ic_ab_done", "msg_check_s")

        actions.addView(
            self.build_action("Отмена", cancel_icon, False, self.on_cancel),
            LayoutHelper.createLinear(0, -2, 1.0, Gravity.CENTER_VERTICAL, 0, 0, 8, 0),
        )
        actions.addView(
            self.build_action("Оригинал", reset_icon, False, self.on_reset),
            LayoutHelper.createLinear(0, -2, 1.0, Gravity.CENTER_VERTICAL, 0, 0, 8, 0),
        )
        actions.addView(
            self.build_action("Применить", apply_icon, True, self.on_apply),
            LayoutHelper.createLinear(0, -2, 1.2, Gravity.CENTER_VERTICAL),
        )
        return actions

    def build_action(self, label: str, icon_res: int, filled: bool, on_click: Callable[[], None]):
        from android.view import Gravity
        from android.util import TypedValue
        from android.widget import FrameLayout, ImageView, LinearLayout, TextView
        from android.graphics import Color
        from android.graphics.drawable import GradientDrawable
        from android.text import TextUtils
        try:
            from android.graphics.drawable import RippleDrawable
            from android.content.res import ColorStateList
        except Exception:
            RippleDrawable = None
            ColorStateList = None

        button = FrameLayout(self.context)
        try:
            button.setMinimumHeight(AndroidUtilities.dp(48))
        except Exception:
            pass

        base_bg = GradientDrawable()
        base_bg.setCornerRadius(AndroidUtilities.dp(BUTTON_CORNER_DP))
        base_bg.setColor(self.accent if filled else self.surface_color)

        ripple_list = None
        if RippleDrawable is not None and ColorStateList is not None:
            ripple_color = ((Color.WHITE & 0x00FFFFFF) | 0x33000000) if filled \
                else ((self.accent & 0x00FFFFFF) | 0x40000000)
            ripple_list = single_color_state_list(ColorStateList, ripple_color)
        if ripple_list is not None:
            button.setBackground(RippleDrawable(ripple_list, base_bg, None))
        else:
            button.setBackground(base_bg)

        row = LinearLayout(self.context)
        row.setOrientation(LinearLayout.HORIZONTAL)
        row.setGravity(Gravity.CENTER)
        row.setPadding(
            AndroidUtilities.dp(10), AndroidUtilities.dp(11),
            AndroidUtilities.dp(10), AndroidUtilities.dp(11),
        )

        if icon_res:
            try:
                from android.graphics import PorterDuff
                icon = ImageView(self.context)
                icon.setImageResource(icon_res)
                icon.setColorFilter(
                    Color.WHITE if filled else self.text_primary,
                    PorterDuff.Mode.SRC_IN,
                )
                row.addView(icon, LayoutHelper.createLinear(16, 16, Gravity.CENTER_VERTICAL, 0, 0, 6, 0))
            except Exception:
                pass

        label_view = TextView(self.context)
        label_view.setText(label)
        label_view.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 14)
        try:
            label_view.setSingleLine(True)
            label_view.setMaxLines(1)
            label_view.setEllipsize(TextUtils.TruncateAt.END)
            label_view.setIncludeFontPadding(False)
            label_view.setTypeface(AndroidUtilities.bold())
        except Exception:
            pass
        label_view.setTextColor(Color.WHITE if filled else self.text_primary)
        row.addView(label_view, LayoutHelper.createLinear(-2, -2, Gravity.CENTER_VERTICAL))

        button.addView(row, LayoutHelper.createFrame(-2, -2, Gravity.CENTER))
        button.setClickable(True)
        button.setFocusable(True)
        button.setOnClickListener(OnClickListener(safe(lambda view: on_click())))
        attach_press_animation(button, 0.95, self.plugin.press_listeners)
        return button

    def dismiss(self) -> None:
        try:
            if self.sheet is not None:
                self.sheet.dismiss()
        except Exception:
            pass

    def on_cancel(self) -> None:
        self.dismiss()

    def on_reset(self) -> None:
        try:
            TRANSLATION_CACHE.clear()
            PENDING_TRANSLATIONS.clear()
            self.plugin.set_setting(ENABLED_SETTING, False, reload_settings=True)
            refresh_plugin_settings()
            self.dismiss()
            BulletinHelper.show_simple("Оригинальный язык восстановлен", R.raw.info)
        except Exception as exc:
            log(f"[PST] reset failed: {exc}")

    def on_apply(self) -> None:
        try:
            lang = LANGUAGES[self.selected_index]
            TRANSLATION_CACHE.clear()
            PENDING_TRANSLATIONS.clear()
            self.plugin.set_setting(TARGET_LANG_SETTING, self.selected_index)
            self.plugin.set_setting(ENABLED_SETTING, True, reload_settings=True)
            refresh_plugin_settings()
            self.dismiss()
            BulletinHelper.show_simple(
                f"Язык: {lang['flag']} {lang['name']}",
                R.raw.msg_translate,
            )
        except Exception as exc:
            log(f"[PST] apply failed: {exc}")
