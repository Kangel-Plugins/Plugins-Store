# ════════════════════════════════════════════════════════════════════
#  Движок: работа с цветами темы
# ════════════════════════════════════════════════════════════════════

THEME = "org.telegram.ui.ActionBar.Theme"


class _ApplyCommonThemeHook(MethodHook):
    """Перед Theme.applyCommonTheme() заново кладём свои цвета в тему:
    так изменения переживают смену темы, ночной режим и т.п."""

    def __init__(self, engine):
        super().__init__()
        self.engine = engine

    def before_hooked_method(self, param):
        try:
            self.engine.reapply_quick()
        except Exception:
            log_exc("hook")

    def after_hooked_method(self, param):
        pass


class _PinnedFillHook(MethodHook):
    """В новых версиях Telegram заливка закреплённых чатов отключена в самом
    коде. Если пользователь задал chats_pinnedOverlay — рисуем её сами
    (под содержимым ячейки, поверх её фона)."""

    def __init__(self, engine):
        super().__init__()
        self.engine = engine
        self.paint = None

    def before_hooked_method(self, param):
        try:
            color = self.engine.overrides.get("chats_pinnedOverlay")
            if color is None or c_a(color) == 0:
                return
            cell = param.thisObject
            if cell is None or not bool(cell.getIsPinned()):
                return
            if self.paint is None:
                self.paint = J("android.graphics.Paint")()
            self.paint.setColor(ji(color))
            canvas = param.args[0]
            canvas.drawRect(0.0, 0.0, float(cell.getMeasuredWidth()), float(cell.getMeasuredHeight()), self.paint)
        except Exception:
            log_exc("pinned fill")

    def after_hooked_method(self, param):
        pass


class _ChatThemeHook(MethodHook):
    """У чатов со своей темой (обои/цвета чата) цвета берутся из отдельной
    таблицы ThemeDelegate. После её заполнения дописываем туда наши цвета,
    иначе при повторном входе в чат изменения «откатываются»."""

    def __init__(self, engine):
        super().__init__()
        self.engine = engine

    def before_hooked_method(self, param):
        pass

    def after_hooked_method(self, param):
        try:
            self.engine.patch_delegate(param.thisObject)
        except Exception:
            log_exc("chat theme hook")


class Engine:
    def __init__(self, plugin):
        self.plugin = plugin
        self.overrides = {}          # name -> u32
        self._names = None           # index -> name
        self._ids = {}               # name -> index
        self._orig_defaults = {}     # kid -> исходное значение defaultColors[kid]
        self._hook = None
        self.hook_ok = False
        self._preview = None         # (kid, present, value) для отмены
        self._blink_token = 0
        self._blink_state = None
        self.dirty = False
        self.anims = {}              # name -> {speed, phase, s, v, a}  (живые)
        self.anims_saved = {}        # то, что записано в настройках
        self._anim_token = 0
        self._anim_running = False
        self._anim_paused = False
        self._anim_owner = False     # мы включили Theme.animatingColors
        self.screen = {"title": "", "keys": [], "descs": [], "fragments": []}

    # ── ключи ──
    @property
    def T(self):
        return J(THEME)

    def names(self):
        if self._names is None:
            TC = J("org.telegram.ui.ActionBar.ThemeColors")
            count = int(self.T.colorsCount)
            names = []
            for i in range(count):
                n = None
                try:
                    n = TC.getStringName(i)
                except Exception:
                    n = None
                names.append(str(n) if n is not None else None)
            self._names = names
            self._ids = {n: i for i, n in enumerate(names) if n}
        return self._names

    def all_keys(self):
        return [n for n in self.names() if n and n not in NON_COLOR_KEYS]

    def key_id(self, name):
        self.names()
        kid = self._ids.get(name, -1)
        if kid < 0:
            try:
                kid = int(J("org.telegram.ui.ActionBar.ThemeColors").stringKeyToInt(name))
            except Exception:
                kid = -1
        return kid

    def name_of(self, kid):
        names = self.names()
        if 0 <= kid < len(names):
            return names[kid]
        return None

    def get(self, kid):
        """Цвет ключа без учёта перелива/мигания (то, что сохранится)."""
        try:
            return u32(self.T.getColor(int(kid), None, True))
        except Exception:
            pass
        try:
            return u32(self.T.getColor(int(kid)))
        except Exception:
            return 0xFFFF00FF

    # ── хранение ──
    def load(self):
        raw = self.plugin.get_setting("overrides", "{}")
        data = {}
        try:
            data = json.loads(raw) if raw else {}
        except Exception:
            data = {}
        self.overrides = {}
        for k, v in data.items():
            c = parse_color(v) if isinstance(v, str) else (u32(v) if isinstance(v, int) else None)
            if c is not None:
                self.overrides[str(k)] = c

    def save(self):
        data = {k: hex_color(v) for k, v in sorted(self.overrides.items())}
        self.plugin.set_setting("overrides", json.dumps(data))

    # ── низкий уровень ──
    def _current_colors(self):
        return get_static(THEME, "currentColors")

    def _read_default_raw(self, kid):
        arr = get_static(THEME, "defaultColors")
        if arr is not None:
            try:
                return int(arr[kid])
            except Exception:
                pass
        try:
            return int(self.T.getDefaultColor(int(kid)))
        except Exception:
            return 0

    def _put(self, kid, color):
        """Поставить цвет ключу (в текущие цвета темы и в дефолтные —
        чтобы работало и на стандартной теме, где currentColors игнорируется)."""
        if kid < 0:
            return
        c = s32(color)
        try:
            self.T.setColor(int(kid), c, False)
        except Exception:
            log_exc("setColor")
        if kid not in self._orig_defaults:
            self._orig_defaults[kid] = self._read_default_raw(kid)
        try:
            self.T.setDefaultColor(int(kid), c)
        except Exception:
            pass

    def _restore_default(self, kid):
        if kid in self._orig_defaults:
            raw = self._orig_defaults.pop(kid)
            try:
                self.T.setDefaultColor(int(kid), int(raw))
            except Exception:
                pass

    def reapply_quick(self):
        """Вызывается из хука: только положить цвета, без побочных эффектов."""
        if not self.overrides:
            return
        cc = self._current_colors()
        for name, color in self.overrides.items():
            kid = self.key_id(name)
            if kid < 0:
                continue
            if cc is not None:
                try:
                    cc.put(int(kid), s32(color))
                    continue
                except Exception:
                    cc = None
            try:
                self.T.setColor(int(kid), s32(color), False)
            except Exception:
                pass

    def reapply_all(self):
        for name, color in self.overrides.items():
            self._put(self.key_id(name), color)

    # ── хук ──
    def install_hook(self):
        try:
            cls = java_class_of(THEME)
            m = cls.getDeclaredMethod("applyCommonTheme")
            m.setAccessible(True)
            self._hook = self.plugin.hook_method(m, _ApplyCommonThemeHook(self))
            self.hook_ok = self._hook is not None
        except Exception:
            log_exc("install_hook")
            self.hook_ok = False

    def install_chat_theme_hook(self):
        self._chat_hooks = None
        try:
            cls = java_class_of("org.telegram.ui.ChatActivity$ThemeDelegate")
            self._chat_hooks = self.plugin.hook_all_methods(cls, "setupChatTheme", _ChatThemeHook(self))
        except Exception:
            log_exc("install_chat_theme_hook")

    def patch_delegate(self, td):
        """Положить наши цвета в таблицу темы чата (если у чата своя тема)."""
        if td is None or not self.overrides:
            return False
        if get_field(td, "chatTheme") is None:
            return False          # обычный чат берёт цвета из общей темы
        cc = get_field(td, "currentColors")
        if cc is None:
            return False
        for name, color in self.overrides.items():
            kid = self.key_id(name)
            if kid >= 0:
                try:
                    cc.put(int(kid), s32(color))
                except Exception:
                    return False
        return True

    def chat_fragments(self):
        out = []
        try:
            act = get_activity()
            layout = act.getActionBarLayout() if act is not None else None
            if layout is None:
                return out
            ChatC = java_class_of("org.telegram.ui.ChatActivity")
            stack = layout.getFragmentStack()
            for i in range(int(stack.size())):
                f = stack.get(i)
                if f is not None and ChatC.isInstance(f):
                    out.append(f)
        except Exception:
            log_exc("chat_fragments")
        return out

    def resync_chat_delegates(self):
        """Пересобрать таблицы открытых чатов со своей темой: цвета темы чата + наши."""
        for f in self.chat_fragments():
            try:
                td = get_field(f, "themeDelegate")
                if td is None:
                    continue
                theme = get_field(td, "chatTheme")
                if theme is None:
                    continue
                try:
                    acc = int(f.getCurrentAccount())
                    dark = bool(get_field(td, "isDark"))
                    fresh = theme.createColors(acc, 1 if dark else 0)
                    if fresh is not None:
                        set_field(td, "currentColors", fresh)
                except Exception:
                    pass
                self.patch_delegate(td)
            except Exception:
                log_exc("resync delegate")

    def install_pinned_hook(self):
        try:
            cls = java_class_of("org.telegram.ui.Cells.DialogCell")
            m = cls.getDeclaredMethod("onDraw", java_class_of("android.graphics.Canvas"))
            m.setAccessible(True)
            self._pin_hook = self.plugin.hook_method(m, _PinnedFillHook(self))
        except Exception:
            log_exc("install_pinned_hook")
            self._pin_hook = None

    def remove_hook(self):
        ch = getattr(self, "_chat_hooks", None)
        if ch:
            for u in (ch if isinstance(ch, (list, tuple)) else [ch]):
                try:
                    self.plugin.unhook_method(u)
                except Exception:
                    pass
            self._chat_hooks = None
        pin = getattr(self, "_pin_hook", None)
        if pin is not None:
            try:
                self.plugin.unhook_method(pin)
            except Exception:
                pass
            self._pin_hook = None
        if self._hook is not None:
            try:
                self.plugin.unhook_method(self._hook)
            except Exception:
                pass
            self._hook = None
            self.hook_ok = False

    # ── обновление интерфейса ──
    def refresh_theme(self):
        """Пересобрать цвета темы (хук вернёт наши изменения) и обновить UI."""
        T = self.T
        # дефолтные цвета (нужны стандартной теме) переживают refresh сами
        self.reapply_all()
        try:
            T.refreshThemeColors(False, True)
        except Exception:
            try:
                T.refreshThemeColors()
            except Exception:
                log_exc("refreshThemeColors")
        if not self.hook_ok:
            self.reapply_all()
            for fn in ("applyCommonTheme", "applyDialogsTheme", "applyProfileTheme"):
                try:
                    getattr(T, fn)()
                except Exception:
                    pass
            try:
                T.applyChatTheme(False, False)
            except Exception:
                pass
        self.resync_chat_delegates()
        self.refresh_views(None)
        self.rebuild_hidden()

    def rebuild_hidden(self):
        try:
            act = get_activity()
            layout = act.getActionBarLayout() if act is not None else None
            if layout is not None:
                layout.rebuildAllFragmentViews(False, False)
        except Exception:
            log_exc("rebuild_hidden")

    def rebuild_all(self):
        try:
            act = get_activity()
            layout = act.getActionBarLayout() if act is not None else None
            if layout is not None:
                layout.rebuildAllFragmentViews(True, True)
        except Exception:
            log_exc("rebuild_all")

    def visible_fragments(self):
        LA = J("org.telegram.ui.LaunchActivity")
        frags = []
        seen = set()
        System = J("java.lang.System")
        for getter in ("getLastFragmentIncludeMainTabs", "getLastFragment"):
            try:
                f = getattr(LA, getter)()
            except Exception:
                f = None
            if f is None:
                continue
            try:
                hid = int(System.identityHashCode(f))
            except Exception:
                hid = id(f)
            if hid not in seen:
                seen.add(hid)
                frags.append(f)
        return frags

    def descriptions(self, fragment):
        out = []
        try:
            arr = fragment.getThemeDescriptions()
        except Exception:
            log_exc("getThemeDescriptions")
            arr = None
        if arr is None:
            return out
        try:
            n = int(arr.size())
            for i in range(n):
                d = arr.get(i)
                if d is None:
                    continue
                try:
                    out.append((int(d.getCurrentKey()), d))
                except Exception:
                    pass
        except Exception:
            log_exc("descriptions iterate")
        return out

    def snapshot_screen(self):
        frags = self.visible_fragments()
        descs = []
        keys = []
        seen = set()
        title = ""
        for f in frags:
            if not title:
                try:
                    title = str(f.getClass().getSimpleName())
                except Exception:
                    title = ""
            for kid, d in self.descriptions(f):
                descs.append((kid, d))
                n = self.name_of(kid)
                if n and n not in seen and n not in NON_COLOR_KEYS:
                    seen.add(n)
                    keys.append(n)
        self.screen = {"title": title, "keys": keys, "descs": descs, "fragments": frags}
        return self.screen

    def descs_for(self, kid):
        return [d for k, d in self.screen.get("descs", []) if k == kid]

    def apply_descs(self, kid, color=None):
        c = self.get(kid) if color is None else color
        for d in self.descs_for(kid):
            try:
                d.setColor(s32(c), False, False)
            except Exception:
                pass

    def refresh_views(self, kids=None):
        try:
            if not self.screen.get("descs"):
                self.snapshot_screen()
            for kid, d in self.screen.get("descs", []):
                if kids is not None and kid not in kids:
                    continue
                try:
                    d.setColor(s32(self.get(kid)), False, False)
                except Exception:
                    pass
        except Exception:
            log_exc("refresh_views")
        self.invalidate_all()

    def invalidate_all(self):
        act = get_activity()
        if act is None:
            return
        try:
            invalidate_tree(act.getWindow().getDecorView())
        except Exception:
            log_exc("invalidate_all")

    # ── редактирование ──
    def begin_preview(self, kid):
        present, value = None, None
        cc = self._current_colors()
        if cc is not None:
            try:
                idx = int(cc.indexOfKey(int(kid)))
                present = idx >= 0
                value = int(cc.valueAt(idx)) if present else 0
            except Exception:
                present = None
        self._preview = (kid, present, value)

    def preview(self, kid, color, final=False):
        name = self.name_of(kid)
        if name in WALLPAPER_KEYS and not final:
            return
        self.stop_blink()
        self.dirty = True
        self._put(kid, color)
        if final:
            for f in self.chat_fragments():
                td = get_field(f, "themeDelegate")
                cc = get_field(td, "currentColors") if td is not None and get_field(td, "chatTheme") is not None else None
                if cc is not None:
                    try:
                        cc.put(int(kid), s32(color))
                    except Exception:
                        pass
        self.apply_descs(kid, color)
        if final:
            self.invalidate_all()

    def cancel_preview(self):
        if self._preview is None:
            return
        kid, present, value = self._preview
        self._preview = None
        name = self.name_of(kid)
        if name in self.overrides:
            self._put(kid, self.overrides[name])
        elif present is None:
            self._restore_default(kid)
            self.refresh_theme()
            return
        else:
            try:
                if present:
                    self.T.setColor(int(kid), int(value), False)
                else:
                    self.T.setColor(int(kid), 0, True)
            except Exception:
                log_exc("cancel setColor")
            self._restore_default(kid)
        self.resync_chat_delegates()
        self.apply_descs(kid)
        self.invalidate_all()

    def commit(self, kid, color):
        name = self.name_of(kid)
        if not name:
            return
        self._preview = None
        self.dirty = True
        self.overrides[name] = u32(color)
        self.save()
        self._put(kid, color)
        self.resync_chat_delegates()
        self.apply_descs(kid, color)
        self.invalidate_all()

    def remove_override(self, name, refresh=True):
        if name not in self.overrides:
            return
        self.overrides.pop(name, None)
        self.dirty = True
        self.save()
        kid = self.key_id(name)
        self._restore_default(kid)
        if refresh:
            self.refresh_theme()

    def reset_all(self):
        self.anims = {}
        self.anims_saved = {}
        self.save_anims()
        self._anim_sync()
        if self.overrides:
            data = {k: hex_color(v) for k, v in sorted(self.overrides.items())}
            self.plugin.set_setting("overrides_backup", json.dumps(data))
        self.overrides = {}
        self.dirty = True
        self.save()
        for kid in list(self._orig_defaults.keys()):
            self._restore_default(kid)
        self.refresh_theme()

    def restore_everything(self):
        """При выгрузке плагина: вернуть тему как была."""
        self.anim_halt()
        self.remove_hook()
        for kid in list(self._orig_defaults.keys()):
            self._restore_default(kid)
        try:
            self.T.refreshThemeColors(False, True)
        except Exception:
            try:
                self.T.refreshThemeColors()
            except Exception:
                pass
        if is_ui_thread():
            try:
                self.refresh_views(None)
                self.rebuild_hidden()
            except Exception:
                pass

    # ── RGB-перелив ──
    def anim_fps(self):
        try:
            i = int(self.plugin.get_setting("anim_fps", 1) or 0)
        except Exception:
            i = 1
        return (10, 20, 30)[max(0, min(2, i))]

    @staticmethod
    def clean_anim(v):
        def f(x, lo, hi, d):
            try:
                return max(lo, min(hi, float(x)))
            except Exception:
                return d
        return {"speed": f(v.get("speed"), 10, 360, 90), "phase": f(v.get("phase"), 0, 360, 0),
                "s": f(v.get("s"), 0, 1, 1), "v": f(v.get("v"), 0, 1, 1),
                "a": int(f(v.get("a"), 0, 255, 255))}

    def load_anims(self):
        raw = self.plugin.get_setting("anims", "{}")
        try:
            data = json.loads(raw) if raw else {}
        except Exception:
            data = {}
        self.anims = {}
        for k, v in data.items():
            if isinstance(v, dict) and str(k) not in WALLPAPER_KEYS and str(k) not in NON_COLOR_KEYS:
                self.anims[str(k)] = self.clean_anim(v)
        self.anims_saved = {k: dict(v) for k, v in self.anims.items()}

    def save_anims(self):
        self.plugin.set_setting("anims", json.dumps(self.anims_saved))

    def anim_set(self, name, cfg, persist=False):
        """Включить/обновить перелив ключа (cfg=None — выключить)."""
        if name in WALLPAPER_KEYS or name in NON_COLOR_KEYS:
            return False
        if cfg is None:
            self.anims.pop(name, None)
            if persist:
                self.anims_saved.pop(name, None)
                self.save_anims()
            self._anim_sync()
            return True
        self.anims[name] = self.clean_anim(cfg)
        if persist:
            self.anims_saved[name] = dict(self.anims[name])
            self.save_anims()
        self.anim_kick()
        return True

    def anim_revert(self, name):
        saved = self.anims_saved.get(name)
        if saved is None:
            if name in self.anims:
                self.anims.pop(name, None)
                self._anim_sync()
        else:
            self.anims[name] = dict(saved)
            self.anim_kick()

    def anim_clear_all(self):
        names = list(self.anims)
        self.anims = {}
        self.anims_saved = {}
        self.save_anims()
        self._anim_sync()
        return len(names)

    def anim_ribbon(self, names, speed=90.0, step=28.0):
        """«RGB-лента»: радуга по ключам со сдвигом фазы — цвет бежит по элементам."""
        n = 0
        for name in names:
            kid = self.key_id(name)
            if kid < 0 or name in WALLPAPER_KEYS or name in NON_COLOR_KEYS:
                continue
            c = self.get(kid)
            h, sat, val = color_hsv(c)
            self.anims[name] = self.clean_anim({
                "speed": speed, "phase": (n * step) % 360.0,
                "s": max(sat, 0.75), "v": max(val, 0.85), "a": c_a(c) or 255})
            self.anims_saved[name] = dict(self.anims[name])
            n += 1
        if n:
            self.save_anims()
            self.anim_kick()
        return n

    def anim_pause(self, paused):
        self._anim_paused = bool(paused)
        if paused:
            self._anim_token += 1
            self._anim_running = False
        else:
            self.anim_kick()

    def anim_kick(self):
        if not self.anims:
            self._anim_sync()
            return
        if self._anim_running or self._anim_paused:
            return
        self._anim_running = True
        self._anim_token += 1
        token = self._anim_token
        self._anim_tick(token, 0)

    def _anim_tick(self, token, n):
        if token != self._anim_token:
            return
        try:
            if not self.anims:
                self._anim_running = False
                return
            T = self.T
            if not T.isAnimatingColor():
                T.setAnimatingColor(True)
                self._anim_owner = True
            if n % 30 == 0:
                self.snapshot_screen()      # экран мог смениться
            now = time.time()
            for name, cfg in list(self.anims.items()):
                kid = self.key_id(name)
                if kid < 0:
                    continue
                hue = (now * cfg["speed"] + cfg["phase"]) % 360.0
                c = hsv_color(hue, cfg["s"], cfg["v"], cfg["a"])
                T.setAnimatedColor(int(kid), s32(c))
                self.apply_descs(kid, c)
            if n % 2 == 0:
                self.invalidate_all()
        except Exception:
            log_exc("anim tick")
        post_ui(lambda: self._anim_tick(token, n + 1), int(1000 / self.anim_fps()))

    def _anim_sync(self):
        """Пересоздать таблицу анимированных цветов только из живых переливов."""
        self._anim_token += 1
        self._anim_running = False
        try:
            self.T.setAnimatingColor(False)
        except Exception:
            pass
        self._anim_owner = False
        if self.anims and not self._anim_paused:
            self.anim_kick()
        else:
            try:
                self.refresh_views(None)
            except Exception:
                pass

    def anim_halt(self):
        self.anims = {}
        self._anim_sync()

    # ── мигание: показать, где ключ ──
    def blink(self, kid, times=6, interval=260, on_end=None):
        self.stop_blink()
        self._blink_token += 1
        token = self._blink_token
        T = self.T
        orig = self.get(kid)
        hi = highlight_for(orig)
        use_anim = False
        try:
            if not T.isAnimatingColor():
                T.setAnimatingColor(True)
                use_anim = True
        except Exception:
            use_anim = False
        self._blink_state = (kid, use_anim)

        def step(i):
            if token != self._blink_token:
                return
            if i >= times:
                self.stop_blink()
                if on_end:
                    on_end()
                return
            c = hi if i % 2 == 0 else orig
            try:
                T.setAnimatedColor(int(kid), s32(c))
            except Exception:
                pass
            self.apply_descs(kid, c)
            self.invalidate_all()
            post_ui(lambda: step(i + 1), interval)

        step(0)

    def stop_blink(self):
        st = self._blink_state
        if st is None:
            return
        self._blink_state = None
        self._blink_token += 1
        kid, use_anim = st
        if self.anims:
            # таблицу делит перелив: пересоберём её, чтобы не осталось следов мигания
            self._anim_sync()
        elif use_anim:
            try:
                self.T.setAnimatingColor(False)
            except Exception:
                pass
        self.apply_descs(kid)
        self.invalidate_all()

    # ── геометрия: где на экране элементы ключа ──
    def desc_views(self, d, cache=None):
        """Вью, которые красит ThemeDescription (повторяет его логику)."""
        out = []
        view = get_field(d, "viewToInvalidate")
        if view is None:
            return out
        classes = get_field(d, "listClasses")
        if classes is None or len(classes) == 0:
            out.append(view)
            return out
        fields = get_field(d, "listClassesFieldName")
        flags = as_int(get_field(d, "changeFlags"), 0)
        kid = as_int(d.getCurrentKey(), -1)
        if cache is not None:
            vid = ident(view)
            cands = cache.get(vid)
            if cands is None:
                cands = [view] + children_of(view, 120)
                cache[vid] = cands
        else:
            cands = [view] + children_of(view, 120)
        ViewC = java_class_of("android.view.View")
        for child in cands:
            for b in range(len(classes)):
                cls = classes[b]
                if cls is None:
                    continue
                try:
                    if not cls.isInstance(child):
                        continue
                except Exception:
                    continue
                if (u32(flags) & 0x00040000) and as_int(child.getTag(), -999) != kid:
                    continue
                target = child
                if fields is not None and b < len(fields) and fields[b] is not None:
                    fv = get_field(child, str(fields[b]))
                    try:
                        if fv is not None and ViewC.isInstance(fv):
                            target = cast(J("android.view.View"), fv)
                    except Exception:
                        pass
                out.append(target)
                break
        return out

    def rects_for_key(self, kid, limit=40):
        rects = []
        seen = set()
        cache = {}
        for d in self.descs_for(kid):
            try:
                views = self.desc_views(d, cache)
            except Exception:
                log_exc("desc_views")
                views = []
            for v in views:
                r = view_rect(v)
                if r is None:
                    continue
                key = tuple(r)
                if key in seen:
                    continue
                seen.add(key)
                rects.append(r)
                if len(rects) >= limit:
                    return rects
        return rects

    def find_at(self, x, y, pixel, samples=None):
        """Пипетка: какие ключи отвечают за точку (x, y) окна.
        pixel — цвет точно под пальцем, samples — цвета вокруг (радиус ~6dp).
        -> [(rank, area, name, tags, rect)], лучшие первыми."""
        hits = {}  # name -> [area, tags, desc_hit, rect]
        cache = {}
        rect_cache = {}
        for kid, d in self.screen.get("descs", []):
            name = self.name_of(kid)
            if not name or name in NON_COLOR_KEYS:
                continue
            try:
                views = self.desc_views(d, cache)
            except Exception:
                views = []
            for v in views:
                vid = ident(v)
                if vid in rect_cache:
                    r = rect_cache[vid]
                else:
                    r = view_rect(v)
                    rect_cache[vid] = r
                if r is None:
                    continue
                if r[0] <= x <= r[0] + r[2] and r[1] <= y <= r[1] + r[3]:
                    area = max(1, r[2] * r[3])
                    e = hits.get(name)
                    if e is None:
                        e = [area, [], True, r]
                        hits[name] = e
                    if area < e[0]:
                        e[0] = area
                        e[3] = r
                    for lb in flag_labels(as_int(get_field(d, "changeFlags"), 0)):
                        if lb not in e[1]:
                            e[1].append(lb)
        # совпадения по цвету: точно под пальцем и рядом
        samples = [c for c in (samples or []) if c is not None]
        dominant = None
        if samples:
            counts = {}
            for c in samples:
                counts[c & 0xFFFFFF] = counts.get(c & 0xFFFFFF, 0) + 1
            dominant = max(counts.items(), key=lambda kv: kv[1])[0]
        center, near = set(), set()
        if pixel is not None or samples:
            for name in self.all_keys():
                if name in NON_COLOR_KEYS:
                    continue
                c = self.get(self.key_id(name))
                if c_a(c) < 0xF5:
                    continue
                if pixel is not None and color_dist(c, pixel) <= 3:
                    center.add(name)
                elif any(color_dist(c, sc) <= 3 for sc in samples):
                    if dominant is None or color_dist(c, dominant) > 3:
                        near.add(name)       # мелкая деталь рядом (иконка, текст)
            for name in center | near:
                if name not in hits:
                    hits[name] = [10 ** 12, [], False, None]
        items = []
        for name, e in hits.items():
            tags = list(e[1])
            desc = e[2]
            if name in center:
                tags.append("цвет под пальцем")
            elif name in near:
                tags.append("цвет рядом")
            if desc and name in center:
                rank = 0
            elif desc and name in near:
                rank = 1
            elif name in center:
                rank = 2
            elif desc:
                rank = 3
            else:
                rank = 4
            items.append((rank, e[0], name, tags, e[3]))
        items.sort(key=lambda t: (t[0], t[1], t[2]))
        return items[:60]


# ════════════════════════════════════════════════════════════════════
#  Навигатор: на каком экране используется цвет и как туда попасть
# ════════════════════════════════════════════════════════════════════

ROUTE_LABELS = {
    "dialogs": "Список чатов",
    "chat": "Чат",
    "profile": "Ваш профиль",
    "settings": "Настройки уведомлений",
    "chat_settings": "Настройки оформления",
    "privacy": "Конфиденциальность",
    "calls": "Звонки",
    "contacts": "Контакты",
    "drawer": "Боковое меню",
    "dialog": "Всплывающее окно",
}

ROUTE_CLASSES = {
    "dialogs": "org.telegram.ui.DialogsActivity",
    "chat": "org.telegram.ui.ChatActivity",
    "profile": "org.telegram.ui.ProfileActivity",
    "settings": "org.telegram.ui.NotificationsSettingsActivity",
    "chat_settings": "org.telegram.ui.ThemeActivity",
    "privacy": "org.telegram.ui.PrivacySettingsActivity",
    "calls": "org.telegram.ui.CallLogActivity",
    "contacts": "org.telegram.ui.ContactsActivity",
}

# порядок важен: первое совпадение префикса
STATIC_ROUTES = [
    ("chats_menu", "drawer"),
    ("chats_", "dialogs"),
    ("actionBarDefaultSubmenu", None),
    ("actionBarActionMode", "chat"),
    ("actionBarTab", "dialogs"),
    ("actionBar", "dialogs"),
    ("avatar_backgroundActionBar", "profile"),
    ("avatar_actionBar", "profile"),
    ("avatar_backgroundInProfile", "profile"),
    ("avatar_subtitleInProfile", "profile"),
    ("avatar_nameInMessage", "chat"),
    ("avatar_", "dialogs"),
    ("profile_", "profile"),
    ("chat_", "chat"),
    ("code_", "chat"),
    ("table_", "chat"),
    ("dialog", "dialog"),
    ("switch", "settings"),
    ("checkbox", "settings"),
    ("radio", "settings"),
    ("windowBackground", "settings"),
    ("graySection", "settings"),
    ("key_graySection", "settings"),
    ("divider", "settings"),
    ("listSelector", "settings"),
    ("calls_", "calls"),
    ("contacts_", "contacts"),
    ("fastScroll", "contacts"),
    ("stories", "dialogs"),
    ("topics", "dialogs"),
]

PROBE_ORDER = ["dialogs", "chat", "profile", "settings", "chat_settings", "privacy", "calls", "contacts"]


def static_route(name):
    for prefix, rid in STATIC_ROUTES:
        if name.startswith(prefix):
            return rid
    return None


class Navigator:
    def __init__(self, engine):
        self.engine = engine
        self._probe = None    # name -> [route ids]
        self._probed_ok = set()

    # ── аккаунт / цели ──
    def _account(self):
        try:
            return int(J("org.telegram.messenger.UserConfig").selectedAccount)
        except Exception:
            return 0

    def _self_id(self):
        try:
            return int(J("org.telegram.messenger.UserConfig").getInstance(self._account()).getClientUserId())
        except Exception:
            return 0

    def _chat_target(self):
        """Первый личный чат из списка (там есть и входящие, и исходящие), иначе «Избранное»."""
        me = self._self_id()
        try:
            mc = J("org.telegram.messenger.MessagesController").getInstance(self._account())
            dialogs = mc.getAllDialogs()
            DO = J("org.telegram.messenger.DialogObject")
            n = min(int(dialogs.size()), 60)
            for i in range(n):
                d = dialogs.get(i)
                did = int(d.id)
                if did > 0 and did != me and bool(DO.isUserDialog(did)):
                    return did
        except Exception:
            log_exc("chat target")
        return me

    def _bundle(self, user_id):
        b = J("android.os.Bundle")()
        b.putLong("user_id", int(user_id))
        return b

    def make_fragment(self, rid):
        if rid == "dialogs":
            return J(ROUTE_CLASSES[rid])(None)
        if rid == "chat":
            return J(ROUTE_CLASSES[rid])(self._bundle(self._chat_target()))
        if rid == "profile":
            return J(ROUTE_CLASSES[rid])(self._bundle(self._self_id()))
        if rid == "chat_settings":
            return J(ROUTE_CLASSES[rid])(0)
        if rid == "contacts":
            return J(ROUTE_CLASSES[rid])(None)
        if rid in ROUTE_CLASSES:
            return J(ROUTE_CLASSES[rid])()
        return None

    # ── где используется ключ ──
    def probe(self):
        """Один раз собрать ключи популярных экранов (без их показа)."""
        if self._probe is not None:
            return self._probe
        res = {}
        for rid in PROBE_ORDER:
            descs = []
            try:
                frag = self.make_fragment(rid)
                if frag is not None:
                    arr = frag.getThemeDescriptions()
                    if arr is not None:
                        for i in range(int(arr.size())):
                            d = arr.get(i)
                            if d is not None:
                                descs.append((int(d.getCurrentKey()), d))
                        self._probed_ok.add(rid)
            except Exception:
                descs = []
            for kid, d in descs:
                n = self.engine.name_of(kid)
                if not n:
                    continue
                lst = res.setdefault(n, [])
                if rid not in lst:
                    lst.append(rid)
        self._probe = res
        return res

    def is_current(self, rid):
        cls_name = ROUTE_CLASSES.get(rid)
        if not cls_name:
            return False
        try:
            c = java_class_of(cls_name)
        except Exception:
            return False
        for f in self.engine.visible_fragments():
            try:
                if c.isInstance(f):
                    return True
            except Exception:
                pass
        return False

    def route_for(self, name):
        """-> id экрана, где виден ключ, или None. Текущий экран не предлагается."""
        st = static_route(name)
        try:
            cands = self.probe().get(name, [])
        except Exception:
            cands = []
        order = []
        # статический маршрут — первым, если опрос экрана его не опроверг
        if st and (st in cands or st not in self._probed_ok):
            order.append(st)
        order.extend(r for r in cands if r not in order)
        if st and st not in order:
            order.append(st)
        for rid in order:
            if not self.is_current(rid):
                return rid
        return None

    def where_label(self, name):
        if name in self.engine.screen.get("keys", []):
            return "на этом экране"
        rid = self.route_for(name)
        return ROUTE_LABELS.get(rid, "") if rid else ""

    # ── переходы ──
    def _last(self):
        try:
            return J("org.telegram.ui.LaunchActivity").getLastFragment()
        except Exception:
            return None

    def go_root(self):
        act = get_activity()
        layout = act.getActionBarLayout() if act is not None else None
        if layout is None:
            return False
        stack = layout.getFragmentStack()
        n = int(stack.size())
        roots = []
        for cn in ("org.telegram.ui.DialogsActivity", "org.telegram.ui.MainTabsActivity"):
            try:
                roots.append(java_class_of(cn))
            except Exception:
                pass
        idx = None
        for i in range(n):
            f = stack.get(i)
            if any(rc.isInstance(f) for rc in roots):
                idx = i
                break
        if idx is None:
            last = self._last()
            return bool(last.presentFragment(self.make_fragment("dialogs"))) if last is not None else False
        if idx >= n - 1:
            return True
        frags = [stack.get(i) for i in range(idx + 1, n)]
        for f in frags[:-1]:
            try:
                f.removeSelfFromStack()
            except Exception:
                pass
        frags[-1].finishFragment()
        return True

    def open_drawer(self):
        act = get_activity()
        dlc = None
        try:
            dlc = act.drawerLayoutContainer
        except Exception:
            dlc = get_field(act, "drawerLayoutContainer")
        if dlc is None:
            return False
        try:
            dlc.openDrawer(False)
            return True
        except Exception:
            return False

    def navigate(self, rid):
        """Перейти на экран. True, если переход начат."""
        try:
            if rid == "dialogs":
                return self.go_root()
            if rid == "drawer":
                self.go_root()
                post_ui(lambda: (self.open_drawer() or toast("Откройте боковое меню вручную")), 420)
                return True
            last = self._last()
            frag = self.make_fragment(rid)
            if last is None or frag is None:
                return False
            return bool(last.presentFragment(frag))
        except Exception:
            log_exc("navigate " + str(rid))
            return False


def children_of(view, limit=200):
    """Прямые дети ViewGroup (как в ThemeDescription)."""
    out = []
    try:
        VG = J("android.view.ViewGroup")
        if not java_class_of("android.view.ViewGroup").isInstance(view):
            return out
        g = cast(VG, view)
        n = min(int(g.getChildCount()), limit)
        for i in range(n):
            c = g.getChildAt(i)
            if c is not None:
                out.append(c)
    except Exception:
        pass
    return out


def invalidate_tree(root, limit=5000):
    VGc = java_class_of("android.view.ViewGroup")
    VG = J("android.view.ViewGroup")
    stack = [root]
    n = 0
    while stack and n < limit:
        v = stack.pop()
        n += 1
        try:
            v.invalidate()
            if VGc.isInstance(v):
                g = cast(VG, v)
                for i in range(int(g.getChildCount())):
                    c = g.getChildAt(i)
                    if c is not None:
                        stack.append(c)
        except Exception:
            pass


def view_rect(v):
    """[x, y, w, h] во координатах окна, или None если не видно."""
    try:
        if v is None or not v.isShown():
            return None
        w, h = int(v.getWidth()), int(v.getHeight())
        if w <= 0 or h <= 0:
            return None
        loc = jarray(jint)([0, 0])
        v.getLocationInWindow(loc)
        x, y = int(loc[0]), int(loc[1])
        act = get_activity()
        if act is not None:
            dv = act.getWindow().getDecorView()
            W, H = int(dv.getWidth()), int(dv.getHeight())
            if x + w <= 0 or y + h <= 0 or x >= W or y >= H:
                return None
        return [x, y, w, h]
    except Exception:
        return None


