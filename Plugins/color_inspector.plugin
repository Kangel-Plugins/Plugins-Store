#  Слайдер с градиентной дорожкой
# ════════════════════════════════════════════════════════════════════

class Slider:
    def __init__(self, kit, on_change):
        self.k = kit
        self.on_change = on_change
        self.frac = 0.0
        self.colors = [0xFF000000, 0xFFFFFFFF]
        self.thumb_color = 0xFFFFFFFF
        k = kit
        self.view = k.linear(False, G_CENTER_V)
        self.label = k.text("", 12.5, k.p["sub"], bold=True, gravity=G_CENTER)
        self.view.addView(self.label, k.llp(k.dp(18), MATCH))

        self.track = k.frame()
        self.view.addView(self.track, k.llp(0, k.dp(34), 1.0, l=6, r=8))

        self.bar_host = k.frame()
        self.bar_host.setBackground(k.shape(0xFFFFFFFF, radius=8))
        try:
            self.bar_host.setClipToOutline(True)
        except Exception:
            pass
        self.chk = k.view()
        self.chk.setBackground(k.checker())
        self.chk.setVisibility(GONE)
        self.bar_host.addView(self.chk, k.flp(MATCH, MATCH))
        self.bar = k.view()
        self.grad = k.gradient(self.colors)
        self.bar.setBackground(self.grad)
        self.bar_host.addView(self.bar, k.flp(MATCH, MATCH))
        self.track.addView(self.bar_host, k.flp(MATCH, k.dp(16), G_CENTER_V | G_LEFT, l=11, r=11))

        self.thumb = k.frame()
        self.thumb.setBackground(k.shape(0x33000000, oval=True))
        self.thumb_fill = k.view()
        self.thumb_fill_d = k.shape(self.thumb_color, oval=True, stroke=3, stroke_color=0xFFFFFFFF)
        self.thumb_fill.setBackground(self.thumb_fill_d)
        self.thumb.addView(self.thumb_fill, k.flp(MATCH, MATCH, G_CENTER, 1, 1, 1, 1))
        self.track.addView(self.thumb, k.flp(k.dp(24), k.dp(24), G_CENTER_V | G_LEFT))

        self.value = k.text("", 12.5, k.p["sub"], gravity=G_RIGHT | G_CENTER_V, mono=True)
        self.view.addView(self.value, k.llp(k.dp(44), MATCH))
        on_touch(self.track, self._touch, k.refs)

    def _touch(self, v, e):
        act = int(e.getActionMasked())
        if act == A_DOWN:
            try:
                v.getParent().requestDisallowInterceptTouchEvent(True)
            except Exception:
                pass
        w = int(self.track.getWidth())
        pad = self.k.dp(11)
        span = max(1, w - pad * 2)
        f = (float(e.getX()) - pad) / span
        f = max(0.0, min(1.0, f))
        final = act in (A_UP, A_CANCEL)
        if act in (A_DOWN, A_MOVE, A_UP, A_CANCEL):
            self.frac = f
            self._place()
            try:
                self.on_change(f, final)
            except Exception:
                log_exc("slider change")
        if final:
            try:
                v.getParent().requestDisallowInterceptTouchEvent(False)
            except Exception:
                pass
        return True

    def _place(self, retry=0):
        w = int(self.track.getWidth())
        if w <= 0:
            if retry < 12:
                post_ui(lambda: self._place(retry + 1), 60)
            return
        pad = self.k.dp(11)
        tw = self.k.dp(24)
        x = pad + self.frac * (w - pad * 2) - tw / 2.0
        self.thumb.setTranslationX(float(x))

    def set(self, label, frac, colors, value_text, thumb_color, checker=False):
        self.label.setText(label)
        self.frac = max(0.0, min(1.0, float(frac)))
        if colors != self.colors:
            self.colors = list(colors)
            try:
                self.grad.setColors(jarray(jint)([s32(c) for c in colors]))
            except Exception:
                self.grad = self.k.gradient(colors)
                self.bar.setBackground(self.grad)
        self.chk.setVisibility(VISIBLE if checker else GONE)
        self.value.setText(value_text)
        if thumb_color != self.thumb_color:
            self.thumb_color = thumb_color
            self.thumb_fill_d.setColor(ji(thumb_color | 0xFF000000))
        self._place()


# ════════════════════════════════════════════════════════════════════
#  Страница выбора цвета
# ════════════════════════════════════════════════════════════════════

class ColorPicker:
    def __init__(self, panel):
        self.panel = panel
        self.k = panel.k
        self.engine = panel.engine
        self.name = None
        self.kid = -1
        self.old = 0
        self.h, self.s, self.v, self.a = 0.0, 0.0, 0.0, 255
        self.mode = "hsv"
        self.anim = None
        self._hex_guard = False
        self._live_pending = False
        self._live_color = None
        self.view = None
        self.wheel_size = 0

    # ── построение ──
    def build(self):
        k = self.k
        p = k.p
        scroll = J("android.widget.ScrollView")(k.ctx)
        scroll.setFillViewport(True)
        scroll.setVerticalScrollBarEnabled(False)
        root = k.linear(True)
        root.setPadding(k.dp(16), 0, k.dp(16), k.dp(18))
        scroll.addView(root, J("android.widget.FrameLayout$LayoutParams")(MATCH, WRAP))
        self.root = root

        # шапка
        head = k.linear(False, G_CENTER_V)
        head.addView(k.icon_button("ic_ab_back", "←", p["text"], on_tap=self.panel.picker_cancel),
                     k.llp(k.dp(40), k.dp(40), l=-8))
        tcol = k.linear(True)
        self.title = k.text("", 16.5, p["text"], bold=True)
        self.subtitle = k.text("", 12.5, p["sub"])
        tcol.addView(self.title)
        tcol.addView(self.subtitle)
        head.addView(tcol, k.llp(0, WRAP, 1.0, l=6))
        head.addView(k.icon_button("msg_location", "⌖", p["accent"], on_tap=self._locate),
                     k.llp(k.dp(40), k.dp(40)))
        head.addView(k.icon_button("ic_ab_other", "⋮", p["sub"], on_tap=self._more),
                     k.llp(k.dp(40), k.dp(40), r=-8))
        root.addView(head, k.llp(MATCH, k.dp(52)))

        # другие цвета там, куда нажали
        self.alt_box = k.linear(True)
        self.alt_box.addView(k.text("Другие цвета в этом месте", 12.5, p["sub"], bold=True), k.llp(MATCH, WRAP, b=6))
        ahs = J("android.widget.HorizontalScrollView")(k.ctx)
        ahs.setHorizontalScrollBarEnabled(False)
        self.alt_row = k.linear(False, G_CENTER_V)
        ahs.addView(self.alt_row, J("android.widget.FrameLayout$LayoutParams")(WRAP, MATCH))
        self.alt_box.addView(ahs, k.llp(MATCH, k.dp(40)))
        self.alt_box.setVisibility(GONE)
        root.addView(self.alt_box, k.llp(MATCH, WRAP, b=8))

        # круг + правая колонка
        scr_w = int(k.ctx.getResources().getDisplayMetrics().widthPixels)
        self.wheel_size = int(min(k.dp(178), (scr_w - k.dp(32)) * 0.52))
        tsz = k.dp(26)
        row = k.linear(False, G_TOP)
        wheel_host = k.frame()
        total = self.wheel_size + tsz
        self.wheel_total = total
        self.wheel_img = J("android.widget.ImageView")(k.ctx)
        self.wheel_img.setImageBitmap(self._wheel_bitmap(self.wheel_size))
        wheel_host.addView(self.wheel_img, k.flp(self.wheel_size, self.wheel_size, G_TOP | G_LEFT))
        self.wheel_img.setTranslationX(float(tsz / 2.0))
        self.wheel_img.setTranslationY(float(tsz / 2.0))
        self.wheel_thumb = k.frame()
        self.wheel_thumb.setBackground(k.shape(0x40000000, oval=True))
        self.wheel_thumb_fill_d = k.shape(0xFFFFFFFF, oval=True, stroke=3, stroke_color=0xFFFFFFFF)
        tf = k.view()
        tf.setBackground(self.wheel_thumb_fill_d)
        self.wheel_thumb.addView(tf, k.flp(MATCH, MATCH, G_CENTER, 1, 1, 1, 1))
        wheel_host.addView(self.wheel_thumb, k.flp(tsz, tsz, G_TOP | G_LEFT))
        on_touch(wheel_host, self._wheel_touch, k.refs)
        row.addView(wheel_host, k.llp(total, total))

        col = k.linear(True)
        # превью было/стало
        prev = k.linear(False)
        prev.setBackground(k.shape(0xFFFFFFFF, radius=16))
        try:
            prev.setClipToOutline(True)
        except Exception:
            pass
        self.prev_old_host, self.prev_old = self._preview_half("было")
        self.prev_new_host, self.prev_new = self._preview_half("стало")
        prev.addView(self.prev_old_host, k.llp(0, MATCH, 1.0))
        prev.addView(self.prev_new_host, k.llp(0, MATCH, 1.0))
        on_click(self.prev_old_host, self._revert, k.refs)
        col.addView(prev, k.llp(MATCH, k.dp(64), b=10))

        # HEX
        hexbox = k.linear(False, G_CENTER_V)
        hexbox.setBackground(k.shape(p["card"], radius=12))
        hexbox.setPadding(k.dp(10), 0, k.dp(4), 0)
        self.hex = k.edit("#AARRGGBB", mono=True, size=15)
        self.hex.setInputType(1 | 0x80000 | 0x1000)
        hexbox.addView(self.hex, k.llp(0, MATCH, 1.0))
        hexbox.addView(k.icon_button("msg_copy", "⧉", p["sub"], size=34, on_tap=self._copy_hex),
                       k.llp(k.dp(34), k.dp(34)))
        text_watcher(self.hex, self._hex_changed, k.refs)
        col.addView(hexbox, k.llp(MATCH, k.dp(42), b=10))

        # режим HSV / RGB
        seg = k.linear(False)
        seg.setBackground(k.shape(p["card"], radius=12))
        seg.setPadding(k.dp(3), k.dp(3), k.dp(3), k.dp(3))
        self.seg_hsv = k.text("HSV", 13.5, p["text"], bold=True, gravity=G_CENTER)
        self.seg_rgb = k.text("RGB", 13.5, p["sub"], bold=True, gravity=G_CENTER)
        seg.addView(self.seg_hsv, k.llp(0, MATCH, 1.0))
        seg.addView(self.seg_rgb, k.llp(0, MATCH, 1.0))
        on_click(self.seg_hsv, lambda: self._set_mode("hsv"), k.refs)
        on_click(self.seg_rgb, lambda: self._set_mode("rgb"), k.refs)
        col.addView(seg, k.llp(MATCH, k.dp(38)))

        row.addView(col, k.llp(0, WRAP, 1.0, l=10, t=4))
        root.addView(row, k.llp(MATCH, WRAP, t=2))

        # слайдеры
        self.sliders = []
        for i in range(4):
            s = Slider(k, (lambda idx: (lambda f, final: self._slider(idx, f, final)))(i))
            self.sliders.append(s)
            root.addView(s.view, k.llp(MATCH, k.dp(38), t=2 if i else 10))

        # RGB-перелив
        root.addView(k.text("RGB-перелив", 12.5, p["sub"], bold=True), k.llp(MATCH, WRAP, t=14, b=6))
        arow = k.linear(False, G_CENTER_V)
        self.anim_chip = k.text("Выключен", 13.5, p["sub"], bold=True, gravity=G_CENTER)
        self.anim_chip.setPadding(k.dp(16), 0, k.dp(16), 0)
        self.anim_chip.setClickable(True)
        on_click(self.anim_chip, self._anim_toggle, k.refs)
        arow.addView(self.anim_chip, k.llp(WRAP, k.dp(36)))
        self.anim_note = k.text("оттенок бежит по кругу, насыщенность и яркость — из выбранного цвета",
                                11.5, p["hint"], lines=2)
        arow.addView(self.anim_note, k.llp(0, WRAP, 1.0, l=10))
        root.addView(arow, k.llp(MATCH, WRAP))
        self.anim_speed = Slider(k, self._anim_speed_changed)
        self.anim_speed.view.setVisibility(GONE)
        root.addView(self.anim_speed.view, k.llp(MATCH, k.dp(38), t=6))

        # недавние
        self.recent_title = k.text("Недавние", 12.5, p["sub"], bold=True)
        root.addView(self.recent_title, k.llp(MATCH, WRAP, t=14, b=6))
        self.recent_row = self._swatch_row()
        root.addView(self.recent_row[0], k.llp(MATCH, k.dp(40)))

        root.addView(k.text("Палитра", 12.5, p["sub"], bold=True), k.llp(MATCH, WRAP, t=12, b=6))
        pal_row = self._swatch_row()
        for c in PALETTE:
            self._add_swatch(pal_row[1], c)
        root.addView(pal_row[0], k.llp(MATCH, k.dp(40)))

        # кнопки
        btns = k.linear(False, G_CENTER_V)
        self.btn_reset = k.pill_button("Сбросить", color=p["danger"], on_tap=self._reset)
        btns.addView(self.btn_reset, k.llp(WRAP, k.dp(46)))
        btns.addView(k.view(), k.llp(0, 1, 1.0))
        btns.addView(k.pill_button("Отмена", color=p["sub"], on_tap=self.panel.picker_cancel),
                     k.llp(WRAP, k.dp(46), r=8))
        btns.addView(k.pill_button("Применить", filled=True, on_tap=self._apply),
                     k.llp(WRAP, k.dp(46)))
        root.addView(btns, k.llp(MATCH, WRAP, t=18))

        self.view = scroll
        return scroll

    def _preview_half(self, label):
        k = self.k
        fl = k.frame()
        chk = k.view()
        chk.setBackground(k.checker())
        fl.addView(chk, k.flp(MATCH, MATCH))
        cv = k.view()
        fl.addView(cv, k.flp(MATCH, MATCH))
        t = k.text(label, 11, 0xFFFFFFFF, bold=True, gravity=G_CENTER)
        t.setShadowLayer(float(k.dp(3)), 0.0, 0.0, ji(0x99000000))
        fl.addView(t, k.flp(MATCH, WRAP, G_BOTTOM, b=5))
        return fl, cv

    def _swatch_row(self):
        k = self.k
        hs = J("android.widget.HorizontalScrollView")(k.ctx)
        hs.setHorizontalScrollBarEnabled(False)
        ll = k.linear(False, G_CENTER_V)
        hs.addView(ll, J("android.widget.FrameLayout$LayoutParams")(WRAP, MATCH))
        return hs, ll

    def _add_swatch(self, parent, color):
        k = self.k
        sw, cv = k.swatch(32, color)
        host = k.frame()
        host.setBackground(k.ripple(None, oval=True))
        host.addView(sw, k.flp(k.dp(32), k.dp(32), G_CENTER))
        host.setClickable(True)
        on_click(host, lambda: self.set_color(color, "swatch", final=True), k.refs)
        parent.addView(host, k.llp(k.dp(40), k.dp(40)))

    def _wheel_bitmap(self, size):
        Bitmap = J("android.graphics.Bitmap")
        bmp = Bitmap.createBitmap(size, size, J("android.graphics.Bitmap$Config").ARGB_8888)
        cv = J("android.graphics.Canvas")(bmp)
        cx = cy = size / 2.0
        r = size / 2.0 - 1.0
        hues = [s32(hsv_color(i * 60, 1, 1)) for i in range(7)]
        Paint = J("android.graphics.Paint")
        p1 = Paint(1)
        p1.setShader(J("android.graphics.SweepGradient")(float(cx), float(cy), jarray(jint)(hues), None))
        cv.drawCircle(float(cx), float(cy), float(r), p1)
        p2 = Paint(1)
        TM = J("android.graphics.Shader$TileMode")
        p2.setShader(J("android.graphics.RadialGradient")(float(cx), float(cy), float(r),
                                                           jint(s32(0xFFFFFFFF)), jint(s32(0x00FFFFFF)), TM.CLAMP))
        cv.drawCircle(float(cx), float(cy), float(r), p2)
        return bmp

    # ── загрузка ключа ──
    def load(self, name, kid, color, overridden):
        self.name, self.kid = name, kid
        self.old = u32(color)
        self.title.setText(friendly_name(name))
        self.base_sub = name + ("  •  изменён" if overridden else "")
        self.subtitle.setText(self.base_sub)
        self.btn_reset.setVisibility(VISIBLE if overridden else GONE)
        self.prev_old.setBackgroundColor(s32(self.old))
        self.h, self.s, self.v = color_hsv(self.old)
        self.a = c_a(self.old)
        live = self.engine.anims.get(name)
        self.anim = dict(live) if live else None
        self._anim_ui()
        self._fill_recent()
        self._render("load")
        try:
            self.view.scrollTo(0, 0)
        except Exception:
            pass

    def _fill_recent(self):
        ll = self.recent_row[1]
        ll.removeAllViews()
        rec = self.panel.plugin.recent_colors()
        for c in rec:
            self._add_swatch(ll, c)
        vis = VISIBLE if rec else GONE
        self.recent_title.setVisibility(vis)
        self.recent_row[0].setVisibility(vis)

    # ── состояние ──
    def color(self):
        return hsv_color(self.h, self.s, self.v, self.a)

    def set_color(self, c, source, final=False):
        c = u32(c)
        h, s, v = color_hsv(c)
        if v > 0.0001:
            if s > 0.0001:
                self.h = h
            self.s = s
        self.v = v
        self.a = c_a(c)
        self._render(source, final=final)

    def _set_mode(self, mode):
        self.mode = mode
        p = self.k.p
        on = self.k.shape(p["card2"], radius=10)
        if mode == "hsv":
            self.seg_hsv.setBackground(on)
            self.seg_rgb.setBackground(None)
            self.seg_hsv.setTextColor(ji(p["text"]))
            self.seg_rgb.setTextColor(ji(p["sub"]))
        else:
            self.seg_rgb.setBackground(on)
            self.seg_hsv.setBackground(None)
            self.seg_rgb.setTextColor(ji(p["text"]))
            self.seg_hsv.setTextColor(ji(p["sub"]))
        self._render_sliders()

    def _render(self, source, final=False):
        c = self.color()
        # круг
        total = self.wheel_total
        tsz = self.k.dp(26)
        rad = self.wheel_size / 2.0 - 1.0
        ang = math.radians(self.h)
        cx = total / 2.0 + math.cos(ang) * self.s * rad
        cy = total / 2.0 + math.sin(ang) * self.s * rad
        self.wheel_thumb.setTranslationX(float(cx - tsz / 2.0))
        self.wheel_thumb.setTranslationY(float(cy - tsz / 2.0))
        self.wheel_thumb_fill_d.setColor(ji(c | 0xFF000000))
        g = int(round(self.v * 255))
        PDM = J("android.graphics.PorterDuff$Mode")
        try:
            self.wheel_img.setColorFilter(J("android.graphics.PorterDuffColorFilter")(ji(argb(255, g, g, g)), PDM.MULTIPLY))
        except Exception:
            pass
        # превью и HEX
        self.prev_new.setBackgroundColor(s32(c))
        if source != "hex":
            self._hex_guard = True
            try:
                self.hex.setText(hex_color(c))
            finally:
                self._hex_guard = False
        self._render_sliders()
        if source != "load":
            self._live(c, final)

    def _render_sliders(self):
        c = self.color()
        r, g, b = c_r(c), c_g(c), c_b(c)
        sl = self.sliders
        opaque = c | 0xFF000000
        if self.mode == "hsv":
            sl[0].set("H", self.h / 360.0, [hsv_color(i * 60, 1, 1) for i in range(7)],
                      "%d°" % int(round(self.h)) if self.h < 359.5 else "0°", hsv_color(self.h, 1, 1))
            sl[1].set("S", self.s, [hsv_color(self.h, 0, self.v), hsv_color(self.h, 1, self.v)],
                      "%d%%" % int(round(self.s * 100)), opaque)
            sl[2].set("V", self.v, [0xFF000000, hsv_color(self.h, self.s, 1)],
                      "%d%%" % int(round(self.v * 100)), opaque)
        else:
            sl[0].set("R", r / 255.0, [argb(255, 0, g, b), argb(255, 255, g, b)], str(r), argb(255, r, 0, 0))
            sl[1].set("G", g / 255.0, [argb(255, r, 0, b), argb(255, r, 255, b)], str(g), argb(255, 0, g, 0))
            sl[2].set("B", b / 255.0, [argb(255, r, g, 0), argb(255, r, g, 255)], str(b), argb(255, 0, 0, b))
        sl[3].set("A", self.a / 255.0, [opaque & 0x00FFFFFF, opaque],
                  "%d%%" % int(round(self.a * 100 / 255.0)), opaque, checker=True)

    def _slider(self, idx, f, final):
        if self.mode == "hsv":
            if idx == 0:
                self.h = f * 360.0
            elif idx == 1:
                self.s = f
            elif idx == 2:
                self.v = f
            else:
                self.a = int(round(f * 255))
            self._render("slider", final)
        else:
            if idx == 3:
                self.a = int(round(f * 255))
                self._render("slider", final)
                return
            c = self.color()
            ch = [c_r(c), c_g(c), c_b(c)]
            ch[idx] = int(round(f * 255))
            self.set_color(argb(self.a, ch[0], ch[1], ch[2]), "slider", final=final)

    def _wheel_touch(self, v, e):
        act = int(e.getActionMasked())
        if act == A_DOWN:
            try:
                v.getParent().requestDisallowInterceptTouchEvent(True)
            except Exception:
                pass
        total = self.wheel_total
        rad = self.wheel_size / 2.0 - 1.0
        dx = float(e.getX()) - total / 2.0
        dy = float(e.getY()) - total / 2.0
        d = math.hypot(dx, dy)
        self.h = (math.degrees(math.atan2(dy, dx)) + 360.0) % 360.0
        self.s = max(0.0, min(1.0, d / rad))
        if self.v < 0.02:
            self.v = 1.0
        final = act in (A_UP, A_CANCEL)
        self._render("wheel", final)
        if final:
            try:
                v.getParent().requestDisallowInterceptTouchEvent(False)
            except Exception:
                pass
        return True

    def _hex_changed(self, text):
        if self._hex_guard:
            return
        digits = text.strip().lstrip("#")
        if len(digits) not in (6, 8):
            return  # ждём полный цвет, чтобы не мигать на полпути
        c = parse_color(text)
        if c is None:
            return
        self.set_color(c, "hex", final=True)

    # ── живой предпросмотр (с ограничением частоты) ──
    def set_alts(self, alts, current):
        k = self.k
        p = k.p
        self.alt_row.removeAllViews()
        if not alts or len(alts) < 2:
            self.alt_box.setVisibility(GONE)
            return
        eng = self.engine
        for name, tags in alts:
            kid = eng.key_id(name)
            if kid < 0:
                continue
            sel = name == current
            chip = k.linear(False, G_CENTER_V)
            chip.setPadding(k.dp(6), 0, k.dp(12), 0)
            bg = k.shape(p["card2"] if sel else p["card"], radius=18,
                         stroke=1.5 if sel else 0, stroke_color=p["accent"])
            chip.setBackground(k.ripple(bg, radius=18))
            sw, _ = k.swatch(24, eng.get(kid))
            chip.addView(sw, k.llp(k.dp(24), k.dp(24)))
            t = k.text(friendly_name(name), 13, p["text"] if sel else p["sub"], bold=sel)
            t.setMaxWidth(k.dp(210))
            chip.addView(t, k.llp(WRAP, WRAP, l=8))
            chip.setClickable(True)
            on_click(chip, (lambda nn: (lambda: self.panel.switch_alt(nn)))(name), k.refs)
            self.alt_row.addView(chip, k.llp(WRAP, k.dp(36), r=8))
        self.alt_box.setVisibility(VISIBLE)

    # ── RGB-перелив ──
    def _anim_ui(self):
        k = self.k
        p = k.p
        on = self.anim is not None
        if on:
            self.anim_chip.setText("● Перелив включён")
            self.anim_chip.setTextColor(ji(p["on_accent"]))
            self.anim_chip.setBackground(k.gradient(
                [0xFFFF3B6B, 0xFFFFB02E, 0xFF3DDC97, 0xFF2AABEE, 0xFF8E7CFF], "LEFT_RIGHT", radius=18))
        else:
            self.anim_chip.setText("Выключен")
            self.anim_chip.setTextColor(ji(p["sub"]))
            self.anim_chip.setBackground(k.ripple(k.shape(p["card"], radius=18), radius=18))
        self.anim_speed.view.setVisibility(VISIBLE if on else GONE)
        if on:
            sp = float(self.anim["speed"])
            self.anim_speed.set("С", (sp - 10.0) / 350.0,
                                [hsv_color(i * 60, 1, 1) for i in range(7)],
                                "%d°/с" % int(round(sp)), hsv_color(sp, 1, 1))

    def _anim_toggle(self):
        if self.name in WALLPAPER_KEYS:
            toast("Обои чата переливать нельзя — выберите другой элемент", "err")
            return
        if self.anim is None:
            self.anim = {"speed": 90.0, "phase": 0.0, "s": max(self.s, 0.6),
                         "v": max(self.v, 0.75), "a": self.a or 255}
            self.engine.anim_set(self.name, self.anim)
        else:
            self.anim = None
            self.engine.anim_set(self.name, None)
        self._anim_ui()

    def _anim_speed_changed(self, f, final):
        if self.anim is None:
            return
        self.anim["speed"] = 10.0 + float(f) * 350.0
        self.engine.anim_set(self.name, self.anim)
        sp = self.anim["speed"]
        self.anim_speed.value.setText("%d°/с" % int(round(sp)))
        self.anim_speed.thumb_fill_d.setColor(ji(hsv_color(sp, 1, 1)))

    def _live(self, c, final):
        if self.anim is not None:
            self.anim["s"] = max(0.0, min(1.0, self.s))
            self.anim["v"] = max(0.0, min(1.0, self.v))
            self.anim["a"] = int(self.a)
            self.engine.anim_set(self.name, self.anim)
        self._live_color = c
        if final:
            self._live_pending = False
            self.engine.preview(self.kid, c, final=True)
            return
        if self._live_pending:
            return
        self._live_pending = True

        def go():
            if not self._live_pending:
                return
            self._live_pending = False
            if self._live_color is not None and self.kid >= 0:
                self.engine.preview(self.kid, self._live_color, final=False)
        post_ui(go, 40)

    # ── действия ──
    def _revert(self):
        self.set_color(self.old, "revert", final=True)

    def _copy_hex(self):
        try:
            clipboard_set(hex_color(self.color()))
            toast("Скопировано: " + hex_color(self.color()), "ok")
        except Exception:
            log_exc("copy hex")

    def _apply(self):
        self._live_pending = False
        hide_keyboard(self.hex)
        self.panel.picker_apply(self.color())

    def _reset(self):
        self._live_pending = False
        self.panel.picker_reset()

    def _locate(self):
        self.panel.locate_key(self.name, full=True)

    def _more(self):
        items = ["Вставить цвет из буфера", "Скопировать имя ключа", "Скопировать HEX",
                 "Взять цвет другого ключа…", "Цвет как у «было»"]

        def pick(i):
            if i == 0:
                c = parse_color(clipboard_get())
                if c is None:
                    toast("В буфере нет цвета (#RRGGBB / #AARRGGBB)", "err")
                else:
                    self.set_color(c, "paste", final=True)
            elif i == 1:
                clipboard_set(self.name)
                toast("Скопировано: " + self.name, "ok")
            elif i == 2:
                self._copy_hex()
            elif i == 3:
                self.panel.ask_key_color(lambda c: self.set_color(c, "key", final=True))
            elif i == 4:
                self._revert()
        self.panel.menu(self.name, items, pick)


# ════════════════════════════════════════════════════════════════════
#  Адаптер списка ключей (ListView)
# ════════════════════════════════════════════════════════════════════

class _Holder:
    __slots__ = ("name", "swatch", "title", "sub", "dot", "locate")


class KeyAdapter:
    def __init__(self, panel):
        self.panel = panel
        self.items = []          # [(name, tags or None)]
        self.observers = []
        self.holders = []
        fns = {
            "getCount": lambda: len(self.items),
            "getItem": lambda pos: None,
            "getItemId": lambda pos: int(pos),
            "getItemViewType": lambda pos: 0,
            "getViewTypeCount": lambda: 1,
            "hasStableIds": lambda: False,
            "isEmpty": lambda: len(self.items) == 0,
            "areAllItemsEnabled": lambda: True,
            "isEnabled": lambda pos: True,
            "registerDataSetObserver": self._reg,
            "unregisterDataSetObserver": self._unreg,
            "getView": self._get_view,
            "getAutofillOptions": lambda: None,
        }
        self.proxy = make_proxy(
            "android.widget.ListAdapter", fns,
            bools=("hasStableIds", "isEmpty", "areAllItemsEnabled", "isEnabled"),
            defaults={"getCount": 0, "getItemId": 0, "getItemViewType": 0, "getViewTypeCount": 1})

    def _reg(self, o):
        if o is not None:
            self.observers.append(o)

    def _unreg(self, o):
        try:
            self.observers = [x for x in self.observers if not x.equals(o)]
        except Exception:
            pass

    def set_items(self, items):
        self.items = items
        self.notify()

    def notify(self):
        for o in list(self.observers):
            try:
                o.onChanged()
            except Exception:
                pass

    def _build_row(self):
        k = self.panel.k
        p = k.p
        row = k.linear(False, G_CENTER_V)
        row.setPadding(k.dp(16), 0, k.dp(6), 0)
        row.setLayoutParams(J("android.widget.AbsListView$LayoutParams")(MATCH, k.dp(62)))
        h = _Holder()
        sw, h.swatch = k.swatch(36, 0)
        row.addView(sw, k.llp(k.dp(36), k.dp(36)))
        col = k.linear(True)
        h.title = k.text("", 15, p["text"], bold=True)
        h.sub = k.text("", 12.5, p["sub"])
        col.addView(h.title)
        col.addView(h.sub, k.llp(MATCH, WRAP, t=2))
        row.addView(col, k.llp(0, WRAP, 1.0, l=14))
        h.dot = k.view()
        h.dot.setBackground(k.shape(p["accent"], oval=True))
        row.addView(h.dot, k.llp(k.dp(8), k.dp(8), l=6, r=2))
        h.locate = k.icon_button("msg_location", "⌖", p["sub"])
        h.name = None
        on_click(h.locate, lambda: self.panel.locate_key(h.name, full=True), k.refs)
        row.addView(h.locate, k.llp(k.dp(42), k.dp(42)))
        idx = len(self.holders)
        self.holders.append(h)
        row.setTag(J("java.lang.Integer").valueOf(idx))
        return row

    def _get_view(self, position, convert, parent):
        try:
            row = convert
            h = None
            if row is not None:
                i = as_int(row.getTag(), -1)
                if 0 <= i < len(self.holders):
                    h = self.holders[i]
            if h is None:
                row = self._build_row()
                h = self.holders[-1]
            name, tags = self.items[int(position)]
            h.name = name
            eng = self.panel.engine
            kid = eng.key_id(name)
            c = eng.get(kid)
            h.swatch.setBackgroundColor(s32(c))
            h.title.setText(friendly_name(name))
            if tags:
                sub = " · ".join(tags) + "  ·  " + name
            else:
                sub = key_hint(name) + "  ·  " + name + "  ·  " + hex_color(c, False)
            h.sub.setText(sub)
            h.dot.setVisibility(VISIBLE if name in eng.overrides else GONE)
            return row
        except Exception:
            log_exc("getView")
            if convert is not None:
                return convert
            return J("android.view.View")(self.panel.k.ctx)


# ════════════════════════════════════════════════════════════════════
#  Плавающая панель редактора
# ════════════════════════════════════════════════════════════════════

class EditorPanel:
    def __init__(self, plugin, activity):
        self.plugin = plugin
        self.engine = plugin.engine
        self.act = activity
        style = int(plugin.get_setting("style", 0) or 0)
        dark = True
        if style == 0:
            try:
                dark = bool(J(THEME).isCurrentThemeDark())
            except Exception:
                dark = True
        else:
            dark = style == 1
        self.k = Kit(activity, DARK if dark else LIGHT)
        self.refs = self.k.refs
        self.dialog = None
        self.state = "closed"
        self.page = "list"
        self.tab = "screen"
        self.query = ""
        self.found = []
        self.editing = None   # name
        self.picker_alts = []
        self._keep_alts = False
        self.height_frac = 0.56
        self.screen_h = int(activity.getResources().getDisplayMetrics().heightPixels)
        self._busy = False

    # ── создание ──
    def build(self):
        k = self.k
        p = k.p
        self.root = k.frame()

        # раскрытая панель
        self.sheet = k.linear(True)
        self.sheet.setBackground(k.shape(p["bg"], radii=[22, 22, 0, 0]))
        try:
            self.sheet.setElevation(float(k.dp(12)))
        except Exception:
            pass
        self.root.addView(self.sheet, k.flp(MATCH, MATCH))

        handle_strip = k.frame()
        pill = k.view()
        pill.setBackground(k.shape(p["handle"], radius=3))
        handle_strip.addView(pill, k.flp(k.dp(40), k.dp(5), G_CENTER))
        on_touch(handle_strip, self._handle_touch, self.refs)
        self.sheet.addView(handle_strip, k.llp(MATCH, k.dp(22)))

        self.pages = k.frame()
        self.sheet.addView(self.pages, k.llp(MATCH, 0, 1.0))
        self.list_page = self._build_list_page()
        self.pages.addView(self.list_page, k.flp(MATCH, MATCH))
        self.picker = ColorPicker(self)
        self.picker_view = self.picker.build()
        self.picker_view.setVisibility(GONE)
        self.pages.addView(self.picker_view, k.flp(MATCH, MATCH))
        self.picker._set_mode("hsv")

        # свёрнутый «пузырь»
        self.bubble = k.frame()
        self.bubble.setBackground(k.gradient([0xFFB06CFF, p["accent"], p["accent2"]], "TL_BR", oval=True))
        try:
            self.bubble.setElevation(float(k.dp(6)))
        except Exception:
            pass
        bic = k.icon("msg_palette", 0xFFFFFFFF) or k.icon("msg_colors", 0xFFFFFFFF)
        if bic is not None:
            iv = J("android.widget.ImageView")(k.ctx)
            iv.setImageDrawable(bic)
            iv.setScaleType(J("android.widget.ImageView$ScaleType").CENTER_INSIDE)
            self.bubble.addView(iv, k.flp(MATCH, MATCH))
        else:
            self.bubble.addView(k.text("🎨", 22, gravity=G_CENTER), k.flp(MATCH, MATCH))
        self.bubble_badge = k.text("", 10, 0xFFFFFFFF, bold=True, gravity=G_CENTER)
        self.bubble_badge.setBackground(k.shape(p["danger"], radius=8))
        self.bubble_badge.setPadding(k.dp(4), 0, k.dp(4), 0)
        self.bubble.addView(self.bubble_badge, k.flp(WRAP, k.dp(16), G_TOP | G_RIGHT))
        self.bubble.setVisibility(GONE)
        self.bubble_host = k.frame()
        self.bubble_host.addView(self.bubble, k.flp(k.dp(54), k.dp(54), G_CENTER))
        self.bubble_host.setVisibility(GONE)
        self.root.addView(self.bubble_host, k.flp(k.dp(66), k.dp(66), G_BOTTOM | G_RIGHT))
        on_touch(self.bubble, self._bubble_touch, self.refs)

        # отступ снизу под навигационную панель / клавиатуру
        def insets(v, ins):
            try:
                bottom = int(ins.getSystemWindowInsetBottom())
                self.sheet.setPadding(0, 0, 0, bottom)
            except Exception:
                pass
            return ins
        try:
            prx = make_proxy("android.view.View$OnApplyWindowInsetsListener",
                             {"onApplyWindowInsets": insets})
            self.root.setOnApplyWindowInsetsListener(prx)
            self.refs.append(prx)
        except Exception:
            pass

        # всплывающее уведомление внутри панели
        self.snack_view = k.text("", 13.5, 0xFFFFFFFF, bold=True, lines=2, gravity=G_CENTER)
        self.snack_view.setPadding(k.dp(14), k.dp(8), k.dp(14), k.dp(8))
        self.snack_view.setVisibility(GONE)
        try:
            self.snack_view.setElevation(float(k.dp(16)))
        except Exception:
            pass
        self.root.addView(self.snack_view, k.flp(WRAP, WRAP, G_TOP | G_CENTER_H, l=16, t=26, r=16))
        self._snack_token = 0

        Dialog = J("android.app.Dialog")
        d = Dialog(self.act)
        d.requestWindowFeature(1)
        d.setContentView(self.root)
        d.setCancelable(False)
        d.setCanceledOnTouchOutside(False)

        def on_key(dlg, code, ev):
            if int(code) == 4:
                if int(ev.getAction()) == 1:
                    self.back()
                return True
            return False
        kp = make_proxy("android.content.DialogInterface$OnKeyListener", {"onKey": on_key}, bools=("onKey",))
        d.setOnKeyListener(kp)
        self.refs.append(kp)
        self.dialog = d
        w = d.getWindow()
        w.setBackgroundDrawable(J("android.graphics.drawable.ColorDrawable")(0))
        w.clearFlags(FLAG_DIM_BEHIND)
        w.addFlags(FLAG_NOT_TOUCH_MODAL)
        w.setSoftInputMode(SOFT_ADJUST_RESIZE | SOFT_STATE_HIDDEN)
        try:
            w.setWindowAnimations(J("android.R$style").Animation_InputMethod)
        except Exception:
            pass

    def _build_list_page(self):
        k = self.k
        p = k.p
        page = k.linear(True)

        head = k.linear(False, G_CENTER_V)
        head.setPadding(k.dp(18), 0, k.dp(8), 0)
        tcol = k.linear(True)
        tcol.addView(k.text("Цвета интерфейса", 18, p["text"], bold=True))
        self.head_sub = k.text("", 12.5, p["sub"])
        tcol.addView(self.head_sub, k.llp(MATCH, WRAP, t=1))
        head.addView(tcol, k.llp(0, WRAP, 1.0))
        insp = k.icon_button(None, "⌖", p["accent"], drawable=k.target_icon(p["accent"]), on_tap=self.start_inspector)
        insp.setBackground(k.ripple(k.shape((p["accent"] & 0xFFFFFF) | 0x24000000, oval=True), oval=True))
        head.addView(insp, k.llp(k.dp(40), k.dp(40), r=4))
        head.addView(k.icon_button("ic_ab_other", "⋮", p["sub"], on_tap=self._list_menu), k.llp(k.dp(40), k.dp(40)))
        head.addView(k.icon_button("msg_go_down", "⌄", p["sub"], on_tap=self.collapse), k.llp(k.dp(40), k.dp(40)))
        head.addView(k.icon_button("msg_close", "✕", p["sub"], on_tap=self.close), k.llp(k.dp(40), k.dp(40)))
        page.addView(head, k.llp(MATCH, k.dp(54)))

        # поиск
        sbox = k.linear(False, G_CENTER_V)
        sbox.setBackground(k.shape(p["card"], radius=14))
        sbox.setPadding(k.dp(12), 0, k.dp(4), 0)
        sic = k.icon("msg_search", p["hint"])
        if sic is not None:
            iv = J("android.widget.ImageView")(k.ctx)
            iv.setImageDrawable(sic)
            sbox.addView(iv, k.llp(k.dp(22), k.dp(22), r=8))
        self.search = k.edit("Поиск: «фон чатов», ключ или #цвет")
        sbox.addView(self.search, k.llp(0, MATCH, 1.0))
        self.search_clear = k.icon_button("msg_clear_input", "✕", p["hint"], on_tap=lambda: self.search.setText(""))
        self.search_clear.setVisibility(GONE)
        sbox.addView(self.search_clear, k.llp(k.dp(36), k.dp(36)))
        text_watcher(self.search, self._on_search, self.refs)
        page.addView(sbox, k.llp(MATCH, k.dp(44), l=16, r=16, t=2))

        tap = k.linear(False, G_CENTER_V)
        tap.setPadding(k.dp(14), 0, k.dp(14), 0)
        tap_bg = k.gradient([(p["accent"] & 0xFFFFFF) | 0x33000000, (p["accent2"] & 0xFFFFFF) | 0x26000000],
                            "LEFT_RIGHT", radius=14)
        tap.setBackground(k.ripple(tap_bg, radius=14))
        tic = J("android.widget.ImageView")(k.ctx)
        tic.setImageDrawable(k.target_icon(p["accent"]))
        tap.addView(tic, k.llp(k.dp(22), k.dp(22)))
        tcol2 = k.linear(True)
        tcol2.addView(k.text("Нажмите на элемент экрана", 14.5, p["text"], bold=True))
        tcol2.addView(k.text("и сразу откроется его цвет", 12, p["sub"]))
        tap.addView(tcol2, k.llp(0, WRAP, 1.0, l=12))
        tap.addView(k.text("›", 22, p["accent"], bold=True), k.llp(WRAP, WRAP))
        tap.setClickable(True)
        on_click(tap, self.start_inspector, self.refs)
        page.addView(tap, k.llp(MATCH, k.dp(52), l=16, r=16, t=8))

        # вкладки
        hs = J("android.widget.HorizontalScrollView")(k.ctx)
        hs.setHorizontalScrollBarEnabled(False)
        chips = k.linear(False, G_CENTER_V)
        chips.setPadding(k.dp(16), 0, k.dp(16), 0)
        hs.addView(chips, J("android.widget.FrameLayout$LayoutParams")(WRAP, MATCH))
        self.chips = {}
        for key, label in (("screen", "На экране"), ("all", "Все"), ("changed", "Изменённые"), ("found", "Найдено")):
            t = k.text(label, 13.5, p["sub"], bold=True, gravity=G_CENTER)
            t.setPadding(k.dp(14), 0, k.dp(14), 0)
            t.setClickable(True)
            on_click(t, (lambda kk: (lambda: self.set_tab(kk)))(key), self.refs)
            chips.addView(t, k.llp(WRAP, k.dp(34), r=8))
            self.chips[key] = (t, label)
        page.addView(hs, k.llp(MATCH, k.dp(46), t=6))

        # список
        body = k.frame()
        lv = J("android.widget.ListView")(k.ctx)
        lv.setDivider(None)
        lv.setDividerHeight(0)
        lv.setSelector(k.ripple(None, radius=0))
        lv.setCacheColorHint(0)
        lv.setVerticalScrollBarEnabled(False)
        lv.setClipToPadding(False)
        lv.setPadding(0, 0, 0, k.dp(12))
        self.adapter = KeyAdapter(self)
        lv.setAdapter(self.adapter.proxy)

        def item_click(parent, view, pos, iid):
            pos = int(pos)
            if 0 <= pos < len(self.adapter.items):
                self.open_picker(self.adapter.items[pos][0])

        def item_long(parent, view, pos, iid):
            pos = int(pos)
            if 0 <= pos < len(self.adapter.items):
                self._row_menu(self.adapter.items[pos][0])
            return True
        c1 = make_proxy("android.widget.AdapterView$OnItemClickListener", {"onItemClick": item_click})
        c2 = make_proxy("android.widget.AdapterView$OnItemLongClickListener", {"onItemLongClick": item_long},
                        bools=("onItemLongClick",))
        lv.setOnItemClickListener(c1)
        lv.setOnItemLongClickListener(c2)
        self.refs.extend([c1, c2])
        self.listview = lv
        body.addView(lv, k.flp(MATCH, MATCH))
        self.empty = k.text("", 14, p["hint"], lines=4, gravity=G_CENTER)
        self.empty.setPadding(k.dp(32), 0, k.dp(32), 0)
        self.empty.setVisibility(GONE)
        body.addView(self.empty, k.flp(MATCH, WRAP, G_CENTER))
        page.addView(body, k.llp(MATCH, 0, 1.0, t=2))
        return page

    def snack(self, text, kind="info"):
        try:
            if self.dialog is None or not self.dialog.isShowing():
                return False
            p = self.k.p
            col = {"ok": p["ok"], "err": p["danger"]}.get(kind, p["accent"])
            self.snack_view.setBackground(self.k.shape(0xF0141418, radius=14, stroke=1.5, stroke_color=col))
            self.snack_view.setText(text)
            self.snack_view.setVisibility(VISIBLE)
            self.snack_view.setAlpha(0.0)
            self.snack_view.setTranslationY(float(-self.k.dp(8)))
            self.snack_view.animate().alpha(1.0).translationY(0.0).setDuration(160).start()
            self._snack_token += 1
            token = self._snack_token

            def hide():
                if token != self._snack_token:
                    return
                try:
                    self.snack_view.animate().alpha(0.0).setDuration(200).start()
                except Exception:
                    pass
                post_ui(lambda: (self.snack_view.setVisibility(GONE) if token == self._snack_token else None), 220)
            post_ui(hide, 2000)
            return True
        except Exception:
            log_exc("snack")
            return False

    # ── окно ──
    def _win(self):
        return self.dialog.getWindow() if self.dialog is not None else None

    def _apply_expanded_window(self):
        w = self._win()
        if w is None:
            return
        w.clearFlags(FLAG_NOT_FOCUSABLE)
        w.setGravity(G_BOTTOM)
        lp = w.getAttributes()
        lp.x = 0
        lp.y = 0
        w.setAttributes(lp)
        w.setLayout(MATCH, int(self.screen_h * self.height_frac))
        try:
            w.getDecorView().setPadding(0, 0, 0, 0)
        except Exception:
            pass

    def _apply_bubble_window(self):
        w = self._win()
        if w is None:
            return
        w.addFlags(FLAG_NOT_FOCUSABLE)
        w.setGravity(G_BOTTOM | G_RIGHT)
        w.setLayout(self.k.dp(66), self.k.dp(66))
        lp = w.getAttributes()
        lp.x = int(self.plugin.get_setting("bubble_x", self.k.dp(14)) or 0)
        lp.y = int(self.plugin.get_setting("bubble_y", self.k.dp(110)) or 0)
        w.setAttributes(lp)

    def show(self):
        if self.dialog is None:
            self.build()
        self.engine.snapshot_screen()
        self.refresh_list(first=True)
        self.state = "expanded"
        self.sheet.setVisibility(VISIBLE)
        self.bubble_host.setVisibility(GONE)
        self.bubble.setVisibility(GONE)
        self._apply_expanded_window()
        self.dialog.show()
        self._apply_expanded_window()

    def expand(self):
        if self.dialog is None:
            return self.show()
        hide_keyboard(self.search)
        self.engine.snapshot_screen()
        self.sheet.setVisibility(VISIBLE)
        self.bubble_host.setVisibility(GONE)
        self.bubble.setVisibility(GONE)
        self.state = "expanded"
        self._apply_expanded_window()
        if self.page == "list":
            self.refresh_list()
        if not self.dialog.isShowing():
            self.dialog.show()

    def collapse(self):
        if self.dialog is None:
            return
        hide_keyboard(self.search)
        hide_keyboard(self.picker.hex)
        self.sheet.setVisibility(GONE)
        self.bubble_host.setVisibility(VISIBLE)
        self.bubble.setVisibility(VISIBLE)
        n = len(self.engine.overrides)
        self.bubble_badge.setText(str(n))
        self.bubble_badge.setVisibility(VISIBLE if n else GONE)
        self.state = "bubble"
        self._apply_bubble_window()

    def hide_temporarily(self):
        try:
            hide_keyboard(self.search)
            hide_keyboard(self.picker.hex)
            self.dialog.hide()
        except Exception:
            pass

    def unhide(self):
        try:
            if self.dialog is not None:
                self.dialog.show()
        except Exception:
            pass

    def close(self):
        if self.page == "picker" and self.editing:
            self.engine.anim_revert(self.editing)
            self.engine.cancel_preview()
        self.engine.stop_blink()
        try:
            hide_keyboard(self.search)
        except Exception:
            pass
        try:
            if self.dialog is not None:
                self.dialog.dismiss()
        except Exception:
            pass
        self.dialog = None
        self.state = "closed"
        if self.engine.dirty:
            self.engine.dirty = False
            self.engine.rebuild_hidden()
        if self.plugin.panel is self:
            self.plugin.panel = None

    def back(self):
        if self.state == "bubble":
            return
        if self.page == "picker":
            self.picker_cancel()
        else:
            self.collapse()

    # ── жесты ──
    def _handle_touch(self, v, e):
        act = int(e.getActionMasked())
        y = float(e.getRawY())
        if act == A_DOWN:
            self._drag = {"y": y, "h": int(self.screen_h * self.height_frac), "moved": False}
            return True
        st = getattr(self, "_drag", None)
        if st is None:
            return True
        dy = y - st["y"]
        if abs(dy) > self.k.dp(6):
            st["moved"] = True
        if act == A_MOVE and st["moved"]:
            h = int(st["h"] - dy)
            h = max(int(self.screen_h * 0.2), min(int(self.screen_h * 0.93), h))
            st["cur"] = h
            w = self._win()
            if w is not None:
                w.setLayout(MATCH, h)
        elif act in (A_UP, A_CANCEL):
            self._drag = None
            if not st["moved"]:
                self.height_frac = 0.88 if self.height_frac < 0.7 else 0.56
                self._apply_expanded_window()
            else:
                h = st.get("cur", st["h"])
                if h < self.screen_h * 0.3:
                    self.collapse()
                else:
                    self.height_frac = h / float(self.screen_h)
                    self._apply_expanded_window()
        return True

    def _bubble_touch(self, v, e):
        act = int(e.getActionMasked())
        rx, ry = float(e.getRawX()), float(e.getRawY())
        w = self._win()
        if w is None:
            return True
        lp = w.getAttributes()
        if act == A_DOWN:
            self._bdrag = {"x": rx, "y": ry, "lx": int(lp.x), "ly": int(lp.y), "moved": False,
                           "t": time.time()}
            v.animate().scaleX(0.9).scaleY(0.9).setDuration(120).start()
            return True
        st = getattr(self, "_bdrag", None)
        if st is None:
            return True
        dx, dy = rx - st["x"], ry - st["y"]
        if abs(dx) > self.k.dp(8) or abs(dy) > self.k.dp(8):
            st["moved"] = True
        if act == A_MOVE and st["moved"]:
            sw = int(self.act.getResources().getDisplayMetrics().widthPixels)
            lp.x = int(max(0, min(sw - self.k.dp(66), st["lx"] - dx)))
            lp.y = int(max(0, min(self.screen_h - self.k.dp(120), st["ly"] - dy)))
            w.setAttributes(lp)
        elif act in (A_UP, A_CANCEL):
            v.animate().scaleX(1.0).scaleY(1.0).setDuration(120).start()
            self._bdrag = None
            if st["moved"]:
                self.plugin.set_setting("bubble_x", int(lp.x))
                self.plugin.set_setting("bubble_y", int(lp.y))
            elif act == A_UP:
                if time.time() - st.get("t", 0) > 0.45:
                    self.expand()
                    post_ui(self.start_inspector, 80)   # долгое нажатие — выбрать элемент
                else:
                    self.expand()
        return True

    # ── список ──
    def set_tab(self, tab):
        self.tab = tab
        self.refresh_list()
        try:
            self.listview.setSelection(0)
        except Exception:
            pass

    def _on_search(self, text):
        self.query = text.strip()
        self.search_clear.setVisibility(VISIBLE if self.query else GONE)
        self.refresh_list()

    def _base_items(self, tab):
        eng = self.engine
        if tab == "screen":
            return [(n, None) for n in eng.screen.get("keys", [])]
        if tab == "changed":
            return [(n, None) for n in sorted(eng.overrides) if eng.key_id(n) >= 0]
        if tab == "found":
            return [(n, tags) for (n, tags) in self.found]
        return [(n, None) for n in eng.all_keys()]

    def refresh_list(self, first=False):
        eng = self.engine
        p = self.k.p
        if first and not eng.screen.get("keys") and self.tab == "screen":
            self.tab = "all"
        if self.tab == "found" and not self.found:
            self.tab = "screen" if eng.screen.get("keys") else "all"
        counts = {
            "screen": len(eng.screen.get("keys", [])),
            "all": len(eng.all_keys()),
            "changed": len([n for n in eng.overrides if eng.key_id(n) >= 0]),
            "found": len(self.found),
        }
        for key, (t, label) in self.chips.items():
            if key == "found" and not self.found:
                t.setVisibility(GONE)
                continue
            t.setVisibility(VISIBLE)
            sel = key == self.tab
            t.setText("%s  %d" % (label, counts[key]))
            if sel:
                t.setBackground(self.k.shape(p["accent"], radius=17))
                t.setTextColor(ji(p["on_accent"]))
            else:
                t.setBackground(self.k.ripple(self.k.shape(p["card"], radius=17), radius=17))
                t.setTextColor(ji(p["sub"]))
        items = self._base_items(self.tab)
        q = self.query.lower()
        if q:
            if q.startswith("#"):
                qq = q[1:].upper()
                items = [(n, t) for (n, t) in items
                         if qq in hex_color(eng.get(eng.key_id(n)))[1:]]
            else:
                items = [(n, t) for (n, t) in items
                         if q in n.lower() or q in friendly_name(n).lower() or q in key_hint(n).lower()]
        self.adapter.set_items(items)
        title = eng.screen.get("title") or "—"
        self.head_sub.setText("Экран: %s  ·  изменено: %d" % (title, counts["changed"]))
        if items:
            self.empty.setVisibility(GONE)
        else:
            if self.tab == "screen" and not q:
                msg = "Этот экран не сообщает свои цвета.\nОткройте вкладку «Все» или найдите элемент пипеткой ⌖"
            elif self.tab == "changed" and not q:
                msg = "Пока ничего не изменено"
            else:
                msg = "Ничего не найдено"
            self.empty.setText(msg)
            self.empty.setVisibility(VISIBLE)

    # ── редактирование ──
    def open_picker(self, name, alts=None, from_tap=False):
        eng = self.engine
        kid = eng.key_id(name)
        if kid < 0:
            toast("Ключ не найден в этой версии: " + name, "err")
            return
        hide_keyboard(self.search)
        if self.page == "picker" and self.editing and self.editing != name:
            eng.anim_revert(self.editing)
            eng.cancel_preview()
        self.editing = name
        eng.begin_preview(kid)
        self.list_page.setVisibility(GONE)
        self.picker_view.setVisibility(VISIBLE)
        self.page = "picker"
        self.picker.load(name, kid, eng.get(kid), name in eng.overrides)
        if alts is not None:
            self.picker_alts = list(alts)
        elif not getattr(self, "_keep_alts", False):
            self.picker_alts = []
        self.picker.set_alts(self.picker_alts, name)
        if self.height_frac < 0.6:
            self.height_frac = 0.66
            self._apply_expanded_window()
        if from_tap:
            # элемент точно на этом экране — только подсветить, никуда не переходить
            post_ui(lambda: self.locate_key(name, full=False), 200)
        elif bool(self.plugin.get_setting("auto_highlight", True)):
            def auto():
                on_screen = name in eng.screen.get("keys", []) or bool(eng.rects_for_key(kid))
                if not on_screen and bool(self.plugin.get_setting("auto_navigate", True)):
                    self.locate_key(name, full=True)     # перейти туда, где элемент
                else:
                    self.locate_key(name, full=False)
            post_ui(auto, 180)
        post_ui(lambda: self._update_where(name), 60)

    def switch_alt(self, name):
        """Переключиться на другой цвет из того же места (иконка ↔ фон ↔ текст)."""
        if name == self.editing:
            return
        self._keep_alts = True
        try:
            self.open_picker(name, from_tap=True)
        finally:
            self._keep_alts = False

    def _back_to_list(self):
        self.picker_alts = []
        self.editing = None
        self.page = "list"
        self.picker_view.setVisibility(GONE)
        self.list_page.setVisibility(VISIBLE)
        self.refresh_list()

    def picker_cancel(self):
        hide_keyboard(self.picker.hex)
        self.engine.stop_blink()
        if self.editing:
            self.engine.anim_revert(self.editing)
        self.engine.cancel_preview()
        self._back_to_list()

    def picker_apply(self, color):
        name = self.editing
        if not name:
            return self._back_to_list()
        self.engine.stop_blink()
        self.engine.commit(self.engine.key_id(name), color)
        self.engine.anim_set(name, self.picker.anim, persist=True)
        self.plugin.push_recent(color)
        toast("%s → %s" % (friendly_name(name), hex_color(color)), "ok")
        self._back_to_list()

    def picker_reset(self):
        name = self.editing
        self.engine.stop_blink()
        self.engine._preview = None
        if name:
            self.engine.anim_set(name, None, persist=True)
            self.engine.remove_override(name)
            toast("Сброшено: " + friendly_name(name), "ok")
        self._back_to_list()

    def ask_key_color(self, cb):
        """Выбрать цвет другого ключа (по имени из поиска)."""
        k = self.k
        if AlertDialogBuilder is None:
            return
        box = k.linear(True)
        box.setPadding(k.dp(22), k.dp(6), k.dp(22), 0)
        e = J("android.widget.EditText")(self.act)
        e.setHint("например: actionBarDefault")
        e.setSingleLine(True)
        box.addView(e)

        def ok(b, w):
            name = str(e.getText().toString()).strip()
            kid = self.engine.key_id(name)
            if kid < 0:
                toast("Нет такого ключа: " + name, "err")
                return
            cb(self.engine.get(kid))
        try:
            b = AlertDialogBuilder(self.act)
            b.set_title("Цвет другого ключа")
            b.set_view(box)
            b.set_positive_button("Взять", ok)
            b.set_negative_button("Отмена", None)
            b.show()
        except Exception:
            log_exc("ask_key_color")

    # ── меню ──
    def menu(self, title, items, cb):
        if AlertDialogBuilder is None:
            return
        try:
            b = AlertDialogBuilder(self.act)
            b.set_title(title)
            b.set_items(items, lambda bb, which: post_ui(lambda: cb(int(which))))
            b.show()
        except Exception:
            log_exc("menu")

    def confirm(self, title, message, ok_text, cb, danger=True):
        if AlertDialogBuilder is None:
            cb()
            return
        try:
            b = AlertDialogBuilder(self.act)
            b.set_title(title)
            b.set_message(message)
            b.set_positive_button(ok_text, lambda bb, w: post_ui(cb))
            b.set_negative_button("Отмена", None)
            b.show()
            if danger:
                try:
                    b.make_button_red(AlertDialogBuilder.BUTTON_POSITIVE)
                except Exception:
                    pass
        except Exception:
            log_exc("confirm")

    def _row_menu(self, name):
        eng = self.engine
        kid = eng.key_id(name)
        changed = name in eng.overrides
        items = ["Изменить цвет", "Показать, где это (с переходом)", "Скопировать имя ключа", "Скопировать цвет"]
        if changed:
            items.append("Сбросить изменение")

        def pick(i):
            if i == 0:
                self.open_picker(name)
            elif i == 1:
                self.locate_key(name, full=True)
            elif i == 2:
                clipboard_set(name)
                toast("Скопировано: " + name, "ok")
            elif i == 3:
                clipboard_set(hex_color(eng.get(kid)))
                toast("Скопировано: " + hex_color(eng.get(kid)), "ok")
            elif i == 4:
                eng.remove_override(name)
                self.refresh_list()
                toast("Сброшено: " + friendly_name(name), "ok")
        self.menu(friendly_name(name), items, pick)

    def _list_menu(self):
        plugin = self.plugin
        eng = self.engine
        hl = bool(plugin.get_setting("auto_highlight", True))
        an = bool(plugin.get_setting("auto_navigate", True))
        entries = []

        def add(label, fn):
            entries.append((label, fn))

        def ribbon():
            names = [n for n in eng.screen.get("keys", []) if not RIBBON_SKIP.search(n)]
            if not names:
                toast("На этом экране нет подходящих элементов", "err")
                return
            cnt = eng.anim_ribbon(names)
            toast("RGB-лента: %d элементов" % cnt, "ok")
            self.refresh_list()

        def stop_all():
            cnt = eng.anim_clear_all()
            toast("Переливы остановлены: %d" % cnt if cnt else "Переливов нет", "ok" if cnt else "info")
            self.refresh_list()

        def rebuild():
            eng.refresh_theme()
            eng.rebuild_all()
            post_ui(self._after_rebuild, 450)

        def toggle(key, cur, text):
            plugin.set_setting(key, not cur)
            toast(text + (" выключено" if cur else " включено"))

        def restore():
            n = plugin.restore_backup()
            self.refresh_list()
            if n:
                toast("Возвращено цветов: %d" % n, "ok")

        add("RGB-лента на этом экране", ribbon)
        if eng.anims:
            add("Остановить все переливы (%d)" % len(eng.anims), stop_all)
        add("Экспорт изменений в буфер", plugin.export_to_clipboard)
        add("Импорт из буфера", lambda: (plugin.import_from_clipboard(), self.refresh_list()))
        add("Перерисовать все экраны", rebuild)
        add(("✓ " if hl else "") + "Подсвечивать при выборе ключа", lambda: toggle("auto_highlight", hl, "Подсветка"))
        add(("✓ " if an else "") + "Переходить на экран элемента", lambda: toggle("auto_navigate", an, "Переход на экран"))
        add("Сбросить ВСЕ изменения", lambda: plugin.ask_reset_all(after=self.refresh_list))
        if plugin.get_setting("overrides_backup", ""):
            add("Вернуть последние сброшенные", restore)

        def pick(i):
            if 0 <= i < len(entries):
                entries[i][1]()
        self.menu("Theme Color Editor", [e[0] for e in entries], pick)

    def _after_rebuild(self):
        self.engine.snapshot_screen()
        if self.page == "list":
            self.refresh_list()

    # ── «где этот элемент» ──
    def locate_key(self, name, full=True, allow_nav=True):
        """Показать, где элемент. Если на текущем экране его нет —
        перейти на экран, где он используется, и подсветить там."""
        if not name:
            return
        eng = self.engine
        nav = self.plugin.nav
        kid = eng.key_id(name)
        if kid < 0 or self._busy:
            return
        title = friendly_name(name)
        p = self.k.p
        if not full:
            rects = eng.rects_for_key(kid)
            Overlay.flash(self.act, rects, None, 1500, p)
            eng.blink(kid, times=4, interval=240)
            return

        self._busy = True
        self.hide_temporarily()

        def done():
            self._busy = False
            self.unhide()
            try:
                self._after_rebuild()
                if self.page == "picker" and self.editing:
                    self._update_where(self.editing)
            except Exception:
                log_exc("locate done")

        def show_here(screen_label=None):
            try:
                eng.snapshot_screen()
                rects = eng.rects_for_key(kid)
                where = ("  ·  экран «%s»" % screen_label) if screen_label else ""
                if rects:
                    msg = "%s%s\nнайдено мест: %d" % (title, where, len(rects))
                else:
                    msg = "%s%s\nсмотрите, что мигает" % (title, where)
                Overlay.flash(self.act, rects, msg, 2400, p)
                eng.blink(kid, times=8, interval=260, on_end=lambda: post_ui(done, 150))
            except Exception:
                log_exc("locate show")
                done()

        def go():
            try:
                eng.snapshot_screen()
                rects = eng.rects_for_key(kid)
                if rects or name in eng.screen.get("keys", []) or not allow_nav:
                    show_here()
                    return
                rid = nav.route_for(name)
                if rid == "dialog":
                    self._demo_dialog(kid, title, done)
                    return
                if rid and nav.navigate(rid):
                    label = ROUTE_LABELS.get(rid, rid)
                    Overlay.flash(self.act, [], "Переход: %s…" % label, 650, p)
                    post_ui(lambda: show_here(label), 700 if rid != "drawer" else 1000)
                    return
                show_here()
            except Exception:
                log_exc("locate")
                done()
        post_ui(go, 160)

    def _demo_dialog(self, kid, title, done):
        """Ключи всплывающих окон: показать пример окна, где этот цвет — ярким."""
        eng = self.engine
        T = J(THEME)
        hi = highlight_for(eng.get(kid))
        anim = False
        try:
            if not T.isAnimatingColor():
                T.setAnimatingColor(True)
                T.setAnimatedColor(int(kid), s32(hi))
                anim = True
        except Exception:
            anim = False
        b = None
        if AlertDialogBuilder is not None:
            try:
                b = AlertDialogBuilder(self.act)
                b.set_title("Пример всплывающего окна")
                b.set_message("Ярким цветом показан элемент:\n«%s»\n\nТак выглядят окна подтверждений и меню." % title)
                b.set_positive_button("Понятно", None)
                b.set_negative_button("Отмена", None)
                b.show()
            except Exception:
                log_exc("demo dialog")
                b = None

        def restore():
            if anim:
                try:
                    T.setAnimatingColor(False)
                except Exception:
                    pass
        post_ui(restore, 800)

        def finish():
            try:
                if b is not None:
                    b.dismiss()
            except Exception:
                pass
            done()
        post_ui(finish, 3200)

    def _update_where(self, name):
        try:
            label = self.plugin.nav.where_label(name)
        except Exception:
            label = ""
        if self.page != "picker" or self.editing != name:
            return
        if label == "на этом экране":
            extra = "  •  📍 на этом экране"
        elif label:
            extra = "  •  📍 %s (нажмите метку — перейду)" % label
        else:
            extra = ""
        self.picker.subtitle.setText(self.picker.base_sub + extra)

    # ── пипетка ──
    def start_inspector(self):
        if self._busy:
            return
        self._busy = True
        self.hide_temporarily()

        def go():
            def result(items, pt):
                self._busy = False
                if items is None:
                    self.unhide()
                    return
                self.found = [(it[2], it[3]) for it in items]
                if self.state != "expanded":
                    self.expand()
                self.unhide()
                if self.page == "picker":
                    self.picker_cancel()
                self.query = ""
                try:
                    self.search.setText("")
                except Exception:
                    pass
                if self.found:
                    self.tab = "found"
                    self.refresh_list()
                    # сразу открыть цвет самого подходящего, остальные — переключателями
                    self.open_picker(self.found[0][0], alts=self.found[:12], from_tap=True)
                else:
                    self.refresh_list()
                    toast("Под пальцем не нашлось цветов темы — попробуйте точнее или вкладку «Все»", "err")
            Overlay.inspect(self.act, self.engine, self.k.p, result)
        post_ui(go, 180)


# ════════════════════════════════════════════════════════════════════
#  Оверлей поверх экрана: подсветка и пипетка
# ════════════════════════════════════════════════════════════════════

class Overlay:
    _current = None

    @staticmethod
    def _decor(act):
        return act.getWindow().getDecorView()

    @staticmethod
    def _remove(ov):
        try:
            parent = ov.getParent()
            if parent is not None:
                cast(J("android.view.ViewGroup"), parent).removeView(ov)
        except Exception:
            pass

    @staticmethod
    def _label(k, text, p):
        t = k.text(text, 13.5, 0xFFFFFFFF, bold=True, lines=2, gravity=G_CENTER)
        t.setBackground(k.shape(0xE6141418, radius=18, stroke=1, stroke_color=(p["accent"] & 0xFFFFFF) | 0xAA000000))
        t.setPadding(k.dp(16), k.dp(9), k.dp(16), k.dp(9))
        return t

    @staticmethod
    def flash(act, rects, label, duration, p):
        """Рамки вокруг элементов + подпись. Не перехватывает касания."""
        try:
            decor = Overlay._decor(act)
            k = Kit(act, p)
            ov = k.frame()
            ov.setClickable(False)
            ov.setFocusable(False)
            OA = J("android.animation.ObjectAnimator")
            loc = jarray(jint)([0, 0])
            decor.getLocationInWindow(loc)
            ox, oy = int(loc[0]), int(loc[1])
            pad = k.dp(3)
            for r in rects[:40]:
                v = k.view()
                v.setBackground(k.shape(0x22FF2D95, radius=8, stroke=2.5, stroke_color=0xFFFF2D95))
                lp = k.flp(r[2] + pad * 2, r[3] + pad * 2)
                lp.leftMargin = int(r[0] - ox - pad)
                lp.topMargin = int(r[1] - oy - pad)
                ov.addView(v, lp)
                anim = OA.ofFloat(v, "alpha", jarray(jfloat)([1.0, 0.25]))
                anim.setDuration(280)
                anim.setRepeatCount(max(1, int(duration / 280) - 1))
                anim.setRepeatMode(2)
                anim.start()
            if label:
                t = Overlay._label(k, label, p)
                top = 0
                try:
                    top = int(J("org.telegram.messenger.AndroidUtilities").statusBarHeight)
                except Exception:
                    top = k.dp(24)
                lp = k.flp(WRAP, WRAP, G_TOP | G_CENTER_H)
                lp.topMargin = top + k.dp(64)
                ov.addView(t, lp)
            cast(J("android.view.ViewGroup"), decor).addView(ov, J("android.widget.FrameLayout$LayoutParams")(MATCH, MATCH))
            ov.setAlpha(0.0)
            ov.animate().alpha(1.0).setDuration(150).start()

            def end():
                try:
                    ov.animate().alpha(0.0).setDuration(200).start()
                except Exception:
                    pass
                post_ui(lambda: Overlay._remove(ov), 230)
            post_ui(end, int(duration))
        except Exception:
            log_exc("Overlay.flash")

    @staticmethod
    def inspect(act, engine, p, cb):
        """Пипетка: снимок экрана → касание → список ключей."""
        try:
            window = act.getWindow()
            decor = window.getDecorView()
            W, H = int(decor.getWidth()), int(decor.getHeight())
            Bitmap = J("android.graphics.Bitmap")
            bmp = Bitmap.createBitmap(max(1, W), max(1, H), J("android.graphics.Bitmap$Config").ARGB_8888)
            engine.snapshot_screen()
            state = {"done": False}

            def start_overlay():
                if state["done"]:
                    return
                state["done"] = True
                try:
                    Overlay._inspect_overlay(act, engine, p, bmp, cb)
                except Exception:
                    log_exc("inspect overlay")
                    cb(None, None)

            def fallback_draw():
                try:
                    decor.draw(J("android.graphics.Canvas")(bmp))
                except Exception:
                    log_exc("decor.draw")
                start_overlay()

            used_pixelcopy = False
            try:
                if int(J("android.os.Build$VERSION").SDK_INT) >= 26:
                    def finished(code):
                        if int(code) != 0:
                            fallback_draw()
                        else:
                            start_overlay()
                    lst = make_proxy("android.view.PixelCopy$OnPixelCopyFinishedListener",
                                     {"onPixelCopyFinished": finished})
                    Overlay._keep = lst
                    handler = J("android.os.Handler")(J("android.os.Looper").getMainLooper())
                    J("android.view.PixelCopy").request(window, bmp, lst, handler)
                    used_pixelcopy = True
            except Exception:
                log_exc("PixelCopy")
                used_pixelcopy = False
            if not used_pixelcopy:
                fallback_draw()
            else:
                post_ui(lambda: (None if state["done"] else fallback_draw()), 1200)
        except Exception:
            log_exc("inspect")
            cb(None, None)

    @staticmethod
    def _inspect_overlay(act, engine, p, bmp, cb):
        k = Kit(act, p)
        decor = Overlay._decor(act)
        ov = k.frame()
        ov.setBackgroundColor(s32(0x26000000))
        ov.setClickable(True)

        hint = Overlay._label(k, "👆 Нажмите на кнопку или элемент,\nцвет которого хотите изменить", p)
        hint.setTextSize(1, 15.0)
        top = k.dp(24)
        try:
            top = int(J("org.telegram.messenger.AndroidUtilities").statusBarHeight)
        except Exception:
            pass
        hlp = k.flp(WRAP, WRAP, G_TOP | G_CENTER_H)
        hlp.topMargin = top + k.dp(14)
        ov.addView(hint, hlp)
        try:
            hint.setTranslationY(float(-k.dp(30)))
            hint.animate().translationY(0.0).setDuration(260).start()
        except Exception:
            pass

        cancel = k.pill_button("Отмена", filled=True, color=0xE6141418)
        clp = k.flp(WRAP, k.dp(44), G_BOTTOM | G_CENTER_H)
        clp.bottomMargin = k.dp(40)
        ov.addView(cancel, clp)

        ring_sz = k.dp(46)
        ring = k.frame()
        ring_d = k.shape(0x00000000, oval=True, stroke=3, stroke_color=0xFFFFFFFF)
        ring.setBackground(ring_d)
        dot = k.view()
        dot.setBackground(k.shape(0xFFFF2D95, oval=True, stroke=1.5, stroke_color=0xFFFFFFFF))
        ring.addView(dot, k.flp(k.dp(9), k.dp(9), G_CENTER))
        ring.setVisibility(GONE)
        ov.addView(ring, k.flp(ring_sz, ring_sz))

        chip = k.text("", 13, 0xFFFFFFFF, bold=True, mono=True, gravity=G_CENTER)
        chip_bg = k.shape(0xE6141418, radius=12)
        chip.setBackground(chip_bg)
        chip.setPadding(k.dp(10), k.dp(5), k.dp(10), k.dp(5))
        chip.setVisibility(GONE)
        ov.addView(chip, k.flp(WRAP, WRAP))

        magnifier = None
        try:
            if int(J("android.os.Build$VERSION").SDK_INT) >= 28:
                magnifier = J("android.widget.Magnifier")(ov)
        except Exception:
            magnifier = None

        bw, bh = int(bmp.getWidth()), int(bmp.getHeight())
        st = {"finished": False}

        def pixel_at(x, y):
            xi = max(0, min(bw - 1, int(x)))
            yi = max(0, min(bh - 1, int(y)))
            try:
                return u32(bmp.getPixel(xi, yi))
            except Exception:
                return None

        def finish(items, pt):
            if st["finished"]:
                return
            st["finished"] = True
            try:
                if magnifier is not None:
                    magnifier.dismiss()
            except Exception:
                pass
            Overlay._remove(ov)
            try:
                bmp.recycle()
            except Exception:
                pass
            cb(items, pt)

        on_click(cancel, lambda: finish(None, None), k.refs)

        def touch(v, e):
            act_ = int(e.getActionMasked())
            x, y = float(e.getX()), float(e.getY())
            if "ox" not in st:
                loc0 = jarray(jint)([0, 0])
                ov.getLocationInWindow(loc0)
                st["ox"], st["oy"] = int(loc0[0]), int(loc0[1])
            wx, wy = int(x) + st["ox"], int(y) + st["oy"]
            if act_ in (A_DOWN, A_MOVE):
                ring.setVisibility(VISIBLE)
                ring.setTranslationX(float(x - ring_sz / 2.0))
                ring.setTranslationY(float(y - ring_sz / 2.0))
                px = pixel_at(wx, wy)
                if px is not None:
                    chip.setText(hex_color(px, False))
                    chip_bg.setStroke(k.dp(2), ji(px | 0xFF000000))
                    chip.setVisibility(VISIBLE)
                    chip.setTranslationX(float(x + k.dp(30)))
                    chip.setTranslationY(float(y - k.dp(70)))
                if magnifier is not None:
                    try:
                        magnifier.show(float(x), float(y))
                    except Exception:
                        pass
                hint.setVisibility(INVISIBLE)
            elif act_ == A_UP:
                px = pixel_at(wx, wy)
                rad = k.dp(6)
                samples = []
                for gx in (-2, -1, 0, 1, 2):
                    for gy in (-2, -1, 0, 1, 2):
                        samples.append(pixel_at(wx + gx * rad / 2.0, wy + gy * rad / 2.0))
                ring.setVisibility(GONE)
                chip.setVisibility(GONE)
                try:
                    if magnifier is not None:
                        magnifier.dismiss()
                except Exception:
                    pass
                items = []
                try:
                    items = engine.find_at(wx, wy, px, samples)
                except Exception:
                    log_exc("find_at")
                best = None
                for it in items:
                    if it[4] is not None:
                        best = it[4]
                        break
                label = friendly_name(items[0][2]) if items else None
                Overlay.flash(act, [best] if best is not None else [], label, 700, p)
                post_ui(lambda: finish(items, (wx, wy)), 480 if items else 0)
            elif act_ == A_CANCEL:
                ring.setVisibility(GONE)
                chip.setVisibility(GONE)
            return True

        on_touch(ov, touch, k.refs)
        Overlay._keep_refs = k.refs
        cast(J("android.view.ViewGroup"), decor).addView(ov, J("android.widget.FrameLayout$LayoutParams")(MATCH, MATCH))
        ov.setAlpha(0.0)
        ov.animate().alpha(1.0).setDuration(160).start()


# ════════════════════════════════════════════════════════════════════
#  Плагин
# ════════════════════════════════════════════════════════════════════

class ColorInspectorPlugin(BasePlugin):

    def on_plugin_load(self):
        global _PLUGIN
        _PLUGIN = self
        self.panel = None
        self._drawer_item = None
        self.engine = Engine(self)
        self.nav = Navigator(self.engine)
        try:
            self.engine.load()
        except Exception:
            log_exc("load overrides")
        try:
            self.engine.load_anims()
        except Exception:
            log_exc("load anims")
        self.engine.install_hook()
        self.engine.install_pinned_hook()
        self.engine.install_chat_theme_hook()
        if self.engine.overrides:
            post_ui(self._initial_apply, 250)
        if self.engine.anims:
            post_ui(self.engine.anim_kick, 900)
        self._update_drawer_item()

    def _initial_apply(self):
        self.engine.refresh_theme()

    def on_plugin_unload(self):
        try:
            if self.panel is not None:
                self.panel.close()
        except Exception:
            pass
        self.panel = None
        try:
            self.engine.stop_blink()
        except Exception:
            pass
        try:
            self.engine.restore_everything()
        except Exception:
            log_exc("restore_everything")
        self._remove_drawer_item()

    def on_app_event(self, event_type):
        try:
            name = str(event_type).upper()
            if "PAUSE" in name or "STOP" in name:
                self.engine.anim_pause(True)        # в фоне перелив не гоняем
            elif "RESUME" in name or "START" in name:
                self.engine.anim_pause(False)
            if "RESUME" in name and self.engine.overrides and not self.engine.hook_ok:
                post_ui(self.engine.refresh_theme, 200)
        except Exception:
            pass

    # ── пункт в боковом меню ──
    def _update_drawer_item(self, enabled=None):
        self._remove_drawer_item()
        if enabled is None:
            enabled = bool(self.get_setting("drawer_item", True))
        if enabled:
            try:
                self._drawer_item = self.add_menu_item(MenuItemData(
                    menu_type=MenuItemType.DRAWER_MENU,
                    text="Редактор цветов",
                    icon="msg_palette",
                    on_click=lambda ctx: post_ui(self.open_editor),
                    priority=0,
                ))
            except Exception:
                log_exc("add_menu_item")

    def _remove_drawer_item(self):
        if self._drawer_item is not None:
            try:
                self.remove_menu_item(self._drawer_item)
            except Exception:
                pass
            self._drawer_item = None

    # ── редактор ──
    def open_editor(self):
        act = get_activity()
        if act is None:
            toast("Не удалось открыть редактор: нет активного окна", "err")
            return
        try:
            if self.panel is not None and self.panel.dialog is not None:
                if self.panel.act is act:
                    self.panel.expand()
                    return
                self.panel.close()
            self.panel = EditorPanel(self, act)
            self.panel.show()
        except Exception:
            log_exc("open_editor")
            toast("Ошибка открытия редактора — подробности в логах", "err")

    # ── недавние цвета ──
    def recent_colors(self):
        try:
            data = json.loads(self.get_setting("recent", "[]") or "[]")
            out = []
            for x in data:
                c = parse_color(x)
                if c is not None:
                    out.append(c)
            return out[:14]
        except Exception:
            return []

    def push_recent(self, color):
        rec = [c for c in self.recent_colors() if c != u32(color)]
        rec.insert(0, u32(color))
        self.set_setting("recent", json.dumps([hex_color(c) for c in rec[:14]]))

    # ── экспорт / импорт / сброс ──
    def export_text(self):
        lines = ["%s=%s" % (k, hex_color(v)) for k, v in sorted(self.engine.overrides.items())]
        return "\n".join(lines)

    def export_to_clipboard(self):
        if not self.engine.overrides:
            toast("Нет изменений для экспорта")
            return
        try:
            clipboard_set(self.export_text())
            toast("Скопировано изменений: %d (формат .attheme)" % len(self.engine.overrides), "ok")
        except Exception:
            log_exc("export")
            toast("Не удалось скопировать", "err")

    def import_from_clipboard(self):
        text = clipboard_get()
        pairs = parse_import(text)
        eng = self.engine
        good = 0
        for name, c in pairs:
            if eng.key_id(name) >= 0 and name not in NON_COLOR_KEYS:
                eng.overrides[name] = c
                good += 1
        if not good:
            toast("В буфере нет цветов (ожидается key=#AARRGGBB по строкам или JSON)", "err")
            return
        eng.save()
        eng.dirty = True
        eng.refresh_theme()
        toast("Импортировано цветов: %d" % good, "ok")

    def _stop_anims(self):
        n = self.engine.anim_clear_all()
        toast("Переливы остановлены: %d" % n if n else "Переливов нет", "ok" if n else "info")

    def restore_backup(self):
        raw = self.get_setting("overrides_backup", "")
        pairs = parse_import(raw) if raw else []
        eng = self.engine
        n = 0
        for name, c in pairs:
            if eng.key_id(name) >= 0:
                eng.overrides[name] = c
                n += 1
        if n:
            eng.dirty = True
            eng.save()
            self.set_setting("overrides_backup", "")
            eng.refresh_theme()
        return n

    def ask_reset_all(self, after=None):
        n = len(self.engine.overrides)
        if not n:
            toast("Изменений нет")
            return

        def do():
            self.engine.reset_all()
            toast("Все изменения сброшены", "ok")
            if after:
                after()
        if self.panel is not None and self.panel.dialog is not None:
            self.panel.confirm("Сбросить всё?", "Будут удалены изменения цветов: %d." % n, "Сбросить", do)
        elif AlertDialogBuilder is not None:
            try:
                b = AlertDialogBuilder(get_activity())
                b.set_title("Сбросить всё?")
                b.set_message("Будут удалены изменения цветов: %d." % n)
                b.set_positive_button("Сбросить", lambda bb, w: post_ui(do))
                b.set_negative_button("Отмена", None)
                b.show()
            except Exception:
                do()
        else:
            do()

    # ── настройки ──
    def create_settings(self):
        """Ошибка здесь прячет кнопку настроек, поэтому строим максимально бережно."""
        try:
            items = self._settings_items()
            return [it for it in items if it is not None]
        except Exception:
            log_exc("create_settings")
            try:
                return [Header(text="Theme Color Editor"),
                        Text(text="Открыть редактор цветов", on_click=lambda *a: post_ui(self.open_editor))]
            except Exception:
                return []

    def _settings_items(self):
        n = 0
        try:
            n = len(self.engine.overrides)
        except Exception:
            pass
        return [
            S_header("Редактор"),
            S_text(text="Открыть редактор цветов", icon="msg_palette", accent=True,
                 on_click=lambda *a: post_ui(self.open_editor)),
            S_switch(key="drawer_item", text="Пункт в боковом меню", default=True,
                   subtext="«Редактор цветов» в меню слева", icon="msg_list",
                   on_change=lambda v=None, *a: post_ui(
                       lambda: self._update_drawer_item(bool(v) if isinstance(v, bool) else None))),
            S_switch(key="auto_highlight", text="Подсвечивать элемент при выборе", default=True,
                   subtext="Рамка и мигание там, где используется цвет", icon="msg_location"),
            S_switch(key="auto_navigate", text="Переходить на экран элемента", default=True,
                   subtext="Если цвета нет на текущем экране — открыть профиль, чат, настройки и т.п.",
                   icon="msg_arrow_forward"),
            S_selector(key="style", text="Оформление редактора", default=0,
                     items=["Как у темы", "Тёмное", "Светлое"], icon="msg_theme"),
            S_header("RGB-перелив"),
            S_selector(key="anim_fps", text="Плавность перелива", default=1,
                     items=["Экономно (10 к/с)", "Обычно (20 к/с)", "Плавно (30 к/с)"], icon="msg_theme"),
            S_text(text="Остановить все переливы", icon="msg_reset",
                 on_click=lambda *a: post_ui(self._stop_anims)),
            S_header("Изменения (%d)" % n),
            S_text(text="Экспорт в буфер обмена", icon="msg_copy",
                 on_click=lambda *a: post_ui(self.export_to_clipboard)),
            S_text(text="Импорт из буфера обмена", icon="msg_download",
                 on_click=lambda *a: post_ui(self.import_from_clipboard)),
            S_text(text="Сбросить все изменения", icon="msg_reset", red=True,
                 on_click=lambda *a: post_ui(self.ask_reset_all)),
            S_divider(text="Изменения действуют поверх любой темы и сохраняются после перезапуска. "
                         "В редакторе: ⌖ — пипетка (нажмите на элемент экрана), значок метки — показать, "
                         "где элемент (с переходом на нужный экран); потяните за полоску сверху, "
                         "чтобы изменить высоту окна."),
        ]


def _safe_setting(cls, required, **kw):
    """Создать элемент настроек; если SDK не знает какой-то параметр —
    повторить без необязательных, а не уронить весь экран настроек."""
    try:
        return cls(**kw)
    except TypeError:
        log("settings: %s не принял %s" % (getattr(cls, "__name__", cls), sorted(set(kw) - set(required))))
    base = {k: v for k, v in kw.items() if k in required}
    for opt in ("on_change", "on_click", "icon", "accent", "red", "subtext", "items"):
        if opt in kw:
            trial = dict(base)
            trial[opt] = kw[opt]
            try:
                cls(**trial)
                base = trial
            except TypeError:
                pass
    try:
        return cls(**base)
    except Exception:
        log_exc("settings item")
        return None


def S_header(text):
    return _safe_setting(Header, ("text",), text=text)


def S_text(**kw):
    return _safe_setting(Text, ("text",), **kw)


def S_switch(**kw):
    return _safe_setting(Switch, ("key", "text", "default"), **kw)


def S_selector(**kw):
    return _safe_setting(Selector, ("key", "text", "default", "items"), **kw)


def S_divider(**kw):
    return _safe_setting(Divider, (), **kw)


def parse_import(text):
    out = []
    if not text:
        return out
    t = text.strip()
    if t.startswith("{"):
        try:
            data = json.loads(t)
            for k, v in data.items():
                c = parse_color(v) if isinstance(v, str) else (u32(v) if isinstance(v, int) else None)
                if c is not None:
                    out.append((str(k).strip(), c))
            return out
        except Exception:
            pass
    for line in t.replace("\r", "\n").replace(";", "\n").split("\n"):
        line = line.strip()
        if not line or line.startswith("#") and "=" not in line:
            continue
        if "=" in line:
            k, v = line.split("=", 1)
        elif ":" in line:
            k, v = line.split(":", 1)
        else:
            continue
        k = k.strip().strip('"').strip("'")
        c = parse_color(v.strip().strip(",").strip('"').strip("'"))
        if k and c is not None:
            out.append((k, c))
    return out
