def log(msg):
    try:
        if _PLUGIN is not None:
            _PLUGIN.log("[ThemeColorEditor] " + str(msg))
            return
    except Exception:
        pass
    try:
        print("[ThemeColorEditor] " + str(msg))
    except Exception:
        pass


def log_exc(where):
    log(where + ":\n" + traceback.format_exc())


_JC = {}


def J(name):
    cls = _JC.get(name)
    if cls is None:
        cls = jclass(name)
        _JC[name] = cls
    return cls


def s32(c):
    c = int(c) & 0xFFFFFFFF
    return c - 0x100000000 if c & 0x80000000 else c


def u32(c):
    return int(c) & 0xFFFFFFFF


def ji(c):
    """Цвет как jint (для перегруженных методов int/long)."""
    return jint(s32(c))


def c_a(c):
    return (c >> 24) & 0xFF


def c_r(c):
    return (c >> 16) & 0xFF


def c_g(c):
    return (c >> 8) & 0xFF


def c_b(c):
    return c & 0xFF


def argb(a, r, g, b):
    return ((int(a) & 0xFF) << 24) | ((int(r) & 0xFF) << 16) | ((int(g) & 0xFF) << 8) | (int(b) & 0xFF)


def hsv_color(h, s, v, a=255):
    r, g, b = colorsys.hsv_to_rgb((h % 360.0) / 360.0, max(0.0, min(1.0, s)), max(0.0, min(1.0, v)))
    return argb(a, round(r * 255), round(g * 255), round(b * 255))


def color_hsv(c):
    h, s, v = colorsys.rgb_to_hsv(c_r(c) / 255.0, c_g(c) / 255.0, c_b(c) / 255.0)
    return h * 360.0, s, v


def hex_color(c, force_alpha=True):
    c = u32(c)
    if not force_alpha and c_a(c) == 255:
        return "#%06X" % (c & 0xFFFFFF)
    return "#%08X" % c


def parse_color(text):
    """'#RGB', '#RRGGBB', '#AARRGGBB', без '#', или десятичное int (.attheme)."""
    if text is None:
        return None
    t = str(text).strip().replace(" ", "")
    if not t:
        return None
    if t.startswith("#"):
        t = t[1:]
    elif t.lower().startswith("0x"):
        t = t[2:]
    else:
        if t.lstrip("-").isdigit() and (t.startswith("-") or len(t) > 8):
            try:
                return u32(int(t))
            except Exception:
                return None
    if not all(ch in "0123456789abcdefABCDEF" for ch in t):
        return None
    if len(t) == 3:
        t = "".join(ch * 2 for ch in t)
    if len(t) == 4:
        t = "".join(ch * 2 for ch in t)
    if len(t) == 6:
        return 0xFF000000 | int(t, 16)
    if len(t) == 8:
        return int(t, 16)
    return None


def luminance(c):
    def ch(x):
        x /= 255.0
        return x / 12.92 if x <= 0.03928 else ((x + 0.055) / 1.055) ** 2.4
    return 0.2126 * ch(c_r(c)) + 0.7152 * ch(c_g(c)) + 0.0722 * ch(c_b(c))


def color_dist(c1, c2):
    return max(abs(c_r(c1) - c_r(c2)), abs(c_g(c1) - c_g(c2)), abs(c_b(c1) - c_b(c2)))


def highlight_for(c):
    """Яркий цвет, максимально заметный на фоне исходного."""
    cands = [0xFFFF2D95, 0xFF00E5FF, 0xFFFFE600, 0xFF39FF14]
    best, bd = cands[0], -1
    for x in cands:
        d = abs(c_r(x) - c_r(c)) + abs(c_g(x) - c_g(c)) + abs(c_b(x) - c_b(c))
        if d > bd:
            best, bd = x, d
    return best


def as_int(x, default=0):
    if x is None:
        return default
    try:
        return int(x)
    except Exception:
        pass
    try:
        return int(x.intValue())
    except Exception:
        return default


def post_ui(fn, delay=0):
    """Выполнить на UI-потоке, проглатывая ошибки."""
    def run():
        try:
            fn()
        except Exception:
            log_exc("ui callback")
    run_on_ui_thread(run, delay)


def toast(text, kind="info"):
    # когда панель раскрыта, штатный bulletin оказался бы под ней — показываем в панели
    try:
        panel = getattr(_PLUGIN, "panel", None) if _PLUGIN is not None else None
        if panel is not None and panel.state == "expanded" and panel.dialog is not None:
            if panel.snack(str(text), kind):
                return
    except Exception:
        pass
    try:
        if BulletinHelper is not None:
            if kind == "ok":
                BulletinHelper.show_success(text)
            elif kind == "err":
                BulletinHelper.show_error(text)
            else:
                BulletinHelper.show_info(text)
            return
    except Exception:
        pass
    try:
        J("android.widget.Toast").makeText(app_context(), str(text), 0).show()
    except Exception:
        log("toast failed: " + str(text))


def app_context():
    return J("org.telegram.messenger.ApplicationLoader").applicationContext


def get_activity():
    try:
        act = J("org.telegram.ui.LaunchActivity").instance
        if act is not None:
            return act
    except Exception:
        pass
    try:
        from client_utils import get_last_fragment
        f = get_last_fragment()
        if f is not None:
            return f.getParentActivity()
    except Exception:
        pass
    return None


def dp(v):
    try:
        return int(J("org.telegram.messenger.AndroidUtilities").dp(float(v)))
    except Exception:
        try:
            return int(round(float(v) * app_context().getResources().getDisplayMetrics().density))
        except Exception:
            return int(round(float(v) * 2.75))


def clipboard_set(text):
    ctx = app_context()
    cm = ctx.getSystemService("clipboard")
    cm.setPrimaryClip(J("android.content.ClipData").newPlainText("colors", str(text)))


def clipboard_get():
    try:
        ctx = app_context()
        cm = ctx.getSystemService("clipboard")
        clip = cm.getPrimaryClip()
        if clip is None or clip.getItemCount() == 0:
            return ""
        t = clip.getItemAt(0).coerceToText(ctx)
        return str(t) if t is not None else ""
    except Exception:
        log_exc("clipboard_get")
        return ""


# ── reflection ──────────────────────────────────────────────────────

_FIELD_CACHE = {}
_CLASS_CACHE = {}


def java_class_of(name):
    c = _CLASS_CACHE.get(name)
    if c is not None:
        return c
    try:
        if find_class is not None:
            c = find_class(name)
    except Exception:
        c = None
    if c is None:
        c = J("java.lang.Class").forName(name)
    _CLASS_CACHE[name] = c
    return c


def is_ui_thread():
    try:
        L = J("android.os.Looper")
        return L.myLooper() is not None and L.myLooper().equals(L.getMainLooper())
    except Exception:
        return False


def ident(obj):
    try:
        return int(J("java.lang.System").identityHashCode(obj))
    except Exception:
        return id(obj)


def _find_field(cls, name):
    key = (str(cls.getName()), name)
    if key in _FIELD_CACHE:
        return _FIELD_CACHE[key]
    f = None
    c = cls
    while c is not None:
        try:
            f = c.getDeclaredField(name)
            f.setAccessible(True)
            break
        except Exception:
            f = None
            c = c.getSuperclass()
    _FIELD_CACHE[key] = f
    return f


def get_field(obj, name):
    try:
        f = _find_field(obj.getClass(), name)
        return f.get(obj) if f is not None else None
    except Exception:
        return None


def set_field(obj, name, value):
    try:
        f = _find_field(obj.getClass(), name)
        if f is None:
            return False
        f.set(obj, value)
        return True
    except Exception:
        return False


def get_static(class_name, name):
    try:
        f = _find_field(java_class_of(class_name), name)
        return f.get(None) if f is not None else None
    except Exception:
        return None


# ── dynamic proxies (Java-интерфейсы из Python) ─────────────────────

_PROXY_CLASSES = {}


def _forwarder(name, is_bool, default):
    def fwd(self, *args):
        res = None
        fn = None
        try:
            fn = self._ci_fns.get(name)
        except Exception:
            fn = None
        if fn is not None:
            try:
                res = fn(*args)
            except Exception:
                log_exc("proxy " + name)
                res = None
        if res is None:
            res = default
        if is_bool:
            return bool(res)
        return res
    fwd.__name__ = name
    return fwd


def make_proxy(iface, fns, extra=(), bools=(), defaults=None):
    defaults = defaults or {}
    methods = tuple(sorted(set(fns) | set(extra)))
    key = (iface, methods, tuple(sorted(bools)), tuple(sorted(defaults.items())))
    cls = _PROXY_CLASSES.get(key)
    if cls is None:
        ns = {}
        for m in methods:
            ns[m] = _forwarder(m, m in bools, defaults.get(m, False if m in bools else None))
        cls = type("CI_" + iface.rsplit(".", 1)[-1].replace("$", "_"),
                   (dynamic_proxy(J(iface)),), ns)
        _PROXY_CLASSES[key] = cls
    obj = cls()
    obj._ci_fns = dict(fns)
    return obj


def on_click(view, fn, refs=None):
    p = make_proxy("android.view.View$OnClickListener", {"onClick": lambda v: fn()})
    view.setOnClickListener(p)
    if refs is not None:
        refs.append(p)
    return p


def on_long_click(view, fn, refs=None):
    def handler(v):
        fn()
        return True
    p = make_proxy("android.view.View$OnLongClickListener", {"onLongClick": handler}, bools=("onLongClick",))
    view.setOnLongClickListener(p)
    if refs is not None:
        refs.append(p)
    return p


def on_touch(view, fn, refs=None):
    p = make_proxy("android.view.View$OnTouchListener", {"onTouch": fn}, bools=("onTouch",))
    view.setOnTouchListener(p)
    if refs is not None:
        refs.append(p)
    return p


def text_watcher(edit, fn, refs=None):
    def after(s):
        fn(str(s.toString()) if s is not None else "")
    p = make_proxy("android.text.TextWatcher", {"afterTextChanged": after},
                   extra=("beforeTextChanged", "onTextChanged"))
    edit.addTextChangedListener(p)
    if refs is not None:
        refs.append(p)
    return p


