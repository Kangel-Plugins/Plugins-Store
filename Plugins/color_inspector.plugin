def _tokens(key):
    out = []
    for part in key.split("_"):
        out.extend(t.lower() for t in re.findall(r"[A-Z]+(?![a-z])|[A-Z]?[a-z]+|\d+", part))
    return out


def friendly_name(key):
    if not key:
        return ""
    f = FRIENDLY.get(key)
    if f:
        return f
    try:
        return _auto_name(key)
    except Exception:
        return key


def _auto_name(key):
    toks = _tokens(key)
    ctx = ""
    for seq, phrase in _SECTIONS:
        n = len(seq)
        if tuple(toks[:n]) == seq and len(toks) > n:
            toks = toks[n:]
            ctx = phrase
            break
    direction = ""
    mods = []
    adjs = []
    base = []
    for i, t in enumerate(toks):
        nxt = toks[i + 1] if i + 1 < len(toks) else ""
        if t == "in" and nxt in ("message", "messages", "profile", "chat"):
            continue
        if t == "in":
            direction = "во входящих"
        elif t == "out":
            direction = "в исходящих"
        elif t.isdigit():
            if t not in ("1", "21"):
                mods.append("№" + t)
        elif t in _MODS:
            if _MODS[t]:
                mods.append(_MODS[t])
        elif t in _ADJ:
            adjs.append(t)
        else:
            base.append(t)
    if direction and ctx == "в чате":
        ctx = ""
    if not base:
        if adjs:
            base = [adjs.pop()]
        else:
            base = ["color"]
    head_i = None
    for i in range(len(base) - 1, -1, -1):
        if base[i] in _HEADS:
            head_i = i
            break
    if head_i is None:
        head_i = len(base) - 1
    head = base[head_i]
    quals = base[:head_i] + base[head_i + 1:]
    quals.reverse()
    hw = _WORDS.get(head)
    if hw:
        head_nom, gender = hw[0], hw[2]
    else:
        head_nom, gender = head, "m"
    words = []
    for a in adjs:
        words.append(_ADJ[a][_GENDER_IDX.get(gender, 0)])
    words.append(head_nom)
    for q in quals:
        w = _WORDS.get(q)
        words.append(w[1] if w else q)
    if direction:
        words.append(direction)
    if ctx:
        words.append(ctx)
    name = " ".join(w for w in words if w)
    seen = []
    for m in mods:
        if m not in seen:
            seen.append(m)
    if seen:
        name += " (" + ", ".join(seen) + ")"
    return name[:1].upper() + name[1:]

for _c, _ru in (("Red", "красный"), ("Orange", "оранжевый"), ("Violet", "фиолетовый"), ("Green", "зелёный"),
                ("Cyan", "бирюзовый"), ("Blue", "синий"), ("Pink", "розовый")):
    FRIENDLY.setdefault("avatar_nameInMessage" + _c, "Цвет имён в группах: " + _ru)
