def key_hint(name):
    """Раздел интерфейса, к которому относится ключ."""
    if not name:
        return ""
    for prefix, text in PREFIX_HINTS:
        if name.startswith(prefix):
            return text
    return "Цвет темы"


def flag_labels(flags):
    flags = u32(flags)
    out = []
    for bit, label in FLAG_LABELS:
        if flags & bit and label not in out:
            out.append(label)
    return out


