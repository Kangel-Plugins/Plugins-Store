#  UI-кит: стили, drawable, базовые вью
# ════════════════════════════════════════════════════════════════════

DARK = dict(bg=0xFF15151C, card=0xFF1F1F29, card2=0xFF2A2A36, stroke=0xFF30303E,
            text=0xFFF4F4F8, sub=0xFF9C9CAE, hint=0xFF6F6F82, accent=0xFF8E7CFF,
            accent2=0xFF5B8CFF, on_accent=0xFFFFFFFF, danger=0xFFFF5C72, ok=0xFF3DDC97,
            ripple=0x26FFFFFF, handle=0xFF3E3E4E, shadow=0x66000000)
LIGHT = dict(bg=0xFFFFFFFF, card=0xFFF3F3F8, card2=0xFFE8E8F0, stroke=0xFFE0E0EA,
             text=0xFF15151C, sub=0xFF6C6C7E, hint=0xFF9A9AAC, accent=0xFF6B5BEA,
             accent2=0xFF3F7BFF, on_accent=0xFFFFFFFF, danger=0xFFE5484D, ok=0xFF16A34A,
             ripple=0x1F000000, handle=0xFFD3D3DE, shadow=0x33000000)


class Kit:
    def __init__(self, ctx, pal):
        self.ctx = ctx
        self.p = pal
        self.refs = []
        self._bold = None
        self._checker_bmp = None

    def dp(self, v):
        return dp(v)

    @property
    def bold(self):
        if self._bold is None:
            AU = J("org.telegram.messenger.AndroidUtilities")
            tf = None
            try:
                tf = AU.bold()
            except Exception:
                tf = None
            if tf is None:
                try:
                    tf = AU.getTypeface("fonts/rmedium.ttf")
                except Exception:
                    tf = None
            if tf is None:
                tf = J("android.graphics.Typeface").DEFAULT_BOLD
            self._bold = tf
        return self._bold

    # ── drawables ──
    def shape(self, color, radius=0, stroke=0, stroke_color=0, oval=False, radii=None):
        d = J("android.graphics.drawable.GradientDrawable")()
        if oval:
            d.setShape(1)
        d.setColor(ji(color))
        if radii is not None:
            d.setCornerRadii(jarray(jfloat)([float(self.dp(r)) for r in radii for _ in (0, 1)]))
        elif radius and not oval:
            d.setCornerRadius(float(self.dp(radius)))
        if stroke:
            d.setStroke(max(1, int(self.dp(stroke))), ji(stroke_color))
        return d

    def gradient(self, colors, orientation="LEFT_RIGHT", radius=0, oval=False):
        GD = J("android.graphics.drawable.GradientDrawable")
        orient = getattr(J("android.graphics.drawable.GradientDrawable$Orientation"), orientation)
        d = GD(orient, jarray(jint)([s32(c) for c in colors]))
        if oval:
            d.setShape(1)
        elif radius:
            d.setCornerRadius(float(self.dp(radius)))
        return d

    def ripple(self, content=None, radius=12, oval=False, color=None):
        mask = self.shape(0xFFFFFFFF, radius=radius, oval=oval)
        csl = J("android.content.res.ColorStateList").valueOf(ji(color if color is not None else self.p["ripple"]))
        return J("android.graphics.drawable.RippleDrawable")(csl, content, mask)

    def checker(self):
        if self._checker_bmp is None:
            Bitmap = J("android.graphics.Bitmap")
            cell = max(2, self.dp(4))
            bmp = Bitmap.createBitmap(cell * 2, cell * 2, J("android.graphics.Bitmap$Config").ARGB_8888)
            cv = J("android.graphics.Canvas")(bmp)
            cv.drawColor(ji(0xFFFFFFFF))
            p = J("android.graphics.Paint")()
            p.setColor(ji(0xFFCFCFD8))
            cv.drawRect(0.0, 0.0, float(cell), float(cell), p)
            cv.drawRect(float(cell), float(cell), float(cell * 2), float(cell * 2), p)
            self._checker_bmp = bmp
        d = J("android.graphics.drawable.BitmapDrawable")(self.ctx.getResources(), self._checker_bmp)
        TM = J("android.graphics.Shader$TileMode")
        d.setTileModeXY(TM.REPEAT, TM.REPEAT)
        return d

    def icon(self, name, color, fallback=None):
        """Иконка Telegram по имени ресурса, подкрашенная; None если нет."""
        ctx = self.ctx
        res = ctx.getResources()
        rid = 0
        for pkg in (str(ctx.getPackageName()), "org.telegram.messenger"):
            try:
                rid = int(res.getIdentifier(name, "drawable", pkg))
            except Exception:
                rid = 0
            if rid:
                break
        if not rid:
            try:
                rid = int(getattr(J("org.telegram.messenger.R$drawable"), name))
            except Exception:
                rid = 0
        if not rid:
            return None
        try:
            d = ctx.getResources().getDrawable(rid).mutate()
            PDM = J("android.graphics.PorterDuff$Mode")
            d.setColorFilter(J("android.graphics.PorterDuffColorFilter")(ji(color), PDM.SRC_IN))
            return d
        except Exception:
            return None

    def target_icon(self, color):
        """Иконка «прицел» для пипетки: кольцо + точка (рисуется в 22dp)."""
        ring = self.shape(0x00000000, oval=True, stroke=2, stroke_color=color)
        dot = self.shape(color, oval=True)
        LD = J("android.graphics.drawable.LayerDrawable")
        Drawable = J("android.graphics.drawable.Drawable")
        ld = LD(jarray(Drawable)([ring, dot]))
        ld.setLayerInset(0, self.dp(1), self.dp(1), self.dp(1), self.dp(1))
        ld.setLayerInset(1, self.dp(7), self.dp(7), self.dp(7), self.dp(7))
        return ld

    # ── views ──
    def text(self, s="", size=14, color=None, bold=False, lines=1, gravity=None, mono=False):
        t = J("android.widget.TextView")(self.ctx)
        t.setText(str(s))
        t.setTextSize(1, float(size))
        t.setTextColor(ji(self.p["text"] if color is None else color))
        if bold:
            t.setTypeface(self.bold)
        if mono:
            t.setTypeface(J("android.graphics.Typeface").MONOSPACE)
        if lines == 1:
            t.setSingleLine(True)
            t.setEllipsize(J("android.text.TextUtils$TruncateAt").END)
        elif lines:
            t.setMaxLines(int(lines))
            t.setEllipsize(J("android.text.TextUtils$TruncateAt").END)
        if gravity is not None:
            t.setGravity(int(gravity))
        return t

    def linear(self, vertical=True, gravity=None):
        l = J("android.widget.LinearLayout")(self.ctx)
        l.setOrientation(1 if vertical else 0)
        if gravity is not None:
            l.setGravity(int(gravity))
        return l

    def frame(self):
        return J("android.widget.FrameLayout")(self.ctx)

    def view(self):
        return J("android.view.View")(self.ctx)

    def llp(self, w, h, weight=0.0, l=0, t=0, r=0, b=0, gravity=None):
        lp = J("android.widget.LinearLayout$LayoutParams")(int(w), int(h), float(weight))
        lp.setMargins(self.dp(l), self.dp(t), self.dp(r), self.dp(b))
        if gravity is not None:
            lp.gravity = int(gravity)
        return lp

    def flp(self, w, h, gravity=G_TOP | G_LEFT, l=0, t=0, r=0, b=0):
        lp = J("android.widget.FrameLayout$LayoutParams")(int(w), int(h), int(gravity))
        lp.setMargins(self.dp(l), self.dp(t), self.dp(r), self.dp(b))
        return lp

    def icon_button(self, icon_name, fallback, color=None, size=40, drawable=None, on_tap=None):
        color = self.p["sub"] if color is None else color
        fl = self.frame()
        fl.setBackground(self.ripple(None, oval=True))
        d = drawable if drawable is not None else self.icon(icon_name, color)
        if d is not None:
            iv = J("android.widget.ImageView")(self.ctx)
            iv.setImageDrawable(d)
            iv.setScaleType(J("android.widget.ImageView$ScaleType").CENTER_INSIDE)
            pad = self.dp(9)
            iv.setPadding(pad, pad, pad, pad)
            fl.addView(iv, self.flp(MATCH, MATCH))
        else:
            fl.addView(self.text(fallback, 17, color, gravity=G_CENTER), self.flp(MATCH, MATCH))
        fl.setClickable(True)
        if on_tap is not None:
            on_click(fl, on_tap, self.refs)
        return fl

    def swatch(self, size, color, ring=True):
        """Кружок цвета с шахматкой под прозрачностью. -> (view, color_view)."""
        fl = self.frame()
        fl.setBackground(self.shape(0xFFFFFFFF, oval=True))
        try:
            fl.setClipToOutline(True)
        except Exception:
            pass
        chk = self.view()
        chk.setBackground(self.checker())
        fl.addView(chk, self.flp(MATCH, MATCH))
        cv = self.view()
        cv.setBackgroundColor(s32(color))
        fl.addView(cv, self.flp(MATCH, MATCH))
        if ring:
            rv = self.view()
            rv.setBackground(self.shape(0x00000000, oval=True, stroke=1, stroke_color=0x40808090))
            fl.addView(rv, self.flp(MATCH, MATCH))
        return fl, cv

    def pill_button(self, label, filled=False, color=None, on_tap=None):
        color = self.p["accent"] if color is None else color
        t = self.text(label, 14.5, self.p["on_accent"] if filled else color, bold=True, gravity=G_CENTER)
        bg = self.shape(color if filled else (color & 0x00FFFFFF) | 0x1F000000, radius=14)
        t.setBackground(self.ripple(bg, radius=14, color=0x33FFFFFF if filled else None))
        t.setPadding(self.dp(14), 0, self.dp(14), 0)
        t.setClickable(True)
        if on_tap is not None:
            on_click(t, on_tap, self.refs)
        return t

    def edit(self, hint="", mono=False, size=15):
        e = J("android.widget.EditText")(self.ctx)
        e.setHint(str(hint))
        e.setTextSize(1, float(size))
        e.setTextColor(ji(self.p["text"]))
        e.setHintTextColor(ji(self.p["hint"]))
        e.setSingleLine(True)
        e.setBackground(None)
        e.setPadding(0, 0, 0, 0)
        e.setImeOptions(6 | 0x10000000)
        e.setInputType(1 | 0x80000)
        if mono:
            e.setTypeface(J("android.graphics.Typeface").MONOSPACE)
        return e


def hide_keyboard(view):
    try:
        J("org.telegram.messenger.AndroidUtilities").hideKeyboard(view)
        return
    except Exception:
        pass
    try:
        imm = app_context().getSystemService("input_method")
        imm.hideSoftInputFromWindow(view.getWindowToken(), 0)
    except Exception:
        pass


