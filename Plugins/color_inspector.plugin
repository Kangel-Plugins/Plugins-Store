"""
Theme Color Editor — редактор цветов интерфейса для exteraGram.

Что умеет:
  • плавающее окно со списком всех цветовых ключей темы (как встроенный
    редактор Telegram), поиск, вкладки «На экране / Все / Изменённые»;
  • нажатие на ключ — плагин показывает, где этот элемент на экране
    (рамка вокруг элементов + мигание цветом);
  • пипетка: нажмите на любой элемент экрана — плагин найдёт его ключи;
  • удобный выбор цвета: HSV-круг, слайдеры HSV/RGB, прозрачность, HEX,
    недавние цвета и палитра, живой предпросмотр;
  • изменения сохраняются и действуют поверх любой темы, переживают
    перезапуск и смену темы; экспорт/импорт в формате .attheme.
"""

__id__ = "color_inspector"
__name__ = "Theme Color Editor"
__description__ = "Редактор цветов каждого элемента интерфейса: понятные названия, пипетка «найти элемент по нажатию», подсветка элемента с переходом на нужный экран, RGB-перелив и «лента», HSV-круг, RGB/HEX, живой предпросмотр, экспорт и импорт."
__author__ = "@resotez"
__version__ = "1.3.3"
__icon__ = "exteraPlugins/1"
__min_version__ = "12.10.6"
__category__ = ["appearance"]

