def tr(ru, en):
    try:
        if str(Locale.getDefault().getLanguage()) == "ru":
            return ru
    except Exception:
        pass
    return en


def _clean_title(text):
    raw = str(text)
    cleaned = re.sub(r"[^\w\s&\-.,/()+]+", "", raw, flags=re.UNICODE)
    cleaned = re.sub(r"\s+", " ", cleaned).strip()
    return cleaned or raw


def _norm(text):
    return re.sub(r"[\W_]+", "", str(text), flags=re.UNICODE).lower()


def _get_field(obj, cls, name):
    f = cls.getDeclaredField(name)
    f.setAccessible(True)
    return f.get(obj)


def _set_int_field(obj, cls, name, value):
    f = cls.getDeclaredField(name)
    f.setAccessible(True)
    f.setInt(obj, value)


def _base_class(obj, simple_name):

    c = obj.getClass()
    while c is not None:
        if c.getSimpleName() == simple_name:
            return c
        c = c.getSuperclass()
    return obj.getClass()


def _field_any(obj, name):
    c = obj.getClass()
    while c is not None:
        try:
            f = c.getDeclaredField(name)
            f.setAccessible(True)
            return f.get(obj)
        except Exception:
            c = c.getSuperclass()
    return None


if UI_OK:
    def _interp():
        return CubicBezierInterpolator.DEFAULT

    def _color(key):
        return Theme.getColor(key)

    def _signed(v):
        v &= 0xFFFFFFFF
        return v - 0x100000000 if v >= 0x80000000 else v

    def _argb(a, r, g, b):
        return _signed((a << 24) | (r << 16) | (g << 8) | b)

    def _alpha(color, a):
        return _signed((int(a) << 24) | ((color & 0xFFFFFFFF) & 0xFFFFFF))

    def _mix(c1, c2, t):
        a, b = c1 & 0xFFFFFFFF, c2 & 0xFFFFFFFF
        out = 0
        for shift in (24, 16, 8, 0):
            x, y = (a >> shift) & 255, (b >> shift) & 255
            out |= int(round(x + (y - x) * t)) << shift
        return _signed(out)

    def _round_bg(color, radius_dp, oval=False):
        d = GradientDrawable()
        d.setShape(GradientDrawable.OVAL if oval else GradientDrawable.RECTANGLE)
        if not oval:
            d.setCornerRadius(float(AndroidUtilities.dp(radius_dp)))
        d.setColor(color)
        return d

    def _haptic(view, kind):
        try:
            view.performHapticFeedback(kind)
        except Exception:
            pass

    def _medium(text_view):
        try:
            text_view.setTypeface(AndroidUtilities.bold())
        except Exception:
            try:
                text_view.setTypeface(AndroidUtilities.getTypeface("fonts/rmedium.ttf"))
            except Exception:
                pass

    def _icon(context, names, color):
        try:
            res = context.getResources()
            pkg = context.getPackageName()
            for name in names:
                rid = int(res.getIdentifier(name, "drawable", pkg))
                if rid:
                    drawable = res.getDrawable(rid).mutate()
                    drawable.setColorFilter(PorterDuffColorFilter(color, PorterDuff.Mode.MULTIPLY))
                    view = ImageView(context)
                    view.setImageDrawable(drawable)
                    view.setScaleType(ImageView.ScaleType.CENTER)
                    return view
        except Exception:
            pass
        return None

    class TouchProxy(dynamic_proxy(View.OnTouchListener)):
        def __init__(self, fn):
            super().__init__()
            self.fn = fn

        def onTouch(self, view, event):
            try:
                return bool(self.fn(view, event))
            except Exception:
                return False

    class UpdateProxy(dynamic_proxy(ValueAnimator.AnimatorUpdateListener)):
        def __init__(self, fn):
            super().__init__()
            self.fn = fn

        def onAnimationUpdate(self, animator):
            try:
                self.fn(float(animator.getAnimatedFraction()))
            except Exception:
                pass

    _running = {}

    def _hkey(tag, obj):

        try:
            return (tag, int(JSystem.identityHashCode(obj)))
        except Exception:
            return (tag, id(obj))

    def _cancel_anim(key):
        entry = _running.pop(key, None)
        if entry is None:
            return False
        entry["state"]["done"] = True
        try:
            entry["va"].cancel()
        except Exception:
            pass
        return True

    def _animate(host, duration, on_frame, on_end=None, interp=None, key=None):
        state = {"done": False}
        if key is not None:
            _cancel_anim(key)

        def finish():
            if state["done"]:
                return
            state["done"] = True
            if key is not None:
                entry = _running.get(key)
                if entry is not None and entry["state"] is state:
                    _running.pop(key, None)
            if on_end is not None:
                on_end()

        def tick(f):
            if state["done"]:
                return
            on_frame(f)
            if f >= 0.999:
                finish()

        va = ValueAnimator.ofFloat(0.0, 1.0)
        va.setDuration(duration)
        va.setInterpolator(interp or _interp())
        va.addUpdateListener(UpdateProxy(tick))
        if key is not None:
            _running[key] = {"va": va, "state": state}
        va.start()
        if on_end is not None:
            host.postDelayed(R(finish), int(duration) + 80)
        return va

    def _make_transition():
        lt = LayoutTransition()
        lt.setDuration(240)
        lt.enableTransitionType(LayoutTransition.CHANGING)
        for kind in (LayoutTransition.APPEARING, LayoutTransition.DISAPPEARING,
                     LayoutTransition.CHANGE_APPEARING, LayoutTransition.CHANGE_DISAPPEARING,
                     LayoutTransition.CHANGING):
            lt.setInterpolator(kind, _interp())
        lt.setStartDelay(LayoutTransition.APPEARING, 100)
        lt.setStartDelay(LayoutTransition.CHANGE_DISAPPEARING, 120)
        try:
            appear = ObjectAnimator.ofPropertyValuesHolder(
                None,
                PropertyValuesHolder.ofFloat("alpha", 0.0, 1.0),
                PropertyValuesHolder.ofFloat("scaleX", 0.6, 1.0),
                PropertyValuesHolder.ofFloat("scaleY", 0.6, 1.0),
            )
            appear.setDuration(260)
            appear.setInterpolator(_interp())
            lt.setAnimator(LayoutTransition.APPEARING, appear)
            vanish = ObjectAnimator.ofPropertyValuesHolder(
                None,
                PropertyValuesHolder.ofFloat("alpha", 1.0, 0.0),
                PropertyValuesHolder.ofFloat("scaleX", 1.0, 0.6),
                PropertyValuesHolder.ofFloat("scaleY", 1.0, 0.6),
            )
            vanish.setDuration(180)
            vanish.setInterpolator(_interp())
            lt.setAnimator(LayoutTransition.DISAPPEARING, vanish)
        except Exception:
            pass
        return lt

    class Palette:

        def __init__(self):
            self.text = _color(Theme.key_windowBackgroundWhiteBlackText)
            self.gray = _color(Theme.key_windowBackgroundWhiteGrayText)
            self.base = _color(Theme.key_windowBackgroundWhite)
            try:
                self.accent = _color(Theme.key_featuredStickers_addButton)
                self.on_accent = _color(Theme.key_featuredStickers_buttonText)
            except Exception:
                self.accent = _color(Theme.key_windowBackgroundWhiteBlueText4)
                self.on_accent = _argb(255, 255, 255, 255)
            try:
                self.red = _color(Theme.key_text_RedBold)
            except Exception:
                self.red = _color(Theme.key_dialogTextRed)
            self.bar = _mix(self.base, self.text, 0.08)
            self.chip = _mix(self.bar, self.text, 0.13)
            self.lift = _mix(self.bar, self.text, 0.24)
            self.red_fill = _mix(self.bar, self.red, 0.28)
            self.white = _argb(255, 255, 255, 255)
            self.clear_white = _argb(0, 255, 255, 255)

    def _check_drawable(color):
        try:
            path = Path()
            path.moveTo(27.0, 53.0)
            path.lineTo(43.0, 69.0)
            path.lineTo(74.0, 33.0)
            drawable = ShapeDrawable(PathShape(path, 100.0, 100.0))
            paint = drawable.getPaint()
            paint.setStyle(Paint.Style.STROKE)
            paint.setStrokeWidth(10.0)
            paint.setStrokeCap(Paint.Cap.ROUND)
            paint.setStrokeJoin(Paint.Join.ROUND)
            paint.setAntiAlias(True)
            paint.setColor(color)
            return drawable
        except Exception:
            return None

    class Chip:

        def __init__(self, editor, tab_id, label):
            self.editor = editor
            self.tab_id = tab_id
            self.selected = False
            pal = editor.pal
            dp = AndroidUtilities.dp
            self.bg_color = pal.chip
            self.tx_color = pal.text
            self.bg = _round_bg(self.bg_color, 18)
            view = TextView(editor.context)
            view.setText(label)
            view.setTextSize(14.0)
            view.setSingleLine(True)
            view.setGravity(Gravity.CENTER)
            view.setTextColor(self.tx_color)
            view.setPadding(dp(14), 0, dp(14), 0)
            view.setBackground(self.bg)
            _medium(view)
            lp = LinearLayout.LayoutParams(-2, dp(36))
            lp.setMargins(dp(3), 0, dp(3), 0)
            view.setLayoutParams(lp)
            self.view = view

        def set_selected(self, selected):
            if selected == self.selected:
                return
            self.selected = selected
            pal = self.editor.pal
            c0, t0 = self.bg_color, self.tx_color
            c1 = pal.accent if selected else pal.chip
            t1 = pal.on_accent if selected else pal.text

            def frame(f):
                self.bg_color = _mix(c0, c1, f)
                self.tx_color = _mix(t0, t1, f)
                self.bg.setColor(self.bg_color)
                self.view.setTextColor(self.tx_color)

            _animate(self.view, 200, frame)

        def set_lifted(self, lifted):
            pal = self.editor.pal
            if lifted:
                self.bg_color = pal.accent if self.selected else pal.lift
            else:
                self.bg_color = pal.accent if self.selected else pal.chip
            self.bg.setColor(self.bg_color)

    class MenuChip:

        def __init__(self, editor, tab_id, label):
            self.editor = editor
            self.tab_id = tab_id
            self.selected = False
            pal = editor.pal
            ctx = editor.context
            dp = AndroidUtilities.dp
            self.bg_color = pal.chip
            self.tx_color = pal.text
            self.ring_color = pal.gray
            self.fill_color = pal.clear_white
            self.bg = _round_bg(self.bg_color, 18)

            box = LinearLayout(ctx)
            box.setOrientation(LinearLayout.HORIZONTAL)
            box.setGravity(Gravity.CENTER_VERTICAL)
            box.setPadding(dp(14), 0, dp(8), 0)
            box.setBackground(self.bg)

            self.title = TextView(ctx)
            self.title.setText(label)
            self.title.setTextSize(14.0)
            self.title.setSingleLine(True)
            self.title.setTextColor(self.tx_color)
            _medium(self.title)
            box.addView(self.title, LinearLayout.LayoutParams(-2, -2))

            self.ring = _round_bg(self.fill_color, 0, oval=True)
            self.ring.setStroke(dp(1.5), self.ring_color)
            self.circle = FrameLayout(ctx)
            self.circle.setBackground(self.ring)

            self.number = None
            self.check_view = None
            self.glyph = TextView(ctx)
            self.glyph.setGravity(Gravity.CENTER)
            self.glyph.setTextSize(12.0)
            self.glyph.setTextColor(pal.accent)
            _medium(self.glyph)
            self.glyph.setIncludeFontPadding(False)
            self.circle.addView(self.glyph, FrameLayout.LayoutParams(-1, -1))
            clp = LinearLayout.LayoutParams(dp(20), dp(20))
            clp.setMargins(dp(10), 0, 0, 0)
            box.addView(self.circle, clp)

            lp = LinearLayout.LayoutParams(-2, dp(36))
            lp.setMargins(0, 0, dp(6), dp(6))
            box.setLayoutParams(lp)
            self.view = box

        def set_number(self, number):
            self.number = number
            if self.selected and self.glyph is not None:
                self.glyph.setText(str(number))

        def set_selected(self, selected):
            if selected == self.selected:
                return
            self.selected = selected
            pal = self.editor.pal
            c0, t0, r0, f0 = self.bg_color, self.tx_color, self.ring_color, self.fill_color
            c1 = pal.accent if selected else pal.chip
            t1 = pal.on_accent if selected else pal.text
            r1 = pal.white if selected else pal.gray
            f1 = pal.white if selected else pal.clear_white
            dp = AndroidUtilities.dp

            def frame(f):
                self.bg_color, self.tx_color = _mix(c0, c1, f), _mix(t0, t1, f)
                self.ring_color, self.fill_color = _mix(r0, r1, f), _mix(f0, f1, f)
                self.bg.setColor(self.bg_color)
                self.title.setTextColor(self.tx_color)
                self.ring.setColor(self.fill_color)
                self.ring.setStroke(dp(1.5), self.ring_color)

            _animate(self.view, 220, frame)
            if self.glyph is not None:
                self.glyph.setText(str(self.number) if (selected and self.number) else "")
            if self.check_view is not None:
                self.check_view.animate().cancel()
                if selected:
                    self.check_view.setScaleX(0.4)
                    self.check_view.setScaleY(0.4)
                    self.check_view.animate().alpha(1.0).scaleX(1.0).scaleY(1.0).setDuration(260) \
                        .setInterpolator(OvershootInterpolator(2.0)).start()
                else:
                    self.check_view.animate().alpha(0.0).scaleX(0.6).scaleY(0.6).setDuration(140) \
                        .setInterpolator(_interp()).start()
            if selected:
                self.circle.setScaleX(0.8)
                self.circle.setScaleY(0.8)
                self.circle.animate().scaleX(1.0).scaleY(1.0).setDuration(300) \
                    .setInterpolator(OvershootInterpolator(2.0)).start()

    class Editor:
        def __init__(self, plugin, context, kind=None):
            self.plugin = plugin
            self.context = context
            self.kind = kind
            self.pal = Palette()
            self.chips = {}
            self.by_view = {}
            self.mode = "idle"
            self.selected = set()
            self.press = None
            self.drag = None
            self.menu_open = False
            self.menu_avail = []
            self.menu_selected = []
            self.menu_chips = {}
            self.tick_runnable = R(self._tick)
            self.slop = AndroidUtilities.dp(8)
            self._build()


        def _build(self):
            ctx, pal = self.context, self.pal
            dp = AndroidUtilities.dp

            self.root = LinearLayout(ctx)
            self.root.setOrientation(LinearLayout.VERTICAL)
            self.root.setPadding(dp(10), dp(10), dp(10), dp(10))


            top_row = LinearLayout(ctx)
            top_row.setOrientation(LinearLayout.HORIZONTAL)
            top_row.setGravity(Gravity.CENTER_VERTICAL)
            self.root.addView(top_row, LinearLayout.LayoutParams(-1, dp(52)))

            self.bar = FrameLayout(ctx)
            self.bar.setBackground(_round_bg(pal.bar, 26))
            self.bar.setOutlineProvider(ViewOutlineProvider.BACKGROUND)
            self.bar.setClipToOutline(True)
            top_row.addView(self.bar, LinearLayout.LayoutParams(0, -1, 1.0))

            self.scroll = HorizontalScrollView(ctx)
            self.scroll.setHorizontalScrollBarEnabled(False)
            self.scroll.setOverScrollMode(View.OVER_SCROLL_NEVER)
            self.scroll.setClipChildren(False)
            self.scroll.setClipToPadding(False)
            self.scroll.setPadding(dp(7), 0, dp(7), 0)
            self.scroll.setHorizontalFadingEdgeEnabled(False)
            self.tabs_row = LinearLayout(ctx)
            self.tabs_row.setOrientation(LinearLayout.HORIZONTAL)
            self.tabs_row.setGravity(Gravity.CENTER_VERTICAL)
            self.tabs_row.setLayoutTransition(_make_transition())
            self.scroll.addView(self.tabs_row, FrameLayout.LayoutParams(-2, -1))
            self.bar.addView(self.scroll, FrameLayout.LayoutParams(-1, -1))

            self.hint = TextView(ctx)
            self.hint.setText(tr("Пусто", "Empty"))
            self.hint.setTextSize(15.0)
            self.hint.setSingleLine(True)
            self.hint.setTextColor(pal.gray)
            self.hint.setGravity(Gravity.CENTER_VERTICAL)
            self.hint.setPadding(dp(18), 0, 0, 0)
            self.bar.addView(self.hint, FrameLayout.LayoutParams(-2, -1, Gravity.START | Gravity.CENTER_VERTICAL))


            plus_box = FrameLayout(ctx)
            plus_box.setBackground(_round_bg(_mix(pal.bar, pal.accent, 0.18), 0, oval=True))
            plus = _icon(ctx, ("msg_add", "msg_plus"), pal.accent)
            if plus is None:
                plus = TextView(ctx)
                plus.setText("＋")
                plus.setTextSize(24.0)
                plus.setGravity(Gravity.CENTER)
                plus.setTextColor(pal.accent)
            plus.setOnClickListener(OnClickListener(lambda view: self._toggle_menu()))
            self.plus = plus
            plus_box.addView(plus, FrameLayout.LayoutParams(-1, -1))
            plus_lp = LinearLayout.LayoutParams(dp(52), dp(52))
            plus_lp.setMargins(dp(8), 0, 0, 0)
            top_row.addView(plus_box, plus_lp)


            self.sel_bar = LinearLayout(ctx)
            self.sel_bar.setOrientation(LinearLayout.HORIZONTAL)
            self.sel_bar.setVisibility(View.GONE)
            self.sel_bar.setPadding(0, dp(8), 0, 0)
            self.delete_chip = self._action_capsule("", pal.red, pal.red_fill)
            self.delete_chip.setOnClickListener(OnClickListener(lambda view: self._delete_selected()))
            self.cancel_chip = self._action_capsule(tr("Отмена", "Cancel"), pal.text, pal.chip)
            self.cancel_chip.setOnClickListener(OnClickListener(lambda view: self._exit_select()))
            dlp = LinearLayout.LayoutParams(0, dp(40), 1.0)
            dlp.setMargins(0, 0, dp(4), 0)
            clp = LinearLayout.LayoutParams(0, dp(40), 1.0)
            clp.setMargins(dp(4), 0, 0, 0)
            self.sel_bar.addView(self.delete_chip, dlp)
            self.sel_bar.addView(self.cancel_chip, clp)
            self.root.addView(self.sel_bar, LinearLayout.LayoutParams(-1, -2))


            self.menu = LinearLayout(ctx)
            self.menu.setOrientation(LinearLayout.VERTICAL)
            self.menu.setVisibility(View.GONE)
            self.menu.setBackground(_round_bg(pal.bar, 22))
            self.menu.setPadding(dp(12), dp(12), dp(6), dp(8))
            mlp = LinearLayout.LayoutParams(-1, -2)
            mlp.setMargins(0, dp(8), 0, 0)
            self.root.addView(self.menu, mlp)

            self._populate()

        def _populate(self):
            known = self.plugin.load_known()
            ids = self.plugin.all_ids()
            for tab_id in self.plugin.edit_list(self.kind):
                if tab_id in ids and tab_id not in self.chips:
                    self._add_chip(tab_id, self.plugin.title_of(tab_id, known))
            self._update_empty()

        def refresh(self):
            self._clear_press()
            self.drag = None
            self.mode = "idle"
            self.selected = set()
            self.sel_bar.setVisibility(View.GONE)
            if self.menu_open:
                self.menu_open = False
                self.menu.setVisibility(View.GONE)
                self.plus.setRotation(0.0)
            self.tabs_row.removeAllViews()
            self.chips = {}
            self.by_view = {}
            self._populate()
            self._relayout()

        def set_open(self, flag):
            self.root.setVisibility(View.VISIBLE if flag else View.GONE)
            self._relayout()

        def _action_capsule(self, text, color, fill):
            view = TextView(self.context)
            view.setText(text)
            view.setTextSize(14.0)
            view.setGravity(Gravity.CENTER)
            view.setTextColor(color)
            view.setBackground(_round_bg(fill, 20))
            _medium(view)
            return view

        def _add_chip(self, tab_id, label):
            chip = Chip(self, tab_id, label)
            chip.view.setOnTouchListener(TouchProxy(lambda v, e, c=chip: self._on_touch(c, v, e)))
            self.chips[tab_id] = chip
            self.by_view[JSystem.identityHashCode(chip.view)] = chip
            self.tabs_row.addView(chip.view)
            return chip

        def _update_empty(self):
            empty = int(self.tabs_row.getChildCount()) == 0
            self.scroll.setVisibility(View.INVISIBLE if empty else View.VISIBLE)
            self.hint.setVisibility(View.VISIBLE if empty else View.GONE)


        def _avail_width(self):
            width = int(self.root.getWidth())
            if width <= 0:
                width = int(self.context.getResources().getDisplayMetrics().widthPixels) - AndroidUtilities.dp(32)
            return width - int(self.root.getPaddingLeft()) - int(self.root.getPaddingRight())

        def _relayout(self):
            try:
                parent = self.root.getParent()
                for _ in range(40):
                    if parent is None:
                        break
                    parent.requestLayout()
                    parent = parent.getParent()
            except Exception:
                pass

        def _base_margin(self, view):
            store = self.__dict__.setdefault("_margins", {})
            key = int(JSystem.identityHashCode(view))
            if key not in store:
                try:
                    store[key] = int(view.getLayoutParams().topMargin)
                except Exception:
                    store[key] = 0
            return store[key]

        def _set_margin(self, view, lp, value):
            try:
                lp.setMargins(0, int(value), 0, 0)
            except Exception:
                pass

        def _show_now(self, view):
            lp = view.getLayoutParams()
            lp.height = -2
            base = self._base_margin(view)
            if base:
                self._set_margin(view, lp, base)
            view.setLayoutParams(lp)
            view.setAlpha(1.0)
            view.setVisibility(View.VISIBLE)
            self._relayout()

        def _expand(self, view):
            key = _hkey("h", view)
            if _cancel_anim(key):
                _thaw_list()
            _freeze_list(self.root)
            lp = view.getLayoutParams()
            base = self._base_margin(view)

            if int(view.getVisibility()) == 0 and int(lp.height) >= 0:
                cur_h, cur_a = int(lp.height), float(view.getAlpha())
            else:
                cur_h, cur_a = 0, 0.0
            view.measure(
                View.MeasureSpec.makeMeasureSpec(max(1, self._avail_width()), View.MeasureSpec.EXACTLY),
                View.MeasureSpec.makeMeasureSpec(0, View.MeasureSpec.UNSPECIFIED),
            )
            target = int(view.getMeasuredHeight())
            lp.height = cur_h
            if base:
                self._set_margin(view, lp, base * (cur_h / float(target)) if target > 0 else 0)
            view.setLayoutParams(lp)
            view.setAlpha(cur_a)
            view.setVisibility(View.VISIBLE)
            self._relayout()

            def frame(f):
                h = cur_h + (target - cur_h) * f
                lp.height = int(h)
                if base:
                    self._set_margin(view, lp, base * min(1.0, h / float(target)) if target > 0 else base)
                view.setLayoutParams(lp)
                view.setAlpha(min(1.0, cur_a + (1.0 - cur_a) * min(1.0, f * 1.4)))

            def end():
                self._show_now(view)
                view.postDelayed(R(_thaw_list), 80)

            _animate(view, 300, frame, end, key=key)

            view.postDelayed(R(lambda: self._settle(view)), 650)

        def _settle(self, view):
            try:
                if _hkey("h", view) in _running:
                    return
                wanted = (view is self.menu and self.menu_open) or (view is self.sel_bar and self.mode == "select")
                if wanted and (int(view.getVisibility()) != 0 or int(view.getHeight()) <= 0
                               or float(view.getAlpha()) < 1.0):
                    self._show_now(view)
                    if view is self.menu:
                        for chip in list(self.menu_chips.values()):
                            chip.view.setAlpha(1.0)
                            chip.view.setScaleX(1.0)
                            chip.view.setScaleY(1.0)
            except Exception:
                pass

        def _collapse(self, view):
            key = _hkey("h", view)
            if _cancel_anim(key):
                _thaw_list()
            _freeze_list(self.root)
            lp = view.getLayoutParams()
            base = self._base_margin(view)
            cur_h = int(lp.height) if int(lp.height) >= 0 else int(view.getHeight())
            cur_a = float(view.getAlpha())

            def end():
                view.setVisibility(View.GONE)
                lp.height = -2
                if base:
                    self._set_margin(view, lp, base)
                view.setLayoutParams(lp)
                view.setAlpha(1.0)
                view.postDelayed(R(_thaw_list), 80)

            if cur_h <= 0 or int(view.getVisibility()) != 0:
                end()
                return

            def frame(f):
                h = cur_h * (1.0 - f)
                lp.height = int(h)
                if base:
                    self._set_margin(view, lp, base * (h / float(cur_h)))
                view.setLayoutParams(lp)
                view.setAlpha(max(0.0, cur_a * (1.0 - f * 1.4)))

            _animate(view, 240, frame, end, key=key)


        def _on_touch(self, chip, view, event):
            action = int(event.getActionMasked())
            if action == MotionEvent.ACTION_DOWN:
                self._clear_press()
                press = {"chip": chip, "x": float(event.getRawX()), "y": float(event.getRawY()),
                         "armed": False, "long": False, "moved": False}
                press["arm"] = R(lambda: self._arm(press))
                press["lng"] = R(lambda: self._long(press))
                self.press = press
                view.postDelayed(press["arm"], 170)
                view.postDelayed(press["lng"], 520)
                return True
            press = self.press
            if press is None or press["chip"] is not chip:
                return False
            if action == MotionEvent.ACTION_MOVE:
                x, y = float(event.getRawX()), float(event.getRawY())
                if self.drag is not None:
                    self._drag_move(x)
                    return True
                if abs(x - press["x"]) > self.slop or abs(y - press["y"]) > self.slop:
                    press["moved"] = True
                    if press["armed"] and not press["long"]:
                        self._drag_begin(chip, x)
                    else:
                        self._cancel_timers(press)
                return True
            if action == MotionEvent.ACTION_UP or action == MotionEvent.ACTION_CANCEL:
                self._cancel_timers(press)
                if self.drag is not None:
                    self._drag_drop()
                elif action == MotionEvent.ACTION_UP and not press["moved"] and not press["long"]:
                    if self.mode == "select":
                        self._toggle_select(chip)
                self.press = None
                return True
            return False

        def _cancel_timers(self, press):
            view = press["chip"].view
            view.removeCallbacks(press["arm"])
            view.removeCallbacks(press["lng"])

        def _clear_press(self):
            if self.press is not None:
                try:
                    self._cancel_timers(self.press)
                except Exception:
                    pass
                self.press = None

        def _arm(self, press):
            if self.press is not press:
                return
            press["armed"] = True
            parent = press["chip"].view.getParent()
            if parent is not None:
                parent.requestDisallowInterceptTouchEvent(True)

        def _long(self, press):
            if self.press is not press or press["moved"] or self.drag is not None:
                return
            press["long"] = True
            chip = press["chip"]
            _haptic(chip.view, HapticFeedbackConstants.LONG_PRESS)
            if self.mode == "select":
                self._toggle_select(chip)
            else:
                self._enter_select(chip)


        def _drag_begin(self, chip, x):
            view = chip.view
            row = self.tabs_row
            start = int(row.indexOfChild(view))
            self.drag = {"chip": chip, "start": start, "target": start, "last_x": x, "raw_x": x, "applied": {}}
            chip.set_lifted(True)
            view.animate().cancel()
            view.animate().scaleX(1.05).scaleY(1.05).translationZ(float(AndroidUtilities.dp(10))) \
                .setDuration(160).setInterpolator(_interp()).start()
            _haptic(view, HapticFeedbackConstants.CLOCK_TICK)
            self.scroll.postOnAnimation(self.tick_runnable)

        def _drag_move(self, x):
            d = self.drag
            d["raw_x"] = x
            dx = x - d["last_x"]
            d["last_x"] = x
            self._drag_by(dx)

        def _drag_by(self, dx):
            d = self.drag
            if d is None:
                return
            view = d["chip"].view
            row = self.tabs_row
            s = d["start"]
            own_center = float(view.getLeft()) + float(view.getWidth()) / 2.0
            lo = hi = 0.0
            others = [row.getChildAt(j) for j in range(int(row.getChildCount())) if j != s]
            if others:
                margin = float(AndroidUtilities.dp(4))
                first, last = others[0], others[-1]
                first_center = float(first.getLeft()) + float(first.getWidth()) / 2.0
                last_center = float(last.getLeft()) + float(last.getWidth()) / 2.0
                lo = min(0.0, first_center - margin - own_center)
                hi = max(0.0, last_center + margin - own_center)
            view.setTranslationX(max(lo, min(hi, float(view.getTranslationX()) + dx)))
            self._retarget()

        def _retarget(self):
            d = self.drag
            row = self.tabs_row
            view = d["chip"].view
            n = int(row.getChildCount())
            s = d["start"]
            cx = float(view.getLeft()) + float(view.getWidth()) / 2.0 + float(view.getTranslationX())
            t = 0
            for j in range(n):
                if j == s:
                    continue
                other = row.getChildAt(j)
                if float(other.getLeft()) + float(other.getWidth()) / 2.0 < cx:
                    t += 1
            if t != d["target"]:
                d["target"] = t
                _haptic(view, HapticFeedbackConstants.CLOCK_TICK)
            step = float(view.getWidth() + AndroidUtilities.dp(6))
            for j in range(n):
                if j == s:
                    continue
                other = row.getChildAt(j)
                shift = 0.0
                if s < j <= t:
                    shift = -step
                elif t <= j < s:
                    shift = step
                key = JSystem.identityHashCode(other)
                if d["applied"].get(key) != shift:
                    d["applied"][key] = shift
                    other.animate().translationX(shift).setDuration(200).setInterpolator(_interp()).start()

        def _tick(self):
            d = self.drag
            if d is None:
                return
            try:
                sc = self.scroll
                loc = jarray(jint)([0, 0])
                sc.getLocationOnScreen(loc)
                left = float(loc[0])
                right = left + float(sc.getWidth())
                zone = float(AndroidUtilities.dp(56))
                x = d["raw_x"]
                speed = 0.0
                if x < left + zone:
                    speed = -min(1.0, (left + zone - x) / zone) * AndroidUtilities.dp(12)
                elif x > right - zone:
                    speed = min(1.0, (x - (right - zone)) / zone) * AndroidUtilities.dp(12)
                if speed != 0.0:
                    view = d["chip"].view
                    before = jarray(jint)([0, 0])
                    view.getLocationOnScreen(before)
                    sc.scrollBy(int(speed), 0)
                    after = jarray(jint)([0, 0])
                    view.getLocationOnScreen(after)
                    moved = float(after[0]) - float(before[0])
                    if moved != 0.0:
                        self._drag_by(-moved)
            except Exception:
                pass
            self.scroll.postOnAnimation(self.tick_runnable)

        def _drag_drop(self):
            d = self.drag
            self.drag = None
            chip = d["chip"]
            view = chip.view
            row = self.tabs_row
            s, t = d["start"], d["target"]
            n = int(row.getChildCount())
            views = [row.getChildAt(j) for j in range(n)]
            gap = AndroidUtilities.dp(6)
            final = 0.0
            if t > s:
                final = float(sum(int(views[j].getWidth()) + gap for j in range(s + 1, t + 1)))
            elif t < s:
                final = -float(sum(int(views[j].getWidth()) + gap for j in range(t, s)))
            anim = view.animate().translationX(final).scaleX(1.0).scaleY(1.0).translationZ(0.0) \
                .setDuration(200).setInterpolator(_interp())
            if s != t:
                anim.withEndAction(R(lambda: self._commit(views, s, t, chip)))
            else:
                chip.set_lifted(False)
                for other in views:
                    other.animate().translationX(0.0).setDuration(200).setInterpolator(_interp()).start()
            anim.start()

        def _commit(self, views, s, t, chip):
            row = self.tabs_row
            views.insert(t, views.pop(s))
            transition = row.getLayoutTransition()
            row.setLayoutTransition(None)
            try:
                for v in views:
                    v.animate().cancel()
                    v.setTranslationX(0.0)
                    v.setTranslationZ(0.0)
                    v.setScaleX(1.0)
                    v.setScaleY(1.0)
                chip.set_lifted(False)
                row.removeAllViews()
                for v in views:
                    row.addView(v)
            finally:


                row.postDelayed(R(lambda: row.setLayoutTransition(transition)), 160)
            ids = [self.by_view[JSystem.identityHashCode(v)].tab_id for v in views]
            self.plugin.reorder_saved(self.kind, ids)


        def _enter_select(self, chip):
            if self.menu_open:
                self._close_menu()
            self.mode = "select"
            self.selected = set()
            self._toggle_select(chip)
            self._expand(self.sel_bar)

        def _toggle_select(self, chip):
            if chip.tab_id in self.selected:
                self.selected.discard(chip.tab_id)
                chip.set_selected(False)
            else:
                self.selected.add(chip.tab_id)
                chip.set_selected(True)
            if not self.selected:
                self._exit_select()
                return
            self.delete_chip.setText(tr(f"Удалить · {len(self.selected)}", f"Delete · {len(self.selected)}"))

        def _exit_select(self):
            if self.mode != "select":
                return
            self.mode = "idle"
            for tab_id in list(self.selected):
                chip = self.chips.get(tab_id)
                if chip is not None:
                    chip.set_selected(False)
            self.selected = set()
            self._collapse(self.sel_bar)

        def _delete_selected(self):
            ids = list(self.selected)
            if not ids:
                return
            self.mode = "idle"
            self.selected = set()
            views = []
            for tab_id in ids:
                chip = self.chips.pop(tab_id, None)
                if chip is not None:
                    self.by_view.pop(JSystem.identityHashCode(chip.view), None)
                    chip.view.setOnTouchListener(None)
                    views.append(chip.view)
            self.plugin.remove_many(self.kind, ids)
            self._collapse(self.sel_bar)
            if not views:
                self._update_empty()
                return
            gone = set()

            def drop(view):
                key = int(JSystem.identityHashCode(view))
                if key in gone:
                    return
                gone.add(key)
                try:
                    self.tabs_row.removeView(view)
                except Exception:
                    pass
                if len(gone) >= len(views):
                    self._update_empty()


            for view in views:
                try:
                    view.animate().cancel()
                    view.animate().alpha(0.0).scaleX(0.6).scaleY(0.6).setDuration(200) \
                        .setInterpolator(_interp()).withEndAction(R(lambda v=view: drop(v))).start()
                except Exception:
                    drop(view)
            self.tabs_row.postDelayed(R(lambda: [drop(v) for v in views]), 450)


        def _toggle_menu(self):
            if self.menu_open:
                self._close_menu()
            else:
                self._open_menu()

        def _open_menu(self):
            if self.mode == "select":
                self._exit_select()
            try:
                self._fill_menu()
            except Exception as error:
                self._menu_error(error)
            self.menu_open = True
            try:
                self.plus.animate().rotation(45.0).setDuration(260).setInterpolator(_interp()).start()
            except Exception:
                pass
            try:
                self._expand(self.menu)
            except Exception:
                self._show_now(self.menu)
            try:
                for i, chip in enumerate(list(self.menu_chips.values())):
                    view = chip.view
                    view.setAlpha(0.0)
                    view.setScaleX(0.85)
                    view.setScaleY(0.85)
                    view.animate().alpha(1.0).scaleX(1.0).scaleY(1.0).setStartDelay(40 + i * 18) \
                        .setDuration(260).setInterpolator(_interp()).start()
            except Exception:
                for chip in list(self.menu_chips.values()):
                    try:
                        chip.view.setAlpha(1.0)
                    except Exception:
                        pass

        def _menu_error(self, error):
            self.menu.removeAllViews()
            self.menu_chips = {}
            note = TextView(self.context)
            note.setText(tr("Не удалось открыть меню", "Could not open the menu"))
            note.setTextSize(13.0)
            note.setTextColor(self.pal.red)
            self.menu.addView(note, LinearLayout.LayoutParams(-2, -2))

        def _close_menu(self):
            if not self.menu_open:
                return
            self.menu_open = False
            self.plus.animate().rotation(0.0).setDuration(260).setInterpolator(_interp()).start()
            self._collapse(self.menu)

        def _fill_menu(self):
            pal = self.pal
            dp = AndroidUtilities.dp
            ctx = self.context
            self.menu.removeAllViews()
            self.menu_chips = {}
            self.menu_selected = []
            listed = set(self.chips.keys())
            names = self.plugin.catalog()
            def _menu_key(x):

                if names.get(x) == "TAB_GROUPUSERS" and self.kind == "group":
                    return -3
                if names.get(x) == "TAB_GIFTS":
                    return -2
                if x == ROUND_TAB_ID:
                    return VOICE_TAB_ID + 0.5
                if x == VIDEO_TAB_ID:
                    return MEDIA_TAB_ID + 0.5
                return x
            self.menu_avail = [i for i in sorted(self.plugin.ids_for(self.kind), key=_menu_key) if i not in listed]
            if not self.menu_avail:
                empty = TextView(ctx)
                none_known = self.kind is not None and not self.plugin.ids_for(self.kind)
                empty.setText(
                    tr("Здесь появятся вкладки, которые показываются в таких профилях. Откройте любой такой профиль один раз.",
                       "Tabs shown in such profiles will appear here. Open any such profile once.")
                    if none_known else tr("Все вкладки уже добавлены", "All tabs are already added"))
                empty.setTextSize(14.0)
                empty.setTextColor(pal.gray)
                empty.setPadding(dp(4), dp(4), 0, dp(4))
                self.menu.addView(empty, LinearLayout.LayoutParams(-2, -2))
                return

            known = self.plugin.load_known()
            chips = []
            for tab_id in self.menu_avail:
                mc = MenuChip(self, tab_id, self.plugin.title_of(tab_id, known))
                mc.view.setOnClickListener(OnClickListener(lambda view, c=mc: self._menu_toggle(c)))
                self.menu_chips[tab_id] = mc
                chips.append(mc)


            limit = self._avail_width() - dp(12 + 6)
            rows, row, used = [], [], 0
            for mc in chips:
                mc.view.measure(
                    View.MeasureSpec.makeMeasureSpec(0, View.MeasureSpec.UNSPECIFIED),
                    View.MeasureSpec.makeMeasureSpec(0, View.MeasureSpec.UNSPECIFIED),
                )
                w = int(mc.view.getMeasuredWidth()) + dp(6)
                if row and used + w > limit:
                    rows.append(row)
                    row, used = [], 0
                row.append(mc)
                used += w
            if row:
                rows.append(row)
            for r in rows:
                line = LinearLayout(ctx)
                line.setOrientation(LinearLayout.HORIZONTAL)
                for mc in r:
                    line.addView(mc.view)
                self.menu.addView(line, LinearLayout.LayoutParams(-2, -2))

            self.add_off = _mix(pal.bar, pal.text, 0.16)
            self.add_button = TextView(ctx)
            self.add_button.setTextSize(15.0)
            self.add_button.setGravity(Gravity.CENTER)
            _medium(self.add_button)
            self.add_bg = _round_bg(self.add_off, 22)
            self.add_button.setBackground(self.add_bg)
            self.add_button.setTextColor(pal.gray)
            self.add_button.setText(tr("Добавить", "Add"))
            self.add_button.setOnClickListener(OnClickListener(lambda view: self._confirm_add()))
            self.add_color = self.add_off
            self.add_text = pal.gray
            alp = LinearLayout.LayoutParams(-1, dp(44))
            alp.setMargins(0, dp(6), dp(6), 0)
            self.menu.addView(self.add_button, alp)

        def _menu_toggle(self, mc):
            if mc.tab_id in self.menu_selected:
                self.menu_selected.remove(mc.tab_id)
                mc.number = None
                mc.set_selected(False)
            else:
                self.menu_selected.append(mc.tab_id)
                mc.number = len(self.menu_selected)
                mc.set_selected(True)
            for pos, tab_id in enumerate(self.menu_selected, 1):
                chip = self.menu_chips.get(tab_id)
                if chip is not None:
                    chip.set_number(pos)
            _haptic(mc.view, HapticFeedbackConstants.CLOCK_TICK)
            self._refresh_add_button()

        def _refresh_add_button(self):
            pal = self.pal
            count = len(self.menu_selected)
            self.add_button.setText(tr(f"Добавить · {count}", f"Add · {count}") if count else tr("Добавить", "Add"))
            c0, t0 = self.add_color, self.add_text
            c1 = pal.accent if count else self.add_off
            t1 = pal.on_accent if count else pal.gray

            def frame(f):
                self.add_color, self.add_text = _mix(c0, c1, f), _mix(t0, t1, f)
                self.add_bg.setColor(self.add_color)
                self.add_button.setTextColor(self.add_text)

            _animate(self.add_button, 200, frame, key=_hkey("a", self.add_button))

        def _confirm_add(self):
            ids = [i for i in self.menu_selected if i in self.menu_avail]
            if not ids:
                return
            self.plugin.add_many(self.kind, ids)
            known = self.plugin.load_known()
            self.scroll.setVisibility(View.VISIBLE)
            self.hint.setVisibility(View.GONE)
            for tab_id in ids:
                self._add_chip(tab_id, self.plugin.title_of(tab_id, known))
            self._close_menu()
            self.scroll.postDelayed(R(lambda: self.scroll.smoothScrollTo(int(self.tabs_row.getWidth()), 0)), 160)


    def _relayout_up(view):
        try:
            parent = view.getParent()
            for _ in range(40):
                if parent is None:
                    break
                parent.requestLayout()
                parent = parent.getParent()
        except Exception:
            pass

    class Toggle:

        def __init__(self, pal, context, title, hint, checked, on_change):
            dp = AndroidUtilities.dp
            self.pal = pal
            self.on_change = on_change
            self.checked = bool(checked)
            self.pos = 1.0 if self.checked else 0.0
            self.off = _mix(pal.bar, pal.text, 0.30)
            row = LinearLayout(context)
            row.setOrientation(LinearLayout.HORIZONTAL)
            row.setGravity(Gravity.CENTER_VERTICAL)
            row.setPadding(dp(18), dp(10), dp(14), dp(10))
            col = LinearLayout(context)
            col.setOrientation(LinearLayout.VERTICAL)
            head = TextView(context)
            head.setText(title)
            head.setTextSize(16.0)
            head.setTextColor(pal.text)
            col.addView(head, LinearLayout.LayoutParams(-2, -2))
            if hint:
                sub = TextView(context)
                sub.setText(hint)
                sub.setTextSize(13.0)
                sub.setTextColor(pal.gray)
                col.addView(sub, LinearLayout.LayoutParams(-2, -2))
            row.addView(col, LinearLayout.LayoutParams(0, -2, 1.0))
            self.track_bg = _round_bg(_mix(self.off, pal.accent, self.pos), 13)
            track = FrameLayout(context)
            track.setBackground(self.track_bg)
            self.thumb = View(context)
            self.thumb.setBackground(_round_bg(pal.white, 0, oval=True))
            tlp = FrameLayout.LayoutParams(dp(20), dp(20), Gravity.START | Gravity.CENTER_VERTICAL)
            tlp.setMargins(dp(3), 0, 0, 0)
            track.addView(self.thumb, tlp)
            mlp = LinearLayout.LayoutParams(dp(46), dp(26))
            mlp.setMargins(dp(12), 0, 0, 0)
            row.addView(track, mlp)
            self.row = row
            self._apply()
            row.setOnClickListener(OnClickListener(lambda view: self.set_checked(not self.checked)))

        def _apply(self):
            self.track_bg.setColor(_mix(self.off, self.pal.accent, self.pos))
            self.thumb.setTranslationX(float(self.pos * AndroidUtilities.dp(20)))

        def set_checked(self, value):
            value = bool(value)
            if value == self.checked:
                return
            self.checked = value
            start, end = self.pos, (1.0 if value else 0.0)

            def frame(f):
                self.pos = start + (end - start) * f
                self._apply()

            def done():
                self.pos = end
                self._apply()

            _animate(self.row, 150, frame, done, key=("t", id(self)))
            _haptic(self.row, HapticFeedbackConstants.CLOCK_TICK)
            try:
                self.on_change(value)
            except Exception:
                pass

    def _is_recycler(view):
        c = view.getClass()
        while c is not None:
            if str(c.getSimpleName()) == "RecyclerView":
                return True
            c = c.getSuperclass()
        return False

    _freeze = {"rv": None, "anim": None, "n": 0}

    def _freeze_list(view):
        try:
            if _freeze["n"] == 0:
                parent = view.getParent()
                for _ in range(40):
                    if parent is None:
                        break
                    if _is_recycler(parent):
                        _freeze["rv"] = parent
                        _freeze["anim"] = parent.getItemAnimator()
                        parent.setItemAnimator(None)
                        break
                    parent = parent.getParent()
            _freeze["n"] += 1
        except Exception:
            pass

    def _thaw_list():
        try:
            if _freeze["n"] <= 0:
                return
            _freeze["n"] -= 1
            if _freeze["n"] == 0 and _freeze["rv"] is not None:
                _freeze["rv"].setItemAnimator(_freeze["anim"])
                _freeze["rv"] = None
                _freeze["anim"] = None
        except Exception:
            pass

    def _thaw_all():
        try:
            if _freeze["rv"] is not None:
                _freeze["rv"].setItemAnimator(_freeze["anim"])
        except Exception:
            pass
        _freeze["rv"] = None
        _freeze["anim"] = None
        _freeze["n"] = 0

    class Panel:

        def __init__(self, plugin, context):
            self.plugin = plugin
            self.context = context
            self.pal = Palette()
            self.token = 0
            self.running = None
            self.holding = False
            _thaw_all()
            self.root = LinearLayout(context)
            self.root.setOrientation(LinearLayout.VERTICAL)
            self.master = Toggle(
                self.pal, context,
                tr("Отдельный порядок по типам профилей", "Separate order per profile type"),
                tr("Общий список скрывается, для людей, групп и каналов настраивается свой",
                   "The common list is hidden: people, groups and channels get their own"),
                plugin.master_on(), self._on_master)
            self.root.addView(self.master.row, LinearLayout.LayoutParams(-1, -2))
            self.common = Editor(plugin, context, None)
            self.root.addView(self.common.root, LinearLayout.LayoutParams(-1, -2))
            self.types = LinearLayout(context)
            self.types.setOrientation(LinearLayout.VERTICAL)
            self.blocks = {}
            specs = (
                ("user", tr("Профили людей", "People profiles"),
                 ""),
                ("self", tr("Мой профиль", "My profile"),
                 ""),
                ("group", tr("Группы", "Groups"),
                 ""),
                ("channel", tr("Каналы", "Channels"),
                 ""),
            )
            for kind, title, hint in specs:
                toggle = Toggle(self.pal, context, title, hint, plugin.type_on(kind),
                                lambda v, k=kind: self._on_type(k, v))
                editor = Editor(plugin, context, kind)
                self.types.addView(toggle.row, LinearLayout.LayoutParams(-1, -2))
                self.types.addView(editor.root, LinearLayout.LayoutParams(-1, -2))
                self.blocks[kind] = (toggle, editor)
            self.root.addView(self.types, LinearLayout.LayoutParams(-1, -2))
            self._apply_instant(self._targets())

        def _targets(self):
            master = self.plugin.master_on()
            out = [(self.common.root, not master), (self.types, master)]
            for kind, (toggle, editor) in self.blocks.items():
                out.append((editor.root, self.plugin.type_on(kind)))
            return out

        def _apply_instant(self, targets):
            for view, flag in targets:
                lp = view.getLayoutParams()
                if lp is not None:
                    lp.height = -2
                    view.setLayoutParams(lp)
                view.setVisibility(View.VISIBLE if flag else View.GONE)
                view.setAlpha(1.0)

        def _relayout(self):
            _relayout_up(self.root)
            self.root.post(R(lambda: _relayout_up(self.root)))

        def _hold(self, on):
            if on and not self.holding:
                self.holding = True
                _freeze_list(self.root)
            elif not on and self.holding:
                self.holding = False
                self.root.postDelayed(R(_thaw_list), 80)

        def _go(self):
            root = self.root
            targets = self._targets()
            width = int(root.getWidth())
            if width <= 0:
                self._apply_instant(targets)
                self._relayout()
                self._hold(False)
                return
            active_before = list(getattr(self, "active", []))
            moving = []
            for view, flag in targets:
                visible = int(view.getVisibility()) == 0
                if flag != visible or any(view is a for a in active_before):
                    moving.append((view, flag))
            if not moving:
                self._relayout()
                self._hold(False)
                return

            if any(v is self.types for v, _f in moving):
                nested = [(v, f) for v, f in moving if v is not self.types]
                self._apply_instant(nested)
                moving = [(v, f) for v, f in moving if v is self.types]
            self._hold(True)
            spec_w = View.MeasureSpec.makeMeasureSpec(width, View.MeasureSpec.EXACTLY)
            spec_h = View.MeasureSpec.makeMeasureSpec(0, View.MeasureSpec.UNSPECIFIED)
            items = []
            for view, flag in moving:
                lp = view.getLayoutParams()
                visible = int(view.getVisibility()) == 0
                if visible:
                    cur_h = int(lp.height) if int(lp.height) >= 0 else int(view.getHeight())
                    cur_a = float(view.getAlpha())
                else:
                    cur_h, cur_a = 0, 0.0
                if flag:
                    view.measure(spec_w, spec_h)
                    end_h = int(view.getMeasuredHeight())
                else:
                    end_h = 0
                lp.height = cur_h
                view.setLayoutParams(lp)
                view.setAlpha(cur_a)
                view.setVisibility(View.VISIBLE)
                items.append((view, lp, cur_h, end_h, cur_a, flag))
            self.active = [it[0] for it in items]

            def frame(f):
                for view, lp, cur_h, end_h, cur_a, flag in items:
                    lp.height = int(cur_h + (end_h - cur_h) * f)
                    view.setLayoutParams(lp)
                    if flag:
                        view.setAlpha(cur_a + (1.0 - cur_a) * max(0.0, min(1.0, (f - 0.2) / 0.8)))
                    else:
                        view.setAlpha(cur_a * (1.0 - max(0.0, min(1.0, f / 0.6))))

            def done():
                for view, lp, cur_h, end_h, cur_a, flag in items:
                    lp.height = -2
                    view.setLayoutParams(lp)
                    view.setAlpha(1.0)
                    view.setVisibility(View.VISIBLE if flag else View.GONE)
                self.active = []
                self._relayout()
                self._hold(False)

            _animate(root, 360, frame, done, key=("p", id(self)))

        def _on_master(self, value):
            self.plugin.set_setting("sep_master", bool(value))
            self._go()

        def _on_type(self, kind, value):
            self.plugin.set_setting("sep_" + kind, bool(value))
            self._go()


class UpdateTabsHook(MethodHook):

    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        p = self.plugin
        p.update_depth += 1
        if p.update_depth > 1:
            return
        try:
            p.begin_capture(param.thisObject)
        except Exception:
            pass

    def after_hooked_method(self, param):
        p = self.plugin
        p.update_depth = max(0, p.update_depth - 1)
        if p.update_depth > 0:
            return
        try:
            p.end_capture()
        except Exception:
            pass


class AddTabHook(MethodHook):

    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        p = self.plugin
        if p.probing:
            try:
                if JSystem.identityHashCode(param.thisObject) == p.probe_hash:
                    args = list(param.args or [])
                    p.probe_captured.append((int(args[0]), args[1]))
            except Exception:
                pass
            return
        if p.rebuilding:
            return
        try:
            key = JSystem.identityHashCode(param.thisObject)
            if p.capturing:
                if key != p.strip_hash:
                    return
                args = list(param.args or [])
                p.captured.append((int(args[0]), args[1], args[2:]))
            elif key in p.known_strips:
                order = p.order_for(p.strip_kinds.get(key))
                if order and int(param.args[0]) not in order:
                    param.setResult(None)
        except Exception:
            pass


class FinishHook(MethodHook):

    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        p = self.plugin
        if not p.capturing or p.rebuilding or p.done:
            return
        try:
            if JSystem.identityHashCode(param.thisObject) != p.strip_hash:
                return
            p.apply_order(param.thisObject)
        except Exception:
            pass


class BeginUpdateHook(MethodHook):

    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        p = self.plugin
        if not p.capturing:
            return
        try:
            if JSystem.identityHashCode(param.thisObject) != p.strip_hash:
                return
            if param.args and len(param.args) > 0:
                param.args[0] = Boolean(False)
        except Exception:
            pass


class HasTabHook(MethodHook):

    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        p = self.plugin
        if not p.rebuilding:
            return
        try:
            if int(param.args[0]) in p.pending:
                param.setResult(Boolean(True))
        except Exception:
            pass


class FirstTabHook(MethodHook):

    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        p = self.plugin
        try:
            layout = param.thisObject
            strip = _get_field(layout, _base_class(layout, "SharedMediaLayout"), "scrollSlidingTextTabStrip")
            visible = p.visible.get(JSystem.identityHashCode(strip))
            if not visible:
                return
            param.setResult(Boolean(int(strip.getCurrentTabId()) == visible[0]))
        except Exception:
            pass


class FirstIdHook(MethodHook):

    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        p = self.plugin
        try:
            visible = p.visible.get(JSystem.identityHashCode(param.thisObject))
            if visible:
                param.setResult(Integer(visible[0]))
        except Exception:
            pass


class MeasureHook(MethodHook):

    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        p = self.plugin
        if not p.hidden_layouts:
            return
        try:
            layout = param.thisObject
            if JSystem.identityHashCode(layout) in p.hidden_layouts:
                p.zero_height(layout)
        except Exception:
            pass


class TabOrderPlugin(BasePlugin):
    def on_plugin_load(self):
        self.capturing = False
        self.rebuilding = False
        self.done = False
        self.reapplied = False
        self.need_force = False
        self.plan_hide = None
        self.applied_count = 0
        self.update_depth = 0
        self.strip = None
        self.layout = None
        self.strip_hash = None
        self.captured = []
        self.pending = set()
        self.suppressed = set()
        self.visible = {}
        self.known_strips = set()
        self.hidden = {}
        self.hidden_layouts = {}
        self.opened = {}
        self._catalog = None
        self._set_dimension = None
        self.dbg = []
        self.video_state = None
        self.probing = False
        self.probe_hash = None
        self.probe_captured = []
        self.cur_begin = None
        self.strip_kind = None
        self.strip_kinds = {}
        self.kind_cache = {}
        self.editors = {}
        self.live_toggle = True

        self._hook(LAYOUT_CLS, "updateTabs", UpdateTabsHook(self))
        self._hook(LAYOUT_CLS, "isCurrentTabFirst", FirstTabHook(self))
        self._hook(LAYOUT_CLS, "onMeasure", MeasureHook(self))
        self._hook(STRIP_CLS, "addTextTab", AddTabHook(self))
        self._hook(STRIP_CLS, "hasTab", HasTabHook(self))
        self._hook(STRIP_CLS, "getFirstTabId", FirstIdHook(self))
        for name in FINISH_NAMES:
            self._hook(STRIP_CLS, name, FinishHook(self))
        self._hook(STRIP_CLS, "beginUpdate", BeginUpdateHook(self))
        self.migrate_lists()
        self.migrate_self()
        self.migrate_video()
        try:


            AndroidUtilities.runOnUIThread(R(self.probe_foreign_tabs), 5000)
        except Exception:
            pass

    def probe_foreign_tabs(self):
        if self.probing or jclass is None:
            return
        try:
            if self.video_active():
                return
        except Exception:
            pass
        strip = None
        try:
            ctx = self._context()
            for args in ((ctx, None), (ctx,)):
                try:
                    strip = jclass(STRIP_CLS)(*args)
                    break
                except Exception:
                    strip = None
            if strip is None:
                return
            native = self.catalog()
            self.probe_hash = JSystem.identityHashCode(strip)
            self.probe_captured = []
            self.probing = True
            try:
                for tab_id in sorted(native):
                    strip.addTextTab(int(tab_id), self.title_of(tab_id, {}))
            finally:
                self.probing = False
            found = {}
            for tab_id, title in self.probe_captured:
                if tab_id not in native:
                    found[tab_id] = str(title)
            self.probe_captured = []
            found = {i: t for i, t in found.items() if i not in ALIAS_TAB_IDS}
            if found:
                self.learn(found)
            if self._parse_list(self.get_setting("foreign_tabs", None)) != sorted(found):
                self.save_list("foreign_tabs", sorted(found))
        except Exception:
            self.probing = False


    def _hook(self, class_name, method_name, handler):
        try:
            cls = find_class(class_name) if isinstance(class_name, str) else class_name
            if cls:
                self.hook_all_methods(cls, method_name, handler)
        except Exception:
            pass

    def load_list(self, key):
        try:
            return [int(x) for x in json.loads(self.get_setting(key, "[]") or "[]")]
        except Exception:
            return []

    def save_list(self, key, value):
        self.set_setting(key, json.dumps([int(x) for x in value]))

    def _parse_list(self, raw):
        try:
            return [int(x) for x in json.loads(raw or "[]")]
        except Exception:
            return []

    def master_on(self):
        try:
            return bool(self.get_setting("sep_master", False))
        except Exception:
            return False

    def type_on(self, kind):
        try:
            return kind in KINDS and bool(self.get_setting("sep_" + kind, False))
        except Exception:
            return False

    def separate_on(self, kind):
        return self.master_on() and self.type_on(kind)

    def order_key(self, kind):
        return "order_" + kind if kind in KINDS else "order"

    def order_for(self, kind):
        order = list(self._order_raw(kind))
        if kind == "self":

            fixed = self.fixed_self_ids()
            order = fixed + [i for i in order if i not in fixed]
        return order

    def fixed_self_ids(self):
        catalog = self.catalog()
        return sorted(i for i, name in catalog.items() if name in SELF_ONLY)

    def _order_raw(self, kind):
        if kind == "self":

            base = self._order_raw("user")
            if self.separate_on("self"):
                own = self._parse_list(self.get_setting("order_self", None))
                return own + [i for i in base if i not in own]
            return base
        if self.separate_on(kind):
            return self._parse_list(self.get_setting("order_" + kind, None))
        return self.load_list("order")

    def edit_list(self, kind):
        if kind in KINDS:
            own = self._parse_list(self.get_setting("order_" + kind, None))
        else:
            own = self.load_list("order")
        fixed = set(self.fixed_self_ids())
        return [i for i in own if i not in fixed]

    def migrate_self(self):
        try:
            if self.get_setting("self_v489", False):
                return
            catalog = self.catalog()
            exclusive = set(i for i, name in catalog.items() if "self" in TAB_KINDS.get(name, ()))
            people = self._parse_list(self.get_setting("order_user", None))
            moved = [i for i in people if catalog.get(i) in SELF_ONLY]
            if moved:
                self.save_list("order_user", [i for i in people if i not in moved])
            own = self._parse_list(self.get_setting("order_self", None))
            clean = [i for i in own if i in exclusive]
            for i in moved:
                if i not in clean:
                    clean.append(i)
            if clean != own:
                self.save_list("order_self", clean)
            if moved and own == [] and self.get_setting("sep_self", None) is None:
                self.set_setting("sep_self", True)
            self.set_setting("self_v489", True)
        except Exception:
            pass

    def migrate_video(self):
        try:
            if self.get_setting("video_v4812", False):
                return
            for key in ORDER_KEYS:
                raw = self.get_setting(key, None)
                order = self._parse_list(raw) if raw is not None else []
                if MEDIA_TAB_ID in order and VIDEO_TAB_ID not in order:
                    order.insert(order.index(MEDIA_TAB_ID) + 1, VIDEO_TAB_ID)
                    self.save_list(key, order)
            self.set_setting("video_v4812", True)
        except Exception:
            pass

    def migrate_lists(self):
        try:
            if self.get_setting("lists_v48", False):
                return
            common = self.load_list("order")
            for kind in KINDS:
                raw = self.get_setting("order_" + kind, None)
                if raw is None:
                    continue
                own = self._parse_list(raw)
                it = iter(common)
                if own and all(x in it for x in own):
                    self.save_list("order_" + kind, [])
            self.set_setting("lists_v48", True)
        except Exception:
            pass

    def load_known(self):
        try:
            raw = json.loads(self.get_setting("known_tabs", "{}") or "{}")
            return {int(k): str(v) for k, v in raw.items()}
        except Exception:
            return {}


    def catalog(self):
        if self._catalog is not None:
            return self._catalog
        result = {}
        for class_name in (LAYOUT_CLS, PROFILE_CLS):
            try:
                cls = find_class(class_name)
                fields = list(cls.getDeclaredFields())
            except Exception:
                continue
            for f in fields:
                try:
                    name = str(f.getName())
                    upper = name.upper()
                    if not (name.startswith("TAB_") or ("TAB" in upper and ("GIFT" in upper or "POLL" in upper))):
                        continue
                    if upper.endswith("COUNT") or upper.endswith("TABS"):
                        continue
                    if not Modifier.isStatic(f.getModifiers()):
                        continue
                    if str(f.getType().getName()) != "int":
                        continue
                    f.setAccessible(True)
                    value = int(f.getInt(None))
                    if value >= 0 and value not in ALIAS_TAB_IDS and value not in result:
                        result[value] = name
                except Exception:
                    continue
        if not result:
            result = dict(FALLBACK_TABS)
        names = set(result.values())
        for tab_id, name in EXTRA_TABS.items():
            if tab_id not in result and name not in names:
                result[tab_id] = name
        self._catalog = result
        return result

    def _controller(self, cls):
        try:
            return cls.getDeclaredMethod("getInstance").invoke(None)
        except Exception:
            pass
        try:
            for f in cls.getDeclaredFields():
                if Modifier.isStatic(f.getModifiers()) and f.getType() == cls:
                    f.setAccessible(True)
                    return f.get(None)
        except Exception:
            pass
        return None

    def registry_state(self):
        try:
            cls = find_class(PLUGINS_CONTROLLER_CLS)
            if cls is None:
                return None
            controller = self._controller(cls)
            if controller is None:
                return None
            map_cls = find_class("java.util.Map")
            plugin, saw_map = None, False
            c = cls
            while c is not None and str(c.getName()) != "java.lang.Object" and plugin is None:
                for f in c.getDeclaredFields():
                    try:
                        f.setAccessible(True)
                        value = f.get(controller)
                        if value is not None and map_cls.isInstance(value):
                            saw_map = True
                            if bool(value.containsKey(VIDEO_PLUGIN_ID)):
                                plugin = value.get(VIDEO_PLUGIN_ID)
                                break
                    except Exception:
                        continue
                c = c.getSuperclass()
            if plugin is None:
                return "missing" if saw_map else None
            for method_name in ("isEnabled", "isActive"):
                try:
                    return "on" if bool(plugin.getClass().getMethod(method_name).invoke(plugin)) else "off"
                except Exception:
                    continue
            for field_name in ("enabled", "isEnabled", "active"):
                value = get_private_field(plugin, field_name)
                if value is not None:
                    return "on" if bool(value) else "off"
        except Exception:
            pass
        return None

    def split_instance(self):
        try:
            import gc
            for cls in list(BasePlugin.__subclasses__()):
                try:
                    handler = cls.__dict__.get("on_plugin_load")
                    scope = getattr(handler, "__globals__", None) or {}
                    if scope.get("__id__") != VIDEO_PLUGIN_ID:
                        continue
                    for obj in gc.get_referrers(cls):
                        if isinstance(obj, cls):
                            return obj
                except Exception:
                    continue
        except Exception:
            pass
        return None

    def python_instance_alive(self):
        return self.split_instance() is not None

    def video_active(self):
        state = self.registry_state()
        if state == "on":
            return True
        if state == "off":
            return False
        if self.python_instance_alive():
            return True
        if self.video_state is not None:
            return self.video_state
        return bool(self.get_setting("video_seen", False))

    def split_flags(self):
        now = time.time()
        cached = getattr(self, "_flags_cache", None)
        if cached is not None and now - cached[0] < 1.0:
            return cached[1]
        result = (False, False)
        try:
            if self.video_active():
                media = voice = None
                inst = self.split_instance()
                if inst is not None:
                    try:
                        flags = getattr(inst, "flags", None)
                        if flags is not None:
                            media, voice = bool(flags.get("media")), bool(flags.get("voice"))
                    except Exception:
                        media = voice = None
                if media is None:
                    media = self.get_setting("media_split_seen", None)
                if voice is None:
                    voice = self.get_setting("voice_split_seen", None)


                result = (False if media is None else bool(media), True if voice is None else bool(voice))
        except Exception:
            result = (False, False)
        self._flags_cache = (now, result)
        return result

    def all_ids(self):
        known = self.load_known()
        ids = set(known.keys()) | set(self.catalog().keys())
        try:

            seen_titles = set(_norm(t) for t in known.values())
            for tab_id in list(ids):
                if tab_id in known or tab_id in ALIAS_TAB_IDS:
                    continue
                if _norm(self.title_of(tab_id, {})) in seen_titles:
                    ids.discard(tab_id)
        except Exception:
            pass
        try:
            media_on, voice_on = self.split_flags()
        except Exception:
            media_on = voice_on = False

        if voice_on:
            ids.add(ROUND_TAB_ID)
        else:
            ids.discard(ROUND_TAB_ID)

        if media_on:
            ids.add(VIDEO_TAB_ID)
        else:
            ids.discard(VIDEO_TAB_ID)
        return ids

    def ids_for(self, kind):
        every = set(self.all_ids())
        if kind not in KINDS:
            return set(i for i in every if self.catalog().get(i) not in SELF_ONLY)
        catalog = self.catalog()
        if kind == "self":

            return set(i for i in every if "self" in TAB_KINDS.get(catalog.get(i), ())
                       and catalog.get(i) not in SELF_ONLY)
        shown = set(self._parse_list(self.get_setting("shown_" + kind, None)))
        shown |= set(self._parse_list(self.get_setting("foreign_tabs", None)))
        for tab_id in every:
            if tab_id in ALIAS_TAB_IDS:
                shown.add(tab_id)
            elif kind in TAB_KINDS.get(catalog.get(tab_id), ()):
                shown.add(tab_id)
        shown = set(i for i in shown if catalog.get(i) not in SELF_ONLY)
        return set(i for i in every if i in shown)

    def title_of(self, tab_id, known):


        if tab_id == ROUND_TAB_ID:
            return tr("Видеосообщения", "Video messages")
        if tab_id == VIDEO_TAB_ID:
            return tr("Видео", "Videos")
        if tab_id == MEDIA_TAB_ID and self.split_flags()[0]:
            return tr("Фото", "Photos")
        if tab_id == MEDIA_TAB_ID:
            return tr("Медиа", "Media")
        if self.catalog().get(tab_id) in TITLE_FROM_PLUGIN:
            pair = TAB_TITLES.get(self.catalog().get(tab_id))
            return tr(pair[0], pair[1])
        if tab_id in known:
            return _clean_title(known[tab_id])
        if tab_id == POLLS_TAB_ID:
            return tr("Опросы", "Polls")
        name = self.catalog().get(tab_id)
        if name:
            pair = TAB_TITLES.get(name)
            if pair:
                return tr(pair[0], pair[1])
            return name[4:].replace("_", " ").capitalize() if name.startswith("TAB_") else name
        return f"#{tab_id}"


    def _dialog_id_of(self, layout):
        owner = _field_any(layout, "profileActivity")
        if owner is None:
            owner = _field_any(layout, "parentFragment")
        value = _field_any(layout, "dialogId")
        if (value is None or int(value) == 0) and owner is not None:
            value = _field_any(owner, "dialogId")
            if value is None or int(value) == 0:
                uid = _field_any(owner, "userId")
                cid = _field_any(owner, "chatId")
                if uid is not None and int(uid) != 0:
                    value = int(uid)
                elif cid is not None and int(cid) != 0:
                    value = -int(cid)
        return (int(value) if value is not None else 0), owner

    def profile_kind(self, layout):
        try:
            dialog_id, owner = self._dialog_id_of(layout)
            if dialog_id == 0:
                return None
            if dialog_id > 0:
                try:
                    account = None
                    if owner is not None:
                        try:
                            account = int(owner.getCurrentAccount())
                        except Exception:
                            account = None
                    if account is None:
                        account = int(jclass("org.telegram.messenger.UserConfig").selectedAccount)
                    me = int(jclass("org.telegram.messenger.UserConfig").getInstance(account).getClientUserId())
                    if me == dialog_id:
                        return "self"
                except Exception:
                    pass
                return "user"
            if dialog_id in self.kind_cache:
                return self.kind_cache[dialog_id]
            kind = None
            if jclass is not None:
                account = None
                if owner is not None:
                    try:
                        account = int(owner.getCurrentAccount())
                    except Exception:
                        account = None
                if account is None:
                    account = int(jclass("org.telegram.messenger.UserConfig").selectedAccount)
                chat = jclass("org.telegram.messenger.MessagesController").getInstance(account).getChat(Long(-dialog_id))
                if chat is not None:
                    try:
                        is_channel = bool(jclass("org.telegram.messenger.ChatObject").isChannelAndNotMegaGroup(chat))
                    except Exception:
                        is_channel = (str(chat.getClass().getSimpleName()).startswith("TL_channel")
                                      and not bool(chat.megagroup))
                    kind = "channel" if is_channel else "group"
            if kind is not None:
                if len(self.kind_cache) > 256:
                    self.kind_cache.clear()
                self.kind_cache[dialog_id] = kind
            return kind
        except Exception:
            return None

    def begin_capture(self, layout):
        base = _base_class(layout, "SharedMediaLayout")
        strip = _get_field(layout, base, "scrollSlidingTextTabStrip")
        if strip is None:
            return
        self.layout = layout
        self.strip = strip
        self.strip_hash = JSystem.identityHashCode(strip)
        if len(self.known_strips) > 32:
            self.known_strips.clear()
            self.strip_kinds.clear()
        self.known_strips.add(self.strip_hash)
        self.strip_kind = self.profile_kind(layout)
        self.strip_kinds[self.strip_hash] = self.strip_kind
        try:
            self.cur_begin = int(strip.getCurrentTabId())
        except Exception:
            self.cur_begin = None
        self.captured = []
        self.done = False
        self.reapplied = False
        self.need_force = False
        self.plan_hide = None
        self.applied_count = 0
        self.suppressed = set()
        self.capturing = True

    def end_capture(self):
        layout, strip = self.layout, self.strip
        try:
            if self.capturing and self.captured and strip is not None:
                if not self.done:

                    self.apply_order(strip, call_finish=True)
                elif self.needs_reapply(strip):

                    self.apply_order(strip, call_finish=True)
                self.sync_visibility(layout, strip)
                self.maybe_force_first(layout, strip)
        finally:
            self.flush_debug()
            self.capturing = False
            self.strip = None
            self.layout = None
            self.captured = []

    def needs_reapply(self, strip):
        if self.reapplied:
            return False
        if len(self.captured) > self.applied_count:
            return True
        for tab_id in self.suppressed:
            try:
                if bool(strip.hasTab(tab_id)):
                    return True
            except Exception:
                pass
        return False

    def learn(self, titles):
        known = self.load_known()
        merged = dict(known)
        merged.update({k: _clean_title(v) for k, v in titles.items()})
        if merged != known:
            self.set_setting("known_tabs", json.dumps({str(k): v for k, v in merged.items()}, ensure_ascii=False))
            self.migrate_guessed(merged)

    def learn_kind(self, kind, ids):
        if kind not in KINDS:
            return
        key = "shown_" + kind
        seen = set(self._parse_list(self.get_setting(key, None)))
        merged = seen | set(int(i) for i in ids)
        if merged != seen:
            self.set_setting(key, json.dumps(sorted(merged)))

    def migrate_guessed(self, known):
        by_title = {}
        for tab_id, title in known.items():
            by_title.setdefault(_norm(title), tab_id)
        for key in ORDER_KEYS:
            raw = self.get_setting(key, None)
            order = self._parse_list(raw) if raw is not None else []
            if not order:
                continue
            result, changed = [], False
            for tab_id in order:
                if tab_id not in known and tab_id not in ALIAS_TAB_IDS:
                    real = by_title.get(_norm(self.title_of(tab_id, {})))
                    if real is not None and real != tab_id:
                        tab_id, changed = real, True
                if tab_id in result:
                    changed = True
                    continue
                result.append(tab_id)
            if changed:
                self.save_list(key, result)

    def add_all(self, strip, ids, by_id):
        for tab_id in ids:
            title, extra = by_id[tab_id]
            if extra:
                strip.addTextTab(tab_id, title, *extra)
            else:
                strip.addTextTab(tab_id, title)
            self.pending.discard(tab_id)

    def call_finish(self, strip):
        for name in FINISH_NAMES:
            try:
                getattr(strip, name)()
                return
            except Exception:
                continue

    def apply_order(self, strip, call_finish=False):
        if self.done:
            self.reapplied = True
        self.done = True
        by_id, seq = {}, []
        for tab_id, title, extra in self.captured:
            if tab_id not in by_id:
                by_id[tab_id] = (title, extra)
                seq.append(tab_id)
        self.applied_count = len(self.captured)
        if not seq:
            return

        if MEDIA_TAB_ID in by_id and VIDEO_TAB_ID in by_id:

            by_id[MEDIA_TAB_ID] = (tr("Фото", "Photos"), by_id[MEDIA_TAB_ID][1])
        seen_any = None
        for base_id, alias_id, key in ((VOICE_TAB_ID, ROUND_TAB_ID, "voice_split_seen"),
                                       (MEDIA_TAB_ID, VIDEO_TAB_ID, "media_split_seen")):
            if base_id in by_id or alias_id in by_id:
                on = alias_id in by_id
                seen_any = bool(seen_any) or on
                if self.get_setting(key, None) != on:
                    self.set_setting(key, on)
        if seen_any is not None:
            self.video_state = seen_any
            if self.get_setting("video_seen", None) != self.video_state:
                self.set_setting("video_seen", self.video_state)
            self._flags_cache = None
        try:
            catalog_ids = set(self.catalog().keys())
            new_ids = {i: str(by_id[i][0]) for i in seq if i not in catalog_ids and i not in ALIAS_TAB_IDS}
            if new_ids:
                self.note(f"not-in-catalog={new_ids}")
        except Exception:
            pass
        self.learn({i: str(by_id[i][0]) for i in seq})
        self.learn_kind(self.strip_kind, seq)
        self.visible.pop(self.strip_hash, None)
        self.plan_hide = False
        self.suppressed = set()


        order = self.order_for(self.strip_kind)
        desired = [i for i in order if i in by_id]
        self.note(f"strip={seq} kind={self.strip_kind} order={order} desired={desired}")
        if not desired:
            self.plan_hide = True
            return
        self.suppressed = set(i for i in seq if i not in desired)
        self.visible[self.strip_hash] = list(desired)
        if desired == seq:
            return

        try:
            cur = int(strip.getCurrentTabId())
        except Exception:
            cur = None

        self.rebuilding = True
        try:
            try:
                self.pending = set(desired) | self.suppressed
                strip.removeTabs()
                self.add_all(strip, desired, by_id)
            except Exception:
                self.pending = set()
                self.visible.pop(self.strip_hash, None)
                try:
                    strip.removeTabs()
                    self.add_all(strip, seq, by_id)
                except Exception:
                    pass
                return
            keep = cur if (cur is not None and cur in desired) else desired[0]
            if cur is not None and cur not in desired:
                self.need_force = True
            try:
                strip.setInitialTabId(keep)
            except Exception:
                pass
            if call_finish:
                self.call_finish(strip)
        finally:
            self.rebuilding = False
            self.pending = set()


    def sync_visibility(self, layout, strip):
        if self.plan_hide is None:
            return
        hide = bool(self.plan_hide)
        self._set_strip_visible(strip, not hide)
        self._set_layout_hidden(layout, hide)

    def _set_strip_visible(self, strip, visible):
        key = JSystem.identityHashCode(strip)
        try:
            if not visible:
                strip.setVisibility(8)
                parent = strip.getParent()
                wrapper = None
                try:
                    if (parent is not None and int(parent.getChildCount()) == 1
                            and parent.getClass().getSimpleName() != "SharedMediaLayout"):
                        parent.setVisibility(8)
                        wrapper = parent
                except Exception:
                    wrapper = None
                self.hidden[key] = wrapper
            elif key in self.hidden:
                strip.setVisibility(0)
                wrapper = self.hidden.pop(key)
                if wrapper is not None:
                    wrapper.setVisibility(0)
        except Exception:
            pass

    def _is_profile_layout(self, layout):
        base = _base_class(layout, "SharedMediaLayout")
        for name in ("profileActivity", "parentFragment"):
            try:
                owner = _get_field(layout, base, name)
            except Exception:
                continue
            if owner is not None:
                return str(owner.getClass().getSimpleName()) == "ProfileActivity"
        return False

    def _set_layout_hidden(self, layout, hide):
        if layout is None:
            return
        key = JSystem.identityHashCode(layout)
        try:
            if hide:
                if not self._is_profile_layout(layout):
                    return
                if len(self.hidden_layouts) > 32:
                    self.hidden_layouts.clear()
                self.hidden_layouts[key] = True
                layout.setVisibility(8)
                layout.requestLayout()
            elif key in self.hidden_layouts:
                self.hidden_layouts.pop(key, None)
                layout.setVisibility(0)
                layout.requestLayout()
        except Exception:
            pass

    def zero_height(self, layout):
        try:
            if self._set_dimension is None:
                method = find_class("android.view.View").getDeclaredMethod(
                    "setMeasuredDimension", Integer.TYPE, Integer.TYPE)
                method.setAccessible(True)
                self._set_dimension = method
            self._set_dimension.invoke(layout, int(layout.getMeasuredWidth()), 0)
        except Exception:
            pass

    def note(self, text):
        try:
            self.dbg.append(str(text))
        except Exception:
            pass

    def flush_debug(self):
        self.dbg = []

    def maybe_force_first(self, layout, strip):
        try:
            self._maybe_force_first(layout, strip)
        except Exception as e:
            self.note("force-err:" + repr(e)[:160])

    def _maybe_force_first(self, layout, strip):
        if layout is None or strip is None:
            return
        visible = self.visible.get(JSystem.identityHashCode(strip))
        if not visible:
            self.note("force:no-visible")
            return
        first = visible[0]
        self.note(f"first={first}")
        if first in ALIAS_TAB_IDS or first not in self.catalog():
            self.note("force:foreign-tab")
            return

        entry = None
        if not self.need_force:
            key = JSystem.identityHashCode(layout)
            entry = self.opened.get(key)
            if entry is None:
                if len(self.opened) > 64:
                    self.opened.clear()
                entry = self.opened[key] = [time.time(), False, None, None]


            before = self.cur_begin
            if (entry[1] and before is not None and before >= 0
                    and before != entry[3] and before in visible):
                self.note("force:user-tab")
                return

        base = _base_class(layout, "SharedMediaLayout")
        page0 = _get_field(layout, base, "mediaPages")[0]
        pbase = _base_class(page0, "MediaPage")
        sel_before = int(_get_field(page0, pbase, "selectedType"))
        try:
            cur_before = int(strip.getCurrentTabId())
        except Exception:
            cur_before = None
        self.note(f"sel={sel_before} cur={cur_before} need_force={self.need_force}")
        if sel_before != first:
            _set_int_field(page0, pbase, "selectedType", first)
            try:
                strip.selectTabWithId(first, 1.0)
            except Exception:
                pass
            for args in ((False,), ()):
                try:
                    layout.switchToCurrentSelectedMode(*args)
                    break
                except Exception:
                    continue
        else:

            try:
                if int(strip.getCurrentTabId()) != first:
                    strip.selectTabWithId(first, 1.0)
            except Exception:
                pass
        try:
            self.note(f"after: sel={int(_get_field(page0, pbase, 'selectedType'))} cur={int(strip.getCurrentTabId())}")
        except Exception:
            pass
        if entry is not None:
            try:
                ok = int(strip.getCurrentTabId()) == first
            except Exception:
                ok = False
            if ok:
                entry[1] = True
                entry[3] = first


    def reorder_saved(self, kind, visible_ids):
        hidden_now = [i for i in self.edit_list(kind) if i not in visible_ids]
        self.save_list(self.order_key(kind), list(visible_ids) + hidden_now)

    def add_many(self, kind, tab_ids):
        order = self.edit_list(kind)
        for tab_id in tab_ids:
            if tab_id not in order:
                order.append(tab_id)
        self.save_list(self.order_key(kind), order)

    def remove_many(self, kind, tab_ids):
        drop = set(tab_ids)
        self.save_list(self.order_key(kind), [i for i in self.edit_list(kind) if i not in drop])


    def _context(self):
        try:
            fragment = get_last_fragment()
            activity = fragment.getParentActivity() if fragment is not None else None
            if activity is not None:
                return activity
        except Exception:
            pass
        return ApplicationLoader.applicationContext

    def _note_view(self):
        dp = AndroidUtilities.dp
        pal = Palette()
        word = "Split Tabs"
        text = tr(
            "Совместимость гарантируется только с Split Tabs. Для других плагинов, добавляющих вкладки, гарантий нет.",
            "Only Split Tabs is guaranteed to work. No guarantees for other plugins that add tabs.",
        )
        span = jclass("android.text.SpannableString")(text)
        start = text.index(word)
        span.setSpan(jclass("android.text.style.URLSpan")(SPLIT_TABS_URL), start, start + len(word), 33)
        view = TextView(self._context())
        view.setText(span)
        view.setTextSize(13.0)
        view.setTextColor(pal.gray)
        view.setLinkTextColor(pal.accent)
        view.setMovementMethod(jclass("android.text.method.LinkMovementMethod").getInstance())
        view.setPadding(dp(20), dp(2), dp(20), dp(16))
        return view

    def create_settings(self):
        try:
            self.probe_foreign_tabs()
        except Exception:
            pass
        rows = [
            Divider(text=tr(
                "Тяни вкладку, чтобы поменять порядок, удерживай, чтобы выбрать и удалить. "
                "Показываются только вкладки из списка.",
                "Drag a tab to reorder, hold to select and delete. "
                "Only listed tabs are shown.",
            )),
        ]
        if UI_OK:
            try:
                rows.append(Custom(view=Panel(self, self._context()).root))
            except Exception:
                pass
        rows.append(Divider(text=tr(
            "Тип с выключенным переключателем использует общий порядок.\n\n"
            "Вкладки других плагинов находятся сами и предлагаются для всех типов профилей. "
            "Если установили или удалили такой плагин, нажмите значок перезагрузки справа вверху.",
            "A type with its switch off uses the common order.\n\n"
            "Tabs of other plugins are found automatically and offered for every profile type. "
            "If you installed or removed such a plugin, tap the reload icon at the top right.",
        )))
        if UI_OK and jclass is not None:
            try:
                rows.append(Custom(view=self._note_view()))
            except Exception:
                pass
        return rows
