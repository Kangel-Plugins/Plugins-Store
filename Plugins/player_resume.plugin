__id__ = "player_resume"
__name__ = "Player Resume"
__description__ = "Сворачивание плеера в кнопку у FAB при закрытии"
__author__ = "@RnPlugins"
__version__ = "1.0.1"
__build__ = 65
__icon__ = "RnDev/8"
__app_version__ = ">=12.10.6"
__sdk_version__ = ">=1.4.3.3"

import base64
from base_plugin import BasePlugin
from ui.settings import Header, Selector, Switch, Text, Divider
from java.nio import ByteBuffer
from dalvik.system import InMemoryDexClassLoader
from org.telegram.messenger import ApplicationLoader

DEX_B64 = """"""


class PlayerResumePlugin(BasePlugin):
    def _invoke_static(self, name, *args):
        if not getattr(self, "dex_class", None):
            return False
        for m in self.dex_class.getMethods():
            if m.getName() == name and len(m.getParameterTypes()) == len(args):
                try:
                    m.invoke(None, *args)
                    return True
                except Exception as e:
                    self.log(f"Error invoking {name}: {e}")
        return False

    def _save_to_prefs(self, key, value):
        try:
            ctx = ApplicationLoader.applicationContext
            if ctx is not None:
                p = ctx.getSharedPreferences("player_resume_prefs", 0)
                editor = p.edit()
                if isinstance(value, bool):
                    editor.putBoolean(key, value)
                elif isinstance(value, int):
                    editor.putInt(key, value)
                editor.apply()
        except Exception as e:
            self.log(f"Error saving {key} to prefs: {e}")

    def _get_from_prefs(self, key, default):
        try:
            ctx = ApplicationLoader.applicationContext
            if ctx is not None:
                p = ctx.getSharedPreferences("player_resume_prefs", 0)
                if isinstance(default, bool):
                    return p.getBoolean(key, default)
                elif isinstance(default, int):
                    return p.getInt(key, default)
        except Exception as e:
            self.log(f"Error getting {key} from prefs: {e}")
        return default

    def on_setting_changed(self, key, value):
        try:
            if key in ("startup_mode", "protection_timeout", "pill_position", "pill_shape"):
                int_val = int(value)
                self.set_setting(key, int_val)
                self._save_to_prefs(key, int_val)
                self._invoke_set_setting(key, int_val)
            elif key == "playlist_protection":
                bool_val = bool(value)
                int_val = 1 if bool_val else 0
                self.set_setting(key, bool_val)
                self._save_to_prefs(key, bool_val)
                self._invoke_set_setting(key, int_val)
                self._invoke_static("refreshSettingsUi")
            else:
                bool_val = bool(value)
                int_val = 1 if bool_val else 0
                self.set_setting(key, bool_val)
                self._save_to_prefs(key, bool_val)
                self._invoke_set_setting(key, int_val)
        except Exception as e:
            self.log(f"Error on_setting_changed {key}: {e}")
        self.apply_settings()

    def on_timeout_click(self, _=None):
        if not getattr(self, "dex_class", None):
            return
        try:
            from java.lang import Integer
            timeout = int(self.get_setting("protection_timeout", 29))
            for m in self.dex_class.getMethods():
                if m.getName() == "showTimeoutPicker" and len(m.getParameterTypes()) == 1:
                    m.invoke(None, Integer(timeout))
                    return
        except Exception as e:
            self.log(f"Error showing timeout picker: {e}")

    def _invoke_set_setting(self, key, int_val):
        if not getattr(self, "dex_class", None):
            return
        try:
            from java.lang import String, Integer
            for m in self.dex_class.getMethods():
                if m.getName() == "setSetting" and len(m.getParameterTypes()) == 2:
                    m.invoke(None, String(key), Integer(int_val))
                    return
        except Exception as e:
            self.log(f"Error invoking setSetting: {e}")

    def apply_settings(self):
        restore_paused = bool(self.get_setting("restore_paused", True))
        minimize_on_close = bool(self.get_setting("minimize_on_close", True))
        try:
            startup_mode = int(self.get_setting("startup_mode", 0))
        except Exception:
            startup_mode = 0
        playlist_protection = bool(self.get_setting("playlist_protection", False))
        try:
            protection_timeout = int(self.get_setting("protection_timeout", 29))
        except Exception:
            protection_timeout = 29
        try:
            pill_position = int(self.get_setting("pill_position", 0))
        except Exception:
            pill_position = 0
        try:
            pill_shape = int(self.get_setting("pill_shape", 0))
        except Exception:
            pill_shape = 0

        self._save_to_prefs("restore_paused", restore_paused)
        self._save_to_prefs("minimize_on_close", minimize_on_close)
        self._save_to_prefs("startup_mode", startup_mode)
        self._save_to_prefs("playlist_protection", playlist_protection)
        self._save_to_prefs("protection_timeout", protection_timeout)
        self._save_to_prefs("pill_position", pill_position)
        self._save_to_prefs("pill_shape", pill_shape)

        if not getattr(self, "dex_class", None):
            return

        try:
            from java.lang import Boolean, Integer
            for m in self.dex_class.getMethods():
                if m.getName() == "updateSettings" and len(m.getParameterTypes()) == 7:
                    m.invoke(
                        None,
                        Boolean(restore_paused),
                        Boolean(minimize_on_close),
                        Integer(startup_mode),
                        Boolean(playlist_protection),
                        Integer(protection_timeout),
                        Integer(pill_position),
                        Integer(pill_shape),
                    )
                    return
        except Exception as e:
            self.log(f"Error invoking updateSettings: {e}")

        self._invoke_set_setting("restore_paused", 1 if restore_paused else 0)
        self._invoke_set_setting("minimize_on_close", 1 if minimize_on_close else 0)
        self._invoke_set_setting("startup_mode", startup_mode)
        self._invoke_set_setting("playlist_protection", 1 if playlist_protection else 0)
        self._invoke_set_setting("protection_timeout", protection_timeout)
        self._invoke_set_setting("pill_position", pill_position)
        self._invoke_set_setting("pill_shape", pill_shape)

    def show_author_sheet(self):
        try:
            if getattr(self, "author_sheet_class", None) is not None:
                self.author_sheet_class.getMethod("showFromCurrentActivity").invoke(None)
            else:
                self.log("Author sheet class not loaded")
        except Exception as e:
            self.log(f"Error showing author sheet: {e}")

    def on_author_click(self, _=None):
        self.show_author_sheet()

    def create_settings(self):
        self.apply_settings()
        timeout = int(self.get_setting("protection_timeout", 29))
        is_protection_enabled = bool(self.get_setting("playlist_protection", False))

        items = [
            Header(text="Кнопка"),
            Switch(
                key="minimize_on_close",
                text="Сворачивать в кнопку",
                subtext="Прятать плеер у FAB при закрытии",
                default=bool(self.get_setting("minimize_on_close", True)),
                icon="msg_calls_minimize",
                on_change=lambda val: self.on_setting_changed("minimize_on_close", val),
            ),
            Selector(
                key="pill_position",
                text="Положение",
                default=int(self.get_setting("pill_position", 0)),
                items=[
                    "Слева",
                    "Сверху",
                ],
                icon="msg_forward_replace",
                on_change=lambda val: self.on_setting_changed("pill_position", val),
            ),
            Selector(
                key="pill_shape",
                text="Форма",
                default=int(self.get_setting("pill_shape", 0)),
                items=[
                    "Квадрат",
                    "Круг",
                ],
                icon="msg_photo_cropfix",
                on_change=lambda val: self.on_setting_changed("pill_shape", val),
            ),
            Header(text="Воспроизведение"),
            Switch(
                key="restore_paused",
                text="На паузе",
                subtext="Не запускать звук автоматически",
                default=bool(self.get_setting("restore_paused", True)),
                icon="msg_media",
                on_change=lambda val: self.on_setting_changed("restore_paused", val),
            ),
            Selector(
                key="startup_mode",
                text="При запуске",
                default=int(self.get_setting("startup_mode", 0)),
                items=[
                    "Сохранять",
                    "Открывать плеер",
                    "Сворачивать в кнопку",
                ],
                icon="msg_retry",
                on_change=lambda val: self.on_setting_changed("startup_mode", val),
            ),
            Divider(),
            Switch(
                key="playlist_protection",
                text="Защита плейлиста",
                subtext="Возвращать прошлый плейлист при быстром прослушивании",
                default=is_protection_enabled,
                icon="msg_secret",
                on_change=lambda val: self.on_setting_changed("playlist_protection", val),
            ),
        ]

        if is_protection_enabled:
            items.append(
                Text(
                    text="Время проверки",
                    subtext=f"{timeout} сек",
                    icon="msg_autodelete",
                    on_click=self.on_timeout_click,
                )
            )

        items.extend([
            Header(text="Об авторе"),
            Text(
                text="Автор",
                subtext="Подробнее о разработчике",
                icon="msg_openprofile",
                on_click=self.on_author_click,
            ),
        ])
        return items

    def on_plugin_load(self):
        self.dex_class = None
        self.dex_loader = None
        self.author_sheet_class = None
        try:
            dex_bytes = base64.b64decode(DEX_B64)
            buffer = ByteBuffer.wrap(dex_bytes)
            parent_cl = ApplicationLoader.applicationContext.getClassLoader()
            self.dex_loader = InMemoryDexClassLoader(buffer, parent_cl)
            self.dex_class = self.dex_loader.loadClass("dev.rooni.playerresume.PlayerResume")
            try:
                self.author_sheet_class = self.dex_loader.loadClass("dev.rooni.author.AuthorBottomSheet")
            except Exception:
                pass
            self._invoke_static("start")
            try:
                self.apply_settings()
            except Exception as e:
                self.log(f"apply_settings error: {e}")
        except Exception as e:
            self.log(f"Failed to load PlayerResume: {e}")

    def on_plugin_unload(self):
        try:
            if getattr(self, "author_sheet_class", None) is not None:
                try:
                    self.author_sheet_class.getMethod("dismissCurrent").invoke(None)
                except Exception:
                    pass
            if getattr(self, "dex_class", None) is not None:
                self._invoke_static("stop")
        except Exception as e:
            self.log(f"Failed to unload PlayerResume: {e}")
        finally:
            self.dex_class = None
            self.author_sheet_class = None
            self.dex_loader = None
