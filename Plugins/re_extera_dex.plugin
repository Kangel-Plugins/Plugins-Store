__id__ = "re_extera_dex"
__name__ = "re:extera v2"
__description__ = "Enable ghost mode, save deleted messages and more!"
__author__ = "@shiawasez | @shikaatuxplugins \noriginal author: @bleizixPlugins"
__version__ = "3.0.1"
__icon__ = "myadestes_1_amashiro_natsuki_plus_nacho_neko/30"
__min_version__ = "13.1.1"

import base64
import os
import shutil
from typing import Any

from base_plugin import BasePlugin
from client_utils import get_last_fragment
from dalvik.system import InMemoryDexClassLoader
from java.nio import ByteBuffer
from org.telegram.messenger import ApplicationLoader, LocaleController
from ui.bulletin import BulletinHelper
from ui.settings import Text

ENTRY_CLASS = "ni.shikatu.re_extera.Initializer"
LEGACY_CACHE_DIR = "re_extera_cache"


def is_russian():
    return LocaleController.getInstance().getCurrentLocale().getLanguage() == "ru"


def remove_legacy_cache():
    files_dir = ApplicationLoader.applicationContext.getFilesDir().getAbsolutePath()
    shutil.rmtree(os.path.join(files_dir, LEGACY_CACHE_DIR), ignore_errors=True)


class Loader:
    def __init__(self, plugin: BasePlugin):
        self.plugin = plugin
        self.entry = None

    def load(self):
        dex = base64.b64decode(DEX_BASE64)
        class_loader = InMemoryDexClassLoader(ByteBuffer.wrap(dex), ApplicationLoader.applicationContext.getClassLoader())
        self.entry = class_loader.loadClass(ENTRY_CLASS)
        self.call("init")
        self.plugin.log("re:extera loaded")

    def call(self, name):
        if self.entry is None:
            return
        try:
            self.entry.getMethod(name).invoke(None)
        except Exception as e:
            self.plugin.log(f"Failed to call {name}: {e}")


class Plugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self.loader = None

    def on_plugin_load(self) -> None:
        self.log(f"Init {__version__}")
        remove_legacy_cache()
        self.loader = Loader(self)
        try:
            self.loader.load()
        except Exception as e:
            self.log(f"Failed to load re:extera: {e}")
            prefix = "Ошибка загрузки re:extera" if is_russian() else "Error loading re:extera"
            BulletinHelper.show_info(f"{prefix}: {e}", get_last_fragment())

    def on_plugin_unload(self) -> None:
        if self.loader is not None:
            self.loader.call("unload")

    def create_settings(self) -> list[Any]:
        title = "Настройки re:extera" if is_russian() else "re:extera Settings"
        return [Text(text=title, on_click=lambda v: self.loader and self.loader.call("showSettings"))]


