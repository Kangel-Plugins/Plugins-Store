def _classify(text: str):
    """Возвращает (категория, название, тип, включено). Неизвестные строки — кнопками в «Прочее»."""
    hit = DEBUG_SPECS.get(text.strip().lower())
    if hit is not None:
        return hit
    return "Прочее", text, "btn", None


# Данные последнего открытого меню: пункты, слушатель оригинального диалога, экран настроек.
_DBG = None
_DBG_SCREEN = None  # Java-экран меню отладки, чтобы перерисовать список
_DebugScreenClass = None


def _debug_screen():
    """Экран отладки: Java-подкласс UniversalFragment (тот же класс, что у экранов настроек)."""
    global _DebugScreenClass
    if _DebugScreenClass is None:
        from extera_utils.classes import Base, java_subclass, joverload
        from org.telegram.ui.Components import UniversalFragment

        @java_subclass(UniversalFragment)
        class _DebugScreen(Base):
            @joverload("getTitle", [])
            def get_title(self):
                return _t("debug_title")

            @joverload("fillItems", ["java.util.ArrayList", "org.telegram.ui.Components.UniversalAdapter"])
            def fill_items(self, items, adapter):
                _fill_debug_items(items)

            @joverload("onClick", ["org.telegram.ui.Components.UItem", "android.view.View", "int", "float", "float"])
            def on_click(self, item, view, position, x, y):
                _on_debug_click(item)

            @joverload("onLongClick", ["org.telegram.ui.Components.UItem", "android.view.View", "int", "float", "float"])
            def on_long_click(self, item, view, position, x, y):
                return False

        _DebugScreenClass = _DebugScreen
    return _DebugScreenClass.new_instance()


def _pref_get(key: str) -> bool:
    from org.telegram.messenger import MessagesController
    return bool(MessagesController.getGlobalMainSettings().getBoolean(key, False))


def _pref_set(key: str, value: bool):
    from org.telegram.messenger import MessagesController
    MessagesController.getGlobalMainSettings().edit().putBoolean(key, bool(value)).commit()


