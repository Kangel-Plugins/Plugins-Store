def _t(key: str, plugin=None, **kw) -> str:
    lang = _lang(plugin)
    s = _TR.get(lang, _TR["ru"]).get(key)
    if s is None:
        s = _TR["ru"].get(key, key)
    if kw:
        try:
            return s.format(**kw)
        except Exception:
            return s
    return s


# ======================= Общее =======================

# Типы элементов UniversalAdapter (см. исходники Telegram).
HEADER_TYPES = {0, 1}  # VIEW_TYPE_HEADER, VIEW_TYPE_BLACK_HEADER
BREAK_TYPES = {-4, -3, -2, -1, 2, 7, 8}  # тени и служебные элементы, отделяют блоки
SHADOW_TYPE = 7  # VIEW_TYPE_SHADOW
CUSTOM_SHADOW_TYPE = -4  # VIEW_TYPE_CUSTOM_SHADOW, верхняя тень и футер с версией
SPACE_TYPE = 28  # VIEW_TYPE_SPACE


def _jfield(obj, name):
    """Public-поле Java через рефлексию."""
    return obj.getClass().getField(name).get(obj)


def _jget(obj, name):
    """Поле Java любого уровня видимости через рефлексию."""
    c = obj.getClass()
    while c is not None:
        try:
            f = c.getDeclaredField(name)
        except Exception:
            c = c.getSuperclass()
            continue
        f.setAccessible(True)
        return f.get(obj)
    raise AttributeError(f"поле не найдено: {name}")


def _jint(i):
    """Явный int для Java-перегрузок (remove/add по индексу)."""
    try:
        from java import jint
        return jint(i)
    except Exception:
        return i


def _as_bool(v) -> bool:
    if isinstance(v, bool):
        return v
    if isinstance(v, (int, float)):
        return v != 0
    if isinstance(v, str):
        s = v.strip().lower()
        if s in ("false", "0", "no", "off", ""):
            return False
        if s in ("true", "1", "yes", "on"):
            return True
    return bool(v)


def _scan(items):
    """Разбивает список на блоки: (индекс заголовка или None, текст заголовка, [(индекс, id, текст, item)])."""
    blocks = []
    header_idx = None
    header_text = ""
    cells = []

    def flush():
        if cells:
            blocks.append((header_idx, header_text, list(cells)))

    for i in range(items.size()):
        item = items.get(i)
        vt = int(_jfield(item, "viewType"))
        if vt in HEADER_TYPES:
            flush()
            cells = []
            header_idx = i
            header_text = str(_jfield(item, "text") or "")
        elif vt in BREAK_TYPES:
            flush()
            cells = []
            header_idx = None
            header_text = ""
        else:
            item_id = int(_jfield(item, "id"))
            text = _jfield(item, "text")
            if text is not None:
                cells.append((i, item_id, str(text), item))
    flush()
    return blocks


