_ICON_ENTRY_CACHE = {}
_RUNTIME_LOCALE_CACHE = (None, {})


def _icon_entry_name(rid: int) -> str:
    if not rid:
        return ""
    cached = _ICON_ENTRY_CACHE.get(rid)
    if cached is not None:
        return cached
    name = ""
    try:
        from org.telegram.messenger import ApplicationLoader
        name = str(ApplicationLoader.applicationContext.getResources().getResourceEntryName(int(rid)) or "")
    except Exception:
        name = ""
    _ICON_ENTRY_CACHE[rid] = name
    return name


def _runtime_locale_by_text() -> dict:
    """Строит словарь {локализованное_название: ключ} из текущего LocaleController / R.string."""
    global _RUNTIME_LOCALE_CACHE
    try:
        from org.telegram.messenger import LocaleController
        lc = LocaleController.getInstance()
        info = lc.getCurrentLocaleInfo()
        lang_tag = (
            str(info.shortName or "") + "|" + str(info.pluralLangCode or "")
        ) if info is not None else "default"
    except Exception:
        lang_tag = "default"
    if _RUNTIME_LOCALE_CACHE[0] == lang_tag and _RUNTIME_LOCALE_CACHE[1]:
        return _RUNTIME_LOCALE_CACHE[1]
    out = {}
    try:
        from org.telegram.messenger import LocaleController
        r_str = _try_jclass("org.telegram.messenger.R$string")
        if r_str is not None:
            for r_name, key in RUNTIME_R_STRINGS.items():
                try:
                    rid = int(r_str.getField(r_name).getInt(None))
                    val = LocaleController.getString(rid)
                    if val is not None:
                        s = str(val).strip()
                        if s:
                            out[s] = key
                            out[s.lower()] = key
                except Exception:
                    pass
    except Exception:
        pass
    _RUNTIME_LOCALE_CACHE = (lang_tag, out)
    return out


def _strip_new_badge(t: str) -> str:
    low = t.lower()
    for suf in (" new", " новое", " новий", " жаңа", " neu", " nuevo", " nouveau"):
        if low.endswith(suf):
            return t[:len(t) - len(suf)].strip()
    return t


# Заголовок и подпись собственного экрана плагина: такие экраны не трогаем, там переключатели с теми же названиями.
def _key_for_text(text):
    """Ключ пункта по тексту: RU/EN, текущий LocaleController (любой язык), бейдж NEW и подстроки форков."""
    t = text.strip()
    if not t:
        return None
    for cand in (t, _strip_new_badge(t)):
        key = HIDABLE_BY_TEXT.get(cand)
        if key is not None:
            return key
        loc_map = _runtime_locale_by_text()
        key = loc_map.get(cand) or loc_map.get(cand.lower())
        if key is not None:
            return key
    low = t.lower()
    if low in ("privacy & security", "chats", "chat"):
        return "privacy" if "privacy" in low else "chat"
    if len(low) <= 48:
        if "ayugram" in low or "ayupreferences" in low or "ayusettings" in low:
            return "ayugram"
        if "exteragram" in low or "exterapreferences" in low or "exteraless" in low or low == "extera":
            return "exteragram"
    return None


def _key_for_item(item, allow_id: bool = False):
    """Определяет ключ пункта по иконке (любой язык), тексту/локали и (для SettingsActivity) по UItem.id."""
    try:
        rid = int(_jfield(item, "iconResId"))
    except Exception:
        rid = 0
    if rid != 0:
        ename = _icon_entry_name(rid).lower()
        if ename:
            key = ICON_NAME_TO_KEY.get(ename)
            if key is not None:
                return key
            if "ayu" in ename and "ghost" not in ename:
                return "ayugram"
            if "extera" in ename or ename.startswith("etg_"):
                return "exteragram"
    try:
        text = _jfield(item, "text")
    except Exception:
        text = None
    if text is not None:
        key = _key_for_text(str(text))
        if key is not None:
            return key
    if allow_id and text is not None:
        try:
            item_id = int(_jfield(item, "id"))
        except Exception:
            item_id = 0
        if item_id in SETTINGS_ID_TO_KEY:
            return SETTINGS_ID_TO_KEY[item_id]
        if item_id == -1 and rid != 0:
            return "ayugram" if "ayu" in str(text).lower() else "exteragram"
    return None


