def _translate_client_dbg_text(text, strict=False):
    if text is None:
        return None
    s = str(text)
    low = s.strip().lower()
    tr = _CLIENT_DBG_EXACT.get(low)
    if tr is not None:
        return tr
    for pref, ptr in _CLIENT_DBG_PREFIXES:
        if low.startswith(pref):
            return ptr
    if not strict and low.startswith("cpu "):
        return "ЦП: " + s.strip()[4:]
    return None


def _translate_client_dbg_val(val):
    if val is None:
        return None
    s = str(val)
    low = s.strip().lower()
    tr = _CLIENT_DBG_VALUES.get(low)
    if tr is not None:
        return tr
    if low.startswith("__no_google_play"):
        return "Нет Google Play"
    if "cpu since launch" in low:
        return s.replace("CPU since launch", "ЦП с запуска").replace("cpu since launch", "ЦП с запуска")
    if "cpu since " in low:
        return s.replace("CPU since ", "ЦП с ").replace("cpu since ", "ЦП с ")
    return None


def _translate_client_debug_list(items):
    """Переводит элементы списка UniversalAdapter на экранах отладки exteraGram и AyuGram."""
    if _is_en():
        return False
    try:
        n = items.size()
    except Exception:
        return False
    if n == 0 or n > LIST_MAX_ITEMS:
        return False
    hits = 0
    for i in range(n):
        t = _jfield(items.get(i), "text")
        if t is not None and _translate_client_dbg_text(t, strict=True) is not None:
            hits += 1
            if hits >= 2:
                break
    if hits < 2:
        return False
    changed = False
    for i in range(n):
        item = items.get(i)
        t = _jfield(item, "text")
        tr = _translate_client_dbg_text(t, strict=False)
        if tr is not None and tr != str(t):
            item.text = tr
            changed = True
        sub = _jfield(item, "subtext")
        tr_sub = _translate_client_dbg_text(sub, strict=True)
        if tr_sub is not None and tr_sub != str(sub):
            item.subtext = tr_sub
            changed = True
        val = _jfield(item, "textValue")
        tr_val = _translate_client_dbg_val(val)
        if tr_val is not None and tr_val != str(val):
            item.textValue = tr_val
            changed = True
    return changed


def _client_debug_kind(frag):
    """Возвращает 'extera', 'ayu' или None, если это не экран отладки клиента."""
    if frag is None:
        return None
    for own in (_DBG_SCREEN, _DBG_DEV_SCREEN, _DBG_DATA_SCREEN, _WARN_SCREEN):
        if own is not None:
            try:
                if System.identityHashCode(frag) == System.identityHashCode(own):
                    return None
            except Exception:
                pass
    try:
        cname = str(frag.getClass().getName())
    except Exception:
        return None
    clow = cname.lower()
    if ".plugins." in clow or "_debugscreen" in clow or "_devscreen" in clow or "_datascreen" in clow or "_forkhidewarningscreen" in clow:
        return None
    if cname in EXTERA_DEBUG_CLASSES or (cname.startswith("com.exteragram.") and "debug" in clow):
        return "extera"
    if cname in AYU_DEBUG_CLASSES or (cname.startswith("com.radolyn.") and "debug" in clow):
        return "ayu"
    title = _get_fragment_title(frag)
    if title == "🤔" or title == "Отладка AyuGram 🤔":
        return "ayu"
    if (cname.startswith("com.exteragram.") or cname.startswith("com.radolyn.")) and title in ("Debug", "Отладка exteraGram"):
        return "extera"
    return None


def _try_present_fragment(host, frag):
    """Открывает экран через _DBG_SCREEN (с откатом на parentLayout и исходный SettingsActivity)."""
    global _IN_CLIENT_DEBUG_SCREEN
    kind = _client_debug_kind(frag)
    if kind is not None:
        _IN_CLIENT_DEBUG_SCREEN = kind
    for fn in (
        lambda: host.presentFragment(frag),
        lambda: host.getParentLayout().presentFragment(frag),
        lambda: (_DBG or {}).get("frag").presentFragment(frag),
    ):
        try:
            res = fn()
            if res is None or bool(res):
                return True
        except Exception:
            pass
    return False


def _open_fork_debug(which):
    """Открывает встроенный экран отладки exteraGram или AyuGram (🤔)."""
    label = "exteraGram" if which == "exteragram" else "AyuGram"
    host = _DBG_SCREEN
    if host is None:
        return
    base_py_cls = _try_jclass("org.telegram.ui.ActionBar.BaseFragment")
    base_jcls = _to_java_class("org.telegram.ui.ActionBar.BaseFragment")

    cached = _FOUND_DEBUG_CLASS.get(which)
    if cached:
        frag = _instantiate_by_name(cached, base_py_cls, base_jcls)
        if frag is not None and _try_present_fragment(host, frag):
            return

    candidates = EXTERA_DEBUG_CLASSES if which == "exteragram" else AYU_DEBUG_CLASSES
    for cname in candidates:
        frag = _instantiate_by_name(cname, base_py_cls, base_jcls)
        if frag is not None and _try_present_fragment(host, frag):
            _FOUND_DEBUG_CLASS[which] = cname
            return

    prefixes = ("com.exteragram.", "org.telegram.ui.") if which == "exteragram" else ("com.radolyn.", "org.telegram.ui.")
    dex_names = _iter_dex_classes(base_jcls, prefixes)

    for kws in (("debug",), ("dev", "easter", "secret", "hidden", "diag")):
        for cname in dex_names:
            low = cname.lower()
            if which == "exteragram" and cname.startswith("org.telegram.ui.") and "extera" not in low:
                continue
            if which == "ayugram" and cname.startswith("org.telegram.ui.") and "ayu" not in low:
                continue
            if not any(kw in low for kw in kws):
                continue
            frag = _instantiate_by_name(cname, base_py_cls, base_jcls)
            if frag is not None and _try_present_fragment(host, frag):
                _FOUND_DEBUG_CLASS[which] = cname
                return

    if which == "ayugram":
        try:
            ayu_prefs = _to_java_class("com.radolyn.ayugram.ui.preferences.AyuGramPreferencesActivity", base_jcls)
            if ayu_prefs is not None:
                for inner in ayu_prefs.getDeclaredClasses():
                    frag = _instantiate_java_class(inner, base_jcls)
                    if frag is not None and _try_present_fragment(host, frag):
                        _FOUND_DEBUG_CLASS[which] = str(inner.getName())
                        return
        except Exception:
            pass
        for cname in dex_names:
            if not cname.startswith("com.radolyn."):
                continue
            frag = _instantiate_by_name(cname, base_py_cls, base_jcls)
            if frag is None:
                continue
            title = _get_fragment_title(frag)
            tlow = title.lower()
            if (title == "🤔" or "debug" in tlow or "отлад" in tlow) and _try_present_fragment(host, frag):
                _FOUND_DEBUG_CLASS[which] = cname
                return

    BulletinHelper.show_info(_t("dbg_not_found", label=label))


def _fill_debug_items(items, only=None):
    from org.telegram.ui.Components import UItem

    if only is None:
        items.add(_fork_debug_row_item("exteragram", EXTERA_DEBUG_ROW_ID, _t("extera_dbg_title")))
        if _is_ayugram_client():
            items.add(_fork_debug_row_item("ayugram", AYU_DEBUG_ROW_ID, _t("ayu_dbg_title")))
        items.add(UItem.asShadow(936002, None))

    data = _DBG or {}
    states = data.setdefault("state", {})  # текущее состояние переключателей: idx -> bool
    groups = {cat: [] for cat in CATEGORY_ORDER}
    for idx, text in data.get("entries", []):
        if text.strip().lower() in CALL_REPLACED_KEYS:
            continue
        cat, title, kind, on = _classify(text)
        if kind == "sw":
            if idx not in states:
                states[idx] = bool(on)
            # id = индекс + 1, чтобы не использовать 0 и не пересекаться с служебными id
            groups.setdefault(cat, []).append((idx + 1, title, "sw", states[idx]))
        else:
            groups.setdefault(cat, []).append((idx + 1, title, "btn", False))

    groups.setdefault("Звонки", []).extend([
        (CALL_TCP_ID, "__CALL_TCP__", "sw", _pref_get(CALL_TCP_KEY)),
        (CALL_CS_ID, "__CALL_CS__", "sw", _pref_get(CALL_CS_KEY)),
        (0, _t("call_warning"), "note", False),
    ])

    n = 0  # уникальные id заголовков и разделителей: одинаковые id ломают обновление списка
    for cat in CATEGORY_ORDER:
        if only is None and cat == DEV_CAT:
            continue  # на главном экране вместо неё строка-переход
        if only is not None and cat != only:
            continue
        rows = groups.get(cat)
        if not rows:
            continue
        n += 1
        if only is None and cat == CONFIRM_CAT:
            items.add(_data_row_item())  # на главном экране — строка-переход
            items.add(UItem.asShadow(930000 + n, None))
            continue
        if only is None:
            items.add(UItem.asHeader(910000 + n, _t_debug_cat(cat)))
        for bi, part in enumerate(_order_rows(cat, rows)):
            if bi > 0:
                items.add(UItem.asShadow(935000 + n * 10 + bi, None))  # разделитель между блоками
            for item_id, title, kind, on in part:
                if title == "__CALL_TCP__":
                    disp_title = _t("call_tcp")
                    hint = None
                elif title == "__CALL_CS__":
                    disp_title = _t("call_cs")
                    hint = None
                else:
                    disp_title = _t_debug_item(title)
                    hint = _t_debug_hint(title)
                if kind == "sw":
                    # подпись у переключателя — мелким шрифтом под названием
                    row = UItem.asButtonCheck(item_id, disp_title, hint) if hint else UItem.asCheck(item_id, disp_title)
                    row.setChecked(bool(on))
                    items.add(row)
                elif kind == "note":
                    items.add(UItem.asShadow(920000 + n, disp_title))
                else:
                    cell_item = _hint_button_item(item_id, disp_title, hint) if hint else None
                    if cell_item is not None:
                        items.add(cell_item)
                    else:
                        items.add(UItem.asButton(item_id, disp_title))
                        if hint:
                            items.add(UItem.asShadow(940000 + item_id, hint))
        items.add(UItem.asShadow(930000 + n, None))
    if only is None:
        items.add(UItem.asShadow(936000, None))
        items.add(_dev_row_item())
        items.add(UItem.asShadow(936001, None))


CONFIRM_CAT = "Данные, кэш и сброс"  # кнопки этой категории выполняются только после подтверждения


def _entry_text(idx):
    """Исходный текст пункта меню Telegram по индексу."""
    for entry_idx, text in (_DBG or {}).get("entries", []):
        if entry_idx == idx:
            return text
    return None


def _ask_then_run(idx, title):
    """Окно подтверждения, затем действие Telegram и перерисовка экрана."""
    activity = _DBG_SCREEN.getParentActivity() if _DBG_SCREEN is not None else None
    if activity is None:
        _run_debug_action(idx)
        _refresh_debug_screen()
        return
    builder = AlertDialogBuilder(activity)
    builder.set_title(_t("confirm_title"))
    builder.set_message(_t("confirm_msg", title=title))

    def yes(bld, which):
        bld.dismiss()
        _run_debug_action(idx)
        _refresh_debug_screen()

    def no(bld, which):
        bld.dismiss()

    builder.set_positive_button(_t("confirm_yes"), yes)
    builder.set_negative_button(_t("confirm_no"), no)
    builder.show()


def _press_button(idx):
    """Нажатие на пункт: кнопки категории «Данные, кэш и сброс» — через подтверждение."""
    text = _entry_text(idx)
    if text is not None:
        cat, title, kind, _ = _classify(text)
        if cat == CONFIRM_CAT and kind == "btn":
            _ask_then_run(idx, _t_debug_item(title))
            return
    _run_debug_action(idx)
    _refresh_debug_screen()


def _on_debug_click(item):
    """Нажатие в экране отладки: переключатели меняем здесь, действие запускаем у Telegram, список перерисовываем."""
    item_id = int(_jfield(item, "id"))
    if item_id == EXTERA_DEBUG_ROW_ID:
        _open_fork_debug("exteragram")
        return
    if item_id == AYU_DEBUG_ROW_ID:
        _open_fork_debug("ayugram")
        return
    if _DBG is None:
        return
    if item_id == DEV_ROW_ID:
        _open_dev_screen()
        return
    if item_id == DATA_ROW_ID:
        _open_data_screen()
        return
    if item_id in (CALL_TCP_ID, CALL_CS_ID):
        key = CALL_TCP_KEY if item_id == CALL_TCP_ID else CALL_CS_KEY
        _pref_set(key, not _pref_get(key))
        _refresh_debug_screen()
        return
    if item_id >= 900000:
        return  # заголовки и разделители не нажимаются
    idx = item_id - 1
    states = _DBG.setdefault("state", {})
    if idx in states:
        states[idx] = not states[idx]
    _press_button(idx)


def _refresh_debug_screen():
    for scr in (_DBG_SCREEN, _DBG_DEV_SCREEN, _DBG_DATA_SCREEN):
        if scr is None:
            continue
        try:
            # без анимации: с анимацией часть строк после обновления могла остаться невидимой
            scr.listView.adapter.update(False)
        except Exception:
            pass


def _run_debug_action(idx: int):
    """Запускает оригинальный обработчик пункта диалога Telegram."""
    if _DBG is None:
        return
    try:
        _DBG["listener"].onClick(None, idx)
    except Exception:
        pass


