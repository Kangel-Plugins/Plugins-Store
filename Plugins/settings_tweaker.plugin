        try:
            self.plugin._open_screen(pending)
        except Exception:
            pass


# ======================= Плагин =======================

def _remove_profile_row(frag, name):
    """Убирает строку с номером name из списка профиля: номера следующих строк сдвигаются, rowCount уменьшается."""
    rows = []
    c = frag.getClass()
    while c is not None:
        for f in c.getDeclaredFields():
            if f.getType().getName() == "int" and f.getName().endswith("Row"):
                f.setAccessible(True)
                rows.append(f)
        c = c.getSuperclass()
    target = None
    for f in rows:
        if f.getName() == name:
            target = f
    if target is None:
        return
    pos = target.getInt(frag)
    if pos < 0:
        return  # строки нет в текущем списке
    for f in rows:
        v = f.getInt(frag)
        if v > pos:
            f.setInt(frag, _jint(v - 1))
    target.setInt(frag, _jint(-1))
    count = None
    c = frag.getClass()
    while c is not None and count is None:
        try:
            rc = c.getDeclaredField("rowCount")
            rc.setAccessible(True)
            count = rc
        except Exception:
            c = c.getSuperclass()
    if count is not None:
        count.setInt(frag, _jint(count.getInt(frag) - 1))


WARNING_RED = 0xFFE25D5D - (1 << 32)  # красный цвет ARGB, приведён к знаковому int для Java

_WARN_PLUGIN = None
_WARN_SCREEN = None
_WarnScreenClass = None

WARN_ROW_PLUGIN = 960101
WARN_ROW_MENU = 960102
WARN_ROW_PLUGSTONAV = 960103
WARN_ACT_APPLY = 960200
WARN_ACT_ENABLE_PLUGINS_ROW = 960201
WARN_ACT_OPEN_NAV = 960202
WARN_ACT_PLUGSTONAV = 960203
WARN_ACT_IGNORE = 960204


class _PyRunnable(dynamic_proxy(jclass("java.lang.Runnable"))):
    def __init__(self, fn):
        super().__init__()
        self._fn = fn

    def run(self):
        try:
            self._fn()
        except Exception:
            pass


def _run_on_ui(fn):
    """Выполняет действие строго в главном потоке Android (Switch.on_change вызывается с pluginsQueue)."""
    try:
        from android.os import Looper
        if Looper.myLooper() == Looper.getMainLooper():
            fn()
            return
    except Exception:
        pass
    try:
        AndroidUtilities.runOnUIThread(_PyRunnable(fn))
    except Exception:
        pass


def _plugins_menu_item_id() -> int:
    for enum_name in (
        "com.exteragram.messenger.utils.chats.MainMenuItem",
        "com.exteragram.messenger.preferences.components.MainMenuItem",
        "app.exteraless.drawer.MainMenuItem",
    ):
        cls = _try_jclass(enum_name)
        if cls is None:
            continue
        try:
            item = cls.valueOf("PLUGINS")
            if item is not None:
                return int(item.getId())
        except Exception:
            try:
                item = getattr(cls, "PLUGINS", None)
                if item is not None:
                    for attr in ("getId", "id"):
                        v = getattr(item, attr, None)
                        if v is not None:
                            return int(v() if callable(v) else v)
            except Exception:
                pass
    return 102


def _java_int_list(obj) -> list:
    out = []
    if obj is None:
        return out
    try:
        for i in range(int(obj.size())):
            v = obj.get(i)
            if v is not None:
                out.append(int(str(v)))
    except Exception:
        try:
            for v in obj:
                if v is not None:
                    out.append(int(str(v)))
        except Exception:
            pass
    return out


def _is_plugins_in_menu() -> bool:
    """Проверяет, включён ли пункт «Плагины» в «Элементах меню» (appNavigationSettings)."""
    pid = _plugins_menu_item_id()
    ec = _try_jclass("com.exteragram.messenger.ExteraConfig")
    if ec is not None:
        layout = []
        hidden = []
        for getter in ("getMainMenuLayout", "mainMenuLayout"):
            try:
                val = getattr(ec, getter, None)
                if val is not None:
                    layout = _java_int_list(val() if callable(val) else val)
                    if layout:
                        break
            except Exception:
                pass
        for getter in ("getMainMenuHiddenItems", "mainMenuHiddenItems"):
            try:
                val = getattr(ec, getter, None)
                if val is not None:
                    hidden = _java_int_list(val() if callable(val) else val)
                    if hidden:
                        break
            except Exception:
                pass
        if not layout:
            try:
                dval = getattr(ec, "getDefaultMainMenuLayout", None)
                if callable(dval):
                    layout = _java_int_list(dval())
            except Exception:
                pass
        if layout:
            return pid in layout and pid not in hidden

    try:
        import json
        from org.telegram.messenger import ApplicationLoader
        sp = ApplicationLoader.applicationContext.getSharedPreferences("exteraconfig", 0)
        if sp is not None:
            raw = sp.getString("mainMenuLayout", "")
            raw_hid = sp.getString("mainMenuHiddenItems", "")
            vis = []
            hid = []
            if raw:
                try:
                    vis = [int(x) for x in json.loads(raw)]
                except Exception:
                    vis = [int(x.strip()) for x in raw.split(",") if x.strip().lstrip("-").isdigit()]
            if raw_hid:
                try:
                    hid = [int(x) for x in json.loads(raw_hid)]
                except Exception:
                    hid = [int(x.strip()) for x in raw_hid.split(",") if x.strip().lstrip("-").isdigit()]
            if vis:
                return pid in vis and pid not in hid
    except Exception:
        pass
    return False


def _plugstonav_status():
    """Возвращает ('enabled' | 'disabled' | 'missing', plugin_obj)."""
    try:
        ctrl_cls = _try_jclass("com.exteragram.messenger.plugins.PluginsController")
        ctrl = ctrl_cls.getInstance() if ctrl_cls is not None else None
        if ctrl is not None:
            plugins_map = ctrl.getPlugins()
            if plugins_map is not None:
                p = None
                try:
                    p = plugins_map.get("plugstonav")
                except Exception:
                    p = None
                if p is None:
                    try:
                        it = plugins_map.values().iterator()
                        while it.hasNext():
                            cand = it.next()
                            if cand is not None and str(cand.getId()) == "plugstonav":
                                p = cand
                                break
                    except Exception:
                        pass
                if p is not None:
                    enabled = False
                    try:
                        enabled = bool(p.isEnabled())
                    except Exception:
                        pass
                    return ("enabled" if enabled else "disabled"), p
    except Exception:
        pass
    try:
        from org.telegram.messenger import ApplicationLoader
        ctx = ApplicationLoader.applicationContext
        for pref_name in ("plugins", "plugins_preferences", "extera_plugins"):
            sp = ctx.getSharedPreferences(pref_name, 0)
            if sp is not None and sp.contains("plugin_enabled_plugstonav"):
                return ("enabled" if sp.getBoolean("plugin_enabled_plugstonav", False) else "disabled"), None
    except Exception:
        pass
    return "missing", None


def _open_url_in_telegram(host, url, fail_msg=None):
    act = host.getParentActivity() if host is not None else None
    if act is not None:
        try:
            from org.telegram.messenger.browser import Browser
            Browser.openUrl(act, url)
            return True
        except Exception:
            pass
        try:
            from android.content import Intent
            from android.net import Uri
            act.startActivity(Intent(Intent.ACTION_VIEW, Uri.parse(url)))
            return True
        except Exception:
            pass
    BulletinHelper.show_info(fail_msg or _t("toast_open_url_fail"))
    return False


def _open_app_navigation_settings(host):
    """Открывает «Элементы меню» (https://t.me/exteraSettings?s=appNavigationSettings)."""
    exteraless_nav = _try_jclass("app.exteraless.settings.OpenExteraAppNavigationActivity")
    if exteraless_nav is not None and host is not None:
        try:
            host.presentFragment(exteraless_nav())
            return
        except Exception:
            pass
    url = "https://t.me/exteraSettings?s=appNavigationSettings"
    if _open_url_in_telegram(host, url):
        return
    for cname in (
        "com.exteragram.messenger.preferences.AppNavigationPreferencesActivity",
        "com.exteragram.messenger.preferences.DrawerPreferencesActivity",
    ):
        cls = _try_jclass(cname)
        if cls is not None and host is not None:
            try:
                host.presentFragment(cls())
                return
            except Exception:
                continue
    BulletinHelper.show_info(_t("toast_open_nav_fail"))


def _open_plugstonav_download(host):
    """Открывает пост с плагином Plugins Tab (https://t.me/exteraPluginsSup/1118)."""
    _open_url_in_telegram(host, PLUGSTONAV_POST_URL, fail_msg=_t("toast_open_plugtab_fail"))


def _warn_u_button(item_id, text, icon_name=None, accent=False, red=False, value=None):
    from org.telegram.ui.Components import UItem
    item = None
    if value is not None:
        item = UItem.asButton(item_id, text, value)
    elif icon_name:
        try:
            from org.telegram.messenger import R
            res_id = int(getattr(R.drawable, icon_name, 0) or 0)
            if res_id:
                item = UItem.asButton(item_id, res_id, text)
        except Exception:
            pass
    if item is None:
        item = UItem.asButton(item_id, text)
    if accent:
        item = item.accent()
    if red:
        item = item.red()
    return item


_WARN_SUB_FACTORY_JAVA = None


def _get_warn_sub_factory():
    """Фабрика строки TextCell с подзаголовком внутри блока и статусом справа."""
    global _WARN_SUB_FACTORY_JAVA
    if _WARN_SUB_FACTORY_JAVA is not None:
        return _WARN_SUB_FACTORY_JAVA
    from extera_utils.classes import Base, java_subclass, joverload, joverride
    from org.telegram.ui.Cells import TextCell
    UItemFactory = jclass("org.telegram.ui.Components.UItem$UItemFactory")

    @java_subclass(UItemFactory)
    class _WarnSubFactory(Base):
        @joverride()
        def createView(self, context, list_view, current_account, class_guid, resources_provider):
            cell = TextCell(context)
            try:
                cell.heightDp = 62
            except Exception:
                pass
            return cell

        @joverride()
        def bindView(self, view, item, divider, adapter, list_view):
            title = _jfield(item, "text") or ""
            val = _jfield(item, "textValue") or ""
            sub = _jfield(item, "subtext") or ""
            if val:
                view.setTextAndValue(title, val, bool(divider))
            else:
                view.setText(title, bool(divider))
            try:
                view.setSubtitle(sub if sub else None)
            except Exception:
                pass
            try:
                view.setColors(Theme.key_windowBackgroundWhiteGrayIcon, Theme.key_windowBackgroundWhiteBlackText)
            except Exception:
                pass

        @joverride()
        def isShadow(self):
            return False

        @joverride()
        def isClickable(self):
            return True

        @joverload("contentsEquals", ["org.telegram.ui.Components.UItem", "org.telegram.ui.Components.UItem"])
        def contents_equals(self, a, b):
            try:
                return (
                    int(_jfield(a, "id")) == int(_jfield(b, "id"))
                    and str(_jfield(a, "text") or "") == str(_jfield(b, "text") or "")
                    and str(_jfield(a, "textValue") or "") == str(_jfield(b, "textValue") or "")
                    and str(_jfield(a, "subtext") or "") == str(_jfield(b, "subtext") or "")
                )
            except Exception:
                return False

    peer = _WarnSubFactory.new_instance()
    java_factory = getattr(peer, "java", peer)
    UItemFactory.setup(java_factory)
    _WARN_SUB_FACTORY_JAVA = java_factory
    return _WARN_SUB_FACTORY_JAVA


def _warn_sub_row_item(item_id, text, subtext, value):
    from org.telegram.ui.Components import UItem
    try:
        from org.telegram.ui.Cells import TextCell
        if hasattr(TextCell, "setSubtitle"):
            factory = _get_warn_sub_factory()
            item = UItem.ofFactory(factory.getClass())
            item.id = item_id
            item.text = text
            item.subtext = subtext
            item.textValue = value
            return item
    except Exception:
        pass
    return _warn_u_button(item_id, text, value=value)


def _refresh_warn_screen():
    if _WARN_SCREEN is None:
        return
    try:
        ab = _WARN_SCREEN.getActionBar()
        if ab is not None:
            ab.setTitle(_t("warn_title"))
    except Exception:
        pass
    try:
        _WARN_SCREEN.listView.adapter.update(False)
    except Exception:
        pass


def _fill_warn_items(items):
    from org.telegram.ui.Components import UItem
    plugin = _WARN_PLUGIN
    in_plugin = bool(plugin is not None and plugin._flag(PLUGINS_SWITCH, False))
    in_menu = _is_plugins_in_menu()
    plug_state, _ = _plugstonav_status()
    safe_now = in_plugin or in_menu or (plug_state == "enabled")

    warn_msg = _t("fork_warning", plugin)
    ctx = _WARN_SCREEN.getParentActivity() if _WARN_SCREEN is not None else None
    if ctx is not None and not safe_now:
        tv = TextView(ctx)
        tv.setText(warn_msg)
        tv.setTextSize(14)
        tv.setTextColor(WARNING_RED)
        tv.setPadding(AndroidUtilities.dp(21), AndroidUtilities.dp(14), AndroidUtilities.dp(21), AndroidUtilities.dp(10))
        items.add(UItem.asCustomShadow(960001, tv))
    elif safe_now:
        items.add(UItem.asShadow(960001, _t("warn_safe", plugin)))
    else:
        items.add(UItem.asShadow(960001, warn_msg))

    items.add(UItem.asHeader(960010, _t("warn_check_header", plugin)))
    items.add(_warn_u_button(
        WARN_ROW_PLUGIN,
        _t("warn_in_settings", plugin),
        value=_t("warn_enabled", plugin) if in_plugin else _t("warn_disabled", plugin),
    ))
    items.add(_warn_u_button(
        WARN_ROW_MENU,
        _t("warn_in_menu", plugin),
        value=_t("warn_enabled", plugin) if in_menu else _t("warn_disabled", plugin),
    ))
    plug_val = (
        _t("warn_enabled", plugin)
        if plug_state == "enabled"
        else (_t("warn_disabled", plugin) if plug_state == "disabled" else _t("warn_not_installed", plugin))
    )
    items.add(_warn_sub_row_item(
        WARN_ROW_PLUGSTONAV,
        _t("warn_plugtab", plugin),
        _t("warn_plugtab_sub", plugin),
        plug_val,
    ))
    items.add(UItem.asShadow(960011, _t("warn_check_footer", plugin)))

    items.add(UItem.asHeader(960020, _t("warn_actions_header", plugin)))
    if safe_now:
        items.add(_warn_u_button(
            WARN_ACT_APPLY,
            _t("warn_act_apply", plugin),
            icon_name="msg_done",
            accent=True,
        ))
    else:
        items.add(_warn_u_button(
            WARN_ACT_ENABLE_PLUGINS_ROW,
            _t("warn_act_enable_settings", plugin),
            icon_name="msg_plugins",
            accent=True,
        ))

        items.add(_warn_u_button(
            WARN_ACT_OPEN_NAV,
            _t("warn_act_open_nav", plugin),
            icon_name="msg_list",
        ))

        if plug_state == "disabled":
            items.add(_warn_u_button(
                WARN_ACT_PLUGSTONAV,
                _t("warn_act_enable_plugtab", plugin),
                icon_name="msg_plugins",
            ))
        else:
            items.add(_warn_u_button(
                WARN_ACT_PLUGSTONAV,
                _t("warn_act_download_plugtab", plugin),
                icon_name="msg_download",
            ))
        items.add(UItem.asShadow(960024, None))

        items.add(_warn_u_button(
            WARN_ACT_IGNORE,
            _t("warn_act_ignore", plugin),
            icon_name="msg_delete",
            red=True,
        ))

    items.add(UItem.asShadow(960099, None))


def _reload_own_settings_ui(plugin, ps_frag=None):
    """Принудительно обновляет экран настроек самого плагина после возврата с экрана предупреждения."""
    if plugin is None:
        return
    try:
        plugin.set_setting(
            "hide_exteragram",
            bool(plugin._override.get("exteragram", plugin.get_setting("hide_exteragram", False))),
            reload_settings=True,
        )
    except Exception:
        pass
    target = ps_frag if ps_frag is not None else getattr(plugin, "_own_settings_frag", None)
    if target is None:
        return
    try:
        m = getattr(target, "updateItems", None)
        if callable(m):
            m()
    except Exception:
        pass
    try:
        lv = _jget(target, "listView")
        if lv is not None and lv.adapter is not None:
            lv.adapter.update(False)
            lv.adapter.notifyDataSetChanged()
    except Exception:
        pass


def _apply_hide_exteragram(plugin, frag, enable_plugins_row=False, toast_msg=None):
    if plugin is not None:
        if enable_plugins_row:
            plugin._override[PLUGINS_SWITCH] = True
            try:
                plugin.set_setting(PLUGINS_SWITCH, True, reload_settings=False)
            except Exception:
                pass
        plugin._override["exteragram"] = True
        try:
            plugin.set_setting("hide_exteragram", True, reload_settings=False)
        except Exception:
            pass
        plugin._need_settings_reload = True
        plugin._refresh()

    def _finish_and_toast():
        global _WARN_SCREEN
        if frag is not None:
            try:
                frag.finishFragment()
            except Exception:
                pass
        _WARN_SCREEN = None
        _reload_own_settings_ui(plugin)
        try:
            AndroidUtilities.runOnUIThread(_PyRunnable(lambda: _reload_own_settings_ui(plugin)), 80)
        except Exception:
            pass
        if toast_msg:
            BulletinHelper.show_success(toast_msg)

    _run_on_ui(_finish_and_toast)


def _try_enable_plugstonav_or_open(plugin, frag):
    plug_state, _ = _plugstonav_status()
    if plug_state == "enabled":
        _apply_hide_exteragram(plugin, frag, toast_msg=_t("toast_extera_hidden", plugin))
        return
    if plug_state == "disabled":
        try:
            ctrl_cls = _try_jclass("com.exteragram.messenger.plugins.PluginsController")
            ctrl = ctrl_cls.getInstance() if ctrl_cls is not None else None
            if ctrl is not None:
                ctrl.setPluginEnabled("plugstonav", True, None)

                def _after():
                    st, _ = _plugstonav_status()
                    if st == "enabled":
                        _apply_hide_exteragram(plugin, frag, toast_msg=_t("toast_plugtab_hidden", plugin))
                    else:
                        if plugin is not None and frag is not None:
                            BulletinHelper.show_info(_t("toast_enable_plugtab_list", plugin))
                            plugin._open_plugins(frag)

                AndroidUtilities.runOnUIThread(_PyRunnable(_after), 350)
                return
        except Exception:
            pass
        if plugin is not None and frag is not None:
            plugin._open_plugins(frag)
        return
    _open_plugstonav_download(frag)


def _on_warn_click(item, frag):
    global _WARN_SCREEN
    plugin = _WARN_PLUGIN
    item_id = int(_jfield(item, "id"))
    if item_id == WARN_ACT_APPLY:
        _apply_hide_exteragram(plugin, frag, toast_msg=_t("toast_extera_hidden", plugin))
    elif item_id in (WARN_ACT_ENABLE_PLUGINS_ROW, WARN_ROW_PLUGIN):
        _apply_hide_exteragram(
            plugin,
            frag,
            enable_plugins_row=True,
            toast_msg=_t("toast_plugins_added_hidden", plugin),
        )
    elif item_id in (WARN_ACT_OPEN_NAV, WARN_ROW_MENU):
        _open_app_navigation_settings(frag)
    elif item_id in (WARN_ACT_PLUGSTONAV, WARN_ROW_PLUGSTONAV):
        _try_enable_plugstonav_or_open(plugin, frag)
    elif item_id == WARN_ACT_IGNORE:
        _apply_hide_exteragram(plugin, frag, toast_msg=_t("toast_extera_hidden", plugin))


def _fork_hide_warning_screen(plugin):
    """Отдельный экран предупреждения при скрытии «Настройки exteraGram» без доступа к плагинам."""
    global _WarnScreenClass, _WARN_PLUGIN, _WARN_SCREEN
    _WARN_PLUGIN = plugin
    if _WarnScreenClass is None:
        from extera_utils.classes import Base, java_subclass, joverload
        from org.telegram.ui.Components import UniversalFragment

        @java_subclass(UniversalFragment)
        class _ForkHideWarningScreen(Base):
            @joverload("getTitle", [])
            def get_title(self):
                return _t("warn_title")

            @joverload("fillItems", ["java.util.ArrayList", "org.telegram.ui.Components.UniversalAdapter"])
            def fill_items(self, items, adapter):
                _fill_warn_items(items)

            @joverload("onClick", ["org.telegram.ui.Components.UItem", "android.view.View", "int", "float", "float"])
            def on_click(self, item, view, position, x, y):
                _on_warn_click(item, _WARN_SCREEN)

            @joverload("onLongClick", ["org.telegram.ui.Components.UItem", "android.view.View", "int", "float", "float"])
            def on_long_click(self, item, view, position, x, y):
                return False

        _WarnScreenClass = _ForkHideWarningScreen
    screen = _WarnScreenClass.new_instance()
    _WARN_SCREEN = getattr(screen, "java", screen)
    return _WARN_SCREEN



# ---- цветные значки строк на главном экране настроек ("Плагины", "Меню отладки") ----
# Рамка 28dp с вертикальным градиентом и белым глифом запечены в сам WebP (как рисует нативная SettingCell).
# Собирались из tweaker_colored_xxhdpi (см. telegram_icons/): плагины — #E91E63 -> #D81B60, отладка — #FBC02D -> #F57F17.
ICON_PLUGINS_B64 = ""
ICON_DEBUG_B64 = ""
_icon_cache = {}


def _icon_drawable(key):
    """Декодирует встроенную WebP-иконку (рамка + глиф) в Drawable; кэшируется."""
    d = _icon_cache.get(key)
    if d is None:
        raw = base64.b64decode(ICON_PLUGINS_B64 if key == "plugins" else ICON_DEBUG_B64)
        bmp = BitmapFactory.decodeByteArray(raw, 0, len(raw))
        d = BitmapDrawable(bmp)
        _icon_cache[key] = d
    return d


_ROW_FACTORY_JAVA = None


def _build_framed_row_view(ctx):
    layout = FrameLayout(ctx)
    layout.setMinimumHeight(AndroidUtilities.dp(50))
    layout.setLayoutParams(ViewGroup.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, AndroidUtilities.dp(50)))

    icon = ImageView(ctx)
    icon_params = FrameLayout.LayoutParams(
        AndroidUtilities.dp(28), AndroidUtilities.dp(28),
        Gravity.LEFT | Gravity.CENTER_VERTICAL,
    )
    icon_params.leftMargin = AndroidUtilities.dp(18)
    layout.addView(icon, icon_params)

    text = TextView(ctx)
    text.setTextSize(16)
    text.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText))
    text_params = FrameLayout.LayoutParams(
        FrameLayout.LayoutParams.MATCH_PARENT,
        FrameLayout.LayoutParams.WRAP_CONTENT,
        Gravity.LEFT | Gravity.CENTER_VERTICAL,
    )
    text_params.leftMargin = AndroidUtilities.dp(64)
    text_params.rightMargin = AndroidUtilities.dp(21)
    layout.addView(text, text_params)

    divider = View(ctx)
    try:
        divider.setBackgroundColor(Theme.dividerPaint.getColor())
    except Exception:
        pass
    div_params = FrameLayout.LayoutParams(FrameLayout.LayoutParams.MATCH_PARENT, 1, Gravity.BOTTOM)
    div_params.leftMargin = AndroidUtilities.dp(64)
    layout.addView(divider, div_params)
    return layout


def _get_row_factory():
    global _ROW_FACTORY_JAVA
    if _ROW_FACTORY_JAVA is not None:
        return _ROW_FACTORY_JAVA
    from extera_utils.classes import Base, java_subclass, joverload, joverride
    UItemFactory = jclass("org.telegram.ui.Components.UItem$UItemFactory")

    @java_subclass(UItemFactory)
    class _TweakerRowFactory(Base):
        @joverride()
        def createView(self, context, list_view, current_account, class_guid, resources_provider):
            return _build_framed_row_view(context)

        @joverride()
        def bindView(self, view, item, divider, adapter, list_view):
            item_id = int(_jfield(item, "id"))
            icon_key = "plugins" if item_id == PLUGINS_ROW_ID else "debug"
            view.getChildAt(0).setImageDrawable(_icon_drawable(icon_key))
            tv = view.getChildAt(1)
            tv.setText(_jfield(item, "text"))
            try:
                tv.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText))
            except Exception:
                pass
            div = view.getChildAt(2)
            try:
                div.setBackgroundColor(Theme.dividerPaint.getColor())
            except Exception:
                pass
            div.setVisibility(View.VISIBLE if divider else View.GONE)

        @joverride()
        def isShadow(self):
            return False

        @joverride()
        def isClickable(self):
            return True

        @joverload("contentsEquals", ["org.telegram.ui.Components.UItem", "org.telegram.ui.Components.UItem"])
        def contents_equals(self, a, b):
            try:
                return int(_jfield(a, "id")) == int(_jfield(b, "id")) and str(_jfield(a, "text") or "") == str(_jfield(b, "text") or "")
            except Exception:
                return False

    peer = _TweakerRowFactory.new_instance()
    java_factory = getattr(peer, "java", peer)
    UItemFactory.setup(java_factory)
    _ROW_FACTORY_JAVA = java_factory
    return _ROW_FACTORY_JAVA


class _TweakCellClick(dynamic_proxy(View.OnClickListener)):
    """Резервный обработчик нажатия строки, если UItemFactory недоступна."""

    def __init__(self, action):
        super().__init__()
        self.action = action

    def onClick(self, v):
        try:
            self.action()
        except Exception:
            pass


def _framed_settings_cell(frag, item_id, icon_key, title, action=None):
    """Строка главного экрана настроек с цветной рамкой-значком (эффект нажатия и скругления рисует сам список)."""
    from org.telegram.ui.Components import UItem
    try:
        factory = _get_row_factory()
        item = UItem.ofFactory(factory.getClass())
        item.id = item_id
        item.text = title
        return item
    except Exception:
        pass
    ctx = frag.getParentActivity() if frag is not None else None
    if ctx is None:
        try:
            from org.telegram.messenger import ApplicationLoader
            ctx = ApplicationLoader.applicationContext
        except Exception:
            ctx = None
    if ctx is None:
        raise RuntimeError("нет контекста для ячейки")
    layout = _build_framed_row_view(ctx)
    layout.getChildAt(0).setImageDrawable(_icon_drawable(icon_key))
    layout.getChildAt(1).setText(title)
    try:
        layout.setBackground(Theme.getSelectorDrawable(False))
    except Exception:
        pass
    if action is not None:
        layout.setOnClickListener(_TweakCellClick(action))
    layout.setOnTouchListener(_PressRipple(layout))
    return UItem.asCustom(item_id, layout)



class SettingsTweakerPlugin(BasePlugin):
    def on_plugin_load(self):
        global _FORK_SWITCH_PLUGIN
        _FORK_SWITCH_PLUGIN = self
        _is_ayugram_client(self)
        _lang(self)
        try:
            self.description = _t("plugin_desc", self)
        except Exception:
            pass
        self._override = {}
        self._sa_frags = []  # экраны настроек, которые плагин видел: (идентификатор, экран)
        self._handled_id = None
        self._armed = False
        self._pending = None
        self._frag = None
        self._profile_frags = []  # открытые экраны профиля, чтобы применить кнопку сразу
        self._btn_removed = {}  # убранная из ряда кнопка «Настройки»: id ряда → (действие, позиция)
        self._own_settings_frag = None
        self._need_settings_reload = False

        def install(cls_name, method, hook):
            try:
                self.hook_all_methods(find_class(cls_name), method, hook)
            except Exception:
                pass  # хук не встал: остальные хуки работают, плагин не падает

        install("org.telegram.ui.SettingsActivity", "fillItems", _SettingsFillHook(self))
        install("org.telegram.ui.SettingsActivity", "onClick", _SettingsClickHook(self))
        install("org.telegram.ui.ActionBar.BaseFragment", "onFragmentCreate", _FragCreateHook())
        install("org.telegram.ui.ActionBar.BaseFragment", "onResume", _ResumeHook(self))
        install("org.telegram.ui.ActionBar.ActionBar", "setTitle", _TitleHook())
        cell_tr = _CellTranslateHook()
        install("org.telegram.ui.Cells.HeaderCell", "setText", cell_tr)
        install("org.telegram.ui.Cells.TextCheckCell", "setTextAndCheck", cell_tr)
        install("org.telegram.ui.Cells.TextCheckCell", "setTextAndValueAndCheck", cell_tr)
        install("org.telegram.ui.Cells.TextSettingsCell", "setText", cell_tr)
        install("org.telegram.ui.Cells.TextSettingsCell", "setTextAndValue", cell_tr)
        install("org.telegram.ui.Cells.TextCell", "setText", cell_tr)
        install("org.telegram.ui.Cells.TextCell", "setTextAndValue", cell_tr)
        install("org.telegram.ui.Components.UniversalAdapter", "updateInternal", _ListHook(self))
        install("org.telegram.ui.Components.UniversalAdapter", "update", _ListHook(self))
        install("org.telegram.ui.Components.UniversalAdapter", "updateWithoutNotify", _ListHook(self))
        install("org.telegram.ui.SettingsActivity", "openDebugMenu", _DebugMenuHook(self))
        install("org.telegram.ui.ActionBar.AlertDialog$Builder", "setItems", _SetItemsHook(self))
        install("org.telegram.ui.ActionBar.AlertDialog$Builder", "show", _ShowHook(self))
        # openDebugMenu заканчивается не на builder.show(), а на showDialog(builder.create())
        install("org.telegram.ui.ActionBar.BaseFragment", "showDialog", _ShowHook(self))
        install(PROFILE_CLASS, "updateRowsIds", _ProfileRowsHook(self))
        install(PROFILE_CLASS, "createView", _ProfileRowsHook(self))
        install(PROFILE_CLASS, "onResume", _ProfileRowsHook(self))
        self._refresh()

    # --- меню отладки --------------------------------------------------------

    def _debug_on(self) -> bool:
        return self._flag(DEBUG_SWITCH, False)

    def _add_debug_row(self, frag, items):
        """Строка «Меню отладки» перед футером с версией, в собственном блоке."""
        if not self._debug_on():
            return
        n = items.size()
        if n == 0 or int(_jfield(items.get(0), "viewType")) == SPACE_TYPE:
            return  # режим поиска
        row = _framed_settings_cell(frag, DEBUG_ROW_ID, "debug", _t("debug_title", self), lambda: self._open_debug_from_row(frag))
        from org.telegram.ui.Components import UItem
        last_vt = int(_jfield(items.get(n - 1), "viewType"))
        pos = n - 1 if last_vt in (CUSTOM_SHADOW_TYPE, SPACE_TYPE) else n
        items.add(_jint(pos), UItem.asShadow(None))
        items.add(_jint(pos + 1), row)

    def _add_plugins_row(self, frag, items):
        """Строка «Плагины» в главных настройках, сразу после пунктов форков, если включён переключатель."""
        if not self._flag(PLUGINS_SWITCH, False):
            return
        n = items.size()
        if n == 0 or int(_jfield(items.get(0), "viewType")) == SPACE_TYPE:
            return  # режим поиска
        from org.telegram.ui.Components import UItem
        row = _framed_settings_cell(frag, PLUGINS_ROW_ID, "plugins", _t("plugins_title", self), lambda: self._open_plugins(frag))
        last_fork = -1
        for i in range(n):
            if _key_for_item(items.get(i), allow_id=True) in FORK_KEYS:
                last_fork = i
        if last_fork >= 0:
            items.add(_jint(last_fork + 1), row)
        else:
            pos = 0
            for i in range(n):
                vt = int(_jfield(items.get(i), "viewType"))
                t = _jfield(items.get(i), "text")
                if t is not None and vt not in HEADER_TYPES and vt not in BREAK_TYPES and vt != SPACE_TYPE:
                    pos = i
                    break
            items.add(_jint(pos), row)

    def _open_plugins(self, frag):
        """Открывает список плагинов exteraGram. Имя класса заранее неизвестно, пробуем несколько вариантов."""
        for screen_name in PLUGINS_SCREENS:
            try:
                frag.presentFragment(jclass(screen_name)())
                return
            except Exception:
                continue
        BulletinHelper.show_info(_t("plugins_open_fail", self))

    def _open_debug_from_row(self, frag):
        self._pending = None
        self._frag = frag
        self._armed = True
        frag.openDebugMenu()  # перехват сработает, диалог не покажется

    def _graphic_on(self) -> bool:
        return self._flag(DEBUG_GRAPHIC_KEY, False)

    def _on_open_debug(self, frag):
        self._pending = None
        self._frag = frag
        self._armed = self._debug_on() and self._graphic_on()

    def _capture_items(self, args):
        if not self._armed or len(args) != 2 or args[0] is None:
            return
        items = args[0]
        entries = []
        for i in range(len(items)):
            text = items[i]
            if text is not None:
                entries.append((i, str(text)))
        self._pending = {"entries": entries, "listener": args[1], "frag": self._frag}
        self._armed = False

    def _open_screen(self, pending):
        global _DBG, _DBG_SCREEN
        _DBG = pending
        frag = pending.get("frag")
        if frag is None:
            return
        screen = _debug_screen()
        java_screen = getattr(screen, "java", screen)
        _DBG_SCREEN = java_screen
        frag.presentFragment(java_screen)

    # --- скрытие пунктов -----------------------------------------------------

    def _hidden(self, key: str) -> bool:
        if key == "ayugram" and not _is_ayugram_client(self):
            return False
        if key in self._override:
            return _as_bool(self._override[key])
        return _as_bool(self.get_setting("hide_" + key, False))

    def _flag(self, name: str, default: bool) -> bool:
        """Значение переключателя: сначала временное (сразу после нажатия), потом сохранённое."""
        if name in self._override:
            return _as_bool(self._override[name])
        return _as_bool(self.get_setting(name, default))

    def _hide_set(self, items, allow_id: bool = False) -> set:
        """Индексы пунктов, которые надо скрыть. Заголовок прячется, если все пункты его блока скрыты."""
        try:
            return self._hide_set_inner(items, allow_id=allow_id)
        except Exception:
            return set()

    def _hide_set_inner(self, items, allow_id: bool = False) -> set:
        remove = set()
        for header_idx, _, cells in _scan(items):
            hidden = []
            for idx, _, _, item in cells:
                key = _key_for_item(item, allow_id=allow_id)
                if key is not None and self._hidden(key):
                    hidden.append(idx)
            remove.update(hidden)
            if header_idx is not None and cells and len(hidden) == len(cells):
                remove.add(header_idx)
        # Дополнительная проверка строк форков на случай нестандартного viewType/разделения.
        for i in range(items.size()):
            if i in remove:
                continue
            item = items.get(i)
            if int(_jfield(item, "viewType")) in HEADER_TYPES | BREAK_TYPES:
                continue
            key = _key_for_item(item, allow_id=allow_id)
            if key in FORK_KEYS and self._hidden(key):
                remove.add(i)
        return remove

    def _remove_with_shadows(self, items, remove):
        n = items.size()
        vts = [int(_jfield(items.get(i), "viewType")) for i in range(n)]
        # Убираем тени, которые теперь стоят подряд или в начале списка.
        kept = [i for i in range(n) if i not in remove]
        prev_is_break = True
        for i in kept:
            if vts[i] == SHADOW_TYPE and prev_is_break:
                remove.add(i)
                continue
            prev_is_break = vts[i] in BREAK_TYPES
        # Тень в конце списка, оставшаяся после скрытия футера, тоже не нужна.
        for i in reversed([k for k in kept if k not in remove]):
            if vts[i] == SHADOW_TYPE:
                remove.add(i)
            else:
                break
        for i in sorted(remove, reverse=True):
            items.remove(_jint(i))

    def _apply(self, frag, items) -> bool:
        if items.size() == 0 or int(_jfield(items.get(0), "viewType")) == SPACE_TYPE:
            return True  # режим поиска
        if self._is_own_list(items):
            return True  # экран самого плагина
        self._remember_frag(frag)
        _capture_fork_icons(items)
        remove = self._hide_set(items, allow_id=True)
        if remove:
            self._remove_with_shadows(items, remove)
        self._apply_version(items)
        return True

    def _is_own_list(self, items) -> bool:
        for i in range(items.size()):
            item = items.get(i)
            try:
                if _jfield(item, "settingItem") is not None:
                    return True
            except Exception:
                pass
            t = _jfield(item, "text")
            if t is not None and str(t).strip() in OWN_TEXTS:
                return True
        return False

    def _apply_version(self, items):
        """Версия скрыта: строку заменяем пустым отступом, чтобы внизу оставалось место под плавающую панель."""
        n = items.size()
        if n < 2 or not self._hidden(VERSION_KEY):
            return
        if int(_jfield(items.get(n - 1), "viewType")) != CUSTOM_SHADOW_TYPE:
            return
        from org.telegram.ui.Components import UItem
        from org.telegram.messenger import AndroidUtilities
        items.set(_jint(n - 1), UItem.asSpace(AndroidUtilities.dp(100)))

    def _on_list(self, adapter):
        items = _jget(adapter, "items")
        try:
            if _translate_client_debug_list(items):
                adapter.notifyDataSetChanged()
                return
        except Exception:
            pass
        if System.identityHashCode(items) == self._handled_id:
            return  # уже обработано fillItems
        n = items.size()
        if n == 0 or n > LIST_MAX_ITEMS:
            return  # пустые и длинные списки (чаты, контакты) — не настройки
        if self._is_own_list(items):
            return
        matches = 0
        for i in range(n):
            item = items.get(i)
            if int(_jfield(item, "viewType")) in HEADER_TYPES | BREAK_TYPES:
                continue
            if _key_for_item(item, allow_id=False) is not None:
                matches += 1
        if matches < SETTINGS_MIN_MATCH:
            return
        _capture_fork_icons(items)
        remove = self._hide_set(items, allow_id=False)
        if not remove:
            return
        self._remove_with_shadows(items, remove)
        adapter.notifyDataSetChanged()

    def _hide_profile_rows(self, frag):
        for key, field in PROFILE_FORK_ROWS.items():
            if self._hidden(key):
                _remove_profile_row(frag, field)
        # Поддержка старых сборок, где главные настройки находились в ProfileActivity.
        is_legacy_settings = False
        for fname in ("accountRow", "chatRow"):
            try:
                if _jget(frag, fname) >= 0:
                    is_legacy_settings = True
                    break
            except Exception:
                pass
        if is_legacy_settings:
            for key, fields in PROFILE_SETTINGS_ROWS.items():
                if self._hidden(key):
                    for fname in fields:
                        _remove_profile_row(frag, fname)

    def _on_profile(self, frag):
        self._remember_profile(frag)
        self._hide_profile_rows(frag)
        try:
            self._apply_profile_button(frag)
        except Exception:
            pass

    def _remember_profile(self, frag):
        h = System.identityHashCode(frag)
        if any(k == h for k, _ in self._profile_frags):
            return
        self._profile_frags.append((h, frag))
        if len(self._profile_frags) > 4:
            self._profile_frags.pop(0)

    def _apply_profile_button(self, frag):
        """Кнопка «Настройки» в ряду «Выбрать фото / Изменить / Настройки» (ProfileActionsView)."""
        hide = self._hidden(PROFILE_BTN_KEY)
        av = _jget(frag, "actionsView")
        if av is None:
            return
        vid = System.identityHashCode(av)
        actions = _jget(av, "actions")
        key = SETTINGS_ACTION_KEY
        if hide:
            for i in range(actions.size()):
                a = actions.get(i)
                if int(_jget(a, "key")) == key:
                    actions.remove(a)
                    self._btn_removed[vid] = (a, i)
                    break
        else:
            saved = self._btn_removed.pop(vid, None)
            if saved is not None:
                a, pos = saved
                present = any(int(_jget(actions.get(i), "key")) == key for i in range(actions.size()))
                if not present:
                    actions.add(min(pos, actions.size()), a)
        m = av.getClass().getDeclaredMethod("applyVisibleActions")
        m.setAccessible(True)
        m.invoke(av)
        av.invalidate()
        av.requestLayout()

    def _remember_frag(self, frag):
        h = System.identityHashCode(frag)
        if any(k == h for k, _ in self._sa_frags):
            return
        self._sa_frags.append((h, frag))
        if len(self._sa_frags) > 4:
            self._sa_frags.pop(0)

    def _update_frag(self, frag):
        try:
            lv = _jget(frag, "listView")
            if lv is None or lv.adapter is None:
                return
            if lv.isComputingLayout():
                lv.post(_PyRunnable(lambda: self._update_frag(frag)))
                return
            lv.adapter.update(False)
        except Exception:
            pass

    def _scan_fragment_tree(self, frag):
        if frag is None:
            return
        try:
            if self._is_settings(frag):
                self._remember_frag(frag)
            elif str(frag.getClass().getName()) == PROFILE_CLASS:
                self._remember_profile(frag)
        except Exception:
            pass
        try:
            arr = _jget(frag, "fragmentsArr")
            if arr is not None:
                n = int(arr.size())
                for i in range(n):
                    st = arr.valueAt(i)
                    if st is not None:
                        child = _jget(st, "fragment")
                        if child is not None:
                            self._scan_fragment_tree(child)
        except Exception:
            pass

    def _discover_live_fragments(self):
        try:
            la_cls = _try_jclass("org.telegram.ui.LaunchActivity")
            if la_cls is None:
                return
            inst = la_cls.instance
            if inst is None:
                return
            for mname in ("getActionBarLayout", "getRightActionBarLayout"):
                try:
                    layout = getattr(inst, mname)()
                    if layout is None:
                        continue
                    stack = layout.getFragmentStack()
                    if stack is None:
                        continue
                    for i in range(int(stack.size())):
                        self._scan_fragment_tree(stack.get(i))
                except Exception:
                    continue
        except Exception:
            pass

    def _refresh_profile_frag(self, frag):
        try:
            if frag.getFragmentView() is not None:
                m = frag.getClass().getDeclaredMethod("updateRowsIds")
                m.setAccessible(True)
                m.invoke(frag)
                la = _jget(frag, "listAdapter")
                if la is not None:
                    la.notifyDataSetChanged()
        except Exception:
            pass
        try:
            self._apply_profile_button(frag)
        except Exception:
            pass

    def _is_settings(self, frag) -> bool:
        """Экран настроек или его наследник: проверяем имена классов по цепочке предков."""
        c = frag.getClass()
        while c is not None:
            if c.getName() == "org.telegram.ui.SettingsActivity":
                return True
            c = c.getSuperclass()
        return False

    def _on_resume(self, frag):
        global _IN_CLIENT_DEBUG_SCREEN
        if _WARN_SCREEN is not None and frag is not None:
            try:
                if System.identityHashCode(frag) == System.identityHashCode(_WARN_SCREEN):
                    _refresh_warn_screen()
            except Exception:
                pass
        if frag is not None and getattr(self, "_need_settings_reload", False):
            try:
                cname = str(frag.getClass().getName())
                is_own = (
                    (self._own_settings_frag is not None and System.identityHashCode(frag) == System.identityHashCode(self._own_settings_frag))
                    or cname.endswith("PluginSettingsActivity")
                )
                if is_own:
                    self._need_settings_reload = False
                    self._own_settings_frag = frag
                    _reload_own_settings_ui(self, frag)
            except Exception:
                pass
        for scr, tkey in (
            (_DBG_SCREEN, "debug_title"),
            (_DBG_DEV_SCREEN, "dev_title"),
            (_DBG_DATA_SCREEN, "data_title"),
        ):
            if scr is not None and frag is not None:
                try:
                    if System.identityHashCode(frag) == System.identityHashCode(scr):
                        ab = frag.getActionBar()
                        if ab is not None:
                            ab.setTitle(_t(tkey, self))
                        lv = _jget(frag, "listView")
                        if lv is not None and lv.adapter is not None:
                            lv.adapter.update(False)
                except Exception:
                    pass
        try:
            kind = _client_debug_kind(frag)
            _IN_CLIENT_DEBUG_SCREEN = kind
            if kind is not None and not _is_en(self):
                ab = frag.getActionBar()
                if ab is not None:
                    ab.setTitle("Отладка exteraGram" if kind == "extera" else "Отладка AyuGram 🤔")
        except Exception:
            pass
        if self._is_settings(frag):
            self._remember_frag(frag)
            self._update_frag(frag)
            return
        try:
            arr = _jget(frag, "fragmentsArr")
            if arr is not None:
                for i in range(int(arr.size())):
                    st = arr.valueAt(i)
                    child = _jget(st, "fragment") if st is not None else None
                    if child is not None and self._is_settings(child):
                        self._remember_frag(child)
                        self._update_frag(child)
        except Exception:
            pass

    def _refresh(self):
        def _do():
            self._discover_live_fragments()
            for _, frag in list(self._sa_frags):
                self._update_frag(frag)
            for _, frag in list(self._profile_frags):
                self._refresh_profile_frag(frag)
        _run_on_ui(_do)

    def _has_plugins_access(self) -> bool:
        """Есть ли доступ к плагинам хотя бы одним способом (в плагине, меню навигации или plugstonav)."""
        if self._flag(PLUGINS_SWITCH, False):
            return True
        if _is_plugins_in_menu():
            return True
        plug_state, _ = _plugstonav_status()
        return plug_state == "enabled"

    def _open_fork_hide_warning(self):
        def _do():
            host = None
            try:
                from client_utils import get_last_fragment
                host = get_last_fragment()
            except Exception:
                pass
            if host is None:
                try:
                    la_cls = _try_jclass("org.telegram.ui.LaunchActivity")
                    if la_cls is not None:
                        host = la_cls.getSafeLastFragment()
                except Exception:
                    pass
            if host is None:
                BulletinHelper.show_info(_t("fork_warning", self))
                return
            self._own_settings_frag = host
            try:
                host.presentFragment(_fork_hide_warning_screen(self))
            except Exception:
                BulletinHelper.show_info(_t("fork_warning", self))
        _run_on_ui(_do)

    def _on_toggle(self, key: str, value):
        val = _as_bool(value)
        if key == "exteragram" and val and not self._has_plugins_access():
            self._override["exteragram"] = False
            try:
                self.set_setting("hide_exteragram", False, reload_settings=True)
            except Exception:
                pass
            self._refresh()
            self._open_fork_hide_warning()
            return
        self._override[key] = val
        self._refresh()

    # --- экран настроек плагина ----------------------------------------------

    def _hide_switch(self, key):
        if key in FORK_KEYS:
            return Custom(factory=_get_fork_switch_factory(key).instance.java)
        _, _, icon = HIDABLE[key]
        return Switch(
            key="hide_" + key,
            text=_t_hidable(key, self),
            default=False,
            icon=icon,
            on_change=lambda v, k=key: self._on_toggle(k, v),
        )

    def create_settings(self) -> list:
        global _FORK_SWITCH_PLUGIN
        _FORK_SWITCH_PLUGIN = self
        _is_ayugram_client(self)
        _lang(self)
        if self._override:
            self._override.clear()
            self._refresh()
        rows = [
            Custom(factory=_get_lang_switch_factory().instance.java),
            Switch(
                key=DEBUG_SWITCH,
                text=_t("debug_switch", self),
                default=False,
                subtext=_t("debug_switch_sub", self),
                on_change=lambda v: self._on_toggle(DEBUG_SWITCH, v),
            ),
            Switch(
                key=DEBUG_GRAPHIC_KEY,
                text=_t("debug_graphic", self),
                default=False,
                subtext=_t("debug_graphic_sub", self),
            ),
            Divider(),
            Switch(
                key=PLUGINS_SWITCH,
                text=_t("plugins_switch", self),
                default=False,
                icon="msg_plugins",
                subtext=_t("plugins_switch_sub", self),
                on_change=lambda v: self._on_toggle(PLUGINS_SWITCH, v),
            ),
            Divider(),
            Switch(
                key="hide_" + PROFILE_BTN_KEY,
                text=_t("profile_btn", self),
                default=False,
                icon="msg_settings",
                subtext=_t("profile_btn_sub", self),
                on_change=lambda v: self._on_toggle(PROFILE_BTN_KEY, v),
            ),
            Divider(),
            Header(text=_t("hide_header", self)),
        ]
        for key in FORK_KEYS:
            if key == "ayugram" and not _is_ayugram_client(self):
                continue
            rows.append(self._hide_switch(key))
        for i, group in enumerate(GROUPS):
            rows.append(Divider())
            for key in group:
                rows.append(self._hide_switch(key))
        rows.append(Divider())
        rows.append(Switch(
            key="hide_" + VERSION_KEY,
            text=_t("version_title", self),
            default=False,
            icon="settings_faq",
            on_change=lambda v: self._on_toggle(VERSION_KEY, v),
        ))
        return rows
