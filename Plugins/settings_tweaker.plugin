def _order_rows(cat, rows):
    """Строки категории по блокам: список списков. Остальное — последним блоком."""
    blocks = DEBUG_BLOCKS.get(cat)
    if not blocks:
        return [rows]
    parts, used = [], set()
    for block in blocks:
        part = []
        for title in block:
            part.extend(r for r in rows if r[1] == title)
        used.update(block)
        if part:
            parts.append(part)
    rest = [r for r in rows if r[1] not in used]
    if rest:
        parts.append(rest)
    return parts


class _PressRipple(dynamic_proxy(View.OnTouchListener)):
    """Резервная вспышка фона для фоллбэк-ячейки, если UItemFactory недоступна."""

    def __init__(self, cell):
        super().__init__()
        self.cell = cell

    def onTouch(self, view, event):
        action = event.getActionMasked()
        if action == 0:
            self.cell.setPressed(True)
        elif action in (1, 3):
            self.cell.setPressed(False)
        return False


class _DebugButtonClick(dynamic_proxy(View.OnClickListener)):
    """Резервный обработчик нажатия кнопки меню отладки (для фоллбэк-ветки)."""

    def __init__(self, idx):
        super().__init__()
        self.idx = idx

    def onClick(self, v):
        _press_button(self.idx)


_HINT_FACTORY_JAVA = None


def _get_hint_factory():
    global _HINT_FACTORY_JAVA
    if _HINT_FACTORY_JAVA is not None:
        return _HINT_FACTORY_JAVA
    from extera_utils.classes import Base, java_subclass, joverload, joverride
    from org.telegram.ui.Cells import TextDetailSettingsCell
    UItemFactory = jclass("org.telegram.ui.Components.UItem$UItemFactory")

    @java_subclass(UItemFactory)
    class _HintButtonFactory(Base):
        @joverride()
        def createView(self, context, list_view, current_account, class_guid, resources_provider):
            return TextDetailSettingsCell(context)

        @joverride()
        def bindView(self, view, item, divider, adapter, list_view):
            title = _jfield(item, "text") or ""
            hint = _jfield(item, "subtext") or ""
            view.setTextAndValue(title, hint, bool(divider))
            try:
                red = Theme.getColor(Theme.key_text_RedRegular)
            except Exception:
                red = -1763531
            view.getValueTextView().setTextColor(red)

        @joverride()
        def isShadow(self):
            return False

        @joverride()
        def isClickable(self):
            return True

        @joverload("contentsEquals", ["org.telegram.ui.Components.UItem", "org.telegram.ui.Components.UItem"])
        def contents_equals(self, a, b):
            try:
                return (
                    int(_jfield(a, "id")) == int(_jfield(b, "id"))
                    and str(_jfield(a, "text") or "") == str(_jfield(b, "text") or "")
                    and str(_jfield(a, "subtext") or "") == str(_jfield(b, "subtext") or "")
                )
            except Exception:
                return False

    peer = _HintButtonFactory.new_instance()
    java_factory = getattr(peer, "java", peer)
    UItemFactory.setup(java_factory)
    _HINT_FACTORY_JAVA = java_factory
    return _HINT_FACTORY_JAVA


def _hint_button_item(item_id, title, hint):
    """Кнопка с подписью под названием в стиле настроек Telegram."""
    from org.telegram.ui.Components import UItem
    try:
        factory = _get_hint_factory()
        item = UItem.ofFactory(factory.getClass())
        item.id = item_id
        item.text = title
        item.subtext = hint
        return item
    except Exception:
        pass
    from org.telegram.ui.Cells import TextDetailSettingsCell
    if _DBG_SCREEN is None:
        return None
    ctx = _DBG_SCREEN.getParentActivity()
    if ctx is None:
        return None
    cell = TextDetailSettingsCell(ctx)
    cell.setTextAndValue(title, hint, True)
    try:
        cell.setBackground(Theme.getSelectorDrawable(False))
    except Exception:
        pass
    try:
        red = Theme.getColor(Theme.key_text_RedRegular)
    except Exception:
        red = -1763531
    cell.getValueTextView().setTextColor(red)
    cell.setOnClickListener(_DebugButtonClick(item_id - 1))
    cell.setOnTouchListener(_PressRipple(cell))
    return UItem.asCustom(item_id, cell)


