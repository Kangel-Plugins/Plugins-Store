                    args[0] = jclass("java.lang.String")("Отладка AyuGram 🤔")
            elif s == "Debug" and _IN_CLIENT_DEBUG_SCREEN == "extera":
                if not _is_en():
                    args[0] = jclass("java.lang.String")("Отладка exteraGram")
        except Exception:
            pass


class _CellTranslateHook(MethodHook):
    """Переводит пункты отладки exteraGram/AyuGram, если экран строится на прямых ячейках."""

    def before_hooked_method(self, param):
        if _is_en() or _IN_CLIENT_DEBUG_SCREEN is None:
            return
        args = param.args
        if not args or args[0] is None:
            return
        try:
            tr0 = _translate_client_dbg_text(args[0], strict=False)
            if tr0 is not None:
                args[0] = jclass("java.lang.String")(tr0)
            if len(args) >= 2 and args[1] is not None and not isinstance(args[1], bool):
                s1 = str(args[1])
                tr1 = _translate_client_dbg_val(s1) or _translate_client_dbg_text(s1, strict=True)
                if tr1 is not None:
                    args[1] = jclass("java.lang.String")(tr1)
        except Exception:
            pass


