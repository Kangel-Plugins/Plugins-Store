_EXTERA_SCAN_RID = None


def _capture_fork_icons(items):
    """Запоминает встроенные R.drawable.* логотипов exteraGram и AyuGram из главных настроек."""
    try:
        from org.telegram.messenger import ApplicationLoader
        res = ApplicationLoader.applicationContext.getResources()
        n = items.size()
        for i in range(n):
            item = items.get(i)
            key = _key_for_item(item, allow_id=True)
            if key in FORK_KEYS:
                rid = int(_jfield(item, "iconResId"))
                if rid != 0:
                    ename = ""
                    try:
                        ename = str(res.getResourceEntryName(rid) or "")
                    except Exception:
                        pass
                    if key == "ayugram" and "ghost" in ename.lower():
                        continue
                    _FORK_ICONS[key] = rid
                    if key == "exteragram" and ename and _FORK_SWITCH_PLUGIN is not None:
                        try:
                            _FORK_SWITCH_PLUGIN.set_setting("_fork_icon_exteragram", ename, reload_settings=False)
                        except Exception:
                            pass
    except Exception:
        pass


def _scan_extera_drawable_id():
    """Один раз ищет среди R.drawable имя иконки exteraGram, если SettingsActivity ещё не открывался."""
    global _EXTERA_SCAN_RID
    if _EXTERA_SCAN_RID is not None:
        return _EXTERA_SCAN_RID
    best = 0
    best_score = -1
    try:
        r_drawable = _try_jclass("org.telegram.messenger.R$drawable")
        if r_drawable is not None:
            for f in r_drawable.getFields():
                name = str(f.getName() or "")
                low = name.lower()
                if "extera" not in low and not low.startswith("etg_"):
                    continue
                if any(bad in low for bad in ("splash", "arrow", "intro", "bg", "background", "banner", "header")):
                    continue
                score = 0
                if "setting" in low:
                    score += 5
                if "icon" in low or "logo" in low or "tile" in low:
                    score += 3
                if low.startswith("etg_") or low.startswith("extera"):
                    score += 2
                if score > best_score:
                    try:
                        val = int(f.getInt(None))
                        if val != 0:
                            best = val
                            best_score = score
                    except Exception:
                        pass
    except Exception:
        pass
    _EXTERA_SCAN_RID = best
    return best


def _drawable_fits_24dp(rid):
    if rid == 0:
        return False
    try:
        from org.telegram.messenger import ApplicationLoader
        d = ApplicationLoader.applicationContext.getResources().getDrawable(rid, None)
        if d is None:
            return False
        limit = AndroidUtilities.dp(28)
        w = int(d.getIntrinsicWidth())
        h = int(d.getIntrinsicHeight())
        return 0 < w <= limit and 0 < h <= limit
    except Exception:
        return False


def _resolve_fork_icon(key):
    """Возвращает R.drawable.* логотипа форка: для extera — из SettingsActivity/кэша/etg_settings, для ayu — логотип (не призрак)."""
    rid = _FORK_ICONS.get(key, 0)
    if key == "exteragram" and rid != 0:
        return rid
    fallback_oversized = rid
    try:
        from org.telegram.messenger import ApplicationLoader
        ctx = ApplicationLoader.applicationContext
        res = ctx.getResources()
        pkg = ctx.getPackageName()
        if key == "exteragram" and _FORK_SWITCH_PLUGIN is not None:
            try:
                saved = str(_FORK_SWITCH_PLUGIN.get_setting("_fork_icon_exteragram", "") or "")
                if saved:
                    cid = int(res.getIdentifier(saved, "drawable", pkg))
                    if cid != 0:
                        return cid
            except Exception:
                pass
        names = list(FORK_ICON_CANDIDATES.get(key, ()))
        if key == "exteragram" and not _is_ayugram_client():
            names.append("ic_logo_foreground")
        for name in names:
            cid = int(res.getIdentifier(name, "drawable", pkg))
            if cid != 0:
                if key == "ayugram":
                    return cid
                if _drawable_fits_24dp(cid):
                    return cid
                if fallback_oversized == 0:
                    fallback_oversized = cid
        if key == "exteragram" and fallback_oversized == 0:
            scanned = _scan_extera_drawable_id()
            if scanned != 0:
                return scanned
    except Exception:
        pass
    return fallback_oversized


_FORK_SWITCH_PLUGIN = None
_FORK_SWITCH_FACTORIES = {}
_FORK_CELL_REFS = {}
_FORK_ICON_CHECK_CELL_CLS = None
_CROPPED_BMP_CACHE = {}


def _crop_drawable_to_bitmap(d, res, target_dp=20, fill=0.90):
    """Обрезает прозрачные поля Drawable и рендерит в заданный размер dp."""
    if d is None:
        return None
    try:
        from android.graphics import Bitmap, Canvas
        probe = 48
        pbmp = Bitmap.createBitmap(probe, probe, Bitmap.Config.ARGB_8888)
        pcan = Canvas(pbmp)
        dm = d.mutate()
        dm.setBounds(0, 0, probe, probe)
        dm.draw(pcan)

        min_x, min_y = probe, probe
        max_x, max_y = -1, -1
        try:
            from java import jarray, jint
            buf = jarray(jint)([0] * (probe * probe))
            pbmp.getPixels(buf, 0, probe, 0, 0, probe, probe)
            for idx, px in enumerate(list(buf)):
                if ((px >> 24) & 0xFF) > 16:
                    y = idx // probe
                    x = idx % probe
                    if x < min_x:
                        min_x = x
                    if x > max_x:
                        max_x = x
                    if y < min_y:
                        min_y = y
                    if y > max_y:
                        max_y = y
        except Exception:
            for y in range(probe):
                for x in range(probe):
                    if ((int(pbmp.getPixel(x, y)) >> 24) & 0xFF) > 16:
                        if x < min_x:
                            min_x = x
                        if x > max_x:
                            max_x = x
                        if y < min_y:
                            min_y = y
                        if y > max_y:
                            max_y = y
        try:
            pbmp.recycle()
        except Exception:
            pass

        target_px = AndroidUtilities.dp(target_dp)
        out_bmp = Bitmap.createBitmap(target_px, target_px, Bitmap.Config.ARGB_8888)
        out_can = Canvas(out_bmp)
        dm2 = d.mutate()
        if max_x >= min_x and max_y >= min_y:
            cw = float(max_x - min_x + 1)
            ch = float(max_y - min_y + 1)
            side = max(cw, ch)
            scale = (float(target_px) * float(fill)) / side
            render_sz = int(round(probe * scale))
            cx = (min_x + max_x + 1) / 2.0
            cy = (min_y + max_y + 1) / 2.0
            left = int(round(target_px / 2.0 - cx * scale))
            top = int(round(target_px / 2.0 - cy * scale))
            dm2.setBounds(left, top, left + render_sz, top + render_sz)
        else:
            dm2.setBounds(0, 0, target_px, target_px)
        dm2.draw(out_can)
        return out_bmp
    except Exception:
        return None


def _cropped_icon_drawable(rid, target_dp=20, fill=0.90):
    """Обрезает прозрачные поля ресурса и рендерит в заданный размер dp."""
    if rid == 0:
        return None
    try:
        from org.telegram.messenger import ApplicationLoader
        res = ApplicationLoader.applicationContext.getResources()
        cache_key = (int(rid), int(target_dp), round(float(fill), 2))
        cached_bmp = _CROPPED_BMP_CACHE.get(cache_key)
        if cached_bmp is not None:
            return BitmapDrawable(res, cached_bmp)
        d = res.getDrawable(rid, None)
        out_bmp = _crop_drawable_to_bitmap(d, res, target_dp=target_dp, fill=fill)
        if out_bmp is None:
            return None
        _CROPPED_BMP_CACHE[cache_key] = out_bmp
        return BitmapDrawable(res, out_bmp)
    except Exception:
        return None


def _extera_fallback_drawable(res, target_dp=20):
    """Встроенный логотип exteraGram для первого запуска, пока SettingsActivity ещё не открывался."""
    try:
        cache_key = ("extera_fallback", int(target_dp))
        cached_bmp = _CROPPED_BMP_CACHE.get(cache_key)
        if cached_bmp is not None:
            return BitmapDrawable(res, cached_bmp)
        raw = base64.b64decode(ICON_EXTERA_FALLBACK_B64)
        bmp = BitmapFactory.decodeByteArray(raw, 0, len(raw))
        if bmp is None:
            return None
        out_bmp = _crop_drawable_to_bitmap(BitmapDrawable(res, bmp), res, target_dp=target_dp, fill=0.90)
        if out_bmp is None:
            return BitmapDrawable(res, bmp)
        _CROPPED_BMP_CACHE[cache_key] = out_bmp
        return BitmapDrawable(res, out_bmp)
    except Exception:
        return None


def _fork_icon_24dp(key):
    """Возвращает масштабированный Drawable логотипа форка под масштаб остальных иконок списка."""
    rid = _resolve_fork_icon(key)
    try:
        from org.telegram.messenger import ApplicationLoader
        ctx = ApplicationLoader.applicationContext
        res = ctx.getResources()
        if rid == 0 and key == "exteragram":
            fb = _extera_fallback_drawable(res, target_dp=20)
            if fb is not None:
                return fb
        if rid == 0:
            rid = int(res.getIdentifier("msg_settings", "drawable", ctx.getPackageName()))
        if rid == 0:
            return None
        bd = _cropped_icon_drawable(rid, target_dp=20, fill=0.90)
        if bd is not None:
            return bd
        bd = _scaled_icon_drawable(rid)
        if bd is not None:
            return bd
        d = res.getDrawable(rid, None)
        return d.mutate() if d is not None else None
    except Exception:
        return None


def _get_fork_icon_check_cell_cls():
    global _FORK_ICON_CHECK_CELL_CLS
    if _FORK_ICON_CHECK_CELL_CLS is not None:
        return _FORK_ICON_CHECK_CELL_CLS
    from extera_utils.classes import Base, java_subclass, joverride
    from org.telegram.ui.Cells import TextCheckCell

    @java_subclass(TextCheckCell)
    class _ForkIconCheckCell(Base):
        @joverride()
        def onDraw(self, canvas):
            super().onDraw(canvas)
            d = getattr(self, "_fork_icon", None)
            if d is None:
                return
            try:
                color = Theme.getColor(Theme.key_windowBackgroundWhiteGrayIcon)
                if color != getattr(self, "_icon_color", None):
                    d.setColorFilter(PorterDuffColorFilter(color, PorterDuff.Mode.MULTIPLY))
                    self._icon_color = color
                h = self.java.getMeasuredHeight()
                size = AndroidUtilities.dp(20)
                left = AndroidUtilities.dp(23)
                top = (h - size) // 2
                d.setBounds(left, top, left + size, top + size)
                d.draw(canvas)
            except Exception:
                pass

    _FORK_ICON_CHECK_CELL_CLS = _ForkIconCheckCell
    return _FORK_ICON_CHECK_CELL_CLS


class _ForkToggleClick(dynamic_proxy(View.OnClickListener)):
    def __init__(self, cell, key):
        super().__init__()
        self.cell = cell
        self.key = key

    def onClick(self, v):
        plugin = _FORK_SWITCH_PLUGIN
        if plugin is None:
            return
        new_val = not bool(plugin._hidden(self.key))
        plugin._on_toggle(self.key, new_val)
        actual = bool(plugin._hidden(self.key))
        try:
            self.cell.setChecked(actual)
        except Exception:
            pass
        try:
            plugin.set_setting("hide_" + self.key, actual, reload_settings=False)
        except Exception:
            pass


def _shift_fork_check_text(java_view):
    try:
        tv = java_view.getChildAt(0)
        if tv is None:
            return
        lp = tv.getLayoutParams()
        target = AndroidUtilities.dp(71)
        if lp.leftMargin != target:
            lp.leftMargin = target
            tv.setLayoutParams(lp)
            java_view.requestLayout()
    except Exception:
        pass


def _get_fork_switch_factory(key):
    """Фабрика строки-переключателя форка с иконкой из меню отладки (SimpleSettingFactory)."""
    cached = _FORK_SWITCH_FACTORIES.get(key)
    if cached is not None:
        return cached

    def create_view(context, list_view, current_account, class_guid, resources_provider):
        cls = _get_fork_icon_check_cell_cls()
        try:
            peer = cls.new_instance(context, resources_provider)
        except Exception:
            peer = cls.new_instance(context)
        peer._fork_icon = _fork_icon_24dp(key)
        peer._icon_color = None
        plugin = _FORK_SWITCH_PLUGIN
        checked = bool(plugin._hidden(key)) if plugin is not None else False
        peer.java.setTextAndCheck(_t_hidable(key, plugin), checked, True)
        peer.java.setWillNotDraw(False)
        _shift_fork_check_text(peer.java)
        try:
            peer.java.setBackground(Theme.getSelectorDrawable(False))
        except Exception:
            pass
        click_proxy = _ForkToggleClick(peer.java, key)
        touch_proxy = _PressRipple(peer.java)
        peer.java.setOnClickListener(click_proxy)
        peer.java.setOnTouchListener(touch_proxy)
        _FORK_CELL_REFS[System.identityHashCode(peer.java)] = (peer, click_proxy, touch_proxy)
        return peer.java

    def bind_view(view, item, divider, adapter, list_view):
        ref = _FORK_CELL_REFS.get(System.identityHashCode(view))
        if ref is not None:
            peer = ref[0]
            if getattr(peer, "_fork_icon", None) is None or key in _FORK_ICONS:
                d = _fork_icon_24dp(key)
                if d is not None:
                    peer._fork_icon = d
                    peer._icon_color = None
        plugin = _FORK_SWITCH_PLUGIN
        checked = bool(plugin._hidden(key)) if plugin is not None else False
        try:
            view.setTextAndCheck(_t_hidable(key, plugin), checked, bool(divider))
        except Exception:
            pass
        _shift_fork_check_text(view)

    factory = SimpleSettingFactory(create_view, bind_view, is_clickable=True, is_shadow=False)
    _FORK_SWITCH_FACTORIES[key] = factory
    return factory


_LANG_SWITCH_FACTORY = None
_LANG_ROW_REFS = {}


def _argb(c: int) -> int:
    return c - (1 << 32) if c >= 0x80000000 else c


def _is_dark_theme() -> bool:
    try:
        bg = int(Theme.getColor(Theme.key_windowBackgroundWhite))
        r = (bg >> 16) & 0xFF
        g = (bg >> 8) & 0xFF
        b = bg & 0xFF
        return (0.299 * r + 0.587 * g + 0.114 * b) < 128.0
    except Exception:
        return True


def _apply_lang_row_style(state, lang, animate=False):
    dark = _is_dark_theme()
    track_gd = state["track_gd"]
    track_gd.setColor(_argb(0xFF141D28 if dark else 0xFFE3E9F0))
    track_gd.setStroke(max(1, AndroidUtilities.dp(1)), _argb(0x10FFFFFF if dark else 0x10000000))

    try:
        accent = int(Theme.getColor(Theme.key_featuredStickers_addButton))
        state["thumb_gd"].setColor(accent)
    except Exception:
        accent = _argb(0xFF2E86D8)
        state["thumb_gd"].setColor(accent)

    ar = (accent >> 16) & 0xFF
    ag = (accent >> 8) & 0xFF
    ab = accent & 0xFF
    acc_lum = 0.299 * ar + 0.587 * ag + 0.114 * ab

    inactive = _argb(0xFF8396A8 if dark else 0xFF607488)
    active = _argb(0xFF111111 if acc_lum > 185.0 else 0xFFFFFFFF)
    is_en = (lang == "en")
    state["tv_ru"].setTextColor(inactive if is_en else active)
    state["tv_en"].setTextColor(active if is_en else inactive)

    tx = float(state["thumb_w"]) if is_en else 0.0
    thumb = state["thumb"]
    if animate:
        try:
            thumb.animate().translationX(tx).setDuration(200).start()
            return
        except Exception:
            pass
    thumb.setTranslationX(tx)


def _refresh_all_for_lang(plugin):
    if plugin is None:
        return
    try:
        plugin.description = _t("plugin_desc", plugin)
    except Exception:
        pass
    try:
        plugin._refresh()
    except Exception:
        pass
    try:
        plugin.set_setting(LANG_KEY, _lang(plugin), reload_settings=True)
    except Exception:
        pass
    try:
        _reload_own_settings_ui(plugin)
    except Exception:
        pass
    for scr, tkey in (
        (_DBG_SCREEN, "debug_title"),
        (_DBG_DEV_SCREEN, "dev_title"),
        (_DBG_DATA_SCREEN, "data_title"),
        (_WARN_SCREEN, "warn_title"),
    ):
        if scr is None:
            continue
        try:
            ab = scr.getActionBar()
            if ab is not None:
                ab.setTitle(_t(tkey, plugin))
        except Exception:
            pass
        try:
            lv = _jget(scr, "listView")
            if lv is not None and lv.adapter is not None:
                lv.adapter.update(False)
        except Exception:
            pass


class _LangPickClick(dynamic_proxy(View.OnClickListener)):
    def __init__(self, state, target_lang):
        super().__init__()
        self.state = state
        self.target_lang = target_lang

    def onClick(self, v):
        global _PLUGIN_LANG
        plugin = _FORK_SWITCH_PLUGIN
        if _lang(plugin) == self.target_lang:
            return
        _PLUGIN_LANG = self.target_lang
        if plugin is not None:
            try:
                plugin.set_setting(LANG_KEY, self.target_lang, reload_settings=False)
            except Exception:
                pass
        try:
            _apply_lang_row_style(self.state, self.target_lang, animate=True)
        except Exception:
            pass

        def _finish_reload():
            _refresh_all_for_lang(_FORK_SWITCH_PLUGIN)

        try:
            AndroidUtilities.runOnUIThread(_PyRunnable(_finish_reload), 195)
        except Exception:
            _finish_reload()


def _get_lang_switch_factory():
    """Переключатель языка по центру в верхней строке настроек (спокойный нативный стиль Telegram)."""
    global _LANG_SWITCH_FACTORY
    if _LANG_SWITCH_FACTORY is not None:
        return _LANG_SWITCH_FACTORY

    def _make_option_tv(context, text):
        tv = TextView(context)
        tv.setText(text)
        tv.setTextSize(1, 14.5)
        try:
            tv.setTypeface(AndroidUtilities.getTypeface("fonts/rmedium.ttf"))
        except Exception:
            try:
                tv.setTypeface(AndroidUtilities.bold())
            except Exception:
                try:
                    tv.setTypeface(Typeface.DEFAULT_BOLD)
                except Exception:
                    pass
        tv.setGravity(Gravity.CENTER)
        tv.setSingleLine(True)
        return tv

    def create_view(context, list_view, current_account, class_guid, resources_provider):
        row = FrameLayout(context)
        row.setLayoutParams(ViewGroup.LayoutParams(-1, -2))
        row.setMinimumHeight(AndroidUtilities.dp(67))
        row.setPadding(
            AndroidUtilities.dp(16),
            AndroidUtilities.dp(11),
            AndroidUtilities.dp(16),
            AndroidUtilities.dp(11),
        )

        try:
            disp_w = int(AndroidUtilities.displaySize.x)
            pill_w = max(AndroidUtilities.dp(240), min(AndroidUtilities.dp(380), int(disp_w * 0.75)))
        except Exception:
            pill_w = AndroidUtilities.dp(280)
        if pill_w % 2 != 0:
            pill_w += 1
        pill_h = AndroidUtilities.dp(45)
        pad = AndroidUtilities.dp(4)
        thumb_w = (pill_w - 2 * pad) // 2
        thumb_h = pill_h - 2 * pad

        pill = FrameLayout(context)
        track_gd = GradientDrawable()
        track_gd.setCornerRadius(float(pill_h) / 2.0)
        pill.setBackground(track_gd)

        thumb = View(context)
        thumb_gd = GradientDrawable()
        thumb_gd.setColor(_argb(0xFF2E86D8))
        thumb_gd.setCornerRadius(float(thumb_h) / 2.0)
        thumb.setBackground(thumb_gd)
        thumb_lp = FrameLayout.LayoutParams(thumb_w, thumb_h)
        thumb_lp.leftMargin = pad
        thumb_lp.topMargin = pad
        pill.addView(thumb, thumb_lp)

        ll = LinearLayout(context)
        ll.setOrientation(LinearLayout.HORIZONTAL)
        tv_ru = _make_option_tv(context, _t("lang_ru"))
        tv_en = _make_option_tv(context, _t("lang_en"))
        opt_lp = LinearLayout.LayoutParams(0, -1, 1.0)
        ll.addView(tv_ru, opt_lp)
        ll.addView(tv_en, opt_lp)
        ll_lp = FrameLayout.LayoutParams(pill_w - 2 * pad, thumb_h)
        ll_lp.leftMargin = pad
        ll_lp.topMargin = pad
        pill.addView(ll, ll_lp)

        row.addView(pill, FrameLayout.LayoutParams(pill_w, pill_h, Gravity.CENTER))

        state = {
            "tv_ru": tv_ru,
            "tv_en": tv_en,
            "thumb": thumb,
            "thumb_gd": thumb_gd,
            "track_gd": track_gd,
            "thumb_w": thumb_w,
        }
        click_ru = _LangPickClick(state, "ru")
        click_en = _LangPickClick(state, "en")
        tv_ru.setOnClickListener(click_ru)
        tv_en.setOnClickListener(click_en)
        _apply_lang_row_style(state, _lang(), animate=False)

        _LANG_ROW_REFS[System.identityHashCode(row)] = (state, click_ru, click_en)
        return row

    def bind_view(view, item, divider, adapter, list_view):
        ref = _LANG_ROW_REFS.get(System.identityHashCode(view))
        if ref is None:
            return
        state = ref[0]
        _apply_lang_row_style(state, _lang(), animate=False)

    factory = SimpleSettingFactory(create_view, bind_view, is_clickable=False, is_shadow=True)
    _LANG_SWITCH_FACTORY = factory
    return factory


def _scaled_icon_drawable(rid):
    """Сжимает и центрирует крупный/адаптивный встроенный логотип (21dp)."""
    if rid == 0:
        return None
    bd = _cropped_icon_drawable(rid, target_dp=21, fill=0.90)
    if bd is not None:
        return bd
    try:
        from org.telegram.messenger import ApplicationLoader
        from android.graphics import Bitmap, Canvas
        ctx = ApplicationLoader.applicationContext
        res = ctx.getResources()
        d = res.getDrawable(rid, None)
        if d is None:
            return None
        limit = AndroidUtilities.dp(28)
        w = int(d.getIntrinsicWidth())
        h = int(d.getIntrinsicHeight())
        if 0 < w <= limit and 0 < h <= limit:
            return None
        size = AndroidUtilities.dp(21)
        bmp = Bitmap.createBitmap(size, size, Bitmap.Config.ARGB_8888)
        canvas = Canvas(bmp)
        dm = d.mutate()
        dm.setBounds(0, 0, size, size)
        dm.draw(canvas)
        return BitmapDrawable(res, bmp)
    except Exception:
        return None


def _get_fork_row_factory():
    """Фабрика TextCell с принудительным масштабированием иконки до 24dp и белым нажатием."""
    global _FORK_ROW_FACTORY_JAVA
    if _FORK_ROW_FACTORY_JAVA is not None:
        return _FORK_ROW_FACTORY_JAVA
    from extera_utils.classes import Base, java_subclass, joverload, joverride
    UItemFactory = jclass("org.telegram.ui.Components.UItem$UItemFactory")
    from org.telegram.ui.Cells import TextCell

    @java_subclass(UItemFactory)
    class _ScaledForkRowFactory(Base):
        @joverride()
        def createView(self, context, list_view, current_account, class_guid, resources_provider):
            try:
                return TextCell(context, resources_provider)
            except Exception:
                return TextCell(context)

        @joverride()
        def bindView(self, view, item, divider, adapter, list_view):
            rid = int(_jfield(item, "iconResId"))
            title = str(_jfield(item, "text") or "")
            bd = _scaled_icon_drawable(rid)
            if bd is not None:
                view.setTextAndIcon(title, bd, bool(divider))
            elif rid != 0:
                view.setTextAndIcon(title, rid, bool(divider))
            else:
                view.setText(title, bool(divider))
            try:
                view.setColors(Theme.key_windowBackgroundWhiteGrayIcon, Theme.key_windowBackgroundWhiteBlackText)
            except Exception:
                pass

        @joverride()
        def isShadow(self):
            return False

        @joverride()
        def isClickable(self):
            return True

        @joverload("contentsEquals", ["org.telegram.ui.Components.UItem", "org.telegram.ui.Components.UItem"])
        def contents_equals(self, a, b):
            try:
                return int(_jfield(a, "id")) == int(_jfield(b, "id")) and int(_jfield(a, "iconResId")) == int(_jfield(b, "iconResId")) and str(_jfield(a, "text") or "") == str(_jfield(b, "text") or "")
            except Exception:
                return False

    peer = _ScaledForkRowFactory.new_instance()
    java_factory = getattr(peer, "java", peer)
    UItemFactory.setup(java_factory)
    _FORK_ROW_FACTORY_JAVA = java_factory
    return _FORK_ROW_FACTORY_JAVA


def _fork_debug_row_item(which, row_id, title):
    """Строка перехода на экран отладки exteraGram / AyuGram с встроенным логотипом 24dp (если есть)."""
    from org.telegram.ui.Components import UItem
    rid = _resolve_fork_icon(which)
    if rid != 0 and not _drawable_fits_24dp(rid):
        try:
            factory = _get_fork_row_factory()
            item = UItem.ofFactory(factory.getClass())
            item.id = row_id
            item.iconResId = rid
            item.text = title
            return item
        except Exception:
            return UItem.asButton(row_id, title)
    if rid != 0:
        return UItem.asButton(row_id, rid, title)
    return UItem.asButton(row_id, title)


def _to_java_class(cls_name, base_jcls=None):
    try:
        return jclass("java.lang.Class").forName(cls_name)
    except Exception:
        pass
    if base_jcls is not None:
        try:
            return base_jcls.getClassLoader().loadClass(cls_name)
        except Exception:
            pass
    return None


def _try_jclass(cls_name):
    try:
        return jclass(cls_name)
    except Exception:
        pass
    try:
        return find_class(cls_name)
    except Exception:
        return None


_APK_DEX_CACHE = None


def _instantiate_java_class(jcls_obj, base_jcls):
    if jcls_obj is None:
        return None
    cname = str(jcls_obj.getName())
    try:
        if base_jcls is not None and not base_jcls.isAssignableFrom(jcls_obj):
            return None
    except Exception:
        return None
    try:
        return jclass(cname)()
    except Exception:
        pass
    try:
        return jcls_obj.newInstance()
    except Exception:
        pass
    try:
        from java import jarray
        obj_cls = jclass("java.lang.Object")
        obj_empty = jarray(obj_cls)(0)
        obj_null = jarray(obj_cls)([None])
        obj_zero = jarray(obj_cls)([jclass("java.lang.Integer")(0)])
        obj_false = jarray(obj_cls)([jclass("java.lang.Boolean")(False)])
        for ctor in jcls_obj.getDeclaredConstructors():
            params = ctor.getParameterTypes()
            ctor.setAccessible(True)
            if len(params) == 0:
                try:
                    return ctor.newInstance()
                except Exception:
                    return ctor.newInstance(obj_empty)
            if len(params) == 1:
                pname = str(params[0].getName())
                if pname == "android.os.Bundle":
                    return ctor.newInstance(obj_null)
                if pname == "int":
                    return ctor.newInstance(obj_zero)
                if pname == "boolean":
                    return ctor.newInstance(obj_false)
    except Exception:
        pass
    return None


def _instantiate_by_name(cname, base_py_cls, base_jcls):
    if not cname:
        return None
    py_cls = _try_jclass(cname)
    if py_cls is not None:
        if isinstance(py_cls, type):
            if base_py_cls is not None and isinstance(base_py_cls, type):
                try:
                    if not issubclass(py_cls, base_py_cls):
                        return None
                except Exception:
                    pass
            try:
                return py_cls()
            except Exception:
                pass
        else:
            res = _instantiate_java_class(py_cls, base_jcls)
            if res is not None:
                return res
    return _instantiate_java_class(_to_java_class(cname, base_jcls), base_jcls)


def _scan_apk_dex_classes():
    """Читает имена классов из classes*.dex в APK (без Android Hidden API)."""
    global _APK_DEX_CACHE
    if _APK_DEX_CACHE is not None:
        return _APK_DEX_CACHE
    out = []
    seen = set()
    try:
        import struct
        import zipfile
        from org.telegram.messenger import ApplicationLoader
        ai = ApplicationLoader.applicationContext.getApplicationInfo()
        apks = []
        if ai.sourceDir:
            apks.append(str(ai.sourceDir))
        splits = ai.splitSourceDirs
        if splits is not None:
            for s in splits:
                if s:
                    apks.append(str(s))
        for apk_path in apks:
            try:
                with zipfile.ZipFile(apk_path, "r") as zf:
                    for name in zf.namelist():
                        if not (name.startswith("classes") and name.endswith(".dex")):
                            continue
                        data = zf.read(name)
                        if len(data) < 112 or data[:4] != b"dex\n":
                            continue
                        s_cnt, s_off, t_cnt, t_off = struct.unpack_from("<IIII", data, 56)
                        s_offs = struct.unpack_from(f"<{s_cnt}I", data, s_off)
                        t_ids = struct.unpack_from(f"<{t_cnt}I", data, t_off)
                        for sid in t_ids:
                            pos = s_offs[sid]
                            b = data[pos]
                            pos += 1
                            while b & 0x80:
                                b = data[pos]
                                pos += 1
                            if data[pos:pos + 1] != b"L":
                                continue
                            keep = (
                                data[pos + 1:pos + 16] == b"com/exteragram/"
                                or data[pos + 1:pos + 13] == b"com/radolyn/"
                            )
                            if not keep and data[pos + 1:pos + 17] == b"org/telegram/ui/":
                                end_tmp = data.find(b"\x00", pos)
                                sub = data[pos + 17:end_tmp].lower() if end_tmp > pos + 17 else b""
                                keep = b"debug" in sub or b"extera" in sub or b"ayu" in sub
                            if not keep:
                                continue
                            end = data.find(b"\x00", pos)
                            if end > pos + 2 and data[end - 1:end] == b";":
                                cname = data[pos + 1:end - 1].decode("utf-8", "ignore").replace("/", ".")
                                # Пропускаем анонимные лямбды вида Foo$1, оставляем именованные классы
                                tail = cname.rsplit("$", 1)[-1]
                                if "$" in cname and tail.isdigit():
                                    continue
                                if cname not in seen:
                                    seen.add(cname)
                                    out.append(cname)
            except Exception:
                continue
    except Exception:
        pass
    _APK_DEX_CACHE = out
    return out


def _iter_dex_classes(base_jcls, prefixes):
    out = _scan_apk_dex_classes()
    if out:
        return [c for c in out if any(c.startswith(p) for p in prefixes)]
    res = []
    try:
        if base_jcls is None:
            return res
        loader = base_jcls.getClassLoader()
        path_list = _jget(loader, "pathList")
        elements = _jget(path_list, "dexElements")
        if elements is None:
            return res
        for i in range(len(elements)):
            dex_file = _jget(elements[i], "dexFile")
            if dex_file is None:
                continue
            entries = dex_file.entries()
            while entries.hasMoreElements():
                cname = str(entries.nextElement())
                if any(cname.startswith(p) for p in prefixes):
                    res.append(cname)
    except Exception:
        pass
    return res


def _get_fragment_title(frag):
    """Читает заголовок BaseFragment через ActionBar или метод getTitle() (в т.ч. protected)."""
    try:
        ab = frag.getActionBar()
        if ab is not None:
            t = ab.getTitle()
            if t is not None and str(t).strip():
                return str(t).strip()
    except Exception:
        pass
    try:
        return str(frag.getTitle() or "").strip()
    except Exception:
        pass
    try:
        c = frag.getClass()
        while c is not None:
            try:
                m = c.getDeclaredMethod("getTitle")
                m.setAccessible(True)
                return str(m.invoke(frag) or "").strip()
            except Exception:
                c = c.getSuperclass()
    except Exception:
        pass
    return ""


_IS_AYUGRAM_CLIENT = None
_IN_CLIENT_DEBUG_SCREEN = None  # None | "extera" | "ayu"


def _is_ayugram_client(plugin=None):
    """Определяет AyuGram один раз при первом запуске плагина и сохраняет результат."""
    global _IS_AYUGRAM_CLIENT
    if _IS_AYUGRAM_CLIENT is not None:
        return _IS_AYUGRAM_CLIENT

    pkg = ""
    try:
        from org.telegram.messenger import ApplicationLoader
        pkg = str(ApplicationLoader.applicationContext.getPackageName() or "")
    except Exception:
        pass

    if plugin is not None:
        try:
            saved_pkg = str(plugin.get_setting("_client_pkg", "") or "")
            saved_val = plugin.get_setting("_client_is_ayugram", None)
            if saved_val is not None and (not pkg or saved_pkg == pkg):
                _IS_AYUGRAM_CLIENT = bool(saved_val)
                return _IS_AYUGRAM_CLIENT
        except Exception:
            pass

    is_ayu = False
    if "ayu" in pkg.lower():
        is_ayu = True
    elif "ayugram" in _FORK_ICONS:
        is_ayu = True
    else:
        for cname in (
            "com.radolyn.ayugram.ui.preferences.AyuGramPreferencesActivity",
            "com.radolyn.ayugram.AyuConfig",
            "com.radolyn.ayugram.AyuConstants",
        ):
            if _try_jclass(cname) is not None or _to_java_class(cname) is not None:
                is_ayu = True
                break

    _IS_AYUGRAM_CLIENT = is_ayu
    if plugin is not None:
        try:
            if pkg:
                plugin.set_setting("_client_pkg", pkg, reload_settings=False)
            plugin.set_setting("_client_is_ayugram", is_ayu, reload_settings=False)
        except Exception:
            pass
    return _IS_AYUGRAM_CLIENT


