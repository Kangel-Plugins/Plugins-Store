def _t_hidable(key: str, plugin=None) -> str:
    ru, en, _ = HIDABLE[key]
    return en if _is_en(plugin) else ru


def _t_debug_cat(cat: str, plugin=None) -> str:
    if _is_en(plugin):
        return DEBUG_CAT_EN.get(cat, cat)
    return cat


def _t_debug_item(title: str, plugin=None) -> str:
    if _is_en(plugin):
        return DEBUG_ITEM_EN.get(title, title)
    return title


def _t_debug_hint(title: str, plugin=None):
    if _is_en(plugin):
        return DEBUG_HINTS_EN.get(title)
    return DEBUG_HINTS.get(title)

# Английские строки, которые Telegram зашивает прямо в код меню отладки.
# Ключ — текст в нижнем регистре; значение — (категория, русское название).
# Строки из ресурсов Telegram уже на языке приложения и сюда не попадают.
# Пункты меню отладки Telegram, зашитые в код (не из ресурсов).
# Ключ — текст пункта в нижнем регистре, как его показывает Telegram сейчас.
# Значение: (категория, название, тип, включено).
#   "sw"  — переключатель; «включено» выводится из текста пункта (например, «Enable …» = сейчас выключено);
#   "btn" — обычное действие, состояние не нужно.
# Русские строки Telegram тоже здесь: без записи пункт покажется как кнопка с исходным текстом.
