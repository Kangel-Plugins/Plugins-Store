class _SettingsFillHook(MethodHook):
    """SettingsActivity.fillItems: скрываем пункты и добавляем строку меню отладки."""

    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        frag, items = param.thisObject, param.args[0]
        applied = False
        try:
            applied = bool(self.plugin._apply(frag, items))
        except Exception:
            applied = False
        if applied:
            self.plugin._handled_id = System.identityHashCode(items)
        try:
            self.plugin._add_debug_row(frag, items)
            self.plugin._add_plugins_row(frag, items)
        except Exception:
            pass


