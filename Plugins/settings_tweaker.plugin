# ======================= Локализация (RU / EN) =======================

LANG_KEY = "plugin_lang"  # "ru" | "en"
_PLUGIN_LANG = None


def _lang(plugin=None) -> str:
    global _PLUGIN_LANG
    p = plugin or _FORK_SWITCH_PLUGIN
    if p is not None:
        try:
            v = str(p.get_setting(LANG_KEY, "") or "").lower()
            if v in ("ru", "en"):
                _PLUGIN_LANG = v
                return v
        except Exception:
            pass
    if _PLUGIN_LANG in ("ru", "en"):
        return _PLUGIN_LANG
    return "ru"


def _is_en(plugin=None) -> bool:
    return _lang(plugin) == "en"


