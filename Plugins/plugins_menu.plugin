import time
from java import dynamic_proxy, jclass
from android.view import View, MotionEvent
from android.widget import Toast
from android.os import Bundle

from base_plugin import BasePlugin, MethodHook
from hook_utils import find_class
from android_utils import log
from client_utils import get_last_fragment
from ui.settings import Selector

__id__ = "plugins_menu"
__name__ = "Title Actions"
__description__ = "Действие по нажатию на заголовок exteraGram"
__author__ = "@RedPlugin"
__version__ = "1.0"
__icon__ = "alegquin108/14"
__app_version__ = ">=12.10.6"

DIALOGS = "org.telegram.ui.DialogsActivity"
HOOKED_METHODS = ("createView", "onResume")
PLUGINS_SCREENS = [
    "com.exteragram.messenger.plugins.ui.PluginsActivity",
    "com.exteragram.messenger.plugins.PluginsActivity",
    "com.exteragram.messenger.plugins.ui.PluginsListActivity",
    "com.exteragram.messenger.plugins.ui.PluginsFragment",
]
ACTIONS = [
    "Плагины",
    "Избранное",
    "Настройки",
    "Профиль",
    "Ничего",
]
MODE_VERSION = "2"

plugin_ref = [None]
last_open = [0.0]


def toast(text):
    try:
        app = jclass("org.telegram.messenger.ApplicationLoader")
        Toast.makeText(app.applicationContext, text, Toast.LENGTH_LONG).show()
    except Exception as e:
        log("TitleActions toast error: " + str(e))


def get_class(name):
    app = "org.telegram.messenger.ApplicationLoader"
    getters = [
        lambda: jclass(name).class_,
        lambda: find_class(name).class_,
        lambda: jclass("java.lang.Class").forName(
            name, True, jclass(app).class_.getClassLoader()
        ),
        lambda: jclass("java.lang.Class").forName(name),
    ]
    last_error = None
    for getter in getters:
        try:
            return getter()
        except Exception as e:
            last_error = e
    raise RuntimeError("Не найден класс " + name + ": " + str(last_error))


def get_setting(key, default):
    plugin = plugin_ref[0]
    if plugin is None:
        return default
    try:
        return plugin.get_setting(key, default)
    except Exception:
        return default


def set_setting(key, value):
    plugin = plugin_ref[0]
    if plugin is None:
        return
    try:
        plugin.set_setting(key, value, reload_settings=False)
    except TypeError:
        plugin.set_setting(key, value)


def migrate_mode():
    if str(get_setting("mode_version", "")) == MODE_VERSION:
        return
    try:
        old = int(get_setting("mode", 0))
    except Exception:
        old = 0
    if old == 2:
        new = 0
    elif old > 2:
        new = old - 1
    else:
        new = old
    set_setting("mode", new)
    set_setting("mode_version", MODE_VERSION)


def my_user_id():
    config = jclass("org.telegram.messenger.UserConfig")
    return config.getInstance(config.selectedAccount).getClientUserId()


def open_chat(fragment, key, value):
    args = Bundle()
    args.putLong(key, int(value))
    chat = jclass("org.telegram.ui.ChatActivity")(args)
    fragment.presentFragment(chat)


def open_plugins(fragment):
    errors = []
    for screen_name in PLUGINS_SCREENS:
        try:
            fragment.presentFragment(jclass(screen_name)())
            return
        except Exception as e:
            errors.append(screen_name.split(".")[-1] + ": " + str(e))
    log("TitleActions plugins errors: " + " | ".join(errors))
    toast("Title Actions: экран плагинов не открылся. " + errors[0][:150])


def open_settings(fragment):
    fragment.presentFragment(jclass("org.telegram.ui.SettingsActivity")())


def open_profile(fragment):
    args = Bundle()
    args.putLong("user_id", my_user_id())
    fragment.presentFragment(jclass("org.telegram.ui.ProfileActivity")(args))


def run_action(fragment):
    now = time.time()
    if now - last_open[0] < 0.6:
        return
    last_open[0] = now
    action = int(get_setting("mode", 0))
    try:
        if action == 0:
            open_plugins(fragment)
        elif action == 1:
            open_chat(fragment, "user_id", my_user_id())
        elif action == 2:
            open_settings(fragment)
        elif action == 3:
            open_profile(fragment)
    except Exception as e:
        log("TitleActions action error: " + str(e))
        toast("Title Actions: " + str(e)[:150])


class TitleClick(dynamic_proxy(View.OnClickListener)):
    def __init__(self, fragment):
        super().__init__()
        self.fragment = fragment

    def onClick(self, v):
        run_action(self.fragment)


class BarTouch(dynamic_proxy(View.OnTouchListener)):
    def __init__(self, fragment):
        super().__init__()
        self.fragment = fragment

    def onTouch(self, v, event):
        try:
            if event.getAction() == MotionEvent.ACTION_UP:
                w = v.getWidth()
                x = event.getX()
                y = event.getY()
                if w * 0.25 <= x <= w * 0.75 and 0 <= y <= v.getHeight():
                    run_action(self.fragment)
        except Exception as e:
            log("TitleActions touch error: " + str(e))
        return False


class AttachHook(MethodHook):
    def after_hooked_method(self, param):
        try:
            fragment = param.thisObject
            action_bar = fragment.getActionBar()
            if action_bar is None:
                return
            try:
                title = action_bar.getTitleTextView()
            except Exception:
                title = None
            if title is not None:
                title.setOnClickListener(TitleClick(fragment))
            action_bar.setOnTouchListener(BarTouch(fragment))
        except Exception as e:
            toast("Title Actions hook: " + str(e)[:150])


class TitleActionsPlugin(BasePlugin):
    def on_plugin_load(self):
        plugin_ref[0] = self
        migrate_mode()
        hook = AttachHook()
        count = 0
        for method in get_class(DIALOGS).getDeclaredMethods():
            if str(method.getName()) in HOOKED_METHODS:
                self.hook_method(method, hook)
                count += 1
        if count == 0:
            toast("Title Actions: методы DialogsActivity не найдены")

    def on_plugin_unload(self):
        plugin_ref[0] = None

    def create_settings(self):
        return [
            Selector(
                key="mode",
                text="Открывать",
                default=0,
                items=ACTIONS,
            ),
        ]