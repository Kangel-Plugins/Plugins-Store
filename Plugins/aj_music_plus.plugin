 lambda v: self.p._qc_resume(self.act, self._ghost_track())))
   rlp = self.LP(-2, self.dp(40))
   rlp.topMargin = self.dp(8)
   box.addView(rb, rlp)
  return box
 def _ghost_track(self):
  if not self.ghost:
   if self.items:
    return None
   try:
