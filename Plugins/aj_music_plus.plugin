 @staticmethod
 def _as_bitmap(value):
  if value is None:
   return None
  for _ in range(3):
   try:
    if str(value.getClass().getName()) == "android.graphics.Bitmap":
     return value
   except Exception:
    return None
   nxt = None
   try:
    nxt = value.getBitmap()
   except Exception:
    try:
     nxt = value.bitmap
    except Exception:
     try:
      nxt = value.drawable.getBitmap()
     except Exception:
      nxt = None
   if nxt is None:
    return None
   value = nxt
  return None
 def _save_cover_gallery(self, art, pm):
  try:
   bmp = None
