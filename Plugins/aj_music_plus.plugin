  return photo
 def _lib_artist_images(self, entries):
  p = self.p
  cache = p.__dict__.setdefault("_artist_bmp", {})
  pending = p.__dict__.setdefault("_artist_pending", [])
  for a in entries:
   if a["k"] not in cache and a.get("u") != "" and a not in pending:
    pending.append(a)
  if not pending or p.__dict__.get("_artist_img_busy"):
   return
  p._artist_img_busy = True
  def work():
   try:
    while pending and self.dialog.isShowing():
     a = pending.pop(0)
     bmp = self._lib_artist_fetch_image(a)
     if bmp is not None:
      cache[a["k"]] = bmp
      run_on_ui_thread(lambda k=a["k"], b=bmp: self._lib_artist_set_image(k, b))
   finally:
    p._artist_img_busy = False
    run_on_ui_thread(p._lib_save)
  threading.Thread(target=work, daemon=True).start()
 def _lib_artist_fetch_image(self, a):
  import os, hashlib, urllib.parse
  BF = _cls("android.graphics.BitmapFactory")
  norm = lambda t: re.sub(r"\\W+", "", str(t).casefold())
  artist_name = str(a.get("n") or "").strip()
  first = re.split(r"\\s*(?:,|&|/|;|\\bfeat\\.?|\\bft\\.?|\\bwith\\b)\\s*",
 artist_name, flags=re.I)[0].strip()
  queries = list(dict.fromkeys(q for q in (artist_name, first) if q))
  try:
   ctx = find_class("org.telegram.messenger.ApplicationLoader").applicationContext
   folder = os.path.join(str(ctx.getCacheDir().getAbsolutePath()), "smq_artists")
   os.makedirs(folder, exist_ok=True)
   path = os.path.join(folder, hashlib.md5(a["k"].encode("utf-8")).hexdigest() + ".jpg")
   bmp = BF.decodeFile(path) if os.path.exists(path) else None
   if bmp is not None:
    return _cls("android.graphics.Bitmap").createScaledBitmap(bmp, 200, 200, True)
   candidates = []
   if a.get("u"):
    candidates.append(a.get("u"))
   for q in queries:
    try:
     hits = json.loads(_http_text(
 "https://api.deezer.com/search/artist?limit=5&q=" +
 urllib.parse.quote(q))).get("data") or []
     hit = next((h for h in hits
 if norm(h.get("name", "")) == norm(q)
 and h.get("picture_medium")), None)
     if hit:
      candidates.append(hit.get("picture_medium"))
      break
    except Exception:
     pass
   for q in queries:
    try:
     data = json.loads(_http_text(
 "https://itunes.apple.com/search?term=" + urllib.parse.quote(q) +
 "&entity=album&attribute=artistTerm&limit=15"))
     results = data.get("results") or []
     hit = next((r for r in results
 if norm(r.get("artistName", "")) == norm(q)
 and r.get("artworkUrl100")), None)
     if hit:
      candidates.append(hit["artworkUrl100"].replace("100x100bb", "600x600bb"))
      break
    except Exception:
     pass
   for q in queries:
    try:
     data = json.loads(_http_text(
 "https://en.wikipedia.org/w/api.php?action=query&generator=search"
 "&gsrsearch=" + urllib.parse.quote(q) +
 "&gsrnamespace=0&gsrlimit=5&prop=pageimages&piprop=thumbnail"
 "&pithumbsize=500&format=json"))
     pages = (data.get("query") or {}).get("pages") or {}
     page_list = pages.values() if isinstance(pages, dict) else []
     hit = next((pg for pg in page_list
 if norm(q) in norm(pg.get("title", ""))
 and (pg.get("thumbnail") or {}).get("source")), None)
     if hit:
      candidates.append(hit["thumbnail"]["source"])
      break
    except Exception:
     pass
   for url in dict.fromkeys(u for u in candidates if u):
    try:
     stream = _http_stream(url)
     try:
      image = BF.decodeStream(stream)
     finally:
      stream.close()
     if image is None:
      continue
     bmp = image
     try:
      fos = jclass("java.io.FileOutputStream")(path)
      bmp.compress(_cls("android.graphics.Bitmap$CompressFormat").JPEG, 85, fos)
      fos.close()
     except Exception:
      pass
     a["u"] = url
     return _cls("android.graphics.Bitmap").createScaledBitmap(bmp, 200, 200, True)
    except Exception:
     continue
   return None
  except Exception:
   return None
 def _lib_artist_set_image(self, key, bmp):
  try:
   iv = self.lib_artist_views.get(key)
   if iv is not None:
    iv.setImageBitmap(bmp)
   hv = getattr(self, "hdr_artist_views", {}).get(key)
   if hv is not None:
    hv.setImageBitmap(bmp)
  except Exception:
   pass
 def _lib_artist_scan(self, key):
  target = str(key).casefold()
  seen, kept, dupes, natural = set(), [], [], []
  by_title = {}
  def author_ok(message):
   return (_QueueEditor._author_of(message) or "").strip().casefold() == target
  def is_dupe(message):
   try:
    raw_title = _QueueEditor._title_of(message)
    title = self._album_norm(raw_title, _QueueEditor._author_of(message) or "") \
 or " ".join(raw_title.casefold().split())
    exact = (" ".join(raw_title.casefold().split()), target)
   except Exception:
    return False
   try:
    dur = int(message.getDuration())
   except Exception:
    dur = 0
   for entry in by_title.get(title, ()):
    other, other_exact = entry["dur"], entry["exact"]
    gap = abs(dur - other)
    if not dur or not other or gap <= 2 or (gap <= 6 and exact == other_exact):
     entry["dupes"].append(message)
     return True
   by_title.setdefault(title, []).append(
 {"dur": dur, "exact": exact, "msg": message, "dupes": []})
   return False
  groups = []
  cache = self.p._chat_track_cache
  for ck in list(cache.keys()):
   msgs = cache.get(ck)
   rows = getattr(msgs, "rows", None)
   found = []
   if rows is not None:
    for n, r in enumerate(rows):
     if (r.get("a") or "").strip().casefold() == target:
      try:
       found.append(msgs[n])
      except Exception:
       pass
   else:
    for message in msgs or []:
     if message is not None and author_ok(message):
      found.append(message)
   if found:
    groups.append(found)
  groups.sort(key=lambda g: -len(g))
  extra = [m for m in (self.p.__dict__.get("_artist_extra_msgs", {}).get(target, []) or [])
 if m is not None and author_ok(m)]
  if extra:
   groups.append(extra)
  for group in groups:
   for message in group:
    if message is None or not author_ok(message):
     continue
    k = self._lib_key(message)
    if k in seen:
     continue
    seen.add(k)
    natural.append(message)
    is_dupe(message)
  hidden = set()
  for entries in by_title.values():
   for entry in entries:
    if not entry["dupes"]:
     continue
    shown, others = entry["msg"], list(entry["dupes"])
    try:
     if not self.p._is_downloaded(shown):
      better = next((d for d in others if self.p._is_downloaded(d)), None)
      if better is not None:
       others.remove(better)
       others.append(shown)
       shown = better
    except Exception:
     pass
    hidden.update(self._lib_key(d) for d in others)
  for message in natural:
   (dupes if self._lib_key(message) in hidden else kept).append(message)
  return kept, dupes, natural
 def _lib_artist_msgs(self, key):
  return self._lib_artist_scan(key)[0]
 def _lib_on_artist_page(self, name):
  try:
   kind, ref = self.lib_state
   if kind != "artist" or getattr(self, "tab", None) != "library":
    return False
   n = str(name or "").strip().casefold()
   if not n:
    return False
   if str(ref).casefold() == n:
    return True
   a = next((a for a in self._lib_artist_data().get("list", [])
 if str(a.get("k", "")).casefold() == str(ref).casefold()), None)
   return a is not None and str(a.get("n", "")).strip().casefold() == n
  except Exception:
   return False
 def _lib_ensure_artist(self, name, message=None):
  name = str(name or "").strip()
  if not name:
   return None
  key = name.casefold()
  ad = self._lib_artist_data()
  artist = next((a for a in ad.get("list", [])
 if str(a.get("k", "")).casefold() == key
 or str(a.get("n", "")).strip().casefold() == key), None)
  if artist is not None:
   key = str(artist.get("k", key)).casefold()
  if message is not None:
   extras = self.p.__dict__.setdefault("_artist_extra_msgs", {})
   bucket = extras.setdefault(key, [])
   try:
    message_key = self._lib_key(message)
    if all(self._lib_key(existing) != message_key for existing in bucket):
     bucket.append(message)
   except Exception:
    if message not in bucket:
     bucket.append(message)
  if artist is None:
   msgs = self._lib_artist_msgs(key)
   artist = {"k": key, "n": name, "c": max(1, len(msgs)), "q": 1}
   ad.setdefault("list", []).append(artist)
   self.p._lib_save()
  return key
 def _lib_artist_view(self, key):
  p = self.p
  if str(key).casefold() in self._lib_excluded_artists():
   self._lib_go("home")
   return
  a = next((x for x in self._lib_artist_data()["list"] if x["k"] == key), None)
  if a is None:
   self._lib_go("home")
   return
  self._lib_set_selection_context(("artist", key))
  self.lib_scope = None
  tried = p.__dict__.setdefault("_artist_tried", set())
  missing = [k for k in ((int(c["d"]), int(c["t"])) for c in p._lib_data()["chats"])
 if k not in p._chat_track_cache and k not in tried]
  if missing:
   tried.update(missing)
   self._lib_each_chat(missing, lambda _m: None,
 lambda: self.lib_state == ("artist", key) and self._lib_render())
  msgs, dupes, natural = self._lib_artist_scan(key)
  meta = ("Loading tracks…" if missing else
 self._lib_tracks_meta(len(msgs), self._lib_message_minutes(msgs)) if msgs else "No cached tracks")
  artist_avatar = self._artist_avatar(key, self.dp(36), a["n"])
  self._lib_detail_header(
 a["n"], meta, lambda: self._lib_go("home"),
 lambda: self._lib_artist_menu(key), avatar_view=artist_avatar)
  if missing:
   self._lib_empty_loading_view("Loading tracks…")
   return
  if not msgs:
   self._lib_hint("No cached tracks. Rescan the chat from its menu to reload them.")
   return
  src = ("artist", key)
  qname, qcover = a["n"], None
  self.lib_filter_label = None
  shown = self._lib_album_tabs(a, msgs, dupes, natural)
  dupe_info = self.lib_dupe_info
  if self.lib_filter_label:
   src = ("artist", key, self.lib_album_sel.get(key))
   qname = f"{a['n']}:{self.lib_filter_label}"[:60]
   qcover = shown[0] if shown else None
  self._lib_apply_filter_meta(shown)
  if self.lib_filter_label:
   self.lib_scope = {"state": ("artist", key), "shown": shown, "name": qname,
 "src": src, "cover": qcover, "label": self.lib_filter_label}
  self._lib_detail_actions(
 lambda: p._lib_play_msgs(shown, "play", name=qname, source_key=src, cover=qcover),
 lambda: p._lib_play_msgs(shown, "play", shuffle=True, name=qname, source_key=src, cover=qcover))
  def row_at(i):
   m = shown[i]
   return (m, None,
 lambda mm=m, idx=i: p._lib_play_msgs(
 shown, "play", start=p._msg_key(mm), name=qname,
 source_key=src, cover=qcover, _start_index=idx),
 lambda mm=m: self._lib_track_menu(mm))
  miss = int(getattr(self, "lib_album_missing", 0) or 0)
  def tail():
   if miss and self.lib_filter_label:
    self._lib_hint(f"{miss} song{'s' if miss != 1 else ''} missing from this album")
   if dupe_info:
    self._lib_dupes_card(dupe_info)
   if a.get("q") and len(msgs) <= 1:
    self._lib_hint("Add your favorite chats to library to find Artists")
  self._lib_render_track_rows(len(shown), row_at, tail=tail)
 def _lib_dupes_card(self, info):
  n = int(info["n"])
  noun = "track" if n == 1 else "tracks"
  album = bool(info.get("album"))
  if info["open"]:
   title = f"Showing {n} dupe {noun} from this album" if album else f"Showing {n} duplicate {noun}"
   sub = "Tap to hide them"
  else:
   title = f"{n} dupe {noun} from this album hidden" if album else f"{n} duplicate {noun} hidden"
   sub = "Tap to show them in list"
  def toggle():
   opened = self.__dict__.setdefault("lib_dupes_open", set())
   scope = info["scope"]
   if scope in opened:
    opened.discard(scope)
   else:
    opened.add(scope)
   try:
    y = int(self.lib_sv.getScrollY())
   except Exception:
    y = 0
   self._lib_render()
   try:
    self.handler.postDelayed(self.Run(lambda: self.lib_sv.scrollTo(0, y)), 30)
   except Exception:
    pass
  self._lib_row(title, sub, toggle, True, True, glyph="\u29c9",
 description=f"{title}. {sub}", top_margin_dp=12)
 _ALBUM_SINGLES = "\u0001singles"
 _ALBUM_OTHER = "\u0001other"
 @staticmethod
 def _album_norm(title, artist=""):
  t = str(title or "").casefold().strip()
  an = re.sub(r"[\W_]+", "", str(artist or "").casefold())
  if an and " - " in t:
   head, tail = t.split(" - ", 1)
   if re.sub(r"[\W_]+", "", head) == an:
    t = tail
  t = re.sub(r"\s*[\(\[][^\)\]]*\b(?:feat|ft|featuring|with|prod|explicit|remaster(?:ed)?|bonus)\b[^\)\]]*[\)\]]", "", t)
  t = re.sub(r"\s+-\s+(?:\d{4}\s+)?remaster(?:ed)?.*$", "", t)
  t = re.sub(r"\s+(?:feat|ft)\.?\s.*$", "", t)
  return re.sub(r"[\W_]+", "", t)
 def _lib_itunes_albums(self, a, want):
  import urllib.parse
  q_ = urllib.parse.quote
  name = str(a.get("n") or "").strip()
  first = re.split(r"\s*(?:,|&|/|;|\bfeat\.?|\bft\.?|\bwith\b)\s*", name, flags=re.I)[0].strip() or name
  nn = lambda t: re.sub(r"[\W_]+", "", str(t).casefold())
  reached = False
  songs = []
  def get(url):
   return json.loads(_http_text(url)).get("results") or []
  aid = None
  for q in dict.fromkeys(x for x in (name, first) if x):
   try:
    res = get("https://itunes.apple.com/search?media=music&entity=musicArtist&limit=5&term=" + q_(q))
    reached = True
   except Exception:
    continue
   hit = next((r for r in res if nn(r.get("artistName", "")) == nn(q)), None)
   if hit and hit.get("artistId"):
    aid = hit["artistId"]
    break
  if aid:
   try:
    res = get(f"https://itunes.apple.com/lookup?id={aid}&entity=song&limit=200")
    reached = True
    songs += [r for r in res if r.get("wrapperType") == "track"]
   except Exception:
    pass
  have = {self._album_norm(x.get("trackName"), name) for x in songs}
  for t, raw in [(t, r) for t, r in want.items() if t not in have][:60]:
   try:
    res = get("https://itunes.apple.com/search?media=music&entity=song&limit=10&term=" +
 q_(f"{first} {raw}"))
    reached = True
   except Exception:
    continue
   songs += [r for r in res if nn(first) and nn(first) in nn(r.get("artistName", ""))]
  if not reached:
   return None
  cands = {}
  for x in songs:
   t = self._album_norm(x.get("trackName"), name)
   cn = str(x.get("collectionName") or "").strip()
   if t in want and cn and x.get("collectionId"):
    cands.setdefault(t, {})[x["collectionId"]] = x
  def clean(n):
   n = re.sub(r"\s*[\(\[][^\)\]]*\b(?:deluxe|expanded|remaster(?:ed)?|international|bonus|"
 r"anniversary|special|edition|version)\b[^\)\]]*[\)\]]", "", n, flags=re.I)
   return re.sub(r"\s+", " ", n).strip() or n
  def rank(x):
   n = str(x.get("collectionName") or "")
   single = bool(re.search(r"-\s*(single|ep)\s*$", n, re.I))
   comp = bool(re.search(r"greatest hits|best of|\bhits\b|collection|compilation|essentials|"
 r"anthology|karaoke|tribute|\bsingles\b|playlist|sessions|b-sides|rarities",
 n, re.I))
   live = bool(re.search(r"\blive\b|unplugged|\bat the\b|in concert", n, re.I))
   tiny = int(x.get("trackCount") or 0) < 5
   return (comp, live, single, tiny, str(x.get("releaseDate") or "9999"), len(n))
  found = {}
  am, tn = a.setdefault("am", {}), a.setdefault("tn", {})
  for t, group in cands.items():
   best = min(group.values(), key=rank)
   cname = clean(str(best.get("collectionName")).strip())
   found[t] = cname
   try:
    if best.get("trackNumber"):
     tn[t] = [int(best.get("discNumber") or 1), int(best["trackNumber"])]
    e = am.setdefault(cname, {})
    art = best.get("artworkUrl100")
    if art and not e.get("art"):
     e["art"] = art.replace("100x100bb", "400x400bb")
    cnt = int(best.get("trackCount") or 0)
    if cnt and (not e.get("cnt") or cnt < e["cnt"]):
     e["cnt"] = cnt
   except Exception:
    pass
  return found
 def _lib_artist_albums(self, a, msgs):
  p = self.p
  if a.get("alv") != 3:
   a["al"], a["alv"], a["am"], a["tn"], a["nf"] = {}, 3, {}, {}, {}
   p.__dict__.setdefault("_album_tried", {}).pop(a["k"], None)
  cache = a.setdefault("al", {})
  titles = {}
  for m in msgs:
   titles[self._lib_key(m)] = (self._album_norm(self._title_of(m), a.get("n", "")), self._title_of(m))
  nf = a.setdefault("nf", {})
  now = time.time()
  tn = a.setdefault("tn", {})
  want = {t: raw for t, raw in titles.values()
 if t and (t not in cache or t not in tn) and now - nf.get(t, 0) > 2592000}
  k = a["k"]
  busy = p.__dict__.setdefault("_album_busy", set())
  tried = p.__dict__.setdefault("_album_tried", {}).setdefault(k, set())
  todo = {t: raw for t, raw in want.items() if t not in tried}
  if todo and k not in busy and p._net_ok():
   busy.add(k)
   tried.update(todo)
   def work():
    found = None
    try:
     found = self._lib_itunes_albums(a, todo)
    except Exception:
     pass
    def done():
     busy.discard(k)
     if found is not None:
      hit = {t: found[t] for t in todo if found.get(t)}
      for t in todo:
       if t not in tn:
        nf[t] = int(time.time())
      cache.update({t: v for t, v in hit.items() if t not in cache})
      p._lib_save()
     try:
      if self.dialog.isShowing() and self.lib_state == ("artist", k):
       self._lib_render()
     except Exception:
      pass
    run_on_ui_thread(done)
   threading.Thread(target=work, daemon=True).start()
  return {key: cache.get(t, "") for key, (t, _raw) in titles.items()}
 def _lib_album_tabs(self, a, msgs, dupes=(), natural=None):
  self.lib_album_missing = 0
  self.lib_dupe_info = None
  dupes = list(dupes or ())
  natural = list(natural or [])
  opened = self.__dict__.setdefault("lib_dupes_open", set())
  artist_name = a.get("n", "")
  def tkey_factory():
   tn = a.get("tn") or {}
   def tkey(m):
    v = tn.get(self._album_norm(self._title_of(m), artist_name))
    return (0, v[0], v[1]) if v else (1, 0, 0)
   return tkey
  def group_of(m):
   al = (a.get("al") or {}).get(self._album_norm(self._title_of(m), artist_name), "")
   if not al:
    return self._ALBUM_OTHER
   return self._ALBUM_SINGLES if al.lower().endswith("- single") else al
  def finish(sel, base, album_sorted=False):
   if not dupes:
    return base
   scope = (a["k"], sel)
   in_scope = [d for d in dupes if sel is None or group_of(d) == sel]
   if not in_scope:
    return base
   is_open = scope in opened
   self.lib_dupe_info = {"n": len(in_scope), "open": is_open, "scope": scope,
 "album": sel is not None and sel not in (self._ALBUM_SINGLES, self._ALBUM_OTHER)}
   if not is_open:
    return base
   full = [m for m in natural if sel is None or group_of(m) == sel]
   if album_sorted:
    full = sorted(full, key=tkey_factory())
   return full
  try:
   albums = self._lib_artist_albums(a, msgs)
   groups, order = {}, []
   for m in msgs:
    al = albums.get(self._lib_key(m), "")
    g = (self._ALBUM_SINGLES if al.lower().endswith("- single") else al) if al else self._ALBUM_OTHER
    if g not in groups:
     order.append(g)
    groups.setdefault(g, []).append(m)
   real = [g for g in order if g not in (self._ALBUM_SINGLES, self._ALBUM_OTHER)]
   if not real or len(groups) < 2:
    return finish(None, msgs)
   real.sort(key=lambda g: -len(groups[g]))
   tail = [g for g in (self._ALBUM_SINGLES, self._ALBUM_OTHER) if g in groups]
   chips = [None] + real + tail
   sel_map = self.__dict__.setdefault("lib_album_sel", {})
   sel = sel_map.get(a["k"])
   if sel is not None and sel not in groups:
    sel = None
    sel_map.pop(a["k"], None)
   def pick(i):
    if chips[i] is None:
     sel_map.pop(a["k"], None)
    else:
     sel_map[a["k"]] = chips[i]
    self._lib_render()
   def chip(g):
    if g is None:
     return {"title": "All", "lead": None}
    title = ("Singles" if g == self._ALBUM_SINGLES
 else "Other" if g == self._ALBUM_OTHER else g)
    return {"title": title, "pad_l": 6, "max_w": 180, "lead_size": (self.dp(24), self.dp(24)),
 "lead_gap": 7,
 "lead": lambda sv, g=g: self._album_lead(a, g, groups[g][0], sv)}
   self._chip_row(("album", a["k"]), [chip(g) for g in chips],
 chips.index(sel), pick)
   if sel is not None:
    self.lib_filter_label = ("Singles" if sel == self._ALBUM_SINGLES
 else "Other" if sel == self._ALBUM_OTHER else sel)
   if sel is None:
    return finish(None, msgs)
   out = groups[sel]
   album_sorted = False
   if sel not in (self._ALBUM_SINGLES, self._ALBUM_OTHER):
    out = sorted(out, key=tkey_factory())
    album_sorted = True
    cnt = int(((a.get("am") or {}).get(sel) or {}).get("cnt") or 0)
    self.lib_album_missing = max(0, cnt - len(out)) if cnt else 0
   return finish(sel, out, album_sorted)
  except Exception:
   return msgs
 def _album_lead(self, a, album, first_msg, row):
  try:
   if self.p.get_setting("album_cover_itunes", False):
    url = ((a.get("am") or {}).get(album) or {}).get("art")
    if url:
     return self._album_itunes_cover_view(url)
  except Exception:
   pass
  return self._album_cover_view(first_msg, row=row)
 def _album_itunes_cover_view(self, url, radius_dp=5, glyph_sp=11):
  FL = _cls("android.widget.FrameLayout")
  FLP = _cls("android.widget.FrameLayout$LayoutParams")
  GD = _cls("android.graphics.drawable.GradientDrawable")
  cover = FL(self.act)
  cbg = GD()
  cbg.setColor(_mix(self.c_item, self.c_sub, 0.15))
  cbg.setCornerRadius(float(self.dp(radius_dp)))
  cover.setBackground(cbg)
  try:
   cover.setClipToOutline(True)
  except Exception:
   pass
  glyph = self._text("\u266a", glyph_sp, self.c_sub, gravity=17)
  cover.addView(glyph, FLP(-1, -1))
  iv = _cls("android.widget.ImageView")(self.act)
  iv.setScaleType(_cls("android.widget.ImageView$ScaleType").CENTER_CROP)
  cover.addView(iv, FLP(-1, -1))
  cache = self.p.__dict__.setdefault("_album_bmp", {})
  bmp = cache.get(url)
  if bmp is not None:
   iv.setImageBitmap(bmp)
   glyph.setVisibility(8)
   return cover
  def work():
   import os, hashlib
   try:
    BF = _cls("android.graphics.BitmapFactory")
    ctx = find_class("org.telegram.messenger.ApplicationLoader").applicationContext
    folder = os.path.join(str(ctx.getCacheDir().getAbsolutePath()), "smq_albums")
    os.makedirs(folder, exist_ok=True)
    path = os.path.join(folder, hashlib.md5(url.encode("utf-8")).hexdigest() + ".jpg")
    image = BF.decodeFile(path) if os.path.exists(path) else None
    if image is None:
     stream = _http_stream(url)
     try:
      image = BF.decodeStream(stream)
     finally:
      stream.close()
     if image is None:
      return
     try:
      fos = jclass("java.io.FileOutputStream")(path)
      image.compress(_cls("android.graphics.Bitmap$CompressFormat").JPEG, 85, fos)
      fos.close()
     except Exception:
      pass
    scaled = _cls("android.graphics.Bitmap").createScaledBitmap(image, 160, 160, True)
    cache[url] = scaled
    def show():
     try:
      iv.setImageBitmap(scaled)
      glyph.setVisibility(8)
     except Exception:
      pass
    run_on_ui_thread(show)
   except Exception:
    pass
  threading.Thread(target=work, daemon=True).start()
  return cover
 def _lib_artist_menu(self, key):
  p, act = self.p, self.act
  artist = next((x for x in self._lib_artist_data()["list"] if x["k"] == key), None)
  if artist is None:
   self._lib_go("home")
   return
  name = str(artist.get("n", "Artist"))
  sc = self._lib_scope(("artist", key))
  msgs = [m for m in (sc["shown"] if sc else self._lib_artist_msgs(key)) if m is not None]
  qname, qsrc, qcover = (sc["name"], sc["src"], sc["cover"]) if sc else (name, ("artist", key), None)
  meta = self._lib_tracks_meta(len(msgs), self._lib_message_minutes(msgs)) if msgs else "No cached tracks"
  if sc and msgs:
   meta = f"{sc['label']} · {meta}"
  def guarded(fn):
   def run():
    if msgs:
     fn()
    else:
     p._bulletin("No cached tracks for this artist", error=True)
   return run
  play_next = guarded(lambda: p._lib_play_msgs(msgs, "next", name=qname, source_key=qsrc, cover=qcover))
  add_to = guarded(lambda: p._lib_add_to_sheet(
 act, lambda cb: cb(list(msgs)), sc["label"] if sc else name, f"{len(msgs)} tracks"))
  save_to_music = guarded(lambda: p._save_to_music(msgs))
  exclude_from_queue = guarded(lambda: p._exclude_from_queue(msgs, sc["label"] if sc else name))
  def select_tracks():
   if self.lib_state != ("artist", key):
    self._lib_go("artist", key)
   self._lib_select_all_menu()
  pinned = key in self._lib_pinned_artists()
  extras = [("Unpin artist" if pinned else "Pin artist",
 "Remove from the top of Artists" if pinned else "Always show at the top of Artists",
 False, lambda: self._lib_toggle_pin_artist(key, name))]
  if msgs:
   extras += [
 ("Save to Music", "Download and save all tracks", False, save_to_music),
 ("Set as profile playlist", "Use this artist's tracks as your profile music", False,
 lambda: p._profile_playlist_sheet(
 act, name, lambda cb: cb(list(msgs)), len(msgs)))]
  p._collection_sheet(
 act, name, meta, play_next, add_to,
 select=select_tracks if msgs else None,
 exclude=exclude_from_queue if msgs else None,
 extras=extras,
 danger=[("Remove from library",
 "Change this later in the Excluded Artists list in plugin settings",
 True, lambda: self._lib_exclude_artist(key, name))],
 artist_search=name)
 def _lib_chat_info(self, c):
  cached = self.p._chat_track_cache.get((c["d"], c["t"]))
  acc = self._lib_chat_account(c, cached)
  sub = (self._lib_tracks_meta(len(cached), self._lib_message_minutes(cached))
 if cached is not None else (self._lib_cached_meta(c) or self._lib_chat_kind(c, acc)))
  return acc, sub
 def _lib_chat_row(self, c, first, last):
  acc, sub = self._lib_chat_info(c)
  self._lib_row(c["n"], sub, (lambda k=(c["d"], c["t"]): self._lib_go("chat", k)),
 first, last, glyph="#", avatar_did=int(c["d"]), avatar_acc=acc,
 reorder_type="chats", reorder_id=(int(c["d"]), int(c["t"])),
 type_icons=self._TYPE_ICONS.get(self._lib_chat_kind(c, acc)))
 def _lib_chat_card(self, c, grid_row):
  acc, sub = self._lib_chat_info(c)
  self._lib_round_card(
 grid_row, lambda size: self._lib_avatar_tile(int(c["d"]), acc, size),
 c["n"], sub, lambda k=(c["d"], c["t"]): self._lib_go("chat", k), "Chat: ",
 reorder_type="chats", reorder_id=(int(c["d"]), int(c["t"])))
 def _lib_friend_info(self, friend):
  uid = int(friend.get("d", friend.get("id", 0)) or 0)
  acc = int(friend.get("a", 0) or 0)
  cached = self.p._friend_track_cache.get((acc, uid))
  sub = (self._lib_tracks_meta(len(cached), self._lib_message_minutes(cached))
 if cached is not None else
 (self._lib_cached_meta(friend) or "Profile playlist · tap to load"))
  return uid, acc, sub
 def _lib_friend_row(self, friend, first, last):
  uid, acc, sub = self._lib_friend_info(friend)
  self._lib_row(friend.get("n", "Profile"), sub, (lambda user_id=uid: self._lib_go("friend", user_id)),
 first, last, glyph="♫", avatar_did=uid, avatar_acc=acc,
 reorder_type="friends", reorder_id=uid,
 description="Friend profile playlist: " + str(friend.get("n", "Profile")))
 def _lib_friend_card(self, friend, grid_row):
  uid, acc, sub = self._lib_friend_info(friend)
  self._lib_round_card(
 grid_row, lambda size: self._lib_avatar_tile(uid, acc, size),
 friend.get("n", "Profile"), sub,
 lambda user_id=uid: self._lib_go("friend", user_id), "Friend: ",
 reorder_type="friends", reorder_id=uid)
 def _lib_search_results(self):
  p = self.p
  d = p._lib_data()
  query = str(self.lib_search_query or "").strip().casefold()
  if not query:
   self._lib_home()
   return
  self._lib_set_selection_context(("search",))
  contains = lambda value: query in str(value or "").casefold()
  artists = [a for a in self._lib_artist_data().get("list", [])
 if contains(a.get("n"))]
  playlists = [pl for pl in d.get("playlists", []) if contains(pl.get("name"))]
  chats = [c for c in d.get("chats", []) if contains(c.get("n"))]
  friends = [f for f in d.get("friends", []) if contains(f.get("n"))]
  track_hits = []
  track_seen = set()
  library_chat_keys = set()
  for c in d.get("chats", []):
   try:
    library_chat_keys.add((int(c.get("d", 0)), int(c.get("t", 0))))
   except Exception:
    pass
  def add_message_track(message):
   if message is None:
    return
   try:
    title = self._title_of(message)
    artist = self._author_of(message)
    if not contains(title):
     return
    key = self._lib_key(message)
    if key is not None and key in track_seen:
     return
    if key is not None:
     track_seen.add(key)
    track_hits.append({
 "title": title, "artist": artist, "message": message,
 "key": key, "playlist_id": None
 })
   except Exception:
    pass
  cache = getattr(p, "_chat_track_cache", {}) or {}
  for chat_key in library_chat_keys:
   if len(track_hits) >= 30:
    break
   msgs = cache.get(chat_key, []) or []
   rows = getattr(msgs, "rows", None)
   if rows is not None:
    for n, r in enumerate(rows):
     if contains(str(r.get("t") or "")):
      add_message_track(msgs[n])
      if len(track_hits) >= 30:
       break
   else:
    for message in msgs:
     add_message_track(message)
  for pl in d.get("playlists", []):
   for track in pl.get("tracks", []) or []:
    title = str(track.get("t", "") or "")
    artist = str(track.get("a", "") or "")
    if not contains(title):
     continue
    try:
     key = (int(track.get("i", 0)), int(track.get("d", 0)))
    except Exception:
     key = None
    if key is not None and key in track_seen:
     continue
    if key is not None:
     track_seen.add(key)
    track_hits.append({
 "title": title or "Audio", "artist": artist,
 "message": p._msg_cache.get(key) if key is not None else None,
 "key": key, "playlist_id": pl.get("id"), "track": track
 })
  track_hits = track_hits[:30]
  total = len(artists) + len(playlists) + len(chats) + len(friends) + len(track_hits)
  self._lib_label("Search results", f"{total} match{'es' if total != 1 else ''}")
  if not total:
   self._lib_hint(f"No results for “{self.lib_search_query.strip()}”. Try an artist, track, playlist, chat, or friend.")
   return
  def add_section(title, entries, count_text=None):
   if not entries:
    return
   self._lib_label(title, count_text or str(len(entries)))
   for i, entry in enumerate(entries):
    yield i, entry
  for i, artist in add_section("Artists", artists):
   key = str(artist.get("k", "")).casefold()
   name = str(artist.get("n", "Artist"))
   self._lib_row(
 name, f"{int(artist.get('c', 0) or 0)} track{'s' if int(artist.get('c', 0) or 0) != 1 else ''}",
 lambda k=key: self._lib_go("artist", k), i == 0, i == len(artists) - 1,
 tile_fn=lambda cd, a=artist: self._lib_artist_photo(a, cd),
 description="Artist: " + name)
  for i, playlist in add_section("Playlists", playlists):
   tracks = playlist.get("tracks", []) or []
   self._lib_row(
 str(playlist.get("name", "Playlist")),
 self._lib_tracks_meta(len(tracks), p._lib_minutes(tracks)),
 lambda pid=playlist.get("id"): self._lib_go("pl", pid),
 i == 0, i == len(playlists) - 1,
 cover_ms=self._lib_playlist_cover_messages(tracks),
 description="Playlist: " + str(playlist.get("name", "Playlist")))
  for i, entry in add_section("Tracks", track_hits):
   message = entry.get("message")
   playlist_id = entry.get("playlist_id")
   track = entry.get("track")
   if message is not None:
    callback = lambda m=message: p._lib_play_msgs([m], "play")
   elif playlist_id is not None:
    callback = lambda pid=playlist_id: self._lib_go("pl", pid)
   else:
    callback = lambda: None
   if message is None and track is None:
    track = {"t": entry.get("title") or "Audio"}
   self._lib_track_row(
 message, track, callback,
 lambda m=message, t=track, pid=playlist_id: self._lib_track_menu(m, t, pid, selectable=False),
 i == 0, i == len(track_hits) - 1, selectable=False)
  for i, chat in add_section("Chats", chats):
   self._lib_chat_row(chat, i == 0, i == len(chats) - 1)
  for i, friend in add_section("Friends", friends):
   self._lib_friend_row(friend, i == 0, i == len(friends) - 1)
  if len(track_hits) >= 30:
   self._lib_hint("Showing the first 30 track matches.")
 def _lib_home(self):
  p = self.p
  d = p._lib_data()
  def playlists():
   pls = d.get("playlists", [])
   self._lib_section(
 "playlists", "Playlists", pls,
 lambda pl, first, last: self._lib_playlist_entry_row(pl, first, last),
 lambda pl, row: self._lib_playlist_entry_card(pl, row),
 sort=self._lib_playlist_list_sort_menu, sort_desc="Sort playlists")
   self._lib_prefetch_covers(pls)
   if not pls:
    self._lib_hint("No playlists yet. Use Add to from a track, chat, or the Queue menu to create one.")
  def chats():
   entries = d.get("chats", [])
   self._lib_section("chats", "Chats", entries, self._lib_chat_row, self._lib_chat_card)
   if not entries:
    self._lib_hint("Add a chat from its Music + menu: Add chat to Library.")
  def friends():
   entries = d.get("friends", [])
   self._lib_section("friends", "Friends", entries, self._lib_friend_row, self._lib_friend_card)
   if not entries:
    self._lib_hint("Add a user from their Music + menu : Add as friend")
  section_builders = {
 "playlists": playlists,
 "chats": chats,
 "friends": friends,
 "artists": self._lib_artists_section,
 }
  for section in p._library_section_order():
   section_builders[section]()
 def _lib_remove_track(self, pid, t):
  pl = self.p._lib_pl(pid)
  if pl is not None and t in pl["tracks"]:
   pl["tracks"].remove(t)
   self.p._lib_save()
   self._lib_render()
 def _lib_track_menu(self, m, t=None, pid=None, selectable=True):
  p, act = self.p, self.act
  track_key = self._lib_key(m, t)
  if m is None:
   if pid:
    self._lib_remove_track(pid, t)
    p._bulletin("Removed the unavailable track")
   return
  hero = [("Play next", lambda: p._lib_play_msgs([m], "next", keep_order=False), False),
 p._hero_add_to(act, m)]
  if selectable:
   hero.append(("Select", lambda: self._lib_begin_selection(track_key), False))
  if pid:
   hero.append(("Remove", lambda: self._lib_remove_track(pid, t), True))
  p._track_sheet(act, m, hero, editor=self)
 def _lib_reverse_playlist(self, pid):
  pl = self.p._lib_pl(pid)
  if pl is None:
   return
  pl["tracks"].reverse()
  self.p._lib_save()
  self._lib_render()
  self.p._bulletin("Reversed playlist order")
 def _lib_sort_playlist(self, pid, mode):
  pl = self.p._lib_pl(pid)
  if pl is None:
   return
  tracks = pl["tracks"]
  descending = mode.endswith("_desc")
  base = mode[:-5] if descending else mode
  if base == "title":
   tracks.sort(key=lambda t: (str(t.get("t", "")).lower(), str(t.get("a", "")).lower()), reverse=descending)
   label = "title Z–A" if descending else "title A–Z"
  elif base == "artist":
   tracks.sort(key=lambda t: (str(t.get("a", "")).lower(), str(t.get("t", "")).lower()), reverse=descending)
   label = "artist Z–A" if descending else "artist A–Z"
  elif base == "duration":
   tracks.sort(key=lambda t: int(t.get("s", 0)), reverse=descending)
   label = "longest first" if descending else "shortest first"
  else:
   self._lib_reverse_playlist(pid)
   return
  self.p._lib_save()
  self._lib_render()
  self.p._bulletin(f"Sorted by {label}")
 def _lib_playlist_sort_menu(self, pid):
  pl = self.p._lib_pl(pid)
  if pl is None:
   return
  self._lib_sort_sheet(
 "Sort playlist", pl["name"],
 [("title", "Title", "Track title"),
 ("artist", "Artist", "Artist name"),
 ("duration", "Duration", "Track length")],
 lambda mode, desc: self._lib_sort_playlist(pid, mode + ("_desc" if desc else "")),
 desc=False,
 extra=[("Reverse order", "Reverse the current track order", False,
 lambda: self._lib_reverse_playlist(pid))])
 def _lib_playlist_menu(self, pid):
  p, act = self.p, self.act
  pl = p._lib_pl(pid)
  if pl is None:
   self._lib_go("home")
   return
  tracks = pl["tracks"]
  name = pl["name"]
  meta = self._lib_tracks_meta(len(tracks), p._lib_minutes(tracks))
  def rename():
   def save(text):
    if text:
     p._lib_rename(pid, text)
    self.lib_confirm = None
    self._lib_render()
   self._prompt_text("Rename playlist", name, "Playlist name", save)
  def delete():
   d = p._lib_data()
   snap = (list(d["playlists"]), d.get("last"))
   p._lib_delete(pid)
   self._lib_go("home")
   self._lib_undo_list("playlists", snap, f"Deleted “{name}”")
  p._collection_sheet(
 act, name, meta,
 lambda: p._lib_play(act, tracks, "next", name=name),
 lambda: p._lib_add_to_sheet(
 act, (lambda cb: cb(tracks)), name, f"{len(tracks)} tracks", exclude=pid),
 select=lambda: self._lib_select_all_menu(),
 exclude=lambda: p._exclude_from_queue(self._lib_known(tracks), name),
 extras=[
 ("Sort tracks", "Sort by title, artist, duration, or reverse", False,
 lambda: self._lib_playlist_sort_menu(pid)),
 ("Rename playlist", "Change the playlist name", False, rename),
 ("Set as profile playlist", "Use this playlist as your profile music", False,
 lambda: p._profile_playlist_sheet(
 act, name, lambda cb: p._lib_resolve(act, tracks, cb), len(tracks)))],
 danger=[("Delete playlist", "", True, delete)])
 def _lib_playlist_view(self, pid):
  p = self.p
  pl = p._lib_pl(pid)
  if pl is None:
   self._lib_go("home")
   return
  p._lib_data()["last"] = pid
  self._lib_set_selection_context(("pl", pid))
  tracks = pl["tracks"]
  name = pl["name"]
  act = self.act
  meta = self._lib_tracks_meta(len(tracks), p._lib_minutes(tracks))
  self._lib_detail_header(name, meta,
 lambda: self._lib_go("home"),
 lambda: self._lib_playlist_menu(pid))
  self._lib_detail_actions(
 lambda: p._lib_play(act, tracks, "play", name=name, source_key=("playlist", pid)),
 lambda: p._lib_play(act, tracks, "play", shuffle=True, name=name, source_key=("playlist", pid)),
 )
  msgs = self._lib_known(tracks)
  need = [i for i, m in enumerate(msgs)
 if m is None and (tracks[i]["i"], tracks[i]["d"]) not in p._msg_missing]
  if need and pid not in self.lib_resolved:
   self.lib_resolved.add(pid)
   def done(_res):
    if self.lib_state == ("pl", pid):
     self._lib_render()
   self.handler.post(self.Run(lambda: p._lib_resolve(act, tracks, done)))
  if not tracks:
   self._lib_hint("This playlist is empty. Use Add to from a chat or another playlist.")
  def row_at(i):
   t, m = tracks[i], msgs[i]
   if m is None:
    on_click = lambda: p._bulletin("That message was deleted or is too old to load", error=True)
   else:
    on_click = lambda tt=t: p._lib_play(
 act, tracks, "play", start=(tt["i"], tt["d"]), name=name, source_key=("playlist", pid))
   on_more = lambda mm=m, tt=t: self._lib_track_menu(mm, tt, pid)
   return m, t, on_click, on_more
  self._lib_render_track_rows(len(tracks), row_at, playlist_id=pid)
 def _lib_fetch_chat_tracks(self, key, act, callback=None, since_id=0, force=False, on_batch=None):
  p = self.p
  key = tuple(key)
  cached = p._chat_track_cache.get(key)
  if cached is not None and not force:
   if callback is not None:
    callback(cached)
   return
  if callback is not None:
   self.lib_waiters.setdefault(key, []).append(callback)
  bb = self.__dict__.setdefault("_lib_bb", {})
  if on_batch is not None:
   cbs, buf = bb.setdefault(key, ([], []))
   cbs.append(on_batch)
   for b in list(buf):
    try:
     on_batch(*b)
    except Exception:
     pass
  if key in self.lib_loading:
   return
  chat = next((c for c in p._lib_data()["chats"] if (c["d"], c["t"]) == key), None)
  if chat is None:
   for fn in self.lib_waiters.pop(key, []):
    fn([])
   return
  self.lib_loading.add(key)
  def publish_ready(used):
   self.lib_loading.discard(key)
   bb.pop(key, None)
   done_stream = self.lib_streams.get(key)
   if done_stream is not None:
    self._lib_follow_merge(done_stream, True)
   p._chat_track_cache[key] = used
   self.__dict__.setdefault("_lib_topic_groups", {}).pop(key, None)
   self.lib_streams.pop(key, None)
   p._activity_status(("chat_stream", key), None)
   p.__dict__.setdefault("_lib_fresh", {})[("c",) + key] = time.time()
   if used and not self.__dict__.get("_artist_scanning"):
    p._artist_dirty = True
    self._lib_artist_auto()
   if used:
    if len(used) >= 128:
     self._lib_store_counts_async(chat, used, ("chat", key))
    else:
     self._lib_store_counts(chat, used)
   p._request_library_refresh()
   for fn in self.lib_waiters.pop(key, []):
    try:
     fn(used)
    except Exception:
     pass
   if self.lib_state == ("chat", key):
    self._lib_render()
  def ready(used):
   if not since_id:
    publish_ready(used)
    return
   def merge_incremental():
    merged = None
    try:
     old = p._chat_track_cache.revive(key)
     if old is not None and getattr(old, "rows", None) is not None:
      if used:
       try:
        acc = int(old._idx.acc)
       except Exception:
        acc = int(used[0].currentAccount)
       nidx = p._tstore.append(key, used, acc)
       if nidx is not None:
        merged = _LazyTracks(p._chat_track_cache, key, idx=nidx)
      else:
       merged = old
     elif old is not None and getattr(old, "_objs", None) is not None:
      combined = list(used or []) + list(old._objs or [])
      by_key = {}
      for item in combined:
       try:
        by_key[(int(item.getId()), int(item.getDialogId()))] = item
       except Exception:
        pass
      merged = sorted(by_key.values(), key=lambda m: -int(m.getId()))
    except Exception:
     pass
    if merged is None:
     try:
      run_on_ui_thread(failed)
     except Exception:
      failed()
     return
    def commit():
     publish_ready(merged)
    try:
     run_on_ui_thread(commit)
    except Exception:
     commit()
   threading.Thread(target=merge_incremental, daemon=True,
 name="smq-incremental-chat-merge").start()
  def failed():
   self.lib_loading.discard(key)
   bb.pop(key, None)
   self.lib_streams.pop(key, None)
   p._activity_status(("chat_stream", key), None)
   stale = None
   try:
    stale = p._chat_track_cache.revive(key)
   except Exception:
    pass
   for fn in self.lib_waiters.pop(key, []):
    try:
     fn(stale if stale is not None else [])
    except Exception:
     pass
   if stale is not None and self.lib_state == ("chat", key):
    self._lib_render()
  def batches(batch, count, total):
   cbs, buf = bb.setdefault(key, ([], []))
   buf.append((batch, count, total))
   for cb in list(cbs):
    try:
     cb(batch, count, total)
    except Exception:
     pass
  self.handler.post(self.Run(lambda: p._fetch_scope_tracks(
 None, chat["d"], chat["t"], [], ready, act, on_fail=failed,
 since_id=since_id, on_batch=batches, silent=True)))
 def _lib_stream_begin(self, key, base=None, mode="initial", known_ids=None):
  key = tuple(key)
  tail = []
  known = set(known_ids or ())
  if known_ids is None:
   rows = getattr(base, "rows", None) if base is not None else None
   if rows is not None:
    try:
     known = set(int(r.get("i", 0) or 0) for r in rows)
    except Exception:
     known = set()
   elif base is not None and mode != "rescan":
    objs = getattr(base, "_objs", None)
    if objs is not None:
     try:
      known = set(int(m.getId()) for m in objs if m is not None)
     except Exception:
      known = set()
  display = _ProgressiveChatTracks(base if base is not None else [], tail)
  stream = {"base": base if base is not None else [], "tail": tail,
 "display": display, "known": known, "mode": mode, "count": 0}
  self.lib_streams[key] = stream
  return stream
 def _lib_follow_stream(self, key, src):
  st = self.lib_streams.get(tuple(key))
  if st is not None:
   st["follow"] = {"src": src, "idx": len(st["tail"]), "state": {"keys": None, "desc": None}}
 def _lib_follow_merge(self, stream, final=False):
  fol = stream.get("follow")
  if fol is None:
   return
  p = self.p
  if getattr(p, "_queue_scope_key", None) != fol["src"]:
   stream["follow"] = None
   return
  if p.__dict__.get("_queue_build_state") is not None:
   return
  items = stream["tail"][fol["idx"]:]
  fol["idx"] = len(stream["tail"])
  try:
   p._queue_insert_sorted(items, fol["state"], final)
  except Exception:
   pass
 def _lib_stream_meta_text(self, stream):
  n = len(stream["display"])
  if stream["mode"] == "rescan":
   return f"{n:,} tracks \u00b7 Rescanning\u2026"
  if n <= 0:
   return "Loading tracks\u2026"
  total = int(stream.get("total", 0) or 0)
  if total >= n:
   return f"{n:,} of {total:,} tracks loaded"
  return f"{n:,} tracks loaded"
 def _lib_stream_batch(self, key, batch, count=0, total=0):
  key = tuple(key)
  stream = self.lib_streams.get(key)
  if stream is None:
   return
  added = 0
  for m in batch or []:
   try:
    mid = int(m.getId())
   except Exception:
    continue
   if mid in stream["known"]:
    continue
   stream["known"].add(mid)
   stream["tail"].append(m)
   k = self.p._msg_key(m)
   if k:
    self.p._msg_cache[k] = m
   added += 1
  if added:
   self._lib_follow_merge(stream)
  stream["count"] = int(count or stream["count"])
  try:
   stream["total"] = max(int(stream.get("total", 0) or 0), int(total or 0))
  except Exception:
   pass
  if self.__dict__.get("_lib_replay"):
   return
  viewing = self.tab == "library" and self.lib_state == ("chat", key)
  if viewing:
   self.p._activity_status(("chat_stream", key), None)
  else:
   visible_n = len(stream["tail"])
   self.p._activity_status(("chat_stream", key),
 (f"Rescanning chat · {visible_n} new tracks found" if stream["mode"] == "rescan"
 else f"Loading chat · {visible_n} tracks loaded"))
  if not added or not viewing:
   return
  loader = self.lib_track_loader
  if loader is not None and loader.get("context") == self.lib_state:
   loader["count"] = len(stream["display"])
   self.handler.postDelayed(self.Run(self._lib_maybe_load_more), 30)
   try:
    meta = self._lib_stream_meta_text(stream)
    self.lib_detail_base_meta = meta
    if self.lib_detail_meta is not None and not self.lib_sel_mode:
     self.lib_detail_meta.setText(meta)
   except Exception:
    pass
  else:
   self._lib_render()
 def _lib_chat_menu(self, key):
  p, act = self.p, self.act
  key = tuple(key)
  chat = next((c for c in p._lib_data()["chats"] if (c["d"], c["t"]) == key), None)
  if chat is None:
   self._lib_go("home")
   return
  msgs = p._chat_track_cache.get(key)
  if msgs is None:
   meta = "Loading tracks…"
  else:
   cached_meta = self._lib_cached_meta(chat)
   if cached_meta is not None:
    meta = cached_meta
   elif len(msgs) >= 128:
    meta = self._lib_tracks_meta(len(msgs), 0)
   else:
    meta = self._lib_tracks_meta(len(msgs), self._lib_message_minutes(msgs))
  sc = self._lib_scope(("chat", key))
  def scoped():
   return [m for m in sc["shown"] if m is not None]
  if sc:
   items = scoped()
   meta = f"{sc['label']} · " + self._lib_tracks_meta(len(items), self._lib_message_minutes(items))
  def play_next():
   if sc:
    p._lib_play_msgs(scoped(), "next", name=sc["name"], source_key=sc["src"])
    return
   self._lib_fetch_chat_tracks(key, act, lambda found: p._lib_play_msgs(
 found, "next", name=chat["n"]))
  def add_to():
   if sc:
    p._lib_add_to_sheet(act, lambda cb: cb(scoped()), sc["label"], sc["label"])
    return
   self._lib_add_chat_items_to_sheet(key, chat, act)
  def rescan(full=False):
   old = p._chat_track_cache.get(key)
   before = len(old) if old is not None else 0
   prep_key = ("chat_rescan_prep", key)
   p._activity_status(prep_key, "Preparing chat rescan…")
   p._bulletin("Checking for new music…" if not full and old is not None else "Rescanning…")
   def prepare():
    since = 0
    known_ids = set()
    try:
     rows = getattr(old, "rows", None) if old is not None else None
     if rows is not None:
      known_ids = set(int(r.get("i", 0) or 0) for r in rows)
      if not full and p._tstore.enabled() and known_ids:
       since = max(known_ids)
     else:
      objs = getattr(old, "_objs", None) if old is not None else None
      if objs is not None:
       known_ids = set()
       top = 0
       for message in objs:
        try:
         mid = int(message.getId())
         known_ids.add(mid)
         top = max(top, mid)
        except Exception:
         pass
       if not full and p._tstore.enabled():
        since = top
    except Exception:
     since = 0
    def start_fetch():
     p._activity_status(prep_key, None)
     self._lib_stream_begin(
 key, base=old if old is not None else [], mode="rescan",
 known_ids=known_ids)
     if self.tab == "library" and self.lib_state == ("chat", key):
      self._lib_render()
     def finished(found):
      try:
       n = len(found) if found is not None else 0
       if not since:
        p._bulletin(f"{n} track{'s' if n != 1 else ''} loaded")
       elif n > before:
        d = n - before
        p._bulletin(f"{d} new track{'s' if d != 1 else ''} found")
       else:
        p._bulletin("No new music")
      except Exception:
       pass
     self._lib_fetch_chat_tracks(
 key, act, finished, since_id=since, force=True,
 on_batch=lambda batch, count, total: self._lib_stream_batch(
 key, batch, count, total))
    try:
     run_on_ui_thread(start_fetch)
    except Exception:
     start_fetch()
   threading.Thread(target=prepare, daemon=True, name="smq-chat-rescan-plan").start()
  def remove():
   d = p._lib_data()
   snap = (list(d["chats"]), None)
   p._lib_remove_chat(chat["d"], chat["t"])
   self._lib_go("home")
   self._lib_undo_list("chats", snap, f"Removed “{chat['n']}”")
  p._collection_sheet(
 act, chat["n"], meta, play_next, add_to,
 select=lambda: self._lib_select_all_menu(),
 exclude=lambda: p._exclude_from_queue(scoped() if sc else msgs, sc["label"] if sc else chat["n"]),
 extras=[
 ("Rescan this chat", "Checks for new songs. Hold for full rescan", False, rescan, "", None,
 lambda: rescan(True)),
 ("Set as profile playlist", "Use this chat's music as your profile music", False,
 lambda: p._profile_playlist_sheet(
 act, sc["label"] if sc else chat["n"],
 (lambda cb: cb(scoped())) if sc else (lambda cb: self._lib_fetch_chat_tracks(key, act, cb)),
 len(scoped()) if sc else len(msgs) if msgs is not None else None))],
 danger=[("Remove from Library", "This only removes the saved shortcut", True, remove)],
 header_action=(("msg_viewintopic", "msg_openin", "msg_profile"),
 "Open chat", lambda: p._open_chat_scope(chat["d"], sc["topic"] if sc else chat["t"]), "↗"))
 def _lib_add_chat_items_to_sheet(self, key, chat, act):
