 def _load(self) -> bool:
  mc = self.p._get_mc()
  pl = self.p._get_playlist(mc) if mc is not None else None
  if pl is None or pl.size() == 0:
   self.row_meta_cache, self.dl_cache = {}, {}
   c = self.p._qcache_get()
   if c is not None:
    self.ghost = True
    self.reversed = bool(c["reversed"])
    raw = list(c["items"])
    self.items = raw if self.reversed else raw[::-1]
    self.keys = [self._key(m) for m in self.items]
    self._rebuild_key_index()
    self.playing_key = c["playing_key"]
    self.pl_size = 0
    return True
   self.ghost = False
   self.items, self.keys, self.key_index = [], [], {}
   self.playing_key, self.pl_size, self.reversed = None, 0, False
   return False
  self.ghost = False
  shuffle_on, rev = self.p._read_order()
  self.reversed = bool(rev and not shuffle_on)
  raw = [pl.get(i) for i in range(pl.size())]
  self.items = raw if self.reversed else raw[::-1]
  self.row_meta_cache = {}
  playing = None
  try:
   playing = mc.getPlayingMessageObject()
  except Exception:
   pass
  self.playing_key = self._key(playing) if playing is not None else None
  self.keys = [self._key(m) for m in self.items]
  self._rebuild_key_index()
  self.dl_cache = {}
  self.pl_size = int(pl.size())
  try:
   self.p._qcache_snapshot()
  except Exception:
   pass
  return True
 def _rebuild_key_index(self):
  index = {}
