   return True
  g = getattr(self, "_gr", None)
  if g is None:
   return False
  if a == 2:
   dy = ry - g["ly"]
   g["v"] = 0.5 * g["v"] + 0.5 * dy / max(1, t - g["t"]) * 1000.0
   g["ly"], g["t"] = ry, t
