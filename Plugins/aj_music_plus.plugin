 except Exception:
  return []
_WCB = None
def _http_stream(url):
 conn = jclass("java.net.URL")(url).openConnection()
 conn.setConnectTimeout(8000)
 conn.setReadTimeout(8000)
 conn.setRequestProperty("User-Agent", "Mozilla/5.0")
 return conn.getInputStream()
def _http_text(url):
 stream = _http_stream(url)
 try:
  sc = jclass("java.util.Scanner")(stream, "UTF-8").useDelimiter("\\A")
  return str(sc.next()) if sc.hasNext() else ""
 finally:
  stream.close()
_LYR_KEY = "".join(random.choice("0123456789abcdef") for _ in range(32))
_LYR_RANK = {"word": 3, "line": 2, "plain": 1}
def _lyr_time(s):
 s = (s or "").strip()
 if not s:
  return None
 try:
  if s.endswith("ms"):
   return int(float(s[:-2]))
  if s.endswith("s"):
   return int(float(s[:-1]) * 1000)
  sec = 0.0
  for part in s.split(":"):
   sec = sec * 60 + float(part)
  return int(sec * 1000)
 except Exception:
  return None
def _lyr_finish(lines):
 lines = sorted((l for l in lines if l.get("t") is not None), key=lambda l: l["t"])
 for i, l in enumerate(lines):
  nxt = lines[i + 1]["t"] if i + 1 < len(lines) else None
  if l.get("e") is None or (nxt is not None and l["e"] > nxt + 2000):
   l["e"] = nxt if nxt is not None else l["t"] + 5000
 return lines
def _lyr_parse_ttml(xml_text):
 import xml.etree.ElementTree as ET
 root = ET.fromstring(xml_text.encode("utf-8") if isinstance(xml_text, str) else xml_text)
 ln = lambda tag: str(tag).rsplit("}", 1)[-1]
 def attr(el, name):
  for k, v in el.attrib.items():
   if k.rsplit("}", 1)[-1] == name:
    return v
  return None
 lines, any_word = [], False
 for p in root.iter():
  if ln(p.tag) != "p":
   continue
  toks = []
  def walk(el):
   if el.text:
    toks.append(("t", el.text))
   for ch in el:
    if ln(ch.tag) == "br":
     toks.append(("t", " "))
    elif (attr(ch, "role") or "") in ("x-translation", "x-roman"):
     pass
    else:
     b, e = _lyr_time(attr(ch, "begin")), _lyr_time(attr(ch, "end"))
     if b is not None and not any(True for _ in ch):
      toks.append(("w", b, e, ch.text or ""))
     else:
      walk(ch)
    if ch.tail:
     toks.append(("t", ch.tail))
  walk(p)
  words, text = [], ""
  for tk in toks:
   if tk[0] == "w":
    words.append([tk[1], tk[2], tk[3]])
    text += tk[3]
   else:
    text += tk[1]
    if words and tk[1][:1].isspace() and not words[-1][2].endswith(" "):
     words[-1][2] += " "
  text = re.sub(r"\s+", " ", text).strip()
  if not text:
   continue
  t = _lyr_time(attr(p, "begin"))
  if t is None and words:
   t = words[0][0]
  e = _lyr_time(attr(p, "end"))
  line = {"t": t, "e": e, "text": text, "w": None}
  if len(words) >= 2:
   for i, w in enumerate(words):
    if w[1] is None:
     w[1] = words[i + 1][0] if i + 1 < len(words) else (e or w[0] + 500)
   line["w"] = [tuple(w) for w in words]
   any_word = True
  lines.append(line)
 lines = _lyr_finish(lines)
 return ("word" if any_word else "line", lines) if lines else (None, [])
_LRC_TS = re.compile(r"\[(\d+):(\d+(?:[.:]\d+)?)\]")
_LRC_WORD = re.compile(r"(<\d+:\d+(?:\.\d+)?>)")
def _lyr_parse_lrc(text):
 lines, any_word = [], False
 for raw in str(text).splitlines():
  stamps, pos = [], 0
  while True:
   m = _LRC_TS.match(raw, pos)
   if not m:
    break
   stamps.append(int((int(m.group(1)) * 60 + float(m.group(2).replace(":", "."))) * 1000))
   pos = m.end()
  if not stamps:
   continue
  body = raw[pos:].strip()
  words = None
  if _LRC_WORD.search(body):
   parts = _LRC_WORD.split(body)
   cur, words = None, []
   for part in parts:
    if _LRC_WORD.fullmatch(part):
     mm, ss = part[1:-1].split(":")
     cur = int((int(mm) * 60 + float(ss)) * 1000)
    elif part.strip() and cur is not None:
     words.append([cur, None, part])
     cur = None
   for i, w in enumerate(words):
    w[1] = words[i + 1][0] if i + 1 < len(words) else None
   body = re.sub(r"\s+", " ", _LRC_WORD.sub("", body)).strip()
   words = [tuple(w) for w in words] if len(words) >= 2 else None
  for t in stamps:
   line = {"t": t, "e": None, "text": body, "w": words}
   if words:
    any_word = True
    line["e"] = words[-1][1]
   lines.append(line)
 lines = _lyr_finish(lines)
 for l in lines:
  if l["w"] and l["w"][-1][1] is None:
   l["w"] = [(a, b if b is not None else l["e"], c) for a, b, c in l["w"]]
 return ("word" if any_word else "line", lines) if lines else (None, [])
def _lyr_parse_plain(text):
 lines = [{"t": None, "e": None, "text": l.strip(), "w": None} for l in str(text).splitlines()]
 while lines and not lines[0]["text"]:
  lines.pop(0)
 while lines and not lines[-1]["text"]:
  lines.pop()
 return ("plain", lines) if lines else (None, [])
def _lyr_http_json(url, headers=None):
 conn = jclass("java.net.URL")(url).openConnection()
 conn.setConnectTimeout(8000)
 conn.setReadTimeout(10000)
 conn.setRequestProperty("User-Agent", "Mozilla/5.0")
 for k, v in (headers or {}).items():
  conn.setRequestProperty(k, v)
 if int(conn.getResponseCode()) != 200:
  return None
 stream = conn.getInputStream()
 try:
  sc = jclass("java.util.Scanner")(stream, "UTF-8").useDelimiter("\\A")
  return json.loads(str(sc.next())) if sc.hasNext() else None
 finally:
  stream.close()
def _lyr_from_unison(title, artist, album, dur):
 import urllib.parse
 q = {"song": title, "artist": artist, "duration": str(int(dur))}
 if album:
  q["album"] = album
 data = _lyr_http_json("https://unison.betterlyrics.org/lyrics?" + urllib.parse.urlencode(q),
 {"x-key-id": _LYR_KEY})
 d = (data or {}).get("data") or {}
 body, fmt = d.get("lyrics"), d.get("format")
 if not body:
  return None
 if fmt == "ttml":
  kind, lines = _lyr_parse_ttml(body)
 elif fmt == "lrc":
  kind, lines = _lyr_parse_lrc(body)
 else:
  kind, lines = _lyr_parse_plain(body)
 return {"kind": kind, "lines": lines, "src": "Unison"} if kind else None
def _lyr_from_lrclib(title, artist, album, dur):
 import urllib.parse
 q = {"track_name": title, "artist_name": artist, "duration": str(int(dur))}
 if album:
  q["album_name"] = album
 item = None
 try:
  item = _lyr_http_json("https://lrclib.net/api/get?" + urllib.parse.urlencode(q))
 except Exception:
  item = None
 if not item:
  hits = _lyr_http_json("https://lrclib.net/api/search?" + urllib.parse.urlencode(
 {"track_name": title, "artist_name": artist})) or []
  hits = [h for h in hits if h.get("syncedLyrics") or h.get("plainLyrics")]
  hits.sort(key=lambda h: (not h.get("syncedLyrics"), abs((h.get("duration") or 0) - dur)))
  item = hits[0] if hits and abs((hits[0].get("duration") or 0) - dur) <= 8 else None
 if not item:
  return None
 if item.get("syncedLyrics"):
  kind, lines = _lyr_parse_lrc(item["syncedLyrics"])
  if kind:
   return {"kind": kind, "lines": lines, "src": "LRCLIB"}
 if item.get("plainLyrics"):
  kind, lines = _lyr_parse_plain(item["plainLyrics"])
  if kind:
   return {"kind": kind, "lines": lines, "src": "LRCLIB"}
 return None
def _lyr_fetch(title, artist, album, dur):
 clean_t = re.sub(r"\s*[\(\[][^\)\]]*[\)\]]", "", title).strip() or title
 clean_t = re.sub(r"\s+-\s+(remaster|live|single|radio|mono|stereo).*$", "", clean_t, flags=re.I)
 first_a = re.split(r"\s*(?:,|&|/|;|\bfeat\.?|\bft\.?|\bwith\b)\s*", artist, flags=re.I)[0].strip() or artist
 variants = list(dict.fromkeys([(title, artist), (clean_t, first_a)]))
 best = None
 for provider in (_lyr_from_unison, _lyr_from_lrclib):
  for t, a in variants:
   try:
    res = provider(t, a, album, dur)
   except Exception:
    res = None
   if res:
    if best is None or _LYR_RANK[res["kind"]] > _LYR_RANK[best["kind"]]:
     best = res
    break
  if best and best["kind"] == "word":
   break
 return best
def _window_hook(dialog, on_touch):
 global _WCB
 win = dialog.getWindow()
 orig = win.getCallback()
 if _WCB is None:
  IH = jclass("java.lang.reflect.InvocationHandler")
  class WinCb(dynamic_proxy(IH)):
   def __init__(self, target, fn):
    super().__init__()
    self.target = target
    self.fn = fn
   def invoke(self, proxy, method, args):
    name = str(method.getName())
    try:
     if name == "dispatchTouchEvent":
      try:
       r = self.fn(self.target, args[0])
      except Exception:
       r = None
      if r is None:
       r = self.target.dispatchTouchEvent(args[0])
      return Boolean.valueOf(bool(r))
     if args is None:
      return method.invoke(self.target)
     return method.invoke(self.target, *args)
    except Exception:
     try:
      if str(method.getReturnType().getName()) == "boolean":
       return Boolean.FALSE
     except Exception:
      pass
     return None
  _WCB = WinCb
 Cls = jclass("java.lang.Class")
 cb = Cls.forName("android.view.Window$Callback")
 proxy = jclass("java.lang.reflect.Proxy").newProxyInstance(
 dialog.getContext().getClassLoader(), jarray(Cls)([cb]), _WCB(orig, on_touch))
 win.setCallback(proxy)
 return proxy
class _PillRow:
 DUR = 0.30
 def __init__(self, ed, pill, cells, labels):
  self.ed, self.pill, self.cells, self.labels = ed, pill, cells, labels
  self.x = self.w = None
  self.run = None
 def geom(self, i):
  c = self.cells[i]
  return float(c.getLeft()), float(c.getWidth())
 def apply(self, x, w):
  ed, pill = self.ed, self.pill
  lp = pill.getLayoutParams()
  wi = int(round(w))
  if int(lp.width) != wi:
   lp.width = wi
   pill.setLayoutParams(lp)
  pill.setTranslationX(float(x))
  self.x, self.w = float(x), float(w)
  for c, tv in zip(self.cells, self.labels):
   cw = float(c.getWidth())
   if cw <= 0:
    continue
   cx = float(c.getLeft())
   ov = max(0.0, min(x + w, cx + cw) - max(x, cx)) / cw
   tv.setTextColor(_mix(ed.c_sub, ed.c_accent, max(0.0, min(1.0, ov))))
 def cancel(self):
  self.run = None
 def set(self, i, attempt=0, prev=None, then=None):
  try:
   if self.run is not None:
    return
   x, w = self.geom(i)
   if w <= 0:
    if attempt < 25:
     self.pill.setVisibility(4)
     self.ed.handler.postDelayed(
 self.ed.Run(lambda: self.set(i, attempt + 1, prev, then)), 30)
    return
   self.pill.setVisibility(0)
   if prev is not None and (abs(prev[0] - x) > 0.5 or abs(prev[1] - w) > 0.5):
    self.apply(prev[0], prev[1])
    if then is not None:
     then()
    self.slide(i)
   else:
    self.apply(x, w)
    if then is not None:
     then()
  except Exception:
   pass
 def slide(self, i, on_frame=None, on_end=None):
  self.cancel()
  try:
   x1, w1 = self.geom(i)
   if w1 <= 0 or self.x is None:
    self.set(i)
    if on_frame:
     on_frame(1.0)
    if on_end:
     on_end()
    return
   x0, w0 = self.x, self.w
   tok = {"t0": time.time()}
   self.run = tok
   ed = self.ed
   def frame():
    if self.run is not tok:
     return
    try:
     f = min(1.0, (time.time() - tok["t0"]) / self.DUR)
     e = 1.0 - (1.0 - f) ** 3
     self.apply(x0 + (x1 - x0) * e, w0 + (w1 - w0) * e)
     if on_frame:
      on_frame(e)
     if f >= 1.0:
      self.run = None
      if on_end:
       on_end()
      return
    except Exception:
     self.run = None
     if on_end:
      on_end()
     return
