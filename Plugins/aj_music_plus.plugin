 Selector(
 key="sheet_min_height",
 text="Minimum sheet height",
 default=4,
 items=[
 "30% of screen",
 "40% of screen",
 "50% of screen",
 "60% of screen",
 "70% of screen",
 "80% of screen",
 ],
 ),
 ]
  settings.extend([
 Divider(),
 Header(text="Telegram Player"),
 Switch(
 key="native_queue_edit",
 text="Enable queue editing in Telegram Player",
 default=True,
 subtext="Long-press a track to move it or remove it.",
 ),
 Switch(
 key="replace_player",
 text="Replace Telegram's player",
 default=True,
 ),
 Divider(),
 Header(text="Updates"),
 Switch(
 key="update_check",
 text="Notify latest updates",
 default=True,
 subtext="Checks for a new version when you open Music +",
 on_change=lambda v: self._update_schedule(True) if v else None,
 ),
 Divider(),
 Header(text="Links"),
 *self._link_rows(),
 ])
  return settings
 def _dialog_title(self, dialog_id, acc=0) -> str:
  try:
   did = int(dialog_id)
   Long = jclass("java.lang.Long")
   MCtl = find_class("org.telegram.messenger.MessagesController").getInstance(int(acc))
   if did < 0:
    chat = MCtl.getChat(Long.valueOf(-did))
    return str(chat.title).strip() if chat is not None else ""
   if int(find_class("org.telegram.messenger.UserConfig").getInstance(int(acc)).getClientUserId()) == did:
    return "Saved Messages"
   user = MCtl.getUser(Long.valueOf(did))
   if user is not None:
    return str(find_class("org.telegram.messenger.UserObject").getUserName(user)).strip()
  except Exception:
   pass
  return ""
 def _topic_title(self, dialog_id, topic_id, acc=0) -> str:
  try:
   MCtl = find_class("org.telegram.messenger.MessagesController").getInstance(int(acc))
   topic = MCtl.getTopicsController().findTopic(-int(dialog_id), int(topic_id))
   if topic is not None and topic.title:
    return str(topic.title).strip()
  except Exception:
   pass
  return ""
 def _topic_label(self, dialog_id, topic_id, acc=0) -> str:
  return (self._topic_title(dialog_id, topic_id, acc)
 or ("General" if int(topic_id) == 1 else f"Topic {topic_id}"))
 def _auto_queue_name(self, dialog_id, topic_id=0, query=None, acc=0) -> str:
  chat = self._dialog_title(dialog_id, acc) if dialog_id else ""
  tail = ""
  if topic_id:
   tail = self._topic_label(dialog_id, topic_id, acc)
  q = (query or "").strip()
  if q:
   tail = f"{tail}/{q}" if tail else q
  name = f"{chat or 'Queue'}:{tail}" if tail else (chat or "Queue")
  return name[:60]
 def _profile_activity_user_id(self, fragment, current=None):
  try:
   cls_name = str(fragment.getClass().getName()) if fragment is not None else ""
  except Exception:
   cls_name = ""
  if "ProfileActivity" not in cls_name:
   return 0
  for name in ("userId", "user_id", "user_id_long", "dialog_id", "peerId", "profileUserId"):
   val = self._read(fragment, name)
   if val is None:
    continue
   try:
    if hasattr(val, "user_id"):
     val = val.user_id
    uid = int(val)
    if uid > 0:
     return uid
   except Exception:
    pass
  try:
   args = self._read(fragment, "arguments", "getArguments")
   if args is not None:
    for name in ("user_id", "userId"):
     uid = int(args.getLong(name, 0) or args.getInt(name, 0) or 0)
     if uid > 0:
      return uid
  except Exception:
   pass
  try:
   did = int(current.getDialogId()) if current is not None else 0
   return did if did > 0 else 0
  except Exception:
   return 0
 def _name_queue(self, current, fragment, topic_id, query):
  self._lib_owned = None
  self._queue_cover_key = None
  try:
   did = int(current.getDialogId()) if current is not None else 0
   acc = self._chat_account(fragment, [current] if current is not None else None)
   profile_uid = self._profile_activity_user_id(fragment, current)
   if profile_uid:
    try:
     me = int(find_class("org.telegram.messenger.UserConfig").getInstance(int(acc)).getClientUserId())
    except Exception:
     me = 0
    name = "My profile" if profile_uid == me else self._dialog_title(profile_uid, acc)
    name = (name or "Profile playlist")[:60]
    key = ("profile_music", int(profile_uid))
    if key == self._queue_scope_key and self._queue_name:
     return
    self._queue_scope_key = key
    self._queue_name = name
    return
   key = (did, int(topic_id or 0), (query or "").strip().lower())
   if key == self._queue_scope_key and self._queue_name:
    return
   self._queue_scope_key = key
   self._queue_name = self._auto_queue_name(did, topic_id, query, acc)
  except Exception:
   pass
 def _lib_data(self):
  if self._lib_cache is None:
   try:
    d = json.loads(self.get_setting("library_v1", "") or "{}")
   except Exception:
    d = {}
   if not isinstance(d, dict):
    d = {}
   d.setdefault("playlists", [])
   d.setdefault("chats", [])
   d.setdefault("friends", [])
   d.setdefault("last", None)
   try:
    default_account = int(find_class("org.telegram.messenger.UserConfig").selectedAccount)
   except Exception:
    default_account = 0
   for chat in d["chats"]:
    if isinstance(chat, dict):
     chat.setdefault("a", default_account)
   for friend in d["friends"]:
    if isinstance(friend, dict):
     friend.setdefault("a", default_account)
     if "d" not in friend and "id" in friend:
      friend["d"] = friend.get("id", 0)
   self._lib_cache = d
  return self._lib_cache
 def _lib_save(self):
  old_liked = getattr(self, "_liked_cache", None)
  self._liked_cache = None
  try:
   self.set_setting("library_v1", json.dumps(self._lib_data(), separators=(",", ":")))
  except Exception:
   pass
  try:
   if old_liked is not None and self._liked_keys() != old_liked:
    run_on_ui_thread(self._liked_changed)
  except Exception:
   pass
 def _lib_track(self, m):
  try:
   dur = int(m.getDuration())
  except Exception:
   dur = 0
  d = {"i": int(m.getId()), "d": int(m.getDialogId()),
 "t": _QueueEditor._title_of(m), "a": _QueueEditor._author_of(m), "s": dur}
  if (d["i"], d["d"]) in self.__dict__.get("_pm_synth_keys", ()):
   d["pf"] = d["d"]
  return d
 def _lib_dicts(self, items):
  return [x if isinstance(x, dict) else self._lib_track(x) for x in items if x is not None]
 def _lib_pl(self, pid):
  for p in self._lib_data()["playlists"]:
   if p["id"] == pid:
    return p
  return None
 def _lib_minutes(self, tracks):
  return max(1, int(round(sum(int(t.get("s", 0)) for t in tracks) / 60.0))) if tracks else 0
 def _lib_create(self, name, items):
  seen, tracks = set(), []
  for t in self._lib_dicts(items):
   k = (t["i"], t["d"])
   if k not in seen:
    seen.add(k)
    tracks.append(t)
  d = self._lib_data()
  pl = {"id": f"p{int(time.time() * 1000)}{random.randint(100, 999)}", "name": (name or "").strip()[:60] or "Playlist",
 "tracks": tracks, "created": int(time.time())}
  d["playlists"].insert(0, pl)
  d["last"] = pl["id"]
  self._lib_save()
  self._request_library_refresh()
  return pl
 def _lib_append(self, pid, items):
  pl = self._lib_pl(pid)
  if pl is None:
   return 0
  have = {(t["i"], t["d"]) for t in pl["tracks"]}
  added = 0
  for t in self._lib_dicts(items):
   k = (t["i"], t["d"])
   if k not in have:
    have.add(k)
    pl["tracks"].append(t)
    added += 1
  self._lib_data()["last"] = pid
  self._lib_save()
  self._request_library_refresh()
  return added
 def _lib_liked_playlist(self, create=False):
  data = self._lib_data()
  for playlist in data["playlists"]:
   if str(playlist.get("name", "")).strip().lower() == "liked songs":
    return playlist
  if not create:
   return None
  playlist = {
 "id": f"p{int(time.time() * 1000)}{random.randint(100, 999)}",
 "name": "Liked Songs",
 "tracks": [],
 "created": int(time.time()),
 }
  data["playlists"].insert(0, playlist)
  self._lib_save()
  return playlist
 def _liked_keys(self):
  cache = getattr(self, "_liked_cache", None)
  if cache is None:
   playlist = self._lib_liked_playlist(False)
   cache = set()
   for track in (playlist or {}).get("tracks", []):
    try:
     cache.add((int(track.get("i", 0)), int(track.get("d", 0))))
    except Exception:
     pass
   self._liked_cache = cache
  return cache
 def _liked_changed(self):
  ed = getattr(self, "_editor", None)
  if ed is not None:
   try:
    ed._refresh_liked_icons()
   except Exception:
    pass
 def _is_track_liked(self, msg):
  if msg is None:
   return False
  try:
   return (int(msg.getId()), int(msg.getDialogId())) in self._liked_keys()
  except Exception:
   return False
 def _toggle_track_liked(self, msg):
  if msg is None:
   return False
  try:
   key = (int(msg.getId()), int(msg.getDialogId()))
   playlist = self._lib_liked_playlist(True)
   tracks = playlist.setdefault("tracks", [])
   for index, track in enumerate(tracks):
    if (int(track.get("i", 0)), int(track.get("d", 0))) == key:
     del tracks[index]
     self._lib_save()
     self._liked_changed()
     return False
   tracks.append(self._lib_track(msg))
   self._lib_save()
   self._liked_changed()
   return True
  except Exception:
   self._bulletin("Couldn't update Liked Songs", error=True)
   return False
 def _lib_delete(self, pid):
  d = self._lib_data()
  d["playlists"] = [p for p in d["playlists"] if p["id"] != pid]
  if d.get("last") == pid:
   d["last"] = d["playlists"][0]["id"] if d["playlists"] else None
  self._lib_save()
 def _lib_rename(self, pid, name):
  pl = self._lib_pl(pid)
  if pl is not None and (name or "").strip():
   pl["name"] = name.strip()[:60]
   self._lib_save()
 def _lib_add_chat(self, dialog_id, topic_id, name, account=0) -> bool:
  d = self._lib_data()
  for c in d["chats"]:
   if c["d"] == int(dialog_id) and c["t"] == int(topic_id or 0):
    c.setdefault("a", int(account))
    return False
  d["chats"].append({"d": int(dialog_id), "t": int(topic_id or 0),
 "n": name, "a": int(account)})
  self._artist_dirty = True
  self._lib_save()
  self._request_library_refresh()
  return True
 def _lib_remove_chat(self, dialog_id, topic_id):
  d = self._lib_data()
  d["chats"] = [c for c in d["chats"] if not (c["d"] == int(dialog_id) and c["t"] == int(topic_id or 0))]
  self._lib_save()
  try:
   self._chat_track_cache.forget((int(dialog_id), int(topic_id or 0)))
  except Exception:
   self._chat_track_cache.pop((int(dialog_id), int(topic_id or 0)), None)
  self._request_library_refresh()
 def _lib_prompt_new(self, act, default, items, after=None):
  def create(text):
   pl = self._lib_create(text or default, items)
   self._bulletin(f"Saved “{pl['name']}” · {len(pl['tracks'])} tracks")
   if after:
    after(pl)
  _ActionSheet(self, act)._prompt_text("Save as playlist", default, "Playlist name", create)
 def _lib_add_to(self, pid, items):
  added = self._lib_append(pid, items)
  pl = self._lib_pl(pid)
  name = pl["name"] if pl else "playlist"
  self._bulletin(f"Added {added} track{'s' if added != 1 else ''} to “{name}”" if added
 else f"Nothing new to add to “{name}”", error=not added)
 def _lib_add_to_sheet(self, act, get_items, default_name="Playlist", subtitle="",
 exclude=None, need_active=False, end_of_queue=True):
  options = []
  if end_of_queue:
   options += [
 ("End of queue", "", False,
 lambda: get_items(lambda its: self._lib_queue_items(act, its, "end", need_active))),
 None,
 ]
  options.append(
 ("New playlist…", "Asks for a name", False,
 lambda: get_items(lambda its: self._lib_prompt_new(act, default_name, its))))
  pls = [p for p in self._lib_data()["playlists"] if p["id"] != exclude]
  if pls:
   options.append(None)
   for p in pls:
    options.append((p["name"], f"{len(p['tracks'])} tracks", False,
 (lambda pid=p["id"]: get_items(lambda its: self._lib_add_to(pid, its)))))
  _ActionSheet(self, act).show_sheet("Add to", subtitle, options)
 def _lib_queue_items(self, act, items, mode, need_active=False):
  if not items:
   return
  if isinstance(items[0], dict):
   self._lib_play(act, items, mode)
  else:
   self._lib_play_msgs(items, mode, keep_order=False, need_active=need_active)
 def _lib_cache_queue(self):
  try:
   mc = self._get_mc()
   pl = self._get_playlist(mc) if mc is not None else None
   for i in range(int(pl.size()) if pl is not None else 0):
    m = pl.get(i)
    k = self._msg_key(m) if m is not None else None
    if k:
     self._msg_cache[k] = m
  except Exception:
   pass
 def _pm_profile_fetch(self, uid, acc, on_done):
  friend = next((f for f in self._lib_data().get("friends", [])
 if int(f.get("d", f.get("id", 0)) or 0) == uid), None)
  h = int(friend.get("h", 0) or 0) if friend else 0
  if friend:
   acc = int(friend.get("a", acc) or 0)
  def work():
   msgs = []
   try:
    inp = self._pm_input_user(uid, h, acc)
    docs = self._pm_get_saved_music(acc, inp, lambda: False, lambda _t: None)
    for index, doc in enumerate(docs):
     try:
      m = self._pm_synthetic_music_message(acc, uid, doc, index)
      if m is None:
       continue
      try:
       if not bool(m.isMusic()):
        continue
      except Exception:
       pass
      msgs.append(m)
     except Exception:
      pass
   except Exception:
    pass
   def fin():
    on_done(msgs)
   try:
    run_on_ui_thread(fin)
   except Exception:
    fin()
  threading.Thread(target=work, daemon=True).start()
 def _lib_resolve(self, act, tracks, on_done):
  pf = {}
  for t in tracks:
   if t.get("pf"):
    k = (int(t["i"]), int(t["d"]))
    if k not in self._msg_cache:
     pf.setdefault(int(t["pf"]), set()).add(k)
  if not pf:
   return self._lib_resolve_chats(act, tracks, on_done)
  users = list(pf)
  acc = self._chat_account(None, None)
  def nxt():
   if not users:
    for ks in pf.values():
     for k in ks:
      if k not in self._msg_cache:
       self._msg_missing.add(k)
    self._lib_resolve_chats(act, tracks, on_done)
    return
   uid = users.pop(0)
   def done(msgs):
    for m in msgs:
     k = self._msg_key(m)
     if k:
      self._msg_cache[k] = m
    nxt()
   self._pm_profile_fetch(uid, acc, done)
  nxt()
 def _lib_resolve_chats(self, act, tracks, on_done):
  self._lib_cache_queue()
  keys = [(int(t["i"]), int(t["d"])) for t in tracks]
  missing = {}
  for i, dlg in keys:
   if (i, dlg) not in self._msg_cache and (i, dlg) not in self._msg_missing:
    missing.setdefault(dlg, set()).add(i)
  if not missing:
   on_done([self._msg_cache.get(k) for k in keys])
   return
  dialogs = list(missing)
  acc = self._chat_account(None, None)
  state = {"stop": False}
  def finish():
   self._prog_end_kind("resolve")
   on_done([self._msg_cache.get(k) for k in keys])
  def next_dialog():
   if state["stop"] or not dialogs:
    finish()
    return
   dlg = dialogs.pop(0)
   def prog(count, _total):
    self._prog_set(("resolve", dlg), count, _total if _total and _total >= count else 0)
   def done(found, err, cancelled):
    for m in found:
     k = self._msg_key(m)
     if k:
      self._msg_cache[k] = m
    if not err and not cancelled:
     for i in missing[dlg]:
      if (i, dlg) not in self._msg_cache:
       self._msg_missing.add((i, dlg))
    next_dialog()
   _MusicFetcher(self, acc, dlg, 0, prog, done, want=missing[dlg]).start()
  next_dialog()
 def _lib_play(self, act, tracks, mode="play", start=None, shuffle=False, name=None, source_key=None):
  keys = [(int(t["i"]), int(t["d"])) for t in tracks]
  def go(msgs):
   have = [m for m in msgs if m is not None]
   missing = len(keys) - len(have)
   if not have:
    self._bulletin("Those tracks aren't available any more", error=True)
    return
   if missing:
    self._bulletin(f"{missing} track{'s' if missing != 1 else ''} unavailable (deleted or too old to load)")
   self._lib_play_msgs(have, mode, start, shuffle, name, source_key=source_key)
  self._lib_resolve(act, tracks, go)
 def _cancel_progressive_queue(self):
  token = int(self.__dict__.get("_queue_build_token", 0)) + 1
  self._queue_build_token = token
  state = self.__dict__.pop("_queue_build_state", None)
  self._queue_expected_count = None
  if state is not None:
   try:
    self._activity_status(state.get("status_key"), None)
   except Exception:
    pass
  return token
 def _lib_play_msgs_progressive(self, msgs, start=None, name=None, source_key=None, cover=None, start_index=None,
 shuffle=False):
  try:
   total = int(len(msgs))
  except Exception:
   return False
  shuffle_on, rev = self._read_order()
  if total < 128:
   return False
  shuf = bool(shuffle or shuffle_on)
  if shuf:
   self._enable_shuffle()
   if start is None and start_index is None:
    start_index = random.randrange(min(total, _PROGRESSIVE_SHUFFLE_POOL))
  token = self._cancel_progressive_queue()
  status_key = ("queue_build", token)
  state = {"token": token, "total": total, "loaded": 0, "visible": [None] * total,
 "keys": set(), "status_key": status_key, "rev": bool(rev),
 "vkeys": [None] * total, "size": 0, "pending": [], "first_msg": None,
 "first_key": None, "scope": source_key, "name": name or "Library",
 "before_key": None, "before_msg": None, "shuf": shuf}
  self._queue_build_state = state
  self._queue_expected_count = total
  def msg_key(msg):
   try:
    return self._msg_key(msg)
   except Exception:
    return None
  def ui_sync(fn, timeout=30.0):
   event = threading.Event()
   result = {"ok": False}
   def wrapped():
    try:
     fn()
     result["ok"] = True
    except Exception:
     pass
    finally:
     event.set()
   try:
    run_on_ui_thread(wrapped)
   except Exception:
    return False
   if not event.wait(timeout):
    return False
   return bool(result["ok"])
  def current_token():
   return (int(self.__dict__.get("_queue_build_token", -1)) == token and
 self.__dict__.get("_queue_build_state") is state)
  def find_start():
   wanted = tuple(start) if start is not None else None
   if start_index is not None:
    try:
     hinted = int(start_index)
     if 0 <= hinted < total:
      candidate = msgs[hinted]
      if candidate is not None and (wanted is None or msg_key(candidate) == wanted):
       return hinted, candidate
    except Exception:
     pass
   if wanted is not None:
    rows = getattr(msgs, "rows", None)
    if rows is not None:
     try:
      for i, row in enumerate(rows):
       if int(row.get("i", 0) or 0) == int(wanted[0]) and \
 int(row.get("d", 0) or 0) == int(wanted[1]):
        candidate = msgs[i]
        if candidate is not None:
         return i, candidate
     except Exception:
      pass
    objs = getattr(msgs, "_objs", None)
    if objs is not None:
     for i, candidate in enumerate(objs):
      if candidate is not None and msg_key(candidate) == wanted:
       return i, candidate
    for i in range(total):
     try:
      candidate = msgs[i]
     except Exception:
      continue
     if candidate is not None and msg_key(candidate) == wanted:
      return i, candidate
   for i in range(total):
    try:
     candidate = msgs[i]
    except Exception:
     continue
    if candidate is not None:
     return i, candidate
   return None, None
  def refresh_editor(force=False):
   editor = getattr(self, "_editor", None)
   if editor is None:
    del state["pending"][:]
    return
   try:
    now = time.monotonic()
    loaded = int(state.get("loaded", 0))
    last_loaded = int(state.get("last_ui_loaded", 0))
    last_time = float(state.get("last_ui_refresh", 0.0))
    if not force and loaded - last_loaded < 512 and now - last_time < 0.5:
     return
    state["last_ui_loaded"] = loaded
    state["last_ui_refresh"] = now
    if force:
     editor._set_progressive_items(state)
    else:
     editor._progressive_flush(state)
    editor._lib_progress_refresh()
   except Exception:
    pass
  def abandon(note=None, reload_ui=False):
   if not current_token():
    return
   self._queue_build_state = None
   self._queue_expected_count = None
   self._queue_build_token = int(self.__dict__.get("_queue_build_token", 0)) + 1
   self._activity_status(status_key, None)
   editor = getattr(self, "_editor", None)
   if editor is not None:
    try:
     if reload_ui:
      editor._reload()
     else:
      editor._update_title()
    except Exception:
     pass
   if note:
    self._bulletin(note)
  def start_first(index, first, window=()):
   if not current_token():
    return
   state["start_index"] = int(index)
   state["visible"][int(index)] = first
   key = msg_key(first)
   state["vkeys"][int(index)] = key
   state["first_key"] = key
   state["first_msg"] = first
   state["keys"].add(key) if key is not None else None
   state["loaded"] = 1
   for widx, wmsg in window:
    wkey = msg_key(wmsg)
    state["visible"][int(widx)] = wmsg
    state["vkeys"][int(widx)] = wkey
    if wkey is not None:
     state["keys"].add(wkey)
    state["loaded"] += 1
   if window:
    state["before_msg"] = window[0][1]
    state["before_key"] = msg_key(window[0][1])
   self._lib_play_msgs([w[1] for w in window] + [first], "play", start=key, name=name,
 source_key=source_key, cover=cover, _progressive=True)
   if not current_token():
    return
   try:
    mc = self._get_mc()
    pl = self._get_playlist(mc) if mc is not None else None
    if pl is None or self._index_of(pl, int(first.getId()), int(first.getDialogId())) < 0:
     raise RuntimeError("first track wasn't installed in the player")
   except Exception:
    self._queue_build_state = None
    self._queue_expected_count = None
    self._activity_status(status_key, None)
    return
   state["size"] = int(pl.size())
   self._lib_owned = (state["keys"], self._queue_scope_key)
   refresh_editor(force=True)
  def apply_batch(pairs, region):
   if not current_token():
    return False
   mc = self._get_mc()
   playlist = self._get_playlist(mc) if mc is not None else None
   if mc is None or playlist is None:
    raise RuntimeError("player playlist disappeared")
   if int(playlist.size()) < int(state.get("size", 0)):
    abandon("Queue changed \u2013 stopped loading the rest of the list", reload_ui=True)
    return False
   try:
    first_present = int(playlist.indexOf(state["first_msg"])) >= 0
   except Exception:
    first_present = True
   if not first_present:
    abandon()
    return False
   messages = [m for _idx, m in pairs if m is not None]
   if not messages:
    return True
   insert_front = ((not rev and region == "after") or (rev and region == "before"))
   ordered = list(reversed(messages)) if insert_front or region == "before" else list(messages)
   if insert_front:
    insert_at = 0
   elif not rev and region == "before":
    anchor = -1
    a_msg = state.get("before_msg") or state["first_msg"]
    a_key = state.get("before_key") or state.get("first_key")
    try:
     anchor = int(playlist.indexOf(a_msg))
    except Exception:
     anchor = -1
    if anchor < 0 and a_key is not None:
     anchor = self._index_of(playlist, int(a_key[0]), int(a_key[1]))
    insert_at = max(0, anchor + 1) if anchor >= 0 else int(playlist.size())
   else:
    insert_at = int(playlist.size())
   arr = ArrayList()
   for message in ordered:
    arr.add(message)
   try:
    playlist.addAll(int(insert_at), arr)
   except Exception:
    for offset, message in enumerate(ordered):
     playlist.add(int(insert_at) + offset, message)
   for message in messages:
    self._map_put(mc, message)
   if insert_front:
    cur = self._current_index(mc)
    if cur < 0:
     cur = self._index_of(playlist, int(state["first_key"][0]), int(state["first_key"][1]))
    if cur >= 0:
     self._set_int_field(mc, "currentPlaylistNum", cur + len(messages))
   mkeys = {}
   for idx, message in pairs:
    if message is None:
     continue
    k = msg_key(message)
    mkeys[id(message)] = k
    if k is not None:
     state["keys"].add(k)
    if 0 <= idx < len(state["visible"]):
     state["visible"][idx] = message
     state["vkeys"][idx] = k
   if rev:
    where, disp = (("front", list(reversed(messages))) if region == "before"
 else ("end", list(messages)))
   else:
    where, disp = (("before_first", list(messages)) if region == "before"
 else ("end", list(messages)))
   state["pending"].append((where, [(m, mkeys.get(id(m))) for m in disp]))
   state["loaded"] += len(messages)
   state["size"] = int(playlist.size())
   if state.get("shuf"):
    if (int(playlist.size()) - int(state.get("shuf_synced", 0)) >= 512
 or not state.get("shuf_synced")):
     self._shuffle_sync(mc, playlist)
     state["shuf_synced"] = int(playlist.size())
   refresh_editor()
   return True
  def wait_if_dragging():
   while current_token():
    ed = getattr(self, "_editor", None)
    if ed is None or getattr(ed, "drag", None) is None:
     return
    time.sleep(0.05)
  def run_segment(indices, region):
   batch = []
   for idx in indices:
    if not current_token():
     return False
    if idx == state.get("start_index"):
     continue
    try:
     message = msgs[idx]
    except Exception:
     message = None
    if message is None:
     continue
    batch.append((idx, message))
    if len(batch) >= 64:
     current = list(batch)
     batch = []
     wait_if_dragging()
     if not ui_sync(lambda b=current, r=region: apply_batch(b, r)):
      return False
     time.sleep(0.01)
   if batch:
    current = list(batch)
    wait_if_dragging()
    if not ui_sync(lambda b=current, r=region: apply_batch(b, r)):
     return False
   return True
  def fail_build(message=None):
   def fail_ui():
    if not current_token():
     return
    self._queue_build_state = None
    self._queue_expected_count = None
    self._activity_status(status_key, None)
    editor = getattr(self, "_editor", None)
    if editor is not None:
     try:
      editor._update_title()
     except Exception:
      pass
    if message:
     self._bulletin(message, error=True)
   ui_sync(fail_ui, timeout=5.0)
  def work():
   try:
    index, first = find_start()
    if first is None or index is None:
     fail_build("No available tracks to play")
     return
    window = []
    if not shuf:
     for widx in range(max(0, index - _PROGRESSIVE_PREV_TRACKS), index):
      try:
       wm = msgs[widx]
      except Exception:
       wm = None
      if wm is not None:
       window.append((widx, wm))
    w0 = window[0][0] if window else index
    if not ui_sync(lambda: start_first(index, first, window)):
     fail_build("Couldn't start the queue")
     return
    if not current_token():
     return
    if rev:
     if not run_segment(range(w0 - 1, -1, -1), "before"):
      fail_build("Queue loading stopped")
      return
     if not run_segment(range(index + 1, total), "after"):
      fail_build("Queue loading stopped")
      return
    else:
     if not run_segment(range(index + 1, total), "after"):
      fail_build("Queue loading stopped")
      return
     if not run_segment(range(0, w0), "before"):
      fail_build("Queue loading stopped")
      return
    def finish_ui():
     if not current_token():
      return
     mc = self._get_mc()
     playlist = self._get_playlist(mc) if mc is not None else None
     actual = int(playlist.size()) if playlist is not None else state["loaded"]
     self._queue_build_state = None
     self._queue_expected_count = None
     self._activity_status(status_key, None)
     try:
      if mc is not None and playlist is not None:
       if state.get("shuf"):
        self._shuffle_sync(mc, playlist)
       else:
        self._finish_bulk_edit(mc, playlist)
     except Exception:
      pass
     editor = getattr(self, "_editor", None)
     if editor is not None:
      try:
       editor._progressive_flush(state)
       editor._update_title()
       editor._mini_update()
      except Exception:
       pass
     self._queue_name = name or "Library"
     if source_key is not None:
      self._queue_scope_key = source_key
     self._lib_owned = (frozenset(state["keys"]), self._queue_scope_key)
     try:
      threading.Thread(target=self._qcache_snapshot, daemon=True,
 name="smq-queue-snapshot").start()
     except Exception:
      pass
     if actual < total:
      pass
    if not ui_sync(finish_ui):
     fail_build("Queue finished, but the UI couldn't be refreshed")
   except Exception:
    fail_build("Queue loading stopped")
  threading.Thread(target=work, daemon=True, name="smq-progressive-queue").start()
  return True
 def _lib_play_msgs(self, msgs, mode="play", start=None, shuffle=False, name=None,
 keep_order=True, need_active=False, source_key=None, quiet=False, cover=None,
 _progressive=False, _start_index=None, _offline_done=False):
  if (not _progressive and not _offline_done and mode == "play"
 and self.get_setting("offline_mode", False)):
   src = [m for m in msgs if m is not None]
   def find_first():
    begin = 0
    if start is not None:
     for i, m in enumerate(src):
      if self._msg_key(m) == tuple(start):
       begin = i
       break
    for i in list(range(begin, len(src))) + list(range(0, begin)):
     if self._is_downloaded(src[i]):
      return i
    return -1
   def run_offline(idx):
    if idx < 0:
     self._bulletin("Offline mode: no downloaded tracks to play", error=True)
     return
    self._lib_play_msgs(src, mode, self._msg_key(src[idx]), shuffle, name, keep_order,
 need_active, source_key, quiet, cover, False,
 idx if len(src) == len(msgs) else None, True)
   if len(src) <= 400:
    run_offline(find_first())
   else:
    def scan_work():
     try:
      idx = find_first()
     except Exception:
      idx = -1
     run_on_ui_thread(lambda: run_offline(idx))
    threading.Thread(target=scan_work, daemon=True).start()
   return
  if not _progressive:
   try:
    n = int(len(msgs))
   except Exception:
    n = 0
   if mode == "play" and n >= 128:
    if self._lib_play_msgs_progressive(
 msgs, start=start, name=name, source_key=source_key, cover=cover,
 start_index=_start_index, shuffle=shuffle):
     return
   if mode not in ("next", "end"):
    self._cancel_progressive_queue()
  msgs = [m for m in msgs if m is not None]
  if not msgs:
   self._bulletin("Nothing to play", error=True)
   return
  mc = self._get_mc()
  if mc is None:
   self._bulletin("Player not available", error=True)
   return
  pl = self._get_playlist(mc)
  active = pl is not None and int(pl.size()) > 0 and self._playing_key(mc) is not None
  if mode in ("next", "end") and not active and need_active:
   self._bulletin("Start playing a track first", error=True)
   return
  if mode in ("next", "end") and active:
   added = self._queue_bulk_insert(mc, pl, msgs, next_=(mode == "next"), keep_order=keep_order)
   where = "next" if mode == "next" else "to the end of the queue"
   if not quiet:
    self._bulletin(f"Added {added} track{'s' if added != 1 else ''} {where}" if added
 else "Already in the queue", error=not added)
   ed = getattr(self, "_editor", None)
   if ed is not None and added:
    try:
     ed._reload()
    except Exception:
     pass
   return
  if shuffle:
   self._enable_shuffle()
  seq = list(msgs)
  first = random.choice(seq[:_PROGRESSIVE_SHUFFLE_POOL]) if shuffle and start is None else seq[0]
  if start is not None:
   for m in seq:
    if self._msg_key(m) == tuple(start):
     first = m
     break
  _shuffle_on, rev = self._read_order()
  stored = seq if rev else seq[::-1]
  al = ArrayList()
  for m in stored:
   al.add(m)
  did = int(first.getDialogId())
  started = False
  prev_filter = getattr(self, "_active_filter", None)
  prev_id = (self._queue_name, self._queue_scope_key, getattr(self, "_queue_cover_key", None),
 getattr(self, "_lib_owned", None))
  new_name = name or "Library"
  new_scope = source_key or ("library", new_name)
  self._queue_name, self._queue_scope_key = new_name, new_scope
  self._queue_cover_key = self._msg_key(cover) if cover is not None else None
  self._lib_owned = (frozenset(k for k in (self._msg_key(m) for m in stored) if k is not None),
 new_scope)
  self._lock_playlist("library")
  previous_remote = bool(getattr(self, "_allow_remote", False))
  previous_bypass = bool(getattr(self, "_lib_bypass", False))
  self._allow_remote = True
  self._lib_bypass = True
  try:
   for args in ((al, first, did, False, None), (al, first, did, 0), (al, first, did)):
    try:
     mc.setPlaylist(*args)
     started = True
     break
    except Exception:
     pass
  finally:
   self._allow_remote = previous_remote
   self._lib_bypass = previous_bypass
  def queue_matches():
   try:
    current_pl = self._get_playlist(mc)
    if current_pl is None:
     return False
    wanted_list = [self._msg_key(m) for m in stored]
    actual_list = [self._msg_key(current_pl.get(i))
 for i in range(int(current_pl.size()))]
    return bool(wanted_list) and actual_list == wanted_list
   except Exception:
    return False
  if not started or not queue_matches():
   try:
    current_pl = self._get_playlist(mc)
    if current_pl is None:
     raise RuntimeError("playlist unavailable")
    current_pl.clear()
    pmap = get_private_field(mc, "playlistMap")
    if pmap is not None:
     pmap.clear()
    for item in stored:
     current_pl.add(item)
     self._map_put(mc, item)
    first_index = self._index_of(current_pl, int(first.getId()), int(first.getDialogId()))
    if first_index < 0:
     raise RuntimeError("selected library track missing from rebuilt queue")
    self._set_int_field(mc, "currentPlaylistNum", first_index)
    if _shuffle_on:
     try:
      mc.buildShuffledPlayList()
      self._set_int_field(mc, "currentPlaylistNum", 0)
     except Exception:
      pass
    started = queue_matches()
   except Exception:
    started = False
  if not started:
   self._active_filter = prev_filter
   (self._queue_name, self._queue_scope_key,
 self._queue_cover_key, self._lib_owned) = prev_id
   self._bulletin("Couldn't build the library queue; playback was left unchanged", error=True)
   return
  previous_remote = bool(getattr(self, "_allow_remote", False))
  previous_bypass = bool(getattr(self, "_lib_bypass", False))
  self._allow_remote = True
  self._lib_bypass = True
  try:
   mc.playMessage(first)
  except Exception:
   self._active_filter = prev_filter
   (self._queue_name, self._queue_scope_key,
 self._queue_cover_key, self._lib_owned) = prev_id
   self._bulletin("Queue built, but playback couldn't start", error=True)
   return
  finally:
   self._allow_remote = previous_remote
   self._lib_bypass = previous_bypass
  self._lock_playlist("library")
  if source_key and isinstance(source_key, (tuple, list)) and len(source_key) >= 2 and source_key[0] == "playlist":
   playlist = self._lib_pl(source_key[1])
   if playlist is not None:
    playlist["last_played"] = int(time.time())
    self._lib_save()
  self._queue_name, self._queue_scope_key = new_name, new_scope
  try:
   self._qcache_snapshot()
  except Exception:
   pass
  if not _progressive:
   self._sync_editor_after_library_start()
  try:
   editor = getattr(self, "_editor", None)
   if editor is not None:
    editor._update_title()
  except Exception:
   pass
 def _sync_editor_after_library_start(self, attempt=0):
  editor = getattr(self, "_editor", None)
  if editor is not None:
   try:
    if getattr(editor, "drag", None) is None and editor._load():
     editor.win_start = editor.win_end = 0
     editor.queue_lazy_ready = False
     editor._refresh()
     editor._scroll_to_playing()
    editor._mini_update()
   except Exception:
    pass
  if attempt < 3:
   self._post(lambda: self._sync_editor_after_library_start(attempt + 1), 160)
 def _finish_scope_tracks_sync(self, tracks, topic_id, on_ready):
  used = list(tracks or [])
  if topic_id == 1 and used:
   try:
    batch = ArrayList()
    for item in used:
     batch.add(item)
    general = self._filter_messages(batch, 1, None, None)
    used = [general.get(i) for i in range(general.size())] if general is not None else []
   except Exception:
    pass
  try:
   used.sort(key=lambda m: -int(m.getId()))
  except Exception:
   pass
  for message in used:
   key = self._msg_key(message)
   if key:
    self._msg_cache[key] = message
  on_ready(used)
 def _finish_scope_tracks_async(self, tracks, topic_id, on_ready):
  def work():
   used = list(tracks or [])
   if topic_id == 1 and used:
    try:
     batch = ArrayList()
     for item in used:
      batch.add(item)
     general = self._filter_messages(batch, 1, None, None)
     used = [general.get(i) for i in range(general.size())] if general is not None else []
    except Exception:
     pass
   try:
    used.sort(key=lambda m: -int(m.getId()))
   except Exception:
    pass
   for message in used:
    key = self._msg_key(message)
    if key:
     self._msg_cache[key] = message
   def finish():
    try:
     on_ready(used)
    except Exception:
     pass
   try:
    run_on_ui_thread(finish)
   except Exception:
    finish()
  threading.Thread(target=work, daemon=True, name="smq-scope-finish").start()
 def _fetch_scope_tracks(self, frag, dialog_id, topic_id, loaded_tracks, on_ready, act=None, on_fail=None,
 since_id=0, on_batch=None, silent=False):
  pkey = ("fetch", int(dialog_id or 0), int(topic_id or 0))
  def _failed():
   self._prog_end(pkey)
   self._activity_status(pkey, None)
   if on_fail is not None:
    try:
     on_fail()
    except Exception:
     pass
  act = act or (frag.getParentActivity() if frag is not None else None)
  if act is None or not dialog_id:
   self._bulletin("Can't determine this chat", error=True)
   _failed()
   return
  scope = "topic" if topic_id else "chat"
  acc = self._chat_account(frag, loaded_tracks)
  sheet = _ProgressSheet(self, act)
  partial = {"continue": False}
  streamed_tracks = []
  def on_progress(count, total):
   sheet.set_text(f"{count} of {total} tracks" if total and total >= count else f"{count} tracks found")
   self._prog_set(pkey, count, total if total and total >= count else 0)
  def batch_ready(batch, count, total):
   used_batch = list(batch or [])
   if topic_id == 1 and used_batch:
    try:
     arr = ArrayList()
     for item in used_batch:
      arr.add(item)
     general = self._filter_messages(arr, 1, None, None)
     used_batch = [general.get(i) for i in range(general.size())] if general is not None else []
    except Exception:
     pass
   for item in used_batch:
    k = self._msg_key(item)
    if k:
     self._msg_cache[k] = item
   if on_batch is not None and used_batch:
    streamed_tracks.extend(used_batch)
    on_batch(used_batch, count, total)
  def on_done(tracks, error, cancelled):
   sheet.close()
   self._prog_end(pkey)
   self._activity_status(pkey, None)
   self._request_library_refresh()
   if cancelled and not partial["continue"]:
    _failed()
    return
   used = tracks
   using_loaded_fallback = False
   if (error or partial["continue"]) and not tracks and loaded_tracks:
    used = loaded_tracks
    using_loaded_fallback = True
    self._bulletin(f"Fetch failed ({error}) – using loaded messages only", error=True)
   elif error and not tracks:
    self._bulletin(
 f"Couldn't check for new music: {error}" if since_id else f"Couldn't load music: {error}",
 error=True)
    _failed()
    return
   if on_batch is not None and not using_loaded_fallback and streamed_tracks:
    used = list(streamed_tracks)
    already_streamed = True
   else:
    already_streamed = False
   if since_id:
    if error and not tracks:
     _failed()
     return
    if already_streamed:
     on_ready(used)
    else:
     self._finish_scope_tracks_async(used, topic_id, on_ready)
    return
   if not used:
    self._bulletin(f"No music found in this {scope}", error=True)
    _failed()
    return
   if already_streamed:
    on_ready(used)
   elif len(used) >= 128:
    self._finish_scope_tracks_async(used, topic_id, on_ready)
   else:
    self._finish_scope_tracks_sync(used, topic_id, on_ready)
  fetcher = _MusicFetcher(self, acc, dialog_id, topic_id, on_progress, on_done,
 min_id=since_id, on_batch=batch_ready if on_batch is not None else None)
  def continue_partial():
   partial["continue"] = True
   fetcher.stop_with_partial()
  def _cancel():
   fetcher.cancel()
   _failed()
  if not silent and not self._library_ui_active():
   sheet.show_progress(f"Loading music of this {scope}…", _cancel,
 on_continue=continue_partial)
  else:
   try:
    sheet.close()
   except Exception:
    pass
  self._prog_set(pkey, 0, 0)
  fetcher.start()
 def _chat_add_friend(self, frag, dialog_id, tracks):
  acc = self._chat_account(frag, tracks)
  user = None
  try:
   user = find_class("org.telegram.messenger.MessagesController").getInstance(acc).getUser(int(dialog_id))
  except Exception:
   pass
  self._friend_add_profile({"user": user, "userId": int(dialog_id), "account": acc})
 def _chat_add_chat(self, context, whole=False):
  try:
   frag, dialog_id, topic_id, tracks, _n = self._chat_scope(context)
   if whole:
    topic_id = 0
   if not dialog_id:
    self._bulletin("Can't do that here", error=True)
    return
   name = self._auto_queue_name(dialog_id, topic_id, None, self._chat_account(frag, tracks))
   new = self._lib_add_chat(
 dialog_id, topic_id, name, self._chat_account(frag, tracks))
   self._bulletin(f"Added “{name}” to Library › Chats" if new else "Already in Library")
  except Exception:
   self._bulletin("Library action failed", error=True)
 def _chat_add_to_sheet(self, context):
  try:
   frag, dialog_id, topic_id, tracks, _n = self._chat_scope(context)
   act = frag.getParentActivity() if frag is not None else None
   if act is None or not dialog_id:
    self._bulletin("Can't do that here", error=True)
    return
   name = self._auto_queue_name(dialog_id, topic_id, None, self._chat_account(frag, tracks))
   def get_items(cb):
    self._fetch_scope_tracks(frag, dialog_id, topic_id, tracks, cb, act)
   self._lib_add_to_sheet(act, get_items, name, name, need_active=True)
  except Exception:
   self._bulletin("Add to failed", error=True)
 def _chat_set_profile(self, context):
  try:
   frag, dialog_id, topic_id, tracks, _n = self._chat_scope(context)
   act = frag.getParentActivity() if frag is not None else None
   if act is None or not dialog_id:
    self._bulletin("Can't do that here", error=True)
    return
   name = self._auto_queue_name(dialog_id, topic_id, None, self._chat_account(frag, tracks))
   def get_items(cb):
    self._fetch_scope_tracks(frag, dialog_id, topic_id, tracks, cb, act)
   self._profile_playlist_sheet(act, name, get_items, None)
  except Exception:
   self._bulletin("Profile playlist failed", error=True)
 def _lock_playlist(self, reason):
  scope = getattr(self, "_topic_hydration_scope", None)
  if scope is not None:
   same_topic_scope = (
 isinstance(reason, tuple) and len(reason) >= 3
 and reason[0] == "filter"
 and int(reason[1]) == int(scope[1])
 and str(reason[2] or "").strip() == str(scope[2] or "").strip()
 )
   if not same_topic_scope:
    self._cancel_topic_hydration()
  self._active_filter = reason
 def _unlock_playlist(self):
  self._active_filter = None
  if getattr(self, "_topic_hydration_scope", None) is not None:
   self._cancel_topic_hydration()
 @staticmethod
 def _to_int(val) -> int:
  try:
   return int(val) if val else 0
  except Exception:
   return 0
 @staticmethod
 def _read(obj, *names):
  if obj is None:
   return None
  for name in names:
   try:
    val = getattr(obj, name, None)
    if val is not None:
     if callable(val):
      val = val()
     if val is not None:
      return val
   except Exception:
    pass
   try:
    val = get_private_field(obj, name)
    if val is not None:
     return val
   except Exception:
    pass
  return None
 def _read_flag(self, obj, names) -> Optional[bool]:
  found = None
  for name in names:
   val = self._read(obj, name)
   if val is None:
    continue
   try:
    if bool(val):
     return True
    found = False
   except Exception:
    continue
  return found
 def _install_menu_items(self):
  try:
   mid = self.add_menu_item(MenuItemData(
 menu_type=MenuItemType.MESSAGE_CONTEXT_MENU,
 text="Music +",
 on_click=self._safe_message_actions,
 icon="files_music",
 condition="message != null && message.isMusic()",
 priority=60,
 item_id="smart_music_queue_actions",
 ))
   if mid:
    self._menu_ids.append(mid)
  except Exception:
   pass
  try:
   profile_type = getattr(MenuItemType, "PROFILE_ACTION_MENU", None)
   if profile_type is not None:
    mid = self.add_menu_item(MenuItemData(
 menu_type=profile_type,
 text="Music +",
 on_click=lambda ctx: self._show_chat_sheet(ctx),
 icon="files_music",
 priority=20,
 item_id="sq_profile_menu",
 ))
    if mid:
     self._menu_ids.append(mid)
  except Exception:
   pass
 def _safe_message_actions(self, context: Dict[str, Any]):
  try:
   msg = context.get("message") if context else None
   if msg is None:
    return
   run_on_ui_thread(lambda: self._show_message_actions(msg))
  except Exception:
   pass
 def _is_message_in_queue(self, msg) -> bool:
  if msg is None:
   return False
  mc = self._get_mc()
  pl = self._get_playlist(mc) if mc is not None else None
  if pl is None:
   return False
  try:
   return self._index_of(pl, int(msg.getId()), int(msg.getDialogId())) >= 0
  except Exception:
   return False
 def _track_sheet(self, act, msg, hero, extras=None, editor=None, subtitle=None):
  def close(fn):
   if editor is not None:
    editor._after_close(fn)
   else:
    fn()
  opts = list(extras or [])
  artist = (_QueueEditor._author_of(msg) or "").strip()
  if artist:
   opts.append(("Search for Artist", "Search Telegram Music for this artist", False,
 lambda a=artist: close(lambda: self._open_artist_music_search(a))))
  if opts:
   opts.append(None)
  opts += [
 ("Forward", "Forward this track to a chat", False, lambda: close(lambda: self._pick_forward(msg))),
 ("Download", "Download this track", False, lambda: self._download_tracks(msg)),
 ("Save to Music", "Download and save this track", False, lambda: self._save_to_music(msg)),
 ("Show in chat", "Open the original message", False, lambda: close(lambda: self._show_in_chat(msg))),
 ]
  if subtitle is None:
   sub = artist
  else:
   sub = f"{artist} \u00b7 {subtitle}" if artist else subtitle
  _ActionSheet(self, act).show_sheet(
 _QueueEditor._title_of(msg), sub,
 opts, list(hero)[:4], artist_view=artist or None,
 artist_message=msg if artist else None, like_message=msg)
 def _collection_sheet(self, act, title, meta, play_next, add_to, select=None, exclude=None,
 extras=(), danger=(), header_action=None, artist_search=None):
  hero = [("Play next", play_next, False, ("ic_action_next", "msg_arrowright")),
 ("Add to", add_to, False, ("msg_add",))]
  if select is not None:
   hero.append(("Select all", select, False))
  if exclude is not None:
   hero.append(("Exclude from queue", exclude, True, ("filled_clear", "msg_close")))
  opts = list(extras)
  if artist_search:
   opts.append(("Search for Artist", "Search Telegram Music for this artist", False,
 lambda name=artist_search: self._open_artist_music_search(name)))
  if danger:
   if opts and opts[-1] is not None:
    opts.append(None)
   opts += list(danger)
  _ActionSheet(self, act).show_sheet(
 title, meta, opts, hero[:4], header_action=header_action,
 artist_view=artist_search)
 def _selection_sheet(self, act, title, subtitle, hero, select_all, forward, save,
 done=None, extras=(), download=None, count=0):
  over = count > 100
  hint = "Select up to 100 tracks"
  opts = ([select_all] if select_all else []) + ([done] if done else []) + list(extras)
  opts += [None,
 ("Forward", hint if over else "Forward selected tracks to a chat", False, forward, "", None, None, over)]
  if download is not None:
   opts.append(("Download", hint if over else "Download the selected tracks", False, download, "", None, None, over))
  opts.append(("Save to Music", "Downloads tracks before saving", False, save))
  _ActionSheet(self, act).show_sheet(title, subtitle, opts, list(hero)[:4])
 def _exclude_from_queue(self, msgs, name):
  msgs = [m for m in msgs or [] if m is not None]
  if not msgs:
   self._bulletin("No cached tracks to exclude", error=True)
   return
  removed, kept = self._queue_exclude_messages(msgs)
  if removed:
   self._bulletin(f"Excluded {removed} track{'s' if removed != 1 else ''} · {name}"
 + (" (kept the playing track)" if kept else ""))
  elif kept:
   self._bulletin(f"Kept the currently playing track · {name}")
  else:
   self._bulletin(f"Nothing from {name} is in the queue", error=True)
 def _hero_add_to(self, act, msg, end_of_queue=True, subtitle="Add this track to the queue or a playlist"):
  return ("Add to", lambda: self._lib_add_to_sheet(
 act, lambda cb: cb([msg]), default_name=_QueueEditor._title_of(msg),
 subtitle=subtitle, end_of_queue=end_of_queue), False, ("msg_add",))
 def _show_queue_track_menu(self, msg, editor=None):
  try:
   frag = get_last_fragment()
   act = editor.act if editor is not None else (frag.getParentActivity() if frag is not None else None)
   if act is None:
    self._bulletin("Can't open music actions here", error=True)
    return
   mc = self._get_mc()
   playing = self._msg_key(msg) == self._playing_key(mc)
   def play_next():
    if editor is not None:
     editor._row_action(self._queue_next, msg)
    elif not self._queue_next(msg):
     self._bulletin("Couldn't do that", error=True)
   def remove_from_queue():
    if editor is not None:
     editor._remove(msg)
     return
    if self._msg_key(msg) == self._playing_key(self._get_mc()):
     self._bulletin("Can't remove the track that is playing", error=True)
    elif not self._queue_remove(msg):
     self._bulletin("Couldn't remove that track", error=True)
   def play_track():
    if editor is not None:
     editor._play(msg)
     return
    controller = self._get_mc()
    if controller is None:
     self._bulletin("Player not available", error=True)
     return
    try:
     self._allow_remote = True
     try:
      controller.playMessage(msg)
     finally:
      self._allow_remote = False
    except Exception:
     self._bulletin("Could not play that track", error=True)
   def select_track():
    if editor is not None:
     editor._enter_sel(msg)
    else:
     self._open_queue_editor_select(msg)
   select = ("Select", select_track, False)
   hero, extras = [self._hero_add_to(act, msg, False, "Add this track to a playlist"), select], []
   if not playing:
    hero = [("Play next", play_next, False), hero[0], select,
 ("Remove", remove_from_queue, True)]
    if editor is not None:
     extras.append(("Play", "", False, play_track))
   self._track_sheet(act, msg, hero, extras, editor=editor)
  except Exception:
   self._bulletin("Couldn't open music actions", error=True)
 def _open_queue_editor_select(self, msg):
  self._open_queue_editor()
  def _select_when_ready():
   ed = getattr(self, "_editor", None)
   if ed is None:
    return
   try:
    if not ed.dialog.isShowing():
     return
    if any(ed._key(item) == self._msg_key(msg) for item in ed.items):
     ed._enter_sel(msg)
   except Exception:
    pass
  self._post(_select_when_ready, 350)
 def _show_message_actions(self, msg):
  try:
   frag = get_last_fragment()
   act = frag.getParentActivity() if frag is not None else None
   if act is None:
    self._bulletin("Can't open music actions here", error=True)
    return
   if self._is_message_in_queue(msg):
    self._show_queue_track_menu(msg)
    return
   hero = [("Play next", lambda: self._do_play_next(msg), False), self._hero_add_to(act, msg)]
   self._track_sheet(act, msg, hero)
  except Exception:
   self._bulletin("Couldn't open music actions", error=True)
 def _drop_editor(self, ed):
  try:
   for r in (getattr(ed, "mini_run", None), getattr(ed, "tick_run", None),
 getattr(ed, "undo_action_run", None), getattr(ed, "undo_expire_run", None)):
    if r is not None:
     try:
      ed.handler.removeCallbacks(r)
     except Exception:
      pass
   try:
    ed._hide_undo()
   except Exception:
    pass
   try:
    ed.dialog.dismiss()
   except Exception:
    pass
  finally:
   if getattr(self, "_editor", None) is ed:
    self._editor = None
   if getattr(self, "_kept_editor", None) is ed:
    self._kept_editor = None
 def _open_queue_editor(self):
  def _go():
   try:
    if self._tab_open():
     return
    act = None
    try:
     frag = get_last_fragment()
     act = frag.getParentActivity() if frag is not None else None
    except Exception:
     pass
    if act is None:
     try:
      act = find_class("org.telegram.ui.LaunchActivity").instance
     except Exception:
      act = None
    if act is None:
     self._bulletin("Can't open the queue editor here", error=True)
     return
    ed = getattr(self, "_editor", None)
    if ed is not None and getattr(ed, "tabmode", False):
     ed = None
    if ed is not None:
     live = False
     try:
      live = (bool(ed.act.equals(act)) and bool(ed.dialog.isShowing())
 and bool(ed.dialog.getWindow().getDecorView().isAttachedToWindow()))
     except Exception:
      live = False
     if live:
      return
     self._drop_editor(ed)
    kept = getattr(self, "_kept_editor", None)
    self._kept_editor = None
    if kept is not None:
     try:
      if (bool(self.get_setting("keep_sheet_alive", True))
 and bool(kept.act.equals(act)) and kept._theme_same()):
       kept.reopen()
       return
     except Exception:
      pass
     self._drop_editor(kept)
    _QueueEditor(self, act).show()
   except Exception as e:
    self._bulletin(f"Queue editor failed: {e}", error=True)
  try:
   run_on_ui_thread(_go)
  except Exception:
   _go()
 def _friend_add_profile(self, context):
  try:
   context = context or {}
   user = context.get("user")
   user_id = self._to_int(context.get("userId") or context.get("user_id"))
   if not user_id and user is not None:
    user_id = self._to_int(self._read(user, "id", "user_id"))
   try:
    acc = int(context.get("account", 0) or 0)
   except Exception:
    acc = 0
   if not user_id:
    self._bulletin("Couldn't identify this profile", error=True)
    return
   try:
    me = int(find_class("org.telegram.messenger.UserConfig").getInstance(acc).getClientUserId())
    if user_id == me:
     self._bulletin("Your own profile doesn't need to be saved as a friend", error=True)
     return
   except Exception:
    pass
   access_hash = self._to_int(self._read(user, "access_hash", "accessHash"))
   name = self._dialog_title(user_id, acc)
   if not name and user is not None:
    try:
     name = str(find_class("org.telegram.messenger.UserObject").getUserName(user)).strip()
    except Exception:
     pass
   name = (name or str(self._read(user, "first_name") or "Profile")).strip()
   friend = {"d": int(user_id), "h": int(access_hash), "a": int(acc), "n": name}
   data = self._lib_data()
   existing = next((f for f in data["friends"]
 if int(f.get("d", f.get("id", 0)) or 0) == user_id), None)
   if existing is None:
    data["friends"].append(friend)
    message = f"Saved {name} to Library › Friends"
   else:
    existing.update(friend)
    message = f"Updated {name} in Library › Friends"
   self._lib_save()
   self._friend_track_cache.pop((acc, user_id), None)
   self._bulletin(message)
   editor = getattr(self, "_editor", None)
   if editor is not None:
    try:
     editor._lib_render()
    except Exception:
     pass
  except Exception:
   self._bulletin("Couldn't save this profile", error=True)
 def _open_profile_user(self, user_id, acc=0):
  try:
   frag = get_last_fragment()
   act = frag.getParentActivity() if frag is not None else None
   if frag is None or act is None:
    self._bulletin("Can't open this profile here", error=True)
    return
   args = jclass("android.os.Bundle")()
   args.putLong("user_id", int(user_id))
   profile = find_class("org.telegram.ui.ProfileActivity")(args)
   frag.presentFragment(profile)
  except Exception:
   self._bulletin("Couldn't open this profile", error=True)
 def _install_chat_menu_items(self):
  mtype = getattr(MenuItemType, "CHAT_ACTION_MENU", None)
  if mtype is None:
   return
  try:
   mid = self.add_menu_item(MenuItemData(
 menu_type=mtype,
 text="Music +",
 on_click=lambda ctx: self._show_chat_sheet(ctx),
 icon="files_music",
 priority=20,
 item_id="sq_chat_menu",
 ))
   if mid:
    self._menu_ids.append(mid)
  except Exception:
   pass
 def _show_chat_sheet(self, context):
  def _go():
   try:
    frag, dialog_id, topic_id, tracks, _ = self._chat_scope(context)
    act = frag.getParentActivity() if frag is not None else None
    if act is None:
     self._bulletin("Can't open the menu here", error=True)
     return
    scope = "topic" if topic_id else "chat"
    private = int(dialog_id or 0) > 0 and not topic_id
    friend_opt = [("Add as friend", "Save this user's profile music to Library › Friends", False,
 lambda: self._chat_add_friend(frag, dialog_id, tracks))] if private else []
    self._collection_sheet(
 act, "Music +", f"Music in this {scope}",
 lambda: self._do_chat_action("next", context),
 lambda: self._chat_add_to_sheet(context),
 exclude=lambda: self._do_chat_action("exclude", context),
 extras=[
 ("Add chat to Library", "The whole group, all topics" if topic_id else "", False,
 lambda: self._chat_add_chat(context, whole=True)),
 *([("Add topic to Library", "Only this topic", False,
 lambda: self._chat_add_chat(context))] if topic_id else []),
 *friend_opt,
 ("Set as profile playlist", f"Use this {scope}'s music as your profile music", False,
 lambda: self._chat_set_profile(context)),
 None,
 ("Open Music +", "Queue and Library", False, self._open_queue_editor)])
   except Exception:
    self._bulletin("Music + menu failed", error=True)
  try:
   run_on_ui_thread(_go)
  except Exception:
   _go()
 def _request_library_refresh(self):
  def refresh():
   try:
    editor = getattr(self, "_editor", None)
    if editor is not None and getattr(editor, "tab", None) == "library":
     editor._queue_library_refresh()
   except Exception:
    pass
  try:
   run_on_ui_thread(refresh)
  except Exception:
   refresh()
 def _activity_status(self, key, text=None):
  jobs = self.__dict__.setdefault("_activity_jobs", {})
  if text is None:
   jobs.pop(key, None)
  else:
   jobs[key] = (str(text), time.monotonic())
  editor = getattr(self, "_editor", None)
  if editor is not None:
   def refresh():
    try:
     editor._activity_refresh()
    except Exception:
     pass
   try:
    run_on_ui_thread(refresh)
   except Exception:
    refresh()
 def _prog_notify(self):
  fn = getattr(getattr(self, "_editor", None), "_lib_progress_refresh", None)
  if fn is not None:
   try:
    fn()
   except Exception:
    pass
 def _prog_set(self, key, done, total=0):
  self.__dict__.setdefault("_prog_tasks", {})[key] = (int(done), int(total), time.time())
  self._prog_notify()
 def _prog_end(self, key):
  if self.__dict__.setdefault("_prog_tasks", {}).pop(key, None) is not None:
   self._prog_notify()
 def _prog_end_kind(self, kind):
  tasks = self.__dict__.setdefault("_prog_tasks", {})
  for k in [k for k in tasks if k[0] == kind]:
   tasks.pop(k, None)
  self._prog_notify()
 def _library_ui_active(self):
  try:
   ed = getattr(self, "_editor", None)
   return ed is not None and getattr(ed, "tab", None) == "library"
  except Exception:
   return False
 def _prog_state(self):
  tasks = self.__dict__.setdefault("_prog_tasks", {})
  now = time.time()
  for k in [k for k, v in tasks.items() if now - v[2] > 120]:
   tasks.pop(k, None)
  if not tasks:
   return None
  fetch = [min(1.0, d / t) for k, (d, t, _) in tasks.items() if k[0] != "each" and t > 0]
  ff = sum(fetch) / len(fetch) if fetch else 0.0
  eaches = [(d, t) for k, (d, t, _) in tasks.items() if k[0] == "each" and t > 0]
  if eaches:
   frac = sum(min(1.0, (d + ff) / t) for d, t in eaches) / len(eaches)
  elif fetch:
   frac = ff
  else:
   return -1
  return max(0, min(100, int(frac * 100)))
 def _net_ok(self):
  try:
   return bool(_jc("org.telegram.tgnet.ConnectionsManager").isNetworkOnline())
  except Exception:
   return True
 def _cache_clear_row(self):
  text = "Clear offline library cache"
  def do_clear(dlg=None):
   try:
    freed = self._tstore.clear()
    self._chat_track_cache.clear()
    self._msg_cache.clear()
    self._bulletin(f"Offline cache cleared ({freed / 1048576:.1f} MB)")
   except Exception:
    pass
   if dlg is not None:
    dlg.dismiss()
  def run(*_a):
   def show():
    try:
     fragment = get_last_fragment()
     act = fragment.getParentActivity() if fragment is not None else None
     if act is None:
      do_clear()
      return
     sh = _NativeSheet(act, "Clear offline cache?",
 "All saved track lists are deleted from this device and fetched "
 "again when needed. Playlists and library chats are kept.")
     sh.primary_button("Clear cache", lambda: do_clear(sh.dlg), color=sh.c_red)
     sh.secondary_row(("Cancel", sh.dlg.dismiss))
     sh.show()
    except Exception:
     pass
   try:
    run_on_ui_thread(show)
   except Exception:
    show()
  if Text is not None:
   try:
    return Text(text=text, icon="msg_delete", accent=True, on_click=run)
   except Exception:
    pass
  return Switch(key="clear_offline_cache_now", text=text, default=False,
 subtext="Deletes the saved track lists; they are fetched again when needed.",
 on_change=lambda v: run() if v else None)
 @staticmethod
 def _msg_key(m):
  try:
   return (int(m.getId()), int(m.getDialogId()))
  except Exception:
   return None
 def _playing_key(self, mc):
  try:
   pm = mc.getPlayingMessageObject()
   return self._msg_key(pm) if pm is not None else None
  except Exception:
   return None
 def _chat_messages(self, frag):
  out, seen = [], set()
  def add(m):
   if m is None:
    return
   k = self._msg_key(m)
   if k is not None and k not in seen:
    seen.add(k)
    out.append(m)
  msgs = self._read(frag, "messages")
  if msgs is not None:
   try:
    for i in range(msgs.size()):
     add(msgs.get(i))
   except Exception:
    pass
  if not out:
   try:
    lv = self._read(frag, "chatListView")
    for i in range(int(lv.getChildCount())):
     v = lv.getChildAt(i)
     try:
      add(v.getMessageObject())
     except Exception:
      pass
   except Exception:
    pass
  return out
 def _chat_scope(self, context):
  frag = None
  try:
   frag = get_last_fragment()
  except Exception:
   pass
  loaded = self._chat_messages(frag) if frag is not None else []
  music = []
  for m in loaded:
   try:
    if m.isMusic():
     music.append(m)
   except Exception:
    pass
  dialog_id = 0
  if music:
   try:
    dialog_id = int(music[0].getDialogId())
   except Exception:
    dialog_id = 0
  if not dialog_id and frag is not None:
   dialog_id = self._to_int(self._read(frag, "getDialogId"))
  if not dialog_id:
   try:
    dialog_id = self._to_int(
 context.get("dialog_id") or context.get("userId") or context.get("user_id")) if context else 0
    if not dialog_id and context and context.get("user") is not None:
     dialog_id = self._to_int(self._read(context.get("user"), "id", "user_id"))
   except Exception:
    dialog_id = 0
  topic_id = self._detect_topic_id(frag, music[0] if music else None) if frag is not None else 0
  tracks = []
  for m in music:
   if topic_id:
    mt = self._get_message_topic_id(m, True)
    if mt != 0 and mt != topic_id:
     continue
   tracks.append(m)
  tracks.sort(key=lambda m: int(m.getId()))
  return frag, dialog_id, topic_id, tracks, len(loaded)
 def _chat_account(self, frag, music) -> int:
  for m in music or []:
   try:
    return int(m.currentAccount)
   except Exception:
    break
  acc = self._read(frag, "getCurrentAccount", "currentAccount") if frag is not None else None
  if acc is not None:
   return self._to_int(acc)
  try:
   return int(_jc("org.telegram.messenger.UserConfig").selectedAccount)
  except Exception:
   return 0
 def _fetch_and_insert(self, kind, frag, dialog_id, topic_id, loaded_tracks):
  pkey = ("fetch", int(dialog_id or 0), int(topic_id or 0))
  act = frag.getParentActivity() if frag is not None else None
  if act is None or not dialog_id:
   self._bulletin("Can't determine this chat", error=True)
   return
  scope = "topic" if topic_id else "chat"
  acc = self._chat_account(frag, loaded_tracks)
  sheet = _ProgressSheet(self, act)
  partial = {"continue": False}
  def on_progress(count, total):
   if total and total >= count:
    sheet.set_text(f"{count} of {total} tracks")
   else:
    sheet.set_text(f"{count} tracks found")
   self._prog_set(pkey, count, total if total and total >= count else 0)
  def on_done(tracks, error, cancelled):
   sheet.close()
   self._prog_end(pkey)
   self._request_library_refresh()
   if cancelled and not partial["continue"]:
    return
   used = tracks
   if topic_id == 1 and used:
    try:
     batch = ArrayList()
     for item in used:
      batch.add(item)
     filtered_general = self._filter_messages(batch, 1, None, None)
     used = ([filtered_general.get(i) for i in range(filtered_general.size())]
 if filtered_general is not None else [])
    except Exception:
     pass
   if (error or partial["continue"]) and not tracks and loaded_tracks:
    used = loaded_tracks
    self._bulletin(f"Fetch failed ({error}) – using loaded messages only", error=True)
   elif error and not tracks:
    self._bulletin(f"Couldn't load music: {error}", error=True)
    return
   if not used:
    self._bulletin(f"No music found in this {scope}", error=True)
    return
   mc = self._get_mc()
   pl = self._get_playlist(mc) if mc is not None else None
   if pl is None or pl.size() == 0 or self._playing_key(mc) is None:
    self._bulletin("Playback stopped – start a track first", error=True)
    return
   added = self._queue_bulk_insert(mc, pl, used, next_=(kind == "next"))
   if added:
    where = "next" if kind == "next" else "to the bottom"
    extra = f" (hit the {_MusicFetcher.CAP} limit)" if len(used) >= _MusicFetcher.CAP else ""
    self._bulletin(f"Added {added} track{'s' if added != 1 else ''} {where}{extra}")
   else:
    self._bulletin("Nothing new to add", error=True)
  fetcher = _MusicFetcher(self, acc, dialog_id, topic_id, on_progress, on_done)
  def continue_partial():
   partial["continue"] = True
   fetcher.stop_with_partial()
  def cancel_fetch():
   fetcher.cancel()
   self._prog_end(pkey)
  if not self._library_ui_active():
   sheet.show_progress(f"Loading music of this {scope}…", cancel_fetch,
 on_continue=continue_partial)
  else:
   try:
    sheet.close()
   except Exception:
    pass
  self._prog_set(pkey, 0, 0)
  fetcher.start()
 def _playback_descending(self, L, rev) -> bool:
  desc = asc = 0
  prev = None
  for m in L:
   if m is None:
    continue
   try:
    cur = (int(m.getDialogId()), int(m.getId()))
   except Exception:
    continue
   if prev is not None and prev[0] == cur[0]:
    if cur[1] < prev[1]:
     desc += 1
    elif cur[1] > prev[1]:
     asc += 1
   prev = cur
  if desc != asc:
   return desc > asc
  return not rev
 def _prepare_editable_order(self):
  shuffle_on, rev = self._read_order()
  if shuffle_on and self.get_setting("play_next_disables_shuffle", True):
   self._disable_shuffle()
   shuffle_on, rev = self._read_order()
  return shuffle_on, rev
 def _do_chat_action(self, kind, context):
  try:
   mc = self._get_mc()
   pl = self._get_playlist(mc) if mc is not None else None
   frag, dialog_id, topic_id, tracks, _ = self._chat_scope(context)
   scope = "topic" if topic_id else "chat"
   if kind == "exclude":
    if pl is None or pl.size() == 0:
     self._bulletin("Queue is empty", error=True)
     return
    removed, kept_playing = self._queue_exclude(mc, pl, dialog_id, topic_id)
    if removed:
     note = " (kept the playing track)" if kept_playing else ""
     self._bulletin(f"Excluded {removed} track{'s' if removed != 1 else ''} of this {scope}{note}")
    else:
     self._bulletin(f"Nothing from this {scope} in the queue", error=True)
    return
   if pl is None or pl.size() == 0 or self._playing_key(mc) is None:
    self._bulletin("Start playing a track first", error=True)
    return
   self._fetch_and_insert(kind, frag, dialog_id, topic_id, tracks)
  except Exception:
   self._bulletin("Queue action failed", error=True)
 def _queue_exclude(self, mc, playlist, dialog_id, topic_id):
  self._prepare_editable_order()
  playing = self._playing_key(mc)
  removed = 0
  kept_playing = False
  pmap = None
  try:
   pmap = get_private_field(mc, "playlistMap")
  except Exception:
   pass
  for i in range(playlist.size() - 1, -1, -1):
   m = playlist.get(i)
   if m is None:
    continue
   try:
    if dialog_id and int(m.getDialogId()) != dialog_id:
     continue
    if topic_id and self._get_message_topic_id(m, True) != topic_id:
     continue
   except Exception:
    continue
   if playing is not None and self._msg_key(m) == playing:
    kept_playing = True
    continue
   playlist.remove(i)
   removed += 1
   try:
    if pmap is not None:
     pmap.remove(m.getId())
   except Exception:
    pass
  if removed:
   self._finish_bulk_edit(mc, playlist)
  return removed, kept_playing
 def _queue_exclude_messages(self, messages):
  mc = self._get_mc()
  playlist = self._get_playlist(mc) if mc is not None else None
  if playlist is None or playlist.size() == 0:
   return 0, False
  keys = set()
  for message in messages or []:
   try:
    key = self._msg_key(message)
    if key is not None:
     keys.add(key)
   except Exception:
    pass
  if not keys:
   return 0, False
  self._prepare_editable_order()
  playing = self._playing_key(mc)
  removed = 0
  kept_playing = False
  pmap = None
  try:
   pmap = get_private_field(mc, "playlistMap")
  except Exception:
   pass
  for i in range(playlist.size() - 1, -1, -1):
   message = playlist.get(i)
   if message is None or self._msg_key(message) not in keys:
    continue
   if playing is not None and self._msg_key(message) == playing:
    kept_playing = True
    continue
   playlist.remove(i)
   removed += 1
   try:
    if pmap is not None:
     pmap.remove(message.getId())
   except Exception:
    pass
  if removed:
   self._finish_bulk_edit(mc, playlist)
  return removed, kept_playing
 def _queue_bulk_insert(self, mc, playlist, tracks, next_: bool, keep_order: bool = False) -> int:
  shuffle_on, rev = self._prepare_editable_order()
  raw = [playlist.get(i) for i in range(playlist.size())]
  L = raw if rev else raw[::-1]
  playing = self._playing_key(mc)
  desc = self._playback_descending(L, rev)
  seq = list(tracks) if keep_order else sorted(tracks, key=lambda m: int(m.getId()), reverse=desc)
  seq_pairs = []
  incoming = set()
  for message in seq:
   key = self._msg_key(message)
   if key is None or key == playing or key in incoming:
    continue
   incoming.add(key)
   seq_pairs.append((message, key))
  seq = [message for message, _key in seq_pairs]
  seq_keys = {key for _message, key in seq_pairs}
  queue_pairs = [(message, self._msg_key(message)) for message in L if message is not None]
  if next_:
   rest = [message for message, key in queue_pairs
 if key not in seq_keys or key == playing]
   pp = -1
   for i, message in enumerate(rest):
    if self._msg_key(message) == playing:
     pp = i
     break
   new = rest[:pp + 1] + seq + rest[pp + 1:] if pp >= 0 else rest + seq
   added = len(seq)
  else:
   existing = {key for _message, key in queue_pairs if key is not None}
   add = [message for message, key in seq_pairs if key not in existing]
   new = L + add
   added = len(add)
  if added == 0:
   return 0
  order = new if rev else new[::-1]
  playlist.clear()
  for m in order:
   playlist.add(m)
  for m in seq:
   self._map_put(mc, m)
  self._finish_bulk_edit(mc, playlist)
  if shuffle_on:
   self._bulletin("Shuffle is on – order applies once shuffle is off")
  return added
 def _shuffle_queue(self):
  mc = self._get_mc()
  pl = self._get_playlist(mc) if mc is not None else None
  if pl is None or pl.size() < 2:
   return None
  _, rev = self._prepare_editable_order()
  raw = [pl.get(i) for i in range(pl.size())]
  snapshot = list(raw)
  L = raw if rev else raw[::-1]
  playing = self._playing_key(mc)
  cur = [m for m in L if playing is not None and m is not None and self._msg_key(m) == playing][:1]
  others = [m for m in L if m is not None and not (cur and m is cur[0])
 and not (playing is not None and self._msg_key(m) == playing)]
  random.shuffle(others)
  new = cur + others
  if len(new) != len(L):
   return None
  for i, m in enumerate(new if rev else new[::-1]):
   pl.set(i, m)
  self._finish_bulk_edit(mc, pl)
  return snapshot
 def _restore_queue(self, snapshot) -> bool:
  mc = self._get_mc()
  pl = self._get_playlist(mc) if mc is not None else None
  if pl is None or pl.size() != len(snapshot):
   return False
  for i, m in enumerate(snapshot):
   pl.set(i, m)
  self._finish_bulk_edit(mc, pl)
  return True
 def _show_in_chat(self, msg):
