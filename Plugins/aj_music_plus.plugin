  except Exception:
   pass
  box.addView(pb, self.LP(self.dp(22), self.dp(22)))
  tv = self._text("", 13, self.c_text, bold=True, gravity=17, single=False)
  tv.setPadding(self.dp(5), 0, 0, 0)
  box.addView(tv, self.LP(-2, -2))
  box.setVisibility(idle)
