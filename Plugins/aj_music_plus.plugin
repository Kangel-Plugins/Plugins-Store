  except Exception:
   return False
 def _lib_render_track_rows(self, count, row_at, playlist_id=None, tail=None):
  shown = min(count, self.PAGE_ROWS)
  self.lib_track_loader = {"count": count, "row_at": row_at, "rendered": 0,
