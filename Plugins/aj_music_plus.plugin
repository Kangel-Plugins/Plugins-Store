  btn.setOnClickListener(self.Click(lambda v: self._set_tab("library")))
  lp = self.LP(-2, self.dp(44))
  lp.topMargin = self.dp(22)
  box.addView(btn, lp)
  try:
   saved = self.p._qc_persisted()
  except Exception:
   saved = None
  if saved is not None:
   n = len(saved["tracks"])
   rb = self._text(f"Resume last queue \u00b7 {n} track{'s' if n != 1 else ''}",
 14, self.c_accent, bold=True, gravity=17)
   rb.setPadding(self.dp(16), 0, self.dp(16), 0)
