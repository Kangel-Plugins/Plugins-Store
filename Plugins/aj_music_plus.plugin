 def _pick_forward(self, msg):
  try:
   items = [m for m in (msg if isinstance(msg, (list, tuple)) else [msg]) if m is not None]
   if not items:
    return
   frag = get_last_fragment()
   lst = ArrayList()
   for m in items:
