  friend = self._lib_friend(user_id)
  if friend is None:
   self._lib_go("home")
   return
  uid = int(friend.get("d", friend.get("id", 0)) or 0)
  name = str(friend.get("n", "Profile"))
  cached = p._friend_track_cache.get((int(friend.get("a", 0) or 0), uid))
  meta = (self._lib_tracks_meta(len(cached), self._lib_message_minutes(cached))
 if cached is not None else "Profile playlist")
  def rescan():
   p._friend_track_cache.pop((int(friend.get("a", 0) or 0), uid), None)
   self._lib_fetch_friend_tracks(uid, act, force=True)
   self._lib_render()
  def remove():
   snap = (list(p._lib_data()["friends"]), None)
   p._lib_data()["friends"] = [f for f in p._lib_data()["friends"]
 if int(f.get("d", f.get("id", 0)) or 0) != uid]
   p._friend_track_cache.pop((int(friend.get("a", 0) or 0), uid), None)
   p._lib_save()
   self._lib_go("home")
   self._lib_undo_list("friends", snap, f"Removed “{name}”")
  p._collection_sheet(
 act, name, meta,
 lambda: self._lib_fetch_friend_tracks(uid, act, lambda found:
 p._lib_play_msgs(found, "next", name=name)),
 lambda: p._lib_add_to_sheet(act, lambda cb: self._lib_fetch_friend_tracks(uid, act, cb), name, name),
 select=lambda: self._lib_select_all_menu(),
 exclude=lambda: p._exclude_from_queue(cached, name),
 extras=[
 ("Rescan", "Refresh this user's public profile playlist", False, rescan),
 ("Open profile", "View the user's Telegram profile", False,
 lambda: p._open_profile_user(uid, int(friend.get("a", 0) or 0)))],
 danger=[("Remove from Library", "This only removes the saved shortcut", True, remove)],
 header_action=(("msg_viewintopic", "msg_openin", "msg_profile"),
 "Open profile", lambda: p._open_profile_user(uid, int(friend.get("a", 0) or 0)), "↗"))
 def _lib_friend_view(self, user_id):
  p = self.p
  friend = self._lib_friend(user_id)
  if friend is None:
   self._lib_go("home")
   return
  uid = int(friend.get("d", friend.get("id", 0)) or 0)
  acc = int(friend.get("a", 0) or 0)
  name = str(friend.get("n", "Profile"))
  key = (acc, uid)
  self._lib_set_selection_context(("friend", uid))
  msgs = p._friend_track_cache.get(key)
  busy_f = getattr(self, "lib_friend_loading", set())
  if msgs is not None and key not in busy_f and \
 bool(p.get_setting("lib_auto_refresh", False)) and \
 time.time() - p.__dict__.setdefault("_lib_fresh", {}).get(("f",) + key, 0) > self._LIB_TTL:
   p._friend_track_cache.pop(key, None)
   msgs = None
  if msgs is not None:
   friend["cn"] = len(msgs)
   friend["cm"] = self._lib_message_minutes(msgs)
  meta = self._lib_tracks_meta(len(msgs), self._lib_message_minutes(msgs)) if msgs is not None else "Loading profile playlist…"
  self._lib_detail_header(name, meta,
 lambda: self._lib_go("home"),
 lambda: self._lib_friend_menu(uid),
 avatar_did=uid, avatar_acc=acc)
  if msgs is None:
   self._lib_empty_loading_view("Loading profile playlist…")
   self._lib_fetch_friend_tracks(uid, self.act)
   return
  self._lib_detail_actions(
 lambda: p._lib_play_msgs(msgs, "play", name=name, source_key=("friend", uid)),
 lambda: p._lib_play_msgs(msgs, "play", shuffle=True, name=name, source_key=("friend", uid)),
 )
  if not msgs:
   self._lib_hint("No public music was found. Rescan after the user updates their profile playlist.")
   return
  def row_at(i):
   m = msgs[i]
   on_click = lambda mm=m: p._lib_play_msgs(
 msgs, "play", start=p._msg_key(mm), name=name, source_key=("friend", uid))
   on_more = lambda mm=m: self._lib_track_menu(mm)
   return m, None, on_click, on_more
  self._lib_render_track_rows(len(msgs), row_at)
 def _build_lyrics_page(self):
  FL = jclass("android.widget.FrameLayout")
  FLP = jclass("android.widget.FrameLayout$LayoutParams")
  LL = jclass("android.widget.LinearLayout")
  page = FL(self.act)
  self.lyr_sv = jclass("android.widget.ScrollView")(self.act)
  self.lyr_sv.setVerticalScrollBarEnabled(False)
  self.lyr_col = LL(self.act)
  self.lyr_col.setOrientation(1)
  self.lyr_col.setPadding(self.dp(20), self.dp(24), self.dp(20), self.dp(24))
  self.lyr_sv.addView(self.lyr_col, self.LP(-1, -2))
  page.addView(self.lyr_sv, FLP(-1, -1))
  self.lyr_status = self._text("", 14, self.c_sub, gravity=17)
  self.lyr_status.setPadding(self.dp(24), 0, self.dp(24), 0)
  page.addView(self.lyr_status, FLP(-1, -2, 17))
  self.lyr_run = self.Run(self._lyr_tick)
  self._lyr_running = False
  self.lyr_key = None
  self.lyr_data = None
  self.lyr_views = []
  self.lyr_active = -1
  self.lyr_word = -1
  self.lyr_token = 0
  self.lyr_cache = {}
  return page
 def _lyr_start(self):
  if self._lyr_running:
   return
  self._lyr_running = True
  self.handler.removeCallbacks(self.lyr_run)
  self.handler.post(self.lyr_run)
 def _lyr_tick(self):
  try:
   if self.tab != "lyrics" or not self.dialog.isShowing():
    self._lyr_running = False
    return
   self._lyr_update()
  except Exception:
   pass
  self.handler.postDelayed(self.lyr_run, 80)
 def _lyr_set_status(self, text):
  self.lyr_status.setText(text)
  self.lyr_status.setVisibility(0 if text else 8)
 def _lyr_update(self):
  _, pm = self._mini_playing()
  if pm is None:
   if self.lyr_key is not None:
    self.lyr_key = None
    self.lyr_data = None
    self.lyr_col.removeAllViews()
   self._lyr_set_status("Nothing is playing")
   return
  key = self._key(pm)
  if key != self.lyr_key:
   self._lyr_load(key, pm)
   return
  data = self.lyr_data
  if not data or data["kind"] == "plain":
   return
  dur = float(pm.getDuration())
  pos = int(float(pm.audioProgress) * dur * 1000)
  lines = data["lines"]
  idx = -1
  for i, l in enumerate(lines):
   if l["t"] <= pos:
    idx = i
   else:
    break
  if idx != self.lyr_active:
   self._lyr_style_active(idx)
  line = lines[idx] if idx >= 0 else None
  if line and line["w"]:
   wi = -1
   for i, w in enumerate(line["w"]):
    if w[0] <= pos:
     wi = i
    else:
     break
   if wi != self.lyr_word:
    self.lyr_word = wi
    self._lyr_paint_words(idx, wi)
 def _lyr_dim(self, active=False):
  return _mix(self.c_bg, self.c_text, 0.5 if active else 0.32)
 def _lyr_load(self, key, pm):
  self.lyr_key = key
  self.lyr_data = None
  self.lyr_active = -1
  self.lyr_word = -1
  self.lyr_token += 1
  token = self.lyr_token
  self.lyr_col.removeAllViews()
  self.lyr_views = []
  if key in self.lyr_cache:
   self._lyr_apply(self.lyr_cache[key])
   return
  self._lyr_set_status("Loading lyrics…")
  title, artist = self._title_of(pm), self._author_of(pm)
  try:
   dur = int(pm.getDuration())
  except Exception:
   dur = 0
  album = ""
  ed = self
  def done(res):
   if token != ed.lyr_token:
    return
   ed.lyr_cache[key] = res
   ed._lyr_apply(res)
  def work():
   try:
    res = _lyr_fetch(title, artist, album, dur)
   except Exception:
    res = None
   run_on_ui_thread(lambda: done(res))
  threading.Thread(target=work, daemon=True).start()
 def _lyr_apply(self, data):
  self.lyr_data = data
  self.lyr_views = []
  self.lyr_col.removeAllViews()
  if not data:
   self._lyr_set_status("No lyrics found")
   return
  self._lyr_set_status("")
  plain = data["kind"] == "plain"
  for i, l in enumerate(data["lines"]):
   text = l["text"] or ("" if plain else "♪")
   tv = self._text(text, 16 if plain else 24, self.c_text if plain else self._lyr_dim(),
 bold=not plain, gravity=3)
   tv.setPadding(0, self.dp(6 if plain else 10), 0, self.dp(6 if plain else 10))
   if not plain:
    tv.setOnClickListener(self.Click(lambda v, k=i: self._lyr_seek(k)))
   self.lyr_col.addView(tv, self.LP(-1, -2))
   self.lyr_views.append(tv)
  foot = self._text("Lyrics: " + data["src"], 11, self.c_sub, gravity=3)
  foot.setPadding(0, self.dp(28), 0, self.dp(60))
  self.lyr_col.addView(foot, self.LP(-1, -2))
  self.lyr_sv.scrollTo(0, 0)
 def _lyr_style_active(self, idx):
  old = self.lyr_active
  self.lyr_active = idx
  self.lyr_word = -1
  views = self.lyr_views
  if 0 <= old < len(views):
   views[old].setText(self.lyr_data["lines"][old]["text"] or "♪")
   views[old].setTextColor(self._lyr_dim())
  if not (0 <= idx < len(views)):
   return
  line = self.lyr_data["lines"][idx]
  tv = views[idx]
  if line["w"]:
   self._lyr_paint_words(idx, -1)
  else:
   tv.setTextColor(self.c_text)
  try:
   y = int(tv.getTop()) + int(tv.getHeight()) // 2 - int(self.lyr_sv.getHeight()) // 2
   self.lyr_sv.smoothScrollTo(0, max(0, y))
  except Exception:
   pass
 def _lyr_paint_words(self, idx, wi):
  line = self.lyr_data["lines"][idx]
  tv = self.lyr_views[idx]
  sp = jclass("android.text.SpannableString")(line["text"])
  FG = jclass("android.text.style.ForegroundColorSpan")
  dim = self._lyr_dim(True)
  n = len(line["text"])
  sung = 0
  if wi >= 0:
   sung = min(n, len("".join(w[2] for w in line["w"][:wi + 1]).rstrip()))
  if sung:
   sp.setSpan(FG(int(self.c_text)), 0, sung, 33)
  if sung < n:
   sp.setSpan(FG(int(dim)), sung, n, 33)
  tv.setText(sp)
 def _lyr_seek(self, i):
  try:
   mc, pm = self._mini_playing()
   dur = float(pm.getDuration()) * 1000.0
   frac = max(0.0, min(1.0, self.lyr_data["lines"][i]["t"] / dur))
   mc.seekToProgress(pm, jfloat(frac) if jfloat else frac)
  except Exception:
   pass
 def _frame_touch(self, e) -> bool:
  a = int(e.getActionMasked())
  y = float(e.getY())
  top = float(self.root.getTop())
  if a == 0:
   self._out = (y < top) and self.drag is None and self.sh is None
   return self._out
  if not self._out:
   return False
  if a == 1:
   self._out = False
   if y < top:
    try:
     self.dialog.dismiss()
    except Exception:
     pass
   return True
  if a == 3:
   self._out = False
  return True
 def _calc_min_h(self) -> int:
  try:
   idx = int(self.p.get_setting("sheet_min_height", 4))
  except Exception:
   idx = 3
  pct = 30 + 10 * max(0, min(5, idx))
  h = int(self.screen_h * pct / 100.0)
  floor = self.dp(340)
  try:
   MS = jclass("android.view.View$MeasureSpec")
   w = int(self.act.getResources().getDisplayMetrics().widthPixels)
   self.stage.setVisibility(8)
   self.root.measure(MS.makeMeasureSpec(w, 1 << 30), MS.makeMeasureSpec(0, 0))
   fixed = int(self.root.getMeasuredHeight())
   self.stage.setVisibility(0)
   if fixed > 0:
    floor = fixed + int(self.H * 1.5)
  except Exception:
   try:
    self.stage.setVisibility(0)
   except Exception:
    pass
  h = max(h, floor)
  return int(min(h, self.h_max - self.dp(40)))
 def _set_h(self, h):
  if self.tabmode:
   return
  self.cur_h = int(h)
  try:
   FLP = jclass("android.widget.FrameLayout$LayoutParams")
   self.root.setLayoutParams(FLP(-1, int(h), 80))
  except Exception:
   pass
 def _animate_h(self, target, gone=False, done=None):
  a = self.cur_h
  n = 10
  self._anim_id += 1
  my = self._anim_id
  if gone:
   self._closing = True
  def step(k):
   if self._anim_id != my:
    return
   t = k / float(n)
   e = 1.0 - (1.0 - t) ** 3
   self._set_h(a + (target - a) * e)
   if k < n:
    self.handler.postDelayed(self.Run(lambda: step(k + 1)), 16)
   elif gone:
    try:
     self.dialog.dismiss()
    except Exception:
     pass
   else:
    self._load_visible_covers()
    if done is not None:
     done()
  step(1)
 def _sd_skip(self, ev):
