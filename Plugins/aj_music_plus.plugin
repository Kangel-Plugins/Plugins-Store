   search = DA(args)
   search.setInitialSearchString(query)
   music_type = 3
   try:
    search.setInitialSearchType(int(music_type))
   except Exception:
    pass
   frag.presentFragment(search)
  except Exception:
   self._bulletin("Couldn't open artist search", error=True)
 def _open_plugin_settings(self):
  def begin():
   editor = getattr(self, "_editor", None)
   if editor is not None:
    try:
     if editor.dialog is not None and bool(editor.dialog.isShowing()):
      editor.dialog.dismiss()
      self._post(self._present_plugin_settings, 220)
      return
    except Exception:
     pass
   self._present_plugin_settings()
  try:
   run_on_ui_thread(begin)
  except Exception:
   begin()
 def _present_plugin_settings(self):
  try:
   from com.exteragram.messenger.plugins import PluginsController
   from com.exteragram.messenger.plugins.ui import PluginSettingsActivity
   fragment = get_last_fragment()
   if fragment is None:
    raise RuntimeError("No active Telegram fragment")
   controller = PluginsController.getInstance()
   registry = controller.plugins
   installed = None
   try:
    installed = registry.get(__id__)
   except Exception:
    pass
   if installed is None:
    try:
     installed = registry.get(getattr(self, "id", __id__))
    except Exception:
     pass
   if installed is None:
    try:
     values = registry.values().toArray()
    except Exception:
     values = []
    for candidate in values:
     try:
      candidate_id = str(getattr(candidate, "id", ""))
      candidate_name = str(getattr(candidate, "name", ""))
      if candidate_id == __id__ or candidate_name == __name__:
       installed = candidate
       break
     except Exception:
      continue
   if installed is None:
    raise RuntimeError("Music + is not registered with the plugin controller")
   fragment.presentFragment(PluginSettingsActivity(installed))
  except Exception:
   self._bulletin("Couldn't open Music + settings", error=True)
 def _open_tg_player(self):
  frag = get_last_fragment()
  act = frag.getParentActivity() if frag is not None else None
  AP = find_class("org.telegram.ui.Components.AudioPlayerAlert")
  alert = None
  self._native_once = True
  self._post(lambda: setattr(self, "_native_once", False), 2500)
  for args in ((act, None), (act,)):
   try:
    alert = AP(*args)
    break
   except Exception:
    pass
  if alert is None:
   self._bulletin("Couldn't open Telegram's player", error=True)
   return
  try:
   if frag is not None:
    frag.showDialog(alert)
   else:
    alert.show()
  except Exception:
   self._bulletin("Couldn't open Telegram's player", error=True)
 def _is_downloaded(self, m) -> bool:
  want = 0
  try:
   doc = m.getDocument()
   want = int(doc.size) if doc is not None else 0
  except Exception:
   pass
  def _complete(f) -> bool:
   try:
    if f is None or not bool(f.exists()):
     return False
    n = int(f.length())
    return n > 0 and (want <= 0 or n >= want)
   except Exception:
    return False
  try:
   FileLoader = find_class("org.telegram.messenger.FileLoader")
   f = FileLoader.getInstance(int(m.currentAccount)).getPathToMessage(m.messageOwner)
   if _complete(f):
    return True
  except Exception:
   pass
  try:
   path = m.messageOwner.attachPath
   if path and str(path).strip():
    return _complete(jclass("java.io.File")(str(path)))
  except Exception:
   pass
  return False
 def _reverse_queue(self) -> int:
  mc = self._get_mc()
  if mc is None:
   return 0
  shuffle_on, rev = self._prepare_editable_order()
  pl = self._get_playlist(mc)
  if pl is None or pl.size() < 2:
   return 0
  logical_rev = bool(rev and not shuffle_on)
  raw = [pl.get(i) for i in range(pl.size())]
  logical = raw if logical_rev else raw[::-1]
  updated = logical[::-1]
  stored = updated if logical_rev else updated[::-1]
  for i, msg in enumerate(stored):
   pl.set(i, msg)
  if shuffle_on:
   pass
  else:
   self._resync_current(mc, pl)
  return len(updated)
 def _offline_target(self, target):
  try:
   if not target.isMusic() or getattr(self, "_allow_remote", False):
    return None
   if self._is_downloaded(target):
    return None
   mc = self._get_mc()
   pl = self._get_playlist(mc) if mc is not None else None
   playing = self._playing_key(mc) if mc is not None else None
   if pl is None or playing is None:
    return None
   shuffle_on, rev = self._read_order()
   if shuffle_on:
    sp = get_private_field(mc, "shuffledPlaylist")
    L = [sp.get(i) for i in range(sp.size())] if sp is not None else []
   else:
    raw = [pl.get(i) for i in range(pl.size())]
    L = raw if rev else raw[::-1]
   keys = [self._msg_key(m) if m is not None else None for m in L]
   if playing not in keys or self._msg_key(target) not in keys:
    return None
   pidx, tidx = keys.index(playing), keys.index(self._msg_key(target))
   if abs(tidx - pidx) != 1:
    return None
   step = tidx - pidx
   j = tidx
   while 0 <= j < len(L):
    if L[j] is not None and self._is_downloaded(L[j]):
     return L[j]
    j += step
   return False
  except Exception:
   return None
 def _install_playfail_hook(self):
  MediaController = find_class("org.telegram.messenger.MediaController")
  if MediaController is None:
   return
  plugin = self
  class PlayFailHook(MethodHook):
   def after_hooked_method(self, param):
    try:
     if not param.args or param.args[0] is None:
      return
     target = param.args[0]
     if not target.isMusic() or plugin._is_downloaded(target):
      return
     failed = False
     try:
      failed = param.getResult() is False
     except Exception:
      pass
     plugin._schedule_deleted_check(target, 0.5 if failed else 6.0)
    except Exception:
     pass
  unhooks = self.hook_all_methods(MediaController, "playMessage", PlayFailHook())
  if unhooks:
   self._hooks.extend(unhooks if isinstance(unhooks, list) else [unhooks])
 def _schedule_deleted_check(self, msg, delay):
  try:
   key = (int(msg.getDialogId()), int(msg.getId()))
  except Exception:
   return
  checked = self.__dict__.setdefault("_del_checked", {})
  now = time.time()
  if now - checked.get(key, 0) < 900 or now - self.__dict__.get("_del_last", 0) < 2.0:
   return
  def later():
   try:
    if self._is_downloaded(msg):
     return
    mc = self._get_mc()
    pm = mc.getPlayingMessageObject() if mc is not None else None
    if pm is not None and (int(pm.getDialogId()), int(pm.getId())) == key:
     try:
      if int(pm.audioProgressSec) > 0 or float(pm.audioProgress) > 0.0:
       return
     except Exception:
      pass
    if not self._net_ok():
     return
    checked[key] = time.time()
    self.__dict__["_del_last"] = time.time()
    threading.Thread(target=self._verify_deleted, args=(msg,), daemon=True).start()
   except Exception:
    pass
  def fire():
   run_on_ui_thread(later)
  t = threading.Timer(float(delay), fire)
  t.daemon = True
  t.start()
 def _server_says_deleted(self, msg):
  acc, did, mid = int(msg.currentAccount), int(msg.getDialogId()), int(msg.getId())
  MCtl = _jc("org.telegram.messenger.MessagesController").getInstance(acc)
  channel = False
  if did < 0:
   chat = MCtl.getChat(-did)
   if chat is None:
    return None
   channel = bool(_jc("org.telegram.messenger.ChatObject").isChannel(chat))
  if channel:
   req = _jc("org.telegram.tgnet.TLRPC$TL_channels_getMessages")()
   ic = MCtl.getInputChannel(-did)
   if ic is None:
    return None
   req.channel = ic
  else:
   req = _jc("org.telegram.tgnet.TLRPC$TL_messages_getMessages")()
  try:
   im = _jc("org.telegram.tgnet.TLRPC$TL_inputMessageID")()
   im.id = mid
   req.id.add(im)
  except Exception:
   req.id.add(jclass("java.lang.Integer").valueOf(mid))
  res, err = self._pm_rpc(acc, req, lambda: False, timeout=15.0, retries=0)
  if err is not None or res is None:
   return None
  try:
   lst = res.messages
   for i in range(int(lst.size())):
    m = lst.get(i)
    if int(m.id) != mid:
     continue
    name = str(m.getClass().getSimpleName())
    if name == "TL_messageEmpty":
     return True
    return False
  except Exception:
   return None
  return None
 def _verify_deleted(self, msg):
  try:
   did, mid = int(msg.getDialogId()), int(msg.getId())
   if self._server_says_deleted(msg) is not True:
    return
   removed = self._prune_deleted_track(did, mid)
   if removed:
    def refresh():
     try:
      ed = getattr(self, "_editor", None)
      if ed is not None and ed.dialog.isShowing() and ed.tab == "library":
       ed._lib_render()
     except Exception:
      pass
    run_on_ui_thread(refresh)
  except Exception:
   pass
 def _prune_deleted_track(self, did, mid):
  cache = self._chat_track_cache
  removed = 0
  for ck in list(cache.keys()):
   try:
    if int(ck[0]) != did:
     continue
    lz = cache.get(ck)
    if lz is None:
     continue
    rows = getattr(lz, "rows", None)
    if rows is not None and not any(int(r.get("i", 0)) == mid for r in rows):
     continue
    objs = [m for m in lz if m is not None]
    keep = [m for m in objs if int(m.getId()) != mid]
    if len(keep) == len(objs):
     continue
    if keep:
     cache[ck] = keep
    else:
     cache.forget(ck)
    removed += 1
   except Exception:
    pass
  return removed
 def _install_offline_hook(self):
  MediaController = find_class("org.telegram.messenger.MediaController")
  if MediaController is None:
   return
  plugin = self
  class OfflineHook(MethodHook):
   def before_hooked_method(self, param):
    try:
     if not plugin.get_setting("offline_mode", False) or not param.args:
      return
     target = param.args[0]
     if target is None:
      return
     res = plugin._offline_target(target)
     if res is None:
      return
     if res is False:
      param.setResult(False)
      plugin._notify_once("Offline mode: no more downloaded tracks")
      return
     param.args[0] = res
     plugin._offline_fix = True
    except Exception:
     pass
   def after_hooked_method(self, param):
    if not getattr(plugin, "_offline_fix", False):
     return
    plugin._offline_fix = False
    try:
     mc = plugin._get_mc()
     plugin._resync_current(mc, plugin._get_playlist(mc))
    except Exception:
     pass
  unhooks = self.hook_all_methods(MediaController, "playMessage", OfflineHook())
  if unhooks:
   self._hooks.extend(unhooks if isinstance(unhooks, list) else [unhooks])
 def _queue_move(self, msg, how) -> bool:
  mc = self._get_mc()
  pl = self._get_playlist(mc) if mc is not None else None
  if pl is None or msg is None:
   return False
  _, rev = self._prepare_editable_order()
  raw = [pl.get(i) for i in range(pl.size())]
  L = raw if rev else raw[::-1]
  key = self._msg_key(msg)
  idx = next((i for i, m in enumerate(L) if m is not None and self._msg_key(m) == key), -1)
  if idx < 0:
   return False
  t = {"up": idx - 1, "down": idx + 1, "end": len(L) - 1}[how]
  if t < 0 or t >= len(L) or t == idx:
   return False
  L.insert(t, L.pop(idx))
  for i, m in enumerate(L if rev else L[::-1]):
   pl.set(i, m)
  self._finish_bulk_edit(mc, pl)
  return True
 def _queue_next(self, msg) -> bool:
  mc = self._get_mc()
  pl = self._get_playlist(mc) if mc is not None else None
  return bool(pl is not None and self._queue_bulk_insert(mc, pl, [msg], True))
 def _queue_remove(self, msg) -> bool:
  mc = self._get_mc()
  pl = self._get_playlist(mc) if mc is not None else None
  if pl is None:
   return False
  ok = self._playlist_remove_by_id(mc, pl, msg.getId(), msg.getDialogId())
  self._resync_current(mc, pl)
  return ok
 @staticmethod
 def _is_player_alert(obj) -> bool:
  try:
   return obj is not None and "AudioPlayerAlert" in str(obj.getClass().getName())
  except Exception:
   return False
 def _install_player_hooks(self):
  BottomSheet = find_class("org.telegram.ui.ActionBar.BottomSheet")
  if BottomSheet is None:
   return
  plugin = self
  class PlayerShowHook(MethodHook):
   def before_hooked_method(self, param):
    try:
     obj = param.thisObject
     if not plugin._is_player_alert(obj):
      return
     if getattr(plugin, "_native_once", False):
      plugin._native_once = False
      return
     if not plugin.get_setting("replace_player", True):
      return
     mc = plugin._get_mc()
     pl = plugin._get_playlist(mc) if mc is not None else None
     if pl is None or pl.size() == 0 or plugin._playing_key(mc) is None:
      return
     plugin._blocked_alert = obj
     param.setResult(None)
     def _go():
      try:
       obj.dismiss()
      except Exception:
       pass
      plugin._open_queue_editor()
     try:
      run_on_ui_thread(_go)
     except Exception:
      _go()
    except Exception:
     pass
   def after_hooked_method(self, param):
    try:
     obj = param.thisObject
     if not plugin._is_player_alert(obj):
      return
     blocked = getattr(plugin, "_blocked_alert", None)
     if blocked is not None and blocked == obj:
      plugin._blocked_alert = None
      return
     if plugin.get_setting("native_queue_edit", True):
      plugin._attach_native_queue_edit(obj)
    except Exception:
     pass
  unhooks = self.hook_all_methods(BottomSheet, "show", PlayerShowHook())
  if unhooks:
   self._hooks.extend(unhooks if isinstance(unhooks, list) else [unhooks])
 def _attach_native_queue_edit(self, alert):
  lv = get_private_field(alert, "listView")
  if lv is None:
   return
  plugin = self
  lv.setOnItemLongClickListener(
 _longclick_proxy()(lambda view, pos: plugin._native_long_press(alert, lv, view))
 )
 def _native_long_press(self, alert, lv, view) -> bool:
  msg = self._read(view, "getMessageObject")
  if msg is None:
   return False
  mc = self._get_mc()
  is_playing = self._msg_key(msg) == self._playing_key(mc)
  frag = get_last_fragment()
  ctx = frag.getParentActivity() if frag is not None else None
  if ctx is None:
   ctx = alert.getContext()
  def run(fn):
   def _r():
    try:
     if fn() is False:
      self._bulletin("Couldn't do that", error=True)
    except Exception:
     self._bulletin("Queue action failed", error=True)
    try:
     lv.getAdapter().notifyDataSetChanged()
    except Exception:
     pass
   return _r
  add_to = self._hero_add_to(ctx, msg, False, "Add this track to a playlist")
  hero, extras = [add_to], []
  if not is_playing:
   hero = [("Play next", run(lambda: self._queue_next(msg)), False), add_to,
 ("Remove", run(lambda: self._queue_remove(msg)), True)]
   extras += [("Move up", "", False, run(lambda: self._queue_move(msg, "up"))),
 ("Move down", "", False, run(lambda: self._queue_move(msg, "down")))]
  extras.append(("Open Music + Queue", "", False, lambda: self._open_queue_editor()))
  self._track_sheet(ctx, msg, hero, extras, subtitle="Playing now" if is_playing else "Queue")
  return True
 def _rebuild_shuffle(self, mc, playlist):
  try:
   n = int(playlist.size())
   sp = get_private_field(mc, "shuffledPlaylist")
   if n == 0 or sp is None:
    return
   pi = self._playing_index(mc, playlist)
   if pi < 0:
    pi = 0
   others = [playlist.get(i) for i in range(n) if i != pi]
   random.shuffle(others)
   sp.clear()
   sp.add(playlist.get(pi))
   for m in others:
    sp.add(m)
   self._set_int_field(mc, "currentPlaylistNum", 0)
  except Exception:
   pass
 def _shuffle_sync(self, mc, playlist):
  try:
   sp = get_private_field(mc, "shuffledPlaylist")
   if sp is None:
    return
   cur = self._current_index(mc)
   size = int(sp.size())
   if size == 0 or not (0 <= cur < size):
    self._rebuild_shuffle(mc, playlist)
    return
   have = set()
   for i in range(size):
    k = self._msg_key(sp.get(i))
    if k is not None:
     have.add(k)
   new = []
   for i in range(int(playlist.size())):
    m = playlist.get(i)
    k = self._msg_key(m) if m is not None else None
    if k is not None and k not in have:
     new.append(m)
   for m in new:
    sp.add(random.randint(cur + 1, size), m)
    size += 1
  except Exception:
   self._rebuild_shuffle(mc, playlist)
 def _ensure_shuffle_built(self):
  try:
   shuffle_on, _ = self._read_order()
   if not shuffle_on:
    return
   mc = self._get_mc()
   pl = self._get_playlist(mc) if mc is not None else None
   sp = get_private_field(mc, "shuffledPlaylist") if mc is not None else None
   if pl is None or sp is None or int(pl.size()) == 0:
    return
   if int(sp.size()) != int(pl.size()):
    if int(sp.size()) == 0:
     self._rebuild_shuffle(mc, pl)
    else:
     self._shuffle_sync(mc, pl)
  except Exception:
   pass
 def _install_shuffle_hooks(self):
  MC = find_class("org.telegram.messenger.MediaController")
  for name in ("playNextMessage", "playPreviousMessage", "playNextMessageWithoutOrder"):
   try:
    u = self.hook_all_methods(
 MC, name, _TabHook(self, lambda param: self._ensure_shuffle_built(), None))
    if u:
     self._hooks.extend(u if isinstance(u, list) else [u])
   except Exception:
    pass
 def _sync_order_to(self, mc, msg):
  try:
   playlist = self._get_playlist(mc)
   if playlist is None or msg is None:
    return
   idx = self._index_of(playlist, int(msg.getId()), int(msg.getDialogId()))
   if idx < 0:
    return
   shuffle_on, _ = self._read_order()
   self._set_int_field(mc, "currentPlaylistNum", idx)
   if shuffle_on:
    self._rebuild_shuffle(mc, playlist)
  except Exception:
   pass
 def _finish_bulk_edit(self, mc, playlist):
  shuffle_on, _ = self._read_order()
  if shuffle_on:
   self._rebuild_shuffle(mc, playlist)
  else:
   self._resync_current(mc, playlist)
 def _clear_queue(self):
  mc = self._get_mc()
  pl = self._get_playlist(mc) if mc is not None else None
  if pl is None or pl.size() == 0:
   return 0, False
  playing = self._playing_key(mc)
  keep = [m for m in (pl.get(i) for i in range(pl.size()))
 if playing is not None and m is not None and self._msg_key(m) == playing][:1]
  removed = pl.size() - len(keep)
  if removed <= 0:
   return 0, bool(keep)
  pl.clear()
  try:
   pmap = get_private_field(mc, "playlistMap")
   if pmap is not None:
    pmap.clear()
  except Exception:
   pass
  for m in keep:
   pl.add(m)
   self._map_put(mc, m)
  self._set_int_field(mc, "currentPlaylistNum", 0)
  try:
   sp = get_private_field(mc, "shuffledPlaylist")
   if sp is not None:
    sp.clear()
    for m in keep:
     sp.add(m)
  except Exception:
   pass
  return removed, bool(keep)
 def _do_play_next(self, msg):
  try:
   ok = self._playlist_insert_next(msg)
   self._bulletin("Playing next" if ok else "Could not add as next", error=not ok)
  except Exception:
   self._bulletin("Play next failed", error=True)
 def _do_add_to_queue(self, msg):
  try:
   ok = self._playlist_append(msg)
   self._bulletin("Added to queue" if ok else "Already in queue / no player", error=not ok)
  except Exception:
   self._bulletin("Add to queue failed", error=True)
 def _get_mc(self):
  try:
   mc = get_media_controller()
   if mc is not None:
    return mc
  except Exception:
   pass
  try:
   MC = find_class("org.telegram.messenger.MediaController")
   if MC is not None:
    return MC.getInstance()
  except Exception:
   pass
  return None
 def _get_playlist(self, mc):
  try:
   pl = mc.getPlaylist()
   if pl is not None:
    return pl
  except Exception:
   pass
  try:
   return get_private_field(mc, "playlist")
  except Exception:
   return None
 def _current_index(self, mc) -> int:
  try:
   return int(get_private_field(mc, "currentPlaylistNum"))
  except Exception:
   return -1
 def _map_put(self, mc, msg):
  try:
   pmap = get_private_field(mc, "playlistMap")
   if pmap is not None:
    pmap.put(msg.getId(), msg)
  except Exception:
   pass
 def _index_of(self, playlist, msg_id, dialog_id) -> int:
  for i in range(playlist.size()):
   m = playlist.get(i)
   if m is not None and m.getId() == msg_id and m.getDialogId() == dialog_id:
    return i
  return -1
 def _playlist_append(self, msg) -> bool:
  mc = self._get_mc()
  if mc is None or msg is None:
   return False
  try:
   if not msg.isMusic():
    return False
   playlist = self._get_playlist(mc)
   if playlist is None:
    return False
   if self._index_of(playlist, msg.getId(), msg.getDialogId()) >= 0:
    return False
   playlist.add(msg)
   self._map_put(mc, msg)
   return True
  except Exception:
   return False
 def _read_order(self):
  shuffle_on = reversed_order = False
  try:
   SharedConfig = find_class("org.telegram.messenger.SharedConfig")
   if SharedConfig is not None:
    shuffle_on = bool(getattr(SharedConfig, "shuffleMusic", False))
    reversed_order = bool(getattr(SharedConfig, "playOrderReversed", False))
  except Exception:
   pass
  return shuffle_on, reversed_order
 def _enable_shuffle(self):
  try:
   SharedConfig = find_class("org.telegram.messenger.SharedConfig")
   if SharedConfig is not None:
    try:
     SharedConfig.setPlaybackOrderType(2)
    except Exception:
     SharedConfig.shuffleMusic = True
    return bool(getattr(SharedConfig, "shuffleMusic", True))
  except Exception:
   pass
  return False
 def _enable_reverse(self):
  try:
   SharedConfig = find_class("org.telegram.messenger.SharedConfig")
   if SharedConfig is not None:
    try:
     SharedConfig.setPlaybackOrderType(1)
    except Exception:
     SharedConfig.shuffleMusic = False
     SharedConfig.playOrderReversed = True
  except Exception:
   pass
 def _disable_shuffle(self):
  try:
   SharedConfig = find_class("org.telegram.messenger.SharedConfig")
   try:
    SharedConfig.setPlaybackOrderType(0)
   except Exception:
    SharedConfig.shuffleMusic = False
  except Exception:
   pass
 def _resync_current(self, mc, playlist):
  try:
   shuffle_on, _ = self._read_order()
   if shuffle_on:
    return
   pi = self._playing_index(mc, playlist)
   if pi >= 0:
    self._set_int_field(mc, "currentPlaylistNum", pi)
  except Exception:
   pass
 def _set_int_field(self, mc, name, value) -> bool:
  candidates = []
  if jint is not None:
   candidates.append(lambda: jint(value))
  try:
   from java.lang import Integer
   candidates.append(lambda: Integer(value))
  except Exception:
   pass
  candidates.append(lambda: value)
  for make in candidates:
   try:
    set_private_field(mc, name, make())
    if self._to_int(get_private_field(mc, name)) == value:
     return True
   except Exception:
    continue
  return False
 def _playing_index(self, mc, playlist) -> int:
  playing = None
  try:
   playing = mc.getPlayingMessageObject()
  except Exception:
   pass
  if playing is not None:
   try:
    i = self._index_of(playlist, playing.getId(), playing.getDialogId())
    if i >= 0:
     return i
   except Exception:
    pass
  cur = self._current_index(mc)
  return cur if 0 <= cur < playlist.size() else -1
 def _playlist_insert_next(self, msg) -> bool:
  mc = self._get_mc()
  if mc is None or msg is None:
   return False
  try:
   if not msg.isMusic():
    return False
   playlist = self._get_playlist(mc)
   if playlist is None:
    return False
   msg_id, dialog_id = msg.getId(), msg.getDialogId()
   p = self._playing_index(mc, playlist)
   if p >= 0:
    c = playlist.get(p)
    if c is not None and c.getId() == msg_id and c.getDialogId() == dialog_id:
     return False
   shuffle_on, reversed_order = self._read_order()
   if shuffle_on and self.get_setting("play_next_disables_shuffle", True):
    self._disable_shuffle()
    shuffle_on, reversed_order = self._read_order()
   existing = self._index_of(playlist, msg_id, dialog_id)
   if existing >= 0:
    playlist.remove(existing)
    try:
     pmap = get_private_field(mc, "playlistMap")
     if pmap is not None:
      pmap.remove(msg_id)
    except Exception:
     pass
   p = self._playing_index_after(mc, playlist, p, existing)
   if p < 0:
    insert_at = playlist.size()
   elif reversed_order:
    insert_at = p + 1
   else:
    insert_at = p
   insert_at = max(0, min(insert_at, playlist.size()))
   playlist.add(insert_at, msg)
   self._map_put(mc, msg)
   if not shuffle_on:
    new_p = p + 1 if (p >= 0 and not reversed_order) else p
    if new_p >= 0:
     self._set_int_field(mc, "currentPlaylistNum", new_p)
   else:
    try:
     if hasattr(mc, "buildShuffledPlayList"):
      mc.buildShuffledPlayList()
    except Exception:
     pass
   return True
  except Exception:
   return False
 def _playing_index_after(self, mc, playlist, old_p, removed_at) -> int:
  i = self._playing_index(mc, playlist)
  if i >= 0:
   return i
  if old_p >= 0 and removed_at >= 0 and removed_at < old_p:
   return old_p - 1
  return old_p if old_p < playlist.size() else -1
 def _playlist_remove_by_id(self, mc, playlist, msg_id, dialog_id) -> bool:
  try:
   i = self._index_of(playlist, msg_id, dialog_id)
   if i < 0:
    return False
   playlist.remove(i)
   try:
    pmap = get_private_field(mc, "playlistMap")
    if pmap is not None:
     pmap.remove(msg_id)
   except Exception:
    pass
   try:
    if self._read_order()[0]:
     self._rebuild_shuffle(mc, playlist)
     return True
    cur = self._current_index(mc)
    if cur > i:
     self._set_int_field(mc, "currentPlaylistNum", cur - 1)
    elif cur == i and playlist.size() > 0:
     self._set_int_field(mc, "currentPlaylistNum", min(i, playlist.size() - 1))
   except Exception:
    pass
   return True
  except Exception:
   return False
 def _play_external_rebuild(self, msg):
  mc = self._get_mc()
  if mc is None or msg is None:
   self._bulletin("Player not available", error=True)
   return
  try:
   self._allow_remote = True
   try:
    mc.playMessage(msg)
   finally:
    self._allow_remote = False
  except Exception:
   self._bulletin("Could not rebuild the queue", error=True)
 def _show_tap_behavior_menu(self, msg):
  try:
   frag = get_last_fragment()
   act = frag.getParentActivity() if frag is not None else None
   if act is None:
    self._bulletin("Queue kept unchanged: couldn't open the decision sheet", error=True)
    return
   options = [
 ("Play this track next", "", False, lambda: self._do_play_next(msg)),
 ("Add this track to the end", "", False, lambda: self._do_add_to_queue(msg)),
 None,
 ("Replace the queue", "", False, lambda: self._play_external_rebuild(msg)),
 ]
   _ActionSheet(self, act).show_sheet(
 "Lock queue is enabled",
 "New queue generation requested — what should happen?",
 options,
 )
  except Exception:
   self._bulletin("Queue kept unchanged: couldn't open the decision sheet", error=True)
 def _make_outside_queue_play_hook(self):
  plugin = self
  class OutsideQueuePlayHook(MethodHook):
   def before_hooked_method(self, param):
    try:
     if not param.args or getattr(plugin, "_allow_remote", False):
      return
     msg = param.args[0]
     if msg is None or not msg.isMusic():
      return
     if not plugin.get_setting("lock_queue", False):
      return
     mode = plugin.get_setting("locked_queue_behavior", 2)
     try:
      mode = int(mode)
     except Exception:
      mode = 2
     if mode not in (0, 1, 2):
      mode = 2
     mc = plugin._get_mc()
     pl = plugin._get_playlist(mc) if mc is not None else None
     if pl is None or pl.size() == 0:
      return
     if plugin._index_of(pl, int(msg.getId()), int(msg.getDialogId())) >= 0:
      return
     if mode == 0:
      param.setResult(False)
      if not plugin._queue_next(msg):
       plugin._bulletin("Queue is locked, but this track couldn't be added next", error=True)
      else:
       plugin._bulletin("Added to play next")
     elif mode == 1:
      param.setResult(False)
      if not plugin._playlist_append(msg):
       plugin._bulletin("Queue is locked, but this track couldn't be added", error=True)
      else:
       plugin._bulletin("Added to the end of the queue")
     elif mode == 2:
      param.setResult(False)
      run_on_ui_thread(lambda: plugin._show_tap_behavior_menu(msg))
    except Exception:
     pass
  return OutsideQueuePlayHook()
 def _install_hooks(self):
  MediaController = find_class("org.telegram.messenger.MediaController")
  if MediaController is None:
   return
  tap_unhooks = self.hook_all_methods(
 MediaController, "playMessage", self._make_outside_queue_play_hook()
 )
  if tap_unhooks:
   self._hooks.extend(tap_unhooks if isinstance(tap_unhooks, list) else [tap_unhooks])
  unhooks = self.hook_all_methods(
 MediaController, "setPlaylist", self._make_set_playlist_hook()
 )
  if unhooks:
   self._hooks.extend(unhooks if isinstance(unhooks, list) else [unhooks])
  try:
   unhooks = self.hook_all_methods(
 MediaController, "loadMoreMusic", self._make_load_more_hook()
 )
   if unhooks:
    self._hooks.extend(unhooks if isinstance(unhooks, list) else [unhooks])
  except Exception:
   pass
  try:
   unhooks = self.hook_all_methods(
 MediaController, "cleanupPlayer", self._make_cleanup_hook()
 )
   if unhooks:
    self._hooks.extend(unhooks if isinstance(unhooks, list) else [unhooks])
  except Exception:
   pass
 _qcache = None
 def _qcache_get(self):
  if not bool(self.get_setting("keep_queue_cached", True)):
   return None
  c = self._qcache
  return c if c and c.get("items") else None
 def _qcache_snapshot(self):
  if not bool(self.get_setting("keep_queue_cached", True)):
   return
  mc = self._get_mc()
  pl = self._get_playlist(mc) if mc is not None else None
  if pl is None or int(pl.size()) == 0:
   return
  items = [pl.get(i) for i in range(int(pl.size()))]
  items = [m for m in items if m is not None]
  if not items:
   return
  shuffle_on, rev = self._read_order()
  playing = None
  try:
   playing = mc.getPlayingMessageObject()
  except Exception:
   pass
  if playing is None:
   playing = items[0]
  self._qcache = {
 "items": items,
 "playing": playing,
 "playing_key": self._msg_key(playing),
 "reversed": bool(rev and not shuffle_on),
 "name": self._queue_name,
 "scope": self._queue_scope_key,
 }
  self._qc_live_src = (self._queue_name, self._queue_scope_key)
  try:
   self._qcache_persist_live(items, bool(rev and not shuffle_on))
  except Exception:
   pass
 _QC_CAP = 1000
 _qc_live_sig = None
 def _qc_tracks(self, msgs, reversed_):
  disp = msgs if reversed_ else msgs[::-1]
  out, seen = [], set()
  for m in disp:
   k = self._msg_key(m)
   if k is None or k in seen:
    continue
   seen.add(k)
   out.append(self._lib_track(m))
   if len(out) >= self._QC_CAP:
    break
  return out
 @staticmethod
 def _qc_sig(tracks):
  return hash(tuple((t["i"], t["d"]) for t in tracks))
 def _qcache_persist_live(self, msgs, reversed_):
  tracks = self._qc_tracks(msgs, reversed_)
  src = [self._queue_name, list(self._queue_scope_key) if isinstance(self._queue_scope_key, (tuple, list))
 else None]
  sig = (self._qc_sig(tracks), repr(src))
  if sig == self._qc_live_sig:
   return
  self._qc_live_sig = sig
  self.set_setting("live_queue_v1", json.dumps({"tracks": tracks, "src": src}, separators=(",", ":")))
 def _qcache_write_slot(self, tracks, src=None):
  if len(tracks) < 2:
   return
  d = self._lib_data()
  pl = self._lib_pl("last_queue")
  sn = sk = None
  if src:
   sn = src[0]
   sk = list(src[1]) if isinstance(src[1], (tuple, list)) else None
  if pl is not None and self._qc_sig(pl.get("tracks", [])) == self._qc_sig(tracks) \
 and pl.get("sn") == sn and pl.get("sk") == sk:
   return
  if pl is None:
   pl = {"id": "last_queue", "name": "Last queue",
 "tracks": tracks, "created": int(time.time()), "auto": True}
   d["playlists"].insert(0, pl)
  else:
   pl["tracks"] = tracks
   pl["created"] = int(time.time())
  pl["sn"], pl["sk"] = sn, sk
  self._lib_save()
 def _qcache_slot_from_current(self, new_keys=None):
  if not bool(self.get_setting("keep_queue_cached", True)):
   return
  mc = self._get_mc()
  pl = self._get_playlist(mc) if mc is not None else None
  if pl is None or int(pl.size()) < 2:
   return
  msgs = [pl.get(i) for i in range(int(pl.size()))]
  shuffle_on, rev = self._read_order()
  tracks = self._qc_tracks([m for m in msgs if m is not None], bool(rev and not shuffle_on))
  if new_keys is not None and set((t["i"], t["d"]) for t in tracks) == set(new_keys):
   return
  self._qcache_write_slot(tracks, getattr(self, "_qc_live_src", None))
 def _qcache_promote_live(self):
  if not bool(self.get_setting("keep_queue_cached", True)):
   return
  try:
   d = json.loads(self.get_setting("live_queue_v1", "") or "{}")
   tracks = [t for t in d.get("tracks", []) if isinstance(t, dict) and "i" in t and "d" in t]
  except Exception:
   return
  if tracks:
   src = d.get("src") if isinstance(d.get("src"), list) and len(d["src"]) == 2 else None
   self._qcache_write_slot(tracks, src)
 _qc_ready_msg = None
 _qc_ready_sig = None
 _qc_ready_busy = False
 def _qc_persisted(self):
  if not bool(self.get_setting("keep_queue_cached", True)):
   return None
  pl = self._lib_pl("last_queue")
  return pl if pl and pl.get("tracks") else None
 def _qc_ready_get(self):
  pl = self._qc_persisted()
  if pl is None:
   return None
  tracks = pl["tracks"]
  sig = self._qc_sig(tracks)
  if self._qc_ready_sig == sig:
   return self._qc_ready_msg
  if self._qc_ready_busy:
   return None
  head = tracks[:12]
  keys = [(int(t["i"]), int(t["d"])) for t in head]
  self._lib_cache_queue()
  missing = {}
  for i, dlg in keys:
   if (i, dlg) not in self._msg_cache and (i, dlg) not in self._msg_missing:
    missing.setdefault(dlg, set()).add(i)
  def pick():
   found = [self._msg_cache.get(k) for k in keys]
   found = [m for m in found if m is not None]
   chosen = None
   for m in found:
    try:
     if self._is_downloaded(m):
      chosen = m
      break
    except Exception:
     pass
   self._qc_ready_msg = chosen or (found[0] if found else None)
   self._qc_ready_sig = sig
   self._qc_ready_busy = False
  if not missing:
   pick()
   return self._qc_ready_msg
  self._qc_ready_busy = True
  dialogs = list(missing)
  acc = self._chat_account(None, None)
  def next_dialog():
   if not dialogs:
    pick()
    return
   dlg = dialogs.pop(0)
   def done(found, err, cancelled):
    for m in found:
     k = self._msg_key(m)
     if k:
      self._msg_cache[k] = m
    next_dialog()
   try:
    _MusicFetcher(self, acc, dlg, 0, lambda c, total: None, done, want=missing[dlg]).start()
   except Exception:
    next_dialog()
  next_dialog()
  return None
 def _qc_resume(self, act, first=None):
  pl = self._qc_persisted()
  if pl is None:
   return
  start = self._msg_key(first) if first is not None else None
  tracks = pl["tracks"]
  sk = pl.get("sk")
  key = tuple(sk) if isinstance(sk, list) and sk else None
  if key and key[0] in ("profile_music", "friend") and len(key) >= 2:
   tracks = [t if t.get("pf") else dict(t, pf=int(key[1])) for t in tracks]
  name, src = pl.get("sn") or "Last queue", key or ("playlist", "last_queue")
  self._lib_cache_queue()
  keys = [(int(t["i"]), int(t["d"])) for t in tracks]
  head = [self._msg_cache.get(k) for k in keys]
  head = [m for m in head if m is not None]
  if not head or len(head) == len(keys) or any(t.get("pf") for t in tracks):
   self._lib_play(act, tracks, "play", start=start, name=name, source_key=src)
   return
  self._lib_play_msgs(head, "play", start, name=name, source_key=src)
  have = {self._msg_key(m) for m in head}
  missing = {}
  for i, dlg in keys:
   if (i, dlg) not in have and (i, dlg) not in self._msg_missing:
    missing.setdefault(dlg, set()).add(i)
  dialogs, acc = list(missing), self._chat_account(None, None)
  def finish():
   rest = [self._msg_cache.get(k) for k in keys if k not in have]
   rest = [m for m in rest if m is not None]
   if rest and self._queue_scope_key == src:
    self._lib_play_msgs(rest, "end", keep_order=True, quiet=True)
  def nxt():
   if not dialogs:
    finish()
    return
   dlg = dialogs.pop(0)
   def done(found, err, cancelled):
    for m in found:
     k = self._msg_key(m)
     if k:
      self._msg_cache[k] = m
    nxt()
   try:
    _MusicFetcher(self, acc, dlg, 0, lambda c, total: None, done, want=missing[dlg]).start()
   except Exception:
    nxt()
  nxt()
 def _qcache_install_hooks(self):
  MC = find_class("org.telegram.messenger.MediaController")
  def pm_before(param):
   if not bool(self.get_setting("keep_queue_cached", True)):
    return
   m = param.args[0]
   mc = self._get_mc()
   pl = self._get_playlist(mc) if mc is not None else None
   if m is None or pl is None or int(pl.size()) == 0:
    return
   if self._index_of(pl, int(m.getId()), int(m.getDialogId())) < 0:
    self._qcache_slot_from_current()
  def sp_before(param):
   if not bool(self.get_setting("keep_queue_cached", True)):
    return
   lst = param.args[0]
   keys = []
   for i in range(int(lst.size())):
    k = self._msg_key(lst.get(i))
    if k is not None:
     keys.append(k)
   self._qcache_slot_from_current(keys)
  def after(param):
   self._qcache_snapshot()
  for name, before in (("playMessage", pm_before), ("setPlaylist", sp_before)):
   try:
    u = self.hook_all_methods(MC, name, _TabHook(self, before, after))
    if u:
     self._hooks.extend(u if isinstance(u, list) else [u])
   except Exception:
    pass
 def _qcache_restore(self, first) -> bool:
  c = self._qcache_get()
  mc = self._get_mc()
  if c is None or mc is None:
   return False
  al = ArrayList()
  for m in c["items"]:
   al.add(m)
  did = int(first.getDialogId())
  prev_r = bool(getattr(self, "_allow_remote", False))
  prev_b = bool(getattr(self, "_lib_bypass", False))
  self._allow_remote = True
  self._lib_bypass = True
  started = False
  try:
   for args in ((al, first, did, 0), (al, first, did)):
    try:
     mc.setPlaylist(*args)
     started = True
     break
    except Exception:
     pass
   if started:
    try:
     mc.playMessage(first)
    except Exception:
     pass
  finally:
   self._allow_remote = prev_r
   self._lib_bypass = prev_b
  if started:
   self._queue_name = c.get("name")
   self._queue_scope_key = c.get("scope")
   self._queue_cover_key = None
   self._lib_owned = None
  else:
   self._bulletin("Couldn't restore the last queue", error=True)
  return started
 @staticmethod
 def _called_from_mini_player() -> bool:
  try:
   for el in jclass("java.lang.Thread").currentThread().getStackTrace():
    if "FragmentContextView" in str(el.getClassName()):
     return True
  except Exception:
   pass
  return False
 def _make_cleanup_hook(self):
  plugin = self
  class CleanupHook(MethodHook):
   def before_hooked_method(self, param):
    try:
     plugin._qcache_snapshot()
     if plugin._called_from_mini_player():
      plugin._qcache_slot_from_current()
    except Exception:
     pass
    try:
     if (not plugin.get_setting("lock_queue", False)
 or getattr(plugin, "_cleanup_ok", False)
 or not plugin._called_from_mini_player()):
      return
     args = [bool(a) for a in param.args]
    except Exception:
     return
    param.setResult(None)
    run_on_ui_thread(lambda: plugin._confirm_close_player(args))
  return CleanupHook()
 def _confirm_close_player(self, args):
  frag = get_last_fragment()
  act = frag.getParentActivity() if frag is not None else None
  if act is None:
   return
  def confirm():
   try:
    self.set_setting("lock_queue", False)
   except Exception:
    pass
   self._cleanup_ok = True
   try:
    mc = self._get_mc()
    if mc is not None:
     mc.cleanupPlayer(*args)
   except Exception:
    pass
   finally:
    self._cleanup_ok = False
  _ActionSheet(self, act).show_sheet(
 "Close player?", "The queue is locked",
 [("Close and unlock queue", "Turns off Lock queue", True, confirm)])
 @staticmethod
 def _force_no_load_music(param) -> bool:
  args = param.args
  for i in range(2, len(args)):
   if isinstance(args[i], (bool, Boolean)):
    param.args[i] = False
    return True
  return False
 @staticmethod
 def _global_search_params(args):
  for i in range(3, len(args)):
   a = args[i]
   if a is None or isinstance(a, (bool, int, float, Boolean)):
    continue
   try:
    if "PlaylistGlobalSearchParams" in str(a.getClass().getName()):
     return a
   except Exception:
    continue
  return None
 def _search_query_from_params(self, params) -> Optional[str]:
  value = self._read(params, "query", "searchQuery", "searchingQuery", "q",
 "getQuery", "getSearchQuery")
  try:
   text = str(value or "").strip()
  except Exception:
   text = ""
  return text or None
 def _cancel_topic_hydration(self):
  try:
   fetcher = getattr(self, "_topic_fetcher", None)
   if fetcher is not None:
    fetcher.cancel()
  except Exception:
   pass
  try:
   sheet = getattr(self, "_topic_progress_sheet", None)
   if sheet is not None:
    sheet.close()
  except Exception:
   pass
  pk = getattr(self, "_topic_pkey", None)
  if pk is not None:
   try:
    self._activity_status(pk, None)
    self._prog_end(pk)
   except Exception:
    pass
   self._topic_pkey = None
  self._topic_fetcher = None
  self._topic_progress_sheet = None
  self._topic_hydration_scope = None
  self._topic_hydration_generation = int(getattr(self, "_topic_hydration_generation", 0)) + 1
 def _schedule_topic_queue_hydration(self, current, topic_id, query, expected_filter=None):
  try:
   dialog_id = int(current.getDialogId())
   topic_id = int(topic_id)
   query = str(query or "").strip()
  except Exception:
   return
  if not dialog_id or (not topic_id and not query):
   return
  expected_filter = expected_filter or ("filter", topic_id, query or None)
  scope = (dialog_id, topic_id, query, expected_filter)
  if scope == getattr(self, "_topic_hydration_scope", None):
   return
  self._cancel_topic_hydration()
  self._topic_hydration_scope = scope
  generation = self._topic_hydration_generation
  self._post(lambda: self._start_topic_queue_hydration(current, scope, generation), 250)
 def _start_topic_queue_hydration(self, tapped_message, scope, generation):
  if generation != getattr(self, "_topic_hydration_generation", -1):
   return
  dialog_id, topic_id, query, expected_filter = scope
  scope_label = ("search results" if query and not topic_id
 else "topic search results" if query
 else "this topic")
  if self._active_filter != expected_filter:
   return
  try:
   mc = self._get_mc()
   pl = self._get_playlist(mc) if mc is not None else None
   if mc is None or pl is None or pl.size() == 0:
    self._topic_hydration_scope = None
    return
   acc = self._chat_account(get_last_fragment(), [tapped_message])
   if acc is None:
    acc = int(getattr(tapped_message, "currentAccount", 0) or 0)
   pkey = ("topic_hydrate", int(dialog_id), int(topic_id))
   self._topic_pkey = pkey
   state = {"keys": None, "desc": None, "pending": [], "last": 0.0}
   def alive():
    return (generation == getattr(self, "_topic_hydration_generation", -1)
 and self._active_filter == expected_filter)
   def flush(items, final=False):
    mc_now = self._get_mc()
    pl_now = self._get_playlist(mc_now) if mc_now is not None else None
    pm = mc_now.getPlayingMessageObject() if mc_now is not None else None
    if pl_now is None or pm is None or int(pm.getDialogId()) != int(dialog_id):
     return False
    arr = ArrayList()
    for item in items:
     if item is not None:
      arr.add(item)
    filtered = self._filter_messages(arr, topic_id, query, pm)
    if filtered is None:
     return True
    return self._queue_insert_sorted([filtered.get(i) for i in range(filtered.size())], state, final)
   def on_progress(count, total):
    if alive():
     self._activity_status(pkey, f"Loading {scope_label}: {count} tracks…")
     self._prog_set(pkey, count, total if total and total >= count else 0)
   def on_batch(batch, count, total):
    if not alive():
     return
    state["pending"].extend(batch)
    now = time.time()
    if now - state["last"] >= 0.8:
     items, state["pending"] = state["pending"], []
     state["last"] = now
     try:
      flush(items)
     except Exception:
      pass
   def on_done(tracks, error, cancelled):
    self._activity_status(pkey, None)
    self._prog_end(pkey)
    if generation != getattr(self, "_topic_hydration_generation", -1):
     return
    self._topic_fetcher = None
    if cancelled and not partial["continue"]:
     self._topic_hydration_scope = None
     return
    if self._active_filter != expected_filter:
     return
    if error and not tracks and not state["keys"]:
     self._topic_hydration_scope = None
     self._bulletin(f"Couldn't load all {scope_label}", error=True)
     return
    try:
     items, state["pending"] = state["pending"], []
     if not flush(items, True):
      self._topic_hydration_scope = None
      return
     mc_now = self._get_mc()
     n = int(self._get_playlist(mc_now).size())
     if error:
      self._bulletin(f"Loaded {n} tracks from {scope_label} (partial)", error=True)
     else:
      self._bulletin(f"Loaded {n} tracks from {scope_label}")
    except Exception:
     self._topic_hydration_scope = None
   partial = {"continue": False}
   fetcher = _MusicFetcher(self, acc, dialog_id, topic_id, on_progress, on_done, query=query, on_batch=on_batch)
   self._topic_fetcher = fetcher
   fetcher.start()
  except Exception:
   self._topic_hydration_scope = None
   self._topic_fetcher = None
   self._topic_progress_sheet = None
 def _intercept_locked_playlist_build(self, param) -> bool:
  try:
   if getattr(self, "_allow_remote", False):
    return False
   if not self.get_setting("lock_queue", False):
    return False
   args = param.args
   msg = args[1] if len(args) > 1 else None
   if msg is None:
    return False
   try:
    if not msg.isMusic():
     return False
    msg_id, dialog_id = int(msg.getId()), int(msg.getDialogId())
   except Exception:
    return False
   mc = self._get_mc()
   playlist = self._get_playlist(mc) if mc is not None else None
   if mc is None or playlist is None or playlist.size() == 0:
    return False
   if self._index_of(playlist, msg_id, dialog_id) >= 0:
    return False
   try:
    mode = int(self.get_setting("locked_queue_behavior", 2))
   except Exception:
    mode = 2
   if mode not in (0, 1, 2):
    mode = 2
   if mode == 0:
    param.setResult(None)
    def add_next():
     if not self._queue_next(msg):
      self._bulletin("Queue is locked, but this track couldn't be added next", error=True)
     else:
      self._bulletin("Added to play next")
    run_on_ui_thread(add_next)
    return True
   if mode == 1:
    param.setResult(None)
    def add_end():
     if not self._playlist_append(msg):
      self._bulletin("Queue is locked, but this track couldn't be added", error=True)
     else:
      self._bulletin("Added to the end of the queue")
    run_on_ui_thread(add_end)
    return True
   if mode == 2:
    param.setResult(None)
    run_on_ui_thread(lambda: self._show_tap_behavior_menu(msg))
    return True
  except Exception:
   pass
  return False
 def _is_library_owned_queue(self, messages) -> bool:
  owned = getattr(self, "_lib_owned", None)
  if owned is None or messages is None:
   return False
  try:
   if int(messages.size()) != len(owned[0]):
    return False
   keys = {self._msg_key(messages.get(i)) for i in range(int(messages.size()))}
   return keys == set(owned[0]) and self._queue_scope_key == owned[1]
  except Exception:
   return False
 def _make_set_playlist_hook(self):
  plugin = self
  class SetPlaylistHook(MethodHook):
   def before_hooked_method(self, param):
    try:
     if getattr(plugin, "_lib_bypass", False):
      plugin._force_no_load_music(param)
      return
     if plugin._is_library_owned_queue(param.args[0] if param.args else None):
      plugin._force_no_load_music(param)
      return
     if plugin._intercept_locked_playlist_build(param):
      return
     args = param.args
     messages = args[0] if len(args) > 0 else None
     current = args[1] if len(args) > 1 else None
     if messages is None or current is None:
      return
     size_in = messages.size()
     block_more = True
     fragment = get_last_fragment()
     is_chat = (
 fragment is not None
 and "ChatActivity" in str(fragment.getClass().getName())
 )
     global_search = plugin._global_search_params(args)
     media_search = (
 global_search is not None
 or plugin._is_media_search_active(fragment)
 )
     profile_uid = plugin._profile_activity_user_id(fragment, current)
     if profile_uid:
      plugin._unlock_playlist()
      plugin._name_queue(current, fragment, 0, None)
      return
     if media_search:
      search_query = (plugin._get_search_query(fragment)
 or plugin._search_query_from_params(global_search))
      if block_more:
       plugin._force_no_load_music(param)
       plugin._lock_playlist("media_search")
      else:
       plugin._unlock_playlist()
      plugin._name_queue(current, fragment, 0, search_query or "Search")
      if search_query:
       plugin._schedule_topic_queue_hydration(
 current, 0, search_query, expected_filter="media_search")
      return
     topic_id = 0
     query = None
     if is_chat:
      if plugin.get_setting("respect_topic", True):
       topic_id = plugin._detect_topic_id(fragment, current)
      if plugin.get_setting("respect_hashtag", True):
       query = plugin._get_search_query(fragment)
     if topic_id == 0 and not query:
      plugin._unlock_playlist()
      plugin._name_queue(current, fragment, 0, None)
      return
     plugin._name_queue(current, fragment, topic_id, query)
     filtered = plugin._filter_messages(messages, topic_id, query, current)
     changed = (
 filtered is not None
 and 0 < filtered.size() < size_in
 )
     if changed:
      param.args[0] = filtered
     if block_more:
      plugin._force_no_load_music(param)
      plugin._lock_playlist(("filter", topic_id, query))
     else:
      plugin._unlock_playlist()
     if topic_id or query:
      plugin._schedule_topic_queue_hydration(current, topic_id, query)
     if changed:
      n = filtered.size()
      parts = []
      if topic_id:
       parts.append("topic")
      if query:
       parts.append("search")
      plugin._notify_once(f"Queue filtered ({' + '.join(parts)}): {n} tracks")
     else:
      pass
    except Exception:
     pass
  return SetPlaylistHook()
 def _make_load_more_hook(self):
  plugin = self
  class LoadMoreHook(MethodHook):
   def before_hooked_method(self, param):
    if plugin._active_filter is None:
     return
    try:
     mc = plugin._get_mc()
     if mc is not None and get_private_field(mc, "playlistGlobalSearchParams") is not None:
      return
    except Exception:
     pass
    param.setResult(None)
  return LoadMoreHook()
 def _filter_messages(self, messages, topic_id, search_query, current_message):
  try:
   filtered = ArrayList()
   q = (search_query or "").strip().lower()
   cur_id = cur_dialog = None
   if current_message is not None:
    try:
     cur_id = current_message.getId()
     cur_dialog = current_message.getDialogId()
    except Exception:
     pass
   has_current = False
   for i in range(messages.size()):
    msg = messages.get(i)
    if msg is None:
     continue
    try:
     if not msg.isMusic():
      continue
    except Exception:
     continue
    is_current = False
    try:
     is_current = cur_id is not None and msg.getId() == cur_id and msg.getDialogId() == cur_dialog
    except Exception:
     pass
    keep = is_current
    if not keep:
     keep = True
     if topic_id != 0:
      mt = self._get_message_topic_id(msg, general=True)
      if mt != 0 and mt != topic_id:
       keep = False
     if keep and q and not self._message_matches_query(msg, q):
      keep = False
    if keep:
     filtered.add(msg)
     has_current = has_current or is_current
   if current_message is not None and not has_current:
    filtered.add(0, current_message)
   return filtered if filtered.size() > 0 else None
  except Exception:
   return None
 def _message_matches_query(self, msg, q: str) -> bool:
  parts = []
  def add(val):
   try:
    if val:
     parts.append(str(val))
   except Exception:
    pass
  add(getattr(msg, "messageText", None))
  add(getattr(msg, "caption", None))
  for getter in ("getMusicTitle", "getMusicAuthor", "getFileName"):
   try:
    add(getattr(msg, getter)())
   except Exception:
    pass
  try:
   add(msg.messageOwner.message)
  except Exception:
   pass
  return q in " ".join(parts).lower()
 def _get_message_topic_id(self, msg, general: bool = True) -> int:
  if msg is None:
   return 0
  owner = getattr(msg, "messageOwner", None)
  try:
   MessageObject = find_class("org.telegram.messenger.MessageObject")
   tid = self._to_int(
 MessageObject.getTopicId(msg.currentAccount, owner, bool(general))
 )
   if tid:
    return tid
  except Exception:
   pass
  try:
   rt = getattr(owner, "reply_to", None) if owner is not None else None
   if rt is not None and bool(getattr(rt, "forum_topic", False)):
    for attr in ("reply_to_top_id", "reply_to_msg_id"):
     val = self._to_int(getattr(rt, attr, 0))
     if val:
      return val
  except Exception:
   pass
  return 0
 def _detect_topic_id(self, act, current) -> int:
  tid = self._to_int(self._read(act, *TOPIC_ID_NAMES))
  if tid:
   return tid
  flag = self._read_flag(act, TOPIC_FLAG_NAMES)
  if flag is True:
   return self._get_message_topic_id(current, general=True)
  if flag is None:
   return self._get_message_topic_id(current, general=False)
  return 0
 def _get_search_query(self, act) -> Optional[str]:
  val = self._read(act, *SEARCH_QUERY_NAMES)
  try:
   s = str(val).strip() if val is not None else ""
  except Exception:
   s = ""
  return s or None
 def _is_media_search_active(self, fragment) -> bool:
  if fragment is None:
   return False
  try:
   cls = str(fragment.getClass().getName())
  except Exception:
   cls = ""
  if "MediaActivity" in cls or "ProfileActivity" in cls:
   if self._read_flag(fragment, ("searching", "searchWas")):
    return True
  layout = self._read(fragment, "sharedMediaLayout")
  if layout is not None and self._read_flag(layout, ("searching", "searchWas")):
   return True
  return False
