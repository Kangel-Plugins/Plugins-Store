_LISTENERS = {}
def _proxy(iface, method, adapt=lambda *a: a, ret=False):
 c = _LISTENERS.get((iface, method))
 if c is None:
  ns = {"adapt": adapt, "ret": ret}
  exec(f"""
class L(dynamic_proxy(jclass({iface!r}))):
    def __init__(self, fn):
        super().__init__()
        self.fn = fn

    def {method}(self, *a):
        try:
            r = self.fn(*adapt(*a))
            return bool(r) if ret else None
        except Exception:
            return False if ret else None
""", {"dynamic_proxy": dynamic_proxy, "jclass": jclass, **ns}, ns)
  c = _LISTENERS[(iface, method)] = ns["L"]
 return c
