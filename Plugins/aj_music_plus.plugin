  try:
   self.scroll.setFillViewport(False)
  except Exception:
   pass
  self.rows = []
  self.row_refs = {}
  for i in range(self.win_start, self.win_end):
   row = self._make_row(i, self.items[i], pi)
   self.container.addView(row, self.LP(-1, self.H))
   self.rows.append(row)
