     fp = os.path.join(d, n)
     st = os.stat(fp)
     files.append((st.st_mtime, st.st_size, fp))
     total += st.st_size
   files.sort()
   while total > self.MAX_BYTES and len(files) > 1:
    _, size, fp = files.pop(0)
    self._remove(fp)
    total -= size
