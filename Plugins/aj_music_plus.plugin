def _jc(name):
 try:
  c = find_class(name)
  if c is not None:
   return c
 except Exception:
  pass
 return jclass(name)
_DELEGATE_CLS = None
def _request_delegate(fn):
 global _DELEGATE_CLS
 if _DELEGATE_CLS is None:
  RD = jclass("org.telegram.tgnet.RequestDelegate")
  class Delegate(dynamic_proxy(RD)):
   def __init__(self, f):
    super().__init__()
    self.f = f
   def run(self, response, error):
    self.f(response, error)
  _DELEGATE_CLS = Delegate
 return _DELEGATE_CLS(fn)
class _MusicFetcher:
 PAGE = 100
 CAP = 10000
 def __init__(self, plugin, account, dialog_id, topic_id, on_progress, on_done, query="", want=None, min_id=0, on_batch=None):
  self.p = plugin
  self.on_batch = on_batch
  self.min_id = int(min_id or 0)
  self.want = set(int(x) for x in want) if want else None
  self.acc = account
  self.dialog_id = dialog_id
  self.topic_id = topic_id
  self.query = str(query or "").strip()
  self.on_progress = on_progress
  self.on_done = on_done
  self.tracks = []
  self.seen = set()
  self.total = 0
  self.cancelled = False
  self._last_offset = None
  self._finished = False
 def start(self):
  self._send(0)
 def cancel(self):
  self.cancelled = True
 def stop_with_partial(self):
  if self._finished:
   return
  self.cancelled = True
  self._finish(None)
 def _ui(self, fn):
  try:
   run_on_ui_thread(fn)
  except Exception:
   fn()
 def _send(self, offset_id):
  try:
   TL = _jc("org.telegram.tgnet.TLRPC$TL_messages_search")
   Flt = _jc("org.telegram.tgnet.TLRPC$TL_inputMessagesFilterMusic")
   MCtl = _jc("org.telegram.messenger.MessagesController")
   CM = _jc("org.telegram.tgnet.ConnectionsManager")
   req = TL()
   req.q = self.query
   req.filter = Flt()
   req.limit = self.PAGE
   req.offset_id = int(offset_id)
   if self.min_id:
    req.min_id = self.min_id
   req.peer = MCtl.getInstance(self.acc).getInputPeer(self.dialog_id)
   if self.topic_id and int(self.topic_id) != 1:
    req.flags = int(req.flags) | 2
    req.top_msg_id = int(self.topic_id)
   self._last_offset = offset_id
   CM.getInstance(self.acc).sendRequest(req, _request_delegate(self._on_response))
  except Exception as e:
   self._finish(f"request failed ({e})")
 def _on_response(self, res, err):
  if self.cancelled or self._finished:
   return
  try:
   if err is not None:
    self._finish(str(getattr(err, "text", "error")))
    return
   msgs = getattr(res, "messages", None)
   if msgs is None:
    self._finish(None)
    return
   try:
    MCtl = _jc("org.telegram.messenger.MessagesController")
    inst = MCtl.getInstance(self.acc)
    inst.putUsers(res.users, False)
    inst.putChats(res.chats, False)
   except Exception:
    pass
   MO = _jc("org.telegram.messenger.MessageObject")
   n = int(msgs.size())
   min_id = None
   page_tracks = []
   for i in range(n):
    tl = msgs.get(i)
    mid = int(tl.id)
    if min_id is None or mid < min_id:
     min_id = mid
    if mid in self.seen:
     continue
    try:
     tl.dialog_id = self.dialog_id
    except Exception:
     pass
    try:
     mo = MO(self.acc, tl, False, True)
     if mo.isMusic():
      self.seen.add(mid)
      self.tracks.append(mo)
      page_tracks.append(mo)
    except Exception:
     pass
   try:
    self.total = max(self.total, int(res.count))
   except Exception:
    pass
   cnt, tot = len(self.tracks), self.total
   self._ui(lambda: self.on_progress(cnt, tot))
   if page_tracks and self.on_batch is not None:
    try:
     batch = list(page_tracks)
     self._ui(lambda b=batch, c=cnt, t=tot: self.on_batch(b, c, t))
    except Exception:
     pass
   reached_total = self.total > 0 and len(self.tracks) >= self.total
   exhausted = n == 0 or min_id is None or min_id == self._last_offset
   done = exhausted or reached_total or len(self.tracks) >= self.CAP
   if self.want is not None and self.want <= self.seen:
    done = True
   if self.total <= 0 and n < self.PAGE:
    done = True
   if self.min_id and min_id is not None and min_id <= self.min_id:
    done = True
   if done:
    self._finish(None)
   else:
    self._send(min_id)
  except Exception as e:
   self._finish(f"processing failed ({e})")
 def _finish(self, error):
  if self._finished:
   return
  self._finished = True
  try:
   self.tracks.sort(key=lambda m: int(m.getId()))
  except Exception:
   pass
  tracks, cancelled = self.tracks, self.cancelled
  self._ui(lambda: self.on_done(tracks, error, cancelled))
class _TLCodec:
 _mode = None
 _layer = None
 @classmethod
 def layer(cls):
  if cls._layer is None:
   try:
    cls._layer = int(_jc("org.telegram.tgnet.TLRPC").LAYER)
   except Exception:
    cls._layer = 0
  return cls._layer
 @staticmethod
 def dump(m):
  try:
   sd = _jc("org.telegram.tgnet.SerializedData")()
   m.messageOwner.serializeToStream(sd)
   arr = sd.toByteArray()
   try:
    return bytes(arr)
   except Exception:
    return bytes((b & 255) for b in arr)
  except Exception:
   return None
 @classmethod
 def load(cls, acc, dialog_id, blob):
  try:
   SD = _jc("org.telegram.tgnet.SerializedData")
   makers = (
 lambda b: b,
 lambda b: jarray(jbyte)(b),
 lambda b: jarray(jbyte)([x - 256 if x > 127 else x for x in b]),
 )
   order = ([cls._mode] if cls._mode is not None else []) + \
 [i for i in range(3) if i != cls._mode]
   sd = None
   for i in order:
    try:
     sd = SD(makers[i](blob))
     cls._mode = i
     break
    except Exception:
     continue
   if sd is None:
    return None
   tl = _jc("org.telegram.tgnet.TLRPC$Message").TLdeserialize(sd, sd.readInt32(False), False)
   if tl is None:
    return None
   tl.dialog_id = int(dialog_id)
   return _jc("org.telegram.messenger.MessageObject")(int(acc), tl, False, True)
  except Exception:
   return None
class _ChatIndex:
 __slots__ = ("key", "path", "acc", "ts", "layer", "rows", "_by_id", "_min")
 def __init__(self, key, path, acc, ts, layer, rows):
  self.key, self.path, self.acc, self.ts, self.layer, self.rows = key, path, acc, ts, layer, rows
  self._by_id = None
  self._min = None
 def row_for(self, mid):
  if self._by_id is None:
   self._by_id = {int(r["i"]): r for r in self.rows}
  return self._by_id.get(int(mid))
 def minutes(self):
  if self._min is None:
   total = sum(max(0, int(r.get("s", 0) or 0)) for r in self.rows)
   self._min = max(1, int(round(total / 60.0))) if total else 0
  return self._min
class _TrackStore:
 MAGIC = b"SMQ1"
 VERSION = 1
 MAX_BYTES = 256 * 1024 * 1024
 IDX_CAP = 8
 def __init__(self, plugin):
  self.p = plugin
  self._dir_path = None
  self._lock = threading.RLock()
  self._wlock = threading.Lock()
  self._idx = collections.OrderedDict()
  self._by_dialog = None
  self._en = (0.0, True)
  self.broken = False
 def enabled(self):
  now = time.monotonic()
  if now - self._en[0] > 2.0:
   try:
    on = bool(self.p.get_setting("persist_track_cache", True))
   except Exception:
    on = False
   self._en = (now, on)
  return self._en[1] and not self.broken
 def _dir(self):
  if self._dir_path is None:
   ctx = find_class("org.telegram.messenger.ApplicationLoader").applicationContext
   path = os.path.join(str(ctx.getFilesDir().getAbsolutePath()), "smq_tracks")
   os.makedirs(path, exist_ok=True)
   self._dir_path = path
  return self._dir_path
 @staticmethod
 def _name(key):
  return "c_%d_%d.smq" % (int(key[0]), int(key[1]))
 @staticmethod
 def _parse(name):
  try:
   if name.startswith("c_") and name.endswith(".smq"):
    a, b = name[2:-4].rsplit("_", 1)
    return (int(a), int(b))
  except Exception:
   pass
  return None
 @staticmethod
 def _remove(path):
  try:
   os.remove(path)
  except Exception:
   pass
 def keys(self):
  try:
   return [k for k in (self._parse(n) for n in os.listdir(self._dir())) if k]
  except Exception:
   return []
 def _dialogs(self):
  with self._lock:
   if self._by_dialog is None:
    m = {}
    for k in self.keys():
     m.setdefault(k[0], []).append(k)
    self._by_dialog = m
   return self._by_dialog
 def load_index(self, key):
  key = (int(key[0]), int(key[1]))
  with self._lock:
   idx = self._idx.get(key)
   if idx is not None:
    self._idx.move_to_end(key)
    return idx
  path = os.path.join(self._dir(), self._name(key))
  try:
   with open(path, "rb") as fh:
    fh.seek(-8, os.SEEK_END)
    tail = fh.read(8)
    if tail[4:] != self.MAGIC:
     raise ValueError("bad magic")
    hl = struct.unpack("<I", tail[:4])[0]
    fh.seek(-8 - hl, os.SEEK_END)
    head = json.loads(fh.read(hl).decode("utf-8"))
   if int(head.get("v", 0)) != self.VERSION:
    raise ValueError("schema %s" % head.get("v"))
  except FileNotFoundError:
   return None
  except Exception:
   self._remove(path)
   with self._lock:
    self._by_dialog = None
   return None
  idx = _ChatIndex(key, path, int(head.get("acc", 0)), float(head.get("ts", 0)),
 int(head.get("layer", 0)), head.get("rows") or [])
  with self._lock:
   self._idx[key] = idx
   while len(self._idx) > self.IDX_CAP:
    self._idx.popitem(last=False)
  return idx
 @staticmethod
 def _row(m):
  try:
   try:
    dur = int(m.getDuration())
   except Exception:
    dur = 0
   return {"i": int(m.getId()), "d": int(m.getDialogId()),
 "t": _QueueEditor._title_of(m), "a": _QueueEditor._author_of(m), "s": dur}
  except Exception:
   return None
 def save(self, key, objs, acc):
  key = (int(key[0]), int(key[1]))
  path = os.path.join(self._dir(), self._name(key))
  tmp = path + ".tmp"
  rows, pos = [], 0
  with self._wlock:
   try:
    with open(tmp, "wb") as fh:
     for m in objs:
      blob = _TLCodec.dump(m)
      row = self._row(m) if blob else None
      if row is None:
       continue
      row["o"], row["l"] = pos, len(blob)
      fh.write(blob)
      pos += len(blob)
      rows.append(row)
     if not rows:
      raise RuntimeError("nothing serialisable")
     ts = time.time()
     head = json.dumps({"v": self.VERSION, "layer": _TLCodec.layer(), "acc": int(acc),
 "ts": ts, "key": list(key), "rows": rows},
 separators=(",", ":")).encode("utf-8")
     fh.write(head)
     fh.write(struct.pack("<I", len(head)))
     fh.write(self.MAGIC)
     fh.flush()
     try:
      os.fsync(fh.fileno())
     except Exception:
      pass
    os.replace(tmp, path)
   except Exception:
    self._remove(tmp)
    if not rows and objs:
     self.broken = True
    return None
   idx = _ChatIndex(key, path, int(acc), ts, _TLCodec.layer(), rows)
   with self._lock:
    self._idx[key] = idx
    self._idx.move_to_end(key)
    while len(self._idx) > self.IDX_CAP:
