   if hit is None:
    return None
   m = self._store.hydrate(*hit)
   if m is not None:
    self[k] = m
   return m
  except Exception:
   return None
 def get(self, k, default=None):
  v = dict.get(self, k)
  if v is None:
   v = self._load(k)
  return default if v is None else v
 def __getitem__(self, k):
  if dict.__contains__(self, k):
   return dict.__getitem__(self, k)
  v = self._load(k)
  if v is None:
   raise KeyError(k)
  return v
 def __contains__(self, k):
  if dict.__contains__(self, k):
   return True
  try:
   return bool(self._store.enabled() and self._store.find(k[0], k[1]) is not None)
  except Exception:
   return False
class _LazyTracks:
 def __init__(self, cache, key, idx=None, objs=None):
  self._cache, self.key, self._idx, self._objs = cache, key, idx, objs
 @property
 def rows(self):
  idx = self._idx
  return idx.rows if (idx is not None and self._objs is None) else None
 @property
 def minutes(self):
  idx = self._idx
  return idx.minutes() if (idx is not None and self._objs is None) else None
 def __len__(self):
  objs = self._objs
  if objs is not None:
   return len(objs)
  idx = self._idx
  return len(idx.rows) if idx is not None else 0
 def __bool__(self):
  return len(self) > 0
 def __getitem__(self, n):
  if isinstance(n, slice):
   return [self[i] for i in range(*n.indices(len(self)))]
  objs = self._objs
  if objs is not None:
   return objs[n]
  idx = self._idx
  rows = idx.rows if idx is not None else ()
  if n < 0:
   n += len(rows)
  if n < 0 or n >= len(rows):
   raise IndexError(n)
  row = rows[n]
  k = (int(row["i"]), int(row["d"]))
  msgs = self._cache.p._msg_cache
