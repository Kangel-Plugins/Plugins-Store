 ("sort tracks", ("iv_ordered_list",)),
 ("sort", ("msg2_sort", "msg_sortby", "msg_filter")),
 ("open smart queue manager", ("msg_reorder", "msg_list")),
 ("sleep", SLEEP_ICONS),
 ("turn off timer", ("msg_close",)),
