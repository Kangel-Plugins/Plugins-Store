__id__ = "pill_to_header"
__name__ = "Pill To Header"
__description__ = """Перенос етг островка из поиска в верхнюю панель."""
__author__ = "@RnPlugins"
__version__ = "1.0.0"
__icon__ = "RnDev/26"
__app_version__ = ">=12.9.0"
__sdk_version__ = ">=1.4.3.3"

import base64
from base_plugin import BasePlugin
from java.nio import ByteBuffer
from dalvik.system import InMemoryDexClassLoader
from org.telegram.messenger import ApplicationLoader

DEX_B64 = """"""


class PillToHeaderPlugin(BasePlugin):
    def _invoke_static(self, name):
        for m in self.dex_class.getMethods():
            if m.getName() == name and len(m.getParameterTypes()) == 0:
                m.invoke(None)
                return True
        return False

    def on_plugin_load(self):
        self.dex_class = None
        self.dex_loader = None
        try:
            dex_bytes = base64.b64decode(DEX_B64)
            buffer = ByteBuffer.wrap(dex_bytes)
            parent_cl = ApplicationLoader.applicationContext.getClassLoader()
            self.dex_loader = InMemoryDexClassLoader(buffer, parent_cl)
            self.dex_class = self.dex_loader.loadClass("dev.rooni.pilltoheader.PillToHeader")
            self._invoke_static("start")
        except Exception as e:
            self.log(f"Failed to load Java PillToHeader module: {e}")

    def on_plugin_unload(self):
        try:
            if getattr(self, "dex_class", None) is not None:
                self._invoke_static("stop")
            self.dex_class = None
            self.dex_loader = None
        except Exception as e:
            self.log(f"Failed to unload Java PillToHeader module: {e}")
