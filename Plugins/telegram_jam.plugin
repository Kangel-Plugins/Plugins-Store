def _lang():
    """Plugin language follows the Telegram app language: Russian or English."""
    code = ""
    try:
        from org.telegram.messenger import LocaleController
        controller = LocaleController.getInstance()
        try:
            code = str(controller.getCurrentLocale().getLanguage() or "")
        except Exception:
            info = controller.getCurrentLocaleInfo()
            code = str(getattr(info, "shortName", "") or getattr(info, "pluralLangCode", "") or "")
    except Exception:
        try:
            from java.util import Locale
            code = str(Locale.getDefault().getLanguage() or "")
        except Exception:
            code = "ru"
    return "ru" if code.lower().startswith("ru") else "en"


def _t(text):
    if _lang() == "ru":
        return text
    return STRINGS_EN.get(text, text)


def _version_tuple(value):
    parts = []
    for part in str(value or "").lstrip("vV").split("."):
        try:
            parts.append(int(part))
        except ValueError:
            parts.append(0)
    while parts and parts[-1] == 0:
        parts.pop()
    return tuple(parts)


def _parse_release(release):
    """Reads plugin/server versions from a GitHub release.

    Tag vX.Y is the server version. The plugin version comes from an asset named
    telegram_jam-<version>.plugin or a "plugin: <version>" line in the notes.
    """
    tag = str(release.get("tag_name") or "")
    info = {
        "server_version": tag.lstrip("vV") or None,
        "release_url": release.get("html_url") or GITHUB_URL,
        "plugin_version": None,
        "plugin_url": None,
    }
    for asset in release.get("assets") or []:
        name = str(asset.get("name") or "")
        found = re.match(r"^telegram_jam[-_]v?([0-9][0-9.]*)\.plugin$", name)
        if found or name == "telegram_jam.plugin":
            info["plugin_url"] = asset.get("browser_download_url")
            if found:
                info["plugin_version"] = found.group(1).rstrip(".")
    if not info["plugin_version"]:
        found = re.search(r"plugin\s*[:=]\s*v?([0-9][0-9.]*)", str(release.get("body") or ""), re.I)
        if found:
            info["plugin_version"] = found.group(1).rstrip(".")
    return info


