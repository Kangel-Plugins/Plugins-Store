<style>
:root{color-scheme:dark;--bg-1:#1a0f28;--bg-2:#442064;--bg-3:#7a2db2;--card-strong:rgba(224,224,236,.58);--card-dark:rgba(24,18,36,.66);--text-light:#fbf7ff;--text-dark:#171321;--muted:rgba(255,255,255,.78);--line:rgba(255,255,255,.18);--accent:#ff44f0;--accent-2:#7f5cff;--shadow:0 18px 46px rgba(0,0,0,.18)}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{min-height:100%}
body{margin:0;font-family:"Comfortaa",sans-serif;font-weight:700;color:var(--text-light);overflow-x:hidden;background:radial-gradient(circle at top left,rgba(255,68,240,.22),transparent 28%),radial-gradient(circle at bottom right,rgba(127,92,255,.26),transparent 30%),linear-gradient(135deg,var(--bg-1) 0%,var(--bg-2) 45%,var(--bg-3) 100%);background-attachment:fixed}
.glow{position:fixed;width:34rem;height:34rem;border-radius:50%;filter:blur(70px);opacity:.24;pointer-events:none}
.glow.l{top:-10rem;left:-10rem;background:#ff3adf}.glow.r{right:-12rem;bottom:-12rem;background:#5d83ff}
.shell{position:relative;width:min(460px,calc(100% - 32px));margin:0 auto;padding:calc(env(safe-area-inset-top) + 24px) 0 calc(env(safe-area-inset-bottom) + 32px);display:grid;gap:14px}
.top{display:flex;align-items:center;justify-content:space-between;gap:12px}.topr{display:flex;gap:8px;align-items:center}.pill.x{cursor:pointer;color:inherit;font:inherit;padding:0 12px}
.top h1{margin:0;font-size:1.6rem;line-height:1}
.pill{display:inline-flex;align-items:center;min-height:32px;padding:0 14px;border-radius:999px;border:1px solid var(--line);background:rgba(255,255,255,.1);font-size:.82rem}
.pill.host{background:linear-gradient(90deg,var(--accent),var(--accent-2));border-color:transparent}
.now{display:grid;grid-template-columns:92px minmax(0,1fr);gap:16px;align-items:center;padding:16px;border:1px solid rgba(255,255,255,.2);border-radius:22px;background:linear-gradient(180deg,rgba(214,214,228,.44),rgba(182,182,198,.36));backdrop-filter:blur(14px);box-shadow:var(--shadow)}
.cover{display:grid;place-items:center;aspect-ratio:1;border-radius:18px;border:1px solid rgba(255,255,255,.16);background:var(--card-strong);color:var(--text-dark);font-size:2.4rem;transition:transform .4s ease}
.cover.on{animation:beat 1.4s ease-in-out infinite}@keyframes beat{50%{transform:scale(1.06)}}
.copy{min-width:0;display:grid;gap:6px}
.title{margin:0;color:var(--text-dark);font-size:1.15rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.status{margin:0;color:rgba(23,19,33,.72);font-size:.84rem;line-height:1.4}
.panel{padding:18px;border:1px solid rgba(255,255,255,.16);border-radius:22px;background:var(--card-dark);backdrop-filter:blur(14px);box-shadow:var(--shadow)}
.ctl{transition:opacity .18s ease}.ctl.off{opacity:.45}.ctl.off *{pointer-events:none}
input[type=range]{-webkit-appearance:none;appearance:none;display:block;width:100%;height:6px;margin:6px 0 10px;border-radius:9px;outline:0;background:linear-gradient(90deg,var(--accent),var(--accent-2)) 0/var(--p,0%) 100% no-repeat,rgba(255,255,255,.16)}
input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:20px;height:20px;border-radius:50%;background:#fff;border:0;box-shadow:0 2px 10px rgba(0,0,0,.4)}
.time{display:flex;justify-content:space-between;color:var(--muted);font-size:.78rem;font-variant-numeric:tabular-nums}
.buttons{display:flex;justify-content:center;align-items:center;gap:16px;margin-top:14px}
button{font:inherit;color:#fff;cursor:pointer;transition:background .18s ease,transform .18s ease,opacity .18s ease}
button:active{transform:scale(.95)}
.round{width:52px;height:52px;border-radius:50%;border:1px solid var(--line);background:rgba(255,255,255,.1);font-size:.85rem}
.play{width:70px;height:70px;border-radius:50%;border:0;display:grid;place-items:center;background:linear-gradient(135deg,var(--accent),var(--accent-2));box-shadow:0 10px 30px rgba(255,68,240,.35)}
.play svg{width:28px;height:28px;fill:#fff}
.hint{margin:12px 0 0;text-align:center;color:var(--muted);font-size:.8rem;line-height:1.5}
.peer{display:flex;align-items:center;gap:10px;padding:5px 0;font-size:.92rem}
.peer small{margin-left:auto;color:var(--muted);font-size:.75rem}
.dot{width:9px;height:9px;border-radius:50%;background:rgba(255,255,255,.25)}.dot.on{background:#7dffb0;box-shadow:0 0 10px #7dffb0}
.row{display:flex;align-items:center;justify-content:space-between;gap:14px}
.row p{margin:4px 0 0;color:var(--muted);font-size:.78rem;line-height:1.45}
.switch{flex:none;position:relative;width:52px;height:30px;border-radius:999px;border:1px solid var(--line);background:rgba(255,255,255,.12)}
.switch::after{content:"";position:absolute;top:3px;left:3px;width:22px;height:22px;border-radius:50%;background:#fff;transition:left .2s ease}
.switch.on{background:linear-gradient(90deg,var(--accent),var(--accent-2));border-color:transparent}.switch.on::after{left:25px}
.actions{display:grid;gap:10px}
.btn{min-height:46px;padding:0 18px;border-radius:999px;border:1px solid var(--line);background:rgba(255,255,255,.12)}
.btn.danger{background:rgba(255,68,140,.28);border-color:rgba(255,120,170,.4)}
.empty{text-align:center;padding:28px 18px}.empty p{color:var(--muted);line-height:1.6;margin:8px 0 0;font-size:.9rem}
.tabs{display:flex;gap:6px;margin-bottom:12px}
.tab{flex:1;min-height:36px;border-radius:999px;border:1px solid var(--line);background:rgba(255,255,255,.06);font-size:.8rem}
.tab.on{background:rgba(255,255,255,.18)}
.mem{display:flex;align-items:center;gap:10px;padding:8px 0;border-bottom:1px solid rgba(255,255,255,.08)}
.mem:last-child{border-bottom:0}
.mem .nm{min-width:0;flex:1;display:grid;gap:3px}
.mem .nm b{font-size:.92rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.mem .nm small{color:var(--muted);font-size:.72rem}
.mini{min-height:30px;padding:0 11px;border-radius:999px;border:1px solid var(--line);background:rgba(255,255,255,.1);font-size:.72rem}
.mini.danger{background:rgba(255,68,140,.28);border-color:rgba(255,120,170,.4)}
.note{margin:10px 0 0;color:var(--muted);font-size:.76rem;line-height:1.5}
[hidden]{display:none!important}
</style></head><body>
<div class="glow l"></div><div class="glow r"></div>
<main class="shell">
<header class="top"><h1>Telegram Jam</h1><div class="topr"><span id="role" class="pill"></span><button id="close" class="pill x" hidden aria-label="close">✕</button></div></header>
<section id="idle" class="panel empty"><div style="font-size:2.4rem">♫</div><p id="idleText"></p></section>
<div id="live" hidden style="display:grid;gap:14px">
<section class="now"><div id="cover" class="cover">♫</div><div class="copy"><p id="title" class="title">—</p><p id="status" class="status"></p></div></section>
<section class="panel"><div id="ctl" class="ctl">
<input id="seek" type="range" min="0" max="1000" value="0"><div class="time"><span id="cur">0:00</span><span id="dur">0:00</span></div>
<div class="buttons"><button id="back" class="round">−10</button><button id="pp" class="play"></button><button id="fwd" class="round">+10</button></div></div>
<p id="perm" class="hint"></p></section>
<section class="panel"><div class="tabs"><button id="tabM" class="tab on"></button><button id="tabB" class="tab"></button></div>
<div id="listM"></div><div id="listB" hidden></div><p id="invHint" class="note"></p></section>
<section id="host" class="panel row"><div><b id="swLabel"></b><p id="modeHint"></p></div><button id="sw" class="switch"></button></section>
<section class="actions"><button id="leave" class="btn"></button><button id="end" class="btn danger"></button></section>
</div></main>
<script>
const T="__TOKEN__",L=__I18N__,$=i=>document.getElementById(i);
$("idleText").innerHTML=L.idle;$("swLabel").textContent=L.guestControls;$("sw").setAttribute("aria-label",L.guestControls);$("end").textContent=L.end;
const PLAY='<svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>',PAUSE='<svg viewBox="0 0 24 24"><path d="M6 5h4v14H6zM14 5h4v14h-4z"/></svg>';
let S={active:false},t0=performance.now(),drag=false,busy=0,tab="m";
const fmt=m=>{m=Math.max(0,m)/1000|0;return(m/60|0)+":"+String(m%60).padStart(2,"0")};
const esc=t=>String(t).replace(/[&<>"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));
async function api(p){try{const r=await fetch(p+(p.includes("?")?"&":"?")+"token="+T,{cache:"no-store"});return await r.json()}catch(e){return null}}
async function poll(){if(Date.now()<busy)return;const s=await api("/api");if(s){S=s;t0=performance.now();render()}}
function act(a,v){busy=Date.now()+700;api("/act?action="+a+(v===undefined?"":"&value="+encodeURIComponent(v)));setTimeout(poll,750)}
const pos=()=>Math.min((S.position_ms||0)+(S.playing?performance.now()-t0:0),S.duration_ms||Infinity);
function members(){const h=S.is_host;return S.members.map(m=>{const tags=[m.creator?L.creatorTag:"",m.host?L.hostTag:"",m.me?L.meTag:""].filter(Boolean).join(" · ");
const btns=h&&!m.me?(!m.host?`<button class="mini" data-a="host" data-v="${esc(m.id)}">${L.makeHost}</button>`:"")+(!m.creator?`<button class="mini danger" data-a="kick" data-v="${esc(m.id)}">${L.kick}</button>`:""):"";
return `<div class="mem"><i class="dot${m.connected?" on":""}"></i><div class="nm"><b>${esc(m.name)}</b><small>${tags||L.memberTag}</small></div>${btns}</div>`}).join("")}
function banned(){if(!S.banned.length)return `<p class="note">${L.noBanned}</p>`;return S.banned.map(b=>`<div class="mem"><i class="dot"></i><div class="nm"><b>${esc(b.name)}</b><small>${L.bannedTag}</small></div>${S.is_host?`<button class="mini" data-a="unban" data-v="${esc(b.id)}">${L.unban}</button>`:""}</div>`).join("")}
function render(){const a=!!S.active,h=!!S.is_host,c=!!S.is_creator;
$("idle").hidden=a;$("live").hidden=!a;$("role").textContent=a?(h?L.host:L.guest):L.out;$("role").className="pill"+(a&&h?" host":"");
if(!a)return;
$("title").textContent=S.has_track?(S.performer?S.performer+" — ":"")+S.track:L.noTrack;
$("status").textContent=S.loading?L.loading:!S.has_track?L.hintPick:S.playing?L.playing:L.paused;
$("cover").className="cover"+(S.playing?" on":"");$("pp").innerHTML=S.playing?PAUSE:PLAY;
$("ctl").className="ctl"+(S.can_control&&S.has_track?"":" off");
$("perm").textContent=h?L.permHost:S.can_control?L.permGuestOn:L.permGuestOff;
$("dur").textContent=fmt(S.duration_ms||0);
$("tabM").textContent=L.members+" "+S.members.length+(S.max_participants?"/"+S.max_participants:"");
$("tabB").textContent=L.banned+(S.banned.length?" "+S.banned.length:"");
$("tabM").className="tab"+(tab==="m"?" on":"");$("tabB").className="tab"+(tab==="b"?" on":"");
$("listM").hidden=tab!=="m";$("listB").hidden=tab!=="b";
$("listM").innerHTML=members();$("listB").innerHTML=banned();
$("invHint").textContent=c?L.inviteHint:"";$("invHint").hidden=!c||tab!=="m";
$("host").hidden=!h;$("sw").className="switch"+(S.control_mode==="both"?" on":"");
$("modeHint").textContent=S.control_mode==="both"?L.modeBoth:L.modeLeader;
$("end").hidden=!(h||c);$("leave").hidden=false;$("leave").textContent=L.leave;tick()}
function tick(){if(drag||!S.active)return;const d=S.duration_ms||0,p=d?pos():0,r=d?p/d:0;$("seek").value=r*1000;$("seek").style.setProperty("--p",r*100+"%");$("cur").textContent=fmt(p)}
let armed=null;
document.addEventListener("click",e=>{const b=e.target.closest("button[data-a]");if(!b)return;const a=b.dataset.a,v=b.dataset.v;
if(a==="kick"&&armed!==v){armed=v;busy=Date.now()+3000;b.textContent=L.kickConfirm;setTimeout(()=>{if(armed===v){armed=null;busy=0;render()}},3000);return}
armed=null;act(a,v)});
$("tabM").onclick=()=>{tab="m";render()};$("tabB").onclick=()=>{tab="b";render()};
$("seek").oninput=e=>{drag=true;$("cur").textContent=fmt(e.target.value/1000*(S.duration_ms||0));e.target.style.setProperty("--p",e.target.value/10+"%")};
$("seek").onchange=e=>{const m=Math.round(e.target.value/1000*(S.duration_ms||0));S.position_ms=m;t0=performance.now();drag=false;act("seek",m)};
$("pp").onclick=()=>{S.position_ms=pos();S.playing=!S.playing;t0=performance.now();render();act("toggle")};
$("back").onclick=()=>act("skip",-10000);$("fwd").onclick=()=>act("skip",10000);
$("sw").onclick=()=>{S.control_mode=S.control_mode==="both"?"leader":"both";render();act("mode",S.control_mode)};
$("leave").onclick=()=>act("leave");{const pb=parseInt(new URLSearchParams(location.search).get("pb")||"0",10);if(pb>0)document.querySelector(".shell").style.paddingBottom=(pb+20)+"px"}if(new URLSearchParams(location.search).get("app")==="1"){$("close").hidden=false;$("close").onclick=()=>act("close")}$("end").onclick=()=>act("end");
poll();setInterval(poll,1500);setInterval(tick,250);
</script></body></html>'''

try:
    from java.chaquopy import dynamic_proxy
    NotificationCenterDelegate = dynamic_proxy(NotificationCenter.NotificationCenterDelegate)
except Exception:
    NotificationCenterDelegate = object

try:
    _RequestDelegateBase = dynamic_proxy(RequestDelegate)
except Exception:
    _RequestDelegateBase = None

if _RequestDelegateBase is not None:
    class _RequestDelegate(_RequestDelegateBase):
        def __init__(self, callback):
            super().__init__()
            self.callback = callback

        def run(self, response, error):
            self.callback(response, error)
else:
    _RequestDelegate = None


class _PlaybackHook(MethodHook):
    def __init__(self, plugin, event_type):
        super().__init__()
        self.plugin = plugin
        self.event_type = event_type

    def after_hooked_method(self, param):
        try:
            self.plugin._on_playback_event(self.event_type, param)
        except Exception:
            self.plugin.log("[telegram_jam] playback hook error: " + traceback.format_exc())


class _PlayerCloseHook(MethodHook):
    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin

    def after_hooked_method(self, _param):
        try:
            self.plugin._on_player_closed()
        except Exception:
            self.plugin._debug_exception("Player close hook error")


class _CallEndedHook(MethodHook):
    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin

    def after_hooked_method(self, _param):
        self.plugin._on_call_finished()


class _TabsUpdatedHook(MethodHook):
    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin

    def before_hooked_method(self, param):
        # Selections made while Telegram rebuilds the tabs are not user taps.
        self.plugin._tabs_rebuilt_at = int(time.time() * 1000)

    def after_hooked_method(self, param):
        try:
            self.plugin._on_filter_tabs_updated(param.thisObject)
        except Exception:
            self.plugin._debug_exception("Folder tab update error")


class _TabClickHook(MethodHook):
    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin

    def before_hooked_method(self, param):
        try:
            arg = param.args[0] if param.args else None
            if arg is None:
                return
            if _tab_id(arg) != JAM_TAB_ID:
                # Another folder was chosen: hide the Jam page over the chat list.
                if self.plugin._tab_overlay is not None:
                    run_on_ui_thread(self.plugin._close_tab_overlay)
                return
            # Do not switch the chat list to a folder that does not exist.
            result = None
            try:
                if str(param.method.getReturnType().getName()) == "boolean":
                    result = Boolean(True)
            except Exception as exc:
                _swallow("before_hooked_method", exc)
            param.setResult(result)
            self.plugin._on_jam_tab_click(param.thisObject)
        except Exception:
            self.plugin._debug_exception("Folder tab click error")


def _tab_id(value):
    # Accepts a FilterTabsView.Tab or a TabView (which holds it in currentTab).
    for candidate in (value, _field(value, "currentTab")):
        if candidate is None:
            continue
        tab_id = _field(candidate, "id")
        if tab_id is not None:
            try:
                return int(tab_id)
            except Exception as exc:
                _swallow("_tab_id", exc)
    return -1


def _field(target, name):
    try:
        value = getattr(target, name)
        if value is not None:
            return value
    except Exception as exc:
        _swallow("_field", exc)
    try:
        return get_private_field(target, name)
    except Exception as exc:
        _swallow("_field", exc)
        return None


class _BackPressHook(MethodHook):
    # Back closes the Jam page over the chat list instead of leaving the app.
    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin

    def before_hooked_method(self, param):
        try:
            if self.plugin._tab_overlay is None:
                return
            run_on_ui_thread(self.plugin._close_tab_overlay)
            result = None
            try:
                if str(param.method.getReturnType().getName()) == "boolean":
                    result = Boolean(False)
            except Exception as exc:
                _swallow("before_hooked_method", exc)
            param.setResult(result)
        except Exception:
            self.plugin._debug_exception("Back press hook error")


class _NewMessagesObserver(NotificationCenterDelegate):
    def __init__(self, plugin):
        try:
            super().__init__()
        except Exception:
            pass
        self.plugin = plugin

    def didReceivedNotification(self, notification_id, account, args):
        if notification_id == getattr(NotificationCenter, "openedChatChanged", None):
            run_on_ui_thread(self.plugin._refresh_chat_menu)
            return
        if notification_id != NotificationCenter.didReceiveNewMessages:
            return
        try:
            messages = args[1]
            for index in range(messages.size()):
                self.plugin._on_incoming_message_object(account, messages.get(index))
        except Exception:
            self.plugin._debug("NC error: " + traceback.format_exc().splitlines()[-1])


class _JamPanelServer:
    def __init__(self, plugin, port=0):
        self.plugin = plugin
        self.token = secrets.token_urlsafe(18)
        self.requested_port = int(port or 0)
        panel = self

        class Handler(BaseHTTPRequestHandler):
            protocol_version = "HTTP/1.1"

            def log_message(self, _format, *_args):
                pass

            def do_GET(self):
                try:
                    parsed = urlparse(self.path)
                    params = parse_qs(parsed.query)
                    if params.get("token", [""])[0] != panel.token:
                        panel._reply(self, 403, b"Forbidden", "text/plain; charset=utf-8")
                        return
                    if parsed.path == "/act":
                        action = params.get("action", [""])[0]
                        value = params.get("value", [""])[0]
                        run_on_ui_thread(lambda: panel.plugin._panel_action(action, value))
                        panel._reply(self, 200, b'{"ok":true}', "application/json; charset=utf-8")
                        return
                    if parsed.path == "/api":
                        body = json.dumps(panel.plugin._panel_state(), ensure_ascii=False).encode("utf-8")
                        panel._reply(self, 200, body, "application/json; charset=utf-8")
                        return
                    body = panel.plugin._panel_html(panel.token).encode("utf-8")
                    panel._reply(self, 200, body, "text/html; charset=utf-8")
                except Exception:
                    panel.plugin._debug_exception("Panel HTTP error")
                    try:
                        panel._reply(self, 500, b"Panel error", "text/plain; charset=utf-8")
                    except Exception as exc:
                        _swallow("do_GET", exc)

        try:
            self.http = ThreadingHTTPServer(("127.0.0.1", self.requested_port), Handler)
        except OSError:
            if not self.requested_port:
                raise
            # Requested port is busy: fall back to any free one.
            self.http = ThreadingHTTPServer(("127.0.0.1", 0), Handler)
        self.port = self.http.server_address[1]
        self.thread = threading.Thread(target=self.http.serve_forever, name="telegram-jam-panel", daemon=True)
        self.thread.start()

    def _reply(self, handler, status, body, content_type):
        handler.send_response(status)
        handler.send_header("Content-Type", content_type)
        handler.send_header("Content-Length", str(len(body)))
        handler.send_header("Cache-Control", "no-store")
        handler.send_header("Connection", "close")
        handler.end_headers()
        handler.wfile.write(body)

    @property
    def url(self):
        return "http://127.0.0.1:%s/?token=%s" % (self.port, self.token)

    def close(self):
        try:
            self.http.shutdown()
            self.http.server_close()
        except Exception as exc:
            _swallow("close", exc)


class TelegramJamPlugin(BasePlugin):
    # ------------------------------------------------------------------ lifecycle
    def on_plugin_load(self):
        # Initialized first so every later startup error shows up in diagnostics.
        self._debug_entries = []
        _SWALLOWED.clear()
        _LOG_SINK[0] = self._debug
        self._socket = None
        self._socket_lock = threading.Lock()
        self._room = None
        self._pending = None
        self._connecting = False
        self._disconnecting = False
        self._server_offset_ms = 0
        self._remote_action_until = 0
        self._last_close_at = 0
        self._apply_guard_until = 0
        self._last_playback_event_at = 0
        self._sync_generation = 0
        self._playback_hooks = []
        self._player_close_hooks = []
        self._tab_hooks = []
        self._tab_fragments = []
        self._tab_delegate_classes = set()
        self._last_tab_click = 0
        self._socket_generation = 0
        self._last_recv = 0
        self._reconnect_pending = False
        self._panel_window = None
        self._panel_seen_at = 0
        self._tab_overlay = None
        self._tab_wanted = False
        self._tabs_rebuilt_at = 0
        self._loaded_at = int(time.time() * 1000)
        self._call_hook = None
        self._menu_item_ids = []
        self._call_end_in_progress = False
        self._awaiting_track = None
        self._received_tracks = {}
        self._relayed = set()
        self._known_tracks = {}
        self._missing = {}
        self._message_observers = {}
        self._temporary_documents = {}
        self._cleanup_texts = set()
        self._relay_marks = set()
        self._sent_copies = set()
        self._track_aliases = {}
        self._doc_aliases = {}
        self._external_pending = None
        self._panel = None
        self._update_prompted = set()
        self._debug("Plugin load started")
        self._safe_setup("send hook", self.add_on_send_message_hook)
        self._safe_setup("update hook", lambda: self.add_hook("TL_updateNewMessage"))
        self._safe_setup("playback hooks", self._install_playback_hooks)
        self._safe_setup("player close hooks", self._install_player_close_hooks)
        self._safe_setup("call hook", self._install_call_hook)
        self._safe_setup("chat menu", self._refresh_chat_menu)
        if self.get_setting("folder_tab", False):
            self._safe_setup("folder tab", self._install_tab_hooks)
        if self.get_setting("check_updates", False):
            run_on_ui_thread(lambda: self._check_updates(manual=False), UPDATE_CHECK_DELAY_MS)
        # Telegram was closed or crashed during a Jam: go back into the same lobby.
        run_on_ui_thread(lambda: self._safe_setup("session restore", self._restore_session), 1500)
        self._debug("Plugin load finished")

    def on_plugin_unload(self):
        _LOG_SINK[0] = None
        self._disconnect()
        self._room = None
        self._pending = None
        self._sync_generation += 1
        for hook in self._playback_hooks + self._player_close_hooks + self._tab_hooks:
            try:
                self.unhook_method(hook)
            except Exception as exc:
                _swallow("on_plugin_unload", exc)
        self._playback_hooks = []
        self._player_close_hooks = []
        self._tab_hooks = []
        self._tab_delegate_classes = set()
        self._refresh_folder_tabs()
        try:
            if self._call_hook:
                self.unhook_method(self._call_hook)
        except Exception as exc:
            _swallow("on_plugin_unload", exc)
        self._call_hook = None
        self._remove_menu_items()
        for observer_data in self._message_observers.values():
            try:
                notification_center, observer = observer_data
                notification_center.removeObserver(observer, NotificationCenter.didReceiveNewMessages)
                opened_id = getattr(NotificationCenter, "openedChatChanged", None)
                if opened_id is not None:
                    notification_center.removeObserver(observer, opened_id)
            except Exception as exc:
                _swallow("on_plugin_unload", exc)
        self._message_observers = {}
        self._close_panel_window()
        self._close_tab_overlay()
        if self._panel:
            self._panel.close()
        self._panel = None

    # ------------------------------------------------------------------ settings
    def create_settings(self) -> List[Any]:
        return [
            Header(text="Telegram Jam"),
            Input(
                key="server_url",
                text=_t("Адрес Jam-сервера"),
                default=DEFAULT_SERVER_URL,
                subtext=_t("По умолчанию: wss://jam.ltyt.me/jam. Гости подключаются к серверу создателя лобби автоматически."),
                icon="msg_link",
            ),
            Text(
                text=_t("Проверить сервер"),
                subtext=_t("Подключиться и узнать задержку, версию сервера и пустит ли он этот плагин."),
                icon="msg_retry",
                on_click=lambda view: self._check_server(),
            ),
            Selector(
                key="control_mode",
                text=_t("Управление по умолчанию"),
                default=0,
                items=[_t("Только хост"), _t("Все участники")],
                icon="msg_settings",
                on_change=self._on_control_mode_change,
            ),
            Switch(
                key="delete_temp_tracks",
                text=_t("Удалять копии треков после Jam"),
                subtext=_t("Когда Jam закончится, удалить треки и служебные сообщения, которые плагин отправил в чаты."),
                default=True,
                icon="msg_delete",
            ),
            Divider(),
            Header(text=_t("Панель")),
            Text(
                text=_t("Панель Jam"),
                subtext=_t("Плеер, участники и управление лобби."),
                icon="msg_music",
                on_click=lambda view: self._open_panel(),
            ),
            Switch(
                key="folder_tab",
                text=_t("Вкладка Jam в папках"),
                subtext=_t("Экспериментально. Пока ты в Jam, среди папок чатов появляется вкладка, открывающая панель. Нужны папки чатов."),
                default=False,
                icon="msg_folders",
                on_change=self._on_folder_tab_change,
            ),
            Input(
                key="panel_port",
                text=_t("Порт панели"),
                default="",
                subtext=_t("Пусто — любой свободный. Например: 8765."),
                icon="msg_link",
            ),
            Divider(),
            Header(text=_t("Обновления")),
            Switch(
                key="check_updates",
                text=_t("Проверять обновления"),
                subtext=_t("При запуске узнавать, вышла ли новая версия. Только уведомляет, ничего не скачивает."),
                default=False,
                icon="msg_retry",
            ),
            Text(
                text=_t("Проверить сейчас"),
                icon="msg_retry",
                on_click=lambda view: self._check_updates(manual=True),
            ),
            Divider(),
            Text(
                text=_t("Команды"),
                subtext=_t("Список команд и префикс."),
                icon="msg_help",
                create_sub_fragment=self._create_commands_page,
            ),
            Text(
                text=_t("Диагностика"),
                subtext=_t("Журнал работы для отправки разработчику."),
                icon="msg_info",
                create_sub_fragment=self._create_diagnostics_page,
            ),
            Text(
                text=_t("О сервере"),
                icon="msg_info",
                on_click=lambda view: self._show_about_server(),
            ),
        ]

    def _create_commands_page(self) -> List[Any]:
        prefix = self._prefix()
        return [
            Header(text=_t("Команды Jam")),
            Input(key="prefix", text=_t("Префикс команд"), default=DEFAULT_PREFIX, icon="msg_edit"),
            Text(text="%sstartjam" % prefix, subtext=_t("Создать лобби и пригласить собеседника. То же, что пункт меню чата."), icon="msg_add"),
            Text(text="%sinvitejam" % prefix, subtext=_t("Пригласить собеседника в своё лобби. Только создатель лобби."), icon="msg_add"),
            Text(text=_t("%sacceptjam <код>") % prefix, subtext=_t("Войти в лобби. Код действует 5 минут и только один раз."), icon="msg_done"),
            Text(text="%sdeclinejam" % prefix, subtext=_t("Отклонить приглашение."), icon="msg_delete"),
            Text(text="%sjamstatus" % prefix, subtext=_t("Показать роль, участников и сервер."), icon="msg_info"),
            Text(text="%sleavejam" % prefix, subtext=_t("Выйти из лобби. Лобби продолжится без тебя; если в нём никого не осталось, закроется."), icon="msg_close"),
            Text(text="%sendjam" % prefix, subtext=_t("Завершить Jam для всех. Хост или создатель."), icon="msg_stop"),
            Divider(),
            Text(text=_t("Чтобы поставить трек, просто включи его: в Jam-чате, в профиле или в другом чате."), icon="msg_music"),
        ]

    def _create_diagnostics_page(self) -> List[Any]:
        entries = list(reversed(getattr(self, "_debug_entries", [])[-20:]))
        items = [
            Header(text=_t("Диагностика Jam")),
            Text(
                text=_t("Скопировать журнал"),
                subtext=_t("Скопировать последние события для отправки разработчику."),
                icon="msg_copy",
                on_click=lambda view: self._copy_diagnostics(),
            ),
            Text(
                text=_t("Очистить журнал"),
                subtext=_t("Удалить локальные диагностические записи."),
                icon="msg_delete",
                red=True,
                on_click=lambda view: self._clear_diagnostics(),
            ),
            Divider(),
            Header(text=_t("Последние события")),
        ]
        if not entries:
            items.append(Text(text=_t("Журнал пока пуст."), icon="msg_info"))
            return items
        for entry in entries:
            items.append(Text(text=entry, icon="msg_info"))
        return items
    def _show_about_server(self):
        def show():
            try:
                fragment = get_last_fragment()
                activity = fragment.getParentActivity() if fragment else None
                if activity is None:
                    return
                builder = AlertDialogBuilder(activity)
                builder.set_title(_t("О сервере"))
                builder.set_message(ABOUT_SERVER_TEXT if _lang() == "ru" else ABOUT_SERVER_TEXT_EN)
                builder.set_positive_button(_t("Закрыть"), lambda bld, _which: bld.dismiss())
                builder.set_neutral_button("GitHub", lambda bld, _which: self._open_github(bld))
                builder.show()
            except Exception:
                self._debug_exception("About dialog error")

        run_on_ui_thread(show)
    def _open_github(self, builder=None):
        try:
            if builder is not None:
                builder.dismiss()
        except Exception as exc:
            _swallow("_open_github", exc)
        if not GITHUB_URL:
            self._bulletin("info", _t("Репозиторий скоро появится."))
            return
        try:
            fragment = get_last_fragment()
            context = fragment.getParentActivity() if fragment else ApplicationLoader.applicationContext
            Browser.openUrl(context, GITHUB_URL)
        except Exception:
            self._debug_exception("GitHub open error")

    # ------------------------------------------------------------------ commands
    def on_send_message_hook(self, account: int, params: Any) -> HookResult:
        text = getattr(params, "message", None)
        if not isinstance(text, str) or not text.strip():
            return HookResult()
        parts = text.strip().split(None, 1)
        command = parts[0].lower()
        argument = parts[1].strip() if len(parts) > 1 else ""
        prefix = self._prefix().lower()
        commands = {
            prefix + "startjam": self._start_jam,
            prefix + "invitejam": self._invite_jam,
            prefix + "acceptjam": self._accept_jam,
            prefix + "declinejam": self._decline_jam,
            prefix + "endjam": self._end_jam,
            prefix + "leavejam": self._leave_jam,
            prefix + "jamstatus": self._jam_status,
        }
        handler = commands.get(command)
        if handler is None:
            return HookResult()
        dialog_id = self._peer_dialog_id(params)
        try:
            self._debug("Command: %s dialog=%s account=%s" % (command, dialog_id, account))
            handler(account, dialog_id, argument)
        except Exception:
            self._debug_exception("Command error")
            self._bulletin("error", _t("Не удалось выполнить команду Jam."))
        return HookResult(strategy=HookStrategy.CANCEL)

    def _start_jam(self, account, dialog_id, _argument=""):
        if not self._is_private_dialog(dialog_id):
            self._bulletin("error", _t("Jam можно создать только в личном чате."))
            return
        if self._room and self._is_creator():
            self._invite_jam(account, dialog_id)
            return
        if self._room or self._connecting:
            self._bulletin("error", _t("Сначала заверши или покинь текущий Jam."))
            return
        server_url = self._server_url()
        if not server_url:
            self._bulletin("error", _t("Укажи адрес Jam-сервера в настройках плагина."))
            return
        self._pending = {"action": "create", "account": account, "dialog_id": dialog_id, "server_url": server_url}
        self._connect(server_url, {
            "type": "create_room",
            "request_id": "create",
            "client_version": __version__,
            "protocol": PROTOCOL_VERSION,
            "control_mode": self._control_mode(),
            "display_name": self._display_name(account)[:64],
            "member_key": self._member_key(account),
        })

    def _invite_jam(self, account, dialog_id, _argument=""):
        room = self._room
        if not room:
            self._start_jam(account, dialog_id)
            return
        if not self._is_private_dialog(dialog_id):
            self._bulletin("error", _t("Пригласить можно только в личном чате."))
            return
        if not self._is_creator():
            self._bulletin("error", _t("Приглашать может только создатель лобби: треки идут через его чаты."))
            return
        if int(dialog_id) in room["member_dialogs"].values():
            self._bulletin("info", _t("Этот собеседник уже в лобби."))
            return
        self._send_ws({"type": "create_invite", "room_id": room["room_id"], "request_id": "invite:%s" % int(dialog_id)})

    def _accept_jam(self, account, dialog_id, argument):
        if not self._is_private_dialog(dialog_id):
            self._bulletin("error", _t("Jam можно принять только в личном чате."))
            return
        if self._room or self._connecting:
            self._bulletin("error", _t("Сначала заверши или покинь текущий Jam."))
            return
        parts = argument.split()
        decoded = self._decode_invite(parts[0]) if len(parts) == 1 else None
        if not decoded:
            self._bulletin("error", _t("Код приглашения повреждён или устарел. Попроси прислать новый."))
            return
        server_url, room_code, ticket = decoded
        self._pending = {"action": "join", "account": account, "dialog_id": dialog_id, "server_url": server_url}
        self._connect(server_url, {
            "type": "join_room",
            "request_id": "join",
            "client_version": __version__,
            "protocol": PROTOCOL_VERSION,
            "room_code": room_code,
            "ticket": ticket,
            "display_name": self._display_name(account)[:64],
            "member_key": self._member_key(account),
        })

    def _decline_jam(self, account, dialog_id, _argument=""):
        if not self._is_private_dialog(dialog_id):
            self._bulletin("error", _t("Команда доступна только в личном чате."))
            return
        self._send_text(account, dialog_id, _t("🎵 Приглашение в Jam отклонено."))
        self._bulletin("info", _t("Приглашение отклонено."))

    def _end_jam(self, _account=None, _dialog_id=None, _argument=""):
        room = self._room
        if not room:
            self._bulletin("info", _t("Активного Jam нет."))
            return
        if not (self._is_host() or self._is_creator()):
            self._bulletin("error", _t("Завершить Jam может хост или создатель лобби."))
            return
        if not self._send_ws({"type": "end_room", "room_id": room["room_id"]}):
            self._reset_room(_t("Jam завершён."))

    def _leave_jam(self, _account=None, _dialog_id=None, _argument=""):
        room = self._room
        if not room:
            self._bulletin("info", _t("Активного Jam нет."))
            return
        self._send_ws({"type": "leave_room", "room_id": room["room_id"]})
        others = [member for member in room.get("members", [])
                  if member.get("id") != room["member_id"] and member.get("connected")]
        # The lobby goes on without us: keep the copies so the others can still
        # play them; each of them removes what it received when its Jam ends.
        self._reset_room(_t("Ты вышел из Jam."), cleanup=not (others and self._is_creator(room)))

    def _jam_status(self, _account=None, _dialog_id=None, _argument=""):
        room = self._room
        if not room:
            self._bulletin("info", _t("Активного Jam нет."))
            return
        role = _t("хост") if self._is_host() else _t("участник")
        names = ", ".join(member["name"] for member in room.get("members", []))
        self._bulletin("info", _t("Jam (%s): ты — %s. В лобби: %s.") % (self._server_label(room["server_url"]), role, names))

    def _on_control_mode_change(self, index):
        self._set_control_mode("both" if int(index) == 1 else "leader")

    def _set_control_mode(self, mode, persist=False):
        room = self._room
        if not room or not self._is_host() or room.get("control_mode") == mode:
            return
        room["control_mode"] = mode
        self._send_ws({"type": "set_control_mode", "room_id": room["room_id"], "control_mode": mode})
        if persist:
            try:
                self.set_setting("control_mode", 1 if mode == "both" else 0)
            except Exception as exc:
                _swallow("_set_control_mode", exc)

    # ------------------------------------------------------------------ roles
    def _is_creator(self, room=None):
        room = room or self._room
        return bool(room) and room.get("member_id") == room.get("creator_id")

    def _is_host(self, room=None):
        room = room or self._room
        return bool(room) and room.get("member_id") == room.get("host_id")

    def _can_control(self, room=None):
        room = room or self._room
        return bool(room) and (self._is_host(room) or room.get("control_mode") == "both")

    def _jam_dialogs(self, room=None):
        room = room or self._room
        if not room:
            return []
        dialogs = set(room["member_dialogs"].values()) if self._is_creator(room) else set()
        if room.get("home_dialog"):
            dialogs.add(int(room["home_dialog"]))
        return sorted(dialogs)

    def _member_key(self, account):
        # Lets the server keep kicked members out without learning who they are.
        try:
            user_id = int(UserConfig.getInstance(account).getClientUserId())
            return hashlib.sha256(("telegram-jam-member:%s" % user_id).encode("utf-8")).hexdigest()
        except Exception as exc:
            _swallow("_member_key", exc)
            return None

    # ------------------------------------------------------------------ websocket
    def _connect(self, server_url, initial_message):
        self._disconnecting = False
        self._connecting = True
        self._socket_generation += 1
        generation = self._socket_generation

        def worker():
            socket = None
            connected = False
            try:
                from websocket import create_connection

                socket = create_connection(server_url, timeout=10)
                socket.settimeout(None)
                with self._socket_lock:
                    if generation != self._socket_generation:
                        return
                    self._socket = socket
                self._last_recv = time.time()
                socket.send(json.dumps(initial_message, separators=(",", ":")))
                connected = True
                self._debug("WS connected; sent %s" % initial_message.get("type"))
                self._start_keepalive(socket)
                while True:
                    raw = socket.recv()
                    if not raw:
                        break
                    self._last_recv = time.time()
                    self._handle_server_message(json.loads(raw))
            except Exception:
                if not self._disconnecting:
                    self._debug("WS error: " + traceback.format_exc().splitlines()[-1])
            finally:
                with self._socket_lock:
                    if self._socket is socket:
                        self._socket = None
                self._connecting = False
                try:
                    if socket:
                        socket.close()
                except Exception as exc:
                    _swallow("worker", exc)
                if generation == self._socket_generation:
                    run_on_ui_thread(lambda: self._on_socket_lost(connected))

        thread = threading.Thread(target=worker, name="telegram-jam", daemon=True)
        thread.start()

    def _start_keepalive(self, socket):
        # Pings keep proxies from dropping idle connections and reveal dead
        # ones (mobile networks often drop TCP without telling anyone).
        def loop():
            while True:
                time.sleep(PING_INTERVAL_S)
                with self._socket_lock:
                    if self._socket is not socket:
                        return
                silent = time.time() - self._last_recv
                try:
                    if silent > SILENCE_LIMIT_S:
                        self._debug("WS silent for %ss, reconnecting" % int(silent))
                        self._kill_socket(socket)
                        return
                    socket.send('{"type":"ping"}')
                except Exception:
                    self._kill_socket(socket)
                    return

        threading.Thread(target=loop, name="telegram-jam-ping", daemon=True).start()

    def _kill_socket(self, socket):
        # abort() shuts the TCP socket down, which also wakes the blocked recv().
        for name in ("abort", "close"):
            try:
                getattr(socket, name)()
            except Exception as exc:
                _swallow("_kill_socket", exc)

    def _on_socket_lost(self, was_connected):
        if self._disconnecting:
            return
        if self._room:
            self._schedule_reconnect()
            return
        if self._pending:
            self._pending = None
            self._bulletin("error", _t("Не удалось подключиться к Jam-серверу."))

    def _schedule_reconnect(self):
        room = self._room
        if not room or self._reconnect_pending:
            return
        attempt = int(room.get("reconnect_attempt", 0) or 0)
        if attempt == 0:
            room["reconnect_since"] = time.time()
            self._bulletin("info", _t("Связь с Jam-сервером потеряна, переподключаюсь…"))
            self._room_changed()
        elif time.time() - room.get("reconnect_since", time.time()) > RECONNECT_GIVE_UP_S:
            self._reset_room(_t("Не удалось переподключиться к Jam-серверу. Jam закрыт."), error=True)
            return
        room["reconnect_attempt"] = attempt + 1
        delay = min(15000, 1000 * (2 ** min(attempt, 4)))
        self._reconnect_pending = True
        generation = self._sync_generation
        self._debug("Reconnect #%s in %s ms" % (attempt + 1, delay))

        def go():
            self._reconnect_pending = False
            if generation != self._sync_generation or self._room is not room:
                return
            self._resume_connect(room)

        run_on_ui_thread(go, delay)

    def _resume_connect(self, room):
        self._connect(room["server_url"], {
                "type": "resume_room",
                "request_id": "resume",
                "room_id": room["room_id"],
                "member_id": room["member_id"],
                "token": room["token"],
                "client_version": __version__,
                "protocol": PROTOCOL_VERSION,
            })

    def _is_reconnecting(self):
        room = self._room
        return bool(room) and int(room.get("reconnect_attempt", 0) or 0) > 0

    def _handle_room_resumed(self, message):
        room = self._room
        snapshot = message.get("room") or {}
        if not room or snapshot.get("room_id") != room["room_id"]:
            return
        was_reconnecting = self._is_reconnecting()
        room["reconnect_attempt"] = 0
        self._apply_snapshot(room, snapshot)
        self._debug("Room resumed")
        if was_reconnecting:
            self._bulletin("success", _t("Снова на связи с Jam."))
        state = snapshot.get("state")
        if isinstance(state, dict) and int(state.get("revision", 0) or 0) > int(room.get("revision", 0) or 0):
            room["revision"] = int(state.get("revision", 0) or 0)
            room["state"] = state
            self._play_synced_state(state)
        self._room_changed()

    def _handle_server_message(self, message):
        message_type = message.get("type") if isinstance(message, dict) else None
        if message_type not in ("pong", "room_state"):
            self._debug("WS received: %s" % message_type)
        if message_type in ("hello", "pong"):
            self._update_server_clock(message)
            if message_type == "hello":
                self._handle_hello(message)
            return
        handlers = {
            "error": self._handle_error,
            "room_created": self._handle_room_created,
            "room_joined": self._handle_room_joined,
            "room_resumed": self._handle_room_resumed,
            "room_update": self._handle_room_update,
            "invite_created": self._handle_invite_created,
            "room_state": self._handle_room_state,
            "track_offer": self._handle_track_offer,
            "track_status": self._handle_track_status,
            "track_ready_all": self._handle_track_ready_all,
            "track_cancelled": self._handle_track_cancelled,
            "room_left": self._handle_room_left,
            "room_ended": self._handle_room_ended,
        }
        handler = handlers.get(message_type)
        if handler:
            try:
                handler(message)
            except Exception:
                self._debug_exception("Handler error: %s" % message_type)

    def _handle_hello(self, message):
        if int(message.get("protocol") or 1) < MIN_SERVER_PROTOCOL:
            self._bulletin("error", _t("Сервер устарел для этой версии плагина. Попроси владельца сервера обновить его."))

    def _handle_error(self, message):
        code = message.get("code") or "?"
        request_id = str(message.get("request_id") or "")
        if code == "client_outdated":
            self._pending = None
            self._show_server_refusal(message)
            return
        texts = {
            "invite_invalid": _t("Код приглашения устарел или уже использован. Попроси прислать новый."),
            "banned": _t("Тебя исключили из этого лобби."),
            "room_full": _t("Лобби заполнено: максимум %s человек.") % message.get("max_participants", "?"),
            "already_joined": _t("Ты уже в этом лобби."),
            "creator_required": _t("Приглашать может только создатель лобби: треки идут через его чаты."),
            "host_required": _t("Это может сделать только хост."),
            "kick_not_allowed": _t("Этого участника нельзя исключить."),
            "server_busy": _t("Jam-сервер перегружен, попробуй позже."),
        }
        if request_id == "resume" or code == "resume_invalid":
            self._reset_room(_t("Пока не было связи, лобби закрылось."), error=True)
            return
        if request_id in ("create", "join"):
            self._pending = None
            self._disconnect()
        self._bulletin("error", texts.get(code) or (_t("Jam-сервер: %s") % code))

    def _new_room(self, pending, message, home_dialog):
        room = {
            "room_id": message["room_id"],
            "room_code": message.get("room_code"),
            "member_id": message["member_id"],
            "token": message["token"],
            "account": pending["account"],
            "server_url": pending["server_url"],
            "started_at": int(time.time()),
            "home_dialog": home_dialog,
            "member_dialogs": {},
            "tickets": {},
            "all_dialogs": set([int(pending["dialog_id"])]),
            "members": [],
            "banned": [],
            "creator_id": None,
            "host_id": None,
            "control_mode": "leader",
            "state": None,
            "revision": 0,
            "pending_track": None,
        }
        self._apply_snapshot(room, message.get("room") or {})
        return room

    def _apply_snapshot(self, room, snapshot):
        for key in ("creator_id", "host_id", "control_mode", "members", "banned", "max_participants"):
            if key in snapshot:
                room[key] = snapshot[key]
        member_ids = set(member.get("id") for member in room.get("members", []))
        room["member_dialogs"] = {mid: did for mid, did in room["member_dialogs"].items() if mid in member_ids}

    def _handle_room_created(self, message):
        pending = self._pending
        if not pending or pending.get("action") != "create":
            return
        room = self._new_room(pending, message, None)
        self._room = room
        self._pending = None
        self._ensure_message_observer(pending["account"])
        self._call_end_in_progress = False
        self._debug("Room created: %s" % room["room_id"])
        self._send_invite(int(pending["dialog_id"]), message)
        self._bulletin("success", _t("Лобби создано. Приглашение отправлено."))
        self._room_changed()
        self._start_sync_loop()

    def _handle_invite_created(self, message):
        room = self._room
        request_id = str(message.get("request_id") or "")
        if not room or not request_id.startswith("invite:"):
            return
        dialog_id = int(request_id.split(":", 1)[1])
        self._send_invite(dialog_id, message)
        self._bulletin("success", _t("Приглашение отправлено. Код действует 5 минут."))

    def _send_invite(self, dialog_id, message):
        room = self._room
        room["tickets"][message["ticket_id"]] = dialog_id
        room["all_dialogs"].add(dialog_id)
        code = self._encode_invite(room["server_url"], message["room_code"], message["ticket"])
        command = "%sacceptjam %s" % (self._prefix(), code)
        text = _t("🎵 %s приглашает тебя в Jam.\n\nКод действует 5 минут. Принять:") % self._display_name(room["account"])
        self._send_text(room["account"], dialog_id, text + "\n" + command, self._code_entity(text + "\n", command), cleanup_after_jam=True)

    def _handle_room_joined(self, message):
        pending = self._pending
        if not pending or pending.get("action") != "join":
            return
        room = self._new_room(pending, message, int(pending["dialog_id"]))
        self._room = room
        self._pending = None
        self._ensure_message_observer(pending["account"])
        self._call_end_in_progress = False
        self._debug("Room joined: %s" % room["room_id"])
        self._bulletin("success", _t("Ты в лобби. Участников: %s.") % len(room["members"]))
        self._room_changed()
        self._start_sync_loop()
        state = (message.get("room") or {}).get("state")
        if state:
            self._handle_room_state({"room_id": room["room_id"], "state": state})

    def _handle_room_update(self, message):
        room = self._room
        snapshot = message.get("room") or {}
        if not room or snapshot.get("room_id") != room["room_id"]:
            return
        was_host = self._is_host(room)
        was_creator = self._is_creator(room)
        old_host = room.get("host_id")
        event = message.get("event") or {}
        kind = event.get("kind")
        if kind == "joined" and self._is_creator(room) and event.get("member_id") != room["member_id"]:
            dialog_id = room["tickets"].pop(event.get("ticket_id"), None)
            if dialog_id is not None:
                room["member_dialogs"][event.get("member_id")] = int(dialog_id)
                room["all_dialogs"].add(int(dialog_id))
                self._debug("Member %s -> dialog %s" % (event.get("member_id"), dialog_id))
            else:
                self._debug("No chat for member %s: ticket %s unknown (known: %s)" % (
                    event.get("member_id"), event.get("ticket_id"), list(room["tickets"].keys())))
        self._apply_snapshot(room, snapshot)
        me = event.get("member_id") == room["member_id"]
        name = event.get("name") or "?"
        if kind == "joined" and not me:
            self._bulletin("info", _t("%s присоединился к лобби.") % name)
        elif kind == "left":
            text = _t("%s вышел из лобби.") % name
            if room.get("host_id") != old_host:
                if self._is_host(room):
                    text += " " + _t("Теперь ты хост Jam.")
                else:
                    text += " " + _t("Хостом стал %s.") % (event.get("host_name") or "?")
            if self._is_creator(room) and not was_creator:
                text += " " + _t("Теперь ты приглашаешь новых участников.")
            self._bulletin("info", text)
        elif kind == "kicked" and not me:
            self._bulletin("info", _t("%s исключён из лобби.") % name)
        elif kind == "host_changed":
            lost = event.get("reason") == "host_lost"
            if me:
                self._bulletin("success", (_t("Хост пропал из сети.") + " " if lost else "") + _t("Теперь ты хост Jam."))
            else:
                self._bulletin("info", (_t("Хост пропал из сети.") + " " if lost else "") + _t("Хостом стал %s.") % name)
        elif kind == "control_mode":
            both = event.get("control_mode") == "both"
            self._bulletin("info", _t("Управление Jam: %s.") % (_t("все участники") if both else _t("только хост")))
        if was_host != self._is_host(room):
            self._debug("Host role changed: %s" % self._is_host(room))
        self._room_changed()

    def _handle_room_left(self, message):
        reason = message.get("reason")
        text = _t("Тебя исключили из лобби.") if reason == "kicked" else _t("Ты вышел из Jam.")
        self._reset_room(text, error=reason == "kicked")

    def _handle_room_ended(self, message):
        reasons = {
            "creator_left": _t("Создатель лобби вышел, Jam завершён."),
            "ended_by_participant": _t("Звонок завершён, Jam остановлен."),
            "expired": _t("Время жизни лобби истекло."),
        }
        self._reset_room(reasons.get(message.get("reason"), _t("Jam завершён.")))

    # ------------------------------------------------------------------ tracks: offering
    def _handle_track_offer(self, message):
        room = self._room
        track = message.get("track")
        if not room or message.get("room_id") != room["room_id"] or not isinstance(track, dict):
            return
        document_id = str(track.get("document_id", "") or "")
        if track.get("temporary") and document_id:
            self._remember_temporary(document_id, None)
        self._awaiting_track = track
        self._known_tracks[track.get("id")] = track
        message_object = self._find_track_message(track)
        self._debug("Track offer: id=%s doc=%s found=%s" % (track.get("id"), document_id, message_object is not None))
        if message_object is not None:
            self._received_tracks[track["id"]] = message_object
            self._send_track_status(track, "ready")
            self._relay_missing(track)
        else:
            self._send_track_status(track, "missing")
            self._search_track_later(track, 0)

    def _search_track_later(self, track, attempt):
        # Backup for when the new-message hook misses the copy: look at recent history.
        delays = (1500, 3000, 5000, 8000)
        if attempt >= len(delays):
            return
        generation = self._sync_generation

        def run():
            awaiting = self._awaiting_track
            if generation != self._sync_generation or not awaiting or awaiting.get("id") != track.get("id"):
                return
            self._search_history(track, lambda message_object: self._track_found(track, message_object),
                                 on_miss=lambda: self._search_track_later(track, attempt + 1))

        run_on_ui_thread(run, delays[attempt])

    def _track_found(self, track, message_object):
        awaiting = self._awaiting_track
        if not awaiting or awaiting.get("id") != track.get("id"):
            return
        self._debug("Track found in history: msg=%s" % message_object.getId())
        self._received_tracks[track["id"]] = message_object
        self._send_track_status(track, "ready")
        self._relay_missing(track)

    def _search_history(self, track, on_found, on_miss=None):
        room = self._room
        if not room:
            return
        account = int(room["account"])
        document_id = str(track.get("document_id", "") or "")
        dialogs = list(self._jam_dialogs(room))
        if not document_id or not dialogs:
            if on_miss:
                on_miss()
            return
        state = {"left": len(dialogs), "done": False}
        since = int(room.get("started_at", 0) or 0) - 30

        def finish(message_object):
            if state["done"]:
                return
            if message_object is not None:
                state["done"] = True
                on_found(message_object)
                return
            state["left"] -= 1
            if state["left"] <= 0:
                state["done"] = True
                if on_miss:
                    on_miss()

        def search(dialog_id):
            def on_history(response, error):
                match = None
                alias = False
                try:
                    if error is None and response is not None:
                        messages = response.messages
                        for index in range(messages.size()):
                            message = messages.get(index)
                            local = self._message_document_id(message)
                            if not local:
                                continue
                            if local == document_id:
                                match = message
                                break
                            expected = int(round(int(track.get("duration_ms", 0) or 0) / 1000.0))
                            if (match is None and not bool(getattr(message, "out", False)) and expected > 0
                                    and int(getattr(message, "date", 0) or 0) >= since
                                    and abs(self._message_seconds(message) - expected) <= 2):
                                match = message
                                alias = True
                except Exception:
                    self._debug_exception("History search error")
                found_message = match

                def deliver():
                    if found_message is None:
                        finish(None)
                        return
                    try:
                        message_object = MessageObject(account, found_message, True, True)
                        if (not bool(getattr(found_message, "out", False))
                                and int(getattr(found_message, "date", 0) or 0) >= since):
                            self._remember_temporary(self._message_document_id(found_message), int(dialog_id))
                        if alias:
                            local = self._message_document_id(found_message)
                            self._doc_aliases[local] = document_id
                            self._track_aliases[document_id] = message_object
                            self._remember_temporary(local, int(dialog_id))
                        finish(message_object)
                    except Exception:
                        self._debug_exception("History message error")
                        finish(None)

                run_on_ui_thread(deliver)

            try:
                request = TLRPC.TL_messages_getHistory()
                request.peer = get_messages_controller(account).getInputPeer(int(dialog_id))
                request.limit = 30
                self._send_tl(request, on_history, account)
            except Exception:
                self._debug_exception("History search request error")
                finish(None)

        for dialog_id in dialogs:
            search(dialog_id)

    def _send_track_status(self, track, status):
        room = self._room
        if not room:
            return
        if status == "ready":
            self._awaiting_track = None
        self._send_ws({"type": "track_status", "room_id": room["room_id"], "track_id": track.get("id"), "status": status})

    def _handle_track_status(self, message):
        room = self._room
        self._debug("Track status: %s from %s" % (message.get("status"), message.get("member_id")))
        if not room or message.get("status") != "missing":
            return
        # Only the creator shares chats with everyone, so it relays missing tracks.
        if not self._is_creator(room):
            return
        track = self._known_tracks.get(message.get("track_id"))
        if not track:
            return
        self._missing.setdefault(track["id"], set()).add(message.get("member_id"))
        self._relay_missing(track)

    def _relay_missing(self, track):
        if not self._room or not self._is_creator():
            return
        for member_id in list(self._missing.get(track.get("id"), ())):
            self._relay_track(track, member_id)

    def _relay_track(self, track, member_id):
        room = self._room
        dialog_id = room["member_dialogs"].get(member_id)
        key = (track.get("id"), member_id)
        if key in self._relayed:
            return
        if dialog_id is None:
            self._debug("Relay: no chat known for member %s (map: %s)" % (member_id, room["member_dialogs"]))
            return
        source = self._received_tracks.get(track["id"]) or self._find_track_message(track)
        if source is None:
            self._debug("Relay: source not found for %s" % track.get("id"))
            return
        self._relayed.add(key)
        self._remember_temporary(self._document_id(source), int(dialog_id), int(source.getId()))
        # If Telegram re-uploads instead of sending by reference, the copy gets
        # a new document id; remember chat + duration so cleanup still finds it.
        self._relay_marks.add((int(dialog_id), self._track_seconds(track, source)))
        self._debug("Relay track %s to member %s, dialog %s" % (track.get("id"), member_id, dialog_id))
        self._send_document(source, int(dialog_id))

    def _handle_track_ready_all(self, message):
        room = self._room
        pending = (room or {}).get("pending_track")
        if not pending or pending["track"].get("id") != message.get("track_id"):
            return
        self._start_pending_track()

    def _handle_track_cancelled(self, message):
        room = self._room
        if not room:
            return
        pending = room.get("pending_track")
        if pending and pending["track"].get("id") == message.get("track_id"):
            room["pending_track"] = None
            self._bulletin("info", _t("Хост забрал управление, трек не добавлен."))
        if self._awaiting_track and self._awaiting_track.get("id") == message.get("track_id"):
            self._awaiting_track = None

    def _offer_track(self, message_object, source="chat"):
        room = self._room
        if not room or message_object is None or not self._is_audio_track(message_object):
            return False
        try:
            document_id = self._document_id(message_object)
            track = {
                "id": "%s:%s:%s" % (room["member_id"], document_id or message_object.getId(), int(time.time())),
                "dialog_id": abs(int(message_object.getDialogId())) or 1,
                "message_id": int(message_object.getId()) or 1,
                "document_id": document_id or None,
                "temporary": document_id in self._temporary_documents,
                "source": source,
                "title": str(message_object.getMusicTitle() or _t("Аудиосообщение"))[:256],
                "duration_ms": max(0, int(message_object.getDuration()) * 1000),
            }
            if not track["document_id"]:
                del track["document_id"]
            performer = str(message_object.getMusicAuthor() or "")[:128] if hasattr(message_object, "getMusicAuthor") else ""
            if performer:
                track["performer"] = performer
        except Exception:
            self._debug_exception("Track read error")
            return False
        self._received_tracks[track["id"]] = message_object
        self._known_tracks[track["id"]] = track
        others = [member for member in room.get("members", []) if member.get("id") != room["member_id"]]
        if not others:
            # Alone in the lobby: nothing to wait for.
            room["pending_track"] = {"track": track, "started_at": self._local_now_ms()}
            self._start_pending_track()
            return True
        room["pending_track"] = {"track": track, "started_at": self._local_now_ms()}
        self._debug("Offer track %s" % track["id"])
        if not self._send_ws({"type": "offer_track", "room_id": room["room_id"], "track": track}):
            room["pending_track"] = None
            return False
        self._bulletin("info", _t("Передаю трек участникам…"))
        generation = self._sync_generation
        run_on_ui_thread(lambda: self._pending_track_timeout(track["id"], generation), TRACK_READY_TIMEOUT_MS)
        return True

    def _pending_track_timeout(self, track_id, generation):
        room = self._room
        pending = (room or {}).get("pending_track")
        if generation != self._sync_generation or not pending or pending["track"].get("id") != track_id:
            return
        self._bulletin("info", _t("Не все успели получить трек — запускаю для остальных."))
        self._start_pending_track()

    def _start_pending_track(self):
        room = self._room
        pending = (room or {}).get("pending_track")
        if not pending:
            return
        room["pending_track"] = None
        state = {
            "track": pending["track"],
            "playing": True,
            "position_ms": 0,
            "start_at_server_ms": self._server_now_ms() + 2000,
            "revision": room.get("revision", 0) + 1,
        }
        self._send_room_state(state)
        self._play_synced_state(state)

    # ------------------------------------------------------------------ tracks: external (profile / other chats)
    def _bring_external_track(self, message_object):
        room = self._room
        targets = self._jam_dialogs(room)
        if not targets:
            # Creator alone in the lobby: play locally and share the state.
            self._offer_track(message_object, source="profile")
            return
        document_id = self._document_id(message_object)
        if not document_id:
            self._bulletin("error", _t("Не удалось определить аудиофайл для Jam."))
            return
        if self._external_pending and self._external_pending.get("document_id") == document_id:
            return
        target = targets[0]
        self._external_pending = {"document_id": document_id, "dialog_id": target, "started": self._local_now_ms()}
        self._remember_temporary(document_id, target, int(message_object.getId()))
        self._relay_marks.add((int(target), self._track_seconds({}, message_object)))
        self._bulletin("info", _t("Добавляю трек в Jam-чат…"))
        self._send_document(message_object, target)
        self._poll_external_copy(document_id, 0)

    def _poll_external_copy(self, document_id, attempt):
        def check():
            pending = self._external_pending
            if not pending or pending.get("document_id") != document_id or not self._room:
                return
            found = self._find_message(self._room["account"], pending["dialog_id"], 0, document_id)
            if found is not None and int(found.getId()) > 0:
                self._external_copy_arrived(found)
                return
            if attempt >= 30:
                self._external_pending = None
                self._bulletin("error", _t("Не удалось добавить трек в Jam-чат."))
                return
            self._poll_external_copy(document_id, attempt + 1)

        run_on_ui_thread(check, 700)

    def _external_copy_arrived(self, message_object):
        if not self._external_pending:
            return
        self._external_pending = None
        self._debug("External copy ready: msg=%s" % message_object.getId())
        self._offer_track(message_object, source="profile")

    def _send_document(self, message_object, dialog_id):
        # Sends the Telegram document by reference (no re-upload). Works for
        # profile music too, which cannot be forwarded as a message.
        room = self._room
        account = int(room["account"]) if room else 0
        document = None
        try:
            document = message_object.getDocument()
        except Exception as exc:
            _swallow("_send_document", exc)
        if document is None:
            self._forward_message(message_object, dialog_id)
            return

        def on_response(response, error):
            if error is not None:
                self._debug("sendMedia error: %s" % getattr(error, "text", error))
                run_on_ui_thread(lambda: self._forward_message(message_object, dialog_id))
                return
            self._debug("sendMedia ok -> dialog %s" % dialog_id)
            self._record_sent_copies(response, dialog_id)
            try:
                get_messages_controller(account).processUpdates(response, False)
            except Exception:
                self._debug_exception("processUpdates error")

        def send():
            try:
                input_document = TLRPC.TL_inputDocument()
                input_document.id = document.id
                input_document.access_hash = document.access_hash
                input_document.file_reference = document.file_reference
                media = TLRPC.TL_inputMediaDocument()
                media.id = input_document
                request = TLRPC.TL_messages_sendMedia()
                request.peer = get_messages_controller(account).getInputPeer(int(dialog_id))
                request.media = media
                request.message = ""
                request.random_id = secrets.randbits(63)
                self._send_tl(request, on_response, account)
            except Exception:
                self._debug_exception("sendMedia failed, forwarding instead")
                self._forward_message(message_object, dialog_id)

        run_on_ui_thread(send)

    def _record_sent_copies(self, response, dialog_id):
        try:
            updates = getattr(response, "updates", None)
            if updates is None:
                return
            for index in range(updates.size()):
                message = getattr(updates.get(index), "message", None)
                if message is None or int(getattr(message, "id", 0) or 0) <= 0:
                    continue
                self._sent_copies.add((int(dialog_id), int(message.id)))
                document_id = self._message_document_id(message)
                if document_id:
                    self._remember_temporary(document_id, int(dialog_id))
                self._debug("Copy sent: dialog=%s msg=%s doc=%s" % (dialog_id, message.id, document_id))
        except Exception:
            self._debug_exception("Copy record error")

    def _track_seconds(self, track, message_object=None):
        duration_ms = int((track or {}).get("duration_ms", 0) or 0)
        if duration_ms <= 0 and message_object is not None:
            try:
                duration_ms = int(float(message_object.getDuration()) * 1000)
            except Exception:
                duration_ms = 0
        return int(round(duration_ms / 1000.0))

    def _message_seconds(self, message):
        try:
            document = message.media.document
            attributes = document.attributes
            for index in range(attributes.size()):
                attribute = attributes.get(index)
                name = str(attribute.getClass().getSimpleName())
                if "Audio" in name:
                    return int(round(float(attribute.duration)))
        except Exception as exc:
            _swallow("_message_seconds", exc)
        return -1

    def _forward_message(self, message_object, dialog_id):
        room = self._room
        if not room:
            return
        account = int(room["account"])

        def forward():
            try:
                messages = ArrayList()
                messages.add(message_object)
                SendMessagesHelper.getInstance(account).sendMessage(messages, int(dialog_id), False, False, True, 0, 0)
                self._debug("Forward requested -> dialog %s" % dialog_id)
            except Exception:
                self._debug_exception("Forward error")

        run_on_ui_thread(forward)

    def _send_tl(self, request, callback, account):
        # client_utils.send_request in current exteraGram builds takes only
        # (request, callback) and always uses the selected account.
        try:
            if int(account) == int(UserConfig.selectedAccount):
                send_request(request, callback)
                return
        except Exception as exc:
            _swallow("_send_tl", exc)
        if _RequestDelegate is not None:
            ConnectionsManager.getInstance(int(account)).sendRequest(request, _RequestDelegate(callback))
            return
        send_request(request, callback)

    def _find_track_message(self, track):
        room = self._room
        if not room:
            return None
        cached = self._received_tracks.get(track.get("id"))
        if cached is not None:
            return cached
        document_id = str(track.get("document_id", "") or "")
        alias = self._track_aliases.get(document_id) if document_id else None
        if alias is not None:
            return alias
        for dialog_id in self._jam_dialogs(room):
            found = self._find_message(room["account"], int(dialog_id), int(track.get("message_id") or 0), document_id)
            if found is not None and (not document_id or self._document_id(found) == document_id) and self._is_audio_track(found):
                return found
        return None

    def _is_in_jam_chat(self, message_object):
        # Profile music lists build MessageObjects whose dialog id is the profile
        # owner: on a Jam partner's profile that equals a Jam chat id, so also
        # check that the message really exists there.
        room = self._room
        try:
            dialog_id = int(message_object.getDialogId())
            if not room or dialog_id not in self._jam_dialogs(room):
                return False
            message_id = int(message_object.getId())
            if message_id <= 0:
                return False
            found = self._find_message(room["account"], dialog_id, message_id)
            return found is not None and self._document_id(found) == self._document_id(message_object)
        except Exception as exc:
            _swallow("_is_in_jam_chat", exc)
            return False

    def _on_incoming_message_object(self, account, message_object):
        room = self._room
        if not room:
            return
        try:
            if int(account) != int(room["account"]) or int(message_object.getDialogId()) not in self._jam_dialogs(room):
                return
            document_id = self._document_id(message_object)
            if not document_id or int(message_object.getId()) <= 0:
                return
            pending = self._external_pending
            if pending and pending.get("document_id") == document_id and int(message_object.getDialogId()) == pending["dialog_id"]:
                self._external_copy_arrived(message_object)
                return
            track = self._awaiting_track
            if not track:
                return
            track_document = str(track.get("document_id", "") or "")
            if document_id != track_document and self._is_relayed_copy(message_object, track):
                # Telegram re-uploaded the file, so the copy has its own document id.
                self._debug("Track arrived as re-upload: doc=%s -> %s" % (document_id, track_document))
                self._doc_aliases[document_id] = track_document
                self._track_aliases[track_document] = message_object
                self._remember_temporary(document_id, int(message_object.getDialogId()))
                document_id = track_document
            if document_id == track_document:
                self._debug("Track arrived: doc=%s msg=%s" % (document_id, message_object.getId()))
                if not self._is_out(message_object):
                    # A copy made for us: remove it when our Jam ends.
                    self._remember_temporary(self._document_id(message_object), int(message_object.getDialogId()))
                self._received_tracks[track["id"]] = message_object
                self._send_track_status(track, "ready")
                self._relay_missing(track)
        except Exception:
            self._debug("NC incoming error: " + traceback.format_exc().splitlines()[-1])

    def _is_out(self, message_object):
        try:
            return bool(message_object.isOut())
        except Exception:
            try:
                return bool(message_object.messageOwner.out)
            except Exception as exc:
                _swallow("_is_out", exc)
                return False

    def _is_relayed_copy(self, message_object, track):
        try:
            if self._is_out(message_object) or not self._is_audio_track(message_object):
                return False
            expected = int(track.get("duration_ms", 0) or 0)
            actual = int(float(message_object.getDuration()) * 1000)
            return expected > 0 and abs(expected - actual) <= 2000
        except Exception as exc:
            _swallow("_is_relayed_copy", exc)
            return False

    def on_update_hook(self, update_name: str, account: int, update: Any) -> HookResult:
        if update_name != "TL_updateNewMessage" or not self._room or not self._awaiting_track:
            return HookResult()
        try:
            message = getattr(update, "message", None)
            if message is None:
                return HookResult()
            if self._message_document_id(message):
                self._on_incoming_message_object(account, MessageObject(account, message, True, True))
        except Exception:
            self._debug("Update hook error: " + traceback.format_exc().splitlines()[-1])
        return HookResult()

    def _ensure_message_observer(self, account):
        if account in self._message_observers:
            return

        def register():
            if account in self._message_observers:
                return
            try:
                try:
                    account_instance = get_account_instance(account)
                except TypeError:
                    account_instance = get_account_instance()
                notification_center = account_instance.getNotificationCenter()
                observer = _NewMessagesObserver(self)
                notification_center.addObserver(observer, NotificationCenter.didReceiveNewMessages)
                opened_id = getattr(NotificationCenter, "openedChatChanged", None)
                if opened_id is not None:
                    notification_center.addObserver(observer, opened_id)
                self._message_observers[account] = (notification_center, observer)
                self._debug("NC observer registered: account=%s" % account)
            except Exception:
                self._debug_exception("NC observer setup error")

        run_on_ui_thread(register)

    # ------------------------------------------------------------------ playback sync
    def _handle_room_state(self, message):
        room = self._room
        state = message.get("state")
        if not room or message.get("room_id") != room["room_id"] or not isinstance(state, dict):
            return
        if message.get("server_time_ms"):
            self._update_server_clock(message)
        revision = int(state.get("revision", 0) or 0)
        if revision <= room.get("revision", 0):
            self._debug("State rev %s dropped as stale (local %s)" % (revision, room.get("revision", 0)))
            return
        room["revision"] = revision
        room["state"] = state
        mine = state.get("updated_by") == room["member_id"]
        self._debug("State rev %s playing=%s pos=%s by %s%s" % (
            revision, state.get("playing"), state.get("position_ms"), state.get("updated_by"), " (mine)" if mine else ""))
        if mine:
            return
        self._play_synced_state(state)

    def _play_synced_state(self, state, searched=False):
        track = state.get("track") or {}
        message_object = self._find_track_message(track)
        if message_object is None:
            if searched:
                self._bulletin("error", _t("Не нашёл аудиосообщение. Открой чат и дождись загрузки трека."))
                return
            generation = self._sync_generation

            def found(_message_object):
                if generation == self._sync_generation and self._room and self._room.get("state") is state:
                    self._play_synced_state(state, searched=True)

            self._search_history(track, found, on_miss=lambda: found(None))
            return
        duration_ms = int(track.get("duration_ms", 0) or 0)
        delay = max(0, self._local_start_time(state) - self._local_now_ms())

        def start():
            try:
                position_ms = self._state_position(state, duration_ms)
                self._remote_action_until = self._local_now_ms() + 1000
                controller = MediaController.getInstance()
                current = controller.getPlayingMessageObject()
                desired_playing = bool(state.get("playing"))
                if self._matches_track(current, track):
                    actual_position_ms = self._message_position(current, duration_ms)
                    is_playing = not controller.isMessagePaused()
                    self._debug("Apply: same track, local playing=%s pos=%s -> want playing=%s pos=%s" % (
                        is_playing, actual_position_ms, desired_playing, position_ms))
                    if is_playing == desired_playing and abs(actual_position_ms - position_ms) <= 350:
                        return
                    # Same track is already loaded: adjust it instead of restarting.
                    if desired_playing and not is_playing:
                        controller.playMessage(current)
                    if duration_ms > 0 and abs(actual_position_ms - position_ms) > 350:
                        controller.seekToProgress(current, float(position_ms) / float(duration_ms))
                    if not desired_playing and is_playing:
                        controller.pauseMessage(current)
                    return
                self._debug("Apply: switching to track %s, playing=%s pos=%s" % (track.get("id"), desired_playing, position_ms))
                controller.playMessage(message_object)
                if duration_ms > 0:
                    controller.seekToProgress(message_object, float(position_ms) / float(duration_ms))
                if not desired_playing:
                    controller.pauseMessage(message_object)
            except Exception:
                self._debug_exception("Player error")
                self._bulletin("error", _t("Не удалось запустить Telegram-плеер."))

        # Until this state is really applied the player still shows the old position;
        # the host's periodic sync must not broadcast it over someone else's seek.
        self._apply_guard_until = self._local_now_ms() + delay + 2500
        run_on_ui_thread(start, delay)

    def _install_playback_hooks(self):
        controller_class = find_class("org.telegram.messenger.MediaController")
        if controller_class is None:
            return
        for method_name, event_type in (
            ("playMessage", "play"),
            ("pauseMessage", "pause"),
            ("seekToProgress", "seek"),
        ):
            try:
                hooks = self.hook_all_methods(
                    controller_class,
                    method_name,
                    _PlaybackHook(self, event_type),
                )
                if hooks:
                    self._playback_hooks.extend(hooks)
            except Exception:
                self.log("[telegram_jam] cannot hook %s: %s" % (method_name, traceback.format_exc()))
    def _install_player_close_hooks(self):
        controller_class = find_class("org.telegram.messenger.MediaController")
        if controller_class is None:
            return
        for method_name in ("cleanupPlayer", "stopAudio"):
            try:
                hooks = self.hook_all_methods(controller_class, method_name, _PlayerCloseHook(self))
                if hooks:
                    self._player_close_hooks.extend(hooks)
            except Exception:
                self._debug("Cannot hook player close %s: %s" % (method_name, traceback.format_exc().splitlines()[-1]))

    def _on_player_closed(self):
        # cleanupPlayer/stopAudio also run when the Jam itself switches tracks, and
        # several times in a row. Only a real close (nothing of the Jam is loaded
        # a moment later) pauses the room; everything else is our own doing.
        now = self._local_now_ms()
        room = self._room
        if not room or not room.get("state") or not self._can_control(room):
            return
        if now < self._remote_action_until:
            self._debug("Player closed during a synced action, ignored")
            return
        if now - self._last_close_at < 1500:
            return
        self._last_close_at = now
        generation = self._sync_generation

        def check():
            room = self._room
            if generation != self._sync_generation or not room or not room.get("state") or not self._can_control(room):
                return
            state = room["state"]
            track = state.get("track")
            if not track:
                return
            try:
                current = MediaController.getInstance().getPlayingMessageObject()
            except Exception:
                current = None
            if self._matches_track(current, track) or self._local_now_ms() < self._remote_action_until:
                self._debug("Player closed, but the Jam track is loaded again: ignored")
                return
            try:
                position = int(self._state_position(state, int(track.get("duration_ms", 0) or 0)))
            except Exception:
                position = int(state.get("position_ms", 0) or 0)
            self._debug("Player really closed -> pausing the room at %s" % position)
            self._send_room_state({
                "track": track,
                "playing": False,
                "position_ms": position,
                "start_at_server_ms": self._server_now_ms(),
                "revision": room.get("revision", 0) + 1,
            })

        run_on_ui_thread(check, 800)

    def _on_playback_event(self, event_type, param):
        now = self._local_now_ms()
        if now < self._remote_action_until or now - self._last_playback_event_at < 200:
            if self._room:
                self._debug("Playback %s ignored (own echo window, %s ms left)" % (
                    event_type, max(0, int(self._remote_action_until - now))))
            return
        self._last_playback_event_at = now
        room = self._room
        if not room:
            return
        if not self._can_control(room):
            self._debug("Playback %s without control (mode %s): reverting" % (event_type, room.get("control_mode")))
            # Without control a guest's own start/seek is reverted to the room state.
            if event_type != "pause" and room.get("state"):
                run_on_ui_thread(lambda: self._play_synced_state(room["state"]), 120)
            return
        try:
            message_object = param.args[0]
            if event_type == "play" and self._is_audio_track(message_object):
                current_track = (room.get("state") or {}).get("track")
                pending_track = (room.get("pending_track") or {}).get("track")
                if not (current_track and self._matches_track(message_object, current_track)) and not (
                    pending_track and self._matches_track(message_object, pending_track)
                ):
                    self._remote_action_until = now + 1000
                    MediaController.getInstance().pauseMessage(message_object)
                    if self._is_in_jam_chat(message_object):
                        self._offer_track(message_object)
                    else:
                        self._bring_external_track(message_object)
                    return
            if not room.get("state"):
                return
            track = room["state"]["track"]
            if not self._matches_track(message_object, track):
                self._debug("Playback %s: message is not the current Jam track, ignored" % event_type)
                return
            duration_ms = int(track.get("duration_ms", 0) or 0)
            position_ms = self._message_position(message_object, duration_ms)
            controller = MediaController.getInstance()
            playing = event_type != "pause" and not controller.isMessagePaused()
            self._debug("Playback %s -> sending playing=%s pos=%s" % (event_type, playing, position_ms))
            lead_ms = 600 if playing else 0
            self._send_room_state({
                "track": track,
                "playing": playing,
                "position_ms": position_ms + lead_ms,
                "start_at_server_ms": self._server_now_ms() + lead_ms,
                "revision": room.get("revision", 0) + 1,
            })
        except Exception:
            self._debug_exception("Playback event error")

    def _send_room_state(self, state):
        room = self._room
        if not room or not self._can_control(room):
            return
        room["state"] = dict(state, updated_by=room["member_id"])
        room["revision"] = state["revision"]
        self._send_ws({"type": "set_state", "room_id": room["room_id"], "state": state})

    def _start_sync_loop(self):
        self._sync_generation += 1
        generation = self._sync_generation
        run_on_ui_thread(lambda: self._sync_tick(generation), 15000)

    def _sync_tick(self, generation):
        if generation != self._sync_generation:
            return
        room = self._room
        if room and self._is_host(room) and room.get("state") and self._local_now_ms() < self._apply_guard_until:
            self._debug("Sync tick skipped: a newer state is still being applied")
        elif room and self._is_host(room) and room.get("state"):
            try:
                controller = MediaController.getInstance()
                message_object = controller.getPlayingMessageObject()
                track = room["state"]["track"]
                if self._matches_track(message_object, track):
                    duration_ms = int(track.get("duration_ms", 0) or 0)
                    playing = not controller.isMessagePaused()
                    lead_ms = 600 if playing else 0
                    self._send_room_state({
                        "track": track,
                        "playing": playing,
                        "position_ms": self._message_position(message_object, duration_ms) + lead_ms,
                        "start_at_server_ms": self._server_now_ms() + lead_ms,
                        "revision": room.get("revision", 0) + 1,
                    })
            except Exception:
                self._debug_exception("Sync tick error")
        run_on_ui_thread(lambda: self._sync_tick(generation), 15000)

    def _matches_track(self, message_object, track):
        # Message ids differ between chats, so the document id is the identity.
        if message_object is None or not track:
            return False
        try:
            document_id = str(track.get("document_id", "") or "")
            if document_id:
                local = self._document_id(message_object)
                return local == document_id or self._doc_aliases.get(local) == document_id
            return int(message_object.getId()) == int(track["message_id"])
        except Exception as exc:
            _swallow("_matches_track", exc)
            return False

    def _message_position(self, message_object, duration_ms):
        if duration_ms <= 0:
            return 0
        progress = max(0.0, min(1.0, float(getattr(message_object, "audioProgress", 0.0))))
        return int(duration_ms * progress)
    def _state_position(self, state, duration_ms):
        position_ms = max(0, int(state.get("position_ms", 0) or 0))
        if state.get("playing"):
            position_ms += max(0, self._server_now_ms() - int(state.get("start_at_server_ms", 0) or 0))
        if duration_ms:
            return min(position_ms, duration_ms)
        return position_ms
    def _find_message(self, account, dialog_id, message_id, document_id=""):
        try:
            controller = get_messages_controller(account)
        except TypeError:
            controller = get_messages_controller()
        except Exception as exc:
            _swallow("_find_message", exc)
            return None
        try:
            dialog_messages = get_private_field(controller, "dialogMessage")
            messages = dialog_messages.get(dialog_id) if dialog_messages else None
            if messages is not None:
                for index in range(messages.size()):
                    message_object = messages.get(index)
                    if int(message_object.getId()) == message_id:
                        return message_object
                    if document_id and self._document_id(message_object) == document_id:
                        return message_object
        except Exception:
            self.log("[telegram_jam] track lookup error: " + traceback.format_exc())
        try:
            storage = get_messages_storage(account)
            message = storage.getMessage(int(dialog_id), int(message_id))
            if message is not None:
                return MessageObject(account, message, True, True)
        except TypeError:
            try:
                storage = get_messages_storage()
                message = storage.getMessage(int(dialog_id), int(message_id))
                if message is not None:
                    return MessageObject(account, message, True, True)
            except Exception as exc:
                _swallow("_find_message", exc)
        except Exception as exc:
            _swallow("_find_message", exc)
        return None
    def _document_id(self, message_object):
        try:
            media = message_object.messageOwner.media
            document = media.document if media else None
            return str(document.id) if document else ""
        except Exception as exc:
            _swallow("_document_id", exc)
            return ""
    def _message_document_id(self, message):
        try:
            media = message.media
            document = media.document if media else None
            return str(document.id) if document else ""
        except Exception as exc:
            _swallow("_message_document_id", exc)
            return ""
    def _is_audio_track(self, message_object):
        try:
            return bool(message_object.isMusic() or message_object.isVoice())
        except Exception as exc:
            _swallow("_is_audio_track", exc)
            return False
    def _code_entity(self, prefix_text, command):
        try:
            entity = TLRPC.TL_messageEntityCode()
            entity.offset = self._utf16_length(prefix_text)
            entity.length = self._utf16_length(command)
            entities = ArrayList()
            entities.add(entity)
            return entities
        except Exception as exc:
            _swallow("_code_entity", exc)
            return None
    def _utf16_length(self, text):
        return len(text.encode("utf-16-le")) // 2

    # ------------------------------------------------------------------ chat menu
    def _remove_menu_items(self):
        for item_id in self._menu_item_ids:
            try:
                self.remove_menu_item(item_id)
            except Exception as exc:
                _swallow("_remove_menu_items", exc)
        self._menu_item_ids = []

    def _add_chat_item(self, text, icon, handler):
        try:
            self._menu_item_ids.append(self.add_menu_item(MenuItemData(
                menu_type=MenuItemType.CHAT_ACTION_MENU,
                text=text,
                icon=icon,
                on_click=handler,
            )))
        except Exception:
            self._debug_exception("Menu item error")

    def _refresh_chat_menu(self):
        self._remove_menu_items()
        room = self._room
        if not room:
            self._add_chat_item(_t("Запустить Jam"), "msg_music", lambda context: self._menu_call(context, self._start_jam))
            return
        if self._is_creator(room):
            self._add_chat_item(_t("Пригласить в Jam"), "msg_add", lambda context: self._menu_call(context, self._invite_jam))
        self._add_chat_item(_t("Панель Jam"), "msg_settings", lambda _context: self._open_panel())
        if self._is_creator(room):
            self._add_chat_item(_t("Завершить Jam"), "msg_stop", lambda _context: self._end_jam())
        else:
            self._add_chat_item(_t("Выйти из Jam"), "msg_close", lambda _context: self._leave_jam())

    def _menu_call(self, context, handler):
        try:
            dialog_id = context.get("dialog_id")
            if dialog_id is None:
                dialog_id = context.get("dialogId")
            account = context.get("account")
            handler(int(account) if account is not None else 0, int(dialog_id), "")
        except Exception:
            self._debug_exception("Menu click error")

    def _room_changed(self):
        self._save_session()
        if not self._room:
            run_on_ui_thread(self._close_tab_overlay)
        run_on_ui_thread(self._refresh_chat_menu)
        # Rebuild folder tabs only when the Jam tab should appear or disappear.
        wanted = bool(self._room) and bool(self.get_setting("folder_tab", False))
        if wanted != self._tab_wanted:
            self._tab_wanted = wanted
            run_on_ui_thread(self._refresh_folder_tabs)

    # ------------------------------------------------------------------ folder tab (experimental)
    def _on_folder_tab_change(self, enabled):
        self._tab_wanted = bool(enabled) and bool(self._room)
        if enabled and not self._tab_hooks:
            self._safe_setup("folder tab", self._install_tab_hooks)
        run_on_ui_thread(self._refresh_folder_tabs)

    def _install_tab_hooks(self):
        dialogs_class = find_class("org.telegram.ui.DialogsActivity")
        tabs_class = find_class("org.telegram.ui.Components.FilterTabsView")
        if dialogs_class is None or tabs_class is None:
            self._debug("Folder tab: classes not found")
            return
        self._tab_hooks.extend(self.hook_all_methods(dialogs_class, "updateFilterTabs", _TabsUpdatedHook(self)) or [])
        self._tab_hooks.extend(self.hook_all_methods(tabs_class, "scrollToTab", _TabClickHook(self)) or [])
        # Also catch the chat list when it is created or shown again, so the tab
        # appears without waiting for Telegram to rebuild the folders.
        self._tab_hooks.extend(self.hook_all_methods(dialogs_class, "onResume", _TabsUpdatedHook(self)) or [])
        self._tab_hooks.extend(self.hook_all_methods(dialogs_class, "onBackPressed", _BackPressHook(self)) or [])
        main_tabs = find_class("org.telegram.ui.MainTabsActivity")
        if main_tabs is not None:
            self._tab_hooks.extend(self.hook_all_methods(main_tabs, "onResume", _TabsUpdatedHook(self)) or [])
        self._debug("Folder tab hooks: %s" % len(self._tab_hooks))
        if not self._tab_hooks:
            self._debug("Folder tab: updateFilterTabs/scrollToTab not found in this client")

    def _dialogs_fragments(self, fragment):
        # Newer clients wrap the chat list in MainTabsActivity: dig it out.
        try:
            if fragment is None:
                return []
            if str(fragment.getClass().getName()).endswith("DialogsActivity"):
                return [fragment]
            found = []
            klass = fragment.getClass()
            while klass is not None and not found:
                for field in klass.getDeclaredFields():
                    if str(field.getType().getName()).endswith(".DialogsActivity"):
                        field.setAccessible(True)
                        value = field.get(fragment)
                        if value is not None:
                            found.append(value)
                klass = klass.getSuperclass()
            return found
        except Exception:
            self._debug("Folder tab: fragment lookup failed: " + traceback.format_exc().splitlines()[-1])
            return []

    def _add_jam_tab(self, tabs):
        attempts = (
            # exteraGram 12.x: (id, stableId, title, emoticon, entities, noanimate, isDefault, isLocked)
            lambda: tabs.addTab(JAM_TAB_ID, JAM_TAB_ID, "Jam", "🎵", None, False, False, False),
            lambda: tabs.addTab(JAM_TAB_ID, JAM_TAB_ID, "🎵 Jam", ArrayList(), False, False, False),
            lambda: tabs.addTab(JAM_TAB_ID, JAM_TAB_ID, "🎵 Jam", False, False, False),
            lambda: tabs.addTab(JAM_TAB_ID, JAM_TAB_ID, "🎵 Jam", None, False, False, False),
        )
        last = None
        for attempt in attempts:
            try:
                attempt()
                return True
            except Exception as error:
                last = error
        self._debug("Folder tab: addTab failed: %s" % last)
        return False

    def _on_filter_tabs_updated(self, fragment):
        fragments = self._dialogs_fragments(fragment)
        if not fragments:
            return
        for item in fragments:
            self._on_dialogs_fragment(item)

    def _on_dialogs_fragment(self, fragment):
        # Telegram rebuilds and re-selects tabs on its own (app start, account
        # switch): taps reported right after that are not the user's.
        self._tabs_rebuilt_at = self._local_now_ms()
        if fragment not in self._tab_fragments:
            self._tab_fragments = [item for item in self._tab_fragments[-4:]] + [fragment]
        if not self._room or not self.get_setting("folder_tab", False):
            return
        try:
            if int(fragment.getCurrentAccount()) != int(self._room["account"]):
                return
        except Exception as exc:
            _swallow("_on_dialogs_fragment", exc)
        tabs = get_private_field(fragment, "filterTabsView")
        if tabs is None:
            self._debug("Folder tab: no filterTabsView (no chat folders?)")
            return
        id_to_position = get_private_field(tabs, "idToPosition")
        if id_to_position is not None and int(id_to_position.get(JAM_TAB_ID, -1)) >= 0:
            return
        if not self._add_jam_tab(tabs):
            return
        try:
            tabs.finishAddingTabs(False)
        except Exception as exc:
            _swallow("_on_dialogs_fragment", exc)
        try:
            adapter = get_private_field(tabs, "adapter")
            if adapter is not None:
                adapter.notifyDataSetChanged()
            tabs.requestLayout()
            tabs.invalidate()
        except Exception as exc:
            _swallow("_on_dialogs_fragment", exc)
        self._hook_tab_delegate(tabs)
        self._debug("Folder tab added")

    def _hook_tab_delegate(self, tabs):
        # The tap reaches DialogsActivity through FilterTabsView's delegate
        # (onPageSelected / didSelectTab): intercept it for the Jam tab.
        try:
            delegate = get_private_field(tabs, "delegate")
            if delegate is None:
                return
            klass = delegate.getClass()
            name = str(klass.getName())
            if name in self._tab_delegate_classes:
                return
            self._tab_delegate_classes.add(name)
            count = 0
            for method_name in ("onPageSelected", "didSelectTab", "onTabSelected"):
                hooks = self.hook_all_methods(klass, method_name, _TabClickHook(self)) or []
                self._tab_hooks.extend(hooks)
                count += len(hooks)
            self._debug("Folder tab delegate hooks: %s (%s)" % (count, name))
        except Exception:
            self._debug_exception("Folder tab delegate hook error")

    def _on_jam_tab_click(self, source=None):
        now = self._local_now_ms()
        if now - self._last_tab_click < 800:
            return
        if now - self._tabs_rebuilt_at < 1500 or now - self._loaded_at < 3000:
            self._debug("Folder tab: ignored automatic selection")
            return
        self._last_tab_click = now
        fragment = self._fragment_for_tabs(source)
        if self._tab_overlay is not None:
            run_on_ui_thread(self._close_tab_overlay)
            return
        run_on_ui_thread(lambda: self._show_tab_overlay(fragment))

    def _fragment_for_tabs(self, source):
        for fragment in reversed(self._tab_fragments):
            try:
                tabs = get_private_field(fragment, "filterTabsView")
                if source is None or tabs is source or (tabs is not None and get_private_field(tabs, "delegate") is source):
                    return fragment
            except Exception as exc:
                _swallow("_fragment_for_tabs", exc)
        return self._tab_fragments[-1] if self._tab_fragments else None

    # The Jam page sits in place of the chat list, under the folder tabs.
    def _show_tab_overlay(self, fragment):
        try:
            if not self._room or fragment is None:
                self._open_panel()
                return
            root = fragment.getFragmentView()
            tabs = get_private_field(fragment, "filterTabsView")
            activity = fragment.getParentActivity()
            if root is None or tabs is None or activity is None:
                self._open_panel()
                return
            self._close_tab_overlay()
            url = self._ensure_panel_server()
            from android.graphics import Color
            from android.view import ViewGroup
            from android.webkit import WebView, WebViewClient
            from android.widget import FrameLayout
            from java import jarray, jint
            root_xy = jarray(jint)(2)
            tabs_xy = jarray(jint)(2)
            root.getLocationInWindow(root_xy)
            tabs.getLocationInWindow(tabs_xy)
            top = max(0, int(tabs_xy[1]) + int(tabs.getHeight()) - int(root_xy[1]))
            container = FrameLayout(activity)
            container.setBackgroundColor(Color.parseColor("#1a0f28"))
            container.setClickable(True)
            view = WebView(activity)
            settings = view.getSettings()
            settings.setJavaScriptEnabled(True)
            settings.setDomStorageEnabled(True)
            view.setBackgroundColor(Color.parseColor("#1a0f28"))
            view.setWebViewClient(WebViewClient())
            container.addView(view, FrameLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT))
            params = FrameLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT)
            params.topMargin = top
            root.addView(container, params)
            try:
                container.setElevation(1000.0)
                container.setTranslationZ(1000.0)
            except Exception as exc:
                _swallow("_show_tab_overlay", exc)
            container.bringToFront()
            previous = None
            try:
                previous = int(get_private_field(tabs, "selectedTabId"))
                tabs.selectTabWithId(JAM_TAB_ID, 1.0)
            except Exception as exc:
                _swallow("_show_tab_overlay", exc)
            self._tab_overlay = {"root": root, "container": container, "view": view, "tabs": tabs, "previous": previous}
            opened_at = time.time()
            # exteraGram's bottom bar floats over the chat list: keep the page's
            # last buttons above it.
            bottom_pad = self._bottom_bar_overlap(activity, root)
            view.loadUrl(url + "&app=1&pb=%s" % bottom_pad)
            self._debug("Folder tab: page shown (top=%s)" % top)

            def check():
                overlay = self._tab_overlay
                if overlay and overlay["container"] is container and self._panel_seen_at < opened_at:
                    self._debug("Folder tab: WebView did not load, using the browser")
                    self._close_tab_overlay()
                    Browser.openUrl(activity, self._panel.url, False)

            run_on_ui_thread(check, 4000)
        except Exception:
            self._debug("Folder tab page error: " + traceback.format_exc().splitlines()[-1])
            self._close_tab_overlay()
            self._open_panel()

    def _bottom_bar_overlap(self, activity, root):
        try:
            from java import jarray, jint
            density = float(activity.getResources().getDisplayMetrics().density) or 1.0
            root_xy = jarray(jint)(2)
            root.getLocationInWindow(root_xy)
            root_bottom = int(root_xy[1]) + int(root.getHeight())
            best = 0
            stack = [activity.getWindow().getDecorView()]
            while stack:
                view = stack.pop()
                name = str(view.getClass().getName())
                if "MainTabsLayout" in name or "BottomNavigation" in name:
                    if int(view.getVisibility()) == 0 and int(view.getHeight()) > 0:
                        xy = jarray(jint)(2)
                        view.getLocationInWindow(xy)
                        best = max(best, root_bottom - int(xy[1]))
                    continue
                try:
                    count = int(view.getChildCount())
                except Exception:
                    count = 0
                for index in range(count):
                    stack.append(view.getChildAt(index))
            pad = int(max(0, best) / density)
            if pad == 0:
                try:
                    bar = find_class("com.exteragram.messenger.ExteraConfig$BottomNavigationBar")
                    if bar is not None and bool(bar.getMethod("visible").invoke(None)):
                        pad = 88
                except Exception as exc:
                    _swallow("_bottom_bar_overlap", exc)
            self._debug("Folder tab: bottom bar overlap %s dp" % pad)
            return pad
        except Exception:
            self._debug("Folder tab: bottom bar lookup failed: " + traceback.format_exc().splitlines()[-1])
            return 96

    def _close_tab_overlay(self):
        overlay = self._tab_overlay
        self._tab_overlay = None
        if not overlay:
            return
        try:
            overlay["root"].removeView(overlay["container"])
        except Exception as exc:
            _swallow("_close_tab_overlay", exc)
        try:
            overlay["view"].destroy()
        except Exception as exc:
            _swallow("_close_tab_overlay", exc)
        try:
            if overlay.get("previous") is not None and overlay["previous"] != JAM_TAB_ID:
                overlay["tabs"].selectTabWithId(int(overlay["previous"]), 1.0)
        except Exception as exc:
            _swallow("_close_tab_overlay", exc)

    def _refresh_folder_tabs(self):
        if not self._tab_fragments:
            try:
                for fragment in self._dialogs_fragments(get_last_fragment()):
                    self._tab_fragments.append(fragment)
            except Exception as exc:
                _swallow("_refresh_folder_tabs", exc)
        if not self._tab_fragments:
            self._debug("Folder tab: chat list not found yet")
        for fragment in list(self._tab_fragments):
            try:
                method = fragment.getClass().getDeclaredMethod("updateFilterTabs", Boolean.TYPE, Boolean.TYPE)
                method.setAccessible(True)
                method.invoke(fragment, True, False)
            except Exception:
                self._debug("Folder tab refresh failed: " + traceback.format_exc().splitlines()[-1])

    # ------------------------------------------------------------------ calls, clock, socket
    def _install_call_hook(self):
        try:
            service_class = find_class("org.telegram.messenger.voip.VoIPService")
            if service_class is None:
                return
            method = service_class.getDeclaredMethod("onDestroy")
            method.setAccessible(True)
            self._call_hook = self.hook_method(method, _CallEndedHook(self))
        except Exception:
            self.log("[telegram_jam] call hook unavailable: " + traceback.format_exc())
    def _on_call_finished(self):
        room = self._room
        if not room or self._call_end_in_progress:
            return
        self._call_end_in_progress = True
        self._send_ws({
            "type": "end_for_all",
            "room_id": room["room_id"],
        })
        self._bulletin("info", _t("Звонок завершён, Jam остановлен."))
    def _update_server_clock(self, message):
        try:
            self._server_offset_ms = int(message["server_time_ms"]) - self._local_now_ms()
        except Exception as exc:
            _swallow("_update_server_clock", exc)
    def _local_now_ms(self):
        import time
        return int(time.time() * 1000)
    def _server_now_ms(self):
        return self._local_now_ms() + self._server_offset_ms
    def _local_start_time(self, state):
        return int(state.get("start_at_server_ms", 0) or 0) - self._server_offset_ms
    def _send_ws(self, message):
        try:
            with self._socket_lock:
                socket = self._socket
            if socket is None:
                if self._is_reconnecting():
                    self._bulletin("info", _t("Переподключаюсь к Jam-серверу, попробуй через пару секунд."))
                else:
                    self._bulletin("error", _t("Нет подключения к Jam-серверу."))
                return False
            socket.send(json.dumps(message, separators=(",", ":")))
            return True
        except Exception:
            self.log("[telegram_jam] send error: " + traceback.format_exc())
            self._bulletin("error", _t("Не удалось отправить команду Jam-серверу."))
            return False
    def _disconnect(self):
        self._disconnecting = True
        with self._socket_lock:
            socket = self._socket
            self._socket = None
        try:
            if socket:
                socket.close()
        except Exception as exc:
            _swallow("_disconnect", exc)

    # ------------------------------------------------------------------ reset & cleanup
    def _reset_room(self, text=None, error=False, cleanup=True):
        room = self._room
        self._sync_generation += 1
        self._room = None
        self._pending = None
        self._awaiting_track = None
        self._received_tracks = {}
        self._relayed = set()
        self._known_tracks = {}
        self._missing = {}
        self._track_aliases = {}
        self._doc_aliases = {}
        self._external_pending = None
        self._call_end_in_progress = False
        if cleanup:
            self._cleanup_temporary_tracks(room)
        else:
            self._forget_temporary_tracks()
        self._disconnect()
        self._room_changed()
        if text:
            self._bulletin("error" if error else "info", text)

    def _remember_temporary(self, document_id, dialog_id, original_id=0):
        if not document_id:
            return
        info = self._temporary_documents.setdefault(document_id, {"original_ids": set()})
        if original_id:
            info["original_ids"].add(int(original_id))

    # ------------------------------------------------------------------ session (survives restarts and crashes)
    def _save_session(self):
        room = self._room
        try:
            if not room or not room.get("token"):
                if self.get_setting(SESSION_KEY, ""):
                    self.set_setting(SESSION_KEY, "")
                return
            data = {
                "v": 1,
                "saved_at": int(time.time()),
                "room": {
                    key: room.get(key) for key in (
                        "room_id", "room_code", "member_id", "token", "account", "server_url", "started_at",
                        "home_dialog", "member_dialogs", "tickets", "creator_id", "host_id", "control_mode",
                        "members", "banned", "max_participants", "state", "revision",
                    )
                },
                "all_dialogs": sorted(int(item) for item in room.get("all_dialogs") or []),
                "documents": {doc: sorted(info["original_ids"]) for doc, info in self._temporary_documents.items()},
                "texts": sorted(self._cleanup_texts),
                "marks": sorted([list(item) for item in self._relay_marks]),
                "copies": sorted([list(item) for item in self._sent_copies]),
            }
            self.set_setting(SESSION_KEY, json.dumps(data, separators=(",", ":")))
        except Exception:
            self._debug_exception("Session save error")

    def _restore_session(self):
        raw = self.get_setting(SESSION_KEY, "")
        if not raw or self._room:
            return
        try:
            data = json.loads(raw)
            saved = data.get("room") or {}
            if time.time() - int(data.get("saved_at", 0)) > SESSION_MAX_AGE_S or not saved.get("token"):
                self.set_setting(SESSION_KEY, "")
                return
            room = dict(saved)
            room["member_dialogs"] = {str(k): int(v) for k, v in (saved.get("member_dialogs") or {}).items()}
            room["tickets"] = dict(saved.get("tickets") or {})
            room["all_dialogs"] = set(int(item) for item in data.get("all_dialogs") or [])
            room["pending_track"] = None
            room["revision"] = int(saved.get("revision") or 0)
            room["reconnect_attempt"] = 1
            room["reconnect_since"] = time.time()
            self._temporary_documents = {
                doc: {"original_ids": set(int(item) for item in ids)} for doc, ids in (data.get("documents") or {}).items()
            }
            self._cleanup_texts = set(data.get("texts") or [])
            self._relay_marks = set(tuple(item) for item in data.get("marks") or [])
            self._sent_copies = set(tuple(item) for item in data.get("copies") or [])
            self._room = room
            self._debug("Session restored: room %s, reconnecting" % room.get("room_id"))
            self._ensure_message_observer(int(room["account"]))
            self._start_sync_loop()
            self._bulletin("info", _t("Возвращаюсь в Jam…"))
            self._resume_connect(room)
        except Exception:
            self._debug_exception("Session restore error")
            try:
                self.set_setting(SESSION_KEY, "")
            except Exception as exc:
                _swallow("_restore_session", exc)

    def _forget_temporary_tracks(self):
        self._temporary_documents = {}
        self._cleanup_texts = set()
        self._relay_marks = set()
        self._sent_copies = set()

    def _cleanup_temporary_tracks(self, room=None):
        # Snapshot and reset at once so a new Jam never shares these sets.
        documents = dict(self._temporary_documents)
        texts = set(self._cleanup_texts)
        marks = set(self._relay_marks)
        copies = set(self._sent_copies)
        self._forget_temporary_tracks()
        if not room or not self.get_setting("delete_temp_tracks", True) or (not documents and not texts and not marks and not copies):
            return
        dialogs = set(room.get("all_dialogs") or [])
        if room.get("home_dialog"):
            dialogs.add(int(room["home_dialog"]))
        for dialog_id in dialogs:
            job = {
                "account": int(room["account"]),
                "dialog_id": int(dialog_id),
                "since": int(room.get("started_at", 0) or 0) - 30,
                "documents": documents,
                "texts": texts,
                "marks": marks,
                "copies": copies,
            }
            run_on_ui_thread(lambda job=job: self._run_cleanup(job), CLEANUP_DELAY_MS)

    def _run_cleanup(self, job):
        account = job["account"]
        dialog_id = job["dialog_id"]

        def on_history(response, error):
            if error is not None or response is None:
                self._debug("Cleanup history error: %s" % getattr(error, "text", error))
                return
            ids = []
            originals = set()
            for info in job["documents"].values():
                originals |= info["original_ids"]
            try:
                messages = response.messages
                for index in range(messages.size()):
                    message = messages.get(index)
                    message_id = int(message.id)
                    if message_id <= 0 or int(getattr(message, "date", 0) or 0) < job["since"]:
                        continue
                    document_id = self._message_document_id(message)
                    info = job["documents"].get(document_id) if document_id else None
                    if info is not None and message_id not in info["original_ids"]:
                        ids.append(message_id)
                        continue
                    if (dialog_id, message_id) in job["copies"]:
                        ids.append(message_id)
                        continue
                    if document_id and bool(getattr(message, "out", False)) and message_id not in originals:
                        seconds = self._message_seconds(message)
                        if seconds >= 0 and any((dialog_id, seconds + d) in job["marks"] for d in (-1, 0, 1)):
                            ids.append(message_id)
                            continue
                    if str(getattr(message, "message", "") or "") in job["texts"]:
                        ids.append(message_id)
            except Exception:
                self._debug_exception("Cleanup scan error")
                return
            self._debug("Cleanup dialog %s: %s message(s)" % (dialog_id, len(ids)))
            if ids:
                run_on_ui_thread(lambda: self._delete_messages(account, dialog_id, ids))

        try:
            request = TLRPC.TL_messages_getHistory()
            request.peer = get_messages_controller(account).getInputPeer(dialog_id)
            request.limit = CLEANUP_HISTORY_LIMIT
            self._send_tl(request, on_history, account)
        except Exception:
            self._debug_exception("Cleanup request error")

    def _delete_messages(self, account, dialog_id, ids):
        try:
            controller = get_messages_controller(account)
            java_ids = ArrayList()
            for message_id in sorted(set(ids)):
                java_ids.add(Integer(int(message_id)))
            # Jam copies are shared chat artifacts: revoke them for both sides.
            for call_args in (
                (java_ids, None, None, dialog_id, 0, True, 0),
                (java_ids, None, None, dialog_id, True, 0),
                (java_ids, None, None, dialog_id, True, False),
            ):
                try:
                    controller.deleteMessages(*call_args)
                    self._debug("Cleanup deleted %s messages" % java_ids.size())
                    return
                except Exception as exc:
                    _swallow("_delete_messages", exc)
                    continue
            self._debug("Cleanup delete failed for ids=%s" % sorted(set(ids)))
        except Exception:
            self._debug_exception("Cleanup delete error")

    # ------------------------------------------------------------------ panel
    def _panel_port(self):
        value = str(self.get_setting("panel_port", "") or "").strip()
        try:
            port = int(value)
        except ValueError:
            return 0
        return port if 1024 <= port <= 65535 else 0

    def _ensure_panel_server(self):
        port = self._panel_port()
        if self._panel and self._panel.requested_port != port:
            self._panel.close()
            self._panel = None
        if not self._panel:
            self._panel = _JamPanelServer(self, port)
            if port and self._panel.port != port:
                self._bulletin("info", _t("Порт %s занят, панель открыта на другом.") % port)
        return self._panel.url

    def _open_panel(self):
        try:
            self._ensure_panel_server()
            self._debug("Opening panel: port=%s" % self._panel.port)
            fragment = get_last_fragment()
            activity = fragment.getParentActivity() if fragment else None
            if activity is not None and self._show_panel_window(activity, self._panel.url + "&app=1"):
                return
            context = activity or ApplicationLoader.applicationContext
            Browser.openUrl(context, self._panel.url, False)
        except Exception:
            self._debug("Panel open error: " + traceback.format_exc().splitlines()[-1])
            self._bulletin("error", _t("Не удалось открыть локальную панель Jam."))

    def _show_panel_window(self, activity, url):
        # A WebView inside Telegram, like Mini Apps, instead of the external browser.
        try:
            self._close_panel_window()
            from android.app import Dialog
            from android.graphics import Color
            from android.webkit import WebView, WebViewClient
            style = find_class("android.R$style")
            theme = getattr(style, "Theme_DeviceDefault_NoActionBar", 0) if style is not None else 0
            dialog = Dialog(activity, theme) if theme else Dialog(activity)
            view = WebView(activity)
            settings = view.getSettings()
            settings.setJavaScriptEnabled(True)
            settings.setDomStorageEnabled(True)
            view.setBackgroundColor(Color.parseColor("#1a0f28"))
            view.setWebViewClient(WebViewClient())
            dialog.setContentView(view)
            dialog.setCancelable(True)
            opened_at = time.time()
            self._panel_window = (dialog, view)
            dialog.show()
            view.loadUrl(url)

            def check():
                # Some builds forbid plain http in WebViews: the page then never
                # asks for its state, so fall back to the browser.
                if self._panel_window and self._panel_window[0] is dialog and self._panel_seen_at < opened_at:
                    self._debug("Panel WebView did not load, using the browser")
                    self._close_panel_window()
                    Browser.openUrl(activity, self._panel.url, False)

            run_on_ui_thread(check, 4000)
            return True
        except Exception:
            self._debug("Panel WebView error: " + traceback.format_exc().splitlines()[-1])
            self._close_panel_window()
            return False

    def _close_panel_window(self):
        window = self._panel_window
        self._panel_window = None
        if not window:
            return
        dialog, view = window
        for action in (dialog.dismiss, view.destroy):
            try:
                action()
            except Exception as exc:
                _swallow("_close_panel_window", exc)

    def _panel_state(self):
        self._panel_seen_at = time.time()
        room = self._room
        if not room:
            return {"active": False}
        state = room.get("state") or {}
        track = state.get("track") or {}
        duration = int(track.get("duration_ms", 0) or 0)
        playing = bool(state.get("playing"))
        position = self._state_position(state, duration) if playing else int(state.get("position_ms", 0) or 0)
        if track:
            try:
                controller = MediaController.getInstance()
                current = controller.getPlayingMessageObject()
                if self._matches_track(current, track):
                    position = self._message_position(current, duration)
                    playing = not controller.isMessagePaused()
                else:
                    playing = False
            except Exception as exc:
                _swallow("_panel_state", exc)
        members = []
        for member in room.get("members", []):
            members.append({
                "id": member.get("id"),
                "name": member.get("name") or "?",
                "connected": bool(member.get("connected")),
                "creator": member.get("id") == room.get("creator_id"),
                "host": member.get("id") == room.get("host_id"),
                "me": member.get("id") == room["member_id"],
            })
        return {
            "active": True,
            "is_host": self._is_host(room),
            "is_creator": self._is_creator(room),
            "control_mode": room.get("control_mode") or "leader",
            "can_control": self._can_control(room),
            "has_track": bool(track),
            "loading": bool(room.get("pending_track")),
            "track": str(track.get("title") or ""),
            "performer": str(track.get("performer") or ""),
            "playing": playing,
            "position_ms": int(position),
            "duration_ms": duration,
            "members": members,
            "banned": [{"id": ban.get("id"), "name": ban.get("name") or "?"} for ban in room.get("banned", [])],
            "max_participants": int(room.get("max_participants") or 0),
            "server": self._server_label(room.get("server_url", "")),
        }

    def _panel_action(self, action, value=""):
        if action == "close":
            self._close_panel_window()
            self._close_tab_overlay()
            return
        room = self._room
        if not room:
            return
        if action == "leave":
            self._leave_jam()
            return
        if action == "end":
            self._end_jam()
            return
        if action == "mode":
            self._set_control_mode("both" if value == "both" else "leader", persist=True)
            return
        if action in ("kick", "host", "unban"):
            if not self._is_host(room):
                self._bulletin("error", _t("Это может сделать только хост."))
                return
            payloads = {
                "kick": {"type": "kick_member", "member_id": value},
                "host": {"type": "transfer_host", "member_id": value},
                "unban": {"type": "unban_member", "ban_id": value},
            }
            payload = dict(payloads[action], room_id=room["room_id"])
            self._send_ws(payload)
            if action == "unban":
                self._bulletin("info", _t("Убран из чёрного списка. Пригласи его снова через меню чата."))
            return
        if action not in ("toggle", "seek", "skip"):
            return
        self._debug("Panel %s %s (control %s, mode %s)" % (action, value, self._can_control(room), room.get("control_mode")))
        if not self._can_control(room):
            self._bulletin("error", _t("Управлять плеером может только хост."))
            return
        try:
            track = (room.get("state") or {}).get("track")
            if not track:
                self._bulletin("error", _t("Сначала добавь трек в Jam."))
                return
            duration = int(track.get("duration_ms", 0) or 0)
            controller = MediaController.getInstance()
            current = controller.getPlayingMessageObject()
            if self._matches_track(current, track):
                position = self._message_position(current, duration)
                playing = not controller.isMessagePaused()
            else:
                # This player is not on the Jam track (closed, or something else plays):
                # the room's own state is the truth, not "paused".
                position = self._state_position(room.get("state") or {}, duration)
                playing = bool((room.get("state") or {}).get("playing"))
                self._debug("Panel: local player is not on the Jam track, using room state (playing=%s)" % playing)
            if action == "toggle":
                playing = not playing
            elif action == "seek":
                position = int(float(value))
            else:
                position += int(float(value))
            if duration > 0:
                position = min(position, max(0, duration - 500))
            position = max(0, position)
            lead_ms = 400 if playing else 0
            state = {
                "track": track,
                "playing": playing,
                "position_ms": int(position),
                "start_at_server_ms": self._server_now_ms() + lead_ms,
                "revision": room.get("revision", 0) + 1,
            }
            self._debug("Panel -> state playing=%s pos=%s" % (playing, int(position)))
            self._send_room_state(state)
            self._play_synced_state(state)
        except Exception:
            self._debug_exception("Panel action error")

    def _panel_html(self, token):
        lang = _lang()
        page = PANEL_HTML.replace("__TOKEN__", escape(token))
        page = page.replace("__LANG__", lang)
        return page.replace("__I18N__", json.dumps(PANEL_STRINGS[lang], ensure_ascii=False))

    # ------------------------------------------------------------------ server check
    def _check_server(self):
        server_url = self._server_url()
        if not server_url:
            self._bulletin("error", _t("Укажи адрес Jam-сервера в настройках плагина."))
            return
        self._bulletin("info", _t("Проверяю %s…") % self._server_label(server_url))

        def worker():
            socket = None
            try:
                from websocket import create_connection

                started = time.time()
                socket = create_connection(server_url, timeout=8)
                connect_ms = int((time.time() - started) * 1000)
                hello = {}
                deadline = time.time() + 8
                while time.time() < deadline and hello.get("type") != "hello":
                    hello = json.loads(socket.recv())
                rtts = []
                for _ in range(3):
                    sent = time.time()
                    socket.send('{"type":"ping"}')
                    while json.loads(socket.recv()).get("type") != "pong":
                        pass
                    rtts.append(int((time.time() - sent) * 1000))
                self._report_server(server_url, hello, connect_ms, sorted(rtts)[len(rtts) // 2])
            except Exception:
                self._debug("Server check failed: " + traceback.format_exc().splitlines()[-1])
                self._show_server_report(_t("Сервер недоступен"), _t("Не удалось подключиться к %s.\n\nПроверь адрес, интернет и работает ли сервер.") % server_url)
            finally:
                try:
                    if socket:
                        socket.close()
                except Exception as exc:
                    _swallow("worker", exc)

        threading.Thread(target=worker, name="telegram-jam-check", daemon=True).start()

    def _report_server(self, server_url, hello, connect_ms, ping_ms):
        protocol = int(hello.get("protocol") or 1)
        min_version = str(hello.get("min_plugin_version") or "")
        lines = [
            _t("Адрес: %s") % server_url,
            _t("Пинг: %s мс (подключение %s мс)") % (ping_ms, connect_ms),
            _t("Версия сервера: %s, протокол %s") % (hello.get("server_version") or "?", protocol),
        ]
        if hello.get("max_participants"):
            lines.append(_t("Лобби: до %s человек") % hello.get("max_participants"))
        if protocol < MIN_SERVER_PROTOCOL:
            title = _t("Сервер устарел")
            lines.append(_t("Этот плагин требует протокол %s или новее.") % MIN_SERVER_PROTOCOL)
        elif min_version and _version_tuple(__version__) < _version_tuple(min_version):
            title = _t("Плагин устарел для этого сервера")
            lines.append(_t("Сервер принимает плагин от версии %s, у тебя %s.") % (min_version, __version__))
        else:
            title = _t("Сервер работает")
            lines.append(_t("Можно пользоваться."))
        self._show_server_report(title, "\n".join(lines))

    def _show_server_report(self, title, text):
        def show():
            try:
                fragment = get_last_fragment()
                activity = fragment.getParentActivity() if fragment else None
                if activity is None:
                    self._bulletin("info", title)
                    return
                builder = AlertDialogBuilder(activity)
                builder.set_title(title)
                builder.set_message(text)
                builder.set_positive_button(_t("Закрыть"), lambda bld, _which: bld.dismiss())
                builder.show()
            except Exception:
                self._debug_exception("Server report error")

        run_on_ui_thread(show)

    # ------------------------------------------------------------------ updates
    def _check_updates(self, manual=False):
        def worker():
            info = None
            try:
                info = self._fetch_release_info()
            except Exception:
                self._debug("Update check failed: " + traceback.format_exc().splitlines()[-1])
            if not info:
                if manual:
                    self._bulletin("error", _t("Не удалось проверить обновления."))
                return
            latest = info.get("plugin_version") or ""
            if _version_tuple(latest) > _version_tuple(__version__):
                if manual or latest not in self._update_prompted:
                    self._update_prompted.add(latest)
                    self._show_update_dialog(info)
            elif manual:
                self._bulletin("success", _t("У тебя последняя версия (%s).") % __version__)

        threading.Thread(target=worker, name="telegram-jam-update", daemon=True).start()

    def _fetch_release_info(self):
        if UPDATE_INFO_URL:
            data = self._http_json(UPDATE_INFO_URL)
            if isinstance(data, dict) and data.get("plugin_version"):
                return data
        release = self._http_json(GITHUB_RELEASE_API)
        return _parse_release(release) if isinstance(release, dict) else None

    def _http_json(self, url):
        request = urllib.request.Request(url, headers={
            "Accept": "application/json",
            "User-Agent": "telegram-jam-plugin/%s" % __version__,
        })
        with urllib.request.urlopen(request, timeout=10) as response:
            return json.loads(response.read(512 * 1024).decode("utf-8"))

    def _show_update_dialog(self, info):
        details = _t("Твоя версия: %s\nНовая версия: %s\nСервер (релиз): %s") % (
            __version__, info.get("plugin_version") or "?", info.get("server_version") or "?",
        )
        url = info.get("plugin_url") or info.get("release_url") or CHANNEL_URL

        def show():
            try:
                fragment = get_last_fragment()
                activity = fragment.getParentActivity() if fragment else None
                if activity is None:
                    self._bulletin("info", _t("Вышла новая версия плагина."))
                    return
                builder = AlertDialogBuilder(activity)
                builder.set_title(_t("Обновление Jam"))
                builder.set_message(_t("Вышла новая версия плагина.") + "\n\n" + details)
                builder.set_positive_button(_t("Обновить"), lambda bld, _which: self._open_url(bld, url))
                builder.set_neutral_button(_t("Канал"), lambda bld, _which: self._open_url(bld, CHANNEL_URL))
                builder.set_negative_button(_t("Закрыть"), lambda bld, _which: bld.dismiss())
                builder.show()
            except Exception:
                self._debug_exception("Update dialog error")

        run_on_ui_thread(show)

    def _show_server_refusal(self, message):
        details = _t("Твоя версия: %s\nСервер: %s\nСервер принимает плагин от версии: %s") % (
            __version__, message.get("server_version") or "?", message.get("min_plugin_version") or "?",
        )
        url = message.get("update_url") or CHANNEL_URL
        if not (url.startswith("https://") or url.startswith("http://") or url.startswith("tg://")):
            url = CHANNEL_URL

        def show():
            try:
                fragment = get_last_fragment()
                activity = fragment.getParentActivity() if fragment else None
                headline = _t("Плагин устарел для этого Jam-сервера. Обнови его, чтобы создавать и принимать Jam.")
                if activity is None:
                    self._bulletin("error", headline)
                    return
                builder = AlertDialogBuilder(activity)
                builder.set_title(_t("Обновление Jam"))
                builder.set_message(headline + "\n\n" + details)
                builder.set_positive_button(_t("Обновить"), lambda bld, _which: self._open_url(bld, url))
                builder.set_negative_button(_t("Закрыть"), lambda bld, _which: bld.dismiss())
                builder.show()
            except Exception:
                self._debug_exception("Refusal dialog error")

        run_on_ui_thread(show)

    def _open_url(self, builder, url):
        try:
            if builder is not None:
                builder.dismiss()
        except Exception as exc:
            _swallow("_open_url", exc)
        try:
            fragment = get_last_fragment()
            context = fragment.getParentActivity() if fragment else ApplicationLoader.applicationContext
            Browser.openUrl(context, url)
        except Exception:
            self._debug_exception("Open url error")

    # ------------------------------------------------------------------ invite codes
    # Invite code layout (base64url, no padding):
    #   header(1) | sizes(1) | room_code | ticket | xor(server address) | tag(2)
    # header: 0x90 marker (v2), 0x40 plain ws://, 0x20 default /jam path.
    # sizes: room_code length << 4 | ticket length. The ticket is single-use and
    # expires after 5 minutes; the room code and server stay the same for the lobby.
    def _invite_keystream(self, seed, length):
        out = b""
        counter = 0
        while len(out) < length:
            out += hashlib.sha256(b"telegram-jam:" + seed + bytes([counter])).digest()
            counter += 1
        return out[:length]

    def _invite_tag(self, head, address):
        return hashlib.sha256(b"telegram-jam-tag:" + head + address).digest()[:2]

    def _b64decode(self, value):
        return base64.urlsafe_b64decode(value + "=" * (-len(value) % 4))

    def _b64encode(self, value):
        return base64.urlsafe_b64encode(value).decode("ascii").rstrip("=")

    def _encode_invite(self, server_url, room_code, ticket):
        room_bytes = self._b64decode(room_code)
        ticket_bytes = self._b64decode(ticket)
        if not (0 < len(room_bytes) < 16 and 0 < len(ticket_bytes) < 16):
            raise ValueError("unexpected invite sizes")
        plain_ws = server_url.startswith("ws://")
        rest = server_url.split("://", 1)[1]
        default_path = rest.endswith(DEFAULT_SERVER_PATH) and "/" not in rest[: -len(DEFAULT_SERVER_PATH)]
        if default_path:
            rest = rest[: -len(DEFAULT_SERVER_PATH)]
        address = rest.encode("utf-8")
        header = bytes([INVITE_MARK | (0x40 if plain_ws else 0) | (0x20 if default_path else 0)])
        head = header + bytes([(len(room_bytes) << 4) | len(ticket_bytes)]) + room_bytes + ticket_bytes
        stream = self._invite_keystream(room_bytes + ticket_bytes, len(address))
        hidden = bytes(a ^ b for a, b in zip(address, stream))
        return self._b64encode(head + hidden + self._invite_tag(head, address))

    def _decode_invite(self, code):
        try:
            payload = self._b64decode(code)
            if len(payload) < 6 or payload[0] & INVITE_MARK != INVITE_MARK:
                return None
            room_size, ticket_size = payload[1] >> 4, payload[1] & 0x0F
            end = 2 + room_size + ticket_size
            head = payload[:end]
            room_bytes = payload[2:2 + room_size]
            ticket_bytes = payload[2 + room_size:end]
            hidden = payload[end:-2]
            if not room_size or not ticket_size or not hidden or len(ticket_bytes) != ticket_size:
                return None
            address = bytes(a ^ b for a, b in zip(hidden, self._invite_keystream(room_bytes + ticket_bytes, len(hidden))))
            if self._invite_tag(head, address) != payload[-2:]:
                return None
            server_url = ("ws://" if payload[0] & 0x40 else "wss://") + address.decode("utf-8")
            if payload[0] & 0x20:
                server_url += DEFAULT_SERVER_PATH
            if not self._valid_server_url(server_url):
                return None
            return server_url, self._b64encode(room_bytes), self._b64encode(ticket_bytes)
        except Exception:
            return None

    # ------------------------------------------------------------------ misc
    def _debug(self, message):
        timestamp = time.strftime("%H:%M:%S", time.localtime())
        entry = "%s  %s" % (timestamp, message)
        entries = getattr(self, "_debug_entries", None)
        if entries is not None:
            entries.append(entry)
            del entries[:-80]
        try:
            logger = getattr(self, "logger", None)
            if logger is not None:
                logger.info(entry)
            else:
                self.log("[telegram_jam] " + entry)
        except Exception:
            pass

    def _debug_exception(self, title):
        trace = traceback.format_exc().strip().splitlines()
        self._debug(title)
        for line in trace[-8:]:
            self._debug("  " + line)
    def _safe_setup(self, name, callback):
        try:
            callback()
            self._debug("Setup OK: " + name)
        except Exception:
            self._debug_exception("Setup failed: " + name)
    def _copy_diagnostics(self):
        entries = getattr(self, "_debug_entries", [])
        copy_to_clipboard("Telegram Jam diagnostics\n" + "\n".join(entries))
    def _clear_diagnostics(self):
        self._debug_entries = []
        self._bulletin("success", _t("Журнал Jam очищен."))
    def _send_text(self, account, dialog_id, text, entities=None, cleanup_after_jam=False):
        if cleanup_after_jam:
            self._cleanup_texts.add(text)
        def send():
            try:
                params = SendMessagesHelper.SendMessageParams()
                params.peer = int(dialog_id)
                params.message = text
                if entities:
                    params.entities = entities
                SendMessagesHelper.getInstance(account).sendMessage(params)
            except Exception:
                self.log("[telegram_jam] send text error: " + traceback.format_exc())

        run_on_ui_thread(send)
    def _server_label(self, server_url):
        try:
            return server_url.split("://", 1)[1].split("/", 1)[0]
        except Exception as exc:
            _swallow("_server_label", exc)
            return ""
    def _prefix(self):
        return (self.get_setting("prefix", DEFAULT_PREFIX) or DEFAULT_PREFIX).strip() or DEFAULT_PREFIX
    def _control_mode(self):
        return "both" if self.get_setting("control_mode", 0) == 1 else "leader"
    def _server_url(self):
        value = (self.get_setting("server_url", DEFAULT_SERVER_URL) or DEFAULT_SERVER_URL).strip()
        return value if self._valid_server_url(value) else ""
    def _valid_server_url(self, value):
        return isinstance(value, str) and (value.startswith("wss://") or value.startswith("ws://")) and "/" in value[5:]
    def _peer_dialog_id(self, params):
        try:
            return int(params.peer)
        except Exception as exc:
            _swallow("_peer_dialog_id", exc)
            return None
    def _is_private_dialog(self, dialog_id):
        return dialog_id is not None and dialog_id > 0
    def _display_name(self, account):
        try:
            user = UserConfig.getInstance(account).getCurrentUser()
            if user:
                parts = [part for part in (user.first_name, user.last_name) if part]
                if parts:
                    return " ".join(parts)
        except Exception as exc:
            _swallow("_display_name", exc)
        return _t("Пользователь")
    def _bulletin(self, kind, text):
        try:
            fragment = get_last_fragment()
            if kind == "error":
                BulletinHelper.show_error(text, fragment)
            elif kind == "success":
                BulletinHelper.show_success(text, fragment)
            else:
                BulletinHelper.show_info(text, fragment)
        except Exception:
            self.log("[telegram_jam] bulletin error: " + traceback.format_exc())
