# Errors that are safe to ignore are still written to the diagnostics log,
# once per place, so a silent failure can be found from "Copy log".
_LOG_SINK = [None]
_SWALLOWED = set()


def _swallow(where, exc=None):
    try:
        if where in _SWALLOWED:
            return
        _SWALLOWED.add(where)
        sink = _LOG_SINK[0]
        if sink is not None:
            sink("Ignored error in %s: %s: %s" % (where, type(exc).__name__, exc))
    except Exception:
        pass

