__id__ = "ser"
__name__ = "Screenshot Export Remove"
__description__ = "Убирает экспорт сообщений по скриншоту\nRemoves message export from screenshots"
__author__ = "@ka1Plugins"
__version__ = "1.0"
__icon__ = "ka1Plugins/9"
__app_version__ = ">=13.2.2"
__sdk_version__ = ">=1.4.6.5"

from base_plugin import BasePlugin, MethodReplacement
from dalvik.system import DexFile
from org.telegram.messenger import ApplicationLoader
from android_utils import log
from java.lang import Class
from java.lang.reflect import Modifier


class SmartReplacement(MethodReplacement):
    def __init__(self, ret_type):
        self.ret_type = str(ret_type)

    def replace_hooked_method(self, param):
        if self.ret_type == "void":
            return None
        elif self.ret_type == "boolean":
            return False
        elif self.ret_type in ("int", "long", "short", "byte", "char"):
            return 0
        elif self.ret_type in ("float", "double"):
            return 0.0
        return None


class ScreenshotCustomizeRemovePlugin(BasePlugin):

    def on_plugin_load(self):
        target_pkg = "com.exteragram.messenger.messageexport"
        target_classes = set()
        
        try:
            dex_path = ApplicationLoader.applicationContext.getPackageCodePath()
            dex = DexFile(dex_path)
            entries = dex.entries()
            while entries.hasMoreElements():
                name = entries.nextElement()
                if name == target_pkg or name.startswith(target_pkg + "."):
                    target_classes.add(name)
            dex.close()
        except Exception as e:
            log(f"Dex scan error: {e}")
            
        target_classes.add("com.exteragram.messenger.messageexport.ChatScreenshotExportBridge")
        target_classes.add("com.exteragram.messenger.messageexport.ChatScreenshotExportBridge$Api34")
        target_classes.add("com.exteragram.messenger.messageexport.MessageExport")
        
        log(f"Found {len(target_classes)} classes to block in {target_pkg}")
        
        for cls_name in target_classes:
            try:
                cls = Class.forName(cls_name)
                
                for ctor in cls.getDeclaredConstructors():
                    if Modifier.isAbstract(ctor.getModifiers()):
                        continue
                    ctor.setAccessible(True)
                    self.hook_method(ctor, SmartReplacement("void"))
                    
                for method in cls.getDeclaredMethods():
                    mods = method.getModifiers()
                    if Modifier.isAbstract(mods) or Modifier.isNative(mods):
                        continue
                    method.setAccessible(True)
                    ret_type = method.getReturnType()
                    self.hook_method(method, SmartReplacement(ret_type))
                    
                log(f"Blocked class: {cls_name}")
            except Exception as e:
                log(f"Failed to hook class {cls_name}: {e}")