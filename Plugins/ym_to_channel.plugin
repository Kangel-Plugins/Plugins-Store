def _lang_code():
    try:
        loc = LocaleController.getInstance().getCurrentLocale()
        code = str(loc.getLanguage() or "") if loc is not None else ""
        if code:
            return code
    except Exception:
        _dexc("_lang_code:L95")
        pass
    try:
        return str(Locale.getDefault().getLanguage() or "")
    except Exception:
        _dexc("_lang_code:L100")
        return ""
def is_ru():
    """Russian UI when the Telegram language (or, failing that, the phone language) is Russian-like, English otherwise."""
    now = time.time()
    if _LANG["ru"] is None or now - _LANG["ts"] > 5.0:
        _LANG["ru"] = _lang_code().lower().replace("-", "_").split("_")[0] in _RU_LANGS
        _LANG["ts"] = now
    return _LANG["ru"]
def L(ru, en):
    return ru if is_ru() else en
def svc_name(svc):
    if svc == "ym":
        return L("Яндекс Музыка", "Yandex Music")
    return dict(SERVICES)[svc]
def sources():
    return [L("Яндекс Музыка", "Yandex Music"), "SoundCloud", L("Сначала Яндекс, потом SoundCloud", "Yandex first, then SoundCloud")]
# ---- logging (rewritten) ----
_LOG_RING = []
_DEBUG = {"on": False, "max": 300, "max_off": 300, "path": None, "t_persist": 0.0, "plugin": None, "keys": ['debug', 'sc_links', 'sc_pause', 'service', 'sp_client_id', 'sp_client_secret', 'sp_fallback', 'sp_links', 'sp_pause', 'sp_quality', 'sp_source', 'ym_likes', 'ym_pause', 'ym_quality', 'ym_token', 'yt_fallback', 'yt_links', 'yt_pause', 'yt_quality', 'yt_source']}
_SECRET_RE = re.compile(r"(OAuth\s+|Bearer\s+|token=|access_token=|client_id=|client_secret=)[^&\s'\")]+", re.I)
def scrub(text):
    return _SECRET_RE.sub(lambda m: m.group(1) + "***", str(text))
def _dbg_ts():
    t = time.time()
    return "%s.%03d %-12s" % (time.strftime("%H:%M:%S", time.localtime(t)), int((t % 1) * 1000), threading.current_thread().name[:12])
def ylog(msg, debug=False):
    if debug and not _DEBUG["on"]:
        return
    text = scrub(msg)
    _LOG_RING.append(_dbg_ts() + " " + text)
    del _LOG_RING[:-_DEBUG["max"]]
    try:
        _sdk_log("[MP port] " + text)
    except Exception:
        pass
def ylog_exc(where):
    ylog(where + ": " + traceback.format_exc().strip().splitlines()[-1])
    ylog(traceback.format_exc(), debug=True)
    _derr(where)
def _dlog(msg):
    ylog(msg, debug=True)
def _dinfo(msg):
    ylog(msg)
def _dbg_ring():
    return list(_LOG_RING)
def _dbg_header():
    out = ["MP port %s" % __version__, "verbose: %s, uptime %ds" % ("ON" if _DEBUG["on"] else "off", time.time() - _DBG_T0)]
    out += _dbg_env()
    p = _DEBUG.get("plugin")
    if p is None:
        return out
    def part(label, fn):
        try:
            out.append("%s: %s" % (label, fn()))
        except Exception as e:
            out.append("%s: <%s>" % (label, _tn(e)))
    part("services", lambda: ", ".join(p._enabled()))
    part("channel", lambda: (p.state.data.get("channel") or {}).get("title"))
    part("state", lambda: "sent=%d failed=%d pending=%d" % (len(p.state.data["sent"]), len(p.state.data["failed"]), len(p.state.data["pending"])))
    part("run", lambda: "alive=%s status=%s" % (p.worker is not None and p.worker.is_alive(), p.status))
    part("soundcloud client_id", lambda: "cached" if p.state.data.get("sc_cid") else "none")
    part("failed, last 10", lambda: list(p.state.data.get("failed", {}).items())[-10:])
    return out

# ======================= debug toolkit (added) =======================
# Always on (cheap): error ring with full tracebacks, counters of swallowed exceptions, per-session log file.
# Only with "verbose log" switched on: method tracing, hook / task / network traces, slow-call detection.
_DBG_LOCK = threading.Lock()
_PERSIST_LOCK = threading.Lock()
_DBG_ERRS = {}      # "place | last line" -> [count, first time, last time, traceback]
_DBG_SILENT = {}    # place -> [count, last exception text]
_DBG_SAMPLE = {}    # key -> [window start, calls, not logged]
_DBG_BUCKET = [40.0, 0.0]
_DBG_T0 = time.time()
_DBG_STATS = {}     # label -> [calls, total ms, max ms], filled only while verbose log is on
_SECRETISH = ("key", "secret", "token", "session")
_TOKENISH = re.compile(r"[A-Za-z0-9_\-+=]{20,}")


def _tn(v):
    """Short type name, e.g. ValueError or ArrayList."""
    try:
        return str(type(v)).split("'")[1].rsplit(".", 1)[-1]
    except Exception:
        return "?"


def _dsafe(v, n=60):
    """Short, side-effect free description of a value (never calls repr() on foreign objects)."""
    try:
        if v is None or isinstance(v, (bool, int, float)):
            s = repr(v)
        elif isinstance(v, str):
            # token-like strings (hex / encoded keys) are never shown, only their length
            s = "<str %d>" % len(v) if _TOKENISH.fullmatch(v) else repr(v)
        elif isinstance(v, (list, tuple, set, frozenset, dict)):
            s = "%s[%d]" % (_tn(v), len(v))
        else:
            s = "<%s>" % _tn(v)
        return s if len(s) <= n else s[:n - 1] + "~"
    except Exception:
        return "<?>"


def _dargs(args, kw):
    parts = [_dsafe(a) for a in args[:6]] + ["%s=%s" % (k, _dsafe(v)) for k, v in list(kw.items())[:4]]
    if len(args) > 6:
        parts.append("+%d" % (len(args) - 6))
    return ", ".join(parts)


def _dsample(key, limit=5, window=5.0):
    """True while `key` has logged fewer than `limit` lines in the current `window` seconds; the rest is only counted."""
    now = time.time()
    carry = 0
    with _DBG_LOCK:
        s = _DBG_SAMPLE.get(key)
        if s is None or now - s[0] >= window:
            carry = s[2] if s else 0
            s = _DBG_SAMPLE[key] = [now, 0, 0]
        s[1] += 1
        ok = s[1] <= limit
        if not ok:
            s[2] += 1
    if carry:
        _dlog("%s: +%d calls not logged (sampling)" % (key, carry))
    return ok


def _dbudget():
    """Global cap for trace lines (about 25 per second, bursts up to 40), so tracing cannot flood the log."""
    now = time.time()
    with _DBG_LOCK:
        b = _DBG_BUCKET
        b[0] = min(40.0, b[0] + (now - b[1]) * 25.0) if b[1] else 40.0
        b[1] = now
        if b[0] >= 1.0:
            b[0] -= 1.0
            return True
    return False


def _derr(where):
    """Remembers the exception being handled with its full traceback (always, independent of the verbose switch)."""
    try:
        tb = traceback.format_exc().strip()
        last = tb.splitlines()[-1] if tb else ""
        k = "%s | %s" % (where, last[:140])
        now = time.strftime("%H:%M:%S")
        with _DBG_LOCK:
            rec = _DBG_ERRS.get(k)
            if rec is None:
                if len(_DBG_ERRS) >= 40:
                    _DBG_ERRS.pop(next(iter(_DBG_ERRS)))
                rec = _DBG_ERRS[k] = [0, now, now, tb]
            rec[0] += 1
            rec[2] = now
        _persist()
    except Exception:
        pass


def _dexc(where):
    """Called from an `except` block that swallows an exception: counts it per place and logs the first ones."""
    try:
        with _DBG_LOCK:
            rec = _DBG_SILENT.get(where)
            if rec is None:
                rec = _DBG_SILENT[where] = [0, ""]
            rec[0] += 1
            n = rec[0]
        if n <= 3 or _DEBUG["on"]:
            rec[1] = traceback.format_exc().strip().splitlines()[-1][:200]
        if _DEBUG["on"] and (n <= 3 or n % 200 == 0):
            _dlog("swallowed at %s (#%d) %s" % (where, n, rec[1]))
    except Exception:
        pass


def _trace(fn, label, light, method):
    """Wraps a method: with verbose log on, logs call, result, time and exceptions. `light` = per-frame code:
    only exceptions and slow calls are logged."""
    import functools

    @functools.wraps(fn)
    def w(*a, **kw):
        if not _DEBUG["on"]:
            return fn(*a, **kw)
        full = (not light) and _dsample(label) and _dbudget()
        if full:
            _dlog("-> %s(%s)" % (label, _dargs(a[1:] if method else a, kw)))
        t0 = time.time()
        try:
            r = fn(*a, **kw)
        except BaseException as e:
            if _dsample(label + " !", 5, 30.0):
                _dlog("!! %s raised %s: %s" % (label, _tn(e), str(e)[:160]))
            raise
        dt = (time.time() - t0) * 1000.0
        st = _DBG_STATS.get(label)
        if st is None:
            st = _DBG_STATS[label] = [0, 0.0, 0.0]
        st[0] += 1
        st[1] += dt
        if dt > st[2]:
            st[2] = dt
        if full:
            _dlog("<- %s = %s  %.0fms" % (label, _dsafe(r), dt))
        if dt >= (80.0 if light else 400.0) and _dsample(label + " slow", 3, 30.0):
            _dlog("SLOW %s %.0fms" % (label, dt))
        return r
    return w


def _t(label, light=False, method=True):
    """Decorator for a method; with verbose log on it traces the call (see _trace)."""
    def deco(fn):
        return _trace(fn, label, light, method)
    return deco


class _DThread(threading.Thread):
    """Thread that records start, end and uncaught exceptions."""

    def run(self):
        _dlog("thread start: %s" % self.name)
        try:
            threading.Thread.run(self)
        except BaseException:
            _derr("thread " + str(self.name))
            _dinfo("thread %s died: %s" % (self.name, traceback.format_exc().strip().splitlines()[-1]))
            raise
        finally:
            _dlog("thread end: %s" % self.name)


def _dbg_env():
    out = []
    try:
        from java import jclass
        b = jclass("android.os.Build")
        v = jclass("android.os.Build$VERSION")
        out.append("device: %s %s, Android %s (API %s)" % (b.MANUFACTURER, b.MODEL, v.RELEASE, v.SDK_INT))
    except Exception as e:
        out.append("device: unknown (%s)" % _tn(e))
    try:
        from java import jclass
        bv = jclass("org.telegram.messenger.BuildVars")
        out.append("app: %s (%s)" % (bv.BUILD_VERSION_STRING, bv.BUILD_VERSION))
    except Exception as e:
        out.append("app: unknown (%s)" % _tn(e))
    try:
        from java import jclass
        out.append("locale: %s" % jclass("java.util.Locale").getDefault().toString())
    except Exception:
        pass
    return out


def _dbg_settings():
    p = _DEBUG.get("plugin")
    out = []
    if p is None:
        return out
    for k in _DEBUG["keys"]:
        try:
            v = p.get_setting(k, None)
        except Exception as e:
            v = "<%s>" % _tn(e)
        if any(s in k.lower() for s in _SECRETISH):
            v = "set" if v else "empty"
        out.append("%s=%s" % (k, _dsafe(v, 40)))
    return [", ".join(out[i:i + 5]) for i in range(0, len(out), 5)]


def _dbg_digest(top=8):
    """A few lines for the on-screen diagnostics: most frequent errors and swallowed exceptions."""
    with _DBG_LOCK:
        errs = sorted(_DBG_ERRS.items(), key=lambda kv: -kv[1][0])[:top]
        sil = sorted(_DBG_SILENT.items(), key=lambda kv: -kv[1][0])[:top]
    lines = []
    if errs:
        lines.append("Errors:")
        lines += ["  x%d %s" % (r[0], k) for k, r in errs]
    if sil:
        lines.append("Swallowed exceptions:")
        lines += ["  x%d %s - %s" % (r[0], k, r[1]) for k, r in sil]
    return lines


def _dbg_dump():
    out = ["== header =="]
    try:
        out += _dbg_header()
    except Exception as e:
        out.append("header failed: %r" % (e,))
    out.append("settings:")
    try:
        out += ["  " + l for l in _dbg_settings()]
    except Exception as e:
        out.append("  failed: %r" % (e,))
    with _DBG_LOCK:
        errs = list(_DBG_ERRS.items())
        sil = sorted(_DBG_SILENT.items(), key=lambda kv: -kv[1][0])[:40]
    out += ["", "== errors, always recorded (%d kinds) ==" % len(errs)]
    for k, r in errs:
        out.append("[x%d %s..%s] %s" % (r[0], r[1], r[2], k))
        out.append(r[3])
    out += ["", "== swallowed exceptions: count, place, last =="]
    out += ["x%d  %s  %s" % (r[0], k, r[1]) for k, r in sil]
    out += ["", "== hot spots (verbose only): total ms, calls, avg ms, max ms, method =="] + _dbg_hotspots()
    out += ["", "== log, verbose %s ==" % ("ON" if _DEBUG["on"] else "off")] + _dbg_ring()
    return "\n".join(out)


def _dbg_hotspots(top=25):
    rows = sorted(list(_DBG_STATS.items()), key=lambda kv: -kv[1][1])[:top]
    return ["%9.0f  %7d  %7.3f  %7.1f  %s" % (r[1], r[0], r[1] / max(1, r[0]), r[2], k) for k, r in rows]


def _dbg_prev(n=150):
    p = _DEBUG.get("path")
    try:
        with open(str(p) + ".prev", encoding="utf-8", errors="replace") as f:
            return f.read().splitlines()[-n:]
    except Exception:
        return []


def _dbg_report():
    """Everything for a bug report: this session plus the tail of the previous one (what happened before a crash)."""
    prev = _dbg_prev()
    text = _dbg_dump()
    if prev:
        text += "\n\n== previous session, tail ==\n" + "\n".join(prev)
    return text


def _persist(force=False):
    """Writes the session log to disk (at most every 5 s), so it survives a crash or a restart."""
    p = _DEBUG.get("path")
    now = time.time()
    if not p or (not force and now - _DEBUG["t_persist"] < 5.0):
        return
    if not _PERSIST_LOCK.acquire(False):
        return
    try:
        _DEBUG["t_persist"] = now
        with open(p, "w", encoding="utf-8") as f:
            f.write(_dbg_dump())
    except Exception:
        pass
    finally:
        _PERSIST_LOCK.release()


def _dbg_start(path, plugin):
    """Opens a debug session: keeps the previous session's file as .prev and records the environment."""
    try:
        _DEBUG["plugin"] = plugin
        _DEBUG["path"] = path
        _DEBUG["t_persist"] = 0.0
        if os.path.exists(path):
            os.replace(path, path + ".prev")
    except Exception:
        _dexc("_dbg_start")
    _dinfo("session start, version %s" % __version__)
    for line in _dbg_env():
        _dinfo(line)


def _dbg_stop():
    _dinfo("session end")
    _persist(True)
    _DEBUG["plugin"] = None


def _dbg_set_debug(on):
    on = bool(on)
    _DEBUG["on"] = on
    _DEBUG["max"] = 3000 if on else _DEBUG["max_off"]
    _dinfo("verbose log %s" % ("ON" if on else "off"))
    if on:
        _persist(True)
# ===================== end of debug toolkit =====================

def ui(fn, delay=0):
    def _wrapped():
        try:
            fn()
        except Exception:
            ylog_exc("ui")
    if delay:
        run_on_ui_thread(_wrapped, delay)
    else:
        run_on_ui_thread(_wrapped)
def _toast(kind, text):
    text = scrub(text)
    def _show():
        try:
            getattr(BulletinHelper, kind)(text)
        except Exception:
            _dexc("_toast._show:L503")
            pass
    ui(_show)
def toast_info(text):
    _toast("show_info", text)
def toast_ok(text):
    _toast("show_success", text)
def toast_err(text):
    _toast("show_error", text)
def ctx_get(ctx, key):
    if ctx is None:
        return None
    try:
        return ctx.get(key)
    except Exception:
        _dexc("ctx_get:L518")
        pass
    try:
        return ctx[key]
    except Exception:
        _dexc("ctx_get:L523")
        return None
def safe_name(s):
    s = re.sub(r'[\\/:*?"<>|\x00-\x1f]', "_", s or "").strip()
    return s[:120] or "track"
class JsonFile:
    @_t("JsonFile.__init__")
    def __init__(self, path, default):
        self.path = path
        self.data = default
        self.lock = threading.RLock()
    @_t("JsonFile.load")
    def load(self):
        with self.lock:
            try:
                if os.path.exists(self.path):
                    with open(self.path, "r", encoding="utf-8") as f:
                        d = json.load(f)
                    if isinstance(d, dict):
                        self.data.update(d)
            except Exception:
                ylog_exc("load state")
        return self
    @_t("JsonFile.save")
    def save(self):
        with self.lock:
            try:
                tmp = self.path + ".tmp"
                with open(tmp, "w", encoding="utf-8") as f:
                    json.dump(self.data, f, ensure_ascii=False, separators=(",", ":"))
                os.replace(tmp, self.path)
            except Exception:
                ylog_exc("save state")
class MpError(Exception):
    pass
class YmError(MpError):
    pass


# ---------------------------------------------------------------- helpers
def find_all(o, key):
    """Every value stored under `key` anywhere in a JSON structure, in document order."""
    if isinstance(o, dict):
        for k, v in o.items():
            if k == key:
                yield v
            else:
                yield from find_all(v, key)
    elif isinstance(o, list):
        for x in o:
            yield from find_all(x, key)
def find_first(o, key):
    return next(find_all(o, key), None)
def runs_text(node):
    if not isinstance(node, dict):
        return ""
    if "simpleText" in node:
        return str(node["simpleText"])
    return "".join(str(r.get("text", "")) for r in node.get("runs") or [])
def parse_dur(text):
    parts = [int(x) for x in re.findall(r"\d+", text or "")]
    sec = 0
    for p in parts:
        sec = sec * 60 + p
    return float(sec)
def norm(s):
    s = (s or "").lower().replace("ё", "е")
    s = re.sub(r"\(.*?\)|\[.*?\]", " ", s)
    s = re.sub(r"\b(feat|ft|featuring|prod|remaster(ed)?|official|video|audio|lyrics?|radio edit)\b.*$", " ", s)
    s = re.sub(r"[^\w\s]", " ", s)
    return " ".join(s.split())
def similar(a, b):
    a, b = norm(a), norm(b)
    if not a or not b:
        return 0.0
    if a == b:
        return 1.0
    return difflib.SequenceMatcher(None, a, b).ratio()
def split_artists(s):
    return [x.strip() for x in re.split(r",|&|;|\bfeat\.?\b|\bft\.?\b|\bx\b", s or "", flags=re.I) if x.strip()]
def match_score(want, title, artists, dur):
    """0..1 how sure we are that a candidate is the wanted track; 0 means a definite no."""
    wd = float(want.get("dur") or 0)
    if wd and dur and abs(wd - float(dur)) > DUR_TOL:
        return 0.0
    wt, ct = norm(want.get("title")), norm(title)
    ts = similar(want.get("title"), title)
    if wt and re.search(r"\b%s\b" % re.escape(wt), ct):
        ts = max(ts, 0.9)
    blob = norm("%s %s" % (artists, title))
    wa = [norm(x) for x in split_artists(want.get("artists")) if norm(x)]
    if not wa or any(x in blob for x in wa):
        ar = 1.0
    else:
        ar = max(similar(x, artists) for x in wa)
    if ts < 0.75 or ar < 0.5:
        return 0.0
    return 0.65 * ts + 0.35 * ar
def mk(svc, tid, title, artists, album="", dur=0.0, cover=None, **extra):
    d = {"key": "%s:%s" % (svc, tid), "svc": svc, "id": str(tid), "title": title or L("Без названия", 'Untitled'),
         "artists": artists or "Unknown", "album": album or "", "dur": float(dur or 0), "cover": cover}
    d.update(extra)
    return d
def split_links(text):
    return re.findall(r"https?://[^\s,;]+|spotify:playlist:[A-Za-z0-9]+", text or "")


# ---------------------------------------------------------------- network
class Net:
    """requests.Session that logs every call (without secrets) and its timing."""
    @_t("Net.__init__")
    def __init__(self, name, headers=None, ua=None):
        import requests
        self.name = name
        self.s = requests.Session()
        self.s.headers.update({"User-Agent": ua or BROWSER_UA, "Accept-Language": "en-US,en;q=0.8"})
        if headers:
            self.s.headers.update(headers)
    @_t("Net.req")
    def req(self, method, url, **kw):
        kw.setdefault("timeout", (8, 30))
        t0 = time.time()
        ylog("net %s %s %s" % (self.name, method, str(url)[:150]), debug=True)
        try:
            r = self.s.request(method, url, **kw)
        except Exception as e:
            ylog("net %s failed after %.0fms: %s" % (self.name, (time.time() - t0) * 1000.0, e))
            raise
        ylog("net %s -> HTTP %s, %s bytes, %.0fms" % (self.name, r.status_code, r.headers.get("Content-Length", "?"),
                                                    (time.time() - t0) * 1000.0), debug=True)
        if r.status_code >= 400:
            ylog("net %s: HTTP %s from %s" % (self.name, r.status_code, str(url)[:100]))
        return r
    @_t("Net.get")
    def get(self, url, **kw):
        return self.req("GET", url, **kw)
    @_t("Net.post")
    def post(self, url, **kw):
        return self.req("POST", url, **kw)
def download(net, url, dest, **kw):
    tmp = dest + ".part"
    with net.req("GET", url, stream=True, timeout=(8, 60), **kw) as r:
        if r.status_code >= 400:
            raise MpError(L("файл HTTP %d", 'file HTTP %d') % r.status_code)
        with open(tmp, "wb") as f:
            for chunk in r.iter_content(65536):
                if chunk:
                    f.write(chunk)
    os.replace(tmp, dest)
def download_hls(net, url, dest):
    r = net.get(url)
    if r.status_code >= 400:
        raise MpError("HLS HTTP %d" % r.status_code)
    segs = [urlparse.urljoin(url, l.strip()) for l in r.text.splitlines() if l.strip() and not l.startswith("#")]
    if not segs:
        raise MpError(L("пустой HLS-плейлист", 'empty HLS playlist'))
    tmp = dest + ".part"
    with open(tmp, "wb") as f:
        for i, u in enumerate(segs):
            rr = net.get(u, timeout=(8, 60))
            if rr.status_code >= 400:
                raise MpError(L("сегмент %d HTTP %d", 'segment %d HTTP %d') % (i, rr.status_code))
            f.write(rr.content)
    os.replace(tmp, dest)


# ---------------------------------------------------------------- Yandex Music
class YandexMusic:
    @_t("YandexMusic.__init__")
    def __init__(self, token):
        import requests
        self.s = requests.Session()
        self.s.headers.update(YM_HEADERS)
        self.s.headers["Authorization"] = "OAuth " + token
        self.uid = None
        self.login = None
    @_t("YandexMusic._call")
    def _call(self, method, path, **kw):
        kw.setdefault("timeout", (8, 30))
        t0 = time.time()
        ylog("net yandex %s %s" % (method, path[:100]), debug=True)
        r = self.s.request(method, API + path, **kw)
        ylog("net yandex -> HTTP %s, %.0fms" % (r.status_code, (time.time() - t0) * 1000.0), debug=True)
        if r.status_code in (401, 403):
            raise YmError(L("токен не подходит или истёк (HTTP %d)", 'the token is wrong or expired (HTTP %d)') % r.status_code)
        if r.status_code >= 400:
            raise YmError(L("Яндекс ответил HTTP %d", 'Yandex answered HTTP %d') % r.status_code)
        j = r.json()
        if isinstance(j, dict) and j.get("error"):
            raise YmError(str(j.get("error")))
        return j.get("result") if isinstance(j, dict) else j
    @_t("YandexMusic.account")
    def account(self):
        res = self._call("GET", "/account/status") or {}
        acc = res.get("account") or {}
        self.uid = acc.get("uid")
        self.login = acc.get("login") or acc.get("displayName") or str(self.uid)
        if not self.uid:
            raise YmError(L("не удалось узнать аккаунт", 'could not read the account'))
        plus = bool((res.get("plus") or {}).get("hasPlus"))
        return self.login, plus
    @_t("YandexMusic.liked_ids")
    def liked_ids(self):
        res = self._call("GET", "/users/%s/likes/tracks" % self.uid) or {}
        items = ((res.get("library") or {}).get("tracks")) or []
        return [str(t.get("id")).split(":")[0] for t in items if t.get("id")]
    @_t("YandexMusic.playlists")
    def playlists(self):
        res = self._call("GET", "/users/%s/playlists/list" % self.uid) or []
        return [{"kind": int(p.get("kind")), "title": p.get("title") or L("Без названия", 'Untitled'),
                 "count": int(p.get("trackCount") or 0)} for p in res if p.get("kind") is not None]
    @_t("YandexMusic.playlist_ids")
    def playlist_ids(self, kind):
        res = self._call("GET", "/users/%s/playlists/%s" % (self.uid, kind)) or {}
        out = []
        for t in res.get("tracks") or []:
            tid = t.get("id") or (t.get("track") or {}).get("id")
            if tid:
                out.append(str(tid).split(":")[0])
        return out
    @_t("YandexMusic.tracks")
    def tracks(self, ids):
        out = {}
        for i in range(0, len(ids), 100):
            chunk = ids[i:i + 100]
            res = self._call("POST", "/tracks", data={"track-ids": ",".join(chunk), "with-positions": "false"}) or []
            for t in res:
                out[str(t.get("id"))] = t
        return out
    @_t("YandexMusic.search")
    def search(self, text):
        res = self._call("GET", "/search", params={"text": text, "nocorrect": "false", "type": "track",
                                                   "page": 0, "playlist-in-path": "false"}) or {}
        return ((res.get("tracks") or {}).get("results")) or []
    @_t("YandexMusic.download_url")
    def download_url(self, tid, quality):
        infos = self._call("GET", "/tracks/%s/download-info" % tid) or []
        mp3 = [i for i in infos if i.get("codec") == "mp3" and i.get("downloadInfoUrl")]
        if not mp3:
            raise YmError(L("нет mp3 для скачивания", 'no mp3 to download'))
        rate = lambda i: int(i.get("bitrateInKbps") or 0)
        fit = [i for i in mp3 if rate(i) <= quality]
        best = max(fit, key=rate) if fit else min(mp3, key=rate)
        r = self.s.get(best["downloadInfoUrl"], timeout=(8, 30))
        if r.status_code >= 400:
            raise YmError("download-info HTTP %d" % r.status_code)
        xml = r.text
        def tag(name):
            m = re.search(r"<%s>([^<]*)</%s>" % (name, name), xml)
            if not m:
                raise YmError(L("download-info без поля ", 'download-info without field ') + name)
            return m.group(1)
        host, path, ts, s = tag("host"), tag("path"), tag("ts"), tag("s")
        sign = hashlib.md5((SIGN_SALT + path[1:] + s).encode("utf-8")).hexdigest()
        return "https://%s/get-mp3/%s/%s%s" % (host, sign, ts, path), int(best.get("bitrateInKbps") or 0)
    @_t("YandexMusic.fetch")
    def fetch(self, url, dest):
        tmp = dest + ".part"
        with self.s.get(url, stream=True, timeout=(8, 60)) as r:
            if r.status_code >= 400:
                raise YmError(L("файл HTTP %d", 'file HTTP %d') % r.status_code)
            with open(tmp, "wb") as f:
                for chunk in r.iter_content(65536):
                    if chunk:
                        f.write(chunk)
        os.replace(tmp, dest)
    @_t("YandexMusic.cover")
    def cover(self, track):
        uri = track.get("coverUri") or ((track.get("albums") or [{}])[0].get("coverUri"))
        if not uri:
            return None
        try:
            r = self.s.get("https://" + uri.replace("%%", "400x400"), timeout=(8, 20))
            if r.status_code < 400 and r.content:
                return r.content
        except Exception:
            ylog_exc("yandex cover")
        return None
def ym_names(tr):
    artists = ", ".join(a.get("name", "") for a in tr.get("artists") or [] if a.get("name")) or "Unknown"
    title = tr.get("title") or L("Без названия", 'Untitled')
    if tr.get("version"):
        title = "%s (%s)" % (title, tr["version"])
    album = ((tr.get("albums") or [{}])[0]).get("title") or ""
    return title, artists, album
def pick_ym(want, results):
    best, best_score = None, 0.0
    for tr in results[:10]:
        if tr.get("available") is False:
            continue
        title, artists, _ = ym_names(tr)
        sc = match_score(want, title, artists, float(tr.get("durationMs") or 0) / 1000.0)
        ylog("match yandex: %s - %s -> %.2f" % (artists[:40], title[:40], sc), debug=True)
        if sc > best_score:
            best, best_score = tr, sc
    return (best, best_score) if best_score >= MATCH_MIN else (None, best_score)


# ---------------------------------------------------------------- Spotify
class Spotify:
    @_t("Spotify.__init__")
    def __init__(self, cid="", secret=""):
        self.net = Net("spotify")
        self.cid = (cid or "").strip()
        self.secret = (secret or "").strip()
        self.token = None
    @staticmethod
    @_t("Spotify.parse", False, False)
    def parse(link):
        """(kind, id) of a Spotify link: playlist, album or track."""
        m = re.search(r"(playlist|album|track)[/:]([A-Za-z0-9]{22})", link or "")
        return (m.group(1), m.group(2)) if m else (None, None)
    @_t("Spotify._api_token")
    def _api_token(self):
        r = self.net.post("https://accounts.spotify.com/api/token", data={"grant_type": "client_credentials"},
                          auth=(self.cid, self.secret))
        if r.status_code != 200:
            raise MpError(L("Spotify: Client ID/Secret не подошли (HTTP %d)", 'Spotify: Client ID/Secret were rejected (HTTP %d)') % r.status_code)
        self.token = r.json().get("access_token")
        if not self.token:
            raise MpError(L("Spotify: токен не получен", 'Spotify: no token received'))
    @_t("Spotify._api_get")
    def _api_get(self, url, **kw):
        for _ in range(3):
            r = self.net.get(url, headers={"Authorization": "Bearer " + self.token}, **kw)
            if r.status_code == 429:
                time.sleep(min(20, int(r.headers.get("Retry-After", "5") or 5)))
                continue
            if r.status_code >= 400:
                raise MpError("Spotify API: HTTP %d" % r.status_code)
            return r.json()
        raise MpError("Spotify API: HTTP 429")
    @staticmethod
    @_t("Spotify._track", False, False)
    def _track(t, album=""):
        return mk("sp", t["id"], t.get("name"), ", ".join(a.get("name", "") for a in t.get("artists") or []),
                  album or (t.get("album") or {}).get("name"), float(t.get("duration_ms") or 0) / 1000.0)
    @_t("Spotify.via_api")
    def via_api(self, kind, pid):
        if not self.token:
            self._api_token()
        base = "https://api.spotify.com/v1/"
        if kind == "playlist":
            name = self._api_get(base + "playlists/%s" % pid, params={"fields": "name"}).get("name") or pid
            url = base + "playlists/%s/tracks" % pid
            params = {"limit": 100, "fields": "next,items(track(id,name,duration_ms,artists(name),album(name)))"}
            out = []
            while url and len(out) < 3000:
                j = self._api_get(url, params=params)
                out += [self._track(it["track"]) for it in j.get("items") or [] if (it.get("track") or {}).get("id")]
                url, params = j.get("next"), None
            return name, out
        if kind == "album":
            j = self._api_get(base + "albums/%s" % pid)
            name = j.get("name") or pid
            tr = j.get("tracks") or {}
            items, nxt = list(tr.get("items") or []), tr.get("next")
            while nxt and len(items) < 3000:
                jj = self._api_get(nxt)
                items += jj.get("items") or []
                nxt = jj.get("next")
            return name, [self._track(t, name) for t in items if t.get("id")]
        t = self._api_get(base + "tracks/%s" % pid)
        return t.get("name") or pid, ([self._track(t)] if t.get("id") else [])
    @_t("Spotify.via_embed")
    def via_embed(self, kind, pid):
        r = self.net.get("https://open.spotify.com/embed/%s/%s" % (kind, pid))
        if r.status_code >= 400:
            raise MpError(L("Spotify: страница HTTP %d", 'Spotify: page HTTP %d') % r.status_code)
        m = re.search(r'<script id="__NEXT_DATA__"[^>]*>(.*?)</script>', r.text, re.S)
        if not m:
            raise MpError(L("Spotify: страница изменилась, список не найден", 'Spotify: the page changed, no track list found'))
        data = json.loads(m.group(1))
        entity = find_first(data, "entity")
        name = (entity.get("name") or entity.get("title")) if isinstance(entity, dict) else None
        items = find_first(data, "trackList")
        album = (name or "") if kind == "album" else ""
        out = []
        if isinstance(items, list):
            for t in items:
                m2 = re.search(r"track:([A-Za-z0-9]+)", str(t.get("uri") or ""))
                if m2:
                    out.append(mk("sp", m2.group(1), t.get("title"), t.get("subtitle"), album, float(t.get("duration") or 0) / 1000.0))
        elif isinstance(entity, dict) and kind == "track":
            artists = ", ".join(a.get("name", "") for a in entity.get("artists") or [] if isinstance(a, dict)) or str(entity.get("subtitle") or "")
            out.append(mk("sp", pid, entity.get("name") or entity.get("title"), artists, "", float(entity.get("duration") or 0) / 1000.0))
        if not out:
            raise MpError(L("Spotify: в странице нет списка треков (закрыто?)", 'Spotify: the page has no track list (private?)'))
        if len(out) >= 100:
            ylog("Spotify: на странице ровно %d треков, возможно, список длиннее: для полного списка нужны Client ID и Secret" % len(out))
        return name or pid, out
    @_t("Spotify.playlist")
    def playlist(self, kind, pid):
        if self.cid and self.secret:
            try:
                return self.via_api(kind, pid)
            except Exception as e:
                ylog("Spotify API не сработал (%s), пробую публичную страницу" % e)
        return self.via_embed(kind, pid)


# ---------------------------------------------------------------- YouTube Music (playlists) and YouTube (audio)
class YtMusic:
    @_t("YtMusic.__init__")
    def __init__(self):
        self.net = Net("ytmusic", {"Origin": "https://music.youtube.com", "Referer": "https://music.youtube.com/"})
    @staticmethod
    @_t("YtMusic.playlist_id", False, False)
    def playlist_id(link):
        m = re.search(r"[?&]list=([A-Za-z0-9_-]+)", link or "")
        return m.group(1) if m else None
    @_t("YtMusic._post")
    def _post(self, endpoint, body):
        body = dict(body)
        body["context"] = {"client": YTM_CLIENT}
        r = self.net.post("%s/%s?prettyPrint=false" % (YTM_URL, endpoint), json=body)
        if r.status_code >= 400:
            raise MpError("YouTube Music: HTTP %d" % r.status_code)
        return r.json()
    @staticmethod
    @_t("YtMusic._items", False, False)
    def _items(j):
        out = []
        for r in find_all(j, "musicResponsiveListItemRenderer"):
            if str(r.get("musicItemRendererDisplayPolicy") or "").endswith("GREY_OUT"):
                continue
            vid = (r.get("playlistItemData") or {}).get("videoId") or find_first(r, "videoId")
            cols = [c.get("musicResponsiveListItemFlexColumnRenderer", {}).get("text") for c in r.get("flexColumns") or []]
            if not vid or not cols:
                continue
            title = runs_text(cols[0])
            artists = []
            if len(cols) > 1 and isinstance(cols[1], dict):
                for run in cols[1].get("runs") or []:
                    be = ((run.get("navigationEndpoint") or {}).get("browseEndpoint")) or {}
                    if str(be.get("browseId") or "").startswith("UC"):
                        artists.append(run.get("text", ""))
                if not artists:
                    artists = [runs_text(cols[1]).split(" • ")[0]]
            album = runs_text(cols[2]) if len(cols) > 2 else ""
            fixed = (r.get("fixedColumns") or [{}])[0].get("musicResponsiveListItemFixedColumnRenderer", {}).get("text")
            out.append(mk("yt", vid, title, ", ".join(a for a in artists if a), album, parse_dur(runs_text(fixed)), None, vid=vid))
        return out
    @staticmethod
    @_t("YtMusic._token", False, False)
    def _token(j):
        t = find_first(j, "nextContinuationData")
        if isinstance(t, dict) and t.get("continuation"):
            return t["continuation"]
        c = find_first(j, "continuationCommand")
        if isinstance(c, dict) and c.get("token"):
            return c["token"]
        return None
    @_t("YtMusic.playlist")
    def playlist(self, pid):
        j = self._post("browse", {"browseId": "VL" + pid})
        head = find_first(j, "musicResponsiveHeaderRenderer") or find_first(j, "musicDetailHeaderRenderer") or {}
        name = runs_text(head.get("title")) if isinstance(head, dict) else ""
        out = self._items(j)
        seen = set()
        tok = self._token(j)
        pages = 0
        while tok and tok not in seen and pages < 60:
            seen.add(tok)
            pages += 1
            j = self._post("browse", {"continuation": tok})
            out += self._items(j)
            tok = self._token(j)
        if not out:
            raise MpError(L("YouTube Music: в плейлисте не нашлось треков (закрытый или пустой?)", 'YouTube Music: no tracks found in the playlist (private or empty?)'))
        return name or pid, out
class YouTube:
    @_t("YouTube.__init__")
    def __init__(self):
        self.net = Net("youtube")
    @_t("YouTube.search")
    def search(self, query):
        r = self.net.post("%s/search?prettyPrint=false" % YT_URL,
                          json={"context": {"client": YT_WEB}, "query": query, "params": "EgIQAQ%3D%3D"})
        if r.status_code >= 400:
            raise MpError(L("YouTube: поиск HTTP %d", 'YouTube: search HTTP %d') % r.status_code)
        out = []
        for v in find_all(r.json(), "videoRenderer"):
            if v.get("videoId"):
                out.append({"vid": v["videoId"], "title": runs_text(v.get("title")),
                            "dur": parse_dur(runs_text(v.get("lengthText"))), "chan": runs_text(v.get("ownerText"))})
        return out
    @_t("YouTube.find")
    def find(self, want):
        q = "%s %s" % (split_artists(want.get("artists"))[:1] and split_artists(want["artists"])[0] or "", want.get("title"))
        best, best_score = None, 0.0
        for v in self.search(q)[:8]:
            sc = match_score(want, v["title"], v["chan"], v["dur"])
            ylog("match youtube: %s | %s -> %.2f" % (v["chan"][:30], v["title"][:50], sc), debug=True)
            if sc > best_score:
                best, best_score = v, sc
        if best is None or best_score < MATCH_MIN:
            raise MpError(L("на YouTube не найден", 'not found on YouTube'))
        return best["vid"]
    @_t("YouTube._client_formats")
    def _client_formats(self, vid, client, cid, ua):
        r = self.net.post("%s/player?prettyPrint=false" % YT_URL,
                          headers={"User-Agent": ua, "X-YouTube-Client-Name": str(cid), "X-YouTube-Client-Version": client["clientVersion"]},
                          json={"context": {"client": client}, "videoId": vid, "contentCheckOk": True, "racyCheckOk": True})
        j = r.json()
        status = (j.get("playabilityStatus") or {}).get("status")
        reason = (j.get("playabilityStatus") or {}).get("reason", "")
        fmts = [f for f in (j.get("streamingData") or {}).get("adaptiveFormats") or []
                if str(f.get("mimeType", "")).startswith("audio/") and f.get("url")]
        ylog("youtube %s client %s: %s, аудио-форматов %d" % (vid, client["clientName"], status, len(fmts)), debug=True)
        return fmts, status, reason
    @_t("YouTube._download")
    def _download(self, fmts, base, ua):
        mp4 = [f for f in fmts if "audio/mp4" in f.get("mimeType", "")]
        f = max(mp4 or fmts, key=lambda x: int(x.get("bitrate") or 0))
        ext = ".m4a" if "audio/mp4" in f.get("mimeType", "") else ".webm"
        dest = base + ext
        total = int(f.get("contentLength") or 0)
        tmp = dest + ".part"
        got = 0
        with open(tmp, "wb") as out:
            while True:
                end = got + 4 * 1024 * 1024 - 1
                if total:
                    end = min(end, total - 1)
                r = self.net.get(f["url"], headers={"User-Agent": ua, "Range": "bytes=%d-%d" % (got, end)}, timeout=(8, 60))
                if r.status_code >= 400:
                    raise MpError(L("YouTube: файл HTTP %d", 'YouTube: file HTTP %d') % r.status_code)
                out.write(r.content)
                got += len(r.content)
                if not r.content or (total and got >= total) or (not total and len(r.content) < 4 * 1024 * 1024):
                    break
        os.replace(tmp, dest)
        return dest
    @_t("YouTube.audio")
    def audio(self, vid, base):
        last = L("нет ответа", 'no answer')
        for client, cid, ua in YT_PLAYER_CLIENTS:
            try:
                fmts, status, reason = self._client_formats(vid, client, cid, ua)
                if not fmts:
                    last = ("%s %s" % (status, reason)).strip()
                    continue
                return self._download(fmts, base, ua)
            except Exception as e:
                last = "%s: %s" % (client["clientName"], e)
                ylog("youtube %s: клиент %s не подошёл (%s)" % (vid, client["clientName"], e))
        raise MpError(L("YouTube не отдал звук (%s)", 'YouTube gave no audio (%s)') % last.strip())


# ---------------------------------------------------------------- SoundCloud
def sc_mp3(trans):
    """The best mp3 transcoding of a SoundCloud track: progressive first, then HLS."""
    hls = None
    for tc in trans or []:
        fmt = tc.get("format") or {}
        if "mpeg" not in str(fmt.get("mime_type") or ""):
            continue
        proto = fmt.get("protocol")
        if proto == "progressive":
            return tc
        if proto == "hls":
            hls = hls or tc
    return hls
class SoundCloud:
    @_t("SoundCloud.__init__")
    def __init__(self, cache):
        self.net = Net("soundcloud", ua=DESKTOP_UA)
        self.cache = cache
    @_t("SoundCloud.client_id")
    def client_id(self, force=False):
        now = time.time()
        cid = self.cache.get("sc_cid")
        if cid and not force and now - float(self.cache.get("sc_cid_ts") or 0) < 3 * 86400:
            return cid
        if not force and now - float(self.cache.get("sc_cid_fail") or 0) < 120:
            raise MpError(L("SoundCloud: не удалось получить client_id (сайт изменился)", 'SoundCloud: could not get a client_id (the site changed)'))
        try:
            cid = self._scrape()
        except Exception:
            self.cache["sc_cid_fail"] = now
            raise
        self.cache["sc_cid"] = cid
        self.cache["sc_cid_ts"] = now
        self.cache["sc_cid_fail"] = 0
        ylog("SoundCloud: client_id обновлён")
        return cid
    @_t("SoundCloud._scrape")
    def _scrape(self):
        r = self.net.get("https://soundcloud.com/")
        page = r.text or ""
        ylog("SoundCloud: главная страница HTTP %s, %d байт" % (r.status_code, len(page)))
        m = re.search(r'"hydratable"\s*:\s*"apiClient"\s*,\s*"data"\s*:\s*\{[^{}]*?"id"\s*:\s*"([A-Za-z0-9]{32})"', page)
        if m:
            return m.group(1)
        srcs = [urlparse.urljoin("https://soundcloud.com/", x) for x in re.findall(r'<script[^>]+src="([^"]+)"', page)]
        ylog("SoundCloud: скриптов на странице %d" % len(srcs))
        for u in list(reversed(srcs))[:8]:
            try:
                js = self.net.get(u).text
            except Exception as e:
                ylog("SoundCloud: скрипт не загрузился (%s)" % e)
                continue
            m = re.search(r'client_id\s*:\s*"([0-9a-zA-Z]{32})"', js)
            if m:
                return m.group(1)
        raise MpError(L("SoundCloud: не удалось получить client_id (сайт изменился)", 'SoundCloud: could not get a client_id (the site changed)'))
    @_t("SoundCloud.get")
    def get(self, endpoint, **params):
        for attempt in (0, 1):
            p = dict(params)
            p["client_id"] = self.client_id(force=bool(attempt))
            r = self.net.get(endpoint, params=p)
            if r.status_code in (401, 403) and not attempt:
                continue
            if r.status_code == 404:
                raise MpError(L("SoundCloud: не найдено", 'SoundCloud: not found'))
            if r.status_code >= 400:
                raise MpError("SoundCloud: HTTP %d" % r.status_code)
            return r.json()
        raise MpError(L("SoundCloud: доступ запрещён", 'SoundCloud: access denied'))
    @staticmethod
    @_t("SoundCloud.track", False, False)
    def track(t):
        meta = t.get("publisher_metadata") or {}
        title = t.get("title") or ""
        artists = meta.get("artist") or ""
        if not artists and " - " in title:
            artists, title = [x.strip() for x in title.split(" - ", 1)]
        art = (t.get("artwork_url") or "").replace("-large.", "-t500x500.")
        return mk("sc", t.get("id"), title, artists or (t.get("user") or {}).get("username"), meta.get("album_title"),
                  float(t.get("duration") or 0) / 1000.0, art or None,
                  sc={"trans": (t.get("media") or {}).get("transcodings") or [], "auth": t.get("track_authorization"),
                      "policy": t.get("policy")})
    @_t("SoundCloud.resolve")
    def resolve(self, link):
        j = self.get("https://api-v2.soundcloud.com/resolve", url=link)
        kind = j.get("kind")
        if kind == "track":
            return j.get("title") or link, [self.track(j)]
        if kind != "playlist":
            raise MpError(L("SoundCloud: это не плейлист и не трек", 'SoundCloud: this is neither a playlist nor a track'))
        tracks = j.get("tracks") or []
        full = {t["id"]: t for t in tracks if t.get("title")}
        missing = [str(t["id"]) for t in tracks if t.get("id") and t["id"] not in full]
        for i in range(0, len(missing), 50):
            for t in self.get("https://api-v2.soundcloud.com/tracks", ids=",".join(missing[i:i + 50])) or []:
                full[t["id"]] = t
        return j.get("title") or link, [self.track(full[t["id"]]) for t in tracks if t.get("id") in full]
    @_t("SoundCloud.search")
    def search(self, query):
        j = self.get("https://api-v2.soundcloud.com/search/tracks", q=query, limit=10)
        return [self.track(t) for t in (j.get("collection") or []) if t.get("id")]
    @_t("SoundCloud.fetch")
    def fetch(self, tr, dest):
        sc = tr.get("sc") or {}
        if sc.get("policy") == "SNIP":
            raise MpError(L("у SoundCloud только фрагмент трека (Go+)", 'SoundCloud only has a preview of this track (Go+)'))
        tc = sc_mp3(sc.get("trans"))
        if tc is None:
            raise MpError(L("у SoundCloud нет mp3 для этого трека", 'SoundCloud has no mp3 for this track'))
        j = self.get(tc["url"], track_authorization=sc.get("auth") or "")
        url = j.get("url")
        if not url:
            raise MpError(L("SoundCloud не дал ссылку на звук", 'SoundCloud gave no audio link'))
        if (tc.get("format") or {}).get("protocol") == "progressive":
            download(self.net, url, dest)
        else:
            download_hls(self.net, url, dest)
    @_t("SoundCloud.cover")
    def cover(self, tr):
        if not tr.get("cover"):
            return None
        try:
            r = self.net.get(tr["cover"], timeout=(8, 20))
            return r.content if r.status_code < 400 and r.content else None
        except Exception:
            ylog_exc("soundcloud cover")
            return None
def pick_sc(want, cands):
    best, best_score = None, 0.0
    for c in cands[:10]:
        if (c.get("sc") or {}).get("policy") == "SNIP" or sc_mp3((c.get("sc") or {}).get("trans")) is None:
            continue
        sc = match_score(want, c["title"], c["artists"] + " " + c["title"], c["dur"])
        ylog("match soundcloud: %s - %s -> %.2f" % (c["artists"][:30], c["title"][:40], sc), debug=True)
        if sc > best_score:
            best, best_score = c, sc
    return (best, best_score) if best_score >= MATCH_MIN else (None, best_score)


# ---------------------------------------------------------------- ID3
def _id3_text(fid, text):
    body = b"\x01" + "﻿".encode("utf-16-le") + (text or "").encode("utf-16-le") + b"\x00\x00"
    return fid.encode("ascii") + struct.pack(">I", len(body)) + b"\x00\x00" + body
def _id3_cover(data):
    mime = b"image/png" if data[:4] == b"\x89PNG" else b"image/jpeg"
    body = b"\x00" + mime + b"\x00" + b"\x03" + b"\x00" + data
    return b"APIC" + struct.pack(">I", len(body)) + b"\x00\x00" + body
def _syncsafe(n):
    return bytes([(n >> 21) & 0x7F, (n >> 14) & 0x7F, (n >> 7) & 0x7F, n & 0x7F])
def write_tags(path, title, artist, album, cover):
    with open(path, "rb") as f:
        audio = f.read()
    if audio[:3] == b"ID3" and len(audio) >= 10:
        size = (audio[6] << 21) | (audio[7] << 14) | (audio[8] << 7) | audio[9]
        footer = 10 if audio[5] & 0x10 else 0
        audio = audio[10 + size + footer:]
    frames = _id3_text("TIT2", title) + _id3_text("TPE1", artist)
    if album:
        frames += _id3_text("TALB", album)
    if cover:
        frames += _id3_cover(cover)
    header = b"ID3\x03\x00\x00" + _syncsafe(len(frames))
    with open(path + ".tag", "wb") as f:
        f.write(header + frames + audio)
    os.replace(path + ".tag", path)


# ---------------------------------------------------------------- plugin
class MpPortPlugin(BasePlugin):
    def set_setting(self, key, value, *a, **kw):
        k = str(key)
        if not k.startswith("_"):
            _dinfo("setting %s = %s" % (k, "***" if any(s in k.lower() for s in _SECRETISH) else _dsafe(value, 80)))
        return super().set_setting(key, value, *a, **kw)
    @_t("MpPortPlugin.on_plugin_load")
    def on_plugin_load(self):
        self.dir = os.path.join(get_plugins_dir(), "ym_to_channel_data")
        self.files = os.path.join(self.dir, "files")
        for d in (self.dir, self.files):
            try:
                ensure_dir_exists(d)
            except Exception:
                _dexc("MpPortPlugin.on_plugin_load:L1257")
                os.makedirs(d, exist_ok=True)
        _dbg_start(os.path.join(self.dir, "mp_port_session.txt"), self)
        _dbg_set_debug(self.get_setting("debug", False))
        self.state = JsonFile(os.path.join(self.dir, "state.json"),
                              {"sent": {}, "failed": {}, "channel": None, "channels": {}, "playlists": [], "pending": [],
                               "sc_cid": "", "sc_cid_ts": 0}).load()
        self.stop_ev = threading.Event()
        self.worker = None
        self.run_scope = []
        self.status = L("не запускалась", 'not run yet')
        self.progress = None
        self._settings_ts = 0.0
        self._known_playlists = []
        self._cleanup(force_old=True)
        try:
            self.add_menu_item(MenuItemData(
                menu_type=MenuItemType.CHAT_ACTION_MENU,
                text=L("MP port: выгружать сюда", 'MP port: export here'),
                subtext=L("Сделать канал целью выгрузки", 'Make this channel an export target'),
                on_click=lambda ctx: ui(lambda: self.set_channel_from_ctx(ctx)),
                icon="msg_channel",
                item_id="ym_to_channel_target",
                priority=9,
            ))
        except Exception:
            ylog_exc("chat menu")
        ylog("загружен, отправлено ранее: %d" % len(self.state.data["sent"]))
        if not self._token() and not self.state.data.get("oauth_notice_shown"):
            self.state.data["oauth_notice_shown"] = True
            self.state.save()
            ui(lambda: toast_info(L(
                "MP port: выгрузка треков без OAuth-токена Яндекс Музыки не работает",
                "MP port: exporting tracks without a Yandex Music OAuth token does not work",
            )), 800)
    @_t("MpPortPlugin.on_plugin_unload")
    def on_plugin_unload(self):
        self.stop_ev.set()
        self.state.save()
    @_t("MpPortPlugin._index")
    def _index(self, key, default, size):
        try:
            v = self.get_setting(key, default)
            v = default if v is None else int(v)
        except Exception:
            _dexc("MpPortPlugin._index:L1295")
            v = default
        return v if 0 <= v < size else default
    @_t("MpPortPlugin._token")
    def _token(self):
        return str(self.get_setting("ym_token", "") or "").strip()
    @_t("MpPortPlugin._activity")
    def _activity(self):
        frag = get_last_fragment()
        return frag.getParentActivity() if frag is not None else None
    @_t("MpPortPlugin._refresh_settings")
    def _refresh_settings(self, throttle=False):
        now = time.time()
        if throttle and now - self._settings_ts < 3.0:
            return
        self._settings_ts = now
        def _do():
            self.set_setting("_rev", int(self.get_setting("_rev", 0) or 0) + 1, reload_settings=True)
        ui(_do)
    @_t("MpPortPlugin._rebuild_on")
    def _rebuild_on(self, key, value):
        """Saves the value once more, this time asking exteraGram to rebuild the settings page."""
        def rebuild():
            self.set_setting(key, value, reload_settings=True)
        ui(rebuild, 50)
    @_t("MpPortPlugin._on_debug")
    def _on_debug(self, value):
        _dbg_set_debug(value)
    @_t("MpPortPlugin._service")
    def _service(self):
        return SERVICES[self._index("service", 0, len(SERVICES))][0]
    @_t("MpPortPlugin._enabled")
    def _enabled(self):
        """Services that are set up: Yandex with a token and something to export, the others with playlist links."""
        out = []
        if self._token() and (self.get_setting("ym_likes", True) or self.state.data.get("playlists")):
            out.append("ym")
        for s in ("sp", "yt", "sc"):
            if self._links(s):
                out.append(s)
        return out
    @_t("MpPortPlugin._running")
    def _running(self):
        return getattr(self, "worker", None) is not None and self.worker.is_alive()
    @_t("MpPortPlugin._channel")
    def _channel(self, svc):
        """The channel of a service, or the common one."""
        return (self.state.data.get("channels") or {}).get(svc) or self.state.data.get("channel")
    @_t("MpPortPlugin._sent_count")
    def _sent_count(self, svc):
        keys = self.state.data.get("sent", {})
        if svc == "ym":
            return sum(1 for k in keys if ":" not in str(k))
        return sum(1 for k in keys if str(k).startswith(svc + ":"))
    @_t("MpPortPlugin._links")
    def _links(self, svc):
        return split_links(str(self.get_setting(svc + "_links", "") or ""))
    @_t("MpPortPlugin._pause")
    def _pause(self, svc):
        return PAUSES[self._index(svc + "_pause", 1, len(PAUSES))]
    @_t("MpPortPlugin.set_channel_from_ctx")
    def set_channel_from_ctx(self, ctx):
        chat = ctx_get(ctx, "chat")
        did = ctx_get(ctx, "dialog_id")
        acc = ctx_get(ctx, "account")
        try:
            acc = int(acc) if acc is not None else UserConfig.selectedAccount
        except Exception:
            _dexc("MpPortPlugin.set_channel_from_ctx:L1363")
            acc = UserConfig.selectedAccount
        if chat is None and did:
            try:
                chat = MessagesController.getInstance(acc).getChat(Long.valueOf(-int(did)))
            except Exception:
                _dexc("MpPortPlugin.set_channel_from_ctx:L1369")
                chat = None
        if chat is None or not ChatObject.isChannel(chat):
            toast_err(L("Выгружать можно только в канал", 'You can only export to a channel'))
            return
        try:
            if not ChatObject.canPost(chat):
                toast_err(L("В этом канале у вас нет права публиковать", 'You are not allowed to post in this channel'))
                return
        except Exception:
            _dexc("MpPortPlugin.set_channel_from_ctx:L1379")
            pass
        info = {"id": int(chat.id), "acc": int(acc), "title": str(chat.title or "")}
        act = self._activity()
        if act is None:
            self.state.data["channel"] = info
            self.state.save()
            self._refresh_settings()
            return
        b = AlertDialogBuilder(act)
        b.set_title(L("Выгружать сюда:", 'Export here:'))
        def pick(bld, which):
            bld.dismiss()
            if which == 0:
                self.state.data["channel"] = info
                label = L("Все сервисы", 'All services')
            elif 0 < which <= len(SERVICES):
                svc = SERVICES[which - 1][0]
                self.state.data.setdefault("channels", {})[svc] = info
                label = svc_name(svc)
            else:
                return
            self.state.save()
            ylog("канал для «%s»: %s" % (label, info["title"]))
            toast_ok("%s → «%s»" % (label, info["title"]))
            self._refresh_settings()
        b.set_items([L("Все сервисы (общий канал)", 'All services (common channel)')] + [svc_name(k) for k, _ in SERVICES], pick)
        b.set_negative_button(L("Отмена", 'Cancel'), lambda bld, w: bld.dismiss())
        b.show()
    @_t("MpPortPlugin.reset_channel")
    def reset_channel(self, svc):
        if (self.state.data.get("channels") or {}).pop(svc, None) is not None:
            self.state.save()
            toast_info(L("%s: теперь общий канал", '%s: now uses the common channel') % svc_name(svc))
            self._refresh_settings()
    @_t("MpPortPlugin._copy")
    def _copy(self, text, label):
        try:
            from android_utils import copy_to_clipboard
            copy_to_clipboard(text)
            toast_ok(L("Ссылка на расширение для %s скопирована", 'Extension link for %s copied') % label)
        except Exception:
            ylog_exc("copy")
            toast_err(L("Не удалось скопировать ссылку", 'Could not copy the link'))
    @_t("MpPortPlugin.token_help")
    def token_help(self, *args):
        act = self._activity()
        if act is None:
            return
        b = AlertDialogBuilder(act)
        b.set_title(L("Как получить OAuth-токен", 'How to get an OAuth token'))
        b.set_message(L(TOKEN_HELP, TOKEN_HELP_EN))
        def chrome(bld, w):
            bld.dismiss()
            self._copy(EXT_CHROME, "Chrome")
        def firefox(bld, w):
            bld.dismiss()
            self._copy(EXT_FIREFOX, "Firefox")
        b.set_neutral_button(L("Закрыть", 'Close'), lambda bld, w: bld.dismiss())
        b.set_negative_button("Firefox", firefox)
        b.set_positive_button("Chrome", chrome)
        b.show()
    @_t("MpPortPlugin.check_token")
    def check_token(self, *args):
        token = self._token()
        if not token:
            toast_err(L("Сначала вставьте OAuth-токен", 'Paste the OAuth token first'))
            return
        def bg():
            try:
                ym = YandexMusic(token)
                login, plus = ym.account()
                if plus:
                    toast_ok(L("Яндекс Музыка: %s, Плюс есть", 'Yandex Music: %s, Plus is active') % login)
                else:
                    toast_info(L("Яндекс Музыка: %s. Без Плюса скачается не всё", 'Yandex Music: %s. Without Plus not everything downloads') % login)
            except Exception as e:
                ylog_exc("check token")
                toast_err(L("Вход не удался: %s", 'Sign-in failed: %s') % e)
        _DThread(target=bg, name="MP-check", daemon=True).start()
    @_t("MpPortPlugin.check_links")
    def check_links(self, svc, *args):
        if not self._links(svc):
            toast_err(L("Сначала вставьте ссылки на плейлисты", 'Paste the playlist links first'))
            return
        def bg():
            try:
                items = self._collect(svc, {}, report=True)
                toast_ok(L("%s: найдено треков %d", '%s: %d tracks found') % (svc_name(svc), len(items)))
            except Exception as e:
                ylog_exc("check links " + svc)
                toast_err("%s: %s" % (svc_name(svc), e))
        _DThread(target=bg, name="MP-links", daemon=True).start()
    @_t("MpPortPlugin.ui_playlists")
    def ui_playlists(self, *args):
        token = self._token()
        if not token:
            toast_err(L("Сначала вставьте OAuth-токен", 'Paste the OAuth token first'))
            return
        def bg():
            try:
                ym = YandexMusic(token)
                ym.account()
                self._known_playlists = ym.playlists()
            except Exception as e:
                ylog_exc("playlists")
                toast_err(L("Не удалось получить плейлисты: %s", 'Could not load playlists: %s') % e)
                return
            if not self._known_playlists:
                toast_info(L("Своих плейлистов нет", 'You have no playlists'))
                return
            ui(self._playlists_dialog)
        _DThread(target=bg, name="MP-lists", daemon=True).start()
    @_t("MpPortPlugin._playlists_dialog")
    def _playlists_dialog(self):
        act = self._activity()
        if act is None:
            return
        chosen = set(int(k) for k in self.state.data.get("playlists", []))
        items = ["%s %s (%d)" % ("☑" if p["kind"] in chosen else "☐", p["title"], p["count"]) for p in self._known_playlists]
        b = AlertDialogBuilder(act)
        b.set_title(L("Плейлисты для выгрузки", 'Playlists to export'))
        def on_item(bld, which):
            bld.dismiss()
            if 0 <= which < len(self._known_playlists):
                kind = self._known_playlists[which]["kind"]
                sel = set(int(k) for k in self.state.data.get("playlists", []))
                sel.symmetric_difference_update({kind})
                self.state.data["playlists"] = sorted(sel)
                self.state.save()
                self._refresh_settings()
                ui(self._playlists_dialog, 150)
        b.set_items(items, on_item)
        b.set_positive_button(L("Готово", 'Done'), lambda bld, w: bld.dismiss())
        b.show()
    @_t("MpPortPlugin._preflight")
    def _preflight(self, scope):
        if not scope:
            return L("Нечего выгружать: вставьте токен Яндекс Музыки или ссылки на плейлисты", 'Nothing to export: paste a Yandex Music token or playlist links')
        for svc in scope:
            name = svc_name(svc)
            if self._channel(svc) is None:
                return L("%s: выберите канал (⋮ внутри канала → «MP port: выгружать сюда»)", '%s: choose a channel (⋮ inside the channel → «MP port: export here»)') % name
            if svc == "ym":
                if not self._token():
                    return L("Яндекс Музыка: сначала вставьте OAuth-токен", 'Yandex Music: paste the OAuth token first')
                if not self.get_setting("ym_likes", True) and not self.state.data.get("playlists"):
                    return L("Яндекс Музыка: включите «Мне нравится» или выберите плейлисты", 'Yandex Music: turn on «Liked tracks» or choose playlists')
            elif not self._links(svc):
                return L("%s: добавьте ссылки на плейлисты", '%s: add playlist links') % name
        return None
    @_t("MpPortPlugin.toggle_run")
    def toggle_run(self, services=None):
        """Starts the export of the given services (all configured ones when None), or stops a running one."""
        if self._running():
            self.stop_ev.set()
            self.status = L("останавливается…", 'stopping…')
            toast_info(L("Останавливаю после текущего трека", 'Stopping after the current track'))
            self._refresh_settings()
            return
        scope = list(services) if services else self._enabled()
        problem = self._preflight(scope)
        if problem:
            ylog("запуск отклонён: " + problem)
            toast_err(problem)
            return
        self.run_scope = scope
        self.stop_ev = threading.Event()
        self.worker = _DThread(target=self._run, args=(scope,), name="MP-run", daemon=True)
        self.worker.start()
        ylog("выгрузка запущена: " + ", ".join(scope))
        toast_info(L("Выгрузка запущена: ", 'Export started: ') + ", ".join(svc_name(x) for x in scope))
    # ---- collecting track lists
    @_t("MpPortPlugin._collect")
    def _collect(self, svc, ctx, report=False):
        if svc == "ym":
            return self._collect_ym(ctx)
        out = []
        errors = []
        for link in self._links(svc):
            try:
                if svc == "sp":
                    kind, pid = Spotify.parse(link)
                    if not pid:
                        raise MpError(L("не похоже на ссылку Spotify (плейлист, альбом или трек)", 'this does not look like a Spotify link (playlist, album or track)'))
                    name, tracks = Spotify(self.get_setting("sp_client_id", ""), self.get_setting("sp_client_secret", "")).playlist(kind, pid)
                elif svc == "yt":
                    pid = YtMusic.playlist_id(link)
                    if not pid:
                        raise MpError(L("в ссылке нет параметра list=", 'the link has no list= parameter'))
                    name, tracks = YtMusic().playlist(pid)
                else:
                    name, tracks = self._sc(ctx).resolve(link)
                ylog("%s «%s»: %d треков" % (svc_name(svc), name, len(tracks)))
                out += tracks
            except Exception as e:
                ylog_exc("collect %s %s" % (svc, link[:60]))
                errors.append("%s" % e)
        if not out and errors:
            raise MpError(errors[0])
        seen = set()
        uniq = []
        for t in out:
            if t["key"] not in seen:
                seen.add(t["key"])
                uniq.append(t)
        return uniq
    @_t("MpPortPlugin._collect_ym")
    def _collect_ym(self, ctx):
        ym = self._ym(ctx)
        ids = []
        if self.get_setting("ym_likes", True):
            ids += list(reversed(ym.liked_ids()))
        for kind in self.state.data.get("playlists", []):
            try:
                ids += ym.playlist_ids(kind)
            except Exception as e:
                ylog("плейлист %s: %s" % (kind, e))
        seen = set()
        out = []
        for tid in ids:
            if tid not in seen:
                seen.add(tid)
                out.append({"key": tid, "svc": "ym", "id": tid})
        ctx["ym_ids"] = [t["id"] for t in out]
        return out
    @_t("MpPortPlugin._ym")
    def _ym(self, ctx):
        ym = ctx.get("ym")
        if ym is None:
            token = self._token()
            if not token:
                raise MpError(L("нет токена Яндекс Музыки", 'no Yandex Music token'))
            ym = YandexMusic(token)
            ym.account()
            ctx["ym"] = ym
        return ym
    @_t("MpPortPlugin._sc")
    def _sc(self, ctx):
        sc = ctx.get("sc")
        if sc is None:
            sc = ctx["sc"] = SoundCloud(self.state.data)
        return sc
    @_t("MpPortPlugin._yt")
    def _yt(self, ctx):
        yt = ctx.get("yt")
        if yt is None:
            yt = ctx["yt"] = YouTube()
        return yt
    # ---- the run
    @_t("MpPortPlugin._run")
    def _run(self, scope):
        sent = self.state.data["sent"]
        failed = self.state.data["failed"]
        ok = fail = 0
        try:
            self.status = L("получаю список треков…", 'loading the track list…')
            self._refresh_settings()
            ctx = {}
            plan = []
            for svc in scope:
                try:
                    items = self._collect(svc, ctx)
                except Exception as e:
                    ylog_exc("collect " + svc)
                    toast_err("%s: %s" % (svc_name(svc), e))
                    continue
                todo = [t for t in items if t["key"] not in sent]
                ylog("%s: всего %d, к выгрузке %d" % (svc_name(svc), len(items), len(todo)))
                if todo:
                    plan.append((svc, todo))
            total = sum(len(t) for _, t in plan)
            if not total:
                self.status = L("новых треков нет", 'no new tracks')
                toast_ok(L("Новых треков нет — всё уже в канале", 'No new tracks, everything is already in the channel'))
                return
            for svc, todo in plan:
                pause = self._pause(svc)
                for tr in todo:
                    if self.stop_ev.is_set():
                        break
                    self._wait_pending()
                    self.progress = (ok + fail, total)
                    self.status = L("выгружено %d из %d, ошибок %d", 'exported %d of %d, errors %d') % (ok, total, fail)
                    self._refresh_settings(throttle=True)
                    try:
                        self._process(svc, tr, ctx)
                        sent[tr["key"]] = int(time.time())
                        failed.pop(tr["key"], None)
                        ok += 1
                    except Exception as e:
                        failed[tr["key"]] = str(e)[:120]
                        fail += 1
                        ylog("трек %s (%s): %s" % (tr["key"], tr.get("title", ""), e))
                    if (ok + fail) % 10 == 0:
                        self.state.save()
                    self.stop_ev.wait(pause)
                if self.stop_ev.is_set():
                    break
            self.status = (L("остановлено: ", 'stopped: ') if self.stop_ev.is_set() else L("готово: ", 'done: ')) + L("отправлено %d из %d, ошибок %d", 'sent %d of %d, errors %d') % (ok, total, fail)
            (toast_info if self.stop_ev.is_set() or fail else toast_ok)("MP port: " + self.status)
        except Exception as e:
            ylog_exc("run")
            self.status = L("ошибка: %s", 'error: %s') % e
            toast_err(L("Выгрузка прервана: %s", 'Export interrupted: %s') % e)
        finally:
            self.progress = None
            self.state.save()
            self._refresh_settings()
    @_t("MpPortPlugin._path")
    def _path(self, tr, ext):
        return os.path.join(self.files, "%s - %s [%s].%s" % (
            safe_name(tr["artists"])[:60], safe_name(tr["title"])[:60], safe_name(tr["key"]), ext))
    @_t("MpPortPlugin._process")
    def _process(self, svc, tr, ctx):
        if svc == "ym":
            path = self._file_ym(tr, ctx)
        elif svc == "sc":
            path = self._file_sc(tr, ctx)
        else:
            path = self._file_matched(svc, tr, ctx)
        self._send(path, svc)
    @_t("MpPortPlugin._send")
    def _send(self, path, svc):
        """Sends the file as music (player, title, performer, duration), not as a plain document."""
        ch = self._channel(svc)
        peer = -int(ch["id"])
        try:
            from client_utils import send_audio as sender
            kind = "audio"
        except ImportError:
            from client_utils import send_document as sender
            kind = "document"
            ylog("в этом SDK нет send_audio, отправляю как файл")
        ylog("отправка %s: %s" % (kind, os.path.basename(path)), debug=True)
        try:
            sender(peer, path, account=int(ch.get("acc", 0)))
        except TypeError as e:
            if "account" not in str(e):
                raise
            sender(peer, path)
        with self.state.lock:
            self.state.data["pending"].append([path, time.time()])
    @_t("MpPortPlugin._file_ym")
    def _file_ym(self, stub, ctx):
        ym = self._ym(ctx)
        info = ctx.setdefault("ym_info", {})
        tid = stub["id"]
        if tid not in info:
            ids = ctx.get("ym_ids") or [tid]
            i = ids.index(tid) if tid in ids else 0
            info.update(ym.tracks(ids[i:i + 100] if tid in ids else [tid]))
        tr = info.get(tid)
        if tr is None or tr.get("available") is False:
            raise YmError(L("трек недоступен", 'track unavailable'))
        title, artists, album = ym_names(tr)
        url, _ = ym.download_url(tid, QUALITIES[self._index("ym_quality", 0, len(QUALITIES))])
        path = self._path({"artists": artists, "title": title, "key": tid}, "mp3")
        ym.fetch(url, path)
        write_tags(path, title, artists, album, ym.cover(tr))
        return path
    @_t("MpPortPlugin._file_sc")
    def _file_sc(self, tr, ctx):
        sc = self._sc(ctx)
        path = self._path(tr, "mp3")
        sc.fetch(tr, path)
        write_tags(path, tr["title"], tr["artists"], tr["album"], sc.cover(tr))
        return path
    @_t("MpPortPlugin._file_matched")
    def _file_matched(self, svc, tr, ctx):
        """Spotify / YouTube Music: the sound comes from a source that serves mp3, or from YouTube as is."""
        notes = []
        for src in SOURCE_ORDER[self._index(svc + "_source", 2, len(SOURCE_ORDER))]:
            if src == "ym" and not self._token():
                ylog("Яндекс пропущен: нет токена", debug=True)
                notes.append(L("Яндекс Музыка: нет токена", 'Yandex Music: no token'))
                continue
            try:
                got = self._from_ym(svc, tr, ctx) if src == "ym" else self._from_sc(tr, ctx)
                if got:
                    return got
            except Exception as e:
                ylog("%s для %s: %s" % (svc_name(src) if src in ("ym", "sc") else src, tr["key"], e))
                notes.append(str(e))
        if self.get_setting(svc + "_fallback", True):
            return self._from_youtube(tr, ctx)
        raise MpError(L("mp3 не найден: ", 'mp3 not found: ') + "; ".join(notes))
    @_t("MpPortPlugin._from_ym")
    def _from_ym(self, svc, tr, ctx):
        ym = self._ym(ctx)
        q = "%s %s" % (split_artists(tr["artists"])[:1] and split_artists(tr["artists"])[0] or "", tr["title"])
        best, score = pick_ym(tr, ym.search(q))
        if best is None:
            raise MpError(L("в Яндексе не найден (лучшее совпадение %.2f)", 'not found on Yandex (best match %.2f)') % score)
        url, _ = ym.download_url(str(best["id"]), QUALITIES[self._index(svc + "_quality", 0, len(QUALITIES))])
        path = self._path(tr, "mp3")
        ym.fetch(url, path)
        ylog("%s: найден в Яндексе (%.2f)" % (tr["key"], score))
        write_tags(path, tr["title"], tr["artists"], tr["album"] or ym_names(best)[2], ym.cover(best))
        return path
    @_t("MpPortPlugin._from_sc")
    def _from_sc(self, tr, ctx):
        sc = self._sc(ctx)
        q = "%s %s" % (split_artists(tr["artists"])[:1] and split_artists(tr["artists"])[0] or "", tr["title"])
        best, score = pick_sc(tr, sc.search(q))
        if best is None:
            raise MpError(L("на SoundCloud не найден (лучшее совпадение %.2f)", 'not found on SoundCloud (best match %.2f)') % score)
        path = self._path(tr, "mp3")
        sc.fetch(best, path)
        ylog("%s: найден на SoundCloud (%.2f)" % (tr["key"], score))
        write_tags(path, tr["title"], tr["artists"], tr["album"] or best["album"], sc.cover(best))
        return path
    @_t("MpPortPlugin._from_youtube")
    def _from_youtube(self, tr, ctx):
        yt = self._yt(ctx)
        vid = tr.get("vid") or yt.find(tr)
        base = os.path.splitext(self._path(tr, "x"))[0]
        path = yt.audio(vid, base)
        ylog("%s: скачано с YouTube как есть (%s)" % (tr["key"], os.path.splitext(path)[1]))
        return path
    # ---- files waiting for Telegram
    @_t("MpPortPlugin._uploading_paths")
    def _uploading_paths(self):
        try:
            from hook_utils import get_private_field
            from org.telegram.messenger import FileLoader
            ch = self.state.data.get("channel") or next(iter((self.state.data.get("channels") or {}).values()), {})
            acc = int(ch.get("acc", UserConfig.selectedAccount))
            m = get_private_field(FileLoader.getInstance(acc), "uploadOperationPaths")
            if m is None:
                return None
            return {str(k) for k in m.keySet().toArray()}
        except Exception:
            _dexc("MpPortPlugin._uploading_paths:L1812")
            return None
    @_t("MpPortPlugin._cleanup")
    def _cleanup(self, force_old=False):
        now = time.time()
        busy = self._uploading_paths()
        keep = []
        with self.state.lock:
            for path, ts in self.state.data.get("pending", []):
                age = now - float(ts)
                done = age > UPLOAD_LIMIT or (busy is not None and age > UPLOAD_GRACE and path not in busy)
                if force_old and age > UPLOAD_LIMIT:
                    done = True
                if done:
                    try:
                        if os.path.exists(path):
                            os.remove(path)
                    except Exception:
                        _dexc("MpPortPlugin._cleanup:L1830")
                        pass
                else:
                    keep.append([path, ts])
            self.state.data["pending"] = keep
        if force_old:
            for name in os.listdir(self.files):
                p = os.path.join(self.files, name)
                if all(p != k[0] for k in keep):
                    try:
                        if now - os.path.getmtime(p) > UPLOAD_LIMIT:
                            os.remove(p)
                    except Exception:
                        _dexc("MpPortPlugin._cleanup:L1843")
                        pass
    @_t("MpPortPlugin._wait_pending")
    def _wait_pending(self):
        while not self.stop_ev.is_set():
            self._cleanup()
            if len(self.state.data.get("pending", [])) < MAX_PENDING:
                return
            self.status = L("жду, пока Telegram догрузит отправленное…", 'waiting for Telegram to finish uploading…')
            self._refresh_settings(throttle=True)
            self.stop_ev.wait(5)
    @_t("MpPortPlugin.reset_sent")
    def reset_sent(self, *args):
        act = self._activity()
        if act is None:
            return
        b = AlertDialogBuilder(act)
        b.set_title(L("Сбросить список отправленных?", 'Reset the list of sent tracks?'))
        b.set_message(L("Плагин забудет, какие треки уже в канале, и при следующем запуске отправит всё заново.", 'The plugin will forget which tracks are already in the channel and send everything again on the next run.'))
        def yes(bld, w):
            bld.dismiss()
            self.state.data["sent"] = {}
            self.state.data["failed"] = {}
            self.state.save()
            toast_info(L("Список отправленных очищен", 'The list of sent tracks was cleared'))
            self._refresh_settings()
        b.set_positive_button(L("Сбросить", 'Reset'), yes)
        b.set_negative_button(L("Отмена", 'Cancel'), lambda bld, w: bld.dismiss())
        b.show()
    @_t("MpPortPlugin.show_log")
    def show_log(self, *args):
        act = self._activity()
        if act is None:
            return
        failed = self.state.data.get("failed", {})
        text = "\n".join([L("Версия ", 'Version ') + __version__, L("Отправлено всего: %d", 'Sent in total: %d') % len(self.state.data["sent"]),
                          L("С ошибкой: %d", 'Failed: %d') % len(failed), ""] + _dbg_digest() + ["", L("Последние события:", 'Latest events:')] + _dbg_ring()[-25:])
        b = AlertDialogBuilder(act)
        b.set_title(L("Журнал выгрузки", 'Export log'))
        b.set_message(text)
        b.set_positive_button("OK", lambda bld, w: bld.dismiss())
        b.show()
    @_t("MpPortPlugin.send_log")
    def send_log(self, *args):
        def bg():
            try:
                from client_utils import send_document
                _persist(True)
                path = os.path.join(self.dir, "mp_port_log.txt")
                with open(path, "w", encoding="utf-8") as f:
                    f.write(_dbg_report())
                me = int(UserConfig.getInstance(UserConfig.selectedAccount).getClientUserId())
                send_document(me, path, caption="MP port %s log" % __version__)
                toast_ok(L("Журнал отправлен в Избранное", 'Log sent to Saved Messages'))
            except Exception:
                ylog_exc("send log")
                toast_err(L("Не удалось отправить журнал", 'Could not send the log'))
        _DThread(target=bg, name="MP-log", daemon=True).start()
    # ---- settings
    @_t("MpPortPlugin._service_run")
    def _service_run(self, svc):
        """Export button and target channel of one service."""
        mine = self._running() and svc in (self.run_scope or [])
        ch = (self.state.data.get("channels") or {}).get(svc)
        return [
            Header(text=L("Выгрузка: ", 'Export: ') + svc_name(svc)),
            Text(text=L("Остановить", 'Stop') if mine else L("Выгрузить из «%s»", 'Export from «%s»') % svc_name(svc), icon="msg_download", accent=True,
                 subtext=self.status if mine else L("Уже в канале: %d", 'Already in the channel: %d') % self._sent_count(svc),
                 on_click=lambda v, s=svc: self.toggle_run([s])),
            Text(text=(L("Канал: ", 'Channel: ') + ch["title"]) if ch else L("Канал: общий", 'Channel: common'), icon="msg_channel",
                 subtext=L("Нажмите, чтобы вернуть общий канал", 'Tap to use the common channel again') if ch else L("Свой канал: ⋮ внутри канала → «MP port: выгружать сюда» → этот сервис", 'Own channel: ⋮ inside the channel → «MP port: export here» → this service'),
                 on_click=lambda v, s=svc: self.reset_channel(s)),
        ]
    @_t("MpPortPlugin._service_block")
    def _service_block(self, svc, data):
        if svc == "ym":
            return [
                Header(text=L("Яндекс Музыка", 'Yandex Music')),
                Input(key="ym_token", text=L("OAuth-токен", 'OAuth token'), default="",
                      subtext=L("Токен Яндекс Музыки. Используется только для запросов к Яндексу", 'Yandex Music token. Used only for requests to Yandex')),
                Text(text=L("Проверить токен", 'Check token'), icon="msg_info", on_click=lambda v: self.check_token()),
                Text(text=L("Как получить токен", 'How to get a token'), icon="msg_help", accent=True,
                     subtext=L("Пошагово, со ссылкой на расширение для браузера", 'Step by step, with a link to the browser extension'),
                     on_click=lambda v: ui(self.token_help)),
                Divider(text=L(("Большинство способов получить токен перестали работать. "
                             "Самый стабильный — расширение для браузера Yandex Music Token."), 'Most ways to get a token no longer work. The most stable one is the Yandex Music Token browser extension.')),
                Divider(text=L(("Автор плагина никак не связан с создателем расширения "
                             "и не отвечает за данные пользователя."), 'The plugin author is not affiliated with the extension author and is not responsible for user data.')),
                Header(text=L("Что выгружать", 'What to export')),
                Switch(key="ym_likes", text=L("Мне нравится", 'Liked tracks'), default=True, subtext=L("Все лайкнутые треки, от старых к новым", 'All liked tracks, oldest first')),
                Text(text=L("Плейлисты", 'Playlists'), icon="msg_media",
                     subtext=L("Выбрано: %d", 'Selected: %d') % len(data.get("playlists", [])) if data.get("playlists") else L("Не выбраны", 'None selected'),
                     on_click=lambda v: self.ui_playlists()),
                Selector(key="ym_quality", text=L("Качество", 'Quality'), default=0, items=["%d kbps" % q for q in QUALITIES]),
                Selector(key="ym_pause", text=L("Пауза между треками", 'Pause between tracks'), default=1, items=[L("%d с", '%d s') % p for p in PAUSES]),
            ] + self._service_run("ym")
        name = svc_name(svc)
        items = [
            Header(text=name),
            Input(key=svc + "_links", text=L("Ссылки на плейлисты", 'Playlist links'), default="",
                  subtext=L("Одна или несколько, через пробел", 'One or more, separated by spaces')),
            Text(text=L("Проверить ссылки", 'Check links'), icon="msg_info", on_click=lambda v, s=svc: self.check_links(s)),
        ]
        if svc == "sp":
            items += [
                Input(key="sp_client_id", text=L("Client ID (необязательно)", 'Client ID (optional)'), default="",
                      subtext=L("Из developer.spotify.com. Без ключей список берётся с публичной страницы, до 100 треков", 'From developer.spotify.com. Without keys the list comes from the public page, up to 100 tracks')),
                Input(key="sp_client_secret", text=L("Client Secret (необязательно)", 'Client Secret (optional)'), default=""),
            ]
        if svc in ("sp", "yt"):
            items += [
                Selector(key=svc + "_source", text=L("Откуда брать звук", 'Where to take the audio from'), default=2, items=sources()),
                Switch(key=svc + "_fallback", text=L("Если mp3 не нашёлся, скачать с YouTube", 'If no mp3 is found, download from YouTube'), default=True,
                       subtext=L("Файл придёт как есть (m4a), без конвертации в mp3", 'The file arrives as is (m4a), not converted to mp3')),
                Selector(key=svc + "_quality", text=L("Качество mp3 из Яндекса", 'mp3 quality from Yandex'), default=0, items=["%d kbps" % q for q in QUALITIES]),
            ]
        items.append(Selector(key=svc + "_pause", text=L("Пауза между треками", 'Pause between tracks'), default=1, items=[L("%d с", '%d s') % p for p in PAUSES]))
        items += self._service_run(svc)
        notes = {
            "sp": L("Spotify не отдаёт звук, поэтому каждый трек ищется по названию, исполнителю и длительности (±3 с).", 'Spotify does not serve audio, so each track is matched by title, artist and duration (±3 s).'),
            "yt": L("YouTube Music отдаёт только opus и m4a, поэтому звук ищется там, где уже есть mp3.", 'YouTube Music only serves opus and m4a, so the audio is searched where mp3 already exists.'),
            "sc": L("С SoundCloud берутся треки, у которых есть mp3 (полные, не фрагменты Go+).", 'From SoundCloud, tracks that have an mp3 are taken (full tracks, not Go+ previews).'),
        }
        items.append(Divider(text=notes[svc]))
        return items
    @_t("MpPortPlugin.create_settings")
    def create_settings(self):
        st = getattr(self, "state", None)
        data = st.data if st is not None else {"sent": {}, "playlists": [], "channel": None}
        ch = data.get("channel")
        running = self._running()
        svc = self._service()
        items = [
            Header(text="MP port"),
        ]
        if not self._token():
            items.append(Text(
                text=L("Выгрузка треков без OAuth-токена не работает", "Exporting tracks without an OAuth token does not work"),
                icon="msg_info",
                red=True,
                subtext=L("Вставьте OAuth-токен Яндекс Музыки ниже", "Paste your Yandex Music OAuth token below"),
            ))
        items += [
            Selector(key="service", text=L("Сервис", 'Service'), default=0, items=[svc_name(k) for k, _ in SERVICES], icon="msg_media",
                     on_change=lambda v: self._rebuild_on("service", v)),
            Divider(),
        ]
        items += self._service_block(svc, data)
        items += [
            Divider(),
            Header(text=L("Канал", 'Channel')),
            Text(text=(ch or {}).get("title") or L("Общий канал не выбран", 'Common channel not chosen'), icon="msg_channel",
                 subtext=L("Общий канал для всех сервисов. Меняется через ⋮ внутри канала → «MP port: выгружать сюда»", 'Common channel for all services. Change it via ⋮ inside the channel → «MP port: export here»')),
            Divider(),
            Header(text=L("Выгрузка из всех сервисов", 'Export from all services')),
            Text(text=L("Остановить", 'Stop') if running else L("Выгрузить всё настроенное", 'Export everything set up'), icon="msg_download", accent=True,
                 subtext=getattr(self, "status", "") if running else (L("Настроено: ", 'Set up: ') + (", ".join(svc_name(x) for x in self._enabled()) or L("ничего", 'nothing'))),
                 on_click=lambda v: self.toggle_run(None)),
            Text(text=L("Журнал", 'Log'), icon="msg_stats", subtext=L("Отправлено всего: %d", 'Sent in total: %d') % len(data.get("sent", {})),
                 on_click=lambda v: ui(self.show_log)),
            Switch(key="debug", text=L("Подробный журнал", 'Verbose log'), default=False, on_change=self._on_debug,
                   subtext=L("Пишет каждый вызов, запрос и подбор трека. Включайте, когда что-то работает не так", 'Logs every call, request and track match. Turn it on when something misbehaves')),
            Text(text=L("Отправить журнал в Избранное", 'Send log to Saved Messages'), icon="msg_info", on_click=lambda v: self.send_log()),
            Text(text=L("Сбросить список отправленных", 'Reset the list of sent tracks'), icon="msg_delete", on_click=lambda v: ui(self.reset_sent)),
            Divider(text=L(("Уже отправленные треки пропускаются, так что повторный запуск докачивает только новое. "
                         "Файлы удаляются с телефона после того, как Telegram их загрузит."), 'Tracks that were already sent are skipped, so a new run only adds what is new. Files are removed from the phone once Telegram has uploaded them.')),
        ]
        return items