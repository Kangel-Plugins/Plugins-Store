from android.os import Bundle
from android.view import View

from org.telegram.messenger import LocaleController, R as R_tg
from org.telegram.tgnet import TLRPC
from org.telegram.ui import ChatActivity, PhotoViewer

from android_utils import OnClickListener, run_on_ui_thread
from base_plugin import BasePlugin, MethodHook
from client_utils import get_last_fragment, get_messages_controller, send_request
from hook_utils import find_class, get_private_field
from ui.bulletin import BulletinHelper

__id__ = "GoToAvatarMessage"
__name__ = "Go To Avatar Message"
__description__ = "добавляет пункт в просмотре аватарки в профиле для перехода к сервисному сообщению об установке аватарки, как в telegram desktop\nработает только в группах/каналах\n\nadds an option in avatar viewer in profile, to go to \"Photo Updated\" service message, like in telegram desktop\nworks only in groups/channels"
__author__ = "@nlvxm"
__version__ = "1.0"
__app_version__ = ">=12.5.1"

def tr(ru: str, en: str) -> str:
    try:
        lang = LocaleController.getInstance().getCurrentLocale().getLanguage()
        return ru if str(lang).startswith("ru") else en
    except Exception:
        return en

class _Hook(MethodHook):
    def __init__(self, plugin, fn):
        self.plugin = plugin
        self.fn = fn

    def after_hooked_method(self, param):
        try:
            self.fn(param.thisObject)
        except Exception as e:
            self.plugin.log(f"hook error: {e}")

class GoToAvatarMessage(BasePlugin):
    def on_plugin_load(self):
        cls = find_class("org.telegram.ui.PhotoViewer")
        self.hook_all_methods(cls, "setParentActivity", _Hook(self, self._add_item))
        self.hook_all_methods(cls, "setImageIndex", _Hook(self, self._update_visibility))
        run_on_ui_thread(lambda: self._add_item(PhotoViewer.getInstance()))

    def on_plugin_unload(self):
        def remove():
            _, popup = self._menu(PhotoViewer.getInstance())
            item = popup.findViewWithTag("GoToAvatarMessage") if popup is not None else None
            if item is not None:
                item.getParent().removeView(item)

        run_on_ui_thread(remove)

    def _menu(self, pv):
        menu = get_private_field(pv, "menuItem")
        popup = get_private_field(menu, "popupLayout") if menu is not None else None
        return menu, popup

    def _dialog_id(self, pv) -> int:
        return int(get_private_field(pv, "avatarsDialogId") or 0)

    def _add_item(self, pv):
        menu, popup = self._menu(pv)
        if popup is None:
            return
        if popup.findViewWithTag("GoToAvatarMessage") is None:
            item = menu.addSubItem(100042, R_tg.drawable.msg_message, tr("Перейти к сообщению", "Go to message"))
            item.setTag("GoToAvatarMessage")
            item.setOnClickListener(OnClickListener(lambda v: self._on_click(pv, menu)))
            try:
                item.setColors(0xFFFAFAFA - (1 << 32), 0xFFFAFAFA - (1 << 32))
            except Exception:
                pass
        self._update_visibility(pv)

    def _update_visibility(self, pv):
        _, popup = self._menu(pv)
        item = popup.findViewWithTag("GoToAvatarMessage") if popup is not None else None
        if item is not None:
            item.setVisibility(View.VISIBLE if self._dialog_id(pv) != 0 else View.GONE)

    def _on_click(self, pv, menu):
        try:
            menu.closeSubMenu()
        except Exception:
            pass
        try:
            dialog_id = self._dialog_id(pv)
            index = int(get_private_field(pv, "currentIndex") or 0)
            msgs = get_private_field(pv, "imagesArrMessages")

            if msgs is not None and index < msgs.size():
                msg = msgs.get(index)
                if msg is not None and msg.getId() != 0:
                    return self._open(pv, dialog_id, int(msg.getId()))

            photo_id = self._photo_id(pv, index)
            if not photo_id:
                return BulletinHelper.show_error(tr("Сообщение не найдено", "Message not found"))
            self._search(pv, dialog_id, photo_id)
        except Exception as e:
            self.log(f"click error: {e}")
            BulletinHelper.show_error(tr("Сообщение не найдено", "Message not found"))

    def _photo_id(self, pv, i: int) -> int:
        avatars = get_private_field(pv, "avatarsArr")
        if avatars is not None and i < avatars.size():
            return int(avatars.get(i).id)
        locs = get_private_field(pv, "imagesArrLocations")
        if locs is not None and i < locs.size():
            loc = locs.get(i)
            return int(loc.photoId or (loc.photo.id if loc.photo is not None else 0))
        return 0

    def _search(self, pv, dialog_id: int, photo_id: int, offset: int = 0):
        req = TLRPC.TL_messages_search()
        req.peer = get_messages_controller().getInputPeer(dialog_id)
        req.filter = TLRPC.TL_inputMessagesFilterChatPhotos()
        req.q = ""
        req.limit = 80
        req.add_offset = offset

        def on_response(response, error):
            msgs = getattr(response, "messages", None) if error is None else None
            if msgs is None or msgs.size() == 0:
                return run_on_ui_thread(lambda: BulletinHelper.show_error(tr("Сообщение не найдено", "Message not found")))

            for i in range(msgs.size()):
                msg = msgs.get(i)
                photo = getattr(getattr(msg, "action", None), "photo", None)
                if photo is not None and int(photo.id) == photo_id:
                    msg_id = int(msg.id)
                    return run_on_ui_thread(lambda: self._open(pv, dialog_id, msg_id))

            if msgs.size() >= 80:
                self._search(pv, dialog_id, photo_id, offset + 80)
            else:
                run_on_ui_thread(lambda: BulletinHelper.show_error(tr("Сообщение не найдено", "Message not found")))

        send_request(req, on_response)

    def _open(self, pv, dialog_id: int, msg_id: int):
        fragment = get_last_fragment()
        if fragment is None:
            return BulletinHelper.show_error(tr("Сообщение не найдено", "Message not found"))

        args = Bundle()
        args.putLong("chat_id", -dialog_id)
        args.putInt("message_id", msg_id)
        fragment.presentFragment(ChatActivity(args))
        pv.closePhoto(False, False)