import base64

from java import dynamic_proxy
from java.nio import ByteBuffer
from dalvik.system import InMemoryDexClassLoader
from android.widget import LinearLayout, TextView, ImageView
from android.view import View, MotionEvent
from android.graphics import Typeface, Color, BitmapFactory
from android.graphics.drawable import GradientDrawable, RippleDrawable
from android.content.res import ColorStateList
from org.telegram.messenger import ApplicationLoader, AndroidUtilities
from org.telegram.messenger.browser import Browser
from org.telegram.ui.ActionBar import Theme, BottomSheet

from base_plugin import BasePlugin
from android_utils import run_on_ui_thread, OnClickListener
from client_utils import get_last_fragment
from ui.settings import Header, Text, Custom

__id__ = "gift_search"
__name__ = "GiftSearch"
__description__ = "Поиск подарков в один клик — добавляет отдельную вкладку «Подарки» прямо в глобальный поиск Telegram"
__author__ = "@uipurple"
__icon__ = "ui_purpleicons/0"
__version__ = "1.0.1r"
__app_version__ = ">=12.5.1"
__sdk_version__ = ">=1.4.3.3"

dex_class_name = "giftsearch.HooksInjection"
dex_base64 = ""

class ButtonTouchListener(dynamic_proxy(View.OnTouchListener)):
    def __init__(self, callback):
        super().__init__()
        self.callback = callback

    def onTouch(self, view, event):
        return self.callback(view, event)


class Plugin(BasePlugin):

    def __init__(self):
        super().__init__()
        self.dex_class = None
        self.dex_loader = None
        self.channel_sheet = None

    def on_plugin_load(self):
        self._load_dex()

    def on_plugin_unload(self):
        self._unload_dex()

    def create_settings(self):
        items = []

        preview = self._make_preview()
        if preview is not None:
            items.append(Custom(view=preview))

        items += [
            Header(text="Параметры"),
            Text(
                text="Настройки поиска",
                subtext="Настройки фильтров и Fuzzy-поиск",
                icon="msg_search",
                create_sub_fragment=self._make_search_settings,
            ),
            Text(
                text="Настройки интерфейса",
                subtext="Карточки, отступы и размеры",
                icon="msg_palette",
                create_sub_fragment=self._make_interface_settings,
            ),
            Header(text="О плагине"),
            Text(
                text="Канал разработчика",
                icon="msg_channel",
                on_click=lambda v: run_on_ui_thread(self._show_channel_sheet),
            ),
        ]
        return items

    def _make_view(self, method_name):
        try:
            if self.dex_class is None:
                return None
            ctx = None
            frag = get_last_fragment()
            if frag is not None:
                ctx = frag.getParentActivity()
            if ctx is None:
                ctx = ApplicationLoader.applicationContext
            for m in self.dex_class.getMethods():
                if m.getName() == method_name:
                    return m.invoke(None, ctx)
        except Exception:
            pass
        return None

    def _make_preview(self):
        return self._make_view("createPreview")

    def _make_search_settings(self):
        v = self._make_view("createSettings")
        return [Custom(view=v)] if v is not None else []

    def _make_interface_settings(self):
        v = self._make_view("createInterface")
        return [Custom(view=v)] if v is not None else []

    def _show_channel_sheet(self):
        try:
            frag = get_last_fragment()
            act = frag.getParentActivity()
            self.channel_sheet = BottomSheet(act, True)
            self.channel_sheet.setBackgroundColor(0)
            self.channel_sheet.setApplyBottomPadding(False)
            self.channel_sheet.setApplyTopPadding(False)
            self.channel_sheet.setCustomView(self._draw_channel_ui(act))
            self.channel_sheet.show()
        except Exception:
            pass

    def _draw_channel_ui(self, ctx):
        dp = AndroidUtilities.dp
        bg = Theme.getColor(Theme.key_dialogBackground)
        tx = Theme.getColor(Theme.key_dialogTextBlack)
        ac = Theme.getColor(Theme.key_featuredStickers_addButton)
        gy = Color.parseColor("#A0A0A0") if Theme.isCurrentThemeDark() else Color.parseColor("#606060")

        root = LinearLayout(ctx)
        root.setOrientation(1)
        root.setGravity(1)

        sh = GradientDrawable()
        sh.setColor(bg)
        rad = float(dp(18))
        sh.setCornerRadii([rad, rad, rad, rad, 0, 0, 0, 0])
        root.setBackground(sh)
        root.setPadding(dp(24), dp(12), dp(24), dp(44))

        hd = View(ctx)
        h_sh = GradientDrawable()
        h_sh.setColor(gy)
        h_sh.setAlpha(60)
        h_sh.setCornerRadius(float(dp(3)))
        hd.setBackground(h_sh)
        root.addView(hd, LinearLayout.LayoutParams(dp(36), dp(4)))

        img = ImageView(ctx)
        img.setScaleType(ImageView.ScaleType.CENTER_INSIDE)
        try:
            channel_png_base64 = ""
            data = base64.b64decode(channel_png_base64)
            bmp = BitmapFactory.decodeByteArray(data, 0, len(data))
            if bmp is not None:
                img.setImageBitmap(bmp)
        except Exception:
            pass
        lp_i = LinearLayout.LayoutParams(dp(120), dp(120))
        lp_i.topMargin = dp(24)
        root.addView(img, lp_i)

        h1 = TextView(ctx)
        h1.setText("Канал разработчика")
        h1.setTextColor(tx)
        h1.setTextSize(1, 22)
        h1.setTypeface(Typeface.create("sans-serif-medium", 0))
        h1.setGravity(1)
        lp1 = LinearLayout.LayoutParams(-2, -2)
        lp1.topMargin = dp(20)
        root.addView(h1, lp1)

        h2 = TextView(ctx)
        h2.setText("Подпишитесь на канал разработчика, чтобы получать обновления и новые плагины!")
        h2.setTextColor(gy)
        h2.setTextSize(1, 15)
        h2.setGravity(1)
        lp2 = LinearLayout.LayoutParams(-2, -2)
        lp2.topMargin = dp(16)
        root.addView(h2, lp2)

        btn = self._make_button(ctx, "Открыть канал", ac)
        btn.setOnClickListener(OnClickListener(lambda v: self._go_channel()))
        lp_b = LinearLayout.LayoutParams(-1, -2)
        lp_b.topMargin = dp(32)
        root.addView(btn, lp_b)

        return root

    def _go_channel(self):
        try:
            if self.channel_sheet:
                self.channel_sheet.dismiss()
            act = get_last_fragment().getParentActivity()
            Browser.openUrl(act, "https://t.me/uipurple")
        except Exception:
            pass

    def _make_button(self, ctx, text, accent):
        dp = AndroidUtilities.dp
        btn = TextView(ctx)
        btn.setText(text)
        btn.setTextColor(-1)
        btn.setGravity(17)
        btn.setTypeface(Typeface.create("sans-serif-medium", 0))
        btn.setTextSize(1, 16)
        btn.setPadding(0, dp(14), 0, dp(14))

        content = GradientDrawable()
        content.setShape(GradientDrawable.RECTANGLE)
        content.setCornerRadius(float(dp(32)))
        content.setColor(accent)

        mask = GradientDrawable()
        mask.setShape(GradientDrawable.RECTANGLE)
        mask.setCornerRadius(float(dp(32)))
        mask.setColor(Color.WHITE)

        rc = Color.parseColor("#30FFFFFF") if Theme.isCurrentThemeDark() else Color.parseColor("#25FFFFFF")
        btn.setBackground(RippleDrawable(ColorStateList.valueOf(rc), content, mask))
        btn.setOnTouchListener(ButtonTouchListener(self._on_btn_touch))
        return btn

    def _on_btn_touch(self, view, event):
        a = event.getAction()
        if a == MotionEvent.ACTION_DOWN:
            view.animate().scaleX(0.965).scaleY(0.965).setDuration(120).start()
        elif a == MotionEvent.ACTION_UP or a == MotionEvent.ACTION_CANCEL:
            view.animate().scaleX(1.0).scaleY(1.0).setDuration(120).start()
        return False

    def _load_dex(self):
        self._unload_dex()
        dex_bytes = base64.b64decode(dex_base64)
        buffer = ByteBuffer.wrap(dex_bytes)
        parent_cl = ApplicationLoader.applicationContext.getClassLoader()

        self.dex_loader = InMemoryDexClassLoader(buffer, parent_cl)
        self.dex_class = self.dex_loader.loadClass(dex_class_name)
        self.dex_class.getMethod("start").invoke(None)

    def _unload_dex(self):
        if self.dex_class is not None:
            self.dex_class.getMethod("stop").invoke(None)
        self.dex_class = None
        self.dex_loader = None