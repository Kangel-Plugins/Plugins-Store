_BOX_CLASSES = {}


def box_class(name):
    """Resolves a java.lang wrapper class on demand.

    Every jclass() call is a JNI lookup, so they are not done at import time.
    """
    cls = _BOX_CLASSES.get(name)
    if cls is None:
        cls = jclass(name)
        _BOX_CLASSES[name] = cls
    return cls


_JAVA_CLASSES = {}


def java_class(name):
    cls = _JAVA_CLASSES.get(name)
    if cls is None:
        cls = jclass(name)
        _JAVA_CLASSES[name] = cls
    return cls


class NativeBridge:
    """Loads the DEX payload and calls into it."""

    def __init__(self, entry_class):
        self.entry_class = entry_class
        self.clazz = None
        self.loader = None
        self.loaded = False
        self._method_cache = {}
        self._lock = threading.Lock()

    def load(self):
        with self._lock:
            return self._load_locked()

    def unload(self):
        # never block the caller: if a load is in flight the worker cleans up
        if not self._lock.acquire(False):
            return False
        try:
            self._unload_locked()
        finally:
            self._lock.release()
        return True

    def _load_locked(self):
        if self.loaded:
            try:
                self.unload()
            except Exception:
                pass
        context = ApplicationLoader.applicationContext
        if context is None:
            raise RuntimeError("application context not ready")
        if int(jclass("android.os.Build$VERSION").SDK_INT) < 26:
            raise RuntimeError("API 26+ required")
        if not _DEX_BASE64:
            raise RuntimeError("DEX payload empty")
        raw = base64.b64decode(_DEX_BASE64)
        try:
            payload = zlib.decompress(raw)
        except Exception:
            payload = raw
        try:
            ByteBuffer = jclass("java.nio.ByteBuffer")
            InMemoryDexClassLoader = jclass("dalvik.system.InMemoryDexClassLoader")
            self.loader = InMemoryDexClassLoader(ByteBuffer.wrap(payload), context.getClassLoader())
            self.clazz = self.loader.loadClass(self.entry_class)
        except Exception:
            cache_dir = context.getCacheDir().getAbsolutePath()
            dex_hash = hashlib.sha256(_DEX_BASE64.encode()).hexdigest()[:12]
            dex_path = os.path.join(cache_dir, "plugin_{}.dex".format(dex_hash))
            opt_dir = os.path.join(cache_dir, "dex_opt_{}".format(dex_hash))
            os.makedirs(opt_dir, exist_ok=True)
            if not os.path.exists(dex_path):
                with open(dex_path, "wb") as handle:
                    handle.write(payload)
            DexClassLoader = jclass("dalvik.system.DexClassLoader")
            self.loader = DexClassLoader(dex_path, opt_dir, None, context.getClassLoader())
            self.clazz = self.loader.loadClass(self.entry_class)
        self._method_cache.clear()
        self._invoke("load")
        self.loaded = True

    def _unload_locked(self):
        if self.clazz:
            try:
                self._invoke("unload")
            except Exception:
                pass
        self._method_cache.clear()
        self.clazz = None
        self.loader = None
        self.loaded = False

    def _invoke(self, name, *args):
        if not self.clazz:
            raise RuntimeError("DEX not loaded")
        key = (name, len(args))
        cached = self._method_cache.get(key)
        if not cached:
            for method in self.clazz.getDeclaredMethods():
                if str(method.getName()) == name and len(method.getParameterTypes()) == len(args):
                    method.setAccessible(True)
                    cached = (method, [str(pt.getName()) for pt in method.getParameterTypes()])
                    self._method_cache[key] = cached
                    break
            if not cached:
                raise RuntimeError("method not found: {}/{}".format(name, len(args)))
        method, types = cached
        converted = []
        for index, arg in enumerate(args):
            arg_type = types[index]
            if arg_type in ("int", "java.lang.Integer"):
                converted.append(box_class("java.lang.Integer").valueOf(int(arg)))
            elif arg_type in ("long", "java.lang.Long"):
                converted.append(box_class("java.lang.Long").valueOf(int(arg)))
            elif arg_type in ("boolean", "java.lang.Boolean"):
                converted.append(box_class("java.lang.Boolean").valueOf(bool(arg)))
            elif arg_type in ("float", "java.lang.Float"):
                converted.append(box_class("java.lang.Float").valueOf(float(arg)))
            else:
                converted.append(arg)
        return method.invoke(None, *converted)

    def call(self, name, *args):
        return self._invoke(name, *args)

    def update_config(self, value):
        return self._invoke("updateConfig", 1 if value else 0)


class FallbackHook(MethodHook):
    """Used only when the DEX could not install its own hooks."""

    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        self._apply(param)

    def after_hooked_method(self, param):
        self._apply(param)

    def _apply(self, param):
        try:
            args = param.args
            if not args:
                return
            message = None
            for arg in args:
                if arg is None:
                    continue
                if str(arg.getClass().getName()).endswith("MessageObject"):
                    message = arg
                    break
            if message is None:
                return
            cell = param.thisObject
            if cell is None:
                return
            self.plugin.apply_avatar(cell, message)
        except Exception:
            pass


class HeaderAvatarHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        pass

    def after_hooked_method(self, param):
        try:
            self.plugin.hide_header_avatar(param.thisObject)
        except Exception:
            pass


_ACTIVE_INSTANCE = None


class Plugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self.bridge = NativeBridge(ENTRY_CLASS)
        self._fallback_handles = []
        self._header_handles = []
        self._trace_started = False
        self._trace_path = None
        self._unloaded = False



    def on_plugin_load(self):
        global _ACTIVE_INSTANCE
        if _ACTIVE_INSTANCE is not None and _ACTIVE_INSTANCE is not self:
            try:
                _ACTIVE_INSTANCE.on_plugin_unload()
            except Exception:
                pass
        _ACTIVE_INSTANCE = self

        self._unloaded = False

        self._start_background(self._load_dex)
        run_on_ui_thread(self._install_header_hooks)

    def _start_background(self, func):
        try:
            if PLUGINS_QUEUE is not None:
                run_on_queue(func, PLUGINS_QUEUE)
                return
        except Exception as error:
            self.log("cannot use the plugin queue: {}".format(error))
        threading.Thread(target=func, name="avatar_in_dm_loader", daemon=True).start()

    def _load_dex(self):
        """Runs in the background: loads the dex and installs the hooks."""
        started = time.time()
        loaded = False
        installed = False
        try:
            self.bridge.load()
            loaded = True
            try:
                installed = bool(self.bridge.call("areHooksInstalled"))
            except Exception:
                installed = False
        except Exception as error:
            self.log("DEX payload could not be loaded: {}".format(error))

        if self._unloaded:
            # the plugin was disabled while the dex was loading
            if loaded:
                try:
                    self.bridge.unload()
                except Exception:
                    pass
            return

        if not installed:
            self.log("DEX hooks are unavailable, using the python fallback")
            run_on_ui_thread(self._install_fallback_hooks)

        spent = int((time.time() - started) * 1000)
        if spent > 5000:
            self.log("the dex took {} ms to load, something is wrong".format(spent))
        else:
            self.log("{} ({} ms)".format(self._status(), spent))

    def on_plugin_unload(self):
        global _ACTIVE_INSTANCE
        self._unloaded = True
        for handle in self._fallback_handles:
            try:
                handle.unhook()
            except Exception:
                pass
        self._fallback_handles = []
        for handle in self._header_handles:
            try:
                handle.unhook()
            except Exception:
                pass
        self._header_handles = []
        try:
            if self.bridge is not None:

                self.bridge.unload()
        except Exception:
            pass
        if _ACTIVE_INSTANCE is self:
            _ACTIVE_INSTANCE = None



    def _install_fallback_hooks(self):
        if self._unloaded or self._fallback_handles:
            return
        cell_cls = None
        for candidate in ("org.telegram.ui.Cells.ChatMessageCell", "org.telegram.p035ui.Cells.ChatMessageCell"):
            try:
                cell_cls = jclass(candidate)
                break
            except Exception:
                continue
        if cell_cls is None:
            self.log("ChatMessageCell not found")
            return

        target = "setMessageContent"
        if not self._has_method(cell_cls, target):
            target = "setMessageObject"
        hook = FallbackHook(self)
        try:
            handle = self.hook_all_methods(cell_cls, target, hook)
            if handle is not None:
                self._fallback_handles.append(handle)
        except Exception as error:
            self.log("fallback hook {} failed: {}".format(target, error))

    @staticmethod
    def _has_method(clazz, name):
        try:
            for method in clazz.getDeclaredMethods():
                if str(method.getName()) == name:
                    return True
        except Exception:
            pass
        return False

    def apply_avatar(self, cell, message):
        """Patches a single cell, used by the python fallback."""
        if self.bridge is not None and self.bridge.clazz is not None:
            try:
                self.bridge.call("applyAvatar", cell, message)
                return
            except Exception:
                pass
        try:
            dialog_id = int(message.getDialogId())
        except Exception:
            return
        # Leave group/channel/secret-chat layout to the host.
        if dialog_id <= 0:
            return
        show_avatar = self._is_human_dialog(message, dialog_id)
        try:
            cell.isChat = show_avatar
        except Exception:
            try:
                from hook_utils import set_private_field
                set_private_field(cell, "isChat", show_avatar)
            except Exception:
                pass

    @staticmethod
    def _is_human_dialog(message, dialog_id):
        """Resolve the dialog peer in the message's account; fail closed."""
        if dialog_id <= 0 or dialog_id == TELEGRAM_SERVICE_USER_ID:
            return False
        try:
            account = int(message.currentAccount)
            UserConfig = java_class("org.telegram.messenger.UserConfig")
            if dialog_id == int(UserConfig.getInstance(account).getClientUserId()):
                return False
            MessagesController = java_class("org.telegram.messenger.MessagesController")
            user = MessagesController.getInstance(account).getUser(
                box_class("java.lang.Long").valueOf(dialog_id)
            )
            return user is not None and not bool(user.bot)
        except Exception:
            return False

    def _status(self):
        if self.bridge is not None:
            try:
                return str(self.bridge.call("status"))
            except Exception:
                pass
        return "Avatar in DM is ready"

    def _install_header_hooks(self):
        if self._unloaded or self._header_handles:
            return
        from java.lang import Class as JavaClass
        container_cls = None
        for name in HEADER_CONTAINER_CLASSES:
            try:
                container_cls = JavaClass.forName(name)
                break
            except Exception:
                continue
        if container_cls is None:
            self.log("ChatAvatarContainer not found, action bar avatar stays visible")
            return
        try:
            handle = self.hook_all_methods(container_cls, "checkAndUpdateAvatar", HeaderAvatarHook(self))
        except Exception as error:
            self.log("action bar avatar hook failed: {}".format(error))
            return
        if handle is not None:
            self._header_handles.append(handle)
            self.log("action bar avatar hook installed")

    def hide_header_avatar(self, container):
        if self._unloaded or container is None or get_private_field is None:
            return
        parent = get_private_field(container, "parentFragment")
        if parent is None or not self._is_direct_chat(parent.getCurrentUser()):
            return
        avatar = container.getAvatarImageView()
        if avatar is None:
            return
        gone = java_class("android.view.View").GONE
        # Telegram's onLayout reads the avatar's visibility, so GONE moves the title and subtitle into its slot.
        if avatar.getVisibility() != gone:
            avatar.setVisibility(gone)
        self._maybe_start_trace()

    @staticmethod
    def _is_direct_chat(user):
        if user is None:
            return False
        try:
            return not bool(java_class("org.telegram.messenger.UserObject").isReplyUser(user))
        except Exception:
            return False

    def _maybe_start_trace(self):
        if PROFILE_TRACE_SECONDS <= 0 or self._trace_started:
            return
        self._trace_started = True
        try:
            context = ApplicationLoader.applicationContext
            folder = context.getExternalFilesDir(None) or context.getCacheDir()
            path = os.path.join(str(folder.getAbsolutePath()), "avatar_in_dm_{}.trace".format(int(time.time())))
            java_class("android.os.Debug").startMethodTracingSampling(path, 32 * 1024 * 1024, 1000)
        except Exception as error:
            self.log("method trace not started: {}".format(error))
            return
        self._trace_path = path
        self.log("method trace started: {}".format(path))
        run_on_ui_thread(self._stop_trace, PROFILE_TRACE_SECONDS * 1000)

    def _stop_trace(self):
        try:
            java_class("android.os.Debug").stopMethodTracing()
        except Exception as error:
            self.log("method trace not stopped: {}".format(error))
            return
        self.log("method trace saved: {}".format(self._trace_path))
