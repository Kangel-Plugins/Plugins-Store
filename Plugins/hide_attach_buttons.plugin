from typing import Any, List

from android.graphics.drawable import GradientDrawable, InsetDrawable
from android.view import View, ViewTreeObserver
import traceback

from java.lang import System

from base_plugin import BasePlugin, MethodHook
from hook_utils import find_class, get_private_field
from android_utils import run_on_ui_thread, log as _android_log
from ui.settings import Header, Switch, Divider

try:
    from java import dynamic_proxy
except Exception:
    dynamic_proxy = None

try:
    from org.telegram.messenger import AndroidUtilities
except Exception:
    AndroidUtilities = None

BUILD = "md3-r8"
TOKEN_KEY = "hide_attach_buttons.token"

__id__ = "hide_attach_buttons"
__name__ = "HideAttachButtons"
__description__ = "Скрывает выбранные кнопки нижней панели прикрепления."
__author__ = "@optimist_opti × @KUNSESHBOY"
__version__ = "1.0"
__icon__ = "NE_SMOTRI_SYUDA81/5"
__min_version__= "12.10.6"


BUTTON_IDS = {
    1: "gallery",
    3: "music",
    4: "document",
    5: "contact",
    6: "location",
    9: "poll",
    11: "quick_replies",
    16: "article",
}

ADAPTER_KEYS = {
    "gallery": "gallery",
    "document": "document",
    "music": "music",
    "poll": "poll",
    "contact": "contact",
    "quickreplies": "quick_replies",
    "location": "location",
    "rich": "article",
}

ARTICLE_MARKERS = ("стать", "article")

LIST_MARKERS = ("список", "list")

_STATE = {}
_FIELDS = {}
_PREDRAW = {"recycler": None, "observer": None, "proxy": None}
_ORIG_W = {}

STRETCH_MAX = 4


def _alive(plugin):
    try:
        return str(System.getProperty(TOKEN_KEY)) == plugin._token
    except Exception:
        return False


_LOG_SEEN = {}


def _log(plugin, msg):
    key = str(msg)[:120]
    seen = _LOG_SEEN.get(key, 0)
    if seen >= 5:
        return
    if len(_LOG_SEEN) >= 300 and key not in _LOG_SEEN:
        _LOG_SEEN.clear()
    _LOG_SEEN[key] = seen + 1
    text = f"[HideAttachButtons] {msg}"
    try:
        plugin.log(text)
    except Exception:
        try:
            _android_log(text)
        except Exception:
            pass


_DIAG = {"left": 30}


def _diag(plugin, msg):
    if _DIAG["left"] > 0:
        _DIAG["left"] -= 1
        _log(plugin, f"diag: {msg}")


def _vid(view):
    try:
        return int(System.identityHashCode(view))
    except Exception:
        return id(view)


def _class_name(view):
    try:
        return str(view.getClass().getName())
    except Exception:
        return type(view).__name__


def _is_bot_view(view):
    name = _class_name(view)
    return "AttachBot" in name or "BotButton" in name


def _hide_on(plugin, key):
    return bool(plugin.get_setting(f"hide_{key}", False))


def _hide_bots(plugin):
    return bool(plugin.get_setting("hide_all_bots", False))


def _hide_view(view):
    if view is None:
        return
    try:
        key = _vid(view)
        lp = view.getLayoutParams()

        if key not in _STATE:
            st = {
                "clickable": bool(view.isClickable()),
                "enabled": bool(view.isEnabled()),
                "w": None,
                "h": None,
                "lm": None,
                "rm": None,
            }
            if lp is not None:
                st["w"] = _ORIG_W.get(key, lp.width)
                st["h"] = lp.height
                try:
                    st["lm"] = lp.leftMargin
                    st["rm"] = lp.rightMargin
                except Exception:
                    pass
            _STATE[key] = st

        view.setVisibility(View.GONE)
        view.setTranslationX(0)
        view.setAlpha(0.0)
        view.setEnabled(False)
        view.setClickable(False)

        if lp is not None:
            lp.width = 0
            lp.height = 0
            if _STATE[key]["lm"] is not None:
                lp.leftMargin = 0
                lp.rightMargin = 0
            view.setLayoutParams(lp)
    except Exception:
        pass


def _show_view(view):
    if view is None:
        return
    st = _STATE.pop(_vid(view), None)
    if st is None:
        return
    try:
        lp = view.getLayoutParams()
        if lp is not None:
            if st["w"] is not None:
                lp.width = st["w"]
            if st["h"] is not None:
                lp.height = st["h"]
            if st["lm"] is not None:
                lp.leftMargin = st["lm"]
                lp.rightMargin = st["rm"]
            view.setLayoutParams(lp)
        view.setVisibility(View.VISIBLE)
        view.setAlpha(1.0)
        view.setEnabled(st["enabled"])
        view.setClickable(st["clickable"])
        view.requestLayout()
    except Exception:
        pass


def _apply(view, hide):
    if hide:
        _hide_view(view)
    else:
        _show_view(view)


def _find_text(view, depth):
    try:
        t = str(view.getText() or "").strip()
        if t:
            return t
    except Exception:
        pass
    if depth >= 3:
        return ""
    try:
        if hasattr(view, "getChildCount"):
            for i in range(view.getChildCount()):
                t = _find_text(view.getChildAt(i), depth + 1)
                if t:
                    return t
    except Exception:
        pass
    try:
        d = view.getContentDescription()
        if d:
            return str(d).strip()
    except Exception:
        pass
    return ""


def _get_label(view):
    if view is None:
        return ""
    for field in ("textView", "nameTextView"):
        try:
            tv = get_private_field(view, field)
            if tv is not None:
                t = str(tv.getText() or "").strip()
                if t:
                    return t
        except Exception:
            pass
    return _find_text(view, 0)


def _should_hide(plugin, bid, label, is_bot):
    if is_bot:
        return _hide_bots(plugin)

    key = BUTTON_IDS.get(bid) if bid is not None else None
    if key and _hide_on(plugin, key):
        return True

    low = (label or "").lower()
    if low and _hide_on(plugin, "list") and low in LIST_MARKERS:
        return True
    if low and _hide_on(plugin, "article"):
        for m in ARTICLE_MARKERS:
            if m in low:
                return True
    return False


def _center_remaining(recycler):
    if recycler is None:
        return
    try:
        visible = []
        for i in range(recycler.getChildCount()):
            child = recycler.getChildAt(i)
            if child is None:
                continue
            if child.getVisibility() != View.VISIBLE:
                child.setTranslationX(0)
                continue
            visible.append(child)

        if not visible:
            return

        widths = []
        total_w = 0
        for v in visible:
            w = v.getWidth() or v.getMeasuredWidth() or 0
            widths.append(w)
            total_w += w

        pad_l = recycler.getPaddingLeft()
        pad_r = recycler.getPaddingRight()
        avail = (recycler.getWidth() or recycler.getMeasuredWidth() or 0) - pad_l - pad_r
        if avail <= 0 or total_w <= 0:
            return

        if total_w > avail:
            for v in visible:
                v.setTranslationX(0)
            return

        x = pad_l + (avail - total_w) // 2
        for idx, child in enumerate(visible):
            child.setTranslationX(float(x - child.getLeft()))
            x += widths[idx]

        recycler.invalidate()
    except Exception:
        pass


def _visible_buttons(recycler):
    n = 0
    for i in range(recycler.getChildCount()):
        c = recycler.getChildAt(i)
        if c is not None and c.getVisibility() == View.VISIBLE:
            n += 1
    return n


_CONTAINER = {"view": None}


def _update_container(plugin, recycler):
    if recycler is None:
        return
    try:
        container = recycler.getParent()
        if container is None or not hasattr(container, "setVisibility"):
            return
        hide = _visible_buttons(recycler) == 0
        if hide:
            
            _CONTAINER["view"] = container
            if container.getVisibility() != View.GONE:
                container.setVisibility(View.GONE)
        else:
            
            cur = _CONTAINER["view"]
            if cur is not None:
                _CONTAINER["view"] = None
                if _vid(cur) == _vid(container):
                    if container.getVisibility() == View.GONE:
                        container.setVisibility(View.VISIBLE)
                        container.requestLayout()
                else:
                    try:
                        cur.setVisibility(View.VISIBLE)
                        cur.requestLayout()
                    except Exception:
                        pass
    except Exception:
        pass


_MD3 = {"orig": {}, "sig": None}
_THEME = {"cls": None}


def _theme_cls():
    cls = _THEME["cls"]
    if cls is None:
        cls = find_class("org.telegram.ui.ActionBar.Theme")
        _THEME["cls"] = cls
    return cls


def _theme_color(name, default):
    try:
        cls = _theme_cls()
        return int(cls.getColor(int(getattr(cls, name))))
    except Exception:
        return default


def _is_dark_theme():
    try:
        return bool(_theme_cls().isCurrentThemeDark())
    except Exception:
        return True


def _argb(r, g, b):
    v = (0xFF << 24) | ((r & 0xFF) << 16) | ((g & 0xFF) << 8) | (b & 0xFF)
    return v - (1 << 32) if v & 0x80000000 else v


def _channels(c):
    c = int(c)
    return (c >> 16) & 0xFF, (c >> 8) & 0xFF, c & 0xFF


def _blend(base, over, ratio):
    br, bg, bb = _channels(base)
    orr, og, ob = _channels(over)
    return _argb(
        int(br * (1 - ratio) + orr * ratio),
        int(bg * (1 - ratio) + og * ratio),
        int(bb * (1 - ratio) + ob * ratio),
    )


_COLOR_CACHE = {"ts": 0, "val": None}


def _md3_colors(recycler):
    now = int(System.currentTimeMillis())
    if _COLOR_CACHE["val"] is not None and now - _COLOR_CACHE["ts"] < 2000:
        return _COLOR_CACHE["val"]
    val = _md3_colors_now(recycler)
    _COLOR_CACHE["ts"] = now
    _COLOR_CACHE["val"] = val
    return val


def _md3_colors_now(recycler):
    dark = _is_dark_theme()
    base = None
    try:
        bg = recycler.getParent().getBackground()
        if bg is not None and "ColorDrawable" in _class_name(bg):
            r, g, b = _channels(bg.getColor())
            base = _argb(r, g, b)
    except Exception:
        base = None
    if base is None:
        base = _theme_color("key_windowBackgroundWhite", _argb(24, 24, 27) if dark else _argb(255, 255, 255))
    on = _theme_color("key_windowBackgroundWhiteBlackText", _argb(255, 255, 255) if dark else _argb(0, 0, 0))
    accent = _theme_color("key_chats_actionBackground", None)
    if accent is None:
        accent = _theme_color("key_windowBackgroundWhiteBlueText", _argb(255, 95, 120))
    unselected = _blend(base, on, 0.07 if dark else 0.05)
    selected = _blend(base, accent, 0.32 if dark else 0.22)
    return unselected, selected


def _md3_enabled(plugin):
    return bool(plugin.get_setting("md3_style", False))


def _md3_restore(recycler=None):
    for vid, pair in list(_MD3["orig"].items()):
        try:
            pair[0].setBackground(pair[1])
        except Exception:
            pass
    _MD3["orig"].clear()
    _MD3["sig"] = None


def _md3_views(recycler):
    vis = []
    for i in range(recycler.getChildCount()):
        c = recycler.getChildAt(i)
        if c is not None and c.getVisibility() == View.VISIBLE:
            vis.append(c)
    return vis


_LAYOUT_FIELDS = {
    1: "photoLayout",
    3: "audioLayout",
    4: "documentLayout",
    5: "contactsLayout",
    6: "locationLayout",
    9: "pollLayout",
    11: "quickRepliesLayout",
}

_ALERT_FIELDS = {}


def _find_field(obj, name):
    cls = obj.getClass()
    while cls is not None:
        try:
            f = cls.getDeclaredField(name)
            f.setAccessible(True)
            return f
        except Exception:
            cls = cls.getSuperclass()
    return None


def _child_bid(view):
    if _is_bot_view(view):
        return None
    try:
        t = view.getTag()
        if t is not None:
            return int(t)
    except Exception:
        pass
    try:
        cid = get_private_field(view, "currentId")
        if cid is not None:
            return int(cid)
    except Exception:
        pass
    return None


_OUTER_FIELDS = {}


def _selected_bid(recycler):
    try:
        adapter = recycler.getAdapter()
        outer_key = str(adapter.getClass().getName())
        f = _OUTER_FIELDS.get(outer_key)
        if f is None:
            f = adapter.getClass().getDeclaredField("this$0")
            f.setAccessible(True)
            _OUTER_FIELDS[outer_key] = f
        alert = f.get(adapter)
        key = str(alert.getClass().getName())
        cache = _ALERT_FIELDS.get(key)
        if cache is None:
            cache = {"sel": _find_field(alert, "selectedId"), "cur": _find_field(alert, "currentAttachLayout")}
            for bid, name in _LAYOUT_FIELDS.items():
                cache[bid] = _find_field(alert, name)
            _ALERT_FIELDS[key] = cache
        if cache["sel"] is not None:
            try:
                _MD3["src"] = "selectedId"
                return int(cache["sel"].get(alert))
            except Exception:
                pass
        _MD3["src"] = "layout"
        if cache["cur"] is None:
            return "unknown"
        cur = cache["cur"].get(alert)
        if cur is None:
            return "unknown"
        for bid, name in _LAYOUT_FIELDS.items():
            fld = cache.get(bid)
            if fld is not None:
                val = fld.get(alert)
                if val is not None and val == cur:
                    return bid
        return None
    except Exception:
        return "unknown"


def _dp(value):
    try:
        return int(AndroidUtilities.dp(value))
    except Exception:
        return int(value * 2.75)


def _apply_md3(plugin, recycler):
    try:
        if recycler is None:
            return
        if not _md3_enabled(plugin):
            if _MD3["orig"]:
                _md3_restore()
            return

        vis = _md3_views(recycler)
        n = len(vis)
        if n == 0:
            if _MD3["orig"]:
                _md3_restore()
            return

        height = int(vis[0].getHeight() or recycler.getHeight() or 0)
        if height <= 0:
            return

        unselected, selected = _md3_colors(recycler)

        sel_bid = _selected_bid(recycler)
        sel_idx = 0
        if sel_bid != "unknown":
            sel_idx = -1
            if sel_bid is not None:
                for i, c in enumerate(vis):
                    if _child_bid(c) == sel_bid:
                        sel_idx = i
                        break

        sig = (tuple(_vid(c) for c in vis), height, unselected, selected, sel_idx, _dp(100))
        if sig == _MD3["sig"]:
            return
        _MD3["sig"] = sig
        _diag(plugin, f"md3: n={n} src={_MD3.get('src')} selected_bid={sel_bid} idx={sel_idx} h={height}")

        gap = _dp(3)
        v_inset = _dp(3)
        full = max(height // 2, 1)
        rect = min(_dp(12), max((height - 2 * v_inset) // 2, 1))

        for idx, c in enumerate(vis):
            vid = _vid(c)
            if vid not in _MD3["orig"]:
                _MD3["orig"][vid] = (c, c.getBackground())

            is_sel = idx == sel_idx
            d = GradientDrawable()
            d.setColor(selected if is_sel else unselected)
            d.setCornerRadius(float(full if is_sel else rect))

            pl, pt, pr, pb = c.getPaddingLeft(), c.getPaddingTop(), c.getPaddingRight(), c.getPaddingBottom()
            if is_sel:
                c.setBackground(InsetDrawable(d, 0, 0, 0, 0))
            else:
                c.setBackground(InsetDrawable(d, gap, v_inset, gap, v_inset))
            if (c.getPaddingLeft(), c.getPaddingTop(), c.getPaddingRight(), c.getPaddingBottom()) != (pl, pt, pr, pb):
                c.setPadding(pl, pt, pr, pb)

        if len(_MD3["orig"]) > 80:
            keep = set(_vid(c) for c in vis)
            for old in list(_MD3["orig"].keys()):
                if old not in keep:
                    pair = _MD3["orig"].pop(old, None)
                    if pair is not None:
                        try:
                            pair[0].setBackground(pair[1])
                        except Exception:
                            pass
    except Exception as e:
        if not _MD3.get("err"):
            _MD3["err"] = True
            tb = " | ".join(traceback.format_exc().strip().splitlines()[-4:])
            _log(plugin, f"md3 error ({BUILD}): {e} :: {tb}")


def _stretch_reset(plugin, recycler):
    if not plugin._stretched:
        return
    plugin._stretched = False
    for i in range(recycler.getChildCount()):
        child = recycler.getChildAt(i)
        if child is None:
            continue
        orig = _ORIG_W.pop(_vid(child), None)
        lp = child.getLayoutParams()
        if orig is not None and lp is not None and lp.width != orig:
            lp.width = orig
            child.setLayoutParams(lp)
        child.forceLayout()
        for j in range(child.getChildCount()):
            child.getChildAt(j).forceLayout()
    recycler.requestLayout()


def _stretch_layout(plugin, recycler):
    if recycler is None:
        return
    vis = []
    for i in range(recycler.getChildCount()):
        c = recycler.getChildAt(i)
        if c is not None and c.getVisibility() == View.VISIBLE:
            vis.append(c)
    n = len(vis)
    pad_l = recycler.getPaddingLeft()
    avail = (recycler.getWidth() or recycler.getMeasuredWidth() or 0) - pad_l - recycler.getPaddingRight()
    cur_w = sum(c.getWidth() for c in vis)

    state = (n, cur_w, avail) if _DIAG["left"] > 0 else None
    if state is not None and state != _DIAG.get("state"):
        _DIAG["state"] = state
        _diag(plugin, f"stretch state: visible={n} width={cur_w} avail={avail} recycler={recycler.getWidth()} pad={pad_l}/{recycler.getPaddingRight()}")

    if n == 0 or avail <= 0:
        return
    if n > STRETCH_MAX:
        _stretch_reset(plugin, recycler)
        return

    now = int(System.currentTimeMillis())
    if now - plugin._stretch_ts > 1000:
        plugin._stretch_ts = now
        plugin._stretch_hits = 0

    w = avail // n
    changed = False
    for c in vis:
        lp = c.getLayoutParams()
        if lp is None:
            continue
        if abs(c.getTranslationX()) > 0.5:
            c.setTranslationX(0)
        if lp.width != w:
            if plugin._stretch_hits > 40:
                return
            _ORIG_W.setdefault(_vid(c), lp.width)
            lp.width = w
            c.setLayoutParams(lp)
            plugin._stretch_hits += 1
            changed = True
        if c.getChildCount() > 0:
            inner = c.getChildAt(0)
            if inner.getLeft() != 0 or inner.getRight() != w:
                if plugin._stretch_hits > 40:
                    return
                inner.layout(0, inner.getTop(), w, inner.getBottom())
                plugin._stretch_hits += 1
                changed = True
    plugin._stretched = True
    if changed:
        _diag(plugin, f"layout n={n} w={w} avail={avail}")
    elif _DIAG["left"] > 0:
        sig = []
        for c in vis:
            kids = []
            for j in range(c.getChildCount()):
                k = c.getChildAt(j)
                kids.append(f"{_class_name(k).split('.')[-1]}:{k.getLeft()}-{k.getRight()}")
            sig.append(f"{c.getLeft()}-{c.getRight()} {kids}")
        sig_text = " | ".join(sig)
        if sig_text != _DIAG.get("detail"):
            _DIAG["detail"] = sig_text
            _diag(plugin, f"buttons: {sig_text}")


def _ensure_adapter_hooks(plugin, recycler):
    if plugin._adapter_seen or plugin._lazy_done:
        return
    adapter = recycler.getAdapter()
    if adapter is None:
        return
    plugin._lazy_done = True
    cls = adapter.getClass()
    _hook(plugin, cls, "notifyDataSetChanged", ButtonsAdapterHook(plugin))
    _hook(plugin, cls, "getItemCount", ButtonsAdapterCountHook(plugin))
    _hook(plugin, cls, "onViewAttachedToWindow", ViewAttachedHook(plugin))
    _diag(plugin, "adapter hooks installed lazily")
    adapter.notifyDataSetChanged()


def _reflow_end(plugin):
    plugin._reflow_queued = False
    plugin._reflow_view = None


def _reflow(plugin, view):
    plugin._reflow_view = view
    if getattr(plugin, "_reflow_queued", False):
        return
    plugin._reflow_queued = True

    def fix():
        if not _alive(plugin):
            return
        try:
            view = plugin._reflow_view
            parent = view.getParent() if view is not None else None
            if parent is None or not hasattr(parent, "getChildCount"):
                return

            _ensure_adapter_hooks(plugin, parent)

            for i in range(parent.getChildCount()):
                child = parent.getChildAt(i)
                if child is None:
                    continue

                if _is_bot_view(child):
                    _apply(child, _hide_bots(plugin))
                    continue

                bid = None
                try:
                    t = child.getTag()
                    bid = int(t) if t is not None else None
                except Exception:
                    bid = None
                if bid is None:
                    try:
                        cid = get_private_field(child, "currentId")
                        if cid is not None:
                            bid = int(cid)
                    except Exception:
                        pass

                _apply(child, _should_hide(plugin, bid, _get_label(child), False))

            _attach_layout(plugin, parent)
            _attach_predraw(plugin, parent)
            try:
                _stretch_layout(plugin, parent)
            except Exception as e:
                _diag(plugin, f"stretch error: {e}")
            _center_remaining(parent)
            _update_container(plugin, parent)
            _apply_md3(plugin, parent)
        except Exception as e:
            _log(plugin, f"reflow: {e}")

    run_on_ui_thread(fix, 30)
    run_on_ui_thread(fix, 150)
    run_on_ui_thread(fix, 350)
    run_on_ui_thread(lambda: _reflow_end(plugin), 360)


def _adapter_fields(adapter):
    cls = adapter.getClass()
    cname = str(cls.getName())
    res = _FIELDS.get(cname)
    if res is not None:
        return res
    res = {}
    for f in cls.getDeclaredFields():
        try:
            if str(f.getType().getName()) != "int":
                continue
            f.setAccessible(True)
            res[str(f.getName())] = f
        except Exception:
            pass
    _FIELDS[cname] = res
    return res


def _compact_settings(plugin):
    return (_hide_bots(plugin),) + tuple(_hide_on(plugin, key) for key in sorted(set(ADAPTER_KEYS.values())))


def _compact_adapter(plugin, adapter, force=True):
    if adapter is None:
        return

    fields = _adapter_fields(adapter)
    count_f = fields.get("buttonsCount")
    if count_f is None:
        return

    key = (_vid(adapter), _compact_settings(plugin))
    if not force and plugin._compact_seen == (key, count_f.getInt(adapter)):
        return

    vals = {n: f.getInt(adapter) for n, f in fields.items()}
    count = vals["buttonsCount"]
    if count <= 0:
        return

    start_n = next((n for n in vals if n.lower().endswith("botsstartrow")), None)
    end_n = next((n for n in vals if n.lower().endswith("botsendrow")), None)

    slots = {}
    for n, v in vals.items():
        if n.endswith("Button") and 0 <= v < count:
            slots[v] = ("btn", n)

    bots_start = -1
    if start_n and end_n:
        s, e = vals[start_n], vals[end_n]
        if 0 <= s < e <= count:
            bots_start = s
            for p in range(s, e):
                slots[p] = ("bot", None)

    hide_bots = _hide_bots(plugin)

    kept = []
    removed = []
    for pos in range(count):
        kind, name = slots.get(pos, ("unknown", None))
        hide = False
        if kind == "bot":
            hide = hide_bots
        elif kind == "btn":
            key = ADAPTER_KEYS.get(name[: -len("Button")].lower())
            hide = bool(key) and _hide_on(plugin, key)
        (removed if hide else kept).append((kind, name))

    if not removed:
        plugin._compact_seen = (key, count)
        return

    new_bots_start = -1
    n_bots = 0
    for new_pos, (kind, name) in enumerate(kept):
        if kind == "btn":
            fields[name].setInt(adapter, new_pos)
        elif kind == "bot":
            if new_bots_start < 0:
                new_bots_start = new_pos
            n_bots += 1
    for kind, name in removed:
        if kind == "btn":
            fields[name].setInt(adapter, -1)

    if bots_start >= 0:
        if n_bots > 0:
            fields[start_n].setInt(adapter, new_bots_start)
            fields[end_n].setInt(adapter, new_bots_start + n_bots)
        else:
            fields[start_n].setInt(adapter, -1)
            fields[end_n].setInt(adapter, -1)

    count_f.setInt(adapter, len(kept))
    plugin._compact_seen = (key, len(kept))


def _fingerprint(recycler):
    try:
        parent = recycler.getParent()
        count = recycler.getChildCount()
        parts = [count, recycler.getWidth(), recycler.getHeight(),
                 parent.getVisibility() if parent is not None else -1]
        for i in range(count):
            c = recycler.getChildAt(i)
            parts.append(None if c is None else (_vid(c), c.getVisibility(), c.getWidth(), c.getLeft()))
        return tuple(parts)
    except Exception:
        return None


def _enforce_bots(plugin, recycler):
    if not _hide_bots(plugin):
        return
    changed = False
    for i in range(recycler.getChildCount()):
        c = recycler.getChildAt(i)
        if c is None or c.getVisibility() != View.VISIBLE:
            continue
        if _is_bot_view(c):
            _hide_view(c)
            changed = True
    if changed:
        _center_remaining(recycler)


if dynamic_proxy is not None:
    class _PreDrawEnforcer(dynamic_proxy(ViewTreeObserver.OnPreDrawListener)):
        def __init__(self, plugin, recycler):
            super().__init__()
            self.plugin = plugin
            self.recycler = recycler

        def onPreDraw(self):
            if not _alive(self.plugin):
                return True
            fp = _fingerprint(self.recycler)
            if fp is not None and fp == self.plugin._pre_fp:
                return True
            try:
                _enforce_bots(self.plugin, self.recycler)
            except Exception:
                pass
            try:
                _stretch_layout(self.plugin, self.recycler)
            except Exception as e:
                _diag(self.plugin, f"stretch error: {e}")
            try:
                _update_container(self.plugin, self.recycler)
            except Exception:
                pass
            self.plugin._pre_fp = _fingerprint(self.recycler)
            return True
else:
    _PreDrawEnforcer = None


def _detach_predraw():
    obs = _PREDRAW["observer"]
    proxy = _PREDRAW["proxy"]
    try:
        if obs is not None and proxy is not None and obs.isAlive():
            obs.removeOnPreDrawListener(proxy)
    except Exception:
        pass
    _PREDRAW["recycler"] = None
    _PREDRAW["observer"] = None
    _PREDRAW["proxy"] = None


def _attach_predraw(plugin, recycler):
    if _PreDrawEnforcer is None or recycler is None:
        return
    try:
        obs = recycler.getViewTreeObserver()
        if obs is None or not obs.isAlive():
            return
        if (
            _PREDRAW["recycler"] is not None
            and _vid(_PREDRAW["recycler"]) == _vid(recycler)
            and _PREDRAW["observer"] is not None
            and _vid(_PREDRAW["observer"]) == _vid(obs)
        ):
            return
        _detach_predraw()
        proxy = _PreDrawEnforcer(plugin, recycler)
        obs.addOnPreDrawListener(proxy)
        _PREDRAW["recycler"] = recycler
        _PREDRAW["observer"] = obs
        _PREDRAW["proxy"] = proxy
    except Exception as e:
        _log(plugin, f"pre-draw attach: {e}")


_LAYOUT = {"recycler": None, "proxy": None, "animator": None}

if dynamic_proxy is not None:
    class _LayoutEnforcer(dynamic_proxy(View.OnLayoutChangeListener)):
        def __init__(self, plugin, recycler):
            super().__init__()
            self.plugin = plugin
            self.recycler = recycler

        def onLayoutChange(self, v, left, top, right, bottom, old_left, old_top, old_right, old_bottom):
            if not _alive(self.plugin):
                return
            try:
                _enforce_bots(self.plugin, self.recycler)
            except Exception:
                pass
            try:
                _stretch_layout(self.plugin, self.recycler)
            except Exception as e:
                _diag(self.plugin, f"stretch error: {e}")
            try:
                _attach_predraw(self.plugin, self.recycler)
            except Exception:
                pass
            try:
                _update_container(self.plugin, self.recycler)
            except Exception:
                pass
            try:
                _apply_md3(self.plugin, self.recycler)
            except Exception:
                pass
else:
    _LayoutEnforcer = None


def _detach_layout():
    recycler = _LAYOUT["recycler"]
    proxy = _LAYOUT["proxy"]
    try:
        if recycler is not None and proxy is not None:
            recycler.removeOnLayoutChangeListener(proxy)
    except Exception:
        pass
    try:
        if recycler is not None and _LAYOUT.get("animator") is not None:
            recycler.setItemAnimator(_LAYOUT["animator"])
    except Exception:
        pass
    _LAYOUT["recycler"] = None
    _LAYOUT["proxy"] = None
    _LAYOUT["animator"] = None


def _attach_layout(plugin, recycler):
    if _LayoutEnforcer is None or recycler is None:
        return
    try:
        cur = _LAYOUT["recycler"]
        if cur is not None and _vid(cur) == _vid(recycler):
            return
        _detach_layout()
        proxy = _LayoutEnforcer(plugin, recycler)
        recycler.addOnLayoutChangeListener(proxy)
        _LAYOUT["recycler"] = recycler
        _LAYOUT["proxy"] = proxy
        _attach_watch(plugin, recycler)
        try:
            _LAYOUT["animator"] = recycler.getItemAnimator()
            recycler.setItemAnimator(None)
        except Exception:
            _LAYOUT["animator"] = None
    except Exception as e:
        _log(plugin, f"layout attach: {e}")


def _sheet_closed(plugin):
    _detach_predraw()
    _detach_layout()
    _md3_restore()
    cur = _CONTAINER["view"]
    _CONTAINER["view"] = None
    if cur is not None:
        try:
            cur.setVisibility(View.VISIBLE)
        except Exception:
            pass
    plugin._pre_fp = None
    plugin._compact_seen = None
    _WATCH["vid"] = None
    _WATCH["proxy"] = None


def _prune_state(recycler):
    live = set()
    for i in range(recycler.getChildCount()):
        child = recycler.getChildAt(i)
        if child is not None:
            live.add(_vid(child))
    for store in (_STATE, _ORIG_W):
        for key in list(store.keys()):
            if key not in live:
                store.pop(key, None)


_WATCH = {"vid": None, "proxy": None}


if dynamic_proxy is not None:
    class _SheetWatcher(dynamic_proxy(View.OnAttachStateChangeListener)):
        def __init__(self, plugin):
            super().__init__()
            self.plugin = plugin

        def onViewAttachedToWindow(self, v):
            pass

        def onViewDetachedFromWindow(self, v):
            if _alive(self.plugin):
                _sheet_closed(self.plugin)
else:
    _SheetWatcher = None


def _attach_watch(plugin, recycler):
    if _SheetWatcher is None or recycler is None:
        return
    try:
        vid = _vid(recycler)
        if _WATCH["vid"] == vid:
            return
        _prune_state(recycler)
        proxy = _SheetWatcher(plugin)
        recycler.addOnAttachStateChangeListener(proxy)
        _WATCH["vid"] = vid
        _WATCH["proxy"] = proxy
    except Exception as e:
        _log(plugin, f"watch attach: {e}")


class HideAttachButtonHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            if not _alive(self.plugin):
                return
            view = param.thisObject
            if view is None:
                return

            args = param.args
            button_id = None
            label = ""
            if args and len(args) >= 1:
                try:
                    button_id = int(args[0])
                except Exception:
                    button_id = None
            if args and len(args) >= 2:
                try:
                    label = str(args[1] or "").strip()
                except Exception:
                    label = ""
            if not label:
                label = _get_label(view)

            _apply(view, _should_hide(self.plugin, button_id, label, False))
            _reflow(self.plugin, view)
        except Exception as e:
            _log(self.plugin, f"std hook: {e}")


class CheckedStateHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            if not _alive(self.plugin):
                return
            if not _md3_enabled(self.plugin):
                return
            view = param.thisObject
            parent = view.getParent() if view is not None else None
            if parent is None:
                return

            def refresh():
                try:
                    if not _alive(self.plugin):
                        return
                    _apply_md3(self.plugin, parent)
                except Exception:
                    pass

            refresh()
            run_on_ui_thread(refresh, 200)
        except Exception as e:
            _log(self.plugin, f"checked hook: {e}")


class HideBotButtonHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            if not _alive(self.plugin):
                return
            view = param.thisObject
            if view is None:
                return
            _apply(view, _hide_bots(self.plugin))
            _reflow(self.plugin, view)
        except Exception as e:
            _log(self.plugin, f"bot hook: {e}")


class ButtonsAdapterHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            if not _alive(self.plugin):
                return
            self.plugin._adapter_seen = True
            _compact_adapter(self.plugin, param.thisObject)
        except Exception as e:
            _log(self.plugin, f"adapter hook: {e}")


class ButtonsAdapterCountHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        try:
            if not _alive(self.plugin):
                return
            self.plugin._adapter_seen = True
            _compact_adapter(self.plugin, param.thisObject, False)
        except Exception as e:
            _log(self.plugin, f"adapter count hook: {e}")


class ViewAttachedHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            if not _alive(self.plugin):
                return
            view = param.args[0].itemView
            if view is not None and _is_bot_view(view) and _hide_bots(self.plugin):
                _hide_view(view)
                _reflow(self.plugin, view)
        except Exception as e:
            _log(self.plugin, f"attach hook: {e}")


def _hook(plugin, cls, name, hook):
    try:
        plugin.hook_all_methods(cls, name, hook)
    except Exception as e:
        if "getName" not in str(e):
            _log(plugin, f"hook {name}: {e}")


class HideAttachButtonsPlugin(BasePlugin):
    def on_plugin_load(self):
        self._token = f"{int(System.currentTimeMillis())}-{id(self)}"
        System.setProperty(TOKEN_KEY, self._token)
        self._gen = 0
        self._stretched = False
        self._stretch_err = False
        self._adapter_seen = False
        self._lazy_done = False
        self._stretch_ts = 0
        self._stretch_hits = 0
        self._pre_fp = None
        self._compact_seen = None
        self._reflow_queued = False
        self._reflow_view = None
        _LOG_SEEN.clear()
        _WATCH["vid"] = None
        _DIAG["left"] = 30
        _DIAG["detail"] = False
        _ORIG_W.clear()
        _STATE.clear()
        _MD3["orig"].clear()
        _MD3["sig"] = None
        _MD3["err"] = False
        _ALERT_FIELDS.clear()
        _log(self, f"build {BUILD}")
        self._install_hooks()

    def on_plugin_unload(self):
        self._gen = -1
        try:
            if str(System.getProperty(TOKEN_KEY)) == self._token:
                System.setProperty(TOKEN_KEY, "off")
        except Exception:
            pass
        try:
            cur = _CONTAINER.get("view")
            if cur is not None:
                cur.setVisibility(View.VISIBLE)
                cur.requestLayout()
        except Exception:
            pass
        _CONTAINER["view"] = None
        _md3_restore()
        _detach_predraw()
        _detach_layout()
        _STATE.clear()
        _FIELDS.clear()
        _ORIG_W.clear()
        _DIAG["left"] = 30

    def _install_hooks(self):
        AttachButton = find_class("org.telegram.ui.Components.ChatAttachAlert$AttachButton")
        AttachBotButton = find_class("org.telegram.ui.Components.ChatAttachAlert$AttachBotButton")
        ButtonsAdapter = find_class("org.telegram.ui.Components.ChatAttachAlert$ButtonsAdapter")

        if ButtonsAdapter is not None:
            _hook(self, ButtonsAdapter, "notifyDataSetChanged", ButtonsAdapterHook(self))
            _hook(self, ButtonsAdapter, "getItemCount", ButtonsAdapterCountHook(self))
            _hook(self, ButtonsAdapter, "onViewAttachedToWindow", ViewAttachedHook(self))
        else:
            _log(self, "ButtonsAdapter not found")

        if AttachButton is not None:
            _hook(self, AttachButton, "setTextAndIcon", HideAttachButtonHook(self))
            _hook(self, AttachButton, "updateCheckedState", CheckedStateHook(self))
        else:
            _log(self, "AttachButton not found")

        if AttachBotButton is not None:
            for method_name in ("setUser", "setAttachBot"):
                _hook(self, AttachBotButton, method_name, HideBotButtonHook(self))
        else:
            _log(self, "AttachBotButton not found")

    def create_settings(self) -> List[Any]:
        return [
            Header(text="Стандартные кнопки"),
            Switch(key="hide_gallery", text="Скрыть «Галерея»", default=False, icon="msg_hide"),
            Switch(key="hide_music", text="Скрыть «Музыка»", default=False, icon="msg_hide"),
            Switch(key="hide_document", text="Скрыть «Файл»", default=False, icon="msg_hide"),
            Switch(key="hide_contact", text="Скрыть «Контакт»", default=False, icon="msg_hide"),
            Switch(key="hide_location", text="Скрыть «Геопозиция»", default=False, icon="msg_hide"),
            Switch(key="hide_poll", text="Скрыть «Опрос»", default=False, icon="msg_hide"),
            Switch(key="hide_quick_replies", text="Скрыть «Быстрые ответы»", default=False, icon="msg_hide"),
            Switch(key="hide_article", text="Скрыть «Статья»", default=False, icon="msg_hide"),
            Switch(key="hide_list", text="Скрыть «Список»", default=False, icon="msg_hide"),
            Divider(),
            Header(text="Боты и мини-приложения"),
            Switch(
                key="hide_all_bots",
                text="Скрыть ВСЕ боты",
                default=False,
                subtext="Скрывает все кнопки ботов в панели",
                icon="msg_bots",
            ),
            Divider(),
            Header(text="Стиль"),
            Switch(
                key="md3_style",
                text="Material Design 3",
                default=False,
                subtext="Отдельные сегменты с зазором: выбранная кнопка — овал цвета акцента темы, остальные — тонированные скруглённые прямоугольники",
                icon="msg_settings",
            ),
        ]
