# ------------------------------------------------------------------
# Хук 5: ProfileActivity.updateProfileData — строка "номер • @юзернейм" под именем
# ------------------------------------------------------------------
class ProfileHeaderHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            fake_user, fake_phone = get_fakes(self.plugin)
            if not fake_user and not fake_phone:
                return
            STATS["head_calls"] += 1
            real_user, real_phone = real_values()
            act = param.thisObject
            STATS["head_done"] += scan_text_fields(act, fake_user, fake_phone, real_user, real_phone)
            root = act.getFragmentView()
            if root is not None:
                STATS["head_done"] += scan_tree(root, fake_user, fake_phone, real_user, real_phone)

            def rescan():
                try:
                    r = act.getFragmentView()
                    if r is not None:
                        STATS["head_done"] += scan_tree(r, fake_user, fake_phone, real_user, real_phone)
                except Exception as e2:
                    STATS["error"] = "rescan: " + str(e2)

            if run_on_ui_thread is not None:
                try:
                    run_on_ui_thread(rescan, 100)
                    run_on_ui_thread(rescan, 400)
                except Exception as e3:
                    STATS["error"] = "ui_thread: " + str(e3)
        except Exception as e:
            STATS["error"] = "header: " + str(e)


# ------------------------------------------------------------------
# Плагин
# ------------------------------------------------------------------
class FakeUsernamePlugin(BasePlugin):

    def __init__(self):
        super().__init__()
        self.hook_refs = []

    def on_plugin_load(self):
        STATS["hooks"] = []
        if not hasattr(self, "hook_refs"):
            self.hook_refs = []
        self._hook_class("org.telegram.ui.Cells.TextDetailCell", "setTextAndValue", None, lambda: DetailCellHook(self))
        self._hook_class("org.telegram.ui.ProfileActivity$ListAdapter", "onBindViewHolder", 2, lambda: ProfileBindHook(self))
        self._hook_class("org.telegram.ui.ProfileActivity", "updateProfileData", None, lambda: ProfileHeaderHook(self))
        for cname in DRAWER_CELL_CLASSES:
            if self._hook_class(cname, "setUser", None, lambda: DrawerHook(self)):
                break
        for cname in DRAWER_ADAPTER_CLASSES:
            if self._hook_class(cname, "onBindViewHolder", 2, lambda: DrawerBindHook(self)):
                break

    def on_plugin_unload(self):
        for ref in self.hook_refs:
            try:
                self.unhook_method(ref)
            except Exception as e:
                log("[FakeUsername] unload error: " + str(e))
        self.hook_refs = []

    def _hook_class(self, class_name, method_name, nparams, factory):
        short = class_name.split(".")[-1] + "." + method_name
        try:
            cls = find_class(class_name)
            if not cls:
                STATS["hooks"].append(short + ": класс не найден")
                return False
            methods = find_methods(cls, method_name, nparams)
            if not methods:
                STATS["hooks"].append(short + ": метод не найден")
                return False
            ok = 0
            for m in methods:
                try:
                    m.setAccessible(True)
                    ref = self.hook_method(m, factory())
                    self.hook_refs.append(ref)
                    ok += 1
                except Exception as e:
                    STATS["hooks"].append(short + ": ошибка " + str(e))
            if ok:
                STATS["hooks"].append(short + ": OK (" + str(ok) + ")")
                return True
            return False
        except Exception as e:
            STATS["hooks"].append(short + ": ошибка " + str(e))
            return False

    # ------------------------------------------------------------------
    # Обновление интерфейса
    # ------------------------------------------------------------------
    def _refresh_ui(self):
        try:
            NotificationCenter.getGlobalInstance().postNotificationName(NotificationCenter.mainUserInfoChanged)
        except Exception as e:
            STATS["error"] = "refresh: " + str(e)
            try:
                act = LaunchActivity.instance
                adapter = get_private_field(act, "drawerLayoutAdapter")
                adapter.notifyDataSetChanged()
            except Exception as e2:
                STATS["error"] = "refresh2: " + str(e2)

    # ------------------------------------------------------------------
    # Настройки
    # ------------------------------------------------------------------
    def create_settings(self):
        items = []
        try:
            user = fmt_username(self.get_setting(KEY_USER, "")) or S_NOT_SET
            phone = clean_phone(self.get_setting(KEY_PHONE, "")) or S_NOT_SET
            items.append(Header(text=S_HEADER))
            items.append(Text(text=S_USER_LABEL + ": " + user, icon="msg_edit", on_click=lambda *args: self._show_edit_dialog()))
            items.append(Text(text=S_PHONE_LABEL + ": " + phone, icon="msg_calls", on_click=lambda *args: self._show_edit_dialog()))
            items.append(Text(text=S_RESET_ALL, icon="msg_delete", on_click=lambda *args: self._reset_all()))
            items.append(Text(text=S_DIAG, icon="msg_info", on_click=lambda *args: self._show_diag()))
        except Exception as e:
            items.append(Header(text=S_ERR + str(e)))
        return items

    def _show_diag(self):
        act = LaunchActivity.instance
        if not act:
            return
        real_user, real_phone = real_values()
        lines = []
        lines.append(S_HOOKS)
        for h in STATS["hooks"]:
            lines.append("  " + h)
        if real_user:
            lines.append(S_REAL_USER + S_YES)
        else:
            lines.append(S_REAL_USER + S_NO)
        if real_phone:
            lines.append(S_REAL_PHONE + S_YES)
        else:
            lines.append(S_REAL_PHONE + S_NO)
        lines.append(S_CALLS + ":")
        lines.append("  cell: " + str(STATS["cell_calls"]) + " / " + str(STATS["cell_done"]))
        lines.append("  bind: " + str(STATS["bind_calls"]) + " / " + str(STATS["bind_done"]))
        lines.append("  drawer: " + str(STATS["drawer_calls"]) + " / " + str(STATS["drawer_done"]))
        lines.append("  header: " + str(STATS["head_calls"]) + " / " + str(STATS["head_done"]))
        for sn in STATS["seen"]:
            lines.append("  seen: " + sn)
        err = STATS["error"] or S_NONE
        lines.append(S_LAST_ERR + err)

        tv = TextView(act)
        tv.setText("\n".join(lines))
        tv.setTextSize(13.0)
        tv.setTextColor(theme_colors()[0])
        tv.setPadding(AndroidUtilities.dp(20), AndroidUtilities.dp(8), AndroidUtilities.dp(20), AndroidUtilities.dp(8))
        try:
            tv.setTextIsSelectable(True)
        except Exception:
            pass

        builder = AlertDialogBuilder(act)
        builder.set_title(S_DIAG)
        builder.set_view(tv)
        builder.set_positive_button(S_CLOSE, lambda b, w: b.dismiss())
        builder.show()

    def _show_edit_dialog(self):
        act = LaunchActivity.instance
        if not act:
            return

        cur_user = str(self.get_setting(KEY_USER, "") or "")
        cur_phone = str(self.get_setting(KEY_PHONE, "") or "")

        container = LinearLayout(act)
        container.setOrientation(LinearLayout.VERTICAL)
        container.setPadding(AndroidUtilities.dp(20), AndroidUtilities.dp(8), AndroidUtilities.dp(20), AndroidUtilities.dp(8))

        hint = TextView(act)
        hint.setText(S_DLG_HINT)
        hint.setTextSize(13.0)
        hint.setTextColor(theme_colors()[1])
        hint.setPadding(0, 0, 0, AndroidUtilities.dp(8))
        container.addView(hint)

        edit_user = EditText(act)
        edit_user.setInputType(InputType.TYPE_CLASS_TEXT)
        edit_user.setHint(S_USER_HINT)
        edit_user.setText(cur_user)
        edit_user.setTextColor(theme_colors()[0])
        edit_user.setHintTextColor(theme_colors()[1])
        container.addView(edit_user)

        edit_phone = EditText(act)
        edit_phone.setInputType(InputType.TYPE_CLASS_TEXT)
        edit_phone.setHint(S_PHONE_HINT)
        edit_phone.setText(cur_phone)
        edit_phone.setTextColor(theme_colors()[0])
        edit_phone.setHintTextColor(theme_colors()[1])
        container.addView(edit_phone)

        def on_save(b, w):
            try:
                self.set_setting(KEY_USER, str(edit_user.getText()).strip())
                self.set_setting(KEY_PHONE, str(edit_phone.getText()).strip())
                self._refresh_ui()
                BulletinHelper.show_success(S_SAVED)
            except Exception as ex:
                BulletinHelper.show_error(S_ERR + str(ex))
            b.dismiss()

        builder = AlertDialogBuilder(act)
        builder.set_title(S_DLG_TITLE)
        builder.set_view(container)
        builder.set_positive_button(S_SAVE, on_save)
        builder.set_negative_button(S_CANCEL, lambda b, w: b.dismiss())
        builder.show()

    def _reset_all(self):
        self.set_setting(KEY_USER, "")
        self.set_setting(KEY_PHONE, "")
        self._refresh_ui()
        BulletinHelper.show_info(S_RESET_DONE)
