from android.text import InputType
from android.view import ViewGroup
from org.telegram.ui.ActionBar import Theme
import re

try:
    from android_utils import run_on_ui_thread
except Exception:
    run_on_ui_thread = None

KEY_USER = "fake_username"
KEY_PHONE = "fake_phone"

S_HEADER = "Визуальный профиль"
S_USER_LABEL = "Юзернейм"
S_PHONE_LABEL = "Номер телефона"
S_NOT_SET = "не задан"
S_RESET_ALL = "Сбросить всё"
S_DIAG = "Диагностика"
S_IMPORTANT = "Важно"
S_INFO = "Изменения видны только вам. Реальные данные аккаунта не меняются."
S_DLG_TITLE = "Визуальный профиль"
S_DLG_HINT = "Любой текст, без ограничений. Пустое поле — показывать настоящее значение."
S_USER_HINT = "Юзернейм, например: durov"
S_PHONE_HINT = "Номер, например: +7 999 123-45-67"
S_SAVE = "Сохранить"
S_CANCEL = "Отмена"
S_CLOSE = "Закрыть"
S_SAVED = "Сохранено. Если не обновилось, переоткройте профиль"
S_RESET_DONE = "Всё сброшено"
S_ERR = "Ошибка: "
S_HOOKS = "Хуки:"
S_REAL_USER = "Настоящий юзернейм найден: "
S_REAL_PHONE = "Настоящий номер найден: "
S_YES = "да"
S_NO = "нет"
S_CALLS = "Вызовов / замен"
S_LAST_ERR = "Последняя ошибка: "
S_NONE = "нет"

DRAWER_CELL_CLASSES = ["org.telegram.ui.Cells.DrawerProfileCell", "org.telegram.ui.Components.DrawerProfileCell", "org.telegram.ui.DrawerProfileCell"]
DRAWER_ADAPTER_CLASSES = ["org.telegram.ui.Adapters.DrawerLayoutAdapter", "org.telegram.ui.Components.DrawerLayoutAdapter", "org.telegram.ui.DrawerLayoutAdapter"]

PHONE_CHARS = "+0123456789 ()-"

STATS = {"cell_calls": 0, "cell_done": 0, "bind_calls": 0, "bind_done": 0, "drawer_calls": 0, "drawer_done": 0, "head_calls": 0, "head_done": 0, "error": "", "hooks": [], "seen": []}


# ------------------------------------------------------------------
# Утилиты
# ------------------------------------------------------------------
def fmt_username(raw):
    raw = str(raw or "").strip()
    if not raw:
        return ""
    if raw.startswith("@"):
        return raw
    return "@" + raw


def clean_phone(raw):
    return str(raw or "").strip()


def digits_of(text):
    out = ""
    for ch in str(text or ""):
        if ch.isdigit():
            out += ch
    return out


def looks_like_phone(text):
    t = str(text or "").strip()
    if not t:
        return False
    has_digit = False
    for ch in t:
        if ch not in PHONE_CHARS:
            return False
        if ch.isdigit():
            has_digit = True
    return has_digit


def real_values():
    # настоящие юзернейм и номер текущего аккаунта
    real_user = ""
    real_phone = ""
    try:
        user = UserConfig.getInstance(UserConfig.selectedAccount).getCurrentUser()
        if user is not None:
            try:
                x = user.username
                if x:
                    real_user = str(x)
            except Exception:
                pass
            try:
                p = user.phone
                if p:
                    real_phone = digits_of(str(p))
            except Exception:
                pass
    except Exception as e:
        STATS["error"] = "real_values: " + str(e)
    return real_user, real_phone


def classify(text, real_user, real_phone):
    t = str(text or "").strip()
    if not t:
        return None
    if real_user:
        low = t.lower()
        ru = real_user.lower()
        if low == "@" + ru or low == ru:
            return "user"
    if real_phone and looks_like_phone(t) and digits_of(t) == real_phone:
        return "phone"
    return None


def set_tv_text(tv, text):
    # AnimatedTextView принимает (text, animated), обычный TextView — только text
    try:
        tv.setText(text, False)
        return
    except Exception:
        pass
    tv.setText(text)


def scan_and_replace(view, fake_user, fake_phone, real_user, real_phone):
    done = 0
    try:
        if isinstance(view, ViewGroup):
            for i in range(view.getChildCount()):
                done += scan_and_replace(view.getChildAt(i), fake_user, fake_phone, real_user, real_phone)
            return done
        try:
            cur = str(view.getText())
        except Exception:
            return 0
        kind = classify(cur, real_user, real_phone)
        if kind == "user" and fake_user:
            set_tv_text(view, fake_user)
            done += 1
        elif kind == "phone" and fake_phone:
            set_tv_text(view, fake_phone)
            done += 1
    except Exception as e:
        STATS["error"] = "scan: " + str(e)
    return done


def replace_in_text(text, fake_user, fake_phone, real_user, real_phone):
    s = str(text)
    changed = False
    if fake_user and real_user:
        pat = re.compile("@" + re.escape(real_user), re.IGNORECASE)
        if pat.search(s):
            s = pat.sub(lambda m: fake_user, s)
            changed = True
    if fake_phone and real_phone:
        pat2 = re.compile(r"\+?\d[\d\s\-()]{4,}\d")
        def _sub(m):
            if digits_of(m.group(0)) == real_phone:
                return fake_phone
            return m.group(0)
        s2 = pat2.sub(_sub, s)
        if s2 != s:
            s = s2
            changed = True
    return s, changed


def fix_text_view(tv, fake_user, fake_phone, real_user, real_phone):
    try:
        cur = tv.getText()
    except Exception:
        return 0
    if cur is None:
        return 0
    s = str(cur)
    if real_phone and real_phone in digits_of(s) and len(STATS["seen"]) < 6:
        try:
            STATS["seen"].append(str(tv.getClass().getName()) + " [" + s[:40] + "]")
        except Exception:
            pass
    new_text, changed = replace_in_text(s, fake_user, fake_phone, real_user, real_phone)
    if changed:
        set_tv_text(tv, new_text)
        return 1
    return 0


def scan_tree(view, fake_user, fake_phone, real_user, real_phone):
    done = 0
    try:
        if isinstance(view, ViewGroup):
            for i in range(view.getChildCount()):
                done += scan_tree(view.getChildAt(i), fake_user, fake_phone, real_user, real_phone)
            return done
        done += fix_text_view(view, fake_user, fake_phone, real_user, real_phone)
    except Exception as e:
        STATS["error"] = "tree: " + str(e)
    return done


def scan_text_fields(obj, fake_user, fake_phone, real_user, real_phone):
    # перебираем поля вида SimpleTextView / SimpleTextView[] / AnimatedTextView у объекта
    done = 0
    try:
        fields = obj.getClass().getDeclaredFields()
    except Exception:
        return 0
    for i in range(len(fields)):
        try:
            f = fields[i]
            tname = str(f.getType().getName())
            if "TextView" not in tname:
                continue
            f.setAccessible(True)
            val = f.get(obj)
            if val is None:
                continue
            if tname.startswith("["):
                for j in range(len(val)):
                    el = val[j]
                    if el is not None:
                        done += fix_text_view(el, fake_user, fake_phone, real_user, real_phone)
            else:
                done += fix_text_view(val, fake_user, fake_phone, real_user, real_phone)
        except Exception as e:
            STATS["error"] = "fields: " + str(e)
    return done


def find_methods(cls_obj, name, nparams=None):
    for variant in (0, 1):
        try:
            holder = cls_obj if variant == 0 else cls_obj.getClass()
            ms = holder.getDeclaredMethods()
        except Exception:
            continue
        found = []
        for i in range(len(ms)):
            m = ms[i]
            try:
                if str(m.getName()) != name:
                    continue
                if nparams is not None and int(m.getParameterCount()) != nparams:
                    continue
                found.append(m)
            except Exception:
                continue
        if found:
            return found
    return []


def theme_colors():
    # белый текст на тёмной теме, тёмный на светлой
    try:
        dark = bool(Theme.isCurrentThemeDark())
    except Exception:
        dark = True
    if dark:
        return -1, -1711276033
    return -16777216, -1728053248


def get_fakes(plugin):
    fake_user = fmt_username(plugin.get_setting(KEY_USER, ""))
    fake_phone = clean_phone(plugin.get_setting(KEY_PHONE, ""))
    return fake_user, fake_phone


# ------------------------------------------------------------------
# Хук 1: TextDetailCell.setTextAndValue — строки профиля/настроек
# ------------------------------------------------------------------
class DetailCellHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        try:
            fake_user, fake_phone = get_fakes(self.plugin)
            if not fake_user and not fake_phone:
                return
            STATS["cell_calls"] += 1
            first = param.args[0]
            if first is None:
                return
            real_user, real_phone = real_values()
            kind = classify(str(first), real_user, real_phone)
            if kind == "user" and fake_user:
                param.args[0] = fake_user
                STATS["cell_done"] += 1
            elif kind == "phone" and fake_phone:
                param.args[0] = fake_phone
                STATS["cell_done"] += 1
        except Exception as e:
            STATS["error"] = "cell: " + str(e)
            log("[FakeUsername] cell hook error: " + str(e))


# ------------------------------------------------------------------
# Хук 2: ProfileActivity$ListAdapter.onBindViewHolder — запасной
# ------------------------------------------------------------------
class ProfileBindHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            fake_user, fake_phone = get_fakes(self.plugin)
            if not fake_user and not fake_phone:
                return
            STATS["bind_calls"] += 1
            real_user, real_phone = real_values()
            view = param.args[0].itemView
            STATS["bind_done"] += scan_and_replace(view, fake_user, fake_phone, real_user, real_phone)
        except Exception as e:
            STATS["error"] = "bind: " + str(e)
            log("[FakeUsername] bind hook error: " + str(e))


# ------------------------------------------------------------------
# Хук 3: DrawerProfileCell.setUser — шапка бокового меню
# ------------------------------------------------------------------
class DrawerHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            fake_user, fake_phone = get_fakes(self.plugin)
            if not fake_user and not fake_phone:
                return
            STATS["drawer_calls"] += 1
            real_user, real_phone = real_values()
            STATS["drawer_done"] += scan_and_replace(param.thisObject, fake_user, fake_phone, real_user, real_phone)
        except Exception as e:
            STATS["error"] = "drawer: " + str(e)
            log("[FakeUsername] drawer hook error: " + str(e))


# ------------------------------------------------------------------
# Хук 4: DrawerLayoutAdapter.onBindViewHolder — запасной для меню
# ------------------------------------------------------------------
class DrawerBindHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            fake_user, fake_phone = get_fakes(self.plugin)
