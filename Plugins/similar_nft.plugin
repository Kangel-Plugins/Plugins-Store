def _detect_lang() -> str:
    code = ""
    try:
        from org.telegram.messenger import LocaleController
        lc = LocaleController.getInstance()
        try:
            code = str(lc.getCurrentLocale().getLanguage())
        except Exception:
            code = str(lc.currentLocale.getLanguage())
    except Exception:
        code = ""
    if not code:
        try:
            from java.util import Locale
            code = str(Locale.getDefault().getLanguage())
        except Exception:
            code = "ru"
    code = code.lower()[:2]
    if code in ("ru", "be"):
        return "ru"
    if code == "uk":
        return "uk"
    return "en"


def _set_lang(setting: Any) -> None:
    try:
        i = int(setting)
    except Exception:
        i = 0
    _LANG[0] = {1: "ru", 2: "en", 3: "uk"}.get(i) or _detect_lang()


def tr(key: str, *args: Any) -> str:
    row = _T.get(key)
    if row is None:
        return key
    txt = row[_LANG_IDX.get(_LANG[0], 0)]
    return (txt % args) if args else txt


def _cap(s: str) -> str:
    return s[:1].upper() + s[1:]


def _sort_labels() -> List[str]:
    return [tr("sort_%d" % i) for i in range(4)]


def _filter_labels() -> List[str]:
    return [tr("f_model"), tr("f_backdrop"), tr("f_pattern")]


def _cur_labels() -> List[str]:
    return [tr("cur_%d" % i) for i in range(3)]


def _lg(msg: Any) -> None:
    try:
        _alog("[SimilarNFT] " + str(msg))
    except Exception:
        pass


def _dbg(msg: Any) -> None:
    """log + keep in a ring buffer that can be copied from the plugin settings"""
    try:
        _DEBUG.append("%s %s" % (time.strftime("%H:%M:%S"), msg))
        if len(_DEBUG) > 250:
            del _DEBUG[:50]
    except Exception:
        pass
    _lg(msg)


def _sgn(v: int) -> int:
    v &= 0xFFFFFFFF
    return v - (1 << 32) if v & 0x80000000 else v


def argb(a: int, r: int, g: int, b: int) -> int:
    return _sgn((a << 24) | (r << 16) | (g << 8) | b)


def rgb24(c: int, alpha: int = 255) -> int:
    return _sgn((alpha << 24) | (int(c) & 0xFFFFFF))


def dp(v: float) -> int:
    return int(AndroidUtilities.dp(float(v)))


def _to_int(v: Any, d: int = 0) -> int:
    try:
        return int(v)
    except Exception:
        return d


def _num(v: Any, d: int = 0) -> int:
    """int() that also understands boxed java.lang.Number objects."""
    try:
        return int(v)
    except Exception:
        pass
    try:
        return int(v.longValue())
    except Exception:
        return d


def _kind(class_name: str) -> str:
    """Normalised simple class name: 'TL_stars$TL_starGiftUnique' -> 'stargiftunique'."""
    n = class_name.replace("$", ".").split(".")[-1].lower().replace("_", "")
    if n.startswith("tl") and len(n) > 2:
        n = n[2:]
    return n


def _obj_kind(o: Any) -> str:
    try:
        return _kind(o.getClass().getName())
    except Exception:
        return ""


def _is_dark() -> bool:
    try:
        from org.telegram.ui.ActionBar import Theme
        return bool(Theme.isCurrentThemeDark())
    except Exception:
        return True


def _activity() -> Any:
    try:
        from org.telegram.ui import LaunchActivity
        inst = LaunchActivity.instance
        if inst is not None:
            return inst
    except Exception:
        pass
    try:
        frag = get_last_fragment()
        if frag is not None:
            act = frag.getParentActivity()
            if act is not None:
                return act
    except Exception:
        pass
    return None


_JCLS_CACHE: Dict[str, Any] = {}


def _is_class_obj(c: Any) -> bool:
    """True for a real java.lang.Class instance (find_class may return a Chaquopy *type object*)."""
    try:
        return hasattr(c, "getDeclaredMethods") and hasattr(c, "getDeclaredClasses") and hasattr(c, "getName")
    except Exception:
        return False


def _jcls(name: str) -> Any:
    """java.lang.Class for `name`, or None. Works whatever find_class() returns."""
    if name in _JCLS_CACHE:
        return _JCLS_CACHE[name]
    res = None
    try:
        c = find_class(name)
        if c is not None and _is_class_obj(c):
            res = c
    except Exception:
        res = None
    if res is None:
        loaders = []
        try:
            from org.telegram.messenger import ApplicationLoader
            loaders.append(ApplicationLoader.applicationContext.getClassLoader())
        except Exception:
            pass
        try:
            a = _activity()
            if a is not None:
                loaders.append(a.getClassLoader())
        except Exception:
            pass
        for ld in loaders:
            try:
                res = ld.loadClass(name)
                if res is not None:
                    break
            except Exception:
                res = None
    if res is None:
        try:
            res = jclass("java.lang.Class").forName(name)
        except Exception:
            res = None
    if res is not None:
        _JCLS_CACHE[name] = res
    return res


def _method0(c: Any, name: str) -> Any:
    """declared no-arg method `name` of java.lang.Class `c` (searches superclasses too)"""
    k = c
    while k is not None:
        try:
            for m in k.getDeclaredMethods():
                try:
                    if str(m.getName()) == name and len(m.getParameterTypes()) == 0:
                        m.setAccessible(True)
                        return m
                except Exception:
                    continue
            k = k.getSuperclass()
        except Exception:
            return None
    return None


def _get_field(obj: Any, name: str) -> Any:
    """Read a (private) Java field, walking up the class hierarchy."""
    try:
        k = obj.getClass()
    except Exception:
        return None
    while k is not None:
        try:
            f = k.getDeclaredField(name)
            f.setAccessible(True)
            return f.get(obj)
        except Exception:
            try:
                k = k.getSuperclass()
            except Exception:
                return None
    return None


def _account_of(dialog: Any) -> int:
    v = _get_field(dialog, "currentAccount")
    if v is not None:
        n = _num(v, -1)
        if 0 <= n < 10:
            return n
    try:
        return int(UserConfig.selectedAccount)
    except Exception:
        return 0


def _toast(msg: str) -> None:
    try:
        BulletinHelper.show_info(msg)
    except Exception:
        _lg(msg)


def _sys_toast(ctx: Any, msg: str) -> None:
    """Android toast: unlike bulletins it is visible above dialogs / bottom sheets."""
    try:
        Toast.makeText(ctx, msg, 0).show()
    except Exception:
        _toast(msg)


def _copy(ctx: Any, text: str) -> bool:
    try:
        copy_to_clipboard(text)
        return True
    except Exception:
        pass
    try:
        from android.content import ClipData
        cm = ctx.getSystemService("clipboard")
        cm.setPrimaryClip(ClipData.newPlainText("nft", text))
        return True
    except Exception as e:
        _lg("copy failed: %s" % e)
        return False


def _err_text(error: Any) -> str:
    try:
        t = str(getattr(error, "text", "") or "")
    except Exception:
        t = ""
    if not t:
        t = str(error)
    if t.startswith("FLOOD_WAIT_") or t.startswith("FLOOD_PREMIUM_WAIT_"):
        sec = t.rsplit("_", 1)[-1]
        return tr("err_many", sec)
    if not t.strip():
        return tr("err_conn")
    return t


# ---------------------------------------------------------------------------
# Java <-> Telegram TL discovery (class names differ between builds, so we
# resolve everything by reflection instead of hard-coding).
# ---------------------------------------------------------------------------
def _find_tl(names) -> Any:
    key = tuple(names)
    if key in _TL_CLASSES:
        return _TL_CLASSES[key]
    found = None
    for cname in _TL_CONTAINERS:
        try:
            c = _jcls(cname)
            if c is None:
                continue
            inner = c.getDeclaredClasses()
        except Exception:
            continue
        for k in inner:
            try:
                if _kind(k.getName()) in key:
                    found = jclass(k.getName())
                    break
            except Exception:
                continue
        if found is not None:
            break
    if found is not None:  # do not cache misses: a later call may still succeed
        _TL_CLASSES[key] = found
    return found


_TRAVERSE_PREFIX = (
    "org.telegram.tgnet.",
    "org.telegram.messenger.MessageObject",
    "org.telegram.ui.Stars.",
    "org.telegram.ui.Gifts.",
)
_STOP_PREFIX = ("android.", "java.", "javax.", "kotlin.", "org.telegram.ui.ActionBar.BottomSheet")
_BAD_WORDS = ("Controller", "Storage", "Config", "Adapter", "Cell", "Fragment")


def find_unique_gift(root: Any, max_nodes: int = 700, max_depth: int = 6) -> Any:
    """Breadth-first reflective search for a starGiftUnique object inside `root`."""
    if root is None:
        return None
    try:
        Modifier = jclass("java.lang.reflect.Modifier")
    except Exception:
        return None
    seen = set()
    queue = [(root, 0)]
    nodes = 0
    while queue and nodes < max_nodes:
        obj, depth = queue.pop(0)
        try:
            ident = int(System.identityHashCode(obj))
            if ident in seen:
                continue
            seen.add(ident)
            nodes += 1
            cls = obj.getClass()
            cname = str(cls.getName())
            if _kind(cname) == "stargiftunique":
                return obj
            if depth >= max_depth:
                continue
            if cname.startswith("java.") or any(w in cname for w in _BAD_WORDS):
                continue
            if depth > 0 and cname.startswith("org.telegram.ui.") and "StarGiftSheet" not in cname:
                continue
            k = cls
            while k is not None:
                kn = str(k.getName())
                if kn.startswith(_STOP_PREFIX):
                    break
                for f in k.getDeclaredFields():
                    try:
                        if Modifier.isStatic(f.getModifiers()):
                            continue
                        t = f.getType()
                        if t.isPrimitive():
                            continue
                        tn = str(t.getName())
                        is_list = tn in ("java.util.ArrayList", "java.util.List")
                        if not (is_list or tn.startswith(_TRAVERSE_PREFIX) or tn == "java.lang.Object"):
                            continue
                        f.setAccessible(True)
                        v = f.get(obj)
                        if v is None or isinstance(v, (str, int, float, bool)):
                            continue
                        if is_list:
                            if depth <= 2:
                                for li in range(min(int(v.size()), 12)):
                                    el = v.get(li)
                                    if el is not None and str(el.getClass().getName()).startswith(_TRAVERSE_PREFIX):
                                        queue.append((el, depth + 1))
                            continue
                        queue.append((v, depth + 1))
                    except Exception:
                        continue
                k = k.getSuperclass()
        except Exception:
            continue
    return None


_NUM_TAIL = re.compile(r"^(.*?)\s*#\s*(\d[\d\s,.\u00a0\u202f]*)$", re.S)


def _iter_views(root: Any, limit: int = 700):
    stack = [root]
    n = 0
    while stack and n < limit:
        v = stack.pop()
        n += 1
        yield v
        try:
            cnt = int(v.getChildCount())
        except Exception:
            continue
        for i in range(cnt - 1, -1, -1):
            try:
                stack.append(v.getChildAt(i))
            except Exception:
                pass


def _view_text(v: Any) -> str:
    try:
        t = v.getText()
    except Exception:
        return ""
    try:
        return str(t) if t is not None else ""
    except Exception:
        return ""


def slug_from_ui(root: Any) -> Optional[str]:
    """NFT sheets show 'Title #12,117'; the public slug is 'Title-12117' (letters/digits only)."""
    prev = ""
    try:
        for v in _iter_views(root):
            t = _view_text(v).strip().replace("\n", " ")
            if not t or len(t) > 80:
                continue
            m = _NUM_TAIL.match(t)
            if m:
                title = m.group(1).strip() or prev
                digits = re.sub(r"\D", "", m.group(2))
                base = re.sub(r"[^A-Za-z0-9]", "", title)
                if base and digits:
                    return "%s-%s" % (base, digits)
            elif re.search(r"[A-Za-z]", t):
                prev = t
    except Exception as e:
        _dbg("slug_from_ui error: %s" % e)
    return None


def fetch_gift_by_slug(slug: str, account: int, cb) -> None:
    """cb(gift_or_None, error_text_or_None) is called on the UI thread"""
    cls = _find_tl(("getuniquestargift", "paymentsgetuniquestargift"))
    if cls is None:
        cb(None, tr("err_no_req", "getUniqueStarGift"))
        return
    req = cls()
    req.slug = slug

    def _cb(response, error):
        def _ui():
            try:
                if error is not None:
                    cb(None, _err_text(error))
                    return
                g = getattr(response, "gift", None)
                if g is not None and _obj_kind(g) == "stargiftunique":
                    cb(g, None)
                else:
                    cb(None, tr("nft_not_found"))
            except Exception as e:
                cb(None, str(e))
        run_on_ui_thread(_ui)

    try:
        send_request(req, _cb, account=account)
    except TypeError:
        send_request(req, _cb)


def _describe_dialog(dialog: Any) -> None:
    """one-time dump of the interesting fields of a sheet class, for the diagnostics report"""
    try:
        cname = str(dialog.getClass().getName())
        if cname in _DESC_SEEN:
            return
        _DESC_SEEN.add(cname)
        Modifier = jclass("java.lang.reflect.Modifier")
        parts = []
        k = dialog.getClass()
        while k is not None and len(parts) < 80:
            kn = str(k.getName())
            if kn.startswith(("android.", "java.")):
                break
            for f in k.getDeclaredFields():
                try:
                    if Modifier.isStatic(f.getModifiers()):
                        continue
                    t = str(f.getType().getName())
                    if (t.startswith("org.telegram.tgnet") or "MessageObject" in t or t.startswith("java.util.")
                            or t.startswith("org.telegram.ui.Stars") or t in ("java.lang.String", "java.lang.Object")):
                        parts.append("%s:%s" % (f.getName(), t.split(".")[-1]))
                except Exception:
                    continue
            k = k.getSuperclass()
        _dbg("fields of %s: %s" % (cname, ", ".join(parts)))
    except Exception as e:
        _dbg("describe error: %s" % e)


def _rarity(a: Any) -> str:
    try:
        p = a.rarity_permille
        if isinstance(p, (int, float)) and p > 0:
            return "%g%%" % (p / 10.0)
    except Exception:
        pass
    try:
        r = a.rarity
        if r is not None:
            try:
                p = r.permille
                if isinstance(p, (int, float)) and p > 0:
                    return "%g%%" % (p / 10.0)
            except Exception:
                pass
            k = _obj_kind(r)
            for w in ("legendary", "epic", "rare", "uncommon"):
                if w in k:
                    return w.capitalize()
    except Exception:
        pass
    return ""


def _permille(a: Any) -> int:
    try:
        p = a.rarity_permille
        if isinstance(p, (int, float)) and p > 0:
            return int(p)
    except Exception:
        pass
    try:
        r = a.rarity
        if r is not None:
            p = r.permille
            if isinstance(p, (int, float)) and p > 0:
                return int(p)
    except Exception:
        pass
    return 0


def parse_price(g: Any):
    stars = None
    ton = None
    try:
        ra = g.resell_amount
        if ra is not None:
            for i in range(ra.size()):
                a = ra.get(i)
                amt = _num(a.amount)
                if "ton" in _obj_kind(a):
                    ton = amt / 1e9
                else:
                    stars = amt
    except Exception:
        pass
    if stars is None and ton is None:
        try:
            rs = _num(g.resell_stars)
            if rs > 0:
                stars = rs
        except Exception:
            pass
    return stars, ton


def parse_gift(g: Any) -> Dict[str, Any]:
    d: Dict[str, Any] = {
        "raw": g,
        "gift_id": _num(getattr(g, "gift_id", 0)),
        "num": _num(getattr(g, "num", 0)),
        "title": str(getattr(g, "title", "") or ""),
        "slug": str(getattr(g, "slug", "") or ""),
        "model": None,
        "backdrop": None,
        "pattern": None,
    }
    try:
        attrs = g.attributes
        for i in range(attrs.size()):
            a = attrs.get(i)
            k = _obj_kind(a)
            try:
                if k == "stargiftattributemodel":
                    doc = a.document
                    d["model"] = {"name": str(a.name or ""), "doc": doc, "doc_id": _num(doc.id), "rarity": _rarity(a), "pm": _permille(a)}
                elif k == "stargiftattributebackdrop":
                    d["backdrop"] = {
                        "name": str(a.name or ""),
                        "id": _num(a.backdrop_id),
                        "center": _num(a.center_color),
                        "edge": _num(a.edge_color),
                        "rarity": _rarity(a),
                        "pm": _permille(a),
                    }
                elif k == "stargiftattributepattern":
                    doc = a.document
                    d["pattern"] = {"name": str(a.name or ""), "doc_id": _num(doc.id), "rarity": _rarity(a), "pm": _permille(a)}
            except Exception as e:
                _lg("attr parse error: %s" % e)
    except Exception as e:
        _lg("attributes parse error: %s" % e)
    d["stars"], d["ton"] = parse_price(g)
    return d


def fmt_price(it: Dict[str, Any]):
    """returns (text, is_ton)"""
    if it.get("stars") is not None:
        return "\u2605 " + ("{:,}".format(int(it["stars"])).replace(",", " ")), False
    if it.get("ton") is not None:
        s = ("%.2f" % it["ton"]).rstrip("0").rstrip(".")
        return "\u25C6 %s TON" % (s or "0"), True
    return "—", False


def build_resale_request(gift: Dict[str, Any], fkeys, offset: str, sort: int, limit: int) -> Any:
    req_cls = _find_tl(("getresalestargifts", "paymentsgetresalestargifts"))
    if req_cls is None:
        raise RuntimeError(tr("err_no_req", "getResaleStarGifts"))
    req = req_cls()
    req.gift_id = int(gift["gift_id"])
    req.offset = offset or ""
    req.limit = int(limit)
    flags = 0
    srv = 0 if sort in (0, 3) else sort  # "expensive first" is sorted client-side
    if srv == 0:
        try:
            req.sort_by_price = True
        except Exception:
            pass
        flags |= 2
    elif srv == 1:
        try:
            req.sort_by_num = True
        except Exception:
            pass
        flags |= 4
    ids = []
    model, backdrop, pattern = gift.get("model"), gift.get("backdrop"), gift.get("pattern")
    if "model" in fkeys and model:
        c = _find_tl(("stargiftattributeidmodel",))
        if c is None:
            raise RuntimeError(tr("err_no_cls", "StarGiftAttributeIdModel"))
        o = c()
        o.document_id = int(model["doc_id"])
        ids.append(o)
    if "backdrop" in fkeys and backdrop:
        c = _find_tl(("stargiftattributeidbackdrop",))
        if c is None:
            raise RuntimeError(tr("err_no_cls", "StarGiftAttributeIdBackdrop"))
        o = c()
        o.backdrop_id = int(backdrop["id"])
        ids.append(o)
    if "pattern" in fkeys and pattern and pattern.get("doc_id"):
        c = _find_tl(("stargiftattributeidpattern",))
        if c is None:
            raise RuntimeError(tr("err_no_cls", "StarGiftAttributeIdPattern"))
        o = c()
        o.document_id = int(pattern["doc_id"])
        ids.append(o)
    if ids:
        lst = None
        try:
            lst = req.attributes
        except Exception:
            lst = None
        if lst is None:
            lst = ArrayList()
            req.attributes = lst
        for o in ids:
            lst.add(o)
        flags |= 8
    try:
        req.flags = int(req.flags) | flags
    except Exception:
        try:
            req.flags = flags
        except Exception:
            pass
    return req


# ---------------------------------------------------------------------------
# glass drawing helpers
# ---------------------------------------------------------------------------
def glass_bg(c1: int, c2: int, stroke: Optional[int], radius: float, corners=None, sw: float = 1.0) -> Any:
    gd = GradientDrawable()
    gd.setOrientation(GradientDrawable.Orientation.TOP_BOTTOM)
    gd.setColors(jarray(jint)([c1, c2]))
    if corners is not None:
        gd.setCornerRadii(jarray(jfloat)([float(x) for x in corners]))
    else:
        gd.setCornerRadius(float(dp(radius)))
    if stroke is not None:
        gd.setStroke(max(1, dp(sw)), stroke)
    return gd


def radial_bg(c_center: int, c_edge: int, radius: float, size_dp: float) -> Any:
    gd = GradientDrawable()
    gd.setGradientType(GradientDrawable.RADIAL_GRADIENT)
    gd.setGradientRadius(float(dp(size_dp * 0.75)))
    gd.setColors(jarray(jint)([c_center, c_edge]))
    gd.setCornerRadius(float(dp(radius)))
    return gd


def mk_text(ctx: Any, text: str, size: float, color: int, bold: bool = False, single: bool = True) -> Any:
    t = TextView(ctx)
    t.setText(text)
    t.setTextSize(float(size))
    t.setTextColor(color)
    if bold:
        t.setTypeface(Typeface.DEFAULT_BOLD)
    if single:
        t.setSingleLine(True)
        t.setEllipsize(TextUtils.TruncateAt.END)
    return t


class _Touch(dynamic_proxy(View.OnTouchListener)):
    """Passive touch listener (never consumes the event)."""

    def __init__(self, fn):
        super().__init__()
        self.fn = fn

    def onTouch(self, v, e):
        try:
            self.fn(v, int(e.getActionMasked()))
        except Exception:
            pass
        return False


class _TouchRet(dynamic_proxy(View.OnTouchListener)):
    """Touch listener whose return value is decided by `fn(view, event)`."""

    def __init__(self, fn):
        super().__init__()
        self.fn = fn

    def onTouch(self, v, e):
        try:
            return bool(self.fn(v, e))
        except Exception:
            return False


class _ScrollListener(dynamic_proxy(View.OnScrollChangeListener)):
    def __init__(self, fn):
        super().__init__()
        self.fn = fn

    def onScrollChange(self, v, scroll_x, scroll_y, old_x, old_y):
        try:
            self.fn(v, int(scroll_y))
        except Exception:
            pass


class _KeyListener(dynamic_proxy(DialogInterface.OnKeyListener)):
    def __init__(self, fn):
        super().__init__()
        self.fn = fn

    def onKey(self, dialog, key_code, event):
        try:
            return bool(self.fn(int(key_code), event))
        except Exception:
            return False


class _ViewKeyListener(dynamic_proxy(View.OnKeyListener)):
    def __init__(self, fn):
        super().__init__()
        self.fn = fn

    def onKey(self, v, key_code, event):
        try:
            return bool(self.fn(key_code, event))
        except Exception:
            return False


class _UpdateListener(dynamic_proxy(ValueAnimator.AnimatorUpdateListener)):
    def __init__(self, fn):
        super().__init__()
        self.fn = fn

    def onAnimationUpdate(self, animation):
        try:
            self.fn(float(animation.getAnimatedFraction()))
        except Exception:
            pass


class _InsetsListener(dynamic_proxy(View.OnApplyWindowInsetsListener)):
    def __init__(self, fn):
        super().__init__()
        self.fn = fn

    def onApplyWindowInsets(self, v, insets):
        try:
            self.fn(insets)
        except Exception:
            pass
        return insets


def _real_height(ctx: Any) -> int:
    try:
        wm = cast(WindowManager, ctx.getSystemService("window"))
        if int(Build.VERSION.SDK_INT) >= 30:
            return int(wm.getMaximumWindowMetrics().getBounds().height())
        dm = DisplayMetrics()
        wm.getDefaultDisplay().getRealMetrics(dm)
        return int(dm.heightPixels)
    except Exception:
        return 0


def _res_id(ctx: Any, name: str) -> int:
    try:
        return int(ctx.getResources().getIdentifier(name, "drawable", ctx.getPackageName()))
    except Exception:
        return 0


def press_effect(view: Any) -> None:
    def _on(v, action):
        if action == 0:
            v.animate().scaleX(0.97).scaleY(0.97).setDuration(90).start()
        elif action in (1, 3):
            v.animate().scaleX(1.0).scaleY(1.0).setDuration(240).setInterpolator(OvershootInterpolator(2.2)).start()

    view.setOnTouchListener(_Touch(_on))


def fade_in(view: Any, delay: int = 0, dy: float = 14.0, dur: int = 340) -> None:
    if not _ANIM[0]:
        view.setAlpha(1.0)
        view.setTranslationY(0.0)
        return
    view.setAlpha(0.0)
    view.setTranslationY(float(dp(dy)))
    view.animate().alpha(1.0).translationY(0.0).setStartDelay(int(delay)).setDuration(int(dur)).setInterpolator(
        DecelerateInterpolator(1.7)
    ).start()


class Pal:
    def __init__(self, dark: bool):
        self.dark = dark
        if dark:
            self.panel_a, self.panel_b = argb(232, 30, 36, 56), argb(246, 12, 15, 27)
            self.stroke = argb(90, 255, 255, 255)
            self.text, self.sub = argb(255, 255, 255, 255), argb(165, 255, 255, 255)
            self.card_a, self.card_b, self.card_stroke = argb(44, 255, 255, 255), argb(18, 255, 255, 255), argb(50, 255, 255, 255)
            self.track, self.track_stroke = argb(34, 255, 255, 255), argb(44, 255, 255, 255)
            self.ind_a, self.ind_b, self.ind_stroke = argb(130, 255, 255, 255), argb(66, 255, 255, 255), argb(150, 255, 255, 255)
            self.tab_off, self.tab_on = argb(160, 255, 255, 255), argb(255, 255, 255, 255)
            self.handle = argb(95, 255, 255, 255)
            self.star_txt, self.star_bg = argb(255, 255, 216, 108), argb(46, 255, 196, 60)
            self.ton_txt, self.ton_bg = argb(255, 128, 214, 255), argb(46, 70, 180, 255)
            self.skel = argb(34, 255, 255, 255)
            self.toast_a, self.toast_b, self.toast_stroke = argb(245, 56, 64, 92), argb(245, 30, 35, 58), argb(120, 255, 255, 255)
        else:
            self.panel_a, self.panel_b = argb(240, 252, 253, 255), argb(246, 236, 240, 249)
            self.stroke = argb(150, 255, 255, 255)
            self.text, self.sub = argb(255, 16, 20, 30), argb(150, 16, 20, 30)
            self.card_a, self.card_b, self.card_stroke = argb(190, 255, 255, 255), argb(130, 255, 255, 255), argb(34, 0, 0, 0)
            self.track, self.track_stroke = argb(26, 0, 0, 0), argb(20, 0, 0, 0)
            self.ind_a, self.ind_b, self.ind_stroke = argb(255, 255, 255, 255), argb(240, 255, 255, 255), argb(36, 0, 0, 0)
            self.tab_off, self.tab_on = argb(140, 16, 20, 30), argb(255, 16, 20, 30)
            self.handle = argb(70, 0, 0, 0)
            self.star_txt, self.star_bg = argb(255, 168, 102, 0), argb(40, 255, 176, 20)
            self.ton_txt, self.ton_bg = argb(255, 0, 116, 186), argb(36, 0, 140, 255)
            self.skel = argb(24, 0, 0, 0)
            self.toast_a, self.toast_b, self.toast_stroke = argb(245, 52, 58, 78), argb(245, 28, 32, 48), argb(90, 255, 255, 255)


# ---------------------------------------------------------------------------
# the bottom sheet with similar NFTs
# ---------------------------------------------------------------------------
def _pick(lst, idx, default):
    try:
        i = int(idx)
        if 0 <= i < len(lst):
            return lst[i]
    except Exception:
        pass
    return default


def _jload(plugin: Any, key: str, default: Any) -> Any:
    try:
        v = plugin.get_setting(key, "")
        if isinstance(v, str) and v:
            return json.loads(v)
    except Exception as e:
        _lg("jload %s failed: %s" % (key, e))
    return default


def _jsave(plugin: Any, key: str, val: Any) -> None:
    try:
        plugin.set_setting(key, json.dumps(val, ensure_ascii=False))
    except Exception as e:
        _lg("jsave %s failed: %s" % (key, e))


def fmt_stars(n: int) -> str:
    return "\u2605" + "{:,}".format(int(n)).replace(",", " ")


def _median(v: List[int]) -> int:
    v = sorted(v)
    n = len(v)
    if n == 0:
        return 0
    return v[n // 2] if n % 2 else (v[n // 2 - 1] + v[n // 2]) // 2


def _open_browser(ctx: Any, url: str) -> None:
    try:
        ctx.startActivity(Intent(Intent.ACTION_VIEW, Uri.parse(url)))
    except Exception as e:
        _lg("browser open failed: %s" % e)
        _toast(url)


class SimilarSheet:
    def __init__(self, plugin: "SimilarNftPlugin", ctx: Any, account: int, gift: Dict[str, Any], host: Any = None):
        self.host = host
        self.group = None
        self.plugin = plugin
        self.ctx = ctx
        self.account = account
        self.gift = gift
        _set_lang(plugin.get_setting("language", 0))
        th = _to_int(plugin.get_setting("theme", 0), 0)
        self.pal = Pal(_is_dark() if th == 0 else th == 2)
        gs = plugin.get_setting
        self.sort = _to_int(gs("sort", 0), 0)
        if self.sort not in (0, 1, 2, 3):
            self.sort = 0
        self.page_size = _pick(PAGE_SIZES, gs("page_size", 1), 24)
        self.ttl = _pick(TTLS, gs("cache_ttl", 2), 90)
        self.rare_pm = _pick(RARITY_LIMITS, gs("rarity_limit", 0), 0)
        self.pmin = _pick(PRICE_MIN, gs("price_min", 0), 0)
        self.pmax = _pick(PRICE_MAX, gs("price_max", 0), 0)
        self.usd = _pick(USD_RATES, gs("usd_rate", 0), 0.0)
        self.compact = bool(gs("compact", False))
        self.haptics = bool(gs("haptics", True))
        self.anim = bool(gs("animations", True))
        _ANIM[0] = self.anim
        self.blur_on = bool(gs("glass_blur", True))
        self.auto_more = bool(gs("infinite_scroll", True))
        self.use_accent = bool(gs("accent_backdrop", True))
        self.list_frac = _pick(LIST_HEIGHTS, gs("list_height", 1), 0.5)
        self.tap_menu = _to_int(gs("tap_action", 0), 0) == 1
        self.show_rar = bool(gs("rarity_rows", True))
        self.remember = bool(gs("remember_filters", False))

        self.available = {
            "model": bool(gift.get("model")),
            "backdrop": bool(gift.get("backdrop")),
            "pattern": bool(gift.get("pattern") and gift["pattern"].get("doc_id")),
        }
        idx = _to_int(gs("default_filter", 0), 0)
        if not (0 <= idx < len(FILTER_SETS)):
            idx = 0
        self.fset = set(k for k in FILTER_SETS[idx] if self.available[k])
        if not self.fset:
            for k in FILTER_KEYS:
                if self.available[k]:
                    self.fset = {k}
                    break
        self.cur = 0
        if self.remember:
            sv = _jload(plugin, "last_view", None)
            if isinstance(sv, dict):
                ks = sv.get("f")
                if isinstance(ks, list):
                    self.fset = set(k for k in ks if k in FILTER_KEYS and self.available.get(k))
                if sv.get("c") in (0, 1, 2):
                    self.cur = sv["c"]
        self.show_favs = False
        self.favs: List[Dict[str, Any]] = _jload(plugin, "favs", [])
        if not isinstance(self.favs, list):
            self.favs = []
        self.items: List[Dict[str, Any]] = []
        self.next_offset = ""
        self.total: Optional[int] = None
        self.gen = 0
        self.closed = False
        self.closing = False
        self.loading = False
        self.more_failed = False
        self.load_all = False
        self.auto_pages = 0
        self.rendered = False
        self.floor_stars: Optional[int] = None
        self.prev_floor: Optional[int] = None
        self.own_stars = gift.get("stars")
        self.summary = ""
        self.pulses: List[Any] = []
        self.dialog = None
        self.win = None
        self.screen_h = 0
        self.nav = 0
        self.filter_views: List[Any] = []
        self.footer = None
        self.toast_view = None
        self.actions_view = None
        self._dragging = False
        self._drag_y0 = 0.0
        self._drag_t0 = 0.0

    def d(self, ms: int) -> int:
        return int(ms) if self.anim else 1

    # ---- construction ------------------------------------------------
    def show(self) -> None:
        ctx = self.ctx
        p = self.pal
        self.screen_h = _real_height(ctx) or int(ctx.getResources().getDisplayMetrics().heightPixels)
        try:
            self.nav = int(AndroidUtilities.navigationBarHeight)
        except Exception:
            self.nav = 0

        host = self.host
        group = None
        if host is not None:
            try:
                self.win = host.getWindow()
                group = cast(ViewGroup, self.win.getDecorView())
                dh = int(group.getHeight())
                if dh > 0:
                    self.screen_h = max(dh, self.screen_h)
            except Exception as e:
                _lg("host window unavailable: %s" % e)
                host = None
                group = None
        d = None
        win = self.win
        if host is None:
            theme = 0
            try:
                theme = int(ctx.getResources().getIdentifier("TransparentDialog", "style", ctx.getPackageName()))
            except Exception:
                theme = 0
            d = Dialog(ctx, theme) if theme else Dialog(ctx)
            d.requestWindowFeature(Window.FEATURE_NO_TITLE)
            self.dialog = d
            win = d.getWindow()
            self.win = win
            win.setBackgroundDrawable(ColorDrawable(0))
            win.setLayout(-1, -1)
            try:
                attrs0 = win.getAttributes()
                attrs0.width = -1
                attrs0.height = _real_height(ctx) or -1
                attrs0.gravity = Gravity.TOP | Gravity.LEFT
                attrs0.x = 0
                attrs0.y = 0
                win.setAttributes(attrs0)
            except Exception as e:
                _lg("window size failed: %s" % e)
            try:
                win.addFlags(LP_IN_SCREEN | LP_NO_LIMITS | LP_DRAWS_BARS)
                win.clearFlags(LP_DIM_BEHIND)  # our own scrim does the dimming
            except Exception:
                pass

        root = FrameLayout(ctx)
        self.root = root

        scrim = View(ctx)
        scrim.setBackgroundColor(argb(120, 0, 0, 0) if p.dark else argb(80, 20, 24, 40))
        scrim.setAlpha(0.0)
        scrim.setOnClickListener(OnClickListener(lambda v: self.close()))
        root.addView(scrim, FrameLayout.LayoutParams(-1, -1))
        self.scrim = scrim

        panel = FrameLayout(ctx)
        r = float(dp(30))
        panel.setBackground(glass_bg(p.panel_a, p.panel_b, p.stroke, 0, corners=[r, r, r, r, 0, 0, 0, 0]))
        panel.setClickable(True)
        plp = FrameLayout.LayoutParams(-1, -2)
        plp.gravity = Gravity.BOTTOM
        root.addView(panel, plp)
        self.panel = panel

        backdrop = self.gift.get("backdrop")
        self.accent = rgb24(backdrop["center"], 255) if (backdrop and self.use_accent) else argb(255, 70, 150, 255)
        glow = View(ctx)
        tint = rgb24(backdrop["center"], 70) if (backdrop and self.use_accent) else argb(60, 90, 160, 255)
        glow.setBackground(glass_bg(tint, argb(0, 0, 0, 0), None, 0, corners=[r, r, r, r, 0, 0, 0, 0]))
        panel.addView(glow, FrameLayout.LayoutParams(-1, dp(200)))

        hl = View(ctx)
        try:
            g2 = GradientDrawable()
            g2.setOrientation(GradientDrawable.Orientation.LEFT_RIGHT)
            g2.setColors(jarray(jint)([argb(0, 255, 255, 255), argb(170 if p.dark else 220, 255, 255, 255), argb(0, 255, 255, 255)]))
            hl.setBackground(g2)
        except Exception:
            pass
        hlp = FrameLayout.LayoutParams(-1, max(1, dp(1)))
        hlp.leftMargin = dp(28)
        hlp.rightMargin = dp(28)
        panel.addView(hl, hlp)

        content = LinearLayout(ctx)
        content.setOrientation(LinearLayout.VERTICAL)
        content.setPadding(dp(16), dp(6), dp(16), max(dp(14), self.nav + dp(10)))
        panel.addView(content, FrameLayout.LayoutParams(-1, -2))
        self.content = content

        drag = LinearLayout(ctx)
        drag.setOrientation(LinearLayout.VERTICAL)
        drag.setPadding(0, dp(4), 0, dp(2))
        handle = View(ctx)
        handle.setBackground(glass_bg(p.handle, p.handle, None, 3))
        hlp2 = LinearLayout.LayoutParams(dp(40), dp(4))
        hlp2.gravity = Gravity.CENTER_HORIZONTAL
        hlp2.bottomMargin = dp(12)
        drag.addView(handle, hlp2)
        drag.addView(self._build_header(), LinearLayout.LayoutParams(-1, -2))
        drag.setOnTouchListener(_TouchRet(self._on_drag))
        content.addView(drag, LinearLayout.LayoutParams(-1, -2))
        self.drag_area = drag

        filters = self._build_filters()
        flp = LinearLayout.LayoutParams(-1, dp(44))
        flp.topMargin = dp(14)
        content.addView(filters, flp)

        self.info = mk_text(ctx, "", 12.5, p.sub, single=False)
        try:
            self.info.setMaxLines(2)
            self.info.setEllipsize(TextUtils.TruncateAt.END)
        except Exception:
            pass
        ilp = LinearLayout.LayoutParams(-1, -2)
        ilp.topMargin = dp(10)
        ilp.leftMargin = dp(4)
        ilp.rightMargin = dp(4)
        content.addView(self.info, ilp)

        tiles = self._build_tiles()
        tlp = LinearLayout.LayoutParams(-1, -2)
        tlp.topMargin = dp(8)
        content.addView(tiles, tlp)

        self.extra = mk_text(ctx, "", 11.5, p.sub, single=False)
        elp = LinearLayout.LayoutParams(-1, -2)
        elp.topMargin = dp(6)
        elp.leftMargin = dp(4)
        elp.rightMargin = dp(4)
        content.addView(self.extra, elp)
        self.extra.setVisibility(View.GONE)

        chips = self._build_chips()
        clp = LinearLayout.LayoutParams(-1, -2)
        clp.topMargin = dp(8)
        clp.bottomMargin = dp(8)
        content.addView(chips, clp)

        scroll = ScrollView(ctx)
        scroll.setVerticalScrollBarEnabled(False)
        scroll.setOverScrollMode(View.OVER_SCROLL_NEVER)
        self.list = LinearLayout(ctx)
        self.list.setOrientation(LinearLayout.VERTICAL)
        scroll.addView(self.list, FrameLayout.LayoutParams(-1, -2))
        h = min(dp(560), int(self.screen_h * self.list_frac))
        sframe = FrameLayout(ctx)
        sframe.addView(scroll, FrameLayout.LayoutParams(-1, -1))
        fade = View(ctx)
        try:
            fg = GradientDrawable()
            fg.setOrientation(GradientDrawable.Orientation.TOP_BOTTOM)
            fg.setColors(jarray(jint)([p.panel_b & 0x00FFFFFF, p.panel_b]))
            fade.setBackground(fg)
        except Exception:
            pass
        fl2 = FrameLayout.LayoutParams(-1, dp(18))
        fl2.gravity = Gravity.BOTTOM
        sframe.addView(fade, fl2)
        content.addView(sframe, LinearLayout.LayoutParams(-1, h))
        self.scroll = scroll
        if self.auto_more:
            try:
                scroll.setOnScrollChangeListener(_ScrollListener(self._on_scroll))
            except Exception as e:
                _lg("scroll listener failed: %s" % e)

        self._anim_targets = [drag, filters, self.info, tiles, chips, sframe]

        if group is not None:
            self.group = group
            root.setClickable(True)
            group.addView(root, FrameLayout.LayoutParams(-1, -1))
            try:
                root.setOnApplyWindowInsetsListener(_InsetsListener(self._on_insets))
                root.requestApplyInsets()
            except Exception as e:
                _lg("insets listener failed: %s" % e)
            try:
                root.setFocusableInTouchMode(True)
                root.requestFocus()
                root.setOnKeyListener(_ViewKeyListener(self._on_key))
            except Exception as e:
                _lg("key listener failed: %s" % e)
        else:
            d.setContentView(root)
            try:
                decor0 = win.getDecorView()
                decor0.setPadding(0, 0, 0, 0)
                decor0.setOnApplyWindowInsetsListener(_InsetsListener(self._on_insets))
            except Exception as e:
                _lg("insets listener failed: %s" % e)
            try:
                if int(Build.VERSION.SDK_INT) >= 30:
                    win.setDecorFitsSystemWindows(False)
                else:
                    win.getDecorView().setSystemUiVisibility(1792)
            except Exception:
                pass
            try:
                win.setStatusBarColor(0)
                win.setNavigationBarColor(0)
                if int(Build.VERSION.SDK_INT) >= 29:
                    win.setNavigationBarContrastEnforced(False)
            except Exception:
                pass
            d.setOnKeyListener(_KeyListener(self._on_key))
        if d is not None:
            d.show()
        self._animate_in()
        self._paint_filters()
        self._refresh_info()
        self._load(True)

    def _make_thumb(self, model: Optional[Dict[str, Any]], backdrop: Optional[Dict[str, Any]], size: int, radius: int) -> Any:
        ctx = self.ctx
        frame = FrameLayout(ctx)
        if backdrop and backdrop.get("center") is not None:
            frame.setBackground(radial_bg(rgb24(backdrop["center"]), rgb24(backdrop.get("edge", backdrop["center"])), radius, size))
        else:
            frame.setBackground(glass_bg(self.pal.card_a, self.pal.card_b, self.pal.card_stroke, radius))
        ok = False
        if model and model.get("doc") is not None:
            try:
                from org.telegram.messenger import ImageLocation
                iv = BackupImageView(ctx)
                loc = ImageLocation.getForDocument(model["doc"])
                iv.setImage(loc, "80_80_firstframe", cast(Drawable, None), model["doc"])
                inner = int(size * 0.84)
                lp = FrameLayout.LayoutParams(dp(inner), dp(inner))
                lp.gravity = Gravity.CENTER
                frame.addView(iv, lp)
                ok = True
            except Exception as e:
                _lg("thumb error: %s" % e)
        if not ok:
            g = mk_text(ctx, "NFT", size * 0.24, self.pal.sub, bold=True)
            g.setGravity(Gravity.CENTER)
            frame.addView(g, FrameLayout.LayoutParams(-1, -1))
        return frame

    def _on_insets(self, insets: Any) -> None:
        b = 0
        try:
            b = int(insets.getSystemWindowInsetBottom())
        except Exception:
            b = 0
        if b > 0 and b != self.nav:
            self.nav = b
            try:
                self.content.setPadding(dp(16), dp(6), dp(16), max(dp(14), b + dp(10)))
            except Exception:
                pass

    def _icon_btn(self, names, fallback: str, fn) -> Any:
        ctx, p = self.ctx, self.pal
        box = FrameLayout(ctx)
        box.setBackground(glass_bg(p.card_a, p.card_b, p.card_stroke, 17))
        res = 0
        for n in names:
            res = _res_id(ctx, n)
            if res:
                break
        made = False
        if res:
            try:
                iv = ImageView(ctx)
                iv.setImageResource(res)
                iv.setColorFilter(p.text, PorterDuff.Mode.SRC_IN)
                iv.setPadding(dp(8), dp(8), dp(8), dp(8))
                box.addView(iv, FrameLayout.LayoutParams(-1, -1))
                made = True
            except Exception:
                made = False
        if not made:
            t = mk_text(ctx, fallback, 15, p.text, bold=True)
            t.setGravity(Gravity.CENTER)
            box.addView(t, FrameLayout.LayoutParams(-1, -1))
        box.setOnClickListener(OnClickListener(lambda v: fn()))
        press_effect(box)
        return box

    def _build_header(self) -> Any:
        ctx, p, g = self.ctx, self.pal, self.gift
        row = LinearLayout(ctx)
        row.setOrientation(LinearLayout.HORIZONTAL)
        row.setGravity(Gravity.CENTER_VERTICAL)
        row.addView(self._make_thumb(g.get("model"), g.get("backdrop"), 48, 16), LinearLayout.LayoutParams(dp(48), dp(48)))

        col = LinearLayout(ctx)
        col.setOrientation(LinearLayout.VERTICAL)
        col.addView(mk_text(ctx, tr("title"), 20, p.text, bold=True), LinearLayout.LayoutParams(-2, -2))
        col.addView(mk_text(ctx, "%s #%s" % (g.get("title") or "NFT", g.get("num") or ""), 13, p.sub), LinearLayout.LayoutParams(-2, -2))
        clp = LinearLayout.LayoutParams(0, -2)
        clp.weight = 1.0
        clp.leftMargin = dp(12)
        clp.rightMargin = dp(6)
        row.addView(col, clp)

        buttons = (
            (("msg_retry", "msg_refresh"), "\u21BB", self._refresh),
            (("msg_copy", "msg_copy_filled"), "\u2261", self._copy_summary),
            (("msg_close", "input_clear", "ic_close_white"), "\u2715", self.close),
        )
        for names, glyph, fn in buttons:
            b = self._icon_btn(names, glyph, fn)
            blp = LinearLayout.LayoutParams(dp(34), dp(34))
            blp.leftMargin = dp(6)
            row.addView(b, blp)
        return row

    def _build_filters(self) -> Any:
        ctx, p = self.ctx, self.pal
        row = LinearLayout(ctx)
        row.setOrientation(LinearLayout.HORIZONTAL)
        row.setPadding(dp(3), dp(3), dp(3), dp(3))
        row.setBackground(glass_bg(p.track, p.track, p.track_stroke, 22))
        self.filter_views = []
        for i, key in enumerate(FILTER_KEYS):
            t = mk_text(ctx, _filter_labels()[i], 13.5, p.tab_off, bold=True)
            t.setGravity(Gravity.CENTER)
            t.setOnClickListener(OnClickListener(lambda v, k=key: self._toggle_filter(k)))
            press_effect(t)
            lp = LinearLayout.LayoutParams(0, -1)
            lp.weight = 1.0
            row.addView(t, lp)
            self.filter_views.append(t)
        return row

    def _build_tiles(self) -> Any:
        ctx, p = self.ctx, self.pal
        row = LinearLayout(ctx)
        row.setOrientation(LinearLayout.HORIZONTAL)
        self.tile_labs = []
        self.tile_vals = []
        for ti, label in enumerate((tr("tile_floor"), tr("tile_median"), tr("tile_max"))):
            box = LinearLayout(ctx)
            box.setOrientation(LinearLayout.VERTICAL)
            box.setPadding(dp(12), dp(8), dp(10), dp(9))
            box.setBackground(glass_bg(p.card_a, p.card_b, p.card_stroke, 16))
            lab = mk_text(ctx, label, 10.5, p.sub)
            val = mk_text(ctx, "\u2014", 15.5, p.star_txt if ti == 0 else p.text, bold=True)
            box.addView(lab, LinearLayout.LayoutParams(-2, -2))
            box.addView(val, LinearLayout.LayoutParams(-2, -2))
            lp = LinearLayout.LayoutParams(0, -2)
            lp.weight = 1.0
            lp.leftMargin = dp(3)
            lp.rightMargin = dp(3)
            row.addView(box, lp)
            self.tile_labs.append(lab)
            self.tile_vals.append(val)
        return row

    def _mk_chip(self, text: str, fn) -> Any:
        p = self.pal
        c = mk_text(self.ctx, text, 12.5, p.text, bold=True)
        c.setGravity(Gravity.CENTER)
        c.setPadding(dp(13), dp(7), dp(13), dp(7))
        c.setBackground(glass_bg(p.card_a, p.card_b, p.card_stroke, 15))
        c.setOnClickListener(OnClickListener(lambda v: fn()))
        press_effect(c)
        return c

    def _build_chips(self) -> Any:
        ctx = self.ctx
        hs = HorizontalScrollView(ctx)
        hs.setHorizontalScrollBarEnabled(False)
        hs.setOverScrollMode(View.OVER_SCROLL_NEVER)
        row = LinearLayout(ctx)
        row.setOrientation(LinearLayout.HORIZONTAL)
        hs.addView(row, FrameLayout.LayoutParams(-2, -2))
        self.sort_chip = self._mk_chip("", self._cycle_sort)
        self.cur_chip = self._mk_chip("", self._cycle_cur)
        self.fav_chip = self._mk_chip("", self._toggle_favs)
        self.all_chip = self._mk_chip("", self._start_load_all)
        self.list_chip = self._mk_chip("", self._copy_list)
        for c in (self.sort_chip, self.cur_chip, self.fav_chip, self.all_chip, self.list_chip):
            lp = LinearLayout.LayoutParams(-2, -2)
            lp.rightMargin = dp(8)
            row.addView(c, lp)
        self._update_chips()
        return hs

    def _style_chip(self, chip: Any, active: bool) -> None:
        p = self.pal
        if active:
            chip.setBackground(glass_bg(p.ind_a, p.ind_b, self.accent, 15))
            chip.setTextColor(p.tab_on)
        else:
            chip.setBackground(glass_bg(p.card_a, p.card_b, p.card_stroke, 15))
            chip.setTextColor(p.text)

    def _update_chips(self) -> None:
        try:
            busy = self.load_all or (self.loading and self.sort == 3)
            self.sort_chip.setText("\u2195 " + _sort_labels()[self.sort])
            self.cur_chip.setText(_cur_labels()[self.cur])
            self.fav_chip.setText("\u2665\uFE0E %d" % len(self.favs))
            self.all_chip.setText("\u21E9 " + (tr("chip_loading", len(self.items)) if busy else tr("chip_all")))
            self.list_chip.setText(tr("chip_copy"))
            self._style_chip(self.list_chip, False)
            self._style_chip(self.sort_chip, self.sort != 0)
            self._style_chip(self.cur_chip, self.cur != 0)
            self._style_chip(self.fav_chip, self.show_favs)
            self._style_chip(self.all_chip, busy)
        except Exception:
            pass

    def _paint_filters(self) -> None:
        p = self.pal
        for key, t in zip(FILTER_KEYS, self.filter_views):
            on = key in self.fset and not self.show_favs
            label = _filter_labels()[FILTER_KEYS.index(key)]
            if on:
                t.setBackground(glass_bg(p.ind_a, p.ind_b, self.accent, 19))
                t.setTextColor(p.tab_on)
            else:
                t.setBackground(ColorDrawable(0))
                t.setTextColor(p.tab_off)
            t.setText(label)
            t.setAlpha(1.0 if self.available[key] else 0.32)

    # ---- animations ----------------------------------------------------
    def _animate_in(self) -> None:
        self.panel.setTranslationY(float(self.screen_h))
        self.panel.animate().translationY(0.0).setDuration(self.d(460)).setInterpolator(DecelerateInterpolator(2.4)).start()
        self.scrim.animate().alpha(1.0).setDuration(self.d(340)).start()
        for i, v in enumerate(self._anim_targets):
            fade_in(v, 140 + i * 50, 10.0, 380)
        self._animate_blur(0.0, 26.0, self.d(420))

    def _apply_blur(self, radius: float) -> None:
        if not self.blur_on or self.win is None:
            return
        try:
            if int(Build.VERSION.SDK_INT) >= 31:
                attrs = self.win.getAttributes()
                attrs.flags = attrs.flags | LP_BLUR_BEHIND
                attrs.setBlurBehindRadius(int(radius))
                self.win.setAttributes(attrs)
        except Exception:
            pass

    def _clear_blur(self) -> None:
        try:
            if self.win is not None and int(Build.VERSION.SDK_INT) >= 31:
                attrs = self.win.getAttributes()
                attrs.setBlurBehindRadius(0)
                attrs.flags = attrs.flags & ~LP_BLUR_BEHIND
                self.win.setAttributes(attrs)
        except Exception:
            pass

    def _animate_blur(self, a: float, b: float, dur: int) -> None:
        if not self.blur_on:
            return
        try:
            va = ValueAnimator.ofFloat(jarray(jfloat)([0.0, 1.0]))
            va.setDuration(int(dur))
            va.addUpdateListener(_UpdateListener(lambda f: self._apply_blur(a + (b - a) * f)))
            va.start()
        except Exception:
            pass

    def _on_key(self, key_code: int, event: Any) -> bool:
        if key_code == 4:
            try:
                if int(event.getAction()) == 1:
                    if self.actions_view is not None:
                        self._hide_actions()
                    else:
                        self.close()
            except Exception:
                self.close()
            return True
        return False

    def close(self) -> None:
        if self.closing or self.closed:
            return
        self.closing = True
        self.gen += 1
        self.load_all = False
        self._stop_pulse()

        def _finish():
            if self.closed:
                return
            self.closed = True
            try:
                if self.group is not None:
                    self._clear_blur()
                    self.group.removeView(self.root)
                elif self.dialog is not None:
                    self.dialog.dismiss()
            except Exception:
                pass

        try:
            self._animate_blur(26.0, 0.0, self.d(260))
            self.scrim.animate().alpha(0.0).setDuration(self.d(260)).start()
            self.panel.animate().translationY(float(self.screen_h)).setDuration(self.d(300)).setInterpolator(
                AccelerateInterpolator(1.6)
            ).withEndAction(R(_finish)).start()
            run_on_ui_thread(_finish, 700)
        except Exception:
            _finish()

    # ---- swipe down to dismiss ------------------------------------------
    def _on_drag(self, v: Any, e: Any) -> bool:
        if self.closing or self.closed:
            return False
        a = int(e.getActionMasked())
        y = float(e.getRawY())
        if a == 0:
            self._dragging = True
            self._drag_y0 = y
            self._drag_t0 = time.time()
            try:
                self.panel.animate().cancel()
            except Exception:
                pass
            return True
        if not self._dragging:
            return False
        dy = max(0.0, y - self._drag_y0)
        if a == 2:
            self.panel.setTranslationY(float(dy))
            self.scrim.setAlpha(max(0.15, 1.0 - dy / max(1.0, self.screen_h * 0.7)))
            return True
        if a in (1, 3):
            self._dragging = False
            dt = max(0.05, time.time() - self._drag_t0)
            if a == 1 and (dy > dp(120) or (dy > dp(28) and dy / dt > dp(700))):
                self.close()
            else:
                self.panel.animate().translationY(0.0).setDuration(260).setInterpolator(DecelerateInterpolator(2.0)).start()
                self.scrim.animate().alpha(1.0).setDuration(200).start()
            return True
        return False

    # ---- in-sheet toast --------------------------------------------------
    def _toast_in(self, text: str) -> None:
        if self.closed:
            return
        try:
            old = self.toast_view
            if old is not None:
                try:
                    self.root.removeView(old)
                except Exception:
                    pass
            p = self.pal
            t = mk_text(self.ctx, text, 13.5, argb(255, 255, 255, 255), bold=True)
            t.setGravity(Gravity.CENTER)
            t.setPadding(dp(18), dp(11), dp(18), dp(11))
            t.setBackground(glass_bg(p.toast_a, p.toast_b, p.toast_stroke, 20))
            try:
                t.setElevation(float(dp(10)))
            except Exception:
                pass
            lp = FrameLayout.LayoutParams(-2, -2)
            lp.gravity = Gravity.BOTTOM | Gravity.CENTER_HORIZONTAL
            lp.bottomMargin = dp(34) + self.nav
            lp.leftMargin = dp(20)
            lp.rightMargin = dp(20)
            self.root.addView(t, lp)
            t.setAlpha(0.0)
            t.setTranslationY(float(dp(12)))
            t.animate().alpha(1.0).translationY(0.0).setDuration(self.d(240)).setInterpolator(DecelerateInterpolator(1.8)).start()
            self.toast_view = t

            def _remove():
                try:
                    self.root.removeView(t)
                except Exception:
                    pass
                if self.toast_view is t:
                    self.toast_view = None

            def _hide():
                if self.closed or self.toast_view is not t:
                    return
                try:
                    t.animate().alpha(0.0).setDuration(260).withEndAction(R(_remove)).start()
                except Exception:
                    _remove()

            run_on_ui_thread(_hide, 1700)
        except Exception as e:
            _lg("toast error: %s" % e)

    # ---- interactions ---------------------------------------------------
    def _haptic(self) -> None:
        if not self.haptics:
            return
        try:
            self.root.performHapticFeedback(3)
        except Exception:
            pass

    def _toggle_filter(self, key: str) -> None:
        if self.closing:
            return
        if not self.available.get(key):
            self._toast_in(tr("toast_no_attr"))
            return
        self._haptic()
        self.show_favs = False
        if key in self.fset:
            self.fset.discard(key)
        else:
            self.fset.add(key)
        self._save_view()
        self._paint_filters()
        self._reload_animated()

    def _cycle_sort(self) -> None:
        if self.closing:
            return
        self._haptic()
        self.sort = (self.sort + 1) % 4
        try:
            self.plugin.set_setting("sort", self.sort)
        except Exception:
            pass
        if self.show_favs:
            self.show_favs = False
            self._paint_filters()
        self._reload_animated()

    def _cycle_cur(self) -> None:
        if self.closing:
            return
        self._haptic()
        self.cur = (self.cur + 1) % 3
        self._save_view()
        self._update_chips()
        self._refresh_info()
        self._render_full()

    def _toggle_favs(self) -> None:
        if self.closing:
            return
        self._haptic()
        self.show_favs = not self.show_favs
        self._paint_filters()
        self._update_chips()
        self._refresh_info()
        self._render_full()

    def _start_load_all(self) -> None:
        if self.closing or self.show_favs:
            return
        self._haptic()
        if not self.next_offset:
            self._toast_in(tr("toast_all_loaded", len(self.items)))
            return
        if self.loading:
            self.load_all = True
            self._update_chips()
            return
        self.load_all = True
        self._update_chips()
        self._load(False)

    def _refresh(self) -> None:
        if self.closing:
            return
        self._haptic()
        try:
            _CACHE.pop(self._cache_key(), None)
        except Exception:
            pass
        self._reload_animated()

    def _reload_animated(self) -> None:
        self.gen += 1
        gen = self.gen
        self.loading = False
        self.load_all = False
        self._update_chips()
        self._refresh_info()
        fired = [False]

        def _go():
            if fired[0] or gen != self.gen or self.closed or self.closing:
                return
            fired[0] = True
            self._load(True)

        try:
            self.list.animate().alpha(0.0).setDuration(self.d(130)).withEndAction(R(_go)).start()
        except Exception:
            pass
        run_on_ui_thread(_go, 260)

    def _save_view(self) -> None:
        if self.remember:
            _jsave(self.plugin, "last_view", {"f": sorted(self.fset), "c": self.cur})

    def _on_tap(self, it: Dict[str, Any]) -> None:
        if self.tap_menu:
            self._show_actions(it)
        else:
            self._open_gift(it.get("slug") or "")

    def _copy_list(self) -> None:
        if self.closing:
            return
        self._haptic()
        lines = []
        for it in self._view_items()[:100]:
            lines.append("%s #%s - %s - https://t.me/nft/%s" % (it.get("title") or "NFT", it.get("num"), fmt_price(it)[0], it.get("slug")))
        if not lines:
            self._toast_in(tr("no_match"))
            return
        if _copy(self.ctx, "\n".join(lines)):
            self._toast_in(tr("toast_list"))
        else:
            self._toast_in(tr("toast_copy_fail"))

    def _open_gift(self, slug: str) -> None:
        if not slug:
            return
        url = "https://t.me/nft/" + slug
        ctx = self.ctx
        self.close()
        run_on_ui_thread(lambda: _open_url(ctx, url), 280)

    def _copy_link(self, slug: str) -> None:
        if not slug:
            return
        self._haptic()
        if _copy(self.ctx, "https://t.me/nft/" + slug):
            self._toast_in(tr("toast_link"))
        else:
            self._toast_in(tr("toast_copy_fail"))

    def _share(self, slug: str) -> None:
        if not slug:
            return
        try:
            i = Intent(Intent.ACTION_SEND)
            i.setType("text/plain")
            i.putExtra("android.intent.extra.TEXT", "https://t.me/nft/" + slug)
            self.ctx.startActivity(Intent.createChooser(i, tr("share")))
        except Exception as e:
            _lg("share failed: %s" % e)
            self._toast_in(tr("toast_share_fail"))

    def _copy_summary(self) -> None:
        if self.closing:
            return
        self._haptic()
        g = self.gift
        text = "%s #%s — похожие NFT\n%s" % (g.get("title") or "NFT", g.get("num") or "", self.summary)
        if _copy(self.ctx, text.strip()):
            self._toast_in(tr("toast_summary"))
        else:
            self._toast_in(tr("toast_copy_fail"))

    def _on_scroll(self, v: Any, scroll_y: int) -> None:
        if not self.auto_more or self.closing or self.closed or self.show_favs:
            return
        if self.loading or self.more_failed or not self.next_offset:
            return
        child = v.getChildAt(0)
        if child is None:
            return
        remaining = int(child.getBottom()) - (int(v.getHeight()) + int(scroll_y))
        if remaining < dp(260):
            self._load(False)

    # ---- favorites / action menu ----------------------------------------
    def _fav_index(self, slug: str) -> int:
        for i, f in enumerate(self.favs):
            if f.get("slug") == slug:
                return i
        return -1

    def _toggle_fav(self, it: Dict[str, Any]) -> None:
        slug = it.get("slug") or ""
        if not slug:
            return
        self._haptic()
        i = self._fav_index(slug)
        if i >= 0:
            self.favs.pop(i)
            msg = tr("fav_removed")
        else:
            m, b = it.get("model"), it.get("backdrop")
            rec = {
                "slug": slug, "title": it.get("title") or "", "num": it.get("num") or 0,
                "stars": it.get("stars"), "ton": it.get("ton"),
                "m": (m or {}).get("name") or "", "b": (b or {}).get("name") or "",
                "bc": (b or {}).get("center"), "be": (b or {}).get("edge"), "t": int(time.time()),
            }
            self.favs.insert(0, rec)
            del self.favs[100:]
            msg = tr("fav_added")
        _jsave(self.plugin, "favs", self.favs)
        self._toast_in(msg)
        self._update_chips()
        self._refresh_info()
        if self.show_favs:
            self._render_full()
        else:
            self._restyle_fav_marks()

    def _restyle_fav_marks(self) -> None:
        self._render_full_keep_scroll()

    def _fav_items(self) -> List[Dict[str, Any]]:
        out = []
        for f in self.favs:
            try:
                bc = f.get("bc")
                out.append({
                    "slug": f.get("slug") or "", "title": f.get("title") or "", "num": f.get("num") or 0,
                    "stars": f.get("stars"), "ton": f.get("ton"),
                    "model": {"name": f["m"]} if f.get("m") else None,
                    "backdrop": ({"name": f.get("b") or "", "center": bc, "edge": f.get("be") if f.get("be") is not None else bc}
                                 if bc is not None else None),
                    "pattern": None,
                })
            except Exception:
                continue
        return out

    def _hide_actions(self) -> None:
        v = self.actions_view
        self.actions_view = None
        if v is not None:
            try:
                self.root.removeView(v)
            except Exception:
                pass

    def _action_btn(self, label: str, fn) -> Any:
        b = mk_text(self.ctx, label, 15, argb(255, 255, 255, 255), bold=True)
        b.setGravity(Gravity.CENTER_VERTICAL)
        b.setPadding(dp(16), dp(13), dp(16), dp(13))
        b.setBackground(glass_bg(argb(46, 255, 255, 255), argb(24, 255, 255, 255), argb(40, 255, 255, 255), 14))
        b.setOnClickListener(OnClickListener(lambda v: (self._hide_actions(), fn())))
        press_effect(b)
        return b

    def _show_actions(self, it: Dict[str, Any]) -> bool:
        if self.closed or self.closing:
            return True
        try:
            self._hide_actions()
            self._haptic()
            ctx, p = self.ctx, self.pal
            slug = it.get("slug") or ""
            ov = FrameLayout(ctx)
            ov.setBackgroundColor(argb(120, 0, 0, 0))
            ov.setClickable(True)
            ov.setOnClickListener(OnClickListener(lambda v: self._hide_actions()))
            card = LinearLayout(ctx)
            card.setOrientation(LinearLayout.VERTICAL)
            card.setPadding(dp(14), dp(14), dp(14), dp(10))
            card.setBackground(glass_bg(p.toast_a, p.toast_b, p.toast_stroke, 24))
            card.setClickable(True)
            title = mk_text(ctx, "%s #%s" % (it.get("title") or "NFT", it.get("num")), 16, argb(255, 255, 255, 255), bold=True)
            tlp = LinearLayout.LayoutParams(-1, -2)
            tlp.bottomMargin = dp(10)
            tlp.leftMargin = dp(4)
            card.addView(title, tlp)
            is_fav = self._fav_index(slug) >= 0
            actions = [
                (tr("act_open"), lambda: self._open_gift(slug)),
                (tr("act_copy"), lambda: self._copy_link(slug)),
                (tr("share"), lambda: self._share(slug)),
                (tr("act_browser"), lambda: _open_browser(ctx, "https://t.me/nft/" + slug)),
                (tr("act_unfav") if is_fav else tr("act_fav"), lambda: self._toggle_fav(it)),
            ]
            for label, fn in actions:
                lp = LinearLayout.LayoutParams(-1, -2)
                lp.bottomMargin = dp(6)
                card.addView(self._action_btn(label, fn), lp)
            clp = FrameLayout.LayoutParams(-1, -2)
            clp.gravity = Gravity.CENTER
            clp.leftMargin = dp(28)
            clp.rightMargin = dp(28)
            ov.addView(card, clp)
            self.root.addView(ov, FrameLayout.LayoutParams(-1, -1))
            self.actions_view = ov
            ov.setAlpha(0.0)
            ov.animate().alpha(1.0).setDuration(self.d(180)).start()
        except Exception as e:
            _lg("actions error: %s" % e)
        return True

    # ---- client-side filtering / stats -----------------------------------
    def _passes(self, it: Dict[str, Any]) -> bool:
        st, tn = it.get("stars"), it.get("ton")
        if self.cur == 1 and st is None:
            return False
        if self.cur == 2 and tn is None:
            return False
        if st is not None:
            if self.pmin and st < self.pmin:
                return False
            if self.pmax and st > self.pmax:
                return False
        if self.rare_pm:
            m = it.get("model")
            pm = (m or {}).get("pm") or 0
            if pm and pm > self.rare_pm:
                return False
        return True

    def _view_items(self) -> List[Dict[str, Any]]:
        if self.show_favs:
            return self._fav_items()
        v = [it for it in self.items if self._passes(it)]
        if self.sort == 3:
            v.sort(key=lambda it: (1, it["stars"]) if it.get("stars") is not None else (0, it.get("ton") or 0), reverse=True)
        return v

    def _recalc(self, view: List[Dict[str, Any]]) -> None:
        stars = [it["stars"] for it in view if it.get("stars") is not None]
        self.floor_stars = min(stars) if stars else None

    def _delta_text(self, it: Dict[str, Any]):
        st, fl = it.get("stars"), self.floor_stars
        if st is None or not fl or self.show_favs:
            return "", False
        if st <= fl:
            return tr("floor_tag"), True
        return "+%d%%" % int(round((st / float(fl) - 1.0) * 100)), False

    def _floor_check(self, items: List[Dict[str, Any]]) -> None:
        if self.sort != 0:
            return
        try:
            stars = [it["stars"] for it in items if it.get("stars") is not None]
            if not stars:
                return
            floor = min(stars)
            ck = self._cache_key()
            key = "%s|%s|%s|%s" % (self.gift["gift_id"], ck[2], ck[3], ck[4])
            store = _jload(self.plugin, "floors", {})
            if not isinstance(store, dict):
                store = {}
            prev = store.get(key)
            now = int(time.time())
            if prev and prev.get("f"):
                self.prev_floor = int(prev["f"])
            if (not prev) or now - int(prev.get("t", 0)) > 6 * 3600:
                store[key] = {"f": int(floor), "t": now}
                if len(store) > 60:
                    for k in sorted(store, key=lambda x: store[x].get("t", 0))[:15]:
                        store.pop(k, None)
                _jsave(self.plugin, "floors", store)
        except Exception as e:
            _lg("floor check error: %s" % e)

    # ---- info / stats ----------------------------------------------------
    def _filter_desc(self) -> str:
        g = self.gift
        parts = []
        single = len(self.fset) == 1
        for key in FILTER_KEYS:
            if key in self.fset and g.get(key):
                a = g[key]
                s = a.get("name") or ""
                if single and a.get("rarity"):
                    s += " · " + a["rarity"]
                parts.append(s)
        if not parts:
            return tr("whole", g.get("title") or "NFT")
        return " + ".join(parts)

    def _refresh_info(self) -> None:
        try:
            view = self._view_items()
            self._recalc(view)
            if self.show_favs:
                line1 = tr("favorites", len(view))
            else:
                line1 = self._filter_desc()
                if self.total is not None:
                    line1 += "  ·  " + tr("on_sale", self.total)
            stars = [it["stars"] for it in view if it.get("stars") is not None]
            tons = [it["ton"] for it in view if it.get("ton") is not None and it.get("stars") is None]
            summary = [line1]
            extra = []
            floor_label = tr("tile_floor")
            if stars:
                fl, med, mx = min(stars), _median(stars), max(stars)
                vals = [fmt_stars(fl), fmt_stars(med), fmt_stars(mx)]
                summary.append(tr("sum_stats", *vals))
                if self.usd > 0:
                    extra.append("\u2248 $%s" % ("%.2f" % (fl * self.usd)).rstrip("0").rstrip("."))
                if self.prev_floor and self.prev_floor != fl and not self.show_favs:
                    pct = int(round((fl / float(self.prev_floor) - 1.0) * 100))
                    if pct != 0:
                        arrow = "\u25BC" if pct < 0 else "\u25B2"
                        floor_label = "%s  %s%d%%" % (tr("tile_floor"), arrow, abs(pct))
                        extra.append(tr("since_last", arrow, abs(pct)))
                if self.own_stars and not self.show_favs:
                    cheaper = len([x for x in stars if x < self.own_stars])
                    extra.append(tr("own_lot", fmt_stars(self.own_stars), cheaper))
            else:
                vals = ["\u2014", "\u2014", "\u2014"]
            if tons:
                extra.append(tr("from_ton", ("%.2f" % min(tons)).rstrip("0").rstrip(".")))
            if extra:
                summary.append(", ".join(extra))
            self.summary = "\n".join(summary)
            self.info.setText(line1)
            for v, t in zip(self.tile_vals, vals):
                v.setText(t)
            self.tile_labs[0].setText(floor_label)
            if extra:
                self.extra.setText("  \u00B7  ".join(extra))
                self.extra.setVisibility(View.VISIBLE)
            else:
                self.extra.setVisibility(View.GONE)
            self._update_chips()
        except Exception as e:
            _lg("info error: %s" % e)

    # ---- list rendering ---------------------------------------------------
    def _stop_pulse(self) -> None:
        for a in self.pulses:
            try:
                a.cancel()
            except Exception:
                pass
        self.pulses = []

    def _show_skeleton(self) -> None:
        ctx, p = self.ctx, self.pal
        self._stop_pulse()
        self.rendered = False
        self.list.removeAllViews()
        self.footer = None
        self.list.setAlpha(1.0)
        for i in range(6):
            row = LinearLayout(ctx)
            row.setOrientation(LinearLayout.HORIZONTAL)
            row.setGravity(Gravity.CENTER_VERTICAL)
            row.setPadding(dp(10), dp(10), dp(12), dp(10))
            row.setBackground(glass_bg(p.card_a, p.card_b, p.card_stroke, 18))
            lp = LinearLayout.LayoutParams(-1, -2)
            lp.bottomMargin = dp(8)
            row.setLayoutParams(lp)
            circ = View(ctx)
            circ.setBackground(glass_bg(p.skel, p.skel, None, 16))
            row.addView(circ, LinearLayout.LayoutParams(dp(52), dp(52)))
            col = LinearLayout(ctx)
            col.setOrientation(LinearLayout.VERTICAL)
            b1 = View(ctx)
            b1.setBackground(glass_bg(p.skel, p.skel, None, 5))
            b2 = View(ctx)
            b2.setBackground(glass_bg(p.skel, p.skel, None, 5))
            l1 = LinearLayout.LayoutParams(dp(150), dp(12))
            l2 = LinearLayout.LayoutParams(dp(100), dp(10))
            l2.topMargin = dp(8)
            col.addView(b1, l1)
            col.addView(b2, l2)
            cl = LinearLayout.LayoutParams(0, -2)
            cl.weight = 1.0
            cl.leftMargin = dp(12)
            row.addView(col, cl)
            pill = View(ctx)
            pill.setBackground(glass_bg(p.skel, p.skel, None, 12))
            row.addView(pill, LinearLayout.LayoutParams(dp(64), dp(26)))
            self.list.addView(row)
            row.setAlpha(0.0)
            row.animate().alpha(1.0).setStartDelay(i * 40).setDuration(260).start()
            if self.anim:
                try:
                    from android.animation import ObjectAnimator
                    a = ObjectAnimator.ofFloat(row, "alpha", jarray(jfloat)([0.45, 1.0]))
                    a.setDuration(820)
                    a.setRepeatCount(-1)
                    a.setRepeatMode(2)
                    a.setStartDelay(300 + i * 90)
                    a.start()
                    self.pulses.append(a)
                except Exception:
                    pass

    def _make_row(self, it: Dict[str, Any]) -> Any:
        ctx, p = self.ctx, self.pal
        tsz = 40 if self.compact else 52
        row = LinearLayout(ctx)
        row.setOrientation(LinearLayout.HORIZONTAL)
        row.setGravity(Gravity.CENTER_VERTICAL)
        pad = 7 if self.compact else 10
        row.setPadding(dp(pad), dp(pad), dp(12), dp(pad))
        row.setBackground(glass_bg(p.card_a, p.card_b, p.card_stroke, 18))
        lp = LinearLayout.LayoutParams(-1, -2)
        lp.bottomMargin = dp(6 if self.compact else 8)
        row.setLayoutParams(lp)
        row.addView(self._make_thumb(it.get("model"), it.get("backdrop"), tsz, 14 if self.compact else 16),
                    LinearLayout.LayoutParams(dp(tsz), dp(tsz)))

        col = LinearLayout(ctx)
        col.setOrientation(LinearLayout.VERTICAL)
        fav = self._fav_index(it.get("slug") or "") >= 0
        name = "%s%s #%s" % ("\u2665 " if fav else "", it.get("title") or "NFT", it.get("num"))
        col.addView(mk_text(ctx, name, 14.5 if self.compact else 15, p.text, bold=True), LinearLayout.LayoutParams(-2, -2))
        sub_parts = []
        for k in FILTER_KEYS:
            a = it.get(k)
            if a and a.get("name"):
                sub_parts.append(a["name"])
        sub_txt = " \u00B7 ".join(sub_parts)
        col.addView(mk_text(ctx, sub_txt, 12 if self.compact else 12.5, p.sub), LinearLayout.LayoutParams(-2, -2))
        if not self.compact and self.show_rar:
            rar = []
            for k, lab in (("model", tr("f_model")), ("backdrop", tr("f_backdrop")), ("pattern", tr("f_pattern"))):
                a = it.get(k)
                if a and a.get("rarity"):
                    rar.append("%s %s" % (lab, a["rarity"]))
            if rar:
                rv = mk_text(ctx, " \u00B7 ".join(rar), 11, p.sub)
                rv.setAlpha(0.75)
                col.addView(rv, LinearLayout.LayoutParams(-2, -2))
        cl = LinearLayout.LayoutParams(0, -2)
        cl.weight = 1.0
        cl.leftMargin = dp(12)
        cl.rightMargin = dp(8)
        row.addView(col, cl)

        right = LinearLayout(ctx)
        right.setOrientation(LinearLayout.VERTICAL)
        right.setGravity(Gravity.CENTER_HORIZONTAL)
        text, is_ton = fmt_price(it)
        price = mk_text(ctx, text, 13.5, p.ton_txt if is_ton else p.star_txt, bold=True)
        price.setGravity(Gravity.CENTER)
        price.setPadding(dp(11), dp(6), dp(11), dp(6))
        bg = p.ton_bg if is_ton else p.star_bg
        price.setBackground(glass_bg(bg, bg, p.ton_txt if is_ton else p.star_txt, 14, sw=0.8))
        right.addView(price, LinearLayout.LayoutParams(-2, -2))
        dtxt, is_floor = self._delta_text(it)
        if dtxt:
            dv = mk_text(ctx, dtxt, 11, argb(255, 90, 210, 130) if is_floor else p.sub, bold=is_floor)
            dv.setGravity(Gravity.CENTER)
            dlp = LinearLayout.LayoutParams(-2, -2)
            dlp.topMargin = dp(2)
            right.addView(dv, dlp)
        row.addView(right, LinearLayout.LayoutParams(-2, -2))

        slug = it.get("slug") or ""
        row.setOnClickListener(OnClickListener(lambda v, i=it: self._on_tap(i)))
        row.setOnLongClickListener(OnLongClickListener(lambda v, i=it: self._show_actions(i)))
        press_effect(row)
        return row

    def _make_message(self, text: str, retry: bool) -> Any:
        ctx, p = self.ctx, self.pal
        box = LinearLayout(ctx)
        box.setOrientation(LinearLayout.VERTICAL)
        box.setGravity(Gravity.CENTER)
        box.setPadding(dp(20), dp(36), dp(20), dp(20))
        msg = mk_text(ctx, text, 14.5, p.sub, single=False)
        msg.setGravity(Gravity.CENTER)
        box.addView(msg, LinearLayout.LayoutParams(-2, -2))
        if retry:
            btn = self._make_button(tr("retry"), lambda v: self._load(True))
            blp = LinearLayout.LayoutParams(-2, dp(40))
            blp.topMargin = dp(16)
            box.addView(btn, blp)
        return box

    def _make_button(self, label: str, fn) -> Any:
        p = self.pal
        b = mk_text(self.ctx, label, 14, p.text, bold=True)
        b.setGravity(Gravity.CENTER)
        b.setPadding(dp(22), 0, dp(22), 0)
        b.setBackground(glass_bg(p.ind_a, p.ind_b, p.ind_stroke, 20))
        b.setOnClickListener(OnClickListener(fn))
        press_effect(b)
        return b

    def _drop_footer(self) -> None:
        f = self.footer
        self.footer = None
        if f is not None:
            try:
                self.list.removeView(f)
            except Exception:
                pass

    def _add_footer(self, n_new: int) -> None:
        if self.next_offset and not self.show_favs:
            self.footer = self._make_button(tr("show_more"), lambda v: self._load(False))
            flp = LinearLayout.LayoutParams(-1, dp(44))
            flp.topMargin = dp(2)
            flp.bottomMargin = dp(6)
            self.list.addView(self.footer, flp)
            fade_in(self.footer, min(n_new, 12) * 42 + 60, 10.0, 320)

    def _render_full(self) -> None:
        self._stop_pulse()
        self.list.removeAllViews()
        self.footer = None
        self.list.setAlpha(1.0)
        self.rendered = True
        view = self._view_items()
        self._recalc(view)
        if not view:
            if self.show_favs:
                txt = tr("fav_empty")
            elif self.items:
                txt = tr("no_match")
            else:
                txt = tr("no_similar")
            box = self._make_message(txt, False)
            self.list.addView(box)
            fade_in(box, 0, 10.0, 360)
            self._add_footer(0)
            return
        for i, it in enumerate(view):
            row = self._make_row(it)
            self.list.addView(row)
            fade_in(row, min(i, 12) * 42, 16.0, 380)
        self._add_footer(len(view))

    def _render_full_keep_scroll(self) -> None:
        try:
            y = int(self.scroll.getScrollY())
        except Exception:
            y = 0
        self._render_full()
        try:
            self.scroll.post(R(lambda: self.scroll.scrollTo(0, y)))
        except Exception:
            pass

    def _render_append(self, batch: List[Dict[str, Any]]) -> None:
        self._stop_pulse()
        self._drop_footer()
        self.list.setAlpha(1.0)
        self._recalc(self._view_items())
        for i, it in enumerate(batch):
            row = self._make_row(it)
            self.list.addView(row)
            fade_in(row, min(i, 12) * 42, 16.0, 380)
        self._add_footer(len(batch))

    # ---- data ----------------------------------------------------------------
    def _cache_key(self):
        g = self.gift
        m = g["model"]["doc_id"] if ("model" in self.fset and g.get("model")) else 0
        b = g["backdrop"]["id"] if ("backdrop" in self.fset and g.get("backdrop")) else -1
        pt = g["pattern"]["doc_id"] if ("pattern" in self.fset and g.get("pattern")) else 0
        return (self.account, g["gift_id"], m, b, pt, 0 if self.sort in (0, 3) else self.sort)

    def _load(self, reset: bool) -> None:
        if self.closed or self.closing:
            return
        key = self._cache_key()
        if reset:
            self.loading = False
            self.more_failed = False
            self.items = []
            self.next_offset = ""
            self.total = None
            self.auto_pages = 0
            self.rendered = False
            self.prev_floor = None
            hit = _CACHE.get(key) if (self.ttl > 0 and self.sort != 3) else None
            if hit and time.time() - hit["ts"] < self.ttl:
                self.gen += 1  # invalidate anything still in flight
                self.items = list(hit["items"])
                self.next_offset = hit["next"]
                self.total = hit["total"]
                self._floor_check(self.items)
                self._refresh_info()
                if not self.show_favs:
                    self._render_full()
                return
            self._show_skeleton()
        else:
            if self.loading or not self.next_offset:
                return
            self.more_failed = False
            if self.footer is not None:
                try:
                    self.footer.setText(tr("loading"))
                    self.footer.setAlpha(0.6)
                except Exception:
                    pass
        self.gen += 1
        gen = self.gen
        self.loading = True
        offset = "" if reset else self.next_offset

        def _cb(response, error):
            run_on_ui_thread(lambda: self._on_response(gen, key, reset, response, error))

        try:
            req = build_resale_request(self.gift, self.fset, offset, self.sort, self.page_size)
            try:
                send_request(req, _cb, account=self.account)
            except TypeError:
                send_request(req, _cb)
        except Exception as e:
            self.loading = False
            _lg("request error: %s\n%s" % (e, traceback.format_exc()))
            self._fail(str(e), reset)

    def _fail(self, text: str, reset: bool = True) -> None:
        """reset=True: replace the list with an error; False: keep the list, offer a retry."""
        if self.closed:
            return
        self.load_all = False
        self._update_chips()
        try:
            if reset:
                self._stop_pulse()
                self.list.removeAllViews()
                self.footer = None
                self.list.setAlpha(1.0)
                self.rendered = True
                box = self._make_message(tr("load_fail") + text, True)
                self.list.addView(box)
                fade_in(box, 0, 10.0, 360)
            else:
                self.more_failed = True
                if self.footer is not None:
                    self.footer.setText(tr("retry"))
                    self.footer.setAlpha(1.0)
                self._toast_in(tr("load_fail_toast") + text)
        except Exception:
            pass

    def _on_response(self, gen: int, key: Any, reset: bool, response: Any, error: Any) -> None:
        if gen != self.gen or self.closed:
            return
        self.loading = False
        try:
            if error is not None:
                self._fail(_err_text(error), reset)
                return
            if response is None or not hasattr(response, "gifts"):
                self._fail(tr("bad_response"), reset)
                return
            gifts = response.gifts
            own = self.gift.get("slug")
            batch: List[Dict[str, Any]] = []
            skipped = 0
            for i in range(gifts.size()):
                g = gifts.get(i)
                if _obj_kind(g) != "stargiftunique":
                    continue
                d = parse_gift(g)
                if own and d["slug"] == own:
                    skipped += 1
                    continue
                batch.append(d)
            nxt = ""
            try:
                nxt = str(response.next_offset or "")
            except Exception:
                nxt = ""
            total = None
            try:
                total = _num(response.count, len(batch))
            except Exception:
                total = None
            self.items.extend(batch)
            self.next_offset = nxt
            use_cache = self.ttl > 0 and self.sort != 3
            if reset:
                if total is not None:
                    total = max(len(self.items), total - skipped)
                self.total = total
                self._floor_check(self.items)
                if use_cache:
                    _CACHE[key] = {"items": list(self.items), "next": nxt, "total": total, "ts": time.time()}
                    if len(_CACHE) > 40:
                        for k in sorted(_CACHE, key=lambda x: _CACHE[x]["ts"])[:10]:
                            _CACHE.pop(k, None)
            else:
                if self.total is not None and skipped:
                    self.total = max(len(self.items), self.total - skipped)
                ent = _CACHE.get(key) if use_cache else None
                if ent is not None:
                    ent["items"] = list(self.items)
                    ent["next"] = nxt
                    ent["total"] = self.total
            self._refresh_info()

            cont = False
            if self.next_offset and len(self.items) < MAX_ALL:
                if self.load_all or self.sort == 3:
                    cont = True
                elif not self.show_favs and not self._view_items() and self.auto_pages < 8:
                    self.auto_pages += 1
                    cont = True
            if not self.next_offset or len(self.items) >= MAX_ALL:
                self.load_all = False

            if self.show_favs:
                pass
            elif cont and (self.sort == 3 or not self._view_items()):
                pass  # keep the skeleton until there is something to show
            elif self.sort == 3 or reset or not self.rendered:
                self._render_full()
            else:
                self._render_append([it for it in batch if self._passes(it)])
            if cont:
                self._load(False)
            self._update_chips()
        except Exception as e:
            _lg("response error: %s\n%s" % (e, traceback.format_exc()))
            self._fail(str(e), reset)


def _open_url(ctx: Any, url: str) -> None:
    try:
        i = Intent(Intent.ACTION_VIEW, Uri.parse(url))
        i.setPackage(ctx.getPackageName())
        ctx.startActivity(i)
        return
    except Exception as e:
        _lg("intent open failed: %s" % e)
    try:
        from org.telegram.messenger.browser import Browser
        Browser.openUrl(ctx, url)
    except Exception as e:
        _lg("browser open failed: %s" % e)
        _toast(url)


# ---------------------------------------------------------------------------
# button ("pill") injected into the NFT sheet
# ---------------------------------------------------------------------------
def _make_pill(ctx: Any, on_click) -> Any:
    pill = LinearLayout(ctx)
    pill.setOrientation(LinearLayout.HORIZONTAL)
    pill.setGravity(Gravity.CENTER_VERTICAL)
    pill.setPadding(dp(14), dp(9), dp(17), dp(9))
    pill.setBackground(glass_bg(argb(170, 44, 52, 78), argb(150, 18, 21, 36), argb(120, 255, 255, 255), 20))
    try:
        pill.setElevation(float(dp(8)))
    except Exception:
        pass
    icon_added = False
    try:
        res = ctx.getResources()
        rid = int(res.getIdentifier("msg_search", "drawable", ctx.getPackageName()))
        if rid:
            iv = ImageView(ctx)
            iv.setImageResource(rid)
            iv.setColorFilter(argb(255, 255, 255, 255))
            pill.addView(iv, LinearLayout.LayoutParams(dp(18), dp(18)))
            icon_added = True
    except Exception:
        icon_added = False
    if not icon_added:
        pill.addView(mk_text(ctx, "\u2726", 15, argb(255, 255, 255, 255)), LinearLayout.LayoutParams(-2, -2))
    label = mk_text(ctx, tr("title"), 14.5, argb(255, 255, 255, 255), bold=True)
    llp = LinearLayout.LayoutParams(-2, -2)
    llp.leftMargin = dp(8)
    pill.addView(label, llp)
    pill.setOnClickListener(OnClickListener(on_click))
    press_effect(pill)
    return pill


class _ShowHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            self.plugin.on_dialog_shown(param.thisObject)
        except Exception as e:
            _dbg("show hook error: %s" % e)


class _CaptureHook(MethodHook):
    """Hooked into StarGiftSheet.set(...)-like methods: grabs the gift straight from the arguments."""

    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            self.plugin.on_sheet_method(param)
        except Exception as e:
            _dbg("capture hook error: %s" % e)


# ---------------------------------------------------------------------------
# plugin
# ---------------------------------------------------------------------------
class SimilarNftPlugin(BasePlugin):
    def _apply_lang(self) -> None:
        _set_lang(self.get_setting("language", 0))

    def on_plugin_load(self):
        self._apply_lang()
        self._attached = set()
        self._done = set()
        self._captured = {}
        self._menu_on = False
        self._menu_ref = None
        self._last_open = 0.0
        _dbg("plugin load v%s" % __version__)
        try:
            from org.telegram.messenger import BuildVars
            _dbg("app version: %s" % BuildVars.BUILD_VERSION_STRING)
        except Exception:
            pass
        n = 0
        hooked_methods = set()
        for cname in ("org.telegram.ui.ActionBar.BottomSheet", "android.app.Dialog") + _SHEET_CLASSES:
            try:
                c = _jcls(cname)
                if c is None:
                    _dbg("class %s not found" % cname)
                    continue
                m = _method0(c, "show")
                if m is None:
                    _dbg("%s has no show()" % cname)
                    continue
                mid = "%s.%s" % (str(m.getDeclaringClass().getName()), "show")
                if mid in hooked_methods:
                    continue
                hooked_methods.add(mid)
                self.hook_method(m, _ShowHook(self))
                n += 1
                _dbg("hooked %s" % mid)
            except Exception as e:
                _dbg("hook %s failed: %s" % (cname, e))
        if n == 0:
            # last resort: hook_all_methods on the sheet classes
            for cname in ("org.telegram.ui.ActionBar.BottomSheet", "android.app.Dialog"):
                try:
                    c = _jcls(cname)
                    if c is not None and hasattr(self, "hook_all_methods"):
                        self.hook_all_methods(c, "show", _ShowHook(self))
                        n += 1
                        _dbg("hook_all_methods %s.show" % cname)
                        break
                except Exception as e:
                    _dbg("hook_all_methods %s failed: %s" % (cname, e))
        n2 = 0
        try:
            n2 = self._hook_sheet_methods()
        except Exception as e:
            _dbg("sheet hooks failed: %s" % e)
        fallback_menu = False
        if n == 0:
            _dbg("WARNING: show() not hooked; enabling the message menu item as a fallback")
            fallback_menu = True
        self._sync_menu(bool(self.get_setting("menu_item", False)) or fallback_menu)

    def on_plugin_unload(self):
        try:
            self._sync_menu(False)
        except Exception:
            pass
        try:
            _CACHE.clear()
            self._captured.clear()
        except Exception:
            pass

    def _hook_sheet_methods(self) -> int:
        total = 0
        Modifier = jclass("java.lang.reflect.Modifier")
        for cname in _SHEET_CLASSES:
            c = _jcls(cname)
            if c is None:
                _dbg("class %s not found" % cname)
                continue
            for m in c.getDeclaredMethods():
                try:
                    name = str(m.getName())
                    mods = int(m.getModifiers())
                    if "$" in name or m.isSynthetic() or Modifier.isStatic(mods) or Modifier.isAbstract(mods):
                        continue
                    pts = [str(t.getName()) for t in m.getParameterTypes()]
                    if not pts or not any(("StarGift" in t) or t.endswith(".MessageObject") for t in pts):
                        continue
                    m.setAccessible(True)
                    self.hook_method(m, _CaptureHook(self))
                    total += 1
                    _dbg("hooked %s.%s(%s)" % (cname.split(".")[-1], name, ", ".join(t.split(".")[-1] for t in pts)))
                    if total >= 30:
                        return total
                except Exception as e:
                    _dbg("hook method failed: %s" % e)
        return total

    def on_sheet_method(self, param) -> None:
        obj = param.thisObject
        if obj is None:
            return
        found = None
        for a in param.args:
            if a is None:
                continue
            g = find_unique_gift(a, 300, 5)
            if g is not None:
                found = g
                break
        if found is not None:
            if len(self._captured) > 100:
                self._captured.clear()
            self._captured[int(System.identityHashCode(obj))] = found
            _dbg("captured NFT from sheet call")

    # ---- settings -----------------------------------------------------------
    def _on_menu_switch(self, value):
        self._sync_menu(bool(value))

    def _copy_debug(self, *args):
        ctx = _activity()
        text = "SimilarNFT v%s\n%s" % (__version__, "\n".join(_DEBUG[-160:]))
        ok = bool(ctx is not None and _copy(ctx, text))
        _toast(tr("diag_copied") if ok else tr("toast_copy_fail"))

    def create_settings(self) -> List[Any]:
        self._apply_lang()
        fl = _filter_labels()
        combos = [" + ".join(fl[FILTER_KEYS.index(k)] for k in combo) for combo in FILTER_SETS]
        sorts = [_cap(x) for x in _sort_labels()]
        items = [
            Header(text=tr("s_hdr_lang")),
            Selector(key="language", text=tr("s_lang"), default=0,
                     items=[tr("s_lang_auto"), "Русский", "English", "Українська"]),
            Divider(text=tr("s_lang_sub")),
            Header(text=tr("s_hdr_button")),
            Switch(key="enabled", text=tr("s_enabled"), default=True, subtext=tr("s_enabled_sub")),
            Selector(key="btn_pos", text=tr("s_btn_pos"), default=0,
                     items=[tr("s_pos_0"), tr("s_pos_1"), tr("s_pos_2")]),
            Header(text=tr("s_hdr_list")),
            Selector(key="default_filter", text=tr("s_default_filter"), default=0, items=combos),
            Switch(key="remember_filters", text=tr("s_remember"), default=False, subtext=tr("s_remember_sub")),
            Selector(key="sort", text=tr("s_sort"), default=0, items=sorts),
            Selector(key="page_size", text=tr("s_page_size"), default=1, items=["12", "24", "50"]),
            Selector(key="tap_action", text=tr("s_tap"), default=0, items=[tr("s_tap_0"), tr("s_tap_1")]),
            Selector(key="list_height", text=tr("s_height"), default=1,
                     items=[tr("s_h_0"), tr("s_h_1"), tr("s_h_2")]),
            Switch(key="infinite_scroll", text=tr("s_infinite"), default=True, subtext=tr("s_infinite_sub")),
            Switch(key="compact", text=tr("s_compact"), default=False, subtext=tr("s_compact_sub")),
            Switch(key="rarity_rows", text=tr("s_rar_rows"), default=True),
            Header(text=tr("s_hdr_filters")),
            Selector(key="price_min", text=tr("s_price_min"), default=0,
                     items=[tr("s_none"), "100 \u2605", "500 \u2605", "1 000 \u2605", "5 000 \u2605"]),
            Selector(key="price_max", text=tr("s_price_max"), default=0,
                     items=[tr("s_none"), "500 \u2605", "1 000 \u2605", "2 000 \u2605", "5 000 \u2605",
                            "10 000 \u2605", "50 000 \u2605"]),
            Selector(key="rarity_limit", text=tr("s_rarity"), default=0,
                     items=[tr("s_any"), "\u2264 5%", "\u2264 2%", "\u2264 1%"]),
            Selector(key="usd_rate", text=tr("s_usd"), default=0,
                     items=[tr("s_off"), tr("s_usd_item", "0.013"), tr("s_usd_item", "0.02")]),
            Header(text=tr("s_hdr_look")),
            Selector(key="theme", text=tr("s_theme"), default=0,
                     items=[tr("s_theme_0"), tr("s_theme_1"), tr("s_theme_2")]),
            Switch(key="accent_backdrop", text=tr("s_accent"), default=True),
            Switch(key="glass_blur", text=tr("s_blur"), default=True, subtext=tr("s_blur_sub")),
            Switch(key="animations", text=tr("s_anim"), default=True),
            Switch(key="haptics", text=tr("s_haptics"), default=True),
            Selector(key="cache_ttl", text=tr("s_cache"), default=2,
                     items=[tr("s_cache_0"), tr("s_cache_1"), tr("s_cache_2"), tr("s_cache_3")]),
            Header(text=tr("s_hdr_fallback")),
            Switch(key="menu_item", text=tr("s_menu_item"), default=False, subtext=tr("s_menu_item_sub"),
                   on_change=self._on_menu_switch),
        ]
        try:
            from ui.settings import Text as _SText
            items.append(Header(text=tr("s_hdr_diag")))
            items.append(_SText(text=tr("s_clear_favs"), icon="msg_delete",
                                on_click=lambda *a: self.set_setting("favs", "[]")))
            items.append(_SText(text=tr("s_reset_floors"), icon="msg_delete",
                                on_click=lambda *a: self.set_setting("floors", "{}")))
            items.append(_SText(text=tr("s_copy_report"), icon="msg_copy", on_click=self._copy_debug))
        except Exception as e:
            _dbg("no Text setting item: %s" % e)
        items.append(Divider(text=tr("s_footer")))
        return items

    # ---- menu item ------------------------------------------------------------
    def _sync_menu(self, want: bool) -> None:
        if want and not self._menu_on:
            try:
                try:
                    item = MenuItemData(
                        menu_type=MenuItemType.MESSAGE_CONTEXT_MENU,
                        text=tr("title"),
                        on_click=self._on_menu_click,
                        item_id=MENU_ID,
                        priority=5,
                    )
                except TypeError:
                    item = MenuItemData(
                        menu_type=MenuItemType.MESSAGE_CONTEXT_MENU,
                        text=tr("title"),
                        on_click=self._on_menu_click,
                        priority=5,
                    )
                res = self.add_menu_item(item)
                ref = res if (isinstance(res, str) and res) else getattr(item, "item_id", None)
                self._menu_ref = ref or MENU_ID
                self._menu_on = True
            except Exception as e:
                _dbg("add menu item failed: %s" % e)
        elif not want and self._menu_on:
            try:
                self.remove_menu_item(self._menu_ref or MENU_ID)
            except Exception as e:
                _dbg("remove menu item failed: %s" % e)
            self._menu_on = False
            self._menu_ref = None

    def _on_menu_click(self, context: Dict[str, Any]):
        self._apply_lang()
        try:
            msg = context.get("message")
            g = find_unique_gift(msg)
            if g is None:
                _toast(tr("no_nft_msg"))
                return
            acc = context.get("account")
            acc = acc if isinstance(acc, int) else int(UserConfig.selectedAccount)
            self.open_similar(parse_gift(g), acc)
        except Exception as e:
            _dbg("menu click error: %s\n%s" % (e, traceback.format_exc()))
            _toast(tr("open_fail"))

    # ---- NFT sheet detection -------------------------------------------------
    def on_dialog_shown(self, dialog: Any) -> None:
        if dialog is None or not self.get_setting("enabled", True):
            return
        name = str(dialog.getClass().getName())
        low = name.lower()
        if "gift" not in low and "nft" not in low:
            return
        key = int(System.identityHashCode(dialog))
        if key in self._attached:
            return
        self._attached.add(key)
        if len(self._attached) > 300:
            self._attached = {key}
        _dbg("gift dialog shown: %s" % name)
        _describe_dialog(dialog)
        delays = [0, 150, 400, 800, 1400, 2200, 3200, 5000, 8000]
        for i, dl in enumerate(delays):
            run_on_ui_thread(lambda d=dialog, k=key, n=i: self._try_attach(d, k, n), dl)

    def _detect(self, dialog: Any, key: int):
        """returns (info, slug_hint); info is a parsed unique gift, slug_hint comes from the sheet's texts"""
        g = self._captured.get(key)
        src = "captured"
        if g is None:
            g = find_unique_gift(dialog)
            src = "fields"
        if g is not None:
            info = parse_gift(g)
            if info.get("gift_id"):
                return info, None, src
        try:
            hint = slug_from_ui(dialog.getWindow().getDecorView())
        except Exception:
            hint = None
        return None, hint, "ui-text"

    def _try_attach(self, dialog: Any, key: int, attempt: int) -> None:
        try:
            if key in self._done:
                return
            if not dialog.isShowing():
                return
            info, hint, src = self._detect(dialog, key)
            if info is None and not hint:
                if attempt in (0, 4, 8):
                    _dbg("attempt %d: NFT not found in %s" % (attempt, dialog.getClass().getName()))
                return
            self._done.add(key)
            if len(self._done) > 300:
                self._done = {key}
            if info is not None:
                _dbg("NFT sheet via %s: %s #%s (gift_id=%s, model=%s, backdrop=%s)" % (
                    src, info["title"], info["num"], info["gift_id"],
                    (info["model"] or {}).get("name"), (info["backdrop"] or {}).get("name")))
            else:
                _dbg("NFT sheet via ui-text, slug=%s" % hint)
            self._attach_pill(dialog, key, info, hint)
        except Exception as e:
            _dbg("attach error: %s\n%s" % (e, traceback.format_exc()))

    def _sheet_top_fn(self, dialog: Any, decor: Any):
        """returns a function giving the y (in decor coordinates) of the top edge of the visible sheet.

        The sheet's own containerView may span the whole window, so instead the view tree is scanned for the
        topmost wide, tall, non-fullscreen view (the sheet / its coloured header) and that view is tracked."""
        loc = jarray(jint)([0, 0])
        dloc = jarray(jint)([0, 0])
        state: Dict[str, Any] = {"v": None, "n": 0}

        def _scan():
            dw, dh = int(decor.getWidth()), int(decor.getHeight())
            if dw <= 0 or dh <= 0:
                return None
            decor.getLocationOnScreen(dloc)
            oy = int(dloc[1])
            best, best_key = None, None
            for v in _iter_views(decor, 1500):
                try:
                    w, h = int(v.getWidth()), int(v.getHeight())
                    if w < dw * 0.9 or h < dp(120) or h >= dh * 0.95:
                        continue
                    if not v.isShown():
                        continue
                    v.getLocationOnScreen(loc)
                    top = int(loc[1]) - oy
                    if top < 0:
                        continue
                    key = (top, -h)
                    if best_key is None or key < best_key:
                        best, best_key = v, key
                except Exception:
                    continue
            return best

        def _top():
            try:
                v = state["v"]
                state["n"] += 1
                bad = v is None or v.getParent() is None or int(v.getHeight()) <= 0 or not v.isShown()
                if bad or state["n"] % 45 == 1:
                    nv = _scan()
                    if nv is not None:
                        state["v"] = v = nv
                    elif bad:
                        state["v"] = v = None
                if v is None:
                    return None
                v.getLocationOnScreen(loc)
                decor.getLocationOnScreen(dloc)
                return int(loc[1]) - int(dloc[1])
            except Exception:
                return None

        return _top

    def _attach_pill(self, dialog: Any, key: int, info: Optional[Dict[str, Any]], hint: Optional[str]) -> None:
        self._apply_lang()
        win = dialog.getWindow()
        decor = win.getDecorView()
        group = cast(ViewGroup, decor)
        ctx = dialog.getContext()
        account = _account_of(dialog)

        def _click(v):
            self._on_pill_click(dialog, key, account, info, hint)

        pill = _make_pill(ctx, _click)
        mode = _to_int(self.get_setting("btn_pos", 0), 0)
        edge_to_edge = False
        try:
            edge_to_edge = (int(win.getAttributes().flags) & LP_NO_LIMITS) != 0
        except Exception:
            edge_to_edge = False
        sb = 0
        try:
            sb = int(AndroidUtilities.statusBarHeight)
        except Exception:
            sb = 0
        nav = 0
        try:
            nav = int(AndroidUtilities.navigationBarHeight) if edge_to_edge else 0
        except Exception:
            nav = 0

        lp = FrameLayout.LayoutParams(-2, -2)
        if mode == 2:
            lp.gravity = Gravity.BOTTOM | Gravity.CENTER_HORIZONTAL
            lp.bottomMargin = dp(104) + nav
        else:
            lp.gravity = Gravity.TOP | Gravity.CENTER_HORIZONTAL
            lp.topMargin = (dp(10) + (sb if edge_to_edge else 0)) if mode == 1 else 0
        group.addView(pill, lp)
        pill.setAlpha(0.0)
        pill.setScaleX(0.82)
        pill.setScaleY(0.82)
        anim = pill.animate().alpha(1.0).scaleX(1.0).scaleY(1.0).setStartDelay(120).setDuration(480).setInterpolator(
            OvershootInterpolator(1.25)
        )
        if mode != 0:
            pill.setTranslationY(float(dp(-14) if mode == 1 else dp(14)))
            anim = anim.translationY(0.0)
        anim.start()
        if mode == 0:
            self._track_pill(dialog, decor, pill, sb if edge_to_edge else 0)

    def _track_pill(self, dialog: Any, decor: Any, pill: Any, sb: int) -> None:
        """keeps the pill floating just above the top edge of the sheet (follows drags / scrolling)"""
        top_fn = self._sheet_top_fn(dialog, decor)
        state = {"y": None}
        holder: List[Any] = []

        def _tick():
            try:
                if not dialog.isShowing() or pill.getParent() is None:
                    return
                ph = int(pill.getHeight()) or dp(40)
                lo = sb + dp(6)
                hi = max(lo, int(decor.getHeight()) - dp(150) - ph)
                top = top_fn() if top_fn is not None else None
                if top is None:
                    y = state["y"] if state["y"] is not None else int(int(decor.getHeight()) * 0.32) - ph - dp(10)
                else:
                    y = top - ph - dp(10)
                    if y < lo:
                        y = lo
                y = max(lo, min(int(y), hi))
                if state["y"] != y:
                    pill.setTranslationY(float(y))
                    state["y"] = y
            except Exception:
                pass
            try:
                pill.postOnAnimation(holder[0])
            except Exception:
                pass

        holder.append(R(_tick))
        pill.post(holder[0])

    def _on_pill_click(self, dialog: Any, key: int, account: int, info: Optional[Dict[str, Any]], hint: Optional[str]) -> None:
        ctx = _activity() or dialog.getContext()
        try:
            # the sheet can be re-used for another gift, so resolve it again on tap
            g = self._captured.get(key)
            if g is None:
                g = find_unique_gift(dialog)
            cur = None
            if g is not None:
                parsed = parse_gift(g)
                if parsed.get("gift_id"):
                    cur = parsed
            if cur is None:
                cur = info
            if cur is not None:
                self.open_similar(cur, account, dialog)
                return
            slug = hint or slug_from_ui(dialog.getWindow().getDecorView())
            if not slug:
                _sys_toast(ctx, tr("nft_undetected"))
                return
            now = time.time()
            if now - self._last_open < 0.7:
                return
            _sys_toast(ctx, tr("nft_loading"))

            def _got(gift, err):
                if gift is None:
                    _dbg("fetch by slug %s failed: %s" % (slug, err))
                    _sys_toast(ctx, tr("nft_load_fail", err))
                    return
                self.open_similar(parse_gift(gift), account, dialog)

            fetch_gift_by_slug(slug, account, _got)
        except Exception as e:
            _dbg("pill click error: %s\n%s" % (e, traceback.format_exc()))
            _sys_toast(ctx, tr("err_generic", e))

    # ---- opening the sheet ----------------------------------------------------
    def open_similar(self, info: Dict[str, Any], account: int, host: Any = None) -> None:
        self._apply_lang()
        try:
            now = time.time()
            if now - self._last_open < 0.7:  # ignore double taps
                return
            self._last_open = now
            if not info.get("gift_id"):
                _toast(tr("gift_type_fail"))
                return
            ctx = _activity()
            if ctx is None:
                _toast(tr("no_window"))
                return
            SimilarSheet(self, ctx, account, info, host).show()
        except Exception as e:
            _dbg("open error: %s\n%s" % (e, traceback.format_exc()))
            _toast(tr("open_fail_e", e))
