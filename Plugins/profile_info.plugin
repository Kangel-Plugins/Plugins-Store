            value = str(self.get_setting(SETTING_PROMPT_PI, "") or "").strip()
            return value or AI_PROMPT_DEFAULT
        except Exception as e:
            log(f"[PI] _prompt_pi error: {e}")
            return AI_PROMPT_DEFAULT

    def _prompt_pb(self) -> str:
        try:
            value = str(self.get_setting(SETTING_PROMPT_PB, "") or "").strip()
            return value or PB_PROMPT_DEFAULT
