class PinnedHTTPSConnection(http.client.HTTPSConnection):
    def __init__(self, host, ip, port=HTTPS_PORT, timeout=AI_TIMEOUT):
        try:
            super().__init__(host, port, timeout=timeout, context=ssl.create_default_context())
            self.pinned_ip = ip
        except Exception as e:
            log(f"[PI] PinnedHTTPSConnection.__init__ error: {e}")
            raise

    def connect(self):
        try:
            sock = socket.create_connection((self.pinned_ip, self.port), self.timeout)
            self.sock = self._context.wrap_socket(sock, server_hostname=self.host)
        except Exception as e:
            log(f"[PI] PinnedHTTPSConnection.connect error: {e}")
            raise

def _key_create_view(context, list_view, current_account, class_guid, resources_provider):
    cell = TextCell(context)
    try:
        cell.setBackgroundColor(Theme.getColor(Theme.key_windowBackgroundWhite))
    except Exception as e:
        log(f"[PI] _key_create_view error: {e}")
    return cell

def _fit_value(label: str, value: str) -> str:
    value = " ".join(str(value or "").split())
    if not value:
        return ""
    try:
        size = float(AndroidUtilities.dp(16))
        label_paint = Paint(Paint.ANTI_ALIAS_FLAG)
        label_paint.setTextSize(size)
        label_paint.setTypeface(Typeface.DEFAULT_BOLD)
        value_paint = Paint(Paint.ANTI_ALIAS_FLAG)
        value_paint.setTextSize(size)
        total = float(AndroidUtilities.displaySize.x) - AndroidUtilities.dp(116)
        avail = total - float(label_paint.measureText(label)) - AndroidUtilities.dp(32)
        if avail <= 0:
            return ""
        if float(value_paint.measureText(value)) <= avail:
            return value
        avail -= float(value_paint.measureText(ELLIPSIS))
        lo, hi = 0, len(value)
        while lo < hi:
            mid = (lo + hi + 1) // 2
            if float(value_paint.measureText(value[:mid])) <= avail:
                lo = mid
            else:
                hi = mid - 1
        return value[:lo].rstrip() + ELLIPSIS if lo > 0 else ""
    except Exception as e:
        log(f"[PI] _fit_value error: {e}")
        return value[:12] + ELLIPSIS

def _make_value_factory(title, icon_res, value_fn, click_name):
    def bind(view, item, divider, adapter, list_view):
        try:
            plugin = plugin_state["plugin"]
            value = value_fn(plugin) if plugin else ""
            view.setTextAndValueAndIcon(title, value, icon_res, bool(divider))
        except Exception as e:
            log(f"[PI] _make_value_factory.bind error: {e}")
    def click(plugin, item, view):
        try:
            py_plugin = plugin_state["plugin"]
            if py_plugin is not None:
                getattr(py_plugin, click_name)(view)
        except Exception as e:
            log(f"[PI] _make_value_factory.click error: {e}")
    return SimpleSettingFactory(_key_create_view, bind, is_clickable=True, on_click=click)

def _endpoint_value(plugin) -> str:
    try:
        value = str(plugin.get_setting(SETTING_AI_ENDPOINT, DEFAULT_AI_ENDPOINT) or DEFAULT_AI_ENDPOINT).strip()
        return _fit_value("Эндпоинт", value)
    except Exception as e:
        log(f"[PI] _endpoint_value error: {e}")
        return ""

def _model_value(plugin) -> str:
    try:
        value = str(plugin.get_setting(SETTING_AI_MODEL, DEFAULT_AI_MODEL) or DEFAULT_AI_MODEL).strip()
        return _fit_value("Модель", value)
    except Exception as e:
        log(f"[PI] _model_value error: {e}")
        return ""

def _key_value(plugin) -> str:
    try:
        return "Указан" if str(plugin.get_setting(SETTING_AI_KEY, "") or "").strip() else ""
    except Exception as e:
        log(f"[PI] _key_value error: {e}")
        return ""

def _prompt_value(setting_key, default):
    def fn(plugin):
        try:
            value = str(plugin.get_setting(setting_key, "") or "").strip()
            return "Стандартный" if not value or value == default.strip() else "Свой"
        except Exception as e:
            log(f"[PI] _prompt_value error: {e}")
            return ""
    return fn

