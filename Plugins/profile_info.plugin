class ProfileInfoPlugin(BasePlugin):
    def on_plugin_load(self):
        try:
            plugin_state["plugin"] = self
            self.add_on_send_message_hook()
        except Exception as e:
            log(f"[PI] on_plugin_load error: {e}")

    def create_settings(self) -> List[Any]:
        try:
            ai_on = bool(self.get_setting(SETTING_AI_ENABLED, DEFAULT_AI_ENABLED))
            ai_items = []
            if ai_on:
                ai_items = [
                    Text(
                        text="Подключение",
                        subtext="Эндпоинт, модель, ключ, DNS",
                        icon="msg_link",
                        on_click=self._noop,
                        create_sub_fragment=self._page_ai,
                    ),
                    Text(
                        text="Промпты",
                        subtext="Как ИИ оценивает и шутит",
                        icon="msg_edit",
                        on_click=self._noop,
                        create_sub_fragment=self._page_prompts,
                    ),
                ]
            return [
                Header(text="Профиль"),
                Switch(
                    key=SETTING_SEND_AVATAR,
                    text="Отправлять аватарку",
                    default=DEFAULT_SEND_AVATAR,
                    subtext="Прикреплять к сообщению",
                    icon="msg_photos",
                ),
                Switch(
                    key=SETTING_AVATAR_VIDEO,
                    text="Видео-аватарки гифкой",
                    default=DEFAULT_AVATAR_VIDEO,
                    subtext="Иначе статичный кадр",
                    icon="msg_gif",
                ),
                Switch(
                    key=SETTING_ORIGINAL_NAME,
                    text="Оригинальное имя",
                    default=DEFAULT_ORIGINAL_NAME,
                    subtext="Для людей из ваших контактов",
                    icon="msg_contacts",
                ),
                Header(text="Нейросеть"),
                Switch(
                    key=SETTING_AI_ENABLED,
                    text="Отчёт от ИИ",
                    default=DEFAULT_AI_ENABLED,
                    subtext="Оценка в .pi, нужен для .pb",
                    icon="msg_bot",
                    on_change=self._on_ai_enabled_toggle,
                ),
                *ai_items,
                Header(text="Данные"),
                Switch(
                    key=SETTING_CACHE_ENABLED,
                    text="Кэшировать списки",
                    default=DEFAULT_CACHE_ENABLED,
                    subtext="Хранить списки профилей 1 час",
                    icon="msg_settings",
                ),
                Text(
                    text="Сбросить кэш",
                    icon="msg_delete",
                    on_click=self._clear_cache,
                ),
                Divider(text="Сбрасывает сохранённые списки профилей от exteraGram, Opex, Cherrygram и Nimarko."),
            ]
        except Exception as e:
            log(f"[PI] create_settings error: {e}")
            return []

    def _noop(self, view):
        pass

    def _on_ai_enabled_toggle(self, value):
        try:
            self.set_setting(SETTING_AI_ENABLED, bool(value), reload_settings=True)
        except Exception as e:
            log(f"[PI] _on_ai_enabled_toggle error: {e}")

    def _dialog_container(self, activity, edit):
        try:
            container = LinearLayout(activity)
            container.setPadding(AndroidUtilities.dp(DIALOG_PADDING_SIDE_DP), AndroidUtilities.dp(8), AndroidUtilities.dp(DIALOG_PADDING_SIDE_DP), AndroidUtilities.dp(4))
            container.addView(edit, LinearLayout.LayoutParams(-1, -2))
            return container
        except Exception as e:
            log(f"[PI] _dialog_container error: {e}")
            return None

    def _activity(self):
        try:
            fragment = get_last_fragment()
            return fragment.getParentActivity() if fragment else None
        except Exception as e:
            log(f"[PI] _activity error: {e}")
            return None

    def _apply_edit_theme(self, edit):
        try:
            edit.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
            edit.setHintTextColor(Theme.getColor(Theme.key_dialogTextHint))
        except Exception as e:
            log(f"[PI] _apply_edit_theme error: {e}")

    def _show_dialog(self, activity, title, edit, on_save, neutral_text, on_neutral):
        try:
            builder = AlertDialogBuilder(activity)
            builder.set_title(title)
            builder.set_view(self._dialog_container(activity, edit))
            builder.set_positive_button("Сохранить", on_save)
            builder.set_neutral_button(neutral_text, on_neutral)
            builder.set_negative_button("Отмена", lambda b, w: b.dismiss())
            builder.show()
        except Exception as e:
            log(f"[PI] _show_dialog error: {e}")

    def _edit_value_dialog(self, view, title: str, hint: str, key: str, default: str, normalize, saved_msg: str, multiline: bool = False, max_length: int = 0):
        try:
            activity = self._activity()
            if activity is None:
                return
            edit = AndroidEditText(activity)
            if multiline:
                edit.setInputType(InputType.TYPE_CLASS_TEXT | InputType.TYPE_TEXT_FLAG_MULTI_LINE)
                edit.setSingleLine(False)
                edit.setMinLines(8)
                edit.setMaxLines(14)
                edit.setGravity(Gravity.TOP | Gravity.START)
                edit.setVerticalScrollBarEnabled(True)
                if max_length:
                    try:
                        edit.setFilters(jarray(InputFilter)([InputFilter.LengthFilter(int(max_length))]))
                    except Exception as e:
                        log(f"[PI] _edit_value_dialog error: {e}")
            else:
                edit.setSingleLine(True)
            edit.setHint(hint)
            current = str(self.get_setting(key, default) or default)
            edit.setText(current)
            edit.setSelection(len(current))
            self._apply_edit_theme(edit)
            def save(builder, which):
                try:
                    value = normalize(str(edit.getText()).strip()) or default
                    self.set_setting(key, value, reload_settings=True)
                    BulletinHelper.show_success(saved_msg)
                    builder.dismiss()
                except Exception as e:
                    log(f"[PI] _edit_value_dialog.save error: {e}")
            def reset(builder, which):
                try:
                    self.set_setting(key, default, reload_settings=True)
                    BulletinHelper.show_success(saved_msg)
                    builder.dismiss()
                except Exception as e:
                    log(f"[PI] _edit_value_dialog.reset error: {e}")
            self._show_dialog(activity, title, edit, save, "Сбросить", reset)
        except Exception as e:
            log(f"[PI] _edit_value_dialog error: {e}")

    def _normalize_endpoint(self, value: str) -> str:
        try:
            if not value:
                return ""
            if not re.compile(r"^https?://", re.IGNORECASE).match(value):
                value = URL_SCHEME_DEFAULT + value
            return value.rstrip("/")
        except Exception as e:
            log(f"[PI] _normalize_endpoint error: {e}")
            return ""

    def _edit_endpoint(self, view):
        try:
            self._edit_value_dialog(view, "Эндпоинт", "https://...", SETTING_AI_ENDPOINT, DEFAULT_AI_ENDPOINT, self._normalize_endpoint, "Эндпоинт сохранён")
        except Exception as e:
            log(f"[PI] _edit_endpoint error: {e}")

    def _edit_model(self, view):
        try:
            self._edit_value_dialog(view, "Модель", "Название модели", SETTING_AI_MODEL, DEFAULT_AI_MODEL, lambda v: v, "Модель сохранена")
        except Exception as e:
            log(f"[PI] _edit_model error: {e}")

    def _edit_ai_key(self, view):
        try:
            activity = self._activity()
            if activity is None:
                return
            edit = AndroidEditText(activity)
            edit.setSingleLine(True)
            edit.setHint("API-ключ")
            current_key = str(self.get_setting(SETTING_AI_KEY, "") or "")
            edit.setText(current_key)
            edit.setSelection(len(current_key))
            self._apply_edit_theme(edit)
            def save(builder, which):
                try:
                    value = str(edit.getText()).strip()
                    self.set_setting(SETTING_AI_KEY, value, reload_settings=True)
                    BulletinHelper.show_success("API-ключ сохранён" if value else "API-ключ удалён")
                    builder.dismiss()
                except Exception as e:
                    log(f"[PI] _edit_ai_key.save error: {e}")
            def clear(builder, which):
                try:
                    self.set_setting(SETTING_AI_KEY, "", reload_settings=True)
                    BulletinHelper.show_success("API-ключ удалён")
                    builder.dismiss()
                except Exception as e:
                    log(f"[PI] _edit_ai_key.clear error: {e}")
            self._show_dialog(activity, "API-ключ", edit, save, "Очистить", clear)
        except Exception as e:
            log(f"[PI] _edit_ai_key error: {e}")

    def _note_with_link(self, text: str):
        try:
            builder = SpannableStringBuilder(text)
            start = text.find(AI_CHAT_LINK_TEXT)
            if start >= 0:
                builder.setSpan(URLSpanNoUnderline("https://t.me/exteraSettings?s=aiServices"), start, start + len(AI_CHAT_LINK_TEXT), Spanned.SPAN_EXCLUSIVE_EXCLUSIVE)
            return Custom(item=UItem.asShadow(builder))
        except Exception as e:
            log(f"[PI] _note_with_link error: {e}")
            return Divider(text=text)

    def _on_use_chat_toggle(self, value):
        try:
            self.set_setting(SETTING_AI_USE_CHAT, bool(value), reload_settings=True)
        except Exception as e:
            log(f"[PI] _on_use_chat_toggle error: {e}")

    def _on_ai_dns_toggle(self, value):
        try:
            self.set_setting(SETTING_AI_USE_DNS, bool(value), reload_settings=True)
        except Exception as e:
            log(f"[PI] _on_ai_dns_toggle error: {e}")

    def _page_ai(self) -> List[Any]:
        try:
            use_chat = bool(self.get_setting(SETTING_AI_USE_CHAT, DEFAULT_AI_USE_CHAT))
            items = [
                Header(text="Запрос"),
                Switch(
                    key=SETTING_AI_USE_CHAT,
                    text="Модель из AI Chat",
                    default=DEFAULT_AI_USE_CHAT,
                    subtext="Сервис, выбранный в exteraGram",
                    icon="menu_premium_chatbot",
                    on_change=self._on_use_chat_toggle,
                ),
            ]
            if use_chat:
                note = "Эндпоинт, модель и API-ключ берутся из сервиса, который выбран в AI Chat. Чтобы сменить модель, выберите другой сервис там."
                endpoint, model, key, error = self._chat_service()
                if error:
                    note += "\n\nСейчас: " + error + "."
                elif model:
                    note += "\n\nСейчас: " + model + "."
                items.append(self._note_with_link(note))
            else:
                items.append(self._note_with_link("Если включить, плагин будет использовать сервис, выбранный в AI Chat, и настройки ниже не понадобятся."))
                items += [
                    Custom(factory=EndpointRowFactory.instance.java),
                    Custom(factory=ModelRowFactory.instance.java),
                    Custom(factory=KeyRowFactory.instance.java),
                    Divider(text="Рекомендуется использовать Gemini, ключ можно получить здесь: https://aistudio.google.com/apikey. Для других провайдеров используется формат OpenAI (chat/completions)."),
                ]
            items += [
                Header(text="Ответ"),
                Switch(
                    key=SETTING_AI_WAIT,
                    text="Ждать ответ ИИ",
                    default=DEFAULT_AI_WAIT,
                    subtext="Для .pi и .pb",
                    icon="msg_stories_timer",
                ),
                Divider(text="Выключено: сначала отправляется сообщение «Подождите...», затем оно редактируется ответом."),
                Header(text="Сеть"),
                Switch(
                    key=SETTING_AI_USE_DNS,
                    text="Использовать DNS",
                    default=DEFAULT_AI_USE_DNS,
                    subtext="Адрес эндпоинта через DNS-over-HTTPS",
                    icon="msg_language",
                    on_change=self._on_ai_dns_toggle,
                ),
            ]
            if bool(self.get_setting(SETTING_AI_USE_DNS, DEFAULT_AI_USE_DNS)):
                items.append(
                    Input(
                        key=SETTING_AI_DNS,
                        text="DNS-сервер",
                        default=DEFAULT_AI_DNS,
                        icon="msg_edit",
                    )
                )
            return items
        except Exception as e:
            log(f"[PI] _page_ai error: {e}")
            return []

