__id__ = "screen_guard"
__name__ = "Screen Guard"
__description__ = "Скрывает содержимое exteraGram в списке недавних приложений, чтобы переписку не было видно на миниатюре. Работает на Android 13 и новее."
__author__ = "@nyashkazxcgram"
__version__ = "3.0.0"
__icon__ = "exteraPlugins/1"
__min_version__ = "11.9.0"

from base_plugin import BasePlugin
from client_utils import get_last_fragment
from android_utils import log
from java import dynamic_proxy
from android.app import Application
from android.os import Build
from org.telegram.messenger import ApplicationLoader
from ui.settings import Header, Switch, Divider, Text


class _Life(dynamic_proxy(Application.ActivityLifecycleCallbacks)):
    def __init__(self, owner):
        super().__init__()
        self.owner = owner

    def onActivityCreated(self, activity, bundle):
        self.owner.protect(activity)

    def onActivityStarted(self, activity):
        pass

    def onActivityResumed(self, activity):
        self.owner.protect(activity)

    def onActivityPaused(self, activity):
        pass

    def onActivityStopped(self, activity):
        pass

    def onActivitySaveInstanceState(self, activity, bundle):
        pass

    def onActivityDestroyed(self, activity):
        pass


class ScreenGuardPlugin(BasePlugin):
    def on_plugin_load(self):
        self.callbacks = None
        self.activity = None

        # защищаем каждое окно приложения, когда оно появляется или возвращается на экран
        try:
            self.callbacks = _Life(self)
            ApplicationLoader.applicationContext.registerActivityLifecycleCallbacks(self.callbacks)
        except Exception as e:
            log("ScreenGuard: не удалось подписаться на окна приложения: " + str(e))

        # и то окно, которое открыто прямо сейчас
        try:
            fr = get_last_fragment()
            if fr is not None and fr.getParentActivity() is not None:
                self.protect(fr.getParentActivity())
        except Exception as e:
            log("ScreenGuard: текущее окно: " + str(e))

    def on_plugin_unload(self):
        try:
            if self.callbacks is not None:
                ApplicationLoader.applicationContext.unregisterActivityLifecycleCallbacks(self.callbacks)
            if self.activity is not None and Build.VERSION.SDK_INT >= 33:
                self.activity.setRecentsScreenshotEnabled(True)
        except Exception as e:
            log("ScreenGuard unload error: " + str(e))

    # ---------- настройки ----------
    def create_settings(self):
        return [
            Header(text="Screen Guard"),
            Switch(key="enabled", text="Скрывать содержимое в недавних", default=True,
                   on_change=lambda v: self.protect(self.activity, v)),
            Divider(),
            Text(text="В списке недавних приложений вместо миниатюры с перепиской будет пустое окно. "
                      "Это встроенный способ Android, он работает на Android 13 и новее. "
                      "Размытую миниатюру сделать нельзя: система фотографирует окно раньше, чем приложение успевает на это отреагировать."),
        ]

    def _get(self, key, default):
        try:
            return self.get_setting(key, default)
        except Exception:
            return default

    def protect(self, act, enabled=None):
        if act is None:
            return
        self.activity = act
        if enabled is None:
            enabled = bool(self._get("enabled", True))
        try:
            if Build.VERSION.SDK_INT >= 33:
                act.setRecentsScreenshotEnabled(not enabled)
            else:
                log("ScreenGuard: нужен Android 13 или новее")
        except Exception as e:
            log("ScreenGuard protect error: " + str(e))
