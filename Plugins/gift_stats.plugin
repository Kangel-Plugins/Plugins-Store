PAGE_LIMIT = 30
TOP_LIMIT = 100
EXPORT_TOP_LIMIT = 10
EXPORT_WIDTH_DP = 320
EXPORT_TIMEOUT_SEC = 60
EXPORT_IDLE_SEC = 6
PRELOAD_TIMEOUT_SEC = 12
ACTION_IDLE_SEC = 90
ACTION_WATCH_TICK_SEC = 5
ROW_FIRST = 12
ROW_BATCH = 120


class _ActionState:
    """Одно действие плагина (сбор статистики, экспорт): свой поток, очередь задач, отмена и сторож.

    Всё содержимое действия исполняется в этом потоке, а из сетевых колбэков и UI-постов
    задачи только перекладываются в его очередь. Зависшее действие не держит UI-поток
    клиента: сторож снимает его, освобождает состояние плагина, а сам поток после этого
    игнорируется — его результаты уже не смогут ничего изменить (см. GiftStatsPlugin._stale).
    """

    def __init__(self, plugin, name, idle_limit=ACTION_IDLE_SEC):
        self.plugin = plugin
        self.name = name
        self.idle_limit = idle_limit
        self.cancel = False
        self.done = False
        self.abandoned = False
        self.user_cancelled = False
        self.started = time.time()
        self.beat = self.started
        self._tasks = queue.Queue()
        self._thread = threading.Thread(target=self._loop, name=f"gift_stats_{name}", daemon=True)
        self._watcher = threading.Thread(target=self._watch, name=f"gift_stats_{name}_watch", daemon=True)
        self._thread.start()
        self._watcher.start()

    def alive(self):
        return not (self.done or self.cancel)

    def touch(self):
        self.beat = time.time()

    def submit(self, fn):
        self._tasks.put(fn)

    def stop(self):
        self.done = True
        self._tasks.put(None)

    def _loop(self):
        while True:
            task = self._tasks.get()
            if task is None:
                return
            if not self.alive() or self.plugin._act is not self:
                continue
            self.touch()
            self.plugin._run_task(self, task)

    def _watch(self):
        while self.alive():
            time.sleep(ACTION_WATCH_TICK_SEC)
            if self.done or self.cancel or self.abandoned:
                return
            idle = time.time() - self.beat
            if idle > self.idle_limit:
                self.plugin._abandon(self, f"нет прогресса {int(idle)} с")
                return


class _JavaRunnable(dynamic_proxy(find_class("java.lang.Runnable"))):
    def __init__(self, fn):
        super().__init__()
        self.fn = fn

    def run(self):
        self.fn()


@java_subclass(find_class("java.lang.Object"),
               find_class("org.telegram.ui.DialogsActivity$DialogsActivityDelegate"))
class _ChatPickerDelegate(Base):
    """Ответ нативного выбора чата: выбранный чат становится получателем картинки."""

    def __init__(self, *args):
        self._plugin = None
        self._intent = None

    @joverload("didSelectDialogs", [
        "org.telegram.ui.DialogsActivity", "java.util.ArrayList", "java.lang.CharSequence",
        "boolean", "boolean", "int", "int", "org.telegram.ui.TopicsFragment"])
    def didSelectDialogs(self, fragment, dids, message, param, notify, schedule_date,
                         schedule_repeat_period, topics_fragment):
        try:
            try:
                fragment.finishFragment()
            except Exception:
                pass
            plugin = self._plugin
            intent = self._intent
            if plugin is None or not intent:
                return True
            dialog_id = None
            try:
                if dids is not None and dids.size() > 0:
                    dialog_id = int(dids.get(0).dialogId)
            except Exception as e:
                plugin.log(f"GiftStats picker parse error: {e}")
            if dialog_id:
                target = dict(intent)
                target["peer"] = dialog_id
                target["reply"] = None
                target["reply_id"] = None
                target["reply_obj"] = None
                plugin.log(f"GiftStats export target picked: {dialog_id}")
                plugin._run_export(**target)
            return True
        except Exception as e:
            try:
                if self._plugin is not None:
                    self._plugin.log(f"GiftStats picker delegate error: {e}")
            except Exception:
                pass
            return False


