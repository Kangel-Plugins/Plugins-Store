# Классы клиента, которые нужны плагину.
DIALOG_CELL_CLASS = "org.telegram.ui.Cells.DialogCell"
BASE_CELL_CLASS = "org.telegram.ui.Cells.BaseCell"
SPOILER_EFFECT_CLASS = "org.telegram.ui.Components.spoilers.SpoilerEffect"
SHARED_CONFIG_CLASS = "org.telegram.messenger.SharedConfig"
ANDROID_UTILITIES_CLASS = "org.telegram.messenger.AndroidUtilities"
SWAP_EMOJI_CLASS = "org.telegram.ui.Components.AnimatedEmojiDrawable$SwapAnimatedEmojiDrawable"

# Поля DialogCell со строкой предпросмотра: обнуляем на время кадра.
PREVIEW_FIELDS = ("messageLayout", "typingLayout", "messageNameLayout")

# Отступы названия от верха ячейки (см. DialogCell.onDraw).
NAME_TOP_TWO_LINES = 14
NAME_TOP_THREE_LINES = 10
TAGS_OFFSET_TWO_LINES = 9
TAGS_OFFSET_FORUM = 8

# Размер аватарки в dp для обычного и трёхстрочного режима.
AVATAR_TWO_LINES = 52
AVATAR_THREE_LINES = 56

# Всё, что нарисовано выше этой линии, считается верхней строкой и едет вместе с ней.
TOP_BAND_DP = 26

# Ниже этой высоты строку не сжимаем: иначе счётчик непрочитанных наедет на текст.
MIN_ROW_DP = 40

# Метка в _shift_tags: этот Layout не сдвигаем, а не рисуем вовсе.
HIDE_MARKER = -1

# Индекс настройки -> коэффициент размера аватарки.
AVATAR_SCALES = (1.0, 0.75, 0.5)

# Индексы старого выпадающего списка скрытия -> (время, галочки).
LEGACY_HIDE_PRESETS = (
    (False, False),
    (False, False),
    (True, False),
    (False, True),
    (True, True),
)

# Страховка от «залипшего» стека, если чужой onDraw бросит исключение.
MAX_STACK = 64

