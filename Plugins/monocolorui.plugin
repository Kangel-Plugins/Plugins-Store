__id__ = "monocolorui"
__name__ = "MonoColor UI"
__description__ = "Полностью перекрашивает твой интерфейс в один цвет: аватарки, истории, списки чатов - все одного тона"
__author__ = "@limeplug"
__version__ = "1.7"
__icon__ = "pokelimeplug/1"
__app_version__ = ">=12.5.1"
__sdk_version__ = ">=1.4.0"

import base64
import zlib

from android.graphics.drawable import GradientDrawable
from android.view import View
from android.widget import LinearLayout, ScrollView, TextView
from base_plugin import BasePlugin
from java import dynamic_proxy, jclass
from org.telegram.messenger import AndroidUtilities, ApplicationLoader
from org.telegram.ui import LaunchActivity
from org.telegram.ui.ActionBar import AlertDialog, Theme
from org.telegram.ui.Components.Paint import ColorPickerBottomSheet
from ui.settings import Header, Switch, Text

ENTRY_CLASS = "com.monocolor.ui.MonoColor"
DEX_BEGIN = "__DEX_BEGIN__"
DEX_END = "__DEX_END__"
BuildVersion = jclass("android.os.Build$VERSION")
OnClickListener = jclass("android.view.View$OnClickListener")
ColorConsumer = jclass("androidx.core.util.Consumer")
PipetteDelegate = jclass("org.telegram.ui.Components.Paint.ColorPickerBottomSheet$PipetteDelegate")
CUSTOM_SOURCE = 6
DEFAULT_COLOR = 0xFF4FAEDE


class _Click(dynamic_proxy(OnClickListener)):
    def __init__(self, callback):
        super().__init__()
        self.callback = callback

    def onClick(self, view):
        self.callback(view)


class _ColorListener(dynamic_proxy(ColorConsumer)):
    def __init__(self, callback):
        super().__init__()
        self.callback = callback

    def accept(self, color):
        self.callback(color)


class _NoPipette(dynamic_proxy(PipetteDelegate)):
    def getContainerView(self):
        return None

    def getSnapshotDrawingView(self):
        return None

    def isPipetteAvailable(self):
        return False

    def isPipetteVisible(self):
        return False

    def onColorSelected(self, color):
        return None

    def onDrawImageOverCanvas(self, bitmap, canvas):
        return None

    def onStartColorPipette(self):
        return None

    def onStopColorPipette(self):
        return None


class Dex:
    def __init__(self, entry_class):
        self.entry_class = entry_class
        self.clazz = None
        self.loaded = False

    def load(self):
        if self.loaded:
            return
        if self.clazz is None:
            context = ApplicationLoader.applicationContext
            if context is None:
                raise RuntimeError("application context is not ready")
            if int(BuildVersion.SDK_INT) < 26:
                raise RuntimeError("embedded DEX requires Android API 26+")
            ByteBuffer = jclass("java.nio.ByteBuffer")
            InMemoryDexClassLoader = jclass("dalvik.system.InMemoryDexClassLoader")
            loader = InMemoryDexClassLoader(
                ByteBuffer.wrap(self._read_payload()),
                context.getClassLoader(),
            )
            self.clazz = loader.loadClass(self.entry_class)
        try:
            self._invoke("load")
            self.loaded = True
        except Exception as load_error:
            try:
                self._invoke("unload")
            except Exception as cleanup_error:
                self.loaded = False
                raise RuntimeError(
                    "DEX load failed and cleanup also failed: "
                    f"{load_error}; cleanup: {cleanup_error}"
                ) from cleanup_error
            self.loaded = False
            raise

    def unload(self):
        if self.clazz is None or not self.loaded:
            return
        self._invoke("unload")
        self.loaded = False

    def apply(self):
        if self.clazz is None or not self.loaded:
            return
        self._invoke("apply")

    def _invoke(self, method_name, *args):
        if self.clazz is None:
            raise RuntimeError("embedded DEX class is not loaded")
        matches = []
        for method in self.clazz.getDeclaredMethods():
            if str(method.getName()) != method_name:
                continue
            if len(method.getParameterTypes()) != len(args):
                continue
            method.setAccessible(True)
            matches.append(method)
        if len(matches) > 1:
            raise RuntimeError(f"ambiguous core method: {method_name}/{len(args)}")
        if matches:
            return matches[0].invoke(None, *args)
        raise RuntimeError(f"core method not found: {method_name}/{len(args)}")

    def _read_payload(self):
        try:
            with open(__file__, "r", encoding="utf-8") as source:
                text = source.read()
            block = text.split(f"# {DEX_BEGIN}", 1)[1].split(f"# {DEX_END}", 1)[0]
            payload = "".join(
                line.strip()[1:].strip()
                for line in block.splitlines()
                if line.strip().startswith("#")
            )
        except Exception as exc:
            raise RuntimeError(f"embedded dex read failed: {exc}")
        if not payload:
            raise RuntimeError("embedded dex payload not found")
        try:
            return zlib.decompress(base64.b64decode(payload))
        except Exception as exc:
            raise RuntimeError(f"embedded dex decode failed: {exc}")


class MonoColorUiPlugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self.dex = Dex(ENTRY_CLASS)

    def on_plugin_load(self):
        try:
            self.dex.load()
        except Exception as exc:
            try:
                self.dex.unload()
            except Exception as cleanup_error:
                self.log(f"Ошибка очистки после сбоя загрузки DEX: {cleanup_error}")
            self.log(f"Не удалось загрузить DEX: {exc}")
            raise

    def on_plugin_unload(self):
        try:
            self.dex.unload()
        except Exception as exc:
            self.log(f"Ошибка выгрузки DEX: {exc}")

    def create_settings(self):
        index = self._source_index()
        title, color = self._palette()[index]
        rows = [
            Header(text="Цвет"),
            Text(
                text="Из темы",
                subtext=self._label(title, color),
                on_click=self._open_sources,
            ),
        ]
        if index == CUSTOM_SOURCE:
            rows.append(
                Text(
                    text="Свой цвет",
                    subtext=self._label("", self._custom_color()),
                    on_click=self._open_picker,
                )
            )
        rows.extend([
            Switch(
                key="gradient",
                text="Градиент",
                default=False,
                subtext="Второй оттенок на аватарках, именах и кольцах",
                on_change=self._reapply,
            ),
            Header(text="Что перекрашивать"),
            Switch(
                key="avatars",
                text="Аватарки",
                default=True,
                subtext="Заглушки и фото в цвет темы",
                on_change=self._reapply,
            ),
            Switch(
                key="stories",
                text="Истории",
                default=True,
                subtext="Кольца непрочитанных, близких друзей и эфиров",
                on_change=self._reapply,
            ),
            Switch(
                key="names",
                text="Имена",
                default=True,
                subtext="Стандартные цветные имена в чатах",
                on_change=self._reapply,
            ),
            Switch(
                key="dialogs",
                text="Список чатов",
                default=True,
                subtext="Названия чатов и последние сообщения",
                on_change=self._reapply,
            ),
            Switch(
                key="profiles",
                text="Цвета профилей",
                default=True,
                subtext="Свой цвет имени, шапки, аватарки и кольца истории",
                on_change=self._reapply,
            ),
        ])
        return rows

    def _palette(self):
        specs = [
            ("Кнопка", "key_featuredStickers_addButton"),
            ("Акцент", None),
            ("Шапка", "key_windowBackgroundWhiteBlueHeader"),
            ("Ссылки", "key_windowBackgroundWhiteBlueText"),
            ("Плавающая кнопка", "key_dialogFloatingButton"),
            ("Исходящие", "key_chat_outBubble"),
            ("Свой", "custom"),
        ]
        rows = []
        for title, key_name in specs:
            if key_name == "custom":
                color = self._custom_color()
            else:
                color = self._read_theme_color(key_name)
            rows.append((title, color or DEFAULT_COLOR))
        return rows

    def _source_index(self):
        try:
            index = int(self.get_setting("color_source", 0))
        except Exception:
            index = 0
        if index < 0 or index > CUSTOM_SOURCE:
            return 0
        return index

    def _custom_color(self):
        return self._parse_color(self.get_setting("custom_color", "#4FAEDE"))

    def _parse_color(self, text):
        value = str(text or "").strip()
        if value.startswith("#"):
            value = value[1:]
        if len(value) == 3:
            value = "".join(ch * 2 for ch in value)
        elif len(value) == 8:
            value = value[2:]
        if len(value) != 6:
            return DEFAULT_COLOR
        try:
            return int(value, 16) | 0xFF000000
        except Exception:
            return DEFAULT_COLOR

    def _label(self, title, color):
        hex_color = "#%06X" % (int(color) & 0xFFFFFF)
        if title:
            return "%s  %s" % (title, hex_color)
        return hex_color

    def _java_color(self, color):
        value = int(color) & 0xFFFFFFFF
        if value >= 0x80000000:
            value -= 0x100000000
        return value

    def _read_theme_color(self, key_name):
        try:
            if key_name is None:
                return self._accent_color()
            return int(Theme.getColor(getattr(Theme, key_name))) | 0xFF000000
        except Exception:
            return 0

    def _accent_color(self):
        try:
            theme = Theme.getActiveTheme()
            if theme is None:
                return 0
            if theme.hasAccentColors():
                color = int(theme.getAccentColor(theme.currentAccentId))
                if color != 0:
                    return color | 0xFF000000
            if theme.isMonet():
                index = {91: 0, 90: 1, 89: 2}.get(int(theme.currentAccentId), 0)
                color = int(jclass("com.exteragram.messenger.utils.ui.MonetUtils").getSystemAccentColor(index, bool(theme.isDark())))
                if color != 0:
                    return color | 0xFF000000
        except Exception:
            return 0
        return 0

    def _screen(self):
        fragment = LaunchActivity.getSafeLastFragment()
        if fragment is None:
            return None
        activity = fragment.getParentActivity()
        if activity is None:
            return None
        return fragment, activity

    def _open_sources(self, view):
        try:
            screen = self._screen()
            if screen is None:
                return
            fragment, activity = screen
            content = LinearLayout(activity)
            content.setOrientation(1)
            current = self._source_index()
            self._source_clicks = []
            for index, (title, color) in enumerate(self._palette()):
                content.addView(self._source_row(activity, index, title, color, index == current))
            scroll = ScrollView(activity)
            scroll.addView(content)
            builder = AlertDialog.Builder(activity, fragment.getResourceProvider())
            builder.setTitle("Цвет")
            builder.setView(scroll)
            builder.setNegativeButton("Отмена", None)
            dialog = builder.create()
            self._source_dialog = dialog
            dialog.show()
        except Exception as exc:
            self.log(f"Не удалось открыть выбор цвета: {exc}")

    def _source_row(self, activity, index, title, color, selected):
        row = LinearLayout(activity)
        row.setOrientation(0)
        row.setGravity(16)
        pad = AndroidUtilities.dp(16)
        row.setPadding(pad, AndroidUtilities.dp(10), pad, AndroidUtilities.dp(10))
        row.setBackground(Theme.createSelectorDrawable(self._java_color(Theme.getColor(Theme.key_listSelector)), 2))
        dot = View(activity)
        shape = GradientDrawable()
        shape.setShape(GradientDrawable.OVAL)
        shape.setColor(self._java_color(color))
        dot.setBackground(shape)
        size = AndroidUtilities.dp(22)
        dot_params = LinearLayout.LayoutParams(size, size)
        row.addView(dot, dot_params)
        label = TextView(activity)
        label.setText(self._label(title, color))
        label.setTextSize(16)
        label.setTextColor(self._java_color(Theme.getColor(
            Theme.key_dialogRadioBackgroundChecked if selected else Theme.key_dialogTextBlack
        )))
        label.setPadding(AndroidUtilities.dp(14), 0, 0, 0)
        row.addView(label, LinearLayout.LayoutParams(-1, -2))
        click = _Click(lambda _view, picked=index: self._pick_source(picked))
        self._source_clicks.append(click)
        row.setOnClickListener(click)
        return row

    def _pick_source(self, index):
        dialog = getattr(self, "_source_dialog", None)
        if dialog is not None:
            dialog.dismiss()
            self._source_dialog = None
        self.set_setting("color_source", int(index), reload_settings=True)
        self._reapply(index)

    def _open_picker(self, view):
        try:
            screen = self._screen()
            if screen is None:
                return
            fragment, activity = screen
            self._picker_listener = _ColorListener(self._save_custom_color)
            self._pipette = _NoPipette()
            sheet = ColorPickerBottomSheet(activity, fragment.getResourceProvider())
            sheet.setPipetteDelegate(self._pipette)
            sheet.setColor(self._java_color(self._custom_color()))
            sheet.setColorListener(self._picker_listener)
            self._picker = sheet
            sheet.show()
        except Exception as exc:
            self.log(f"Не удалось открыть палитру: {exc}")

    def _save_custom_color(self, color):
        self.set_setting("custom_color", self._label("", color), reload_settings=True)
        self._reapply(color)

    def _reapply(self, value):
        try:
            self.dex.apply()
        except Exception as exc:
            self.log(f"Не удалось обновить цвета: {exc}")

