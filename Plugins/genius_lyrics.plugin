import requests
import json
import re
from java.util import Locale
from org.telegram.tgnet import TLRPC
from base_plugin import BasePlugin, HookResult, HookStrategy
from android_utils import log
from client_utils import send_message, run_on_queue
from markdown_utils import parse_markdown
from bs4 import BeautifulSoup
from ui.bulletin import BulletinHelper

__id__ = "genius_lyrics"
__name__ = "Genius Lyrics"
__description__ = "Получить текст песни из Genius, юзай .lyrics [имя песни]."
__author__ = "@ArThirtyFour | @KangelPlugins"
__min_version__ = "12.1.1"
__version__ = "1.2.0"
__icon__ = "amechan_wakuwaku_by_fStikBot/1"

API_TOKEN = '9JiBRxKAEgfssIWg3Yw8uxKyDO0HZr1IQS5qVYQiKMLwJ4d_9tEMxxYlm3w_mIML'
API_BASE_URL = "https://api.genius.com"


class LocaleController:
    STRINGS = {
        "en": {
            "searching": "🔍 Searching for lyrics...",
            "artist": "Artist",
            "open_genius": "Open on Genius",
            "lyrics_not_found": "Lyrics not found",
            "lyrics_truncated": "... (text truncated)",
            "lyrics_found": "Lyrics found!",
            "genius_no_lyrics": "Genius did not return lyrics",
            "api_error": "Genius API error: %s",
            "song_not_found": 'Could not find song "%s"',
            "error_occurred": "An error occurred: %s: %s",
            "genius_error": "Genius error",
            "usage": "Usage: %s [song name]",
        },
        "ru": {
            "searching": "🔍 Ищем текст песни...",
            "artist": "Исполнитель",
            "open_genius": "Открыть на Genius",
            "lyrics_not_found": "Текст песни не найден",
            "lyrics_truncated": "... (текст обрезан)",
            "lyrics_found": "Текст песни найден!",
            "genius_no_lyrics": "Genius не отдал текст песни",
            "api_error": "Ошибка API Genius: %s",
            "song_not_found": 'Не удалось найти песню "%s"',
            "error_occurred": "Произошла ошибка: %s: %s",
            "genius_error": "Ошибка Genius",
            "usage": "Использование: %s [название песни]",
        },
    }

    def __init__(self):
        try:
            self.lang = Locale.getDefault().getLanguage()
        except Exception:
            self.lang = "en"
        if self.lang not in self.STRINGS:
            self.lang = "en"

    def get(self, key: str, *args) -> str:
        text = self.STRINGS.get(self.lang, {}).get(key, self.STRINGS["en"].get(key, key))
        if args:
            try:
                return text % args
            except Exception:
                return text
        return text

    def __getitem__(self, key: str) -> str:
        return self.get(key)


loc = LocaleController()


class GeniusLyricsPlugin(BasePlugin):

    def on_plugin_load(self):
        self.add_on_send_message_hook()

    def _get_headers(self):
        return {
            "User-Agent": (
                "Mozilla/5.0 (Linux; Android 14) "
                "AppleWebKit/537.36 (KHTML, like Gecko) "
                "Chrome/130.0 Mobile Safari/537.36"
            ),
            "Accept": (
                "text/html,application/xhtml+xml,application/xml;"
                "q=0.9,image/avif,image/webp,*/*;q=0.8"
            ),
            "Accept-Language": "en-US,en;q=0.9",
            "Referer": "https://genius.com/",
        }

    def scrape_lyrics(self, song_url):
        log(f"[GeniusLyrics] Scraping: {song_url}")

        try:
            response = requests.get(
                song_url,
                headers=self._get_headers(),
                timeout=15,
                allow_redirects=True
            )

            log(
                f"[GeniusLyrics] HTTP {response.status_code}, "
                f"length={len(response.text)}"
            )

            if response.status_code != 200:
                return None

            soup = BeautifulSoup(response.text, "html.parser")

            containers = soup.find_all(
                "div",
                attrs={"data-lyrics-container": "true"}
            )

            if not containers:
                containers = soup.select(
                    "div[class*='Lyrics__Container']"
                )

            if not containers:
                containers = soup.select(
                    "div[class*='Lyrics-']"
                )

            log(
                f"[GeniusLyrics] Lyrics containers: "
                f"{len(containers)}"
            )

            if containers:
                parts = []

                for container in containers:
                    for br in container.find_all("br"):
                        br.replace_with("\n")

                    text = container.get_text(
                        separator="",
                        strip=False
                    )

                    text = text.replace("\r\n", "\n")
                    text = text.replace("\r", "\n")
                    text = "\n".join(
                        line.rstrip()
                        for line in text.split("\n")
                    ).strip()

                    if text:
                        parts.append(text)

                lyrics = "\n\n".join(parts).strip()

                if lyrics:
                    marker = "[Текст песни"
                    marker_pos = lyrics.find(marker)

                    if marker_pos != -1:
                        end_pos = lyrics.find("]", marker_pos)

                        if end_pos != -1:
                            lyrics = lyrics[end_pos + 1:]

                    lyrics = re.sub(
                        r"^.*?Lyrics\s*",
                        "",
                        lyrics,
                        count=1,
                        flags=re.IGNORECASE | re.DOTALL
                    )

                    lyrics = lyrics.strip()

                    log(
                        f"[GeniusLyrics] Extracted "
                        f"{len(lyrics)} chars"
                    )
                    return lyrics

            log("[GeniusLyrics] Trying embedded JSON fallback")

            raw = response.text

            patterns = [
                r'"lyricsHtml":"(.*?)"',
                r'"lyrics":"(.*?)"',
            ]

            for pattern in patterns:
                for match in re.finditer(pattern, raw, re.DOTALL):
                    try:
                        value = json.loads('"' + match.group(1) + '"')
                    except Exception:
                        value = match.group(1)

                    if "lyrics" not in value.lower() and len(value) < 100:
                        continue

                    value = BeautifulSoup(
                        value,
                        "html.parser"
                    )

                    for br in value.find_all("br"):
                        br.replace_with("\n")

                    text = value.get_text(
                        separator="",
                        strip=False
                    ).strip()

                    if len(text) > 100:
                        log(
                            "[GeniusLyrics] Lyrics recovered "
                            "from embedded data"
                        )
                        return text

            log(
                "[GeniusLyrics] No lyrics found in page. "
                f"data-container="
                f"{'data-lyrics-container' in raw}, "
                f"lyrics-container="
                f"{'Lyrics__Container' in raw}"
            )

            return None

        except Exception as e:
            log(
                f"[GeniusLyrics] Scrape error: "
                f"{type(e).__name__}: {e}"
            )
            return None

    def format_lyrics_message(
        self,
        song_title,
        artist_name,
        lyrics,
        song_url
    ):
        artist_label = loc["artist"]
        open_genius_label = loc["open_genius"]

        if lyrics:
            if len(lyrics) > 3500:
                lyrics = (
                    lyrics[:3500]
                    + f"\n\n{loc['lyrics_truncated']}"
                )

            lines = lyrics.split("\n")
            formatted = "\n".join(
                line.strip() if line.strip() else ""
                for line in lines
            ).strip()

            header_md = (
                f"🎵 **{song_title}**\n"
                f"👤 _{artist_label}: {artist_name}_\n\n"
                f"🔗 [{open_genius_label}]({song_url})\n\n"
            )

            parsed_header = parse_markdown(header_md)
            header_text = parsed_header.text
            entities = [
                entity.to_tlrpc_object()
                for entity in parsed_header.entities
            ]

            offset = len(header_text.encode("utf-16-le")) // 2
            length = len(formatted.encode("utf-16-le")) // 2

            quote = TLRPC.TL_messageEntityBlockquote()
            quote.offset = offset
            quote.length = length
            quote.collapsed = True
            entities.append(quote)

            return header_text + formatted, entities

        not_found_label = loc["lyrics_not_found"]
        fallback_md = (
            f"🎵 **{song_title}**\n"
            f"👤 _{artist_label}: {artist_name}_\n\n"
            f"🔗 [{open_genius_label}]({song_url})\n\n"
            f"❌ {not_found_label}"
        )
        parsed = parse_markdown(fallback_md)
        return parsed.text, [
            entity.to_tlrpc_object()
            for entity in parsed.entities
        ]

    def on_send_message_hook(self, account, params):
        if not isinstance(params.message, str):
            return HookResult()

        message_text = params.message.strip()
        command_prefix = ".lyrics"

        if (
            not message_text.startswith(command_prefix + " ")
            and message_text != command_prefix
        ):
            return HookResult()

        song_name = message_text[len(command_prefix):].strip()

        log(
            f"[GeniusLyrics] Command: {command_prefix}, "
            f"song={song_name!r}"
        )

        if not song_name:
            params.message = loc.get("usage", command_prefix)
            return HookResult(
                strategy=HookStrategy.MODIFY,
                params=params
            )

        BulletinHelper.show_info(
            loc["searching"]
        )

        peer = params.peer

        run_on_queue(
            lambda: self.search_and_reply(peer, song_name)
        )

        return HookResult(
            strategy=HookStrategy.CANCEL
        )

    def search_and_reply(self, peer, song_name):
        log(
            f"[GeniusLyrics] Searching Genius: "
            f"{song_name!r}"
        )

        try:
            search_url = (
                f"{API_BASE_URL}/search"
                f"?q={requests.utils.quote(song_name)}"
            )

            headers = {
                "Authorization": f"Bearer {API_TOKEN}",
                "User-Agent": "GeniusLyricsPlugin/1.2.0",
                "Accept": "application/json",
            }

            response = requests.get(
                search_url,
                headers=headers,
                timeout=15
            )

            log(
                f"[GeniusLyrics] API status: "
                f"{response.status_code}"
            )

            if response.status_code != 200:
                error_msg = loc.get("api_error", str(response.status_code))
                BulletinHelper.show_error(error_msg)
                send_message({
                    "peer": peer,
                    "message": f"❌ {error_msg}"
                })
                return

            data = response.json()
            hits = data.get("response", {}).get("hits", [])

            if not hits:
                error_msg = loc.get("song_not_found", song_name)
                BulletinHelper.show_error(error_msg)
                send_message({
                    "peer": peer,
                    "message": f"❌ {error_msg}"
                })
                return

            song = None

            for hit in hits:
                result = hit.get("result", {})
                if result.get("url"):
                    song = result
                    break

            if not song:
                raise RuntimeError(
                    "Genius API returned no usable song URL"
                )

            song_url = song.get("url")
            song_title = song.get("title", song_name)
            artist_name = (
                song.get("primary_artist", {})
                .get("name", "Unknown")
            )

            log(
                f"[GeniusLyrics] Selected: "
                f"{song_title} / {artist_name}"
            )

            lyrics = self.scrape_lyrics(song_url)

            if lyrics:
                BulletinHelper.show_success(
                    loc["lyrics_found"]
                )
            else:
                BulletinHelper.show_error(
                    loc["genius_no_lyrics"]
                )

            message_text, entities = self.format_lyrics_message(
                song_title,
                artist_name,
                lyrics,
                song_url
            )

            send_message({
                "peer": peer,
                "message": message_text,
                "entities": entities
            })

            log("[GeniusLyrics] Message sent")

        except Exception as e:
            error_msg = loc.get("error_occurred", type(e).__name__, str(e))

            log(f"[GeniusLyrics] {error_msg}")

            BulletinHelper.show_error(
                loc["genius_error"]
            )

            send_message({
                "peer": peer,
                "message": f"❌ {error_msg}"
            })
