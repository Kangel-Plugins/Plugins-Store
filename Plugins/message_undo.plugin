import threading
try:
    from client_utils import run_on_queue, PLUGINS_QUEUE, get_queue_by_name
    def _run_bg(task):
        try:
            if get_queue_by_name(PLUGINS_QUEUE) is not None:
                run_on_queue(task, PLUGINS_QUEUE)
                return
        except Exception:
            pass
        threading.Thread(target=task, daemon=True).start()
except Exception:
    def _run_bg(task):
        threading.Thread(target=task, daemon=True).start()

import base64
import hashlib
import os
import zlib
from typing import Any, List
from base_plugin import BasePlugin, HookResult, HookStrategy
from ui.settings import Header, Input
from java import jclass
from org.telegram.messenger import ApplicationLoader, LocaleController

IntegerClass = jclass("java.lang.Integer")
LongClass = jclass("java.lang.Long")

__id__ = "message_undo"
__name__ = "Message Undo"
__description__ = "Добавляет кнопку с таймером, которая позволяет удалить последнее отправленное сообщение"
__author__ = "@dekma0091"
__version__ = "1.4"
__icon__ = "pixelcamera/11"
__min_version__ = "13.1.1"

ENTRY_CLASS = "ni.dekma.message_undo.MessageUndoBridge"
_ACTIVE_INSTANCE = None


def is_english():
    try:
        lang = str(LocaleController.getLocaleStringIso639() or "").lower()
        if lang:
            return not (lang.startswith("ru") or lang.startswith("uk") or lang.startswith("be"))
    except Exception:
        pass
    return False


class NativeBridge:
    def __init__(self, entry_class_name):
        self.entry_class_name = entry_class_name
        self.target_class = None
        self.loader = None
        self.is_active = False
        self.is_loading = False
        self.is_stopped = False
        self._lock = threading.Lock()
        self._cache = {}

    def start(self):
        with self._lock:
            if self.is_active or self.is_loading or self.is_stopped:
                return
            self.is_loading = True
        try:
            if self.target_class is None:
                ctx = ApplicationLoader.applicationContext
                if ctx is None:
                    raise RuntimeError("Application context is unavailable")
                if not _DEX_BASE64:
                    raise RuntimeError("Payload data is missing")
                compressed_data = base64.b64decode(_DEX_BASE64)
                dex_data = zlib.decompress(compressed_data)
                dex_buffer = None
                try:
                    ByteBuffer = jclass("java.nio.ByteBuffer")
                    InMemoryDexClassLoader = jclass("dalvik.system.InMemoryDexClassLoader")
                    dex_buffer = ByteBuffer.wrap(dex_data)
                    self.loader = InMemoryDexClassLoader(dex_buffer, ctx.getClassLoader())
                    self.target_class = self.loader.loadClass(self.entry_class_name)
                except Exception:
                    cache_dir = ctx.getCacheDir().getAbsolutePath()
                    dex_hash = hashlib.sha256(_DEX_BASE64.encode()).hexdigest()[:12]
                    dex_path = os.path.join(cache_dir, f"plugin_{dex_hash}.dex")
                    opt_dir = os.path.join(cache_dir, f"dex_opt_{dex_hash}")
                    os.makedirs(opt_dir, exist_ok=True)
                    if not os.path.exists(dex_path):
                        with open(dex_path, "wb") as f:
                            f.write(dex_data)
                    DexClassLoader = jclass("dalvik.system.DexClassLoader")
                    self.loader = DexClassLoader(dex_path, opt_dir, None, ctx.getClassLoader())
                    self.target_class = self.loader.loadClass(self.entry_class_name)
                finally:
                    del dex_buffer
                    del dex_data
                    del compressed_data
            self._invoke_static("load")
            with self._lock:
                if self.is_stopped:
                    try:
                        self._invoke_static("unload")
                    except Exception:
                        pass
                    self.is_active = False
                else:
                    self.is_active = True
                self.is_loading = False
        except Exception:
            with self._lock:
                self.is_active = False
                self.is_loading = False
            try:
                self._invoke_static("unload")
            except Exception:
                pass
            raise

    def stop(self):
        with self._lock:
            self.is_stopped = True
            if self.target_class is None or not self.is_active:
                return
            self.is_active = False
        try:
            self._invoke_static("unload")
        except Exception:
            pass
        self.target_class = None
        self.loader = None

    def show_undo(self, account: int, peer_id: int):
        with self._lock:
            if not self.is_active or self.target_class is None:
                return
        try:
            self._invoke_static("showUndo", IntegerClass(int(account)), LongClass(int(peer_id)))
        except Exception:
            pass

    def _invoke_static(self, method_name, *args):
        if self.target_class is None:
            raise RuntimeError("Target class reference is null")
        key = (method_name, len(args))
        method = self._cache.get(key)
        if method is None:
            for m in self.target_class.getDeclaredMethods():
                if str(m.getName()) == method_name and len(m.getParameterTypes()) == len(args):
                    m.setAccessible(True)
                    self._cache[key] = m
                    method = m
                    break
        if method is None:
            raise RuntimeError(f"Static method not found: {method_name}")
        return method.invoke(None, *args)


class message_undo(BasePlugin):
    def __init__(self):
        super().__init__()
        self.bridge = NativeBridge(ENTRY_CLASS)

    def on_plugin_load(self):
        global _ACTIVE_INSTANCE
        if _ACTIVE_INSTANCE is not None and _ACTIVE_INSTANCE is not self:
            try:
                _ACTIVE_INSTANCE.on_plugin_unload()
            except Exception:
                pass
        _ACTIVE_INSTANCE = self
        def _bg_init():
            try:
                self.bridge.start()
            except Exception as err:
                try:
                    self.bridge.stop()
                except Exception as stop_err:
                    self.log(f"Stop error: {stop_err}")
                self.log(f"Start error: {err}")
            if self.bridge.is_stopped:
                return
            try:
                self.add_on_send_message_hook()
            except Exception:
                pass
        _run_bg(_bg_init)

    def on_plugin_unload(self):
        global _ACTIVE_INSTANCE
        try:
            self.remove_hook("send_message_hook")
        except Exception:
            pass
        try:
            self.bridge.stop()
        except Exception as err:
            self.log(f"Unload error: {err}")
        if _ACTIVE_INSTANCE is self:
            _ACTIVE_INSTANCE = None

    def on_send_message_hook(self, account: int, params: Any) -> HookResult:
        try:
            peer_id = getattr(params, "peer", 0) if params else 0
            self.bridge.show_undo(account, peer_id)
            return HookResult(strategy=HookStrategy.DEFAULT)
        finally:
            del params

    def create_settings(self) -> List[Any]:
        en = is_english()
        return [
            Header(text="Undo send settings" if en else "Настройки отмены отправки"),
            Input(
                key="duration",
                text="Display duration (seconds)" if en else "Время отображения (секунды)",
                default="5",
                subtext="Undo button display duration from 1 to 60 seconds" if en else "Длительность показа кнопки отмены от 1 до 60 секунд",
            ),
        ]


_DEX_BASE64 = ""
