__id__ = "soundpad"
__name__ = "Soundpad"
__description__ = "Панель звуков во время записи голосового, кружка и в звонке."
__version__ = "0.3.9"
__author__ = "@van1lLove"
__min_version__ = "12.5.1"
__icon__ = "VanilPluginIcons/1"

import base64
import json
import os
import re
import time
import uuid
from concurrent.futures import ThreadPoolExecutor

from android_utils import run_on_ui_thread
from base_plugin import BasePlugin, MenuItemData, MenuItemType, MethodHook
from client_utils import get_last_fragment
from java import dynamic_proxy, jboolean, jclass, jint, jlong
from java.nio import ByteBuffer
from org.telegram.messenger import ApplicationLoader
from android.view import View
from ui.alert import AlertDialogBuilder
from ui.settings import Header, Switch, Text, Selector
try:
    from ui.settings import Custom
except ImportError:
    Custom = None


DEX = ""
CHANNEL = "https://t.me/van1lPLugin"
PICK_AUDIO = 26141
MAX_BYTES = 32 * 1024 * 1024
MAX_CLIPS = 48
VOLUMES = [25, 50, 75, 100]
PANEL_VALUES = {
    "opacity": ("Непрозрачность фона", ["45%", "60%", "75%", "88%", "100%"], [45, 60, 75, 88, 100], 2),
    "width": ("Ширина", ["Узкая", "Средняя", "Широкая", "Очень широкая"], [164, 194, 232, 282], 1),
    "rows": ("Видимых звуков", ["2", "3", "4", "5", "6"], [2, 3, 4, 5, 6], 1),
    "radius": ("Скругление", ["Прямые углы", "Малое", "Среднее", "Большое"], [0, 9, 17, 25], 2),
    "font": ("Размер названий", ["Мелкий", "Средний", "Крупный"], [12, 14, 17], 1),
    "style": ("Стиль полоски", ["Material 3", "Обычная", "Сегменты"], [0, 1, 2], 0),
    "barHeight": ("Толщина полоски", ["Тонкая", "Средняя", "Толстая"], [3, 6, 10], 1),
}
PANEL_SWITCHES = {
    "compact": ("Компактные строки", False),
    "shadow": ("Тень окна", True),
    "progress": ("Показывать полоску", True),
    "time": ("Показывать время", True),
    "animate": ("Анимации вкладок и цифр", True),
}
PANEL_COLORS = {
    "surface": "Фон окна", "active": "Цвет полоски и акцентов", "track": "Цвет дорожки", "textColor": "Цвет текста",
}


class Callback(MethodHook):
    def __init__(self, callback, before=False):
        super().__init__()
        self.callback = callback
        self.before = before

    def before_hooked_method(self, param):
        if self.before:
            self.callback(param)

    def after_hooked_method(self, param):
        if not self.before:
            self.callback(param)


class PanelAction(dynamic_proxy(jclass("java.util.function.Consumer"))):
    def __init__(self, run):
        super().__init__()
        self.run = run

    def accept(self, value):
        self.run(str(value))


class Soundpad(BasePlugin):
    def on_plugin_load(self):
        self.app = ApplicationLoader.applicationContext
        self.loader = self.app.getClassLoader()
        self.folder = os.path.join(str(self.app.getFilesDir().getAbsolutePath()), "soundpad")
        os.makedirs(self.folder, exist_ok=True)
        for filename in os.listdir(self.folder):
            if re.fullmatch(r"[a-f0-9]{32}\.part", filename):
                os.unlink(os.path.join(self.folder, filename))
        self.worker = ThreadPoolExecutor(max_workers=1, thread_name_prefix="soundpad")
        self.alive = True
        self.ticket = 0
        self.pending_picker = False
        self.picker_since = 0.0
        self.player = None
        self.preview_dialog = None
        self.appearance_demo = None
        self.board_view = None
        self.panel_owner = None
        self.panel_mode = 0
        self.route = 0
        self.panel_listener = None
        self.hooks = []
        self.methods = {}
        self.core_error = ""
        try:
            dex_loader = jclass("dalvik.system.InMemoryDexClassLoader")(ByteBuffer.wrap(base64.b64decode(DEX)), self.loader)
            core = dex_loader.loadClass("com.soundpad.SoundCore")
            self.methods = {str(m.getName()): m for m in core.getDeclaredMethods()}
            self._core("install", self.loader)
        except Exception as exc:
            self.core_error = "На этой сборке не удалось подключить исходящий звук"
            self.log(f"[Soundpad] {exc}")
        self._add_hooks()
        if "prepare" in self.methods:
            self.worker.submit(self._prepare_existing, self._clips())
        for kind in (MenuItemType.CHAT_ACTION_MENU, MenuItemType.DRAWER_MENU):
            self.add_menu_item(MenuItemData(menu_type=kind, text="Soundpad", on_click=self._open,
                                            item_id="soundpad_" + str(kind).rsplit(".", 1)[-1]))

    def on_plugin_unload(self):
        self.alive = False
        self.ticket += 1
        if "uninstall" in self.methods:
            try:
                self._core("uninstall")
            except Exception as exc:
                self.log(f"[Soundpad] {exc}")
        for hook in reversed(self.hooks):
            try:
                self.unhook_method(hook)
            except Exception as exc:
                self.log(f"[Soundpad] {exc}")
        self.worker.shutdown(wait=False, cancel_futures=True)
        run_on_ui_thread(self._close_ui)

    def _close_ui(self):
        self.appearance_demo = None
        self.board_view = None
        self._stop_preview()
        self._hide_panel()

    def _hide_panel(self):
        owner, self.panel_owner = self.panel_owner, None
        route, self.route = self.route, 0
        self.panel_mode = 0
        self.panel_listener = None
        if route:
            self.ticket += 1
            try:
                self._core("end", jlong(route))
            finally:
                if owner is not None:
                    try:
                        owner.removeOnAttachStateChangeListener(self.detach)
                    except Exception as exc:
                        self.log(f"[Soundpad] Слушатель панели: {exc}")

    def _core(self, name, *args):
        return self.methods[name].invoke(None, list(args))

    def _install_hook(self, cls, name, cb, args=(), before=False):
        method = self.loader.loadClass(cls).getDeclaredMethod(name, list(args))
        method.setAccessible(True)
        self.hooks.append(self.hook_method(method, Callback(cb, before)))

    def _add_hooks(self):
        integer = jclass("java.lang.Integer").TYPE
        specs = (
            ("org.telegram.ui.LaunchActivity", "onActivityResult", self._picked,
             (integer, integer, self.loader.loadClass("android.content.Intent")), True),
            ("org.telegram.ui.GroupCallActivity", "show", self._group_open, (), False),
            ("org.telegram.ui.VoIPFragment", "show", self._private_open,
             (self.loader.loadClass("android.app.Activity"), integer), False),
        )
        self.picker_available = False
        self.detach = Detached(self)
        try:
            enter = "org.telegram.ui.Components.ChatActivityEnterView"
            cls = self.loader.loadClass(enter)
            self.recording = cls.getDeclaredField("recordingAudioVideo")
            self.recording.setAccessible(True)
            self._install_hook(enter, "updateRecordInterface", self._record_ui,
                               (integer, jclass("java.lang.Boolean").TYPE))
        except Exception as exc:
            self.log(f"[Soundpad] Интерфейс записи: {exc}")
        for cls, name, fn, args, before in specs:
            try:
                self._install_hook(cls, name, fn, args, before)
                if before:
                    self.picker_available = True
            except Exception as exc:
                self.log(f"[Soundpad] {name}: {exc}")

    def _activity(self):
        frag = get_last_fragment()
        activity = frag.getParentActivity() if frag is not None else None
        if activity is None:
            activity = jclass("org.telegram.ui.LaunchActivity").instance
        return activity

    def _toast(self, text):
        if self.alive:
            toast = jclass("android.widget.Toast")
            toast.makeText(self.app, str(text), toast.LENGTH_SHORT).show()

    def _clips(self):
        try:
            rows = json.loads(str(self.get_setting("clips", "[]")))
        except (ValueError, TypeError):
            return []
        if not isinstance(rows, list):
            return []
        return [r for r in rows[:MAX_CLIPS] if isinstance(r, dict) and
                re.fullmatch(r"[a-f0-9]{32}", str(r.get("id", ""))) and
                isinstance(r.get("name"), str) and os.path.isfile(self._path(r["id"]))]

    def _save(self, clips):
        data = json.dumps(clips, ensure_ascii=False)
        self.set_setting("clips", data)
        try:
            if self.board_view is not None and self.board_view.isAttachedToWindow():
                self._core("updateClipList", self.board_view, data)
            if self.route:
                self._core("panelItems", jlong(self.route), data)
        except Exception as exc:
            self.log(f"[Soundpad] Обновление списка: {exc}")

    def _path(self, uid):
        return os.path.join(self.folder, uid + ".audio")

    def _prepare_existing(self, clips):
        for item in clips:
            if not self.alive:
                break
            path = self._path(item["id"])
            if not os.path.isfile(path + ".pcm"):
                try:
                    self._core("prepare", path, path + ".pcm")
                except Exception as exc:
                    self.log(f"[Soundpad] Подготовка: {exc}")

    def _delete_files(self, uid):
        path = self._path(uid)
        for file in (path, path + ".pcm"):
            try:
                os.unlink(file)
            except FileNotFoundError:
                pass

    def _volume(self):
        try:
            return VOLUMES[max(0, min(int(self.get_setting("volume", 2)), len(VOLUMES) - 1))]
        except (ValueError, TypeError):
            return 75

    def _picker(self, *_):
        if not self.picker_available or "importFile" not in self.methods:
            self._toast("Выбор файлов недоступен в этой сборке клиента")
            return
        if self.pending_picker and time.monotonic() - self.picker_since < 2:
            return
        activity = self._activity()
        if activity is None:
            return
        Intent = jclass("android.content.Intent")
        intent = Intent(Intent.ACTION_OPEN_DOCUMENT)
        intent.addCategory(Intent.CATEGORY_OPENABLE)
        intent.setType("audio/*")
        intent.putExtra(Intent.EXTRA_ALLOW_MULTIPLE, jboolean(True))
        self.pending_picker = True
        self.picker_since = time.monotonic()
        try:
            activity.startActivityForResult(intent, jint(PICK_AUDIO))
        except Exception:
            self.pending_picker = False
            self._toast("Не удалось открыть системный выбор файлов")

    def _picked(self, param):
        if not self.alive or not self.pending_picker or int(param.args[0]) != PICK_AUDIO:
            return
        self.pending_picker = False
        param.setResult(None)
        result = param.args[2]
        if int(param.args[1]) != -1 or result is None:
            return
        multi = result.getClipData()
        available = MAX_CLIPS - len(self._clips())
        uris = ([multi.getItemAt(i).getUri() for i in range(min(multi.getItemCount(), available))]
                if multi is not None else [result.getData()] if available else [])
        if not uris:
            self._toast("В Soundpad помещается до 48 звуков")
            return
        self.worker.submit(self._import_many, [uri for uri in uris if uri is not None])

    def _import_many(self, uris):
        good = []
        for uri in uris:
            if not self.alive:
                break
            try:
                good.append(self._import_one(uri))
            except Exception as exc:
                self.log(f"[Soundpad] Импорт: {exc}")
        def finish():
            clips = self._clips() if self.alive else []
            accepted = good[:MAX_CLIPS - len(clips)] if self.alive else []
            try:
                if accepted:
                    self._save(clips + accepted)
            except Exception:
                accepted = []
            for item in good:
                if item not in accepted:
                    self._delete_files(item["id"])
            if self.alive:
                self._toast(f"Добавлено: {len(accepted)}" +
                            (f" · не добавлено: {len(uris) - len(accepted)}" if len(accepted) != len(uris) else ""))
        run_on_ui_thread(finish)

    def _import_one(self, uri):
        resolver = self.app.getContentResolver()
        name = "Звук"
        try:
            cursor = resolver.query(uri, ["_display_name"], None, None, None)
        except Exception:
            cursor = None
        if cursor is not None:
            try:
                if cursor.moveToFirst() and cursor.getString(0):
                    name = str(cursor.getString(0))
            finally:
                cursor.close()
        name = re.sub(r"[\x00-\x1f]", " ", name).strip()
        stem, ext = os.path.splitext(name)
        if stem.strip() and re.fullmatch(r"\.[A-Za-z0-9]{2,5}", ext):
            name = stem.strip()
        name = name[:70] or "Звук"
        uid = uuid.uuid4().hex
        part = os.path.join(self.folder, uid + ".part")
        path = self._path(uid)
        try:
            duration = int(self._core("importFile", self.app, uri, part, path + ".pcm", jint(MAX_BYTES)))
            os.replace(part, path)
            return {"id": uid, "name": name, "ms": duration}
        finally:
            if os.path.exists(part):
                os.unlink(part)
            if not os.path.exists(path):
                self._delete_files(uid)

    def _open(self, *_):
        run_on_ui_thread(self._board)

    def _target(self):
        frag = get_last_fragment()
        chat = self.loader.loadClass("org.telegram.ui.ChatActivity")
        if frag is None or not chat.isInstance(frag):
            return None
        return int(frag.getCurrentAccount()), int(frag.getDialogId())

    def _select(self, title, actions, message=None):
        activity = self._activity()
        if activity is None or not self.alive:
            return
        box = AlertDialogBuilder(activity)
        box.set_title(title)
        if message:
            box.set_message(message)
        box.set_items([label for label, action in actions], lambda d, w: actions[int(w)][1]())
        box.set_negative_button("Закрыть", lambda d, w: d.dismiss())
        box.show()
        return box

    def _board(self):
        activity = self._activity()
        if activity is None or not self.alive:
            return
        clips = self._clips()
        description = "Нажми на звук, чтобы открыть меню. Чтобы изменить порядок, зажми строку и перетащи её."
        if not clips:
            description = "Добавь один или несколько аудиофайлов с телефона."
        if self.core_error:
            description += "\n\n" + self.core_error
        box = AlertDialogBuilder(activity)
        box.set_title("Управление звуками")
        box.set_message(description)
        config = self._style_config()
        view = self._core("createClipList", activity, jint(self._theme_color("textColor") - 0x100000000),
                          jint(config["accent"]), jint(config["base"]),
                          json.dumps(clips, ensure_ascii=False), PanelAction(self._board_action))
        box.set_view(view, -2)
        box.set_positive_button("Добавить файлы", lambda *_: self._picker())
        box.set_negative_button("Закрыть", lambda d, w: d.dismiss())
        if self.player is not None:
            box.set_neutral_button("Остановить предпрослушивание", lambda *_: self._stop_preview())
        elif self.route and int(self._core("playing")) > 0:
            box.set_neutral_button("Остановить эффект", lambda *_: self._stop_effect())
        self.board_view = view
        box.show()

    def _stop_effect(self):
        self._stop()
        self._paint_progress()

    def _board_action(self, action):
        if not self.alive:
            return
        kind, uid, *rest = action.split(":")
        clips = self._clips()
        item = next((clip for clip in clips if clip["id"] == uid), None)
        if item is None:
            return
        if kind == "open":
            self._clip_actions(item)
        elif kind in ("before", "after") and rest and rest[0] != uid:
            clips.remove(item)
            target = next((i for i, clip in enumerate(clips) if clip["id"] == rest[0]), None)
            if target is not None:
                clips.insert(target + (kind == "after"), item)
                self._save(clips)

    def _clip_actions(self, item):
        clips = self._clips()
        index = next((i for i, clip in enumerate(clips) if clip["id"] == item["id"]), -1)
        if index < 0:
            return
        item = clips[index]
        actions = [
            ("Изменить название", lambda: self._rename(item)),
            ("Убрать из избранного" if item.get("favorite") else "Добавить в избранное",
             lambda: self._favorite(item)),
        ]
        actions.extend([("Послушать на телефоне", lambda: self._preview(item)), ("Удалить из библиотеки", lambda: self._delete(item))])
        self._select(item["name"], actions,
                     f"Место в списке «Все» — {index + 1} из {len(clips)}. "
                     + ("Звук есть во вкладке «Избранное»." if item.get("favorite")
                        else "Добавь ★, если хочешь видеть этот звук во вкладке «Избранное».")
                     + " Предпрослушивание слышишь только ты.")

    def _favorite(self, item):
        self._save([dict(row, favorite=not row.get("favorite")) if row["id"] == item["id"] else row
                    for row in self._clips()])

    def _in_call(self):
        try:
            return not self.core_error and bool(self._core("inCall"))
        except Exception:
            return False

    def _rename(self, item):
        ui = self._activity()
        box = AlertDialogBuilder(ui)
        field = jclass("android.widget.EditText")(ui)
        field.setSingleLine(True)
        field.setText(item["name"])
        field.selectAll()
        theme = jclass("org.telegram.ui.ActionBar.Theme")
        field.setTextColor(theme.getColor(theme.key_dialogTextBlack))
        box.set_title("Название звука")
        box.set_view(field, -2)
        def save(*_):
            name = str(field.getText()).strip()[:70]
            if name:
                self._save([dict(row, name=name) if row["id"] == item["id"] else row for row in self._clips()])
        box.set_positive_button("Сохранить", save)
        box.set_negative_button("Отмена", lambda d, w: d.dismiss())
        box.show()

    def _delete(self, item):
        box = AlertDialogBuilder(self._activity())
        box.set_title("Удалить звук?")
        box.set_message(item["name"])
        def remove(*_):
            self._stop()
            self._save([row for row in self._clips() if row["id"] != item["id"]])
            self._delete_files(item["id"])
        box.set_positive_button("Удалить", remove)
        box.set_negative_button("Отмена", lambda d, w: d.dismiss())
        box.show()

    def _stop_preview(self):
        player, self.player = self.player, None
        dialog, self.preview_dialog = self.preview_dialog, None
        if player is not None:
            try:
                player.release()
            except Exception as exc:
                self.log(f"[Soundpad] Предпрослушивание: {exc}")
        if dialog is not None:
            try:
                dialog.dismiss()
            except Exception:
                pass

    def _stop(self):
        self.ticket += 1
        self._stop_preview()
        if not self.core_error:
            return int(self._core("stop"))

    def _preview(self, item):
        if self.route or self._in_call():
            self._toast("Предпрослушивание доступно вне записи и звонка")
            return
        self._stop()
        player = jclass("android.media.MediaPlayer")()
        try:
            player.setDataSource(self._path(item["id"]))
            self.player = player
            player.setOnPreparedListener(Prepared(self))
            player.setOnCompletionListener(PreviewCompleted(self))
            player.setOnErrorListener(PreviewFailed(self))
            player.prepareAsync()
            run_on_ui_thread(self._preview_controls, 120)
        except Exception:
            self.player = None
            player.release()
            self._toast("Не удалось воспроизвести файл")

    def _preview_controls(self):
        if not self.alive or self.player is None:
            return
        self.preview_dialog = self._select("Предпрослушивание", [("Остановить предпрослушивание", self._stop_preview)],
                                           "Этот звук сейчас играет только на телефоне.")

    def _play(self, item):
        if not self.route:
            return
        stamp = self._stop()
        token, route = self.ticket, self.route
        volume = self._volume()
        path = self._path(item["id"])
        self._paint_progress(item, 0, True)

        def work():
            if not self.alive or token != self.ticket:
                return
            try:
                result = self._core("play", path, path + ".pcm", jlong(route), jlong(stamp), jint(volume))
                msg = "" if result is None else str(result)
            except Exception as exc:
                self.log(f"[Soundpad] {exc}")
                msg = "Не удалось открыть звук"

            def ready():
                if token != self.ticket or route != self.route:
                    return
                if msg:
                    self._paint_progress()
                    self._toast(msg)
                else:
                    self._refresh_playback(token, item)
            run_on_ui_thread(ready)
        self.worker.submit(work)

    def _paint_progress(self, item=None, elapsed=0, waiting=False):
        if self.route:
            clip = item or {}
            self._core("panelProgress", jlong(self.route), clip.get("id", ""), clip.get("name", ""),
                       jint(elapsed), jint(clip.get("ms", 0)), jboolean(waiting))

    def _refresh_playback(self, token, item):
        if not self.alive or not self.route or token != self.ticket:
            return
        state = int(self._core("playing"))
        if state > 0:
            self._paint_progress(item, int(self._core("progressMillis")), state == 1)
            run_on_ui_thread(lambda: self._refresh_playback(token, item), 70)
        elif state < 0:
            self._paint_progress()
            self._toast("Клиент не передал звук в текущую запись")
        else:
            self._paint_progress(item, int(item.get("ms", 0)))
            run_on_ui_thread(lambda: self._paint_progress() if token == self.ticket else None, 650)

    def _record_ui(self, param):
        enter = param.thisObject
        def sync():
            if not self.alive or self.core_error:
                return
            if not self.recording.getBoolean(enter):
                if self.panel_owner == enter:
                    self._hide_panel()
                return
            mode = 2 if enter.isInVideoMode() else 1
            if self.panel_owner == enter and self.panel_mode == mode:
                return
            target = self._target()
            if target is None:
                return
            self._attach(enter.getRootView(), enter, mode, target)
        run_on_ui_thread(sync)

    def _group_open(self, param):
        sheet = param.thisObject
        def attach():
            window = sheet.getWindow()
            if window is not None and sheet.isShowing():
                root = window.getDecorView()
                self._attach(root, root, 3, (0, 0))
        run_on_ui_thread(attach)

    def _private_open(self, param):
        def attach():
            cls = self.loader.loadClass("org.telegram.ui.VoIPFragment")
            fragment = cls.getMethod("getInstance", []).invoke(None, [])
            if fragment is not None:
                field = cls.getDeclaredField("windowView")
                field.setAccessible(True)
                root = field.get(fragment)
                if root is not None:
                    self._attach(root, root, 3, (0, 0))
        run_on_ui_thread(attach)

    def _attach(self, root, owner, mode, target):
        if not self.alive or self.core_error or root is None:
            return
        if not self.loader.loadClass("android.widget.FrameLayout").isInstance(root):
            return
        if self.panel_owner == owner and self.panel_mode == mode:
            return
        self._hide_panel()
        self._stop_preview()
        route = int(self._core("begin", jint(mode), jint(target[0]), jlong(target[1])))
        if not route:
            return

        self.route, self.panel_owner, self.panel_mode = route, owner, mode
        try:
            config = self._panel_config(root, owner, mode)
            owner.addOnAttachStateChangeListener(self.detach)
            self.panel_listener = PanelAction(lambda action: self._safe_panel_action(route, action))
            self._core("showPanel", jlong(route), root, json.dumps(config),
                       json.dumps(self._clips(), ensure_ascii=False), self.panel_listener)
        except Exception as exc:
            self._hide_panel()
            self.log(f"[Soundpad] Панель: {exc}")
            self._toast("Не удалось открыть панель Soundpad")
            return
        if mode != 3:
            run_on_ui_thread(lambda: self._core("raisePanel", jlong(route)) if self.route == route else None, 320)
        run_on_ui_thread(lambda: self._watch_panel(route), 250)

    def _watch_panel(self, route):
        if not self.alive or route != self.route:
            return
        try:
            active = (self._core("panelActive", jlong(route)) and self.panel_owner.isAttachedToWindow()
                      and (self.panel_mode == 3 or self.recording.getBoolean(self.panel_owner)))
        except Exception as exc:
            self.log(f"[Soundpad] Состояние записи: {exc}")
            active = False
        if active:
            run_on_ui_thread(lambda: self._watch_panel(route), 250)
        else:
            self._hide_panel()

    def _safe_panel_action(self, route, action):
        if not self.alive or route != self.route:
            return
        try:
            self._panel_action(action)
        except Exception as exc:
            self.log(f"[Soundpad] Действие панели: {exc}")
            self._toast("Не удалось выполнить действие Soundpad")

    def _panel_action(self, action):
        if action == "stop":
            self._stop()
            self._paint_progress()
        elif action.startswith("clip:"):
            clip = next((r for r in self._clips() if r["id"] == action[5:]), None)
            if clip:
                self._play(clip)
        elif action.startswith("move:"):
            _, x, y = action.split(":")
            position = "call" if self.panel_mode == 3 else "record"
            self.set_setting("pad_position_" + position, json.dumps([float(x), float(y)]))

    def _style_config(self):
        theme = jclass("org.telegram.ui.ActionBar.Theme")
        config = dict(base=int(theme.getColor(theme.key_dialogBackground)),
                      text=int(theme.getColor(theme.key_dialogTextBlack)),
                      accent=int(theme.getColor(theme.key_dialogTextLink)))
        for key, (_, _, values, default) in PANEL_VALUES.items():
            try:
                index = int(self.get_setting("pad_" + key, default))
            except (TypeError, ValueError):
                index = default
            config[key] = values[index] if 0 <= index < len(values) else values[default]
        for key, (_, default) in PANEL_SWITCHES.items():
            config[key] = bool(self.get_setting("pad_" + key, default))
        for key in PANEL_COLORS:
            value = str(self.get_setting("pad_" + key, "") or "").strip()
            if re.fullmatch(r"#[\da-fA-F]{6}", value):
                if key == "textColor":
                    config["text"] = int(value[1:], 16) - 0x1000000
                else:
                    config[key] = value
        return config

    def _panel_config(self, root, owner, mode):
        config = self._style_config()
        config["call"] = mode == 3
        pos = "call" if mode == 3 else "record"
        try:
            x, y = json.loads(str(self.get_setting("pad_position_" + pos, "null")))
            if 0 <= x <= 1 and 0 <= y <= 1:
                config.update(x=x, y=y)
        except (ValueError, TypeError):
            pass
        if mode != 3:
            from java import jarray
            origin, xy = jarray(jint)(2), jarray(jint)(2)
            root.getLocationInWindow(origin)
            owner.getLocationInWindow(xy)
            dp = root.getResources().getDisplayMetrics().density
            config["clearance"] = max(round(dp * 62), min(int(root.getHeight() * .55),
                                                      int(root.getHeight() + origin[1] - xy[1] + dp * 8)))
        return config

    def _reset_position(self, *_):
        for key in ("pad_position_record", "pad_position_call"):
            self.set_setting(key, "null")
        self._toast("Положение панели сброшено")

    def _make_demo(self, activity):
        return self._core("createDemo", activity, json.dumps(self._style_config()))

    def _theme_color(self, key):
        theme = jclass("org.telegram.ui.ActionBar.Theme")
        if key == "track":
            text = int(theme.getColor(theme.key_dialogTextBlack))
            return (text & 0xffffff) | 0xff000000
        attribute = {"surface": "key_dialogBackground", "active": "key_dialogTextLink",
                     "textColor": "key_dialogTextBlack"}[key]
        return int(theme.getColor(getattr(theme, attribute))) & 0xffffffff

    def _choose_color(self, key):
        activity = self._activity()
        if activity is None or not self.alive:
            return
        raw = str(self.get_setting("pad_" + key, "") or "").strip()
        initial = (int(raw[1:], 16) | 0xff000000) if re.fullmatch(r"#[\da-fA-F]{6}", raw) else self._theme_color(key)
        view = self._core("createColorPicker", activity, jint(initial - 0x100000000))
        box = AlertDialogBuilder(activity)
        box.set_title(PANEL_COLORS[key])
        box.set_view(view, -2)

        def apply(value):
            self.set_setting("pad_" + key, value)
            self._refresh_demo()

        box.set_positive_button("Выбрать", lambda *_: apply(f'#{int(self._core("selectedColor", view)) & 0xffffff:06X}'))
        box.set_neutral_button("Цвет темы", lambda *_: apply(""))
        box.set_negative_button("Отмена", lambda d, w: d.dismiss())
        box.show()

    def _preview_window(self, *args):
        clicked = args[0] if args else None

        def show():
            try:
                activity = None
                if clicked is not None:
                    activity = jclass("org.telegram.messenger.AndroidUtilities").findActivity(clicked.getContext())
                if activity is None:
                    activity = self._activity()
                if activity is None or "createDemo" not in self.methods:
                    self._toast("Живой пример недоступен. Открой настройки в главном окне клиента.")
                    return
                box = AlertDialogBuilder(activity)
                box.set_title("Как выглядит панель")
                box.set_message("Нажми на звук, чтобы увидеть таймер. Перетащи панель за верхнюю строку.")
                demo = self._make_demo(activity)
                try:
                    box.set_view(demo, -2)
                except TypeError:
                    box.set_view(demo)
                box.set_positive_button("Готово", lambda d, w: d.dismiss())
                box.show()
            except Exception as exc:
                self.log(f"[Soundpad] Пример панели: {exc}")
                self._toast("Не удалось открыть пример панели")
        run_on_ui_thread(show)

    def _refresh_demo(self, *_):
        def refresh():
            if self.alive and self.appearance_demo is not None:
                self._core("updateDemo", self.appearance_demo, json.dumps(self._style_config()))
        run_on_ui_thread(refresh)

    def _appearance(self):
        selectors = {key: Selector(key="pad_" + key, text=label, default=default,
                                   items=labels, on_change=self._refresh_demo)
                     for key, (label, labels, _, default) in PANEL_VALUES.items()}
        switch_hints = {
            "compact": "Меньше высота строк, больше места для записи",
            "shadow": "Отделяет панель от чата или видео",
            "progress": "Показывает, какая часть звука уже прозвучала",
            "time": "Слева прошло, справа полная длительность",
            "animate": "Скользящая вкладка и вращение цифр таймера",
        }
        switches = {key: Switch(key="pad_" + key, text=label, default=default,
                                subtext=switch_hints[key], on_change=self._refresh_demo)
                    for key, (label, default) in PANEL_SWITCHES.items()}
        colors = [Text(text=label, on_click=lambda *_, key=key: run_on_ui_thread(lambda: self._choose_color(key)))
                  for key, label in PANEL_COLORS.items()]
        rows = [
            self._preview_row(),
            Header(text="Окно"),
            selectors["opacity"], selectors["width"], selectors["rows"], selectors["radius"], selectors["font"],
            switches["compact"], switches["shadow"],
            Text(text="Сбросить положение окна", subtext="Вернуть панель к левому краю в записи и звонке",
                 on_click=lambda *_: run_on_ui_thread(self._reset_position)),
            Header(text="Полоска и таймер"),
            selectors["style"], selectors["barHeight"],
            switches["progress"], switches["time"], switches["animate"],
            Header(text="Цвета"),
        ] + colors
        if Custom is not None and "createDemo" in self.methods:
            try:
                self.appearance_demo = self._make_demo(self.app)
                rows += [Header(text="Живой пример с твоими настройками"), Custom(view=self.appearance_demo)]
            except Exception as exc:
                self.log(f"[Soundpad] Пример в настройках: {exc}")
        return rows

    def _preview_row(self):
        return Text(text="Открыть живой пример", subtext="Панель, вкладки и таймер с твоими настройками",
                    on_click=self._preview_window)

    def _channel(self, *_):
        activity = self._activity()
        if activity is not None:
            jclass("org.telegram.messenger.browser.Browser").openUrl(activity, CHANNEL)

    def create_settings(self):
        rows = [
            Header(text="Панель во время записи"),
            self._preview_row(),
            Text(text="Где появится панель", subtext="Слева, когда начнёшь голосовое, кружок или звонок"),
            Header(text="Звуки"),
            Text(text="Управление звуками", subtext="Нажми для меню. Зажми и перетащи, чтобы изменить порядок", on_click=self._open),
            Text(text="Добавить звуки", subtext="Файлы до 32 МБ и трёх минут", on_click=lambda *_: run_on_ui_thread(self._picker)),
            Selector(key="volume", text="Громкость звука", default=2, items=["25%", "50%", "75%", "100%"]),
            Text(text="Внешний вид панели", subtext="Прозрачность, размеры, цвета и прогресс",
                 create_sub_fragment=self._appearance),
            Header(text="Дополнительно"),
            Text(text="Канал автора", subtext="@van1lPLugin", on_click=lambda *_: run_on_ui_thread(self._channel)),
        ]
        if self.core_error:
            rows.append(Text(text=self.core_error))
        return rows


class Detached(dynamic_proxy(View.OnAttachStateChangeListener)):
    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin

    def onViewAttachedToWindow(self, view):
        pass

    def onViewDetachedFromWindow(self, view):
        if self.plugin.panel_owner == view:
            self.plugin._hide_panel()


class Prepared(dynamic_proxy(jclass("android.media.MediaPlayer$OnPreparedListener"))):
    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin

    def onPrepared(self, player):
        if self.plugin.alive and player == self.plugin.player:
            if self.plugin._in_call():
                self.plugin._stop_preview()
            else:
                player.start()


class PreviewFailed(dynamic_proxy(jclass("android.media.MediaPlayer$OnErrorListener"))):
    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin

    def onError(self, player, what, extra):
        if player == self.plugin.player:
            self.plugin._stop_preview()
            self.plugin._toast("Не удалось воспроизвести файл")
        return True


class PreviewCompleted(dynamic_proxy(jclass("android.media.MediaPlayer$OnCompletionListener"))):
    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin

    def onCompletion(self, player):
        if player == self.plugin.player:
            self.plugin._stop_preview()


