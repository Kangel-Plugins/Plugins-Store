class iOSOverscroll(BasePlugin):
    def on_plugin_load(self):
        self.dex_class = None
        self.dex_loader = None
        self._last_valid = {
            "intensity": self._clean_number_str(self.get_setting("intensity", PRESETS[0]["intensity"]), PRESETS[0]["intensity"]),
            "fling_intensity": self._clean_number_str(self.get_setting("fling_intensity", PRESETS[0]["fling_intensity"]), PRESETS[0]["fling_intensity"]),
            "spring_speed": self._clean_number_str(self.get_setting("spring_speed", PRESETS[0]["spring_speed"]), PRESETS[0]["spring_speed"]),
            "spring_bounce": self._clean_number_str(self.get_setting("spring_bounce", PRESETS[0]["spring_bounce"]), PRESETS[0]["spring_bounce"]),
            "zoom_intensity": self._clean_number_str(self.get_setting("zoom_intensity", PRESETS[0]["zoom_intensity"]), PRESETS[0]["zoom_intensity"]),
            "stretch_intensity": self._clean_number_str(self.get_setting("stretch_intensity", PRESETS[0]["stretch_intensity"]), PRESETS[0]["stretch_intensity"]),
        }
        try:
            dex_bytes = base64.b64decode(DEX_B64)
            buffer = ByteBuffer.wrap(dex_bytes)
            parent_cl = ApplicationLoader.applicationContext.getClassLoader()
            self.dex_loader = InMemoryDexClassLoader(buffer, parent_cl)
            self.dex_class = self.dex_loader.loadClass("org.nlvxm.iosoverscroll.IOSOverScroll")

            start_method = self.dex_class.getMethod("start")
            start_method.invoke(None)

            self._sync_to_dex()
        except Exception as e:
            self.log(f"Load error: {e}\n{traceback.format_exc()}")

    def on_plugin_unload(self):
        try:
            if self.dex_class is not None:
                stop_method = self.dex_class.getMethod("stop")
                stop_method.invoke(None)
        except Exception as e:
            self.log(f"Unload error: {e}")
        finally:
            self.dex_class = None
            self.dex_loader = None

    def create_settings(self) -> List[Any]:
        preset_idx = int(self.get_setting("preset", 0))
        bounce_enabled = bool(self.get_setting("bounce_enabled", True))
        zoom_enabled = bool(self.get_setting("zoom_enabled", True))
        stretch_enabled = bool(self.get_setting("stretch_enabled", True))

        items: List[Any] = [
            Selector(
                key="preset",
                text=tr("Пресет", "Preset"),
                default=preset_idx,
                items=preset_names(),
                icon="msg_media",
                on_change=self._on_preset_change,
            ),
            Divider(),
            Switch(
                key="bounce_enabled",
                text=tr("Эффект отскока", "Bounce effect"),
                default=bounce_enabled,
                subtext=tr("Пружинящий отскок при возврате в исходное положение", "Springy bounce when the list returns to its original position"),
                icon="msg_blur_linear",
                on_change=self._on_bounce_toggle,
            ),
            Switch(
                key="zoom_enabled",
                text=tr("Зум элементов", "Zoom items"),
                default=zoom_enabled,
                subtext=tr("Плавное отдаление элементов списка в глубину", "List items smoothly recede into the background"),
                icon="menu_intro",
                on_change=self._on_zoom_toggle,
            ),
            Switch(
                key="stretch_enabled",
                text=tr("Растяжение элементов", "Stretch items"),
                default=stretch_enabled,
                subtext=tr("Растяжение элементов списка", "Stretch list items"),
                icon="pip_video_expand",
                on_change=self._on_stretch_toggle,
            ),
            Divider(),
            Input(
                key="intensity",
                text=tr("Интенсивность натяжения", "Overscroll tension"),
                default=str(self.get_setting("intensity", PRESETS[0]["intensity"])),
                subtext=tr("Сила растяжения списка (по умолч. 1.35)", "How far the list stretches (default: 1.35)"),
                icon="msg_edit",
                on_change=self._on_intensity_change,
            ),
            Input(
                key="fling_intensity",
                text=tr("Сила инерции (флинг)", "Fling strength"),
                default=str(self.get_setting("fling_intensity", PRESETS[0]["fling_intensity"])),
                subtext=tr("Сила отскока при резком свайпе (по умолч. 1.30)", "Bounce strength on a quick swipe (default: 1.30)"),
                icon="msg_edit",
                on_change=self._on_fling_change,
            ),
            Input(
                key="spring_speed",
                text=tr("Скорость возврата", "Return speed"),
                default=str(self.get_setting("spring_speed", PRESETS[0]["spring_speed"])),
                subtext=tr("Скорость отскока списка назад (по умолч. 19.5)", "How fast the list springs back (default: 19.5)"),
                icon="msg_edit",
                on_change=self._on_speed_change,
            ),
        ]

        if bounce_enabled:
            items.append(
                Input(
                    key="spring_bounce",
                    text=tr("Эффект пружины (отскок)", "Spring effect (bounce)"),
                    default=str(self.get_setting("spring_bounce", PRESETS[0]["spring_bounce"])),
                    subtext=tr("Демпфирование: <0.7 пружинистее, >0.8 мягче (по умолч. 0.72)", "Damping: <0.7 springier, >0.8 softer (default: 0.72)"),
                    icon="msg_edit",
                    on_change=self._on_bounce_change,
                )
            )

        if zoom_enabled:
            items.append(
                Input(
                    key="zoom_intensity",
                    text=tr("Интенсивность зума", "Zoom intensity"),
                    default=str(self.get_setting("zoom_intensity", PRESETS[0]["zoom_intensity"])),
                    subtext=tr("Множитель отдаления элементов (по умолч. 1.0)", "Multiplier for how far items recede (default: 1.0)"),
                    icon="msg_edit",
                    on_change=self._on_zoom_change,
                )
            )

        if stretch_enabled:
            items.append(
                Input(
                    key="stretch_intensity",
                    text=tr("Интенсивность растяжения", "Stretch intensity"),
                    default=str(self.get_setting("stretch_intensity", PRESETS[0]["stretch_intensity"])),
                    subtext=tr("Множитель растяжения элементов (по умолч. 1.0)", "Items stretch multiplier (default: 1.0)"),
                    icon="msg_edit",
                    on_change=self._on_stretch_change,
                )
            )

        items.append(Divider())
        items.append(
            Text(
                text=tr("Экспорт настроек", "Export settings"),
                icon="msg_unarchive",
                on_click=self._on_export_click,
            )
        )
        items.append(
            Text(
                text=tr("Импорт настроек", "Import settings"),
                icon="msg_archive",
                on_click=self._on_import_click,
            )
        )

        return items

    def _on_preset_change(self, new_index: int):
        if 0 <= new_index < len(PRESETS):
            p = PRESETS[new_index]
            data = {
                "preset": new_index,
                "intensity": p["intensity"],
                "fling_intensity": p["fling_intensity"],
                "spring_speed": p["spring_speed"],
                "spring_bounce": p["spring_bounce"],
                "zoom_intensity": p["zoom_intensity"],
                "stretch_intensity": p["stretch_intensity"],
            }
            self._last_valid.update({
                "intensity": p["intensity"],
                "fling_intensity": p["fling_intensity"],
                "spring_speed": p["spring_speed"],
                "spring_bounce": p["spring_bounce"],
                "zoom_intensity": p["zoom_intensity"],
                "stretch_intensity": p["stretch_intensity"],
            })
            try:
                self.import_settings(data, reload_settings=True)
            except Exception:
                for k, v in data.items():
                    self.set_setting(k, v)
            try:
                self.set_setting("preset", -1)
                self.set_setting("preset", new_index, reload_settings=True)
            except Exception:
                self.set_setting("preset", new_index)
            self._sync_to_dex()
        elif new_index == len(PRESETS):
            self.set_setting("preset", new_index)

    def _on_intensity_change(self, new_val: str):
        self._on_param_change("intensity", new_val)

    def _on_fling_change(self, new_val: str):
        self._on_param_change("fling_intensity", new_val)

    def _on_speed_change(self, new_val: str):
        self._on_param_change("spring_speed", new_val)

    def _on_bounce_change(self, new_val: str):
        self._on_param_change("spring_bounce", new_val)

    def _on_zoom_change(self, new_val: str):
        self._on_param_change("zoom_intensity", new_val)

    def _on_stretch_change(self, new_val: str):
        self._on_param_change("stretch_intensity", new_val)

    def _on_param_change(self, key: str, new_val: str):
        norm = self._normalize_number_str(new_val)
        if norm is None:
            fallback = self._last_valid.get(key, PRESETS[0].get(key, "1.0"))
            self.set_setting(key, fallback, reload_settings=True)
            try:
                from ui.bulletin import BulletinHelper
                BulletinHelper.show_error(tr("Введите положительное число", "Enter a positive number"))
            except Exception:
                pass
            return

        self._last_valid[key] = norm
        self.set_setting(key, norm)
        matched_preset = self._find_matching_preset()
        try:
            self.set_setting("preset", -1)
            self.set_setting("preset", matched_preset, reload_settings=True)
        except Exception:
            self.set_setting("preset", matched_preset)
        self._sync_to_dex()

    def _find_matching_preset_from_data(self, data: dict) -> int:
        cur_intensity = self._clean_number_str(data.get("intensity", self.get_setting("intensity", "")), "")
        cur_fling = self._clean_number_str(data.get("fling_intensity", self.get_setting("fling_intensity", "")), "")
        cur_speed = self._clean_number_str(data.get("spring_speed", self.get_setting("spring_speed", "")), "")
        cur_bounce = self._clean_number_str(data.get("spring_bounce", self.get_setting("spring_bounce", "")), "")
        cur_zoom = self._clean_number_str(data.get("zoom_intensity", self.get_setting("zoom_intensity", "")), "")
        cur_stretch = self._clean_number_str(data.get("stretch_intensity", self.get_setting("stretch_intensity", "")), "")

        for idx, p in enumerate(PRESETS):
            if (cur_intensity == p["intensity"] and
                cur_fling == p["fling_intensity"] and
                cur_speed == p["spring_speed"] and
                cur_bounce == p["spring_bounce"] and
                cur_zoom == p["zoom_intensity"] and
                cur_stretch == p["stretch_intensity"]):
                return idx
        return len(PRESETS)

    def _find_matching_preset(self) -> int:
        return self._find_matching_preset_from_data({})

    def _on_bounce_toggle(self, enabled: bool):
        self.set_setting("bounce_enabled", enabled, reload_settings=True)
        self._sync_to_dex()

    def _on_zoom_toggle(self, enabled: bool):
        self.set_setting("zoom_enabled", enabled, reload_settings=True)
        self._sync_to_dex()

    def _on_stretch_toggle(self, enabled: bool):
        self.set_setting("stretch_enabled", enabled, reload_settings=True)
        self._sync_to_dex()

    def _sync_to_dex(self):
        intensity = float(self._clean_number_str(self.get_setting("intensity", PRESETS[0]["intensity"]), PRESETS[0]["intensity"]))
        fling = float(self._clean_number_str(self.get_setting("fling_intensity", PRESETS[0]["fling_intensity"]), PRESETS[0]["fling_intensity"]))
        speed = float(self._clean_number_str(self.get_setting("spring_speed", PRESETS[0]["spring_speed"]), PRESETS[0]["spring_speed"]))
        bounce_enabled = bool(self.get_setting("bounce_enabled", True))
        if bounce_enabled:
            bounce = float(self._clean_number_str(self.get_setting("spring_bounce", PRESETS[0]["spring_bounce"]), PRESETS[0]["spring_bounce"]))
        else:
            bounce = 1.0
        zoom_enabled = bool(self.get_setting("zoom_enabled", True))
        if zoom_enabled:
            zoom = float(self._clean_number_str(self.get_setting("zoom_intensity", PRESETS[0]["zoom_intensity"]), PRESETS[0]["zoom_intensity"]))
        else:
            zoom = 0.0
        stretch_enabled = bool(self.get_setting("stretch_enabled", True))
        if stretch_enabled:
            stretch = float(self._clean_number_str(self.get_setting("stretch_intensity", PRESETS[0]["stretch_intensity"]), PRESETS[0]["stretch_intensity"]))
        else:
            stretch = 0.0
        self._apply_config(intensity, fling, speed, bounce, zoom, stretch)

    def _apply_config(self, i: float, f: float, o: float, z: float, zm: float, str_val: float):
        if self.dex_class is None:
            return
        try:
            for m in self.dex_class.getMethods():
                if m.getName() == "setConfig" and len(m.getParameterTypes()) == 6:
                    m.invoke(None, float(i), float(f), float(o), float(z), float(zm), float(str_val))
                    break
        except Exception as e:
            self.log(f"Config error: {e}")

    def _normalize_number_str(self, val: Any) -> Optional[str]:
        if val is None:
            return None
        s = str(val).replace(",", ".").strip()
        if not s:
            return None
        if s.startswith("."):
            s = "0" + s
        elif s.startswith("+."):
            s = "0" + s[1:]
        if s.endswith("."):
            s = s + "0"
        try:
            f = float(s)
            if f <= 0.0 or f != f or f == float("inf"):
                return None
            clean = f"{f:.4f}".rstrip("0").rstrip(".")
            if "." not in clean:
                clean = clean + ".0"
            return clean
        except Exception:
            return None

    def _clean_number_str(self, val: Any, fallback: str) -> str:
        norm = self._normalize_number_str(val)
        return norm if norm is not None else fallback

    def _on_export_click(self, view: Any = None):
        data = {
            "bounce_enabled": bool(self.get_setting("bounce_enabled", True)),
            "zoom_enabled": bool(self.get_setting("zoom_enabled", True)),
            "stretch_enabled": bool(self.get_setting("stretch_enabled", True)),
            "intensity": self._clean_number_str(self.get_setting("intensity", PRESETS[0]["intensity"]), PRESETS[0]["intensity"]),
            "fling_intensity": self._clean_number_str(self.get_setting("fling_intensity", PRESETS[0]["fling_intensity"]), PRESETS[0]["fling_intensity"]),
            "spring_speed": self._clean_number_str(self.get_setting("spring_speed", PRESETS[0]["spring_speed"]), PRESETS[0]["spring_speed"]),
            "spring_bounce": self._clean_number_str(self.get_setting("spring_bounce", PRESETS[0]["spring_bounce"]), PRESETS[0]["spring_bounce"]),
            "zoom_intensity": self._clean_number_str(self.get_setting("zoom_intensity", PRESETS[0]["zoom_intensity"]), PRESETS[0]["zoom_intensity"]),
            "stretch_intensity": self._clean_number_str(self.get_setting("stretch_intensity", PRESETS[0]["stretch_intensity"]), PRESETS[0]["stretch_intensity"]),
        }
        json_str = json.dumps(data, separators=(",", ":"))
        try:
            from android_utils import copy_to_clipboard
            copy_to_clipboard(json_str)
        except Exception:
            try:
                from org.telegram.messenger import AndroidUtilities
                AndroidUtilities.addToClipboard(json_str)
            except Exception:
                pass
        try:
            from ui.bulletin import BulletinHelper
            BulletinHelper.show_success(tr("Настройки скопированы в буфер", "Settings copied to clipboard"))
        except Exception:
            pass

    def _get_clipboard_text(self) -> str:
        try:
            from android.content import Context
            cm = ApplicationLoader.applicationContext.getSystemService(Context.CLIPBOARD_SERVICE)
            if cm and cm.hasPrimaryClip():
                clip = cm.getPrimaryClip()
                if clip and clip.getItemCount() > 0:
                    item = clip.getItemAt(0)
                    t = item.coerceToText(ApplicationLoader.applicationContext)
                    return str(t).strip() if t else ""
        except Exception:
            pass
        return ""

    def _validate_import_json(self, raw_str: str) -> Optional[dict]:
        if not raw_str or not isinstance(raw_str, str):
            return None
        raw_str = raw_str.strip()
        if not (raw_str.startswith("{") and raw_str.endswith("}")):
            return None
        try:
            parsed = json.loads(raw_str)
            if not isinstance(parsed, dict):
                return None
        except Exception:
            return None

        result = {}
        valid_keys = {"intensity", "fling_intensity", "spring_speed", "spring_bounce", "zoom_intensity", "stretch_intensity"}
        bool_keys = {"bounce_enabled", "zoom_enabled", "stretch_enabled"}

        found_any = False
        for k in valid_keys:
            if k in parsed:
                norm = self._normalize_number_str(parsed[k])
                if norm is None:
                    return None
                result[k] = norm
                found_any = True

        for k in bool_keys:
            if k in parsed:
                result[k] = bool(parsed[k])
                found_any = True

        return result if found_any else None

    def _on_import_click(self, view: Any = None):
        text = self._get_clipboard_text()
        if not text:
            try:
                from ui.bulletin import BulletinHelper
                BulletinHelper.show_error(tr("Буфер обмена пуст", "Clipboard is empty"))
            except Exception:
                pass
            return

        validated = self._validate_import_json(text)
        if validated is None:
            try:
                from ui.bulletin import BulletinHelper
                BulletinHelper.show_error(tr("Ошибка: неверный формат или отрицательные значения", "Error: invalid format or negative values"))
            except Exception:
                pass
            return

        self._show_import_dialog(view, validated)

    def _show_import_dialog(self, view: Any, data: dict):
        context = None
        if view:
            try:
                context = view.getContext()
            except Exception:
                pass
        if not context:
            try:
                from client_utils import get_last_fragment
                frag = get_last_fragment()
                if frag:
                    context = frag.getParentActivity()
            except Exception:
                pass
        if not context:
            context = ApplicationLoader.applicationContext

        title = tr("Импорт настроек", "Import settings")
        message = tr("Текущие настройки будут перезаписаны параметрами из буфера обмена. Продолжить?", "Your current settings will be overwritten with the values from the clipboard. Continue?")

        def on_confirm(dialog_or_builder):
            try:
                dialog_or_builder.dismiss()
            except Exception:
                pass
            scheduled = False
            try:
                from android_utils import run_on_ui_thread
                run_on_ui_thread(lambda: self._apply_imported_data(data), 100)
                scheduled = True
            except Exception:
                pass
            if not scheduled and view:
                try:
                    view.postDelayed(lambda: self._apply_imported_data(data), 100)
                    scheduled = True
                except Exception:
                    pass
            if not scheduled:
                self._apply_imported_data(data)

        try:
            from ui.alert import AlertDialogBuilder
            builder = AlertDialogBuilder(context)
            builder.set_title(title)
            builder.set_message(message)
            builder.set_positive_button(tr("Импортировать", "Import"), lambda b, w: on_confirm(b))
            builder.set_negative_button(tr("Отмена", "Cancel"), lambda b, w: b.dismiss())
            builder.show()
            return
        except Exception:
            pass

        try:
            from org.telegram.ui.ActionBar import AlertDialog
            builder = AlertDialog.Builder(context)
            builder.setTitle(title)
            builder.setMessage(message)
            builder.setPositiveButton(tr("Импортировать", "Import"), lambda d, w: on_confirm(d))
            builder.setNegativeButton(tr("Отмена", "Cancel"), lambda d, w: d.dismiss())
            builder.show()
        except Exception:
            self._apply_imported_data(data)

    def _apply_imported_data(self, data: dict):
        for k, v in data.items():
            if k in self._last_valid:
                self._last_valid[k] = str(v)

        matched = self._find_matching_preset_from_data(data)
        data["preset"] = matched

        try:
            self.import_settings(data, reload_settings=True)
        except Exception:
            for k, v in data.items():
                self.set_setting(k, v)

        try:
            self.set_setting("preset", -1)
            self.set_setting("preset", matched, reload_settings=True)
        except Exception:
            self.set_setting("preset", matched)

        self._sync_to_dex()
        try:
            from ui.bulletin import BulletinHelper
            BulletinHelper.show_success(tr("Настройки успешно импортированы", "Settings imported successfully"))
        except Exception:
            pass
