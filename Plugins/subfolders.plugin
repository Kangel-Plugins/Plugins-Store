class CounterTabWidthHook(MethodHook):

    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        plugin = self.plugin
        if plugin._unloaded or plugin._counter_width_busy or jint is None:
            return
        try:
            if not bool(param.args[0]):
                return
            tab = param.thisObject
            tv = get_private_field(tab, 'this$0')
            cap = plugin._counter_cap_for_tab(tv, int(tab.id))
            before = int(get_private_field(tab, 'counter'))
            if cap is not None and 0 <= cap < before:
                if not plugin._write_counter_int(tab, 'counter', cap):
                    return
                plugin._counter_width_busy = True
                try:
                    param.setResult(jint(int(tab.getWidth(False))))
                finally:
                    plugin._counter_width_busy = False
                plugin._schedule_counter_ui_sync(tv, int(tab.id), force=True)
        except Exception as e:
            pass

class TabSelectHook(MethodHook):

    def __init__(self, plugin, source_name):
        self.plugin = plugin
        self.source_name = source_name

    def after_hooked_method(self, param):
        if self.plugin._unloaded:
            return
        try:
            args = list(param.args) if param.args is not None else []
            try:
                self.plugin.last_tabs_view = param.thisObject
                self.plugin._ensure_counter_hook(param.thisObject)
            except Exception:
                pass
            if str(self.source_name).endswith('selectTabWithStableId'):
                return
            progress = self._extract_progress(args)
            try:
                self.plugin._last_tab_progress = (progress, time.time())
            except Exception:
                pass
            tab_index = self._resolve_index(param, self._extract_tab_index(args))
            if tab_index is None:
                return
            self.plugin.on_tab_selected(tab_index, self.source_name, progress)
        except Exception as e:
            pass

    def _resolve_index(self, param, tab_index):
        if tab_index is None:
            return None
        if not str(self.source_name).endswith('selectTabWithStableId'):
            return int(tab_index)
        position = None
        try:
            position = self.plugin._position_by_stable_id(param.thisObject, int(tab_index))
        except Exception as e:
            pass
        if position is None:
            return None
        try:
            tabs = get_private_field(param.thisObject, 'tabs')
            return int(tabs.get(int(position)).id)
        except Exception:
            return None

    def _extract_progress(self, args):
        for a in args:
            if isinstance(a, float):
                return float(a)
        for a in args:
            try:
                if hasattr(a, 'floatValue'):
                    return float(a.floatValue())
            except Exception:
                continue
        return None

    def _extract_tab_index(self, args):
        for a in args:
            if a is None:
                continue
            try:
                tid = getattr(a, 'id', None)
                if tid is not None and (not isinstance(a, (int, float, bool, str))):
                    return int(tid)
            except Exception:
                pass
        for a in args:
            if isinstance(a, int) and (not isinstance(a, bool)):
                return int(a)
            try:
                if hasattr(a, 'intValue'):
                    return int(a.intValue())
            except Exception:
                continue
        return None
_GATE_FORCE_OPEN = [False]
try:
    _TAB_GATE = jclass('java.util.concurrent.atomic.AtomicIntegerArray')(2)
    _TAB_GATE.set(0, -1)
except Exception:
    _TAB_GATE = None
TAB_GATE_CONDITION = 'object.get(1) != 0 || param.args[0] != object.get(0)'

def _tab_gate_decorator():
    if _TAB_GATE is None or HookFilter is None or hook_filters is None:
        return None
    try:
        return hook_filters(HookFilter.Condition(TAB_GATE_CONDITION, object=_TAB_GATE))
    except Exception:
        return None
_TAB_GATE_DECORATOR = _tab_gate_decorator()

def _gate_note_click(tab_index):
    if _TAB_GATE is None:
        return
    try:
        _TAB_GATE.set(0, int(tab_index))
    except Exception:
        pass

def _gate_open(ms=None):
    if _TAB_GATE is None:
        return
    try:
        _TAB_GATE.set(1, 1)
    except Exception:
        pass

def _gate_reset():
    if _TAB_GATE is None:
        return
    try:
        _TAB_GATE.set(0, -1)
        _TAB_GATE.set(1, 1 if _GATE_FORCE_OPEN[0] else 0)
    except Exception:
        pass

def _gate_set_enabled(enabled):
    _GATE_FORCE_OPEN[0] = not enabled
    if _TAB_GATE is None:
        return
    try:
        _TAB_GATE.set(1, 0 if enabled else 1)
    except Exception:
        pass

def _tree_sig(tree):
    if tree is None:
        return None
    try:
        top = []
        for name, _f in tree.top_level:
            kids = tree.children_of(name) or []
            top.append((name, tuple((c for c, _cf in kids))))
        orphans = tuple(sorted(((g, tuple((c for c, _cf in grp['children']))) for g, grp in tree.groups.items() if grp.get('parent') is None)))
        return (tuple(top), orphans)
    except Exception:
        return None

class TabSelectGatedHook(TabSelectHook):

    def after_hooked_method(self, param):
        TabSelectHook.after_hooked_method(self, param)
if _TAB_GATE_DECORATOR is not None:
    TabSelectGatedHook.after_hooked_method = _TAB_GATE_DECORATOR(TabSelectGatedHook.after_hooked_method)

class BackPressHook(MethodHook):

    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        if self.plugin._unloaded:
            return
        try:
            if self.plugin.expanded_group is None:
                return
            target = getattr(param, 'thisObject', None)
            if target is None:
                try:
                    target = param.getThisObject()
                except Exception:
                    target = None
            if not self.plugin._is_main_dialogs_screen(target):
                return
            try:
                param.setResult(False)
                self.plugin.collapse_and_go_home(target=target)
            except Exception:
                pass
        except Exception as e:
            pass

