    def __init__(self, plugin, source_name):
        self.plugin = plugin
        self.source_name = source_name

    def after_hooked_method(self, param):
        if self.plugin._unloaded:
            return
        try:
            if self.plugin.expanded_group is None:
                return
            self.plugin.schedule_expand_sync(self.source_name)
            self.plugin._request_counter_ui_recheck(self.plugin.last_tabs_view)
        except Exception as e:
            pass

def _describe_args(args):
    out = []
    for a in args:
        try:
            if a is None:
                out.append('None')
            elif isinstance(a, (int, float, bool, str)):
                out.append(repr(a))
            else:
                out.append(str(a.getClass().getSimpleName()))
        except Exception:
            out.append('?')
    return '[' + ', '.join(out) + ']'
FILTER_CREATE_CLASS = 'org.telegram.ui.FilterCreateActivity'
APPROVED_PRESENT_TTL = 3.0

def _set_java_field(obj, name, value):
    cls = obj.getClass()
    while cls is not None:
        try:
            fld = cls.getDeclaredField(name)
            fld.setAccessible(True)
            fld.set(obj, value)
            return True
        except Exception:
            cls = cls.getSuperclass()
    return False

def _identity(obj):
    try:
        from java.lang import System
        return int(System.identityHashCode(obj))
    except Exception:
        return id(obj)

class PresentFilterCreateHook(MethodHook):

    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        if self.plugin._unloaded:
            return
        try:
            args = param.args
            if args is None or len(args) == 0:
                return
            target = args[0]
            if target is None:
                return
            try:
                if str(target.getClass().getName()) != FILTER_CREATE_CLASS:
                    return
            except Exception:
                return
            if not self.plugin._should_offer_subfolder(target):
                return
            host = param.thisObject
            if host is None:
                return
            if not self.plugin._offer_create_choice(host, target):
                return
            param.setResult(True)
        except Exception as e:
            pass

