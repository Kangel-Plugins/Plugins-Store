class TabCounterHook(MethodHook):

    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        if self.plugin._unloaded:
            return
        try:
            native = int(param.getResult())
            if native <= 0:
                return
            tab_id = int(param.args[0])
            context = self.plugin._counter_context(param.thisObject, tab_id)
            if context is None:
                return
            mc, folder = context
            count, reason, evidence = self.plugin._explicit_unread_state(mc, folder)
            if count is not None and 0 <= count < native and (jint is not None):
                param.setResult(jint(count))
                panel = self.plugin._panel_from_counter_delegate(param.thisObject)
                if panel is not None:
                    self.plugin._schedule_counter_ui_sync(panel, tab_id)
        except Exception as e:
            pass

