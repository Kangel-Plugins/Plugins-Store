	def register_hooks(A):register_action_bar(A);register_star_rating(A);register_media_layout(A);register_settings_menu(A);register_gift_button(A);register_gift_cards(A);register_greeting_button(A);register_profile_appearance(A);register_profile_actions(A);register_premium_emoji(A);register_premium_badge(A);register_star_reaction(A);register_hide_emoji_search(A);register_hide_premium_features(A);register_hide_ai_features(A);register_hide_articles(A);register_hide_todo(A);register_hide_communities(A);register_hide_group_stickers(A);register_hide_wallet(A);register_settings_header(A)
	def on_plugin_unload(A):
		global _ACTIVE_LITEGRAM_INSTANCE;log_info(_B5,'LiteGram plugin unloaded')
		try:dex_bridge.unload()
		except Exception:pass
		if _ACTIVE_LITEGRAM_INSTANCE is A:_ACTIVE_LITEGRAM_INSTANCE=_A
	@classmethod
	def get_instance(A):
		B='Error while getting LiteGramPlugin Instance!'
		if A._instance is _A:BulletinHelper.show_error(B);raise RuntimeError(B)
		return A._instance


