SAVE_KEY = "ws_save"
ValueCallbackCls = find_class("android.webkit.ValueCallback")

GAME_HTML = r"""<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover"/>
<title></title>
<style>
:root{
  --bg0:#0e1626; --panel:#1c1830; --panel2:#262040;
  --line:rgba(255,255,255,.10); --ink:#e9ecf4; --dim:#9aa3b8;
  --gold:#d8b23f; --accent:#8f7fd0; --soft:#7fb4d8;
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent;}
html,body{margin:0;height:100%;overflow:hidden;background:var(--bg0);color:var(--ink);
  font-family:-apple-system,Roboto,"Segoe UI",sans-serif;user-select:none;-webkit-user-select:none;touch-action:manipulation;}
#cv{position:fixed;inset:0;width:100%;height:100%;display:block;}
#hud{position:fixed;top:calc(8px + env(safe-area-inset-top,0px));left:10px;right:10px;display:flex;align-items:center;gap:7px;z-index:6;}
.hbtn{width:40px;height:40px;flex:0 0 auto;border:none;border-radius:12px;background:rgba(28,24,48,.88);
  border:1px solid var(--line);color:var(--ink);display:flex;align-items:center;justify-content:center;
  box-shadow:0 2px 8px rgba(0,0,0,.3);transition:transform .08s,opacity .15s;}
.hbtn:active{transform:scale(.9);}
.hbtn:disabled{opacity:.35;}
.hbtn svg{width:20px;height:20px;}
.hbtn.gold{color:var(--gold);}
#coins{margin-left:auto;display:flex;align-items:center;gap:6px;height:40px;padding:0 14px;border-radius:20px;
  background:rgba(28,24,48,.88);border:1px solid var(--line);font-weight:700;font-size:14px;color:var(--gold);}
#coins svg{width:16px;height:16px;}
#lvl{position:fixed;top:calc(56px + env(safe-area-inset-top,0px));left:0;right:0;text-align:center;z-index:5;
  font-size:14px;font-weight:700;letter-spacing:.6px;color:var(--dim);}
#lvl b{color:var(--ink);}
#moves{position:fixed;top:calc(76px + env(safe-area-inset-top,0px));left:0;right:0;text-align:center;z-index:5;font-size:11.5px;color:var(--dim);}
#cat{position:fixed;top:calc(50px + env(safe-area-inset-top,0px));right:14px;z-index:5;width:48px;height:42px;
  pointer-events:none;transform-origin:50% 100%;}
#cat canvas{width:48px;height:42px;image-rendering:pixelated;display:block;}
#banner{position:fixed;left:50%;bottom:calc(46px + env(safe-area-inset-bottom,0px));transform:translateX(-50%);
  z-index:6;background:rgba(28,24,48,.94);border:1px solid var(--line);border-radius:14px;padding:9px 16px;
  font-size:12.5px;color:var(--dim);max-width:86vw;text-align:center;opacity:0;transition:opacity .3s;pointer-events:none;}
#banner.show{opacity:1;}
.ov{position:fixed;inset:0;z-index:20;display:none;align-items:center;justify-content:center;background:rgba(6,8,16,.72);}
.ov.show{display:flex;}
.card{width:min(92vw,360px);max-height:82vh;overflow-y:auto;background:linear-gradient(180deg,var(--panel2),var(--panel));
  border:1px solid var(--line);border-radius:20px;padding:22px 20px;text-align:center;box-shadow:0 18px 60px rgba(0,0,0,.6);
  animation:pop .25s cubic-bezier(.2,.9,.3,1.2);}
@keyframes pop{from{transform:scale(.85);opacity:0}to{transform:scale(1);opacity:1}}
.card::-webkit-scrollbar{width:6px;}
.card::-webkit-scrollbar-track{background:transparent;}
.card::-webkit-scrollbar-thumb{background:var(--accent);border-radius:3px;}
.card h2{margin:0 0 6px;font-size:22px;}
.card p{margin:6px 0;font-size:13.5px;color:var(--dim);line-height:1.5;}
.stars{display:flex;justify-content:center;gap:8px;margin:10px 0;}
.stars svg{width:34px;height:34px;}
.stars .off{opacity:.25;}
.reward{display:inline-flex;align-items:center;gap:7px;margin:6px 0 12px;padding:7px 16px;border-radius:16px;
  background:rgba(216,178,63,.12);border:1px solid rgba(216,178,63,.35);color:var(--gold);font-weight:700;font-size:14px;}
.reward svg{width:16px;height:16px;}
.btn{display:flex;align-items:center;justify-content:center;gap:8px;width:100%;margin:8px 0 0;padding:13px;border:none;border-radius:14px;
  font-size:15px;font-weight:700;background:linear-gradient(90deg,#7f6fd0,#5b8fd8);color:#fff;
  box-shadow:0 6px 18px rgba(90,110,200,.25);transition:transform .08s;}
.btn:active{transform:scale(.97);}
.btn svg{width:18px;height:18px;}
.btn.ghost{background:rgba(255,255,255,.06);border:1px solid var(--line);color:var(--ink);box-shadow:none;}
.rules{text-align:left;font-size:13px;color:var(--dim);line-height:1.6;margin:10px 0;}
.rules b{color:var(--ink);}
.sw{display:flex;align-items:center;justify-content:space-between;padding:11px 4px;border-bottom:1px solid var(--line);font-size:14px;}
.sw:last-of-type{border-bottom:none;}
.tgl{width:44px;height:24px;border-radius:12px;background:#3a3550;position:relative;border:none;transition:background .2s;}
.tgl::after{content:"";position:absolute;top:3px;left:3px;width:18px;height:18px;border-radius:50%;background:#b9b3cc;transition:left .2s,background .2s;}
.tgl.on{background:var(--accent);}
.tgl.on::after{left:23px;background:#fff;}
</style>
</head>
<body>
<canvas id="cv"></canvas>
<div id="hud">
  <button class="hbtn" id="bMenu"></button>
  <button class="hbtn" id="bRestart"></button>
  <button class="hbtn gold" id="bHint"></button>
  <button class="hbtn" id="bUndo"></button>
  <button class="hbtn gold" id="bPlus"></button>
  <div id="coins"><span id="coinIco"></span><span id="coinN">0</span></div>
  <button class="hbtn" id="bSnd"></button>
</div>
<div id="lvl">Level <b id="lvlN">1</b></div>
<div id="moves">Ходы: <span id="movN">0</span></div>
<div id="cat"><canvas id="catCv" width="48" height="42"></canvas></div>
<div id="banner"></div>

<div class="ov" id="win"><div class="card">
  <h2>Уровень пройден!</h2>
  <div class="stars" id="wStars"></div>
  <p id="wInfo"></p>
  <div class="reward"><span id="wCoinIco"></span><span id="wCoins">+0</span></div>
  <button class="btn" id="bNext"></button>
  <button class="btn ghost" id="bReplay">Переиграть</button>
</div></div>

<div class="ov" id="pause"><div class="card">
  <h2>Пауза</h2>
  <div class="sw"><span>Звук</span><button class="tgl" id="tSnd"></button></div>
  <div class="sw"><span>Подсказки при старте</span><button class="tgl" id="tTips"></button></div>
  <button class="btn ghost" id="bHelp">Как играть</button>
  <button class="btn ghost" id="bResetLvl">Начать уровень заново</button>
  <button class="btn ghost" id="bBack">Продолжить</button>
  <button class="btn" id="bExit">Выйти из игры</button>
</div></div>

<div class="ov" id="help"><div class="card">
  <h2>Как играть</h2>
  <div class="rules">
    <b>1.</b> Нажми на пробирку — она приподнимется.<br>
    <b>2.</b> Нажми на другую: верхний цвет перельётся, если там пусто или сверху тот же цвет и есть место.<br>
    <b>3.</b> Цель — собрать каждую пробирку из <b>одного цвета</b> (4 деления).<br>
    <b>4.</b> Кнопки сверху: отмена хода, заново, <b>лампочка — игра сама делает лучший ход</b> (10 монет), плюс — пустая пробирка (50 монет).<br>
    <b>5.</b> Меньше ходов — больше звёзд и монет.
  </div>
  <button class="btn" id="bGot">Понятно, играем!</button>
</div></div>

<script>
window.onerror=function(m,s,l){document.body.innerHTML='<pre style="color:#f88;padding:14px;font:12px monospace;white-space:pre-wrap">JS ERROR: '+m+' (line '+l+')</pre>';};
window.__ev=[];
(function(){
"use strict";
var SAVE; try{ SAVE=__SAVE__; }catch(e){ SAVE=null; }

var CAP=4;
var COLORS=['#e9c33f','#e0567f','#3fb9d8','#5cbf60','#e08a3c','#8f6fd0','#d95f5f','#5b8fd8','#3fbfa8','#d87fb8','#a8c24a','#d89a70'];
var LS='watersort_save_v1';
var save={level:1,coins:60,sound:true,tips:true,seen:false};
try{ var raw=localStorage.getItem(LS); if(raw) save=Object.assign(save,JSON.parse(raw)); }catch(e){}
if(SAVE && typeof SAVE==='object') save=Object.assign(save,SAVE);
function persist(){ try{localStorage.setItem(LS,JSON.stringify(save));}catch(e){} window.__ev.push({t:'save',s:JSON.stringify(save)}); }

/* ---------- SVG icons ---------- */
function svg(inner,fill){return '<svg viewBox="0 0 24 24" fill="'+(fill||'none')+'" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">'+inner+'</svg>';}
var IC={
  menu:svg('<path d="M4 6h16M4 12h16M4 18h16"/>'),
  restart:svg('<path d="M3 12a9 9 0 1 0 3-6.7"/><path d="M3 4v5h5"/>'),
  hint:svg('<path d="M9 18h6M10 21h4"/><path d="M12 3a6 6 0 0 0-4 10.5c.8.7 1 1.5 1 2.5h6c0-1 .2-1.8 1-2.5A6 6 0 0 0 12 3z"/>'),
  undo:svg('<path d="M9 14 4 9l5-5"/><path d="M4 9h10a6 6 0 0 1 0 12h-3"/>'),
  plus:svg('<path d="M12 5v14M5 12h14"/>'),
  sndOn:svg('<path d="M11 5 6 9H3v6h3l5 4z" fill="currentColor" stroke="none"/><path d="M15.5 8.5a5 5 0 0 1 0 7M18.5 6a8.5 8.5 0 0 1 0 12"/>'),
  sndOff:svg('<path d="M11 5 6 9H3v6h3l5 4z" fill="currentColor" stroke="none"/><path d="M16 9l5 6M21 9l-5 6"/>'),
  coin:'<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" fill="#d8b23f"/><circle cx="12" cy="12" r="6" fill="none" stroke="#a8842a" stroke-width="1.5"/><path d="M9 9c1-1.5 4-1.5 5 0" stroke="#f4e3a1" stroke-width="1.5" fill="none" stroke-linecap="round"/></svg>',
  star:function(on){return '<svg viewBox="0 0 24 24" class="'+(on?'':'off')+'"><path d="M12 2.5l2.9 6 6.6.9-4.8 4.6 1.2 6.5-5.9-3.2-5.9 3.2 1.2-6.5L2.5 9.4l6.6-.9z" fill="'+(on?'#d8b23f':'#5a5470')+'"/></svg>';},
  play:svg('<path d="M7 4l13 8-13 8z" fill="currentColor" stroke="none"/>')
};
function setIco(id,html){document.getElementById(id).innerHTML=html;}
setIco('bMenu',IC.menu); setIco('bRestart',IC.restart); setIco('bHint',IC.hint);
setIco('bUndo',IC.undo); setIco('bPlus',IC.plus); setIco('coinIco',IC.coin);
setIco('wCoinIco',IC.coin); setIco('bNext',IC.play+'<span>Следующий уровень</span>');

/* ---------- canvas / state ---------- */
var cv=document.getElementById('cv'),ctx=cv.getContext('2d');
var W=0,H=0,DPR=1,slots=[];
var tubes=[],initial=[],level=save.level|0,coins=save.coins|0,moves=0,undoStack=[],selected=-1,anim=null,extra=0;
var completed={},settle={},particles=[],stars=[],won=false,shake=0;
var AC=null,master=null;
var flies=[]; for(var f=0;f<9;f++)flies.push({x:Math.random(),y:0.3+Math.random()*0.5,p:Math.random()*6.28,s:0.3+Math.random()*0.5});

function fit(){
  DPR=Math.min(2.5,window.devicePixelRatio||1);
  W=window.innerWidth;H=window.innerHeight;
  cv.width=Math.round(W*DPR);cv.height=Math.round(H*DPR);
  layout();
}
function layout(){
  var n=tubes.length||1;
  var rows=n<=5?1:2, cols=Math.ceil(n/rows);
  var top=104, bottom=H-52, aw=W-20, ah=bottom-top;
  var cw=aw/cols, ch=ah/rows;
  var tw=Math.min(cw*0.6,58), th=Math.min(ch*0.84,tw*4.4);
  slots=[];
  for(var i=0;i<n;i++){
    var r=Math.floor(i/cols), c=i%cols;
    var inRow=Math.min(cols,n-r*cols);
    slots.push({x:W/2+(c-(inRow-1)/2)*cw, y:top+r*ch+ch/2, w:tw, h:th});
  }
}
window.addEventListener('resize',fit);
window.addEventListener('orientationchange',fit);
if(window.visualViewport)window.visualViewport.addEventListener('resize',fit);
setTimeout(fit,60);setTimeout(fit,300);
for(var i=0;i<44;i++)stars.push({x:Math.random(),y:Math.random()*0.6,r:Math.random()*1.1+0.3,p:Math.random()*6.28});

/* ---------- pixel cat ---------- */
var CAT_MAP=[
"..o..........o..",
".obo........obo.",
".obbo......obbo.",
".obbbboooobbbbo.",
".obbbbbbbbbbbbo.",
"obbbbbbbbbbbbbbo",
"obbeebbbbbbeebbo",
"obbeebbbbbbeebbo",
"obbbbbboobbbbbbo",
"obpbbbbbbbbbbpbo",
"obbbbccccccbbbbo",
".obbbccccccbbbo.",
".obbbbbbbbbbbbo.",
"..oooooooooooo.."];
var CAT_COL={o:'#2a2138',b:'#e8a04c',c:'#f6d9a8',p:'#e88ba0',e:'#201a2e'};
var catCv=document.getElementById('catCv'),catCtx=catCv.getContext('2d');
var catBlink=false,catEl=document.getElementById('cat');
function drawCat(blink){
  catCtx.clearRect(0,0,48,42);
  for(var y=0;y<CAT_MAP.length;y++)for(var x=0;x<CAT_MAP[y].length;x++){
    var ch=CAT_MAP[y][x]; if(ch==='.')continue;
    if(blink&&ch==='e')ch=(y===6)?'o':'b';
    catCtx.fillStyle=CAT_COL[ch]||'#000'; catCtx.fillRect(x*3,y*3,3,3);
  }
}
drawCat(false);

/* ---------- audio ---------- */
function ac(){ if(!AC){var C=window.AudioContext||window.webkitAudioContext;if(!C)return null;AC=new C();master=AC.createGain();master.gain.value=save.sound?0.8:0;master.connect(AC.destination);} if(AC.state==='suspended')AC.resume(); return AC; }
function setSnd(on){ save.sound=on; if(master)master.gain.value=on?0.8:0; setIco('bSnd',on?IC.sndOn:IC.sndOff); document.getElementById('tSnd').classList.toggle('on',on); persist(); }
function tone(fq,d,type,v,slide){ if(!save.sound)return; var a=ac(); if(!a)return; var t=a.currentTime,o=a.createOscillator(),g=a.createGain();
  o.type=type||'sine'; o.frequency.setValueAtTime(fq,t); if(slide)o.frequency.exponentialRampToValueAtTime(slide,t+d);
  g.gain.setValueAtTime(0.0001,t); g.gain.exponentialRampToValueAtTime(v||0.15,t+0.012); g.gain.exponentialRampToValueAtTime(0.0001,t+d);
  o.connect(g);g.connect(master);o.start(t);o.stop(t+d+0.02); }
function noise(d,v,fq){ if(!save.sound)return; var a=ac(); if(!a)return; var n=a.sampleRate*d|0,buf=a.createBuffer(1,n,a.sampleRate),ch=buf.getChannelData(0);
  for(var i=0;i<n;i++)ch[i]=(Math.random()*2-1)*(1-i/n);
  var s=a.createBufferSource(),g=a.createGain(),fl=a.createBiquadFilter(); fl.type='bandpass'; fl.frequency.value=fq||900; fl.Q.value=1.2;
  s.buffer=buf; g.gain.value=v||0.2; s.connect(fl);fl.connect(g);g.connect(master);s.start(); }
var sSelect=function(){tone(620,0.07,'triangle',0.12,880);};
var sPour=function(){noise(0.28,0.22,700);tone(300,0.25,'sine',0.1,180);};
var sBad=function(){tone(160,0.16,'sawtooth',0.12,110);};
var sDone=function(){tone(880,0.12,'triangle',0.14);setTimeout(function(){tone(1320,0.16,'triangle',0.12);},90);};
var sCoin=function(){tone(1500,0.06,'square',0.08,2000);};
var sWin=function(){[523,659,784,1046,1318].forEach(function(fq,i){setTimeout(function(){tone(fq,0.3,'triangle',0.16);},i*110);});};
var sClick=function(){tone(440,0.05,'square',0.06);};

/* ---------- model ---------- */
function topRun(t){ if(!t.length)return 0; var c=t[t.length-1],n=0; for(var i=t.length-1;i>=0&&t[i]===c;i--)n++; return n; }
function isFullSingle(t){ return t.length===CAP&&topRun(t)===CAP; }
function isSolved(list){ return list.every(function(t){return t.length===0||isFullSingle(t);}); }
function clone(l){ return l.map(function(t){return t.slice();}); }
function canPour(s,d){ if(s===d)return 0; var S=tubes[s],D=tubes[d]; if(!S.length||D.length>=CAP)return 0;
  var c=S[S.length-1]; if(D.length&&D[D.length-1]!==c)return 0; return Math.min(topRun(S),CAP-D.length); }
function frag(l){ var fq=0; l.forEach(function(t){for(var i=1;i<t.length;i++)if(t[i]!==t[i-1])fq++;}); return fq; }
function gen(lv){
  var c=Math.min(3+Math.floor((lv-1)/2),10);
  for(var attempt=0;attempt<40;attempt++){
    var base=[]; for(var i=0;i<c;i++)base.push([i,i,i,i]); base.push([],[]);
    var w=clone(base), M=c*12+Math.min(lv,40);
    for(var m=0;m<M;m++){
      var opts=[];
      for(var s=0;s<w.length;s++){ var S=w[s]; if(!S.length)continue; var run=topRun(S);
        for(var d=0;d<w.length;d++){ if(d===s)continue; var space=CAP-w[d].length; if(space<=0)continue;
          for(var k=1;k<=Math.min(run,space);k++){ if(k===run&&run!==S.length)continue; opts.push([s,d,k]); } } }
      if(!opts.length)break;
      var pick=opts[Math.random()*opts.length|0];
      for(var q=0;q<pick[2];q++)w[pick[1]].push(w[pick[0]].pop());
    }
    var empt=w.filter(function(t){return !t.length;}).length;
    if(!isSolved(w)&&empt>=1&&frag(w)>=c) return w;
  }
  var fb=[]; for(var j=0;j<c;j++)fb.push([j,j,j,j]); fb.push([],[]);
  fb[0].pop(); fb[c].push(fb[1].pop()); fb[1].push(fb[0].pop());
  return fb;
}
function startLevel(lv){
  level=lv; tubes=gen(lv); initial=clone(tubes); moves=0; undoStack=[]; selected=-1; anim=null; extra=0; completed={}; settle={}; won=false;
  document.getElementById('lvlN').textContent=lv;
  document.getElementById('movN').textContent=0;
  layout(); syncHud();
  if(save.tips&&!save.seen){ show('help'); } else banner('Собери каждый цвет в свою пробирку');
}
function syncHud(){
  document.getElementById('coinN').textContent=coins;
  document.getElementById('bUndo').disabled=!undoStack.length||!!anim||won;
  document.getElementById('bHint').disabled=!!anim||won;
  document.getElementById('bPlus').disabled=!!anim||won||extra>=2||coins<50;
  document.getElementById('bRestart').disabled=!!anim;
}
function banner(t){ var b=document.getElementById('banner'); b.textContent=t; b.classList.add('show'); clearTimeout(b._t); b._t=setTimeout(function(){b.classList.remove('show');},2600); }
function show(id){ document.getElementById(id).classList.add('show'); }
function hide(id){ document.getElementById(id).classList.remove('show'); }

/* ---------- particles ---------- */
function spark(x,y,col,n,spd){ for(var i=0;i<(n||14);i++){ var a=Math.random()*6.28,s=(spd||120)*(0.4+Math.random());
  particles.push({x:x,y:y,vx:Math.cos(a)*s,vy:Math.sin(a)*s-60,g:260,life:0.7+Math.random()*0.5,max:1,col:col,sz:2+Math.random()*3,shape:0}); } }
function confetti(){ for(var i=0;i<120;i++){ var a=Math.random()*6.28,s=180+Math.random()*400;
  particles.push({x:W/2,y:H*0.4,vx:Math.cos(a)*s,vy:Math.sin(a)*s-260,g:620,life:1.4+Math.random(),max:2,col:COLORS[i%COLORS.length],sz:4+Math.random()*5,shape:1,rot:Math.random()*6.28,vr:(Math.random()-0.5)*10}); } }

/* ---------- liquid column (continuous) ---------- */
function runsOf(units){
  var runs=[];
  for(var i=0;i<units.length;i++){
    var c=units[i];
    if(runs.length&&runs[runs.length-1].c===c)runs[runs.length-1].a++;
    else runs.push({c:c,a:1});
  }
  return runs;
}
function transfer(){ if(!anim)return 0; var p=anim.t/anim.dur; return anim.k*Math.max(0,Math.min(1,(p-0.22)/0.56)); }
function columnFor(i){
  var runs=runsOf(tubes[i]);
  if(anim&&anim.s===i){
    var t=transfer(), top=runs[runs.length-1];
    if(top){ top.a-=t; if(top.a<=0.0001)runs.pop(); }
  }else if(anim&&anim.d===i){
    var t2=transfer();
    if(t2>0){ var top2=runs[runs.length-1];
      if(top2&&top2.c===anim.col)top2.a+=t2; else runs.push({c:anim.col,a:t2}); }
  }
  return runs;
}
function shade(hex,amt){
  var r=parseInt(hex.substr(1,2),16),g=parseInt(hex.substr(3,2),16),b=parseInt(hex.substr(5,2),16);
  if(amt>=0){r+=(255-r)*amt;g+=(255-g)*amt;b+=(255-b)*amt;}
  else{r*=(1+amt);g*=(1+amt);b*=(1+amt);}
  return 'rgb('+(r|0)+','+(g|0)+','+(b|0)+')';
}
function drawLiquid(runs,w,h,i,now){
  if(!runs.length)return;
  var innerW=w-8,innerH=h-10,unit=innerH/CAP,yBot=innerH/2;
  var total=0; runs.forEach(function(r){total+=r.a;});
  var totalH=total*unit, topY=yBot-totalH;
  ctx.save();
  tubePath(0,0,w-4,h-4,(w-4)*0.3); ctx.clip();
  var yy=yBot;
  for(var ri=0;ri<runs.length;ri++){
    var run=runs[ri], hh=run.a*unit;
    var g=ctx.createLinearGradient(0,yy-hh,0,yy);
    g.addColorStop(0,shade(COLORS[run.c],0.16));
    g.addColorStop(0.45,COLORS[run.c]);
    g.addColorStop(1,shade(COLORS[run.c],-0.20));
    ctx.fillStyle=g;
    ctx.fillRect(-innerW/2,yy-hh,innerW,hh+0.6);
    if(ri<runs.length-1){
      ctx.fillStyle='rgba(0,0,0,.14)';
      ctx.fillRect(-innerW/2,yy-hh-0.7,innerW,1.4);
      ctx.fillStyle='rgba(255,255,255,.10)';
      ctx.fillRect(-innerW/2,yy-hh+0.7,innerW,1);
    }
    yy-=hh;
  }
  // bubbles rising inside the fluid
  for(var b=0;b<3;b++){
    var seed=i*7+b*13;
    var speed=0.05+(seed%5)*0.012;
    var prog=((now/1000*speed)+(seed%10)/10)%1;
    var by=yBot-3-prog*(totalH-6);
    if(by<topY+3)continue;
    var bx=(((seed*37)%100)/100-0.5)*innerW*0.62;
    ctx.fillStyle='rgba(255,255,255,'+(0.10+0.06*Math.sin(now/400+seed)).toFixed(2)+')';
    ctx.beginPath();ctx.arc(bx,by,1+(seed%3)*0.5,0,6.283);ctx.fill();
  }
  // single continuous surface meniscus
  var amp=0.7;
  if(settle[i]&&now-settle[i]<650)amp+=(1-(now-settle[i])/650)*2.4;
  if(anim&&anim.d===i)amp+=1.2;
  var wob=Math.sin(now/240+i*1.7)*amp;
  ctx.fillStyle='rgba(255,255,255,.26)';
  ctx.beginPath();ctx.ellipse(0,topY+wob,innerW/2,2.3,0,0,6.283);ctx.fill();
  ctx.fillStyle='rgba(255,255,255,.45)';
  ctx.beginPath();ctx.ellipse(-innerW*0.18,topY+wob-0.6,innerW*0.15,1.1,0,0,6.283);ctx.fill();
  // inner glass refraction stripes over fluid
  ctx.fillStyle='rgba(255,255,255,.10)';
  ctx.fillRect(-innerW/2+2,topY,2.4,totalH);
  ctx.fillStyle='rgba(0,0,0,.10)';
  ctx.fillRect(innerW/2-3,topY,2.4,totalH);
  ctx.restore();
}

/* ---------- pour ---------- */
function beginPour(s,d,k){
  undoStack.push({t:clone(tubes),m:moves});
  anim={s:s,d:d,k:k,col:tubes[s][tubes[s].length-1],t:0,dur:0.85};
  selected=-1; sPour(); syncHud();
}
function commitPour(){
  var a=anim; for(var i=0;i<a.k;i++)tubes[a.d].push(tubes[a.s].pop());
  moves++; document.getElementById('movN').textContent=moves; anim=null;
  var now=performance.now(); settle[a.d]=now; settle[a.s]=now;
  if(isFullSingle(tubes[a.d])&&!completed[a.d]){ completed[a.d]=true; var sl=slots[a.d]; spark(sl.x,sl.y-sl.h/2,COLORS[a.col],18,140); sDone(); }
  if(isSolved(tubes)) winLevel();
  syncHud();
}
function winLevel(){
  won=true;
  var c=tubes.filter(function(t){return t.length;}).length;
  var par=c*3, st=moves<=par?3:(moves<=par*1.6?2:1);
  var gain=20+st*10; coins+=gain; save.coins=coins; save.level=level+1; persist();
  confetti(); sWin();
  setTimeout(function(){
    var el=document.getElementById('wStars'); el.innerHTML='';
    for(var i=0;i<3;i++)el.innerHTML+=IC.star(i<st);
    document.getElementById('wInfo').textContent='Ходов: '+moves+' (цель '+par+')';
    document.getElementById('wCoins').textContent='+'+gain;
    document.getElementById('coinN').textContent=coins;
    show('win'); syncHud();
  },900);
}
function bestMove(){
  var best=null,bs=-1e9;
  for(var s=0;s<tubes.length;s++)for(var d=0;d<tubes.length;d++){
    var k=canPour(s,d); if(!k)continue;
    var S=tubes[s],D=tubes[d],sc=k*2;
    if(D.length+k===CAP&&D.length&&D[D.length-1]===S[S.length-1])sc+=100;
    if(D.length===0&&isFullSingle(S))sc-=200;
    if(k===S.length)sc+=40;
    if(D.length&&D[D.length-1]===S[S.length-1])sc+=20;
    if(sc>bs){bs=sc;best=[s,d];}
  }
  return best;
}

/* ---------- background ---------- */
function hill(yBase,amp,col,phase){
  ctx.fillStyle=col; ctx.beginPath(); ctx.moveTo(0,H); ctx.lineTo(0,yBase);
  for(var x=0;x<=W;x+=8)ctx.lineTo(x,yBase+Math.sin(x*0.01+phase)*amp);
  ctx.lineTo(W,H); ctx.closePath(); ctx.fill();
}
function drawBackground(now){
  var g=ctx.createLinearGradient(0,0,0,H);
  g.addColorStop(0,'#0e1626');g.addColorStop(0.55,'#1a2440');g.addColorStop(1,'#233052');
  ctx.fillStyle=g;ctx.fillRect(0,0,W,H);
  var mx=W*0.16,my=H*0.13;
  var mg=ctx.createRadialGradient(mx,my,4,mx,my,90);
  mg.addColorStop(0,'rgba(232,236,244,.10)');mg.addColorStop(1,'rgba(0,0,0,0)');
  ctx.fillStyle=mg;ctx.fillRect(mx-90,my-90,180,180);
  ctx.fillStyle='#e8ecf4';ctx.beginPath();ctx.arc(mx,my,22,0,6.283);ctx.fill();
  ctx.fillStyle='rgba(0,0,0,.08)';
  ctx.beginPath();ctx.arc(mx-7,my-4,4,0,6.283);ctx.fill();
  ctx.beginPath();ctx.arc(mx+6,my+7,3,0,6.283);ctx.fill();
  for(var i=0;i<stars.length;i++){var st=stars[i];var a=0.18+0.3*Math.abs(Math.sin(now/1100+st.p));
    ctx.fillStyle='rgba(255,255,255,'+a.toFixed(2)+')';ctx.beginPath();ctx.arc(st.x*W,st.y*H,st.r,0,6.283);ctx.fill();}
  ctx.fillStyle='rgba(255,255,255,.04)';
  for(var c2=0;c2<3;c2++){
    var cx=((now*0.006+c2*300)%(W+240))-120, cy=H*(0.16+c2*0.09);
    ctx.beginPath();ctx.ellipse(cx,cy,70,16,0,0,6.283);ctx.ellipse(cx+40,cy+6,50,12,0,0,6.283);ctx.fill();
  }
  var lx=W*0.84;
  ctx.strokeStyle='rgba(255,255,255,.12)';ctx.lineWidth=1.5;
  ctx.beginPath();ctx.moveTo(lx,0);ctx.lineTo(lx,52);ctx.stroke();
  ctx.fillStyle='#2a2138';ctx.beginPath();ctx.moveTo(lx-16,66);ctx.lineTo(lx+16,66);ctx.lineTo(lx+7,52);ctx.lineTo(lx-7,52);ctx.closePath();ctx.fill();
  var lg=ctx.createRadialGradient(lx,80,6,lx,80,W*0.5);
  lg.addColorStop(0,'rgba(232,190,120,.07)');lg.addColorStop(1,'rgba(0,0,0,0)');
  ctx.fillStyle=lg;ctx.fillRect(0,0,W,H);
  hill(H*0.72,10,'#131c30',1.2);
  hill(H*0.80,8,'#0f1626',2.6);
  var sy=H-26;
  ctx.fillStyle='#241b33';ctx.fillRect(0,sy,W,6);
  ctx.fillStyle='rgba(255,255,255,.05)';ctx.fillRect(0,sy,W,1);
  for(var b=0;b<6;b++){
    var bx=W*(b+0.5)/6, bh=18+(b%3)*5;
    ctx.fillStyle='#1a2337';
    ctx.beginPath();
    ctx.moveTo(bx-3,sy-bh);ctx.lineTo(bx+3,sy-bh);ctx.lineTo(bx+3,sy-bh+6);
    ctx.quadraticCurveTo(bx+9,sy-bh+10,bx+9,sy-4);ctx.lineTo(bx-9,sy-4);
    ctx.quadraticCurveTo(bx-9,sy-bh+10,bx-3,sy-bh+6);ctx.closePath();ctx.fill();
    ctx.strokeStyle='rgba(255,255,255,.05)';ctx.lineWidth=1;ctx.stroke();
  }
  for(var f2=0;f2<flies.length;f2++){var fl=flies[f2];
    var fx=(fl.x+Math.sin(now/2400*fl.s+fl.p)*0.03)*W;
    var fy=(fl.y+Math.cos(now/3000*fl.s+fl.p)*0.02)*H;
    var fa=0.25+0.3*Math.abs(Math.sin(now/700+fl.p));
    ctx.fillStyle='rgba(232,190,120,'+fa.toFixed(2)+')';
    ctx.beginPath();ctx.arc(fx,fy,1.6,0,6.283);ctx.fill();}
}

/* ---------- tubes ---------- */
function tubePath(x,y,w,h,r){
  ctx.beginPath();
  ctx.moveTo(x-w/2,y-h/2);
  ctx.lineTo(x-w/2,y+h/2-r);
  ctx.quadraticCurveTo(x-w/2,y+h/2,x-w/2+r,y+h/2);
  ctx.lineTo(x+w/2-r,y+h/2);
  ctx.quadraticCurveTo(x+w/2,y+h/2,x+w/2,y+h/2-r);
  ctx.lineTo(x+w/2,y-h/2);
}
function drawTube(i,now){
  var sl=slots[i];
  var lift=(selected===i)?-14:0;
  var x=sl.x,y=sl.y+lift,w=sl.w,h=sl.h;
  var shakeX=(shake>0&&selected===i)?Math.sin(now/18)*4*shake:0;
  ctx.save(); ctx.translate(x+shakeX,y);
  var glow=completed[i]?'rgba(120,200,140,.35)':(selected===i?'rgba(127,180,216,.35)':null);
  ctx.shadowColor=glow||'rgba(0,0,0,.3)'; ctx.shadowBlur=glow?10:5;
  tubePath(0,0,w,h,w*0.32); ctx.fillStyle='rgba(255,255,255,.04)'; ctx.fill();
  ctx.shadowBlur=0;
  drawLiquid(columnFor(i),w,h,i,now);
  tubePath(0,0,w,h,w*0.32);
  ctx.strokeStyle=glow?'rgba(220,228,240,.75)':'rgba(205,215,232,.5)';
  ctx.lineWidth=2.2; ctx.stroke();
  ctx.strokeStyle='rgba(255,255,255,.2)'; ctx.lineWidth=1.2;
  ctx.beginPath();ctx.moveTo(-w/2+4,-h/2+6);ctx.lineTo(-w/2+4,h/2-w*0.34);ctx.stroke();
  ctx.strokeStyle='rgba(205,215,232,.7)'; ctx.lineWidth=2.6;
  ctx.beginPath();ctx.moveTo(-w/2-2,-h/2);ctx.lineTo(w/2+2,-h/2);ctx.stroke();
  if(completed[i]){
    ctx.strokeStyle='rgba(233,236,244,.85)';ctx.lineWidth=2.4;ctx.lineCap='round';
    ctx.beginPath();ctx.moveTo(-6,-h/2-12);ctx.lineTo(-1,-h/2-7);ctx.lineTo(7,-h/2-17);ctx.stroke();
  }
  ctx.restore();
}
function smooth(t){return t*t*(3-2*t);}
function drawAnim(now){
  if(!anim)return;
  var a=anim,p=a.t/a.dur,S=slots[a.s],D=slots[a.d];
  var lift=p<0.22?smooth(p/0.22):(p>0.8?1-smooth((p-0.8)/0.2):1);
  var dir=S.x<D.x?1:-1, ang=dir*1.85*lift;
  var mouthX=D.x,mouthY=D.y-D.h/2-14;
  var hx=Math.sin(ang)*S.h/2, hy=-Math.cos(ang)*S.h/2;
  var sx=S.x+(mouthX-hx-S.x)*lift, sy=S.y+(mouthY-hy-S.y)*lift;
  if(p>0.22&&p<0.8){
    var runsD=columnFor(a.d), tot=0; runsD.forEach(function(r){tot+=r.a;});
    var surfY=D.y+(D.h-10)/2-tot*(D.h-10)/CAP;
    ctx.strokeStyle=COLORS[a.col];ctx.lineWidth=Math.max(4,S.w*0.16);ctx.lineCap='round';
    ctx.beginPath();ctx.moveTo(mouthX,mouthY);
    ctx.quadraticCurveTo(mouthX+Math.sin(now/60)*2,(mouthY+surfY)/2,D.x,surfY);ctx.stroke();
    if(Math.random()<0.5)particles.push({x:D.x+(Math.random()-0.5)*8,y:surfY,vx:(Math.random()-0.5)*60,vy:-40-Math.random()*60,g:300,life:0.4,max:0.4,col:COLORS[a.col],sz:2,shape:0});
  }
  ctx.save();ctx.translate(sx,sy);ctx.rotate(ang);
  var w=S.w,h=S.h;
  tubePath(0,0,w,h,w*0.32);ctx.fillStyle='rgba(255,255,255,.04)';ctx.fill();
  drawLiquid(columnFor(a.s),w,h,a.s,now);
  tubePath(0,0,w,h,w*0.32);ctx.strokeStyle='rgba(205,215,232,.6)';ctx.lineWidth=2.2;ctx.stroke();
  ctx.strokeStyle='rgba(205,215,232,.7)';ctx.lineWidth=2.6;ctx.beginPath();ctx.moveTo(-w/2-2,-h/2);ctx.lineTo(w/2+2,-h/2);ctx.stroke();
  ctx.restore();
}
function draw(now){
  ctx.setTransform(DPR,0,0,DPR,0,0);
  drawBackground(now);
  for(var t2=0;t2<tubes.length;t2++){ if(anim&&anim.s===t2)continue; drawTube(t2,now); }
  drawAnim(now);
  for(var p2=particles.length-1;p2>=0;p2--){var pa=particles[p2];
    if(pa.life<=0){particles.splice(p2,1);continue;}
    ctx.save();ctx.globalAlpha=Math.max(0,Math.min(1,pa.life/pa.max));ctx.fillStyle=pa.col;
    if(pa.shape){ctx.translate(pa.x,pa.y);ctx.rotate(pa.rot);ctx.fillRect(-pa.sz/2,-pa.sz/2,pa.sz,pa.sz*0.6);}
    else{ctx.beginPath();ctx.arc(pa.x,pa.y,pa.sz,0,6.283);ctx.fill();}
    ctx.restore();}
}
var last=performance.now();
function loop(now){
  requestAnimationFrame(loop);
  var dt=Math.min(0.05,(now-last)/1000);last=now;
  if(anim){anim.t+=dt;if(anim.t>=anim.dur)commitPour();}
  if(shake>0)shake=Math.max(0,shake-dt*3);
  for(var i=0;i<particles.length;i++){var p=particles[i];p.life-=dt;p.vy+=p.g*dt;p.x+=p.vx*dt;p.y+=p.vy*dt;if(p.vr)p.rot+=p.vr*dt;}
  var ct=now/1000, sp=won?3.2:1.5, ph=Math.sin(ct*sp);
  var sway=ph*2.2, squat=Math.abs(ph)*(won?0.10:0.05), jump=won?-Math.abs(Math.sin(ct*3.2))*5:0;
  catEl.style.transform='translate('+sway.toFixed(1)+'px,'+(jump+squat*8).toFixed(1)+'px) scale('+(1+squat*0.6).toFixed(3)+','+(1-squat).toFixed(3)+')';
  var blink=(ct%3.6)>3.45; if(blink!==catBlink){catBlink=blink;drawCat(blink);}
  draw(now);
}
requestAnimationFrame(loop);

/* ---------- input ---------- */
cv.addEventListener('pointerdown',function(e){
  ac();
  if(anim||won)return;
  var x=e.clientX,y=e.clientY,hit=-1;
  for(var i=0;i<slots.length;i++){var s=slots[i];
    if(Math.abs(x-s.x)<s.w*0.75&&Math.abs(y-s.y)<s.h*0.62){hit=i;break;}}
  if(hit<0){selected=-1;return;}
  if(selected<0){ if(tubes[hit].length){selected=hit;sSelect();} else sBad(); return; }
  if(hit===selected){selected=-1;sClick();return;}
  var k=canPour(selected,hit);
  if(k>0)beginPour(selected,hit,k);
  else { sBad(); shake=1; selected=tubes[hit].length?hit:-1; }
});

/* ---------- buttons ---------- */
function bind(id,fn){document.getElementById(id).addEventListener('click',function(){ac();sClick();fn();});}
bind('bUndo',function(){ if(anim||won||!undoStack.length)return; var h=undoStack.pop(); tubes=h.t; moves=h.m;
  document.getElementById('movN').textContent=moves; completed={}; selected=-1; syncHud(); banner('Ход отменён'); });
bind('bRestart',function(){ if(anim)return; tubes=clone(initial); moves=0; undoStack=[]; selected=-1; completed={}; settle={}; extra=0; won=false;
  document.getElementById('movN').textContent=0; layout(); syncHud(); banner('Уровень заново'); });
bind('bHint',function(){
  if(anim||won)return;
  if(coins<10){banner('Нужно 10 монет');sBad();return;}
  var mv=bestMove();
  if(!mv){banner('Нет доступных ходов — отмени или заново');sBad();return;}
  var k=canPour(mv[0],mv[1]);
  coins-=10;save.coins=coins;persist();document.getElementById('coinN').textContent=coins;
  sCoin(); banner('Подсказка: игра делает ход за тебя');
  beginPour(mv[0],mv[1],k);
});
bind('bPlus',function(){ if(anim||won||extra>=2)return; if(coins<50){banner('Нужно 50 монет');sBad();return;}
  coins-=50;save.coins=coins;persist();document.getElementById('coinN').textContent=coins;
  tubes.push([]);extra++;layout();sCoin();syncHud();banner('Пустая пробирка добавлена'); });
bind('bSnd',function(){setSnd(!save.sound);});
bind('bMenu',function(){show('pause');});
bind('bBack',function(){hide('pause');});
bind('bExit',function(){persist();window.__ev.push('sort://close');});
bind('bHelp',function(){hide('pause');show('help');});
bind('bResetLvl',function(){hide('pause');tubes=clone(initial);moves=0;undoStack=[];selected=-1;completed={};settle={};extra=0;won=false;
  document.getElementById('movN').textContent=0;layout();syncHud();});
bind('bGot',function(){hide('help');save.seen=true;persist();banner('Нажми пробирку, затем другую');});
bind('bNext',function(){hide('win');startLevel(level+1);});
bind('bReplay',function(){hide('win');startLevel(level);});
document.getElementById('tSnd').addEventListener('click',function(){setSnd(!save.sound);});
document.getElementById('tTips').addEventListener('click',function(){save.tips=!save.tips;this.classList.toggle('on',save.tips);persist();});

/* ---------- init ---------- */
document.getElementById('tSnd').classList.toggle('on',save.sound);
document.getElementById('tTips').classList.toggle('on',save.tips);
setIco('bSnd',save.sound?IC.sndOn:IC.sndOff);
document.getElementById('coinN').textContent=coins;
fit();
startLevel(level);
})();
</script>
</body>
</html>"""


class EvCb(dynamic_proxy(ValueCallbackCls)):
    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin

    def onReceiveValue(self, value):
        try:
            raw = str(value)
            if not raw or raw in ("null", "[]"):
                return
            if raw.startswith('"'):
                raw = json.loads(raw)
            evs = json.loads(raw)
            if evs:
                self.plugin._handle(evs)
        except Exception:
            pass


class WaterSortPlugin(BasePlugin):

    def __init__(self):
        super().__init__()
        self._wv = None
        self._dlg = None
        self._poll = False

    def on_plugin_load(self):
        self.add_menu_item(MenuItemData(
            menu_type=MenuItemType.CHAT_ACTION_MENU,
            text="Get Color",
            icon="dialog_media_game_20",
            item_id="water_sort_open",
            on_click=lambda ctx: self._open(),
        ))
        self.add_on_send_message_hook()
        self.log("загружен")

    def on_plugin_unload(self):
        run_on_ui_thread(self._destroy)

    def log(self, m):
        try:
            log(f"WaterSort: {m}")
        except Exception:
            pass

    def on_send_message_hook(self, account, params):
        try:
            msg = getattr(params, "message", None)
            if isinstance(msg, str) and msg.strip().lower() in (".tubes", ".sort"):
                self._open()
                return HookResult(strategy=HookStrategy.CANCEL)
        except Exception:
            pass
        return HookResult()

    def _handle(self, evs):
        for ev in evs:
            try:
                if isinstance(ev, str) and ev.startswith("sort://close"):
                    run_on_ui_thread(self._destroy)
                elif isinstance(ev, dict) and ev.get("t") == "save":
                    self.set_setting(SAVE_KEY, ev.get("s") or "")
            except Exception as e:
                self.log(f"bridge: {e}")

    def _open(self):
        run_on_ui_thread(self._build)

    def _build(self):
        try:
            frag = get_last_fragment()
            act = frag.getParentActivity() if frag else None
            if act is None:
                return
            from android.app import Dialog
            from android.webkit import WebView
            from android.widget import FrameLayout
            from android.graphics import Color
            from android.graphics.drawable import ColorDrawable
            from android.view import Window, ViewGroup, WindowManager
            from android.content import DialogInterface

            if self._dlg is not None:
                try: self._dlg.dismiss()
                except Exception: pass
                self._dlg = None
            if self._wv is not None:
                try: self._wv.destroy()
                except Exception: pass
                self._wv = None

            stored = self.get_setting(SAVE_KEY, "") or ""
            try:
                json.loads(stored)
                sj = stored
            except Exception:
                sj = "null"
            html = GAME_HTML.replace("__SAVE__", sj)

            wv = WebView(act)
            st = wv.getSettings()
            st.setJavaScriptEnabled(True)
            st.setDomStorageEnabled(True)
            st.setUseWideViewPort(False)
            try: st.setMediaPlaybackRequiresUserGesture(False)
            except Exception: pass
            wv.setBackgroundColor(Color.parseColor("#FF0E1626"))
            wv.loadDataWithBaseURL("https://localhost/", html, "text/html", "utf-8", None)

            holder = FrameLayout(act)
            holder.setBackgroundColor(Color.parseColor("#FF0E1626"))
            wv.setLayoutParams(FrameLayout.LayoutParams(-1, -1))
            holder.addView(wv)

            dlg = Dialog(act)
            dlg.requestWindowFeature(Window.FEATURE_NO_TITLE)
            dlg.setContentView(holder, ViewGroup.LayoutParams(-1, -1))
            dlg.setCancelable(True)
            outer = self

            class _Dismiss(dynamic_proxy(DialogInterface.OnDismissListener)):
                def onDismiss(self, d):
                    outer._poll = False
                    outer._wv = None
                    outer._dlg = None

            dlg.setOnDismissListener(_Dismiss())
            win = dlg.getWindow()
            try:
                win.setLayout(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT)
                win.setBackgroundDrawable(ColorDrawable(Color.parseColor("#FF0E1626")))
                win.addFlags(WindowManager.LayoutParams.FLAG_FULLSCREEN | WindowManager.LayoutParams.FLAG_LAYOUT_NO_LIMITS)
                win.clearFlags(WindowManager.LayoutParams.FLAG_DIM_BEHIND)
                win.getDecorView().setSystemUiVisibility(0x1706)
            except Exception as e:
                self.log(f"fullscreen: {e}")

            self._wv = wv
            self._dlg = dlg
            dlg.show()
            self._poll = True

            def loop():
                while self._poll and self._wv is not None:
                    time.sleep(0.25)
                    w = self._wv
                    if w is None:
                        break
                    run_on_ui_thread(lambda: self._poll_once(w))
            threading.Thread(target=loop, daemon=True).start()
        except Exception as e:
            self.log(f"окно: {e}")

    def _poll_once(self, wv):
        try:
            wv.evaluateJavascript(
                "window.__ev && window.__ev.length ? JSON.stringify(window.__ev.splice(0)) : '[]'",
                EvCb(self))
        except Exception:
            pass

    def _destroy(self):
        self._poll = False
        try:
            if self._dlg is not None:
                self._dlg.dismiss()
        except Exception:
            pass
        try:
            if self._wv is not None:
                self._wv.destroy()
        except Exception:
            pass
        self._wv = None
        self._dlg = None

    def create_settings(self):
        from ui.settings import Header, Text, Divider
        rows = [Header(text="Пробирки: Get Color")]
        try:
            rows.append(Text(text="Играть", subtext="Открыть головоломку на весь экран",
                             icon="msg_reactions", on_click=lambda *a: self._open()))
        except Exception:
            pass
        rows.append(Text(text="Как играть", subtext="Переливай верхний цвет в пустую пробирку или на тот же цвет. "
                                                  "Собери каждую пробирку из одного цвета. Лампочка делает ход за тебя. "
                                                  "Монеты и уровень сохраняются.",
                         icon="msg_info"))
        rows.append(Divider(text="WaterSort v%s // %s" % (__version__, __author__)))
        return rows