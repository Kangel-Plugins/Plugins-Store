var KEYS = ["EMPTY","WALL","STONE","SAND","DIRT","GUNP","SNOW","SEED","ASH","WATER","OIL","ACID","ALK","MERC","LAVA","STEAM","SMOKE","GAS","WOOD","COAL","TNT","ICE","PLANT","FUNG","WIRE","BATT","LAMP","GLASS","SALT","FIRE","BOLT","SPARK"];
var W = __GW__;
var H = Math.round(__GW__ * 1.66);
var cv = document.getElementById('cv');
var ctx = cv.getContext('2d');
cv.width = W;
cv.height = H;

var CELLS = W * H;
