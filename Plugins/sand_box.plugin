__id__ = "sand_box"
__name__ = "SandBox"
__description__ = (
    "Интерактивная песочница: рисуй элементы и наблюдай, как они горят, текут, взрываются и взаимодействуют друг с другом."
)
__author__ = "@the_kubicki"
__version__ = "1.0.0"
__icon__ = "Kubick_Plugin_by_fStikBot/0"
__min_version__ = "13.1.1"

GRID_WIDTHS = [100, 150, 200]
SPEED_STEPS = [1, 2, 4]

ValueCallbackCls = find_class("android.webkit.ValueCallback")

GAME_HTML = """<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no"/>
<style>
html, body {
    margin: 0;
    padding: 0;
    background: #101014;
    color: #eee;
    font-family: sans-serif;
    overflow: hidden;
    height: 100%;
}
#wrap {
    display: flex;
    flex-direction: column;
    height: 100vh;
}
#top {
    display: flex;
    gap: 6px;
    padding: 6px;
    align-items: center;
}
#top button {
    background: #26262e;
    color: #eee;
    border: none;
    border-radius: 10px;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
}
#top button .bv {
    font-size: 9px;
    color: #ffd76a;
    margin-left: 1px;
    font-style: normal;
}
#top button.text-btn {
    width: auto;
    padding: 0 12px;
    font-size: 12px;
}
#top button.danger {
    background: #5a2626;
}
#fps {
    margin-left: auto;
    font: 11px monospace;
    color: #8f8;
    flex: 0 0 auto;
}
#cv {
    flex: 1;
    width: 100%;
    min-height: 0;
    image-rendering: pixelated;
    touch-action: none;
    background: #000;
}
#pal {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 60px;
    grid-template-rows: repeat(2, auto);
    gap: 4px;
    padding: 6px;
    overflow-x: auto;
    overflow-y: hidden;
    flex: 0 0 auto;
}
.tile {
    background: #1c1c22;
    border: 2px solid transparent;
    border-radius: 10px;
    padding: 4px 2px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
}
.tile svg {
    width: 32px;
    height: 32px;
    display: block;
}
.tile span {
    display: block;
    font-size: 8px;
    color: #aaa;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 56px;
}
.tile.sel {
    border-color: #ffd76a;
    background: #2c2c36;
}
.tile.sel span {
    color: #ffd76a;
}
#set {
    position: fixed;
    left: 0; top: 0; right: 0; bottom: 0;
    background: rgba(10, 10, 14, 0.94);
    z-index: 10;
    overflow-y: auto;
    padding: 14px;
    display: none;
}
#set h3 { margin: 0 0 10px 0; font-size: 16px; }
.srow {
    display: flex;
    gap: 10px;
    align-items: center;
    margin-bottom: 10px;
    background: #1c1c22;
    border-radius: 12px;
    padding: 8px;
}
.srow button {
    background: #26262e;
    color: #eee;
    border: none;
    border-radius: 10px;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
}
.srow .ic {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffd76a;
    flex: 0 0 auto;
}
.srow .tx { flex: 1 1 auto; }
.srow b { font-size: 13px; display: block; }
.srow b i { color: #ffd76a; font-style: normal; }
.srow .tx span { font-size: 11px; color: #aaa; display: block; margin-top: 2px; }
.srow input[type=range] { width: 100%; accent-color: #ffd76a; margin: 4px 0; }
.close-settings-btn {
    background: #3a6ea5;
    color: #eee;
    border: none;
    border-radius: 20px;
    padding: 12px;
    font-size: 14px;
    width: 100%;
    margin-top: 10px;
}
#toast {
    position: fixed;
    left: 50%;
    bottom: 130px;
    transform: translateX(-50%);
    background: rgba(40, 40, 48, 0.95);
    color: #fff;
    font-size: 13px;
    padding: 8px 16px;
    border-radius: 16px;
    z-index: 20;
    display: none;
    white-space: nowrap;
}
</style>
</head>
<body>
<div id="wrap">
    <div id="top">
        <button id="bg"></button>
        <button id="bp"></button>
        <button id="bs"></button>
        <button id="bc" class="text-btn">очистить</button>
        <span id="fps"></span>
        <button id="bx" class="danger"></button>
    </div>
    <canvas id="cv"></canvas>
    <div id="pal"></div>
</div>
<div id="set">
    <h3>Настройки игры</h3>
    <div class="srow">
        <span class="ic" id="icbr"></span>
        <div class="tx"><b>Кисть: <i id="brv">3</i></b>
            <input id="br" type="range" min="1" max="16" value="3"/>
            <span>Толщина кисти: радиус круга, которым рисуется выбранный элемент (1 — точка, 16 — широкое пятно).</span></div>
    </div>
    <div class="srow">
        <span class="ic" id="icrw"></span>
        <div class="tx"><b>Ряды палитры: <i id="rwv">2</i></b>
            <input id="rw" type="range" min="1" max="4" value="2"/>
            <span>Во сколько рядов показывать нижнюю палитру элементов: 1 — длинная лента, 4 — компактная сетка. Запоминается.</span></div>
    </div>
    <div class="srow">
        <button id="sd"></button>
        <div class="tx"><b>Демо-сцена</b><span>Строит пример: куча песка, лужа воды, дерево с растением и цепь батарея-провод-лампа.</span></div>
    </div>
    <div class="srow">
        <button id="sv"></button>
        <div class="tx"><b>Сохранить</b><span>Запоминает текущую сцену в памяти телефона — переживёт закрытие окна.</span></div>
    </div>
    <div class="srow">
        <button id="sl"></button>
        <div class="tx"><b>Загрузить</b><span>Восстанавливает последнюю сохранённую сцену поверх текущей.</span></div>
    </div>
    <button id="sx" class="close-settings-btn">Закрыть настройки</button>
</div>
<div id="toast"></div>
<script>
window.onerror = function (m, s, l) {
    document.body.innerHTML = '<pre style="color:#f88;padding:10px;font:12px monospace;white-space:pre-wrap">JS ERROR: ' + m + ' (line ' + l + ')</pre>';
};
window.__ev = [];

