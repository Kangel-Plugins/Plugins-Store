    temp[i0] = 20;
    vr[i0] = (Math.random() * 4) | 0;
}

var NID = 0;
var E = [];
function el(name, emoji, color, type, dens, opt) {
    var id = NID++;
    var o = { id: id, name: name, emoji: emoji, color: color, type: type, dens: dens, desc: '' };
    if (opt) for (var k in opt) o[k] = opt[k];
    E[id] = o;
    return id;
}

var EMPTY = el("Ластик", "🚫", [16, 16, 20], 0, 0, { desc: 'Стирает всё' });
var WALL  = el("Стена",  "🧱", [92, 92, 98], 1, 100, { desc: 'Неразрушимая основа' });
var STONE = el("Камень", "🪨", [122, 122, 125], 2, 90, { desc: 'Сыпучий, тяжёлый' });
var SAND  = el("Песок",  "⏳", [222, 190, 120], 2, 80, { desc: 'Сыпется, с лавой даёт стекло' });
var DIRT  = el("Земля",  "🟤", [122, 86, 60], 2, 78, { desc: 'Почва для растений' });
var GUNP  = el("Порох",  "💥", [62, 62, 64], 2, 76, { fl: 1, desc: 'Детонирует мгновенно' });
var SNOW  = el("Снег",   "❄️", [240, 248, 255], 2, 30, { cold: 1, desc: 'Холодный, тает в воду' });
var SEED  = el("Семя",   "🌰", [152, 112, 62], 2, 70, { fl: 0.6, desc: 'Прорастает на земле у воды' });
var ASH   = el("Пепел",  "🌫", [110, 108, 105], 2, 40, { desc: 'Остаток горения, с водой станет землёй' });
var WATER = el("Вода",   "💧", [42, 92, 205], 3, 30, { disp: 5, cond: 1, desc: 'Тушит, замерзает, кипит, проводит ток' });
var OIL   = el("Масло",  "🛢", [152, 122, 42], 3, 25, { disp: 3, fl: 0.9, desc: 'Плавает на воде, горит' });
var ACID  = el("Кислота","🧪", [142, 222, 62], 3, 32, { disp: 3, desc: 'Растворяет почти всё' });
var ALK   = el("Щёлочь", "🥛", [222, 222, 232], 3, 31, { disp: 3, desc: 'Нейтрализует кислоту в воду и соль' });
var MERC  = el("Ртуть",  "⚪", [182, 186, 192], 3, 95, { disp: 1, cond: 2, desc: 'Тяжёлый жидкий проводник' });
var LAVA  = el("Лава",   "🌋", [222, 82, 22], 3, 85, { disp: 1, hot: 100, desc: 'Жжёт, с водой каменеет' });
var STEAM = el("Пар",    "☁️", [202, 202, 212], 4, 5, { life: 180, desc: 'Поднимается, у холода конденсируется' });
var SMOKE = el("Дым",    "💨", [72, 72, 78], 4, 4, { life: 120, desc: 'Поднимается и рассеивается' });
var GAS   = el("Газ",    "🫧", [182, 222, 182], 4, 2, { fl: 1, desc: 'Горючий, взрывается с огнём' });
var WOOD  = el("Дерево", "🪵", [112, 82, 52], 5, 50, { fl: 0.5, desc: 'Горит, оставляет пепел' });
var COAL  = el("Уголь",  "⚫", [42, 42, 44], 5, 52, { fl: 0.3, desc: 'Тлеет долго' });
var TNT   = el("Динамит","🧨", [202, 62, 52], 5, 55, { fuse: 1, desc: 'Мигает и даёт один мощный взрыв' });
var ICE   = el("Лёд",    "🧊", [162, 212, 252], 5, 28, { cold: 1, desc: 'Морозит воду, тает, колется от взрыва' });
var PLANT = el("Растение","🌿", [62, 162, 72], 5, 40, { fl: 0.7, grow: 1, desc: 'Растёт вверх без конца, пока есть место' });
var FUNG  = el("Грибок", "🍄", [192, 122, 192], 5, 42, { fl: 0.5, spread: 1, desc: 'Расползается по органике' });
var WIRE  = el("Провод", "🔌", [202, 152, 52], 5, 60, { cond: 2, desc: 'Проводит ток, в т.ч. по диагонали' });
var BATT  = el("Батарея","🔋", [62, 162, 92], 1, 62, { src: 1, desc: 'Источник тока; в огне взрывается' });
var LAMP  = el("Лампа",  "💡", [232, 232, 182], 1, 45, { lamp: 1, desc: 'Светится целиком от контакта с током' });
var GLASS = el("Стекло", "🔮", [170, 220, 230], 5, 55, { desc: 'Из песка с лавой; бьётся от взрыва' });
var SALT  = el("Соль",   "🧂", [240, 240, 240], 2, 70, { desc: 'Осадок нейтрализации' });
var FIRE  = el("Огонь",  "🔥", [252, 142, 32], 6, 1, { hot: 90, desc: 'Поджигает горючее, лижет вверх' });
var BOLT  = el("Молния", "⚡", [252, 252, 122], 6, 1, { bolt: 1, desc: 'Удар: взрыв и поджиг' });
var SPARK = el("Искра",  "✨", [255, 220, 120], 7, 1, { desc: 'Горячая частица взрыва: летит и поджигает' });

var DX = [1, 1, 0, -1, -1, -1, 0, 1];
var DY = [0, 1, 1, 1, 0, -1, -1, -1];
var flashT = 0;

var img = ctx.createImageData(W, H);
var buf = new Uint32Array(img.data.buffer);
var parity = 0;
var tick = 0;
var paused = false;
var speed = __SP__;
var brush = 3;
var cur = WATER;
var frames = 0;
var fpsT = Date.now();

var NB = new Int32Array(4);
function nb4c(i) {
    var x = i % W, y = (i / W) | 0, n = 0;
    if (x > 0) NB[n++] = i - 1;
    if (x < W - 1) NB[n++] = i + 1;
    if (y > 0) NB[n++] = i - W;
    if (y < H - 1) NB[n++] = i + W;
    return n;
}
var NB8 = new Int32Array(8);
function nb8c(i) {
    var x = i % W, y = (i / W) | 0, n = 0;
    for (var dy = -1; dy <= 1; dy++) {
        for (var dx = -1; dx <= 1; dx++) {
            if (dx === 0 && dy === 0) continue;
            var nx = x + dx, ny = y + dy;
            if (nx >= 0 && nx < W && ny >= 0 && ny < H) NB8[n++] = ny * W + nx;
        }
    }
    return n;
}
function idx(x, y) { return y * W + x; }
function inB(x, y) { return x >= 0 && x < W && y >= 0 && y < H; }
function swap(a, b) {
    var t = grid[a]; grid[a] = grid[b]; grid[b] = t;
    t = temp[a]; temp[a] = temp[b]; temp[b] = t;
    t = life[a]; life[a] = life[b]; life[b] = t;
    t = memo[a]; memo[a] = memo[b]; memo[b] = t;
    t = vr[a]; vr[a] = vr[b]; vr[b] = t;
    stamp[b] = parity;
}
function canEnter(m, tg) {
    if (tg === EMPTY) return true;
    var tt = E[tg].type;
    if (tt === 4 || tt === 3 || tt === 7) return E[m].dens > E[tg].dens;
    return false;
}
function ignite(i) {
    var id = grid[i];
    if (!E[id].fl) return;
    memo[i] = id;
    grid[i] = FIRE;
    life[i] = (id === COAL) ? 200 : (id === WOOD) ? 120 : 40 + ((Math.random() * 40) | 0);
    stamp[i] = parity;
}
function boom(cx, cy, r) {
    flashT = Math.max(flashT, Math.min(6, 2 + (r >> 1)));
    for (var dy = -r; dy <= r; dy++) {
        for (var dx = -r; dx <= r; dx++) {
            var d = Math.sqrt(dx * dx + dy * dy);
            if (d > r) continue;
            var x = cx + dx, y = cy + dy;
            if (!inB(x, y)) continue;
            var i = idx(x, y), id = grid[i];
            if (id === WALL) continue;
            var fr = d / r;
            if (fr < 0.35) {
                grid[i] = EMPTY; life[i] = 0;
            } else if (fr < 0.7) {
                if (E[id].fl) { grid[i] = FIRE; memo[i] = id; life[i] = 60; }
                else if (id === GLASS || id === ICE) grid[i] = EMPTY;
                else if (id !== EMPTY && Math.random() < 0.75) { grid[i] = EMPTY; life[i] = 0; }
            } else {
                if (E[id].fl && Math.random() < 0.6) { grid[i] = FIRE; memo[i] = id; life[i] = 60; }
                else if ((id === GLASS || id === ICE) && Math.random() < 0.7) grid[i] = EMPTY;
                else if ((id === STONE || id === SAND || id === DIRT) && Math.random() < 0.35) grid[i] = EMPTY;
            }
            stamp[i] = parity;
        }
    }
    var ns = r * r;
    for (var k = 0; k < ns; k++) {
        var a = (Math.random() * 8) | 0;
        var ox = cx + DX[a], oy = cy + DY[a];
        if (!inB(ox, oy)) continue;
        var si = idx(ox, oy);
        if (grid[si] === EMPTY || grid[si] === SMOKE || grid[si] === FIRE) {
            grid[si] = SPARK; vr[si] = a; life[si] = 8 + ((Math.random() * r) | 0);
            stamp[si] = parity;
        }
    }
    for (var k3 = 0; k3 < r; k3++) {
        var px = cx + ((Math.random() * (2 * r + 1)) | 0) - r;
        var py = cy + ((Math.random() * (2 * r + 1)) | 0) - r;
        if (!inB(px, py)) continue;
        var pi = idx(px, py), pid = grid[pi];
        if (pid === STONE || pid === SAND || pid === DIRT || pid === GLASS || pid === ICE || pid === WOOD) {
            var ddx = px - cx, ddy = py - cy;
            var len = Math.max(1, Math.sqrt(ddx * ddx + ddy * ddy));
            var tx = px + Math.round(ddx / len * 3);
            var ty = py + Math.round(ddy / len * 3) - 2;
            grid[pi] = EMPTY; stamp[pi] = parity;
            if (inB(tx, ty) && grid[idx(tx, ty)] === EMPTY) { grid[idx(tx, ty)] = pid; stamp[idx(tx, ty)] = parity; }
        }
    }
}

function react(i, x, y) {
    var id = grid[i], e = E[id], k, j, n;
    if (id === FIRE) {
        if (--life[i] <= 0) {
            var was = memo[i];
            if (was && E[was].type === 5 && Math.random() < 0.6) { grid[i] = ASH; }
            else if (Math.random() < 0.35) { grid[i] = SMOKE; life[i] = E[SMOKE].life; }
            else grid[i] = EMPTY;
            memo[i] = 0;
            return;
        }
        n = nb4c(i);
        for (k = 0; k < n; k++) {
            j = NB[k];
            var jid = grid[j];
            if (jid === WATER) {
                grid[i] = SMOKE; life[i] = E[SMOKE].life;
                if (Math.random() < 0.4) { grid[j] = STEAM; life[j] = E[STEAM].life; }
                return;
            }
            if (E[jid].fl && Math.random() < E[jid].fl * 0.25) ignite(j);
            if (jid === ICE) grid[j] = WATER;
            if (jid === SNOW) grid[j] = WATER;
        }
        if (y > 0 && grid[i - W] === EMPTY && Math.random() < 0.3) { swap(i, i - W); return; }
    } else if (id === LAVA) {
        n = nb4c(i);
        for (k = 0; k < n; k++) {
            j = NB[k];
            var id2 = grid[j];
            if (id2 === WATER) { grid[i] = STONE; grid[j] = STEAM; life[j] = E[STEAM].life; return; }
            if (id2 === ICE || id2 === SNOW) { grid[j] = WATER; }
            else if (id2 === SAND && Math.random() < 0.1) { grid[j] = GLASS; }
            else if (E[id2].fl && Math.random() < 0.4) ignite(j);
        }
    } else if (id === STEAM) {
        if (--life[i] <= 0 || temp[i] < 10) { grid[i] = Math.random() < 0.5 ? WATER : EMPTY; return; }
    } else if (id === SMOKE) {
        if (--life[i] <= 0) { grid[i] = EMPTY; return; }
    } else if (id === GAS) {
        n = nb4c(i);
        for (k = 0; k < n; k++) {
            j = NB[k];
            if (grid[j] === FIRE || grid[j] === LAVA) { boom(x, y, 4); grid[i] = FIRE; life[i] = 40; return; }
        }
    } else if (id === ACID) {
        n = nb4c(i);
        for (k = 0; k < n; k++) {
            j = NB[k];
            var id4 = grid[j];
            if (id4 === ALK) { grid[i] = WATER; grid[j] = SALT; return; }
            if (id4 !== EMPTY && id4 !== WALL && id4 !== ACID && id4 !== ALK && id4 !== GLASS && Math.random() < 0.08) {
                grid[j] = EMPTY;
                if (Math.random() < 0.06) { grid[i] = EMPTY; return; }
            }
        }
    } else if (id === ALK) {
        n = nb4c(i);
        for (k = 0; k < n; k++) {
            j = NB[k];
            if (grid[j] === ACID) { grid[i] = WATER; grid[j] = SALT; return; }
        }
    } else if (id === ASH) {
        n = nb4c(i);
        for (k = 0; k < n; k++) {
            j = NB[k];
            if (grid[j] === WATER && Math.random() < 0.01) { grid[i] = DIRT; return; }
        }
    } else if (id === SEED) {
        if (y < H - 1 && grid[idx(x, y + 1)] === DIRT) {
            n = nb4c(i);
            var wet = false;
            for (k = 0; k < n; k++) if (grid[NB[k]] === WATER) wet = true;
            if (wet && ++life[i] > 10) { grid[i] = PLANT; life[i] = 0; }
        }
    } else if (id === PLANT) {
        if (y > 0 && grid[i - W] === EMPTY && Math.random() < 0.04) {
            grid[i - W] = PLANT;
            stamp[i - W] = parity;
        }
        n = nb4c(i);
        for (k = 0; k < n; k++) {
            j = NB[k];
            if (grid[j] === WATER && Math.random() < 0.08) {
                var empty = [];
                for (var m = 0; m < n; m++) if (grid[NB[m]] === EMPTY) empty.push(NB[m]);
                if (empty.length > 0) grid[empty[(Math.random() * empty.length) | 0]] = PLANT;
                return;
            }
        }
    } else if (id === FUNG) {
        n = nb4c(i);
        if (n > 0) {
            j = NB[(Math.random() * n) | 0];
            var jf = grid[j];
            if ((jf === WOOD || jf === DIRT || jf === PLANT) && Math.random() < 0.012) grid[j] = FUNG;
        }
    } else if (id === TNT) {
        n = nb4c(i);
        var hot = false;
        for (k = 0; k < n; k++) {
            j = NB[k];
            if (grid[j] === FIRE || grid[j] === LAVA || temp[j] > 70) hot = true;
        }
        if (hot && life[i] === 0) life[i] = 55;
        if (life[i] > 0) {
            life[i]--;
            if (life[i] === 1) { boom(x, y, 12); grid[i] = EMPTY; }
        }
    } else if (id === GUNP) {
        n = nb4c(i);
        for (k = 0; k < n; k++) {
            j = NB[k];
            if (grid[j] === FIRE || grid[j] === LAVA || temp[j] > 60) { boom(x, y, 5); grid[i] = FIRE; life[i] = 40; memo[i] = GUNP; return; }
        }
    } else if (id === BATT) {
        n = nb4c(i);
        var hotb = false;
        for (k = 0; k < n; k++) {
            j = NB[k];
            if (grid[j] === FIRE || grid[j] === LAVA || temp[j] > 80) hotb = true;
        }
        if (hotb) { boom(x, y, 4); grid[i] = EMPTY; }
    } else if (id === BOLT) {
        boom(x, y, 3);
        n = nb4c(i);
        for (k = 0; k < n; k++) if (E[grid[NB[k]]].fl) ignite(NB[k]);
        grid[i] = EMPTY;
        return;
    } else if (id === ICE) {
        n = nb4c(i);
        for (k = 0; k < n; k++) {
            j = NB[k];
            if (grid[j] === WATER && Math.random() < 0.008) grid[j] = ICE;
        }
    } else if (id === WATER) {
        n = nb4c(i);
        for (k = 0; k < n; k++) {
            j = NB[k];
            if (grid[j] === FIRE) {
                grid[j] = SMOKE; life[j] = E[SMOKE].life;
                if (Math.random() < 0.3) { grid[i] = STEAM; life[i] = E[STEAM].life; return; }
            } else if (grid[j] === SNOW && Math.random() < 0.02) grid[j] = WATER;
        }
    }
}

function movePowder(i, x, y) {
    if (y >= H - 1) return;
    var b = idx(x, y + 1);
    if (canEnter(grid[i], grid[b])) { swap(i, b); return; }
    var d = Math.random() < 0.5 ? 1 : -1;
    for (var s = 0; s < 2; s++) {
        var nx = x + (s === 0 ? d : -d);
        if (nx < 0 || nx >= W) continue;
        var j = idx(nx, y + 1);
        if (canEnter(grid[i], grid[j])) { swap(i, j); return; }
    }
}
function moveLiquid(i, x, y) {
    if (y < H - 1) {
        var b = idx(x, y + 1);
        if (canEnter(grid[i], grid[b])) { swap(i, b); return; }
        var d = Math.random() < 0.5 ? 1 : -1;
        for (var s = 0; s < 2; s++) {
            var nx = x + (s === 0 ? d : -d);
            if (nx < 0 || nx >= W) continue;
            var j = idx(nx, y + 1);
            if (canEnter(grid[i], grid[j])) { swap(i, j); return; }
        }
    }
    var disp = E[grid[i]].disp || 1;
    var dir = Math.random() < 0.5 ? 1 : -1;
    for (var k = 0; k < disp; k++) {
        var nx2 = x + dir;
        if (nx2 < 0 || nx2 >= W) return;
        var j2 = idx(nx2, y);
        if (!canEnter(grid[i], grid[j2])) return;
        swap(i, j2);
        i = j2;
        x = nx2;
    }
}
function moveGas(i, x, y) {
    if (y > 0) {
        var b = idx(x, y - 1);
        if (grid[b] === EMPTY || E[grid[b]].type === 3) { swap(i, b); return; }
        var d = Math.random() < 0.5 ? 1 : -1;
        for (var s = 0; s < 2; s++) {
            var nx = x + (s === 0 ? d : -d);
            if (nx < 0 || nx >= W) continue;
            var j = idx(nx, y - 1);
            if (grid[j] === EMPTY) { swap(i, j); return; }
        }
    }
    var dir = Math.random() < 0.5 ? 1 : -1;
    var nx2 = x + dir;
    if (nx2 >= 0 && nx2 < W && grid[idx(nx2, y)] === EMPTY) swap(i, idx(nx2, y));
}
function moveSpark(i, x, y) {
    if (--life[i] <= 0) { grid[i] = Math.random() < 0.5 ? SMOKE : EMPTY; return; }
    var d = vr[i] % 8;
    var nx = x + DX[d], ny = y + DY[d];
    if (!inB(nx, ny)) { grid[i] = EMPTY; return; }
    var j = idx(nx, ny), tg = grid[j];
    if (tg === EMPTY || tg === GAS || tg === SMOKE || tg === STEAM) {
        swap(i, j);
        vr[j] = d;
        if (Math.random() < 0.25) { grid[i] = Math.random() < 0.5 ? FIRE : SMOKE; life[i] = 18; }
    } else {
        if (E[tg].fl) ignite(j);
        grid[i] = Math.random() < 0.5 ? FIRE : SMOKE;
        life[i] = 15;
    }
}

function chargeLamps() {
    lp.fill(0);
    var stack = [];
    for (var i = 0; i < CELLS; i++) {
        if (grid[i] !== LAMP) continue;
        var n = nb8c(i), seed = false;
        for (var k = 0; k < n; k++) {
            var j = NB8[k], e = E[grid[j]];
            if (e.src || (e.cond && ch[j] === 1)) { seed = true; break; }
        }
        if (seed) { lp[i] = 1; stack.push(i); }
    }
    while (stack.length) {
        var c = stack.pop();
        var m = nb8c(c);
        for (var q = 0; q < m; q++) {
            var j2 = NB8[q];
            if (grid[j2] === LAMP && lp[j2] === 0) { lp[j2] = 1; stack.push(j2); }
        }
    }
}

function step() {
    parity ^= 1;
    for (var y = H - 1; y >= 0; y--) {
        var ltr = ((y + tick) & 1) === 0;
        for (var xi = 0; xi < W; xi++) {
            var x = ltr ? xi : W - 1 - xi;
            var i = y * W + x;
            if (stamp[i] === parity) continue;
            var id = grid[i];
            if (id === EMPTY) continue;
            stamp[i] = parity;
            react(i, x, y);
            id = grid[i];
            if (id === EMPTY) continue;
            var t = E[id].type;
            if (t === 2) movePowder(i, x, y);
            else if (t === 3) moveLiquid(i, x, y);
            else if (t === 4) moveGas(i, x, y);
            else if (t === 7) moveSpark(i, x, y);
        }
    }
    nch.fill(0);
    for (var i2 = 0; i2 < CELLS; i2++) {
        var id2 = grid[i2], e2 = E[id2];
        if (e2.src) { nch[i2] = 1; continue; }
        if (!e2.cond) continue;
        var n2 = nb8c(i2), on = 0;
        for (var k2 = 0; k2 < n2; k2++) {
            var j2 = NB8[k2], nid = grid[j2];
            if (E[nid].src || (E[nid].cond && ch[j2] === 1 && (e2.cond === 2 || E[nid].cond === 2))) { on = 1; break; }
        }
        nch[i2] = on;
    }
    var tc = ch; ch = nch; nch = tc;
    chargeLamps();
    for (var i3 = 0; i3 < CELLS; i3++) {
        var e3 = E[grid[i3]];
        if (e3.hot) temp[i3] = e3.hot;
        else if (e3.cold) temp[i3] = 0;
    }
    if ((tick & 1) === 0) {
        for (var i4 = 0; i4 < CELLS; i4++) {
            var t4 = temp[i4];
            if (t4 === 20) continue;
            var n4 = nb4c(i4);
            for (var k4 = 0; k4 < n4; k4++) {
                var j4 = NB[k4];
                temp[j4] += (t4 - temp[j4]) >> 3;
            }
            temp[i4] = 20 + ((t4 - 20) * 3 >> 2);
        }
    }
    for (var i5 = 0; i5 < CELLS; i5++) {
        var id5 = grid[i5];
        if (id5 === WATER) {
            if (temp[i5] <= 2) grid[i5] = ICE;
            else if (temp[i5] >= 95) { grid[i5] = STEAM; life[i5] = E[STEAM].life; }
        } else if (id5 === ICE && temp[i5] >= 8) grid[i5] = WATER;
        else if (id5 === SNOW && temp[i5] >= 6) grid[i5] = WATER;
    }
    tick++;
}

function colorOf(i) {
    var id = grid[i], e = E[id];
    var r = e.color[0], g = e.color[1], b = e.color[2];
    var v = (vr[i] - 1.5) * 0.07;
    if (id === FIRE) {
        r = 255; g = 120 + ((tick + i) % 60); b = 30;
    } else if (id === SPARK) {
        r = 255; g = 200 + ((tick + i) % 55); b = 90;
    } else if (id === LAMP) {
        if (lp[i]) { r = 255; g = 240; b = 150; } else { r = 90; g = 90; b = 80; }
    } else if (id === WIRE && ch[i] === 1) {
        r = 255; g = 220; b = 80;
    } else if (id === LAVA) {
        g = 60 + ((tick + i) % 40);
    } else if (id === TNT && life[i] > 0 && ((tick >> 1) & 1)) {
        r = 255; g = 60; b = 60;
    }
    r = Math.max(0, Math.min(255, r * (1 + v))) | 0;
    g = Math.max(0, Math.min(255, g * (1 + v))) | 0;
    b = Math.max(0, Math.min(255, b * (1 + v))) | 0;
    return (255 << 24) | (b << 16) | (g << 8) | r;
}
function render() {
    for (var i = 0; i < CELLS; i++) buf[i] = colorOf(i);
    ctx.putImageData(img, 0, 0);
    if (flashT > 0) {
        ctx.fillStyle = 'rgba(255,240,200,' + (flashT / 8) + ')';
        ctx.fillRect(0, 0, W, H);
        flashT--;
    }
}

function paint(cx, cy, r, id) {
    for (var dy = -r; dy <= r; dy++) {
        for (var dx = -r; dx <= r; dx++) {
            if (dx * dx + dy * dy > r * r) continue;
            var x = cx + dx, y = cy + dy;
            if (!inB(x, y)) continue;
            var i = idx(x, y);
            grid[i] = id;
            memo[i] = 0;
            life[i] = E[id].life || 0;
            if (id === FIRE) life[i] = 50;
            if (id === SPARK) { life[i] = 20; vr[i] = (Math.random() * 8) | 0; }
            else vr[i] = (Math.random() * 4) | 0;
            temp[i] = E[id].hot || (E[id].cold ? 0 : 20);
        }
    }
}

var lastPt = null, drawing = false;
function ptFromEvent(e) {
    var r = cv.getBoundingClientRect();
    return [((e.clientX - r.left) / r.width * W) | 0, ((e.clientY - r.top) / r.height * H) | 0];
}
function drawLine(a, b) {
    var dx = b[0] - a[0], dy = b[1] - a[1];
    var n = Math.max(Math.abs(dx), Math.abs(dy), 1);
    for (var k = 0; k <= n; k++) {
        paint(a[0] + ((dx * k / n) | 0), a[1] + ((dy * k / n) | 0), brush, cur);
    }
}
cv.addEventListener('pointerdown', function (e) { drawing = true; lastPt = ptFromEvent(e); drawLine(lastPt, lastPt); e.preventDefault(); });
cv.addEventListener('pointermove', function (e) { if (!drawing) return; var p = ptFromEvent(e); drawLine(lastPt, p); lastPt = p; e.preventDefault(); });
cv.addEventListener('pointerup', function () { drawing = false; lastPt = null; });
cv.addEventListener('pointercancel', function () { drawing = false; lastPt = null; });

var toastT = null;
function toast(msg) {
    var t = document.getElementById('toast');
    t.textContent = msg;
    t.style.display = 'block';
    if (toastT) clearTimeout(toastT);
    toastT = setTimeout(function () { t.style.display = 'none'; }, 1400);
}

var pal = document.getElementById('pal');
KEYS.forEach(function(key, id) {
    var d = document.createElement('div');
    d.className = 'tile' + (id === cur ? ' sel' : '');
    d.innerHTML = ICONS[key] + '<span>' + E[id].name + '</span>';
    d.onclick = function () {
        cur = id;
        var s = document.querySelectorAll('.tile');
        for (var k = 0; k < s.length; k++) s[k].className = 'tile';
        d.className = 'tile sel';
        toast(E[id].name);
    };
    pal.appendChild(d);
});

function applyRows(n) {
    n = Math.max(1, Math.min(4, n | 0));
    pal.style.gridTemplateRows = 'repeat(' + n + ', auto)';
    document.getElementById('rwv').textContent = n;
    try { localStorage.setItem('sand_rows', '' + n); } catch (e) {}
}
var rows0 = 2;
try { rows0 = parseInt(localStorage.getItem('sand_rows') || '2', 10) || 2; } catch (e) {}
document.getElementById('rw').value = rows0;
applyRows(rows0);

document.getElementById('bg').innerHTML = SVG.gear;
document.getElementById('bp').innerHTML = SVG.pause;
document.getElementById('bs').innerHTML = SVG.fast + '<i class="bv">×' + speed + '</i>';
document.getElementById('bx').innerHTML = SVG.close;
document.getElementById('sd').innerHTML = SVG.demo;
document.getElementById('sv').innerHTML = SVG.save;
document.getElementById('sl').innerHTML = SVG.folder;
document.getElementById('icbr').innerHTML = SVG.brush;
document.getElementById('icrw').innerHTML = SVG.rows;
document.getElementById('brv').textContent = brush;

document.getElementById('bg').onclick = function () {
    var s = document.getElementById('set');
    s.style.display = (s.style.display === 'block') ? 'none' : 'block';
};
document.getElementById('sx').onclick = function () {
    document.getElementById('set').style.display = 'none';
};
document.getElementById('bx').onclick = function () {
    var s = document.getElementById('set');
    if (s.style.display === 'block') {
        s.style.display = 'none';
        toast('Настройки закрыты');
    } else {
        window.__ev.push('sand://close');
    }
};
document.getElementById('bp').onclick = function () {
    paused = !paused;
    this.innerHTML = paused ? SVG.play : SVG.pause;
    toast(paused ? 'Пауза: время остановлено' : 'Симуляция идёт');
};
document.getElementById('bs').onclick = function () {
    speed = speed === 1 ? 2 : (speed === 2 ? 4 : 1);
    this.innerHTML = SVG.fast + '<i class="bv">×' + speed + '</i>';
    toast('Скорость: ×' + speed);
};
document.getElementById('br').oninput = function () {
    brush = parseInt(this.value, 10) || 1;
    document.getElementById('brv').textContent = brush;
};
document.getElementById('rw').oninput = function () {
    applyRows(parseInt(this.value, 10) || 1);
};
document.getElementById('bc').onclick = function () {
    grid.fill(EMPTY); memo.fill(0);
    for (var i = 0; i < CELLS; i++) { temp[i] = 20; life[i] = 0; }
    toast('Поле очищено');
};
document.getElementById('sd').onclick = function () {
    grid.fill(EMPTY); memo.fill(0);
    for (var i = 0; i < CELLS; i++) { temp[i] = 20; life[i] = 0; }
    demo();
    toast('Демо-сцена построена');
};
document.getElementById('sv').onclick = function () {
    try {
        var s = '';
        for (var i = 0; i < CELLS; i += 8192) s += String.fromCharCode.apply(null, grid.subarray(i, i + 8192));
        localStorage.setItem('sand_v1', btoa(s));
        toast('Сцена сохранена');
    } catch (e) { toast('Не удалось сохранить'); }
};
document.getElementById('sl').onclick = function () {
    try {
        var d = localStorage.getItem('sand_v1');
        if (!d) { toast('Сохранений пока нет'); return; }
        var bin = atob(d);
        for (var i = 0; i < CELLS && i < bin.length; i++) { grid[i] = bin.charCodeAt(i); life[i] = 0; memo[i] = 0; }
        toast('Сцена загружена');
    } catch (e) { toast('Не удалось загрузить'); }
};

function demo() {
    for (var x = 0; x < W; x++) { grid[idx(x, H - 1)] = WALL; grid[idx(x, H - 2)] = WALL; }
    for (var k = 0; k < 600; k++) {
        var xs = (W / 2 + ((Math.random() - 0.5) * 30)) | 0;
        var ys = (H - 3 - ((Math.random() * 20) | 0)) | 0;
        if (inB(xs, ys) && grid[idx(xs, ys)] === EMPTY) grid[idx(xs, ys)] = SAND;
    }
    for (var k2 = 0; k2 < 300; k2++) {
        var xw = (20 + (Math.random() * 30)) | 0;
        var yw = (H - 3 - ((Math.random() * 8) | 0)) | 0;
        if (inB(xw, yw) && grid[idx(xw, yw)] === EMPTY) grid[idx(xw, yw)] = WATER;
    }
    for (var yw2 = H - 20; yw2 < H - 2; yw2++) if (inB(W - 25, yw2)) grid[idx(W - 25, yw2)] = WOOD;
    if (inB(W - 25, H - 21)) grid[idx(W - 25, H - 21)] = PLANT;
    if (inB(10, H - 6)) { grid[idx(10, H - 6)] = BATT; grid[idx(11, H - 6)] = WIRE; grid[idx(12, H - 6)] = LAMP; }
}
demo();

function loop() {
    requestAnimationFrame(loop);
    if (!paused) for (var s = 0; s < speed; s++) step();
    render();
    frames++;
    var now = Date.now();
    if (now - fpsT >= 1000) { document.getElementById('fps').textContent = frames + ' fps'; frames = 0; fpsT = now; }
}
loop();
</script>
</body>
</html>"""


class SandEvCb(dynamic_proxy(ValueCallbackCls)):
    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin

    def onReceiveValue(self, value):
        try:
            raw = str(value)
            if not raw or raw == "null" or raw == "[]":
                return
            if raw.startswith('"'):
                raw = json.loads(raw)
            evs = json.loads(raw)
            if evs:
                self.plugin._handle_events(evs)
        except Exception:
            pass


class SandBoxPlugin(BasePlugin):

    def __init__(self):
        super().__init__()
        self._wv = None
        self._dlg = None
        self._poll_alive = False

    def on_plugin_load(self):
        self.add_menu_item(MenuItemData(
            menu_type=MenuItemType.CHAT_ACTION_MENU,
            text="SandBox",
            icon="dialog_media_game_20",
            item_id="sand_open_btn",
            on_click=self._on_menu
        ))
        self.add_on_send_message_hook()

    def on_plugin_unload(self):
        run_on_ui_thread(self._destroy)

    def _on_menu(self, context):
        self._open()

    def on_send_message_hook(self, account, params):
        if not self.get_setting("enabled", True):
            return HookResult()
        msg = getattr(params, "message", None)
        if isinstance(msg, str) and msg.strip().lower().startswith(".sand"):
            self._open()
            return HookResult(strategy=HookStrategy.CANCEL)
        return HookResult()

    def _int(self, key, default, lo, hi):
        return default

    def _open(self):
        run_on_ui_thread(self._build)

    def _handle_events(self, evs):
        for u in evs:
            if u.startswith("sand://close"):
                run_on_ui_thread(self._destroy)

    def _start_poll(self):
        self._poll_alive = True
        def loop():
            while self._poll_alive and self._wv is not None:
                time.sleep(0.3)
                wv = self._wv
                if wv is None:
                    break
                run_on_ui_thread(lambda: self._poll_once(wv))
        threading.Thread(target=loop, daemon=True).start()

    def _poll_once(self, wv):
        try:
            wv.evaluateJavascript("window.__ev && window.__ev.length ? JSON.stringify(window.__ev.splice(0)) : '[]'", SandEvCb(self))
        except Exception:
            pass

    def _destroy(self):
        self._poll_alive = False
        try:
            if self._dlg is not None:
                self._dlg.dismiss()
        except Exception:
            pass
        try:
            if self._wv is not None:
                self._wv.destroy()
        except Exception:
            pass
        self._wv = None
        self._dlg = None

    def _build(self):
        try:
            from client_utils import get_last_fragment
            from android.app import Dialog
            from android.webkit import WebView
            from android.widget import FrameLayout
            from android.graphics import Color
            from android.graphics.drawable import ColorDrawable
            from android.view import Window, ViewGroup, WindowManager
            from java import dynamic_proxy
            from android.content import DialogInterface

            fragment = get_last_fragment()
            if fragment is None:
                return
            ctx = fragment.getParentActivity()
            if ctx is None:
                return
            if self._dlg is not None:
                try:
                    self._dlg.dismiss()
                except Exception:
                    pass
                self._dlg = None
            if self._wv is not None:
                try:
                    self._wv.destroy()
                except Exception:
                    pass
                self._wv = None

            wv = WebView(ctx)
            st = wv.getSettings()
            st.setJavaScriptEnabled(True)
            st.setDomStorageEnabled(True)
            st.setUseWideViewPort(False)
            wv.setBackgroundColor(Color.parseColor("#FF101014"))
            gw = GRID_WIDTHS[1]
            sp = SPEED_STEPS[0]
            html = GAME_HTML.replace("__GW__", str(gw)).replace("__SP__", str(sp))
            wv.loadDataWithBaseURL("https://localhost/", html, "text/html", "utf-8", None)

            holder = FrameLayout(ctx)
            holder.setBackgroundColor(Color.parseColor("#FF101014"))
            wv.setLayoutParams(FrameLayout.LayoutParams(-1, -1))
            holder.addView(wv)

            dlg = Dialog(ctx)
            dlg.requestWindowFeature(Window.FEATURE_NO_TITLE)
            dlg.setContentView(holder, ViewGroup.LayoutParams(-1, -1))
            dlg.setCancelable(True)

            class _DismissListener(dynamic_proxy(DialogInterface.OnDismissListener)):
                def __init__(self, cb):
                    super().__init__()
                    self.cb = cb

                def onDismiss(self, d):
                    try:
                        self.cb()
                    except Exception:
                        pass

            dlg.setOnDismissListener(_DismissListener(self._destroy))

            win = dlg.getWindow()
            try:
                win.setLayout(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT)
                win.setBackgroundDrawable(ColorDrawable(Color.parseColor("#FF101014")))
                win.addFlags(
                    WindowManager.LayoutParams.FLAG_FULLSCREEN
                    | WindowManager.LayoutParams.FLAG_LAYOUT_NO_LIMITS
                )
                win.clearFlags(WindowManager.LayoutParams.FLAG_DIM_BEHIND)
                win.getDecorView().setSystemUiVisibility(0x1706)
            except Exception as e:
                log(f"sand: fullscreen flags: {e}")

            self._wv = wv
            self._dlg = dlg
            dlg.show()
            self._start_poll()
        except Exception as e:
            log(f"sand: окно не открылось: {e}")
            BulletinHelper.show_info(f"SandBox не запустилась: {e}")