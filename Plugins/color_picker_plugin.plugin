from java import jclass, dynamic_proxy

from base_plugin import BasePlugin, MenuItemData, MenuItemType
from android_utils import log
from client_utils import get_last_fragment
from ui.bulletin import BulletinHelper

from org.telegram.messenger import AndroidUtilities

__id__ = "color_picker_plugin"
__name__ = "Пипетка"
__description__ = "Три точки в чате → Плагины → Пипетка: копирует HEX и RGB любого цвета с экрана"
__author__ = "@Y0uAreMyLove"
__version__ = "1.0.0"
__icon__ = "msg_theme"
__min_version__ = "12.10.6"
__category__ = ["tools"]

Bitmap = jclass("android.graphics.Bitmap")
Canvas = jclass("android.graphics.Canvas")
Color = jclass("android.graphics.Color")
GradientDrawable = jclass("android.graphics.drawable.GradientDrawable")
PixelCopy = jclass("android.view.PixelCopy")
Handler = jclass("android.os.Handler")
Looper = jclass("android.os.Looper")
View = jclass("android.view.View")
KeyEvent = jclass("android.view.KeyEvent")
MotionEvent = jclass("android.view.MotionEvent")
Gravity = jclass("android.view.Gravity")
FrameLayout = jclass("android.widget.FrameLayout")
ImageView = jclass("android.widget.ImageView")
TextView = jclass("android.widget.TextView")
Runnable = jclass("java.lang.Runnable")


class _Run(dynamic_proxy(Runnable)):
    def __init__(self, fn):
        super().__init__()
        self.fn = fn

    def run(self):
        self.fn()


class _Touch(dynamic_proxy(View.OnTouchListener)):
    def __init__(self, fn):
        super().__init__()
        self.fn = fn

    def onTouch(self, v, e):
        return self.fn(e)


class _Click(dynamic_proxy(View.OnClickListener)):
    def __init__(self, fn):
        super().__init__()
        self.fn = fn

    def onClick(self, v):
        self.fn()


class _Key(dynamic_proxy(View.OnKeyListener)):
    def __init__(self, fn):
        super().__init__()
        self.fn = fn

    def onKey(self, v, code, e):
        return self.fn(code, e)


class _Copied(dynamic_proxy(PixelCopy.OnPixelCopyFinishedListener)):
    def __init__(self, fn):
        super().__init__()
        self.fn = fn

    def onPixelCopyFinished(self, result):
        self.fn(result)


def color_hex(c: int) -> str:
    return "#%06X" % (c & 0xFFFFFF)  # getPixel отдаёт знаковый int ARGB


def color_rgb(c: int) -> str:
    return "rgb(%d, %d, %d)" % ((c >> 16) & 0xFF, (c >> 8) & 0xFF, c & 0xFF)


def is_light(c: int) -> bool:
    r, g, b = (c >> 16) & 0xFF, (c >> 8) & 0xFF, c & 0xFF
    return 0.299 * r + 0.587 * g + 0.114 * b > 150


assert color_hex(-1) == "#FFFFFF" and color_hex(0xFF102030 - (1 << 32)) == "#102030"
assert color_rgb(0xFF102030 - (1 << 32)) == "rgb(16, 32, 48)"
assert is_light(-1) and not is_light(0xFF000000 - (1 << 32))


class ColorPickerPlugin(BasePlugin):
    def on_plugin_load(self):
        self.overlay = None
        self.main = Handler(Looper.getMainLooper())
        self.add_menu_item(MenuItemData(
            menu_type=MenuItemType.CHAT_ACTION_MENU,
            text="Пипетка",
            icon="msg_theme",
            # пауза, чтобы меню успело закрыться и не попало в снимок экрана
            on_click=lambda ctx: self.main.postDelayed(_Run(self._capture), 350),
        ))

    def on_plugin_unload(self):
        if self.overlay:
            self.main.post(_Run(self.overlay))

    def _capture(self):
        try:
            window = get_last_fragment().getParentActivity().getWindow()
            decor = window.getDecorView()
            bmp = Bitmap.createBitmap(decor.getWidth(), decor.getHeight(), Bitmap.Config.ARGB_8888)
        except Exception as e:
            log(f"[Пипетка] нет окна: {e!r}")
            BulletinHelper.show_error("Пипетка: не удалось получить экран")
            return

        def fallback():
            # draw() не видит видео/SurfaceView, поэтому только запасной путь
            decor.draw(Canvas(bmp))
            self._show(decor, bmp)

        try:  # PixelCopy снимает реальное содержимое окна, включая видео
            PixelCopy.request(window, bmp, _Copied(
                lambda r: self._show(decor, bmp) if r == PixelCopy.SUCCESS else fallback()), self.main)
        except Exception as e:
            log(f"[Пипетка] PixelCopy недоступен: {e!r}")
            fallback()

    def _show(self, decor, bmp):
        ctx = decor.getContext()
        w, h = bmp.getWidth(), bmp.getHeight()
        dp = AndroidUtilities.dp
        mp = FrameLayout.LayoutParams(-1, -1)

        root = FrameLayout(ctx)
        img = ImageView(ctx)
        img.setScaleType(ImageView.ScaleType.FIT_XY)
        img.setImageBitmap(bmp)
        root.addView(img, mp)

        ring_size = dp(36)
        ring_bg = GradientDrawable()
        ring_bg.setShape(GradientDrawable.OVAL)
        ring = View(ctx)
        ring.setBackground(ring_bg)
        ring.setVisibility(View.INVISIBLE)
        root.addView(ring, FrameLayout.LayoutParams(ring_size, ring_size))

        label_bg = GradientDrawable()
        label_bg.setCornerRadius(dp(10))
        label = TextView(ctx)
        label.setTextSize(16)
        label.setPadding(dp(14), dp(8), dp(14), dp(8))
        label.setBackground(label_bg)
        label.setVisibility(View.INVISIBLE)
        root.addView(label, FrameLayout.LayoutParams(-2, -2))

        hint_bg = GradientDrawable()
        hint_bg.setCornerRadius(dp(10))
        hint_bg.setColor(Color.argb(200, 0, 0, 0))
        hint = TextView(ctx)
        hint.setText("Ведите пальцем по экрану, отпустите — HEX скопируется.\nНажмите сюда для отмены")
        hint.setTextColor(Color.WHITE)
        hint.setTextSize(13)
        hint.setGravity(Gravity.CENTER)
        hint.setPadding(dp(12), dp(8), dp(12), dp(8))
        hint.setBackground(hint_bg)
        hp = FrameLayout.LayoutParams(-2, -2, Gravity.TOP | Gravity.CENTER_HORIZONTAL)
        hp.topMargin = AndroidUtilities.statusBarHeight + dp(16)
        root.addView(hint, hp)

        def close():
            self.overlay = None
            decor.removeView(root)
            img.setImageBitmap(None)
            bmp.recycle()

        def on_touch(e):
            x = int(min(max(e.getX(), 0), w - 1))
            y = int(min(max(e.getY(), 0), h - 1))
            c = bmp.getPixel(x, y)
            contrast = Color.BLACK if is_light(c) else Color.WHITE
            ring_bg.setStroke(dp(3), contrast)
            ring.setTranslationX(x - ring_size / 2)
            ring.setTranslationY(y - ring_size / 2)
            label.setText(f"{color_hex(c)}\n{color_rgb(c)}")
            label.setTextColor(contrast)
            label_bg.setColor(c | 0xFF000000 - (1 << 32))  # без прозрачности
            label_bg.setStroke(dp(1), contrast)
            # подпись над пальцем, чтобы её было видно; у края экрана — под ним
            lw, lh = label.getWidth(), label.getHeight()
            ly = y - dp(64) - lh
            label.setTranslationX(min(max(x - lw / 2, dp(8)), w - lw - dp(8)))
            label.setTranslationY(ly if ly > dp(8) else y + dp(48))
            ring.setVisibility(View.VISIBLE)
            label.setVisibility(View.VISIBLE)
            if e.getAction() == MotionEvent.ACTION_UP:
                AndroidUtilities.addToClipboard(f"{color_hex(c)}, {color_rgb(c)}")
                BulletinHelper.show_success(f"Скопировано: {color_hex(c)}, {color_rgb(c)}")
                close()
            return True

        def on_key(code, e):
            if code != KeyEvent.KEYCODE_BACK:
                return False
            if e.getAction() == KeyEvent.ACTION_UP:
                close()
            return True

        root.setOnTouchListener(_Touch(on_touch))
        hint.setOnClickListener(_Click(close))
        root.setOnKeyListener(_Key(on_key))
        root.setFocusableInTouchMode(True)
        decor.addView(root, mp)
        root.requestFocus()  # иначе «Назад» закроет чат, а оверлей останется
        self.overlay = close
