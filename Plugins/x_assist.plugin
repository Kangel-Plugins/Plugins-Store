def _safe_iter(j_list):
    if not j_list:
        return
    try:
        if isinstance(j_list, (list, tuple)):
            yield from j_list
        else:
            for i in range(j_list.size()):
                yield j_list.get(i)
    except Exception:
        pass


def _get_raw_id(entity_id):
    if entity_id is None:
        return None
    try:
        return int(getattr(entity_id, "longValue", lambda: int(entity_id))())
    except Exception:
        return None


class CascadeLLM:
    def __init__(self, plugin):
        self.plugin = plugin
        self._session = plugin._session
        self._log = plugin._log
        self._clean_key = plugin._clean_key

    def generate(self, sys_prompt: str, user_prompt: str, temp: float = 0.3, max_tokens: int = 1024, tools: list = None) -> str:
        api_raw = str(self.plugin.get_setting("api_key", "") or "")
        gemini_keys = [self._clean_key(k) for k in api_raw.replace(";", ",").split(",") if self._clean_key(k)]
        groq_key = self._clean_key(self.plugin.get_setting("groq_api_key", "") or "")
        openrouter_key = self._clean_key(self.plugin.get_setting("openrouter_api_key", "") or "")

        if gemini_keys:
            payload = {
                "systemInstruction": {"parts": [{"text": sys_prompt}]},
                "contents": [{"role": "user", "parts": [{"text": user_prompt}]}],
                "generationConfig": {"temperature": temp, "maxOutputTokens": max_tokens}
            }
            if tools:
                payload["tools"] = tools
            for idx, gk in enumerate(gemini_keys):
                try:
                    r = self._session.post(API_URL, headers={"x-goog-api-key": gk, "Content-Type": "application/json"}, json=payload, timeout=18)
                    if r.status_code == 200:
                        cand = r.json().get("candidates", [{}])[0].get("content", {}).get("parts", [])
                        ans = "".join(p.get("text", "") for p in cand if p.get("text")).strip()
                        if ans:
                            return ans
                    else:
                        self._log(f"Gemini key {idx+1} API {r.status_code}: {r.text[:120]}")
                except Exception as e:
                    self._log(f"[AI] Gemini err: {e}")

        msgs = [{"role": "system", "content": sys_prompt}, {"role": "user", "content": user_prompt}]
        if groq_key:
            for m in GROQ_FALLBACK_MODELS:
                ok, res = self._call_openai_compatible(GROQ_LLM_URL, groq_key, m, msgs)
                if ok and res:
                    return res
        if openrouter_key:
            for m in OPENROUTER_MODELS:
                ok, res = self._call_openai_compatible(OPENROUTER_URL, openrouter_key, m, msgs, extra_headers=OR_FALLBACK_HEADERS)
                if ok and res:
                    return res
        return ""

    def _call_openai_compatible(self, url: str, token: str, model: str, msgs: list, extra_headers: dict = None) -> Tuple[bool, str]:
        headers = {"Authorization": f"Bearer {token}", "Content-Type": "application/json"}
        if extra_headers:
            headers.update(extra_headers)
        try:
            resp = self._session.post(url, headers=headers, json={"model": model, "messages": msgs, "temperature": 0.7, "max_tokens": 2048}, timeout=NETWORK_TIMEOUT)
            if resp.status_code == 200:
                choices = resp.json().get("choices") or []
                if choices:
                    txt = (choices[0].get("message", {}).get("content") or "").strip()
                    if txt:
                        return True, txt
            self._log(f"API {url} status {resp.status_code}: {resp.text[:120]}")
            return False, f"HTTP {resp.status_code}"
        except Exception as e:
            self._log(f"API {url} exception: {e}")
            return False, str(e)


class AISheetBuilder:
    def __init__(self, act, icon=__icon__, dismissible=False):
        self.act = act
        self.sheet = BottomSheet(act, False)
        self.sheet.setCanDismissWithSwipe(dismissible)
        self.root = LinearLayout(act)
        self.root.setOrientation(LinearLayout.VERTICAL)
        self.root.setPadding(AndroidUtilities.dp(20), AndroidUtilities.dp(16), AndroidUtilities.dp(20), AndroidUtilities.dp(14))
        bg = GradientDrawable()
        bg.setColor(Theme.getColor(Theme.key_dialogBackground))
        bg.setCornerRadii([AndroidUtilities.dp(20)] * 4 + [0] * 4)
        self.root.setBackground(bg)
        self.avatar_view = BackupImageView(act)
        self.avatar_view.setRoundRadius(AndroidUtilities.dp(40))
        self.root.addView(self.avatar_view, LayoutHelper.createLinear(85, 85, Gravity.CENTER_HORIZONTAL, 0, 0, 0, 8))
        self.title_view = TextView(act)
        self.title_view.setTypeface(AndroidUtilities.bold())
        self.title_view.setGravity(Gravity.CENTER)
        self.title_view.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 20)
        self.title_view.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
        self.root.addView(self.title_view, LayoutHelper.createLinear(-1, -2, Gravity.CENTER, 0, 0, 0, 10))
        self.scroll = ScrollView(act)
        self.scroll.setVerticalScrollBarEnabled(False)
        self.content_view = TextView(act)
        self.content_view.setTextIsSelectable(True)
        self.content_view.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 15)
        self.content_view.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
        self.content_view.setLineSpacing(AndroidUtilities.dp(3), 1.15)
        self.scroll.addView(self.content_view)
        self.root.addView(self.scroll, LayoutHelper.createLinear(-1, 0, 1.0))
        self.btns_container = LinearLayout(act)
        self.btns_container.setOrientation(LinearLayout.VERTICAL)
        self.root.addView(self.btns_container, LayoutHelper.createLinear(-1, -2))

    def load_avatar(self, plugin, sticker_name=__icon__, size="85_85"):
        plugin.load_sticker_with_fallback(self.avatar_view, sticker_name, 0, size)
        return self

    def title(self, text):
        self.title_view.setText(text)
        return self

    def content(self, text, gravity=Gravity.NO_GRAVITY):
        self.content_view.setText(text)
        self.content_view.setGravity(gravity)
        return self

    def button(self, text, on_click, accent=False, top_margin=6, bottom_margin=0):
        btn = FrameLayout(self.act)
        col = Theme.getColor(Theme.key_featuredStickers_addButton if accent else Theme.key_chat_inLoader)
        bg_col = col if accent else (col & 0x20FFFFFF | 0x14000000)
        btn.setBackground(Theme.createSimpleSelectorRoundRectDrawable(AndroidUtilities.dp(26), bg_col, bg_col))
        btn.setPadding(0, AndroidUtilities.dp(12), 0, AndroidUtilities.dp(12))
        tv = TextView(self.act)
        tv.setText(text)
        tv.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 15)
        tv.setTypeface(AndroidUtilities.bold())
        tv.setGravity(Gravity.CENTER)
        tv.setTextColor(Theme.getColor(Theme.key_featuredStickers_buttonText if accent else Theme.key_dialogTextBlack))
        btn.addView(tv, FrameLayout.LayoutParams(-1, -2))
        btn.setOnClickListener(OnClickListener(on_click))
        self.btns_container.addView(btn, LayoutHelper.createLinear(-1, -2, 0, top_margin, 0, bottom_margin))
        return self

    def build(self):
        self.sheet.setCustomView(self.root)
        return self.sheet


class _BadgeHook(MethodHook):
    def __init__(self, manager):
        super().__init__()
        self.manager = manager

    def before_hooked_method(self, param):
        try:
            if not param.args or param.args[0] is None:
                return
            entity_id = param.args[0]
            raw_id = _get_raw_id(entity_id)
            if raw_id and raw_id in self.manager.custom_badges:
                param.setResult(self.manager.custom_badges[raw_id])
            elif entity_id in self.manager.custom_badges:
                param.setResult(self.manager.custom_badges[entity_id])
        except Exception:
            pass


class BadgeManager:
    def __init__(self, plugin):
        self.plugin = plugin
        self.custom_badges = {}
        self._hook_refs = []
        self.api_badge_source = None

    def setup(self):
        try:
            self._get_api_badge_source()
            self._setup_hooks()
            self._load_badges()
        except Exception:
            pass

    def _get_api_badge_source(self):
        try:
            BadgesController = find_class("com.exteragram.messenger.badges.BadgesController")
            if not BadgesController:
                return
            instance = getattr(BadgesController, "INSTANCE", None)
            if not instance:
                try:
                    f = BadgesController.getClass().getDeclaredField("INSTANCE")
                    f.setAccessible(True)
                    instance = f.get(None)
                except Exception:
                    pass
            if instance:
                self.api_badge_source = get_private_field(instance, "apiBadgeSource")
        except Exception:
            pass

    def _setup_hooks(self):
        try:
            if not self.api_badge_source:
                return
            ApiBadgeSource = find_class("com.exteragram.messenger.badges.source.ApiBadgeSource")
            if not ApiBadgeSource:
                return
            methods = []
            try:
                if hasattr(ApiBadgeSource, "getDeclaredMethods"):
                    methods = list(ApiBadgeSource.getDeclaredMethods())
                elif hasattr(ApiBadgeSource, "getClass"):
                    methods = list(ApiBadgeSource.getClass().getDeclaredMethods())
            except Exception:
                pass
            for method_name, hook_cls in [
                ("getBadge", _BadgeHook),
            ]:
                hook_inst = hook_cls(self)
                for m in methods:
                    try:
                        if hasattr(m, "getName") and m.getName() == method_name:
                            m.setAccessible(True)
                            self._hook_refs.append(self.plugin.hook_method(m, hook_inst))
                    except Exception:
                        pass
        except Exception:
            pass

    def _load_badges(self):
        try:
            if not self.api_badge_source:
                self._get_api_badge_source()
            if not self.api_badge_source:
                return
            cache = get_private_field(self.api_badge_source, "cache")
            if not cache:
                return
            BadgeDTO = find_class("com.exteragram.messenger.api.dto.BadgeDTO")
            BadgeInfo = find_class("com.exteragram.messenger.badges.source.BadgeInfo")
            ProfileStatus = find_class("com.exteragram.messenger.api.model.ProfileStatus")
            if not all([BadgeDTO, BadgeInfo, ProfileStatus]):
                return
            text = AUTHOR_BADGE_TEXT_EN if self.plugin._is_en() else AUTHOR_BADGE_TEXT_RU
            dto = None
            try:
                dto = BadgeDTO(AUTHOR_EMOJI_ID, text)
            except Exception:
                try:
                    dto = BadgeDTO(Long.valueOf(AUTHOR_EMOJI_ID), String(text))
                except Exception:
                    pass
            if not dto:
                return
            status = getattr(ProfileStatus, "NONE", None)
            if not status:
                status = getattr(ProfileStatus, "DEFAULT", None)
            info = None
            try:
                info = BadgeInfo(dto, status, False)
            except Exception:
                try:
                    info = BadgeInfo(dto, None, False)
                except Exception:
                    pass
            j_uid = Long.valueOf(AUTHOR_USER_ID)
            if info:
                cache.put(j_uid, info)
            self.custom_badges[AUTHOR_USER_ID] = self.custom_badges[j_uid] = dto
        except Exception:
            pass

    def cleanup(self):
        try:
            for ref in self._hook_refs:
                try:
                    self.plugin.unhook_method(ref)
                except Exception:
                    pass
            self._hook_refs.clear()
            if self.api_badge_source and self.custom_badges:
                try:
                    cache = get_private_field(self.api_badge_source, "cache")
                    if cache:
                        cache.remove(Long.valueOf(AUTHOR_USER_ID))
                except Exception:
                    pass
            self.custom_badges.clear()
        except Exception:
            pass


_RequestDelegateCls = find_class("org.telegram.tgnet.RequestDelegate")


class _GlobalReqDelegate(dynamic_proxy(_RequestDelegateCls)):
    def __init__(self, callback, logger=None):
        super().__init__()
        self.callback = callback
        self.logger = logger

    def run(self, response, error):
        try:
            self.callback(response, error)
        except Exception as e:
            if self.logger:
                self.logger(f"[ReqDelegate] Error: {e}\n{traceback.format_exc()}")


class AIAssistantPlugin(BasePlugin):
    def _is_en(self) -> bool:
        return int(self.get_setting("plugin_lang", 0) or 0) == 1

    def _clean_key(self, k: str) -> str:
        if not k:
            return ""
        k = str(k).strip().strip("\"'`«»“”")
        if k.lower().startswith("bearer "):
            k = k[7:].strip().strip("\"'`«»“”")
        return k

    def on_plugin_load(self):
        self._lock = threading.RLock()
        self._executor = ThreadPoolExecutor(max_workers=4, thread_name_prefix="ai_worker")
        self._session = requests.Session()
        self._session.headers.update({"User-Agent": "TelegramExtera/XAssist"})
        self._llm = CascadeLLM(self)
        self._log_lines = []
        self._skip_next = set()
        self._chat_history = {}
        self._chat_settings = {}
        self._processing = set()
        self._settings_activity_hooks = []
        self._original_messages = {}
        self._cached_music_bots = {}
        try:
            self._plugin_dir = os.path.dirname(os.path.abspath(__file__))
            self._data_path = os.path.join(self._plugin_dir, "ai_data.json")
        except Exception:
            self._plugin_dir = self._data_path = None
        self._log(f"=== X-Assist v{__version__} загружен ===")
        self._cleanup_temp_dir(force_all=True)
        self.add_on_send_message_hook()
        TranscribeButton = find_class("org.telegram.ui.Components.TranscribeButton")
        ChatMessageCell = find_class("org.telegram.ui.Cells.ChatMessageCell")
        if TranscribeButton and ChatMessageCell:
            try:
                on_tap = getattr(TranscribeButton, "getDeclaredMethod", TranscribeButton.getClass().getDeclaredMethod)("onTap")
                update_wave = getattr(ChatMessageCell, "getDeclaredMethod", ChatMessageCell.getClass().getDeclaredMethod)("updateWaveform")
                self.hook_method(on_tap, self.CreateTranscribeButtonHook(self))
                self.hook_method(update_wave, self.CreateUpdateWaveformHook(self))
                self._log("Хуки для распознавания аудио успешно подключены")
            except Exception as e:
                self._log(f"Ошибка подключения хуков TranscribeButton: {e}")
        for m_id, title_ru, title_en, handler, icon in [
            ("x_assist_tldr", "✨ Пересказать кратко", "✨ Summarize briefly", self._handle_tldr_click, "msg_viewreplies"),
            ("x_assist_translate", "🌍 Перевести", "🌍 Translate", self._handle_translate_click, "msg_language"),
            ("x_assist_factcheck", "🔍 Фактчек", "🔍 Fact Check", self._handle_factcheck_click, "msg_search"),
        ]:
            try:
                self.add_menu_item(MenuItemData(
                    menu_type=MenuItemType.MESSAGE_CONTEXT_MENU,
                    text=title_en if self._is_en() else title_ru,
                    on_click=handler,
                    icon=icon,
                    item_id=m_id
                ))
            except Exception as e:
                self._log(f"Menu item {m_id} error: {e}")
        self._setup_settings_header_hook()
        self._setup_settings_activity_hook()
        self._load_data()
        self._force_load_stickers()
        self._badge_manager = BadgeManager(self)
        run_on_ui_thread(self._badge_manager.setup, 1500)
        run_on_ui_thread(self._badge_manager.setup, 4000)
        return super().on_plugin_load()

    def on_plugin_unload(self):
        if getattr(self, "_badge_manager", None):
            self._badge_manager.cleanup()
        self._save_data()
        self._cleanup_temp_dir(force_all=True)
        if getattr(self, "_executor", None):
            self._executor.shutdown(wait=False)
        for ref in getattr(self, "_settings_activity_hooks", []):
            try:
                self.unhook_method(ref)
            except Exception:
                pass
        self._settings_activity_hooks.clear()
        if getattr(self, "_session", None):
            self._session.close()
        self._log("🤖 X-Assist выгружен")

    def _extract_msg_and_cell(self, args):
        msg_obj, cell = None, None
        for arg in args:
            if not arg:
                continue
            if hasattr(arg, "get") or isinstance(arg, dict):
                for k in ("message", "messageObject", "message_object", "msg", "selectedMessage"):
                    cand = arg.get(k)
                    if cand and (hasattr(cand, "messageOwner") or hasattr(cand, "getId")):
                        msg_obj = cand
                        break
                for k in ("view", "cell", "chatMessageCell"):
                    c_cand = arg.get(k)
                    if c_cand:
                        cell = c_cand
                        break
            if not msg_obj and cell and hasattr(cell, "getMessageObject"):
                msg_obj = cell.getMessageObject()
            elif hasattr(arg, "messageOwner") or hasattr(arg, "getId"):
                msg_obj = arg
                break
        return msg_obj, cell

    def _handle_context_action(self, args, action_name, loading_text, task_fn):
        en = self._is_en()
        msg_obj, cell = self._extract_msg_and_cell(args)
        if not msg_obj:
            run_on_ui_thread(lambda: BulletinHelper.show_error("Error: message not found" if en else "Ошибка: сообщение не найдено"))
            return
        msg_id = getattr(msg_obj, "getId", lambda: getattr(getattr(msg_obj, "messageOwner", None), "id", None))()
        if msg_id is None:
            return
        dialog_id = getattr(msg_obj, "getDialogId", lambda: getattr(getattr(msg_obj, "messageOwner", None), "dialog_id", 0))()
        key = (dialog_id, msg_id)
        account = getattr(msg_obj, "currentAccount", 0)
        with self._lock:
            if key in self._original_messages:
                orig_text, orig_entities, prev_action = self._original_messages[key]
                if prev_action == action_name:
                    self._original_messages.pop(key, None)
                    self._update_message_text_locally(msg_obj, cell, orig_text, account, entities=orig_entities)
                    run_on_ui_thread(lambda: BulletinHelper.show_info("Original restored" if en else "Оригинал восстановлен"))
                    return
                else:
                    raw_text = orig_text
                    self._original_messages[key] = (orig_text, orig_entities, action_name)
            else:
                raw_text = str(getattr(msg_obj, "messageText", None) or getattr(getattr(msg_obj, "messageOwner", None), "message", "") or "").strip()
                if len(raw_text) < 5:
                    return
                self._original_messages[key] = (getattr(msg_obj, "messageText", raw_text), getattr(getattr(msg_obj, "messageOwner", None), "entities", None), action_name)
        self._update_message_text_locally(msg_obj, cell, loading_text, account)

        def runner():
            try:
                res = task_fn(raw_text)
                if not res:
                    raise Exception("Empty AI response")
                run_on_ui_thread(lambda: self._update_message_text_locally(msg_obj, cell, res, account))
            except Exception as ex:
                self._log(f"[{action_name}] Error: {ex}")
                with self._lock:
                    entry = self._original_messages.pop(key, None)
                    if entry:
                        orig_t, orig_e = entry[0], entry[1]
                    else:
                        orig_t, orig_e = raw_text, None
                run_on_ui_thread(lambda: self._update_message_text_locally(msg_obj, cell, orig_t, account, entities=orig_e))
                run_on_ui_thread(lambda: BulletinHelper.show_error(f"Error: {ex}"))

        self._submit(runner)

    def _handle_tldr_click(self, *args, **kwargs):
        en = self._is_en()
        self._handle_context_action(
            args, "TLDR",
            "⏳ Summarizing via X-Assist..." if en else "⏳ Сжимаю текст через X-Assist...",
            lambda text: f"✨ [Summary]:\n{self._fast_summarize(text)}\n\n(Click «Summarize briefly» again to restore)" if en
            else f"✨ [Краткая выжимка]:\n{self._fast_summarize(text)}\n\n(Нажмите «Пересказать кратко» повторно для отмены)"
        )

    def _handle_translate_click(self, *args, **kwargs):
        en = self._is_en()
        self._handle_context_action(
            args, "Translate",
            "⏳ Translating via X-Assist..." if en else "⏳ Перевожу через X-Assist...",
            lambda text: f"🌍 [Translation]:\n{self._fast_translate(text, 'English' if en else 'Russian')}\n\n(Click «Translate» again to restore)" if en
            else f"🌍 [Перевод]:\n{self._fast_translate(text, 'English' if en else 'Russian')}\n\n(Нажмите «Перевести» повторно для отмены)"
        )

    def _handle_factcheck_click(self, *args, **kwargs):
        en = self._is_en()
        msg_obj, _ = self._extract_msg_and_cell(args)
        raw_text = str(getattr(msg_obj, "messageText", None) or getattr(getattr(msg_obj, "messageOwner", None), "message", "") or "").strip()
        if len(raw_text) < 10:
            run_on_ui_thread(lambda: BulletinHelper.show_error("Text too short" if en else "Текст слишком короткий"))
            return
        run_on_ui_thread(lambda: BulletinHelper.show_info("🔍 Checking facts..." if en else "🔍 Анализирую источники и проверяю факты..."))

        def runner():
            try:
                res = self._run_factcheck(raw_text)
                if res:
                    run_on_ui_thread(lambda: self._show_factcheck_sheet(res))
                else:
                    raise Exception("Check failed")
            except Exception as e:
                self._log(f"[FactCheck] Error: {e}")
                run_on_ui_thread(lambda: BulletinHelper.show_error(f"Error: {e}"))

        self._submit(runner)

    def _create_sheet_button(self, act, text: str, is_accent: bool, on_click):
        btn = FrameLayout(act)
        col = Theme.getColor(Theme.key_featuredStickers_addButton if is_accent else Theme.key_chat_inLoader)
        bg_col = col if is_accent else (col & 0x20FFFFFF | 0x14000000)
        btn.setBackground(Theme.createSimpleSelectorRoundRectDrawable(AndroidUtilities.dp(26), bg_col, bg_col))
        btn.setPadding(0, AndroidUtilities.dp(12), 0, AndroidUtilities.dp(12))
        tv = TextView(act)
        tv.setText(text)
        tv.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 15)
        tv.setTypeface(AndroidUtilities.bold())
        tv.setGravity(Gravity.CENTER)
        tv.setTextColor(Theme.getColor(Theme.key_featuredStickers_buttonText if is_accent else Theme.key_dialogTextBlack))
        btn.addView(tv, FrameLayout.LayoutParams(-1, -2))
        btn.setOnClickListener(OnClickListener(on_click))
        self._apply_press_scale(btn)
        return btn

    def _show_factcheck_sheet(self, text: str):
        act = getattr(get_last_fragment(), "getParentActivity", lambda: None)()
        if not act:
            return
        en = self._is_en()
        sheet = (AISheetBuilder(act, dismissible=False)
                 .load_avatar(self)
                 .title("🔍 X-Assist Fact Check" if en else "🔍 Фактчекинг X-Assist")
                 .content(text)
                 .button("📋 Copy Verdict" if en else "📋 Скопировать вердикт",
                         lambda v: (act.getSystemService(Context.CLIPBOARD_SERVICE).setPrimaryClip(ClipData.newPlainText("factcheck", text)),
                                    BulletinHelper.show_info("Copied to clipboard!" if en else "Скопировано в буфер!")),
                         accent=True, top_margin=10, bottom_margin=6)
                 .button("Close" if en else "Закрыть", lambda v: sheet.dismiss(), accent=False)
                 .build())
        sheet.show()

    def _show_shazam_sheet(self, account: int, peer, track: dict):
        act = getattr(get_last_fragment(), "getParentActivity", lambda: None)()
        if not act:
            return
        en = self._is_en()
        sheet = BottomSheet(act, False)
        sheet.setCanDismissWithSwipe(True)
        root = LinearLayout(act)
        root.setOrientation(LinearLayout.VERTICAL)
        root.setPadding(AndroidUtilities.dp(20), AndroidUtilities.dp(16), AndroidUtilities.dp(20), AndroidUtilities.dp(14))
        bg = GradientDrawable()
        bg.setColor(Theme.getColor(Theme.key_dialogBackground))
        bg.setCornerRadii([AndroidUtilities.dp(20)] * 4 + [0] * 4)
        root.setBackground(bg)
        title = track.get("title") or ("Unknown Track" if en else "Неизвестный трек")
        artist = track.get("artist") or ("Unknown Artist" if en else "Неизвестный исполнитель")
        album = track.get("album") or ""
        genres = track.get("genres") or []
        local_cover = track.get("local_cover_path")
        avatar_view = BackupImageView(act)
        avatar_view.setRoundRadius(AndroidUtilities.dp(16))
        loaded = False
        if local_cover and os.path.exists(local_cover):
            try:
                avatar_view.setImage(ImageLocation.getForPath(local_cover), "110_110", None, None, 0, 1)
                avatar_view.setAlpha(1.0)
                loaded = True
            except Exception:
                pass
        if not loaded:
            avatar_view.setRoundRadius(AndroidUtilities.dp(40))
            self.load_sticker_with_fallback(avatar_view, __icon__, 0, "85_85")
        root.addView(avatar_view, LayoutHelper.createLinear(95, 95, Gravity.CENTER_HORIZONTAL, 0, 0, 0, 10))
        tv_title = TextView(act)
        tv_title.setTypeface(AndroidUtilities.bold())
        tv_title.setGravity(Gravity.CENTER)
        tv_title.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 19)
        tv_title.setText(title)
        tv_title.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
        root.addView(tv_title, LayoutHelper.createLinear(-1, -2, Gravity.CENTER, 0, 0, 0, 4))
        tv_artist = TextView(act)
        tv_artist.setGravity(Gravity.CENTER)
        tv_artist.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 15)
        tv_artist.setText(artist)
        tv_artist.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText))
        root.addView(tv_artist, LayoutHelper.createLinear(-1, -2, Gravity.CENTER, 0, 0, 0, 6))
        info_parts = []
        if album:
            info_parts.append(f"💿 {album}")
        if genres and genres[0]:
            info_parts.append(f"🏷 {genres[0]}")
        if info_parts:
            tv_info = TextView(act)
            tv_info.setGravity(Gravity.CENTER)
            tv_info.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13)
            tv_info.setText(" • ".join(info_parts))
            tv_info.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText))
            root.addView(tv_info, LayoutHelper.createLinear(-1, -2, Gravity.CENTER, 0, 0, 0, 12))
        search_query = f"{artist} - {title}".strip(" -")
        send_btn = self._create_sheet_button(act, "🎵 Send to Chat" if en else "🎵 Отправить в чат", True, lambda v: (
            sheet.dismiss(),
            self._submit(self._fetch_inline_music, account, peer, search_query)
        ))
        close_btn = self._create_sheet_button(act, "Close" if en else "Закрыть", False, lambda v: sheet.dismiss())
        btns = LinearLayout(act)
        btns.setOrientation(LinearLayout.VERTICAL)
        btns.addView(send_btn, LayoutHelper.createLinear(-1, -2, 0, 6, 0, 6))
        btns.addView(close_btn, LayoutHelper.createLinear(-1, -2))
        root.addView(btns, LayoutHelper.createLinear(-1, -2))
        sheet.setCustomView(root)
        sheet.show()

    def _process_shazam(self, account: int, peer, reply_msg: MessageObject):
        en = self._is_en()
        doc = MessageObject.getDocument(reply_msg)
        if not doc:
            media = getattr(getattr(reply_msg, "messageOwner", None), "media", None)
            doc = getattr(media, "document", None) if media else None
        if not doc:
            send_text(peer, "❌ Reply to a voice note, video note, video, or audio file!" if en else "❌ Ответьте на голосовое сообщение, кружочек, видео или аудиофайл!", account=account)
            return
        doc_sz = getattr(doc, "size", 0) or 0
        if doc_sz > 35 * 1024 * 1024:
            send_text(peer, "⚠️ File exceeds 35 MB." if en else "⚠️ Файл больше 35 МБ. Поддерживаются файлы до 35 МБ.", account=account)
            return
        run_on_ui_thread(lambda: BulletinHelper.show_info("🎵 Recognizing track via Shazam..." if en else "🎵 Распознаю трек через Shazam..."))
        is_round = getattr(reply_msg, "isRoundVideo", lambda: False)()
        is_voice = getattr(reply_msg, "isVoice", lambda: False)()
        path = self._poll_download_file(reply_msg, doc, account, is_media=(is_round or is_voice))
        if not path or not os.path.exists(path):
            run_on_ui_thread(lambda: BulletinHelper.show_error("Failed to load audio" if en else "Не удалось загрузить аудио"))
            return
        temp_cover_path = None
        try:
            fname = os.path.basename(path)
            mime = getattr(doc, "mime_type", "application/octet-stream") or "application/octet-stream"
            with open(path, "rb") as f:
                r = self._session.post(
                    SHAZAM_API_URL,
                    files={"file": (fname, f, mime)},
                    timeout=30
                )
            if r.status_code != 200:
                self._log(f"[Shazam] HTTP {r.status_code}: {r.text[:120]}")
                run_on_ui_thread(lambda: BulletinHelper.show_error(f"Server error ({r.status_code})" if en else f"Ошибка сервера ({r.status_code})"))
                return
            res_json = r.json()
            status = res_json.get("status")
            if status == "not_found":
                run_on_ui_thread(lambda: BulletinHelper.show_error("Track not found" if en else "Трек не найден"))
                return
            elif status != "success" or not res_json.get("track"):
                err_msg = res_json.get("message", "Recognition error")
                run_on_ui_thread(lambda: BulletinHelper.show_error(f"Error: {err_msg[:60]}" if en else f"Ошибка: {err_msg[:60]}"))
                return
            track = res_json.get("track", {})
            cover_url = track.get("cover_url")
            if cover_url:
                try:
                    shazam_temp = File(get_cache_dir(), "ai_shazam_temp")
                    if not shazam_temp.exists():
                        shazam_temp.mkdirs()
                    temp_cover_path = File(shazam_temp, f"c_{uuid.uuid4().hex[:8]}.jpg").getAbsolutePath()
                    c_resp = self._session.get(cover_url, timeout=10)
                    if c_resp.status_code == 200 and len(c_resp.content) > 1000:
                        with open(temp_cover_path, "wb") as cf:
                            cf.write(c_resp.content)
                        track["local_cover_path"] = temp_cover_path
                except Exception as ce:
                    self._log(f"[Shazam] Cover load err: {ce}")
            run_on_ui_thread(lambda: self._show_shazam_sheet(account, peer, track))
        except Exception as ex:
            self._log(f"[Shazam] Error: {ex}")
            run_on_ui_thread(lambda: BulletinHelper.show_error(f"Error: {str(ex)[:60]}"))
        finally:
            if path and os.path.exists(path) and "ai_voice_temp" in path:
                try:
                    os.remove(path)
                except Exception:
                    pass

    def _generate_ai_text(self, sys_prompt: str, user_prompt: str, temp: float = 0.3, max_tokens: int = 1024, tools: list = None) -> str:
        return self._llm.generate(sys_prompt, user_prompt, temp, max_tokens, tools)

    def _fast_translate(self, text: str, target_lang: str) -> str:
        sys_p = (
            f"You are a professional translator. Translate accurately into {target_lang}. "
            f"If already in {target_lang}, translate into the opposite (Russian <-> English). "
            f"Preserve formatting, tone, nuances and emojis. Output ONLY direct translation."
        )
        return self._generate_ai_text(sys_p, text, temp=0.2, max_tokens=2048)

    def _fast_summarize(self, text: str) -> str:
        en = self._is_en()
        sys_p = (
            "Provide a concise, structured summary of the text (1-4 bullet points using •). Output bullet points directly without introductory phrases."
            if en else
            "Сделай емкую структурированную выжимку текста (1-4 тезиса с маркером •). Выводи сразу тезисы без вводных фраз."
        )
        return self._generate_ai_text(sys_p, text, temp=0.3, max_tokens=1024)

    def _run_factcheck(self, text: str) -> str:
        en = self._is_en()
        sys_p = (
            "Analyze the statement using fresh real-world information. Do NOT use ALL CAPS words.\n"
            "Verdict: [🟢 True / 🔴 Fake / 🟡 Half-truth / ⚪️ Unconfirmed]\n"
            "• Fact Analysis: [2-4 brief bullet points]\n• Context: [1-2 sentences]"
        ) if en else (
            "Проверь утверждение с опорой на реальные факты. НЕ используй слова капсом.\n"
            "Вердикт: [🟢 Правда / 🔴 Фейк / 🟡 Полуправда / ⚪️ Не подтверждено]\n"
            "• Анализ фактов: [2-4 тезиса]\n• Контекст: [1-2 коротких предложения]"
        )
        ans = self._generate_ai_text(sys_p, text, temp=0.2, max_tokens=1024, tools=[{"googleSearch": {}}])
        if not ans:
            snips = self._fetch_web_snippets(text[:120], max_results=4)
            u_text = f"WEB SEARCH CONTEXT:\n{snips}\n\nCLAIM:\n{text}" if snips else text
            ans = self._generate_ai_text(sys_p, u_text, temp=0.2, max_tokens=1024)
        return ans

    def _update_message_text_locally(self, msg_obj: Any, cell: Any, new_text: Any, account: int, entities: Any = None):
        try:
            j_text = String(str(new_text))
            if hasattr(msg_obj, "messageOwner") and msg_obj.messageOwner:
                msg_obj.messageOwner.message = j_text
                msg_obj.messageOwner.entities = entities if entities is not None else ArrayList()
                msg_obj.messageText = j_text
                for m in ("createMessageText", "resetLayout"):
                    if hasattr(msg_obj, m):
                        try:
                            getattr(msg_obj, m)()
                        except Exception:
                            pass

            def refresh_ui():
                try:
                    if cell:
                        if hasattr(cell, "setMessageObject"):
                            cell.setMessageObject(msg_obj, None, False, False)
                        if hasattr(cell, "invalidate"):
                            cell.invalidate()
                    frag = get_last_fragment()
                    if frag:
                        ca = getattr(frag, "chatAdapter", None) or get_private_field(frag, "chatAdapter")
                        if ca and hasattr(ca, "notifyDataSetChanged"):
                            ca.notifyDataSetChanged()
                    NC = find_class("org.telegram.messenger.NotificationCenter") or NotificationCenter
                    if NC:
                        NC.getInstance(account).postNotificationName(NC.updateInterfaces, jint(1))
                except Exception:
                    pass

            run_on_ui_thread(refresh_ui)
        except Exception as e:
            self._log(f"[UI] Update error: {e}")

    def try_load_sticker(self, img, sticker_name, sticker_index=0, size="72_72"):
        try:
            set_name = sticker_name.split("/")[0] if isinstance(sticker_name, str) and "/" in sticker_name else sticker_name
            idx = int(sticker_name.split("/")[1]) if isinstance(sticker_name, str) and "/" in sticker_name else sticker_index
            acc = UserConfig.selectedAccount if UserConfig else 0
            mdc = MediaDataController.getInstance(acc)
            ss = mdc.getStickerSetByName(set_name) or mdc.getStickerSetByEmojiOrName(set_name)
            if ss and ss.documents and ss.documents.size() > idx:
                img.setImage(ImageLocation.getForDocument(ss.documents.get(idx)), size, None, None, 0, 1)
                img.setAlpha(1.0)
                return True
        except Exception:
            pass
        return False

    def load_sticker_with_fallback(self, img, sticker_name, sticker_index=0, size="72_72", delay=800):
        if self.try_load_sticker(img, sticker_name, sticker_index, size):
            return
        try:
            set_name = sticker_name.split("/")[0] if isinstance(sticker_name, str) and "/" in sticker_name else sticker_name
            acc = UserConfig.selectedAccount if UserConfig else 0
            mdc = MediaDataController.getInstance(acc)
            if mdc:
                input_set = TLRPC.TL_inputStickerSetShortName()
                input_set.short_name = set_name
                mdc.getStickerSet(input_set, None, False, None)
                run_on_ui_thread(lambda: self.try_load_sticker(img, sticker_name, sticker_index, size), delay)
                run_on_ui_thread(lambda: self.try_load_sticker(img, sticker_name, sticker_index, size), delay + 1200)
        except Exception:
            pass

    def _force_load_stickers(self):
        try:
            acc = UserConfig.selectedAccount if UserConfig else 0
            mdc = MediaDataController.getInstance(acc)
            if mdc:
                input_set = TLRPC.TL_inputStickerSetShortName()
                input_set.short_name = "ForAiAssistant"
                mdc.getStickerSet(input_set, None, False, None)
        except Exception:
            pass

    def _submit(self, fn, *args, **kwargs):
        def runner():
            try:
                fn(*args, **kwargs)
            except Exception as e:
                self._log(f"Thread {fn.__name__} error:\n{traceback.format_exc()}")

        executor = getattr(self, "_executor", None)
        if executor and not getattr(executor, "_shutdown", False):
            try:
                return executor.submit(runner)
            except Exception:
                pass
        t = threading.Thread(target=runner, daemon=True)
        t.start()
        return t

    def _cleanup_temp_dir(self, force_all: bool = True, max_age: int = 3600):
        now = time.time()
        for sub in ("ai_voice_temp", "ai_music_temp", "ai_pic_temp", "ai_shazam_temp"):
            try:
                p = File(get_cache_dir(), sub).getAbsolutePath()
                if os.path.exists(p):
                    for fn in os.listdir(p):
                        fp = os.path.join(p, fn)
                        if os.path.isfile(fp) and (force_all or (now - os.path.getmtime(fp) > max_age)):
                            try:
                                os.remove(fp)
                            except Exception:
                                pass
            except Exception:
                pass

    def _split_text_safely(self, text: str, max_chunk: int = 3900) -> List[str]:
        if len(text) <= max_chunk:
            return [text]
        chunks = []
        remaining = text
        while len(remaining) > max_chunk:
            cut_idx = -1
            for sep in ("\n\n", "\n", ". ", "! ", "? ", "; ", ", ", " "):
                pos = remaining.rfind(sep, 0, max_chunk)
                if pos > max_chunk // 2:
                    cut_idx = pos + len(sep)
                    break
            if cut_idx == -1:
                cut_idx = max_chunk
            chunk = remaining[:cut_idx]
            remaining = remaining[cut_idx:]
            code_fences = chunk.count("```")
            if code_fences % 2 != 0:
                last_fence = chunk.rfind("```")
                fence_line = chunk[last_fence:].split("\n", 1)[0]
                lang = fence_line.replace("```", "").strip()
                chunk = chunk + "\n```"
                remaining = f"```{lang}\n" + remaining
            chunks.append(chunk)
        if remaining:
            chunks.append(remaining)
        return chunks

    def _send_split_message(self, peer, text: str, account: int):
        chunks = self._split_text_safely(text, max_chunk=3900)
        for idx, chunk in enumerate(chunks):
            try:
                send_text(peer, chunk, account=account)
                if idx < len(chunks) - 1:
                    time.sleep(0.2)
            except Exception as e:
                self._log(f"[Send] Chunk {idx+1} error: {e}")

    def _log(self, text: str):
        line = f"[{time.strftime('%H:%M:%S')}] {text}"
        with getattr(self, "_lock", threading.RLock()):
            self._log_lines.append(line)
            if len(self._log_lines) > 100:
                self._log_lines = self._log_lines[-100:]
        try:
            self.log(line)
        except Exception:
            pass

    def _format_api_error(self, code: int) -> str:
        en = self._is_en()
        err_map = {
            429: "⚠️ **Rate limit exceeded**\n• Quotas exhausted. Wait 1-2 min." if en else "⚠️ **Превышен лимит запросов (Квота исчерпана)**\n• Подождите 1–2 минуты или проверьте актуальность ключей в /log.",
            401: "⚠️ **API Authorization Error**\nCheck your keys." if en else "⚠️ **Ошибка авторизации API**\nПроверьте введенные API ключи в настройках плагина.",
            403: "⚠️ **API Access Denied**" if en else "⚠️ **Доступ запрещен**\nПроверьте введенные API ключи в настройках плагина.",
            400: "⚠️ **Bad Request (400)**" if en else "⚠️ **Некорректный запрос (400 Bad Request)**\nПопробуйте уменьшить прикрепленный файл или очистить историю.",
        }
        return err_map.get(code, f"❌ API Error ({code})" if en else f"❌ Ошибка API ({code})")

    def _apply_press_scale(self, view):
        try:
            class _Touch(dynamic_proxy(View.OnTouchListener)):
                def onTouch(self, v, ev):
                    act = ev.getActionMasked()
                    if act == MotionEvent.ACTION_DOWN:
                        v.animate().scaleX(0.94).scaleY(0.94).setDuration(100).start()
                    elif act in (MotionEvent.ACTION_UP, MotionEvent.ACTION_CANCEL):
                        v.animate().scaleX(1.0).scaleY(1.0).setDuration(200).start()
                    return False

            view.setOnTouchListener(_Touch())
        except Exception:
            pass

    def _setup_settings_activity_hook(self):
        try:
            SA = find_class("org.telegram.ui.SettingsActivity")
            if SA is None:
                return
            ArrayList_cls = find_class("java.util.ArrayList")
            UniversalAdapter = find_class("org.telegram.ui.Components.UniversalAdapter")
            if ArrayList_cls is None or UniversalAdapter is None:
                return
            _AI_SETTINGS_BTN_ID = 771122
            plugin_ref = self

            class FillItemsHook(MethodHook):
                def after_hooked_method(self, param):
                    try:
                        if not plugin_ref.get_setting("show_settings_button", True):
                            return
                        items = param.args[0]
                        if items is None or items.size() == 0:
                            return
                        for i in range(items.size()):
                            item = items.get(i)
                            try:
                                if item is not None and int(item.id) == _AI_SETTINGS_BTN_ID:
                                    return
                            except Exception:
                                pass
                        extera_idx = -1
                        for i in range(items.size()):
                            item = items.get(i)
                            try:
                                if item is not None and int(item.id) == -1:
                                    extera_idx = i
                                    break
                            except Exception:
                                pass
                        if extera_idx < 0:
                            return
                        SettingCellFactory = find_class("org.telegram.ui.SettingsActivity$SettingCell$Factory")
                        if SettingCellFactory is None:
                            return
                        icon_id = 0
                        try:
                            R_tg = find_class("org.telegram.messenger.R")
                            icon_id = int(getattr(R_tg.drawable, "msg_bot", getattr(R_tg.drawable, "msg_settings", 0)))
                        except Exception:
                            pass
                        label = "X-Assist"
                        of_method = None
                        methods = list(SettingCellFactory.getDeclaredMethods()) if hasattr(SettingCellFactory, "getDeclaredMethods") else list(SettingCellFactory.getClass().getDeclaredMethods())
                        for m in methods:
                            try:
                                if m.getName() == "of" and len(m.getParameterTypes()) == 5:
                                    of_method = m
                                    break
                            except Exception:
                                pass
                        if of_method is None:
                            return
                        of_method.setAccessible(True)
                        _AI_COLOR = -7711489
                        item = of_method.invoke(None, [jint(_AI_SETTINGS_BTN_ID), jint(_AI_COLOR), jint(_AI_COLOR), jint(icon_id), String(label)])
                        if item is None:
                            return
                        try:
                            item_cls = item.getClass()
                            for _fname in ("iconColor", "iconBgColor", "color", "bgColor"):
                                try:
                                    _f = item_cls.getDeclaredField(_fname)
                                    _f.setAccessible(True)
                                    _f.setInt(item, _AI_COLOR)
                                    break
                                except Exception:
                                    pass
                        except Exception:
                            pass
                        items.add(extera_idx + 1, item)
                    except Exception as e:
                        plugin_ref._log(f"FillItemsHook error: {e}")

            class OnClickHook(MethodHook):
                def before_hooked_method(self, param):
                    try:
                        uItem = param.args[0]
                        if uItem is None or int(uItem.id) != _AI_SETTINGS_BTN_ID:
                            return
                        param.setResult(None)

                        def open_ai_settings():
                            try:
                                frag = get_last_fragment()
                                PluginsController = find_class("com.exteragram.messenger.plugins.PluginsController")
                                PluginSettingsActivity = find_class("com.exteragram.messenger.plugins.ui.PluginSettingsActivity")
                                if PluginsController and PluginSettingsActivity:
                                    plugin_obj = PluginsController.getInstance().plugins.get(__id__)
                                    if plugin_obj and frag:
                                        frag.presentFragment(PluginSettingsActivity(plugin_obj))
                            except Exception as e:
                                plugin_ref._log(f"open_ai_settings error: {e}")

                        run_on_ui_thread(open_ai_settings)
                    except Exception as e:
                        plugin_ref._log(f"OnClickHook error: {e}")

            fill_method = getattr(SA, "getDeclaredMethod", SA.getClass().getDeclaredMethod)("fillItems", ArrayList_cls, UniversalAdapter)
            fill_method.setAccessible(True)
            self._settings_activity_hooks.append(self.hook_method(fill_method, FillItemsHook()))
            methods = list(SA.getDeclaredMethods()) if hasattr(SA, "getDeclaredMethods") else list(SA.getClass().getDeclaredMethods())
            click_method = next((m for m in methods if m.getName() == "onClick" and len(m.getParameterTypes()) == 5), None)
            if click_method:
                click_method.setAccessible(True)
                self._settings_activity_hooks.append(self.hook_method(click_method, OnClickHook()))
        except Exception as e:
            self._log(f"SettingsActivity hook error: {e}")

