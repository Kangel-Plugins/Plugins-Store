    def _send_chosen_inline_track(self, account: int, peer, item: dict):
        bot_result, qid = item.get("bot_result"), item.get("query_id", 0)
        en = self._is_en()
        cm = find_class("org.telegram.tgnet.ConnectionsManager").getInstance(account)
        mc = find_class("org.telegram.messenger.MessagesController").getInstance(account)
        u_cfg = find_class("org.telegram.messenger.UserConfig").getInstance(account)
        if not all([cm, mc, u_cfg, u_cfg.getCurrentUser()]):
            return
        try:
            my_peer = mc.getInputPeer(u_cfg.getCurrentUser())
            tgt_peer = mc.getInputPeer(peer)
            transit = TLRPC.TL_messages_sendInlineBotResult()
            transit.silent = transit.background = True
            transit.hide_via = False
            transit.peer = my_peer
            transit.random_id = int(uuid.uuid4().int & 0x7FFFFFFFFFFFFFFF)
            transit.query_id = int(qid)
            res_id = getattr(bot_result, "id", None)
            transit.id = String(str(res_id) if res_id is not None else "")

            def on_transit(resp, err):
                if err or not resp:
                    self._send_direct_fallback(cm, tgt_peer, bot_result, qid)
                    return
                msg_id = None
                if hasattr(resp, "updates") and resp.updates:
                    for u in _safe_iter(resp.updates):
                        m = getattr(u, "message", None)
                        if m and getattr(m, "id", 0):
                            msg_id = int(m.id)
                            break
                if not msg_id and hasattr(resp, "id"):
                    msg_id = int(resp.id)
                if not msg_id:
                    self._send_direct_fallback(cm, tgt_peer, bot_result, qid)
                    return
                run_on_ui_thread(lambda: BulletinHelper.show_info("🎵 Sending track to chat..." if en else "🎵 Отправляю трек в чат..."))
                fwd = TLRPC.TL_messages_forwardMessages()
                fwd.drop_author = True
                fwd.drop_media_captions = True
                fwd.silent = False
                fwd.background = False
                fwd.with_my_score = False
                fwd.from_peer, fwd.to_peer = my_peer, tgt_peer
                ids, r_ids = ArrayList(), ArrayList()
                ids.add(jint(msg_id))
                r_ids.add(Long.valueOf(int(uuid.uuid4().int & 0x7FFFFFFFFFFFFFFF)))
                fwd.id, fwd.random_id = ids, r_ids

                def on_fwd(f_resp, f_err):
                    if f_err:
                        self._send_direct_fallback(cm, tgt_peer, bot_result, qid)
                    try:
                        del_req = TLRPC.TL_messages_deleteMessages()
                        del_req.revoke = True
                        del_ids = ArrayList()
                        del_ids.add(jint(msg_id))
                        del_req.id = del_ids
                        cm.sendRequest(del_req, _GlobalReqDelegate(lambda r, e: None))
                    except Exception:
                        pass

                cm.sendRequest(fwd, _GlobalReqDelegate(on_fwd, self._log))

            cm.sendRequest(transit, _GlobalReqDelegate(on_transit, self._log))
        except Exception as e:
            self._log(f"[Music] Transit err: {e}")
            self._send_direct_fallback(cm, mc.getInputPeer(peer), bot_result, qid)

    def _send_direct_fallback(self, cm, target_peer, bot_result, qid):
        try:
            req = TLRPC.TL_messages_sendInlineBotResult()
            req.peer = target_peer
            req.random_id = int(uuid.uuid4().int & 0x7FFFFFFFFFFFFFFF)
            req.query_id = int(qid)
            res_id = getattr(bot_result, "id", None)
            req.id = String(str(res_id) if res_id is not None else "")
            cm.sendRequest(req, _GlobalReqDelegate(lambda r, e: None, self._log))
        except Exception:
            pass

