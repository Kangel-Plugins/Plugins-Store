    def _create_settings_header(self, context):
        try:
            container = FrameLayout(context)
            try:
                if StarParticlesView:
                    particlesView = StarParticlesView(context)
                    particlesView.doNotFling = True
                    particlesView.setClipWithGradient()
                    try:
                        purple_key = None
                        avatar_keys = getattr(Theme, "keys_avatar_name", None) or getattr(Theme, "keys_avatar_background", None)
                        if avatar_keys and len(avatar_keys) > 2:
                            purple_key = avatar_keys[2]
                        if purple_key is not None:
                            particlesView.drawable.colorKey = purple_key
                        elif hasattr(Theme, "key_premiumGradient2"):
                            particlesView.drawable.colorKey = Theme.key_premiumGradient2
                        else:
                            particlesView.drawable.colorKey = Theme.key_premiumGradient1
                    except Exception:
                        particlesView.drawable.colorKey = Theme.key_premiumGradient1
                    particlesView.drawable.isCircle = False
                    particlesView.drawable.roundEffect = False
                    particlesView.drawable.useRotate = False
                    particlesView.drawable.useBlur = True
                    particlesView.drawable.checkBounds = True
                    particlesView.drawable.useScale = True
                    particlesView.drawable.startFromCenter = True
                    particlesView.drawable.centerOffsetY = AndroidUtilities.dp(24)
                    particlesView.drawable.size1 = 17
                    particlesView.drawable.size2 = 18
                    particlesView.drawable.size3 = 19
                    particlesView.drawable.init()
                    try:
                        _INDIGO_COLOR = -10262799
                        p = getattr(particlesView.drawable, "paint", None) or self._get_private_field(particlesView.drawable, "paint")
                        if p:
                            p.setColorFilter(PorterDuffColorFilter(jint(_INDIGO_COLOR), PorterDuff.Mode.SRC_IN))
                    except Exception:
                        pass
                    container.addView(particlesView, LayoutHelper.createFrame(-1, 230, Gravity.CENTER_HORIZONTAL | Gravity.TOP, 0, -10, 0, 0))
            except Exception:
                pass
            ml = LinearLayout(context)
            ml.setOrientation(LinearLayout.VERTICAL)
            ml.setGravity(Gravity.CENTER)
            ml.setPadding(AndroidUtilities.dp(20), AndroidUtilities.dp(20), AndroidUtilities.dp(20), AndroidUtilities.dp(16))
            stk = BackupImageView(context)
            stk.setRoundRadius(AndroidUtilities.dp(45))
            if not self.try_load_sticker(stk, __icon__, 0, "130_130"):
                self.load_sticker_with_fallback(stk, __icon__, 0, "130_130")
            ml.addView(stk, LayoutHelper.createLinear(110, 110, Gravity.CENTER, 0, 0, 0, 12))
            t = TextView(context)
            t.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText))
            t.setTypeface(AndroidUtilities.bold())
            t.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 22)
            t.setText("X-Assist")
            t.setGravity(Gravity.CENTER)
            ml.addView(t, LayoutHelper.createLinear(-1, -2, Gravity.CENTER, 0, 0, 0, 4))
            sub = TextView(context)
            sub.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText))
            sub.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 14)
            sub.setText(f"Version {__version__} • Your personal AI" if self._is_en() else f"Версия {__version__} • Твой персональный AI")
            sub.setGravity(Gravity.CENTER)
            ml.addView(sub, LayoutHelper.createLinear(-1, -2, Gravity.CENTER))
            container.addView(ml, LayoutHelper.createFrame(-1, -2, Gravity.CENTER))
            return container
        except Exception:
            return None

    def _setup_settings_header_hook(self):
        try:
            PSA = find_class("com.exteragram.messenger.plugins.ui.PluginSettingsActivity")
            if not PSA:
                return
            methods = list(PSA.getDeclaredMethods()) if hasattr(PSA, "getDeclaredMethods") else list(PSA.getClass().getDeclaredMethods())
            method = next((m for m in methods if m.getName() == "fillItems" and len(m.getParameterTypes()) == 2), None)
            if not method:
                return
            method.setAccessible(True)
            plugin = self

            class HeaderHook(MethodHook):
                def after_hooked_method(self, param):
                    try:
                        items = param.args[0]
                        if not items or items.size() == 0:
                            return
                        for i in range(items.size()):
                            it = items.get(i)
                            if hasattr(it, "settingItem") and str(it.settingItem) == "x_assist_header":
                                return
                        act = param.thisObject
                        p_obj = plugin._get_private_field(act, "plugin")
                        if not p_obj or str(p_obj.getId()) != __id__ or plugin._get_private_field(act, "createSubFragmentCallback") or plugin._get_private_field(act, "searching"):
                            return
                        hdr = plugin._create_settings_header(act.getContext())
                        if hdr:
                            it = UItem.asCustom(hdr)
                            it.settingItem = HeaderSetting("x_assist_header") if HeaderSetting else None
                            try:
                                it.setTransparent(True)
                            except Exception:
                                pass
                            items.add(0, it)
                            items.add(1, UItem.asShadow())
                    except Exception:
                        pass

            self.hook_method(method, HeaderHook())
        except Exception as e:
            self._log(f"Header hook err: {e}")

    def _open_url(self, url: str):
        try:
            frag = get_last_fragment()
            if frag and frag.getParentActivity():
                Browser.openUrl(frag.getParentActivity(), Uri.parse(url), True, True, True, None, None, False, False, False)
        except Exception:
            pass

    def _fetch_web_snippets(self, query: str, max_results: int = 5) -> str:
        try:
            h = {"User-Agent": "Mozilla/5.0", "Accept-Language": "ru,uk,en;q=0.9"}
            resp = self._session.post("https://html.duckduckgo.com/html/", data={"q": query}, headers=h, timeout=12)
            if resp.status_code == 200:
                snips = re.findall(r'<a[^>]*class="result__snippet"[^>]*>(.*?)</a>', resp.text, re.DOTALL)
                res = [f"• {html.unescape(re.sub(r'<[^>]+>', '', s)).strip()}" for s in snips[:max_results]]
                return "\n".join(res)
        except Exception:
            pass
        return ""

    class CreateUpdateWaveformHook(MethodHook):
        def __init__(self, plugin):
            super().__init__()
            self.plugin = plugin

        def after_hooked_method(self, param):
            if self.plugin.get_setting("premium_stt", True):
                set_private_field(param.thisObject, "useTranscribeButton", True)

    class CreateTranscribeButtonHook(MethodReplacement):
        def __init__(self, plugin):
            super().__init__()
            self.plugin = plugin

        def replace_hooked_method(self, param):
            if self.plugin.get_setting("premium_stt", True):
                self.plugin._submit(self.onTap, param)

        def onTap(self, param):
            this = param.thisObject
            parent = get_private_field(this, "parent")
            if not parent:
                return
            should_open = get_private_field(this, "shouldBeOpen")
            loading = get_private_field(this, "loading")
            to_open = not should_open
            if not should_open:
                if not loading:
                    this.setLoading(True, True)
                else:
                    return
            else:
                this.setOpen(False, True)
                this.setLoading(False, True)
                set_private_field(this, "pressed", False)
            self.transcribePressed(param, parent.getMessageObject(), to_open)

        def transcribePressed(self, param, msg_obj, open_mode):
            token = self.plugin._clean_key(self.plugin.get_setting("groq_api_key", "") or "")
            this = param.thisObject
            en = self.plugin._is_en()
            if not token:
                run_on_ui_thread(lambda: (this.setLoading(False, True), BulletinHelper.show_error("Specify Groq API key!" if en else "Укажите Groq API токен!")))
                return
            if not msg_obj or not msg_obj.messageOwner or not msg_obj.isSent():
                run_on_ui_thread(lambda: this.setLoading(False, True))
                return
            TB = find_class("org.telegram.ui.Components.TranscribeButton")
            MS = find_class("org.telegram.messenger.MessagesStorage")
            DO = find_class("org.telegram.messenger.DialogObject")
            MC = find_class("org.telegram.messenger.MessagesController")
            NC = find_class("org.telegram.messenger.NotificationCenter")
            acc, owner = msg_obj.currentAccount, msg_obj.messageOwner
            peer = MC.getInstance(acc).getInputPeer(owner.peer_id)
            dialog_id, msg_id = DO.getPeerDialogId(peer), owner.id
            if open_mode:
                if owner.voiceTranscription is not None and owner.voiceTranscriptionFinal:
                    TB.openVideoTranscription(msg_obj)
                    owner.voiceTranscriptionOpen = True
                    MS.getInstance(acc).updateMessageVoiceTranscriptionOpen(dialog_id, msg_id, owner)
                    run_on_ui_thread(lambda: NC.getInstance(acc).postNotificationName(NC.voiceTranscriptionUpdate, msg_obj, None, None, True, True))
                    return
                owner.voiceTranscriptionId = msg_id
                doc = getattr(getattr(owner, "media", None), "document", None)
                path = self.plugin._poll_download_file(msg_obj, doc, acc, is_media=True)
                if not path:
                    run_on_ui_thread(lambda: (this.setLoading(False, True), BulletinHelper.show_error("Failed to load audio" if en else "Не удалось скачать аудио")))
                    return
                try:
                    text = self.plugin._transcribe_audio(path)
                    if self.plugin.get_setting("llama_cleanup", False):
                        cleaned = self.plugin._cleanup_llama(text, token)
                        if cleaned:
                            text = "✨ " + cleaned
                    TB.openVideoTranscription(msg_obj)
                    owner.voiceTranscriptionOpen = owner.voiceTranscriptionFinal = True
                    MS.getInstance(acc).updateMessageVoiceTranscription(dialog_id, msg_id, text, owner)
                    run_on_ui_thread(lambda: this.finishTranscription(msg_obj, msg_id, text))
                except Exception as e:
                    run_on_ui_thread(lambda: (this.setLoading(False, True), BulletinHelper.show_error(f"Error: {str(e)[:100]}")))
                finally:
                    if path and os.path.exists(path) and "ai_voice_temp" in path:
                        try:
                            os.remove(path)
                        except Exception:
                            pass
            else:
                owner.voiceTranscriptionOpen = False
                MS.getInstance(acc).updateMessageVoiceTranscriptionOpen(dialog_id, msg_id, owner)
                run_on_ui_thread(lambda: NC.getInstance(acc).postNotificationName(NC.voiceTranscriptionUpdate, msg_obj, None, None, False, None))

    def _cleanup_llama(self, text, api_key):
        payload = {
            "model": GROQ_CLEANUP_MODEL,
            "max_tokens": 2048,
            "temperature": 0,
            "messages": [
                {"role": "system", "content": "Correct punctuation, speech errors without altering meaning. Output ONLY text."},
                {"role": "user", "content": text}
            ]
        }
        r = self._session.post(GROQ_LLM_URL, headers={"Authorization": f"Bearer {api_key}", "Content-Type": "application/json"}, json=payload, timeout=25)
        return r.json()["choices"][0]["message"]["content"].strip() if r.status_code == 200 else None

    def _resolve_dialog_id(self, peer) -> int:
        if isinstance(peer, int):
            return peer
        for attr in ("user_id", "chat_id", "channel_id", "peer_id"):
            val = getattr(peer, attr, None)
            if val is not None:
                try:
                    return int(val)
                except Exception:
                    pass
        return 0

    def _chat_key(self, peer) -> str:
        d = self._resolve_dialog_id(peer)
        return str(d) if d else f"peer:{str(peer)}"

    def _get_private_field(self, obj, name):
        cls = getattr(obj, "getClass", lambda: None)()
        while cls is not None:
            try:
                f = cls.getDeclaredField(name)
                f.setAccessible(True)
                return f.get(obj)
            except Exception:
                cls = cls.getSuperclass()
        return None

    def _load_data(self):
        try:
            if self._data_path and os.path.exists(self._data_path):
                with open(self._data_path, "r", encoding="utf-8") as f:
                    data = json.load(f)
                with self._lock:
                    for p, msgs in data.get("history", {}).items():
                        clean_msgs = [m for m in msgs if not str(m).startswith(("Собеседник:", "Собеседник :"))]
                        self._chat_history[p] = deque(clean_msgs, maxlen=HISTORY_MAXLEN)
                self._chat_settings = data.get("settings", {})
        except Exception:
            pass

    def _save_data(self):
        try:
            if self._data_path and self.get_setting("auto_save", True):
                with self._lock:
                    data = {"history": {k: list(v) for k, v in self._chat_history.items()}, "settings": dict(self._chat_settings)}
                with open(self._data_path, "w", encoding="utf-8") as f:
                    json.dump(data, f, ensure_ascii=False, indent=2)
        except Exception:
            pass

    def _remember(self, key, who: str, text: str):
        if key and text:
            with self._lock:
                self._chat_history.setdefault(str(key), deque(maxlen=HISTORY_MAXLEN)).append(f"{who}: {text}")

    def _get_chat_memory(self, key) -> int:
        with self._lock:
            val = self._chat_settings.get(str(key), {}).get("memory", self.get_setting("default_memory", 1))
            return [10, 20, 30, 50][val] if isinstance(val, int) and 0 <= val < 4 else 20

    def _poll_download_file(self, msg_obj, doc, account: int, is_media: bool = False) -> str:
        try:
            fl = FileLoader.getInstance(account)
            owner = msg_obj.messageOwner
            attach = getattr(owner, "attachPath", None)
            if attach and os.path.exists(attach) and os.path.getsize(attach) > 0:
                return attach
            if is_media:
                temp_dir = File(get_cache_dir(), "ai_voice_temp")
                if not temp_dir.exists():
                    temp_dir.mkdirs()
                ext = ".mp4" if getattr(msg_obj, "isRoundVideo", lambda: False)() else ".ogg"
                target = File(temp_dir, f"m_{uuid.uuid4().hex[:8]}{ext}").getAbsolutePath()
                if doc:
                    try:
                        if hasattr(doc, "mime_type"):
                            fl.loadFile(doc, msg_obj, 1, 0)
                    except Exception:
                        pass
                for _ in range(35):
                    time.sleep(0.35)
                    f_msg = fl.getPathToMessage(owner)
                    if f_msg and f_msg.exists() and f_msg.length() > 0:
                        if is_media:
                            shutil.copyfile(f_msg.getAbsolutePath(), target)
                            return target
                        return str(f_msg.getAbsolutePath())
                if doc:
                    for force in (True, False):
                        try:
                            f_att = fl.getPathToAttach(doc, force)
                            if f_att and f_att.exists() and f_att.length() > 0:
                                return str(f_att.getAbsolutePath())
                        except Exception:
                            pass
        except Exception as e:
            self._log(f"[Download] Poll err: {e}")
        return None

    def _download_photo_sync(self, msg_obj: MessageObject, account: int):
        try:
            media = getattr(msg_obj.messageOwner, "media", None)
            photo = getattr(media, "photo", None) if media else None
            doc = MessageObject.getDocument(msg_obj)
            if doc and getattr(doc, "mime_type", "").startswith("image/"):
                return self._poll_download_file(msg_obj, doc, account), doc.mime_type
            if photo and hasattr(photo, "sizes"):
                valid = [s for s in _safe_iter(photo.sizes) if s and "Stripped" not in s.getClass().getSimpleName()]
                if valid:
                    best = max(valid, key=lambda s: getattr(s, "w", 0) * getattr(s, "h", 0))
                    try:
                        FileLoader.getInstance(account).loadFile(ImageLocation.getForPhoto(best, photo), msg_obj, "jpg", 1, 1)
                    except Exception:
                        pass
                    return self._poll_download_file(msg_obj, best, account), "image/jpeg"
        except Exception:
            pass
        return None, None

    def _get_document_info(self, msg: MessageObject) -> Tuple[Any, str, str, int]:
        doc = MessageObject.getDocument(msg)
        if not doc:
            return None, "", "", 0
        name = "document"
        for attr in _safe_iter(getattr(doc, "attributes", None)):
            if attr and "DocumentAttributeFilename" in attr.getClass().getSimpleName():
                name = getattr(attr, "file_name", "document") or "document"
                break
        return doc, name, getattr(doc, "mime_type", "application/octet-stream") or "application/octet-stream", getattr(doc, "size", 0)

    def _transcribe_audio(self, path: str) -> str:
        token = self._clean_key(self.get_setting("groq_api_key", "") or "")
        lang_idx = max(0, min(int(self.get_setting("language", 2) or 2), len(LANGUAGE_CODES) - 1))
        lang_code = LANGUAGE_CODES[lang_idx]
        form = {"model": (None, GROQ_WHISPER_MODEL), "response_format": (None, "verbose_json"), "temperature": (None, "0")}
        if lang_code != "auto":
            form["language"] = (None, lang_code)
        with open(path, "rb") as f:
            form["file"] = (os.path.basename(path), f, "audio/ogg")
        r = self._session.post(GROQ_WHISPER_URL, headers={"Authorization": f"Bearer {token}"}, files=form, timeout=90)
        if r.status_code != 200:
            raise Exception(f"Whisper error: {r.status_code}")
        data = r.json()
        segs = data.get("segments", [])
        text = " ".join((s.get("text") or "").strip() for s in segs if s.get("no_speech_prob", 1.0) < 0.6).strip() if segs else (data.get("text") or "").strip()
        if not text:
            raise Exception("No speech recognized")
        return text

    def _expand_prompt(self, prompt: str) -> str:
        en_prompt = self._fast_translate(prompt, "English") if not prompt.isascii() else prompt
        if not self.get_setting("chatgpt_prompt_expander", True):
            return en_prompt
        sys_p = "You are an expert prompt engineer. Expand the prompt into a vivid, photorealistic scene description in English under 50 words. Output ONLY the scene."
        res = self._generate_ai_text(sys_p, f"Concept: {en_prompt}", temp=0.7, max_tokens=160)
        return res if res and len(res) > len(en_prompt) else en_prompt

    def _process_image_gen(self, account: int, peer, prompt: str):
        out_path = None
        en = self._is_en()
        try:
            self._cleanup_temp_dir(force_all=False)
            run_on_ui_thread(lambda: BulletinHelper.show_info("🎨 Generating image..." if en else "🎨 Генерация изображения..."))
            temp_dir = File(get_cache_dir(), "ai_pic_temp")
            if not temp_dir.exists():
                temp_dir.mkdirs()
            out_path = File(temp_dir, f"p_{uuid.uuid4().hex[:8]}.jpg").getAbsolutePath()
            enhanced = self._expand_prompt(prompt)
            seed = uuid.uuid4().int % 10000000
            enc = urllib.parse.quote(enhanced)
            url = f"https://image.pollinations.ai/prompt/{enc}?width=1024&height=1024&nologo=true&seed={seed}&model=flux"
            r = self._session.get(url, timeout=50)
            if r.status_code != 200 or len(r.content) < 5000:
                r = self._session.get(f"https://image.pollinations.ai/prompt/{enc}?width=1024&height=1024&nologo=true&seed={seed}", timeout=40)
            if r.status_code == 200 and len(r.content) > 5000:
                with open(out_path, "wb") as f:
                    f.write(r.content)
            else:
                raise Exception(f"Server error ({r.status_code})")
            caption = f"🎨 **[AI Generation]**\n📝 **Prompt:** {prompt[:250]}\n\nBy @xassistofficial" if en else f"🎨 **[AI Генерация]**\n📝 **Промпт:** {prompt[:250]}\n\nBy @xassistofficial"
            if send_photo is not None:
                try:
                    send_photo(peer, out_path, caption=caption, account=account)
                except Exception:
                    send_text(peer, "⚠️ Failed to send image", account=account)
        except Exception as e:
            self._log(f"[Image] Err: {e}")
            send_text(peer, f"❌ Error: {e}", account=account)
        finally:
            if out_path and os.path.exists(out_path):
                try:
                    os.remove(out_path)
                except Exception:
                    pass

    def _fetch_inline_music(self, account: int, peer, query: str):
        en = self._is_en()
        run_on_ui_thread(lambda: BulletinHelper.show_info("🔍 Searching tracks..." if en else "🔍 Ищу треки..."))
        try:
            cm = find_class("org.telegram.tgnet.ConnectionsManager").getInstance(account)
            mc = find_class("org.telegram.messenger.MessagesController").getInstance(account)
            bots = ["vkmusic_bot", "lybot"]

            def try_bot(idx: int):
                if idx >= len(bots):
                    run_on_ui_thread(lambda: BulletinHelper.show_error("Tracks not found" if en else "Треки не найдены"))
                    send_text(peer, "❌ Tracks not found" if en else "❌ Не удалось найти треки.", account=account)
                    return
                bot_name = bots[idx]

                def send_query(target_bot):
                    req = TLRPC.TL_messages_getInlineBotResults()
                    req.bot = mc.getInputUser(target_bot)
                    req.query = String(query)
                    req.offset = String("")
                    req.peer = mc.getInputPeer(peer)

                    def on_res(in_resp, in_err):
                        if in_err or not in_resp or not getattr(in_resp, "results", None) or in_resp.results.size() == 0:
                            try_bot(idx + 1)
                            return
                        tracks = []
                        qid = getattr(in_resp, "query_id", 0)
                        for i in range(in_resp.results.size()):
                            r = in_resp.results.get(i)
                            if not r:
                                continue
                            t_title = str(getattr(r, "title", "") or "")
                            t_desc = str(getattr(r, "description", "") or "")
                            t_dur = "MP3"
                            doc = getattr(r, "document", None)
                            if doc and hasattr(doc, "attributes"):
                                for attr in _safe_iter(doc.attributes):
                                    if attr and "DocumentAttributeAudio" in attr.getClass().getSimpleName():
                                        d_sec = getattr(attr, "duration", 0)
                                        if d_sec > 0:
                                            m, s = divmod(d_sec, 60)
                                            t_dur = f"{m}:{s:02d}"
                                        t_title = t_title or str(getattr(attr, "title", "") or "")
                                        t_desc = t_desc or str(getattr(attr, "performer", "") or "")
                            tracks.append({"title": html.unescape(t_title or query).strip(), "author": html.unescape(t_desc or "Music").strip(), "duration": t_dur, "bot_result": r, "query_id": qid})
                        run_on_ui_thread(lambda: self._show_music_picker_sheet(account, peer, tracks, query))

                    cm.sendRequest(req, _GlobalReqDelegate(on_res, self._log))

                cached = self._cached_music_bots.get(bot_name)
                if cached:
                    send_query(cached)
                    return

                def on_resolved(resp, err):
                    if err or not resp or not getattr(resp, "users", None) or resp.users.size() == 0:
                        try_bot(idx + 1)
                        return
                    u = resp.users.get(0)
                    mc.putUser(u, False)
                    self._cached_music_bots[bot_name] = u
                    send_query(u)

                resolve_req = TLRPC.TL_contacts_resolveUsername()
                resolve_req.username = String(bot_name)
                cm.sendRequest(resolve_req, _GlobalReqDelegate(on_resolved, self._log))

            try_bot(0)
        except Exception as e:
            self._log(f"[Music] Err: {e}")

