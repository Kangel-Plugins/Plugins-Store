    def on_update_hook(self, name: str, account: int, update: Any) -> HookResult:
        return HookResult()

    def _get_custom_command(self, key: str, default: str) -> str:
        cmd = str(self.get_setting(key, default) or default).strip().lower()
        if not cmd:
            cmd = default.lower()
        words = cmd.split()
        if words:
            cmd = words[0]
        if not cmd.startswith("/"):
            cmd = "/" + cmd
        return cmd

    def on_send_message_hook(self, account: int, params: Any) -> HookResult:
        peer = getattr(params, "peer", None)
        raw_msg = getattr(params, "message", None)
        if not peer or raw_msg is None:
            return HookResult()
        text = str(raw_msg).strip()
        peer_key = self._chat_key(peer)
        if peer in self._skip_next or peer_key in self._skip_next:
            self._skip_next.discard(peer)
            self._skip_next.discard(peer_key)
            return HookResult()
        reply_msg = getattr(params, "replyToMsg", None)
        if text == "/help" or text.startswith("/help"):
            en = self._is_en()
            cmd_ask_label = self._get_custom_command("cmd_ask", "/ask")
            cmd_search_label = self._get_custom_command("cmd_search", "/search")
            if en:
                help_text = (
                    "👋 Welcome to X-Assist!\n\n"
                    "Your personal smart AI assistant directly in Telegram.\n\n"
                    "🔑 How to configure API keys (free):\n\n"
                    "1️⃣ Gemini API Key (Primary brain):\n"
                    "• Visit: https://aistudio.google.com/app/apikey\n"
                    "• Sign in with your Google account and click «Create API key»\n"
                    "• Copy your key and paste into Settings ➔ API Keys ➔ Gemini API Key\n"
                    "(You can specify multiple keys separated by commas as backup)\n\n"
                    "2️⃣ Groq API Key (Voice transcription + fallback):\n"
                    "• Visit: https://console.groq.com/keys\n"
                    "• Sign up, click «Create API Key» and copy the key\n"
                    "• Paste into Settings ➔ API Keys ➔ Groq API Key\n"
                    "(Used for fast transcription of voice messages and video notes)\n\n"
                    "3️⃣ OpenRouter API Key (Backup text models):\n"
                    "• Visit: https://openrouter.ai/settings/keys\n"
                    "• Create a key and paste into OpenRouter API Key\n\n"
                    "━━━━━━━━━━━━━━━━━━━━\n\n"
                    "📋 Commands & features:\n\n"
                    f"💬 {cmd_ask_label} [question] — Ask assistant (image and document recognition works only in reply to a message containing them).\n"
                    f"🌐 {cmd_search_label} [query] — Real-time internet search via Google.\n"
                    "🎨 /pic [prompt] — High quality image generation.\n"
                    "🎵 /ms [title] — Search, select and send music tracks.\n"
                    "🎵 /shazam — Recognize music from voice notes, video notes, video or audio (reply to message).\n"
                    "✨ Context Menu — Tap on a message, then tap «Plugins», and those three buttons («Summarize briefly», «Translate», «Fact Check») will be there.\n"
                    "🧹 /clear_history — Clear dialogue memory in this chat.\n"
                    "📝 /log — Show recent system logs.\n"
                    "❓ /help — Show this help message.\n\n"
                    "━━━━━━━━━━━━━━━━━━━━\n\n"
                    "💡 Encountered an error or bug?\n"
                    "If you are sure everything is set up correctly, but something is not working — contact the author in private messages (using «Contact author» button in settings), describe the problem in detail and attach the output of /log."
                )
            else:
                help_text = (
                    "👋 Добро пожаловать в X-Assist!\n\n"
                    "Ваш персональный умный AI-помощник прямо в Telegram.\n\n"
                    "🔑 Как настроить API-ключи (это бесплатно):\n\n"
                    "1️⃣ Gemini API Key (Основной ум):\n"
                    "• Перейдите на сайт: https://aistudio.google.com/app/apikey\n"
                    "• Войдите через Google-аккаунт и нажмите «Create API key»\n"
                    "• Скопируйте ключ и вставьте в Настройки ➔ API-Ключи ➔ Gemini API Key\n"
                    "(Можно вставить несколько ключей через запятую для запаса)\n\n"
                    "2️⃣ Groq API Key (Распознавание речи + резерв):\n"
                    "• Перейдите на сайт: https://console.groq.com/keys\n"
                    "• Зарегистрируйтесь, нажмите «Create API Key» и скопируйте ключ\n"
                    "• Вставьте в Настройки ➔ API-Ключи ➔ Groq API Key\n"
                    "(Нужен для быстрой расшифровки голосовых сообщений и кружочков)\n\n"
                    "3️⃣ OpenRouter API Key (Запасной резерв текстовых моделей):\n"
                    "• Зайдите на: https://openrouter.ai/settings/keys\n"
                    "• Создайте ключ и вставьте в OpenRouter API Key\n\n"
                    "━━━━━━━━━━━━━━━━━━━━\n\n"
                    "📋 Команды и возможности:\n\n"
                    f"💬 {cmd_ask_label} [вопрос] — Задать вопрос ассистенту (распознавание изображений и документов работает только в ответ на сообщение с ними).\n"
                    f"🌐 {cmd_search_label} [запрос] — Поиск актуальной информации в интернете через Google.\n"
                    "🎨 /pic [описание] — Генерация картинок в высоком качестве.\n"
                    "🎵 /ms [название] — Поиск, выбор и отправка музыки.\n"
                    "🎵 /shazam — Распознать трек по голосовому, кружочку, видео или аудио (в ответ на сообщение).\n"
                    "✨ Контекстное меню — Нажмите на сообщение, затем на «Плагины», и эти три кнопки («Пересказать кратко», «Перевести», «Фактчек») будут там.\n"
                    "🧹 /clear_history — Очистить память диалога в этом чате.\n"
                    "📝 /log — Показать последние системные логи.\n"
                    "❓ /help — Вызвать эту справку.\n\n"
                    "━━━━━━━━━━━━━━━━━━━━\n\n"
                    "💡 Возникла ошибка или баг?\n"
                    "Если вы уверены, что настроили всё правильно, но что-то работает не так — напишите автору в личные сообщения (кнопка «Связь с автором» в настройках плагина), подробно описав проблему и приложив результат команды /log."
                )
            send_text(peer, help_text, account=account)
            return HookResult(strategy=HookStrategy.CANCEL)
        parts = text.split(maxsplit=1)
        first_word = parts[0].lower() if parts else ""
        remainder = parts[1].strip() if len(parts) > 1 else ""
        if first_word in ("/pic", "/img"):
            p = remainder or (getattr(getattr(reply_msg, "messageOwner", None), "message", "").strip() if reply_msg else "")
            if p:
                self._submit(self._process_image_gen, account, peer, p)
            else:
                send_text(peer, "❌ Please specify an image description!" if self._is_en() else "❌ Укажите описание картинки!", account=account)
            return HookResult(strategy=HookStrategy.CANCEL)
        if first_word in ("/ms", "/music"):
            q = remainder
            if q:
                self._submit(self._fetch_inline_music, account, peer, q)
            else:
                send_text(peer, "❌ Please specify a song name!" if self._is_en() else "❌ Укажите название песни!", account=account)
            return HookResult(strategy=HookStrategy.CANCEL)
        if first_word == "/shazam":
            if not reply_msg:
                send_text(peer, "❌ Reply with /shazam to a voice note, video note, video, or audio file!" if self._is_en() else "❌ Ответьте командой /shazam на голосовое сообщение, кружочек, видео или аудиофайл!", account=account)
                return HookResult(strategy=HookStrategy.CANCEL)
            self._submit(self._process_shazam, account, peer, reply_msg)
            return HookResult(strategy=HookStrategy.CANCEL)
        if first_word == "/log":
            with self._lock:
                log_txt = "\n".join(self._log_lines[-40:]) or ("Logs are empty" if self._is_en() else "Лог пуст")
            hdr = "📝 **Logs:**\n" if self._is_en() else "📝 **Логи:**\n"
            self._send_split_message(peer, f"{hdr}{log_txt}", account=account)
            return HookResult(strategy=HookStrategy.CANCEL)
        if first_word == "/clear_history":
            with self._lock:
                if peer_key in self._chat_history:
                    self._chat_history[peer_key].clear()
                    self._save_data()
            send_text(peer, "🧹 History cleared!" if self._is_en() else "🧹 История очищена!", account=account)
            return HookResult(strategy=HookStrategy.CANCEL)
        custom_ask = self._get_custom_command("cmd_ask", "/ask")
        custom_search = self._get_custom_command("cmd_search", "/search")
        is_search = False
        is_ask = False
        q = ""
        if first_word in (custom_search, "/search"):
            is_search = True
            q = remainder
        elif first_word in (custom_ask, "/ask"):
            is_ask = True
            q = remainder
        if not (is_search or is_ask):
            return HookResult()
        api_raw = str(self.get_setting("api_key", "") or "")
        has_gemini = any(self._clean_key(k) for k in api_raw.replace(";", ",").split(","))
        has_groq = bool(self._clean_key(self.get_setting("groq_api_key", "") or ""))
        has_or = bool(self._clean_key(self.get_setting("openrouter_api_key", "") or ""))
        if not (has_gemini or has_groq or has_or):
            err_msg = (
                "❌ Specify at least one API key (Gemini, Groq, or OpenRouter) in plugin settings!\nType `/help` for instructions."
                if self._is_en() else
                "❌ Укажите хотя бы один API-ключ (Gemini, Groq или OpenRouter) в настройках плагина!\nНапишите `/help` для инструкции."
            )
            send_text(peer, err_msg, account=account)
            return HookResult(strategy=HookStrategy.CANCEL)
        if not q and reply_msg:
            if self._is_photo_message(reply_msg):
                q = "Describe and analyze this image in detail." if self._is_en() else "Подробно опиши и проанализируй это изображение."
            elif MessageObject.getDocument(reply_msg):
                q = "Thoroughly examine this document, summarize it and highlight key points." if self._is_en() else "Подробно изучи этот документ, сделай краткую выжимку и выдели главное."
            elif getattr(getattr(reply_msg, "messageOwner", None), "message", "").strip():
                q = "Analyze and explain this message." if self._is_en() else "Проанализируй и объясни это сообщение."
        if not q:
            send_text(peer, "❌ Enter your question after the command." if self._is_en() else "❌ Введите вопрос после команды.", account=account)
            return HookResult(strategy=HookStrategy.CANCEL)
        with self._lock:
            if peer_key in self._processing:
                send_text(peer, "⏳ Request is already being processed..." if self._is_en() else "⏳ Запрос уже обрабатывается...", account=account)
                return HookResult(strategy=HookStrategy.CANCEL)
            self._processing.add(peer_key)
        self._remember(peer_key, "User" if self._is_en() else "Я", q)
        self._submit(self._ask_gemini, account, peer, peer_key, q, is_search, reply_msg)
        return HookResult(strategy=HookStrategy.CANCEL)

    def _is_photo_message(self, msg: MessageObject) -> bool:
        media = getattr(getattr(msg, "messageOwner", None), "media", None)
        return bool(media and (getattr(media, "photo", None) or (MessageObject.getDocument(msg) and getattr(MessageObject.getDocument(msg), "mime_type", "").startswith("image/"))))

    def _ask_gemini(self, account: int, peer, peer_key: str, question: str, is_search: bool = False, reply_msg: MessageObject = None):
        en = self._is_en()
        try:
            api_raw = str(self.get_setting("api_key", "") or "")
            gemini_keys = [self._clean_key(k) for k in api_raw.replace(";", ",").split(",") if self._clean_key(k)]
            groq_key = self._clean_key(self.get_setting("groq_api_key", "") or "")
            openrouter_key = self._clean_key(self.get_setting("openrouter_api_key", "") or "")
            use_web = (self.get_setting("search_always", False) or is_search) and self.get_setting("enable_web_search", True)
            if use_web:
                run_on_ui_thread(lambda: BulletinHelper.show_info("🔍 Searching the web..." if en else "🔍 Поиск в интернете..."))
            else:
                run_on_ui_thread(lambda: BulletinHelper.show_info("💭 Generating response..." if en else "💭 Генерирую ответ..."))
            image_data = doc_data = None
            doc_text_content = doc_file_name = replied_text = ""
            if reply_msg and getattr(reply_msg, "messageOwner", None):
                if self._is_photo_message(reply_msg):
                    run_on_ui_thread(lambda: BulletinHelper.show_info("🖼 Loading photo..." if en else "🖼 Загружаю фото..."))
                    p, mime = self._download_photo_sync(reply_msg, account)
                    if p and os.path.exists(p):
                        with open(p, "rb") as f:
                            image_data = (mime, base64.b64encode(f.read()).decode("utf-8"))
                elif MessageObject.getDocument(reply_msg):
                    doc, doc_file_name, mime, sz = self._get_document_info(reply_msg)
                    if sz <= 15 * 1024 * 1024:
                        run_on_ui_thread(lambda: BulletinHelper.show_info(f"📄 Loading {doc_file_name}..." if en else f"📄 Загружаю {doc_file_name}..."))
                        dp = self._poll_download_file(reply_msg, doc, account)
                        if dp and os.path.exists(dp):
                            ext = os.path.splitext(doc_file_name.lower())[1]
                            if ext == ".pdf" or mime == "application/pdf":
                                with open(dp, "rb") as f:
                                    doc_data = ("application/pdf", base64.b64encode(f.read()).decode("utf-8"))
                            else:
                                try:
                                    with open(dp, "r", encoding="utf-8", errors="ignore") as f:
                                        doc_text_content = f.read(150000 if ext in TEXT_EXTENSIONS or mime.startswith("text/") else 100000)
                                except Exception:
                                    pass
                    else:
                        send_text(peer, "⚠️ File exceeds 15 MB. Supported document size is up to 15 MB." if en else "⚠️ Файл больше 15 МБ. Поддерживаются документы до 15 МБ.", account=account)
                        return
                else:
                    raw_m = getattr(reply_msg.messageOwner, "message", "")
                    if raw_m and not raw_m.startswith("/"):
                        replied_text = raw_m.strip()
            memory_lim = self._get_chat_memory(peer_key)
            with self._lock:
                raw_history = list(self._chat_history.get(peer_key, []))
            history = [h for h in raw_history if not str(h).startswith(("Собеседник:", "Собеседник :"))][-memory_lim:]
            gemini_contents = []
            for h in history[:-1]:
                if ":" in h:
                    s, m = h.split(":", 1)
                    r = "model" if s.strip() in ("Assistant", "Ассистент") else "user"
                    txt = f"{s.strip()}: {m.strip()}"
                    if gemini_contents and gemini_contents[-1]["role"] == r:
                        gemini_contents[-1]["parts"][0]["text"] += f"\n{txt}"
                    else:
                        gemini_contents.append({"role": r, "parts": [{"text": txt}]})
            while gemini_contents and gemini_contents[0]["role"] == "model":
                gemini_contents.pop(0)
            cur_prompt = question
            if replied_text:
                cur_prompt = f"MESSAGE CONTEXT:\n«««\n{replied_text}\n»»»\nTASK:\n{question}" if en else f"КОНТЕКСТ СООБЩЕНИЯ:\n«««\n{replied_text}\n»»»\nЗАДАЧА:\n{question}"
            if doc_text_content:
                cur_prompt = f"DOCUMENT CONTENT «{doc_file_name}»:\n```\n{doc_text_content}\n```\nTASK:\n{cur_prompt}" if en else f"СОДЕРЖИМОЕ ДОКУМЕНТА «{doc_file_name}»:\n```\n{doc_text_content}\n```\nЗАДАЧА:\n{cur_prompt}"
            u_parts = []
            if image_data:
                u_parts.append({"inline_data": {"mime_type": image_data[0], "data": image_data[1]}})
            elif doc_data:
                u_parts.append({"inline_data": {"mime_type": doc_data[0], "data": doc_data[1]}})
            u_parts.append({"text": cur_prompt})
            if gemini_contents and gemini_contents[-1]["role"] == "user":
                gemini_contents[-1]["parts"].extend(u_parts)
            else:
                gemini_contents.append({"role": "user", "parts": u_parts})
            openai_msgs = [{"role": "system", "content": SYSTEM_PROMPT}] + [
                {"role": "assistant" if "Assistant" in h.split(":", 1)[0] else "user", "content": h.split(":", 1)[1].strip()}
                for h in history[:-1] if ":" in h
            ] + [{"role": "user", "content": cur_prompt}]
            start_t = time.time()
            header_badge = (f"📄 **[File: {doc_file_name}]**\n" if en else f"📄 **[Файл: {doc_file_name}]**\n") if doc_file_name else ((("🖼 **[Image Analysis]**\n" if en else "🖼 **[Анализ изображения]**\n") if image_data else (("🌐 **[Google Search]**\n" if en else "🌐 **[Google Поиск]**\n") if use_web else "")))
            new_text, used_badge = None, ""

            def parse_gemini(resp):
                cand = resp.json().get("candidates", [{}])[0].get("content", {}).get("parts", [])
                ans = "".join(p.get("text", "") for p in cand if p.get("text")).strip()
                return ans if ans else None

            def try_fallbacks(msgs, badge):
                if groq_key:
                    for m in GROQ_FALLBACK_MODELS:
                        ok, res = self._llm._call_openai_compatible(GROQ_LLM_URL, groq_key, m, msgs)
                        if ok and res:
                            return res, badge
                if openrouter_key:
                    for m in OPENROUTER_MODELS:
                        ok, res = self._llm._call_openai_compatible(OPENROUTER_URL, openrouter_key, m, msgs, extra_headers=OR_FALLBACK_HEADERS)
                        if ok and res:
                            return res, badge
                return None, ""

            def call_gemini(k, payload):
                return self._session.post(API_URL, headers={"x-goog-api-key": k, "Content-Type": "application/json"}, json=payload, timeout=NETWORK_TIMEOUT)

            if use_web:
                payload = {"systemInstruction": {"parts": [{"text": SYSTEM_PROMPT}]}, "contents": gemini_contents, "generationConfig": {"temperature": 0.7, "maxOutputTokens": 2048}, "tools": [{"googleSearch": {}}]}
                for idx, gk in enumerate(gemini_keys):
                    try:
                        r = call_gemini(gk, payload)
                        if r.status_code == 200:
                            ans = parse_gemini(r)
                            if ans:
                                new_text, used_badge = ans, header_badge
                                break
                        else:
                            self._log(f"Gemini key {idx+1} err ({r.status_code}): {r.text[:120]}")
                    except Exception as e:
                        self._log(f"Gemini key {idx+1} error: {e}")
                if not new_text:
                    run_on_ui_thread(lambda: BulletinHelper.show_info("🌐 Searching via backup networks..." if en else "🌐 Поиск через резервные сети..."))
                    snips = self._fetch_web_snippets(question)
                    target_msgs = openai_msgs
                    if snips:
                        snippet_prompt = f"FRESH WEB DATA:\n{snips}\n\nUSER PROMPT:\n{cur_prompt}\n\nAnswer using the web data above." if en else f"АКТУАЛЬНЫЕ ДАННЫЕ ИЗ СЕТИ (ПОИСК):\n{snips}\n\nЗАПРОС ПОЛЬЗОВАТЕЛЯ:\n{cur_prompt}\n\nОтветь на запрос пользователя, используя свежие данные из поиска выше."
                        target_msgs = list(openai_msgs[:-1]) + [{"role": "user", "content": snippet_prompt}]
                    res, b = try_fallbacks(target_msgs, "🌐 **[Fallback: Web Search]**\n" if en else "🌐 **[Резерв: Web Поиск]**\n")
                    if res:
                        new_text, used_badge = res, b
            if not new_text:
                base_badge = (("⚠️ **[Web search failed: answering from Gemini knowledge base]**\n" if en else "⚠️ **[Поиск в сети не удался: ответ из базы Gemini]**\n") if use_web else "")
                fb_badge = (("⚠️ **[Web search failed: answering from backup knowledge base]**\n" if en else "⚠️ **[Поиск в сети не удался: ответ из резервной базы]**\n") if use_web else ("⚡️ **[Fallback]**\n" if en else "⚡️ **[Резерв]**\n"))
                payload = {"systemInstruction": {"parts": [{"text": SYSTEM_PROMPT}]}, "contents": gemini_contents, "generationConfig": {"temperature": 0.7, "maxOutputTokens": 2048}}
                for idx, gk in enumerate(gemini_keys):
                    try:
                        r = call_gemini(gk, payload)
                        if r.status_code == 200:
                            ans = parse_gemini(r)
                            if ans:
                                new_text, used_badge = ans, base_badge
                                break
                        else:
                            self._log(f"Gemini fallback key {idx+1} err ({r.status_code}): {r.text[:120]}")
                    except Exception as e:
                        self._log(f"Gemini fallback key {idx+1}: {e}")
                if not new_text:
                    run_on_ui_thread(lambda: BulletinHelper.show_info("⚡️ Answering via backup model..." if en else "⚡️ Ответ через резервную модель..."))
                    res, b = try_fallbacks(openai_msgs, fb_badge)
                    if res:
                        new_text, used_badge = res, b
            if not new_text:
                new_text = self._format_api_error(429)
            run_on_ui_thread(lambda: BulletinHelper.show_info("✍️ Sending response..." if en else "✍️ Отправляю ответ..."))
            new_text = re.sub(r"^###\s+", "▫️ ", new_text, flags=re.MULTILINE)
            act_badge = used_badge or header_badge
            stats = (f"\n📊 ⏱ {round(time.time() - start_t, 1)}s | 💾 Context: {len(history)} msgs." if en else f"\n📊 ⏱ {round(time.time() - start_t, 1)}с | 💾 Контекст: {len(history)} сообщ.") if self.get_setting("show_stats", False) else ""
            footer = "\n\nBy @xassistofficial"
            final_msg = f"{act_badge}{new_text}{stats}{footer}"
            if not new_text.startswith(("❌", "⚠️")):
                self._remember(peer_key, "Assistant" if en else "Ассистент", new_text)
            self._send_split_message(peer, final_msg, account=account)
        except Exception as e:
            self._log(f"[Ask] Err: {e}")
            send_text(peer, f"❌ Error: {e}" if en else f"❌ Ошибка: {e}", account=account)
        finally:
            with self._lock:
                self._processing.discard(peer_key)