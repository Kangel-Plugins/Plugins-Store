from typing import Any, List

from base_plugin import BasePlugin, MethodHook
from hook_utils import find_class

__id__ = "hide_admin_rank_chat"
__name__ = "Hide Admin Rank (Chat)"
__description__ = "Отключает клик по роли рядом с сообщениями в чате."
__author__ = "@ksuebes"
__version__ = "1.0"
__icon__ = "SpottyAnimated/47"
__app_version__ = ">=12.5.1"


TARGET_CLASS = "org.telegram.ui.Cells.ChatMessageCell"


RANK_METHOD = "getAdminRank"


TOUCH_METHODS = ("checkAdminMotionEvent", "checkAdminTouchEvent")


class ForceEmptyStringHook(MethodHook):
    def __init__(self, plugin: "HideAdminRankChatPlugin"):
        self.plugin = plugin

    def before_hooked_method(self, param: Any):
        try:
            param.setResult("")
        except Exception as exc:
            self.plugin.log_once("rank_result_fail", f"getAdminRank override failed: {exc}")


class ForceFalseHook(MethodHook):
    def __init__(self, plugin: "HideAdminRankChatPlugin"):
        self.plugin = plugin

    def before_hooked_method(self, param: Any):
        try:
            param.setResult(False)
        except Exception as exc:
            self.plugin.log_once("touch_result_fail", f"touch event override failed: {exc}")


class HideAdminRankChatPlugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self.unhook_objects: List[Any] = []
        self.logged_messages = set()

    def on_plugin_load(self):
        self.on_plugin_unload()

        clazz = find_class(TARGET_CLASS)
        if clazz is None:
            self.log_once("missing_class", f"Class not found: {TARGET_CLASS}")
            return

        found_any_touch = False
        for method_name in TOUCH_METHODS:
            unhooks = self.hook_all_methods(clazz, method_name, ForceFalseHook(self), priority=10000)
            if unhooks:
                self.unhook_objects.extend(unhooks)
                found_any_touch = True
            else:
                self.log_once(f"missing_touch_{method_name}", f"Method not hooked: {TARGET_CLASS}.{method_name}")

        if not found_any_touch:
            self.log_once(
                "no_touch_methods_at_all",
                f"None of {TOUCH_METHODS} were found on {TARGET_CLASS} — rank click may still work.",
            )

        self.log(f"{__name__} loaded: {len(self.unhook_objects)} hooks installed")

    def on_plugin_unload(self):
        for unhook in list(getattr(self, "unhook_objects", [])):
            try:
                self.unhook_method(unhook)
            except Exception:
                pass
        self.unhook_objects.clear()

    def log_once(self, key: str, message: str):
        if key in self.logged_messages:
            return
        self.logged_messages.add(key)
        self.log(message)
