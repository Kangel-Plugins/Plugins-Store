__id__ = "ipo"
__name__ = "IPO"
__description__ = "Тап по иконке плагина открывает стикер-пак, из которого эта иконка."
__version__ = "1.0"
__author__ = "@la_cringe"
__app_version__ = ">=12.10.6"
__icon__ = "exteraPlugins/2"

import traceback

from base_plugin import BasePlugin, MethodHook
from hook_utils import find_class
from client_utils import get_last_fragment
from android_utils import OnClickListener
from ui.bulletin import BulletinHelper
from org.telegram.tgnet import TLRPC
from java.lang import Class

TARGET_METHOD = "setPlaceholderImageByIndex"
STICKERS_ALERT_CLASS = "org.telegram.ui.Components.StickersAlert"
SHEET_CONTAINER_CLASS = "org.telegram.ui.ActionBar.BottomSheet$ContainerView"
SHEET_CLASS_NAME = "org.telegram.ui.ActionBar.BottomSheet"


class IconBindHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            self.plugin.attach_click(param.args)
        except Exception:
            self.plugin.log("icon bind error\n" + traceback.format_exc())


class IconPackOpenerPlugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self.unhooks = []

    def on_plugin_load(self):
        self.on_plugin_unload()
        media_data_controller = find_class("org.telegram.messenger.MediaDataController")
        if media_data_controller is None:
            self.log("MediaDataController not found")
            return
        self.unhooks.extend(
            self.hook_all_methods(media_data_controller, TARGET_METHOD, IconBindHook(self), priority=10000)
        )

    def on_plugin_unload(self):
        for handle in list(self.unhooks):
            try:
                self.unhook_method(handle)
            except Exception:
                pass
        self.unhooks = []

    def attach_click(self, args):
        if not args or len(args) < 2:
            return
        view, pack = args[0], args[1]
        if view is None or pack is None:
            return
        pack = str(pack)
        view.setOnClickListener(
            OnClickListener(lambda *a, p=pack, v=view: self.open_pack(p, v))
        )

    def find_sheet_container(self, view):
        parent = view.getParent()
        while parent is not None:
            if self.class_name(parent) == SHEET_CONTAINER_CLASS:
                return parent
            parent = parent.getParent()
        return None

    def open_pack(self, pack, view):
        try:
            container = self.find_sheet_container(view)
            if container is not None:
                self.dismiss_sheet(container)
            alert = self.build_alert(pack, view.getContext())
            if alert is None:
                raise RuntimeError("StickersAlert constructor not found")
            alert.show()
        except Exception:
            self.log("open pack error\n" + traceback.format_exc())
            try:
                BulletinHelper.show_error("Не удалось открыть стикерпак")
            except Exception:
                pass

    def build_alert(self, short_name, context):
        input_set = TLRPC.TL_inputStickerSetShortName()
        input_set.short_name = short_name
        best = None
        for ctor in Class.forName(STICKERS_ALERT_CLASS).getConstructors():
            names = [p.getSimpleName() for p in ctor.getParameterTypes()]
            if len(names) >= 3 and "Context" in names[0] and "BaseFragment" in names[1] and "InputStickerSet" in names[2]:
                if best is None or len(names) < len(best.getParameterTypes()):
                    best = ctor
        if best is None:
            return None
        call_args = [context, get_last_fragment(), input_set]
        for ptype in best.getParameterTypes()[3:]:
            simple = ptype.getSimpleName()
            if simple == "boolean":
                call_args.append(False)
            elif simple in ("int", "long", "short", "byte", "float", "double"):
                call_args.append(0)
            else:
                call_args.append(None)
        return best.newInstance(*call_args)

    def dismiss_sheet(self, container):
        try:
            for field in container.getClass().getDeclaredFields():
                if str(field.getType().getName()) == SHEET_CLASS_NAME:
                    field.setAccessible(True)
                    sheet = field.get(container)
                    if sheet is not None:
                        sheet.dismiss()
                    return
        except Exception:
            self.log("dismiss sheet error\n" + traceback.format_exc())

    def class_name(self, obj):
        try:
            return str(obj.getClass().getName())
        except Exception:
            return ""
