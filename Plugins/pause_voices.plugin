# -*- coding: utf-8 -*-
import os
import traceback
import threading

from typing import Any, List

from java import jclass

from org.telegram.messenger import ApplicationLoader

from base_plugin import BasePlugin
from ui.settings import Header, Switch, Selector

__id__          = "pause_voices"
__name__        = "Pause Voices"
__description__ = "[EN]: Tapping the (X) on a voice or video message (video note) no longer deletes it permanently; you can now save the message, cancel it, or pause sending. \n\n[RU]: Нажатие на крестик у голосового или видео сообщения (кружка) больше не удаляет его безвозвратно — сообщение можно сохранить, отменить или поставить отправку на паузу."
__author__      = "@itNotMax - @MaxExteraPlugins"
__version__     = "1.0"
__icon__        = "MaxExteraPluginsStickers/29"
__min_version__ = "12.1.1"
__app_version__ = ">=12.1.1"
__sdk_version__ = ">=1.4.3.3"

ENTRY_CLASS = "com.exteraplugins.send_pause.Main"
DEX_BEGIN = "__DEX_BEGIN__"
DEX_END = "__DEX_END__"
PREFS_NAME = "send_pause_prefs"

DELAY_INDEX_KEY = "send_delay_index"
SAVE_CANCELED_KEY = "save_canceled_downloads"
DELAY_OPTIONS = ["Выкл", "3 сек", "5 сек", "10 сек"]
DELAY_SECONDS = [0, 3, 5, 10]

DIAG_FILE = "send_pause_diag.txt"

DIAG = []


def _log(msg):
    line = "[SendPause] " + msg
    DIAG.append(msg)
    if len(DIAG) > 60:
        del DIAG[:len(DIAG) - 60]
    try:
        from android.util import Log as ALog
        ALog.d("SendPause", msg)
    except Exception:
        pass
    try:
        ctx = ApplicationLoader.applicationContext
        if ctx is not None:
            p = str(ctx.getFilesDir().getAbsolutePath())
            with open(os.path.join(p, DIAG_FILE), "a", encoding="utf-8") as f:
                f.write(line + "\n")
    except Exception:
        pass


class Dex:
    def __init__(self, ec):
        self.ec = ec
        self.clazz = None
        self.loaded = False
        self.loading = False
        self._m = {}

    def load(self):
        if self.loaded or self.loading:
            return
        self.loading = True
        _log("py: dex.load() begin")
        try:
            if self.clazz is None:
                ctx = ApplicationLoader.applicationContext
                if not ctx:
                    raise RuntimeError("no ctx")
                raw = self._rp()
                _log("py: payload ready, len=" + str(len(raw)))
                loader_cls = jclass("dalvik.system.InMemoryDexClassLoader")
                loader = loader_cls(jclass("java.nio.ByteBuffer").wrap(raw), ctx.getClassLoader())
                clazz = loader.loadClass(self.ec)
                _log("py: class loaded: " + str(clazz))
                self.clazz = clazz
                for m in self.clazz.getDeclaredMethods():
                    m.setAccessible(True)
                    self._m[str(m.getName())] = m
                _log("py: methods: " + ",".join(sorted(self._m.keys())))
            _log("py: invoking Main.load")
            self._m["load"].invoke(None)
            self.loaded = True
            self.loading = False
            _log("py: Main.load OK")
        except Exception as e:
            self.loading = False
            _log("py: dex.load ERROR " + traceback.format_exc())

    def unload(self):
        try:
            if self.loaded:
                self._m["unload"].invoke(None)
        except Exception as e:
            _log("py: unload error " + str(e))
        self.loaded = False

    def call(self, name, *args):
        try:
            if self.loaded and name in self._m:
                return self._m[name].invoke(None, *args)
        except Exception as e:
            _log("py: dex." + name + " error " + str(e))
        return None

    def _rp(self):
        with open(__file__, "r", encoding="utf-8") as f:
            t = f.read()
        if "# " + DEX_BEGIN not in t or "# " + DEX_END not in t:
            raise RuntimeError("markers missing; file size=" + str(len(t)))
        b = t.split("# " + DEX_BEGIN, 1)[1].split("# " + DEX_END, 1)[0]
        p = "".join(l.strip()[1:].strip() for l in b.splitlines() if l.strip().startswith("#"))
        if not p:
            raise RuntimeError("dex empty")
        import zlib
        import base64
        return zlib.decompress(base64.b64decode(p))


class SendPausePlugin(BasePlugin):

    def __init__(self):
        super().__init__()
        self.dex = Dex(ENTRY_CLASS)

    def on_plugin_load(self):
        threading.Thread(target=self._load_dex, daemon=True, name="SendPause-init").start()

    def on_plugin_unload(self):
        try:
            self.dex.unload()
        except Exception:
            pass

    def _load_dex(self):
        _log("py: plugin load thread start")
        try:
            self.dex.load()
            self._push_prefs()
        except Exception as e:
            _log("py: plugin load thread error " + traceback.format_exc())

    def _read_prefs(self):
        try:
            idx = int(self.get_setting(DELAY_INDEX_KEY, 0) or 0)
        except Exception:
            idx = 0
        if idx < 0 or idx >= len(DELAY_SECONDS):
            idx = 0
        try:
            save = bool(self.get_setting(SAVE_CANCELED_KEY, False))
        except Exception:
            save = False
        return idx, save

    def _push_prefs(self):
        try:
            idx, save = self._read_prefs()
            self.dex.call("setPrefs", DELAY_SECONDS[idx], save)
        except Exception as e:
            _log("py: push prefs error " + str(e))

    def _on_delay_change(self, value):
        try:
            idx = int(value) if value is not None else 0
            if idx < 0 or idx >= len(DELAY_SECONDS):
                idx = 0
            _, save = self._read_prefs()
            self.dex.call("setPrefs", DELAY_SECONDS[idx], save)
        except Exception:
            self._push_prefs()

    def _on_save_change(self, value):
        try:
            idx, _ = self._read_prefs()
            self.dex.call("setPrefs", DELAY_SECONDS[idx], bool(value))
        except Exception:
            self._push_prefs()

    def _prefs(self):
        return ApplicationLoader.applicationContext.getSharedPreferences(PREFS_NAME, 0)

    def create_settings(self):
        items = [
            Header(text="Настройки"),
        ]
        try:
            items.append(Selector(
                key=DELAY_INDEX_KEY,
                text="Задержка отправки",
                default=0,
                items=DELAY_OPTIONS,
                icon="msg_schedule",
                on_change=self._on_delay_change,
            ))
        except Exception as e:
            _log("py: selector error " + repr(e))
        try:
            items.append(Switch(
                key=SAVE_CANCELED_KEY,
                text="Сохранять отменённые в Загрузки",
                default=False,
                subtext="При нажатии крестика файл копируется в папку Загрузки. Повторный крестик после возобновления не сохраняет файл второй раз.",
                icon="msg_download",
                on_change=self._on_save_change,
            ))
        except Exception as e:
            _log("py: switch error " + repr(e))
        self._push_prefs()

        if not self.dex.loaded:
            try:
                self.dex.load()
            except Exception as e:
                _log("py: sync load error " + str(e))

        return items


__plugin__ = SendPausePlugin

_log("py: module import (diag v2)")


