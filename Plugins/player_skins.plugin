_ICON_CACHE = {}


def build_path(ops):
    path = A.Path()
    cw = A.Path.Direction.CW
    for op in ops:
        k = op[0]
        if k == "M":
            path.moveTo(F(op[1]), F(op[2]))
        elif k == "L":
            path.lineTo(F(op[1]), F(op[2]))
        elif k == "C":
            path.cubicTo(F(op[1]), F(op[2]), F(op[3]), F(op[4]), F(op[5]), F(op[6]))
        elif k == "Z":
            path.close()
        elif k == "O":
            path.addCircle(F(op[1]), F(op[2]), F(op[3]), cw)
        elif k == "R":
            path.addRoundRect(F(op[1]), F(op[2]), F(op[3]), F(op[4]), F(op[5]), F(op[5]), cw)
    return path


def icon_bitmap(name, size_px, color=None, color2=None):
    """White mask when color is None (tint it with a color filter), otherwise final colors."""
    key = (name, size_px, color, color2)
    bmp = _ICON_CACHE.get(key)
    if bmp is not None:
        return bmp
    bmp = A.Bitmap.createBitmap(max(1, size_px), max(1, size_px), A.Bitmap.Config.ARGB_8888)
    canvas = A.Canvas(bmp)
    s = size_px / 24.0
    canvas.scale(F(s), F(s))
    paint = A.Paint(1)
    for layer in ICONS[name]:
        kind, width, ops = layer[0], layer[1], layer[2]
        role = layer[3] if len(layer) > 3 else "fg"
        fg = WHITE if color is None else color
        paint.setColor(jint(fg if role == "fg" else (BLACK if color2 is None else color2)))
        if kind == "f":
            paint.setStyle(A.Paint.Style.FILL)
        else:
            paint.setStyle(A.Paint.Style.STROKE)
            paint.setStrokeWidth(F(width))
            paint.setStrokeCap(A.Paint.Cap.ROUND)
            paint.setStrokeJoin(A.Paint.Join.ROUND)
        canvas.drawPath(build_path(ops), paint)
    if len(_ICON_CACHE) > 200:
        _ICON_CACHE.clear()
    _ICON_CACHE[key] = bmp
    return bmp


def swoosh_bitmap(w, h):
    """Soft white wave lines for the Yandex 'My Wave by track' card."""
    bmp = A.Bitmap.createBitmap(max(1, w), max(1, h), A.Bitmap.Config.ARGB_8888)
    canvas = A.Canvas(bmp)
    paint = A.Paint(1)
    paint.setStyle(A.Paint.Style.STROKE)
    paint.setStrokeCap(A.Paint.Cap.ROUND)
    curves = [
        (-0.02, 0.95, 0.10, 0.10, 0.20, 1.10, 0.34, 0.45, 4.0, 0.07),
        (-0.02, 0.95, 0.10, 0.10, 0.20, 1.10, 0.34, 0.45, 1.6, 0.45),
        (0.00, 0.62, 0.12, 0.30, 0.22, 0.95, 0.30, 0.70, 1.0, 0.18),
        (0.62, 0.88, 0.76, 0.20, 0.88, 0.95, 1.02, 0.30, 4.0, 0.07),
        (0.62, 0.88, 0.76, 0.20, 0.88, 0.95, 1.02, 0.30, 1.6, 0.45),
        (0.70, 0.62, 0.82, 0.38, 0.92, 0.80, 1.02, 0.55, 1.0, 0.18),
    ]
    for x0, y0, c1x, c1y, c2x, c2y, x1, y1, width, alpha in curves:
        path = A.Path()
        path.moveTo(F(x0 * w), F(y0 * h))
        path.cubicTo(F(c1x * w), F(c1y * h), F(c2x * w), F(c2y * h), F(x1 * w), F(y1 * h))
        paint.setStrokeWidth(F(P(width)))
        paint.setColor(jint(with_alpha(WHITE, alpha)))
        canvas.drawPath(path, paint)
    return bmp


# ---------------------------------------------------------------- storage, fonts, waveform

class Store:
    def __init__(self, path, default):
        self.path = path
        self.data = default
        self.lock = threading.Lock()
        try:
            if os.path.exists(path):
                with open(path, "r", encoding="utf-8") as f:
                    loaded = json.load(f)
                if isinstance(loaded, type(default)):
                    self.data = loaded
        except Exception:
            log_exc("store load")

    def save(self):
        try:
            with self.lock:
                tmp = self.path + ".tmp"
                with open(tmp, "w", encoding="utf-8") as f:
                    json.dump(self.data, f, ensure_ascii=False, separators=(",", ":"))
                os.replace(tmp, self.path)
        except Exception:
            log_exc("store save")

    def save_async(self):
        threading.Thread(target=self.save, name="PlayerSkins-save", daemon=True).start()


class Fonts:
    def __init__(self, directory):
        self.dir = directory
        self.cache = {}
        self.loading = set()
        self.on_ready = None

    def path(self, skin):
        return os.path.join(self.dir, FONT_FILES[skin][0])

    def get(self, skin, weight, enabled=True):
        """Typeface of the skin font, or the system one while the font is not downloaded yet."""
        key = (skin, weight)
        tf = self.cache.get(key)
        if tf is not None:
            return tf
        if enabled and skin in FONT_FILES:
            path = self.path(skin)
            if os.path.exists(path):
                try:
                    builder = A.Typeface.Builder(path)
                    builder.setFontVariationSettings("'wght' %d" % weight)
                    tf = builder.build()
                    if tf is not None:
                        self.cache[key] = tf
                        return tf
                except Exception:
                    log_exc("typeface")
            else:
                self.download(skin)
        return AndroidUtilities.bold() if weight >= 600 else AndroidUtilities.regular()

    def download(self, skin):
        if skin in self.loading:
            return
        self.loading.add(skin)
        threading.Thread(target=self._download, args=(skin,), name="PlayerSkins-font", daemon=True).start()

    def _download(self, skin):
        try:
            import requests
            name, rel = FONT_FILES[skin]
            for base in FONT_MIRRORS:
                try:
                    resp = requests.get(base + rel, timeout=(6, 30))
                    data = resp.content if resp.status_code == 200 else b""
                    if len(data) > 20000 and data[:4] in (b"\x00\x01\x00\x00", b"OTTO", b"true"):
                        os.makedirs(self.dir, exist_ok=True)
                        tmp = self.path(skin) + ".tmp"
                        with open(tmp, "wb") as f:
                            f.write(data)
                        os.replace(tmp, self.path(skin))
                        log("font %s downloaded (%d bytes)" % (name, len(data)))
                        if self.on_ready is not None:
                            ui(self.on_ready)
                        return
                    log("font %s: bad response from %s (%s)" % (name, base, resp.status_code))
                except Exception as e:
                    log("font %s: %s failed: %r" % (name, base, e))
        except Exception:
            log_exc("font download")
        finally:
            self.loading.discard(skin)


def fake_wave(seed_text, bins=WAVE_BINS):
    """Plausible-looking waveform, always the same for the same track."""
    digest = hashlib.sha256(seed_text.encode("utf-8", "replace")).digest()
    vals = []
    for i in range(bins):
        x = i / float(bins)
        b = digest[i % len(digest)] / 255.0
        b2 = digest[(i * 7 + 3) % len(digest)] / 255.0
        slow = 0.5 + 0.28 * math.sin(x * 6.2832 * (1.5 + digest[0] / 128.0) + digest[1] / 40.0)
        mid = 0.2 * math.sin(x * 6.2832 * (6 + digest[2] / 32.0) + digest[3] / 40.0)
        env = min(1.0, x * 14.0) * min(1.0, (1.0 - x) * 10.0 + 0.25)
        vals.append(max(0.08, min(1.0, (slow + mid) * (0.55 + 0.45 * b) * env + 0.12 * b2)))
    return vals


def decode_wave(path, bins=WAVE_BINS, budget=30.0):
    """Loudness sampled at `bins` positions of an audio file, 0..1. Raises on failure."""
    import audioop
    from android.media import MediaExtractor, MediaCodec
    from java import jbyte
    started = time.time()
    extractor = MediaExtractor()
    codec = None
    try:
        extractor.setDataSource(path)
        fmt = None
        mime = None
        for i in range(extractor.getTrackCount()):
            cand = extractor.getTrackFormat(i)
            m = cand.getString("mime")
            if m is not None and str(m).startswith("audio/"):
                extractor.selectTrack(i)
                fmt, mime = cand, str(m)
                break
        if fmt is None or not fmt.containsKey("durationUs"):
            raise RuntimeError("no audio track")
        duration = int(fmt.getLong("durationUs"))
        if duration <= 0:
            raise RuntimeError("zero duration")
        codec = MediaCodec.createDecoderByType(mime)
        codec.configure(fmt, None, None, 0)
        codec.start()
        info = MediaCodec.BufferInfo()
        chunk = jarray(jbyte)([0] * 4096)
        peaks = []
        for b in range(bins):
            if time.time() - started > budget:
                raise RuntimeError("time budget exceeded at bin %d" % b)
            extractor.seekTo(jlong(int(duration * (b + 0.5) / bins)), MediaExtractor.SEEK_TO_CLOSEST_SYNC)
            codec.flush()
            level = 0
            got = 0
            eos = False
            for _ in range(24):
                if not eos:
                    idx = codec.dequeueInputBuffer(jlong(5000))
                    if idx >= 0:
                        size = extractor.readSampleData(codec.getInputBuffer(idx), 0)
                        if size < 0:
                            codec.queueInputBuffer(idx, 0, 0, jlong(0), MediaCodec.BUFFER_FLAG_END_OF_STREAM)
                            eos = True
                        else:
                            codec.queueInputBuffer(idx, 0, size, jlong(int(extractor.getSampleTime())), 0)
                            extractor.advance()
                out = codec.dequeueOutputBuffer(info, jlong(5000))
                if out >= 0:
                    n = min(int(info.size), 4096) & ~1
                    if n > 0:
                        buf = codec.getOutputBuffer(out)
                        buf.position(int(info.offset))
                        buf.get(chunk, 0, n)
                        try:
                            data = bytes(chunk)[:n]
                        except Exception:
                            data = bytes((chunk[k] & 0xFF) for k in range(n))
                        level = max(level, audioop.rms(data, 2))
                        got += 1
                    codec.releaseOutputBuffer(out, False)
                    if got >= 2 or (int(info.flags) & 4):
                        break
            peaks.append(level)
        top = float(max(peaks)) if peaks else 0.0
        if top <= 0:
            raise RuntimeError("silent result")
        return [max(0.06, min(1.0, (p / top) ** 0.7)) for p in peaks]
    finally:
        try:
            if codec is not None:
                codec.stop()
                codec.release()
        except Exception:
            pass
        try:
            extractor.release()
        except Exception:
            pass


def sc_wave_bitmap(vals, up, down):
    """White mask, one bar per value: bars above the baseline and a fainter reflection under it."""
    bar, gap = max(2, P(2.2)), max(1, P(1.1))
    count = len(vals)
    width = count * (bar + gap)
    height = up + gap + down
    bmp = A.Bitmap.createBitmap(max(1, width), max(1, height), A.Bitmap.Config.ARGB_8888)
    canvas = A.Canvas(bmp)
    paint = A.Paint(1)
    paint.setStyle(A.Paint.Style.FILL)
    for i, v in enumerate(vals):
        x = i * (bar + gap)
        hu = max(P(2), int(up * v))
        hd = max(1, int(down * v))
        paint.setColor(jint(WHITE))
        canvas.drawRect(F(x), F(up - hu), F(x + bar), F(up), paint)
        paint.setColor(jint(with_alpha(WHITE, 0.5)))
        canvas.drawRect(F(x), F(up + gap), F(x + bar), F(up + gap + hd), paint)
    return bmp, width, height


# ---------------------------------------------------------------- services

class ArtistPhotos:
    """Artist photos from the public Deezer search; only the artist name leaves the device."""

    def __init__(self, directory):
        self.dir = directory
        try:
            os.makedirs(directory, exist_ok=True)
        except Exception:
            log_exc("photos dir")
        self.index = Store(os.path.join(directory, "index.json"), {})
        self.lock = threading.Lock()
        self.waiters = {}

    @staticmethod
    def norm(name):
        s = (name or "").casefold().replace("ё", "е")
        return "".join(ch for ch in s if ch.isalnum())

    def cached(self, name):
        rec = self.index.data.get(self.norm(name))
        if rec and rec.get("f"):
            path = os.path.join(self.dir, rec["f"])
            if os.path.exists(path):
                return path
        return None

    def request(self, name, done):
        """Returns a cached file path now, or None and calls done(path) on the UI thread later."""
        n = self.norm(name)
        if not n:
            return None
        path = self.cached(name)
        if path:
            return path
        rec = self.index.data.get(n)
        if rec is not None:
            retry = 7 * DAY if rec.get("miss") else 600.0
            if time.time() - float(rec.get("t", 0)) < retry:
                return None
        with self.lock:
            first = n not in self.waiters
            self.waiters.setdefault(n, []).append(done)
        if first:
            threading.Thread(target=self._fetch, args=(name, n), name="PlayerSkins-photo", daemon=True).start()
        return None

    def _fetch(self, name, n):
        fname = ""
        miss = False
        try:
            import requests
            resp = requests.get(DEEZER_SEARCH, params={"q": name, "limit": 5}, timeout=(5, 10))
            items = (resp.json().get("data") or []) if resp.status_code == 200 else []
            url = None
            miss = resp.status_code == 200
            for item in items:
                if self.norm(item.get("name", "")) == n:
                    url = item.get("picture_medium") or item.get("picture_big") or item.get("picture")
                    break
            if url and "/artist//" not in url:
                img = requests.get(url, timeout=(5, 15))
                data = img.content if img.status_code == 200 else b""
                if len(data) > 1000 and (data[:3] == b"\xff\xd8\xff" or data[:8] == b"\x89PNG\r\n\x1a\n"):
                    fname = hashlib.md5(n.encode("utf-8")).hexdigest() + ".img"
                    with open(os.path.join(self.dir, fname), "wb") as f:
                        f.write(data)
                    miss = False
        except Exception as e:
            log("photo %r: %r" % (name, e))
            miss = False
        self.index.data[n] = {"f": fname, "t": time.time(), "miss": bool(miss and not fname)}
        self.index.save()
        with self.lock:
            waiters = self.waiters.pop(n, [])
        path = os.path.join(self.dir, fname) if fname else None
        for done in waiters:
            ui(lambda done=done: done(path))


class SleepTimer:
    MINUTES = (5, 10, 15, 30, 45, 60)

    def __init__(self, plugin):
        self.p = plugin
        self.mode = None
        self.end_at = 0.0
        self.track = None
        self.ev = None

    def active(self):
        return self.mode is not None

    @staticmethod
    def label(minutes):
        return T("timer_hour") if minutes == 60 else T("timer_min") % minutes

    def remaining(self):
        if self.mode == "track":
            return T("timer_track")
        if self.mode == "time":
            return T("timer_left") % max(1, int(math.ceil((self.end_at - time.time()) / 60.0)))
        return None

    def set(self, minutes):
        """minutes > 0: pause after that long; -1: pause at the end of the current track; 0: turn off."""
        was = self.active()
        self._stop()
        if minutes == 0:
            if was:
                self.p.notify(T("timer_cancel"))
            self.p.timer_changed()
            return
        if minutes < 0:
            mo = playing()
            if mo is None:
                self.p.timer_changed()
                return
            self.mode = "track"
            self.track = msg_key(mo)
            text = T("timer_track")
        else:
            self.mode = "time"
            self.end_at = time.time() + minutes * 60.0
            text = self.label(minutes)
        ev = threading.Event()
        self.ev = ev
        threading.Thread(target=self._loop, args=(ev,), name="PlayerSkins-timer", daemon=True).start()
        log("sleep timer: %s" % text)
        self.p.notify(T("timer_set") % text)
        self.p.timer_changed()

    def _stop(self):
        if self.ev is not None:
            self.ev.set()
        self.ev = None
        self.mode = None

    def _loop(self, ev):
        while not ev.wait(0.5):
            try:
                if self.mode == "time" and time.time() >= self.end_at:
                    ui(lambda: self._fire(ev))
                    return
                if self.mode == "track":
                    mo = playing()
                    if mo is None:
                        continue
                    if msg_key(mo) != self.track:
                        ui(lambda: self._fire(ev))
                        return
                    duration = float(mo.getDuration())
                    if duration > 1 and duration - position_ms(mo) / 1000.0 <= 0.8:
                        ui(lambda: self._fire(ev))
                        return
            except Exception:
                log_exc("timer loop")

    def _fire(self, ev):
        if ev is not self.ev:
            return
        self._stop()
        mc = MediaController.getInstance()
        mo = mc.getPlayingMessageObject()
        if mo is not None and not as_bool(mc.isMessagePaused()):
            mc.pauseMessage(mo)
        log("sleep timer fired")
        self.p.notify(T("timer_fired"))
        self.p.timer_changed()

    def shutdown(self):
        self._stop()


# ---------------------------------------------------------------- widgets

class Btn:
    """An ImageView button: white-mask icon tinted with a color filter, optional shaped background."""

    def __init__(self, ctrl, name, icon, icon_dp, box, action=None, bg=None, own=True, view=None, tint="icon", bg_key=None):
        self.c = ctrl
        self.name = name
        self.icon_dp = icon_dp
        bw, bh = box if isinstance(box, tuple) else (box, box)
        self.box_w, self.box_h = P(bw), P(bh)
        self.own = own
        self.tint_key = tint
        self.bg_key = bg_key
        self.tint = None
        self.icon = None
        self.bg = None
        if view is None:
            view = A.ImageView(ctrl.ctx)
            view.setScaleType(A.ImageView.ScaleType.CENTER)
            ctrl.add_view(view, flp(self.box_w, self.box_h))
            ctrl.el[name] = view
        self.view = view
        if bg is not None:
            self.bg = round_bg(0, oval=(bg == "oval"), radius=self.box_h / 2.0)
            view.setBackground(self.bg)
        if action is not None:
            view.setOnClickListener(on_click(lambda: self._clicked(action)))
        elif own:
            view.setClickable(False)
        self.set_icon(icon)

    def _clicked(self, action):
        try:
            v = self.view
            v.setScaleX(F(0.9))
            v.setScaleY(F(0.9))
            v.animate().scaleX(F(1.0)).scaleY(F(1.0)).setDuration(jlong(160)).start()
        except Exception:
            pass
        action()

    def set_icon(self, icon, color=None, color2=None, force=False):
        key = (icon, color, color2)
        if key == self.icon and not force:
            return
        self.icon = key
        self.view.setImageBitmap(icon_bitmap(icon, P(self.icon_dp), color, color2))
        if color is not None:
            self.tint = None
            self.view.clearColorFilter()
        elif self.tint is not None:
            self.view.setColorFilter(color_filter(self.tint))

    def set_tint(self, color):
        if self.icon is not None and self.icon[1] is not None:
            return
        if color != self.tint or not self.own:
            self.tint = color
            self.view.setColorFilter(color_filter(color))

    def set_bg(self, color):
        if self.bg is not None:
            self.bg.setColor(jint(color))

    def place(self, rect):
        place(self.view, rect[0], rect[1], rect[2], rect[3])


class LineSeek:
    """A thin line with a round thumb, made of plain views."""

    def __init__(self, ctrl, track_dp=3, fill_dp=3, thumb_dp=12):
        self.c = ctrl
        self.progress = 0.0
        self.w = 0
        self.dragging = False
        self.track_h, self.fill_h, self.thumb_size = P(track_dp), P(fill_dp), P(thumb_dp)
        ctx = ctrl.ctx
        self.box = A.FrameLayout(ctx)
        self.box.setClipChildren(False)
        ctrl.add_view(self.box, flp(-1, P(32)))
        ctrl.el["seek"] = self.box
        self.track_bg = round_bg(0, radius=self.track_h / 2.0)
        self.fill_bg = round_bg(0, radius=self.fill_h / 2.0)
        self.thumb_bg = round_bg(0, oval=True)
        self.track, self.fill, self.thumb = A.View(ctx), A.View(ctx), A.View(ctx)
        self.track.setBackground(self.track_bg)
        self.fill.setBackground(self.fill_bg)
        self.thumb.setBackground(self.thumb_bg)
        self.fill.setPivotX(F(0.0))
        self.box.addView(self.track, flp(-1, self.track_h, 16))
        self.box.addView(self.fill, flp(-1, self.fill_h, 16))
        self.box.addView(self.thumb, flp(self.thumb_size, self.thumb_size, 19))
        self.box.setOnTouchListener(touch_listener(self._touch))

    def place(self, rect):
        place(self.box, *rect)
        self.w = int(rect[2])
        self._apply()

    def colors(self, track, fill, thumb):
        self.track_bg.setColor(jint(track))
        self.fill_bg.setColor(jint(fill))
        self.thumb_bg.setColor(jint(thumb))

    def set(self, progress):
        progress = clamp01(float(progress))
        if abs(progress - self.progress) < 0.0005:
            return
        self.progress = progress
        self._apply()

    def _apply(self):
        if self.w <= 0:
            return
        self.fill.setScaleX(F(max(0.0001, self.progress)))
        self.thumb.setTranslationX(F(self.w * self.progress - self.thumb_size / 2.0))

    def _touch(self, view, event):
        action = int(event.getActionMasked())
        if self.w <= 0:
            return False
        p = clamp01(float(event.getX()) / self.w)
        if action == 0:
            self.dragging = True
            parent = view.getParent()
            if parent is not None:
                parent.requestDisallowInterceptTouchEvent(True)
        if action in (0, 2) and self.dragging:
            self.progress = p
            self._apply()
            self.c.seek_preview(p)
            return True
        if action in (1, 3) and self.dragging:
            self.dragging = False
            parent = view.getParent()
            if parent is not None:
                parent.requestDisallowInterceptTouchEvent(False)
            if action == 1:
                self.c.seek_to(p)
            else:
                self.c.refresh_progress()
            return True
        return False


class ScWave:
    """SoundCloud waveform: the playhead stays in the middle and the waveform scrolls under it."""

    def __init__(self, ctrl):
        self.c = ctrl
        ctx = ctrl.ctx
        self.box = A.FrameLayout(ctx)
        ctrl.add_view(self.box, flp(-1, P(124)))
        ctrl.el["wave"] = self.box
        self.back, self.front = A.ImageView(ctx), A.ImageView(ctx)
        for v in (self.back, self.front):
            v.setScaleType(A.ImageView.ScaleType.FIT_XY)
            self.box.addView(v, flp(1, 1, 51))
        self.vals = None
        self.bmp_w = 0
        self.bmp_h = 0
        self.w = 0
        self.center = 0
        self.progress = 0.0
        self.dragging = False
        self.drag_x = 0.0
        self.drag_p = 0.0
        self.up, self.down = P(76), P(46)
        self.box.setOnTouchListener(touch_listener(self._touch))

    def set_wave(self, vals):
        self.vals = vals
        bmp, w, h = sc_wave_bitmap(vals, self.up, self.down)
        self.bmp_w, self.bmp_h = w, h
        for v in (self.back, self.front):
            v.setImageBitmap(bmp)
            v.setLayoutParams(flp(w, h, 51))
            place(v, 0, 0, w, h)
        self._apply()

    def place(self, rect, center):
        place(self.box, *rect)
        self.w = int(rect[2])
        self.center = int(center)
        if self.bmp_w:
            for v in (self.back, self.front):
                place(v, 0, 0, self.bmp_w, self.bmp_h)
        self._apply()

    def colors(self, unplayed, played):
        self.back.setColorFilter(color_filter(unplayed))
        self.front.setColorFilter(color_filter(played))

    def set(self, progress):
        progress = clamp01(float(progress))
        if abs(progress - self.progress) < 0.0002:
            return
        self.progress = progress
        self._apply()

    def _apply(self):
        if not self.bmp_w:
            return
        tx = self.center - self.progress * self.bmp_w
        self.back.setTranslationX(F(tx))
        self.front.setTranslationX(F(tx))
        self.front.setClipBounds(A.Rect(0, 0, max(0, int(self.progress * self.bmp_w)), self.bmp_h))

    def _touch(self, view, event):
        if not self.bmp_w:
            return False
        action = int(event.getActionMasked())
        x = float(event.getX())
        if action == 0:
            self.dragging = True
            self.drag_x, self.drag_p = x, self.progress
            parent = view.getParent()
            if parent is not None:
                parent.requestDisallowInterceptTouchEvent(True)
            return True
        if not self.dragging:
            return False
        p = clamp01(self.drag_p - (x - self.drag_x) / float(self.bmp_w))
        if action == 2:
            self.progress = p
            self._apply()
            self.c.seek_preview(p)
            return True
        if action in (1, 3):
            self.dragging = False
            parent = view.getParent()
            if parent is not None:
                parent.requestDisallowInterceptTouchEvent(False)
            if action == 1 and abs(x - self.drag_x) > P(4):
                self.c.seek_to(p)
            else:
                self.c.refresh_progress()
            return True
        return False


