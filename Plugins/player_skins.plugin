    like_icons = ("heart", "icon", "heart_fill", "accent", False)

    def __init__(self, ctrl):
        self.c = ctrl

    def palette(self, stats, dark):
        raise NotImplementedError

    def build(self):
        raise NotImplementedError

    def geometry(self, e):
        raise NotImplementedError

    def cover_rect(self, g):
        return g["cover"]

    def title_shift(self):
        return 0.0

    def moving(self, g):
        """Elements that move to another place in the lyrics/queue modes: name -> (main rect, compact rect)."""
        return {}

    def colors(self, pal, pc):
        pass

    def dynamic(self):
        pass

    def progress(self):
        pass

    def transitions(self, g, f):
        pass

    def track_changed(self, mo):
        pass

    def cover_loaded(self, mo, bmp):
        pass


class SpotifySkin(Skin):
    key = "spotify"
    FONT = "spotify"
    TITLE = (19, 700)
    ARTIST = (15, 400)
    SOURCE = (12, 700)
    TIME = (11.5, 400)
    always_dark = True
    fade_main = ("lyric", "lcard", "dislike")
    like_icons = ("plus_circle", "icon", "check_circle", "accent", True)

    def __init__(self, ctrl):
        super().__init__(ctrl)
        self.timer_slot = None
        self.canvas_on = False
        self.line = None
        self.lyrics_state = -1

    def palette(self, stats, dark):
        if stats is None:
            card = rgb(0x404040)
        elif stats["neutral"]:
            card = with_lum(stats["dom"], 0.045, max_s=0.12)
        else:
            card = with_lum(stats["dom"], 0.045)
        return {
            "background": rgb(0x121212), "bg_top": mix(card, rgb(0x121212), 0.3), "bg_bottom": rgb(0x121212),
            "card": card, "surface": rgb(0x282828), "status": with_alpha(BLACK, 0.2),
            "text": WHITE, "text2": with_alpha(WHITE, 0.7), "icon": WHITE,
            "accent": rgb(0x1ED760), "on_accent": BLACK,
            "fill": WHITE, "track": with_alpha(WHITE, 0.3), "thumb": WHITE,
            "play_bg": WHITE, "play_icon": BLACK,
            "placeholder": rgb(0x282828), "placeholder_icon": rgb(0x7F7F7F), "dark": True,
        }

    def build(self):
        c = self.c
        p = c.p
        if p.timer_enabled():
            self.timer_slot = "repeat" if int(p.get_setting("timer_place", 0) or 0) == 1 else "row"
        c.make_gradient_bg(status=True)
        c.make_scrims()
        c.make_thumb()
        c.text("caption", 11, 500, gravity=17, color="text", spacing=0.0)
        c.restyle("collapse", "chevron_down", 28.4, tint="icon")
        c.restyle("more", "more_v", 24.8, tint="icon")
        c.restyle("shuffle", "shuffle", 29, keep_bg=True, tint=None)
        if self.timer_slot == "repeat":
            c.hidden_extra.append("repeatButton")
        else:
            c.restyle("repeat", "repeat", 29, keep_bg=True, tint=None)
        c.add("prev", "prev", 39, 48, c.act_prev)
        c.add("play", "pause", 33, 64, c.act_play, bg="oval", tint="play_icon", bg_key="play_bg")
        c.add("next", "next", 39, 48, c.act_next)
        c.add("like", "plus_circle", 34.6, 44, c.act_like)
        c.add("dislike", "x", 38.4, 44, c.act_dislike)
        c.add("devices", "devices", 25.5, 40, c.act_cast)
        c.add("share", "share", 24, 40, c.act_share)
        c.add("queue", "queue", 21, 40, c.act_queue)
        if self.timer_slot is not None:
            c.add("timer", "timer", 28.4, 40, c.act_timer)
        c.text("lyric", 15, 700, color="text")
        c.make_lcard()
        c.make_seek(track_dp=3, fill_dp=3, thumb_dp=12)

    @property
    def menu_items(self):
        return ("speed", "order") if self.timer_slot == "repeat" else ("speed",)

    def geometry(self, e):
        cl, ct, W, cb, H = e["cl"], e["ct"], e["cw"], e["cb"], e["h"]
        mid = cl + W / 2.0
        g = {}
        hc = ct + P(33)
        g["collapse"] = C(cl + P(32), hc, P(40), P(40))
        g["more"] = C(cl + W - P(32), hc, P(40), P(40))
        g["caption"] = C(mid, ct + P(25), W - P(150), P(16))
        g["source"] = C(mid, ct + P(38.5), W - P(150), P(20))
        g["status"] = (0, 0, e["w"], ct)
        card_top = cb - P(32)
        g["lcard"] = (cl + P(16), card_top, W - P(32), H - card_top + P(24))
        row = cb - P(69)
        g["devices"] = C(cl + P(31), row, P(40), P(40))
        g["queue"] = C(cl + W - P(33), row, P(40), P(40))
        g["share"] = C(cl + W - P(83.3), row, P(40), P(40))
        tr = cb - P(142.2)
        outer = W / 2.0 - P(36.4)
        inner = outer * 0.5075
        g["shuffle"] = C(mid - outer, tr, P(40), P(40))
        right_slot = C(mid + outer, tr, P(40), P(40))
        if self.timer_slot == "repeat":
            g["timer"] = right_slot
        else:
            g["repeat"] = right_slot
            if self.timer_slot == "row":
                g["timer"] = C(cl + W - P(133.5), row, P(40), P(40))
        g["prev"] = C(mid - inner, tr, P(48), P(48))
        g["next"] = C(mid + inner, tr, P(48), P(48))
        g["play"] = C(mid, tr, P(64), P(64))
        sy = cb - P(214.9)
        g["seek"] = (cl + P(24), sy - P(16), W - P(48), P(32))
        ty = cb - P(197.5)
        g["time"] = (cl + P(24), ty - P(9), P(90), P(18))
        g["duration"] = (cl + W - P(24) - P(90), ty - P(9), P(90), P(18))
        rc = cb - P(258.6)
        g["like"] = C(cl + W - P(40), rc, P(44), P(44))
        g["dislike"] = C(cl + W - P(96), rc, P(44), P(44))
        right = cl + W - (P(124) if self.c.wants.get("dislike", False) else P(68))
        g["title"] = (cl + P(24), cb - P(267.8) - P(14), right - cl - P(24), P(28))
        g["artist"] = (cl + P(18), cb - P(248) - P(13), right - cl - P(12), P(26))
        g["thumb"] = (cl + P(24), rc - P(24), P(48), P(48))
        g["lyric"] = (cl + P(24), cb - P(332.7) - P(12), W - P(48), P(24))
        top = ct + P(99.3)
        bottom = cb - P(332.7) - P(93.1)
        size = max(0, min(W - P(48), bottom - top))
        g["cover"] = (mid - size / 2.0, top + (bottom - top - size) / 2.0, size, P(7.5))
        side = max(H, e["w"])
        g["cover_full"] = (mid - side / 2.0, (H - side) / 2.0, side, 0)
        g["scrim_top"] = (0, 0, e["w"], ct + P(110))
        g["scrim_bottom"] = (0, int(H * 0.42), e["w"], H - int(H * 0.42))
        ry = ct + P(64)
        g["cover_c"] = (cl + P(24), ry, P(48), P(4))
        g["title_c"] = (cl + P(84), ry - P(4), W - P(84) - P(64), P(28))
        g["artist_c"] = (cl + P(78), ry + P(22), W - P(84) - P(64) + P(12), P(26))
        g["like_c"] = C(cl + W - P(40), ry + P(24), P(44), P(44))
        st, sb = ry + P(48) + P(18), sy - P(30)
        g["stage"] = (cl, st, W, max(P(64), sb - st))
        return g

    def canvas(self):
        return self.c.anim.get("canvas", 0.0)

    def cover_rect(self, g):
        return lerp_rect(g["cover"], g["cover_full"], smooth(self.canvas()))

    def title_shift(self):
        return P(61) * smooth(self.canvas())

    def moving(self, g):
        return {"like": (g["like"], g["like_c"])}

    def colors(self, pal, pc):
        c = self.c
        if c.lcard_bg is not None:
            c.lcard_bg.setColor(jint(int(pc.buffer)))

    def dynamic(self):
        c = self.c
        wave = c.p.mywave()
        on = bool(wave is not None and getattr(wave, "active", False))
        if on != c.wants.get("dislike", False):
            c.want("dislike", on)
            c.L.requestLayout()
        timer = c.btn.get("timer")
        if timer is not None and c.pal is not None:
            timer.set_tint(c.pal["accent"] if c.p.timer.active() else c.pal["icon"])

    def track_changed(self, mo):
        c = self.c
        self.canvas_on = False
        c.anim_set("canvas", 0.0)
        self.line = None
        c.want("lyric", False)
        c.want("thumb", True)
        thumb = c.el.get("thumb")
        if thumb is not None:
            thumb.setImageDrawable(None)
        try:
            caption = c.txt.get("caption")
            if caption is not None and mo is not None:
                caption.setText(T(c.source_kind(mo)))
        except Exception:
            log_exc("caption")
        if mo is not None and c.mode() != 1:
            try:
                call(c.sheet, SHEET, "loadLyrics", False)
            except Exception:
                log_exc("load lyrics")

    def cover_loaded(self, mo, bmp):
        thumb = self.c.el.get("thumb")
        if thumb is not None and bmp is not None:
            thumb.setImageBitmap(cover_copy(bmp, 160))

    def progress(self):
        c = self.c
        ready = c.motion_ready()
        if ready != self.canvas_on:
            self.canvas_on = ready
            c.animate("canvas", 1.0 if ready else 0.0, 450)
        lv = c.o["lyricsView"]
        state = as_int(get_private_field(lv, "state"), 0)
        if state != self.lyrics_state:
            self.lyrics_state = state
            if state in (1, 3, 4, 5, 6, 0):
                c.want("lcard", state in (1, 3))
        text = None
        if state == 3:
            lyr = get_private_field(lv, "lyrics")
            if lyr is not None and as_bool(lyr.synced):
                mo = playing()
                if mo is not None:
                    idx = as_int(lyr.indexAt(jlong(position_ms(mo))), -1)
                    text = str(lyr.lines.get(idx).text).strip() if idx >= 0 else ""
                    if not text:
                        text = "♪"
        if text != self.line:
            self.line = text
            if text is not None:
                c.txt["lyric"].setText(text)
            c.want("lyric", text is not None)

    def transitions(self, g, f):
        c = self.c
        cv = smooth(self.canvas()) * (1.0 - f)
        for name in ("scrim_top", "scrim_bottom", "thumb"):
            c.set_alpha(name, cv)
        c.set_alpha("status", 1.0 - cv)


class YandexSkin(Skin):
    key = "yandex"
    FONT = "yandex"
    TITLE = (19, 600)
    ARTIST = (15.5, 400)
    SOURCE = (13, 500)
    TIME = (13, 400)
    hide = ("shuffleButton",)
    menu_items = ("order", "speed")
    fade_main = ("avatar0", "avatar1", "vibe")
    like_icons = ("heart", "icon2", "heart_fill", "icon_main", False)

    def __init__(self, ctrl):
        super().__init__(ctrl)
        self.avatar_n = 1
        self.photo_for = None
        self.avatar_src = {}
        self.swoosh_size = None

    def palette(self, stats, dark):
        if dark:
            bg = scale(stats["avg"], 0.66) if stats else rgb(0x1E1E1E)
            h, s, _ = hsv_of(bg)
            return {
                "background": bg, "bg_top": bg, "bg_bottom": bg, "surface": mix(bg, WHITE, 0.1),
                "text": with_alpha(WHITE, 0.9), "text2": with_alpha(WHITE, 0.5), "icon": with_alpha(WHITE, 0.55),
                "icon_main": with_alpha(WHITE, 0.92), "icon2": with_alpha(WHITE, 0.5), "icon_dim": with_alpha(WHITE, 0.5),
                "accent": rgb(0xFFFF00), "on_accent": BLACK,
                "fill": WHITE, "track": with_alpha(WHITE, 0.2), "thumb": WHITE,
                "play_bg": rgb(0xFFFF00), "play_icon": BLACK, "card": with_alpha(WHITE, 0.07),
                "pill": with_alpha(WHITE, 0.08), "pill_on": with_alpha(WHITE, 0.16), "peek": with_alpha(WHITE, 0.05),
                "card_a": with_alpha(WHITE, 0.16), "card_b": with_alpha(WHITE, 0.06),
                "vibe1": from_hsv(h, min(s * 0.5, 0.25), 0.93), "vibe2": with_alpha(WHITE, 0.93),
                "placeholder": mix(bg, WHITE, 0.08), "placeholder_icon": with_alpha(WHITE, 0.4), "dark": True,
            }
        base = stats["avg"] if stats else rgb(0xF2F2F2)
        bg = mix(base, WHITE, 0.82)
        h, s, _ = hsv_of(bg)
        return {
            "background": bg, "bg_top": bg, "bg_bottom": bg, "surface": mix(bg, BLACK, 0.04),
            "text": with_alpha(BLACK, 0.9), "text2": with_alpha(BLACK, 0.5), "icon": with_alpha(BLACK, 0.55),
            "icon_main": with_alpha(BLACK, 0.9), "icon2": with_alpha(BLACK, 0.5), "icon_dim": with_alpha(BLACK, 0.5),
            "accent": rgb(0xD4A800), "on_accent": BLACK,
            "fill": BLACK, "track": with_alpha(BLACK, 0.14), "thumb": BLACK,
            "play_bg": rgb(0xFFDD00), "play_icon": BLACK, "card": with_alpha(BLACK, 0.05),
            "pill": with_alpha(BLACK, 0.06), "pill_on": with_alpha(BLACK, 0.12), "peek": with_alpha(BLACK, 0.04),
            "card_a": with_alpha(BLACK, 0.07), "card_b": with_alpha(BLACK, 0.03),
            "vibe1": from_hsv(h, min(s * 2.0, 0.5), 0.45), "vibe2": with_alpha(BLACK, 0.9),
            "placeholder": mix(bg, BLACK, 0.06), "placeholder_icon": with_alpha(BLACK, 0.35), "dark": False,
        }

    def build(self):
        c = self.c
        c.make_peek()
        c.restyle("collapse", "chevron_down", 25.7, tint="icon_dim")
        c.restyle("more", "more_v", 26.7, tint="icon2")
        c.add("cast", "cast_y", 23.3, 40, c.act_cast, tint="icon_dim")
        c.add("qlist", "list_bullets", 26, 40, c.act_queue, tint="icon_dim")
        c.make_avatars()
        c.add("share", "upload", 26.4, 40, c.act_share, tint="icon2")
        c.make_seek(track_dp=2, fill_dp=2, thumb_dp=10)
        c.add("dislike", "heart_off", 24.5, 44, c.act_dislike, tint="icon2")
        c.add("prev", "prev_y", 31.8, 48, c.act_prev, tint="icon_main")
        c.add("play", "pause", 34.9, 64, c.act_play, bg="oval", tint="play_icon", bg_key="play_bg")
        c.add("next", "next_y", 31.8, 48, c.act_next, tint="icon_main")
        c.add("like", "heart", 24.1, 44, c.act_like)
        c.restyle("repeat", "repeat", 25.6, box=(72, 48), bg="pill", tint=None)
        c.add("lyrics", "lyrics_y", 25.5, (72, 48), c.act_lyrics, bg="pill", tint="icon2", bg_key="pill")
        c.add("download", "download", 25.5, (72, 48), c.act_download, bg="pill", tint="icon2", bg_key="pill")
        c.make_vibe_card()

    def geometry(self, e):
        cl, ct, W, cb, H = e["cl"], e["ct"], e["cw"], e["cb"], e["h"]
        mid = cl + W / 2.0
        g = {}
        hc = ct + P(24.4)
        g["collapse"] = C(cl + P(24), hc, P(40), P(40))
        g["source"] = C(mid, hc, W - P(176), P(22))
        g["cast"] = C(cl + W - P(72), hc, P(40), P(40))
        g["qlist"] = C(cl + W - P(24), hc, P(40), P(40))
        card_top = cb - P(75.3)
        g["vibe"] = (cl + P(28), card_top, W - P(56), P(51.6))
        g["peek"] = (cl + P(28), cb + P(8.3), W - P(56), P(60))
        pills = cb - P(143.7)
        g["repeat"] = C(cl + P(64), pills, P(72), P(48))
        g["lyrics"] = C(mid, pills, P(72), P(48))
        g["download"] = C(cl + W - P(64), pills, P(72), P(48))
        tr = cb - P(270.6)
        g["dislike"] = C(cl + P(39.5), tr, P(44), P(44))
        g["prev"] = C(mid - P(72), tr, P(48), P(48))
        g["play"] = C(mid, tr, P(64), P(64))
        g["next"] = C(mid + P(72), tr, P(48), P(48))
        g["like"] = C(cl + W - P(40), tr, P(44), P(44))
        sy = cb - P(337.5)
        g["seek"] = (cl + P(28), sy - P(16), W - P(56), P(32))
        ty = cb - P(325.7)
        g["time"] = (cl + P(28), ty - P(9), P(90), P(18))
        g["duration"] = (cl + W - P(28) - P(90), ty - P(9), P(90), P(18))
        row = cb - P(392.6)
        g["avatar0"] = C(cl + P(54), row, P(52), P(52))
        g["avatar1"] = C(cl + P(86), row, P(52), P(52))
        tx = cl + (P(125.1) if self.avatar_n > 1 else P(93.1))
        right = cl + W - P(112)
        g["share"] = C(cl + W - P(88), row, P(40), P(40))
        g["more"] = C(cl + W - P(40), row, P(40), P(40))
        g["title"] = (tx, row - P(9.4) - P(15), right - tx, P(30))
        g["artist"] = (tx - P(6), row + P(9.9) - P(13), right - tx + P(12), P(26))
        top = ct + P(90.6)
        bottom = row - P(49.9)
        size = max(0, min(W - P(56), bottom - top))
        g["cover"] = (mid - size / 2.0, top + (bottom - top - size) / 2.0, size, P(12))
        ry = ct + P(56)
        g["cover_c"] = (cl + P(28), ry, P(52), P(10))
        g["title_c"] = (cl + P(93), ry + P(16.6) - P(15), W - P(93) - P(112), P(30))
        g["artist_c"] = (cl + P(87), ry + P(35.9) - P(13), W - P(93) - P(112) + P(12), P(26))
        g["share_c"] = C(cl + W - P(88), ry + P(26), P(40), P(40))
        g["more_c"] = C(cl + W - P(40), ry + P(26), P(40), P(40))
        st, sb = ry + P(52) + P(16), sy - P(28)
        g["stage"] = (cl, st, W, max(P(64), sb - st))
        return g

    def moving(self, g):
        return {"share": (g["share"], g["share_c"]), "more": (g["more"], g["more_c"])}

    def colors(self, pal, pc):
        c = self.c
        if c.vibe_lock is not None:
            c.vibe_lock.setColorFilter(color_filter(pal["vibe2"]))
        if c.vibe_bg is not None:
            c.vibe_bg.setColors(jarray(jint)([pal["card_a"], pal["card_b"], pal["card_a"]]))
        if c.peek_bg is not None:
            c.peek_bg.setColor(jint(pal["peek"]))
        for i in range(2):
            av = c.el.get("avatar%d" % i)
            if av is not None:
                av.getBackground().setColor(jint(pal["placeholder"]))

    def dynamic(self):
        c = self.c
        pal = c.pal
        if pal is None:
            return
        mode = c.mode()
        lyr = c.btn.get("lyrics")
        if lyr is not None:
            lyr.set_tint(pal["icon_main"] if mode == 1 else pal["icon2"])
            lyr.set_bg(pal["pill_on"] if mode == 1 else pal["pill"])
        rep = c.btn.get("repeat")
        if rep is not None:
            rep.set_bg(pal["pill_on"] if int(SharedConfig.repeatMode) != 0 else pal["pill"])
        dl = c.btn.get("download")
        if dl is not None:
            saved = c.p.is_saved()
            dl.set_icon("check" if saved else "download")
            dl.set_tint(pal["icon2"])
            dl.view.setAlpha(F(0.4 if c.noforwards() else 1.0))
        # The card is always shown; without My Wave it is locked and explains where to get the plugin.
        c.set_vibe_locked(c.p.mywave() is None)

    def track_changed(self, mo):
        c = self.c
        title = str(mo.getMusicTitle() or "") if mo is not None else ""
        c.refresh_vibe_text(title)
        names = []
        if mo is not None:
            names = [n for n in ARTIST_SPLIT.split(str(mo.getMusicAuthor() or "")) if n.strip()][:2]
        n = max(1, len(names))
        if n != self.avatar_n:
            self.avatar_n = n
            c.L.requestLayout()
        c.want("avatar1", n > 1)
        self.photo_for = c.track_id
        self.avatar_src = {}
        for i in range(2):
            c.el["avatar%d" % i].setImageDrawable(None)
        if not c.p.photos_enabled():
            return
        for i, name in enumerate(names):
            self._photo(i, name.strip())

    def _photo(self, i, name):
        c = self.c
        track = self.photo_for

        def apply(path):
            if c.closed or self.photo_for != track or not path:
                return
            try:
                bmp = A.BitmapFactory.decodeFile(path)
                if bmp is not None:
                    c.el["avatar%d" % i].setImageBitmap(bmp)
                    self.avatar_src[i] = "photo"
            except Exception:
                log_exc("avatar")
        path = c.p.photos.request(name, apply)
        if path:
            apply(path)

    def cover_loaded(self, mo, bmp):
        c = self.c
        if bmp is None:
            return
        small = None
        for i in range(2):
            av = c.el.get("avatar%d" % i)
            if av is not None and self.avatar_src.get(i) != "photo":
                if small is None:
                    small = cover_copy(bmp, 200)
                av.setImageBitmap(small)
                self.avatar_src[i] = "cover"

    def transitions(self, g, f):
        c = self.c
        size = g.get("vibe_size")
        if c.swoosh is not None and size is not None and size != self.swoosh_size:
            self.swoosh_size = size
            c.swoosh.setImageBitmap(swoosh_bitmap(size[0], size[1]))


class SoundCloudSkin(Skin):
    key = "soundcloud"
    FONT = "soundcloud"
    TITLE = (15, 500)
    ARTIST = (15, 400)
    SOURCE = (13, 500)
    TIME = (11, 400)
    always_dark = True
    cover_hidden = True
    hide = ("shuffleButton", "repeatButton", "timeView", "durationView", "headerTitle")
    menu_items = ("lyrics", "order", "speed")
    fade_main = ("follow", "comment_bar")
    like_icons = ("heart", "icon", "heart_fill", "accent", False)

    def __init__(self, ctrl):
        super().__init__(ctrl)
        self.pill_text = None

    def palette(self, stats, dark):
        return {
            "background": rgb(0x121212), "bg_top": rgb(0x121212), "bg_bottom": rgb(0x121212), "surface": rgb(0x1E1E1E),
            "text": WHITE, "text2": rgb(0xC6C6C6), "icon": WHITE,
            "accent": rgb(0xFF5500), "on_accent": WHITE,
            "fill": rgb(0xFF5500), "track": rgb(0xE6E6E6), "thumb": WHITE,
            "play_bg": with_alpha(BLACK, 0.45), "play_icon": WHITE, "card": rgb(0x121212),
            "light": rgb(0xF3F3F3), "on_light": BLACK, "circle": with_alpha(BLACK, 0.45), "box": BLACK,
            "comment_bg": with_alpha(BLACK, 0.7), "comment_stroke": with_alpha(WHITE, 0.22),
            "placeholder": rgb(0x1E1E1E), "placeholder_icon": rgb(0x7A7A7A), "dark": True,
        }

    def build(self):
        c = self.c
        c.make_art()
        c.restyle("collapse", "chevron_down", 25, bg="oval", tint="on_light", bg_key="light")
        c.add("follow", "person_add", 25, 36, c.act_follow, bg="oval", tint="on_light", bg_key="light")
        c.add("prev", "prev", 30, 56, c.act_prev, bg="oval", tint="icon", bg_key="circle")
        c.add("play", "pause", 34, 72, c.act_play, bg="oval", tint="play_icon", bg_key="play_bg")
        c.add("next", "next", 30, 56, c.act_next, bg="oval", tint="icon", bg_key="circle")
        c.make_wave()
        c.make_time_pill()
        c.make_comment_bar()
        c.add("like", "heart", 25.5, 44, c.act_like)
        c.add("comment", "comment", 25.5, 44, c.act_comment)
        c.add("share", "share", 26.5, 44, c.act_share)
        c.add("queue", "queue_list", 24, 44, c.act_queue)
        c.restyle("more", "more_v", 23.7, tint="icon")

    def geometry(self, e):
        cl, ct, W, cb, H = e["cl"], e["ct"], e["cw"], e["cb"], e["h"]
        mid = cl + W / 2.0
        g = {}
        top = ct + P(8)
        bottom = cb - P(72)
        g["art"] = (cl, top, W, bottom - top)
        g["title"] = (cl + P(16), top + P(58.9), W - P(86), P(23.6))
        g["artist"] = (cl + P(16), top + P(83.3), W - P(86), P(22.9))
        g["title_c"], g["artist_c"] = g["title"], g["artist"]
        bx = cl + W - P(34.2)
        g["collapse"] = C(bx, top + P(82.9), P(36), P(36))
        g["follow"] = C(bx, top + P(134.9), P(36), P(36))
        base = bottom - P(143.3)
        g["wave"] = (0, base - P(76), e["w"], P(124))
        g["wave_center"] = mid
        g["tpill_base"] = (mid, base)
        g["comment_bar"] = (cl + P(16), bottom - P(94.9), W - P(32), P(57.8))
        free_top = top + P(153)
        free_bottom = base - P(76) - P(16)
        tc = (free_top + free_bottom) / 2.0
        tc_c = base - P(76) - P(44)
        for name, dx, size in (("prev", -P(84), P(56)), ("play", 0, P(72)), ("next", P(84), P(56))):
            g[name] = C(mid + dx, tc, size, size)
            g[name + "_c"] = C(mid + dx, tc_c, size, size)
        bar = bottom + P(32.2)
        xs = [cl + P(28) + (W - P(68)) * k / 4.0 for k in range(5)]
        for name, x in zip(("like", "comment", "share", "queue"), xs):
            g[name] = C(x, bar, P(44), P(44))
        g["more"] = C(xs[4], bar, P(40), P(40))
        g["cover"] = (cl, top, P(1), 0)
        g["cover_c"] = g["cover"]
        st = top + P(83.3) + P(22.9) + P(14)
        sb = tc_c - P(36) - P(12)
        g["stage"] = (cl, st, W, max(P(64), sb - st))
        return g

    def moving(self, g):
        return {name: (g[name], g[name + "_c"]) for name in ("prev", "play", "next")}

    def colors(self, pal, pc):
        c = self.c
        for tv in c.title_views() + c.artist_views():
            if tv is not None:
                tv.setBackgroundColor(jint(pal["box"]))
        if c.wave is not None:
            c.wave.colors(pal["track"], pal["fill"])
        self.pill_text = None
        self.progress()

    def track_changed(self, mo):
        c = self.c
        if mo is not None and c.wave is not None:
            c.p.request_wave(c, mo)
        c.update_art()

    def cover_loaded(self, mo, bmp):
        self.c.update_art()

    def progress(self):
        c = self.c
        tv = c.txt.get("tpill")
        if tv is None or c.pal is None:
            return
        left = str(c.v["time"].getText() or "")
        right = str(c.v["duration"].getText() or "")
        text = "%s  |  %s" % (left, right)
        if text == self.pill_text:
            return
        self.pill_text = text
        span = A.SpannableString(text)
        start = len(left) + 2
        span.setSpan(A.ForegroundColorSpan(jint(c.pal["text2"])), start + 3, len(text), A.Spanned.SPAN_EXCLUSIVE_EXCLUSIVE)
        tv.setText(span)
        c.place_time_pill()

    def transitions(self, g, f):
        self.c.set_alpha("art", lerp(1.0, 0.25, f))


SKIN_STYLES = (STYLE_SPOTIFY, STYLE_YANDEX, STYLE_SOUNDCLOUD)


def make_skin(style, ctrl):
    """The skin of a style. Spelled out, so it is plain which code runs for which setting."""
    if style == STYLE_SPOTIFY:
        return SpotifySkin(ctrl)
    if style == STYLE_YANDEX:
        return YandexSkin(ctrl)
    return SoundCloudSkin(ctrl)


# ---------------------------------------------------------------- full-screen player controller

class Ctrl:
    ORIGINALS = ("collapseButton", "moreButton", "headerTitle", "headerSubtitle", "lyricsView", "queueView", "coverView",
                 "titleView", "artistView", "profileButton", "seekBar", "timeView", "durationView", "controlsView",
                 "shuffleButton", "repeatButton", "speedButton", "lyricsButton", "queueButton")
    SHORT = {"collapse": "collapseButton", "more": "moreButton", "shuffle": "shuffleButton", "repeat": "repeatButton",
             "source": "headerTitle", "time": "timeView", "duration": "durationView"}
    HIDDEN = ("seekBar", "controlsView", "speedButton", "lyricsButton", "queueButton", "profileButton", "headerSubtitle")

    def __init__(self, plugin, sheet, style):
        A.init()
        self.p = plugin
        self.sheet = sheet
        self.style = style
        self.L = get_private_field(sheet, "playerLayout")
        if self.L is None:
            raise RuntimeError("playerLayout not found")
        self.ctx = sheet.getContext()
        self.o = {}
        for name in self.ORIGINALS:
            view = get_private_field(sheet, name)
            if view is None:
                raise RuntimeError("player field %s not found" % name)
            self.o[name] = view
        self.v = {short: self.o[full] for short, full in self.SHORT.items()}
        self.rhythm = get_private_field(sheet, "rhythmBackground")
        self.actions = get_private_field(sheet, "actions")
        self.mine = []
        self.el = {}
        self.wants = {}
        self.alphas = {}
        self.vis_state = {}
        self.btn = {}
        self.txt = {}
        self.txt_spec = {}
        self.txt_color = {}
        self.hidden_extra = []
        self.seek = None
        self.wave = None
        self.bg_draw = None
        self.lcard_bg = None
        self.vibe_bg = None
        self.vibe_line2 = None
        self.vibe_col = None
        self.vibe_lock = None
        self.vibe_locked = False
        self.swoosh = None
        self.peek_bg = None
        self.anchor = None
        self.geo = None
        self.active = True
        self.closed = False
        self.controls_shown = True
        self.pal = None
        self.track_id = None
        self.title_w = self.artist_w = None
        self.art_for = None
        self.anim = {}
        self.anim_tok = {}
        self.child_count = -1
        self.fails = 0
        self.foreign = []
        self.guard = None
        self.pinned = []
        self.pin_rect = {}
        self.pin_tr = {}
        self.mine_set = None
        self.skin = make_skin(style, self)
        self.dark = True if self.skin.always_dark else plugin.is_dark()
        self.skin.build()
        for name in ("headerTitle", "collapseButton", "moreButton"):
            try:
                self.o[name].bringToFront()
            except Exception:
                log_exc("bring to front")
        self.make_anchor()
        self.apply_static()
        self.refresh_all()
        self.refresh_colors(False)
        self.update_state()

    # ---- element registry
    def add_view(self, view, lp, index=None, above_cover=False):
        if above_cover:
            index = int(self.L.indexOfChild(self.o["coverView"])) + 1
        if index is None:
            self.L.addView(view, lp)
        else:
            self.L.addView(view, int(index), lp)
        self.mine.append(view)
        self.mine_java().add(view)

    def mine_java(self):
        if self.mine_set is None:
            from java.util import HashSet
            self.mine_set = HashSet()
        return self.mine_set

    def want(self, name, on):
        if self.wants.get(name, True) != on:
            self.wants[name] = on
            self.refresh_el(name)

    def set_alpha(self, name, a):
        a = clamp01(a)
        if abs(self.alphas.get(name, 1.0) - a) > 0.001 or name not in self.alphas:
            self.alphas[name] = a
            self.refresh_el(name)

    def refresh_el(self, name):
        view = self.el.get(name)
        if view is None:
            return
        a = self.alphas.get(name, 1.0)
        show = self.active and self.controls_shown and self.wants.get(name, True) and a > 0.01
        vis = VISIBLE if show else INVISIBLE
        if self.vis_state.get(name) != vis:
            self.vis_state[name] = vis
            view.setVisibility(vis)
        view.setAlpha(F(a))

    def refresh_all(self):
        for name in list(self.el.keys()):
            self.refresh_el(name)

    # ---- construction helpers used by skins
    def make_gradient_bg(self, status=False):
        self.bg = A.View(self.ctx)
        self.bg_draw = A.GradientDrawable()
        self.bg_draw.setOrientation(A.GradientDrawable.Orientation.TOP_BOTTOM)
        self.bg.setBackground(self.bg_draw)
        self.add_view(self.bg, flp(-1, -1), index=0)
        self.el["bg"] = self.bg
        if status:
            band = A.View(self.ctx)
            band.setBackgroundColor(jint(with_alpha(BLACK, 0.2)))
            self.add_view(band, flp(-1, P(24)), above_cover=True)
            self.el["status"] = band

    def make_scrims(self):
        for name, colors in (("scrim_top", [with_alpha(BLACK, 0.45), with_alpha(BLACK, 0.0)]),
                             ("scrim_bottom", [with_alpha(BLACK, 0.0), with_alpha(BLACK, 0.55), with_alpha(BLACK, 0.85)])):
            view = A.View(self.ctx)
            d = A.GradientDrawable()
            d.setOrientation(A.GradientDrawable.Orientation.TOP_BOTTOM)
            d.setColors(jarray(jint)(colors))
            view.setBackground(d)
            self.add_view(view, flp(-1, P(100)), above_cover=True)
            self.el[name] = view
            self.alphas[name] = 0.0

    def make_thumb(self):
        view = A.ImageView(self.ctx)
        view.setScaleType(A.ImageView.ScaleType.CENTER_CROP)
        view.setBackground(round_bg(rgb(0x282828), radius=P(4)))
        view.setClipToOutline(True)
        self.add_view(view, flp(P(48), P(48)), above_cover=True)
        self.el["thumb"] = view
        self.alphas["thumb"] = 0.0

    def make_lcard(self):
        box = A.FrameLayout(self.ctx)
        r = P(16)
        self.lcard_bg = round_bg(rgb(0x404040), radii=[r, r, r, r, 0, 0, 0, 0])
        box.setBackground(self.lcard_bg)
        tv = self._new_text(15, 700)
        tv.setText(T("lyrics_preview"))
        box.addView(tv, flp(-2, -2, 51, (P(17), P(17.5), P(17), 0)))
        self.txt["lcard_text"] = tv
        self.txt_spec["lcard_text"] = (15, 700)
        self.txt_color["lcard_text"] = "text"
        box.setOnClickListener(on_click(self.act_lyrics))
        self.add_view(box, flp(-1, P(80)))
        self.el["lcard"] = box
        self.wants["lcard"] = False

    def make_avatars(self):
        for i in range(2):
            view = A.ImageView(self.ctx)
            view.setScaleType(A.ImageView.ScaleType.CENTER_CROP)
            view.setBackground(round_bg(rgb(0x303030), oval=True))
            view.setClipToOutline(True)
            self.add_view(view, flp(P(52), P(52)))
            self.el["avatar%d" % i] = view
        self.wants["avatar1"] = False

    def make_vibe_card(self):
        box = A.FrameLayout(self.ctx)
        self.vibe_bg = A.GradientDrawable()
        self.vibe_bg.setOrientation(A.GradientDrawable.Orientation.LEFT_RIGHT)
        self.vibe_bg.setCornerRadius(F(P(20)))
        box.setBackground(self.vibe_bg)
        box.setClipToOutline(True)
        self.swoosh = A.ImageView(self.ctx)
        self.swoosh.setScaleType(A.ImageView.ScaleType.FIT_XY)
        box.addView(self.swoosh, flp(-1, -1))
        col = A.LinearLayout(self.ctx)
        col.setOrientation(A.LinearLayout.VERTICAL)
        col.setGravity(17)
        l1 = self._new_text(13, 400, gravity=17)
        l1.setText(T("vibe_by_track"))
        l2 = self._new_text(19, 700, gravity=17)
        col.addView(l1, A.LinearLayout.LayoutParams(-2, -2))
        col.addView(l2, A.LinearLayout.LayoutParams(-2, -2))
        box.addView(col, flp(-1, -2, 17, (P(16), 0, P(16), 0)))
        for name, tv, spec, colkey in (("vibe1", l1, (13, 400), "vibe1"), ("vibe2", l2, (19, 700), "vibe2")):
            self.txt[name] = tv
            self.txt_spec[name] = spec
            self.txt_color[name] = colkey
        self.vibe_line2 = l2
        self.vibe_col = col
        box.setOnClickListener(on_click(self.act_vibe))
        self.add_view(box, flp(-1, P(52)))
        self.el["vibe"] = box

    def set_vibe_locked(self, locked):
        if locked != self.vibe_locked:
            self.vibe_locked = locked
            self.refresh_vibe_text()

    def refresh_vibe_text(self, title=None):
        try:
            self._vibe_text(title)
        except Exception:
            log_exc("wave card")

    def _vibe_text(self, title):
        tv = self.vibe_line2
        if tv is None:
            return
        if title is None:
            mo = playing()
            title = str(mo.getMusicTitle() or "") if mo is not None else ""
        if self.vibe_locked:
            if self.vibe_lock is None:
                from android.graphics.drawable import BitmapDrawable
                size = P(17)
                self.vibe_lock = BitmapDrawable(self.ctx.getResources(), icon_bitmap("lock", size))
                self.vibe_lock.setBounds(0, 0, size, size)
                if self.pal is not None:
                    self.vibe_lock.setColorFilter(color_filter(self.pal["vibe2"]))
            tv.setCompoundDrawables(self.vibe_lock, None, None, None)
            tv.setCompoundDrawablePadding(P(6))
            tv.setText(title)
        else:
            tv.setCompoundDrawables(None, None, None, None)
            tv.setText("▶ " + title)
        if self.vibe_col is not None:
            self.vibe_col.setAlpha(F(0.55 if self.vibe_locked else 1.0))

    def make_peek(self):
        view = A.View(self.ctx)
        r = P(16)
        self.peek_bg = round_bg(with_alpha(WHITE, 0.05), radii=[r, r, r, r, 0, 0, 0, 0])
        view.setBackground(self.peek_bg)
        self.add_view(view, flp(-1, P(60)))
        self.el["peek"] = view

    def make_art(self):
        view = A.ImageView(self.ctx)
        view.setScaleType(A.ImageView.ScaleType.CENTER_CROP)
        view.setBackground(round_bg(rgb(0x1E1E1E), radius=P(24)))
        view.setClipToOutline(True)
        self.add_view(view, flp(-1, -1), index=0)
        self.el["art"] = view

    def make_wave(self):
        self.wave = ScWave(self)

    def make_time_pill(self):
        tv = self._new_text(11, 400, gravity=17)
        tv.setBackgroundColor(jint(BLACK))
        tv.setPadding(P(8), 0, P(8), 0)
        self.add_view(tv, flp(-2, P(20)))
        self.el["tpill"] = tv
        self.txt["tpill"] = tv
        self.txt_spec["tpill"] = (11, 400)
        self.txt_color["tpill"] = "text"

    def make_comment_bar(self):
        box = A.FrameLayout(self.ctx)
        box.setBackground(round_bg(with_alpha(BLACK, 0.7), radius=P(28.9), stroke=(max(1, P(1)), with_alpha(WHITE, 0.22))))
        hint = self._new_text(11, 400)
        hint.setText(T("comment_hint"))
        box.addView(hint, flp(-2, -2, 19, (P(32), 0, 0, 0)))
        emoji = A.TextView(self.ctx)
        emoji.setText("\U0001F525   \U0001F44F   \U0001F972")
        emoji.setTextSize(SP, F(17))
        box.addView(emoji, flp(-2, -2, 21, (0, 0, P(22), 0)))
        self.txt["comment_hint"] = hint
        self.txt_spec["comment_hint"] = (11, 400)
        self.txt_color["comment_hint"] = "text"
        box.setOnClickListener(on_click(self.act_comment))
        self.add_view(box, flp(-1, P(58)))
        self.el["comment_bar"] = box

    def make_anchor(self):
        self.anchor = A.View(self.ctx)
        self.add_view(self.anchor, flp(P(40), P(40)))

    def make_seek(self, track_dp=3, fill_dp=3, thumb_dp=12):
        self.seek = LineSeek(self, track_dp, fill_dp, thumb_dp)

    def _new_text(self, sp, weight, gravity=19):
        tv = A.TextView(self.ctx)
        tv.setTextSize(SP, F(sp))
        tv.setTypeface(self.font(weight))
        tv.setGravity(gravity)
        tv.setSingleLine(True)
        tv.setEllipsize(A.TextUtils.TruncateAt.END)
        tv.setIncludeFontPadding(False)
        return tv

    def text(self, name, sp, weight, gravity=19, color="text", spacing=0.0):
        tv = self._new_text(sp, weight, gravity)
        if spacing:
            tv.setLetterSpacing(F(spacing))
        self.add_view(tv, flp(-1, P(24)))
        self.el[name] = tv
        self.txt[name] = tv
        self.txt_spec[name] = (sp, weight)
        self.txt_color[name] = color
        return tv

    def add(self, name, icon, icon_dp, box, action, bg=None, tint="icon", bg_key=None):
        self.btn[name] = Btn(self, name, icon, icon_dp, box, action, bg=bg, tint=tint, bg_key=bg_key)

    def restyle(self, name, icon, icon_dp, box=40, keep_bg=False, bg=None, tint="icon", bg_key=None):
        """Keeps an original button (with its click handlers and menus) and only changes its look."""
        view = self.v[name]
        if not keep_bg and bg is None:
            view.setBackground(None)
        self.btn[name] = Btn(self, name, icon, icon_dp, box, None, bg=bg, own=False, view=view, tint=tint, bg_key=bg_key)

    def title_views(self):
        sw = self.o["titleView"]
        return [sw.getTextView(), sw.getNextTextView()]

    def artist_views(self):
        sw = self.o["artistView"]
        return [sw.getTextView(), sw.getNextTextView()]

    def font(self, weight):
        return self.p.fonts.get(self.skin.FONT, weight, self.p.fonts_enabled())

    def apply_static(self):
        """Typography and visibility that do not depend on layout."""
        s = self.skin
        pad = P(9) if s.cover_hidden else None
        for views, spec in ((self.title_views(), s.TITLE), (self.artist_views(), s.ARTIST)):
            for tv in views:
                if tv is not None:
                    tv.setTextSize(SP, F(spec[0]))
                    tv.setTypeface(self.font(spec[1]))
                    if pad is not None:
                        tv.setPadding(pad, 0, pad, 0)
        src = self.v["source"]
        src.setTextSize(SP, F(s.SOURCE[0]))
        src.setTypeface(self.font(s.SOURCE[1]))
        for key, gravity in (("time", 19), ("duration", 21)):
            tv = self.v[key]
            tv.setTextSize(SP, F(s.TIME[0]))
            tv.setTypeface(self.font(s.TIME[1]))
            tv.setGravity(gravity)
        for name, tv in self.txt.items():
            spec = self.txt_spec.get(name)
            if spec is not None:
                tv.setTypeface(self.font(spec[1]))
        for name in list(self.HIDDEN) + list(s.hide) + self.hidden_extra:
            self.o[name].setVisibility(GONE)

    # ---- colors
    def stats(self):
        mo = playing()
        st = self.p.stats.get(msg_key(mo)) if mo is not None else None
        if st is not None:
            return st
        try:
            if mo is not None:
                seed = as_int(find_class(PKG + ".CoverColorExtractor").getCachedSeed(mo), 0)
                if seed:
                    return {"avg": scale(seed, 0.55), "dom": seed, "neutral": False}
        except Exception:
            log_exc("seed")
        return None

    def refresh_colors(self, animated):
        pal = self.skin.palette(self.stats(), self.dark)
        self.pal = pal
        base = get_private_field(self.sheet, "colors")
        pc = base.copy()
        pc.background = pal["background"]
        pc.surfaceContainer = pal["surface"]
        pc.text = pal["text"]
        pc.textSecondary = pal["text2"]
        pc.icon = pal["icon"]
        pc.accent = pal["accent"]
        pc.onAccent = pal["on_accent"]
        pc.tonal = pal["placeholder"]
        pc.onTonal = pal["placeholder_icon"]
        pc.wave = pal["fill"]
        pc.track = pal["track"]
        pc.buffer = pal["card"]
        pc.divider = with_alpha(pal["text"], 0.12)
        glow = pc.glow
        glow[0] = pal["bg_top"]
        glow[1] = pal["bg_bottom"]
        glow[2] = pal["play_bg"]
        glow[3] = pal["play_icon"]
        pc.dark = bool(pal["dark"])
        pc.fromCover = True
        call(self.sheet, SHEET, "animateColors", pc, bool(animated))

    def on_colors(self, pc):
        """Runs after the player applied a (possibly mid-animation) palette to its own views."""
        if not self.active or self.pal is None:
            return
        pal = self.pal
        glow = pc.glow
        top, bottom, play_bg, play_icon = int(glow[0]), int(glow[1]), int(glow[2]), int(glow[3])
        if self.bg_draw is not None:
            self.bg_draw.setColors(jarray(jint)([top, bottom]))
        if self.seek is not None:
            self.seek.colors(int(pc.track), int(pc.wave), pal["thumb"])
        live = {"play_bg": play_bg, "play_icon": play_icon}
        for name, b in self.btn.items():
            if b.bg_key is not None:
                b.set_bg(live.get(b.bg_key, pal.get(b.bg_key, 0)))
            if b.tint_key is not None and name != "like":
                b.set_tint(live.get(b.tint_key, pal.get(b.tint_key, pal["icon"])))
        for name, key in self.txt_color.items():
            self.txt[name].setTextColor(jint(pal.get(key, pal["text"])))
        self.paint_like()
        self.skin.colors(pal, pc)
        self.skin.dynamic()

    def paint_like(self):
        b = self.btn.get("like")
        if b is None or self.pal is None:
            return
        off, off_key, on, on_key, bicolor = self.skin.like_icons
        if self.p.is_liked():
            if bicolor:
                b.set_icon(on, self.pal[on_key], self.pal["on_accent"])
            else:
                b.set_icon(on)
                b.set_tint(self.pal[on_key])
        else:
            b.set_icon(off)
            b.set_tint(self.pal[off_key])

    # ---- state
    def mode(self):
        try:
            return int(jfield(SHEET, "mode").getInt(self.sheet))
        except Exception:
            return 0

    def noforwards(self):
        try:
            return bool(jfield(SHEET, "noforwards").getBoolean(self.sheet))
        except Exception:
            return False

    def update_state(self):
        """Play/pause picture, like, repeat picture, mode buttons."""
        if not self.active:
            return
        mc = MediaController.getInstance()
        paused = as_bool(mc.isMessagePaused())
        play = self.btn.get("play")
        if play is not None:
            play.set_icon("play" if paused else "pause")
        rep = self.btn.get("repeat")
        if rep is not None:
            rep.set_icon("repeat_one" if int(SharedConfig.repeatMode) == 2 else "repeat", force=True)
        sh = self.btn.get("shuffle")
        if sh is not None:
            sh.set_icon("shuffle", force=True)
        self.hide_stock_header()
        mo = mc.getPlayingMessageObject()
        track = msg_key(mo) if mo is not None else None
        if track != self.track_id:
            self.track_id = track
            self.on_track_changed(mo)
        pc = get_private_field(self.sheet, "colors")
        if pc is not None and self.pal is not None:
            self.on_colors(pc)

    def hide_stock_header(self):
        if not self.active:
            return
        for name in ("profileButton", "headerSubtitle"):
            view = self.o[name]
            if int(view.getVisibility()) != GONE:
                view.setVisibility(GONE)

    def current_cover(self):
        """Bitmap of the cover the player shows, if it already belongs to the playing track."""
        try:
            cover = self.o["coverView"]
            cmo = cover.getMessageObject()
            receiver = cover.getImageReceiver()
            if cmo is None or receiver is None or msg_key(cmo) != self.track_id:
                return None
            if as_bool(get_private_field(cover, "placeholders")[as_int(get_private_field(cover, "current"), 0)]):
                return None
            bmp = receiver.getBitmap()
            if bmp is None or as_bool(bmp.isRecycled()):
                return None
            return bmp
        except Exception:
            log_exc("current cover")
            return None

    def on_track_changed(self, mo):
        self.art_for = None
        bmp = self.current_cover() if mo is not None else None
        if bmp is not None and self.track_id not in self.p.stats:
            try:
                self.p.stats[self.track_id] = cover_stats(bmp)
            except Exception:
                log_exc("stats on track change")
        self.skin.track_changed(mo)
        if bmp is not None:
            self.skin.cover_loaded(mo, bmp)
        if self.pal is not None:
            self.refresh_colors(True)

    def cover_loaded(self, mo, receiver):
        key = msg_key(mo)
        bmp = receiver.getBitmap() if receiver is not None else None
        if bmp is None or as_bool(bmp.isRecycled()):
            return
        fresh = key not in self.p.stats
        if fresh:
            self.p.stats[key] = cover_stats(bmp)
            if len(self.p.stats) > 60:
                for old in list(self.p.stats.keys())[:20]:
                    self.p.stats.pop(old, None)
        if key == self.track_id:
            self.skin.cover_loaded(mo, bmp)
            if fresh:
                self.refresh_colors(True)

    def update_art(self):
        """Artwork as the full-bleed SoundCloud card."""
        art = self.el.get("art")
        if art is None or self.art_for == self.track_id:
            return
        try:
            bmp = self.current_cover()
            if bmp is None:
                return
            art.setImageBitmap(cover_copy(bmp))
            self.art_for = self.track_id
        except Exception:
            log_exc("art")

    def motion_ready(self):
        """True once the player shows the first frame of a live (motion) cover."""
        try:
            cover = self.o["coverView"]
            cur = as_int(get_private_field(cover, "current"), 0)
            paths = get_private_field(cover, "motionPaths")
            shown = get_private_field(cover, "motionShownAt")
            if paths is None or shown is None:
                return False
            return paths[cur] is not None and int(shown[cur]) != 0
        except Exception:
            log_exc("motion state")
            return False

    def source_kind(self, mo):
        try:
            if get_private_field(self.sheet, "savedMusicList") is not None:
                return "from_profile"
            if as_bool(MediaController.getInstance().currentPlaylistIsGlobalSearch()):
                return "from_search"
            did = int(mo.getDialogId())
            acc = int(mo.currentAccount)
            if did == int(UserConfig.getInstance(acc).getClientUserId()):
                return "from_saved"
            if did < 0:
                from org.telegram.messenger import MessagesController, ChatObject
                chat = MessagesController.getInstance(acc).getChat(A.Long.valueOf(-did))
                if chat is not None and as_bool(ChatObject.isChannel(chat)) and not as_bool(chat.megagroup):
                    return "from_channel"
                return "from_group"
            if did > 0:
                return "from_chat"
        except Exception:
            log_exc("source kind")
        return "from_music"

    # ---- animation
    def anim_set(self, key, value):
        self.anim_tok.pop(key, None)
        self.anim[key] = value
        self.on_transitions()

    def animate(self, key, target, ms):
        start = self.anim.get(key, 0.0)
        t0 = time.time()
        token = object()
        self.anim_tok[key] = token

        def step():
            if self.closed or self.anim_tok.get(key) is not token:
                return
            k = clamp01((time.time() - t0) * 1000.0 / ms)
            self.anim[key] = lerp(start, target, k)
            self.on_transitions()
            if k < 1.0:
                ui(step, 16)
            else:
                self.anim_tok.pop(key, None)
        step()

    # ---- layout
    def env(self):
        L = self.L
        h = int(L.getHeight())
        try:
            nav = as_int(call(L, LAYOUT, "getNavigationBottomInset"))
        except Exception:
            log_exc("nav inset")
            nav = 0
        return {
            "cl": int(jfield(LAYOUT, "contentLeft").getInt(L)),
            "ct": int(jfield(LAYOUT, "contentTop").getInt(L)),
            "cw": int(jfield(LAYOUT, "contentWidth").getInt(L)),
            "cb": h - nav,
            "w": int(L.getWidth()), "h": h,
        }

    def usable(self):
        L = self.L
        return bool(jfield(LAYOUT, "fullscreen").getBoolean(L)) and not bool(jfield(LAYOUT, "landscape").getBoolean(L))

    def set_active(self, active):
        if active == self.active:
            return
        self.active = active
        log("skin %s" % ("active" if active else "passive (landscape/tablet)"))
        for view in self.mine:
            view.setVisibility(VISIBLE if active else GONE)
        self.vis_state.clear()
        hidden = list(self.HIDDEN) + list(self.skin.hide) + self.hidden_extra
        for name in hidden:
            if name in ("profileButton", "headerSubtitle"):
                continue
            self.o[name].setVisibility(GONE if active else VISIBLE)
        for name, view in self.o.items():
            view.setTranslationX(F(0))
            view.setTranslationY(F(0))
        self.child_count = -1
        if not active:
            self.release_foreign()
        if active:
            self.refresh_all()
        else:
            call(self.sheet, SHEET, "updateProfileState", False)
            call(self.sheet, SHEET, "updateHeader")
        self.L.requestLayout()

    def on_layout(self):
        if self.closed:
            return
        usable = self.usable()
        if usable != self.active:
            self.set_active(usable)
        if not self.active:
            return
        e = self.env()
        if e["cw"] <= 0 or e["h"] <= 0:
            return
        g = self.skin.geometry(e)
        self.geo = g
        if "bg" in self.el:
            place(self.el["bg"], 0, 0, e["w"], e["h"])
        for name, rect in g.items():
            if not isinstance(rect, tuple) or len(rect) < 4:
                continue
            if name in self.btn:
                self.btn[name].place(rect)
            elif name == "seek" and self.seek is not None:
                self.seek.place(rect[:4])
            elif name == "wave" and self.wave is not None:
                self.wave.place(rect[:4], g["wave_center"] - rect[0])
            elif name in self.el:
                place(self.el[name], *rect[:4])
            elif name in ("source", "time", "duration"):
                place(self.v[name], *rect[:4])
        if "vibe" in g:
            g["vibe_size"] = (int(g["vibe"][2]), int(g["vibe"][3]))
        if "more" in g:
            place(self.anchor, *g["more"][:4])
        if not bool(jfield(LAYOUT, "keyboardLayout").getBoolean(self.L)):
            sx, sy, sw, sh = g["stage"]
            place(self.o["lyricsView"], sx, sy, sw, sh)
            place(self.o["queueView"], sx, sy, sw, sh)
        pins, rects = [], {}
        for name, rect in g.items():
            if not isinstance(rect, tuple) or len(rect) < 4:
                continue
            if name in self.btn and not self.btn[name].own:
                view = self.btn[name].view
            elif name in ("source", "time", "duration"):
                view = self.v[name]
            else:
                continue
            rects[name] = (int(rect[0]), int(rect[1]), max(0, int(rect[2])), max(0, int(rect[3])))
            pins.append((name, view))
        self.pinned, self.pin_rect = pins, rects
        self.title_w = self.artist_w = None
        self.scan_foreign()
        self.place_time_pill()
        self.on_transitions()
        self.refresh_progress()

    def place_time_pill(self):
        tv = self.el.get("tpill")
        g = self.geo
        if tv is None or g is None or "tpill_base" not in g:
            return
        cx, base = g["tpill_base"]
        w = int(tv.getPaint().measureText(str(tv.getText()))) + P(20)
        place(tv, cx - w / 2.0, base - P(20), w, P(20))

    def scan_foreign(self):
        """Finds the views other plugins put into the player, My Wave's likes and streak bar for example.

        They are laid out for the stock player, so on a skin they land on top of its buttons. The skin has its
        own buttons for the same things, placed as in the original app (likes go through My Wave as well),
        so while the skin is shown those views stay hidden and the buttons the skin moved stay where it put them.
        """
        try:
            L = self.L
            count = int(L.getChildCount())
            if count == self.child_count:
                return
            self.child_count = count
            own = self.own_views()
            mine = self.mine_java()
            cast = get_private_field(self.sheet, "castButton")
            found = []
            for i in range(count):
                child = L.getChildAt(i)
                if child is None or bool(own.contains(child)) or bool(mine.contains(child)):
                    continue
                if cast is not None and child.equals(cast):
                    continue
                if str(child.getClass().getName()).endswith("HintView2"):
                    continue
                found.append(child)
            entries = []
            for view in found:
                old = next((e for e in self.foreign if e[0].equals(view)), None)
                entries.append(old if old is not None else [view, None])
            if len(entries) != len(self.foreign) or any(e[1] is None for e in entries):
                log("views of other plugins in the player: %s" %
                    (", ".join(str(e[0].getClass().getName()) for e in entries) or "none"))
            self.foreign = entries
            self.update_guard()
            self.enforce()
        except Exception:
            log_exc("other plugins' views")

    def own_views(self):
        """exteraGram's own player views. The layout keeps them in a set; if a later version renames it,
        every view the player sheet holds in a field counts as its own."""
        try:
            return jfield(LAYOUT, "ownViews").get(self.L)
        except Exception:
            pass
        from java.util import HashSet
        known = HashSet()
        try:
            for f in jclass_obj(SHEET).getDeclaredFields():
                try:
                    f.setAccessible(True)
                    value = f.get(self.sheet)
                    if isinstance(value, A.View):
                        known.add(value)
                except Exception:
                    pass
        except Exception:
            log_exc("player fields")
        for view in self.o.values():
            known.add(view)
        return known

    def update_guard(self):
        need = self.active and not self.closed and (bool(self.foreign) or self.p.mywave() is not None)
        if need and self.guard is None:
            self.guard = predraw_listener(self.enforce)
            self.L.getViewTreeObserver().addOnPreDrawListener(self.guard)
        elif not need and self.guard is not None:
            self.remove_guard()

    def remove_guard(self):
        guard, self.guard = self.guard, None
        if guard is not None:
            try:
                self.L.getViewTreeObserver().removeOnPreDrawListener(guard)
            except Exception:
                log_exc("remove guard")

    def enforce(self):
        """Runs before every frame while another plugin shares the player: the last word on what is shown where.
        Never requests a new layout pass, so two plugins can not keep each other busy."""
        if self.closed or not self.active:
            return
        if self.p.hide_others():
            for e in self.foreign:
                view = e[0]
                vis = int(view.getVisibility())
                if vis == VISIBLE:
                    e[1] = VISIBLE
                    view.setVisibility(INVISIBLE)
                elif vis == GONE:
                    e[1] = GONE
        for name, view in self.pinned:
            rect = self.pin_rect.get(name)
            if rect is not None:
                x, y, w, h = rect
                if int(view.getLeft()) != x or int(view.getTop()) != y or int(view.getWidth()) != w \
                        or int(view.getHeight()) != h:
                    view.measure(exact(w), exact(h))
                    view.layout(x, y, x + w, y + h)
            tx, ty = self.pin_tr.get(name, (0.0, 0.0))
            if abs(float(view.getTranslationX()) - tx) > 0.5:
                view.setTranslationX(F(tx))
            if abs(float(view.getTranslationY()) - ty) > 0.5:
                view.setTranslationY(F(ty))
        for name in list(self.HIDDEN) + list(self.skin.hide) + self.hidden_extra:
            if name in ("profileButton", "headerSubtitle"):
                continue
            view = self.o[name]
            if int(view.getVisibility()) == VISIBLE:
                view.setVisibility(INVISIBLE)

    def release_foreign(self):
        """Gives other plugins their views back (landscape, the skin turned off, the plugin unloaded)."""
        self.remove_guard()
        for e in self.foreign:
            try:
                if e[1] == VISIBLE and int(e[0].getVisibility()) == INVISIBLE:
                    e[0].setVisibility(VISIBLE)
            except Exception:
                log_exc("release")
        self.foreign = []
        self.child_count = -1

    def on_transitions(self):
        """Runs after every frame of the player's own mode animation and re-asserts the skin geometry."""
        if self.closed or not self.active or self.geo is None:
            return
        g = self.geo
        sheet, L = self.sheet, self.L
        keyboard = bool(jfield(LAYOUT, "keyboardLayout").getBoolean(L))
        self.show_controls(not keyboard)
        if keyboard:
            return
        f = clamp01(float(jfield(SHEET, "modeProgress").getFloat(sheet)))
        cover = self.o["coverView"]
        a, b = self.skin.cover_rect(g), g["cover_c"]
        cover.setCoverRect(F(lerp(a[0], b[0], f)), F(lerp(a[1], b[1], f)), F(lerp(a[2], b[2], f)), F(lerp(a[3], b[3], f)), F(f))
        cover.setHideProgress(F(1.0 if self.skin.cover_hidden else 0.0))
        shift = self.skin.title_shift() * (1.0 - f)
        t, ar = g["title"], g["artist"]
        main_t = (t[0] + shift, t[1], t[2] - shift, t[3])
        main_a = (ar[0] + shift, ar[1], ar[2] - shift, ar[3])
        self.move(self.o["titleView"], main_t, g["title_c"], f, "title_w")
        self.move(self.o["artistView"], main_a, g["artist_c"], f, "artist_w")
        tr = {}
        for name, (main, comp) in self.skin.moving(g).items():
            view = self.btn[name].view if name in self.btn else self.el.get(name)
            if view is not None:
                tx, ty = (comp[0] - main[0]) * f, (comp[1] - main[1]) * f
                tr[name] = (tx, ty)
                view.setTranslationX(F(tx))
                view.setTranslationY(F(ty))
        self.pin_tr = tr
        for name in self.skin.fade_main:
            self.set_alpha(name, 1.0 - smooth(f * 1.6))
        self.skin.transitions(g, f)

    def move(self, view, main, compact, f, width_attr):
        x, y = lerp(main[0], compact[0], f), lerp(main[1], compact[1], f)
        w = int(lerp(main[2], compact[2], f))
        if getattr(self, width_attr) != w or int(view.getWidth()) != w or int(view.getLeft()) != int(main[0]) \
                or int(view.getTop()) != int(main[1]):
            setattr(self, width_attr, w)
            place(view, main[0], main[1], w, main[3])
        view.setTranslationX(F(x - main[0]))
        view.setTranslationY(F(y - main[1]))

    def show_controls(self, shown):
        if shown == self.controls_shown:
            return
        self.controls_shown = shown
        self.refresh_all()

    # ---- progress
    def refresh_progress(self):
        if not self.active:
            return
        try:
            p = float(self.o["seekBar"].getProgress())
            if self.seek is not None and not self.seek.dragging:
                self.seek.set(p)
            if self.wave is not None and not self.wave.dragging:
                self.wave.set(p)
            self.skin.progress()
        except Exception:
            log_exc("progress")

    def seek_preview(self, p):
        mo = playing()
        if mo is not None:
            self.v["time"].setText(str(AndroidUtilities.formatShortDuration(int(float(mo.getDuration()) * p))))
            self.skin.progress()

    def seek_to(self, p):
        mc = MediaController.getInstance()
        mo = mc.getPlayingMessageObject()
        if mo is None:
            return
        mc.seekToProgress(mo, F(p))
        jfield(SHEET, "lastTime").setInt(self.sheet, -1)
        call(self.sheet, SHEET, "updateProgress", mo)

    # ---- actions
    def act_play(self):
        call(self.sheet, SHEET, "togglePlay")

    def act_prev(self):
        if playing() is None:
            return
        jfield(SHEET, "pendingDirection").setInt(self.sheet, -1)
        MediaController.getInstance().playPreviousMessage()

    def act_next(self):
        if playing() is None:
            return
        jfield(SHEET, "pendingDirection").setInt(self.sheet, 1)
        MediaController.getInstance().playNextMessage()

    def act_lyrics(self):
        call(self.sheet, SHEET, "selectMode", jint(0 if self.mode() == 1 else 1))

    def act_queue(self):
        call(self.sheet, SHEET, "selectMode", jint(0 if self.mode() == 2 else 2))

    def act_share(self):
        mo = playing()
        if mo is None or self.actions is None:
            return
        if self.noforwards():
            self.bulletin(T("protected"))
            return
        self.actions.forward(mo, False)

    def act_like(self):
        self.p.toggle_like(self)
        ui(self.update_state, 50)

    def act_dislike(self):
        self.p.dislike(self)

    def act_timer(self):
        opts = call(self.sheet, SHEET, "makeMenu", self.btn["timer"].view, False, True)
        self.p.fill_timer_menu(opts, opts.dismiss)
        opts.setGravity(5)
        opts.show()

    def act_cast(self):
        try:
            if not bool(jfield(SHEET, "castAvailable").getBoolean(self.sheet)):
                self.bulletin(T("no_cast"))
                return
            btn = get_private_field(self.sheet, "castButton")
            AndroidUtilities.removeFromParent(btn)
            btn.setVisibility(INVISIBLE)
            self.L.addView(btn, flp(P(1), P(1)))
            from org.telegram.messenger.chromecast import ChromecastController
            ChromecastController.getInstance().setCurrentMediaAndCastIfNeeded(MediaController.getInstance().getCurrentChromecastMedia())
            ui(lambda: btn.performClick(), 80)
        except Exception:
            log_exc("cast")
            self.bulletin(T("no_cast"))

    def act_download(self):
        mo = playing()
        if mo is None or self.actions is None:
            return
        if self.noforwards():
            self.bulletin(T("protected"))
            return
        self.actions.saveToMusic(mo)
        self.p.mark_saved()
        self.skin.dynamic()

    def act_vibe(self):
        self.p.mywave_miss_at = 0.0
        wave = self.p.mywave()
        if wave is not None:
            self.set_vibe_locked(False)
            wave.action_track_wave()
            return
        self.set_vibe_locked(True)
        self.show_wave_needed()

    def activity(self):
        act = get_private_field(self.actions, "activity") if self.actions is not None else None
        return act if act is not None else self.ctx

    def show_wave_needed(self):
        """Explains the lock and offers the post where My Wave is published."""
        try:
            from org.telegram.ui.ActionBar import AlertDialog
            b = AlertDialog.Builder(self.activity())
            b.setTitle(T("wave_needed"))
            b.setMessage(T("wave_needed_text"))
            b.setPositiveButton(T("open_post"), dialog_button(self.open_post))
            b.setNegativeButton(T("close"), dialog_button(lambda: None))
            b.show()
        except Exception:
            log_exc("wave dialog")
            self.bulletin(T("wave_needed"))

    def open_post(self):
        act = self.activity()
        try:
            self.sheet.dismiss()
        except Exception:
            log_exc("dismiss player")

        def go():
            try:
                from org.telegram.messenger.browser import Browser
                Browser.openUrl(act, MYWAVE_POST)
            except Exception:
                log_exc("open post")
        ui(go, 250)

    def act_follow(self):
        mo = playing()
        if mo is not None and self.actions is not None:
            self.actions.searchArtist(str(mo.getMusicAuthor() or ""))

    def act_comment(self):
        mo = playing()
        if mo is None or self.actions is None:
            return
        if int(mo.getId()) <= 0:
            self.bulletin(T("no_chat"))
            return
        self.actions.showInChat(mo)

    def bulletin(self, text):
        try:
            from org.telegram.messenger import R as R_tg
            call(self.sheet, SHEET, "bulletins").createSimpleBulletin(R_tg.raw.info, text).show()
        except Exception:
            toast(text)

    def menu_action(self, kind):
        if kind == "speed":
            call(self.sheet, SHEET, "showSpeedMenu", self.anchor)
        elif kind == "order":
            call(self.sheet, SHEET, "showOrderMenu", self.anchor)
        elif kind == "lyrics":
            self.act_lyrics()
        elif kind == "dislike":
            self.act_dislike()

    def close(self):
        if not self.closed:
            try:
                self.release_foreign()
            except Exception:
                log_exc("close")
        self.closed = True


# ---------------------------------------------------------------- plugin

class PlayerSkinsPlugin(BasePlugin):
    def on_plugin_load(self):
        self.ctrl = None
        self.hooks_ok = {}
        self.mywave_inst = None
        self.mywave_miss_at = 0.0
        self.wave_jobs = set()
        self.mini_paint = None
        self.menu_for = None
        self.stats = {}
        base = os.path.join(get_plugins_dir(), "player_skins_data")
        try:
            os.makedirs(base, exist_ok=True)
        except Exception:
            log_exc("data dir")
        self.dir = base
        self.fonts = Fonts(os.path.join(base, "fonts"))
        self.fonts.on_ready = self._fonts_ready
        self.likes = Store(os.path.join(base, "likes.json"), {})
        self.saved = Store(os.path.join(base, "saved.json"), {})
        self.waves = Store(os.path.join(base, "waves.json"), {})
        self.photos = ArtistPhotos(os.path.join(base, "artists"))
        self.timer = SleepTimer(self)
        log("load: version %s, style=%s, theme=%s" % (__version__, self.style(), self.get_setting("theme", 0)))
        self._install_hooks()
        ui(self._attach_existing, 300)

    def on_plugin_unload(self):
        try:
            self.timer.shutdown()
            ctrl = self.ctrl
            self.ctrl = None
            if ctrl is not None:
                ctrl.close()
        except Exception:
            log_exc("unload")

    # ---- settings
    def style(self):
        try:
            return int(self.get_setting("style", STYLE_SPOTIFY) or 0)
        except Exception:
            return STYLE_OFF

    def style_name(self, style=None):
        style = self.style() if style is None else style
        return STYLE_NAMES[style] if 0 < style < len(STYLE_NAMES) else None

    def per_style(self, name, style=None):
        """A switch kept separately for every style. Before 0.4 it was one for all, so that value is the default."""
        key = self.style_name(style)
        legacy = self.get_setting(name, True)
        if key is None:
            return bool(legacy)
        return bool(self.get_setting("%s_%s" % (name, key), legacy))

    def fonts_enabled(self):
        return self.per_style("fonts")

    def photos_enabled(self):
        return bool(self.get_setting("photos", True))

    def hide_others(self):
        return self.per_style("others")

    def timer_enabled(self):
        return self.per_style("timer")

    def is_dark(self):
        theme = int(self.get_setting("theme", 0) or 0)
        if theme == 0:
            return True
        if theme == 1:
            return False
        try:
            from org.telegram.ui.ActionBar import Theme
            return bool(Theme.isCurrentThemeDark())
        except Exception:
            return True

    def create_settings(self):
        """Only the selected style's settings are listed; picking another style rebuilds the page."""
        _RU[0] = None
        style = self.style()
        items = [
            Header(text=T("hdr_main")),
            Selector(key="style", text=T("style"), default=STYLE_SPOTIFY,
                     items=[T("style_off"), "Spotify", T("style_y"), "SoundCloud"], icon="msg_filled_data_music",
                     on_change=self._style_changed),
        ]
        name = self.style_name(style)
        if name is None:
            items.append(Divider(text=T("pick_style")))
            items.append(Text(text=T("log"), icon="msg_info", on_click=lambda v: self.send_log()))
            return items
        if style == STYLE_SPOTIFY:
            title = "Spotify"
        elif style == STYLE_YANDEX:
            title = T("style_y")
        else:
            title = "SoundCloud"
        items.append(Header(text=T("hdr_style") % title))
        if style == STYLE_YANDEX:
            items.append(Selector(key="theme", text=T("theme"), default=0,
                                  items=[T("theme_dark"), T("theme_light"), T("theme_tg")], on_change=self._changed))
        items.append(Switch(key="fonts_" + name, text=T("font_one"), subtext=T("font_one_sub") % FONT_NAMES[name],
                            default=self.per_style("fonts"), on_change=self._changed))
        if style == STYLE_YANDEX:
            items.append(Switch(key="photos", text=T("photos"), subtext=T("photos_sub"), default=True,
                                on_change=self._changed))
        if style == STYLE_SOUNDCLOUD:
            items.append(Switch(key="real_wave", text=T("wave"), subtext=T("wave_sub"), default=True))
        items.append(Switch(key="mini_" + name, text=T("mini"), default=self.per_style("mini"), on_change=self._changed))
        timer_on = self.per_style("timer")
        if style == STYLE_SPOTIFY:
            items.append(Switch(key="timer_" + name, text=T("timer_on"), subtext=T("timer_sub_button"), default=timer_on,
                                on_change=self._spotify_timer_changed))
            if timer_on:
                items.append(Selector(key="timer_place", text=T("timer_place"), default=0,
                                      items=[T("timer_row"), T("timer_repeat")], on_change=self._changed))
        else:
            items.append(Switch(key="timer_" + name, text=T("timer_on"), subtext=T("timer_sub_menu"), default=timer_on,
                                on_change=self._changed))
        items.append(Switch(key="others_" + name, text=T("others"), subtext=T("others_sub"),
                            default=self.per_style("others"), on_change=self._changed))
        note = T("note_common")
        if style in (STYLE_SPOTIFY, STYLE_SOUNDCLOUD):
            note += " " + T("note_dark")
        items.append(Divider(text=note))
        items.append(Text(text=T("log"), icon="msg_info", on_click=lambda v: self.send_log()))
        return items

    def _style_changed(self, value):
        self._rebuild_on("style", value)

    def _spotify_timer_changed(self, value):
        self._rebuild_on("timer_spotify", value)

    def _rebuild_on(self, key, value):
        """Saves the value once more, this time asking exteraGram to rebuild the settings page."""
        self._changed()

        def rebuild():
            try:
                self.set_setting(key, value, reload_settings=True)
            except Exception:
                log_exc("rebuild settings")
        ui(rebuild, 50)

    def _changed(self, *args):
        try:
            if self.ctrl is not None and not self.ctrl.closed:
                toast(T("reopen"))
        except Exception:
            pass

    def send_log(self):
        def job():
            try:
                from client_utils import send_document
                path = os.path.join(self.dir, "player_skins_log.txt")
                lines = ["Player Skins %s" % __version__, "hooks: %s" % self.hooks_ok,
                         "style=%s theme=%s fonts=%s mini=%s photos=%s timer=%s/%s others=%s wave=%s" % (
                             self.style(), self.get_setting("theme", 0), self.fonts_enabled(), self.per_style("mini"),
                             self.photos_enabled(), self.timer_enabled(), self.get_setting("timer_place", 0),
                             self.hide_others(), self.get_setting("real_wave", True)),
                         "controller: %s" % ("yes" if self.ctrl is not None else "no"), ""] + list(LOG)
                with open(path, "w", encoding="utf-8") as f:
                    f.write("\n".join(lines))
                me = int(UserConfig.getInstance(UserConfig.selectedAccount).getClientUserId())
                send_document(me, path, caption="Player Skins %s log" % __version__)
                toast(T("log_sent"), "show_success")
            except Exception:
                log_exc("send log")
                toast(T("log_fail"), "show_error")
        threading.Thread(target=job, name="PlayerSkins-log", daemon=True).start()

    def _fonts_ready(self):
        ctrl = self.ctrl
        if ctrl is not None and not ctrl.closed and ctrl.active:
            ctrl.apply_static()
            ctrl.L.requestLayout()

    def notify(self, text):
        ctrl = self.ctrl
        if ctrl is not None and not ctrl.closed:
            ui(lambda: ctrl.bulletin(text))
        else:
            toast(text)

    def timer_changed(self):
        ctrl = self.ctrl
        if ctrl is not None and not ctrl.closed and ctrl.active:
            ui(ctrl.skin.dynamic)

    # ---- hooks
    def _hook(self, cls, name, before=None, after=None, sheet_only=True, layout=False):
        try:
            if before is not None:
                self.hook_all_methods(cls, name, before=self._safe(before, name, sheet_only, layout))
            else:
                self.hook_all_methods(cls, name, after=self._safe(after, name, sheet_only, layout))
            self.hooks_ok[name] = "ok"
        except Exception as e:
            self.hooks_ok[name] = "failed: %r" % (e,)
            log_exc("hook " + name)

    def _install_hooks(self):
        sheet = find_class(SHEET)
        layout = find_class(LAYOUT)
        if sheet is None or layout is None:
            self.hooks_ok["player"] = "class not found"
            log("new player classes not found - nothing to style")
            return
        try:
            self.hook_all_constructors(sheet, after=self._safe(self._on_created, "constructor", False, False))
            self.hooks_ok["constructor"] = "ok"
        except Exception as e:
            self.hooks_ok["constructor"] = "failed: %r" % (e,)
            log_exc("hook constructor")
        self._hook(layout, "onLayout", after=lambda c, p: c.on_layout(), layout=True)
        self._hook(sheet, "applyTransitions", after=lambda c, p: c.on_transitions())
        self._hook(sheet, "applyColors", after=lambda c, p: c.on_colors(p.args[0]))
        self._hook(sheet, "updateCoverColors", before=self._cover_colors)
        self._hook(sheet, "onCoverBitmapLoaded", after=self._cover_loaded)
        self._hook(sheet, "updateProgress", after=lambda c, p: c.refresh_progress())
        self._hook(sheet, "bindMessage", after=lambda c, p: c.update_state())
        self._hook(sheet, "updateOrderButtons", after=lambda c, p: c.update_state())
        self._hook(sheet, "updateProfileState", after=lambda c, p: c.update_state())
        self._hook(sheet, "setMode", after=lambda c, p: c.update_state())
        self._hook(sheet, "updateHeader", after=lambda c, p: c.hide_stock_header())
        self._hook(sheet, "updateRhythm", after=self._no_rhythm)
        self._hook(sheet, "showMenu", before=self._menu_flag, sheet_only=False)
        self._hook(layout, "onDetachedFromWindow", after=self._detached, layout=True)
        options = find_class(ITEM_OPTIONS)
        if options is not None:
            self._hook(options, "show", before=self._menu_show, sheet_only=False)
        mini = find_class(MINI)
        if mini is not None:
            self._hook(mini, "updateColors", after=self._mini_colors, sheet_only=False)
            self._hook(mini, "setSurfaceColor", before=self._mini_surface, sheet_only=False)
            self._hook(mini, "drawProgress", before=self._mini_progress, sheet_only=False)
        log("hooks: %s" % self.hooks_ok)

    def _safe(self, fn, name, sheet_only=True, layout=False):
        """Wraps a hook body: never lets an exception out, routes it to the controller of this sheet."""
        def handler(param):
            try:
                A.init()
                if not sheet_only:
                    fn(param)
                    return
                ctrl = self.ctrl
                if ctrl is None or ctrl.closed:
                    return
                target = ctrl.L if layout else ctrl.sheet
                if not target.equals(param.thisObject):
                    return
                fn(ctrl, param)
            except Exception:
                log_exc(name)
                if sheet_only:
                    self._failed()
        return handler

    def _failed(self):
        ctrl = self.ctrl
        if ctrl is None or ctrl.closed:
            return
        ctrl.fails += 1
        if ctrl.fails < 6:
            return
        log("too many errors - switching the skin off for this player window")
        try:
            ctrl.set_active(False)
        except Exception:
            log_exc("fallback")
        ctrl.close()

    def _on_created(self, param):
        self._attach(param.thisObject)

    def _attach_existing(self):
        try:
            A.init()
            sheet = jfield(SHEET, "instance").get(None)
            if sheet is not None and self.ctrl is None and not as_bool(sheet.isDismissed()):
                self._attach(sheet)
                if self.ctrl is not None:
                    self.ctrl.L.requestLayout()
        except Exception:
            log_exc("attach existing")

    def _attach(self, sheet):
        style = self.style()
        if style not in SKIN_STYLES:
            return
        old = self.ctrl
        if old is not None:
            if not old.closed and old.sheet.equals(sheet):
                return
            old.close()
        self.ctrl = None
        try:
            self.ctrl = Ctrl(self, sheet, style)
            log("attached: %s, dark=%s" % (STYLE_NAMES[style], self.ctrl.dark))
        except Exception:
            self.ctrl = None
            log_exc("attach")

    def _cover_colors(self, ctrl, param):
        if not ctrl.active:
            return
        ctrl.refresh_colors(as_bool(param.args[0]))
        param.setResult(None)

    def _cover_loaded(self, ctrl, param):
        if not ctrl.active:
            return
        mo, receiver = param.args[0], param.args[1]
        if mo is None or receiver is None:
            return
        ctrl.cover_loaded(mo, receiver)

    def _no_rhythm(self, ctrl, param):
        if not ctrl.active or ctrl.rhythm is None:
            return
        ctrl.rhythm.setActive(False)
        ctrl.rhythm.setAnimating(False)
        try:
            find_class(PKG + ".rhythm.RhythmTap").setEnabled(False)
        except Exception:
            pass

    def _menu_flag(self, param):
        self.menu_for = param.thisObject

    def _menu_show(self, param):
        sheet = self.menu_for
        if sheet is None:
            return
        opts = param.thisObject
        scrim = jfield(ITEM_OPTIONS, "scrimView").get(opts)
        more = jfield(SHEET, "moreButton").get(sheet)
        if scrim is None or more is None or not scrim.equals(more):
            return
        self.menu_for = None
        ctrl = self.ctrl
        if ctrl is not None and (ctrl.closed or not ctrl.active or not ctrl.sheet.equals(sheet)):
            ctrl = None
        kinds = list(ctrl.skin.menu_items) if ctrl is not None else []
        if ctrl is not None and "dislike" not in ctrl.btn:
            wave = self.mywave()
            if wave is not None and getattr(wave, "active", False):
                kinds.insert(0, "dislike")
        timer = self.timer_enabled() or self.timer.active()
        if not kinds and not timer:
            return
        opts.addGap()
        icons = {"speed": ("msg_speed_normal",), "order": ("player_new_shuffle",), "lyrics": ("formatting_quote",),
                 "dislike": ("msg_block", "msg_cancel")}
        for kind in kinds:
            def run(kind=kind):
                try:
                    opts.dismiss()
                except Exception:
                    pass
                ui(lambda: ctrl.menu_action(kind), 120)
            opts.add(res_id(*icons[kind]), T(kind), JRunnable(run))
        if timer:
            sub = opts.makeSwipeback()
            sub.add(res_id("ic_ab_back"), T("back"), JRunnable(lambda: opts.closeSwipeback()))
            sub.addGap()
            self.fill_timer_menu(sub, opts.dismiss)
            icon = res_id("msg_autodelete", "msg_timer", "msg_mute_period")
            rest = self.timer.remaining()
            if rest:
                opts.add(icon, T("timer"), rest, JRunnable(lambda: opts.openSwipeback(sub)))
            else:
                opts.add(icon, T("timer"), JRunnable(lambda: opts.openSwipeback(sub)))
            last = opts.getLast()
            if last is not None:
                last.setRightIcon(res_id("msg_arrowright"))

    def fill_timer_menu(self, opts, close):
        t = self.timer

        def choose(minutes):
            try:
                close()
            except Exception:
                pass
            t.set(minutes)
        if t.active():
            opts.add(0, T("timer_off"), t.remaining(), JRunnable(lambda: choose(0)))
        for m in SleepTimer.MINUTES:
            opts.add(0, SleepTimer.label(m), JRunnable(lambda m=m: choose(m)))
        opts.add(0, T("timer_track"), JRunnable(lambda: choose(-1)))

    def _detached(self, ctrl, param):
        if as_bool(ctrl.sheet.isDismissed()):
            ctrl.close()
            self.ctrl = None
            log("detached")

    # ---- likes
    def mywave(self):
        """The running My Wave plugin instance, if that plugin is installed and enabled."""
        try:
            inst = self.mywave_inst
            if inst is not None:
                ev = getattr(inst, "_stop_ev", None)
                if ev is not None and not ev.is_set():
                    return inst
                self.mywave_inst = None
            now = time.time()
            if now - self.mywave_miss_at < 5.0:
                return None
            self.mywave_miss_at = now
            module = sys.modules.get("my_wave")
            if module is None:
                for mod in list(sys.modules.values()):
                    if getattr(mod, "__id__", None) == "my_wave":
                        module = mod
                        break
            cls = getattr(module, "MyWavePlugin", None) if module is not None else None
            if cls is None:
                return None
            import gc
            for obj in gc.get_referrers(cls):
                if type(obj) is cls and hasattr(obj, "profile") and hasattr(obj, "action_like"):
                    ev = getattr(obj, "_stop_ev", None)
                    if ev is not None and not ev.is_set():
                        self.mywave_inst = obj
                        self.mywave_mod = module
                        return obj
        except Exception:
            log_exc("mywave lookup")
        return None

    def track_key(self):
        mo = playing()
        if mo is None:
            return None, None
        title = str(mo.getMusicTitle() or "")
        artist = str(mo.getMusicAuthor() or "")
        return mo, (artist.strip().lower() + "|" + title.strip().lower())

    def is_liked(self):
        try:
            mo, key = self.track_key()
            if mo is None:
                return False
            wave = self.mywave()
            if wave is not None:
                module = getattr(self, "mywave_mod", None) or sys.modules.get(type(wave).__module__)
                tk = module.track_key(str(mo.getMusicAuthor() or ""), str(mo.getMusicTitle() or ""))
                return bool(wave.profile.is_liked(tk))
            return key in self.likes.data
        except Exception:
            log_exc("is_liked")
            return False

    def is_saved(self):
        _, key = self.track_key()
        return key is not None and key in self.saved.data

    def mark_saved(self):
        _, key = self.track_key()
        if key is not None:
            self.saved.data[key] = int(time.time())
            self.saved.save_async()

    def toggle_like(self, ctrl):
        mo, key = self.track_key()
        if mo is None:
            return
        wave = self.mywave()
        if wave is not None:
            wave.action_like()
            return
        if key in self.likes.data:
            del self.likes.data[key]
            ctrl.bulletin(T("unliked"))
        else:
            self.likes.data[key] = int(time.time())
            saved = False
            try:
                if ctrl.actions is not None and not ctrl.noforwards():
                    me = int(UserConfig.getInstance(UserConfig.selectedAccount).getClientUserId())
                    ctrl.actions.forwardTo(mo, jlong(me), False)
                    saved = True
            except Exception:
                log_exc("save to saved messages")
            ctrl.bulletin(T("saved") if saved else T("liked"))
        self.likes.save_async()

    def dislike(self, ctrl):
        wave = self.mywave()
        if wave is not None:
            wave.action_dislike()
        else:
            ctrl.bulletin(T("no_wave"))

    # ---- waveform
    def request_wave(self, ctrl, mo):
        try:
            title = str(mo.getMusicTitle() or "")
            artist = str(mo.getMusicAuthor() or "")
            key = "%s|%s|%d|%d" % (artist, title, int(float(mo.getDuration())), WAVE_BINS)
            cached = self.waves.data.get(key)
            if cached:
                ctrl.wave.set_wave([v / 100.0 for v in cached])
                return
            ctrl.wave.set_wave(fake_wave(key))
            if not bool(self.get_setting("real_wave", True)) or key in self.wave_jobs:
                return
            path = None
            f = find_class(PKG + ".PlayerActions").getLocalFile(mo)
            if f is not None and bool(f.exists()) and int(f.length()) > 0:
                size = int(mo.getSize())
                if size <= 0 or int(f.length()) >= size:
                    path = str(f.getAbsolutePath())
            if path is None:
                return
            self.wave_jobs.add(key)
            track_id = ctrl.track_id
            threading.Thread(target=self._wave_job, args=(key, path, track_id), name="PlayerSkins-wave", daemon=True).start()
        except Exception:
            log_exc("request wave")

    def _wave_job(self, key, path, track_id):
        try:
            started = time.time()
            vals = decode_wave(path)
            self.waves.data[key] = [int(v * 100) for v in vals]
            if len(self.waves.data) > 300:
                for old in list(self.waves.data.keys())[:60]:
                    self.waves.data.pop(old, None)
            self.waves.save()
            log("waveform ready in %.1fs" % (time.time() - started))

            def apply():
                ctrl = self.ctrl
                if ctrl is not None and not ctrl.closed and ctrl.track_id == track_id and ctrl.wave is not None:
                    ctrl.wave.set_wave(vals)
            ui(apply)
        except Exception:
            log_exc("wave decode")
        finally:
            self.wave_jobs.discard(key)

    # ---- mini player
    def mini_on(self):
        return self.style() in SKIN_STYLES and self.per_style("mini")

    def mini_palette(self, helper):
        A.init()
        style = self.style()
        stats = None
        try:
            mo = get_private_field(helper, "boundMessage")
            if mo is not None:
                stats = self.stats.get(msg_key(mo))
                if stats is None:
                    cover = get_private_field(helper, "coverView")
                    receiver = cover.getCurrentReceiver() if cover is not None else None
                    bmp = receiver.getBitmap() if receiver is not None else None
                    if bmp is not None and not as_bool(bmp.isRecycled()):
                        stats = cover_stats(bmp)
                        self.stats[msg_key(mo)] = stats
        except Exception:
            log_exc("mini stats")
        skin = make_skin(style, None)
        dark = True if skin.always_dark else self.is_dark()
        pal = skin.palette(stats, dark)
        if style == STYLE_SPOTIFY:
            surface = mix(pal["card"], BLACK, 0.25)
            line = WHITE
        elif style == STYLE_SOUNDCLOUD:
            surface = rgb(0x1A1A1A)
            line = pal["accent"]
        else:
            surface = pal["background"]
            line = pal["fill"]
        return {"surface": surface, "title": pal["text"], "sub": pal["text2"], "icon": pal.get("icon_main", pal["icon"]),
                "line": line, "track": pal["track"], "style": style}

    def _mini_colors(self, param):
        if not self.mini_on():
            return
        helper = param.thisObject
        if not bool(jfield(MINI, "active").getBoolean(helper)):
            return
        pal = self.mini_palette(helper)
        skin_key = make_skin(pal["style"], None).FONT
        for field, color, weight in (("titleView", pal["title"], 700), ("subtitleView", pal["sub"], 400)):
            sw = get_private_field(helper, field)
            if sw is None:
                continue
            tf = self.fonts.get(skin_key, weight, self.fonts_enabled())
            for tv in (sw.getTextView(), sw.getNextTextView()):
                if tv is not None:
                    tv.setTextColor(jint(color))
                    tv.setTypeface(tf)
        flt = color_filter(pal["icon"])
        for field in ("prevButton", "nextIcon", "closeIcon"):
            view = get_private_field(helper, field)
            if view is not None:
                view.setColorFilter(flt)
        ppd = get_private_field(helper, "playPauseDrawable")
        if ppd is not None:
            ppd.setColor(jint(pal["icon"]))
        for field in ("prevBackground", "playBackground", "nextBackground"):
            d = get_private_field(helper, field)
            if d is not None:
                d.setColors(jint(pal["icon"]), 0)
        surface = get_private_field(helper, "surfaceView")
        if surface is not None:
            surface.setBackgroundColor(jint(pal["surface"]))
        host = get_private_field(helper, "host")
        if host is not None:
            host.invalidate()

    def _mini_surface(self, param):
        if not self.mini_on():
            return
        helper = param.thisObject
        if not bool(jfield(MINI, "active").getBoolean(helper)):
            return
        # The arguments of the original call are never changed: a Python int would reach Java as a Long
        # and crash the app. The method is done here instead and the original is skipped.
        color = self.mini_palette(helper)["surface"]
        jfield(MINI, "surfaceColor").setInt(helper, jint(color))
        view = get_private_field(helper, "surfaceView")
        if view is not None:
            view.setBackgroundColor(jint(color))
        param.setResult(None)

    def _mini_progress(self, param):
        """Replaces the wavy ring around the play button with a thin line along the bottom edge."""
        if not self.mini_on():
            return
        helper = param.thisObject
        canvas, mo = param.args[0], param.args[1]
        host = get_private_field(helper, "host")
        if host is None or canvas is None:
            return
        pal = self.mini_palette(helper)
        if self.mini_paint is None:
            self.mini_paint = A.Paint(1)
        paint = self.mini_paint
        w, h = int(host.getWidth()), int(host.getHeight())
        progress = clamp01(float(mo.audioProgress)) if mo is not None else 0.0
        inset, line = P(10), max(2, P(2))
        top = h - line - P(2)
        paint.setColor(jint(pal["track"]))
        canvas.drawRect(F(inset), F(top), F(w - inset), F(top + line), paint)
        paint.setColor(jint(pal["line"]))
        canvas.drawRect(F(inset), F(top), F(inset + (w - 2 * inset) * progress), F(top + line), paint)
        if not bool(MediaController.getInstance().isMessagePaused()):
            host.postInvalidateDelayed(jlong(300))
        param.setResult(None)
