_RU = [None]
LOG = []
ERR_SEEN = {}


def is_ru():
    if _RU[0] is None:
        try:
            _RU[0] = str(LocaleController.getInstance().getCurrentLocale().getLanguage()) == "ru"
        except Exception:
            _RU[0] = False
    return _RU[0]


def T(key):
    pair = STR[key]
    return pair[0] if is_ru() else pair[1]


def log(msg):
    try:
        LOG.append("%s %s" % (time.strftime("%H:%M:%S"), msg))
        del LOG[:-400]
    except Exception:
        pass


def log_exc(where):
    """Records an exception once per place, so per-frame hooks cannot flood the log."""
    try:
        n = ERR_SEEN.get(where, 0) + 1
        ERR_SEEN[where] = n
        if n <= 3:
            log("ERROR in %s (#%d):\n%s" % (where, n, traceback.format_exc().strip()))
    except Exception:
        pass


def ui(fn, delay=0):
    def _run():
        try:
            fn()
        except Exception:
            log_exc("ui")
    try:
        if delay:
            run_on_ui_thread(_run, delay)
        else:
            run_on_ui_thread(_run)
    except Exception:
        log_exc("run_on_ui_thread")


def toast(text, kind="show_info"):
    def _show():
        try:
            if kind == "show_success":
                BulletinHelper.show_success(text)
            elif kind == "show_error":
                BulletinHelper.show_error(text)
            else:
                BulletinHelper.show_info(text)
        except Exception:
            pass
    ui(_show)


# ---------------------------------------------------------------- colors

def sgn(c):
    c &= 0xFFFFFFFF
    return c - 0x100000000 if c & 0x80000000 else c


def rgb(v):
    return sgn(0xFF000000 | (v & 0xFFFFFF))


def with_alpha(c, a):
    return sgn(((int(max(0.0, min(1.0, a)) * 255 + 0.5) & 0xFF) << 24) | (c & 0xFFFFFF))


def mix(c1, c2, t):
    t = max(0.0, min(1.0, t))
    out = 0
    for shift in (24, 16, 8, 0):
        a = (c1 >> shift) & 0xFF
        b = (c2 >> shift) & 0xFF
        out |= (int(a + (b - a) * t + 0.5) & 0xFF) << shift
    return sgn(out)


def scale(c, k):
    r, g, b = (c >> 16) & 0xFF, (c >> 8) & 0xFF, c & 0xFF
    return rgb((min(255, int(r * k + 0.5)) << 16) | (min(255, int(g * k + 0.5)) << 8) | min(255, int(b * k + 0.5)))


def hsv_of(c):
    return colorsys.rgb_to_hsv(((c >> 16) & 0xFF) / 255.0, ((c >> 8) & 0xFF) / 255.0, (c & 0xFF) / 255.0)


def from_hsv(h, s, v):
    r, g, b = colorsys.hsv_to_rgb(h % 1.0, max(0.0, min(1.0, s)), max(0.0, min(1.0, v)))
    return rgb((int(r * 255 + 0.5) << 16) | (int(g * 255 + 0.5) << 8) | int(b * 255 + 0.5))


def rel_lum(c):
    def lin(v):
        v /= 255.0
        return v / 12.92 if v <= 0.04045 else ((v + 0.055) / 1.055) ** 2.4
    return 0.2126 * lin((c >> 16) & 0xFF) + 0.7152 * lin((c >> 8) & 0xFF) + 0.0722 * lin(c & 0xFF)


def with_lum(c, target, max_s=0.9):
    """Same hue, saturation capped, brightness chosen to reach the target relative luminance."""
    h, s, _ = hsv_of(c)
    s = min(s, max_s)
    lo, hi = 0.0, 1.0
    for _ in range(18):
        m = (lo + hi) / 2.0
        if rel_lum(from_hsv(h, s, m)) < target:
            lo = m
        else:
            hi = m
    return from_hsv(h, s, (lo + hi) / 2.0)


WHITE = rgb(0xFFFFFF)
BLACK = rgb(0x000000)


def clamp01(x):
    return 0.0 if x < 0.0 else (1.0 if x > 1.0 else x)


def lerp(a, b, t):
    return a + (b - a) * t


def lerp_rect(a, b, t):
    return tuple(lerp(x, y, t) for x, y in zip(a, b))


def smooth(t):
    t = clamp01(t)
    return t * t * (3.0 - 2.0 * t)


def F(x):
    return jfloat(float(x))


# ---------------------------------------------------------------- java access

class A:
    """Android classes, imported on first use."""
    ready = False

    @classmethod
    def init(cls):
        if cls.ready:
            return
        from android.view import View, ViewGroup, Gravity, ViewTreeObserver
        from android.widget import FrameLayout, ImageView, TextView, LinearLayout
        from android.graphics import Bitmap, BitmapFactory, Canvas, Paint, Path, Rect, PorterDuff, PorterDuffColorFilter, Typeface
        from android.graphics.drawable import GradientDrawable
        from android.text import TextUtils, SpannableString, Spanned
        from android.text.style import ForegroundColorSpan
        from java.lang import Class, Integer, Long
        cls.View, cls.ViewGroup, cls.Gravity, cls.ViewTreeObserver = View, ViewGroup, Gravity, ViewTreeObserver
        cls.FrameLayout, cls.ImageView, cls.TextView, cls.LinearLayout = FrameLayout, ImageView, TextView, LinearLayout
        cls.Bitmap, cls.BitmapFactory, cls.Canvas, cls.Paint, cls.Path, cls.Rect = Bitmap, BitmapFactory, Canvas, Paint, Path, Rect
        cls.PorterDuff, cls.PorterDuffColorFilter, cls.Typeface = PorterDuff, PorterDuffColorFilter, Typeface
        cls.GradientDrawable, cls.TextUtils = GradientDrawable, TextUtils
        cls.SpannableString, cls.Spanned, cls.ForegroundColorSpan = SpannableString, Spanned, ForegroundColorSpan
        cls.Class, cls.Integer, cls.Long = Class, Integer, Long
        cls.density = float(AndroidUtilities.density)
        cls.ready = True


def P(dp):
    return int(dp * A.density + 0.5)


_CLASSES = {}
_FIELDS = {}
_METHODS = {}


def jclass_obj(name):
    c = _CLASSES.get(name)
    if c is None:
        c = A.Class.forName(name, False, ApplicationLoader.applicationContext.getClassLoader())
        _CLASSES[name] = c
    return c


def jfield(cls_name, name):
    key = (cls_name, name)
    f = _FIELDS.get(key)
    if f is None:
        f = jclass_obj(cls_name).getDeclaredField(name)
        f.setAccessible(True)
        _FIELDS[key] = f
    return f


def jmethod(cls_name, name, nparams):
    key = (cls_name, name, nparams)
    m = _METHODS.get(key)
    if m is None:
        for cand in jclass_obj(cls_name).getDeclaredMethods():
            if str(cand.getName()) == name and len(cand.getParameterTypes()) == nparams:
                m = cand
                break
        if m is None:
            raise RuntimeError("method %s.%s/%d not found" % (cls_name, name, nparams))
        m.setAccessible(True)
        _METHODS[key] = m
    return m


def call(obj, cls_name, name, *args):
    return jmethod(cls_name, name, len(args)).invoke(obj, *args)


def color_filter(c):
    return A.PorterDuffColorFilter(jint(c), A.PorterDuff.Mode.SRC_IN)


def exact(v):
    return A.View.MeasureSpec.makeMeasureSpec(max(0, int(v)), EXACTLY)


def place(view, x, y, w, h, *rest):
    x, y, w, h = int(x), int(y), max(0, int(w)), max(0, int(h))
    view.measure(exact(w), exact(h))
    view.layout(x, y, x + w, y + h)


def C(cx, cy, w, h):
    """Rect (x, y, w, h) centered on a point."""
    return (cx - w / 2.0, cy - h / 2.0, w, h)


def flp(w, h, gravity=None, margins=None):
    lp = A.FrameLayout.LayoutParams(int(w), int(h)) if gravity is None else A.FrameLayout.LayoutParams(int(w), int(h), int(gravity))
    if margins is not None:
        lp.setMargins(*[int(m) for m in margins])
    return lp


def res_id(*names):
    ctx = ApplicationLoader.applicationContext
    for name in names:
        try:
            rid = int(ctx.getResources().getIdentifier(name, "drawable", ctx.getPackageName()))
            if rid:
                return rid
        except Exception:
            pass
    return 0


_PROXIES = {}


def touch_listener(fn):
    cls = _PROXIES.get("touch")
    if cls is None:
        class _Touch(dynamic_proxy(A.View.OnTouchListener)):
            def __init__(self, handler):
                super().__init__()
                self.handler = handler

            def onTouch(self, view, event):
                try:
                    return bool(self.handler(view, event))
                except Exception:
                    log_exc("touch")
                    return False
        cls = _PROXIES["touch"] = _Touch
    return cls(fn)


def predraw_listener(fn):
    """ViewTreeObserver.OnPreDrawListener backed by a Python function; drawing always goes on."""
    cls = _PROXIES.get("predraw")
    if cls is None:
        class _PreDraw(dynamic_proxy(A.ViewTreeObserver.OnPreDrawListener)):
            def __init__(self, handler):
                super().__init__()
                self.handler = handler

            def onPreDraw(self):
                try:
                    self.handler()
                except Exception:
                    log_exc("pre-draw")
                return True
        cls = _PROXIES["predraw"] = _PreDraw
    return cls(fn)


def dialog_button(fn):
    """AlertDialog.OnButtonClickListener backed by a Python function."""
    cls = _PROXIES.get("dialog_button")
    if cls is None:
        from org.telegram.ui.ActionBar import AlertDialog

        class _DialogButton(dynamic_proxy(AlertDialog.OnButtonClickListener)):
            def __init__(self, handler):
                super().__init__()
                self.handler = handler

            def onClick(self, dialog, which):
                try:
                    self.handler()
                except Exception:
                    log_exc("dialog button")
        cls = _PROXIES["dialog_button"] = _DialogButton
    return cls(fn)


def callback(fn):
    """org.telegram.messenger.Utilities.Callback backed by a Python function."""
    cls = _PROXIES.get("callback")
    if cls is None:
        from org.telegram.messenger import Utilities

        class _Callback(dynamic_proxy(Utilities.Callback)):
            def __init__(self, handler):
                super().__init__()
                self.handler = handler

            def run(self, value):
                try:
                    self.handler(value)
                except Exception:
                    log_exc("callback")
        cls = _PROXIES["callback"] = _Callback
    return cls(fn)


def as_bool(v):
    if isinstance(v, bool):
        return v
    try:
        return bool(v.booleanValue())
    except Exception:
        return bool(v)


def as_int(v, default=0):
    if v is None:
        return default
    if isinstance(v, int):
        return v
    try:
        return int(v.intValue())
    except Exception:
        return int(v)


def on_click(fn):
    def handler(view):
        try:
            fn()
        except Exception:
            log_exc("click")
    return OnClickListener(handler)


def round_bg(color, radius=0.0, oval=False, radii=None, stroke=None):
    d = A.GradientDrawable()
    if oval:
        d.setShape(A.GradientDrawable.OVAL)
    elif radii is not None:
        d.setCornerRadii(jarray(jfloat)([float(r) for r in radii]))
    else:
        d.setCornerRadius(F(radius))
    d.setColor(jint(color))
    if stroke is not None:
        d.setStroke(int(stroke[0]), jint(stroke[1]))
    return d


def playing():
    try:
        mo = MediaController.getInstance().getPlayingMessageObject()
        if mo is not None and as_bool(mo.isMusic()):
            return mo
    except Exception:
        pass
    return None


def msg_key(mo):
    try:
        return "%d:%d" % (int(mo.getDialogId()), int(mo.getId()))
    except Exception:
        return None


def position_ms(mo):
    try:
        ms = int(MediaController.getInstance().getProgressMs(mo))
        if ms >= 0:
            return ms
    except Exception:
        pass
    try:
        return int(float(mo.audioProgress) * float(mo.getDuration()) * 1000.0)
    except Exception:
        return 0


def cover_copy(bmp, side=720):
    """A private copy of a cover bitmap: the player recycles its own ones."""
    w, h = int(bmp.getWidth()), int(bmp.getHeight())
    s = max(1, min(side, w))
    copy = A.Bitmap.createScaledBitmap(bmp, s, max(1, int(s * h / max(1, w))), True)
    if copy is bmp or copy.equals(bmp):
        copy = bmp.copy(A.Bitmap.Config.ARGB_8888, False)
    return copy


def cover_stats(bmp):
    """Average color and the dominant color by area (or a neutral one) of a cover."""
    n = 12
    small = A.Bitmap.createScaledBitmap(bmp, n, n, True)
    arr = jarray(jint)([0] * (n * n))
    small.getPixels(arr, 0, n, 0, 0, n, n)
    tot = [0, 0, 0]
    buckets = {}
    for v in arr:
        v = int(v)
        r, g, b = (v >> 16) & 0xFF, (v >> 8) & 0xFF, v & 0xFF
        tot[0] += r
        tot[1] += g
        tot[2] += b
        h, s, val = colorsys.rgb_to_hsv(r / 255.0, g / 255.0, b / 255.0)
        key = int(h * 12) % 12 if (s > 0.2 and val > 0.15) else -1
        bk = buckets.setdefault(key, [0, 0, 0, 0])
        bk[0] += r
        bk[1] += g
        bk[2] += b
        bk[3] += 1
    count = float(n * n)
    avg = rgb((int(tot[0] / count) << 16) | (int(tot[1] / count) << 8) | int(tot[2] / count))
    gray = buckets.get(-1, [0, 0, 0, 0])
    chroma = [(k, v) for k, v in buckets.items() if k >= 0]
    chroma_total = sum(v[3] for _, v in chroma)
    if chroma and chroma_total > gray[3]:
        def score(kv):
            k = kv[0]
            near = buckets.get((k + 1) % 12, [0, 0, 0, 0])[3] + buckets.get((k - 1) % 12, [0, 0, 0, 0])[3]
            return kv[1][3] + 0.5 * near
        _, bk = max(chroma, key=score)
        neutral = False
    else:
        bk = gray if gray[3] else [tot[0], tot[1], tot[2], int(count)]
        neutral = True
    c = float(bk[3])
    dom = rgb((int(bk[0] / c) << 16) | (int(bk[1] / c) << 8) | int(bk[2] / c))
    return {"avg": avg, "dom": dom, "neutral": neutral}


# ---------------------------------------------------------------- icons

def _mirror(ops):
    out = []
    for op in ops:
        k = op[0]
        if k in ("M", "L"):
            out.append((k, 24 - op[1], op[2]))
        elif k == "C":
            out.append((k, 24 - op[1], op[2], 24 - op[3], op[4], 24 - op[5], op[6]))
        elif k == "R":
            out.append((k, 24 - op[3], op[2], 24 - op[1], op[4], op[5]))
        elif k == "O":
            out.append((k, 24 - op[1], op[2], op[3]))
        else:
            out.append(op)
    return out


