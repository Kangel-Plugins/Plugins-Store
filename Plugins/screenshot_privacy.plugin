class _SetMessageContentHook(MethodHook):
    def __init__(self, plugin: "ScreenshotPrivacyPlugin"):
        self.plugin = plugin

    def before_hooked_method(self, param):
        plugin = self.plugin
        plugin._layout_depth += 1
        saved_rank = None
        try:
            msg = param.args[0] if param.args and len(param.args) > 0 else None
            if msg is not None and plugin._masking_active and plugin.get_setting("hide_tags", True):
                owner = getattr(msg, "messageOwner", None)
                rank = getattr(owner, "from_rank", None) if owner is not None else None
                if rank is not None:
                    saved_rank = (owner, rank)
                    owner.from_rank = None
        except Exception:
            pass
        plugin._rank_stack.append(saved_rank)
        try:
            msg = param.args[0] if param.args and len(param.args) > 0 else None
            if msg is None:
                return
            should_mask = self.plugin._masking_active and self.plugin.get_setting("hide_mentions", True)
            if should_mask:
                self.plugin.ensure_message_mentions_masked(msg)
                reply_msg = getattr(msg, "replyMessageObject", None)
                if reply_msg is not None:
                    self.plugin.ensure_message_mentions_masked(reply_msg)
            elif self.plugin._masked_mentions:
                self.plugin.restore_message_mentions_if_needed(msg)
                reply_msg = getattr(msg, "replyMessageObject", None)
                if reply_msg is not None:
                    self.plugin.restore_message_mentions_if_needed(reply_msg)
        except Exception:
            pass

    def after_hooked_method(self, param):
        plugin = self.plugin
        plugin._layout_depth = max(0, plugin._layout_depth - 1)
        try:
            saved_rank = plugin._rank_stack.pop() if plugin._rank_stack else None
            if saved_rank is not None:
                saved_rank[0].from_rank = saved_rank[1]
        except Exception:
            pass
        if not self.plugin._masking_active:
            return
        cell = param.thisObject
        try:
            if self.plugin.get_setting("hide_nicknames", True):
                draw_name = bool(_safe_get(cell, "drawNameLayout", False))
                name_layout = _safe_get(cell, "nameLayout")
                if draw_name and name_layout is not None:
                    user = _safe_get(cell, "currentUser")
                    chat = _safe_get(cell, "currentChat")
                    msg = _safe_get(cell, "currentMessageObject")
                    peer_id = 0
                    if user is not None:
                        peer_id = int(getattr(user, "id", 0) or 0)
                    elif chat is not None:
                        peer_id = -int(getattr(chat, "id", 0) or 0)
                    elif msg is not None:
                        peer_id = int(msg.getFromChatId() or 0)
                    masked = self.plugin.get_masked_name(peer_id)
                    if str(_safe_get(cell, "currentNameString", "") or "") == masked:
                        # Имя уже подменено на этапе разметки (getAuthorName) — ширины корректны.
                        draw_name = False
                if draw_name and name_layout is not None:
                    old_lw = int(_safe_get(cell, "nameLayoutWidth", 0) or 0)
                    old_nw = int(_safe_get(cell, "nameWidth", 0) or 0)
                    bg_w = int(_safe_get(cell, "backgroundWidth", 0) or 0)
                    max_allowed_w = max(AndroidUtilities.dp(60), old_nw + AndroidUtilities.dp(24), bg_w - AndroidUtilities.dp(28))
                    desired_w = int(math.ceil(Theme.chat_namePaint.measureText(masked))) + AndroidUtilities.dp(4)
                    avail_w = max(AndroidUtilities.dp(60), min(desired_w, max_allowed_w))
                    ell_name = TextUtils.ellipsize(masked, Theme.chat_namePaint, avail_w, TextUtils.TruncateAt.END)
                    new_name_layout = StaticLayout(
                        ell_name,
                        Theme.chat_namePaint,
                        avail_w + AndroidUtilities.dp(2),
                        Layout.Alignment.ALIGN_NORMAL,
                        1.0,
                        0.0,
                        False,
                    )
                    new_lw = int(math.ceil(new_name_layout.getLineWidth(0))) if new_name_layout.getLineCount() > 0 else 0
                    _safe_set(cell, "nameLayout", new_name_layout)
                    _safe_set(cell, "currentNameString", masked)
                    _safe_set(cell, "nameLayoutWidth", new_lw)
                    if new_name_layout.getLineCount() > 0:
                        _safe_set(cell, "nameOffsetX", new_name_layout.getLineLeft(0))
                    _safe_set(cell, "nameWidth", max(new_lw, old_nw - old_lw + new_lw))
                    if (
                        old_lw > new_lw
                        and self.plugin.should_collapse_time_space(cell)
                        and _safe_get(cell, "replyNameLayout") is None
                        and not bool(_safe_get(cell, "drawForwardedName", False))
                        and not bool(_safe_get(cell, "hasLinkPreview", False))
                        and not bool(_safe_get(cell, "drawPhotoImage", False))
                    ):
                        try:
                            rlb = _safe_get(cell, "reactionsLayoutInBubble")
                            no_react = rlb is None or bool(getattr(rlb, "isEmpty", True))
                            msg_obj = _safe_get(cell, "currentMessageObject")
                            tw_msg = int(_safe_get(msg_obj, "textWidth", 0) or 0) if msg_obj is not None else 0
                            if no_react and tw_msg > 0:
                                extra_tx = int(cell.getExtraTextX()) * 2
                                target_bg_w = max(tw_msg, new_lw) + AndroidUtilities.dp(31) + extra_tx
                                if 0 < target_bg_w < bg_w:
                                    _safe_set(cell, "backgroundWidth", target_bg_w)
                        except Exception:
                            pass

            if self.plugin.get_setting("hide_statuses", True) or self.plugin.get_setting("hide_nicknames", True):
                _safe_set(cell, "currentNameStatus", None)
                _safe_set(cell, "currentNameBotVerificationId", JLong(0))
                _safe_set(cell, "nameStatusSlug", None)
                status_dr = _safe_get(cell, "currentNameStatusDrawable")
                if status_dr is not None:
                    try:
                        status_dr.set(None, False)
                    except Exception:
                        pass
                emoji_dr = _safe_get(cell, "currentNameEmojiStatusDrawable")
                if emoji_dr is not None:
                    try:
                        emoji_dr.set(None, False)
                    except Exception:
                        pass

            if self.plugin.get_setting("hide_tags", True):
                _safe_set(cell, "adminLayout", None)
                _safe_set(cell, "adminLayoutIsAdmin", False)
                _safe_set(cell, "adminLayoutIsOwner", False)
                _safe_set(cell, "adminLayoutIsTag", False)
                _safe_set(cell, "boostCounterSpan", None)
                _safe_set(cell, "boostCounterBounds", None)

            if self.plugin.get_setting("hide_reply_names", True):
                reply_layout = _safe_get(cell, "replyNameLayout")
                if reply_layout is not None:
                    reply_peer_id = 0
                    try:
                        msg = _safe_get(cell, "currentMessageObject")
                        if msg is not None and getattr(msg, "replyMessageObject", None) is not None:
                            reply_peer_id = int(msg.replyMessageObject.getFromChatId() or 0)
                    except Exception:
                        pass
                    masked_reply = self.plugin.get_masked_name(reply_peer_id)
                    cur_text = str(reply_layout.getText() or "")
                    if reply_peer_id != 0 and masked_reply and masked_reply.strip("​") and masked_reply not in cur_text:
                        # Имя не подменилось при разметке (например, канал) — перестраиваем,
                        # но не шире исходной строки, чтобы текст не вылезал за пузырь.
                        orig_w = 0
                        try:
                            if reply_layout.getLineCount() > 0:
                                orig_w = int(math.ceil(reply_layout.getLineWidth(0)))
                        except Exception:
                            orig_w = 0
                        rw = max(AndroidUtilities.dp(24), orig_w)
                        ell_reply = TextUtils.ellipsize(masked_reply, Theme.chat_replyNamePaint, rw, TextUtils.TruncateAt.END)
                        new_rl = StaticLayout(
                            ell_reply,
                            Theme.chat_replyNamePaint,
                            rw + AndroidUtilities.dp(2),
                            Layout.Alignment.ALIGN_NORMAL,
                            1.0,
                            0.0,
                            False,
                        )
                        _safe_set(cell, "replyNameLayout", new_rl)
                        if new_rl.getLineCount() > 0:
                            _safe_set(cell, "replyNameOffset", int(new_rl.getLineLeft(0)))

                fwd_layouts = _safe_get(cell, "forwardedNameLayout")
                if fwd_layouts is not None and len(fwd_layouts) > 1 and fwd_layouts[1] is not None:
                    fwd_user = _safe_get(cell, "currentForwardUser")
                    fwd_chat = _safe_get(cell, "currentForwardChannel")
                    peer_id = 0
                    if fwd_user is not None:
                        peer_id = int(getattr(fwd_user, "id", 0) or 0)
                    elif fwd_chat is not None:
                        peer_id = -int(getattr(fwd_chat, "id", 0) or 0)
                    masked = self.plugin.get_masked_name(peer_id) or _t("Пользователь")
                    old_fwd = fwd_layouts[1]
                    if masked in str(old_fwd.getText() or ""):
                        fwd_layouts = None
                if fwd_layouts is not None and len(fwd_layouts) > 1 and fwd_layouts[1] is not None:
                    old_fwd = fwd_layouts[1]
                    orig_fw = 0
                    try:
                        if old_fwd.getLineCount() > 0:
                            orig_fw = int(math.ceil(old_fwd.getLineWidth(0)))
                    except Exception:
                        orig_fw = 0
                    max_fw = max(AndroidUtilities.dp(40), int(_safe_get(cell, "forwardedNameWidth", AndroidUtilities.dp(150)) or AndroidUtilities.dp(150)))
                    fwd_width = max(AndroidUtilities.dp(40), min(max_fw, orig_fw or max_fw))
                    ell_fwd = TextUtils.ellipsize(masked, Theme.chat_forwardNamePaint, fwd_width, TextUtils.TruncateAt.END)
                    new_layout = StaticLayout(
                        ell_fwd,
                        Theme.chat_forwardNamePaint,
                        fwd_width + AndroidUtilities.dp(2),
                        Layout.Alignment.ALIGN_NORMAL,
                        1.0,
                        0.0,
                        False,
                    )
                    fwd_layouts[1] = new_layout
                    fwd_offsets = _safe_get(cell, "forwardNameOffsetX")
                    if fwd_offsets is not None and len(fwd_offsets) > 1 and new_layout.getLineCount() > 0:
                        fwd_offsets[1] = new_layout.getLineLeft(0)

            if self.plugin.should_collapse_time_space(cell):
                if int(_safe_get(cell, "captionNewLine", 0) or 0) == 1:
                    dp14 = AndroidUtilities.dp(14)
                    _safe_set(cell, "captionNewLine", 0)
                    ah = int(_safe_get(cell, "addedCaptionHeight", 0) or 0)
                    if ah > dp14:
                        _safe_set(cell, "addedCaptionHeight", ah - dp14)
                    th = int(_safe_get(cell, "totalHeight", 0) or 0)
                    if th > dp14:
                        _safe_set(cell, "totalHeight", th - dp14)
        except Exception:
            pass


class _MessageCellAvatarHook(MethodHook):
    def __init__(self, plugin: "ScreenshotPrivacyPlugin"):
        self.plugin = plugin

    def _cache_cell_avatar_color(self, cell: Any, msg: Any):
        try:
            avatar_image = _safe_get(cell, "avatarImage")
            if avatar_image is None:
                return
            bmp = _extract_bitmap_from_image_receiver(avatar_image)
            if bmp is None:
                return
            peer_id = self._resolve_peer_id(cell, msg)
            if peer_id != 0:
                self.plugin.cache_bitmap_color(peer_id, bmp)
        except Exception:
            pass

    @staticmethod
    def _resolve_peer_id(cell: Any, msg: Any) -> int:
        user = _safe_get(cell, "currentUser")
        chat = _safe_get(cell, "currentChat")
        if user is not None:
            return int(getattr(user, "id", 0) or 0)
        if chat is not None:
            return -int(getattr(chat, "id", 0) or 0)
        if msg is not None:
            try:
                return int(msg.getFromChatId() or 0)
            except Exception:
                pass
        return 0

    def before_hooked_method(self, param):
        try:
            cell = param.thisObject
            msg = param.args[0] if param.args and len(param.args) > 0 else None
            self._cache_cell_avatar_color(cell, msg)
        except Exception:
            pass

    def after_hooked_method(self, param):
        cell = param.thisObject
        msg = param.args[0] if param.args and len(param.args) > 0 else None
        self._cache_cell_avatar_color(cell, msg)

        if not self.plugin.is_masking_active() or not self.plugin.get_setting("hide_avatars", True):
            return

        try:
            is_visible = bool(_safe_get(cell, "isAvatarVisible", False))
            draw_name_avatar = bool(_safe_get(cell, "drawNameAvatar", False))
            if not is_visible and not draw_name_avatar:
                return

            avatar_image = _safe_get(cell, "avatarImage")
            avatar_drawable = _safe_get(cell, "avatarDrawable")
            if avatar_image is None or avatar_drawable is None:
                return

            account = int(_safe_get(cell, "currentAccount", UserConfig.selectedAccount) or UserConfig.selectedAccount)
            peer_id = self._resolve_peer_id(cell, msg)
            user = _safe_get(cell, "currentUser")
            chat = _safe_get(cell, "currentChat")

            self.plugin.apply_masked_avatar(
                avatar_drawable=avatar_drawable,
                image_receiver=avatar_image,
                account=account,
                peer_id=peer_id,
                user=user,
                chat=chat,
            )
        except Exception:
            pass


class _ChatAvatarContainerAvatarHook(MethodHook):
    def __init__(self, plugin: "ScreenshotPrivacyPlugin"):
        self.plugin = plugin

    def before_hooked_method(self, param):
        try:
            container = param.thisObject
            img_view = _safe_get(container, "avatarImageView")
            if img_view is None:
                return
            ir = img_view.getImageReceiver()
            bmp = _extract_bitmap_from_image_receiver(ir)
            if bmp is None:
                return
            fragment = _safe_get(container, "parentFragment")
            if fragment is not None:
                did = int(fragment.getDialogId() or 0)
                if did != 0:
                    self.plugin.cache_bitmap_color(did, bmp)
        except Exception:
            pass

    def after_hooked_method(self, param):
        container = param.thisObject
        try:
            img_view = _safe_get(container, "avatarImageView")
            if img_view is not None:
                ir = img_view.getImageReceiver()
                bmp = _extract_bitmap_from_image_receiver(ir)
                fragment = _safe_get(container, "parentFragment")
                if bmp is not None and fragment is not None:
                    did = int(fragment.getDialogId() or 0)
                    if did != 0:
                        self.plugin.cache_bitmap_color(did, bmp)
        except Exception:
            pass

        if not self.plugin.is_masking_active():
            return
        if not (self.plugin.get_setting("hide_avatars", True) and self.plugin.get_setting("hide_header_avatar", True)):
            return

        try:
            img_view = _safe_get(container, "avatarImageView")
            avatar_drawable = _safe_get(container, "avatarDrawable")
            if img_view is None or avatar_drawable is None:
                return

            self.plugin.save_container_stories_flag(container)
            _safe_set(container, "allowDrawStories", False)

            fragment = _safe_get(container, "parentFragment")
            account = int(_safe_get(container, "currentAccount", UserConfig.selectedAccount) or UserConfig.selectedAccount)
            peer_id = 0
            user = None
            chat = None
            if fragment is not None:
                peer_id = int(fragment.getDialogId() or 0)
                user = fragment.getCurrentUser()
                chat = fragment.getCurrentChat()
                if fragment.getChatMode() == 3:
                    saved_did = int(fragment.getSavedDialogId() or 0)
                    if saved_did != 0:
                        peer_id = saved_did
                        mc = fragment.getMessagesController()
                        if saved_did > 0:
                            user = mc.getUser(jlong(saved_did))
                            chat = None
                        else:
                            user = None
                            chat = mc.getChat(jlong(-saved_did))

            self.plugin.apply_masked_avatar(
                avatar_drawable=avatar_drawable,
                image_receiver=img_view.getImageReceiver(),
                account=account,
                peer_id=peer_id,
                user=user,
                chat=chat,
                image_view=img_view,
            )
        except Exception:
            pass


class _ChatAvatarContainerTitleHook(MethodHook):
    def __init__(self, plugin: "ScreenshotPrivacyPlugin"):
        self.plugin = plugin

    def before_hooked_method(self, param):
        if not self.plugin._masking_active or not self.plugin.get_setting("hide_header_name", True):
            return
        try:
            container = param.thisObject
            if param.args and len(param.args) >= 1:
                param.args[0] = self.plugin.get_header_placeholder(container)
            if len(param.args) >= 8:
                param.args[1] = False
                param.args[2] = False
                param.args[3] = False
                param.args[4] = False
                param.args[5] = None
                param.args[6] = None
            elif len(param.args) >= 6:
                param.args[1] = False
                param.args[2] = False
                param.args[3] = False
                param.args[4] = False
                param.args[5] = None
        except Exception:
            pass

    def after_hooked_method(self, param):
        if not self.plugin._masking_active:
            return
        if self.plugin.get_setting("hide_statuses", True) or self.plugin.get_setting("hide_header_name", True):
            try:
                ttv = _safe_get(param.thisObject, "titleTextView")
                if ttv is not None:
                    ttv.setRightDrawable(None)
                    ttv.setRightDrawable2(None)
            except Exception:
                pass


class _ChatAvatarContainerSubtitleHook(MethodHook):
    def __init__(self, plugin: "ScreenshotPrivacyPlugin"):
        self.plugin = plugin

    def after_hooked_method(self, param):
        if not self.plugin._masking_active:
            return
        container = param.thisObject
        try:
            sub_view = container.getSubtitleTextView()
            if sub_view is None:
                return
            if self.plugin.get_setting("hide_header_subtitle", True):
                self.plugin.save_container_subtitle_visible(container, sub_view.getVisibility() != View.GONE)
                sub_view.setVisibility(View.GONE)
        except Exception:
            pass


class _TouchPreMaskHook(MethodHook):
    """Мгновенно включает предмаскировку при касании экрана 3 пальцами (жест скриншота)."""
    def __init__(self, plugin: "ScreenshotPrivacyPlugin"):
        self.plugin = plugin

    def before_hooked_method(self, param):
        if self.plugin._masking_active or self.plugin._capturing_now:
            return
        try:
            ev = param.args[0]
            if ev is None:
                return
            if ev.getActionMasked() != MotionEvent.ACTION_POINTER_DOWN:
                return
            if ev.getPointerCount() < 3:
                return
            self.plugin.on_three_finger_gesture()
        except Exception:
            pass


class _ChatAvatarContainerTitleIconsHook(MethodHook):
    def __init__(self, plugin: "ScreenshotPrivacyPlugin"):
        self.plugin = plugin

    def before_hooked_method(self, param):
        if not self.plugin._masking_active:
            return
        if self.plugin.get_setting("hide_statuses", True) or self.plugin.get_setting("hide_header_name", True):
            if param.args and len(param.args) >= 2:
                param.args[0] = None
                param.args[1] = None


class _LayoutScopeHook(MethodHook):
    """Пока выполняется метод, UserObject.getUserName() отдаёт замаскированные имена."""

    def __init__(self, plugin: "ScreenshotPrivacyPlugin", as_author: bool = False, track_reply: bool = False):
        self.plugin = plugin
        self.as_author = as_author  # True -> подчиняется «Имена», иначе «В ответах и пересылках»
        self.track_reply = track_reply

    def before_hooked_method(self, param):
        self.plugin._layout_depth += 1
        if self.as_author:
            self.plugin._author_name_depth += 1

    def after_hooked_method(self, param):
        plugin = self.plugin
        plugin._layout_depth = max(0, plugin._layout_depth - 1)
        if self.as_author:
            plugin._author_name_depth = max(0, plugin._author_name_depth - 1)
        if not plugin._masking_active or not self.track_reply:
            return
        try:
            msg = _safe_get(param.thisObject, "replyingMessageObject")
            if msg is not None:
                pid = int(msg.getFromChatId() or 0)
                if pid != 0:
                    plugin._reply_panel_mask = (pid, plugin.get_masked_name(pid))
        except Exception:
            pass


class _SetForUserOrChatHook(MethodHook):
    """
    ImageReceiver.setForUserOrChat: пока включён режим скриншота, любая аватарка,
    которую клиент ставит заново (комментаторы под постами, авторы пунктов чек-листа,
    карточки контактов и т.п.), сразу заменяется на замаскированную.
    """

    def __init__(self, plugin: "ScreenshotPrivacyPlugin"):
        self.plugin = plugin

    def after_hooked_method(self, param):
        plugin = self.plugin
        if not plugin._masking_active or plugin._in_avatar_apply:
            return
        if not plugin.get_setting("hide_avatars", True):
            return
        try:
            args = param.args
            if not args:
                return
            obj = args[0]
            if obj is None:
                return
            peer_id = int(getattr(obj, "id", 0) or 0)
            if peer_id == 0:
                return
            UserCls = find_class("org.telegram.tgnet.TLRPC$User")
            is_user = UserCls is not None and isinstance(obj, UserCls)
            if not is_user:
                peer_id = -peer_id
            avatar_drawable = None
            for a in args[1:]:
                if a is not None and isinstance(a, AvatarDrawable):
                    avatar_drawable = a
                    break
            if avatar_drawable is None:
                avatar_drawable = AvatarDrawable()
            plugin._in_avatar_apply = True
            try:
                plugin.apply_masked_avatar(
                    avatar_drawable=avatar_drawable,
                    image_receiver=param.thisObject,
                    account=UserConfig.selectedAccount,
                    peer_id=peer_id,
                    user=obj if is_user else None,
                    chat=None if is_user else obj,
                )
            finally:
                plugin._in_avatar_apply = False
        except Exception:
            plugin._in_avatar_apply = False


class _ContactNameHook(MethodHook):
    """ContactsController.formatName внутри разметки сообщения (карточки контактов)."""

    def __init__(self, plugin: "ScreenshotPrivacyPlugin"):
        self.plugin = plugin

    def after_hooked_method(self, param):
        plugin = self.plugin
        if plugin._layout_depth <= 0 or not plugin._masking_active:
            return
        if not plugin.get_setting("hide_nicknames", True):
            return
        try:
            original = str(param.getResult() or "")
            if not original.strip():
                return
            fake_id = -(10 ** 13) - (abs(hash(original)) % (10 ** 9))
            param.setResult(plugin.get_masked_name(fake_id))
        except Exception:
            pass


class _FieldNullScopeHook(MethodHook):
    """
    На время вызова метода обнуляет поля у аргумента (например страну телефона
    и дату регистрации в PeerSettings или подпись автора поста) и возвращает их после.
    Данные в памяти клиента не меняются — только то, что попадёт в разметку.
    """

    def __init__(self, plugin: "ScreenshotPrivacyPlugin", arg_index: int, resolver: Any, fields: tuple):
        self.plugin = plugin
        self.arg_index = arg_index
        self.resolver = resolver
        self.fields = fields
        self.stack: List[Any] = []

    def before_hooked_method(self, param):
        saved = []
        try:
            plugin = self.plugin
            if plugin._masking_active and plugin.get_setting("hide_personal_info", True):
                arg = param.args[self.arg_index] if param.args and len(param.args) > self.arg_index else None
                for target in (self.resolver(arg) if arg is not None else ()):
                    if target is None:
                        continue
                    for name in self.fields:
                        val = getattr(target, name, None)
                        if val is not None:
                            saved.append((target, name, val))
                            setattr(target, name, None)
        except Exception:
            pass
        self.stack.append(saved)

    def after_hooked_method(self, param):
        saved = self.stack.pop() if self.stack else []
        for target, name, val in saved:
            try:
                setattr(target, name, val)
            except Exception:
                pass


class _PhoneFormatHook(MethodHook):
    """Номер телефона в карточке контакта внутри сообщения -> «+• ••• •••-••-••»."""

    def __init__(self, plugin: "ScreenshotPrivacyPlugin"):
        self.plugin = plugin

    def after_hooked_method(self, param):
        plugin = self.plugin
        if plugin._layout_depth <= 0 or not plugin._masking_active:
            return
        if not plugin.get_setting("hide_personal_info", True):
            return
        try:
            original = str(param.getResult() or "")
            if original:
                param.setResult("".join("•" if ch.isdigit() else ch for ch in original))
        except Exception:
            pass


class _UserInfoRowHook(MethodHook):
    """Строки плашки знакомства (страна телефона, регистрация) -> «скрыто», размеры не прыгают."""

    def __init__(self, plugin: "ScreenshotPrivacyPlugin"):
        self.plugin = plugin

    def before_hooked_method(self, param):
        plugin = self.plugin
        if not plugin._masking_active or not plugin.get_setting("hide_personal_info", True):
            return
        try:
            if len(param.args) >= 3 and not bool(param.args[2]):
                param.args[1] = _t("скрыто")
        except Exception:
            pass


class _UserInfoWidthHook(MethodHook):
    """С короткими заглушками плашка сужается и обрезает нижнюю подпись — расширяем под неё."""

    def __init__(self, plugin: "ScreenshotPrivacyPlugin"):
        self.plugin = plugin

    def after_hooked_method(self, param):
        if not self.plugin._masking_active:
            return
        try:
            cell = param.thisObject
            footer = _safe_get(cell, "footer")
            if footer is None:
                return
            need = float(footer.getCurrentWidth()) + AndroidUtilities.dp(32)
            limit = AndroidUtilities.displaySize.x * 0.95
            width = float(_safe_get(cell, "width", 0.0) or 0.0)
            if width < need:
                _safe_set(cell, "width", min(need, limit))
        except Exception:
            pass


def _msg_signature_targets(msg: Any):
    owner = getattr(msg, "messageOwner", None)
    if owner is None:
        return ()
    return (owner, getattr(owner, "fwd_from", None))


class _PinnedMessageViewHook(MethodHook):
    def __init__(self, plugin: "ScreenshotPrivacyPlugin"):
        self.plugin = plugin

    def before_hooked_method(self, param):
        if not self.plugin._masking_active or not self.plugin.get_setting("hide_pinned", True):
            return
        try:
            chat_activity = param.thisObject
            ChatActivityClass = chat_activity.getClass()
            hide_method = ChatActivityClass.getDeclaredMethod("hidePinnedMessageView", JBoolean.TYPE)
            hide_method.setAccessible(True)
            hide_method.invoke(chat_activity, False)
            param.setResult(None)
        except Exception:
            try:
                pinned_view = _safe_get(param.thisObject, "pinnedMessageView")
                if pinned_view is not None:
                    pinned_view.setVisibility(View.GONE)
                    param.setResult(None)
            except Exception:
                pass


def _build_plugin_icon_bitmap(size: int = 192) -> Any:
    """
    Генерирует векторно-чёткую нативную иконку для Screenshot Privacy:
    фирменный сине-фиолетовый градиент, рамка кадра скриншота и перечёркнутый глаз.
    """
    bmp = Bitmap.createBitmap(size, size, Bitmap.Config.ARGB_8888)
    canvas = Canvas(bmp)
    s = float(size)

    bg_paint = Paint(Paint.ANTI_ALIAS_FLAG)
    bg_paint.setShader(
        LinearGradient(
            0.0,
            0.0,
            s,
            s,
            jint(Color.rgb(0x3E, 0x7B, 0xFA)),
            jint(Color.rgb(0x7B, 0x4D, 0xFF)),
            Shader.TileMode.CLAMP,
        )
    )
    canvas.drawRect(0.0, 0.0, s, s, bg_paint)

    glow_paint = Paint(Paint.ANTI_ALIAS_FLAG)
    glow_paint.setColor(jint(Color.argb(0x24, 0xFF, 0xFF, 0xFF)))
    canvas.drawCircle(s * 0.28, s * 0.22, s * 0.42, glow_paint)

    white = jint(Color.rgb(0xFF, 0xFF, 0xFF))

    stroke_paint = Paint(Paint.ANTI_ALIAS_FLAG)
    stroke_paint.setColor(white)
    stroke_paint.setStyle(Paint.Style.STROKE)
    stroke_paint.setStrokeWidth(s * 0.068)
    stroke_paint.setStrokeCap(Paint.Cap.ROUND)
    stroke_paint.setStrokeJoin(Paint.Join.ROUND)

    m = s * 0.19
    arm = s * 0.15
    p = Path()
    p.moveTo(m, m + arm)
    p.lineTo(m, m)
    p.lineTo(m + arm, m)
    p.moveTo(s - m - arm, m)
    p.lineTo(s - m, m)
    p.lineTo(s - m, m + arm)
    p.moveTo(m, s - m - arm)
    p.lineTo(m, s - m)
    p.lineTo(m + arm, s - m)
    p.moveTo(s - m - arm, s - m)
    p.lineTo(s - m, s - m)
    p.lineTo(s - m, s - m - arm)
    canvas.drawPath(p, stroke_paint)

    eye_paint = Paint(Paint.ANTI_ALIAS_FLAG)
    eye_paint.setColor(white)
    eye_paint.setStyle(Paint.Style.STROKE)
    eye_paint.setStrokeWidth(s * 0.062)
    eye_paint.setStrokeCap(Paint.Cap.ROUND)
    eye_paint.setStrokeJoin(Paint.Join.ROUND)

    cx = s * 0.5
    cy = s * 0.5
    ew = s * 0.21
    eh = s * 0.14
    eye_path = Path()
    eye_path.moveTo(cx - ew, cy)
    eye_path.quadTo(cx, cy - eh * 1.45, cx + ew, cy)
    eye_path.quadTo(cx, cy + eh * 1.45, cx - ew, cy)
    canvas.drawPath(eye_path, eye_paint)

    pupil_paint = Paint(Paint.ANTI_ALIAS_FLAG)
    pupil_paint.setColor(white)
    pupil_paint.setStyle(Paint.Style.FILL)
    canvas.drawCircle(cx, cy, s * 0.062, pupil_paint)

    slash_bg = Paint(Paint.ANTI_ALIAS_FLAG)
    slash_bg.setColor(jint(Color.rgb(0x5D, 0x64, 0xFC)))
    slash_bg.setStyle(Paint.Style.STROKE)
    slash_bg.setStrokeWidth(s * 0.115)
    slash_bg.setStrokeCap(Paint.Cap.ROUND)
    canvas.drawLine(cx - s * 0.17, cy + s * 0.17, cx + s * 0.17, cy - s * 0.17, slash_bg)

    canvas.drawLine(cx - s * 0.17, cy + s * 0.17, cx + s * 0.17, cy - s * 0.17, eye_paint)
    return bmp


_ICON_BITMAP_CACHE = None


def _get_plugin_icon_bitmap():
    global _ICON_BITMAP_CACHE
    try:
        if _ICON_BITMAP_CACHE is None or _ICON_BITMAP_CACHE.isRecycled():
            _ICON_BITMAP_CACHE = _build_plugin_icon_bitmap(192)
    except Exception:
        return None
    return _ICON_BITMAP_CACHE


_VIEW_SET_MEASURED = None


def _set_measured_dimension(view: Any, width: int, height: int):
    global _VIEW_SET_MEASURED
    if _VIEW_SET_MEASURED is None:
        ViewCls = _java_lang_class("android.view.View")
        m = ViewCls.getDeclaredMethod("setMeasuredDimension", JInteger.TYPE, JInteger.TYPE)
        m.setAccessible(True)
        _VIEW_SET_MEASURED = m
    _VIEW_SET_MEASURED.invoke(view, JInteger(int(width)), JInteger(int(height)))


class _ChatActionCellDrawHook(MethodHook):
    """Пропускает отрисовку скрытых системных сообщений / разделителей дат."""

    def __init__(self, plugin: "ScreenshotPrivacyPlugin"):
        self.plugin = plugin

    def before_hooked_method(self, param):
        if not self.plugin._masking_active:
            return
        try:
            if self.plugin.should_hide_action_cell(param.thisObject):
                param.setResult(None)
        except Exception:
            pass


class _ChatActionCellMeasureHook(MethodHook):
    """Схлопывает скрытое системное сообщение до нулевой высоты, чтобы не оставалось дыры."""

    def __init__(self, plugin: "ScreenshotPrivacyPlugin"):
        self.plugin = plugin

    def after_hooked_method(self, param):
        if not self.plugin._masking_active:
            return
        try:
            cell = param.thisObject
            if self.plugin.should_hide_action_cell(cell):
                _set_measured_dimension(cell, cell.getMeasuredWidth(), 0)
        except Exception:
            pass


class _AvatarOnlineHook(MethodHook):
    def __init__(self, plugin: "ScreenshotPrivacyPlugin"):
        self.plugin = plugin

    def before_hooked_method(self, param):
        if not self.plugin._masking_active:
            return
        if self.plugin.get_setting("hide_avatars", True) or self.plugin.get_setting("hide_statuses", True):
            try:
                canvas = param.args[0]
                image_receiver = param.args[1]
                if image_receiver is not None and canvas is not None:
                    image_receiver.draw(canvas)
                param.setResult(None)
            except Exception:
                pass


class _AvatarsListDrawableHook(MethodHook):
    """Аватарки проголосовавших в опросах (AvatarsListDrawable)."""

    def __init__(self, plugin: "ScreenshotPrivacyPlugin"):
        self.plugin = plugin

    def before_hooked_method(self, param):
        plugin = self.plugin
        should_mask = plugin._masking_active and plugin.get_setting("hide_avatars", True)
        if not should_mask and not plugin._masked_list_items:
            return
        try:
            pool = _safe_get(param.thisObject, "avatarItemsPool")
            if pool is None:
                return
            account = int(_safe_get(param.thisObject, "currentAccount", UserConfig.selectedAccount) or 0)
            for i in range(pool.size()):
                item = pool.get(i)
                if item is None:
                    continue
                if should_mask:
                    plugin.mask_avatar_list_item(item, account)
                else:
                    plugin.restore_avatar_list_item(item)
        except Exception:
            pass


class _AvatarsDrawableDrawHook(MethodHook):
    def __init__(self, plugin: "ScreenshotPrivacyPlugin", chat_msg_cell_cls: Any):
        self.plugin = plugin
        self.chat_msg_cell_cls = chat_msg_cell_cls

    def before_hooked_method(self, param):
        avd = param.thisObject
        if avd is None:
            return
        should_mask = self.plugin._masking_active and self.plugin.get_setting("hide_avatars", True)
        if not should_mask and not self.plugin._masked_avds:
            return
        try:
            if should_mask:
                # Любой владелец: сообщения, реакции, плашка знакомства, панель звонка и т.д.
                self.plugin.mask_avatars_drawable(avd, _safe_get(avd, "parent"))
            else:
                self.plugin.restore_avatars_drawable_if_needed(avd)
        except Exception:
            pass


class _PluginCellIconHook(MethodHook):
    def __init__(self, plugin_id: str):
        self.plugin_id = plugin_id

    def after_hooked_method(self, param):
        try:
            cell = param.thisObject
            plg = _safe_get(cell, "plugin")
            if plg is None or str(plg.getId() or "") != self.plugin_id:
                return
            img_view = _safe_get(cell, "imageView")
            if img_view is None:
                return
            bmp = _get_plugin_icon_bitmap()
            if bmp is None:
                return
            try:
                img_view.setAnimatedEmojiDrawable(None)
            except Exception:
                pass
            try:
                ir = img_view.getImageReceiver()
                if ir is not None:
                    ir.clearImage()
            except Exception:
                pass
            img_view.setImageBitmap(bmp)
            img_view.invalidate()
        except Exception:
            pass

class ScreenshotPrivacyPlugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self._masking_active: bool = False
        self._premask_active: bool = False
        self._premask_token: int = 0
        self._capturing_now: bool = False
        self._last_screenshot_ts: float = 0.0
        self._ignore_observer_until: float = 0.0
        self._dominant_color_cache: Dict[int, int] = {}
        self._random_color_cache: Dict[int, int] = {}
        self._container_stories_flag: Dict[int, bool] = {}
        self._container_subtitle_visible: Dict[int, bool] = {}
        self._alias_map: Dict[int, str] = {}
        self._mention_alias_map: Dict[Any, str] = {}
        self._header_random_cache: Dict[Any, str] = {}
        self._masked_avds: Dict[int, Any] = {}
        self._masked_mentions: Dict[int, Any] = {}
        self._masked_list_items: Dict[int, Any] = {}
        self._alias_counter: int = 0
        self._mention_alias_counter: int = 0
        self._layout_depth: int = 0
        self._in_avatar_apply: bool = False
        self._author_name_depth: int = 0
        self._rank_stack: List[Any] = []

        self._menu_toggle_id: Optional[str] = None
        self._menu_capture_id: Optional[str] = None

        self._notif_delegate: Optional[_ScreenshotNotificationDelegate] = None
        self._notif_accounts: List[int] = []
        self._screen_capture_cb: Any = None
        self._registered_activity: Any = None
        self._content_observer: Any = None
        self._last_mediastore_uri: Any = None

        self._app_in_foreground: bool = True
        self._last_resume_mono: float = time.monotonic()
        self._last_resume_ms: int = int(time.time() * 1000)
        self._seen_mediastore_ids: set = set()
        self._max_seen_mediastore_id: int = 0

    def _set_masking_active(self, active: bool):
        self._masking_active = bool(active)

    def _sync_default_placeholders(self):
        nick_ph = (self.get_setting("nickname_placeholder", "") or "").strip()
        if nick_ph in ("Пользователь", "User"):
            self.set_setting("nickname_placeholder", _t("Пользователь"), reload_settings=False)
        hdr_ph = (self.get_setting("header_placeholder", "") or "").strip()
        if hdr_ph in ("Собеседник", "Contact"):
            self.set_setting("header_placeholder", _t("Собеседник"), reload_settings=False)

    def on_plugin_load(self):
        global _language_choice
        _language_choice = _language_index(self.get_setting("language", 0))
        self._sync_description()
        self._sync_default_placeholders()
        self._migrate_settings()
        self._set_masking_active(bool(self.get_setting("manual_masking", False)))

        self._app_in_foreground = True
        self._last_resume_mono = time.monotonic()
        self._last_resume_ms = int(time.time() * 1000)
        self._snapshot_latest_mediastore_id()

        self._install_hooks()
        self._sync_menu_items()
        self._register_screenshot_detectors()

    def _sync_description(self):
        try:
            pc = find_class("com.exteragram.messenger.plugins.PluginsController")
            if pc is not None:
                plugin = pc.getInstance().getPlugins().get(__id__)
                if plugin is not None:
                    plugin.setDescription(_t(_DESCRIPTION))
        except Exception:
            pass

    def _language_changed(self, value: Any = None, *_):
        global _language_choice
        _language_choice = _language_index(value if value is not None else self.get_setting("language", 0))
        self._sync_default_placeholders()
        self.set_setting("language", _language_choice, reload_settings=True)
        self._sync_description()
        self._sync_menu_items()
        self._alias_map.clear(); self._mention_alias_map.clear()
        self._header_random_cache.clear()
        self._alias_counter = 0; self._mention_alias_counter = 0
        self._refresh_if_active()

    def on_plugin_unload(self):
        global _ICON_BITMAP_CACHE
        was_active = self._masking_active
        self._set_masking_active(False)
        self._premask_active = False
        self._premask_token += 1
        if was_active:
            self.set_setting("manual_masking", False)
            run_on_ui_thread(self._refresh_current_chat)

        self._unregister_screenshot_detectors()
        self._remove_menu_items()
        self.restore_all_masked_avds()
        self.restore_all_masked_mentions()
        for ref, _sig, _acc in list(self._masked_list_items.values()):
            item = ref.get()
            if item is not None:
                self.restore_avatar_list_item(item)
        self._masked_list_items.clear()
        self._dominant_color_cache.clear()
        self._container_stories_flag.clear()
        self._container_subtitle_visible.clear()
        self._alias_map.clear(); self._mention_alias_map.clear(); self._mention_alias_map.clear(); self._random_color_cache.clear(); self._header_random_cache.clear()
        _FIELD_CACHE.clear()
        _ICON_BITMAP_CACHE = None

    def on_app_event(self, event_type: AppEvent):
        if event_type == AppEvent.RESUME:
            self._app_in_foreground = True
            self._last_resume_mono = time.monotonic()
            self._last_resume_ms = int(time.time() * 1000)
            self._register_android14_callback()
            self._register_mediastore_observer()
            self._snapshot_latest_mediastore_id()
        elif event_type == AppEvent.PAUSE:
            self._app_in_foreground = False
            self._unregister_android14_callback()
            self._unregister_mediastore_observer()
            if self._premask_active:
                self._premask_active = False
                self._premask_token += 1
                if not self.get_setting("manual_masking", False) and not self._capturing_now:
                    self._set_masking_active(False)
                    self._refresh_current_chat()

    # ------------------------------------------------------------------ settings

    def _auto_intercept(self) -> bool:
        mode = self.get_setting("capture_mode", None)
        if mode is not None:
            try:
                return int(mode) == 0
            except Exception:
                pass
        value = self.get_setting("auto_intercept", None)
        if value is None:
            # миграция со старых ключей manual_only_mode / intercept_system_screenshot
            value = not bool(self.get_setting("manual_only_mode", False)) and bool(
                self.get_setting("intercept_system_screenshot", True)
            )
        return bool(value)

    def _migrate_settings(self):
        if self.get_setting("capture_mode", None) is None:
            self.set_setting("capture_mode", 0 if self._auto_intercept() else 1, reload_settings=False)

    def _menu_buttons_enabled(self) -> bool:
        # В ручном режиме кнопки в ⋮ — единственный способ, поэтому всегда включены.
        return (not self._auto_intercept()) or bool(self.get_setting("show_chat_menu", True))

    def _build_status_summary(self) -> str:
        parts = []
        if self.get_setting("hide_nicknames", True):
            parts.append(_t("имена"))
        if self.get_setting("hide_avatars", True):
            parts.append(_t("аватарки"))
        if int(self.get_setting("hide_time_mode", 0)) != 3:
            parts.append(_t("время"))
        if self.get_setting("hide_tags", True):
            parts.append(_t("тэги"))
        if self.get_setting("hide_pinned", True):
            parts.append(_t("закреп"))
        if self.get_setting("hide_service_messages", False):
            parts.append(_t("системные"))
        if self.get_setting("hide_personal_info", True):
            parts.append(_t("личные данные"))
        if self.get_setting("hide_header_name", True) or self.get_setting("hide_header_avatar", True):
            parts.append(_t("шапка"))
        hidden_str = ", ".join(parts) if parts else _t("ничего")
        return f"{_t('Скрывается: ')}{hidden_str}."

    def _on_capture_mode_changed(self, value: Any):
        try:
            mode = int(value)
        except Exception:
            mode = 0
        auto = mode == 0
        # старые ключи держим в синхроне для совместимости
        self.set_setting("auto_intercept", auto, reload_settings=False)
        self.set_setting("manual_only_mode", not auto, reload_settings=False)
        self.set_setting("intercept_system_screenshot", auto, reload_settings=False)
        self.set_setting("capture_mode", mode, reload_settings=True)
        self._sync_menu_items()

    def _on_chat_menu_changed(self, value: bool):
        self.set_setting("show_chat_menu", bool(value), reload_settings=True)
        self._sync_menu_items()

    def _on_subpage_setting_changed(self, key: str, value: Any, clear_aliases: bool = False, clear_header: bool = False):
        if clear_aliases:
            self._alias_map.clear()
            self._mention_alias_map.clear()
            self._alias_counter = 0; self._mention_alias_counter = 0
        if clear_header:
            self._header_random_cache.clear()
        self.set_setting(key, value, reload_settings=True)
        self._refresh_if_active()

    def _nick_mode_summary(self) -> str:
        nick_modes = [
            _t("Один текст"),
            _t("Участник 1, 2…"),
            _t("Пусто"),
            _t("Случайные фразы"),
            _t("Случайные символы"),
        ]
        idx = min(4, max(0, int(self.get_setting("nickname_mode", 0))))
        if idx == 0:
            raw = (self.get_setting("nickname_placeholder", "") or "").strip()
            ph = _t("Пользователь") if (not raw or raw in ("Пользователь", "User")) else raw
            return f"{nick_modes[0]}: «{ph}»"
        return nick_modes[idx]

    def _avatar_mode_summary(self) -> str:
        modes = [_t("Заливка цветом аватарки"), _t("Стандартная с буквой"), _t("Случайный цвет")]
        return modes[min(2, max(0, int(self.get_setting("avatar_mode", 0))))]

    def _header_summary(self) -> str:
        parts = []
        if self.get_setting("hide_header_name", True):
            parts.append(_t("название"))
        if self.get_setting("hide_header_subtitle", True):
            parts.append(_t("статус"))
        if self.get_setting("hide_header_avatar", True):
            parts.append(_t("аватарка"))
        if self.get_setting("hide_date_headers", False):
            parts.append(_t("даты"))
        return (_t("Скрывается: ") + ", ".join(parts)) if parts else _t("Всё отображается")

    def _create_nicks_subpage(self) -> List[Any]:
        items: List[Any] = [
            Header(text="Чем заменять имена"),
            Selector(
                key="nickname_mode",
                text="Вариант",
                icon="msg_customize",
                default=0,
                items=[
                    "Один текст для всех",
                    "Участник 1, 2…",
                    "Пусто",
                    "Случайные фразы",
                    "Случайные символы",
                ],
                on_change=lambda v: self._on_subpage_setting_changed("nickname_mode", v, clear_aliases=True),
            ),
        ]
        if int(self.get_setting("nickname_mode", 0)) == 0:
            items.append(
                Input(
                    key="nickname_placeholder",
                    text="Текст заглушки",
                    icon="msg_contacts",
                    default=_t("Пользователь"),
                    on_change=lambda v: self._refresh_if_active(),
                )
            )
        items.extend([
            Divider(text="«Участник 1, 2…» и случайные варианты сохраняют разные имена у разных людей — переписку проще читать."),
            Header(text="Где ещё заменять"),
            Switch(
                key="hide_reply_names",
                text="В ответах и пересылках",
                icon="msg_forward",
                default=True,
                on_change=lambda v: self._on_subpage_setting_changed("hide_reply_names", v),
            ),
            Switch(
                key="hide_mentions",
                text="@упоминания в тексте",
                icon="msg_mention",
                default=True,
                on_change=lambda v: self._on_subpage_setting_changed("hide_mentions", v),
            ),
            Switch(
                key="hide_statuses",
                text="Эмодзи-статусы и значки",
                subtext="Галочки верификации, эмодзи-статусы и точка «в сети».",
                icon="msg_fave",
                default=True,
                on_change=lambda v: self._on_subpage_setting_changed("hide_statuses", v),
            ),
        ])
        return items

    def _create_avatars_subpage(self) -> List[Any]:
        ava_mode = int(self.get_setting("avatar_mode", 0))
        items: List[Any] = [
            Header(text="Как выглядят скрытые аватарки"),
            Selector(
                key="avatar_mode",
                text="Стиль",
                icon="msg_photo_settings",
                default=0,
                items=[
                    "Цвет аватарки",
                    "С буквой (ТГ)",
                    "Случайный цвет",
                ],
                on_change=lambda v: self._on_subpage_setting_changed("avatar_mode", v),
            ),
        ]
        if ava_mode == 1:
            items.append(
                Selector(
                    key="avatar_letter_source",
                    text="Откуда буква",
                    icon="msg_contacts",
                    default=0,
                    items=[
                        "Реальный ник",
                        "Заглушка",
                    ],
                    on_change=lambda v: self._on_subpage_setting_changed("avatar_letter_source", v),
                )
            )
        if ava_mode == 0:
            items.extend([
                Divider(
                    text="Плагин берёт главный цвет текущей фотографии профиля и заливает им круг без буквы."
                ),
                Text(
                    text="Очистить кеш цветов аватарок",
                    subtext="Пересчитает цвета заново при следующем снимке.",
                    icon="msg_clearcache",
                    on_click=self._on_clear_color_cache_click,
                ),
            ])
        elif ava_mode == 1:
            items.append(Divider(text="Как стандартная аватарка Telegram без фото: цветной круг с первой буквой."))
        else:
            items.append(Divider(text="У каждого собеседника свой случайный цвет, новый при каждом снимке."))
        return items

    def _create_header_subpage(self) -> List[Any]:
        hide_hdr_name = bool(self.get_setting("hide_header_name", True))
        hdr_mode = int(self.get_setting("header_mode", 0))
        items: List[Any] = [
            Header(text="Верхняя панель чата"),
            Switch(
                key="hide_header_name",
                text="Название чата",
                icon="msg_groups",
                default=True,
                on_change=lambda v: self._on_subpage_setting_changed("hide_header_name", v),
            ),
        ]
        if hide_hdr_name:
            items.append(
                Selector(
                    key="header_mode",
                    text="Чем заменять название",
                    icon="msg_customize",
                    default=0,
                    items=[
                        "Авто / свой текст",
                        "Случайные фразы",
                        "Случайные символы",
                        "Пусто",
                    ],
                    on_change=lambda v: self._on_subpage_setting_changed("header_mode", v, clear_header=True),
                )
            )
            if hdr_mode == 0:
                items.append(
                    Input(
                        key="header_placeholder",
                        text="Свой текст в шапке",
                        icon="msg_contacts",
                        default=_t("Собеседник"),
                        on_change=lambda v: self._refresh_if_active(),
                    )
                )
        items.extend([
            Switch(
                key="hide_header_subtitle",
                text="Статус под названием",
                subtext="«в сети», «был(а) недавно», число участников.",
                icon="msg_recent",
                default=True,
                on_change=lambda v: self._on_subpage_setting_changed("hide_header_subtitle", v),
            ),
            Switch(
                key="hide_header_avatar",
                text="Аватарка в шапке",
                icon="msg_openprofile",
                default=True,
                on_change=lambda v: self._on_subpage_setting_changed("hide_header_avatar", v),
            ),
        ])
        if hide_hdr_name and hdr_mode == 0:
            items.append(Divider(text="В режиме «Авто» для групп и каналов пишется «Чат» / «Канал», для личных — ваш текст."))
        else:
            items.append(Divider())
        items.extend([
            Header(text="Лента сообщений"),
            Switch(
                key="hide_date_headers",
                text="Разделители дат",
                subtext="Плашки «Сегодня», «Вчера» и плавающая дата.",
                icon="msg_calendar2",
                default=False,
                on_change=lambda v: self._on_subpage_setting_changed("hide_date_headers", v),
            ),
        ])
        return items

    def _on_reset_defaults_click(self, view: Any):
        defaults = {
            "language": _language_choice,
            "manual_masking": False,
            "capture_mode": 0,
            "auto_intercept": True,
            "manual_only_mode": False,
            "intercept_system_screenshot": True,
            "three_finger_premask": True,
            "delete_original": False,
            "show_chat_menu": True,
            "hide_nicknames": True,
            "nickname_mode": 0,
            "nickname_placeholder": _t("Пользователь"),
            "hide_reply_names": True,
            "hide_mentions": True,
            "hide_time_mode": 0,
            "hide_tags": True,
            "hide_statuses": True,
            "hide_avatars": True,
            "avatar_mode": 0,
            "avatar_letter_source": 0,
            "hide_pinned": True,
            "hide_service_messages": False,
            "hide_personal_info": True,
            "hide_header_name": True,
            "header_mode": 0,
            "header_placeholder": _t("Собеседник"),
            "hide_header_subtitle": True,
            "hide_header_avatar": True,
            "hide_date_headers": False,
        }
        self._set_masking_active(False)
        self._premask_active = False
        self._dominant_color_cache.clear()
        self._alias_map.clear()
        self._mention_alias_map.clear()
        self._random_color_cache.clear()
        self._header_random_cache.clear()
        self._alias_counter = 0; self._mention_alias_counter = 0
        self.import_settings(defaults, reload_settings=True)
        self._sync_menu_items()
        run_on_ui_thread(self._refresh_current_chat)
        BulletinHelper.show_success(_t("Настройки сброшены по умолчанию"))

    def create_settings(self) -> List[Any]:
        auto = self._auto_intercept()
        hide_names = bool(self.get_setting("hide_nicknames", True))
        hide_avatars = bool(self.get_setting("hide_avatars", True))
        hide_service = bool(self.get_setting("hide_service_messages", False))

        items: List[Any] = [
            Divider(text=self._build_status_summary()),

            # ---- Режим работы
            Header(text="Режим работы"),
            Selector(
                key="capture_mode",
                text="Когда замазывать",
                icon="msg_screencast",
                default=0,
                items=["Автоматически", "Только вручную"],
                on_change=self._on_capture_mode_changed,
            ),
        ]
