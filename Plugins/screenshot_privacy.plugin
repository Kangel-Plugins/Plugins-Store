                "• «Режим скриншота» — замазывает чат на экране, пока не выключите."
            )))

        # ---- Что скрывать
        items.extend([
            Header(text="Что скрывать"),
            Switch(
                key="hide_nicknames",
                text="Имена",
                subtext="Отправители, ответы, пересылки и @упоминания.",
                icon="msg_contacts",
