class _TimeStringHook(MethodHook):
    def __init__(self, plugin: "ScreenshotPrivacyPlugin"):
        self.plugin = plugin

    def after_hooked_method(self, param):
        if not self.plugin._masking_active:
            return
        mode = int(self.plugin.get_setting("hide_time_mode", 0))
        if mode == 3:
            return
        original = param.getResult()
        if not original:
            return
        if mode in (0, 1):
            param.setResult("")
        elif mode == 2:
            param.setResult("00:00")


class _MeasureTimeHook(MethodHook):
    def __init__(self, plugin: "ScreenshotPrivacyPlugin"):
        self.plugin = plugin

    def after_hooked_method(self, param):
        if not self.plugin._masking_active:
            return
        mode = int(self.plugin.get_setting("hide_time_mode", 0))
        if mode == 3:
            return
        try:
            cell = param.thisObject
            cur_time = _safe_get(cell, "currentTimeString")
            if not cur_time and mode != 1:
                return
            old_tw = int(_safe_get(cell, "timeTextWidth", 0) or 0)
            old_w = int(_safe_get(cell, "timeWidth", 0) or 0)
            if mode == 1:
                _safe_set(cell, "currentTimeString", SpannableStringBuilder(""))
                _safe_set(cell, "timeTextWidth", 0)
                _safe_set(cell, "timeWidth", 0)
                _safe_set(cell, "timeLayout", None)
            elif mode == 0:
                _safe_set(cell, "currentTimeString", SpannableStringBuilder(""))
                _safe_set(cell, "timeTextWidth", 0)
                _safe_set(cell, "timeWidth", max(0, old_w - old_tw))
                _safe_set(cell, "timeLayout", None)
            elif mode == 2:
                fake = "00:00"
                new_tw = int(math.ceil(Theme.chat_timePaint.measureText(fake)))
                _safe_set(cell, "currentTimeString", SpannableStringBuilder(fake))
                _safe_set(cell, "timeTextWidth", new_tw)
                _safe_set(cell, "timeWidth", max(new_tw, old_w - old_tw + new_tw))
        except Exception:
            pass


class _GetExtraTimeXHook(MethodHook):
    def __init__(self, plugin: "ScreenshotPrivacyPlugin"):
        self.plugin = plugin

    def before_hooked_method(self, param):
        if not self.plugin._masking_active:
            return
        if self.plugin.should_collapse_time_space(param.thisObject):
            param.setResult(jint(0))


class _CalcBackgroundWidthHook(MethodHook):
    def __init__(self, plugin: "ScreenshotPrivacyPlugin"):
        self.plugin = plugin

    def before_hooked_method(self, param):
        if not self.plugin._masking_active:
            return
        try:
            cell = param.thisObject
            if self.plugin.should_collapse_time_space(cell):
                param.args[1] = jint(0)
        except Exception:
            pass

    def after_hooked_method(self, param):
        if not self.plugin._masking_active:
            return
        try:
            cell = param.thisObject
            if not self.plugin.should_collapse_time_space(cell):
                return
            if bool(_safe_get(cell, "hasNewLineForTime", False)):
                msg = _safe_get(cell, "currentMessageObject")
                extra_dp = 14
                if msg is not None and (
                    bool(getattr(msg, "hasCodeAtBottom", False))
                    or bool(getattr(msg, "hasQuoteAtBottom", False))
                ):
                    extra_dp = 18
                _safe_set(cell, "hasNewLineForTime", False)
                th = int(_safe_get(cell, "totalHeight", 0) or 0)
                if th > AndroidUtilities.dp(extra_dp):
                    _safe_set(cell, "totalHeight", th - AndroidUtilities.dp(extra_dp))
        except Exception:
            pass


class _DrawTimeHook(MethodHook):
    def __init__(self, plugin: "ScreenshotPrivacyPlugin"):
        self.plugin = plugin

    def before_hooked_method(self, param):
        if not self.plugin._masking_active:
            return
        mode = int(self.plugin.get_setting("hide_time_mode", 0))
        if mode == 1:
            param.setResult(None)
            return
        if mode == 0:
            try:
                cell = param.thisObject
                msg = _safe_get(cell, "currentMessageObject")
                if msg is None:
                    return
                if not msg.isOutOwner():
                    has_views = _safe_get(cell, "currentViewsString") is not None
                    has_replies = _safe_get(cell, "currentRepliesString") is not None
                    is_pinned = bool(_safe_get(cell, "isPinned", False))
                    if not has_views and not has_replies and not is_pinned:
                        param.setResult(None)
            except Exception:
                pass


class _MessageObjectApplyEntitiesHook(MethodHook):
    def __init__(self, plugin: "ScreenshotPrivacyPlugin"):
        self.plugin = plugin

    def after_hooked_method(self, param):
        if not self.plugin._masking_active or not self.plugin.get_setting("hide_mentions", True):
            return
        try:
            msg = param.thisObject
            if msg is None:
                return
            mt = _safe_get(msg, "messageText")
            if mt is None:
                return
            masked = self.plugin.mask_mentions_in_spannable(mt)
            if masked is not None:
                _safe_set(msg, "messageText", masked)
                self.plugin.track_masked_mention_msg(msg)
        except Exception:
            pass


