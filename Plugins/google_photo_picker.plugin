# -*- coding: utf-8 -*-
"""
Google Фото в меню вложений exteraGram.

Добавляет пункт «Google Фото» сразу после «Галереи» в штатное меню скрепки
(Галерея, Файл и остальные пункты не трогаются) и открывает выбор медиа с
поддержкой фото, видео, множественного выбора и облачной библиотеки Google
Фото. Выбранное уходит одним блоком (альбомом), как в обычном медиапикере
Telegram.

Как это устроено:

  * Кнопка. Индексы в ChatAttachAlert$ButtonsAdapter сдвигаются на +1 после
    notifyDataSetChanged(): раскладку дальше считает сам Telegram, поэтому
    getItemCount/getItemViewType/onBindViewHolder остаются штатными и меню не
    «съезжает». Наш слот остаётся пустым — его и оформляет AdapterBindHook.
  * Клик. Идёт штатным путём по тегу кнопки (MY_TAG) в
    ChatActivity.didPressedButton, а оттуда — в наши хуки на
    dismissWithButtonClick / processSelectedAttach. Свой OnClickListener не
    ставим: кликабельный ребёнок заставляет
    RecyclerListView.onInterceptTouchEvent вернуть false, после чего
    перестают работать нажатия по ОСТАЛЬНЫМ кнопкам меню.
  * Запуск выбора откладывается на LAUNCH_DELAY_MS. Если стартовать поверх ещё
    не закрытого BottomSheet, окно picker'а остаётся позади окна Telegram:
    активность поднимается, а на экране ничего не появляется.
  * Что открывать, решает detect_strategy(): нативный системный пикер Google
    (native), собственный выбор приложения Google Фото (photos_app) или
    системный выбор (system). Варианты перебираются от лучшего к запасному,
    поэтому неверное определение меняет только порядок, но не ломает выбор.
  * Отправка: SendMessagesHelper.SendingMediaInfo ->
    ChatActivity.didSelectSearchPhotos — тот же путь, что у поиска медиа в
    Telegram (forceDocument=false, groupMedia=true, то есть один альбом).
  * Значок вкладки — векторный логотип Google Фото (ICON_SVG), отрисованный
    ровно в размер вкладки. Цвет ему выдаёт тема через
    ImageView.setColorFilter(SRC_IN), поэтому иконка сама перекрашивается под
    светлую и тёмную тему и под выбранное состояние.
  * Видео. Telegram всегда гоняет видео через аппаратный транскодер, а на
    файлах из системного picker'а тот пишет пустой огрызок на 148 байт.
    Плагин помечает свои пути как «конвертация не нужна» (needConvert ->
    false) и сам подставляет размеры, длительность и кадр для предпросмотра.
"""

import time

from base_plugin import BasePlugin, MethodHook
from hook_utils import find_class, get_private_field, set_private_field
from android_utils import log, run_on_ui_thread
from client_utils import run_on_queue, get_last_fragment

from java import jarray, jclass
from java.lang import Boolean, Integer, Long, String
from java.util import ArrayList

from android.app import Activity
from android.content import ComponentName, Intent
from android.os import Build, Bundle

__id__ = "google_photo_picker"
__name__ = "Google Фото picker"
__description__ = (
    "Добавляет пункт «Google Фото» в меню вложений\n"
    "Доступна возможность поиска фоток по тексту (как в приложении)\n"
    "Доступны медиафайлы из облака (только гугл фото) и личного пространства!"
)
__author__ = "@varwqxddd"
__version__ = "4.1.0"
__icon__ = "pixelcamera/15"
__app_version__ = ">=12.5.1"

# ─── константы плагина ────────────────────────────────────────────────────────

# Сдвиг индексов кнопок меню: слот MY_INDEX освобождается под нашу кнопку.
# Галерея всегда стоит на позиции 0 — наша кнопка сразу после неё.
MY_INDEX = 1

# Свой id кнопки. Telegram использует 1, 3–6, 9, 11–16, 7, 8 — наш id
# не должен совпадать, чтобы клик доходил до наших хуков.
MY_TAG = 1000

# requestCode для startActivityForResult. Свободные у Telegram: 0, 1, 2, 19, 21.
MY_REQUEST_CODE = 0x6F11  # 28433

# Пауза перед запуском picker'а: даём меню вложений закрыться, иначе окно
# picker'а остаётся позади окна Telegram.
LAUNCH_DELAY_MS = 400

# Предел системного picker'а: при превышении он отвергает конфигурацию целиком
# (IllegalIntentExtraException) и закрывается.
MAX_PICK_ITEMS = 100

TAG = "[GooglePhotoPicker] "

# Нативные системные пикеры Google, умеющие показывать облако Google Фото.
# Порядок = приоритет: сначала отдельный «гугловский» пикер, затем пикер из
# модуля MediaProvider. У первого имя класса НЕ совпадает с именем пакета
# (проверено на устройстве; с «.MainActivity» активность отвечает
# «does not exist»).
GOOGLE_NATIVE_PICKERS = (
    (
        "com.google.android.photopicker",
        "com.android.photopicker.MainActivity",
    ),
    (
        "com.google.android.providers.media.module",
        "com.android.providers.media.photopicker.PhotoPickerActivity",
    ),
)

# Собственный выбор внутри приложения Google Фото — точка входа для телефонов,
# где нативного пикера Google нет или где ACTION_PICK_IMAGES перехвачен
# вендорским пикером (HyperOS, ColorOS, OriginOS, MagicOS): его пикер облако
# Google Фото не показывает, а этот — показывает (читает библиотеку самого
# Google Фото, а не локальный MediaStore). Активность экспортирована и
# запускается по явному компоненту.
GOOGLE_PHOTOS_PACKAGE = "com.google.android.apps.photos"
GOOGLE_PHOTOS_PICKER_CLASS = (
    "com.google.android.apps.photos.picker.external.ExternalPickerActivity"
)

# Действие, по которому регистрируется поставщик облачных медиа. Именно его
# наличие у Google Фото означает, что системный пикер сможет показать облако.
CLOUD_MEDIA_PROVIDER_ACTION = "android.content.action.CLOUD_MEDIA_PROVIDER"


def int_class():
    r"""
    Класс примитива int для рефлексии.

    jint из Chaquopy — это аннотация типа, а не java.lang.Class, поэтому
    getDeclaredMethod("...", jint) не находит метод. Нужен именно
    Integer.TYPE (int.class).
    """
    try:
        return Integer.TYPE
    except Exception:
        pass
    try:
        return jclass("int")
    except Exception:
        return None


# ─── 1. кнопка в меню вложений ────────────────────────────────────────────────

# ButtonsAdapter хранит позиции кнопок в int-полях: galleryButton,
# documentButton, ... , attachBotsStartRow/attachBotsEndRow и buttonsCount.
_INDEX_FIELD_SUFFIXES = ("Button", "Row")
_INDEX_FIELD_NAMES = ("buttonsCount",)


class AdapterRowsHook(MethodHook):
    """
    notifyDataSetChanged(): освобождаем слот MY_INDEX под нашу кнопку.

    Индексы сдвигаются на +1 от исходных значений. Базовые значения
    запоминаются при первом вызове: без этого повторный
    notifyDataSetChanged() сдвигал бы индексы ещё раз, и меню росло бы.

    Кнопки Telegram остаются штатными — сдвиг двигает их всех разом, а
    раскладку по новым индексам считает сам Telegram.
    """

    ADAPTER_CLASS = "org.telegram.ui.Components.ChatAttachAlert$ButtonsAdapter"

    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        if not self._is_buttons_adapter(param.thisObject):
            return
        self.plugin._rows_shifted = False

    def after_hooked_method(self, param):
        adapter = param.thisObject
        if not self._is_buttons_adapter(adapter):
            return
        if self.plugin._rows_shifted:
            return
        self.plugin._rows_shifted = True
        try:
            self._shift(adapter)
        except Exception as exc:
            log(TAG + "row shift failed: " + str(exc))

    @classmethod
    def _is_buttons_adapter(cls, obj):
        """Чужой адаптер (другая RecyclerView) сдвигать нельзя."""
        try:
            return str(obj.getClass().getName()) == cls.ADAPTER_CLASS
        except Exception:
            return False

    def _shift(self, adapter):
        """
        Сдвигает индексы кнопок на +1 от исходных значений.

        Исходные значения запоминаются один раз, в атрибуте _base_indices:
        поля Telegram при каждом notifyDataSetChanged() пересчитываются заново,
        и без такого снимка сдвиг бы накапливался.
        """
        fields = [f for f in adapter.getClass().getDeclaredFields()
                  if self._is_index_field(f)]
        if not fields:
            log(TAG + "warning: no row index fields found")
            return

        base = getattr(adapter, "_base_indices", None)
        if base is None:
            base = {}
            for field in fields:
                field.setAccessible(True)
                base[str(field.getName())] = int(field.get(adapter))
            adapter._base_indices = base

        shifted = 0
        for field in fields:
            value = base.get(str(field.getName()))
            if value is None:
                continue
            field.setAccessible(True)
            if value >= MY_INDEX:
                field.set(adapter, Integer(value + 1))
                shifted += 1
            else:
                field.set(adapter, Integer(value))

        if shifted == 0:
            log(TAG + "warning: no row indices shifted")

    @staticmethod
    def _is_index_field(field):
        try:
            if str(field.getType().getName()) != "int":
                return False
            name = str(field.getName())
            return name in _INDEX_FIELD_NAMES or name.endswith(_INDEX_FIELD_SUFFIXES)
        except Exception:
            return False


class AdapterBindHook(MethodHook):
    """
    onBindViewHolder(holder, position): оформляем нашу вкладку.

    Позиции не подменяются — слот уже освобождён AdapterRowsHook, поэтому
    штатный bind для нашего индекса ничего не рисует. Наш слот не совпадает
    ни с одним индексом Telegram, значит вьюха остаётся пустой: ей и выдаём
    логотип, подпись и свой тег для клика.

    Вьюхи переиспользуются RecyclerView, поэтому отданную другому пункту
    вьюху обязательно чистим от нашего тега.
    """

    def __init__(self, plugin):
        self.plugin = plugin
        self._ours = False

    def before_hooked_method(self, param):
        try:
            self._ours = int(param.args[1]) == MY_INDEX
        except Exception:
            self._ours = False

    def after_hooked_method(self, param):
        ours, self._ours = self._ours, False
        try:
            view = self._item_view(param.args[0])
            if view is None:
                return
            if not ours:
                # Вьюха ушла под другую кнопку. Если её отдали боту, штатный
                # bind тег не ставит — и на ней остался бы наш id, из-за чего
                # клик по боту открывал бы Google Фото.
                self.plugin.clear_stale_tag(view)
                return
            # Штатный обработчик Telegram читает id кнопки из тега — именно
            # по нему нажатие доходит до наших хуков.
            view.setTag(Integer(MY_TAG))
            self.plugin.style_button(view)
        except Exception as exc:
            log(TAG + "bind our tab failed: " + str(exc))

    @staticmethod
    def _item_view(holder):
        try:
            return holder.itemView
        except Exception:
            return get_private_field(holder, "itemView")


class AlertButtonHook(MethodHook):
    """
    Основной путь клика: ChatAttachAlert.dismissWithButtonClick(MY_TAG).

    Сюда приходит наш тег из штатного OnItemClickListener: он видит незнакомый
    id и передаёт его в delegate.didPressedButton, а тот вызывает
    dismissWithButtonClick.
    """

    def __init__(self, plugin):
        self.plugin = plugin
        self._alert = None

    def before_hooked_method(self, param):
        """
        Оригинал не блокируем: BottomSheet.dismissWithButtonClick закрывает
        меню принудительно, тогда как dismiss() уважает delegate.canDismiss()
        и может ничего не сделать. Поэтому даём Telegram закрыть меню штатно,
        а picker открываем уже после этого, в after-хуке.
        """
        self._alert = None
        try:
            button = int(param.args[0])
        except Exception:
            return
        if button != MY_TAG:
            return
        self._alert = getattr(param, "thisObject", None)

    def after_hooked_method(self, param):
        alert = self._alert
        self._alert = None
        if alert is None:
            return
        self.plugin.on_menu_item_selected(alert, None)


class ProcessSelectedAttachHook(MethodHook):
    """
    Резервный путь клика: ChatActivity.processSelectedAttach(MY_TAG).

    Telegram вызывает его сразу после dismissWithButtonClick, поэтому если
    основной хук не встал, сработает этот. Повторный запуск отсекает защита от
    дублирования в on_menu_item_selected.
    """

    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        try:
            which = int(param.args[0])
        except Exception:
            return
        if which != MY_TAG:
            return
        param.setResult(None)
        self.plugin.on_menu_item_selected(None, getattr(param, "thisObject", None))


# ─── 2. результат системного выбора ───────────────────────────────────────────

class PickerResultHook(MethodHook):
    """ChatActivity.onActivityResultFragment — забираем выбранные uri."""

    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        try:
            request_code = int(param.args[0])
        except Exception:
            return
        if request_code != MY_REQUEST_CODE:
            return
        param.setResult(None)
        try:
            result_code = int(param.args[1])
            data = param.args[2]
            if result_code != Activity.RESULT_OK or data is None:
                return
            self.plugin.on_picked(param.thisObject, data)
        except Exception as exc:
            log(TAG + "result handling failed: " + str(exc))


class VideoEditedInfoNeedConvertHook(MethodHook):
    """
    Пропускает конвертацию для видео, которые подготовил плагин.

    В Telegram needConvert() возвращает True для любого обычного видео (за
    счёт !roundVideo), поэтому он всегда гоняет файл через аппаратный
    MediaCodec. На видео из системного picker'а этот транскодер пишет пустой
    файл на 148 байт: метаданные в такой копии вырезаны, и кодировщик
    получает нулевой битрейт. Отправка после этого замирает навсегда.

    Когда needConvert() возвращает false, Telegram не создаёт временный файл,
    а берёт размер исходника целиком и загружает видео как есть — с плеером.

    Хук срабатывает только на путях, которые добавил плагин, так что обычные
    видео Telegram обрабатывает по-прежнему.
    """

    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            this = getattr(param, "thisObject", None)
            path = str(getattr(this, "originalPath", "") or "")
            bypass_paths = getattr(self.plugin, "_bypass_paths", set())
            if path and path in bypass_paths:
                param.setResult(Boolean(False))
        except Exception as exc:
            log(TAG + "needConvert hook error: " + str(exc))


class ScheduleVideoConvertHook(MethodHook):
    """
    Предохранитель: не даёт поставить наши видео в очередь перекодирования.

    Даже если Telegram по какой-то причине решит, что конвертация нужна, в
    очередь такие файлы не попадут — иначе снова получится пустой огрызок.
    """

    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        try:
            if param.args is not None and len(param.args) > 0:
                obj = param.args[0]
                info = getattr(obj, "videoEditedInfo", None)
                if info is not None:
                    path = str(getattr(info, "originalPath", "") or "")
                    bypass_paths = getattr(self.plugin, "_bypass_paths", set())
                    if path and path in bypass_paths:
                        param.setResult(Boolean(False))
        except Exception as exc:
            log(TAG + "scheduleVideoConvert hook error: " + str(exc))


# ─── иконка вкладки ──────────────────────────────────────────────────────────
#
# Логотип Google Фото, обведённый по контуру в вектор. Форма и толщина штриха
# повторяют картинку-образец (сверено попиксельно), но, в отличие от растра,
# контур остаётся резким на экране с любой плотностью.
#
# Фигура разбита на внешний контур и четыре отверстия. Намотка у них разная,
# поэтому при заливке отверстия вырезаются сами: fill-rule этот парсер не
# понимает, и без встречной намотки фигура залилась бы сплошным пятном.
#
# Цвет заливки здесь не важен: Telegram рисует иконку вкладки через
# ImageView.setColorFilter(SRC_IN) и подставляет цвет темы — светлая она или
# тёмная, вкладка выбрана или нет, всё берётся из темы автоматически.
