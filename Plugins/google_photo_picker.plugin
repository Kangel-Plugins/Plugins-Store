    "13.92 14.73 13.95 14.88 14.13 15.06 14.19 15.3 15 16.05 15.27 16.08 15.39 16.29  "
    "15.75 16.32 15.93 16.56 16.41 16.56 16.65 16.8 18.27 16.8 18.57 16.56 19.11 16.56  "
    "19.23 16.35 19.59 16.32 19.77 16.08 20.04 16.05 20.16 15.87 20.31 15.84 20.88 15.27  "
    "21.09 14.94 21.15 14.67 21.36 14.58 21.36 14.22 21.6 14.04 21.6 13.5 21.39 13.29 Z"
