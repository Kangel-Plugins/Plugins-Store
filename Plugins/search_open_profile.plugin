# bugs and suggestions: t.me/thrzxd

import traceback
from typing import Any, List, Optional

from android.os import Bundle
from base_plugin import BasePlugin, MethodHook
from hook_utils import find_class, get_private_field
from java import jclass
from org.telegram.messenger import DialogObject
from org.telegram.ui import ProfileActivity

__id__ = "search_open_profile"
__name__ = "Search Open Profile"
__description__ = "Opens the profile instead of the chat when a private chat is selected in search."
__version__ = "1.0.0"
__author__ = "@thrzxd • @kotilnya"
__icon__ = "LuckyStarankhaubivaet_by_fStikBot/20"
__app_version__ = ">=12.5.1"

DIALOGS_ACTIVITY_CLASS = "org.telegram.ui.DialogsActivity"
SEARCH_DELEGATE_CLASS = "org.telegram.ui.Adapters.DialogsSearchAdapter$DialogsSearchAdapterDelegate"

TLUser = jclass("org.telegram.tgnet.TLRPC$User")
JLong = jclass("java.lang.Long")


def _resolve_java_class(cls: Any, expected_name: str) -> Optional[Any]:
    """Returns java.lang.Class for a find_class() result, verifying its name."""
    if cls is None:
        return None
    candidates = []
    try:
        candidates.append(cls.getClass())
    except Exception:
        pass
    candidates.append(cls)
    for candidate in candidates:
        try:
            if candidate is not None and candidate.getName() == expected_name:
                return candidate
        except Exception:
            continue
    return None


def _find_java_class(name: str) -> Optional[Any]:
    return _resolve_java_class(find_class(name), name)


class SearchItemClickHook(MethodHook):
    """Hook for DialogsActivity.onItemClick(View, int, Adapter, float, float)."""

    def __init__(self, plugin: "SearchOpenProfilePlugin") -> None:
        self.plugin = plugin

    def before_hooked_method(self, param: Any) -> None:
        try:
            fragment = param.thisObject
            user = self.plugin.get_search_user(fragment, param.args[2], param.args[1])
            if user is None:
                return
            self.plugin.add_recent_search(fragment, user)
            self.plugin.open_profile(fragment, user, "search list")
            param.setResult(None)
        except Exception as e:
            self.plugin.log(f"Error in SearchItemClickHook: {e}\n{traceback.format_exc()}")


class SubDialogClickHook(MethodHook):
    """Hook for DialogsSearchAdapterDelegate.didPressedOnSubDialog(long) in DialogsActivity."""

    def __init__(self, plugin: "SearchOpenProfilePlugin") -> None:
        self.plugin = plugin

    def before_hooked_method(self, param: Any) -> None:
        try:
            fragment = self.plugin.get_outer_dialogs_activity(param.thisObject)
            user = self.plugin.get_sub_dialog_user(fragment, int(param.args[0]))
            if user is None:
                return
            self.plugin.open_profile(fragment, user, "top peers row")
            param.setResult(None)
        except Exception as e:
            self.plugin.log(f"Error in SubDialogClickHook: {e}\n{traceback.format_exc()}")


class SearchOpenProfilePlugin(BasePlugin):
    def __init__(self) -> None:
        super().__init__()
        self._unhooks: List[Any] = []

    def on_plugin_load(self) -> None:
        self._remove_hooks()
        self._hook_search_item_click()
        self._hook_sub_dialog_click()
        self.log("Plugin loaded")

    def on_plugin_unload(self) -> None:
        self._remove_hooks()
        self.log("Plugin unloaded")

    def _hook_search_item_click(self) -> None:
        try:
            dialogs_cls = _find_java_class(DIALOGS_ACTIVITY_CLASS)
            method = self._find_on_item_click(dialogs_cls)
            if method is None:
                self.log("DialogsActivity.onItemClick(View, int, Adapter, float, float) not found")
                return
            self._add_hook(method, SearchItemClickHook(self), "DialogsActivity.onItemClick")
        except Exception as e:
            self.log(f"Failed to hook DialogsActivity.onItemClick: {e}\n{traceback.format_exc()}")

    def _hook_sub_dialog_click(self) -> None:
        try:
            delegate_cls = self._find_search_delegate_class()
            if delegate_cls is None:
                self.log("DialogsSearchAdapterDelegate implementation not found in DialogsActivity")
                return
            method = delegate_cls.getDeclaredMethod("didPressedOnSubDialog", JLong.TYPE)
            method.setAccessible(True)
            self._add_hook(method, SubDialogClickHook(self), f"{delegate_cls.getName()}.didPressedOnSubDialog")
        except Exception as e:
            self.log(f"Failed to hook didPressedOnSubDialog: {e}\n{traceback.format_exc()}")

    def _find_on_item_click(self, dialogs_cls: Any) -> Optional[Any]:
        if dialogs_cls is None:
            return None
        for method in dialogs_cls.getDeclaredMethods():
            if method.getName() != "onItemClick":
                continue
            types = method.getParameterTypes()
            if len(types) == 5 and types[0].getName() == "android.view.View" and types[1].getName() == "int":
                method.setAccessible(True)
                return method
        return None

    def _find_search_delegate_class(self) -> Optional[Any]:
        # Anonymous inner classes of DialogsActivity are scanned to find the search adapter delegate
        misses = 0
        for index in range(1, 401):
            name = f"{DIALOGS_ACTIVITY_CLASS}${index}"
            cls = _find_java_class(name)
            if cls is None:
                misses += 1
                if misses > 40:
                    break
                continue
            misses = 0
            if self._implements(cls, SEARCH_DELEGATE_CLASS):
                return cls
        return None

    @staticmethod
    def _implements(cls: Any, interface_name: str) -> bool:
        try:
            return any(iface.getName() == interface_name for iface in cls.getInterfaces())
        except Exception:
            return False

    def _add_hook(self, method: Any, hook: MethodHook, label: str) -> None:
        unhook = self.hook_method(method, hook)
        if unhook:
            self._unhooks.append(unhook)
            self.log(f"Hooked {label}")

    def _remove_hooks(self) -> None:
        for unhook in self._unhooks:
            try:
                self.unhook_method(unhook)
            except Exception as e:
                self.log(f"Error unhooking method: {e}")
        self._unhooks = []

    def get_search_user(self, fragment: Any, adapter: Any, position: int) -> Optional[Any]:
        """Returns a private chat user for a search list item, or None to keep default behavior."""
        if not self._is_eligible_fragment(fragment):
            return None
        search_adapter = self._get_search_adapter(fragment)
        if search_adapter is None or adapter is None or not adapter.equals(search_adapter):
            return None
        item = search_adapter.getItem(position)
        if not isinstance(item, TLUser):
            return None
        return item if self._is_private_user(fragment, item) else None

    def get_sub_dialog_user(self, fragment: Any, dialog_id: int) -> Optional[Any]:
        """Returns a private chat user for a top peers item, or None to keep default behavior."""
        if not self._is_eligible_fragment(fragment):
            return None
        if not DialogObject.isUserDialog(dialog_id):
            return None
        user = fragment.getMessagesController().getUser(JLong.valueOf(dialog_id))
        return user if self._is_private_user(fragment, user) else None

    def get_outer_dialogs_activity(self, delegate: Any) -> Optional[Any]:
        """Extracts the enclosing DialogsActivity instance from the anonymous delegate."""
        if delegate is None:
            return None
        for field in delegate.getClass().getDeclaredFields():
            if field.getType().getName() == DIALOGS_ACTIVITY_CLASS:
                field.setAccessible(True)
                return field.get(delegate)
        return None

    @staticmethod
    def _get_search_adapter(fragment: Any) -> Optional[Any]:
        pager = get_private_field(fragment, "searchViewPager")
        return pager.dialogsSearchAdapter if pager is not None else None

    @staticmethod
    def _is_eligible_fragment(fragment: Any) -> bool:
        """Skips selection mode (forward/share) and action mode."""
        if fragment is None or fragment.getParentActivity() is None:
            return False
        if get_private_field(fragment, "onlySelect"):
            return False
        action_bar = fragment.getActionBar()
        return not (action_bar is not None and action_bar.isActionModeShowed())

    @staticmethod
    def _is_private_user(fragment: Any, user: Any) -> bool:
        if user is None or getattr(user, "bot", False):
            return False
        return user.id != fragment.getUserConfig().getClientUserId()

    def add_recent_search(self, fragment: Any, user: Any) -> None:
        try:
            search_adapter = self._get_search_adapter(fragment)
            if search_adapter is not None:
                search_adapter.putRecentSearch(user.id, user)
        except Exception as e:
            self.log(f"Failed to add recent search: {e}")

    def open_profile(self, fragment: Any, user: Any, source: str) -> None:
        args = Bundle()
        args.putLong("user_id", user.id)
        if not fragment.getMessagesController().checkCanOpenChat(args, fragment):
            self.log(f"Profile {user.id} is restricted, opening blocked ({source})")
            return
        fragment.presentFragment(ProfileActivity(args))
        self.log(f"User opened profile {user.id} from {source}")
