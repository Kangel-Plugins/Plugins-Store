__id__ = "sticker_hints_ecubz"
__name__ = "Sticker Hints DEX"
__description__ = "Точные и динамические подсказки стикеров по фразам. Одна фраза может содержать несколько стикеров. Для привязки ответьте на стикер командой .bind фраза или используйте пункт контекстного меню."
__description__en = "Exact dynamic sticker hints for custom phrases. One phrase can contain multiple stickers. Reply to a sticker with .bind phrase or use the context menu."
__author__ = "@eCubz @eCubzBio"
__version__ = "2.0.7"
__icon__ = "eCubzPlugin/1"
__app_version__ = ">=12.5.1"
__sdk_version__ = ">=1.4.3.6"

import base64
import json
import locale
import traceback

from android_utils import log, run_on_ui_thread
from base_plugin import BasePlugin, HookResult, HookStrategy
from client_utils import get_last_fragment
from dalvik.system import InMemoryDexClassLoader
from hook_utils import find_class
from java.nio import ByteBuffer
from org.telegram.messenger import ApplicationLoader, AndroidUtilities, MediaDataController, MessageObject, UserConfig
from org.telegram.tgnet import TLRPC
from org.telegram.ui.Components import AnimatedEmojiDrawable
from ui.alert import AlertDialogBuilder
from ui.bulletin import BulletinHelper
from ui.settings import Divider, Header, Input, Switch, Text

DEX_B64 = """"""

try:
    from java.util import Locale
    _language = str(Locale.getDefault().getLanguage() or "en")
except Exception:
    try:
        _language = str(locale.getdefaultlocale()[0] or "en")
    except Exception:
        _language = "en"

_LANG = "ru" if _language.lower().startswith("ru") else "en"

_STRINGS = {
    "main": {"ru": "Основные настройки", "en": "General"},
    "enabled": {"ru": "Включить подсказки", "en": "Enable hints"},
    "enabled_sub": {
        "ru": "Показывать назначенные стикеры при вводе",
        "en": "Show assigned stickers while typing",
    },
    "dynamic": {"ru": "Динамические бинды", "en": "Dynamic bindings"},
    "dynamic_sub": {
        "ru": "Подбирать стикеры уже по началу фразы",
        "en": "Suggest stickers from a phrase prefix",
    },
    "case": {"ru": "Учитывать регистр", "en": "Case sensitive"},
    "case_sub": {
        "ru": "Различать прописные и строчные буквы",
        "en": "Distinguish uppercase and lowercase letters",
    },
    "bindings": {"ru": "Привязки", "en": "Bindings"},
    "command": {"ru": "Команда привязки", "en": "Bind command"},
    "command_sub": {
        "ru": "Например: .bind или .add",
        "en": "For example: .bind or .add",
    },
    "empty": {
        "ru": "Привязок пока нет. Ответьте на стикер командой .bind фраза.",
        "en": "No bindings yet. Reply to a sticker with .bind phrase.",
    },
    "legacy": {
        "ru": "Старая запись без ID. Создайте эту привязку заново.",
        "en": "Legacy entry without an ID. Create this binding again.",
    },
    "hold": {
        "ru": "Удерживайте запись, чтобы удалить её",
        "en": "Hold an entry to delete it",
    },
    "bind_menu": {"ru": "Привязать к фразе", "en": "Bind to phrase"},
    "dialog_title": {"ru": "Привязать стикер", "en": "Bind sticker"},
    "dialog_message": {
        "ru": "Введите фразу. К одной фразе можно добавить несколько стикеров.",
        "en": "Enter a phrase. Multiple stickers can be assigned to one phrase.",
    },
    "phrase_hint": {"ru": "Фраза", "en": "Phrase"},
    "save": {"ru": "Сохранить", "en": "Save"},
    "cancel": {"ru": "Отмена", "en": "Cancel"},
    "delete": {"ru": "Удалить", "en": "Delete"},
    "delete_title": {"ru": "Удалить привязку?", "en": "Delete binding?"},
    "delete_message": {
        "ru": "Будет удалён только выбранный стикер для фразы «{word}».",
        "en": "Only the selected sticker for “{word}” will be removed.",
    },
    "saved": {
        "ru": "Стикер добавлен к фразе «{word}»",
        "en": "Sticker added to “{word}”",
    },
    "exists": {
        "ru": "Этот стикер уже привязан к фразе «{word}»",
        "en": "This sticker is already assigned to “{word}”",
    },
    "deleted": {"ru": "Привязка удалена", "en": "Binding deleted"},
    "empty_phrase": {"ru": "Фраза не может быть пустой", "en": "Phrase cannot be empty"},
    "no_reply": {
        "ru": "Ответьте на стикер и напишите {cmd} фраза",
        "en": "Reply to a sticker and type {cmd} phrase",
    },
    "not_sticker": {"ru": "В сообщении нет стикера", "en": "The message has no sticker"},
    "reopen": {
        "ru": "Переоткройте настройки, чтобы обновить список.",
        "en": "Reopen settings to refresh the list.",
    },
}


def _s(key):
    return _STRINGS.get(key, {}).get(_LANG, key)


def _as_bool(value, default=False):
    if value is None:
        return default
    if isinstance(value, str):
        normalized = value.strip().lower()
        if normalized in ("1", "true", "yes", "on"):
            return True
        if normalized in ("0", "false", "no", "off", ""):
            return False
    return bool(value)


class Plugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self._dex_loader = None
        self._dex_class = None
        self._menu_id = None
        self._bindings_cache = None

    def on_plugin_load(self):
        self._bindings_cache = None
        self._load_bindings_full()
        self._load_dex()
        try:
            self._menu_id = self.add_menu_item(
                self.MenuType.CHAT_CONTEXT,
                _s("bind_menu"),
                on_click=self._on_bind_menu,
                condition="message != null",
                priority=500,
            )
        except Exception as error:
            self.log("Не удалось добавить пункт меню: " + str(error))
        try:
            self.add_on_send_message_hook()
        except Exception as error:
            self.log("Не удалось подключить команду привязки: " + str(error))

    def on_plugin_unload(self):
        if self._menu_id is not None:
            try:
                self.remove_menu_item(self._menu_id)
            except Exception:
                pass
            self._menu_id = None
        try:
            if self._dex_class is not None:
                self._dex_class.getMethod("stop").invoke(None)
        except Exception as error:
            self.log("Не удалось остановить DEX-ядро: " + str(error))
        self._dex_class = None
        self._dex_loader = None
        self._bindings_cache = None

    def _load_dex(self):
        try:
            dex_bytes = base64.b64decode(DEX_B64, validate=True)
            buffer = ByteBuffer.wrap(dex_bytes)
            parent = ApplicationLoader.applicationContext.getClassLoader()
            self._dex_loader = InMemoryDexClassLoader(buffer, parent)
            self._dex_class = self._dex_loader.loadClass(
                "ru.ecubz.stickerhints.StickerHintsDex"
            )
            self._dex_class.getMethod("start").invoke(None)
            self._sync_dex()
            self.log("DEX-ядро Sticker Hints запущено")
        except Exception as error:
            self._dex_class = None
            self._dex_loader = None
            self.log("Не удалось загрузить DEX-ядро: " + str(error))

    def _sync_dex(self):
        try:
            if self._dex_class is not None:
                bindings_json = json.dumps(self._load_bindings_full(), ensure_ascii=False)
                enabled = _as_bool(self.get_setting("enabled", True))
                case_sensitive = _as_bool(self.get_setting("case_sensitive", False))
                dynamic = _as_bool(self.get_setting("dynamic_bindings", True))
                string_class = find_class("java.lang.String")
                boolean_type = find_class("java.lang.Boolean").TYPE
                self._dex_class.getMethod(
                    "syncSettingsData",
                    string_class,
                    boolean_type,
                    boolean_type,
                    boolean_type,
                ).invoke(None, bindings_json, enabled, case_sensitive, dynamic)
        except Exception as error:
            self.log("Не удалось синхронизировать DEX-ядро: " + str(error))

    def _register_document(self, document):
        try:
            if self._dex_class is None or document is None:
                return
            object_class = find_class("java.lang.Object")
            method = self._dex_class.getMethod("registerDocument", object_class)
            method.invoke(None, document)
        except Exception as error:
            self.log("Не удалось передать стикер в DEX-ядро: " + str(error))

    def _set_boolean(self, key, value):
        parsed = value.lower() == "true" if isinstance(value, str) else bool(value)
        self.set_setting(key, parsed)
        self._sync_dex()

    def create_settings(self):
        try:
            items = [
                Header(text=_s("main")),
                Switch(
                    key="enabled",
                    text=_s("enabled"),
                    subtext=_s("enabled_sub"),
                    default=True,
                    icon="msg_sticker",
                    on_change=lambda value: self._set_boolean("enabled", value),
                ),
                Switch(
                    key="dynamic_bindings",
                    text=_s("dynamic"),
                    subtext=_s("dynamic_sub"),
                    default=True,
                    icon="msg_search",
                    on_change=lambda value: self._set_boolean("dynamic_bindings", value),
                ),
                Switch(
                    key="case_sensitive",
                    text=_s("case"),
                    subtext=_s("case_sub"),
                    default=False,
                    icon="msg_edit",
                    on_change=lambda value: self._set_boolean("case_sensitive", value),
                ),
                Divider(),
                Header(text=_s("bindings")),
                Input(
                    key="bind_command",
                    text=_s("command"),
                    subtext=_s("command_sub"),
                    default=".bind",
                ),
                Divider(),
            ]

            bindings = self._load_bindings_full()
            if not bindings:
                items.append(Text(text=_s("empty"), icon="msg_info"))
            else:
                for word in sorted(bindings.keys(), key=str.lower):
                    for index, info in enumerate(bindings[word]):
                        emoji = str(info.get("emoji") or "")
                        document_id = info.get("doc_id")
                        set_name = str(info.get("set_name") or "")
                        title = word + (" → " + emoji if emoji else "")
                        details = []
                        if set_name:
                            details.append(set_name)
                        if document_id:
                            details.append("ID " + str(document_id))
                        else:
                            details.append(_s("legacy"))
                        display = title + "\n" + " · ".join(details)
                        items.append(
                            Text(
                                text=display,
                                icon="msg_sticker",
                                on_long_click=self._make_delete_handler(word, index),
                            )
                        )
                items.append(Divider(text=_s("hold")))
            return items
        except Exception as error:
            log("Sticker Hints: ошибка настроек: " + str(error) + "\n" + traceback.format_exc())
            return []

    def _make_delete_handler(self, word, index):
        def on_long_click(_context):
            def show_dialog():
                try:
                    fragment = get_last_fragment()
                    activity = fragment.getParentActivity() if fragment else None
                    if activity is None:
                        return
                    builder = AlertDialogBuilder(activity)
                    builder.set_title(_s("delete_title"))
                    builder.set_message(_s("delete_message").format(word=word))

                    def delete_binding(dialog, _which):
                        self._delete_binding(word, index)
                        dialog.dismiss()
                        BulletinHelper.show_info(_s("deleted") + "\n" + _s("reopen"))

                    builder.set_positive_button(_s("delete"), delete_binding)
                    builder.set_negative_button(_s("cancel"), None)
                    builder.show()
                except Exception as error:
                    self.log("Не удалось открыть удаление привязки: " + str(error))

            run_on_ui_thread(show_dialog)
            return True

        return on_long_click

    def _delete_binding(self, word, index):
        bindings = self._load_bindings_full()
        values = list(bindings.get(word) or [])
        if 0 <= index < len(values):
            values.pop(index)
            if values:
                bindings[word] = values
            else:
                bindings.pop(word, None)
            self._save_bindings_full(bindings)

    def _normalize_item(self, value):
        if isinstance(value, str):
            value = {"emoji": value}
        if not isinstance(value, dict):
            return None
        result = {}
        emoji = str(value.get("emoji") or "").strip()
        if emoji:
            result["emoji"] = emoji
        for key in ("doc_id", "access_hash", "dc_id", "set_id", "set_access_hash"):
            raw = value.get(key)
            if raw is not None:
                try:
                    parsed = int(raw)
                    if parsed:
                        result[key] = parsed
                except Exception:
                    pass
        for key in ("file_ref", "mime_type", "set_name"):
            val = str(value.get(key) or "").strip()
            if val:
                result[key] = val
        return result if result else None

    def _normalize_bindings(self, data):
        result = {}
        if not isinstance(data, dict):
            return result
        for raw_word, raw_values in data.items():
            word = str(raw_word or "").strip()
            if not word:
                continue
            values = raw_values if isinstance(raw_values, list) else [raw_values]
            clean = []
            seen_ids = set()
            for value in values:
                item = self._normalize_item(value)
                if not item:
                    continue
                document_id = item.get("doc_id")
                if document_id and document_id in seen_ids:
                    continue
                if document_id:
                    seen_ids.add(document_id)
                clean.append(item)
            if clean:
                result[word] = clean
        return result

    def _load_bindings_full(self):
        if self._bindings_cache is not None:
            return {
                word: [dict(item) for item in values]
                for word, values in self._bindings_cache.items()
            }

        data = {}
        raw_v4 = self.get_setting("bindings_v4", "")
        if raw_v4:
            try:
                data = json.loads(str(raw_v4))
            except Exception:
                data = {}
        else:
            raw_v3 = self.get_setting("bindings_v3", "")
            if raw_v3:
                try:
                    data = json.loads(str(raw_v3))
                except Exception:
                    data = {}
            if not data:
                data = self._load_legacy_bindings()

        normalized = self._normalize_bindings(data)
        self._bindings_cache = normalized
        if not raw_v4 and normalized:
            self.set_setting("bindings_v4", json.dumps(normalized, ensure_ascii=False))
        return {
            word: [dict(item) for item in values]
            for word, values in normalized.items()
        }

    def _load_legacy_bindings(self):
        data = {}
        raw_json = self.get_setting("bindings_json", "")
        if raw_json:
            try:
                old = json.loads(str(raw_json))
                if isinstance(old, dict):
                    for word, emoji in old.items():
                        data.setdefault(str(word), []).append({"emoji": emoji})
            except Exception:
                pass

        raw_list = self.get_setting("bindings_list", "")
        if raw_list:
            for pair in str(raw_list).split(","):
                if "=" not in pair:
                    continue
                word, emoji = pair.split("=", 1)
                word = word.strip()
                emoji = emoji.strip()
                if word and emoji:
                    data.setdefault(word, []).append({"emoji": emoji})

        raw_ids = self.get_setting("bound_doc_ids", "")
        if raw_ids:
            try:
                identifiers = json.loads(str(raw_ids))
                if isinstance(identifiers, dict):
                    for lower_word, entry in identifiers.items():
                        target_word = next(
                            (word for word in data if word.lower() == str(lower_word).lower()),
                            None,
                        )
                        if target_word is None:
                            continue
                        values = data.get(target_word) or []
                        if not values:
                            values.append({})
                        target = values[0]
                        if isinstance(entry, dict):
                            target.update(entry)
                        elif isinstance(entry, (int, float)):
                            target["doc_id"] = int(entry)
            except Exception:
                pass
        return data

    def _save_bindings_full(self, bindings):
        normalized = self._normalize_bindings(bindings)
        self.set_setting("bindings_v4", json.dumps(normalized, ensure_ascii=False))
        self._bindings_cache = normalized
        self._sync_dex()

    def _find_word_key(self, bindings, phrase):
        case_sensitive = _as_bool(self.get_setting("case_sensitive", False))
        if case_sensitive:
            return phrase if phrase in bindings else None
        lowered = phrase.lower()
        return next((word for word in bindings if word.lower() == lowered), None)

    def _extract_sticker(self, message):
        document = None
        account = UserConfig.selectedAccount
        try:
            account = int(getattr(message, "currentAccount", UserConfig.selectedAccount))
        except Exception:
            pass

        try:
            document = MessageObject.getDocument(message)
        except Exception:
            pass

        owner = getattr(message, "messageOwner", None) or message
        if document is None:
            try:
                media = getattr(owner, "media", None)
                document = getattr(media, "document", None) if media else None
            except Exception:
                document = None

        if document is None:
            try:
                entities = getattr(owner, "entities", None)
                if entities is not None:
                    for i in range(entities.size()):
                        ent = entities.get(i)
                        if isinstance(ent, TLRPC.TL_messageEntityCustomEmoji):
                            if getattr(ent, "document", None) is not None:
                                document = ent.document
                                break
                            doc_id = int(getattr(ent, "document_id", 0) or 0)
                            if doc_id:
                                try:
                                    document = AnimatedEmojiDrawable.findDocument(account, doc_id)
                                except Exception:
                                    document = None
                                if document is None:
                                    try:
                                        media_dc = MediaDataController.getInstance(account)
                                        sets = media_dc.getStickerSets(MediaDataController.TYPE_EMOJIPACKS)
                                        if sets is not None:
                                            for s in range(sets.size()):
                                                st_set = sets.get(s)
                                                if st_set is not None and st_set.documents is not None:
                                                    for d in range(st_set.documents.size()):
                                                        doc_item = st_set.documents.get(d)
                                                        if doc_item is not None and int(doc_item.id) == doc_id:
                                                            document = doc_item
                                                            break
                                                    if document is not None:
                                                        break
                                    except Exception:
                                        pass
                                if document is not None:
                                    break
            except Exception:
                pass

        if document is None:
            return None

        sticker_attribute = None
        custom_emoji_attribute = None
        try:
            attributes = getattr(document, "attributes", None)
            if attributes is not None:
                for i in range(attributes.size()):
                    attribute = attributes.get(i)
                    if isinstance(attribute, TLRPC.TL_documentAttributeSticker):
                        sticker_attribute = attribute
                    elif isinstance(attribute, TLRPC.TL_documentAttributeCustomEmoji):
                        custom_emoji_attribute = attribute
        except Exception:
            pass

        if sticker_attribute is None and custom_emoji_attribute is None:
            return None

        alt_emoji = ""
        if sticker_attribute is not None and getattr(sticker_attribute, "alt", None):
            alt_emoji = str(sticker_attribute.alt).strip()
        elif custom_emoji_attribute is not None and getattr(custom_emoji_attribute, "alt", None):
            alt_emoji = str(custom_emoji_attribute.alt).strip()

        result = {
            "document": document,
            "doc_id": int(document.id),
            "access_hash": int(getattr(document, "access_hash", 0) or 0),
            "dc_id": int(getattr(document, "dc_id", 0) or 0),
            "mime_type": str(getattr(document, "mime_type", "") or "image/webp"),
            "emoji": alt_emoji,
        }
        try:
            file_ref = getattr(document, "file_reference", None)
            if file_ref is not None and len(file_ref) > 0:
                result["file_ref"] = base64.b64encode(bytes(file_ref)).decode("ascii")
        except Exception:
            pass

        input_set = getattr(sticker_attribute, "stickerset", None) if sticker_attribute else None
        if input_set is None and custom_emoji_attribute is not None:
            input_set = getattr(custom_emoji_attribute, "stickerset", None)
        if input_set is None:
            try:
                input_set = MediaDataController.getInputStickerSet(document)
            except Exception:
                input_set = None

        if input_set is not None:
            try:
                set_id = int(getattr(input_set, "id", 0) or 0)
                if set_id:
                    result["set_id"] = set_id
            except Exception:
                pass
            try:
                access_hash = int(getattr(input_set, "access_hash", 0) or 0)
                if access_hash:
                    result["set_access_hash"] = access_hash
            except Exception:
                pass
            try:
                set_name = str(getattr(input_set, "short_name", None) or "").strip()
                if set_name:
                    result["set_name"] = set_name
            except Exception:
                pass
        return result

    def _add_binding(self, phrase, sticker):
        phrase = " ".join(str(phrase or "").split()).strip()
        if not phrase:
            BulletinHelper.show_error(_s("empty_phrase"))
            return False

        bindings = self._load_bindings_full()
        word_key = self._find_word_key(bindings, phrase)
        if word_key is None:
            word_key = phrase
            bindings[word_key] = []

        document_id = int(sticker["doc_id"])
        fields_to_copy = (
            "emoji", "access_hash", "dc_id", "mime_type", "file_ref",
            "set_id", "set_access_hash", "set_name"
        )
        for item in bindings[word_key]:
            if int(item.get("doc_id") or 0) == document_id:
                for key in fields_to_copy:
                    if sticker.get(key):
                        item[key] = sticker[key]
                self._save_bindings_full(bindings)
                self._register_document(sticker.get("document"))
                BulletinHelper.show_info(_s("exists").format(word=word_key))
                return False

        item = {
            key: sticker[key]
            for key in ("doc_id", "emoji", "access_hash", "dc_id", "mime_type", "file_ref", "set_id", "set_access_hash", "set_name")
            if sticker.get(key) is not None and sticker.get(key) != ""
        }
        bindings[word_key].append(item)
        self._save_bindings_full(bindings)
        self._register_document(sticker.get("document"))
        BulletinHelper.show_success(_s("saved").format(word=word_key))
        return True

    def _on_bind_menu(self, context):
        try:
            message = context.get("message") if context else None
            sticker = self._extract_sticker(message)
            if sticker is None:
                BulletinHelper.show_error(_s("not_sticker"))
                return

            fragment = get_last_fragment()
            activity = fragment.getParentActivity() if fragment else None
            if activity is None:
                return
            edit_text_class = find_class("android.widget.EditText")
            frame_layout_class = find_class("android.widget.FrameLayout")
            container = frame_layout_class(activity)
            edit_text = edit_text_class(activity)
            edit_text.setHint(_s("phrase_hint"))
            edit_text.setSingleLine(True)
            padding = AndroidUtilities.dp(20)
            container.setPadding(padding, AndroidUtilities.dp(8), padding, AndroidUtilities.dp(8))
            container.addView(edit_text)

            builder = AlertDialogBuilder(activity)
            builder.set_title(_s("dialog_title"))
            builder.set_message(_s("dialog_message"))
            builder.set_view(container)

            def save_binding(_dialog, _which):
                phrase = str(edit_text.getText().toString() or "").strip()
                self._add_binding(phrase, sticker)

            builder.set_positive_button(_s("save"), save_binding)
            builder.set_negative_button(_s("cancel"), None)
            builder.show()
        except Exception as error:
            self.log("Не удалось открыть создание привязки: " + str(error))

    def on_send_message_hook(self, account, params):
        matched = False
        try:
            if params is None or getattr(params, "message", None) is None:
                return HookResult()
            text = str(params.message or "").strip()
            custom = str(self.get_setting("bind_command", ".bind") or ".bind").strip()
            commands = []
            for command in (custom, ".bind", ".привязать"):
                if command and command.lower() not in [value.lower() for value in commands]:
                    commands.append(command)

            phrase = ""
            lower_text = text.lower()
            for command in commands:
                lower_command = command.lower()
                if lower_text == lower_command:
                    matched = True
                    break
                prefix = lower_command + " "
                if lower_text.startswith(prefix):
                    matched = True
                    phrase = text[len(command):].strip()
                    break
            if not matched:
                return HookResult()
            if not phrase:
                BulletinHelper.show_error(_s("empty_phrase"))
                return HookResult(strategy=HookStrategy.CANCEL)

            reply_to = getattr(params, "replyToMsg", None)
            if reply_to is None:
                BulletinHelper.show_error(_s("no_reply").format(cmd=custom))
                return HookResult(strategy=HookStrategy.CANCEL)
            sticker = self._extract_sticker(reply_to)
            if sticker is None:
                BulletinHelper.show_error(_s("not_sticker"))
                return HookResult(strategy=HookStrategy.CANCEL)

            self._add_binding(phrase, sticker)
            return HookResult(strategy=HookStrategy.CANCEL)
        except Exception as error:
            self.log("Ошибка команды привязки: " + str(error) + "\n" + traceback.format_exc())
            if matched:
                return HookResult(strategy=HookStrategy.CANCEL)
            return HookResult()
