def _argb(h):
    h = h.lstrip("#")
    if len(h) == 6:
        h = "FF" + h
    v = int(h, 16)
    return v - (1 << 32) if v >= (1 << 31) else v


def _with_alpha(color, a):
    v = ((a & 0xFF) << 24) | ((color & 0xFFFFFFFF) & 0x00FFFFFF)
    return v - (1 << 32) if v >= (1 << 31) else v


WHITE = _argb("#FFFFFF")


def _dark_background(radius_px):
    bg = GradientDrawable(GradOrient.TL_BR, jarray(jint)([_argb("#0B0E2A"), _argb("#1A1247"), _argb("#0A2A3E")]))
    bg.setCornerRadius(float(radius_px))
    return bg


class _Click(dynamic_proxy(jclass("android.view.View$OnClickListener"))):
    def __init__(self, fn):
        super().__init__()
        self.fn = fn

    def onClick(self, view):
        try:
            self.fn()
        except Exception:
            log("GiftsStudio click: " + traceback.format_exc())


class _Seek(dynamic_proxy(jclass("android.widget.SeekBar$OnSeekBarChangeListener"))):
    def __init__(self, fn):
        super().__init__()
        self.fn = fn

    def onProgressChanged(self, bar, progress, from_user):
        if from_user:
            try:
                self.fn(int(progress))
            except Exception:
                log("GiftsStudio seek: " + traceback.format_exc())

    def onStartTrackingTouch(self, bar):
        pass

    def onStopTrackingTouch(self, bar):
        pass


class _Attach(dynamic_proxy(jclass("androidx.recyclerview.widget.RecyclerView$OnChildAttachStateChangeListener"))):
    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin

    def onChildViewAttachedToWindow(self, view):
        try:
            self.plugin._on_attach(view)
        except Exception:
            self.plugin._err()

    def onChildViewDetachedFromWindow(self, view):
        pass


class _Detach(dynamic_proxy(jclass("android.view.View$OnAttachStateChangeListener"))):
    def __init__(self, anims):
        super().__init__()
        self.anims = anims

    def onViewAttachedToWindow(self, view):
        pass

    def onViewDetachedFromWindow(self, view):
        for a in list(self.anims):
            try:
                a.cancel()
            except Exception:
                pass
        self.anims.clear()


class _Touch(dynamic_proxy(jclass("androidx.recyclerview.widget.RecyclerView$OnItemTouchListener"))):
    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin

    def onInterceptTouchEvent(self, rv, e):
        try:
            return bool(self.plugin._pick_touch(rv, e, False))
        except Exception:
            self.plugin._err()
            return False

    def onTouchEvent(self, rv, e):
        try:
            self.plugin._pick_touch(rv, e, True)
        except Exception:
            self.plugin._err()

    def onRequestDisallowInterceptTouchEvent(self, disallow):
        pass


class _FillHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            self.plugin._on_fill(param)
        except Exception:
            self.plugin._err()


class GiftsStudioPlugin(BasePlugin):
    _running = False
    _ru = False
    _gen = 0
    _d = 3.0
    _tab = 0
    _motion_ok = True
    _saver_t = 0.0
    _saver_v = False

    # lifecycle
    def on_plugin_load(self):
        self._running = True
        self._gen += 1
        self._cur = None
        self._geo = None
        self._pid = 0
        self._orig = {}
        self._styled = {}
        self._listened = set()
        self._anim = {}
        self._minpos = {}
        self._seen = {}
        self._shown = {}
        self._bg_orig = {}
        self._tile_sig = {}
        self._cfg_cache = dict(DEFAULTS)
        self._mk = {}
        self._mk_src = None
        self._maxstars = 0
        self._ovr_cache = {}
        self._ovr_use = {}
        self._ovr_raw = None
        self._bypass = False
        self._fly_clock = 0.0
        self._fly_paused = False
        self._last_frame = time.time()
        self._clipped = {}
        self._pick = False
        self._undo = []
        self._last_err = ""
        self._span_note = ""
        self._hook_info = []
        self._fill_calls = 0
        self._fill_gifts = 0
        self._ru = self._detect_ru()
        self._overshoot = jclass("android.view.animation.OvershootInterpolator")(1.4)
        self._install_hooks()
        self._add_menus()
        gen = self._gen
        run_on_ui_thread(lambda: self._loop(gen), 600)
        run_on_ui_thread(lambda: self._frame(gen), 900)

    def on_plugin_unload(self):
        self._running = False
        self._gen += 1
        try:
            run_on_ui_thread(self._restore_all)
        except Exception:
            pass

    def _detect_ru(self):
        try:
            lc = jclass("org.telegram.messenger.LocaleController").getInstance().getCurrentLocale()
            return str(lc.getLanguage()).startswith("ru")
        except Exception:
            try:
                return str(jclass("java.util.Locale").getDefault().getLanguage()).startswith("ru")
            except Exception:
                return False

    def _t(self, en, ru):
        return ru if self._ru else en

    def _err(self):
        msg = traceback.format_exc()
        if msg != self._last_err:
            self._last_err = msg
            log("GiftsStudio: " + msg)

    # hooks / menus
    def _install_hooks(self):
        hook = _FillHook(self)
        for name in CONTAINER_CLASSES:
            try:
                cls = find_class(name)
                if cls is None:
                    continue
                self.hook_all_methods(cls, "fillItems", hook)
                self._hook_info.append("fillItems @ " + name)
            except Exception as e:
                self._hook_info.append("fail @ " + name + ": " + str(e))

    def _add_menus(self):
        for tname in ("PROFILE_ACTION_MENU", "DRAWER_MENU"):
            mtype = getattr(MenuItemType, tname, None)
            if mtype is None:
                continue
            try:
                self.add_menu_item(MenuItemData(
                    menu_type=mtype,
                    text=self._t("Gifts Studio", "Студия подарков"),
                    icon="msg_gift_premium",
                    on_click=lambda *a: self.open_studio(),
                ))
            except Exception:
                self._err()

    # settings storage
    def _gi(self, key, default):
        try:
            return int(float(self.get_setting(key, default)))
        except Exception:
            return default

    def _jget(self, name):
        try:
            v = json.loads(self.get_setting(name, "{}") or "{}")
            return v if isinstance(v, dict) else {}
        except Exception:
            return {}

    def _jset(self, name, value):
        self.set_setting(name, json.dumps(value))

    def _norm(self, key, v, default):
        if key in BOOL_KEYS:
            if isinstance(v, str):
                return v.strip().lower() in ("1", "true", "yes", "on")
            return bool(v)
        if key in STR_KEYS:
            return str(v if v is not None else "")
        try:
            v = int(float(v))
        except Exception:
            v = default
        lo, hi = RANGES.get(key, (-10 ** 9, 10 ** 9))
        return max(lo, min(hi, v))

    def _cfg(self, pid=0):
        c = {k: self._norm(k, self.get_setting(k, d), d) for k, d in DEFAULTS.items()}
        if self._gi("scope", 0) == 1 and pid:
            ov = self._jget("profiles").get(str(pid))
            if isinstance(ov, dict):
                for k, v in ov.items():
                    if k in DEFAULTS:
                        c[k] = self._norm(k, v, DEFAULTS[k])
        return c

    def _put(self, key, value, pid=0):
        if self._gi("scope", 0) == 1 and pid:
            prof = self._jget("profiles")
            prof.setdefault(str(pid), {})[key] = value
            self._jset("profiles", prof)
        else:
            self.set_setting(key, str(value) if key in INPUT_KEYS else value)

    def _own_id(self):
        try:
            uc = jclass("org.telegram.messenger.UserConfig")
            return int(uc.getInstance(uc.selectedAccount).getClientUserId())
        except Exception:
            return 0

    def _applies(self, pid):
        mode = self._gi("apply_to", 0)
        if mode == 0 or not pid:
            return True
        mine = pid == self._own_id()
        return mine if mode == 2 else not mine

    def _accent(self):
        return _argb(ACCENTS[self._gi("accent", 0) % len(ACCENTS)][2])

    # java helpers
    def _cname(self, obj):
        try:
            return str(obj.getClass().getName())
        except Exception:
            return ""

    def _ident(self, obj):
        try:
            return int(System.identityHashCode(obj))
        except Exception:
            return 0

    def _gv(self, obj, path, default=None):
        cur = obj
        for part in path.split("."):
            if cur is None:
                return default
            try:
                cur = getattr(cur, part)
            except Exception:
                return default
        return default if cur is None else cur

    def _pid_from(self, container):
        try:
            v = get_private_field(container, "dialogId")
            if v:
                return int(v)
        except Exception:
            pass
        try:
            return int(get_last_fragment().getDialogId())
        except Exception:
            return self._pid

    def _saver(self, act=None):
        now = time.time()
        if now - self._saver_t < 5.0:
            return self._saver_v
        self._saver_t = now
        v = False
        try:
            if self.get_setting("battery_aware", True):
                if act is None:
                    act = get_last_fragment().getParentActivity()
                v = bool(act.getSystemService("power").isPowerSaveMode())
        except Exception:
            v = False
        self._saver_v = v
        return v

    # fillItems hook: order / filter
    def _key_of(self, obj):
        # Saved gifts have no single stable id, so the key combines every field that identifies one.
        g = self._gv(obj, "gift")
        if g is None:
            g = obj
        return "|".join(str(x) for x in (
            self._gv(g, "id", 0), self._gv(obj, "msg_id", 0), self._gv(obj, "saved_id", 0),
            self._gv(obj, "date", 0), self._gv(g, "num", 0)))

    def _meta(self, obj, idx):
        g = self._gv(obj, "gift")
        if g is None:
            g = obj
        stars = self._gv(g, "stars", 0)
        title = str(self._gv(g, "title", ""))
        num = self._gv(g, "num", 0)
        gid = self._gv(g, "id", 0)
        unique = "Unique" in self._cname(g)
        key = self._key_of(obj)
        label = ("%s #%s" % (title, num)) if (unique and title) else ("\u2605 %s" % stars)
        return {
            "key": key, "idx": idx, "unique": unique, "label": label, "title": title or label,
            "date": int(self._gv(obj, "date", 0) or 0), "stars": int(stars or 0), "num": int(num or 0),
            "total": int(self._gv(g, "availability_total", 0) or 0),
            "pinned": bool(self._gv(obj, "pinned_to_top", False)), "gid": int(gid or 0),
            "has_msg": self._gv(obj, "message") is not None,
            "anon": bool(self._gv(obj, "name_hidden", False)),
        }

    def _process(self, metas, cfg, pid):
        hidden = set(self._jget("hidden").get(str(pid), []))
        q = cfg["query"].strip().lower()
        f = cfg["filter"]
        order = []
        for i, m in enumerate(metas):
            if not cfg["peek_hidden"] and m["key"] in hidden:
                continue
            if f == 1 and not m["unique"]:
                continue
            if f == 2 and m["unique"]:
                continue
            if f == 3 and not (m["total"] > 0 and not m["unique"]):
                continue
            if f == 4 and not m["pinned"]:
                continue
            if q and q not in m["title"].lower() and q not in m["label"].lower():
                continue
            if not m["unique"]:
                if cfg["minstars"] and m["stars"] < cfg["minstars"]:
                    continue
                if cfg["maxstars"] and m["stars"] > cfg["maxstars"]:
                    continue
            if cfg["only_msg"] and not m["has_msg"]:
                continue
            if cfg["hide_anon"] and m["anon"]:
                continue
            order.append(i)
        s = cfg["sort"]
        M = metas
        if s == 1:
            order.sort(key=lambda i: -M[i]["date"])
        elif s == 2:
            order.sort(key=lambda i: M[i]["date"])
        elif s == 3:
            order.sort(key=lambda i: -M[i]["stars"])
        elif s == 4:
            order.sort(key=lambda i: M[i]["stars"])
        elif s == 5:
            order.sort(key=lambda i: M[i]["total"] if M[i]["total"] > 0 else 10 ** 9)
        elif s == 6:
            order.sort(key=lambda i: M[i]["title"].lower())
        elif s == 7:
            order.sort(key=lambda i: (M[i]["gid"], i))
        elif s == 8:
            random.Random(cfg["seed"]).shuffle(order)
        elif s == 9:
            rank = {k: n for n, k in enumerate(self._jget("manual").get(str(pid), []))}
            order.sort(key=lambda i: rank.get(M[i]["key"], 10 ** 6 + i))
        elif s == 10:
            order.sort(key=lambda i: M[i]["num"] if M[i]["num"] > 0 else 10 ** 9)
        elif s == 11:
            order.sort(key=lambda i: (0, -M[i]["num"]) if M[i]["num"] > 0 else (1, 0))
        if cfg["reverse"]:
            order.reverse()
        if cfg["pinned_first"]:
            order = [i for i in order if M[i]["pinned"]] + [i for i in order if not M[i]["pinned"]]
        if cfg["limit"] > 0:
            order = order[:cfg["limit"]]
        return order

    def _on_fill(self, param):
        if not self._running or self._bypass or not self.get_setting("enabled", True):
            return
        items = None
        for a in param.args:
            if a is not None and hasattr(a, "subList") and hasattr(a, "set"):
                items = a
                break
        if items is None:
            return
        self._fill_calls += 1
        pid = self._pid_from(param.thisObject)
        n = int(items.size())
        idxs, gifts = [], []
        for i in range(n):
            it = items.get(i)
            obj = getattr(it, "object", None) if it is not None else None
            if obj is not None and "StarGift" in self._cname(obj):
                idxs.append(i)
                gifts.append((it, self._meta(obj, len(gifts))))
        self._fill_gifts = len(gifts)
        metas = [g[1] for g in gifts]
        self._seen[pid] = metas
        if not gifts:
            return
        cfg = self._cfg(pid)
        if not self._applies(pid):
            self._shown[pid] = [m["key"] for m in metas]
            return
        order = self._process(metas, cfg, pid)
        self._shown[pid] = [metas[i]["key"] for i in order]
        new_items = [gifts[i][0] for i in order]
        for slot, it in enumerate(new_items):
            items.set(idxs[slot], it)
        if len(new_items) < len(idxs):
            tail = idxs[len(new_items):]
            if tail == list(range(tail[0], tail[-1] + 1)):
                items.subList(tail[0], tail[-1] + 1).clear()

    # loops
    def _loop(self, gen):
        # Cells are recycled on scroll, so styling is re-applied on a timer instead of once.
        if not self._running or gen != self._gen:
            return
        try:
            self._scan_and_apply()
        except Exception:
            self._err()
        run_on_ui_thread(lambda: self._loop(gen), 350)

    def _frame(self, gen):
        if not self._running or gen != self._gen:
            return
        delay = 250
        now = time.time()
        dt = min(0.1, max(0.0, now - self._last_frame))
        self._last_frame = now
        try:
            cfg = self._cfg_cache
            moving = (cfg["float_amp"] > 0 or cfg["fly"]) and self._cur and self._geo and self._motion_ok
            if moving:
                delay = 20 if cfg["fly"] else 33
                lst = self._cur[1]
                if cfg["fly"]:
                    if not self._fly_paused:
                        self._fly_clock += dt * cfg["fly_speed"] * 3.0
                    self._geo["win"] = self._win(lst)
                for i in range(int(lst.getChildCount())):
                    self._style_child(lst, lst.getChildAt(i), cfg, self._geo, False, now)
        except Exception:
            self._err()
        run_on_ui_thread(lambda: self._frame(gen), delay)

    def _win(self, lst):
        try:
            arr = jarray(jint)([0, 0])
            lst.getLocationInWindow(arr)
            root = lst.getRootView()
            return (int(arr[0]), int(arr[1]), int(root.getWidth()), int(root.getHeight()))
        except Exception:
            return (0, 0, 0, 0)

    def _unclip(self, view):
        p = view.getParent()
        n = 0
        while p is not None and n < 14:
            if isinstance(p, ViewGroup):
                try:
                    h = self._ident(p)
                    if h not in self._clipped:
                        self._clipped[h] = (p, bool(p.getClipChildren()), bool(p.getClipToPadding()))
                        p.setClipChildren(False)
                        p.setClipToPadding(False)
                except Exception:
                    pass
            try:
                p = p.getParent()
            except Exception:
                break
            n += 1

    def _reclip(self):
        for p, cc, cp in list(self._clipped.values()):
            try:
                p.setClipChildren(cc)
                p.setClipToPadding(cp)
            except Exception:
                pass
        self._clipped.clear()

    def _walk(self, view, depth, want_cls):
        if depth > 16:
            return None
        if want_cls is None:
            if "ProfileGiftsContainer" in self._cname(view):
                return view
        elif isinstance(view, want_cls):
            return view
        if isinstance(view, ViewGroup):
            for i in range(int(view.getChildCount())):
                r = self._walk(view.getChildAt(i), depth + 1, want_cls)
                if r is not None:
                    return r
        return None

    def _locate(self):
        frag = get_last_fragment()
        if frag is None:
            return None
        name = self._cname(frag)
        if not any(k in name for k in ("Profile", "Gift", "Stars")):
            return None
        root = frag.getFragmentView()
        if root is None:
            return None
        container = self._walk(root, 0, None)
        if container is None:
            return None
        lst = self._walk(container, 0, RecyclerView)
        if lst is None:
            return None
        return container, lst

    def _geometry(self, lst, ad, pid):
        n = int(ad.getItemCount())
        gpos = []
        objs = []
        has_get = hasattr(ad, "getItem")
        if has_get:
            for i in range(n):
                try:
                    it = ad.getItem(i)
                    obj = getattr(it, "object", None) if it is not None else None
                    if obj is not None and "StarGift" in self._cname(obj):
                        gpos.append(i)
                        objs.append(obj)
                except Exception:
                    self._err()
        if objs and self._fill_calls == 0 and len(self._seen.get(pid, [])) != len(objs):
            metas = [self._meta(o, i) for i, o in enumerate(objs)]
            self._seen[pid] = metas
            self._shown[pid] = [m["key"] for m in metas]
        if not gpos:
            h = self._ident(lst)
            vis = []
            for i in range(int(lst.getChildCount())):
                ch = lst.getChildAt(i)
                if "Gift" in self._cname(ch):
                    p = int(lst.getChildAdapterPosition(ch))
                    if p >= 0:
                        vis.append(p)
            if vis:
                m = min(self._minpos.get(h, 10 ** 9), min(vis))
                self._minpos[h] = m
                gpos = list(range(m, n))
        return gpos, {p: i for i, p in enumerate(gpos)}

    def _neutral(self, cfg):
        return (cfg["scale"] == 100 and cfg["gapx"] == 0 and cfg["gapy"] == 0 and cfg["tilt"] == 0
                and cfg["alpha"] == 100 and not cfg["stagger"] and not cfg["mirror"] and not cfg["snake"]
                and not cfg["brick"] and cfg["wave"] == 0 and cfg["fan"] == 0 and cfg["float_amp"] == 0
                and not cfg["tiles"] and cfg["pin_scale"] == 100 and cfg["uniq_scale"] == 100
                and cfg["price_grow"] == 0 and not cfg["fly"])

    def _ovr_load(self, pid):
        raw = self.get_setting("gift_over", "{}")
        sig = (raw, pid)
        if sig != self._ovr_raw:
            self._ovr_raw = sig
            try:
                v = json.loads(raw or "{}").get(str(pid), {})
                self._ovr_cache = v if isinstance(v, dict) else {}
            except Exception:
                self._ovr_cache = {}
        return self._ovr_cache

    def _ovr_get(self, pid, key):
        v = self._jget("gift_over").get(str(pid), {}).get(key, {})
        return v if isinstance(v, dict) else {}

    def _ovr_set(self, pid, key, field, value):
        d = self._jget("gift_over")
        p = d.setdefault(str(pid), {})
        g = p.setdefault(key, {})
        if value == OVR_DEF[field]:
            g.pop(field, None)
        else:
            g[field] = value
        if not g:
            p.pop(key, None)
        self._jset("gift_over", d)
        self._ovr_raw = None
        self._apply_now()

    def _ovr_clear(self, pid, key=None):
        d = self._jget("gift_over")
        if key is None:
            d.pop(str(pid), None)
        else:
            d.get(str(pid), {}).pop(key, None)
        self._jset("gift_over", d)
        self._ovr_raw = None
        self._apply_now()

    def _scan_and_apply(self):
        if not self._running:
            return
        if not self.get_setting("enabled", True):
            self._restore_all()
            return
        self._motion_ok = not self._saver()
        found = self._locate()
        if not found:
            self._cur = None
            self._geo = None
            return
        container, lst = found
        pid = self._pid_from(container)
        self._cur = (container, lst)
        self._pid = pid
        off = self._bypass or not self._applies(pid)
        cfg = dict(DEFAULTS) if off else self._cfg(pid)
        self._cfg_cache = cfg
        self._ovr_load(pid)
        self._ovr_use = {} if off else self._ovr_cache
        ad = lst.getAdapter()
        if ad is None:
            return
        h = self._ident(lst)
        if h not in self._listened:
            self._listened.add(h)
            try:
                lst.addOnChildAttachStateChangeListener(_Attach(self))
                lst.addOnItemTouchListener(_Touch(self))
                lst.setClipChildren(False)
                lst.setClipToPadding(False)
                container.setClipChildren(False)
            except Exception:
                self._err()
        gpos, rank = self._geometry(lst, ad, pid)
        ms = self._seen.get(pid)
        if ms is not self._mk_src:
            self._mk_src = ms
            self._mk = {m["key"]: m for m in (ms or [])}
            self._maxstars = max([m["stars"] for m in (ms or [])] or [0])
        lm = lst.getLayoutManager()
        k = self._apply_cols(lst, lm, cfg, gpos, h)
        self._geo = {"h": h, "rank": rank, "k": k, "count": len(gpos), "keys": {}}
        if cfg["fly"]:
            self._geo["win"] = self._win(lst)
            if cfg["fly_area"] == 1:
                self._unclip(lst)
        if not (cfg["fly"] and cfg["fly_area"] == 1) and self._clipped:
            self._reclip()
        neutral = self._neutral(cfg) and not self._ovr_use
        if neutral and not self._styled.get(h):
            return
        self._styled[h] = not neutral
        now = time.time()
        for i in range(int(lst.getChildCount())):
            self._style_child(lst, lst.getChildAt(i), cfg, self._geo, False, now)

    # columns
    def _apply_cols(self, lst, lm, cfg, gpos, h):
        # The grid may use a span count larger than the visible column count (one item spans
        # `s` of `span` units), so the target is s * columns, not just the column count.
        # If any item would exceed the new span count, the change is rolled back.
        if not isinstance(lm, GridLayoutManager):
            self._span_note = "layout manager is not a grid: " + self._cname(lm)
            return 3
        st = self._orig.get(h)
        if st is None:
            if not gpos:
                return max(1, int(lm.getSpanCount()))
            st = {"span": int(lm.getSpanCount()), "s": 1, "bad": False}
            try:
                lk = lm.getSpanSizeLookup()
                vals = [int(lk.getSpanSize(p)) for p in gpos[:12]]
                if vals:
                    st["s"] = max(1, min(vals))
            except Exception:
                self._err()
            self._orig[h] = st
        want = cfg["cols"]
        target = st["span"] if want == 0 else st["s"] * want
        cur = int(lm.getSpanCount())
        if cur != target and not st["bad"]:
            lm.setSpanCount(target)
            try:
                lk = lm.getSpanSizeLookup()
                ad = lst.getAdapter()
                for i in range(int(ad.getItemCount())):
                    if int(lk.getSpanSize(i)) > target:
                        raise ValueError("item span exceeds span count at %d" % i)
                self._span_note = "ok"
            except Exception as e:
                lm.setSpanCount(cur)
                st["bad"] = True
                self._span_note = "columns override rejected: " + str(e)
        return max(1, int(lm.getSpanCount()) // st["s"])

    # child styling
    def _tile(self, cfg, tint_idx):
        tint = _argb(TINT_HEX[tint_idx % len(TINT_HEX)])
        a = int(cfg["tile_alpha"] * 2.55)
        gd = GradientDrawable(GradOrient.TOP_BOTTOM,
                              jarray(jint)([_with_alpha(tint, min(255, a + 36)), _with_alpha(tint, max(8, a // 2))]))
        gd.setCornerRadius(float(self._dp(cfg["tile_radius"])))
        gd.setStroke(max(1, self._dp(1)), _with_alpha(WHITE, min(255, a + 70)))
        return gd

    def _reset_child(self, ch):
        ch.setScaleX(1.0)
        ch.setScaleY(1.0)
        ch.setAlpha(1.0)
        ch.setRotation(0.0)
        ch.setTranslationX(0.0)
        ch.setTranslationY(0.0)
        ch.setTranslationZ(0.0)
        hid = self._ident(ch)
        if hid in self._bg_orig:
            ch.setBackground(self._bg_orig.pop(hid))
            self._tile_sig.pop(hid, None)

    def _fly_applies(self, cfg, meta):
        m = cfg["fly_only"]
        if m == 0:
            return True
        if meta is None:
            return False
        return bool(meta["unique"]) if m == 1 else not meta["unique"]

    def _rnd(self, seed, i):
        x = (seed * 1103515245 + i * 12345 + 12345) & 0x7FFFFFFF
        x = ((x ^ (x >> 13)) * 1274126177) & 0x7FFFFFFF
        return (x % 10000) / 10000.0

    def _fly(self, lst, ch, cfg, geo, key, rank):
        w = ch.getWidth()
        h = ch.getHeight()
        if w <= 0 or h <= 0:
            return None
        seed = (zlib.crc32(key.encode("utf-8")) if key else rank * 7919) ^ (cfg["fly_seed"] * 7919)
        c = self._fly_clock
        tau = 6.2831853

        def r(i):
            return self._rnd(seed, i)
        u = 0.5 + 0.5 * (0.62 * math.sin(c * (0.11 + 0.08 * r(1)) + tau * r(5))
                         + 0.38 * math.sin(c * (0.23 + 0.13 * r(2)) + tau * r(6)))
        v = 0.5 + 0.5 * (0.62 * math.sin(c * (0.09 + 0.08 * r(3)) + tau * r(7))
                         + 0.38 * math.sin(c * (0.19 + 0.14 * r(4)) + tau * r(8)))
        if cfg["fly_area"] == 0:
            tx = u * max(0, lst.getWidth() - w) - ch.getLeft()
            ty = v * max(0, lst.getHeight() - h) - ch.getTop()
        else:
            lx, ly, rw, rh = geo.get("win", (0, 0, 0, 0))
            if rw <= 0 or rh <= 0:
                return None
            tx = u * max(0, rw - w) - (lx + ch.getLeft())
            ty = v * max(0, rh - h) - (ly + ch.getTop())
        amp = cfg["fly_size"] / 100.0
        fm = 1.0 + amp * (0.55 * math.sin(c * (0.17 + 0.12 * r(9)) + tau * r(10))
                          + 0.45 * math.sin(c * (0.31 + 0.2 * r(11)) + tau * r(12)))
        fm = max(0.25, min(4.0, fm))
        rot = 0.0
        if cfg["fly_spin"]:
            rot = (c * cfg["fly_spin"] * 18.0 * (1.0 if r(13) > 0.5 else -1.0)) % 360.0
        return tx, ty, rot, fm

    def _key_for(self, lst, geo, pos):
        keys = geo["keys"]
        k = keys.get(pos)
        if k is None:
            k = ""
            try:
                it = lst.getAdapter().getItem(pos)
                obj = getattr(it, "object", None) if it is not None else None
                if obj is not None:
                    k = self._key_of(obj)
            except Exception:
                k = ""
            keys[pos] = k
        return k

    def _style_child(self, lst, ch, cfg, geo, animate, t=None):
        pos = int(lst.getChildAdapterPosition(ch))
        rank = geo["rank"].get(pos)
        if rank is None:
            if self._styled.get(geo["h"]):
                self._reset_child(ch)
            return
        hid = self._ident(ch)
        if not animate and time.time() - self._anim.get(hid, 0.0) < 0.45:
            return
        now = t if t is not None else time.time()
        d = self._d
        k = geo["k"]
        col = rank % k
        row = rank // k
        cw = ch.getWidth()
        center = (k - 1) / 2.0
        sc = cfg["scale"] / 100.0
        al = cfg["alpha"] / 100.0
        tx = (col - center) * cfg["gapx"] * d
        if cfg["mirror"] != (cfg["snake"] and row % 2 == 1):
            tx += (k - 1 - 2 * col) * cw
        if cfg["brick"] and row % 2 == 1:
            tx += cw * 0.5
        ty = row * cfg["gapy"] * d
        if cfg["stagger"] and col % 2 == 1:
            ty += ch.getHeight() * 0.28
        if cfg["wave"]:
            ty += math.sin(col * 1.15) * cfg["wave"] * d
        rot = 0.0
        if cfg["tilt"]:
            if cfg["tilt_mode"] == 0:
                rot = float(cfg["tilt"]) if rank % 2 == 0 else -float(cfg["tilt"])
            else:
                rot = (((rank * 7919 + 13) % 1000) / 500.0 - 1.0) * cfg["tilt"]
        if cfg["fan"]:
            rot += (col - center) * cfg["fan"]
        if cfg["float_amp"] > 0 and self._motion_ok:
            ph = now * (0.6 + cfg["float_speed"] * 0.35)
            ty += math.sin(ph + rank * 0.8) * cfg["float_amp"] * d
            rot += math.sin(ph * 0.7 + rank) * cfg["float_amp"] * 0.15
        key = self._key_for(lst, geo, pos)
        meta = self._mk.get(key) if key else None
        ms = 1.0
        if meta:
            if meta["pinned"]:
                ms *= cfg["pin_scale"] / 100.0
            if meta["unique"]:
                ms *= cfg["uniq_scale"] / 100.0
            if cfg["price_grow"] and self._maxstars > 0 and meta["stars"] > 0:
                ms *= 1.0 + cfg["price_grow"] / 100.0 * meta["stars"] / float(self._maxstars)
        sx = sc * ms
        sy = sc * ms
        z = 0
        if cfg["fly"] and self._motion_ok and self._fly_applies(cfg, meta):
            fx = self._fly(lst, ch, cfg, geo, key, rank)
            if fx:
                tx, ty, frot, fm = fx
                rot += frot
                sx *= fm
                sy *= fm
                z = 4
        ov = self._ovr_use.get(key) if key else None
        if ov:
            o = ov.get("s", 100) / 100.0
            sx *= o * ov.get("w", 100) / 100.0
            sy *= o * ov.get("h", 100) / 100.0
            al *= ov.get("a", 100) / 100.0
            tx += ov.get("x", 0) * d
            ty += ov.get("y", 0) * d
            rot += ov.get("r", 0)
            if ov.get("f"):
                z = 3
        if max(sx, sy) > 1.02:
            z = max(z, 2)
        al = max(0.0, min(1.0, al))
        ch.setRotation(float(rot))
        ch.setTranslationX(float(tx))
        ch.setTranslationY(float(ty))
        ch.setTranslationZ(float(z * d))
        if cfg["tiles"]:
            tint = cfg["tile_tint"]
            if cfg["tint_type"] and meta and meta["unique"]:
                tint = (tint + 2) % len(TINT_HEX)
            sig = (tint, cfg["tile_alpha"], cfg["tile_radius"])
            if self._tile_sig.get(hid) != sig:
                if hid not in self._bg_orig:
                    self._bg_orig[hid] = ch.getBackground()
                ch.setBackground(self._tile(cfg, tint))
                self._tile_sig[hid] = sig
        elif hid in self._bg_orig:
            ch.setBackground(self._bg_orig.pop(hid))
            self._tile_sig.pop(hid, None)
        if animate:
            self._anim[hid] = time.time() + 0.3
            ch.setScaleX(float(sx * 0.55))
            ch.setScaleY(float(sy * 0.55))
            ch.setAlpha(0.0)
            ch.animate().scaleX(float(sx)).scaleY(float(sy)).alpha(float(al)) \
                .setStartDelay(int(min(rank, 12) * 25)).setDuration(300) \
                .setInterpolator(self._overshoot).start()
        else:
            ch.setScaleX(float(sx))
            ch.setScaleY(float(sy))
            ch.setAlpha(float(al))

    def _pick_touch(self, rv, e, handle):
        if not self._pick or not self._geo:
            return False
        act = int(e.getActionMasked())
        if not handle:
            return act == 0
        if act == 1:
            self._pick = False
            child = rv.findChildViewUnder(float(e.getX()), float(e.getY()))
            if child is not None:
                pos = int(rv.getChildAdapterPosition(child))
                if pos in self._geo["rank"]:
                    key = self._key_for(rv, self._geo, pos)
                    title = (self._mk.get(key) or {}).get("label", "")
                    if key:
                        run_on_ui_thread(lambda: self._open_gift_editor(key, title))
                        return True
            BulletinHelper.show_info(self._t("No gift under your finger", "Здесь нет подарка"))
        elif act == 3:
            self._pick = False
        return True

    def _open_gift_editor(self, key, title):
        frag = get_last_fragment()
        act = frag.getParentActivity() if frag is not None else None
        if act is None:
            return
        self._d = float(act.getResources().getDisplayMetrics().density)
        self._gift_editor(act, key, title)

    def _on_attach(self, view):
        if not self._running or not self._cur or not self._geo:
            return
        cfg = self._cfg_cache
        animate = bool(cfg.get("pop")) and bool(self.get_setting("enabled", True))
        if self._neutral(cfg) and not self._ovr_use and not animate:
            return
        self._style_child(self._cur[1], view, cfg, self._geo, animate)

    def _restore_all(self):
        cur = self._cur
        if not cur:
            return
        lst = cur[1]
        try:
            h = self._ident(lst)
            st = self._orig.get(h)
            lm = lst.getLayoutManager()
            if st and isinstance(lm, GridLayoutManager) and int(lm.getSpanCount()) != st["span"]:
                lm.setSpanCount(st["span"])
            for i in range(int(lst.getChildCount())):
                self._reset_child(lst.getChildAt(i))
            self._styled[h] = False
            self._reclip()
        except Exception:
            self._err()
        self._cur = None
        self._geo = None

    def _apply_now(self):
        try:
            self._scan_and_apply()
        except Exception:
            self._err()

    def _refresh_items(self):
        def go():
            cur = self._cur
            if not cur:
                return
            try:
                ad = cur[1].getAdapter()
                if hasattr(ad, "update"):
                    ad.update(False)
                else:
                    ad.notifyDataSetChanged()
            except Exception:
                self._err()
        run_on_ui_thread(go, 300)

    def _changed(self, *a):
        self._apply_now()
        self._refresh_items()

    # settings page
    def create_settings(self):
        t = self._t

        def names(arr):
            return [n[1 if self._ru else 0] for n in arr]

        def inp(key, en, ru):
            return Input(key=key, text=t(en, ru), default=str(DEFAULTS[key]), on_change=self._changed)

        def sw(key, en, ru):
            return Switch(key=key, text=t(en, ru), default=DEFAULTS[key], on_change=self._changed)

        cols = [t("Auto (native)", "Авто (как в Telegram)")] + [str(i) for i in range(1, 9)]
        return [
            Header(text=t("Gifts Studio", "Студия подарков")),
            Switch(key="enabled", text=t("Enable plugin", "Включить плагин"), default=True,
                   subtext=t("Works in the Gifts tab of profiles", "Работает во вкладке «Подарки» профилей"),
                   on_change=self._changed),
            Text(text=t("Open Studio", "Открыть студию"), on_click=lambda *a: self.open_studio()),
            Text(text=t("Edit size of single gifts", "Размер отдельных подарков"), on_click=lambda *a: self._open_tab(5)),
            Divider(text=t("Open a profile with gifts first, then pick Gifts Studio in the profile or side menu for a live preview",
                           "Сначала откройте профиль с подарками, затем выберите «Студию подарков» в меню профиля или боковом меню")),
            Header(text=t("Layout", "Сетка")),
            Selector(key="cols", text=t("Gifts per row", "Подарков в ряду"), default=0, items=cols, on_change=self._changed),
            inp("scale", "Gift size, % (30-220)", "Размер подарка, % (30-220)"),
            inp("gapx", "Horizontal spacing, dp", "Отступ по горизонтали, dp"),
            inp("gapy", "Vertical spacing, dp", "Отступ по вертикали, dp"),
            inp("tilt", "Tilt, degrees (0-25)", "Наклон, градусы (0-25)"),
            Selector(key="tilt_mode", text=t("Tilt style", "Стиль наклона"), default=0, items=names(TILT_NAMES),
                     on_change=self._changed),
            inp("alpha", "Opacity, % (30-100)", "Прозрачность, % (30-100)"),
            sw("stagger", "Honeycomb stagger", "Сотовый сдвиг"),
            sw("mirror", "Mirror rows", "Зеркальные ряды"),
            sw("snake", "Snake order", "Змейка"),
            sw("brick", "Brick offset", "Кирпичный сдвиг"),
            inp("wave", "Wave, dp (0-40)", "Волна, dp (0-40)"),
            inp("fan", "Fan angle per column (0-15)", "Веер, градусов на колонку (0-15)"),
            inp("pin_scale", "Pinned gifts size, % (50-300)", "Размер закреплённых, % (50-300)"),
            inp("uniq_scale", "Unique gifts size, % (50-300)", "Размер уникальных, % (50-300)"),
            inp("price_grow", "Grow with price, % (0-100)", "Рост размера с ценой, % (0-100)"),
            Header(text=t("Motion", "Движение")),
            sw("pop", "Pop-in animation", "Анимация появления"),
            inp("float_amp", "Levitation amplitude, dp (0 = off)", "Левитация, dp (0 = выкл)"),
            inp("float_speed", "Levitation speed (1-10)", "Скорость левитации (1-10)"),
            Switch(key="battery_aware", text=t("Pause motion in battery saver", "Останавливать анимации в режиме экономии"),
                   default=True, on_change=self._changed),
            Header(text=t("Flight", "Полёт")),
            sw("fly", "Flying gifts", "Летающие подарки"),
            inp("fly_speed", "Flight speed, x (1-50)", "Скорость полёта, x (1-50)"),
            inp("fly_size", "Random size change, % (0-100)", "Случайное изменение размера, % (0-100)"),
            inp("fly_spin", "Spin (0-10)", "Вращение (0-10)"),
            Selector(key="fly_only", text=t("Who flies", "Кто летает"), default=1, items=names(FLY_ONLY_NAMES),
                     on_change=self._changed),
            Selector(key="fly_area", text=t("Flight area", "Область полёта"), default=0, items=names(FLY_AREA_NAMES),
                     on_change=self._changed),
            inp("fly_seed", "Flight pattern seed", "Зерно рисунка полёта"),
            Header(text=t("Glass", "Стекло")),
            sw("tiles", "Glass tiles behind gifts", "Стеклянные плитки под подарками"),
            inp("tile_radius", "Tile corner radius, dp", "Скругление плитки, dp"),
            inp("tile_alpha", "Tile glass strength, % (4-60)", "Плотность стекла, % (4-60)"),
            Selector(key="tile_tint", text=t("Tile tint", "Оттенок плитки"), default=0, items=names(TINTS),
                     on_change=self._changed),
            sw("tint_type", "Tint unique gifts differently", "Уникальные другим цветом"),
            Selector(key="accent", text=t("Studio accent", "Акцент студии"), default=0,
                     items=[a[1 if self._ru else 0] for a in ACCENTS]),
            Switch(key="fx_anim", text=t("Animated glass in Studio (shimmer, bubbles)", "Анимированное стекло в студии (блик, пузыри)"),
                   default=True),
            Header(text=t("Order", "Порядок")),
            Selector(key="sort", text=t("Sort", "Сортировка"), default=0, items=names(SORT_NAMES), on_change=self._changed),
            sw("reverse", "Reverse order", "Обратный порядок"),
            sw("pinned_first", "Pinned gifts first", "Закреплённые первыми"),
            inp("limit", "Max gifts shown (0 = all)", "Максимум подарков (0 = все)"),
            inp("seed", "Shuffle seed", "Зерно перемешивания"),
            sw("peek_hidden", "Show gifts I hid", "Показать скрытые мной"),
            Header(text=t("Filters", "Фильтры")),
            Selector(key="filter", text=t("Show", "Показывать"), default=0, items=names(FILTER_NAMES), on_change=self._changed),
            inp("query", "Search by name", "Поиск по названию"),
            inp("minstars", "Min price, stars (regular gifts)", "Мин. цена, звёзды (обычные)"),
            inp("maxstars", "Max price, stars (regular gifts)", "Макс. цена, звёзды (обычные)"),
            sw("only_msg", "Only gifts with a comment", "Только с комментарием"),
            sw("hide_anon", "Hide anonymous senders' gifts", "Скрыть подарки анонимов"),
            Header(text=t("Scope", "Область применения")),
            Selector(key="apply_to", text=t("Apply to", "Применять к"), default=0,
                     items=[t("All profiles", "Всем профилям"), t("Other people only", "Только чужим"),
                            t("My profile only", "Только моему")], on_change=self._changed),
            Selector(key="scope", text=t("Layout memory", "Память раскладки"), default=0,
                     items=[t("One layout for everyone", "Одна для всех"),
                            t("Separate per profile", "Отдельная для каждого профиля")], on_change=self._changed),
            Switch(key="haptics", text=t("Haptic feedback in Studio", "Вибро-отклик в студии"), default=True),
            Header(text=t("Tools", "Инструменты")),
            Text(text=t("Diagnostics", "Диагностика"), on_click=lambda *a: self.show_diagnostics()),
            Text(text=t("Reset single-gift edits", "Сбросить правки отдельных подарков"),
                 on_click=lambda *a: (self._jset("gift_over", {}), self._ovr_clear(self._pid))),
            Text(text=t("Reset everything", "Сбросить всё"), on_click=lambda *a: self.reset_all()),
        ]

    def reset_all(self):
        for k, d in DEFAULTS.items():
            self.set_setting(k, str(d) if k in INPUT_KEYS else d)
        for name in ("profiles", "hidden", "manual", "slots", "gift_over"):
            self._jset(name, {})
        self._changed()
        BulletinHelper.show_info(self._t("Everything reset", "Всё сброшено"))

    # studio helpers
    def _dp(self, x):
        return int(x * self._d + 0.5)

    def _txt(self, ctx, text, size, color, bold=False):
        tv = TextView(ctx)
        tv.setText(text)
        tv.setTextSize(2, float(size))
        tv.setTextColor(color)
        if bold:
            tv.setTypeface(Typeface.DEFAULT_BOLD)
        return tv

    def _glass(self, radius=16, top=0x34, bot=0x10, stroke=0x48):
        gd = GradientDrawable(GradOrient.TOP_BOTTOM,
                              jarray(jint)([_with_alpha(WHITE, top), _with_alpha(WHITE, bot)]))
        gd.setCornerRadius(float(self._dp(radius)))
        gd.setStroke(max(1, self._dp(1)), _with_alpha(WHITE, stroke))
        return gd

    def _accent_glass(self, accent, radius=14):
        gd = GradientDrawable(GradOrient.TOP_BOTTOM,
                              jarray(jint)([_with_alpha(accent, 0xF2), _with_alpha(accent, 0x95)]))
        gd.setCornerRadius(float(self._dp(radius)))
        gd.setStroke(max(1, self._dp(1)), _with_alpha(WHITE, 0x78))
        return gd

    def _lp(self, w=-1, h=-2, weight=None, margins=(0, 0, 0, 0)):
        lp = LP(w, h, float(weight)) if weight is not None else LP(w, h)
        lp.setMargins(self._dp(margins[0]), self._dp(margins[1]), self._dp(margins[2]), self._dp(margins[3]))
        return lp

    def _haptic(self, view):
        if self.get_setting("haptics", True):
            try:
                view.performHapticFeedback(3)
            except Exception:
                pass

    def _animate(self, view, prop, vals, dur, store, mode=2, linear=False):
        if store is None:
            return
        a = ObjectAnimator.ofFloat(view, prop, jarray(jfloat)([float(x) for x in vals]))
        a.setDuration(dur)
        a.setRepeatCount(-1)
        a.setRepeatMode(mode)
        a.setInterpolator(jclass("android.view.animation.LinearInterpolator" if linear
                                 else "android.view.animation.AccelerateDecelerateInterpolator")())
        a.start()
        store.append(a)

    def _bubble_layer(self, act, layer, width, height, accent, store):
        dp = self._dp
        for size, fx, fy, color, dx, dy, dur in (
                (230, -0.18, -0.10, accent, 70, 50, 9000), (260, 0.55, 0.62, _argb("#FF6FB5"), -60, -70, 11000),
                (170, 0.62, -0.08, _argb("#35D0FF"), -40, 60, 10000)):
            blob = View(act)
            gd = GradientDrawable()
            gd.setShape(1)
            gd.setGradientType(1)
            gd.setGradientRadius(float(dp(size) * 0.5))
            gd.setColors(jarray(jint)([_with_alpha(color, 0x70), _with_alpha(color, 0x00)]))
            blob.setBackground(gd)
            lp = FLP(dp(size), dp(size))
            lp.setMargins(int(width * fx), int(height * fy), 0, 0)
            layer.addView(blob, lp)
            self._animate(blob, "translationX", [0, dp(dx)], dur, store)
            self._animate(blob, "translationY", [0, dp(dy)], dur + 1700, store)
        for size, fx, fy, dur, rise in ((26, 0.08, 0.80, 5200, 60), (18, 0.78, 0.70, 4300, 74),
                                        (12, 0.30, 0.92, 3600, 50), (34, 0.62, 0.45, 6400, 66),
                                        (14, 0.90, 0.18, 3900, 40), (20, 0.14, 0.32, 5000, 52),
                                        (10, 0.46, 0.66, 3300, 44)):
            b = View(act)
            gd = GradientDrawable()
            gd.setShape(1)
            gd.setGradientType(1)
            gd.setGradientRadius(float(dp(size) * 0.65))
            gd.setGradientCenter(0.35, 0.3)
            gd.setColors(jarray(jint)([_with_alpha(WHITE, 0x90), _with_alpha(WHITE, 0x26), _with_alpha(WHITE, 0x08)]))
            gd.setStroke(max(1, dp(1)), _with_alpha(WHITE, 0x70))
            b.setBackground(gd)
            lp = FLP(dp(size), dp(size))
            lp.setMargins(int(width * fx), int(height * fy), 0, 0)
            layer.addView(b, lp)
            self._animate(b, "translationY", [0, -dp(rise)], dur, store)
            self._animate(b, "translationX", [0, dp(12)], dur + 900, store)
            self._animate(b, "alpha", [0.35, 0.95], dur - 700, store)

    def _open_tab(self, i):
        self._tab = i
        self.open_studio()

    def open_studio(self, *a):
        self._bypass = False
        run_on_ui_thread(self._open_studio_ui)

    def _open_studio_ui(self):
        try:
            self._studio()
        except Exception:
            self._err()
            BulletinHelper.show_info(self._t("Studio failed to open, see Diagnostics", "Студия не открылась, см. Диагностику"))

    # studio
    def _stats(self, pid):
        ms = self._seen.get(pid) or []
        hidden = set(self._jget("hidden").get(str(pid), []))
        return {
            "count": len(ms), "unique": sum(1 for m in ms if m["unique"]),
            "total": sum(m["stars"] for m in ms), "types": len({m["gid"] for m in ms}),
            "pinned": sum(1 for m in ms if m["pinned"]), "hidden": sum(1 for m in ms if m["key"] in hidden),
            "top": max(ms, key=lambda m: m["stars"], default=None),
            "rare": min((m for m in ms if m["total"] > 0), key=lambda m: m["total"], default=None),
        }

    def _studio(self):
        t = self._t
        frag = get_last_fragment()
        act = frag.getParentActivity() if frag is not None else None
        if act is None:
            return
        dm = act.getResources().getDisplayMetrics()
        self._d = float(dm.density)
        dp = self._dp
        pid = self._pid
        accent = self._accent()
        sw_px = int(dm.widthPixels * 0.84)
        sh_px = int(dm.heightPixels * 0.70)
        anims = []
        motion = bool(self.get_setting("fx_anim", True)) and not self._saver(act)

        frame = FrameLayout(act)
        frame.setBackground(_dark_background(dp(18)))
        layer = FrameLayout(act)
        frame.addView(layer, FLP(-1, -1))
        self._bubble_layer(act, layer, sw_px, sh_px, accent, anims if motion else None)
        if not motion:
            for i in range(int(layer.getChildCount())):
                layer.getChildAt(i).setAlpha(0.6)
        frame.addOnAttachStateChangeListener(_Detach(anims))
        scroll = ScrollView(act)
        scroll.setVerticalScrollBarEnabled(False)
        frame.addView(scroll, FLP(-1, sh_px))
        content = LinearLayout(act)
        content.setOrientation(1)
        content.setPadding(dp(14), dp(12), dp(14), dp(14))
        scroll.addView(content)
        sub_ref = {}

        def sub_text():
            c = self._cfg(pid)
            geo = self._geo
            if geo:
                per = c["cols"] if c["cols"] else geo["k"]
                return t("%d gifts  \u00b7  %d per row  \u00b7  %d%%", "%d подарков  \u00b7  %d в ряду  \u00b7  %d%%") % (
                    geo["count"], per, c["scale"])
            return t("Open a profile Gifts tab for live preview", "Откройте вкладку «Подарки» для предпросмотра")

        def style_chip(tv, active):
            tv.setBackground(self._accent_glass(accent) if active else self._glass(14, 0x2C, 0x0C, 0x40))
            tv.setTextColor(WHITE)

        def chip(text, active, fn, weight=1.0, margins=(0, 0, 8, 8)):
            tv = TextView(act)
            tv.setText(text)
            tv.setTextSize(2, 13.0)
            tv.setGravity(17)
            tv.setTypeface(Typeface.DEFAULT_BOLD)
            tv.setPadding(dp(12), dp(10), dp(12), dp(10))
            style_chip(tv, active)
            tv.setOnClickListener(_Click(lambda: (self._haptic(tv), fn(tv))))
            tv.setLayoutParams(self._lp(0 if weight else -2, -2, weight, margins))
            return tv

        def hrow():
            r = LinearLayout(act)
            r.setOrientation(0)
            return r

        def label(text):
            tv = self._txt(act, text.upper(), 11, _with_alpha(WHITE, 0xB8), True)
            tv.setLetterSpacing(0.08)
            tv.setLayoutParams(self._lp(-1, -2, None, (2, 14, 0, 6)))
            return tv

        def fmt(key, v):
            if key == "cols":
                return t("Auto", "Авто") if v == 0 else str(v)
            if key in ("scale", "alpha", "tile_alpha", "pin_scale", "uniq_scale", "price_grow", "fly_size"):
                return "%d%%" % v
            if key in ("tilt", "fan"):
                return "%d\u00b0" % v
            if key in ("float_speed", "fly_speed", "fly_spin"):
                return "x%d" % v
            return "%d dp" % v

        def slider(key, title, lo, hi):
            cur = self._cfg(pid)[key]
            box = LinearLayout(act)
            box.setOrientation(1)
            box.setPadding(dp(14), dp(10), dp(14), dp(6))
            box.setBackground(self._glass(16, 0x22, 0x0A, 0x38))
            box.setLayoutParams(self._lp(-1, -2, None, (0, 0, 0, 8)))
            top = hrow()
            name = self._txt(act, title, 14, WHITE, True)
            name.setLayoutParams(self._lp(0, -2, 1.0))
            val = self._txt(act, fmt(key, cur), 14, _with_alpha(WHITE, 0xD0), True)
            top.addView(name)
            top.addView(val)
            sb = SeekBar(act)
            sb.setMax(hi - lo)
            sb.setProgress(max(0, min(hi, cur) - lo))
            try:
                sb.setProgressTintList(ColorStateList.valueOf(accent))
                sb.setThumbTintList(ColorStateList.valueOf(WHITE))
            except Exception:
                pass

            def on(p):
                v = p + lo
                self._put(key, v, pid)
                val.setText(fmt(key, v))
                self._apply_now()
                if "tv" in sub_ref:
                    sub_ref["tv"].setText(sub_text())
            sb.setOnSeekBarChangeListener(_Seek(on))
            box.addView(top)
            box.addView(sb)
            content.addView(box)

        def toggle(key, title):
            def click(tv):
                nv = not self._cfg(pid)[key]
                self._put(key, nv, pid)
                style_chip(tv, nv)
                self._changed()
            return chip(title, self._cfg(pid)[key], click)

        def gtoggle(key, title, refresh=False):
            def click(tv):
                nv = not bool(self.get_setting(key, True))
                self.set_setting(key, nv)
                style_chip(tv, nv)
                if refresh:
                    render()
            return chip(title, bool(self.get_setting(key, True)), click)

        def cycle(key, names, prefix, count, pretty=None):
            def text():
                idx = self._cfg(pid)[key]
                return prefix + (pretty(idx) if pretty else names[idx][1 if self._ru else 0])

            def click(tv):
                nv = (self._cfg(pid)[key] + 1) % count
                self._put(key, nv, pid)
                tv.setText(text())
                self._changed()
            c = chip(text(), False, click)
            c.setBackground(self._glass(14, 0x3A, 0x18, 0x58))
            return c

        def step_chip(key, steps, prefix):
            def text():
                v = self._cfg(pid)[key]
                return prefix + (str(v) if v else t("off", "выкл"))

            def click(tv):
                cur = self._cfg(pid)[key]
                nv = steps[(steps.index(cur) + 1) % len(steps)] if cur in steps else steps[0]
                self._put(key, nv, pid)
                tv.setText(text())
                self._changed()
            c = chip(text(), False, click)
            c.setBackground(self._glass(14, 0x3A, 0x18, 0x58))
            return c

        def add_row(*views):
            r = hrow()
            for v in views:
                r.addView(v)
            content.addView(r)

        def snap():
            c = self._cfg(pid)
            return {k: c[k] for k in LAYOUT_KEYS}

        def apply_cfg(data, record=True):
            if record:
                self._undo.append(snap())
                del self._undo[:-15]
            for k, v in data.items():
                if k in DEFAULTS:
                    self._put(k, v, pid)
            self._changed()
            render()

        def layout_defaults():
            return {k: DEFAULTS[k] for k in LAYOUT_KEYS}

        def reset_keys(keys):
            if self._gi("scope", 0) == 1 and pid:
                prof = self._jget("profiles")
                ov = prof.get(str(pid), {})
                for k in keys:
                    ov.pop(k, None)
                prof[str(pid)] = ov
                self._jset("profiles", prof)
            else:
                for k in keys:
                    self.set_setting(k, str(DEFAULTS[k]) if k in INPUT_KEYS else DEFAULTS[k])

        def reset_order():
            reset_keys(ORDER_KEYS)
            for name in ("manual", "hidden"):
                d = self._jget(name)
                d.pop(str(pid), None)
                self._jset(name, d)
            self._changed()
            render()

        def clip_set(text, msg):
            cm = act.getSystemService("clipboard")
            cm.setPrimaryClip(jclass("android.content.ClipData").newPlainText("gifts", text))
            BulletinHelper.show_info(msg)

        def do_copy():
            data = {"v": 2, "cfg": self._cfg(pid), "manual": self._jget("manual").get(str(pid), []),
                    "hidden": self._jget("hidden").get(str(pid), []),
                    "over": self._jget("gift_over").get(str(pid), {})}
            clip_set(json.dumps(data), t("Layout copied", "Раскладка скопирована"))

        def do_paste():
            cm = act.getSystemService("clipboard")
            clip = cm.getPrimaryClip()
            raw = str(clip.getItemAt(0).coerceToText(act)) if clip is not None and clip.getItemCount() > 0 else ""
            try:
                data = json.loads(raw)
                cfg = data["cfg"]
            except Exception:
                BulletinHelper.show_info(t("Clipboard has no layout", "В буфере нет раскладки"))
                return
            for name in ("manual", "hidden"):
                if isinstance(data.get(name), list) and data[name]:
                    d = self._jget(name)
                    d[str(pid)] = data[name]
                    self._jset(name, d)
            if isinstance(data.get("over"), dict) and data["over"]:
                d = self._jget("gift_over")
                d[str(pid)] = data["over"]
                self._jset("gift_over", d)
                self._ovr_raw = None
            apply_cfg(cfg)
            BulletinHelper.show_info(t("Layout applied", "Раскладка применена"))

        def slot_save(n):
            slots = self._jget("slots")
            cfg = self._cfg(pid)
            slots[str(n)] = {k: cfg[k] for k in LAYOUT_KEYS}
            self._jset("slots", slots)
            BulletinHelper.show_info(t("Saved to slot %d", "Сохранено в слот %d") % n)

        def slot_load(n):
            data = self._jget("slots").get(str(n))
            if not data:
                BulletinHelper.show_info(t("Slot %d is empty", "Слот %d пуст") % n)
                return
            apply_cfg(data)

        def summary():
            s = self._stats(pid)
            line = t("Gifts: %d  |  unique: %d  |  value: \u2605 %d  |  types: %d",
                     "Подарков: %d  |  уникальных: %d  |  стоимость: \u2605 %d  |  видов: %d") % (
                s["count"], s["unique"], s["total"], s["types"])
            if s["top"]:
                line += "\n" + t("Most expensive: ", "Самый дорогой: ") + s["top"]["label"]
            if s["rare"]:
                line += "\n" + t("Rarest: ", "Самый редкий: ") + s["rare"]["label"]
            clip_set(line, t("Summary copied", "Итоги скопированы"))

        def bump_scale(step):
            apply_cfg({"scale": max(30, min(220, self._cfg(pid)["scale"] + step))})

        def do_undo():
            if not self._undo:
                BulletinHelper.show_info(t("Nothing to undo", "Нечего отменять"))
                return
            apply_cfg(self._undo.pop(), False)

        def toggle_bypass(tv):
            self._bypass = not self._bypass
            style_chip(tv, self._bypass)
            self._changed()

        def autofit():
            cur = self._cur
            geo = self._geo
            if not cur or not geo or not geo["count"]:
                BulletinHelper.show_info(t("Open the Gifts tab first", "Сначала откройте вкладку «Подарки»"))
                return
            lst = cur[1]
            n = geo["count"]
            w = float(lst.getWidth() - lst.getPaddingLeft() - lst.getPaddingRight())
            hgt = float(lst.getHeight())
            asp = 1.0
            for i in range(int(lst.getChildCount())):
                ch = lst.getChildAt(i)
                if ch.getWidth() > 0 and int(lst.getChildAdapterPosition(ch)) in geo["rank"]:
                    asp = ch.getHeight() / float(ch.getWidth())
                    break
            best = 8
            for c in range(1, 9):
                if math.ceil(n / float(c)) * (w / c) * asp <= hgt:
                    best = c
                    break
            apply_cfg({"cols": best, "scale": 100})
            BulletinHelper.show_info(t("%d per row", "%d в ряду") % best)

        def small_btn(text, fn):
            tv = TextView(act)
            tv.setText(text)
            tv.setTextSize(2, 15.0)
            tv.setGravity(17)
            tv.setTextColor(WHITE)
            tv.setBackground(self._accent_glass(accent, 12))
            tv.setOnClickListener(_Click(lambda: (self._haptic(tv), fn())))
            tv.setLayoutParams(self._lp(dp(36), dp(36), None, (4, 0, 0, 0)))
            return tv

        def start_pick():
            if not self._geo:
                BulletinHelper.show_info(t("Open the Gifts tab first", "Сначала откройте вкладку «Подарки»"))
                return
            self._pick = True
            try:
                self._studio_dialog.dismiss()
            except Exception:
                pass
            BulletinHelper.show_info(t("Tap the gift you want to edit", "Нажмите на подарок, который хотите изменить"))

        def gift_row(k, m, n):
            ov = self._ovr_get(pid, k)
            row = hrow()
            row.setGravity(16)
            row.setPadding(dp(12), dp(6), dp(8), dp(6))
            row.setBackground(self._glass(14, 0x2A, 0x0C, 0x30))
            row.setLayoutParams(self._lp(-1, -2, None, (0, 0, 0, 6)))
            dt = ""
            if m["date"] > 0:
                try:
                    dt = "  \u00b7  " + time.strftime("%d.%m.%y", time.localtime(m["date"]))
                except Exception:
                    dt = ""
            name = self._txt(act, "%d. %s%s" % (n, m["label"], dt), 13, WHITE, True)
            name.setLayoutParams(self._lp(0, -2, 1.0))
            pct = self._txt(act, "%d%%" % ov.get("s", 100), 13, _with_alpha(WHITE, 0xD0), True)
            pct.setPadding(dp(8), 0, dp(8), 0)

            def bump(step):
                cur = self._ovr_get(pid, k).get("s", 100)
                nv = max(20, min(400, cur + step))
                self._ovr_set(pid, k, "s", nv)
                pct.setText("%d%%" % nv)
            row.addView(name)
            row.addView(small_btn("\u2212", lambda: bump(-10)))
            row.addView(pct)
            row.addView(small_btn("+", lambda: bump(10)))
            row.addView(small_btn("\u270E", lambda: self._gift_editor(act, k, m["label"])))
            return row

        def clear_over():
            self._ovr_clear(pid)
            render()

        def sec_gifts():
            seen = self._seen.get(pid) or []
            if not seen:
                content.addView(label(t("Open the Gifts tab of a profile first", "Сначала откройте вкладку «Подарки» профиля")))
                return
            content.addView(label(t("Tip: press Pick, then tap a gift on the profile", "Совет: нажмите «Выбрать» и коснитесь подарка на профиле")))
            meta = {m["key"]: m for m in seen}
            keys = [k for k in self._shown.get(pid, []) if k in meta] or [m["key"] for m in seen]
            content.addView(label(t("Size of each gift", "Размер каждого подарка")))
            add_row(chip(t("Pick on profile", "Выбрать на профиле"), True, lambda tv: start_pick()),
                    chip(t("Reset all edits", "Сбросить все правки"), False, lambda tv: clear_over()))
            for n, k in enumerate(keys[:80]):
                content.addView(gift_row(k, meta[k], n + 1))
            if len(keys) > 80:
                content.addView(self._txt(act, "\u2026", 13, WHITE))

        # ---- sections
        def sec_layout():
            content.addView(label(t("Presets", "Пресеты")))
            hs = HScroll(act)
            hs.setHorizontalScrollBarEnabled(False)
            prow = hrow()
            for en, ru, data in PRESETS:
                full = layout_defaults()
                full.update(data)
                prow.addView(chip(ru if self._ru else en, False, (lambda tv, d=full: apply_cfg(d)), None))
            hs.addView(prow)
            content.addView(hs)
            content.addView(label(t("Grid", "Сетка")))
            slider("cols", t("Gifts per row", "Подарков в ряду"), 0, 8)
            slider("scale", t("Gift size", "Размер подарка"), 30, 220)
            slider("gapx", t("Horizontal spacing", "Отступ по горизонтали"), 0, 60)
            slider("gapy", t("Vertical spacing", "Отступ по вертикали"), 0, 60)
            slider("alpha", t("Opacity", "Прозрачность"), 30, 100)
            content.addView(label(t("Shape", "Форма")))
            slider("tilt", t("Tilt", "Наклон"), 0, 25)
            slider("fan", t("Fan", "Веер"), 0, 15)
            slider("wave", t("Wave", "Волна"), 0, 40)
            add_row(cycle("tilt_mode", TILT_NAMES, t("Tilt: ", "Наклон: "), 2), toggle("stagger", t("Honeycomb", "Соты")))
            add_row(toggle("mirror", t("Mirror", "Зеркало")), toggle("snake", t("Snake", "Змейка")),
                    toggle("brick", t("Brick", "Кирпич")))
            content.addView(label(t("Smart size", "Умный размер")))
            slider("pin_scale", t("Pinned gifts size", "Размер закреплённых"), 50, 300)
            slider("uniq_scale", t("Unique gifts size", "Размер уникальных"), 50, 300)
            slider("price_grow", t("Grow with price", "Рост с ценой"), 0, 100)
            content.addView(label(t("Quick actions", "Быстрые действия")))
            add_row(chip(t("Size -10%", "Размер -10%"), False, lambda tv: bump_scale(-10)),
                    chip(t("Size +10%", "Размер +10%"), False, lambda tv: bump_scale(10)))
            add_row(chip(t("Auto-fit", "Вписать все"), False, lambda tv: autofit()))
            add_row(chip(t("Undo", "Отмена"), False, lambda tv: do_undo()),
                    chip(t("Before / After", "До / После"), self._bypass, toggle_bypass))

        def sec_motion():
            content.addView(label(t("Motion", "Движение")))
            slider("float_amp", t("Levitation", "Левитация"), 0, 20)
            slider("float_speed", t("Levitation speed", "Скорость левитации"), 1, 10)
            add_row(toggle("pop", t("Pop-in", "Появление")),
                    gtoggle("battery_aware", t("Pause on battery saver", "Пауза при экономии")))

        def sec_glass():
            content.addView(label(t("Glass tiles", "Стеклянные плитки")))
            add_row(toggle("tiles", t("Glass tiles", "Плитки")),
                    cycle("tile_tint", TINTS, t("Tint: ", "Оттенок: "), 6))
            add_row(toggle("tint_type", t("Tint unique differently", "Уникальные другим цветом")))
            slider("tile_radius", t("Corner radius", "Скругление"), 0, 36)
            slider("tile_alpha", t("Glass strength", "Плотность стекла"), 4, 60)
            content.addView(label(t("Studio look", "Вид студии")))
            add_row(cycle_global("accent", t("Accent: ", "Акцент: ")),
                    gtoggle("fx_anim", t("Shimmer & bubbles", "Блик и пузыри"), True))

        def cycle_global(key, prefix):
            def text():
                a = ACCENTS[self._gi(key, 0) % len(ACCENTS)]
                return prefix + a[1 if self._ru else 0]

            def click(tv):
                self.set_setting(key, (self._gi(key, 0) + 1) % len(ACCENTS))
                self._tab = 3
                self._reopen_later()
            c = chip(text(), False, click)
            c.setBackground(self._glass(14, 0x3A, 0x18, 0x58))
            return c

        def sec_order():
            content.addView(label(t("Sorting", "Сортировка")))
            add_row(cycle("sort", SORT_NAMES, "", 12))
            add_row(toggle("reverse", t("Reverse", "Наоборот")), toggle("pinned_first", t("Pinned first", "Закреплённые вверху")))
            add_row(chip(t("Shuffle again", "Перемешать заново"), False, lambda tv: shuffle_again()),
                    step_chip("limit", LIMIT_STEPS, t("Limit: ", "Лимит: ")))
            content.addView(label(t("Manual", "Вручную")))
            add_row(chip(t("\u2195 Reorder and hide", "\u2195 Порядок и скрытие"), False, lambda tv: self._editor(act)),
                    toggle("peek_hidden", t("Peek hidden", "Показать скрытые")))

        def shuffle_again():
            self._put("seed", random.randint(1, 99999), pid)
            self._put("sort", 8, pid)
            self._changed()
            render()

        def sec_filters():
            content.addView(label(t("Filters", "Фильтры")))
            add_row(cycle("filter", FILTER_NAMES, "", 5))
            add_row(step_chip("minstars", STAR_STEPS, t("Min \u2605: ", "Мин \u2605: ")),
                    step_chip("maxstars", STAR_STEPS, t("Max \u2605: ", "Макс \u2605: ")))
            add_row(toggle("only_msg", t("With comment", "С комментарием")), toggle("hide_anon", t("No anonymous", "Без анонимов")))
            q = self._cfg(pid)["query"]

            def q_click(tv):
                if q:
                    self._put("query", "", pid)
                    self._changed()
                    render()
                else:
                    BulletinHelper.show_info(t("Type a name in plugin settings, field Search", "Введите название в настройках плагина, поле «Поиск»"))
            add_row(chip((t("Search: ", "Поиск: ") + q + "  \u2715") if q else t("Search (in plugin settings)", "Поиск (в настройках плагина)"),
                         bool(q), q_click))

        def stat_tile(value, title):
            box = LinearLayout(act)
            box.setOrientation(1)
            box.setGravity(17)
            box.setPadding(dp(8), dp(12), dp(8), dp(12))
            box.setBackground(self._glass(16, 0x2A, 0x0C, 0x40))
            box.setLayoutParams(self._lp(0, -2, 1.0, (0, 0, 8, 8)))
            v = self._txt(act, value, 20, WHITE, True)
            v.setGravity(17)
            s = self._txt(act, title, 11, _with_alpha(WHITE, 0xB0))
            s.setGravity(17)
            box.addView(v)
            box.addView(s)
            return box

        def sec_stats():
            s = self._stats(pid)
            if not s["count"]:
                content.addView(label(t("Open the Gifts tab of a profile first", "Сначала откройте вкладку «Подарки» профиля")))
                return
            content.addView(label(t("Collection", "Коллекция")))
            add_row(stat_tile(str(s["count"]), t("gifts", "подарков")),
                    stat_tile(str(s["unique"]), t("unique", "уникальных")),
                    stat_tile(str(s["types"]), t("types", "видов")))
            add_row(stat_tile("\u2605 %d" % s["total"], t("total value", "стоимость")),
                    stat_tile(str(s["pinned"]), t("pinned", "закреплено")),
                    stat_tile(str(s["hidden"]), t("hidden by me", "скрыто мной")))
            add_row(stat_tile("\u2605 %d" % (s["total"] // max(1, s["count"])), t("average", "средняя")),
                    stat_tile(str(s["count"] - s["types"]), t("duplicates", "дублей")),
                    stat_tile(str(len(self._ovr_cache)), t("edited", "изменено")))
            if s["top"]:
                content.addView(self._txt(act, t("Most expensive: ", "Самый дорогой: ") + s["top"]["label"], 13, WHITE))
            if s["rare"]:
                content.addView(self._txt(act, t("Rarest: ", "Самый редкий: ") + s["rare"]["label"], 13, WHITE))
            sp = View(act)
            content.addView(sp, self._lp(-1, dp(10)))
            add_row(chip(t("Copy summary", "Скопировать итоги"), False, lambda tv: summary()))

        def sec_tools():
            content.addView(label(t("Slots", "Слоты")))
            add_row(*[chip(t("Save %d", "Сохранить %d") % n, False, (lambda tv, n=n: slot_save(n))) for n in (1, 2, 3)])
            add_row(*[chip(t("Load %d", "Загрузить %d") % n, False, (lambda tv, n=n: slot_load(n))) for n in (1, 2, 3)])
            content.addView(label(t("Share", "Поделиться")))
            add_row(chip(t("Copy layout", "Копировать"), False, lambda tv: do_copy()),
                    chip(t("Paste layout", "Вставить"), False, lambda tv: do_paste()))
            content.addView(label(t("Reset", "Сброс")))
            add_row(chip(t("Layout", "Сетка"), False, lambda tv: (apply_cfg(layout_defaults()))),
                    chip(t("Order & filters", "Порядок и фильтры"), False, lambda tv: reset_order()))
            content.addView(label(t("Scope", "Область")))

            def scope_click(tv):
                self.set_setting("scope", 0 if self._gi("scope", 0) == 1 else 1)
                self._changed()
                render()
            add_row(chip(t("Own layout per profile", "Своя раскладка у профиля"), self._gi("scope", 0) == 1, scope_click))
            add_row(chip(t("Diagnostics", "Диагностика"), False, lambda tv: self.show_diagnostics()),
                    gtoggle("haptics", t("Haptics", "Вибро")))

        def toggle_freeze(tv):
            self._fly_paused = not self._fly_paused
            style_chip(tv, self._fly_paused)

        def fly_reroll():
            self._put("fly_seed", random.randint(1, 99999), pid)
            self._changed()

        def fly_max():
            self._put("fly", True, pid)
            self._put("fly_speed", 50, pid)
            self._changed()
            render()

        def sec_fly():
            content.addView(label(t("Chaos flight", "Хаотичный полёт")))
            add_row(toggle("fly", t("Flying gifts", "Летающие подарки")),
                    chip(t("Freeze", "Заморозить"), self._fly_paused, toggle_freeze))
            slider("fly_speed", t("Speed", "Скорость"), 1, 50)
            slider("fly_size", t("Random size change", "Случайный размер"), 0, 100)
            slider("fly_spin", t("Spin", "Вращение"), 0, 10)
            add_row(cycle("fly_only", FLY_ONLY_NAMES, t("Who: ", "Кто: "), 3),
                    cycle("fly_area", FLY_AREA_NAMES, t("Area: ", "Область: "), 2))
            add_row(chip(t("New pattern", "Новый рисунок"), False, lambda tv: fly_reroll()),
                    chip(t("Speed x50", "Скорость x50"), False, lambda tv: fly_max()))

        sections = (sec_layout, sec_motion, sec_fly, sec_glass, sec_order, sec_gifts, sec_filters, sec_stats, sec_tools)

        def render():
            content.removeAllViews()
            card = FrameLayout(act)
            hb = GradientDrawable(GradOrient.TL_BR, jarray(jint)([_with_alpha(accent, 0xE6), _argb("#E04F8BFF"), _argb("#E6FF6FB5")]))
            hb.setCornerRadius(float(dp(22)))
            hb.setStroke(max(1, dp(1)), _with_alpha(WHITE, 0x80))
            card.setBackground(hb)
            inner = LinearLayout(act)
            inner.setOrientation(1)
            inner.setPadding(dp(18), dp(16), dp(18), dp(16))
            inner.addView(self._txt(act, t("Gifts Studio", "Студия подарков"), 22, WHITE, True))
            sub = self._txt(act, sub_text(), 13, _with_alpha(WHITE, 0xE0))
            sub.setPadding(0, dp(4), 0, 0)
            sub_ref["tv"] = sub
            inner.addView(sub)
            card.addView(inner, FLP(-1, -2))
            if motion:
                shine = View(act)
                sg = GradientDrawable(GradOrient.LEFT_RIGHT, jarray(jint)([0, _with_alpha(WHITE, 0x70), 0]))
                shine.setBackground(sg)
                shine.setRotation(16.0)
                card.addView(shine, FLP(dp(70), dp(140)))
                self._animate(shine, "translationX", [-dp(90), sw_px], 2600, anims, 1, True)
            card.setLayoutParams(self._lp(-1, -2, None, (0, 0, 0, 6)))
            content.addView(card)

            hs = HScroll(act)
            hs.setHorizontalScrollBarEnabled(False)
            trow = hrow()
            for i, (en, ru) in enumerate(TABS):
                def go(tv, i=i):
                    self._tab = i
                    render()
                trow.addView(chip(ru if self._ru else en, i == self._tab, go, None))
            hs.addView(trow)
            hs.setLayoutParams(self._lp(-1, -2, None, (0, 8, 0, 0)))
            content.addView(hs)
            sections[self._tab]()

        render()
        b = AlertDialogBuilder(act)
        b.set_view(frame)
        b.set_positive_button(t("Done", "Готово"), lambda *a: None)
        b.show()
        self._studio_dialog = b
        try:
            dlg = getattr(b, "dialog", None)
            if dlg is None and hasattr(b, "get_dialog"):
                dlg = b.get_dialog()
            if dlg is not None:
                dlg.getWindow().setDimAmount(0.12)
        except Exception:
            pass

    def _reopen_later(self):
        try:
            b = getattr(self, "_studio_dialog", None)
            if b is not None:
                b.dismiss()
        except Exception:
            pass
        run_on_ui_thread(self._open_studio_ui, 250)

    def _mini_slider(self, act, parent, title, lo, hi, cur, fmt, on, accent):
        dp = self._dp
        box = LinearLayout(act)
        box.setOrientation(1)
        box.setPadding(dp(14), dp(10), dp(14), dp(6))
        box.setBackground(self._glass(16, 0x22, 0x0A, 0x38))
        box.setLayoutParams(self._lp(-1, -2, None, (0, 0, 0, 8)))
        top = LinearLayout(act)
        top.setOrientation(0)
        name = self._txt(act, title, 14, WHITE, True)
        name.setLayoutParams(self._lp(0, -2, 1.0))
        val = self._txt(act, fmt % cur, 14, _with_alpha(WHITE, 0xD0), True)
        top.addView(name)
        top.addView(val)
        sb = SeekBar(act)
        sb.setMax(hi - lo)
        sb.setProgress(max(0, min(hi, cur) - lo))
        try:
            sb.setProgressTintList(ColorStateList.valueOf(accent))
            sb.setThumbTintList(ColorStateList.valueOf(WHITE))
        except Exception:
            pass

        def cb(p):
            v = p + lo
            val.setText(fmt % v)
            on(v)
        sb.setOnSeekBarChangeListener(_Seek(cb))
        box.addView(top)
        box.addView(sb)
        parent.addView(box)

    def _gift_editor(self, act, key, title):
        t = self._t
        pid = self._pid
        dp = self._dp
        accent = self._accent()
        dm = act.getResources().getDisplayMetrics()
        frame = FrameLayout(act)
        frame.setBackground(_dark_background(dp(18)))
        scroll = ScrollView(act)
        scroll.setVerticalScrollBarEnabled(False)
        frame.addView(scroll, FLP(-1, int(dm.heightPixels * 0.6)))
        box = LinearLayout(act)
        box.setOrientation(1)
        box.setPadding(dp(14), dp(12), dp(14), dp(12))
        scroll.addView(box)
        fields = (
            ("s", "Size", "Размер", 20, 400, "%d%%"), ("w", "Width", "Ширина", 30, 300, "%d%%"),
            ("h", "Height", "Высота", 30, 300, "%d%%"), ("r", "Rotation", "Поворот", -180, 180, "%d\u00b0"),
            ("x", "Shift X", "Сдвиг X", -80, 80, "%d dp"), ("y", "Shift Y", "Сдвиг Y", -80, 80, "%d dp"),
            ("a", "Opacity", "Прозрачность", 10, 100, "%d%%"),
        )

        def chip(text, active, fn):
            tv = TextView(act)
            tv.setText(text)
            tv.setTextSize(2, 13.0)
            tv.setGravity(17)
            tv.setTypeface(Typeface.DEFAULT_BOLD)
            tv.setTextColor(WHITE)
            tv.setPadding(dp(12), dp(10), dp(12), dp(10))
            tv.setBackground(self._accent_glass(accent) if active else self._glass(14, 0x2C, 0x0C, 0x40))
            tv.setOnClickListener(_Click(lambda: (self._haptic(tv), fn(tv))))
            tv.setLayoutParams(self._lp(0, -2, 1.0, (0, 0, 8, 8)))
            return tv

        def render():
            box.removeAllViews()
            head = self._txt(act, title, 18, WHITE, True)
            head.setPadding(0, dp(2), 0, dp(10))
            box.addView(head)
            ov = self._ovr_get(pid, key)
            for f, en, ru, lo, hi, fmt in fields:
                self._mini_slider(act, box, ru if self._ru else en, lo, hi, ov.get(f, OVR_DEF[f]), fmt,
                                  (lambda v, f=f: self._ovr_set(pid, key, f, v)), accent)
            row = LinearLayout(act)
            row.setOrientation(0)

            def front(tv):
                cur = bool(self._ovr_get(pid, key).get("f", False))
                self._ovr_set(pid, key, "f", not cur)
                tv.setBackground(self._glass(14, 0x2C, 0x0C, 0x40) if cur else self._accent_glass(accent))

            def reset(tv):
                self._ovr_clear(pid, key)
                render()
            row.addView(chip(t("On top", "Поверх остальных"), bool(ov.get("f", False)), front))
            row.addView(chip(t("Reset this gift", "Сбросить подарок"), False, reset))
            box.addView(row)

        render()
        b = AlertDialogBuilder(act)
        b.set_view(frame)
        b.set_positive_button(t("Done", "Готово"), lambda *a: None)
        b.show()

    # reorder / hide editor
    def _editor(self, act):
        t = self._t
        pid = self._pid
        seen = self._seen.get(pid)
        if not seen:
            BulletinHelper.show_info(t("Open the Gifts tab of a profile first", "Сначала откройте вкладку «Подарки» профиля"))
            return
        dp = self._dp
        accent = self._accent()
        meta = {m["key"]: m for m in seen}
        shown = [k for k in self._shown.get(pid, []) if k in meta]
        order = shown + [m["key"] for m in seen if m["key"] not in shown]
        hidden = set(self._jget("hidden").get(str(pid), []))
        dm = act.getResources().getDisplayMetrics()

        frame = FrameLayout(act)
        frame.setBackground(_dark_background(dp(18)))
        scroll = ScrollView(act)
        scroll.setVerticalScrollBarEnabled(False)
        frame.addView(scroll, FLP(-1, int(dm.heightPixels * 0.62)))
        box = LinearLayout(act)
        box.setOrientation(1)
        box.setPadding(dp(14), dp(12), dp(14), dp(12))
        scroll.addView(box)

        def save():
            d = self._jget("manual")
            d[str(pid)] = list(order)
            self._jset("manual", d)
            h = self._jget("hidden")
            h[str(pid)] = sorted(hidden)
            self._jset("hidden", h)
            self._put("sort", 9, pid)
            self._changed()

        def move(i, j):
            if 0 <= j < len(order):
                order[i], order[j] = order[j], order[i]
                save()
                render()

        def toggle_hide(k):
            if k in hidden:
                hidden.discard(k)
            else:
                hidden.add(k)
            save()
            render()

        def btn(text, fn):
            tv = TextView(act)
            tv.setText(text)
            tv.setTextSize(2, 15.0)
            tv.setGravity(17)
            tv.setTextColor(WHITE)
            tv.setBackground(self._accent_glass(accent, 12))
            tv.setOnClickListener(_Click(lambda: (self._haptic(tv), fn())))
            tv.setLayoutParams(self._lp(dp(38), dp(38), None, (6, 0, 0, 0)))
            return tv

        def render():
            box.removeAllViews()
            head = self._txt(act, t("Reorder and hide gifts", "Порядок и скрытие подарков"), 18, WHITE, True)
            head.setPadding(0, dp(2), 0, dp(10))
            box.addView(head)
            for i, k in enumerate(order):
                m = meta[k]
                row = LinearLayout(act)
                row.setOrientation(0)
                row.setGravity(16)
                row.setPadding(dp(12), dp(8), dp(8), dp(8))
                off = k in hidden
                row.setBackground(self._glass(14, 0x14 if off else 0x2A, 0x06 if off else 0x0C, 0x30))
                row.setLayoutParams(self._lp(-1, -2, None, (0, 0, 0, 6)))
                name = self._txt(act, "%d.  %s%s" % (i + 1, m["label"], t("  (hidden)", "  (скрыт)") if off else ""), 14,
                                 _with_alpha(WHITE, 0x70 if off else 0xFF))
                name.setLayoutParams(self._lp(0, -2, 1.0))
                row.addView(name)
                row.addView(btn("\u270E", lambda k=k: self._gift_editor(act, k, meta[k]["label"])))
                row.addView(btn("\u25B2", lambda i=i: move(i, i - 1)))
                row.addView(btn("\u25BC", lambda i=i: move(i, i + 1)))
                row.addView(btn("\u21BA" if off else "\u2715", lambda k=k: toggle_hide(k)))
                box.addView(row)

        render()
        b = AlertDialogBuilder(act)
        b.set_view(frame)
        b.set_positive_button(t("Done", "Готово"), lambda *a: None)
        b.show()

    # diagnostics
    def show_diagnostics(self, *a):
        def go():
            frag = get_last_fragment()
            act = frag.getParentActivity() if frag is not None else None
            if act is None:
                return
            cur = self._cur
            lines = ["Gifts Studio v%s" % __version__,
                     "running: %s, enabled: %s" % (self._running, self.get_setting("enabled", True)),
                     "hooks: " + ("; ".join(self._hook_info) or "none"),
                     "fillItems calls: %d, gifts in last call: %d" % (self._fill_calls, self._fill_gifts)]
            if cur:
                lst = cur[1]
                lm = lst.getLayoutManager()
                ad = lst.getAdapter()
                st = self._orig.get(self._ident(lst), {})
                lines += ["container: " + self._cname(cur[0]), "list: " + self._cname(lst),
                          "layout manager: " + self._cname(lm), "adapter: " + self._cname(ad),
                          "items: %s, gifts: %s" % (ad.getItemCount() if ad else "?", self._geo["count"] if self._geo else "?"),
                          "span now: %s, original: %s, per item: %s" % (
                              lm.getSpanCount() if isinstance(lm, GridLayoutManager) else "n/a",
                              st.get("span", "?"), st.get("s", "?")),
                          "columns: " + (self._span_note or "-")]
            else:
                lines.append("gifts list not found (open a profile Gifts tab)")
            lines.append("profile id: %s, own id: %s" % (self._pid, self._own_id()))
            lines.append("fly: %s, clock: %.1f, clipped parents: %d" % (
                self._cfg_cache.get("fly"), self._fly_clock, len(self._clipped)))
            lines.append("seen: %d, indexed: %d, edited gifts: %d, pick: %s" % (
                len(self._seen.get(self._pid, [])), len(self._mk), len(self._ovr_cache), self._pick))
            if self._last_err:
                lines.append("last error: " + self._last_err[-600:])
            text = "\n".join(lines)
            b = AlertDialogBuilder(act)
            b.set_title(self._t("Diagnostics", "Диагностика"))
            b.set_message(text)

            def copy(*x):
                cm = act.getSystemService("clipboard")
                cm.setPrimaryClip(jclass("android.content.ClipData").newPlainText("diag", text))
            b.set_positive_button("OK", lambda *x: None)
            b.set_neutral_button(self._t("Copy", "Копировать"), copy)
            b.show()
        run_on_ui_thread(go)
