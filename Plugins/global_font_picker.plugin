_CELL_DELEGATE_NONE = (
    "didToggleRichMessageCheckbox didPressExtendedMediaPreview didPressUserStatus didPressUserAvatar "
    "didPressHiddenForward didPressViaBotNotInline didPressViaBot didPressBoostCounter didPressChannelAvatar "
    "didPressCancelSendButton didLongPress didPressReplyMessage getProgressLoadingBotButtonUrl "
    "getProgressLoadingLink didPressUrl didPressCodeCopy didPressChannelRecommendation "
    "didPressMoreChannelRecommendations didPressChannelRecommendationsClose needOpenWebView didPressWebPage "
    "didPressImage didPressPollMedia didPressGroupImage didPressSideButton didQuickShareStart didQuickShareMove "
    "didQuickShareEnd didPressOther didPressSponsoredClose didPressSummarize didPressSponsoredInfo didPressTime "
    "didPressBotButton didLongPressBotButton didPressCustomBotButton didLongPressCustomBotButton didPressReaction "
    "didPressVoteButtons didPressInstantButton didPressShowMore didPressGiveawayChatButton didPressCommentButton "
    "didPressHint needShowPremiumFeatures needShowPremiumBulletin videoTimerReached didStartVideoStream "
    "setShouldNotRepeatSticker getTextSelectionHelper needReloadPolls onDiceFinished getPinchToZoomHelper "
    "invalidateBlur didPressTopicButton didPressDialogButton didPressEmojiStatus didPressAboutRevenueSharingAds "
    "didPressRevealSensitiveContent didPressEffect didPressFactCheckWhat didPressFactCheck forceUpdate "
    "didTogglePollPreview forceUpdateNoAnimation didPressAdmin drawPollMode didPressAddPollOptionButton "
    "getDraftMessageMeasureController"
)
_CELL_DELEGATE_FALSE = (
    "isReplyOrSelf canToggleRichMessageCheckbox didLongPressUserAvatar didLongPressChannelAvatar isProgressLoading "
    "didPressToDoButton didLongPressPollOption didLongPressToDoButton openArticlePhoto needPlayMessage "
    "drawingVideoPlayerContainer canPerformActions canPerformReply onAccessibilityAction hasSelectedMessages "
    "shouldDrawThreadProgress keyboardIsOpened didPressAnimatedEmoji shouldShowTopicButton shouldShowDialogButton "
    "allowAddPollOptions isAdmin isOwner doNotShowLoadingReply"
)

try:
    from java import dynamic_proxy as _dynamic_proxy
    from org.telegram.ui.Cells import ChatMessageCell as _ChatMessageCellCls

    _CellDelegateBase = _dynamic_proxy(_ChatMessageCellCls.ChatMessageCellDelegate)
except Exception:
    _CellDelegateBase = None

if _CellDelegateBase is not None:
    class _PreviewCellDelegate(_CellDelegateBase):
        """Inert delegate for the settings preview cells (same idea as Delegate in Quote)."""

        def __init__(self):
            super().__init__()

        def getAdminRank(self, uid):
            return None

        def isLandscape(self):
            return AndroidUtilities.displaySize.x > AndroidUtilities.displaySize.y

        def canDrawOutboundsContent(self):
            return True

        def shouldRepeatSticker(self, msg):
            return True

        def getAddPollOptionInputFieldHeight(self, cell):
            return 0

        for _names, _value in ((_CELL_DELEGATE_NONE, None), (_CELL_DELEGATE_FALSE, False)):
            for _name in _names.split():
                locals()[_name] = lambda self, *args, _value=_value: _value
        del _names, _value, _name


def _safe_str(value):
    try:
        if value is None:
            return ""
        return str(value)
    except Exception:
        return ""


def _safe_bool(value, fallback=False):
    try:
        return bool(value)
    except Exception:
        return fallback


def _safe_int(value, fallback=0):
    try:
        return int(value)
    except Exception:
        return fallback


class Plugin(BasePlugin):
    class ActivityResultHook(MethodHook):
        def __init__(self, plugin):
            super().__init__()
            self.plugin = plugin

        def before_hooked_method(self, param):
            try:
                request_code = param.args[0]
                result_code = param.args[1]
                data = param.args[2]
                if request_code != FONT_PICKER_REQUEST_CODE:
                    return
                param.setResult(None)
                if result_code == Activity.RESULT_OK and data is not None and data.getData() is not None:
                    uri = data.getData()
                    run_on_queue(lambda picked_uri=uri: self.plugin._handle_picked_font_uri(picked_uri))
            except Exception as e:
                self.plugin.log("activity result error: %s" % e)
                BulletinHelper.show_error(self.plugin._t("import_fail"))
            finally:
                self.plugin._picker_mode = PICKER_MODE_APPLY
                self.plugin._clear_activity_hook()

    def __init__(self):
        super().__init__()
        self._activity_hook = None
        self._plugin_dir_path = ""
        self._favorites_dir_path = ""
        self._recents_dir_path = ""
        self._bundled_dir_path = ""
        self._loaded_path = ""
        self._font_regular = None
        self._font_bold = None
        self._font_italic = None
        self._font_bold_italic = None
        self._picker_mode = PICKER_MODE_APPLY
        self._preview_cache = {}
        self._refresh_queued = False
        self._dex_loader = None
        self._core = None
        self._core_status = "—"
        self._core_error = ""
        self._dex_sha = ""
        self._dex_loader_kind = ""
        self._file_secrets = []
        self._menu_ids = []
        self._preview_factory = None
        self._preview_cells = []
        self._preview_fake_refs = []
        self._preview_host = None
        self._preview_hosts = []
        self._preview_kind = ""
        self._downloading_ids = set()
        self._catalog_view_refs = {}
        self._cell_delegate = None

    def _lang(self):
        return "en" if _safe_int(self.get_setting(SETTING_LANG, 0), 0) == 1 else "ru"

    def _t(self, key):
        pack = STRINGS.get(self._lang()) or STRINGS["ru"]
        return pack.get(key, STRINGS["ru"].get(key, key))

    def _preview_text(self):
        value = _safe_str(self.get_setting(SETTING_PREVIEW, PREVIEW_SAMPLE)).strip()
        return value or PREVIEW_SAMPLE

    def on_plugin_load(self):
        self._ensure_plugin_dir()
        self._install_embedded_fonts()
        self._ensure_default_font()
        self._normalize_favorites()
        self._normalize_selected_path()
        self._load_dex_core()
        if self._reload_font_state():
            self._refresh_visible_ui()
            try:
                from android.os import Handler, Looper
                def _again():
                    try:
                        self._reload_font_state()
                        self._refresh_visible_ui()
                    except Exception:
                        pass
                Handler(Looper.getMainLooper()).postDelayed(_again, 80)
                Handler(Looper.getMainLooper()).postDelayed(_again, 250)
            except Exception:
                pass
        self._install_menus()
        self._install_file_handlers()

    def on_plugin_unload(self):
        # Plugin turned off (or reloaded): typefaces already set on live views stay until
        # the app is restarted, so tell the user.
        self._show_restart_bulletin("unload_restart")
        self._clear_activity_hook()
        self._remove_file_handlers()
        self._core_stop()
        self._preview_cache.clear()
        self._preview_cells = []
        self._preview_fake_refs = []
        self._preview_host = None
        self._preview_hosts = []
        self._preview_kind = ""
        self._font_regular = None
        self._font_bold = None
        self._font_italic = None
        self._font_bold_italic = None

    def _show_restart_bulletin(self, key):
        try:
            text = self._t(key)
            run_on_ui_thread(lambda t=text: BulletinHelper.show_info(t))
        except Exception as e:
            self.log("restart bulletin: %s" % e)

    def on_app_event(self, event_type):
        if AppEvent is None:
            return
        try:
            if event_type == AppEvent.RESUME:
                # Apply typefaces ASAP to reduce FOUC (flash of default font)
                self._reload_font_state()
                self._refresh_visible_ui()
                # Second pass after layout settles (DEX hooks attach on window)
                def _late():
                    try:
                        self._reload_font_state()
                        self._refresh_visible_ui()
                    except Exception:
                        pass
                try:
                    from android.os import Handler, Looper
                    Handler(Looper.getMainLooper()).postDelayed(_late, 50)
                    Handler(Looper.getMainLooper()).postDelayed(_late, 180)
                except Exception:
                    run_on_ui_thread(_late)
        except Exception:
            pass

    def _dex_bytes(self):
        raw = "".join(_DEX_ZLIB_B64.split())
        data = zlib.decompress(base64.b64decode(raw))
        if not data.startswith(b"dex\n"):
            raise RuntimeError("DEX magic mismatch")
        digest = hashlib.sha256(data).hexdigest()
        if digest != DEX_SHA256:
            raise RuntimeError("DEX integrity check failed")
        self._dex_sha = digest
        return data

    def _existing_dex_matches(self, path, expected):
        try:
            if not path or not os.path.exists(path):
                return False
            with open(path, "rb") as handle:
                current = handle.read()
            return hashlib.sha256(current).hexdigest() == hashlib.sha256(expected).hexdigest()
        except Exception:
            return False

    def _atomic_write(self, path, data):
        tmp = path + ".tmp"
        with open(tmp, "wb") as handle:
            handle.write(data)
            handle.flush()
        os.replace(tmp, path)

    def _cleanup_old_dex(self, dex_dir, keep_name):
        try:
            for name in os.listdir(dex_dir.getAbsolutePath()):
                if name.startswith("fontcore_") and name.endswith(".dex") and name != keep_name:
                    try:
                        os.remove(os.path.join(dex_dir.getAbsolutePath(), name))
                    except Exception:
                        pass
        except Exception:
            pass

    def _load_dex_core(self):
        try:
            ctx = ApplicationLoader.applicationContext
            dex_bytes = self._dex_bytes()
            parent = ctx.getClassLoader()
            clazz = None
            loader = None
            kind = ""

            try:
                from java.nio import ByteBuffer
                from dalvik.system import InMemoryDexClassLoader

                loader = InMemoryDexClassLoader(ByteBuffer.wrap(dex_bytes), parent)
                clazz = loader.loadClass(CORE_CLASS)
                kind = "in-memory"
            except Exception as inmem_error:
                self.log("in-memory dex failed: %s" % inmem_error)
                from dalvik.system import DexClassLoader

                dex_dir = ctx.getDir("gfp_dex", 0)
                opt_dir = ctx.getDir("gfp_dex_opt", 0)
                keep_name = "fontcore_v%s.dex" % DEX_VERSION
                dex_file = File(dex_dir, keep_name)
                path = dex_file.getAbsolutePath()
                if not self._existing_dex_matches(path, dex_bytes):
                    self._atomic_write(path, dex_bytes)
                else:
                    self.log(self._t("hash_ok"))
                self._cleanup_old_dex(dex_dir, keep_name)
                loader = DexClassLoader(path, opt_dir.getAbsolutePath(), None, parent)
                clazz = loader.loadClass(CORE_CLASS)
                kind = "file"

            self._dex_loader = loader
            self._core = clazz
            self._dex_loader_kind = kind
            start = clazz.getMethod("start", ClassLoader)
            start.invoke(None, parent)
            hooked = clazz.getMethod("isHooked").invoke(None)
            version = clazz.getMethod("version").invoke(None)
            self._core_status = "DEX %s v%s hooked=%s" % (kind, version, hooked)
            self._core_error = ""
            self.log("font dex core ready: %s" % self._core_status)
        except Exception as e:
            self._core = None
            self._core_error = _safe_str(e)
            self._core_status = "DEX error"
            self.log("dex core load failed: %s" % e)

    def _core_configure(self, enabled):
        if self._core is None:
            return False
        try:
            method = self._core.getMethod(
                "configure",
                Boolean.TYPE,
                Boolean.TYPE,
                Boolean.TYPE,
                Boolean.TYPE,
                Typeface,
                Typeface,
                Typeface,
                Typeface,
            )
            method.invoke(
                None,
                bool(enabled),
                _safe_bool(self.get_setting(SETTING_APPLY_INTERFACE, True), True),
                _safe_bool(self.get_setting(SETTING_APPLY_STYLED, True), True),
                _safe_bool(self.get_setting(SETTING_APPLY_MESSAGES, True), True),
                self._font_regular,
                self._font_bold,
                self._font_italic,
                self._font_bold_italic,
            )
            self._core_reapply()
            return True
        except Exception as e:
            self.log("dex configure failed: %s" % e)
            self._core_error = _safe_str(e)
            self._core_reapply()
            return False

    def _core_stop(self):
        if self._core is None:
            return
        try:
            self._core.getMethod("stop").invoke(None)
        except Exception as e:
            self.log("dex stop failed: %s" % e)

    def _install_menus(self):
        if not HAS_MENU:
            return
        try:
            item_id = self.add_menu_item(
                MenuItemData(
                    menu_type=MenuItemType.DRAWER_MENU,
                    text=self._t("drawer"),
                    subtext=self._t("drawer_sub"),
                    icon="msg_text",
                    on_click=self._on_drawer_click,
                    priority=40,
                )
            )
            if item_id:
                self._menu_ids.append(item_id)
        except Exception as e:
            self.log("menu error: %s" % e)

    def _on_drawer_click(self, context):
        fragment = None
        try:
            fragment = context.get("fragment") if context else None
        except Exception:
            fragment = None
        if fragment is None:
            fragment = get_last_fragment()
        activity = fragment.getParentActivity() if fragment else None
        if activity is None:
            BulletinHelper.show_error(self._t("no_activity"))
            return
        labels = [self._t("toggle"), self._t("catalog"), self._t("pick"), self._t("open_fav")]
        builder = AlertDialogBuilder(activity)
        builder.set_title(self._t("drawer"))
        builder.set_items(labels, lambda b, which, bb=builder: self._on_drawer_item(which, bb))
        builder.set_negative_button(self._t("close"), lambda b, _w: b.dismiss())
        builder.show()

    def _on_drawer_item(self, which, builder):
        try:
            builder.dismiss()
        except Exception:
            pass
        if which == 0:
            enabled = _safe_bool(self.get_setting(SETTING_ENABLED, False))
            if enabled:
                self._core_configure(False)
                self.set_setting(SETTING_ENABLED, False, reload_settings=True)
                BulletinHelper.show_info(self._t("disabled_restart"))
                self._refresh_visible_ui()
            else:
                self.set_setting(SETTING_ENABLED, True)
                self._on_enabled_changed(True)
        elif which == 1:
            self._show_google_catalog_dialog()
        elif which == 2:
            self._open_font_picker(PICKER_MODE_APPLY)
        elif which == 3:
            self._show_favorites_dialog()

    def _install_file_handlers(self):
        if not HAS_FILES:
            return
        for ext in ("ttf", "otf", "ttc", "otc"):
            try:
                secret = FilesController.register(
                    FilesController.FileInfo(ext=ext, on_click=self._on_font_file_click)
                )
                self._file_secrets.append((ext, secret))
            except Exception as e:
                self.log("files controller %s: %s" % (ext, e))

    def _remove_file_handlers(self):
        if not HAS_FILES:
            return
        for ext, secret in self._file_secrets:
            try:
                FilesController.unregister(ext, secret)
            except Exception:
                pass
        self._file_secrets = []

    def _on_font_file_click(self, args):
        name = _safe_str(getattr(args, "file_name", "") or "font.ttf")
        path = ""
        try:
            f = getattr(args, "file", None)
            if f is not None:
                if hasattr(f, "getAbsolutePath"):
                    path = _safe_str(f.getAbsolutePath())
                else:
                    path = _safe_str(f)
        except Exception:
            path = ""
        activity = getattr(args, "activity", None)
        if activity is None:
            fragment = get_last_fragment()
            activity = fragment.getParentActivity() if fragment else None
        if activity is None:
            if path and os.path.exists(path):
                try:
                    self._activate_font_path(path, name, reload_settings=True)
                    BulletinHelper.show_success("%s: %s" % (self._t("applied"), name))
                except Exception:
                    BulletinHelper.show_error(self._t("import_fail"))
            return
        labels = [self._t("from_chat_apply"), self._t("from_chat_fav")]
        builder = AlertDialogBuilder(activity)
        builder.set_title(name)
        builder.set_items(
            labels,
            lambda b, which, p=path, n=name, bb=builder: self._on_chat_font_choice(which, p, n, bb),
        )
        builder.set_negative_button(self._t("cancel"), lambda b, _w: b.dismiss())
        builder.show()

    def _on_chat_font_choice(self, which, path, name, builder):
        try:
            builder.dismiss()
        except Exception:
            pass
        if not path or not os.path.exists(path):
            BulletinHelper.show_error(self._t("import_fail"))
            return
        try:
            if which == 0:
                target = os.path.join(self._plugin_dir_path, "selected_font" + (self._extract_supported_extension(name) or ".ttf"))
                with open(path, "rb") as src, open(target, "wb") as dst:
                    dst.write(src.read())
                self._activate_font_path(target, name, reload_settings=True)
                BulletinHelper.show_success("%s: %s" % (self._t("applied"), name))
            else:
                favorite = self._copy_existing_font_to_favorites(path, name)
                BulletinHelper.show_success("%s: %s" % (self._t("fav_added"), favorite["name"]))
        except Exception as e:
            self.log("chat font error: %s" % e)
            BulletinHelper.show_error(self._t("import_fail"))

    def _theme_color(self, key_name, fallback):
        try:
            key = getattr(Theme, key_name)
            return Theme.getColor(key)
        except Exception:
            return fallback

    def _clone_wallpaper(self):
        src = None
        for name in ("getCachedWallpaperNonBlocking", "getCachedWallpaper"):
            try:
                fn = getattr(Theme, name, None)
                if fn is None:
                    continue
                src = fn()
                if src is not None:
                    break
            except Exception:
                src = None
        if src is None:
            try:
                src = ColorDrawable(self._theme_color("key_chat_wallpaper", 0xFF0E1621))
            except Exception:
                return None
        try:
            state = src.getConstantState()
            if state is not None:
                copy = state.newDrawable()
                if copy is not None:
                    try:
                        copy = copy.mutate()
                    except Exception:
                        pass
                    try:
                        copy.setCallback(None)
                    except Exception:
                        pass
                    return copy
        except Exception:
            pass
        try:
            return ColorDrawable(self._theme_color("key_chat_wallpaper", 0xFF0E1621))
        except Exception:
            return None

    def _wallpaper_snapshot(self):
        """Draw the real chat wallpaper into a bitmap (pattern / gradient / image), like Quote does."""
        try:
            width = int(AndroidUtilities.displaySize.x)
            height = min(int(AndroidUtilities.displaySize.y), int(AndroidUtilities.dp(480)))
            if width <= 0 or height <= 0:
                return None
            wallpaper = None
            for name in ("getCachedWallpaper", "getCachedWallpaperNonBlocking"):
                try:
                    fn = getattr(Theme, name, None)
                    if fn is None:
                        continue
                    wallpaper = fn()
                    if wallpaper is not None:
                        break
                except Exception:
                    wallpaper = None
            if wallpaper is None:
                return None
            bmp = Bitmap.createBitmap(width, height, Bitmap.Config.ARGB_8888)
            canvas = Canvas(bmp)
            try:
                if Theme.isPatternWallpaper():
                    canvas.drawColor(self._theme_color("key_chat_wallpaper", 0xFF0E1621))
            except Exception:
                pass
            old_bounds = None
            try:
                old_bounds = wallpaper.copyBounds()
            except Exception:
                old_bounds = None
            try:
                wallpaper.setBounds(0, 0, width, height)
                wallpaper.draw(canvas)
            finally:
                if old_bounds is not None:
                    try:
                        wallpaper.setBounds(old_bounds)
                    except Exception:
                        pass
            return bmp
        except Exception as e:
            self.log("wallpaper snapshot: %s" % e)
            return None

    def _bubble_drawable(self, incoming):
        r = float(AndroidUtilities.dp(16))
        tail = float(AndroidUtilities.dp(5))
        if incoming:
            radii = [r, r, r, r, r, r, tail, tail]
            color = self._theme_color("key_chat_inBubble", 0xFF212D3B)
        else:
            radii = [r, r, r, r, tail, tail, r, r]
            color = self._theme_color("key_chat_outBubble", 0xFF2B5278)
        try:
            from android.graphics.drawable import GradientDrawable

            d = GradientDrawable()
            d.setColor(color)
            d.setCornerRadii(radii)
            return d
        except Exception:
            try:
                return Theme.createRoundRectDrawable(int(r), color)
            except Exception:
                return None

    def _service_drawable(self):
        color = self._theme_color("key_chat_serviceBackground", 0x66000000)
        try:
            from android.graphics.drawable import GradientDrawable

            d = GradientDrawable()
            d.setColor(color)
            d.setCornerRadius(float(AndroidUtilities.dp(11)))
            return d
        except Exception:
            try:
                return Theme.createRoundRectDrawable(AndroidUtilities.dp(11), color)
            except Exception:
                return None

    def _find_tagged(self, view, tag):
        if view is None:
            return None
        try:
            if _safe_str(view.getTag()) == tag:
                return view
        except Exception:
            pass
        try:
            count = view.getChildCount()
        except Exception:
            return None
        for idx in range(count):
            hit = self._find_tagged(view.getChildAt(idx), tag)
            if hit is not None:
                return hit
        return None

    def _clock_text(self):
        try:
            from java.text import SimpleDateFormat
            from java.util import Date, Locale

            return SimpleDateFormat("HH:mm", Locale.getDefault()).format(Date())
        except Exception:
            return "12:04"

    def _core_reapply(self):
        def _do():
            if self._core is not None:
                try:
                    self._core.getMethod("reapplyVisible").invoke(None)
                except Exception as e:
                    self.log("reapplyVisible: %s" % e)
            try:
                self._reapply_tree_python(force_now=True)
            except Exception as e:
                self.log("python reapply: %s" % e)

        run_on_ui_thread(_do)

    def _reapply_tree_python(self, force_now=False):
        plugin = self
        face = self._font_regular
        enabled = _safe_bool(self.get_setting(SETTING_ENABLED, False)) and face is not None

        def apply_view(view, depth=0):
            if view is None or depth > 28:
                return
            try:
                tag = _safe_str(view.getTag())
                if tag == PREVIEW_TAG:
                    return
            except Exception:
                pass
            try:
                if isinstance(view, TextView):
                    if enabled:
                        try:
                            view.setTypeface(face)
                        except Exception:
                            pass
                    view.invalidate()
                else:
                    cls = _safe_str(view.getClass().getName())
                    if "SimpleTextView" in cls or "AnimatedTextView" in cls:
                        if enabled:
                            try:
                                view.setTypeface(face)
                            except Exception:
                                pass
                            try:
                                text = view.getText()
                                view.setText(text)
                            except Exception:
                                pass
                        try:
                            view.invalidate()
                        except Exception:
                            pass
            except Exception:
                pass
            try:
                n = view.getChildCount()
            except Exception:
                n = 0
            for i in range(n):
                try:
                    apply_view(view.getChildAt(i), depth + 1)
                except Exception:
                    pass

        def _do():
            roots = []
            try:
                wmg = jclass("android.view.WindowManagerGlobal")
                inst = wmg.getInstance()
                views = None
                try:
                    views = get_private_field(inst, "mViews")
                except Exception:
                    views = None
                if views is not None:
                    try:
                        size = views.size()
                        for i in range(size):
                            roots.append(views.get(i))
                    except Exception:
                        try:
                            for v in views:
                                roots.append(v)
                        except Exception:
                            pass
            except Exception:
                pass
            if not roots:
                fragment = get_last_fragment()
                if fragment is not None:
                    try:
                        roots.append(fragment.getFragmentView())
                    except Exception:
                        pass
                    try:
                        activity = fragment.getParentActivity()
                        if activity is not None:
                            roots.append(activity.getWindow().getDecorView())
                    except Exception:
                        pass
            for root in roots:
                apply_view(root)
            fragment = get_last_fragment()
            plugin._notify_list_adapters(fragment)
            try:
                if fragment is not None:
                    ab = get_private_field(fragment, "actionBar")
                    if ab is not None:
                        title = ab.getTitle()
                        ab.setTitle(title)
                        try:
                            ab.invalidate()
                        except Exception:
                            pass
            except Exception:
                pass

        if force_now:
            _do()
        else:
            run_on_ui_thread(_do)

    def _telegram_bubble_drawable(self, incoming):
        is_out = not incoming
        try:
            MD = getattr(Theme, "MessageDrawable", None)
            if MD is None:
                MD = jclass("org.telegram.ui.ActionBar.Theme$MessageDrawable")
            drawable = MD(0, is_out, False)
            if drawable is not None:
                return drawable
        except Exception as e:
            self.log("MessageDrawable: %s" % e)
        try:
            src = Theme.chat_msgOutDrawable if is_out else Theme.chat_msgInDrawable
            if src is not None:
                state = src.getConstantState()
                if state is not None:
                    copy = state.newDrawable()
                    try:
                        copy = copy.mutate()
                    except Exception:
                        pass
                    return copy
        except Exception:
            pass
        try:
            ctx = ApplicationLoader.applicationContext
            key = Theme.key_chat_outBubble if is_out else Theme.key_chat_inBubble
            res_name = "msg_out" if is_out else "msg_in"
            res_id = 0
            try:
                from android_utils import R as TelegramR

                res_id = int(getattr(TelegramR.drawable, res_name, 0) or 0)
            except Exception:
                res_id = 0
            if res_id:
                themed = Theme.getThemedDrawable(ctx, res_id, key)
                if themed is not None:
                    return themed
        except Exception:
            pass
        return self._bubble_drawable(incoming)

    def _preview_script(self):
        return [
            {"text": self._t("preview_in1"), "out": False, "mention": False},
            {"text": self._t("preview_out1"), "out": True, "mention": False},
            {"text": self._t("preview_in2"), "out": False, "mention": True},
            {"text": self._t("preview_out2"), "out": True, "mention": False},
        ]

    def _preview_face(self):
        face = self._font_regular
        if face is None:
            path = self.get_setting(SETTING_FONT_PATH, "")
            if path:
                face = self._get_preview_typeface(path)
        return face

    def _parent_layout(self):
        fragment = get_last_fragment()
        if fragment is None:
            return None
        for name in ("getParentLayout", "getLayout"):
            try:
                fn = getattr(fragment, name, None)
                if fn is None:
                    continue
                parent = fn()
                if parent is not None:
                    return parent
            except Exception:
                pass
        try:
            return get_private_field(fragment, "parentLayout")
        except Exception:
            return None

    def _make_preview_message(self, text, outgoing, msg_id, date_unix, mention=False):
        try:
            from java.util import ArrayList
            from org.telegram.messenger import MessageObject, UserConfig
            from org.telegram.tgnet import TLRPC
        except Exception as e:
            self.log("preview message imports: %s" % e)
            return None
        try:
            account = UserConfig.selectedAccount
            self_id = UserConfig.getInstance(account).getClientUserId()
            msg = TLRPC.TL_message()
            msg.message = _safe_str(text)
            msg.date = int(date_unix)
            msg.dialog_id = 1
            msg.id = int(msg_id)
            try:
                msg.media = TLRPC.TL_messageMediaEmpty()
            except Exception:
                pass
            msg.out = bool(outgoing)
            try:
                msg.from_id = TLRPC.TL_peerUser()
                msg.peer_id = TLRPC.TL_peerUser()
            except Exception:
                pass
            if outgoing:
                msg.flags = 259
                try:
                    msg.from_id.user_id = self_id
                    msg.peer_id.user_id = 0
                except Exception:
                    pass
            else:
                msg.flags = 257
                try:
                    msg.from_id.user_id = 0
                    msg.peer_id.user_id = self_id
                except Exception:
                    pass
            if mention and "@JavaScript_XD" in _safe_str(text):
                try:
                    if getattr(msg, "entities", None) is None:
                        msg.entities = ArrayList()
                    try:
                        ent = TLRPC.TL_messageEntityTextUrl()
                    except Exception:
                        ent = TLRPC.TL_messageEntityMention()
                    ent.offset = 0
                    ent.length = len("@JavaScript_XD")
                    try:
                        ent.url = "https://t.me/JavaScript_XD"
                    except Exception:
                        pass
                    msg.entities.add(ent)
                    msg.flags = int(msg.flags) | 128
                except Exception as e:
                    self.log("preview mention: %s" % e)
            obj = MessageObject(account, msg, True, False)
            try:
                obj.eventId = 1
            except Exception:
                pass
            try:
                obj.resetLayout()
            except Exception:
                pass
            return obj
        except Exception as e:
            self.log("make preview message: %s" % e)
            return None

    def _create_chat_cell(self, context, account):
        try:
            from org.telegram.ui.Cells import ChatMessageCell
        except Exception as e:
            self.log("ChatMessageCell import: %s" % e)
            return None
        errors = []
        for maker in (
            lambda: ChatMessageCell(context, account, False, None, None),
            lambda: ChatMessageCell(context, account),
            lambda: ChatMessageCell(context),
        ):
            try:
                cell = maker()
                if cell is not None:
                    self._prepare_preview_cell(cell)
                    return cell
            except Exception as e:
                errors.append(_safe_str(e))
        self.log("ChatMessageCell ctor failed: %s" % " | ".join(errors))
        return None

    def _prepare_preview_cell(self, cell):
        # Same setup the Quote plugin gives its ChatMessageCell: delegate + full draw.
        try:
            if self._cell_delegate is None and _CellDelegateBase is not None:
                self._cell_delegate = _PreviewCellDelegate()
            if self._cell_delegate is not None:
                cell.setDelegate(self._cell_delegate)
        except Exception as e:
            self.log("preview delegate: %s" % e)
        try:
            cell.setFullyDraw(True)
        except Exception:
            pass

    def _set_cell_message(self, cell, obj):
        if cell is None or obj is None:
            return
        try:
            cell.setFullyDraw(True)
        except Exception:
            pass
        try:
            cell.setParentViewSize(int(AndroidUtilities.displaySize.x), int(AndroidUtilities.displaySize.y))
        except Exception:
            pass
        for call in (
            lambda: cell.setMessageObject(obj, None, False, False, False),
            lambda: cell.setMessageObject(obj, None, False, False),
            lambda: cell.setMessageObject(obj),
        ):
            try:
                call()
                break
            except Exception:
                continue
        try:
            cell.invalidate()
        except Exception:
            pass

    def _fill_native_preview(self, cells=None):
        cells = cells if cells is not None else (getattr(self, "_preview_cells", None) or [])
        script = self._preview_script()
        now = int(time.time())
        count = min(len(cells), len(script))
        for idx in range(count):
            item = script[idx]
            obj = self._make_preview_message(
                item["text"],
                item["out"],
                idx + 1,
                now - (count - idx) * 25,
                item.get("mention"),
            )
            self._set_cell_message(cells[idx], obj)

    def _add_fake_bubble(self, context, col, outgoing, tag):
        from android.view import Gravity

        row = LinearLayout(context)
        row.setOrientation(LinearLayout.HORIZONTAL)
        row.setGravity(Gravity.RIGHT if outgoing else Gravity.LEFT)
        row.setTag(PREVIEW_TAG)
        lp = LinearLayout.LayoutParams(-1, -2)
        lp.topMargin = AndroidUtilities.dp(2)
        lp.bottomMargin = AndroidUtilities.dp(2)
        if outgoing:
            lp.leftMargin = AndroidUtilities.dp(56)
            lp.rightMargin = AndroidUtilities.dp(3)
        else:
            lp.rightMargin = AndroidUtilities.dp(56)
            lp.leftMargin = AndroidUtilities.dp(3)

        bubble = LinearLayout(context)
        bubble.setOrientation(LinearLayout.HORIZONTAL)
        bubble.setGravity(Gravity.BOTTOM)
        bubble.setTag(tag)
        bubble.setPadding(
            AndroidUtilities.dp(13 if not outgoing else 11),
            AndroidUtilities.dp(6),
            AndroidUtilities.dp(9 if not outgoing else 11),
            AndroidUtilities.dp(6),
        )
        bg = self._telegram_bubble_drawable(not outgoing)
        if bg is not None:
            try:
                bubble.setBackground(bg)
            except Exception:
                pass

        msg = TextView(context)
        msg.setTag(tag + "_msg")
        msg.setTextSize(16)
        try:
            msg.setMaxWidth(AndroidUtilities.dp(240))
        except Exception:
            pass
        try:
            msg.setIncludeFontPadding(False)
        except Exception:
            pass

        time = TextView(context)
        time.setTag(tag + "_time")
        time.setTextSize(11)
        time.setPadding(AndroidUtilities.dp(7), 0, 0, AndroidUtilities.dp(1))
        try:
            time.setIncludeFontPadding(False)
        except Exception:
            pass

        bubble.addView(msg, LinearLayout.LayoutParams(-2, -2))
        bubble.addView(time, LinearLayout.LayoutParams(-2, -2))
        row.addView(bubble, LinearLayout.LayoutParams(-2, -2))
        col.addView(row, lp)
        return {"msg": msg, "time": time, "bubble": bubble, "out": outgoing}

    def _mention_span(self, text, color):
        raw = _safe_str(text)
        needle = "@JavaScript_XD"
        if needle not in raw:
            return raw
        try:
            from android.text import SpannableString, Spanned
            from android.text.style import ForegroundColorSpan

            spanned = SpannableString(raw)
            start = raw.find(needle)
            spanned.setSpan(
                ForegroundColorSpan(int(color)),
                start,
                start + len(needle),
                Spanned.SPAN_EXCLUSIVE_EXCLUSIVE,
            )
            return spanned
        except Exception:
            return raw

    def _fill_fake_preview_views(self):
        refs = getattr(self, "_preview_fake_refs", None) or []
        script = self._preview_script()
        clock = self._clock_text()
        face = self._preview_face()
        in_text = self._theme_color("key_chat_messageTextIn", 0xFFFFFFFF)
        out_text = self._theme_color("key_chat_messageTextOut", 0xFFFFFFFF)
        in_time = self._theme_color("key_chat_inTimeText", 0x99FFFFFF)
        out_time = self._theme_color("key_chat_outTimeText", 0xB3FFFFFF)
        link = self._theme_color(
            "key_chat_messageLinkIn",
            self._theme_color("key_chat_inReplyNameText", 0xFF6BB3F2),
        )
        for idx, ref in enumerate(refs):
            if idx >= len(script):
                break
            item = script[idx]
            outgoing = item["out"]
            bubble = ref.get("bubble")
            msg = ref.get("msg")
            time = ref.get("time")
            if bubble is not None:
                bg = self._telegram_bubble_drawable(not outgoing)
                if bg is not None:
                    try:
                        bubble.setBackground(bg)
                    except Exception:
                        pass
            if msg is not None:
                body = item["text"]
                if item.get("mention"):
                    msg.setText(self._mention_span(body, link))
                else:
                    msg.setText(body)
                msg.setTextColor(out_text if outgoing else in_text)
                if face is not None:
                    try:
                        msg.setTypeface(face)
                    except Exception:
                        pass
            if time is not None:
                time.setText((clock + "  ✓") if outgoing else clock)
                time.setTextColor(out_time if outgoing else in_time)
                if face is not None:
                    try:
                        time.setTypeface(face)
                    except Exception:
                        pass

    def _install_wall(self, context, host):
        # Wallpaper layer: plain background under the messages, exactly like v2.7.0.
        # The view fills the host (MATCH_PARENT). The host height is always pinned to an exact
        # value (initial estimate, then real content height in _fit_one_preview), so the
        # wallpaper own min height can never stretch the block below the last message.
        from android.view import Gravity, View

        fallback = self._theme_color("key_chat_wallpaper", 0xFF0E1621)
        art = View(context)
        art.setTag("gfp_wall_art")
        snap = self._wallpaper_snapshot()
        if snap is not None:
            try:
                drawable = BitmapDrawable(context.getResources(), snap)
                drawable.setGravity(Gravity.TOP | Gravity.FILL_HORIZONTAL)
                art.setBackground(drawable)
                host.addView(art, FrameLayout.LayoutParams(-1, -1))
                return
            except Exception as e:
                self.log("wallpaper snapshot bg: %s" % e)
        paper = self._clone_wallpaper()
        if paper is not None:
            try:
                art.setBackground(paper)
            except Exception:
                art.setBackgroundColor(fallback)
        else:
            art.setBackgroundColor(fallback)
        host.addView(art, FrameLayout.LayoutParams(-1, -1))

    def _preview_initial_height(self):
        # Exact height used until the real content height is measured (first fit runs
        # right after layout). A bit taller than 4 short messages, so nothing is cut.
        try:
            return int(AndroidUtilities.dp(240))
        except Exception:
            return -2

    def _track_preview_host(self, host):
        try:
            hosts = list(getattr(self, "_preview_hosts", None) or [])
            hosts.append(host)
            self._preview_hosts = hosts[-6:]
        except Exception:
            pass

    def _try_build_native_preview(self, context):
        try:
            from org.telegram.messenger import UserConfig
        except Exception as e:
            self.log("native preview import: %s" % e)
            return None
        try:
            account = UserConfig.selectedAccount
        except Exception:
            account = 0
        first = self._create_chat_cell(context, account)
        if first is None:
            return None
        host = FrameLayout(context)
        self._install_wall(context, host)
        col = LinearLayout(context)
        col.setOrientation(LinearLayout.VERTICAL)
        col.setTag("gfp_col")
        col.setPadding(0, AndroidUtilities.dp(8), 0, AndroidUtilities.dp(10))
        host.addView(col, FrameLayout.LayoutParams(-1, -2))
        cells = [first]
        try:
            first.setFullyDraw(True)
        except Exception:
            pass
        col.addView(first, LinearLayout.LayoutParams(-1, -2))
        for _idx in range(3):
            cell = self._create_chat_cell(context, account)
            if cell is None:
                self._preview_cells = []
                return None
            try:
                cell.setFullyDraw(True)
            except Exception:
                pass
            col.addView(cell, LinearLayout.LayoutParams(-1, -2))
            cells.append(cell)
        self._preview_cells = cells
        self._preview_host = host
        self._track_preview_host(host)
        self._preview_kind = "native"
        self._fill_native_preview(cells)
        try:
            host.setTag("gfp_stage_native")
        except Exception:
            pass
        return host


    def _build_fake_preview(self, context):
        stage = FrameLayout(context)
        stage.setTag("gfp_stage_fake")
        self._install_wall(context, stage)
        col = LinearLayout(context)
        col.setOrientation(LinearLayout.VERTICAL)
        col.setTag("gfp_col")
        pad = AndroidUtilities.dp(8)
        col.setPadding(pad, AndroidUtilities.dp(10), pad, AndroidUtilities.dp(12))
        stage.addView(col, FrameLayout.LayoutParams(-1, -2))
        refs = []
        for idx, item in enumerate(self._preview_script()):
            refs.append(self._add_fake_bubble(context, col, item["out"], "gfp_b%d" % idx))
        self._preview_fake_refs = refs
        self._preview_kind = "fake"
        self._preview_host = stage
        self._track_preview_host(stage)
        self._preview_cells = []
        self._fill_fake_preview_views()
        return stage

    def _fit_one_preview(self, host):
        # Pin host height to the real content height (col). The wallpaper view fills the host,
        # so the background always ends right under the last message (no stretch, no gap).
        col = None
        try:
            col = host.findViewWithTag("gfp_col")
        except Exception:
            col = None
        if col is None:
            return
        width = int(col.getWidth())
        if width <= 0:
            return
        from android.view import View

        col.measure(
            View.MeasureSpec.makeMeasureSpec(width, View.MeasureSpec.EXACTLY),
            View.MeasureSpec.makeMeasureSpec(0, View.MeasureSpec.UNSPECIFIED),
        )
        need = int(col.getMeasuredHeight())
        if need <= 0:
            return
        lp = host.getLayoutParams()
        if lp is not None and int(lp.height) != need:
            lp.height = need
            host.setLayoutParams(lp)

    def _fit_preview_height(self):
        for host in list(getattr(self, "_preview_hosts", None) or []):
            try:
                self._fit_one_preview(host)
            except Exception as e:
                self.log("fit preview height: %s" % e)

    def _schedule_fit_preview(self):
        try:
            from android.os import Handler, Looper

            handler = Handler(Looper.getMainLooper())
            for delay in (0, 60, 200, 500):
                handler.postDelayed(lambda: self._fit_preview_height(), delay)
        except Exception:
            pass

    def _refresh_chat_preview(self):
        def _do():
            try:
                kind = getattr(self, "_preview_kind", "")
                if kind == "native":
                    self._fill_native_preview()
                    host = getattr(self, "_preview_host", None)
                    if host is not None:
                        try:
                            host.invalidate()
                        except Exception:
                            pass
                    for cell in getattr(self, "_preview_cells", None) or []:
                        try:
                            cell.invalidate()
                        except Exception:
                            pass
                elif kind == "fake":
                    self._fill_fake_preview_views()
                self._schedule_fit_preview()
            except Exception as e:
                self.log("preview refresh: %s" % e)

        run_on_ui_thread(_do)

    def _make_preview_factory(self):
        if not HAS_RICH_SETTINGS:
            return None
        plugin = self

        def create(context, list_view, current_account, class_guid, resources_provider):
            wrap = LinearLayout(context)
            wrap.setOrientation(LinearLayout.VERTICAL)
            wrap.setTag(PREVIEW_TAG)
            stage = plugin._try_build_native_preview(context)
            if stage is None:
                stage = plugin._build_fake_preview(context)
            wrap.addView(stage, LinearLayout.LayoutParams(-1, plugin._preview_initial_height()))
            try:
                from android.os import Handler, Looper

                Handler(Looper.getMainLooper()).post(lambda: plugin._refresh_chat_preview())
                Handler(Looper.getMainLooper()).postDelayed(lambda: plugin._refresh_chat_preview(), 80)
            except Exception:
                pass
            return wrap

        def bind(view, item, divider, adapter, list_view):
            try:
                plugin._refresh_chat_preview()
            except Exception as e:
                plugin.log("preview bind: %s" % e)

        try:
            return SimpleSettingFactory(create, bind, is_clickable=False, is_shadow=False)
        except Exception as e:
            self.log("preview factory: %s" % e)
            return None


    def _embedded_items(self):
        return [item for item in CATALOG if item.get("source") == "embed"]

    def _google_items(self):
        return [item for item in CATALOG if item.get("source") == "google"]

    def _catalog_path(self, item):
        if not item or not self._bundled_dir_path:
            return ""
        return os.path.join(self._bundled_dir_path, "%s.ttf" % item["id"])

    def _catalog_ready(self, item):
        path = self._catalog_path(item)
        try:
            return bool(path) and os.path.exists(path) and os.path.getsize(path) > 1024
        except Exception:
            return False

    def _install_embedded_fonts(self):
        if not self._bundled_dir_path:
            return
        for fid, blob in _EMBEDDED_FONTS.items():
            path = os.path.join(self._bundled_dir_path, "%s.ttf" % fid)
            try:
                if os.path.exists(path) and os.path.getsize(path) > 1024:
                    continue
            except Exception:
                pass
            try:
                raw = "".join(_safe_str(blob).split())
                if not raw:
                    continue
                data = zlib.decompress(base64.b64decode(raw))
                if data[:4] not in (b"\x00\x01\x00\x00", b"OTTO", b"ttcf"):
                    raise RuntimeError("bad font magic")
                tmp = path + ".tmp"
                with open(tmp, "wb") as handle:
                    handle.write(data)
                    handle.flush()
                os.replace(tmp, path)
            except Exception as e:
                self.log("embed font %s: %s" % (fid, e))

    def _ensure_default_font(self):
        if self.get_setting(SETTING_FONT_PATH, ""):
            return
        ptsans = self._catalog_path({"id": "pt_sans"})
        if ptsans and os.path.exists(ptsans):
            self.set_setting(SETTING_FONT_PATH, ptsans)
            self.set_setting(SETTING_FONT_NAME, "PT Sans")

    def _make_catalog_factory(self):
        if not HAS_RICH_SETTINGS:
            return None
        plugin = self

        def create(context, list_view, current_account, class_guid, resources_provider):
            layout = LinearLayout(context)
            layout.setOrientation(LinearLayout.VERTICAL)
            pad = AndroidUtilities.dp(12)
            layout.setPadding(pad, AndroidUtilities.dp(4), pad, AndroidUtilities.dp(8))
            layout.setTag(PREVIEW_TAG)
            help_view = TextView(context)
            help_view.setText(plugin._t("bundled_help"))
            help_view.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText2))
            help_view.setTextSize(13)
            help_view.setTag(PREVIEW_TAG)
            help_view.setPadding(AndroidUtilities.dp(4), 0, AndroidUtilities.dp(4), AndroidUtilities.dp(8))
            layout.addView(help_view)
            current_path = plugin.get_setting(SETTING_FONT_PATH, "")
            for item in plugin._embedded_items():
                layout.addView(plugin._build_catalog_card(context, item, current_path, None))
            return layout

        def bind(view, item, divider, adapter, list_view):
            return

        try:
            return SimpleSettingFactory(create, bind, is_clickable=False, is_shadow=False)
        except Exception as e:
            self.log("catalog factory: %s" % e)
            return None

    def _catalog_text_rows(self, embedded_only=True):
        rows = []
        current_path = self.get_setting(SETTING_FONT_PATH, "")
        items = self._embedded_items() if embedded_only else CATALOG
        for item in items:
            path = self._catalog_path(item)
            mark = self._t("now") if path and path == current_path else self._t("ready")
            rows.append(
                Text(
                    text=item["name"],
                    subtext="%s · %s" % (item.get("kind", ""), mark),
                    on_click=lambda _v, it=item: self._apply_catalog_item(it),
                )
            )
        return rows

    def _build_catalog_card(self, activity, item, current_path, builder, force_download_badge=True):
        path = self._catalog_path(item)
        ready = self._catalog_ready(item)
        is_current = bool(path) and path == current_path and _safe_bool(self.get_setting(SETTING_ENABLED, False))
        fid = item.get("id", "")

        card = LinearLayout(activity)
        card.setOrientation(LinearLayout.VERTICAL)
        card.setPadding(AndroidUtilities.dp(14), AndroidUtilities.dp(12), AndroidUtilities.dp(14), AndroidUtilities.dp(12))
        card.setTag(PREVIEW_TAG)
        card.setClickable(True)
        bg_key = Theme.key_windowBackgroundGray if is_current else Theme.key_windowBackgroundWhite
        card.setBackground(Theme.createRoundRectDrawable(AndroidUtilities.dp(14), Theme.getColor(bg_key)))

        top = LinearLayout(activity)
        top.setOrientation(LinearLayout.HORIZONTAL)
        top.setTag(PREVIEW_TAG)
        title = TextView(activity)
        title.setText(item.get("name", "font"))
        title.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText))
        title.setTextSize(16)
        title.setTag(PREVIEW_TAG)
        badge = TextView(activity)
        if is_current:
            badge.setText(self._t("now"))
            badge.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlueText))
        elif fid in self._downloading_ids:
            badge.setText(self._t("loading"))
            badge.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlueText))
        elif force_download_badge and not is_current:
            # UX: always show "скачать" so the loading animation can play on tap
            badge.setText(self._t("download"))
            badge.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlueText))
        elif ready:
            badge.setText(self._t("ready"))
            badge.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText2))
        else:
            badge.setText(self._t("download"))
            badge.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlueText))
        badge.setTextSize(12)
        badge.setTag(PREVIEW_TAG)
        badge.setPadding(AndroidUtilities.dp(8), 0, 0, 0)
        top.addView(title, LinearLayout.LayoutParams(0, -2, 1))
        top.addView(badge)
        card.addView(top)

        progress = ProgressBar(activity)
        try:
            progress.setIndeterminate(True)
        except Exception:
            pass
        progress.setTag(PREVIEW_TAG)
        lp_prog = LinearLayout.LayoutParams(-1, AndroidUtilities.dp(3))
        lp_prog.topMargin = AndroidUtilities.dp(6)
        progress.setLayoutParams(lp_prog)
        progress.setVisibility(0 if fid in self._downloading_ids else 8)
        card.addView(progress)

        sample = TextView(activity)
        sample.setText(self._preview_text())
        sample.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText))
        sample.setTextSize(18)
        sample.setPadding(0, AndroidUtilities.dp(6), 0, 0)
        sample.setTag(PREVIEW_TAG)
        # Real typeface as soon as file is on disk (silent preload)
        if ready:
            face = self._get_preview_typeface(path)
            if face is not None:
                try:
                    sample.setTypeface(face)
                    title.setTypeface(face)
                except Exception:
                    pass
        card.addView(sample)
        card.setOnClickListener(OnClickListener(lambda _v, it=item, b=builder: self._apply_catalog_item(it, b)))

        self._catalog_view_refs[fid] = {
            "title": title,
            "sample": sample,
            "badge": badge,
            "progress": progress,
            "card": card,
            "item": item,
            "path": path,
        }

        wrap = LinearLayout(activity)
        wrap.setOrientation(LinearLayout.VERTICAL)
        wrap.setTag(PREVIEW_TAG)
        wrap.setPadding(0, 0, 0, AndroidUtilities.dp(8))
        wrap.addView(card)
        return wrap

    def _set_card_loading(self, fid, loading):
        refs = self._catalog_view_refs.get(fid) or {}
        badge = refs.get("badge")
        progress = refs.get("progress")

        def ui():
            try:
                if badge is not None and loading:
                    badge.setText(self._t("loading"))
                    badge.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlueText))
                if progress is not None:
                    progress.setVisibility(0 if loading else 8)
            except Exception:
                pass

        run_on_ui_thread(ui)

    def _apply_preview_to_card(self, fid, path, name, mark_ready=False):
        refs = self._catalog_view_refs.get(fid) or {}
        title = refs.get("title")
        sample = refs.get("sample")
        badge = refs.get("badge")
        progress = refs.get("progress")
        face = self._get_preview_typeface(path)

        def ui():
            try:
                if face is not None:
                    if sample is not None:
                        sample.setTypeface(face)
                    if title is not None:
                        title.setTypeface(face)
                if progress is not None:
                    progress.setVisibility(8)
                if badge is not None and mark_ready:
                    current_path = self.get_setting(SETTING_FONT_PATH, "")
                    if path and path == current_path and _safe_bool(self.get_setting(SETTING_ENABLED, False)):
                        badge.setText(self._t("now"))
                        badge.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlueText))
                    else:
                        # keep "скачать" look unless fully applied this session
                        badge.setText(self._t("download"))
                        badge.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlueText))
            except Exception as e:
                self.log("preview apply ui: %s" % e)

        run_on_ui_thread(ui)

    def _preload_catalog_previews(self, items):
        """Silently download missing fonts for typeface preview; badge stays on «скачать»."""
        pending = []
        for item in items:
            fid = item.get("id", "")
            if not fid:
                continue
            if self._catalog_ready(item):
                path = self._catalog_path(item)
                self._apply_preview_to_card(fid, path, item.get("name", ""), mark_ready=False)
            else:
                pending.append(item)

        def worker(queue=pending):
            for it in queue:
                font_id = it.get("id", "")
                if not font_id or font_id in self._downloading_ids:
                    continue
                try:
                    # silent: no loading badge during background cache fill
                    path = self._download_google_font(it)
                    if path:
                        self._apply_preview_to_card(font_id, path, it.get("name", ""), mark_ready=False)
                except Exception as e:
                    self.log("preload %s: %s" % (font_id, e))

        if pending:
            run_on_queue(worker)

    def _apply_catalog_item(self, item, builder=None):
        fid = item.get("id", "")
        refs = self._catalog_view_refs.get(fid) or {}
        card = refs.get("card")
        # Wave slightly delayed so it lands with the apply moment
        def delayed_wave():
            self._trigger_screen_ripple(card, 1.2)
        try:
            from android.os import Handler, Looper
            Handler(Looper.getMainLooper()).postDelayed(delayed_wave, 200)
        except Exception:
            run_on_ui_thread(delayed_wave)
        run_on_queue(lambda it=item, b=builder: self._apply_catalog_item_bg(it, b))

    def _apply_catalog_item_bg(self, item, builder):
        fid = item.get("id", "")
        refs = self._catalog_view_refs.get(fid) or {}
        card = refs.get("card")
        try:
            need_net = not self._catalog_ready(item)
            if need_net:
                self._downloading_ids.add(fid)
                self._set_card_loading(fid, True)
            path = self._ensure_catalog_font(item)
            if not path:
                self._set_card_loading(fid, False)
                BulletinHelper.show_error(self._t("download_fail"))
                return
            self._apply_preview_to_card(fid, path, item.get("name", ""), mark_ready=True)
            self._activate_font_path(path, item.get("name", "font"), reload_settings=True)
            BulletinHelper.show_success("%s: %s" % (self._t("applied"), item.get("name", "")))
            if builder is not None:
                try:
                    run_on_ui_thread(lambda: builder.dismiss())
                except Exception:
                    pass
        except Exception as e:
            self.log("catalog apply: %s" % e)
            self._set_card_loading(fid, False)
            BulletinHelper.show_error(self._t("import_fail"))
        finally:
            self._downloading_ids.discard(fid)

    def _ensure_catalog_font(self, item):
        path = self._catalog_path(item)
        if self._catalog_ready(item):
            return path
        if item.get("source") == "embed":
            self._install_embedded_fonts()
            if self._catalog_ready(item):
                return path
            return ""
        # Progress is shown on the card itself (wave bar + "loading")
        return self._download_google_font(item)

    def _download_google_font(self, item):
        family = item.get("gf") or item.get("name")
        path = self._catalog_path(item)
        if not family or not path:
            return ""
        css_url = "https://fonts.googleapis.com/css2?family=%s:wght@400&display=swap" % family.replace(" ", "+")
        try:
            css = self._http_get(css_url, GOOGLE_CSS_UA)
            text = css.decode("utf-8", "replace") if isinstance(css, (bytes, bytearray)) else _safe_str(css)
            urls = re.findall(r"url\((https://[^)]+)\)", text)
            file_url = ""
            for url in urls:
                clean = url.strip().strip("\"'")
                if ".ttf" in clean or ".otf" in clean:
                    file_url = clean
                    break
            if not file_url and urls:
                file_url = urls[0].strip().strip("\"'")
            if not file_url:
                raise RuntimeError("no font url in css")
            data = self._http_get(file_url, GOOGLE_CSS_UA)
            if not data or len(data) < 1024:
                raise RuntimeError("empty font")
            if data[:4] not in (b"\x00\x01\x00\x00", b"OTTO", b"ttcf"):
                raise RuntimeError("not a ttf")
            tmp = path + ".tmp"
            with open(tmp, "wb") as handle:
                handle.write(data)
                handle.flush()
            os.replace(tmp, path)
            self._preview_cache.pop(path, None)
            return path
        except Exception as e:
            self.log("google font %s: %s" % (family, e))
            return ""

    def _http_get(self, url, user_agent):
        try:
            conn = URL(url).openConnection()
            conn.setRequestProperty("User-Agent", user_agent)
            conn.setConnectTimeout(15000)
            conn.setReadTimeout(20000)
            stream = conn.getInputStream()
            out = ByteArrayOutputStream()
            buf = bytearray(8192)
            while True:
                n = stream.read(buf)
                if n == -1:
                    break
                out.write(buf, 0, n)
            try:
                stream.close()
            except Exception:
                pass
            return bytes(out.toByteArray())
        except Exception:
            try:
                import requests

                response = requests.get(url, headers={"User-Agent": user_agent}, timeout=20)
                response.raise_for_status()
                return response.content
            except Exception as e:
                raise e

    def _on_open_google_click(self, _view=None):
        self._show_google_catalog_dialog()

    def _make_filter_tab(self, activity, text, selected, on_click):
        """Horizontal pill like Telegram chat folders / FilterTabsView."""
        tab = TextView(activity)
        tab.setText(text)
        tab.setTextSize(14)
        tab.setGravity(16)  # CENTER_VERTICAL
        tab.setPadding(
            AndroidUtilities.dp(14),
            AndroidUtilities.dp(7),
            AndroidUtilities.dp(14),
            AndroidUtilities.dp(7),
        )
        tab.setSingleLine(True)
        tab.setTag(PREVIEW_TAG)
        tab.setClickable(True)
        if selected:
            try:
                tab.setBackground(
                    Theme.createRoundRectDrawable(
                        AndroidUtilities.dp(16),
                        Theme.getColor(Theme.key_featuredStickers_addButton),
                    )
                )
            except Exception:
                tab.setBackground(
                    Theme.createRoundRectDrawable(
                        AndroidUtilities.dp(16),
                        Theme.getColor(Theme.key_windowBackgroundWhiteBlueButton),
                    )
                )
            try:
                tab.setTextColor(Theme.getColor(Theme.key_featuredStickers_buttonText))
            except Exception:
                tab.setTextColor(0xFFFFFFFF)
        else:
            try:
                tab.setBackground(
                    Theme.createRoundRectDrawable(
                        AndroidUtilities.dp(16),
                        Theme.getColor(Theme.key_windowBackgroundGray),
                    )
                )
            except Exception:
                tab.setBackground(
                    Theme.createRoundRectDrawable(
                        AndroidUtilities.dp(16),
                        Theme.getColor(Theme.key_windowBackgroundWhite),
                    )
                )
            tab.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText2))
        # Ripple
        try:
            from android.graphics.drawable import RippleDrawable
            from android.content.res import ColorStateList
            # soft press feedback via scale
            pass
        except Exception:
            pass
        tab.setOnClickListener(OnClickListener(lambda _v: on_click()))
        # Press scale like Cashier
        try:
            from android.view import MotionEvent as ME

            class _LS:
                def onTouch(self, view, event):
                    a = event.getAction()
                    if a == 0:  # DOWN
                        try:
                            view.animate().scaleX(0.94).scaleY(0.94).setDuration(80).start()
                        except Exception:
                            pass
                    elif a in (1, 3):  # UP CANCEL
                        try:
                            view.animate().scaleX(1.0).scaleY(1.0).setDuration(160).start()
                        except Exception:
                            pass
                    return False

            # Use OnClickListener only; scale on click below
        except Exception:
            pass
        return tab

    def _resolve_launch_activity(self):
        try:
            return jclass("org.telegram.ui.LaunchActivity")
        except Exception:
            try:
                return jclass("org.telegram.messenger.LaunchActivity")
            except Exception as e:
                self.log("LaunchActivity: %s" % e)
                return None

    def _trigger_screen_ripple(self, view, intensity=1.0):
        """Same wave as Cashier: LaunchActivity.makeRipple + haptic."""
        def _do():
            try:
                if view is not None:
                    coords = view.getLocationOnScreen()
                    w = float(view.getWidth() or 0)
                    h = float(view.getHeight() or 0)
                    if coords is not None and len(coords) >= 2:
                        x = float(coords[0]) + w / 2.0
                        y = float(coords[1]) + h / 2.0
                    else:
                        x = w / 2.0
                        y = h / 2.0
                    launch = self._resolve_launch_activity()
                    if launch is not None:
                        launch.makeRipple(x, y, float(intensity))
            except Exception as e:
                self.log("ripple: %s" % e)
            try:
                if view is not None:
                    view.performHapticFeedback(HapticFeedbackConstants.KEYBOARD_TAP)
            except Exception:
                pass
            # local scale pulse so something is always visible even without makeRipple
            try:
                if view is not None:
                    w = view.getWidth()
                    h = view.getHeight()
                    if w:
                        view.setPivotX(w / 2.0)
                    if h:
                        view.setPivotY(h / 2.0)
                    view.animate().cancel()
                    view.animate().scaleX(0.92).scaleY(0.92).alpha(0.75).setDuration(90).start()

                    def bounce():
                        try:
                            view.animate().cancel()
                            view.animate().scaleX(1.0).scaleY(1.0).alpha(1.0).setDuration(280).setInterpolator(
                                OvershootInterpolator(1.45)
                            ).start()
                        except Exception:
                            try:
                                view.setScaleX(1.0)
                                view.setScaleY(1.0)
                                view.setAlpha(1.0)
                            except Exception:
                                pass

                    from android.os import Handler, Looper
                    Handler(Looper.getMainLooper()).postDelayed(bounce, 95)
            except Exception:
                pass

        run_on_ui_thread(_do)

    def _play_apply_wave(self, view):
        self._trigger_screen_ripple(view, 1.15)

    def _soft_haptic(self, view):
        """Folder switch: vibration only, ~1/3 of apply intensity, no screen wave."""
        def _do():
            try:
                if view is not None:
                    # lighter haptic than KEYBOARD_TAP when possible
                    try:
                        view.performHapticFeedback(HapticFeedbackConstants.CLOCK_TICK)
                    except Exception:
                        view.performHapticFeedback(HapticFeedbackConstants.KEYBOARD_TAP)
            except Exception:
                pass
            # very subtle local scale, no makeRipple
            try:
                if view is not None:
                    view.animate().cancel()
                    view.animate().scaleX(0.97).scaleY(0.97).setDuration(70).start()
                    def back():
                        try:
                            view.animate().scaleX(1.0).scaleY(1.0).setDuration(120).start()
                        except Exception:
                            pass
                    from android.os import Handler, Looper
                    Handler(Looper.getMainLooper()).postDelayed(back, 75)
            except Exception:
                pass
        run_on_ui_thread(_do)


    def _show_google_catalog_dialog(self):
        fragment = get_last_fragment()
        activity = fragment.getParentActivity() if fragment else None
        if activity is None:
            BulletinHelper.show_error(self._t("no_screen"))
            return
        self._catalog_view_refs = {}

        builder = AlertDialogBuilder(activity)
        root = LinearLayout(activity)
        root.setOrientation(LinearLayout.VERTICAL)
        pad = AndroidUtilities.dp(12)
        root.setPadding(pad, pad, pad, pad)

        help_view = TextView(activity)
        help_view.setText(self._t("google_help"))
        help_view.setTextColor(Theme.getColor(Theme.key_dialogTextGray3))
        help_view.setTag(PREVIEW_TAG)
        help_view.setPadding(AndroidUtilities.dp(4), 0, AndroidUtilities.dp(4), AndroidUtilities.dp(10))
        root.addView(help_view)

        items = self._google_items()
        ru_items = [x for x in items if x.get("locale") == "ru"]
        en_items = [x for x in items if x.get("locale") != "ru"]
        current_path = self.get_setting(SETTING_FONT_PATH, "")
        state = {"tab": "ru"}  # default Russian

        # Horizontal filter tabs (TG folders style)
        tabs_scroll = HorizontalScrollView(activity)
        tabs_scroll.setHorizontalScrollBarEnabled(False)
        tabs_scroll.setTag(PREVIEW_TAG)
        tabs_row = LinearLayout(activity)
        tabs_row.setOrientation(LinearLayout.HORIZONTAL)
        tabs_row.setTag(PREVIEW_TAG)
        tabs_row.setPadding(AndroidUtilities.dp(2), 0, AndroidUtilities.dp(2), AndroidUtilities.dp(10))
        tabs_scroll.addView(tabs_row)
        root.addView(tabs_scroll)

        list_host = LinearLayout(activity)
        list_host.setOrientation(LinearLayout.VERTICAL)
        list_host.setTag(PREVIEW_TAG)
        root.addView(list_host)

        tab_views = {}

        def rebuild_tabs():
            try:
                tabs_row.removeAllViews()
            except Exception:
                return
            specs = [
                ("ru", "%s  %s" % (self._t("folder_ru"), len(ru_items))),
                ("en", "%s  %s" % (self._t("folder_en"), len(en_items))),
                ("all", "%s  %s" % (self._t("folder_all"), len(items))),
            ]
            for key, label in specs:
                selected = state["tab"] == key
                tab = self._make_filter_tab(activity, label, selected, lambda k=key: select_tab(k))
                tab_views[key] = tab
                lp = LinearLayout.LayoutParams(-2, -2)
                lp.rightMargin = AndroidUtilities.dp(8)
                tabs_row.addView(tab, lp)

        def rebuild_list():
            try:
                list_host.removeAllViews()
            except Exception:
                return
            if state["tab"] == "ru":
                shown = ru_items
            elif state["tab"] == "en":
                shown = en_items
            else:
                shown = items
            for item in shown:
                list_host.addView(
                    self._build_catalog_card(activity, item, current_path, builder, force_download_badge=True)
                )
            run_on_queue(lambda lst=list(shown): self._preload_catalog_previews(lst))

        def select_tab(key):
            if state["tab"] == key:
                self._soft_haptic(tab_views.get(key))
                return
            order = ["ru", "en", "all"]
            try:
                old_i = order.index(state["tab"])
                new_i = order.index(key)
            except Exception:
                old_i, new_i = 0, 1
            forward = new_i > old_i
            state["tab"] = key
            rebuild_tabs()
            # TG-like content transition: slide + fade
            direction = 1 if forward else -1
            dist = AndroidUtilities.dp(28)

            def after_out():
                rebuild_list()
                try:
                    list_host.setTranslationX(-direction * dist)
                    list_host.setAlpha(0.0)
                    list_host.animate().cancel()
                    list_host.animate().translationX(0).alpha(1.0).setDuration(220).setInterpolator(
                        DecelerateInterpolator()
                    ).start()
                except Exception:
                    pass

            try:
                list_host.animate().cancel()
                list_host.animate().translationX(direction * dist).alpha(0.0).setDuration(140).setInterpolator(
                    DecelerateInterpolator()
                ).start()
                from android.os import Handler, Looper
                Handler(Looper.getMainLooper()).postDelayed(after_out, 150)
            except Exception:
                after_out()
            self._soft_haptic(tab_views.get(key))

        rebuild_tabs()
        rebuild_list()

        scroll = ScrollView(activity)
        scroll.addView(root)
        builder.set_title(self._t("google_title"))
        builder.set_view(scroll)
        builder.set_negative_button(self._t("close"), lambda b, _w: b.dismiss())
        builder.show()

    def _on_open_recents_click(self, _view=None):
        recents = self._get_recents()
        fragment = get_last_fragment()
        activity = fragment.getParentActivity() if fragment else None
        if activity is None:
            BulletinHelper.show_error(self._t("no_screen"))
            return
        if not recents:
            BulletinHelper.show_info(self._t("recents_empty"))
            return
        labels = [item.get("name", "font") for item in recents]
        builder = AlertDialogBuilder(activity)
        builder.set_title(self._t("recents"))
        builder.set_items(
            labels,
            lambda b, which, items=recents, bb=builder: self._apply_recent_index(which, items, bb),
        )
        builder.set_negative_button(self._t("close"), lambda b, _w: b.dismiss())
        builder.show()

    def _apply_recent_index(self, which, items, builder):
        try:
            builder.dismiss()
        except Exception:
            pass
        if which < 0 or which >= len(items):
            return
        item = items[which]
        self._apply_recent(item.get("path", ""), item.get("name", "font"))

    def create_settings(self):
        try:
            return self._build_settings()
        except Exception as e:
            self.log("create_settings error: %s" % e)
            return [
                Header(text="Global Font"),
                Switch(key=SETTING_ENABLED, text="Enable", default=False, on_change=self._on_enabled_changed),
                Text(text="Pick a font", accent=True, on_click=self._on_pick_font_click),
                Divider(text=_safe_str(e)),
            ]

    def _build_settings(self):
        current_path = self.get_setting(SETTING_FONT_PATH, "")
        favorites_count = self._get_favorites_count_quick()
        google_count = len([x for x in CATALOG if x.get("source") == "google"])

        settings = [Header(text=self._t("header"))]

        factory = self._make_preview_factory()
        if factory is not None:
            try:
                settings.append(Custom(factory=factory.instance.java))
            except Exception as e:
                self.log("custom preview: %s" % e)

        settings.append(
            Switch(
                key=SETTING_ENABLED,
                text=self._t("enable"),
                default=False,
                subtext=self._t("enable_sub"),
                icon="msg_settings",
                on_change=self._on_enabled_changed,
            )
        )

        # === M3 primary actions ===
        settings.append(Divider(text=self._t("catalog")))
        settings.append(
            Text(
                text=self._t("google"),
                subtext="%s · %s" % (google_count, self._t("google_help")),
                accent=True,
                icon="msg_mini_more",
                on_click=self._on_open_google_click,
            )
        )
        settings.append(
            Text(
                text=self._t("pick"),
                subtext=self._t("actions"),
                icon="msg_media",
                on_click=self._on_pick_font_click,
            )
        )

        # Favorites / recents row-like group
        settings.append(Divider(text=self._t("open_fav")))
        settings.append(
            Text(
                text=self._t("open_fav"),
                subtext=str(favorites_count),
                icon="msg_folders",
                on_click=self._on_open_favorites_click,
            )
        )
        settings.append(
            Text(
                text=self._t("add_fav"),
                icon="msg_add",
                on_click=self._on_add_favorite_click,
            )
        )
        if current_path:
            settings.append(
                Text(
                    text=self._t("save_current"),
                    on_click=self._on_save_current_to_favorites_click,
                )
            )
        recents = self._get_recents()
        if recents:
            settings.append(
                Text(
                    text=self._t("recents"),
                    subtext=str(len(recents)),
                    icon="msg_recent",
                    on_click=self._on_open_recents_click,
                )
            )

        # Scopes — two logical groups (row 1 / row 2 feel)
        settings.append(Divider(text=self._t("scopes")))
        settings.append(
            Switch(
                key=SETTING_APPLY_INTERFACE,
                text=self._t("interface"),
                default=True,
                subtext=self._t("interface_sub"),
                on_change=self._on_scope_changed,
            )
        )
        settings.append(
            Switch(
                key=SETTING_APPLY_MESSAGES,
                text=self._t("messages"),
                default=True,
                subtext=self._t("messages_sub"),
                on_change=self._on_scope_changed,
            )
        )
        settings.append(Divider())
        settings.append(
            Switch(
                key=SETTING_APPLY_STYLED,
                text=self._t("styled"),
                default=True,
                subtext=self._t("styled_sub"),
                on_change=self._on_scope_changed,
            )
        )

        if HAS_RICH_SETTINGS:
            settings.append(Divider(text=self._t("more")))
            settings.append(
                Selector(
                    key=SETTING_LANG,
                    text=self._t("language"),
                    default=0,
                    items=["Русский", "English"],
                    on_change=self._on_lang_changed,
                )
            )
            settings.append(
                Input(
                    key=SETTING_PREVIEW,
                    text=self._t("preview_text"),
                    default=PREVIEW_SAMPLE,
                )
            )

        core_line = "%s: %s" % (self._t("core"), self._core_status)
        if self._core_error:
            core_line = "%s (%s)" % (core_line, self._core_error)
        settings.append(Divider(text=core_line))
        settings.append(Text(text=self._t("reload_core"), on_click=self._on_reload_core_click))
        settings.append(Text(text=self._t("reset"), red=True, on_click=self._on_reset_font_click))
        settings.append(Divider(text="v%s · %s" % (__version__, self._t("notify"))))
        try:
            from org.telegram.messenger.browser import Browser

            settings.append(Divider())
            settings.append(
                Text(
                    text="@JavaScript_XD",
                    subtext="https://t.me/plugin_XD",
                    icon="msg_channel",
                    accent=True,
                    on_click=lambda _view: Browser.openUrl(
                        get_last_fragment().getParentActivity(),
                        "https://t.me/plugin_XD",
                    ),
                )
            )
        except Exception:
            settings.append(Divider())
            settings.append(Text(text="@JavaScript_XD", subtext="https://t.me/plugin_XD", accent=True))
        return settings


    def _create_scopes_page(self):
        return [
            Header(text=self._t("scopes")),
            Switch(
                key=SETTING_APPLY_INTERFACE,
                text=self._t("interface"),
                default=True,
                subtext=self._t("interface_sub"),
                on_change=self._on_scope_changed,
            ),
            Switch(
                key=SETTING_APPLY_STYLED,
                text=self._t("styled"),
                default=True,
                subtext=self._t("styled_sub"),
                on_change=self._on_scope_changed,
            ),
            Switch(
                key=SETTING_APPLY_MESSAGES,
                text=self._t("messages"),
                default=True,
                subtext=self._t("messages_sub"),
                on_change=self._on_scope_changed,
            ),
        ]

    def _create_favorites_page(self):
        items = [Header(text=self._t("open_fav"))]
        if HAS_RICH_SETTINGS:
            items.append(
                Input(
                    key=SETTING_FAV_QUERY,
                    text=self._t("search"),
                    default="",
                    on_change=self._on_fav_query_changed,
                )
            )
        items.append(Text(text=self._t("add_fav"), accent=True, on_click=self._on_add_favorite_click))
        items.append(Text(text=self._t("open_fav_gallery"), on_click=self._on_open_favorites_click))
        query = _safe_str(self.get_setting(SETTING_FAV_QUERY, "")).lower().strip()
        favorites = self._get_favorites()
        shown = 0
        for favorite in favorites:
            name = favorite.get("name", "font")
            if query and query not in name.lower():
                continue
            path = self._favorite_path(favorite.get("file"))
            items.append(
                Text(
                    text=name,
                    subtext=self._t("tap_apply"),
                    on_click=lambda _v, p=path, n=name: self._apply_favorite_from_dialog(p, n, None),
                    on_long_click=lambda _v, f=favorite: self._remove_favorite_from_dialog(f, None),
                )
            )
            shown += 1
        if shown == 0:
            items.append(Divider(text=self._t("fav_empty")))
        return items

    def _create_recents_page(self):
        items = [Header(text=self._t("recents"))]
        recents = self._get_recents()
        if not recents:
            items.append(Divider(text=self._t("recents_empty")))
            return items
        for item in recents:
            name = item.get("name", "font")
            path = item.get("path", "")
            items.append(
                Text(
                    text=name,
                    subtext=self._t("tap_apply"),
                    on_click=lambda _v, p=path, n=name: self._apply_recent(p, n),
                )
            )
        return items

    def _create_advanced_page(self):
        items = [
            Header(text=self._t("advanced")),
            Divider(text="%s: %s" % (self._t("core"), self._core_status)),
        ]
        if self._core_error:
            items.append(Divider(text=self._core_error))
        if self._dex_sha:
            items.append(Divider(text="SHA-256 %s…" % self._dex_sha[:16]))
        if self._dex_loader_kind:
            items.append(Divider(text="loader %s" % self._dex_loader_kind))
        items.append(Text(text=self._t("reload_core"), on_click=self._on_reload_core_click))
        if HAS_RICH_SETTINGS:
            items.append(
                Input(
                    key=SETTING_PREVIEW,
                    text=self._t("preview_text"),
                    default=PREVIEW_SAMPLE,
                )
            )
        items.append(Divider(text="v%s · FontCore DEX v3" % __version__))
        items.append(Divider(text=self._t("notify")))
        return items

    def _on_fav_query_changed(self, _new_value):
        try:
            self.set_setting(SETTING_FAV_QUERY, _safe_str(_new_value), reload_settings=True)
        except Exception:
            pass

    def _on_lang_changed(self, _new_index):
        self.set_setting(SETTING_LANG, _safe_int(_new_index, 0), reload_settings=True)

    def _on_reload_core_click(self, _view=None):
        try:
            self._core_stop()
            self._load_dex_core()
            self._reload_font_state()
            self.set_setting(SETTING_ENABLED, _safe_bool(self.get_setting(SETTING_ENABLED, False)), reload_settings=True)
            BulletinHelper.show_success(self._t("core_reload_ok"))
        except Exception as e:
            self.log("reload core: %s" % e)
            BulletinHelper.show_error(self._t("core_reload_fail"))

    def _on_enabled_changed(self, new_value):
        if new_value:
            path = self.get_setting(SETTING_FONT_PATH, "")
            if not path or not os.path.exists(path):
                self._ensure_default_font()
            if not self._reload_font_state():
                self.set_setting(SETTING_ENABLED, False, reload_settings=True)
                BulletinHelper.show_error(self._t("need_font"))
                return
            BulletinHelper.show_success(self._t("enabled_ok"))
        else:
            self._core_configure(False)
            BulletinHelper.show_info(self._t("disabled_restart"))
        self._refresh_visible_ui()

    def _on_scope_changed(self, _new_value):
        enabled = _safe_bool(self.get_setting(SETTING_ENABLED, False))
        self._core_configure(enabled)
        self._refresh_visible_ui()

    def _on_pick_font_click(self, _view=None):
        self._open_font_picker(PICKER_MODE_APPLY)

    def _on_add_favorite_click(self, _view=None):
        self._open_font_picker(PICKER_MODE_FAVORITE)

    def _on_open_favorites_click(self, _view=None):
        self._show_favorites_dialog()

    def _on_save_current_to_favorites_click(self, _view=None):
        current_path = self.get_setting(SETTING_FONT_PATH, "")
        current_name = self.get_setting(SETTING_FONT_NAME, "")
        if not current_path or not os.path.exists(current_path):
            BulletinHelper.show_error(self._t("need_font"))
            return
        if self._is_favorite_path(current_path):
            BulletinHelper.show_info(self._t("fav_dup"))
            return
        try:
            favorite = self._copy_existing_font_to_favorites(current_path, current_name or os.path.basename(current_path))
            BulletinHelper.show_success("%s: %s" % (self._t("fav_added"), favorite["name"]))
        except Exception as e:
            self.log("save current favorite error: %s" % e)
            BulletinHelper.show_error(self._t("import_fail"))

    def _on_reset_font_click(self, _view=None):
        fragment = get_last_fragment()
        activity = fragment.getParentActivity() if fragment else None
        if activity is None:
            self._clear_current_selection(reload_settings=True)
            BulletinHelper.show_info(self._t("reset_restart"))
            self._refresh_visible_ui()
            return
        builder = AlertDialogBuilder(activity)
        builder.set_title(self._t("reset"))
        builder.set_message(self._t("confirm_reset"))
        builder.set_positive_button(self._t("yes"), lambda b, _w: self._confirm_reset(b))
        builder.set_negative_button(self._t("cancel"), lambda b, _w: b.dismiss())
        builder.make_button_red(AlertDialogBuilder.BUTTON_POSITIVE) if hasattr(AlertDialogBuilder, "BUTTON_POSITIVE") else None
        builder.show()

    def _confirm_reset(self, builder):
        try:
            builder.dismiss()
        except Exception:
            pass
        self._clear_current_selection(reload_settings=True)
        BulletinHelper.show_info(self._t("reset_restart"))
        self._refresh_visible_ui()

    def _ensure_plugin_dir(self):
        try:
            base_dir = ApplicationLoader.getFilesDirFixed()
            if base_dir:
                folder = File(base_dir, __id__)
            else:
                folder = File(ApplicationLoader.applicationContext.getFilesDir(), __id__)
            if not folder.exists():
                folder.mkdirs()
            self._plugin_dir_path = folder.getAbsolutePath()
            self._favorites_dir_path = os.path.join(self._plugin_dir_path, FAVORITES_DIR_NAME)
            self._recents_dir_path = os.path.join(self._plugin_dir_path, RECENTS_DIR_NAME)
            self._bundled_dir_path = os.path.join(self._plugin_dir_path, BUNDLED_DIR_NAME)
            for path in (self._favorites_dir_path, self._recents_dir_path, self._bundled_dir_path):
                if path and not os.path.exists(path):
                    os.makedirs(path)
        except Exception as e:
            self.log("dir error: %s" % e)
            self._plugin_dir_path = ""
            self._favorites_dir_path = ""
            self._recents_dir_path = ""
            self._bundled_dir_path = ""

    def _open_font_picker(self, mode):
        fragment = get_last_fragment()
        if not fragment:
            BulletinHelper.show_error(self._t("no_screen"))
            return
        activity = fragment.getParentActivity()
        if not activity:
            BulletinHelper.show_error(self._t("no_activity"))
            return
        self._picker_mode = mode
        self._install_activity_hook(activity)
        try:
            intent = Intent(Intent.ACTION_OPEN_DOCUMENT)
            intent.addCategory(Intent.CATEGORY_OPENABLE)
            intent.addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)
            intent.setType("*/*")
            chooser_title = self._t("add_fav") if mode == PICKER_MODE_FAVORITE else self._t("pick")
            activity.startActivityForResult(Intent.createChooser(intent, chooser_title), FONT_PICKER_REQUEST_CODE)
        except Exception as e:
            self.log("picker error: %s" % e)
            self._picker_mode = PICKER_MODE_APPLY
            self._clear_activity_hook()
            BulletinHelper.show_error(self._t("pick_error"))

    def _install_activity_hook(self, activity):
        self._clear_activity_hook()
        try:
            integer_type = find_class("java.lang.Integer").TYPE
            method = activity.getClass().getDeclaredMethod("onActivityResult", integer_type, integer_type, Intent)
            method.setAccessible(True)
            self._activity_hook = self.hook_method(method, Plugin.ActivityResultHook(self))
        except Exception as e:
            self.log("activity hook error: %s" % e)
            self._activity_hook = None

    def _clear_activity_hook(self):
        if self._activity_hook:
            try:
                self.unhook_method(self._activity_hook)
            except Exception:
                pass
            self._activity_hook = None

    def _handle_picked_font_uri(self, uri):
        if not self._plugin_dir_path:
            BulletinHelper.show_error(self._t("import_fail"))
            return
        display_name = self._query_display_name(uri)
        if not display_name:
            display_name = self._fallback_display_name(uri)
        extension = self._extract_supported_extension(display_name)
        if not extension:
            BulletinHelper.show_error(self._t("bad_ext"))
            return
        try:
            if self._picker_mode == PICKER_MODE_FAVORITE:
                favorite = self._import_favorite_from_uri(uri, display_name, extension)
                BulletinHelper.show_success("%s: %s" % (self._t("fav_added"), favorite["name"]))
                return
            target_path = os.path.join(self._plugin_dir_path, "selected_font%s" % extension)
            self._copy_uri_to_file(uri, target_path)
            self._activate_font_path(target_path, display_name, reload_settings=True)
            BulletinHelper.show_success("%s: %s" % (self._t("applied"), display_name))
        except Exception as e:
            self.log("font import error: %s" % e)
            BulletinHelper.show_error(self._t("import_fail"))

    def _query_display_name(self, uri):
        resolver = ApplicationLoader.applicationContext.getContentResolver()
        cursor = None
        try:
            cursor = resolver.query(uri, None, None, None, None)
            if cursor is not None and cursor.moveToFirst():
                name_index = cursor.getColumnIndex(OpenableColumns.DISPLAY_NAME)
                if name_index != -1:
                    name = cursor.getString(name_index)
                    return self._sanitize_filename(name)
        except Exception:
            return ""
        finally:
            if cursor is not None:
                try:
                    cursor.close()
                except Exception:
                    pass
        return ""

    def _fallback_display_name(self, uri):
        raw = ""
        try:
            raw = _safe_str(uri.getLastPathSegment())
        except Exception:
            raw = ""
        if not raw:
            raw = "selected_font.ttf"
        return self._sanitize_filename(raw)

    def _sanitize_filename(self, name):
        cleaned = _safe_str(name).strip()
        cleaned = cleaned.replace("\\", "_").replace("/", "_").replace(":", "_")
        cleaned = re.sub(r"\s+", " ", cleaned)
        cleaned = re.sub(r"[^0-9A-Za-zА-Яа-я._ ()-]", "_", cleaned)
        if not cleaned:
            cleaned = "selected_font.ttf"
        return cleaned

    def _extract_supported_extension(self, name):
        extension = os.path.splitext(_safe_str(name))[1].lower()
        if extension in SUPPORTED_EXTENSIONS:
            return extension
        return ""

    def _copy_uri_to_file(self, uri, target_path):
        resolver = ApplicationLoader.applicationContext.getContentResolver()
        input_stream = resolver.openInputStream(uri)
        if not input_stream:
            raise RuntimeError("ContentResolver.openInputStream returned null")
        output_stream = FileOutputStream(target_path)
        try:
            buffer = bytearray(8192)
            while True:
                size = input_stream.read(buffer)
                if size == -1:
                    break
                output_stream.write(buffer, 0, size)
        finally:
            try:
                input_stream.close()
            except Exception:
                pass
            try:
                output_stream.close()
            except Exception:
                pass

    def _load_font_from_path(self, path):
        if not path or not os.path.exists(path):
            return False
        try:
            regular = Typeface.createFromFile(path)
            if regular is None:
                return False
            self._loaded_path = path
            self._font_regular = regular
            self._font_bold = Typeface.create(regular, Typeface.BOLD)
            self._font_italic = Typeface.create(regular, Typeface.ITALIC)
            self._font_bold_italic = Typeface.create(regular, Typeface.BOLD_ITALIC)
            return True
        except Exception as e:
            self.log("font load error: %s" % e)
            self._loaded_path = ""
            self._font_regular = None
            self._font_bold = None
            self._font_italic = None
            self._font_bold_italic = None
            return False

    def _activate_font_path(self, path, display_name, reload_settings=False):
        if not self._load_font_from_path(path):
            raise RuntimeError("Typeface.createFromFile returned nothing usable.")
        self.set_setting(SETTING_FONT_PATH, path)
        self.set_setting(SETTING_FONT_NAME, display_name)
        self.set_setting(SETTING_ENABLED, True, reload_settings=reload_settings)
        self._core_configure(True)
        self._push_recent(path, display_name)
        self._refresh_visible_ui()

    def _apply_recent(self, path, name):
        if not path or not os.path.exists(path):
            BulletinHelper.show_error(self._t("fav_gone"))
            return
        try:
            self._activate_font_path(path, name, reload_settings=True)
            BulletinHelper.show_success("%s: %s" % (self._t("applied"), name))
        except Exception as e:
            self.log("recent apply: %s" % e)
            BulletinHelper.show_error(self._t("import_fail"))

    def _reload_font_state(self):
        enabled = _safe_bool(self.get_setting(SETTING_ENABLED, False))
        path = self.get_setting(SETTING_FONT_PATH, "")
        if not enabled or not path or not os.path.exists(path):
            self._core_configure(False)
            return False
        if path != self._loaded_path or self._font_regular is None:
            if not self._load_font_from_path(path):
                self._core_configure(False)
                return False
        return self._core_configure(True)

    def _notify_list_adapters(self, fragment):
        if fragment is None:
            return
        for field_name in (
            "listView",
            "messagesListView",
            "chatListView",
            "recyclerListView",
            "searchListView",
            "blurredRecyclerView",
        ):
            try:
                recycler = get_private_field(fragment, field_name)
                if recycler is None:
                    continue
                adapter = recycler.getAdapter()
                if adapter is not None:
                    adapter.notifyDataSetChanged()
                recycler.invalidate()
            except Exception:
                pass

    def _refresh_visible_ui(self):
        if self._refresh_queued:
            return
        self._refresh_queued = True

        def _ui_task():
            self._refresh_queued = False
            try:
                self._core_reapply()
            except Exception:
                pass
            try:
                self._refresh_chat_preview()
            except Exception:
                pass
            fragment = get_last_fragment()
            self._notify_list_adapters(fragment)
            if fragment is None:
                return
            for field_name in (
                "actionBar",
                "avatarContainer",
                "filterTabsView",
                "filterTabsView2",
                "searchTabsView",
                "fragmentView",
                "contentView",
                "page",
            ):
                try:
                    view = get_private_field(fragment, field_name)
                    if view is not None:
                        view.invalidate()
                        try:
                            view.requestLayout()
                        except Exception:
                            pass
                except Exception:
                    pass
            try:
                from android.os import Handler, Looper
                Handler(Looper.getMainLooper()).postDelayed(lambda: self._core_reapply(), 60)
                Handler(Looper.getMainLooper()).postDelayed(lambda: self._core_reapply(), 220)
                # bubbles are re-laid out after the core has swapped the theme paints
                Handler(Looper.getMainLooper()).postDelayed(lambda: self._refresh_chat_preview(), 140)
                Handler(Looper.getMainLooper()).postDelayed(lambda: self._refresh_chat_preview(), 320)
            except Exception:
                pass

        run_on_ui_thread(_ui_task)

    def _normalize_selected_path(self):
        path = self.get_setting(SETTING_FONT_PATH, "")
        if path and not os.path.exists(path):
            self._clear_current_selection(reload_settings=False)

    def _clear_current_selection(self, reload_settings=False):
        old_path = self.get_setting(SETTING_FONT_PATH, "")
        self._loaded_path = ""
        self._font_regular = None
        self._font_bold = None
        self._font_italic = None
        self._font_bold_italic = None
        self._core_configure(False)
        self.set_setting(SETTING_FONT_PATH, "")
        self.set_setting(SETTING_FONT_NAME, "")
        self.set_setting(SETTING_ENABLED, False, reload_settings=reload_settings)
        if self._can_delete_temporary_font(old_path):
            try:
                os.remove(old_path)
            except Exception:
                pass

    def _can_delete_temporary_font(self, path):
        if not path or not self._plugin_dir_path:
            return False
        if self._is_favorite_path(path) or self._is_recent_path(path):
            return False
        try:
            normalized = os.path.abspath(path)
            selected_prefix = os.path.abspath(os.path.join(self._plugin_dir_path, "selected_font"))
            return normalized.startswith(selected_prefix)
        except Exception:
            return False

    def _favorite_storage_name(self, favorite):
        stored = _safe_str(favorite.get("file")).strip()
        if stored:
            return os.path.basename(stored)
        legacy_path = _safe_str(favorite.get("path")).strip()
        if legacy_path:
            return os.path.basename(legacy_path)
        return ""

    def _get_favorites_count_quick(self):
        raw = self.get_setting(SETTING_FAVORITES_JSON, "[]")
        try:
            parsed = json.loads(raw)
            if isinstance(parsed, list):
                return len(parsed)
        except Exception:
            pass
        return 0

    def _get_favorites(self):
        raw = self.get_setting(SETTING_FAVORITES_JSON, "[]")
        try:
            parsed = json.loads(raw)
        except Exception:
            parsed = []
        favorites = []
        dirty = False
        if not isinstance(parsed, list):
            parsed = []
            dirty = True
        for item in parsed:
            if not isinstance(item, dict):
                dirty = True
                continue
            file_name = self._favorite_storage_name(item)
            if not file_name:
                dirty = True
                continue
            path = self._favorite_path(file_name)
            if not path or not os.path.exists(path):
                dirty = True
                continue
            name = _safe_str(item.get("name")).strip() or os.path.basename(file_name)
            favorites.append({"name": name, "file": file_name})
        if dirty:
            self._save_favorites(favorites, reload_settings=False)
        return favorites

    def _save_favorites(self, favorites, reload_settings=False):
        safe_items = []
        for item in favorites:
            if not isinstance(item, dict):
                continue
            file_name = self._favorite_storage_name(item)
            if not file_name:
                continue
            safe_items.append(
                {
                    "name": _safe_str(item.get("name")).strip() or os.path.basename(file_name),
                    "file": os.path.basename(file_name),
                }
            )
        self.set_setting(SETTING_FAVORITES_JSON, json.dumps(safe_items, ensure_ascii=False), reload_settings=reload_settings)

    def _normalize_favorites(self):
        self._save_favorites(self._get_favorites(), reload_settings=False)

    def _favorite_path(self, file_name):
        if not file_name or not self._favorites_dir_path:
            return ""
        return os.path.join(self._favorites_dir_path, os.path.basename(file_name))

    def _is_recent_path(self, path):
        if not path or not self._recents_dir_path:
            return False
        try:
            normalized_path = os.path.abspath(path)
            normalized_dir = os.path.abspath(self._recents_dir_path)
            return normalized_path.startswith(normalized_dir + os.sep) or normalized_path == normalized_dir
        except Exception:
            return False

    def _get_recents(self):
        raw = self.get_setting(SETTING_RECENTS_JSON, "[]")
        try:
            parsed = json.loads(raw)
        except Exception:
            parsed = []
        if not isinstance(parsed, list):
            return []
        items = []
        for item in parsed:
            if not isinstance(item, dict):
                continue
            path = _safe_str(item.get("path"))
            if not path or not os.path.exists(path):
                continue
            items.append({"name": _safe_str(item.get("name")) or os.path.basename(path), "path": path})
        return items[:MAX_RECENTS]

    def _push_recent(self, path, name):
        if not path:
            return
        items = [x for x in self._get_recents() if x.get("path") != path]
        items.insert(0, {"name": name or os.path.basename(path), "path": path})
        items = items[:MAX_RECENTS]
        try:
            self.set_setting(SETTING_RECENTS_JSON, json.dumps(items, ensure_ascii=False))
        except Exception:
            pass

    def _build_unique_favorite_path(self, display_name, extension):
        base_name = os.path.splitext(self._sanitize_filename(display_name))[0].strip() or "favorite_font"
        base_name = re.sub(r"\s+", "_", base_name)
        stamp = int(time.time() * 1000)
        while True:
            file_name = "%s_%s%s" % (base_name, stamp, extension)
            target_path = self._favorite_path(file_name)
            if target_path and not os.path.exists(target_path):
                return file_name, target_path
            stamp += 1

    def _import_favorite_from_uri(self, uri, display_name, extension):
        file_name, target_path = self._build_unique_favorite_path(display_name, extension)
        self._copy_uri_to_file(uri, target_path)
        try:
            preview = Typeface.createFromFile(target_path)
            if preview is None:
                raise RuntimeError("invalid font")
        except Exception:
            try:
                os.remove(target_path)
            except Exception:
                pass
            raise
        favorite = {"name": display_name, "file": file_name}
        favorites = self._get_favorites()
        favorites.append(favorite)
        self._save_favorites(favorites, reload_settings=True)
        self._preview_cache.pop(target_path, None)
        return favorite

    def _copy_existing_font_to_favorites(self, source_path, display_name):
        extension = self._extract_supported_extension(source_path)
        if not extension:
            extension = ".ttf"
        file_name, target_path = self._build_unique_favorite_path(display_name, extension)
        with open(source_path, "rb") as source_file:
            data = source_file.read()
        with open(target_path, "wb") as target_file:
            target_file.write(data)
        favorite = {"name": display_name, "file": file_name}
        favorites = self._get_favorites()
        favorites.append(favorite)
        self._save_favorites(favorites, reload_settings=True)
        self._preview_cache.pop(target_path, None)
        return favorite

    def _is_favorite_path(self, path):
        if not path or not self._favorites_dir_path:
            return False
        try:
            normalized_path = os.path.abspath(path)
            normalized_dir = os.path.abspath(self._favorites_dir_path)
            return normalized_path.startswith(normalized_dir + os.sep) or normalized_path == normalized_dir
        except Exception:
            return False

    def _show_favorites_dialog(self):
        fragment = get_last_fragment()
        activity = fragment.getParentActivity() if fragment else None
        if activity is None:
            BulletinHelper.show_error(self._t("no_screen"))
            return
        favorites = self._get_favorites()
        builder = AlertDialogBuilder(activity)
        wrapper = LinearLayout(activity)
        wrapper.setOrientation(LinearLayout.VERTICAL)
        padding = AndroidUtilities.dp(16)
        wrapper.setPadding(padding, padding, padding, padding)

        search = AndroidEditText(activity)
        search.setHint(self._t("search"))
        search.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
        search.setHintTextColor(Theme.getColor(Theme.key_dialogTextGray3))
        search.setTag(PREVIEW_TAG)
        search.setSingleLine(True)
        wrapper.addView(search)

        list_host = LinearLayout(activity)
        list_host.setOrientation(LinearLayout.VERTICAL)
        list_host.setTag(PREVIEW_TAG)
        wrapper.addView(list_host)

        def rebuild(_editable=None):
            try:
                list_host.removeAllViews()
            except Exception:
                return
            query = _safe_str(search.getText()).lower().strip()
            shown = 0
            current_path = self.get_setting(SETTING_FONT_PATH, "")
            for favorite in favorites:
                name = favorite.get("name", "")
                if query and query not in name.lower():
                    continue
                list_host.addView(self._build_favorite_row(activity, favorite, current_path, builder))
                shown += 1
            if shown == 0:
                empty = TextView(activity)
                empty.setText(self._t("fav_empty"))
                empty.setTextColor(Theme.getColor(Theme.key_dialogTextGray3))
                empty.setTag(PREVIEW_TAG)
                empty.setPadding(0, AndroidUtilities.dp(14), 0, 0)
                list_host.addView(empty)

        summary = TextView(activity)
        summary.setText(self._t("fav_help"))
        summary.setTextColor(Theme.getColor(Theme.key_dialogTextGray3))
        summary.setTag(PREVIEW_TAG)
        summary.setPadding(0, 0, 0, AndroidUtilities.dp(10))
        wrapper.addView(summary, 1)

        try:
            from android.text import TextWatcher

            class Watcher(TextWatcher):
                def beforeTextChanged(self, s, start, count, after):
                    pass

                def onTextChanged(self, s, start, before, count):
                    pass

                def afterTextChanged(self, s):
                    rebuild()

            search.addTextChangedListener(Watcher())
        except Exception:
            pass

        rebuild()
        scroll = ScrollView(activity)
        scroll.addView(wrapper)
        builder.set_title(self._t("fav_title"))
        builder.set_view(scroll)
        builder.set_negative_button(self._t("close"), lambda b, _w: b.dismiss())
        builder.show()

    def _build_favorite_row(self, activity, favorite, current_path, builder):
        path = self._favorite_path(favorite.get("file"))
        is_current = bool(path) and path == current_path and _safe_bool(self.get_setting(SETTING_ENABLED, False))
        card = LinearLayout(activity)
        card.setOrientation(LinearLayout.VERTICAL)
        card.setPadding(AndroidUtilities.dp(12), AndroidUtilities.dp(10), AndroidUtilities.dp(12), AndroidUtilities.dp(10))
        card.setTag(PREVIEW_TAG)
        card.setClickable(True)
        background_key = Theme.key_windowBackgroundGray if is_current else Theme.key_windowBackgroundWhite
        card.setBackground(Theme.createRoundRectDrawable(AndroidUtilities.dp(12), Theme.getColor(background_key)))
        title = TextView(activity)
        title.setText(favorite.get("name", "font"))
        title.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
        title.setTextSize(16)
        title.setTag(PREVIEW_TAG)
        card.addView(title)
        status = TextView(activity)
        status.setText(self._t("active") if is_current else self._t("tap_card"))
        status.setTextColor(Theme.getColor(Theme.key_dialogTextGray3))
        status.setPadding(0, AndroidUtilities.dp(4), 0, 0)
        status.setTag(PREVIEW_TAG)
        card.addView(status)
        preview = TextView(activity)
        preview.setText(self._preview_text())
        preview.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
        preview.setTextSize(15)
        preview.setPadding(0, AndroidUtilities.dp(8), 0, 0)
        preview.setTag(PREVIEW_TAG)
        preview_typeface = self._get_preview_typeface(path)
        if preview_typeface is not None:
            try:
                preview.setTypeface(preview_typeface)
                title.setTypeface(preview_typeface)
            except Exception:
                pass
        card.addView(preview)
        actions = LinearLayout(activity)
        actions.setOrientation(LinearLayout.HORIZONTAL)
        actions.setPadding(0, AndroidUtilities.dp(10), 0, 0)
        actions.setTag(PREVIEW_TAG)
        apply_button = TextView(activity)
        apply_button.setText(self._t("apply"))
        apply_button.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlueText))
        apply_button.setTag(PREVIEW_TAG)
        apply_button.setOnClickListener(
            OnClickListener(lambda _v, p=path, n=favorite.get("name", "font"), b=builder: self._apply_favorite_from_dialog(p, n, b))
        )
        actions.addView(apply_button)
        remove_button = TextView(activity)
        remove_button.setText(self._t("delete"))
        remove_button.setTextColor(Theme.getColor(Theme.key_text_RedBold))
        remove_button.setPadding(AndroidUtilities.dp(18), 0, 0, 0)
        remove_button.setTag(PREVIEW_TAG)
        remove_button.setOnClickListener(
            OnClickListener(lambda _v, f=favorite, b=builder: self._remove_favorite_from_dialog(f, b))
        )
        actions.addView(remove_button)
        card.addView(actions)
        card.setOnClickListener(
            OnClickListener(lambda _v, p=path, n=favorite.get("name", "font"), b=builder: self._apply_favorite_from_dialog(p, n, b))
        )
        spacer = LinearLayout(activity)
        spacer.setPadding(0, AndroidUtilities.dp(6), 0, 0)
        wrap = LinearLayout(activity)
        wrap.setOrientation(LinearLayout.VERTICAL)
        wrap.addView(card)
        wrap.addView(spacer)
        return wrap

    def _get_preview_typeface(self, path):
        if not path or not os.path.exists(path):
            return None
        cached = self._preview_cache.get(path)
        if cached is not None:
            return cached
        try:
            preview = Typeface.createFromFile(path)
            if preview is not None:
                self._preview_cache[path] = preview
            return preview
        except Exception as e:
            self.log("preview font load error: %s" % e)
            return None

    def _apply_favorite_from_dialog(self, path, name, builder):
        if not path or not os.path.exists(path):
            BulletinHelper.show_error(self._t("fav_gone"))
            self._normalize_favorites()
            if builder is not None:
                try:
                    builder.dismiss()
                except Exception:
                    pass
            return
        try:
            self._activate_font_path(path, name, reload_settings=True)
            BulletinHelper.show_success("%s: %s" % (self._t("applied"), name))
            if builder is not None:
                builder.dismiss()
        except Exception as e:
            self.log("favorite apply error: %s" % e)
            BulletinHelper.show_error(self._t("import_fail"))

    def _remove_favorite_from_dialog(self, favorite, builder):
        path = self._favorite_path(favorite.get("file"))
        current_path = self.get_setting(SETTING_FONT_PATH, "")
        favorites = []
        for item in self._get_favorites():
            if self._favorite_storage_name(item) != self._favorite_storage_name(favorite):
                favorites.append(item)
        self._save_favorites(favorites, reload_settings=True)
        if path:
            try:
                if os.path.exists(path):
                    os.remove(path)
            except Exception:
                pass
            self._preview_cache.pop(path, None)
        if current_path and path and current_path == path:
            self._clear_current_selection(reload_settings=True)
            self._refresh_visible_ui()
        if builder is not None:
            try:
                builder.dismiss()
            except Exception:
                pass
        BulletinHelper.show_info(self._t("removed"))
