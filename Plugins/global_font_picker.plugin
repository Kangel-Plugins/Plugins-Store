__id__ = "global_font_picker"
__name__ = "Global Font Picker"
__description__ = "Applies a selected font across Telegram UI. v2.7.3: chat preview reworked like in Quote (real wallpaper snapshot, proper message cells), and a \"restart the app\" bulletin when the plugin or the font is turned off."
