__id__ = "pill_mentions"
__name__ = "PillMentions"
__description__ = "Показывает в Pill Stack кто упомянул, в каком чате и когда с редиректом в чат по нажатию"
__author__ = "@dekma0091"
__version__ = "2.1"
__icon__ = "pixelcamera/6"
__min_version__ = "12.5.1"

MY_PILL_ID = 1560
TAG_KEY = 0x50494C4C
TAG_KEY_J = jint(TAG_KEY)
PILL_ID_J = jint(MY_PILL_ID)

DIALOG_ANIM_DURATION_MS = 250
LAZY_LOAD_DELAY_MS = 20
LAZY_LOAD_BATCH_SIZE = 1
POPUP_ALPHA = 190
POPUP_BG_COLOR_DARK = 0xff141414
POPUP_BG_COLOR_LIGHT = 0xffffffff
CARD_BG_OPACITY_DARK = 0x08
CARD_BG_OPACITY_LIGHT = 0x04
UPDATE_INTERVAL_SECONDS = 8
PAGE_SIZE = 20

ENTRY_CLASS = "ni.dekma.pill_mentions.PillMentionsBridge"

_ui_package_prefix = None
_pillstack_package_prefix = None

def _find_ui_cls(name):
    global _ui_package_prefix
    if not _ui_package_prefix:
        for candidate in ["org.telegram.ui"] + [f"org.telegram.p{i:03d}ui" for i in range(200)]:
            try:
                if find_class(f"{candidate}.LaunchActivity") is not None:
                    _ui_package_prefix = candidate
                    break
            except Exception:
                pass
        _ui_package_prefix = _ui_package_prefix or "org.telegram.ui"
    try:
        return find_class(f"{_ui_package_prefix}.{name}")
    except Exception:
        return None

def _find_pillstack_cls(name):
    global _pillstack_package_prefix
    if not _pillstack_package_prefix:
        for candidate in ["com.exteragram.messenger.pillstack.ui", "com.exteragram.messenger.pillstack.p014ui"]:
            try:
                if find_class(f"{candidate}.pills.weather.WeatherPill") is not None:
                    _pillstack_package_prefix = candidate
                    break
            except Exception:
                pass
        _pillstack_package_prefix = _pillstack_package_prefix or "com.exteragram.messenger.pillstack.ui"
    try:
        return find_class(f"{_pillstack_package_prefix}.{name}")
    except Exception:
        return None

def _clear_view_references(view):
    try:
        if hasattr(view, 'setOnClickListener'):
            view.setOnClickListener(None)
        if hasattr(view, 'getChildCount'):
            count = view.getChildCount()
            for i in range(count):
                _clear_view_references(view.getChildAt(i))
    except Exception:
        pass


class NativeBridge:
    def __init__(self, entry_class_name):
        self.entry_class_name = entry_class_name
        self.target_class = None
        self.is_active = False
        self.is_loading = False
        self.is_stopped = False
        self._lock = threading.Lock()

    def start(self):
        with self._lock:
            if self.is_active or self.is_loading or self.is_stopped:
                return
            self.is_loading = True
        try:
            if self.target_class is None:
                ctx = ApplicationLoader.applicationContext
                if ctx is None or not _DEX_BASE64:
                    with self._lock:
                        self.is_loading = False
                    return
                compressed_data = base64.b64decode(_DEX_BASE64)
                dex_data = zlib.decompress(compressed_data)
                dex_buffer = ByteBuffer.wrap(dex_data)
                class_loader = InMemoryDexClassLoader(dex_buffer, ctx.getClassLoader())
                self.target_class = class_loader.loadClass(self.entry_class_name)
            self._invoke_static("load")
            with self._lock:
                if self.is_stopped:
                    try:
                        self._invoke_static("unload")
                    except Exception:
                        pass
                    self.is_active = False
                else:
                    self.is_active = True
                self.is_loading = False
        except Exception:
            with self._lock:
                self.is_active = False
                self.is_loading = False
            try:
                self._invoke_static("unload")
            except Exception:
                pass
            raise

    def stop(self):
        with self._lock:
            self.is_stopped = True
            if self.target_class is None or not self.is_active:
                return
            self.is_active = False
        try:
            self._invoke_static("unload")
        except Exception:
            pass

    def create_index(self):
        if self.is_active:
            try:
                self._invoke_static("createIndex")
            except Exception:
                pass

    def get_unread_count(self):
        if not self.is_active:
            return 0
        try:
            result = self._invoke_static("getUnreadCount")
            return int(result) if result is not None else 0
        except Exception:
            return 0

    def fetch_mentions(self, time_limit, limit, offset, sort_asc):
        if not self.is_active:
            return '{"items":[],"hasMore":false}'
        try:
            params = f"{time_limit},{limit},{offset},{1 if sort_asc else 0}"
            result = self._invoke_static("fetchMentions", params)
            return str(result) if result else '{"items":[],"hasMore":false}'
        except Exception:
            return '{"items":[],"hasMore":false}'

    def mark_as_read(self, uid, mid):
        if self.is_active:
            try:
                params = f"{uid},{mid}"
                self._invoke_static("markAsRead", params)
            except Exception:
                pass

    def _invoke_static(self, method_name, *args):
        if self.target_class is None:
            return None
        for method in self.target_class.getDeclaredMethods():
            if str(method.getName()) == method_name and len(method.getParameterTypes()) == len(args):
                method.setAccessible(True)
                if not args:
                    return method.invoke(None)
                return method.invoke(None, *args)
        return None


class WhitelistCreator(dynamic_proxy(find_class("com.exteragram.messenger.pillstack.core.PillRegistry$PillCreator"))):
    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin

    def create(self, context, resourcesProvider):
        try:
            pill = self.plugin.WeatherPill(context, resourcesProvider)
            pill.setTag(TAG_KEY_J, PILL_ID_J)
            self.plugin.active_pills.add(pill)
            run_on_ui_thread(lambda: self.plugin.update_pill_ui(pill))
            return pill
        except Exception:
            return None
        finally:
            del context
            del resourcesProvider

class MenuAction(dynamic_proxy(Runnable)):
    def __init__(self, idx, label, plugin, btn):
        super().__init__()
        self.idx = idx
        self.label = label
        self.plugin = plugin
        self.btn = btn
    def run(self):
        try:
            self.plugin.set_setting("time_filter", self.idx)
            filter_labels = ["За все время", "За час", "За сегодня", "За 3 дня", "За неделю"]
            self.btn.setText(filter_labels[self.idx])
            threading.Thread(target=self.plugin._load_mentions_async, args=(True,)).start()
        except Exception:
            pass

class GetIdHook(MethodHook):
    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin

    def before_hooked_method(self, param):
        try:
            tag = param.thisObject.getTag(TAG_KEY_J)
            if tag and int(tag) == MY_PILL_ID:
                self.plugin.active_pills.add(param.thisObject)
                param.setResult(PILL_ID_J)
        finally:
            del param

    def after_hooked_method(self, param):
        try:
            pass
        finally:
            del param

class InteractionHook(MethodHook):
    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin

    def before_hooked_method(self, param):
        try:
            tag = param.thisObject.getTag(TAG_KEY_J)
            if tag and int(tag) == MY_PILL_ID:
                method_name = param.method.getName()
                if method_name == "onPillClicked":
                    self.plugin.on_click_action()
                    param.setResult(None)
                elif method_name == "onPillLongClicked":
                    param.setResult(True)
                elif method_name in ["onUpdateData", "setData"]:
                    param.setResult(None)
        finally:
            del param

    def after_hooked_method(self, param):
        try:
            pass
        finally:
            del param

class MentionsViewerPlugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self._registered_unhooks = []
        self.active_pills = weakref.WeakSet()
        self.sort_asc = False
        self.current_dialog_mentions = None
        self.render_cards_callback = None
        self.updater_running = False
        self.render_generation = 0
        self._mentions_offset = 0
        self._has_more = False
        self._load_more_btn = None
        self.bridge = NativeBridge(ENTRY_CLASS)

        self.PillRegistry = None
        self.PillInfo = None
        self.PillCreator = None
        self.PillStackConfig = None
        self.WeatherPill = None
        self.ChatActivity = None
        self.AvatarDrawable = None
        self.BackupImageView = None
        self.ItemOptions = None
        self.Theme = None
        self.AndroidUtilities = None
        self.LayoutTransition = None
        self.TransitionManager = None
        self.AutoTransition = None
        self.MessagesController = None

    def on_plugin_load(self):
        self.updater_running = True
        threading.Thread(target=self._load_async_plugin_tasks, daemon=True).start()

    def _load_async_plugin_tasks(self):
        try:
            self.bridge.start()
            if self.bridge.is_stopped:
                return
            self.PillRegistry = find_class("com.exteragram.messenger.pillstack.core.PillRegistry")
            self.PillInfo = find_class("com.exteragram.messenger.pillstack.core.PillRegistry$PillInfo")
            self.PillCreator = find_class("com.exteragram.messenger.pillstack.core.PillRegistry$PillCreator")
            self.PillStackConfig = find_class("com.exteragram.messenger.pillstack.core.PillStackConfig")
            self.WeatherPill = _find_pillstack_cls("pills.weather.WeatherPill")
            self.ChatActivity = _find_ui_cls("ChatActivity")
            self.AvatarDrawable = _find_ui_cls("Components.AvatarDrawable")
            self.BackupImageView = _find_ui_cls("Components.BackupImageView")
            self.ItemOptions = _find_ui_cls("Components.ItemOptions")
            self.Theme = find_class("org.telegram.ui.ActionBar.Theme")
            self.AndroidUtilities = find_class("org.telegram.messenger.AndroidUtilities")
            self.LayoutTransition = find_class("android.animation.LayoutTransition")
            self.TransitionManager = find_class("android.transition.TransitionManager")
            self.AutoTransition = find_class("android.transition.AutoTransition")
            self.MessagesController = find_class("org.telegram.messenger.MessagesController")

            if self.bridge.is_stopped:
                return

            self.bridge.create_index()

            if self.bridge.is_stopped:
                return

            if self.PillRegistry and self.PillInfo and self.WeatherPill:
                self._register_pill_stack()
                self._badge_updater_loop()
        except Exception:
            pass

    def on_plugin_unload(self):
        self.updater_running = False
        if self.PillRegistry:
            try:
                self.PillRegistry.unregister(PILL_ID_J)
            except Exception:
                pass

        for u in self._registered_unhooks:
            try:
                self.unhook_method(u)
            except Exception:
                pass
        self._registered_unhooks.clear()
        self.active_pills.clear()
        self.bridge.stop()

    def _register_pill_stack(self):
        try:
            ctx = ApplicationLoader.applicationContext
            res = ctx.getResources()
            icon_res = res.getIdentifier("msg_mention", "drawable", ctx.getPackageName())
            if icon_res == 0:
                icon_res = res.getIdentifier("msg_notifications", "drawable", ctx.getPackageName())
            if icon_res == 0:
                icon_res = res.getIdentifier("msg_message", "drawable", ctx.getPackageName())

            color_top = jint(-11565578)
            color_bottom = jint(-13276952)

            creator = WhitelistCreator(self)
            pill_info = self.PillInfo(
                PILL_ID_J,
                "Упоминания",
                jint(icon_res),
                color_top,
                color_bottom,
                creator
            )

            self.PillRegistry.register(pill_info)
            self.PillRegistry.activatePill(PILL_ID_J)

            u1 = self.hook_all_methods(self.WeatherPill, "getPillId", GetIdHook(self))
            if u1:
                self._registered_unhooks.append(u1)

            u2 = self.hook_all_methods(self.WeatherPill, "onPillClicked", InteractionHook(self))
            if u2:
                self._registered_unhooks.append(u2)

            u3 = self.hook_all_methods(self.WeatherPill, "onPillLongClicked", InteractionHook(self))
            if u3:
                self._registered_unhooks.append(u3)

            u4 = self.hook_all_methods(self.WeatherPill, "onUpdateData", InteractionHook(self))
            if u4:
                self._registered_unhooks.append(u4)

            u5 = self.hook_all_methods(self.WeatherPill, "setData", InteractionHook(self))
            if u5:
                self._registered_unhooks.append(u5)
        except Exception:
            pass

    def update_pill_ui(self, pill):
        try:
            tv = get_private_field(pill, "textView")
            if tv:
                tv.setText("Упоминания")

            iv = get_private_field(pill, "iconView")
            if iv:
                ctx = pill.getContext()
                icon_res = ctx.getResources().getIdentifier("msg_mention", "drawable", ctx.getPackageName())
                if icon_res == 0:
                    icon_res = ctx.getResources().getIdentifier("msg_notifications", "drawable", ctx.getPackageName())
                if icon_res == 0:
                    icon_res = ctx.getResources().getIdentifier("msg_message", "drawable", ctx.getPackageName())
                if icon_res != 0:
                    iv.setImageResource(icon_res)

            themedColor = 0xff2196f3
            if tv:
                tv.setTextColor(jint(themedColor))
            if iv:
                iv.setColorFilter(jint(themedColor))

            if self.Theme and self.AndroidUtilities:
                default_color = self.Theme.getColor(self.Theme.key_windowBackgroundWhite) if self.Theme.isCurrentThemeDark() else self.Theme.multAlpha(themedColor, 0.09)
                pressed_color = self.Theme.multAlpha(themedColor, 0.1)

                layout = get_private_field(pill, "layout")
                if layout:
                    layout.setBackground(self.Theme.createSimpleSelectorRoundRectDrawable(
                        self.AndroidUtilities.dp(14),
                        jint(default_color),
                        jint(pressed_color)
                    ))
            threading.Thread(target=self.update_badge_count).start()
        except Exception:
            pass

    def _badge_updater_loop(self):
        while self.updater_running:
            try:
                self.update_badge_count()
            except Exception:
                pass
            time.sleep(UPDATE_INTERVAL_SECONDS)

    def update_badge_count(self):
        try:
            count = self.bridge.get_unread_count()
            run_on_ui_thread(lambda: self._apply_badge_to_pills(count))
        except Exception:
            pass

    def _apply_badge_to_pills(self, count):
        try:
            text = f"Упоминания ({count})" if count > 0 else "Упоминания"
            themedColor = 0xffe53935 if count > 0 else 0xff2196f3

            for pill in list(self.active_pills):
                if not pill:
                    continue
                tv = get_private_field(pill, "textView")
                if tv:
                    tv.setText(text)
                    tv.setTextColor(jint(themedColor))

                iv = get_private_field(pill, "iconView")
                if iv:
                    iv.setColorFilter(jint(themedColor))

                if self.Theme and self.AndroidUtilities:
                    default_color = self.Theme.getColor(self.Theme.key_windowBackgroundWhite) if self.Theme.isCurrentThemeDark() else self.Theme.multAlpha(themedColor, 0.09)
                    pressed_color = self.Theme.multAlpha(themedColor, 0.1)

                    layout = get_private_field(pill, "layout")
                    if layout:
                        layout.setBackground(self.Theme.createSimpleSelectorRoundRectDrawable(
                            self.AndroidUtilities.dp(14),
                            jint(default_color),
                            jint(pressed_color)
                        ))
        except Exception:
            pass

    def _build_mentions_query(self):
        time_filter = 0
        try:
            time_filter = int(self.get_setting("time_filter", 0))
        except Exception:
            pass

        current_time = int(time.time())
        time_limit = 0
        if time_filter == 1:
            time_limit = current_time - 3600
        elif time_filter == 2:
            now = datetime.datetime.now()
            midnight = datetime.datetime(now.year, now.month, now.day)
            time_limit = int(midnight.timestamp())
        elif time_filter == 3:
            time_limit = current_time - 259200
        elif time_filter == 4:
            time_limit = current_time - 604800
        return time_limit

    def on_click_action(self):
        self.current_dialog_mentions = None
        self.render_cards_callback = None
        self.render_generation = 0
        self._mentions_offset = 0
        self._has_more = False
        threading.Thread(target=self._load_mentions_async, args=(False,)).start()

    def _load_mentions_async(self, refresh_only, append=False):
        try:
            if not append:
                self._mentions_offset = 0

            time_limit = self._build_mentions_query()
            offset = self._mentions_offset

            json_str = self.bridge.fetch_mentions(time_limit, PAGE_SIZE, offset, self.sort_asc)
            data = json.loads(json_str)

            mentions = data.get("items", [])
            self._has_more = data.get("hasMore", False)
            self._mentions_offset = offset + len(mentions)

            if append:
                run_on_ui_thread(lambda: self._append_mentions(mentions))
            elif refresh_only:
                run_on_ui_thread(lambda: self.update_active_dialog(mentions))
            else:
                run_on_ui_thread(lambda: self.show_mentions_dialog(mentions))
        except Exception:
            pass

    def _append_mentions(self, new_mentions):
        try:
            if self.current_dialog_mentions is not None and new_mentions:
                self.current_dialog_mentions.extend(new_mentions)
                if self.render_cards_callback:
                    self.render_cards_callback()
        except Exception:
            pass

    def update_active_dialog(self, new_mentions):
        try:
            if self.current_dialog_mentions is not None:
                self.current_dialog_mentions = new_mentions
                if self.render_cards_callback:
                    self.render_cards_callback()
            threading.Thread(target=self.update_badge_count).start()
        except Exception:
            pass

    def show_mentions_dialog(self, mentions):
        try:
            last_fragment = get_last_fragment()
            if not last_fragment:
                return
            activity = last_fragment.getParentActivity()
            if not activity:
                return

            self.current_dialog_mentions = mentions
            mc = self.MessagesController.getInstance(UserConfig.selectedAccount)
            ctx = ApplicationLoader.applicationContext

            builder = AlertDialogBuilder(activity)

            root = LinearLayout(activity)
            root.setOrientation(1)

            header_layout = LinearLayout(activity)
            header_layout.setOrientation(0)
            header_layout.setPadding(
                self.AndroidUtilities.dp(20),
                self.AndroidUtilities.dp(16),
                self.AndroidUtilities.dp(16),
                self.AndroidUtilities.dp(8)
            )

            title_view = TextView(activity)
            title_view.setTextSize(TypedValue.COMPLEX_UNIT_SP, 20)
            title_view.setTypeface(self.AndroidUtilities.bold())
            title_tv_color = self.Theme.getColor(self.Theme.key_dialogTextBlack)
            title_view.setTextColor(jint(title_tv_color))
            title_view.setText("Упоминания")

            title_lp = LinearLayout.LayoutParams(0, -2, 1.0)
            title_view.setLayoutParams(title_lp)
            header_layout.addView(title_view)

            time_filter = 0
            try:
                time_filter = int(self.get_setting("time_filter", 0))
            except Exception:
                pass
            filter_labels = ["За все время", "За час", "За сегодня", "За 3 дня", "За неделю"]
            initial_label = filter_labels[time_filter] if 0 <= time_filter < len(filter_labels) else "За все время"

            is_dark = self.Theme.isCurrentThemeDark()
            card_bg = (CARD_BG_OPACITY_DARK << 24) | 0xffffff if is_dark else (CARD_BG_OPACITY_LIGHT << 24)
            pressed_bg = (int(CARD_BG_OPACITY_DARK * 2.25) << 24) | 0xffffff if is_dark else (int(CARD_BG_OPACITY_LIGHT * 2.75) << 24)

            text_color = self.Theme.getColor(self.Theme.key_dialogTextBlack)
            link_color = self.Theme.getColor(self.Theme.key_dialogTextLink)
            gray_color = self.Theme.getColor(self.Theme.key_dialogTextGray)

            filter_btn = TextView(activity)
            filter_btn.setTextSize(TypedValue.COMPLEX_UNIT_SP, 14)
            filter_btn.setTextColor(jint(link_color))
            filter_btn.setText(initial_label)
            filter_btn.setPadding(
                self.AndroidUtilities.dp(8),
                self.AndroidUtilities.dp(4),
                self.AndroidUtilities.dp(8),
                self.AndroidUtilities.dp(4)
            )
            filter_btn.setBackground(self.Theme.createSimpleSelectorRoundRectDrawable(
                self.AndroidUtilities.dp(8),
                jint(0),
                jint(pressed_bg)
            ))
            header_layout.addView(filter_btn)

            sort_btn = TextView(activity)
            sort_btn.setTextSize(TypedValue.COMPLEX_UNIT_SP, 14)
            sort_btn.setTextColor(jint(link_color))
            sort_btn.setPadding(
                self.AndroidUtilities.dp(8),
                self.AndroidUtilities.dp(4),
                self.AndroidUtilities.dp(8),
                self.AndroidUtilities.dp(4)
            )
            sort_btn.setBackground(self.Theme.createSimpleSelectorRoundRectDrawable(
                self.AndroidUtilities.dp(8),
                jint(0),
                jint(pressed_bg)
            ))
            header_layout.addView(sort_btn)

            root.addView(header_layout)

            scroll = ScrollView(activity)
            scroll.setVerticalScrollBarEnabled(False)

            container = LinearLayout(activity)
            container.setOrientation(1)
            container.setPadding(
                self.AndroidUtilities.dp(16),
                self.AndroidUtilities.dp(4),
                self.AndroidUtilities.dp(16),
                self.AndroidUtilities.dp(8)
            )
            if self.LayoutTransition:
                container.setLayoutTransition(self.LayoutTransition())

            scroll.addView(container)
            root.addView(scroll)

            cards_container = LinearLayout(activity)
            cards_container.setOrientation(1)
            if self.LayoutTransition:
                cards_container.setLayoutTransition(self.LayoutTransition())
            container.addView(cards_container)

            empty_view = TextView(activity)
            empty_view.setTextSize(TypedValue.COMPLEX_UNIT_SP, 16)
            empty_view.setTextColor(jint(gray_color))
            empty_view.setGravity(17)
            empty_view.setPadding(
                self.AndroidUtilities.dp(16),
                self.AndroidUtilities.dp(40),
                self.AndroidUtilities.dp(16),
                self.AndroidUtilities.dp(40)
            )
            empty_view.setText("Упоминаний не найдено")
            empty_view.setVisibility(8)
            container.addView(empty_view)

            def make_read_listener(mid, uid):
                def on_click(v):
                    try:
                        self.bridge.mark_as_read(uid, mid)
                        for it in list(self.current_dialog_mentions):
                            if it["mid"] == mid and it["uid"] == uid:
                                self.current_dialog_mentions.remove(it)
                                break
                        render_cards()
                    except Exception:
                        pass
                    finally:
                        del v
                return OnClickListener(on_click)

            def make_click_listener(mid, uid):
                def on_click(v):
                    try:
                        builder.dismiss()
                        if self.ChatActivity:
                            b = Bundle()
                            b.putLong("chat_id", -uid)
                            b.putInt("message_id", mid)
                            lf = get_last_fragment()
                            if lf:
                                lf.presentFragment(self.ChatActivity(b))
                    except Exception:
                        pass
                    finally:
                        del v
                return OnClickListener(on_click)

            def get_sender_object(sender_id, sender_type):
                if not sender_id:
                    return None
                try:
                    if sender_type == "user":
                        try:
                            return mc.getUser(Long(sender_id))
                        except Exception:
                            return mc.getUser(jlong(sender_id))
                    elif sender_type in ("channel", "chat"):
                        try:
                            return mc.getChat(Long(sender_id))
                        except Exception:
                            return mc.getChat(jlong(sender_id))
                except Exception:
                    pass
                return None

            def render_slice(sorted_mentions, start_idx, end_idx):
                existing_count = cards_container.getChildCount()
                for idx in range(start_idx, end_idx):
                    item = sorted_mentions[idx]
                    mid = item["mid"]
                    uid = item["uid"]
                    sender_name = item.get("senderName", "Неизвестно")
                    chat_name = item.get("chatName", "Неизвестный чат")

                    sender_id = item.get("senderId", 0)
                    sender_type = item.get("senderType", "unknown")
                    sender_obj = get_sender_object(sender_id, sender_type)

                    text = item.get("text", "")
                    text = text.replace("\n", " ").strip()
                    if len(text) > 80:
                        text = text[:77] + "..."

                    msg_date = datetime.datetime.fromtimestamp(item.get("date", 0))
                    now = datetime.datetime.now()
                    if msg_date.date() == now.date():
                        time_str = msg_date.strftime('%H:%M')
                    elif (now.date() - msg_date.date()).days == 1:
                        time_str = "Вчера"
                    else:
                        time_str = msg_date.strftime('%d.%m')

                    if idx < existing_count:
                        card = cards_container.getChildAt(idx)
                        avatar_view = card.getChildAt(0)
                        center_layout = card.getChildAt(1)
                        top_row = center_layout.getChildAt(0)
                        title_tv = top_row.getChildAt(0)
                        time_tv = top_row.getChildAt(1)
                        msg_tv = center_layout.getChildAt(2)
                        read_btn = card.getChildAt(2)

                        title_tv.setText(f"{sender_name} в {chat_name}")
                        time_tv.setText(time_str)
                        msg_tv.setText(text)

                        if avatar_view and self.AvatarDrawable:
                            avatar_drawable = self.AvatarDrawable()
                            if sender_obj:
                                avatar_drawable.setInfo(sender_obj)
                                avatar_view.setForUserOrChat(sender_obj, avatar_drawable)
                            else:
                                avatar_view.setImageDrawable(avatar_drawable)

                        read_btn.setOnClickListener(make_read_listener(mid, uid))
                        card.setOnClickListener(make_click_listener(mid, uid))
                    else:
                        card = LinearLayout(activity)
                        card.setOrientation(0)
                        card.setPadding(
                            self.AndroidUtilities.dp(10),
                            self.AndroidUtilities.dp(10),
                            self.AndroidUtilities.dp(10),
                            self.AndroidUtilities.dp(10)
                        )

                        lp = LinearLayout.LayoutParams(-1, -2)
                        lp.topMargin = self.AndroidUtilities.dp(5)
                        lp.bottomMargin = self.AndroidUtilities.dp(5)
                        card.setLayoutParams(lp)

                        card.setBackground(self.Theme.createSimpleSelectorRoundRectDrawable(
                            self.AndroidUtilities.dp(12),
                            jint(card_bg),
                            jint(pressed_bg)
                        ))

                        if self.BackupImageView and self.AvatarDrawable:
                            avatar_view = self.BackupImageView(activity)
                            avatar_view.setRoundRadius(self.AndroidUtilities.dp(20))

                            av_lp = LinearLayout.LayoutParams(self.AndroidUtilities.dp(40), self.AndroidUtilities.dp(40))
                            av_lp.gravity = 16
                            av_lp.rightMargin = self.AndroidUtilities.dp(10)
                            avatar_view.setLayoutParams(av_lp)

                            avatar_drawable = self.AvatarDrawable()
                            if sender_obj:
                                avatar_drawable.setInfo(sender_obj)
                                avatar_view.setForUserOrChat(sender_obj, avatar_drawable)
                            else:
                                avatar_view.setImageDrawable(avatar_drawable)
                            card.addView(avatar_view)

                        center_layout = LinearLayout(activity)
                        center_layout.setOrientation(1)
                        center_lp = LinearLayout.LayoutParams(0, -2, 1.0)
                        center_lp.gravity = 16
                        center_layout.setLayoutParams(center_lp)

                        top_row = LinearLayout(activity)
                        top_row.setOrientation(0)

                        title_tv = TextView(activity)
                        title_tv.setTextSize(TypedValue.COMPLEX_UNIT_SP, 13)
                        title_tv.setTypeface(self.AndroidUtilities.bold())
                        title_tv.setTextColor(jint(link_color))
                        title_tv.setText(f"{sender_name} в {chat_name}")
                        title_tv_lp = LinearLayout.LayoutParams(0, -2, 1.0)
                        title_tv.setLayoutParams(title_tv_lp)
                        top_row.addView(title_tv)

                        time_tv = TextView(activity)
                        time_tv.setTextSize(TypedValue.COMPLEX_UNIT_SP, 11)
                        time_tv.setTextColor(jint(gray_color))
                        time_tv.setText(time_str)
                        top_row.addView(time_tv)

                        center_layout.addView(top_row)

                        space = TextView(activity)
                        space.setTextSize(TypedValue.COMPLEX_UNIT_SP, 2)
                        center_layout.addView(space)

                        msg_tv = TextView(activity)
                        msg_tv.setTextSize(TypedValue.COMPLEX_UNIT_SP, 13)
                        msg_tv.setTextColor(jint(text_color))
                        msg_tv.setText(text)
                        center_layout.addView(msg_tv)

                        card.addView(center_layout)

                        read_btn = ImageView(activity)
                        read_btn.setPadding(
                            self.AndroidUtilities.dp(8),
                            self.AndroidUtilities.dp(8),
                            self.AndroidUtilities.dp(8),
                            self.AndroidUtilities.dp(8)
                        )

                        btn_lp = LinearLayout.LayoutParams(self.AndroidUtilities.dp(36), self.AndroidUtilities.dp(36))
                        btn_lp.gravity = 16
                        btn_lp.leftMargin = self.AndroidUtilities.dp(6)
                        read_btn.setLayoutParams(btn_lp)

                        done_res = ctx.getResources().getIdentifier("msg_done", "drawable", ctx.getPackageName())
                        if done_res != 0:
                            read_btn.setImageResource(done_res)
                            read_btn.setColorFilter(jint(gray_color))

                        read_btn.setBackground(self.Theme.createSimpleSelectorRoundRectDrawable(
                            self.AndroidUtilities.dp(18),
                            jint(0),
                            jint(pressed_bg)
                        ))

                        read_btn.setOnClickListener(make_read_listener(mid, uid))
                        card.addView(read_btn)

                        card.setOnClickListener(make_click_listener(mid, uid))
                        cards_container.addView(card)

            load_more_btn = TextView(activity)
            load_more_btn.setText("Загрузить ещё")
            load_more_btn.setTextSize(TypedValue.COMPLEX_UNIT_SP, 14)
            load_more_btn.setTextColor(jint(link_color))
            load_more_btn.setTypeface(self.AndroidUtilities.bold())
            load_more_btn.setGravity(17)
            load_more_btn.setPadding(
                self.AndroidUtilities.dp(16),
                self.AndroidUtilities.dp(14),
                self.AndroidUtilities.dp(16),
                self.AndroidUtilities.dp(14)
            )
            lm_lp = LinearLayout.LayoutParams(-1, -2)
            lm_lp.topMargin = self.AndroidUtilities.dp(4)
            load_more_btn.setLayoutParams(lm_lp)
            load_more_btn.setBackground(self.Theme.createSimpleSelectorRoundRectDrawable(
                self.AndroidUtilities.dp(12),
                jint(card_bg),
                jint(pressed_bg)
            ))
            self._load_more_btn = load_more_btn

            def on_load_more(v):
                try:
                    load_more_btn.setText("Загрузка...")
                    threading.Thread(target=self._load_mentions_async, args=(False, True)).start()
                except Exception:
                    pass
                finally:
                    del v
            load_more_btn.setOnClickListener(OnClickListener(on_load_more))

            def render_cards():
                self.render_generation += 1
                gen = self.render_generation

                sorted_mentions = self.current_dialog_mentions
                needed_count = len(sorted_mentions)

                if self.TransitionManager and self.AutoTransition:
                    try:
                        transition = self.AutoTransition()
                        transition.setDuration(Long(DIALOG_ANIM_DURATION_MS))
                        self.TransitionManager.beginDelayedTransition(root, transition)
                    except Exception:
                        pass

                if load_more_btn.getParent():
                    cards_container.removeView(load_more_btn)

                if needed_count == 0:
                    empty_view.setVisibility(0)
                    for i in range(cards_container.getChildCount() - 1, -1, -1):
                        cards_container.removeViewAt(i)
                    return
                else:
                    empty_view.setVisibility(8)

                existing_count = cards_container.getChildCount()
                if existing_count > needed_count:
                    for i in range(existing_count - 1, needed_count - 1, -1):
                        cards_container.removeViewAt(i)

                render_slice(sorted_mentions, 0, min(needed_count, LAZY_LOAD_BATCH_SIZE))

                if needed_count > LAZY_LOAD_BATCH_SIZE:
                    def load_remaining():
                        time.sleep(LAZY_LOAD_DELAY_MS / 1000.0)
                        if self.render_generation == gen:
                            def finish_render():
                                if self.render_generation == gen:
                                    render_slice(sorted_mentions, LAZY_LOAD_BATCH_SIZE, needed_count)
                                    if self._has_more:
                                        load_more_btn.setText("Загрузить ещё")
                                        cards_container.addView(load_more_btn)
                            run_on_ui_thread(finish_render)
                    threading.Thread(target=load_remaining).start()
                else:
                    if self._has_more:
                        load_more_btn.setText("Загрузить ещё")
                        cards_container.addView(load_more_btn)

            self.render_cards_callback = render_cards

            def toggle_sort(v):
                try:
                    self.sort_asc = not self.sort_asc
                    sort_btn.setText("⇅ Новые" if not self.sort_asc else "⇅ Старые")
                    threading.Thread(target=self._load_mentions_async, args=(True,)).start()
                finally:
                    del v
                    gc.collect()

            sort_btn.setText("⇅ Новые" if not self.sort_asc else "⇅ Старые")
            sort_btn.setOnClickListener(OnClickListener(toggle_sort))

            sort_btn_lp = LinearLayout.LayoutParams(-2, -2)
            sort_btn_lp.gravity = 16
            sort_btn_lp.leftMargin = self.AndroidUtilities.dp(6)
            sort_btn.setLayoutParams(sort_btn_lp)

            plugin_ref = self
            def show_filter_menu(v):
                try:
                    last_frag = get_last_fragment()
                    if not last_frag or not plugin_ref.ItemOptions:
                        return

                    options = plugin_ref.ItemOptions.makeOptions(root, v)
                    options.setBlur(True)
                    color = POPUP_BG_COLOR_DARK if is_dark else POPUP_BG_COLOR_LIGHT
                    if color > 0x7fffffff:
                        color -= 0x100000000
                    options.setBackgroundColor(jint(color))
                    opt_layout = options.getLinearLayout()
                    if opt_layout:
                        for i in range(opt_layout.getChildCount()):
                            child = opt_layout.getChildAt(i)
                            if hasattr(child, 'setBackAlpha'):
                                child.setBackAlpha(jint(POPUP_ALPHA))
                    filter_items = ["За все время", "За последний час", "За сегодня", "За последние 3 дня", "За неделю"]

                    current_filter = 0
                    try:
                        current_filter = int(plugin_ref.get_setting("time_filter", 0))
                    except Exception:
                        pass

                    for idx, label in enumerate(filter_items):
                        action = MenuAction(idx, label, plugin_ref, filter_btn)
                        options.addChecked(idx == current_filter, label, action)

                    options.show()
                except Exception:
                    pass
                finally:
                    del v
                    gc.collect()

            filter_btn.setOnClickListener(OnClickListener(show_filter_menu))

            filter_btn_lp = LinearLayout.LayoutParams(-2, -2)
            filter_btn_lp.gravity = 16
            filter_btn.setLayoutParams(filter_btn_lp)

            render_cards()

            def on_cancel(dialog, which):
                try:
                    _clear_view_references(root)
                    dialog.dismiss()
                    self.current_dialog_mentions = None
                    self.render_cards_callback = None
                finally:
                    del dialog
                    gc.collect()

            builder.set_view(root)
            builder.set_negative_button("Закрыть", on_cancel)
            builder.show()
        except Exception:
            pass


_DEX_BASE64 = ""
