_RUN_RE = re.compile(r"([^\W\d_])\1", re.IGNORECASE | re.UNICODE)
_DOUBLE_CLASS_RE = re.compile(r"\[([^\]]+)\]\[\1\]")

def _collapse_classes(pattern):
    while True:
        collapsed = _DOUBLE_CLASS_RE.sub(r"[\1]", pattern)
        if collapsed == pattern:
            return collapsed
        pattern = collapsed

def _capture_tail(pattern):
    if not pattern.endswith("\\b"):
        return pattern, ()
    close = len(pattern) - 3
    optional = False
    if close >= 0 and pattern[close] == "?":
        optional = True
        close -= 1
    if close < 0 or pattern[close] != ")":
        return pattern, ()
    depth = 0
    open_index = -1
    index = close
    while index >= 0:
        char = pattern[index]
        if char == ")":
            depth += 1
        elif char == "(":
            depth -= 1
            if depth == 0:
                open_index = index
                break
        index -= 1
    if open_index < 0 or pattern[open_index:open_index + 3] != "(?:":
        return pattern, ()
    alternatives = tuple(pattern[open_index + 3:close].split("|"))
    pattern = (
        pattern[:open_index]
        + "(?P<_end>"
        + pattern[open_index + 3:close]
        + ")"
        + ("?" if optional else "")
        + "\\b"
    )
    return pattern, alternatives

def _make_rule(pattern, replacement):
    pattern, endings = _capture_tail(pattern)
    return (
        re.compile(pattern, re.IGNORECASE),
        re.compile(_collapse_classes(pattern), re.IGNORECASE),
        replacement,
        endings,
    )

