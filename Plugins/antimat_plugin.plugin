        (r"\b[дd][еeё][рp][ь][мm][иi][щsh](?:е|а|у|ем|и|ам|ами|ах)\b", "нечто"),
        (r"\b[дd][еeё][рp][ь][мm](?:о|а|у|ом|е)\b", "нечто"),
        (r"\b[хx][уy][еeё][тt](?:а|ы|е|у|ой|ою|ам|ами|ах)\b", "ерунда"),
        (r"\b[хx][уy][еeё][тt][ь]\b", "обнаглеть"),
        (r"\b[хx][уy][еeё](?:ю|ешь|ет|ем|ете|ют)\b", "удивляться"),
        (r"\b[сc][хx][уy][яa]\b", "с чего"),
        (r"\b[гg][аa@][нn][дd][оo0][нn](?:а|у|ом|е|ы|ов|ам|ами|ах)?\b", "человек"),
        (r"\b[гg][оo0][вb][нn][оo0][еeё][дd](?:а|у|ом|е|ы|ов|ам|ами|ах)?\b", "неприятный человек"),
        (r"\b[мm][уy][дd][аa@][ч4][ь][еeё]\b", "неприятные люди"),
        (r"\b[еeё][бb6][аa@][нn][ь][кk](?:о|а|у|ом|е)\b", "недогадливый человек"),
        # увеличительные формы на -ище
        (r"\b[хx][уy](?:ищами|ищам|ищах|ищем|ище|ищи|ищу|ища|ищ)\b", "морковище"),
        (r"\b[пpn][иi][з3][дd](?:ищами|ищам|ищах|ищем|ище|ищи|ищу|ища|ищ)\b", "пирожище"),
        (r"\b[дd][оo0][лl][бb6][оo0][еeё][бb6](?:ищами|ищам|ищах|ищем|ище|ищи|ищу|ища|ищ)\b", "недалёкий человечище"),
        (r"\b[сc][уy][ч4](?:ищами|ищам|ищах|ищем|ище|ищи|ищу|ища|ищ)\b", "собачище"),
        (r"\b[пpn][иi][дd][оo0][рp](?:ищами|ищам|ищах|ищем|ище|ищи|ищу|ища|ищ)\b", "человечище"),
        (r"\b[уy][рp][оo0][дd](?:ищами|ищам|ищах|ищем|ище|ищи|ищу|ища|ищ)\b", "человечище"),
        (r"\b[хx][уy][еeё][сc][оo0][сc](?:ищами|ищам|ищах|ищем|ище|ищи|ищу|ища|ищ)\b", "нехороший человечище"),
        (r"\b[уy][еeё][бb6][аa@][нn](?:ищами|ищам|ищах|ищем|ище|ищи|ищу|ища|ищ)\b", "невежище"),
        (r"\b[бb6][лl][яa][дd](?:ищами|ищам|ищах|ищем|ище|ищи|ищу|ища|ищ)\b", "неприятная женщина"),
        (r"\b[жj][оo0][пpn](?:ищами|ищам|ищах|ищем|ище|ищи|ищу|ища|ищ)\b", "пятая точка"),
        (r"\b[гg][аa@][нn][дd][оo0][нn](?:ищами|ищам|ищах|ищем|ище|ищи|ищу|ища|ищ)\b", "человечище"),
        (r"\b[пpn][иi][дd][оo0][рp][аa@][сc](?:ищами|ищам|ищах|ищем|ище|ищи|ищу|ища|ищ)\b", "нехороший человечище"),
        (r"\b[мm][рp][аa@][з3](?:ищами|ищам|ищах|ищем|ище|ищи|ищу|ища|ищ)\b", "неприятная личность"),
    )
)

_FEM_AMBIG = ("?", "?")
_AUG_AMBIG = ("aug", "?")
_TAIL_TAG_CACHE = {}
_ADJ_CACHE = {}
_NOUN_FORMS_CACHE = {}

_NOUNS = {
    "актриса": "f", "беда": "f", "болтовня": "f", "болтунья": "f", "варежка": "f",
    "близость": "f", "вещь": "f", "глупость": "f", "гуляка": "f", "девушка": "f",
    "ерунда": "f", "жадина": "f", "жадность": "f", "женщина": "f", "жидкость": "f",
    "затрещина": "f", "козлятина": "f", "компания": "f", "конфета": "f", "личность": "f",
    "морковка": "f", "морока": "f", "невежда": "f", "неприятность": "f", "неряха": "f",
    "потеря": "f", "работа": "f", "редиска": "f", "собака": "f", "собачка": "f",
    "точка": "f", "трусишка": "f", "штуковина": "f", "шутка": "f",
    "актёр": "m", "бегун": "m", "беспорядок": "m", "болтун": "m", "выговор": "m",
    "выпендрёж": "m", "грубиян": "m", "козлик": "m", "малыш": "m", "материал": "m",
    "мусор": "m", "нарушитель": "m", "нытик": "m", "обман": "m", "подхалим": "m",
    "простак": "m", "простачок": "m", "пустозвон": "m", "разгильдяй": "m",
    "разгром": "m", "сайт": "m", "свинопас": "m", "трус": "m", "тумак": "m",
    "человек": "m", "человечек": "m", "чертёжник": "m", "щенок": "m",
    "петушок": "m", "пирожок": "m", "грубиянище": "m", "морковище": "m",
    "пирожище": "m", "человечище": "m", "собачище": "m", "невежище": "m",
    "безразличие": "n", "вещество": "n", "высказывание": "n", "животное": "n",
    "насекомое": "n", "недоразумение": "n", "существо": "n", "лицо": "n",
    "нарушение": "n", "занятие": "n", "разгильдяйство": "n", "неприличие": "n",
    "недогадливость": "f",
    "кино": "0", "нечто": "0",
}
_NOUN_ALIAS = {
    "вещи": ("вещь", "f"), "тумаки": ("тумак", "m"),
    "грубияны": ("грубиян", "m"), "люди": ("человек", "m"),
}
_ANIMATE = {
    "актриса", "актёр", "бегун", "болтун", "болтунья", "грубиян", "грубиянище", "гуляка",
    "девушка", "жадина", "женщина", "животное", "козлик", "малыш", "насекомое",
    "невежда", "невежище", "неряха", "нытик", "подхалим", "простак", "простачок", "пустозвон",
    "разгильдяй", "свинопас", "собака", "собачка", "собачище", "существо", "трус", "трусишка",
    "человек", "человечек", "человечище", "чертёжник", "щенок", "петушок", "нарушитель",
}
_SIBILANT_EM = {"выпендрёж"}
_GEN_PL_ZERO = {"собака", "гуляка", "морока"}
_NOT_ADJ = {"занимающийся"}
_PLURAL_CUES = {
    "они", "эти", "те", "все", "мы", "вы", "такие", "какие", "мои", "твои",
    "наши", "ваши", "свои", "одни", "двое", "трое", "оба", "обе", "сколько",
    "несколько", "много",
}
