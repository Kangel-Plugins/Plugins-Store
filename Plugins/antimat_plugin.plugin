    "нет", "без", "от", "у", "до", "из", "с", "со", "около", "для", "ради",
    "после", "кроме", "мимо", "возле", "против",
}
_PREP_CUES = {"о", "об", "обо", "при"}
_DAT_CUES = {"по"}
_PLURAL_VERBS = {
    "были", "стали", "будут", "есть", "ходят", "делают", "говорят", "могут",
    "хотят", "знают", "живут", "сидят", "стоят",
}


def _tail_tags(endings):
    if not endings:
        return {}
    alts = set(endings)
    if alts & {"ья", "ье", "ьи", "ьего", "ьему", "ьим", "ьем", "ьей", "ьих", "ьими"}:
        mapping = {
            "ий": ("nom", "sg"), "ья": ("nom", "sg"), "ье": ("nom", "sg"),
            "ьи": ("nom", "pl"), "ьего": ("gen", "sg"), "ьему": ("dat", "sg"),
            "ьим": ("ins", "sg"), "ьем": ("prep", "sg"), "ьей": ("ins", "sg"),
            "ью": ("acc", "sg"), "ьих": ("gen", "pl"), "ьими": ("ins", "pl"),
        }
        return {alt: mapping[alt] for alt in endings if alt in mapping}
    if alts & {"ого", "его", "ому", "ему", "ыми", "ими", "ых", "их", "ую", "юю", "яя", "ые", "ие"}:
        if "ый" in alts:
            nom_m = "ый"
        elif "ий" in alts:
            nom_m = "ий"
        else:
            nom_m = "ой"
        mapping = {
            nom_m: ("nom", "sg"),
            "ая": ("nom", "sg"), "яя": ("nom", "sg"),
            "ое": ("nom", "sg"), "ее": ("nom", "sg"),
            "ые": ("nom", "pl"), "ие": ("nom", "pl"),
            "ого": ("gen", "sg"), "его": ("gen", "sg"),
            "ому": ("dat", "sg"), "ему": ("dat", "sg"),
            "ым": ("ins", "sg"), "им": ("ins", "sg"),
            "ом": ("prep", "sg"), "ем": ("prep", "sg"),
            "ой": ("ins", "sg"), "ей": ("ins", "sg"),
            "ою": ("ins", "sg"), "ею": ("ins", "sg"),
            "ую": ("acc", "sg"), "юю": ("acc", "sg"),
            "ых": ("gen", "pl"), "их": ("gen", "pl"),
            "ыми": ("ins", "pl"), "ими": ("ins", "pl"),
        }
        return {alt: mapping[alt] for alt in endings if alt in mapping}
    if alts & {"ия", "ии", "ию", "ией", "иям", "иями", "иях"}:
        mapping = {
            "ия": ("nom", "sg"), "ии": _FEM_AMBIG, "ию": ("acc", "sg"),
            "ией": ("ins", "sg"), "иям": ("dat", "pl"), "иями": ("ins", "pl"),
            "иях": ("prep", "pl"),
        }
        return {alt: mapping[alt] for alt in endings if alt in mapping}
    feminine = bool(alts & {"ой", "ою", "ью", "ёй"}) or ("ям" in alts and "ей" in alts)
    mixed = feminine and "о" in alts and "ом" in alts
    augmentative = {
        "ище": ("nom", "sg"), "ища": _AUG_AMBIG, "ищу": ("dat", "sg"),
        "ищем": ("ins", "sg"), "ищи": ("nom", "pl"), "ищ": ("gen", "pl"),
        "ищам": ("dat", "pl"), "ищами": ("ins", "pl"), "ищах": ("prep", "pl"),
    }
    tags = {alt: augmentative[alt] for alt in endings if alt in augmentative}
    for alt in endings:
        if feminine:
            if mixed and alt == "о":
                tags[alt] = ("nom", "sg")
            elif mixed and alt == "ом":
                tags[alt] = ("ins", "sg")
            elif alt in ("", "ь", "а", "я"):
                tags[alt] = ("nom", "sg")
            elif alt in ("ы", "и"):
                tags[alt] = _FEM_AMBIG
            elif alt == "е":
                tags[alt] = ("dat", "sg")
            elif alt in ("у", "ю"):
                tags[alt] = ("acc", "sg")
            elif alt in ("ой", "ою", "ею", "ью"):
                tags[alt] = ("ins", "sg")
            elif alt in ("ей", "ёй"):
                tags[alt] = ("gen", "pl") if "ью" in alts else ("ins", "sg")
            elif alt in ("ам", "ям"):
                tags[alt] = ("dat", "pl")
            elif alt in ("ами", "ями"):
                tags[alt] = ("ins", "pl")
            elif alt in ("ах", "ях"):
                tags[alt] = ("prep", "pl")
        else:
            if alt in ("", "ь", "о", "ё"):
                tags[alt] = ("nom", "sg")
            elif alt in ("а", "я"):
                tags[alt] = ("gen", "sg")
            elif alt in ("у", "ю"):
                tags[alt] = ("dat", "sg")
            elif alt in ("ом", "ем", "ём"):
                tags[alt] = ("ins", "sg")
            elif alt == "е":
                tags[alt] = ("prep", "sg")
            elif alt in ("ы", "и"):
                tags[alt] = ("nom", "pl")
            elif alt in ("ов", "ев", "ёв", "ей", "в"):
                tags[alt] = ("gen", "pl")
            elif alt in ("ам", "ям"):
                tags[alt] = ("dat", "pl")
            elif alt in ("ами", "ями"):
                tags[alt] = ("ins", "pl")
            elif alt in ("ах", "ях"):
                tags[alt] = ("prep", "pl")
    return tags


def _word_kind(word):
    if word in _NOUNS or word in _NOUN_ALIAS:
        return "noun"
    if word in _NOT_ADJ:
        return "other"
    base = word[:-2] if word.endswith("ся") else word
    if base.endswith(("ый", "ий", "ой", "ая", "яя", "ое", "ее", "ые", "ие")):
        return "adj"
    return "other"


def _adj_info(token):
    low = token.lower()
    cached = _ADJ_CACHE.get(low)
    if cached:
        return cached
    reflexive = low.endswith("ся") and low.endswith("ийся")
    word = low[:-2] if reflexive else low
    gender = "m"
    if word.endswith(("ый", "ой")):
        stem, kind = word[:-2], "hard"
    elif word.endswith("ая"):
        stem = word[:-2]
        kind = "sibilant" if stem.endswith(("ш", "ж", "ч", "щ")) else "hard"
        gender = "f"
    elif word.endswith("яя"):
        stem, kind, gender = word[:-2], "soft", "f"
    elif word.endswith(("ое", "ее")):
        stem, kind, gender = word[:-2], "hard", "n"
    elif word.endswith(("ые", "ие")):
        stem, kind, gender = word[:-2], "hard", "pl"
    elif word.endswith("ий"):
        stem = word[:-2]
        if low == "собачий":
            kind = "possessive"
        elif stem.endswith(("ш", "ж", "ч", "щ")):
            kind = "sibilant"
        elif stem.endswith(("к", "г", "х")):
            kind = "velar"
        else:
            kind = "soft"
    else:
        stem, kind = word, "hard"
    info = (stem, kind, gender, reflexive, low)
    _ADJ_CACHE[low] = info
    return info


def _adjective_forms(stem, kind, lemma):
    if kind == "possessive":
        return {
            "nom_m": stem + "ий", "nom_f": stem + "ья", "nom_n": stem + "ье",
            "nom_pl": stem + "ьи", "gen_m": stem + "ьего", "dat_m": stem + "ьему",
            "ins_m": stem + "ьим", "prep_m": stem + "ьем", "obl_f": stem + "ьей",
            "acc_f": stem + "ью", "gen_pl": stem + "ьих", "dat_pl": stem + "ьим",
            "ins_pl": stem + "ьими",
        }
    if kind == "soft":
        return {
            "nom_m": stem + "ий", "nom_f": stem + "яя", "nom_n": stem + "ее",
            "nom_pl": stem + "ие", "gen_m": stem + "его", "dat_m": stem + "ему",
            "ins_m": stem + "им", "prep_m": stem + "ем", "obl_f": stem + "ей",
            "acc_f": stem + "юю", "gen_pl": stem + "их", "dat_pl": stem + "им",
            "ins_pl": stem + "ими",
        }
    if kind == "velar":
        return {
            "nom_m": stem + "ий", "nom_f": stem + "ая", "nom_n": stem + "ое",
            "nom_pl": stem + "ие", "gen_m": stem + "ого", "dat_m": stem + "ому",
            "ins_m": stem + "им", "prep_m": stem + "ом", "obl_f": stem + "ой",
            "acc_f": stem + "ую", "gen_pl": stem + "их", "dat_pl": stem + "им",
            "ins_pl": stem + "ими",
        }
    if kind == "sibilant":
        return {
            "nom_m": stem + "ий", "nom_f": stem + "ая", "nom_n": stem + "ее",
            "nom_pl": stem + "ие", "gen_m": stem + "его", "dat_m": stem + "ему",
            "ins_m": stem + "им", "prep_m": stem + "ем", "obl_f": stem + "ей",
            "acc_f": stem + "ую", "gen_pl": stem + "их", "dat_pl": stem + "им",
            "ins_pl": stem + "ими",
        }
    if lemma.endswith(("ый", "ой")):
        nom_m = lemma
    else:
        nom_m = stem + "ый"
    if kind == "hard" and lemma.endswith("ой") and stem.endswith(("к", "г", "х")):
        return {
            "nom_m": lemma, "nom_f": stem + "ая", "nom_n": stem + "ое",
            "nom_pl": stem + "ие", "gen_m": stem + "ого", "dat_m": stem + "ому",
            "ins_m": stem + "им", "prep_m": stem + "ом", "obl_f": stem + "ой",
            "acc_f": stem + "ую", "gen_pl": stem + "их", "dat_pl": stem + "им",
            "ins_pl": stem + "ими",
        }
    return {
        "nom_m": nom_m, "nom_f": stem + "ая", "nom_n": stem + "ое",
        "nom_pl": stem + "ые", "gen_m": stem + "ого", "dat_m": stem + "ому",
        "ins_m": stem + "ым", "prep_m": stem + "ом", "obl_f": stem + "ой",
        "acc_f": stem + "ую", "gen_pl": stem + "ых", "dat_pl": stem + "ым",
        "ins_pl": stem + "ыми",
    }


def _inflect_adj(token, case, number, gender, animate, long_ins):
    stem, kind, cit_gender, reflexive, lemma = _adj_info(token)
    forms = _adjective_forms(stem, kind, lemma)
    if number == "pl":
        if case == "nom":
            value = forms["nom_pl"]
        elif case == "gen":
            value = forms["gen_pl"]
        elif case == "dat":
            value = forms["dat_pl"]
        elif case == "ins":
            value = forms["ins_pl"]
        elif case == "prep":
            value = forms["gen_pl"]
        else:
            value = forms["gen_pl"] if animate else forms["nom_pl"]
    else:
        current = gender or cit_gender
        if current == "pl":
            current = "m"
        if case == "nom":
            value = forms["nom_" + current]
        elif case == "gen":
            value = forms["obl_f"] if current == "f" else forms["gen_m"]
        elif case == "dat":
            value = forms["obl_f"] if current == "f" else forms["dat_m"]
        elif case == "ins":
            if current == "f":
                value = forms["obl_f"]
                if long_ins:
                    value = value[:-2] + ("ою" if value.endswith("ой") else "ею")
            else:
                value = forms["ins_m"]
        elif case == "prep":
            value = forms["obl_f"] if current == "f" else forms["prep_m"]
        else:
            if current == "f":
                value = forms["acc_f"]
            elif current == "m" and animate:
                value = forms["gen_m"]
            else:
                value = forms["nom_" + current]
    if reflexive:
        value += "ся"
    return value


def _masc_forms(lemma, animate):
    if lemma.endswith("й"):
        stem = lemma[:-1]
        sg = [lemma, stem + "я", stem + "ю", stem + "ем", stem + "е"]
        pl = [stem + "и", stem + "ев", stem + "ям", stem + "ями", stem + "ях"]
    elif lemma.endswith("ь"):
        stem = lemma[:-1]
        sg = [lemma, stem + "я", stem + "ю", stem + "ем", stem + "е"]
        pl = [stem + "и", stem + "ей", stem + "ям", stem + "ями", stem + "ях"]
    elif lemma.endswith("ище"):
        # Увеличительные на -ище склоняются как "домище".
        stem = lemma[:-1]
        sg = [lemma, stem + "а", stem + "у", stem + "ем", stem + "е"]
        pl = [stem + "и", stem, stem + "ам", stem + "ами", stem + "ах"]
    elif lemma.endswith(("ж", "ч", "ш", "щ")):
        stem = lemma
        ins = stem + ("ем" if lemma in _SIBILANT_EM else "ом")
        sg = [lemma, stem + "а", stem + "у", ins, stem + "е"]
        pl = [stem + "и", stem + "ей", stem + "ам", stem + "ами", stem + "ах"]
    elif lemma.endswith(("ок", "ёк", "ек")) and len(lemma) > 3:
        stem = lemma[:-2] + lemma[-1]
        sg = [lemma, stem + "а", stem + "у", stem + "ом", stem + "е"]
        pl = [stem + "и", stem + "ов", stem + "ам", stem + "ами", stem + "ах"]
    else:
        stem = lemma
        last = stem[-1]
        pl_nom_end = "и" if last in "гкхжчшщ" else "ы"
        pl_gen_end = "ей" if last in "жчшщ" else "ов"
        sg = [lemma, stem + "а", stem + "у", stem + "ом", stem + "е"]
        pl = [stem + pl_nom_end, stem + pl_gen_end, stem + "ам", stem + "ами", stem + "ах"]
    return {"sg": sg, "pl": pl, "sg_acc": sg[1] if animate else sg[0],
            "pl_acc": pl[1] if animate else pl[0]}


def _fem_forms(lemma):
    if lemma.endswith("ь"):
        stem = lemma[:-1]
        sg = [lemma, stem + "и", stem + "и", stem + "ью", stem + "и"]
        pl = [stem + "и", stem + "ей", stem + "ям", stem + "ями", stem + "ях"]
        return {"sg": sg, "pl": pl, "sg_acc": lemma, "pl_acc": pl[0]}
    if lemma.endswith("я"):
        stem = lemma[:-1]
        if lemma.endswith("ия"):
            dat = stem + "и"
            ins = stem + "ей"
            gen_pl = stem + "й"
        elif lemma.endswith("ья"):
            dat = stem + "е"
            ins = stem + "ей"
            gen_pl = stem + "ий"
        elif lemma == "болтовня":
            dat = stem + "е"
            ins = stem + "ёй"
            gen_pl = "болтовен"
        else:
            dat = stem + "е"
            ins = stem + "ей"
            gen_pl = stem + "ь"
        sg = [lemma, stem + "и", dat, ins, dat]
        pl = [stem + "и", gen_pl, stem + "ям", stem + "ями", stem + "ях"]
        return {"sg": sg, "pl": pl, "sg_acc": stem + "ю", "pl_acc": pl[0]}
    stem = lemma[:-1]
    pl_nom_end = "и" if stem[-1] in "гкхжчшщ" else "ы"
    if lemma in _GEN_PL_ZERO:
        gen_pl = stem
    elif stem.endswith("к"):
        filler = "ек" if len(stem) > 1 and stem[-2] in "жчшщ" else "ок"
        gen_pl = stem[:-1] + filler
    else:
        gen_pl = stem
    gen_sg = stem + ("и" if stem[-1] in "гкхжчшщ" else "ы")
    sg = [lemma, gen_sg, stem + "е", stem + "ой", stem + "е"]
    pl = [stem + pl_nom_end, gen_pl, stem + "ам", stem + "ами", stem + "ах"]
    return {"sg": sg, "pl": pl, "sg_acc": stem + "у", "pl_acc": pl[0]}


def _neut_forms(lemma):
    if lemma.endswith("ое"):
        stem = lemma[:-2]
        sg = [lemma, stem + "ого", stem + "ому", stem + "ым", stem + "ом"]
        pl = [stem + "ые", stem + "ых", stem + "ым", stem + "ыми", stem + "ых"]
        animate = lemma in _ANIMATE
        return {"sg": sg, "pl": pl, "sg_acc": sg[1] if animate else sg[0],
                "pl_acc": pl[1] if animate else pl[0]}
    if lemma.endswith("ие"):
        stem = lemma[:-1]
        sg = [lemma, stem + "я", stem + "ю", stem + "ем", stem + "и"]
        pl = [stem + "я", stem + "й", stem + "ям", stem + "ями", stem + "ях"]
    else:
        stem = lemma[:-1]
        sg = [lemma, stem + "а", stem + "у", stem + "ом", stem + "е"]
        pl = [stem + "а", stem, stem + "ам", stem + "ами", stem + "ах"]
    return {"sg": sg, "pl": pl, "sg_acc": sg[0], "pl_acc": pl[0]}


def _inflect_noun(lemma, gender, case, number, animate):
    if gender == "0":
        return lemma
    if lemma == "человек":
        if number == "pl":
            forms = {
                "sg": [], "pl": ["люди", "людей", "людям", "людьми", "людях"],
                "sg_acc": "", "pl_acc": "людей",
            }
        else:
            forms = {
                "sg": ["человек", "человека", "человеку", "человеком", "человеке"],
                "pl": [], "sg_acc": "человека", "pl_acc": "",
            }
    else:
        key = (lemma, gender)
        forms = _NOUN_FORMS_CACHE.get(key)
        if forms is None:
            if gender == "f":
                forms = _fem_forms(lemma)
            elif gender == "n":
                forms = _neut_forms(lemma)
            else:
                forms = _masc_forms(lemma, animate)
            _NOUN_FORMS_CACHE[key] = forms
    if number == "pl":
        if case == "acc":
            return forms["pl_acc"]
        return forms["pl"][{"nom": 0, "gen": 1, "dat": 2, "ins": 3, "prep": 4}[case]]
    if case == "acc":
        return forms["sg_acc"]
    return forms["sg"][{"nom": 0, "gen": 1, "dat": 2, "ins": 3, "prep": 4}[case]]


def _noun_info(word):
    low = word.lower()
    if low in _NOUN_ALIAS:
        return _NOUN_ALIAS[low]
    return low, _NOUNS.get(low, "m")


def _replacement_animate(replacement):
    words = replacement.split()
    for word in words:
        low = word.lower()
        if low in _NOUNS or low in _NOUN_ALIAS:
            lemma, _ = _noun_info(low)
            return lemma in _ANIMATE
        if low in _NOT_ADJ:
            return False
        if _word_kind(low) == "adj":
            continue
        return False
    return bool(words) and _word_kind(words[0].lower()) == "adj"


def _resolve_fem(text, start, end, replacement):
    match = re.search(r"([^\W\d_]+)\s*$", text[:start], re.UNICODE)
    previous = match.group(1).lower() if match else ""
    match = re.match(r"\s+([^\W\d_]+)", text[end:], re.UNICODE)
    following = match.group(1).lower() if match else ""
    if previous in _PREP_CUES:
        return ("prep", "sg")
    if previous in _DAT_CUES:
        return ("dat", "sg")
    if previous in _GEN_CUES:
        return ("gen", "sg")
    if previous in _PLURAL_CUES or following in _PLURAL_VERBS:
        return ("nom", "pl")
    if _replacement_animate(replacement):
        return ("nom", "pl")
    return ("gen", "sg")


def _resolve_aug(text, start, end):
    match = re.search(r"([^\W\d_]+)\s*$", text[:start], re.UNICODE)
    previous = match.group(1).lower() if match else ""
    match = re.match(r"\s+([^\W\d_]+)", text[end:], re.UNICODE)
    following = match.group(1).lower() if match else ""
    if previous in _PLURAL_CUES or following in _PLURAL_VERBS:
        return ("nom", "pl")
    return ("gen", "sg")


def _inflect_phrase(replacement, case, number, long_ins=False, gender_hint=None):
    words = replacement.split(" ")
    adjectives = []
    head = None
    for index, word in enumerate(words):
        kind = _word_kind(word.lower())
        if kind == "adj" and head is None:
            adjectives.append(index)
        elif kind == "noun" and head is None:
            head = index
            break
        else:
            break
    if head is None:
        if len(words) == 1 and _word_kind(words[0].lower()) == "adj":
            return _inflect_adj(words[0], case, number, gender_hint, False, long_ins)
        return replacement
    lemma, gender = _noun_info(words[head])
    animate = lemma in _ANIMATE
    result = list(words)
    for index in adjectives:
        result[index] = _inflect_adj(words[index], case, number, gender, animate, long_ins)
    result[head] = _inflect_noun(lemma, gender, case, number, animate)
    return " ".join(result)


def _shape(replacement, ending, endings, text, start, end, capital):
    ending = ending.lower()
    tags = _TAIL_TAG_CACHE.get(endings)
    if tags is None:
        tags = _tail_tags(endings)
        _TAIL_TAG_CACHE[endings] = tags
    tag = tags.get(ending)
    if tag == _FEM_AMBIG:
        tag = _resolve_fem(text, start, end, replacement)
    elif tag == _AUG_AMBIG:
        tag = _resolve_aug(text, start, end)
    elif ending == "е" and tag is not None and tag[1] == "sg":
        # "е" — дательный или предложный: смотрим на предлог перед словом.
        match = re.search(r"([^\W\d_]+)\s*$", text[:start], re.UNICODE)
        previous = match.group(1).lower() if match else ""
        if previous in _PREP_CUES:
            tag = ("prep", "sg")
        elif previous in _DAT_CUES:
            tag = ("dat", "sg")
    if tag is None:
        value = replacement
    else:
        gender_hint = None
        if tag[1] == "sg":
            if ending in ("ая", "яя", "ья", "ою", "ею", "ую", "юю", "ью"):
                gender_hint = "f"
            elif ending in ("ой", "ей") and tag[0] in ("ins", "gen", "dat", "prep"):
                gender_hint = "f"
            elif ending in ("ое", "ее", "ье"):
                gender_hint = "n"
        value = _inflect_phrase(
            replacement, tag[0], tag[1], ending in ("ою", "ею"), gender_hint
        )
    if capital and value:
        return value[:1].upper() + value[1:]
    return value

def _collapse(text):
    chars = []
    starts = []
    ends = []
    previous = None
    for index, char in enumerate(text):
        if previous is not None and char.isalpha() and char.lower() == previous.lower():
            ends[-1] = index + 1
            continue
        chars.append(char)
        starts.append(index)
        ends.append(index + 1)
        previous = char
    return "".join(chars), starts, ends

def _replace(text, direct, stretched, replacement, endings):
    text = direct.sub(
        lambda match: _shape(
            replacement,
            match.groupdict().get("_end") or "",
            endings,
            text,
            match.start(),
            match.end(),
            match.group(0)[:1].isupper(),
        ),
        text,
    )
    if not _RUN_RE.search(text):
        return text
    collapsed, starts, ends = _collapse(text)
    parts = []
    position = 0
    changed = False
    for match in stretched.finditer(collapsed):
        start = starts[match.start()]
        end = ends[match.end() - 1]
        if start < position:
            continue
        parts.append(text[position:start])
        parts.append(
            _shape(
                replacement,
                match.groupdict().get("_end") or "",
                endings,
                collapsed,
                match.start(),
                match.end(),
                text[start:start + 1].isupper(),
            )
        )
        position = end
        changed = True
    if not changed:
        return text
    parts.append(text[position:])
    return "".join(parts)

def _clean(text):
    if not text:
        return text
    for direct, stretched, replacement, endings in _RULES:
        text = _replace(text, direct, stretched, replacement, endings)
    return text

def _get_raw_id(entity_id):
    if entity_id is None:
        return None
    try:
        return int(entity_id.longValue())
    except Exception:
        try:
            return int(entity_id)
        except Exception:
            return None

class _BadgeHook(MethodHook):
    def __init__(self, manager):
        super().__init__()
        self.manager = manager

    def before_hooked_method(self, param):
        try:
            if not param.args or param.args[0] is None:
                return
            entity_id = param.args[0]
            raw_id = _get_raw_id(entity_id)
            if raw_id is not None and raw_id in self.manager.custom_badges:
                param.setResult(self.manager.custom_badges[raw_id])
            elif entity_id in self.manager.custom_badges:
                param.setResult(self.manager.custom_badges[entity_id])
        except Exception:
            pass

class _CreatorBadgeManager:
    def __init__(self, plugin):
        self.plugin = plugin
        self.custom_badges = {}
        self._hook_refs = []
        self.api_badge_source = None

    def setup(self):
        try:
            self._get_api_badge_source()
            if not self._hook_refs:
                self._setup_hooks()
            self._load_badges()
        except Exception:
            pass

    def _get_api_badge_source(self):
        try:
            BadgesController = find_class("com.exteragram.messenger.badges.BadgesController")
            if not BadgesController:
                return
            instance = getattr(BadgesController, "INSTANCE", None)
            if not instance:
                try:
                    field = BadgesController.getClass().getDeclaredField("INSTANCE")
                    field.setAccessible(True)
                    instance = field.get(None)
                except Exception:
                    pass
            if instance:
                self.api_badge_source = get_private_field(instance, "apiBadgeSource")
        except Exception:
            pass

    def _setup_hooks(self):
        try:
            ApiBadgeSource = find_class("com.exteragram.messenger.badges.source.ApiBadgeSource")
            if not ApiBadgeSource:
                return
            methods = []
            try:
                if hasattr(ApiBadgeSource, "getDeclaredMethods"):
                    methods = list(ApiBadgeSource.getDeclaredMethods())
                elif hasattr(ApiBadgeSource, "getClass"):
                    methods = list(ApiBadgeSource.getClass().getDeclaredMethods())
            except Exception:
                pass
            for method in methods:
                try:
                    if hasattr(method, "getName") and method.getName() == "getBadge":
                        method.setAccessible(True)
                        ref = self.plugin.hook_method(method, _BadgeHook(self))
                        if ref is not None:
                            self._hook_refs.append(ref)
                except Exception:
                    pass
        except Exception:
            pass

    def _load_badges(self):
        #если ты это читаешь, напиши @syspz в лс тетрагидропиранилциклопентилтетрагидропиридопиридиновые
        try:
            if not self.api_badge_source:
                self._get_api_badge_source()
            dto_class = BadgeDTO or find_class("com.exteragram.messenger.api.dto.BadgeDTO")
            BadgeInfo = find_class("com.exteragram.messenger.badges.source.BadgeInfo")
            ProfileStatus = find_class("com.exteragram.messenger.api.model.ProfileStatus")
            text = CREATOR_BADGE_TEXT_EN if self.plugin._is_en() else CREATOR_BADGE_TEXT_RU
            dto = None
            if dto_class:
                try:
                    dto = dto_class(CREATOR_EMOJI_ID, text)
                except Exception:
                    try:
                        dto = dto_class(Long.valueOf(CREATOR_EMOJI_ID), String(text))
                    except Exception:
                        pass
            if not dto:
                return
            j_uid = CREATOR_ID
            try:
                if Long is not None:
                    j_uid = Long.valueOf(CREATOR_ID)
            except Exception:
                j_uid = CREATOR_ID
            self.custom_badges[CREATOR_ID] = dto
            try:
                self.custom_badges[j_uid] = dto
            except Exception:
                pass
            cache = None
            if self.api_badge_source:
                cache = get_private_field(self.api_badge_source, "cache")
            info_status = None
            if ProfileStatus:
                info_status = getattr(ProfileStatus, "NONE", None) or getattr(ProfileStatus, "DEFAULT", None)
            if cache is not None and BadgeInfo:
                info = None
                try:
                    info = BadgeInfo(dto, info_status, False)
                except Exception:
                    try:
                        info = BadgeInfo(dto, None, False)
                    except Exception:
                        pass
                if info:
                    try:
                        cache.put(j_uid, info)
                    except Exception:
                        pass
        except Exception:
            pass

    def cleanup(self):
        try:
            for ref in self._hook_refs:
                try:
                    self.plugin.unhook_method(ref)
                except Exception:
                    pass
            self._hook_refs.clear()
            if self.api_badge_source:
                try:
                    cache = get_private_field(self.api_badge_source, "cache")
                    if cache is not None:
                        try:
                            cache.remove(Long.valueOf(CREATOR_ID))
                        except Exception:
                            cache.remove(CREATOR_ID)
                except Exception:
                    pass
            self.custom_badges.clear()
        except Exception:
            pass

class AntimatPlusPlugin(BasePlugin):
    def _is_en(self):
        value = self.get_setting("badge_english", False)
        if isinstance(value, str):
            return value.lower() in ("1", "true", "yes", "on")
        return bool(value)

    def _word_filter_enabled(self):
        value = self.get_setting("word_filter_enabled", True)
        if isinstance(value, str):
            return value.lower() not in ("0", "false", "no", "off", "")
        return bool(value)

    def on_plugin_load(self):
        self.add_on_send_message_hook()
        self._badge_manager = _CreatorBadgeManager(self)
        try:
            run_on_ui_thread(self._badge_manager.setup, 1500)
            run_on_ui_thread(self._badge_manager.setup, 4000)
        except Exception:
            self._badge_manager.setup()
        self.log("Антимат+ на связи")

    def on_plugin_unload(self):
        manager = getattr(self, "_badge_manager", None)
        if manager:
            manager.cleanup()

    def create_settings(self):
        en = self._is_en()
        return [
            Header(text="Antimat+" if en else "Антимат+"),
            Switch(
                key="word_filter_enabled",
                text="Word filter" if en else "Фильтр слов",
                default=True,
                subtext="Replace profanity in outgoing messages"
                if en else "Заменять мат и грубые слова в исходящих сообщениях",
            ),
            Switch(
                key="badge_english",
                text="English badge text" if en else "Английский текст бейджа",
                default=False,
                subtext="Swearer instead of Матерширник"
                if en else "Swearer вместо Матерширник",
                on_change=lambda _value: getattr(self, "_badge_manager", None)
                and self._badge_manager._load_badges(),
            ),
            Divider(),
        ]

    def on_send_message_hook(self, account, params):
        if not self._word_filter_enabled():
            return HookResult()
        original_message = getattr(params, "message", None)
        original_caption = getattr(params, "caption", None)
        message = _clean(original_message)
        caption = _clean(original_caption)
        if message == original_message and caption == original_caption:
            return HookResult()
        if message != original_message:
            params.message = message
            if getattr(params, "entities", None):
                params.entities = None
        if caption != original_caption:
            params.caption = caption
        self.log("Отфильтровано исходящее сообщение")
        # Ну что, попался?) Шлём твоей маме все твои матерные сообщения
        return HookResult(strategy=HookStrategy.MODIFY_FINAL, params=params)