class _PyFileW:
    def __init__(self, f):
        self.f = f

    def write(self, text):
        self.f.write(text)

    def flush(self):
        self.f.flush()

    def close(self):
        self.f.close()


class _JStreamW:
    def __init__(self, stream):
        self.s = stream

    def write(self, text):
        from java import jarray, jbyte
        data = text.encode("utf-8")
        self.s.write(jarray(jbyte)([b - 256 if b > 127 else b for b in data]))

    def flush(self):
        self.s.flush()

    def close(self):
        self.s.close()


class _FileSink:
    SUBDIR = "memory_monitor"

    def __init__(self):
        self._q = queue.Queue()
        self._thread = None
        self._lock = threading.Lock()
        self._stop = False
        self._w = {}
        self._where = {}
        self._errs = []
        self._session = time.strftime("%Y%m%d_%H%M%S")

    def start(self):
        with self._lock:
            if self._thread is not None and self._thread.is_alive():
                return
            self._stop = False
            self._thread = threading.Thread(target=self._run, daemon=True)
            self._thread.start()

    def stop(self):
        self._stop = True
        self._q.put(None)
        t = self._thread
        if t is not None:
            t.join(1.0)

    @staticmethod
    def _ts():
        t = time.time()
        return time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(t)) + ".%03d" % int((t % 1) * 1000)

    def _put(self, item):
        if self._stop or self._q.qsize() > 20000:
            return
        self._q.put(item)

    def log(self, text):
        self._put(("log", "%s %s\n" % (self._ts(), text)))

    def metric(self, name, n, mean, p50, p95, mx):
        self._put(("metric", "%s,%s,%d,%.2f,%.2f,%.2f,%.2f\n" % (self._ts(), name, n, mean, p50, p95, mx)))

    def file(self, name, text):
        self._put(("file:" + name, text))

    def where_text(self):
        parts = ["%s -> %s" % (k, v) for k, v in sorted(self._where.items())]
        if self._errs:
            parts.append("fail: " + " | ".join(self._errs[-4:]))
        return "; ".join(parts) or "(ещё не открыт)"

    def _run(self):
        while True:
            item = self._q.get()
            batch = [item]
            try:
                while len(batch) < 500:
                    batch.append(self._q.get_nowait())
            except queue.Empty:
                pass
            done = False
            for it in batch:
                if it is None:
                    done = True
                    continue
                try:
                    self._write(it[0], it[1])
                except Exception as e:
                    self._errs.append("write %s: %s" % (it[0], e))
            for w in list(self._w.values()):
                try:
                    w.flush()
                except Exception:
                    pass
            if done:
                break
        for w in list(self._w.values()):
            try:
                w.close()
            except Exception:
                pass
        self._w = {}

    def _write(self, kind, text):
        w = self._w.get(kind)
        if w is None:
            w = self._open(kind)
            if w is None:
                return
            self._w[kind] = w
            if kind == "metric":
                w.write("ts,metric,n,mean_ms,p50_ms,p95_ms,max_ms\n")
            elif kind == "log":
                w.write("# memory_monitor log, session %s, %s\n" % (self._session, self._where.get(kind)))
        w.write(text)
        if kind.startswith("file:"):
            w.flush()
            w.close()
            del self._w[kind]

    def _open(self, kind):
        if kind == "log":
            name, mime = "memory_monitor_%s.log" % self._session, "text/plain"
        elif kind == "metric":
            name, mime = "metrics_%s.csv" % self._session, "text/csv"
        else:
            name, mime = kind[5:], "text/plain"
        for mode in ("dir", "ms", "app", "int"):
            try:
                w, where = self._open_mode(mode, name, mime)
            except Exception as e:
                self._errs.append("%s: %s" % (mode, str(e)[:80]))
                continue
            self._where[kind] = where
            return w
        return None

    def _open_dir(self, d, name, label):
        os.makedirs(d, exist_ok=True)
        path = os.path.join(d, name)
        return _PyFileW(open(path, "a", encoding="utf-8")), "%s %s" % (label, path)

    def _dir_candidates(self):
        out = []
        try:
            Env = find_class('android.os.Environment')
            out.append(os.path.join(str(Env.getExternalStoragePublicDirectory('Download').getAbsolutePath()), self.SUBDIR))
        except Exception:
            pass
        for base in ('/storage/emulated/0/Download', '/sdcard/Download', '/storage/sdcard0/Download'):
            p = os.path.join(base, self.SUBDIR)
            if p not in out:
                out.append(p)
        return out

    def _open_mode(self, mode, name, mime):
        if mode == 'dir':
            last = None
            for d in self._dir_candidates():
                try:
                    jf = File(d)
                    if not jf.exists():
                        jf.mkdirs()
                    if not (jf.exists() and jf.isDirectory() and jf.canWrite()):
                        raise RuntimeError('not writable')
                    return self._open_dir(d, name, 'dir')
                except Exception as e:
                    last = '%s: %s' % (d, str(e)[:60])
            raise RuntimeError(last or 'no candidates')
        ctx = find_class('org.telegram.messenger.ApplicationLoader').applicationContext
        if mode == 'ms':
            CV = find_class('android.content.ContentValues')
            MSD = find_class('android.provider.MediaStore$Downloads')
            cv = CV()
            cv.put('_display_name', name)
            cv.put('mime_type', mime)
            cv.put('relative_path', 'Download/' + self.SUBDIR)
            cr = ctx.getContentResolver()
            uri = cr.insert(MSD.EXTERNAL_CONTENT_URI, cv)
            if uri is None:
                raise RuntimeError('insert returned null')
            return _JStreamW(cr.openOutputStream(uri)), 'MediaStore Download/%s/%s' % (self.SUBDIR, name)
        if mode == 'app':
            d = ctx.getExternalFilesDir(None)
            if d is None:
                raise RuntimeError('no external files dir')
            return self._open_dir(os.path.join(str(d.getAbsolutePath()), self.SUBDIR), name, 'app')
        return self._open_dir(os.path.join(str(ctx.getFilesDir().getAbsolutePath()), self.SUBDIR), name, 'int')


