): %d', 'fmt_gfx_total': 'Graphics + unmapped dma-buf: %s', 'fmt_fd_top_header': 'Top FD categories:', 'fmt_fd_row': '  %d × %s  (%s)', 'fmt_source': 'Source: %s', 'fmt_no_data': 'no data', 'src_ok': 'native libmemmon.so (ABI %s, rev %s)', 'src_layout_drift': 'native loaded, smaps layer off (layout drift) — rebuild .so', 'src_smaps_selftest_failed': 'native loaded, smaps groups off (selftest fail)', 'src_abi_mismatch': 'ABI mismatch (.so=%s, need %s) — rebuild and embed .so', 'src_no_so': '.so not embedded — embed via embed_so_mmp.py; no PSS/RSS/RAM/FD data', 'src_no_ctypes': 'ctypes unavailable — core not loaded', 'src_error': '.so load error'}, 'ru': {'set_header': 'Memory Monitor Pro v%s', 'set_enable_pill': 'Включить виджет', 'set_interval_row': 'Интервал: %s сек', 'set_display_mode': 'Режим виджета', 'set_click_action': 'Действие по клику', 'set_color_header': 'Цвет и пороги', 'set_color_mode': 'Цвет виджета', 'set_warn_row': 'Оранжевый порог: %s МБ', 'set_crit_row': 'Красный порог: %s МБ', 'click_refresh': 'Обновить', 'click_cycle': 'Сменить режим', 'click_live': 'Живой монитор', 'color_auto': 'Авто по PSS', 'color_system': 'Системный', 'color_white': 'Белый', 'menu_refresh': 'Обновить', 'menu_live': 'Живой монитор (все типы)', 'menu_cycle': 'Сменить режим (сейчас: %s)', 'menu_plugin_settings': 'Настройки виджета', 'menu_restart': 'Рестарт приложения', 'live_title': 'Memory Monitor Pro — реальное время', 'live_close': 'Закрыть', 'err_prefix': 'ошибка', 'dlg_interval_title': 'Интервал обновления', 'dlg_warn_title': 'Оранжевый порог', 'dlg_crit_title': 'Красный порог', 'dlg_range_hint': '%d–%d', 'btn_save': 'Сохранить', 'btn_cancel': 'Отмена', 'mode_all': 'Все типы (ротация)', 'mode_pss': 'PSS процесса', 'mode_rss': 'RSS процесса', 'mode_java': 'Java-heap', 'mode_native': 'Native-heap', 'mode_graphics': 'Graphics', 'mode_code': 'Code', 'mode_stack': 'Stack', 'mode_ram': 'RAM устройства', 'mode_pss_java': 'PSS + Java', 'fmt_proc_full': 'Процесс: PSS %s · RSS %s · Swap %s', 'fmt_proc_rss': 'Процесс: RSS %s (statm)', 'fmt_java': 'Java-heap: %s / %s (max %s)', 'fmt_native': 'Native-heap: %s / %s', 'fmt_andro_header': 'Типы памяти Android (Debug.MemoryInfo):', 'fmt_ram': 'RAM устройства: занято %s из %s (доступно %s)', 'fmt_swap': 'Swap устройства: занято %s из %s', 'fmt_fd': 'FD: %d (%s)', 'fmt_fd_total': 'FD: %d', 'fmt_groups_header': 'Топ smaps-групп по PSS:', 'fmt_group_row': '  %s — %s (rss %s, maps %d)', 'fmt_rss_split': 'RSS: anon %s · file %s · shmem %s', 'fmt_proc_misc': 'Потоков: %d · пик RSS %s · VmSwap %s', 'fmt_dmabuf': 'dma-buf (FD): %d буферов, %s (не отображены, вне smaps: %s)', 'fmt_dmabuf_unk': '  dma-buf FD без размера (старое ядро): %d', 'fmt_gfx_total': 'Graphics + немапнутые dma-buf: %s', 'fmt_fd_top_header': 'Топ категорий FD:', 'fmt_fd_row': '  %d × %s  (%s)', 'fmt_source': 'Источник: %s', 'fmt_no_data': 'нет данных', 'src_ok': 'натив libmemmon.so (ABI %s, rev %s)', 'src_layout_drift': 'натив загружен, smaps-слой отключён (layout drift) — пересобери .so', 'src_smaps_selftest_failed': 'натив загружен, smaps-группы отключены (selftest fail)', 'src_abi_mismatch': 'ABI mismatch (.so=%s, нужно %s) — пересобери и вшей .so', 'src_no_so': '.so не вшит — вшей через embed_so_mmp.py; данных PSS/RSS/RAM/FD нет', 'src_no_ctypes': 'ctypes недоступен — ядро не загружено', 'src_error': 'ошибка загрузки .so'}}

# 1 JNI-вызов для сбора всех 15 метрик Runtime + Debug + MemoryInfo.
MM_COLLECT_STATS_MVEL = """
Debug.getMemoryInfo(mi);
return rt.maxMemory() + "," + rt.totalMemory() + "," + rt.freeMemory() + "," +
       Debug.getNativeHeapAllocatedSize() + "," + Debug.getNativeHeapSize() + "," + Debug.getNativeHeapFreeSize() + "," +
       mi.getMemoryStat("summary.java-heap") + "," +
       mi.getMemoryStat("summary.native-heap") + "," +
       mi.getMemoryStat("summary.code") + "," +
       mi.getMemoryStat("summary.stack") + "," +
       mi.getMemoryStat("summary.graphics") + "," +
       mi.getMemoryStat("summary.private-other") + "," +
       mi.getMemoryStat("summary.system") + "," +
       mi.getMemoryStat("summary.total-pss") + "," +
       mi.getMemoryStat("summary.total-swap");
"""

# Лёгкий вариант без Debug.getMemoryInfo (он обходит smaps и дорогой): только Runtime + native heap (6 метрик).
MM_COLLECT_LITE_MVEL = """
return rt.maxMemory() + "," + rt.totalMemory() + "," + rt.freeMemory() + "," +
       Debug.getNativeHeapAllocatedSize() + "," + Debug.getNativeHeapSize() + "," + Debug.getNativeHeapFreeSize();
"""

# 1 JNI-вызов на ежесекундный UI-тик (ensure + sync_theme + _render).
# java_instance (this) — строка формата "enabled|colorInt|text".
MM_RENDER_TICK_MVEL = """
int p1 = indexOf('|');
int p2 = indexOf('|', p1 + 1);
boolean enabled = substring(0, p1).equals("1");

if (!enabled) {
    if (root.getVisibility() != 8) root.setVisibility(8);
    return true;
}

frag = LaunchActivity.getSafeLastFragment();
if (frag != null && frag.getParentActivity() != null) {
    if (!root.getContext().equals(frag.getParentActivity())) {
        return false;
    }
}
if (!root.isAttachedToWindow()) {
    return false;
}
if (root.getVisibility() != 0) root.setVisibility(0);

par = root.getParent();
if (par != null) {
    int n = par.getChildCount();
    if (n > 0 && !par.getChildAt(n - 1).equals(root)) {
        root.bringToFront();
    }
}

int baseBg = Theme.getColor(key_bg);
bg.setColor((int) ((baseBg & 16777215) | -436207616));

int colorInt = Integer.parseInt(substring(p1 + 1, p2));
tv.setText(substring(p2 + 1));

if (colorInt != 0) {
    tv.setTextColor(colorInt);
    iv.setColorFilter(colorInt);
} else {
    iv.clearColorFilter();
    tv.setTextColor(Theme.getColor(key_txt));
}
return true;
"""

# 1 JNI-вызов на событие касания в MMDragListener.
# java_instance (this) — сам объект MotionEvent (ev).
MM_TOUCH_MVEL = """
int a = getActionMasked();

if (a == 0) {
    v.animate().cancel();
    x0 = getRawX();
    y0 = getRawY();
    tx = v.getTranslationX();
    ty = v.getTranslationY();
    par = v.getParent();
    if (par != null) {
        int mw = par.getWidth() - v.getWidth();
        int mh = par.getHeight() - v.getHeight();
        if (mw < 0) mw = 0;
        if (mh < 0) mh = 0;
        maxX = (float) mw;
        maxY = (float) mh;
    } else {
        maxX = 10000f;
        maxY = 10000f;
    }
    moved = false;
    menu_shown = false;
    v.postDelayed(lp_run, lpt);
    return "";
}

if (a == 2) {
    float dx = getRawX() - x0;
    float dy = getRawY() - y0;
    if (!moved && (dx > slop || dx < (0 - slop) || dy > slop || dy < (0 - slop))) {
        moved = true;
        v.removeCallbacks(lp_run);
    }
    if (moved && !menu_shown) {
        float nx = tx + dx;
        float ny = ty + dy;
        if (nx > maxX) nx = maxX;
        if (nx < 0) nx = nx * 0;
        if (ny > maxY) ny = maxY;
        if (ny < 0) ny = ny * 0;
        v.setTranslationX((float) nx);
        v.setTranslationY((float) ny);
    }
    return "";
}

if (a == 1 || a == 3) {
    v.removeCallbacks(lp_run);
    if (menu_shown) {
        return (a == 1) ? "M" : "";
    } else if (moved) {
        float curX = v.getTranslationX();
        float curY = v.getTranslationY();
        float parentW = maxX + v.getWidth();
        float center = curX + v.getWidth() / 2f;
        float leftEdge = edgeMargin;
        if (leftEdge > maxX) leftEdge = maxX;
        float rightEdge = maxX - edgeMargin;
        if (rightEdge < leftEdge) rightEdge = leftEdge;
        float targetX = (center <= parentW / 2f) ? leftEdge : rightEdge;
        v.animate().translationX((float) targetX).setDuration(200).start();
        return ((int) targetX) + "," + ((int) curY);
    } else if (a == 1) {
        return "C";
    }
}
return "";
"""


def _get_lang():
    try:
        LocaleController = find_class('org.telegram.messenger.LocaleController')
        if LocaleController is not None:
            lc = LocaleController.getInstance()
            if lc is not None and hasattr(lc, 'getCurrentLocale'):
                locale = lc.getCurrentLocale()
                if locale is not None and hasattr(locale, 'getLanguage'):
                    if locale.getLanguage() == 'ru':
                        return 'ru'
    except Exception:
        pass
    return 'en'


def _tr(key):
    return STRINGS.get(_get_lang(), STRINGS['en']).get(key, key)


def _mode_names():
    return [_tr('mode_all'), _tr('mode_pss'), _tr('mode_rss'), _tr('mode_java'), _tr('mode_native'), _tr('mode_graphics'), _tr('mode_code'), _tr('mode_stack'), _tr('mode_ram'), _tr('mode_pss_java')]


def _fmt_bytes(n):
    try:
        n = float(n)
    except Exception:
        return '?'
    if n >= 1024 * _MB:
        return '%.2f GB' % (n / (1024 * _MB))
    if n >= 100 * _MB:
        return '%d MB' % int(n / _MB)
    return '%.1f MB' % (n / _MB)


_PROXY_LOCK = threading.Lock()
_R_CLS = None
_TOUCH_CLS = None
_NOACT_BACKOFF_S = 5.0   # нет Activity: ensure() с воркера не чаще раза в это время (как +OW L3 в Culprit)


def _runnable(fn, log=None):
    # Класс dynamic_proxy(Runnable) объявляется РОВНО ОДИН РАЗ и переиспользуется (как _wg_runnable
    # в Culprit Detector, +OV fix). Повторное объявление нового подкласса на каждый вызов портит
    # внутреннее состояние Chaquopy -> позже AttributeError: ... '_chaquopyGetDict'. fn и log
    # хранятся атрибутами экземпляра.
    global _R_CLS
    cls = _R_CLS
    if cls is None:
        with _PROXY_LOCK:
            cls = _R_CLS
            if cls is None:
                Runnable = find_class('java.lang.Runnable')

                class _R(dynamic_proxy(Runnable)):
                    def __init__(self, f, lg=None):
                        super().__init__()
                        self._f = f
                        self._lg = lg

                    def run(self):
                        try:
                            self._f()
                        except Exception as e:
                            lg = self._lg
                            if lg:
                                lg('runnable err: %s' % e)
                _R_CLS = cls = _R
    return cls(fn, log)


def _touch_proxy(fn):
    # То же для View.OnTouchListener: раньше MMDragListener объявлялся заново при каждой пересборке
    # View (смена Activity). fn(v, ev) -> bool хранится атрибутом экземпляра.
    global _TOUCH_CLS
    cls = _TOUCH_CLS
    if cls is None:
        with _PROXY_LOCK:
            cls = _TOUCH_CLS
            if cls is None:
                L = find_class('android.view.View$OnTouchListener')

                class _TouchL(dynamic_proxy(L)):
                    def __init__(self, f):
                        super().__init__()
                        self._f = f

                    def onTouch(self, v, ev):
                        try:
                            return bool(self._f(v, ev))
                        except Exception:
                            return False
                _TOUCH_CLS = cls = _TouchL
    return cls(fn)


_UI_LOCK = threading.Lock()
_UI_CLS = None
_UI_HANDLER = None
_UI_LOG = [None]


def _post_ui(fn):
    # Один Handler главного looper'а и общий Runnable-класс (_runnable): отдельный _UiR больше не нужен.
    global _UI_HANDLER
    try:
        h = _UI_HANDLER
        if h is None:
            with _UI_LOCK:
                if _UI_HANDLER is None:
                    Looper = find_class('android.os.Looper')
                    Handler = find_class('android.os.Handler')
                    _UI_HANDLER = Handler(Looper.getMainLooper())
                h = _UI_HANDLER
        h.post(_runnable(fn, _UI_LOG[0]))
        return True
    except Exception:
        try:
            run_on_ui_thread(fn)
        except Exception:
            pass
        return False


class MemoryMonitorEngine:

    def __init__(self, log):
        self._log = log
        self.lib = None
        self.native_ok = False
        self.smaps_ok = False
        self.state = 'no_so'
        self.abi_seen = None
        self.build_rev = None
        self._stats_ctx = None
        self._stats_lock = threading.Lock()
        try:
            ctx = HashMap()
            ctx.put('rt', find_class('java.lang.Runtime').getRuntime())
            ctx.put('Debug', find_class('android.os.Debug'))
            ctx.put('mi', find_class('android.os.Debug$MemoryInfo')())
            self._stats_ctx = ctx
        except Exception as e:
            self._log('stats ctx init err: %s' % e)
        self.tick2_ok = False        # доступны ли mm_tick2 / mm_dmabuf_scan / mm_fd_census (ABI 3, layout сошёлся)
        self._pss_cache = None       # (monotonic, pss) — последний реальный PSS для цвета/тренда без rollup
        self._dmb_cache = {'ts': -1e9, 'v': None}
        self._mvel_err_n = 0         # подряд ошибок MVEL-сбора (лог — первая и каждая 300-я)

    def _native_dir(self):
        try:
            ApplicationLoader = find_class('org.telegram.messenger.ApplicationLoader')
            ctx = ApplicationLoader.applicationContext
            d = File(ctx.getFilesDir(), 'memory_monitor_pro')
            if not d.exists():
                d.mkdirs()
            return d.getAbsolutePath()
        except Exception:
            return None

    def _extract_so(self):
        if not _SO_ARM64:
            return None
        try:
            import base64, zlib
            raw = zlib.decompress(base64.b64decode(_SO_ARM64))
            base = self._native_dir()
            if not base:
                return None
            path = os.path.join(base, _SO_NAME)
            jf = File(path)
            try:
                if jf.exists() and int(jf.length()) == len(raw):
                    with open(path, 'rb') as ef:
                        if ef.read() == raw:
                            return path
            except Exception:
                pass
            try:
                if jf.exists():
                    jf.setWritable(True, True)
                    jf.delete()
            except Exception:
                pass
            try:
                with open(path, 'wb') as f:
                    f.write(raw)
            except OSError as we:
                if jf.exists():
                    self._log('extract: использую существующий .so (запись недоступна: %s)' % we)
                    return path
                raise
            try:
                jf2 = File(path)
                jf2.setReadable(True, False)
                jf2.setExecutable(True, False)
            except Exception:
                pass
            return path
        except Exception as e:
            self._log('extract err: %s' % e)
            return None

    def _declare(self, lib):
        c = ctypes
        lib.mm_abi_version.restype = c.c_int32
        lib.mm_build_rev.restype = c.c_int32
        lib.mm_smaps_group_count.restype = c.c_int32
        lib.mm_smaps_field_count.restype = c.c_int32
        lib.mm_smaps_layout_version.restype = c.c_int32
        lib.mm_smaps_groups.argtypes = [c.POINTER(c.c_int64), c.c_int32]
        lib.mm_smaps_groups.restype = c.c_int32
        lib.mm_smaps_rollup.argtypes = [c.POINTER(c.c_int64), c.c_int32]
        lib.mm_smaps_rollup.restype = c.c_int32
        lib.mm_smaps_selftest.restype = c.c_int32
        lib.mm_meminfo.argtypes = [c.POINTER(c.c_int64), c.c_int32]
        lib.mm_meminfo.restype = c.c_int32
        lib.mm_statm_rss.restype = c.c_int64
        lib.mm_fd_count.restype = c.c_int32
        lib.mm_tick.argtypes = [c.POINTER(c.c_int64), c.c_int32]
        lib.mm_tick.restype = c.c_int32
        lib.mm_fd_kinds.argtypes = [c.POINTER(c.c_int64), c.c_int32]
        lib.mm_fd_kinds.restype = c.c_int32

    def _declare_v3(self, lib):
        c = ctypes
        lib.mm_tick2.argtypes = [c.POINTER(c.c_int64), c.c_int32, c.c_int32]
        lib.mm_tick2.restype = c.c_int32
        lib.mm_tick2_field_count.restype = c.c_int32
        lib.mm_dmabuf_scan.argtypes = [c.POINTER(c.c_int64), c.c_int32]
        lib.mm_dmabuf_scan.restype = c.c_int32
        lib.mm_dmabuf_field_count.restype = c.c_int32
        lib.mm_fd_census.argtypes = [c.c_char_p, c.c_int32]
        lib.mm_fd_census.restype = c.c_int32

    def load_native(self):
        if not _CTYPES_OK:
            self.state = 'no_ctypes'
            self._log('ctypes недоступен — ядро не загрузить, данных PSS/RSS/RAM/FD не будет')
            return
        if not _SO_ARM64:
            self.state = 'no_so'
            self._log('.so не вшит (_SO_ARM64 пуст) — запусти embed_so_mmp.py; без ядра данных PSS/RSS/RAM/FD нет')
            return
        try:
            path = self._extract_so()
            if not path:
                self.state = 'error'
                return
            lib = ctypes.CDLL(path)
            self._declare(lib)
            abi = int(lib.mm_abi_version())
            self.abi_seen = abi
            if abi != MM_ABI_EXPECT:
                self.state = 'abi_mismatch'
                self._log('ABI MISMATCH .so=%d, нужно %d — натив отключён, пересобери libmemmon.so' % (abi, MM_ABI_EXPECT))
                return
            try:
                self.build_rev = int(lib.mm_build_rev())
            except Exception:
                self.build_rev = None
            layout_ok = True
            try:
                if int(lib.mm_smaps_group_count()) != len(_SMAPS_GROUPS):
                    layout_ok = False
                if int(lib.mm_smaps_field_count()) != _SMAPS_FIELDS:
                    layout_ok = False
                if int(lib.mm_smaps_layout_version()) != _SMAPS_LAYOUT_VERSION:
                    layout_ok = False
            except Exception:
                layout_ok = False
            try:
                self._declare_v3(lib)
                self.tick2_ok = (int(lib.mm_tick2_field_count()) == _TICK2_FIELDS and
                                 int(lib.mm_dmabuf_field_count()) == _DMABUF_FIELDS)
            except Exception:
                self.tick2_ok = False
            if not self.tick2_ok:
                self._log('mm_tick2/dmabuf/census недоступны (layout) — работаю на mm_tick')
            self.lib = lib
            self.native_ok = True
            self.smaps_ok = bool(layout_ok)
            if layout_ok:
                try:
                    selftest = int(lib.mm_smaps_selftest())
                except Exception:
                    selftest = -1
                if selftest <= 0:
                    self.smaps_ok = False
                    self.state = 'smaps_selftest_failed'
                    self._log('smaps selftest FAIL (%d) — группы отключены; rollup/meminfo/tick активны' % selftest)
                else:
                    self.state = 'ok'
                    self._log('натив OK: ABI=%d rev=%s selftest groups=%d' % (abi, self.build_rev, selftest))
            else:
                self.state = 'layout_drift'
                self._log('layout drift .so vs плагин — smaps-группы отключены (защита от неверной атрибуции)')
        except Exception as e:
            self.state = 'error'
            self.lib = None
            self.native_ok = False
            self._log('load_native err: %s' % e)

    def smaps_rollup(self):
        if self.native_ok and self.lib is not None:
            try:
                arr = (ctypes.c_int64 * 3)()
                if int(self.lib.mm_smaps_rollup(arr, ctypes.c_int32(3))) >= 3:
                    return {'pss': int(arr[0]), 'rss': int(arr[1]), 'swap': int(arr[2]), 'src': 'native'}
            except Exception:
                pass
        return None

    def statm_rss(self):
        if self.native_ok and self.lib is not None:
            try:
                v = int(self.lib.mm_statm_rss())
                if v > 0:
                    return v
            except Exception:
                pass
        return 0

    def meminfo(self):
        if self.native_ok and self.lib is not None:
            try:
                arr = (ctypes.c_int64 * 4)()
                if int(self.lib.mm_meminfo(arr, ctypes.c_int32(4))) >= 4:
                    return {'total': int(arr[0]), 'avail': int(arr[1]), 'swap_total': int(arr[2]), 'swap_free': int(arr[3]), 'src': 'native'}
            except Exception:
                pass
        return None

    def java_heap(self):
        try:
            rt = find_class('java.lang.Runtime').getRuntime()
            mx = int(rt.maxMemory())
            tot = int(rt.totalMemory())
            fr = int(rt.freeMemory())
            return {'used': tot - fr, 'total': tot, 'max': mx}
        except Exception:
            return None

    def native_heap(self):
        try:
            Debug = find_class('android.os.Debug')
            return {'alloc': int(Debug.getNativeHeapAllocatedSize()), 'total': int(Debug.getNativeHeapSize()), 'free': int(Debug.getNativeHeapFreeSize())}
        except Exception:
            return None

    def debug_summary(self):
        try:
            Debug = find_class('android.os.Debug')
            MemoryInfo = find_class('android.os.Debug$MemoryInfo')
            mi = MemoryInfo()
            Debug.getMemoryInfo(mi)
            out = {}
            for key in ('java-heap', 'native-heap', 'code', 'stack', 'graphics', 'private-other', 'system', 'total-pss', 'total-swap'):
                try:
                    v = mi.getMemoryStat('summary.' + key)
                    if v is not None:
                        out[key] = int(str(v)) * 1024
                except Exception:
                    pass
            return out or None
        except Exception:
            return None

    def native_tick(self):
        if not (self.native_ok and self.lib is not None):
            return None
        try:
            arr = (ctypes.c_int64 * 9)()
            if int(self.lib.mm_tick(arr, ctypes.c_int32(9))) >= 9:
                nt = {}
                if int(arr[0]) > 0 or int(arr[1]) > 0:
                    nt['pss'] = int(arr[0])
                    nt['rss'] = int(arr[1])
                    nt['swap'] = int(arr[2])
                elif int(arr[3]) > 0:
                    nt['rss'] = int(arr[3])
                if int(arr[4]) > 0:
                    nt['dev'] = {'total': int(arr[4]), 'avail': int(arr[5]), 'swap_total': int(arr[6]), 'swap_free': int(arr[7]), 'src': 'native'}
                if int(arr[8]) > 0:
                    nt['fd_total'] = int(arr[8])
                return nt or None
        except Exception:
            pass
        return None

    def native_tick2(self, want_pss):
        if not (self.native_ok and self.tick2_ok and self.lib is not None):
            return None
        try:
            arr = (ctypes.c_int64 * _TICK2_FIELDS)()
            rc = int(self.lib.mm_tick2(arr, ctypes.c_int32(_TICK2_FIELDS), ctypes.c_int32(1 if want_pss else 0)))
            if rc < _TICK2_FIELDS:
                return None
            nt = {}
            applied = int(arr[15])
            if (applied & 1) and (int(arr[0]) > 0 or int(arr[1]) > 0):
                nt['pss'] = int(arr[0])
                nt['rss'] = int(arr[1])
                nt['swap'] = int(arr[2])
            elif int(arr[3]) > 0:
                nt['rss'] = int(arr[3])
            if applied & 2:
                nt['proc'] = {'anon': int(arr[9]), 'file': int(arr[10]), 'shmem': int(arr[11]),
                              'vm_swap': int(arr[12]), 'hwm': int(arr[13]), 'threads': int(arr[14])}
            if int(arr[4]) > 0:
                nt['dev'] = {'total': int(arr[4]), 'avail': int(arr[5]),
                             'swap_total': int(arr[6]), 'swap_free': int(arr[7]),
                             'src': 'native'}
            if int(arr[8]) > 0:
                nt['fd_total'] = int(arr[8])
            return nt or None
        except Exception:
            pass
        return None

    def dmabuf_scan(self, force=False):
        if not (self.native_ok and self.tick2_ok and self.lib is not None):
            return None
        try:
            now = time.monotonic()
            cc = self._dmb_cache
            if (not force) and cc['v'] is not None and (now - cc['ts']) < _DMABUF_TTL_S:
                return cc['v']
            arr = (ctypes.c_int64 * _DMABUF_FIELDS)()
            got = int(self.lib.mm_dmabuf_scan(arr, ctypes.c_int32(_DMABUF_FIELDS)))
            if got < _DMABUF_FIELDS or int(arr[0]) != 1:
                return None
            v = {'fds': int(arr[1]), 'bufs': int(arr[2]), 'bytes': int(arr[3]),
                 'unmapped_bufs': int(arr[4]), 'unmapped_bytes': int(arr[5]),
                 'size_unknown': int(arr[6]), 'fds_scanned': int(arr[7]),
                 'ino_src': int(arr[8]), 'mapped_inodes': int(arr[9]),
                 'dedup_overflow': int(arr[10]), 'scan_us': int(arr[11])}
            cc['v'] = v
            cc['ts'] = now
            return v
        except Exception:
            return None

    def fd_census(self, top=6):
        if not (self.native_ok and self.tick2_ok and self.lib is not None):
            return None
        try:
            buf = ctypes.create_string_buffer(_FDC_BUF)
            n = int(self.lib.mm_fd_census(buf, ctypes.c_int32(_FDC_BUF)))
            if n <= 0:
                return None
            lines = buf.raw[:n].decode('utf-8', 'replace').split('\n')
            meta = {}
            for kv in lines[0].lstrip('#').split():
                k, _, v = kv.partition('=')
                try:
                    meta[k] = int(v)
                except ValueError:
                    meta[k] = v
            rows = []
            for ln in lines[1:]:
                p = ln.split('\t')
                if len(p) >= 4:
                    try:
                        rows.append((p[0], int(p[1]), p[2], p[3]))
                    except ValueError:
                        pass
            return {'meta': meta, 'rows': rows[:top]}
        except Exception:
            return None

    def smaps_groups(self):
        if self.native_ok and self.smaps_ok and (self.lib is not None):
            try:
                n = len(_SMAPS_GROUPS) * _SMAPS_FIELDS
                arr = (ctypes.c_int64 * n)()
                if int(self.lib.mm_smaps_groups(arr, ctypes.c_int32(n))) >= n:
                    out = {}
                    for i, name in enumerate(_SMAPS_GROUPS):
                        b = i * _SMAPS_FIELDS
                        out[name] = {'rss': int(arr[b]), 'pss': int(arr[b + 1]), 'swap': int(arr[b + 2]), 'n': int(arr[b + 3])}
                    return out
            except Exception:
                pass
        return None

    def fd_kinds(self):
        if not (self.native_ok and self.lib is not None):
            return None
        try:
            arr = (ctypes.c_int64 * 5)()
            if int(self.lib.mm_fd_kinds(arr, ctypes.c_int32(5))) >= 5:
                kinds = {}
                for i, name in enumerate(('file', 'socket', 'pipe', 'anon_inode', 'other')):
                    if int(arr[i]):
                        kinds[name] = int(arr[i])
                return kinds or None
        except Exception:
            pass
        return None

    def tick_snapshot(self, need_andro=True, need_pss=True):
        snap = {'ts': int(time.time() * 1000)}
        nt = self.native_tick2(need_pss) if self.tick2_ok else self.native_tick()
        if nt:
            snap.update(nt)
            if 'pss' in nt:
                snap['src'] = 'native'
            elif 'rss' in nt:
                snap['src'] = 'statm'
        else:
            roll = self.smaps_rollup()
            if roll:
                snap.update({'pss': roll['pss'], 'rss': roll['rss'],
                             'swap': roll['swap'], 'src': roll['src']})
            else:
                v = self.statm_rss()
                if v > 0:
                    snap['rss'] = v
                    snap['src'] = 'statm'
            mi = self.meminfo()
            if mi:
                snap['dev'] = mi
            try:
                if self.native_ok and self.lib is not None:
                    fd = int(self.lib.mm_fd_count())
                    if fd > 0:
                        snap['fd_total'] = fd
            except Exception:
                pass
        now = time.monotonic()
        if snap.get('pss', 0) > 0:
            self._pss_cache = (now, snap['pss'])
        elif self._pss_cache is not None and now - self._pss_cache[0] <= 30.0:
            snap['pss_stale'] = self._pss_cache[1]
        if need_andro:
            dm = self.dmabuf_scan()
            if dm:
                snap['dmabuf'] = dm
        if self._stats_ctx is not None:
            try:
                script = MM_COLLECT_STATS_MVEL if need_andro else MM_COLLECT_LITE_MVEL
                with self._stats_lock:
                    raw = str(mvel_execute(script, self._stats_ctx))
                p = raw.split(',')
                max_m, tot_m, free_m = int(p[0]), int(p[1]), int(p[2])
                snap['java'] = {'used': tot_m - free_m, 'total': tot_m, 'max': max_m}
                snap['native'] = {'alloc': int(p[3]), 'total': int(p[4]), 'free': int(p[5])}
                if need_andro:
                    andro_keys = ('java-heap', 'native-heap', 'code', 'stack', 'graphics',
                                  'private-other', 'system', 'total-pss', 'total-swap')
                    ad = {}
                    for i, k in enumerate(andro_keys):
                        sv = p[6 + i]
                        if sv and sv != 'null':
                            ad[k] = int(sv) * 1024
                    if ad:
                        snap['andro'] = ad
                self._mvel_err_n = 0
                return snap
            except Exception as e:
                self._mvel_err_n += 1
                if self._mvel_err_n == 1 or self._mvel_err_n % 300 == 0:
                    self._log('mvel stats err (#%d): %s' % (self._mvel_err_n, e))
        jh = self.java_heap()
        if jh:
            snap['java'] = jh
        nh = self.native_heap()
        if nh:
            snap['native'] = nh
        ad = self.debug_summary() if need_andro else None
        if ad:
            snap['andro'] = ad
        return snap

    def full_snapshot(self):
        snap = self.tick_snapshot(True, True)
        g = self.smaps_groups()
        if g:
            dm = snap.get('dmabuf')
            gd = g.get('gfx-dmabuf')
            if dm and gd is not None:
                ub = int(dm.get('unmapped_bytes', 0))
                gd['fd_unmapped'] = ub
                if ub > 0:
                    gd['rss'] = int(gd['rss']) + ub
                    gd['pss'] = int(gd['pss']) + ub
            snap['groups'] = g
        fd = self.fd_kinds()
        if fd:
            snap['fd'] = fd
        fc = self.fd_census()
        if fc:
            snap['fd_census'] = fc
        return snap

    def source_label(self):
        return {'ok': _tr('src_ok') % (self.abi_seen, self.build_rev), 'layout_drift': _tr('src_layout_drift'), 'smaps_selftest_failed': _tr('src_smaps_selftest_failed'), 'abi_mismatch': _tr('src_abi_mismatch') % (self.abi_seen, MM_ABI_EXPECT), 'no_so': _tr('src_no_so'), 'no_ctypes': _tr('src_no_ctypes'), 'error': _tr('src_error')}.get(self.state, self.state)

    def format_details(self, snap):
        L = []
        if 'pss' in snap:
            L.append(_tr('fmt_proc_full') %
                     (_fmt_bytes(snap['pss']), _fmt_bytes(snap.get('rss', 0)),
                      _fmt_bytes(snap.get('swap', 0))))
        elif 'rss' in snap:
            L.append(_tr('fmt_proc_rss') % _fmt_bytes(snap['rss']))
        pr = snap.get('proc')
        if pr:
            L.append(_tr('fmt_rss_split') %
                     (_fmt_bytes(pr['anon']), _fmt_bytes(pr['file']), _fmt_bytes(pr['shmem'])))
            L.append(_tr('fmt_proc_misc') %
                     (pr['threads'], _fmt_bytes(pr['hwm']), _fmt_bytes(pr['vm_swap'])))
        jh = snap.get('java')
        if jh:
            L.append(_tr('fmt_java') %
                     (_fmt_bytes(jh['used']), _fmt_bytes(jh['total']), _fmt_bytes(jh['max'])))
        nh = snap.get('native')
        if nh:
            L.append(_tr('fmt_native') % (_fmt_bytes(nh['alloc']), _fmt_bytes(nh['total'])))
        ad = snap.get('andro')
        if ad:
            L.append('')
            L.append(_tr('fmt_andro_header'))
            names = (('java-heap', 'Java Heap'), ('native-heap', 'Native Heap'),
                     ('code', 'Code'), ('stack', 'Stack'), ('graphics', 'Graphics'),
                     ('private-other', 'Private Other'), ('system', 'System'),
                     ('total-pss', 'TOTAL PSS'), ('total-swap', 'TOTAL Swap'))
            for key, label in names:
                if key in ad:
                    L.append('  %-13s %s' % (label, _fmt_bytes(ad[key])))
        dm = snap.get('dmabuf')
        if dm:
            L.append(_tr('fmt_dmabuf') %
                     (dm['bufs'], _fmt_bytes(dm['bytes']), _fmt_bytes(dm['unmapped_bytes'])))
            if dm.get('size_unknown'):
                L.append(_tr('fmt_dmabuf_unk') % dm['size_unknown'])
            if ad and 'graphics' in ad:
                L.append(_tr('fmt_gfx_total') % _fmt_bytes(ad['graphics'] + dm['unmapped_bytes']))
        dev = snap.get('dev')
        if dev and dev.get('total'):
            L.append(_tr('fmt_ram') %
                     (_fmt_bytes(dev['total'] - dev['avail']), _fmt_bytes(dev['total']),
                      _fmt_bytes(dev['avail'])))
            if dev.get('swap_total'):
                L.append(_tr('fmt_swap') %
                         (_fmt_bytes(dev['swap_total'] - dev['swap_free']),
                          _fmt_bytes(dev['swap_total'])))
        fd = snap.get('fd')
        if fd:
            total_fd = sum(fd.values())
            det = ', '.join('%s %d' % (k, v) for k, v in
                            sorted(fd.items(), key=lambda kv: kv[1], reverse=True))
            L.append(_tr('fmt_fd') % (total_fd, det))
        elif snap.get('fd_total'):
            L.append(_tr('fmt_fd_total') % snap['fd_total'])
        fc = snap.get('fd_census')
        if fc and fc.get('rows'):
            L.append(_tr('fmt_fd_top_header'))
            for kind, cnt, cat, tgt in fc['rows']:
                L.append(_tr('fmt_fd_row') % (cnt, cat, tgt))
        g = snap.get('groups')
        if g:
            items = [(k, v) for k, v in g.items() if v['pss'] or v['rss']]
            items.sort(key=lambda kv: kv[1]['pss'], reverse=True)
            L.append('')
            L.append(_tr('fmt_groups_header'))
            for name, v in items[:8]:
                L.append(_tr('fmt_group_row') %
                         (name, _fmt_bytes(v['pss']), _fmt_bytes(v['rss']), v['n']))
        L.append('')
        L.append(_tr('fmt_source') % self.source_label())
        return '\n'.join(L) if L else _tr('fmt_no_data')


class MemoryPill:

    def __init__(self, plugin, engine):
        self.plugin = plugin
        self.engine = engine
        self.views = weakref.WeakSet()
        self._lock = threading.Lock()
        self._stopped = False
        self._last_snap = None
        self._rot = 0
        self._pss_history = []
        self._update_event = threading.Event()
        self._worker = None
        self._live_gen = 0
        self._menu = None
        self._last_key = None
        self._skip_n = 0
        self._wstop = None       # v1.5.8: персональный Event остановки текущего воркера
        self._live_dlg = None    # живой диалог: закрывается в dismiss_ui() при remove/unload
        self._last_shape = None  # (build_gen, len, prefix) текста последнего кадра: поджим при смене ширины
        _UI_LOG[0] = plugin.log  # v1.5.8: лог для _post_ui

    def attach(self, view):
        self.views.add(view)
        self.refresh_async()
        self.ensure_loop()

    def set_pill_enabled(self, enabled):
        self.plugin.set_setting('enable_pill', bool(enabled))

        def update_visibility():
            for view in list(self.views):
                try:
                    view.setVisibility(0 if enabled else 8)
                except Exception:
                    pass
        try:
            run_on_ui_thread(update_visibility)
        except Exception:
            pass
        if enabled:
            self.refresh_async()
            self.ensure_loop()

    def stop(self):
        self._stopped = True
        ev = self._wstop
        if ev is not None:
            ev.set()  # v1.5.8: персональный Event воркера
        self._update_event.set()  # будим рабочий поток, чтобы он сразу завершился

    def _interval(self):
        try:
            v = int(str(self.plugin.get_setting('update_interval', '1')).strip())
        except Exception:
            v = 1
        return max(1, min(3600, v))

    def ensure_loop(self):
        with self._lock:
            if self._stopped or (self._worker is not None and self._worker.is_alive()):
                return
            ev = threading.Event()
            self._wstop = ev
            self._worker = threading.Thread(target=self._worker_loop, args=(ev,), daemon=True)
            self._worker.start()

    def _worker_loop(self, ev):
        while not self._stopped and not ev.is_set():
            self._update_event.wait(self._wait_s())
            self._update_event.clear()
            if self._stopped or ev.is_set():
                return
            try:
                if self.plugin.get_setting('enable_pill', True):
                    ov = getattr(self.plugin, 'overlay', None)
                    if ov is not None and ov.root is None:
                        self._kick_ensure(ov)
                if len(self.views) and not self._ui_hidden() and self.plugin.get_setting('enable_pill', True):
                    self._do_tick()
            except Exception as e:
                self.plugin.log('refresh err: %s' % e)

    def refresh_async(self):
        self._update_event.set()
        self.ensure_loop()

    def _do_tick(self):
        if self._stopped:
            return
        snap = self.engine.tick_snapshot(self._need_andro(), self._need_pss())
        try:
            raw = snap.get('pss')
            if raw is None:
                raw = snap.get('pss_stale')
            if raw is None:
                raw = snap.get('rss')
            if raw is not None and float(raw) > 0:
                cur = float(raw)
                now = time.monotonic()
                self._pss_history.append((now, cur))
                self._pss_history = [x for x in self._pss_history if now - x[0] <= 10.0]
                old_pss = self._pss_history[0][1]  # самое старое значение в окне (~10 с)
                if cur - old_pss > 2 * _MB:
                    snap['trend'] = '▲'
                elif old_pss - cur > 2 * _MB:
                    snap['trend'] = '▼'
        except Exception:
            pass
        self._rot += 1
        self._last_snap = snap
        if self._stopped:
            return

        def _ui():
            try:
                ov = getattr(self.plugin, 'overlay', None)
                if ov is not None and ov.root is None:
                    ov.ensure()
            except Exception:
                pass
            self._render_all(snap)
        _post_ui(_ui)

    def _need_andro(self):
        return self._mode() in (0, 5, 6, 7)

    def _need_pss(self):
        mode = self._mode()
        if mode in (1, 9):
            return True
        if mode == 0:
            return self._rot % 3 == 0
        try:
            cm = int(self.plugin.get_setting('color_mode', 0))
        except Exception:
            cm = 0
        return cm == 0 and self._rot % 5 == 0

    def _gfx_bytes(self, snap):
        ad = snap.get('andro') or {}
        if 'graphics' not in ad:
            return None
        dm = snap.get('dmabuf')
        return int(ad['graphics']) + (int(dm.get('unmapped_bytes', 0)) if dm else 0)

    def _render_all(self, snap):
        if self._stopped:
            return
        try:
            self._render(None, snap)
        except Exception as e:
            self.plugin.log('render err: %s' % e)

    def _mode(self):
        try:
            return int(self.plugin.get_setting('display_mode', 0)) % len(MM_MODES)
        except Exception:
            return 0

    def _rotation_items(self, snap):
        items = []
        pss = snap.get('pss', snap.get('pss_stale'))
        if pss is not None:
            items.append('PSS %s' % _fmt_bytes(pss))
        if 'rss' in snap:
            items.append('RSS %s' % _fmt_bytes(snap['rss']))
        jh = snap.get('java')
        if jh:
            items.append('Java %s' % _fmt_bytes(jh['used']))
        nh = snap.get('native')
        if nh:
            items.append('NH %s' % _fmt_bytes(nh['alloc']))
        ad = snap.get('andro') or {}
        gfx = self._gfx_bytes(snap)
        if gfx is not None:
            items.append('Gfx %s' % _fmt_bytes(gfx))
        if 'code' in ad:
            items.append('Code %s' % _fmt_bytes(ad['code']))
        if 'stack' in ad:
            items.append('Stack %s' % _fmt_bytes(ad['stack']))
        dev = snap.get('dev')
        if dev and dev.get('total'):
            items.append('RAM %s/%s' % (_fmt_bytes(dev['total'] - dev['avail']),
                                        _fmt_bytes(dev['total'])))
        return items or [_tr('fmt_no_data')]

    def _text_for(self, snap):
        mode = self._mode()
        jh = snap.get('java')
        ad = snap.get('andro') or {}
        arrow = (' ' + snap['trend']) if snap.get('trend') else ''
        if mode == 0:
            items = self._rotation_items(snap)
            return items[self._rot % len(items)] + arrow
        if mode == 1:
            if 'pss' not in snap and 'rss' not in snap:
                return 'PSS ?'
            return 'PSS %s%s' % (_fmt_bytes(snap.get('pss', snap.get('rss', 0))), arrow)
        if mode == 2:
            if 'rss' not in snap:
                return 'RSS ?'
            return 'RSS %s' % _fmt_bytes(snap['rss'])
        if mode == 3:
            if not jh:
                return 'Java ?'
            return 'Java %s/%s' % (_fmt_bytes(jh['used']), _fmt_bytes(jh['max']))
        if mode == 4:
            nh = snap.get('native')
            if not nh:
                return 'NH ?'
            return 'NH %s' % _fmt_bytes(nh['alloc'])
        if mode == 5:
            gfx = self._gfx_bytes(snap)
            return ('Gfx %s' % _fmt_bytes(gfx)) if gfx is not None else 'Gfx ?'
        if mode == 6:
            return ('Code %s' % _fmt_bytes(ad['code'])) if 'code' in ad else 'Code ?'
        if mode == 7:
            return ('Stack %s' % _fmt_bytes(ad['stack'])) if 'stack' in ad else 'Stack ?'
        if mode == 8:
            dev = snap.get('dev')
            if not dev or not dev.get('total'):
                return 'RAM ?'
            return 'RAM %s/%s' % (_fmt_bytes(dev['total'] - dev['avail']), _fmt_bytes(dev['total']))
        p = _fmt_bytes(snap['pss']) if 'pss' in snap else '?'
        j = _fmt_bytes(jh['used']) if jh else '?'
        return 'P %s · J %s%s' % (p, j, arrow)

    def _color_int(self, snap):
        try:
            cm = int(self.plugin.get_setting('color_mode', 0))
        except Exception:
            cm = 0
        if cm == 1:
            return 0
        if cm >= 2:
            return -1  # #FFFFFF
        try:
            warn = float(str(self.plugin.get_setting('warn_mb', '700')))
        except Exception:
            warn = 700.0
        try:
            crit = float(str(self.plugin.get_setting('crit_mb', '1200')))
        except Exception:
            crit = 1200.0
        pss_mb = float(snap.get('pss', snap.get('pss_stale', snap.get('rss', 0)))) / _MB
        if pss_mb >= crit:
            return -769226    # #F44336
        if pss_mb >= warn:
            return -26624     # #FF9800
        return -11751600      # #4CAF50

    def _render(self, view, snap):
        ov = getattr(self.plugin, 'overlay', None)
        if ov is None or ov.root is None or ov._render_ctx is None:
            return
        try:
            enabled = 1 if self.plugin.get_setting('enable_pill', True) else 0
            payload = '%d|%d|%s' % (enabled, self._color_int(snap), self._text_for(snap))
            key = (ov.build_gen, payload)
            if key == self._last_key and self._skip_n < 4:
                self._skip_n += 1
                return
            self._skip_n = 0
            ok = mvel_execute(MM_RENDER_TICK_MVEL, ov._render_ctx, java_instance=payload)
            if ok:
                self._last_key = key
                self._after_frame(ov, payload)
            elif enabled:
                self._last_key = None
                ov.ensure()
                if ov.root is not None and ov._render_ctx is not None:
                    if mvel_execute(MM_RENDER_TICK_MVEL, ov._render_ctx, java_instance=payload):
                        self._last_key = (ov.build_gen, payload)
        except Exception as e:
            self.plugin.log('mvel render err: %s' % e)

    def on_click(self, view):
        try:
            action = int(self.plugin.get_setting('click_action', 0))
        except Exception:
            action = 0
        if action == 1:
            self.cycle_mode()
        elif action == 2:
            self.show_details()
        else:
            self.refresh_async()

    def cycle_mode(self):
        mode = (self._mode() + 1) % len(MM_MODES)
        self.plugin.set_setting('display_mode', mode)
        self.refresh_async()

    def show_details(self):

        def work():
            try:
                snap = self.engine.full_snapshot()
                text = self.engine.format_details(snap)
            except Exception as e:
                text = '%s: %s' % (_tr('err_prefix'), e)

            def ui():
                try:
                    LaunchActivity = find_class('org.telegram.ui.LaunchActivity')
                    fragment = LaunchActivity.getSafeLastFragment()
                    if not fragment:
                        return
                    act = fragment.getParentActivity()
                    Builder = find_class('org.telegram.ui.ActionBar.AlertDialog$Builder')
                    b = Builder(act)
                    b.setTitle(_tr('live_title'))
                    tv = None
                    try:
                        TextView = find_class('android.widget.TextView')
                        ScrollView = find_class('android.widget.ScrollView')
                        AndroidUtilities = find_class('org.telegram.messenger.AndroidUtilities')
                        tv = TextView(act)
                        tv.setText(text)
                        tv.setTextSize(13.0)
                        try:
                            Theme = find_class('org.telegram.ui.ActionBar.Theme')
                            tv.setTextColor(jint(Theme.getColor(Theme.key_dialogTextBlack)))
                        except Exception:
                            pass
                        try:
                            Typeface = find_class('android.graphics.Typeface')
                            tv.setTypeface(Typeface.MONOSPACE)
                        except Exception:
                            pass
                        pad = int(AndroidUtilities.dp(16.0))
                        tv.setPadding(pad, pad, pad, pad)
                        sv = ScrollView(act)
                        sv.addView(tv)
                        b.setView(sv)
                    except Exception:
                        tv = None
                        b.setMessage(text)
                    try:
                        b.setPositiveButton(_tr('live_close'), None)
                    except Exception:
                        pass
                    dlg = b.create()
                    fragment.showDialog(dlg)
                    if tv is not None:
                        self._start_live_updates(dlg, tv)
                except Exception as e:
                    self.plugin.log('dialog err: %s' % e)
            run_on_ui_thread(ui)
        threading.Thread(target=work, daemon=True).start()

    def dismiss_ui(self):
        # UI-поток (из MMOverlayPill.remove): закрыть меню и живой диалог, погасить цикл диагностики
        # меню и живой цикл. Раньше они переживали выгрузку/смену Activity (у Culprit: _dismiss_menu +
        # dialog.dismiss в remove, +OW M1 / +OX R1).
        with self._lock:
            self._menu_gen = getattr(self, '_menu_gen', 0) + 1
            self._live_gen += 1
        m = self._menu
        self._menu = None
        if m is not None:
            try:
                m.dismiss()
            except Exception:
                pass
        d = self._live_dlg
        self._live_dlg = None
        if d is not None:
            try:
                d.dismiss()
            except Exception:
                pass

    def _ui_hidden(self):
        # Воркер-поток, только чтение полей View. True = окно прикреплено, но не видно (приложение в
        # фоне): тик не нужен. Откреплённый/устаревший root скрытым НЕ считаем: его чинит _render через
        # ensure(). Любая ошибка -> False (тикаем как раньше).
        try:
            ov = getattr(self.plugin, 'overlay', None)
            r = ov.root if ov is not None else None
            if r is None:
                return False
            return bool(r.isAttachedToWindow()) and int(r.getWindowVisibility()) != 0
        except Exception:
            return False

    def _wait_s(self):
        # Нет Activity (root нет, ensure() выставил backoff) -> спим дольше, а не будим воркер каждую секунду.
        w = self._interval()
        try:
            ov = getattr(self.plugin, 'overlay', None)
            if ov is not None and ov.root is None:
                rem = ov._backoff_until - time.monotonic()
                if rem > w:
                    w = min(rem, _NOACT_BACKOFF_S)
        except Exception:
            pass
        return w

    def _kick_ensure(self, ov):
        if time.monotonic() >= ov._backoff_until:
            _post_ui(ov.ensure)

    def _after_frame(self, ov, payload):
        # Ширина пилюли зависит от текста, а при translationX/Y View у края сама не сжимается
        # (PSS 400 MB -> RAM 2.9 GB/5.5 GB вылезало за экран). Поджимаем позицию, когда «форма»
        # текста изменилась (длина/префикс), а не на каждый тик: значения меняются каждую секунду.
        try:
            txt = payload.split('|', 2)[-1]
            shape = (ov.build_gen, len(txt), txt[:4])
            if shape != self._last_shape:
                self._last_shape = shape
                ov.post_clamp()
        except Exception:
            pass

    def _start_live_updates(self, dlg, tv):
        with self._lock:
            self._live_gen += 1
            gen = self._live_gen
        self._live_dlg = dlg

        def loop():
            i = 0
            while i < 36000:
                time.sleep(1.0)
                if gen != self._live_gen:
                    return
                try:
                    if self._stopped or not dlg.isShowing():
                        return
                except Exception:
                    return
                try:
                    snap = self.engine.full_snapshot()
                    text = self.engine.format_details(snap)

                    def update_ui(t=text):
                        tv.setText(t)
                        try:
                            Theme = find_class('org.telegram.ui.ActionBar.Theme')
                            tv.setTextColor(jint(Theme.getColor(Theme.key_dialogTextBlack)))
                        except Exception:
                            pass
                    run_on_ui_thread(update_ui)
                except Exception:
                    pass
                i += 1
        threading.Thread(target=loop, daemon=True).start()

    def show_menu(self, view):
        try:
            try:
                if self._menu is not None:
                    self._menu.dismiss()
            except Exception:
                pass
            self._menu = None
            LaunchActivity = find_class('org.telegram.ui.LaunchActivity')
            fragment = LaunchActivity.getSafeLastFragment()
            if not fragment:
                return
            ItemOptions = find_class('org.telegram.ui.Components.ItemOptions')
            if not ItemOptions:
                return
            ApplicationLoader = find_class('org.telegram.messenger.ApplicationLoader')
            ctx = ApplicationLoader.applicationContext
            res = ctx.getResources()
            pkg = ctx.getPackageName()

            def icon(name):
                try:
                    return res.getIdentifier(name, 'drawable', pkg)
                except Exception:
                    return 0
            log = self.plugin.log
            plugin = self.plugin

            def open_plugin_settings():
                try:
                    from client_utils import get_last_fragment
                    from com.exteragram.messenger.plugins import PluginsController
                    PluginSettingsActivity = find_class('com.exteragram.messenger.plugins.ui.PluginSettingsActivity')
                    controller = PluginsController.getInstance()
                    plugins_map = getattr(controller, 'plugins', None)
                    java_plugin = plugins_map.get(plugin.id) if plugins_map else None
                    if java_plugin:
                        frag = get_last_fragment()
                        if frag:
                            frag.presentFragment(PluginSettingsActivity(java_plugin))
                except Exception as e:
                    log('settings err: %s' % e)
            options = ItemOptions.makeOptions(fragment, view)
            options.add(jint(icon('msg_retry')), _tr('menu_refresh'), _runnable(self.refresh_async, log))
            options.add(jint(icon('msg_info')), _tr('menu_live'), _runnable(self.show_details, log))
            options.add(jint(icon('msg_stats')), _tr('menu_cycle') % _mode_names()[self._mode()], _runnable(self.cycle_mode, log))
            options.addGap()
            options.add(jint(icon('msg_settings')), _tr('menu_plugin_settings'), _runnable(open_plugin_settings, log))
            options.add(jint(icon('msg_clearcache')), _tr('menu_restart'), _runnable(self._restart_app, log))
            self._menu = options
            options.setDrawScrim(False).setDimAlpha(jint(0)).show()
            self._menu_diag(view)
        except Exception as e:
            self.plugin.log('menu err: %s' % e)

    def _menu_diag(self, view):
        ov = getattr(self.plugin, 'overlay', None)
        if ov is None or ov.root is None:
            return
        base = 0
        self._menu_gen = getattr(self, '_menu_gen', 0) + 1
        gen = self._menu_gen
        ds = {'lost': False, 'healed': False}

        def tick():
            o = getattr(self.plugin, 'overlay', None)
            if o is None or o.root is None or ds['healed']:
                return
            try:
                f = bool(o.root.hasWindowFocus())
            except Exception:
                return
            if not f:
                ds['lost'] = True
            elif ds['lost']:
                ds['healed'] = True
                self._heal_after_menu(o, base, 'focus back')

        def late():
            o = getattr(self.plugin, 'overlay', None)
            if o is not None and o.root is not None and not ds['healed'] and not ds['lost']:
                ds['healed'] = True
                self._heal_after_menu(o, base, 'timeout, focus not taken')

        def run():
            t0 = time.monotonic()
            while time.monotonic() - t0 < 60.0 and not ds['healed']:
                time.sleep(0.15)
                if self._stopped or gen != self._menu_gen:
                    return
                _post_ui(tick)
                if not ds['lost'] and time.monotonic() - t0 >= 3.0:
                    _post_ui(late)
                    time.sleep(0.3)
        threading.Thread(target=run, daemon=True).start()

    def _heal_after_menu(self, ov, base, why):
        r = ov.root
        if r is None:
            return
        for fn in (lambda: r.setEnabled(True), lambda: r.setVisibility(0),
                   lambda: r.setAlpha(1.0), lambda: r.setScaleX(1.0), lambda: r.setScaleY(1.0),
                   lambda: r.getParent().requestDisallowInterceptTouchEvent(False),
                   lambda: r.cancelPendingInputEvents(),
                   lambda: r.setOnTouchListener(ov._listener)):
            try:
                fn()
            except Exception:
                pass
        try:
            par = r.getParent()
            n = int(par.getChildCount())
            if not bool(par.getChildAt(n - 1).equals(r)):
                r.bringToFront()
        except Exception:
            pass
        try:
            if ov._touch_state is not None:
                ov._touch_state.put('menu_shown', False)
                ov._touch_state.put('moved', False)
        except Exception:
            pass
        self.plugin.log('menu: heal applied (%s)' % why)

    def _restart_app(self):
        try:
            ApplicationLoader = find_class('org.telegram.messenger.ApplicationLoader')
            ctx = ApplicationLoader.applicationContext
            intent = ctx.getPackageManager().getLaunchIntentForPackage(ctx.getPackageName())
            from android.content import Intent
            intent.addFlags(Intent.FLAG_ACTIVITY_CLEAR_TOP | Intent.FLAG_ACTIVITY_NEW_TASK | Intent.FLAG_ACTIVITY_CLEAR_TASK)
            ctx.startActivity(intent)
            try:
                find_class('java.lang.System').exit(jint(0))
            except Exception:
                pass
            os._exit(0)
        except Exception as e:
            self.plugin.log('restart err: %s' % e)


class MMOverlayPill:

    def __init__(self, plugin, pill):
        self.plugin = plugin
        self.pill = pill
        self.root = None
        self.tv = None
        self.iv = None
        self._bg = None
        self._listener = None
        self._render_ctx = None
        self._touch_state = None
        self.build_gen = 0
        self._clamp_run = None    # один Runnable поджима позиции на View (создаётся в _build)
        self._lp_run = None       # отложенный long-press Runnable: снимается в remove()
        self._backoff_until = 0.0 # нет Activity -> воркер не дёргает ensure() до этого момента

    @staticmethod
    def _jcolor(c):
        c &= 4294967295
        if c >= 2147483648:
            c -= 4294967296
        return jint(c)

    def _dp(self, v):
        try:
            AndroidUtilities = find_class('org.telegram.messenger.AndroidUtilities')
            return int(AndroidUtilities.dp(float(v)))
        except Exception:
            return int(v * 3)

    def _activity(self):
        try:
            LaunchActivity = find_class('org.telegram.ui.LaunchActivity')
            fragment = LaunchActivity.getSafeLastFragment()
            if fragment is not None:
                return fragment.getParentActivity()
        except Exception:
            pass
        return None

    def ensure(self):
        try:
            act = self._activity()
            if act is None:
                self._backoff_until = time.monotonic() + _NOACT_BACKOFF_S
                return
            self._backoff_until = 0.0
            if self.root is not None:
                try:
                    same_ctx = bool(self.root.getContext().equals(act))
                except Exception:
                    same_ctx = False
                if not same_ctx:
                    self.remove()
                    self._build(act)
                    return
                if self.root.isAttachedToWindow():
                    if self.root not in self.pill.views:
                        self.pill.attach(self.root)
                    return
                parent = self.root.getParent()
                if parent is not None:
                    parent.removeView(self.root)
                self._attach(act)
                if self.root not in self.pill.views:
                    self.pill.attach(self.root)
                return
            self._build(act)
        except Exception as e:
            self.plugin.log('overlay ensure err: %s' % e)

    def _build(self, act):
        LinearLayout = find_class('android.widget.LinearLayout')
        TextView = find_class('android.widget.TextView')
        ImageView = find_class('android.widget.ImageView')
        GradientDrawable = find_class('android.graphics.drawable.GradientDrawable')
        LLP = find_class('android.widget.LinearLayout$LayoutParams')
        Theme = find_class('org.telegram.ui.ActionBar.Theme')
        LaunchActivity = find_class('org.telegram.ui.LaunchActivity')

        root = LinearLayout(act)
        root.setOrientation(0)
        root.setGravity(16)
        root.setPadding(self._dp(10), self._dp(5), self._dp(10), self._dp(5))
        bg = GradientDrawable()
        bg.setCornerRadius(float(self._dp(16)))
        root.setBackground(bg)
        self._bg = bg
        try:
            root.setElevation(float(self._dp(8)))
        except Exception:
            pass
        iv = ImageView(act)
        try:
            ctx = act.getApplicationContext()
            res = ctx.getResources()
            icon_res = res.getIdentifier('msg_filled_datausage', 'drawable', ctx.getPackageName())
            if icon_res:
                iv.setImageResource(icon_res)
        except Exception:
            pass
        ilp = LLP(self._dp(14), self._dp(14))
        ilp.rightMargin = self._dp(6)
        root.addView(iv, ilp)
        tv = TextView(act)
        tv.setTextSize(12.0)
        try:
            Typeface = find_class('android.graphics.Typeface')
            tv.setTypeface(Typeface.DEFAULT_BOLD)
        except Exception:
            pass
        tv.setSingleLine(True)
        tv.setText('…')
        root.addView(tv)
        self.root, self.tv, self.iv = (root, tv, iv)

        rctx = HashMap()
        rctx.put('root', root)
        rctx.put('bg', bg)
        rctx.put('tv', tv)
        rctx.put('iv', iv)
        rctx.put('Theme', Theme)
        rctx.put('LaunchActivity', LaunchActivity)
        rctx.put('key_bg', Theme.key_windowBackgroundWhite)
        rctx.put('key_txt', Theme.key_windowBackgroundWhiteBlackText)
        self._render_ctx = rctx
        self.build_gen += 1
        self._clamp_run = _runnable(self._clamp, self.plugin.log)

        self.sync_theme()
        if not self.plugin.get_setting('enable_pill', True):
            root.setVisibility(8)
        self._listener = self._make_drag_listener()
        root.setOnTouchListener(self._listener)
        self._attach(act)
        self.pill.attach(root)

    def _attach(self, act):
        FLP = find_class('android.widget.FrameLayout$LayoutParams')
        decor = act.getWindow().getDecorView()
        lp = FLP(-2, -2)
        lp.gravity = 51
        lp.leftMargin = 0
        lp.topMargin = 0
        try:
            x = int(str(self.plugin.get_setting('overlay_x', str(self._dp(8)))))
            y = int(str(self.plugin.get_setting('overlay_y', str(self._dp(96)))))
        except Exception:
            x, y = (self._dp(8), self._dp(96))
        self.root.setTranslationX(float(max(0, x)))
        self.root.setTranslationY(float(max(0, y)))
        decor.addView(self.root, lp)
        try:
            self.root.bringToFront()
        except Exception:
            pass
        self.post_clamp()

    def post_clamp(self):
        # UI-поток: после смены ширины текста поджать позицию к краям окна (см. _clamp).
        try:
            r = self.root
            cr = self._clamp_run
            if r is not None and cr is not None:
                r.post(cr)
        except Exception:
            pass

    def _clamp(self):
        # Прежний _clamp_saved_pos, вынесен в метод, один Runnable на View. Зовётся после attach
        # (позиция могла остаться за краем при смене ориентации/размера окна) и после смены текста.
        # Только UI-поток.
        try:
            rv = self.root
            if rv is None:
                return
            par = rv.getParent()
            if par is None:
                return
            w = int(par.getWidth())
            h = int(par.getHeight())
            if w <= 0 or h <= 0:
                return
            try:
                # post() выполняется раньше layout-прохода кадра: getWidth() ещё старая. Берём ширину
                # заново измеренную (wrap_content, UNSPECIFIED).
                rv.measure(0, 0)
                vw = int(rv.getMeasuredWidth())
                vh = int(rv.getMeasuredHeight())
                if vw <= 0 or vh <= 0:
                    raise ValueError('not measured')
            except Exception:
                vw = int(rv.getWidth())
                vh = int(rv.getHeight())
            cur_x = float(rv.getTranslationX())
            cur_y = float(rv.getTranslationY())
            nx = max(0.0, min(float(w - vw), cur_x))
            ny = max(0.0, min(float(h - vh), cur_y))
            if nx != cur_x:
                rv.setTranslationX(nx)
            if ny != cur_y:
                rv.setTranslationY(ny)
        except Exception:
            pass

    def _teardown_pending(self):
        # По образцу Culprit +OW(H1/M1): ДО обнуления root снять отложенный long-press и поджим, закрыть
        # меню и диалог, убрать View из pill.views (иначе WeakSet держит её до GC и воркер тикает).
        root = self.root
        lp = self._lp_run
        cr = self._clamp_run
        self._lp_run = None
        self._clamp_run = None
        try:
            self.pill.dismiss_ui()
        except Exception:
            pass
        if root is not None:
            for cb in (lp, cr):
                if cb is not None:
                    try:
                        root.removeCallbacks(cb)
                    except Exception:
                        pass
            try:
                self.pill.views.discard(root)
            except Exception:
                pass

    def remove(self):
        self._teardown_pending()
        try:
            if self.root is not None:
                try:
                    self.root.setOnTouchListener(None)
                except Exception:
                    pass
                parent = self.root.getParent()
                if parent is not None:
                    parent.removeView(self.root)
        except Exception:
            pass
        ts = self._touch_state
        self._touch_state = None
        self._listener = None
        if ts is not None:
            try:
                ts.clear()
            except Exception:
                pass
        self.root = None
        self.tv = None
        self.iv = None
        self._bg = None
        self._render_ctx = None

    def sync_theme(self):
        try:
            if self._bg is None:
                return
            Theme = find_class('org.telegram.ui.ActionBar.Theme')
            base = int(Theme.getColor(Theme.key_windowBackgroundWhite))
            self._bg.setColor(self._jcolor(base & 16777215 | 230 << 24))
        except Exception:
            pass

    def _make_drag_listener(self):
        OnTouchListener = find_class("android.view.View$OnTouchListener")
        plugin = self.plugin
        pill = self.pill
        st = HashMap()
        self._touch_state = st
        st.put("v", self.root)
        st.put("x0", 0.0)
        st.put("y0", 0.0)
        st.put("tx", 0.0)
        st.put("ty", 0.0)
        st.put("maxX", 10000.0)
        st.put("maxY", 10000.0)
        st.put("moved", False)
        st.put("menu_shown", False)
        st.put("edgeMargin", float(self._dp(8)))
        try:
            VC = find_class("android.view.ViewConfiguration").get(self._activity())
            st.put("slop", int(VC.getScaledTouchSlop()))
            st.put("lpt", int(VC.getLongPressTimeout()))
        except Exception:
            st.put("slop", 24)
            st.put("lpt", 450)

        def _trigger_long_press():
            if not st.get("moved") and not st.get("menu_shown"):
                st.put("menu_shown", True)
                try:
                    if self.root is not None:
                        self.root.performHapticFeedback(0)
                except Exception:
                    pass

        lp_run = _runnable(_trigger_long_press, plugin.log)
        st.put("lp_run", lp_run)
        self._lp_run = lp_run

        ps = {"x0": 0.0, "y0": 0.0, "tx": 0.0, "ty": 0.0, "maxX": 10000.0, "maxY": 10000.0, "down": False}
        mode = {"mvel": True, "logged": False}

        def touch_py(v, ev):
            a = int(ev.getActionMasked())
            if a == 0:
                v.animate().cancel()
                ps["x0"] = float(ev.getRawX())
                ps["y0"] = float(ev.getRawY())
                ps["tx"] = float(v.getTranslationX())
                ps["ty"] = float(v.getTranslationY())
                par = v.getParent()
                if par is not None:
                    ps["maxX"] = float(max(0, int(par.getWidth()) - int(v.getWidth())))
                    ps["maxY"] = float(max(0, int(par.getHeight()) - int(v.getHeight())))
                else:
                    ps["maxX"] = 10000.0
                    ps["maxY"] = 10000.0
                ps["down"] = True
                st.put("moved", False)
                st.put("menu_shown", False)
                v.postDelayed(lp_run, int(st.get("lpt")))
                return ""
            if not ps["down"]:
                return ""
            if a == 2:
                dx = float(ev.getRawX()) - ps["x0"]
                dy = float(ev.getRawY()) - ps["y0"]
                slop = int(st.get("slop"))
                if not st.get("moved") and (abs(dx) > slop or abs(dy) > slop):
                    st.put("moved", True)
                    v.removeCallbacks(lp_run)
                if st.get("moved") and not st.get("menu_shown"):
                    v.setTranslationX(float(max(0.0, min(ps["maxX"], ps["tx"] + dx))))
                    v.setTranslationY(float(max(0.0, min(ps["maxY"], ps["ty"] + dy))))
                return ""
            if a == 1 or a == 3:
                ps["down"] = False
                v.removeCallbacks(lp_run)
                if st.get("menu_shown"):
                    return "M" if a == 1 else ""
                if st.get("moved"):
                    cur_x = float(v.getTranslationX())
                    cur_y = float(v.getTranslationY())
                    width = float(v.getWidth())
                    edge = float(st.get("edgeMargin"))
                    left = min(edge, ps["maxX"])
                    right = max(left, ps["maxX"] - edge)
                    target = left if cur_x + width / 2.0 <= (ps["maxX"] + width) / 2.0 else right
                    v.animate().translationX(float(target)).setDuration(200).start()
                    return "%d,%d" % (int(target), int(cur_y))
                if a == 1:
                    return "C"
            return ""

        def dispatch(res, v):
            if res == "M":
                pill.show_menu(v)
            elif res == "C":
                pill.on_click(v)
            elif "," in res:
                sx, sy = res.split(",")
                plugin.set_setting("overlay_x", sx)
                plugin.set_setting("overlay_y", sy)

        def on_touch(v, ev):
            try:
                res = None
                if mode["mvel"]:
                    try:
                        res = str(mvel_execute(MM_TOUCH_MVEL, st, java_instance=ev) or "")
                        if not mode["logged"]:
                            mode["logged"] = True
                            plugin.log("touch: MVEL ok")
                    except Exception as e:
                        mode["mvel"] = False
                        res = None
                        plugin.log("touch: MVEL failed (%s) -> Python handler" % e)
                if res is None:
                    res = touch_py(v, ev)
                dispatch(res, v)
                return True
            except Exception as e:
                plugin.log("overlay touch err: %s" % e)
            return False

        return _touch_proxy(on_touch)


class MemoryMonitorProPlugin(BasePlugin):

    def __init__(self):
        super().__init__()
        self.engine = None
        self.pill = None
        self.sink = None

    def _tee_log(self):
        orig = self.log
        sink = self.sink

        def _log(*args, **kw):
            try:
                orig(*args, **kw)
            except Exception:
                pass
            try:
                sink.log(" ".join(str(x) for x in args))
            except Exception:
                pass
        try:
            self.log = _log
        except Exception:
            pass

    def on_plugin_load(self):
        self.sink = _FileSink()
        self.sink.start()
        self._tee_log()
        self.log("load v%s" % __version__)
        self.engine = MemoryMonitorEngine(self.log)
        self.engine.load_native()
        self.pill = MemoryPill(self, self.engine)
        self.overlay = MMOverlayPill(self, self.pill)
        run_on_ui_thread(self.overlay.ensure)
        self.pill.refresh_async()

    def on_plugin_unload(self):
        try:
            ov = getattr(self, 'overlay', None)
            if ov is not None:
                run_on_ui_thread(ov.remove)
            self.overlay = None
        except Exception:
            pass
        try:
            if self.pill:
                self.pill.stop()
        except Exception:
            pass
        try:
            if self.sink is not None:
                self.log('unload')
                self.sink.stop()
        except Exception:
            pass
        super().on_plugin_unload()

    def _set_num_setting(self, key, value, default, lo, hi):
        raw = str(value or '').replace(',', '.').split('.')[0]
        digits = ''.join((ch for ch in raw if ch.isdigit()))
        try:
            n = int(digits) if digits else int(default)
        except Exception:
            n = int(default)
        n = max(int(lo), min(int(hi), n))
        self.set_setting(key, str(n))

    def _show_num_dialog(self, key, title, default, lo, hi, on_saved=None):
        try:
            from client_utils import get_last_fragment
            from ui.alert import AlertDialogBuilder
            from android.widget import EditText, LinearLayout
            from android.text import InputType, InputFilter
            from android.text.method import DigitsKeyListener
            from android.view import ViewGroup
            f = get_last_fragment()
            if not f:
                return
            ctx = f.getParentActivity()
            cur = str(self.get_setting(key, str(default)))
            layout = LinearLayout(ctx)
            layout.setOrientation(LinearLayout.VERTICAL)
            layout.setPadding(48, 24, 48, 24)
            edit = EditText(ctx)
            edit.setHint(_tr('dlg_range_hint') % (int(lo), int(hi)))
            edit.setInputType(InputType.TYPE_CLASS_NUMBER)
            try:
                _Theme = find_class('org.telegram.ui.ActionBar.Theme')
                edit.setTextColor(jint(_Theme.getColor(_Theme.key_dialogTextBlack)))
                edit.setHintTextColor(jint(_Theme.getColor(_Theme.key_dialogTextHint)))
            except Exception:
                pass
            try:
                edit.setKeyListener(DigitsKeyListener.getInstance('0123456789'))
            except Exception:
                pass
            try:
                edit.setFilters([InputFilter.LengthFilter(len(str(int(hi))))])
            except Exception:
                pass
            try:
                edit.setText(cur)
                edit.setSelection(len(cur))
            except Exception:
                pass
            layout.addView(edit, LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT))
            builder = AlertDialogBuilder(ctx)
            builder.set_title(title)
            builder.set_view(layout)

            def on_ok(dialog, which):
                self._set_num_setting(key, str(edit.getText()), default, lo, hi)
                if on_saved:
                    try:
                        on_saved()
                    except Exception:
                        pass
                try:
                    self.notify_settings_changed()
                except Exception:
                    pass
            builder.set_positive_button(_tr('btn_save'), on_ok)
            builder.set_negative_button(_tr('btn_cancel'), None)
            builder.show()
        except Exception as e:
            self.log('num dialog err: %s' % e)

    def _edit_interval(self, view=None):

        def after():
            if self.pill:
                self.pill.refresh_async()
        self._show_num_dialog('update_interval', _tr('dlg_interval_title'), 1, 1, 3600, on_saved=after)

    def _edit_warn(self, view=None):
        self._show_num_dialog('warn_mb', _tr('dlg_warn_title'), 700, 50, 1000000)

    def _edit_crit(self, view=None):
        self._show_num_dialog('crit_mb', _tr('dlg_crit_title'), 1200, 50, 1000000)

    def create_settings(self) -> List[Any]:
        from ui.settings import Header, Switch, Selector, Divider, Text
        interval = str(self.get_setting('update_interval', '1'))
        warn = str(self.get_setting('warn_mb', '700'))
        crit = str(self.get_setting('crit_mb', '1200'))
        rows = [Header(_tr('set_header') % __version__), Switch('enable_pill', _tr('set_enable_pill'), True, on_change=lambda v: self.pill.set_pill_enabled(v) if self.pill else self.set_setting('enable_pill', v)), Text(text=_tr('set_interval_row') % interval, icon='msg_settings', on_click=self._edit_interval), Selector('display_mode', _tr('set_display_mode'), 0, _mode_names(), on_change=lambda v: self.set_setting('display_mode', v)), Selector('click_action', _tr('set_click_action'), 0, [_tr('click_refresh'), _tr('click_cycle'), _tr('click_live')], on_change=lambda v: self.set_setting('click_action', v)), Divider(), Header(_tr('set_color_header')), Selector('color_mode', _tr('set_color_mode'), 0, [_tr('color_auto'), _tr('color_system'), _tr('color_white')], on_change=lambda v: self.set_setting('color_mode', v)), Text(text=_tr('set_warn_row') % warn, icon='msg_settings', on_click=self._edit_warn), Text(text=_tr('set_crit_row') % crit, icon='msg_settings', on_click=self._edit_crit), Divider(), Text(text='@chestertech / @useful_plugins', icon='msg_info')]
        return rows
