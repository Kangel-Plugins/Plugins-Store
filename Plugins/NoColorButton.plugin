__id__ = "NoColorButton"
__name__ = "No Color Button"
__description__ = "Убирает чёртовы цветные кнопки от ботов (прям любые)."
__author__ = "original @pixwet, fork by @Tsarkei"
__version__ = "1.4"
__icon__ = "te4_lei3_xi1_ya4_by_fStikBot/12"
__app_version__ = ">=12.10.6"

import traceback

from base_plugin import BasePlugin, MethodHook
from hook_utils import find_class

# bg_primary / bg_danger / bg_success are flag bits 0, 1, 2 of KeyboardButtonStyle.flags
BG_BITS = (("bg_primary", 1), ("bg_danger", 2), ("bg_success", 4))

STYLE_CLASSES = (
    "org.telegram.tgnet.tl.TL_keyboard$KeyboardButtonStyle",
    "org.telegram.tgnet.TLRPC$KeyboardButtonStyle",
    "org.telegram.tgnet.TLRPC$TL_keyboardButtonStyle",
)
BUTTON_CLASSES = (
    "org.telegram.messenger.BotInlineKeyboard$ButtonBot",
)


def _clear(style):
    for name, _bit in BG_BITS:
        try:
            setattr(style, name, False)
        except Exception:
            pass


def _restore(style):
    # flags still hold the original bits from the server: put the booleans back so the
    # message is cached unchanged and colors return if the plugin is turned off
    try:
        flags = int(style.flags)
    except Exception:
        return
    for name, bit in BG_BITS:
        try:
            setattr(style, name, bool(flags & bit))
        except Exception:
            pass


class _AfterRead(MethodHook):
    def after_hooked_method(self, param):
        try:
            _clear(param.thisObject)
        except Exception:
            traceback.print_exc()


class _AroundSerialize(MethodHook):
    def before_hooked_method(self, param):
        try:
            _restore(param.thisObject)
        except Exception:
            traceback.print_exc()

    def after_hooked_method(self, param):
        try:
            _clear(param.thisObject)
        except Exception:
            traceback.print_exc()


class _NoneColor(MethodHook):
    def __init__(self, none_value):
        self.none_value = none_value

    def before_hooked_method(self, param):
        if self.none_value is not None:
            param.setResult(self.none_value)


class NoColorButtonPlugin(BasePlugin):

    def on_plugin_load(self):
        self._hooks = []
        layers = 0

        # layer 1: strip the colors from the button data itself, whatever draws the button
        for name in STYLE_CLASSES:
            cls = find_class(name)
            if cls is None:
                continue
            if self._hook(cls, "readParams", _AfterRead()):
                layers += 1
                self._hook(cls, "serializeToStream", _AroundSerialize())

        # layer 2: the renderer asks ButtonBot.getColor() -> always NONE
        none_value = None
        enum_cls = find_class("org.telegram.messenger.BotInlineKeyboard$BackgroundColor")
        if enum_cls is not None:
            try:
                none_value = enum_cls.getField("NONE").get(None)
            except Exception:
                traceback.print_exc()
        if none_value is not None:
            for name in BUTTON_CLASSES:
                cls = find_class(name)
                if cls is not None and self._hook(cls, "getColor", _NoneColor(none_value)):
                    layers += 1

        if layers == 0:
            self.log("NoColorButton: no hook points found in this client version")

    def on_plugin_unload(self):
        for h in list(self._hooks):
            try:
                self.unhook_method(h)
            except Exception:
                pass
        self._hooks = []

    def _hook(self, cls, method, hook):
        try:
            res = self.hook_all_methods(cls, method, hook)
            if res:
                self._hooks.extend(list(res))
                return True
        except Exception:
            traceback.print_exc()
        self.log("NoColorButton: hook failed: %s" % method)
        return False
