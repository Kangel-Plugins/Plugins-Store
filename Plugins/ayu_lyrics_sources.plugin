# System language, independent of provider data and saved preferences.
_language_override = None
_language_choice = 0
_language_cache = (0.0, "en")

def _language_index(value):
    try:
        index = int(value)
        return index if index in (0, 1, 2) else 0
    except (ValueError, TypeError):
        return {"ru": 1, "en": 2}.get(str(value).lower(), 0)

def _language():
    global _language_cache
    if _language_override in ("ru", "en"):
        return _language_override
    if _language_choice in (1, 2):
        return "ru" if _language_choice == 1 else "en"
    now = time.monotonic()
    if now - _language_cache[0] < 1:
        return _language_cache[1]
    try:
        locale = jclass("android.content.res.Resources").getSystem().getConfiguration().locale
        language = str(locale.getLanguage())
    except Exception:
        try:
            language = str(jclass("java.util.Locale").getDefault().getLanguage())
        except Exception:
            language = "en"
    language = "ru" if language.lower().startswith("ru") else "en"
    _language_cache = (now, language)
    return language

