_REVERSE_TRANSLATIONS = {value: key for key, value in _TRANSLATIONS.items()}

def _t(value):
    if not isinstance(value, str):
        return value
    canonical = value if value in _TRANSLATIONS else _REVERSE_TRANSLATIONS.get(value, value)
    return canonical if _language() == "ru" else _TRANSLATIONS.get(canonical, canonical)

def _localized_setting(factory):
    def create(**kwargs):
        for name in ("text", "subtext"):
            if name in kwargs:
                kwargs[name] = _t(kwargs[name])
        if "items" in kwargs:
            kwargs["items"] = [_t(value) for value in kwargs["items"]]
        return factory(**kwargs)
    return create

Header, Switch, Selector, Input, Text, Divider = map(_localized_setting, (Header, Switch, Selector, Input, Text, Divider))
