STAMP = re.compile(r"\[(\d{1,3}):(\d{1,2})(?:[.:](\d{1,3}))?\]")
WORD_STAMP = re.compile(r"<\d{1,3}:\d{1,2}(?:[.:]\d{1,3})?>")
VERSION = re.compile(r"\b(live|remix|acoustic|instrumental|karaoke|sped|slowed|nightcore|cover)\b", re.I)


def find_class(name):
    # Explicit java.lang.Class avoids SDK-version differences in find_class wrappers.
    context = jclass("org.telegram.messenger.ApplicationLoader").applicationContext
    return jclass("java.lang.Class").forName(name, False, context.getClassLoader())


def number(value, default=0):
    try:
        value = float(value)
        return value if math.isfinite(value) else default
    except (ValueError, TypeError):
        return default


def norm(value):
    folded = unicodedata.normalize("NFKD", str(value or "")).casefold()
    folded = "".join(c for c in folded if not unicodedata.combining(c))
    return " ".join(re.findall(r"[^\W_]+", folded))


def strip_extras(text):
    text = re.sub(r"[\(\[][^\)\]]*\b(?:feat|ft|featuring|official|video|audio|visualizer|lyrics?|remastered|remaster|album version|explicit)\b[^\)\]]*[\)\]]", " ", str(text or ""), flags=re.I)
    text = re.sub(r"\s+\b(feat|ft|featuring)\.?\s+.*$", " ", text, flags=re.I)
    return norm(text)


def similarity(a, b):
    # Same bounded Levenshtein metric as Resonance; substring matches are not exact.
    a_norm, b_norm = strip_extras(a)[:300], strip_extras(b)[:300]
    if not a_norm or not b_norm:
        return 0.0
    if a_norm == b_norm:
        return 1.0
    previous = list(range(len(b_norm) + 1))
    for i, char in enumerate(a_norm):
        row = [i + 1]
        for j, other in enumerate(b_norm):
            row.append(min(row[j] + 1, previous[j + 1] + 1, previous[j] + (char != other)))
        previous = row
    return 1 - previous[-1] / max(len(a_norm), len(b_norm))


def artist_similarity(a, b):
    def canonical(text):
        # Android ICU supplies the same Latin folding used by Foundation on macOS.
        try:
            text = jclass("android.icu.text.Transliterator").getInstance("Any-Latin; Latin-ASCII").transliterate(str(text))
        except Exception:
            pass
        return strip_extras(text)
    left, right = canonical(a), canonical(b)
    if left and sorted(left.split()) == sorted(right.split()):
        return 1.0
    primary_a, primary_b = (canonical(re.split(r"[,;]", str(x))[0]) for x in (a, b))
    return max(similarity(left, right), similarity(primary_a, primary_b))


def text_agreement(left, right):
    def shingles(value):
        words = norm(value).split()
        if len(words) >= 8:
            return {" ".join(words[i:i + 3]) for i in range(len(words) - 2)}
        chars = "".join(words)
        return {chars[i:i + 4] for i in range(len(chars) - 3)} if len(chars) >= 8 else set()
    a, b = shingles(left), shingles(right)
    return len(a & b) / max(len(a), len(b)) if min(len(a), len(b)) >= 4 else 0.0


def names(value):
    if isinstance(value, list):
        return ", ".join(names(v) for v in value)
    if isinstance(value, dict):
        return str(value.get("name") or value.get("title") or "")
    return str(value or "")


def metadata(value):
    if not isinstance(value, dict):
        return {}
    return {"title": names(value.get("trackName") or value.get("title") or value.get("name")),
            "artist": names(value.get("artistName") or value.get("artist") or value.get("artists")),
            "album": names(value.get("albumName") or value.get("album")),
            "duration": number(value.get("duration")) or number(value.get("duration_ms")) / 1000 or
                        ((clock_ms(value.get("duration")) or 0) / 1000)}


def match_quality(query, meta, trusted=False):
    """Reject other recordings before considering timing quality."""
    title, artist = meta.get("title", ""), meta.get("artist", "")
    if not title and not trusted:
        return None
    ts = similarity(query["title"], title) if title else 0.83
    ars = artist_similarity(query["artist"], artist) if query["artist"] and artist else 0.0
    if ts < 0.74 or (query["artist"] and artist and ars < 0.65):
        return None
    if title and set(VERSION.findall(norm(query["title"]))) != set(VERSION.findall(norm(title))):
        return None
    duration = number(meta.get("duration"))
    delta = abs(query["duration"] - duration) if query["duration"] and duration else None
    max_delta = max(18, (query["duration"] or 0) * 0.08)
    if delta is not None and delta > max_delta and not query.get("_manual"):
        return None
    # Metadata-less endpoints cannot outrank a verified exact recording.
    score = ts * .55 + ars * .3 + (max(0, 1 - delta / 5) if delta is not None else .3) * .15
    exact = int(bool(title and artist and query["artist"]) and ts >= .9 and ars >= .8
                and delta is not None and delta <= 3 and score >= .84)
    return exact, round(ts * 0.65 + ars * 0.35, 4), -(delta if delta is not None else 5)


def text_clean(text):
    return str(text or "").replace("\x00", "").strip()[:4000]


def lrc_parse(text):
    if not isinstance(text, str) or len(text) > MAX_BYTES:
        return []
    offset = re.search(r"(?im)^\[offset:\s*([+-]?\d+)\s*\]", text)
    offset = int(offset.group(1)) if offset else 0
    timed, plain = [], []
    for raw in text.splitlines()[:MAX_LINES]:
        raw = raw.strip()
        marks, end = [], 0
        while True:
            match = STAMP.match(raw, end)
            if not match:
                break
            mm, ss, ff = match.groups()
            if int(ss) >= 60:
                return []
            marks.append(max(0, int(mm) * 60000 + int(ss) * 1000 + int((ff or "0").ljust(3, "0")) - offset))
            end = match.end()
        if marks:
            content = text_clean(WORD_STAMP.sub("", raw[end:]))
            timed.extend((stamp, content) for stamp in marks)
        elif raw and not re.match(r"^\[[A-Za-z#]+:.*\]$", raw):
            plain.append((None, text_clean(raw)))
    return timed or plain


def clock_ms(value):
    if value is None:
        return None
    value = str(value).strip()
    try:
        for suffix, scale in (("ms", 1), ("h", 3600000), ("m", 60000), ("s", 1000)):
            if value.endswith(suffix):
                result = float(value[:-len(suffix)]) * scale
                return int(result) if math.isfinite(result) else None
        parts = value.split(":")
        if len(parts) == 1:
            result = float(value) * 1000  # Apple/Better Lyrics bare seconds
            return round(result) if math.isfinite(result) else None
        if len(parts) not in (2, 3):
            return None
        total = 0
        for part in parts:
            total = total * 60 + float(part)
        return round(total * 1000) if math.isfinite(total) else None
    except (ValueError, OverflowError):
        return None


def ttml_parse(text):
    """Read absolute TTML paragraph timing; unsupported relative/seq timing fails closed."""
    if not isinstance(text, str) or len(text) > MAX_BYTES or re.search(r"<!DOCTYPE|<!ENTITY", text, re.I):
        return []
    try:
        root = ET.fromstring(text)
    except ET.ParseError:
        return []
    if any(node.attrib.get("timeContainer") == "seq" for node in root.iter()):
        return []
    # Apple/AMLL exports repeat absolute times on sections and paragraphs.
    # A child preceding its container is a relative-timing document we do not support.
    for parent in root.iter():
        if parent.tag.rsplit("}", 1)[-1] not in ("body", "div"):
            continue
        begin = clock_ms(parent.attrib.get("begin"))
        if begin is not None and any(child.tag.rsplit("}", 1)[-1] == "p" and
            clock_ms(child.attrib.get("begin")) is not None and clock_ms(child.attrib["begin"]) < begin for child in parent.iter()):
            return []

    def visible(node):
        role = next((v for k, v in node.attrib.items() if k.rsplit("}", 1)[-1] == "role"), "")
        if role in ("x-translation", "x-roman", "x-bg", "translation", "romanization"):
            return ""
        result = node.text or ""
        for child in node:
            result += ("\n" if child.tag.rsplit("}", 1)[-1] == "br" else visible(child)) + (child.tail or "")
        return result

    out = []
    for node in root.iter():
        if node.tag.rsplit("}", 1)[-1] != "p":
            continue
        start = clock_ms(node.attrib.get("begin"))
        if start is None:
            starts = [clock_ms(c.attrib.get("begin")) for c in node.iter()]
            starts = [s for s in starts if s is not None]
            start = min(starts) if starts else None
        content = re.sub(r"\s+", " ", visible(node)).strip()
        if content:
            out.append((start, content))
        if len(out) >= MAX_LINES:
            break
    # Never invent timing for untimed lines inside an otherwise timed document.
    if any(s is None for s, _ in out):
        return [(None, t) for _, t in out]
    return out


def utf16_length(text):
    return len(text.encode("utf-16-le")) // 2


def align_words(text, tokens, line_start):
    """Match source tokens to UTF-16 offsets used by Android Layout; never distribute time."""
    words, cursor, previous = [], 0, -1
    for start, end, token in tokens[:256]:
        token = re.sub(r"\s+", " ", str(token or "")).strip()
        if not token or start is None:
            continue
        start = int(start)
        end = int(end) if end is not None else start  # onset-only, not an invented duration
        if start < previous or start < line_start - 50 or end < start or end - start > 60000:
            return []
        index = text.find(token, cursor)
        if index < 0 or text[cursor:index].strip():
            return []
        finish = index + len(token)
        words.append([start, end, utf16_length(text[:index]), utf16_length(text[:finish])])
        cursor, previous = finish, start
    if text[cursor:].strip() or not words:
        return []
    return words


def ttml_words(text, lines):
    if not isinstance(text, str) or len(text) > MAX_BYTES or not text or not lines or re.search(r"<!DOCTYPE|<!ENTITY", text, re.I):
        return []
    try:
        root = ET.fromstring(text)
    except ET.ParseError:
        return []
    by_key = {(s, t): [] for s, t in lines if s is not None}
    result = []

    def collect(node, excluded=False):
        role = next((v for k, v in node.attrib.items() if k.rsplit("}", 1)[-1] == "role"), "")
        if excluded or role in ("x-translation", "x-roman", "x-bg", "translation", "romanization"):
            return []
        children = [c for c in node if c.attrib.get("begin") is not None]
        if node.tag.rsplit("}", 1)[-1] == "span" and not children and "begin" in node.attrib:
            return [(clock_ms(node.attrib.get("begin")), clock_ms(node.attrib.get("end")), "".join(node.itertext()))]
        return [word for child in node for word in collect(child)]

    for node in root.iter():
        if node.tag.rsplit("}", 1)[-1] != "p":
            continue
        tokens = collect(node)
        start = clock_ms(node.attrib.get("begin"))
        if start is None:
            start = min((s for s, _, _ in tokens if s is not None), default=None)
        for stamp, content in by_key:
            if stamp == start:
                words = align_words(content, tokens, stamp)
                if words:
                    result.append({"time": stamp, "text": content, "words": words})
                    break
    return result


def enhanced_words(text, lines):
    available = {(s, t) for s, t in lines if s is not None}
    result = []
    offset = re.search(r"(?im)^\[offset:\s*([+-]?\d+)\s*\]", text or "")
    offset = int(offset.group(1)) if offset else 0
    for raw in (text or "").splitlines()[:MAX_LINES]:
        tags = list(WORD_STAMP.finditer(raw))
        if len(tags) < 2:
            continue
        parsed = lrc_parse(raw)
        for stamp, content in parsed:
            stamp = max(0, stamp - offset) if stamp is not None else None
            if (stamp, content) not in available:
                continue
            tokens = []
            for i, tag in enumerate(tags):
                start = clock_ms(tag.group()[1:-1])
                end = clock_ms(tags[i + 1].group()[1:-1]) if i + 1 < len(tags) else None
                token = raw[tag.end():tags[i + 1].start() if i + 1 < len(tags) else len(raw)]
                tokens.append((max(0, start - offset), max(0, end - offset) if end is not None else None, token))
            words = align_words(content, tokens, stamp)
            if words:
                result.append({"time": stamp, "text": content, "words": words})
    return result


def json_words(rows, lines, line_time="start", word_key="words", word_start="start", word_end="end"):
    available = {(s, t) for s, t in lines if s is not None}
    out = []
    for row in (rows if isinstance(rows, list) else [])[:MAX_LINES]:
        if not isinstance(row, dict) or row.get(line_time) is None:
            continue
        stamp, content = round(number(row[line_time], -1)), text_clean(row.get("text"))
        if (stamp, content) not in available:
            continue
        tokens = []
        for word in (row.get(word_key) or [])[:256]:
            if not isinstance(word, dict) or word.get(word_start) is None:
                continue
            start = number(word[word_start], -1)
            end = number(word.get(word_end), -1)
            if end < 0 and word.get("duration") is not None:
                end = start + number(word["duration"])
            tokens.append((start, end if end >= 0 else None, word.get("text")))
        words = align_words(content, tokens, stamp)
        if words:
            out.append({"time": stamp, "text": content, "words": words})
    return out


def lyricsfile_parse(text):
    if not isinstance(text, str) or not text or len(text) > MAX_BYTES:
        return [], []
    try:
        import yaml  # PyYAML 6.0.3 is bundled in the inspected APK.
        if any(isinstance(token, yaml.tokens.AliasToken) for token in yaml.scan(text)):
            return [], []
        data = yaml.safe_load(text)
        if not isinstance(data, dict):
            return [], []
        lines = structured_lines(data.get("lines"), "start_ms")
        return lines, json_words(data.get("lines"), lines, "start_ms", "words", "start_ms", "end_ms")
    except Exception:
        return [], []


def structured_lines(rows, time_key="start", text_key="text", scale=1, timed=True):
    out = []
    for row in (rows if isinstance(rows, list) else [])[:MAX_LINES]:
        if not isinstance(row, dict):
            continue
        value = row.get(time_key)
        stamp = number(value, -1) * scale if timed and value is not None else -1
        out.append((round(stamp) if stamp >= 0 else None, text_clean(row.get(text_key))))
    if any(s is None for s, text in out if text):
        return [(None, text) for _, text in out]
    return out


PREF_SOURCE_KEYS = ("auto", "lrcmux", "lrclib", "amll", "karalyr", "better", "liriqo", "lrcred", "lrcshare", "lyrically", "lyricsplus")


def onset_only(item):
    words = [word for row in item.get("word_lines", []) for word in row.get("words", [])]
    return bool(words) and sum(word[1] <= word[0] for word in words) > len(words) // 2


def apple_word_source(item):
    return bool(re.search(r"apple[\s_-]*music|苹果音乐|蘋果音樂", str(item.get("credit") or ""), re.I)) and bool(item.get("word_lines")) and not onset_only(item)


def mark_timing_preferences(candidates, config):
    for item in candidates:
        item["apple_preferred"] = False
    if not config.get("apple_first", True) or config.get("pref_source", 0) or config.get("pref_mode", 0):
        return
    apples = [c for c in candidates if c.get("auto_eligible") and apple_word_source(c)]
    if not apples:
        return
    eligible = [c for c in candidates if c.get("auto_eligible") and not c.get("instrumental")]
    total = max((content_size(c)[0] for c in eligible), default=0)
    references = [(c, "\n".join(text for _, text in c["lines"])) for c in eligible]
    for item in apples:
        plain = "\n".join(text for _, text in item["lines"])
        agreement = max((text_agreement(plain, text) for other, text in references if other is not item), default=1)
        # Repeated backing vocals and punctuation conventions may increase other word counts.
        # A cut verse still fails coverage or agreement; explicit user priorities remain in control.
        item["apple_preferred"] = bool(total and content_size(item)[0] >= total * .90 and agreement >= .9)


def timing_rank(item):
    if not item.get("synced"):
        return 0
    rows = item.get("word_lines", [])
    if not rows:
        return 1
    full = {(s, text) for s, text in item["lines"] if text.strip()}
    exact = set()
    for row in rows:
        encoded = row["text"].encode("utf-16-le")
        if all(len(encoded[w[2] * 2:w[3] * 2].decode("utf-16-le").split()) == 1 for w in row["words"]):
            exact.add((row["time"], row["text"]))
    return 3 if exact == full and not onset_only(item) else 2



def content_size(item):
    """Text coverage, independent of blank rows, line wrapping, timing and provider order."""
    units, rows = 0, 0
    for _, text in item.get("lines", []):
        # Section headings are annotations, not extra vocals.
        if re.fullmatch(r"\s*[\[(](?:intro|outro|verse|chorus|bridge|pre[- ]?chorus|instrumental|куплет|припев|интро|аутро)(?:[^\])]{0,60})[\])]\s*", text, re.I):
            continue
        value = unicodedata.normalize("NFC", norm(text))
        if not value:
            continue
        # CJK lyrics often have no spaces; count their written units individually.
        value = re.sub(r"([\u3400-\u9fff\u3040-\u30ff\uac00-\ud7af])", r" \1 ", value)
        units += len(value.split())
        rows += 1
    return units, rows


def rank_candidate(c, config=None):
    if not c:
        return (-999,)
    config = config or {}
    pref_source_idx = int(config.get("pref_source", 0) or 0)
    pref_key = PREF_SOURCE_KEYS[pref_source_idx] if 0 <= pref_source_idx < len(PREF_SOURCE_KEYS) else "auto"
    pref_bonus = int(pref_key != "auto" and c.get("provider") == pref_key)

    pref_mode = int(config.get("pref_mode", 0) or 0)
    quality = c.get("quality") or (0, 0.83, -5)
    exact = int(c.get("auto_eligible", bool(quality[0])))
    sim = quality[1]
    delta = quality[2]
    synced = bool(c.get("synced"))
    content_units, lines_count = content_size(c)
    sync_score = timing_rank(c)
    word_quality = sync_score >= 2
    embedded = int(c.get("provider") == "embedded" and config.get("embedded_first", False))
    apple = int(bool(c.get("apple_preferred")) and config.get("apple_first", True) and not pref_source_idx and not pref_mode)
    prefix = (exact, embedded, apple, content_units)
    order = config.get("sources", ())
    source_priority = -order.index(c["provider"]) if c.get("provider") in order else -99

    if pref_mode == 1:
        # Построчная синхронизация в приоритете
        sync_score = 4 if (synced and not word_quality) else sync_score
        return (*prefix, pref_bonus, sync_score, sim, delta, min(lines_count, 200), source_priority)
    elif pref_mode == 2:
        # Точные метаданные и длительность в приоритете
        return (*prefix, pref_bonus, sim, delta, sync_score, min(lines_count, 200), source_priority)
    elif pref_mode == 3:
        # Максимальная полнота текста
        return (*prefix, pref_bonus, min(lines_count, 200), sync_score, sim, delta, source_priority)
    else:
        # Full eligible transcription first; timing quality breaks equal-coverage ties.
        return (*prefix, sync_score, pref_bonus, sim, delta, min(lines_count, 200), source_priority)


# Only explicit credit labels: never guess from short lyrics or a person's name.
CREDIT_LABEL = re.compile(r"^(?:作[词詞曲]|编曲|編曲|制作人|製作人|演唱|歌手|词曲|詞曲|"
    r"автор(?:ы| слов| музыки| текста)?|композитор|исполнитель|вокал|аранжировка|сведение|мастеринг|продюсер|"
    r"artist|singer|songwriter|lyrics?(?:\s+(?:by|and music by))?|music(?:\s+by)?|written by|compos(?:er|ed by)|"
    r"performed by|produced by|arranged by|vocals?(?:\s+by)?|текст|музыка)\s*[:：]\s*.+$", re.I)
CREDIT_BY = re.compile(r"^(?:lyrics?|music|written|composed|performed|produced|arranged|vocals?)\s+by\s+\S.+$", re.I)


def clean_lyric_lines(lines, query=None, meta=None):
    cleaned = []
    if not isinstance(lines, (list, tuple)):
        return []
    for row in lines[:MAX_LINES]:
        if not isinstance(row, (list, tuple)) or len(row) != 2:
            continue
        stamp, raw = row
        if not isinstance(raw, str):
            continue
        text = text_clean(raw)
        if text.startswith("{") and '"c"' in text and '"t"' in text:
            try:
                row = json.loads(text)
                parts = row.get("c") if isinstance(row, dict) else None
                if (isinstance(parts, list) and parts and isinstance(row.get("t"), (int, float))
                        and all(isinstance(part, dict) and isinstance(part.get("tx"), str) for part in parts)):
                    # NetEase metadata headers are JSON, not lyrics; negative t is a sentinel.
                    if not math.isfinite(row["t"]) or row["t"] <= 0:
                        continue
                    text = text_clean("".join(part["tx"] for part in parts))
            except (ValueError, TypeError):
                # A broken structured NetEase header must not become visible lyric text.
                continue
        if CREDIT_LABEL.fullmatch(text) or CREDIT_BY.fullmatch(text):
            continue
        cleaned.append((stamp, text))
    content = [norm(text) for _, text in cleaned if norm(text)]
    if not content:
        return []
    return cleaned


def needs_upstream_confirmation(credit):
    return bool(re.search(r"net[\s_-]*ease|music\.163|music163|网易|網易|云音乐|雲音樂", str(credit or ""), re.I))


def instrumental_hint(payload, lines=()):
    """Only explicit provider flags or a whole, otherwise empty instrumental notice."""
    if isinstance(payload, dict) and (payload.get("instrumental") is True or payload.get("pureMusic") is True):
        return True
    content = [text.strip() for _, text in clean_lyric_lines(lines) if text.strip()]
    return bool(content) and all(re.fullmatch(
        r"[\[（(]?\s*(?:纯音乐[，,]?\s*请欣赏|純音樂[，,]?\s*請欣賞|instrumental(?: track)?|инструментал|инструментальная композиция)\s*[\]）)]?[.!。]?", text, re.I)
        for text in content)


def sanitize_candidate(item, query=None):
    if not isinstance(item, dict):
        return None
    result = dict(item)
    if result.get("instrumental"):
        result.update(lines=[], word_lines=[], synced=False)
        return result
    lines = clean_lyric_lines(result.get("lines", []), query, result.get("metadata"))
    if not lines or sum(len(t) for _, t in lines) < 12:
        return None
    result["lines"] = lines
    keys = {(stamp, text) for stamp, text in lines}
    result["word_lines"] = [row for row in (result.get("word_lines") or []) if isinstance(row, dict) and (row.get("time"), row.get("text")) in keys]
    if needs_upstream_confirmation(result.get("credit")):
        result["requires_text_validation"] = True
        result["upstream_restricted"] = True
        if not result.get("upstream_confirmed"):
            result["auto_eligible"] = False
    return result


def parse_artist_aliases(value):
    if isinstance(value, str):
        try:
            decoded = json.loads(value)
            pairs = decoded if isinstance(decoded, list) else []
        except (ValueError, TypeError):
            pairs = [part.split("=", 1) for part in value.split(";") if "=" in part]
    else:
        pairs = value if isinstance(value, (list, tuple)) else []
    result = {}
    for pair in pairs[:24]:
        if not isinstance(pair, (list, tuple)) or len(pair) != 2 or not all(isinstance(x, str) for x in pair):
            continue
        original, alias = (" ".join(x.split())[:200] for x in pair)
        if original and alias and strip_extras(original) != strip_extras(alias):
            result[strip_extras(original)] = (original, alias)
    return list(result.values())


def candidate(provider, query, meta, lines, credit=None, trusted=False, instrumental=False, word_lines=None, config=None):
    quality = match_quality(query, meta, trusted)
    if quality is None:
        return None
    instrumental = instrumental or instrumental_hint({}, lines)
    # Preserve timed rests for the native dots and the end of a vocal phrase.
    lines = clean_lyric_lines([(s, text_clean(t)) for s, t in lines[:MAX_LINES] if t or s is not None], query, meta)
    if instrumental and quality[0]:
        lines = []
    if not lines:
        return {"provider": provider, "credit": credit or provider, "lines": [], "quality": quality,
                "rank": (*quality[:1], -1, *quality[1:]), "metadata": meta,
                "auto_eligible": bool(quality[0]), "synced": False, "instrumental": True,
                "word_lines": []} if instrumental and quality[0] else None
    if sum(len(t) for _, t in lines) < 12:
        return None
    synced = all(s is not None for s, _ in lines)
    if synced:
        if any(not math.isfinite(s) or s < 0 or s > 6 * 3600000 for s, _ in lines):
            return None
        if query["duration"] and not (query.get("_manual") and not quality[0]) and max(s for s, _ in lines) > query["duration"] * 1000 + max(3000, query["duration"] * 10):
            return None
        lines = sorted(dict.fromkeys(lines), key=lambda x: x[0])
        if len({s for s, _ in lines}) < 2:
            synced = False
    if not synced:
        lines = [(None, t) for _, t in lines]
    # Exact recording, usable line sync, metadata fit, duration fit, completeness.
    keys = {(s, t) for s, t in lines if synced}
    max_word_time = (query["duration"] * 1000 + max(3000, query["duration"] * 10)) if query["duration"] and not (query.get("_manual") and not quality[0]) else 6 * 3600000
    cleaned_words = []
    for r in (word_lines or []):
        if not isinstance(r, dict):
            continue
        r_time, text, words = r.get("time"), r.get("text", ""), r.get("words") or []
        if (r_time, text) not in keys or not (1 <= len(words) <= 256):
            continue
        previous_start, previous_end = -1, 0
        valid = True
        for w in words:
            if not isinstance(w, (list, tuple)) or len(w) != 4 or any(not isinstance(v, int) for v in w):
                valid = False
                break
            if not (max(0, r_time - 50) <= w[0] <= w[1] <= max_word_time and w[0] >= previous_start
                    and previous_end <= w[2] < w[3] <= utf16_length(text)):
                valid = False
                break
            try:
                encoded = text.encode("utf-16-le")
                encoded[w[2] * 2:w[3] * 2].decode("utf-16-le")
                if encoded[previous_end * 2:w[2] * 2].decode("utf-16-le").strip():
                    valid = False
                    break
            except UnicodeError:
                valid = False
                break
            previous_start, previous_end = w[0], w[3]
        if valid and not text.encode("utf-16-le")[previous_end * 2:].decode("utf-16-le").strip():
            cleaned_words.append(r)
    word_lines = cleaned_words
    item = {
        "provider": provider,
        "credit": credit or provider,
        "lines": lines,
        "quality": quality,
        "metadata": dict(meta),
        "requires_text_validation": bool(trusted or not number(meta.get("duration"))),
        "auto_eligible": bool(quality[0] and not trusted),
        "synced": synced,
        "instrumental": False,
        "word_lines": word_lines,
    }
    item = sanitize_candidate(item, query)
    if item:
        item["rank"] = rank_candidate(item, config)
    return item


def to_lrc(result, sync=True):
    if not result:
        return ""
    out = []
    for stamp, text in result["lines"]:
        if sync and result["synced"] and stamp is not None:
            out.append("[%02d:%02d.%03d]%s" % (stamp // 60000, stamp // 1000 % 60, stamp % 1000, text))
        else:
            # Prevent a lyric containing a literal LRC tag from enabling sync accidentally.
            out.append(STAMP.sub("", WORD_STAMP.sub("", text)))
    return "\n".join(out)


class HttpFailure(Exception):
    pass


class SameOriginRedirect(urllib.request.HTTPRedirectHandler):
    """Do not forward API keys to a different origin via HTTP redirects."""
    def __init__(self, origin):
        self.origin = origin

    def redirect_request(self, req, fp, code, msg, hdrs, newurl):
        target = urllib.parse.urlsplit(newurl)
        if (target.scheme, target.hostname, target.port or 443) != self.origin:
            # urllib only closes the redirect response after a successful redirect_request.
            try:
                fp.close()
            except Exception:
                pass
            raise HttpFailure("cross-origin redirect")
        return super().redirect_request(req, fp, code, msg, hdrs, newurl)


class ProviderClient:
    def __init__(self):
        self.lock = threading.RLock()
        self.catalog_lock = threading.RLock()
        self.cooldown = {}
        self.catalog = None

    def get(self, url, params, deadline, headers=None, raw=False):
        parsed = urllib.parse.urlsplit(url)
        if parsed.scheme != "https" or not parsed.hostname or parsed.username or parsed.password:
            raise HttpFailure("HTTPS required")
        host = parsed.hostname
        with self.lock:
            if self.cooldown.get(host, 0) > time.monotonic():
                raise HttpFailure("cooldown")
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            raise HttpFailure("deadline")
        params = {k: v for k, v in params.items() if v is not None and v != "" and v != 0}
        if params:
            url += ("&" if "?" in url else "?") + urllib.parse.urlencode(params)
        h = {"User-Agent": UA, "Accept": "application/json, text/plain, application/xml", "Accept-Encoding": "identity"}
        h.update(headers or {})
        try:
            with urllib.request.build_opener(SameOriginRedirect(("https", host, parsed.port or 443))).open(urllib.request.Request(url, headers=h), timeout=min(8, remaining)) as response:
                chunks, size = [], 0
                while True:
                    if time.monotonic() >= deadline:
                        raise HttpFailure("deadline")
                    block = response.read(32768)
                    if not block:
                        break
                    size += len(block)
                    if size > MAX_BYTES:
                        raise HttpFailure("oversize")
                    chunks.append(block)
                text = b"".join(chunks).decode("utf-8-sig")
                return text if raw else json.loads(text)
        except urllib.error.HTTPError as error:
            try:
                code = error.code
                if code == 404:
                    return None
                delay = 60 if code == 429 else 30
                retry = (error.headers or {}).get("Retry-After", "")
                if retry:
                    try:
                        delay = max(delay, float(retry))
                    except ValueError:
                        try:
                            delay = max(delay, parsedate_to_datetime(retry).timestamp() - time.time())
                        except (ValueError, TypeError):
                            pass
                if code in (401, 403):
                    delay = 300
                if code in (401, 403, 419, 429, 500, 502, 503):
                    with self.lock:
                        now = time.monotonic()
                        for expired in [k for k, until in self.cooldown.items() if until <= now]:
                            del self.cooldown[expired]
                        self.cooldown[host] = now + min(max(delay, 1), 86400)
            finally:
                error.close()
            raise HttpFailure("HTTP %s" % code)
        except urllib.error.URLError as error:
            reason = error.reason
            if isinstance(reason, ssl.SSLCertVerificationError):
                raise HttpFailure(_t("TLS: не удалось проверить сертификат")) from None
            if isinstance(reason, (TimeoutError, socket.timeout)):
                raise HttpFailure(_t("таймаут соединения")) from None
            if isinstance(reason, socket.gaierror):
                raise HttpFailure(_t("DNS: сервер не найден")) from None
            raise HttpFailure(_t("ошибка сетевого соединения")) from None
        except (TimeoutError, socket.timeout):
            raise HttpFailure(_t("таймаут чтения")) from None

    def _netease_instrumental(self, query, deadline):
        # LiriQo drops NetEase's pureMusic flag and instrumental notice. Consult
        # the origin only for its credits-only response, never for lyric selection.
        data = self.get("https://music.163.com/api/search/get",
                        {"s": query["artist"] + " " + query["title"], "type": 1, "limit": 5}, deadline)
        rows = ((data or {}).get("result") or {}).get("songs") or []
        verified = []
        for row in rows[:5]:
            if not isinstance(row, dict):
                continue
            meta = metadata(row)
            meta["duration"] = number(row.get("duration")) / 1000
            quality = match_quality(query, meta)
            if quality and quality[0] and isinstance(row.get("id"), int) and not isinstance(row["id"], bool) and row["id"] > 0:
                verified.append((quality, row["id"], meta))
        for _, ident, meta in sorted(verified, key=lambda entry: entry[0], reverse=True)[:2]:
            data = self.get("https://music.163.com/api/song/lyric",
                            {"id": ident, "lv": -1, "kv": -1, "tv": -1}, deadline)
            if not isinstance(data, dict) or data.get("code") != 200:
                continue
            lines = lrc_parse((data.get("lrc") or {}).get("lyric") or "")
            if instrumental_hint(data, lines):
                return meta
        return None

    def fetch(self, provider, query, config, deadline):
        title, artist, album, duration = (query[k] for k in ("title", "artist", "album", "duration"))
        common = {"title": title, "artist": artist, "album": album, "duration": duration}
        lrparams = {"track_name": title, "artist_name": artist, "album_name": album, "duration": duration}
        out = []

        def add(meta, lines, credit=None, trusted=False, instrumental=False, word_lines=None):
            item = candidate(provider, query, meta, lines, credit, trusted, instrumental, word_lines)
            if item:
                out.append(item)
                progress = config.get("_provider_progress")
                if callable(progress):
                    progress(item)

        if provider in ("lrclib", "amll", "karalyr"):
            base = {"lrclib": "https://lrclib.net/api", "amll": "https://api.amll.dev/v1/lrclib", "karalyr": "https://www.karalyr.com/api"}[provider]
            credit = {"lrclib": "LRCLIB", "amll": "AMLL TTML", "karalyr": "Karalyr"}[provider]
            rows, failures = [], []
            def request(path, params):
                try:
                    return self.get(base + path, params, deadline)
                except Exception as error:
                    failures.append(error)
                    return None
            exact = request("/get", lrparams) if artist else None
            if isinstance(exact, dict):
                rows.append(exact)
                # Publish a verified exact result before the broader search request.
                first_lines = lrc_parse(exact.get("syncedLyrics") or exact.get("plainLyrics") or "")
                first_words = enhanced_words(exact.get("syncedLyrics") or "", first_lines)
                if config.get("words", True) and exact.get("lyricsfile"):
                    rich_lines, rich_words = lyricsfile_parse(exact["lyricsfile"])
                    if rich_lines and rich_words:
                        first_lines, first_words = rich_lines, rich_words
                add(metadata(exact), first_lines, credit, instrumental=instrumental_hint(exact, first_lines), word_lines=first_words)
            # A line-synced /get result must not hide a word-timed /search version.
            data = request("/search", {"track_name": title, "artist_name": artist})
            rows.extend(data if isinstance(data, list) else [])
            clean_t, clean_a = strip_extras(title), strip_extras(artist)
            if not any(match_quality(query, metadata(row)) for row in rows if isinstance(row, dict)):
                if (norm(title), norm(artist)) != (clean_t, clean_a):
                    data = request("/search", {"track_name": clean_t, "artist_name": clean_a})
                    rows.extend(data if isinstance(data, list) else [])
                if not rows and provider in ("lrclib", "amll"):
                    data = request("/search", {"q": (clean_a + " " + clean_t).strip()})
                    rows.extend(data if isinstance(data, list) else [])
            unique, rich_count = set(), 0
            ranked = [(match_quality(query, metadata(row)), row) for row in rows if isinstance(row, dict)]
            ranked = sorted((pair for pair in ranked if pair[0] is not None), key=lambda pair: pair[0], reverse=True)
            for _, row in ranked[:16]:
                identity = (str(row.get("id")), row.get("syncedLyrics"), row.get("plainLyrics"), row.get("lyricsfile"))
                if identity in unique:
                    continue
                unique.add(identity)
                lines = lrc_parse(row.get("syncedLyrics") or row.get("plainLyrics") or "")
                words = enhanced_words(row.get("syncedLyrics") or "", lines)
                if config.get("words", True) and row.get("lyricsfile"):
                    rich, rich_words = lyricsfile_parse(row["lyricsfile"])
                    if rich and (rich_words or not words):
                        lines, words = rich, rich_words
                if provider == "amll" and config.get("words", True) and row.get("id") and rich_count < 3:
                    rich_count += 1
                    try:
                        rich = self.get("https://api.amll.dev/v1/lyrics/get", {"id": row["id"]}, deadline)
                        text = ((rich or {}).get("data") or {}).get("lyrics")
                        rich_lines = ttml_parse(text) if text else []
                        if rich_lines:
                            lines, words = rich_lines, ttml_words(text, rich_lines)
                    except Exception:
                        pass
                add(metadata(row), lines, credit, instrumental=instrumental_hint(row, lines), word_lines=words)
            if not out and failures and not rows:
                raise failures[-1]
        elif provider == "lrcmux":
            data = self.get("https://api.lrcmux.dev/get", dict(common, level="word" if config.get("words", True) else "line", format="json"), deadline)
            clean_t = strip_extras(title)
            clean_a = strip_extras(artist)
            if not isinstance(data, dict) and (clean_t != title or clean_a != artist):
                clean_common = {"title": clean_t, "artist": clean_a, "album": album, "duration": duration}
                data = self.get("https://api.lrcmux.dev/get", dict(clean_common, level="word" if config.get("words", True) else "line", format="json"), deadline)
            if isinstance(data, dict):
                meta = data.get("meta") or {}
                source_info = meta.get("source") or {}
                source = source_info.get("name", "") if isinstance(source_info, dict) else str(source_info)
                lines = structured_lines(data.get("lines"), timed=meta.get("level") in ("line", "word"))
                add(metadata(data.get("track")), lines, "LRC Mux / " + source if source else "LRC Mux",
                    instrumental=instrumental_hint(meta, lines), word_lines=json_words(data.get("lines"), lines))
        elif provider == "better":
            headers = {"X-API-Key": config["better_key"]} if config["better_key"] else None
            data = self.get("https://api.betterlyrics.org/getLyrics", {"s": title, "a": artist, "al": album, "d": duration}, deadline, headers)
            if isinstance(data, dict) and data.get("ttml"):
                lines = ttml_parse(data["ttml"])
                add(dict(query, duration=0), lines, "Better Lyrics", trusted=True, word_lines=ttml_words(data["ttml"], lines))
        elif provider == "liriqo":
            data = self.get("https://api.liriqo-alfarrizi.my.id/v1/lyrics", common, deadline)
            if isinstance(data, dict):
                netease_missing = False
                tracks = [row for row in (data.get("tracks") or [])[:32] if isinstance(row, dict)]
                if config.get("apple_first", True):
                    tracks.sort(key=lambda row: not bool(re.search(r"apple[\s_-]*music|苹果音乐|蘋果音樂", str(row.get("upstreamProvider") or row.get("provider") or ""), re.I)))
                for row in tracks[:8]:
                    if not isinstance(row, dict):
                        continue
                    lines = structured_lines(row.get("timed"), timed=row.get("syncLevel") in ("word", "syllable", "line"))
                    if not lines:
                        lines = lrc_parse(row.get("plain") or "")
                    envelope = metadata(data.get("metadata"))
                    native = metadata(row)
                    own_identity = similarity(native["title"], envelope["title"]) >= .95 and artist_similarity(native["artist"], envelope["artist"]) >= .9
                    actual = {"title": native["title"] or envelope["title"], "artist": native["artist"] or envelope["artist"],
                              "album": native["album"] or envelope["album"],
                              "duration": native["duration"] or (envelope["duration"] if own_identity else 0)}
                    if row.get("ttml"):
                        rich_lines = ttml_parse(row["ttml"])
                        rich_words = ttml_words(row["ttml"], rich_lines)
                        if rich_words or not lines:
                            lines = rich_lines
                        else:
                            rich_words = json_words(row.get("timed"), lines)
                    else:
                        rich_words = json_words(row.get("timed"), lines)
                    upstream = str(row.get("upstreamProvider") or row.get("provider") or "LiriQo")
                    if needs_upstream_confirmation(upstream) and not clean_lyric_lines(lines, query, actual):
                        netease_missing = True
                    add(actual, lines, "LiriQo / " + upstream,
                        trusted=not native["duration"], instrumental=instrumental_hint(row, lines), word_lines=rich_words)
                if netease_missing and not any(item.get("instrumental") for item in out):
                    try:
                        confirmed = self._netease_instrumental(query, deadline)
                        if confirmed:
                            add(confirmed, [], "LiriQo / NetEase Cloud Music", instrumental=True)
                    except Exception:
                        pass  # Origin failure is not evidence of an instrumental recording.
        elif provider == "lrcred":
            client_id = config["lrcred_client"]
            if not re.search(r"https://\S+", client_id) or not re.search(r"[^\s@]+@[^\s@]+\.[^\s@]+", client_id):
                raise HttpFailure(_t("нужен Client ID: приложение, HTTPS-ссылка, email"))
            headers = {"User-Agent": "AyuLyricsSources/1.0 " + client_id}
            data = self.get("https://lrc.red/search.json", {"q": artist + " " + title}, deadline, headers)
            rows = data.get("hits", []) if isinstance(data, dict) else []
            ranked = [(match_quality(query, metadata(r)), r) for r in rows[:20]]
            ranked = sorted((p for p in ranked if p[0] is not None), key=lambda p: p[0], reverse=True)
            for _, row in ranked[:2]:
                ident = str(row.get("isrc") or "")
                if not re.fullmatch(r"[A-Za-z0-9]{12}", ident):
                    continue
                text = self.get("https://lrc.red/s/" + ident + ".ttml", {}, deadline, headers, raw=True)
                if text:
                    lines = ttml_parse(text)
                    add(metadata(row), lines, "lrc.red https://lrc.red/s/" + ident, word_lines=ttml_words(text, lines))
        elif provider == "lyricsplus":
            base = config["lyricsplus_url"].rstrip("/")
            if not base:
                raise HttpFailure(_t("укажите HTTPS-адрес своего LyricsPlus"))
            data = self.get(base + "/v2/lyrics/get", common, deadline)
            if isinstance(data, dict):
                lines = structured_lines(data.get("lyrics"), "time", timed=str(data.get("type")).lower() != "none")
                add(metadata(data.get("metadata")), lines, "LyricsPlus", trusted=True,
                    word_lines=json_words(data.get("lyrics"), lines, "time", "syllabus", "time", "end"))
        elif provider == "lrcshare":
            key = config["lrcshare_key"]
            if not key:
                raise HttpFailure(_t("нужен API-ключ LrcShare"))
            headers = {"X-API-Key": key}
            fingerprint = hashlib.sha256(key.encode()).hexdigest()
            with self.catalog_lock:
                catalog = self.catalog
                if not catalog or catalog[0] != fingerprint or catalog[1] < time.monotonic():
                    data = self.get("https://api.lrcshare.com/v1/catalog", {}, deadline, headers)
                    cat = (data or {}).get("data", {})
                    if not cat.get("session_token"):
                        raise HttpFailure("catalog unavailable")
                    self.catalog = catalog = (fingerprint, time.monotonic() + 23 * 3600, cat)
            cat = catalog[2]
            if title.lower() not in cat.get("text", "") or artist and artist.lower() not in cat.get("text", ""):
                return []
            headers["X-LrcShare-Session"] = cat["session_token"]
            data = self.get("https://api.lrcshare.com/v1/search", {"type": "song", "title": title, "artist": artist, "limit": 8}, deadline, headers)
            for row in ((data or {}).get("data") or {}).get("items", [])[:8]:
                if match_quality(query, metadata(row)) is None:
                    continue
                ident = urllib.parse.quote(str(row["id"]), safe="")
                data = self.get("https://api.lrcshare.com/v1/lyric/" + ident, {"lyric_format": "enhanced" if config.get("words", True) else "line"}, deadline, headers)
                for version in ((data or {}).get("data") or {}).get("lyric_versions", [])[:6]:
                    text = version.get("lrc")
                    lines = lrc_parse(text) if text else ttml_parse(version.get("ttml_text") or "<tt/>")
                    credit = "LrcShare https://lrcshare.com"
                    if version.get("comment"):
                        credit += " / " + text_clean(version["comment"])[:180]
                    words = enhanced_words(text, lines) if text else ttml_words(version.get("ttml_text") or "", lines)
                    add(metadata(row), lines, credit, word_lines=words)
                break
        elif provider == "lyrically":
            data = self.get("https://lyrics.paxsenix.org/spotify/search", {"q": artist + " " + title}, deadline)
            rows = data.get("tracks", []) if isinstance(data, dict) else []
            if isinstance(rows, dict):
                rows = rows.get("items", [])
            ranked = [(match_quality(query, metadata(r)), r) for r in rows[:15]]
            ranked = sorted((p for p in ranked if p[0] is not None), key=lambda p: p[0], reverse=True)
            for _, row in ranked[:1]:
                data = self.get("https://lyrics.paxsenix.org/spotify/lyrics", {"id": row["id"], "v": 1}, deadline)
                if isinstance(data, dict):
                    lyrics = data.get("lyrics", data)
                    if isinstance(lyrics, dict):
                        add(metadata(row), structured_lines(lyrics.get("lines"), "startTimeMs", "words", timed=lyrics.get("syncType") == "LINE_SYNCED"), "Lyrically / Spotify")
        return out


class SearchEngine:
    """Bounded provider pool, per-track deadline, no duplicate provider requests."""
    def __init__(self):
        self.client = ProviderClient()
        self.pool = concurrent.futures.ThreadPoolExecutor(max_workers=4, thread_name_prefix="AyuLyricsHTTP")
        self.stopped = threading.Event()

    def close(self):
        self.stopped.set()
        self.pool.shutdown(wait=False, cancel_futures=True)

    def _rank_results(self, query, config, candidates):
        candidates = [clean for c in candidates if (clean := sanitize_candidate(c, query)) is not None]
        # Validate metadata-less providers against an independent transcription,
        # exactly as OnlineLyricsMatching does in Resonance.
        references = ["\n".join(t for _, t in c["lines"]) for c in candidates
                      if c.get("auto_eligible") and not c.get("instrumental") and not c.get("requires_text_validation")]
        if config.get("reference_text"):
            references.append(config["reference_text"])
        for c in candidates:
            if not c.get("requires_text_validation"):
                continue
            meta = c.get("metadata", {})
            if meta and (similarity(meta.get("title"), query["title"]) < .9
                         or artist_similarity(meta.get("artist"), query["artist"]) < .8):
                continue
            extent = max([s for s, _ in c["lines"] if s is not None] +
                         [w[1] for r in c.get("word_lines", []) for w in r["words"]] + [0])
            plain = "\n".join(t for _, t in c["lines"])
            agreement = any(text_agreement(plain, ref) >= (.8 if c.get("upstream_restricted") else .5) for ref in references)
            timing_ok = (not c.get("synced") and c.get("upstream_restricted")) or (query["duration"] > 0 and
                min(30000, query["duration"] * 500) <= extent <= query["duration"] * 1000 + 3000)
            c["auto_eligible"] = bool(timing_ok and agreement)
            if c.get("upstream_restricted"):
                c["upstream_confirmed"] = c["auto_eligible"]
        mark_timing_preferences(candidates, config)
        # Stable order and no self-referencing all_candidates object.
        unique = {}
        for c in candidates:
            signature = (c["provider"], c["credit"], to_lrc(c), json.dumps(c.get("word_lines", []), sort_keys=True))
            unique.setdefault(signature, c)
        candidates = list(unique.values())
        order = {name: i for i, name in enumerate(config["sources"])}
        candidates = sorted(candidates, key=lambda c: (rank_candidate(c, config), -order.get(c["provider"], 99)), reverse=True)
        best = next((c for c in candidates if c.get("auto_eligible")), None)
        result = dict(best, all_candidates=candidates) if best else ({"_no_auto": True, "all_candidates": candidates} if candidates else None)
        return result

    def search(self, query, config):
        query = dict(query)
        for original, alias in ([] if query.get("_manual") else parse_artist_aliases(config.get("artist_aliases", []))):
            if strip_extras(original) == strip_extras(query["artist"]):
                query["artist"] = alias
                break
        deadline = time.monotonic() + config.get("timeout", 12)
        pending, candidates, report = {}, [], []
        updates = queue.Queue()
        # Workers may outlive this call until their own deadline: give them nothing
        # that reaches the UI state (progress callback, embedded reference text).
        worker_config = {k: v for k, v in config.items() if k not in ("_progress", "reference_text")}
        worker_config["_provider_progress"] = updates.put
        for provider in config["sources"]:
            if self.stopped.is_set():
                break
            future = self.pool.submit(self.client.fetch, provider, query, worker_config, deadline)
            pending[future] = provider
        try:
            while pending and not self.stopped.is_set():
                left = deadline - time.monotonic()
                if left <= 0:
                    break
                done, _ = concurrent.futures.wait(pending, timeout=min(left, 0.2), return_when=concurrent.futures.FIRST_COMPLETED)
                for future in done:
                    provider = pending.pop(future)
                    try:
                        found = future.result()
                        candidates.extend(found)
                        report.append((provider, "OK" if found else "нет совпадения"))
                    except Exception as error:
                        # Do not include exception URLs: they may contain private server details.
                        detail = str(error) if isinstance(error, HttpFailure) else type(error).__name__
                        report.append((provider, detail[:100]))
                changed = bool(done)
                while True:
                    try:
                        candidates.append(updates.get_nowait())
                        changed = True
                    except queue.Empty:
                        break
                progress = config.get("_progress")
                if changed and callable(progress):
                    snapshot = self._rank_results(query, config, candidates)
                    if snapshot:
                        try:
                            progress(snapshot, list(report))
                        except Exception:
                            pass  # The final callback remains authoritative.
            for future, provider in pending.items():
                future.cancel()
                report.append((provider, "таймаут"))
            result = self._rank_results(query, config, candidates)
            best = result is not None and not result.get("_no_auto")
            error = any(s not in ("OK", "нет совпадения") for _, s in report)
            return result, 0 if best else 2 if error else 1, report
        finally:
            for future in pending:
                future.cancel()


class RepositoryHook(MethodHook):
    def __init__(self, plugin, kind):
        self.plugin, self.kind = plugin, kind

    def before_hooked_method(self, param):
        plugin = self.plugin
        if not plugin._active:
            return
        try:
            if not plugin.get_setting("enabled", True):
                return
            query = param.args[0]
            if query is None:
                return
            config = plugin._config()
            key = plugin._key(query, config)
            cached = plugin._cached(key)
            if self.kind == "getCached":
                param.setResult(cached)
            elif self.kind == "isKnownMissing":
                # Keep the native Retry button usable, even after a transient miss.
                param.setResult(plugin._Boolean.FALSE)
            elif self.kind == "loadCached":
                callback = param.args[1]
                if cached is not None:
                    plugin._deliver(callback, cached, 0)
                else:
                    q = {"title": str(query.title() or ""), "artist": str(query.artist() or ""),
                         "album": str(query.album() or ""), "duration": max(0, int(query.duration()))}
                    plugin._start(key, q, config, callback)
                param.setResult(None)
            elif self.kind == "fetch":
                callback = param.args[1]
                if cached is not None:
                    plugin._deliver(callback, cached, 0)
                else:
                    q = {"title": str(query.title() or ""), "artist": str(query.artist() or ""),
                         "album": str(query.album() or ""), "duration": max(0, int(query.duration()))}
                    plugin._start(key, q, config, callback)
                param.setResult(None)
        except Exception as error:
            # Before successful interception, let the original implementation run.
            plugin._log("Repository hook: " + type(error).__name__)


class PlayerLoadHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        p = self.plugin
        if not p._active or not p.get_setting("enabled", True):
            return
        try:
            if p._load_sheet(param.thisObject, bool(param.args[0])):
                param.setResult(None)
        except Exception as error:
            p._log("Player load: " + type(error).__name__ + ": " + str(error) + "\n" + traceback.format_exc(limit=6))
            # A partially created state cannot receive stale callbacks afterwards.
            state = p._states.pop(p._sheet_id(param.thisObject), None)
            if state:
                p._dispose_state(state)


class PlayerDismissHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        state = self.plugin._states.pop(self.plugin._sheet_id(param.thisObject), None)
        if state:
            self.plugin._dispose_state(state)
        else:
            try:
                self.plugin._release_renderer(self.plugin._field(param.thisObject, "lyricsView"))
            except Exception:
                pass


class PlayerTouchHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        try:
            if int(param.args[0].getActionMasked()) == 0:
                state = self.plugin._states.get(self.plugin._sheet_id(param.thisObject))
                if state and int(self.plugin._field(param.thisObject, "mode")) == 1:
                    self.plugin._show_button(state)
        except Exception as error:
            self.plugin._log("Button touch: " + type(error).__name__)


class PlayerColorHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        state = self.plugin._entry_for_view(param.thisObject)
        if state and state.get("button") is not None:
            self.plugin._tint_button(state)


class PluginArtworkHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        try:
            if str(param.args[0].getId()) == __id__:
                param.args[0].setDescription(_t(_DESCRIPTION))
        except Exception:
            pass

    def after_hooked_method(self, param):
        try:
            if str(param.args[0].getId()) != __id__:
                return
            image = self.plugin._plugin_image_field.get(param.thisObject)
            drawable = self.plugin._artwork_method.invoke(None, image.getContext().getResources())
            image.setVisibility(0)
            image.setImageDrawable(drawable)
        except Exception as error:
            self.plugin._log("Plugin icon: " + type(error).__name__)


class CreditHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            lyrics_view = param.thisObject
            view = self.plugin._credit_field.get(lyrics_view)
            if view is not None:
                orig_credit = str(param.args[1] or "")
                self.plugin._setup_credit_view(lyrics_view, view, orig_credit)
        except Exception as error:
            self.plugin._log("Credit hook: " + type(error).__name__)


class WordBindHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            if self.plugin._active:
                self.plugin._word_methods["bind"].invoke(None, param.thisObject, param.args[0])
                state = self.plugin._entry_for_view(param.thisObject)
                if state:
                    self.plugin._configure_effects(state)
                else:
                    self.plugin._configure_native_effects(param.thisObject)
        except Exception as error:
            self.plugin._log("Word bind: " + type(error).__name__)


class QuickSettingsFillHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        if not self.plugin._active:
            return
        try:
            self.plugin._fill_quick_settings(param.thisObject, param.args[0])
        except Exception as error:
            self.plugin._log(_t("Быстрые настройки: ") + type(error).__name__ + ": " + str(error))


class QuickSettingsClickHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        if not self.plugin._active:
            return
        try:
            if self.plugin._quick_toggle(param.thisObject, param.args[0], param.args[1]):
                param.setResult(None)
        except Exception as error:
            self.plugin._log(_t("Переключатель плеера: ") + type(error).__name__ + ": " + str(error))


class AyuLyricsSourcesPlugin(BasePlugin):
    def _log(self, text):
        errors = getattr(self, "_errors", [])
        self._errors = (errors + [time.strftime("%H:%M:%S") + " " + text[:300]])[-20:]
        try:
            self.log("AyuLyricsSources: " + text)
        except Exception:
            pass

    def _config(self):
        config = {
            "sources": tuple(key for key, _, default in PROVIDERS if self.get_setting("source_" + key, default)),
            "sync": bool(self.get_setting("sync", True)),
            "words": bool(self.get_setting("words", True)),
            "pref_source": int(self.get_setting("pref_source", 0) or 0),
            "pref_mode": int(self.get_setting("pref_mode", 0) or 0),
            "apple_first": bool(self.get_setting("apple_first", True)),
            "embedded_first": bool(self.get_setting("embedded_first", False)),
            "artist_aliases": parse_artist_aliases(self.get_setting("artist_aliases", "")),
            "timeout": 12,
        }
        for key in ("better_key", "lrcshare_key", "lrcred_client", "lyricsplus_url"):
            config[key] = str(self.get_setting(key, "") or "").strip()
        # Header injection is rejected before any request is made.
        if any("\r" in config[k] or "\n" in config[k] for k in ("better_key", "lrcshare_key", "lrcred_client")):
            raise ValueError("invalid header")
        return config

    def _key(self, query, config):
        data = query if isinstance(query, dict) else self._query_dict(query)
        values = [data["title"], data["artist"], data["album"], data["duration"], config]
        if data.get("_manual"):
            values.append("manual-query")
        return hashlib.sha256(json.dumps(values, sort_keys=True, ensure_ascii=False).encode()).hexdigest()

    def _cached(self, key):
        with self._lock:
            entry = self._cache.get(key)
            if entry is None:
                return None
            exp = entry["expires"] if isinstance(entry, dict) else entry[0]
            if exp < time.monotonic():
                del self._cache[key]
                return None
            self._cache.move_to_end(key)
            return entry["lyrics"] if isinstance(entry, dict) else entry[1]

    def _store_cache(self, key, entry):
        # Caller holds self._lock. Expired entries still pin Java Lyrics and every candidate.
        now = time.monotonic()
        for stale in [k for k, v in self._cache.items()
                      if (v["expires"] if isinstance(v, dict) else v[0]) < now]:
            del self._cache[stale]
        self._cache[key] = entry
        self._cache.move_to_end(key)
        while len(self._cache) > 24:
            self._cache.popitem(last=False)

    def _deliver(self, callback, lyrics, status):
        def deliver():
            try:
                callback.onResult(lyrics, status)
            except Exception as error:
                self._log("Callback: " + type(error).__name__)
        run_on_ui_thread(deliver)

    def _to_java(self, result, sync):
        if not result or result.get("_no_auto"):
            return None
        if result["instrumental"]:
            return self._Lyrics.instrumental(1, _t(result["credit"]))
        lyrics = self._Lyrics.parse(to_lrc(result, sync), 1, _t(result["credit"]))
        if lyrics is not None and sync and self.get_setting("words", True) and result.get("word_lines"):
            if "register" in getattr(self, "_word_methods", {}):
                try:
                    self._word_methods["register"].invoke(None, lyrics, json.dumps([dict(row, exact_intervals=apple_word_source(result)) for row in result["word_lines"]], ensure_ascii=False))
                except Exception as err:
                    self._log("Word register failed: " + type(err).__name__)
        return lyrics

    def _start(self, key, query, config, callback):
        with self._lock:
            if key in self._pending:
                if len(self._pending[key]["callbacks"]) < 8:
                    self._pending[key]["callbacks"].append(callback)
                else:
                    self._deliver(callback, None, 2)
                return
            if len(self._pending) >= 4:
                self._deliver(callback, None, 2)
                return
            ticket = {"callbacks": [callback], "generation": self._generation, "started": time.monotonic(),
                      "deadline": time.monotonic() + config.get("timeout", 12)}
            self._pending[key] = ticket
        self._record_report(query, _t("Поиск выполняется: ") + ", ".join(config["sources"]), state="searching")
        try:
            self._jobs.submit(self._search, key, query, config, ticket)
        except Exception:
            with self._lock:
                self._pending.pop(key, None)
            raise

    def _timing_text(self, entry):
        first, total = entry.get("first_ms"), entry.get("total_ms")
        text = _t("\nПервый подтверждённый ответ: %.2f с") % (first / 1000) if first is not None else ""
        if total is not None:
            text += _t("; полный поиск: %.2f с") % (total / 1000)
        return text

    def _publish_progress(self, key, query, config, ticket, result, reports):
        def publish():
            with self._lock:
                if not self._active or self._pending.get(key) is not ticket or ticket["generation"] != self._generation:
                    return
                callbacks = list(ticket["callbacks"])
            try:
                selected = result if not result.get("_no_auto") else None
                old = self._cache.get(key)
                same = selected is not None and isinstance(old, dict) and old.get("result") and self._fingerprint(selected) == self._fingerprint(old["result"])
                lyrics = old.get("lyrics") if same else self._to_java(selected, config["sync"])
                if selected and lyrics is not None and ticket.get("first_ms") is None:
                    ticket["first_ms"] = round((time.monotonic() - ticket.get("started", time.monotonic())) * 1000)
                entry = {"key": key, "query": query, "lyrics": lyrics, "result": selected,
                         "candidates": list(result.get("all_candidates") or []), "chosen": 0 if selected else -1,
                         "status": 0 if lyrics else 1, "reports": reports, "partial": True,
                         "first_ms": ticket.get("first_ms"), "expires": time.monotonic() + 30}
                with self._lock:
                    if self._pending.get(key) is not ticket or ticket["generation"] != self._generation:
                        return
                    self._store_cache(key, entry)
                for callback in callbacks:
                    progress = getattr(callback, "onProgress", None)
                    if callable(progress):
                        progress(entry)
            except Exception as error:
                self._log("Search preview: " + type(error).__name__)
        run_on_ui_thread(publish)

    def _search(self, key, query, config, ticket):
        result, status, report = None, 2, []
        try:
            if self._active and ticket["generation"] == self._generation:
                remaining = ticket.get("deadline", time.monotonic() + 12) - time.monotonic()
                if remaining > 0:
                    progress = lambda result, reports: self._publish_progress(key, query, config, ticket, result, reports)
                    result, status, report = self._engine.search(query, dict(config, timeout=remaining, _progress=progress))
                else:
                    report = [("plugin", _t("истёк срок ожидания в очереди"))]
        except Exception as error:
            report = [("plugin", type(error).__name__)]

        def finish():
            lyrics, current_status = None, status
            with self._lock:
                if self._pending.get(key) is not ticket:
                    return
                self._pending.pop(key)
                valid = self._active and ticket["generation"] == self._generation
                callbacks = ticket["callbacks"]
            if valid:
                try:
                    all_candidates = list(result.get("all_candidates") or []) if result else []
                    if result and not all_candidates and not result.get("_no_auto"):
                        all_candidates = [{k: v for k, v in result.items() if k != "all_candidates"}]
                    selected = result if result and not result.get("_no_auto") else None
                    lyrics = self._to_java(selected, config["sync"])
                    if selected is not None and lyrics is None:
                        current_status = 2
                    entry = {"key": key, "query": query, "lyrics": lyrics, "result": selected,
                             "candidates": all_candidates, "chosen": 0 if selected else -1,
                             "status": current_status,
                             "reports": report,
                             "first_ms": ticket.get("first_ms"),
                             "total_ms": round((time.monotonic() - ticket.get("started", time.monotonic())) * 1000),
                             "expires": time.monotonic() + (3600 if lyrics else 20)}
                    with self._lock:
                        self._store_cache(key, entry)
                    if selected and lyrics is not None:
                        self._save_offline(query, selected)
                    if selected:
                        message = _t("Найден: ") + self._format_variant(selected)
                        if config["sync"] and config["words"] and selected.get("word_lines") and not self._word_methods:
                            message += _t("\nМодуль караоке недоступен: отображаются таймкоды строк")
                    elif all_candidates:
                        message = _t("Найдено %d вариантов для ручной проверки. Запись не подтверждена.") % len(all_candidates)
                    else:
                        message = (_t("Все онлайн-источники выключены") if not config["sources"] else
                                   _t("Текст не найден") if current_status != 2 else _t("Поиск завершён с ошибками"))
                    self._record_report(query, message + self._timing_text(entry), report)
                except Exception as error:
                    current_status = 2
                    self._record_report(query, _t("Ошибка обработки: ") + type(error).__name__, report)
                    self._log("Result conversion: " + type(error).__name__)
            else:
                current_status = 2
            for callback in callbacks:
                try:
                    callback.onResult(lyrics, current_status)
                except Exception as error:
                    self._log("Callback: " + type(error).__name__)
        run_on_ui_thread(finish)


    def _track_key(self, query):
        values = [query[k] for k in ("title", "artist", "album", "duration")]
        if query.get("_manual"):
            values.append("manual-query")
        raw = json.dumps(values, ensure_ascii=False)
        return hashlib.sha256(raw.encode()).hexdigest()

    def _persist(self, key, value):
        try:
            self.set_setting(key, json.dumps(value, ensure_ascii=False), reload_settings=False)
        except Exception as error:
            self._log(_t("Сохранение ") + key + ": " + type(error).__name__)

    def _read_saved(self, key, default):
        try:
            value = json.loads(self.get_setting(key, "") or "null")
            return value if isinstance(value, type(default)) else default
        except (ValueError, TypeError):
            return default

    def _record_report(self, query, message, reports=(), state="complete"):
        record = {"time": time.strftime("%d.%m.%Y %H:%M:%S"), "title": query.get("title", "")[:180],
                  "artist": query.get("artist", "")[:180], "state": state, "message": message[:3000],
                  "providers": list(reports)}
        with self._lock:
            history = getattr(self, "_history", [])
            # Keep the start while pending; completion replaces its own search row.
            search_id = self._track_key(query)
            history = [r for r in history if not (r.get("id") == search_id and r.get("state") == "searching")]
            if state == "complete" and history and history[0].get("id") == search_id and history[0].get("state") == "complete":
                history = history[1:]
            record["id"] = search_id
            self._history = ([record] + history)[:20]
            self._last_report = self._format_report(record)
            saved = list(self._history)
        self._persist("history_v2", saved)

    def _format_report(self, record):
        return (record.get("time", "") + "\n" + record.get("artist", "") + " — " + record.get("title", "") +
                "\n" + record.get("message", "") + "\n" + "\n".join(str(p) + ": " + _t(str(s)) for p, s in record.get("providers", [])))

    def _fingerprint(self, item):
        raw = [item.get("provider"), item.get("credit"), item.get("lines"), item.get("word_lines", [])]
        return hashlib.sha256(json.dumps(raw, sort_keys=True, ensure_ascii=False).encode()).hexdigest()

    def _remember_choice(self, entry, item):
        saved = {k: v for k, v in item.items() if k not in ("all_candidates", "java_lyrics")}
        key = entry.get("track_id") or self._track_key(entry["query"])
        self._choices.pop(key, None)
        self._choices[key] = saved
        while len(self._choices) > 24 or len(json.dumps(self._choices, ensure_ascii=False).encode()) > 512 * 1024:
            self._choices.pop(next(iter(self._choices)))
        self._persist("choices_v2", self._choices)

    def _save_offline(self, query, item):
        if not hasattr(self, "_offline"):
            self._offline = {}
        saved = {k: v for k, v in item.items() if k not in ("all_candidates", "java_lyrics")}
        key = self._track_key(query)
        self._offline.pop(key, None)
        self._offline[key] = saved
        while len(self._offline) > 12 or len(json.dumps(self._offline, ensure_ascii=False).encode()) > 512 * 1024:
            self._offline.pop(next(iter(self._offline)))
        self._persist("offline_v2", self._offline)

    def _clear_cache(self, *_):
        self._offline = {}
        self._persist("offline_v2", {})
        self._invalidate()

    def _reflect_field(self, obj, name):
        cls = obj.getClass()
        while cls is not None:
            try:
                field = cls.getDeclaredField(name)
                field.setAccessible(True)
                return field
            except Exception:
                cls = cls.getSuperclass()
        raise AttributeError(name)

    def _field(self, obj, name):
        return self._reflect_field(obj, name).get(obj)

    def _sheet_id(self, sheet):
        return int(self._System.identityHashCode(sheet))

    def _current_message(self):
        return self._MediaController.getInstance().getPlayingMessageObject()

    def _message_key(self, message):
        try:
            document = message.getDocument()
            document_id = int(document.id) if document is not None else 0
        except Exception:
            document_id = 0
        return "%s:%s:%s:%s" % (message.currentAccount, message.getDialogId(), message.getId(), document_id)

    def _query_dict(self, query):
        return {"title": str(query.title() or ""), "artist": str(query.artist() or ""),
                "album": str(query.album() or ""), "duration": max(0, int(query.duration()))}

    def _effective_query(self, original, track_id):
        query = dict(original)
        saved = getattr(self, "_search_queries", {}).get(track_id)
        if isinstance(saved, dict):
            query.update(title=saved["title"], artist=saved["artist"], album="", _manual=True)
        return query

    def _read_search_queries(self):
        stored = self._read_saved("search_queries_v1", {})
        clean = OrderedDict()
        for key, value in list(stored.items())[-24:]:
            if not isinstance(key, str) or len(key) > 160 or not isinstance(value, dict):
                continue
            title, artist = value.get("title"), value.get("artist")
            if not isinstance(title, str) or not isinstance(artist, str) or not title.strip() or max(len(title), len(artist)) > 200:
                continue
            clean[key] = {"title": " ".join(title.split()), "artist": " ".join(artist.split())}
        return clean

    def _commit_track_search(self, view, track_id, title=None, artist="", reset=False):
        entry = self._entry_for_view(view)
        if entry is None or entry["track_id"] != track_id:
            raise ValueError(_t("Трек уже сменился. Откройте поиск заново."))
        if not reset:
            if not isinstance(title, str) or not isinstance(artist, str):
                raise ValueError(_t("Укажите название трека"))
            title, artist = " ".join(title.split()), " ".join(artist.split())
            if not title or max(len(title), len(artist)) > 200:
                raise ValueError(_t("Укажите название трека"))
        saved = OrderedDict(getattr(self, "_search_queries", {}))
        saved.pop(track_id, None)
        if not reset:
            saved[track_id] = {"title": title, "artist": artist}
        while len(saved) > 24:
            saved.popitem(last=False)
        self._search_queries = saved
        self._persist("search_queries_v1", saved)
        # Supersede every callback from the old query before changing its identity.
        entry["search_token"] += 1
        entry["query"] = self._effective_query(entry.get("original_query", entry["query"]), track_id)
        entry.pop("latest_query", None)
        entry.pop("preferences_dirty", None)
        entry.update(result=None, lyrics=None, candidates=[], chosen=-1, manual=False, searching=False)
        entry["key"] = self._key(entry["query"], self._config())
        entry["opened_at"] = time.monotonic()
        entry.pop("first_display_ms", None)
        self._choices.pop(track_id, None)
        self._persist("choices_v2", self._choices)
        self._release_renderer(view)
        self._show_state_method.invoke(entry["sheet"], self._Integer(2))
        self._search_state(entry, self._config())
        return entry

    def _state_current(self, state):
        if not self._active or state.get("generation") != self._generation:
            return False
        if self._states.get(state["sheet_id"]) is not state:
            return False
        try:
            message = self._current_message()
            return message is not None and self._message_key(message) == state["track_id"]
        except Exception:
            return False

    def _entry_for_view(self, view):
        # Java bridge wrappers need Java equality, not Python `is`.
        for state in reversed(list(getattr(self, "_states", {}).values())):
            if state.get("view") == view and self._state_current(state):
                return state
        return None

    def _embedded_candidate(self, lyrics, query):
        if lyrics is None:
            return None
        rows = lyrics.lines
        lines = []
        # Chaquopy does not make java.util.ArrayList a Python iterable.
        for index in range(int(rows.size())):
            line = rows.get(index)
            lines.append((int(line.time) if lyrics.synced else None, str(line.text or "")))
        item = candidate("embedded", query, query, lines, "Из аудиофайла", instrumental=bool(lyrics.instrumental))
        if item:
            item["auto_eligible"] = True
        return item

    def _weak_variants_click(self, view):
        reference = self._WeakReference(view)
        def click(_):
            current = reference.get()
            if current is not None:
                entry = self._entry_for_view(current)
                if entry is not None:
                    self._open_variants_dialog(current, entry)
        return OnClickListener(click)

    def _make_button(self, state):
        view = state["view"]
        background = self._ExpressiveDrawable(24.0).setAlwaysShowContainer(True)
        button = self._create_icon_method.invoke(state["sheet"], view.getContext(), self._Integer(self._text_icon), background)
        state["button_background"] = background
        button.setContentDescription(_t("Доступные тексты и синхронизация"))
        button.setTag("ayu_lyrics_sources_button")
        button.setOnClickListener(self._weak_variants_click(view))
        params = self._FrameParams(self._dp(48), self._dp(48), 53)
        params.topMargin, params.rightMargin = self._dp(8), self._dp(20)
        view.addView(button, params)
        state["button"] = button
        scroll = self._field(view, "scrollView")
        state["scroll"] = scroll
        state["scroll_margin"] = int(scroll.getLayoutParams().topMargin)
        scroll_params = scroll.getLayoutParams()
        scroll_params.topMargin = state["scroll_margin"] + self._dp(56)
        scroll.setLayoutParams(scroll_params)
        self._update_button(state)
        self._show_button(state)

    def _update_button(self, state):
        button = state.get("button")
        if button is None:
            return
        count = len(state.get("candidates", []))
        label = _t("Поиск текстов") if state.get("searching") else _t("Доступные тексты: %d") % count
        button.setContentDescription(label)
        self._tint_button(state)
        if getattr(self, "_source_sheet_update", None) is not None:
            self._update_variant_sheets(state)

    def _show_button(self, state):
        button = state.get("button")
        if button is None or not self._state_current(state):
            return
        state["button_token"] = state.get("button_token", 0) + 1
        token = state["button_token"]
        button.animate().cancel()
        button.setVisibility(0)
        button.setClickable(True)
        button.animate().alpha(1.0).scaleX(1.0).scaleY(1.0).setDuration(140).start()
        try:
            manager = button.getContext().getSystemService("accessibility")
            if manager is not None and manager.isTouchExplorationEnabled():
                return
        except Exception:
            pass

        sheet_id = state["sheet_id"]
        opened_at = state.get("opened_at")
        def hide():
            current = self._states.get(sheet_id)
            if not current or not self._state_current(current) or current.get("opened_at") != opened_at or current.get("button_token") != token:
                return
            target = current.get("button")
            if target is None:
                return
            target.setClickable(False)
            target.animate().alpha(0.0).scaleX(.9).scaleY(.9).setDuration(180).start()

            def hidden():
                active = self._states.get(sheet_id)
                if active and self._state_current(active) and active.get("opened_at") == opened_at and active.get("button_token") == token and active.get("button") is not None:
                    active["button"].setVisibility(4)
            run_on_ui_thread(hidden, 200)
        run_on_ui_thread(hide, 3500)

    def _tint_button(self, state):
        try:
            colors = self._field(state["sheet"], "colors")
            background = state["button_background"]
            self._tint_icon_method.invoke(None, state["button"], background, self._Integer(int(colors.icon)))
            background.setColors(int(colors.icon), int(colors.surfaceContainer))
            if self._word_methods.get("accent"):
                self._word_methods["accent"].invoke(None, state["view"], self._Integer(int(colors.accent)))
        except Exception as error:
            self._log(_t("Цвет кнопки: ") + type(error).__name__)

    def _release_renderer(self, view):
        for name in ("detach", "release"):
            method = getattr(self, "_word_methods", {}).get(name)
            if method is not None:
                try:
                    method.invoke(None, view)
                except Exception as error:
                    self._log("Renderer release: " + type(error).__name__)

    def _dispose_state(self, state):
        self._close_variant_sheets(state["sheet_id"])
        state["button_token"] = state.get("button_token", 0) + 1
        self._release_renderer(state["view"])
        try:
            if state.get("button") is not None:
                state["button"].animate().cancel()
                state["button"].setOnClickListener(None)
                state["view"].removeView(state["button"])
            credit = self._credit_field.get(state["view"]) if getattr(self, "_credit_field", None) is not None else None
            if credit is not None:
                credit.setOnClickListener(None)
            if state.get("scroll") is not None:
                params = state["scroll"].getLayoutParams()
                params.topMargin = state["scroll_margin"]
                state["scroll"].setLayoutParams(params)
        except Exception as error:
            self._log(_t("Удаление кнопки: ") + type(error).__name__)

    def _prune_states(self):
        # A sheet closed without dismiss() (activity destroyed, etc.) must not keep
        # its dialog, views and candidates alive until four newer sheets push it out.
        for sheet_id, state in list(self._states.items()):
            try:
                sheet = state["sheet"]
                dead = bool(sheet.isDismissed())
                if not dead:
                    context = sheet.getContext()
                    # Dialogs can survive Activity recreation without dismiss().
                    for _ in range(8):
                        if hasattr(context, "isDestroyed"):
                            dead = bool(context.isDestroyed()) or bool(context.isFinishing())
                            break
                        if not hasattr(context, "getBaseContext"):
                            break
                        base = context.getBaseContext()
                        if base is None or base == context:
                            break
                        context = base
            except Exception:
                dead = True
            if dead:
                self._states.pop(sheet_id, None)
                try:
                    self._dispose_state(state)
                except Exception as error:
                    self._log(_t("Очистка плеера: ") + type(error).__name__)

    def _load_sheet(self, sheet, force=False):
        self._prune_states()
        message = self._current_message()
        if message is None:
            return False
        java_query = self._TrackQuery.forMessage(message)
        if java_query is None:
            return False
        original, config = self._query_dict(java_query), self._config()
        sheet_id, track_id = self._sheet_id(sheet), self._message_key(message)
        query = self._effective_query(original, track_id)
        old = self._states.get(sheet_id)
        if old and old["track_id"] == track_id and old["generation"] == self._generation:
            old["original_query"] = original
            # Native metadata and cover notifications call loadLyrics again.
            # They must never replace a selected or already accepted transcription.
            if not force:
                if old.get("searching"):
                    old["latest_query"] = query
                    return True
                accepted_online = old.get("result") and old["result"].get("provider") != "embedded"
                if old.get("manual") or accepted_online or old["query"] == query:
                    return True
            if force:
                self._refresh_lyrics(old["view"], old)
                return True
        view = self._field(sheet, "lyricsView")
        embedded = self._embedded_candidate(self._Repository.fromTags(message), query)
        state = {"sheet": sheet, "sheet_id": sheet_id, "track_id": track_id, "view": view,
                 "opened_at": time.monotonic(),
                 "generation": self._generation, "original_query": original, "query": query, "key": self._key(query, config),
                 "lyrics": None, "result": None, "candidates": [embedded] if embedded else [],
                 "chosen": -1, "searching": False, "search_token": 0, "manual": False}
        if old:
            self._dispose_state(old)
        self._states[sheet_id] = state
        while len(self._states) > 4:
            _, removed = self._states.popitem(last=False)
            self._dispose_state(removed)
        # Invalidate every outstanding native callback before taking ownership.
        field = self._reflect_field(sheet, "lyricsRequest")
        field.setInt(sheet, int(field.getInt(sheet)) + 1)
        try:
            self._make_button(state)
        except Exception as error:
            self._log(_t("Кнопка текстов: ") + type(error).__name__)
            self._dispose_state(state)
            for name in ("button", "scroll", "scroll_margin"):
                state.pop(name, None)
        saved = self._choices.get(track_id) or (None if query.get("_manual") else self._choices.get(self._track_key(query)))
        if saved:
            state["candidates"].insert(0, saved)
            self._apply_candidate(state, saved, manual=True, remember=False)
        elif embedded:
            self._apply_candidate(state, embedded)
        offline = getattr(self, "_offline", {}).get(self._track_key(query))
        if offline:
            self._merge_state(state, {"candidates": [offline]})
        cached = self._cache.get(state["key"])
        if isinstance(cached, dict) and cached.get("expires", 0) > time.monotonic():
            self._merge_state(state, cached)
            if state["lyrics"] is None:
                state["view"].setState(6, _t("Не удалось найти текст"), None, _t("Повторить"))
            self._record_report(query, _t("Из кэша плагина: ") + (state.get("result") or {}).get("credit", _t("нет автоматического выбора")), state="cache")
            if cached.get("partial"):
                self._search_state(state, config)
        else:
            if state["lyrics"] is None:
                self._show_state_method.invoke(sheet, self._Integer(2))
            self._search_state(state, config)
        return True

    def _apply_candidate(self, state, item, manual=False, remember=False):
        if not self._state_current(state):
            return False
        item = sanitize_candidate(item, state["query"])
        if item is None:
            return False
        lyrics = self._to_java(item, self._config()["sync"])
        if lyrics is None:
            return False
        state["lyrics"], state["result"] = lyrics, item
        if manual:
            state["manual"] = True
        state["chosen"] = next((i for i, c in enumerate(state["candidates"]) if self._fingerprint(c) == self._fingerprint(item)), -1)
        # showLyrics updates position and uses the native playback clock.
        self._show_method.invoke(state["sheet"], lyrics)
        if "first_display_ms" not in state:
            state["first_display_ms"] = max(0, round((time.monotonic() - state.get("opened_at", time.monotonic())) * 1000))
        if remember:
            self._remember_choice(state, item)
        self._update_button(state)
        return True

    def _merge_state(self, state, entry):
        by_fingerprint = {self._fingerprint(c): c for c in state["candidates"]}
        for item in entry.get("candidates", []):
            fingerprint = self._fingerprint(item)
            if fingerprint not in by_fingerprint or item.get("auto_eligible"):
                by_fingerprint[fingerprint] = item
        candidates = [clean for item in by_fingerprint.values() if (clean := sanitize_candidate(item, state["query"])) is not None]
        config = self._config()
        mark_timing_preferences(candidates, config)
        candidates.sort(key=lambda c: rank_candidate(c, config), reverse=True)
        state["candidates"] = candidates[:60]
        if not state.get("manual"):
            current = sanitize_candidate(state.get("result"), state["query"])
            if state.get("result") and (current is None or not current.get("auto_eligible")):
                self._release_renderer(state["view"])
                state.update(result=None, lyrics=None, chosen=-1)
                state["view"].setState(6, _t("Не удалось найти текст"), None, _t("Повторить"))
            best = next((c for c in candidates if c.get("auto_eligible")), None)
            if best and (state.get("result") is None or rank_candidate(best, config) > rank_candidate(state["result"], config)):
                self._apply_candidate(state, best)
        if state.get("result"):
            state["chosen"] = next((i for i, c in enumerate(state["candidates"]) if self._fingerprint(c) == self._fingerprint(state["result"])), -1)
        self._update_button(state)

    def _search_state(self, state, config):
        state["searching"] = True
        state["search_token"] += 1
        token = state["search_token"]
        self._update_button(state)
        reference = next((c for c in state["candidates"] if c.get("provider") == "embedded"), None)
        if reference:
            config = dict(config, reference_text="\n".join(t for _, t in reference["lines"]))
        plugin = self

        class ResultCallback:
            def onProgress(self, entry):
                if not plugin._state_current(state) or state["search_token"] != token:
                    return
                plugin._merge_state(state, entry)
                if state.get("result"):
                    shown = (_t("Ручной выбор сохранён: ") if state.get("manual") else _t("Показан: ")) + plugin._format_variant(state["result"])
                    shown += _t("\nОстальные источники продолжают поиск") + plugin._timing_text(entry)
                    plugin._record_report(state["query"], shown, entry.get("reports", []), state="searching")

            def onResult(self, lyrics, status):
                if not plugin._state_current(state) or state["search_token"] != token:
                    return
                state["searching"] = False
                entry = plugin._cache.get(state["key"])
                if isinstance(entry, dict):
                    plugin._merge_state(state, entry)
                    if state.get("result"):
                        shown = (_t("Сохранён ручной выбор: ") if state.get("manual") else _t("Показан: ")) + plugin._format_variant(state["result"])
                        shown += _t("\nДоступно вариантов: %d") % len(state["candidates"])
                        plugin._record_report(state["query"], shown + plugin._timing_text(entry), entry.get("reports", []))
                if state.pop("preferences_dirty", False):
                    plugin._matching_changed()
                if state["lyrics"] is None:
                    state["view"].setState(6, _t("Не удалось найти текст"), None, _t("Повторить"))
                plugin._update_button(state)
                if state.get("latest_query") and state["latest_query"] != state["query"] and not state.get("manual"):
                    if state.get("result") is None or state["result"].get("provider") == "embedded":
                        plugin._load_sheet(state["sheet"])

        self._start(state["key"], state["query"], config, ResultCallback())

    def _setup_credit_view(self, lyrics_view, view, orig_credit):
        if not self._active or not self.get_setting("enabled", True):
            return
        entry = self._entry_for_view(lyrics_view)
        if entry is None:
            return
        view.setText(_t(orig_credit))
        view.setContentDescription(_t("Источник текста. Нажмите, чтобы выбрать версию"))
        view.setOnClickListener(self._weak_variants_click(lyrics_view))
        if "https://lrc.red" in orig_credit or "https://lrcshare.com" in orig_credit:
            self._Linkify.addLinks(view, 1)
            view.setMovementMethod(self._LinkMovementMethod.getInstance())

    def _format_variant(self, item):
        count = sum(bool(text.strip()) for _, text in item.get("lines", []))
        words = len(item.get("word_lines", []))
        mode = _t("инструментал") if item.get("instrumental") else (_t("слова: %d/%d строк") % (words, count) if words else _t("построчно") if item.get("synced") else _t("без синхронизации"))
        meta = item.get("metadata", {})
        total_words = sum(len(norm(text).split()) for _, text in item.get("lines", []))
        detail = _t("%s · %d строк · %d слов") % (mode, count, total_words)
        if meta.get("duration"):
            seconds = int(meta["duration"])
            detail += " · %d:%02d" % (seconds // 60, seconds % 60)
        if not item.get("auto_eligible"):
            detail += _t(" · запись не подтверждена")
        if meta.get("album"):
            detail += _t("\nАльбом: ") + str(meta["album"])[:160]
        return _t(item.get("credit") or item["provider"]) + "\n" + detail

    def _variant_label(self, item):
        mode = _t("Слова") if item.get("word_lines") else _t("Строки") if item.get("synced") else _t("Текст")
        if item.get("instrumental"):
            mode = _t("Инструментал")
        return mode + " · " + _t(item.get("credit") or item["provider"]) + (_t(" · проверить") if not item.get("auto_eligible") else "")

    def _selection_summary(self, entry):
        config = self._config()
        sources = ("Авто", "LRC Mux", "LRCLIB", "AMLL TTML", "Karalyr", "Better Lyrics", "LiriQo", "lrc.red", "LrcShare", "Spotify", "LyricsPlus")
        priorities = ("Авто", "Построчный", "Метаданные", "Полнота")
        source = max(0, min(len(sources)-1, config["pref_source"]))
        priority = max(0, min(len(priorities)-1, config["pref_mode"]))
        priority_label = _t(priorities[priority])
        if not source and not priority:
            priority_label = _t("Apple Music → полнота") if config.get("apple_first", True) else _t("Полнота")
        mode = _t("Выбрано вручную") if entry.get("manual") else _t("Автовыбор")
        result = mode + " · " + (_t("Источник: %s") % _t(sources[source])) + "\n" + (_t("Приоритет: %s") % priority_label)
        if config.get("embedded_first"):
            result += " · " + _t("Сначала текст файла")
        return result

    def _variant_payload(self, entry):
        selected = self._fingerprint(entry["result"]) if entry.get("result") else None
        items = []
        labels = {key: label for key, label, _ in PROVIDERS}
        for item in entry.get("candidates", []):
            credit = _t(item.get("credit")) or labels.get(item["provider"], item["provider"])
            split = credit.split(" / ", 1)
            mode = (_t("Инструментал") if item.get("instrumental") else
                    _t("Начала слов") if onset_only(item) else _t("Пословный") if timing_rank(item) == 3 else _t("Частично пословный") if item.get("word_lines") else
                    _t("Построчный") if item.get("synced") else _t("Обычный текст"))
            words_by_time = {(r["time"], r["text"]): r for r in item.get("word_lines", [])}
            rows, used, limited = [], 0, False
            for index, (stamp, text) in enumerate(item.get("lines", [])[:80]):
                if used + len(text) > 16000:
                    break
                detail = []
                if (stamp, text) in words_by_time:
                    encoded = text.encode("utf-16-le")
                    for start, end, left, right in words_by_time[(stamp, text)]["words"][:256]:
                        detail.append("%.2f–%.2f  %s" % (start / 1000, end / 1000, encoded[left*2:right*2].decode("utf-16-le")))
                word_text = "\n".join(detail)
                available = max(0, 16000 - used - len(text))
                if len(word_text) > available:
                    word_text = word_text[:available]
                    limited = True
                used += len(text) + len(word_text)
                rows.append({"time": "%02d:%02d.%03d" % (stamp//60000, stamp//1000%60, stamp%1000) if stamp is not None else "", "text": text or "♪", "words": word_text})
            count = sum(bool(text.strip()) for _, text in item.get("lines", []))
            total_words = sum(len(norm(text).split()) for _, text in item.get("lines", []))
            remaining = len(item.get("lines", [])) - len(rows)
            note = (_t("Показаны первые %d строк. Выбирается полный текст.") % len(rows)) if remaining > 0 else ""
            if limited:
                note += ("\n" if note else "") + _t("Предпросмотр таймкодов сокращён. Выбирается полный текст.")
            items.append({"id": self._fingerprint(item), "source": split[-1],
                          "provider": split[0] if len(split) > 1 else (labels.get(item["provider"], "") if labels.get(item["provider"]) != credit else ""),
                          "mode": mode, "stats": _t("%d строк · %d слов") % (count, total_words),
                          "selected": self._fingerprint(item) == selected, "verified": bool(item.get("auto_eligible")),
                          "synced": bool(item.get("synced")), "preview": rows, "preview_note": note})
        colors = {}
        try:
            palette = self._field(entry["sheet"], "colors")
            colors = {name: int(getattr(palette, name)) for name in ("background", "surfaceContainer", "text", "textSecondary", "accent", "onAccent", "tonal", "onTonal", "divider")}
        except Exception:
            pass
        query = entry["query"]
        return json.dumps({"language": _language(), "track": query.get("title", "") + " · " + query.get("artist", ""),
                           "selection_summary": self._selection_summary(entry),
                           "manual": bool(entry.get("manual")), "searching": bool(entry.get("searching")),
                           "items": items, "colors": colors}, ensure_ascii=False)

    def _variant_action(self, view, action, track_id=None):
        entry = self._entry_for_view(view)
        if entry is None or (track_id is not None and entry["track_id"] != track_id):
            return
        if action.startswith("pick:"):
            item = next((c for c in entry["candidates"] if self._fingerprint(c) == action[5:]), None)
            if item is not None:
                self._select_item(entry, item)
        elif action == "search":
            self._show_track_search(entry)
        elif action == "retry":
            self._refresh_lyrics(view, entry)
        elif action == "auto":
            entry["manual"] = False
            self._choices.pop(entry["track_id"], None)
            self._choices.pop(self._track_key(entry["query"]), None)
            self._persist("choices_v2", self._choices)
            best = next((c for c in entry["candidates"] if c.get("auto_eligible")), None)
            if best:
                self._apply_candidate(entry, best)
            self._refresh_lyrics(view, entry)
        elif action == "diagnostics":
            self._show_report(None, entry["query"])

    def _update_variant_sheets(self, entry):
        live = []
        payload = None
        for owner, reference in getattr(self, "_variant_sheets", []):
            sheet = reference.get()
            if sheet is None or not sheet.isShowing():
                continue
            live.append((owner, reference))
            if owner == entry["sheet_id"]:
                if payload is None:
                    payload = self._variant_payload(entry)
                self._source_sheet_update.invoke(None, sheet, payload)
        self._variant_sheets = live

    def _close_variant_sheets(self, owner):
        keep = []
        for key, reference in getattr(self, "_variant_sheets", []):
            sheet = reference.get()
            if key == owner:
                if sheet is not None:
                    sheet.dismiss()
            elif sheet is not None and sheet.isShowing():
                keep.append((key, reference))
        self._variant_sheets = keep

    def _open_variants_dialog(self, lyrics_view, entry):
        if not self._state_current(entry):
            return
        native = getattr(self, "_source_sheet_show", None)
        if native is not None:
            try:
                self._close_variant_sheets(entry["sheet_id"])
                reference = self._WeakReference(lyrics_view)
                track_id = entry["track_id"]
                def action(button):
                    current = reference.get()
                    if current is not None:
                        self._variant_action(current, str(button.getTag()), track_id)
                dialog = native.invoke(None, lyrics_view.getContext(), self._field(entry["sheet"], "baseResourcesProvider"),
                                       self._variant_payload(entry), OnClickListener(action))
                self._variant_sheets.append((entry["sheet_id"], self._WeakReference(dialog)))
                return
            except Exception as error:
                self._log(_t("Меню текстов: ") + type(error).__name__ + ": " + str(error)[:200])
        if AlertDialogBuilder is None:
            return
        candidates = list(entry.get("candidates", []))
        chosen = self._fingerprint(entry["result"]) if entry.get("result") else None
        items = [("✓ " if self._fingerprint(c) == chosen else "") + self._variant_label(c) for c in candidates]
        items += [_t("Повторить поиск") + (_t(" · выполняется") if entry.get("searching") else ""), _t("Выбирать автоматически"), _t("Диагностика этого трека")]

        def clicked(builder, which):
            builder.dismiss()
            if not self._state_current(entry):
                return
            if 0 <= which < len(candidates):
                self._preview_variant(entry, candidates[which])
            elif which == len(candidates):
                self._refresh_lyrics(lyrics_view, entry)
            elif which == len(candidates) + 1:
                entry["manual"] = False
                self._choices.pop(entry["track_id"], None)
                self._choices.pop(self._track_key(entry["query"]), None)
                self._persist("choices_v2", self._choices)
                best = next((c for c in entry["candidates"] if c.get("auto_eligible")), None)
                if best:
                    self._apply_candidate(entry, best)
                self._refresh_lyrics(lyrics_view, entry)
            else:
                self._show_report(None, entry["query"])

        title = _t("Тексты · поиск…") if entry.get("searching") else _t("Доступные тексты")
        self._dialog(entry).set_title(title).set_items(items, clicked).set_negative_button(_t("Закрыть"), lambda *_: None).show()

    def _dialog(self, entry):
        return AlertDialogBuilder(entry["view"].getContext(), resources_provider=self._field(entry["sheet"], "baseResourcesProvider"))

    def _preview_variant(self, entry, item):
        if not self._state_current(entry):
            return
        rows = []
        words_by_time = {(r["time"], r["text"]): r for r in item.get("word_lines", [])}
        for stamp, text in item.get("lines", [])[:80]:
            prefix = ("%02d:%02d.%03d  " % (stamp // 60000, stamp // 1000 % 60, stamp % 1000)) if stamp is not None else ""
            rows.append(prefix + text)
            if (stamp, text) in words_by_time and len(rows) < 24:
                encoded = text.encode("utf-16-le")
                for start, end, left, right in words_by_time[(stamp, text)]["words"][:256]:
                    token = encoded[left * 2:right * 2].decode("utf-16-le")
                    rows.append("  %.2f–%.2f  %s" % (start / 1000, end / 1000, token))
        if len(item.get("lines", [])) > 80:
            rows.append(_t("… ещё %d строк") % (len(item["lines"]) - 80))
        message = self._format_variant(item) + "\n\n" + "\n".join(rows)
        self._dialog(entry).set_title(_t("Просмотр текста")).set_message(message[:16000]).set_positive_button(
            _t("Выбрать"), lambda *_: self._select_item(entry, item)).set_negative_button(
            _t("Назад"), lambda *_: self._open_variants_dialog(entry["view"], entry)).show()

    def _select_item(self, entry, item):
        if self._apply_candidate(entry, item, manual=True, remember=True):
            self._record_report(entry["query"], _t("Выбран вручную: ") + self._format_variant(item), state="manual")

    def _select_variant(self, lyrics_view, entry, which):
        candidates = entry.get("candidates", [])
        if 0 <= which < len(candidates):
            self._select_item(entry, candidates[which])

    def _refresh_lyrics(self, lyrics_view, entry):
        if not self._state_current(entry) or entry.get("searching"):
            return
        self._cache.pop(entry["key"], None)
        # Keep the current transcription and manual lock while searching.
        self._search_state(entry, self._config())


    def _invalidate(self, *_):
        if not hasattr(self, "_lock"):
            return
        with self._lock:
            self._generation += 1
            self._cache.clear()
            tickets = list(self._pending.values())
            self._pending.clear()
        states = list(getattr(self, "_states", {}).values())
        if hasattr(self, "_states"):
            self._states.clear()
        def clear_views():
            for state in states:
                self._dispose_state(state)
        run_on_ui_thread(clear_views)
        for ticket in tickets:
            for callback in ticket["callbacks"]:
                self._deliver(callback, None, 2)
        if getattr(self, "_word_methods", None):
            clear = self._word_methods["clear"]
            run_on_ui_thread(lambda: clear.invoke(None))

    def _matching_changed(self, *_):
        # Selection preferences reuse fetched variants; they must not tear down the player.
        def apply():
            config = self._config()
            for state in list(getattr(self, "_states", {}).values()):
                if not self._state_current(state):
                    continue
                self._merge_state(state, {"candidates": []})
                self._update_variant_sheets(state)
                if state.get("searching"):
                    state["preferences_dirty"] = True
                    continue
                java_query = self._TrackQuery.forMessage(self._current_message())
                if java_query is None:
                    continue
                key = self._key(state["query"], config)
                automatic = next((c for c in state["candidates"] if c.get("auto_eligible")), None)
                same = automatic and state.get("result") and self._fingerprint(automatic) == self._fingerprint(state["result"])
                lyrics = state["lyrics"] if same and not state.get("manual") else self._to_java(automatic, config["sync"])
                previous = self._cache.get(state["key"], {})
                cached = dict(previous, key=key, query=state["query"], candidates=list(state["candidates"]), result=automatic,
                              lyrics=lyrics, status=0 if lyrics is not None else 1, chosen=0 if automatic else -1,
                              expires=time.monotonic() + (3600 if lyrics is not None else 20))
                with self._lock:
                    self._store_cache(key, cached)
                state["key"] = key
                if automatic is not None:
                    self._save_offline(state["query"], automatic)
        run_on_ui_thread(apply)

    def _configure_effects(self, state):
        method = getattr(self, "_word_methods", {}).get("effects")
        if method is None:
            return
        mode = max(0, min(6, int(self.get_setting("effects_style", 0)))) if self.get_setting("effects_enabled", False) else -1
        strength = max(0, min(2, int(self.get_setting("effects_strength", 1))))
        rhythm, accent = None, -1
        try:
            rhythm = self._field(state["sheet"], "rhythmBackground")
        except Exception:
            pass  # Older builds still animate the fill using the playback clock.
        try:
            accent = int(self._field(state["sheet"], "colors").accent)
        except Exception:
            pass
        method.invoke(None, state["view"], rhythm, self._Integer(mode), self._Integer(strength), self._Integer(accent))
        transitions = self._word_methods.get("transitions")
        if transitions is not None:
            transitions.invoke(None, state["view"], self._Integer(max(0, min(3, int(self.get_setting("transition_mode", 2))))),
                               self._Integer(max(0, min(3, int(self.get_setting("transition_lead", 2))))))

    def _effects_changed(self, *_):
        def apply():
            for state in list(getattr(self, "_states", {}).values()):
                try:
                    self._configure_effects(state)
                except Exception as error:
                    self._log(_t("Эффекты текста: ") + type(error).__name__)
            self._configure_native_effects(rebind=True)
        run_on_ui_thread(apply)
        self._refresh_quick_settings()

    def _words_changed(self, *_):
        def apply():
            previous = [state for state in list(getattr(self, "_states", {}).values()) if self._state_current(state)]
            self._invalidate()
            for old in previous:
                item, config = old.get("result"), self._config()
                if item and (not config["words"] or item.get("word_lines")):
                    query = self._TrackQuery.forMessage(self._current_message())
                    lyrics = self._to_java(item, config["sync"])
                    if query is not None and lyrics is not None:
                        key = self._key(old["query"], config)
                        with self._lock:
                            self._store_cache(key, {"lyrics": lyrics, "result": item, "candidates": list(old["candidates"]),
                                                    "status": 0, "partial": bool(old.get("searching")),
                                                    "expires": time.monotonic() + 3600})
                if self._load_sheet(old["sheet"]):
                    state = self._states.get(old["sheet_id"])
                    if state and old.get("result"):
                        self._merge_state(state, {"candidates": old["candidates"]})
                        self._apply_candidate(state, old["result"], manual=old.get("manual", False))
            self._configure_native_effects(rebind=True)
        run_on_ui_thread(apply)
        self._refresh_quick_settings()

    def _configure_native_effects(self, view=None, rebind=False):
        if getattr(self, "_Player", None) is None:
            return
        try:
            sheet = self._Player.instance
            if sheet is None or sheet.isDismissed():
                return
            current = self._field(sheet, "lyricsView")
            ident = int(self._System.identityHashCode(current))
            if view is not None and int(self._System.identityHashCode(view)) != ident:
                return
            if view is None and any(int(self._System.identityHashCode(s["view"])) == ident for s in self._states.values()):
                return
            if rebind and self._word_methods.get("bind"):
                lyrics = self._field(current, "lyrics")
                if lyrics is not None:
                    self._word_methods["bind"].invoke(None, current, lyrics)
            self._configure_effects({"sheet": sheet, "view": current})
        except Exception as error:
            self._log(_t("Эффекты штатного текста: ") + type(error).__name__)

    def _paused_player_position(self, view):
        try:
            if not getattr(self, "_paused_clock_fields", None):
                return None
            sheet = self._Player.instance
            if sheet is None or sheet.isDismissed() or view.getState() != 3:
                return None
            actual = self._field(sheet, "lyricsView")
            if int(self._System.identityHashCode(actual)) != int(self._System.identityHashCode(view)):
                return None
            controller = self._MediaController.getInstance()
            if not controller.isMessagePaused():
                return None
            player = self._field(controller, "audioPlayer")
            if player is not None:
                position = int(player.getCurrentPosition())
                return position if position >= 0 else None
        except Exception as error:
            self._log(_t("Позиция на паузе: ") + type(error).__name__)
        return None

    def _remember_quick_sheet(self, sheet):
        ident = int(self._System.identityHashCode(sheet))
        previous = getattr(self, "_quick_sheets", [])
        known = any(key == ident and ref.get() is not None for key, ref in previous)
        refs = [(key, ref) for key, ref in previous if ref.get() is not None and key != ident]
        self._quick_sheets = (refs + [(ident, self._WeakReference(sheet))])[-4:]
        expanded = getattr(self, "_quick_expanded", {})
        self._quick_expanded = {key: expanded.get(key, False) for key, _ in self._quick_sheets}
        if not known:
            self._quick_expanded[ident] = False

    def _fill_quick_settings(self, sheet, items):
        for index in range(int(items.size()) - 1, -1, -1):
            if int(items.get(index).id) in QUICK_SETTING_IDS:
                items.remove(index)
        anchor = next((i + 1 for i in range(int(items.size())) if int(items.get(i).id) == 3), None)
        if anchor is None:
            return
        self._remember_quick_sheet(sheet)
        expanded = self._quick_expanded.get(int(self._System.identityHashCode(sheet)), False)
        reference = self._WeakReference(sheet)
        def toggle_effects(view):
            owner = reference.get()
            if self._active and owner is not None and not owner.isDismissed():
                self.set_setting("effects_enabled", not bool(self.get_setting("effects_enabled", False)), reload_settings=False)
                self._effects_changed()
        rows = [self._UItem.asCheck(QUICK_WORDS_ID, _t("Пословное караоке"), _t("Заливка по таймкодам слов, когда они доступны."), True).setChecked(bool(self.get_setting("words", True))),
                self._UItem.asExteraExpandableSwitch(QUICK_EFFECTS_ID, _t("Живой текст"), _t(EFFECT_SHORT_NAMES[max(0, min(6, int(self.get_setting("effects_style", 0))))]), OnClickListener(toggle_effects)).setChecked(bool(self.get_setting("effects_enabled", False))).setCollapsed(not expanded)]
        if expanded:
            for ident, key, default, title, names in ((QUICK_STYLE_ID, "effects_style", 0, _t("Эффект"), EFFECT_NAMES),
                                                     (QUICK_STRENGTH_ID, "effects_strength", 1, _t("Интенсивность"), STRENGTH_NAMES),
                                                     (QUICK_TRANSITION_ID, "transition_mode", 2, _t("Плавность переходов"), TRANSITION_NAMES),
                                                     (QUICK_LEAD_ID, "transition_lead", 2, _t("Упреждение перехода"), LEAD_NAMES)):
                selected = max(0, min(len(names)-1, int(self.get_setting(key, default))))
                rows.append(self._UItem.asButton(ident, title, _t(names[selected]) + " ▾").pad())
        for offset, row in enumerate(rows):
            items.add(anchor + offset, row)

    def _set_quick_effect(self, key, index):
        names = {"effects_style": EFFECT_NAMES, "effects_strength": STRENGTH_NAMES, "transition_mode": TRANSITION_NAMES, "transition_lead": LEAD_NAMES}.get(key, ())
        if not 0 <= index < len(names):
            return
        self.set_setting(key, index, reload_settings=False)
        self._effects_changed()

    def _open_effect_dropdown(self, sheet, view, key):
        from android_utils import R
        names = {"effects_style": EFFECT_NAMES, "effects_strength": STRENGTH_NAMES, "transition_mode": TRANSITION_NAMES, "transition_lead": LEAD_NAMES}[key]
        default = 0 if key == "effects_style" else 1 if key == "effects_strength" else 2
        selected = max(0, min(len(names)-1, int(self.get_setting(key, default))))
        provider = self._field(sheet, "resourcesProvider")
        popup = self._ItemOptions.makeOptions(self._field(sheet, "containerView"), provider, view)
        reference = self._WeakReference(sheet)
        for index, title in enumerate(names):
            def choose(which=index):
                owner = reference.get()
                if self._active and owner is not None and not owner.isDismissed():
                    self._set_quick_effect(key, which)
            popup.addChecked(index == selected, _t(title), R(choose))
        popup.setMinWidth(230).show()

    def _quick_toggle(self, sheet, item, view):
        ident = int(item.id)
        if ident == QUICK_EFFECTS_ID:
            self._remember_quick_sheet(sheet)
            key = int(self._System.identityHashCode(sheet))
            self._quick_expanded[key] = not self._quick_expanded.get(key, False)
            self._field(sheet, "adapter").update(True)
            return True
        if ident in (QUICK_STYLE_ID, QUICK_STRENGTH_ID, QUICK_TRANSITION_ID, QUICK_LEAD_ID):
            self._remember_quick_sheet(sheet)
            self._open_effect_dropdown(sheet, view, {QUICK_STYLE_ID: "effects_style", QUICK_STRENGTH_ID: "effects_strength", QUICK_TRANSITION_ID: "transition_mode", QUICK_LEAD_ID: "transition_lead"}[ident])
            return True
        if ident != QUICK_WORDS_ID:
            return False
        value = not bool(self.get_setting("words", True))
        self.set_setting("words", value, reload_settings=False)
        self._settings_checked.invoke(None, view, self._Boolean.TRUE if value else self._Boolean.FALSE)
        self._remember_quick_sheet(sheet)
        self._words_changed()
        return True

    def _refresh_quick_settings(self):
        def refresh():
            for _, ref in list(getattr(self, "_quick_sheets", [])):
                sheet = ref.get()
                if sheet is not None and not sheet.isDismissed():
                    try:
                        self._field(sheet, "adapter").update(True)
                    except Exception as error:
                        self._log(_t("Обновление настроек плеера: ") + type(error).__name__)
        run_on_ui_thread(refresh)

    def _load_word_renderer(self, lyrics_view, line_view):
        try:
            context = jclass("org.telegram.messenger.ApplicationLoader").applicationContext
            directory = os.path.join(str(context.getCodeCacheDir().getAbsolutePath()), "ayu_lyrics_sources")
            os.makedirs(directory, exist_ok=True)
            payload = base64.b64decode(WORD_RENDERER_DEX)
            digest = hashlib.sha256(payload).hexdigest()
            filename = os.path.join(directory, digest + ".dex")
            if not os.path.exists(filename) or os.path.getsize(filename) != len(payload):
                tmp_filename = filename + ".tmp"
                with open(tmp_filename, "wb") as output:
                    output.write(payload)
                    output.flush()
                try:
                    os.chmod(tmp_filename, 0o400)
                except Exception:
                    pass
                os.replace(tmp_filename, filename)
            with open(filename, "rb") as source:
                if hashlib.sha256(source.read()).hexdigest() != digest:
                    try:
                        os.remove(filename)
                    except Exception:
                        pass
                    raise RuntimeError("renderer integrity")
            # Each plugin version writes a new <sha256>.dex; drop older builds and their oat output.
            for root, _, files in os.walk(directory):
                for name in files:
                    if re.fullmatch(r"[0-9a-f]{64}\.(?:dex|odex|vdex|art)(?:\.tmp)?", name) and not name.startswith(digest + "."):
                        try:
                            os.remove(os.path.join(root, name))
                        except Exception:
                            pass
            self._dex_loader = jclass("dalvik.system.DexClassLoader")(filename, directory, None, context.getClassLoader())
            renderer = self._dex_loader.loadClass("local.ayu.lyrics.WordRenderer")
            Object, String, Class = (find_class(n) for n in ("java.lang.Object", "java.lang.String", "java.lang.Class"))
            self._word_methods = {
                "register": renderer.getDeclaredMethod("register", Object, String),
                "bind": renderer.getDeclaredMethod("bind", Object, Object),
                "clear": renderer.getDeclaredMethod("clear"),
                "draw": renderer.getDeclaredMethod("draw", Object, find_class("android.graphics.Canvas"),
                    find_class("android.text.Layout"), find_class("android.graphics.Paint"), jclass("java.lang.Integer").TYPE),
            }
            effects = self._dex_loader.loadClass("local.ayu.lyrics.LyricEffects")
            Integer = jclass("java.lang.Integer").TYPE
            transitions = self._dex_loader.loadClass("local.ayu.lyrics.LineTransitions")
            self._word_methods["transitions"] = transitions.getDeclaredMethod("configure", Object, Integer, Integer)
            self._word_methods["effects"] = effects.getDeclaredMethod("configure", Object, Object, Integer, Integer, Integer)
            self._word_methods["detach"] = effects.getDeclaredMethod("detach", Object)
            self._word_methods["release"] = renderer.getDeclaredMethod("release", Object)
            self._word_methods["accent"] = effects.getDeclaredMethod("setAccent", Object, Integer)
            renderer.getDeclaredMethod("initialize", Class, Class).invoke(None, lyrics_view, line_view)
            return True
        except Exception as error:
            self._log("Word renderer disabled: " + type(error).__name__ + " (" + str(error) + ")")
            self._word_methods = {}
            return False

    def _enable_native_player(self):
        # Requested prerequisites, applied on enable only. Do not fight later user changes.
        try:
            config = jclass("com.exteragram.messenger.ExteraConfig")
        except Exception as error:
            self._log("Native player preferences: " + type(error).__name__)
            return
        for getter, setter in (("getNewPlayerStyle", "setNewPlayerStyle"), ("getLyricsOnline", "setLyricsOnline")):
            try:
                if not getattr(config, getter)():
                    getattr(config, setter)(True)
            except Exception as error:
                self._log("Native player preference " + getter + ": " + type(error).__name__)

    def on_plugin_load(self):
        global _language_choice
        _language_choice = _language_index(self.get_setting("language", 0))
        self._active = False
        self._load_token = getattr(self, "_load_token", 0) + 1
        self._lock = threading.RLock()
        self._cache = OrderedDict()
        self._pending = {}
        self._generation = 0
        self._hooks = []
        self._word_methods = {}
        self._states = OrderedDict()
        self._quick_sheets = []
        self._quick_expanded = {}
        self._variant_sheets = []
        self._alias_dialogs = []
        self._errors = []
        self._history = self._read_saved("history_v2", [])[:20]
        self._search_queries = self._read_search_queries()
        self._choices = self._read_saved("choices_v2", {})
        self._offline = self._read_saved("offline_v2", {})
        for name, key in (("_choices", "choices_v2"), ("_offline", "offline_v2")):
            saved = getattr(self, name)
            clean = {k: item for k, old in saved.items() if (item := sanitize_candidate(old)) is not None}
            setattr(self, name, clean)
            if clean != saved:
                self._persist(key, clean)
        self._last_report = _t("Поиск ещё не выполнялся")
        self._compat = _t("Не инициализирован")
        self._engine = SearchEngine()
        self._jobs = concurrent.futures.ThreadPoolExecutor(max_workers=2, thread_name_prefix="AyuLyricsSearch")
        try:
            repo = find_class(PREFIX + "lyrics.LyricsRepository")
            query = find_class(PREFIX + "TrackQuery")
            callback = find_class(PREFIX + "lyrics.LyricsRepository$Callback")
            self._Lyrics = jclass(PREFIX + "lyrics.Lyrics")
            self._Boolean = jclass("java.lang.Boolean")
            self._Integer = jclass("java.lang.Integer")
            self._Long = jclass("java.lang.Long")
            self._Linkify = jclass("android.text.util.Linkify")
            self._LinkMovementMethod = jclass("android.text.method.LinkMovementMethod")
            self._System = jclass("java.lang.System")
            self._WeakReference = jclass("java.lang.ref.WeakReference")
            self._UItem = jclass("org.telegram.ui.Components.UItem")
            self._ItemOptions = jclass("org.telegram.ui.Components.ItemOptions")
            self._MediaController = jclass("org.telegram.messenger.MediaController")
            self._Player = jclass(PREFIX + "MusicPlayerSheet")
            self._TrackQuery = jclass(PREFIX + "TrackQuery")
            self._Repository = jclass(PREFIX + "lyrics.LyricsRepository")
            self._ExpressiveDrawable = jclass(PREFIX + "ui.ExpressiveStateDrawable")
            self._text_icon = jclass("org.telegram.messenger.R$drawable").msg_list
            self._FrameParams = jclass("android.widget.FrameLayout$LayoutParams")
            self._dp = jclass("org.telegram.messenger.AndroidUtilities").dp
            player = find_class(PREFIX + "MusicPlayerSheet")
            self._show_method = player.getDeclaredMethod("showLyrics", find_class(PREFIX + "lyrics.Lyrics"))
            self._show_state_method = player.getDeclaredMethod("showLyricsState", jclass("java.lang.Integer").TYPE)
            load_method = player.getDeclaredMethod("loadLyrics", jclass("java.lang.Boolean").TYPE)
            dismiss_method = player.getDeclaredMethod("dismiss")
            self._create_icon_method = player.getDeclaredMethod("createIconButton", find_class("android.content.Context"),
                jclass("java.lang.Integer").TYPE, find_class(PREFIX + "ui.ExpressiveStateDrawable"))
            self._tint_icon_method = player.getDeclaredMethod("setIconTint", find_class("android.widget.ImageView"),
                find_class(PREFIX + "ui.ExpressiveStateDrawable"), jclass("java.lang.Integer").TYPE)
            touch_method = player.getDeclaredMethod("dispatchTouchEvent", find_class("android.view.MotionEvent"))
            for method in (self._show_method, self._show_state_method, load_method, dismiss_method, self._create_icon_method, self._tint_icon_method):
                method.setAccessible(True)
            for method, hook in ((load_method, PlayerLoadHook(self)), (dismiss_method, PlayerDismissHook(self)), (touch_method, PlayerTouchHook(self))):
                handle = self.hook_method(method, hook)
                if handle is None:
                    raise RuntimeError("player hook failed")
                self._hooks.append(handle)
            methods = [(name, repo.getDeclaredMethod(name, query, callback) if name in ("fetch", "loadCached")
                        else repo.getDeclaredMethod(name, query))
                       for name in ("getCached", "isKnownMissing", "loadCached", "fetch")]
            for name, method in methods:
                h = self.hook_method(method, RepositoryHook(self, name))
                if h is not None:
                    self._hooks.append(h)
                else:
                    raise RuntimeError("Failed to hook repository method: " + name)
            try:
                view = find_class(PREFIX + "ui.LyricsView")
                self._credit_field = view.getDeclaredField("creditView")
                self._credit_field.setAccessible(True)
                try:
                    self._lyrics_field = view.getDeclaredField("lyrics")
                    self._lyrics_field.setAccessible(True)
                except Exception:
                    self._lyrics_field = None
                credit_method = view.getDeclaredMethod("addCredit", find_class("android.content.Context"),
                                                       find_class("java.lang.CharSequence"), jclass("java.lang.Float").TYPE)
                credit_method.setAccessible(True)
                h_credit = self.hook_method(credit_method, CreditHook(self))
                if h_credit:
                    self._hooks.append(h_credit)
                color_method = view.getDeclaredMethod("setColors", *([jclass("java.lang.Integer").TYPE] * 4))
                h_color = self.hook_method(color_method, PlayerColorHook(self))
                if h_color:
                    self._hooks.append(h_color)
            except Exception as credit_err:
                self._log("Credit hook skipped: " + str(credit_err))

            word_ok = False
            word_handles = []
            try:
                view = find_class(PREFIX + "ui.LyricsView")
                line_view = find_class(PREFIX + "ui.LyricsView$LineView")
                if self._load_word_renderer(view, line_view):
                    bind_method = view.getDeclaredMethod("setLyrics", find_class(PREFIX + "lyrics.Lyrics"), find_class("java.lang.CharSequence"))
                    h_bind = self.hook_method(bind_method, WordBindHook(self))
                    if h_bind is None:
                        raise RuntimeError("word bind hook failed")
                    self._hooks.append(h_bind)
                    word_handles.append(h_bind)
                    self._renderer_hooks = self._dex_loader.loadClass("local.ayu.lyrics.RendererHooks")
                    self._renderer_hooks.getDeclaredMethod("install", find_class("java.lang.Class"), find_class("java.lang.Class")).invoke(None, view, line_view)
                    self._native_uninstall = self._renderer_hooks.getDeclaredMethod("uninstall")
                    self._word_methods["release"] = self._renderer_hooks.getDeclaredMethod("release", find_class("java.lang.Object"))
                    word_ok = True
            except Exception as word_err:
                for handle in word_handles:
                    try:
                        self.unhook_method(handle)
                        self._hooks.remove(handle)
                    except Exception:
                        pass
                self._word_methods = {}
                self._log("Word hooks skipped: " + str(word_err))

            quick_handles = []
            try:
                view = find_class(PREFIX + "ui.LyricsView")
                self._paused_clock_fields = {}
                for name in ("clockPositionMs", "lastDisplayPositionMs", "catchUpMs"):
                    field = view.getDeclaredField(name)
                    field.setAccessible(True)
                    self._paused_clock_fields[name] = field
            except Exception as pause_error:
                self._paused_clock_fields = {}
                self._log("Pause position sync unavailable: " + str(pause_error))
            try:
                settings = find_class(PREFIX + "ui.PlayerSettingsSheet")
                fill = settings.getDeclaredMethod("fillItems", find_class("java.util.ArrayList"), find_class("org.telegram.ui.Components.UniversalAdapter"))
                click = settings.getDeclaredMethod("onItemClick", find_class("org.telegram.ui.Components.UItem"), find_class("android.view.View"))
                self._settings_checked = settings.getDeclaredMethod("setChecked", find_class("android.view.View"), self._Boolean.TYPE)
                self._settings_checked.setAccessible(True)
                for method, hook in ((fill, QuickSettingsFillHook(self)), (click, QuickSettingsClickHook(self))):
                    method.setAccessible(True)
                    handle = self.hook_method(method, hook)
                    if handle is None:
                        raise RuntimeError("quick settings hook failed")
                    self._hooks.append(handle)
                    quick_handles.append(handle)
            except Exception as settings_error:
                for handle in quick_handles:
                    try:
                        self.unhook_method(handle)
                        self._hooks.remove(handle)
                    except Exception:
                        pass
                self._log("Quick settings unavailable: " + str(settings_error))

            try:
                artwork = self._dex_loader.loadClass("local.ayu.lyrics.PluginArtwork")
                self._artwork_method = artwork.getDeclaredMethod("create", find_class("android.content.res.Resources"))
                cell = find_class("com.exteragram.messenger.plugins.ui.components.PluginCell")
                self._plugin_image_field = cell.getDeclaredField("imageView")
                self._plugin_image_field.setAccessible(True)
                method = cell.getDeclaredMethod("set", find_class("com.exteragram.messenger.plugins.Plugin"),
                    find_class("com.exteragram.messenger.plugins.ui.components.PluginCellDelegate"))
                handle = self.hook_method(method, PluginArtworkHook(self))
                if handle is not None:
                    self._hooks.append(handle)
            except Exception as icon_error:
                self._log("Plugin artwork fallback: " + type(icon_error).__name__)

            try:
                sheet = self._dex_loader.loadClass("local.ayu.lyrics.SourceSheet")
                self._source_sheet_show = sheet.getDeclaredMethod("show", find_class("android.content.Context"), find_class("java.lang.Object"), find_class("java.lang.String"), find_class("android.view.View$OnClickListener"))
                self._source_sheet_update = sheet.getDeclaredMethod("update", find_class("android.app.Dialog"), find_class("java.lang.String"))
            except Exception as sheet_error:
                self._source_sheet_show = None
                self._log("Native source sheet unavailable: " + str(sheet_error)[:180])

            self._active = True
            self._sync_description()
            if word_ok:
                self._compat = _t("Подключён к MD3-плееру; модуль караоке загружен")
            else:
                self._compat = _t("Подключён к MD3-плееру (построчный режим)")
            def attach_open_player():
                try:
                    if not self._active:
                        return
                    self._enable_native_player()
                    sheet = self._Player.instance
                    if self._active and sheet is not None and not sheet.isDismissed():
                        if self.get_setting("enabled", True) and int(self._field(sheet, "mode")) == 1:
                            self._load_sheet(sheet)
                        else:
                            self._configure_native_effects(rebind=True)
                        settings_sheet = self._field(sheet, "settingsSheet")
                        if settings_sheet is not None and not settings_sheet.isDismissed():
                            self._field(settings_sheet, "adapter").update(False)
                except Exception as attach_error:
                    self._log("Attach player: " + type(attach_error).__name__)
            run_on_ui_thread(attach_open_player)
        except Exception as error:
            self._compat = _t("Ошибка загрузки: ") + type(error).__name__ + _t(". Действует штатный поиск.")
            self._log(self._compat)
            self._remove_hooks()
            self._engine.close()
            self._jobs.shutdown(wait=False, cancel_futures=True)

    def _remove_hooks(self):
        native = getattr(self, "_native_uninstall", None)
        if native is not None:
            try:
                native.invoke(None)
            except Exception as error:
                self._log("Native renderer unhook: " + type(error).__name__)
            self._native_uninstall = None
        for hook in reversed(self._hooks):
            if hook is not None:
                try:
                    self.unhook_method(hook)
                except Exception:
                    try:
                        hook.unhook()
                    except Exception:
                        pass
        self._hooks.clear()

    def on_plugin_unload(self):
        self._active = False
        self._refresh_quick_settings()
        aliases = getattr(self, "_alias_dialogs", [])
        self._alias_dialogs = []
        def close_aliases():
            for reference in aliases:
                dialog = reference.get()
                if dialog is not None:
                    dialog.dismiss()
        run_on_ui_thread(close_aliases)
        self._invalidate()
        self._remove_hooks()
        self._engine.close()
        self._jobs.shutdown(wait=False, cancel_futures=True)
        token = getattr(self, "_load_token", 0)

        def release():
            # Runs after the UI cleanup queued above; skipped if the plugin was loaded again.
            if self._active or getattr(self, "_load_token", 0) != token:
                return
            with self._lock:
                self._cache.clear()
                self._pending.clear()
            self._states.clear()
            self._variant_sheets = []
            self._quick_sheets = []
            self._quick_expanded = {}
            with self._engine.client.catalog_lock:
                self._engine.client.catalog = None
            for name in ("_dex_loader", "_renderer_hooks", "_native_uninstall", "_artwork_method",
                         "_plugin_image_field", "_source_sheet_show", "_source_sheet_update"):
                setattr(self, name, None)
            self._word_methods = {}
        run_on_ui_thread(release)

    def _show_report(self, _view, query=None):
        from client_utils import get_last_fragment
        fragment = get_last_fragment()
        if fragment is not None:
            history = getattr(self, "_history", [])
            if query:
                history = [r for r in history if r.get("id") == self._track_key(query)]
            message = "\n\n".join(self._format_report(r) for r in history[:20]) or _t("Поиск ещё не выполнялся")
            message = _t(getattr(self, "_compat", "")) + "\n\n" + message
            errors = getattr(self, "_errors", [])
            if errors:
                message += _t("\n\nСобытия плагина:\n") + "\n".join(errors)
            AlertDialogBuilder(fragment.getParentActivity()).set_title(_t("Последние поиски")).set_message(message[:24000]).set_positive_button("OK", lambda *_: None).show()

    def _commit_artist_alias(self, original, alias, previous=None):
        original = " ".join(str(original).split())[:200]
        if not original:
            raise ValueError(_t("Укажите имя из аудиофайла"))
        pairs = parse_artist_aliases(self.get_setting("artist_aliases", ""))
        remove = {strip_extras(original), strip_extras(previous or original)}
        pairs = [(a, b) for a, b in pairs if strip_extras(a) not in remove]
        if alias is not None:
            alias = " ".join(str(alias).split())[:200]
            if not alias or strip_extras(alias) == strip_extras(original):
                raise ValueError(_t("Укажите другое имя для поиска"))
            if len(pairs) >= 24:
                raise ValueError(_t("Сохранено 24 замены. Сначала удалите ненужную"))
            pairs.append((original, alias))
        self.set_setting("artist_aliases", json.dumps(pairs, ensure_ascii=False), reload_settings=False)
        self._invalidate()
        def reload_player():
            sheet = self._Player.instance if getattr(self, "_Player", None) is not None else None
            if self._active and sheet is not None and not sheet.isDismissed() and int(self._field(sheet, "mode")) == 1:
                self._load_sheet(sheet)
        run_on_ui_thread(reload_player)

    def _remember_alias_dialog(self, dialog, builder=None, on_dismiss=None):
        # SDK item listeners retain their Python builder. Break its Java edges on dismiss.
        if builder is not None:
            from java import dynamic_proxy
            reference = weakref.ref(builder)
            class ReleaseBuilder(dynamic_proxy(jclass("android.content.DialogInterface$OnDismissListener"))):
                def onDismiss(self, _dialog):
                    holder = reference()
                    if holder is not None:
                        holder._alert_dialog = None
                        holder._java_builder = None
                    if on_dismiss is not None:
                        on_dismiss()
            dialog.setOnDismissListener(ReleaseBuilder())
        refs = [ref for ref in getattr(self, "_alias_dialogs", []) if ref.get() is not None]
        self._alias_dialogs = (refs + [self._WeakReference(dialog)])[-4:]

    def _show_track_search(self, entry):
        if not self._state_current(entry):
            return
        from client_utils import get_last_fragment
        from java import dynamic_proxy
        fragment = get_last_fragment()
        if fragment is None:
            return
        context = fragment.getParentActivity()
        view_ref = self._WeakReference(entry["view"])
        track_id = entry["track_id"]
        load_token = getattr(self, "_load_token", 0)
        query = dict(entry["query"])
        custom = bool(query.get("_manual"))
        def reopen():
            def show():
                if not self._active or getattr(self, "_load_token", 0) != load_token:
                    return
                view = view_ref.get()
                state = self._entry_for_view(view) if view is not None else None
                if state is not None and state["track_id"] == track_id and view.getWindowToken() is not None and not state["sheet"].isDismissed():
                    self._open_variants_dialog(view, state)
            run_on_ui_thread(show, 140)
        Linear = jclass("android.widget.LinearLayout")
        Params = jclass("android.widget.LinearLayout$LayoutParams")
        Label = jclass("android.widget.TextView")
        Edit = jclass("org.telegram.ui.Components.EditTextBoldCursor")
        Theme = jclass("org.telegram.ui.ActionBar.Theme")
        Drawable = jclass("android.graphics.drawable.GradientDrawable")
        color = Theme.getColor
        foreground, secondary = color(Theme.key_dialogTextBlack), color(Theme.key_dialogTextGray3)
        background, accent = color(Theme.key_dialogBackground), color(Theme.key_dialogTextBlue2)
        try:
            accent = int(self._field(entry["sheet"], "colors").accent)
        except Exception:
            pass
        def blend(left, right, amount):
            value = 0xff000000 | sum(round(((left >> shift) & 255) * (1-amount) + ((right >> shift) & 255) * amount) << shift for shift in (16, 8, 0))
            return value - 0x100000000
        body = Linear(context); body.setOrientation(1)
        body.setPadding(self._dp(24), self._dp(2), self._dp(24), self._dp(8))
        note = Label(context); note.setText(_t("Уточните исполнителя и название для поиска текста."))
        note.setTextSize(14); note.setTextColor(secondary); note.setPadding(0, 0, 0, self._dp(16))
        body.addView(note, Params(-1, -2))
        fields = []
        Ime = jclass("android.view.inputmethod.EditorInfo")
        for index, (label_text, hint, value) in enumerate(((_t("Исполнитель"), _t("Можно оставить пустым"), query.get("artist", "")),
                                                          (_t("Название трека"), _t("Обязательное поле"), query.get("title", "")))):
            card = Linear(context); card.setOrientation(1); card.setPadding(self._dp(14), self._dp(10), self._dp(14), self._dp(8))
            shape = Drawable(); shape.setColor(blend(background, foreground, .065)); shape.setCornerRadius(self._dp(14))
            shape.setStroke(self._dp(1), blend(background, foreground, .13)); card.setBackgroundDrawable(shape)
            label = Label(context); label.setText(label_text); label.setTextSize(12); label.setTextColor(secondary)
            label.setMinHeight(self._dp(20)); card.addView(label, Params(-1, -2))
            field = Edit(context); field.setSingleLine(True); field.setTextSize(18); field.setTextColor(foreground)
            field.setHintTextColor(color(Theme.key_dialogTextHint)); field.setHint(hint); field.setContentDescription(label_text)
            field.setBackgroundDrawable(None); field.setPadding(0, 0, 0, 0); field.setInputType(0x80001)
            field.setFilters([jclass("android.text.InputFilter$LengthFilter")(200)]); field.setText(str(value)[:200])
            field.setSelectAllOnFocus(True); field.setMinHeight(self._dp(40))
            field.setImeOptions((5 if index == 0 else 6) | Ime.IME_FLAG_NO_EXTRACT_UI | Ime.IME_FLAG_NO_FULLSCREEN)
            card.addView(field, Params(-1, -2)); fields.append(field)
            space = Params(-1, -2); space.bottomMargin = self._dp(12); body.addView(card, space)
            stroke_width = self._dp(1)
            def focus_listener(shape_ref, label_ref):
                class Focus(dynamic_proxy(jclass("android.view.View$OnFocusChangeListener"))):
                    def onFocusChange(self, _view, focused):
                        drawable, caption = shape_ref.get(), label_ref.get()
                        if drawable is not None:
                            drawable.setStroke(stroke_width, blend(background, accent if focused else foreground, .70 if focused else .13))
                        if caption is not None:
                            caption.setTextColor(accent if focused else secondary)
                return Focus()
            field.setOnFocusChangeListener(focus_listener(self._WeakReference(shape), self._WeakReference(label)))
        preview = Label(context); preview.setTextSize(14); preview.setTextColor(foreground); preview.setMaxLines(2)
        preview.setEllipsize(jclass("android.text.TextUtils$TruncateAt").END); body.addView(preview, Params(-1, -2))
        helper = Label(context); helper.setText(_t("Только для этого трека. Файл и теги не изменятся."))
        helper.setTextSize(12); helper.setTextColor(secondary); helper.setPadding(0, self._dp(8), 0, self._dp(4)); body.addView(helper, Params(-1, -2))
        scroll = jclass("android.widget.ScrollView")(context); scroll.setFillViewport(False); scroll.addView(body)
        builder = self._dialog(entry).set_title(_t("Ручной поиск текста")).set_view(scroll, -2).set_positive_button(_t("Найти"), None).set_negative_button(_t("Отмена"), None)
        if custom:
            builder.set_neutral_button(_t("Сбросить"), None)
        builder.show(); dialog = builder.get_dialog(); self._remember_alias_dialog(dialog, builder, reopen)
        dialog.getWindow().setSoftInputMode(0x10)
        owner, artist_ref, title_ref = (self._WeakReference(obj) for obj in (dialog, fields[0], fields[1]))
        button_ref, preview_ref = self._WeakReference(dialog.getButton(-1)), self._WeakReference(preview)
        class Watcher(dynamic_proxy(jclass("android.text.TextWatcher"))):
            def beforeTextChanged(self, *_args): pass
            def onTextChanged(self, *_args): pass
            def afterTextChanged(self, _value):
                artist, title, button, caption = artist_ref.get(), title_ref.get(), button_ref.get(), preview_ref.get()
                if artist is None or title is None: return
                name, performer = str(title.getText()).strip(), str(artist.getText()).strip()
                if button is not None:
                    button.setEnabled(bool(name)); button.setAlpha(1 if name else .45)
                if caption is not None:
                    caption.setText((_t("Запрос: ") + name + (" · " + performer if performer else "")) if name else _t("Укажите название трека"))
        watcher = Watcher()
        for field in fields: field.addTextChangedListener(watcher)
        watcher.afterTextChanged(None)
        def submit(reset=False):
            window, artist, title, view = owner.get(), artist_ref.get(), title_ref.get(), view_ref.get()
            if not self._active or getattr(self, "_load_token", 0) != load_token or window is None or artist is None or title is None or view is None: return
            try:
                self._commit_track_search(view, track_id, str(title.getText()), str(artist.getText()), reset=reset)
            except ValueError as error:
                title.setError(str(error)); return
            try:
                title.getContext().getSystemService("input_method").hideSoftInputFromWindow(title.getWindowToken(), 0)
            except Exception:
                pass
            window.dismiss()
        dialog.getButton(-1).setOnClickListener(OnClickListener(lambda _: submit()))
        class Submit(dynamic_proxy(jclass("android.widget.TextView$OnEditorActionListener"))):
            def onEditorAction(self, _view, action, _event):
                button = button_ref.get()
                if int(action) == 6 and button is not None and button.isEnabled(): button.performClick(); return True
                return False
        fields[1].setOnEditorActionListener(Submit())
        if custom:
            dialog.getButton(-3).setOnClickListener(OnClickListener(lambda _: submit(True)))

    def _show_artist_aliases(self, _view=None):
        from client_utils import get_last_fragment
        fragment = get_last_fragment()
        if fragment is None:
            return
        pairs = parse_artist_aliases(self.get_setting("artist_aliases", ""))
        current = ""
        message = self._current_message()
        if message is not None:
            query = self._TrackQuery.forMessage(message)
            if query is not None:
                current = str(query.artist() or "")
        if not pairs:
            self._edit_artist_alias(current, "")
            return
        rows = [_t("Добавить для текущего трека") if current else _t("Добавить замену")] + [a + " → " + b for a, b in pairs]
        def choose(builder, index):
            builder.dismiss()
            if not self._active:
                return
            if index == 0:
                self._edit_artist_alias(current, "")
            elif 1 <= index <= len(pairs):
                original, alias = pairs[index - 1]
                self._edit_artist_alias(original, alias, original)
        builder = AlertDialogBuilder(fragment.getParentActivity()).set_title(_t("Имена для поиска текста")).set_items(rows, choose).set_negative_button(_t("Закрыть"), None).show()
        self._remember_alias_dialog(builder.get_dialog(), builder)

    def _edit_artist_alias(self, original="", alias="", previous=None):
        from client_utils import get_last_fragment
        fragment = get_last_fragment()
        if fragment is None:
            return
        from java import dynamic_proxy
        context = fragment.getParentActivity()
        Linear = jclass("android.widget.LinearLayout")
        Params = jclass("android.widget.LinearLayout$LayoutParams")
        Label = jclass("android.widget.TextView")
        Edit = jclass("org.telegram.ui.Components.EditTextBoldCursor")
        Theme = jclass("org.telegram.ui.ActionBar.Theme")
        Drawable = jclass("android.graphics.drawable.GradientDrawable")
        color = Theme.getColor
        foreground, secondary = color(Theme.key_dialogTextBlack), color(Theme.key_dialogTextGray3)
        background, accent = color(Theme.key_dialogBackground), color(Theme.key_dialogTextBlue2)
        def blend(left, right, amount):
            value = 0xff000000 | sum(round(((left >> shift) & 255) * (1 - amount) + ((right >> shift) & 255) * amount) << shift for shift in (16, 8, 0))
            return value - 0x100000000
        surface = blend(background, foreground, .065)
        body = Linear(context); body.setOrientation(1)
        body.setPadding(self._dp(24), self._dp(2), self._dp(24), self._dp(8))
        note = Label(context); note.setText(_t("Укажите сценическое имя, под которым искать тексты этого исполнителя."))
        note.setTextSize(14); note.setTextColor(secondary); note.setPadding(0, 0, 0, self._dp(16))
        body.addView(note, Params(-1, -2))
        fields = []
        for index, (title, hint, value) in enumerate(((_t("Имя в аудиофайле"), _t("Имя из тегов"), original), (_t("Искать под именем"), _t("Сценическое имя или группа"), alias))):
            card = Linear(context); card.setOrientation(1); card.setPadding(self._dp(14), self._dp(10), self._dp(14), self._dp(8))
            shape = Drawable(); shape.setColor(surface); shape.setCornerRadius(self._dp(14))
            if index == 1:
                shape.setStroke(self._dp(1), blend(background, accent, .65))
            card.setBackgroundDrawable(shape)
            label = Label(context); label.setText(_t(title)); label.setTextSize(12); label.setTextColor(accent if index else secondary)
            label.setMinHeight(self._dp(20)); card.addView(label, Params(-1, -2))
            field = Edit(context); field.setSingleLine(True); field.setTextSize(18); field.setTextColor(foreground)
            field.setHintTextColor(color(Theme.key_dialogTextHint)); field.setHint(_t(hint)); field.setText(value)
            field.setContentDescription(_t(title)); field.setPadding(0, 0, 0, 0); field.setBackgroundDrawable(None)
            field.setInputType(0x80001)
            Ime = jclass("android.view.inputmethod.EditorInfo")
            field.setImeOptions((5 if index == 0 else 6) | Ime.IME_FLAG_NO_EXTRACT_UI | Ime.IME_FLAG_NO_FULLSCREEN)
            field.setSelectAllOnFocus(True); field.setFilters([jclass("android.text.InputFilter$LengthFilter")(200)])
            field.setMinHeight(self._dp(40)); card.addView(field, Params(-1, -2)); fields.append(field)
            space = Params(-1, -2); space.bottomMargin = self._dp(12); body.addView(card, space)
        preview = Label(context); preview.setTextSize(14); preview.setTextColor(foreground)
        preview.setMaxLines(2); preview.setEllipsize(jclass("android.text.TextUtils$TruncateAt").END)
        body.addView(preview, Params(-1, -2))
        helper = Label(context); helper.setText(_t("Замена применяется ко всем трекам этого исполнителя. Файл и теги не изменятся."))
        helper.setTextSize(12); helper.setTextColor(secondary); helper.setPadding(0, self._dp(8), 0, self._dp(4))
        body.addView(helper, Params(-1, -2))
        scroll = jclass("android.widget.ScrollView")(context); scroll.setFillViewport(False); scroll.addView(body)
        builder = AlertDialogBuilder(context).set_title(_t("Имя для поиска текста")).set_view(scroll, -2).set_positive_button(_t("Сохранить"), None).set_negative_button(_t("Отмена"), None)
        if previous:
            builder.set_neutral_button(_t("Удалить"), None)
        builder.show(); dialog = builder.get_dialog(); self._remember_alias_dialog(dialog, builder)
        dialog.getWindow().setSoftInputMode(0x10)
        owner, first, second = (self._WeakReference(value) for value in (dialog, fields[0], fields[1]))
        button_ref, preview_ref = self._WeakReference(dialog.getButton(-1)), self._WeakReference(preview)
        class PreviewWatcher(dynamic_proxy(jclass("android.text.TextWatcher"))):
            def beforeTextChanged(self, *_args):
                pass
            def onTextChanged(self, *_args):
                pass
            def afterTextChanged(self, _editable):
                left, right, button, label = first.get(), second.get(), button_ref.get(), preview_ref.get()
                if left is None or right is None:
                    return
                original, replacement = str(left.getText()).strip(), str(right.getText()).strip()
                valid = bool(original and replacement and strip_extras(original) != strip_extras(replacement))
                if button is not None:
                    button.setEnabled(valid); button.setAlpha(1.0 if valid else .45)
                if label is not None:
                    label.setText(_t("Запрос: ") + (replacement if replacement else _t("введите имя для поиска")))
        watcher = PreviewWatcher()
        for field in fields:
            field.addTextChangedListener(watcher)
        watcher.afterTextChanged(None)
        def save(_):
            window, left, right = owner.get(), first.get(), second.get()
            if not self._active or window is None or left is None or right is None:
                return
            original, alias = str(left.getText()).strip(), str(right.getText()).strip()
            if not original:
                left.setError(_t("Укажите имя из аудиофайла"))
                return
            try:
                self._commit_artist_alias(original, alias, previous)
            except ValueError as error:
                right.setError(_t(str(error)))
                return
            window.dismiss()
        dialog.getButton(-1).setOnClickListener(OnClickListener(save))
        class Submit(dynamic_proxy(jclass("android.widget.TextView$OnEditorActionListener"))):
            def onEditorAction(self, _view, action, _event):
                button = button_ref.get()
                if int(action) == 6 and button is not None and button.isEnabled():
                    button.performClick()
                    return True
                return False
        fields[1].setOnEditorActionListener(Submit())
        if previous:
            def remove(_):
                window = owner.get()
                if self._active and window is not None:
                    self._commit_artist_alias(previous, None)
                    window.dismiss()
            dialog.getButton(-3).setOnClickListener(OnClickListener(remove))

    def _source_settings(self):
        descriptions = {
            "lrclib": _t("База текстов с проверкой записи и длительности."),
            "lrcmux": _t("Несколько баз в одном поиске."),
            "amll": _t("Пословные таймкоды и слоги."),
            "karalyr": _t("Тексты с синхронизацией по словам."),
            "better": _t("Для части запросов нужен API-ключ."),
            "liriqo": _t("Несколько источников и форматов текста."),
            "lrcred": _t("Нужен Client ID в разделе «Доступ к сервисам»."),
            "lyrically": _t("Поиск через Spotify. Экспериментальный источник."),
            "lrcshare": _t("Нужен собственный API-ключ."),
            "lyricsplus": _t("Нужен адрес своего сервера."),
        }
        rows = [Header(text=_t("Источники текстов"))]
        for key, label, default in PROVIDERS:
            rows.append(Switch(key="source_" + key, text=label, default=default,
                               subtext=descriptions[key], on_change=self._invalidate))
        rows.extend([Divider(text=_t("NetEase используется для автовыбора только после подтверждения слов независимым источником. Авторские кредиты и служебные ответы не считаются текстом.")),
                     Text(text=_t("Доступ к сервисам"), subtext=_t("API-ключи и адрес сервера"), create_sub_fragment=self._access_settings),
                     Divider(text=_t("Агрегаторы могут обращаться к своим внутренним базам. Тумблеры управляют прямыми запросами плагина."))])
        return rows

    def _matching_settings(self):
        return [Header(text=_t("Автовыбор текста")),
                Switch(key="embedded_first", text=_t("Предпочитать текст файла"), default=False, on_change=self._matching_changed,
                       subtext=_t("Если в аудиофайле есть текст, выбирать его первым.")),
                Switch(key="apple_first", text=_t("Предпочитать Apple Music"), default=True, on_change=self._matching_changed,
                       subtext=_t("В режиме «Авто» предпочитать подходящую пословную версию Apple Music.")),
                Selector(key="pref_source", text=_t("Предпочитать источник"), default=0, on_change=self._matching_changed,
                         items=[_t("Авто"), "LRC Mux", "LRCLIB", "AMLL TTML", "Karalyr", "Better Lyrics", "LiriQo", "lrc.red", "LrcShare", "Spotify", "LyricsPlus"]),
                Selector(key="pref_mode", text=_t("Приоритет при выборе"), default=0, on_change=self._matching_changed,
                         items=[_t("Авто"), _t("Построчный"), _t("Метаданные"), _t("Полнота")]),
                Divider(text=_t("Автовыбор сначала проверяет запись и полноту слов, затем качество синхронизации. Ручной выбор версии сохраняется, пока вы не вернёте автовыбор в меню текстов.")),
                Text(text=_t("Исправить имя для поиска"), on_click=self._show_artist_aliases,
                     subtext=_t("Заменить имя только для поиска."))]

    def _access_settings(self):
        return [Header(text=_t("Доступ к сервисам")),
                Divider(text=_t("Основные источники работают без ключей. Заполняйте эти поля только для сервисов, которыми пользуетесь.")),
                Input(key="better_key", text=_t("Better Lyrics: API-ключ"), default="", on_change=self._invalidate),
                Input(key="lrcshare_key", text=_t("LrcShare: API-ключ"), default="", on_change=self._invalidate),
                Input(key="lrcred_client", text="lrc.red: Client ID", default="", on_change=self._invalidate,
                      subtext=_t("Название приложения, HTTPS-ссылка и контактный email.")),
                Input(key="lyricsplus_url", text=_t("Сервер LyricsPlus"), default="", on_change=self._invalidate,
                      subtext=_t("HTTPS-адрес без /v2/lyrics/get."))]

    def _sync_description(self):
        try:
            plugin = jclass("com.exteragram.messenger.plugins.PluginsController").getInstance().getPlugins().get(__id__)
            if plugin is not None:
                plugin.setDescription(_t(_DESCRIPTION))
        except Exception:
            pass

    def _language_changed(self, value=None, *_):
        global _language_choice
        _language_choice = _language_index(value if value is not None else self.get_setting("language", 0))
        self.set_setting("language", _language_choice, reload_settings=True)
        self._sync_description()
        self._refresh_quick_settings()
        def update_missing():
            for state in list(getattr(self, "_states", {}).values()):
                if self._state_current(state) and state.get("lyrics") is None and not state.get("searching"):
                    state["view"].setState(6, _t("Не удалось найти текст"), None, _t("Повторить"))
        run_on_ui_thread(update_missing)

    def create_settings(self):
        if getattr(self, "_active", False):
            status = _t("Плеер подключён. Пословный текст и эффекты доступны.") if getattr(self, "_word_methods", {}) else _t("Плеер подключён. Доступна синхронизация по строкам.")
        else:
            status = _t("Плеер не подключён. Подробности — в последних поисках.") if hasattr(self, "_compat") else _t("Плагин выключен.")
        enabled = sum(bool(self.get_setting("source_" + key, default)) for key, _, default in PROVIDERS)
        return [Divider(text=status),
                Selector(key="language", text="Язык", icon="msg_translate", default=0, items=["Системный", "Русский", "English"], on_change=self._language_changed),
                Header(text=_t("Плеер")),
                Switch(key="enabled", text=_t("Расширенный поиск"), default=True, on_change=self._invalidate,
                       subtext=_t("Находить больше вариантов текста.")),
                Switch(key="sync", text=_t("Синхронизация строк"), default=True, on_change=self._invalidate,
                       subtext=_t("Следовать исполнению по таймкодам.")),
                Switch(key="words", text=_t("Пословное караоке"), default=True, on_change=self._words_changed,
                       subtext=_t("Заполнять слова по их таймкодам.")),
                Divider(),
                Header(text=_t("Живой текст")),
                Switch(key="effects_enabled", text=_t("Эффекты текста"), default=False, on_change=self._effects_changed,
                       subtext=_t("Движение букв, переливы и искры.")),
                Selector(key="effects_style", text=_t("Эффект"), default=0, on_change=self._effects_changed, items=list(EFFECT_NAMES)),
                Selector(key="effects_strength", text=_t("Интенсивность"), default=1, on_change=self._effects_changed, items=list(STRENGTH_NAMES)),
                Selector(key="transition_mode", text=_t("Плавность переходов"), default=2, on_change=self._effects_changed, items=list(TRANSITION_NAMES)),
                Selector(key="transition_lead", text=_t("Упреждение перехода"), default=2, on_change=self._effects_changed, items=list(LEAD_NAMES)),
                Divider(text=_t("Упреждение начинает движение к следующей строке чуть раньше. Таймкоды слов и заливка не сдвигаются.")),
                Divider(text=_t("Эффекты работают с синхронизированным текстом. Для реакции на музыку включите ритм в настройках плеера.")),
                Header(text=_t("Поиск")),
                Text(text=_t("Источники текстов"), subtext=_t("Включено: %d из %d") % (enabled, len(PROVIDERS)), create_sub_fragment=self._source_settings),
                Text(text=_t("Как выбирать текст"), subtext=_t("Порядок выбора версии"), create_sub_fragment=self._matching_settings),
                Text(text=_t("Исправить имя для поиска"), subtext=_t("Заменить имя только для поиска."), on_click=self._show_artist_aliases),
                Text(text=_t("Доступ к сервисам"), subtext=_t("API-ключи и свой сервер"), create_sub_fragment=self._access_settings),
                Divider(),
                Header(text=_t("Диагностика")),
                Text(text=_t("Последние поиски"), subtext=_t("Результаты, источники и ошибки"), on_click=self._show_report),
                Text(text=_t("Очистить кэш"), subtext=_t("Ручной выбор сохранится."), on_click=self._clear_cache)]


WORD_RENDERER_DEX = ""
