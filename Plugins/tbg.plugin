__id__ = "tbg"
__name__ = "Chat Gradient/Blur Remover"
__description__ = "Убирает весь градиент/блюр в чате\nRemoves all gradient/blur in chat"
__author__ = "@ka1Plugins"
__version__ = "1.0"
__icon__ = "AnimatedEmojies/384"
__min_version__ = "12.9.0"

from base_plugin import BasePlugin, MethodHook
from hook_utils import find_class


class NoDrawHook(MethodHook):
    def before_hooked_method(self, param):
        param.setResult(None)


class BlurOffHook(MethodHook):
    def before_hooked_method(self, param):
        param.setResult(False)


class SetupGlassAfterHook(MethodHook):
    def after_hooked_method(self, param):
        try:
            obj = param.thisObject
            if obj is None:
                return
            clazz = obj.getClass()
            while clazz is not None and "ActionBar" in clazz.getName():
                for f in clazz.getDeclaredFields():
                    n = f.getName().lower()
                    if "blur" not in n and "glass" not in n:
                        continue
                    try:
                        f.setAccessible(True)
                        v = f.get(obj)
                        if v is not None and hasattr(v, "setAlpha"):
                            v.setAlpha(0)
                    except Exception:
                        pass
                clazz = clazz.getSuperclass()
        except Exception:
            pass


class ChatGradientBlurRemoverPlugin(BasePlugin):

    def on_plugin_load(self):
        self._unhooks = []
        try:
            self._hook(
                "org.telegram.messenger.SharedConfig",
                "chatBlurEnabled", BlurOffHook(),
            )
            self._hook(
                "org.telegram.ui.Components.chat.layouts.ChatActivityFadeView",
                "draw", NoDrawHook(),
            )
            self._hook(
                "org.telegram.ui.Components.chat.layouts.ChatActivityFadeView",
                "onDraw", NoDrawHook(),
            )
            self._hook(
                "org.telegram.ui.ActionBar.ActionBar",
                "setupGlass", SetupGlassAfterHook(),
            )
            self._hook(
                "org.telegram.ui.Components.blur3.drawable.BlurredBackgroundDrawable",
                "draw", NoDrawHook(),
            )
        except Exception as e:
            self.log(f"Load error: {e}")

    def on_plugin_unload(self):
        for u in getattr(self, "_unhooks", []):
            try:
                self.unhook_method(u)
            except Exception:
                pass
        self._unhooks = []

    def _hook(self, class_name, method_name, hook):
        cls = find_class(class_name)
        if not cls:
            return
        for m in cls.getClass().getDeclaredMethods():
            if m.getName() == method_name:
                try:
                    m.setAccessible(True)
                    self._unhooks.append(self.hook_method(m, hook))
                except Exception:
                    pass