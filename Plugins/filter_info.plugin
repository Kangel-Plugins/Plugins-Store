__id__ = "filter_info"
__name__ = "Filter Info"
__description__ = "Кнопка «Что отфильтровано» в меню отфильтрованных сообщений: показывает, какие фильтры AyuGram (regex, общие и по чатам) сработали."
__author__ = "@etodsk & Claude"
__version__ = "1.3"
__icon__ = "vdyrky/12"
__min_version__ = "12.10.6"
__app_version__ = ">=12.10.6"
__sdk_version__ = ">=1.4.3.3"

import re
import time
from typing import Any, Dict

from java import jclass
from java.lang import Class as JClass
from java.util.regex import Pattern
from android.database.sqlite import SQLiteDatabase

from org.telegram.messenger import ApplicationLoader
from base_plugin import BasePlugin, MenuItemData, MenuItemType, MethodHook
from ui.alert import AlertDialogBuilder
from ui.bulletin import BulletinHelper
from android_utils import log
from client_utils import get_last_fragment

FLAG_KEY = "fi_hit"
# пункт показывается только у сообщений, помеченных хуком (см. _mark_message)
MSG_CONDITION = (
    'message != null && message.messageOwner != null && '
    'message.messageOwner.params != null && '
    'message.messageOwner.params.containsKey("fi_hit")'
)
CACHE_TTL = 15  # сек: как часто перечитывать базу фильтров

MAX_SHOWN = 15
_db_cache = {"path": None}
_data_cache = {"t": 0.0, "data": None}
_pat_cache = {}


# ───────────────────────── чтение БД AyuGram ─────────────────────────

def _list_candidate_files(ctx):
    dirs = []
    try:
        dirs.append(ctx.getDatabasePath("x").getParentFile())
    except Exception:
        pass
    try:
        fd = ctx.getFilesDir()
        dirs.append(fd)
        dirs.append(fd.getParentFile())
    except Exception:
        pass
    out, seen = [], set()
    for d in dirs:
        if d is None:
            continue
        try:
            fs = d.listFiles()
        except Exception:
            fs = None
        if fs is None:
            continue
        for i in range(len(fs)):
            f = fs[i]
            try:
                if not f.isFile() or f.length() < 4096:
                    continue
                name = str(f.getName())
                if name.endswith(("-wal", "-shm", "-journal")):
                    continue
                path = str(f.getAbsolutePath())
                if path in seen:
                    continue
                seen.add(path)
                with open(path, "rb") as fh:
                    if fh.read(15) != b"SQLite format 3":
                        continue
                out.append(path)
            except Exception:
                pass
    return out


def _open(path):
    return SQLiteDatabase.openDatabase(path, None, SQLiteDatabase.OPEN_READONLY)


def _tables(db):
    res = {}
    c = db.rawQuery("SELECT name FROM sqlite_master WHERE type='table'", None)
    try:
        while c.moveToNext():
            n = str(c.getString(0))
            res[n.lower()] = n
    finally:
        c.close()
    return res


def _rows(db, table):
    rows = []
    c = db.rawQuery('SELECT * FROM "' + table + '"', None)
    try:
        names = [str(x) for x in c.getColumnNames()]
        while c.moveToNext():
            r = {}
            for i, n in enumerate(names):
                t = c.getType(i)
                if t == 0:
                    r[n] = None
                elif t == 1:
                    r[n] = int(c.getLong(i))
                elif t == 2:
                    r[n] = float(c.getDouble(i))
                elif t == 3:
                    r[n] = str(c.getString(i))
                else:
                    r[n] = None
            rows.append(r)
    finally:
        c.close()
    return rows


def _find_db():
    ctx = ApplicationLoader.applicationContext
    if ctx is None:
        return None
    paths = []
    if _db_cache["path"]:
        paths.append(_db_cache["path"])
    paths += [p for p in _list_candidate_files(ctx) if p not in paths]
    for p in paths:
        try:
            db = _open(p)
            try:
                if "regexfilter" in _tables(db):
                    _db_cache["path"] = p
                    return p
            finally:
                db.close()
        except Exception:
            pass
    return None


def load_data():
    """Возвращает dict(filters, exclusions, shadow, path) или None."""
    path = _find_db()
    if not path:
        return None
    db = _open(path)
    try:
        tb = _tables(db)
        data = {
            "path": path,
            "filters": _rows(db, tb["regexfilter"]),
            "exclusions": [],
            "shadow": [],
        }
        for low, real in tb.items():
            if "exclusion" in low:
                data["exclusions"] += _rows(db, real)
            elif "shadow" in low:
                data["shadow"] += _rows(db, real)
        return data
    finally:
        db.close()


# ───────────────────────── матчинг ─────────────────────────

def _pick(row, names, default=None):
    low = {k.lower(): k for k in row.keys()}
    for n in names:
        if n.lower() in low:
            return row[low[n.lower()]]
    return default


def _truthy(v, default=True):
    if v is None:
        return default
    return bool(v)


def _norm_dialog(d):
    try:
        return int(d)
    except Exception:
        return None


def _compile(pat, flags):
    k = (pat, flags)
    p = _pat_cache.get(k)
    if p is None:
        p = Pattern.compile(pat, flags)
        _pat_cache[k] = p
    return p


def get_data():
    now = time.time()
    if now - _data_cache["t"] > CACHE_TTL:
        try:
            _data_cache["data"] = load_data()
        except Exception as e:
            log("FilterInfo load: " + str(e))
            _data_cache["data"] = None
        _data_cache["t"] = now
    return _data_cache["data"]


def match_filters(data, dialog_id, text, urls=""):
    """-> (matched, excluded_matched, applicable_count)"""
    matched, excluded = [], []
    applicable = 0

    excl_ids, excl_all = set(), False
    for r in data["exclusions"]:
        d = _norm_dialog(_pick(r, ["dialogId", "dialog_id"]))
        if d != dialog_id:
            continue
        fid = _pick(r, ["filterId", "filter_id", "regexFilterId"])
        if fid is None:
            excl_all = True
        else:
            excl_ids.add(fid)

    for f in data["filters"]:
        if not _truthy(_pick(f, ["enabled", "isEnabled"]), True):
            continue
        f_dialog = _norm_dialog(_pick(f, ["dialogId", "dialog_id"]))
        is_shared = f_dialog in (None, 0)
        if not is_shared and f_dialog != dialog_id:
            continue
        pat = _pick(f, ["text", "regex", "pattern", "filter"])
        if not pat:
            continue
        applicable += 1
        flags = Pattern.CASE_INSENSITIVE if _truthy(_pick(f, ["caseInsensitive", "case_insensitive"]), False) else 0
        reversed_ = _truthy(_pick(f, ["reversed", "isReversed", "inverted"]), False)
        try:
            p = _compile(str(pat), flags)
            in_text = bool(p.matcher(text).find())
            in_urls = bool(urls) and bool(p.matcher(urls).find())
        except Exception:
            continue
        found = in_text or in_urls
        if found == reversed_:
            continue
        item = {"pattern": str(pat), "shared": is_shared, "reversed": reversed_,
                "icase": bool(flags),
                "where": "в тексте" if in_text else "в ссылке/кнопке"}
        fid = _pick(f, ["id", "_id"])
        if is_shared and (excl_all or (fid is not None and fid in excl_ids)):
            excluded.append(item)
        else:
            matched.append(item)
    return matched, excluded, applicable


def shadow_banned(data, sender_id):
    if not sender_id:
        return False
    for r in data["shadow"]:
        for k, v in r.items():
            if k.lower() in ("userid", "user_id", "dialogid", "dialog_id", "fromid", "from_id"):
                try:
                    if abs(int(v)) == abs(int(sender_id)):
                        return True
                except Exception:
                    pass
    return False


# ───────────────────────── UI ─────────────────────────

def _msg_text(msg):
    try:
        if msg.messageOwner is not None and msg.messageOwner.message is not None:
            return str(msg.messageOwner.message)
    except Exception:
        pass
    return ""


def _sender_id(msg):
    try:
        v = int(msg.getFromChatId())
        if v > 0:
            return v
    except Exception:
        pass
    try:
        fid = msg.messageOwner.from_id
        return int(getattr(fid, "user_id", 0) or 0)
    except Exception:
        return 0


def _haystack(msg):
    """Текст, который AyuGram отдаёт фильтрам:
    текст/подпись, затем <button>…</button> на каждую кнопку, затем <type>N</type>."""
    parts = [_msg_text(msg)]
    btns = []
    try:
        rm = msg.messageOwner.reply_markup
        rows = rm.rows if rm is not None else None
        if rows is not None:
            for i in range(rows.size()):
                bl = rows.get(i).buttons
                for j in range(bl.size()):
                    b = bl.get(j)
                    t = str(getattr(b, "text", "") or "")
                    u = getattr(b, "url", None)
                    btns.append("<button>" + t + "</button>" + ((" " + str(u)) if u else ""))
    except Exception:
        pass
    if btns:
        parts.append("\n".join(btns))
    try:
        t = int(msg.type)
    except Exception:
        t = 0
    parts.append("<type>" + str(t) + "</type>")
    return "\n\n".join(parts)


def _collect_urls(msg):
    """URL из скрытых ссылок (entities), кнопок под постом и превью."""
    out = []
    try:
        o = msg.messageOwner
    except Exception:
        return out
    try:
        ents = o.entities
        if ents is not None:
            for i in range(ents.size()):
                u = getattr(ents.get(i), "url", None)
                if u:
                    out.append(str(u))
    except Exception:
        pass
    try:
        rm = o.reply_markup
        rows = rm.rows if rm is not None else None
        if rows is not None:
            for i in range(rows.size()):
                btns = rows.get(i).buttons
                for j in range(btns.size()):
                    u = getattr(btns.get(j), "url", None)
                    if u:
                        out.append(str(u))
    except Exception:
        pass
    try:
        wp = getattr(o.media, "webpage", None)
        u = getattr(wp, "url", None)
        if u:
            out.append(str(u))
    except Exception:
        pass
    return out


def _blocked_info(msg):
    """Отправитель / автор пересылки в чёрном списке Telegram."""
    res = []
    try:
        from org.telegram.messenger import MessagesController, UserConfig
        bp = MessagesController.getInstance(UserConfig.selectedAccount).blockePeers
        cands = []
        sid = _sender_id(msg)
        if sid:
            cands.append(("Отправитель", sid))
        try:
            fid = msg.messageOwner.fwd_from.from_id
            fu = int(getattr(fid, "user_id", 0) or 0)
            if fu:
                cands.append(("Автор пересланного", fu))
        except Exception:
            pass
        for label, uid in cands:
            if bp.indexOfKey(int(uid)) >= 0:
                res.append(label + " в чёрном списке (ЧС)")
    except Exception as e:
        log("FilterInfo blocked: " + str(e))
    return res


TYPE_NAMES = {
    0: "текст", 1: "фото", 2: "голосовое", 3: "видео", 4: "геопозиция",
    5: "кружок", 6: "загрузка", 8: "гифка", 9: "файл", 10: "дата",
    11: "смена фото чата", 12: "контакт", 13: "стикер", 14: "музыка",
    15: "анимированный стикер", 16: "звонок", 17: "опрос", 18: "подарок Premium",
    19: "эмодзи", 20: "превью платного медиа", 21: "предложенное фото",
    22: "обои чата", 23: "история", 24: "упоминание в истории",
    25: "подарок Premium (канал)", 26: "розыгрыш", 27: "рекомендации каналов",
    28: "итоги розыгрыша", 1000: "служебное/неизвестно",
}
_TYPE_RE = re.compile(r"<type>\s*\(?(\d+(?:\|\d+)*)\)?\s*</type>")


def _type_label(n):
    return "%s — %s" % (n, TYPE_NAMES.get(int(n), "неизвестный тип"))


def _fmt(item):
    tags = []
    if item["reversed"]:
        tags.append("инверсия")
    if item["icase"]:
        tags.append("без регистра")
    s = "• " + item["pattern"]
    m = _TYPE_RE.search(item["pattern"])
    if m:
        tags.append("тип: " + ", ".join(_type_label(x) for x in m.group(1).split("|")))
    if item.get("where"):
        tags.append(item["where"])
    if tags:
        s += "  (" + ", ".join(tags) + ")"
    return s


def _show(frag, title, message):
    parent = frag.getParentActivity() if frag else None
    if parent is None:
        BulletinHelper.show_info(message[:120])
        return
    b = AlertDialogBuilder(parent)
    b.set_title(title)
    b.set_message(message)
    b.set_positive_button("OK", lambda d, w: d.dismiss())
    b.show()


def _mark_message(mo):
    """Ставит/снимает флаг fi_hit в messageOwner.params, по нему работает condition меню."""
    try:
        owner = mo.messageOwner
        if owner is None:
            return
        hit = False
        data = get_data()
        if data is not None:
            urls = "\n".join(_collect_urls(mo))
            matched, _ex, _n = match_filters(data, int(mo.getDialogId()), _haystack(mo), urls)
            hit = bool(matched) or shadow_banned(data, _sender_id(mo))
        if not hit and _blocked_info(mo):
            hit = True
        params = owner.params
        if hit:
            if params is None:
                owner.params = jclass("java.util.HashMap")()
                params = owner.params
            params.put(FLAG_KEY, "1")
        elif params is not None:
            params.remove(FLAG_KEY)
    except Exception as e:
        log("FilterInfo mark: " + str(e))


class MarkHook(MethodHook):
    def after_hooked_method(self, param):
        try:
            mo = param.args[0]
            if mo is not None:
                _mark_message(mo)
        except Exception as e:
            log("FilterInfo hook: " + str(e))


class FilterInfoPlugin(BasePlugin):

    def on_plugin_load(self):
        hooked = False
        try:
            cell_cls = JClass.forName("org.telegram.ui.Cells.ChatMessageCell")
            for m in cell_cls.getDeclaredMethods():
                if str(m.getName()) == "setMessageContent":
                    try:
                        self.hook_method(m, MarkHook())
                        hooked = True
                    except Exception:
                        pass
        except Exception as e:
            log("FilterInfo setup: " + str(e))

        item = dict(
            menu_type=MenuItemType.MESSAGE_CONTEXT_MENU,
            text="Что отфильтровано",
            icon="msg_filter",
            item_id="filter_info_btn",
            on_click=self._on_click,
        )
        try:
            if hooked:
                self.add_menu_item(MenuItemData(condition=MSG_CONDITION, **item))
            else:
                self.add_menu_item(MenuItemData(**item))
        except TypeError:
            self.add_menu_item(MenuItemData(**item))

    def _on_click(self, ctx: Dict[str, Any]):
        frag = ctx.get("fragment") or get_last_fragment()
        msg = ctx.get("message")
        if msg is None:
            return
        try:
            text = _haystack(msg)
            did = ctx.get("dialog_id")
            if not did:
                did = msg.getDialogId()
            did = int(did)

            _data_cache["t"] = 0.0  # свежие фильтры
            data = get_data()
            if data is None:
                _show(frag, "Что отфильтровано", "Не нашёл базу фильтров AyuGram.")
                return

            urls = _collect_urls(msg)
            matched, excluded, applicable = match_filters(data, did, text, "\n".join(urls))
            parts = []
            for b in _blocked_info(msg):
                parts.append(b + ". При включённой настройке «Скрывать от пользователей в ЧС» "
                             "сообщение скрывается из-за этого.")
                parts.append("")
            if matched:
                parts.append("Сработали фильтры (%d):" % len(matched))
                parts += [_fmt(x) + ("  [общий]" if x["shared"] else "  [этот чат]")
                          for x in matched[:MAX_SHOWN]]
                if len(matched) > MAX_SHOWN:
                    parts.append("… и ещё %d" % (len(matched) - MAX_SHOWN))
            if excluded:
                parts.append("")
                parts.append("Подходят, но исключены в этом чате (%d):" % len(excluded))
                parts += [_fmt(x) for x in excluded[:MAX_SHOWN]]
            if any("<type>" in x["pattern"] for x in matched + excluded):
                try:
                    parts.append("")
                    parts.append("Тип этого сообщения: " + _type_label(int(msg.type)))
                except Exception:
                    pass
            if shadow_banned(data, _sender_id(msg)):
                parts.append("")
                parts.append("Отправитель в списке «Теневой бан».")
            if not parts:
                parts.append("Сейчас ни один фильтр не подходит к этому сообщению.")
                parts.append("Проверено фильтров: %d, ссылок/кнопок: %d" % (applicable, len(urls)))
            _show(frag, "Что отфильтровано", "\n".join(parts))
        except Exception as e:
            log("FilterInfo click: " + str(e))
            BulletinHelper.show_error("Ошибка: " + str(e)[:100])
