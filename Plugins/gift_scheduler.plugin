TICK_SECONDS = 15
RETRY_DELAY = 30
ALARM_REQUEST_CODE = 7731
TL_CONTAINERS = (
    "org.telegram.tgnet.TLRPC$",
    "org.telegram.tgnet.tl.TL_stars$",
    "org.telegram.tgnet.tl.TL_payments$",
    "org.telegram.tgnet.tl.TL_account$",
)
BOTTOM_SHEET_CLASS = "org.telegram.ui.ActionBar.BottomSheet"
HIDE_NAME_TEXTS = ("скрыть моё имя", "скрыть мое имя", "hide my name")
CATALOG_TTL = 600
STATUS_ICONS = {"pending": "⏳", "sending": "📤", "sent": "✅", "failed": "❌", "missed": "⚠️"}
SELF_WORDS = ("me", "self", "я", "мне", "себе")
_USERNAME_RE = re.compile(r"[A-Za-z][A-Za-z0-9_]{3,31}")
_REL_RE = re.compile(
    r"^(?:через\s+|in\s+|\+)\s*(\d{1,4})\s*(м|мин|минут\w*|m|min\w*|ч|час\w*|h|hour\w*|д|дн\w*|день|d|day\w*)\.?$",
    re.IGNORECASE,
)
_TIME_RE = re.compile(r"(\d{1,2}):(\d{2})")
_DATE_RE = re.compile(r"(\d{1,2})\.(\d{1,2})(?:\.(\d{2,4}))?")


# ---------------------------------------------------------------------- чистые функции

def parse_recipient(text: Any) -> Optional[dict]:
    """«@name», «t.me/name», «123456», «tg://user?id=1», «я» -> {"kind": ..., ...} или None."""
    raw = str(text or "").strip()
    if not raw:
        return None
    if raw.lower() in SELF_WORDS:
        return {"kind": "self"}
    match = re.search(r"tg://user\?id=(\d+)", raw, re.IGNORECASE)
    if match:
        return {"kind": "id", "id": int(match.group(1))}
    raw = re.sub(r"^(https?://)?(www\.)?(t|telegram)\.me/", "", raw, flags=re.IGNORECASE)
    raw = raw.split("?")[0].split("/")[0].strip().lstrip("@")
    if re.fullmatch(r"\d{1,15}", raw):
        return {"kind": "id", "id": int(raw)}
    if _USERNAME_RE.fullmatch(raw):
        return {"kind": "username", "username": raw}
    return None


def parse_when(text: Any, now: Optional[datetime] = None) -> Optional[datetime]:
    """Время отправки по местному времени устройства.

    «25.12 18:00», «25.12.2026 18:00», «18:30» (сегодня или завтра), «завтра 09:00»,
    «сегодня 21:15», «через 90 мин», «+2ч», «+1д».
    """
    raw = str(text or "").strip().lower()
    now = now or datetime.now()
    if not raw:
        return None

    rel = _REL_RE.match(raw)
    if rel:
        amount = int(rel.group(1))
        unit = rel.group(2)[0]
        if unit in "мm":
            delta = timedelta(minutes=amount)
        elif unit in "чh":
            delta = timedelta(hours=amount)
        else:
            delta = timedelta(days=amount)
        return (now + delta).replace(second=0, microsecond=0)

    tm = _TIME_RE.search(raw)
    if not tm:
        return None
    hour, minute = int(tm.group(1)), int(tm.group(2))
    if hour > 23 or minute > 59:
        return None
    rest = (raw[:tm.start()] + " " + raw[tm.end():]).strip()

    try:
        if rest in ("", "сегодня", "today"):
            when = now.replace(hour=hour, minute=minute, second=0, microsecond=0)
            if rest == "" and when <= now:
                when += timedelta(days=1)
            return when
        if rest in ("завтра", "tomorrow"):
            day = now + timedelta(days=1)
            return day.replace(hour=hour, minute=minute, second=0, microsecond=0)
        if rest in ("послезавтра",):
            day = now + timedelta(days=2)
            return day.replace(hour=hour, minute=minute, second=0, microsecond=0)
        dm = _DATE_RE.fullmatch(rest)
        if dm:
            day, month = int(dm.group(1)), int(dm.group(2))
            year_text = dm.group(3)
            if year_text:
                year = int(year_text)
                if year < 100:
                    year += 2000
                return datetime(year, month, day, hour, minute)
            when = datetime(now.year, month, day, hour, minute)
            if when <= now:
                when = datetime(now.year + 1, month, day, hour, minute)
            return when
    except ValueError:
        return None
    return None


def fmt_when(ts: float) -> str:
    when = datetime.fromtimestamp(ts)
    fmt = "%d.%m %H:%M" if when.year == datetime.now().year else "%d.%m.%Y %H:%M"
    return when.strftime(fmt)


def is_retryable(error) -> bool:
    """Сетевой сбой, после которого можно безопасно повторить (до оплаты)."""
    text = str(getattr(error, "text", "") or "")
    try:
        code = int(getattr(error, "code", 0) or 0)
    except Exception:
        code = 0
    if code in (-1, -2000, -3000, 500) or code <= -1000:
        return True
    return text == "" or any(k in text.upper() for k in ("TIMEOUT", "CONNECTION", "NETWORK", "INTERNAL", "SERVER_ERROR"))


def friendly_error(text: str) -> str:
    """Код ошибки Telegram -> понятная подпись."""
    text = str(text or "")
    table = (
        ("BALANCE_TOO_LOW", "не хватает звёзд на балансе"),
        ("STARGIFT_USAGE_LIMITED", "подарок закончился"),
        ("STARGIFT_INVALID", "такого подарка больше нет"),
        ("USER_PRIVACY", "получатель не принимает подарки"),
        ("PEER_ID_INVALID", "получатель недоступен (нужен @username или человек, которого клиент видел)"),
        ("USER_ID_INVALID", "получатель недоступен (нужен @username или человек, которого клиент видел)"),
        ("FLOOD", "Telegram просит подождать: слишком много запросов"),
        ("MESSAGE_TOO_LONG", "слишком длинная подпись"),
        ("FORM_EXPIRED", "форма оплаты устарела"),
        ("PAYMENT_FAILED", "оплата не прошла"),
    )
    for code, human in table:
        if code in text:
            return human
    return text or "неизвестная ошибка"


def _cls_name(obj) -> str:
    try:
        return str(obj.getClass().getName())
    except Exception:
        return type(obj).__name__


