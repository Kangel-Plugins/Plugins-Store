import threading
import time
import weakref

from android_utils import run_on_ui_thread
from base_plugin import BasePlugin, MethodHook
from hook_utils import find_class, get_private_field
from java import dynamic_proxy, jfloat, jint

# Hello!

__id__ = "screen_time_pill"
__name__ = "Screen Time"
__description__ = "Показывает общее экранное время в таблетке(Pill Stack)"
__author__ = "@XPlugins_hub"
__version__ = "1.0R"
__icon__ = "XPlugin_etg/1"
__min_version__ = "13.1.1"
__category__ = ["tools"]

SCREEN_TIME_PILL_ID = 1587
TAG_KEY = jint(0x5354494D)
GRAY_PILL_COLOR = jint(-13215687)
WHITE_COLOR = jint(-1)
CLOCK_ICONS = ("msg_recent", "msg_emoji_recent", "msg_autodelete", "msg_schedule", "msg_timer")


class ScreenTimePillPlugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self.active_pills = weakref.WeakSet()
        self._hooks = []
        self._stop_event = threading.Event()
        self._lock = threading.Lock()
        self._icon_res = 0
        self._seconds = 0.0
        self._last_rendered = ""

    def _resolve_icon(self) -> int:
        try:
            ctx = self.ApplicationLoader.applicationContext
            res = ctx.getResources()
            pkg = ctx.getPackageName()
            for name in CLOCK_ICONS:
                res_id = res.getIdentifier(name, "drawable", pkg)
                if res_id != 0:
                    return int(res_id)
        except Exception as e:
            self.log(f"icon resolve error: {e}")
        return 0

    def _make_capsule_drawable(self):
        try:
            GradientDrawable = find_class("android.graphics.drawable.GradientDrawable")
            if not GradientDrawable:
                return None
            gd = GradientDrawable()
            gd.setShape(jint(0))
            gd.setColor(GRAY_PILL_COLOR)
            gd.setCornerRadius(jfloat(999.0))
            return gd
        except Exception as e:
            self.log(f"drawable error: {e}")
            return None

    def _apply_capsule_style(self, pill):
        if not pill:
            return
        try:
            gd = self._make_capsule_drawable()
            if gd is not None:
                pill.setBackground(gd)
            pill.setClipToOutline(True)
        except Exception as e:
            self.log(f"style error: {e}")

    def _save_state(self):
        try:
            self.set_setting("saved_seconds", int(self._seconds))
        except Exception as e:
            self.log(f"state save error: {e}")

    def _is_foreground(self) -> bool:
        try:
            paused = getattr(self.ApplicationLoader, "mainInterfacePaused", None)
            if paused is not None:
                return not bool(paused)
        except Exception:
            pass
        return True

    def _format_time(self) -> str:
        total_minutes = int(self._seconds) // 60
        return f"{total_minutes // 60}h{total_minutes % 60}min"

    def _register_hook(self, result):
        if isinstance(result, (list, tuple, set)):
            self._hooks.extend(result)
        elif result:
            self._hooks.append(result)

    def _start_tracker(self):
        self._stop_event.clear()

        def loop():
            last_mono = time.monotonic()
            save_acc = 0.0
            while not self._stop_event.wait(1.0):
                now_mono = time.monotonic()
                delta = now_mono - last_mono
                last_mono = now_mono
                if delta <= 0 or delta > 10:
                    continue

                changed = False
                with self._lock:
                    if self._is_foreground():
                        self._seconds += delta
                        save_acc += delta
                        if save_acc >= 30.0:
                            save_acc = 0.0
                            self._save_state()
                    text = self._format_time()
                    if text != self._last_rendered:
                        self._last_rendered = text
                        changed = True
                if changed:
                    run_on_ui_thread(self._refresh_all_pills)

        threading.Thread(target=loop, daemon=True).start()

    def _refresh_all_pills(self):
        for pill in list(self.active_pills):
            self.update_ui(pill)

    def reset_counter(self):
        with self._lock:
            self._seconds = 0.0
            self._last_rendered = self._format_time()
            self._save_state()
        run_on_ui_thread(self._refresh_all_pills)

    def on_plugin_load(self):
        self.PillRegistry = find_class("com.exteragram.messenger.pillstack.core.PillRegistry")
        self.PillInfo = find_class("com.exteragram.messenger.pillstack.core.PillRegistry$PillInfo")
        self.PillCreator = find_class("com.exteragram.messenger.pillstack.core.PillRegistry$PillCreator")
        self.PillStackConfig = find_class("com.exteragram.messenger.pillstack.core.PillStackConfig")
        self.WeatherPill = find_class("com.exteragram.messenger.pillstack.ui.pills.weather.WeatherPill")
        self.ApplicationLoader = find_class("org.telegram.messenger.ApplicationLoader")
        self.LaunchActivity = find_class("org.telegram.ui.LaunchActivity")
        self.ItemOptions = find_class("org.telegram.ui.Components.ItemOptions")
        self.Runnable = find_class("java.lang.Runnable")
        self.PillStackPreferencesActivity = find_class("com.exteragram.messenger.pillstack.ui.PillStackPreferencesActivity")

        if not self.PillRegistry or not self.PillInfo or not self.WeatherPill:
            return

        self._seconds = float(max(0, int(self.get_setting("saved_seconds", 0))))
        self._last_rendered = self._format_time()
        self._icon_res = self._resolve_icon()
        plugin_ref = self

        class ScreenTimeCreator(dynamic_proxy(self.PillCreator)):
            def create(self, context, resourcesProvider):
                try:
                    pill = plugin_ref.WeatherPill(context, resourcesProvider)
                    pill.setTag(TAG_KEY, jint(SCREEN_TIME_PILL_ID))
                    plugin_ref._apply_capsule_style(pill)
                    plugin_ref.active_pills.add(pill)
                    run_on_ui_thread(lambda: plugin_ref.update_ui(pill))
                    return pill
                except Exception as e:
                    plugin_ref.log(f"create pill error: {e}")
                    return None

        class GetIdHook(MethodHook):
            def before_hooked_method(self, param):
                tag = param.thisObject.getTag(TAG_KEY)
                if tag is not None and int(tag) == SCREEN_TIME_PILL_ID:
                    plugin_ref.active_pills.add(param.thisObject)
                    param.setResult(jint(SCREEN_TIME_PILL_ID))

        class InteractionHook(MethodHook):
            def before_hooked_method(self, param):
                tag = param.thisObject.getTag(TAG_KEY)
                if tag is None or int(tag) != SCREEN_TIME_PILL_ID:
                    return
                name = param.method.getName()
                if name == "onPillClicked":
                    plugin_ref.update_ui(param.thisObject)
                    param.setResult(None)
                elif name == "onPillLongClicked":
                    plugin_ref.show_pill_menu(param.thisObject)
                    param.setResult(True)
                elif name in ("onUpdateData", "setData"):
                    param.setResult(None)

        class DrawGuardHook(MethodHook):
            def before_hooked_method(self, param):
                tag = param.thisObject.getTag(TAG_KEY)
                if tag is None or int(tag) != SCREEN_TIME_PILL_ID:
                    return
                plugin_ref._apply_capsule_style(param.thisObject)

        try:
            pill_info = self.PillInfo(
                jint(SCREEN_TIME_PILL_ID),
                "Screen Time",
                jint(self._icon_res),
                GRAY_PILL_COLOR,
                GRAY_PILL_COLOR,
                ScreenTimeCreator(),
            )
            self.PillRegistry.register(pill_info)

            get_id_hook = GetIdHook()
            interaction_hook = InteractionHook()
            draw_guard_hook = DrawGuardHook()
            for method_name, hook in (
                ("getPillId", get_id_hook),
                ("onPillClicked", interaction_hook),
                ("onPillLongClicked", interaction_hook),
                ("onUpdateData", interaction_hook),
                ("setData", interaction_hook),
                ("onDraw", draw_guard_hook),
            ):
                self._register_hook(self.hook_all_methods(self.WeatherPill, method_name, hook))

            if self.PillStackConfig:
                active = self.PillStackConfig.activePills
                if not any(int(active.get(i)) == SCREEN_TIME_PILL_ID for i in range(active.size())):
                    active.add(jint(SCREEN_TIME_PILL_ID))
                    self.PillStackConfig.savePillsLayout()
                    run_on_ui_thread(self.PillStackConfig.notifySettingsChanged)

            self._start_tracker()
        except Exception as e:
            self.log(f"register error: {e}")

    def on_plugin_unload(self):
        self._stop_event.set()
        with self._lock:
            self._save_state()
        for hook in self._hooks:
            try:
                hook.unhook() if hasattr(hook, "unhook") else self.unhook_method(hook)
            except Exception as e:
                self.log(f"unhook error: {e}")
        self._hooks.clear()
        self.active_pills.clear()
        if self.PillRegistry and hasattr(self.PillRegistry, "unregister"):
            try:
                self.PillRegistry.unregister(jint(SCREEN_TIME_PILL_ID))
            except Exception:
                pass

    def update_ui(self, pill):
        if not pill:
            return
        try:
            with self._lock:
                text = self._format_time()
            self._apply_capsule_style(pill)
            tv = get_private_field(pill, "textView")
            if tv:
                tv.setText(text)
                tv.setTextColor(WHITE_COLOR)
            iv = get_private_field(pill, "iconView")
            if iv:
                if self._icon_res != 0:
                    iv.setImageResource(jint(self._icon_res))
                iv.setColorFilter(WHITE_COLOR)
            pill.invalidate()
        except Exception as e:
            self.log(f"update ui error: {e}")

    def show_pill_menu(self, pill):
        try:
            if not self.LaunchActivity or not self.ItemOptions or not self.Runnable:
                return
            fragment = self.LaunchActivity.getSafeLastFragment()
            if not fragment:
                return

            ctx = self.ApplicationLoader.applicationContext
            res = ctx.getResources()
            pkg = ctx.getPackageName()
            options = self.ItemOptions.makeOptions(fragment, pill)
            plugin_ref = self

            class ActionRunnable(dynamic_proxy(self.Runnable)):
                def __init__(self, fn):
                    super().__init__()
                    self._fn = fn

                def run(self):
                    try:
                        self._fn()
                    except Exception as e:
                        plugin_ref.log(f"menu action error: {e}")

            def open_pill_settings():
                last = plugin_ref.LaunchActivity.getSafeLastFragment()
                if last and plugin_ref.PillStackPreferencesActivity:
                    last.presentFragment(plugin_ref.PillStackPreferencesActivity())

            options.add(jint(res.getIdentifier("msg_retry", "drawable", pkg)), "Обновить", ActionRunnable(lambda: self.update_ui(pill)))
            options.add(jint(res.getIdentifier("msg_delete", "drawable", pkg)), "Сбросить счётчик", ActionRunnable(self.reset_counter))
            options.addGap()
            options.add(jint(res.getIdentifier("msg_settings", "drawable", pkg)), "Настройки Pill Stack", ActionRunnable(open_pill_settings))
            options.setDrawScrim(False).setDimAlpha(jint(0)).show()
        except Exception as e:
            self.log(f"menu error: {e}")