from base_plugin import BasePlugin, MethodHook
from hook_utils import find_class
from android_utils import log
from ui.settings import Header, Switch, Selector
from java import jclass, dynamic_proxy
from typing import Any, List

__id__ = "fake_motion_blur"
__name__ = "fake motion blur"
__description__ = "направленный motion blur при скролле во всех списках (gpu renderEffect, android 12+)"
__author__ = "sixth"
__version__ = "3.0.1"
__icon__ = "msg_photo_settings"
__min_version__ = "12.5.1"
__app_version__ = ">=12.5.1"

# чувак строки ниже не для слабых

STRENGTHS = [(0.25, 12.0), (0.45, 24.0), (0.75, 45.0)]
RESET_DELAY = 150  # мс без скролла, блюр снимается сам

# кстати mb_fx что уже в канале просто гомно, не робит на 12.5.1 и сам по себе с другой реализацией

_v = {}  # hash(view) -> [vx, vy, view, reset]
_fx = {}

# edited in виво docs знак качества

def _clear(rv):
    _v.pop(rv.hashCode(), None)
    rv.setRenderEffect(None)

# хукает токо скролл, предложения по хуку анимашек принимаются

class Reset(dynamic_proxy(jclass("java.lang.Runnable"))):
    def __init__(self, rv):
        super().__init__()
        self.rv = rv

    def run(self):
        try:
            _clear(self.rv)
        except Exception as e:
            log("MotionBlur reset: " + str(e))

# клод поработал конечно но я держу пидра

class Plugin(BasePlugin):
    def create_settings(self) -> List[Any]:
        return [
            Header(text="Motion Blur"),
            Switch(key="enabled", text="Включить", default=True),
            Selector(key="strength", text="Сила", default=1,
                     items=["Слабая", "Средняя", "Сильная"]),
        ]

    def on_plugin_load(self):
        if int(jclass("android.os.Build$VERSION").SDK_INT) < 31:
            return
        _fx["re"] = jclass("android.graphics.RenderEffect")
        _fx["clamp"] = jclass("android.graphics.Shader$TileMode").CLAMP

# вроде без этого хуево
        rv_cls = find_class("androidx.recyclerview.widget.RecyclerView")
        plugin = self

        class ScrolledHook(MethodHook):
            def after_hooked_method(self, param):
                try:
                    if not plugin.get_setting("enabled", True):
                        return
                    rv = param.thisObject
                    k = rv.hashCode()
                    st = _v.get(k)
                    if st is None:
                        st = _v[k] = [0.0, 0.0, rv, Reset(rv)]
                    st[0] = st[0] * 0.5 + abs(float(param.args[0])) * 0.5
                    st[1] = st[1] * 0.5 + abs(float(param.args[1])) * 0.5
                    mult, cap = STRENGTHS[int(plugin.get_setting("strength", 1))]
                    rx = min(st[0] * mult, cap)
                    ry = min(st[1] * mult, cap)
                    rv.removeCallbacks(st[3])
                    if rx < 0.5 and ry < 0.5:
                        rv.setRenderEffect(None)
                    else:
                        rv.setRenderEffect(_fx["re"].createBlurEffect(rx, ry, _fx["clamp"]))
                        rv.postDelayed(st[3], RESET_DELAY)
                except Exception as e:
                    log("MotionBlur scrolled: " + str(e))

        class IdleHook(MethodHook):
            def after_hooked_method(self, param):
                try:
                    if int(param.args[0]) == 0:
                        _clear(param.thisObject)
                except Exception as e:
                    log("MotionBlur idle: " + str(e))

        class DetachHook(MethodHook):
            def after_hooked_method(self, param):
                try:
                    _clear(param.thisObject)
                except Exception as e:
                    log("MotionBlur detach: " + str(e))

        self.hook_all_methods(rv_cls, "dispatchOnScrolled", ScrolledHook())
        self.hook_all_methods(rv_cls, "dispatchOnScrollStateChanged", IdleHook())
        self.hook_all_methods(rv_cls, "onDetachedFromWindow", DetachHook())

    def on_plugin_unload(self):
        for st in list(_v.values()):
            try:
                st[2].removeCallbacks(st[3])
                _clear(st[2])
            except Exception as e:
                log("MotionBlur unload: " + str(e))
