]

# Некоторые реакции TG хранит без U+FE0F — Android рендерит серыми в TextView
EMOJI_DISPLAY = {
    "✍": "✍️", "☃": "☃️", "🕊": "🕊️", "❤": "❤️", "⚡": "⚡️",
}
EMOJI_API = {v: k for k, v in EMOJI_DISPLAY.items()}

def _emoji_for_display(e): return EMOJI_DISPLAY.get(e, e)
def _emoji_for_api(e): return EMOJI_API.get(e, e)

# ── UI-утилиты ────────────────────────────────────────────────────────────────

def _tc(key, fallback=-8355712):
    try:
        v = Theme.getColor(key)
        if isinstance(v, int) and v > 0x7FFFFFFF:
            v -= 0x100000000
        return v
    except Exception:
        return fallback

def dp(v):
    try:
        return AndroidUtilities.dp(v)
    except Exception:
        return int(v * 2.75)

def _ripple(view):
    try:
        from android.graphics.drawable import ColorDrawable
        view.setBackground(RippleDrawable(
            ColorStateList.valueOf(_tc(Theme.key_listSelector)),
            None, ColorDrawable(Color.TRANSPARENT)))
    except Exception:
        pass

def _panel_bg():
    bg = GradientDrawable()
    bg.setCornerRadii([dp(20), dp(20), 0, 0, 0, 0, 0, 0])
    bg.setColor(_tc(Theme.key_dialogBackground))
    return bg

def _get_root(activity):
    try:
        rv = activity.getWindow().getDecorView()
        try:
            cv = rv.findViewById(0x01020002)
            if cv is not None:
                return cv
        except Exception:
            pass
        return rv
    except Exception:
        return None

def _make_label(act, text):
    tv = TextView(act)
    tv.setText(text)
    tv.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13)
    try:
        tv.setTextColor(_tc(Theme.key_windowBackgroundWhiteGrayText))
    except Exception:
        pass
    lp = LinearLayout.LayoutParams(-1, -2)
    lp.setMargins(dp(4), 0, 0, dp(6))
    tv.setLayoutParams(lp)
    return tv

def _make_btn(act, text, primary=True, on_click=None):
    tv = TextView(act)
    tv.setText(text)
    tv.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 15)
    tv.setGravity(Gravity.CENTER)
    try:
        tv.setTypeface(AndroidUtilities.getTypeface("fonts/rmedium.ttf"))
    except Exception:
        tv.setTypeface(None, Typeface.BOLD)
    btn_bg = GradientDrawable()
    btn_bg.setCornerRadius(dp(18))
    if primary:
        try:
            btn_bg.setColor(_tc(Theme.key_featuredStickers_addButton))
            tv.setTextColor(_tc(Theme.key_featuredStickers_buttonText))
        except Exception:
            btn_bg.setColor(Color.parseColor("#007AFF"))
            tv.setTextColor(Color.WHITE)
    else:
        btn_bg.setColor(Color.parseColor("#33888888"))
        try:
            tv.setTextColor(_tc(Theme.key_dialogTextBlue))
        except Exception:
            tv.setTextColor(Color.parseColor("#007AFF"))
    try:
        tv.setBackground(RippleDrawable(
            ColorStateList.valueOf(Color.parseColor("#40000000")), btn_bg, None))
    except Exception:
        tv.setBackground(btn_bg)
    tv.setPadding(dp(24), dp(14), dp(24), dp(14))
    tv.setClickable(True)
    tv.setFocusable(True)
    if on_click:
        tv.setOnClickListener(OnClickListener(on_click))
    return tv

# ── Пикер эмодзи ─────────────────────────────────────────────────────────────

def _make_emoji_picker(act, on_select_fn):
    """Возвращает (view, setup_fn). setup_fn() вызвать после добавления в иерархию."""
    outer = FrameLayout(act)
    outer_bg = GradientDrawable()
    outer_bg.setCornerRadius(dp(12))
    try:
        outer_bg.setColor(_tc(Theme.key_chat_inBubble))
    except Exception:
        outer_bg.setColor(Color.parseColor("#10000000"))
    outer.setBackground(outer_bg)
    outer.setPadding(dp(4), dp(4), dp(4), dp(4))

    inner = LinearLayout(act)
    inner.setOrientation(LinearLayout.VERTICAL)

    try:
        from androidx.core.widget import NestedScrollView
        vsv = NestedScrollView(act)
    except Exception:
        try:
            from android.support.v4.widget import NestedScrollView
            vsv = NestedScrollView(act)
        except Exception:
            vsv = ScrollView(act)
    vsv.setVerticalScrollBarEnabled(False)
    vsv.addView(inner)
    outer.addView(vsv)

    lp = LinearLayout.LayoutParams(-1, dp(280))
    lp.setMargins(0, dp(4), 0, dp(8))
    outer.setLayoutParams(lp)

    def setup():
        COLS = 8
        sz = dp(40)
        for row_list in [ALL_REACTIONS[i:i+COLS] for i in range(0, len(ALL_REACTIONS), COLS)]:
            row_ll = LinearLayout(act)
            row_ll.setOrientation(LinearLayout.HORIZONTAL)
            row_ll.setGravity(Gravity.CENTER_HORIZONTAL)
            for em in row_list:
                em_tv = TextView(act)
                em_tv.setText(_emoji_for_display(em))
                em_tv.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 20)
                em_tv.setGravity(Gravity.CENTER)
                em_tv.setLayoutParams(LinearLayout.LayoutParams(sz, sz))
                em_tv.setClickable(True)
                em_tv.setFocusable(True)
                _ripple(em_tv)
                def _mk(e):
                    def on_click(v):
                        on_select_fn(e)
                    return on_click
                em_tv.setOnClickListener(OnClickListener(_mk(em)))
                row_ll.addView(em_tv)
            inner.addView(row_ll)

    return outer, setup

# ── TG API: отправка реакции ─────────────────────────────────────────────────


# ── Выделенные сообщения ─────────────────────────────────────────────────────

def _collect_selected(chat):
    """Возвращает (ids, message_objects) выделенных сообщений по возрастанию id."""
    sel = get_private_field(chat, "selectedMessagesIds")
    found = {}
    for arr in sel:
        if arr is None:
            continue
        for i in range(int(arr.size())):
            try:
                found[int(arr.keyAt(i))] = arr.valueAt(i)
            except Exception:
                pass
    ids = sorted(found.keys())
    return ids, [found[i] for i in ids if found[i] is not None]


def _clear_selection(chat):
    """Снимает выделение и закрывает action mode (иначе выделение «залипает»)."""
    def _do():
        for name in ("clearSelectionMode", "hideActionMode"):
            try:
                for m in _find_all_methods(chat, name):
                    if len(m.getParameterTypes()) == 0:
                        m.invoke(chat)
                        return
            except Exception:
                continue
        try:
            chat.getActionBar().hideActionMode()
        except Exception:
            pass
    run_on_ui_thread(_do)


def _reaction_key(reaction):
    """Из VisibleReaction достаёт эмодзи (строка) или documentId (число строкой)."""
    for attr in ("emojicon", "emoticon"):
        try:
            v = getattr(reaction, attr)
            if v is not None and str(v) not in ("", "None"):
                return str(v)
        except Exception:
            pass
    try:
        v = int(getattr(reaction, "documentId"))
        if v != 0:
            return str(v)
    except Exception:
        pass
    try:
        v = reaction.reaction.emoticon
        if v is not None and str(v) not in ("", "None"):
            return str(v)
    except Exception:
        pass
    return None


_SEND_CACHE = {}


def _get_connections_manager():
    """
    Получает ConnectionsManager через get_account_instance() из client_utils.
    find_class("ConnectionsManager") не работает в AyuGram — класс недоступен
    через classloader плагина, но get_account_instance() даёт AccountInstance
    у которого есть getConnectionsManager().
    """
    ai = get_account_instance()
    if ai is None:
        raise Exception("get_account_instance() returned None")
    get_cc = ai.getClass().getDeclaredMethod("getConnectionsManager")
    get_cc.setAccessible(True)
    cc = get_cc.invoke(ai)
    if cc is None:
        raise Exception("getConnectionsManager() returned None")
    return cc


def _send_reaction(account, peer_id, msg_id, emoji):
    """
    Отправляет реакцию через TL_messages_sendReaction.
    Поддерживает обычные эмодзи (TL_reactionEmoji) и кастомные (TL_reactionCustomEmoji).
    Кастомная эмодзи определяется по тому, что emoji — числовой documentId.
    """
    from java.util import ArrayList
    from org.telegram.messenger import MessagesController

    TL_sendReaction = find_class("org.telegram.tgnet.TLRPC$TL_messages_sendReaction")
    if not TL_sendReaction:
        raise Exception("TL_messages_sendReaction not found")

    # Определяем тип реакции: число → кастомная эмодзи, строка → обычная
    reaction = None
    is_custom = False
    try:
        doc_id = int(emoji)
        is_custom = True
    except (ValueError, TypeError):
        is_custom = False

    if is_custom:
        TL_reactionCustomEmoji = find_class(
            "org.telegram.tgnet.TLRPC$TL_reactionCustomEmoji")
        if not TL_reactionCustomEmoji:
            raise Exception("TL_reactionCustomEmoji not found")
        reaction = TL_reactionCustomEmoji()
        reaction.document_id = int(emoji)
        log(f"[BulkReact] custom emoji reaction doc_id={emoji}")
    else:
        TL_reactionEmoji = find_class("org.telegram.tgnet.TLRPC$TL_reactionEmoji")
        if not TL_reactionEmoji:
            raise Exception("TL_reactionEmoji not found")
        reaction = TL_reactionEmoji()
        reaction.emoticon = emoji
        log(f"[BulkReact] emoji reaction emoticon={emoji}")

    reactions_list = ArrayList()
    reactions_list.add(reaction)

    # Запрос
    req = TL_sendReaction()
    req.msg_id   = int(msg_id)
    req.reaction = reactions_list
    req.flags    = req.flags | 1  # HAS_REACTION

    # InputPeer
    mc       = MessagesController.getInstance(account)
    req.peer = mc.getInputPeer(int(peer_id))
    if req.peer is None:
        raise Exception(f"InputPeer is null for peer_id={peer_id}")

    # ConnectionsManager
    cc = _get_connections_manager()

    # sendRequest с минимальным числом параметров >= 2 (кэшируем)
    cls = cc.getClass()
    best_m = _SEND_CACHE.get(str(cls.getName()))
    if best_m is None:
        best_cnt = 999
        for m in cls.getDeclaredMethods():
            if m.getName() != "sendRequest":
                continue
            cnt = len(m.getParameterTypes())
            if cnt >= 2 and cnt < best_cnt:
                best_m = m
                best_cnt = cnt
        if best_m is None:
            raise Exception("sendRequest not found")
        best_m.setAccessible(True)
        _SEND_CACHE[str(cls.getName())] = best_m
    pts = best_m.getParameterTypes()

    args = [None] * len(pts)
    args[0] = req
    for i in range(1, len(pts)):
        pname = str(pts[i].getName())
        if pname in ("int", "long"):
            args[i] = 0
        elif pname == "boolean":
            args[i] = False

    best_m.invoke(cc, *args)
    return True

# ── Встроенный пикер реакций ─────────────────────────────────────────────────
#
# Из исходников ChatActivity.java и логов рантайма:
#
#  • ChatSelectionReactionMenuOverlay  — оверлей для выбора реакций при выделении.
#    Существует в AyuGram как import. Пробуем его первым.
#
#  • ReactionsContainerLayout  — View-strip с реакциями.
#    Конструктор: (int account, BaseFragment, Context, int type, Theme$ResourcesProvider)
#    type=0 (TYPE_DEFAULT).
#    setMessage(MessageObject, TLRPC$ChatFull, boolean)
#    setDelegate(ReactionsContainerLayout$ReactionsContainerDelegate)
#    setFragment(BaseFragment)
#    startEnterAnimation(boolean)
#    dismissWindow() / dismissParent(boolean)
#
#  • Показ через ChatScrimPopupContainerLayout или через Window.


def _find_recycler(rcl):
    """Ищет внутри ReactionsContainerLayout горизонтальный RecyclerView со списком реакций."""
    cls = rcl.getClass()
    while cls is not None and str(cls.getName()) != "java.lang.Object":
        try:
            for f in cls.getDeclaredFields():
                tn = str(f.getType().getName())
                if "RecyclerListView" in tn or "RecyclerView" in tn:
                    f.setAccessible(True)
                    v = f.get(rcl)
                    if v is not None:
                        return v
        except Exception:
            pass
        try:
            cls = cls.getSuperclass()
        except Exception:
            break
    return None


def _fit_picker(rcl, plugin_ref):
    """
    Делает так, чтобы вся полоска реакций вместе со стрелкой разворота была видна сразу,
    без прокрутки: расширяем контейнер на недостающую ширину и уменьшаем его целиком
    (масштаб), чтобы на экране он занимал столько же места. Реакции получаются чуть мельче.
    Применяем несколько раз: TG может пересчитать размеры во время анимации показа.
    """
    try:
        pref = {0: 1.0, 1: 0.9, 2: 0.8}.get(int(plugin_ref.get_setting("picker_scale", 0)), 1.0)
    except Exception:
        pref = 1.0

    def _apply():
        try:
            lw = int(rcl.getWidth())
            h = int(rcl.getHeight())
            if lw <= 0 or h <= 0:
                return
            sw = int(rcl.getRootView().getWidth())
            margin = dp(8)
            x = max(float(rcl.getX()), float(margin))
            avail = sw - x - margin

            # Сколько ширины не хватает, чтобы все элементы (с стрелкой) поместились
            extra = 0
            vp = rng = -1
            rv = _find_recycler(rcl)
            if rv is not None:
                try:
                    vp = int(rv.getWidth())
                    rng = int(rv.computeHorizontalScrollRange())
                    if vp > 0 and rng > vp:
                        extra = rng - vp
                except Exception as e:
                    log(f"[BulkReact] scroll range err: {e}")

            new_w = lw + extra
            if extra > 0:
                lp = rcl.getLayoutParams()
                if lp is not None:
                    lp.width = new_w
                    rcl.setLayoutParams(lp)

            sc = max(0.6, min(pref, avail / float(new_w), 1.0))
            rcl.setPivotX(0.0)
            rcl.setPivotY(h / 2.0)
            rcl.setScaleX(sc)
            rcl.setScaleY(sc)

            # Расширение могло сдвинуть полоску влево за край — возвращаем левый край на экран.
            # (pivot слева, поэтому левый край после масштабирования = getX())
            cur_x = float(rcl.getX())
            if cur_x < margin:
                rcl.setTranslationX(float(rcl.getTranslationX()) + (margin - cur_x))
            log(f"[BulkReact] fit: lw={lw} vp={vp} range={rng} extra={extra} avail={int(avail)} scale={sc:.2f} x={cur_x:.0f}")
        except Exception as e:
            log(f"[BulkReact] fit_picker err: {e}")

    for delay in (0.1, 0.4, 0.8, 1.5):
        threading.Timer(delay, lambda: run_on_ui_thread(_apply)).start()


def _get_message_object(chat, msg_id):
    try:
        messages = get_private_field(chat, "messages")
        if messages is None:
            return None
        for i in range(min(int(messages.size()), 500)):
            try:
                mo = messages.get(i)
                if mo is not None and int(mo.getId()) == msg_id:
                    return mo
            except Exception:
                pass
    except Exception as e:
        log(f"[BulkReact] _get_message_object err: {e}")
    return None


def _find_all_methods(java_instance, name):
    """Возвращает все методы с именем name по иерархии классов java-объекта."""
    result = []
    cls = java_instance.getClass()
    while cls is not None and str(cls.getName()) != "java.lang.Object":
        try:
            for m in cls.getDeclaredMethods():
                if m.getName() == name:
                    m.setAccessible(True)
                    result.append(m)
        except Exception:
            pass
        try:
            cls = cls.getSuperclass()
        except Exception:
            break
    return result


def _try_show_native_picker(chat, account, did, msg_ids, start_fn, plugin_ref=None, msg_objects=None):
    """
    Минимальный подход: используем CSRMO как задумал TG.
    Только setSelectedMessages + перехватываем делегат + animateVisible.
    """
    from java import dynamic_proxy

    msg_objects = list(msg_objects or [])
    if not msg_objects:
        for mid in msg_ids:
            mo = _get_message_object(chat, mid)
            if mo is not None:
                msg_objects.append(mo)
    if not msg_objects:
        log("[BulkReact] native: no MessageObjects, fallback")
        return False

    try:
        loader     = chat.getClass().getClassLoader()
        CSRMO_jcls = loader.loadClass(
            "org.telegram.ui.Components.Reactions.ChatSelectionReactionMenuOverlay")
        RCL_jcls   = loader.loadClass(
            "org.telegram.ui.Components.ReactionsContainerLayout")
        delegate_jcls = loader.loadClass(
            "org.telegram.ui.Components.ReactionsContainerLayout$ReactionsContainerDelegate")
        Boolean_jcls = loader.loadClass("java.lang.Boolean")
        bool_type    = Boolean_jcls.getDeclaredField("TYPE").get(None)
        bool_true    = Boolean_jcls.getDeclaredMethod("valueOf", bool_type).invoke(None, True)
        bool_false   = Boolean_jcls.getDeclaredMethod("valueOf", bool_type).invoke(None, False)

        # ── Ищем существующий CSRMO в полях ChatActivity ─────────────────────
        csrmo = None
        cls = chat.getClass()
        while cls is not None and str(cls.getName()) != "java.lang.Object":
            for f in cls.getDeclaredFields():
                if "ChatSelectionReactionMenuOverlay" in str(f.getType().getName()):
                    try:
                        f.setAccessible(True)
                        val = f.get(chat)
                        if val is not None:
                            csrmo = val
                            log(f"[BulkReact] CSRMO found: {f.getName()}")
                    except Exception:
                        pass
            if csrmo:
                break
            try:
                cls = cls.getSuperclass()
            except Exception:
                break

        if csrmo is None:
            log("[BulkReact] CSRMO not found, creating")
            ctor = CSRMO_jcls.getDeclaredConstructors()[0]
            ctor.setAccessible(True)
            csrmo = ctor.newInstance(chat, chat.getParentActivity())
            content = get_private_field(chat, "contentView")
            if content is None:
                content = chat.getParentActivity().getWindow().getDecorView()
            from android.widget import FrameLayout as FL
            lp = FL.LayoutParams(-1, -1)
            run_on_ui_thread(lambda: content.addView(csrmo, lp))

        if plugin_ref is not None:
            plugin_ref._csrmo        = csrmo
            plugin_ref._csrmo_loader = loader

        # ── Перехватываем делегат RCL внутри CSRMO ───────────────────────────
        # Ищем RCL-поле, ждём пока оно появится после checkCreateReactionsLayout
        try:
            m_create = CSRMO_jcls.getDeclaredMethod("checkCreateReactionsLayout")
            m_create.setAccessible(True)
            m_create.invoke(csrmo)
        except Exception as e:
            log(f"[BulkReact] checkCreateReactionsLayout err: {e}")

        proxy = None
        rcl = None
        for f in CSRMO_jcls.getDeclaredFields():
            if "reactionsContainerLayout" in f.getName():
                f.setAccessible(True)
                rcl = f.get(csrmo)
                break

        if rcl is not None:
            # ── Устанавливаем правильный тип и параметры RCL ─────────────────
            try:
                for f in RCL_jcls.getDeclaredFields():
                    fn = f.getName()
                    if fn == "type":
                        f.setAccessible(True)
                        f.setInt(rcl, 0)  # TYPE_DEFAULT — компактная полоска
                        log("[BulkReact] RCL.type = 0 ✓")
                    elif fn == "showExpandableReactions":
                        f.setAccessible(True)
                        f.set(rcl, True)
                        log("[BulkReact] RCL.showExpandableReactions = True ✓")
            except Exception as e:
                log(f"[BulkReact] RCL type setup err: {e}")

            picked = [False]
            delegate_proxy_cls = find_class(
                "org.telegram.ui.Components.ReactionsContainerLayout$ReactionsContainerDelegate")

            # Читаем оригинальный делегат TG — он управляет стрелкой/expand
            orig_del = [None]
            try:
                del_field = None
                for f in RCL_jcls.getDeclaredFields():
                    if str(f.getType().getName()).endswith("ReactionsContainerDelegate"):
                        f.setAccessible(True)
                        orig_del[0] = f.get(rcl)
                        del_field   = f
                        log(f"[BulkReact] orig delegate: {orig_del[0]}")
                        break
            except Exception as e:
                log(f"[BulkReact] orig_del err: {e}")

            class RCLDelegate(dynamic_proxy(delegate_proxy_cls)):
                def onReactionClicked(self, view, reaction, *a):
                    if picked[0]:
                        return
                    picked[0] = True
                    try:
                        emoji = _reaction_key(reaction)
                        if not emoji:
                            log(f"[BulkReact] cannot read reaction: {reaction}")
                            BulletinHelper.show_error("BulkReact: не удалось определить реакцию")
                            picked[0] = False
                            return
                        log(f"[BulkReact] reaction picked: {emoji}")

                        def hide():
                            try:
                                # Закрываем развёрнутое окно кастомных реакций если открыто
                                try:
                                    for f in RCL_jcls.getDeclaredFields():
                                        if f.getName() == "reactionsWindow":
                                            f.setAccessible(True)
                                            rw = f.get(rcl)
                                            if rw is not None:
                                                for m in rw.getClass().getDeclaredMethods():
                                                    if m.getName() in ("dismiss", "hide",
                                                                       "close", "dismissWindow"):
                                                        m.setAccessible(True)
                                                        m.invoke(rw)
                                                        log("[BulkReact] reactionsWindow closed ✓")
                                                        break
                                            break
                                except Exception as ex:
                                    log(f"[BulkReact] reactionsWindow close err: {ex}")

                                # Скрываем CSRMO
                                m_anim = CSRMO_jcls.getDeclaredMethod(
                                    "animateVisible", bool_type)
                                m_anim.setAccessible(True)
                                m_anim.invoke(csrmo, bool_false)
                                if plugin_ref is not None:
                                    plugin_ref._csrmo = None
                            except Exception as ex:
                                log(f"[BulkReact] hide err: {ex}")

                        run_on_ui_thread(hide)
                        start_fn(account, did, msg_ids, emoji)
                        _clear_selection(chat)
                    except Exception as ex:
                        log(f"[BulkReact] delegate err: {ex}")

                # Проксируем всё остальное на оригинальный делегат TG
                def _fwd(self, name, default, *args):
                    if orig_del[0] is not None:
                        try:
                            for m in delegate_jcls.getDeclaredMethods():
                                if m.getName() == name:
                                    m.setAccessible(True)
                                    return m.invoke(orig_del[0], *args)
                        except Exception:
                            pass
                    return default

                def drawBackground(self, *a):
                    return self._fwd("drawBackground", False, *a)

                def allowLongPress(self, *a):
                    return self._fwd("allowLongPress", False, *a)

                def needEnterText(self, *a):
                    return self._fwd("needEnterText", False, *a)

                def drawRoundRect(self, *a):
                    self._fwd("drawRoundRect", None, *a)

                def onEmojiWindowDismissed(self, *a):
                    self._fwd("onEmojiWindowDismissed", None, *a)

                def hideMenu(self, *a):
                    self._fwd("hideMenu", None, *a)

            try:
                proxy = RCLDelegate()
                for f in RCL_jcls.getDeclaredFields():
                    if str(f.getType().getName()).endswith("ReactionsContainerDelegate"):
                        f.setAccessible(True)
                        f.set(rcl, proxy)
                        log("[BulkReact] delegate injected via field ✓")
                        break
            except Exception as e:
                log(f"[BulkReact] inject delegate err: {e}")

        # ── setSelectedMessages — TG сам заполнит список реакций ─────────────
        try:
            List_jcls      = loader.loadClass("java.util.List")
            ArrayList_jcls = loader.loadClass("java.util.ArrayList")
            java_list      = ArrayList_jcls.getDeclaredConstructor().newInstance()
            add_m          = ArrayList_jcls.getDeclaredMethod(
                "add", loader.loadClass("java.lang.Object"))
            for mo in msg_objects:
                add_m.invoke(java_list, mo)
            m_set = CSRMO_jcls.getDeclaredMethod("setSelectedMessages", List_jcls)
            m_set.setAccessible(True)
            m_set.invoke(csrmo, java_list)
            log(f"[BulkReact] setSelectedMessages({len(msg_objects)}) ✓")
        except Exception as e:
            log(f"[BulkReact] setSelectedMessages err: {e}")

        # ── Показываем ────────────────────────────────────────────────────────
        # proxy и rcl захватываем в closure для повторного инжекта после показа
        _proxy_ref = [proxy if rcl is not None else None]
        _rcl_ref   = [rcl]

        def show():
            try:
                # invalidatePosition(false) — TG сам позиционирует полоску над сообщением
                try:
                    Bool2     = loader.loadClass("java.lang.Boolean")
                    bt2       = Bool2.getDeclaredField("TYPE").get(None)
                    bool_f2   = Bool2.getDeclaredMethod("valueOf", bt2).invoke(None, False)
                    m_inv = CSRMO_jcls.getDeclaredMethod("invalidatePosition", bt2)
                    m_inv.setAccessible(True)
                    m_inv.invoke(csrmo, bool_f2)
                    log("[BulkReact] invalidatePosition(false) ✓")
                except Exception:
                    try:
                        m_inv2 = CSRMO_jcls.getDeclaredMethod("invalidatePosition")
                        m_inv2.setAccessible(True)
                        m_inv2.invoke(csrmo)
                        log("[BulkReact] invalidatePosition() ✓")
                    except Exception as e2:
                        log(f"[BulkReact] invalidatePosition err: {e2}")

                m_anim = CSRMO_jcls.getDeclaredMethod("animateVisible", bool_type)
                m_anim.setAccessible(True)
                m_anim.invoke(csrmo, bool_true)
                log("[BulkReact] animateVisible(true) ✓")

                if _rcl_ref[0] is not None and plugin_ref is not None:
                    _fit_picker(_rcl_ref[0], plugin_ref)

                # Инжектируем делегат ПОСЛЕ animateVisible — TG мог перезаписать его
                if _proxy_ref[0] is not None and _rcl_ref[0] is not None:
                    try:
                        for f in RCL_jcls.getDeclaredFields():
                            if str(f.getType().getName()).endswith(
                                    "ReactionsContainerDelegate"):
                                f.setAccessible(True)
                                f.set(_rcl_ref[0], _proxy_ref[0])
                                log("[BulkReact] delegate re-injected post-show ✓")
                                break
                    except Exception as e:
                        log(f"[BulkReact] re-inject err: {e}")

            except Exception as e:
                log(f"[BulkReact] show err: {e}")

        run_on_ui_thread(show)
        return True

    except Exception as e:
        log(f"[BulkReact] native picker err: {e}")
        return False


class BulkReactPlugin(BasePlugin):

    def __init__(self):
        super().__init__()
        self.btn = None
        self._running = False
        self._stop = False
        self._flood_wait = 0  # секунд, устанавливается через post_request_hook
        self._csrmo = None    # ChatSelectionReactionMenuOverlay instance
        self._csrmo_loader = None  # classloader для CSRMO методов

    # ── Добавление / удаление кнопки ─────────────────────────────────────────

    def _add_btn(self, chat):
        try:
            if not (chat.getActionBar() and chat.getActionBar().isActionModeShowed()):
                return self._remove_btn()
            cont = get_private_field(chat, "actionsButtonsLayout")
            if not cont:
                cont = get_private_field(chat, "bottomMessagesActionContainer")
            if not cont:
                return
            if cont.findViewWithTag(TAG):
                return  # уже добавлена

            from org.telegram.messenger import R
            IV = find_class("android.widget.ImageView")

            try:
                BlurredRoundBtn = find_class("org.telegram.ui.Components.chat.buttons.ChatActivityBlurredRoundButton")
                factory = get_private_field(chat, "glassBackgroundDrawableFactory")
                colorProvider = get_private_field(chat, "blurredBackgroundColorProvider")
                resourceProvider = get_private_field(chat, "themeDelegate")
                if BlurredRoundBtn and factory and colorProvider:
                    icon_size = 48
                    self.btn = None
                    try:
                        self.btn = BlurredRoundBtn.create(
                            chat.getParentActivity(), factory, colorProvider,
                            resourceProvider, R.drawable.media_like, icon_size)
                    except Exception:
                        try:
                            self.btn = BlurredRoundBtn.create(
                                chat.getParentActivity(), factory, colorProvider, resourceProvider)
                            self.btn.setIcon(R.drawable.media_like, icon_size)
                        except Exception:
                            self.btn = None
                    if not self.btn:
                        raise Exception("no BlurredRoundButton")
                else:
                    raise Exception("factory/provider missing")
            except Exception:
                # Fallback — обычный ImageView
                from android.widget import ImageView
                self.btn = ImageView(chat.getParentActivity())
                try:
                    from org.telegram.messenger import R
                    self.btn.setImageResource(R.drawable.media_like)
                except Exception:
                    self.btn.setImageResource(0x10804B2)
                self.btn.setColorFilter(Theme.getColor(Theme.key_glass_defaultIcon))
                self.btn.setBackground(Theme.createSelectorDrawable(
                    Theme.getColor(Theme.key_listSelector), 1))
                from android.widget import ImageView as IV2
                self.btn.setScaleType(IV2.ScaleType.FIT_CENTER)
                pad = dp(14)
                self.btn.setPadding(pad, pad, pad, pad)

            self.btn.setTag(TAG)
            self.btn.setOnClickListener(OnClickListener(lambda v: self._on_btn_click(chat)))
            from android.widget import LinearLayout
            lp = LinearLayout.LayoutParams(dp(56), dp(56))
            lp.weight = 0
            lp.setMargins(dp(8), 0, dp(8), 0)
            cont.addView(self.btn, 1, lp)
        except Exception as e:
            log(f"[BulkReact] _add_btn error: {e}")

    def _remove_btn(self):
        if self.btn:
            try:
                p = self.btn.getParent()
                if p:
                    p.removeView(self.btn)
            except Exception:
                pass
            self.btn = None
        # Скрываем CSRMO если он был показан нами
        if self._csrmo is not None:
            try:
                csrmo = self._csrmo
                loader = self._csrmo_loader
                self._csrmo = None
                self._csrmo_loader = None
                if loader is not None:
                    Boolean_jcls = loader.loadClass("java.lang.Boolean")
                    bool_type    = Boolean_jcls.getDeclaredField("TYPE").get(None)
                    bool_false   = Boolean_jcls.getDeclaredMethod(
                        "valueOf", bool_type).invoke(None, False)
                    CSRMO_jcls   = loader.loadClass(
                        "org.telegram.ui.Components.Reactions.ChatSelectionReactionMenuOverlay")
                    m_anim = CSRMO_jcls.getDeclaredMethod("animateVisible", bool_type)
                    m_anim.setAccessible(True)
                    m_anim.invoke(csrmo, bool_false)
            except Exception as e:
                log(f"[BulkReact] csrmo hide err: {e}")

    # ── Хуки ─────────────────────────────────────────────────────────────────

    def on_plugin_load(self):
        CA = find_class("org.telegram.ui.ChatActivity")
        MO = find_class("org.telegram.messenger.MessageObject")
        Bool = find_class("java.lang.Boolean")
        cl = CA.getClass()

        # Хук: сообщение выделено/снято
        self.hook_method(
            cl.getDeclaredMethod("addToSelectedMessages", MO, Bool.TYPE, Bool.TYPE),
            type("H", (MethodHook,), {
                "after_hooked_method": lambda s, p: run_on_ui_thread(
                    lambda: self._add_btn(p.thisObject))
            })()
        )
        # Хук: action mode скрыт
        self.hook_method(
            cl.getDeclaredMethod("hideActionMode"),
            type("H2", (MethodHook,), {
                "after_hooked_method": lambda s, p: run_on_ui_thread(self._remove_btn)
            })()
        )

        # Хук на FLOOD_WAIT от сервера при отправке реакций
        self.add_hook("TL_messages_sendReaction")

    def on_plugin_unload(self):
        self._stop = True  # останавливаем фоновый поток
        self._remove_btn()

    # ── Клик по кнопке → открываем пикер ─────────────────────────────────────

    def _on_btn_click(self, chat):
        if self._running:
            BulletinHelper.show_error("BulkReact: уже выполняется, подождите")
            return

        # Собираем список выделенных сообщений
        try:
            msgs, mos = _collect_selected(chat)
            try:
                account = int(chat.getCurrentAccount())
            except Exception:
                account = int(get_user_config().selectedAccount)
            did = chat.getDialogId()
            if not msgs:
                BulletinHelper.show_error("BulkReact: нет выделенных сообщений")
                return
            try:
                from org.telegram.messenger import DialogObject
                if DialogObject.isEncryptedDialog(did):
                    BulletinHelper.show_error("BulkReact: в секретных чатах нет реакций")
                    return
            except Exception:
                pass
        except Exception as e:
            BulletinHelper.show_error(f"BulkReact: не удалось получить сообщения: {e}")
            return

        try:
            act = chat.getParentActivity()
            root_view = _get_root(act)
            if not root_view:
                return
        except Exception as e:
            BulletinHelper.show_error(f"BulkReact: нет Activity: {e}")
            return

        # Пробуем встроенный пикер, если не получится — кастомный
        if _try_show_native_picker(chat, account, did, msgs,
                                   self._start_bulk_react,
                                   plugin_ref=self, msg_objects=mos):
            return

        run_on_ui_thread(lambda: self._open_picker_panel(
            act, root_view, account, did, msgs, chat))

    # ── Панель с пикером ─────────────────────────────────────────────────────

    def _open_picker_panel(self, act, root_view, account, did, msg_ids, chat):
        try:
            overlay = FrameLayout(act)
            overlay.setLayoutParams(FrameLayout.LayoutParams(-1, -1))
            overlay.setClickable(True)
            overlay.setFocusable(True)

            dim = View(act)
            dim.setLayoutParams(FrameLayout.LayoutParams(-1, -1))
            dim.setBackgroundColor(Color.argb(160, 0, 0, 0))
            overlay.addView(dim)
            dim.setOnClickListener(OnClickListener(lambda v: close_fn()))

            panel = LinearLayout(act)
            panel.setOrientation(LinearLayout.VERTICAL)
            panel.setBackground(_panel_bg())
            panel_lp = FrameLayout.LayoutParams(-1, -2)
            panel_lp.gravity = Gravity.BOTTOM
            panel.setLayoutParams(panel_lp)
            overlay.addView(panel)

            def close_fn(v=None):
                try:
                    root_view.removeView(overlay)
                except Exception:
                    pass

            # Заголовок
            hdr = LinearLayout(act)
            hdr.setOrientation(LinearLayout.HORIZONTAL)
            hdr.setGravity(Gravity.CENTER_VERTICAL)
            hdr.setPadding(dp(16), dp(16), dp(16), dp(12))

            close_tv = TextView(act)
            close_tv.setText("✕")
            close_tv.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 18)
            close_tv.setGravity(Gravity.CENTER)
            close_tv.setPadding(0, dp(4), dp(14), dp(4))
            try:
                close_tv.setTextColor(_tc(Theme.key_windowBackgroundWhiteGrayText))
            except Exception:
                pass
            close_tv.setClickable(True)
            close_tv.setFocusable(True)
            close_tv.setOnClickListener(OnClickListener(close_fn))
            hdr.addView(close_tv, LinearLayout.LayoutParams(-2, -2))

            title_tv = TextView(act)
            title_tv.setText(f"Реакция на {len(msg_ids)} сообщ.")
            title_tv.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 18)
            try:
                title_tv.setTypeface(AndroidUtilities.getTypeface("fonts/rmedium.ttf"))
            except Exception:
                title_tv.setTypeface(None, Typeface.BOLD)
            try:
                title_tv.setTextColor(_tc(Theme.key_windowBackgroundWhiteBlackText))
            except Exception:
                pass
            hdr.addView(title_tv, LinearLayout.LayoutParams(0, -2, 1.0))
            panel.addView(hdr)

            # Разделитель
            divider = View(act)
            divider.setBackgroundColor(_tc(Theme.key_divider))
            panel.addView(divider, LinearLayout.LayoutParams(-1, dp(1)))

            # Контент
            content = LinearLayout(act)
            content.setOrientation(LinearLayout.VERTICAL)
            content.setPadding(dp(16), dp(12), dp(16), dp(24))

            selected_ref = [None]
            start_btn_ref = [None]
            status_tv = TextView(act)

            def on_emoji_picked(emoji):
                selected_ref[0] = emoji
                if start_btn_ref[0] is not None:
                    start_btn_ref[0].setText(f"Поставить {_emoji_for_display(emoji)}")
                status_tv.setText(f"Выбрано: {_emoji_for_display(emoji)}  —  нажмите «Поставить»")
                try:
                    status_tv.setTextColor(_tc(Theme.key_windowBackgroundWhiteBlackText))
                except Exception:
                    pass

            picker_view, picker_setup = _make_emoji_picker(act, on_emoji_picked)
            content.addView(_make_label(act, "Выберите реакцию:"))
            content.addView(picker_view)

            status_tv.setText("Реакция не выбрана")
            status_tv.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13)
            try:
                status_tv.setTextColor(_tc(Theme.key_windowBackgroundWhiteGrayText))
            except Exception:
                pass
            status_tv.setGravity(Gravity.CENTER)
            lp_s = LinearLayout.LayoutParams(-1, -2)
            lp_s.setMargins(0, dp(8), 0, dp(8))
            status_tv.setLayoutParams(lp_s)
            content.addView(status_tv)

            def on_start(v):
                emoji = selected_ref[0]
                if not emoji:
                    BulletinHelper.show_error("Выберите реакцию!")
                    return
                close_fn()
                self._start_bulk_react(account, did, msg_ids, emoji)
                _clear_selection(chat)

            btn_row = LinearLayout(act)
            btn_row.setOrientation(LinearLayout.HORIZONTAL)
            btn_row.setLayoutParams(LinearLayout.LayoutParams(-1, -2))

            cancel_btn = _make_btn(act, "Отмена", primary=False, on_click=close_fn)
            start_btn  = _make_btn(act, "Выберите реакцию", primary=True, on_click=on_start)

            start_btn_ref[0] = start_btn

            lp_c = LinearLayout.LayoutParams(0, -2, 1.0)
            lp_c.setMargins(0, 0, dp(8), 0)
            cancel_btn.setLayoutParams(lp_c)
            start_btn.setLayoutParams(LinearLayout.LayoutParams(0, -2, 2.0))
            btn_row.addView(cancel_btn)
            btn_row.addView(start_btn)
            content.addView(btn_row)

            panel.addView(content, LinearLayout.LayoutParams(-1, -2))

            root_view.addView(overlay)

            try:
                panel.setTranslationY(dp(800))
                panel.animate().translationY(0).setDuration(250).start()
            except Exception:
                pass

            # Инициализируем пикер ПОСЛЕ добавления в иерархию
            picker_setup()

        except Exception as e:
            log(f"[BulkReact] _open_picker_panel error: {e}")
            BulletinHelper.show_error(f"BulkReact ошибка: {e}")

    # ── Отправка реакций с защитой от флуда ──────────────────────────────────

    def _start_bulk_react(self, account, did, msg_ids, emoji):
        if self._running:
            return
        self._running = True
        self._stop = False
        threading.Thread(
            target=self._react_worker,
            args=(account, did, msg_ids, emoji),
            daemon=True
        ).start()

    def post_request_hook(self, request_name, account, response, error):
        """Перехватываем FLOOD_WAIT от сервера на реакции."""
        from base_plugin import HookResult, HookStrategy
        if request_name == "TL_messages_sendReaction" and error:
            try:
                err_text = str(error.text) if hasattr(error, "text") else str(error)
                if "FLOOD_WAIT_" in err_text:
                    wait_sec = int(re.search(r"FLOOD_WAIT_(\d+)", err_text).group(1))
                    log(f"[BulkReact] post_hook FLOOD_WAIT_{wait_sec}")
                    self._flood_wait = wait_sec
            except Exception as e:
                log(f"[BulkReact] post_hook parse error: {e}")
        return HookResult()

    def _pace(self):
        """(мин. задержка, макс. задержка, размер пачки, пауза между пачками)."""
        profiles = {0: (0.25, 0.5, 25, 5.0),    # быстро
                    1: (0.5, 1.0, 15, 10.0),    # обычно
                    2: (1.0, 2.0, 10, 15.0)}    # осторожно
        try:
            idx = int(self.get_setting("speed", 1))
        except Exception:
            idx = 1
        return profiles.get(idx, profiles[1])

    def _sleep(self, sec):
        """Прерываемый sleep. False — если плагин выгружен."""
        end = time.time() + sec
        while time.time() < end:
            if self._stop:
                return False
            time.sleep(min(0.25, max(0.0, end - time.time())))
        return not self._stop

    def _react_worker(self, account, did, msg_ids, emoji):
        """
        Отправляет реакцию на каждое сообщение с защитой от флуда:
        - случайная задержка между запросами (зависит от профиля скорости)
        - длинная пауза после каждой пачки
        - при FLOOD_WAIT (post_request_hook) — ждём указанное время
        - при выгрузке плагина поток аккуратно останавливается
        """
        total = len(msg_ids)
        ok = fail = 0
        display_emoji = _emoji_for_display(emoji)
        d_min, d_max, batch, batch_pause = self._pace()

        def notify(text):
            run_on_ui_thread(lambda: BulletinHelper.show_success(text))

        def notify_err(text):
            run_on_ui_thread(lambda: BulletinHelper.show_error(text))

        self._flood_wait = 0

        try:
            for idx, msg_id in enumerate(msg_ids):
                if self._stop:
                    break

                if self._flood_wait > 0:
                    wait = self._flood_wait + 3
                    self._flood_wait = 0
                    log(f"[BulkReact] FLOOD_WAIT, sleeping {wait}s")
                    notify_err(f"BulkReact: флуд, ждём {wait}с...")
                    if not self._sleep(wait):
                        break

                try:
                    _send_reaction(account, did, msg_id, emoji)
                    ok += 1
                except Exception as e:
                    fail += 1
                    log(f"[BulkReact] error msg {msg_id}: {e}")

                if idx + 1 >= total:
                    break
                if (idx + 1) % batch == 0:
                    notify(f"BulkReact: {idx+1}/{total} {display_emoji}...")
                    if not self._sleep(batch_pause):
                        break
                elif not self._sleep(random.uniform(d_min, d_max)):
                    break
        finally:
            stopped = self._stop
            self._running = False
            self._flood_wait = 0
            if not stopped:
                text = f"BulkReact: готово! {display_emoji}  {ok}/{total} сообщений"
                if fail:
                    text += f" (ошибок: {fail})"
                    notify_err(text)
                else:
                    notify(text)

    # ── Настройки ─────────────────────────────────────────────────────────────

    def create_settings(self):
        from ui.settings import Header, Divider
        items = []
        try:
            from ui.settings import Selector
            items += [
                Header(text="Защита от флуда"),
                Selector(key="speed", text="Скорость отправки", default=1,
                         items=["Быстро", "Обычно", "Осторожно"]),
                Divider(text="«Осторожно» — для сотен сообщений, «Быстро» — чаще FLOOD_WAIT"),
                Header(text="Пикер реакций"),
                Selector(key="picker_scale", text="Размер полоски реакций", default=0,
                         items=["Обычный", "Чуть меньше", "Меньше"]),
                Divider(text="Ширина подгоняется автоматически, чтобы стрелка разворота была видна сразу; здесь можно сделать ещё мельче"),
            ]
        except Exception as e:
            log(f"[BulkReact] settings unavailable: {e}")
        return items
