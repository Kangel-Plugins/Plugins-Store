    "👍","👎","❤","🔥","🥰","👏","😁","🤔","🤯","😱",
    "🤬","😢","🎉","🤩","🤮","💩","🙏","👌","🕊","🤡",
    "🥱","🥴","😍","🐳","❤‍🔥","🌚","🌭","💯","🤣","⚡",
    "🍌","🏆","💔","🤨","😐","🍓","🍾","💋","🖕","😈",
    "😴","😭","🤓","👻","👨‍💻","👀","🎃","🙈","😇","😨",
    "🤝","✍","🤗","🫡","🎅","🎄","☃","💅","🤪","🗿",
    "🆒","💘","🙉","🦄","😘","💊","🙊","😎","👾","🤷‍♂",
