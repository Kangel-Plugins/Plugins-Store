    def _readable_guide_block(self):
        fragment = get_last_fragment()
        activity = fragment.getParentActivity() if fragment else None
        if activity is None:
            return Text(
                text="Инструкция по голосовым и медиафайлам",
                subtext="В меню аудио- или видеофайла выбери «Плагины → Расшифровать медиа».",
                icon="msg_info",
            )

        density = float(activity.getResources().getDisplayMetrics().density)
        pad = int(16 * density)
        gap = int(7 * density)
        block = LinearLayout(activity)
        block.setOrientation(LinearLayout.VERTICAL)
        block.setPadding(pad, int(12 * density), pad, int(12 * density))

        def add_paragraph(title, body):
            title_view = TextView(activity)
            title_view.setText(title)
            title_view.setTextSize(16)
            title_view.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText))
            title_view.setSingleLine(False)
            title_view.setMaxLines(20)
            title_view.setLineSpacing(int(2 * density), 1.0)
            block.addView(title_view, LinearLayout.LayoutParams(-1, -2))

            body_view = TextView(activity)
            body_view.setText(body)
            body_view.setTextSize(14)
            body_view.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText))
            body_view.setSingleLine(False)
            body_view.setMaxLines(20)
            body_view.setLineSpacing(int(2 * density), 1.0)
            body_view.setPadding(0, int(2 * density), 0, gap)
            block.addView(body_view, LinearLayout.LayoutParams(-1, -2))

        add_paragraph(
            "Приватность",
            "Не включай автоцитату для чувствительных чатов. "
            "Ручное распознавание тоже отправляет выбранную запись в Groq.",
        )
        add_paragraph(
            "Как пользоваться",
            "1. Вставь ключ, выбери модель и язык." + chr(10)
            + "2. Нажми кнопку расшифровки под голосовым или кружком, либо открой меню сообщения.",
        )
        add_paragraph(
            "Медиафайлы",
            "Открой меню аудио- или видеофайла и выбери «Плагины → Расшифровать медиа». "
            "Длинные файлы автоматически делятся на части; обработку можно прервать.",
        )
        return Custom(view=block)

    def _run_bg(self, fn):
        def safe():
            try:
                fn()
            except Exception:
                self.logger.exception("bg task failed")
        threading.Thread(target=safe, daemon=True).start()

    def _clear_cache_action(self, view):
        with self._lock:
            self._cache.clear()
            self._seen.clear()
        out_dir = os.path.join(get_cache_dir(), "groq_stt")
        removed = 0
        if os.path.isdir(out_dir):
            for name in os.listdir(out_dir):
                try:
                    os.remove(os.path.join(out_dir, name))
                    removed += 1
                except OSError:
                    pass
        _groq_show_success("Кэш очищен (удалено файлов: %d)" % removed)

    def _test_groq_token(self, view):
        token = self._token()
        if not token:
            _groq_show_error("Сначала укажи API-ключ")
            return
        BulletinHelper.show_info("Groq: проверяю ключ...")

        def check():
            try:
                resp = self._session.get(
                    "https://api.groq.com/openai/v1/models",
                    headers={"Authorization": "Bearer " + token},
                    timeout=15,
                )
                if resp.status_code == 200:
                    _groq_show_success("Ключ рабочий (200 OK)")
                elif resp.status_code == 401:
                    _groq_show_error("Неверный API-ключ (401)")
                else:
                    _groq_show_error("Код ответа %d" % resp.status_code)
            except requests.exceptions.Timeout:
                _groq_show_error("Таймаут соединения. Проверь интернет или VPN")
            except Exception as e:
                _groq_show_error("Ошибка сети: %s" % str(e)[:100])

        self._run_bg(check)

    def _open_groq_url(self, view):
        try:
            frag = get_last_fragment()
            if frag and frag.getParentActivity():
                frag.getParentActivity().startActivity(
                    Intent(Intent.ACTION_VIEW, Uri.parse("https://console.groq.com")))
        except Exception:
            self.logger.exception("open url failed")

    def _token(self) -> str:
        return str(self.get_setting("groq_token", "") or "").strip()

    def _edit_groq_token(self, view):
        fragment = get_last_fragment()
        activity = fragment.getParentActivity() if fragment else None
        if activity is None:
            _groq_show_error("Не удалось открыть окно ввода ключа")
            return

        field = AndroidEditText(activity)
        field.setSingleLine(True)
        field.setInputType(129)
        password_method = PasswordTransformationMethod.getInstance()
        field.setTransformationMethod(password_method)
        field.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText))
        field.setHintTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText))
        field.setHint("Вставь API-ключ Groq")
        current = self._token()
        if current:
            field.setText(JavaString(current))
            field.setSelection(len(current))

        content = LinearLayout(activity)
        content.setOrientation(LinearLayout.VERTICAL)
        content.setPadding(24, 8, 24, 0)
        content.addView(field, LinearLayout.LayoutParams(-1, -2))

        reveal = TextView(activity)
        reveal.setText("Показать ключ")
        reveal.setTextSize(14)
        reveal.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText))
        reveal.setPadding(0, 12, 0, 8)
        content.addView(reveal, LinearLayout.LayoutParams(-1, -2))

        class RevealListener(dynamic_proxy(View.OnClickListener)):
            def __init__(self):
                super().__init__()
                self.visible = False

            def onClick(self, view):
                self.visible = not self.visible
                if self.visible:
                    field.setTransformationMethod(None)
                    reveal.setText("Скрыть ключ")
                else:
                    field.setTransformationMethod(password_method)
                    reveal.setText("Показать ключ")
                field.setSelection(field.getText().length())

        listener = RevealListener()
        self._key_reveal_listener = listener
        reveal.setOnClickListener(listener)

        builder = AlertDialogBuilder(activity)
        builder.set_title("API-ключ Groq")
        builder.set_message("Ключ скрыт. Нажми «Показать ключ», чтобы проверить его.")
        builder.set_view(content)

        def save_key(dialog, which):
            value = str(field.getText().toString()).strip()
            if value:
                self.set_setting("groq_token", value, reload_settings=True)
                _groq_show_success("API-ключ сохранён")
            else:
                _groq_show_error("Ключ не изменён")
            dialog.dismiss()

        builder.set_positive_button("Сохранить", save_key)
        builder.set_negative_button("Отмена", lambda dialog, which: dialog.dismiss())
        builder.show()

    def _lang(self) -> str:
        try:
            i = int(self.get_setting("language_idx", 0))
        except (TypeError, ValueError):
            i = 0
        return LANGUAGES[max(0, min(i, len(LANGUAGES) - 1))][1]

    def _model(self) -> str:
        try:
            i = int(self.get_setting("model_idx", 0))
        except (TypeError, ValueError):
            i = 0
        return WHISPER_MODELS[max(0, min(i, len(WHISPER_MODELS) - 1))]

    @staticmethod
    def _try_set(obj, name, value):
        try:
            setattr(obj, name, value)
        except Exception:
            pass

    @staticmethod
    def _doc_duration(doc) -> int:
        try:
            for a in doc.attributes:
                if isinstance(a, (TLRPC.TL_documentAttributeAudio, TLRPC.TL_documentAttributeVideo)):
                    return int(a.duration)
        except Exception:
            pass
        return 0

    @staticmethod
    def _is_forward(owner) -> bool:
        try:
            if getattr(owner, "fwd_from", None) is not None:
                return True
            if int(getattr(owner, "flags", 0)) & int(getattr(TLRPC, "MESSAGE_FLAG_FWD", 2)):
                return True
            if MessageObject.isForwardedMessage(owner):
                return True
        except Exception:
            pass
        return False

    @staticmethod
    def _is_sent(owner) -> bool:
        try:
            return int(owner.id) > 0 and int(getattr(owner, "sendState", 0)) == 0
        except Exception:
            return int(getattr(owner, "id", 0)) > 0

    def _check_cancel(self, cancel_event=None):
        if cancel_event is not None and cancel_event.is_set():
            raise TranscriptionCancelled()

    def _wait_sent(self, owner, timeout: float, cancel_event=None) -> bool:
        deadline = time.time() + timeout
        while time.time() < deadline and not self._is_sent(owner):
            if cancel_event is not None and cancel_event.is_set():
                return False
            time.sleep(0.3)
        return self._is_sent(owner)

    def _whisper_hint(self, lang: str) -> str:
        custom = str(self.get_setting("custom_prompt", "") or "").strip()
        base = ""
        if lang in ("ru", "auto"):
            base = (
                "блять, нахуй, пиздец, ёбаный, ебать, сука, хуй, залупа, мудак, гондон, уёбок, "
                "заебись, охуенно, ахуенно, невъебенно, дохуя, охуеть, разъебай, задрот, "
                "кринж, рофл, чиллить, шарить, хайп, скам, треш, угар, лол, кек, имхо, го, "
                "катка, тимейт, рандом, лут, читер, нерф, баф, апнуть, хилить, тащить, слив, "
                "щас, чё, ничё, короч, вобщем, типа, пофиг, похер, хз, лан, спс, пж, кста, мб, гс, "
                "Тинькофф, Сбер, Озон, Вайлдберриз, Авито, Госуслуги, Яндекс, ВК, Телега, "
                "Дискорд, Ютуб, ГитХаб, ЧатГПТ, айфон, макбук, вайфай, Москва, Питер"
            )
        combined = (custom + ", " + base) if (custom and base) else (custom or base)
        return _fit_bytes(combined) if combined else ""

    @staticmethod
    def _format_text(text: str) -> str:
        t = re.sub(r"\s+", " ", (text or "")).strip()
        if not t:
            return t
        t = re.sub(r"\s+([,.;:!?…])", r"\1", t)
        t = re.sub(r"([,;:!?…])(?=\S)", r"\1 ", t)
        t = re.sub(r"\.(?=[A-Za-zА-Яа-яЁё])", r". ", t)
        t = t[0].upper() + t[1:]
        t = re.sub(r"([.!?…]\s+)([a-zа-яё])", lambda m: m.group(1) + m.group(2).upper(), t)
        if t[-1] not in ".!?…":
            t += "."
        return t

    def _on_file_loaded(self, args):
        try:
            name = str(args[0])
            f = args[1]
            path = str(f.getAbsolutePath()) if f is not None else ""
        except Exception:
            return
        with self._lock:
            w = self._file_waiters.get(name)
        if w is not None:
            w["path"] = path
            w["event"].set()

    def _resolve_audio(self, account: int, owner, cancel_event=None) -> str:
        self._check_cancel(cancel_event)
        attach = getattr(owner, "attachPath", None)
        if attach and os.path.isfile(attach) and os.path.getsize(attach) > 0:
            return attach
        loader = FileLoader.getInstance(account)
        doc = getattr(getattr(owner, "media", None), "document", None)
        expected = int(getattr(doc, "size", 0) or 0) if doc is not None else 0
        name = str(FileLoader.getAttachFileName(doc)) if doc is not None else ""

        def find() -> str:
            getters = [lambda: loader.getPathToMessage(owner)]
            if doc is not None:
                getters.append(lambda: loader.getPathToAttach(doc))
            for g in getters:
                try:
                    f = g()
                    if f is None:
                        continue
                    p = str(f.getAbsolutePath())
                    if p and os.path.isfile(p):
                        sz = os.path.getsize(p)
                        if sz > 0 and (expected <= 0 or sz >= expected):
                            return p
                except Exception:
                    pass
            return ""

        p = find()
        if p:
            return p

        ev = threading.Event()
        waiter = {"event": ev, "path": ""}
        if name:
            with self._lock:
                self._file_waiters[name] = waiter
        try:
            if doc is not None:
                loader.loadFile(doc, None, FileLoader.PRIORITY_HIGH, 0)
            deadline = time.time() + 180
            while time.time() < deadline:
                self._check_cancel(cancel_event)
                if ev.wait(0.2):
                    break
            self._check_cancel(cancel_event)
            p = waiter["path"]
            if p and os.path.isfile(p) and os.path.getsize(p) > 0:
                return p
            p = find()
            if p:
                return p
            try:
                f = loader.getPathToMessage(owner)
                p = str(f.getAbsolutePath()) if f is not None else ""
                if p and os.path.isfile(p) and os.path.getsize(p) > 0:
                    if not name or not bool(loader.isLoadingFile(name)):
                        return p
            except Exception:
                pass
            raise RuntimeError("файл не скачался")
        finally:
            if name:
                with self._lock:
                    self._file_waiters.pop(name, None)

    def _extract_audio_wav(self, src: str, cancel_event=None) -> str:
        self._check_cancel(cancel_event)
        extractor = MediaExtractor()
        codec = None
        chunks = []
        rate, channels = 48000, 1
        try:
            extractor.setDataSource(src)
            track, fmt = -1, None
            for i in range(extractor.getTrackCount()):
                f = extractor.getTrackFormat(i)
                mime = str(f.getString(MediaFormat.KEY_MIME) or "")
                if mime.startswith("audio/"):
                    track, fmt = i, f
                    break
            if track < 0:
                raise RuntimeError("в файле нет аудиодорожки")
            extractor.selectTrack(track)
            rate = int(fmt.getInteger(MediaFormat.KEY_SAMPLE_RATE))
            channels = int(fmt.getInteger(MediaFormat.KEY_CHANNEL_COUNT))
            codec = MediaCodec.createDecoderByType(str(fmt.getString(MediaFormat.KEY_MIME)))
            codec.configure(fmt, None, None, 0)
            codec.start()
            info = MediaCodec.BufferInfo()
            in_done = False
            out_done = False
            stalls = 0
            deadline = time.time() + 180
            while not out_done:
                self._check_cancel(cancel_event)
                if time.time() > deadline:
                    raise RuntimeError("таймаут извлечения аудио")
                if not in_done:
                    idx = codec.dequeueInputBuffer(10000)
                    if idx >= 0:
                        buf = codec.getInputBuffer(idx)
                        size = extractor.readSampleData(buf, 0)
                        if size < 0:
                            codec.queueInputBuffer(idx, 0, 0, 0, MediaCodec.BUFFER_FLAG_END_OF_STREAM)
                            in_done = True
                        else:
                            sample_time = max(0, int(extractor.getSampleTime()))
                            codec.queueInputBuffer(idx, 0, size, jlong(sample_time), 0)
                            extractor.advance()
                out = codec.dequeueOutputBuffer(info, 10000)
                if out >= 0:
                    stalls = 0
                    if info.size > 0 and (info.flags & MediaCodec.BUFFER_FLAG_CODEC_CONFIG) == 0:
                        ob = codec.getOutputBuffer(out)
                        ob.position(info.offset)
                        arr = jarray(jbyte)(info.size)
                        ob.get(arr)
                        chunks.append(_jbytes(arr))
                    codec.releaseOutputBuffer(out, False)
                    if (info.flags & MediaCodec.BUFFER_FLAG_END_OF_STREAM) != 0:
                        out_done = True
                elif out == MediaCodec.INFO_OUTPUT_FORMAT_CHANGED:
                    nf = codec.getOutputFormat()
                    try:
                        rate = int(nf.getInteger(MediaFormat.KEY_SAMPLE_RATE))
                        channels = int(nf.getInteger(MediaFormat.KEY_CHANNEL_COUNT))
                    except Exception:
                        pass
                else:
                    stalls += 1
                    if in_done and stalls > 300:
                        break
            codec.stop()
            codec.release()
            codec = None
        finally:
            try:
                extractor.release()
            except Exception:
                pass
            if codec is not None:
                try:
                    codec.release()
                except Exception:
                    pass
        pcm = b"".join(chunks)
        if not pcm:
            raise RuntimeError("не удалось извлечь аудио")
        samples = _to_mono16k(pcm, rate, channels)
        if self.get_setting("trim_silence", True):
            trimmed = _trim_silence(samples, 16000, 1)
            if trimmed is None:
                raise NoSpeechError("в записи нет слов")
            samples = trimmed
        out_dir = os.path.join(get_cache_dir(), "groq_stt")
        ensure_dir_exists(out_dir)
        out_path = os.path.join(out_dir, "a_%d_%d.wav" % (int(time.time() * 1000), random.randint(100, 999)))
        with wave.open(out_path, "wb") as w:
            w.setnchannels(1)
            w.setsampwidth(2)
            w.setframerate(16000)
            w.writeframes(samples.tobytes())
        return out_path

    def _post_whisper_file(self, path: str, filename: str, mime: str, token: str,
                           lang: str, cancel_event=None) -> str:
        self._check_cancel(cancel_event)
        form = {
            "model": (None, self._model()),
            "response_format": (None, "json"),
            "temperature": (None, "0"),
        }
        if lang != "auto":
            form["language"] = (None, lang)
        hint = self._whisper_hint(lang)
        if hint:
            form["prompt"] = (None, hint)
        with open(path, "rb") as f:
            data = f.read()
        self._check_cancel(cancel_event)

        last_err = None
        for attempt in range(2):
            self._check_cancel(cancel_event)
            try:
                resp = self._session.post(
                    GROQ_WHISPER_URL,
                    headers={"Authorization": "Bearer " + token},
                    files={**form, "file": (filename, data, mime)},
                    timeout=120,
                )
            except requests.exceptions.Timeout:
                last_err = RuntimeError("Groq не отвечает (таймаут). Проверь интернет/VPN")
                continue
            except requests.exceptions.ConnectionError:
                last_err = RuntimeError("Нет соединения с Groq (сеть/регион/VPN)")
                continue
            self._check_cancel(cancel_event)
            if resp.status_code == 429:
                if attempt == 0:
                    time.sleep(2.0)
                    continue
                raise RuntimeError("Groq: лимит запросов (429), подожди")
            if resp.status_code == 401:
                raise RuntimeError("Groq: неверный токен (401)")
            if resp.status_code >= 500 and attempt == 0:
                time.sleep(1.0)
                continue
            if resp.status_code != 200:
                raise RuntimeError("Groq %d: %s" % (resp.status_code, resp.text[:200]))
            dataj = resp.json()
            text = (dataj.get("text") or "").strip()
            if not text:
                text = " ".join(s.get("text", "").strip() for s in (dataj.get("segments") or [])).strip()
            return text
        if last_err is not None:
            raise last_err
        return ""

    def _transcribe_path(self, path: str, kind: str, token: str, lang: str,
                         cancel_event=None, status_cb=None) -> str:
        self._check_cancel(cancel_event)
        size = os.path.getsize(path)
        if size > MAX_FILE_BYTES:
            raise RuntimeError("файл больше 100 МБ")

        if kind == "wav":
            out_dir = os.path.join(get_cache_dir(), "groq_stt")
            ensure_dir_exists(out_dir)
            parts = _split_wav_segments(path, out_dir, MAX_SEGMENT_SEC)
            try:
                texts = []
                total = len(parts)
                for idx, part in enumerate(parts):
                    self._check_cancel(cancel_event)
                    if status_cb is not None and total > 1:
                        status_cb("Распознаю часть %d из %d..." % (idx + 1, total))
                    part_text = self._post_whisper_file(
                        part, "part_%d.wav" % idx, "audio/wav", token, lang, cancel_event
                    )
                    if part_text:
                        texts.append(part_text)
                full_text = " ".join(texts).strip()
            finally:
                for part in parts:
                    if part != path:
                        try:
                            os.remove(part)
                        except OSError:
                            pass
        else:
            if size > MAX_RAW_GROQ_BYTES:
                raise RuntimeError("файл больше 24 МБ без извлечения WAV")
            filename = os.path.basename(path)
            if kind == "round":
                mime = "video/mp4"
                if "." not in filename:
                    filename += ".mp4"
            else:
                mime = "audio/ogg"
                if "." not in filename:
                    filename += ".ogg"
            full_text = self._post_whisper_file(path, filename, mime, token, lang, cancel_event)

        if not full_text:
            raise RuntimeError("Groq не распознал речь. Проверь громкость и качество записи")
        return self._format_text(full_text)

    def get_transcription(self, account: int, owner, is_round: bool,
                          cancel_event=None, status_cb=None) -> str:
        self._check_cancel(cancel_event)
        doc = getattr(getattr(owner, "media", None), "document", None)
        cache_key = (
            int(account),
            int(doc.id) if doc is not None else int(owner.id),
            self._model(),
            self._lang(),
        )
        with self._lock:
            cached = self._cache.get(cache_key)
            if cached is not None:
                self._cache.move_to_end(cache_key)
                return cached

        token = self._token()
        if not token:
            raise RuntimeError("укажи Groq API Token в настройках")
        if status_cb is not None:
            status_cb("Загружаю файл из Telegram...")
        path = self._resolve_audio(account, owner, cancel_event)
        kind = "round" if is_round else "voice"
        tmp = None
        if (not is_round) or self.get_setting("extract_audio", True):
            try:
                if status_cb is not None:
                    status_cb("Извлекаю аудиодорожку...")
                tmp = self._extract_audio_wav(path, cancel_event)
                path, kind = tmp, "wav"
            except (NoSpeechError, TranscriptionCancelled):
                raise
            except Exception as e:
                self.logger.warning("audio extract failed, sending raw file: %s", e)
        try:
            if status_cb is not None:
                status_cb("Отправляю в Groq Whisper...")
            text = self._transcribe_path(path, kind, token, self._lang(), cancel_event, status_cb)
        finally:
            if tmp:
                try:
                    os.remove(tmp)
                except OSError:
                    pass
        with self._lock:
            self._cache[cache_key] = text
            if len(self._cache) > 200:
                self._cache.popitem(last=False)
        return text

    def _on_copy_click(self, context):
        message = context.get("message")
        if message is None:
            _groq_show_error("Не удалось получить сообщение")
            return
        try:
            if message.isVoiceOnce() or message.isRoundOnce():
                _groq_show_error("Одноразовые не расшифровываются")
                return
        except Exception:
            return
        if not self._token():
            _groq_show_error("Укажи Groq API Token в настройках")
            return
        account = context.get("account")
        account = int(account) if account is not None else int(message.currentAccount)
        BulletinHelper.show_info("Groq: расшифровываю...")
        self._run_bg(lambda: self._copy_job(account, message.messageOwner, bool(message.isRoundVideo())))

    def _copy_job(self, account, owner, is_round):
        if not self._wait_sent(owner, 120):
            _groq_show_error("Сообщение не отправлено")
            return
        try:
            text = self.get_transcription(account, owner, is_round)
        except Exception as e:
            self.logger.exception("copy failed")
            _groq_show_error("Ошибка расшифровки: %s" % str(e)[:150])
            return
        self._copy_to_clipboard(text, notify=True)

    def _copy_to_clipboard(self, text, notify=False):
        def do():
            try:
                cm = ApplicationLoader.applicationContext.getSystemService(Context.CLIPBOARD_SERVICE)
                cm.setPrimaryClip(ClipData.newPlainText("transcription", JavaString(text)))
                if notify:
                    _groq_show_success("Расшифровка скопирована")
            except Exception:
                self.logger.exception("clipboard failed")
                _groq_show_error("Не удалось скопировать")
        run_on_ui_thread(do)

    def _on_media_transcribe_click(self, context):
        message = context.get("message")
        if message is None:
            _groq_show_error("Не удалось получить медиа")
            return
        owner = getattr(message, "messageOwner", None)
        media = getattr(owner, "media", None) if owner is not None else None
        document = getattr(media, "document", None) if media is not None else None
        if document is None:
            _groq_show_error("В этом сообщении нет аудиофайла")
            return
        try:
            if message.isVoiceOnce() or message.isRoundOnce():
                _groq_show_error("Одноразовое медиа не расшифровывается")
                return
        except Exception:
            pass
        if not self._token():
            _groq_show_error("Укажи Groq API Token в настройках")
            return
        account = context.get("account")
        account = int(account) if account is not None else int(message.currentAccount)
        run_on_ui_thread(lambda: self._start_media_transcription(account, owner))

    def _start_media_transcription(self, account, owner):
        fragment = get_last_fragment()
        activity = fragment.getParentActivity() if fragment else None
        if activity is None:
            _groq_show_error("Не удалось открыть окно обработки")
            return

        density = float(activity.getResources().getDisplayMetrics().density)
        content = LinearLayout(activity)
        content.setOrientation(LinearLayout.VERTICAL)
        content.setPadding(int(22 * density), int(12 * density),
                           int(22 * density), int(18 * density))
        label = TextView(activity)
        label.setText("Подготовка к обработке...")
        label.setTextSize(15)
        label.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText))
        content.addView(label, LinearLayout.LayoutParams(-1, -2))
        progress = ProgressBar(activity, None, 16842872)
        progress.setIndeterminate(True)
        params = LinearLayout.LayoutParams(-1, int(4 * density))
        params.topMargin = int(14 * density)
        content.addView(progress, params)

        dialog = AlertDialogBuilder(activity)
        dialog.set_title("Groq: обработка медиа")
        dialog.set_view(content)
        cancel_event = threading.Event()
        dialog.set_negative_button(
            "Прервать",
            lambda current_dialog, which: self._cancel_media_job(cancel_event, current_dialog),
        )
        dialog.set_cancelable(False)
        dialog.show()

        def update_status(msg):
            if not cancel_event.is_set():
                run_on_ui_thread(lambda: label.setText(JavaString(msg)))

        self._run_bg(lambda: self._media_transcribe_job(
            account, owner, dialog, cancel_event, update_status))

    def _cancel_media_job(self, cancel_event, dialog):
        cancel_event.set()
        self._dismiss_dialog(dialog)

    def _media_transcribe_job(self, account, owner, progress_dialog, cancel_event, status_cb):
        if not self._wait_sent(owner, 120, cancel_event):
            if not cancel_event.is_set():
                run_on_ui_thread(lambda: self._finish_media_error(
                    progress_dialog, "Медиа ещё не загружено"))
            return
        try:
            text = self.get_transcription(account, owner, False, cancel_event, status_cb)
        except TranscriptionCancelled:
            return
        except Exception as e:
            if cancel_event.is_set():
                return
            self.logger.exception("media transcription failed")
            error_text = "Ошибка расшифровки: %s" % str(e)[:150]
            run_on_ui_thread(lambda: self._finish_media_error(progress_dialog, error_text))
            return
        if not cancel_event.is_set():
            run_on_ui_thread(lambda: self._finish_media_success(progress_dialog, text))

    @staticmethod
    def _dismiss_dialog(dialog):
        try:
            dialog.dismiss()
        except Exception:
            pass

    def _finish_media_error(self, dialog, message):
        self._dismiss_dialog(dialog)
        _groq_show_error(message)

    def _finish_media_success(self, dialog, text):
        self._dismiss_dialog(dialog)
        self._show_media_transcription(text)

    def _show_media_transcription(self, text):
        fragment = get_last_fragment()
        activity = fragment.getParentActivity() if fragment else None
        if activity is None:
            _groq_show_error("Не удалось открыть окно расшифровки")
            return
        density = float(activity.getResources().getDisplayMetrics().density)
        scroll = ScrollView(activity)
        body = TextView(activity)
        body.setText(JavaString(text))
        body.setTextSize(16)
        body.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText))
        body.setPadding(int(20 * density), int(16 * density), int(20 * density), int(16 * density))
        body.setTextIsSelectable(True)
        body.setSingleLine(False)
        scroll.addView(body, LinearLayout.LayoutParams(-1, -2))

        builder = AlertDialogBuilder(activity)
        builder.set_title("Groq: расшифровка")
        builder.set_view(scroll)
        builder.set_neutral_button(
            "Копировать",
            lambda dialog, which: self._copy_to_clipboard(text, notify=True),
        )
        builder.set_positive_button("Закрыть", lambda dialog, which: dialog.dismiss())
        builder.show()

    def _on_quote_click(self, context):
        message = context.get("message")
        if message is None:
            _groq_show_error("Не удалось получить сообщение")
            return
        try:
            if not (message.isVoice() or message.isRoundVideo()):
                _groq_show_error("Это не голосовое и не кружок")
                return
            if message.isVoiceOnce() or message.isRoundOnce():
                _groq_show_error("Одноразовые не расшифровываются")
                return
        except Exception:
            return
        if not self._token():
            _groq_show_error("Укажи Groq API Token в настройках")
            return
        account = context.get("account")
        account = int(account) if account is not None else int(message.currentAccount)
        BulletinHelper.show_info("Groq: расшифровываю для отправки...")
        self._run_bg(lambda: self._quote_job(
            account, int(message.getDialogId()), int(message.getId()),
            self._topic_top(message.messageOwner), message.messageOwner,
            bool(message.isRoundVideo()), message))

    @staticmethod
    def _topic_top(owner) -> int:
        try:
            r = owner.reply_to
            if r is not None:
                top = int(getattr(r, "reply_to_top_id", 0) or 0)
                if not top and getattr(r, "forum_topic", False):
                    top = int(getattr(r, "reply_to_msg_id", 0) or 0)
                return top
        except Exception:
            pass
        return 0

    def _quote_job(self, account, dialog_id, msg_id, top, owner, is_round, mo):
        if not self._wait_sent(owner, 120):
            _groq_show_error("Сообщение не отправлено — расшифровка отменена")
            return
        try:
            text = self.get_transcription(account, owner, is_round)
        except Exception as e:
            self.logger.exception("quote failed")
            _groq_show_error("Ошибка расшифровки: %s" % str(e)[:150])
            return
        self._send_text_quotes(account, dialog_id, msg_id, top, text, mo)

    def _send_req(self, req, callback, account):
        wrapped = RequestCallback(callback)
        try:
            return send_request(req, wrapped, account=account)
        except TypeError:
            return send_request(req, wrapped)

    def _send_text_quotes(self, account, dialog_id, msg_id, top, text, mo):
        rest = text
        while rest:
            if len(rest) <= CHUNK:
                chunk, rest = rest, ""
            else:
                cut = rest.rfind("\n", 0, CHUNK)
                if cut < CHUNK // 2:
                    cut = rest.rfind(" ", 0, CHUNK)
                if cut < CHUNK // 2:
                    cut = CHUNK
                chunk, rest = rest[:cut].rstrip(), rest[cut:].lstrip()
            if chunk:
                self._send_one_quote(account, dialog_id, msg_id, top, chunk, mo)

    def _send_native(self, account, dialog_id, top, text, mo) -> bool:
        try:
            p = SendMessagesHelper.SendMessageParams()
            p.peer = int(dialog_id)
            p.message = text
            p.entities = self._blockquote_entities(text)
            self._try_set(p, "replyToTopMsg", int(top))
            if self.get_setting("reply_to_original", False) and mo is not None:
                self._try_set(p, "replyToMsg", mo)
            self._try_set(p, "searchWebpage", False)
            self._try_set(p, "notify", True)
            self._try_set(p, "silent", False)
            SendMessagesHelper.getInstance(int(account)).sendMessage(p, False)
            return True
        except Exception:
            self.logger.exception("native send failed, fallback to TL")
            return False

    def _apply_updates_bg(self, account, response):
        if response is None:
            return

        def do():
            try:
                get_messages_controller(account).processUpdates(response, False)
            except Exception:
                self.logger.exception("processUpdates failed")
        self._run_bg(do)

    def _send_raw_quote(self, account, dialog_id, msg_id, top, text):
        try:
            peer = get_messages_controller(account).getInputPeer(dialog_id)
            if peer is None or isinstance(peer, TLRPC.TL_inputPeerEmpty):
                raise ValueError("empty peer")
            req = TLRPC.TL_messages_sendMessage()
            req.peer = peer
            req.message = text
            req.random_id = random.getrandbits(63)
            req.entities = self._blockquote_entities(text)
            req.flags |= 8
            reply_on = bool(self.get_setting("reply_to_original", False))
            target = msg_id if (reply_on and msg_id > 0) else (top if top > 0 else 0)
            if target > 0:
                reply = TLRPC.TL_inputReplyToMessage()
                reply.reply_to_msg_id = target
                if top > 0:
                    reply.top_msg_id = top
                    reply.flags |= 2
                req.reply_to = reply
                req.flags |= 1

            def on_sent(response, error):
                if error is not None:
                    _groq_show_error("Цитата не отправлена: %s"
                                     % (getattr(error, "text", None) or "ошибка"))
                    return
                self._apply_updates_bg(account, response)

            self._send_req(req, on_sent, account)
        except Exception:
            self.logger.exception("send quote failed")
            _groq_show_error("Не удалось отправить расшифровку")

    def _send_one_quote(self, account, dialog_id, msg_id, top, text, mo):
        if self.get_setting("native_send", True):
            if self._send_native(account, dialog_id, top, text, mo):
                return
        self._send_raw_quote(account, dialog_id, msg_id, top, text)

    def _blockquote_entities(self, text):
        e = TLRPC.TL_messageEntityBlockquote()
        e.offset = 0
        e.length = JavaString(text).length()
        e.collapsed = bool(self.get_setting("collapsed_quote", True))
        arr = ArrayList()
        arr.add(e)
        return arr

    def _on_new_messages(self, account: int, args):
        if not self.get_setting("auto_quote_out", False):
            return
        try:
            messages = args[1]
        except Exception:
            return
        if messages is None:
            return
        for i in range(messages.size()):
            try:
                mo = messages.get(i)
                if getattr(mo.messageOwner, "out", False):
                    self._auto_consider(account, mo)
            except Exception:
                self.logger.exception("auto process failed")

    def _auto_consider(self, account: int, mo):
        try:
            owner = mo.messageOwner
            if owner is None or not getattr(owner, "out", False):
                return
            if self._is_forward(owner):
                return
            if isinstance(owner, TLRPC.TL_message_secret):
                return
            media = MessageObject.getMedia(owner)
            if not isinstance(media, TLRPC.TL_messageMediaDocument) or getattr(media, "ttl_seconds", 0):
                return
            doc = media.document
            if doc is None:
                return
            is_voice = bool(MessageObject.isVoiceDocument(doc))
            is_round = bool(MessageObject.isRoundVideoDocument(doc))
            if not (is_voice or is_round):
                return
            try:
                cap = float(self.get_setting("auto_max_sec", "300") or 300)
            except ValueError:
                cap = 300.0
            if self._doc_duration(doc) > cap:
                return
            dialog_id = int(MessageObject.getDialogId(owner))
            key = (int(account), dialog_id, int(doc.id))
            with self._lock:
                if key in self._seen:
                    return
                self._seen[key] = True
                if len(self._seen) > 500:
                    self._seen.popitem(last=False)
            top = self._topic_top(owner)
            self._run_bg(lambda: self._auto_job(int(account), dialog_id, top, owner, is_round, mo))
        except Exception:
            self.logger.exception("auto consider failed")

    def _auto_job(self, account, dialog_id, top, owner, is_round, mo):
        if not self._wait_sent(owner, 300):
            return
        try:
            text = self.get_transcription(account, owner, is_round)
        except Exception as e:
            self.logger.exception("auto failed")
            _groq_show_error("Авто-расшифровка: %s" % str(e)[:150])
            return
        self._send_text_quotes(account, dialog_id, int(getattr(owner, "id", 0)), top, text, mo)


class CreateTranscribeButtonHook(MethodReplacement):
    def __init__(self, plugin_instance):
        super().__init__()
        self.plugin = plugin_instance

    def replace_hooked_method(self, param):
        self.onTap(param)

    def onTap(self, param):
        this = param.thisObject
        parent = get_private_field(this, "parent")
        shouldBeOpen = get_private_field(this, "shouldBeOpen")
        loading = get_private_field(this, "loading")
        if parent is None:
            return
        set_private_field(this, "clickedToOpen", False)
        toOpen = not shouldBeOpen
        if not shouldBeOpen:
            if not loading:
                this.setLoading(True, True)
            else:
                set_private_field(this, "pressed", False)
                return
        else:
            this.setOpen(False, True)
            this.setLoading(False, True)
        set_private_field(this, "pressed", False)
        if toOpen:
            set_private_field(this, "clickedToOpen", True)
        self.transcribePressed(param, parent.getMessageObject(), toOpen)

    @staticmethod
    def _reset_button_state(this):
        try:
            this.setLoading(False, True)
            this.setOpen(False, True)
            set_private_field(this, "clickedToOpen", False)
            set_private_field(this, "pressed", False)
        except Exception:
            pass

    def transcribePressed(self, param, messageObject, open):
        this = param.thisObject
        if not self.plugin._token():
            self._reset_button_state(this)
            _groq_show_error("Укажи Groq API Token в настройках")
            return
        TranscribeButton = find_class("org.telegram.ui.Components.TranscribeButton")
        MessagesStorage = find_class("org.telegram.messenger.MessagesStorage")
        DialogObject = find_class("org.telegram.messenger.DialogObject")
        MessagesController = find_class("org.telegram.messenger.MessagesController")
        NotificationCenter = find_class("org.telegram.messenger.NotificationCenter")
        opsByPos = get_private_field(this, "transcribeOperationsByDialogPosition")
        opsById = get_private_field(this, "transcribeOperationsById")
        if messageObject is None or messageObject.messageOwner is None or not messageObject.isSent():
            self._reset_button_state(this)
            return
        account = messageObject.currentAccount
        peer = MessagesController.getInstance(account).getInputPeer(messageObject.messageOwner.peer_id)
        dialogId = DialogObject.getPeerDialogId(peer)
        messageId = messageObject.messageOwner.id
        if open:
            if (messageObject.messageOwner.voiceTranscription is not None
                    and messageObject.messageOwner.voiceTranscriptionFinal):
                TranscribeButton.openVideoTranscription(messageObject)
                messageObject.messageOwner.voiceTranscriptionOpen = True
                MessagesStorage.getInstance(account).updateMessageVoiceTranscriptionOpen(
                    dialogId, messageId, messageObject.messageOwner)
                run_on_ui_thread(lambda: NotificationCenter.getInstance(account).postNotificationName(
                    NotificationCenter.voiceTranscriptionUpdate, messageObject, None, None, True, True))
                return
            if opsByPos is None:
                set_private_field(this, "transcribeOperationsByDialogPosition", HashMap())
                opsByPos = get_private_field(this, "transcribeOperationsByDialogPosition")
            opsByPos.put(int(self.reqInfoHash(messageObject)), messageObject)
            if opsById is None:
                set_private_field(this, "transcribeOperationsById", HashMap())
                opsById = get_private_field(this, "transcribeOperationsById")
            opsById.put(int(self.reqInfoHash(messageObject)), messageObject)
            messageObject.messageOwner.voiceTranscriptionId = messageId
            self.plugin._run_bg(lambda: self.transcribeInBackground(
                this, messageObject, dialogId, messageId, account,
                TranscribeButton, MessagesStorage, opsByPos, opsById))
        else:
            key = int(self.reqInfoHash(messageObject))
            if opsByPos is not None:
                opsByPos.remove(key)
            if opsById is not None:
                opsById.remove(key)
            messageObject.messageOwner.voiceTranscriptionOpen = False
            MessagesStorage.getInstance(account).updateMessageVoiceTranscriptionOpen(
                dialogId, messageId, messageObject.messageOwner)
            run_on_ui_thread(lambda: NotificationCenter.getInstance(account).postNotificationName(
                NotificationCenter.voiceTranscriptionUpdate, messageObject, None, None, False, None))

    def transcribeInBackground(self, this, messageObject, dialogId, messageId, account,
                               TranscribeButton, MessagesStorage, opsByPos, opsById):
        try:
            is_round = False
            try:
                is_round = bool(messageObject.isRoundVideo())
            except Exception:
                pass
            text = self.plugin.get_transcription(account, messageObject.messageOwner, is_round)
            MessagesStorage.getInstance(account).updateMessageVoiceTranscription(
                dialogId, messageId, text, messageObject.messageOwner)
        except Exception as e:
            self.plugin.logger.exception("transcription worker failed")
            error_text = str(e)[:150]

            def fail_on_ui():
                key = int(self.reqInfoHash(messageObject))
                try:
                    if opsByPos is not None:
                        opsByPos.remove(key)
                    if opsById is not None:
                        opsById.remove(key)
                    messageObject.messageOwner.voiceTranscriptionId = 0
                    this.setLoading(False, True)
                    this.setOpen(False, True)
                    set_private_field(this, "pressed", False)
                    NotificationCenter.getInstance(account).postNotificationName(
                        NotificationCenter.voiceTranscriptionUpdate,
                        messageObject, None, None, False, None)
                except Exception:
                    self.plugin.logger.exception("transcription UI cleanup failed")
                _groq_show_error("Groq: %s" % error_text)

            run_on_ui_thread(fail_on_ui)
            return

        def finish_on_ui():
            TranscribeButton.openVideoTranscription(messageObject)
            messageObject.messageOwner.voiceTranscriptionOpen = True
            messageObject.messageOwner.voiceTranscriptionFinal = True
            this.finishTranscription(messageObject, messageId, text)
            key = int(self.reqInfoHash(messageObject))
            if opsByPos is not None:
                opsByPos.remove(key)
            if opsById is not None:
                opsById.remove(key)

        run_on_ui_thread(finish_on_ui)

    def reqInfoHash(self, messageObject):
        if messageObject is None:
            return 0
        return Objects.hash(messageObject.currentAccount, messageObject.getDialogId(), messageObject.getId())


class CreateUpdateWaveformHook(MethodHook):
    def after_hooked_method(self, param):
        set_private_field(param.thisObject, "useTranscribeButton", True)
