def _fit_bytes(s: str, limit: int = 896) -> str:
    b = s.encode("utf-8")
    return s if len(b) <= limit else b[:limit].decode("utf-8", errors="ignore")


def _jbytes(arr) -> bytes:
    try:
        return bytes(arr)
    except TypeError:
        return bytes(bytearray(arr))


def _to_mono16k(pcm: bytes, rate: int, channels: int) -> array:
    samples = array("h")
    samples.frombytes(pcm[: len(pcm) - (len(pcm) % 2)])
    if sys.byteorder != "little":
        samples.byteswap()
    if channels == 2:
        samples = array("h", ((a + b) // 2 for a, b in zip(samples[0::2], samples[1::2])))
    elif channels > 2:
        n = len(samples) // channels
        samples = array("h", (sum(samples[i * channels:(i + 1) * channels]) // channels
                              for i in range(n)))
    if rate == 16000:
        return samples
    if rate > 16000 and rate % 16000 == 0:
        r = rate // 16000
        return array("h", (sum(block) // r for block in zip(*[samples[k::r] for k in range(r)])))
    n_out = max(1, int(len(samples) * 16000 / rate))
    out = array("h", [0]) * n_out
    step = rate / 16000.0
    last = len(samples) - 1
    for i in range(n_out):
        pos = i * step
        j = int(pos)
        if j >= last:
            out[i] = samples[last]
        else:
            out[i] = int(samples[j] + (samples[j + 1] - samples[j]) * (pos - j))
    return out


class NoSpeechError(RuntimeError):
    pass


class TranscriptionCancelled(Exception):
    pass


def _trim_silence(samples, rate, channels):
    n = len(samples)
    if n == 0:
        return None
    frame = max(1, int(rate * 0.03)) * channels
    pad = int(rate * 0.3) * channels
    if n < frame:
        return samples

    energies = [
        sum(map(abs, samples[i:i + frame])) / frame
        for i in range(0, n - frame + 1, frame)
    ]
    peak = max(energies, default=0)
    if peak < 8:
        return None
    ordered = sorted(energies)
    floor = ordered[len(ordered) // 5]
    upper = ordered[min(len(ordered) - 1, int(len(ordered) * 0.9))]
    if peak < 32 and upper < 32 and (upper - floor) < 8:
        return None

    threshold = min(max(floor * 2, peak * 0.03, 8), peak * 0.6)
    voiced = [i for i, energy in enumerate(energies) if energy >= threshold]
    if not voiced:
        return samples

    start = max(0, voiced[0] * frame - pad)
    end = min(n, (voiced[-1] + 1) * frame + pad)
    trimmed = samples[start:end]
    return trimmed if len(trimmed) else samples


def _split_wav_segments(wav_path: str, out_dir: str, max_sec: int = MAX_SEGMENT_SEC) -> List[str]:
    with wave.open(wav_path, "rb") as w:
        channels = w.getnchannels()
        sampwidth = w.getsampwidth()
        rate = w.getframerate()
        total_frames = w.getnframes()
        frames_per_chunk = max(1, int(rate * max_sec))
        if total_frames <= frames_per_chunk:
            return [wav_path]
        parts = []
        idx = 0
        while True:
            raw = w.readframes(frames_per_chunk)
            if not raw:
                break
            part_path = os.path.join(out_dir, "part_%d_%d.wav" % (int(time.time() * 1000), idx))
            with wave.open(part_path, "wb") as pw:
                pw.setnchannels(channels)
                pw.setsampwidth(sampwidth)
                pw.setframerate(rate)
                pw.writeframes(raw)
            parts.append(part_path)
            idx += 1
        return parts


class _Observer(dynamic_proxy(NotificationCenter.NotificationCenterDelegate)):
    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin

    def didReceivedNotification(self, id, account, args):
        try:
            if id == NotificationCenter.didReceiveNewMessages:
                self.plugin._on_new_messages(int(account), args)
            elif id == NotificationCenter.fileLoaded:
                self.plugin._on_file_loaded(args)
        except Exception:
            self.plugin.logger.exception("observer error")


class GroqTranscriberPlugin(BasePlugin):

    def _resolve_java_class(self, class_name: str):
        try:
            cls = find_class(class_name)
            if cls is not None and hasattr(cls, "getName"):
                return cls
        except Exception:
            pass
        try:
            JavaClassCls = jclass("java.lang.Class")
            cls = JavaClassCls.forName(class_name)
            if cls is not None and hasattr(cls, "getName"):
                return cls
        except Exception:
            pass
        try:
            ctx = ApplicationLoader.applicationContext
            if ctx is not None:
                cls = ctx.getClassLoader().loadClass(class_name)
                if cls is not None and hasattr(cls, "getName"):
                    return cls
        except Exception:
            pass
        return None

    def _hook_methods_safe(self, class_name: str, method_name: str, handler):
        java_cls = self._resolve_java_class(class_name)
        if java_cls is None:
            self.logger.warning("Failed to resolve java.lang.Class for %s", class_name)
            return
        try:
            handles = self.hook_all_methods(java_cls, method_name, handler)
            if handles:
                self._hooks.extend(handles if isinstance(handles, list) else [handles])
            return
        except Exception as err:
            self.logger.warning("hook_all_methods(%s.%s) failed: %s; falling back to getDeclaredMethods", class_name, method_name, err)
        try:
            for method in java_cls.getDeclaredMethods():
                if str(method.getName()) == method_name:
                    handle = self.hook_method(method, handler)
                    if handle is not None:
                        self._hooks.append(handle)
        except Exception:
            self.logger.exception("Manual hook failed for %s.%s", class_name, method_name)

    def on_plugin_load(self):
        self._lock = threading.RLock()
        self._cache = OrderedDict()
        self._seen = OrderedDict()
        self._file_waiters = {}
        self._observers = {}
        self._hooks = []
        self._menu_items = []
        self._session = requests.Session()

        self._hook_methods_safe(
            "org.telegram.ui.Components.TranscribeButton",
            "onTap",
            CreateTranscribeButtonHook(self),
        )
        self._hook_methods_safe(
            "org.telegram.ui.Cells.ChatMessageCell",
            "updateWaveform",
            CreateUpdateWaveformHook(),
        )

        self._menu_items.append(self.add_menu_item(MenuItemData(
            menu_type=MenuItemType.MESSAGE_CONTEXT_MENU,
            text="Расшифровать аудио в чат",
            icon="msg_reply",
            priority=11,
            condition="message != null && (message.isVoice() || message.isRoundVideo())",
            on_click=self._on_quote_click,
        )))

        self._menu_items.append(self.add_menu_item(MenuItemData(
            menu_type=MenuItemType.MESSAGE_CONTEXT_MENU,
            text="Копировать расшифровку",
            icon="",
            priority=12,
            condition="message != null && (message.isVoice() || message.isRoundVideo())",
            on_click=self._on_copy_click,
        )))

        self._menu_items.append(self.add_menu_item(MenuItemData(
            menu_type=MenuItemType.MESSAGE_CONTEXT_MENU,
            text="Расшифровать медиа",
            icon="msg_voice_unmute",
            priority=13,
            condition="message != null && (message.isMusic() || message.isVideo()) && !message.isVoice() && !message.isRoundVideo()",
            on_click=self._on_media_transcribe_click,
        )))

        def register():
            for acc in range(int(UserConfig.MAX_ACCOUNT_COUNT)):
                try:
                    d = _Observer(self)
                    nc = get_notification_center(acc)
                    nc.addObserver(d, NotificationCenter.didReceiveNewMessages)
                    nc.addObserver(d, NotificationCenter.fileLoaded)
                    self._observers[acc] = d
                except Exception:
                    self.logger.exception("observer register failed")
        run_on_ui_thread(register)

    def on_plugin_unload(self):
        observers = dict(self._observers)
        hooks = list(self._hooks)
        menu_items = list(self._menu_items)

        for item in menu_items:
            if item is not None:
                try:
                    self.remove_menu_item(item)
                except Exception:
                    pass

        for h in hooks:
            if h is not None:
                try:
                    self.unhook_method(h)
                except Exception:
                    pass

        def unregister():
            for acc, d in observers.items():
                try:
                    nc = get_notification_center(acc)
                    nc.removeObserver(d, NotificationCenter.didReceiveNewMessages)
                    nc.removeObserver(d, NotificationCenter.fileLoaded)
                except Exception:
                    pass
        run_on_ui_thread(unregister)

        try:
            self._session.close()
        except Exception:
            pass

        with self._lock:
            self._cache.clear()
            self._seen.clear()
            self._file_waiters.clear()
            self._observers.clear()
            self._hooks.clear()
            self._menu_items.clear()

