def _groq_notice_text(message):
    text = str(message)
    return text if text.startswith("Groq:") else "Groq: " + text


def _groq_show_error(message):
    run_on_ui_thread(lambda: BulletinHelper.show_error(_groq_notice_text(message)))


def _groq_show_success(message):
    run_on_ui_thread(lambda: BulletinHelper.show_success(_groq_notice_text(message)))


