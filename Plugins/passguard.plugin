class PasscodeHook(MethodHook):
    """After-hook for SharedConfig.checkPasscode(String)."""

    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        self.plugin.on_passcode_checked(param)


class DialogListHook(MethodHook):
    """After-hook for dialog list getters."""

    def __init__(self, plugin, source="activity", kind=""):
        self.plugin = plugin
        self.source = source
        self.kind = kind

    def after_hooked_method(self, param):
        self.plugin.on_dialogs_array(param, self.source, self.kind)


