def qlog(message):
    log(f"[QuoteCreate] {message}")


def log_exc(what):
    qlog(f"{what}:\n{traceback.format_exc()}")


def quietly(fn, default=None):
    try:
        return fn()
    except Exception:
        return default


def dp(value):
    return AndroidUtilities.dp(value)


def plural_ru(count, one, few, many):
    count = abs(int(count))
    if count % 100 in (11, 12, 13, 14):
        return many
    return {1: one, 2: few, 3: few, 4: few}.get(count % 10, many)


def format_bytes(size):
    if size < 1024:
        return f"{size} Б"
    if size < 1024 * 1024:
        return f"{size / 1024:.0f} КБ"
    return f"{size / (1024 * 1024):.1f} МБ"


def as_java_color(color):
    value = int(color) & 0xFFFFFFFF
    return value - 0x100000000 if value >= 0x80000000 else value


def jcolor(color):
    return jint(as_java_color(color))


def with_alpha(color, fraction):
    return (max(0, min(255, int(fraction * 255))) << 24) | (int(color) & 0xFFFFFF)


def scale_alpha(color, percent):
    value = int(color) & 0xFFFFFFFF
    alpha = (value >> 24) * max(0, min(100, int(percent))) // 100
    return (alpha << 24) | (value & 0xFFFFFF)


def is_light(color):
    value = int(color) & 0xFFFFFFFF
    return ((value >> 16) & 0xFF) * 299 + ((value >> 8) & 0xFF) * 587 + (value & 0xFF) * 114 >= 186000


def hex_color(color):
    return "#{:08X}".format(int(color) & 0xFFFFFFFF)


def theme_color(key, provider=None):
    return Theme.getColor(key) if provider is None else Theme.getColor(key, provider)


def drawable(*names):
    for name in names:
        res = getattr(R.drawable, name, 0)
        if res:
            return res
    return 0


def show_done(text, icon_name):
    icon = getattr(R.raw, icon_name, 0)
    if icon:
        BulletinHelper.show_simple(text, icon)
    else:
        BulletinHelper.show_success(text)


def box(left, top, right, bottom):
    left, top, right, bottom = int(left), int(top), int(right), int(bottom)
    return (left, top, right, bottom) if right > left and bottom > top else None


def shift(bounds, dy):
    return (bounds[0], bounds[1] + dy, bounds[2], bounds[3] + dy) if bounds else None


def rounded(color, radius_dp):
    background = GradientDrawable()
    background.setCornerRadius(float(dp(radius_dp)))
    background.setColor(jcolor(color))
    return background


def text_view(context, text, size_dp, color, bold=False, single_line=True):
    view = TextView(context)
    view.setText(text)
    view.setTextSize(TypedValue.COMPLEX_UNIT_DIP, float(size_dp))
    view.setTextColor(jcolor(color))
    if single_line:
        view.setSingleLine(True)
    if bold:
        view.setTypeface(AndroidUtilities.getTypeface("fonts/rmedium.ttf"))
    return view


def vibrate(context, millis, amplitude):
    vibrator = context.getSystemService(Context.VIBRATOR_SERVICE)
    if vibrator is None:
        return
    if VibrationEffect is not None:
        vibrator.vibrate(VibrationEffect.createOneShot(millis, amplitude))
    else:
        vibrator.vibrate(millis)


def is_service_msg(msg):
    owner = getattr(msg, "messageOwner", None) if msg is not None else None
    return owner is not None and getattr(owner, "action", None) is not None


def is_action_msg(msg):
    return msg is not None and (bool(msg.isDateObject) or msg.contentType == 1)


def msg_topic_id(account, msg, dialog_id):
    try:
        if dialog_id > 0:
            return 0
        chat = MessagesController.getInstance(account).getChat(-dialog_id)
        if chat is None or not ChatObject.isForum(chat):
            return 0
        reply_to = msg.messageOwner.reply_to
        if reply_to is not None:
            topic_id = getattr(reply_to, "reply_to_top_id", 0) or getattr(reply_to, "reply_to_msg_id", 0)
            if topic_id:
                return topic_id
        return MessageObject.getTopicId(account, msg.messageOwner, True)
    except Exception as e:
        qlog(f"Topic id failed: {e}")
        return 0


def make_top_reply(account, topic_id, dialog_id):
    if topic_id <= 0:
        return None
    try:
        message = TLRPC.TL_message()
        message.message = ""
        message.id = topic_id
        message.peer_id = MessagesController.getInstance(account).getPeer(dialog_id)
        return MessageObject(account, message, False, False)
    except Exception as e:
        qlog(f"replyToTopMsg failed: {e}")
        return None


_PRIMITIVE_DEFAULTS = {"int": lambda: jint(0), "long": lambda: jlong(0), "boolean": lambda: False}
_REFERENCE_DEFAULTS = {
    "org.telegram.messenger.SendMessageChatArguments":
        lambda: find_class("org.telegram.messenger.SendMessageChatArguments").EMPTY,
}


def call_static_compat(class_name, method_name, direct, values, required=None):
    try:
        return direct()
    except TypeError as direct_error:
        qlog(f"{method_name}: signature mismatch, fallback to reflection: {direct_error}")
    clazz = Class.forName(class_name, False, ApplicationLoader.applicationContext.getClassLoader())
    candidates = []
    for method in clazz.getMethods():
        if method.getName() != method_name or not Modifier.isStatic(method.getModifiers()):
            continue
        type_names = [t.getName() for t in method.getParameterTypes()]
        if all(type_names.count(name) >= count for name, count in (required or {}).items()):
            candidates.append((len(type_names), method, type_names))
    for _, method, type_names in sorted(candidates, key=lambda item: item[0]):
        queues = {name: list(items) for name, items in values.items()}
        args = []
        for name in type_names:
            if queues.get(name):
                args.append(queues[name].pop(0))
            elif name in _PRIMITIVE_DEFAULTS:
                args.append(_PRIMITIVE_DEFAULTS[name]())
            elif name in _REFERENCE_DEFAULTS:
                args.append(_REFERENCE_DEFAULTS[name]())
            elif name in ("float", "double", "short", "byte", "char"):
                break
            else:
                args.append(None)
        else:
            return method.invoke(None, *args)
    raise Exception(f"{method_name}: нет совместимой перегрузки")


def new_bitmap(width, height):
    return Bitmap.createBitmap(max(1, int(width)), max(1, int(height)), Bitmap.Config.ARGB_8888)


def swap_bitmap(old, new):
    if new is not old:
        old.recycle()
    return new


def decode_preview(data):
    options = BitmapFactory.Options()
    options.inJustDecodeBounds = True
    BitmapFactory.decodeByteArray(data, 0, len(data), options)
    width, height = options.outWidth, options.outHeight
    options.inJustDecodeBounds = False
    options.inSampleSize = 1
    while width * height * 4 > PREVIEW_MAX_BYTES * options.inSampleSize ** 2:
        options.inSampleSize *= 2
    bitmap = BitmapFactory.decodeByteArray(data, 0, len(data), options)
    if bitmap is None:
        raise Exception("не удалось декодировать превью")
    return bitmap, (width, height)


def scale_bitmap(bitmap, factor):
    try:
        width = max(1, int(round(bitmap.getWidth() * factor)))
        height = max(1, int(round(bitmap.getHeight() * factor)))
        if width == bitmap.getWidth() and height == bitmap.getHeight():
            return bitmap
        return Bitmap.createScaledBitmap(bitmap, width, height, True)
    except Exception as e:
        qlog(f"Scale failed: {e}")
        return bitmap


def round_corners(bitmap, radius):
    try:
        width, height = bitmap.getWidth(), bitmap.getHeight()
        radius = max(0, min(int(radius), min(width, height) // 2))
        if radius <= 0:
            return bitmap
        result = new_bitmap(width, height)
        canvas = Canvas(result)
        paint = Paint(Paint.ANTI_ALIAS_FLAG)
        paint.setColor(jcolor(0xFFFFFFFF))
        canvas.drawRoundRect(RectF(0.0, 0.0, float(width), float(height)), float(radius), float(radius), paint)
        paint.setXfermode(PorterDuffXfermode(PorterDuff.Mode.SRC_IN))
        canvas.drawBitmap(bitmap, 0.0, 0.0, paint)
        return result
    except Exception as e:
        qlog(f"Corner rounding failed: {e}")
        return bitmap


def flatten_alpha(bitmap):
    try:
        if not bitmap.hasAlpha():
            return bitmap
        result = new_bitmap(bitmap.getWidth(), bitmap.getHeight())
        canvas = Canvas(result)
        canvas.drawColor(jcolor(0xFFFFFFFF))
        canvas.drawBitmap(bitmap, 0.0, 0.0, None)
        return result
    except Exception as e:
        qlog(f"Alpha flatten failed: {e}")
        return bitmap


def opaque_bounds(bmp):
    try:
        width, height = bmp.getWidth(), bmp.getHeight()
        if width <= 0 or height <= 0 or not bmp.hasAlpha():
            return None
        row = jarray(jint)(width)
        top = bottom = None
        left, right = width, -1
        for y in range(height):
            bmp.getPixels(row, 0, width, 0, y, width, 1)
            pixels = row[:]
            first = next((x for x in range(width) if pixels[x] & 0xFF000000), -1)
            if first < 0:
                continue
            last = next(x for x in range(width - 1, first - 1, -1) if pixels[x] & 0xFF000000)
            if top is None:
                top = y
            bottom = y
            left, right = min(left, first), max(right, last)
        if top is None or (left <= 0 and top <= 0 and right >= width - 1 and bottom >= height - 1):
            return None
        return left, top, right + 1, bottom + 1
    except Exception as e:
        qlog(f"Sticker bounds detect failed: {e}")
        return None


def sticker_bitmap(bmp, target=512):
    pad = 0
    bounds = opaque_bounds(bmp)
    if bounds:
        left, top, right, bottom = bounds
        crop_w, crop_h = max(1, right - left), max(1, bottom - top)
        if crop_w != bmp.getWidth() or crop_h != bmp.getHeight():
            bmp = swap_bitmap(bmp, Bitmap.createBitmap(bmp, left, top, crop_w, crop_h))
            pad = 8
    width, height = bmp.getWidth(), bmp.getHeight()
    scale = float(max(1, target - pad * 2)) / max(width, height)
    new_w = max(1, min(target, int(round(width * scale))))
    new_h = max(1, min(target, int(round(height * scale))))
    if new_w == width and new_h == height and pad == 0:
        return bmp
    prepared = new_bitmap(new_w + pad * 2, new_h + pad * 2)
    paint = Paint(Paint.ANTI_ALIAS_FLAG)
    paint.setFilterBitmap(True)
    paint.setDither(True)
    Canvas(prepared).drawBitmap(bmp, Rect(0, 0, width, height), Rect(pad, pad, pad + new_w, pad + new_h), paint)
    bmp.recycle()
    return prepared


def write_sticker_webp(bmp, path):
    def compress(fmt, quality):
        out = FileOutputStream(path)
        try:
            bmp.compress(fmt, quality, out)
        finally:
            out.close()
        return os.path.getsize(path)

    lossless = getattr(Bitmap.CompressFormat, "WEBP_LOSSLESS", None)
    lossy = getattr(Bitmap.CompressFormat, "WEBP_LOSSY", None) or Bitmap.CompressFormat.WEBP
    attempts = ([(lossless, 100)] if lossless is not None else []) + [(lossy, q) for q in STICKER_QUALITY_STEPS]
    size = 0
    for fmt, quality in attempts:
        size = compress(fmt, quality)
        if 0 < size <= STICKER_MAX_BYTES:
            return size
    raise Exception(f"стикер не влезает в 512 КБ ({format_bytes(size)})")


def media_local(loader, owner, attach=None):
    for get_path in (lambda: loader.getPathToMessage(owner),
                     lambda: loader.getPathToAttach(attach) if attach is not None else None):
        path = quietly(get_path)
        if path is not None and path.exists():
            return True
    return False


def media_ready(loader, msg, owner, attach, file_name):
    quietly(lambda: msg.checkMediaExistance(False))
    exists = getattr(msg, "mediaExists", False)
    ready = bool(quietly(exists, False) if callable(exists) else exists) or media_local(loader, owner, attach)
    loading = bool(file_name) and quietly(lambda: loader.isLoadingFile(file_name), False)
    return ready and not loading


def request_media(loader, msg, priority):
    owner = msg.messageOwner
    document = quietly(msg.getDocument)
    if document is not None:
        if media_local(loader, owner, document):
            return None
        loadable = quietly(lambda: MessageObject.isVideoDocument(document)
                           or MessageObject.isGifDocument(document)
                           or MessageObject.isRoundVideoDocument(document)
                           or MessageObject.isStickerDocument(document)
                           or MessageObject.isAnimatedStickerDocument(document, True), False)
        if loadable:
            try:
                loader.loadFile(document, msg, priority, 0)
                name = quietly(lambda: FileLoader.getAttachFileName(document))
                return lambda: media_ready(loader, msg, owner, document, name)
            except Exception as e:
                qlog(f"document preload failed: {e}")
    thumbs = getattr(msg, "photoThumbs", None)
    if thumbs is None or thumbs.size() == 0:
        return None
    try:
        size = FileLoader.getClosestPhotoSizeWithSize(thumbs, AndroidUtilities.getPhotoSize())
        parent = getattr(msg, "photoThumbsObject", None)
        if parent is None:
            media = MessageObject.getMedia(owner)
            if media is not None:
                parent = getattr(media, "photo", None) or getattr(media, "document", None)
        location = ImageLocation.getForObject(size, parent) if size is not None and parent is not None else None
        if location is None:
            return None
        loader.loadFile(location, msg, None, priority, 1)
        name = quietly(lambda: FileLoader.getAttachFileName(size))
        return lambda: media_ready(loader, msg, owner, size, name)
    except Exception as e:
        qlog(f"thumb preload failed: {e}")
        return None


def preload_media(msgs, account):
    try:
        loader = FileLoader.getInstance(account)
        checks = [check for check in (request_media(loader, m, FileLoader.PRIORITY_NORMAL_UP) for m in msgs) if check]
        deadline = time.time() + 6.0
        while checks and time.time() < deadline:
            checks = [check for check in checks if not quietly(check, True)]
            if checks:
                time.sleep(0.06)
    except Exception as e:
        qlog(f"preload stage failed: {e}")


def snapshot_view(view):
    try:
        width, height = view.getWidth(), view.getHeight()
        if width <= 0 or height <= 0:
            return None
        bmp = new_bitmap(width, height)
        canvas = Canvas(bmp)
        drawn = threading.Event()

        def draw():
            try:
                view.draw(canvas)
            except Exception:
                pass
            finally:
                drawn.set()

        run_on_ui_thread(draw)
        drawn.wait(2.0)
        return bmp
    except Exception:
        return None


def wallpaper_bitmap(chat):
    try:
        content = quietly(chat.getContentView)
        background = getattr(content, "backgroundView", None) if content is not None else None
        bmp = snapshot_view(background) if background is not None else None
        if bmp is not None:
            return bmp
        provider = chat.getResourceProvider()
        wallpaper = ((quietly(content.getBackgroundImage) if content is not None else None)
                     or (quietly(provider.getWallpaperDrawable) if provider is not None else None)
                     or Theme.getCachedWallpaper())
        if wallpaper is None:
            return None
        width, height = AndroidUtilities.displaySize.x, AndroidUtilities.displaySize.y
        bmp = new_bitmap(width, height)
        canvas = Canvas(bmp)
        if Theme.isPatternWallpaper():
            canvas.drawColor(jcolor(theme_color(Theme.key_chat_wallpaper, provider)))
        wallpaper.setBounds(0, 0, width, height)
        wallpaper.draw(canvas)
        return bmp
    except Exception:
        return None


def before_hook(fn):
    class _Before(MethodHook):
        def before_hooked_method(self, param):
            fn(param)
    return _Before()


def after_hook(fn):
    class _After(MethodHook):
        def after_hooked_method(self, param):
            fn(param)
    return _After()


class _Callback(dynamic_proxy(Utilities.Callback)):
    def __init__(self, fn):
        super().__init__()
        self.fn = fn

    def run(self, arg):
        try:
            self.fn(arg)
        except Exception as e:
            qlog(f"Callback error: {e}")


class _DismissListener(dynamic_proxy(DialogInterface.OnDismissListener)):
    def __init__(self, fn):
        super().__init__()
        self.fn = fn

    def onDismiss(self, dialog):
        self.fn()


class _BounceTouch(dynamic_proxy(View.OnTouchListener)):
    def onTouch(self, view, event):
        action = event.getActionMasked()
        if action == MotionEvent.ACTION_DOWN:
            scale = 0.92
        elif action in (MotionEvent.ACTION_UP, MotionEvent.ACTION_CANCEL):
            scale = 1.0
        else:
            return False
        quietly(lambda: view.animate().scaleX(scale).scaleY(scale).setDuration(150).start())
        return False


class _ColorConsumer(dynamic_proxy(Consumer)):
    def __init__(self, fn):
        super().__init__()
        self.fn = fn

    def accept(self, color):
        try:
            self.fn(int(color))
        except Exception as e:
            qlog(f"Color apply failed: {e}")


class _NoPipette(dynamic_proxy(ColorPickerBottomSheet.PipetteDelegate)):
    def onStartColorPipette(self): pass
    def onStopColorPipette(self): pass
    def getContainerView(self): return None
    def getSnapshotDrawingView(self): return None
    def onDrawImageOverCanvas(self, bitmap, canvas): pass
    def isPipetteVisible(self): return False
    def isPipetteAvailable(self): return False
    def onColorSelected(self, color): pass


class _ChatPicked(dynamic_proxy(DialogsActivity.DialogsActivityDelegate)):
    def __init__(self, fn):
        super().__init__()
        self.fn = fn

    def didSelectDialogs(self, fragment, dids, *args):
        try:
            self.fn(fragment, dids)
        except Exception as e:
            qlog(f"Chat pick failed: {e}")
            BulletinHelper.show_error("Не удалось отправить цитату")
        return True

    def canSelectStories(self):
        return False

    def didSelectStories(self, fragment):
        return False


class _SliderDelegate(dynamic_proxy(SeekBarView.SeekBarViewDelegate)):
    def __init__(self, on_drag, describe, steps):
        super().__init__()
        self.on_drag, self.describe, self.steps = on_drag, describe, steps

    def onSeekBarDrag(self, stop, progress):
        try:
            self.on_drag(float(progress))
        except Exception as e:
            qlog(f"Slider update failed: {e}")

    def onSeekBarPressed(self, pressed):
        pass

    def getContentDescription(self):
        return self.describe()

    def getStepsCount(self):
        return self.steps

    def needVisuallyDivideSteps(self):
        return False


if UniversalViewDelegate is not None:
    class _DrawDelegate(dynamic_proxy(UniversalViewDelegate)):
        def __init__(self, on_draw):
            super().__init__()
            self.on_draw = on_draw

        def onDraw(self, canvas, original):
            quietly(lambda: original.run(canvas))
            self.on_draw(canvas)

        def onMeasure(self, width_spec, height_spec, original):
            quietly(lambda: original.run(Integer(width_spec), Integer(height_spec)))

        def onAttachedToWindow(self):
            pass

        def onDetachedFromWindow(self):
            pass

        def onTouchEvent(self, event, original):
            return bool(quietly(lambda: original.run(event), False))

        def onInitializeAccessibilityNodeInfo(self, info, original):
            quietly(lambda: original.run(info))


_DELEGATE_NONE = (
    "didToggleRichMessageCheckbox didPressExtendedMediaPreview didPressUserStatus didPressUserAvatar "
    "didPressHiddenForward didPressViaBotNotInline didPressViaBot didPressBoostCounter didPressChannelAvatar "
    "didPressCancelSendButton didLongPress didPressReplyMessage getProgressLoadingBotButtonUrl "
    "getProgressLoadingLink didPressUrl didPressCodeCopy didPressChannelRecommendation "
    "didPressMoreChannelRecommendations didPressChannelRecommendationsClose needOpenWebView didPressWebPage "
    "didPressImage didPressPollMedia didPressGroupImage didPressSideButton didQuickShareStart didQuickShareMove "
    "didQuickShareEnd didPressOther didPressSponsoredClose didPressSummarize didPressSponsoredInfo didPressTime "
    "didPressBotButton didLongPressBotButton didPressCustomBotButton didLongPressCustomBotButton didPressReaction "
    "didPressVoteButtons didPressInstantButton didPressShowMore didPressGiveawayChatButton didPressCommentButton "
    "didPressHint needShowPremiumFeatures needShowPremiumBulletin videoTimerReached didStartVideoStream "
    "setShouldNotRepeatSticker getTextSelectionHelper needReloadPolls onDiceFinished getPinchToZoomHelper "
    "invalidateBlur didPressTopicButton didPressDialogButton didPressEmojiStatus didPressAboutRevenueSharingAds "
    "didPressRevealSensitiveContent didPressEffect didPressFactCheckWhat didPressFactCheck forceUpdate "
    "didTogglePollPreview forceUpdateNoAnimation didPressAdmin drawPollMode didPressAddPollOptionButton "
    "getDraftMessageMeasureController"
)
_DELEGATE_FALSE = (
    "isReplyOrSelf canToggleRichMessageCheckbox didLongPressUserAvatar didLongPressChannelAvatar isProgressLoading "
    "didPressToDoButton didLongPressPollOption didLongPressToDoButton openArticlePhoto needPlayMessage "
    "drawingVideoPlayerContainer canPerformActions canPerformReply onAccessibilityAction hasSelectedMessages "
    "shouldDrawThreadProgress keyboardIsOpened didPressAnimatedEmoji shouldShowTopicButton shouldShowDialogButton "
    "allowAddPollOptions"
)


class Delegate(dynamic_proxy(ChatMessageCell.ChatMessageCellDelegate)):
    def __init__(self, chat):
        super().__init__()
        self.mc = chat.getMessagesController()
        self.chat = chat.getCurrentChat()
        self.user = chat.getCurrentUser()
        self.topic = get_private_field(chat, "forumTopic")

    def _group_id(self):
        chat = self.chat
        return chat.id if chat is not None and not ChatObject.isChannelAndNotMegaGroup(chat) else None

    def isAdmin(self, uid):
        group = self._group_id()
        return group is not None and bool(quietly(lambda: self.mc.isAdmin(group, uid), False))

    def isOwner(self, uid):
        group = self._group_id()
        return group is not None and bool(quietly(lambda: self.mc.isOwner(group, uid), False))

    def getAdminRank(self, uid):
        if quietly(lambda: UserObject.isBotForum(self.user), False):
            return None
        group = self._group_id()
        rank = quietly(lambda: self.mc.getAdminRank(group, uid)) if group is not None else None
        from_id = getattr(self.topic, "from_id", None)
        if rank is None and from_id is not None and uid in (from_id.user_id, from_id.channel_id, from_id.chat_id):
            rank = quietly(lambda: LocaleController.getString(R.string.TopicCreator))
        return rank

    def isLandscape(self):
        return AndroidUtilities.displaySize.x > AndroidUtilities.displaySize.y

    def canDrawOutboundsContent(self):
        return True

    def shouldRepeatSticker(self, msg):
        return True

    def doNotShowLoadingReply(self, msg):
        return msg is not None and msg.getDialogId() == UserObject.REPLY_BOT

    def getAddPollOptionInputFieldHeight(self, cell):
        return 0

    for _names, _value in ((_DELEGATE_NONE, None), (_DELEGATE_FALSE, False)):
        for _name in _names.split():
            locals()[_name] = lambda self, *args, _value=_value: _value
    del _names, _value, _name


def attempt(what, fn):
    try:
        fn()
    except Exception as e:
        qlog(f"{what} failed: {e}")


def draw_shifted(canvas, dy, fn):
    canvas.save()
    try:
        canvas.translate(0.0, float(dy))
        fn()
    finally:
        canvas.restore()


def cell_field(cell, name):
    value = getattr(cell, name, None)
    return value if value else get_private_field(cell, name)


def cell_float(cell, name):
    return float(cell_field(cell, name) or 0)


def drawable_bounds(drawable, pad=0):
    if drawable is None:
        return None
    rect = drawable.getBounds()
    return box(rect.left - pad, rect.top - pad, rect.right + pad, rect.bottom + pad)


def receiver_bounds(receiver):
    try:
        left, top = int(receiver.getImageX()), int(receiver.getImageY())
        right, bottom = int(receiver.getImageX2()), int(receiver.getImageY2())
        if right <= left:
            right = int(left + receiver.getImageWidth())
        if bottom <= top:
            bottom = int(top + receiver.getImageHeight())
        return box(left, top, right, bottom)
    except Exception:
        return None


def round_radius(receiver, bounds=None):
    radius = quietly(lambda: max(int(value or 0) for value in receiver.getRoundRadius()), 0) or 0
    if bounds:
        limit = max(1, min(bounds[2] - bounds[0], bounds[3] - bounds[1]) // 2)
        radius = limit if radius <= 0 else min(radius, limit)
    return radius if radius > 0 else None


def name_bounds(cell):
    try:
        layout = cell_field(cell, "nameLayout")
        if not cell_field(cell, "drawNameLayout") or not layout:
            return None
        bounds = drawable_bounds(cell_field(cell, "nameLayoutSelector"), dp(1))
        if bounds:
            return bounds
        x = cell_float(cell, "nameX") + cell_float(cell, "nameOffsetX")
        y = cell_float(cell, "nameY")
        width = int(max(1, layout.getLineWidth(0))) if layout.getLineCount() > 0 else 0
        width = width or int(cell_field(cell, "nameLayoutWidth") or 0)
        if width <= 0:
            return None
        left, top = int(x - dp(2)), int(y - dp(1))
        return box(left, top, left + width + dp(4), top + max(1, layout.getHeight()) + dp(2))
    except Exception:
        return None


def name_avatar_bounds(cell):
    try:
        if not cell_field(cell, "drawNameAvatar"):
            return None
        x, y = cell_float(cell, "nameX"), cell_float(cell, "nameY")
        if cell_field(cell, "currentNameBotVerificationId"):
            x -= dp(20)
        return box(x, y, x + dp(26), y + dp(26))
    except Exception:
        return None


def reply_name_bounds(cell):
    try:
        layout = cell_field(cell, "replyNameLayout")
        if not layout:
            return None
        msg = cell_field(cell, "currentMessageObject")
        no_background = msg is not None and bool(quietly(msg.shouldDrawWithoutBackground, False))
        x = (cell_float(cell, "replyStartX") + (-dp(6) if no_background else -dp(1))
             - cell_float(cell, "replyNameOffset") + dp(10))
        y = cell_float(cell, "replyStartY") + (dp(1) if no_background else dp(3))
        if getattr(cell, "needReplyImage", False):
            image = getattr(cell, "replyImageReceiver", None)
            x += float(image.getImageWidth()) + dp(3) if image is not None else dp(28)
        width = (quietly(lambda: int(max(1, layout.getLineWidth(0))) if layout.getLineCount() > 0 else 0, 0)
                 or quietly(lambda: int(max(1, layout.getWidth())), 0))
        if width <= 0:
            return None
        left, top = int(x - dp(2)), int(y - dp(1))
        return box(left, top, int(x + width + dp(4)), top + max(1, layout.getHeight()) + dp(1))
    except Exception:
        return None


def forward_bounds(cell):
    try:
        if not cell_field(cell, "drawForwardedName"):
            return None
        layouts = cell_field(cell, "forwardedNameLayout")
        if not layouts or layouts[0] is None:
            return None
        x, y, width, height = (cell_float(cell, name)
                               for name in ("forwardNameX", "forwardNameY", "forwardedNameWidth", "forwardHeight"))
        return box(x - dp(2), y - dp(1), x + width + dp(4), y + height + dp(1))
    except Exception:
        return None


def via_bounds(cell):
    try:
        via_width = cell_float(cell, "viaWidth")
        if via_width <= 0:
            return None
        x = cell_float(cell, "nameX") + cell_float(cell, "viaNameWidth")
        y = cell_float(cell, "nameY")
        return box(x - dp(2), y - dp(4) - dp(1), x + via_width + dp(2), y + dp(20) + dp(1))
    except Exception:
        return None


def username_bounds(cell, msg):
    result = []
    try:
        text = str(getattr(msg, "messageText", None) or "")
        matches = [(m.start(), m.end()) for m in USERNAME_RE.finditer(text)]
        blocks = getattr(msg, "textLayoutBlocks", None)
        if not matches or blocks is None:
            return result
        text_x, text_y = int(getattr(cell, "textX", 0) or 0), int(getattr(cell, "textY", 0) or 0)
        pad = dp(1)
        for index in range(blocks.size()):
            block = blocks.get(index)
            layout = getattr(block, "textLayout", None)
            if layout is None:
                continue
            offset = int(getattr(block, "charactersOffset", 0) or 0)
            block_y = 0.0
            for getter in (lambda: block.textYOffset(blocks, cell.transitionParams),
                           lambda: block.textYOffset(blocks),
                           lambda: block.textYOffset):
                value = quietly(lambda: float(getter()))
                if value is not None:
                    block_y = value
                    break
            length = layout.getText().length()
            for start, end in matches:
                local_start, local_end = max(0, start - offset), min(length, end - offset)
                if local_end <= local_start:
                    continue
                try:
                    first_line = layout.getLineForOffset(local_start)
                    last_line = layout.getLineForOffset(max(local_start, local_end - 1))
                except Exception:
                    continue
                for line in range(first_line, last_line + 1):
                    try:
                        line_start = max(local_start, layout.getLineStart(line))
                        line_end = min(local_end, layout.getLineEnd(line))
                        if line_end <= line_start:
                            continue
                        x1, x2 = sorted((layout.getPrimaryHorizontal(line_start), layout.getPrimaryHorizontal(line_end)))
                        top, bottom = layout.getLineTop(line), layout.getLineBottom(line)
                    except Exception:
                        continue
                    bounds = box(int(text_x + x1) - pad, int(text_y + block_y + top) - pad,
                                 int(text_x + x2) + pad, int(text_y + block_y + bottom) + pad)
                    if bounds:
                        result.append(bounds)
    except Exception as e:
        qlog(f"Username bounds failed: {e}")
    return result


def mask_color(bmp, left, top, right, bottom):
    width, height = bmp.getWidth(), bmp.getHeight()
    cx, cy = (left + right) // 2, (top + bottom) // 2
    samples = []
    for x, y in ((left - 2, top - 2), (right + 2, top - 2), (left - 2, bottom + 2), (right + 2, bottom + 2),
                 (cx, top - 2), (cx, bottom + 2), (left - 2, cy), (right + 2, cy)):
        pixel = bmp.getPixel(max(0, min(width - 1, x)), max(0, min(height - 1, y))) & 0xFFFFFFFF
        if (pixel >> 24) >= 0x10:
            samples.append(pixel)
    if not samples:
        return 0xFF2B2B2B
    count = len(samples)
    red = sum((c >> 16) & 0xFF for c in samples) // count
    green = sum((c >> 8) & 0xFF for c in samples) // count
    blue = sum(c & 0xFF for c in samples) // count
    return 0xFF000000 | (red << 16) | (green << 8) | blue


def draw_mask(canvas, bmp, left, top, right, bottom, clip_circle=False, clip_radius=None, style=0, text_color=None):
    if right <= left or bottom <= top:
        return
    canvas.save()
    try:
        if clip_radius is None and not clip_circle:
            clip_radius = dp(4)
        path = Path()
        if clip_radius:
            path.addRoundRect(RectF(float(left), float(top), float(right), float(bottom)),
                              float(clip_radius), float(clip_radius), Path.Direction.CW)
            canvas.clipPath(path)
        elif clip_circle:
            radius = max(1.0, min(right - left, bottom - top) / 2.0)
            path.addCircle((left + right) / 2.0, (top + bottom) / 2.0, radius, Path.Direction.CW)
            canvas.clipPath(path)
        if style in (0, 1):
            factor = 0.05 if style == 0 else 0.1
            small_w, small_h = max(1, int((right - left) * factor)), max(1, int((bottom - top) * factor))
            small = new_bitmap(small_w, small_h)
            area, small_area = Rect(left, top, right, bottom), Rect(0, 0, small_w, small_h)
            Canvas(small).drawBitmap(bmp, area, small_area, None)
            paint = Paint()
            paint.setFilterBitmap(style == 0)
            canvas.drawBitmap(small, small_area, area, paint)
            small.recycle()
            return
        fill = Paint()
        fill.setColor(jcolor(mask_color(bmp, left, top, right, bottom)))
        canvas.drawRect(float(left), float(top), float(right), float(bottom), fill)
        if style == 4:
            return
        color = text_color if text_color is not None else SPOILER_COLOR
        if style == 2:
            effect = SpoilerEffect()
            effect.setColor(jcolor(color))
            effect.setBounds(left, top, right, bottom)
            effect.draw(canvas)
            return
        hatch = Paint()
        hatch.setColor(jcolor(color))
        hatch.setStrokeWidth(float(max(1, dp(1))))
        hatch.setStyle(Paint.Style.STROKE)
        span = bottom - top
        for x in range(left - span, right + span, max(1, dp(6))):
            canvas.drawLine(float(x), float(top), float(x + span), float(bottom), hatch)
    except Exception as e:
        qlog(f"Anonymize overlay error: {e}")
    finally:
        canvas.restore()


def group_id(msg):
    return quietly(lambda: int(msg.getGroupId()) if msg.hasValidGroupId() else 0, 0)


def make_album(run):
    try:
        group = MessageObject.GroupedMessages()
        group.groupId = run[0][0].getGroupId()
        for msg, _, _ in run:
            group.messages.add(msg)
        group.calculate()
        if group.posArray.size() != len(run) or any(group.getPosition(msg) is None for msg, _, _ in run):
            return None
        return group
    except Exception as e:
        qlog(f"Album group build failed: {e}")
        return None


def album_geometry(group, width):
    result, span, row = [], 0, 0
    for index in range(group.posArray.size()):
        size = group.posArray.get(index).spanSize
        if size <= 0:
            size = 1000
        if span > 0 and span + size > 1000:
            row += 1
            span = 0
        left = math.ceil(span * width / 1000.0)
        right = math.ceil(min(1000, span + size) * width / 1000.0)
        result.append((row, left, max(1, right - left)))
        span += size
    return result


@contextmanager
def patched_message(msg, opt):
    saved = []

    def patch(target, name, value):
        try:
            saved.append((target, name, getattr(target, name)))
            setattr(target, name, value)
        except Exception:
            pass

    try:
        if opt.fake_name:
            patch(msg, "customName", opt.fake_name)
        if quietly(lambda: msg.hasMediaSpoilers() and not msg.needDrawBluredPreview(), False):
            patch(msg, "isMediaSpoilersRevealed", True)
            patch(msg, "isMediaSpoilersRevealedInSharedMedia", True)
            patch(msg, "revealingMediaSpoilers", False)
        if opt.hide_reactions and getattr(msg.messageOwner, "reactions", None) is not None:
            patch(msg.messageOwner, "reactions", None)
        if opt.hide_media:
            patch(msg, "type", 0)
        yield
    finally:
        for target, name, value in reversed(saved):
            with suppress(Exception):
                setattr(target, name, value)


class Renderer:
    def __init__(self, plugin, msgs, chat, sticker=False):
        self.pl, self.msgs, self.chat, self.sticker = plugin, msgs, chat, sticker
        self.ctx = chat.getParentActivity()
        self.theme = self.res = self.delegate = None
        self._cell = self._action_cell = None

    def render(self, bg_bmp, transparent=False):
        prepared = self._neighbours()
        if not prepared:
            return None
        opt = self._options()
        pieces = []
        done = threading.Event()

        def draw_on_ui():
            try:
                self._draw_all(prepared, opt, pieces)
            except Exception:
                log_exc("Render UI stage failed")
            finally:
                done.set()

        run_on_ui_thread(draw_on_ui)
        limit = RENDER_WAIT_BASE_SEC + RENDER_WAIT_PER_MSG_SEC * len(prepared)
        if not done.wait(limit):
            raise Exception(f"рендер не завершился за {limit:.1f}с")
        if not pieces:
            return None
        return self._encode(self._compose(pieces, bg_bmp, transparent), transparent, len(pieces))

    def _options(self):
        get = self.pl.get_setting
        nick = bool(get("anonymize_nickname", False))
        fake_name = ""
        if nick and get("anonymize_fake_name", False):
            fake_name = str(get("anonymize_fake_text", "Аноним") or "").strip() or "Аноним"
        return SimpleNamespace(
            anon_nick=nick,
            anon_avatar=bool(get("anonymize_avatar", False)),
            anon_usernames=bool(get("anonymize_usernames", False)),
            style=int(get("anonymize_style", 0) or 0),
            fake_name=fake_name,
            hide_time=bool(get("hide_time", False)),
            hide_status=bool(get("hide_status", False)),
            hide_reactions=bool(get("hide_reactions", False)),
            hide_media=bool(get("hide_media", False)),
        )

    def _neighbours(self):
        msgs = self.msgs

        def same(a, b):
            return (not is_action_msg(a) and not is_action_msg(b) and a.getSenderId() == b.getSenderId()
                    and abs(a.messageOwner.date - b.messageOwner.date) < 300)

        prepared = []
        for index, msg in enumerate(msgs):
            with suppress(Exception):
                prepared.append((msg, index < len(msgs) - 1 and same(msgs[index + 1], msg),
                                 index > 0 and same(msg, msgs[index - 1])))
        return prepared

    def _surface_size(self):
        list_view = quietly(self.chat.getChatListView)
        list_width = (list_view.getMeasuredWidth() or list_view.getWidth()) if list_view is not None else 0
        return max(1, list_width, AndroidUtilities.displaySize.x), max(1, AndroidUtilities.displaySize.y)

    def _plan(self, prepared, width, hide_media):
        album_width = max(1, min(width, AndroidUtilities.displaySize.x or width))
        units, index = [], 0
        while index < len(prepared):
            gid = 0 if hide_media else group_id(prepared[index][0])
            end = index + 1
            while gid and end < len(prepared) and group_id(prepared[end][0]) == gid:
                end += 1
            run = prepared[index:end]
            group = make_album(run) if gid and len(run) > 1 else None
            geometry = quietly(lambda: album_geometry(group, album_width)) if group is not None else None
            if not geometry or len(geometry) != len(run):
                units.extend([Entry(msg, bottom, top, None, None, None, 0, width)] for msg, bottom, top in run)
            else:
                unit = []
                for position_index, (msg, _, _) in enumerate(run):
                    pos = group.posArray.get(position_index)
                    row, x, cell_width = geometry[position_index]
                    bottom = run[-1][1] if pos.flags & MessageObject.POSITION_FLAG_BOTTOM else True
                    top = run[0][2] if pos.flags & MessageObject.POSITION_FLAG_TOP else True
                    unit.append(Entry(msg, bottom, top, group, pos, row, x, cell_width))
                units.append(unit)
            index = end
        return units

    def _draw_all(self, prepared, opt, pieces):
        chat = self.chat
        self.theme = chat.getResourceProvider()
        self.res = get_private_field(chat, "sharedResources")
        if self.theme is None or self.res is None:
            return
        self.delegate = Delegate(chat)
        width, screen_h = self._surface_size()
        try:
            for unit in self._plan(prepared, width, opt.hide_media):
                shots = [shot for shot in (self._draw_entry(entry, opt, width, screen_h) for entry in unit) if shot]
                if unit[0].group is None:
                    pieces.extend(Piece(*shot[:5]) for shot in shots)
                elif shots:
                    self._compose_album(shots, width, pieces)
        finally:
            for cell in (self._cell, self._action_cell):
                if cell is not None:
                    quietly(cell.onDetachedFromWindow)

    def _draw_entry(self, entry, opt, width, screen_h):
        msg = entry.msg
        try:
            with patched_message(msg, opt):
                if is_action_msg(msg):
                    return self._draw_action(msg, opt, width, screen_h)
                return self._draw_message(entry, opt, width, screen_h)
        except Exception as e:
            qlog(f"Message render skipped ({quietly(msg.getId, 'unknown')}): {e}")
            return None

    def _message_cell(self):
        if self._cell is None:
            current_chat, current_user = self.chat.getCurrentChat(), self.chat.getCurrentUser()
            cell = ChatMessageCell(self.ctx, self.chat.getCurrentAccount(), True, self.res, self.theme)
            cell.onAttachedToWindow()
            cell.setDelegate(self.delegate)
            cell.isChat = current_chat is not None
            cell.isBot = current_user is not None and bool(current_user.bot)
            cell.isMegagroup = current_chat is not None and ChatObject.isChannel(current_chat) and bool(current_chat.megagroup)
            cell.drawingToBitmap = True
            cell.setFullyDraw(True)
            self._cell = cell
        return self._cell

    def _draw_message(self, entry, opt, width, screen_h):
        msg, pos = entry.msg, entry.pos
        cell = self._message_cell()
        receivers = [r for r in (get_private_field(cell, name) for name in CELL_IMAGE_FIELDS) if r is not None]
        for receiver in receivers:
            receiver.setAllowLoadingOnAttachedOnly(False)
        outgoing = msg.isOutOwner()
        w = int(entry.width) if entry.width else width
        cell.setParentViewSize(width, screen_h)
        cell.setMessageObject(msg, entry.group, entry.bottom_near, entry.top_near, False)
        cell.measure(View.MeasureSpec.makeMeasureSpec(w, EXACTLY), View.MeasureSpec.makeMeasureSpec(0, UNSPECIFIED))
        h = cell.getMeasuredHeight()
        if h <= 0:
            return None
        cell.layout(0, 0, w, h)
        decor = self._album_decor_bottom(cell, entry.group, pos) if pos is not None else 0
        if opt.hide_time:
            set_private_field(cell, "timeLayout", None)
        if opt.hide_status:
            set_private_field(cell, "animateToStatusDrawableParams", Integer(0))
            set_private_field(cell, "statusDrawableAnimationInProgress", True)
            set_private_field(cell, "viewsLayout", None)
            set_private_field(cell, "repliesLayout", None)
        cell.setParentViewSize(width, screen_h)
        quietly(lambda: cell.setVisiblePart(0, h, screen_h, 0.0, 0.0, width, screen_h, 0, 0, 0))
        loader = ImageLoader.getInstance()
        for receiver in receivers:
            quietly(lambda: loader.loadImageForImageReceiver(receiver))
        if msg.type == MessageObject.TYPE_POLL:
            try:
                buttons = cell.getPollButtons()
                if buttons is not None and buttons.size() > 0:
                    cell.firstVisiblePollButton = 0
                    cell.lastVisiblePollButton = buttons.size() - 1
            except Exception:
                pass

        left, right = 0, w
        bounds_left, bounds_right = cell.getBoundsLeft(), cell.getBoundsRight()
        if bounds_right > bounds_left:
            left = max(0, bounds_left)
            right = min(w, max(left + 1, bounds_right))
        if right <= left:
            left, right = 0, w
        extra = 0
        if outgoing:
            extra = dp(64) + (dp(170) if msg.messageOwner.reply_to is not None else 0)
        left = max(0, left - dp(14))
        right = min(w, max(left + 1, right + extra))

        force_avatar = bool(getattr(msg, "forceAvatar", False)) or getattr(msg, "customAvatarDrawable", None) is not None
        avatar_slot = not outgoing and (not entry.bottom_near or force_avatar)
        if pos is not None and not cell.isAvatarVisible:
            avatar_slot = False
        draw_avatar = cell.isAvatarVisible and avatar_slot
        avatar_size = dp(42)
        avatar_y = h - avatar_size - dp(4)
        inset = -avatar_y if draw_avatar and avatar_y < 0 else 0

        bmp = new_bitmap(max(1, width - int(entry.x)) if pos is not None else w, h + inset)
        canvas = Canvas(bmp)
        if quietly(cell.drawBackgroundInParent, False):
            attempt("Background draw", lambda: draw_shifted(
                canvas, inset + cell.getPaddingTop(), lambda: cell.drawBackgroundInternal(canvas, True)))
        draw_shifted(canvas, inset, lambda: cell.draw(canvas))
        if pos is not None:
            draw_shifted(canvas, inset + cell.getPaddingTop(), lambda: self._draw_group_extras(canvas, cell, pos))

        receiver = cell_avatar = manual_avatar = None
        if draw_avatar:
            receiver = cell.getAvatarImage()
            cell_avatar = shift(receiver_bounds(receiver), inset)
        if avatar_slot and not entry.bottom_near:
            avatar = cell.getAvatarImage()
            if avatar is not None:
                receiver = avatar
                if not opt.anon_avatar:
                    def draw_avatar_image():
                        avatar.setImageCoords(dp(6), avatar_y, avatar_size, avatar_size)
                        avatar.setVisible(True, False)
                        avatar.draw(canvas)
                    draw_shifted(canvas, inset, draw_avatar_image)
            if avatar is not None or opt.anon_avatar:
                manual_avatar = (dp(6), avatar_y + inset, dp(6) + avatar_size, avatar_y + avatar_size + inset)
        avatar_bounds = manual_avatar or cell_avatar
        avatar_radius = round_radius(receiver, avatar_bounds)
        for bounds in (cell_avatar, manual_avatar):
            if bounds:
                left = max(0, min(left, bounds[0] - dp(6)))

        if opt.anon_nick or opt.anon_avatar or opt.anon_usernames:
            try:
                text_key = Theme.key_chat_messageTextOut if outgoing else Theme.key_chat_messageTextIn
                text_color = quietly(lambda: theme_color(text_key, self.theme))

                def mask(bounds, **kwargs):
                    if bounds:
                        draw_mask(canvas, bmp, *bounds, style=opt.style, text_color=text_color, **kwargs)

                if opt.anon_usernames:
                    for bounds in username_bounds(cell, msg):
                        mask(shift(bounds, inset))
                if opt.anon_nick:
                    names = [reply_name_bounds(cell), forward_bounds(cell), via_bounds(cell)]
                    for bounds in names if opt.fake_name else [name_bounds(cell)] + names:
                        mask(shift(bounds, inset))
                if opt.anon_avatar:
                    for bounds in (avatar_bounds, shift(name_avatar_bounds(cell), inset)):
                        mask(bounds, clip_circle=True, clip_radius=avatar_radius)
            except Exception as e:
                qlog(f"Anonymize draw error: {e}")
        return Shot(bmp, left, right, h, inset, entry.x, entry.row, decor)

    def _draw_group_extras(self, canvas, cell, pos):
        flags = pos.flags
        left_column = flags & MessageObject.POSITION_FLAG_LEFT
        if pos.last:
            attempt("Album time draw", lambda: cell.drawTime(canvas, 1.0, True))
        if pos.minX == 0 and pos.minY == 0:
            attempt("Album name draw", lambda: cell.hasNameLayout() and cell.drawNamesLayout(canvas, 1.0))
        attempt("Album caption draw",
                lambda: flags & cell.captionFlag() and cell.drawCaptionLayout(canvas, not left_column, 1.0))
        if flags & MessageObject.POSITION_FLAG_BOTTOM and left_column:
            attempt("Album reactions draw",
                    lambda: (cell.drawCommentLayout(canvas, 1.0), cell.drawReactionsLayout(canvas, 1.0, None)))

    def _album_decor_bottom(self, cell, group, pos):
        try:
            siblings = getattr(pos, "siblingHeights", None)
            if siblings is None or len(siblings) == 0:
                return 0
            max_height = max(AndroidUtilities.displaySize.x, AndroidUtilities.displaySize.y) * 0.5
            extra = cell.getExtraInsetHeight() + sum(math.ceil(max_height * float(h)) for h in siblings)
            extra += (pos.maxY - pos.minY) * int(round(7 * AndroidUtilities.density))
            for index in range(group.posArray.size()):
                other = group.posArray.get(index)
                if other.minY != pos.minY or (other.minX == pos.minX and other.maxX == pos.maxX and other.maxY == pos.maxY):
                    continue
                extra -= math.ceil(max_height * other.ph) - dp(4)
                break
            return -extra
        except Exception as e:
            qlog(f"Album sibling inset failed: {e}")
            return 0

    def _action_cell_view(self):
        if self._action_cell is None:
            current_chat = self.chat.getCurrentChat()
            cell = ChatActionCell(self.ctx, False, self.theme)
            cell.onAttachedToWindow()
            quietly(lambda: setattr(cell, "isForum", current_chat is not None and ChatObject.isForum(current_chat)))
            quietly(lambda: setattr(cell, "isMonoForum", current_chat is not None and ChatObject.isMonoForum(current_chat)))
            quietly(lambda: cell.setShowTopic(True))
            self._action_cell = cell
        return self._action_cell

    def _draw_action(self, msg, opt, width, screen_h):
        try:
            cell = self._action_cell_view()
            cell.setMessageObject(msg, True)
            photo = cell.getPhotoImage()
            if photo is not None:
                photo.setAllowLoadingOnAttachedOnly(False)
                ImageLoader.getInstance().loadImageForImageReceiver(photo)
            cell.measure(View.MeasureSpec.makeMeasureSpec(width, EXACTLY), View.MeasureSpec.makeMeasureSpec(0, UNSPECIFIED))
            h = cell.getMeasuredHeight()
            if h <= 0:
                return None
            cell.layout(0, 0, width, h)
            quietly(lambda: cell.setVisiblePart(0.0, screen_h))
            bmp = new_bitmap(width, h)
            canvas = Canvas(bmp)
            cell.draw(canvas)
            left, right = 0, width
            bg_left, bg_right = get_private_field(cell, "backgroundLeft"), get_private_field(cell, "backgroundRight")
            if bg_left is not None and bg_right is not None and bg_right > bg_left:
                left = max(0, bg_left - dp(8))
                right = min(width, max(left + 1, bg_right + dp(8)))
            if opt.anon_avatar and not msg.isDateObject:
                bounds = receiver_bounds(photo)
                if bounds:
                    draw_mask(canvas, bmp, *bounds, clip_circle=True, clip_radius=round_radius(photo, bounds),
                              style=opt.style, text_color=quietly(lambda: theme_color(Theme.key_chat_serviceText, self.theme)))
            return Shot(bmp, left, right, h, 0, 0, None, 0)
        except Exception as e:
            qlog(f"Action cell render failed: {e}")
            return None

    def _compose_album(self, shots, width, pieces):
        try:
            row_heights = {}
            for shot in shots:
                row = shot.row or 0
                row_heights[row] = max(row_heights.get(row, 0), shot.height + shot.decor)
            row_tops, total = {}, 0
            for row in sorted(row_heights):
                row_tops[row] = total
                total += max(0, row_heights[row])
            logical_h = max(1, total)
            tops = [row_tops[shot.row or 0] - shot.inset for shot in shots]
            inset = max([0] + [-top for top in tops])
            height = max([inset + logical_h] + [inset + top + shot.bmp.getHeight() for top, shot in zip(tops, shots)])
            album = new_bitmap(width, height)
            canvas = Canvas(album)
            left, right = None, 0
            for top, shot in zip(tops, shots):
                canvas.drawBitmap(shot.bmp, float(shot.x), float(inset + top), None)
                shot_left = max(0, min(width, shot.left + shot.x))
                left = shot_left if left is None else min(left, shot_left)
                right = max(right, max(0, min(width, shot.right + shot.x)))
            if left is None or right <= left:
                left, right = 0, width
            pieces.append(Piece(album, left, right, logical_h, inset))
        except Exception as e:
            qlog(f"Album compose failed: {e}")
        finally:
            for shot in shots:
                quietly(shot.bmp.recycle)

    def _compose(self, pieces, bg_bmp, transparent):
        left = min(piece.left for piece in pieces)
        right = max(piece.right for piece in pieces)
        if right <= left:
            left, right = 0, max(piece.bmp.getWidth() for piece in pieces)
        placed, y, min_y, max_y = [], 0, 0, 0
        for index, piece in enumerate(pieces):
            top = y - piece.inset
            min_y, max_y = min(min_y, top), max(max_y, top + piece.bmp.getHeight())
            placed.append((piece.bmp, top))
            y += piece.height + (dp(2) if index < len(pieces) - 1 else 0)
        pad = dp(8) if transparent else dp(self.pl._setting_int("image_padding", 16, 0, 48))
        final = new_bitmap(max(1, right - left) + pad * 2, max(1, max_y - min_y) + pad * 2)
        canvas = Canvas(final)
        if not transparent:
            self._draw_background(canvas, final, bg_bmp)
        for bmp, top in placed:
            canvas.drawBitmap(bmp, float(pad - left), float(pad + top - min_y), None)
            bmp.recycle()
        return final

    def _draw_background(self, canvas, final, bg_bmp):
        bg_type = self.pl.get_setting("bg_type", 0)
        width, height = final.getWidth(), final.getHeight()
        if bg_type == 0 and bg_bmp is not None:
            bg_w, bg_h = bg_bmp.getWidth(), bg_bmp.getHeight()
            scale = max(width / bg_w, height / bg_h)
            src_left, src_top = int((bg_w * scale - width) / 2 / scale), int((bg_h * scale - height) / 2 / scale)
            src = Rect(src_left, src_top, int(src_left + width / scale), int(src_top + height / scale))
            canvas.drawBitmap(bg_bmp, src, Rect(0, 0, width, height), None)
        elif bg_type == 2:
            color = self.pl._setting_color_int("bg_color", "#FF000000")
            if color != 0:
                canvas.drawColor(jcolor(color))
        elif bg_type == 0:
            canvas.drawColor(jcolor(0xFF000000))

    def _encode(self, final, transparent, count):
        factor = 1.0 if transparent or self.sticker else self.pl._render_scale_factor()
        if factor != 1.0:
            final = swap_bitmap(final, scale_bitmap(final, factor))
        self.pl._draw_watermark(Canvas(final), final, self.chat, count, factor)
        jpeg = not transparent and not self.sticker and self.pl._format().name == "JPEG"
        if not jpeg and not self.sticker:
            radius = dp(self.pl._setting_int("corner_radius", 0, 0, 48))
            if radius > 0:
                final = swap_bitmap(final, round_corners(final, int(radius * factor)))
        out = ByteArrayOutputStream()
        if jpeg:
            final = swap_bitmap(final, flatten_alpha(final))
            final.compress(Bitmap.CompressFormat.JPEG, self.pl._setting_int("jpeg_quality", 92, 40, 100), out)
        else:
            final.compress(Bitmap.CompressFormat.PNG, 100, out)
        final.recycle()
        return out.toByteArray()


class QuotePreviewSheet:
    def __init__(self, plugin, chat, data, msgs, reply_to):
        self.plugin, self.chat, self.data, self.msgs, self.reply_to = plugin, chat, data, msgs, reply_to
        self.activity = chat.getParentActivity()
        self.provider = chat.getResourceProvider()
        self.account = chat.getCurrentAccount()
        self.dialog_id = chat.getDialogId()
        self.sheet = self.bitmap = self.preview_view = self.progress_view = self.meta_view = None
        self.size = (0, 0)
        self.rendering = False
        self.generation = 0
        self.toggles = {}
        self.anon_rows = []
        self.bounce = _BounceTouch()
        self.text_color = self.color(Theme.key_dialogTextBlack)
        self.surface = with_alpha(self.text_color, 0.05)

    def color(self, key):
        return theme_color(key, self.provider)

    def notify(self, text, icon_name):
        sheet, icon = self.sheet, getattr(R.raw, icon_name, 0)
        if sheet is not None and icon and sheet.isShowing():
            try:
                return BulletinFactory.of(sheet.getContainer(), self.provider).createSimpleBulletin(icon, text).show()
            except Exception as e:
                qlog(f"Sheet bulletin failed: {e}")
        show_done(text, icon_name)

    def show(self):
        self.bitmap, self.size = decode_preview(self.data)
        try:
            sheet = BottomSheet(self.activity, False, self.provider)
            background = jcolor(self.color(Theme.key_dialogBackground))
            sheet.setBackgroundColor(background)
            sheet.fixNavigationBar(background)
            sheet.setOnHideListener(_DismissListener(self._on_hide))
            self.sheet = sheet
            sheet.setCustomView(self._build())
            sheet.show()
        except Exception:
            self._on_hide()
            raise

    def _on_hide(self):
        if self.preview_view is not None:
            quietly(lambda: self.preview_view.setImageBitmap(None))
        self.preview_view = self.sheet = None
        if self.bitmap is not None:
            self.bitmap.recycle()
            self.bitmap = None

    def _build(self):
        ctx, plugin = self.activity, self.plugin
        content = LinearLayout(ctx)
        content.setOrientation(LinearLayout.VERTICAL)
        content.setPadding(dp(12), dp(12), dp(12), dp(12))
        count = len(self.msgs)
        title = f"Цитата · {count} {plural_ru(count, 'сообщение', 'сообщения', 'сообщений')}"
        content.addView(text_view(ctx, title, 20, self.text_color, bold=True), LayoutHelper.createLinear(-1, -2))
        content.addView(self._toggle_row(), LayoutHelper.createLinear(-1, -2, 0, 10, 0, 0))
        content.addView(self._preview_card(), LayoutHelper.createLinear(-1, -2, 0, 0, 8, 0, 0))
        content.addView(self._anon_card(), LayoutHelper.createLinear(-1, -2, 0, 0, 8, 0, 0))

        send_here = ButtonWithCounterView(ctx, True, self.provider)
        send_here.setText("Отправить сюда", False)
        self._clickable(send_here, self._guarded(lambda v: plugin._send(
            self.data, self.account, self.dialog_id, self.reply_to, "photo"), dismiss=True))
        content.addView(send_here, LayoutHelper.createLinear(-1, 52, 0, 0, 8, 0, 6))

        fill, text = self.color(Theme.key_buttonNeutral), self.color(Theme.key_buttonNeutralText)
        other_chat = self._action_button("В другой чат", self._guarded(
            lambda v: plugin._pick_chat_and_send(self.data), dismiss=True), fill, text, subtitle="выбрать получателя")
        content.addView(other_chat, LayoutHelper.createLinear(-1, -2, 0, 0, 0, 0, 6))

        content.addView(self._button_row(
            self._action_button("Файл", self._guarded(lambda v: plugin._send(
                self.data, self.account, self.dialog_id, self.reply_to, "file"), dismiss=True),
                fill, text, subtitle=plugin._format_hint()),
            self._action_button("Стикер", self._guarded(
                lambda v: plugin._render_sticker(self.msgs, self.chat, self.reply_to), dismiss=True),
                fill, text, subtitle="webp до 512 КБ"),
        ), LayoutHelper.createLinear(-1, -2, 0, 0, 0, 0, 6))

        def utility(title, icon, action):
            return self._action_button(title, self._guarded(action), fill, text, icon=icon,
                                       radius=14, min_height=40, icon_size=18)

        content.addView(self._button_row(
            utility("Копировать", drawable("msg_copy_solar", "msg_copy"),
                    lambda v: plugin._copy(self.data, v, self.notify)),
            utility("В галерею", drawable("msg_gallery_solar", "msg_gallery"),
                    lambda v: plugin._save_gallery(self.data, self.activity, v, self.notify)),
            utility("Поделиться", drawable("msg_share_solar", "msg_share"),
                    lambda v: plugin._share(self.data, self.activity, v)),
        ), LayoutHelper.createLinear(-1, -2))

        self._sync_controls()
        scroll = ScrollView(ctx)
        scroll.setFillViewport(True)
        scroll.setVerticalScrollBarEnabled(False)
        scroll.setClipToPadding(False)
        scroll.addView(content, LayoutHelper.createFrame(-1, -2))
        return scroll

    def _toggle_row(self):
        row = LinearLayout(self.activity)
        row.setOrientation(LinearLayout.HORIZONTAL)
        row.setGravity(Gravity.CENTER_VERTICAL)
        for key, icons, title in DISPLAY_TOGGLES:
            icon = drawable(*icons)
            if not icon:
                continue
            params = LinearLayout.LayoutParams(-2, dp(34))
            if row.getChildCount():
                params.leftMargin = dp(6)
            row.addView(self._toggle_button(key, icon, title), params)
        scroll = HorizontalScrollView(self.activity)
        scroll.setHorizontalScrollBarEnabled(False)
        scroll.setClipToPadding(False)
        scroll.addView(row, LayoutHelper.createFrame(-2, -2))
        return scroll

    def _toggle_button(self, key, icon_res, title):
        button = LinearLayout(self.activity)
        button.setOrientation(LinearLayout.HORIZONTAL)
        button.setGravity(Gravity.CENTER)
        button.setPadding(dp(10), dp(7), dp(12), dp(7))
        button.setContentDescription(title)
        icon = ImageView(self.activity)
        icon.setScaleType(ImageView.ScaleType.CENTER_INSIDE)
        icon.setImageResource(icon_res)
        params = LinearLayout.LayoutParams(dp(17), dp(17))
        params.rightMargin = dp(6)
        button.addView(icon, params)
        label = text_view(self.activity, title, 13, self.text_color, bold=True)
        button.addView(label, LinearLayout.LayoutParams(-2, -2))
        self.toggles[key] = (button, icon, label)
        self._clickable(button, lambda v: self._toggle(key))
        return button

    def _preview_card(self):
        ctx = self.activity
        shell = FrameLayout(ctx)
        shell.setPadding(dp(8), dp(8), dp(8), dp(8))
        shell.setBackground(rounded(self.surface, 16))

        preview = ImageView(ctx)
        preview.setAdjustViewBounds(True)
        preview.setScaleType(ImageView.ScaleType.FIT_CENTER)
        preview.setImageBitmap(self.bitmap)
        preview.setClickable(True)
        preview.setFocusable(True)
        preview.setContentDescription("Открыть превью на весь экран")
        preview.setOnClickListener(OnClickListener(lambda v: self._open_zoom()))
        self.preview_view = preview
        shell.addView(preview, LayoutHelper.createFrame(-1, -2, Gravity.CENTER))

        progress = FrameLayout(ctx)
        progress.setBackground(rounded(with_alpha(self.color(Theme.key_dialogBackground), 0.6), 16))
        progress.setClickable(True)
        progress.setVisibility(View.GONE)
        spinner = RadialProgressView(ctx, self.provider)
        spinner.setSize(dp(28))
        spinner.setProgressColor(jcolor(self.color(Theme.key_featuredStickers_addButton)))
        progress.addView(spinner, LayoutHelper.createFrame(40, 40, Gravity.CENTER))
        self.progress_view = progress
        shell.addView(progress, LayoutHelper.createFrame(-1, -1, Gravity.CENTER))

        meta_row = LinearLayout(ctx)
        meta_row.setOrientation(LinearLayout.HORIZONTAL)
        meta_row.setGravity(Gravity.CENTER_VERTICAL)
        self.meta_view = text_view(ctx, self._meta_text(), 12, with_alpha(self.text_color, 0.55))
        meta_row.addView(self.meta_view, LinearLayout.LayoutParams(0, -2, 1.0))
        meta_row.addView(text_view(ctx, "нажмите, чтобы увеличить", 12, with_alpha(self.text_color, 0.4)),
                         LinearLayout.LayoutParams(-2, -2))

        card = LinearLayout(ctx)
        card.setOrientation(LinearLayout.VERTICAL)
        card.setPadding(dp(10), dp(10), dp(10), dp(10))
        card.setBackground(rounded(self.surface, 20))
        card.addView(shell, LayoutHelper.createLinear(-1, -2))
        card.addView(meta_row, LayoutHelper.createLinear(-1, -2, 4, 8, 4, 0))
        return card

    def _meta_text(self):
        size = len(self.data)
        parts = ["{}×{}".format(*self.size), self.plugin._format().name, format_bytes(size)]
        text = " · ".join(parts)
        return text + " · для стикера будет сжато" if size > STICKER_MAX_BYTES else text

    def _anon_card(self):
        card = LinearLayout(self.activity)
        card.setOrientation(LinearLayout.VERTICAL)
        card.setBackground(rounded(self.surface, 14))
        card.setClipToOutline(True)
        for title, key, divider in (("Скрыть имя", "anonymize_nickname", True), ("Скрыть аватар", "anonymize_avatar", False)):
            row = TextCheckCell(self.activity, self.provider)
            row.setTextAndCheck(title, bool(self.plugin.get_setting(key, False)), divider)
            row.setBackground(self._tap_bg(0, 0, 0.15))
            row.setOnClickListener(OnClickListener(lambda v, key=key, row=row: self._toggle(key, row)))
            self.anon_rows.append(row)
            card.addView(row, LayoutHelper.createLinear(-1, -2))
        return card

    def _button_row(self, *buttons):
        row = LinearLayout(self.activity)
        row.setOrientation(LinearLayout.HORIZONTAL)
        row.setGravity(Gravity.CENTER_VERTICAL)
        last = len(buttons) - 1
        for index, button in enumerate(buttons):
            row.addView(button, LayoutHelper.createLinear(0, -2, 1.0, 4 if index else 0, 0, 4 if index < last else 0, 0))
        return row

    def _action_button(self, title, on_click, fill, text_color, subtitle=None, icon=0, radius=16, min_height=46, icon_size=20):
        ctx = self.activity
        content = LinearLayout(ctx)
        content.setOrientation(LinearLayout.VERTICAL)
        content.setGravity(Gravity.CENTER)
        padding = dp(7 if icon and not subtitle else 9)
        content.setPadding(dp(12), padding, dp(12), padding)
        if icon:
            image = ImageView(ctx)
            image.setScaleType(ImageView.ScaleType.CENTER_INSIDE)
            image.setImageResource(icon)
            image.setColorFilter(jcolor(text_color))
            content.addView(image, LinearLayout.LayoutParams(dp(icon_size), dp(icon_size)))
        else:
            label = text_view(ctx, title, 14, text_color)
            label.setGravity(Gravity.CENTER)
            label.setTypeface(Typeface.DEFAULT_BOLD)
            content.addView(label)
        if subtitle:
            hint = text_view(ctx, subtitle, 11.5, with_alpha(text_color, 0.72), single_line=False)
            hint.setGravity(Gravity.CENTER)
            content.addView(hint, LayoutHelper.createLinear(-1, -2, 0, 0, 3, 0, 0))
        button = FrameLayout(ctx)
        button.setMinimumHeight(dp(min_height))
        button.setContentDescription(title)
        button.setBackground(self._tap_bg(fill, radius, 0.22))
        button.addView(content, LayoutHelper.createFrame(-1, -2, Gravity.CENTER))
        self._clickable(button, on_click)
        return button

    def _clickable(self, view, on_click):
        view.setClickable(True)
        view.setFocusable(True)
        view.setOnClickListener(OnClickListener(on_click))
        view.setOnTouchListener(self.bounce)

    def _tap_bg(self, fill, radius, ripple_alpha):
        ripple = with_alpha(self.color(Theme.key_listSelector), ripple_alpha)
        return RippleDrawable(ColorStateList.valueOf(jcolor(ripple)), rounded(fill, radius), None)

    def _guarded(self, action, dismiss=False):
        def on_click(view):
            if self.rendering:
                return
            if dismiss and self.sheet is not None:
                self.sheet.dismiss()
            action(view)
        return on_click

    def _toggle(self, key, check_cell=None):
        if self.rendering:
            return
        value = not self.plugin.get_setting(key, False)
        self.plugin.set_setting(key, value)
        if check_cell is not None:
            check_cell.setChecked(value)
        self._rerender()

    def _sync_controls(self):
        busy = self.rendering
        alpha = 0.5 if busy else 1.0
        for row in self.anon_rows:
            row.setAlpha(alpha)
            row.setClickable(not busy)
        for key, (button, icon, label) in self.toggles.items():
            enabled = bool(self.plugin.get_setting(key, False))
            fill = self.color(Theme.key_featuredStickers_addButton if enabled else Theme.key_buttonNeutral)
            text = jcolor(self.color(Theme.key_featuredStickers_buttonText if enabled else Theme.key_buttonNeutralText))
            button.setBackground(self._tap_bg(fill, 17, 0.18))
            icon.setColorFilter(text)
            label.setTextColor(text)
            button.setAlpha(alpha)
            button.setClickable(not busy)
        if self.progress_view is not None:
            self.progress_view.setVisibility(View.VISIBLE if busy else View.GONE)
        if self.preview_view is not None:
            self.preview_view.setClickable(not busy)

    def _rerender(self):
        self.generation += 1
        generation = self.generation
        self.rendering = True
        self._sync_controls()
        run_on_queue(lambda: self._render_task(generation), PLUGINS_QUEUE, PREVIEW_DEBOUNCE_MS)

    def _render_task(self, generation):
        if generation != self.generation or self.sheet is None:
            return
        bg = data = error = None
        try:
            bg = self.plugin._chat_background(self.chat)
            data = self.plugin._render_bytes(self.msgs, self.chat, bg)
            if not data:
                error = "пустой результат рендера"
        except Exception as e:
            error = str(e)
        finally:
            if bg is not None:
                bg.recycle()
        run_on_ui_thread(lambda: self._apply_render(generation, data, error))

    def _apply_render(self, generation, data, error):
        if generation != self.generation:
            return
        if error is None:
            try:
                self._swap_preview(data)
            except Exception as e:
                error = str(e)
        self.rendering = False
        self._sync_controls()
        if error:
            BulletinHelper.show_error(f"Не удалось обновить превью: {error[:80]}")

    def _swap_preview(self, data):
        bitmap, size = decode_preview(data)
        if self.sheet is None:
            bitmap.recycle()
            return
        old, self.bitmap, self.size, self.data = self.bitmap, bitmap, size, data
        self.preview_view.setImageBitmap(bitmap)
        old.recycle()
        self.meta_view.setText(self._meta_text())

    def _open_zoom(self):
        if self.rendering or self.bitmap is None:
            return
        try:
            ZoomPreviewDialog(self.activity, self.bitmap).show()
        except Exception as e:
            qlog(f"Zoom preview failed: {e}")


class _ScaleListener(dynamic_proxy(ScaleGestureDetector.OnScaleGestureListener)):
    def __init__(self, zoom):
        super().__init__()
        self.zoom = zoom

    def onScaleBegin(self, detector):
        return True

    def onScale(self, detector):
        self.zoom.set_scale(self.zoom.scale * float(detector.getScaleFactor()))
        return True

    def onScaleEnd(self, detector):
        pass


class _ZoomTouch(dynamic_proxy(View.OnTouchListener)):
    def __init__(self, zoom):
        super().__init__()
        self.zoom = zoom
        self.last_x = self.last_y = self.down_x = self.down_y = self.last_tap = 0.0
        self.tap = self.resync = False

    def onTouch(self, view, event):
        zoom = self.zoom
        try:
            zoom.detector.onTouchEvent(event)
            action = event.getActionMasked()
            x, y = float(event.getX()), float(event.getY())
            if action == MotionEvent.ACTION_DOWN:
                self.down_x, self.last_x, self.down_y, self.last_y = x, x, y, y
                now = time.time()
                double = now - self.last_tap < 0.3
                self.last_tap = 0.0 if double else now
                self.tap, self.resync = not double, False
                if double:
                    zoom.set_scale(1.0 if zoom.scale > 1.01 else 2.5)
            elif action in (MotionEvent.ACTION_POINTER_DOWN, MotionEvent.ACTION_POINTER_UP):
                self.tap, self.resync = False, True
            elif action == MotionEvent.ACTION_MOVE:
                if abs(x - self.down_x) > dp(8) or abs(y - self.down_y) > dp(8):
                    self.tap = False
                if event.getPointerCount() == 1 and zoom.scale > 1.01 and not self.resync:
                    zoom.pan(x - self.last_x, y - self.last_y)
                self.last_x, self.last_y, self.resync = x, y, False
            elif action == MotionEvent.ACTION_UP and self.tap and not zoom.hits_image(x, y):
                zoom.dismiss()
        except Exception as e:
            qlog(f"Zoom touch failed: {e}")
        return True


class ZoomPreviewDialog:
    def __init__(self, activity, bitmap):
        self.activity, self.bitmap = activity, bitmap
        self.scale, self.tx, self.ty = 1.0, 0.0, 0.0
        self.dialog = self.image = self.detector = self._listeners = None

    def show(self):
        ctx = self.activity
        root = FrameLayout(ctx)
        root.setBackgroundColor(jcolor(0xF00E0E0E))

        image = ImageView(ctx)
        image.setScaleType(ImageView.ScaleType.FIT_CENTER)
        image.setImageBitmap(self.bitmap)
        self.image = image
        root.addView(image, LayoutHelper.createFrame(-1, -1, Gravity.CENTER))

        hint = text_view(ctx, "Двойной тап — увеличить, тап вне картинки — закрыть", 12, 0x99FFFFFF, single_line=False)
        hint.setGravity(Gravity.CENTER)
        root.addView(hint, LayoutHelper.createFrame(-1, -2, Gravity.BOTTOM | Gravity.CENTER_HORIZONTAL, 16, 0, 16, 24))

        scale_listener, touch = _ScaleListener(self), _ZoomTouch(self)
        self._listeners = (scale_listener, touch)
        self.detector = ScaleGestureDetector(ctx, scale_listener)
        root.setOnTouchListener(touch)

        close = text_view(ctx, "Закрыть", 15, 0xFFFFFFFF, single_line=False)
        close.setPadding(dp(18), dp(12), dp(18), dp(12))
        close.setOnClickListener(OnClickListener(lambda v: self.dismiss()))
        root.addView(close, LayoutHelper.createFrame(-2, -2, Gravity.TOP | Gravity.RIGHT, 0, 8, 8, 0))

        dialog = Dialog(ctx, AndroidR.style.Theme_Translucent_NoTitleBar_Fullscreen)
        dialog.setContentView(root, ViewGroup.LayoutParams(-1, -1))
        window = dialog.getWindow()
        window.setBackgroundDrawableResource(AndroidR.color.transparent)
        window.setLayout(-1, -1)
        self.dialog = dialog
        dialog.show()

    def set_scale(self, value):
        self.scale = max(1.0, min(5.0, float(value)))
        if self.scale <= 1.01:
            self.tx = self.ty = 0.0
        self._sync()

    def pan(self, dx, dy):
        self.tx += dx
        self.ty += dy
        self._sync()

    def _sync(self):
        self.image.setScaleX(float(self.scale))
        self.image.setScaleY(float(self.scale))
        self.image.setTranslationX(float(self.tx))
        self.image.setTranslationY(float(self.ty))

    def hits_image(self, x, y):
        width, height = self.image.getWidth(), self.image.getHeight()
        bmp_w, bmp_h = self.bitmap.getWidth(), self.bitmap.getHeight()
        if width <= 0 or height <= 0 or bmp_w <= 0 or bmp_h <= 0:
            return True
        fit = min(width / bmp_w, height / bmp_h) * self.scale
        center_x = self.image.getLeft() + width / 2.0 + self.tx
        center_y = self.image.getTop() + height / 2.0 + self.ty
        return abs(x - center_x) <= bmp_w * fit / 2.0 and abs(y - center_y) <= bmp_h * fit / 2.0

    def dismiss(self):
        if self.dialog is not None:
            quietly(self.dialog.dismiss)
            self.dialog = None


def run_async(fn, error_prefix, limit=50):
    def task():
        try:
            fn()
        except Exception as e:
            log_exc(error_prefix)
            error = str(e)[:limit] if limit else str(e)
            run_on_ui_thread(lambda: BulletinHelper.show_error(f"{error_prefix}: {error}"))
    run_on_queue(task, PLUGINS_QUEUE)


def call_private(obj, name, types=(), args=()):
    method = obj.getClass().getDeclaredMethod(name, *types)
    method.setAccessible(True)
    return method.invoke(obj, *args)


class ExteraShotPlugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self.btn = None
        self.tmp = None
        self._bg_cache = None
        self._refs = {}
        self._settings_refs = []
        self._wm_previews = []
        self._logo_hook = None
        self._action_sel_ids = set()
        self._action_fill = None
        self._action_paint = None

    def on_plugin_load(self):
        self.tmp = self._tmp_dir()
        chat_cls = ChatActivity.getClass()
        self.hook_method(
            chat_cls.getDeclaredMethod("addToSelectedMessages", MessageObject, Boolean.TYPE, Boolean.TYPE),
            after_hook(lambda param: run_on_ui_thread(lambda: self._on_selection_changed(param.thisObject))))
        self.hook_method(
            chat_cls.getDeclaredMethod("hideActionMode"),
            after_hook(lambda param: run_on_ui_thread(lambda: self._on_action_mode_hidden(param.thisObject))))
        try:
            self.hook_method(
                chat_cls.getDeclaredMethod("processRowSelect", View, Boolean.TYPE, Float.TYPE, Float.TYPE),
                before_hook(self._on_row_select))
        except Exception as e:
            qlog(f"processRowSelect hook skipped: {e}")
        try:
            on_draw = ChatActionCell.getClass().getDeclaredMethod("onDraw", Canvas)
            on_draw.setAccessible(True)
            self.hook_method(on_draw, after_hook(self._draw_service_selection))
        except Exception as e:
            qlog(f"onDraw action hook skipped: {e}")
        try:
            self.add_menu_item(MenuItemData(
                menu_type=MenuItemType.MESSAGE_CONTEXT_MENU,
                item_id="quotecreate_make_quote",
                text="Сделать цитату",
                icon="msg_screencast",
                condition="message != null",
                on_click=self._on_menu_quote,
                priority=8,
            ))
        except Exception as e:
            qlog(f"Menu item registration failed: {e}")
        run_on_queue(self._cleanup_tmp, PLUGINS_QUEUE)
        if not self.get_setting("_first_run_done", False):
            self._blink_flash()
            self.set_setting("_first_run_done", True)

    def on_plugin_unload(self):
        run_on_ui_thread(self._remove_button)
        self._action_sel_ids = set()
        self._action_fill = None
        self._refs.clear()
        self._settings_refs = []
        self._wm_previews = []
        if self._bg_cache is not None:
            self._bg_cache[2].recycle()
            self._bg_cache = None
        self._cleanup_tmp(max_age=0)

    def _blink_flash(self):
        def task():
            context = ApplicationLoader.applicationContext
            if self.get_setting("load_vib", True):
                quietly(lambda: vibrate(context, 1300, 255))
            if not self.get_setting("load_flash", True):
                return
            try:
                from android.hardware.camera2 import CameraCharacteristics
                camera = context.getSystemService(Context.CAMERA_SERVICE)
                torch = next((camera_id for camera_id in camera.getCameraIdList() if camera.getCameraCharacteristics(
                    camera_id).get(CameraCharacteristics.FLASH_INFO_AVAILABLE)), None)
                if torch is None:
                    return
                for _ in range(5):
                    camera.setTorchMode(torch, True)
                    time.sleep(0.1)
                    camera.setTorchMode(torch, False)
                    time.sleep(0.1)
            except Exception:
                pass

        run_on_queue(task, PLUGINS_QUEUE)

    @staticmethod
    def _action_mode_on(chat):
        action_bar = chat.getActionBar()
        return action_bar is not None and action_bar.isActionModeShowed()

    def _on_selection_changed(self, chat):
        self._update_button(chat)
        self._sync_action_cells(chat)

    def _on_action_mode_hidden(self, chat):
        self._remove_button()
        self._sync_action_cells(chat)

    def _update_button(self, chat):
        try:
            if not self._action_mode_on(chat):
                return self._remove_button()
            container = get_private_field(chat, "actionsButtonsLayout")
            if container is None or container.findViewWithTag(BUTTON_TAG) is not None:
                return
            factory = get_private_field(chat, "glassBackgroundDrawableFactory")
            color_provider = get_private_field(chat, "blurredBackgroundColorProvider")
            if BlurredRoundButton is None or factory is None or color_provider is None:
                raise Exception("BlurredRoundButton not available")
            provider, icon = chat.getResourceProvider(), R.drawable.input_video_pressed_solar
            try:
                button = BlurredRoundButton.create(chat.getParentActivity(), factory, color_provider, provider, icon, 48)
            except Exception:
                button = BlurredRoundButton.create(chat.getParentActivity(), factory, color_provider, provider)
                button.setIcon(icon, 48)
                button.setIconColor(jcolor(theme_color(Theme.key_glass_defaultIcon, provider)))
            button.setTag(BUTTON_TAG)
            button.setOnClickListener(OnClickListener(lambda v: self._on_button_click(chat)))
            params = LinearLayout.LayoutParams(dp(56), dp(56))
            params.setMargins(dp(8), 0, dp(8), 0)
            container.addView(button, 1, params)
            self.btn = button
        except Exception as e:
            qlog(f"Action mode button failed: {e}")

    def _remove_button(self):
        parent = self.btn.getParent() if self.btn is not None else None
        if parent is not None:
            parent.removeView(self.btn)
        self.btn = None

    def _on_row_select(self, param):
        try:
            chat, view = param.thisObject, param.args[0]
            if not self._action_mode_on(chat) or not isinstance(view, ChatActionCell):
                return
            msg = view.getMessageObject()
            if not is_service_msg(msg):
                return
            call_private(chat, "addToSelectedMessages", (MessageObject, Boolean.TYPE), (msg, bool(param.args[1])))
            quietly(lambda: call_private(chat, "updateActionModeTitle"))
            quietly(chat.updateVisibleRows)
            self._sync_action_cells(chat)
            param.setResult(None)
        except Exception as e:
            qlog(f"processRowSelect hook error: {e}")

    def _sync_action_cells(self, chat):
        try:
            action_mode = self._action_mode_on(chat)
            selected = get_private_field(chat, "selectedMessagesIds") if action_mode else None
            ids = {msg.getId() for arr in (selected or []) for msg in (arr.valueAt(i) for i in range(arr.size()))
                   if is_service_msg(msg)}
            self._action_sel_ids = ids
            fill = theme_color(Theme.key_chat_serviceBackgroundSelected, chat.getResourceProvider()) if ids else None
            self._action_fill = (118 << 24) | (fill & 0xFFFFFF) if ids else None
            list_view = chat.getChatListView()
            for index in range(list_view.getChildCount() if list_view is not None else 0):
                cell = list_view.getChildAt(index)
                if isinstance(cell, ChatActionCell):
                    quietly(lambda: self._paint_action_cell(chat, cell, selected))
        except Exception as e:
            qlog(f"action cell visual update error: {e}")

    @staticmethod
    def _paint_action_cell(chat, cell, selected):
        msg = cell.getMessageObject()
        if selected is None:
            cell.setOverrideColor(-1, -1)
        elif is_service_msg(msg) and selected[0 if msg.getDialogId() == chat.getDialogId() else 1].indexOfKey(msg.getId()) >= 0:
            cell.setOverrideColor(Theme.key_chat_serviceBackgroundSelected, Theme.key_chat_serviceText)
        else:
            cell.setOverrideColor(Theme.key_chat_serviceBackground, Theme.key_chat_serviceText)
        cell.invalidate()

    def _draw_service_selection(self, param):
        if not self._action_sel_ids or self._action_fill is None:
            return
        try:
            cell, canvas = param.thisObject, param.args[0]
            msg = cell.getMessageObject()
            width, height = cell.getWidth(), cell.getHeight()
            if msg is None or msg.getId() not in self._action_sel_ids or width <= 0 or height <= 0:
                return
            if self._action_paint is None:
                self._action_paint = Paint(Paint.ANTI_ALIAS_FLAG)
            self._action_paint.setColor(jcolor(self._action_fill))
            canvas.drawRect(0.0, 0.0, float(width), float(height), self._action_paint)
        except Exception:
            pass

    def _on_button_click(self, chat):
        selected = get_private_field(chat, "selectedMessagesIds")
        msgs = sorted((arr.valueAt(i) for arr in (selected or []) for i in range(arr.size())), key=lambda m: m.getId())
        if not msgs:
            return BulletinHelper.show_error("Нет сообщений")
        quietly(chat.clearSelectionMode)
        self._render_quote(msgs, chat)

    def _on_menu_quote(self, context):
        try:
            msg, fragment = context.get("message"), context.get("fragment")
            if msg is None:
                return BulletinHelper.show_error("Не удалось получить сообщение")
            if not isinstance(fragment, ChatActivity):
                return BulletinHelper.show_error("Цитату можно создать только из чата")
            group = context.get("groupedMessages")
            items = getattr(group, "messages", None) if group is not None else None
            msgs = [items.get(i) for i in range(items.size())] if items is not None and items.size() else [msg]
            self._render_quote(sorted(msgs, key=lambda m: m.getId()), fragment)
        except Exception as e:
            qlog(f"Menu quote failed: {e}")
            BulletinHelper.show_error("Не удалось создать цитату")

    def _render_quote(self, msgs, chat):
        self._render_async(msgs, chat, "Рендер...", lambda data: self._show_preview(chat, data, msgs))

    def _render_sticker(self, msgs, chat, reply_to):
        account, dialog_id = chat.getCurrentAccount(), chat.getDialogId()
        self._render_async(msgs, chat, "Рендер стикера...",
                           lambda data: self._send(data, account, dialog_id, reply_to, "sticker"), sticker=True)

    def _render_async(self, msgs, chat, title, on_done, sticker=False):
        dialog = AlertDialogBuilder(chat.getParentActivity(), AlertDialogBuilder.ALERT_TYPE_SPINNER).set_title(title).show()
        transparent = sticker and bool(self.get_setting("transparent_sticker", True))

        def task():
            bg = None
            try:
                bg = self._chat_background(chat, transparent)
                data = self._render_bytes(msgs, chat, bg, transparent, sticker)
                if not data:
                    raise Exception("рендер вернул пустой результат")
                run_on_ui_thread(lambda: (dialog.dismiss(), on_done(data)))
            except Exception as e:
                log_exc("Render failed")
                error = str(e)
                run_on_ui_thread(lambda: (dialog.dismiss(), BulletinHelper.show_error(error)))
            finally:
                if bg is not None:
                    bg.recycle()

        run_on_queue(task, PLUGINS_QUEUE)

    def _render_bytes(self, msgs, chat, bg, transparent=False, sticker=False):
        preload_media(msgs, chat.getCurrentAccount())
        return Renderer(self, msgs, chat, sticker).render(bg, transparent)

    def _chat_background(self, chat, transparent=False):
        if transparent or self.get_setting("bg_type", 0) != 0:
            return None
        key = (chat.getDialogId(), AndroidUtilities.displaySize.x, AndroidUtilities.displaySize.y)
        now, cached = time.time(), self._bg_cache
        if not (cached and cached[0] == key and now - cached[1] < 4.0 and not cached[2].isRecycled()):
            bmp = wallpaper_bitmap(chat)
            if bmp is None:
                return None
            if cached:
                cached[2].recycle()
            self._bg_cache = cached = (key, now, bmp)
        return cached[2].copy(cached[2].getConfig(), False)

    def _show_preview(self, chat, data, msgs):
        account, dialog_id = chat.getCurrentAccount(), chat.getDialogId()
        reply_to = quietly(chat.getThreadMessage)
        if reply_to is None:
            reply_to = make_top_reply(account, quietly(chat.getTopicId, 0) or 0, dialog_id)
        if reply_to is None:
            reply_to = make_top_reply(account, msg_topic_id(account, msgs[0], dialog_id), dialog_id)
        try:
            QuotePreviewSheet(self, chat, data, msgs, reply_to).show()
        except Exception as e:
            qlog(f"Preview sheet failed: {e}")
            BulletinHelper.show_error("Не удалось открыть предпросмотр")

    def _send(self, data, account, dialog_id, reply_to, mode="photo"):
        def prepare():
            if mode == "sticker":
                bmp = BitmapFactory.decodeByteArray(data, 0, len(data))
                if bmp is None:
                    raise Exception("не удалось декодировать изображение")
                bmp = sticker_bitmap(bmp)
                path = self._tmp_path(f"q_{int(time.time())}.webp")
                try:
                    write_sticker_webp(bmp, path)
                finally:
                    bmp.recycle()
            else:
                path = self._write_tmp(f"q_{int(time.time())}.{self._format().ext}", data)
            run_on_ui_thread(lambda: self._send_file(path, account, dialog_id, reply_to, mode))

        run_async(prepare, "Ошибка")

    def _send_file(self, path, account, dialog_id, reply_to, mode):
        if mode == "sticker":
            return self._send_webp(path, account, dialog_id, reply_to)
        try:
            instance = AccountInstance.getInstance(account)
            values = {"org.telegram.messenger.AccountInstance": [instance], "long": [jlong(dialog_id)],
                      "org.telegram.messenger.MessageObject": [reply_to, reply_to], "boolean": [True]}
            required = {"org.telegram.messenger.AccountInstance": 1, "long": 1, "org.telegram.messenger.MessageObject": 2}
            if mode == "file":
                mime = self._format().mime
                call_static_compat(
                    "org.telegram.messenger.SendMessagesHelper", "prepareSendingDocument",
                    lambda: SendMessagesHelper.prepareSendingDocument(
                        instance, path, path, None, None, mime, dialog_id, reply_to, reply_to,
                        None, None, None, True, 0, None, None, 0, False),
                    {**values, "java.lang.String": [path, path, None, mime]}, {**required, "java.lang.String": 4})
            else:
                call_static_compat(
                    "org.telegram.messenger.SendMessagesHelper", "prepareSendingPhoto",
                    lambda: SendMessagesHelper.prepareSendingPhoto(
                        instance, path, None, dialog_id, reply_to, reply_to, None, None, None,
                        None, None, 0, None, True, 0, 0, None, 0),
                    {**values, "java.lang.String": [path]}, {**required, "java.lang.String": 1})
            show_done("Отправлено", "forward")
        except Exception as e:
            log_exc("Send error")
            BulletinHelper.show_error(f"Ошибка: {str(e)[:120]}")

    def _send_webp(self, path, account, dialog_id, reply_to):
        try:
            file = File(path)
            if not file.exists():
                raise Exception("файл стикера не найден")
            options = BitmapFactory.Options()
            options.inJustDecodeBounds = True
            BitmapFactory.decodeFile(path, options)
            width, height = options.outWidth, options.outHeight
            if width <= 0 or height <= 0:
                raise Exception("не удалось прочитать размеры стикера")
            if width > 512 or height > 512:
                raise Exception(f"стикер слишком большой: {width}×{height}")
            document = TLRPC.TL_document()
            document.id = 0
            document.access_hash = 0
            document.file_reference = bytearray()
            document.date = int(time.time())
            document.mime_type = "image/webp"
            document.size = file.length()
            document.dc_id = 0
            name_attr = TLRPC.TL_documentAttributeFilename()
            name_attr.file_name = file.getName()
            sticker_attr = TLRPC.TL_documentAttributeSticker()
            sticker_attr.alt = ""
            sticker_attr.stickerset = TLRPC.TL_inputStickerSetEmpty()
            size_attr = TLRPC.TL_documentAttributeImageSize()
            size_attr.w, size_attr.h = width, height
            for attr in (name_attr, sticker_attr, size_attr):
                document.attributes.add(attr)
            thumb_source = ImageLoader.loadBitmap(path, None, 90, 90, True)
            if thumb_source is not None:
                thumb = ImageLoader.scaleAndSaveImage(thumb_source, 90.0, 90.0, 55, False)
                if thumb is not None:
                    document.thumbs.add(thumb)
                    document.flags |= 1
                thumb_source.recycle()
            params = HashMap()
            params.put("originalPath", path)
            send_params = call_static_compat(
                "org.telegram.messenger.SendMessagesHelper$SendMessageParams", "of",
                lambda: SendMessagesHelper.SendMessageParams.of(
                    document, None, path, dialog_id, reply_to, reply_to,
                    None, None, None, params, True, 0, 0, 0, None, None, False),
                {"org.telegram.tgnet.TLRPC$TL_document": [document], "java.lang.String": [path],
                 "long": [jlong(dialog_id)], "org.telegram.messenger.MessageObject": [reply_to, reply_to],
                 "java.util.HashMap": [params], "boolean": [True]},
                {"org.telegram.tgnet.TLRPC$TL_document": 1, "java.lang.String": 1, "long": 1,
                 "org.telegram.messenger.MessageObject": 2, "java.util.HashMap": 1})
            SendMessagesHelper.getInstance(account).sendMessage(send_params)
            show_done("Стикер отправлен", "smile_to_sticker")
        except Exception as e:
            log_exc("Sticker send error")
            BulletinHelper.show_error(f"Ошибка: {str(e)[:50]}")

    def _pick_chat_and_send(self, data):
        def open_picker():
            try:
                fragment = get_last_fragment()
                if fragment is None:
                    return BulletinHelper.show_error("Нет активного экрана")
                args = Bundle()
                args.putInt("dialogsType", DIALOGS_TYPE_FORWARD)
                args.putBoolean("resetDelegate", False)
                for key in ("onlySelect", "closeFragment", "canSelectTopics", "checkCanWrite", "allowGlobalSearch",
                            "allowUsers", "allowBots", "allowGroups", "allowMegagroups", "allowLegacyGroups",
                            "allowChannels"):
                    args.putBoolean(key, True)
                picker = DialogsActivity(args)
                delegate = _ChatPicked(lambda picked, dids: self._on_chat_picked(picked, dids, data))
                self._refs["picker"] = delegate
                picker.setDelegate(delegate)
                fragment.presentFragment(picker)
            except Exception as e:
                qlog(f"Chat picker open failed: {e}")
                BulletinHelper.show_error("Не удалось открыть выбор чата")

        run_on_ui_thread(open_picker)

    def _on_chat_picked(self, fragment, dids, data):
        topic_key = dids.get(0) if dids is not None and dids.size() else None
        if topic_key is None or topic_key.dialogId == 0:
            return BulletinHelper.show_error("Чат не выбран")
        account = fragment.getCurrentAccount()
        reply_to = make_top_reply(account, topic_key.topicId, topic_key.dialogId)
        self._refs.pop("picker", None)
        quietly(fragment.finishFragment)
        self._send(data, account, topic_key.dialogId, reply_to, "photo")

    def _save_gallery(self, data, activity, view, notify=show_done):
        self._click_feedback(view)

        def save():
            path = self._write_tmp(f"q_{int(time.time())}.{self._format().ext}", data)
            MediaController.saveFile(path, activity or ApplicationLoader.applicationContext, 0, None, None,
                                     _Callback(lambda uri: notify("Сохранено в галерею", "ic_save_to_gallery")))

        run_async(save, "Ошибка сохранения")

    def _share(self, data, activity, view):
        self._click_feedback(view)
        BulletinHelper.show_info("Открываю меню отправки")

        def prepare():
            uri = self._file_uri(self._write_tmp(f"share_{int(time.time())}.{self._format().ext}", data))
            run_on_ui_thread(lambda: self._open_share(uri, activity))

        run_async(prepare, "Ошибка отправки")

    def _open_share(self, uri, activity):
        try:
            intent = Intent(Intent.ACTION_SEND)
            intent.setType(self._format().mime)
            intent.putExtra(Intent.EXTRA_STREAM, uri)
            intent.addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)
            chooser = Intent.createChooser(intent, "Поделиться")
            if activity is None:
                chooser.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
            (activity or ApplicationLoader.applicationContext).startActivity(chooser)
        except Exception as e:
            BulletinHelper.show_error(f"Ошибка отправки: {str(e)[:50]}")

    def _copy(self, data, view, notify=show_done):
        self._click_feedback(view)
        context = ApplicationLoader.applicationContext

        def copy():
            uri = self._file_uri(self._write_tmp(f"c_{int(time.time())}.{self._format().ext}", data))
            clip = ClipData.newUri(context.getContentResolver(), "Image", uri)

            def set_clip():
                try:
                    context.getSystemService(Context.CLIPBOARD_SERVICE).setPrimaryClip(clip)
                    notify("Скопировано", "copy")
                except Exception as e:
                    BulletinHelper.show_error(f"Ошибка: {e}")

            run_on_ui_thread(set_clip)

        run_async(copy, "Ошибка", limit=None)

    @staticmethod
    def _click_feedback(view):
        def feedback():
            try:
                if not view.performHapticFeedback(HapticFeedbackConstants.KEYBOARD_TAP):
                    vibrate(view.getContext(), 20, 120)
            except Exception as e:
                qlog(f"Click feedback error: {e}")

        run_on_ui_thread(feedback)

    @staticmethod
    def _tmp_dir():
        context = ApplicationLoader.applicationContext
        base = context.getExternalCacheDir() or context.getCacheDir()
        path = os.path.join(base.getAbsolutePath(), __id__)
        os.makedirs(path, exist_ok=True)
        return path

    def _tmp_path(self, name):
        os.makedirs(self.tmp, exist_ok=True)
        return os.path.join(self.tmp, name)

    def _write_tmp(self, name, data):
        path = self._tmp_path(name)
        with open(path, "wb") as file:
            file.write(bytes(data))
        return path

    @staticmethod
    def _file_uri(path):
        context = ApplicationLoader.applicationContext
        return FileProvider.getUriForFile(context, f"{context.getPackageName()}.provider", File(path))

    def _cleanup_tmp(self, max_age=TMP_MAX_AGE_SEC):
        logo = self._logo_path()
        keep = os.path.abspath(logo) if logo else None
        try:
            now = time.time()
            for name in os.listdir(self.tmp):
                path = os.path.join(self.tmp, name)
                if os.path.abspath(path) != keep and os.path.isfile(path) and now - os.path.getmtime(path) >= max_age:
                    with suppress(OSError):
                        os.remove(path)
        except Exception as e:
            qlog(f"Temp cleanup failed: {e}")

    def create_settings(self):
        self._settings_refs = []
        self._wm_previews = []
        slider = self._slider_setting
        logo = self._logo_path()
        settings = [
            Header("Настройки фона"),
            Selector("bg_type", "Тип фона", 0, ["Тема чата", "Прозрачный", "Свой цвет"], icon="msg_customize",
                     on_change=self._reload_on_change("bg_type", 0)),
            Switch("transparent_sticker", "Прозрачный фон для стикера", True, icon="media_sticker_stroke"),
            Divider("если выключено — стикер рендерится с фоном чата или своим цветом"),
        ]
        if self.get_setting("bg_type", 0) == 2:
            settings[2:2] = [
                Text(f"Цвет фона: {self._setting_color_text('bg_color', '#FF000000')}", icon="msg_palette",
                     on_click=self._pick_bg_color),
                Divider("нажмите на «цвет фона», чтобы выбрать цвет из палитры"),
            ]
        settings += [
            Header("Изображение"),
            Selector("output_format", "Формат", 0, ["PNG", "JPEG"], icon="msg_photos",
                     on_change=self._reload_on_change("output_format", 0)),
        ]
        if self._format().name == "JPEG":
            settings.append(slider("jpeg_quality", "Качество JPEG", 92, 40, 100, "%"))
        settings += [
            Selector("render_scale", "Масштаб", 0, ["1x", "1.5x", "2x"], icon="msg_photo_settings"),
            slider("image_padding", "Поля вокруг цитаты", 16, 0, 48, "dp"),
            slider("corner_radius", "Скругление углов", 0, 0, 48, "dp"),
            Divider("скругление применяется только к PNG — у JPEG нет прозрачности"),
            Header("Водяной знак"),
            Switch("watermark_enabled", "Включить водяной знак", False, icon="msg_customize"),
            Input("watermark_text", "Текст", "@username", subtext="Доступны подстановки {date}, {chat}, {count}",
                  icon="msg_edit"),
            Selector("watermark_position", "Позиция", 0, ["Низ справа", "Низ слева", "Верх справа", "Верх слева", "Центр"],
                     icon="msg_openprofile"),
            self._custom(self._watermark_preview_factory()),
            slider("watermark_size", "Размер текста", 13, 8, 48, "dp"),
            slider("watermark_opacity", "Прозрачность текста", 72, 5, 100, "%"),
            slider("watermark_padding", "Отступ от края", 12, 0, 64, "dp"),
            slider("watermark_angle", "Наклон текста", 0, -45, 45, "°"),
            self._custom(self._color_factory()),
            Switch("watermark_blur_bg", "Размытый фон под текстом", True, icon="menu_feature_transparent"),
            slider("watermark_bg_opacity", "Прозрачность плашки", 36, 0, 100, "%"),
            slider("watermark_bg_radius", "Скругление плашки", 12, 0, 32, "dp"),
            Switch("watermark_tile", "Замостить по диагонали", False, icon="msg_media",
                   on_change=lambda *_: self._invalidate_wm_previews()),
            Divider("текст повторяется сеткой по всей картинке — плашка и размытие при этом не рисуются"),
            Text(f"Логотип: {os.path.basename(logo) if logo else 'не выбран'}", subtext="PNG или JPEG из файлов устройства",
                 icon="msg_photo_settings", on_click=self._pick_logo),
        ]
        if logo:
            settings += [
                slider("watermark_logo_size", "Размер логотипа", 28, 12, 96, "dp"),
                slider("watermark_logo_opacity", "Прозрачность логотипа", 80, 5, 100, "%"),
                Text("Убрать логотип", icon="msg_delete", on_click=self._clear_logo),
            ]
        settings += [
            Header("Отображение"),
            Switch("hide_time", "Скрывать время", False, icon="msg_contacts_time"),
            Switch("hide_status", "Скрывать галочки и просмотры", False, icon="msg_views"),
            Switch("hide_reactions", "Скрывать реакции", False, icon="msg_reactions"),
            Switch("hide_media", "Скрывать медиа", False, icon="media_live_off"),
            Header("Анонимизация"),
            Selector("anonymize_style", "Эффект", 0, ["Размытие", "Пиксели", "Спойлер", "Замазка", "Скрыть"],
                     icon="menu_feature_transparent"),
            Divider("Выберите эффект скрытия имени и аватара."),
            Switch("anonymize_nickname", "Скрывать никнейм", False, icon="menu_feature_transparent"),
            Switch("anonymize_avatar", "Скрывать аватар", False, icon="msg_openprofile"),
            Switch("anonymize_usernames", "Скрывать @юзернеймы в тексте", False, icon="msg_mention"),
            Switch("anonymize_fake_name", "Подменять имя вместо закраски", False, icon="msg_contacts",
