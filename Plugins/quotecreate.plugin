def warn(what, error=""):
    log(f"[Quote] {what}: {error}" if error else f"[Quote] {what}")


def safe(fn, default=None):
    try:
        return fn()
    except Exception:
        return default


def dp(value):
    return AndroidUtilities.dp(value)


def jcolor(color):
    value = int(color) & 0xFFFFFFFF
    return jint(value - 0x100000000 if value >= 0x80000000 else value)


def alpha(color, fraction):
    return (max(0, min(255, int(fraction * 255))) << 24) | (int(color) & 0xFFFFFF)


def fade(color, percent):
    value = int(color) & 0xFFFFFFFF
    return ((value >> 24) * max(0, min(100, int(percent))) // 100 << 24) | (value & 0xFFFFFF)


def is_light(color):
    value = int(color) & 0xFFFFFFFF
    return ((value >> 16) & 0xFF) * 299 + ((value >> 8) & 0xFF) * 587 + (value & 0xFF) * 114 >= 186000


def to_hex(color):
    return "#{:08X}".format(int(color) & 0xFFFFFFFF)


def tcolor(key, provider=None):
    return Theme.getColor(key) if provider is None else Theme.getColor(key, provider)


def icon_res(*names):
    return next((res for res in (getattr(R.drawable, name, 0) for name in names) if res), 0)


def plural(count, one, few, many):
    count = abs(int(count))
    if count % 100 in (11, 12, 13, 14):
        return many
    return {1: one, 2: few, 3: few, 4: few}.get(count % 10, many)


def size_text(size):
    if size < 1024:
        return f"{size} Б"
    if size < 1024 * 1024:
        return f"{size / 1024:.0f} КБ"
    return f"{size / (1024 * 1024):.1f} МБ"


def toast(text, icon):
    res = getattr(R.raw, icon, 0)
    if res:
        BulletinHelper.show_simple(text, res)
    else:
        BulletinHelper.show_success(text)


def background(fn, title):
    def task():
        try:
            fn()
        except Exception as e:
            warn(title, traceback.format_exc())
            error = str(e)[:80]
            run_on_ui_thread(lambda: BulletinHelper.show_error(f"{title}: {error}"))

    run_on_queue(task, PLUGINS_QUEUE)


def haptic(view):
    run_on_ui_thread(lambda: safe(lambda: view.performHapticFeedback(HapticFeedbackConstants.KEYBOARD_TAP)))


def box(left, top, right, bottom):
    left, top, right, bottom = int(left), int(top), int(right), int(bottom)
    return (left, top, right, bottom) if right > left and bottom > top else None


def shift(bounds, dy):
    return (bounds[0], bounds[1] + dy, bounds[2], bounds[3] + dy) if bounds else None


def blank(layout):
    if layout is None:
        return None
    paint = TextPaint(layout.getPaint())
    paint.setColor(jint(0))
    return StaticLayout(layout.getText(), paint, layout.getWidth(), Layout.Alignment.ALIGN_NORMAL, 1.0, 0.0, False)


def rounded(color, radius):
    drawable = GradientDrawable()
    drawable.setCornerRadius(float(dp(radius)))
    drawable.setColor(jcolor(color))
    return drawable


def pressable(fill, radius, pressed):
    return Theme.createSimpleSelectorRoundRectDrawable(dp(radius), jcolor(fill), jcolor(pressed))


def label(context, text, size, color, bold=False):
    view = TextView(context)
    view.setText(text)
    view.setTextSize(TypedValue.COMPLEX_UNIT_DIP, float(size))
    view.setTextColor(jcolor(color))
    view.setSingleLine(True)
    if bold:
        view.setTypeface(AndroidUtilities.getTypeface("fonts/rmedium.ttf"))
    return view


def linear(context, vertical=False, gravity=Gravity.CENTER_VERTICAL):
    layout = LinearLayout(context)
    layout.setOrientation(LinearLayout.VERTICAL if vertical else LinearLayout.HORIZONTAL)
    layout.setGravity(gravity)
    return layout


def setting_row(context):
    root = linear(context, vertical=True, gravity=Gravity.NO_GRAVITY)
    root.setPadding(dp(21), dp(10), dp(21), dp(12))
    root.setLayoutParams(ViewGroup.LayoutParams(-1, -2))
    return root


def is_service(msg):
    owner = getattr(msg, "messageOwner", None) if msg is not None else None
    return owner is not None and getattr(owner, "action", None) is not None


def is_action(msg):
    return msg is not None and (bool(msg.isDateObject) or msg.contentType == 1)


def selected_messages(chat):
    selected = get_private_field(chat, "selectedMessagesIds")
    return [array.valueAt(i) for array in (selected or []) for i in range(array.size())]


def topic_of(account, msg, dialog_id):
    try:
        if dialog_id > 0:
            return 0
        chat = MessagesController.getInstance(account).getChat(-dialog_id)
        if chat is None or not ChatObject.isForum(chat):
            return 0
        reply_to = msg.messageOwner.reply_to
        if reply_to is not None:
            topic = getattr(reply_to, "reply_to_top_id", 0) or getattr(reply_to, "reply_to_msg_id", 0)
            if topic:
                return topic
        return MessageObject.getTopicId(account, msg.messageOwner, True)
    except Exception as e:
        warn("topic id", e)
        return 0


def top_reply(account, topic, dialog_id):
    if not topic or topic <= 0:
        return None
    try:
        message = TLRPC.TL_message()
        message.message = ""
        message.id = topic
        message.peer_id = MessagesController.getInstance(account).getPeer(dialog_id)
        return MessageObject(account, message, False, False)
    except Exception as e:
        warn("top reply", e)
        return None


def new_bitmap(width, height):
    return Bitmap.createBitmap(max(1, int(width)), max(1, int(height)), Bitmap.Config.ARGB_8888)


def swap(old, new):
    if new is not old:
        old.recycle()
    return new


def decode(data):
    options = BitmapFactory.Options()
    options.inJustDecodeBounds = True
    BitmapFactory.decodeByteArray(data, 0, len(data), options)
    width, height = options.outWidth, options.outHeight
    options.inJustDecodeBounds = False
    options.inSampleSize = 1
    while width * height * 4 > PREVIEW_LIMIT * options.inSampleSize ** 2:
        options.inSampleSize *= 2
    bitmap = BitmapFactory.decodeByteArray(data, 0, len(data), options)
    if bitmap is None:
        raise Exception("не удалось декодировать превью")
    return bitmap


def rescale(bitmap, factor):
    width = max(1, int(round(bitmap.getWidth() * factor)))
    height = max(1, int(round(bitmap.getHeight() * factor)))
    if width == bitmap.getWidth() and height == bitmap.getHeight():
        return bitmap
    return Bitmap.createScaledBitmap(bitmap, width, height, True)


def round_bitmap(bitmap, radius):
    width, height = bitmap.getWidth(), bitmap.getHeight()
    radius = max(0, min(int(radius), min(width, height) // 2))
    if radius <= 0:
        return bitmap
    result = new_bitmap(width, height)
    canvas = Canvas(result)
    paint = Paint(Paint.ANTI_ALIAS_FLAG)
    paint.setColor(jcolor(0xFFFFFFFF))
    canvas.drawRoundRect(RectF(0.0, 0.0, float(width), float(height)), float(radius), float(radius), paint)
    paint.setXfermode(PorterDuffXfermode(PorterDuff.Mode.SRC_IN))
    canvas.drawBitmap(bitmap, 0.0, 0.0, paint)
    return result


def flatten(bitmap):
    if not bitmap.hasAlpha():
        return bitmap
    result = new_bitmap(bitmap.getWidth(), bitmap.getHeight())
    canvas = Canvas(result)
    canvas.drawColor(jcolor(0xFFFFFFFF))
    canvas.drawBitmap(bitmap, 0.0, 0.0, None)
    return result


def opaque(bmp):
    width, height = bmp.getWidth(), bmp.getHeight()
    if width <= 0 or height <= 0 or not bmp.hasAlpha():
        return None
    row, column = jarray(jint)(width), jarray(jint)(height)

    def row_hit(y):
        bmp.getPixels(row, 0, width, 0, y, width, 1)
        return any(pixel & 0xFF000000 for pixel in row[:])

    top = next((y for y in range(height) if row_hit(y)), None)
    if top is None:
        return None
    bottom = next(y for y in range(height - 1, top - 1, -1) if row_hit(y)) + 1
    span = bottom - top

    def column_hit(x):
        bmp.getPixels(column, 0, 1, x, top, 1, span)
        return any(pixel & 0xFF000000 for pixel in column[:span])

    left = next(x for x in range(width) if column_hit(x))
    right = next(x for x in range(width - 1, left - 1, -1) if column_hit(x)) + 1
    if (left, top, right, bottom) == (0, 0, width, height):
        return None
    return left, top, right, bottom


def fit_sticker(bmp):
    pad = 0
    bounds = safe(lambda: opaque(bmp))
    if bounds:
        left, top, right, bottom = bounds
        bmp = swap(bmp, Bitmap.createBitmap(bmp, left, top, right - left, bottom - top))
        pad = 8
    width, height = bmp.getWidth(), bmp.getHeight()
    scale = float(STICKER_SIDE - pad * 2) / max(width, height)
    new_w = max(1, min(STICKER_SIDE, int(round(width * scale))))
    new_h = max(1, min(STICKER_SIDE, int(round(height * scale))))
    if new_w == width and new_h == height and pad == 0:
        return bmp
    result = new_bitmap(new_w + pad * 2, new_h + pad * 2)
    paint = Paint(Paint.ANTI_ALIAS_FLAG)
    paint.setFilterBitmap(True)
    paint.setDither(True)
    Canvas(result).drawBitmap(bmp, Rect(0, 0, width, height), Rect(pad, pad, pad + new_w, pad + new_h), paint)
    bmp.recycle()
    return result


def write_webp(bmp, path):
    lossless = getattr(Bitmap.CompressFormat, "WEBP_LOSSLESS", None)
    lossy = getattr(Bitmap.CompressFormat, "WEBP_LOSSY", None) or Bitmap.CompressFormat.WEBP
    attempts = ([(lossless, 100)] if lossless is not None else []) + [(lossy, q) for q in WEBP_STEPS]
    size = 0
    for fmt, quality in attempts:
        out = FileOutputStream(path)
        try:
            bmp.compress(fmt, quality, out)
        finally:
            out.close()
        size = os.path.getsize(path)
        if 0 < size <= STICKER_LIMIT:
            return
    raise Exception(f"стикер не влезает в 512 КБ ({size_text(size)})")


def image_size(path):
    options = BitmapFactory.Options()
    options.inJustDecodeBounds = True
    BitmapFactory.decodeFile(path, options)
    return options.outWidth, options.outHeight


def make_document(path, mime, sticker=False):
    file = File(path)
    document = TLRPC.TL_document()
    document.id = 0
    document.access_hash = 0
    document.file_reference = bytearray()
    document.date = int(time.time())
    document.mime_type = mime
    document.size = file.length()
    document.dc_id = 0
    name = TLRPC.TL_documentAttributeFilename()
    name.file_name = file.getName()
    document.attributes.add(name)
    if sticker:
        width, height = image_size(path)
        if width <= 0 or height <= 0 or width > STICKER_SIDE or height > STICKER_SIDE:
            raise Exception(f"неверный размер стикера: {width}×{height}")
        attr = TLRPC.TL_documentAttributeSticker()
        attr.alt = ""
        attr.stickerset = TLRPC.TL_inputStickerSetEmpty()
        size = TLRPC.TL_documentAttributeImageSize()
        size.w, size.h = width, height
        document.attributes.add(attr)
        document.attributes.add(size)
    source = ImageLoader.loadBitmap(path, None, 90, 90, True)
    if source is not None:
        thumb = ImageLoader.scaleAndSaveImage(source, 90.0, 90.0, 55, False)
        if thumb is not None:
            document.thumbs.add(thumb)
            document.flags |= 1
        source.recycle()
    return document


def media_local(loader, owner, attach=None):
    for get_path in (lambda: loader.getPathToMessage(owner),
                     lambda: loader.getPathToAttach(attach) if attach is not None else None):
        path = safe(get_path)
        if path is not None and path.exists():
            return True
    return False


def media_ready(loader, msg, owner, attach, name):
    safe(lambda: msg.checkMediaExistance(False))
    exists = getattr(msg, "mediaExists", False)
    ready = bool(safe(exists, False) if callable(exists) else exists) or media_local(loader, owner, attach)
    return ready and not (name and safe(lambda: loader.isLoadingFile(name), False))


def request_media(loader, msg):
    owner, priority = msg.messageOwner, FileLoader.PRIORITY_NORMAL_UP
    document = safe(msg.getDocument)
    if document is not None:
        if media_local(loader, owner, document):
            return None
        loadable = safe(lambda: MessageObject.isVideoDocument(document)
                        or MessageObject.isGifDocument(document)
                        or MessageObject.isRoundVideoDocument(document)
                        or MessageObject.isStickerDocument(document)
                        or MessageObject.isAnimatedStickerDocument(document, True), False)
        if loadable:
            try:
                loader.loadFile(document, msg, priority, 0)
                name = safe(lambda: FileLoader.getAttachFileName(document))
                return lambda: media_ready(loader, msg, owner, document, name)
            except Exception as e:
                warn("document preload", e)
    thumbs = getattr(msg, "photoThumbs", None)
    if thumbs is None or thumbs.size() == 0:
        return None
    try:
        size = FileLoader.getClosestPhotoSizeWithSize(thumbs, AndroidUtilities.getPhotoSize())
        parent = getattr(msg, "photoThumbsObject", None)
        if parent is None:
            media = MessageObject.getMedia(owner)
            if media is not None:
                parent = getattr(media, "photo", None) or getattr(media, "document", None)
        location = ImageLocation.getForObject(size, parent) if size is not None and parent is not None else None
        if location is None:
            return None
        loader.loadFile(location, msg, None, priority, 1)
        name = safe(lambda: FileLoader.getAttachFileName(size))
        return lambda: media_ready(loader, msg, owner, size, name)
    except Exception as e:
        warn("thumb preload", e)
        return None


def preload(msgs, account):
    loader = FileLoader.getInstance(account)
    checks = [check for check in (safe(lambda: request_media(loader, msg)) for msg in msgs) if check]
    deadline = time.time() + 6.0
    while checks and time.time() < deadline:
        checks = [check for check in checks if not safe(check, True)]
        if checks:
            time.sleep(0.06)


def snapshot(view):
    width, height = view.getWidth(), view.getHeight()
    if width <= 0 or height <= 0:
        return None
    bmp = new_bitmap(width, height)
    canvas = Canvas(bmp)
    drawn = threading.Event()

    def draw():
        try:
            view.draw(canvas)
        except Exception as e:
            warn("wallpaper snapshot", e)
        finally:
            drawn.set()

    run_on_ui_thread(draw)
    drawn.wait(2.0)
    return bmp


def wallpaper(chat):
    content = safe(chat.getContentView)
    view = getattr(content, "backgroundView", None) if content is not None else None
    bmp = safe(lambda: snapshot(view)) if view is not None else None
    if bmp is not None:
        return bmp
    provider = chat.getResourceProvider()
    drawable = ((safe(content.getBackgroundImage) if content is not None else None)
                or (safe(provider.getWallpaperDrawable) if provider is not None else None)
                or Theme.getCachedWallpaper())
    if drawable is None:
        return None
    width, height = AndroidUtilities.displaySize.x, AndroidUtilities.displaySize.y
    bmp = new_bitmap(width, height)
    canvas = Canvas(bmp)
    if Theme.isPatternWallpaper():
        canvas.drawColor(jcolor(tcolor(Theme.key_chat_wallpaper, provider)))
    drawable.setBounds(0, 0, width, height)
    drawable.draw(canvas)
    return bmp


def tile_wallpaper(canvas, bmp, width, height, offset_x):
    bg_w, bg_h = bmp.getWidth(), bmp.getHeight()
    scale = max(1.0, width / bg_w)
    tile_w, tile_h = max(1, int(round(bg_w * scale))), max(1, int(round(bg_h * scale)))
    x = -max(0, min(tile_w - width, int(offset_x)))
    top = 0 if height >= tile_h else (height - tile_h) // 2
    src, paint, flip = Rect(0, 0, bg_w, bg_h), Paint(Paint.FILTER_BITMAP_FLAG), False
    while top < height:
        canvas.save()
        if flip:
            canvas.scale(1.0, -1.0, 0.0, top + tile_h / 2.0)
        canvas.drawBitmap(bmp, src, Rect(x, top, x + tile_w, top + tile_h), paint)
        canvas.restore()
        top += tile_h
        flip = not flip


def blur_region(canvas, bitmap, rect, radius):
    left, top = max(0, int(rect.left)), max(0, int(rect.top))
    right = min(bitmap.getWidth(), int(rect.right + 0.999))
    bottom = min(bitmap.getHeight(), int(rect.bottom + 0.999))
    width, height = max(1, right - left), max(1, bottom - top)
    region = Bitmap.createBitmap(bitmap, left, top, width, height)
    try:
        Utilities.stackBlurBitmap(region, max(6, min(18, int(max(width, height) / 18))))
        path = Path()
        path.addRoundRect(rect, float(radius), float(radius), Path.Direction.CW)
        paint = Paint(Paint.ANTI_ALIAS_FLAG)
        paint.setFilterBitmap(True)
        canvas.save()
        canvas.clipPath(path)
        canvas.drawBitmap(region, float(left), float(top), paint)
        canvas.restore()
    finally:
        region.recycle()


class Hook(MethodHook):
    def __init__(self, before=None, after=None):
        super().__init__()
        self.on_before, self.on_after = before, after

    def before_hooked_method(self, param):
        if self.on_before is not None:
            self.on_before(param)

    def after_hooked_method(self, param):
        if self.on_after is not None:
            self.on_after(param)


class Dismiss(dynamic_proxy(DialogInterface.OnDismissListener)):
    def __init__(self, fn):
        super().__init__()
        self.fn = fn

    def onDismiss(self, dialog):
        self.fn()


class Bounce(dynamic_proxy(View.OnTouchListener)):
    def onTouch(self, view, event):
        action = event.getActionMasked()
        if action == MotionEvent.ACTION_DOWN:
            scale = 0.92
        elif action in (MotionEvent.ACTION_UP, MotionEvent.ACTION_CANCEL):
            scale = 1.0
        else:
            return False
        safe(lambda: view.animate().scaleX(scale).scaleY(scale).setDuration(150).start())
        return False


class Hold(dynamic_proxy(View.OnTouchListener)):
    def __init__(self, scroller):
        super().__init__()
        self.scroller = scroller

    def onTouch(self, view, event):
        scroller = self.scroller
        if event.getActionMasked() == MotionEvent.ACTION_DOWN and (
                scroller.canScrollVertically(1) or scroller.canScrollVertically(-1)):
            scroller.getParent().requestDisallowInterceptTouchEvent(True)
        return False


class ColorSink(dynamic_proxy(Consumer)):
    def __init__(self, fn):
        super().__init__()
        self.fn = fn

    def accept(self, color):
        try:
            self.fn(int(color))
        except Exception as e:
            warn("color apply", e)


class NoPipette(dynamic_proxy(ColorPickerBottomSheet.PipetteDelegate)):
    def onStartColorPipette(self): pass
    def onStopColorPipette(self): pass
    def getContainerView(self): return None
    def getSnapshotDrawingView(self): return None
    def onDrawImageOverCanvas(self, bitmap, canvas): pass
    def isPipetteVisible(self): return False
    def isPipetteAvailable(self): return False
    def onColorSelected(self, color): pass


class Picked(dynamic_proxy(DialogsActivity.DialogsActivityDelegate)):
    def __init__(self, fn):
        super().__init__()
        self.fn = fn

    def didSelectDialogs(self, fragment, dids, *args):
        try:
            self.fn(fragment, dids)
        except Exception as e:
            warn("chat pick", e)
            BulletinHelper.show_error("Не удалось отправить цитату")
        return True

    def canSelectStories(self):
        return False

    def didSelectStories(self, fragment):
        return False


class Slider(dynamic_proxy(SeekBarView.SeekBarViewDelegate)):
    def __init__(self, on_drag, on_release, describe, steps):
        super().__init__()
        self.on_drag, self.on_release, self.describe, self.steps = on_drag, on_release, describe, steps

    def onSeekBarDrag(self, stop, progress):
        try:
            self.on_drag(bool(stop), float(progress))
        except Exception as e:
            warn("slider", e)

    def onSeekBarPressed(self, pressed):
        if not pressed:
            safe(self.on_release)

    def getContentDescription(self):
        return self.describe()

    def getStepsCount(self):
        return self.steps

    def needVisuallyDivideSteps(self):
        return False


if UniversalViewDelegate is not None:
    class Drawer(dynamic_proxy(UniversalViewDelegate)):
        def __init__(self, on_draw):
            super().__init__()
            self.on_draw = on_draw

        def onDraw(self, canvas, original):
            safe(lambda: original.run(canvas))
            self.on_draw(canvas)

        def onMeasure(self, width_spec, height_spec, original):
            safe(lambda: original.run(Integer(width_spec), Integer(height_spec)))

        def onAttachedToWindow(self):
            pass

        def onDetachedFromWindow(self):
            pass

        def onTouchEvent(self, event, original):
            return bool(safe(lambda: original.run(event), False))

        def onInitializeAccessibilityNodeInfo(self, info, original):
            safe(lambda: original.run(info))


def delegate_defaults():
    methods = ChatMessageCell.ChatMessageCellDelegate.getClass().getMethods()
    return {method.getName(): ZERO.get(method.getReturnType().getName()) for method in methods}


def constant(value):
    return lambda self, *args: value


class Delegate(dynamic_proxy(ChatMessageCell.ChatMessageCellDelegate)):
    locals().update({name: constant(value) for name, value in safe(delegate_defaults, {}).items()})

    def __init__(self, chat):
        super().__init__()
        self.controller = chat.getMessagesController()
        self.chat = chat.getCurrentChat()
        self.user = chat.getCurrentUser()
        self.topic = get_private_field(chat, "forumTopic")

    def group(self):
        chat = self.chat
        return chat.id if chat is not None and not ChatObject.isChannelAndNotMegaGroup(chat) else None

    def isAdmin(self, uid):
        group = self.group()
        return group is not None and bool(safe(lambda: self.controller.isAdmin(group, uid), False))

    def isOwner(self, uid):
        group = self.group()
        return group is not None and bool(safe(lambda: self.controller.isOwner(group, uid), False))

    def getAdminRank(self, uid):
        if safe(lambda: UserObject.isBotForum(self.user), False):
            return None
        group = self.group()
        rank = safe(lambda: self.controller.getAdminRank(group, uid)) if group is not None else None
        author = getattr(self.topic, "from_id", None)
        if rank is None and author is not None and uid in (author.user_id, author.channel_id, author.chat_id):
            rank = safe(lambda: LocaleController.getString(R.string.TopicCreator))
        return rank

    def isLandscape(self):
        return AndroidUtilities.displaySize.x > AndroidUtilities.displaySize.y

    def canDrawOutboundsContent(self):
        return True

    def shouldRepeatSticker(self, msg):
        return True

    def doNotShowLoadingReply(self, msg):
        return msg is not None and msg.getDialogId() == UserObject.REPLY_BOT


def attempt(what, fn):
    try:
        fn()
    except Exception as e:
        warn(what, e)


def draw_shifted(canvas, dy, fn):
    canvas.save()
    try:
        canvas.translate(0.0, float(dy))
        fn()
    finally:
        canvas.restore()


def field(cell, name):
    value = getattr(cell, name, None)
    return value if value else get_private_field(cell, name)


def fnum(cell, name):
    return float(field(cell, name) or 0)


def drawable_bounds(drawable, pad=0):
    if drawable is None:
        return None
    rect = drawable.getBounds()
    return box(rect.left - pad, rect.top - pad, rect.right + pad, rect.bottom + pad)


def receiver_bounds(receiver):
    try:
        left, top = int(receiver.getImageX()), int(receiver.getImageY())
        right, bottom = int(receiver.getImageX2()), int(receiver.getImageY2())
        if right <= left:
            right = int(left + receiver.getImageWidth())
        if bottom <= top:
            bottom = int(top + receiver.getImageHeight())
        return box(left, top, right, bottom)
    except Exception:
        return None


def round_radius(receiver, bounds=None):
    radius = safe(lambda: max(int(value or 0) for value in receiver.getRoundRadius()), 0) or 0
    if bounds:
        limit = max(1, min(bounds[2] - bounds[0], bounds[3] - bounds[1]) // 2)
        radius = limit if radius <= 0 else min(radius, limit)
    return radius if radius > 0 else None


def line_width(layout):
    return int(max(1, layout.getLineWidth(0))) if layout.getLineCount() > 0 else 0


def name_bounds(cell):
    layout = field(cell, "nameLayout")
    if not field(cell, "drawNameLayout") or not layout:
        return None
    bounds = drawable_bounds(field(cell, "nameLayoutSelector"), dp(1))
    if bounds:
        return bounds
    x = fnum(cell, "nameX") + fnum(cell, "nameOffsetX")
    width = line_width(layout) or int(field(cell, "nameLayoutWidth") or 0)
    if width <= 0:
        return None
    left, top = int(x - dp(2)), int(fnum(cell, "nameY") - dp(1))
    return box(left, top, left + width + dp(4), top + max(1, layout.getHeight()) + dp(2))


def name_avatar_bounds(cell):
    if not field(cell, "drawNameAvatar"):
        return None
    x, y = fnum(cell, "nameX"), fnum(cell, "nameY")
    if field(cell, "currentNameBotVerificationId"):
        x -= dp(20)
    return box(x, y, x + dp(26), y + dp(26))


def reply_name_bounds(cell):
    layout = field(cell, "replyNameLayout")
    if not layout:
        return None
    msg = field(cell, "currentMessageObject")
    bare = msg is not None and bool(safe(msg.shouldDrawWithoutBackground, False))
    x = fnum(cell, "replyStartX") + (-dp(6) if bare else -dp(1)) - fnum(cell, "replyNameOffset") + dp(10)
    y = fnum(cell, "replyStartY") + (dp(1) if bare else dp(3))
    if getattr(cell, "needReplyImage", False):
        image = getattr(cell, "replyImageReceiver", None)
        x += float(image.getImageWidth()) + dp(3) if image is not None else dp(28)
    width = safe(lambda: line_width(layout), 0) or safe(lambda: int(max(1, layout.getWidth())), 0)
    if width <= 0:
        return None
    left, top = int(x - dp(2)), int(y - dp(1))
    return box(left, top, int(x + width + dp(4)), top + max(1, layout.getHeight()) + dp(1))


def forward_bounds(cell):
    if not field(cell, "drawForwardedName"):
        return None
    layouts = field(cell, "forwardedNameLayout")
    if not layouts or layouts[0] is None:
        return None
    x, y, width, height = (fnum(cell, name) for name in ("forwardNameX", "forwardNameY", "forwardedNameWidth", "forwardHeight"))
    return box(x - dp(2), y - dp(1), x + width + dp(4), y + height + dp(1))


def via_bounds(cell):
    width = fnum(cell, "viaWidth")
    if width <= 0:
        return None
    x = fnum(cell, "nameX") + fnum(cell, "viaNameWidth")
    y = fnum(cell, "nameY")
    return box(x - dp(2), y - dp(5), x + width + dp(2), y + dp(21))


def block_offset(block, blocks, cell):
    for getter in (lambda: block.textYOffset(blocks, cell.transitionParams),
                   lambda: block.textYOffset(blocks),
                   lambda: block.textYOffset):
        value = safe(lambda: float(getter()))
        if value is not None:
            return value
    return 0.0


def username_bounds(cell, msg):
    result = []
    text = str(getattr(msg, "messageText", None) or "")
    matches = [(m.start(), m.end()) for m in USERNAME_RE.finditer(text)]
    blocks = getattr(msg, "textLayoutBlocks", None)
    if not matches or blocks is None:
        return result
    text_x, text_y, pad = int(getattr(cell, "textX", 0) or 0), int(getattr(cell, "textY", 0) or 0), dp(1)
    for index in range(blocks.size()):
        block = blocks.get(index)
        layout = getattr(block, "textLayout", None)
        if layout is None:
            continue
        offset = int(getattr(block, "charactersOffset", 0) or 0)
        block_y = block_offset(block, blocks, cell)
        length = layout.getText().length()
        for start, end in matches:
            local_start, local_end = max(0, start - offset), min(length, end - offset)
            if local_end <= local_start:
                continue
            for line in range(layout.getLineForOffset(local_start), layout.getLineForOffset(local_end - 1) + 1):
                line_start = max(local_start, layout.getLineStart(line))
                line_end = min(local_end, layout.getLineEnd(line))
                if line_end <= line_start:
                    continue
                x1, x2 = sorted((layout.getPrimaryHorizontal(line_start), layout.getPrimaryHorizontal(line_end)))
                bounds = box(int(text_x + x1) - pad, int(text_y + block_y + layout.getLineTop(line)) - pad,
                             int(text_x + x2) + pad, int(text_y + block_y + layout.getLineBottom(line)) + pad)
                if bounds:
                    result.append(bounds)
    return result


def mask_color(bmp, left, top, right, bottom):
    width, height = bmp.getWidth(), bmp.getHeight()
    cx, cy = (left + right) // 2, (top + bottom) // 2
    samples = []
    for x, y in ((left - 2, top - 2), (right + 2, top - 2), (left - 2, bottom + 2), (right + 2, bottom + 2),
                 (cx, top - 2), (cx, bottom + 2), (left - 2, cy), (right + 2, cy)):
        pixel = bmp.getPixel(max(0, min(width - 1, x)), max(0, min(height - 1, y))) & 0xFFFFFFFF
        if (pixel >> 24) >= 0x10:
            samples.append(pixel)
    if not samples:
        return 0xFF2B2B2B
    count = len(samples)
    red = sum((c >> 16) & 0xFF for c in samples) // count
    green = sum((c >> 8) & 0xFF for c in samples) // count
    blue = sum(c & 0xFF for c in samples) // count
    return 0xFF000000 | (red << 16) | (green << 8) | blue


def draw_mask(canvas, bmp, bounds, style, ink, circle=False, radius=None):
    left, top, right, bottom = bounds
    canvas.save()
    try:
        if radius is None and not circle:
            radius = dp(4)
        path = Path()
        if radius:
            path.addRoundRect(RectF(float(left), float(top), float(right), float(bottom)),
                              float(radius), float(radius), Path.Direction.CW)
            canvas.clipPath(path)
        elif circle:
            path.addCircle((left + right) / 2.0, (top + bottom) / 2.0,
                           max(1.0, min(right - left, bottom - top) / 2.0), Path.Direction.CW)
            canvas.clipPath(path)
        if style in (0, 1):
            factor = 0.05 if style == 0 else 0.1
            small_w, small_h = max(1, int((right - left) * factor)), max(1, int((bottom - top) * factor))
            small = new_bitmap(small_w, small_h)
            area, small_area = Rect(left, top, right, bottom), Rect(0, 0, small_w, small_h)
            Canvas(small).drawBitmap(bmp, area, small_area, None)
            paint = Paint()
            paint.setFilterBitmap(style == 0)
            canvas.drawBitmap(small, small_area, area, paint)
            small.recycle()
            return
        fill = Paint()
        fill.setColor(jcolor(mask_color(bmp, left, top, right, bottom)))
        canvas.drawRect(float(left), float(top), float(right), float(bottom), fill)
        if style == 4:
            return
        color = ink if ink is not None else SPOILER_COLOR
        if style == 2:
            effect = SpoilerEffect()
            effect.setColor(jcolor(color))
            effect.setBounds(left, top, right, bottom)
            effect.draw(canvas)
            return
        hatch = Paint()
        hatch.setColor(jcolor(color))
        hatch.setStrokeWidth(float(max(1, dp(1))))
        hatch.setStyle(Paint.Style.STROKE)
        span = bottom - top
        for x in range(left - span, right + span, max(1, dp(6))):
            canvas.drawLine(float(x), float(top), float(x + span), float(bottom), hatch)
    except Exception as e:
        warn("mask", e)
    finally:
        canvas.restore()


def group_of(msg):
    return safe(lambda: int(msg.getGroupId()) if msg.hasValidGroupId() else 0, 0)


def make_album(run):
    try:
        group = MessageObject.GroupedMessages()
        group.groupId = run[0][0].getGroupId()
        for msg, _, _ in run:
            group.messages.add(msg)
        group.calculate()
        if group.posArray.size() != len(run) or any(group.getPosition(msg) is None for msg, _, _ in run):
            return None
        return group
    except Exception as e:
        warn("album group", e)
        return None


def album_geometry(group, width):
    result, span, row = [], 0, 0
    for index in range(group.posArray.size()):
        size = group.posArray.get(index).spanSize
        if size <= 0:
            size = 1000
        if span > 0 and span + size > 1000:
            row += 1
            span = 0
        left = math.ceil(span * width / 1000.0)
        right = math.ceil(min(1000, span + size) * width / 1000.0)
        result.append((row, left, max(1, right - left)))
        span += size
    return result


@contextmanager
def patched(msg, opt):
    saved = []

    def patch(target, name, value):
        try:
            saved.append((target, name, getattr(target, name)))
            setattr(target, name, value)
        except Exception:
            pass

    try:
        if opt.fake_name:
            patch(msg, "customName", opt.fake_name)
        if safe(lambda: msg.hasMediaSpoilers() and not msg.needDrawBluredPreview(), False):
            patch(msg, "isMediaSpoilersRevealed", True)
            patch(msg, "isMediaSpoilersRevealedInSharedMedia", True)
            patch(msg, "revealingMediaSpoilers", False)
        if opt.hide_reactions and getattr(msg.messageOwner, "reactions", None) is not None:
            patch(msg.messageOwner, "reactions", None)
        if opt.hide_media:
            patch(msg, "type", 0)
        yield
    finally:
        for target, name, value in reversed(saved):
            with suppress(Exception):
                setattr(target, name, value)


class Renderer:
    def __init__(self, msgs, chat, opt):
        self.msgs, self.chat, self.opt = msgs, chat, opt
        self.ctx = chat.getParentActivity()
        self.provider = self.res = self.delegate = None
        self.cell = self.action = None

    def render(self, wallpaper_bmp):
        rows = self.neighbours()
        if not rows:
            return None
        pieces = []
        done = threading.Event()

        def draw():
            try:
                self.draw_all(rows, pieces)
            except Exception:
                warn("UI render", traceback.format_exc())
            finally:
                done.set()

        run_on_ui_thread(draw)
        limit = 6.0 + 0.7 * len(rows)
        if not done.wait(limit):
            raise Exception(f"рендер не завершился за {limit:.1f}с")
        if not pieces:
            return None
        return self.encode(self.compose(pieces, wallpaper_bmp), len(pieces))

    def neighbours(self):
        msgs, last = self.msgs, len(self.msgs) - 1

        def same(a, b):
            return (not is_action(a) and not is_action(b) and a.getSenderId() == b.getSenderId()
                    and abs(a.messageOwner.date - b.messageOwner.date) < 300)

        rows = []
        for index, msg in enumerate(msgs):
            try:
                rows.append((msg, index < last and same(msgs[index + 1], msg), index > 0 and same(msg, msgs[index - 1])))
            except Exception as e:
                warn("neighbours", e)
        return rows

    def surface(self):
        list_view = safe(self.chat.getChatListView)
        list_width = (list_view.getMeasuredWidth() or list_view.getWidth()) if list_view is not None else 0
        return max(1, list_width, AndroidUtilities.displaySize.x), max(1, AndroidUtilities.displaySize.y)

    def plan(self, rows, width):
        album_width = max(1, min(width, AndroidUtilities.displaySize.x or width))
        units, index = [], 0
        while index < len(rows):
            gid = 0 if self.opt.hide_media else group_of(rows[index][0])
            end = index + 1
            while gid and end < len(rows) and group_of(rows[end][0]) == gid:
                end += 1
            run = rows[index:end]
            group = make_album(run) if gid and len(run) > 1 else None
            geometry = safe(lambda: album_geometry(group, album_width)) if group is not None else None
            if not geometry or len(geometry) != len(run):
                units.extend([Entry(msg, bottom, top, None, None, None, 0, width)] for msg, bottom, top in run)
            else:
                unit = []
                for position, (msg, _, _) in enumerate(run):
                    pos = group.posArray.get(position)
                    row, x, cell_width = geometry[position]
                    bottom = run[-1][1] if pos.flags & MessageObject.POSITION_FLAG_BOTTOM else True
                    top = run[0][2] if pos.flags & MessageObject.POSITION_FLAG_TOP else True
                    unit.append(Entry(msg, bottom, top, group, pos, row, x, cell_width))
                units.append(unit)
            index = end
        return units

    def draw_all(self, rows, pieces):
        chat = self.chat
        self.provider = chat.getResourceProvider()
        self.res = get_private_field(chat, "sharedResources")
        if self.provider is None or self.res is None:
            return
        self.delegate = Delegate(chat)
        width, screen_h = self.surface()
        try:
            for unit in self.plan(rows, width):
                shots = [shot for shot in (self.draw_entry(entry, width, screen_h) for entry in unit) if shot]
                if unit[0].group is None:
                    pieces.extend(Piece(*shot[:5]) for shot in shots)
                elif shots:
                    self.compose_album(shots, width, pieces)
        finally:
            for cell in (self.cell, self.action):
                if cell is not None:
                    safe(cell.onDetachedFromWindow)

    def draw_entry(self, entry, width, screen_h):
        msg = entry.msg
        try:
            with patched(msg, self.opt):
                if is_action(msg):
                    return self.draw_action(msg, width, screen_h)
                return self.draw_message(entry, width, screen_h)
        except Exception as e:
            warn(f"message {safe(msg.getId, '?')} skipped", e)
            return None

    def message_cell(self):
        if self.cell is None:
            chat, user = self.chat.getCurrentChat(), self.chat.getCurrentUser()
            cell = ChatMessageCell(self.ctx, self.chat.getCurrentAccount(), True, self.res, self.provider)
            cell.onAttachedToWindow()
            cell.setDelegate(self.delegate)
            cell.isChat = chat is not None
            cell.isBot = user is not None and bool(user.bot)
            cell.isMegagroup = chat is not None and ChatObject.isChannel(chat) and bool(chat.megagroup)
            cell.drawingToBitmap = True
            cell.setFullyDraw(True)
            self.cell = cell
        return self.cell

    def draw_message(self, entry, width, screen_h):
        msg, pos, opt = entry.msg, entry.pos, self.opt
        cell = self.message_cell()
        receivers = [r for r in (get_private_field(cell, name) for name in RECEIVERS) if r is not None]
        for receiver in receivers:
            receiver.setAllowLoadingOnAttachedOnly(False)
        outgoing = msg.isOutOwner()
        w = int(entry.width) if entry.width else width
        cell.setParentViewSize(width, screen_h)
        cell.setMessageObject(msg, entry.group, entry.bottom_near, entry.top_near, False)
        cell.measure(View.MeasureSpec.makeMeasureSpec(w, EXACTLY), View.MeasureSpec.makeMeasureSpec(0, UNSPECIFIED))
        h = cell.getMeasuredHeight()
        if h <= 0:
            return None
        cell.layout(0, 0, w, h)
        decor = self.decor_bottom(cell, entry.group, pos) if pos is not None else 0
        if opt.hide_time:
            cell.timeLayout = blank(cell.timeLayout)
        if opt.hide_status:
            set_private_field(cell, "animateToStatusDrawableParams", Integer(0))
            set_private_field(cell, "statusDrawableAnimationInProgress", True)
            set_private_field(cell, "viewsLayout", None)
            set_private_field(cell, "repliesLayout", None)
        cell.setParentViewSize(width, screen_h)
        safe(lambda: cell.setVisiblePart(0, h, screen_h, 0.0, 0.0, width, screen_h, 0, 0, 0))
        loader = ImageLoader.getInstance()
        for receiver in receivers:
            safe(lambda: loader.loadImageForImageReceiver(receiver))
        if msg.type == MessageObject.TYPE_POLL:
            buttons = safe(cell.getPollButtons)
            if buttons is not None and buttons.size() > 0:
                cell.firstVisiblePollButton = 0
                cell.lastVisiblePollButton = buttons.size() - 1

        left, right = 0, w
        bounds_left, bounds_right = cell.getBoundsLeft(), cell.getBoundsRight()
        if bounds_right > bounds_left:
            left = max(0, bounds_left)
            right = min(w, max(left + 1, bounds_right))
        extra = dp(64) + (dp(170) if msg.messageOwner.reply_to is not None else 0) if outgoing else 0
        left = max(0, left - dp(14))
        right = min(w, max(left + 1, right + extra))

        force_avatar = bool(getattr(msg, "forceAvatar", False)) or getattr(msg, "customAvatarDrawable", None) is not None
        avatar_slot = not outgoing and (not entry.bottom_near or force_avatar)
        if pos is not None and not cell.isAvatarVisible:
            avatar_slot = False
        draw_avatar = cell.isAvatarVisible and avatar_slot
        avatar_size = dp(42)
        avatar_y = h - avatar_size - dp(4)
        inset = -avatar_y if draw_avatar and avatar_y < 0 else 0

        bmp = new_bitmap(max(1, width - int(entry.x)) if pos is not None else w, h + inset)
        canvas = Canvas(bmp)
        if safe(cell.drawBackgroundInParent, False):
            attempt("background", lambda: draw_shifted(
                canvas, inset + cell.getPaddingTop(), lambda: cell.drawBackgroundInternal(canvas, True)))
        draw_shifted(canvas, inset, lambda: cell.draw(canvas))
        if pos is not None:
            draw_shifted(canvas, inset + cell.getPaddingTop(), lambda: self.group_extras(canvas, cell, pos))

        receiver = cell_avatar = manual_avatar = None
        if draw_avatar:
            receiver = cell.getAvatarImage()
            cell_avatar = shift(receiver_bounds(receiver), inset)
        if avatar_slot and not entry.bottom_near:
            avatar = cell.getAvatarImage()
            if avatar is not None:
                receiver = avatar
                if not opt.anon_avatar:
                    def paint_avatar():
                        avatar.setImageCoords(dp(6), avatar_y, avatar_size, avatar_size)
                        avatar.setVisible(True, False)
                        avatar.draw(canvas)

                    draw_shifted(canvas, inset, paint_avatar)
            if avatar is not None or opt.anon_avatar:
                manual_avatar = (dp(6), avatar_y + inset, dp(6) + avatar_size, avatar_y + avatar_size + inset)
        avatar_bounds = manual_avatar or cell_avatar
        for bounds in (cell_avatar, manual_avatar):
            if bounds:
                left = max(0, min(left, bounds[0] - dp(6)))

        if opt.anon_nick or opt.anon_avatar or opt.anon_usernames:
            ink = safe(lambda: tcolor(Theme.key_chat_messageTextOut if outgoing else Theme.key_chat_messageTextIn,
                                      self.provider))

            def mask(bounds, **kwargs):
                if bounds:
                    draw_mask(canvas, bmp, bounds, opt.style, ink, **kwargs)

            if opt.anon_usernames:
                for bounds in safe(lambda: username_bounds(cell, msg), []):
                    mask(shift(bounds, inset))
            if opt.anon_nick:
                names = [safe(lambda: getter(cell)) for getter in (reply_name_bounds, forward_bounds, via_bounds)]
                if not opt.fake_name:
                    names.append(safe(lambda: name_bounds(cell)))
                for bounds in names:
                    mask(shift(bounds, inset))
            if opt.anon_avatar:
                radius = round_radius(receiver, avatar_bounds)
                for bounds in (avatar_bounds, shift(safe(lambda: name_avatar_bounds(cell)), inset)):
                    mask(bounds, circle=True, radius=radius)
        return Shot(bmp, left, right, h, inset, entry.x, entry.row, decor)

    def group_extras(self, canvas, cell, pos):
        flags = pos.flags
        left_column = flags & MessageObject.POSITION_FLAG_LEFT
        if pos.last:
            attempt("album time", lambda: cell.drawTime(canvas, 1.0, True))
        if pos.minX == 0 and pos.minY == 0:
            attempt("album name", lambda: cell.hasNameLayout() and cell.drawNamesLayout(canvas, 1.0))
        attempt("album caption", lambda: flags & cell.captionFlag() and cell.drawCaptionLayout(canvas, not left_column, 1.0))
        if flags & MessageObject.POSITION_FLAG_BOTTOM and left_column:
            attempt("album reactions",
                    lambda: (cell.drawCommentLayout(canvas, 1.0), cell.drawReactionsLayout(canvas, 1.0, None)))

    def decor_bottom(self, cell, group, pos):
        try:
            siblings = getattr(pos, "siblingHeights", None)
            if siblings is None or len(siblings) == 0:
                return 0
            max_height = max(AndroidUtilities.displaySize.x, AndroidUtilities.displaySize.y) * 0.5
            extra = cell.getExtraInsetHeight() + sum(math.ceil(max_height * float(h)) for h in siblings)
            extra += (pos.maxY - pos.minY) * int(round(7 * AndroidUtilities.density))
            for index in range(group.posArray.size()):
                other = group.posArray.get(index)
                if other.minY != pos.minY or (other.minX == pos.minX and other.maxX == pos.maxX and other.maxY == pos.maxY):
                    continue
                extra -= math.ceil(max_height * other.ph) - dp(4)
                break
            return -extra
        except Exception as e:
            warn("album inset", e)
            return 0

    def action_cell(self):
        if self.action is None:
            chat = self.chat.getCurrentChat()
            cell = ChatActionCell(self.ctx, False, self.provider)
            cell.onAttachedToWindow()
            safe(lambda: setattr(cell, "isForum", chat is not None and ChatObject.isForum(chat)))
            safe(lambda: setattr(cell, "isMonoForum", chat is not None and ChatObject.isMonoForum(chat)))
            safe(lambda: cell.setShowTopic(True))
            self.action = cell
        return self.action

    def draw_action(self, msg, width, screen_h):
        cell = self.action_cell()
        cell.setMessageObject(msg, True)
        photo = cell.getPhotoImage()
        if photo is not None:
            photo.setAllowLoadingOnAttachedOnly(False)
            ImageLoader.getInstance().loadImageForImageReceiver(photo)
        cell.measure(View.MeasureSpec.makeMeasureSpec(width, EXACTLY), View.MeasureSpec.makeMeasureSpec(0, UNSPECIFIED))
        h = cell.getMeasuredHeight()
        if h <= 0:
            return None
        cell.layout(0, 0, width, h)
        safe(lambda: cell.setVisiblePart(0.0, screen_h))
        bmp = new_bitmap(width, h)
        canvas = Canvas(bmp)
        cell.draw(canvas)
        left, right = 0, width
        bg_left, bg_right = get_private_field(cell, "backgroundLeft"), get_private_field(cell, "backgroundRight")
        if bg_left is not None and bg_right is not None and bg_right > bg_left:
            left = max(0, bg_left - dp(8))
            right = min(width, max(left + 1, bg_right + dp(8)))
        if self.opt.anon_avatar and not msg.isDateObject and photo is not None:
            bounds = receiver_bounds(photo)
            if bounds:
                draw_mask(canvas, bmp, bounds, self.opt.style, safe(lambda: tcolor(Theme.key_chat_serviceText, self.provider)),
                          circle=True, radius=round_radius(photo, bounds))
        return Shot(bmp, left, right, h, 0, 0, None, 0)

    def compose_album(self, shots, width, pieces):
        try:
            heights = {}
            for shot in shots:
                row = shot.row or 0
                heights[row] = max(heights.get(row, 0), shot.height + shot.decor)
            row_tops, total = {}, 0
            for row in sorted(heights):
                row_tops[row] = total
                total += max(0, heights[row])
            logical_h = max(1, total)
            tops = [row_tops[shot.row or 0] - shot.inset for shot in shots]
            inset = max([0] + [-top for top in tops])
            height = max([inset + logical_h] + [inset + top + shot.bmp.getHeight() for top, shot in zip(tops, shots)])
            album = new_bitmap(width, height)
            canvas = Canvas(album)
            left, right = width, 0
            for top, shot in zip(tops, shots):
                canvas.drawBitmap(shot.bmp, float(shot.x), float(inset + top), None)
                left = min(left, max(0, min(width, shot.left + shot.x)))
                right = max(right, max(0, min(width, shot.right + shot.x)))
            if right <= left:
                left, right = 0, width
            pieces.append(Piece(album, left, right, logical_h, inset))
        except Exception as e:
            warn("album compose", e)
        finally:
            for shot in shots:
                safe(shot.bmp.recycle)

    def compose(self, pieces, wallpaper_bmp):
        left = min(piece.left for piece in pieces)
        right = max(piece.right for piece in pieces)
        if right <= left:
            left, right = 0, max(piece.bmp.getWidth() for piece in pieces)
        placed, y, min_y, max_y = [], 0, 0, 0
        for index, piece in enumerate(pieces):
            top = y - piece.inset
            min_y, max_y = min(min_y, top), max(max_y, top + piece.bmp.getHeight())
            placed.append((piece.bmp, top))
            y += piece.height + (dp(2) if index < len(pieces) - 1 else 0)
        pad = dp(8) if self.opt.transparent else dp(self.opt.padding)
        final = new_bitmap(max(1, right - left) + pad * 2, max(1, max_y - min_y) + pad * 2)
        canvas = Canvas(final)
        if not self.opt.transparent:
            self.paint_background(canvas, final, wallpaper_bmp, left - pad)
        for bmp, top in placed:
            canvas.drawBitmap(bmp, float(pad - left), float(pad + top - min_y), None)
            bmp.recycle()
        return final

    def paint_background(self, canvas, final, wallpaper_bmp, offset_x):
        bg_type, width, height = self.opt.bg_type, final.getWidth(), final.getHeight()
        if bg_type == 0 and wallpaper_bmp is not None:
            tile_wallpaper(canvas, wallpaper_bmp, width, height, offset_x)
        elif bg_type == 0:
            canvas.drawColor(jcolor(0xFF000000))
        elif bg_type == 2 and self.opt.bg_color & 0xFF000000:
            canvas.drawColor(jcolor(self.opt.bg_color))

    def encode(self, final, count):
        opt = self.opt
        factor = 1.0 if opt.transparent or opt.sticker else opt.scale
        if factor != 1.0:
            final = swap(final, rescale(final, factor))
        opt.watermark.draw(Canvas(final), final, self.chat, count, factor)
        jpeg = not opt.transparent and not opt.sticker and opt.fmt.name == "JPEG"
        if not jpeg and not opt.sticker and opt.corner > 0:
            final = swap(final, round_bitmap(final, int(dp(opt.corner) * factor)))
        out = ByteArrayOutputStream()
        if jpeg:
            final = swap(final, flatten(final))
            final.compress(Bitmap.CompressFormat.JPEG, opt.quality, out)
        else:
            final.compress(Bitmap.CompressFormat.PNG, 100, out)
        final.recycle()
        return out.toByteArray()


class Watermark:
    def __init__(self, prefs, logo=None):
        self.enabled = prefs.flag("watermark_enabled")
        self.template = prefs.text("watermark_text", "@username")
        self.position = prefs.num("watermark_position", 0, 0, 4)
        self.size = prefs.num("watermark_size", 13, 8, 48)
        self.opacity = prefs.num("watermark_opacity", 72, 5, 100)
        self.padding = prefs.num("watermark_padding", 12, 0, 64)
        self.angle = prefs.num("watermark_angle", 0, -45, 45)
        self.color = fade(prefs.color("watermark_color", "#FFFFFFFF"), self.opacity)
        self.blur = prefs.flag("watermark_blur_bg", True)
        self.plate = prefs.num("watermark_bg_opacity", 36, 0, 100)
        self.radius = prefs.num("watermark_bg_radius", 12, 0, 32)
        self.tile = prefs.flag("watermark_tile")
        self.logo = logo
        self.logo_size = prefs.num("watermark_logo_size", 28, 12, 96)
        self.logo_opacity = prefs.num("watermark_logo_opacity", 80, 5, 100)

    def caption(self, chat=None, count=None):
        text = self.template
        if "{" not in text:
            return text
        title = ""
        if chat is not None:
            current, user = chat.getCurrentChat(), chat.getCurrentUser()
            if current is not None:
                title = str(current.title or "")
            elif user is not None:
                title = str(UserObject.getUserName(user) or "")
        return (text.replace("{date}", time.strftime("%d.%m.%Y"))
                .replace("{chat}", title)
                .replace("{count}", "" if count is None else str(count)))

    def anchor(self, width, height, box_w, box_h, pad):
        right, bottom = width - pad - box_w, height - pad - box_h
        left, top = {
            1: (pad, bottom),
            2: (right, pad),
            3: (pad, pad),
            4: ((width - box_w) // 2, (height - box_h) // 2),
        }.get(self.position, (right, bottom))
        return max(0, min(max(0, width - box_w), left)), max(0, min(max(0, height - box_h), top))

    def text_paint(self):
        paint = Paint(Paint.ANTI_ALIAS_FLAG)
        paint.setDither(True)
        paint.setFakeBoldText(True)
        return paint

    def layout(self, paint, text, width, height, scale=1.0):
        size = max(1, int(round(self.size * scale)))
        pad = int(round(dp(self.padding) * scale))
        paint.setTextSize(float(dp(size)))
        paint.setColor(jcolor(self.color))

        def measure(value):
            return int(paint.measureText(value) + 0.999)

        limit = max(1, width - pad * 2 - int(dp(16) * scale))
        while size > 8 and measure(text) > limit:
            size -= 1
            paint.setTextSize(float(dp(size)))
        if measure(text) > limit:
            while text and measure(text.rstrip() + "...") > limit:
                text = text[:-1]
            text = text.rstrip() + "..." if text else "..."
        metrics = paint.getFontMetrics()
        inner_x, inner_y = int(dp(8) * scale), int(dp(5) * scale)
        box_w = max(1, measure(text) + inner_x * 2)
        box_h = max(1, int(metrics.descent - metrics.ascent + 0.999) + inner_y * 2)
        left, top = self.anchor(width, height, box_w, box_h, pad)
        return SimpleNamespace(
            text=text, left=left, top=top, box_w=box_w, box_h=box_h, inner_x=inner_x, inner_y=inner_y,
            ascent=float(metrics.ascent), radius=float(int(round(dp(self.radius) * scale))),
            rect=RectF(float(left), float(top), float(left + box_w), float(top + box_h)))

    def plate_color(self, least=0):
        return fade(0xFF000000 if is_light(self.color) else 0xFFFFFFFF, max(self.plate, least))

    def label(self, canvas, paint, lay):
        canvas.save()
        if self.angle:
            canvas.rotate(float(self.angle), lay.left + lay.box_w / 2.0, lay.top + lay.box_h / 2.0)
        canvas.drawText(lay.text, float(lay.left + lay.inner_x), float(lay.top + lay.inner_y) - lay.ascent, paint)
        canvas.restore()

    def tiles(self, canvas, paint, lay, width, height):
        step_x = max(int(lay.box_w * 1.6), dp(60))
        step_y = max(int(lay.box_h * 3.0), dp(52))
        span = int((width + height) * 0.75)
        canvas.save()
        canvas.rotate(float(self.angle or -30), width / 2.0, height / 2.0)
        for row, y in enumerate(range(-span, height + span, step_y)):
            for x in range(-span + (step_x // 2 if row % 2 else 0), width + span, step_x):
                canvas.drawText(lay.text, float(x), float(y), paint)
        canvas.restore()

    def draw_logo(self, canvas, width, height, scale=1.0):
        logo = self.logo
        if logo is None:
            return
        size = int(round(dp(self.logo_size) * scale))
        logo_w, logo_h = logo.getWidth(), logo.getHeight()
        dst_h = max(1, int(round(size * logo_h / max(1, logo_w))))
        left, top = self.anchor(width, height, size, dst_h, int(round(dp(self.padding) * scale)))
        paint = Paint(Paint.ANTI_ALIAS_FLAG)
        paint.setFilterBitmap(True)
        paint.setAlpha(int(255 * self.logo_opacity / 100))
        canvas.drawBitmap(logo, Rect(0, 0, logo_w, logo_h), Rect(left, top, left + size, top + dst_h), paint)

    def draw(self, canvas, bitmap, chat=None, count=None, scale=1.0):
        if not self.enabled:
            return
        try:
            width, height = bitmap.getWidth(), bitmap.getHeight()
            text = self.caption(chat, count)
            if text:
                paint = self.text_paint()
                lay = self.layout(paint, text, width, height, scale)
                shadow = max(32, min(145, int(self.opacity * 1.35)))
                paint.setShadowLayer(float(dp(1)), 0.0, float(dp(1)),
                                     jcolor((shadow << 24) | (0x000000 if is_light(self.color) else 0xFFFFFF)))
                if self.tile:
                    self.tiles(canvas, paint, lay, width, height)
                else:
                    if self.blur:
                        attempt("watermark blur", lambda: blur_region(canvas, bitmap, lay.rect, lay.radius))
                    if self.plate > 0:
                        plate = Paint(Paint.ANTI_ALIAS_FLAG)
                        plate.setColor(jcolor(self.plate_color()))
                        canvas.drawRoundRect(lay.rect, lay.radius, lay.radius, plate)
                    self.label(canvas, paint, lay)
            self.draw_logo(canvas, width, height, scale)
        except Exception as e:
            warn("watermark", e)

    def preview(self, canvas, provider):
        width, height = canvas.getWidth(), canvas.getHeight()
        if width <= 0 or height <= 0:
            return

        def color(key):
            return jcolor(tcolor(key, provider))

        def round_rect(paint, left, top, right, bottom, radius):
            canvas.drawRoundRect(RectF(float(left), float(top), float(right), float(bottom)),
                                 float(dp(radius)), float(dp(radius)), paint)

        pad = dp(8)
        paint = Paint(Paint.ANTI_ALIAS_FLAG)
        paint.setColor(color(Theme.key_windowBackgroundWhite))
        round_rect(paint, pad, 0, width - pad, height, 14)
        area = RectF(float(pad + dp(8)), float(dp(8)), float(width - pad - dp(8)), float(height - dp(8)))
        paint.setColor(color(Theme.key_chat_wallpaper))
        canvas.drawRoundRect(area, float(dp(12)), float(dp(12)), paint)

        left, top = pad + dp(22), dp(24)
        paint.setColor(color(Theme.key_chat_inBubble))
        round_rect(paint, left, top, left + min(dp(188), width - dp(92)), top + dp(44), 13)
        ink = Paint(Paint.ANTI_ALIAS_FLAG)
        ink.setTextSize(float(dp(13)))
        ink.setColor(color(Theme.key_chat_messageTextIn))
        canvas.drawText("Пример сообщения", float(left + dp(12)), float(top + dp(27)), ink)
        out_w = min(dp(178), width - dp(100))
        out_left, out_top = width - pad - dp(22) - out_w, top + dp(56)
        paint.setColor(color(Theme.key_chat_outBubble))
        round_rect(paint, out_left, out_top, out_left + out_w, out_top + dp(46), 13)
        ink.setColor(color(Theme.key_chat_messageTextOut))
        canvas.drawText("Так будет в цитате", float(out_left + dp(12)), float(out_top + dp(28)), ink)

        content_w, content_h = int(area.width()), int(area.height())
        text_paint = self.text_paint()
        lay = self.layout(text_paint, self.caption(count=3), content_w, content_h)
        canvas.save()
        canvas.clipRect(area)
        canvas.translate(float(int(area.left)), float(int(area.top)))
        if self.tile:
            self.tiles(canvas, text_paint, lay, content_w, content_h)
        else:
            if self.blur or self.plate > 0:
                paint.setColor(jcolor(self.plate_color(18 if self.blur else 0)))
                canvas.drawRoundRect(lay.rect, lay.radius, lay.radius, paint)
            self.label(canvas, text_paint, lay)
        self.draw_logo(canvas, content_w, content_h)
        canvas.restore()


class Prefs:
    def __init__(self, plugin):
        self.plugin = plugin
        self.live = {}

    def flag(self, key, default=False):
        return bool(self.plugin.get_setting(key, default))

    def choice(self, key):
        return safe(lambda: int(self.plugin.get_setting(key, 0) or 0), 0)

    def num(self, key, default, low, high):
        value = self.live.get(key)
        if value is None:
            value = safe(lambda: int(float(str(self.plugin.get_setting(key, str(default))).strip())), default)
        return max(low, min(high, value))

    def text(self, key, default):
        return str(self.plugin.get_setting(key, default) or "").strip() or default

    def hex(self, key, default):
        value = self.text(key, default)
        if not value.startswith("#"):
            value = "#" + value
        if len(value) == 7:
            value = "#FF" + value[1:]
        return value.upper() if safe(lambda: Color.parseColor(value) is not None, False) else default

    def color(self, key, default):
        return int(Color.parseColor(self.hex(key, default))) & 0xFFFFFFFF

    def format(self):
        return FORMATS[1] if self.choice("output_format") == 1 else FORMATS[0]

    def options(self, logo, sticker=False):
        flag = self.flag
        nick = flag("anonymize_nickname")
        return SimpleNamespace(
            sticker=sticker,
            transparent=sticker and flag("transparent_sticker", True),
            anon_nick=nick,
            anon_avatar=flag("anonymize_avatar"),
            anon_usernames=flag("anonymize_usernames"),
            style=self.choice("anonymize_style"),
            fake_name=self.text("anonymize_fake_text", "Аноним") if nick and flag("anonymize_fake_name") else "",
            hide_time=flag("hide_time"),
            hide_status=flag("hide_status"),
            hide_reactions=flag("hide_reactions"),
            hide_media=flag("hide_media"),
            bg_type=self.choice("bg_type"),
            bg_color=self.color("bg_color", "#FF000000"),
            padding=self.num("image_padding", 16, 0, 48),
            scale={1: 1.5, 2: 2.0}.get(self.choice("render_scale"), 1.0),
            fmt=self.format(),
            quality=self.num("jpeg_quality", 92, 40, 100),
            corner=self.num("corner_radius", 0, 0, 48),
            watermark=Watermark(self, logo),
        )


class Sheet:
    def __init__(self, plugin, chat, data, msgs, reply_to):
        self.plugin, self.chat, self.data, self.msgs, self.reply_to = plugin, chat, data, msgs, reply_to
        self.activity = chat.getParentActivity()
        self.provider = chat.getResourceProvider()
        self.account = chat.getCurrentAccount()
        self.dialog_id = chat.getDialogId()
        self.sheet = self.bitmap = self.image = self.spinner = self.meta = self.viewport = None
        self.busy = False
        self.generation = 0
        self.toggles = {}
        self.bounce = Bounce()
        self.hold = None
        self.ink = self.color(Theme.key_dialogTextBlack)
        self.surface = alpha(self.ink, 0.06)

    def color(self, key):
        return tcolor(key, self.provider)

    def ripple(self, fill, radius):
        return pressable(fill, radius, alpha(self.color(Theme.key_listSelector), 0.2))

    def notify(self, text, icon):
        res = getattr(R.raw, icon, 0)
        if self.sheet is not None and res and self.sheet.isShowing():
            try:
                return BulletinFactory.of(self.sheet.getContainer(), self.provider).createSimpleBulletin(res, text).show()
            except Exception as e:
                warn("sheet bulletin", e)
        toast(text, icon)

    def show(self):
        self.bitmap = decode(self.data)
        try:
            sheet = BottomSheet(self.activity, False, self.provider)
            fill = jcolor(self.color(Theme.key_dialogBackground))
            sheet.setBackgroundColor(fill)
            sheet.fixNavigationBar(fill)
            sheet.setOnHideListener(Dismiss(self.on_hide))
            self.sheet = sheet
            sheet.setCustomView(self.build())
            sheet.show()
            run_on_ui_thread(self.fit, 100)
        except Exception:
            self.on_hide()
            raise

    def on_hide(self):
        if self.image is not None:
            safe(lambda: self.image.setImageBitmap(None))
        self.image = self.sheet = self.viewport = None
        if self.bitmap is not None:
            self.bitmap.recycle()
            self.bitmap = None

    def build(self):
        ctx, plugin = self.activity, self.plugin
        content = linear(ctx, vertical=True, gravity=Gravity.CENTER_HORIZONTAL)
        content.setPadding(dp(14), dp(8), dp(14), dp(12))
        content.addView(self.preview(), LayoutHelper.createLinear(-1, -2))
        self.meta = label(ctx, self.meta_text(), 12, alpha(self.ink, 0.45))
        self.meta.setGravity(Gravity.CENTER)
        content.addView(self.meta, LayoutHelper.createLinear(-1, -2, 0, 8, 0, 0))
        content.addView(self.chips(), LayoutHelper.createLinear(-2, -2, Gravity.CENTER_HORIZONTAL, 0, 12, 0, 0))

        send = ButtonWithCounterView(ctx, True, self.provider)
        send.setText("Отправить", False)
        self.clickable(send, self.guarded(lambda v: plugin.send_quote(
            self.data, self.account, self.dialog_id, self.reply_to, "photo"), dismiss=True))
        content.addView(send, LayoutHelper.createLinear(-1, 48, 0, 14, 0, 0))
        content.addView(self.actions(), LayoutHelper.createLinear(-1, -2, 0, 14, 0, 0))

        self.sync()
        scroll = ScrollView(ctx)
        scroll.setFillViewport(True)
        scroll.setVerticalScrollBarEnabled(False)
        scroll.addView(content, LayoutHelper.createFrame(-1, -2))
        return scroll

    def preview(self):
        ctx = self.activity
        shell = FrameLayout(ctx)
        shell.setBackground(rounded(self.surface, 14))
        shell.setClipToOutline(True)

        image = ImageView(ctx)
        image.setAdjustViewBounds(True)
        image.setScaleType(ImageView.ScaleType.FIT_CENTER)
        image.setImageBitmap(self.bitmap)
        image.setContentDescription("Открыть превью на весь экран")
        image.setOnClickListener(OnClickListener(lambda v: self.open_zoom()))
        self.image = image
        viewport = ScrollView(ctx)
        viewport.setVerticalScrollBarEnabled(True)
        viewport.setOverScrollMode(View.OVER_SCROLL_NEVER)
        viewport.addView(image, LayoutHelper.createFrame(-1, -2))
        self.viewport = viewport
        self.hold = Hold(viewport)
        image.setOnTouchListener(self.hold)
        shell.addView(viewport, LayoutHelper.createFrame(-1, -2))
        self.fit()

        spinner = FrameLayout(ctx)
        spinner.setBackgroundColor(jcolor(alpha(self.color(Theme.key_dialogBackground), 0.6)))
        spinner.setClickable(True)
        spinner.setVisibility(View.GONE)
        progress = RadialProgressView(ctx, self.provider)
        progress.setSize(dp(28))
        progress.setProgressColor(jcolor(self.color(Theme.key_featuredStickers_addButton)))
        spinner.addView(progress, LayoutHelper.createFrame(40, 40, Gravity.CENTER))
        self.spinner = spinner
        shell.addView(spinner, LayoutHelper.createFrame(-1, -1, Gravity.CENTER))
        return shell

    def fit(self):
        viewport, bitmap = self.viewport, self.bitmap
        if viewport is None or bitmap is None:
            return
        width = viewport.getWidth() or AndroidUtilities.displaySize.x - dp(28)
        natural = int(width * bitmap.getHeight() / max(1, bitmap.getWidth()))
        params = viewport.getLayoutParams()
        params.height = max(1, min(natural, int(AndroidUtilities.displaySize.y * PREVIEW_SHARE)))
        viewport.setLayoutParams(params)

    def meta_text(self):
        count = len(self.msgs)
        return " · ".join((f"{count} {plural(count, 'сообщение', 'сообщения', 'сообщений')}",
                           self.plugin.prefs.format().name, size_text(len(self.data))))

    def chips(self):
        ctx = self.activity
        row = linear(ctx, gravity=Gravity.CENTER)
        for key, name, title in TOGGLES:
            chip = FrameLayout(ctx)
            chip.setContentDescription(title)
            safe(lambda: chip.setTooltipText(title))
            icon = ImageView(ctx)
            icon.setScaleType(ImageView.ScaleType.CENTER_INSIDE)
            icon.setImageResource(getattr(R.drawable, name))
            chip.addView(icon, LayoutHelper.createFrame(20, 20, Gravity.CENTER))
            params = LinearLayout.LayoutParams(dp(44), dp(34))
            if row.getChildCount():
                params.leftMargin = dp(6)
            row.addView(chip, params)
            self.toggles[key] = (chip, icon)
            self.clickable(chip, lambda v, key=key: self.toggle(key))
        return row

    def actions(self):
        ctx, plugin = self.activity, self.plugin
        row = linear(ctx, gravity=Gravity.TOP)
        items = (
            ("Чат", ("msg_forward",), lambda v: plugin.pick_chat(self.data), True),
            ("Файл", ("msg_filehq_solar", "msg_filehq"), lambda v: plugin.send_quote(
                self.data, self.account, self.dialog_id, self.reply_to, "file"), True),
            ("Стикер", ("msg_sticker_solar", "msg_sticker"), lambda v: plugin.make_sticker(
                self.msgs, self.chat, self.reply_to), True),
            ("Копия", ("msg_copy_solar", "msg_copy"), lambda v: plugin.copy_image(self.data, v, self.notify), False),
            ("Ещё", ("msg_share_solar", "msg_share"), lambda v: plugin.share_image(self.data, self.activity, v), False),
        )
        for title, icons, action, dismiss in items:
            cell = linear(ctx, vertical=True, gravity=Gravity.CENTER_HORIZONTAL)
            cell.setContentDescription(title)
            circle = FrameLayout(ctx)
            circle.setBackground(self.ripple(self.surface, 22))
            circle.setDuplicateParentStateEnabled(True)
            icon = ImageView(ctx)
            icon.setScaleType(ImageView.ScaleType.CENTER_INSIDE)
            icon.setImageResource(icon_res(*icons))
            icon.setColorFilter(self.ink)
            circle.addView(icon, LayoutHelper.createFrame(22, 22, Gravity.CENTER))
            cell.addView(circle, LinearLayout.LayoutParams(dp(44), dp(44)))
            caption = label(ctx, title, 12, alpha(self.ink, 0.7))
            caption.setGravity(Gravity.CENTER)
            cell.addView(caption, LayoutHelper.createLinear(-2, -2, Gravity.CENTER_HORIZONTAL, 0, 6, 0, 0))
            self.clickable(cell, self.guarded(action, dismiss=dismiss))
            row.addView(cell, LinearLayout.LayoutParams(0, -2, 1.0))
        return row

    def clickable(self, view, on_click):
        view.setClickable(True)
        view.setFocusable(True)
        view.setOnClickListener(OnClickListener(on_click))
        view.setOnTouchListener(self.bounce)

    def guarded(self, action, dismiss=False):
        def on_click(view):
            if self.busy:
                return
            if dismiss and self.sheet is not None:
                self.sheet.dismiss()
            action(view)
        return on_click

    def toggle(self, key):
        if self.busy:
            return
        self.plugin.set_setting(key, not self.plugin.prefs.flag(key))
        self.rerender()

    def sync(self):
        busy, prefs = self.busy, self.plugin.prefs
        for key, (chip, icon) in self.toggles.items():
            on = prefs.flag(key)
            fill = self.color(Theme.key_featuredStickers_addButton) if on else self.surface
            ink = self.color(Theme.key_featuredStickers_buttonText) if on else alpha(self.ink, 0.6)
            chip.setBackground(self.ripple(fill, 17))
            icon.setColorFilter(jcolor(ink))
            chip.setAlpha(0.5 if busy else 1.0)
            chip.setClickable(not busy)
        if self.spinner is not None:
            self.spinner.setVisibility(View.VISIBLE if busy else View.GONE)
        if self.image is not None:
            self.image.setClickable(not busy)

    def rerender(self):
        self.generation += 1
        generation = self.generation
        self.busy = True
        self.sync()
        run_on_queue(lambda: self.render_task(generation), PLUGINS_QUEUE, DEBOUNCE_MS)

    def render_task(self, generation):
        if generation != self.generation or self.sheet is None:
            return
        data = error = None
        try:
            data = self.plugin.render_bytes(self.msgs, self.chat)
            if not data:
                error = "пустой результат рендера"
        except Exception as e:
            warn("preview render", traceback.format_exc())
            error = str(e)
        run_on_ui_thread(lambda: self.apply(generation, data, error))

    def apply(self, generation, data, error):
        if generation != self.generation:
            return
        if error is None:
            try:
                self.replace(data)
            except Exception as e:
                error = str(e)
        self.busy = False
        self.sync()
        if error:
            BulletinHelper.show_error(f"Не удалось обновить превью: {error[:80]}")

    def replace(self, data):
        bitmap = decode(data)
        if self.sheet is None:
            bitmap.recycle()
            return
        old, self.bitmap, self.data = self.bitmap, bitmap, data
        self.image.setImageBitmap(bitmap)
        old.recycle()
        self.fit()
        self.meta.setText(self.meta_text())

    def open_zoom(self):
        if self.busy or self.bitmap is None:
            return
        try:
            Zoom(self.activity, self.bitmap).show()
        except Exception as e:
            warn("zoom", e)


class Pinch(dynamic_proxy(ScaleGestureDetector.OnScaleGestureListener)):
    def __init__(self, zoom):
        super().__init__()
        self.zoom = zoom

    def onScaleBegin(self, detector):
        return True

    def onScale(self, detector):
        self.zoom.set_scale(self.zoom.scale * float(detector.getScaleFactor()))
        return True

    def onScaleEnd(self, detector):
        pass


class Pan(dynamic_proxy(View.OnTouchListener)):
    def __init__(self, zoom):
        super().__init__()
        self.zoom = zoom
        self.last_x = self.last_y = self.down_x = self.down_y = self.last_tap = 0.0
        self.tap = self.resync = False

    def onTouch(self, view, event):
        zoom = self.zoom
        try:
            zoom.detector.onTouchEvent(event)
            action = event.getActionMasked()
            x, y = float(event.getX()), float(event.getY())
            if action == MotionEvent.ACTION_DOWN:
                self.down_x, self.last_x, self.down_y, self.last_y = x, x, y, y
                now = time.time()
                double = now - self.last_tap < 0.3
                self.last_tap = 0.0 if double else now
                self.tap, self.resync = not double, False
                if double:
                    zoom.set_scale(1.0 if zoom.scale > 1.01 else 2.5)
            elif action in (MotionEvent.ACTION_POINTER_DOWN, MotionEvent.ACTION_POINTER_UP):
                self.tap, self.resync = False, True
            elif action == MotionEvent.ACTION_MOVE:
                if abs(x - self.down_x) > dp(8) or abs(y - self.down_y) > dp(8):
                    self.tap = False
                if event.getPointerCount() == 1 and zoom.scale > 1.01 and not self.resync:
                    zoom.pan(x - self.last_x, y - self.last_y)
                self.last_x, self.last_y, self.resync = x, y, False
            elif action == MotionEvent.ACTION_UP and self.tap and not zoom.hits(x, y):
                zoom.dismiss()
        except Exception as e:
            warn("zoom touch", e)
        return True


class Zoom:
    def __init__(self, activity, bitmap):
        self.activity, self.bitmap = activity, bitmap
        self.scale, self.tx, self.ty = 1.0, 0.0, 0.0
        self.dialog = self.image = self.detector = self.listeners = None

    def show(self):
        ctx = self.activity
        root = FrameLayout(ctx)
        root.setBackgroundColor(jcolor(0xF00E0E0E))
        image = ImageView(ctx)
        image.setScaleType(ImageView.ScaleType.FIT_CENTER)
        image.setImageBitmap(self.bitmap)
        self.image = image
        root.addView(image, LayoutHelper.createFrame(-1, -1, Gravity.CENTER))

        pinch, pan = Pinch(self), Pan(self)
        self.listeners = (pinch, pan)
        self.detector = ScaleGestureDetector(ctx, pinch)
        root.setOnTouchListener(pan)

        close = label(ctx, "Закрыть", 15, 0xFFFFFFFF)
        close.setPadding(dp(18), dp(12), dp(18), dp(12))
        close.setOnClickListener(OnClickListener(lambda v: self.dismiss()))
        root.addView(close, LayoutHelper.createFrame(-2, -2, Gravity.TOP | Gravity.RIGHT, 0, 8, 8, 0))

        dialog = Dialog(ctx, AndroidR.style.Theme_Translucent_NoTitleBar_Fullscreen)
        dialog.setContentView(root, ViewGroup.LayoutParams(-1, -1))
        window = dialog.getWindow()
        window.setBackgroundDrawableResource(AndroidR.color.transparent)
        window.setLayout(-1, -1)
        self.dialog = dialog
        dialog.show()

    def set_scale(self, value):
        self.scale = max(1.0, min(5.0, float(value)))
        if self.scale <= 1.01:
            self.tx = self.ty = 0.0
        self.apply()

    def pan(self, dx, dy):
        self.tx += dx
        self.ty += dy
        self.apply()

    def apply(self):
        self.image.setScaleX(float(self.scale))
        self.image.setScaleY(float(self.scale))
        self.image.setTranslationX(float(self.tx))
        self.image.setTranslationY(float(self.ty))

    def hits(self, x, y):
        width, height = self.image.getWidth(), self.image.getHeight()
        bmp_w, bmp_h = self.bitmap.getWidth(), self.bitmap.getHeight()
        if width <= 0 or height <= 0 or bmp_w <= 0 or bmp_h <= 0:
            return True
        fit = min(width / bmp_w, height / bmp_h) * self.scale
        center_x = self.image.getLeft() + width / 2.0 + self.tx
        center_y = self.image.getTop() + height / 2.0 + self.ty
        return abs(x - center_x) <= bmp_w * fit / 2.0 and abs(y - center_y) <= bmp_h * fit / 2.0

    def dismiss(self):
        if self.dialog is not None:
            safe(self.dialog.dismiss)
            self.dialog = None


def deferred(fn):
    def hook(param):
        target = param.thisObject
        run_on_ui_thread(lambda: fn(target))
    return hook


def call_private(obj, name, types=(), args=()):
    method = obj.getClass().getDeclaredMethod(name, *types)
    method.setAccessible(True)
    return method.invoke(obj, *args)


def action_mode(chat):
    bar = chat.getActionBar()
    return bar is not None and bar.isActionModeShowed()


class QuotePlugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self.prefs = Prefs(self)
        self.tmp = None
        self.btn = None
        self.bg_cache = None
        self.logo_cache = None
        self.logo_hook = None
        self.refs = {}
        self.held = []
        self.previews = []
        self.selected_ids = set()
        self.selected_paint = Paint(Paint.ANTI_ALIAS_FLAG)

    def on_plugin_load(self):
        self.tmp = tmp_dir()
        self.hook_private(ChatActivity, "addToSelectedMessages", (MessageObject, Boolean.TYPE, Boolean.TYPE),
                    Hook(after=deferred(self.on_selection)))
        self.hook_private(ChatActivity, "hideActionMode", (),
                    Hook(after=deferred(self.on_action_hidden)))
        self.hook_private(ChatActivity, "processRowSelect", (View, Boolean.TYPE, Float.TYPE, Float.TYPE),
                    Hook(before=self.on_row_select))
        self.hook_private(ChatActionCell, "onDraw", (Canvas,), Hook(after=self.draw_selection))
        try:
            self.add_menu_item(MenuItemData(
                menu_type=MenuItemType.MESSAGE_CONTEXT_MENU,
                item_id="quotecreate_make_quote",
                text="Сделать цитату",
                icon="msg_screencast",
                condition="message != null",
                on_click=self.on_menu,
                priority=8,
            ))
        except Exception as e:
            warn("menu item", e)
        run_on_queue(self.sweep, PLUGINS_QUEUE)

    def on_plugin_unload(self):
        run_on_ui_thread(self.drop_button)
        self.selected_ids = set()
        self.refs.clear()
        self.held = []
        self.previews = []
        self.logo_cache = None
        if self.bg_cache is not None:
            safe(self.bg_cache[2].recycle)
            self.bg_cache = None
        run_on_queue(lambda: self.sweep(0), PLUGINS_QUEUE)

    def hook_private(self, cls, name, types, hook):
        try:
            method = cls.getClass().getDeclaredMethod(name, *types)
            method.setAccessible(True)
            return self.hook_method(method, hook)
        except Exception as e:
            warn(f"hook {name} skipped", e)
            return None

    def on_selection(self, chat):
        self.update_button(chat)
        self.sync_cells(chat)

    def on_action_hidden(self, chat):
        self.drop_button()
        self.sync_cells(chat)

    def update_button(self, chat):
        try:
            if not action_mode(chat):
                return self.drop_button()
            container = get_private_field(chat, "actionsButtonsLayout")
            if container is None or container.findViewWithTag(BUTTON_TAG) is not None:
                return
            factory = get_private_field(chat, "glassBackgroundDrawableFactory")
            colors = get_private_field(chat, "blurredBackgroundColorProvider")
            if BlurredRoundButton is None or factory is None or colors is None:
                raise Exception("ChatActivityBlurredRoundButton недоступен")
            provider, icon = chat.getResourceProvider(), R.drawable.input_video_pressed_solar
            try:
                button = BlurredRoundButton.create(chat.getParentActivity(), factory, colors, provider, icon, 48)
            except Exception:
                button = BlurredRoundButton.create(chat.getParentActivity(), factory, colors, provider)
                button.setIcon(icon, 48)
                button.setIconColor(jcolor(tcolor(Theme.key_glass_defaultIcon, provider)))
            button.setTag(BUTTON_TAG)
            button.setOnClickListener(OnClickListener(lambda v: self.on_button(chat)))
            params = LinearLayout.LayoutParams(dp(56), dp(56))
            params.setMargins(dp(8), 0, dp(8), 0)
            container.addView(button, 1, params)
            self.btn = button
        except Exception as e:
            warn("action button", e)

    def drop_button(self):
        parent = self.btn.getParent() if self.btn is not None else None
        if parent is not None:
            parent.removeView(self.btn)
        self.btn = None

    def on_row_select(self, param):
        try:
            chat, view = param.thisObject, param.args[0]
            if not action_mode(chat) or not isinstance(view, ChatActionCell):
                return
            msg = view.getMessageObject()
            if not is_service(msg):
                return
            call_private(chat, "addToSelectedMessages", (MessageObject, Boolean.TYPE), (msg, bool(param.args[1])))
            safe(lambda: call_private(chat, "updateActionModeTitle"))
            safe(chat.updateVisibleRows)
            self.sync_cells(chat)
            param.setResult(None)
        except Exception as e:
            warn("row select", e)

    def sync_cells(self, chat):
        try:
            selected = get_private_field(chat, "selectedMessagesIds") if action_mode(chat) else None
            self.selected_ids = {msg.getId() for msg in selected_messages(chat) if is_service(msg)} if selected is not None else set()
            if self.selected_ids:
                fill = tcolor(Theme.key_chat_serviceBackgroundSelected, chat.getResourceProvider())
                self.selected_paint.setColor(jcolor((118 << 24) | (fill & 0xFFFFFF)))
            list_view = chat.getChatListView()
            for index in range(list_view.getChildCount() if list_view is not None else 0):
                cell = list_view.getChildAt(index)
                if isinstance(cell, ChatActionCell):
                    safe(lambda: self.paint_cell(chat, cell, selected))
        except Exception as e:
            warn("service selection", e)

    def paint_cell(self, chat, cell, selected):
        msg = cell.getMessageObject()
        if selected is None:
            cell.setOverrideColor(-1, -1)
        elif is_service(msg) and selected[0 if msg.getDialogId() == chat.getDialogId() else 1].indexOfKey(msg.getId()) >= 0:
            cell.setOverrideColor(Theme.key_chat_serviceBackgroundSelected, Theme.key_chat_serviceText)
        else:
            cell.setOverrideColor(Theme.key_chat_serviceBackground, Theme.key_chat_serviceText)
        cell.invalidate()

    def draw_selection(self, param):
        if not self.selected_ids:
            return
        try:
            cell, canvas = param.thisObject, param.args[0]
            msg = cell.getMessageObject()
            if msg is not None and msg.getId() in self.selected_ids:
                canvas.drawRect(0.0, 0.0, float(cell.getWidth()), float(cell.getHeight()), self.selected_paint)
        except Exception:
            pass

    def on_button(self, chat):
        msgs = sorted(selected_messages(chat), key=lambda m: m.getId())
        if not msgs:
            return BulletinHelper.show_error("Нет сообщений")
        safe(chat.clearSelectionMode)
        self.make_quote(msgs, chat)

    def on_menu(self, context):
        try:
            msg, fragment = context.get("message"), context.get("fragment")
            if msg is None:
                return BulletinHelper.show_error("Не удалось получить сообщение")
            if not isinstance(fragment, ChatActivity):
                return BulletinHelper.show_error("Цитату можно создать только из чата")
            group = context.get("groupedMessages")
            items = getattr(group, "messages", None) if group is not None else None
            msgs = [items.get(i) for i in range(items.size())] if items is not None and items.size() else [msg]
            self.make_quote(sorted(msgs, key=lambda m: m.getId()), fragment)
        except Exception as e:
            warn("menu quote", e)
            BulletinHelper.show_error("Не удалось создать цитату")

    def make_quote(self, msgs, chat):
        self.render_async(msgs, chat, "Рендер...", lambda data: self.show_sheet(chat, data, msgs))

    def make_sticker(self, msgs, chat, reply_to):
        account, dialog_id = chat.getCurrentAccount(), chat.getDialogId()
        self.render_async(msgs, chat, "Рендер стикера...",
                          lambda data: self.send_quote(data, account, dialog_id, reply_to, "sticker"), sticker=True)

    def render_async(self, msgs, chat, title, on_done, sticker=False):
        dialog = AlertDialogBuilder(chat.getParentActivity(), AlertDialogBuilder.ALERT_TYPE_SPINNER).set_title(title).show()

        def task():
            try:
                data = self.render_bytes(msgs, chat, sticker)
                if not data:
                    raise Exception("рендер вернул пустой результат")
                run_on_ui_thread(lambda: (dialog.dismiss(), on_done(data)))
            except Exception as e:
                warn("render", traceback.format_exc())
                error = str(e)[:120]
                run_on_ui_thread(lambda: (dialog.dismiss(), BulletinHelper.show_error(error)))

        run_on_queue(task, PLUGINS_QUEUE)

    def render_bytes(self, msgs, chat, sticker=False):
        opt = self.prefs.options(self.logo_image(), sticker)
        bg = None if opt.transparent or opt.bg_type != 0 else self.chat_background(chat)
        try:
            safe(lambda: preload(msgs, chat.getCurrentAccount()))
            return Renderer(msgs, chat, opt).render(bg)
        finally:
            if bg is not None:
                bg.recycle()

    def chat_background(self, chat):
        key = (chat.getDialogId(), AndroidUtilities.displaySize.x, AndroidUtilities.displaySize.y)
        now, cached = time.time(), self.bg_cache
        if not (cached and cached[0] == key and now - cached[1] < 4.0):
            bmp = safe(lambda: wallpaper(chat))
            if bmp is None:
                return None
            if cached:
                cached[2].recycle()
            self.bg_cache = cached = (key, now, bmp)
        return cached[2].copy(cached[2].getConfig(), False)

    def show_sheet(self, chat, data, msgs):
        account, dialog_id = chat.getCurrentAccount(), chat.getDialogId()
        reply_to = (safe(chat.getThreadMessage)
                    or top_reply(account, safe(chat.getTopicId, 0), dialog_id)
                    or top_reply(account, topic_of(account, msgs[0], dialog_id), dialog_id))
        try:
            Sheet(self, chat, data, msgs, reply_to).show()
        except Exception as e:
            warn("preview sheet", traceback.format_exc())
            BulletinHelper.show_error(f"Не удалось открыть предпросмотр: {str(e)[:60]}")

    def send_quote(self, data, account, dialog_id, reply_to, mode):
        fmt = self.prefs.format()

        def prepare():
            stamp = int(time.time() * 1000)
            if mode == "sticker":
                bmp = BitmapFactory.decodeByteArray(data, 0, len(data))
                if bmp is None:
                    raise Exception("не удалось декодировать изображение")
                path = self.tmp_path(f"q_{stamp}.webp")
                bmp = fit_sticker(bmp)
                try:
                    write_webp(bmp, path)
                finally:
                    bmp.recycle()
                media = make_document(path, "image/webp", sticker=True)
            else:
                path = self.write_tmp(f"q_{stamp}.{fmt.ext}", data)
                if mode == "file":
                    media = make_document(path, fmt.mime)
                else:
                    media = SendMessagesHelper.getInstance(account).generatePhotoSizes(path, None)
                    if media is None:
                        raise Exception("не удалось подготовить фото")
            run_on_ui_thread(lambda: self.deliver(media, path, account, dialog_id, reply_to, mode))

        background(prepare, "Ошибка отправки")

    def deliver(self, media, path, account, dialog_id, reply_to, mode):
        try:
            extra = HashMap()
            extra.put("originalPath", path)
            build = SendMessagesHelper.SendMessageParams.of
            if mode == "photo":
                params = build(media, None, dialog_id, reply_to, reply_to, None, None, None, extra,
                               True, 0, 0, 0, None, False, False)
            else:
                params = build(media, None, path, dialog_id, reply_to, reply_to, None, None, None, extra,
                               True, 0, 0, 0, None, None, False)
            SendMessagesHelper.getInstance(account).sendMessage(params)
            if mode == "sticker":
                toast("Стикер отправлен", "smile_to_sticker")
            else:
                toast("Отправлено", "forward")
        except Exception as e:
            warn("send", traceback.format_exc())
            BulletinHelper.show_error(f"Ошибка отправки: {str(e)[:100]}")

    def pick_chat(self, data):
        def open_picker():
            try:
                fragment = get_last_fragment()
                if fragment is None:
                    return BulletinHelper.show_error("Нет активного экрана")
                args = Bundle()
                args.putInt("dialogsType", 3)
                args.putBoolean("resetDelegate", False)
                for key in ("onlySelect", "closeFragment", "canSelectTopics", "checkCanWrite", "allowGlobalSearch",
                            "allowUsers", "allowBots", "allowGroups", "allowMegagroups", "allowLegacyGroups",
                            "allowChannels"):
                    args.putBoolean(key, True)
                picker = DialogsActivity(args)
                delegate = Picked(lambda chosen, dids: self.on_picked(chosen, dids, data))
                self.refs["picker"] = delegate
                picker.setDelegate(delegate)
                fragment.presentFragment(picker)
            except Exception as e:
                warn("chat picker", e)
                BulletinHelper.show_error("Не удалось открыть выбор чата")

        run_on_ui_thread(open_picker)

    def on_picked(self, fragment, dids, data):
        topic = dids.get(0) if dids is not None and dids.size() else None
        if topic is None or topic.dialogId == 0:
            return BulletinHelper.show_error("Чат не выбран")
        account = fragment.getCurrentAccount()
        self.refs.pop("picker", None)
        safe(fragment.finishFragment)
        self.send_quote(data, account, topic.dialogId, top_reply(account, topic.topicId, topic.dialogId), "photo")

    def share_image(self, data, activity, view):
        haptic(view)
        fmt = self.prefs.format()

        def prepare():
            uri = file_uri(self.write_tmp(f"share_{int(time.time() * 1000)}.{fmt.ext}", data))

            def open_chooser():
                intent = Intent(Intent.ACTION_SEND)
                intent.setType(fmt.mime)
                intent.putExtra(Intent.EXTRA_STREAM, uri)
                intent.addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)
                chooser = Intent.createChooser(intent, "Поделиться")
                if activity is None:
                    chooser.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
                try:
                    (activity or ApplicationLoader.applicationContext).startActivity(chooser)
                except Exception as e:
                    BulletinHelper.show_error(f"Ошибка отправки: {str(e)[:60]}")

            run_on_ui_thread(open_chooser)

        background(prepare, "Ошибка отправки")

    def copy_image(self, data, view, notify):
        haptic(view)
        context = ApplicationLoader.applicationContext
        ext = self.prefs.format().ext

        def copy():
            uri = file_uri(self.write_tmp(f"c_{int(time.time() * 1000)}.{ext}", data))
            clip = ClipData.newUri(context.getContentResolver(), "Image", uri)

            def set_clip():
                try:
                    context.getSystemService(Context.CLIPBOARD_SERVICE).setPrimaryClip(clip)
                    notify("Скопировано", "copy")
                except Exception as e:
                    BulletinHelper.show_error(f"Ошибка копирования: {str(e)[:60]}")

            run_on_ui_thread(set_clip)

        background(copy, "Ошибка копирования")

    def tmp_path(self, name):
        os.makedirs(self.tmp, exist_ok=True)
        return os.path.join(self.tmp, name)

    def write_tmp(self, name, data):
        path = self.tmp_path(name)
        with open(path, "wb") as file:
            file.write(bytes(data))
        return path

    def sweep(self, max_age=TMP_AGE):
        logo = self.logo_path()
        keep = os.path.abspath(logo) if logo else None
        try:
            now = time.time()
            for name in os.listdir(self.tmp):
                path = os.path.join(self.tmp, name)
                if os.path.abspath(path) != keep and os.path.isfile(path) and now - os.path.getmtime(path) >= max_age:
                    with suppress(OSError):
                        os.remove(path)
        except Exception as e:
            warn("temp cleanup", e)

    def create_settings(self):
        self.held = []
        self.previews = []
        prefs, slider = self.prefs, self.slider
        items = [
            Header("Фон"),
            Selector("bg_type", "Тип фона", 0, ["Тема чата", "Прозрачный", "Свой цвет"], icon="msg_background",
                     on_change=self.reloader("bg_type", 0)),
        ]
        if prefs.choice("bg_type") == 2:
            items.append(Text(f"Цвет фона: {prefs.hex('bg_color', '#FF000000')}", icon="msg_palette",
                              on_click=lambda *_: self.pick_color("bg_color", "#FF000000", reload=True)))
        items += [
            Switch("transparent_sticker", "Прозрачный фон для стикера", True, icon="media_sticker_stroke"),
            Header("Изображение"),
            Selector("output_format", "Формат", 0, ["PNG", "JPEG"], icon="msg_photos",
                     on_change=self.reloader("output_format", 0)),
        ]
        jpeg = prefs.format().name == "JPEG"
        if jpeg:
            items.append(slider("jpeg_quality", "Качество JPEG", 92, 40, 100, "%"))
        items += [
            Selector("render_scale", "Масштаб", 0, ["1x", "1.5x", "2x"], icon="msg_zoomin"),
            slider("image_padding", "Поля вокруг цитаты", 16, 0, 48, "dp"),
        ]
        if not jpeg:
            items.append(slider("corner_radius", "Скругление углов", 0, 0, 48, "dp"))
        items += [
            Header("Водяной знак"),
            Switch("watermark_enabled", "Водяной знак", False, icon="msg_photo_text_framed",
                   on_change=self.reloader("watermark_enabled", False)),
        ]
        if prefs.flag("watermark_enabled"):
            items += self.watermark_settings()
        items += [
            Header("Отображение"),
            Switch("hide_time", "Скрывать время", False, icon="msg_contacts_time"),
            Switch("hide_status", "Скрывать галочки и просмотры", False, icon="msg_markread"),
            Switch("hide_reactions", "Скрывать реакции", False, icon="msg_reactions"),
            Switch("hide_media", "Скрывать медиа", False, icon="menu_photo_off_24"),
            Header("Анонимизация"),
            Selector("anonymize_style", "Эффект", 0, ["Размытие", "Пиксели", "Спойлер", "Замазка", "Скрыть"],
                     icon="msg_photo_blur"),
            Switch("anonymize_nickname", "Скрывать никнейм", False, icon="msg_contacts_name"),
            Switch("anonymize_avatar", "Скрывать аватар", False, icon="msg_openprofile"),
            Switch("anonymize_usernames", "Скрывать @юзернеймы в тексте", False, icon="msg_mention"),
            Switch("anonymize_fake_name", "Подменять имя вместо закраски", False, icon="msg_replace",
                   on_change=self.reloader("anonymize_fake_name", False)),
        ]
        if prefs.flag("anonymize_fake_name"):
            items.append(Input("anonymize_fake_text", "Подставляемое имя", "Аноним", icon="msg_edit"))
        return items

    def watermark_settings(self):
        slider, logo = self.slider, self.logo_path()
        items = [
            self.custom_row(self.preview_factory()),
            Input("watermark_text", "Текст", "@username", subtext="{date}, {chat}, {count}", icon="msg_photo_text_regular"),
            Selector("watermark_position", "Позиция", 0, ["Низ справа", "Низ слева", "Верх справа", "Верх слева", "Центр"],
                     icon="msg_location", on_change=lambda *_: self.refresh_previews()),
            slider("watermark_size", "Размер текста", 13, 8, 48, "dp"),
            slider("watermark_opacity", "Прозрачность текста", 72, 5, 100, "%"),
            slider("watermark_padding", "Отступ от края", 12, 0, 64, "dp"),
            slider("watermark_angle", "Наклон текста", 0, -45, 45, "°"),
            self.custom_row(self.palette_factory()),
            Switch("watermark_tile", "Замостить по диагонали", False, icon="msg_media",
                   on_change=self.reloader("watermark_tile", False)),
        ]
        if not self.prefs.flag("watermark_tile"):
            items += [
                Switch("watermark_blur_bg", "Размытый фон под текстом", True, icon="msg_blur_radial",
                       on_change=lambda *_: self.refresh_previews()),
                slider("watermark_bg_opacity", "Прозрачность плашки", 36, 0, 100, "%"),
                slider("watermark_bg_radius", "Скругление плашки", 12, 0, 32, "dp"),
            ]
        items.append(Text(f"Логотип: {os.path.basename(logo) if logo else 'не выбран'}",
                          icon="msg_addphoto", on_click=self.pick_logo))
        if logo:
            items += [
                slider("watermark_logo_size", "Размер логотипа", 28, 12, 96, "dp"),
                slider("watermark_logo_opacity", "Прозрачность логотипа", 80, 5, 100, "%"),
                Text("Убрать логотип", icon="msg_delete", red=True, on_click=self.clear_logo),
            ]
        return items

    def reloader(self, key, default):
        return lambda *_: self.set_setting(key, self.get_setting(key, default), reload_settings=True)

    def custom_row(self, factory):
        self.held.append(factory)
        return Custom(factory=factory.instance.java)

    def refresh_previews(self):
        for view in self.previews:
            safe(view.invalidate)

    def slider(self, key, title, default, low, high, suffix):
        prefs = self.prefs

        def current():
            return prefs.num(key, default, low, high)

        def caption(value):
            return f"{value}{suffix}" if suffix in ("%", "°") else f"{value} {suffix}"

        def flush():
            value = prefs.live.pop(key, None)
            if value is not None:
                self.set_setting(key, str(value))

        def create_view(context, list_view, account, class_guid, provider):
            root = setting_row(context)
            row = linear(context)
            row.addView(label(context, title, 16, tcolor(Theme.key_windowBackgroundWhiteBlackText, provider)),
                        LinearLayout.LayoutParams(0, -2, 1.0))
            value_view = label(context, caption(current()), 14,
                               tcolor(Theme.key_windowBackgroundWhiteBlueText, provider), bold=True)
            row.addView(value_view, LayoutHelper.createLinear(-2, -2))
            root.addView(row, LayoutHelper.createLinear(-1, -2))
            seek = SeekBarView(context, provider)
            seek.setReportChanges(True)
            root.addView(seek, LayoutHelper.createLinear(-1, 38, 0, 2, 0, 0, 0))

            def on_drag(stop, progress):
                value = max(low, min(high, int(round(low + (high - low) * progress))))
                value_view.setText(caption(value))
                prefs.live[key] = value
                if stop:
                    flush()
                self.refresh_previews()

            delegate = Slider(on_drag, flush, lambda: f"{title}: {caption(current())}", high - low)
            self.held.append(delegate)
            seek.setDelegate(delegate)
            return root

        def bind_view(view, item, divider, adapter, list_view):
            value = current()
            safe(lambda: view.getChildAt(0).getChildAt(1).setText(caption(value)))
            safe(lambda: view.getChildAt(1).setProgress(float(value - low) / (high - low)))

        return self.custom_row(SimpleSettingFactory(create_view, bind_view, is_clickable=False, is_shadow=False))

    def palette_factory(self):
        prefs, provider_ref = self.prefs, [None]

        def paint_circle(view, color, selected):
            circle = GradientDrawable()
            circle.setShape(GradientDrawable.OVAL)
            circle.setColor(jcolor(color))
            stroke = tcolor(Theme.key_windowBackgroundWhiteBlueText if selected else Theme.key_divider, provider_ref[0])
            circle.setStroke(dp(2 if selected else 1), stroke)
            view.setBackground(circle)

        def refresh(root):
            current = prefs.hex("watermark_color", "#FFFFFFFF")
            root.getChildAt(0).getChildAt(1).setText(current)
            swatches = root.getChildAt(1)
            for index, color in enumerate(SWATCHES):
                paint_circle(swatches.getChildAt(index), color, to_hex(color) == current)
            custom = current not in {to_hex(color) for color in SWATCHES}
            picker = swatches.getChildAt(len(SWATCHES))
            paint_circle(picker, prefs.color("watermark_color", current) if custom else 0, custom)
            icon = picker.getChildAt(0)
            icon.setVisibility(View.GONE if custom else View.VISIBLE)
            icon.setColorFilter(tcolor(Theme.key_windowBackgroundWhiteGrayText2, provider_ref[0]))
            self.refresh_previews()

        def create_view(context, list_view, account, class_guid, provider):
            provider_ref[0] = provider
            root = setting_row(context)
            row = linear(context)
            row.addView(label(context, "Цвет текста", 16, tcolor(Theme.key_windowBackgroundWhiteBlackText, provider)),
                        LinearLayout.LayoutParams(0, -2, 1.0))
            row.addView(label(context, prefs.hex("watermark_color", "#FFFFFFFF"), 13,
                              tcolor(Theme.key_windowBackgroundWhiteGrayText2, provider)),
                        LayoutHelper.createLinear(-2, -2))
            root.addView(row, LayoutHelper.createLinear(-1, -2))
            swatches = linear(context)

            def add_circle(on_click):
                circle = FrameLayout(context)
                circle.setClickable(True)
                circle.setFocusable(True)
                circle.setOnClickListener(OnClickListener(on_click))
                params = LinearLayout.LayoutParams(dp(32), dp(32))
                params.rightMargin = dp(10)
                swatches.addView(circle, params)
                return circle

            def select(color):
                self.set_setting("watermark_color", to_hex(color))
                refresh(root)

            for color in SWATCHES:
                add_circle(lambda v, color=color: select(color))
            picker = add_circle(lambda v: self.pick_color("watermark_color", "#FFFFFFFF", on_pick=lambda c: refresh(root)))
            icon = ImageView(context)
            icon.setScaleType(ImageView.ScaleType.CENTER_INSIDE)
            icon.setImageResource(R.drawable.msg_palette)
            picker.addView(icon, LayoutHelper.createFrame(18, 18, Gravity.CENTER))
            root.addView(swatches, LayoutHelper.createLinear(-1, -2, 0, 9, 0, 0, 0))
            return root

        def bind_view(view, item, divider, adapter, list_view):
            safe(lambda: refresh(view))

        return SimpleSettingFactory(create_view, bind_view, is_clickable=False, is_shadow=False)

    def preview_factory(self):
        def create_view(context, list_view, account, class_guid, provider):
            root = setting_row(context)
            root.addView(label(context, "Предпросмотр", 16, tcolor(Theme.key_windowBackgroundWhiteBlackText, provider),
                               bold=True), LayoutHelper.createLinear(-1, -2))
            if UniversalView is None or UniversalViewDelegate is None:
                return root
            delegate = Drawer(lambda canvas: attempt(
                "watermark preview", lambda: Watermark(self.prefs, self.logo_image()).preview(canvas, provider)))
            preview = UniversalView(context, delegate)
            preview.setWillNotDraw(False)
            preview.setImportantForAccessibility(View.IMPORTANT_FOR_ACCESSIBILITY_NO)
            self.held.append(delegate)
            self.previews.append(preview)
            root.addView(preview, LayoutHelper.createLinear(-1, 150, 0, 8, 0, 0, 0))
            return root

        def bind_view(view, item, divider, adapter, list_view):
            preview = view.getChildAt(1)
            if preview is not None:
                if preview not in self.previews:
                    self.previews.append(preview)
                preview.invalidate()

        return SimpleSettingFactory(create_view, bind_view, is_clickable=False, is_shadow=False)

    def pick_color(self, key, default, reload=False, on_pick=None):
        try:
            fragment = get_last_fragment()
            activity = fragment.getParentActivity() if fragment is not None else None
            if activity is None:
                return BulletinHelper.show_error("Не удалось открыть палитру")

            def accept(color):
                self.set_setting(key, to_hex(color), reload_settings=reload)
                if on_pick is not None:
                    on_pick(color)
                self.refresh_previews()

            pipette, sink = NoPipette(), ColorSink(accept)
            self.refs[key] = (pipette, sink)
            sheet = ColorPickerBottomSheet(activity, fragment.getResourceProvider())
            sheet.setPipetteDelegate(pipette)
            sheet.setColor(jcolor(self.prefs.color(key, default)))
            sheet.setColorListener(sink)
            run_on_ui_thread(sheet.show)
        except Exception as e:
            warn("color picker", e)
            BulletinHelper.show_error("Не удалось открыть палитру")

    def logo_path(self):
        path = str(self.get_setting("watermark_logo_path", "") or "").strip()
        return path if path and os.path.exists(path) else ""

    def logo_image(self):
        path = self.logo_path()
        if not path:
            return None
        stamp = (path, safe(lambda: os.path.getmtime(path), 0))
        cached = self.logo_cache
        if cached is None or cached[0] != stamp:
            self.logo_cache = cached = (stamp, safe(lambda: BitmapFactory.decodeFile(path)))
        return cached[1]

    def pick_logo(self, *_):
        try:
            fragment = get_last_fragment()
            if fragment is None:
                return BulletinHelper.show_error("Не удалось открыть выбор файла")
            intent = Intent(Intent.ACTION_OPEN_DOCUMENT)
            intent.addCategory(Intent.CATEGORY_OPENABLE)
            intent.setType("image/*")
            intent.addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)
            if self.logo_hook is None:
                self.logo_hook = self.hook_private(LaunchActivity, "onActivityResult", (Integer.TYPE, Integer.TYPE, Intent),
                                             Hook(after=self.on_logo_result))
            run_on_ui_thread(lambda: fragment.startActivityForResult(intent, LOGO_REQUEST))
        except Exception as e:
            warn("logo picker", e)
            BulletinHelper.show_error("Не удалось открыть выбор файла")

    def on_logo_result(self, param):
        try:
            request, result, data = param.args
            if int(request) != LOGO_REQUEST or int(result) != Activity.RESULT_OK or data is None:
                return
            uri = data.getData()
            if uri is not None:
                background(lambda: self.import_logo(uri), "Не удалось добавить логотип")
        except Exception as e:
            warn("logo result", e)

    def import_logo(self, uri):
        stream = ApplicationLoader.applicationContext.getContentResolver().openInputStream(uri)
        if stream is None:
            raise Exception("нет доступа к файлу")
        sink, buffer = ByteArrayOutputStream(), jarray(jbyte)(64 * 1024)
        try:
            while (count := stream.read(buffer)) > 0:
                sink.write(buffer, 0, count)
                if sink.size() > LOGO_LIMIT:
                    raise Exception("файл больше 8 МБ")
        finally:
            stream.close()
        if sink.size() == 0:
            raise Exception("пустой файл")
        path = self.write_tmp("watermark_logo.png", sink.toByteArray())
        probe = BitmapFactory.decodeFile(path)
        if probe is None:
            os.remove(path)
            raise Exception("не изображение")
        probe.recycle()
        self.logo_cache = None
        run_on_ui_thread(lambda: (self.set_setting("watermark_logo_path", path, reload_settings=True),
                                  toast("Логотип добавлен", "tab_colors")))

    def clear_logo(self, *_):
        path = self.logo_path()
        if path:
            with suppress(OSError):
                os.remove(path)
        self.logo_cache = None
        self.set_setting("watermark_logo_path", "", reload_settings=True)
        toast("Логотип убран", "tab_colors")


def tmp_dir():
    context = ApplicationLoader.applicationContext
    base = context.getExternalCacheDir() or context.getCacheDir()
    path = os.path.join(base.getAbsolutePath(), __id__)
    os.makedirs(path, exist_ok=True)
    return path


def file_uri(path):
    context = ApplicationLoader.applicationContext
    return FileProvider.getUriForFile(context, f"{context.getPackageName()}.provider", File(path))
