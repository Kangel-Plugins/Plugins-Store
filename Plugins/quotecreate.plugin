        return settings

    def _reload_on_change(self, key, default):
        return lambda *_: self.set_setting(key, self.get_setting(key, default), reload_settings=True)

    def _custom(self, factory):
        self._settings_refs.append(factory)
        return Custom(factory=factory.instance.java)

    def _setting_int(self, key, default, low, high):
        try:
            value = int(float(str(self.get_setting(key, str(default))).strip()))
        except Exception:
            value = default
        return max(low, min(high, value))

    def _setting_color_text(self, key, default):
        value = str(self.get_setting(key, default) or "").strip() or default
        if not value.startswith("#"):
            value = "#" + value
        if len(value) == 7:
            value = "#FF" + value[1:]
        try:
            Color.parseColor(value)
            return value.upper()
        except Exception:
            return default

    def _setting_color_int(self, key, default):
        return Color.parseColor(self._setting_color_text(key, default))

    def _format(self):
        if int(self.get_setting("output_format", 0) or 0) == 1:
            return OutputFormat("JPEG", "jpg", "image/jpeg")
        return OutputFormat("PNG", "png", "image/png")

    def _format_hint(self):
        if self._format().name == "JPEG":
            return f"JPEG {self._setting_int('jpeg_quality', 92, 40, 100)}%"
        return "PNG без сжатия"

    def _render_scale_factor(self):
        return {1: 1.5, 2: 2.0}.get(int(self.get_setting("render_scale", 0) or 0), 1.0)

    def _slider_setting(self, key, title, default, low, high, suffix):
        def current():
            return self._setting_int(key, default, low, high)

        def text(value):
            return f"{value}{suffix}" if suffix in ("%", "°") else f"{value} {suffix}"

        def create_view(context, list_view, account, class_guid, provider):
            root = LinearLayout(context)
            root.setOrientation(LinearLayout.VERTICAL)
            root.setPadding(dp(21), dp(10), dp(21), dp(12))
            row = LinearLayout(context)
            row.setOrientation(LinearLayout.HORIZONTAL)
            row.setGravity(Gravity.CENTER_VERTICAL)
            row.addView(text_view(context, title, 16, theme_color(Theme.key_windowBackgroundWhiteBlackText, provider)),
                        LinearLayout.LayoutParams(0, -2, 1.0))
            value_view = text_view(context, text(current()), 14,
                                   theme_color(Theme.key_windowBackgroundWhiteBlueText, provider), bold=True)
            row.addView(value_view, LayoutHelper.createLinear(-2, -2))
            root.addView(row, LayoutHelper.createLinear(-1, -2))
            seek = SeekBarView(context, provider)
            seek.setReportChanges(True)
            root.addView(seek, LayoutHelper.createLinear(-1, 38, 0, 2, 0, 0, 0))

            def on_drag(progress):
                value = max(low, min(high, int(round(low + (high - low) * progress))))
                value_view.setText(text(value))
                self.set_setting(key, str(value))
                self._invalidate_wm_previews()

            delegate = _SliderDelegate(on_drag, lambda: f"{title}: {text(current())}", high - low)
            self._settings_refs.append(delegate)
            seek.setDelegate(delegate)
            return root

        def bind_view(view, item, divider, adapter, list_view):
            value = current()
            quietly(lambda: (view.getChildAt(0).getChildAt(1).setText(text(value)),
                             view.getChildAt(1).setProgress(float(value - low) / (high - low))))

        return self._custom(SimpleSettingFactory(create_view, bind_view, is_clickable=False, is_shadow=False))

    def _color_factory(self):
        provider_ref = [None]

        def paint_circle(view, color, selected):
            circle = GradientDrawable()
            circle.setShape(GradientDrawable.OVAL)
            circle.setColor(jcolor(color))
            stroke = theme_color(Theme.key_windowBackgroundWhiteBlueText if selected else Theme.key_divider, provider_ref[0])
            circle.setStroke(dp(2 if selected else 1), jcolor(stroke))
            view.setBackground(circle)

        def refresh(root):
            current = self._setting_color_text("watermark_color", "#FFFFFFFF")
            root.getChildAt(0).getChildAt(1).setText(current)
            swatches = root.getChildAt(1)
            for index, color in enumerate(WATERMARK_SWATCHES):
                paint_circle(swatches.getChildAt(index), color, hex_color(color) == current)
            custom = current not in {hex_color(color) for color in WATERMARK_SWATCHES}
            picker = swatches.getChildAt(len(WATERMARK_SWATCHES))
            paint_circle(picker, self._setting_color_int("watermark_color", current) if custom else 0, custom)
            icon = picker.getChildAt(0)
            icon.setVisibility(View.GONE if custom else View.VISIBLE)
            icon.setColorFilter(jcolor(theme_color(Theme.key_windowBackgroundWhiteGrayText2, provider_ref[0])))
            self._invalidate_wm_previews()

        def create_view(context, list_view, account, class_guid, provider):
            provider_ref[0] = provider
            root = LinearLayout(context)
            root.setOrientation(LinearLayout.VERTICAL)
            root.setPadding(dp(21), dp(10), dp(21), dp(12))
            row = LinearLayout(context)
            row.setOrientation(LinearLayout.HORIZONTAL)
            row.setGravity(Gravity.CENTER_VERTICAL)
            row.addView(text_view(context, "Цвет текста", 16, theme_color(Theme.key_windowBackgroundWhiteBlackText, provider)),
                        LinearLayout.LayoutParams(0, -2, 1.0))
            row.addView(text_view(context, self._setting_color_text("watermark_color", "#FFFFFFFF"), 13,
                                  theme_color(Theme.key_windowBackgroundWhiteGrayText2, provider)),
                        LayoutHelper.createLinear(-2, -2))
            root.addView(row, LayoutHelper.createLinear(-1, -2))
            swatches = LinearLayout(context)
            swatches.setOrientation(LinearLayout.HORIZONTAL)
            swatches.setGravity(Gravity.CENTER_VERTICAL)

            def add_circle(on_click):
                circle = FrameLayout(context)
                circle.setClickable(True)
                circle.setFocusable(True)
                circle.setOnClickListener(OnClickListener(on_click))
                params = LinearLayout.LayoutParams(dp(32), dp(32))
                params.rightMargin = dp(10)
                swatches.addView(circle, params)
                return circle

            def select(color):
                self.set_setting("watermark_color", hex_color(color))
                refresh(root)

            for color in WATERMARK_SWATCHES:
                add_circle(lambda v, color=color: select(color))
            picker = add_circle(lambda v: self._pick_color(
                "watermark_color", "#FFFFFFFF", "Цвет водяного знака выбран", on_selected=lambda color: refresh(root)))
            icon = ImageView(context)
            icon.setScaleType(ImageView.ScaleType.CENTER_INSIDE)
            icon.setImageResource(drawable("msg_palette", "msg_customize"))
            picker.addView(icon, LayoutHelper.createFrame(18, 18, Gravity.CENTER))
            root.addView(swatches, LayoutHelper.createLinear(-1, -2, 0, 9, 0, 0, 0))
            return root

        def bind_view(view, item, divider, adapter, list_view):
            quietly(lambda: refresh(view))

        return SimpleSettingFactory(create_view, bind_view, is_clickable=False, is_shadow=False)

    def _pick_bg_color(self, *_):
        self._pick_color("bg_color", "#FF000000", "Цвет фона выбран")

    def _pick_color(self, key, default, done_text, on_selected=None):
        try:
            fragment = get_last_fragment()
            if fragment is None:
                return BulletinHelper.show_error("Не удалось открыть палитру: нет активного экрана")
            activity = fragment.getParentActivity()
            if activity is None:
                return BulletinHelper.show_error("Не удалось открыть палитру: нет Activity")

            def accept(color):
                self.set_setting(key, hex_color(color), reload_settings=key == "bg_color")
                if on_selected is not None:
                    on_selected(color)
                self._invalidate_wm_previews()
                show_done(done_text, "tab_colors")

            pipette, consumer = _NoPipette(), _ColorConsumer(accept)
            self._refs[key] = (pipette, consumer)
            sheet = ColorPickerBottomSheet(activity, fragment.getResourceProvider())
            sheet.setPipetteDelegate(pipette)
            sheet.setColor(jcolor(self._setting_color_int(key, default)))
            sheet.setColorListener(consumer)
            run_on_ui_thread(sheet.show)
        except Exception as e:
            qlog(f"Color picker open failed: {e}")
            BulletinHelper.show_error("Не удалось открыть палитру")

    def _logo_path(self):
        path = str(self.get_setting("watermark_logo_path", "") or "").strip()
        return path if path and os.path.exists(path) else ""

    def _pick_logo(self, *_):
        try:
            fragment = get_last_fragment()
            if fragment is None:
                return BulletinHelper.show_error("Не удалось открыть выбор файла")
            intent = Intent(Intent.ACTION_OPEN_DOCUMENT)
            intent.addCategory(Intent.CATEGORY_OPENABLE)
            intent.setType("image/*")
            intent.addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)
            if self._logo_hook is None:
                method = LaunchActivity.getClass().getDeclaredMethod("onActivityResult", Integer.TYPE, Integer.TYPE, Intent)
                method.setAccessible(True)
                self._logo_hook = self.hook_method(method, after_hook(self._on_logo_result))
            run_on_ui_thread(lambda: fragment.startActivityForResult(intent, LOGO_REQUEST_CODE))
        except Exception as e:
            qlog(f"Logo picker failed: {e}")
            BulletinHelper.show_error("Не удалось открыть выбор файла")

    def _on_logo_result(self, param):
        try:
            request, result, data = param.args
            if int(request) != LOGO_REQUEST_CODE or int(result) != Activity.RESULT_OK or data is None:
                return
            uri = data.getData()
            if uri is not None:
                run_on_queue(lambda: self._import_logo(uri), PLUGINS_QUEUE)
        except Exception as e:
            qlog(f"Logo result error: {e}")

    def _import_logo(self, uri):
        try:
            stream = ApplicationLoader.applicationContext.getContentResolver().openInputStream(uri)
            if stream is None:
                raise Exception("нет доступа к файлу")
            sink, buffer = ByteArrayOutputStream(), jarray(jbyte)(64 * 1024)
            try:
                while (count := stream.read(buffer)) > 0:
                    sink.write(buffer, 0, count)
                    if sink.size() > 8 * 1024 * 1024:
                        raise Exception("файл больше 8 МБ")
            finally:
                stream.close()
            if sink.size() == 0:
                raise Exception("пустой файл")
            path = self._write_tmp("watermark_logo.png", sink.toByteArray())
            probe = BitmapFactory.decodeFile(path)
            if probe is None:
                os.remove(path)
                raise Exception("не изображение")
            probe.recycle()
            run_on_ui_thread(lambda: (self.set_setting("watermark_logo_path", path, reload_settings=True),
                                      show_done("Логотип добавлен", "tab_colors")))
        except Exception as e:
            error = str(e)
            run_on_ui_thread(lambda: BulletinHelper.show_error(f"Не удалось добавить логотип: {error[:60]}"))

    def _clear_logo(self, *_):
        path = self._logo_path()
        if path:
            with suppress(OSError):
                os.remove(path)
        self.set_setting("watermark_logo_path", "", reload_settings=True)
        self._invalidate_wm_previews()
        show_done("Логотип убран", "tab_colors")

    def _invalidate_wm_previews(self):
        for view in self._wm_previews:
            quietly(view.invalidate)

    def _watermark_text(self, chat=None, count=None):
        text = str(self.get_setting("watermark_text", "@username") or "").strip() or "@username"
        if "{" not in text:
            return text
        title = ""
        if chat is not None:
            current_chat, current_user = chat.getCurrentChat(), chat.getCurrentUser()
            if current_chat is not None:
                title = str(current_chat.title or "")
            elif current_user is not None:
                title = str(UserObject.getUserName(current_user) or "")
        return (text.replace("{date}", time.strftime("%d.%m.%Y"))
                .replace("{chat}", title)
                .replace("{count}", "" if count is None else str(count)))

    def _anchor(self, width, height, box_w, box_h, pad):
        right, bottom = width - pad - box_w, height - pad - box_h
        left, top = {
            1: (pad, bottom),
            2: (right, pad),
            3: (pad, pad),
            4: (int((width - box_w) / 2), int((height - box_h) / 2)),
        }.get(self._setting_int("watermark_position", 0, 0, 4), (right, bottom))
        return max(0, min(max(0, width - box_w), left)), max(0, min(max(0, height - box_h), top))

    def _watermark_layout(self, paint, text, width, height, scale=1.0):
        size_dp = max(1, int(round(self._setting_int("watermark_size", 13, 8, 48) * scale)))
        pad = int(round(dp(self._setting_int("watermark_padding", 12, 0, 64)) * scale))
        text_color = scale_alpha(self._setting_color_int("watermark_color", "#FFFFFFFF"),
                                 self._setting_int("watermark_opacity", 72, 5, 100))
        paint.setTextSize(float(dp(size_dp)))
        paint.setColor(jcolor(text_color))

        def measure(value):
            return int(paint.measureText(value) + 0.999)

        max_width = max(1, width - pad * 2 - int(dp(16) * scale))
        while size_dp > 8 and measure(text) > max_width:
            size_dp -= 1
            paint.setTextSize(float(dp(size_dp)))
        if measure(text) > max_width:
            while text and measure(text.rstrip() + "...") > max_width:
                text = text[:-1]
            text = text.rstrip() + "..." if text else "..."
        metrics = paint.getFontMetrics()
        inner_x, inner_y = int(dp(8) * scale), int(dp(5) * scale)
        box_w = max(1, measure(text) + inner_x * 2)
        box_h = max(1, int(metrics.descent - metrics.ascent + 0.999) + inner_y * 2)
        left, top = self._anchor(width, height, box_w, box_h, pad)
        return SimpleNamespace(
            text=text, left=left, top=top, box_w=box_w, box_h=box_h, inner_x=inner_x, inner_y=inner_y,
            ascent=float(metrics.ascent), text_color=text_color,
            radius=int(round(dp(self._setting_int("watermark_bg_radius", 12, 0, 32)) * scale)),
            bg_opacity=self._setting_int("watermark_bg_opacity", 36, 0, 100),
            angle=self._setting_int("watermark_angle", 0, -45, 45),
        )

    @staticmethod
    def _plate_rect(layout):
        return RectF(float(layout.left), float(layout.top),
                     float(layout.left + layout.box_w), float(layout.top + layout.box_h))

    @staticmethod
    def _plate_color(layout, min_opacity=0):
        return scale_alpha(0xFF000000 if is_light(layout.text_color) else 0xFFFFFFFF, max(layout.bg_opacity, min_opacity))

    @staticmethod
    def _draw_label(canvas, paint, layout):
        canvas.save()
        try:
            if layout.angle:
                canvas.rotate(float(layout.angle), layout.left + layout.box_w / 2.0, layout.top + layout.box_h / 2.0)
            canvas.drawText(layout.text, float(layout.left + layout.inner_x), float(layout.top + layout.inner_y) - layout.ascent, paint)
        finally:
            canvas.restore()

    @staticmethod
    def _draw_tiles(canvas, paint, layout, width, height):
        step_x = max(int(layout.box_w * 1.6), dp(60))
        step_y = max(int(layout.box_h * 3.0), dp(52))
        span = int((width + height) * 0.75)
        canvas.save()
        try:
            canvas.rotate(float(layout.angle or -30), width / 2.0, height / 2.0)
            for row, y in enumerate(range(-span, height + span, step_y)):
                for x in range(-span + (step_x // 2 if row % 2 else 0), width + span, step_x):
                    canvas.drawText(layout.text, float(x), float(y), paint)
        finally:
            canvas.restore()

    @staticmethod
    def _draw_blur(canvas, bitmap, rect, radius):
        region = None
        try:
            left, top = max(0, int(rect.left)), max(0, int(rect.top))
            right = min(bitmap.getWidth(), int(rect.right + 0.999))
            bottom = min(bitmap.getHeight(), int(rect.bottom + 0.999))
            width, height = max(1, right - left), max(1, bottom - top)
            region = Bitmap.createBitmap(bitmap, left, top, width, height)
            Utilities.stackBlurBitmap(region, max(6, min(18, int(max(width, height) / 18))))
            path = Path()
            path.addRoundRect(rect, float(radius), float(radius), Path.Direction.CW)
            paint = Paint(Paint.ANTI_ALIAS_FLAG)
            paint.setFilterBitmap(True)
            canvas.save()
            try:
                canvas.clipPath(path)
                canvas.drawBitmap(region, float(left), float(top), paint)
            finally:
                canvas.restore()
        except Exception as e:
            qlog(f"Watermark blur failed: {e}")
        finally:
            if region is not None:
                region.recycle()

    def _draw_logo(self, canvas, width, height, scale=1.0):
        path = self._logo_path()
        logo = BitmapFactory.decodeFile(path) if path else None
        if logo is None:
            return
        try:
            size = int(round(dp(self._setting_int("watermark_logo_size", 28, 12, 96)) * scale))
            logo_w, logo_h = logo.getWidth(), logo.getHeight()
            dst_h = max(1, int(round(size * logo_h / logo_w)))
            pad = int(round(dp(self._setting_int("watermark_padding", 12, 0, 64)) * scale))
            left, top = self._anchor(width, height, size, dst_h, pad)
            paint = Paint(Paint.ANTI_ALIAS_FLAG)
            paint.setFilterBitmap(True)
            paint.setAlpha(int(255 * self._setting_int("watermark_logo_opacity", 80, 5, 100) / 100))
            canvas.drawBitmap(logo, Rect(0, 0, logo_w, logo_h), Rect(left, top, left + size, top + dst_h), paint)
        except Exception as e:
            qlog(f"Watermark logo draw failed: {e}")
        finally:
            logo.recycle()

    def _draw_watermark(self, canvas, bitmap, chat=None, count=None, scale=1.0):
        if not self.get_setting("watermark_enabled", False):
            return
        try:
            width, height = bitmap.getWidth(), bitmap.getHeight()
            text = self._watermark_text(chat, count)
            if text:
                paint = Paint(Paint.ANTI_ALIAS_FLAG)
                paint.setDither(True)
                paint.setFakeBoldText(True)
                layout = self._watermark_layout(paint, text, width, height, scale)
                shadow_alpha = max(32, min(145, int(self._setting_int("watermark_opacity", 72, 5, 100) * 1.35)))
                shadow = (shadow_alpha << 24) | (0x000000 if is_light(layout.text_color) else 0xFFFFFF)
                paint.setShadowLayer(float(dp(1)), 0.0, float(dp(1)), jcolor(shadow))
                if self.get_setting("watermark_tile", False):
                    self._draw_tiles(canvas, paint, layout, width, height)
                else:
                    rect = self._plate_rect(layout)
                    if self.get_setting("watermark_blur_bg", True):
                        self._draw_blur(canvas, bitmap, rect, layout.radius)
                    if layout.bg_opacity > 0:
                        plate = Paint(Paint.ANTI_ALIAS_FLAG)
                        plate.setColor(jcolor(self._plate_color(layout)))
                        canvas.drawRoundRect(rect, float(layout.radius), float(layout.radius), plate)
                    self._draw_label(canvas, paint, layout)
            self._draw_logo(canvas, width, height, scale)
        except Exception as e:
            qlog(f"Watermark draw failed: {e}")

    def _watermark_preview_factory(self):
        def create_view(context, list_view, account, class_guid, provider):
            root = LinearLayout(context)
            root.setOrientation(LinearLayout.VERTICAL)
            root.setGravity(Gravity.CENTER_VERTICAL)
            root.setPadding(dp(21), dp(10), dp(21), dp(12))
            root.addView(text_view(context, "Предпросмотр", 16, theme_color(Theme.key_windowBackgroundWhiteBlackText, provider),
                                   bold=True), LayoutHelper.createLinear(-1, -2))
            if UniversalView is None or UniversalViewDelegate is None:
                root.addView(text_view(context, "Предпросмотр недоступен", 13,
                                       theme_color(Theme.key_windowBackgroundWhiteGrayText2, provider)),
                             LayoutHelper.createLinear(-1, -2, 0, 8, 0, 0, 0))
                return root
            delegate = _DrawDelegate(lambda canvas: self._draw_watermark_preview(canvas, provider))
            preview = UniversalView(context, delegate)
            preview.setWillNotDraw(False)
            preview.setImportantForAccessibility(View.IMPORTANT_FOR_ACCESSIBILITY_NO)
            self._settings_refs.append(delegate)
            self._wm_previews.append(preview)
            root.addView(preview, LayoutHelper.createLinear(-1, 150, 0, 8, 0, 0, 0))
            return root

        def bind_view(view, item, divider, adapter, list_view):
            preview = view.getChildAt(1)
            if preview is not None:
                if preview not in self._wm_previews:
                    self._wm_previews.append(preview)
                preview.invalidate()

        return SimpleSettingFactory(create_view, bind_view, is_clickable=False, is_shadow=False)

    def _draw_watermark_preview(self, canvas, provider):
        try:
            width, height = canvas.getWidth(), canvas.getHeight()
            if width <= 0 or height <= 0:
                return

            def color(key):
                return jcolor(theme_color(key, provider))

            def round_rect(paint, left, top, right, bottom, radius):
                canvas.drawRoundRect(RectF(float(left), float(top), float(right), float(bottom)),
                                     float(dp(radius)), float(dp(radius)), paint)

            pad = dp(8)
            paint = Paint(Paint.ANTI_ALIAS_FLAG)
            paint.setColor(color(Theme.key_windowBackgroundWhite))
            round_rect(paint, pad, 0, width - pad, height, 14)
            chat_rect = RectF(float(pad + dp(8)), float(dp(8)), float(width - pad - dp(8)), float(height - dp(8)))
            paint.setColor(color(Theme.key_chat_wallpaper))
            canvas.drawRoundRect(chat_rect, float(dp(12)), float(dp(12)), paint)

            left, top = pad + dp(22), dp(24)
            paint.setColor(color(Theme.key_chat_inBubble))
            round_rect(paint, left, top, left + min(dp(188), width - dp(92)), top + dp(44), 13)
            text_paint = Paint(Paint.ANTI_ALIAS_FLAG)
            text_paint.setTextSize(float(dp(13)))
            text_paint.setColor(color(Theme.key_chat_messageTextIn))
            canvas.drawText("Пример сообщения", float(left + dp(12)), float(top + dp(27)), text_paint)
            out_w = min(dp(178), width - dp(100))
            out_left, out_top = width - pad - dp(22) - out_w, top + dp(56)
            paint.setColor(color(Theme.key_chat_outBubble))
            round_rect(paint, out_left, out_top, out_left + out_w, out_top + dp(46), 13)
            canvas.drawText("Так будет в цитате", float(out_left + dp(12)), float(out_top + dp(28)), text_paint)

            if not self.get_setting("watermark_enabled", False):
                text_paint.setTextSize(float(dp(12)))
                text_paint.setColor(jcolor(scale_alpha(theme_color(Theme.key_windowBackgroundWhiteGrayText2, provider), 75)))
                canvas.drawText("Водяной знак выключен", float(left), float(height - dp(16)), text_paint)
                return

            content_w, content_h = int(chat_rect.width()), int(chat_rect.height())
            wm_paint = Paint(Paint.ANTI_ALIAS_FLAG)
            wm_paint.setFakeBoldText(True)
            layout = self._watermark_layout(wm_paint, self._watermark_text(count=3), content_w, content_h)
            canvas.save()
            try:
                canvas.clipRect(chat_rect)
                canvas.translate(float(int(chat_rect.left)), float(int(chat_rect.top)))
                if self.get_setting("watermark_tile", False):
                    self._draw_tiles(canvas, wm_paint, layout, content_w, content_h)
                else:
                    blur = bool(self.get_setting("watermark_blur_bg", True))
                    if blur or layout.bg_opacity > 0:
                        paint.setColor(jcolor(self._plate_color(layout, 18 if blur else 0)))
                        canvas.drawRoundRect(self._plate_rect(layout), float(layout.radius), float(layout.radius), paint)
                    self._draw_label(canvas, wm_paint, layout)
                self._draw_logo(canvas, content_w, content_h)
            finally:
                canvas.restore()
        except Exception as e:
            qlog(f"Watermark settings preview draw failed: {e}")
