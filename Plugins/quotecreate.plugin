class Slider(dynamic_proxy(SeekBarView.SeekBarViewDelegate)):
    def __init__(self, on_drag, on_release, describe, steps):
        super().__init__()
        self.on_drag, self.on_release, self.describe, self.steps = on_drag, on_release, describe, steps

    def onSeekBarDrag(self, stop, progress):
        try:
            self.on_drag(bool(stop), float(progress))
        except Exception as e:
            warn("slider", e)

    def onSeekBarPressed(self, pressed):
        if not pressed:
            safe(self.on_release)

    def getContentDescription(self):
        return self.describe()

    def getStepsCount(self):
        return self.steps

    def needVisuallyDivideSteps(self):
        return False


if UniversalViewDelegate is not None:
    class Drawer(dynamic_proxy(UniversalViewDelegate)):
        def __init__(self, on_draw, on_touch):
            super().__init__()
            self.on_draw = on_draw
            self.on_touch = on_touch

        def onDraw(self, canvas, original):
            safe(lambda: original.run(canvas))
            self.on_draw(canvas)

        def onMeasure(self, width_spec, height_spec, original):
            safe(lambda: original.run(Integer(width_spec), Integer(height_spec)))

        def onAttachedToWindow(self):
            pass

        def onDetachedFromWindow(self):
            pass

        def onTouchEvent(self, event, original):
            if safe(lambda: self.on_touch(event), False):
                return True
            return bool(safe(lambda: original.run(event), False))

        def onInitializeAccessibilityNodeInfo(self, info, original):
            safe(lambda: original.run(info))


if ScreenCaptureCallback is not None:
    class ScreenCallback(dynamic_proxy(ScreenCaptureCallback)):
        def __init__(self, fn):
            super().__init__()
            self.fn = fn

        def onScreenCaptured(self):
            safe(self.fn)


def delegate_defaults():
    methods = ChatMessageCell.ChatMessageCellDelegate.getClass().getMethods()
    return {method.getName(): ZERO.get(method.getReturnType().getName()) for method in methods}


def constant(value):
    return lambda self, *args: value


class Delegate(dynamic_proxy(ChatMessageCell.ChatMessageCellDelegate)):
    locals().update({name: constant(value) for name, value in safe(delegate_defaults, {}).items()})

    def __init__(self, chat, anon_nick=False):
        super().__init__()
        self.controller = chat.getMessagesController()
        self.chat = chat.getCurrentChat()
        self.user = chat.getCurrentUser()
        self.topic = get_private_field(chat, "forumTopic")
        self.anon_nick = anon_nick

    def group(self):
        chat = self.chat
        return chat.id if chat is not None and not ChatObject.isChannelAndNotMegaGroup(chat) else None

    def isAdmin(self, uid):
        group = self.group()
        return group is not None and bool(safe(lambda: self.controller.isAdmin(group, uid), False))

    def isOwner(self, uid):
        group = self.group()
        return group is not None and bool(safe(lambda: self.controller.isOwner(group, uid), False))

    def getAdminRank(self, uid):
        if self.anon_nick or safe(lambda: UserObject.isBotForum(self.user), False):
            return None
        group = self.group()
        rank = safe(lambda: self.controller.getAdminRank(group, uid)) if group is not None else None
        author = getattr(self.topic, "from_id", None)
        if rank is None and author is not None and uid in (author.user_id, author.channel_id, author.chat_id):
            rank = safe(lambda: LocaleController.getString(R.string.TopicCreator))
        return rank

    def isLandscape(self):
        return AndroidUtilities.displaySize.x > AndroidUtilities.displaySize.y

    def canDrawOutboundsContent(self):
        return True

    def shouldRepeatSticker(self, msg):
        return True

    def doNotShowLoadingReply(self, msg):
        return msg is not None and msg.getDialogId() == UserObject.REPLY_BOT


def attempt(what, fn):
    try:
        fn()
    except Exception as e:
        warn(what, e)


def draw_shifted(canvas, dy, fn):
    canvas.save()
    try:
        canvas.translate(0.0, float(dy))
        fn()
    finally:
        canvas.restore()


def field(cell, name):
    value = getattr(cell, name, MISSING)
    return get_private_field(cell, name) if value is MISSING else value


def fnum(cell, name):
    return float(field(cell, name) or 0)


def drawable_bounds(drawable, pad=0):
    if drawable is None:
        return None
    rect = drawable.getBounds()
    return box(rect.left - pad, rect.top - pad, rect.right + pad, rect.bottom + pad)


def receiver_bounds(receiver):
    try:
        left, top = int(receiver.getImageX()), int(receiver.getImageY())
        right, bottom = int(receiver.getImageX2()), int(receiver.getImageY2())
        if right <= left:
            right = int(left + receiver.getImageWidth())
        if bottom <= top:
            bottom = int(top + receiver.getImageHeight())
        return box(left, top, right, bottom)
    except Exception:
        return None


def round_radius(receiver, bounds=None):
    radius = safe(lambda: max(int(value or 0) for value in receiver.getRoundRadius()), 0) or 0
    if bounds:
        limit = max(1, min(bounds[2] - bounds[0], bounds[3] - bounds[1]) // 2)
        radius = limit if radius <= 0 else min(radius, limit)
    return radius if radius > 0 else None


def line_width(layout):
    return int(max(1, layout.getLineWidth(0))) if layout.getLineCount() > 0 else 0


def name_bounds(cell):
    layout = field(cell, "nameLayout")
    if not field(cell, "drawNameLayout") or not layout:
        return None
    bounds = drawable_bounds(field(cell, "nameLayoutSelector"), dp(1))
    if bounds:
        return bounds
    has_av = bool(field(cell, "drawNameAvatar"))
    x = fnum(cell, "nameX") + (dp(32.33) if has_av else 0) + fnum(cell, "nameOffsetX")
    y = fnum(cell, "nameY") + ((dp(-2.33) if field(cell, "adminLayout") is not None else dp(5)) if has_av else 0)
    width = line_width(layout) or int(field(cell, "nameLayoutWidth") or 0)
    if width <= 0:
        return None
    left, top = int(x - dp(2)), int(y - dp(1))
    return box(left, top, left + width + dp(4), top + max(1, layout.getHeight()) + dp(2))


def status_bounds(cell):
    if field(cell, "currentNameStatus") is None:
        return None
    return drawable_bounds(field(cell, "nameStatusSelector"), dp(1))


def admin_bounds(cell):
    if field(cell, "adminLayout") is None:
        return None
    rect = field(cell, "adminLayoutRect")
    if rect is None:
        return None
    return box(rect.left, rect.top, rect.right, rect.bottom)


def name_avatar_bounds(cell):
    if not field(cell, "drawNameAvatar"):
        return None
    x, y = fnum(cell, "nameX"), fnum(cell, "nameY")
    if field(cell, "currentNameBotVerificationId"):
        x -= dp(20)
    return box(x, y, x + dp(26), y + dp(26))


def forum_avatar_bounds(cell, msg):
    if msg is None or msg.isOutOwner() or not field(cell, "isSideMenuEnabled"):
        return None
    if not (field(cell, "isForum") or field(cell, "isMonoForum")):
        return None
    if msg.type not in (MessageObject.TYPE_ROUND_VIDEO, MessageObject.TYPE_STICKER, MessageObject.TYPE_ANIMATED_STICKER):
        return None
    photo = field(cell, "photoImage")
    if photo is None:
        return None
    x, y = photo.getImageX() + dp(7), photo.getImageY() + dp(7)
    return box(x, y, x + dp(26), y + dp(26))


def reply_name_bounds(cell):
    layout = field(cell, "replyNameLayout")
    if not layout:
        return None
    msg = field(cell, "currentMessageObject")
    bare = msg is not None and bool(safe(msg.shouldDrawWithoutBackground, False))
    x = fnum(cell, "replyStartX") + (-dp(6) if bare else -dp(1)) - fnum(cell, "replyNameOffset") + dp(10)
    y = fnum(cell, "replyStartY") + (dp(1) if bare else dp(3))
    if getattr(cell, "needReplyImage", False):
        image = getattr(cell, "replyImageReceiver", None)
        x += float(image.getImageWidth()) + dp(3) if image is not None else dp(28)
    width = safe(lambda: line_width(layout), 0) or safe(lambda: int(max(1, layout.getWidth())), 0)
    if width <= 0:
        return None
    left, top = int(x - dp(2)), int(y - dp(1))
    return box(left, top, int(x + width + dp(4)), top + max(1, layout.getHeight()) + dp(1))


def reply_fwd_bounds(cell):
    if not field(cell, "replyPanelIsForward"):
        return None
    layout = field(cell, "replyTextLayout")
    if not layout:
        return None
    msg = field(cell, "currentMessageObject")
    bare = msg is not None and bool(safe(msg.shouldDrawWithoutBackground, False))
    x = fnum(cell, "replyStartX") + (-dp(6) if bare else -dp(1)) + dp(10)
    y = fnum(cell, "replyStartY") + (dp(1) if bare else dp(3)) - dp(1) + Theme.chat_replyNamePaint.getTextSize() + dp(5)
    width = safe(lambda: line_width(layout), 0) or safe(lambda: int(max(1, layout.getWidth())), 0)
    if width <= 0:
        return None
    return box(x - dp(2), y - dp(1), x + width + dp(4), y + max(1, layout.getHeight()) + dp(1))


def forward_origin(cell):
    msg = field(cell, "currentMessageObject")
    if not field(cell, "drawForwardedName") and not (msg is not None and msg.type == MessageObject.TYPE_STORY):
        return None
    layouts = field(cell, "forwardedNameLayout")
    if not layouts or layouts[0] is None or len(layouts) < 2 or layouts[1] is None:
        return None
    if field(cell, "replyNameLayout") is None:
        x = fnum(cell, "forwardNameX") - (dp(7) if msg is not None and msg.type == MessageObject.TYPE_EMOJIS else 0)
    else:
        bg_left = float(cell.getBackgroundDrawableLeft())
        extra = safe(lambda: float(call_private(cell, "getExtraTextX")), 0.0) or 0.0
        outgoing = msg is not None and bool(msg.isOutOwner())
        media_or_pinned = bool(field(cell, "mediaBackground")) or bool(field(cell, "drawPinnedBottom"))
        if not field(cell, "isSideMenued") and msg is not None and (msg.type == MessageObject.TYPE_ROUND_VIDEO or msg.isAnyKindOfSticker()):
            if msg.type == MessageObject.TYPE_EMOJIS:
                x = bg_left + dp(11 if outgoing or media_or_pinned else 17) + extra - dp(7)
            else:
                x = float(dp(23)) if outgoing else float(bg_left + cell.getBackgroundDrawableRight() + dp(17))
        else:
            x = bg_left + dp(10 if outgoing or media_or_pinned else 16) + extra
    return x, fnum(cell, "forwardNameY"), fnum(cell, "forwardHeight"), layouts


def forward_bounds(cell):
    origin = forward_origin(cell)
    if origin is None:
        return None
    fx, fy, fh, layouts = origin
    offsets = field(cell, "forwardNameOffsetX")
    ox = float(offsets[1]) if offsets is not None and len(offsets) > 1 else 0.0
    x1, y1 = fx - ox, fy + fh / 2.0 + dp(1.33)
    width = safe(lambda: line_width(layouts[1]), 0) or int(fnum(cell, "forwardedNameWidth"))
    height = max(1, layouts[1].getHeight())
    if width <= 0:
        return None
    return box(x1 - dp(2), y1 - dp(1), x1 + width + dp(4), y1 + height + dp(1))


def forward_avatar_bounds(cell):
    origin = forward_origin(cell)
    if origin is None:
        return None
    if field(cell, "currentForwardUser") is None and field(cell, "currentForwardChannel") is None:
        return None
    fx, fy, fh, layouts = origin
    offsets = field(cell, "forwardNameOffsetX")
    ox = float(offsets[1]) if offsets is not None and len(offsets) > 1 else 0.0
    x1, y1 = fx - ox, fy + fh / 2.0 + dp(1.33)
    size = max(dp(12), int(round(1.23 * layouts[1].getPaint().getTextSize())))
    return box(x1 - dp(1), y1 - dp(1), x1 + size + dp(1), y1 + size + dp(1))


def via_bounds(cell):
    width = fnum(cell, "viaWidth")
    if width <= 0 or field(cell, "drawForwardedName"):
        return None
    has_av = bool(field(cell, "drawNameAvatar"))
    x = fnum(cell, "nameX") + (dp(32.33) if has_av else 0) + fnum(cell, "viaNameWidth")
    y = fnum(cell, "nameY") + ((dp(-2.33) if field(cell, "adminLayout") is not None else dp(5)) if has_av else 0)
    return box(x - dp(2), y - dp(2), x + width + dp(2), y + dp(20))


def block_offset(block, blocks, cell):
    for getter in (lambda: block.textYOffset(blocks, cell.transitionParams),
                   lambda: block.textYOffset(blocks),
                   lambda: block.textYOffset):
        value = safe(lambda: float(getter()))
        if value is not None:
            return value
    return 0.0


def msg_key(msg):
    owner = getattr(msg, "messageOwner", None)
    return (int(safe(msg.getId, 0) or 0), bool(getattr(msg, "isDateObject", False)),
            int(getattr(owner, "date", 0) or 0) if owner is not None else 0)


def merge_ranges(ranges):
    ordered = sorted((int(s), int(e)) for s, e in ranges if e > s)
    if not ordered:
        return []
    merged = [ordered[0]]
    for start, end in ordered[1:]:
        prev_s, prev_e = merged[-1]
        if start <= prev_e:
            merged[-1] = (prev_s, max(prev_e, end))
        else:
            merged.append((start, end))
    return merged


def word_bounds(text, idx):
    length = len(text)
    if length <= 0:
        return 0, 0
    idx = max(0, min(length - 1, idx))
    if text[idx].isspace():
        start = idx
        while start < length and text[start].isspace():
            start += 1
        if start < length:
            idx = start
        else:
            while idx > 0 and text[idx].isspace():
                idx -= 1
    if text[idx].isspace():
        return idx, min(length, idx + 1)
    start = end = idx
    while start > 0 and not text[start - 1].isspace():
        start -= 1
    while end < length and not text[end].isspace():
        end += 1
    return start, max(start + 1, end)


def has_capture_permission(context):
    if Build.VERSION.SDK_INT < 34 or ScreenCaptureCallback is None:
        return False
    return safe(lambda: context.checkSelfPermission("android.permission.DETECT_SCREEN_CAPTURE") == PackageManager.PERMISSION_GRANTED, False)


def has_media_permission(context):
    if Build.VERSION.SDK_INT < 23:
        return True
    if Build.VERSION.SDK_INT >= 33:
        return (safe(lambda: context.checkSelfPermission(Manifest.permission.READ_MEDIA_IMAGES) == PackageManager.PERMISSION_GRANTED, False)
                or safe(lambda: context.checkSelfPermission(Manifest.permission.READ_EXTERNAL_STORAGE) == PackageManager.PERMISSION_GRANTED, False))
    return safe(lambda: context.checkSelfPermission(Manifest.permission.READ_EXTERNAL_STORAGE) == PackageManager.PERMISSION_GRANTED, False)


def visible_messages(chat):
    list_view = safe(chat.getChatListView)
    if list_view is None:
        return []
    vis_top = float(getattr(chat, "chatListViewPaddingTop", 0) or list_view.getPaddingTop())
    vis_bottom = float(list_view.getHeight() - list_view.getPaddingBottom())
    if vis_bottom <= vis_top:
        vis_top, vis_bottom = 0.0, float(max(1, list_view.getHeight()))
    rows = []
    for index in range(list_view.getChildCount()):
        child = list_view.getChildAt(index)
        if not isinstance(child, (ChatMessageCell, ChatActionCell)):
            continue
        top = float(child.getTop()) + float(child.getTranslationY())
        bottom = float(child.getBottom()) + float(child.getTranslationY())
        height = max(1.0, bottom - top)
        overlap = min(bottom, vis_bottom) - max(top, vis_top)
        if overlap < min(float(dp(12)), height * 0.2):
            continue
        msg = safe(child.getMessageObject)
        if msg is None:
            continue
        group = safe(child.getCurrentMessagesGroup) if isinstance(child, ChatMessageCell) else None
        items = getattr(group, "messages", None) if group is not None else None
        if items is not None and items.size() > 1:
            g_msgs = [items.get(i) for i in range(items.size())]
            g_msgs.sort(key=lambda m: safe(m.getId, 0) or 0)
            for offset, g_msg in enumerate(g_msgs):
                rows.append((top, offset, g_msg))
        else:
            rows.append((top, 0, msg))
    rows.sort(key=lambda item: (item[0], item[1]))
    seen, result = set(), []
    for _, _, msg in rows:
        key = msg_key(msg)
        if key not in seen:
            seen.add(key)
            result.append(msg)
    floating = get_private_field(chat, "floatingDateView")
    if floating is not None and safe(floating.getVisibility, View.GONE) == View.VISIBLE and float(safe(floating.getAlpha, 0.0) or 0.0) > 0.5:
        f_msg = safe(floating.getMessageObject)
        if f_msg is not None:
            f_key = msg_key(f_msg)
            if f_key not in seen and not (result and getattr(result[0], "isDateObject", False)):
                result.insert(0, f_msg)
    return result


class Redactions:
    def __init__(self, spans=None, hidden_msgs=None, excluded_msgs=None):
        self.spans = {k: list(v) for k, v in (spans or {}).items()}
        self.hidden_msgs = set(hidden_msgs or ())
        self.excluded_msgs = set(excluded_msgs or ())

    def copy(self):
        return Redactions(self.spans, self.hidden_msgs, self.excluded_msgs)

    def same(self, other):
        if other is None:
            return False
        if self.hidden_msgs != other.hidden_msgs or self.excluded_msgs != other.excluded_msgs:
            return False
        keys = {k for k, v in self.spans.items() if v}
        other_keys = {k for k, v in other.spans.items() if v}
        if keys != other_keys:
            return False
        return all(sorted(self.spans[k]) == sorted(other.spans[k]) for k in keys)

    def count(self):
        return sum(len(v) for v in self.spans.values()) + len(self.hidden_msgs) + len(self.excluded_msgs)

    def empty(self):
        return self.count() == 0

    def clear(self):
        self.spans.clear()
        self.hidden_msgs.clear()
        self.excluded_msgs.clear()

    def add_span(self, key, source, start, end):
        if end <= start:
            return
        cur = self.spans.get(key, [])
        same = [(s, e) for src, s, e in cur if src == source]
        other = [(src, s, e) for src, s, e in cur if src != source]
        same.append((int(start), int(end)))
        merged = [(source, s, e) for s, e in merge_ranges(same)]
        self.spans[key] = other + merged

    def drop_span(self, key, source, start, end):
        cur = self.spans.get(key)
        if not cur:
            return
        kept = []
        for src, s, e in cur:
            if src != source or e <= start or s >= end:
                kept.append((src, s, e))
            else:
                if s < start:
                    kept.append((src, s, start))
                if e > end:
                    kept.append((src, end, e))
        if kept:
            self.spans[key] = kept
        else:
            self.spans.pop(key, None)

    def find_span(self, key, source, pos):
        for src, s, e in self.spans.get(key, ()):
            if src == source and s <= pos < e:
                return s, e
        return None

    def toggle_hidden(self, key):
        if key in self.hidden_msgs:
            self.hidden_msgs.discard(key)
            return False
        self.hidden_msgs.add(key)
        return True

    def toggle_excluded(self, key, total):
        if key in self.excluded_msgs:
            self.excluded_msgs.discard(key)
            return False
        if len(self.excluded_msgs) + 1 >= total:
            return None
        self.excluded_msgs.add(key)
        return True


def utf16(text):
    if text is None:
        return ""
    data = str(text).encode("utf-16-le", "surrogatepass")
    return "".join(chr(data[i] | (data[i + 1] << 8)) for i in range(0, len(data), 2))


def span_boxes(layout, ranges, ox, oy, pad=None):
    result = []
    if pad is None:
        pad = dp(1)
    raw = utf16(layout.getText())
    length = len(raw)
    if length <= 0:
        return result
    for start, end in ranges:
        local_start, local_end = max(0, int(start)), min(length, int(end))
        if local_end <= local_start:
            continue
        for line in range(layout.getLineForOffset(local_start), layout.getLineForOffset(local_end - 1) + 1):
            ls, le = max(0, layout.getLineStart(line)), min(length, layout.getLineEnd(line))
            te = le - 1 if le > ls and raw[le - 1] == "\n" else le
            seg_s, seg_e = max(local_start, ls), min(local_end, te)
            if seg_e <= seg_s:
                continue
            rtl = layout.getParagraphDirection(line) == Layout.DIR_RIGHT_TO_LEFT
            x1 = float(layout.getPrimaryHorizontal(seg_s))
            if seg_e >= te:
                x2 = float(layout.getLineLeft(line) if rtl else layout.getLineRight(line))
            else:
                x2 = float(layout.getPrimaryHorizontal(seg_e))
            left, right = sorted((x1, x2))
            bounds = box(int(ox + left) - pad, int(oy + layout.getLineTop(line)) - pad,
                         int(ox + right) + pad, int(oy + layout.getLineBottom(line)) + pad)
            if bounds:
                result.append(bounds)
    return result


def cell_text_blocks(cell, msg, inset):
    result = []
    pad_top = cell.getPaddingTop()
    if safe(cell.hasCaptionLayout, False):
        cl = safe(cell.getCaptionLayout)
        blocks = getattr(cl, "textLayoutBlocks", None) if cl is not None else None
        source = "caption"
        bx = fnum(cell, "captionX")
        by = fnum(cell, "captionY") + inset + pad_top
        rtl_shift = float(getattr(cl, "textXOffset", 0.0) or 0.0) if cl is not None else 0.0
    else:
        blocks = getattr(msg, "textLayoutBlocks", None)
        source = "text"
        bx = float(getattr(cell, "textX", 0) or 0)
        by = float(getattr(cell, "textY", 0) or 0) + inset + pad_top
        rtl_shift = float(getattr(msg, "textXOffset", 0.0) or 0.0)
    if blocks is None:
        return result
    for index in range(blocks.size()):
        block = blocks.get(index)
        layout = getattr(block, "textLayout", None)
        if layout is None:
            continue
        char_off = int(getattr(block, "charactersOffset", 0) or 0)
        is_quote = bool(getattr(block, "quote", False))
        is_code = bool(getattr(block, "code", False))
        block_rtl = (rtl_shift - (dp(10) if is_quote else 0)) if safe(block.isRtl, False) else 0.0
        code_x = dp(10) if is_code and not is_quote else 0.0
        ox = bx - block_rtl + code_x
        oy = by + block_offset(block, blocks, cell) + float(getattr(block, "padTop", 0) or 0)
        result.append((source, layout, char_off, ox, oy))
    return result


def extract_lines(source, layout, char_off, ox, oy):
    lines = []
    raw = utf16(layout.getText())
    length = len(raw)
    for line in range(layout.getLineCount()):
        ls, le = max(0, layout.getLineStart(line)), min(length, layout.getLineEnd(line))
        te = le - 1 if le > ls and raw[le - 1] == "\n" else le
        if te <= ls:
            continue
        rtl = layout.getParagraphDirection(line) == Layout.DIR_RIGHT_TO_LEFT
        end_x = float(layout.getLineLeft(line) if rtl else layout.getLineRight(line))
        xs = [ox + float(layout.getPrimaryHorizontal(i)) for i in range(ls, te)]
        xs.append(ox + end_x)
        lines.append(LineGeom(source, char_off + ls, char_off + te,
                              oy + float(layout.getLineTop(line)), oy + float(layout.getLineBottom(line)),
                              xs, raw[ls:te]))
    return lines


def geom_span_boxes(lines, source, start, end, pad=None):
    if pad is None:
        pad = dp(2)
    result = []
    for line in lines:
        if line.source != source:
            continue
        s, e = max(start, line.start), min(end, line.end)
        if e <= s:
            continue
        x1, x2 = line.xs[s - line.start], line.xs[e - line.start]
        left, right = sorted((x1, x2))
        bounds = box(int(left) - pad, int(line.top) - pad, int(right) + pad, int(line.bottom) + pad)
        if bounds:
            result.append(bounds)
    return result


def style_icon(idx):
    table = (
        ("msg_photo_blur", "msg_blur_radial"),
        ("msg_qrcode", "msg_blur_linear", "msg_photo_blur"),
        ("msg_spoiler", "msg_photo_blur"),
        ("msg_header_draw", "msg_edit"),
        ("msg_stories_myhide", "msg_blur_off", "msg_spoiler_off"),
    )
    return icon_res(*table[idx if 0 <= idx < len(table) else 0])


def draw_icon(canvas, ctx, res_id, cx, cy, size, color):
    if not res_id or ctx is None:
        return
    dr = safe(lambda: ctx.getDrawable(res_id))
    if dr is None:
        return
    dr = dr.mutate()
    dr.setColorFilter(PorterDuffColorFilter(color, PorterDuff.Mode.SRC_IN))
    half = int(round(size / 2.0))
    ix, iy = int(round(cx)), int(round(cy))
    dr.setBounds(ix - half, iy - half, ix + half, iy + half)
    dr.draw(canvas)


def bubble_rad():
    return dp(max(2, int(safe(lambda: SharedConfig.bubbleRadius, 14) or 14)))


def round_path(bounds, radius):
    path = Path()
    rect = RectF(float(bounds[0]), float(bounds[1]), float(bounds[2]), float(bounds[3]))
    r = float(max(0.0, min(float(radius), rect.width() / 2.0, rect.height() / 2.0)))
    path.addRoundRect(rect, r, r, Path.Direction.CW)
    return path


def shift_path(path, dx, dy):
    if path is None:
        return None
    copy = Path(path)
    if dx or dy:
        copy.offset(float(dx), float(dy))
    return copy


def scale_path(path, scale):
    if path is None:
        return None
    copy = Path(path)
    if scale != 1.0:
        matrix = Matrix()
        matrix.setScale(float(scale), float(scale))
        copy.transform(matrix)
    return copy


def receiver_path(receiver, inset):
    if receiver is None:
        return None, None
    bounds = shift(receiver_bounds(receiver), inset)
    if not bounds:
        return None, None
    rect = RectF(float(bounds[0]), float(bounds[1]), float(bounds[2]), float(bounds[3]))
    lim = min(rect.width(), rect.height()) / 2.0
    raw = safe(receiver.getRoundRadius)
    path = Path()
    if raw is not None and len(raw) >= 4:
        vals = [float(max(0.0, min(lim, float(raw[i] or 0)))) for i in range(4)]
        if any(v > 0 for v in vals):
            radii = jarray(jfloat)([vals[0], vals[0], vals[1], vals[1], vals[2], vals[2], vals[3], vals[3]])
            path.addRoundRect(rect, radii, Path.Direction.CW)
            return path, bounds
    rad = round_radius(receiver, bounds) or bubble_rad()
    return round_path(bounds, rad), bounds


def bubble_shape(cell, msg, inset, bbox, pos=None, top_near=False, bottom_near=False):
    if safe(msg.isRoundVideo, False):
        pb = shift(receiver_bounds(field(cell, "photoImage")), inset)
        if pb:
            path = Path()
            path.addCircle((pb[0] + pb[2]) / 2.0, (pb[1] + pb[3]) / 2.0,
                           max(1.0, min(pb[2] - pb[0], pb[3] - pb[1]) / 2.0), Path.Direction.CW)
            return path, pb
    raw_bg = safe(lambda: field(cell, "drawBackground"))
    has_bg = (True if raw_bg is None else bool(raw_bg)) and not safe(msg.shouldDrawWithoutBackground, False)
    if pos is None and has_bg:
        drawable = safe(lambda: cell.getCurrentBackgroundDrawable(True))
        if drawable is not None:
            bl = safe(cell.getBackgroundDrawableLeft, 0) or 0
            bt = safe(cell.getBackgroundDrawableTop, 0) or 0
            br = safe(cell.getBackgroundDrawableRight, 0) or 0
            bb = safe(cell.getBackgroundDrawableBottom, 0) or 0
            if br > bl and bb > bt:
                def build_native():
                    pt = field(cell, "drawPinnedTop")
                    pb = field(cell, "drawPinnedBottom")
                    p_top = bool(top_near if pt is None else pt)
                    p_bot = bool(bottom_near if pb is None else pb)
                    drawable.setTop(jint(0), jint(max(br, 1)), jint(max(bb + dp(64), 10000)), p_top, p_bot)
                    drawable.setBounds(jint(bl), jint(bt), jint(br), jint(bb))
                    drawable.setBotButtonsBottom(bool(safe(msg.hasInlineBotButtons, False)))
                    raw = drawable.makePath()
                    if raw is None:
                        return None
                    p = Path(raw)
                    p.offset(0.0, float(inset + cell.getPaddingTop()))
                    rf = RectF()
                    p.computeBounds(rf, True)
                    if rf.width() <= 2 or rf.height() <= 2:
                        return None
                    tight = box(int(math.floor(rf.left)), int(math.floor(rf.top)),
                                int(math.ceil(rf.right)), int(math.ceil(rf.bottom)))
                    return p, tight or bbox

                built = safe(build_native)
                if built is not None:
                    return built
    if pos is not None or not has_bg:
        if not safe(msg.isSticker, False):
            path, pb = receiver_path(field(cell, "photoImage"), inset)
            if path is not None:
                return path, pb
    if bbox:
        return round_path(bbox, bubble_rad()), bbox
    return None, bbox


def shift_geoms(geoms, dx, dy):
    if not geoms or (dx == 0 and dy == 0):
        return geoms
    result = []
    for g in geoms:
        b = (g.bubble[0] + dx, g.bubble[1] + dy, g.bubble[2] + dx, g.bubble[3] + dy) if g.bubble else None
        shape = shift_path(g.shape, dx, dy)
        lines = [LineGeom(l.source, l.start, l.end, l.top + dy, l.bottom + dy, [x + dx for x in l.xs], l.text)
                 for l in g.lines]
        result.append(MsgGeom(g.key, b, shape, g.outgoing, g.action, g.ink, lines))
    return result


def bubble_box(cell, inset, left, right, height):
    pad_top = cell.getPaddingTop()
    bg = safe(lambda: box(cell.getBackgroundDrawableLeft(), inset + pad_top + cell.getBackgroundDrawableTop(),
                          cell.getBackgroundDrawableRight(), inset + pad_top + cell.getBackgroundDrawableBottom()))
    if bg:
        return bg
    return box(left, inset, right, height + inset)


def username_bounds(cell, msg):
    result = []
    text = utf16(getattr(msg, "messageText", None))
    matches = [(m.start(), m.end()) for m in USERNAME_RE.finditer(text)]
    if not matches:
        return result
    for source, layout, offset, ox, oy in cell_text_blocks(cell, msg, 0):
        if source != "text":
            continue
        shifted = [(s - offset, e - offset) for s, e in matches]
        result.extend(span_boxes(layout, shifted, ox, oy))
    return result


def action_name_bounds(cell):
    layout = field(cell, "textLayout")
    if layout is None:
        return []
    text = layout.getText()
    if not isinstance(text, Spanned):
        return []
    spans = text.getSpans(0, text.length(), URLSpanNoUnderlineBold.getClass())
    if not spans:
        return []
    ranges = []
    for span in spans:
        url = str(safe(span.getURL, "") or "")
        if url and url.lstrip("-").isdigit():
            ranges.append((text.getSpanStart(span), text.getSpanEnd(span)))
    if not ranges:
        return []
    return span_boxes(layout, ranges, fnum(cell, "textXLeft"), fnum(cell, "textY"))


def mask_color(bmp, left, top, right, bottom):
    width, height = bmp.getWidth(), bmp.getHeight()
    cx, cy = (left + right) // 2, (top + bottom) // 2
    samples = []
    for x, y in ((left - 2, top - 2), (right + 2, top - 2), (left - 2, bottom + 2), (right + 2, bottom + 2),
                 (cx, top - 2), (cx, bottom + 2), (left - 2, cy), (right + 2, cy)):
        pixel = bmp.getPixel(max(0, min(width - 1, x)), max(0, min(height - 1, y))) & 0xFFFFFFFF
        if (pixel >> 24) >= 0x10:
            samples.append(pixel)
    if not samples:
        return Color.rgb(0x2B, 0x2B, 0x2B)
    count = len(samples)
    red = sum((c >> 16) & 0xFF for c in samples) // count
    green = sum((c >> 8) & 0xFF for c in samples) // count
    blue = sum(c & 0xFF for c in samples) // count
    return Color.rgb(red, green, blue)


class SpoilerCache:
    def __init__(self):
        self.lock = threading.Lock()
        self.tile = 0
        self.key = None
        self.bmp = None
        self.canvas = None
        self.shader = None
        self.paints = None
        self.arrays = None
        self.offsets = None
        self.max_count = 0

    def ensure(self, tile):
        if self.tile == tile and self.bmp is not None and not self.bmp.isRecycled() and self.arrays is not None:
            return
        old = self.bmp
        self.tile = tile
        self.key = None
        self.bmp = new_bitmap(tile, tile)
        self.canvas = Canvas(self.bmp)
        self.shader = None
        paints = []
        for idx in range(3):
            paint = Paint(Paint.ANTI_ALIAS_FLAG)
            paint.setStyle(Paint.Style.STROKE)
            paint.setStrokeCap(Paint.Cap.ROUND)
            paint.setColor(jint(alpha(Color.WHITE, SPOILER_ALPHAS[idx])))
            paints.append(paint)
        self.paints = tuple(paints)
        max_count = int(round(80 * 80 * 0.22 * 2.0))
        self.max_count = max_count
        rng = random.Random(0x5B011E7)
        buckets = ([], [], [])
        offsets = ([0], [0], [0])
        pad = max(2.0, float(dp(4.0)))
        for i in range(max_count):
            x = rng.random() * tile
            y = rng.random() * tile
            b = i % 3
            pts = buckets[b]
            pts.append(x)
            pts.append(y)
            if x < pad:
                pts.append(x + tile)
                pts.append(y)
            elif x > tile - pad:
                pts.append(x - tile)
                pts.append(y)
            if y < pad:
                pts.append(x)
                pts.append(y + tile)
            elif y > tile - pad:
                pts.append(x)
                pts.append(y - tile)
            offsets[b].append(len(pts))
        self.arrays = tuple(jarray(jfloat)(pts) for pts in buckets)
        self.offsets = offsets
        if old is not None:
            safe(old.recycle)

    def get(self, density, size_pct):
        tile = max(64, int(dp(80)))
        key = (tile, int(density), int(size_pct))
        if self.key == key and self.shader is not None and self.bmp is not None:
            return self.shader
        self.ensure(tile)
        self.bmp.eraseColor(jint(0))
        scale = max(0.5, min(2.5, size_pct / 100.0))
        count = max(48, min(self.max_count, int(round(80 * 80 * 0.22 * (density / 100.0)))))
        for idx in range(3):
            per = (count + 2 - idx) // 3
            offs = self.offsets[idx]
            n = offs[min(per, len(offs) - 1)]
            if n < 2:
                continue
            paint = self.paints[idx]
            paint.setStrokeWidth(max(1.0, float(dp((1.4 if idx == 0 else 1.2) * scale))))
            self.canvas.drawPoints(self.arrays[idx], jint(0), jint(n), paint)
        self.shader = BitmapShader(self.bmp, Shader.TileMode.REPEAT, Shader.TileMode.REPEAT)
        self.key = key
        return self.shader

    def clear(self):
        with self.lock:
            old = self.bmp
            self.tile = 0
            self.key = self.bmp = self.canvas = self.shader = self.paints = self.arrays = self.offsets = None
            self.max_count = 0
        if old is not None:
            safe(old.recycle)


SPOILER_CACHE = SpoilerCache()


def draw_mask(canvas, bmp, bounds, style, ink, circle=False, radius=None, bg=None, shape=None, cfg=None):
    left, top, right, bottom = bounds
    if cfg is None:
        cfg = DEFAULT_MASK
    canvas.save()
    try:
        if shape is not None:
            canvas.clipPath(shape)
        else:
            if radius is None and not circle:
                radius = dp(4)
            path = Path()
            if radius:
                path.addRoundRect(RectF(float(left), float(top), float(right), float(bottom)),
                                  float(radius), float(radius), Path.Direction.CW)
                canvas.clipPath(path)
            elif circle:
                path.addCircle((left + right) / 2.0, (top + bottom) / 2.0,
                               max(1.0, min(right - left, bottom - top) / 2.0), Path.Direction.CW)
                canvas.clipPath(path)
        if style == 0:
            cl, ct = max(0, int(left)), max(0, int(top))
            cr, cb = min(bmp.getWidth(), int(right)), min(bmp.getHeight(), int(bottom))
            if cr <= cl or cb <= ct:
                return
            w, h = cr - cl, cb - ct
            t = max(0.0, min(1.0, (cfg.blur_radius - 10) / 90.0))
            eff = max(1.0, float(dp(1.5 + 18.5 * (t ** 1.35))))
            paint = Paint(Paint.ANTI_ALIAS_FLAG)
            paint.setFilterBitmap(True)
            if eff <= 20.0:
                region = Bitmap.createBitmap(bmp, cl, ct, w, h)
                try:
                    Utilities.stackBlurBitmap(region, jint(max(1, int(round(eff)))))
                    canvas.drawBitmap(region, float(cl), float(ct), paint)
                finally:
                    region.recycle()
            else:
                down = eff / 16.0
                sw = max(2, min(w, int(round(w / down))))
                sh = max(2, min(h, int(round(h / down))))
                small = new_bitmap(sw, sh)
                try:
                    area, small_area = Rect(cl, ct, cr, cb), Rect(0, 0, sw, sh)
                    Canvas(small).drawBitmap(bmp, area, small_area, paint)
                    r = max(2, min(20, int(round(eff / max(1.0, min(w / float(sw), h / float(sh)))))))
                    Utilities.stackBlurBitmap(small, jint(r))
                    canvas.drawBitmap(small, small_area, area, paint)
                finally:
                    small.recycle()
            if cfg.blur_dim > 0:
                dim = Paint(Paint.ANTI_ALIAS_FLAG)
                dim.setColor(jint(alpha(Color.BLACK, cfg.blur_dim / 100.0)))
                canvas.drawRect(float(cl), float(ct), float(cr), float(cb), dim)
            return
        if style == 1:
            cl, ct = max(0, int(left)), max(0, int(top))
            cr, cb = min(bmp.getWidth(), int(right)), min(bmp.getHeight(), int(bottom))
            if cr <= cl or cb <= ct:
                return
            w, h = cr - cl, cb - ct
            cell = max(2, int(dp(cfg.pixel_size)))
            small_w = max(1, int(round(w / float(cell))))
            small_h = max(1, int(round(h / float(cell))))
            small = new_bitmap(small_w, small_h)
            try:
                area, small_area = Rect(cl, ct, cr, cb), Rect(0, 0, small_w, small_h)
                down_paint = Paint(Paint.FILTER_BITMAP_FLAG)
                Canvas(small).drawBitmap(bmp, area, small_area, down_paint)
                paint = Paint()
                paint.setFilterBitmap(False)
                canvas.drawBitmap(small, small_area, area, paint)
            finally:
                small.recycle()
            return
        fill = Paint(Paint.ANTI_ALIAS_FLAG)
        fill.setColor(jint(bg if bg is not None else mask_color(bmp, left, top, right, bottom)))
        canvas.drawRect(float(left), float(top), float(right), float(bottom), fill)
        if style == 4:
            return
        color = ink if ink is not None else SPOILER_COLOR
        if style == 2:
            with SPOILER_CACHE.lock:
                shader = SPOILER_CACHE.get(cfg.spoiler_density, cfg.spoiler_size)
                sp = Paint(Paint.ANTI_ALIAS_FLAG)
                sp.setShader(shader)
                sp.setColorFilter(PorterDuffColorFilter(color, PorterDuff.Mode.SRC_IN))
                canvas.drawRect(float(left), float(top), float(right), float(bottom), sp)
            return
        hatch = Paint(Paint.ANTI_ALIAS_FLAG)
        hatch.setColor(jint(color))
        hatch.setStrokeWidth(float(max(1, dp(1))))
        hatch.setStyle(Paint.Style.STROKE)
        span = bottom - top
        for x in range(left - span, right + span, max(1, dp(6))):
            canvas.drawLine(float(x), float(top), float(x + span), float(bottom), hatch)
    except Exception as e:
        warn("mask", e)
    finally:
        canvas.restore()


def group_of(msg):
    return safe(lambda: int(msg.getGroupId()) if msg.hasValidGroupId() else 0, 0)


def make_album(run):
    try:
        group = MessageObject.GroupedMessages()
        group.groupId = run[0][0].getGroupId()
        for msg, _, _ in run:
            group.messages.add(msg)
        group.calculate()
        if group.posArray.size() != len(run) or any(group.getPosition(msg) is None for msg, _, _ in run):
            return None
        return group
    except Exception as e:
        warn("album group", e)
        return None


def album_geometry(group, width):
    result, span, row = [], 0, 0
    for index in range(group.posArray.size()):
        size = group.posArray.get(index).spanSize
        if size <= 0:
            size = 1000
        if span > 0 and span + size > 1000:
            row += 1
            span = 0
        left = math.ceil(span * width / 1000.0)
        right = math.ceil(min(1000, span + size) * width / 1000.0)
        result.append((row, left, max(1, right - left)))
        span += size
    return result


COPY_FIELDS = (
    "id", "from_id", "peer_id", "saved_peer_id", "dialog_id", "date", "out", "unread",
    "mentioned", "silent", "post", "from_scheduled", "edit_date", "edit_hide", "pinned",
    "fwd_from", "via_bot_id", "via_business_bot_id", "reply_to", "post_author",
    "views", "forwards", "replies", "reactions", "effect", "from_rank", "from_boosts_applied",
    "send_state",
)


def plain_message(msg, account, donor=None, fallback=False):
    if is_action(msg):
        return msg
    owner = msg.messageOwner
    media = safe(lambda: MessageObject.getMedia(owner))
    has_media = (msg.type not in (MessageObject.TYPE_TEXT, MessageObject.TYPE_EMOJIS)
                 or (media is not None and not isinstance(media, TLRPC.TL_messageMediaEmpty)))
    if not has_media:
        return msg
    raw = str(getattr(owner, "message", None) or "")
    if raw.strip():
        text, use_entities = raw, True
    elif fallback:
        tag = str(getattr(msg, "messageText", None) or "").strip() or "Медиа"
        text, use_entities = f"[{tag}]", False
    else:
        return None
    clone = TLRPC.TL_message()
    for name in COPY_FIELDS:
        if hasattr(owner, name) and hasattr(clone, name):
            with suppress(Exception):
                setattr(clone, name, getattr(owner, name))
    if donor is not None and donor is not msg:
        d_owner = donor.messageOwner
        for name in ("reactions", "replies", "views", "forwards"):
            if not getattr(clone, name, None) and getattr(d_owner, name, None):
                with suppress(Exception):
                    setattr(clone, name, getattr(d_owner, name))
    clone.media = TLRPC.TL_messageMediaEmpty()
    clone.message = text
    flags = int(owner.flags) & ~TLRPC.MESSAGE_FLAG_HAS_MEDIA
    if donor is not None and donor is not msg and (int(donor.messageOwner.flags) & TLRPC.MESSAGE_FLAG_HAS_VIEWS):
        flags |= TLRPC.MESSAGE_FLAG_HAS_VIEWS
    entities = getattr(owner, "entities", None)
    if use_entities and entities is not None and entities.size() > 0:
        clone.entities = ArrayList(entities)
        flags |= TLRPC.MESSAGE_FLAG_HAS_ENTITIES
    else:
        clone.entities = ArrayList()
        flags &= ~TLRPC.MESSAGE_FLAG_HAS_ENTITIES
    clone.flags = jint(flags)
    reply = getattr(msg, "replyMessageObject", None)
    if reply is not None:
        return MessageObject(account, clone, reply, True, False)
    return MessageObject(account, clone, True, False)


def strip_media(msgs, account):
    kept, fallback_src, index = [], [], 0
    while index < len(msgs):
        gid = group_of(msgs[index])
        end = index + 1
        while gid and end < len(msgs) and group_of(msgs[end]) == gid:
            end += 1
        run = msgs[index:end]
        donor = run[0] if gid and len(run) > 1 else None
        fallback_src.append((run[0], donor))
        for msg in run:
            converted = safe(lambda: plain_message(msg, account, donor=donor, fallback=False))
            if converted is not None:
                kept.append(converted)
        index = end
    if kept:
        return kept
    result = []
    for msg, donor in fallback_src:
        converted = safe(lambda: plain_message(msg, account, donor=donor, fallback=True))
        if converted is not None:
            result.append(converted)
    return result


@contextmanager
def patched(msgs, opt):
    saved = []

    def patch(target, name, value):
        try:
            saved.append((target, name, getattr(target, name)))
            setattr(target, name, value)
        except Exception:
            pass

    try:
        for msg in msgs:
            owner = getattr(msg, "messageOwner", None)
            if opt.anon_nick:
                if opt.fake_name:
                    patch(msg, "customName", opt.fake_name)
                    patch(msg, "customReplyName", opt.fake_name)
                    if owner is not None:
                        if getattr(owner, "post_author", None):
                            patch(owner, "post_author", opt.fake_name)
                        fwd = getattr(owner, "fwd_from", None)
                        if fwd is not None:
                            patch(fwd, "from_id", None)
                            patch(fwd, "from_name", opt.fake_name)
                            if getattr(fwd, "post_author", None):
                                patch(fwd, "post_author", None)
                elif owner is not None and getattr(owner, "post_author", None):
                    patch(owner, "post_author", None)
                if owner is not None and getattr(owner, "from_rank", None):
                    patch(owner, "from_rank", None)
            if safe(lambda: msg.hasMediaSpoilers() and not msg.needDrawBluredPreview(), False):
                patch(msg, "isMediaSpoilersRevealed", True)
                patch(msg, "isMediaSpoilersRevealedInSharedMedia", True)
                patch(msg, "revealingMediaSpoilers", False)
            if owner is not None:
                reactions = getattr(owner, "reactions", None)
                if opt.hide_reactions and reactions is not None:
                    patch(owner, "reactions", None)
                elif opt.anon_avatar and reactions is not None and getattr(reactions, "recent_reactions", None):
                    patch(reactions, "recent_reactions", ArrayList())
                replies = getattr(owner, "replies", None)
                if opt.hide_status:
                    if int(owner.flags) & TLRPC.MESSAGE_FLAG_HAS_VIEWS:
                        patch(owner, "flags", jint(int(owner.flags) & ~TLRPC.MESSAGE_FLAG_HAS_VIEWS))
                    if replies is not None and not getattr(replies, "comments", False) and getattr(replies, "replies", 0):
                        patch(replies, "replies", jint(0))
                if opt.anon_avatar and replies is not None and getattr(replies, "recent_repliers", None):
                    patch(replies, "recent_repliers", ArrayList())
            if opt.hide_time and (opt.hide_status or not msg.isOutOwner()):
                patch(msg, "notime", True)
        yield
    finally:
        for target, name, value in reversed(saved):
            with suppress(Exception):
                setattr(target, name, value)


class Renderer:
    def __init__(self, msgs, chat, opt, redactions=None, collect=False):
        self.msgs, self.chat, self.opt = msgs, chat, opt
        self.redactions = redactions
        self.collect = collect
        self.ctx = chat.getParentActivity()
        self.provider = self.res = self.delegate = None
        self.cell = self.action = None
        self.receivers = ()

    def run_draw(self):
        pieces = []
        warmers = []
        limit = 6.0 + 0.7 * len(self.msgs)

        def pass_ui(missing):
            done = threading.Event()

            def draw():
                try:
                    self.draw_all(pieces, missing)
                    if missing:
                        for piece in pieces:
                            safe(piece.bmp.recycle)
                        pieces.clear()
                        for spec in missing.values():
                            item = safe(lambda s=spec: make_warmer(s))
                            if item is not None:
                                warmers.append(item)
                except Exception:
                    warn("UI render", traceback.format_exc())
                finally:
                    done.set()

            run_on_ui_thread(draw)
            if not done.wait(limit):
                raise Exception(f"рендер не завершился за {limit:.1f}с")

        missing = {}
        try:
            pass_ui(missing)
            if warmers:
                loader = ImageLoader.getInstance()
                pending = list(warmers)
                deadline = time.monotonic() + 1.8
                while pending and time.monotonic() < deadline:
                    pending = [
                        (rec, key) for rec, key in pending
                        if not (safe(rec.hasImageLoaded, False)
                                or safe(lambda k=key: loader.isInMemCache(k, False), False)
                                or safe(lambda k=key: loader.isInMemCache(k, True), False))
                    ]
                    if pending:
                        time.sleep(0.025)
                pass_ui(None)
        finally:
            if warmers:
                batch = list(warmers)
                warmers.clear()
                run_on_ui_thread(lambda: [safe(rec.onDetachedFromWindow) for rec, _ in batch])
        return pieces

    def render_bitmap(self, wallpaper_bmp):
        if not self.msgs:
            return None
        pieces = self.run_draw()
        if not pieces:
            return None
        count = len(pieces)
        final, _ = self.compose(pieces, wallpaper_bmp)
        return self.finalize(final, count)

    def render(self, wallpaper_bmp):
        final = self.render_bitmap(wallpaper_bmp)
        if final is None:
            return None
        try:
            return encode_bitmap(final, self.opt)
        finally:
            safe(final.recycle)

    def render_editor(self, wallpaper_bmp):
        if not self.msgs:
            return None, []
        self.collect = True
        pieces = self.run_draw()
        if not pieces:
            return None, []
        return self.compose(pieces, wallpaper_bmp)

    def neighbours(self, msgs):
        last = len(msgs) - 1

        def same(a, b):
            return (not is_action(a) and not is_action(b) and a.getSenderId() == b.getSenderId()
                    and abs(a.messageOwner.date - b.messageOwner.date) < 300)

        rows = []
        for index, msg in enumerate(msgs):
            try:
                rows.append((msg, index < last and same(msgs[index + 1], msg), index > 0 and same(msg, msgs[index - 1])))
            except Exception as e:
                warn("neighbours", e)
        return rows

    def surface(self):
        list_view = safe(self.chat.getChatListView)
        list_width = (list_view.getMeasuredWidth() or list_view.getWidth()) if list_view is not None else 0
        return max(1, list_width, AndroidUtilities.displaySize.x), max(1, AndroidUtilities.displaySize.y)

    def plan(self, rows, width):
        album_width = max(1, min(width, AndroidUtilities.displaySize.x or width))
        units, index = [], 0
        while index < len(rows):
            gid = 0 if self.opt.hide_media else group_of(rows[index][0])
            end = index + 1
            while gid and end < len(rows) and group_of(rows[end][0]) == gid:
                end += 1
            run = rows[index:end]
            group = make_album(run) if gid and len(run) > 1 else None
            geometry = safe(lambda: album_geometry(group, album_width)) if group is not None else None
            if not geometry or len(geometry) != len(run):
                units.extend([Entry(msg, bottom, top, None, None, None, 0, width)] for msg, bottom, top in run)
            else:
                unit = []
                for position, (msg, _, _) in enumerate(run):
                    pos = group.posArray.get(position)
                    row, x, cell_width = geometry[position]
                    if group.isDocuments:
                        bottom, top = run[-1][1], run[0][2]
                    else:
                        bottom = run[-1][1] if pos.flags & MessageObject.POSITION_FLAG_BOTTOM else True
                        top = run[0][2] if pos.flags & MessageObject.POSITION_FLAG_TOP else True
                    unit.append(Entry(msg, bottom, top, group, pos, row, x, cell_width))
                units.append(unit)
            index = end
        return units

    def draw_all(self, pieces, missing=None):
        chat = self.chat
        self.provider = chat.getResourceProvider()
        self.res = get_private_field(chat, "sharedResources")
        if self.provider is None or self.res is None:
            return
        src = self.msgs
        if self.redactions is not None and not self.collect and self.redactions.excluded_msgs:
            kept = [m for m in src if msg_key(m) not in self.redactions.excluded_msgs]
            if kept:
                src = kept
        msgs = strip_media(src, chat.getCurrentAccount()) if self.opt.hide_media else src
        rows = self.neighbours(msgs)
        if not rows:
            return
        self.delegate = Delegate(chat, anon_nick=self.opt.anon_nick)
        width, screen_h = self.surface()
        try:
            for unit in self.plan(rows, width):
                with patched([entry.msg for entry in unit], self.opt):
                    shots = [shot for shot in (self.draw_entry(entry, width, screen_h, missing) for entry in unit) if shot]
                    if missing:
                        for shot in shots:
                            safe(shot.bmp.recycle)
                        continue
                    if unit[0].group is None:
                        pieces.extend(Piece(shot.bmp, shot.left, shot.right, shot.height, shot.inset, shot.geoms) for shot in shots)
                    elif shots:
                        self.compose_album(shots, unit, width, pieces)
        finally:
            for cell in (self.cell, self.action):
                if cell is not None:
                    safe(cell.onDetachedFromWindow)
            self.cell = self.action = None
            self.receivers = ()

    def draw_entry(self, entry, width, screen_h, missing=None):
        msg = entry.msg
        try:
            if is_action(msg):
                return self.draw_action(msg, width, screen_h, missing)
            return self.draw_message(entry, width, screen_h, missing)
        except Exception as e:
            warn(f"message {safe(msg.getId, '?')} skipped", e)
            return None

    def message_cell(self):
        if self.cell is None:
            chat, user = self.chat.getCurrentChat(), self.chat.getCurrentUser()
            cell = ChatMessageCell(self.ctx, self.chat.getCurrentAccount(), True, self.res, self.provider)
            cell.onAttachedToWindow()
            cell.setDelegate(self.delegate)
            cell.isChat = chat is not None
            cell.isBot = user is not None and bool(user.bot)
            cell.isMegagroup = chat is not None and ChatObject.isChannel(chat) and bool(chat.megagroup)
            cell.drawingToBitmap = True
            cell.setFullyDraw(True)
            self.receivers = tuple(r for r in (get_private_field(cell, name) for name in RECEIVERS) if r is not None)
            for receiver in self.receivers:
                receiver.setAllowLoadingOnAttachedOnly(False)
            self.cell = cell
        return self.cell

    def draw_message(self, entry, width, screen_h, missing=None):
        msg, pos, opt = entry.msg, entry.pos, self.opt
        cell = self.message_cell()
        outgoing = msg.isOutOwner()
        w = int(entry.width) if entry.width else width
        cell.setParentViewSize(width, screen_h)
        cell.setMessageObject(msg, entry.group, entry.bottom_near, entry.top_near, False)
        cell.measure(View.MeasureSpec.makeMeasureSpec(w, EXACTLY), View.MeasureSpec.makeMeasureSpec(0, UNSPECIFIED))
        h = cell.getMeasuredHeight()
        if h <= 0:
            return None
        cell.layout(0, 0, w, h)
        decor = self.decor_bottom(cell, entry.group, pos) if pos is not None else 0
        on_media = bool(safe(cell.shouldDrawTimeOnMedia, False))
        rx = getattr(cell, "reactionsLayoutInBubble", None)
        small_rx = not opt.hide_reactions and rx is not None and bool(getattr(rx, "isSmall", False)) and not bool(getattr(rx, "isEmpty", True))
        if opt.hide_status:
            set_private_field(cell, "animateFromStatusDrawableParams", Integer(0))
            set_private_field(cell, "animateToStatusDrawableParams", Integer(0))
            set_private_field(cell, "statusDrawableProgress", Float(1.0))
            set_private_field(cell, "statusDrawableAnimationInProgress", True)
            set_private_field(cell, "viewsLayout", None)
            set_private_field(cell, "repliesLayout", None)
            if outgoing and not opt.hide_time:
                if on_media:
                    if not field(cell, "isPinned") and cell.timeLayout is not None:
                        delta = min(dp(18), max(0, int(cell.timeWidth)))
                        cell.timeX = jint(int(cell.timeX) + delta)
                        cell.timeWidth = jint(int(cell.timeWidth) - delta)
                else:
                    cell.timeX = jint(int(cell.timeX) + dp(17))
        if opt.hide_time:
            has_views = not opt.hide_status and field(cell, "viewsLayout") is not None
            has_replies = not opt.hide_status and field(cell, "repliesLayout") is not None
            has_checks = outgoing and not opt.hide_status
            has_pinned = bool(field(cell, "isPinned"))
            if not (small_rx or has_views or has_replies or has_checks or has_pinned):
                cell.timeLayout = None
            else:
                if on_media and has_checks and not (small_rx or has_views or has_replies or has_pinned):
                    tw = max(0, int(field(cell, "timeTextWidth") or 0))
                    delta = min(tw, max(0, int(cell.timeWidth)))
                    cell.timeX = jint(int(cell.timeX) + delta)
                    cell.timeWidth = jint(int(cell.timeWidth) - delta)
                cell.timeLayout = blank(cell.timeLayout)
        hidden_name = opt.anon_nick and not opt.fake_name and opt.style == 4 and bool(field(cell, "drawNameLayout"))
        if hidden_name:
            set_private_field(cell, "drawNameLayout", False)
        if rx is not None:
            rx.y = jint(0)
        safe(lambda: cell.setVisiblePart(0, h, screen_h, 0.0, 0.0, width, screen_h, 0, 0, 0))
        loader = ImageLoader.getInstance()
        for receiver in self.receivers:
            safe(lambda: loader.loadImageForImageReceiver(receiver))
        if missing is not None:
            for receiver in self.receivers:
                spec = missing_receiver(receiver)
                if spec is not None:
                    missing[spec[2]] = spec
            if missing:
                return None
        if msg.type == MessageObject.TYPE_POLL:
            buttons = safe(cell.getPollButtons)
            if buttons is not None and buttons.size() > 0:
                cell.firstVisiblePollButton = 0
                cell.lastVisiblePollButton = buttons.size() - 1

        hide_av = opt.anon_avatar and opt.style == 4
        left, right = 0, w
        bounds_left, bounds_right = cell.getBoundsLeft(), cell.getBoundsRight()
        if hide_av and not outgoing and cell.isAvatarVisible:
            bg_left = safe(cell.getBackgroundDrawableLeft, 0) or 0
            if bg_left > bounds_left:
                bounds_left = max(0, bg_left - dp(6))
        if bounds_right > bounds_left:
            left = max(0, bounds_left)
            right = min(w, max(left + 1, bounds_right))
        extra = dp(64) + (dp(170) if msg.messageOwner.reply_to is not None else 0) if outgoing else 0
        left = max(0, left - dp(14))
        right = min(w, max(left + 1, right + extra))

        pinned_bottom = bool(safe(cell.drawPinnedBottom, entry.bottom_near))
        force_avatar = bool(getattr(msg, "forceAvatar", False)) or getattr(msg, "customAvatarDrawable", None) is not None
        avatar_slot = not outgoing and (not pinned_bottom or force_avatar)
        if pos is not None and (not cell.isAvatarVisible or not (pos.flags & MessageObject.POSITION_FLAG_BOTTOM)):
            avatar_slot = False
        draw_avatar = cell.isAvatarVisible and avatar_slot
        avatar_size = dp(42)
        avatar_y = h - avatar_size - dp(4)
        inset = -avatar_y if draw_avatar and not hide_av and avatar_y < 0 else 0

        bmp = new_bitmap(max(1, width - int(entry.x)) if pos is not None else w, h + inset)
        canvas = Canvas(bmp)
        if pos is None and safe(cell.drawBackgroundInParent, False):
            attempt("background", lambda: draw_shifted(
                canvas, inset + cell.getPaddingTop(), lambda: cell.drawBackgroundInternal(canvas, True)))
        draw_shifted(canvas, inset, lambda: cell.draw(canvas))
        if pos is not None:
            draw_shifted(canvas, inset + cell.getPaddingTop(), lambda: self.group_extras(canvas, cell, pos))

        bg = None
        if pos is not None:
            pad_top = cell.getPaddingTop()
            bg = safe(lambda: box(cell.getBackgroundDrawableLeft(), pad_top + cell.getBackgroundDrawableTop(),
                                  cell.getBackgroundDrawableRight(), pad_top + cell.getBackgroundDrawableBottom()))

        receiver = cell_avatar = manual_avatar = None
        if draw_avatar and not hide_av:
            receiver = cell.getAvatarImage()
            cell_avatar = shift(receiver_bounds(receiver), inset)
            if not pinned_bottom and receiver is not None:
                if not opt.anon_avatar or opt.style in (0, 1):
                    def paint_avatar():
                        receiver.setImageCoords(dp(6), avatar_y, avatar_size, avatar_size)
                        receiver.setVisible(True, False)
                        receiver.draw(canvas)

                    draw_shifted(canvas, inset, paint_avatar)
                manual_avatar = (dp(6), avatar_y + inset, dp(6) + avatar_size, avatar_y + avatar_size + inset)
        avatar_bounds = manual_avatar or cell_avatar
        for bounds in (cell_avatar, manual_avatar):
            if bounds:
                left = max(0, min(left, bounds[0] - dp(6)))

        masks = []
        ink = safe(lambda: tcolor(Theme.key_chat_messageTextOut if outgoing else Theme.key_chat_messageTextIn,
                                  self.provider))
        mkey = msg_key(msg)
        red = self.redactions if not self.collect else None
        has_red = red is not None and (mkey in red.hidden_msgs or bool(red.spans.get(mkey)))
        text_blocks = cell_text_blocks(cell, msg, inset) if (self.collect or has_red) else ()
        need_box = self.collect or (red is not None and mkey in red.hidden_msgs)
        bbox = bubble_box(cell, inset, left, right, h) if need_box else None
        bshape, bbox = bubble_shape(cell, msg, inset, bbox, pos, entry.top_near, entry.bottom_near) if need_box else (None, None)

        if opt.anon_nick or opt.anon_avatar or opt.anon_usernames or has_red:
            av_bg = safe(lambda: tcolor(Theme.key_chat_inBubble, self.provider)) if opt.style in (2, 3) else None

            def mask(bounds, circle=False, radius=None, fill_bg=None, shape=None):
                if not bounds:
                    return
                if pos is not None:
                    masks.append((bounds, ink, circle, radius, fill_bg, shape))
                else:
                    draw_mask(canvas, bmp, bounds, opt.style, ink, circle=circle, radius=radius,
                              bg=fill_bg, shape=shape, cfg=opt.mask)

            if opt.anon_usernames:
                for bounds in safe(lambda: username_bounds(cell, msg), []):
                    mask(shift(bounds, inset))
            if opt.anon_nick:
                names = [safe(lambda: reply_fwd_bounds(cell))]
                if not hidden_name:
                    names.append(safe(lambda: via_bounds(cell)))
                if opt.fake_name:
                    r_layout = field(cell, "replyNameLayout")
                    if r_layout is not None and str(r_layout.getText()).strip() != opt.fake_name:
                        names.append(safe(lambda: reply_name_bounds(cell)))
                    if msg.type == MessageObject.TYPE_STORY:
                        names.append(safe(lambda: forward_bounds(cell)))
                else:
                    names.extend(safe(lambda: getter(cell)) for getter in (reply_name_bounds, forward_bounds))
                    if not hidden_name:
                        names.extend(safe(lambda: getter(cell)) for getter in (name_bounds, status_bounds, admin_bounds))
                for bounds in names:
                    mask(shift(bounds, inset))
            if opt.anon_avatar:
                if avatar_bounds and not hide_av:
                    mask(avatar_bounds, circle=True, radius=round_radius(receiver, avatar_bounds), fill_bg=av_bg)
                for getter in (name_avatar_bounds, lambda c: forum_avatar_bounds(c, msg)):
                    mask(shift(safe(lambda: getter(cell)), inset), circle=True)
                if not opt.anon_nick:
                    mask(shift(safe(lambda: forward_avatar_bounds(cell)), inset), circle=True)
            if has_red:
                if mkey in red.hidden_msgs:
                    mask(bbox, radius=bubble_rad(), shape=bshape)
                else:
                    msg_spans = red.spans.get(mkey, ())
                    for source, layout, char_off, ox, oy in text_blocks:
                        matched = [(s - char_off, e - char_off) for src, s, e in msg_spans if src == source]
                        if matched:
                            for bounds in span_boxes(layout, matched, ox, oy, pad=dp(2)):
                                mask(bounds)

        geoms = ()
        if self.collect:
            lines = []
            for source, layout, char_off, ox, oy in text_blocks:
                lines.extend(safe(lambda: extract_lines(source, layout, char_off, ox, oy), []))
            geoms = (MsgGeom(mkey, bbox, bshape, outgoing, False, ink, lines),)
        return Shot(bmp, left, right, h, inset, entry.x, entry.row, decor, bg, masks, geoms)

    def group_extras(self, canvas, cell, pos):
        flags = pos.flags
        left_column = flags & MessageObject.POSITION_FLAG_LEFT
        if pos.last:
            attempt("album time", lambda: cell.drawTime(canvas, 1.0, True))
        if pos.minX == 0 and pos.minY == 0:
            attempt("album name", lambda: cell.hasNameLayout() and cell.drawNamesLayout(canvas, 1.0))
        attempt("album caption", lambda: flags & cell.captionFlag() and cell.drawCaptionLayout(canvas, not left_column, 1.0))
        if flags & MessageObject.POSITION_FLAG_BOTTOM and left_column:
            if self.opt.hide_reactions:
                attempt("album comments", lambda: cell.drawCommentLayout(canvas, 1.0))
            else:
                attempt("album reactions",
                        lambda: (cell.drawCommentLayout(canvas, 1.0), cell.drawReactionsLayout(canvas, 1.0, None)))

    def decor_bottom(self, cell, group, pos):
        try:
            siblings = getattr(pos, "siblingHeights", None)
            if siblings is None or len(siblings) == 0:
                return 0
            max_height = max(AndroidUtilities.displaySize.x, AndroidUtilities.displaySize.y) * 0.5
            extra = cell.getExtraInsetHeight() + sum(math.ceil(max_height * float(h)) for h in siblings)
            extra += (pos.maxY - pos.minY) * int(round(7 * AndroidUtilities.density))
            for index in range(group.posArray.size()):
                other = group.posArray.get(index)
                if other.minY != pos.minY or (other.minX == pos.minX and other.maxX == pos.maxX and other.maxY == pos.maxY):
                    continue
                extra -= math.ceil(max_height * other.ph) - dp(4)
                break
            return -extra
        except Exception as e:
            warn("album inset", e)
            return 0

    def action_cell(self):
        if self.action is None:
            chat = self.chat.getCurrentChat()
            cell = ChatActionCell(self.ctx, False, self.provider)
            cell.onAttachedToWindow()
            safe(lambda: setattr(cell, "isForum", chat is not None and ChatObject.isForum(chat)))
            safe(lambda: setattr(cell, "isMonoForum", chat is not None and ChatObject.isMonoForum(chat)))
            safe(lambda: cell.setShowTopic(True))
            self.action = cell
        return self.action

    def draw_action(self, msg, width, screen_h, missing=None):
        cell = self.action_cell()
        cell.setMessageObject(msg, True)
        photo = cell.getPhotoImage()
        if photo is not None:
            photo.setAllowLoadingOnAttachedOnly(False)
            ImageLoader.getInstance().loadImageForImageReceiver(photo)
            if missing is not None:
                spec = missing_receiver(photo)
                if spec is not None:
                    missing[spec[2]] = spec
        if missing:
            return None
        cell.measure(View.MeasureSpec.makeMeasureSpec(width, EXACTLY), View.MeasureSpec.makeMeasureSpec(0, UNSPECIFIED))
        h = cell.getMeasuredHeight()
        if h <= 0:
            return None
        cell.layout(0, 0, width, h)
        safe(lambda: cell.setVisiblePart(0.0, screen_h))
        hide_photo = self.opt.anon_avatar and self.opt.style == 4 and not msg.isDateObject and photo is not None
        if hide_photo:
            photo.setVisible(False, False)
        bmp = new_bitmap(width, h)
        canvas = Canvas(bmp)
        cell.draw(canvas)
        if hide_photo:
            photo.setVisible(True, False)
        left, right = 0, width
        bg_left, bg_right = get_private_field(cell, "backgroundLeft"), get_private_field(cell, "backgroundRight")
        if bg_left is not None and bg_right is not None and bg_right > bg_left:
            left = max(0, bg_left - dp(8))
            right = min(width, max(left + 1, bg_right + dp(8)))
        service_ink = safe(lambda: tcolor(Theme.key_chat_serviceText, self.provider))
        if not msg.isDateObject:
            if self.opt.anon_nick:
                for bounds in safe(lambda: action_name_bounds(cell), []):
                    draw_mask(canvas, bmp, bounds, self.opt.style, service_ink, cfg=self.opt.mask)
            if self.opt.anon_avatar and not hide_photo and photo is not None:
                bounds = receiver_bounds(photo)
                if bounds:
                    av_bg = safe(lambda: tcolor(Theme.key_chat_serviceBackground, self.provider)) if self.opt.style in (2, 3) else None
                    draw_mask(canvas, bmp, bounds, self.opt.style, service_ink,
                              circle=True, radius=round_radius(photo, bounds), bg=av_bg, cfg=self.opt.mask)
        mkey = msg_key(msg)
        act_box = (box(bg_left, dp(2), bg_right, max(dp(4), h - dp(2)))
                   if bg_left is not None and bg_right is not None and bg_right > bg_left else box(left, 0, right, h))
        act_shape = round_path(act_box, min(dp(16), (act_box[3] - act_box[1]) // 2)) if act_box else None
        layout = field(cell, "textLayout")
        ax, ay = fnum(cell, "textXLeft"), fnum(cell, "textY")
        red = self.redactions if not self.collect else None
        if red is not None:
            if mkey in red.hidden_msgs and act_box:
                draw_mask(canvas, bmp, act_box, self.opt.style, service_ink, shape=act_shape, cfg=self.opt.mask)
            elif layout is not None and red.spans.get(mkey):
                matched = [(s, e) for src, s, e in red.spans.get(mkey, ()) if src == "action"]
                for bounds in span_boxes(layout, matched, ax, ay, pad=dp(2)):
                    draw_mask(canvas, bmp, bounds, self.opt.style, service_ink, cfg=self.opt.mask)
        geoms = ()
        if self.collect:
            lines = safe(lambda: extract_lines("action", layout, 0, ax, ay), []) if layout is not None else []
            geoms = (MsgGeom(mkey, act_box, act_shape, False, True, service_ink, lines),)
        return Shot(bmp, left, right, h, 0, 0, None, 0, None, (), geoms)

    def compose_album(self, shots, unit, width, pieces):
        try:
            heights = {}
            for shot in shots:
                row = shot.row or 0
                heights[row] = max(heights.get(row, 0), shot.height + shot.decor)
            row_tops, total = {}, 0
            for row in sorted(heights):
                row_tops[row] = total
                total += max(0, heights[row])
            logical_h = max(1, total)
            tops = [row_tops[shot.row or 0] - shot.inset for shot in shots]
            rects = [(shot.x + shot.bg[0], row_tops[shot.row or 0] + shot.bg[1],
                      shot.x + shot.bg[2], row_tops[shot.row or 0] + shot.bg[3])
                     for shot in shots if shot.bg]
            bg = box(min(r[0] for r in rects), min(r[1] for r in rects),
                     max(r[2] for r in rects), max(r[3] for r in rects)) if rects else None
            inset = max([0] + [-top for top in tops] + ([-bg[1]] if bg else []))
            height = max([inset + logical_h]
                         + [inset + top + shot.bmp.getHeight() for top, shot in zip(tops, shots)]
                         + ([inset + bg[3]] if bg else []))
            album = new_bitmap(width, height)
            canvas = Canvas(album)
            if bg and self.cell is not None:
                attempt("album background", lambda: self.cell.drawBackground(
                    canvas, jint(bg[0]), jint(inset + bg[1]), jint(bg[2]), jint(inset + bg[3]),
                    bool(unit[0].top_near), bool(unit[-1].bottom_near), False, jint(0)))
            left, right = width, 0
            if bg:
                left = min(left, max(0, min(width, bg[0])))
                right = max(right, max(0, min(width, bg[2])))
            album_geoms = []
            for top, shot in zip(tops, shots):
                canvas.drawBitmap(shot.bmp, float(shot.x), float(inset + top), None)
                left = min(left, max(0, min(width, shot.left + shot.x)))
                right = max(right, max(0, min(width, shot.right + shot.x)))
                if shot.geoms:
                    album_geoms.extend(shift_geoms(shot.geoms, shot.x, inset + top))
            for top, shot in zip(tops, shots):
                for bounds, ink, circle, radius, fill_bg, shape in shot.masks:
                    shifted = (bounds[0] + shot.x, bounds[1] + inset + top,
                               bounds[2] + shot.x, bounds[3] + inset + top)
                    draw_mask(canvas, album, shifted, self.opt.style, ink, circle=circle, radius=radius,
                              bg=fill_bg, shape=shift_path(shape, shot.x, inset + top), cfg=self.opt.mask)
            if right <= left:
                left, right = 0, width
            pieces.append(Piece(album, left, right, logical_h, inset, tuple(album_geoms)))
        except Exception as e:
            warn("album compose", e)
        finally:
            for shot in shots:
                safe(shot.bmp.recycle)

    def compose(self, pieces, wallpaper_bmp):
        try:
            left = min(piece.left for piece in pieces)
            right = max(piece.right for piece in pieces)
            if right <= left:
                left, right = 0, max(piece.bmp.getWidth() for piece in pieces)
            placed, y, min_y, max_y = [], 0, 0, 0
            for index, piece in enumerate(pieces):
                top = y - piece.inset
                min_y, max_y = min(min_y, top), max(max_y, top + piece.bmp.getHeight())
                placed.append((piece, top))
                y += piece.height + (dp(2) if index < len(pieces) - 1 else 0)
            pad = dp(8) if self.opt.transparent else dp(self.opt.padding)
            final = new_bitmap(max(1, right - left) + pad * 2, max(1, max_y - min_y) + pad * 2)
            canvas = Canvas(final)
            if not self.opt.transparent:
                self.paint_background(canvas, final, wallpaper_bmp, left - pad)
            geoms = []
            for piece, top in placed:
                dx, dy = pad - left, pad + top - min_y
                canvas.drawBitmap(piece.bmp, float(dx), float(dy), None)
                if piece.geoms:
                    geoms.extend(shift_geoms(piece.geoms, dx, dy))
            return final, geoms
        finally:
            for piece in pieces:
                safe(piece.bmp.recycle)

    def paint_background(self, canvas, final, wallpaper_bmp, offset_x):
        bg_type, width, height = self.opt.bg_type, final.getWidth(), final.getHeight()
        if bg_type == 0 and wallpaper_bmp is not None:
            tile_wallpaper(canvas, wallpaper_bmp, width, height, offset_x)
        elif bg_type == 0:
            canvas.drawColor(jint(tcolor(Theme.key_chat_wallpaper, self.provider)))
        elif bg_type == 2 and self.opt.bg_color & 0xFF000000:
            canvas.drawColor(jint(self.opt.bg_color))

    def finalize(self, final, count):
        opt = self.opt
        try:
            factor = 1.0 if opt.sticker else opt.scale
            if factor != 1.0:
                final = swap(final, rescale(final, factor))
            opt.watermark.draw(Canvas(final), final, self.chat, count, factor)
            jpeg = not opt.sticker and opt.fmt.name == "JPEG"
            if not jpeg and not opt.sticker and opt.corner > 0:
                final = swap(final, round_bitmap(final, int(dp(opt.corner) * factor)))
            if jpeg:
                final = swap(final, flatten(final))
            return final
        except Exception:
            safe(final.recycle)
            raise


def handle_point(aabb, width, height):
    pad = float(dp(4))
    hx = aabb.right + pad if aabb.right + dp(16) <= width else aabb.left - pad
    hy = aabb.bottom + pad if aabb.bottom + dp(16) <= height else aabb.top - pad
    return max(float(dp(10)), min(float(width - dp(10)), hx)), max(float(dp(10)), min(float(height - dp(10)), hy))


def rotated_aabb(rect, angle):
    aabb = RectF(rect)
    if angle:
        matrix = Matrix()
        matrix.setRotate(float(angle), rect.centerX(), rect.centerY())
        matrix.mapRect(aabb)
    return aabb


class Watermark:
    def __init__(self, prefs, logo=None):
        self.enabled = prefs.flag("watermark_enabled")
        raw = prefs.plugin.get_setting("watermark_text", "@username")
        self.template = "" if raw is None else str(raw).strip()
        self.position = prefs.num("watermark_position", 0, 0, 5)
        self.fx = prefs.ratio("watermark_x")
        self.fy = prefs.ratio("watermark_y")
        self.size = prefs.num("watermark_size", 13, 8, 48)
        self.opacity = prefs.num("watermark_opacity", 72, 5, 100)
        self.padding = prefs.num("watermark_padding", 12, 0, 64)
        self.angle = prefs.num("watermark_angle", 0, -45, 45)
        self.color = Theme.multAlpha(prefs.color("watermark_color", "#FFFFFFFF"), self.opacity / 100.0)
        self.blur = prefs.flag("watermark_blur_bg", True)
        self.plate = prefs.num("watermark_bg_opacity", 36, 0, 100)
        self.radius = prefs.num("watermark_bg_radius", 12, 0, 32)
        self.tile = prefs.flag("watermark_tile")
        self.logo = logo
        self.logo_pos = prefs.num("watermark_logo_position", 3, 0, 5)
        self.logo_fx = prefs.ratio("watermark_logo_x")
        self.logo_fy = prefs.ratio("watermark_logo_y")
        self.logo_size = prefs.num("watermark_logo_size", 28, 12, 96)
        self.logo_opacity = prefs.num("watermark_logo_opacity", 80, 5, 100)

    def caption(self, chat=None, count=None):
        text = self.template
        if not text or "{" not in text:
            return text
        title = ""
        if chat is not None:
            current, user = chat.getCurrentChat(), chat.getCurrentUser()
            if current is not None:
                title = str(current.title or "")
            elif user is not None:
                title = str(UserObject.getUserName(user) or "")
        return (text.replace("{date}", time.strftime("%d.%m.%Y"))
                .replace("{chat}", title)
                .replace("{count}", "" if count is None else str(count)))

    def anchor_pos(self, pos, width, height, box_w, box_h, pad):
        right, bottom = width - pad - box_w, height - pad - box_h
        left, top = {
            1: (pad, bottom),
            2: (right, pad),
            3: (pad, pad),
            4: ((width - box_w) // 2, (height - box_h) // 2),
        }.get(pos, (right, bottom))
        return max(0, min(max(0, width - box_w), left)), max(0, min(max(0, height - box_h), top))

    def place(self, width, height, box_w, box_h, pad, pos, fx=None, fy=None, angle=0):
        if angle:
            rad = math.radians(angle)
            cos_a, sin_a = abs(math.cos(rad)), abs(math.sin(rad))
            span_w = box_w * cos_a + box_h * sin_a
            span_h = box_w * sin_a + box_h * cos_a
        else:
            span_w, span_h = float(box_w), float(box_h)
        if pos == 5:
            nx = 0.5 if fx is None else max(0.0, min(1.0, fx))
            ny = 0.5 if fy is None else max(0.0, min(1.0, fy))
            ax = pad + nx * max(0.0, width - pad * 2 - span_w)
            ay = pad + ny * max(0.0, height - pad * 2 - span_h)
        else:
            ax, ay = self.anchor_pos(pos, width, height, int(math.ceil(span_w)), int(math.ceil(span_h)), pad)
        left = (width - box_w) // 2 if span_w > width else int(round(ax + (span_w - box_w) / 2.0))
        top = (height - box_h) // 2 if span_h > height else int(round(ay + (span_h - box_h) / 2.0))
        return left, top

    def text_paint(self):
        paint = Paint(Paint.ANTI_ALIAS_FLAG)
        paint.setDither(True)
        paint.setFakeBoldText(True)
        return paint

    def logo_box(self, scale=1.0):
        logo = self.logo
        if logo is None:
            return 0, 0
        logo_w, logo_h = max(1, logo.getWidth()), max(1, logo.getHeight())
        size = max(1, int(round(dp(self.logo_size) * scale)))
        return size, max(1, int(round(size * logo_h / logo_w)))

    def logo_rect(self, width, height, scale=1.0):
        if self.logo is None:
            return None
        size, dst_h = self.logo_box(scale)
        pad = int(round(dp(self.padding) * scale))
        left, top = self.place(width, height, size, dst_h, pad, self.logo_pos, self.logo_fx, self.logo_fy)
        return Rect(left, top, left + size, top + dst_h)

    def layout(self, paint, text, width, height, scale=1.0):
        size = max(1, int(round(self.size * scale)))
        pad = int(round(dp(self.padding) * scale))
        paint.setTextSize(float(dp(size)))
        paint.setColor(jint(self.color))

        def measure(value):
            return int(paint.measureText(value) + 0.999)

        inner_x, inner_y = int(dp(8) * scale), int(dp(5) * scale)
        limit = max(1, width - pad * 2 - inner_x * 2)
        while size > 8 and measure(text) > limit:
            size -= 1
            paint.setTextSize(float(dp(size)))
        if measure(text) > limit:
            while text and measure(text.rstrip() + "...") > limit:
                text = text[:-1]
            text = text.rstrip() + "..." if text else "..."
        metrics = paint.getFontMetrics()
        text_w = measure(text)
        text_h = max(1, int(metrics.descent - metrics.ascent + 0.999))
        mid_offset = float((metrics.ascent + metrics.descent) / 2.0)
        box_w = max(1, text_w + inner_x * 2)
        box_h = max(1, text_h + inner_y * 2)
        left, top = self.place(width, height, box_w, box_h, pad, self.position, self.fx, self.fy,
                               0 if self.tile else self.angle)
        cy = top + box_h / 2.0
        radius = float(min(int(round(dp(self.radius) * scale)), min(box_w, box_h) // 2))
        return SimpleNamespace(
            text=text, left=left, top=top, box_w=box_w, box_h=box_h,
            text_x=float(left + inner_x), text_y=float(cy - mid_offset), radius=radius,
            rect=RectF(float(left), float(top), float(left + box_w), float(top + box_h)))

    def plate_color(self):
        base = Color.WHITE if AndroidUtilities.isDarkColor(self.color) else Color.BLACK
        return Theme.multAlpha(base, self.plate / 100.0)

    def paint_badge(self, canvas, paint, lay):
        canvas.save()
        if self.angle:
            canvas.rotate(float(self.angle), lay.rect.centerX(), lay.rect.centerY())
        if self.plate > 0:
            plate = Paint(Paint.ANTI_ALIAS_FLAG)
            plate.setColor(jint(self.plate_color()))
            canvas.drawRoundRect(lay.rect, lay.radius, lay.radius, plate)
        if lay.text:
            canvas.drawText(lay.text, lay.text_x, lay.text_y, paint)
        canvas.restore()

    def tiles(self, canvas, paint, lay, width, height):
        step_x = max(int(lay.box_w * 1.6), dp(60))
        step_y = max(int(lay.box_h * 3.0), dp(52))
        span = int((width + height) * 0.75)
        canvas.save()
        canvas.rotate(float(self.angle or -30), width / 2.0, height / 2.0)
        for row, y in enumerate(range(-span, height + span, step_y)):
            for x in range(-span + (step_x // 2 if row % 2 else 0), width + span, step_x):
                canvas.drawText(lay.text, float(x), float(y), paint)
        canvas.restore()

    def draw_logo(self, canvas, width, height, scale=1.0):
        rect = self.logo_rect(width, height, scale)
        if rect is None:
            return None
        logo = self.logo
        paint = Paint(Paint.ANTI_ALIAS_FLAG)
        paint.setFilterBitmap(True)
        paint.setAlpha(int(255 * self.logo_opacity / 100))
        canvas.drawBitmap(logo, Rect(0, 0, logo.getWidth(), logo.getHeight()), rect, paint)
        return rect

    def stamp(self, canvas, bitmap, text, scale=1.0, boxes=None):
        width, height = bitmap.getWidth(), bitmap.getHeight()
        if text:
            paint = self.text_paint()
            shadow = max(32, min(145, int(self.opacity * 1.35)))
            shadow_base = Color.WHITE if AndroidUtilities.isDarkColor(self.color) else Color.BLACK
            paint.setShadowLayer(float(dp(1)), 0.0, float(dp(1)),
                                 jint(ColorUtils.setAlphaComponent(shadow_base, shadow)))
            lay = self.layout(paint, text, width, height, scale)
            if self.tile:
                self.tiles(canvas, paint, lay, width, height)
            else:
                if self.blur:
                    attempt("watermark blur", lambda: blur_region(canvas, bitmap, lay.rect, lay.radius, self.angle))
                self.paint_badge(canvas, paint, lay)
                if boxes is not None:
                    aabb = rotated_aabb(lay.rect, self.angle)
                    boxes["text"] = {"aabb": aabb, "handle": handle_point(aabb, width, height)}
        logo_rect = self.draw_logo(canvas, width, height, scale)
        if logo_rect is not None and boxes is not None:
            aabb = RectF(float(logo_rect.left), float(logo_rect.top), float(logo_rect.right), float(logo_rect.bottom))
            boxes["logo"] = {"aabb": aabb, "handle": handle_point(aabb, width, height)}

    def draw(self, canvas, bitmap, chat=None, count=None, scale=1.0):
        if not self.enabled:
            return
        try:
            self.stamp(canvas, bitmap, self.caption(chat, count), scale)
        except Exception as e:
            warn("watermark", e)

    def preview(self, canvas, provider, boxes=None):
        width, height = canvas.getWidth(), canvas.getHeight()
        if width <= 0 or height <= 0:
            return
        buf = new_bitmap(width, height)
        try:
            bc = Canvas(buf)

            def color(key):
                return jint(tcolor(key, provider))

            drawable = (safe(provider.getWallpaperDrawable) if provider is not None else None) or Theme.getCachedWallpaper()
            if drawable is not None:
                if Theme.isPatternWallpaper():
                    bc.drawColor(color(Theme.key_chat_wallpaper))
                old_bounds = Rect(drawable.getBounds())
                try:
                    iw, ih = drawable.getIntrinsicWidth(), drawable.getIntrinsicHeight()
                    if iw > 0 and ih > 0:
                        scale = max(width / float(iw), height / float(ih))
                        dw, dh = int(round(iw * scale)), int(round(ih * scale))
                        dx, dy = (width - dw) // 2, (height - dh) // 2
                        drawable.setBounds(dx, dy, dx + dw, dy + dh)
                    else:
                        drawable.setBounds(0, 0, width, height)
                    drawable.draw(bc)
                finally:
                    drawable.setBounds(old_bounds)
            else:
                base = tcolor(Theme.key_chat_wallpaper, provider)
                accent = tcolor(Theme.key_featuredStickers_addButton, provider)
                bg_paint = Paint(Paint.ANTI_ALIAS_FLAG)
                bg_paint.setShader(LinearGradient(
                    0.0, 0.0, float(width), float(height),
                    jint(base), jint(ColorUtils.blendARGB(base, accent, 0.22)), Shader.TileMode.CLAMP))
                bc.drawRect(0.0, 0.0, float(width), float(height), bg_paint)

            medium = AndroidUtilities.getTypeface("fonts/rmedium.ttf")
            paint = Paint(Paint.ANTI_ALIAS_FLAG)
            date_paint = Paint(Paint.ANTI_ALIAS_FLAG)
            date_paint.setTextSize(float(dp(11)))
            date_paint.setTypeface(medium)
            date_paint.setColor(color(Theme.key_chat_serviceText))
            date_text = "Сегодня"
            date_w = int(date_paint.measureText(date_text) + 0.999) + dp(18)
            date_left = (width - date_w) // 2
            date_top, date_h = dp(10), dp(20)
            paint.setColor(color(Theme.key_chat_serviceBackground))
            bc.drawRoundRect(RectF(float(date_left), float(date_top), float(date_left + date_w), float(date_top + date_h)),
                             float(dp(10)), float(dp(10)), paint)
            dm = date_paint.getFontMetrics()
            bc.drawText(date_text, float(date_left + dp(9)), float(date_top + date_h / 2.0 - (dm.ascent + dm.descent) / 2.0), date_paint)

            ink = Paint(Paint.ANTI_ALIAS_FLAG)
            ink.setTextSize(float(dp(13.5)))
            name_paint = Paint(Paint.ANTI_ALIAS_FLAG)
            name_paint.setTextSize(float(dp(12)))
            name_paint.setTypeface(medium)
            accent_text = tcolor(Theme.key_windowBackgroundWhiteBlueText, provider)
            name_paint.setColor(jint(accent_text))
            time_paint = Paint(Paint.ANTI_ALIAS_FLAG)
            time_paint.setTextSize(float(dp(10)))

            in_text = "Смотри, как выглядит"
            in_left, in_top, in_h = dp(50), dp(38), dp(50)
            in_w = min(width - dp(66), max(dp(174), int(ink.measureText(in_text) + dp(56))))
            av_size = dp(32)
            av_left, av_top = dp(10), in_top + in_h - av_size
            av_paint = Paint(Paint.ANTI_ALIAS_FLAG)
            av_paint.setShader(LinearGradient(
                float(av_left), float(av_top), float(av_left + av_size), float(av_top + av_size),
                jint(ColorUtils.blendARGB(accent_text, Color.WHITE, 0.25)), jint(accent_text), Shader.TileMode.CLAMP))
            bc.drawCircle(av_left + av_size / 2.0, av_top + av_size / 2.0, av_size / 2.0, av_paint)
            av_ink = Paint(Paint.ANTI_ALIAS_FLAG)
            av_ink.setTextSize(float(dp(14)))
            av_ink.setTypeface(medium)
            av_ink.setColor(jint(Color.WHITE))
            av_ink.setTextAlign(Paint.Align.CENTER)
            am = av_ink.getFontMetrics()
            bc.drawText("А", av_left + av_size / 2.0, float(av_top + av_size / 2.0 - (am.ascent + am.descent) / 2.0), av_ink)

            paint.setColor(color(Theme.key_chat_inBubble))
            in_bottom = in_top + in_h
            bc.drawRoundRect(RectF(float(in_left), float(in_top), float(in_left + in_w), float(in_bottom)),
                             float(dp(15)), float(dp(15)), paint)
            in_tail = Path()
            in_tail.moveTo(float(in_left + dp(6)), float(in_bottom))
            in_tail.lineTo(float(in_left - dp(5)), float(in_bottom))
            in_tail.quadTo(float(in_left), float(in_bottom - dp(2)), float(in_left), float(in_bottom - dp(10)))
            in_tail.lineTo(float(in_left + dp(8)), float(in_bottom - dp(8)))
            in_tail.close()
            bc.drawPath(in_tail, paint)
            bc.drawText("Алексей", float(in_left + dp(12)), float(in_top + dp(17)), name_paint)
            ink.setColor(color(Theme.key_chat_messageTextIn))
            bc.drawText(in_text, float(in_left + dp(12)), float(in_top + dp(37)), ink)
            time_paint.setColor(jint(alpha(tcolor(Theme.key_chat_inTimeText, provider), 0.85)))
            bc.drawText("12:34", float(in_left + in_w - dp(34)), float(in_bottom - dp(7)), time_paint)

            out_text = "Выглядит отлично!"
            out_top, out_h = in_bottom + dp(8), dp(40)
            out_w = min(width - dp(52), max(dp(166), int(ink.measureText(out_text) + dp(66))))
            out_left, out_bottom = width - dp(14) - out_w, out_top + out_h
            out_right = out_left + out_w
            paint.setColor(color(Theme.key_chat_outBubble))
            bc.drawRoundRect(RectF(float(out_left), float(out_top), float(out_right), float(out_bottom)),
                             float(dp(15)), float(dp(15)), paint)
            out_tail = Path()
            out_tail.moveTo(float(out_right - dp(6)), float(out_bottom))
            out_tail.lineTo(float(out_right + dp(5)), float(out_bottom))
            out_tail.quadTo(float(out_right), float(out_bottom - dp(2)), float(out_right), float(out_bottom - dp(10)))
            out_tail.lineTo(float(out_right - dp(8)), float(out_bottom - dp(8)))
            out_tail.close()
            bc.drawPath(out_tail, paint)
            ink.setColor(color(Theme.key_chat_messageTextOut))
            bc.drawText(out_text, float(out_left + dp(12)), float(out_top + dp(25)), ink)
            time_paint.setColor(jint(alpha(tcolor(Theme.key_chat_outTimeText, provider), 0.85)))
            bc.drawText("12:35", float(out_right - dp(48)), float(out_bottom - dp(7)), time_paint)
            check = Paint(Paint.ANTI_ALIAS_FLAG)
            check.setStyle(Paint.Style.STROKE)
            check.setStrokeWidth(float(max(1, dp(1.3))))
            check.setStrokeCap(Paint.Cap.ROUND)
            check.setStrokeJoin(Paint.Join.ROUND)
            check.setColor(color(Theme.key_chat_outSentCheckRead))
            cx, cy = float(out_right - dp(19)), float(out_bottom - dp(9))
            ticks = Path()
            ticks.moveTo(cx, cy - dp(2))
            ticks.lineTo(cx + dp(2.5), cy + dp(0.5))
            ticks.lineTo(cx + dp(7), cy - dp(4.5))
            ticks.moveTo(cx + dp(3.5), cy - dp(2))
            ticks.lineTo(cx + dp(6), cy + dp(0.5))
            ticks.lineTo(cx + dp(10.5), cy - dp(4.5))
            bc.drawPath(ticks, check)

            self.stamp(bc, buf, self.caption(count=3), boxes=boxes)

            area = RectF(0.0, 0.0, float(width), float(height))
            radius = float(dp(14))
            clip = Path()
            clip.addRoundRect(area, radius, radius, Path.Direction.CW)
            canvas.save()
            canvas.clipPath(clip)
            canvas.drawBitmap(buf, 0.0, 0.0, None)
            canvas.restore()

            stroke = Paint(Paint.ANTI_ALIAS_FLAG)
            stroke.setStyle(Paint.Style.STROKE)
            stroke.setStrokeWidth(float(max(1, dp(1))))
            stroke.setColor(color(Theme.key_divider))
            inset = stroke.getStrokeWidth() / 2.0
            canvas.drawRoundRect(RectF(inset, inset, float(width) - inset, float(height) - inset), radius, radius, stroke)
        finally:
            buf.recycle()


class Stage:
    def __init__(self, plugin):
        self.plugin = plugin
        self.selected = None
        self.mode = None
        self.boxes = {}
        self.size = (0, 0)
        self.start = None
        self.snap_x = self.snap_y = False
        self.badge = ""

    def keys(self, kind):
        if kind == "logo":
            return ("watermark_logo_position", "watermark_logo_x", "watermark_logo_y",
                    "watermark_logo_size", 3, 28, 12, 96, "Логотип")
        return ("watermark_position", "watermark_x", "watermark_y",
                "watermark_size", 0, 13, 8, 48, "Текст")

    def hit_handle(self, x, y):
        if self.selected not in self.boxes:
            return False
        hx, hy = self.boxes[self.selected]["handle"]
        return math.hypot(x - hx, y - hy) <= dp(22)

    def hit_item(self, x, y):
        pad = dp(12)
        for kind in ("logo", "text"):
            info = self.boxes.get(kind)
            if info is None:
                continue
            rect = info["aabb"]
            if rect.left - pad <= x <= rect.right + pad and rect.top - pad <= y <= rect.bottom + pad:
                return kind
        return None

    def disallow(self, view, flag):
        parent = safe(view.getParent)
        if parent is not None:
            safe(lambda: parent.requestDisallowInterceptTouchEvent(flag))

    def draw(self, canvas, provider):
        w, h = canvas.getWidth(), canvas.getHeight()
        self.size = (w, h)
        self.boxes = {}
        Watermark(self.plugin.prefs, self.plugin.logo_image()).preview(canvas, provider, boxes=self.boxes)
        if self.selected not in self.boxes:
            self.selected = None
        accent = tcolor(Theme.key_featuredStickers_addButton, provider)
        if self.mode == "drag" and (self.snap_x or self.snap_y):
            guide = Paint(Paint.ANTI_ALIAS_FLAG)
            guide.setColor(jint(alpha(accent, 0.75)))
            guide.setStrokeWidth(float(max(1, dp(1))))
            if self.snap_x:
                canvas.drawLine(w / 2.0, 0.0, w / 2.0, float(h), guide)
            if self.snap_y:
                canvas.drawLine(0.0, h / 2.0, float(w), h / 2.0, guide)
        if self.selected in self.boxes:
            info = self.boxes[self.selected]
            rect = RectF(info["aabb"])
            pad = float(dp(4))
            rect.inset(-pad, -pad)
            frame = Paint(Paint.ANTI_ALIAS_FLAG)
            frame.setStyle(Paint.Style.STROKE)
            frame.setStrokeWidth(float(max(1, dp(1.5))))
            frame.setColor(jint(accent))
            canvas.drawRoundRect(rect, float(dp(8)), float(dp(8)), frame)
            hx, hy = info["handle"]
            hr = float(dp(8))
            dot_bg = Paint(Paint.ANTI_ALIAS_FLAG)
            dot_bg.setColor(jint(Color.WHITE))
            canvas.drawCircle(hx, hy, hr, dot_bg)
            dot_ring = Paint(Paint.ANTI_ALIAS_FLAG)
            dot_ring.setStyle(Paint.Style.STROKE)
            dot_ring.setStrokeWidth(float(dp(2)))
            dot_ring.setColor(jint(accent))
            canvas.drawCircle(hx, hy, hr, dot_ring)
            dot_in = Paint(Paint.ANTI_ALIAS_FLAG)
            dot_in.setColor(jint(accent))
            canvas.drawCircle(hx, hy, float(dp(2.5)), dot_in)
        if self.mode in ("resize", "pinch") and self.badge:
            pill = Paint(Paint.ANTI_ALIAS_FLAG)
            pill.setColor(jint(Color.argb(0xC0, 0, 0, 0)))
            txt = Paint(Paint.ANTI_ALIAS_FLAG)
            txt.setTextSize(float(dp(11)))
            txt.setTypeface(AndroidUtilities.getTypeface("fonts/rmedium.ttf"))
            txt.setColor(jint(Color.WHITE))
            tw = int(txt.measureText(self.badge) + 0.999)
            pw, ph = tw + dp(18), dp(22)
            pl, pt = (w - pw) // 2, dp(8)
            canvas.drawRoundRect(RectF(float(pl), float(pt), float(pl + pw), float(pt + ph)),
                                 float(dp(11)), float(dp(11)), pill)
            fm = txt.getFontMetrics()
            canvas.drawText(self.badge, float(pl + dp(9)), float(pt + ph / 2.0 - (fm.ascent + fm.descent) / 2.0), txt)

    def touch(self, view, event):
        action = event.getActionMasked()
        x, y = float(event.getX()), float(event.getY())
        if action == MotionEvent.ACTION_DOWN:
            self.snap_x = self.snap_y = False
            self.badge = ""
            if self.hit_handle(x, y):
                info = self.boxes[self.selected]
                cx, cy = info["aabb"].centerX(), info["aabb"].centerY()
                _, _, _, size_k, _, def_s, low, high, name = self.keys(self.selected)
                start_size = self.plugin.prefs.num(size_k, def_s, low, high)
                start_d = max(float(dp(12)), math.hypot(x - cx, y - cy))
                self.mode = "resize"
                self.start = (cx, cy, start_d, start_size)
                self.badge = f"{name}: {start_size} dp"
                self.disallow(view, True)
                haptic(view)
                view.invalidate()
                return True
            hit = self.hit_item(x, y)
            if hit is not None:
                self.selected = hit
                info = self.boxes[hit]
                self.mode = "drag"
                self.start = (x - info["aabb"].centerX(), y - info["aabb"].centerY())
                self.disallow(view, True)
                haptic(view)
                view.invalidate()
                return True
            if self.selected is not None:
                self.selected = None
                view.invalidate()
            self.mode = None
            return False
        if action == MotionEvent.ACTION_POINTER_DOWN and event.getPointerCount() >= 2:
            target = self.selected if self.selected in self.boxes else (
                "text" if "text" in self.boxes else ("logo" if "logo" in self.boxes else None))
            if target is not None:
                self.selected = target
                _, _, _, size_k, _, def_s, low, high, name = self.keys(target)
                start_size = self.plugin.prefs.num(size_k, def_s, low, high)
                dist = max(float(dp(16)), math.hypot(event.getX(1) - event.getX(0), event.getY(1) - event.getY(0)))
                self.mode = "pinch"
                self.start = (dist, start_size)
                self.badge = f"{name}: {start_size} dp"
                self.disallow(view, True)
                view.invalidate()
                return True
        if action == MotionEvent.ACTION_MOVE and self.mode is not None and self.selected in self.boxes:
            if self.mode == "pinch" and event.getPointerCount() >= 2:
                dist = max(float(dp(8)), math.hypot(event.getX(1) - event.getX(0), event.getY(1) - event.getY(0)))
                start_d, start_size = self.start
                _, _, _, size_k, _, _, low, high, name = self.keys(self.selected)
                val = max(low, min(high, int(round(start_size * (dist / start_d)))))
                self.plugin.prefs.live[size_k] = val
                self.badge = f"{name}: {val} dp"
                self.plugin.sync_slider(size_k, val)
                view.invalidate()
                return True
            if self.mode == "resize":
                cx, cy, start_d, start_size = self.start
                cur_d = max(float(dp(6)), math.hypot(x - cx, y - cy))
                _, _, _, size_k, _, _, low, high, name = self.keys(self.selected)
                val = max(low, min(high, int(round(start_size * (cur_d / start_d)))))
                self.plugin.prefs.live[size_k] = val
                self.badge = f"{name}: {val} dp"
                self.plugin.sync_slider(size_k, val)
                view.invalidate()
                return True
            if self.mode == "drag":
                ox, oy = self.start
                cx, cy = x - ox, y - oy
                w, h = self.size
                info = self.boxes[self.selected]
                span_w, span_h = info["aabb"].width(), info["aabb"].height()
                pad = float(dp(self.plugin.prefs.num("watermark_padding", 12, 0, 64)))
                avail_w, avail_h = max(1.0, w - pad * 2 - span_w), max(1.0, h - pad * 2 - span_h)
                nx = max(0.0, min(1.0, (cx - span_w / 2.0 - pad) / avail_w))
                ny = max(0.0, min(1.0, (cy - span_h / 2.0 - pad) / avail_h))
                sx = abs(nx - 0.5) * avail_w < dp(6)
                sy = abs(ny - 0.5) * avail_h < dp(6)
                if (sx and not self.snap_x) or (sy and not self.snap_y):
                    haptic(view)
                self.snap_x, self.snap_y = sx, sy
                if sx:
                    nx = 0.5
                if sy:
                    ny = 0.5
                pos_k, x_k, y_k, _, _, _, _, _, _ = self.keys(self.selected)
                self.plugin.prefs.live[pos_k] = 5
                self.plugin.prefs.live[x_k] = nx
                self.plugin.prefs.live[y_k] = ny
                view.invalidate()
                return True
        if action == MotionEvent.ACTION_POINTER_UP and self.mode == "pinch" and event.getPointerCount() <= 2:
            self.finish(view)
            return True
        if action in (MotionEvent.ACTION_UP, MotionEvent.ACTION_CANCEL) and self.mode is not None:
            self.finish(view)
            return True
        return False

    def finish(self, view):
        mode, kind = self.mode, self.selected
        self.mode = None
        self.snap_x = self.snap_y = False
        self.badge = ""
        self.disallow(view, False)
        if kind is not None:
            pos_k, x_k, y_k, size_k, def_p, _, _, _, _ = self.keys(kind)
            prefs = self.plugin.prefs
            if mode == "drag":
                nx = prefs.live.pop(x_k, None)
                ny = prefs.live.pop(y_k, None)
                prefs.live.pop(pos_k, None)
                if nx is not None and ny is not None:
                    self.plugin.set_setting(x_k, f"{nx:.4f}")
                    self.plugin.set_setting(y_k, f"{ny:.4f}")
                    prev = safe(lambda: int(self.plugin.get_setting(pos_k, def_p)), def_p)
                    self.plugin.set_setting(pos_k, 5, reload_settings=(prev != 5))
            elif mode in ("resize", "pinch"):
                val = prefs.live.pop(size_k, None)
                if val is not None:
                    self.plugin.set_setting(size_k, str(val))
        view.invalidate()


class Prefs:
    def __init__(self, plugin):
        self.plugin = plugin
        self.live = {}

    def flag(self, key, default=False):
        return bool(self.plugin.get_setting(key, default))

    def choice(self, key):
        value = self.live.get(key)
        if value is None:
            value = safe(lambda: int(self.plugin.get_setting(key, 0)), 0)
        return value

    def ratio(self, key):
        value = self.live.get(key)
        if value is None:
            raw = str(self.plugin.get_setting(key, "") or "").strip()
            if not raw:
                return None
            value = safe(lambda: float(raw))
        return None if value is None else max(0.0, min(1.0, float(value)))

    def num(self, key, default, low, high):
        value = self.live.get(key)
        if value is None:
            value = safe(lambda: int(float(str(self.plugin.get_setting(key, str(default))).strip())), default)
        return max(low, min(high, value))

    def text(self, key, default):
        return str(self.plugin.get_setting(key, default) or "").strip() or default

    def hex(self, key, default):
        value = self.text(key, default)
        if not value.startswith("#"):
            value = "#" + value
        if len(value) == 7:
            value = "#FF" + value[1:]
        return value.upper() if safe(lambda: Color.parseColor(value) is not None, False) else default

    def color(self, key, default):
        return Color.parseColor(self.hex(key, default))

    def format(self):
        return FORMATS[1] if self.choice("output_format") == 1 else FORMATS[0]

    def mask_cfg(self):
        return MaskCfg(
            self.num("anon_blur_radius", 50, 10, 100),
            self.num("anon_blur_dim", 0, 0, 80),
            self.num("anon_pixel_size", 6, 2, 24),
            self.num("anon_spoiler_density", 100, 20, 200),
            self.num("anon_spoiler_size", 100, 50, 250),
        )

    def mask_state(self):
        return mask_key(self.choice("anonymize_style"), self.mask_cfg())

    def options(self, logo, sticker=False):
        flag = self.flag
        nick = flag("anonymize_nickname")
        return SimpleNamespace(
            sticker=sticker,
            transparent=sticker and flag("transparent_sticker", True),
            anon_nick=nick,
            anon_avatar=flag("anonymize_avatar"),
            anon_usernames=flag("anonymize_usernames"),
            style=self.choice("anonymize_style"),
            mask=self.mask_cfg(),
            fake_name=self.text("anonymize_fake_text", "Аноним") if nick and flag("anonymize_fake_name") else "",
            hide_time=flag("hide_time"),
            hide_status=flag("hide_status"),
            hide_reactions=flag("hide_reactions"),
            hide_media=flag("hide_media"),
            bg_type=self.choice("bg_type"),
            bg_color=self.color("bg_color", "#FF000000"),
            padding=self.num("image_padding", 16, 0, 48),
            scale={1: 1.5, 2: 2.0}.get(self.choice("render_scale"), 1.0),
            fmt=self.format(),
            quality=self.num("jpeg_quality", 92, 40, 100),
            corner=self.num("corner_radius", 0, 0, 48),
            watermark=Watermark(self, logo),
        )


class EffectPanel:
    def __init__(self, plugin, ctx, provider, ink, surface, on_style, on_param, on_layout=None):
        self.plugin = plugin
        self.ctx = ctx
        self.provider = provider
        self.ink = ink
        self.surface = surface
        self.on_style = on_style
        self.on_param = on_param
        self.on_layout = on_layout
        self.root = self.sliders_box = None
        self.style_views = []
        self.slider_rows = {}
        self.delegates = []
        self.hold_seek = HoldSeek()
        self.built_style = None

    def color(self, key):
        return tcolor(key, self.provider)

    def ripple(self, fill, radius):
        return pressable(fill, radius, alpha(self.color(Theme.key_listSelector), 0.2))

    def build(self):
        ctx = self.ctx
        card = linear(ctx, vertical=True, gravity=Gravity.NO_GRAVITY)
        card.setPadding(dp(10), dp(8), dp(10), dp(8))
        card.setBackground(rounded(self.surface, 14, alpha(self.ink, 0.08)))

        scroller = HorizontalScrollView(ctx)
        scroller.setHorizontalScrollBarEnabled(False)
        scroller.setHorizontalFadingEdgeEnabled(True)
        scroller.setFadingEdgeLength(dp(14))
        scroller.setOverScrollMode(View.OVER_SCROLL_NEVER)
        row = linear(ctx, gravity=Gravity.CENTER_VERTICAL)

        self.style_views = []
        for idx, title in enumerate(ANON_STYLES):
            pill = linear(ctx, gravity=Gravity.CENTER_VERTICAL)
            pill.setPadding(dp(10), dp(5), dp(11), dp(5))
            pill.setMinimumHeight(dp(30))
            pill.setClickable(True)
            pill.setFocusable(True)
            pill.setContentDescription(title)
            pill.setOnClickListener(OnClickListener(lambda v, idx=idx: self.pick_style(idx, v)))
            safe(lambda p=pill: ScaleStateListAnimator.apply(p, 0.05, 1.5))

            icon = ImageView(ctx)
            icon.setScaleType(ImageView.ScaleType.CENTER_INSIDE)
            res = style_icon(idx)
            if res:
                icon.setImageResource(res)
            pill.addView(icon, LayoutHelper.createLinear(15, 15, Gravity.CENTER_VERTICAL, 0, 0, 5, 0))
            cap = label(ctx, title, 12.5, self.ink, bold=True)
            pill.addView(cap, LayoutHelper.createLinear(-2, -2, Gravity.CENTER_VERTICAL))

            params = LinearLayout.LayoutParams(-2, -2)
            if idx:
                params.leftMargin = dp(6)
            row.addView(pill, params)
            self.style_views.append((pill, icon, cap))

        scroller.addView(row, LayoutHelper.createFrame(-2, -2))
        card.addView(scroller, LayoutHelper.createLinear(-1, -2))

        sliders_box = linear(ctx, vertical=True, gravity=Gravity.NO_GRAVITY)
        self.sliders_box = sliders_box
        card.addView(sliders_box, LayoutHelper.createLinear(-1, -2))

        self.root = card
        self.sync(force=True)
        return card

    def pick_style(self, idx, view):
        haptic(view)
        if self.on_style is not None:
            self.on_style(idx)

    def build_sliders(self, style):
        box_view = self.sliders_box
        if box_view is None:
            return
        box_view.removeAllViews()
        self.slider_rows.clear()
        self.delegates.clear()
        specs = EFFECT_PARAMS.get(style, ())
        if not specs:
            box_view.setVisibility(View.GONE)
            return
        box_view.setVisibility(View.VISIBLE)
        ctx, prefs = self.ctx, self.plugin.prefs
        accent = self.color(Theme.key_featuredStickers_addButton)
        accent_text = self.color(Theme.key_windowBackgroundWhiteBlueText)
        track = alpha(self.ink, 0.16)
        title_ink = alpha(self.ink, 0.78)
        for idx, (key, title, default, low, high, suffix) in enumerate(specs):
            wrap = linear(ctx, vertical=True, gravity=Gravity.NO_GRAVITY)
            head = linear(ctx, gravity=Gravity.CENTER_VERTICAL)
            head.setPadding(dp(4), 0, dp(4), 0)
            head.addView(label(ctx, title, 12.5, title_ink), LinearLayout.LayoutParams(0, -2, 1.0))

            cur = prefs.num(key, default, low, high)
            val_view = label(ctx, param_text(cur, suffix), 11.5, accent_text, bold=True)
            val_view.setBackground(rounded(alpha(accent_text, 0.12), 7))
            val_view.setPadding(dp(6), dp(2), dp(6), dp(2))
            val_view.setMinWidth(dp(42))
            val_view.setGravity(Gravity.CENTER)
            safe(lambda v=val_view: v.setFontFeatureSettings("tnum"))
            head.addView(val_view, LayoutHelper.createLinear(-2, -2, Gravity.CENTER_VERTICAL, 8, 0, 0, 0))
            wrap.addView(head, LayoutHelper.createLinear(-1, -2))

            seek = SeekBarView(ctx, self.provider)
            seek.setReportChanges(True)
            safe(lambda s=seek: s.setColors(track, accent))
            seek.setOnTouchListener(self.hold_seek)
            seek.setProgress(float(cur - low) / (high - low))

            last = [cur]

            def make_handlers(k=key, t=title, d=default, lo=low, hi=high, suf=suffix, vv=val_view, lst=last):
                def on_drag(stop, progress):
                    val = max(lo, min(hi, int(round(lo + (hi - lo) * progress))))
                    vv.setText(param_text(val, suf))
                    if stop:
                        prefs.live.pop(k, None)
                        self.plugin.set_setting(k, str(val))
                        lst[0] = val
                        if self.on_param is not None:
                            self.on_param(k, val, True)
                    elif val != lst[0]:
                        lst[0] = val
                        prefs.live[k] = val
                        if self.on_param is not None:
                            self.on_param(k, val, False)

                def on_release():
                    val = prefs.live.pop(k, None)
                    if val is not None:
                        self.plugin.set_setting(k, str(val))
                        lst[0] = val
                        if self.on_param is not None:
                            self.on_param(k, val, True)

                return on_drag, on_release, lambda: f"{t}: {param_text(prefs.num(k, d, lo, hi), suf)}"

            on_drag, on_release, desc = make_handlers()
            delegate = Slider(on_drag, on_release, desc, high - low)
            self.delegates.append(delegate)
            seek.setDelegate(delegate)
            wrap.addView(seek, LayoutHelper.createLinear(-1, 30))
            box_view.addView(wrap, LayoutHelper.createLinear(-1, -2, 0, 4 if idx else 7, 0, 0))
            self.slider_rows[key] = (val_view, seek, default, low, high, suffix, last)

    def sync(self, force=False):
        if self.root is None:
            return
        prefs = self.plugin.prefs
        style = prefs.choice("anonymize_style")
        accent = self.color(Theme.key_featuredStickers_addButton)
        accent_ink = self.color(Theme.key_featuredStickers_buttonText)
        idle_fill = alpha(self.ink, 0.06)
        idle_ink = alpha(self.ink, 0.78)
        for idx, (pill, icon, cap) in enumerate(self.style_views):
            on = idx == style
            fill = accent if on else idle_fill
            fg = accent_ink if on else idle_ink
            pill.setBackground(self.ripple(fill, 15))
            icon.setColorFilter(fg)
            cap.setTextColor(fg)
        if force or self.built_style != style:
            prev = self.built_style
            self.built_style = style
            self.build_sliders(style)
            if not force and prev is not None and self.on_layout is not None:
                safe(self.on_layout)
        else:
            for key, (val_view, seek, default, low, high, suffix, last) in self.slider_rows.items():
                val = prefs.num(key, default, low, high)
                val_view.setText(param_text(val, suffix))
                if key not in prefs.live:
                    last[0] = val
                    safe(lambda s=seek, p=float(val - low) / (high - low): s.setProgress(p))

    def destroy(self):
        prefs = self.plugin.prefs
        for specs in EFFECT_PARAMS.values():
            for key, *_ in specs:
                val = prefs.live.pop(key, None)
                if val is not None:
                    self.plugin.set_setting(key, str(val))
        self.delegates.clear()
        self.slider_rows.clear()
        self.style_views.clear()
        self.hold_seek = None
        self.root = self.sliders_box = None
        self.built_style = None


class RedactPane:
    def __init__(self, plugin, chat, msgs, redactions, sheet, on_done, initial=False, start_height=0,
                 need_preload=False, on_preloaded=None):
        self.plugin, self.chat, self.msgs = plugin, chat, msgs
        self.red = redactions.copy()
        self.sheet = sheet
        self.on_done = on_done
        self.initial = initial
        self.start_height = start_height
        self.need_preload = need_preload
        self.on_preloaded = on_preloaded
        self.activity = chat.getParentActivity()
        self.provider = chat.getResourceProvider()
        self.root = self.shell = self.scroller = self.holder = self.canvas_view = self.spinner = None
        self.sub = self.back_btn = self.reset_btn = self.done_btn = self.drawer = self.hold = None
        self.fx_panel = None
        self.base_bmp = self.disp_bmp = self.disp_canvas = self.copy_paint = self.checker_bmp = None
        self.geoms = []
        self.geom_map = {}
        self.sel_text = None
        self.sel_msg = None
        self.handles = None
        self.popup = self.popup_layout = self.popup_anchor = self.scroll_sync = None
        self.sel_t0 = 0
        self.msg_t0 = 0
        self.anim_rects = None
        self.anim_ts = 0
        self.drag_mode = None
        self.down_pos = None
        self.last_off = None
        self.lp_token = 0
        self.lp_fired = False
        self.last_rebuild = 0
        self.rebuild_pending = False
        self.scale = 1.0
        self.busy = True
        self.closed = False
        self.done_called = False
        self.gen = 0
        self.ink = self.color(Theme.key_dialogTextBlack)
        self.surface = alpha(self.ink, 0.05 if AndroidUtilities.isDarkColor(self.ink) else 0.08)

    def color(self, key):
        return tcolor(key, self.provider)

    def ripple(self, fill, radius):
        return pressable(fill, radius, alpha(self.color(Theme.key_listSelector), 0.2))

    def finish(self, apply):
        if self.done_called:
            return
        self.done_called = True
        if self.on_done is not None:
            safe(lambda: self.on_done(self.red if apply else None))

    def destroy(self):
        if self.closed:
            return
        self.closed = True
        self.gen += 1
        self.lp_token += 1
        self.rebuild_pending = False
        self.hide_popup(False)
        if self.fx_panel is not None:
            self.fx_panel.destroy()
            self.fx_panel = None
        if self.scroller is not None:
            safe(lambda: self.scroller.setOnScrollChangeListener(None))
            safe(lambda: self.scroller.setBackground(None))
        self.root = self.sheet = self.shell = self.scroller = self.holder = self.canvas_view = self.spinner = None
        self.sub = self.back_btn = self.reset_btn = self.done_btn = self.drawer = self.hold = self.scroll_sync = None
        self.geoms = []
        self.geom_map.clear()
        self.anim_rects = None
        self.disp_canvas = self.copy_paint = None
        for attr in ("disp_bmp", "base_bmp", "checker_bmp"):
            bmp = getattr(self, attr)
            if bmp is not None:
                safe(bmp.recycle)
                setattr(self, attr, None)

    def build(self):
        ctx = self.activity
        root = linear(ctx, vertical=True, gravity=Gravity.CENTER_HORIZONTAL)
        root.setPadding(dp(12), dp(2), dp(12), dp(12))

        header = linear(ctx, gravity=Gravity.CENTER_VERTICAL)
        header.setPadding(dp(2), 0, dp(2), dp(8))
        back_ico = icon_res("ic_ab_back", "msg_arrow_back")
        if not self.initial and back_ico:
            back = FrameLayout(ctx)
            back.setBackground(Theme.createSelectorDrawable(alpha(self.color(Theme.key_listSelector), 0.22), 1))
            back.setClickable(True)
            back.setFocusable(True)
            back.setContentDescription("Назад")
            back.setOnClickListener(OnClickListener(self.on_back))
            safe(lambda: ScaleStateListAnimator.apply(back, 0.06, 1.5))
            b_iv = ImageView(ctx)
            b_iv.setScaleType(ImageView.ScaleType.CENTER_INSIDE)
            b_iv.setImageResource(back_ico)
            b_iv.setColorFilter(self.ink)
            back.addView(b_iv, LayoutHelper.createFrame(22, 22, Gravity.CENTER))
            self.back_btn = back
            header.addView(back, LayoutHelper.createLinear(34, 34, Gravity.CENTER_VERTICAL, 0, 0, 4, 0))

        titles = linear(ctx, vertical=True, gravity=Gravity.NO_GRAVITY)
        titles.addView(label(ctx, "Скрытие фрагментов", 16, self.ink, bold=True), LayoutHelper.createLinear(-1, -2))
        self.sub = label(ctx, "Нажмите на текст или сообщение", 12, alpha(self.ink, 0.55))
        titles.addView(self.sub, LayoutHelper.createLinear(-1, -2, 0, 2, 0, 0))
        header.addView(titles, LinearLayout.LayoutParams(0, -2, 1.0))

        reset = label(ctx, "Сбросить", 13, self.color(Theme.key_text_RedRegular), bold=True)
        reset.setPadding(dp(8), dp(6), dp(8), dp(6))
        reset.setBackground(self.ripple(alpha(self.color(Theme.key_text_RedRegular), 0.10), 14))
        reset.setClickable(True)
        reset.setFocusable(True)
        reset.setOnClickListener(OnClickListener(self.on_reset))
        safe(lambda: ScaleStateListAnimator.apply(reset, 0.05, 1.5))
        self.reset_btn = reset
        header.addView(reset, LayoutHelper.createLinear(-2, -2, Gravity.CENTER_VERTICAL, 6, 0, 0, 0))

        done_ink = self.color(Theme.key_featuredStickers_buttonText)
        done = label(ctx, "Готово", 13, done_ink, bold=True)
        done.setPadding(dp(12), dp(7), dp(12), dp(7))
        done.setBackground(self.ripple(self.color(Theme.key_featuredStickers_addButton), 16))
        done.setClickable(True)
        done.setFocusable(True)
        done.setOnClickListener(OnClickListener(self.on_confirm))
        safe(lambda: ScaleStateListAnimator.apply(done, 0.05, 1.5))
        self.done_btn = done
        header.addView(done, LayoutHelper.createLinear(-2, -2, Gravity.CENTER_VERTICAL, 6, 0, 0, 0))
        root.addView(header, LayoutHelper.createLinear(-1, -2))

        shell = FrameLayout(ctx)
        shell.setBackground(rounded(self.surface, 14))
        shell.setClipToOutline(True)
        self.shell = shell

        scroller = ScrollView(ctx)
        scroller.setVerticalScrollBarEnabled(True)
        scroller.setScrollBarStyle(View.SCROLLBARS_INSIDE_OVERLAY)
        scroller.setVerticalFadingEdgeEnabled(True)
        scroller.setFadingEdgeLength(dp(20))
        scroller.setOverScrollMode(View.OVER_SCROLL_NEVER)
        if self.plugin.prefs.choice("bg_type") == 1:
            bg, tile = checker(ctx, self.ink)
            self.checker_bmp = tile
            scroller.setBackground(bg)

        self.drawer = Drawer(self.on_draw, self.on_touch)
        view = UniversalView(ctx, self.drawer)
        view.setWillNotDraw(False)
        view.setClickable(True)
        view.setMinimumHeight(dp(220))
        self.canvas_view = view
        holder = FrameLayout(ctx)
        holder.addView(view, FrameLayout.LayoutParams(-1, dp(220), Gravity.TOP))
        self.holder = holder
        scroller.addView(holder, FrameLayout.LayoutParams(-1, dp(220)))
        self.scroll_sync = ScrollSync(self.sync_popup)
        safe(lambda: scroller.setOnScrollChangeListener(self.scroll_sync))
        self.scroller = scroller
        shell.addView(scroller, LayoutHelper.createFrame(-1, -1))

        border = View(ctx)
        border.setBackground(rounded(0, 14, alpha(self.ink, 0.10)))
        border.setImportantForAccessibility(View.IMPORTANT_FOR_ACCESSIBILITY_NO)
        shell.addView(border, LayoutHelper.createFrame(-1, -1))

        spinner = FrameLayout(ctx)
        spinner.setBackgroundColor(alpha(self.color(Theme.key_dialogBackground), 0.55))
        spinner.setClickable(True)
        progress = RadialProgressView(ctx, self.provider)
        progress.setSize(dp(28))
        progress.setProgressColor(self.color(Theme.key_featuredStickers_addButton))
        spinner.addView(progress, LayoutHelper.createFrame(40, 40, Gravity.CENTER))
        self.spinner = spinner
        shell.addView(spinner, LayoutHelper.createFrame(-1, -1, Gravity.CENTER))

        self.fx_panel = EffectPanel(
            self.plugin, ctx, self.provider, self.ink, self.surface,
            self.pick_style, self.on_fx_param, self.on_fx_layout,
        )
        fx_view = self.fx_panel.build()

        self.root = root
        cap = self.max_height()
        init_h = min(cap, max(dp(180), self.start_height)) if self.start_height > 0 else min(dp(300), cap)
        root.addView(shell, LinearLayout.LayoutParams(-1, init_h))
        root.addView(fx_view, LayoutHelper.createLinear(-1, -2, 0, 10, 0, 0))
        self.sync_ui()
        return root

    def pick_style(self, idx):
        self.hide_popup(True)
        self.plugin.set_setting("anonymize_style", idx)
        self.sync_ui()
        self.rebuild()

    def on_fx_param(self, key, val, done):
        self.schedule_rebuild(immediate=done)

    def on_fx_layout(self):
        self.fit()

    def schedule_rebuild(self, immediate=False):
        if self.closed or self.base_bmp is None:
            return
        now = int(SystemClock.uptimeMillis())
        if immediate or now - self.last_rebuild >= 16:
            self.rebuild_pending = False
            self.rebuild()
        elif not self.rebuild_pending:
            self.rebuild_pending = True
            run_on_ui_thread(self.flush_rebuild, 16)

    def flush_rebuild(self):
        if self.closed or not self.rebuild_pending:
            return
        self.rebuild_pending = False
        self.rebuild()

    def on_reset(self, view):
        haptic(view)
        self.hide_popup(True)
        self.red.clear()
        self.sel_text = None
        self.sel_msg = None
        self.anim_rects = None
        self.sync_ui()
        self.rebuild()

    def on_back(self, view):
        haptic(view)
        self.hide_popup(False)
        self.finish(False)

    def on_confirm(self, view):
        haptic(view)
        self.hide_popup(False)
        self.finish(True)

    def sync_ui(self):
        if self.fx_panel is not None:
            self.fx_panel.sync()
        count = self.red.count()
        if self.sub is not None:
            if self.busy:
                self.sub.setText("Подготовка фрагмента...")
            elif count:
                self.sub.setText(f"Скрыто: {count} · нажмите на текст или блок")
            else:
                self.sub.setText("Нажмите на слово для выбора · тяните маркеры")
        if self.reset_btn is not None:
            self.reset_btn.setVisibility(View.VISIBLE if count and not self.busy else View.GONE)
        if self.spinner is not None:
            self.spinner.setVisibility(View.VISIBLE if self.busy else View.GONE)

    def load(self):
        self.gen += 1
        token = self.gen
        self.busy = True
        self.sync_ui()

        def task():
            bmp = geoms = error = None
            try:
                need = self.need_preload and not self.plugin.prefs.flag("hide_media")
                bmp, geoms = self.plugin.render_editor(self.msgs, self.chat, need_preload=need)
                if need:
                    self.need_preload = False
                    if self.on_preloaded is not None:
                        safe(self.on_preloaded)
                if bmp is None:
                    error = "не удалось подготовить фрагмент"
            except Exception as e:
                warn("editor render", traceback.format_exc())
                error = str(e)
            run_on_ui_thread(lambda: self.on_loaded(bmp, geoms or [], error, token))

        run_on_queue(task, PLUGINS_QUEUE)

    def on_loaded(self, bmp, geoms, error, token):
        if self.closed or self.sheet is None or token != self.gen:
            if bmp is not None:
                safe(bmp.recycle)
            return
        self.busy = False
        if error or bmp is None:
            if bmp is not None:
                safe(bmp.recycle)
            BulletinHelper.show_error(f"Ошибка редактора: {(error or '')[:80]}")
            self.finish(False)
            return
        old = self.base_bmp
        self.base_bmp = bmp
        if old is not None:
            safe(old.recycle)
        self.geoms = geoms
        self.geom_map = {g.key: g for g in geoms}
        self.sync_ui()
        self.rebuild()
        self.fit()

    def panel_height(self):
        panel = self.fx_panel.root if self.fx_panel is not None else None
        if panel is None or panel.getVisibility() != View.VISIBLE:
            return 0
        width = (self.root.getWidth() - dp(24)) if (self.root is not None and self.root.getWidth() > dp(24)) else (AndroidUtilities.displaySize.x - dp(24))
        panel.measure(View.MeasureSpec.makeMeasureSpec(max(1, width), EXACTLY), View.MeasureSpec.makeMeasureSpec(0, UNSPECIFIED))
        return panel.getMeasuredHeight() + dp(10)

    def max_height(self):
        sheet, shell = self.sheet, self.shell
        extra = self.panel_height()
        cont = safe(sheet.getContainer) if sheet is not None else None
        cview = safe(sheet.getContainerView) if sheet is not None else None
        ch = cont.getHeight() if cont is not None else 0
        if ch > 0 and shell is not None and shell.getTop() > 0:
            status_h = int(safe(sheet.getStatusBarHeight, AndroidUtilities.statusBarHeight) or AndroidUtilities.statusBarHeight)
            bot_pad = int(safe(sheet.getBottomInset, 0) or 0)
            top_off = 0
            cur = shell
            while isinstance(cur, View) and cur != cview:
                top_off += cur.getTop()
                cur = safe(cur.getParent)
            cv_bot = cview.getPaddingBottom() if cview is not None else dp(12)
            root_bot = self.root.getPaddingBottom() if self.root is not None else dp(12)
            return max(dp(150), ch - status_h - dp(12) - bot_pad - top_off - root_bot - cv_bot - extra)
        disp_y = int(AndroidUtilities.displaySize.y)
        return max(dp(150), disp_y - dp(168) - extra)

    def fit(self):
        shell, view, holder, scroller, bmp = self.shell, self.canvas_view, self.holder, self.scroller, self.base_bmp
        if self.closed or shell is None or view is None or holder is None or scroller is None or bmp is None:
            return
        width = scroller.getWidth() or shell.getWidth() or AndroidUtilities.displaySize.x - dp(40)
        bw, bh = max(1, bmp.getWidth()), max(1, bmp.getHeight())
        vh = max(dp(120), int(math.ceil(width * bh / float(bw))))
        view.setMinimumHeight(vh)
        vp = view.getLayoutParams()
        vp.width = -1
        vp.height = vh
        view.setLayoutParams(vp)
        hp = holder.getLayoutParams()
        hp.width = -1
        hp.height = vh
        holder.setLayoutParams(hp)
        shp = shell.getLayoutParams()
        target_h = min(vh, self.max_height())
        if shp.height != target_h:
            if self.sheet is not None:
                safe(self.sheet.smoothContainerViewLayout)
            shp.height = target_h
            shell.setLayoutParams(shp)
        view.requestLayout()
        holder.requestLayout()
        scroller.requestLayout()
        shell.requestLayout()
        view.invalidate()
        if scroller.getWidth() == 0 or shell.getTop() == 0:
            run_on_ui_thread(self.fit, 60)

    def rebuild(self):
        base = self.base_bmp
        if base is None:
            return
        self.last_rebuild = int(SystemClock.uptimeMillis())
        bw, bh = base.getWidth(), base.getHeight()
        disp = self.disp_bmp
        if disp is None or disp.isRecycled() or disp.getWidth() != bw or disp.getHeight() != bh:
            if disp is not None:
                safe(disp.recycle)
            disp = new_bitmap(bw, bh)
            self.disp_bmp = disp
            self.disp_canvas = Canvas(disp)
        if self.copy_paint is None:
            paint = Paint()
            paint.setXfermode(PorterDuffXfermode(PorterDuff.Mode.SRC))
            self.copy_paint = paint
        canvas = self.disp_canvas
        canvas.drawBitmap(base, 0.0, 0.0, self.copy_paint)
        style = self.plugin.prefs.choice("anonymize_style")
        cfg = self.plugin.prefs.mask_cfg()
        for g in self.geoms:
            if g.key in self.red.hidden_msgs:
                if g.bubble:
                    draw_mask(canvas, disp, g.bubble, style, g.ink, radius=bubble_rad(), shape=g.shape, cfg=cfg)
            else:
                for src, start, end in self.red.spans.get(g.key, ()):
                    for bounds in geom_span_boxes(g.lines, src, start, end, pad=dp(2)):
                        draw_mask(canvas, disp, bounds, style, g.ink, cfg=cfg)
        if self.canvas_view is not None:
            self.canvas_view.invalidate()

    def msg_path(self, g, s):
        if g.shape is not None:
            return scale_path(g.shape, s)
        box_s = (g.bubble[0] * s, g.bubble[1] * s, g.bubble[2] * s, g.bubble[3] * s)
        rad = min(float(dp(16)), (box_s[3] - box_s[1]) / 2.0) if g.action else float(bubble_rad()) * s
        return round_path(box_s, rad)

    def disallow(self, view, flag):
        parent = safe(view.getParent)
        while parent is not None:
            safe(lambda p=parent: p.requestDisallowInterceptTouchEvent(flag))
            parent = safe(parent.getParent)

    def sel_rects(self, s):
        if self.sel_text is None:
            return []
        mkey, source, start, end, _ = self.sel_text
        g = self.geom_map.get(mkey)
        if g is None:
            return []
        rects = []
        for line in g.lines:
            if line.source != source:
                continue
            ls, le = max(start, line.start), min(end, line.end)
            if le <= ls:
                continue
            x1, x2 = line.xs[ls - line.start], line.xs[le - line.start]
            left, right = sorted((x1, x2))
            rects.append(RectF(left * s, line.top * s, right * s, line.bottom * s))
        return rects

    def on_draw(self, canvas):
        try:
            self.draw_content(canvas)
        except Exception:
            warn("redact draw", traceback.format_exc())

    def draw_content(self, canvas):
        bmp, view = self.disp_bmp, self.canvas_view
        if bmp is None or view is None:
            return
        vw, vh = view.getWidth(), view.getHeight()
        if vw <= 0 or vh <= 0:
            return
        bw, bh = max(1, bmp.getWidth()), max(1, bmp.getHeight())
        s = vw / float(bw)
        self.scale = s
        want_h = max(dp(120), int(math.ceil(bh * s)))
        if abs(vh - want_h) > 2:
            run_on_ui_thread(self.fit)
        paint = Paint(Paint.ANTI_ALIAS_FLAG)
        paint.setFilterBitmap(True)
        canvas.drawBitmap(bmp, Rect(0, 0, bw, bh), RectF(0.0, 0.0, float(vw), float(bh * s)), paint)

        accent = self.color(Theme.key_featuredStickers_addButton)
        red_ink = self.color(Theme.key_text_RedRegular)
        style = self.plugin.prefs.choice("anonymize_style")

        if self.red.hidden_msgs:
            badge_bg = Paint(Paint.ANTI_ALIAS_FLAG)
            badge_bg.setColor(jint(Color.argb(0xB4, 18, 22, 34)))
            badge_ring = Paint(Paint.ANTI_ALIAS_FLAG)
            badge_ring.setStyle(Paint.Style.STROKE)
            badge_ring.setStrokeWidth(float(max(1, dp(0.8))))
            badge_ring.setColor(jint(Color.argb(0x2E, 255, 255, 255)))
            dash_hide = Paint(Paint.ANTI_ALIAS_FLAG)
            dash_hide.setStyle(Paint.Style.STROKE)
            dash_hide.setStrokeWidth(float(dp(1.25)))
            dash_hide.setPathEffect(DashPathEffect(jarray(jfloat)([float(dp(4)), float(dp(4))]), 0.0))
            hide_ico = style_icon(style)
            for g in self.geoms:
                if g.key in self.red.hidden_msgs and g.key not in self.red.excluded_msgs and g.bubble:
                    br = RectF(g.bubble[0] * s, g.bubble[1] * s, g.bubble[2] * s, g.bubble[3] * s)
                    if style == 4:
                        dash_hide.setColor(jint(Theme.multAlpha(g.ink if g.ink is not None else self.ink, 0.28)))
                        canvas.drawPath(self.msg_path(g, s), dash_hide)
                    if br.width() >= dp(28) and br.height() >= dp(24):
                        rad_b = float(dp(10))
                        bx = max(br.left + rad_b + dp(4), br.right - rad_b - dp(6))
                        by = min(br.bottom - rad_b - dp(4), br.top + rad_b + dp(6))
                        canvas.drawCircle(bx, by, rad_b, badge_bg)
                        canvas.drawCircle(bx, by, rad_b, badge_ring)
                        draw_icon(canvas, self.activity, hide_ico, bx, by, float(dp(12)), Color.WHITE)

        if self.red.excluded_msgs:
            dim = Paint(Paint.ANTI_ALIAS_FLAG)
            dim.setColor(jint(Color.argb(0xA4, 16, 20, 30)))
            dash = Paint(Paint.ANTI_ALIAS_FLAG)
            dash.setStyle(Paint.Style.STROKE)
            dash.setStrokeWidth(float(dp(1.5)))
            dash.setColor(jint(Color.argb(0x78, 255, 255, 255)))
            dash.setPathEffect(DashPathEffect(jarray(jfloat)([float(dp(5)), float(dp(4))]), 0.0))
            pill_bg = Paint(Paint.ANTI_ALIAS_FLAG)
            pill_bg.setColor(jint(Color.argb(0xDC, 20, 24, 36)))
            pill_ring = Paint(Paint.ANTI_ALIAS_FLAG)
            pill_ring.setStyle(Paint.Style.STROKE)
            pill_ring.setStrokeWidth(float(max(1, dp(0.8))))
            pill_ring.setColor(jint(Color.argb(0x28, 255, 255, 255)))
            txt = Paint(Paint.ANTI_ALIAS_FLAG)
            txt.setColor(jint(Color.WHITE))
            txt.setTextSize(float(dp(12)))
            txt.setTypeface(AndroidUtilities.getTypeface("fonts/rmedium.ttf"))
            fm = txt.getFontMetrics()
            label_s = "Убрано"
            lw = txt.measureText(label_s)
            del_ico = icon_res("msg_delete")
            ico_w = float(dp(14)) if del_ico else 0.0
            ico_gap = float(dp(5)) if del_ico else 0.0
            for g in self.geoms:
                if g.key in self.red.excluded_msgs and g.bubble:
                    br = RectF(g.bubble[0] * s, g.bubble[1] * s, g.bubble[2] * s, g.bubble[3] * s)
                    mp = self.msg_path(g, s)
                    canvas.drawPath(mp, dim)
                    canvas.drawPath(mp, dash)
                    pw, ph = lw + ico_w + ico_gap + dp(20), dp(26)
                    pl, pt = br.centerX() - pw / 2.0, br.centerY() - ph / 2.0
                    pr = RectF(pl, pt, pl + pw, pt + ph)
                    canvas.drawRoundRect(pr, float(dp(13)), float(dp(13)), pill_bg)
                    canvas.drawRoundRect(pr, float(dp(13)), float(dp(13)), pill_ring)
                    if del_ico:
                        draw_icon(canvas, self.activity, del_ico, pl + dp(10) + ico_w / 2.0, pt + ph / 2.0, ico_w, red_ink)
                    canvas.drawText(label_s, pl + dp(10) + ico_w + ico_gap, pt + ph / 2.0 - (fm.ascent + fm.descent) / 2.0, txt)

        self.handles = None
        now = int(SystemClock.uptimeMillis())
        dt = max(1, min(64, now - self.anim_ts)) if self.anim_ts else 16
        self.anim_ts = now
        need_anim = False

        if self.sel_text is not None:
            rects = self.sel_rects(s)
            if rects:
                g = self.geom_map.get(self.sel_text[0])
                out = bool(g.outgoing) if g is not None else False
                hl_key = Theme.key_chat_outTextSelectionHighlight if out else Theme.key_chat_inTextSelectionHighlight
                cur_key = Theme.key_chat_outTextSelectionCursor if out else Theme.key_chat_TextSelectionCursor
                hl_col = self.color(hl_key)
                if not (hl_col & 0xFF000000):
                    hl_col = Theme.multAlpha(accent, 0.28)
                cur_col = self.color(cur_key) or accent

                ep_raw = min(1.0, max(0.0, (now - self.sel_t0) / 220.0))
                hp_raw = min(1.0, max(0.0, (now - self.sel_t0) / 250.0))
                ep = float(CubicBezierInterpolator.EASE_OUT_QUINT.getInterpolation(ep_raw))
                hp = float(CubicBezierInterpolator.EASE_OUT_QUINT.getInterpolation(hp_raw))
                if ep_raw < 1.0 or hp_raw < 1.0:
                    need_anim = True

                drawn = []
                if self.anim_rects is not None and len(self.anim_rects) == len(rects):
                    k = 1.0 - math.exp(-dt / 28.0)
                    nxt = []
                    for (cl, cr), r in zip(self.anim_rects, rects):
                        nl = cl + (r.left - cl) * k
                        nr = cr + (r.right - cr) * k
                        if abs(nl - r.left) > 0.5 or abs(nr - r.right) > 0.5:
                            need_anim = True
                        else:
                            nl, nr = r.left, r.right
                        nxt.append((nl, nr))
                        drawn.append(RectF(nl, r.top, nr, r.bottom))
                    self.anim_rects = nxt
                else:
                    self.anim_rects = [(r.left, r.right) for r in rects]
                    drawn = rects

                cr_pad = float(dp(3))
                sel_path = Path()
                for r in drawn:
                    if ep < 1.0:
                        cx_r = (r.left + r.right) / 2.0
                        hw = (r.right - r.left) * (0.35 + 0.65 * ep) / 2.0
                        l_x, r_x = cx_r - hw, cx_r + hw
                    else:
                        l_x, r_x = r.left, r.right
                    sel_path.addRect(l_x - cr_pad, r.top - dp(1), r_x + cr_pad, r.bottom + dp(1), Path.Direction.CW)

                hi = Paint(Paint.ANTI_ALIAS_FLAG)
                hi.setColor(jint(Theme.multAlpha(hl_col, ep)))
                hi.setPathEffect(CornerPathEffect(float(dp(6))))
                canvas.drawPath(sel_path, hi)

                r0, rn = drawn[0], drawn[-1]
                hs = float(dp(22))
                cur = Paint(Paint.ANTI_ALIAS_FLAG)
                cur.setColor(jint(cur_col))
                sv = hp * (1.14 if self.drag_mode == "start" else 1.0)
                ev = hp * (1.14 if self.drag_mode == "end" else 1.0)

                canvas.save()
                canvas.translate(r0.left - hs, r0.bottom)
                canvas.scale(sv, sv, hs / 2.0, hs / 2.0)
                sp_l = Path()
                sp_l.addCircle(hs / 2.0, hs / 2.0, hs / 2.0, Path.Direction.CCW)
                sp_l.addRect(hs / 2.0, 0.0, hs, hs / 2.0, Path.Direction.CCW)
                canvas.drawPath(sp_l, cur)
                canvas.restore()

                canvas.save()
                canvas.translate(rn.right, rn.bottom)
                canvas.scale(ev, ev, hs / 2.0, hs / 2.0)
                sp_r = Path()
                sp_r.addCircle(hs / 2.0, hs / 2.0, hs / 2.0, Path.Direction.CCW)
                sp_r.addRect(0.0, 0.0, hs / 2.0, hs / 2.0, Path.Direction.CCW)
                canvas.drawPath(sp_r, cur)
                canvas.restore()

                self.handles = ((r0.left - hs / 2.0, r0.bottom + hs / 2.0),
                                (rn.right + hs / 2.0, rn.bottom + hs / 2.0))

        elif self.sel_msg is not None:
            g = self.geom_map.get(self.sel_msg)
            if g is not None and g.bubble:
                mp_raw = min(1.0, max(0.0, (now - self.msg_t0) / 200.0))
                mp_p = float(CubicBezierInterpolator.EASE_OUT_QUINT.getInterpolation(mp_raw))
                if mp_raw < 1.0:
                    need_anim = True
                mp = self.msg_path(g, s)
                tint = Paint(Paint.ANTI_ALIAS_FLAG)
                tint.setColor(jint(Theme.multAlpha(accent, 0.14 * mp_p)))
                canvas.drawPath(mp, tint)
                glow = Paint(Paint.ANTI_ALIAS_FLAG)
                glow.setStyle(Paint.Style.STROKE)
                glow.setStrokeJoin(Paint.Join.ROUND)
                glow.setStrokeCap(Paint.Cap.ROUND)
                glow.setStrokeWidth(float(dp(5.5)))
                glow.setColor(jint(Theme.multAlpha(accent, 0.28 * mp_p)))
                canvas.drawPath(mp, glow)
                outline = Paint(Paint.ANTI_ALIAS_FLAG)
                outline.setStyle(Paint.Style.STROKE)
                outline.setStrokeJoin(Paint.Join.ROUND)
                outline.setStrokeCap(Paint.Cap.ROUND)
                outline.setStrokeWidth(float(dp(2.2)))
                outline.setColor(jint(Theme.multAlpha(accent, mp_p)))
                canvas.drawPath(mp, outline)

        if need_anim:
            view.postInvalidateOnAnimation()

    def hide_popup(self, animated=True):
        pop = self.popup
        self.popup = None
        self.popup_layout = None
        self.popup_anchor = None
        if pop is not None:
            safe(lambda: pop.dismiss(bool(animated)))

    def popup_coords(self, pw, ph):
        view, scroller, anchor = self.canvas_view, self.scroller, self.popup_anchor
        if view is None or scroller is None or anchor is None:
            return None
        ax, top, bot, extra_bot = anchor
        vloc = jarray(jint)([0, 0])
        sloc = jarray(jint)([0, 0])
        view.getLocationInWindow(vloc)
        scroller.getLocationInWindow(sloc)
        top_w = vloc[1] + top
        bot_w = vloc[1] + bot
        st, sb = sloc[1], sloc[1] + scroller.getHeight()
        if bot_w < st or top_w > sb:
            return None
        above = (top_w - ph - dp(4)) >= st
        if above:
            y = top_w - ph - dp(2)
        else:
            y = min(sb - ph - dp(4), bot_w + extra_bot)
        x = max(sloc[0] + dp(4), min(sloc[0] + scroller.getWidth() - pw - dp(4), vloc[0] + ax - pw / 2.0))
        return int(round(x)), int(round(y)), above

    def sync_popup(self):
        if self.popup is None or self.popup_layout is None or not safe(self.popup.isShowing, False):
            return
        pw = self.popup_layout.getMeasuredWidth()
        ph = self.popup_layout.getMeasuredHeight()
        if pw <= 0 or ph <= 0:
            return
        pos = self.popup_coords(pw, ph)
        if pos is None:
            self.hide_popup(True)
            return
        safe(lambda: self.popup.update(pos[0], pos[1], -1, -1))

    def show_actions(self):
        self.hide_popup(False)
        view, scroller = self.canvas_view, self.scroller
        if view is None or scroller is None or self.busy or not safe(view.isAttachedToWindow, True):
            return
        s = self.scale
        accent = self.color(Theme.key_featuredStickers_addButton)
        sub_ink = self.color(Theme.key_actionBarDefaultSubmenuItem)
        red_ink = self.color(Theme.key_text_RedRegular)
        style = self.plugin.prefs.choice("anonymize_style")
        actions = None
        if self.sel_text is not None and self.drag_mode is None:
            rects = self.sel_rects(s)
            if not rects:
                return
            is_hidden = self.sel_text[4]
            if is_hidden:
                actions = (("unhide_text", "Показать текст", icon_res("msg_spoiler_off", "msg_photo_blur"), sub_ink),)
            else:
                actions = (("hide_text", "Скрыть текст", style_icon(style), sub_ink),)
            sel_l = min(r.left for r in rects)
            sel_r = max(r.right for r in rects)
            sel_t = min(r.top for r in rects)
            sel_b = max(r.bottom for r in rects)
            self.popup_anchor = ((sel_l + sel_r) / 2.0, sel_t, sel_b, float(dp(24)))
        elif self.sel_msg is not None:
            g = self.geom_map.get(self.sel_msg)
            if g is None or not g.bubble:
                return
            is_hid = g.key in self.red.hidden_msgs
            is_exc = g.key in self.red.excluded_msgs
            actions = (
                ("toggle_msg", "Показать" if is_hid else "Скрыть",
                 icon_res("msg_spoiler_off", "msg_photo_blur") if is_hid else style_icon(style), sub_ink),
                ("toggle_excl", "Вернуть" if is_exc else "Убрать",
                 icon_res("msg_reset", "msg_edit") if is_exc else icon_res("msg_delete"),
                 accent if is_exc else red_ink),
            )
            br = RectF(g.bubble[0] * s, g.bubble[1] * s, g.bubble[2] * s, g.bubble[3] * s)
            self.popup_anchor = (br.centerX(), br.top, br.bottom, float(dp(6)))
        if not actions:
            return
        try:
            ctx = self.activity
            pop_res = icon_res("popup_fixed_alert2", "popup_fixed_alert")
            layout = ActionBarPopupWindow.ActionBarPopupWindowLayout(ctx, pop_res, self.provider)
            layout.setBackgroundColor(self.color(Theme.key_actionBarDefaultSubmenuBackground))
            row = linear(ctx, gravity=Gravity.CENTER_VERTICAL)
            sel_bg = alpha(self.color(Theme.key_listSelector), 0.22)
            for idx, (act, title, ico, col) in enumerate(actions):
                if idx:
                    div = View(ctx)
                    div.setBackgroundColor(alpha(self.ink, 0.12))
                    row.addView(div, LayoutHelper.createLinear(1, 20, Gravity.CENTER_VERTICAL))
                btn = linear(ctx, gravity=Gravity.CENTER_VERTICAL)
                btn.setPadding(dp(14), dp(11), dp(14), dp(11))
                btn.setBackground(Theme.createSelectorDrawable(sel_bg, 2))
                btn.setClickable(True)
                btn.setFocusable(True)
                if ico:
                    iv = ImageView(ctx)
                    iv.setScaleType(ImageView.ScaleType.CENTER_INSIDE)
                    iv.setImageResource(ico)
                    iv.setColorFilter(col)
                    btn.addView(iv, LayoutHelper.createLinear(18, 18, Gravity.CENTER_VERTICAL, 0, 0, 7, 0))
                btn.addView(label(ctx, title, 14, col, bold=True), LayoutHelper.createLinear(-2, -2, Gravity.CENTER_VERTICAL))
                btn.setOnClickListener(OnClickListener(lambda v, act=act: self.run_action(act, v)))
                row.addView(btn, LayoutHelper.createLinear(-2, -2))
            layout.addView(row, LinearLayout.LayoutParams(-2, -2))
            layout.measure(UNSPECIFIED, UNSPECIFIED)
            pw, ph = layout.getMeasuredWidth(), layout.getMeasuredHeight()
            pos = self.popup_coords(pw, ph)
            if pos is None:
                return
            layout.setShownFromBottom(pos[2])
            popup = ActionBarPopupWindow(layout, -2, -2)
            popup.setAnimationEnabled(True)
            safe(lambda: popup.setAnimationStyle(R.style.PopupContextAnimation))
            popup.setOutsideTouchable(False)
            popup.setFocusable(False)
            popup.showAtLocation(view, Gravity.TOP | Gravity.LEFT, pos[0], pos[1])
            popup.startAnimation()
            self.popup = popup
            self.popup_layout = layout
        except Exception as e:
            warn("actions popup", e)

    def hit_text(self, bx, by):
        for g in self.geoms:
            if g.key in self.red.excluded_msgs or g.key in self.red.hidden_msgs:
                continue
            for line in g.lines:
                if line.top - dp(4) <= by <= line.bottom + dp(4):
                    x_min, x_max = min(line.xs), max(line.xs)
                    if x_min - dp(8) <= bx <= x_max + dp(8) and line.text:
                        best_i, best_d = 0, 1e9
                        for i in range(len(line.text)):
                            mid = (line.xs[i] + line.xs[i + 1]) / 2.0
                            d = abs(bx - mid)
                            if d < best_d:
                                best_d, best_i = d, i
                        return g, line, line.start + best_i
        return None

    def hit_bubble(self, bx, by):
        for g in self.geoms:
            if g.bubble and g.bubble[0] - dp(4) <= bx <= g.bubble[2] + dp(4) and g.bubble[1] - dp(4) <= by <= g.bubble[3] + dp(4):
                return g
        return None

    def nearest_offset(self, g, source, bx, by):
        lines = [l for l in g.lines if l.source == source]
        if not lines:
            return None
        best, best_dy = lines[0], 1e9
        for l in lines:
            dy = 0.0 if l.top <= by <= l.bottom else min(abs(by - l.top), abs(by - l.bottom))
            if dy < best_dy:
                best_dy, best = dy, l
        best_i, best_dx = 0, 1e9
        for i, x in enumerate(best.xs):
            if 0 < i < len(best.text) and 0xDC00 <= ord(best.text[i]) <= 0xDFFF:
                continue
            dx = abs(bx - x)
            if dx < best_dx:
                best_dx, best_i = dx, i
        return best.start + best_i

    def run_action(self, act, view):
        haptic(view)
        self.hide_popup(True)
        if act == "hide_text" and self.sel_text is not None:
            mkey, source, start, end, _ = self.sel_text
            self.red.add_span(mkey, source, start, end)
            self.sel_text = None
            self.anim_rects = None
        elif act == "unhide_text" and self.sel_text is not None:
            mkey, source, start, end, _ = self.sel_text
            self.red.drop_span(mkey, source, start, end)
            self.sel_text = None
            self.anim_rects = None
        elif act == "toggle_msg" and self.sel_msg is not None:
            self.red.toggle_hidden(self.sel_msg)
            self.sel_msg = None
        elif act == "toggle_excl" and self.sel_msg is not None:
            res = self.red.toggle_excluded(self.sel_msg, max(1, len(self.geoms)))
            if res is None:
                BulletinHelper.show_error("Нельзя убрать последнее сообщение")
            self.sel_msg = None
        self.sync_ui()
        self.rebuild()

    def on_long_press(self, token, x, y):
        view = self.canvas_view
        if view is None or token != self.lp_token or self.drag_mode is not None:
            return
        bg = self.hit_bubble(x / self.scale, y / self.scale)
        if bg is None:
            return
        self.lp_fired = True
        self.sel_text = None
        self.anim_rects = None
        self.sel_msg = bg.key
        self.msg_t0 = int(SystemClock.uptimeMillis())
        haptic(view)
        self.show_actions()
        view.postInvalidateOnAnimation()

    def on_touch(self, event):
        view = self.canvas_view
        if view is None or self.disp_bmp is None or self.busy:
            return False
        action = event.getActionMasked()
        x, y = float(event.getX()), float(event.getY())

        if action == MotionEvent.ACTION_DOWN:
            self.down_pos = (x, y)
            self.drag_mode = None
            self.last_off = None
            self.lp_fired = False
            self.lp_token += 1
            if self.handles is not None and self.sel_text is not None:
                (sx, sy), (ex, ey) = self.handles
                ds, de = math.hypot(x - sx, y - sy), math.hypot(x - ex, y - ey)
                limit = float(dp(30))
                if min(ds, de) <= limit:
                    self.drag_mode = "start" if ds <= de else "end"
                    self.disallow(view, True)
                    self.hide_popup(True)
                    haptic(view)
                    view.postInvalidateOnAnimation()
                    return True
            token = self.lp_token
            run_on_ui_thread(lambda: self.on_long_press(token, x, y), 380)
            if self.scroller is not None and (self.scroller.canScrollVertically(1) or self.scroller.canScrollVertically(-1)):
                parent = safe(self.scroller.getParent)
                if parent is not None:
                    safe(lambda: parent.requestDisallowInterceptTouchEvent(True))
            return True

        if action == MotionEvent.ACTION_MOVE:
            if self.down_pos is not None and math.hypot(x - self.down_pos[0], y - self.down_pos[1]) > dp(10):
                self.lp_token += 1
            if self.drag_mode is not None and self.sel_text is not None:
                mkey, source, start, end, is_hidden = self.sel_text
                g = self.geom_map.get(mkey)
                if g is not None:
                    hs = float(dp(22))
                    sample_x = x + hs * 0.35 if self.drag_mode == "start" else x - hs * 0.35
                    sample_y = y - hs * 0.85
                    off = self.nearest_offset(g, source, sample_x / self.scale, sample_y / self.scale)
                    if off is not None and off != self.last_off:
                        self.last_off = off
                        if self.drag_mode == "start":
                            if off < end:
                                start = off
                            elif off > end:
                                start, end = end, off
                                self.drag_mode = "end"
                        else:
                            if off > start:
                                end = off
                            elif off < start:
                                start, end = off, start
                                self.drag_mode = "start"
                        if end > start:
                            if (start, end) != (self.sel_text[2], self.sel_text[3]):
                                haptic(view)
                            self.sel_text = (mkey, source, start, end, False)
                            view.postInvalidateOnAnimation()
                return True
            return False

        if action == MotionEvent.ACTION_UP:
            self.lp_token += 1
            if self.lp_fired:
                self.lp_fired = False
                return True
            if self.drag_mode is not None:
                self.drag_mode = None
                self.disallow(view, False)
                self.show_actions()
                view.postInvalidateOnAnimation()
                return True
            if self.down_pos is not None and math.hypot(x - self.down_pos[0], y - self.down_pos[1]) <= dp(12):
                bx, by = x / self.scale, y / self.scale
                hit = self.hit_text(bx, by)
                if hit is not None:
                    g, line, pos = hit
                    existing = self.red.find_span(g.key, line.source, pos)
                    if existing is not None:
                        self.sel_text = (g.key, line.source, existing[0], existing[1], True)
                    else:
                        ws, we = word_bounds(line.text, pos - line.start)
                        self.sel_text = (g.key, line.source, line.start + ws, line.start + we, False)
                    self.sel_msg = None
                    self.sel_t0 = int(SystemClock.uptimeMillis())
                    self.anim_rects = None
                    haptic(view)
                    self.show_actions()
                    view.postInvalidateOnAnimation()
                    return True
                bg = self.hit_bubble(bx, by)
                if bg is not None:
                    self.sel_text = None
                    self.anim_rects = None
                    self.sel_msg = None if self.sel_msg == bg.key else bg.key
                    haptic(view)
                    if self.sel_msg is not None:
                        self.msg_t0 = int(SystemClock.uptimeMillis())
                        self.show_actions()
                        view.postInvalidateOnAnimation()
                    else:
                        self.hide_popup(True)
                        view.invalidate()
                    return True
                if self.sel_text is not None or self.sel_msg is not None:
                    self.sel_text = None
                    self.sel_msg = None
                    self.anim_rects = None
                    self.hide_popup(True)
                    view.invalidate()
                return True
            return False

        if action == MotionEvent.ACTION_CANCEL:
            self.lp_token += 1
            self.lp_fired = False
            self.drag_mode = None
            self.disallow(view, False)
            view.invalidate()
            return False
        return False


class Sheet:
    def __init__(self, plugin, chat, msgs, reply_to, open_redact=False):
        self.plugin, self.chat, self.msgs, self.reply_to = plugin, chat, msgs, reply_to
        self.open_redact_on_show = open_redact
        self.redactions = Redactions()
        self.activity = chat.getParentActivity()
        self.provider = chat.getResourceProvider()
        self.account = chat.getCurrentAccount()
        self.dialog_id = chat.getDialogId()
        self.data = self.sheet = self.bitmap = self.checker_bmp = None
        self.view_ref = self.full_ref = self.encode_job = self.dims = None
        self.deck = self.main_page = self.redact = self.sheet_delegate = None
        self.image = self.spinner = self.meta = self.viewport = self.zoom = self.redact_btn = self.retry = None
        self.redact_chip = None
        self.send = self.actions_box = self.hold = None
        self.preview_path = None
        self.busy = True
        self.closing = False
        self.preloaded = False
        self.opening = self.dirty = self.failed = self.retry_shown = False
        self.gen = 0
        self.toggles = {}
        self.applied = self.toggle_state()
        self.applied_mask = self.plugin.prefs.mask_state()
        self.ink = self.color(Theme.key_dialogTextBlack)
        self.surface = alpha(self.ink, 0.05 if AndroidUtilities.isDarkColor(self.ink) else 0.08)

    def color(self, key):
        return tcolor(key, self.provider)

    def ripple(self, fill, radius):
        return pressable(fill, radius, alpha(self.color(Theme.key_listSelector), 0.2))

    def notify(self, text, icon):
        res = getattr(R.raw, icon, 0)
        if self.sheet is not None and res and self.sheet.isShowing():
            try:
                return BulletinFactory.of(self.sheet.getContainer(), self.provider).createSimpleBulletin(res, text).show()
            except Exception as e:
                warn("sheet bulletin", e)
        toast(text, icon)

    def dismiss(self):
        self.closing = True
        if self.sheet is not None:
            safe(self.sheet.dismiss)

    def can_dismiss(self):
        if self.closing or self.redact is None:
            return True
        if self.redact.initial:
            return True
        self.close_redact(None)
        return False

    def show(self):
        try:
            sheet = BottomSheet(self.activity, False, self.provider)
            fill = self.color(Theme.key_dialogBackground)
            sheet.setBackgroundColor(fill)
            sheet.fixNavigationBar(fill)
            sheet.setOnHideListener(Dismiss(self.on_hide))
            self.sheet_delegate = SheetDelegate(self.can_dismiss)
            safe(lambda: sheet.setDelegate(self.sheet_delegate))
            self.sheet = sheet
            self.plugin.active_sheet = self
            sheet.setCustomView(self.build())
            if self.open_redact_on_show:
                self.open_redact_on_show = False
                started = self.open_redact(initial=True, defer_load=True)
                sheet.show()
                if started and self.redact is not None:
                    self.redact.load()
                else:
                    self.start_render()
            else:
                sheet.show()
                self.start_render()
        except Exception:
            self.on_hide()
            raise

    def on_hide(self):
        self.gen += 1
        if self.plugin.active_sheet is self:
            self.plugin.active_sheet = None
        if self.redact is not None:
            self.redact.destroy()
            self.redact = None
        if self.image is not None:
            safe(lambda: self.image.setImageBitmap(None))
        if self.viewport is not None:
            safe(lambda: self.viewport.setBackground(None))
        self.deck = self.main_page = self.sheet_delegate = None
        self.image = self.sheet = self.viewport = self.zoom = self.redact_btn = self.retry = self.spinner = None
        self.redact_chip = self.meta = self.send = self.actions_box = self.hold = None
        self.preview_path = None
        self.encode_job = None
        self.data = None
        self.dims = None
        self.bitmap = None
        self.opening = False
        self.toggles.clear()
        if self.view_ref is not None:
            self.view_ref.release()
            self.view_ref = None
        if self.full_ref is not None:
            self.full_ref.release()
            self.full_ref = None
        if self.checker_bmp is not None:
            self.checker_bmp.recycle()
            self.checker_bmp = None

    def mark_preloaded(self):
        self.preloaded = True

    def build(self):
        ctx, plugin = self.activity, self.plugin
        wrapper = linear(ctx, vertical=True, gravity=Gravity.CENTER_HORIZONTAL)

        handle = View(ctx)
        handle.setBackground(rounded(alpha(self.ink, 0.22), 2))
        wrapper.addView(handle, LayoutHelper.createLinear(36, 4, Gravity.CENTER_HORIZONTAL, 0, 8, 0, 6))

        content = linear(ctx, vertical=True, gravity=Gravity.CENTER_HORIZONTAL)
        content.setPadding(dp(14), dp(4), dp(14), dp(12))

        content.addView(self.preview(), LayoutHelper.createLinear(-1, -2))
        self.meta = label(ctx, self.meta_text(), 12, alpha(self.ink, 0.5))
        self.meta.setGravity(Gravity.CENTER)
        content.addView(self.meta, LayoutHelper.createLinear(-1, -2, 0, 8, 0, 0))
        content.addView(self.chips(), LayoutHelper.createLinear(-1, -2, 0, 12, 0, 0))

        send = ButtonWithCounterView(ctx, True, self.provider)
        send.setText("Отправить", False)
        self.clickable(send, self.guarded(lambda v, d: plugin.send_quote(
            d, self.account, self.dialog_id, self.reply_to, "photo"), dismiss=True, need_data=True))
        self.send = send
        content.addView(send, LayoutHelper.createLinear(-1, 48, 0, 14, 0, 0))
        content.addView(self.actions(), LayoutHelper.createLinear(-1, -2, 0, 10, 0, 0))

        self.sync()
        scroll = ScrollView(ctx)
        scroll.setFillViewport(True)
        scroll.setVerticalScrollBarEnabled(False)
        scroll.addView(content, LayoutHelper.createFrame(-1, -2))
        self.main_page = scroll

        deck = FrameLayout(ctx)
        deck.addView(scroll, LayoutHelper.createFrame(-1, -2))
        self.deck = deck
        wrapper.addView(deck, LayoutHelper.createLinear(-1, -2))
        return wrapper

    def preview(self):
        ctx, prefs = self.activity, self.plugin.prefs
        shell = FrameLayout(ctx)
        shell.setBackground(rounded(self.surface, 14))
        shell.setClipToOutline(True)

        image = ImageView(ctx)
        image.setAdjustViewBounds(True)
        image.setScaleType(ImageView.ScaleType.FIT_CENTER)
        image.setContentDescription("Открыть превью на весь экран")
        image.setOnClickListener(OnClickListener(lambda v: self.open_zoom()))
        self.image = image

        viewport = ScrollView(ctx)
        viewport.setVerticalScrollBarEnabled(True)
        viewport.setScrollBarStyle(View.SCROLLBARS_INSIDE_OVERLAY)
        viewport.setVerticalFadingEdgeEnabled(True)
        viewport.setFadingEdgeLength(dp(24))
        viewport.setOverScrollMode(View.OVER_SCROLL_NEVER)
        if prefs.choice("bg_type") == 1 or (prefs.format().name != "JPEG" and prefs.num("corner_radius", 0, 0, 48) > 0):
            bg, tile = checker(ctx, self.ink)
            self.checker_bmp = tile
            viewport.setBackground(bg)
        viewport.addView(image, LayoutHelper.createFrame(-1, -2))
        self.viewport = viewport
        self.hold = Hold(viewport)
        image.setOnTouchListener(self.hold)
        shell.addView(viewport, LayoutHelper.createFrame(-1, -2))
        self.fit()

        border = View(ctx)
        border.setBackground(rounded(0, 14, alpha(self.ink, 0.10)))
        border.setImportantForAccessibility(View.IMPORTANT_FOR_ACCESSIBILITY_NO)
        shell.addView(border, LayoutHelper.createFrame(-1, -1))

        redact = linear(ctx, gravity=Gravity.CENTER_VERTICAL)
        redact.setPadding(dp(10), 0, dp(11), 0)
        redact.setBackground(pressable(Color.argb(0x7A, 0, 0, 0), 16, Color.argb(0xA8, 0, 0, 0)))
        redact.setContentDescription("Скрыть фрагмент")
        r_icon = ImageView(ctx)
        r_icon.setScaleType(ImageView.ScaleType.CENTER_INSIDE)
        r_icon.setImageResource(icon_res("msg_photo_blur", "msg_edit"))
        r_icon.setColorFilter(Color.WHITE)
        redact.addView(r_icon, LayoutHelper.createLinear(15, 15, Gravity.CENTER_VERTICAL, 0, 0, 5, 0))
        r_cap = label(ctx, "Скрыть", 12, Color.WHITE, bold=True)
        redact.addView(r_cap, LayoutHelper.createLinear(-2, -2, Gravity.CENTER_VERTICAL))
        self.clickable(redact, self.guarded(lambda v: self.open_redact()))
        self.redact_btn = (redact, r_cap)
        shell.addView(redact, LayoutHelper.createFrame(-2, 32, Gravity.TOP | Gravity.START, 8, 8, 0, 0))

        zoom = FrameLayout(ctx)
        zoom.setBackground(pressable(Color.argb(0x7A, 0, 0, 0), 16, Color.argb(0xA8, 0, 0, 0)))
        zoom.setContentDescription("Открыть превью на весь экран")
        zoom_icon = ImageView(ctx)
        zoom_icon.setScaleType(ImageView.ScaleType.CENTER_INSIDE)
        zoom_icon.setImageResource(icon_res("msg_zoomin", "ic_ab_search"))
        zoom_icon.setColorFilter(Color.WHITE)
        zoom.addView(zoom_icon, LayoutHelper.createFrame(16, 16, Gravity.CENTER))
        self.clickable(zoom, self.guarded(lambda v: self.open_zoom()))
        self.zoom = zoom
        shell.addView(zoom, LayoutHelper.createFrame(32, 32, Gravity.TOP | Gravity.END, 0, 8, 8, 0))

        ink = self.color(Theme.key_featuredStickers_buttonText)
        retry = linear(ctx, gravity=Gravity.CENTER_VERTICAL)
        retry.setPadding(dp(12), 0, dp(13), 0)
        retry.setBackground(self.ripple(self.color(Theme.key_featuredStickers_addButton), 18))
        retry.setElevation(float(dp(4)))
        retry.setContentDescription("Повторить рендер")
        icon = ImageView(ctx)
        icon.setImageResource(R.drawable.msg_retry)
        icon.setColorFilter(ink)
        retry.addView(icon, LayoutHelper.createLinear(16, 16, Gravity.CENTER_VERTICAL, 0, 0, 6, 0))
        retry.addView(label(ctx, "Повторить", 13, ink, bold=True),
                      LayoutHelper.createLinear(-2, -2, Gravity.CENTER_VERTICAL))
        self.clickable(retry, lambda v: (not self.busy) and self.start_render())
        retry.setVisibility(View.GONE)
        retry.setAlpha(0.0)
        retry.setScaleX(0.92)
        retry.setScaleY(0.92)
        retry.setTranslationY(float(dp(6)))
        self.retry = retry
        shell.addView(retry, LayoutHelper.createFrame(-2, 36, Gravity.BOTTOM | Gravity.CENTER_HORIZONTAL, 0, 0, 0, 10))

        spinner = FrameLayout(ctx)
        spinner.setBackgroundColor(alpha(self.color(Theme.key_dialogBackground), 0.55))
        spinner.setClickable(True)
        spinner.setVisibility(View.GONE)
        progress = RadialProgressView(ctx, self.provider)
        progress.setSize(dp(28))
        progress.setProgressColor(self.color(Theme.key_featuredStickers_addButton))
        spinner.addView(progress, LayoutHelper.createFrame(40, 40, Gravity.CENTER))
        self.spinner = spinner
        shell.addView(spinner, LayoutHelper.createFrame(-1, -1, Gravity.CENTER))
        return shell

    def fit(self):
        viewport, bitmap = self.viewport, self.bitmap
        if viewport is None:
            return
        params = viewport.getLayoutParams()
        if bitmap is None:
            params.height = dp(180)
        else:
            width = viewport.getWidth() or AndroidUtilities.displaySize.x - dp(28)
            natural = int(width * bitmap.getHeight() / max(1, bitmap.getWidth()))
            params.height = max(dp(72), min(natural, int(AndroidUtilities.displaySize.y * PREVIEW_SHARE)))
        viewport.setLayoutParams(params)
        if bitmap is not None and viewport.getWidth() == 0:
            run_on_ui_thread(self.fit, 60)

    def meta_text(self):
        if self.bitmap is None:
            return "Рендеринг..."
        count = max(1, len(self.msgs) - len(self.redactions.excluded_msgs))
        w, h = self.dims if self.dims is not None else (self.bitmap.getWidth(), self.bitmap.getHeight())
        parts = [f"{count} {plural(count, 'сообщение', 'сообщения', 'сообщений')}",
                 self.plugin.prefs.format().name, f"{w}×{h}"]
        if self.data is not None:
            parts.append(size_text(len(self.data)))
        return " · ".join(parts)

    def chips(self):
        ctx = self.activity
        scroller = HorizontalScrollView(ctx)
        scroller.setHorizontalScrollBarEnabled(False)
        scroller.setHorizontalFadingEdgeEnabled(True)
        scroller.setFadingEdgeLength(dp(16))
        scroller.setOverScrollMode(View.OVER_SCROLL_NEVER)
        row = linear(ctx, gravity=Gravity.CENTER_VERTICAL)

        r_chip = linear(ctx, gravity=Gravity.CENTER_VERTICAL)
        r_chip.setPadding(dp(11), dp(6), dp(12), dp(6))
        r_chip.setMinimumHeight(dp(34))
        r_chip.setContentDescription("Скрыть фрагмент")
        r_icon = ImageView(ctx)
        r_icon.setScaleType(ImageView.ScaleType.CENTER_INSIDE)
        r_icon.setImageResource(icon_res("msg_photo_blur", "msg_edit"))
        r_chip.addView(r_icon, LayoutHelper.createLinear(16, 16, Gravity.CENTER_VERTICAL, 0, 0, 5, 0))
        r_cap = label(ctx, "Скрыть", 13, self.ink, bold=True)
        r_chip.addView(r_cap, LayoutHelper.createLinear(-2, -2, Gravity.CENTER_VERTICAL))
        row.addView(r_chip, LinearLayout.LayoutParams(-2, -2))
        self.redact_chip = (r_chip, r_icon, r_cap)
        self.clickable(r_chip, lambda v: (not self.busy) and (haptic(v), self.open_redact()))

        for key, name, title in TOGGLES:
            chip = linear(ctx, gravity=Gravity.CENTER_VERTICAL)
            chip.setPadding(dp(11), dp(6), dp(12), dp(6))
            chip.setMinimumHeight(dp(34))
            chip.setContentDescription(title)
            icon = ImageView(ctx)
            icon.setScaleType(ImageView.ScaleType.CENTER_INSIDE)
            icon.setImageResource(getattr(R.drawable, name))
            chip.addView(icon, LayoutHelper.createLinear(16, 16, Gravity.CENTER_VERTICAL, 0, 0, 5, 0))
            caption = label(ctx, title, 13, self.ink, bold=True)
            chip.addView(caption, LayoutHelper.createLinear(-2, -2, Gravity.CENTER_VERTICAL))
            params = LinearLayout.LayoutParams(-2, -2)
            if row.getChildCount():
                params.leftMargin = dp(6)
            row.addView(chip, params)
            self.toggles[key] = (chip, icon, caption)
            self.clickable(chip, lambda v, key=key: self.toggle(key, v))
        scroller.addView(row, LayoutHelper.createFrame(-2, -2))
        return scroller

    def actions(self):
        ctx, plugin = self.activity, self.plugin
        grid = linear(ctx, vertical=True, gravity=Gravity.CENTER_HORIZONTAL)
        rows = (
            (
                ("Чат", ("msg_forward",), lambda v, d: plugin.pick_chat(d), True, True),
                ("Файл", ("msg_filehq_solar", "msg_filehq"), lambda v, d: plugin.send_quote(
                    d, self.account, self.dialog_id, self.reply_to, "file"), True, True),
                ("Стикер", ("msg_sticker_solar", "msg_sticker"), lambda v: plugin.make_sticker(
                    self.msgs, self.chat, self.reply_to, redactions=self.redactions, need_preload=not self.preloaded), True, False),
            ),
            (
                ("Галерея", ("msg_download",), lambda v, d: plugin.save_image(
                    d, self.activity, v, self.notify), False, True),
                ("Копия", ("msg_copy_solar", "msg_copy"), lambda v, d: plugin.copy_image(
                    d, v, self.notify), False, True),
                ("Ещё", ("msg_share_solar", "msg_share"), lambda v, d: plugin.share_image(
                    d, self.activity, v), False, True),
            ),
        )
        for row_idx, items in enumerate(rows):
            row = linear(ctx, gravity=Gravity.CENTER_VERTICAL)
            for idx, (title, icons, action, dismiss, need_data) in enumerate(items):
                tile = linear(ctx, vertical=True, gravity=Gravity.CENTER)
                tile.setBackground(self.ripple(self.surface, 12))
                tile.setPadding(dp(6), dp(9), dp(6), dp(9))
                tile.setMinimumHeight(dp(62))
                tile.setContentDescription(title)
                icon = ImageView(ctx)
                icon.setScaleType(ImageView.ScaleType.CENTER_INSIDE)
                icon.setImageResource(icon_res(*icons))
                icon.setColorFilter(self.ink)
                tile.addView(icon, LayoutHelper.createLinear(22, 22, Gravity.CENTER_HORIZONTAL))
                caption = label(ctx, title, 12, alpha(self.ink, 0.8), bold=True)
                caption.setGravity(Gravity.CENTER)
                tile.addView(caption, LayoutHelper.createLinear(-2, -2, Gravity.CENTER_HORIZONTAL, 0, 4, 0, 0))
                self.clickable(tile, self.guarded(action, dismiss=dismiss, need_data=need_data))
                params = LinearLayout.LayoutParams(0, -2, 1.0)
                if idx:
                    params.leftMargin = dp(8)
                row.addView(tile, params)
            grid.addView(row, LayoutHelper.createLinear(-1, -2, 0, 8 if row_idx else 0, 0, 0))
        self.actions_box = grid
        return grid

    def clickable(self, view, on_click):
        view.setClickable(True)
        view.setFocusable(True)
        view.setOnClickListener(OnClickListener(on_click))
        safe(lambda: ScaleStateListAnimator.apply(view, 0.05, 1.5))

    def deliver(self, data, job, fn):
        if data is not None:
            fn(data)
            return
        if job is None:
            return

        def wait():
            job.done.wait(15.0)
            if job.data:
                run_on_ui_thread(lambda: fn(job.data))
            else:
                run_on_ui_thread(lambda: BulletinHelper.show_error("Не удалось подготовить изображение"))

        threading.Thread(target=wait, daemon=True).start()

    def guarded(self, action, dismiss=False, need_data=False):
        def on_click(view):
            if self.busy or self.dirty or self.bitmap is None:
                return
            data, job = self.data, self.encode_job
            if dismiss:
                self.dismiss()
            if need_data:
                self.deliver(data, job, lambda d: action(view, d))
            else:
                action(view)
        return on_click

    def toggle_state(self):
        return {key: self.plugin.prefs.flag(key) for key, _, _ in TOGGLES}

    def has_masks(self):
        prefs = self.plugin.prefs
        return (
            not self.redactions.empty()
            or prefs.flag("anonymize_nickname")
            or prefs.flag("anonymize_avatar")
            or prefs.flag("anonymize_usernames")
        )

    def toggle(self, key, view=None):
        if self.busy:
            return
        if view is not None:
            haptic(view)
        self.plugin.set_setting(key, not self.plugin.prefs.flag(key))
        self.failed = False
        self.gen += 1
        token = self.gen
        self.sync()
        if self.dirty:
            run_on_ui_thread(lambda: self.debounced(token), 450)

    def debounced(self, token):
        if self.sheet is None or self.busy or token != self.gen or not self.dirty:
            return
        self.start_render()

    def sync(self):
        busy, states = self.busy, self.toggle_state()
        self.dirty = states != self.applied
        ready = not busy and not self.dirty and self.bitmap is not None
        red_count = self.redactions.count()
        if self.redact_chip is not None:
            r_chip, r_icon, r_cap = self.redact_chip
            on = red_count > 0
            fill = self.color(Theme.key_featuredStickers_addButton) if on else self.surface
            ink = self.color(Theme.key_featuredStickers_buttonText) if on else alpha(self.ink, 0.78)
            r_chip.setBackground(self.ripple(fill, 17))
            r_icon.setColorFilter(ink)
            r_cap.setTextColor(ink)
            r_cap.setText(f"Скрыто: {red_count}" if on else "Скрыть")
            r_chip.setAlpha(0.5 if busy else 1.0)
            r_chip.setClickable(not busy)
        for key, (chip, icon, caption) in self.toggles.items():
            on = states[key]
            fill = self.color(Theme.key_featuredStickers_addButton) if on else self.surface
            ink = self.color(Theme.key_featuredStickers_buttonText) if on else alpha(self.ink, 0.78)
            chip.setBackground(self.ripple(fill, 17))
            icon.setColorFilter(ink)
            caption.setTextColor(ink)
            chip.setAlpha(0.5 if busy else 1.0)
            chip.setClickable(not busy)
        self.sync_retry()
        if self.spinner is not None:
            self.spinner.setVisibility(View.VISIBLE if busy else View.GONE)
        if self.image is not None:
            self.image.setClickable(ready)
            if self.bitmap is not None and not busy:
                target = 0.65 if self.dirty else 1.0
                safe(lambda: self.image.animate().alpha(target).setDuration(140).start())
        if self.redact_btn is not None:
            r_btn, r_cap = self.redact_btn
            r_btn.setVisibility(View.VISIBLE if self.bitmap is not None else View.GONE)
            r_btn.setAlpha(1.0 if ready else 0.4)
            r_btn.setClickable(ready)
            r_cap.setText(f"Скрыто: {red_count}" if red_count else "Скрыть")
        if self.zoom is not None:
            self.zoom.setVisibility(View.VISIBLE if self.bitmap is not None else View.GONE)
            self.zoom.setAlpha(1.0 if ready else 0.4)
            self.zoom.setClickable(ready)
        if self.send is not None:
            safe(lambda: self.send.setLoading(busy))
            safe(lambda: self.send.setEnabled(ready))
            self.send.setClickable(ready)
        if self.actions_box is not None:
            self.actions_box.setAlpha(1.0 if ready else 0.45)
        if self.meta is not None:
            if self.bitmap is None:
                text = "Рендеринг..."
            elif busy:
                text = "Обновление..."
            elif self.dirty and not self.failed:
                text = "Применение изменений..."
            else:
                text = self.meta_text()
            self.meta.setText(text)

    def open_redact(self, initial=False, defer_load=False):
        if self.sheet is None or self.deck is None or self.redact is not None:
            return False
        if not initial and (self.busy or self.dirty):
            return False
        if UniversalView is None or UniversalViewDelegate is None:
            BulletinHelper.show_error("Редактор фрагментов недоступен в этой версии")
            if initial and not defer_load:
                self.start_render()
            return False
        try:
            prev_h = self.main_page.getHeight() if (not initial and self.main_page is not None) else 0
            start_h = max(dp(180), prev_h - dp(190)) if prev_h > 0 else 0
            pane = RedactPane(
                self.plugin, self.chat, self.msgs, self.redactions, self.sheet,
                self.close_redact, initial=initial, start_height=start_h,
                need_preload=not self.preloaded, on_preloaded=self.mark_preloaded,
            )
            view = pane.build()
            self.redact = pane
            safe(lambda: self.sheet.setCanDismissWithSwipe(False))
            if not initial:
                safe(self.sheet.smoothContainerViewLayout)
            if self.main_page is not None:
                safe(lambda: self.main_page.animate().cancel())
                self.main_page.setVisibility(View.GONE)
            self.deck.addView(view, LayoutHelper.createFrame(-1, -2))
            if not initial:
                view.setAlpha(0.0)
                view.setTranslationX(float(dp(24)))
                view.animate().alpha(1.0).translationX(0.0).setDuration(220).setInterpolator(
                    CubicBezierInterpolator.EASE_OUT_QUINT).start()
            if not defer_load:
                pane.load()
            return True
        except Exception as e:
            warn("redact pane", traceback.format_exc())
            if self.redact is not None:
                self.redact.destroy()
                self.redact = None
            if self.main_page is not None:
                self.main_page.setVisibility(View.VISIBLE)
            safe(lambda: self.sheet.setCanDismissWithSwipe(True))
            BulletinHelper.show_error(f"Не удалось открыть редактор: {str(e)[:60]}")
            if initial and not defer_load:
                self.start_render()
            return False

    def close_redact(self, updated):
        pane = self.redact
        if pane is None:
            return
        self.redact = None
        initial = pane.initial
        view = pane.root
        pane.destroy()
        if self.sheet is None or self.deck is None:
            return
        safe(self.sheet.smoothContainerViewLayout)
        if view is not None:
            safe(lambda: view.animate().cancel())
            safe(lambda: self.deck.removeView(view))
        if self.main_page is not None:
            safe(lambda: self.main_page.animate().cancel())
            self.main_page.setVisibility(View.VISIBLE)
            self.main_page.setAlpha(0.0)
            self.main_page.setTranslationX(float(dp(-20)))
            self.main_page.animate().alpha(1.0).translationX(0.0).setDuration(220).setInterpolator(
                CubicBezierInterpolator.EASE_OUT_QUINT).start()
        safe(lambda: self.sheet.setCanDismissWithSwipe(True))
        mask_changed = self.plugin.prefs.mask_state() != self.applied_mask
        if updated is not None:
            changed = not self.redactions.same(updated)
            self.redactions = updated
            if changed or (mask_changed and self.has_masks()) or self.bitmap is None:
                self.start_render()
            else:
                if mask_changed:
                    self.applied_mask = self.plugin.prefs.mask_state()
                self.sync()
        elif initial or self.bitmap is None or (mask_changed and self.has_masks()):
            self.start_render()
        else:
            if mask_changed:
                self.applied_mask = self.plugin.prefs.mask_state()
            self.sync()

    def sync_retry(self):
        view = self.retry
        if view is None:
            return
        show = self.failed and self.dirty and not self.busy
        view.setClickable(show)
        if show == self.retry_shown:
            return
        self.retry_shown = show
        animator = view.animate()
        animator.cancel()
        animator.withEndAction(None)
        if show:
            view.setVisibility(View.VISIBLE)
            animator.alpha(1.0).scaleX(1.0).scaleY(1.0).translationY(0.0).setDuration(200)
        else:
            animator.alpha(0.0).scaleX(0.92).scaleY(0.92).translationY(float(dp(6))).setDuration(150)
            animator.withEndAction(Runnable(lambda: self.hide_retry(view)))
        animator.setInterpolator(DecelerateInterpolator()).start()

    def hide_retry(self, view):
        if self.retry is view and not (self.failed and self.dirty):
            view.setVisibility(View.GONE)

    def start_render(self):
        if self.sheet is None:
            return
        self.gen += 1
        token = self.gen
        self.busy = True
        self.failed = False
        self.sync()
        run_on_queue(lambda: self.render_task(token), PLUGINS_QUEUE)

    def render_task(self, token):
        if self.sheet is None or token != self.gen:
            return
        view_ref = full_ref = opt = dims = error = None
        try:
            need = not self.preloaded and not self.plugin.prefs.flag("hide_media")
            bmp, opt = self.plugin.render_preview(
                self.msgs, self.chat, redactions=self.redactions, need_preload=need)
            if need:
                self.preloaded = True
            if bmp is None:
                error = "пустой результат рендера"
            elif self.sheet is None or token != self.gen:
                safe(bmp.recycle)
                return
            else:
                dims = (bmp.getWidth(), bmp.getHeight())
                full_ref = BmpRef(bmp)
                view_bmp = cap_preview(bmp)
                if view_bmp is bmp:
                    full_ref.retain()
                    view_ref = full_ref
                else:
                    view_ref = BmpRef(view_bmp)
        except Exception as e:
            if view_ref is not None:
                view_ref.release()
                view_ref = None
            if full_ref is not None:
                full_ref.release()
                full_ref = None
            warn("preview render", traceback.format_exc())
            error = str(e)
        run_on_ui_thread(lambda: self.apply(view_ref, full_ref, opt, dims, error, token))

    def apply(self, view_ref, full_ref, opt, dims, error, token):
        if self.sheet is None or token != self.gen:
            if view_ref is not None:
                view_ref.release()
            if full_ref is not None:
                full_ref.release()
            return
        initial = self.bitmap is None
        adopted = False
        if error is None:
            try:
                self.replace(view_ref, full_ref, opt, dims)
                adopted = True
                self.applied = self.toggle_state()
                self.applied_mask = mask_key(opt.style, opt.mask) if opt is not None else self.plugin.prefs.mask_state()
            except Exception as e:
                error = str(e)
        if not adopted:
            if view_ref is not None and view_ref is not self.view_ref:
                view_ref.release()
            if full_ref is not None and full_ref is not self.full_ref:
                full_ref.release()
        self.busy = False
        if error:
            if initial:
                self.dismiss()
                BulletinHelper.show_error(error[:120])
                return
            self.failed = True
            BulletinHelper.show_error(f"Не удалось обновить превью: {error[:80]}")
        self.sync()

    def replace(self, view_ref, full_ref, opt, dims):
        job = SimpleNamespace(done=threading.Event(), data=None, error=None)
        old_view, old_full = self.view_ref, self.full_ref
        self.view_ref, self.full_ref = view_ref, full_ref
        self.bitmap, self.dims, self.data, self.encode_job = view_ref.bmp, dims, None, job
        self.preview_path = None
        self.image.setAlpha(0.0)
        self.image.setImageBitmap(view_ref.bmp)
        if old_view is not None:
            old_view.release()
        if old_full is not None:
            old_full.release()
        self.fit()
        self.meta.setText(self.meta_text())
        enc_bmp = full_ref.retain()
        if enc_bmp is not None:
            threading.Thread(target=self.encode_task, args=(full_ref, enc_bmp, opt, job), daemon=True).start()
        else:
            job.done.set()

    def encode_task(self, full_ref, bmp, opt, job):
        try:
            job.data = encode_bitmap(bmp, opt)
        except Exception as e:
            warn("preview encode", traceback.format_exc())
            job.error = str(e)
        finally:
            full_ref.release()
            job.done.set()
        run_on_ui_thread(lambda: self.on_encoded(job))

    def on_encoded(self, job):
        if self.sheet is None or self.encode_job is not job:
            return
        if job.data is not None:
            self.data = job.data
            if self.meta is not None and not self.busy and not self.dirty:
                self.meta.setText(self.meta_text())

    def open_zoom(self):
        if self.busy or self.dirty or self.opening or self.bitmap is None:
            return
        if self.preview_path and os.path.exists(self.preview_path):
            return self.show_viewer(self.preview_path)
        data, job, ext = self.data, self.encode_job, self.plugin.prefs.format().ext
        if data is None and job is None:
            return
        self.opening = True

        def prepare():
            path = None
            try:
                payload = data
                if payload is None and job is not None:
                    job.done.wait(15.0)
                    payload = job.data
                if payload:
                    path = self.plugin.write_tmp(f"p_{int(time.time() * 1000)}.{ext}", payload)
            except Exception as e:
                warn("zoom", e)
            run_on_ui_thread(lambda: self.finish_zoom(path, job))

        threading.Thread(target=prepare, daemon=True).start()

    def finish_zoom(self, path, job):
        self.opening = False
        if path is None or self.sheet is None or self.encode_job is not job:
            return
        self.preview_path = path
        self.show_viewer(path)

    def show_viewer(self, path):
        try:
            viewer = PhotoViewer.getInstance()
            if viewer.isVisible():
                return
            entries = ArrayList()
            entries.add(MediaController.PhotoEntry(0, 0, 0, path, 0, False, 0, 0, 0))
            viewer.setParentActivity(self.activity, self.provider)
            viewer.openPhotoForSelect(
                entries, 0, -1, False, PhotoViewer.EmptyPhotoViewerProvider(), None)
        except Exception as e:
            warn("zoom", e)


def deferred(fn):
    def hook(param):
        target = param.thisObject
        run_on_ui_thread(lambda: fn(target))
    return hook


def call_private(obj, name, types=(), args=()):
    method = obj.getClass().getDeclaredMethod(name, *types)
    method.setAccessible(True)
    return method.invoke(obj, *args)


def action_mode(chat):
    bar = chat.getActionBar()
    return bar is not None and bar.isActionModeShowed()


class CellFx:
    def __init__(self, cell, provider, msg_id):
        self.cell = cell
        self.msg_id = msg_id
        self.bg = MessageBackgroundDrawable(cell)
        self.cb = CheckBoxBase(cell, 21, provider)
        self.cb.onAttachedToWindow()
        self.visible = False
        self.progress = 0.0
        self.animating = False
        self.last_time = 0

    def set_visible(self, visible, animated):
        if self.visible == visible:
            if not animated and self.animating:
                self.progress = 1.0 if visible else 0.0
                self.animating = False
            return
        self.visible = visible
        self.animating = animated
        if animated:
            self.last_time = SystemClock.elapsedRealtime()
        else:
            self.progress = 1.0 if visible else 0.0
        self.cell.invalidate()

    def set_selected(self, selected, animated, touch=None):
        if touch is not None:
            self.bg.setTouchCoords(float(touch[0]), float(touch[1]))
        self.bg.setSelected(selected, animated)
        self.cb.setChecked(selected, animated)

    def active(self):
        return (self.visible or self.animating or self.progress > 0.0
                or self.bg.isAnimationInProgress() or self.cb.isChecked()
                or self.cb.getProgress() > 0.0)

    def step(self):
        if not self.animating:
            return
        now = SystemClock.elapsedRealtime()
        dt = min(20, max(0, now - self.last_time))
        self.last_time = now
        delta = dt / 220.0
        if self.visible:
            self.progress = min(1.0, self.progress + delta)
            if self.progress >= 1.0:
                self.animating = False
        else:
            self.progress = max(0.0, self.progress - delta)
            if self.progress <= 0.0:
                self.animating = False
        self.cell.invalidate()

    def draw_bg(self, canvas, cell, provider, dark, sel_paint, bg_view):
        w, h = cell.getWidth(), cell.getHeight()
        if w <= 0 or h <= 0:
            return
        if not dark and sel_paint is not None:
            if bg_view is not None:
                safe(lambda: Theme.applyServiceShaderMatrixForView(cell, bg_view, provider))
            self.bg.setCustomPaint(sel_paint)
        else:
            self.bg.setCustomPaint(None)
            self.bg.setColor(tcolor(Theme.key_chat_selectedBackground, provider))
        self.bg.setBounds(0, 0, w, h)
        self.bg.draw(canvas)

    def draw_cb(self, canvas, cell, provider):
        self.step()
        if self.progress <= 0.0:
            return
        eased = CubicBezierInterpolator.EASE_OUT_QUINT.getInterpolation(self.progress)
        size = dp(21)
        x = int(round(dp(8 - 35) + dp(35) * eased))
        y = max(0, (cell.getHeight() - size) // 2)
        self.cb.setResourcesProvider(provider)
        self.cb.setBounds(x, y, size, size)
        self.cb.draw(canvas)


class QuotePlugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self.prefs = Prefs(self)
        self.stage = Stage(self)
        self.tmp = None
        self.btn = None
        self.shot_bulletin = None
        self.active_sheet = None
        self.bg_cache = None
        self.logo_cache = None
        self.logo_hook = None
        self.permission_hook = None
        self.screen_cb = None
        self.screen_act = None
        self.seen_shots = set()
        self.started_at = 0.0
        self.last_shot_at = 0.0
        self.own_save_at = 0.0
        self.shot_gen = 0
        self.refs = {}
        self.held = {}
        self.sliders = {}
        self.previews = []
        self.selected_ids = set()
        self.selecting = False
        self.cell_fx = {}
        self.sel_theme = (None, True, None, None)

    def on_plugin_load(self):
        self.tmp = tmp_dir()
        self.started_at = time.time()
        self.seen_shots = set()
        self.hook_private(ChatActivity, "addToSelectedMessages", (MessageObject, Boolean.TYPE, Boolean.TYPE),
                    Hook(after=deferred(self.on_selection)))
        self.hook_private(ChatActivity, "hideActionMode", (),
                    Hook(after=deferred(self.on_action_hidden)))
        self.hook_private(ChatActivity, "processRowSelect", (View, Boolean.TYPE, Float.TYPE, Float.TYPE),
                    Hook(before=self.on_row_select))
        self.hook_private(ChatActionCell, "onDraw", (Canvas,),
                    Hook(before=self.draw_sel_bg, after=self.draw_sel_cb))
        self.setup_screenshot()
        try:
            self.add_menu_item(MenuItemData(
                menu_type=MenuItemType.MESSAGE_CONTEXT_MENU,
                item_id="quotecreate_make_quote",
                text="Сделать цитату",
                icon="msg_screencast",
                condition="message != null",
                on_click=self.on_menu,
                priority=8,
            ))
        except Exception as e:
            warn("menu item", e)
        run_on_queue(self.sweep, PLUGINS_QUEUE)

    def on_plugin_unload(self):
        self.shot_gen += 1
        run_on_ui_thread(self.teardown_ui)
        self.selected_ids = set()
        self.selecting = False
        self.seen_shots.clear()
        self.cell_fx.clear()
        self.sel_theme = (None, True, None, None)
        self.refs.clear()
        self.held.clear()
        self.sliders.clear()
        self.previews = []
        self.logo_cache = None
        self.logo_hook = None
        self.permission_hook = None
        if self.bg_cache is not None:
            safe(self.bg_cache[2].recycle)
            self.bg_cache = None
        SPOILER_CACHE.clear()
        run_on_queue(lambda: self.sweep(0), PLUGINS_QUEUE)

    def teardown_ui(self):
        self.drop_button(True)
        self.unbind_capture()
        bulletin = self.shot_bulletin
        self.shot_bulletin = None
        if bulletin is not None:
            safe(lambda: bulletin.hide(False, 0))
        sheet = self.active_sheet
        self.active_sheet = None
        if sheet is not None:
            sheet.dismiss()

    def hook_private(self, cls, name, types, hook):
        if cls is None:
            return None
        try:
            method = cls.getClass().getDeclaredMethod(name, *types)
            method.setAccessible(True)
            return self.hook_method(method, hook)
        except Exception as e:
            warn(f"hook {name} skipped", e)
            return None

    def setup_screenshot(self):
        if GalleryObserverExternal is not None:
            self.hook_private(GalleryObserverExternal, "onChange", (Boolean.TYPE,), Hook(after=self.on_media_change))
        if GalleryObserverInternal is not None:
            self.hook_private(GalleryObserverInternal, "onChange", (Boolean.TYPE,), Hook(after=self.on_media_change))
        run_on_ui_thread(self.init_screenshot_ui)

    def init_screenshot_ui(self):
        safe(MediaController.getInstance)
        self.bind_capture()

    def bind_capture(self):
        if ScreenCaptureCallback is None or Build.VERSION.SDK_INT < 34:
            return
        fragment = safe(get_last_fragment)
        activity = safe(fragment.getParentActivity) if fragment is not None else None
        if activity is None or not has_capture_permission(activity):
            return
        if self.screen_act is activity and self.screen_cb is not None:
            return
        self.unbind_capture()
        try:
            cb = ScreenCallback(self.on_screenshot)
            activity.registerScreenCaptureCallback(activity.getMainExecutor(), cb)
            self.screen_cb, self.screen_act = cb, activity
        except Exception as e:
            warn("screen capture cb", e)

    def unbind_capture(self):
        cb, act = self.screen_cb, self.screen_act
        self.screen_cb = self.screen_act = None
        if cb is not None and act is not None:
            safe(lambda: act.unregisterScreenCaptureCallback(cb))

    def on_media_change(self, param):
        if not self.prefs.flag("screenshot_intercept", True):
            return
        if getattr(ApplicationLoader, "mainInterfacePaused", False):
            return
        if time.monotonic() - self.own_save_at < 4.0:
            return
        self.shot_gen += 1
        token = self.shot_gen
        run_on_queue(lambda: self.scan_screenshot(token, 2), PLUGINS_QUEUE)

    def scan_screenshot(self, token, retries):
        if token != self.shot_gen or not self.prefs.flag("screenshot_intercept", True):
            return
        if getattr(ApplicationLoader, "mainInterfacePaused", False):
            return
        ctx = ApplicationLoader.applicationContext
        if ctx is None or not has_media_permission(ctx):
            return
        found = self.query_screenshot(ctx)
        if found:
            run_on_ui_thread(self.on_screenshot)
            return
        if retries > 0:
            delay = 450 if retries == 2 else 750
            run_on_ui_thread(lambda: self.retry_scan(token, retries - 1), delay)

    def retry_scan(self, token, retries):
        if token != self.shot_gen:
            return
        run_on_queue(lambda: self.scan_screenshot(token, retries), PLUGINS_QUEUE)

    def query_screenshot(self, ctx):
        resolver = safe(ctx.getContentResolver)
        if resolver is None:
            return False
        cols = ["_id", "_data", "_display_name", "bucket_display_name", "date_added", "date_modified", "title"]
        if Build.VERSION.SDK_INT >= 29:
            cols.append("relative_path")
        str_arr = jarray(find_class("java.lang.String"))(cols)
        now = time.time()
        for uri in (MediaStore.Images.Media.EXTERNAL_CONTENT_URI, MediaStore.Images.Media.INTERNAL_CONTENT_URI):
            cursor = None
            try:
                cursor = resolver.query(uri, str_arr, None, None, "date_added DESC")
                if cursor is None:
                    continue
                checked = 0
                idx_id = cursor.getColumnIndex("_id")
                idx_add = cursor.getColumnIndex("date_added")
                idx_mod = cursor.getColumnIndex("date_modified")
                text_cols = [i for i in (cursor.getColumnIndex(c) for c in
                                         ("_data", "_display_name", "bucket_display_name", "title", "relative_path"))
                             if i >= 0]
                while checked < 3 and cursor.moveToNext():
                    checked += 1
                    row_id = int(cursor.getLong(idx_id)) if idx_id >= 0 and not cursor.isNull(idx_id) else 0
                    if row_id and row_id in self.seen_shots:
                        continue
                    t_add = float(cursor.getLong(idx_add)) if idx_add >= 0 and not cursor.isNull(idx_add) else 0.0
                    t_mod = float(cursor.getLong(idx_mod)) if idx_mod >= 0 and not cursor.isNull(idx_mod) else 0.0
                    if t_add > 1e12:
                        t_add /= 1000.0
                    if t_mod > 1e12:
                        t_mod /= 1000.0
                    stamp = max(t_add, t_mod)
                    if stamp < self.started_at - 2.0 or abs(now - stamp) > 12.0:
                        continue
                    parts = []
                    for col_i in text_cols:
                        if not cursor.isNull(col_i):
                            val = cursor.getString(col_i)
                            if val:
                                parts.append(str(val).lower())
                    joined = " ".join(parts)
                    if "quote_" in joined:
                        continue
                    if any(key in joined for key in SHOT_KEYS):
                        if row_id:
                            if len(self.seen_shots) >= 32:
                                self.seen_shots.clear()
                            self.seen_shots.add(row_id)
                        return True
            except Exception:
                pass
            finally:
                if cursor is not None:
                    safe(cursor.close)
        return False

    def on_screenshot(self):
        if not self.prefs.flag("screenshot_intercept", True):
            return
        if getattr(ApplicationLoader, "mainInterfacePaused", False):
            return
        now = time.monotonic()
        if now - self.last_shot_at < 2.5:
            return
        if self.active_sheet is not None:
            return
        if safe(lambda: PhotoViewer.getInstance().isVisible(), False):
            return
        fragment = safe(get_last_fragment)
        if not isinstance(fragment, ChatActivity):
            return
        msgs = visible_messages(fragment)
        if not msgs:
            return
        self.last_shot_at = now
        self.show_shot_bulletin(fragment, msgs)

    def clear_shot(self, target=None):
        if target is None or self.shot_bulletin is target:
            self.shot_bulletin = None

    def show_shot_bulletin(self, chat, msgs):
        try:
            ctx = chat.getParentActivity()
            if ctx is None:
                return
            provider = chat.getResourceProvider()
            layout = Bulletin.LottieLayout(ctx, provider)
            raw = next(
                (r for r in (getattr(R.raw, n, 0) for n in ("photo_spoiler", "ic_save_to_gallery", "photo_blur")) if r),
                0,
            )
            fg = tcolor(Theme.key_undo_infoColor, provider)
            if raw:
                layout.imageView.setAutoRepeat(True)
                layout.imageView.setAnimation(raw, 32, 32)
                layout.imageView.setColorFilter(PorterDuffColorFilter(fg, PorterDuff.Mode.SRC_IN))
            else:
                res = icon_res("msg_photo_blur", "msg_screencast")
                if res:
                    layout.imageView.setImageResource(res)
                    layout.imageView.setColorFilter(PorterDuffColorFilter(fg, PorterDuff.Mode.SRC_IN))
            layout.textView.setText("Скрыть фрагменты?")
            layout.textView.setSingleLine(True)

            opened = [False]
            holder = [None]

            def trigger(view=None):
                if opened[0]:
                    return
                opened[0] = True
                haptic(view or layout)
                if holder[0] is not None:
                    safe(holder[0].hide)
                self.show_sheet(chat, msgs, open_redact=True)

            btn = Bulletin.UndoButton(ctx, True, provider)
            btn.setText("Открыть")
            btn.setUndoAction(Runnable(lambda: trigger(btn)))
            layout.setButton(btn)

            bulletin = Bulletin.make(chat, layout, 5000)
            holder[0] = bulletin
            bulletin.setOnClickListener(OnClickListener(trigger))
            bulletin.setOnHideListener(Runnable(lambda b=bulletin: self.clear_shot(b)))
            self.shot_bulletin = bulletin
            safe(bulletin.allowBlur)
            bulletin.show()
        except Exception as e:
            warn("shot bulletin", e)

    def on_selection(self, chat):
        self.update_button(chat)
        self.sync_cells(chat)

    def on_action_hidden(self, chat):
        self.drop_button()
        self.sync_cells(chat)

    def update_button(self, chat):
        try:
            if not action_mode(chat):
                return self.drop_button()
            container = get_private_field(chat, "actionsButtonsLayout")
            if container is None:
                return
            existing = container.findViewWithTag(BUTTON_TAG)
            if existing is not None:
                self.btn = existing
                anim = existing.animate()
                anim.cancel()
                anim.withEndAction(None)
                anim.alpha(1.0).scaleX(1.0).scaleY(1.0).setDuration(180).setInterpolator(DecelerateInterpolator()).start()
                safe(existing.updateColors)
                return
            factory = get_private_field(chat, "glassBackgroundDrawableFactory")
            colors = get_private_field(chat, "blurredBackgroundColorProvider")
            if BlurredRoundButton is None or factory is None or colors is None:
                return warn("action button", "ChatActivityBlurredRoundButton недоступен")
            provider = chat.getResourceProvider()
            icon = icon_res("msg_screencast", "menu_select_quote", "formatting_quote")
            try:
                button = BlurredRoundButton.create(chat.getParentActivity(), factory, colors, provider, icon, 48)
            except Exception:
                button = BlurredRoundButton.create(chat.getParentActivity(), factory, colors, provider)
                button.setIcon(icon, 48)
                button.setIconColor(tcolor(Theme.key_glass_defaultIcon, provider))
            button.setTag(BUTTON_TAG)
            button.setContentDescription("Сделать цитату")
            button.setOnClickListener(OnClickListener(lambda v: self.on_button(chat)))
            safe(lambda: ScaleStateListAnimator.apply(button, 0.065, 2.0))
            params = LinearLayout.LayoutParams(dp(56), dp(56))
            params.setMargins(dp(-1), 0, dp(-1), 0)
            button.setAlpha(0.0)
            button.setScaleX(0.72)
            button.setScaleY(0.72)
            container.addView(button, 1, params)
            button.animate().alpha(1.0).scaleX(1.0).scaleY(1.0).setDuration(220).setInterpolator(DecelerateInterpolator()).start()
            self.btn = button
        except Exception as e:
            warn("action button", e)

    def drop_button(self, instant=False):
        button = self.btn
        self.btn = None
        if button is None:
            return
        anim = button.animate()
        anim.cancel()
        anim.withEndAction(None)
        if instant:
            self.detach_button(button)
            return
        anim.alpha(0.0).scaleX(0.72).scaleY(0.72).setDuration(160).setInterpolator(DecelerateInterpolator()).withEndAction(
            Runnable(lambda: self.detach_button(button))).start()

    def detach_button(self, button):
        if self.btn is button:
            return
        parent = button.getParent()
        if parent is not None:
            parent.removeView(button)

    def on_row_select(self, param):
        try:
            chat, view = param.thisObject, param.args[0]
            if not action_mode(chat) or not isinstance(view, ChatActionCell):
                return
            msg = view.getMessageObject()
            if not is_service(msg):
                return
            touch = (float(param.args[2]), float(param.args[3]))
            call_private(chat, "addToSelectedMessages", (MessageObject, Boolean.TYPE), (msg, bool(param.args[1])))
            safe(lambda: call_private(chat, "updateActionModeTitle"))
            safe(chat.updateVisibleRows)
            self.sync_cells(chat, touched=(view, touch))
            param.setResult(None)
        except Exception as e:
            warn("row select", e)

    def read_sel_theme(self, chat):
        provider = chat.getResourceProvider()
        delegate = get_private_field(chat, "themeDelegate")
        dark = bool(getattr(delegate, "isDark", False)) if delegate is not None else bool(Theme.isCurrentThemeDark())
        sel_paint = (safe(lambda: provider.getPaint(Theme.key_paint_chatMessageBackgroundSelected))
                     if provider is not None else None) or safe(
            lambda: Theme.getThemePaint(Theme.key_paint_chatMessageBackgroundSelected))
        content = safe(chat.getContentView)
        bg_view = getattr(content, "backgroundView", None) if content is not None else None
        return provider, dark, sel_paint, bg_view

    def ensure_fx(self, cell, msg, provider, animated):
        key = System.identityHashCode(cell)
        fx = self.cell_fx.get(key)
        msg_id = msg.getId()
        if fx is None:
            fx = CellFx(cell, provider, msg_id)
            self.cell_fx[key] = fx
            fx.set_visible(self.selecting, animated)
            fx.set_selected(msg_id in self.selected_ids, animated)
        elif fx.msg_id != msg_id:
            fx.msg_id = msg_id
            fx.set_visible(self.selecting, False)
            fx.set_selected(msg_id in self.selected_ids, False)
        return fx

    def sync_cells(self, chat, touched=None):
        try:
            active = action_mode(chat)
            self.selecting = active
            selected = get_private_field(chat, "selectedMessagesIds") if active else None
            self.selected_ids = ({msg.getId() for msg in selected_messages(chat, selected) if is_service(msg)}
                                 if selected is not None else set())
            self.sel_theme = self.read_sel_theme(chat)
            provider = self.sel_theme[0]
            touched_cell, touch_xy = touched if touched is not None else (None, None)
            touched_id = System.identityHashCode(touched_cell) if touched_cell is not None else None
            seen = set()
            list_view = chat.getChatListView()
            for index in range(list_view.getChildCount() if list_view is not None else 0):
                cell = list_view.getChildAt(index)
                if not isinstance(cell, ChatActionCell):
                    continue
                msg = cell.getMessageObject()
                if not is_service(msg):
                    continue
                key = System.identityHashCode(cell)
                seen.add(key)
                if active:
                    fx = self.ensure_fx(cell, msg, provider, True)
                    fx.set_visible(True, True)
                    fx.set_selected(msg.getId() in self.selected_ids, True,
                                    touch=touch_xy if key == touched_id else None)
                elif key in self.cell_fx:
                    fx = self.cell_fx[key]
                    fx.set_selected(False, True)
                    fx.set_visible(False, True)
            if not active:
                for key, fx in list(self.cell_fx.items()):
                    if key not in seen:
                        self.cell_fx.pop(key, None)
                run_on_ui_thread(self.clear_stale_fx, 400)
        except Exception as e:
            warn("service selection", e)

    def clear_stale_fx(self):
        if self.selecting:
            return
        for key, fx in list(self.cell_fx.items()):
            if not fx.active():
                self.cell_fx.pop(key, None)

    def draw_sel_bg(self, param):
        if not self.selecting and not self.cell_fx:
            return
        try:
            cell, canvas = param.thisObject, param.args[0]
            if cell.getParent() is None:
                return
            msg = cell.getMessageObject()
            if not is_service(msg):
                return
            key = System.identityHashCode(cell)
            if not self.selecting and key not in self.cell_fx:
                return
            provider, dark, sel_paint, bg_view = self.sel_theme
            fx = self.ensure_fx(cell, msg, provider, False)
            fx.draw_bg(canvas, cell, provider, dark, sel_paint, bg_view)
        except Exception:
            pass

    def draw_sel_cb(self, param):
        if not self.selecting and not self.cell_fx:
            return
        try:
            cell, canvas = param.thisObject, param.args[0]
            key = System.identityHashCode(cell)
            fx = self.cell_fx.get(key)
            if fx is None:
                return
            fx.draw_cb(canvas, cell, self.sel_theme[0])
            if not self.selecting and not fx.active():
                self.cell_fx.pop(key, None)
        except Exception:
            pass

    def on_button(self, chat):
        msgs = sorted(selected_messages(chat), key=lambda m: m.getId())
        if not msgs:
            return BulletinHelper.show_error("Нет сообщений")
        safe(chat.clearSelectionMode)
        self.show_sheet(chat, msgs)

    def on_menu(self, context):
        try:
            msg, fragment = context.get("message"), context.get("fragment")
            if msg is None:
                return BulletinHelper.show_error("Не удалось получить сообщение")
            if not isinstance(fragment, ChatActivity):
                return BulletinHelper.show_error("Цитату можно создать только из чата")
            group = context.get("groupedMessages")
            items = getattr(group, "messages", None) if group is not None else None
            msgs = [items.get(i) for i in range(items.size())] if items is not None and items.size() else [msg]
            self.show_sheet(fragment, sorted(msgs, key=lambda m: m.getId()))
        except Exception as e:
            warn("menu quote", e)
            BulletinHelper.show_error("Не удалось создать цитату")

    def make_sticker(self, msgs, chat, reply_to, redactions=None, need_preload=True):
        account, dialog_id = chat.getCurrentAccount(), chat.getDialogId()
        dialog = AlertDialogBuilder(chat.getParentActivity(), AlertDialogBuilder.ALERT_TYPE_SPINNER).set_title("Рендер стикера...").show()

        def task():
            try:
                bmp, _ = self.render_preview(
                    msgs, chat, sticker=True, redactions=redactions, need_preload=need_preload)
                if bmp is None:
                    raise Exception("рендер вернул пустой результат")
                run_on_ui_thread(lambda: (dialog.dismiss(), self.send_quote(bmp, account, dialog_id, reply_to, "sticker")))
            except Exception as e:
                warn("render", traceback.format_exc())
                error = str(e)[:120]
                run_on_ui_thread(lambda: (dialog.dismiss(), BulletinHelper.show_error(error)))

        run_on_queue(task, PLUGINS_QUEUE)

    def render_preview(self, msgs, chat, sticker=False, redactions=None, need_preload=True):
        opt = self.prefs.options(self.logo_image(), sticker)
        bg = None if opt.transparent or opt.bg_type != 0 else self.chat_background(chat)
        try:
            if need_preload and not opt.hide_media:
                safe(lambda: preload(msgs, chat.getCurrentAccount()))
            return Renderer(msgs, chat, opt, redactions=redactions).render_bitmap(bg), opt
        finally:
            if bg is not None:
                bg.recycle()

    def render_bytes(self, msgs, chat, sticker=False, redactions=None, need_preload=True):
        opt = self.prefs.options(self.logo_image(), sticker)
        bg = None if opt.transparent or opt.bg_type != 0 else self.chat_background(chat)
        try:
            if need_preload and not opt.hide_media:
                safe(lambda: preload(msgs, chat.getCurrentAccount()))
            return Renderer(msgs, chat, opt, redactions=redactions).render(bg)
        finally:
            if bg is not None:
                bg.recycle()

    def render_editor(self, msgs, chat, need_preload=True):
        opt = self.prefs.options(self.logo_image(), False)
        bg = None if opt.transparent or opt.bg_type != 0 else self.chat_background(chat)
        try:
            if need_preload and not opt.hide_media:
                safe(lambda: preload(msgs, chat.getCurrentAccount()))
            return Renderer(msgs, chat, opt, collect=True).render_editor(bg)
        finally:
            if bg is not None:
                bg.recycle()

    def chat_background(self, chat):
        key = (chat.getDialogId(), AndroidUtilities.displaySize.x, AndroidUtilities.displaySize.y)
        now, cached = time.time(), self.bg_cache
        if not (cached and cached[0] == key and now - cached[1] < 4.0):
            bmp = safe(lambda: wallpaper(chat))
            if bmp is None:
                return None
            if cached:
                cached[2].recycle()
            self.bg_cache = cached = (key, now, bmp)
        return cached[2].copy(cached[2].getConfig(), False)

    def show_sheet(self, chat, msgs, open_redact=False):
        account, dialog_id = chat.getCurrentAccount(), chat.getDialogId()
        reply_to = (safe(chat.getThreadMessage)
                    or top_reply(account, safe(chat.getTopicId, 0), dialog_id)
                    or top_reply(account, topic_of(account, msgs[0], dialog_id), dialog_id))
        try:
            Sheet(self, chat, msgs, reply_to, open_redact=open_redact).show()
        except Exception as e:
            warn("preview sheet", traceback.format_exc())
            BulletinHelper.show_error(f"Не удалось открыть предпросмотр: {str(e)[:60]}")

    def send_quote(self, data, account, dialog_id, reply_to, mode):
        fmt = self.prefs.format()

        def prepare():
            stamp = int(time.time() * 1000)
            if mode == "sticker":
                bmp = data if isinstance(data, Bitmap) else BitmapFactory.decodeByteArray(data, 0, len(data))
                if bmp is None:
                    raise Exception("не удалось декодировать изображение")
                path = self.tmp_path(f"q_{stamp}.webp")
                try:
                    bmp = fit_sticker(bmp)
                    write_webp(bmp, path)
                finally:
                    safe(bmp.recycle)
                media = make_document(path, "image/webp", sticker=True)
            else:
                path = self.write_tmp(f"q_{stamp}.{fmt.ext}", data)
                if mode == "file":
                    media = make_document(path, fmt.mime)
                else:
                    media = SendMessagesHelper.getInstance(account).generatePhotoSizes(path, None)
                    if media is None:
                        raise Exception("не удалось подготовить фото")
            run_on_ui_thread(lambda: self.deliver(media, path, account, dialog_id, reply_to, mode))

        background(prepare, "Ошибка отправки")

    def deliver(self, media, path, account, dialog_id, reply_to, mode):
        try:
            extra = HashMap()
            extra.put("originalPath", path)
            build = SendMessagesHelper.SendMessageParams.of
            if mode == "photo":
                params = build(media, None, dialog_id, reply_to, reply_to, None, None, None, extra,
                               True, 0, 0, 0, None, False, False)
            else:
                params = build(media, None, path, dialog_id, reply_to, reply_to, None, None, None, extra,
                               True, 0, 0, 0, None, None, False)
            SendMessagesHelper.getInstance(account).sendMessage(params)
            if mode == "sticker":
                toast("Стикер отправлен", "smile_to_sticker")
            else:
                toast("Отправлено", "forward")
        except Exception as e:
            warn("send", traceback.format_exc())
            BulletinHelper.show_error(f"Ошибка отправки: {str(e)[:100]}")

    def pick_chat(self, data):
        def open_picker():
            try:
                fragment = get_last_fragment()
                if fragment is None:
                    return BulletinHelper.show_error("Нет активного экрана")
                args = Bundle()
                args.putInt("dialogsType", 3)
                args.putBoolean("resetDelegate", False)
                for key in ("onlySelect", "closeFragment", "canSelectTopics", "checkCanWrite", "allowGlobalSearch",
                            "allowUsers", "allowBots", "allowGroups", "allowMegagroups", "allowLegacyGroups",
                            "allowChannels"):
                    args.putBoolean(key, True)
                picker = DialogsActivity(args)
                delegate = Picked(lambda chosen, dids: self.on_picked(chosen, dids, data))
                self.refs["picker"] = delegate
                picker.setDelegate(delegate)
                fragment.presentFragment(picker)
            except Exception as e:
                warn("chat picker", e)
                BulletinHelper.show_error("Не удалось открыть выбор чата")

        run_on_ui_thread(open_picker)

    def on_picked(self, fragment, dids, data):
        topic = dids.get(0) if dids is not None and dids.size() else None
        if topic is None or topic.dialogId == 0:
            return BulletinHelper.show_error("Чат не выбран")
        account = fragment.getCurrentAccount()
        self.refs.pop("picker", None)
        safe(fragment.finishFragment)
        self.send_quote(data, account, topic.dialogId, top_reply(account, topic.topicId, topic.dialogId), "photo")

    def share_image(self, data, activity, view):
        haptic(view)
        fmt = self.prefs.format()

        def prepare():
            uri = file_uri(self.write_tmp(f"share_{int(time.time() * 1000)}.{fmt.ext}", data))

            def open_chooser():
                intent = Intent(Intent.ACTION_SEND)
                intent.setType(fmt.mime)
                intent.putExtra(Intent.EXTRA_STREAM, uri)
                intent.addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)
                chooser = Intent.createChooser(intent, "Поделиться")
                if activity is None:
                    chooser.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
                try:
                    (activity or ApplicationLoader.applicationContext).startActivity(chooser)
                except Exception as e:
                    BulletinHelper.show_error(f"Ошибка отправки: {str(e)[:60]}")

            run_on_ui_thread(open_chooser)

        background(prepare, "Ошибка отправки")

    def save_image(self, data, activity, view, notify):
        haptic(view)
        fmt = self.prefs.format()
        if (activity is not None and 23 <= Build.VERSION.SDK_INT < 29
                and activity.checkSelfPermission(Manifest.permission.WRITE_EXTERNAL_STORAGE) != PackageManager.PERMISSION_GRANTED):
            self.refs["gallery_permission"] = (data, activity, view, notify)
            string_array = jarray(find_class("java.lang.String"))
            if self.permission_hook is None:
                self.permission_hook = self.hook_private(
                    LaunchActivity, "onRequestPermissionsResult",
                    (Integer.TYPE, string_array, jarray(jint)),
                    Hook(after=self.on_gallery_permission))
            if self.permission_hook is None:
                self.refs.pop("gallery_permission", None)
                return BulletinHelper.show_error("Не удалось запросить доступ к хранилищу")
            activity.requestPermissions(string_array([Manifest.permission.WRITE_EXTERNAL_STORAGE]), GALLERY_REQUEST)
            return

        def prepare():
            stamp = int(time.time() * 1000)
            name = f"quote_{stamp}.{fmt.ext}"
            path = self.write_tmp(name, data)
            token = f"gallery_{stamp}"
            callback = Saved(lambda uri: self.gallery_saved(token, notify))
            self.refs[token] = callback
            try:
                self.own_save_at = time.monotonic()
                MediaController.saveFile(path, activity or ApplicationLoader.applicationContext,
                                         0, name, fmt.mime, callback, False)
            except Exception:
                self.refs.pop(token, None)
                raise

        background(prepare, "Ошибка сохранения")

    def gallery_saved(self, token, notify):
        self.refs.pop(token, None)
        notify("Сохранено в галерею", "ic_save_to_gallery")

    def request_media_access(self, *_):
        fragment = safe(get_last_fragment)
        activity = safe(fragment.getParentActivity) if fragment is not None else None
        if activity is None:
            return BulletinHelper.show_error("Нет активного экрана")
        if has_media_permission(activity) or has_capture_permission(activity):
            return
        perm = Manifest.permission.READ_MEDIA_IMAGES if Build.VERSION.SDK_INT >= 33 else Manifest.permission.READ_EXTERNAL_STORAGE
        string_array = jarray(find_class("java.lang.String"))
        if self.permission_hook is None:
            self.permission_hook = self.hook_private(
                LaunchActivity, "onRequestPermissionsResult",
                (Integer.TYPE, string_array, jarray(jint)),
                Hook(after=self.on_gallery_permission))
        if self.permission_hook is None:
            return BulletinHelper.show_error("Не удалось запросить доступ к медиа")
        activity.requestPermissions(string_array([perm]), SHOT_REQUEST)

    def on_shot_toggle(self, value):
        self.set_setting("screenshot_intercept", bool(value), reload_settings=True)
        if value:
            ctx = ApplicationLoader.applicationContext
            if ctx is not None and not has_media_permission(ctx) and not has_capture_permission(ctx):
                run_on_ui_thread(self.request_media_access)

    def on_gallery_permission(self, param):
        try:
            req = int(param.args[0])
            if req == SHOT_REQUEST:
                granted = param.args[2]
                if granted is not None and len(granted) and int(granted[0]) == PackageManager.PERMISSION_GRANTED:
                    self.set_setting("screenshot_intercept", True, reload_settings=True)
                    toast("Перехват скриншотов активен", "ic_save_to_gallery")
                else:
                    BulletinHelper.show_error("Для перехвата скриншотов нужен доступ к фото")
                return
            if req != GALLERY_REQUEST:
                return
            pending = self.refs.pop("gallery_permission", None)
            if pending is None:
                return
            granted = param.args[2]
            if granted is not None and len(granted) and int(granted[0]) == PackageManager.PERMISSION_GRANTED:
                self.save_image(*pending)
            else:
                BulletinHelper.show_error("Для сохранения нужен доступ к хранилищу")
        except Exception as e:
            warn("gallery permission", e)

    def copy_image(self, data, view, notify):
        haptic(view)
        context = ApplicationLoader.applicationContext
        ext = self.prefs.format().ext

        def copy():
            uri = file_uri(self.write_tmp(f"c_{int(time.time() * 1000)}.{ext}", data))
            clip = ClipData.newUri(context.getContentResolver(), "Image", uri)

            def set_clip():
                try:
                    context.getSystemService(Context.CLIPBOARD_SERVICE).setPrimaryClip(clip)
                    notify("Скопировано", "copy")
                except Exception as e:
                    BulletinHelper.show_error(f"Ошибка копирования: {str(e)[:60]}")

            run_on_ui_thread(set_clip)

        background(copy, "Ошибка копирования")

    def tmp_path(self, name):
        os.makedirs(self.tmp, exist_ok=True)
        return os.path.join(self.tmp, name)

    def write_tmp(self, name, data):
        path = self.tmp_path(name)
        with open(path, "wb") as file:
            file.write(bytes(data))
        return path

    def sweep(self, max_age=TMP_AGE):
        if not self.tmp or not os.path.isdir(self.tmp):
            return
        logo = self.logo_path()
        keep = os.path.abspath(logo) if logo else None
        try:
            now = time.time()
            for name in os.listdir(self.tmp):
                path = os.path.join(self.tmp, name)
                if os.path.abspath(path) != keep and os.path.isfile(path) and now - os.path.getmtime(path) >= max_age:
                    with suppress(OSError):
                        os.remove(path)
        except Exception as e:
            warn("temp cleanup", e)

    def watermark_summary(self):
        prefs = self.prefs
        if not prefs.flag("watermark_enabled"):
            return "Выкл"
        raw = self.get_setting("watermark_text", "@username")
        text = "" if raw is None else str(raw).strip()
        if prefs.flag("watermark_tile") and text:
            return f"Вкл · {text} · Замощение"
        parts = ["Вкл"]
        if text:
            parts.append(text)
            parts.append(POSITIONS[prefs.num("watermark_position", 0, 0, len(POSITIONS) - 1)])
        if self.logo_path():
            parts.append("логотип")
        return " · ".join(parts)

    def anon_summary(self):
        prefs = self.prefs
        active = []
        if prefs.flag("anonymize_nickname"):
            active.append("подмена имени" if prefs.flag("anonymize_fake_name") else "имя")
        if prefs.flag("anonymize_avatar"):
            active.append("аватар")
        if prefs.flag("anonymize_usernames"):
            active.append("@юзернеймы")
        style = ANON_STYLES[prefs.num("anonymize_style", 0, 0, len(ANON_STYLES) - 1)]
        return f"{', '.join(active).capitalize()} · {style}" if active else f"Выкл · {style}"

    def create_settings(self):
        self.held["main"] = []
        prefs, slider = self.prefs, self.slider
        items = [
            Header("Фон"),
            Selector("bg_type", "Тип фона", 0, ["Тема чата", "Прозрачный", "Свой цвет"], icon="msg_background",
                     on_change=self.reloader("bg_type", 0)),
        ]
        if prefs.choice("bg_type") == 2:
            items.append(self.custom_row(
                self.palette_factory("bg_color", "#FF000000", "Цвет фона", BG_SWATCHES), "main"))
        items += [
            Switch("transparent_sticker", "Прозрачный фон для стикера", True, icon="media_sticker_stroke"),
            Divider(),
            Header("Изображение"),
            Selector("output_format", "Формат", 0, ["PNG", "JPEG"], icon="msg_photos",
                     on_change=self.reloader("output_format", 0)),
        ]
        jpeg = prefs.format().name == "JPEG"
        if jpeg:
            items.append(slider("jpeg_quality", "Качество JPEG", 92, 40, 100, "%"))
        items += [
            Selector("render_scale", "Масштаб", 0, ["1x", "1.5x", "2x"], icon="msg_zoomin"),
            slider("image_padding", "Поля вокруг цитаты", 16, 0, 48, "dp"),
        ]
        if not jpeg:
            items.append(slider("corner_radius", "Скругление углов", 0, 0, 48, "dp"))
        items += [
            Divider(),
            Header("Оформление и приватность"),
            Text("Водяной знак", subtext=self.watermark_summary(), icon="msg_photo_text_framed",
                 create_sub_fragment=self.watermark_page),
            Text("Анонимизация", subtext=self.anon_summary(), icon="msg_photo_blur",
                 create_sub_fragment=self.anon_page),
            Divider(),
            Header("Скриншоты"),
            Switch("screenshot_intercept", "Перехват скриншотов", True,
                   subtext="Уведомление с кнопкой редактирования видимого фрагмента",
                   icon="msg_screencast", on_change=self.on_shot_toggle),
        ]
        ctx = ApplicationLoader.applicationContext
        if prefs.flag("screenshot_intercept", True) and ctx is not None and not has_media_permission(ctx) and not has_capture_permission(ctx):
            items.append(Text("Выдать доступ к фото", subtext="Нужен для отслеживания новых скриншотов",
                              icon="msg_photos", on_click=self.request_media_access))
        items += [
            Divider(),
            Header("Отображение"),
            Switch("hide_time", "Скрывать время", False, icon="msg_contacts_time"),
            Switch("hide_status", "Скрывать галочки и просмотры", False, icon="msg_markread"),
            Switch("hide_reactions", "Скрывать реакции", False, icon="msg_reactions"),
            Switch("hide_media", "Скрывать медиа", False, icon="menu_photo_off_24"),
        ]
        return items

    def watermark_page(self):
        self.held["watermark"] = []
        self.sliders.clear()
        self.previews = []
        prefs, slider, logo = self.prefs, self.slider, self.logo_path()
        items = [
            Header("Водяной знак"),
            Switch("watermark_enabled", "Включить водяной знак", False, icon="msg_photo_text_framed",
                   on_change=self.reloader("watermark_enabled", False)),
        ]
        if not prefs.flag("watermark_enabled"):
            return items
        items += [
            self.custom_row(self.preview_factory(), "watermark"),
            Divider(),
            Header("Текст"),
            Input("watermark_text", "Текст", "@username", subtext="{date}, {chat}, {count}",
                  icon="msg_photo_text_regular", on_change=self.reloader("watermark_text", "@username")),
            Selector("watermark_position", "Позиция", 0, list(POSITIONS), icon="msg_location",
                     on_change=self.on_pos_change("watermark_position", "watermark_x", "watermark_y", 0)),
            slider("watermark_size", "Размер текста", 13, 8, 48, "dp", scope="watermark"),
            slider("watermark_opacity", "Прозрачность текста", 72, 5, 100, "%", scope="watermark"),
            slider("watermark_padding", "Отступ от края", 12, 0, 64, "dp", scope="watermark"),
            slider("watermark_angle", "Наклон текста", 0, -45, 45, "°", snap=0, scope="watermark"),
            self.custom_row(self.palette_factory("watermark_color", "#FFFFFFFF", "Цвет текста", SWATCHES), "watermark"),
            Divider(),
            Header("Подложка"),
            Switch("watermark_tile", "Замостить по диагонали", False, icon="msg_media",
                   on_change=self.reloader("watermark_tile", False)),
        ]
        if not prefs.flag("watermark_tile"):
            items += [
                Switch("watermark_blur_bg", "Размытый фон под текстом", True, icon="msg_blur_radial",
                       on_change=lambda *_: self.refresh_previews()),
                slider("watermark_bg_opacity", "Прозрачность плашки", 36, 0, 100, "%", scope="watermark"),
                slider("watermark_bg_radius", "Скругление плашки", 12, 0, 32, "dp", scope="watermark"),
            ]
        items += [
            Divider(),
            Header("Логотип"),
            self.custom_row(self.logo_factory(), "watermark"),
        ]
        if logo:
            items += [
                Selector("watermark_logo_position", "Позиция логотипа", 3, list(POSITIONS), icon="msg_location",
                         on_change=self.on_pos_change("watermark_logo_position", "watermark_logo_x", "watermark_logo_y", 3)),
                slider("watermark_logo_size", "Размер логотипа", 28, 12, 96, "dp", scope="watermark"),
                slider("watermark_logo_opacity", "Прозрачность логотипа", 80, 5, 100, "%", scope="watermark"),
                Text("Убрать логотип", icon="msg_delete", red=True, on_click=self.clear_logo),
            ]
        return items

    def on_pos_change(self, pos_key, x_key, y_key, default):
        def handler(*_):
            val = safe(lambda: int(self.get_setting(pos_key, default)), default)
            for k in (pos_key, x_key, y_key):
                self.prefs.live.pop(k, None)
            if val != 5:
                self.set_setting(x_key, "")
                self.set_setting(y_key, "")
            self.set_setting(pos_key, val, reload_settings=True)
        return handler

    def sync_slider(self, key, value):
        entry = self.sliders.get(key)
        if entry is None:
            return
        value_view, seek, caption, low, high = entry
        safe(lambda: value_view.setText(caption(value)))
        safe(lambda: seek.setProgress(float(value - low) / (high - low)))

    def anon_page(self):
        self.held["anon"] = []
        self.previews = []
        prefs = self.prefs
        style = prefs.choice("anonymize_style")
        items = [
            Header("Стиль скрытия"),
            self.custom_row(self.anon_preview_factory(), "anon"),
            Selector("anonymize_style", "Эффект", 0, list(ANON_STYLES),
                     icon="msg_photo_blur", on_change=self.reloader("anonymize_style", 0)),
        ]
        for key, title, default, low, high, suffix in EFFECT_PARAMS.get(style, ()):
            items.append(self.slider(key, title, default, low, high, suffix, scope="anon"))
        items += [
            Divider(),
            Header("Что скрывать"),
            Switch("anonymize_nickname", "Скрывать никнейм", False, icon="msg_contacts_name",
                   on_change=self.reloader("anonymize_nickname", False)),
            Switch("anonymize_avatar", "Скрывать аватар", False, icon="msg_openprofile",
                   on_change=self.reloader("anonymize_avatar", False)),
            Switch("anonymize_usernames", "Скрывать @юзернеймы в тексте", False, icon="msg_mention",
                   on_change=self.reloader("anonymize_usernames", False)),
            Divider(),
            Header("Подмена имени"),
            Switch("anonymize_fake_name", "Подменять имя вместо закраски", False, icon="msg_replace",
                   on_change=self.reloader("anonymize_fake_name", False)),
        ]
        if prefs.flag("anonymize_fake_name"):
            items.append(Input("anonymize_fake_text", "Подставляемое имя", "Аноним", icon="msg_edit"))
        return items

    def reloader(self, key, default):
        return lambda *_: self.set_setting(key, self.get_setting(key, default), reload_settings=True)

    def custom_row(self, factory, scope="main"):
        self.held.setdefault(scope, []).append(factory)
        return Custom(factory=factory.instance.java)

    def refresh_previews(self):
        for view in self.previews:
            safe(view.postInvalidate)

    def slider(self, key, title, default, low, high, suffix, snap=None, scope="main"):
        prefs = self.prefs

        def current():
            return prefs.num(key, default, low, high)

        def caption(value):
            return f"{value}{suffix}" if suffix in ("%", "°") else f"{value} {suffix}"

        def flush():
            value = prefs.live.pop(key, None)
            if value is not None:
                self.set_setting(key, str(value))

        def create_view(context, list_view, account, class_guid, provider):
            root, body, line = setting_row(context, provider, pad_v=(10, 10))
            row = linear(context)
            row.addView(label(context, title, 16, tcolor(Theme.key_windowBackgroundWhiteBlackText, provider)),
                        LinearLayout.LayoutParams(0, -2, 1.0))
            accent = tcolor(Theme.key_windowBackgroundWhiteBlueText, provider)
            value_view = label(context, caption(current()), 13, accent, bold=True)
            value_view.setBackground(rounded(alpha(accent, 0.12), 8))
            value_view.setPadding(dp(8), dp(3), dp(8), dp(3))
            value_view.setMinWidth(dp(46))
            value_view.setGravity(Gravity.CENTER)
            safe(lambda: value_view.setFontFeatureSettings("tnum"))
            row.addView(value_view, LayoutHelper.createLinear(-2, -2, Gravity.CENTER_VERTICAL, 8, 0, 0, 0))
            body.addView(row, LayoutHelper.createLinear(-1, -2))
            seek = SeekBarView(context, provider)
            seek.setReportChanges(True)
            body.addView(seek, LayoutHelper.createLinear(-1, 38, 0, 2, 0, 0))
            last = [current()]

            def on_drag(stop, progress):
                raw = max(low, min(high, int(round(low + (high - low) * progress))))
                value = snap if snap is not None and abs(raw - snap) <= 2 else raw
                if snap is not None and value == snap and last[0] != snap:
                    haptic(seek)
                last[0] = value
                value_view.setText(caption(value))
                prefs.live[key] = value
                if stop:
                    if snap is not None and value == snap and raw != snap:
                        seek.setProgress(float(snap - low) / (high - low))
                    flush()
                self.refresh_previews()

            delegate = Slider(on_drag, flush, lambda: f"{title}: {caption(current())}", high - low)
            self.held.setdefault(scope, []).append(delegate)
            seek.setDelegate(delegate)
            return root

        def bind_view(view, item, divider, adapter, list_view):
            value = current()
            body, line = view.getChildAt(0), view.getChildAt(1)
            value_view, seek = body.getChildAt(0).getChildAt(1), body.getChildAt(1)
            if scope == "watermark":
                self.sliders[key] = (value_view, seek, caption, low, high)
            safe(lambda: value_view.setText(caption(value)))
            safe(lambda: seek.setProgress(float(value - low) / (high - low)))
            safe(lambda: line.setVisibility(View.VISIBLE if divider else View.GONE))

        return self.custom_row(SimpleSettingFactory(create_view, bind_view, is_clickable=False, is_shadow=False), scope)

    def palette_factory(self, key, default, title, swatches):
        prefs, provider_ref, swatch_hex = self.prefs, [None], {to_hex(color) for color in swatches}
        check_res = icon_res("ic_ab_done", "list_check", "account_check")

        def paint_circle(view, color, selected, custom_btn=False):
            ink = tcolor(Theme.key_windowBackgroundWhiteBlackText, provider_ref[0])
            fill = color if (not custom_btn or selected) else alpha(ink, 0.08)
            circle = GradientDrawable()
            circle.setShape(GradientDrawable.OVAL)
            circle.setColor(fill)
            stroke_color = (tcolor(Theme.key_windowBackgroundWhiteBlueText, provider_ref[0])
                            if selected else alpha(ink, 0.16))
            circle.setStroke(dp(2 if selected else 1), stroke_color)
            view.setBackground(circle)
            icon = view.getChildAt(0)
            contrast = Color.WHITE if AndroidUtilities.isDarkColor(color) else Color.BLACK
            if custom_btn:
                tint = contrast if selected else tcolor(Theme.key_windowBackgroundWhiteGrayText2, provider_ref[0])
                icon.setColorFilter(tint)
            else:
                icon.setVisibility(View.VISIBLE if selected else View.GONE)
                icon.setColorFilter(contrast)

        def refresh(root):
            body = root.getChildAt(0)
            hex_view = body.getChildAt(0).getChildAt(1)
            row = body.getChildAt(1).getChildAt(0)
            current = prefs.hex(key, default)
            hex_view.setText(current)
            for index, color in enumerate(swatches):
                paint_circle(row.getChildAt(index), color, to_hex(color) == current)
            custom = current not in swatch_hex
            paint_circle(row.getChildAt(len(swatches)), prefs.color(key, current), custom, custom_btn=True)
            self.refresh_previews()

        def create_view(context, list_view, account, class_guid, provider):
            provider_ref[0] = provider
            root, body, line = setting_row(context, provider, pad_v=(10, 12))
            header = linear(context)
            header.addView(label(context, title, 16, tcolor(Theme.key_windowBackgroundWhiteBlackText, provider)),
                           LinearLayout.LayoutParams(0, -2, 1.0))
            gray = tcolor(Theme.key_windowBackgroundWhiteGrayText2, provider)
            hex_view = label(context, prefs.hex(key, default), 12, gray, bold=True)
            hex_view.setBackground(rounded(alpha(gray, 0.12), 7))
            hex_view.setPadding(dp(7), dp(3), dp(7), dp(3))
            safe(lambda: hex_view.setFontFeatureSettings("tnum"))
            header.addView(hex_view, LayoutHelper.createLinear(-2, -2, Gravity.CENTER_VERTICAL, 8, 0, 0, 0))
            body.addView(header, LayoutHelper.createLinear(-1, -2))

            scroller = HorizontalScrollView(context)
            scroller.setHorizontalScrollBarEnabled(False)
            scroller.setOverScrollMode(View.OVER_SCROLL_NEVER)
            row = linear(context)

            def add_circle(res, size, on_click):
                circle = FrameLayout(context)
                circle.setClickable(True)
                circle.setFocusable(True)
                circle.setOnClickListener(OnClickListener(lambda v: (haptic(v), on_click(v))))
                safe(lambda: ScaleStateListAnimator.apply(circle, 0.08, 1.5))
                icon = ImageView(context)
                icon.setScaleType(ImageView.ScaleType.CENTER_INSIDE)
                if res:
                    icon.setImageResource(res)
                circle.addView(icon, LayoutHelper.createFrame(size, size, Gravity.CENTER))
                params = LinearLayout.LayoutParams(dp(34), dp(34))
                if row.getChildCount():
                    params.leftMargin = dp(10)
                row.addView(circle, params)
                return circle

            def select(color):
                self.set_setting(key, to_hex(color))
                refresh(root)

            for color in swatches:
                add_circle(check_res, 16, lambda v, color=color: select(color))
            add_circle(R.drawable.msg_palette, 18, lambda v: self.pick_color(
                key, default, lambda: refresh(root)))
            scroller.addView(row, LayoutHelper.createFrame(-2, -2))
            body.addView(scroller, LayoutHelper.createLinear(-1, -2, 0, 10, 0, 0))
            return root

        def bind_view(view, item, divider, adapter, list_view):
            safe(lambda: view.getChildAt(1).setVisibility(View.VISIBLE if divider else View.GONE))
            safe(lambda: refresh(view))

        return SimpleSettingFactory(create_view, bind_view, is_clickable=False, is_shadow=False)

    def logo_factory(self):
        def create_view(context, list_view, account, class_guid, provider):
            root, body, line = setting_row(context, provider, pad_v=(10, 10))
            body.setClickable(True)
            body.setFocusable(True)
            body.setBackground(Theme.getSelectorDrawable(False, provider))
            body.setOnClickListener(OnClickListener(self.pick_logo))
            row = linear(context, gravity=Gravity.CENTER_VERTICAL)
            ink = tcolor(Theme.key_windowBackgroundWhiteBlackText, provider)
            box_view = FrameLayout(context)
            box_view.setBackground(rounded(alpha(ink, 0.06), 10, alpha(ink, 0.12)))
            box_view.setClipToOutline(True)
            thumb = ImageView(context)
            thumb.setScaleType(ImageView.ScaleType.CENTER_INSIDE)
            thumb.setPadding(dp(4), dp(4), dp(4), dp(4))
            box_view.addView(thumb, LayoutHelper.createFrame(-1, -1))
            placeholder = ImageView(context)
            placeholder.setScaleType(ImageView.ScaleType.CENTER_INSIDE)
            placeholder.setImageResource(R.drawable.msg_addphoto)
            placeholder.setColorFilter(tcolor(Theme.key_windowBackgroundWhiteGrayIcon, provider))
            box_view.addView(placeholder, LayoutHelper.createFrame(22, 22, Gravity.CENTER))
            row.addView(box_view, LayoutHelper.createLinear(40, 40, Gravity.CENTER_VERTICAL, 0, 0, 14, 0))

            col = linear(context, vertical=True, gravity=Gravity.CENTER_VERTICAL)
            col.addView(label(context, "Логотип", 16, ink), LayoutHelper.createLinear(-1, -2))
            sub = label(context, "", 13, tcolor(Theme.key_windowBackgroundWhiteGrayText2, provider))
            col.addView(sub, LayoutHelper.createLinear(-1, -2, 0, 2, 0, 0))
            row.addView(col, LinearLayout.LayoutParams(0, -2, 1.0))
            body.addView(row, LayoutHelper.createLinear(-1, -2))
            return root

        def bind_view(view, item, divider, adapter, list_view):
            body, line = view.getChildAt(0), view.getChildAt(1)
            row = body.getChildAt(0)
            box_view, col = row.getChildAt(0), row.getChildAt(1)
            thumb, placeholder, sub = box_view.getChildAt(0), box_view.getChildAt(1), col.getChildAt(1)
            safe(lambda: line.setVisibility(View.VISIBLE if divider else View.GONE))
            logo = self.logo_image()
            if logo is not None:
                thumb.setImageBitmap(logo)
                thumb.setVisibility(View.VISIBLE)
                placeholder.setVisibility(View.GONE)
                sub.setText(f"{logo.getWidth()}×{logo.getHeight()} · Нажмите, чтобы заменить")
            else:
                thumb.setImageBitmap(None)
                thumb.setVisibility(View.GONE)
                placeholder.setVisibility(View.VISIBLE)
                sub.setText("Нажмите, чтобы выбрать изображение")

        return SimpleSettingFactory(create_view, bind_view, is_clickable=False, is_shadow=False)

    def preview_factory(self):
        def create_view(context, list_view, account, class_guid, provider):
            root, body, line = setting_row(context, provider, pad_v=(12, 10), pad_h=16)
            if UniversalView is None or UniversalViewDelegate is None:
                return root
            holder = [None]
            delegate = Drawer(
                lambda canvas: attempt("watermark preview", lambda: self.stage.draw(canvas, provider)),
                lambda event: self.stage.touch(holder[0], event) if holder[0] is not None else False,
            )
            preview = UniversalView(context, delegate)
            holder[0] = preview
            preview.setWillNotDraw(False)
            preview.setClickable(True)
            preview.setImportantForAccessibility(View.IMPORTANT_FOR_ACCESSIBILITY_NO)
            self.held.setdefault("watermark", []).append(delegate)
            self.previews.append(preview)
            body.addView(preview, LayoutHelper.createLinear(-1, 192))
            hint = label(context, "Перетаскивайте текст и логотип · тяните за угол для размера", 12,
                         tcolor(Theme.key_windowBackgroundWhiteGrayText2, provider))
            hint.setGravity(Gravity.CENTER)
            body.addView(hint, LayoutHelper.createLinear(-1, -2, 0, 8, 0, 0))
            return root

        def bind_view(view, item, divider, adapter, list_view):
            body = view.getChildAt(0)
            preview = body.getChildAt(0) if body.getChildCount() else None
            if preview is not None:
                if preview not in self.previews:
                    self.previews.append(preview)
                preview.invalidate()

        return SimpleSettingFactory(create_view, bind_view, is_clickable=False, is_shadow=False)

    def draw_anon_preview(self, canvas, provider):
        width, height = canvas.getWidth(), canvas.getHeight()
        if width <= 0 or height <= 0:
            return
        buf = new_bitmap(width, height)
        try:
            bc = Canvas(buf)

            def color(key):
                return jint(tcolor(key, provider))

            drawable = (safe(provider.getWallpaperDrawable) if provider is not None else None) or Theme.getCachedWallpaper()
            if drawable is not None:
                if Theme.isPatternWallpaper():
                    bc.drawColor(color(Theme.key_chat_wallpaper))
                old_bounds = Rect(drawable.getBounds())
                try:
                    iw, ih = drawable.getIntrinsicWidth(), drawable.getIntrinsicHeight()
                    if iw > 0 and ih > 0:
                        scale = max(width / float(iw), height / float(ih))
                        dw, dh = int(round(iw * scale)), int(round(ih * scale))
                        dx, dy = (width - dw) // 2, (height - dh) // 2
                        drawable.setBounds(dx, dy, dx + dw, dy + dh)
                    else:
                        drawable.setBounds(0, 0, width, height)
                    drawable.draw(bc)
                finally:
                    drawable.setBounds(old_bounds)
            else:
                base = tcolor(Theme.key_chat_wallpaper, provider)
                accent = tcolor(Theme.key_featuredStickers_addButton, provider)
                bg_paint = Paint(Paint.ANTI_ALIAS_FLAG)
                bg_paint.setShader(LinearGradient(
                    0.0, 0.0, float(width), float(height),
                    jint(base), jint(ColorUtils.blendARGB(base, accent, 0.22)), Shader.TileMode.CLAMP))
                bc.drawRect(0.0, 0.0, float(width), float(height), bg_paint)

            style = self.prefs.choice("anonymize_style")
            cfg = self.prefs.mask_cfg()
            medium = AndroidUtilities.getTypeface("fonts/rmedium.ttf")
            bubble_col = tcolor(Theme.key_chat_inBubble, provider)
            text_col = tcolor(Theme.key_chat_messageTextIn, provider)
            accent_text = tcolor(Theme.key_windowBackgroundWhiteBlueText, provider)

            ink = Paint(Paint.ANTI_ALIAS_FLAG)
            ink.setTextSize(float(dp(14)))
            ink.setColor(jint(text_col))
            name_paint = Paint(Paint.ANTI_ALIAS_FLAG)
            name_paint.setTextSize(float(dp(12.5)))
            name_paint.setTypeface(medium)
            name_paint.setColor(jint(accent_text))
            time_paint = Paint(Paint.ANTI_ALIAS_FLAG)
            time_paint.setTextSize(float(dp(10.5)))
            time_paint.setColor(jint(alpha(tcolor(Theme.key_chat_inTimeText, provider), 0.85)))

            name_text = "Алексей"
            sample_a = "Пример "
            sample_b = "скрытого"
            sample_c = " текста"
            full_text = sample_a + sample_b + sample_c
            in_h = dp(56)
            in_top = max(dp(10), (height - in_h) // 2)
            in_bottom = in_top + in_h
            av_size = dp(36)
            av_left = dp(12)
            av_top = in_bottom - av_size
            in_left = av_left + av_size + dp(8)
            in_w = min(width - in_left - dp(12), max(dp(190), int(ink.measureText(full_text) + dp(56))))

            if style != 4:
                av_paint = Paint(Paint.ANTI_ALIAS_FLAG)
                av_paint.setShader(LinearGradient(
                    float(av_left), float(av_top), float(av_left + av_size), float(av_top + av_size),
                    jint(ColorUtils.blendARGB(accent_text, Color.WHITE, 0.25)), jint(accent_text), Shader.TileMode.CLAMP))
                bc.drawCircle(av_left + av_size / 2.0, av_top + av_size / 2.0, av_size / 2.0, av_paint)
                av_ink = Paint(Paint.ANTI_ALIAS_FLAG)
                av_ink.setTextSize(float(dp(15)))
                av_ink.setTypeface(medium)
                av_ink.setColor(jint(Color.WHITE))
                av_ink.setTextAlign(Paint.Align.CENTER)
                am = av_ink.getFontMetrics()
                bc.drawText("А", av_left + av_size / 2.0, float(av_top + av_size / 2.0 - (am.ascent + am.descent) / 2.0), av_ink)
                av_box = box(av_left, av_top, av_left + av_size, av_top + av_size)
                if av_box:
                    draw_mask(bc, buf, av_box, style, text_col, circle=True,
                              bg=bubble_col if style in (2, 3) else None, cfg=cfg)

            paint = Paint(Paint.ANTI_ALIAS_FLAG)
            paint.setColor(jint(bubble_col))
            bc.drawRoundRect(RectF(float(in_left), float(in_top), float(in_left + in_w), float(in_bottom)),
                             float(dp(15)), float(dp(15)), paint)
            tail = Path()
            tail.moveTo(float(in_left + dp(6)), float(in_bottom))
            tail.lineTo(float(in_left - dp(5)), float(in_bottom))
            tail.quadTo(float(in_left), float(in_bottom - dp(2)), float(in_left), float(in_bottom - dp(10)))
            tail.lineTo(float(in_left + dp(8)), float(in_bottom - dp(8)))
            tail.close()
            bc.drawPath(tail, paint)

            name_x = float(in_left + dp(12))
            name_y = float(in_top + dp(19))
            nm = name_paint.getFontMetrics()
            bc.drawText(name_text, name_x, name_y, name_paint)
            n_box = box(name_x - dp(2), name_y + nm.ascent - dp(1),
                        name_x + name_paint.measureText(name_text) + dp(2), name_y + nm.descent + dp(1))
            if n_box:
                draw_mask(bc, buf, n_box, style, text_col, bg=bubble_col, cfg=cfg)

            tx = float(in_left + dp(12))
            ty = float(in_top + dp(41))
            tm = ink.getFontMetrics()
            bc.drawText(full_text, tx, ty, ink)
            w_left = tx + ink.measureText(sample_a)
            w_right = w_left + ink.measureText(sample_b)
            w_box = box(w_left - dp(2), ty + tm.ascent - dp(1), w_right + dp(2), ty + tm.descent + dp(1))
            if w_box:
                draw_mask(bc, buf, w_box, style, text_col, bg=bubble_col, cfg=cfg)
            bc.drawText("12:34", float(in_left + in_w - dp(36)), float(in_bottom - dp(8)), time_paint)

            area = RectF(0.0, 0.0, float(width), float(height))
            radius = float(dp(14))
            clip = Path()
            clip.addRoundRect(area, radius, radius, Path.Direction.CW)
            canvas.save()
            canvas.clipPath(clip)
            canvas.drawBitmap(buf, 0.0, 0.0, None)
            canvas.restore()

            stroke = Paint(Paint.ANTI_ALIAS_FLAG)
            stroke.setStyle(Paint.Style.STROKE)
            stroke.setStrokeWidth(float(max(1, dp(1))))
            stroke.setColor(color(Theme.key_divider))
            inset = stroke.getStrokeWidth() / 2.0
            canvas.drawRoundRect(RectF(inset, inset, float(width) - inset, float(height) - inset), radius, radius, stroke)
        finally:
            buf.recycle()

    def anon_preview_factory(self):
        def create_view(context, list_view, account, class_guid, provider):
            root, body, line = setting_row(context, provider, pad_v=(12, 10), pad_h=16)
            if UniversalView is None or UniversalViewDelegate is None:
                return root
            delegate = Drawer(
                lambda canvas: attempt("anon preview", lambda: self.draw_anon_preview(canvas, provider)),
                lambda event: False,
            )
            preview = UniversalView(context, delegate)
            preview.setWillNotDraw(False)
            preview.setImportantForAccessibility(View.IMPORTANT_FOR_ACCESSIBILITY_NO)
            self.held.setdefault("anon", []).append(delegate)
            self.previews.append(preview)
            body.addView(preview, LayoutHelper.createLinear(-1, 96))
            return root

        def bind_view(view, item, divider, adapter, list_view):
            body = view.getChildAt(0)
            preview = body.getChildAt(0) if body.getChildCount() else None
            if preview is not None:
                if preview not in self.previews:
                    self.previews.append(preview)
                preview.invalidate()

        return SimpleSettingFactory(create_view, bind_view, is_clickable=False, is_shadow=False)

    def pick_color(self, key, default, on_pick):
        try:
            fragment = get_last_fragment()
            activity = fragment.getParentActivity() if fragment is not None else None
            if activity is None:
                return BulletinHelper.show_error("Не удалось открыть палитру")

            def accept(color):
                self.set_setting(key, to_hex(color))
                on_pick()

            pipette, sink = NoPipette(), ColorSink(accept)
            self.refs[key] = (pipette, sink)
            sheet = ColorPickerBottomSheet(activity, fragment.getResourceProvider())
            sheet.setPipetteDelegate(pipette)
            sheet.setColor(self.prefs.color(key, default))
            sheet.setColorListener(sink)
            run_on_ui_thread(sheet.show)
        except Exception as e:
            warn("color picker", e)
            BulletinHelper.show_error("Не удалось открыть палитру")

    def logo_path(self):
        path = str(self.get_setting("watermark_logo_path", "") or "").strip()
        return path if path and os.path.exists(path) else ""

    def logo_image(self):
        path = self.logo_path()
        if not path:
            return None
        stamp = (path, safe(lambda: os.path.getmtime(path), 0))
        cached = self.logo_cache
        if cached is None or cached[0] != stamp:
            self.logo_cache = cached = (stamp, safe(lambda: BitmapFactory.decodeFile(path)))
        return cached[1]

    def pick_logo(self, *_):
        try:
            fragment = get_last_fragment()
            if fragment is None:
                return BulletinHelper.show_error("Не удалось открыть выбор файла")
            intent = Intent(Intent.ACTION_OPEN_DOCUMENT)
            intent.addCategory(Intent.CATEGORY_OPENABLE)
            intent.setType("image/*")
            intent.addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)
            if self.logo_hook is None:
                self.logo_hook = self.hook_private(LaunchActivity, "onActivityResult", (Integer.TYPE, Integer.TYPE, Intent),
                                             Hook(after=self.on_logo_result))
            run_on_ui_thread(lambda: fragment.startActivityForResult(intent, LOGO_REQUEST))
        except Exception as e:
            warn("logo picker", e)
            BulletinHelper.show_error("Не удалось открыть выбор файла")

    def on_logo_result(self, param):
        try:
            request, result, data = param.args
            if int(request) != LOGO_REQUEST or int(result) != Activity.RESULT_OK or data is None:
                return
            uri = data.getData()
            if uri is not None:
                background(lambda: self.import_logo(uri), "Не удалось добавить логотип")
        except Exception as e:
            warn("logo result", e)

    def import_logo(self, uri):
        stream = ApplicationLoader.applicationContext.getContentResolver().openInputStream(uri)
        if stream is None:
            raise Exception("нет доступа к файлу")
        sink, buffer = ByteArrayOutputStream(), jarray(jbyte)(64 * 1024)
        try:
            while (count := stream.read(buffer)) > 0:
                sink.write(buffer, 0, count)
                if sink.size() > LOGO_LIMIT:
                    raise Exception("файл больше 8 МБ")
        finally:
            stream.close()
        if sink.size() == 0:
            raise Exception("пустой файл")
        path = self.write_tmp("watermark_logo.png", sink.toByteArray())
        probe = BitmapFactory.decodeFile(path)
        if probe is None:
            os.remove(path)
            raise Exception("не изображение")
        probe.recycle()
        self.logo_cache = None
        run_on_ui_thread(lambda: (self.set_setting("watermark_logo_path", path, reload_settings=True),
                                  toast("Логотип добавлен", "tab_colors")))

    def clear_logo(self, *_):
        path = self.logo_path()
        if path:
            with suppress(OSError):
                os.remove(path)
        self.logo_cache = None
        self.set_setting("watermark_logo_path", "", reload_settings=True)
        toast("Логотип убран", "tab_colors")


def tmp_dir():
    context = ApplicationLoader.applicationContext
    base = context.getExternalCacheDir() or context.getCacheDir()
    path = os.path.join(base.getAbsolutePath(), __id__)
    os.makedirs(path, exist_ok=True)
    return path


def file_uri(path):
    context = ApplicationLoader.applicationContext
    return FileProvider.getUriForFile(context, f"{context.getPackageName()}.provider", File(path))