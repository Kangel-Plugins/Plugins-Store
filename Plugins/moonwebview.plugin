"""
_DEX_CLASS_NAME = "org.mlplugins.moonwebview.Main"


class MoonWebView(BasePlugin):
    def __init__(self):
        super().__init__()

        self._dexLoader = DexLoader(_DEX_CLASS_NAME)
        self._dexLoader.load_from_b64(_DEX_B64)

    def on_plugin_load(self):
        self._dexLoader.load()

    def on_plugin_unload(self):
        self._dexLoader.unload()

    # stub
    def create_settings(self):
        settings = [Divider()]
        return settings