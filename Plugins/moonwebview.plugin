__id__ = "moonwebview"
__name__ = "MoonWebView"
__author__ = "@pyginx & @MLPlugins"
__version__ = "2.0.0"
__app_version__ = ">=12.9.0"
__description__ = "A plugin for replace Telegram browser to WebView"
__category__ = ["appearance"]

import base64
from dalvik.system import InMemoryDexClassLoader
from java.nio import ByteBuffer
from org.telegram.messenger import ApplicationLoader
from typing import Any as _A
from ui.settings import Divider
from base_plugin import BasePlugin


class Unknown:
    def __init__(self):
        return self

    def __call__(self, *args: _A, **kwds: _A) -> _A:
        return self

    def __str__(self):
        return "unknown"

    def __bool__(self):
        return False

    def __int__(self):
        return -1


def _as_java_type(var):
    from java.lang import Boolean, Float, Integer, String

    java_type = (
        String
        if isinstance(var, str)
        else Integer.TYPE
        if isinstance(var, int)
        else Float.TYPE
        if isinstance(var, float)
        else Boolean.TYPE
        if isinstance(var, bool)
        else var.getClass()
        if hasattr(var, "getClass")
        else Unknown
    )
    return java_type


class DexLoader:
    def __init__(self, class_name: str):
        self._loader = None
        self._class_name = class_name

    def load_from_bytebuffer(self, dex):
        ctx = ApplicationLoader.applicationContext

        self._loader = InMemoryDexClassLoader(dex, ctx.getClassLoader())

    def load_from_bytes(self, dex: bytes):
        self.load_from_bytebuffer(ByteBuffer.wrap(dex))

    def load_from_b64(self, dex_b64: str):
        b64 = "".join(dex_b64.split())
        b64 = base64.b64decode(b64)

        self.load_from_bytes(b64)

    def invoke(self, method_name: str, is_static: bool, *args):
        clazz = self._loader.loadClass(self._class_name)
        instance = None if is_static else clazz.newInstance()

        param_types = [_as_java_type(arg) for arg in args]
        method = clazz.getMethod(method_name, *param_types)

        method.setAccessible(True)
        return method.invoke(instance, *args)

    def load(self, *args):
        self.invoke("load", True, *args)

    def unload(self, *args):
        self.invoke("unload", True, *args)


