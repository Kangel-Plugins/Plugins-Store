__id__ = "dialogs_theme_background"
__name__ = "Dialogs Theme Background"
__description__ = "Делает фон главной страницы диалогов фоновым из темы, как на других экранах."
__author__ = "@RnPlugins"
__version__ = "1.0.0"
__icon__ = "RnDev/29"
__app_version__ = ">=12.5.1"
__sdk_version__ = ">=1.4.3.3"

import base64
from base_plugin import BasePlugin
from java.nio import ByteBuffer
from dalvik.system import InMemoryDexClassLoader
from org.telegram.messenger import ApplicationLoader

DEX_B64 = """"""

class DialogsThemeBackgroundPlugin(BasePlugin):
    def on_plugin_load(self):
        try:
            self.log("Loading DialogsThemeBackground DEX...")
            dex_bytes = base64.b64decode(DEX_B64)
            buffer = ByteBuffer.wrap(dex_bytes)
            parent_cl = ApplicationLoader.applicationContext.getClassLoader()
            self.dex_loader = InMemoryDexClassLoader(buffer, parent_cl)
            self.dex_class = self.dex_loader.loadClass("dev.rooni.dialogsthemebackground.DialogsThemeBackground")

            for method in self.dex_class.getMethods():
                if method.getName() == "start":
                    method.invoke(None)
                    break
            self.log("DialogsThemeBackground loaded and started successfully.")
        except Exception as e:
            self.log(f"Failed to load DialogsThemeBackground DEX: {e}")

    def on_plugin_unload(self):
        try:
            if hasattr(self, "dex_class") and self.dex_class is not None:
                for method in self.dex_class.getMethods():
                    if method.getName() == "stop":
                        method.invoke(None)
                        break
            self.log("DialogsThemeBackground DEX unloaded.")
        except Exception as e:
            self.log(f"Failed to unload DialogsThemeBackground DEX: {e}")
