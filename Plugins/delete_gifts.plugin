from base_plugin import BasePlugin, MethodHook
from java import jclass, dynamic_proxy
from android_utils import run_on_ui_thread, log
from client_utils import get_last_fragment
from ui.bulletin import BulletinHelper

__id__ = "delete_gifts"
__name__ = "DeleteGifts"
__description__ = "Перенос функции удаления подарков из нового обновления Telegram"
__author__ = "@LuPlugins (@optimist_opti)"
__version__ = "1.0"
__min_version__ = "11.9.0"
__icon__ = "rei_plugins/3"

# deleteStarGift#3cdaf8aa stargift:InputSavedStarGift = Bool
DELETE_CONSTRUCTOR = 0x3CDAF8AA
# Метка в saveStarGift.flags: такой запрос хук отправляет как deleteStarGift
MARKER = 0x5EEDDE1E
BUTTON_TAG = "delete_gifts_button"
TL = "org.telegram.tgnet.tl.TL_stars$"

Class = jclass("java.lang.Class")
ConnectionsManager = jclass("org.telegram.tgnet.ConnectionsManager")
RequestDelegate = jclass("org.telegram.tgnet.RequestDelegate")
UserConfig = jclass("org.telegram.messenger.UserConfig")
AndroidUtilities = jclass("org.telegram.messenger.AndroidUtilities")


# ---------- Java-прокси ----------

class _Delegate(dynamic_proxy(RequestDelegate)):
    def __init__(self, cb):
        super().__init__()
        self.cb = cb

    def run(self, response, error):
        try:
            self.cb(response, error)
        except Exception as e:
            log("delete_gifts callback error: %s" % e)


class _Run(dynamic_proxy(jclass("java.lang.Runnable"))):
    def __init__(self, fn):
        super().__init__()
        self.fn = fn

    def run(self):
        try:
            self.fn()
        except Exception as e:
            log("delete_gifts run error: %s" % e)


class _DialogClick(dynamic_proxy(jclass("org.telegram.ui.ActionBar.AlertDialog$OnButtonClickListener"))):
    def __init__(self, fn):
        super().__init__()
        self.fn = fn

    def onClick(self, dialog, which):
        self.fn()


class _ViewClick(dynamic_proxy(jclass("android.view.View$OnClickListener"))):
    def __init__(self, fn):
        super().__init__()
        self.fn = fn

    def onClick(self, view):
        try:
            self.fn()
        except Exception as e:
            log("delete_gifts click error: %s" % e)


# ---------- Хуки ----------

class _SerializeHook(MethodHook):
    """Помеченный saveStarGift сериализуется как deleteStarGift."""

    def before_hooked_method(self, param):
        req = param.thisObject
        if req.flags != MARKER:
            return
        stream = param.args[0]
        stream.writeInt32(DELETE_CONSTRUCTOR)
        req.stargift.serializeToStream(stream)
        param.setResult(None)


class _SheetSetHook(MethodHook):
    """После открытия шторки подарка добавляет в неё кнопку удаления."""

    def after_hooked_method(self, param):
        sheet = param.thisObject
        _ensure_button(sheet)
        # шторка может перестроить содержимое чуть позже
        AndroidUtilities.runOnUIThread(_Run(lambda: _ensure_button(sheet)), 400)


# ---------- Рефлексия (приватные члены шторки) ----------

def _call(obj, name):
    cls = obj.getClass()
    while cls is not None:
        for m in cls.getDeclaredMethods():
            if m.getName() == name and len(m.getParameterTypes()) == 0:
                m.setAccessible(True)
                return m.invoke(obj)
        cls = cls.getSuperclass()
    raise Exception("method not found: %s" % name)


def _field(obj, name):
    cls = obj.getClass()
    while cls is not None:
        for f in cls.getDeclaredFields():
            if f.getName() == name:
                f.setAccessible(True)
                return f.get(obj)
        cls = cls.getSuperclass()
    raise Exception("field not found: %s" % name)


# ---------- Сеть ----------

def _send(req, cb):
    acc = UserConfig.selectedAccount
    ConnectionsManager.getInstance(acc).sendRequest(req, _Delegate(cb))


def _toast(text):
    run_on_ui_thread(lambda: BulletinHelper.show_info(text))


def _delete_request(input_gift):
    req = jclass(TL + "saveStarGift")()
    req.flags = MARKER
    req.stargift = input_gift
    return req


# ---------- Диалог подтверждения ----------

def _confirm(message, on_yes):
    def show():
        builder = jclass("org.telegram.ui.ActionBar.AlertDialog$Builder")(get_last_fragment().getParentActivity())
        builder.setTitle("Удалить?")
        builder.setMessage(message)
        builder.setPositiveButton("Удалить", _DialogClick(on_yes))
        builder.setNegativeButton("Отмена", None)
        builder.show()

    run_on_ui_thread(show)


# ---------- Удаление одного подарка (кнопка в шторке) ----------

def _ensure_button(sheet):
    """Красная кнопка «Удалить подарок» для обычных подарков из своего профиля."""
    try:
        me = UserConfig.getInstance(UserConfig.selectedAccount).getClientUserId()
        if _call(sheet, "getDialogId") != me:
            return
        if _call(sheet, "getUniqueGift") is not None:  # NFT не трогаем
            return
        if _call(sheet, "getInputStarGift") is None:
            return
        layout = _field(sheet, "infoLayout")
        if layout is None:
            return
        for i in range(layout.getChildCount()):
            if str(layout.getChildAt(i).getTag()) == BUTTON_TAG:
                return

        button = jclass("android.widget.TextView")(layout.getContext())
        button.setTag(BUTTON_TAG)
        button.setText("Удалить подарок")
        button.setTextSize(15.0)
        button.setGravity(17)
        button.setTextColor(jclass("android.graphics.Color").parseColor("#E53935"))
        button.setPadding(0, AndroidUtilities.dp(14), 0, AndroidUtilities.dp(14))
        button.setOnClickListener(_ViewClick(lambda: _confirm_delete_one(sheet)))
        layout.addView(button, jclass("android.widget.LinearLayout$LayoutParams")(-1, -2))
    except Exception as e:
        log("delete_gifts button error: %s" % e)


def _confirm_delete_one(sheet):
    _confirm(
        "Подарок будет безвозвратно удалён из аккаунта. Это действие нельзя отменить.",
        lambda: _delete_one(sheet),
    )


def _delete_one(sheet):
    try:
        req = _delete_request(_call(sheet, "getInputStarGift"))
    except Exception as e:
        _toast("Ошибка: %s" % e)
        return

    def cb(resp, err):
        if err is not None or resp is None:
            _toast("Ошибка: %s" % (err.text if err is not None else "нет ответа"))
            return

        def done():
            try:
                listener = _field(sheet, "onGiftUpdatedListener")
                if listener is not None:
                    listener.run()  # обновить список подарков в профиле
            except Exception as e:
                log("delete_gifts listener error: %s" % e)
            try:
                sheet.dismiss()
            except Exception:
                pass
            BulletinHelper.show_info("Подарок удалён")

        run_on_ui_thread(done)

    _send(req, cb)


# ---------- Плагин ----------

class DeleteGiftsPlugin(BasePlugin):
    def on_plugin_load(self):
        try:
            n1 = self._hook("org.telegram.tgnet.tl.TL_stars$saveStarGift", "serializeToStream", _SerializeHook())
            n2 = self._hook("org.telegram.ui.Stars.StarGiftSheet", "set", _SheetSetHook(), first_param="SavedStarGift")
            log("delete_gifts: hooks serialize=%d, sheet=%d" % (n1, n2))
        except Exception as e:
            log("delete_gifts hook error: %s" % e)

    def _hook(self, class_name, method_name, hook, first_param=None):
        count = 0
        for m in Class.forName(class_name).getDeclaredMethods():
            if m.getName() != method_name:
                continue
            if first_param is not None:
                params = m.getParameterTypes()
                if len(params) == 0 or params[0].getSimpleName() != first_param:
                    continue
            self.hook_method(m, hook)
            count += 1
        return count
