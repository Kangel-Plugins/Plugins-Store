    @classmethod
    def g(cls, key: str, *args) -> str:
        is_ru = True
        try:
            account = int(UserConfig.selectedAccount)
            mc = MessagesController.getInstance(account)
            if mc is not None:
                code = str(getattr(mc, "suggestedLangCode", "") or "").lower()
                if code.startswith("ru"):
                    is_ru = True
                elif code:
                    is_ru = False
                else:
                    from java.util import Locale
                    code2 = str(Locale.getDefault().getLanguage()).lower()
                    is_ru = code2.startswith("ru")
        except Exception:
            pass

        entry = cls._T.get(key)
        if not entry:
            return key
        val = entry.get("ru" if is_ru else "en", entry.get("en", key))
        if args:
            try:
                return val.format(*args)
            except Exception:
                return val
        return val


def _activity():
    try:
        f = get_last_fragment()
        if f is not None:
            return f.getParentActivity()
    except Exception:
        pass
    return None


def _find_current_fragment(view=None):
    try:
        f = get_last_fragment()
        if f is not None:
            return f
    except Exception:
        pass
    if view is not None:
        try:
            ctx = view.getContext()
            while ctx is not None:
                if hasattr(ctx, "getActionBarLayout"):
                    layout = ctx.getActionBarLayout()
                    if layout is not None:
                        f = layout.getLastFragment()
                        if f is not None:
                            return f
                if hasattr(ctx, "getBaseContext"):
                    ctx = ctx.getBaseContext()
                else:
                    break
        except Exception:
            pass
    try:
        act = _activity()
        if act is not None and hasattr(act, "getActionBarLayout"):
            layout = act.getActionBarLayout()
            if layout is not None:
                return layout.getLastFragment()
    except Exception:
        pass
    return None


def _get_account_title(account: int) -> str:
    try:
        user = UserConfig.getInstance(int(account)).getCurrentUser()
        if user is not None:
            name_parts = []
            if user.first_name:
                name_parts.append(str(user.first_name))
            if user.last_name:
                name_parts.append(str(user.last_name))
            name = " ".join(name_parts).strip()
            if name:
                return name
            if user.username:
                return "@" + str(user.username)
    except Exception:
        pass
    return "Account %d" % (int(account) + 1)


def _acc_key(key: str, account: int) -> str:
    return "acc_%d_%s" % (int(account), key)


def _get_account_setting(plugin, key: str, account: int, default=False):
    k = _acc_key(key, account)
    val = plugin.get_setting(k, None)
    if val is not None:
        return val
    if account == 0:
        legacy_val = plugin.get_setting(key, None)
        if legacy_val is not None:
            plugin.set_setting(k, legacy_val)
            return legacy_val
    return default


def _get_account_exceptions(plugin, account: int) -> set:
    k = _acc_key(SETTING_EXCEPTIONS, account)
    raw = plugin.get_setting(k, None)
    if raw is None and account == 0:
        raw = plugin.get_setting(SETTING_EXCEPTIONS, None)
    if not raw:
        return set()
    try:
        data = json.loads(str(raw))
        return set(int(x) for x in data if int(x) != 0)
    except Exception:
        return set()


def _save_account_exceptions(plugin, account: int, exceptions: set):
    k = _acc_key(SETTING_EXCEPTIONS, account)
    ids = sorted(list(exceptions))
    plugin.set_setting(k, json.dumps(ids))


def _get_dialog_type(did, mc):
    if did > 0:
        user = mc.getUser(jlong(did))
        if user is not None and getattr(user, "bot", False):
            return "bot"
        return "private"
    else:
        chat = mc.getChat(jlong(-did))
        if chat is None:
            return "unknown"
        if ChatObject.isChannel(chat):
            if getattr(chat, "megagroup", False):
                return "supergroup"
            return "channel"
        return "group"


def _get_dialog_info(did, mc):
    title = ""
    icon = "msg_groups"
    subtext = ""
    try:
        if did > 0:
            user = mc.getUser(jlong(did))
            if user is not None:
                name_parts = []
                if user.first_name:
                    name_parts.append(str(user.first_name))
                if user.last_name:
                    name_parts.append(str(user.last_name))
                title = " ".join(name_parts).strip() or str(user.username or "") or ("ID: %d" % did)
                if getattr(user, "bot", False):
                    icon = "msg_bot"
                    subtext = L.g("type_bot")
                else:
                    icon = "msg_user"
                    subtext = L.g("type_user")
                if user.username:
                    subtext = "@%s • %s" % (user.username, subtext)
            else:
                title = "ID: %d" % did
                icon = "msg_user"
                subtext = L.g("type_user")
        else:
            chat = mc.getChat(jlong(-did))
            if chat is not None:
                title = str(chat.title or ("ID: %d" % did))
                if ChatObject.isChannel(chat):
                    if getattr(chat, "megagroup", False):
                        icon = "msg_groups"
                        subtext = L.g("type_supergroup")
                    else:
                        icon = "msg_channel"
                        subtext = L.g("type_channel")
                else:
                    icon = "msg_groups"
                    subtext = L.g("type_group")
                if getattr(chat, "username", None):
                    subtext = "@%s • %s" % (chat.username, subtext)
            else:
                title = "ID: %d" % did
                icon = "msg_channel"
                subtext = L.g("type_chat")
    except Exception:
        title = "ID: %d" % did
        icon = "msg_help"
        subtext = ""
    return title, icon, subtext


def _get_selected_types(plugin, account: int):
    types = []
    if _get_account_setting(plugin, SETTING_PRIVATE, account, False):
        types.append("private")
    if _get_account_setting(plugin, SETTING_BOTS, account, False):
        types.append("bot")
    if _get_account_setting(plugin, SETTING_GROUPS, account, False):
        types.append("group")
    if _get_account_setting(plugin, SETTING_SUPERGROUPS, account, False):
        types.append("supergroup")
    if _get_account_setting(plugin, SETTING_CHANNELS, account, False):
        types.append("channel")
    return types


def _archive_dialogs(dialog_ids, account, mc, plugin):
    if not dialog_ids:
        return 0

    try:
        req = TLRPC.TL_folders_editPeerFolders()
        req.folder_peers = ArrayList()

        for did in dialog_ids:
            try:
                peer = mc.getInputPeer(jlong(did))
                if peer is None:
                    plugin.log("archiver[acc=%d]: inputPeer is None for %d" % (account, did))
                    continue

                dialog = mc.dialogs_dict.get(jlong(did))
                if dialog is not None:
                    dialog.folder_id = 1

                folder_peer = TLRPC.TL_inputFolderPeer()
                folder_peer.folder_id = 1
                folder_peer.peer = peer
                req.folder_peers.add(folder_peer)
                plugin.log("archiver[acc=%d]: added %d to request" % (account, did))
            except Exception as e:
                plugin.log("archiver[acc=%d]: error building peer for %d: %s" % (account, did, repr(e)))

        if req.folder_peers.size() == 0:
            plugin.log("archiver[acc=%d]: no peers to archive" % account)
            return 0

        count = req.folder_peers.size()
        plugin.log("archiver[acc=%d]: sending TL_folders_editPeerFolders with %d peers" % (account, count))

        cb = RequestCallback(lambda r, e: plugin.log(
            "archiver[acc=%d]: server response err=%s" % (account, repr(e))))

        try:
            ConnectionsManager.getInstance(int(account)).sendRequest(req, cb)
        except Exception:
            send_request(req, cb)

        try:
            NotificationCenter.getInstance(int(account)).postNotificationName(
                NotificationCenter.dialogsNeedReload
            )
        except Exception:
            pass

        return count
    except Exception as e:
        plugin.log("archiver[acc=%d]: _archive_dialogs exception: %s" % (account, repr(e)))
        return 0


def _run_archive(plugin, account=None):
    with _lock:
        try:
            if account is None:
                account = int(UserConfig.selectedAccount)
            else:
                account = int(account)

            mc = MessagesController.getInstance(account)
            if mc is None:
                plugin.log("archiver[acc=%d]: MessagesController is None" % account)
                return

            selected = _get_selected_types(plugin, account)
            plugin.log("archiver[acc=%d]: selected types = %s" % (account, repr(selected)))
            if not selected:
                return

            exceptions = _get_account_exceptions(plugin, account)
            plugin.log("archiver[acc=%d]: exceptions count = %d" % (account, len(exceptions)))

            dialogs = mc.dialogs_dict
            plugin.log("archiver[acc=%d]: dialogs_dict size = %d" % (account, dialogs.size()))
            to_archive = []

            for i in range(dialogs.size()):
                did = int(dialogs.keyAt(i))
                if did == 0 or did in exceptions:
                    continue

                dialog = dialogs.get(jlong(did))
                if dialog is None:
                    continue

                if int(getattr(dialog, "folder_id", 0)) == 1:
                    continue

                dtype = _get_dialog_type(did, mc)
                if dtype in selected:
                    to_archive.append(did)

            plugin.log("archiver[acc=%d]: found %d dialogs to archive" % (account, len(to_archive)))

            if to_archive:
                archived = _archive_dialogs(to_archive, account, mc, plugin)
                final_count = archived

                def show_result():
                    BulletinHelper.show_info(L.g("archived_result", final_count))

                run_on_ui_thread(show_result)
            else:
                run_on_ui_thread(lambda: BulletinHelper.show_info(L.g("no_chats_to_archive")))

        except Exception as e:
            plugin.log("archiver[acc=%d]: _run_archive exception: %s" % (account, repr(e)))


def _on_switch_changed(plugin, key, value, account):
    plugin.log("archiver[acc=%d]: on_change key=%s value=%s" % (account, key, repr(value)))
    if value:
        threading.Thread(target=_run_archive, args=(plugin, account), daemon=True).start()


def _open_exceptions_picker(plugin, account, *args):
    view = args[0] if args else None

    def _ui():
        try:
            frag = _find_current_fragment(view)
            if not frag:
                plugin.log("archiver: fragment not found in _open_exceptions_picker")
                return

            USA = jclass("org.telegram.ui.UsersSelectActivity")
            DelCls = None
            try:
                DelCls = jclass("org.telegram.ui.UsersSelectActivity$FilterUsersActivityDelegate")
            except Exception:
                try:
                    DelCls = getattr(USA, "FilterUsersActivityDelegate", None)
                except Exception:
                    pass

            if USA is None or DelCls is None:
                plugin.log("archiver: UsersSelectActivity or FilterUsersActivityDelegate class not found")
                return

            act = None
            try:
                act = USA(False, ArrayList(), 0)
            except Exception:
                try:
                    act = USA(True, ArrayList(), 0)
                except Exception:
                    try:
                        act = USA(0)
                    except Exception as e0:
                        plugin.log("archiver: USA ctor error: %s" % repr(e0))
                        return

            try:
                act.noChatTypes = True
            except Exception:
                pass
            try:
                act.doNotNewChats = True
            except Exception:
                pass

            class PickerDelegate(dynamic_proxy(DelCls)):
                def didSelectChats(s_self, dids, flags):
                    try:
                        ids = []
                        if dids is not None:
                            try:
                                it = dids.iterator()
                                while it.hasNext():
                                    ids.append(int(it.next()))
                            except Exception:
                                for i in range(dids.size()):
                                    try:
                                        ids.append(int(dids.get(i)))
                                    except Exception:
                                        pass
                        if ids:
                            def save_and_notify():
                                current_exceptions = _get_account_exceptions(plugin, account)
                                added = 0
                                for did in ids:
                                    if did != 0 and did not in current_exceptions:
                                        current_exceptions.add(did)
                                        added += 1
                                if added > 0:
                                    _save_account_exceptions(plugin, account, current_exceptions)
                                    BulletinHelper.show_info(L.g("exceptions_added", added))
                                else:
                                    BulletinHelper.show_info(L.g("no_new_exceptions"))
                            run_on_ui_thread(save_and_notify)
                    except Exception as e:
                        plugin.log("archiver: didSelectChats error: %s" % repr(e))

            act.setDelegate(PickerDelegate())
            frag.presentFragment(act)
        except Exception as e:
            plugin.log("archiver: _open_exceptions_picker error: %s" % repr(e))
            plugin.log(traceback.format_exc())

    run_on_ui_thread(_ui)


def _create_exceptions_sub_fragment(plugin, account):
    def factory():
        mc = MessagesController.getInstance(account)
        exceptions = _get_account_exceptions(plugin, account)
        items = []

        items.append(
            Text(
                text=L.g("add_exceptions"),
                subtext=L.g("add_exceptions_sub"),
                icon="msg_add",
                on_click=lambda *args: _open_exceptions_picker(plugin, account, *args),
            )
        )
        items.append(Divider())

        items.append(Header(text=L.g("exceptions_list_header", len(exceptions))))

        if not exceptions:
            items.append(
                Text(
                    text=L.g("no_exceptions"),
                    subtext=L.g("no_exceptions_sub"),
                    icon="msg_info",
                )
            )
        else:
            sorted_exceptions = sorted(list(exceptions))
            for did in sorted_exceptions:
                title, icon, sub = _get_dialog_info(did, mc)

                def make_on_click(cur_did, cur_title):
                    def on_click(*args):
                        def show_dialog():
                            activity = _activity()
                            if activity is None:
                                return
                            b = AlertDialogBuilder(activity)
                            b.set_title(L.g("remove_exception_title"))
                            b.set_message(L.g("remove_exception_confirm", cur_title))

                            def do_remove(d, w):
                                d.dismiss()
                                cur_set = _get_account_exceptions(plugin, account)
                                if cur_did in cur_set:
                                    cur_set.remove(cur_did)
                                    _save_account_exceptions(plugin, account, cur_set)
                                    BulletinHelper.show_info(L.g("exception_removed"))

                            b.set_positive_button(L.g("remove"), do_remove)
                            b.set_negative_button(L.g("cancel"), lambda d, w: d.dismiss())
                            b.show()

                        run_on_ui_thread(show_dialog)
                    return on_click

                items.append(
                    Text(
                        text=title,
                        subtext=sub,
                        icon=icon,
                        on_click=make_on_click(did, title),
                    )
                )

            items.append(Divider())

            def on_clear_all(*args):
                def show_clear_dialog():
                    activity = _activity()
                    if activity is None:
                        return
                    b = AlertDialogBuilder(activity)
                    b.set_title(L.g("clear_all_confirm_title"))
                    b.set_message(L.g("clear_all_confirm_msg"))

                    def do_clear(d, w):
                        d.dismiss()
                        _save_account_exceptions(plugin, account, set())
                        BulletinHelper.show_info(L.g("exceptions_cleared"))

                    b.set_positive_button(L.g("clear"), do_clear)
                    b.set_negative_button(L.g("cancel"), lambda d, w: d.dismiss())
                    b.show()

                run_on_ui_thread(show_clear_dialog)

            items.append(
                Text(
                    text=L.g("clear_all_exceptions"),
                    subtext=L.g("clear_all_confirm_msg"),
                    icon="msg_delete",
                    red=True,
                    on_click=on_clear_all,
                )
            )

        return items

    return factory


class _NewDialogHook(MethodHook):
    def __init__(self, plugin):
        MethodHook.__init__(self)
        self._plugin = plugin

    def after_hooked_method(self, param):
        plugin = self._plugin
        try:
            mc = param.thisObject
            if mc is not None:
                account = int(getattr(mc, "currentAccount", UserConfig.selectedAccount))
            else:
                account = int(UserConfig.selectedAccount)
                mc = MessagesController.getInstance(account)

            if mc is None:
                return

            selected = _get_selected_types(plugin, account)
            if not selected:
                return

            messages = param.args[1] if len(param.args) > 1 else None
            if messages is None:
                return

            exceptions = _get_account_exceptions(plugin, account)
            dialog_ids_to_archive = []

            for i in range(messages.size()):
                msg_obj = messages.get(i)
                if msg_obj is None:
                    continue

                try:
                    did = int(msg_obj.getDialogId())
                except Exception:
                    continue

                if did == 0 or did in exceptions:
                    continue

                dialog = mc.dialogs_dict.get(jlong(did))
                if dialog is None:
                    continue

                if int(getattr(dialog, "folder_id", 0)) == 1:
                    continue

                dtype = _get_dialog_type(did, mc)
                if dtype in selected:
                    dialog_ids_to_archive.append(did)

            if dialog_ids_to_archive:
                plugin.log("archiver[acc=%d]: auto-archiving %d new dialogs" % (account, len(dialog_ids_to_archive)))
                _archive_dialogs(dialog_ids_to_archive, account, mc, plugin)

        except Exception as e:
            plugin.log("archiver: hook error: %s" % repr(e))


class Archiver(BasePlugin):

    def on_plugin_load(self):
        global _plugin_ref
        _plugin_ref = self
        self.log("archiver: plugin loaded")
        self._install_hooks()

    def on_plugin_unload(self):
        global _plugin_ref
        _plugin_ref = None

    def _install_hooks(self):
        try:
            mc_cls = find_class("org.telegram.messenger.MessagesController")
            if mc_cls is None:
                self.log("archiver: MessagesController class not found")
                return

            hook = _NewDialogHook(self)

            for m in mc_cls.getClass().getDeclaredMethods():
                if str(m.getName()) == "updateInterfaceWithMessages":
                    try:
                        m.setAccessible(True)
                    except Exception:
                        pass
                    ref = self.hook_method(m, hook)
                    if ref is not None:
                        self.log("archiver: hooked updateInterfaceWithMessages")
                    break
        except Exception as e:
            self.log("archiver: hook install error: %s" % repr(e))

    def create_settings(self) -> List[Any]:
        me = self
        acc = int(UserConfig.selectedAccount)
        acc_title = _get_account_title(acc)
        exceptions = _get_account_exceptions(me, acc)

        def make_on_change(name):
            def on_change(value):
                _on_switch_changed(me, name, value, acc)
            return on_change

        items = [
            Header(text=L.g("current_account", acc_title)),
            Divider(text=L.g("account_hint")),
            Header(text=L.g("header_chat_types")),
            Switch(
                key=_acc_key(SETTING_PRIVATE, acc),
                text=L.g("setting_private"),
                default=_get_account_setting(me, SETTING_PRIVATE, acc, False),
                subtext=L.g("setting_private_sub"),
                on_change=make_on_change(SETTING_PRIVATE),
            ),
            Switch(
                key=_acc_key(SETTING_BOTS, acc),
                text=L.g("setting_bots"),
                default=_get_account_setting(me, SETTING_BOTS, acc, False),
                subtext=L.g("setting_bots_sub"),
                on_change=make_on_change(SETTING_BOTS),
            ),
            Switch(
                key=_acc_key(SETTING_GROUPS, acc),
                text=L.g("setting_groups"),
                default=_get_account_setting(me, SETTING_GROUPS, acc, False),
                subtext=L.g("setting_groups_sub"),
                on_change=make_on_change(SETTING_GROUPS),
            ),
            Switch(
                key=_acc_key(SETTING_SUPERGROUPS, acc),
                text=L.g("setting_supergroups"),
                default=_get_account_setting(me, SETTING_SUPERGROUPS, acc, False),
                subtext=L.g("setting_supergroups_sub"),
                on_change=make_on_change(SETTING_SUPERGROUPS),
            ),
            Switch(
                key=_acc_key(SETTING_CHANNELS, acc),
                text=L.g("setting_channels"),
                default=_get_account_setting(me, SETTING_CHANNELS, acc, False),
                subtext=L.g("setting_channels_sub"),
                on_change=make_on_change(SETTING_CHANNELS),
            ),
            Divider(),
            Header(text=L.g("header_exceptions")),
            Text(
                text=L.g("add_exceptions"),
                subtext=L.g("add_exceptions_sub"),
                icon="msg_add",
                on_click=lambda *args: _open_exceptions_picker(me, acc, *args),
            ),
            Text(
                text=L.g("exceptions_title"),
                subtext=L.g("exceptions_sub", len(exceptions)),
                icon="msg_block2",
                create_sub_fragment=_create_exceptions_sub_fragment(me, acc),
            ),
        ]
        return items


