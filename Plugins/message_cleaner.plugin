_LANG = [0]


def _log(text):
    log(f"{TAG} {text}")


def _ru(lang_idx=None):
    if lang_idx is None:
        lang_idx = 0
    if lang_idx == 1:
        return True
    if lang_idx == 2:
        return False
    try:
        code = str(LocaleController.getInstance().getCurrentLocaleInfo().pluralLangCode or "")
        return code[:2] in ("ru", "uk", "be")
    except:
        return False


def _t(ru, en):
    return ru if _ru(_LANG[0]) else en


def _num(n):
    return f"{n:,}".replace(",", "\u202f")


def _msgs(n):
    if not _ru(_LANG[0]):
        return f"{_num(n)} message{'s' if n != 1 else ''}"
    r10, r100 = n % 10, n % 100
    if r10 == 1 and r100 != 11:
        return f"{_num(n)} сообщение"
    if 2 <= r10 <= 4 and not 12 <= r100 <= 14:
        return f"{_num(n)} сообщения"
    return f"{_num(n)} сообщений"


def _chats_word(n):
    if not _ru(_LANG[0]):
        return f"{_num(n)} chat{'s' if n != 1 else ''}"
    r10, r100 = n % 10, n % 100
    if r10 == 1 and r100 != 11:
        return f"{_num(n)} чате"
    return f"{_num(n)} чатах"


def _chats_gen(n):
    if not _ru(_LANG[0]):
        return f"{_num(n)} chat{'s' if n != 1 else ''}"
    r10, r100 = n % 10, n % 100
    if r10 == 1 and r100 != 11:
        return f"{_num(n)} чата"
    return f"{_num(n)} чатов"


