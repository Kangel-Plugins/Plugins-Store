__id__ = "unlim_accounts"
__name__ = "Unlim Accounts"
__description__ = "Raises the account limit to 999. Only **13.1.1**."
__author__ = "@rezolvePlugins"
__version__ = "1.1"
__app_version__ = "==13.1.1"
__category__ = ["tools"]
__sdk_version__ = ">=1.4.5.7"

import base64
import hashlib
import json
import os
import tempfile
import zlib

from android_utils import run_on_ui_thread
from base_plugin import AppEvent, BasePlugin, MethodHook
from hook_utils import find_class
from java import jarray, jclass
from java.lang import Boolean, Integer, Object, Thread
from org.telegram.messenger import ApplicationLoader


USE_HOST_RESULT = object()

Build = jclass("android.os.Build")
BuildVersion = jclass("android.os.Build$VERSION")
Process = jclass("android.os.Process")


def _is_java_true(value):
    return value is True or str(value).lower() == "true"


def _read_payload(kind):
    begin_marker = "# __" + kind + "_BEGIN__"
    end_marker = "# __" + kind + "_END__"
    lines = []
    started = False
    finished = False
    with open(__file__, "r", encoding="utf-8") as source:
        for line in source:
            line = line.strip()
            if not started:
                started = line == begin_marker
            elif line == end_marker:
                finished = True
                break
            elif line.startswith("#"):
                lines.append(line[1:].strip())
    if not started or not finished:
        raise RuntimeError("Embedded payload markers are missing: " + kind)
    payload = "".join(lines)
    if not payload:
        raise RuntimeError("Embedded payload is empty")
    return zlib.decompress(base64.b64decode(payload))


def _matches_digest(path, expected_size, expected_sha):
    try:
        if os.path.getsize(path) != expected_size:
            return False
        digest = hashlib.sha256()
        with open(path, "rb") as source:
            while True:
                chunk = source.read(32768)
                if not chunk:
                    break
                digest.update(chunk)
        return digest.hexdigest() == expected_sha
    except Exception:
        return False


def _current_abi(available):
    abis = Build.SUPPORTED_64_BIT_ABIS if Process.is64Bit() else Build.SUPPORTED_32_BIT_ABIS
    if abis is None or len(abis) == 0:
        raise RuntimeError("ABI списка текущего процесса недоступен")
    for value in abis:
        abi = str(value)
        if abi in available:
            return abi
    raise RuntimeError("Неподдерживаемая ABI процесса: " + ", ".join(map(str, abis)))


def _extract_native(allow_write=True):
    payload = _read_payload("NATIVE")
    bundle = json.loads(payload.decode("utf-8"))
    libs = bundle.get("libs")
    if bundle.get("format") != 2 or not isinstance(libs, dict):
        raise RuntimeError("Native payload schema is invalid")
    abi = _current_abi(libs)
    item = libs.get(abi)
    if not isinstance(item, dict):
        raise RuntimeError("Native payload is missing for " + abi)
    expected_size = int(item.get("size") or 0)
    expected_sha = str(item.get("sha256") or "").lower()

    context = ApplicationLoader.applicationContext
    if context is None:
        raise RuntimeError("Application context is not ready")
    root = str(context.getDir("unlim_accounts", 0).getAbsolutePath())
    target_dir = os.path.join(root, expected_sha, abi)
    target = os.path.join(target_dir, "libunlim_accounts_tgnet.so")
    if _matches_digest(target, expected_size, expected_sha):
        if allow_write:
            os.chmod(target, 0o500)
        return target
    if not allow_write:
        raise RuntimeError("Retained native runtime file changed; restart the client")

    raw = base64.b64decode(str(item.get("data") or ""))
    if len(raw) != expected_size or hashlib.sha256(raw).hexdigest() != expected_sha:
        raise RuntimeError("Native payload digest mismatch")
    os.makedirs(target_dir, exist_ok=True)
    descriptor, staged = tempfile.mkstemp(prefix=".native-", dir=target_dir)
    try:
        with os.fdopen(descriptor, "wb") as output:
            output.write(raw)
            output.flush()
            os.fsync(output.fileno())
        os.chmod(staged, 0o500)
        os.replace(staged, target)
    finally:
        try:
            os.unlink(staged)
        except OSError:
            pass
    return target


class RuntimeBridge:
    def __init__(self):
        # Build-owned identity prevents mixing different DEX/native generations.
        self.name = f"{__id__}:{__version__}:cd5f2c5941efcf57ee499042606a2a33fda77bf11a4b4710130cc13eeee69478"
        self.loader = None
        self.bridge = None
        self.method_cache = {}
        self.retained = False

    def prepare(self):
        if int(BuildVersion.SDK_INT) < 26:
            raise RuntimeError("Unlim Accounts требует Android 8.0 (API 26) или новее")
        if ApplicationLoader.applicationContext is None:
            raise RuntimeError("Контекст приложения ещё не готов")
        retained = self._find_retained()
        self.retained = retained is not None
        if self.bridge is not None:
            if retained is not None and retained != self.loader:
                raise RuntimeError("Another DEX class loader is retained; restart the client")
            return
        if retained is None:
            context = ApplicationLoader.applicationContext
            parent_loader = context.getClassLoader()
            if parent_loader is None:
                raise RuntimeError("Application class loader is not ready")
            ByteBuffer = jclass("java.nio.ByteBuffer")
            InMemoryDexClassLoader = jclass("dalvik.system.InMemoryDexClassLoader")
            self.loader = InMemoryDexClassLoader(
                ByteBuffer.wrap(_read_payload("DEX")),
                parent_loader,
            )
        else:
            self.loader = retained
        self.bridge = self.loader.loadClass("com.rezolve.unlimaccounts.UnlimBridge")

    def _find_retained(self):
        matches = []
        incompatible = []
        fingerprint = self.name.rsplit(":", 1)[1]
        for thread in Thread.getAllStackTraces().keySet().toArray():
            try:
                name = str(thread.getName() or "")
            except Exception:
                continue
            if not name.startswith(__id__ + ":"):
                continue
            # Python-only updates may reuse exactly the same DEX/native runtime.
            # The old four-part name used separate digests and is incompatible.
            parts = name.split(":")
            if len(parts) == 3 and parts[2] == fingerprint:
                matches.append(thread)
            else:
                incompatible.append(name)
        if incompatible:
            raise RuntimeError("Another Unlim Accounts runtime is loaded; restart the client")
        if not matches:
            return None
        if len(matches) != 1:
            raise RuntimeError("Ambiguous Unlim Accounts runtime; restart the client")
        loader = matches[0].getContextClassLoader()
        if loader is None:
            raise RuntimeError("Retained DEX has no class loader")
        return loader

    def invoke(self, name, *args):
        if self.bridge is None:
            raise RuntimeError("DEX runtime is not prepared")
        key = (name, len(args))
        if key not in self.method_cache:
            matches = []
            for method in self.bridge.getDeclaredMethods():
                if (
                    str(method.getName()) == name
                    and len(method.getParameterTypes()) == len(args)
                ):
                    method.setAccessible(True)
                    matches.append(method)
            if len(matches) != 1:
                raise RuntimeError("Invalid bridge method: %s/%d" % key)
            self.method_cache[key] = matches[0]
        try:
            return self.method_cache[key].invoke(None, jarray(Object)(args))
        except Exception as exc:
            messages = []
            try:
                cause = exc.getCause()
            except Exception:
                cause = None
            for _ in range(8):
                if cause is None:
                    break
                try:
                    message = str(cause.getMessage() or cause)
                except Exception:
                    message = str(cause)
                if message and message not in messages:
                    messages.append(message)
                try:
                    next_cause = cause.getCause()
                except Exception:
                    next_cause = None
                if next_cause is cause:
                    break
                cause = next_cause
            if messages:
                raise RuntimeError(" -> ".join(messages))
            raise


class ScopedAccountHook(MethodHook):
    def __init__(self, plugin, name, resolve, arities):
        self.plugin = plugin
        self.generation = plugin.hook_generation
        self.name = name
        self.resolve = resolve
        self.arities = arities

    def before_hooked_method(self, param):
        try:
            if not self.plugin.active or self.generation != self.plugin.hook_generation:
                return
            if len(param.args) not in self.arities:
                return
            result = self.resolve(param.args)
            if result is not USE_HOST_RESULT:
                param.setResult(result)
        except Exception as exc:
            self.plugin.log_once(
                "account_query_" + self.name,
                "Unlim Accounts: %s failed: %s" % (self.name, exc),
            )


class AccountQueries:
    def __init__(self, bridge):
        self.bridge = bridge

    def valid(self, args):
        state = int(self.bridge.invoke("extraAccountState", int(args[0])))
        return Boolean(state != 0) if state >= 0 else USE_HOST_RESULT

    def count(self, args):
        return Integer(int(self.bridge.invoke("activatedAccountsCount")))

    def premium(self, args):
        return Boolean(_is_java_true(self.bridge.invoke("hasPremiumAccounts")))

    def activated(self, args):
        return self.bridge.invoke("activatedAccounts", args[0] if args else None)

    def has_space(self, args):
        return Boolean(int(self.bridge.invoke("firstFreeAccount")) >= 0)

    def free_slot(self, args):
        slot = int(self.bridge.invoke("firstFreeAccount"))
        return Integer(slot) if slot >= 0 else None

    def after_logout(self, args):
        switched = self.bridge.invoke("switchToAvailableExtra")
        return None if _is_java_true(switched) else USE_HOST_RESULT


class UnlimAccountsPlugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self.dex = RuntimeBridge()
        self.unhooks = []
        self.logged = set()
        self.active = False
        self.hook_generation = 0
        self.runtime_started = False
        self.activation_generation = None

    def on_plugin_load(self):
        if self.active:
            return
        self.logged.clear()
        self.active = False
        try:
            if not self._clear_hooks():
                raise RuntimeError("Previous UI hooks could not be removed; restart the client")
            if self.runtime_started and not self._stop_runtime():
                raise RuntimeError("Previous runtime cleanup failed; restart the client")
            self.dex.prepare()
            native_path = _extract_native(allow_write=not self.dex.retained)
            expanded = self.dex.invoke("install", native_path, self.dex.name)
            self.runtime_started = True
            expanded = int(expanded)
            probe_time = int(self.dex.invoke("runSelfTest"))
            preloaded = int(self.dex.invoke("preloadExtraAccountConfigs"))
            self.activation_generation = int(self.dex.invoke("beginActivation"))
            self._install_hooks()
            self.dex.invoke("reconcileExtraAccounts", self.activation_generation)
            self.active = True
            self._schedule_lifecycle_reconciliation()
            self.log(
                "Unlim Accounts включён: расширено полей — %d, загружено аккаунтов — %d, проверка маршрута — %d"
                % (expanded, preloaded, probe_time)
            )
        except Exception:
            self.active = False
            self._clear_hooks()
            self._stop_runtime()
            raise

    def on_plugin_unload(self):
        self.active = False
        if not self._clear_hooks():
            self.log_once("unhook_failed", "Some UI hooks could not be removed; restart the client")
        self._stop_runtime()

    def _stop_runtime(self):
        if not self.runtime_started or self.dex.bridge is None:
            return True
        succeeded = True
        cleanups = []
        if self.activation_generation is not None:
            cleanups.append(("deactivate", (self.activation_generation,)))
        cleanups.append(("prepareForUnload", ()))
        for method, args in cleanups:
            for attempt in range(2):
                try:
                    result = self.dex.invoke(method, *args)
                    if method == "prepareForUnload" and not _is_java_true(result):
                        raise RuntimeError("Unload preparation did not complete")
                    break
                except Exception as exc:
                    if attempt == 1:
                        succeeded = False
                        self.log_once("cleanup_" + method, "%s failed twice: %s" % (method, exc))
        if succeeded:
            self.runtime_started = False
            self.activation_generation = None
        return succeeded

    def on_app_event(self, event_type):
        generation = self.activation_generation
        if not self.active or generation is None:
            return
        if event_type in (AppEvent.RESUME, AppEvent.PAUSE, AppEvent.STOP):
            try:
                self.dex.invoke("reconcileExtraAccounts", generation)
            except Exception as exc:
                self.log_once("reconcile_accounts", "Account reconciliation failed: %s" % exc)

    def _schedule_lifecycle_reconciliation(self):
        generation = self.hook_generation
        activation = self.activation_generation

        def reconcile(attempts):
            try:
                if not self.active or generation != self.hook_generation:
                    return
                if not _is_java_true(getattr(self, "enabled", False)):
                    if attempts > 1:
                        run_on_ui_thread(lambda: reconcile(attempts - 1), 50)
                    return
                self.dex.invoke("reconcileExtraAccounts", activation)
            except Exception as exc:
                self.log_once(
                    "lifecycle_reconciliation",
                    "Lifecycle reconciliation failed: %s" % exc,
                )

        try:
            run_on_ui_thread(lambda: reconcile(20))
        except Exception as exc:
            self.log_once(
                "schedule_lifecycle_reconciliation",
                "Could not schedule lifecycle reconciliation: %s" % exc,
            )

    def _install_hooks(self):
        queries = AccountQueries(self.dex)
        bindings = (
            ("org.telegram.messenger.UserConfig", (
                ("isValidAccount", queries.valid, (1,)),
                ("getActivatedAccountsCount", queries.count, (0,)),
                ("hasPremiumOnAccounts", queries.premium, (0,)),
            )),
            ("com.exteragram.messenger.utils.ui.AccountsUiHelper", (
                ("activated", queries.activated, (0, 1)),
                ("hasFreeSlot", queries.has_space, (0,)),
                ("freeSlotWithinLimit", queries.free_slot, (0,)),
            )),
            ("org.telegram.ui.LaunchActivity", (
                ("switchToAvailableAccountOrLogout", queries.after_logout, (0,)),
            )),
        )
        for class_name, methods in bindings:
            target = find_class(class_name)
            if target is None:
                raise RuntimeError("Required client class is missing: " + class_name)
            for name, resolve, arities in methods:
                hook = ScopedAccountHook(self, name, resolve, arities)
                handles = self.hook_all_methods(target, name, hook, priority=10000)
                try:
                    handles = list(handles or ())
                except TypeError:
                    handles = [handles]
                handles = [handle for handle in handles if handle is not None]
                self.unhooks.extend(handles)
                if len(handles) != len(arities):
                    # on_plugin_load owns rollback, including partial registrations.
                    raise RuntimeError("Expected %d hook(s) for %s, got %d"
                                       % (len(arities), name, len(handles)))

    def _clear_hooks(self):
        self.hook_generation += 1
        for attempt in range(2):
            retained = []
            for unhook in reversed(list(self.unhooks)):
                try:
                    self.unhook_method(unhook)
                except Exception as exc:
                    retained.append(unhook)
                    if attempt == 1:
                        self.log_once(
                            "unhook_%d" % id(unhook),
                            "Could not remove UI hook: %s" % exc,
                        )
            self.unhooks[:] = reversed(retained)
            if not retained:
                return True
        return False

    def log_once(self, key, message):
        if key in self.logged:
            return
        self.logged.add(key)
        try:
            self.log(message)
        except Exception:
            pass


