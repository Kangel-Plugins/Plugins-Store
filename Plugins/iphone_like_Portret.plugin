import base64
import zlib
import threading
from base_plugin import BasePlugin
from java.nio import ByteBuffer
from dalvik.system import InMemoryDexClassLoader
from org.telegram.messenger import ApplicationLoader
from hook_utils import find_class
from ui.settings import Header, Divider, Switch, Input

__id__ = "iphone_like_Portret"
__name__ = "iPhone Like Portret"
__description__ = "Портретный режим аля Айфон на основе MLkit. РАЗМЫТИЕ ВИДНО ТОЛЬКО ПОСЛЕ ОТПРАВКИ КРУЖКА"
__author__ = "@dekma0091 && @DefinitelyNotDekma"
__version__ = "1.4"
__icon__ = "pixelcamera/8"
__min_version__ = "12.10.6"

try:
    from client_utils import run_on_queue, GLOBAL_QUEUE
    def _run_bg(task):
        try:
            run_on_queue(task, GLOBAL_QUEUE)
        except TypeError:
            try:
                run_on_queue(task)
            except Exception:
                threading.Thread(target=task, daemon=True).start()
except Exception:
    def _run_bg(task):
        threading.Thread(target=task, daemon=True).start()

class NativeBridge:
    def __init__(self, entry_class):
        self.entry_class = entry_class
        self.clazz = None
        self.loader = None
        self.loaded = False

    def load(self):
        if self.loaded:
            try: self.unload()
            except Exception: pass
        context = ApplicationLoader.applicationContext
        if context is None:
            raise RuntimeError("application context is not ready")
        if not _DEX_BASE64:
            raise RuntimeError("DEX payload is empty")
        raw_bytes = base64.b64decode(_DEX_BASE64)
        try:
            dex_bytes = zlib.decompress(raw_bytes)
        except Exception:
            dex_bytes = raw_bytes
        buffer = ByteBuffer.wrap(dex_bytes)
        self.loader = InMemoryDexClassLoader(buffer, context.getClassLoader())
        self.clazz = self.loader.loadClass(self.entry_class)
        ContextClass = find_class("android.content.Context")
        self.clazz.getMethod("attach", [ContextClass]).invoke(None, [context])
        self.loaded = True

    def update_config(self, cfg_str):
        if not self.loaded or self.clazz is None: return
        try:
            StringClass = find_class("java.lang.String")
            method = self.clazz.getMethod("updateConfigString", [StringClass])
            method.invoke(None, [cfg_str])
        except Exception: pass

    def unload(self):
        if self.clazz is not None:
            try:
                self.clazz.getMethod("detach", []).invoke(None, [])
            except Exception: pass
        self.clazz = None
        self.loader = None
        self.loaded = False

class VisionCorePlugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self.bridge = NativeBridge("ni.dekma.PortraitBridge")
        self._lock = threading.Lock()
        self.is_active = False
        self.is_loading = False

    def safe_f(self, key, def_val):
        try:
            val = self.get_setting(key, str(def_val))
            if val is None: return float(def_val)
            s = str(val).strip().replace(',', '.')
            if s in ('', '-', '.', '-.', '-0', '+'): return float(def_val)
            return float(s)
        except Exception:
            return float(def_val)

    def safe_b(self, key, def_val):
        val = self.get_setting(key, def_val)
        if isinstance(val, str):
            return val.lower() == "true"
        return bool(val)

    def safe_i(self, key, def_val):
        try:
            return int(self.safe_f(key, float(def_val)))
        except Exception:
            return int(def_val)

    def on_plugin_load(self):
        def _bg_init():
            with self._lock:
                if self.is_active or self.is_loading: return
                self.is_loading = True
            try:
                self.bridge.load()
                self._sync_config()
                with self._lock:
                    self.is_active = True
                    self.is_loading = False
            except Exception:
                with self._lock:
                    self.is_active = False
                    self.is_loading = False
        _run_bg(_bg_init)

    def on_plugin_unload(self):
        with self._lock:
            self.is_active = False
        self.bridge.unload()

    def _sync_config(self):
        try:
            blur = self.safe_f("blur_intensity", 9.0)
            m_start = self.safe_f("mask_start", 0.70)
            m_end = self.safe_f("mask_end", 1.65)
            lerp = self.safe_f("lerp_speed", 0.85)
            b_rear = 1 if self.safe_b("blur_rear_camera", False) else 0
            scale = self.safe_f("radius_scale", 0.82)
            ox = 0.0
            oy = 0.0
            swap = 0
            mx = 0
            my = 0
            shift = 1
            low = 1 if self.safe_b("low_latency", False) else 0
            res = self.safe_i("ml_resolution", 280)
            bilinear = 1 if self.safe_b("bilinear_filter", False) else 0
            grid = 1 if self.safe_b("debug_grid", False) else 0
            auto_calib = 1
            cfg_str = f"{blur};{m_start};{m_end};{lerp};{b_rear};{scale};{ox};{oy};{swap};{mx};{my};{shift};{low};{res};{bilinear};{grid};{auto_calib}"
            self.bridge.update_config(cfg_str)
        except Exception: pass

    def _on_cfg(self, key, val):
        self.set_setting(key, val)
        self._sync_config()

    def create_settings(self):
        return [
            Header(text="Эффект боке"),
            Switch(key="blur_rear_camera", text="Размывать заднюю камеру", default=False, on_change=lambda v: self._on_cfg("blur_rear_camera", v), icon="msg_video"),
            Input(key="radius_scale", text="Масштаб радиуса", default="0.82", on_change=lambda v: self._on_cfg("radius_scale", v), icon="msg_customize"),
            Input(key="blur_intensity", text="Сила размытия", default="9.0", on_change=lambda v: self._on_cfg("blur_intensity", v), icon="msg_photo"),
            Input(key="mask_start", text="Начало спада (0.0-1.0+)", default="0.70", on_change=lambda v: self._on_cfg("mask_start", v), icon="msg_customize"),
            Input(key="mask_end", text="Конец спада (1.0-5.0+)", default="1.65", on_change=lambda v: self._on_cfg("mask_end", v), icon="msg_customize"),
            Header(text="Производительность"),
            Switch(key="low_latency", text="Режим низкой задержки (Low Latency)", default=False, on_change=lambda v: self._on_cfg("low_latency", v), icon="msg_retry"),
            Input(key="ml_resolution", text="Разрешение ML Kit (пикс)", default="280", on_change=lambda v: self._on_cfg("ml_resolution", v), icon="msg_photo"),
            Switch(key="bilinear_filter", text="Билинейная фильтрация", default=False, on_change=lambda v: self._on_cfg("bilinear_filter", v), icon="msg_customize"),
            Input(key="lerp_speed", text="Плавность слежения", default="0.85", on_change=lambda v: self._on_cfg("lerp_speed", v), icon="msg_info"),
            Header(text="Отладка"),
            Switch(key="debug_grid", text="Отладочный маркер лица", default=False, on_change=lambda v: self._on_cfg("debug_grid", v), icon="msg_info"),
            Divider(text="Отображает контур маски и точку фокусировки для визуальной проверки.")
        ]

_DEX_BASE64 = ""
