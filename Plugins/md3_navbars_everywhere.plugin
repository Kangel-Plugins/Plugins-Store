from base_plugin import BasePlugin
from hook_utils import find_class
from org.telegram.messenger import AndroidUtilities
from org.telegram.ui.ActionBar import Theme
from org.telegram.ui.Components import LayoutHelper
from android.view import ViewGroup, View, Gravity
from android.widget import FrameLayout, LinearLayout
from java import jint, jfloat
from extera_utils.classes import Base, java_subclass, joverride

__id__ = "md3_navbars_everywhere"
__name__ = "MD3 Navbars Everywhere"
__description__ = "Applies MD3-styled navbars to attach menu, statistics and gifts preview screens. Requires exteraGram's MD3 navbar to be on."
__author__ = "@Slucket"
__version__ = "1.1.0"
__app_version__ = ">=13.2.0"
__category__ = ["appearance"]
__sdk_version__ = ">=1.4.4.3"

MAIN_TABS_HELPER_CLASSES = [
    "com.exteragram.messenger.utils.ui.tabs.MainTabsUiHelper",
    "com.exteragram.messenger.utils.ui.MainTabsUiHelper",
]

MAIN_TABS_HELPER = None

def get_main_tabs_helper():
    global MAIN_TABS_HELPER
    if MAIN_TABS_HELPER is None:
        for cls_name in MAIN_TABS_HELPER_CLASSES:
            cls = find_class(cls_name)
            if cls:
                MAIN_TABS_HELPER = cls
                break
    return MAIN_TABS_HELPER

def is_md3_enabled() -> bool:
    try:
        helper = get_main_tabs_helper()
        if helper and hasattr(helper, "isMaterial3NavigationBar"):
            return bool(helper.isMaterial3NavigationBar())
    except Exception:
        pass

    try:
        cfg = find_class("com.exteragram.messenger.ExteraConfig")
        if cfg and hasattr(cfg, "getNewNavigationBarStyle"):
            return bool(cfg.getNewNavigationBarStyle())
    except Exception:
        pass

    return False

def is_divider_enabled() -> bool:
    try:
        cfg = find_class("com.exteragram.messenger.ExteraConfig")
        if cfg and hasattr(cfg, "getDividerStyle"):
            return str(cfg.getDividerStyle()) != "HIDDEN"
    except Exception:
        pass
    return True

def fix_original_background(view):
    if not view:
        return
    bg = view.getBackground()
    if not bg:
        return

    try:
        if "InsetDrawable" in bg.getClass().getName():
            bg = bg.JA.getDrawable()
            view.setBackground(bg)
    except Exception:
        pass

    try:
        if hasattr(bg, "setRadius"):
            try:
                bg.JA.setRadius(jint(0))
            except Exception:
                bg.JA.setRadius(jfloat(0.0))
        elif hasattr(bg, "setCornerRadius"):
            try:
                bg.JA.setCornerRadius(jint(0))
            except Exception:
                bg.JA.setCornerRadius(jfloat(0.0))
    except Exception:
        pass

    try:
        if hasattr(bg, "setPadding"):
            try:
                bg.JA.setPadding(jint(0))
            except Exception:
                pass
    except Exception:
        pass

    try:
        if hasattr(bg, "getPaint"):
            paint = bg.JA.getPaint()
            if paint and hasattr(paint, "clearShadowLayer"):
                paint.clearShadowLayer()
    except Exception:
        pass

def invoke_set_main_tab_style(tab, plugin=None):
    if not tab:
        return
    if plugin:
        plugin.force_m3 += 1
    try:
        try:
            m = tab.getClass().getDeclaredMethod("setMainTabStyle")
            m.setAccessible(True)
            m.invoke(tab)
        except Exception:
            if hasattr(tab, "JA") and hasattr(tab.JA, "setMainTabStyle"):
                tab.JA.setMainTabStyle()
    except Exception:
        pass
    finally:
        if plugin:
            plugin.force_m3 = max(0, plugin.force_m3 - 1)

    try:
        if hasattr(tab, "JA"):
            if hasattr(tab.JA, "labelHidden"):
                tab.JA.labelHidden = False
            if hasattr(tab.JA, "textView") and tab.JA.textView:
                tab.JA.textView.setVisibility(0)
                tab.JA.textView.setTypeface(AndroidUtilities.bold())
                tab.JA.textView.setLayoutParams(LayoutHelper.createFrame(-1, 16.0, 49, 0.0, 42.0, 0.0, 0.0))
            if hasattr(tab.JA, "imageView") and tab.JA.imageView:
                tab.JA.imageView.setLayoutParams(LayoutHelper.createFrame(24, 24.0, 49, 0.0, 10.0, 0.0, 0.0))
            if hasattr(tab.JA, "backupImageView") and tab.JA.backupImageView:
                b_lp = tab.JA.backupImageView.getLayoutParams()
                if b_lp and b_lp.width == AndroidUtilities.dp(24.0):
                    tab.JA.backupImageView.setLayoutParams(LayoutHelper.createFrame(24, 24.0, 49, 0.0, 10.0, 0.0, 0.0))
                else:
                    tab.JA.backupImageView.setLayoutParams(LayoutHelper.createFrame(22, 22.0, 49, 0.0, 11.0, 0.0, 0.0))
    except Exception:
        pass

def style_glass_tabs(tabs_view, plugin):
    try:
        tabs = []
        if hasattr(tabs_view, "JA"):
            if hasattr(tabs_view.JA, "tabs") and tabs_view.JA.tabs:
                tabs.extend([t for t in tabs_view.JA.tabs if t])
            elif hasattr(tabs_view.JA, "getTabs") and tabs_view.JA.getTabs():
                tabs.extend([t for t in tabs_view.JA.getTabs() if t])

        if not tabs and isinstance(tabs_view, ViewGroup):
            def find_tabs(vg):
                for i in range(vg.getChildCount()):
                    child = vg.getChildAt(i)
                    if child and child.getClass().getSimpleName() == "GlassTabView":
                        tabs.append(child)
                    elif isinstance(child, ViewGroup):
                        find_tabs(child)
            find_tabs(tabs_view)

        for tab in tabs:
            invoke_set_main_tab_style(tab, plugin)

            try:
                if hasattr(tab, "JA") and hasattr(tab.JA, "selfMeasure"):
                    tab.JA.selfMeasure = False
            except Exception:
                pass

            try:
                lp = tab.getLayoutParams()
                if isinstance(lp, LinearLayout.LayoutParams) and (lp.width != 0 or lp.weight != 1.0):
                    lp.width, lp.weight = 0, 1.0
                    tab.setLayoutParams(lp)
            except Exception:
                pass

            try:
                if hasattr(tab, "JA"):
                    if hasattr(tab.JA, "labelHidden"):
                        tab.JA.labelHidden = False
                    if hasattr(tab.JA, "textView") and tab.JA.textView:
                        tab.JA.textView.setVisibility(0)
                        tab.JA.textView.setTypeface(AndroidUtilities.bold())
                        tab.JA.textView.setLayoutParams(LayoutHelper.createFrame(-1, 16.0, 49, 0.0, 42.0, 0.0, 0.0))
                    if hasattr(tab.JA, "imageView") and tab.JA.imageView:
                        tab.JA.imageView.setLayoutParams(LayoutHelper.createFrame(24, 24.0, 49, 0.0, 10.0, 0.0, 0.0))
                    if hasattr(tab.JA, "backupImageView") and tab.JA.backupImageView:
                        b_lp = tab.JA.backupImageView.getLayoutParams()
                        if b_lp and b_lp.width == AndroidUtilities.dp(24.0):
                            tab.JA.backupImageView.setLayoutParams(LayoutHelper.createFrame(24, 24.0, 49, 0.0, 10.0, 0.0, 0.0))
                        else:
                            tab.JA.backupImageView.setLayoutParams(LayoutHelper.createFrame(22, 22.0, 49, 0.0, 11.0, 0.0, 0.0))
            except Exception:
                pass

            try:
                if hasattr(tab, "JA") and hasattr(tab.JA, "isTabSelected") and hasattr(tab.JA, "setSelected"):
                    tab.JA.setSelected(tab.JA.isTabSelected(), False)
            except Exception:
                pass
    except Exception:
        pass

def setup_md3_navbar(tabs_view, nav_height, apply_padding=True, add_divider=True):
    if not tabs_view:
        return

    try:
        lp = tabs_view.getLayoutParams()
        if lp:
            lp.width = -1  # MATCH_PARENT
            lp.height = AndroidUtilities.dp(64) + int(nav_height)
            try:
                lp.leftMargin = 0
            except Exception:
                pass
            try:
                lp.rightMargin = 0
            except Exception:
                pass
            try:
                lp.bottomMargin = 0
            except Exception:
                pass
            try:
                lp.topMargin = 0
            except Exception:
                pass
            tabs_view.setLayoutParams(lp)
    except Exception:
        pass

    pad = AndroidUtilities.dp(12) if apply_padding else 0
    try:
        tabs_view.setPadding(pad, 0, pad, int(nav_height))
        tabs_view.setClipToPadding(False)
        tabs_view.setTranslationY(jfloat(0.0))
    except Exception:
        pass

    fix_original_background(tabs_view)

    try:
        if hasattr(tabs_view, "JA"):
            if hasattr(tabs_view.JA, "setLensColor"):
                tabs_view.JA.setLensColor(jint(0), jint(0))
            if hasattr(tabs_view.JA, "setFillAvailableWidth"):
                tabs_view.JA.setFillAvailableWidth(True)
            if hasattr(tabs_view.JA, "setMaxWidth"):
                tabs_view.JA.setMaxWidth(jint(0))
    except Exception:
        pass

    if add_divider:
        div_needed = is_divider_enabled()
        try:
            if hasattr(tabs_view, "JA") and hasattr(tabs_view.JA, "setDrawTopDivider"):
                tabs_view.JA.setDrawTopDivider(div_needed)
                tabs_view.invalidate()
                return
        except Exception:
            pass

        try:
            divider = tabs_view.findViewWithTag("md3_custom_divider")
            if div_needed:
                if not divider:
                    divider = View(tabs_view.getContext())
                    divider.setBackgroundColor(Theme.getColor(Theme.key_divider))
                    divider.setTag("md3_custom_divider")
                    div_lp = FrameLayout.LayoutParams(-1, max(1, AndroidUtilities.dp(0.5)))
                    div_lp.gravity = Gravity.TOP
                    tabs_view.addView(divider, div_lp)
                divider.setVisibility(0)
            elif divider:
                divider.setVisibility(8)
        except Exception:
            pass

@java_subclass(View)
class M3DividerView(Base):
    @joverride()
    def onDraw(self, canvas):
        try:
            if not is_divider_enabled():
                return
            paint = getattr(Theme, "forcedDividerPaint", None) or getattr(Theme, "dividerPaint", None)
            if paint:
                old_alpha = paint.getAlpha()
                paint.setAlpha(int(old_alpha * 0.8))
                canvas.drawRect(0.0, 0.0, float(self.java.getMeasuredWidth()), AndroidUtilities.dpf2(0.5), paint)
                paint.setAlpha(old_alpha)
        except Exception:
            pass

class MD3NavbarsPlugin(BasePlugin):
    def on_plugin_load(self):
        self.force_m3 = 0
        self.hooked_classes = set()

        for cls_name in MAIN_TABS_HELPER_CLASSES:
            helper = find_class(cls_name)
            if helper:
                self.hook_all_methods(helper, "isMaterial3NavigationBar", before=self.force_m3_check)
                self.hook_all_methods(helper, "setMainTabSelectedIndicatorBounds", after=self.after_setIndicatorBounds)

        AttachAlert = find_class("org.telegram.ui.Components.ChatAttachAlert")
        if AttachAlert:
            self.hook_all_methods(AttachAlert, "init", after=self.after_init)

        BtnAdapter = find_class("org.telegram.ui.Components.ChatAttachAlert$ButtonsAdapter")
        if BtnAdapter:
            self.hook_all_methods(BtnAdapter, "onCreateViewHolder", after=self.after_onCreateViewHolder)
            self.hook_all_methods(BtnAdapter, "onBindViewHolder", after=self.after_onBindViewHolder)

        GlassTab = find_class("org.telegram.ui.Components.glass.GlassTabView")
        if GlassTab:
            self.hook_all_methods(GlassTab, "setAdditionalWidth", before=self.before_setAdditionalWidth)
            for m in ["setAttachBot", "setAttachBotUser"]:
                self.hook_all_methods(GlassTab, m, after=self.after_attach_bot)

        StatActivity = find_class("org.telegram.ui.StatisticActivity")
        if StatActivity:
            self.hook_all_methods(StatActivity, "createView", after=self.on_statistic)
            self.hook_all_methods(StatActivity, "checkUi_listPaddings", after=self.on_statistic)

        GiftSheet = find_class("org.telegram.ui.Stars.StarGiftPreviewSheet")
        if GiftSheet:
            self.hook_all_constructors(GiftSheet, after=self.on_stargift)
            self.hook_all_methods(GiftSheet, "applyBottomInset", after=self.on_stargift)

        self.log("MD3 Navbars Everywhere loaded (Optimized).")

    def on_plugin_unload(self):
        self.force_m3 = 0
        self.hooked_classes.clear()

    def force_m3_check(self, param):
        if self.force_m3 > 0:
            param.setResult(True)

    def after_setIndicatorBounds(self, param):
        try:
            if not is_md3_enabled():
                return
            view_height = param.args[2]
            if view_height > AndroidUtilities.dp(58.0):
                out = param.args[0]
                if out:
                    top = float(AndroidUtilities.dp(6.0))
                    bottom = top + float(AndroidUtilities.dp(32.0))
                    out.set(float(out.left), top, float(out.right), bottom)
        except Exception:
            pass

    def after_attach_bot(self, param):
        if not is_md3_enabled():
            return
        invoke_set_main_tab_style(param.thisObject, self)

    def on_statistic(self, param):
        if not is_md3_enabled():
            return
        act = param.thisObject
        try:
            tabs = act.JA.tabsView
        except Exception:
            return

        wrapper = getattr(act.JA, "tabsViewWrapper", None)
        if wrapper:
            try:
                wrapper.setPadding(0, 0, 0, 0)
                wrapper.setClipToPadding(False)
                wrapper.setClipChildren(False)
                wrapper.setTranslationY(jfloat(0.0))
                wrapper.setBackground(None)
                w_lp = wrapper.getLayoutParams()
                if w_lp and hasattr(w_lp, "bottomMargin") and w_lp.bottomMargin != 0:
                    w_lp.bottomMargin = 0
                    wrapper.setLayoutParams(w_lp)
            except Exception:
                pass

        nav_height = AndroidUtilities.navigationBarHeight
        try:
            insets = getattr(act.JA, "mSystemInsets", None)
            if insets and insets.bottom > 0:
                nav_height = insets.bottom
        except Exception:
            pass

        if tabs:
            setup_md3_navbar(tabs, nav_height, apply_padding=False)
            style_glass_tabs(tabs, self)

        try:
            act_tabs = getattr(act.JA, "tabs", None)
            if act_tabs:
                for t in act_tabs:
                    if t:
                        invoke_set_main_tab_style(t, self)
        except Exception:
            pass

    def on_stargift(self, param):
        if not is_md3_enabled():
            return
        sheet = param.thisObject
        try:
            nav_h = int(sheet.JA.lastBottomInset) if hasattr(sheet.JA, "lastBottomInset") else AndroidUtilities.navigationBarHeight
            tabs = sheet.JA.tabsSelectorView
        except Exception:
            return

        if tabs:
            setup_md3_navbar(tabs, nav_h, apply_padding=True, add_divider=False)
            style_glass_tabs(tabs, self)

            try:
                if not tabs.findViewWithTag("m3_divider"):
                    div = M3DividerView.new_instance(tabs.getContext())
                    if div:
                        div.java.setWillNotDraw(False)
                        div.java.setTag("m3_divider")
                        lp = FrameLayout.LayoutParams(-1, max(1, AndroidUtilities.dp(0.5)))
                        lp.gravity, pad = Gravity.TOP, AndroidUtilities.dp(12)
                        lp.leftMargin = lp.rightMargin = -pad
                        tabs.addView(div.java, lp)
            except Exception:
                pass

    def after_init(self, param):
        if not is_md3_enabled():
            return
        alert = param.thisObject
        try:
            wrapper, recycler = alert.JA.buttonsRecyclerViewWrapper, alert.JA.buttonsRecyclerView
        except Exception:
            return
        if not wrapper or not recycler:
            return

        w_cls, r_cls = wrapper.getClass().getName(), recycler.getClass().getName()

        if w_cls not in self.hooked_classes:
            cls = find_class(w_cls)
            if cls:
                self.hook_all_methods(cls, "onMeasure", before=self.before_wrapper_onMeasure, after=self.after_wrapper_onMeasure)
                self.dispatch_draw_hooked = bool(self.hook_all_methods(cls, "dispatchDraw", after=self.after_wrapper_dispatchDraw))
                self.hooked_classes.add(w_cls)

        if r_cls not in self.hooked_classes:
            cls = find_class(r_cls)
            if cls:
                self.hook_all_methods(cls, "onMeasure", before=self.before_recycler_onMeasure, after=self.after_recycler_onMeasure)
                self.hooked_classes.add(r_cls)

        try:
            lp = wrapper.getLayoutParams()
            if lp:
                lp.width = -1
                lp.height = AndroidUtilities.dp(64) + AndroidUtilities.navigationBarHeight
                try:
                    lp.bottomMargin = -AndroidUtilities.navigationBarHeight
                except Exception:
                    pass
                wrapper.setLayoutParams(lp)
        except Exception:
            pass

        bg = wrapper.getBackground()
        if bg:
            try:
                if hasattr(bg, "setPadding"):
                    bg.setPadding(0)
            except Exception:
                pass
            try:
                if hasattr(bg, "setRadius"):
                    bg.setRadius(0.0)
                elif hasattr(bg, "setCornerRadius"):
                    bg.setCornerRadius(0.0)
            except Exception:
                pass

        try:
            recycler.setClipToOutline(False)
            recycler.setOutlineProvider(None)
        except Exception:
            pass

        if not getattr(self, "dispatch_draw_hooked", False):
            try:
                if not wrapper.findViewWithTag("m3_divider"):
                    div = M3DividerView.new_instance(wrapper.getContext())
                    if div:
                        div.java.setWillNotDraw(False)
                        div.java.setTag("m3_divider")
                        wrapper.addView(div.java, LayoutHelper.createFrame(-1, 0.5, 48))
            except Exception:
                pass

        try:
            shift = AndroidUtilities.dp(24)
            rlp = recycler.getLayoutParams()
            if rlp:
                rlp.width = -1
                try:
                    rlp.leftMargin = -shift
                except Exception:
                    pass
                try:
                    rlp.rightMargin = -shift
                except Exception:
                    pass
                recycler.setLayoutParams(rlp)

            wrapper.setClipChildren(True)
            OutlineProvider = find_class("android.view.ViewOutlineProvider")
            if OutlineProvider:
                wrapper.setOutlineProvider(OutlineProvider.BOUNDS)
                wrapper.setClipToOutline(True)
        except Exception:
            pass

    def after_wrapper_dispatchDraw(self, param):
        if not is_md3_enabled() or not is_divider_enabled():
            return
        paint = getattr(Theme, "forcedDividerPaint", None) or getattr(Theme, "dividerPaint", None)
        if paint:
            try:
                old_alpha = paint.getAlpha()
                paint.setAlpha(int(old_alpha * 0.8))
                param.args[0].drawRect(0.0, 0.0, float(param.thisObject.getMeasuredWidth()), AndroidUtilities.dpf2(0.5), paint)
                paint.setAlpha(old_alpha)
            except Exception:
                pass

    def before_wrapper_onMeasure(self, param):
        if not is_md3_enabled():
            return
        alert = getattr(param.thisObject.JA, "this$0", None)
        if alert:
            try:
                self.orig_poll = alert.JA.pollAllowedLayouts
                if self.orig_poll is not None:
                    alert.JA.pollAllowedLayouts = jint(0)
                recycler = alert.JA.buttonsRecyclerView
                if recycler:
                    nav_h, shift = AndroidUtilities.navigationBarHeight, AndroidUtilities.dp(24)
                    pad = shift if alert.JA.isPollAttach else AndroidUtilities.dp(10) + shift
                    if recycler.getPaddingLeft() != pad:
                        recycler.setPadding(pad, 0, pad, nav_h)
            except Exception:
                pass

    def after_wrapper_onMeasure(self, param):
        if not is_md3_enabled():
            return
        alert = getattr(param.thisObject.JA, "this$0", None)
        if alert and hasattr(self, "orig_poll") and self.orig_poll is not None:
            try:
                alert.JA.pollAllowedLayouts = jint(self.orig_poll)
            except Exception:
                pass

    def before_recycler_onMeasure(self, param):
        if not is_md3_enabled():
            return
        alert = getattr(param.thisObject.JA, "this$0", None)
        if alert:
            self.disable_add_width = not alert.JA.isPollAttach

    def after_recycler_onMeasure(self, param):
        self.disable_add_width = False

    def before_setAdditionalWidth(self, param):
        if is_md3_enabled() and getattr(self, "disable_add_width", False):
            param.args[0] = jint(0)

    def after_onCreateViewHolder(self, param):
        if not is_md3_enabled() or not param.getResult():
            return
        try:
            tab = param.getResult().itemView.JA.glassTabView
            if tab:
                invoke_set_main_tab_style(tab, self)
        except Exception:
            pass

    def after_onBindViewHolder(self, param):
        if not is_md3_enabled():
            return
        adapter = param.thisObject
        alert = getattr(adapter.JA, "this$0", None)
        if not alert:
            return

        try:
            itemView = param.args[0].itemView if param.args and hasattr(param.args[0], "itemView") else None
            if not itemView:
                return
            lp = itemView.getLayoutParams()
            if not lp:
                return

            if hasattr(itemView, "JA") and hasattr(itemView.JA, "glassTabView"):
                tab = itemView.JA.glassTabView
                if tab and hasattr(tab, "JA"):
                    if hasattr(tab.JA, "labelHidden"):
                        tab.JA.labelHidden = False
                    if hasattr(tab.JA, "textView") and tab.JA.textView:
                        tab.JA.textView.setVisibility(0)
                        tab.JA.textView.setTypeface(AndroidUtilities.bold())
                        tab.JA.textView.setLayoutParams(LayoutHelper.createFrame(-1, 16.0, 49, 0.0, 42.0, 0.0, 0.0))
                    if hasattr(tab.JA, "imageView") and tab.JA.imageView:
                        tab.JA.imageView.setLayoutParams(LayoutHelper.createFrame(24, 24.0, 49, 0.0, 10.0, 0.0, 0.0))
                    if hasattr(tab.JA, "backupImageView") and tab.JA.backupImageView:
                        b_lp = tab.JA.backupImageView.getLayoutParams()
                        if b_lp and b_lp.width == AndroidUtilities.dp(24.0):
                            tab.JA.backupImageView.setLayoutParams(LayoutHelper.createFrame(24, 24.0, 49, 0.0, 10.0, 0.0, 0.0))
                        else:
                            tab.JA.backupImageView.setLayoutParams(LayoutHelper.createFrame(22, 22.0, 49, 0.0, 11.0, 0.0, 0.0))

            if not alert.JA.isPollAttach:
                count = adapter.JA.buttonsCount if adapter.JA.buttonsCount is not None else adapter.getItemCount()
                lp.rightMargin = AndroidUtilities.dp(8) if param.args[1] < count - 1 else 0
            else:
                lp.rightMargin = 0

            lp.leftMargin = 0
            itemView.setLayoutParams(lp)
        except Exception:
            pass
