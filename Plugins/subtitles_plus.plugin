__id__ = "subtitles_plus"
__name__ = "Subtitles+"
__description__ = (
    "Субтитры из MKV прямо во встроенном плеере Telegram — с полным сохранением стилей ASS: шрифты, "
    "позиционирование, караоке. Работает при стриминге, скачивать видео целиком не нужно.\n\n"
    "**Использование:** во время просмотра нажмите шестерёнку ⚙ вверху плеера → «Субтитры». Там можно выбрать "
    "встроенную дорожку или загрузить свой файл .ass / .ssa."
)
__author__ = "@kovidoff"
__version__ = "1.0.0"
__icon__ = "subtitles_plus_by_niko_ocbot/0"
__category__ = ["media"]
__app_version__ = ">=13.1.1"
__sdk_version__ = ">=1.4.3.3"

import base64
import os
import shutil
import time
import zlib

from base_plugin import BasePlugin
from ui.settings import Header, Selector, Divider

from java import jarray
from java.lang import String as JString
from java.nio import ByteBuffer
from android.os import Build
from dalvik.system import InMemoryDexClassLoader
from org.telegram.messenger import ApplicationLoader, LocaleController

LANG_CODES = ["auto", "ru", "en", "uk", "file", "off"]
SCALES = [0.8, 0.9, 1.0, 1.1, 1.25, 1.5]

STRINGS = {
    "en": {
        "header": "Subtitles",
        "language": "Preferred language",
        "lang_items": ["Same as Telegram", "Russian", "English", "Ukrainian", "File default", "Don't turn on"],
        "scale": "Text size",
        "hint": "Picking a track in the player (⚙ → Subtitles) makes its language the default for the "
                "next videos. Your own .ass files are added there too: Add from file.",
        "about": "Version %s · libass 0.17.4",
    },
    "ru": {
        "header": "Субтитры",
        "language": "Язык по умолчанию",
        "lang_items": ["Как в Telegram", "Русский", "Английский", "Украинский", "Как задано в файле", "Не включать"],
        "scale": "Размер текста",
        "hint": "Если выбрать дорожку в плеере (⚙ → Субтитры), её язык станет языком по умолчанию "
                "для следующих видео. Там же можно добавить свой .ass — «Добавить из файла».",
        "about": "Версия %s · libass 0.17.4",
    },
}


def tr(key):
    try:
        lang = str(LocaleController.getInstance().getCurrentLocaleInfo().pluralLangCode)
    except Exception:
        lang = "en"
    table = STRINGS["ru"] if lang in ("ru", "uk", "be") else STRINGS["en"]
    return table[key]


class SubtitlesPlusPlugin(BasePlugin):
    def on_plugin_load(self):
        self.core = None
        self.loader = None
        try:
            self._start()
        except Exception:
            self.logger.exception("failed to start")

    def on_plugin_unload(self):
        self._call("stop", "")
        self.core = None
        self.loader = None

    # ------------------------------------------------------------------ runtime

    def _start(self):
        ctx = ApplicationLoader.applicationContext
        files = str(ctx.getFilesDir().getAbsolutePath())
        base = os.path.join(files, "subtitles_plus")
        abi = next((str(a) for a in Build.SUPPORTED_ABIS if f"{a}/libass.so" in _LIBS), None)
        if abi is None:
            raise RuntimeError("unsupported ABI: %s" % list(Build.SUPPORTED_ABIS))

        # A native library stays bound to the class loader that opened it, so every load gets its
        # own copy; copies from earlier runs are removed here.
        rt_root = os.path.join(base, "rt")
        os.makedirs(rt_root, exist_ok=True)
        for old in os.listdir(rt_root):
            shutil.rmtree(os.path.join(rt_root, old), ignore_errors=True)
        rt = os.path.join(rt_root, "%s-%d" % (__version__, time.time_ns()))
        os.makedirs(rt)
        for name in ("libass.so", "libasskt.so"):
            with open(os.path.join(rt, name), "wb") as f:
                f.write(zlib.decompress(base64.b64decode(_LIBS[f"{abi}/{name}"])))

        dex = zlib.decompress(base64.b64decode(_DEX))
        buffers = jarray(ByteBuffer)([ByteBuffer.wrap(dex)])
        self.loader = InMemoryDexClassLoader(buffers, rt, ctx.getClassLoader())
        core_cls = self.loader.loadClass("com.subtitlesplus.Core")
        self.core = core_cls.getMethod("call", JString, JString)

        cache = str(ctx.getCacheDir().getAbsolutePath()) + "/subtitles_plus"
        result = self._call("start", "%s|%s" % (rt, cache))
        if result != "ok":
            self.logger.error("start failed: %s (abi %s)", result, abi)

    def _call(self, cmd, arg):
        if self.core is None:
            return None
        try:
            return str(self.core.invoke(None, JString(cmd), JString(arg)))
        except Exception:
            self.logger.exception("core call %s failed", cmd)
            return None

    def _get(self, key, default):
        value = self._call("get", key)
        return default if value in (None, "") else value

    def _set(self, key, value):
        self._call("set", "%s=%s" % (key, value))

    # ------------------------------------------------------------------ settings

    def create_settings(self):
        lang = self._get("language", "auto")
        lang_items = list(tr("lang_items"))
        codes = list(LANG_CODES)
        if lang not in codes:
            # a language picked in the player menu that is not in the short list
            try:
                from java.util import Locale
                name = str(Locale(lang).getDisplayLanguage(Locale(str(LocaleController.getInstance().getCurrentLocaleInfo().pluralLangCode))))
                name = name[:1].upper() + name[1:]
            except Exception:
                name = lang
            codes.insert(4, lang)
            lang_items.insert(4, name or lang)

        try:
            scale = float(self._get("font_scale", "1.0"))
        except ValueError:
            scale = 1.0
        scale_index = min(range(len(SCALES)), key=lambda i: abs(SCALES[i] - scale))

        def on_lang(index):
            self._set("language", codes[int(index)])

        def on_scale(index):
            self._set("font_scale", SCALES[int(index)])

        # The language can also change from the player menu, and the list may gain an entry, so the
        # stored selector positions are brought in line with the real values every time.
        lang_index = codes.index(lang)
        for key, index in (("language_ui", lang_index), ("scale_ui", scale_index)):
            try:
                self.set_setting(key, index)
            except Exception:
                pass

        return [
            Header(text=tr("header")),
            Selector(
                key="language_ui",
                text=tr("language"),
                default=lang_index,
                items=lang_items,
                icon="msg_language",
                on_change=on_lang,
            ),
            Selector(
                key="scale_ui",
                text=tr("scale"),
                default=scale_index,
                items=["%d%%" % round(s * 100) for s in SCALES],
                icon="msg_photo_text_framed",
                on_change=on_scale,
            ),
            Divider(text=tr("hint")),
            Divider(text=tr("about") % __version__),
        ]


