def migrate_v1(get, stored_version):
    def as_int(value, default, count):
        try:
            value = int(value)
        except (TypeError, ValueError):
            return default
        return value if 0 <= value < count else default

    out = {}
    if stored_version == 2:
        preset = as_int(get("motion"), 2, 4)
    else:
        preset = as_int(get("motion_preset"), None, 5)
        if preset is None:
            if get("enable_bounce") is None:
                return out
            preset = 4

    if preset == 0:
        out["motion"] = 0
    elif preset in V1_PRESETS:
        depth, tension, speed = V1_PRESETS[preset]
        out.update(motion=V1_TENSION_TO_SCHEME[tension], press_depth=depth, speed=V1_SPEED[speed])
    else:
        out["motion"] = V1_TENSION_TO_SCHEME[as_int(get("spring_tension"), 2, 4)]
        out["press_depth"] = as_int(get("bounce_depth"), 1, 4)
        out["speed"] = V1_SPEED[as_int(get("animation_speed"), 1, 4)]

    if stored_version == 2:
        out["haptics"] = as_int(get("haptics"), 2, 4)
    else:
        level = get("haptic_level")
        if level is None:
            enabled = get("enable_haptics")
            level = 0 if enabled is False else as_int(get("haptic_type"), 1, 3) + 1
        out["haptics"] = as_int(level, 2, 4)

    for key, old_keys in V1_FLAG_MAP.items():
        if preset == 0 and not key.startswith("h_"):
            continue
        values = [get(k) for k in old_keys]
        values = [bool(v) for v in values if v is not None]
        if values:
            out[key] = any(values)
    return out


def weak(method):
    ref = weakref.WeakMethod(method)

    def call(*args):
        target = ref()
        return target(*args) if target is not None else None

    return call


def static_field(cls, name):
    return cls.getDeclaredField(name).get(None)


class Core:
    def __init__(self):
        self.cls = None
        self.loader = None
        self.version_name = ""
        self.version_code = 0
        self.methods = {}

    @property
    def loaded(self):
        return self.cls is not None

    def load(self):
        if jclass("android.os.Build$VERSION").SDK_INT < MIN_ANDROID_SDK:
            raise RuntimeError("нужен Android 8.0 или новее")
        dex = base64.b64decode(DEX_BASE64, validate=True)
        if not dex.startswith(b"dex\n") or len(dex) > MAX_DEX_BYTES:
            raise RuntimeError("повреждённое ядро")
        digest = hashlib.sha256(dex).hexdigest()
        if digest != EXPECTED_DEX_SHA256:
            raise RuntimeError(f"контрольная сумма ядра не совпадает ({digest[:12]})")
        parent = ApplicationLoader.applicationContext.getClassLoader()
        loader = jclass("dalvik.system.InMemoryDexClassLoader")(ByteBuffer.wrap(dex), parent)
        cls = loader.loadClass(CORE_CLASS)
        code = int(static_field(cls, "VERSION_CODE"))
        if code < CORE_MIN_VERSION_CODE:
            raise RuntimeError(f"ядро слишком старое ({code})")
        self.loader = loader
        self.cls = cls
        self.version_code = code
        self.version_name = str(static_field(cls, "VERSION_NAME"))
        self.methods = {}

    def unload(self):
        self.cls = None
        self.loader = None
        self.methods = {}

    def call(self, name, *args):
        if self.cls is None:
            raise RuntimeError("ядро не загружено")
        method = self.methods.get(name)
        if method is None:
            if args:
                method = self.cls.getMethod(name, jclass("java.lang.String"))
            else:
                method = self.cls.getMethod(name)
            self.methods[name] = method
        return method.invoke(None, *args)


class MaterialExpressive(BasePlugin):
    def __init__(self):
        super().__init__()
        self.core = Core()
        self.alive = False
        self.starting = False
        self.lock = threading.Lock()
        self.fault = ""

    def on_plugin_load(self):
        self.alive = True
        self.migrate()
        run_on_queue(self.boot)

    def on_plugin_unload(self):
        self.alive = False
        self.halt()

    def boot(self, announce=False):
        with self.lock:
            if not self.alive or self.starting:
                return
            self.starting = True
        try:
            if self.core.loaded:
                self.halt()
            self.core.load()
            self.core.call("start", self.payload())
            if not self.alive:
                self.halt()
                return
            self.fault = ""
            self.log(f"core {self.core.version_name} started")
            if announce:
                self.bulletin(True, "Ядро перезапущено")
        except Exception as e:
            self.fault = str(e)
            self.core.unload()
            self.log(f"core start failed: {e}")
            if announce:
                self.bulletin(False, f"Ядро не запустилось: {e}")
        finally:
            self.starting = False
        if self.alive:
            self.set_setting(SETTINGS_VERSION_KEY, SETTINGS_VERSION, reload_settings=True)

    def halt(self):
        if not self.core.loaded:
            return
        try:
            self.core.call("stop")
        except Exception as e:
            self.log(f"core stop failed: {e}")
        finally:
            self.core.unload()

    def sync(self, *args):
        if not self.core.loaded:
            return
        try:
            self.core.call("update", self.payload())
        except Exception as e:
            self.log(f"settings sync failed: {e}")

    def pref(self, key):
        return self.get_setting(key, DEFAULTS[key])

    def payload(self):
        return json.dumps({key: self.pref(key) for key in DEFAULTS})

    def migrate(self):
        try:
            stored = int(self.get_setting(SETTINGS_VERSION_KEY, 0))
        except Exception:
            stored = 0
        if stored >= SETTINGS_VERSION:
            return
        try:
            changes = migrate_v1(lambda k: self.get_setting(k, None), stored)
            for key, value in changes.items():
                self.set_setting(key, value)
            if changes:
                self.log(f"settings migrated from v{stored}: {len(changes)} keys")
        except Exception as e:
            self.log(f"settings migration failed: {e}")
        self.set_setting(SETTINGS_VERSION_KEY, SETTINGS_VERSION)

    def create_settings(self):
        sync = weak(self.sync)
        items = []
        preview = self.preview()
        if preview is not None:
            items.append(preview)
        items += [
            Header(text="Движение"),
            Selector(key="motion", text="Схема", items=MOTION_ITEMS, default=LEVELS["motion"],
                     icon="msg2_animations", on_change=sync),
            Selector(key="press_depth", text="Глубина нажатия", items=DEPTH_ITEMS, default=LEVELS["press_depth"],
                     icon="msg_select", on_change=sync),
            Selector(key="speed", text="Скорость", items=SPEED_ITEMS, default=LEVELS["speed"],
                     icon="msg_speed", on_change=sync),
            Selector(key="haptics", text="Виброотклик", items=HAPTIC_ITEMS, default=LEVELS["haptics"],
                     icon="msg_notifications", on_change=sync),
            Divider(),
            Text(text="Интерфейс", subtext=self.summary(LISTS_FLAGS), icon="msg_list",
                 accent=True, create_sub_fragment=weak(self.ui_page)),
            Text(text="Чат", subtext=self.summary(CHAT_FLAGS), icon="msg_discuss",
                 accent=True, create_sub_fragment=weak(self.chat_page)),
            Text(text="Где вибрировать", subtext=self.haptic_summary(), icon="msg_notifications",
                 accent=True, create_sub_fragment=weak(self.haptic_page)),
            Divider(),
            Text(text="Ядро", subtext=self.core_summary(), icon="files_storage",
                 accent=True, create_sub_fragment=weak(self.core_page)),
        ]
        return items

    def preview(self):
        if not self.core.loaded:
            return None
        try:
            item = self.core.call("previewItem")
            return Custom(item=item) if item is not None else None
        except Exception as e:
            self.log(f"preview unavailable: {e}")
            return None

    def switches(self, flags):
        sync = weak(self.sync)
        return [Switch(key=key, text=title, subtext=hint, default=True, on_change=sync)
                for key, title, hint in flags]

    def ui_page(self):
        return [Header(text="Интерфейс")] + self.switches(LISTS_FLAGS)

    def chat_page(self):
        return [Header(text="Чат")] + self.switches(CHAT_FLAGS)

    def haptic_page(self):
        return [Header(text="Где вибрировать")] + self.switches(HAPTIC_FLAGS)

    def core_page(self):
        items = [Header(text="Ядро"), Text(text="Состояние", subtext=self.core_summary())]
        for feature in self.core_status().get("features", []):
            name = FEATURE_NAMES.get(feature.get("name"), feature.get("name"))
            if feature.get("error"):
                state = "недоступно в этой версии exteraGram"
            elif feature.get("on"):
                state = f"работает · хуков: {feature.get('hooks', 0)}"
                if feature.get("missing"):
                    state += f" · нет: {len(feature['missing'])}"
            else:
                state = "выключено"
            items.append(Text(text=name, subtext=state))
        items += [
            Divider(),
            Text(text="Перезапустить ядро", subtext="если эффекты пропали после обновления",
                 icon="msg_retry", accent=True, on_click=weak(self.restart_core)),
            Text(text="Сбросить настройки", subtext="выразительная схема, всё включено",
                 icon="msg_reset", accent=True, on_click=weak(self.reset_settings)),
        ]
        return items

    def level(self, key, count):
        try:
            value = int(self.pref(key))
        except Exception:
            return LEVELS[key]
        return value if 0 <= value < count else LEVELS[key]

    def summary(self, flags):
        if self.level("motion", len(MOTION_ITEMS)) == 0:
            return "движение выключено"
        return self.listing([(key, title) for key, title, hint in flags])

    def haptic_summary(self):
        if self.level("haptics", len(HAPTIC_ITEMS)) == 0:
            return "виброотклик выключен"
        return self.listing([(key, title) for key, title, hint in HAPTIC_FLAGS])

    def listing(self, pairs):
        enabled = [title[:1].lower() + title[1:] for key, title in pairs if self.pref(key)]
        if not enabled:
            return "всё выключено"
        if len(enabled) == len(pairs):
            return "всё включено"
        if len(enabled) <= 2:
            return ", ".join(enabled)
        return f"{enabled[0]}, {enabled[1]} и ещё {len(enabled) - 2}"

    def core_status(self):
        if not self.core.loaded:
            return {}
        try:
            return json.loads(str(self.core.call("status")))
        except Exception:
            return {}

    def core_summary(self):
        if self.core.loaded:
            status = self.core_status()
            on = sum(1 for f in status.get("features", []) if f.get("on"))
            return f"работает · {self.core.version_name} · модулей: {on} · хуков: {status.get('hooks', 0)}"
        if self.starting:
            return "загружается…"
        if self.fault:
            return f"не запущено: {self.fault}"
        return "не запущено"

    def restart_core(self, *args):
        if not self.starting:
            run_on_queue(lambda: self.boot(announce=True))

    def reset_settings(self, *args):
        for key, value in DEFAULTS.items():
            self.set_setting(key, value)
        self.set_setting(SETTINGS_VERSION_KEY, SETTINGS_VERSION, reload_settings=True)
        self.sync()
        self.bulletin(True, "Настройки Material Expressive сброшены")

    def bulletin(self, ok, text):
        def show():
            fragment = get_last_fragment()
            if fragment is None or not self.alive:
                return
            if ok:
                BulletinHelper.show_success(text, fragment)
            else:
                BulletinHelper.show_error(text, fragment)

        run_on_ui_thread(show)


DEX_BASE64 = ""
