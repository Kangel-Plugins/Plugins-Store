import time
import math
import colorsys

from base_plugin import BasePlugin, MenuItemData, MenuItemType
from android_utils import run_on_ui_thread
from client_utils import get_last_fragment, get_user_config
from ui.bulletin import BulletinHelper
from java import dynamic_proxy, jclass

__id__ = "ball"
__name__ = "Ball"
__description__ = "Мини-игра прямо в чате: кидайте аватарку собеседника."
__author__ = "@RedPlugin"
__version__ = "1.0"
__app_version__ = ">=13.1.1"
__category__ = ["fun"]
__icon__ = "AnimatedBasketball/4"

FrameLayout = jclass("android.widget.FrameLayout")
LayoutParams = jclass("android.widget.FrameLayout$LayoutParams")
TextView = jclass("android.widget.TextView")
View = jclass("android.view.View")
OnTouchListener = jclass("android.view.View$OnTouchListener")
OnClickListener = jclass("android.view.View$OnClickListener")
Color = jclass("android.graphics.Color")
Typeface = jclass("android.graphics.Typeface")
MotionEvent = jclass("android.view.MotionEvent")
AndroidUtilities = jclass("org.telegram.messenger.AndroidUtilities")
BackupImageView = jclass("org.telegram.ui.Components.BackupImageView")
AvatarDrawable = jclass("org.telegram.ui.Components.AvatarDrawable")

try:
    Choreographer = jclass("android.view.Choreographer")
    FrameCallback = jclass("android.view.Choreographer$FrameCallback")
except Exception:
    Choreographer = None
    FrameCallback = None


def dp(v):
    return AndroidUtilities.dp(float(v))


class _Touch(dynamic_proxy(OnTouchListener)):
    def __init__(self, game):
        super().__init__()
        self.game = game

    def onTouch(self, v, e):
        return self.game.on_touch(e)


class _Click(dynamic_proxy(OnClickListener)):
    def __init__(self, fn):
        super().__init__()
        self.fn = fn

    def onClick(self, v):
        self.fn()


if FrameCallback is not None:
    class _Frame(dynamic_proxy(FrameCallback)):
        def __init__(self, fn):
            super().__init__()
            self.fn = fn

        def doFrame(self, frame_time_nanos):
            self.fn(frame_time_nanos)
else:
    _Frame = None


COMBO_COLORS = {
    1: (158, 158, 158),
    2: (100, 181, 246),
    3: (77, 208, 225),
    4: (129, 199, 132),
    5: (255, 235, 59),
    6: (255, 167, 38),
    7: (240, 98, 146),
}
LAVA = (255, 69, 0)
LAVA_GLOW = (255, 152, 0)
LAVA_FROM = 8
RAINBOW_FROM = 12


class BallGame:
    STEP = 1.0 / 240.0
    FLOOR_E = 0.74
    WALL_E = 0.80
    CEIL_E = 0.70
    FRICTION = 0.35
    AIR_DRAG = 0.08
    ROLL_DRAG = 0.55
    MIN_HIT_SPEED = 240
    REST_SPEED = 160
    COMBO_TIMEOUT = 1.0
    LABEL_MAX = 50.0

    def __init__(self, activity, target):
        self.activity = activity
        self.target = target
        self.decor = activity.getWindow().getDecorView()
        self.running = True
        self.ready = False
        self.dragging = False
        self.settled = False
        self.vx = self.vy = 0.0
        self.x = self.y = 0.0
        self.rot = 0.0
        self.omega = 0.0
        self.acc = 0.0
        self.t = 0.0
        self.last_t = None
        self.last_touch = None
        self.grab = (0.0, 0.0)

        self.r = dp(28)
        self.g = dp(1300)
        self.v_cap = dp(5000)
        self.hit_min = dp(self.MIN_HIT_SPEED)
        self.rest_speed = dp(self.REST_SPEED)
        self.sq_div = dp(4200)
        self.dp30 = dp(30)
        self.dp6 = dp(6)
        self.dp60 = dp(60)
        self.dp90 = dp(90)
        self.dp160 = dp(160)
        self.label_w = dp(120)
        self.label_h = dp(80)

        self.combo = 0
        self.last_hit = 0.0
        self.pop = 1.0
        self.sq = 0.0
        self.sq_axis = "y"
        self.label_base = 1.0
        self.label_half = 0

        self._tx = None
        self._ty = None
        self._rot = None

        self.choreo = None
        self.cb = None
        self._build()

    def _build(self):
        a = self.activity
        self.root = FrameLayout(a)
        d = self.r * 2

        self.holder = FrameLayout(a)
        self.holder.setLayoutParams(LayoutParams(d, d))
        self.holder.setVisibility(View.INVISIBLE)

        self.ball = BackupImageView(a)
        self.ball.setRoundRadius(self.r)
        av = AvatarDrawable()
        try:
            av.setInfo(self.target)
        except Exception:
            pass
        self.ball.setForUserOrChat(self.target, av)
        self.ball.setLayoutParams(LayoutParams(d, d))
        self.ball.setOnTouchListener(_Touch(self))
        self.holder.addView(self.ball)

        self.label = TextView(a)
        self.label.setTypeface(Typeface.DEFAULT_BOLD)
        self.label.setGravity(17)
        self.label.setTextSize(self.LABEL_MAX)
        self.label.setLayoutParams(LayoutParams(self.label_w, self.label_h))
        self.label.setVisibility(View.INVISIBLE)

        self.close = TextView(a)
        self.close.setText("✕")
        self.close.setTextColor(Color.argb(150, 255, 255, 255))
        self.close.setShadowLayer(float(dp(2)), 0.0, 0.0, Color.argb(200, 0, 0, 0))
        self.close.setTextSize(20.0)
        self.close.setPadding(dp(14), dp(8), dp(14), dp(8))
        lp = LayoutParams(-2, -2)
        lp.gravity = 53
        lp.topMargin = dp(100)
        lp.rightMargin = dp(4)
        self.close.setLayoutParams(lp)
        self.close.setOnClickListener(_Click(self.stop))

        for v in (self.holder, self.label, self.close):
            self.root.addView(v)
        self.decor.addView(self.root, LayoutParams(-1, -1))

    def _style_label(self):
        c = self.combo
        size = 26 + min(c, 12) * 2
        base = size / self.LABEL_MAX
        self.label_base = base
        self.label_half = dp(size * 0.6)
        self.label.setText("X%d" % c)
        if c >= RAINBOW_FROM:
            rgb = colorsys.hsv_to_rgb((c * 0.09) % 1.0, 0.9, 1.0)
            col = tuple(int(v * 255) for v in rgb)
            self.label.setTextColor(Color.rgb(*col))
            self.label.setShadowLayer(float(dp(16)) / base, 0.0, 0.0, Color.rgb(255, 255, 255))
        elif c >= LAVA_FROM:
            self.label.setTextColor(Color.rgb(*LAVA))
            self.label.setShadowLayer(float(dp(10 + c)) / base, 0.0, 0.0, Color.rgb(*LAVA_GLOW))
        else:
            self.label.setTextColor(Color.rgb(*COMBO_COLORS[c]))
            self.label.setShadowLayer(float(dp(2)) / base, 0.0, 0.0, Color.argb(160, 0, 0, 0))

    def _register(self, speed, side):
        r = self.r
        squash = min(0.24, speed / self.sq_div)
        if squash > 0.02:
            self.sq = squash
            self.sq_axis = "y" if side in ("floor", "ceil") else "x"
            pivots = {"floor": (r, 2 * r), "ceil": (r, 0), "left": (0, r), "right": (2 * r, r)}
            px, py = pivots[side]
            self.holder.setPivotX(float(px))
            self.holder.setPivotY(float(py))
        if speed < self.hit_min:
            return
        self.combo += 1
        self.last_hit = self.t
        self.pop = 1.7
        self._style_label()
        lx = min(max(self.x, self.dp60), self.W - self.dp60)
        ly = min(max(self.y - self.dp90, self.dp60), self.H - self.dp160)
        scale = float(self.label_base * self.pop)
        self.label.setTranslationX(float(lx - self.dp60))
        self.label.setTranslationY(float(ly + self.label_half - self.label_h * 0.5))
        self.label.setScaleX(scale)
        self.label.setScaleY(scale)
        self.label.setAlpha(1.0)
        self.label.setVisibility(View.VISIBLE)

    def _reset_combo(self):
        if self.combo:
            self.combo = 0
            self.label.setVisibility(View.INVISIBLE)

    def on_touch(self, e):
        if not self.ready:
            return True
        act = e.getActionMasked()
        rx, ry, now = e.getRawX(), e.getRawY(), time.monotonic()
        if act == MotionEvent.ACTION_DOWN:
            self.dragging = True
            self.settled = False
            self.vx = self.vy = 0.0
            self.omega = 0.0
            self.sq = 0.0
            self.grab = (rx - self.x, ry - self.y)
            self.last_touch = (rx, ry, now)
            self._reset_combo()
        elif act == MotionEvent.ACTION_MOVE and self.dragging:
            lx, ly, lt = self.last_touch
            dt = max(now - lt, 0.001)
            self.vx = self.vx * 0.5 + ((rx - lx) / dt) * 0.5
            self.vy = self.vy * 0.5 + ((ry - ly) / dt) * 0.5
            self.x = min(max(rx - self.grab[0], self.r), self.W - self.r)
            self.y = min(max(ry - self.grab[1], self.ceil + self.r), self.H - self.r)
            self.last_touch = (rx, ry, now)
        elif act in (MotionEvent.ACTION_UP, MotionEvent.ACTION_CANCEL):
            if self.dragging:
                self.dragging = False
                cap = self.v_cap
                self.vx = max(-cap, min(cap, self.vx))
                self.vy = max(-cap, min(cap, self.vy))
                self.omega = self.vx / self.r * 0.4
                self.settled = False
        return True

    def _impact(self, vn, vt, sgn, restitution):
        speed = abs(vn)
        e = restitution if speed > self.rest_speed else 0.0
        slip = vt - sgn * self.omega * self.r
        limit = self.FRICTION * (1.0 + e) * speed
        jt = max(-limit, min(limit, slip / 3.0))
        self.omega += sgn * 2.0 * jt / self.r
        return -vn * e, vt - jt

    def _physics(self, h):
        r = self.r
        self.vy += self.g * h
        k = 1.0 - self.AIR_DRAG * h
        self.vx *= k
        self.vy *= k
        self.omega *= 1.0 - 0.15 * h
        self.x += self.vx * h
        self.y += self.vy * h
        self.rot += math.degrees(self.omega) * h

        if self.x < r:
            self.x = r
            if self.vx < 0:
                speed = abs(self.vx)
                self.vx, self.vy = self._impact(self.vx, self.vy, 1, self.WALL_E)
                self._register(speed, "left")
        elif self.x > self.W - r:
            self.x = self.W - r
            if self.vx > 0:
                speed = abs(self.vx)
                self.vx, self.vy = self._impact(self.vx, self.vy, -1, self.WALL_E)
                self._register(speed, "right")

        if self.y < self.ceil + r:
            self.y = self.ceil + r
            if self.vy < 0:
                speed = abs(self.vy)
                self.vy, self.vx = self._impact(self.vy, self.vx, -1, self.CEIL_E)
                self._register(speed, "ceil")
        elif self.y > self.floor - r:
            self.y = self.floor - r
            if self.vy > 0:
                speed = abs(self.vy)
                self.vy, self.vx = self._impact(self.vy, self.vx, 1, self.FLOOR_E)
                self._register(speed, "floor")

        if self.y >= self.floor - r - 1 and abs(self.vy) < self.dp30:
            slip = self.vx - self.omega * r
            limit = self.FRICTION * self.g * h
            jt = max(-limit, min(limit, slip / 3.0))
            self.vx -= jt
            self.omega += 2.0 * jt / r
            self.vx *= 1.0 - self.ROLL_DRAG * h
            if abs(self.vx) < self.dp6 and abs(self.omega * r) < self.dp6:
                self.vx = 0.0
                self.omega = 0.0

    def _is_rest(self):
        return (
            self.y >= self.floor - self.r - 1
            and self.vx == 0.0
            and self.omega == 0.0
            and abs(self.vy) < self.dp30
        )

    def _step(self, t):
        if self.last_t is None:
            dt = 0.0
        else:
            dt = min(max(t - self.last_t, 0.0), 0.05)
        self.last_t = t
        self.t = t

        W, H = self.root.getWidth(), self.root.getHeight()
        if W <= 0 or H <= 0:
            return
        if not self.ready:
            self.W, self.H = W, H
            self.ceil = dp(30)
            self.floor = H - dp(80)
            self.x, self.y = W * 0.5, H * 0.35
            self.ready = True
            self.holder.setVisibility(View.VISIBLE)

        if not self.dragging and not self.settled:
            self.acc += dt
            n = 0
            while self.acc >= self.STEP and n < 12:
                self._physics(self.STEP)
                self.acc -= self.STEP
                n += 1
            if n == 12:
                self.acc = 0.0
            if self._is_rest():
                self.settled = True
                self.vy = 0.0
                self.acc = 0.0
            if self.rot > 3600.0 or self.rot < -3600.0:
                self.rot %= 360.0

        tx = self.x - self.r
        ty = self.y - self.r
        if tx != self._tx:
            self._tx = tx
            self.holder.setTranslationX(float(tx))
        if ty != self._ty:
            self._ty = ty
            self.holder.setTranslationY(float(ty))
        if self.rot != self._rot:
            self._rot = self.rot
            self.ball.setRotation(float(self.rot))

        if self.sq > 0.001:
            self.sq *= math.exp(-14.0 * dt)
            if self.sq_axis == "y":
                self.holder.setScaleY(1.0 - self.sq)
                self.holder.setScaleX(1.0 + self.sq)
            else:
                self.holder.setScaleX(1.0 - self.sq)
                self.holder.setScaleY(1.0 + self.sq)
        elif self.sq > 0.0:
            self.sq = 0.0
            self.holder.setScaleX(1.0)
            self.holder.setScaleY(1.0)

        if self.combo:
            if self.pop > 1.0:
                self.pop = max(1.0, self.pop - dt * 3.0)
                scale = float(self.label_base * self.pop)
                self.label.setScaleX(scale)
                self.label.setScaleY(scale)
            idle = t - self.last_hit
            if idle > self.COMBO_TIMEOUT:
                alpha = 1.0 - (idle - self.COMBO_TIMEOUT) / 0.5
                if alpha <= 0:
                    self._reset_combo()
                else:
                    self.label.setAlpha(float(alpha))

    def _on_frame(self, frame_time_nanos):
        if not self.running:
            return
        try:
            self._step(frame_time_nanos * 1e-9)
        except Exception as ex:
            self.stop()
            BulletinHelper.show_error("Ball: %s" % ex)
            return
        self._post()

    def _fallback_frame(self):
        self._on_frame(int(time.monotonic() * 1e9))

    def _post(self):
        if not self.running:
            return
        if self.choreo is not None and self.cb is not None:
            try:
                self.choreo.postFrameCallback(self.cb)
                return
            except Exception:
                self.choreo = None
        run_on_ui_thread(self._fallback_frame, 16)

    def start(self):
        try:
            if Choreographer is not None and _Frame is not None:
                self.choreo = Choreographer.getInstance()
                self.cb = _Frame(self._on_frame)
        except Exception:
            self.choreo = None
            self.cb = None
        self._post()

    def stop(self):
        self.running = False
        try:
            if self.choreo is not None and self.cb is not None:
                self.choreo.removeFrameCallback(self.cb)
        except Exception:
            pass
        try:
            self.decor.removeView(self.root)
        except Exception:
            pass


class BallPlugin(BasePlugin):
    def on_plugin_load(self):
        self.game = None
        self.add_menu_item(MenuItemData(
            menu_type=MenuItemType.DRAWER_MENU,
            text="Ball",
            icon="msg_media",
            on_click=self._open,
        ))
        self.add_menu_item(MenuItemData(
            menu_type=MenuItemType.CHAT_ACTION_MENU,
            text="Ball",
            icon="msg_media",
            on_click=self._open,
        ))

    def _target(self, fragment):
        try:
            if fragment is not None and fragment.getClass().getSimpleName() == "ChatActivity":
                user = fragment.getCurrentUser()
                if user is not None:
                    return user
                chat = fragment.getCurrentChat()
                if chat is not None:
                    return chat
        except Exception:
            pass
        return get_user_config().getCurrentUser()

    def _open(self, *args, **kwargs):
        def go():
            try:
                if self.game is not None and self.game.running:
                    self.game.stop()
                fragment = get_last_fragment()
                activity = fragment.getParentActivity()
                self.game = BallGame(activity, self._target(fragment))
                self.game.start()
            except Exception as ex:
                BulletinHelper.show_error("Ball: %s" % ex)
        run_on_ui_thread(go)

    def on_plugin_unload(self):
        if getattr(self, "game", None) is not None:
            run_on_ui_thread(self.game.stop)