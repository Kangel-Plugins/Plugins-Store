def snap_avatar_hide_hook(param):
    activity = param.thisObject
    list_view = HookUtils.get_private_field(activity, "listView")
    if list_view is None or list_view.canScrollVertically(1):
        return

    param.setResult(None)
    shown = HookUtils.get_private_field(activity, "avatarHideShown")
    if shown is None or not 0 < shown < 1:
        return

    missing = math.ceil(HookUtils.get_private_field(activity, "avatarListY") - HookUtils.get_private_field(activity, "avatarHiddenY"))
    if missing <= 0:
        return

    list_view.setPadding(list_view.getPaddingLeft(), list_view.getPaddingTop(), list_view.getPaddingRight(), list_view.getPaddingBottom() + missing)
    list_view.smoothScrollBy(0, missing, CubicBezierInterpolator.EASE_OUT_QUINT)


class MaterialSettingsIcons(BasePlugin):
    def create_settings(self):
        try:
            EO = ExpandableOption
            tg_string = LocaleController.getString

            return [
                S.list_style.as_selector(
                    text=L.prefs_list_style,
                    items=[L.list_style_compact, L.list_style_md3],
                    on_change=lambda index: dex_settings_sync.set_md3_style(index == 1),
                    link_alias="style",
                ),
                S.reorder_settings_list.as_switch(
                    text=L.prefs_reorder_settings,
                    on_change=lambda _: dex_settings_sync.set_reorder_settings_list(
                        S.reorder_settings_list.get()
                    ),
                    link_alias="reorder",
                ),
                *ExpandableSwitchManager.generate(
                    L.prefs_debloat,
                    [
                        EO(
                            tg_string(Res.string.TelegramPremium), S.debloat_tg_prem,
                            dex_settings_sync.set_debloat_tg_prem,
                        ),
                        EO(
                            tg_string(Res.string.TelegramStars), S.debloat_tg_stars,
                            dex_settings_sync.set_debloat_tg_stars,
                        ),
                        EO(
                            tg_string(getattr(Res.string, "GramEarnings", Res.string.MyTON)), S.debloat_my_ton,
                            dex_settings_sync.set_debloat_my_ton,
                        ),
                        EO(
                            tg_string(Res.string.WalletAttachMoney) if hasattr(Res.string, "WalletAttachMoney") else "Wallet",
                            S.debloat_wallet,
                            dex_settings_sync.set_debloat_wallet,
                        ),
                        EO(
                            tg_string(Res.string.TelegramBusiness), S.debloat_tg_business,
                            dex_settings_sync.set_debloat_tg_business,
                        ),
                        EO(
                            tg_string(Res.string.SendAGift), S.debloat_send_gift,
                            dex_settings_sync.set_debloat_send_gift,
                        ),
                        EO(
                            L.prefs_help_section, S.debloat_help_section,
                            dex_settings_sync.set_debloat_help_section,
                        ),
                    ]
                )
            ]
        except Exception:
            logger.error("An error occurred:", exc_info=True)

    def on_plugin_load(self):
        if not dex_loader.inject():
            raise Exception("Failed to load dex module.")

        zwylib.add_autoupdater_task(AU_CHANNEL_ID, AU_MSG_ID)
        zwylib.locales_controller.subscribe_to_refresh(dex_settings_sync.set_fork_subtitles)

        snap_avatar_hide = HookUtils.find_method_by_args_count(jclass("org.telegram.ui.SettingsActivity"), "snapAvatarHide", 0)
        if snap_avatar_hide:
            HookUtils.hook_before(snap_avatar_hide, snap_avatar_hide_hook)

        dex_settings_sync.sync_initial_state()
        logger.info("Loaded.")

    def on_plugin_unload(self):
        zwylib.locales_controller.unsubscribe_from_refresh()
        dex_loader.unload()
        logger.info("Unloaded.")
