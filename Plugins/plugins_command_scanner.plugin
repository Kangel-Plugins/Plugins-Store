import os
import re
from base_plugin import BasePlugin
from java import jclass, dynamic_proxy

AndroidUtilities = jclass("org.telegram.messenger.AndroidUtilities")
PopupWindow = jclass("android.widget.PopupWindow")
ScrollView = jclass("android.widget.ScrollView")
LinearLayout = jclass("android.widget.LinearLayout")
TextView = jclass("android.widget.TextView")
OnClickListener = jclass("android.view.View$OnClickListener")
TextWatcher = jclass("android.text.TextWatcher")
BulletinFactory = jclass("org.telegram.ui.Components.BulletinFactory")
Runnable = jclass("java.lang.Runnable")
GradientDrawable = jclass("android.graphics.drawable.GradientDrawable")
ColorDrawable = jclass("android.graphics.drawable.ColorDrawable")
Color = jclass("android.graphics.Color")
SpannableString = jclass("android.text.SpannableString")
ForegroundColorSpan = jclass("android.text.style.ForegroundColorSpan")
Spannable = jclass("android.text.Spannable")
DialogInterfaceOnClickListener = jclass("android.content.DialogInterface$OnClickListener")

try:
    AlertDialogBuilder = jclass("org.telegram.ui.ActionBar.AlertDialog$Builder")
except Exception:
    AlertDialogBuilder = jclass("android.app.AlertDialog$Builder")

__id__ = "plugins_command_scanner"
__name__ = "Plugin Commands Scanner"
__description__ = "RU: Выводит интерактивное всплывающее меню всех команд плагинов.\n\nEN: Displays an interactive popup menu of all plugin commands."
__author__ = "@pluginsc"
__version__ = "1.0.1"
__icon__ = "open496/1"
__min_version__ = "12.1.1"

ACTIVE_POPUPS_REGISTRY = []


def to_jint(val):
    if isinstance(val, int) and val > 0x7FFFFFFF:
        return val - 0x100000000
    return val


def close_all_active_popups():
    global ACTIVE_POPUPS_REGISTRY
    for popup in list(ACTIVE_POPUPS_REGISTRY):
        try:
            popup.dismiss()
        except Exception:
            pass
    ACTIVE_POPUPS_REGISTRY.clear()


class UIThreadTask(dynamic_proxy(Runnable)):
    def __init__(self, action):
        super().__init__()
        self.action = action

    def run(self):
        try:
            self.action()
        except Exception:
            pass


class ThemeDialogListener(dynamic_proxy(DialogInterfaceOnClickListener)):
    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin

    def onClick(self, dialog, which):
        themes = [
            ("dark", "Тёмная"),
            ("light", "Светлая"),
            ("amoled", "Чёрная (AMOLED)")
        ]
        if 0 <= which < len(themes):
            mode, name = themes[which]
            self.plugin.select_theme(mode, name)
        try:
            dialog.dismiss()
        except Exception:
            pass


class ItemClickListener(dynamic_proxy(OnClickListener)):
    def __init__(self, plugin, cmd_name):
        super().__init__()
        self.plugin = plugin
        self.cmd_name = cmd_name

    def onClick(self, view):
        def action():
            try:
                close_all_active_popups()
                edit_text = self.plugin.get_current_edit_text()
                if not edit_text:
                    return

                self.plugin.is_internal_change = True
                
                edit_text.setText(self.cmd_name + " ")
                
                edit_text.requestFocus()
                edit_text.setSelection(edit_text.getText().length())
                AndroidUtilities.showKeyboard(edit_text)
                
                self.plugin.is_internal_change = False
            except Exception:
                self.plugin.is_internal_change = False

        AndroidUtilities.runOnUIThread(UIThreadTask(action))


class CustomTextWatcher(dynamic_proxy(TextWatcher)):
    def __init__(self, plugin, edit_text):
        super().__init__()
        self.plugin = plugin
        self.edit_text = edit_text

    def beforeTextChanged(self, s, start, count, after):
        pass

    def onTextChanged(self, s, start, before, count):
        pass

    def afterTextChanged(self, s):
        try:
            if self.plugin.is_internal_change:
                return

            text = s.toString().strip()
            trigger = self.plugin.get_setting("trigger_command", ".").strip()

            if text.lower() == trigger.lower():
                def show_ui():
                    close_all_active_popups()
                    self.plugin.show_interactive_menu(self.edit_text)

                self.edit_text.post(UIThreadTask(show_ui))
            else:
                if ACTIVE_POPUPS_REGISTRY and text.lower() != trigger.lower():
                    close_all_active_popups()
        except Exception:
            self.plugin.is_internal_change = False


class PluginCommandsScanner(BasePlugin):
    def on_plugin_load(self):
        self.log("Запуск Plugin Commands Scanner v1.0.0")
        close_all_active_popups()
        self.active_watchers = set()
        self.is_internal_change = False
        self.cached_prepared_items = []
        self.prebuilt_view = None
        self.prebuilt_context_hash = None
        self.prebuilt_theme = None
        self.is_running = True
        
        self.loop_task = UIThreadTask(self._checker_loop_step)
        
        self.refresh_commands_cache()
        self.start_chat_checker()

    def on_plugin_unload(self):
        self.is_running = False
        close_all_active_popups()

    def get_plugins_dir(self):
        return os.path.dirname(os.path.abspath(__file__))

    def get_current_edit_text(self):
        try:
            from client_utils import get_last_fragment
            fragment = get_last_fragment()
            if fragment and hasattr(fragment, "chatActivityEnterView"):
                enter_view = fragment.chatActivityEnterView
                if enter_view and hasattr(enter_view, "getEditField"):
                    return enter_view.getEditField()
        except Exception:
            pass
        return None

    def get_theme_colors(self):
        mode = str(self.get_setting("theme_style", "dark")).lower().strip()
        
        if mode == "amoled":
            bg_color = to_jint(Color.parseColor("#000000"))
            text_color = to_jint(Color.parseColor("#FFFFFF"))
            subtext_color = to_jint(Color.parseColor("#88FFFFFF"))
        elif mode == "light":
            bg_color = to_jint(Color.parseColor("#FFFFFF"))
            text_color = to_jint(Color.parseColor("#000000"))
            subtext_color = to_jint(Color.parseColor("#88000000"))
        else:
            bg_color = to_jint(Color.parseColor("#212121"))
            text_color = to_jint(Color.parseColor("#FFFFFF"))
            subtext_color = to_jint(Color.parseColor("#AA888888"))

        return bg_color, text_color, subtext_color

    def refresh_commands_cache(self):
        raw_commands = []
        plugins_dir = self.get_plugins_dir()
        pattern = re.compile(r'[\'"](\.[a-zA-Z0-9_]+)[\'"]')

        try:
            for root, _, files in os.walk(plugins_dir):
                if "__pycache__" in root:
                    continue
                for file in files:
                    if file.endswith('.py') and not file.startswith('__'):
                        file_path = os.path.join(root, file)
                        plugin_name = file.replace('.py', '')

                        try:
                            with open(file_path, 'r', encoding='utf-8', errors='ignore') as f:
                                content = f.read()
                                found = set(pattern.findall(content))

                                trigger_cmd = self.get_setting("trigger_command", ".").strip()
                                found.discard(trigger_cmd)

                                for cmd in sorted(list(found)):
                                    raw_commands.append((cmd, plugin_name))
                        except Exception as e:
                            self.log(f"Ошибка чтения {file}: {e}")
        except Exception as e:
            self.log(f"Ошибка сканирования: {e}")

        raw_commands.sort(key=lambda x: x[0])

        bg_color, text_color, subtext_color = self.get_theme_colors()
        self.cached_prepared_items = []

        for cmd, plugin_name in raw_commands:
            full_item = f"{cmd}  ({plugin_name})"
            ss = SpannableString(full_item)
            ss.setSpan(ForegroundColorSpan(text_color), 0, len(cmd), Spannable.SPAN_EXCLUSIVE_EXCLUSIVE)
            if plugin_name:
                ss.setSpan(ForegroundColorSpan(subtext_color), len(cmd), len(full_item), Spannable.SPAN_EXCLUSIVE_EXCLUSIVE)
            
            self.cached_prepared_items.append((cmd, ss))

        self.prebuilt_view = None
        return self.cached_prepared_items

    def build_layout_in_advance(self, edit_text):
        try:
            current_mode = str(self.get_setting("theme_style", "dark")).lower().strip()
            
            if self.prebuilt_theme != current_mode:
                self.prebuilt_theme = current_mode
                self.prebuilt_view = None
                self.refresh_commands_cache()

            context = edit_text.getContext()
            context_hash = context.hashCode()

            if self.prebuilt_view is not None and self.prebuilt_context_hash == context_hash:
                return self.prebuilt_view

            bg_color, text_color, subtext_color = self.get_theme_colors()

            scroll_view = ScrollView(context)
            scroll_view.setVerticalScrollBarEnabled(True)

            drawable = GradientDrawable()
            drawable.setShape(GradientDrawable.RECTANGLE)
            drawable.setColor(bg_color)
            drawable.setCornerRadius(AndroidUtilities.dp(12))
            scroll_view.setBackground(drawable)

            container = LinearLayout(context)
            container.setOrientation(LinearLayout.VERTICAL)
            pad = AndroidUtilities.dp(6)
            container.setPadding(0, pad, 0, pad)

            if not self.cached_prepared_items:
                tv = TextView(context)
                tv.setTextSize(1, 14)
                tv.setPadding(
                    AndroidUtilities.dp(16),
                    AndroidUtilities.dp(10),
                    AndroidUtilities.dp(16),
                    AndroidUtilities.dp(10)
                )
                tv.setTextColor(text_color)
                tv.setText("Команды не найдены")
                container.addView(tv)
            else:
                for cmd_name, ss in self.cached_prepared_items:
                    tv = TextView(context)
                    tv.setTextSize(1, 14)
                    tv.setPadding(
                        AndroidUtilities.dp(16),
                        AndroidUtilities.dp(10),
                        AndroidUtilities.dp(16),
                        AndroidUtilities.dp(10)
                    )
                    tv.setText(ss)
                    tv.setOnClickListener(ItemClickListener(self, cmd_name))
                    container.addView(tv)

            scroll_view.addView(container)

            self.prebuilt_view = scroll_view
            self.prebuilt_context_hash = context_hash
            return scroll_view
        except Exception as e:
            self.log(f"Ошибка предварительной сборки UI: {e}")
            return None

    def show_interactive_menu(self, edit_text):
        try:
            close_all_active_popups()

            content_view = self.build_layout_in_advance(edit_text)
            if content_view is None:
                return

            parent = content_view.getParent()
            if parent is not None:
                try:
                    parent.removeView(content_view)
                except Exception:
                    pass

            popup_height = AndroidUtilities.dp(200)
            popup_width = edit_text.getWidth()
            if popup_width <= 0:
                popup_width = AndroidUtilities.dp(300)

            popup = PopupWindow(content_view, popup_width, popup_height, False)
            popup.setBackgroundDrawable(ColorDrawable(0))
            popup.setOutsideTouchable(True)
            popup.setAnimationStyle(0)

            ACTIVE_POPUPS_REGISTRY.append(popup)

            y_offset = -(edit_text.getHeight() + popup_height + AndroidUtilities.dp(6))
            popup.showAsDropDown(edit_text, 0, y_offset)
        except Exception as e:
            self.log(f"Ошибка показа меню: {e}")

    def attach_watcher(self):
        try:
            edit_text = self.get_current_edit_text()
            if edit_text:
                edit_hash = edit_text.hashCode()
                if edit_hash not in self.active_watchers:
                    watcher = CustomTextWatcher(self, edit_text)
                    edit_text.addTextChangedListener(watcher)
                    self.active_watchers.add(edit_hash)
                    self.build_layout_in_advance(edit_text)
        except Exception:
            pass

    def _checker_loop_step(self):
        if not self.is_running:
            return
        self.attach_watcher()
        AndroidUtilities.runOnUIThread(self.loop_task, 1000)

    def start_chat_checker(self):
        AndroidUtilities.runOnUIThread(self.loop_task, 500)

    def send_message_hook(self, message_text, peer_id, reply_to_msg_id=None, **kwargs):
        try:
            trigger = self.get_setting("trigger_command", ".").strip()
            if message_text and message_text.strip().lower() == trigger.lower():
                def show_ui():
                    edit_text = self.get_current_edit_text()
                    if edit_text:
                        self.show_interactive_menu(edit_text)

                AndroidUtilities.runOnUIThread(UIThreadTask(show_ui))
                return None
        except Exception as e:
            self.log(f"Ошибка в send_message_hook: {e}")
        return message_text

    def show_bulletin(self, text):
        try:
            R_drawable = jclass("org.telegram.messenger.R$drawable")
            icon_res = 0
            for icon_name in ["msg_file", "msg_download", "msg_archive", "ic_ab_other"]:
                if hasattr(R_drawable, icon_name):
                    icon_res = getattr(R_drawable, icon_name)
                    break

            from client_utils import get_last_fragment
            fragment = get_last_fragment()

            if fragment and icon_res != 0:
                BulletinFactory.of(fragment).createSimpleBulletin(icon_res, text).show()
            else:
                Toast = jclass("android.widget.Toast")
                ApplicationLoader = jclass("org.telegram.messenger.ApplicationLoader")
                Toast.makeText(ApplicationLoader.applicationContext, text, Toast.LENGTH_SHORT).show()
        except Exception as e:
            self.log(f"Ошибка показа всплывающего сообщения: {e}")

    def select_theme(self, mode, name):
        self.set_setting("theme_style", mode)
        self.prebuilt_theme = mode
        self.prebuilt_view = None
        self.refresh_commands_cache()
        self.show_bulletin(f"Тема изменена на: {name}")

    def show_theme_dialog(self):
        try:
            from client_utils import get_last_fragment
            fragment = get_last_fragment()
            if not fragment:
                return

            context = fragment.getParentActivity()
            if not context:
                context = fragment.getContext()

            builder = AlertDialogBuilder(context)
            builder.setTitle("Тема")

            options = ["Тёмная", "Светлая", "Чёрная (AMOLED)"]
            StringArray = jclass("[Ljava.lang.String;")
            
            builder.setItems(StringArray(options), ThemeDialogListener(self))
            builder.show()
        except Exception as e:
            self.log(f"Ошибка вызова диалога темы: {e}")

    def create_settings(self):
        try:
            from ui.settings import Header, Input, Text, Divider

            curr_theme = str(self.get_setting("theme_style", "dark")).lower().strip()
            theme_names = {
                "dark": "Тёмная",
                "light": "Светлая",
                "amoled": "Чёрная (AMOLED)"
            }
            current_name = theme_names.get(curr_theme, "Тёмная")

            return [
                Header(text="Настройки триггера"),
                Input(
                    text="Триггер-команда",
                    subtext="Введите команду в чате для вызова меню (например .)",
                    key="trigger_command",
                    default="."
                ),
                Header(text="Оформление меню"),
                Text(
                    text="Тема",
                    subtext=f"Текущая тема: {current_name}",
                    on_click=lambda *args: self.show_theme_dialog()
                ),
                Divider(text="Тестирование"),
                Text(
                    text="🔄 Обновить и проверить список команд",
                    subtext="Пересканирует плагины и обновляет кэш",
                    on_click=lambda *args: (
                        self.refresh_commands_cache(),
                        self.show_bulletin(f"Обновлено! Найдено команд: {len(self.cached_prepared_items)}")
                    )
                )
            ]
        except Exception as e:
            self.log(f"Ошибка настроек: {e}")
            from ui.settings import Header, Input
            return [
                Header(text="Настройки триггера"),
                Input(
                    text="Триггер-команда",
                    key="trigger_command",
                    default="."
                )
            ]
