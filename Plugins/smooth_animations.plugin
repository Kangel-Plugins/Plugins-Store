__id__ = "smooth_animations"
__name__ = "Smooth Animations"
__description__ = "Плавнее анимации: включает все анимации, максимальную частоту экрана и скорость анимаций"
__author__ = "@ayamari_zxc"
__version__ = "1.0.0"
__min_version__ = "11.9.0"

from base_plugin import BasePlugin
from android_utils import run_on_ui_thread, log
from client_utils import get_last_fragment
from ui.settings import Header, Switch, Selector, Divider, Text

SCALES = [0.7, 0.85, 1.0, 1.2, 1.5]
SCALE_NAMES = ["0.7x (быстрее)", "0.85x", "1x (как обычно)", "1.2x (мягче)", "1.5x (очень плавно)"]


class SmoothAnimationsPlugin(BasePlugin):
    def on_plugin_load(self):
        run_on_ui_thread(lambda: self._apply({}))

    def on_plugin_unload(self):
        # возвращаем обычную скорость
        run_on_ui_thread(lambda: self._set_scale(1.0))

    # ---------- настройки ----------
    def create_settings(self):
        def ch(key):
            return lambda v: run_on_ui_thread(lambda: self._apply({key: v}))

        return [
            Header(text="Плавность"),
            Switch(
                key="all_anim",
                text="Включить все анимации",
                subtext="Отключает экономию на анимациях в клиенте",
                default=True,
                on_change=ch("all_anim"),
            ),
            Switch(
                key="high_perf",
                text="Режим высокой производительности",
                subtext="Клиент считает устройство мощным и не упрощает эффекты",
                default=True,
                on_change=ch("high_perf"),
            ),
            Switch(
                key="max_hz",
                text="Максимальная частота экрана",
                subtext="90/120 Гц, если экран поддерживает",
                default=True,
                on_change=ch("max_hz"),
            ),
            Divider(),
            Selector(
                key="scale",
                text="Скорость анимаций",
                default=2,
                items=SCALE_NAMES,
                on_change=ch("scale"),
            ),
            Text(text="Скорость меняет длительность всех анимаций приложения. После изменения при необходимости перезапусти клиент."),
        ]

    def _get(self, key, default, over):
        if key in over:
            return over[key]
        try:
            return self.get_setting(key, default)
        except Exception:
            return default

    # ---------- применение ----------
    def _apply(self, over):
        if self._get("all_anim", True, over):
            self._enable_all_anim()
        if self._get("high_perf", True, over):
            self._high_perf()
        if self._get("max_hz", True, over):
            self._max_refresh()
        idx = self._get("scale", 2, over)
        try:
            self._set_scale(SCALES[int(idx)])
        except Exception:
            self._set_scale(1.0)

    def _enable_all_anim(self):
        try:
            from org.telegram.messenger import LiteMode
            try:
                LiteMode.setAllFlags(LiteMode.PRESET_HIGH)
            except Exception:
                LiteMode.setAllFlags(-1)
        except Exception as e:
            log("SmoothAnim LiteMode: " + str(e))

    def _high_perf(self):
        try:
            from org.telegram.messenger import SharedConfig
            SharedConfig.overrideDevicePerformanceClass(SharedConfig.PERFORMANCE_CLASS_HIGH)
        except Exception as e:
            log("SmoothAnim perf class: " + str(e))

    def _max_refresh(self):
        try:
            fr = get_last_fragment()
            act = fr.getParentActivity() if fr is not None else None
            if act is None:
                return
            best = 60.0
            try:
                for m in act.getWindowManager().getDefaultDisplay().getSupportedModes():
                    best = max(best, float(m.getRefreshRate()))
            except Exception:
                best = 120.0
            w = act.getWindow()
            lp = w.getAttributes()
            lp.preferredRefreshRate = float(best)
            w.setAttributes(lp)
        except Exception as e:
            log("SmoothAnim refresh rate: " + str(e))

    def _set_scale(self, scale):
        try:
            from android.animation import ValueAnimator
            ValueAnimator.setDurationScale(float(scale))
        except Exception as e:
            log("SmoothAnim duration scale: " + str(e))
