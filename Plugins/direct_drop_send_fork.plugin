_FIELD_CACHE = {}
_METHOD_CACHE = {}
_DOC_ITEM_CTOR = None
_PHOTO_ENTRY_MODE = None
_PREPARE_MEDIA_METHOD = None
_PREPARE_DOCS_METHOD = None


def same_java_obj(a, b):
    if a is None or b is None:
        return False
    try:
        return int(System.identityHashCode(a)) == int(System.identityHashCode(b))
    except Exception:
        return False


def to_py_int(val, default=0):
    if val is None:
        return default
    if isinstance(val, int):
        return val
    try:
        return int(val.intValue())
    except Exception:
        try:
            return int(val)
        except Exception:
            return default


def to_py_bool(val, default=False):
    if val is None:
        return default
    if isinstance(val, bool):
        return val
    try:
        return bool(val.booleanValue())
    except Exception:
        try:
            return bool(val)
        except Exception:
            return default


def _get_cached_field(obj, field_name):
    try:
        cls = obj.getClass()
        key = (str(cls.getName()), field_name)
        if key in _FIELD_CACHE:
            return _FIELD_CACHE[key]

        curr = cls
        while curr is not None:
            try:
                for f in curr.getDeclaredFields():
                    if f.getName() == field_name:
                        f.setAccessible(True)
                        _FIELD_CACHE[key] = f
                        return f
            except Exception:
                pass
            curr = curr.getSuperclass()

        _FIELD_CACHE[key] = None
    except Exception:
        pass
    return None


def get_java_field(obj, field_name):
    if obj is None:
        return None
    try:
        f = _get_cached_field(obj, field_name)
        if f is not None:
            return f.get(obj)
    except Exception:
        pass
    try:
        return get_private_field(obj, field_name)
    except Exception:
        return None


def set_java_field(obj, field_name, value):
    if obj is None:
        return False
    try:
        f = _get_cached_field(obj, field_name)
        if f is not None:
            f.set(obj, value)
            return True
    except Exception:
        pass
    try:
        set_private_field(obj, field_name, value)
        return True
    except Exception:
        return False


def get_java_method(obj, method_name, param_count=None):
    if obj is None:
        return None
    try:
        cls = obj.getClass()
        key = (str(cls.getName()), method_name, param_count)
        if key in _METHOD_CACHE:
            return _METHOD_CACHE[key]

        curr = cls
        while curr is not None:
            try:
                for m in curr.getDeclaredMethods():
                    if m.getName() == method_name:
                        if param_count is None or len(m.getParameterTypes()) == param_count:
                            m.setAccessible(True)
                            _METHOD_CACHE[key] = m
                            return m
            except Exception:
                pass
            curr = curr.getSuperclass()

        _METHOD_CACHE[key] = None
    except Exception:
        pass
    return None


class CachedClasses:
    file_loader = None
    app_loader = None
    file_provider = None
    chat_object = None
    media_controller = None
    photo_entry = None
    photo_viewer = None
    empty_pv_provider = None
    doc_layout = None
    sending_media_info = None
    account_instance = None
    android_utilities = None
    theme = None
    provider_authority = None

    @classmethod
    def init(cls):
        if cls.file_loader is None:
            cls.file_loader = find_class(CLS_FILE_LOADER)
        if cls.app_loader is None:
            cls.app_loader = find_class(CLS_APP_LOADER)
        if cls.file_provider is None:
            cls.file_provider = find_class(CLS_FILE_PROVIDER)
        if cls.chat_object is None:
            cls.chat_object = find_class(CLS_CHAT_OBJECT)
        if cls.media_controller is None:
            cls.media_controller = find_class(CLS_MEDIA_CONTROLLER)
        if cls.photo_entry is None:
            cls.photo_entry = find_class(CLS_PHOTO_ENTRY)
        if cls.photo_viewer is None:
            cls.photo_viewer = find_class(CLS_PHOTO_VIEWER)
        if cls.empty_pv_provider is None:
            cls.empty_pv_provider = find_class(CLS_EMPTY_PV_PROVIDER)
        if cls.doc_layout is None:
            cls.doc_layout = find_class(CLS_DOC_LAYOUT)
        if cls.sending_media_info is None:
            cls.sending_media_info = find_class(CLS_SENDING_MEDIA_INFO)
        if cls.account_instance is None:
            cls.account_instance = find_class(CLS_ACCOUNT_INSTANCE)
        if cls.android_utilities is None:
            cls.android_utilities = find_class(CLS_ANDROID_UTILITIES)
        if cls.theme is None:
            cls.theme = find_class(CLS_THEME)
        if cls.provider_authority is None and cls.app_loader is not None:
            try:
                cls.provider_authority = str(cls.app_loader.getApplicationId()) + ".provider"
            except Exception:
                pass


def dp_to_px(context, dp_val):
    try:
        dm = context.getResources().getDisplayMetrics()
        return float(TypedValue.applyDimension(TypedValue.COMPLEX_UNIT_DIP, float(dp_val), dm))
    except Exception:
        return float(dp_val) * 2.75


def format_file_size_fast(size_bytes):
    try:
        CachedClasses.init()
        if CachedClasses.android_utilities is not None and hasattr(CachedClasses.android_utilities, "formatFileSize"):
            return str(CachedClasses.android_utilities.formatFileSize(jlong(size_bytes)))
        if size_bytes < 1024:
            return f"{size_bytes} B"
        elif size_bytes < 1024 * 1024:
            return f"{size_bytes / 1024.0:.1f} KB"
        else:
            return f"{size_bytes / (1024.0 * 1024.0):.1f} MB"
    except Exception:
        return ""


def fast_copy_file(src_path, dst_path):
    """Мгновенное копирование файла через системный вызов sendfile (FileChannel.transferTo)."""
    fis = None
    fos = None
    try:
        fis = FileInputStream(src_path)
        fos = FileOutputStream(dst_path)
        ch_in = fis.getChannel()
        ch_out = fos.getChannel()
        size = ch_in.size()
        pos = 0
        while pos < size:
            transferred = ch_in.transferTo(pos, size - pos, ch_out)
            if transferred <= 0:
                break
            pos += transferred
        return True
    except Exception:
        try:
            shutil.copyfile(src_path, dst_path)
            return True
        except Exception:
            return False
    finally:
        if fos is not None:
            try:
                fos.close()
            except Exception:
                pass
        if fis is not None:
            try:
                fis.close()
            except Exception:
                pass


def get_accent_color(activity, chat_activity=None):
    CachedClasses.init()
    theme_cls = CachedClasses.theme
    if theme_cls is not None:
        for key_name in ("key_checkbox", "key_chats_actionBackground", "key_featuredStickers_addButton"):
            try:
                key_val = getattr(theme_cls, key_name, None)
                if key_val is not None:
                    if chat_activity is not None and hasattr(chat_activity, "getThemedColor"):
                        c = to_py_int(chat_activity.getThemedColor(key_val), 0)
                        if c != 0:
                            return c
                    c = to_py_int(theme_cls.getColor(key_val), 0)
                    if c != 0:
                        return c
            except Exception:
                pass

    if activity is not None:
        try:
            tv = TypedValue()
            if activity.getTheme().resolveAttribute(0x01010435, tv, True) and tv.data != 0:
                return int(tv.data)
        except Exception:
            pass

    return Color.parseColor("#FF3B82F6")


def get_active_chat_activity(plugin=None, view=None):
    try:
        frag = get_last_fragment()
        if frag is not None:
            cls_name = str(frag.getClass().getName())
            if "ChatActivity" in cls_name or hasattr(frag, "getDialogId"):
                fv = None
                try:
                    fv = frag.getFragmentView()
                except Exception:
                    pass
                if fv is not None:
                    try:
                        if hasattr(fv, "isAttachedToWindow") and fv.isAttachedToWindow():
                            return frag
                    except Exception:
                        pass
                return frag
    except Exception:
        pass

    if plugin and plugin._current_chat_activity is not None:
        curr = plugin._current_chat_activity
        try:
            fv = curr.getFragmentView()
            if fv is not None and hasattr(fv, "isAttachedToWindow") and fv.isAttachedToWindow():
                return curr
        except Exception:
            pass
        return curr

    if view is not None:
        try:
            ctx = view.getContext()
            for attr_name in ("getActionBarLayout", "actionBarLayout"):
                if hasattr(ctx, attr_name):
                    abl = getattr(ctx, attr_name)
                    if callable(abl):
                        abl = abl()
                    if abl is not None:
                        if hasattr(abl, "getLastFragment"):
                            f = abl.getLastFragment()
                            if f is not None and ("ChatActivity" in str(f.getClass().getName()) or hasattr(f, "getDialogId")):
                                return f
                        if hasattr(abl, "fragmentsStack"):
                            stack = abl.fragmentsStack
                            if stack is not None and stack.size() > 0:
                                f = stack.get(stack.size() - 1)
                                if f is not None and ("ChatActivity" in str(f.getClass().getName()) or hasattr(f, "getDialogId")):
                                    return f
        except Exception:
            pass

    return None


def get_message_edit_text(chat_activity):
    if chat_activity is None:
        return None
    try:
        enter_view = get_java_field(chat_activity, "chatActivityEnterView")
        if enter_view is None and hasattr(chat_activity, "getChatActivityEnterView"):
            try:
                enter_view = chat_activity.getChatActivityEnterView()
            except Exception:
                pass
        if enter_view is not None:
            et = get_java_field(enter_view, "messageEditText")
            if et is not None:
                return et
            if hasattr(enter_view, "getEditField"):
                return enter_view.getEditField()
    except Exception:
        pass
    return None


def can_write_to_chat(chat_activity, is_media=False):
    if chat_activity is None:
        return False

    try:
        enter_view = get_java_field(chat_activity, "chatActivityEnterView")
        if enter_view is None or enter_view.getVisibility() != View.VISIBLE:
            return False

        for overlay_name in ("bottomOverlayChat", "bottomOverlay"):
            ov = get_java_field(chat_activity, overlay_name)
            if ov is not None and ov.getVisibility() == View.VISIBLE:
                return False

        current_chat = chat_activity.getCurrentChat()
        if current_chat is not None:
            chat_obj_cls = CachedClasses.chat_object or find_class(CLS_CHAT_OBJECT)
            if chat_obj_cls is not None:
                if hasattr(chat_obj_cls, "canWriteToChat") and not chat_obj_cls.canWriteToChat(current_chat):
                    return False
                if hasattr(chat_obj_cls, "canSendMessages") and not chat_obj_cls.canSendMessages(current_chat):
                    return False
                if hasattr(chat_obj_cls, "isNotInChat") and chat_obj_cls.isNotInChat(current_chat):
                    return False
                if is_media and hasattr(chat_obj_cls, "canSendMedia") and not chat_obj_cls.canSendMedia(current_chat):
                    return False
    except Exception:
        pass

    return True


def clear_all_selections(chat_activity, cell=None):
    def _clear():
        try:
            if chat_activity is not None:
                tsh = get_java_field(chat_activity, "textSelectionHelper")
                if tsh is not None:
                    try:
                        tsh.clear(True)
                    except Exception:
                        try:
                            tsh.clear()
                        except Exception:
                            pass

                for m_name in ("hideActionMode", "clearSelectionMode", "closeMenu"):
                    if hasattr(chat_activity, m_name):
                        getattr(chat_activity, m_name)()

            if cell is not None:
                try:
                    cell.setChecked(False, False, True)
                except Exception:
                    pass
                cell.invalidate()
        except Exception:
            pass

    run_on_ui_thread(_clear)
    run_on_ui_thread(_clear, 120)


class EditTextTouchTracker(dynamic_proxy(View.OnTouchListener)):
    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin

    def onTouch(self, v, event):
        try:
            if event is not None and event.getActionMasked() == MotionEvent.ACTION_DOWN and v is not None:
                s_raw = int(v.getSelectionStart())
                e_raw = int(v.getSelectionEnd())
                if s_raw != e_raw:
                    s, e = min(s_raw, e_raw), max(s_raw, e_raw)
                    editable = v.getText()
                    if editable is not None and 0 <= s < e <= editable.length():
                        self.plugin._last_et_touch_sel = {
                            "et_hash": int(System.identityHashCode(v)),
                            "start": s,
                            "end": e,
                            "text": str(editable.subSequence(s, e)),
                            "time": time.time(),
                        }
        except Exception:
            pass
        return False


class DocumentLayoutOnShowHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        session = self.plugin._doc_sheet_session
        if session is None:
            return
        if time.time() - session.get("time", 0) > 4.0:
            self.plugin._doc_sheet_session = None
            return

        doc_layout = param.thisObject
        if doc_layout is None:
            return

        try:
            listener = self.plugin._global_drop_listener
            if listener is not None and not session.get("injected"):
                session["injected"] = True
                cap = session.get("draft_caption")
                session["draft_caption"] = None
                listener._inject_files_into_document_layout(
                    session["chat_activity"],
                    session["attach_alert"],
                    doc_layout,
                    session["doc_items"],
                    cap,
                )
        except Exception as e:
            self.plugin.log(f"[DirectDrop] DocumentLayoutOnShowHook error: {e}")


class DocumentLayoutSendHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        doc_layout = param.thisObject
        if doc_layout is None:
            return

        session = self.plugin._doc_sheet_session
        self.plugin._doc_sheet_session = None

        try:
            selected_order = get_java_field(doc_layout, "selectedFilesOrder")
            selected_files = get_java_field(doc_layout, "selectedFiles")
            count = int(selected_order.size()) if selected_order is not None else 0
            if count == 0 and selected_files is not None:
                count = int(selected_files.size())
            if count <= 0:
                return

            chat_activity = (
                session["chat_activity"]
                if session is not None
                else get_active_chat_activity(self.plugin)
            )
            if chat_activity is None:
                return

            peer_id = int(chat_activity.getDialogId())
            reply_ctx = (
                session["reply_ctx"]
                if session is not None
                else self.plugin._global_drop_listener._get_reply_context(chat_activity)
            )

            if get_java_field(doc_layout, "delegate") is not None:
                for _ in range(count):
                    self.plugin._global_drop_listener._queue_reply_context(
                        chat_activity, peer_id, reply_ctx
                    )
                return

            attach_alert = get_java_field(doc_layout, "parentAlert") or (
                session["attach_alert"] if session is not None else None
            )
            caption_val = None
            if attach_alert is not None:
                comment_tv = get_java_field(attach_alert, "commentTextView")
                if comment_tv is not None and hasattr(comment_tv, "getText"):
                    t = comment_tv.getText()
                    if t is not None and len(str(t).strip()) > 0:
                        caption_val = str(t).strip()

            files_to_send = []
            if selected_order is not None:
                for i in range(int(selected_order.size())):
                    p_str = str(selected_order.get(i))
                    if os.path.isfile(p_str):
                        ext = os.path.splitext(p_str)[1].lstrip(".").lower()
                        mime = MimeTypeMap.getSingleton().getMimeTypeFromExtension(ext) if ext else None
                        files_to_send.append((p_str, os.path.basename(p_str), mime or "application/octet-stream"))

            if attach_alert is not None:
                try:
                    attach_alert.dismiss(True)
                except Exception:
                    try:
                        attach_alert.dismiss()
                    except Exception:
                        pass

            if files_to_send:
                self.plugin._global_drop_listener._send_documents_group_or_fallback(
                    chat_activity, peer_id, reply_ctx, files_to_send, caption_val
                )
            param.setResult(None)
        except Exception as e:
            self.plugin.log(f"[DirectDrop] DocumentLayoutSendHook error: {e}")


class PhotoViewerProviderHook(MethodHook):
    def __init__(self, plugin, method_name):
        self.plugin = plugin
        self.method_name = method_name

    def before_hooked_method(self, param):
        session = self.plugin._pv_session
        if session is None or param.thisObject is None:
            return

        try:
            if int(System.identityHashCode(param.thisObject)) != session["provider_hash"]:
                return

            m_name = self.method_name

            if m_name in ("allowCaption", "canScrollAway", "allowGroupPhotos"):
                param.setResult(True)
                return

            if m_name == "getSelectedPhotos":
                param.setResult(session["selected_map"])
                return

            if m_name == "getSelectedPhotosOrder":
                param.setResult(session["selected_order"])
                return

            if m_name == "getSelectedCount":
                param.setResult(int(session["selected_order"].size()))
                return

            if m_name == "getPhotoIndex":
                idx = to_py_int(param.args[0], 0) if param.args else 0
                if 0 <= idx < len(session["media_items"]):
                    entry = session["media_items"][idx][0]
                    param.setResult(int(session["selected_order"].indexOf(Integer(to_py_int(entry.imageId)))))
                else:
                    param.setResult(-1)
                return

            if m_name == "isPhotoChecked":
                idx = to_py_int(param.args[0], 0) if param.args else 0
                if 0 <= idx < len(session["media_items"]):
                    entry = session["media_items"][idx][0]
                    param.setResult(bool(session["selected_map"].containsKey(Integer(to_py_int(entry.imageId)))))
                else:
                    param.setResult(False)
                return

            if m_name == "setPhotoChecked":
                idx = to_py_int(param.args[0], 0) if param.args else 0
                vei = param.args[1] if (param.args and len(param.args) > 1) else None
                if 0 <= idx < len(session["media_items"]):
                    entry = session["media_items"][idx][0]
                    if vei is not None:
                        set_java_field(entry, "editedInfo", vei)
                    key_id = Integer(to_py_int(entry.imageId))
                    if session["selected_map"].containsKey(key_id):
                        session["selected_map"].remove(key_id)
                        session["selected_order"].remove(key_id)
                    else:
                        session["selected_map"].put(key_id, entry)
                        session["selected_order"].add(key_id)
                param.setResult(0)
                return

            if m_name == "cancelButtonPressed":
                self.plugin._pv_session = None
                param.setResult(True)
                return

            if m_name == "sendButtonPressed":
                if session.get("sent"):
                    param.setResult(None)
                    return

                idx = to_py_int(param.args[0], 0) if (param.args and len(param.args) > 0) else 0
                vei = param.args[1] if (param.args and len(param.args) > 1) else None
                notify = to_py_bool(param.args[2], True) if (param.args and len(param.args) > 2) else True
                schedule_date = to_py_int(param.args[3], 0) if (param.args and len(param.args) > 3) else 0
                force_doc = to_py_bool(param.args[4], False) if (param.args and len(param.args) > 4) else False

                session["sent"] = True
                self.plugin._pv_session = None

                self.plugin._global_drop_listener._send_from_photo_viewer_session(
                    session, idx, vei, notify, schedule_date, force_doc
                )
                param.setResult(None)
                return

        except Exception as e:
            self.plugin.log(f"[DirectDrop] PV provider hook error ({self.method_name}): {e}")


class PhotoViewerInternalSendHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        session = self.plugin._pv_session
        if session is None or session.get("sent"):
            return

        try:
            session["sent"] = True
            self.plugin._pv_session = None

            pv = param.thisObject
            cur_idx = to_py_int(get_private_field(pv, "currentIndex"), 0) if pv is not None else 0
            vei = None
            if pv is not None and hasattr(pv, "getCurrentVideoEditedInfo"):
                try:
                    vei = pv.getCurrentVideoEditedInfo()
                except Exception:
                    pass

            self.plugin._global_drop_listener._send_from_photo_viewer_session(
                session, cur_idx, vei, True, 0, False
            )
        except Exception as e:
            self.plugin.log(f"[DirectDrop] Internal PV send hook error: {e}")


class DirectDropListener(dynamic_proxy(View.OnDragListener)):
    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin
        self.keep_perms = []
        self.last_drop_time = 0.0
        self.last_cursor_update_time = 0.0
        self.last_cache_cleanup_time = 0.0
        self.active_et_cut_info = None
        self.last_hover_offset = -1
        self.cached_drag_et = None
        self.source_drag_et = None
        self._loc_v = jarray(jint)(2)
        self._loc_et = jarray(jint)(2)
        self._copy_buf = jarray(jbyte)(262144)

    def onDrag(self, v, event):
        if event is None:
            return False

        action = event.getAction()

        if action == DragEvent.ACTION_DRAG_STARTED:
            self.last_hover_offset = -1
            self.source_drag_et = None
            chat_activity = get_active_chat_activity(self.plugin, v)
            if chat_activity is not None:
                self.source_drag_et = get_message_edit_text(chat_activity)
            self.cached_drag_et = self.source_drag_et
            self._lock_edit_text_source_on_drag_start()
            return True

        if action in (DragEvent.ACTION_DRAG_ENTERED, DragEvent.ACTION_DRAG_EXITED):
            return True

        if action == DragEvent.ACTION_DRAG_ENDED:
            self.active_et_cut_info = None
            self.last_hover_offset = -1
            self.cached_drag_et = None
            self.source_drag_et = None
            self.plugin._is_internal_chat_text_drag = False
            return True

        if action == DragEvent.ACTION_DRAG_LOCATION:
            now = time.time()
            if now - self.last_cursor_update_time >= 0.015:
                self.last_cursor_update_time = now
                self._update_edit_text_cursor_from_drag(v, event)
            return True

        if action == DragEvent.ACTION_DROP:
            now = time.time()
            if now - self.last_drop_time < 0.45:
                return True

            chat_activity = get_active_chat_activity(self.plugin, v)
            if chat_activity is None:
                return False

            current_dialog = int(chat_activity.getDialogId())
            clip_data = event.getClipData()
            if clip_data is None or clip_data.getItemCount() == 0:
                return False

            item_count = clip_data.getItemCount()
            raw_uris = []
            dropped_texts = []

            for i in range(item_count):
                item = clip_data.getItemAt(i)
                if item is None:
                    continue
                u = item.getUri()
                if u is not None:
                    raw_uris.append((u, i))
                else:
                    t = item.getText()
                    if t is not None and len(str(t)) > 0:
                        dropped_texts.append(str(t))

            has_uris = len(raw_uris) > 0

            if has_uris and not self.plugin.get_setting("allow_same_chat_drop", True):
                if (
                    self.plugin._last_drag_source_dialog == current_dialog
                    and now - self.plugin._last_drag_start_time < 20.0
                ):
                    return False

            if not can_write_to_chat(chat_activity, is_media=has_uris):
                self.last_drop_time = now
                BulletinHelper.show_error("В этот чат нельзя отправлять сообщения", chat_activity)
                return False

            if not raw_uris and not dropped_texts:
                return False

            activity = chat_activity.getParentActivity()
            if activity is None:
                return False

            if has_uris:
                try:
                    perms = activity.requestDragAndDropPermissions(event)
                    if perms:
                        self.keep_perms.append(perms)
                        if len(self.keep_perms) > 8:
                            self.keep_perms.pop(0)
                except Exception:
                    pass

            self.last_drop_time = now

            if dropped_texts:
                self._insert_or_move_text_at_drop_point(chat_activity, v, event, "\n".join(dropped_texts))

            if raw_uris:
                resolver = activity.getContentResolver()
                desc = clip_data.getDescription()
                desc_label = str(desc.getLabel()) if (desc is not None and desc.getLabel() is not None) else None
                reply_ctx = self._get_reply_context(chat_activity)

                # Запускаем в выделенном потоке без ожидания очереди pluginsQueue
                threading.Thread(
                    target=self._process_and_present,
                    args=(chat_activity, current_dialog, reply_ctx, resolver, desc_label, raw_uris),
                    daemon=True,
                ).start()

            return True

        return False

    def _lock_edit_text_source_on_drag_start(self):
        if self.active_et_cut_info is not None or self.plugin._is_internal_chat_text_drag:
            return

        try:
            et = self.source_drag_et or self.cached_drag_et
            if et is None:
                return

            et_hash = int(System.identityHashCode(et))
            editable = et.getText()
            if editable is not None:
                s_raw = int(et.getSelectionStart())
                e_raw = int(et.getSelectionEnd())
                if s_raw != e_raw:
                    s, e = min(s_raw, e_raw), max(s_raw, e_raw)
                    if 0 <= s < e <= editable.length():
                        self.active_et_cut_info = {
                            "et_hash": et_hash,
                            "start": s,
                            "end": e,
                            "text": str(editable.subSequence(s, e)),
                        }
                        return

            saved = self.plugin._last_et_touch_sel
            if saved is not None and saved["et_hash"] == et_hash and (time.time() - saved["time"]) < 5.0:
                self.active_et_cut_info = dict(saved)
        except Exception:
            pass

    def _compute_edit_text_offset(self, et, target_view, event):
        if et is None or target_view is None or event is None:
            return -1

        try:
            target_view.getLocationOnScreen(self._loc_v)
            et.getLocationOnScreen(self._loc_et)

            local_x = float(self._loc_v[0]) + float(event.getX()) - float(self._loc_et[0])
            local_y = float(self._loc_v[1]) + float(event.getY()) - float(self._loc_et[1])

            et_w = float(et.getWidth())
            et_h = float(et.getHeight())

            if -45.0 <= local_x <= et_w + 45.0 and -60.0 <= local_y <= et_h + 60.0:
                return int(et.getOffsetForPosition(max(0.0, min(local_x, et_w)), max(0.0, min(local_y, et_h))))
        except Exception:
            pass

        return -1

    def _get_target_edit_text(self, chat_activity=None, target_view=None):
        if target_view is not None:
            try:
                if (
                    hasattr(target_view, "getOffsetForPosition")
                    and hasattr(target_view, "getText")
                    and hasattr(target_view, "setSelection")
                ):
                    return target_view
            except Exception:
                pass

        target_ca = chat_activity or get_active_chat_activity(self.plugin, target_view)
        if target_ca is not None:
            et = get_message_edit_text(target_ca)
            if et is not None:
                try:
                    if hasattr(et, "isAttachedToWindow"):
                        if et.isAttachedToWindow():
                            return et
                    else:
                        return et
                except Exception:
                    return et

        if self.cached_drag_et is not None:
            try:
                if hasattr(self.cached_drag_et, "isAttachedToWindow"):
                    if self.cached_drag_et.isAttachedToWindow():
                        return self.cached_drag_et
                else:
                    return self.cached_drag_et
            except Exception:
                pass

        return None

    def _update_edit_text_cursor_from_drag(self, target_view, event):
        try:
            et = self._get_target_edit_text(target_view=target_view)
            if et is None:
                return
            self.cached_drag_et = et

            offset = self._compute_edit_text_offset(et, target_view, event)
            if offset >= 0:
                if not et.hasFocus():
                    et.requestFocus()
                safe_offset = max(0, min(offset, int(et.length())))
                self.last_hover_offset = safe_offset
                if int(et.getSelectionStart()) != safe_offset or int(et.getSelectionEnd()) != safe_offset:
                    et.setSelection(safe_offset)
        except Exception:
            pass

    def _insert_or_move_text_at_drop_point(self, chat_activity, target_view, event, text_to_insert):
        try:
            et = self._get_target_edit_text(chat_activity=chat_activity, target_view=target_view)
            if et is None:
                self.plugin.log("[DirectDrop] Target EditText not found for drop")
                return
            self.cached_drag_et = et

            offset = self._compute_edit_text_offset(et, target_view, event)
            if offset < 0 and self.last_hover_offset >= 0:
                offset = self.last_hover_offset
            self.last_hover_offset = -1

            editable = et.getText()
            if editable is None:
                et.setText(text_to_insert)
                et.requestFocus()
                return

            et_hash = int(System.identityHashCode(et))
            cut_info = self.active_et_cut_info
            self.active_et_cut_info = None

            if cut_info is None and not self.plugin._is_internal_chat_text_drag:
                saved = self.plugin._last_et_touch_sel
                if (
                    saved is not None
                    and saved["et_hash"] == et_hash
                    and saved["text"] == text_to_insert
                    and (time.time() - saved["time"]) < 12.0
                ):
                    cut_info = saved

            self.plugin._last_et_touch_sel = None

            if cut_info is not None and cut_info["et_hash"] == et_hash and cut_info["text"] == text_to_insert:
                s, e = int(cut_info["start"]), int(cut_info["end"])
                cur_str = str(editable)

                if not (0 <= s < e <= len(cur_str) and cur_str[s:e] == text_to_insert):
                    found_idx = cur_str.find(text_to_insert)
                    s, e = (found_idx, found_idx + len(text_to_insert)) if found_idx >= 0 else (-1, -1)

                if 0 <= s < e <= editable.length():
                    target_pos = max(0, min(offset if offset >= 0 else int(et.getSelectionStart()), editable.length()))
                    if s <= target_pos <= e:
                        et.requestFocus()
                        et.setSelection(target_pos)
                        return

                    editable.delete(s, e)
                    if target_pos > e:
                        target_pos -= (e - s)

                    target_pos = max(0, min(target_pos, editable.length()))
                    editable.insert(target_pos, text_to_insert)
                    et.requestFocus()
                    et.setSelection(min(target_pos + len(text_to_insert), editable.length()))
                    return

            if offset >= 0:
                insert_pos = max(0, min(offset, editable.length()))
                editable.insert(insert_pos, text_to_insert)
                et.requestFocus()
                et.setSelection(min(insert_pos + len(text_to_insert), editable.length()))
            else:
                s = min(int(et.getSelectionStart()), int(et.getSelectionEnd()))
                e = max(int(et.getSelectionStart()), int(et.getSelectionEnd()))
                if et.hasFocus() and s >= 0 and e >= s:
                    editable.replace(s, e, text_to_insert)
                    et.requestFocus()
                    et.setSelection(min(s + len(text_to_insert), editable.length()))
                else:
                    cur_len = editable.length()
                    if cur_len > 0 and not str(editable).endswith(" ") and not text_to_insert.startswith(" ") and not text_to_insert.startswith("\n"):
                        editable.append(" ")
                    editable.append(text_to_insert)
                    et.requestFocus()
                    et.setSelection(editable.length())

            enter_view = get_java_field(chat_activity, "chatActivityEnterView")
            if enter_view is not None and hasattr(enter_view, "openKeyboard"):
                try:
                    enter_view.openKeyboard()
                except Exception:
                    pass
        except Exception as e:
            self.plugin.log(f"[DirectDrop] Insert/Move text error: {e}")

    def _get_reply_context(self, chat_activity):
        reply_msg = None
        top_msg = None
        reply_quote = None

        try:
            reply_msg = get_java_field(chat_activity, "replyingMessageObject")
            if reply_msg is None and hasattr(chat_activity, "getReplyingMessageObject"):
                reply_msg = chat_activity.getReplyingMessageObject()

            if reply_msg is None:
                enter_view = get_java_field(chat_activity, "chatActivityEnterView")
                if enter_view is not None:
                    reply_msg = get_java_field(enter_view, "replyingMessageObject")
                    if reply_msg is None and hasattr(enter_view, "getReplyingMessageObject"):
                        reply_msg = enter_view.getReplyingMessageObject()

            reply_quote = get_java_field(chat_activity, "replyQuote")
            if reply_quote is not None and reply_msg is None:
                reply_msg = get_java_field(reply_quote, "message")

            top_msg = get_java_field(chat_activity, "threadMessageObject")
            if reply_msg is None and top_msg is not None:
                reply_msg = top_msg
        except Exception:
            pass

        return (reply_msg, top_msg, reply_quote)

    def _resolve_uri_meta_and_path(self, resolver, uri, mime, desc_label, index):
        """
        За один запрос возвращает (display_name, direct_local_path).
        Если файл уже лежит локально (из Telegram или из Галереи/Проводника), возвращает его прямой путь.
        """
        uri_str = str(uri)
        known_path = self.plugin._dragged_uri_paths.get(uri_str)
        known_name = self.plugin._dragged_uri_names.get(uri_str)
        if known_name and known_path and os.path.isfile(known_path):
            return known_name, known_path

        name = known_name
        direct_path = known_path if (known_path and os.path.isfile(known_path)) else None

        try:
            scheme = str(uri.getScheme() or "").lower()
            if scheme == "file":
                p = uri.getPath()
                if p and os.path.isfile(str(p)) and os.access(str(p), os.R_OK):
                    direct_path = str(p)
                    if not name:
                        name = os.path.basename(direct_path)
        except Exception:
            pass

        if not name or direct_path is None:
            cursor = None
            try:
                cursor = resolver.query(uri, jarray(String)(["_display_name", "_data"]), None, None, None)
                if cursor is not None and cursor.moveToFirst():
                    if not name:
                        col_name = cursor.getColumnIndex("_display_name")
                        if col_name >= 0:
                            name = cursor.getString(col_name)
                    if direct_path is None:
                        col_data = cursor.getColumnIndex("_data")
                        if col_data >= 0:
                            cand_p = cursor.getString(col_data)
                            if cand_p and os.path.isfile(str(cand_p)) and os.access(str(cand_p), os.R_OK):
                                direct_path = str(cand_p)
            except Exception:
                pass
            finally:
                if cursor is not None:
                    try:
                        cursor.close()
                    except Exception:
                        pass

        if not name:
            try:
                q_name = uri.getQueryParameter("displayName")
                if q_name:
                    name = str(q_name)
            except Exception:
                pass

        if not name:
            last_seg = uri.getLastPathSegment()
            if last_seg:
                name = os.path.basename(str(last_seg))

        if (not name or INTERNAL_CACHE_NAME_RE.match(str(name))) and desc_label:
            if "." in desc_label and not INTERNAL_CACHE_NAME_RE.match(desc_label):
                name = desc_label

        if not name:
            name = f"dropped_{int(time.time() * 1000)}_{index}"

        name = "".join(c for c in str(name) if c not in '/\\:*?"<>|')

        if "." not in name and mime:
            try:
                ext = MimeTypeMap.getSingleton().getExtensionFromMimeType(mime)
                if ext:
                    name = f"{name}.{ext}"
            except Exception:
                pass

        return name, direct_path

    def _queue_reply_context(self, chat_activity, peer_id, reply_ctx):
        reply_msg, top_msg, reply_quote = reply_ctx
        if reply_msg is not None or top_msg is not None or reply_quote is not None:
            self.plugin._pending_replies.append({
                "peer_id": peer_id,
                "reply_msg": reply_msg,
                "top_msg": top_msg,
                "reply_quote": reply_quote,
                "chat_activity": chat_activity,
                "time": time.time(),
            })

    def _is_media_preview_item(self, file_path, mime):
        mime_str = (str(mime) if mime else "").lower()
        ext = os.path.splitext(file_path)[1].lower()
        if (
            (mime_str.startswith("image/") and "gif" not in mime_str and "svg" not in mime_str)
            or ext in (".jpg", ".jpeg", ".png", ".webp", ".heic", ".heif")
        ):
            return True, False
        if mime_str.startswith("video/") or ext in (".mp4", ".mov", ".mkv", ".webm"):
            return True, True
        return False, False

    def _build_photo_entry_fast(self, file_path, is_video, entry_id, file_size):
        global _PHOTO_ENTRY_MODE
        CachedClasses.init()
        pe_cls = CachedClasses.photo_entry
        if pe_cls is None:
            return None

        now_sec = int(time.time())
        width, height = 0, 0
        if not is_video:
            try:
                opts = BitmapFactory.Options()
                opts.inJustDecodeBounds = True
                BitmapFactory.decodeFile(file_path, opts)
                width, height = int(opts.outWidth), int(opts.outHeight)
            except Exception:
                pass

        arg_variants = (
            (0, entry_id, jlong(now_sec), file_path, 0, 0, bool(is_video), width, height, jlong(file_size)),
            (0, entry_id, jlong(now_sec), file_path, 0, bool(is_video), width, height, jlong(file_size)),
            (0, entry_id, jlong(now_sec), file_path, 0, 0, bool(is_video), width, height),
            (0, entry_id, jlong(now_sec), file_path, 0, bool(is_video), width, height),
            (0, entry_id, jlong(now_sec), file_path, 0, bool(is_video), width),
            (0, entry_id, jlong(now_sec), file_path, 0, bool(is_video)),
        )

        entry = None
        if _PHOTO_ENTRY_MODE is not None:
            try:
                entry = pe_cls(*arg_variants[_PHOTO_ENTRY_MODE])
            except Exception:
                entry = None

        if entry is None:
            for idx, args in enumerate(arg_variants):
                try:
                    entry = pe_cls(*args)
                    _PHOTO_ENTRY_MODE = idx
                    break
                except Exception:
                    continue

        if entry is not None:
            set_java_field(entry, "isVideo", bool(is_video))
            if width > 0 and height > 0:
                set_java_field(entry, "width", width)
                set_java_field(entry, "height", height)

        return entry

    def _process_and_present(self, chat_activity, peer_id, reply_ctx, resolver, desc_label, raw_uris):
        try:
            base_drop_dir = os.path.join(get_cache_dir(), "direct_drop")
            drop_dir = None
            buf = self._copy_buf
            saved_files = []

            for idx, (uri, orig_i) in enumerate(raw_uris):
                uri_str = str(uri)
                mime = self.plugin._dragged_uri_mimes.get(uri_str) or resolver.getType(uri)
                name, direct_path = self._resolve_uri_meta_and_path(resolver, uri, mime, desc_label, orig_i)
                is_media, _ = self._is_media_preview_item(name, mime)

                final_path = None

                # 1. Мгновенный путь (0 мс): если файл уже есть на диске, для медиа или при совпадении имени вообще не копируем его!
                if direct_path and os.path.isfile(direct_path):
                    if is_media or os.path.basename(direct_path) == name:
                        final_path = direct_path
                    else:
                        # Для документа с системным кэш-именем (например 4_12345.plugin) пробуем жесткую ссылку в той же папке
                        same_dir_named = os.path.join(os.path.dirname(direct_path), name)
                        try:
                            src_sz = os.path.getsize(direct_path)
                            if os.path.isfile(same_dir_named) and os.path.getsize(same_dir_named) == src_sz:
                                final_path = same_dir_named
                            else:
                                os.link(direct_path, same_dir_named)
                                final_path = same_dir_named
                        except Exception:
                            if drop_dir is None:
                                drop_dir = os.path.join(base_drop_dir, str(int(time.time() * 1000)))
                                ensure_dir_exists(drop_dir)
                            dest_path = os.path.join(drop_dir, name)
                            if os.path.exists(dest_path):
                                base_n, ext_n = os.path.splitext(name)
                                dest_path = os.path.join(drop_dir, f"{base_n}_{idx}{ext_n}")
                            if fast_copy_file(direct_path, dest_path):
                                final_path = dest_path
                            else:
                                final_path = direct_path

                # 2. Если прямого пути нет (внешний ContentProvider), копируем через нативный FileUtils.copy
                if final_path is None:
                    if drop_dir is None:
                        drop_dir = os.path.join(base_drop_dir, str(int(time.time() * 1000)))
                        ensure_dir_exists(drop_dir)
                    dest_path = os.path.join(drop_dir, name)
                    if os.path.exists(dest_path):
                        base_n, ext_n = os.path.splitext(name)
                        dest_path = os.path.join(drop_dir, f"{base_n}_{idx}{ext_n}")

                    stream = None
                    out_stream = None
                    try:
                        stream = resolver.openInputStream(uri)
                        if stream is None:
                            continue
                        out_stream = FileOutputStream(dest_path)
                        try:
                            FileUtils.copy(stream, out_stream)
                        except Exception:
                            while True:
                                read_len = stream.read(buf)
                                if read_len <= 0:
                                    break
                                out_stream.write(buf, 0, read_len)
                        out_stream.flush()
                        final_path = dest_path
                    except Exception as e:
                        self.plugin.log(f"[DirectDrop] Copy stream error: {e}")
                        continue
                    finally:
                        if out_stream is not None:
                            try:
                                out_stream.close()
                            except Exception:
                                pass
                        if stream is not None:
                            try:
                                stream.close()
                            except Exception:
                                pass

                try:
                    sz_bytes = os.path.getsize(final_path)
                except Exception:
                    sz_bytes = 0
                sz_str = format_file_size_fast(sz_bytes)
                ext_part = os.path.splitext(name)[1].lstrip(".").lower()
                ext_str = ext_part if ext_part else "?"
                jfile = File(final_path)
                key_str = String(str(jfile.toString()))

                saved_files.append((final_path, name, mime, sz_str, ext_str, sz_bytes, jfile, key_str))

            if not saved_files:
                return

            all_are_pure_media = all(
                self._is_media_preview_item(item[0], item[2])[0] for item in saved_files
            )

            media_items = []
            doc_items = []
            entries_list = None
            selected_map = None
            selected_order = None

            if all_are_pure_media:
                entries_list = ArrayList()
                selected_map = HashMap()
                selected_order = ArrayList()
                for idx, item in enumerate(saved_files):
                    dest_path, name, mime, _, _, sz_bytes, _, _ = item
                    _, is_video = self._is_media_preview_item(dest_path, mime)
                    entry = self._build_photo_entry_fast(dest_path, is_video, idx + 1, sz_bytes)
                    if entry is not None:
                        media_items.append((entry, dest_path, name, mime))
                        key_id = Integer(idx + 1)
                        entries_list.add(entry)
                        selected_map.put(key_id, entry)
                        selected_order.add(key_id)
                    else:
                        all_are_pure_media = False
                        break

            if not all_are_pure_media:
                media_items.clear()
                doc_items = saved_files

            if not self.plugin.get_setting("open_preview_before_send", True):
                if media_items:
                    prep = [
                        (entry, p, m, None, False, to_py_bool(getattr(entry, "isVideo", False), False))
                        for entry, p, _, m in media_items
                    ]
                    run_on_ui_thread(
                        lambda: self._send_media_group_or_fallback(
                            chat_activity, peer_id, reply_ctx, prep, True, 0, False
                        )
                    )
                elif doc_items:
                    run_on_ui_thread(
                        lambda: self._send_documents_group_or_fallback(
                            chat_activity, peer_id, reply_ctx, doc_items, None
                        )
                    )
                return

            def _show_ui():
                if media_items:
                    self._open_media_editor_preview(
                        chat_activity, peer_id, reply_ctx, media_items, entries_list, selected_map, selected_order
                    )
                elif doc_items:
                    self._open_files_send_preview(chat_activity, peer_id, reply_ctx, doc_items)

            run_on_ui_thread(_show_ui)

            now_t = time.time()
            if now_t - self.last_cache_cleanup_time > 180.0:
                self.last_cache_cleanup_time = now_t
                self._cleanup_old_cache(base_drop_dir)

        except Exception as e:
            self.plugin.log(f"[DirectDrop] Process error: {e}\n{traceback.format_exc()}")
            BulletinHelper.show_error(f"Ошибка обработки файла: {e}", chat_activity)

    def _open_media_editor_preview(
        self, chat_activity, peer_id, reply_ctx, media_items, entries_list, selected_map, selected_order
    ):
        try:
            CachedClasses.init()
            parent_activity = chat_activity.getParentActivity()
            if parent_activity is None or CachedClasses.photo_viewer is None or CachedClasses.empty_pv_provider is None:
                self._open_files_send_preview(
                    chat_activity,
                    peer_id,
                    reply_ctx,
                    [(p, n, m, "", "", 0, File(p), String(str(File(p).toString()))) for _, p, n, m in media_items],
                )
                return

            pv = CachedClasses.photo_viewer.getInstance()
            pv_java_cls = pv.getClass()

            if get_java_field(pv, "parentActivity") is None or get_java_field(pv, "containerView") is None:
                try:
                    pv.setParentActivity(chat_activity)
                except Exception:
                    try:
                        pv.setParentActivity(parent_activity)
                    except Exception:
                        m_spa = get_java_method(pv, "setParentActivity", 2)
                        if m_spa is not None:
                            m_spa.invoke(pv, jarray(Object)([parent_activity, None]))

            if bool(get_java_field(pv, "isVisible")):
                try:
                    pv.closePhoto(False, False)
                except Exception:
                    set_java_field(pv, "isVisible", False)
            set_java_field(pv, "animationInProgress", 0)

            try:
                pv.setMaxSelectedPhotos(-1, True)
            except Exception:
                pass

            et = get_message_edit_text(chat_activity)
            draft_caption = str(et.getText()) if (et is not None and et.length() > 0) else None
            if draft_caption and media_items:
                set_java_field(media_items[0][0], "caption", draft_caption)

            provider = CachedClasses.empty_pv_provider()
            self.plugin._pv_session = {
                "provider": provider,
                "provider_hash": int(System.identityHashCode(provider)),
                "chat_activity": chat_activity,
                "peer_id": peer_id,
                "reply_ctx": reply_ctx,
                "media_items": media_items,
                "entries_list": entries_list,
                "selected_map": selected_map,
                "selected_order": selected_order,
                "draft_caption": draft_caption,
                "sent": False,
            }

            opened = False
            methods = [m for m in pv_java_cls.getDeclaredMethods() if m.getName() == "openPhotoForSelect"]
            methods.sort(key=lambda m: len(m.getParameterTypes()), reverse=True)

            for m in methods:
                m.setAccessible(True)
                call_args = []
                for pt in m.getParameterTypes():
                    pt_name = pt.getName()
                    if "ArrayList" in pt_name or "List" in pt_name:
                        call_args.append(entries_list)
                    elif "PhotoViewerProvider" in pt_name:
                        call_args.append(provider)
                    elif "ChatActivity" in pt_name or "BaseFragment" in pt_name:
                        call_args.append(chat_activity)
                    elif pt_name == "int":
                        call_args.append(Integer(0))
                    elif pt_name == "boolean":
                        call_args.append(Boolean(False))
                    else:
                        call_args.append(None)
                try:
                    res = m.invoke(pv, jarray(Object)(call_args))
                    if res is None or bool(res) is True:
                        opened = True
                        break
                except Exception:
                    continue

            if opened:
                if draft_caption and et is not None:
                    try:
                        if hasattr(pv, "setCaption"):
                            pv.setCaption(draft_caption)
                        et.setText("")
                    except Exception:
                        pass
                return
            self.plugin._pv_session = None
        except Exception as e:
            self.plugin._pv_session = None
            self.plugin.log(f"[DirectDrop] PhotoViewer open error: {e}")

        self._open_files_send_preview(
            chat_activity,
            peer_id,
            reply_ctx,
            [(p, n, m, "", "", 0, File(p), String(str(File(p).toString()))) for _, p, n, m in media_items],
        )

    def _extract_caption_from_photo_viewer(self, pv, entry):
        for src in (
            getattr(entry, "caption", None),
            get_java_field(entry, "caption"),
            get_java_field(pv, "currentCaption") if pv is not None else None,
        ):
            if src is not None and len(str(src).strip()) > 0:
                return str(src).strip()

        if pv is not None:
            for field_name in ("captionEditText", "captionEditTextTop"):
                try:
                    cap_et = get_java_field(pv, field_name)
                    if cap_et is not None:
                        if hasattr(cap_et, "getFieldCharSequence"):
                            cs = cap_et.getFieldCharSequence()
                            if cs is not None and len(str(cs).strip()) > 0:
                                return str(cs).strip()
                        inner_et = get_java_field(cap_et, "editText")
                        if inner_et is not None and hasattr(inner_et, "getText"):
                            t = inner_et.getText()
                            if t is not None and len(str(t).strip()) > 0:
                                return str(t).strip()
                except Exception:
                    pass

        return None

    def _send_from_photo_viewer_session(self, session, current_idx, video_edited_info, notify, schedule_date, force_doc):
        chat_activity = session["chat_activity"]
        peer_id = session["peer_id"]
        reply_ctx = session["reply_ctx"]
        media_items = session["media_items"]
        selected_order = session["selected_order"]

        try:
            CachedClasses.init()
            pv = CachedClasses.photo_viewer.getInstance()

            if 0 <= current_idx < len(media_items) and video_edited_info is not None:
                set_java_field(media_items[current_idx][0], "editedInfo", video_edited_info)

            items_to_send = []
            if selected_order is not None and selected_order.size() > 0:
                id_map = {to_py_int(item[0].imageId): item for item in media_items}
                for i in range(selected_order.size()):
                    img_id = to_py_int(selected_order.get(i))
                    if img_id in id_map:
                        items_to_send.append(id_map[img_id])

            if not items_to_send:
                items_to_send.append(
                    media_items[current_idx] if 0 <= current_idx < len(media_items) else media_items[0]
                )

            active_pv_caption = self._extract_caption_from_photo_viewer(pv, items_to_send[0][0]) or session.get(
                "draft_caption"
            )

            prepared_send_list = []
            caption_assigned = False

            for entry, orig_path, _, mime in items_to_send:
                edited_p = getattr(entry, "imagePath", None) or get_java_field(entry, "imagePath")
                final_p = str(edited_p) if (edited_p and os.path.isfile(str(edited_p))) else orig_path

                entry_cap = getattr(entry, "caption", None) or get_java_field(entry, "caption")
                cap_str = str(entry_cap).strip() if (entry_cap is not None and len(str(entry_cap).strip()) > 0) else None
                if not cap_str and not caption_assigned and active_pv_caption:
                    cap_str = active_pv_caption
                if cap_str:
                    caption_assigned = True

                has_spoiler = to_py_bool(
                    getattr(entry, "hasSpoiler", None) or get_java_field(entry, "hasSpoiler"), False
                )
                is_video = to_py_bool(
                    getattr(entry, "isVideo", None) or get_java_field(entry, "isVideo"), False
                )
                eff_mime = "application/octet-stream" if force_doc else mime
                prepared_send_list.append((entry, final_p, eff_mime, cap_str, has_spoiler, is_video))

            def _close_and_send():
                try:
                    if pv is not None and to_py_bool(get_java_field(pv, "isVisible"), False):
                        pv.closePhoto(True, False)
                except Exception:
                    pass
                self._send_media_group_or_fallback(
                    chat_activity, peer_id, reply_ctx, prepared_send_list, notify, schedule_date, force_doc
                )

            run_on_ui_thread(_close_and_send)
        except Exception as e:
            self.plugin.log(f"[DirectDrop] Send from PV error: {e}")

    def _is_webp_sticker_item(self, file_path, mime):
        ext = os.path.splitext(str(file_path))[1].lower()
        mime_s = (str(mime) if mime else "").lower()
        return ext == ".webp" or "webp" in mime_s

    def _send_media_group_or_fallback(
        self, chat_activity, peer_id, reply_ctx, prepared_send_list, notify, schedule_date, force_doc
    ):
        webp_items = [it for it in prepared_send_list if self._is_webp_sticker_item(it[1], it[2])]
        regular_media = [it for it in prepared_send_list if not self._is_webp_sticker_item(it[1], it[2])]

        if webp_items:
            def _send_webp():
                for _, final_p, eff_mime, cap_str, has_spoiler, _ in webp_items:
                    self._queue_reply_context(chat_activity, peer_id, reply_ctx)
                    self._dispatch_file(peer_id, final_p, eff_mime, cap_str, has_spoiler, notify, schedule_date)

            run_on_queue(_send_webp)

        if not regular_media:
            return

        if len(regular_media) > 1 or any(
            (getattr(it[0], "editedInfo", None) or get_java_field(it[0], "editedInfo")) is not None
            for it in regular_media
            if it[0] is not None
        ):
            if self._invoke_prepare_sending_media_album(
                chat_activity, peer_id, reply_ctx, regular_media, notify, schedule_date, force_doc
            ):
                return

        def _single_task():
            for _, final_p, eff_mime, cap_str, has_spoiler, _ in regular_media:
                self._queue_reply_context(chat_activity, peer_id, reply_ctx)
                self._dispatch_file(peer_id, final_p, eff_mime, cap_str, has_spoiler, notify, schedule_date)

        run_on_queue(_single_task)

    def _invoke_prepare_sending_media_album(
        self, chat_activity, peer_id, reply_ctx, prepared_send_list, notify, schedule_date, force_doc
    ):
        global _PREPARE_MEDIA_METHOD
        try:
            CachedClasses.init()
            smi_cls = CachedClasses.sending_media_info
            acc_cls = CachedClasses.account_instance
            if smi_cls is None or acc_cls is None:
                return False

            info_list = ArrayList()
            any_spoiler = False

            for entry, final_p, _, cap_str, has_spoiler, is_video in prepared_send_list:
                info = smi_cls()
                info.path = final_p
                try:
                    info.uri = Uri.fromFile(File(final_p))
                except Exception:
                    pass
                info.isVideo = bool(is_video)
                if force_doc:
                    set_java_field(info, "forceImage", False)
                if cap_str:
                    info.caption = cap_str
                if has_spoiler:
                    any_spoiler = True
                    set_java_field(info, "hasSpoiler", True)

                if entry is not None:
                    vei = getattr(entry, "editedInfo", None) or get_java_field(entry, "editedInfo")
                    if vei is not None:
                        info.videoEditedInfo = vei
                    for f_name in ("entities", "masks", "ttl", "thumbPath", "isHighQuality"):
                        val = getattr(entry, f_name, None) or get_java_field(entry, f_name)
                        if val is not None:
                            set_java_field(info, f_name, val)
                    set_java_field(info, "photoEntry", entry)

                info_list.add(info)

            account_instance = acc_cls.getInstance(to_py_int(chat_activity.getCurrentAccount(), 0))
            reply_msg, top_msg, reply_quote = reply_ctx
            group_photos = len(prepared_send_list) > 1

            if _PREPARE_MEDIA_METHOD is None:
                sm_raw_cls = chat_activity.getClass().getClassLoader().loadClass(CLS_SEND_MESSAGES_HELPER)
                for m in sm_raw_cls.getDeclaredMethods():
                    if m.getName() == "prepareSendingMedia":
                        p_types = m.getParameterTypes()
                        if (
                            len(p_types) >= 9
                            and "AccountInstance" in p_types[0].getName()
                            and "ArrayList" in p_types[1].getName()
                        ):
                            m.setAccessible(True)
                            _PREPARE_MEDIA_METHOD = (m, p_types)
                            break

            if _PREPARE_MEDIA_METHOD is None:
                return False

            m, p_types = _PREPARE_MEDIA_METHOD
            msg_obj_positions = [
                i for i, pt in enumerate(p_types) if "MessageObject" in pt.getName() and "ReplyQuote" not in pt.getName()
            ]
            editing_msg_pos = msg_obj_positions[2] if len(msg_obj_positions) >= 3 else 8
            bool_before_edit = [i for i in range(editing_msg_pos) if p_types[i].getName() == "boolean"]
            bool_after_edit = [i for i in range(editing_msg_pos + 1, len(p_types)) if p_types[i].getName() == "boolean"]

            args = []
            msg_obj_idx = 0
            int_idx = 0

            for idx, pt in enumerate(p_types):
                p_name = pt.getName()
                if idx == 0:
                    args.append(account_instance)
                elif idx == 1:
                    args.append(info_list)
                elif idx == 2:
                    args.append(Long(peer_id))
                elif "MessageObject" in p_name and "ReplyQuote" not in p_name:
                    args.append(reply_msg if msg_obj_idx == 0 else (top_msg if msg_obj_idx == 1 else None))
                    msg_obj_idx += 1
                elif "ReplyQuote" in p_name:
                    args.append(reply_quote)
                elif p_name == "boolean":
                    if idx in bool_before_edit:
                        args.append(Boolean(bool(group_photos if idx == bool_before_edit[-1] else force_doc)))
                    elif idx in bool_after_edit:
                        if idx == bool_after_edit[0]:
                            args.append(Boolean(bool(notify)))
                        elif len(bool_after_edit) > 1 and idx == bool_after_edit[1]:
                            args.append(Boolean(bool(any_spoiler)))
                        else:
                            args.append(Boolean(False))
                    else:
                        args.append(Boolean(False))
                elif p_name == "int":
                    args.append(Integer(int(schedule_date) if (int_idx == 0 and schedule_date > 0) else 0))
                    int_idx += 1
                elif p_name == "long":
                    args.append(Long(0))
                else:
                    args.append(None)

            m.invoke(None, jarray(Object)(args))

            if reply_msg is not None and reply_msg != top_msg and hasattr(chat_activity, "hideFieldPanel"):
                try:
                    chat_activity.hideFieldPanel(True)
                except Exception:
                    pass
            return True
        except Exception as e:
            self.plugin.log(f"[DirectDrop] prepareSendingMedia album error: {e}")
            return False

    def _send_documents_group_or_fallback(self, chat_activity, peer_id, reply_ctx, doc_items, caption_val):
        if len(doc_items) > 1:
            if self._invoke_prepare_sending_documents_group(
                chat_activity, peer_id, reply_ctx, doc_items, caption_val
            ):
                return

        def _fallback_doc_task():
            for idx, item in enumerate(doc_items):
                self._queue_reply_context(chat_activity, peer_id, reply_ctx)
                self._dispatch_file(
                    peer_id,
                    item[0],
                    item[2],
                    caption=caption_val if idx == len(doc_items) - 1 and caption_val else None,
                )

        run_on_queue(_fallback_doc_task)

    def _invoke_prepare_sending_documents_group(self, chat_activity, peer_id, reply_ctx, doc_items, caption_val):
        global _PREPARE_DOCS_METHOD
        try:
            CachedClasses.init()
            acc_cls = CachedClasses.account_instance
            if acc_cls is None:
                return False

            paths_list = ArrayList()
            orig_paths_list = ArrayList()
            first_mime = None

            for item in doc_items:
                p, mime = item[0], item[2]
                paths_list.add(String(p))
                orig_paths_list.add(String(p))
                if not first_mime and mime:
                    first_mime = str(mime)

            account_instance = acc_cls.getInstance(to_py_int(chat_activity.getCurrentAccount(), 0))
            reply_msg, top_msg, reply_quote = reply_ctx

            if _PREPARE_DOCS_METHOD is None:
                sm_raw_cls = chat_activity.getClass().getClassLoader().loadClass(CLS_SEND_MESSAGES_HELPER)
                for m in sm_raw_cls.getDeclaredMethods():
                    if m.getName() == "prepareSendingDocuments":
                        p_types = m.getParameterTypes()
                        if (
                            len(p_types) >= 8
                            and "AccountInstance" in p_types[0].getName()
                            and "ArrayList" in p_types[1].getName()
                        ):
                            m.setAccessible(True)
                            _PREPARE_DOCS_METHOD = (m, p_types)
                            break

            if _PREPARE_DOCS_METHOD is None:
                return False

            m, p_types = _PREPARE_DOCS_METHOD
            args = []
            list_idx = 0
            str_idx = 0
            long_idx = 0
            msg_obj_idx = 0
            bool_idx = 0

            for idx, pt in enumerate(p_types):
                p_name = pt.getName()
                if idx == 0:
                    args.append(account_instance)
                elif "ArrayList" in p_name or "List" in p_name:
                    args.append(paths_list if list_idx == 0 else (orig_paths_list if list_idx == 1 else None))
                    list_idx += 1
                elif "String" in p_name or "CharSequence" in p_name:
                    if str_idx == 0:
                        args.append(String(caption_val) if caption_val else None)
                    elif str_idx == 1:
                        args.append(String(first_mime or "*/*"))
                    else:
                        args.append(None)
                    str_idx += 1
                elif p_name == "long":
                    args.append(Long(peer_id if long_idx == 0 else 0))
                    long_idx += 1
                elif "MessageObject" in p_name and "ReplyQuote" not in p_name:
                    args.append(reply_msg if msg_obj_idx == 0 else (top_msg if msg_obj_idx == 1 else None))
                    msg_obj_idx += 1
                elif "ReplyQuote" in p_name:
                    args.append(reply_quote)
                elif p_name == "boolean":
                    args.append(Boolean(bool_idx in (0, 1)))
                    bool_idx += 1
                elif p_name == "int":
                    args.append(Integer(0))
                else:
                    args.append(None)

            m.invoke(None, jarray(Object)(args))

            if reply_msg is not None and reply_msg != top_msg and hasattr(chat_activity, "hideFieldPanel"):
                try:
                    chat_activity.hideFieldPanel(True)
                except Exception:
                    pass
            return True
        except Exception as e:
            self.plugin.log(f"[DirectDrop] prepareSendingDocuments group error: {e}")
            return False

    def _create_document_list_item(
        self, chat_activity, doc_layout, list_adapter, file_path, display_name, size_str, ext_str, jfile
    ):
        global _DOC_ITEM_CTOR
        li_inst = None

        if _DOC_ITEM_CTOR is not None:
            try:
                ctor, p_types = _DOC_ITEM_CTOR
                c_args = [doc_layout if "ChatAttachAlertDocumentLayout" in pt.getName() else None for pt in p_types]
                li_inst = ctor.newInstance(jarray(Object)(c_args))
            except Exception:
                li_inst = None

        if li_inst is None:
            raw_li_cls = None
            try:
                for src in (list_adapter, doc_layout):
                    if src is None:
                        continue
                    for list_name in ("items", "recentItems"):
                        arr = get_java_field(src, list_name)
                        if arr is not None and int(arr.size()) > 0:
                            cand = arr.get(0)
                            if cand is not None:
                                raw_li_cls = cand.getClass()
                                break
                    if raw_li_cls is not None:
                        break
            except Exception:
                pass

            if raw_li_cls is None and chat_activity is not None:
                try:
                    raw_li_cls = chat_activity.getClass().getClassLoader().loadClass(CLS_DOC_LIST_ITEM)
                except Exception:
                    pass

            if raw_li_cls is not None:
                for ctor in raw_li_cls.getDeclaredConstructors():
                    ctor.setAccessible(True)
                    p_types = ctor.getParameterTypes()
                    c_args = [doc_layout if "ChatAttachAlertDocumentLayout" in pt.getName() else None for pt in p_types]
                    try:
                        li_inst = ctor.newInstance(jarray(Object)(c_args))
                        if li_inst is not None:
                            _DOC_ITEM_CTOR = (ctor, p_types)
                            break
                    except Exception:
                        continue

        if li_inst is None:
            return None

        thumb_str = String(file_path) if ext_str in ("jpg", "jpeg", "png", "webp", "gif") else None

        set_java_field(li_inst, "icon", Integer(0))
        set_java_field(li_inst, "title", String(str(display_name)))
        set_java_field(li_inst, "subtitle", String(size_str))
        set_java_field(li_inst, "ext", String(ext_str))
        set_java_field(li_inst, "thumb", thumb_str)
        set_java_field(li_inst, "file", jfile)

        return li_inst

    def _activate_caption_and_send_button(self, attach_alert, doc_layout, draft_caption=None):
        if attach_alert is None or doc_layout is None:
            return

        try:
            doc_layout.setVisibility(View.VISIBLE)
            doc_layout.setAlpha(1.0)
            doc_layout.setTranslationY(0.0)
        except Exception:
            pass

        try:
            if draft_caption:
                comment_tv = get_java_field(attach_alert, "commentTextView")
                if comment_tv is not None and hasattr(comment_tv, "setText"):
                    cur_comment = comment_tv.getText()
                    if cur_comment is None or len(str(cur_comment)) == 0:
                        comment_tv.setText(draft_caption)

            update_count_m = get_java_method(attach_alert, "updateCountButton", 1)
            prev_cur_lay = get_java_field(attach_alert, "currentAttachLayout")
            need_temp_swap = not same_java_obj(prev_cur_lay, doc_layout)
            if need_temp_swap:
                set_java_field(attach_alert, "currentAttachLayout", doc_layout)

            if update_count_m is not None:
                try:
                    update_count_m.invoke(attach_alert, jarray(Object)([Integer(1)]))
                except Exception:
                    pass

            cta = get_java_field(attach_alert, "commentTextAnimator")
            if cta is not None:
                try:
                    cta.end()
                except Exception:
                    pass

            if need_temp_swap and prev_cur_lay is not None:
                set_java_field(attach_alert, "currentAttachLayout", prev_cur_lay)
        except Exception as e:
            self.plugin.log(f"[DirectDrop] Activate caption/send bar error: {e}")

    def _inject_files_into_document_layout(
        self, chat_activity, attach_alert, doc_layout, doc_items, draft_caption
    ):
        try:
            list_adapter = get_java_field(doc_layout, "listAdapter")
            if list_adapter is None:
                return False

            selected_files = get_java_field(doc_layout, "selectedFiles")
            selected_order = get_java_field(doc_layout, "selectedFilesOrder")
            recent_items = get_java_field(list_adapter, "recentItems") or get_java_field(doc_layout, "recentItems")

            if recent_items is None or selected_files is None:
                return False

            check_limit = min(int(recent_items.size()), 10)

            for item in reversed(doc_items):
                file_path = item[0]
                display_name = item[1]
                size_str = item[3]
                ext_str = item[4]
                jfile = item[6] if len(item) > 6 and item[6] is not None else File(file_path)
                key_str = item[7] if len(item) > 7 and item[7] is not None else String(str(jfile.toString()))

                existing_item = None
                for i in range(check_limit):
                    cand = recent_items.get(i)
                    cand_file = get_java_field(cand, "file")
                    if cand_file is not None and str(cand_file.toString()) == str(jfile.toString()):
                        existing_item = cand
                        if i != 0:
                            recent_items.remove(i)
                            recent_items.add(0, existing_item)
                        break

                if existing_item is None:
                    existing_item = self._create_document_list_item(
                        chat_activity, doc_layout, list_adapter, file_path, display_name, size_str, ext_str, jfile
                    )
                    if existing_item is not None:
                        recent_items.add(0, existing_item)

                if existing_item is not None:
                    selected_files.put(key_str, existing_item)
                    if selected_order is not None and not bool(selected_order.contains(key_str)):
                        selected_order.add(key_str)

            set_java_field(doc_layout, "hasFiles", Boolean(True))

            try:
                list_adapter.notifyDataSetChanged()
            except Exception:
                pass

            self._activate_caption_and_send_button(attach_alert, doc_layout, draft_caption)
            return True
        except Exception as e:
            self.plugin.log(f"[DirectDrop] Inject into DocumentLayout error: {e}")
            return False

    def _ensure_chat_attach_alert(self, chat_activity):
        attach_alert = get_java_field(chat_activity, "chatAttachAlert")
        if attach_alert is not None:
            return attach_alert

        try:
            m_create = get_java_method(chat_activity, "createChatAttachView", 0)
            if m_create is not None:
                m_create.invoke(chat_activity, jarray(Object)([]))
        except Exception:
            pass

        return get_java_field(chat_activity, "chatAttachAlert")

    def _trigger_native_file_tab_switch(self, attach_alert):
        try:
            cur_lay = get_java_field(attach_alert, "currentAttachLayout")
            next_lay = get_java_field(attach_alert, "nextAttachLayout")
            doc_lay = get_java_field(attach_alert, "documentLayout")

            if doc_lay is not None and (same_java_obj(cur_lay, doc_lay) or same_java_obj(next_lay, doc_lay)):
                return doc_lay

            m_open_doc = get_java_method(attach_alert, "openDocumentsLayout", 1)
            if m_open_doc is not None:
                m_open_doc.invoke(attach_alert, jarray(Object)([Boolean(True)]))
            else:
                m_open_doc0 = get_java_method(attach_alert, "openDocumentsLayout", 0)
                if m_open_doc0 is not None:
                    m_open_doc0.invoke(attach_alert, jarray(Object)([]))

            doc_lay = get_java_field(attach_alert, "documentLayout")
            cur_lay = get_java_field(attach_alert, "currentAttachLayout")
            next_lay = get_java_field(attach_alert, "nextAttachLayout")
            if doc_lay is not None and (same_java_obj(cur_lay, doc_lay) or same_java_obj(next_lay, doc_lay)):
                return doc_lay

            buttons_rv = get_java_field(attach_alert, "buttonsRecyclerView")
            if buttons_rv is not None and int(buttons_rv.getChildCount()) > 0:
                file_btn = None
                btn_pos = 1
                for i in range(int(buttons_rv.getChildCount())):
                    ch = buttons_rv.getChildAt(i)
                    if ch is not None and "AttachButton" in ch.getClass().getName():
                        if to_py_int(ch.getTag(), -1) == 1:
                            file_btn = ch
                            try:
                                p = to_py_int(buttons_rv.getChildAdapterPosition(ch), i)
                                if p >= 0:
                                    btn_pos = p
                            except Exception:
                                btn_pos = i
                            break

                if file_btn is not None:
                    std_listener = get_java_field(buttons_rv, "onItemClickListener")
                    ext_listener = get_java_field(buttons_rv, "onItemClickListenerExtended")
                    if std_listener is not None:
                        m_click = get_java_method(std_listener, "onItemClick", 2)
                        if m_click is not None:
                            m_click.invoke(std_listener, jarray(Object)([file_btn, Integer(btn_pos)]))
                    elif ext_listener is not None:
                        m_click = get_java_method(ext_listener, "onItemClick", 4)
                        if m_click is not None:
                            m_click.invoke(
                                ext_listener,
                                jarray(Object)([file_btn, Integer(btn_pos), Float(0.0), Float(0.0)]),
                            )

            doc_lay = get_java_field(attach_alert, "documentLayout")
            cur_lay = get_java_field(attach_alert, "currentAttachLayout")
            next_lay = get_java_field(attach_alert, "nextAttachLayout")

            if doc_lay is not None and not same_java_obj(cur_lay, doc_lay) and not same_java_obj(next_lay, doc_lay):
                m_show = get_java_method(attach_alert, "showLayout", 1)
                if m_show is not None:
                    m_show.invoke(attach_alert, jarray(Object)([doc_lay]))

            return get_java_field(attach_alert, "documentLayout")
        except Exception:
            return get_java_field(attach_alert, "documentLayout")

    def _open_native_document_attach_sheet(self, chat_activity, peer_id, reply_ctx, doc_items):
        try:
            attach_alert = self._ensure_chat_attach_alert(chat_activity)
            if attach_alert is None:
                return False

            et_main = get_message_edit_text(chat_activity)
            draft_caption = str(et_main.getText()) if (et_main is not None and et_main.length() > 0) else None

            self.plugin._doc_sheet_session = {
                "chat_activity": chat_activity,
                "attach_alert": attach_alert,
                "peer_id": peer_id,
                "reply_ctx": reply_ctx,
                "doc_items": doc_items,
                "draft_caption": draft_caption,
                "injected": False,
                "time": time.time(),
            }

            try:
                if hasattr(attach_alert, "setEditingMessageObject"):
                    attach_alert.setEditingMessageObject(None)
            except Exception:
                pass

            existing_doc = get_java_field(attach_alert, "documentLayout")
            if (
                existing_doc is not None
                and existing_doc.getParent() is not None
                and get_java_field(existing_doc, "delegate") is not None
            ):
                sel_files = get_java_field(existing_doc, "selectedFiles")
                sel_order = get_java_field(existing_doc, "selectedFilesOrder")
                if sel_files is not None:
                    sel_files.clear()
                if sel_order is not None:
                    sel_order.clear()

                comment_tv = get_java_field(attach_alert, "commentTextView")
                if comment_tv is not None and hasattr(comment_tv, "setText"):
                    comment_tv.setText("")

                photo_lay = get_java_field(attach_alert, "photoLayout")
                if photo_lay is not None and not same_java_obj(photo_lay, existing_doc):
                    photo_lay.setVisibility(View.GONE)

                set_java_field(attach_alert, "currentAttachLayout", existing_doc)
                set_java_field(attach_alert, "nextAttachLayout", None)
                set_java_field(attach_alert, "selectedId", Integer(1))

                existing_doc.setVisibility(View.VISIBLE)
                existing_doc.setAlpha(1.0)
                existing_doc.setTranslationY(0.0)

                self.plugin._doc_sheet_session["injected"] = True
                self._inject_files_into_document_layout(
                    chat_activity, attach_alert, existing_doc, doc_items, draft_caption
                )

                chat_activity.showDialog(attach_alert)
                if et_main is not None and draft_caption:
                    et_main.setText("")
                return True

            try:
                if hasattr(attach_alert, "init"):
                    attach_alert.init()
            except Exception:
                pass

            chat_activity.showDialog(attach_alert)
            if et_main is not None and draft_caption:
                et_main.setText("")

            doc_lay_now = self._trigger_native_file_tab_switch(attach_alert)
            if doc_lay_now is not None:
                anim = get_java_field(attach_alert, "viewChangeAnimator")
                if anim is not None:
                    try:
                        anim.end()
                    except Exception:
                        pass
                if not self.plugin._doc_sheet_session.get("injected"):
                    self.plugin._doc_sheet_session["injected"] = True
                    self._inject_files_into_document_layout(
                        chat_activity, attach_alert, doc_lay_now, doc_items, draft_caption
                    )

            def _step_first_open():
                session = self.plugin._doc_sheet_session
                if session is None:
                    return
                dl = self._trigger_native_file_tab_switch(attach_alert)
                if dl is not None:
                    anim = get_java_field(attach_alert, "viewChangeAnimator")
                    if anim is not None:
                        try:
                            anim.end()
                        except Exception:
                            pass
                    if not session.get("injected"):
                        session["injected"] = True
                        self._inject_files_into_document_layout(
                            chat_activity, attach_alert, dl, doc_items, draft_caption
                        )
                    else:
                        self._activate_caption_and_send_button(attach_alert, dl, None)

            run_on_ui_thread(_step_first_open, 16)
            return True
        except Exception as e:
            self.plugin._doc_sheet_session = None
            self.plugin.log(f"[DirectDrop] Native DocumentAttachSheet error: {e}")
            return False

    def _open_files_send_preview(self, chat_activity, peer_id, reply_ctx, doc_items):
        if self._open_native_document_attach_sheet(chat_activity, peer_id, reply_ctx, doc_items):
            return
        self._send_documents_group_or_fallback(chat_activity, peer_id, reply_ctx, doc_items, None)

    def _cleanup_old_cache(self, base_drop_dir):
        try:
            if not os.path.isdir(base_drop_dir):
                return
            now = time.time()
            for entry in os.listdir(base_drop_dir):
                full_p = os.path.join(base_drop_dir, entry)
                try:
                    if now - os.path.getmtime(full_p) > 1200:
                        shutil.rmtree(full_p, ignore_errors=True)
                except Exception:
                    pass
        except Exception:
            pass

    def _dispatch_file(
        self, peer_id, file_path, mime, caption=None, has_spoiler=False, notify=True, schedule_date=0
    ):
        mime_str = (str(mime) if mime else "").lower()
        ext = os.path.splitext(file_path)[1].lower()
        is_webp = (ext == ".webp") or ("webp" in mime_str)

        if caption or has_spoiler or not notify or schedule_date > 0:
            self.plugin._pending_captions.append({
                "peer_id": peer_id,
                "caption": caption,
                "has_spoiler": bool(has_spoiler),
                "notify": bool(notify),
                "schedule_date": int(schedule_date),
                "time": time.time(),
            })

        if not is_webp and (
            (mime_str.startswith("image/") and "gif" not in mime_str and "svg" not in mime_str)
            or ext in (".jpg", ".jpeg", ".png", ".heic", ".heif")
        ):
            send_photo(peer_id, file_path)
        elif mime_str.startswith("video/") or ext in (".mp4", ".mov", ".mkv", ".webm"):
            send_video(peer_id, file_path)
        elif mime_str.startswith("audio/") or ext in (".mp3", ".flac", ".wav", ".m4a", ".ogg"):
            send_audio(peer_id, file_path)
        else:
            send_document(peer_id, file_path)


class OutgoingDragController:
    def __init__(self, plugin):
        self.plugin = plugin
        self.reset()

    def reset(self):
        self.active = False
        self.token = 0
        self.mode = None
        self.target_text = ""
        self.down_raw_x = 0.0
        self.down_raw_y = 0.0
        self.slop_px = 18.0
        self.cell = None
        self.msg_obj = None
        if hasattr(self, "plugin") and self.plugin is not None:
            self.plugin._suppress_lp_until = 0.0

    def _is_message_playing(self, msg_obj):
        """
        Проверяет, воспроизводится ли сейчас это сообщение (например, видеокружок или голосовое).
        Если оно играет (и не стоит на паузе), зажатие пальцем включает штатную перемотку 2x, а не Drag&Drop.
        """
        if msg_obj is None:
            return False
        try:
            CachedClasses.init()
            mc_cls = CachedClasses.media_controller
            if mc_cls is None:
                return False
            mc = mc_cls.getInstance()
            if mc is None:
                return False
            if hasattr(mc, "isMessagePaused") and to_py_bool(mc.isMessagePaused(), False):
                return False
            if to_py_bool(get_java_field(mc, "isPaused"), False):
                return False
            if hasattr(mc, "isPlayingMessage") and to_py_bool(mc.isPlayingMessage(msg_obj), False):
                return True
            playing_obj = (
                mc.getPlayingMessageObject()
                if hasattr(mc, "getPlayingMessageObject")
                else get_java_field(mc, "playingMessageObject")
            )
            if playing_obj is not None:
                return (
                    to_py_int(playing_obj.getId(), -1) == to_py_int(msg_obj.getId(), -2)
                    and to_py_int(playing_obj.getDialogId(), -1) == to_py_int(msg_obj.getDialogId(), -2)
                )
        except Exception:
            pass
        return False

    def on_cell_touch(self, cell, event):
        action = event.getActionMasked()

        if action != MotionEvent.ACTION_DOWN:
            if not self.active:
                return
            if action == MotionEvent.ACTION_MOVE:
                if math.hypot(float(event.getRawX()) - self.down_raw_x, float(event.getRawY()) - self.down_raw_y) > self.slop_px:
                    self.reset()
            elif action in (MotionEvent.ACTION_UP, MotionEvent.ACTION_POINTER_DOWN):
                self.reset()
            elif action == MotionEvent.ACTION_CANCEL and self.mode in ("media_second_hold", "selected_text"):
                self.reset()
            return

        self.reset()
        if not self.plugin.get_setting("enable_drag_out", True):
            return

        lx, ly = float(event.getX()), float(event.getY())
        if not self._is_inside_bubble(cell, lx):
            return

        msg_obj = cell.getMessageObject() if hasattr(cell, "getMessageObject") else None
        if msg_obj is None:
            return

        chat_activity = get_active_chat_activity(self.plugin)
        if chat_activity is None:
            return

        if self.plugin.get_setting("enable_text_drag", True):
            preselected = self._get_preselected_text_if_ready(chat_activity, msg_obj)
            if preselected:
                self._arm_timer(cell, msg_obj, event, "selected_text", preselected, HOLD_ALREADY_SELECTED_MS)
                return

        if self._is_text_selection_active(chat_activity):
            return

        if not self._is_touch_strictly_on_media(cell, msg_obj, lx, ly):
            return

        # Если видеокружок (или голосовое/аудио) сейчас воспроизводится — не мешаем штатному зажатию для скорости 2x!
        if self._is_message_playing(msg_obj):
            return

        selected_msgs = self._get_selected_messages(chat_activity)
        is_cell_checked = (hasattr(cell, "isChecked") and bool(cell.isChecked())) or (
            any(int(m.getId()) == int(msg_obj.getId()) for m in selected_msgs)
        )

        self._arm_timer(
            cell,
            msg_obj,
            event,
            "media_second_hold" if is_cell_checked else "media_single_hold",
            "",
            HOLD_ALREADY_SELECTED_MS if is_cell_checked else HOLD_SINGLE_CONTINUOUS_MS,
        )

    def _arm_timer(self, cell, msg_obj, event, mode, target_text, delay_ms):
        self.active = True
        self.mode = mode
        self.target_text = target_text
        self.token = int(time.time() * 1000000)
        self.down_raw_x = float(event.getRawX())
        self.down_raw_y = float(event.getRawY())
        try:
            self.slop_px = max(12.0, dp_to_px(cell.getContext(), 7))
        except Exception:
            self.slop_px = 18.0
        self.cell = cell
        self.msg_obj = msg_obj

        if mode in ("selected_text", "media_second_hold"):
            self.plugin._suppress_lp_until = time.time() + 0.9

        current_token = self.token
        run_on_ui_thread(lambda: self._on_hold_timeout(current_token), delay_ms)

    def check_move_or_up(self, event):
        if not self.active or event is None:
            return

        action = event.getActionMasked()
        if action == MotionEvent.ACTION_MOVE:
            if math.hypot(float(event.getRawX()) - self.down_raw_x, float(event.getRawY()) - self.down_raw_y) > self.slop_px:
                self.reset()
        elif action in (MotionEvent.ACTION_UP, MotionEvent.ACTION_CANCEL, MotionEvent.ACTION_POINTER_DOWN):
            self.reset()

    def _is_inside_bubble(self, cell, local_x):
        try:
            if hasattr(cell, "getBackgroundDrawableLeft") and hasattr(cell, "getBackgroundDrawableRight"):
                left = float(cell.getBackgroundDrawableLeft())
                right = float(cell.getBackgroundDrawableRight())
                if right > left:
                    return left <= local_x <= right
        except Exception:
            pass
        return True

    def _is_text_selection_active(self, chat_activity):
        try:
            tsh = get_java_field(chat_activity, "textSelectionHelper")
            if tsh is not None and hasattr(tsh, "isInSelectionMode"):
                return bool(tsh.isInSelectionMode())
        except Exception:
            pass
        return False

    def _get_preselected_text_if_ready(self, chat_activity, msg_obj):
        try:
            tsh = get_java_field(chat_activity, "textSelectionHelper")
            if tsh is None or not hasattr(tsh, "isInSelectionMode") or not bool(tsh.isInSelectionMode()):
                return None

            for moving_field in ("movingHandle", "isMoving", "scrolling"):
                if get_java_field(tsh, moving_field):
                    return None

            selected_cell = get_java_field(tsh, "selectedView")
            if selected_cell is not None and hasattr(selected_cell, "getMessageObject"):
                sel_msg = selected_cell.getMessageObject()
                if sel_msg is not None and int(sel_msg.getId()) != int(msg_obj.getId()):
                    return None

            start = get_java_field(tsh, "selectionStart")
            end = get_java_field(tsh, "selectionEnd")
            if start is None or end is None:
                return None

            s, e = int(start), int(end)
            if s < 0 or e <= s:
                return None

            full_text = self._extract_message_text(msg_obj)
            if full_text and s < len(full_text):
                return full_text[s : min(e, len(full_text))]
        except Exception:
            pass

        return None

    def _has_any_media(self, msg_obj):
        try:
            if msg_obj is None or msg_obj.messageOwner is None or msg_obj.messageOwner.media is None:
                return False
            media_cls = msg_obj.messageOwner.media.getClass().getName()
            if "TL_messageMediaEmpty" in media_cls or "TL_messageMediaWebPage" in media_cls:
                return False
            return (
                msg_obj.getDocument() is not None
                or (hasattr(msg_obj, "photoThumbs") and msg_obj.photoThumbs is not None and not msg_obj.photoThumbs.isEmpty())
                or bool(msg_obj.messageOwner.attachPath)
            )
        except Exception:
            return False

    def _get_selected_messages(self, chat_activity):
        result = []
        seen_ids = set()
        try:
            arr_list = get_java_field(chat_activity, "selectedMessagesIds")
            if arr_list is None:
                return result

            for idx in range(2):
                try:
                    sparse = arr_list[idx]
                except Exception:
                    sparse = None
                if sparse is None:
                    continue
                for i in range(int(sparse.size())):
                    m_obj = sparse.valueAt(i)
                    if m_obj is not None:
                        m_id = int(m_obj.getId())
                        if m_id not in seen_ids:
                            seen_ids.add(m_id)
                            result.append(m_obj)
        except Exception:
            pass

        result.sort(key=lambda m: int(m.getId()))
        return result

    def _is_touch_strictly_on_media(self, cell, msg_obj, lx, ly):
        try:
            owner = msg_obj.messageOwner
            if owner is None or owner.media is None:
                return False

            media_cls = owner.media.getClass().getName()
            if "TL_messageMediaEmpty" in media_cls or "TL_messageMediaWebPage" in media_cls:
                return False

            if hasattr(cell, "getPhotoImage"):
                photo_img = cell.getPhotoImage()
                if photo_img is not None:
                    iw, ih = float(photo_img.getImageWidth()), float(photo_img.getImageHeight())
                    if iw > 24.0 and ih > 24.0:
                        ix, iy = float(photo_img.getImageX()), float(photo_img.getImageY())
                        if (ix <= lx <= ix + iw) and (iy <= ly <= iy + ih):
                            return True
                        if (
                            msg_obj.getDocument() is None
                            or msg_obj.isVideo()
                            or msg_obj.isSticker()
                            or msg_obj.isAnimatedSticker()
                            or msg_obj.isGif()
                        ):
                            return False

            if msg_obj.getDocument() is None and "TL_messageMediaDocument" not in media_cls:
                return False

            ctx = cell.getContext()
            if get_java_field(cell, "radialProgress") is not None:
                ry = get_java_field(cell, "radialProgressY")
                if ry is not None and int(ry) > 0:
                    ry_f = float(ry)
                    return (ry_f - dp_to_px(ctx, 14)) <= ly <= (ry_f + dp_to_px(ctx, 64))

            top_limit = dp_to_px(ctx, 8)
            if msg_obj.isReply():
                reply_h = get_java_field(cell, "replyHeight")
                top_limit += float(reply_h) if (reply_h is not None and int(reply_h) > 0) else dp_to_px(ctx, 42)
            if msg_obj.isForwarded():
                top_limit += dp_to_px(ctx, 24)

            if ly < top_limit or ly > top_limit + dp_to_px(ctx, 78):
                return False

            msg_text = self._extract_message_text(msg_obj)
            if msg_text and len(msg_text.strip()) > 0:
                for ty_field in ("captionY", "textY"):
                    ty = get_java_field(cell, ty_field)
                    if ty is not None and int(ty) > int(top_limit + dp_to_px(ctx, 28)):
                        if ly >= float(ty) - dp_to_px(ctx, 8):
                            return False

            return True
        except Exception:
            return False

    def _extract_message_text(self, msg_obj):
        try:
            for attr in ("caption", "messageText"):
                val = getattr(msg_obj, attr, None)
                if val:
                    t = str(val)
                    if t:
                        return t
            if msg_obj.messageOwner is not None and msg_obj.messageOwner.message:
                return str(msg_obj.messageOwner.message)
        except Exception:
            pass
        return ""

    def _on_hold_timeout(self, token):
        if not self.active or self.token != token:
            return

        cell, msg_obj, mode, target_text = self.cell, self.msg_obj, self.mode, self.target_text
        self.reset()

        if cell is None or msg_obj is None:
            return

        chat_activity = get_active_chat_activity(self.plugin)
        if chat_activity is None:
            return

        try:
            chat_list_view = get_java_field(chat_activity, "chatListView")
            if chat_list_view is not None and hasattr(chat_list_view, "getScrollState"):
                if to_py_int(chat_list_view.getScrollState(), 0) != 0:
                    return
        except Exception:
            pass

        if mode == "selected_text" and target_text:
            if self._is_text_selection_active(chat_activity):
                self._start_text_drag(cell, chat_activity, target_text)
        elif mode in ("media_single_hold", "media_second_hold"):
            if self._is_message_playing(msg_obj):
                return
            self._start_media_drag(cell, msg_obj, chat_activity)

    def _start_text_drag(self, cell, chat_activity, text):
        try:
            activity = chat_activity.getParentActivity()
            if activity is None:
                return

            self.plugin._is_internal_chat_text_drag = True
            self.plugin._last_drag_source_dialog = int(chat_activity.getDialogId())
            self.plugin._last_drag_start_time = time.time()

            self._cancel_telegram_long_press(cell)
            clear_all_selections(chat_activity, cell)

            clip_data = ClipData.newPlainText("Dragged Text", text)
            preview = text.replace("\n", " ").strip()
            if len(preview) > 42:
                preview = preview[:42] + "…"
            shadow = self._build_pill_shadow(activity, f"📝  {preview}")

            try:
                cell.performHapticFeedback(HapticFeedbackConstants.LONG_PRESS)
            except Exception:
                pass

            activity.getWindow().getDecorView().startDragAndDrop(clip_data, shadow, None, 256)
        except Exception as e:
            self.plugin._is_internal_chat_text_drag = False
            self.plugin.log(f"[DirectDrop] Text drag error: {e}")

    def _extract_bitmap_from_receiver(self, p_img):
        if p_img is None:
            return None
        for getter in ("getBitmap", "getThumbBitmap"):
            if hasattr(p_img, getter):
                try:
                    b = getattr(p_img, getter)()
                    if b is not None and not b.isRecycled() and b.getWidth() > 16 and b.getHeight() > 16:
                        return b
                except Exception:
                    pass
        if hasattr(p_img, "getBitmapSafe"):
            try:
                holder = p_img.getBitmapSafe()
                if holder is not None and hasattr(holder, "bitmap"):
                    b = holder.bitmap
                    if b is not None and not b.isRecycled() and b.getWidth() > 16 and b.getHeight() > 16:
                        return b
            except Exception:
                pass
        return None

    def _collect_stack_bitmaps(self, touched_cell, chat_activity, prepared_files):
        bitmaps = []
        used_msg_ids = set()

        try:
            if hasattr(touched_cell, "getPhotoImage"):
                b = self._extract_bitmap_from_receiver(touched_cell.getPhotoImage())
                if b is not None:
                    bitmaps.append(b)
                    if hasattr(touched_cell, "getMessageObject") and touched_cell.getMessageObject() is not None:
                        used_msg_ids.add(int(touched_cell.getMessageObject().getId()))
        except Exception:
            pass

        try:
            target_ids = {int(item[4].getId()) for item in prepared_files if item[4] is not None}
            chat_list_view = get_java_field(chat_activity, "chatListView")
            if chat_list_view is not None:
                for i in range(int(chat_list_view.getChildCount())):
                    if len(bitmaps) >= 3:
                        break
                    child = chat_list_view.getChildAt(i)
                    if child is not None and hasattr(child, "getMessageObject") and hasattr(child, "getPhotoImage"):
                        m_obj = child.getMessageObject()
                        if m_obj is not None:
                            m_id = int(m_obj.getId())
                            if m_id in target_ids and m_id not in used_msg_ids:
                                b = self._extract_bitmap_from_receiver(child.getPhotoImage())
                                if b is not None:
                                    bitmaps.append(b)
                                    used_msg_ids.add(m_id)
        except Exception:
            pass

        return bitmaps

    def _start_media_drag(self, cell, msg_obj, chat_activity):
        try:
            activity = chat_activity.getParentActivity()
            if activity is None:
                return

            account = (
                int(msg_obj.currentAccount)
                if hasattr(msg_obj, "currentAccount")
                else int(chat_activity.getCurrentAccount())
            )

            selected_msgs = self._get_selected_messages(chat_activity)
            target_msgs = [m for m in selected_msgs if self._has_any_media(m)]

            if not any(int(m.getId()) == int(msg_obj.getId()) for m in target_msgs):
                if self._has_any_media(msg_obj):
                    target_msgs.append(msg_obj)

            if not target_msgs:
                return

            if len(self.plugin._dragged_uri_names) > 200:
                self.plugin._dragged_uri_names.clear()
                self.plugin._dragged_uri_paths.clear()
                self.plugin._dragged_uri_mimes.clear()

            prepared_files = []
            not_downloaded_count = 0

            for m in target_msgs:
                f_path = self._resolve_local_file_path(m, account)
                if not f_path:
                    not_downloaded_count += 1
                    continue
                d_name, m_type = self._get_file_meta(m, f_path)
                u = self._get_shareable_uri(activity, f_path, d_name)
                if u is not None:
                    u_str = str(u)
                    self.plugin._dragged_uri_names[u_str] = d_name
                    self.plugin._dragged_uri_paths[u_str] = f_path
                    self.plugin._dragged_uri_mimes[u_str] = m_type
                    prepared_files.append((u, d_name, m_type, f_path, m))

            if not prepared_files:
                BulletinHelper.show_info("Дождитесь полной загрузки файла(ов) для перетаскивания", chat_activity)
                return

            if not_downloaded_count > 0:
                BulletinHelper.show_info(
                    f"Взято файлов: {len(prepared_files)} (пропущено нескачанных: {not_downloaded_count})",
                    chat_activity,
                )

            stack_bitmaps = (
                self._collect_stack_bitmaps(cell, chat_activity, prepared_files)
                if len(prepared_files) > 1
                else []
            )

            self.plugin._last_drag_source_dialog = int(chat_activity.getDialogId())
            self.plugin._last_drag_start_time = time.time()

            self._cancel_telegram_long_press(cell)
            clear_all_selections(chat_activity, cell)

            unique_mimes = list({item[2] for item in prepared_files})
            mime_arr = jarray(String)(unique_mimes)
            first_uri, first_name, _, _, _ = prepared_files[0]
            label = first_name if len(prepared_files) == 1 else f"files_{len(prepared_files)}"

            desc = ClipDescription(label, mime_arr)
            clip_data = ClipData(desc, ClipData.Item(first_uri))
            for extra_uri, _, _, _, _ in prepared_files[1:]:
                clip_data.addItem(ClipData.Item(extra_uri))

            if len(prepared_files) == 1:
                shadow = self._build_media_only_shadow(activity, cell, first_name)
            else:
                shadow = self._build_multi_media_shadow(
                    activity,
                    chat_activity,
                    stack_bitmaps,
                    len(prepared_files),
                    f"📦  Файлов: {len(prepared_files)}",
                )

            try:
                cell.performHapticFeedback(HapticFeedbackConstants.LONG_PRESS)
            except Exception:
                pass

            activity.getWindow().getDecorView().startDragAndDrop(clip_data, shadow, None, 256 | 1)
        except Exception as e:
            self.plugin.log(f"[DirectDrop] Media drag error: {e}")
            BulletinHelper.show_error(f"Ошибка Drag&Drop: {e}", chat_activity)

    def _render_rounded_card_bitmap(self, src_bmp, card_w, card_h, corner_r):
        out_bmp = Bitmap.createBitmap(card_w, card_h, Bitmap.Config.ARGB_8888)
        canvas = Canvas(out_bmp)
        paint = Paint(Paint.ANTI_ALIAS_FLAG | Paint.FILTER_BITMAP_FLAG)

        shader = BitmapShader(src_bmp, Shader.TileMode.CLAMP, Shader.TileMode.CLAMP)
        matrix = Matrix()
        scale_f = max(float(card_w) / float(src_bmp.getWidth()), float(card_h) / float(src_bmp.getHeight()))
        matrix.setScale(scale_f, scale_f)
        shader.setLocalMatrix(matrix)
        paint.setShader(shader)

        canvas.drawRoundRect(RectF(0.0, 0.0, float(card_w), float(card_h)), float(corner_r), float(corner_r), paint)
        return out_bmp

    def _build_multi_media_shadow(self, activity, chat_activity, bitmaps, count, fallback_label):
        try:
            valid_bmps = [
                b for b in bitmaps if b is not None and not b.isRecycled() and b.getWidth() > 16 and b.getHeight() > 16
            ]
            if valid_bmps:
                front_bmp = valid_bmps[0]
                bw, bh = int(front_bmp.getWidth()), int(front_bmp.getHeight())

                max_side = int(dp_to_px(activity, 136))
                min_side = int(dp_to_px(activity, 72))
                if max(bw, bh) > max_side:
                    scale = float(max_side) / float(max(bw, bh))
                    card_w = max(min_side, int(bw * scale))
                    card_h = max(min_side, int(bh * scale))
                else:
                    card_w = min(max_side, max(min_side, bw))
                    card_h = min(max_side, max(min_side, bh))

                layers = min(count, 3)
                step = int(dp_to_px(activity, 9))
                corner_r = dp_to_px(activity, 15)
                badge_size = int(dp_to_px(activity, 27))

                pad_left = int(dp_to_px(activity, 6))
                pad_top = int(dp_to_px(activity, 10))
                pad_right = int(dp_to_px(activity, 12)) + (layers - 1) * step
                pad_bottom = int(dp_to_px(activity, 8)) + (layers - 1) * step

                total_w = pad_left + card_w + pad_right
                total_h = pad_top + card_h + pad_bottom

                root = FrameLayout(activity)

                for layer_idx in range(layers - 1, -1, -1):
                    lbmp = valid_bmps[layer_idx] if layer_idx < len(valid_bmps) else front_bmp
                    card_iv = ImageView(activity)
                    card_iv.setImageBitmap(self._render_rounded_card_bitmap(lbmp, card_w, card_h, corner_r))
                    if layer_idx == 2:
                        card_iv.setAlpha(0.55)
                    elif layer_idx == 1:
                        card_iv.setAlpha(0.78)

                    lp = FrameLayout.LayoutParams(card_w, card_h, Gravity.TOP | Gravity.LEFT)
                    lp.leftMargin = pad_left + layer_idx * step
                    lp.topMargin = pad_top + layer_idx * step
                    root.addView(card_iv, lp)

                badge_tv = TextView(activity)
                badge_tv.setText(str(count))
                badge_tv.setTextColor(Color.WHITE)
                badge_tv.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13.0)
                badge_tv.setTypeface(Typeface.DEFAULT_BOLD)
                badge_tv.setGravity(Gravity.CENTER)

                badge_bg = GradientDrawable()
                badge_bg.setColor(get_accent_color(activity, chat_activity))
                badge_bg.setCornerRadius(float(badge_size) / 2.0)
                badge_bg.setStroke(int(max(2.0, dp_to_px(activity, 1.8))), Color.WHITE)
                badge_tv.setBackground(badge_bg)

                badge_w = max(badge_size, int(dp_to_px(activity, 27 + (len(str(count)) - 1) * 7)))
                badge_lp = FrameLayout.LayoutParams(badge_w, badge_size, Gravity.TOP | Gravity.LEFT)
                badge_lp.leftMargin = max(0, pad_left + card_w - int(badge_w * 0.65))
                badge_lp.topMargin = max(0, pad_top - int(badge_size * 0.3))
                root.addView(badge_tv, badge_lp)

                root.measure(
                    View.MeasureSpec.makeMeasureSpec(total_w, View.MeasureSpec.EXACTLY),
                    View.MeasureSpec.makeMeasureSpec(total_h, View.MeasureSpec.EXACTLY),
                )
                root.layout(0, 0, total_w, total_h)
                return View.DragShadowBuilder(root)
        except Exception as e:
            self.plugin.log(f"[DirectDrop] Multi media shadow error: {e}")

        return self._build_pill_shadow(activity, fallback_label)

    def _build_media_only_shadow(self, activity, cell, display_name):
        try:
            bmp = None
            w, h = 0, 0
            if hasattr(cell, "getPhotoImage"):
                photo_img = cell.getPhotoImage()
                if photo_img is not None:
                    bmp = self._extract_bitmap_from_receiver(photo_img)
                    w, h = int(photo_img.getImageWidth()), int(photo_img.getImageHeight())

            if bmp is not None and not bmp.isRecycled() and w > 24 and h > 24:
                max_side = 380
                if max(w, h) > max_side:
                    scale = float(max_side) / float(max(w, h))
                    w, h = max(1, int(w * scale)), max(1, int(h * scale))

                img_view = ImageView(activity)
                img_view.setImageBitmap(self._render_rounded_card_bitmap(bmp, w, h, 26.0))
                img_view.measure(
                    View.MeasureSpec.makeMeasureSpec(w, View.MeasureSpec.EXACTLY),
                    View.MeasureSpec.makeMeasureSpec(h, View.MeasureSpec.EXACTLY),
                )
                img_view.layout(0, 0, w, h)
                return View.DragShadowBuilder(img_view)
        except Exception:
            pass

        return self._build_pill_shadow(activity, f"📄  {display_name}")

    def _build_pill_shadow(self, activity, label):
        tv = TextView(activity)
        tv.setText(label)
        tv.setTextColor(Color.WHITE)
        tv.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 15.0)
        tv.setSingleLine(True)
        tv.setGravity(Gravity.CENTER_VERTICAL)
        tv.setPadding(44, 26, 44, 26)

        bg = GradientDrawable()
        bg.setColor(Color.parseColor("#EE242F3D"))
        bg.setCornerRadius(36.0)
        bg.setStroke(2, Color.parseColor("#55FFFFFF"))
        tv.setBackground(bg)

        spec = View.MeasureSpec.makeMeasureSpec(0, View.MeasureSpec.UNSPECIFIED)
        tv.measure(spec, spec)
        tv.layout(0, 0, tv.getMeasuredWidth(), tv.getMeasuredHeight())
        return View.DragShadowBuilder(tv)

    def _cancel_telegram_long_press(self, cell):
        try:
            now_ms = SystemClock.uptimeMillis()
            cancel_ev = MotionEvent.obtain(now_ms, now_ms, MotionEvent.ACTION_CANCEL, 0.0, 0.0, 0)
            cell.onTouchEvent(cancel_ev)
            parent = cell.getParent()
            if parent is not None and hasattr(parent, "cancelClickRunnables"):
                parent.cancelClickRunnables(True)
            cancel_ev.recycle()
        except Exception:
            pass

    def _is_file_completely_downloaded(self, fl_cls, fl, doc, java_file):
        if java_file is None or not java_file.exists():
            return False

        lower_name = os.path.basename(str(java_file.getAbsolutePath())).lower()
        if lower_name.endswith(".temp") or lower_name.endswith(".preload") or ".temp" in lower_name:
            return False

        actual_len = int(java_file.length())
        if actual_len <= 0:
            return False

        if doc is not None:
            try:
                attach_name = fl_cls.getAttachFileName(doc)
                if attach_name and fl.isLoadingFile(attach_name):
                    return False
            except Exception:
                pass

            expected_size = int(doc.size) if hasattr(doc, "size") and doc.size else 0
            if expected_size > 0 and actual_len < expected_size:
                return False

        return True

    def _resolve_local_file_path(self, msg_obj, account):
        try:
            fl_cls = CachedClasses.file_loader or find_class(CLS_FILE_LOADER)
            fl = fl_cls.getInstance(account)
            owner = msg_obj.messageOwner
            doc = msg_obj.getDocument()

            if doc is not None:
                if owner is not None and owner.attachPath:
                    p = str(owner.attachPath)
                    if os.path.isfile(p) and self._is_file_completely_downloaded(fl_cls, fl, doc, File(p)):
                        return p

                if owner is not None:
                    f = fl.getPathToMessage(owner)
                    if self._is_file_completely_downloaded(fl_cls, fl, doc, f):
                        return str(f.getAbsolutePath())

                for force_cache in (True, False):
                    f = fl.getPathToAttach(doc, force_cache)
                    if self._is_file_completely_downloaded(fl_cls, fl, doc, f):
                        return str(f.getAbsolutePath())
                return None

            if owner is not None and owner.attachPath:
                p = str(owner.attachPath)
                if os.path.isfile(p) and os.path.getsize(p) > 0:
                    return p

            if owner is not None:
                f = fl.getPathToMessage(owner)
                if f is not None and f.exists() and f.length() > 0:
                    return str(f.getAbsolutePath())

            if hasattr(msg_obj, "photoThumbs") and msg_obj.photoThumbs is not None and not msg_obj.photoThumbs.isEmpty():
                biggest_thumb = msg_obj.photoThumbs.get(msg_obj.photoThumbs.size() - 1)
                loc = biggest_thumb.location if hasattr(biggest_thumb, "location") else biggest_thumb
                for force_cache in (True, False):
                    f = fl.getPathToAttach(loc, force_cache)
                    if f is not None and f.exists() and f.length() > 0:
                        return str(f.getAbsolutePath())
        except Exception:
            pass

        return None

    def _get_file_meta(self, msg_obj, file_path):
        name = None
        mime = None

        try:
            doc = msg_obj.getDocument()
            if doc is not None and hasattr(doc, "attributes") and doc.attributes is not None:
                for i in range(doc.attributes.size()):
                    attr = doc.attributes.get(i)
                    if attr is not None and hasattr(attr, "file_name") and attr.file_name:
                        cand = str(attr.file_name).strip()
                        if cand:
                            name = cand
                            break
                if hasattr(doc, "mime_type") and doc.mime_type:
                    mime = str(doc.mime_type)

            if not name and doc is not None:
                fl_cls = CachedClasses.file_loader or find_class(CLS_FILE_LOADER)
                cand = fl_cls.getDocumentFileName(doc)
                if cand:
                    name = str(cand).strip()

            if not name and hasattr(msg_obj, "getDocumentName"):
                cand = msg_obj.getDocumentName()
                if cand:
                    name = str(cand).strip()

            if not mime and hasattr(msg_obj, "getMimeType"):
                mime = msg_obj.getMimeType()
        except Exception:
            pass

        if not name:
            base = os.path.basename(file_path)
            if INTERNAL_CACHE_NAME_RE.match(base):
                name = f"media_{int(msg_obj.getId())}{os.path.splitext(base)[1]}"
            else:
                name = base

        name = "".join(c for c in str(name) if c not in '/\\:*?"<>|')

        ext = os.path.splitext(name)[1].lower()
        if not ext:
            path_ext = os.path.splitext(file_path)[1].lower()
            if path_ext:
                ext = path_ext
                name = f"{name}{ext}"
            elif mime:
                guessed_ext = MimeTypeMap.getSingleton().getExtensionFromMimeType(str(mime))
                if guessed_ext:
                    ext = f".{guessed_ext}"
                    name = f"{name}{ext}"

        if not mime:
            if ext:
                mime = MimeTypeMap.getSingleton().getMimeTypeFromExtension(ext.lstrip("."))
            if not mime:
                mime = "application/octet-stream"

        return name, str(mime)

    def _get_shareable_uri(self, activity, file_path, display_name):
        CachedClasses.init()
        fp_cls = CachedClasses.file_provider
        authority = CachedClasses.provider_authority

        java_file = File(file_path)
        try:
            return fp_cls.getUriForFile(activity, authority, java_file, display_name)
        except Exception:
            try:
                return fp_cls.getUriForFile(activity, authority, java_file)
            except Exception:
                return None


class CellTouchHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        try:
            if param.args and param.args[0] is not None and param.thisObject is not None:
                self.plugin._drag_controller.on_cell_touch(param.thisObject, param.args[0])
        except Exception:
            pass


class ListTouchMonitorHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        if not self.plugin._drag_controller.active:
            return
        try:
            if param.args and param.args[0] is not None:
                self.plugin._drag_controller.check_move_or_up(param.args[0])
        except Exception:
            pass


class SuppressLongPressHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        now = time.time()
        if now < self.plugin._suppress_lp_until or now - self.plugin._last_drag_start_time < 1.0:
            param.setResult(True)


class SendMessageParamsHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        if not self.plugin._pending_replies and not self.plugin._pending_captions:
            return
        try:
            if not param.args or len(param.args) != 1:
                return

            send_params = param.args[0]
            if send_params is None or not hasattr(send_params, "peer"):
                return

            now = time.time()
            target_peer = to_py_int(send_params.peer)

            self.plugin._pending_captions = [
                item for item in self.plugin._pending_captions if now - item["time"] < 20.0
            ]
            for idx, c_item in enumerate(self.plugin._pending_captions):
                if c_item["peer_id"] == target_peer:
                    cap_data = self.plugin._pending_captions.pop(idx)
                    if cap_data.get("caption"):
                        set_java_field(send_params, "caption", cap_data["caption"])
                    if cap_data.get("has_spoiler"):
                        set_java_field(send_params, "hasMediaSpoiler", True)
                    if "notify" in cap_data:
                        set_java_field(send_params, "notify", bool(cap_data["notify"]))
                    if cap_data.get("schedule_date", 0) > 0:
                        set_java_field(send_params, "scheduleDate", int(cap_data["schedule_date"]))
                    break

            self.plugin._pending_replies = [
                item for item in self.plugin._pending_replies if now - item["time"] < 30.0
            ]

            matched_idx = next(
                (idx for idx, item in enumerate(self.plugin._pending_replies) if item["peer_id"] == target_peer),
                -1,
            )
            if matched_idx == -1:
                return

            ctx = self.plugin._pending_replies.pop(matched_idx)
            reply_msg, top_msg, reply_quote, chat_activity = (
                ctx["reply_msg"],
                ctx["top_msg"],
                ctx["reply_quote"],
                ctx["chat_activity"],
            )

            if reply_msg is not None and getattr(send_params, "replyToMsg", None) is None:
                send_params.replyToMsg = reply_msg
            if top_msg is not None and getattr(send_params, "replyToTopMsg", None) is None:
                send_params.replyToTopMsg = top_msg
            if reply_quote is not None and hasattr(send_params, "replyQuote") and getattr(send_params, "replyQuote", None) is None:
                try:
                    send_params.replyQuote = reply_quote
                except Exception:
                    pass

            if chat_activity is not None and reply_msg is not None and reply_msg != top_msg:
                run_on_ui_thread(
                    lambda: chat_activity.hideFieldPanel(True) if hasattr(chat_activity, "hideFieldPanel") else None
                )
        except Exception:
            pass


class ChatActivityViewHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            chat_activity = param.thisObject
            if not chat_activity:
                return

            self.plugin._current_chat_activity = chat_activity

            def _setup_global_drag():
                try:
                    if self.plugin._global_drop_listener is None:
                        self.plugin._global_drop_listener = DirectDropListener(self.plugin)
                    if self.plugin._et_touch_tracker is None:
                        self.plugin._et_touch_tracker = EditTextTouchTracker(self.plugin)

                    listener = self.plugin._global_drop_listener

                    activity = chat_activity.getParentActivity()
                    if activity is not None and activity.getWindow() is not None:
                        decor_view = activity.getWindow().getDecorView()
                        if decor_view is not None:
                            decor_view.setOnDragListener(listener)

                    fragment_view = chat_activity.getFragmentView()
                    if fragment_view:
                        fragment_view.setOnDragListener(listener)

                    et = get_message_edit_text(chat_activity)
                    if et:
                        et.setOnTouchListener(self.plugin._et_touch_tracker)
                        et.setOnDragListener(listener)
                except Exception as e:
                    self.plugin.log(f"[DirectDrop] Setup error: {e}")

            run_on_ui_thread(_setup_global_drag)
        except Exception:
            pass


class Plugin(BasePlugin):
    def create_settings(self):
        return [
            Header(text="Настройки Drag & Drop"),
            Switch(
                key="open_preview_before_send",
                text="Предпросмотр перед отправкой",
                subtext="Открывать редактор медиа и меню файлов (отправка только по кнопке в ТГ)",
                default=True,
                icon="msg_photo",
            ),
            Switch(
                key="enable_drag_out",
                text="Вытаскивание файлов и медиа",
                subtext="Нажмите прямо на файл/медиа: с 1 удержания (~1 сек) или со 2-го зажатия",
                default=True,
                icon="msg_share",
            ),
            Switch(
                key="enable_text_drag",
                text="Перетаскивание выделенного текста",
                subtext="Выделите текст в сообщении, затем зажмите его для переноса в строку ввода",
                default=True,
                icon="msg_copy",
            ),
            Switch(
                key="allow_same_chat_drop",
                text="Сброс файлов внутри того же чата",
                subtext="Разрешить сбрасывать вытащенный файл обратно в этот же чат",
                default=True,
                icon="msg_forward",
            ),
        ]

    def on_plugin_load(self):
        self._unhooks = []
        self._pending_replies = []
        self._pending_captions = []
        self._dragged_uri_names = {}
        self._dragged_uri_paths = {}
        self._dragged_uri_mimes = {}
        self._current_chat_activity = None
        self._global_drop_listener = None
        self._et_touch_tracker = None
        self._last_et_touch_sel = None
        self._pv_session = None
        self._doc_sheet_session = None
        self._last_drag_source_dialog = 0
        self._last_drag_start_time = 0.0
        self._suppress_lp_until = 0.0
        self._is_internal_chat_text_drag = False
        self._drag_controller = OutgoingDragController(self)

        CachedClasses.init()

        ca_cls = find_class(CLS_CHAT_ACTIVITY)
        if ca_cls is not None:
            view_hook = ChatActivityViewHook(self)
            for method_name in ("createView", "onResume"):
                unhook_list = self.hook_all_methods(ca_cls, method_name, view_hook)
                if unhook_list:
                    self._unhooks.extend(unhook_list)

        sm_cls = find_class(CLS_SEND_MESSAGES_HELPER)
        if sm_cls is not None:
            unhook_send = self.hook_all_methods(sm_cls, "sendMessage", SendMessageParamsHook(self))
            if unhook_send:
                self._unhooks.extend(unhook_send)

        dl_cls = CachedClasses.doc_layout
        if dl_cls is not None:
            unhook_dl_show = self.hook_all_methods(dl_cls, "onShow", DocumentLayoutOnShowHook(self))
            if unhook_dl_show:
                self._unhooks.extend(unhook_dl_show)

            unhook_dl_send = self.hook_all_methods(dl_cls, "sendSelectedItems", DocumentLayoutSendHook(self))
            if unhook_dl_send:
                self._unhooks.extend(unhook_dl_send)

        epv_cls = CachedClasses.empty_pv_provider
        if epv_cls is not None:
            for pv_m_name in (
                "allowCaption",
                "canScrollAway",
                "allowGroupPhotos",
                "getSelectedPhotos",
                "getSelectedPhotosOrder",
                "getSelectedCount",
                "getPhotoIndex",
                "isPhotoChecked",
                "setPhotoChecked",
                "cancelButtonPressed",
                "sendButtonPressed",
            ):
                unhook_pv = self.hook_all_methods(
                    epv_cls, pv_m_name, PhotoViewerProviderHook(self, pv_m_name)
                )
                if unhook_pv:
                    self._unhooks.extend(unhook_pv)

        pv_cls = CachedClasses.photo_viewer
        if pv_cls is not None:
            unhook_pv_send = self.hook_all_methods(
                pv_cls, "sendButtonPressed", PhotoViewerInternalSendHook(self)
            )
            if unhook_pv_send:
                self._unhooks.extend(unhook_pv_send)

        cell_cls = find_class(CLS_CHAT_MESSAGE_CELL)
        if cell_cls is not None:
            unhook_cell = self.hook_all_methods(cell_cls, "onTouchEvent", CellTouchHook(self))
            if unhook_cell:
                self._unhooks.extend(unhook_cell)

            unhook_lp = self.hook_all_methods(cell_cls, "performLongClick", SuppressLongPressHook(self))
            if unhook_lp:
                self._unhooks.extend(unhook_lp)

        rlv_cls = find_class(CLS_RECYCLER_LIST_VIEW)
        if rlv_cls is not None:
            unhook_rlv = self.hook_all_methods(rlv_cls, "dispatchTouchEvent", ListTouchMonitorHook(self))
            if unhook_rlv:
                self._unhooks.extend(unhook_rlv)

    def on_plugin_unload(self):
        if hasattr(self, "_unhooks") and self._unhooks:
            for u in self._unhooks:
                try:
                    u.unhook()
                except Exception:
                    pass
            self._unhooks.clear()
        self._pending_replies.clear()
        self._pending_captions.clear()
        self._dragged_uri_names.clear()
        self._dragged_uri_paths.clear()
        self._dragged_uri_mimes.clear()
        _FIELD_CACHE.clear()
        _METHOD_CACHE.clear()
        self._current_chat_activity = None
        self._global_drop_listener = None
        self._et_touch_tracker = None
        self._last_et_touch_sel = None
        self._pv_session = None
        self._doc_sheet_session = None