__id__ = "modular_sections"
__name__ = "Modular Sections"
__description__ = "Преобразует элементы интерфейса в модульные секции Material 3."
__author__ = "@RnPlugins"
__version__ = "1.0.1"
__build__ = 33
__icon__ = "RnDev/14"
__app_version__ = ">=12.5.1"
__sdk_version__ = ">=1.4.3.3"

import base64
import traceback
from base_plugin import BasePlugin
from java.nio import ByteBuffer
from dalvik.system import InMemoryDexClassLoader
from org.telegram.messenger import ApplicationLoader
from android_utils import run_on_ui_thread
from ui.settings import Header, Switch, Divider, Selector, Text

DEX_B64 = """"""

class ModularSectionsPlugin(BasePlugin):
    def on_plugin_load(self):
        self.dex_class = None
        self.dex_loader = None
        self.author_sheet_class = None
        try:
            self.log("Loading Java ModularSections module...")
            dex_bytes = base64.b64decode(DEX_B64)
            buffer = ByteBuffer.wrap(dex_bytes)
            parent_cl = ApplicationLoader.applicationContext.getClassLoader()
            self.dex_loader = InMemoryDexClassLoader(buffer, parent_cl)
            self.dex_class = self.dex_loader.loadClass("dev.rooni.modularsections.ModularSections")
            try:
                self.author_sheet_class = self.dex_loader.loadClass("dev.rooni.author.AuthorBottomSheet")
            except Exception:
                pass
            
            self._apply_settings()
            self._invoke_zero_arg("start")
            run_on_ui_thread(self.check_author_promo, delay=700)
            self.log("Java ModularSections module loaded and started successfully.")
        except Exception as e:
            self.log(f"Failed to load Java ModularSections module: {e}\n{traceback.format_exc()}")

    def on_plugin_unload(self):
        try:
            self.log("Unloading Java ModularSections module...")
            self._invoke_zero_arg("stop")
            self.dex_class = None
            self.author_sheet_class = None
            self.dex_loader = None
            self.log("Java ModularSections module unloaded successfully.")
        except Exception as e:
            self.log(f"Failed to unload Java ModularSections module: {e}")

    def check_author_promo(self):
        try:
            if self.get_setting("author_promo_shown", False):
                return
            if self.author_sheet_class is None:
                return
            if self.author_sheet_class.getMethod("isSubscribedToAuthor").invoke(None):
                self.set_setting("author_promo_shown", True)
                return
            if self.author_sheet_class.getMethod("showFromCurrentActivity").invoke(None):
                self.set_setting("author_promo_shown", True)
        except Exception:
            pass

    def on_author_click(self, _=None):
        try:
            if getattr(self, "author_sheet_class", None) is not None:
                self.author_sheet_class.getMethod("showFromCurrentActivity").invoke(None)
        except Exception:
            pass

    def _invoke_zero_arg(self, method_name):
        if self.dex_class is not None:
            try:
                self.dex_class.getMethod(method_name).invoke(None)
            except Exception as e:
                self.log(f"Failed to invoke {method_name}: {e}")

    def _bool_setting(self, key, default):
        raw = self.get_setting(key, default)
        if isinstance(raw, str):
            return raw.lower() == "true"
        return bool(raw)

    def _apply_settings(self):
        drawer = self._bool_setting("apply_drawer", True)
        dialogs = self._bool_setting("apply_dialogs", False)
        separate = self._bool_setting("separate_pinned", True)
        try:
            margin_mode = int(self.get_setting("margin_mode", 1))
        except Exception:
            margin_mode = 1
        if self.dex_class is not None:
            try:
                from java.lang import Boolean, Integer
                m = self.dex_class.getMethod("updateSettings", Boolean.TYPE, Boolean.TYPE, Boolean.TYPE, Integer.TYPE)
                m.invoke(None, Boolean(drawer), Boolean(dialogs), Boolean(separate), Integer(margin_mode))
                return
            except Exception as e:
                self.log(f"Failed to invoke updateSettings: {e}")
            self._invoke_zero_arg("syncSettings")

    def on_setting_changed(self, key, value):
        if key == "margin_mode":
            self.set_setting(key, int(value))
        elif key == "apply_dialogs":
            self.set_setting(key, bool(value), reload_settings=True)
        else:
            self.set_setting(key, bool(value))
        self._apply_settings()

    def create_settings(self):
        rows = [
            Header(text="Секции интерфейса"),
            Switch(
                key="apply_drawer",
                text="Боковое меню",
                default=self._bool_setting("apply_drawer", True),
                icon="msg_newphone",
                on_change=lambda v: self.on_setting_changed("apply_drawer", v)
            ),
            Switch(
                key="apply_dialogs",
                text="Список чатов",
                default=self._bool_setting("apply_dialogs", False),
                icon="msg_discussion",
                on_change=lambda v: self.on_setting_changed("apply_dialogs", v)
            ),
            Divider(text="Выберите, где использовать секционные контейнеры")
        ]

        if self._bool_setting("apply_dialogs", False):
            rows.extend([
                Header(text="Список чатов"),
                Selector(
                    key="margin_mode",
                    text="Отступы по бокам",
                    default=int(self.get_setting("margin_mode", 1)),
                    items=[
                        "Нет",
                        "Средние",
                        "Большие"
                    ],
                    icon="msg_customize",
                    on_change=lambda v: self.on_setting_changed("margin_mode", v)
                ),
                Switch(
                    key="separate_pinned",
                    text="Закрепы отдельно",
                    subtext="Отображать закрепленные чаты и архив отдельной секцией",
                    default=self._bool_setting("separate_pinned", True),
                    icon="msg_pin",
                    on_change=lambda v: self.on_setting_changed("separate_pinned", v)
                ),
                Divider()
            ])

        rows.extend([
            Header(text="О плагине"),
            Text(
                text="Автор",
                subtext="Подробнее о разработчике",
                icon="msg_openprofile",
                on_click=self.on_author_click
            )
        ])

        return rows
