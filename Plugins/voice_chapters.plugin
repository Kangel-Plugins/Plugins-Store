"""Voice Chapters — local timestamp bookmarks for Telegram voice messages.

Single-file exteraGram / AyuGram Python plugin (plugin SDK >= 1.4.4.3).
The UI uses documented SDK menu and alert-dialog helpers. Uses a lightweight cell-binding hook to add interactive waveform chapter markers.
"""

import json
import hashlib
import time
from collections.abc import Mapping
from typing import Any

from base_plugin import BasePlugin, MenuItemData, MenuItemType, MethodHook

__id__ = "voice_chapters"
__name__ = "Voice Message Bookmarks"
__description__ = "Закладки на нужных секундах голосовых сообщений Telegram. Быстрый переход по меткам над звуковой волной, каталог сохранённых голосовых по чатам, настройка оформления и резервные копии JSON."
__author__ = "@ghoulbananarank"
__version__ = "0.2.16"
__icon__ = "pluginiconssss/1"
__category__ = ["tools", "chats"]
__min_version__ = "12.10.6"
__app_version__ = ">=12.10.6"
__sdk_version__ = ">=1.4.4.3"

_DB_KEY = "voice_chapters_database_v1"
_META_KEY = "voice_chapters_message_metadata_v1"
_MAX_CHAPTERS_PER_VOICE = 30
_MAX_VOICES = 1500
_MAX_BACKUP_BYTES = 12 * 1024 * 1024
_BACKUP_FOLDER_REQUEST = 22051
_BACKUP_RESTORE_REQUEST = 22052
_BACKUP_CREATE_REQUEST = 22053  # Android 9 fallback
_BACKUP_FOLDER_KEY = "backup_tree_uri_v1"


def format_time(seconds: int) -> str:
    s = max(0, int(seconds))
    if s >= 3600:
        return "%d:%02d:%02d" % (s // 3600, (s % 3600) // 60, s % 60)
    return "%02d:%02d" % (s // 60, s % 60)


def parse_time(value: str) -> int:
    """Parse seconds, MM:SS or HH:MM:SS; reject invalid input."""
    parts = str(value).strip().split(":")
    if not 1 <= len(parts) <= 3 or any(not p.isdigit() for p in parts):
        raise ValueError("Enter seconds, MM:SS or HH:MM:SS")
    numbers = [int(x) for x in parts]
    if len(numbers) == 1:
        return numbers[0]
    if any(x >= 60 for x in numbers[1:]):
        raise ValueError("Seconds and minutes must be below 60")
    if len(numbers) == 2:
        return numbers[0] * 60 + numbers[1]
    return numbers[0] * 3600 + numbers[1] * 60 + numbers[2]


def valid_chapter(time_s: int, duration: int) -> bool:
    return isinstance(time_s, int) and duration >= 1 and 0 <= time_s < duration


def append_chapter(chapters, seconds: int, label: str, duration: int, default_prefix="Метка"):
    """Returns a new sorted list. Raises ValueError for invalid edits."""
    if not valid_chapter(seconds, duration):
        raise ValueError("Timestamp is outside the voice message")
    if len(chapters) >= _MAX_CHAPTERS_PER_VOICE:
        raise ValueError("Maximum number of chapters reached")
    if any(int(item["t"]) == seconds for item in chapters):
        raise ValueError("A chapter already exists at that second")
    clean = " ".join(str(label).split())[:48] or (str(default_prefix) + " " + format_time(seconds))
    result = [dict(x) for x in chapters]
    result.append({"t": int(seconds), "name": clean})
    result.sort(key=lambda x: int(x["t"]))
    return result


def safe_decode_database(raw):
    try:
        data = json.loads(raw) if isinstance(raw, str) else raw
        if not isinstance(data, dict):
            return {}
        cleaned = {}
        for key, entries in list(data.items())[:_MAX_VOICES]:
            if not isinstance(key, str) or not isinstance(entries, list):
                continue
            valid = []
            for item in entries[:_MAX_CHAPTERS_PER_VOICE]:
                if not isinstance(item, dict):
                    continue
                t, name = item.get("t"), item.get("name", "")
                if type(t) is int and t >= 0 and t <= 86400 and isinstance(name, str):
                    valid.append({"t": t, "name": name[:48]})
            if valid:
                cleaned[key] = sorted(valid, key=lambda e: e["t"])
        return cleaned
    except (ValueError, TypeError):
        return {}



# Portable, versioned backup format. v1 backups produced by previous versions
# remain readable; v2 includes a SHA-256 checksum for integrity verification.
def backup_document(chapters, metadata):
    content = {"chapters": chapters, "metadata": metadata}
    canonical = json.dumps(content, ensure_ascii=False, sort_keys=True,
                           separators=(",", ":"))
    payload = {"format": "voice_chapters_backup_v2",
               "created_unix": int(time.time()),
               "chapters": chapters, "metadata": metadata,
               "sha256": hashlib.sha256(canonical.encode("utf-8")).hexdigest()}
    return json.dumps(payload, ensure_ascii=False, separators=(",", ":"))


def backup_filename(now=None):
    stamp = time.localtime(time.time() if now is None else now)
    return "Voice_Chapters_%s.json" % time.strftime("%Y-%m-%d_%H-%M-%S", stamp)


def parse_backup_document(raw_text):
    if not isinstance(raw_text, str):
        raise ValueError("Backup must be UTF-8 JSON")
    raw_text = raw_text.lstrip("\ufeff")
    if len(raw_text.encode("utf-8")) > _MAX_BACKUP_BYTES:
        raise ValueError("Backup exceeds 12 MiB")
    doc = json.loads(raw_text)
    if not isinstance(doc, dict):
        raise ValueError("Invalid backup format")
    version = doc.get("format")
    if version not in ("voice_chapters_backup_v1", "voice_chapters_backup_v2"):
        raise ValueError("Not a Voice Chapters backup")
    chapters = doc.get("chapters")
    metadata = doc.get("metadata", {})
    if not isinstance(chapters, dict) or not isinstance(metadata, dict):
        raise ValueError("Malformed chapters or dates")
    if version == "voice_chapters_backup_v2":
        digest = doc.get("sha256")
        if not isinstance(digest, str) or len(digest) != 64:
            raise ValueError("Missing backup checksum")
        canonical = json.dumps({"chapters": chapters, "metadata": metadata},
                               ensure_ascii=False, sort_keys=True,
                               separators=(",", ":"))
        if hashlib.sha256(canonical.encode("utf-8")).hexdigest() != digest:
            raise ValueError("Backup checksum mismatch")
    if len(chapters) > _MAX_VOICES:
        raise ValueError("More than 1500 voice messages in backup")
    for key, marks in chapters.items():
        if not isinstance(key, str) or len(key.split(":")) != 3:
            raise ValueError("Invalid voice message identifier")
        try:
            for part in key.split(":"):
                int(part)
        except ValueError:
            raise ValueError("Invalid voice message identifier")
        if not isinstance(marks, list) or len(marks) > _MAX_CHAPTERS_PER_VOICE:
            raise ValueError("Invalid chapter count")
        times = set()
        for mark in marks:
            if not isinstance(mark, dict):
                raise ValueError("Malformed chapter")
            t, name = mark.get("t"), mark.get("name")
            if type(t) is not int or not (0 <= t <= 86400):
                raise ValueError("Invalid timestamp")
            if not isinstance(name, str) or len(name) > 48 or t in times:
                raise ValueError("Invalid or duplicate chapter name/time")
            times.add(t)
    return chapters, metadata


def merge_backup_chapters(current, incoming):
    """Validate ALL capacity limits before writing; never silently drop marks."""
    merged = {k: [dict(mark) for mark in marks] for k, marks in current.items()}
    added = 0
    for key, marks in incoming.items():
        if key not in merged:
            if len(merged) >= _MAX_VOICES:
                raise ValueError("Too many voice messages after restore")
            merged[key] = [dict(mark) for mark in marks]
            added += len(marks)
        else:
            times = {int(mark["t"]) for mark in merged[key]}
            for mark in marks:
                if mark["t"] not in times:
                    if len(merged[key]) >= _MAX_CHAPTERS_PER_VOICE:
                        raise ValueError("Too many chapters in a voice message")
                    merged[key].append(dict(mark))
                    times.add(mark["t"])
                    added += 1
            merged[key].sort(key=lambda mark: int(mark["t"]))
    return merged, added




def group_waveform_chapters(entries, duration, width, min_spacing=19.0):
    """Return stable (x, group) items. Close chapters share one clickable dot.

    This runs only on message binding, not during rendering or audio progress.
    """
    if duration <= 0 or width <= 0:
        return []
    groups = []
    for entry in sorted(entries, key=lambda e: int(e["t"])):
        x = max(0.0, min(float(width), float(entry["t"]) / float(duration) * float(width)))
        if groups and x - groups[-1][0] < min_spacing:
            prev_x, members = groups[-1]
            members.append(entry)
            groups[-1] = (sum(float(e["t"]) / duration * width for e in members) / len(members), members)
        else:
            groups.append((x, [entry]))
    return groups


