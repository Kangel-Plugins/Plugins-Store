    @classmethod
    def is_ru(cls) -> bool:
        try:
            from org.telegram.messenger import LocaleController
            cur = str(LocaleController.getInstance().getCurrentLocale().getLanguage() or "").lower()
            if cur.startswith("ru") or cur.startswith("uk") or cur.startswith("be") or cur.startswith("kk"):
                return True
            if cur:
                return False
        except Exception:
            pass

        try:
            from java.util import Locale
            code = str(Locale.getDefault().getLanguage() or "").lower()
            if code.startswith("ru") or code.startswith("uk") or code.startswith("be") or code.startswith("kk"):
                return True
        except Exception:
            pass

        return False

    @classmethod
    def get(cls, key: str, default: str = "") -> str:
        entry = cls._T.get(key)
        if not entry:
            return default or key
        lang = "ru" if cls.is_ru() else "en"
        return entry.get(lang) or entry.get("en") or default or key


class Dex:
    def __init__(self, ec):
        self.ec = ec
        self.clazz = None
        self.loaded = False
        self._m = {}

    def load(self):
        if self.loaded:
            return
        if self.clazz is None:
            ctx = ApplicationLoader.applicationContext
            if not ctx:
                raise RuntimeError("no ctx")
            self.clazz = jclass("dalvik.system.InMemoryDexClassLoader")(jclass("java.nio.ByteBuffer").wrap(self._rp()), ctx.getClassLoader()).loadClass(self.ec)
            for m in self.clazz.getDeclaredMethods():
                m.setAccessible(True)
                self._m[str(m.getName())] = m
        self._m["load"].invoke(None)
        self.loaded = True

    def unload(self):
        try:
            if self.loaded and "unload" in self._m:
                self._m["unload"].invoke(None)
        except Exception:
            pass
        self.loaded = False

    def call(self, name, *args):
        try:
            if self.loaded and name in self._m:
                return self._m[name].invoke(None, *args)
        except Exception as e:
            log(f"[ScamMarker] dex.{name}: {e}")
        return None

    def _rp(self):
        with open(__file__, "r", encoding="utf-8") as f:
            t = f.read()
        b = t.split(f"# {DEX_BEGIN}", 1)[1].split(f"# {DEX_END}", 1)[0]
        p = "".join(l.strip()[1:].strip() for l in b.splitlines() if l.strip().startswith("#"))
        if not p:
            raise RuntimeError("dex empty")
        return zlib.decompress(base64.b64decode(p))


class ScamMarker(BasePlugin):
    def __init__(self):
        super().__init__()
        self.dex = Dex(ENTRY_CLASS)

    def on_plugin_load(self):
        def load_dex():
            try:
                self.dex.load()
                self.dex.call("pyRefresh")
            except Exception as e:
                log(f"[ScamMarker] dex load: {e}")
        threading.Thread(target=load_dex, daemon=True, name="ScamMarker-init").start()

    def on_plugin_unload(self):
        try:
            self.dex.unload()
        except Exception:
            pass


__plugin__ = ScamMarker


