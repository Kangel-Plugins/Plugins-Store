def as_java_color(color: Any) -> int:
    value = int(color) & 0xFFFFFFFF
    return value - 0x100000000 if value >= 0x80000000 else value


def call_int_color(target: Any, method_name: str, color: Any):
    value = Integer(as_java_color(color))
    try:
        method = target.getClass().getMethod(method_name, Integer.TYPE)
        return method.invoke(target, value)
    except Exception:
        return getattr(target, method_name)(as_java_color(color))


def theme_color(key: int, provider: Any = None) -> int:
    if provider is None:
        return int(Theme.getColor(int(key)))
    return int(Theme.getColor(int(key), provider))


def dp(value: float) -> int:
    try:
        return int(AndroidUtilities.dp(float(value)))
    except Exception:
        return int(value)


def to_py_list(value: Any) -> List:
    if value is None:
        return []
    if isinstance(value, (list, tuple)):
        return list(value)
    try:
        return [value.get(int(index)) for index in range(int(value.size()))]
    except Exception:
        pass
    try:
        return [value[int(index)] for index in range(len(value))]
    except Exception:
        return []


def fmt_amount(n: int) -> str:
    n = int(n)
    sign = "+" if n > 0 else ("−" if n < 0 else "")
    return f"{sign}{abs(n):,}".replace(",", " ")


def fmt_thousands(n: int) -> str:
    return f"{int(n):,}".replace(",", " ")


def fmt_month_title(year: int, month: int) -> str:
    return f"{MONTHS_RU[month - 1]} {year}"


def ru_plural(n: int, one: str, few: str, many: str) -> str:
    n = abs(int(n))
    if n % 10 == 1 and n % 100 != 11:
        return one
    if 2 <= n % 10 <= 4 and not (12 <= n % 100 <= 14):
        return few
    return many


def shift_month(base_year: int, base_month: int, offset: int):
    index = base_month - 1 + int(offset)
    return base_year + index // 12, index % 12 + 1


def month_range(year: int, month: int):
    start = datetime(year, month, 1).timestamp()
    next_year = year + 1 if month == 12 else year
    next_month = 1 if month == 12 else month + 1
    end = datetime(next_year, next_month, 1).timestamp()
    return start, end, calendar.monthrange(year, month)[1]


def day_key_of(timestamp: int) -> str:
    return datetime.fromtimestamp(int(timestamp)).strftime("%Y-%m-%d")


def category_of(flags: Dict[str, bool], peer_kind: str, amount: int) -> str:
    if flags.get("reaction"):
        return CAT_REACTION
    if flags.get("paid_message"):
        return CAT_PAID_MESSAGE
    if flags.get("stargift") or any(flags.get(name) for name in GIFT_MARKET_FLAG_NAMES) or any(
        flags.get(name) for name in GIFT_FLAG_NAMES
    ):
        if any(flags.get(name) for name in GIFT_MARKET_FLAG_NAMES):
            return CAT_GIFT_MARKET
        return CAT_GIFT
    if flags.get("premium_gift"):
        return CAT_PREMIUM
    if flags.get("subscription"):
        return CAT_SUBSCRIPTION
    if flags.get("floodskip"):
        return CAT_FLOODSKIP
    if flags.get("posts_search"):
        return CAT_POSTS
    if flags.get("extended_media"):
        return CAT_PAID_MEDIA
    if peer_kind == "TL_starsTransactionPeerAds":
        return CAT_ADS
    if peer_kind == "TL_starsTransactionPeerAPI":
        return CAT_BOT
    if peer_kind in ("TL_starsTransactionPeerAppStore", "TL_starsTransactionPeerPlayMarket"):
        return CAT_TOPUP
    if peer_kind in ("TL_starsTransactionPeerFragment", "TL_starsTransactionPeerPremiumBot"):
        return CAT_TOPUP if amount > 0 else CAT_PREMIUM
    return CAT_OTHER


def label(
    context: Any,
    text: str,
    size: float,
    color: int,
    bold: bool = False,
    gravity: int = Gravity.LEFT,
) -> TextView:
    tv = TextView(context)
    tv.setText(text)
    tv.setTextSize(size)
    tv.setGravity(gravity)
    if bold:
        tv.setTypeface(AndroidUtilities.bold())
    call_int_color(tv, "setTextColor", color)
    return tv


def dot_view(context: Any, color: int, size: float = 10.0) -> View:
    dot = View(context)
    drawable = GradientDrawable()
    drawable.setShape(GradientDrawable.RECTANGLE)
    drawable.setCornerRadius(dp(size) / 2.0)
    call_int_color(drawable, "setColor", color)
    dot.setBackground(drawable)
    params = LinearLayout.LayoutParams(dp(size), dp(size))
    params.gravity = Gravity.CENTER_VERTICAL
    dot.setLayoutParams(params)
    return dot


def add_divider(container: Any, color: int, top_dp: float = 0.0) -> None:
    line = View(container.getContext())
    call_int_color(line, "setBackgroundColor", color)
    params = LinearLayout.LayoutParams(LinearLayout.LayoutParams.MATCH_PARENT, dp(1))
    params.leftMargin = dp(18)
    params.rightMargin = dp(18)
    params.topMargin = dp(top_dp)
    container.addView(line, params)


def category_color(category: str, palette: List[int]) -> int:
    try:
        index = CATEGORY_ORDER.index(category)
    except ValueError:
        index = len(CATEGORY_ORDER) - 1
    if not palette:
        return 0
    return palette[index % len(palette)]


def get_resources_provider(fragment: Any) -> Any:
    if fragment is None:
        return None
    try:
        provider = fragment.getResourceProvider()
        if provider is not None:
            return provider
    except Exception:
        pass
    try:
        return fragment.resourcesProvider
    except Exception:
        return None


class _PressScaleListener(dynamic_proxy(View.OnTouchListener)):

    def __init__(self, down_scale: float = 0.95, press_duration: int = 90, release_duration: int = 260):
        super().__init__()
        self.down_scale = float(down_scale)
        self.press_duration = int(press_duration)
        self.release_duration = int(release_duration)

    def onTouch(self, view: Any, event: Any) -> bool:
        action = event.getAction()
        if action == MotionEvent.ACTION_DOWN:
            try:
                view.animate().scaleX(self.down_scale).scaleY(self.down_scale).alpha(0.75).setDuration(
                    self.press_duration
                ).setInterpolator(DecelerateInterpolator()).start()
            except Exception:
                pass
        elif action in (MotionEvent.ACTION_UP, MotionEvent.ACTION_CANCEL):
            try:
                view.animate().scaleX(1.0).scaleY(1.0).alpha(1.0).setDuration(
                    self.release_duration
                ).setInterpolator(OvershootInterpolator(1.4)).start()
            except Exception:
                pass
        return False


def apply_ripple(view: Any, provider: Any, mask: Optional[int] = None) -> None:
    try:
        view.setBackground(
            Theme.createSelectorDrawable(
                theme_color(Theme.key_listSelector, provider),
                Theme.RIPPLE_MASK_CIRCLE_20DP if mask is None else mask,
            )
        )
    except Exception:
        pass


def set_text_with_stars(tv: Any, text: str, ratio: float = 0.95) -> None:
    try:
        if "⭐" not in text:
            return
        size_px = max(dp(8), int(tv.getTextSize() * ratio))
        spannable = SpannableStringBuilder(text)
        start = 0
        while True:
            index = text.find("⭐", start)
            if index < 0:
                break
            drawable = (
                tv.getContext()
                .getResources()
                .getDrawable(TelegramR.drawable.star_small_inner)
                .mutate()
            )
            drawable.setBounds(0, 0, size_px, size_px)
            alignment = getattr(ImageSpan, "ALIGN_CENTER", None)
            if alignment is None:
                alignment = ImageSpan.ALIGN_BASELINE
            spannable.setSpan(
                ImageSpan(drawable, int(alignment)),
                index,
                index + 1,
                Spanned.SPAN_EXCLUSIVE_EXCLUSIVE,
            )
            start = index + 1
        tv.setText(spannable)
    except Exception:
        tv.setText(text)


def build_segment_bar(context: Any, segments: List, provider: Any, height_dp: float = 14.0) -> View:
    container = LinearLayout(context)
    container.setOrientation(LinearLayout.HORIZONTAL)
    background = GradientDrawable()
    background.setShape(GradientDrawable.RECTANGLE)
    background.setCornerRadius(dp(height_dp) / 2.0)
    track = theme_color(Theme.key_divider, provider)
    call_int_color(background, "setColor", track)
    container.setBackground(background)
    try:
        container.setClipToOutline(True)
    except Exception:
        pass

    total = sum(value for value, _color in segments)
    if total <= 0:
        segment = View(context)
        fill = GradientDrawable()
        call_int_color(fill, "setColor", track)
        segment.setBackground(fill)
        container.addView(
            segment,
            LinearLayout.LayoutParams(0, LinearLayout.LayoutParams.MATCH_PARENT, 1.0),
        )
        return container

    for value, color in segments:
        if value <= 0:
            continue
        segment = View(context)
        fill = GradientDrawable()
        call_int_color(fill, "setColor", color)
        segment.setBackground(fill)
        container.addView(
            segment,
            LinearLayout.LayoutParams(0, LinearLayout.LayoutParams.MATCH_PARENT, float(value)),
        )

    try:
        container.setPivotX(0.0)
        container.setScaleX(0.0)
        container.animate().scaleX(1.0).setStartDelay(40).setDuration(460).setInterpolator(
            DecelerateInterpolator(1.6)
        ).start()
    except Exception:
        pass
    return container


def build_period_bars(
    context: Any,
    bucket_meta: List[Dict[str, Any]],
    provider: Any,
    axis_start: str,
    axis_end: str,
    bar_refs: List[Dict[str, Any]],
    on_tap: Any,
    height_dp: float = 96.0,
) -> View:
    height = dp(height_dp)
    baseline_color = theme_color(Theme.key_divider, provider)
    accent = theme_color(Theme.key_windowBackgroundWhiteValueText, provider)
    row = LinearLayout(context)
    row.setOrientation(LinearLayout.HORIZONTAL)
    values = [float(item.get("spend", 0.0)) for item in bucket_meta]
    max_value = max(values) if values else 0.0
    count = len(values)
    if count == 0:
        return row

    for index in range(count):
        value = values[index]
        column = FrameLayout(context)
        column.setPadding(dp(1), 0, dp(1), 0)
        column.setClickable(True)
        apply_ripple(column, provider, RIPPLE_MASK_ALL)
        bar = View(context)
        drawable = GradientDrawable()
        drawable.setShape(GradientDrawable.RECTANGLE)
        drawable.setCornerRadius(dp(2))
        positive = value > 0
        if not positive:
            bar_height = dp(2)
            call_int_color(drawable, "setColor", baseline_color)
        else:
            ratio = value / max_value if max_value > 0 else 0.0
            bar_height = max(dp(3), int((height - dp(12)) * ratio))
            call_int_color(drawable, "setColor", accent)
        bar.setBackground(drawable)
        column.addView(
            bar,
            FrameLayout.LayoutParams(
                FrameLayout.LayoutParams.MATCH_PARENT,
                bar_height,
                Gravity.BOTTOM,
            ),
        )
        if on_tap is not None:
            column.setOnClickListener(OnClickListener(lambda _view=None, i=index: on_tap(i)))
        row.addView(column, LinearLayout.LayoutParams(0, height, 1.0))
        bar_refs.append({"view": bar, "column": column, "drawable": drawable, "positive": positive})

        try:
            bar.setPivotY(float(bar_height))
            bar.setScaleY(0.0)
            bar.animate().scaleY(1.0).setStartDelay(min(360, index * 14)).setDuration(320).setInterpolator(
                DecelerateInterpolator(1.4)
            ).start()
        except Exception:
            pass

    baseline = View(context)
    call_int_color(baseline, "setBackgroundColor", baseline_color)
    axis_color = theme_color(Theme.key_windowBackgroundWhiteGrayText3, provider)
    axis = LinearLayout(context)
    axis.setOrientation(LinearLayout.HORIZONTAL)
    axis.setPadding(dp(4), dp(3), dp(4), 0)
    axis.addView(label(context, axis_start, 11, axis_color))
    axis.addView(
        label(context, axis_end, 11, axis_color, gravity=Gravity.RIGHT),
        LinearLayout.LayoutParams(0, LinearLayout.LayoutParams.WRAP_CONTENT, 1.0),
    )
    wrapper = LinearLayout(context)
    wrapper.setOrientation(LinearLayout.VERTICAL)
    wrapper.addView(row, LinearLayout.LayoutParams(-1, height))
    wrapper.addView(baseline, LinearLayout.LayoutParams(-1, dp(1)))
    wrapper.addView(axis, LinearLayout.LayoutParams(-1, LinearLayout.LayoutParams.WRAP_CONTENT))
    return wrapper


class _StarsDelegate(dynamic_proxy(NotificationCenter.NotificationCenterDelegate)):
    def __init__(self, plugin: "CashierPlugin"):
        super().__init__()
        self.plugin = plugin

    def didReceivedNotification(self, id: int, account: int, *args) -> None:
        plugin = self.plugin
        if plugin is None or not plugin._alive or plugin._delegate is not self:
            return
        try:
            plugin.on_notification(int(id), int(account))
        except Exception as error:
            try:
                plugin.log(f"delegate error: {error}")
            except Exception:
                pass


class _AccountSwitchDelegate(dynamic_proxy(NotificationCenter.NotificationCenterDelegate)):

    def __init__(self, plugin: "CashierPlugin"):
        super().__init__()
        self.plugin = plugin

    def didReceivedNotification(self, id: int, account: int, *args) -> None:
        plugin = self.plugin
        if plugin is None or not plugin._alive or plugin._account_delegate is not self:
            return
        try:
            plugin.on_active_account_changed()
        except Exception as error:
            try:
                plugin.log(f"account switch handling failed: {error}")
            except Exception:
                pass


class _DashboardSession:

    def __init__(self, plugin: "CashierPlugin"):
        self.plugin = plugin
        self.delegate: Optional[Any] = None
        self.java: Optional[Any] = None
        self.container: Optional[LinearLayout] = None
        self.provider: Any = None
        self.views: Dict[str, Any] = {}
        self.destroyed = False

    def __getattr__(self, name):
        java = self.__dict__.get("java")
        if java is None:
            raise AttributeError(name)
        return getattr(java, name)


class _DashboardDelegate(dynamic_proxy(UniversalFragmentDelegate)):
    def __init__(self, session: _DashboardSession):
        super().__init__()
        self.session = session

    def beforeCreateView(self):
        return None

    def afterCreateView(self, view: Any) -> Any:
        session = self.session
        plugin = session.plugin
        try:
            return plugin.build_dashboard_view(session)
        except Exception as error:
            plugin.log(f"dashboard createView failed: {error}")
            return plugin.build_dashboard_fallback(session)

    def fillItems(self, items, adapter):
        pass

    def getTitle(self):
        return "Cashier"

    def onBackPressed(self):
        return None

    def onClick(self, item, view, position, x, y):
        pass

    def onFragmentCreate(self):
        pass

    def onFragmentDestroy(self):
        self.session.plugin.on_dashboard_destroyed(self.session)

    def onLongClick(self, item, view, position, x, y):
        return False

    def onMenuItemClick(self, item_id):
        if int(item_id) == SYNC_MENU_ITEM_ID:
            session = self.session
            session.plugin.trigger_ripple(session.views.get("refresh_item"))
            session.plugin.request_sync(force=True)


class CashierPlugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self._alive = False
        self._lock = threading.RLock()
        self._delegate: Optional[_StarsDelegate] = None
        self._account_delegate: Optional[_AccountSwitchDelegate] = None
        self._notif_account: Optional[int] = None
        self._store_ready = False
        self._store: Dict[str, Any] = dict(_EMPTY_STORE)
        self._account = 0
        self._dashboard: Optional[_DashboardSession] = None
        self._press_listener: Optional[_PressScaleListener] = None
        self._period = PERIOD_MONTH
        self._month_offset = 0
        self._year_offset = 0
        self._syncing = False
        self._sync_events = 0
        self._sync_watchdog: Optional[threading.Timer] = None
        self._sync_timer: Optional[threading.Timer] = None
        self._save_timer: Optional[threading.Timer] = None
        self._form_cache: Dict[int, int] = {}
        self._last_live_seq = 0
        self._launch_activity_cls = None

    def on_plugin_load(self):
        self._alive = True
        self._account = self.current_account()
        self.register()
        run_on_queue(self.store_load)
        self.log("Cashier loaded")

    def on_plugin_unload(self):
        self._alive = False
        self.cancel_timer("_sync_timer")
        self.cancel_timer("_save_timer")
        self.cancel_timer("_sync_watchdog")
        self.close_dashboard()
        self.unregister()
        self.store_save()
        self.log("Cashier unloaded")

    def cancel_timer(self, attr: str) -> None:
        timer = getattr(self, attr, None)
        setattr(self, attr, None)
        if timer is not None:
            try:
                timer.cancel()
            except Exception:
                pass

    def register(self) -> None:
        self._delegate = _StarsDelegate(self)
        self._account_delegate = _AccountSwitchDelegate(self)
        try:
            NotificationCenter.getGlobalInstance().addObserver(
                self._account_delegate, NotificationCenter.activeAccountChanged
            )
        except Exception as error:
            self.log(f"account switch observer failed: {error}")
        self.bind_notification_observer(self._account)

        self.add_hook("TL_messages_sendPaidReaction")
        self.add_hook("TL_payments_sendStarsForm")
        self.add_hook("TL_payments_getPaymentForm")
        self.add_on_send_message_hook()

        self.drawer_menu_id = self.add_menu_item(
            MenuItemData(
                menu_type=MenuItemType.DRAWER_MENU,
                text="Cashier",
                icon="msg_fave",
                on_click=self.open_from_context,
                item_id="cashier_dashboard",
                priority=60,
            )
        )

    def unregister(self) -> None:
        account_delegate = self._account_delegate
        self._account_delegate = None
        if account_delegate is not None:
            try:
                NotificationCenter.getGlobalInstance().removeObserver(
                    account_delegate, NotificationCenter.activeAccountChanged
                )
            except Exception as error:
                self.log(f"removeObserver (global) failed: {error}")

        delegate = self._delegate
        self._delegate = None
        if delegate is None:
            return
        account = self._notif_account if self._notif_account is not None else self._account
        self._notif_account = None
        try:
            center = NotificationCenter.getInstance(int(account))
        except Exception:
            center = None
        if center is None:
            return
        for event in (NotificationCenter.starTransactionsLoaded, NotificationCenter.starBalanceUpdated):
            try:
                center.removeObserver(delegate, event)
            except Exception as error:
                self.log(f"removeObserver failed: {error}")

    def bind_notification_observer(self, account: int) -> None:
        delegate = self._delegate
        if delegate is None:
            return
        try:
            center = NotificationCenter.getInstance(int(account))
            center.addObserver(delegate, NotificationCenter.starTransactionsLoaded)
            center.addObserver(delegate, NotificationCenter.starBalanceUpdated)
            self._notif_account = int(account)
        except Exception as error:
            self.log(f"bind account observer failed: {error}")

    def unbind_notification_observer(self, account: int) -> None:
        delegate = self._delegate
        if delegate is None:
            return
        try:
            center = NotificationCenter.getInstance(int(account))
            center.removeObserver(delegate, NotificationCenter.starTransactionsLoaded)
            center.removeObserver(delegate, NotificationCenter.starBalanceUpdated)
        except Exception as error:
            self.log(f"unbind account observer failed: {error}")

    def on_active_account_changed(self) -> None:
        if not self._alive:
            return
        try:
            new_account = int(UserConfig.selectedAccount)
        except Exception as error:
            self.log(f"read selectedAccount failed: {error}")
            return
        if new_account < 0 or new_account == self._account:
            return
        self.log(f"active account changed: {self._account} -> {new_account}")
        self.switch_account(new_account)

    def switch_account(self, new_account: int) -> None:
        old_account = self._account
        self.cancel_timer("_sync_timer")
        self.cancel_timer("_sync_watchdog")
        self.cancel_timer("_save_timer")
        self._syncing = False
        self._sync_events = 0
        self._period = PERIOD_MONTH
        self._month_offset = 0
        self._year_offset = 0
        with self._lock:
            self._form_cache.clear()
            self._store_ready = False
            self._store = dict(_EMPTY_STORE)

        self._account = new_account
        if old_account != new_account:
            self.unbind_notification_observer(old_account)
            self.bind_notification_observer(new_account)

        self.close_dashboard()
        run_on_queue(self.store_load)
        self.request_sync()

    def current_account(self) -> int:
        try:
            return int(get_user_config().getCurrentAccount())
        except Exception:
            return 0

    def stars_controller(self, account: Optional[int] = None):
        try:
            return StarsController.getInstance(int(self._account if account is None else account))
        except Exception:
            return None

    def bulletin(self, text: str, error: bool = False) -> None:
        try:
            if error:
                BulletinHelper.show_error(text)
            else:
                BulletinHelper.show_info(text)
        except Exception:
            try:
                self.log(text)
            except Exception:
                pass

    def data_path(self, account: int) -> str:
        directory = os.path.join(get_plugins_dir(), DATA_DIR_NAME)
        ensure_dir_exists(directory)
        return os.path.join(directory, f"account_{int(account)}.json")

    def store_load(self) -> None:
        target_account = self._account
        path = self.data_path(target_account)
        store = dict(_EMPTY_STORE)
        try:
            raw = read_file(path)
            if raw:
                parsed = json.loads(str(raw))
                if isinstance(parsed, dict) and int(parsed.get("v", 0)) == STORE_VERSION:
                    store.update(parsed)
        except Exception as error:
            self.log(f"store load failed: {error}")
        with self._lock:
            if self._account != target_account:
                return
            self._store = store
            self._store_ready = True
        self.refresh_dashboard()

    def store_save(self) -> None:
        with self._lock:
            if not self._store_ready:
                return
            snapshot = {
                "v": STORE_VERSION,
                "last_sync": self._store.get("last_sync", 0),
                "balance_last": self._store.get("balance_last", 0),
                "balance_history": self._store.get("balance_history", []),
                "transactions": self._store.get("transactions", []),
            }
            path = self.data_path(self._account)
        try:
            write_file(path, json.dumps(snapshot, ensure_ascii=False, separators=(",", ":")))
        except Exception as error:
            self.log(f"store save failed: {error}")

    def schedule_save(self, delay: float = 2.0) -> None:
        self.cancel_timer("_save_timer")
        if not self._alive:
            return
        self._save_timer = threading.Timer(delay, self.store_save)
        self._save_timer.daemon = True
        self._save_timer.start()

    def on_notification(self, event_id: int, account: int) -> None:
        if event_id == NotificationCenter.starTransactionsLoaded:
            self.on_transactions_loaded(account)
        elif event_id == NotificationCenter.starBalanceUpdated:
            self.on_balance_updated(account)

    def on_balance_updated(self, account: int) -> None:
        if not self._alive or int(account) != self._account:
            return
        controller = self.stars_controller(account)
        if controller is None:
            return
        try:
            balance = int(controller.balance.amount)
        except Exception:
            return
        with self._lock:
            if not self._store_ready or balance == int(self._store.get("balance_last", 0)):
                return
            history = self._store.setdefault("balance_history", [])
            history.append([int(time.time()), balance])
            if len(history) > BALANCE_HISTORY_MAX:
                del history[: len(history) - BALANCE_HISTORY_MAX]
            self._store["balance_last"] = balance
        self.schedule_save()
        self.refresh_dashboard()

    def on_transactions_loaded(self, account: int) -> None:
        if not self._alive or int(account) != self._account:
            return
        controller = self.stars_controller(account)
        if controller is None:
            return
        try:
            snapshot = to_py_list(controller.transactions[ALL_TRANSACTIONS])
            fully = bool(controller.didFullyLoadTransactions(ALL_TRANSACTIONS))
        except Exception as error:
            self.log(f"tx read failed: {error}")
            return

        if not self._syncing:
            run_on_queue(lambda: self.merge_from_snapshot(snapshot, quiet=True, account=account))
            return

        self._sync_events += 1
        if fully or self._sync_events >= MAX_SYNC_EVENTS:
            self.finish_sync(snapshot, account)
        else:
            self.update_sync_progress(len(snapshot))
            try:
                controller.loadTransactions(ALL_TRANSACTIONS)
            except Exception as error:
                self.log(f"page load failed: {error}")
                self.finish_sync(snapshot, account)

    def update_sync_progress(self, loaded: int) -> None:
        session = self._dashboard
        if not self._alive or session is None or session.destroyed:
            return

        def _do():
            if not self._alive or self._dashboard is not session or session.destroyed:
                return
            try:
                session.getActionBar().setSubtitle(f"Синхронизация… {loaded} операций")
            except Exception:
                pass

        run_on_ui_thread(_do)

    def finish_sync(self, snapshot: List[Any], account: int) -> None:
        self._syncing = False
        self.cancel_timer("_sync_watchdog")
        run_on_queue(lambda: self.merge_from_snapshot(snapshot, quiet=False, account=account))

    def request_sync(self, force: bool = False) -> None:
        if not self._alive:
            return
        if not force and not self.get_setting(SETTING_AUTO_SYNC, True):
            return
        self.cancel_timer("_sync_timer")
        if force:
            run_on_ui_thread(self.begin_sync)
        else:
            self._sync_timer = threading.Timer(
                SYNC_DEBOUNCE_SECONDS, lambda: run_on_ui_thread(self.begin_sync)
            )
            self._sync_timer.daemon = True
            self._sync_timer.start()

    def begin_sync(self) -> None:
        if not self._alive or self._syncing:
            return
        controller = self.stars_controller()
        if controller is None:
            self.bulletin("Stars сейчас недоступны — попробуйте чуть позже", error=True)
            return
        self._syncing = True
        self._sync_events = 0
        try:
            if not controller.balanceAvailable():
                controller.getBalance()
            controller.invalidateTransactions(True)
        except Exception as error:
            self._syncing = False
            self.log(f"sync start failed: {error}")
            self.bulletin("Не получилось запустить синхронизацию", error=True)
            return
        watchdog = threading.Timer(
            SYNC_WATCHDOG_SECONDS,
            lambda: run_on_ui_thread(self.on_sync_watchdog),
        )
        watchdog.daemon = True
        self._sync_watchdog = watchdog
        watchdog.start()
        self.refresh_dashboard()

    def on_sync_watchdog(self) -> None:
        if not self._syncing:
            return
        controller = self.stars_controller()
        snapshot: List[Any] = []
        if controller is not None:
            try:
                snapshot = to_py_list(controller.transactions[ALL_TRANSACTIONS])
            except Exception:
                snapshot = []
        self.finish_sync(snapshot, self._account)

    def merge_from_snapshot(self, snapshot: List[Any], quiet: bool, account: int) -> None:
        try:
            with self._lock:
                if not self._store_ready or int(account) != self._account:
                    self.log("merge skipped: store not ready or account changed")
                    return
            parsed = []
            for tx in snapshot:
                record = self.extract_transaction(tx)
                if record is not None:
                    parsed.append(record)
            added = self.merge_records(parsed)
            with self._lock:
                self._store["last_sync"] = int(time.time())
            self.store_save()
            if not quiet:
                total = 0
                with self._lock:
                    total = len(self._store.get("transactions", []))
                self.bulletin(f"Готово: всего операций {total}, новых — {added}")
        except Exception as error:
            self.log(f"merge failed: {error}")
        self.refresh_dashboard()

    def extract_transaction(self, tx: Any) -> Optional[Dict[str, Any]]:
        try:
            amount_obj = getattr(tx, "amount", None)
            if amount_obj is None:
                return None
            amount = int(getattr(amount_obj, "amount", 0) or 0)
            if amount == 0:
                return None
            date = int(getattr(tx, "date", 0) or 0)
            if date <= 0:
                return None
            tx_id = getattr(tx, "id", None)
            tx_id = str(tx_id) if tx_id else f"tx_{date}_{amount}"

            peer = getattr(tx, "peer", None)
            peer_kind = ""
            peer_id = 0
            if peer is not None:
                try:
                    peer_kind = str(peer.getClass().getSimpleName())
                except Exception:
                    peer_kind = ""
                raw_peer = getattr(peer, "peer", None)
                if raw_peer is not None:
                    user_id = int(getattr(raw_peer, "user_id", 0) or 0)
                    channel_id = int(getattr(raw_peer, "channel_id", 0) or 0)
                    chat_id = int(getattr(raw_peer, "chat_id", 0) or 0)
                    if user_id:
                        peer_id = user_id
                    elif channel_id:
                        peer_id = -channel_id
                    elif chat_id:
                        peer_id = -chat_id

            flags = {name: bool(getattr(tx, name, False)) for name in _FLAG_NAMES}
            flags["extended_media"] = bool(to_py_list(getattr(tx, "extended_media", None)))
            flags["stargift"] = getattr(tx, "stargift", None) is not None
            title = getattr(tx, "title", None)
            description = getattr(tx, "description", None)
            return {
                "id": tx_id,
                "date": date,
                "amount": amount,
                "cat": category_of(flags, peer_kind, amount),
                "title": str(title) if title else "",
                "desc": str(description) if description else "",
                "peer_id": peer_id,
                "peer_kind": peer_kind,
                "refund": bool(getattr(tx, "refund", False)),
                "pending": bool(getattr(tx, "pending", False)),
                "src": "history",
            }
        except Exception as error:
            self.log(f"tx extract failed: {error}")
            return None

    def merge_records(self, parsed: List[Dict[str, Any]]) -> int:
        added = 0
        with self._lock:
            existing = {record["id"]: record for record in self._store.get("transactions", [])}
            for record in parsed:
                if record["id"] not in existing:
                    added += 1
                existing[record["id"]] = record

            records = list(existing.values())
            history_records = [record for record in records if record.get("src") != "live"]
            kept = []
            for record in records:
                if record.get("src") == "live" and self.history_confirms_day(history_records, record):
                    continue
                kept.append(record)
            kept.sort(key=lambda item: int(item.get("date", 0)), reverse=True)
            if len(kept) > MAX_RECORDS:
                del kept[MAX_RECORDS:]
            self._store["transactions"] = kept
        return added

    @staticmethod
    def history_confirms_day(history_records: List[Dict[str, Any]], live: Dict[str, Any]) -> bool:
        category = live.get("cat")
        day = live.get("day", "")
        if not day:
            return False
        for record in history_records:
            if record.get("cat") != category or int(record.get("amount", 0)) >= 0:
                continue
            if day_key_of(int(record.get("date", 0))) == day:
                return True
        return False

    def pre_request_hook(self, request_name, account, request):
        try:
            if not self._alive or int(account) != self._account:
                return HookResult()
            if request_name == "TL_messages_sendPaidReaction":
                self.on_live_paid_reaction(request)
            elif request_name == "TL_payments_sendStarsForm":
                self.on_live_stars_form(request)
        except Exception as error:
            self.log(f"pre_request_hook error: {error}")
        return HookResult()

    def post_request_hook(self, request_name, account, response, error):
        try:
            if (
                self._alive
                and int(account) == self._account
                and request_name == "TL_payments_getPaymentForm"
                and response is not None
            ):
                self.cache_form_amount(response)
        except Exception as error:
            self.log(f"post_request_hook error: {error}")
        return HookResult()

    def on_send_message_hook(self, account, params):
        try:
            if self._alive and int(account) == self._account and params is not None:
                pay_stars = int(getattr(params, "payStars", 0) or 0)
                if pay_stars > 0:
                    self.record_live(CAT_PAID_MESSAGE, pay_stars, "Платное сообщение")
        except Exception as error:
            self.log(f"on_send_message_hook error: {error}")
        return HookResult()

    def on_live_paid_reaction(self, request: Any) -> None:
        count = int(getattr(request, "count", 0) or 0)
        if count > 0:
            self.record_live(CAT_REACTION, count, "Платная реакция")

    def on_live_stars_form(self, request: Any) -> None:
        invoice = getattr(request, "invoice", None)
        if invoice is None:
            self.request_sync()
            return
        try:
            kind = str(invoice.getClass().getSimpleName())
        except Exception:
            kind = ""
        if "StarGiftResale" in kind or "StarGiftAuctionBid" in kind:
            category = CAT_GIFT_MARKET
        elif "StarGift" in kind:
            category = CAT_GIFT
        elif "PremiumGiftCode" in kind:
            category = CAT_PREMIUM
        else:
            category = CAT_OTHER

        amount = 0
        try:
            form_id = int(getattr(request, "form_id", 0) or 0)
            with self._lock:
                amount = int(self._form_cache.pop(form_id, 0))
        except Exception:
            amount = 0
        if amount > 0:
            self.record_live(category, amount, CATEGORY_LABELS.get(category, "Покупка"))
        else:
            self.request_sync()

    def cache_form_amount(self, form: Any) -> None:
        form_id = int(getattr(form, "form_id", 0) or 0)
        if form_id <= 0:
            return
        invoice = getattr(form, "invoice", None)
        if invoice is None:
            return
        if str(getattr(invoice, "currency", "") or "").upper() != "XTR":
            return
        total = 0
        for price in to_py_list(getattr(invoice, "prices", None)):
            try:
                total += int(getattr(price, "amount", 0) or 0)
            except Exception:
                pass
        if total <= 0:
            return
        with self._lock:
            self._form_cache[form_id] = total
            if len(self._form_cache) > _FORM_CACHE_MAX:
                for key in list(self._form_cache.keys())[: len(self._form_cache) - _FORM_CACHE_MAX]:
                    self._form_cache.pop(key, None)

    def record_live(self, category: str, stars: int, title: str) -> None:
        if not self.get_setting(SETTING_LIVE_TRACKING, True):
            return
        now = int(time.time())
        key = day_key_of(now)
        with self._lock:
            if not self._store_ready:
                return
            transactions = self._store.setdefault("transactions", [])
            bucket = None
            for record in transactions:
                if record.get("src") == "live" and record.get("cat") == category and record.get("day") == key:
                    bucket = record
                    break
            if bucket is not None:
                bucket["amount"] = int(bucket.get("amount", 0)) - int(stars)
                bucket["date"] = now
                bucket["desc"] = title
            else:
                self._last_live_seq += 1
                transactions.insert(
                    0,
                    {
                        "id": f"live_{now * 1000}_{self._last_live_seq}",
                        "date": now,
                        "amount": -int(stars),
                        "cat": category,
                        "title": "",
                        "desc": title,
                        "peer_id": 0,
                        "peer_kind": "",
                        "refund": False,
                        "pending": True,
                        "src": "live",
                        "day": key,
                    },
                )
            if len(transactions) > MAX_RECORDS:
                del transactions[MAX_RECORDS:]
        self.schedule_save()
        self.request_sync()
        self.refresh_dashboard()

    def stats_for_current_period(self) -> Dict[str, Any]:
        today = datetime.now()
        if self._period == PERIOD_YEAR:
            return self.year_stats(today.year + self._year_offset)
        if self._period == PERIOD_ALL:
            return self.all_time_stats()
        year, month = shift_month(today.year, today.month, self._month_offset)
        return self.month_stats(year, month)

    @staticmethod
    def top_category(cat_totals: Dict[str, int]) -> Optional[str]:
        if not cat_totals:
            return None
        return max(cat_totals.items(), key=lambda item: item[1])[0]

    def month_stats(self, year: int, month: int) -> Dict[str, Any]:
        start, end, days = month_range(year, month)
        with self._lock:
            records = list(self._store.get("transactions", []))
        spend = 0
        income = 0
        per_cat: Dict[str, int] = {}
        daily = [0.0] * days
        day_count = [0] * days
        day_cat: List[Dict[str, int]] = [dict() for _ in range(days)]
        biggest: Optional[Dict[str, Any]] = None
        month_records: List[Dict[str, Any]] = []
        for record in records:
            date = int(record.get("date", 0))
            if date < start or date >= end:
                continue
            amount = int(record.get("amount", 0))
            month_records.append(record)
            if amount < 0:
                value = -amount
                spend += value
                category = record.get("cat", CAT_OTHER)
                per_cat[category] = per_cat.get(category, 0) + value
                day_index = datetime.fromtimestamp(date).day - 1
                if 0 <= day_index < days:
                    daily[day_index] += value
                    day_count[day_index] += 1
                    day_cat[day_index][category] = day_cat[day_index].get(category, 0) + value
                if biggest is None or value > -int(biggest.get("amount", 0)):
                    biggest = record
            else:
                income += amount
        per_cat_list = sorted(per_cat.items(), key=lambda item: item[1], reverse=True)
        bucket_meta = [
            {
                "label": f"{index + 1} {MONTHS_RU_SHORT[month - 1]}",
                "spend": daily[index],
                "count": day_count[index],
                "top_cat": self.top_category(day_cat[index]),
            }
            for index in range(days)
        ]
        return {
            "spend": spend,
            "income": income,
            "per_cat": per_cat_list,
            "bucket_meta": bucket_meta,
            "count": len(month_records),
            "biggest": biggest,
            "records": month_records,
            "period_title": fmt_month_title(year, month),
            "axis_start": "1",
            "axis_end": str(days),
        }

    def year_stats(self, year: int) -> Dict[str, Any]:
        start = datetime(year, 1, 1).timestamp()
        end = datetime(year + 1, 1, 1).timestamp()
        with self._lock:
            records = list(self._store.get("transactions", []))
        spend = 0
        income = 0
        per_cat: Dict[str, int] = {}
        monthly = [0.0] * 12
        month_count = [0] * 12
        month_cat: List[Dict[str, int]] = [dict() for _ in range(12)]
        biggest: Optional[Dict[str, Any]] = None
        year_records: List[Dict[str, Any]] = []
        for record in records:
            date = int(record.get("date", 0))
            if date < start or date >= end:
                continue
            amount = int(record.get("amount", 0))
            year_records.append(record)
            if amount < 0:
                value = -amount
                spend += value
                category = record.get("cat", CAT_OTHER)
                per_cat[category] = per_cat.get(category, 0) + value
                m_index = datetime.fromtimestamp(date).month - 1
                monthly[m_index] += value
                month_count[m_index] += 1
                month_cat[m_index][category] = month_cat[m_index].get(category, 0) + value
                if biggest is None or value > -int(biggest.get("amount", 0)):
                    biggest = record
            else:
                income += amount
        per_cat_list = sorted(per_cat.items(), key=lambda item: item[1], reverse=True)
        bucket_meta = [
            {
                "label": f"{MONTHS_RU[index]} {year}",
                "spend": monthly[index],
                "count": month_count[index],
                "top_cat": self.top_category(month_cat[index]),
            }
            for index in range(12)
        ]
        year_records.sort(key=lambda item: int(item.get("date", 0)), reverse=True)
        return {
            "spend": spend,
            "income": income,
            "per_cat": per_cat_list,
            "bucket_meta": bucket_meta,
            "count": len(year_records),
            "biggest": biggest,
            "records": year_records,
            "period_title": str(year),
            "axis_start": MONTHS_RU_SHORT[0],
            "axis_end": MONTHS_RU_SHORT[11],
        }

    def all_time_stats(self) -> Dict[str, Any]:
        with self._lock:
            records = list(self._store.get("transactions", []))
        dated = [record for record in records if int(record.get("date", 0)) > 0]
        empty = {
            "spend": 0,
            "income": 0,
            "per_cat": [],
            "bucket_meta": [],
            "count": 0,
            "biggest": None,
            "records": [],
            "period_title": "Всё время",
            "axis_start": "",
            "axis_end": "",
        }
        if not dated:
            return empty

        min_date = min(int(record["date"]) for record in dated)
        max_date = max(int(record["date"]) for record in dated)
        start_dt = datetime.fromtimestamp(min_date)
        end_dt = datetime.fromtimestamp(max_date)
        span_months = (end_dt.year - start_dt.year) * 12 + (end_dt.month - start_dt.month) + 1
        by_year = span_months > ALL_TIME_YEARLY_THRESHOLD_MONTHS

        bucket_keys: List[Any] = []
        if by_year:
            bucket_keys = list(range(start_dt.year, end_dt.year + 1))
        else:
            y, m = start_dt.year, start_dt.month
            while (y, m) <= (end_dt.year, end_dt.month):
                bucket_keys.append((y, m))
                y, m = shift_month(y, m, 1)

        index_of = {key: index for index, key in enumerate(bucket_keys)}
        n = len(bucket_keys)
        values = [0.0] * n
        counts = [0] * n
        cats: List[Dict[str, int]] = [dict() for _ in range(n)]

        spend = 0
        income = 0
        per_cat: Dict[str, int] = {}
        biggest: Optional[Dict[str, Any]] = None
        for record in dated:
            amount = int(record.get("amount", 0))
            if amount >= 0:
                income += amount
                continue
            value = -amount
            spend += value
            category = record.get("cat", CAT_OTHER)
            per_cat[category] = per_cat.get(category, 0) + value
            if biggest is None or value > -int(biggest.get("amount", 0)):
                biggest = record
            dt = datetime.fromtimestamp(int(record["date"]))
            key = dt.year if by_year else (dt.year, dt.month)
            idx = index_of.get(key)
            if idx is not None:
                values[idx] += value
                counts[idx] += 1
                cats[idx][category] = cats[idx].get(category, 0) + value

        per_cat_list = sorted(per_cat.items(), key=lambda item: item[1], reverse=True)
        bucket_meta = []
        for index, key in enumerate(bucket_keys):
            bucket_label = str(key) if by_year else f"{MONTHS_RU[key[1] - 1]} {key[0]}"
            bucket_meta.append(
                {
                    "label": bucket_label,
                    "spend": values[index],
                    "count": counts[index],
                    "top_cat": self.top_category(cats[index]),
                }
            )

        records_sorted = sorted(dated, key=lambda item: int(item.get("date", 0)), reverse=True)
        return {
            "spend": spend,
            "income": income,
            "per_cat": per_cat_list,
            "bucket_meta": bucket_meta,
            "count": len(records_sorted),
            "biggest": biggest,
            "records": records_sorted,
            "period_title": "Всё время",
            "axis_start": bucket_meta[0]["label"] if bucket_meta else "",
            "axis_end": bucket_meta[-1]["label"] if bucket_meta else "",
        }

    def last_balance_value(self) -> int:
        try:
            controller = self.stars_controller()
            if controller is not None:
                return int(controller.balance.amount)
        except Exception:
            pass
        with self._lock:
            return int(self._store.get("balance_last", 0))

    def open_from_context(self, context_data: Any = None) -> None:
        fragment = context_data.get("fragment") if isinstance(context_data, dict) else None
        if fragment is None:
            fragment = get_last_fragment()
        if fragment is None:
            self.bulletin("Не получилось найти открытый экран Telegram", error=True)
            return
        try:
            self.open_dashboard(fragment)
        except Exception as error:
            self.log(f"open dashboard failed: {error}")
            self.bulletin("Не получилось открыть Cashier", error=True)

    def open_dashboard(self, parent_fragment: Any) -> None:
        if not self._alive:
            return
        self.close_dashboard()

        self._period = PERIOD_MONTH
        self._month_offset = 0
        self._year_offset = 0
        session = _DashboardSession(self)
        delegate = _DashboardDelegate(session)
        session.delegate = delegate
        session.java = UniversalFragmentClass(delegate)
        self._dashboard = session
        parent_fragment.presentFragment(session.java)
        self.request_sync(force=True)

    def on_dashboard_destroyed(self, session: "_DashboardSession") -> None:
        self.dismiss_period_popup(session)
        session.destroyed = True
        session.container = None
        if self._dashboard is session:
            self._dashboard = None

    def close_dashboard(self) -> None:
        session = self._dashboard
        self._dashboard = None
        if session is not None and not session.destroyed:
            try:
                session.finishFragment()
            except Exception:
                pass

    def refresh_dashboard(self) -> None:
        session = self._dashboard
        if not self._alive or session is None or session.destroyed or session.container is None:
            return

        def rebuild():
            if self._alive and self._dashboard is session and not session.destroyed and session.container is not None:
                try:
                    self.rebuild_dashboard_content(session)
                except Exception as error:
                    self.log(f"dashboard rebuild failed: {error}")

        run_on_ui_thread(rebuild)

    def press_scale_listener(self) -> "_PressScaleListener":
        if self._press_listener is None:
            self._press_listener = _PressScaleListener()
        return self._press_listener

    def resolve_launch_activity(self) -> Optional[Any]:
        if self._launch_activity_cls is None:
            try:
                self._launch_activity_cls = jclass("org.telegram.ui.LaunchActivity")
            except Exception as error:
                self.log(f"LaunchActivity resolve failed: {error}")
        return self._launch_activity_cls

    def trigger_ripple(self, view: Any, intensity: float = 1.0) -> None:
        if view is None or not self.get_setting(SETTING_RIPPLE_EFFECT, True):
            return

        def _do():
            try:
                coords = view.getLocationOnScreen()
                if coords and len(coords) >= 2:
                    w = float(view.getWidth() or 0)
                    h = float(view.getHeight() or 0)
                    x = float(coords[0]) + w / 2.0
                    y = float(coords[1]) + h / 2.0
                    launch_activity = self.resolve_launch_activity()
                    if launch_activity is not None:
                        launch_activity.makeRipple(x, y, float(intensity))
            except Exception as error:
                self.log(f"ripple invoke failed: {error}")
            try:
                view.performHapticFeedback(HapticFeedbackConstants.KEYBOARD_TAP)
            except Exception:
                pass

        run_on_ui_thread(_do)

    def on_period_tab_click(self, period: str, view: Any) -> None:
        self.trigger_ripple(view)
        self.on_period_change(period)

    def on_period_shift_click(self, delta: int, view: Any) -> None:
        self.trigger_ripple(view)
        self.on_period_shift(delta)

    def build_dashboard_fallback(self, session: "_DashboardSession") -> View:
        context = session.getParentActivity()
        view = TextView(context)
        view.setGravity(Gravity.CENTER)
        view.setPadding(dp(24), dp(24), dp(24), dp(24))
        view.setText("Не получилось открыть Cashier.\nПопробуйте перезайти в раздел ещё раз.")
        return view

    def build_dashboard_view(self, session: "_DashboardSession") -> View:
        context = session.getParentActivity()
        provider = get_resources_provider(session)
        session.provider = provider

        action_bar = session.getActionBar()
        action_bar.setBackButtonImage(TelegramR.drawable.ic_ab_back)
        action_bar.setTitle("Cashier")
        menu = action_bar.createMenu()
        refresh_item = menu.addItemWithWidth(
            SYNC_MENU_ITEM_ID, TelegramR.drawable.msg_retry, dp(56), "Обновить"
        )
        session.views["refresh_item"] = refresh_item

        background = theme_color(Theme.key_windowBackgroundWhite, provider)
        root = FrameLayout(context)
        call_int_color(root, "setBackgroundColor", background)

        scroll = ScrollView(context)
        scroll.setVerticalScrollBarEnabled(False)
        scroll.setFillViewport(True)
        container = LinearLayout(context)
        container.setOrientation(LinearLayout.VERTICAL)
        call_int_color(container, "setBackgroundColor", background)
        scroll.addView(
            container,
            LinearLayout.LayoutParams(
                LinearLayout.LayoutParams.MATCH_PARENT,
                LinearLayout.LayoutParams.WRAP_CONTENT,
            ),
        )
        root.addView(scroll, FrameLayout.LayoutParams(FrameLayout.LayoutParams.MATCH_PARENT, FrameLayout.LayoutParams.MATCH_PARENT))

        session.container = container
        self.rebuild_dashboard_content(session)
        return root

    def sync_refresh_animation(self, refresh_item: Any) -> None:
        try:
            if self._syncing:
                if refresh_item.getAnimation() is None:
                    rotation = RotateAnimation(
                        0.0,
                        360.0,
                        RotateAnimation.RELATIVE_TO_SELF,
                        0.5,
                        RotateAnimation.RELATIVE_TO_SELF,
                        0.5,
                    )
                    rotation.setDuration(1000)
                    rotation.setRepeatCount(RotateAnimation.INFINITE)
                    rotation.setInterpolator(LinearInterpolator())
                    refresh_item.startAnimation(rotation)
            elif refresh_item.getAnimation() is not None:
                refresh_item.clearAnimation()
        except Exception:
            pass

    def rebuild_dashboard_content(self, session: "_DashboardSession") -> None:
        container = session.container
        if container is None:
            return
        provider = session.provider
        context = container.getContext()
        container.removeAllViews()

        action_bar = session.getActionBar()
        action_bar.setSubtitle("Синхронизация…" if self._syncing else self.sync_status_text())
        refresh_item = session.views.get("refresh_item")
        if refresh_item is not None:
            self.sync_refresh_animation(refresh_item)

        text_black = theme_color(Theme.key_windowBackgroundWhiteBlackText, provider)
        text_gray = theme_color(Theme.key_windowBackgroundWhiteGrayText2, provider)
        text_gray3 = theme_color(Theme.key_windowBackgroundWhiteGrayText3, provider)
        accent = theme_color(Theme.key_windowBackgroundWhiteValueText, provider)
        red = theme_color(Theme.key_text_RedRegular, provider)
        green = theme_color(Theme.key_windowBackgroundWhiteGreenText, provider)
        divider = theme_color(Theme.key_divider, provider)

        stats = self.stats_for_current_period()
        palette = self.category_palette(len(CATEGORY_ORDER), provider)

        tabs_row = LinearLayout(context)
        tabs_row.setOrientation(LinearLayout.HORIZONTAL)
        tabs_row.setPadding(dp(18), dp(2), dp(18), dp(2))
        for period_key in PERIOD_ORDER:
            active = period_key == self._period
            tab = label(
                context,
                PERIOD_LABELS[period_key],
                13,
                accent if active else text_gray3,
                bold=active,
                gravity=Gravity.CENTER,
            )
            tab.setPadding(dp(4), dp(8), dp(4), dp(8))
            apply_ripple(tab, provider)
            tab.setOnTouchListener(self.press_scale_listener())
            tab.setOnClickListener(OnClickListener(lambda _view=None, p=period_key, v=tab: self.on_period_tab_click(p, v)))
            tabs_row.addView(tab, LinearLayout.LayoutParams(0, LinearLayout.LayoutParams.WRAP_CONTENT, 1.0))
        container.addView(tabs_row, LinearLayout.LayoutParams(-1, LinearLayout.LayoutParams.WRAP_CONTENT))

        nav_row = LinearLayout(context)
        nav_row.setOrientation(LinearLayout.HORIZONTAL)
        nav_row.setGravity(Gravity.CENTER)
        if self._period == PERIOD_ALL:
            nav_row.addView(
                label(context, stats["period_title"], 17, text_black, bold=True, gravity=Gravity.CENTER),
                LinearLayout.LayoutParams(0, LinearLayout.LayoutParams.WRAP_CONTENT, 1.0),
            )
        else:
            can_next = (self._month_offset if self._period == PERIOD_MONTH else self._year_offset) < 0
            prev_arrow = label(context, "‹", 22, accent, bold=True, gravity=Gravity.CENTER)
            prev_arrow.setPadding(dp(20), dp(8), dp(20), dp(8))
            apply_ripple(prev_arrow, provider)
            prev_arrow.setOnTouchListener(self.press_scale_listener())
            prev_arrow.setOnClickListener(OnClickListener(lambda _view=None, v=prev_arrow: self.on_period_shift_click(-1, v)))
            next_arrow = label(
                context, "›", 22, accent if can_next else text_gray3, bold=True, gravity=Gravity.CENTER
            )
            next_arrow.setPadding(dp(20), dp(8), dp(20), dp(8))
            apply_ripple(next_arrow, provider)
            if can_next:
                next_arrow.setOnTouchListener(self.press_scale_listener())
                next_arrow.setOnClickListener(OnClickListener(lambda _view=None, v=next_arrow: self.on_period_shift_click(1, v)))
            nav_row.addView(prev_arrow)
            nav_row.addView(
                label(context, stats["period_title"], 17, text_black, bold=True, gravity=Gravity.CENTER),
                LinearLayout.LayoutParams(0, LinearLayout.LayoutParams.WRAP_CONTENT, 1.0),
            )
            nav_row.addView(next_arrow)
        container.addView(nav_row, LinearLayout.LayoutParams(-1, dp(44)))

        card = LinearLayout(context)
        card.setOrientation(LinearLayout.VERTICAL)
        card.setPadding(dp(18), dp(8), dp(18), dp(12))
        total_text = fmt_thousands(stats["spend"]) + " ⭐"
        total_label = label(
            context,
            total_text,
            26,
            red if stats["spend"] > 0 else text_black,
            bold=True,
        )
        set_text_with_stars(total_label, total_text)
        card.addView(total_label)
        period_word = {
            PERIOD_MONTH: "месяц",
            PERIOD_YEAR: "год",
            PERIOD_ALL: "всё время",
        }[self._period]
        op_word = ru_plural(stats["count"], "операция", "операции", "операций")
        sub_parts = [f"Расходы за {period_word} · {stats['count']} {op_word}"]
        if self.get_setting(SETTING_SHOW_INCOME, True) and stats["income"] > 0:
            sub_parts.append("доходы: " + fmt_amount(stats["income"]) + " ⭐")
        sub_parts.append("баланс: " + fmt_thousands(self.last_balance_value()) + " ⭐")
        sub_text = " · ".join(sub_parts)
        sub_label = label(context, sub_text, 13, text_gray)
        set_text_with_stars(sub_label, sub_text)
        card.addView(sub_label)
        if stats["biggest"] is not None:
            big = stats["biggest"]
            big_cat_label = CATEGORY_LABELS.get(big.get("cat", CAT_OTHER), "Прочее")
            big_text = f"Крупнейшая трата: {fmt_thousands(-int(big['amount']))} ⭐ — {big_cat_label}"
            big_label = label(context, big_text, 13, text_gray3)
            set_text_with_stars(big_label, big_text)
            card.addView(big_label)
        container.addView(card)

        chart_title = label(context, "Распределение трат", 15, text_black, bold=True)
        chart_title.setPadding(dp(18), dp(4), dp(18), dp(2))
        container.addView(chart_title)

        per_cat = stats["per_cat"]
        if per_cat and stats["spend"] > 0:
            segments: List = []
            top_count = min(6, len(per_cat))
            for index in range(top_count):
                segments.append((per_cat[index][1], palette[index % len(palette)]))
            rest = sum(value for _cat, value in per_cat[top_count:])
            if rest > 0:
                segments.append((rest, palette[top_count % len(palette)]))

            segment_holder = LinearLayout(context)
            segment_holder.setOrientation(LinearLayout.VERTICAL)
            segment_holder.setPadding(dp(18), dp(6), dp(18), dp(2))
            segment_holder.addView(
                build_segment_bar(context, segments, provider),
                LinearLayout.LayoutParams(-1, dp(14)),
            )
            top_category, top_value = per_cat[0]
            top_share = int(round(100.0 * top_value / stats["spend"]))
            segment_holder.addView(
                label(
                    context,
                    f"{CATEGORY_LABELS.get(top_category, 'Прочее')} · {top_share}%",
                    13,
                    text_gray,
                    gravity=Gravity.CENTER,
                )
            )
            container.addView(
                segment_holder, LinearLayout.LayoutParams(-1, LinearLayout.LayoutParams.WRAP_CONTENT)
            )

        if per_cat:
            legend = LinearLayout(context)
            legend.setOrientation(LinearLayout.VERTICAL)
            legend.setPadding(dp(18), dp(6), dp(18), dp(6))
            for index, (category, value) in enumerate(per_cat[:6]):
                row = LinearLayout(context)
                row.setOrientation(LinearLayout.HORIZONTAL)
                row.setGravity(Gravity.CENTER_VERTICAL)
                row.addView(dot_view(context, palette[index % len(palette)], 10.0))
                row.addView(
                    label(context, "  " + CATEGORY_LABELS.get(category, "Прочее"), 14, text_black),
                    LinearLayout.LayoutParams(0, LinearLayout.LayoutParams.WRAP_CONTENT, 1.0),
                )
                share = int(round(100.0 * value / stats["spend"])) if stats["spend"] else 0
                value_text = f"{fmt_thousands(value)} ⭐ · {share}%"
                value_label = label(context, value_text, 14, text_gray)
                set_text_with_stars(value_label, value_text)
                row.addView(value_label)
                legend.addView(row, LinearLayout.LayoutParams(-1, dp(30)))
            container.addView(legend)
        else:
            empty_texts = {
                PERIOD_MONTH: "В этом месяце вы ничего не потратили",
                PERIOD_YEAR: "В этом году вы ничего не потратили",
                PERIOD_ALL: "Трат пока не было",
            }
            empty_line = label(
                context, empty_texts[self._period], 13, text_gray3, gravity=Gravity.CENTER
            )
            container.addView(empty_line, LinearLayout.LayoutParams(-1, dp(30)))

        add_divider(container, divider, top_dp=10)

        bucket_meta = stats["bucket_meta"]
        by_year_buckets = self._period == PERIOD_ALL and bucket_meta and " " not in bucket_meta[0]["label"]
        chart_titles = {
            PERIOD_MONTH: "Траты по дням",
            PERIOD_YEAR: "Траты по месяцам",
            PERIOD_ALL: "Траты по годам" if by_year_buckets else "Траты по месяцам",
        }
        bars_title = label(context, chart_titles[self._period], 15, text_black, bold=True)
        bars_title.setPadding(dp(18), dp(4), dp(18), dp(2))
        container.addView(bars_title)
        bucket_values = [item["spend"] for item in bucket_meta]
        max_value = max(bucket_values) if bucket_values else 0.0
        if max_value > 0:
            max_index = bucket_values.index(max_value)
            max_text = f"макс. {fmt_thousands(int(max_value))} ⭐ · {bucket_meta[max_index]['label']}"
            max_label = label(context, max_text, 12, text_gray3)
            max_label.setPadding(dp(18), 0, dp(18), 0)
            set_text_with_stars(max_label, max_text)
            container.addView(max_label)

        self.dismiss_period_popup(session)
        bar_refs: List[Dict[str, Any]] = []
        bars_holder = LinearLayout(context)
        bars_holder.setOrientation(LinearLayout.VERTICAL)
        bars_holder.setPadding(dp(14), dp(4), dp(14), 0)
        bars_holder.addView(
            build_period_bars(
                context,
                bucket_meta,
                provider,
                stats["axis_start"],
                stats["axis_end"],
                bar_refs,
                lambda index: self.on_bucket_tap(session, index),
            ),
            LinearLayout.LayoutParams(-1, LinearLayout.LayoutParams.WRAP_CONTENT),
        )
        container.addView(bars_holder, LinearLayout.LayoutParams(-1, LinearLayout.LayoutParams.WRAP_CONTENT))

        hint = label(
            context, "Нажмите на столбик, чтобы увидеть детали", 11, text_gray3, gravity=Gravity.CENTER
        )
        hint.setPadding(dp(18), dp(6), dp(18), 0)
        container.addView(hint)

        session.views["period_bar_refs"] = bar_refs
        session.views["period_bucket_meta"] = bucket_meta
        session.views["period_bar_accent"] = accent
        session.views["period_bar_baseline"] = theme_color(Theme.key_divider, provider)
        session.views["period_bar_highlight"] = red
        session.views["period_selected"] = None
        session.views["period_popup"] = None

        add_divider(container, divider, top_dp=10)

        recent_title = label(context, "Последние операции", 15, text_black, bold=True)
        recent_title.setPadding(dp(18), dp(4), dp(18), dp(2))
        container.addView(recent_title)

        records = stats["records"]
        if not records:
            empty = label(
                context,
                "Операций пока нет.\nОткройте раздел Stars в Telegram или нажмите на значок обновления вверху.",
                13,
                text_gray3,
                gravity=Gravity.CENTER,
            )
            empty.setPadding(dp(18), dp(18), dp(18), dp(24))
            container.addView(empty)
        else:
            shown = 0
            for record in records:
                if shown >= 30:
                    break
                self.add_transaction_row(
                    container, record, palette, text_black, text_gray3, red, green, divider
                )
                shown += 1
            if len(records) > shown:
                rest = len(records) - shown
                rest_word = ru_plural(rest, "операция", "операции", "операций")
                period_suffix = {
                    PERIOD_MONTH: "в этом месяце",
                    PERIOD_YEAR: "в этом году",
                    PERIOD_ALL: "за всё время",
                }[self._period]
                more = label(
                    context,
                    f"…и ещё {rest} {rest_word} {period_suffix}",
                    13,
                    text_gray3,
                    gravity=Gravity.CENTER,
                )
                more.setPadding(0, dp(10), 0, dp(18))
                container.addView(more)
            else:
                spacer = View(context)
                container.addView(spacer, LinearLayout.LayoutParams(-1, dp(12)))

    def sync_status_text(self) -> str:
        with self._lock:
            last_sync = int(self._store.get("last_sync", 0))
            total = len(self._store.get("transactions", []))
        if last_sync <= 0:
            return "Ещё не синхронизировались — нажмите на значок обновления"
        stamp = datetime.fromtimestamp(last_sync).strftime("%d.%m %H:%M")
        return f"Обновлено {stamp} · операций: {total}"

    def on_period_change(self, period: str) -> None:
        if period == self._period:
            return
        self._period = period
        self.refresh_dashboard()

    def on_period_shift(self, delta: int) -> None:
        today = datetime.now()
        if self._period == PERIOD_YEAR:
            new_offset = self._year_offset + delta
            if today.year + new_offset > today.year:
                return
            self._year_offset = new_offset
            self.refresh_dashboard()
            return
        year, month = shift_month(today.year, today.month, self._month_offset + delta)
        if (year, month) > (today.year, today.month):
            return
        self._month_offset += delta
        self.refresh_dashboard()

    def on_bucket_tap(self, session: "_DashboardSession", index: int) -> None:
        bar_refs = session.views.get("period_bar_refs") or []
        bucket_meta = session.views.get("period_bucket_meta") or []
        if index < 0 or index >= len(bar_refs) or index >= len(bucket_meta):
            return
        self.trigger_ripple(bar_refs[index]["column"])
        accent = session.views.get("period_bar_accent")
        baseline = session.views.get("period_bar_baseline")
        highlight = session.views.get("period_bar_highlight")
        selected = session.views.get("period_selected")

        if selected is not None and 0 <= selected < len(bar_refs) and selected != index:
            self.set_bar_selected(bar_refs[selected], accent, baseline, False)

        if selected == index:
            self.set_bar_selected(bar_refs[index], accent, baseline, False)
            session.views["period_selected"] = None
            self.dismiss_period_popup(session)
            return

        ref = bar_refs[index]
        self.set_bar_selected(ref, accent, highlight, True)
        session.views["period_selected"] = index
        self.show_period_tooltip(session, ref["column"], bucket_meta[index])

    @staticmethod
    def set_bar_selected(ref: Dict[str, Any], accent: int, highlight_or_baseline: int, selected: bool) -> None:
        try:
            if selected and ref["positive"]:
                call_int_color(ref["drawable"], "setColor", highlight_or_baseline)
            elif not selected:
                call_int_color(ref["drawable"], "setColor", accent if ref["positive"] else highlight_or_baseline)
        except Exception:
            pass
        try:
            ref["view"].animate().translationY(dp(-3) if selected else 0.0).setDuration(180).setInterpolator(
                OvershootInterpolator(1.6) if selected else DecelerateInterpolator()
            ).start()
        except Exception:
            pass

    def dismiss_period_popup(self, session: "_DashboardSession") -> None:
        popup = session.views.get("period_popup")
        session.views["period_popup"] = None
        if popup is not None:
            try:
                popup.dismiss()
            except Exception:
                pass

    def show_period_tooltip(self, session: "_DashboardSession", anchor_view: Any, meta: Dict[str, Any]) -> None:
        self.dismiss_period_popup(session)
        try:
            context = anchor_view.getContext()
            provider = session.provider
            background = theme_color(Theme.key_windowBackgroundWhite, provider)
            text_black = theme_color(Theme.key_windowBackgroundWhiteBlackText, provider)
            text_gray = theme_color(Theme.key_windowBackgroundWhiteGrayText2, provider)

            card = LinearLayout(context)
            card.setOrientation(LinearLayout.VERTICAL)
            card.setPadding(dp(12), dp(9), dp(12), dp(9))
            card.setBackground(Theme.createRoundRectDrawable(dp(12), background))
            try:
                card.setElevation(dp(6))
            except Exception:
                pass

            card.addView(label(context, meta["label"], 13, text_black, bold=True))

            spend = int(meta.get("spend", 0))
            if spend > 0:
                count = int(meta.get("count", 0))
                op_word = ru_plural(count, "операция", "операции", "операций")
                text = f"{fmt_thousands(spend)} ⭐ · {count} {op_word}"
                top_cat = meta.get("top_cat")
                if top_cat:
                    text += "\n" + CATEGORY_LABELS.get(top_cat, "Прочее")
            else:
                text = "Трат не было"
            sub = label(context, text, 12, text_gray)
            sub.setPadding(0, dp(3), 0, 0)
            set_text_with_stars(sub, text)
            card.addView(sub)

            popup = PopupWindow(card, FrameLayout.LayoutParams.WRAP_CONTENT, FrameLayout.LayoutParams.WRAP_CONTENT, False)
            popup.setOutsideTouchable(True)
            popup.setBackgroundDrawable(ColorDrawable(0))

            card.measure(
                View.MeasureSpec.makeMeasureSpec(0, View.MeasureSpec.UNSPECIFIED),
                View.MeasureSpec.makeMeasureSpec(0, View.MeasureSpec.UNSPECIFIED),
            )
            popup_w = card.getMeasuredWidth()
            popup_h = card.getMeasuredHeight()

            card.setAlpha(0.0)
            card.setPivotY(float(popup_h))
            card.setScaleY(0.85)

            anchor_w = anchor_view.getWidth()
            anchor_h = anchor_view.getHeight()
            try:
                screen_w = int(AndroidUtilities.displaySize.x)
            except Exception:
                screen_w = 0

            coords = anchor_view.getLocationOnScreen()
            anchor_left = int(coords[0]) if coords and len(coords) > 0 else 0

            margin = dp(8)
            desired_left = anchor_left + anchor_w // 2 - popup_w // 2
            if screen_w > 0:
                desired_left = max(margin, min(desired_left, screen_w - popup_w - margin))
            x_offset = desired_left - anchor_left
            y_offset = -(anchor_h + popup_h + dp(6))

            popup.showAsDropDown(anchor_view, x_offset, y_offset)
            card.animate().alpha(1.0).scaleY(1.0).setDuration(150).setInterpolator(DecelerateInterpolator()).start()
            session.views["period_popup"] = popup
        except Exception as error:
            self.log(f"tooltip show failed: {error}")

    def add_transaction_row(
        self,
        container: Any,
        record: Dict[str, Any],
        palette: List[int],
        text_black: int,
        text_gray3: int,
        red: int,
        green: int,
        divider: int,
    ) -> None:
        context = container.getContext()
        row = LinearLayout(context)
        row.setOrientation(LinearLayout.HORIZONTAL)
        row.setGravity(Gravity.CENTER_VERTICAL)
        row.setPadding(0, dp(8), 0, dp(8))
        row.addView(dot_view(context, category_color(record.get("cat", CAT_OTHER), palette), 9.0))

        labels = LinearLayout(context)
        labels.setOrientation(LinearLayout.VERTICAL)
        labels.setPadding(dp(10), 0, dp(8), 0)
        category_label = CATEGORY_LABELS.get(record.get("cat", CAT_OTHER), "Прочее")
        title = label(context, category_label, 14, text_black, bold=True)
        title.setSingleLine(True)
        title.setEllipsize(TextUtils.TruncateAt.END)
        labels.addView(title, LinearLayout.LayoutParams(-1, LinearLayout.LayoutParams.WRAP_CONTENT))

        subtitle = self.peer_display(record)
        if record.get("pending"):
            subtitle = (subtitle + " · ожидание").strip(" ·") if subtitle else "ожидание"
        if subtitle:
            sub = label(context, subtitle[:80], 12, text_gray3)
            sub.setSingleLine(True)
            sub.setEllipsize(TextUtils.TruncateAt.END)
            labels.addView(sub, LinearLayout.LayoutParams(-1, LinearLayout.LayoutParams.WRAP_CONTENT))
        row.addView(labels, LinearLayout.LayoutParams(0, LinearLayout.LayoutParams.WRAP_CONTENT, 1.0))

        right = LinearLayout(context)
        right.setOrientation(LinearLayout.VERTICAL)
        right.setGravity(Gravity.RIGHT)
        amount = int(record.get("amount", 0))
        amount_color = green if amount > 0 else red
        amount_text = fmt_amount(amount) + " ⭐"
        amount_label = label(
            context, amount_text, 14, amount_color, bold=True, gravity=Gravity.RIGHT
        )
        set_text_with_stars(amount_label, amount_text)
        right.addView(amount_label)
        right.addView(
            label(
                context,
                datetime.fromtimestamp(int(record.get("date", 0))).strftime("%d.%m %H:%M"),
                11,
                text_gray3,
                gravity=Gravity.RIGHT,
            )
        )
        row.addView(
            right,
            LinearLayout.LayoutParams(
                LinearLayout.LayoutParams.WRAP_CONTENT, LinearLayout.LayoutParams.WRAP_CONTENT
            ),
        )

        holder = LinearLayout(context)
        holder.setOrientation(LinearLayout.VERTICAL)
        holder.setPadding(dp(18), 0, dp(18), 0)
        holder.addView(row, LinearLayout.LayoutParams(-1, LinearLayout.LayoutParams.WRAP_CONTENT))
        line = View(context)
        call_int_color(line, "setBackgroundColor", divider)
        holder.addView(line, LinearLayout.LayoutParams(-1, dp(1)))
        container.addView(holder, LinearLayout.LayoutParams(-1, LinearLayout.LayoutParams.WRAP_CONTENT))

    def category_palette(self, count: int, provider: Any) -> List[int]:
        base = theme_color(Theme.key_starsGradient1, provider)
        hsv = jarray(jfloat)([0.0, 0.0, 0.0])
        Color.colorToHSV(as_java_color(base), hsv)
        hue = float(hsv[0])
        sat = float(hsv[1])
        val = float(hsv[2])
        colors: List[int] = []
        for index in range(max(1, int(count))):
            new_hue = (hue + index * 42.0) % 360.0
            new_sat = min(1.0, max(0.42, sat + 0.04 * index))
            new_val = max(0.52, min(1.0, val - 0.05 * index))
            colors.append(
                as_java_color(int(Color.HSVToColor(jarray(jfloat)([new_hue, new_sat, new_val]))))
            )
        return colors

    def peer_display(self, record: Dict[str, Any]) -> str:
        kind = record.get("peer_kind", "")
        if kind in PEER_KIND_LABELS:
            return PEER_KIND_LABELS[kind]
        peer_id = int(record.get("peer_id", 0))
        if peer_id != 0:
            try:
                controller = get_messages_controller()
                if peer_id > 0:
                    user = controller.getUser(peer_id)
                    if user is not None:
                        name = " ".join(
                            part
                            for part in (
                                str(getattr(user, "first_name", "") or ""),
                                str(getattr(user, "last_name", "") or ""),
                            )
                            if part
                        )
                        return name or "Пользователь"
                else:
                    chat = controller.getChat(-peer_id)
                    if chat is not None:
                        return str(getattr(chat, "title", "") or "Канал")
            except Exception:
                pass
        desc = record.get("desc", "")
        if desc:
            return desc
        title = record.get("title", "")
        if title:
            return title
        return ""

    def create_settings(self) -> List[Any]:
        from ui.settings import Divider, Header, Switch, Text

        return [
            Header(text="Cashier"),
            Text(
                text="Открыть Cashier",
                subtext="Панель статистики: графики, история операций и баланс",
                icon="msg_fave",
                on_click=lambda *args, **kwargs: self.open_from_context(),
            ),
            Switch(
                key=SETTING_LIVE_TRACKING,
                text="Учитывать траты сразу",
                default=True,
                subtext="не ждём синхронизацию: реакция, сообщение или покупка появятся в списке мгновенно",
                icon="msg_settings",
                on_change=self.on_setting_changed,
            ),
            Switch(
                key=SETTING_AUTO_SYNC,
                text="Обновляться автоматически",
                default=True,
                subtext="как только меняется баланс или проходит трата, история подтягивается сама",
                on_change=self.on_setting_changed,
            ),
            Switch(
                key=SETTING_SHOW_INCOME,
                text="Показывать доходы",
                default=True,
                subtext="добавить в карточку месяца возвраты, пополнения и доход с рекламы",
                on_change=self.on_setting_changed,
            ),
            Switch(
                key=SETTING_RIPPLE_EFFECT,
                text="Ripple-эффект на кнопках",
                default=True,
                subtext="волна и вибрация при переключении периода, тапе по графику и обновлении",
                icon="msg_brightness_high",
                on_change=self.on_setting_changed,
            ),
            Text(
                text="Синхронизировать сейчас",
                subtext="полностью перезагрузить историю операций из Telegram",
                on_click=lambda *args, **kwargs: self.request_sync(force=True),
            ),
            Text(
                text="Очистить статистику",
                subtext="удалить всю сохранённую историю на этом устройстве",
                icon="msg_block",
                red=True,
                on_click=lambda *args, **kwargs: self.confirm_clear(),
            ),
            Divider(),
        ]

    def on_setting_changed(self, _value=None) -> None:
        pass

    def confirm_clear(self) -> None:
        try:
            fragment = get_last_fragment()
            if fragment is None:
                self.clear_data()
                return
            context = fragment.getContext()
            provider = fragment.getResourceProvider()
            builder = (
                AlertDialogBuilder(context, AlertDialogBuilder.ALERT_TYPE_MESSAGE, provider)
                if provider is not None
                else AlertDialogBuilder(context, AlertDialogBuilder.ALERT_TYPE_MESSAGE)
            )
            builder.set_title("Очистить статистику?")
            builder.set_message(
                "Вся сохранённая история операций на этом устройстве удалится безвозвратно. "
                "В самом Telegram ничего не изменится — при желании историю можно будет загрузить заново."
            )
            builder.set_positive_button("Очистить", lambda b, _which: self.clear_data())
            builder.set_negative_button("Отмена", lambda b, _which: b.dismiss())
            builder.show()
        except Exception as error:
            self.log(f"confirm clear failed: {error}")
            self.clear_data()

    def clear_data(self) -> None:
        with self._lock:
            self._store = dict(_EMPTY_STORE)
            self._store_ready = True
            self._form_cache.clear()
        self.store_save()
        self.refresh_dashboard()
        self.bulletin("Статистика очищена")