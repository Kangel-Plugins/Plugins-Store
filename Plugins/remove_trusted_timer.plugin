from java import dynamic_proxy
from java.lang import Runnable
from android.os import Handler, Looper

from base_plugin import BasePlugin, MethodHook

__id__ = "remove_trusted_timer"
__name__ = "Remove Trusted Timer"
__description__ = "Плагин , позволяющий пропустить 30 секундный таймер не траст плагинов"
__author__ = "@ArThirtyFour | @KangelPlugins"
__version__ = "1.0.0"
__icon__ = "bwaaa_pack/83"
__app_version__ = ">=12.10.0"


class _SetTimerHook(MethodHook):
    def before_hooked_method(self, param):
        param.setResult(None)


class _IsTimerActiveHook(MethodHook):
    def before_hooked_method(self, param):
        param.setResult(False)


class RemoveTrustedTimer(BasePlugin):

    def on_plugin_load(self):
        self.log("Loaded")
        self._install_hooks()

    def on_plugin_unload(self):
        self.log("Unloaded")

    def _install_hooks(self):
        try:
            from java.lang import Class
            ButtonWithCounterView = Class.forName("org.telegram.ui.Stories.recorder.ButtonWithCounterView")
            self.hook_all_methods(ButtonWithCounterView, "setTimer", _SetTimerHook())
            self.hook_all_methods(ButtonWithCounterView, "isTimerActive", _IsTimerActiveHook())
        except Exception as e:
            self.log(f"Failed to hook ButtonWithCounterView: {e}")
