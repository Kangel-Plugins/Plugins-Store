import sys
import os
import platform
import traceback

from base_plugin import BasePlugin, HookResult, HookStrategy
from client_utils import run_on_queue, send_text
from android_utils import log

__id__ = "sdk_check"
__name__ = "SDK Check"
__description__ = "Показывает информацию об SDK устройства и Chaquopy Python SDK по команде .sdk"
__author__ = "@plugins_borbehr"
__version__ = "1.0.4"
__min_version__ = "11.9.0"
__icon__ = "exteraDevPack_by_borbehr/0"

SIGNATURE = "\n\n— SDK Check • @plugins_borbehr"


def _safe(fn, default="н/д"):
    try:
        return fn()
    except Exception:
        return default


def _get_build_and_version():
    """
    Пытаемся получить android.os.Build / android.os.Build.VERSION двумя способами:
    прямой import и, как фолбэк, через Chaquopy jclass.
    """
    try:
        from android.os import Build as _Build
        return _Build, _Build.VERSION
    except Exception:
        pass
    try:
        from java import jclass
        Build = jclass("android.os.Build")
        Version = jclass("android.os.Build$VERSION")
        return Build, Version
    except Exception:
        return None, None


def _get_app_context():
    try:
        from java import jclass
        AppLoader = jclass("org.telegram.messenger.ApplicationLoader")
        return AppLoader.applicationContext
    except Exception:
        return None


def _get_data_dir():
    ctx = _get_app_context()
    if ctx is None:
        return None
    return _safe(lambda: str(ctx.getApplicationInfo().dataDir), None)


def _read_text_file(path, max_len=300):
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as f:
            return f.read(max_len).strip()
    except Exception:
        return None


def _list_dir(path, limit=50):
    try:
        return sorted(os.listdir(path))[:limit]
    except Exception:
        return []


def _dump_prefs_keys(ctx, prefs_name, limit=60):
    """Возвращает список 'ключ = значение' из указанного SharedPreferences-файла."""
    out = []
    try:
        prefs = ctx.getSharedPreferences(prefs_name, 0)  # MODE_PRIVATE
        all_entries = prefs.getAll()
        keys = list(all_entries.keySet())
        for k in keys[:limit]:
            k_str = str(k)
            try:
                v = all_entries.get(k)
            except Exception:
                v = "?"
            out.append(f"{k_str} = {v}")
    except Exception:
        pass
    return out


def _get_chaquopy_sdk_info():
    """
    Реальное расположение версии Python SDK (Chaquopy-движка), найденное
    через .sdk raw:
      files/chaquopy/currentSdk           — текстовый файл/симлинк с текущей версией
      files/chaquopy/.currentSdkFromApk   — версия, зашитая в apk
      files/chaquopy/plugins-sdk/         — папка(и) с установленными SDK (имя = версия)
      shared_prefs/chaquopy.xml           — сама конфигурация Chaquopy
    """
    info = {}
    data_dir = _get_data_dir()
    if not data_dir:
        return info

    chaquopy_dir = os.path.join(data_dir, "files", "chaquopy")
    sdk_dir = os.path.join(chaquopy_dir, "plugins-sdk")

    info["sdk_version_file"] = _safe(
        lambda: _read_text_file(os.path.join(sdk_dir, "v.txt")), None
    )
    info["plugins_sdk_dirs"] = _safe(lambda: _list_dir(sdk_dir), [])

    ctx = _get_app_context()
    if ctx is not None:
        info["chaquopy_prefs"] = _safe(lambda: _dump_prefs_keys(ctx, "chaquopy"), [])
    else:
        info["chaquopy_prefs"] = []

    return info


def _scan_fs_for_python_sdk(root, max_hits=200, max_visited=6000):
    hits = []
    if not root or not os.path.isdir(root):
        return hits
    visited = 0
    for dirpath, dirnames, filenames in os.walk(root):
        visited += 1
        if visited > max_visited or len(hits) >= max_hits:
            break
        for name in dirnames + filenames:
            low = name.lower()
            if "python" in low or "sdk" in low:
                hits.append(os.path.join(dirpath, name))
                if len(hits) >= max_hits:
                    break
    return hits


def _list_shared_prefs_files():
    ctx = _get_app_context()
    if ctx is None:
        return []
    data_dir = _get_data_dir()
    if not data_dir:
        return []
    try:
        prefs_dir = os.path.join(data_dir, "shared_prefs")
        if os.path.isdir(prefs_dir):
            return sorted(os.listdir(prefs_dir))
    except Exception:
        pass
    return []


def build_raw_dump():
    """EXPERIMENTAL диагностический дамп — оставлен для дальнейшей отладки."""
    lines = ["🔎 SDK RAW DUMP (EXPERIMENTAL)", ""]

    ctx = _get_app_context()
    if ctx is None:
        lines.append("Не удалось получить applicationContext.")
        return "\n".join(lines) + SIGNATURE

    data_dir = _get_data_dir()
    lines.append(f"dataDir: {data_dir}")

    prefs_files = _safe(_list_shared_prefs_files, [])
    lines.append("")
    lines.append(f"Файлы shared_prefs ({len(prefs_files)}):")
    for f in prefs_files[:60]:
        lines.append(f"• {f}")

    lines.append("")
    lines.append("Ключи из подходящих по имени prefs-файлов:")
    found_any = False
    for f in prefs_files:
        name_no_ext = f[:-4] if f.endswith(".xml") else f
        low = name_no_ext.lower()
        if any(tag in low for tag in ("plugin", "python", "sdk", "config", "chaquopy")):
            entries = _dump_prefs_keys(ctx, name_no_ext, limit=40)
            for e in entries:
                lines.append(f"• {name_no_ext}.{e}")
                found_any = True
    if not found_any:
        lines.append("• ничего не нашлось в подходящих по имени файлах")

    lines.append("")
    lines.append("Файлы/папки с 'python' или 'sdk' в пути (первые 40):")
    fs_hits = _safe(lambda: _scan_fs_for_python_sdk(data_dir), [])
    if fs_hits:
        for p in fs_hits[:40]:
            lines.append(f"• {p}")
    else:
        lines.append("• не найдено")

    return "\n".join(lines) + SIGNATURE


ANDROID_CODENAMES = {
    21: "Lollipop", 22: "Lollipop", 23: "Marshmallow", 24: "Nougat", 25: "Nougat",
    26: "Oreo", 27: "Oreo", 28: "Pie", 29: "Q (10)", 30: "R (11)", 31: "S (12)",
    32: "S_V2 (12L)", 33: "Tiramisu (13)", 34: "UpsideDownCake (14)",
    35: "VanillaIceCream (15)", 36: "Baklava (16)",
}


def build_sdk_report():
    lines = ["📦 SDK CHECK", ""]

    Build, Version = _get_build_and_version()

    if Build is not None and Version is not None:
        sdk_int = _safe(lambda: int(Version.SDK_INT))
        release = _safe(lambda: str(Version.RELEASE))
        codename = ANDROID_CODENAMES.get(sdk_int, "неизвестно") if isinstance(sdk_int, int) else "н/д"
        manufacturer = _safe(lambda: str(Build.MANUFACTURER))
        model = _safe(lambda: str(Build.MODEL))
        brand = _safe(lambda: str(Build.BRAND))
        device = _safe(lambda: str(Build.DEVICE))
        hardware = _safe(lambda: str(Build.HARDWARE))
        abis = _safe(lambda: ", ".join(list(Build.SUPPORTED_ABIS)))

        lines.append("Android:")
        lines.append(f"• API level (SDK_INT): {sdk_int}")
        lines.append(f"• Версия Android: {release} ({codename})")
        lines.append(f"• Устройство: {manufacturer} {model} ({brand}/{device})")
        lines.append(f"• HARDWARE: {hardware}")
        lines.append(f"• ABI: {abis}")
    else:
        lines.append("Android: не удалось получить android.os.Build")

    lines.append("")
    lines.append("Python / плагинная среда:")
    lines.append(f"• Python: {sys.version.split()[0]}")
    lines.append(f"• platform: {_safe(lambda: platform.platform())}")
    lines.append(f"• machine: {_safe(lambda: platform.machine())}")

    lib_versions = []
    for mod_name in ("requests", "PIL", "yaml", "lxml", "bs4", "packaging"):
        try:
            mod = __import__(mod_name)
            ver = getattr(mod, "__version__", None)
            if ver is None and mod_name == "PIL":
                from PIL import __version__ as pil_ver
                ver = pil_ver
            lib_versions.append(f"{mod_name}={ver or '?'}")
        except Exception:
            lib_versions.append(f"{mod_name}=—")
    lines.append(f"• Либы: {', '.join(lib_versions)}")

    lines.append("")
    lines.append("Python SDK (Chaquopy):")
    chq = _safe(_get_chaquopy_sdk_info, {})
    version = chq.get("sdk_version_file")
    sdk_dirs = chq.get("plugins_sdk_dirs") or []
    prefs_entries = chq.get("chaquopy_prefs") or []

    if version:
        if "|" in version:
            ver_part, _, extra_part = version.partition("|")
            lines.append(f"• Версия: {ver_part.strip()}")
            if extra_part.strip():
                lines.append(f"• Доп. метка (v.txt): {extra_part.strip()}")
        else:
            lines.append(f"• Версия: {version}")
    if sdk_dirs:
        lines.append(f"• Содержимое plugins-sdk/: {', '.join(sdk_dirs)}")
    if prefs_entries:
        for e in prefs_entries[:15]:
            lines.append(f"• prefs[chaquopy]: {e}")
    if not (version or sdk_dirs or prefs_entries):
        lines.append("• не удалось прочитать (нет доступа к files/chaquopy или прав)")

    return "\n".join(lines) + SIGNATURE


def _handle_sdk_command(peer, mode="normal"):
    try:
        report = build_raw_dump() if mode == "raw" else build_sdk_report()
        send_text(peer, report)
    except Exception:
        err = traceback.format_exc()[-1500:]
        log(f"[SDK Check] error: {err}")
        try:
            send_text(peer, f"⚠️ Ошибка SDK Check:\n{err}")
        except Exception:
            pass


class SdkCheckPlugin(BasePlugin):

    def on_plugin_load(self):
        self.add_on_send_message_hook()
        log("[SDK Check] loaded")

    def on_send_message_hook(self, account: int, params) -> HookResult:
        try:
            text = getattr(params, "message", None)
            if not text:
                return HookResult()

            stripped = text.strip()
            if stripped == ".sdk":
                mode = "normal"
            elif stripped == ".sdk raw":
                mode = "raw"
            else:
                return HookResult()

            peer = getattr(params, "peer", None)
            run_on_queue(lambda: _handle_sdk_command(peer, mode))

            return HookResult(strategy=HookStrategy.CANCEL)
        except Exception:
            log(f"[SDK Check] hook error: {traceback.format_exc()}")
            return HookResult()
