        ]

    def _ensure_gms_vision(self):
        if self.gms_checked:
            return self.gms_detector is not None
        self.gms_checked = True
        try:
            ApplicationLoader = jclass("org.telegram.messenger.ApplicationLoader")
            ctx = ApplicationLoader.applicationContext
            if ctx is None:
                return False
            Builder = jclass("com.google.android.gms.vision.face.FaceDetector$Builder")
            self.FrameBuilder = jclass("com.google.android.gms.vision.Frame$Builder")
            builder = Builder(ctx)
            for name, value in (("setTrackingEnabled", True),
                                ("setLandmarkType", 0),
                                ("setClassificationType", 0),
                                ("setMode", 1),
                                ("setProminentFaceOnly", False)):
                try:
                    setter = getattr(builder, name)
                except AttributeError:
                    self.debug_log(f"GMS Vision: {name} отсутствует, оставлено значение по умолчанию")
                    continue
                setter(value)
            detector = builder.build()
            if detector is not None and bool(detector.isOperational()):
                self.gms_detector = detector
                self.debug_log("Детектор: Google Play Services Vision инициализирован")
                return True
            else:
                if detector is not None:
                    detector.release()
                self.debug_log("GMS Vision не активен (isOperational=False), откат на Android SDK")
                return False
        except Exception as e:
            self.debug_log(f"GMS Vision недоступен, откат на Android SDK: {e}")
            return False

    def _hook_send_video(self):
        helper_cls = find_class("org.telegram.messenger.SendMessagesHelper")
        if helper_cls is None:
            self.debug_log("Не удалось найти SendMessagesHelper")
            return
        unhooks = self.hook_all_methods(helper_cls, "prepareSendingVideo", PrepareVideoHook(self))
        count = len(unhooks) if unhooks else 0
        self.debug_log(f"Установлено хуков на prepareSendingVideo: {count}")

    def detect_faces(self, sw_bitmap):
        Rect = jclass("android.graphics.Rect")
        rects = []
        if self.get_setting("use_gms_vision", True) and self._ensure_gms_vision():
            try:
                frame = self.FrameBuilder().setBitmap(sw_bitmap).build()
                sparse_faces = self.gms_detector.detect(frame)
                for i in range(sparse_faces.size()):
                    face = sparse_faces.valueAt(i)
                    pos = face.getPosition()
                    fw = face.getWidth()
                    fh = face.getHeight()
                    rects.append(Rect(int(pos.x), int(pos.y), int(pos.x + fw), int(pos.y + fh)))
                return rects
            except Exception as gms_err:
                self.debug_log(f"Ошибка GMS Vision при детекции, откат на Android SDK: {gms_err}")
                try:
                    self.gms_detector.release()
                except Exception:
                    pass
                self.gms_detector = None
        Bitmap = jclass("android.graphics.Bitmap")
        Config = jclass("android.graphics.Bitmap$Config")
        Canvas = jclass("android.graphics.Canvas")
        Paint = jclass("android.graphics.Paint")
        AndroidFaceDetector = jclass("android.media.FaceDetector")
        FaceCls = jclass("android.media.FaceDetector$Face")
        PointF = jclass("android.graphics.PointF")
        orig_w = sw_bitmap.getWidth()
        orig_h = sw_bitmap.getHeight()
        if orig_w <= 16 or orig_h <= 16:
            return rects
        target_w = min(320, orig_w)
        target_w = target_w - (target_w % 2)
        scale = orig_w / float(target_w)
        target_h = max(2, int(orig_h / scale))
        scaled = None
        rgb565 = None
        first_android_call = not getattr(self, "android_detector_logged", False)
        try:
            if first_android_call:
                self.debug_log("Детектор Android SDK: подготовка RGB_565 и поиск лиц...")
            scaled = Bitmap.createScaledBitmap(sw_bitmap, target_w, target_h, True)
            rgb565 = Bitmap.createBitmap(target_w, target_h, Config.RGB_565)
            c565 = Canvas(rgb565)
            p565 = Paint(Paint.DITHER_FLAG | Paint.FILTER_BITMAP_FLAG)
            c565.drawBitmap(scaled, 0.0, 0.0, p565)
            max_faces = 5
            detector = AndroidFaceDetector(target_w, target_h, max_faces)
            faces = jarray(FaceCls)(max_faces)
            found = detector.findFaces(rgb565, faces)
            if first_android_call:
                self.debug_log(f"Детектор Android SDK работает, найдено лиц: {found}")
                self.android_detector_logged = True
            mid = PointF()
            for i in range(found):
                faces[i].getMidPoint(mid)
                eye_dist = faces[i].eyesDistance()
                cx = mid.x * scale
                cy = mid.y * scale
                ed = eye_dist * scale
                left = int(cx - ed * 1.7)
                top = int(cy - ed * 2.0)
                right = int(cx + ed * 1.7)
                bottom = int(cy + ed * 2.5)
                rects.append(Rect(left, top, right, bottom))
            return rects
        finally:
            if scaled is not None and scaled != sw_bitmap:
                scaled.recycle()
            if rgb565 is not None:
                rgb565.recycle()

    @staticmethod
    def update_face_mask(cached_rects, hold_until_us, detected, pts_us, hold_us):
        """None = поиск пропущен; [] = детектор подтвердил отсутствие лиц."""
        if detected:
            return detected, pts_us + hold_us
        if detected is not None and pts_us >= hold_until_us:
            return [], 0
        return cached_rects, hold_until_us

    @staticmethod
    def mosaic_dimensions(width, height, strength):
        # 0 — очень мелкие, 1 — мелкие, 2 — крупные, 3 — очень крупные.
        columns = [28, 14, 10, 7][max(0, min(int(strength), 3))]
        # Блок не меньше 2 px: при 1 px мозаика превращается в оригинал
        # и лицо перестаёт скрываться (важно для мелких/далёких лиц).
        cell_size = max(2.0, width / float(columns))
        small_w = max(1, min(width, int(round(width / cell_size))))
        small_h = max(1, int(round(height / cell_size)))
        return small_w, small_h

    # ---------------------------------------------------------
    # Овал ИЗ ПИКСЕЛЕЙ: детектор -> прямоугольник -> сетка блоков,
    # ячейки внутри эллипса = мозаика, снаружи = оригинал.
    # ---------------------------------------------------------
    def blur_faces_on_bitmap(self, src_bitmap, cached_rects, hold_until_us,
                             run_detection, pts_us, hold_us):
        Bitmap = jclass("android.graphics.Bitmap")
        Config = jclass("android.graphics.Bitmap$Config")
        Canvas = jclass("android.graphics.Canvas")
        Paint = jclass("android.graphics.Paint")
        mutable = Bitmap.createBitmap(src_bitmap.getWidth(), src_bitmap.getHeight(), Config.ARGB_8888)
        try:
            tmp_canvas = Canvas(mutable)
            tmp_canvas.drawBitmap(src_bitmap, 0.0, 0.0, None)
            detected = self.detect_faces(mutable) if run_detection else None
            cached_rects, hold_until_us = self.update_face_mask(
                cached_rects, hold_until_us, detected, pts_us, hold_us)
            img_w, img_h = mutable.getWidth(), mutable.getHeight()
            strength = self.get_setting("blur_strength", 0)
            paint = Paint(0)
            paint.setFilterBitmap(False)
            paint.setAntiAlias(False)
            for rect in cached_rects:
                pad_x = int(rect.width() * 0.1)
                pad_y = int(rect.height() * 0.1)
                left = max(0, rect.left - pad_x)
                top = max(0, rect.top - pad_y)
                right = min(img_w, rect.right + pad_x)
                bottom = min(img_h, rect.bottom + pad_y)
                box_w, box_h = right - left, bottom - top
                if box_w <= 4 or box_h <= 4:
                    continue
                face_crop = tiny = masked = blocky = None
                try:
                    face_crop = Bitmap.createBitmap(mutable, left, top, box_w, box_h)
                    small_w, small_h = self.mosaic_dimensions(box_w, box_h, strength)
                    tiny = Bitmap.createScaledBitmap(face_crop, small_w, small_h, True)
                    pixels = jarray(jint)(small_w * small_h)
                    tiny.getPixels(pixels, 0, small_w, 0, 0, small_w, small_h)
                    for cy in range(small_h):
                        ny = (cy + 0.5) / small_h * 2.0 - 1.0
                        for cx in range(small_w):
                            nx = (cx + 0.5) / small_w * 2.0 - 1.0
                            if nx * nx + ny * ny > 1.0:
                                pixels[cy * small_w + cx] = 0  # прозрачный = оригинал
                    masked = Bitmap.createBitmap(pixels, small_w, small_h, Config.ARGB_8888)
                    blocky = Bitmap.createScaledBitmap(masked, box_w, box_h, False)
                    tmp_canvas.drawBitmap(blocky, float(left), float(top), paint)
                finally:
                    if blocky is not None and blocky != masked and blocky != tiny and blocky != face_crop and blocky != mutable:
                        blocky.recycle()
                    if masked is not None and masked != tiny and masked != face_crop and masked != mutable:
                        masked.recycle()
                    if tiny is not None and tiny != face_crop and tiny != mutable:
                        tiny.recycle()
                    if face_crop is not None and face_crop != mutable:
                        face_crop.recycle()
            return mutable, cached_rects, hold_until_us
        except Exception:
            mutable.recycle()
            raise

    def process_round_video(self, input_path, output_path):
        MediaMetadataRetriever = jclass("android.media.MediaMetadataRetriever")
        MediaExtractor = jclass("android.media.MediaExtractor")
        MediaCodec = jclass("android.media.MediaCodec")
        MediaFormat = jclass("android.media.MediaFormat")
        MediaMuxer = jclass("android.media.MediaMuxer")
        OutputFormat = jclass("android.media.MediaMuxer$OutputFormat")
        BufferInfo = jclass("android.media.MediaCodec$BufferInfo")
        CodecCapabilities = jclass("android.media.MediaCodecInfo$CodecCapabilities")
        ByteBuffer = jclass("java.nio.ByteBuffer")
        retriever = MediaMetadataRetriever()
        encoder = None
        input_surface = None
        egl_renderer = None
        muxer = None
        extractor = None
        muxer_started = False
        last_processed = None
        deadline = time.monotonic() + 180.0

        def check_deadline():
            if time.monotonic() >= deadline:
                raise TimeoutError("Обработка кружка превысила 180 секунд")

        try:
            self.debug_log("1/6 Открытие исходного видео...")
            duration_ms = 0
            for _ in range(20):
                try:
                    retriever.setDataSource(input_path)
                    duration_ms = int(retriever.extractMetadata(MediaMetadataRetriever.METADATA_KEY_DURATION) or 0)
                except Exception:
                    duration_ms = 0
                if duration_ms > 0:
                    break
                if os.path.getsize(input_path) < 16384:
                    break
                time.sleep(0.05)
            if duration_ms <= 0:
                self.debug_log("Нулевая длительность видео")
                return None
            self.show_info("Размытие лиц в кружке...")
            probe_frame = retriever.getFrameAtTime(0, MediaMetadataRetriever.OPTION_CLOSEST)
            if probe_frame is None:
                probe_frame = retriever.getFrameAtTime(-1)
            if probe_frame is None:
                self.debug_log("Не удалось извлечь пробный кадр")
                return None
            width = probe_frame.getWidth() - (probe_frame.getWidth() % 2)
            height = probe_frame.getHeight() - (probe_frame.getHeight() % 2)
            probe_frame.recycle()
            if width <= 0 or height <= 0:
                return None
            self.debug_log(f"2/6 Настройка энкодера {width}x{height}, {duration_ms} мс")
            fps = 25
            frame_interval_us = 1_000_000 // fps
            total_duration_us = max(0, (duration_ms - 40) * 1000)
            mime = "video/avc"
            format_out = MediaFormat.createVideoFormat(mime, width, height)
            format_out.setInteger(MediaFormat.KEY_COLOR_FORMAT, CodecCapabilities.COLOR_FormatSurface)
            format_out.setInteger(MediaFormat.KEY_BIT_RATE, 1_800_000)
            format_out.setInteger(MediaFormat.KEY_FRAME_RATE, fps)
            format_out.setInteger(MediaFormat.KEY_I_FRAME_INTERVAL, 1)
            encoder = MediaCodec.createEncoderByType(mime)
            encoder.configure(format_out, None, None, MediaCodec.CONFIGURE_FLAG_ENCODE)
            input_surface = encoder.createInputSurface()
            encoder.start()
            self.debug_log("3/6 Инициализация EGLSurfaceRenderer (VBO)...")
            egl_renderer = EglSurfaceRenderer(input_surface, width, height)
            muxer = MediaMuxer(output_path, OutputFormat.MUXER_OUTPUT_MPEG_4)
            video_track_idx = -1
            audio_track_idx = -1
            extractor = MediaExtractor()
            extractor.setDataSource(input_path)
            src_audio_track = -1
            for i in range(extractor.getTrackCount()):
                track_format = extractor.getTrackFormat(i)
                track_mime = str(track_format.getString(MediaFormat.KEY_MIME))
                if track_mime == "audio/mp4a-latm":
                    try:
                        sample_rate = track_format.getInteger(MediaFormat.KEY_SAMPLE_RATE)
                        channel_count = track_format.getInteger(MediaFormat.KEY_CHANNEL_COUNT)
                        clean_audio_fmt = MediaFormat.createAudioFormat(track_mime, sample_rate, channel_count)
                        if track_format.containsKey("csd-0"):
                            csd0 = track_format.getByteBuffer("csd-0")
                            if csd0 is not None:
                                clean_audio_fmt.setByteBuffer("csd-0", csd0)
                        audio_track_idx = muxer.addTrack(clean_audio_fmt)
                        src_audio_track = i
                        self.debug_log(f"Аудиодорожка добавлена: {sample_rate}Hz, {channel_count}ch")
                    except Exception as aud_err:
                        self.debug_log(f"Пропуск аудиодорожки: {aud_err}")
                        src_audio_track = -1
                    break
            buf_info = BufferInfo()
            pts_us = 0
            frame_idx = 0
            cached_rects = []
            hold_until_us = 0
            hold_idx = max(0, min(int(self.get_setting("face_hold_duration", 2)), 3))
            hold_us = [250_000, 500_000, 1_000_000, 1_500_000][hold_idx]
            total_faces_found = 0

            def drain_encoder(end_of_stream):
                nonlocal video_track_idx, muxer_started
                if end_of_stream:
                    encoder.signalEndOfInputStream()
                idle_deadline = time.monotonic() + 10.0
                while True:
                    check_deadline()
                    if time.monotonic() >= idle_deadline:
                        raise TimeoutError("Кодировщик не завершил видеопоток за 10 секунд")
                    status = encoder.dequeueOutputBuffer(buf_info, 10000)
                    if status == MediaCodec.INFO_TRY_AGAIN_LATER:
                        if not end_of_stream:
                            break
                    elif status == MediaCodec.INFO_OUTPUT_FORMAT_CHANGED:
                        new_format = encoder.getOutputFormat()
                        video_track_idx = muxer.addTrack(new_format)
                        muxer.start()
                        muxer_started = True
                    elif status >= 0:
                        idle_deadline = time.monotonic() + 10.0
                        encoded_data = encoder.getOutputBuffer(status)
                        if (buf_info.flags & MediaCodec.BUFFER_FLAG_CODEC_CONFIG) != 0:
                            buf_info.size = 0
                        if buf_info.size != 0 and muxer_started and encoded_data is not None:
                            encoded_data.position(buf_info.offset)
                            encoded_data.limit(buf_info.offset + buf_info.size)
                            muxer.writeSampleData(video_track_idx, encoded_data, buf_info)
                        encoder.releaseOutputBuffer(status, False)
                        if (buf_info.flags & MediaCodec.BUFFER_FLAG_END_OF_STREAM) != 0:
                            break

            frame_step = [1, 2, 3][max(0, min(int(self.get_setting("frame_step", 1)), 2))]
            self.debug_log(f"4/6 Обработка кадров: каждый {frame_step}-й кадр, поиск лиц...")
            while pts_us <= total_duration_us:
                check_deadline()
                drain_encoder(False)
                if last_processed is None or frame_idx % frame_step == 0:
                    raw_frame = retriever.getFrameAtTime(pts_us, MediaMetadataRetriever.OPTION_CLOSEST)
                    if raw_frame is None and pts_us == 0:
                        raw_frame = retriever.getFrameAtTime(-1)
                    if raw_frame is None:
                        raise RuntimeError(f"Не удалось декодировать кадр {frame_idx}")
                    try:
                        processed_frame, cached_rects, hold_until_us = self.blur_faces_on_bitmap(
                            raw_frame, cached_rects, hold_until_us, True, pts_us, hold_us
                        )
                    finally:
                        raw_frame.recycle()
                    if cached_rects:
                        total_faces_found += len(cached_rects)
                    if last_processed is not None:
                        last_processed.recycle()
                    last_processed = processed_frame
                egl_renderer.draw_bitmap(last_processed, pts_us)
                drain_encoder(False)
                pts_us += frame_interval_us
                frame_idx += 1
                if frame_idx == 1 or frame_idx % 25 == 0:
                    self.debug_log(f"4/6 Кадров готово: {frame_idx}, позиция {pts_us // 1000}/{duration_ms} мс")
            self.debug_log(f"5/6 Завершение видеопотока (кадров: {frame_idx}, срабатываний детектора: {total_faces_found})...")
            drain_encoder(True)
            if src_audio_track >= 0 and muxer_started:
                extractor.selectTrack(src_audio_track)
                audio_buf = ByteBuffer.allocate(256 * 1024)
                audio_info = BufferInfo()
                last_audio_pts = -1
                while True:
                    check_deadline()
                    audio_buf.clear()
                    sample_size = extractor.readSampleData(audio_buf, 0)
                    if sample_size < 0:
                        break
                    sample_time = extractor.getSampleTime()
                    if sample_time < 0 or sample_time < last_audio_pts:
                        extractor.advance()
                        continue
                    last_audio_pts = sample_time
                    audio_info.offset = 0
                    audio_info.size = sample_size
                    audio_info.presentationTimeUs = sample_time
                    audio_info.flags = extractor.getSampleFlags()
                    muxer.writeSampleData(audio_track_idx, audio_buf, audio_info)
                    extractor.advance()
            if not muxer_started or video_track_idx < 0:
                raise RuntimeError("Кодировщик не создал видеодорожку")
            muxer.stop()
            muxer_started = False
            self.debug_log("6/6 Сборка MP4 завершена")
            return (width, height)
        finally:
            if last_processed is not None:
                try:
                    last_processed.recycle()
                except Exception:
                    pass
            try:
                retriever.release()
            except Exception:
                pass
            if extractor is not None:
                try:
                    extractor.release()
                except Exception:
                    pass
            if egl_renderer is not None:
                egl_renderer.release()
            if encoder is not None:
                try:
                    encoder.stop()
                except Exception:
                    pass
                try:
                    encoder.release()
                except Exception:
                    pass
            if input_surface is not None:
                try:
                    input_surface.release()
                except Exception:
                    pass
            if muxer is not None:
                try:
                    if muxer_started:
                        muxer.stop()
                except Exception:
                    pass
                try:
                    muxer.release()
                except Exception:
                    pass