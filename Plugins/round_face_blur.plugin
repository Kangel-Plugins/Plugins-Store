    def _ensure_mlkit_vision(self):
        if self.mlkit_checked:
            return self.mlkit_detector is not None
        self.mlkit_checked = True
        try:
            FaceDetectorOptions = jclass("com.google.mlkit.vision.face.FaceDetectorOptions")
            OptionsBuilder = jclass("com.google.mlkit.vision.face.FaceDetectorOptions$Builder")
            FaceDetection = jclass("com.google.mlkit.vision.face.FaceDetection")
            self.InputImageCls = jclass("com.google.mlkit.vision.common.InputImage")
            self.TasksCls = jclass("com.google.android.gms.tasks.Tasks")
            self.TimeUnitCls = jclass("java.util.concurrent.TimeUnit")
            builder = OptionsBuilder()
            builder.setPerformanceMode(FaceDetectorOptions.PERFORMANCE_MODE_FAST)
            builder.setLandmarkMode(FaceDetectorOptions.LANDMARK_MODE_NONE)
            builder.setClassificationMode(FaceDetectorOptions.CLASSIFICATION_MODE_NONE)
            builder.setMinFaceSize(jfloat(0.1))
            builder.enableTracking()
            detector = FaceDetection.getClient(builder.build())
            if detector is not None:
                self.mlkit_detector = detector
                self.mlkit_failures = 0
                self.debug_log("Детектор: ML Kit Face Detection инициализирован")
                return True
        except Exception as e:
            self.debug_log(f"ML Kit недоступен: {e}")
        return False

    def _ensure_gms_vision(self):
        if self.gms_checked:
            return self.gms_detector is not None
        self.gms_checked = True
        try:
            ApplicationLoader = jclass("org.telegram.messenger.ApplicationLoader")
            ctx = ApplicationLoader.applicationContext
            if ctx is None:
                return False
            Builder = jclass("com.google.android.gms.vision.face.FaceDetector$Builder")
            self.FrameBuilder = jclass("com.google.android.gms.vision.Frame$Builder")
            builder = Builder(ctx)
            for name, value in (
                ("setTrackingEnabled", True),
                ("setLandmarkType", 0),
                ("setClassificationType", 0),
                ("setMode", 1),
                ("setProminentFaceOnly", False),
            ):
                try:
                    setter = getattr(builder, name)
                except AttributeError:
                    continue
                setter(value)
            detector = builder.build()
            if detector is not None and bool(detector.isOperational()):
                self.gms_detector = detector
                self.debug_log("Детектор: Google Play Services Vision инициализирован")
                return True
            if detector is not None:
                detector.release()
            self.debug_log("GMS Vision не активен, откат на Android SDK")
            return False
        except Exception as e:
            self.debug_log(f"GMS Vision недоступен, откат на Android SDK: {e}")
            return False

    def _resolve_java_class(self, class_name):
        try:
            cls = find_class(class_name)
            if cls is not None and hasattr(cls, "getName"):
                return cls
        except Exception:
            pass
        try:
            JavaClassCls = jclass("java.lang.Class")
            cls = JavaClassCls.forName(class_name)
            if cls is not None and hasattr(cls, "getName"):
                return cls
        except Exception:
            pass
        try:
            ApplicationLoader = jclass("org.telegram.messenger.ApplicationLoader")
            ctx = ApplicationLoader.applicationContext
            if ctx is not None:
                cls = ctx.getClassLoader().loadClass(class_name)
                if cls is not None and hasattr(cls, "getName"):
                    return cls
        except Exception:
            pass
        if class_name == "org.telegram.messenger.SendMessagesHelper":
            try:
                helper = get_send_messages_helper()
                if helper is not None:
                    return helper.getClass()
            except Exception:
                pass
        return None

    def _hook_send_video(self):
        helper_cls = self._resolve_java_class("org.telegram.messenger.SendMessagesHelper")
        if helper_cls is None:
            self.debug_log("Не удалось найти java.lang.Class для SendMessagesHelper")
            return
        hook = PrepareVideoHook(self)
        unhooks = []
        try:
            res = self.hook_all_methods(helper_cls, "prepareSendingVideo", hook)
            if res:
                unhooks.extend(res)
        except Exception as err:
            self.debug_log(f"hook_all_methods не сработал ({err}), перебор методов вручную")
            try:
                for method in helper_cls.getDeclaredMethods():
                    if str(method.getName()) == "prepareSendingVideo":
                        handle = self.hook_method(method, hook)
                        if handle is not None:
                            unhooks.append(handle)
            except Exception as inner_err:
                self.debug_log(f"Не удалось установить хук на prepareSendingVideo: {inner_err}")
        if unhooks:
            self.hook_handles.extend(unhooks)
        self.debug_log(f"Установлено хуков на prepareSendingVideo: {len(self.hook_handles)}")

    def detect_faces(self, sw_bitmap, android_state=None):
        Rect = jclass("android.graphics.Rect")
        Bitmap = jclass("android.graphics.Bitmap")
        rects = []
        orig_w = sw_bitmap.getWidth()
        orig_h = sw_bitmap.getHeight()
        if orig_w <= 16 or orig_h <= 16:
            return rects
        target_w = min(320, orig_w)
        target_w = target_w - (target_w % 2)
        scale = orig_w / float(target_w)
        target_h = max(2, int(orig_h / scale))
        scaled = None
        temp_rgb565 = None
        try:
            scaled = (
                Bitmap.createScaledBitmap(sw_bitmap, target_w, target_h, True)
                if target_w != orig_w or target_h != orig_h
                else sw_bitmap
            )
            if self.get_setting("use_gms_vision", True):
                if self._ensure_mlkit_vision():
                    try:
                        image = self.InputImageCls.fromBitmap(scaled, 0)
                        task = self.mlkit_detector.process(image)
                        await_task = getattr(self.TasksCls, "await")
                        timeout_ms = 1000 if self.mlkit_warmed_up else 3000
                        faces_list = await_task(task, jlong(timeout_ms), self.TimeUnitCls.MILLISECONDS)
                        self.mlkit_warmed_up = True
                        self.mlkit_failures = 0
                        count = int(faces_list.size()) if faces_list is not None else 0
                        for i in range(count):
                            box = faces_list.get(i).getBoundingBox()
                            rects.append(
                                Rect(
                                    int(box.left * scale),
                                    int(box.top * scale),
                                    int(box.right * scale),
                                    int(box.bottom * scale),
                                )
                            )
                        return rects
                    except Exception as ml_err:
                        self.mlkit_failures += 1
                        self.debug_log(f"Ошибка ML Kit ({self.mlkit_failures}/3): {ml_err}")
                        if self.mlkit_failures >= 3:
                            try:
                                self.mlkit_detector.close()
                            except Exception:
                                pass
                            self.mlkit_detector = None

                if self._ensure_gms_vision():
                    try:
                        frame = self.FrameBuilder().setBitmap(scaled).build()
                        sparse_faces = self.gms_detector.detect(frame)
                        for i in range(sparse_faces.size()):
                            face = sparse_faces.valueAt(i)
                            pos = face.getPosition()
                            fw = face.getWidth()
                            fh = face.getHeight()
                            rects.append(
                                Rect(
                                    int(pos.x * scale),
                                    int(pos.y * scale),
                                    int((pos.x + fw) * scale),
                                    int((pos.y + fh) * scale),
                                )
                            )
                        return rects
                    except Exception as gms_err:
                        self.debug_log(f"Ошибка GMS Vision при детекции, откат на Android SDK: {gms_err}")
                        try:
                            self.gms_detector.release()
                        except Exception:
                            pass
                        self.gms_detector = None

            Config = jclass("android.graphics.Bitmap$Config")
            Canvas = jclass("android.graphics.Canvas")
            Paint = jclass("android.graphics.Paint")
            AndroidFaceDetector = jclass("android.media.FaceDetector")
            FaceCls = jclass("android.media.FaceDetector$Face")
            PointF = jclass("android.graphics.PointF")
            max_faces = 5
            first_android_call = not getattr(self, "android_detector_logged", False)
            if first_android_call:
                self.debug_log("Детектор Android SDK: подготовка RGB_565 и поиск лиц")

            if android_state is not None:
                if android_state.get("size") != (target_w, target_h):
                    old_bmp = android_state.get("rgb565")
                    if old_bmp is not None:
                        try:
                            old_bmp.recycle()
                        except Exception:
                            pass
                    rgb565 = Bitmap.createBitmap(target_w, target_h, Config.RGB_565)
                    android_state["size"] = (target_w, target_h)
                    android_state["rgb565"] = rgb565
                    android_state["canvas"] = Canvas(rgb565)
                    android_state["paint"] = Paint(Paint.DITHER_FLAG | Paint.FILTER_BITMAP_FLAG)
                    android_state["detector"] = AndroidFaceDetector(target_w, target_h, max_faces)
                    android_state["faces"] = jarray(FaceCls)(max_faces)
                    android_state["mid"] = PointF()
                rgb565 = android_state["rgb565"]
                c565 = android_state["canvas"]
                p565 = android_state["paint"]
                detector = android_state["detector"]
                faces = android_state["faces"]
                mid = android_state["mid"]
            else:
                temp_rgb565 = Bitmap.createBitmap(target_w, target_h, Config.RGB_565)
                rgb565 = temp_rgb565
                c565 = Canvas(rgb565)
                p565 = Paint(Paint.DITHER_FLAG | Paint.FILTER_BITMAP_FLAG)
                detector = AndroidFaceDetector(target_w, target_h, max_faces)
                faces = jarray(FaceCls)(max_faces)
                mid = PointF()

            c565.drawBitmap(scaled, 0.0, 0.0, p565)
            found = detector.findFaces(rgb565, faces)
            if first_android_call:
                self.debug_log(f"Детектор Android SDK работает, найдено лиц: {found}")
                self.android_detector_logged = True
            for i in range(found):
                faces[i].getMidPoint(mid)
                eye_dist = faces[i].eyesDistance()
                cx = mid.x * scale
                cy = mid.y * scale
                ed = eye_dist * scale
                left = int(cx - ed * 1.7)
                top = int(cy - ed * 2.0)
                right = int(cx + ed * 1.7)
                bottom = int(cy + ed * 2.5)
                rects.append(Rect(left, top, right, bottom))
            return rects
        finally:
            if scaled is not None and scaled != sw_bitmap:
                scaled.recycle()
            if temp_rgb565 is not None:
                temp_rgb565.recycle()

    @staticmethod
    def update_face_mask(cached_rects, hold_until_us, detected, pts_us, hold_us):
        if detected:
            return detected, pts_us + hold_us
        if detected is not None and pts_us >= hold_until_us:
            return [], 0
        return cached_rects, hold_until_us

    @staticmethod
    def mosaic_dimensions(width, height, strength):
        columns = [28, 14, 10, 7][max(0, min(int(strength), 3))]
        cell_size = max(2.0, width / float(columns))
        small_w = max(1, min(width, int(round(width / cell_size))))
        small_h = max(1, int(round(height / cell_size)))
        return small_w, small_h

    def apply_pixel_mosaic(self, canvas, target_bitmap, rect, strength, paint):
        Bitmap = jclass("android.graphics.Bitmap")
        Config = jclass("android.graphics.Bitmap$Config")
        Rect = jclass("android.graphics.Rect")
        img_w = target_bitmap.getWidth()
        img_h = target_bitmap.getHeight()
        pad_x = int(rect.width() * 0.16)
        pad_y = int(rect.height() * 0.16)
        left = max(0, rect.left - pad_x)
        top = max(0, rect.top - pad_y)
        right = min(img_w, rect.right + pad_x)
        bottom = min(img_h, rect.bottom + pad_y)
        box_w = right - left
        box_h = bottom - top
        if box_w <= 4 or box_h <= 4:
            return
        face_crop = None
        tiny = None
        masked = None
        try:
            face_crop = Bitmap.createBitmap(target_bitmap, left, top, box_w, box_h)
            small_w, small_h = self.mosaic_dimensions(box_w, box_h, strength)
            tiny = Bitmap.createScaledBitmap(face_crop, small_w, small_h, True)
            total = small_w * small_h
            raw_pixels = jarray(jint)(total)
            tiny.getPixels(raw_pixels, 0, small_w, 0, 0, small_w, small_h)
            py_pixels = list(raw_pixels)

            inner_r2 = 0.72
            outer_r2 = 1.08
            inv_span = 1.0 / (outer_r2 - inner_r2)
            inv_w = 2.0 / float(small_w)
            inv_h = 2.0 / float(small_h)

            for row in range(small_h):
                ny = (row + 0.5) * inv_h - 1.0
                ny2 = ny * ny
                row_offset = row * small_w
                for col in range(small_w):
                    nx = (col + 0.5) * inv_w - 1.0
                    dist_sq = nx * nx + ny2
                    if dist_sq <= inner_r2:
                        continue
                    idx = row_offset + col
                    if dist_sq >= outer_r2:
                        py_pixels[idx] = 0
                    else:
                        t = (outer_r2 - dist_sq) * inv_span
                        alpha = int(255.0 * t * t)
                        if alpha <= 0:
                            py_pixels[idx] = 0
                        else:
                            argb = (alpha << 24) | (py_pixels[idx] & 0x00FFFFFF)
                            if argb >= 0x80000000:
                                argb -= 0x100000000
                            py_pixels[idx] = argb

            masked = Bitmap.createBitmap(small_w, small_h, Config.ARGB_8888)
            masked.setHasAlpha(True)
            masked.setPixels(jarray(jint)(py_pixels), 0, small_w, 0, 0, small_w, small_h)
            canvas.drawBitmap(masked, None, Rect(left, top, right, bottom), paint)
        finally:
            if masked is not None:
                masked.recycle()
            if tiny is not None and tiny != face_crop:
                tiny.recycle()
            if face_crop is not None:
                face_crop.recycle()

    def blur_faces_on_canvas(
        self,
        work_canvas,
        work_bitmap,
        cached_rects,
        hold_until_us,
        run_detection,
        pts_us,
        hold_us,
        strength,
        mosaic_paint,
        android_state=None,
    ):
        detected = self.detect_faces(work_bitmap, android_state) if run_detection else None
        cached_rects, hold_until_us = self.update_face_mask(
            cached_rects, hold_until_us, detected, pts_us, hold_us
        )
        for rect in cached_rects:
            self.apply_pixel_mosaic(work_canvas, work_bitmap, rect, strength, mosaic_paint)
        return cached_rects, hold_until_us

    def process_round_video(self, input_path, output_path):
        MediaMetadataRetriever = jclass("android.media.MediaMetadataRetriever")
        MediaExtractor = jclass("android.media.MediaExtractor")
        MediaCodec = jclass("android.media.MediaCodec")
        MediaFormat = jclass("android.media.MediaFormat")
        MediaMuxer = jclass("android.media.MediaMuxer")
        OutputFormat = jclass("android.media.MediaMuxer$OutputFormat")
        BufferInfo = jclass("android.media.MediaCodec$BufferInfo")
        CodecCapabilities = jclass("android.media.MediaCodecInfo$CodecCapabilities")
        ByteBuffer = jclass("java.nio.ByteBuffer")
        Bitmap = jclass("android.graphics.Bitmap")
        Config = jclass("android.graphics.Bitmap$Config")
        Canvas = jclass("android.graphics.Canvas")
        Paint = jclass("android.graphics.Paint")
        Rect = jclass("android.graphics.Rect")
        BuildVersion = jclass("android.os.Build$VERSION")

        retriever = MediaMetadataRetriever()
        encoder = None
        input_surface = None
        egl_renderer = None
        muxer = None
        extractor = None
        muxer_started = False
        work_bitmap = None
        batch_cache = {}
        android_state = {}
        deadline = time.monotonic() + 180.0

        def check_deadline():
            if time.monotonic() >= deadline:
                raise TimeoutError("Обработка кружка превысила 180 секунд")

        def clear_batch_cache():
            for bmp in batch_cache.values():
                try:
                    if bmp is not None:
                        bmp.recycle()
                except Exception:
                    pass
            batch_cache.clear()

        try:
            self.debug_log("1/6 Открытие исходного видео")
            duration_ms = 0
            for _ in range(20):
                try:
                    retriever.setDataSource(input_path)
                    duration_ms = int(retriever.extractMetadata(MediaMetadataRetriever.METADATA_KEY_DURATION) or 0)
                except Exception:
                    duration_ms = 0
                if duration_ms > 0:
                    break
                if os.path.getsize(input_path) < 16384:
                    break
                time.sleep(0.05)
            if duration_ms <= 0:
                self.debug_log("Нулевая длительность видео")
                return None
            self.show_info("Размытие лиц в кружке...")
            probe_frame = retriever.getFrameAtTime(jlong(0), MediaMetadataRetriever.OPTION_CLOSEST)
            if probe_frame is None:
                probe_frame = retriever.getFrameAtTime(jlong(-1))
            if probe_frame is None:
                self.debug_log("Не удалось извлечь пробный кадр")
                return None
            src_w = probe_frame.getWidth()
            src_h = probe_frame.getHeight()
            probe_frame.recycle()
            square_size = min(src_w, src_h)
            square_size = square_size - (square_size % 2)
            if square_size <= 0:
                return None
            crop_left = (src_w - square_size) // 2
            crop_top = (src_h - square_size) // 2
            src_rect = Rect(crop_left, crop_top, crop_left + square_size, crop_top + square_size)
            dst_rect = Rect(0, 0, square_size, square_size)
            width = square_size
            height = square_size
            total_src_frames = 0
            use_batch_frames = False
            if int(BuildVersion.SDK_INT) >= 28:
                try:
                    total_src_frames = int(
                        retriever.extractMetadata(MediaMetadataRetriever.METADATA_KEY_VIDEO_FRAME_COUNT) or 0
                    )
                    if total_src_frames > 1:
                        use_batch_frames = True
                except Exception:
                    use_batch_frames = False
            batch_size = 4 if (src_w * src_h) >= 500_000 else 8
            self.debug_log(
                f"2/6 Настройка энкодера {width}x{height} (из {src_w}x{src_h}), {duration_ms} мс, "
                f"пакетное чтение: {use_batch_frames} (пакет: {batch_size})"
            )
            fps = 25
            frame_interval_us = 1_000_000 // fps
            total_duration_us = max(0, duration_ms * 1000 - (frame_interval_us // 2))
            mime = "video/avc"
            format_out = MediaFormat.createVideoFormat(mime, width, height)
            format_out.setInteger(MediaFormat.KEY_COLOR_FORMAT, CodecCapabilities.COLOR_FormatSurface)
            format_out.setInteger(MediaFormat.KEY_BIT_RATE, 1_800_000)
            format_out.setInteger(MediaFormat.KEY_FRAME_RATE, fps)
            format_out.setInteger(MediaFormat.KEY_I_FRAME_INTERVAL, 1)
            encoder = MediaCodec.createEncoderByType(mime)
            encoder.configure(format_out, None, None, MediaCodec.CONFIGURE_FLAG_ENCODE)
            input_surface = encoder.createInputSurface()
            encoder.start()
            self.debug_log("3/6 Инициализация EGLSurfaceRenderer")
            egl_renderer = EglSurfaceRenderer(input_surface, width, height)
            muxer = MediaMuxer(output_path, OutputFormat.MUXER_OUTPUT_MPEG_4)
            video_track_idx = -1
            audio_track_idx = -1
            extractor = MediaExtractor()
            extractor.setDataSource(input_path)
            src_audio_track = -1
            for i in range(extractor.getTrackCount()):
                track_format = extractor.getTrackFormat(i)
                track_mime = str(track_format.getString(MediaFormat.KEY_MIME))
                if track_mime == "audio/mp4a-latm":
                    try:
                        sample_rate = track_format.getInteger(MediaFormat.KEY_SAMPLE_RATE)
                        channel_count = track_format.getInteger(MediaFormat.KEY_CHANNEL_COUNT)
                        clean_audio_fmt = MediaFormat.createAudioFormat(track_mime, sample_rate, channel_count)
                        if track_format.containsKey("csd-0"):
                            csd0 = track_format.getByteBuffer("csd-0")
                            if csd0 is not None:
                                clean_audio_fmt.setByteBuffer("csd-0", csd0)
                        audio_track_idx = muxer.addTrack(clean_audio_fmt)
                        src_audio_track = i
                        self.debug_log(f"Аудиодорожка добавлена: {sample_rate} Гц, каналов: {channel_count}")
                    except Exception as aud_err:
                        self.debug_log(f"Пропуск аудиодорожки: {aud_err}")
                        src_audio_track = -1
                    break

            work_bitmap = Bitmap.createBitmap(width, height, Config.ARGB_8888)
            work_canvas = Canvas(work_bitmap)
            copy_paint = Paint(Paint.FILTER_BITMAP_FLAG)
            mosaic_paint = Paint(0)
            mosaic_paint.setFilterBitmap(False)
            mosaic_paint.setAntiAlias(False)

            buf_info = BufferInfo()
            pts_us = 0
            frame_idx = 0
            cached_rects = []
            hold_until_us = 0
            hold_idx = max(0, min(int(self.get_setting("face_hold_duration", 2)), 3))
            hold_us = [250_000, 500_000, 1_000_000, 1_500_000][hold_idx]
            strength = max(0, min(int(self.get_setting("blur_strength", 1)), 3))
            frame_step = [1, 2, 3][max(0, min(int(self.get_setting("frame_step", 1)), 2))]
            total_faces_found = 0

            def fetch_source_frame(current_pts_us):
                nonlocal use_batch_frames
                if use_batch_frames:
                    target_src_idx = min(
                        total_src_frames - 1,
                        int(round((current_pts_us / float(duration_ms * 1000)) * (total_src_frames - 1))),
                    )
                    stale_keys = [k for k in batch_cache if k < target_src_idx]
                    for k in stale_keys:
                        bmp = batch_cache.pop(k, None)
                        if bmp is not None:
                            bmp.recycle()
                    if target_src_idx not in batch_cache:
                        clear_batch_cache()
                        count = min(batch_size, total_src_frames - target_src_idx)
                        try:
                            frames = retriever.getFramesAtIndex(jint(target_src_idx), jint(count))
                            if frames is None or frames.size() == 0:
                                raise RuntimeError("Пустой пакет кадров")
                            for offset in range(frames.size()):
                                batch_cache[target_src_idx + offset] = frames.get(offset)
                        except Exception as batch_err:
                            self.debug_log(f"Переключение на getFrameAtTime: {batch_err}")
                            clear_batch_cache()
                            use_batch_frames = False
                    if use_batch_frames and target_src_idx in batch_cache:
                        return batch_cache.pop(target_src_idx)
                frame = retriever.getFrameAtTime(jlong(current_pts_us), MediaMetadataRetriever.OPTION_CLOSEST)
                if frame is None and current_pts_us == 0:
                    frame = retriever.getFrameAtTime(jlong(-1))
                return frame

            def drain_encoder(end_of_stream):
                nonlocal video_track_idx, muxer_started
                if end_of_stream:
                    encoder.signalEndOfInputStream()
                idle_deadline = time.monotonic() + 10.0
                while True:
                    check_deadline()
                    if time.monotonic() >= idle_deadline:
                        raise TimeoutError("Кодировщик не завершил видеопоток за 10 секунд")
                    status = encoder.dequeueOutputBuffer(buf_info, 10000)
                    if status == MediaCodec.INFO_TRY_AGAIN_LATER:
                        if not end_of_stream:
                            break
                    elif status == MediaCodec.INFO_OUTPUT_FORMAT_CHANGED:
                        if not muxer_started:
                            new_format = encoder.getOutputFormat()
                            video_track_idx = muxer.addTrack(new_format)
                            muxer.start()
                            muxer_started = True
                    elif status >= 0:
                        idle_deadline = time.monotonic() + 10.0
                        encoded_data = encoder.getOutputBuffer(status)
                        if (buf_info.flags & MediaCodec.BUFFER_FLAG_CODEC_CONFIG) != 0:
                            buf_info.size = 0
                        if buf_info.size != 0 and muxer_started and encoded_data is not None:
                            encoded_data.position(buf_info.offset)
                            encoded_data.limit(buf_info.offset + buf_info.size)
                            muxer.writeSampleData(video_track_idx, encoded_data, buf_info)
                        encoder.releaseOutputBuffer(status, False)
                        if (buf_info.flags & MediaCodec.BUFFER_FLAG_END_OF_STREAM) != 0:
                            break

            self.debug_log(f"4/6 Обработка кадров: 25 FPS, поиск лиц каждый {frame_step}-й кадр")
            while pts_us <= total_duration_us:
                check_deadline()
                drain_encoder(False)
                raw_frame = fetch_source_frame(pts_us)
                if raw_frame is None:
                    raise RuntimeError(f"Не удалось декодировать кадр {frame_idx}")
                try:
                    work_canvas.drawBitmap(raw_frame, src_rect, dst_rect, copy_paint)
                finally:
                    raw_frame.recycle()
                run_detection = (frame_idx % frame_step == 0)
                cached_rects, hold_until_us = self.blur_faces_on_canvas(
                    work_canvas,
                    work_bitmap,
                    cached_rects,
                    hold_until_us,
                    run_detection,
                    pts_us,
                    hold_us,
                    strength,
                    mosaic_paint,
                    android_state,
                )
                if run_detection and cached_rects:
                    total_faces_found += len(cached_rects)
                egl_renderer.draw_bitmap(work_bitmap, pts_us)
                drain_encoder(False)
                pts_us += frame_interval_us
                frame_idx += 1
                if frame_idx == 1 or frame_idx % 25 == 0:
                    self.debug_log(f"4/6 Кадров готово: {frame_idx}, позиция {pts_us // 1000}/{duration_ms} мс")

            self.debug_log(
                f"5/6 Завершение видеопотока (кадров: {frame_idx}, срабатываний детектора: {total_faces_found})"
            )
            drain_encoder(True)
            if src_audio_track >= 0 and muxer_started:
                extractor.selectTrack(src_audio_track)
                audio_buf = ByteBuffer.allocate(256 * 1024)
                audio_info = BufferInfo()
                last_audio_pts = -1
                while True:
                    check_deadline()
                    audio_buf.clear()
                    sample_size = extractor.readSampleData(audio_buf, 0)
                    if sample_size < 0:
                        break
                    sample_time = extractor.getSampleTime()
                    if sample_time < 0 or sample_time < last_audio_pts:
                        extractor.advance()
                        continue
                    last_audio_pts = sample_time
                    sample_flags = extractor.getSampleFlags()
                    audio_info.offset = 0
                    audio_info.size = sample_size
                    audio_info.presentationTimeUs = sample_time
                    audio_info.flags = (
                        MediaCodec.BUFFER_FLAG_KEY_FRAME
                        if (sample_flags & MediaExtractor.SAMPLE_FLAG_SYNC) != 0
                        else 0
                    )
                    muxer.writeSampleData(audio_track_idx, audio_buf, audio_info)
                    extractor.advance()
            if not muxer_started or video_track_idx < 0:
                raise RuntimeError("Кодировщик не создал видеодорожку")
            muxer.stop()
            muxer_started = False
            self.debug_log("6/6 Сборка MP4 завершена")
            return (width, height)
        finally:
            clear_batch_cache()
            old_rgb565 = android_state.pop("rgb565", None)
            if old_rgb565 is not None:
                try:
                    old_rgb565.recycle()
                except Exception:
                    pass
            android_state.clear()
            if work_bitmap is not None:
                try:
                    work_bitmap.recycle()
                except Exception:
                    pass
            try:
                retriever.release()
            except Exception:
                pass
            if extractor is not None:
                try:
                    extractor.release()
                except Exception:
                    pass
            if egl_renderer is not None:
                egl_renderer.release()
            if encoder is not None:
                try:
                    encoder.stop()
                except Exception:
                    pass
                try:
                    encoder.release()
                except Exception:
                    pass
            if input_surface is not None:
                try:
                    input_surface.release()
                except Exception:
                    pass
            if muxer is not None:
                try:
                    if muxer_started:
                        muxer.stop()
                except Exception:
                    pass
                try:
                    muxer.release()
                except Exception:
                    pass
