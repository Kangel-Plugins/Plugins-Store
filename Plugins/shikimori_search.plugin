def _build_session() -> requests.Session:
    session = requests.Session()
    session.headers.update({"User-Agent": USER_AGENT, "Accept": "application/json"})
    try:
        from urllib3.util.retry import Retry
        retry = Retry(
            total=2,
            connect=2,
            read=1,
            backoff_factor=0.3,
            status_forcelist=(500, 502, 503, 504),
        )
        adapter = HTTPAdapter(pool_connections=8, pool_maxsize=16, max_retries=retry)
    except Exception:
        adapter = HTTPAdapter(pool_connections=8, pool_maxsize=16)
    session.mount("https://", adapter)
    return session

SESSION = _build_session()

class _RateLimiter:
    def __init__(self, max_calls: int, period: float):
        self.max_calls = max_calls
        self.period = period
        self._lock = threading.Lock()
        self._calls = deque()

    def acquire(self):
        while True:
            with self._lock:
                now = time.monotonic()
                while self._calls and now - self._calls[0] > self.period:
                    self._calls.popleft()
                if len(self._calls) < self.max_calls:
                    self._calls.append(now)
                    return
                wait = self.period - (now - self._calls[0])
            if wait > 0:
                time.sleep(wait)

    def note_retry_after(self, seconds: float):
        with self._lock:
            now = time.monotonic()
            reserve_until = now + seconds
            while len(self._calls) < self.max_calls:
                self._calls.append(reserve_until)

_SHIKI_LIMITER = _RateLimiter(max_calls=4, period=1.0)

def _is_allowed_url(url: str) -> bool:
    try:
        parts = urlparse(url)
        host = (parts.hostname or "").lower()
    except Exception:
        return False
    if parts.scheme != "https" or not host:
        return False
    return any(host == d or host.endswith("." + d) for d in ALLOWED_HOSTS)

def _absolute_url(url: str) -> str:
    if not url:
        return ""
    full = urljoin(SITE_URL + "/", url)
    return full if _is_allowed_url(full) else ""

_POSTER_COUNTER = itertools.count()

def _throttled_request(method: str, url: str, timeout, max_retries: int = 2, limited: bool = True, **kwargs):
    if not _is_allowed_url(url):
        raise ValueError("Запрос на недопустимый адрес заблокирован")
    last_exc = None
    resp = None
    for attempt in range(max_retries + 1):
        if limited:
            _SHIKI_LIMITER.acquire()
        try:
            resp = SESSION.request(method, url, timeout=timeout, **kwargs)
        except Exception as e:
            last_exc = e
            continue
        if not _is_allowed_url(resp.url):
            resp.close()
            raise ValueError("Редирект на недопустимый адрес заблокирован")
        if resp.status_code == 429:
            retry_after = 1.0
            try:
                retry_after = float(resp.headers.get("Retry-After", "1"))
            except (TypeError, ValueError):
                pass
            retry_after = min(max(retry_after, 0.5), 5.0)
            _SHIKI_LIMITER.note_retry_after(retry_after)
            if attempt < max_retries:
                time.sleep(retry_after)
                continue
        return resp
    if last_exc:
        raise last_exc
    return resp

def _throttled_get(url: str, timeout, max_retries: int = 2, limited: bool = True, **kwargs):
    return _throttled_request("GET", url, timeout, max_retries, limited, **kwargs)

_CACHE: dict = {}

BMP_CACHE_MAX = 60
_BMP_CACHE: "OrderedDict" = OrderedDict()
_BMP_LOCK = threading.Lock()

def _bmp_get(key):
    with _BMP_LOCK:
        entry = _BMP_CACHE.get(key)
        if entry is None:
            return None
        if time.time() - entry[0] > POSTER_TTL:
            _BMP_CACHE.pop(key, None)
            return None
        _BMP_CACHE.move_to_end(key)
        return entry[1]

def _bmp_set(key, bmp):
    with _BMP_LOCK:
        _BMP_CACHE[key] = (time.time(), bmp)
        _BMP_CACHE.move_to_end(key)
        while len(_BMP_CACHE) > BMP_CACHE_MAX:
            _BMP_CACHE.popitem(last=False)

_GQL_INFLIGHT: dict = {}
_GQL_LOCK = threading.Lock()
_GQL_EXECUTOR = ThreadPoolExecutor(max_workers=1, thread_name_prefix="shiki-gql")

def _cache_get(key, ttl: int):
    entry = _CACHE.get(key)
    if not entry:
        return None
    ts, value = entry
    if time.time() - ts > ttl:
        return None
    return value

def _cache_set(key, value):
    _CACHE[key] = (time.time(), value)
    if len(_CACHE) > 200:
        for k, _ in sorted(_CACHE.items(), key=lambda kv: kv[1][0])[:50]:
            _CACHE.pop(k, None)

def _blend_colors(base: int, over: int, ratio: float) -> int:
    def channel(color: int, shift: int) -> int:
        return (color >> shift) & 0xFF
    out = 0
    for shift in (24, 16, 8, 0):
        value = round(channel(base, shift) * (1.0 - ratio) + channel(over, shift) * ratio)
        out |= max(0, min(255, value)) << shift
    return out - (1 << 32) if out >= (1 << 31) else out

class _SwipeTracker:

    def __init__(self, slop: float, fast_px_per_ms: float):
        self.slop = slop
        self.fast = fast_px_per_ms
        self.active = False
        self.dragging = False
        self.x0 = 0.0
        self.y0 = 0.0
        self.t0 = 0

    def down(self, x: float, y: float, t: int):
        self.active, self.dragging = True, False
        self.x0, self.y0, self.t0 = x, y, t

    def reset(self):
        self.active = self.dragging = False

    def move(self, x: float, y: float, idx: int, n: int) -> Optional[float]:
        if not self.active:
            return None
        dx, dy = x - self.x0, y - self.y0
        if not self.dragging:
            if abs(dx) < self.slop or abs(dx) < abs(dy) * 1.5:
                return None
            if (dx < 0 and idx >= n - 1) or (dx > 0 and idx <= 0):
                return None
            self.dragging = True
        return dx

    def finish(self, x: float, t: int, width: float, idx: int, n: int, cancelled: bool = False):
        was = self.dragging
        dx = x - self.x0
        self.reset()
        if not was:
            return False, None
        if cancelled:
            return True, None
        target = idx + (1 if dx < 0 else -1)
        if not 0 <= target < n:
            return True, None
        elapsed = max(1, t - self.t0)
        if abs(dx) > width * 0.25 or (abs(dx) > self.slop * 3 and abs(dx) / elapsed > self.fast):
            return True, target
        return True, None


def _to_float(value) -> float:
    try:
        return float(value)
    except (TypeError, ValueError):
        return 0.0

def dp(value: float) -> int:
    return AndroidUtilities.dp(value)

