_ICON_ID_CACHE: dict = {}

def _resolve_icon_id_cached(cache_key: str, ctx, tg_names: tuple, fallback_names: tuple) -> int:
    if cache_key in _ICON_ID_CACHE:
        return _ICON_ID_CACHE[cache_key]
    rid = 0
    try:
        for name in tg_names:
            rid = getattr(R_tg.drawable, name, 0)
            if rid:
                break
    except Exception:
        rid = 0
    if not rid:
        try:
            res = ctx.getResources()
            pkg = ctx.getPackageName()
            for name in fallback_names:
                found = res.getIdentifier(name, "drawable", pkg)
                if found != 0:
                    rid = found
                    break
        except Exception:
            pass
    rid = int(rid or 0)
    _ICON_ID_CACHE[cache_key] = rid
    return rid

def _resolve_search_icon_id(ctx) -> int:
    return _resolve_icon_id_cached("search", ctx, ("outline_header_search", "msg_search"), _SEARCH_ICON_NAMES)

def _resolve_status_icon_id(ctx) -> int:
    return _resolve_icon_id_cached("status", ctx, ("iv_lists", "outline_header_search", "msg_search"), _STATUS_ICON_NAMES)

def _resolve_star_icon_id(ctx) -> int:
    return _resolve_icon_id_cached("star", ctx, ("star_small_outline",), _STAR_ICON_NAMES)

def _resolve_calendar_icon_id(ctx) -> int:
    return _resolve_icon_id_cached("calendar", ctx, ("msg_calendar2",), _CALENDAR_ICON_NAMES)

def _resolve_clear_icon_id(ctx) -> int:
    return _resolve_icon_id_cached("clear", ctx, ("ic_close_white", "ic_ab_search_clear"), _CLEAR_ICON_NAMES)

def _chevron_bitmap(size_px: int, up: bool, color: int):
    bmp = Bitmap.createBitmap(size_px, size_px, Bitmap.Config.ARGB_8888)
    canvas = Canvas(bmp)
    paint = Paint(Paint.ANTI_ALIAS_FLAG)
    paint.setColor(jint(color))
    paint.setStyle(Paint.Style.STROKE)
    paint.setStrokeWidth(size_px * 0.11)
    paint.setStrokeCap(Paint.Cap.ROUND)
    paint.setStrokeJoin(Paint.Join.ROUND)
    sz = float(size_px)
    path = Path()
    if up:
        path.moveTo(sz * 0.20, sz * 0.62)
        path.lineTo(sz * 0.50, sz * 0.34)
        path.lineTo(sz * 0.80, sz * 0.62)
    else:
        path.moveTo(sz * 0.20, sz * 0.38)
        path.lineTo(sz * 0.50, sz * 0.66)
        path.lineTo(sz * 0.80, sz * 0.38)
    canvas.drawPath(path, paint)
    return bmp

def _cross_bitmap(size_px: int, color: int):
    bmp = Bitmap.createBitmap(size_px, size_px, Bitmap.Config.ARGB_8888)
    canvas = Canvas(bmp)
    paint = Paint(Paint.ANTI_ALIAS_FLAG)
    paint.setColor(jint(color))
    paint.setStrokeWidth(size_px * 0.11)
    paint.setStrokeCap(Paint.Cap.ROUND)
    sz = float(size_px)
    canvas.drawLine(sz * 0.25, sz * 0.25, sz * 0.75, sz * 0.75, paint)
    canvas.drawLine(sz * 0.75, sz * 0.25, sz * 0.25, sz * 0.75, paint)
    return bmp

def _view_mode_bitmap(size_px: int, grid: bool, color: int):
    bmp = Bitmap.createBitmap(size_px, size_px, Bitmap.Config.ARGB_8888)
    canvas = Canvas(bmp)
    paint = Paint(Paint.ANTI_ALIAS_FLAG)
    paint.setColor(jint(color))
    paint.setStyle(Paint.Style.STROKE)
    paint.setStrokeWidth(size_px * 0.09)
    paint.setStrokeCap(Paint.Cap.ROUND)
    sz = float(size_px)
    if grid:
        r = sz * 0.06
        for x, y in ((0.20, 0.20), (0.56, 0.20), (0.20, 0.56), (0.56, 0.56)):
            canvas.drawRoundRect(RectF(sz * x, sz * y, sz * (x + 0.24), sz * (y + 0.24)), r, r, paint)
    else:
        for y in (0.30, 0.50, 0.70):
            canvas.drawLine(sz * 0.22, sz * y, sz * 0.78, sz * y, paint)
    return bmp

