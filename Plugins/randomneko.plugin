from base_plugin import BasePlugin, HookResult, HookStrategy


_DEFAULT_COMMAND = ".nya"
_DEFAULT_TIMEOUT = 15
_NEKO = "https://neko.itisxiao.cc"
_DEFAULT_UA = f"RandomNeko v{__version__} (Android 16; https://MLPlugins.t.me)"
_DEFAULT_HEADERS = {
    "User-Agent": _DEFAULT_UA,
    "Referer": "https://neko.itisxiao.cc",
    "Accept": "image/*,application/json,*/*",
}
_EXTENSIONS_MAP = {
    "image/png": "png",
    "image/bmp": "bmp",
    "image/jpg": "jpg",
    "image/jpeg": "jpeg",
    "image/webp": "webp",
    "image/gif": "gif",
}
_MAX_BYTES = 15 * 1024 * 1024


def _make_cache_dir():
    cache_dir = get_cache_dir()
    os.makedirs(f"{cache_dir}/randomneko", exist_ok=True)


def _get_timeout():
    try:
        timeout = int(plugin_settings.get_setting(__id__, "timeout", _DEFAULT_TIMEOUT))
    except Exception:
        timeout = plugin_settings.get_setting(__id__, "timeout", _DEFAULT_TIMEOUT)
    return timeout


def _clear_neko_cache():
    cache_dir = get_cache_dir()
    shutil.rmtree(f"{cache_dir}/randomneko")
    _make_cache_dir()


def _load_random_neko():
    from ui.bulletin import BulletinHelper
    BulletinHelper.show_info(strings.loading_neko)
    try:
        response = requests.get(_NEKO, headers=_DEFAULT_HEADERS, timeout=_get_timeout())
        response.raise_for_status()
        contentType = response.headers.get("Content-Type", "image/png")
        body = response.content
        if not body:
            return None
        ext = _EXTENSIONS_MAP.get(contentType)
        if not ext:
            return None
        date = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")
        fileName = f"neko_{date}.{ext}"
        cache_dir = get_cache_dir()
        rn_cache = f"{cache_dir}/randomneko"
        neko_path = f"{rn_cache}/{fileName}"
        with open(neko_path, "wb") as file:
            file.write(body)
        return neko_path
    except Exception:
        return None


strings = Strings(all_strings={
    "en": {
        "command": "Command",
        "timeout": "Timeout",
        "clear_cache": "Clear cache",
        "version": "Version",
        "loading_neko": "Loading neko...",
    },
    "ru": {
        "command": "Команда",
        "timeout": "Таймаут",
        "clear_cache": "Очистить кеш",
        "version": "Версия",
        "loading_neko": "Загрузка неко..."
    },
})


class RandomNeko(BasePlugin):
    def __init__(self):
        super().__init__()

    def log(self, m):
        from android.util import Log
        Log.i("RandomNeko", m)

    def on_plugin_load(self):
        self.log("Plugin is loaded")
        _make_cache_dir()
        self.add_on_send_message_hook()

    def on_plugin_unload(self):
        self.log("Plugin is unloaded")

    def create_settings(self):
        settings = [
            Header(text="RandomNeko"),
            EditText(
                key="command",
                hint=strings.command,
                default=_DEFAULT_COMMAND,
            ),
            EditText(
                key="timeout",
                hint=strings.timeout,
                default=_DEFAULT_TIMEOUT,
            ),
            Divider(),
            Text(
                text=strings.clear_cache,
                on_click=lambda *a, **kw: _clear_neko_cache(),
                accent=True,
            ),
            Divider(text=f"{strings.version}: {__version__}"),
        ]
        return settings

    def on_send_message_hook(self, a, p):
        if not isinstance(p.message, str):
            return HookResult()
        command = self.get_setting("command", _DEFAULT_COMMAND)
        text = p.message.strip()
        peer = p.peer
        if text.startswith(command):
            def _send():
                path = _load_random_neko()
                if not path:
                    return HookResult()
                send_photo(peer, path)
            run_on_queue(_send)
            return HookResult(strategy=HookStrategy.CANCEL, params=p)
        return HookResult(strategy=HookStrategy.MODIFY, params=p)