        ".sprofile — Steam profile card\n"
        ".sinv — CS2/TF2/Dota 2 inventory\n"
        ".slibrary — games library\n\n"
        "Have fun!",
    ),
]

_guide_state = {
    "sheet": None,
    "frame": None,
    "holder": None,
    "pages": None,
    "at": -1,
}
_guide_runnable_refs = {}
_guide_anim_refs = {}


def _guide_later(action, delay_ms):
    try:
        from org.telegram.messenger import AndroidUtilities
        from hook_utils import find_class
        from java import dynamic_proxy
        Runnable = find_class("java.lang.Runnable")
        class _Later(dynamic_proxy(Runnable)):
            def run(self):
                try:
                    action()
                except Exception:
                    pass
                finally:
                    _guide_runnable_refs.pop(id(self), None)
        holder = _Later()
        _guide_runnable_refs[id(holder)] = holder
        AndroidUtilities.runOnUIThread(holder, delay_ms)
    except Exception:
        try:
            from android_utils import run_on_ui_thread
            run_on_ui_thread(action)
        except Exception:
            pass


def _guide_close():
    sheet = _guide_state.get("sheet")
    _guide_state["sheet"] = None
    _guide_state["frame"] = None
    _guide_state["holder"] = None
    _guide_state["pages"] = None
    _guide_state["at"] = -1
    if sheet is None:
        return
    try:
        if sheet.isShowing():
            sheet.dismiss()
    except Exception:
        pass


def _guide_accent():
    try:
        from org.telegram.ui.ActionBar import Theme
        return Theme.getColor(Theme.key_featuredStickers_addButton)
    except Exception:
        from java import jint
        return jint(-8630785)


def _guide_button(ctx, label, accent, action):
    from android.graphics.drawable import GradientDrawable
    from android.view import Gravity
    from android.widget import TextView
    from org.telegram.messenger import AndroidUtilities
    from org.telegram.ui.ActionBar import Theme
    from android_utils import OnClickListener
    from java import jint
    view = TextView(ctx)
    view.setText(label)
    view.setTextSize(14)
    view.setGravity(Gravity.CENTER)
    try:
        view.setTypeface(AndroidUtilities.bold())
    except Exception:
        pass
    view.setPadding(
        AndroidUtilities.dp(16), AndroidUtilities.dp(12),
        AndroidUtilities.dp(16), AndroidUtilities.dp(12)
    )
    bg = GradientDrawable()
    bg.setShape(GradientDrawable.RECTANGLE)
    bg.setCornerRadius(AndroidUtilities.dp(8))
    if accent:
        bg.setColor(_guide_accent())
        view.setTextColor(jint(-1))
    else:
        bg.setColor(Theme.getColor(Theme.key_listSelector))
        view.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
    view.setBackground(bg)
    view.setOnClickListener(OnClickListener(lambda v: action()))
    return view


def _guide_page(ctx, pl, step_index, buttons):
    from android.view import Gravity
    from android.widget import LinearLayout, TextView
    from org.telegram.messenger import AndroidUtilities
    from org.telegram.ui.ActionBar import Theme
    from org.telegram.ui.Components import BackupImageView, LayoutHelper
    lang = Locale.getDefault().getLanguage()
    step = GUIDE_STEPS[step_index]
    set_name, sticker_idx = step[0], step[1]
    title_text = step[2] if lang.startswith('ru') else step[3]
    body_text = step[4] if lang.startswith('ru') else step[5]
    total = len(GUIDE_STEPS)
    note = "%d / %d" % (step_index + 1, total)

    root = LinearLayout(ctx)
    root.setOrientation(LinearLayout.VERTICAL)

    try:
        image = BackupImageView(ctx)
        image.setRoundRadius(0)
        try:
            image.getImageReceiver().setCrossfadeWithOldImage(True)
        except Exception:
            pass
        root.addView(image, LayoutHelper.createLinear(
            120, 120, Gravity.TOP | Gravity.CENTER_HORIZONTAL, 0, 24, 0, 0))
        try:
            pl._load_sticker_async(image, set_name, sticker_idx,
                                   f"steam_guide_{set_name}_{sticker_idx}")
        except Exception:
            pass
    except Exception:
        pass

    title = TextView(ctx)
    try:
        title.setTypeface(AndroidUtilities.bold())
    except Exception:
        pass
    title.setTextSize(20)
    title.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
    title.setText(title_text)
    title.setGravity(Gravity.CENTER)
    root.addView(title, LayoutHelper.createLinear(
        -2, -2, Gravity.TOP | Gravity.CENTER_HORIZONTAL, 24, 16, 24, 0))

    mark = TextView(ctx)
    mark.setText(note)
    mark.setTextSize(13)
    mark.setGravity(Gravity.CENTER)
    mark.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText))
    root.addView(mark, LayoutHelper.createLinear(
        -1, -2, Gravity.TOP, 24, 6, 24, 0))

    body = TextView(ctx)
    body.setText(body_text)
    body.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
    body.setTextSize(15)
    try:
        body.setLineSpacing(float(AndroidUtilities.dp(2)), 1.0)
    except Exception:
        pass
    body.setGravity(Gravity.CENTER)
    try:
        from android.text.util import Linkify
        from android.text.method import LinkMovementMethod
        Linkify.addLinks(body, Linkify.WEB_URLS)
        body.setMovementMethod(LinkMovementMethod.getInstance())
        body.setLinksClickable(True)
    except Exception:
        pass
    root.addView(body, LayoutHelper.createLinear(
        -1, -2, Gravity.TOP, 24, 16, 24, 16))



    row = LinearLayout(ctx)
    row.setOrientation(LinearLayout.HORIZONTAL)
    for index, (label, accent, action) in enumerate(buttons):
        btn = _guide_button(ctx, label, accent, action)
        left = 0 if index == 0 else 8
        row.addView(btn, LayoutHelper.createLinear(
            0, -2, 1.0, Gravity.CENTER_VERTICAL, left, 0, 0, 0))
    root.addView(row, LayoutHelper.createLinear(
        -1, -2, Gravity.CENTER_HORIZONTAL, 24, 0, 24, 24))

    return root


def _guide_hide_page(page):
    from android.view import View
    try:
        page.setVisibility(View.GONE)
        page.setTranslationX(0.0)
        page.setAlpha(1.0)
    except Exception:
        pass


def _guide_release():
    holder = _guide_state.get("holder")
    if holder is None:
        return
    try:
        params = holder.getLayoutParams()
        if params is not None and params.height != -2:
            params.height = -2
            holder.setLayoutParams(params)
    except Exception:
        pass


def _guide_turn(pages, was, now):
    if was == now or was < 0 or now < 0 or was >= len(pages) or now >= len(pages):
        return
    from android.view import View
    from org.telegram.messenger import AndroidUtilities
    side = 1 if now > was else -1
    old = pages[was]
    page = pages[now]
    try:
        width = old.getWidth()
    except Exception:
        width = 0
    if width <= 0:
        try:
            width = AndroidUtilities.dp(320)
        except Exception:
            width = 320
    try:
        page.setVisibility(View.VISIBLE)
        page.setTranslationX(float(side * width))
        page.setAlpha(0.0)
        page.animate().translationX(0.0).alpha(1.0).setDuration(GUIDE_PAGE_MS).start()
        old.animate().translationX(float(-side * width)).alpha(0.0).setDuration(GUIDE_PAGE_MS).start()
    except Exception:
        pass
    _guide_later(lambda: _guide_hide_page(old), GUIDE_PAGE_MS + 40)
    _guide_later(lambda: _guide_release(), GUIDE_PAGE_MS + 40)


def _guide_buttons(pl, ctx, index):
    lang = Locale.getDefault().getLanguage()
    last = len(GUIDE_STEPS) - 1
    if lang.startswith('ru'):
        next_label = "Далее"
        back_label = "Назад"
        skip_label = "Пропустить"
        done_label = "Готово!"
    else:
        next_label = "Next"
        back_label = "Back"
        skip_label = "Skip"
        done_label = "Done!"

    if index == last:
        return [
            (skip_label, False, lambda: _guide_finish(pl)),
            (done_label, True, lambda: _guide_finish(pl)),
        ]
    back_text = back_label if index > 0 else skip_label
    back_action = (lambda: _guide_step(pl, ctx, index - 1)) if index > 0 else (lambda: _guide_finish(pl))
    return [
        (back_text, False, back_action),
        (next_label, True, lambda: _guide_step(pl, ctx, index + 1)),
    ]


def _guide_finish(pl):
    _guide_close()
    _guide_mark_done(pl)


def _guide_step(pl, ctx, index):
    if index < 0 or index >= len(GUIDE_STEPS):
        _guide_finish(pl)
        return
    pages = _guide_state.get("pages")
    was = _guide_state.get("at", 0)
    if pages and 0 <= index < len(pages):
        _guide_turn(pages, was, index)
        _guide_state["at"] = index
    else:
        _guide_open(pl)


def _guide_watch(sheet, pl):
    try:
        from hook_utils import find_class
        from java import dynamic_proxy
        Listener = find_class("android.content.DialogInterface$OnDismissListener")
        class _Gone(dynamic_proxy(Listener)):
            def onDismiss(self, dialog):
                try:
                    if _guide_state.get("sheet") == dialog:
                        _guide_state["sheet"] = None
                        _guide_state["frame"] = None
                        _guide_state["pages"] = None
                        _guide_state["at"] = -1
                except Exception:
                    pass
                finally:
                    _guide_runnable_refs.pop(id(self), None)
        keeper = _Gone()
        _guide_runnable_refs[id(keeper)] = keeper
        sheet.setOnDismissListener(keeper)
    except Exception as e:
        log(f"[SteamPlugin] guide watch error: {e}")


def _guide_open(pl):
    try:
        fragment = get_last_fragment()
        if not fragment:
            return False
        ctx = fragment.getParentActivity()
        if not ctx:
            return False

        from android.view import Gravity, View
        from android.widget import FrameLayout
        from androidx.core.widget import NestedScrollView
        from org.telegram.ui.ActionBar import BottomSheet
        from org.telegram.ui.Components import LayoutHelper

        frame = FrameLayout(ctx)
        pages = []
        for i in range(len(GUIDE_STEPS)):
            btns = _guide_buttons(pl, ctx, i)
            page = _guide_page(ctx, pl, i, btns)
            frame.addView(page, LayoutHelper.createFrame(-1, -2, Gravity.TOP))
            if i > 0:
                page.setVisibility(View.GONE)
            pages.append(page)

        scroll = NestedScrollView(ctx)
        scroll.addView(frame, LayoutHelper.createFrame(-1, -2, Gravity.TOP))
        holder = FrameLayout(ctx)
        holder.addView(scroll, LayoutHelper.createFrame(-1, -2, Gravity.TOP))

        builder = BottomSheet.Builder(ctx)
        builder.setCustomView(holder)
        _guide_close()
        made = builder.create()
        try:
            made.setDimBehindAlpha(GUIDE_DIM_ALPHA)
        except Exception:
            pass
        _guide_watch(made, pl)
        made.show()
        _guide_state["sheet"] = made
        _guide_state["frame"] = frame
        _guide_state["holder"] = holder
        _guide_state["pages"] = pages
        _guide_state["at"] = 0
        log("[SteamPlugin] guide shown")
        return True
    except Exception as e:
        log(f"[SteamPlugin] guide open error: {e}")
        return False


def _guide_offer(pl):
    try:
        fragment = get_last_fragment()
        if not fragment:
            return
        ctx = fragment.getParentActivity()
        if not ctx:
            return

        lang = Locale.getDefault().getLanguage()
        if lang.startswith('ru'):
            title_text = "Добро пожаловать в Steam Plugin!"
            body_text = (
                "Хочешь быстро разобраться с настройкой?\n\n"
                "Пошаговый гид поможет получить API ключ, "
                "найти Steam ID и отправить первую команду за минуту."
            )
            yes_label = "Да, погнали!"
            no_label = "Пропустить"
        else:
            title_text = "Welcome to Steam Plugin!"
            body_text = (
                "Want a quick setup tour?\n\n"
                "A step-by-step guide will help you get your API key, "
                "find Steam ID and send your first command in a minute."
            )
            yes_label = "Yes, let's go!"
            no_label = "Skip"

        from android.view import Gravity
        from android.widget import LinearLayout, TextView
        from androidx.core.widget import NestedScrollView
        from org.telegram.messenger import AndroidUtilities
        from org.telegram.ui.ActionBar import BottomSheet, Theme
        from org.telegram.ui.Components import BackupImageView, LayoutHelper
        from android_utils import OnClickListener
        from java import jint

        root = LinearLayout(ctx)
        root.setOrientation(LinearLayout.VERTICAL)

        try:
            image = BackupImageView(ctx)
            image.setRoundRadius(0)
            root.addView(image, LayoutHelper.createLinear(
                100, 100, Gravity.TOP | Gravity.CENTER_HORIZONTAL, 0, 24, 0, 0))
            pl._load_sticker_async(image, "Kangelcons_by_fStikBot", 0, "steam_offer_sticker")
        except Exception:
            pass

        title = TextView(ctx)
        try:
            title.setTypeface(AndroidUtilities.bold())
        except Exception:
            pass
        title.setTextSize(20)
        title.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
        title.setText(title_text)
        title.setGravity(Gravity.CENTER)
        root.addView(title, LayoutHelper.createLinear(
            -2, -2, Gravity.TOP | Gravity.CENTER_HORIZONTAL, 24, 16, 24, 0))

        body = TextView(ctx)
        body.setText(body_text)
        body.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
        body.setTextSize(15)
        try:
            body.setLineSpacing(float(AndroidUtilities.dp(2)), 1.0)
        except Exception:
            pass
        body.setGravity(Gravity.CENTER)
        root.addView(body, LayoutHelper.createLinear(
            -1, -2, Gravity.TOP, 24, 16, 24, 16))

        sheet_ref = [None]

        def _dismiss():
            try:
                if sheet_ref[0] and sheet_ref[0].isShowing():
                    sheet_ref[0].dismiss()
            except Exception:
                pass

        btn_row = LinearLayout(ctx)
        btn_row.setOrientation(LinearLayout.HORIZONTAL)

        no_btn = TextView(ctx)
        no_btn.setText(no_label)
        no_btn.setTextSize(14)
        no_btn.setGravity(Gravity.CENTER)
        try:
            no_btn.setTypeface(AndroidUtilities.bold())
        except Exception:
            pass
        no_btn.setPadding(AndroidUtilities.dp(16), AndroidUtilities.dp(12),
                          AndroidUtilities.dp(16), AndroidUtilities.dp(12))
        from android.graphics.drawable import GradientDrawable
        no_bg = GradientDrawable()
        no_bg.setShape(GradientDrawable.RECTANGLE)
        no_bg.setCornerRadius(AndroidUtilities.dp(8))
        no_bg.setColor(Theme.getColor(Theme.key_listSelector))
        no_btn.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
        no_btn.setBackground(no_bg)
        no_btn.setOnClickListener(OnClickListener(lambda v: (_dismiss(), _guide_mark_done(pl))))
        btn_row.addView(no_btn, LayoutHelper.createLinear(
            0, -2, 1.0, Gravity.CENTER_VERTICAL, 0, 0, 0, 0))

        yes_btn = TextView(ctx)
        yes_btn.setText(yes_label)
        yes_btn.setTextSize(14)
        yes_btn.setGravity(Gravity.CENTER)
        try:
            yes_btn.setTypeface(AndroidUtilities.bold())
        except Exception:
            pass
        yes_btn.setPadding(AndroidUtilities.dp(16), AndroidUtilities.dp(12),
                           AndroidUtilities.dp(16), AndroidUtilities.dp(12))
        yes_bg = GradientDrawable()
        yes_bg.setShape(GradientDrawable.RECTANGLE)
        yes_bg.setCornerRadius(AndroidUtilities.dp(8))
        yes_bg.setColor(_guide_accent())
        yes_btn.setTextColor(jint(-1))
        yes_btn.setBackground(yes_bg)
        yes_btn.setOnClickListener(OnClickListener(lambda v: (_dismiss(), _guide_open(pl))))
        btn_row.addView(yes_btn, LayoutHelper.createLinear(
            0, -2, 1.0, Gravity.CENTER_VERTICAL, 8, 0, 0, 0))

        root.addView(btn_row, LayoutHelper.createLinear(
            -1, -2, Gravity.CENTER_HORIZONTAL, 24, 0, 24, 24))

        scroll = NestedScrollView(ctx)
        scroll.addView(root)
        builder = BottomSheet.Builder(ctx)
        builder.setCustomView(scroll)
        made = builder.create()
        try:
            made.setDimBehindAlpha(GUIDE_DIM_ALPHA)
        except Exception:
            pass
        sheet_ref[0] = made
        made.show()
        log("[SteamPlugin] guide offer shown")
    except Exception as e:
        log(f"[SteamPlugin] guide offer error: {e}")


def _guide_mark_done(pl):
    try:
        pl.set_setting(GUIDE_DONE_KEY, True, reload_settings=False)
    except Exception:
        try:
            pl.set_setting(GUIDE_DONE_KEY, True)
        except Exception:
            pass


def maybe_show_steam_guide(pl):
    try:
        if pl.get_setting(GUIDE_DONE_KEY, False):
            return
        _guide_mark_done(pl)
        log("[SteamPlugin] guide: first launch, scheduling offer")
        _guide_later(lambda: _guide_offer(pl), GUIDE_FIRST_DELAY_MS)
    except Exception as e:
        log(f"[SteamPlugin] maybe_show_guide error: {e}")



