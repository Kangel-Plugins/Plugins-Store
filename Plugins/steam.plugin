CS2_WEAR_TO_LETTERS = {
    "Factory New": "FN",
    "Minimal Wear": "MW",
    "Field-Tested": "FT",
    "Well-Worn": "WW",
    "Battle-Scarred": "BS",
}

_WEAR_RE = re.compile(r"\((Factory New|Minimal Wear|Field-Tested|Well-Worn|Battle-Scarred)\)")

def cs2_extract_wear_letters(name: str):
    match = _WEAR_RE.search(name or "")
    if not match:
        return None
    return CS2_WEAR_TO_LETTERS.get(match.group(1))

def cs2_strip_wear(name: str) -> str:
    return _WEAR_RE.sub('', name or '').strip()

def cs2_rarity_group(tags: list) -> str:
    other = "Другое" if is_ru() else "Other"
    for tag in tags or []:
        if tag.get('category') == 'Rarity':
            raw = tag.get('localized_tag_name') or tag.get('name') or ''
            raw_en = tag.get('name') or raw
            if is_ru():
                return CS2_RARITY_EN_TO_GROUP.get(raw_en, CS2_RARITY_EN_TO_GROUP.get(raw, raw or other))
            else:
                return CS2_RARITY_EN_TO_GROUP_EN.get(raw_en, CS2_RARITY_EN_TO_GROUP_EN.get(raw, raw or other))
    return other

