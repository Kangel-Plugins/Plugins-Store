def get_inventory_item_rarity(app_id: int, tags: list) -> str:
    tags = tags or []
    other = "Другое" if is_ru() else "Other"
    if app_id == 730:
        return cs2_rarity_group(tags)
    elif app_id == 440:
        for tag in tags:
            if tag.get('category') == 'Quality':
                raw = tag.get('localized_tag_name') or tag.get('name') or ''
                raw_en = tag.get('name') or raw
                mapping = TF2_QUALITY_EN_TO_GROUP if is_ru() else TF2_QUALITY_EN_TO_GROUP_EN
                return mapping.get(raw_en, mapping.get(raw, raw or other))
        for tag in tags:
            if tag.get('category') in ('Rarity', 'Type'):
                raw = tag.get('localized_tag_name') or tag.get('name') or ''
                return raw or other
        return other
    elif app_id == 570:
        for tag in tags:
            if tag.get('category') == 'Rarity':
                raw = tag.get('localized_tag_name') or tag.get('name') or ''
                raw_en = tag.get('name') or raw
                return DOTA2_RARITY_EN_TO_GROUP.get(raw_en, DOTA2_RARITY_EN_TO_GROUP.get(raw, raw or other))
        return other
    return other

